استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_analysis;

// Checked arithmetic with an overflow exit: the one MSIR reading every code
// generator shares of how runtime_checks.sn reports an overflowing add,
// subtract or multiply. That pass leaves the checked operation, which traps,
// at the head of a continuation block C and puts before it, in the block K
// it splits, a test that branches to a cold block that reports the overflow:
//
//   signed add:        T = a +% b; c = (a ^ T) & (b ^ T) <s 0
//   signed subtract:   T = a -% b; c = (a ^ b) & (a ^ T) <s 0
//   unsigned add:      T = a +% b; c = T <u a
//   unsigned subtract: c = a <u b
//   K: ...; condbr c, cold, C       C: V = a op b (checked); ...
//
// A multiply tests the exact product (32 bits and fewer: widened, then
// compared against the type's bounds, in K and, signed, a second block) or,
// at 64 bits, the operands' magnitudes in K and the product divided back in
// a slow path of its own blocks; all of them branch to the cold block or C.
//
// The test computes exactly whether the operation overflows, so a consumer
// that has one operation computing the result and the overflow flag (a
// machine's ADD/SUB/IMUL and a conditional branch on the overflow or carry
// flag, AArch64's ADDS/SUBS and B.cond, LLVM's llvm.*.with.overflow) emits
// that operation in K instead, branches to the cold block on overflow and to
// C otherwise, and drops the test: the values only the test computes, the
// blocks only it runs, and C's checked operation, whose value the fused
// operation defines. The cold block, its report (kind, place, exit status)
// and everything after C are unchanged.
//
// What is recognized:
//   - add and subtract: the test's exact form above (either operand order
//     where the operation commutes); its signedness is read off the test and
//     a consumer checks it against the operation's Type;
//   - multiply: the shape: K's branch leads, through blocks only K reaches
//     that compute pure values and branch without block arguments, to exactly
//     one report block and to C. Only runtime_checks.sn makes a block that
//     calls std's report and then traps (std's report returns nothing, so
//     no source call of it ends in a trap), and every later pass keeps what
//     such a test computes, so the shape is the test.
// The report block is one whose terminator traps after a call of the
// program's report (برنامج_مسير.دالة_فشل_فحص_التشغيل) with the overflow kind,
// 0, as its first argument. Every edge involved carries no block arguments.

// One fused check.
عام نوع حساب_بمخرج_تجاوز_مسير = {
    // Block positions: the block whose terminator is the test (K), the
    // continuation whose first instruction is the checked operation (C), and
    // the block reporting the overflow.
    الكتلة: طبيعي,
    المتابعة: طبيعي,
    البارد: طبيعي,
    // The blocks only the test runs (a multiply's), which no consumer emits
    // once it fuses the check.
    المنطقة: متجه طبيعي,
    // The checked operation (جمع, طرح or ضرب), its operands and its value.
    العملية: عملية_حساب_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير,
    الناتج: معرف_قيمة_مسير,
    // K's branch condition.
    الشرط: معرف_قيمة_مسير,
    // The signedness the test shows (add and subtract only, إشارة_معروفة).
    موقع: منطقي,
    إشارة_معروفة: منطقي
};

عام نوع حسابات_بمخرج_تجاوز_مسير = {
    الحسابات: متجه حساب_بمخرج_تجاوز_مسير,
    // By block position: the index + 1 of the check whose test block it is
    // (K), and of the check whose continuation it is (C); 0 for none.
    اختبار_الكتلة: متجه طبيعي,
    متابعة_الكتلة: متجه طبيعي,
    // By value position: a value only a check's test reads, defined in K or
    // in the check's region. A consumer that fuses the check does not
    // compute it.
    قيم_الاختبار: متجه منطقي
};

// The defining instruction of each value: its block + 1 (0: none, a
// parameter) and its index.
نوع تعريفات_مخرج = {
    الكتلة: متجه طبيعي,
    التعليمة: متجه طبيعي
};

عرف تعريفات_دالة_مخرج(الدالة: &دالة_مسير): تعريفات_مخرج {
    ليكن العدد: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    ليكن الكتل: متغير متجه طبيعي = [];
    ليكن التعليمات: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(الكتل, العدد);
    احجز_سعة(التعليمات, العدد);
    طالما (ف < العدد) { ألحق(الكتل, 0); ألحق(التعليمات, 0); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(ق) -> {
                إذا (ق < العدد) { الكتل[ق] := ك + 1; التعليمات[ق] := ت; };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    ليكن الناتج: تعريفات_مخرج = { الكتلة: الكتل, التعليمة: التعليمات };
    أرجع الناتج;
}

// A number for each integer operation the recognizer compares (0: others).
عرف رقم_حساب_مخرج(العملية: عملية_حساب_صحيح): طبيعي {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع 1; }
    | عملية_حساب_صحيح.طرح -> { أرجع 2; }
    | عملية_حساب_صحيح.ضرب -> { أرجع 3; }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع 4; }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع 5; }
    | عملية_حساب_صحيح.و_بتي -> { أرجع 6; }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع 7; }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع 8; }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع 9; }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع 10; }
    | _ -> { أرجع 0; };
}

// A number for each comparison (1 <, 2 >, 0 others).
عرف رقم_مقارنة_مخرج(العملية: عملية_مقارنة_صحيح): طبيعي {
    طابق العملية مع
    | عملية_مقارنة_صحيح.أصغر -> { أرجع 1; }
    | عملية_مقارنة_صحيح.أكبر -> { أرجع 2; }
    | _ -> { أرجع 0; };
}

عرف قيمتان_مخرج(أ: معرف_قيمة_مسير, ب: معرف_قيمة_مسير): منطقي {
    أرجع أ.القيمة == ب.القيمة;
}

// The integer arithmetic defining القيمة, when an instruction does.
عرف حساب_معرف_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    القيمة: معرف_قيمة_مسير
): اختياري حساب_صحيح_مسير {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*التعريفات).الكتلة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((*التعريفات).الكتلة[ق] == 0) { أرجع اختياري.لا_شيء(); };
    ليكن ك: طبيعي = (*التعريفات).الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*التعريفات).التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.حساب_صحيح(ح) -> { أرجع اختياري.موجود(ح); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The integer comparison defining القيمة, when an instruction does.
عرف مقارنة_معرفة_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    القيمة: معرف_قيمة_مسير
): اختياري مقارنة_صحيح_مسير {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*التعريفات).الكتلة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((*التعريفات).الكتلة[ق] == 0) { أرجع اختياري.لا_شيء(); };
    ليكن ك: طبيعي = (*التعريفات).الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*التعريفات).التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.مقارنة_صحيح(م) -> { أرجع اختياري.موجود(م); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether القيمة is the signed integer constant القيمة_المطلوبة.
عرف ثابت_موقع_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    القيمة: معرف_قيمة_مسير,
    القيمة_المطلوبة: عدد
): منطقي {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*التعريفات).الكتلة) مثل طبيعي)) { أرجع خطأ; };
    إذا ((*التعريفات).الكتلة[ق] == 0) { أرجع خطأ; };
    ليكن ك: طبيعي = (*التعريفات).الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*التعريفات).التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        طابق الثابت مع
        | ثابت_مسير.صحيح_موقع(س) -> { أرجع س == القيمة_المطلوبة; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Whether القيمة is العملية applied to أ and ب (either order when تبديلي).
عرف حساب_من_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    القيمة: معرف_قيمة_مسير,
    العملية: طبيعي,
    أ: معرف_قيمة_مسير,
    ب: معرف_قيمة_مسير,
    تبديلي: منطقي
): منطقي {
    طابق حساب_معرف_مخرج(الدالة, التعريفات, القيمة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(ح) -> {
        إذا (رقم_حساب_مخرج(ح.العملية) != العملية) { أرجع خطأ; };
        إذا (قيمتان_مخرج(ح.اليسار, أ) && قيمتان_مخرج(ح.اليمين, ب)) { أرجع صواب; };
        أرجع تبديلي && قيمتان_مخرج(ح.اليسار, ب) && قيمتان_مخرج(ح.اليمين, أ);
    };
}

// The other operand of the xor القيمة when one of its operands is أ.
عرف آخر_حصري_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    القيمة: معرف_قيمة_مسير,
    أ: معرف_قيمة_مسير
): اختياري معرف_قيمة_مسير {
    طابق حساب_معرف_مخرج(الدالة, التعريفات, القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ح) -> {
        إذا (رقم_حساب_مخرج(ح.العملية) != 5) { أرجع اختياري.لا_شيء(); };
        إذا (قيمتان_مخرج(ح.اليسار, أ)) { أرجع اختياري.موجود(ح.اليمين); };
        إذا (قيمتان_مخرج(ح.اليمين, أ)) { أرجع اختياري.موجود(ح.اليسار); };
        أرجع اختياري.لا_شيء();
    };
}

// Signed add: s1 = a ^ T and s2 = b ^ T (any order), T = a +% b.
عرف جمع_موقع_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    س1: معرف_قيمة_مسير,
    س2: معرف_قيمة_مسير,
    أ: معرف_قيمة_مسير,
    ب: معرف_قيمة_مسير
): منطقي {
    طابق آخر_حصري_مخرج(الدالة, التعريفات, س1, أ) مع
    | اختياري.موجود(الملتف) -> {
        طابق آخر_حصري_مخرج(الدالة, التعريفات, س2, ب) مع
        | اختياري.موجود(ملتف2) -> {
            إذا (قيمتان_مخرج(الملتف, ملتف2) && حساب_من_مخرج(الدالة, التعريفات, الملتف, 7, أ, ب, صواب)) {
                أرجع صواب;
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع خطأ;
}

// Signed subtract: one of s1, s2 is a ^ b, the other a ^ T, T = a -% b.
عرف طرح_موقع_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    س1: معرف_قيمة_مسير,
    س2: معرف_قيمة_مسير,
    أ: معرف_قيمة_مسير,
    ب: معرف_قيمة_مسير
): منطقي {
    إذا (!حساب_من_مخرج(الدالة, التعريفات, س1, 5, أ, ب, صواب)) { أرجع خطأ; };
    طابق آخر_حصري_مخرج(الدالة, التعريفات, س2, أ) مع
    | اختياري.موجود(الملتف) -> {
        أرجع حساب_من_مخرج(الدالة, التعريفات, الملتف, 8, أ, ب, خطأ);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether الشرط is exactly the overflow test of a + b (جمع) or a - b, and
// with which signedness.
عرف اختبار_جمع_أو_طرح_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    الشرط: معرف_قيمة_مسير,
    جمع: منطقي,
    أ: معرف_قيمة_مسير,
    ب: معرف_قيمة_مسير,
    موقع: &متغير منطقي
): منطقي {
    ليكن المقارنة: مقارنة_صحيح_مسير;
    طابق مقارنة_معرفة_مخرج(الدالة, التعريفات, الشرط) مع
    | اختياري.موجود(م) -> { المقارنة := م; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن الصنف: طبيعي = رقم_مقارنة_مخرج(المقارنة.العملية);
    // Signed: (s1 & s2) <s 0.
    إذا (الصنف == 1 && ثابت_موقع_مخرج(الدالة, التعريفات, المقارنة.اليمين, 0)) {
        طابق حساب_معرف_مخرج(الدالة, التعريفات, المقارنة.اليسار) مع
        | اختياري.موجود(و_) -> {
            إذا (رقم_حساب_مخرج(و_.العملية) == 6) {
                ليكن مطابق: متغير منطقي = خطأ;
                إذا (جمع) {
                    مطابق := جمع_موقع_مخرج(الدالة, التعريفات, و_.اليسار, و_.اليمين, أ, ب)
                        || جمع_موقع_مخرج(الدالة, التعريفات, و_.اليمين, و_.اليسار, أ, ب);
                } وإلا {
                    مطابق := طرح_موقع_مخرج(الدالة, التعريفات, و_.اليسار, و_.اليمين, أ, ب)
                        || طرح_موقع_مخرج(الدالة, التعريفات, و_.اليمين, و_.اليسار, أ, ب);
                };
                إذا (مطابق) { *موقع := صواب; أرجع صواب; };
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع خطأ;
    };
    // Unsigned: x <u y, or y >u x.
    ليكن الأصغر: متغير معرف_قيمة_مسير = المقارنة.اليسار;
    ليكن الأكبر: متغير معرف_قيمة_مسير = المقارنة.اليمين;
    إذا (الصنف == 2) { الأصغر := المقارنة.اليمين; الأكبر := المقارنة.اليسار; }
    وإلا إذا (الصنف != 1) { أرجع خطأ; };
    *موقع := خطأ;
    إذا (جمع) {
        // T <u a (or b), T = a +% b.
        إذا (!قيمتان_مخرج(الأكبر, أ) && !قيمتان_مخرج(الأكبر, ب)) { أرجع خطأ; };
        أرجع حساب_من_مخرج(الدالة, التعريفات, الأصغر, 7, أ, ب, صواب);
    };
    // a <u b.
    أرجع قيمتان_مخرج(الأصغر, أ) && قيمتان_مخرج(الأكبر, ب);
}

// Whether block ك reports an overflow and traps.
عرف كتلة_بلاغ_تجاوز_مخرج(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    ك: طبيعي
): منطقي {
    ليكن المبلغ: معرف_دالة_مسير;
    طابق (*البرنامج).دالة_فشل_فحص_التشغيل مع
    | اختياري.موجود(د) -> { المبلغ := د; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    إذا ((الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي) != 0) { أرجع خطأ; };
    طابق (*الدالة).الكتل[ك].المنهي مع
    | اختياري.موجود(منهي_مسير.فخ) -> { }
    | _ -> { أرجع خطأ; };
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
        | عملية_مسير.نداء(النداء) -> {
            طابق النداء.الهدف مع
            | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                إذا (الهدف.القيمة == المبلغ.القيمة && (الطول(النداء.الحجج) مثل طبيعي) > 0) {
                    أرجع ثابت_موقع_مخرج(الدالة, التعريفات, النداء.الحجج[0], 0);
                };
            }
            | _ -> { };
        }
        | _ -> { };
        ت := ت + 1;
    }
    أرجع خطأ;
}

// The checked add, subtract or multiply at the head of block ك.
عرف حساب_مفحوص_في_رأس_مخرج(الدالة: &دالة_مسير, ك: طبيعي): اختياري حساب_صحيح_مسير {
    إذا ((الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    إذا ((الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي) != 0) { أرجع اختياري.لا_شيء(); };
    طابق (*الدالة).الكتل[ك].التعليمات[0].العملية مع
    | عملية_مسير.حساب_صحيح(ح) -> {
        ليكن الرقم: طبيعي = رقم_حساب_مخرج(ح.العملية);
        إذا (الرقم >= 1 && الرقم <= 3) { أرجع اختياري.موجود(ح); };
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether every instruction of block ك is one a test computes: constants,
// integer arithmetic, comparisons and conversions.
عرف كتلة_اختبار_نقية_مخرج(الدالة: &دالة_مسير, ك: طبيعي): منطقي {
    إذا ((الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي) != 0) { أرجع خطأ; };
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
        | عملية_مسير.ثابت(_) -> { }
        | عملية_مسير.حساب_صحيح(_) -> { }
        | عملية_مسير.مقارنة_صحيح(_) -> { }
        | عملية_مسير.تحويل_صحيح(_) -> { }
        | _ -> { أرجع خطأ; };
        ت := ت + 1;
    }
    أرجع صواب;
}

// Whether an instruction of K computes a value without effect and without a
// trap, so the test may own it: a constant, wrapping or bitwise arithmetic,
// a comparison, a widening or a reinterpretation.
عرف تعليمة_نقية_مخرج(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> { أرجع صواب; }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع صواب; }
    | عملية_مسير.حساب_صحيح(ح) -> {
        ليكن الرقم: طبيعي = رقم_حساب_مخرج(ح.العملية);
        أرجع الرقم >= 4 && الرقم <= 10;
    }
    | عملية_مسير.تحويل_صحيح(ت_) -> {
        طابق ت_.العملية مع
        | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع صواب; }
        | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع صواب; }
        | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// The successors of a test's block when its terminator is a branch without
// block arguments (a two-way or a plain branch), else none and false.
عرف خلفاء_بلا_حجج_مخرج(الكتلة: &كتلة_مسير, الناتج: &متغير متجه طبيعي): منطقي {
    طابق (*الكتلة).المنهي مع
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            إذا ((الطول(الحافة.الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
            ألحق(*الناتج, الحافة.الهدف.القيمة مثل طبيعي);
            أرجع صواب;
        }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            إذا ((الطول(عند_الصواب.الحجج) مثل طبيعي) != 0 || (الطول(عند_الخطأ.الحجج) مثل طبيعي) != 0) { أرجع خطأ; };
            ألحق(*الناتج, عند_الصواب.الهدف.القيمة مثل طبيعي);
            ألحق(*الناتج, عند_الخطأ.الهدف.القيمة مثل طبيعي);
            أرجع صواب;
        }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether every predecessor of block ب is K or in the region.
عرف سوابق_ضمن_مخرج(السوابق: &متجه متجه طبيعي, ب: طبيعي, ك: طبيعي, في_المنطقة: &متجه منطقي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السوابق)[ب]) مثل طبيعي)) {
        ليكن س: طبيعي = (*السوابق)[ب][ف];
        إذا (س != ك && !(*في_المنطقة)[س]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Adds the uses the instruction's operands make to الاستخدامات (and notes
// which entries changed).
عرف أضف_استخدامات_عملية_مخرج(
    العملية: &عملية_مسير,
    الاستخدامات: &متغير متجه طبيعي,
    المعدلة: &متغير متجه طبيعي
): فراغ {
    ليكن المعاملات: متغير متجه طبيعي = [];
    ألحق_معاملات_عملية_مسير(العملية, &متغير المعاملات);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
        ليكن ق: طبيعي = المعاملات[ف];
        إذا (ق < (الطول(*الاستخدامات) مثل طبيعي)) {
            إذا ((*الاستخدامات)[ق] == 0) { ألحق(*المعدلة, ق); };
            (*الاستخدامات)[ق] := (*الاستخدامات)[ق] + 1;
        };
        ف := ف + 1;
    }
}

عرف أضف_استخدام_مخرج(القيمة: معرف_قيمة_مسير, الاستخدامات: &متغير متجه طبيعي, المعدلة: &متغير متجه طبيعي): فراغ {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق < (الطول(*الاستخدامات) مثل طبيعي)) {
        إذا ((*الاستخدامات)[ق] == 0) { ألحق(*المعدلة, ق); };
        (*الاستخدامات)[ق] := (*الاستخدامات)[ق] + 1;
    };
}

// Whether القيمة is defined in a block of the region.
عرف معرف_في_المنطقة_مخرج(التعريفات: &تعريفات_مخرج, القيمة: معرف_قيمة_مسير, في_المنطقة: &متجه منطقي): منطقي {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*التعريفات).الكتلة) مثل طبيعي) || (*التعريفات).الكتلة[ق] == 0) { أرجع خطأ; };
    ليكن ب: طبيعي = (*التعريفات).الكتلة[ق] - 1;
    أرجع ب < (الطول(*في_المنطقة) مثل طبيعي) && (*في_المنطقة)[ب];
}

// The value, or the value a widening or reinterpretation of it reads.
عرف مصدر_توسيع_مخرج(الدالة: &دالة_مسير, التعريفات: &تعريفات_مخرج, القيمة: معرف_قيمة_مسير): معرف_قيمة_مسير {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*التعريفات).الكتلة) مثل طبيعي) || (*التعريفات).الكتلة[ق] == 0) { أرجع القيمة; };
    ليكن ك: طبيعي = (*التعريفات).الكتلة[ق] - 1;
    ليكن ت: طبيعي = (*التعريفات).التعليمة[ق];
    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        طابق التحويل.العملية مع
        | عملية_تحويل_صحيح.اقتطاع -> { أرجع القيمة; }
        | _ -> { أرجع التحويل.المصدر; };
    }
    | _ -> { أرجع القيمة; };
}

// Whether block ك computes the wrapping product of أ and ب, or of their
// widenings, in either order.
عرف ضرب_ملتف_في_كتلة_مخرج(
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    ك: طبيعي,
    أ: معرف_قيمة_مسير,
    ب: معرف_قيمة_مسير
): منطقي {
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
        | عملية_مسير.حساب_صحيح(ح) -> {
            إذا (رقم_حساب_مخرج(ح.العملية) == 9) {
                ليكن س: معرف_قيمة_مسير = مصدر_توسيع_مخرج(الدالة, التعريفات, ح.اليسار);
                ليكن ص: معرف_قيمة_مسير = مصدر_توسيع_مخرج(الدالة, التعريفات, ح.اليمين);
                إذا ((قيمتان_مخرج(س, أ) && قيمتان_مخرج(ص, ب)) || (قيمتان_مخرج(س, ب) && قيمتان_مخرج(ص, أ))) {
                    أرجع صواب;
                };
            };
        }
        | _ -> { };
        ت := ت + 1;
    }
    أرجع خطأ;
}

// The fused check whose test is block ك's terminator, if it is one.
عرف حساب_بمخرج_عند_مخرج(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    التعريفات: &تعريفات_مخرج,
    السوابق: &متجه متجه طبيعي,
    ك: طبيعي
): اختياري حساب_بمخرج_تجاوز_مسير {
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن الشرط: معرف_قيمة_مسير;
    ليكن هدف_الصواب: متغير طبيعي = 0;
    ليكن هدف_الخطأ: متغير طبيعي = 0;
    طابق (*الدالة).الكتل[ك].المنهي مع
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع_شرطي(ش, عند_الصواب, عند_الخطأ) -> {
            الشرط := ش;
            هدف_الصواب := عند_الصواب.الهدف.القيمة مثل طبيعي;
            هدف_الخطأ := عند_الخطأ.الهدف.القيمة مثل طبيعي;
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (هدف_الصواب >= عدد_الكتل || هدف_الخطأ >= عدد_الكتل) { أرجع اختياري.لا_شيء(); };
    // The region: blocks reached from K before the report block or C.
    ليكن في_المنطقة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(في_المنطقة, عدد_الكتل);
    طالما (ف < عدد_الكتل) { ألحق(في_المنطقة, خطأ); ف := ف + 1; }
    ليكن المنطقة: متغير متجه طبيعي = [];
    ليكن البارد: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن المتابعة: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن المعلقة: متغير متجه طبيعي = [];
    إذا (!خلفاء_بلا_حجج_مخرج(&(*الدالة).الكتل[ك], &متغير المعلقة)) { أرجع اختياري.لا_شيء(); };
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(المعلقة) مثل طبيعي)) {
        ليكن ب: طبيعي = المعلقة[م];
        م := م + 1;
        إذا (ب >= عدد_الكتل || ب == ك) { أرجع اختياري.لا_شيء(); };
        إذا (كتلة_بلاغ_تجاوز_مخرج(البرنامج, الدالة, التعريفات, ب)) {
            طابق البارد مع
            | اختياري.موجود(س) -> { إذا (س != ب) { أرجع اختياري.لا_شيء(); }; }
            | اختياري.لا_شيء -> { البارد := اختياري.موجود(ب); };
        } وإلا {
            طابق حساب_مفحوص_في_رأس_مخرج(الدالة, ب) مع
            | اختياري.موجود(_) -> {
                طابق المتابعة مع
                | اختياري.موجود(س) -> { إذا (س != ب) { أرجع اختياري.لا_شيء(); }; }
                | اختياري.لا_شيء -> { المتابعة := اختياري.موجود(ب); };
            }
            | اختياري.لا_شيء -> {
                إذا (!في_المنطقة[ب]) {
                    إذا ((الطول(المنطقة) مثل طبيعي) >= 8 || !كتلة_اختبار_نقية_مخرج(الدالة, ب)) {
                        أرجع اختياري.لا_شيء();
                    };
                    في_المنطقة[ب] := صواب;
                    ألحق(المنطقة, ب);
                    إذا (!خلفاء_بلا_حجج_مخرج(&(*الدالة).الكتل[ب], &متغير المعلقة)) { أرجع اختياري.لا_شيء(); };
                };
            };
        };
    }
    ليكن البارد_: طبيعي;
    ليكن المتابعة_: طبيعي;
    طابق البارد مع
    | اختياري.موجود(س) -> { البارد_ := س; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق المتابعة مع
    | اختياري.موجود(س) -> { المتابعة_ := س; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Only K and the region enter C and the region.
    إذا (!سوابق_ضمن_مخرج(السوابق, المتابعة_, ك, &في_المنطقة)) { أرجع اختياري.لا_شيء(); };
    ف := 0;
    طالما (ف < (الطول(المنطقة) مثل طبيعي)) {
        إذا (!سوابق_ضمن_مخرج(السوابق, المنطقة[ف], ك, &في_المنطقة)) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    ليكن الحساب: حساب_صحيح_مسير;
    طابق حساب_مفحوص_في_رأس_مخرج(الدالة, المتابعة_) مع
    | اختياري.موجود(ح) -> { الحساب := ح; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن الناتج: معرف_قيمة_مسير;
    طابق معرف_ناتج_تعليمة_في_مسير((*الدالة).المعرف, &(*الدالة).الكتل[المتابعة_].التعليمات[0]) مع
    | اختياري.موجود(ق) -> { الناتج := ق; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن الرقم: طبيعي = رقم_حساب_مخرج(الحساب.العملية);
    ليكن موقع: متغير منطقي = خطأ;
    ليكن إشارة_معروفة: متغير منطقي = خطأ;
    // The operands dominate K (none is the region's).
    إذا (معرف_في_المنطقة_مخرج(التعريفات, الحساب.اليسار, &في_المنطقة)
        || معرف_في_المنطقة_مخرج(التعريفات, الحساب.اليمين, &في_المنطقة)) { أرجع اختياري.لا_شيء(); };
    // A multiply's test starts in K with the wrapping product of the operands
    // (or of their widenings): it ties K to this check.
    إذا (الرقم == 3 && !ضرب_ملتف_في_كتلة_مخرج(الدالة, التعريفات, ك, الحساب.اليسار, الحساب.اليمين)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الرقم == 1 || الرقم == 2) {
        // Add and subtract: K's own test, exactly.
        إذا ((الطول(المنطقة) مثل طبيعي) != 0 || هدف_الصواب != البارد_ || هدف_الخطأ != المتابعة_) {
            أرجع اختياري.لا_شيء();
        };
        إذا (!اختبار_جمع_أو_طرح_مخرج(
            الدالة, التعريفات, الشرط, الرقم == 1, الحساب.اليسار, الحساب.اليمين, &متغير موقع
        )) { أرجع اختياري.لا_شيء(); };
        إشارة_معروفة := صواب;
    };
    ليكن السجل: حساب_بمخرج_تجاوز_مسير = {
        الكتلة: ك,
        المتابعة: المتابعة_,
        البارد: البارد_,
        المنطقة: المنطقة,
        العملية: الحساب.العملية,
        اليسار: الحساب.اليسار,
        اليمين: الحساب.اليمين,
        الناتج: الناتج,
        الشرط: الشرط,
        موقع: موقع,
        إشارة_معروفة: إشارة_معروفة
    };
    أرجع اختياري.موجود(السجل);
}

// Marks the values only the check's test computes. False when a value of
// the region is read outside the test (the check is then not fused).
عرف علّم_قيم_اختبار_مخرج(
    الدالة: &دالة_مسير,
    السجل: &حساب_بمخرج_تجاوز_مسير,
    الكلية: &متجه طبيعي,
    الاختبار: &متغير متجه طبيعي,
    المعدلة: &متغير متجه طبيعي,
    قيم_الاختبار: &متغير متجه منطقي
): منطقي {
    ليكن ك: طبيعي = (*السجل).الكتلة;
    // The test's reads: K's condition and everything the region computes.
    أضف_استخدام_مخرج((*السجل).الشرط, الاختبار, المعدلة);
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ب: طبيعي = (*السجل).المنطقة[ر];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي)) {
            أضف_استخدامات_عملية_مخرج(&(*الدالة).الكتل[ب].التعليمات[ت].العملية, الاختبار, المعدلة);
            ت := ت + 1;
        }
        طابق (*الدالة).الكتل[ب].المنهي مع
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع_شرطي(ش, _, _) -> { أضف_استخدام_مخرج(ش, الاختبار, المعدلة); }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        ر := ر + 1;
    }
    // Every value the region defines is read only by the test.
    ر := 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ب: طبيعي = (*السجل).المنطقة[ر];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي)) {
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ب].التعليمات[ت]) مع
            | اختياري.موجود(ق) -> {
                إذا (ق >= (الطول(*الكلية) مثل طبيعي) || (*الكلية)[ق] != (*الاختبار)[ق]) { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ر := ر + 1;
    }
    // K's values, last first: one every read of which is the test's joins it.
    ليكن العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
    ليكن المملوكة: متغير متجه طبيعي = [];
    ليكن ت: متغير طبيعي = العدد;
    طالما (ت > 0) {
        ت := ت - 1;
        ليكن التعليمة: &تعليمة_مسير = &(*الدالة).الكتل[ك].التعليمات[ت];
        طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
        | اختياري.موجود(ق) -> {
            إذا (ق < (الطول(*الكلية) مثل طبيعي) && (*الكلية)[ق] > 0 && (*الكلية)[ق] == (*الاختبار)[ق]
                && تعليمة_نقية_مخرج(&(*التعليمة).العملية)) {
                ألحق(المملوكة, ق);
                أضف_استخدامات_عملية_مخرج(&(*التعليمة).العملية, الاختبار, المعدلة);
            };
        }
        | اختياري.لا_شيء -> { };
    }
    ر := 0;
    طالما (ر < (الطول(المملوكة) مثل طبيعي)) { (*قيم_الاختبار)[المملوكة[ر]] := صواب; ر := ر + 1; }
    ر := 0;
    طالما (ر < (الطول((*السجل).المنطقة) مثل طبيعي)) {
        ليكن ب: طبيعي = (*السجل).المنطقة[ر];
        ليكن ت2: متغير طبيعي = 0;
        طالما (ت2 < (الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي)) {
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ب].التعليمات[ت2]) مع
            | اختياري.موجود(ق) -> { (*قيم_الاختبار)[ق] := صواب; }
            | اختياري.لا_شيء -> { };
            ت2 := ت2 + 1;
        }
        ر := ر + 1;
    }
    أرجع صواب;
}

// No checks (a function a consumer does not fuse).
عام عرف حسابات_بمخرج_تجاوز_فارغة_مسير(): حسابات_بمخرج_تجاوز_مسير {
    ليكن الحسابات: متجه حساب_بمخرج_تجاوز_مسير = [];
    ليكن الكتل: متجه طبيعي = [];
    ليكن المتابعات: متجه طبيعي = [];
    ليكن القيم: متجه منطقي = [];
    ليكن الناتج: حسابات_بمخرج_تجاوز_مسير = {
        الحسابات: الحسابات, اختبار_الكتلة: الكتل, متابعة_الكتلة: المتابعات, قيم_الاختبار: القيم
    };
    أرجع الناتج;
}

// The function's checks with an overflow exit.
عام عرف حسابات_بمخرج_تجاوز_مسير_في(البرنامج: &برنامج_مسير, الدالة: &دالة_مسير): حسابات_بمخرج_تجاوز_مسير {
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن عدد_القيم: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    ليكن الحسابات: متغير متجه حساب_بمخرج_تجاوز_مسير = [];
    ليكن اختبار_الكتلة: متغير متجه طبيعي = [];
    ليكن متابعة_الكتلة: متغير متجه طبيعي = [];
    ليكن قيم_الاختبار: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(اختبار_الكتلة, عدد_الكتل);
    احجز_سعة(متابعة_الكتلة, عدد_الكتل);
    طالما (ف < عدد_الكتل) { ألحق(اختبار_الكتلة, 0); ألحق(متابعة_الكتلة, 0); ف := ف + 1; }
    ف := 0;
    احجز_سعة(قيم_الاختبار, عدد_القيم);
    طالما (ف < عدد_القيم) { ألحق(قيم_الاختبار, خطأ); ف := ف + 1; }
    ليكن بلا_شيء: حسابات_بمخرج_تجاوز_مسير = {
        الحسابات: الحسابات,
        اختبار_الكتلة: اختبار_الكتلة,
        متابعة_الكتلة: متابعة_الكتلة,
        قيم_الاختبار: قيم_الاختبار
    };
    طابق (*البرنامج).دالة_فشل_فحص_التشغيل مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { أرجع بلا_شيء; };
    // Only a function with a report block can hold a check.
    ليكن أي_فخ: متغير منطقي = خطأ;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل && !أي_فخ) {
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فخ) -> { أي_فخ := صواب; }
        | _ -> { };
        ك := ك + 1;
    }
    إذا (!أي_فخ) { أرجع بلا_شيء; };
    ليكن الناتج: متغير حسابات_بمخرج_تجاوز_مسير = بلا_شيء;
    ليكن التعريفات: تعريفات_مخرج = تعريفات_دالة_مخرج(الدالة);
    ليكن السوابق: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الكتل) { ليكن فارغة: متجه طبيعي = []; ألحق(السوابق, فارغة); ف := ف + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        ليكن خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            ليكن ه: طبيعي = الخلفاء[خ].القيمة مثل طبيعي;
            إذا (ه < عدد_الكتل) { ألحق(السوابق[ه], ك); };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    ليكن الكلية: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, عدد_القيم);
    ليكن الاختبار: متغير متجه طبيعي = [];
    ف := 0;
    احجز_سعة(الاختبار, عدد_القيم);
    طالما (ف < عدد_القيم) { ألحق(الاختبار, 0); ف := ف + 1; }
    ليكن المعدلة: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        طابق حساب_بمخرج_عند_مخرج(البرنامج, الدالة, &التعريفات, &السوابق, ك) مع
        | اختياري.موجود(السجل) -> {
            // Each block is one check's continuation at most.
            إذا (الناتج.متابعة_الكتلة[السجل.المتابعة] == 0
                && علّم_قيم_اختبار_مخرج(
                    الدالة, &السجل, &الكلية, &متغير الاختبار, &متغير المعدلة, &متغير الناتج.قيم_الاختبار
                )) {
                ليكن الرقم: طبيعي = (الطول(الناتج.الحسابات) مثل طبيعي) + 1;
                الناتج.اختبار_الكتلة[ك] := الرقم;
                الناتج.متابعة_الكتلة[السجل.المتابعة] := الرقم;
                ألحق(الناتج.الحسابات, السجل);
            };
            ليكن ر: متغير طبيعي = 0;
            طالما (ر < (الطول(المعدلة) مثل طبيعي)) { الاختبار[المعدلة[ر]] := 0; ر := ر + 1; }
            ليكن فارغة: متجه طبيعي = [];
            المعدلة := فارغة;
        }
        | اختياري.لا_شيء -> { };
        ك := ك + 1;
    }
    أرجع الناتج;
}
