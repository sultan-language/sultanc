استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.diagnostics.primitive_names;

// The MSIR program as text (`--emit=msir`), after the optimization pipeline,
// as `--emit=llvm-ir` prints the optimized module: a reading aid, not an
// input format. Every identity is printed by its number, the one the
// verifier and the debug data use: functions `@N`, external functions
// `@extern.N`, globals `@global.N`, blocks `bN`, values `%N` and Types `tN`
// (MSIR carries Type IDs only). A function the debug data names carries its
// source name. Operation mnemonics are the stable machine names of a format
// (like LLVM's), not prose, so they are not localized; a primitive is named
// by its stable diagnostic name (compiler/diagnostics/primitive_names.sn).
//
//   extern @extern.0 "write" (t3, t9, t3) -> t3
//   global @global.0: t9 = text "hi"
//   fn @4 "main"() -> t3 {
//     entry b0
//   b0:
//     %0: t3 = const 0
//     ret %0
//   }

عرف ألحق_طبيعيا_نص_مسير(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق_بايتات_نص(الناتج, طبيعي_إلى_نص(القيمة));
}

عرف ألحق_قيمة_نص_مسير(الناتج: &متغير متجه ط8, القيمة: معرف_قيمة_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «%»);
    ألحق_طبيعيا_نص_مسير(الناتج, القيمة.القيمة مثل طبيعي);
}

عرف ألحق_نوع_نص_مسير(الناتج: &متغير متجه ط8, النوع: معرف_نوع): فراغ {
    ألحق_بايتات_نص(الناتج, «t»);
    ألحق_طبيعيا_نص_مسير(الناتج, النوع.القيمة مثل طبيعي);
}

عرف ألحق_كتلة_نص_مسير(الناتج: &متغير متجه ط8, الكتلة: معرف_كتلة_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «b»);
    ألحق_طبيعيا_نص_مسير(الناتج, الكتلة.القيمة مثل طبيعي);
}

عرف ألحق_دالة_نص_مسير(الناتج: &متغير متجه ط8, الدالة: معرف_دالة_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «@»);
    ألحق_طبيعيا_نص_مسير(الناتج, الدالة.القيمة مثل طبيعي);
}

عرف ألحق_خارجية_نص_مسير(الناتج: &متغير متجه ط8, الدالة: معرف_دالة_خارجية_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «@extern.»);
    ألحق_طبيعيا_نص_مسير(الناتج, الدالة.القيمة مثل طبيعي);
}

عرف ألحق_عاما_نص_مسير(الناتج: &متغير متجه ط8, العام: معرف_عام_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «@global.»);
    ألحق_طبيعيا_نص_مسير(الناتج, العام.القيمة مثل طبيعي);
}

// Bytes in double quotes: a quote, a backslash and the ASCII control bytes
// are escaped (`\"`, `\\`, `\n`, `\t`, `\xHH`); every other byte, UTF-8
// included, is written as it is.
عرف ألحق_بايتات_مقتبسة_نص_مسير(الناتج: &متغير متجه ط8, البايتات: &متجه ط8): فراغ {
    ليكن الأرقام: متجه ط8 = بايتات_من_نص(«0123456789abcdef»);
    ألحق(*الناتج, 0x22);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        ليكن ب: ط8 = (*البايتات)[ف];
        إذا (ب == 0x22 || ب == 0x5C) {
            ألحق(*الناتج, 0x5C);
            ألحق(*الناتج, ب);
        } وإلا إذا (ب == 0x0A) {
            ألحق_بايتات_نص(الناتج, «\n»);
        } وإلا إذا (ب == 0x09) {
            ألحق_بايتات_نص(الناتج, «\t»);
        } وإلا إذا (ب < 0x20 || ب == 0x7F) {
            ألحق_بايتات_نص(الناتج, «\x»);
            ألحق(*الناتج, الأرقام[((ب >> 4) & 0x0F) مثل طبيعي]);
            ألحق(*الناتج, الأرقام[(ب & 0x0F) مثل طبيعي]);
        } وإلا {
            ألحق(*الناتج, ب);
        };
        ف := ف + 1;
    }
    ألحق(*الناتج, 0x22);
}

// `%a, %b, %c`
عرف ألحق_قيما_نص_مسير(الناتج: &متغير متجه ط8, القيم: &متجه معرف_قيمة_مسير): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
        ألحق_قيمة_نص_مسير(الناتج, (*القيم)[ف]);
        ف := ف + 1;
    }
}

// `(t1, t2)`
عرف ألحق_أنواعا_نص_مسير(الناتج: &متغير متجه ط8, الأنواع: &متجه معرف_نوع): فراغ {
    ألحق_بايتات_نص(الناتج, «(»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنواع) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
        ألحق_نوع_نص_مسير(الناتج, (*الأنواع)[ف]);
        ف := ف + 1;
    }
    ألحق_بايتات_نص(الناتج, «)»);
}

عرف ألحق_ناتجا_نص_مسير(الناتج: &متغير متجه ط8, النوع: &اختياري معرف_نوع): فراغ {
    طابق *النوع مع
    | اختياري.موجود(ن) -> {
        ألحق_بايتات_نص(الناتج, « -> »);
        ألحق_نوع_نص_مسير(الناتج, ن);
    }
    | اختياري.لا_شيء -> { };
}

عرف ألحق_ثابتا_نص_مسير(الناتج: &متغير متجه ط8, الثابت: &ثابت_مسير): فراغ {
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> {
        إذا (القيمة) { ألحق_بايتات_نص(الناتج, «true»); } وإلا { ألحق_بايتات_نص(الناتج, «false»); };
    }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { ألحق_بايتات_نص(الناتج, عدد_إلى_نص(القيمة)); }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        ألحق_طبيعيا_نص_مسير(الناتج, القيمة);
        ألحق_بايتات_نص(الناتج, «u»);
    }
    | ثابت_مسير.مؤشر_فارغ -> { ألحق_بايتات_نص(الناتج, «null»); }
    | ثابت_مسير.عشري(البايتات) -> {
        ألحق_بايتات_نص(الناتج, «float »);
        ألحق_بايتات_مقتبسة_نص_مسير(الناتج, &البايتات);
    }
    | ثابت_مسير.نص(البايتات) -> {
        ألحق_بايتات_نص(الناتج, «text »);
        ألحق_بايتات_مقتبسة_نص_مسير(الناتج, &البايتات);
    }
    | ثابت_مسير.متجه(العناصر) -> {
        ألحق_بايتات_نص(الناتج, «[»);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
            ألحق_ثابتا_نص_مسير(الناتج, &العناصر[ف]);
            ف := ف + 1;
        }
        ألحق_بايتات_نص(الناتج, «]»);
    }
    | ثابت_مسير.دالة(المعرف) -> { ألحق_دالة_نص_مسير(الناتج, المعرف); };
}

عرف اسم_حساب_صحيح_نص_مسير(العملية: عملية_حساب_صحيح): نص {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع «int.add»; }
    | عملية_حساب_صحيح.طرح -> { أرجع «int.sub»; }
    | عملية_حساب_صحيح.ضرب -> { أرجع «int.mul»; }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع «int.sdiv»; }
    | عملية_حساب_صحيح.قسمة_طبيعية -> { أرجع «int.udiv»; }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع «int.srem»; }
    | عملية_حساب_صحيح.باقي_طبيعي -> { أرجع «int.urem»; }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع «int.or»; }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع «int.xor»; }
    | عملية_حساب_صحيح.و_بتي -> { أرجع «int.and»; }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع «int.shl»; }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع «int.lshr»; }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع «int.ashr»; }
    | عملية_حساب_صحيح.جمع_ملتف -> { أرجع «int.add.wrap»; }
    | عملية_حساب_صحيح.طرح_ملتف -> { أرجع «int.sub.wrap»; }
    | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع «int.mul.wrap»; }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع «int.shl.wrap»; };
}

عرف اسم_مقارنة_صحيح_نص_مسير(العملية: عملية_مقارنة_صحيح): نص {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> { أرجع «int.eq»; }
    | عملية_مقارنة_صحيح.لا_يساوي -> { أرجع «int.ne»; }
    | عملية_مقارنة_صحيح.أصغر -> { أرجع «int.lt»; }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> { أرجع «int.le»; }
    | عملية_مقارنة_صحيح.أكبر -> { أرجع «int.gt»; }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> { أرجع «int.ge»; };
}

عرف اسم_حساب_عشري_نص_مسير(العملية: عملية_حساب_عشري): نص {
    طابق العملية مع
    | عملية_حساب_عشري.جمع -> { أرجع «float.add»; }
    | عملية_حساب_عشري.طرح -> { أرجع «float.sub»; }
    | عملية_حساب_عشري.ضرب -> { أرجع «float.mul»; }
    | عملية_حساب_عشري.قسمة -> { أرجع «float.div»; };
}

عرف اسم_مقارنة_عشري_نص_مسير(العملية: عملية_مقارنة_عشري): نص {
    طابق العملية مع
    | عملية_مقارنة_عشري.يساوي -> { أرجع «float.eq»; }
    | عملية_مقارنة_عشري.لا_يساوي -> { أرجع «float.ne»; }
    | عملية_مقارنة_عشري.أصغر -> { أرجع «float.lt»; }
    | عملية_مقارنة_عشري.أصغر_أو_يساوي -> { أرجع «float.le»; }
    | عملية_مقارنة_عشري.أكبر -> { أرجع «float.gt»; }
    | عملية_مقارنة_عشري.أكبر_أو_يساوي -> { أرجع «float.ge»; };
}

عرف اسم_تحويل_صحيح_نص_مسير(العملية: عملية_تحويل_صحيح): نص {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> { أرجع «int.sext»; }
    | عملية_تحويل_صحيح.توسيع_صفري -> { أرجع «int.zext»; }
    | عملية_تحويل_صحيح.اقتطاع -> { أرجع «int.trunc»; }
    | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع «int.bitcast»; };
}

عرف اسم_تحويل_عائم_نص_مسير(العملية: عملية_تحويل_عائم): نص {
    طابق العملية مع
    | عملية_تحويل_عائم.عائم_إلى_موقع -> { أرجع «float.to_signed»; }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> { أرجع «float.to_unsigned»; }
    | عملية_تحويل_عائم.موقع_إلى_عائم -> { أرجع «float.from_signed»; }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> { أرجع «float.from_unsigned»; }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> { أرجع «float.resize»; };
}

عرف ألحق_ثنائيا_نص_مسير(
    الناتج: &متغير متجه ط8, الاسم: نص, اليسار: معرف_قيمة_مسير, اليمين: معرف_قيمة_مسير
): فراغ {
    ألحق_بايتات_نص(الناتج, الاسم);
    ألحق_بايتات_نص(الناتج, « »);
    ألحق_قيمة_نص_مسير(الناتج, اليسار);
    ألحق_بايتات_نص(الناتج, «, »);
    ألحق_قيمة_نص_مسير(الناتج, اليمين);
}

عرف ألحق_أحاديا_نص_مسير(الناتج: &متغير متجه ط8, الاسم: نص, القيمة: معرف_قيمة_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, الاسم);
    ألحق_بايتات_نص(الناتج, « »);
    ألحق_قيمة_نص_مسير(الناتج, القيمة);
}

عرف ألحق_قيمة_ورقما_نص_مسير(
    الناتج: &متغير متجه ط8, الاسم: نص, القيمة: معرف_قيمة_مسير, الرقم: طبيعي
): فراغ {
    ألحق_أحاديا_نص_مسير(الناتج, الاسم, القيمة);
    ألحق_بايتات_نص(الناتج, «, »);
    ألحق_طبيعيا_نص_مسير(الناتج, الرقم);
}

عرف ألحق_إذن_ذاكرة_نص_مسير(الناتج: &متغير متجه ط8, الإذن: إذن_ذاكرة_نداء_مسير): فراغ {
    طابق الإذن مع
    | إذن_ذاكرة_نداء_مسير.قراءة -> { ألحق_بايتات_نص(الناتج, «read»); }
    | إذن_ذاكرة_نداء_مسير.كتابة -> { ألحق_بايتات_نص(الناتج, «write»); }
    | إذن_ذاكرة_نداء_مسير.قراءة_وكتابة -> { ألحق_بايتات_نص(الناتج, «read-write»); };
}

// `call TARGET(%a, %b)`, then the call's place, memory ranges and kernel
// contract when it has them.
عرف ألحق_نداء_نص_مسير(الناتج: &متغير متجه ط8, النداء: &نداء_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «call »);
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الدالة) -> { ألحق_دالة_نص_مسير(الناتج, الدالة); }
    | هدف_نداء_مسير.دالة_خارجية(الدالة) -> { ألحق_خارجية_نص_مسير(الناتج, الدالة); }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        ألحق_بايتات_نص(الناتج, «primitive.»);
        ألحق_بايتات_نص(الناتج, نص_هوية_بدائي_تشخيصية(البدائي));
    }
    | هدف_نداء_مسير.قيمة_دالة(القيمة) -> { ألحق_قيمة_نص_مسير(الناتج, القيمة); };
    ألحق_بايتات_نص(الناتج, «(»);
    ألحق_قيما_نص_مسير(الناتج, &(*النداء).الحجج);
    ألحق_بايتات_نص(الناتج, «)»);
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(المكان) -> {
        ألحق_بايتات_نص(الناتج, « place »);
        ألحق_قيمة_نص_مسير(الناتج, المكان);
    }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).نطاقات_الذاكرة) مثل طبيعي)) {
        ليكن النطاق: &نطاق_ذاكرة_نداء_مسير = &(*النداء).نطاقات_الذاكرة[ف];
        ألحق_بايتات_نص(الناتج, « memory(arg »);
        ألحق_طبيعيا_نص_مسير(الناتج, (*النطاق).فهرس_الحجة);
        ألحق_بايتات_نص(الناتج, «: »);
        ألحق_قيمة_نص_مسير(الناتج, (*النطاق).المؤشر);
        ألحق_بايتات_نص(الناتج, « in »);
        ألحق_قيمة_نص_مسير(الناتج, (*النطاق).الأصل);
        ألحق_بايتات_نص(الناتج, « length »);
        ألحق_قيمة_نص_مسير(الناتج, (*النطاق).الطول);
        طابق (*النطاق).المطلوب مع
        | اختياري.موجود(المطلوب) -> {
            ألحق_بايتات_نص(الناتج, « at most »);
            ألحق_قيمة_نص_مسير(الناتج, المطلوب);
        }
        | اختياري.لا_شيء -> { };
        ألحق_بايتات_نص(الناتج, « »);
        ألحق_إذن_ذاكرة_نص_مسير(الناتج, (*النطاق).الإذن);
        ألحق_بايتات_نص(الناتج, «)»);
        ف := ف + 1;
    }
    طابق (*النداء).عقد_النواة مع
    | اختياري.موجود(العقد) -> {
        ألحق_بايتات_نص(الناتج, « kernel(symbol »);
        ألحق_طبيعيا_نص_مسير(الناتج, العقد.المنشئ.القيمة مثل طبيعي);
        ألحق_بايتات_نص(الناتج, «, order »);
        ألحق_طبيعيا_نص_مسير(الناتج, العقد.الترتيب);
        ألحق_بايتات_نص(الناتج, «, selector »);
        ألحق_دالة_نص_مسير(الناتج, العقد.المنتقي);
        ألحق_بايتات_نص(الناتج, «, number »);
        ألحق_قيمة_نص_مسير(الناتج, العقد.الرقم);
        ألحق_بايتات_نص(الناتج, «)»);
    }
    | اختياري.لا_شيء -> { };
}

عرف ألحق_عملية_نص_مسير(الناتج: &متغير متجه ط8, العملية: &عملية_مسير): فراغ {
    طابق *العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        ألحق_بايتات_نص(الناتج, «const »);
        ألحق_ثابتا_نص_مسير(الناتج, &الثابت);
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        ألحق_ثنائيا_نص_مسير(الناتج, اسم_حساب_صحيح_نص_مسير(ح.العملية), ح.اليسار, ح.اليمين);
    }
    | عملية_مسير.مقارنة_صحيح(م) -> {
        ألحق_ثنائيا_نص_مسير(الناتج, اسم_مقارنة_صحيح_نص_مسير(م.العملية), م.اليسار, م.اليمين);
    }
    | عملية_مسير.حساب_عشري(ح) -> {
        ألحق_ثنائيا_نص_مسير(الناتج, اسم_حساب_عشري_نص_مسير(ح.العملية), ح.اليسار, ح.اليمين);
    }
    | عملية_مسير.مقارنة_عشري(م) -> {
        ألحق_ثنائيا_نص_مسير(الناتج, اسم_مقارنة_عشري_نص_مسير(م.العملية), م.اليسار, م.اليمين);
    }
    | عملية_مسير.تحويل_صحيح(ت) -> {
        ألحق_أحاديا_نص_مسير(الناتج, اسم_تحويل_صحيح_نص_مسير(ت.العملية), ت.المصدر);
    }
    | عملية_مسير.تحويل_عائم(ت) -> {
        ألحق_أحاديا_نص_مسير(الناتج, اسم_تحويل_عائم_نص_مسير(ت.العملية), ت.المصدر);
    }
    | عملية_مسير.مرجع_إلى_مؤشر(م) -> { ألحق_أحاديا_نص_مسير(الناتج, «ref.to_pointer», م.المرجع); }
    | عملية_مسير.نقل_تسلسل_مملوك(ن) -> { ألحق_أحاديا_نص_مسير(الناتج, «sequence.move», ن.المصدر); }
    | عملية_مسير.تجميع(ت) -> {
        ألحق_بايتات_نص(الناتج, «aggregate (»);
        ألحق_قيما_نص_مسير(الناتج, &ت.الأعضاء);
        ألحق_بايتات_نص(الناتج, «)»);
    }
    | عملية_مسير.تهيئة_متجه(ت) -> {
        ألحق_بايتات_نص(الناتج, «vector [»);
        ألحق_قيما_نص_مسير(الناتج, &ت.العناصر);
        ألحق_بايتات_نص(الناتج, «]»);
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> { ألحق_قيمة_ورقما_نص_مسير(الناتج, «field», الاستخراج.المصدر, الاستخراج.الفهرس); }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> { ألحق_ثنائيا_نص_مسير(الناتج, «element», الاستخراج.المصدر, الاستخراج.الفهرس); }
    | عملية_مسير.مكان_محلي(م) -> {
        ألحق_بايتات_نص(الناتج, «place.local»);
        إذا (م.قابل_للكتابة) { ألحق_بايتات_نص(الناتج, « mutable»); };
        طابق م.المحلي مع
        | اختياري.موجود(الرمز) -> {
            ألحق_بايتات_نص(الناتج, « symbol »);
            ألحق_طبيعيا_نص_مسير(الناتج, الرمز.القيمة مثل طبيعي);
        }
        | اختياري.لا_شيء -> { };
    }
    | عملية_مسير.مكان_عام(م) -> {
        ألحق_بايتات_نص(الناتج, «place.global »);
        ألحق_عاما_نص_مسير(الناتج, م.العام);
        إذا (م.قابل_للكتابة) { ألحق_بايتات_نص(الناتج, « mutable»); };
    }
    | عملية_مسير.مرجع_إلى_مكان(م) -> { ألحق_أحاديا_نص_مسير(الناتج, «place.of_reference», م.المرجع); }
    | عملية_مسير.صندوق_إلى_مكان(ص) -> { ألحق_أحاديا_نص_مسير(الناتج, «place.of_box», ص.الصندوق); }
    | عملية_مسير.مكان_حقل(م) -> { ألحق_قيمة_ورقما_نص_مسير(الناتج, «place.field», م.الأصل, م.الفهرس); }
    | عملية_مسير.مكان_فهرس(م) -> { ألحق_ثنائيا_نص_مسير(الناتج, «place.element», م.الأصل, م.الفهرس); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(م) -> {
        ألحق_ثنائيا_نص_مسير(الناتج, «place.pointer_element», م.المؤشر, م.الفهرس);
    }
    | عملية_مسير.تحميل(ت) -> { ألحق_أحاديا_نص_مسير(الناتج, «load», ت.المكان); }
    | عملية_مسير.تخزين(ت) -> { ألحق_ثنائيا_نص_مسير(الناتج, «store», ت.المكان, ت.القيمة); }
    | عملية_مسير.مكان_إلى_مرجع(م) -> { ألحق_أحاديا_نص_مسير(الناتج, «reference.of_place», م.المكان); }
    | عملية_مسير.بناء_موسوم(ب) -> {
        ألحق_بايتات_نص(الناتج, «tagged »);
        ألحق_طبيعيا_نص_مسير(الناتج, ب.المنشئ);
        ألحق_بايتات_نص(الناتج, « (»);
        ألحق_قيما_نص_مسير(الناتج, &ب.الحمولات);
        ألحق_بايتات_نص(الناتج, «)»);
    }
    | عملية_مسير.استعلام_وسم(الاستخراج) -> { ألحق_أحاديا_نص_مسير(الناتج, «tag», الاستخراج.المصدر); }
    | عملية_مسير.استخراج_حمولة(الاستخراج) -> {
        ألحق_قيمة_ورقما_نص_مسير(الناتج, «payload», الاستخراج.المصدر, الاستخراج.المنشئ);
        ألحق_بايتات_نص(الناتج, «, »);
        ألحق_طبيعيا_نص_مسير(الناتج, الاستخراج.الحمولة);
    }
    | عملية_مسير.بناء_صندوق(ب) -> { ألحق_أحاديا_نص_مسير(الناتج, «box», ب.القيمة); }
    | عملية_مسير.بناء_إغلاق(ب) -> {
        ألحق_بايتات_نص(الناتج, «closure »);
        ألحق_دالة_نص_مسير(الناتج, ب.الدالة);
        ألحق_بايتات_نص(الناتج, «(»);
        ألحق_قيما_نص_مسير(الناتج, &ب.الالتقاطات);
        ألحق_بايتات_نص(الناتج, «)»);
        طابق ب.المدمر مع
        | اختياري.موجود(المدمر) -> {
            ألحق_بايتات_نص(الناتج, « destroy »);
            ألحق_دالة_نص_مسير(الناتج, المدمر);
        }
        | اختياري.لا_شيء -> { };
        إذا (ب.البيئة_الساكنة) { ألحق_بايتات_نص(الناتج, « static»); };
    }
    | عملية_مسير.استخراج_التقاط(الاستخراج) -> {
        ألحق_بايتات_نص(الناتج, «capture »);
        ألحق_طبيعيا_نص_مسير(الناتج, الاستخراج.الفهرس);
    }
    | عملية_مسير.نداء(النداء) -> { ألحق_نداء_نص_مسير(الناتج, &النداء); }
    | عملية_مسير.ملكية_مكان(م) -> {
        طابق م.الحدث مع
        | حدث_ملكية_مسير.تصريح -> { ألحق_أحاديا_نص_مسير(الناتج, «local.declare», م.المكان); }
        | حدث_ملكية_مسير.تهيئة -> { ألحق_أحاديا_نص_مسير(الناتج, «owner.initialize», م.المكان); }
        | حدث_ملكية_مسير.تسليم -> { ألحق_أحاديا_نص_مسير(الناتج, «owner.give_up», م.المكان); }
        | حدث_ملكية_مسير.إسقاط -> { ألحق_أحاديا_نص_مسير(الناتج, «owner.drop», م.المكان); };
    };
}

// `b1(%a, %b)`; a block without arguments is `b1`.
عرف ألحق_حافة_نص_مسير(الناتج: &متغير متجه ط8, الحافة: &حافة_مسير): فراغ {
    ألحق_كتلة_نص_مسير(الناتج, (*الحافة).الهدف);
    إذا ((الطول((*الحافة).الحجج) مثل طبيعي) > 0) {
        ألحق_بايتات_نص(الناتج, «(»);
        ألحق_قيما_نص_مسير(الناتج, &(*الحافة).الحجج);
        ألحق_بايتات_نص(الناتج, «)»);
    };
}

عرف ألحق_منهيا_قائما_نص_مسير(الناتج: &متغير متجه ط8, المنهي: &منهي_مسير): فراغ {
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        ألحق_بايتات_نص(الناتج, «br »);
        ألحق_حافة_نص_مسير(الناتج, &الحافة);
    }
    | منهي_مسير.فرع_شرطي(الشرط, الصحيح, الخاطئ) -> {
        ألحق_بايتات_نص(الناتج, «br »);
        ألحق_قيمة_نص_مسير(الناتج, الشرط);
        ألحق_بايتات_نص(الناتج, «, »);
        ألحق_حافة_نص_مسير(الناتج, &الصحيح);
        ألحق_بايتات_نص(الناتج, «, »);
        ألحق_حافة_نص_مسير(الناتج, &الخاطئ);
    }
    | منهي_مسير.فرع_متعدد(المتعدد) -> {
        ألحق_بايتات_نص(الناتج, «switch »);
        ألحق_قيمة_نص_مسير(الناتج, المتعدد.المميز);
        ألحق_بايتات_نص(الناتج, « [»);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المتعدد.الحالات) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
            ألحق_طبيعيا_نص_مسير(الناتج, المتعدد.الحالات[ف].الوسم);
            ألحق_بايتات_نص(الناتج, «: »);
            ألحق_حافة_نص_مسير(الناتج, &المتعدد.الحالات[ف].الحافة);
            ف := ف + 1;
        }
        ألحق_بايتات_نص(الناتج, «] default »);
        ألحق_حافة_نص_مسير(الناتج, &المتعدد.الافتراضي);
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        ألحق_بايتات_نص(الناتج, «ret»);
        طابق القيمة مع
        | اختياري.موجود(ق) -> {
            ألحق_بايتات_نص(الناتج, « »);
            ألحق_قيمة_نص_مسير(الناتج, ق);
        }
        | اختياري.لا_شيء -> { };
    }
    | منهي_مسير.فخ -> { ألحق_بايتات_نص(الناتج, «trap»); };
}

عرف ألحق_منهيا_نص_مسير(الناتج: &متغير متجه ط8, المنهي: &اختياري منهي_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «  »);
    طابق *المنهي مع
    | اختياري.لا_شيء -> { ألحق_بايتات_نص(الناتج, «unterminated»); }
    | اختياري.موجود(القائم) -> { ألحق_منهيا_قائما_نص_مسير(الناتج, &القائم); };
    ألحق_بايتات_نص(الناتج, "\n");
}

// `%N: tT`, the Type taken from the function's values.
عرف ألحق_قيمة_بنوعها_نص_مسير(الناتج: &متغير متجه ط8, القيمة: &قيمة_مسير): فراغ {
    ألحق_قيمة_نص_مسير(الناتج, (*القيمة).المعرف);
    ألحق_بايتات_نص(الناتج, «: »);
    ألحق_نوع_نص_مسير(الناتج, (*القيمة).النوع);
}

عرف ألحق_تعليمة_نص_مسير(الناتج: &متغير متجه ط8, الدالة: &دالة_مسير, التعليمة: &تعليمة_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «  »);
    طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
    | اختياري.موجود(القيمة) -> {
        ألحق_قيمة_بنوعها_نص_مسير(الناتج, &القيمة);
        ألحق_بايتات_نص(الناتج, « = »);
    }
    | اختياري.لا_شيء -> { };
    إذا ((*التعليمة).تقييم_وقت_الترجمة) { ألحق_بايتات_نص(الناتج, «comptime »); };
    ألحق_عملية_نص_مسير(الناتج, &(*التعليمة).العملية);
    ألحق_بايتات_نص(الناتج, "\n");
}

عرف ألحق_كتلة_كاملة_نص_مسير(الناتج: &متغير متجه ط8, الدالة: &دالة_مسير, الكتلة: &كتلة_مسير): فراغ {
    ألحق_كتلة_نص_مسير(الناتج, (*الكتلة).المعرف);
    إذا ((الطول((*الكتلة).المعاملات) مثل طبيعي) > 0) {
        ألحق_بايتات_نص(الناتج, «(»);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الكتلة).المعاملات) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
            ألحق_قيمة_بنوعها_نص_مسير(الناتج, &(*الكتلة).المعاملات[ف]);
            ف := ف + 1;
        }
        ألحق_بايتات_نص(الناتج, «)»);
    };
    ألحق_بايتات_نص(الناتج, ":\n");
    ليكن ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
        ألحق_تعليمة_نص_مسير(الناتج, الدالة, &(*الكتلة).التعليمات[ت]);
        ت := ت + 1;
    }
    ألحق_منهيا_نص_مسير(الناتج, &(*الكتلة).المنهي);
}

// The source name the debug data gives the function, when it gives one.
عرف ألحق_اسم_دالة_نص_مسير(الناتج: &متغير متجه ط8, الدالة: معرف_دالة_مسير, التصحيح: &بيانات_تصحيح_مسير): فراغ {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.موجود(معرف_التصحيح) -> {
        إذا (معرف_التصحيح.القيمة < (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) {
            ليكن الاسم: &متجه ط8 = &(*التصحيح).الدلالي.الدوال[معرف_التصحيح.القيمة].الاسم;
            إذا ((الطول(*الاسم) مثل طبيعي) > 0) {
                ألحق_بايتات_نص(الناتج, « »);
                ألحق_بايتات_مقتبسة_نص_مسير(الناتج, الاسم);
            };
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف ألحق_دالة_كاملة_نص_مسير(الناتج: &متغير متجه ط8, الدالة: &دالة_مسير, التصحيح: &بيانات_تصحيح_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «fn »);
    ألحق_دالة_نص_مسير(الناتج, (*الدالة).المعرف);
    ألحق_اسم_دالة_نص_مسير(الناتج, (*الدالة).المعرف, التصحيح);
    ألحق_بايتات_نص(الناتج, «(»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايتات_نص(الناتج, «, »); };
        إذا (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي) && (*الدالة).معاملات_وقت_الترجمة[ف]) {
            ألحق_بايتات_نص(الناتج, «comptime »);
        };
        ألحق_قيمة_بنوعها_نص_مسير(الناتج, &(*الدالة).المعاملات[ف]);
        ف := ف + 1;
    }
    ألحق_بايتات_نص(الناتج, «)»);
    ألحق_ناتجا_نص_مسير(الناتج, &(*الدالة).الناتج);
    إذا ((الطول((*الدالة).الالتقاطات) مثل طبيعي) > 0) {
        ألحق_بايتات_نص(الناتج, « captures »);
        ألحق_أنواعا_نص_مسير(الناتج, &(*الدالة).الالتقاطات);
    };
    ألحق_بايتات_نص(الناتج, " {\n");
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        ألحق_بايتات_نص(الناتج, «  entry »);
        ألحق_كتلة_نص_مسير(الناتج, المدخل);
        ألحق_بايتات_نص(الناتج, "\n");
    }
    | اختياري.لا_شيء -> { };
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ألحق_كتلة_كاملة_نص_مسير(الناتج, الدالة, &(*الدالة).الكتل[ك]);
        ك := ك + 1;
    }
    ألحق_بايتات_نص(الناتج, "}\n");
}

عرف ألحق_خارجية_كاملة_نص_مسير(الناتج: &متغير متجه ط8, الخارجية: &دالة_خارجية_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «extern »);
    ألحق_خارجية_نص_مسير(الناتج, (*الخارجية).المعرف);
    ألحق_بايتات_نص(الناتج, « »);
    ألحق_بايتات_مقتبسة_نص_مسير(الناتج, &(*الخارجية).الاسم);
    طابق (*الخارجية).المكتبة مع
    | اختياري.موجود(المكتبة) -> {
        ألحق_بايتات_نص(الناتج, « library »);
        ألحق_بايتات_مقتبسة_نص_مسير(الناتج, &المكتبة);
    }
    | اختياري.لا_شيء -> { };
    ألحق_بايتات_نص(الناتج, « »);
    ألحق_أنواعا_نص_مسير(الناتج, &(*الخارجية).المعاملات);
    ألحق_ناتجا_نص_مسير(الناتج, &(*الخارجية).الناتج);
    طابق (*الخارجية).المعاملات_الثابتة مع
    | اختياري.موجود(الثابتة) -> {
        ألحق_بايتات_نص(الناتج, « variadic after »);
        ألحق_طبيعيا_نص_مسير(الناتج, الثابتة);
    }
    | اختياري.لا_شيء -> { };
    إذا ((*الخارجية).عند_عنوان) { ألحق_بايتات_نص(الناتج, « at_address»); };
    ألحق_بايتات_نص(الناتج, "\n");
}

عرف ألحق_عاما_كاملا_نص_مسير(الناتج: &متغير متجه ط8, العام: &عام_مسير): فراغ {
    ألحق_بايتات_نص(الناتج, «global »);
    ألحق_عاما_نص_مسير(الناتج, (*العام).المعرف);
    ألحق_بايتات_نص(الناتج, «: »);
    ألحق_نوع_نص_مسير(الناتج, (*العام).النوع);
    إذا ((*العام).قابل_للكتابة) { ألحق_بايتات_نص(الناتج, « mutable»); };
    طابق (*العام).الاسم_الخارجي مع
    | اختياري.موجود(الاسم) -> {
        ألحق_بايتات_نص(الناتج, « extern »);
        ألحق_بايتات_مقتبسة_نص_مسير(الناتج, &الاسم);
    }
    | اختياري.لا_شيء -> {
        ألحق_بايتات_نص(الناتج, « = »);
        ألحق_ثابتا_نص_مسير(الناتج, &(*العام).التهيئة);
    };
    ألحق_بايتات_نص(الناتج, "\n");
}

// `KEY @N`, for a program fact naming a function.
عرف ألحق_حقيقة_دالة_نص_مسير(الناتج: &متغير متجه ط8, المفتاح: نص, الدالة: &اختياري معرف_دالة_مسير): فراغ {
    طابق *الدالة مع
    | اختياري.موجود(المعرف) -> {
        ألحق_بايتات_نص(الناتج, المفتاح);
        ألحق_بايتات_نص(الناتج, « »);
        ألحق_دالة_نص_مسير(الناتج, المعرف);
        ألحق_بايتات_نص(الناتج, "\n");
    }
    | اختياري.لا_شيء -> { };
}

// The whole program: its external functions, globals, program facts, then
// its functions, each in identity order.
عام عرف نص_برنامج_مسير(البرنامج: &برنامج_مسير, التصحيح: &بيانات_تصحيح_مسير): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال_الخارجية) مثل طبيعي)) {
        ألحق_خارجية_كاملة_نص_مسير(&متغير الناتج, &(*البرنامج).الدوال_الخارجية[ف]);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*البرنامج).العوام) مثل طبيعي)) {
        ألحق_عاما_كاملا_نص_مسير(&متغير الناتج, &(*البرنامج).العوام[ف]);
        ف := ف + 1;
    }
    ألحق_حقيقة_دالة_نص_مسير(&متغير الناتج, «start», &(*البرنامج).دالة_بدء_البرنامج);
    ألحق_حقيقة_دالة_نص_مسير(&متغير الناتج, «process_exit», &(*البرنامج).دالة_خروج_العملية);
    ألحق_حقيقة_دالة_نص_مسير(&متغير الناتج, «task_switch», &(*البرنامج).دالة_تبديل_سياق_المهام);
    ألحق_حقيقة_دالة_نص_مسير(&متغير الناتج, «module_initializer», &(*البرنامج).دالة_تهيئة_الوحدة);
    طابق (*البرنامج).مزودات_تخصيص_الذاكرة مع
    | اختياري.موجود(المزودات) -> {
        ألحق_بايتات_نص(&متغير الناتج, «allocator »);
        ألحق_دالة_نص_مسير(&متغير الناتج, المزودات.التخصيص);
        ألحق_بايتات_نص(&متغير الناتج, «, »);
        ألحق_دالة_نص_مسير(&متغير الناتج, المزودات.إعادة_التخصيص);
        ألحق_بايتات_نص(&متغير الناتج, «, »);
        ألحق_دالة_نص_مسير(&متغير الناتج, المزودات.التحرير);
        ألحق_بايتات_نص(&متغير الناتج, "\n");
    }
    | اختياري.لا_شيء -> { };
    ف := 0;
    طالما (ف < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        ألحق_بايتات_نص(&متغير الناتج, "\n");
        ألحق_دالة_كاملة_نص_مسير(&متغير الناتج, &(*البرنامج).الدوال[ف], التصحيح);
        ف := ف + 1;
    }
    أرجع الناتج;
}
