استورد compiler.source.span;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.drop_elaboration;
استورد compiler.msir.ssf.borrow_flow;
استورد compiler.msir.ssf.borrow_liveness;
استورد compiler.msir.lowering.ownership_glue;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.ownership_errors;
استورد compiler.runtime.primitive_identity;

// The ownership legality analysis of initial MSIR
// (docs/en/internals/ownership-analysis.md, "Legality"): moves and
// initialization. It runs on verified initial MSIR, before drop elaboration,
// and reports, for each source function, the first use that the language
// rejects, as the source states it:
//   a read of a local that holds no value on some path (use before
//   initialization), or whose value was moved out or released on some path;
//   a move of a value out of borrowed storage (a borrowed view, a
//   dereference, a module value), of one member of an owned aggregate (a
//   partial move), a release of what the function does not own, and a second
//   assignment to a local declared without `mutable`.
//
// The state of every source local (its place, msir_model.sn, مكان_محلي_مسير)
// at every block entry is the fixed point of drop elaboration's
// initialization dataflow (احسب_حالات_دخول_شبكة_مسير) over the legality
// lattice (ادمج_حالة_شرعية_مسير): a declaration (تصريح) leaves the place
// holding none, a store gives it a value, a load whose value is moved out
// (احسب_استهلاك_قيم_دالة_مسير, the moves drop elaboration derives) or
// released, and a give-up lowering states, leave it moved out or released.
//
// Where a use is reported, and in which order, follows the source. Lowering
// records the source of every use it emits (برنامج_مسير.مصادر_الاستخدامات):
// only those are uses. Each statement (the instructions of one statement
// debug location) is checked in the order its operands are evaluated, left
// to right: every read against the state the uses before it left, so a read
// after a move earlier in the same statement is a use after the move. Blocks
// are visited in reverse postorder, and a loop's body first with the states
// before it repeats, then with those of the fixed point: the first error is
// the one the source meets first. A closure's body and a compile-time block are part
// of the function they are written in, at their construction or call.
// Instances of generic templates are not checked here.

// The first rejected use of a source function.
عام نوع خطأ_ملكية_دالة_مسير = {
    الرمز: معرف_رمز,
    الخطأ: خطأ_تدفق_سلامة
};

عرف بلا_ط32_شرعية(): ط32 { أرجع 0xFFFFFFFF; }

// The root of a place: kinds 0 none, 1 a source local (الخانة), 2 a module
// value, 3 a dereference of a reference, 4 a box payload. الإسقاط: a member
// or element of it.
نوع جذر_مكان_شرعية = {
    الصنف: طبيعي,
    الخانة: طبيعي,
    الإسقاط: منطقي
};

// The facts of one function the analysis reads.
نوع دالة_شرعية = {
    الدالة: طبيعي,
    // Per value: its defining instruction as block * 2^32 + position plus one
    // (0 for none: a parameter or block parameter).
    التعريفات: متجه طبيعي,
    // Per value: the tracked local (الخانات) whose place it is, plus one.
    خانات_القيم: متجه طبيعي,
    // Per block and instruction: its source use (an index into the
    // function's uses) plus one.
    المداخل: متجه متجه طبيعي,
    // Per tracked local: its place, Symbol, whether it owns its value.
    أماكن_الخانات: متجه طبيعي,
    رموز_الخانات: متجه معرف_رمز,
    مالكة_الخانات: متجه منطقي,
    // Per tracked local: its position among the states, plus one; 0 for a
    // local the dataflow need not follow (given its value where it is
    // declared and never moved out: it holds one wherever it is used).
    حالات_الخانات: متجه طبيعي,
    // Per value: moved out (after drop elaboration's passing back), the value
    // it derives from (plus one), released (the release primitive's argument).
    المستهلكة: متجه منطقي,
    المحولة: متجه طبيعي,
    المحررة: متجه منطقي,
    // Per block: the loads of a whole tracked local whose value moves out in
    // that block, after the block it is loaded in (a match arm binding the
    // whole scrutinee): pairs position of the use (the number of
    // instructions for the terminator), value of the load. The move happens
    // there, on that path only.
    النقول_المؤجلة: متجه متجه طبيعي,
    // Per value: a load النقول_المؤجلة moves at its use.
    المؤجلة: متجه منطقي,
    // The borrow state of the locals (borrow_flow.sn), and per tracked
    // local its local there plus one (0 for none).
    الاستعارات: وصف_استعارات_مسير,
    استعارات_الخانات: متجه طبيعي,
    // Per block: whether the walk checks anything there (a source use, an
    // extraction, a closure or call it analyzes, a borrow event, a deferred
    // move). The entry states are the dataflow's, so the others are skipped.
    المفحوصة: متجه منطقي
};

عرف رقم_تعريف_شرعية(الكتلة: طبيعي, الموضع: طبيعي): طبيعي {
    أرجع (الكتلة * 4294967296) + الموضع + 1;
}

// The state of tracked local الخانة in الحالة (a local the dataflow does not
// follow holds a value).
عرف حالة_خانة_شرعية(الحقائق: &دالة_شرعية, الحالة: &متجه طبيعي, الخانة: طبيعي): طبيعي {
    دع الموضع: طبيعي = (*الحقائق).حالات_الخانات[الخانة];
    إذا (الموضع == 0) { أرجع 2; };
    أرجع (*الحالة)[الموضع - 1];
}

عرف ضع_حالة_خانة_شرعية(الحقائق: &دالة_شرعية, الحالة: &متغير متجه طبيعي, الخانة: طبيعي, القيمة: طبيعي): فراغ {
    دع الموضع: طبيعي = (*الحقائق).حالات_الخانات[الخانة];
    إذا (الموضع > 0) { (*الحالة)[الموضع - 1] := القيمة; };
}

// The pair state position, state of tracked local الخانة, appended to a
// block summary.
عرف ألحق_زوج_شرعية(الحقائق: &دالة_شرعية, الملخص: &متغير متجه طبيعي, الخانة: طبيعي, القيمة: طبيعي): فراغ {
    دع الموضع: طبيعي = (*الحقائق).حالات_الخانات[الخانة];
    إذا (الموضع > 0) { ألحق(*الملخص, الموضع - 1); ألحق(*الملخص, القيمة); };
}

// A value whose Type owns storage the Frontend moves (a closure-counted Type
// is copied by a read).
عرف يملك_للشرعية(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع) && !هل_نوع_معدود_عادي_مسير(الأنواع, النوع);
}

عرف جذر_مكان_شرعية_عند(الحقائق: &دالة_شرعية, البرنامج: &برنامج_مسير, المكان: معرف_قيمة_مسير): جذر_مكان_شرعية {
    دع الحالي: متغير طبيعي = المكان.القيمة مثل طبيعي;
    دع الإسقاط: متغير منطقي = خطأ;
    دع الخطوات: متغير طبيعي = 0;
    دع د: طبيعي = (*الحقائق).الدالة;
    // A chain of definitions is no longer than the values it passes.
    طالما (الخطوات <= (الطول((*الحقائق).التعريفات) مثل طبيعي)) {
        الخطوات := الخطوات + 1;
        إذا (الحالي >= (الطول((*الحقائق).التعريفات) مثل طبيعي)) { أرجع جذر_فارغ_شرعية(); };
        دع التعريف: طبيعي = (*الحقائق).التعريفات[الحالي];
        إذا (التعريف == 0) { أرجع جذر_فارغ_شرعية(); };
        دع الكتلة: طبيعي = (التعريف - 1) / 4294967296;
        دع الموضع: طبيعي = (التعريف - 1) % 4294967296;
        طابق (*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع].العملية مع
        | عملية_مسير.مكان_محلي(_) -> {
            دع الخانة: طبيعي = (*الحقائق).خانات_القيم[الحالي];
            إذا (الخانة == 0) { أرجع جذر_فارغ_شرعية(); };
            دع الجذر: جذر_مكان_شرعية = { الصنف: 1, الخانة: الخانة - 1, الإسقاط: الإسقاط };
            أرجع الجذر;
        }
        | عملية_مسير.مكان_عام(_) -> {
            دع الجذر: جذر_مكان_شرعية = { الصنف: 2, الخانة: 0, الإسقاط: الإسقاط };
            أرجع الجذر;
        }
        | عملية_مسير.مرجع_إلى_مكان(_) -> {
            دع الجذر: جذر_مكان_شرعية = { الصنف: 3, الخانة: 0, الإسقاط: الإسقاط };
            أرجع الجذر;
        }
        | عملية_مسير.صندوق_إلى_مكان(_) -> {
            دع الجذر: جذر_مكان_شرعية = { الصنف: 4, الخانة: 0, الإسقاط: الإسقاط };
            أرجع الجذر;
        }
        | عملية_مسير.مكان_حقل(الحقل) -> { الإسقاط := صواب; الحالي := الحقل.الأصل.القيمة مثل طبيعي; }
        | عملية_مسير.مكان_فهرس(الفهرس) -> { الإسقاط := صواب; الحالي := الفهرس.الأصل.القيمة مثل طبيعي; }
        | _ -> { أرجع جذر_فارغ_شرعية(); };
    }
    أرجع جذر_فارغ_شرعية();
}

عرف جذر_فارغ_شرعية(): جذر_مكان_شرعية {
    دع الجذر: جذر_مكان_شرعية = { الصنف: 0, الخانة: 0, الإسقاط: خطأ };
    أرجع الجذر;
}

// The use recorded for instruction الموضع of block الكتلة, plus one.
عرف مدخل_تعليمة_شرعية(الحقائق: &دالة_شرعية, الكتلة: طبيعي, الموضع: طبيعي): طبيعي {
    إذا (الكتلة >= (الطول((*الحقائق).المداخل) مثل طبيعي)) { أرجع 0; };
    إذا (الموضع >= (الطول((*الحقائق).المداخل[الكتلة]) مثل طبيعي)) { أرجع 0; };
    أرجع (*الحقائق).المداخل[الكتلة][الموضع];
}

// The use recorded for the instruction that defines القيمة, plus one.
عرف مدخل_قيمة_شرعية(الحقائق: &دالة_شرعية, القيمة: طبيعي): طبيعي {
    إذا (القيمة >= (الطول((*الحقائق).التعريفات) مثل طبيعي)) { أرجع 0; };
    دع التعريف: طبيعي = (*الحقائق).التعريفات[القيمة];
    إذا (التعريف == 0) { أرجع 0; };
    أرجع مدخل_تعليمة_شرعية(الحقائق, (التعريف - 1) / 4294967296, (التعريف - 1) % 4294967296);
}

عرف رمز_استخدام_شرعية(الاستخدام: &استخدام_مصدري_مسير): اختياري معرف_رمز {
    إذا ((*الاستخدام).الرمز == بلا_ط32_شرعية()) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(معرف_رمز_من((*الاستخدام).الرمز مثل طبيعي));
}

// A read of tracked local الخانة in state الحالة at الاستخدام: the error the
// source reports, if any.
عرف تحقق_قراءة_شرعية(
    الحقائق: &دالة_شرعية,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الخانة: طبيعي,
    الحالة: طبيعي,
    الاستخدام: &استخدام_مصدري_مسير
): اختياري خطأ_تدفق_سلامة {
    دع الرمز: معرف_رمز = (*الحقائق).رموز_الخانات[الخانة];
    دع الصنف: طبيعي = الحالة % 8;
    إذا (الصنف == 1 || الصنف == 5) {
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز, اختياري.موجود((*الاستخدام).الاسم)));
    };
    إذا (الصنف == 3 || الصنف == 6) {
        دع الأصل: متغير اختياري نطاق = اختياري.لا_شيء();
        دع رقم_الأصل: طبيعي = الحالة / 8;
        إذا (رقم_الأصل > 0 && رقم_الأصل <= (الطول(*الاستخدامات) مثل طبيعي)) {
            الأصل := اختياري.موجود((*الاستخدامات)[رقم_الأصل - 1].الاسم);
        };
        دع السياق: سياق_استخدام_بعد_النقل = {
            الرمز: الرمز,
            أصل_النقل: الأصل,
            الاستخدام: اختياري.موجود((*الاستخدام).الاسم),
            على_عرض: خطأ
        };
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
    };
    إذا (الصنف == 4 || الصنف == 7) {
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.استخدام_بعد_التحرير(الرمز));
    };
    أرجع اختياري.لا_شيء();
}

// The release of tracked local الخانة (its whole value) in state الحالة, as
// the source checks it.
عرف تحقق_تحرير_شرعية(
    الحقائق: &دالة_شرعية,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الخانة: طبيعي,
    الحالة: طبيعي,
    الاستخدام: &استخدام_مصدري_مسير
): اختياري خطأ_تدفق_سلامة {
    دع الرمز: معرف_رمز = (*الحقائق).رموز_الخانات[الخانة];
    دع الصنف: طبيعي = الحالة % 8;
    إذا (الصنف == 4 || الصنف == 7) {
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.تحرير_مكرر(الرمز));
    };
    إذا (الصنف == 3 || الصنف == 6) {
        دع الأصل: متغير اختياري نطاق = اختياري.لا_شيء();
        دع رقم_الأصل: طبيعي = الحالة / 8;
        إذا (رقم_الأصل > 0 && رقم_الأصل <= (الطول(*الاستخدامات) مثل طبيعي)) {
            الأصل := اختياري.موجود((*الاستخدامات)[رقم_الأصل - 1].الاسم);
        };
        دع السياق: سياق_استخدام_بعد_النقل = {
            الرمز: الرمز,
            أصل_النقل: الأصل,
            الاستخدام: اختياري.موجود((*الاستخدام).التعبير),
            على_عرض: خطأ
        };
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق));
    };
    إذا (الصنف == 1 || الصنف == 5) {
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.استخدام_قبل_التهيئة(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
    };
    أرجع اختياري.لا_شيء();
}

عرف خطأ_نقل_من_مرجع_شرعية(الرمز: اختياري معرف_رمز, الموضع: نطاق): خطأ_تدفق_سلامة {
    دع السياق: سياق_نقل_من_مرجع = { الرمز: الرمز, الموضع: الموضع };
    أرجع خطأ_تدفق_سلامة.نقل_من_مرجع(السياق);
}

// The tracked local a give-up names, plus one (0 for none).
عرف خانة_ملكية_شرعية(الحقائق: &دالة_شرعية, العملية: &عملية_مسير, الحدث_المطلوب: طبيعي): طبيعي {
    طابق *العملية مع
    | عملية_مسير.ملكية_مكان(الملكية) -> {
        دع الحدث: متغير طبيعي = 0;
        طابق الملكية.الحدث مع
        | حدث_ملكية_مسير.تصريح -> { الحدث := 1; }
        | حدث_ملكية_مسير.تهيئة -> { الحدث := 2; }
        | حدث_ملكية_مسير.تسليم -> { الحدث := 3; }
        | حدث_ملكية_مسير.إسقاط -> { الحدث := 4; };
        إذا (الحدث != الحدث_المطلوب) { أرجع 0; };
        دع الموضع: طبيعي = الملكية.المكان.القيمة مثل طبيعي;
        إذا (الموضع >= (الطول((*الحقائق).خانات_القيم) مثل طبيعي)) { أرجع 0; };
        أرجع (*الحقائق).خانات_القيم[الموضع];
    }
    | _ -> { أرجع 0; };
}

// The tracked local a whole store writes, plus one (0 for none).
عرف خانة_تخزين_كامل_شرعية(الحقائق: &دالة_شرعية, العملية: &عملية_مسير): طبيعي {
    طابق *العملية مع
    | عملية_مسير.تخزين(التخزين) -> {
        دع الموضع: طبيعي = التخزين.المكان.القيمة مثل طبيعي;
        إذا (الموضع >= (الطول((*الحقائق).خانات_القيم) مثل طبيعي)) { أرجع 0; };
        أرجع (*الحقائق).خانات_القيم[الموضع];
    }
    | _ -> { أرجع 0; };
}

// The state the instruction at الموضع of block الكتلة leaves its local in,
// as pairs local, state appended to الملخص (none when it changes none).
عرف ألحق_أثر_تعليمة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    الملخص: &متغير متجه طبيعي
): فراغ {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع];
    دع المصرح: طبيعي = خانة_ملكية_شرعية(الحقائق, &(*التعليمة).العملية, 1);
    إذا (المصرح > 0) { ألحق_زوج_شرعية(الحقائق, الملخص, المصرح - 1, 1); أرجع; };
    دع المخزن: طبيعي = خانة_تخزين_كامل_شرعية(الحقائق, &(*التعليمة).العملية);
    إذا (المخزن > 0) { ألحق_زوج_شرعية(الحقائق, الملخص, المخزن - 1, 2); أرجع; };
    دع المسلم: طبيعي = خانة_ملكية_شرعية(الحقائق, &(*التعليمة).العملية, 3);
    إذا (المسلم > 0) {
        إذا ((*الحقائق).مالكة_الخانات[المسلم - 1]) {
            ألحق_زوج_شرعية(الحقائق, الملخص, المسلم - 1, 3 + (8 * مدخل_تعليمة_شرعية(الحقائق, الكتلة, الموضع)));
        };
        أرجع;
    };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.تحميل(التحميل) -> {
        طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
        | اختياري.موجود(القيمة) -> {
            إذا (!نقل_مؤجل_شرعية(الحقائق, الكتلة, القيمة)) {
                ألحق_أثر_نقل_شرعية(الحقائق, البرنامج, الأنواع, الكتلة, الموضع, القيمة, الملخص);
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// The move (or release) of the load at الموضع of block الكتلة, whose value is
// القيمة, as a state pair appended to الملخص.
عرف ألحق_أثر_نقل_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    القيمة: طبيعي,
    الملخص: &متغير متجه طبيعي
): فراغ {
    دع د: طبيعي = (*الحقائق).الدالة;
    إذا (!(القيمة < (الطول((*الحقائق).المستهلكة) مثل طبيعي) && (*الحقائق).المستهلكة[القيمة])) { أرجع; };
    طابق (*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع].العملية مع
    | عملية_مسير.تحميل(التحميل) -> {
        دع المكان: طبيعي = التحميل.المكان.القيمة مثل طبيعي;
        إذا (المكان >= (الطول((*الحقائق).خانات_القيم) مثل طبيعي)) { أرجع; };
        دع الخانة: طبيعي = (*الحقائق).خانات_القيم[المكان];
        إذا (الخانة == 0) { أرجع; };
        إذا ((*الحقائق).المحررة[القيمة]) {
            ألحق_زوج_شرعية(الحقائق, الملخص, الخانة - 1, 4);
        } وإلا إذا ((*الحقائق).مالكة_الخانات[الخانة - 1]
            && يملك_للشرعية(الأنواع, (*البرنامج).الدوال[د].القيم[القيمة].النوع)) {
            ألحق_زوج_شرعية(الحقائق, الملخص, الخانة - 1, 3 + (8 * مدخل_تعليمة_شرعية(الحقائق, الكتلة, الموضع)));
        };
    }
    | _ -> { };
}

// Whether the load القيمة moves its value out in a later block
// (النقول_المؤجلة).
عرف نقل_مؤجل_شرعية(الحقائق: &دالة_شرعية, الكتلة: طبيعي, القيمة: طبيعي): منطقي {
    أرجع القيمة < (الطول((*الحقائق).المؤجلة) مثل طبيعي) && (*الحقائق).المؤجلة[القيمة];
}

// The moves النقول_المؤجلة puts at position الموضع of block الكتلة.
عرف ألحق_نقولا_مؤجلة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    الملخص: &متغير متجه طبيعي
): فراغ {
    إذا (الكتلة >= (الطول((*الحقائق).النقول_المؤجلة) مثل طبيعي)) { أرجع; };
    دع ف: متغير طبيعي = 0;
    طالما ((ف + 1) < (الطول((*الحقائق).النقول_المؤجلة[الكتلة]) مثل طبيعي)) {
        إذا ((*الحقائق).النقول_المؤجلة[الكتلة][ف] == الموضع) {
            دع الحمل: طبيعي = (*الحقائق).النقول_المؤجلة[الكتلة][ف + 1];
            دع التعريف: طبيعي = (*الحقائق).التعريفات[الحمل];
            ألحق_أثر_نقل_شرعية(
                الحقائق, البرنامج, الأنواع, (التعريف - 1) / 4294967296, (التعريف - 1) % 4294967296,
                الحمل, الملخص
            );
        };
        ف := ف + 2;
    }
}

// The state of local الخانة in a use pass: the last value the instructions
// it checks gave it (المعطاة), else its state before them.
عرف حالة_معطاة_شرعية(
    الحقائق: &دالة_شرعية,
    الحالة_الأولى: &متجه طبيعي,
    المعطاة: &متجه طبيعي,
    الخانة: طبيعي
): طبيعي {
    دع ف: متغير طبيعي = الطول(*المعطاة) مثل طبيعي;
    طالما (ف >= 2) {
        ف := ف - 2;
        إذا ((*المعطاة)[ف] == الخانة) { أرجع (*المعطاة)[ف + 1]; };
    }
    أرجع حالة_خانة_شرعية(الحقائق, الحالة_الأولى, الخانة);
}

// The use pass of the instructions [البداية, النهاية) of block الكتلة (one
// instruction, in evaluation order, تحقق_كتلة_شرعية): every read, and every
// write into a member, checked against the state before them. Only what
// gives a local its value there (a declaration, a store) is applied on the
// way.
عرف تحقق_قراءات_عبارة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    الحالة_الأولى: &متجه طبيعي,
    حالة_الاستعارات: &متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    دع د: طبيعي = (*الحقائق).الدالة;
    // The values the statement gives locals on the way: pairs local, state.
    دع المعطاة: متغير متجه طبيعي = [];
    دع ت: متغير طبيعي = البداية;
    طالما (ت < النهاية) {
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[ت];
        دع المكان: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
        دع المدخل: متغير طبيعي = 0;
        دع كتابة: متغير منطقي = خطأ;
        طابق (*التعليمة).العملية مع
        | عملية_مسير.تخزين(التخزين) -> {
            المكان := اختياري.موجود(التخزين.المكان);
            المدخل := مدخل_قيمة_شرعية(الحقائق, التخزين.المكان.القيمة مثل طبيعي);
            كتابة := صواب;
        }
        | عملية_مسير.تحميل(التحميل) -> {
            // A release statement is not read first: its release checks it.
            دع محررة: متغير منطقي = خطأ;
            طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
            | اختياري.موجود(القيمة) -> {
                محررة := القيمة < (الطول((*الحقائق).المحررة) مثل طبيعي) && (*الحقائق).المحررة[القيمة];
            }
            | اختياري.لا_شيء -> { };
            إذا (!محررة) {
                المكان := اختياري.موجود(التحميل.المكان);
                المدخل := مدخل_تعليمة_شرعية(الحقائق, الكتلة, ت);
            };
        }
        | عملية_مسير.مكان_إلى_مرجع(المرجع) -> {
            المكان := اختياري.موجود(المرجع.المكان);
            المدخل := مدخل_تعليمة_شرعية(الحقائق, الكتلة, ت);
        }
        | _ -> { };
        طابق المكان مع
        | اختياري.موجود(مكان_الاستخدام) -> {
            إذا (المدخل > 0
                && (*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_قراءة_مسير()) {
                دع الجذر: جذر_مكان_شرعية = جذر_مكان_شرعية_عند(الحقائق, البرنامج, مكان_الاستخدام);
                // A whole store writes the local: it reads nothing.
                إذا (الجذر.الصنف == 1 && (!كتابة || الجذر.الإسقاط)) {
                    طابق تحقق_قراءة_شرعية(
                        الحقائق, الاستخدامات, الجذر.الخانة,
                        حالة_معطاة_شرعية(الحقائق, الحالة_الأولى, &المعطاة, الجذر.الخانة),
                        &(*الاستخدامات)[المدخل - 1]
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    // Its borrows: a write ended it, it is borrowed exclusively.
                    دع محلي_الاستعارة: طبيعي = (*الحقائق).استعارات_الخانات[الجذر.الخانة];
                    إذا (محلي_الاستعارة > 0) {
                        طابق تحقق_قراءة_استعارة_مسير(
                            &(*الحقائق).الاستعارات, حالة_الاستعارات, محلي_الاستعارة - 1,
                            اختياري.موجود((*الاستخدامات)[المدخل - 1].الاسم)
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        }
        | اختياري.لا_شيء -> { };
        دع المصرح: طبيعي = خانة_ملكية_شرعية(الحقائق, &(*التعليمة).العملية, 1);
        إذا (المصرح > 0) { ألحق(المعطاة, المصرح - 1); ألحق(المعطاة, 1); };
        دع المخزن: طبيعي = خانة_تخزين_كامل_شرعية(الحقائق, &(*التعليمة).العملية);
        إذا (المخزن > 0) { ألحق(المعطاة, المخزن - 1); ألحق(المعطاة, 2); };
        ت := ت + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The value a member, payload or element read of a loaded value comes from:
// the load at the start of the chain, as a value position plus one.
عرف حمل_أصل_مستخرج_شرعية(الحقائق: &دالة_شرعية, البرنامج: &برنامج_مسير, القيمة: طبيعي): طبيعي {
    دع الحالي: متغير طبيعي = القيمة;
    دع الخطوات: متغير طبيعي = 0;
    دع د: طبيعي = (*الحقائق).الدالة;
    طالما (الخطوات <= (الطول((*الحقائق).التعريفات) مثل طبيعي)) {
        الخطوات := الخطوات + 1;
        إذا (الحالي >= (الطول((*الحقائق).التعريفات) مثل طبيعي)) { أرجع 0; };
        دع التعريف: طبيعي = (*الحقائق).التعريفات[الحالي];
        إذا (التعريف == 0) { أرجع 0; };
        دع الكتلة: طبيعي = (التعريف - 1) / 4294967296;
        دع الموضع: طبيعي = (التعريف - 1) % 4294967296;
        طابق (*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع].العملية مع
        | عملية_مسير.استخراج_حمولة(الاستخراج) -> { الحالي := الاستخراج.المصدر.القيمة مثل طبيعي; }
        | عملية_مسير.استخراج_حقل(الاستخراج) -> { الحالي := الاستخراج.المصدر.القيمة مثل طبيعي; }
        | عملية_مسير.استخراج_فهرس(الاستخراج) -> { الحالي := الاستخراج.المصدر.القيمة مثل طبيعي; }
        | عملية_مسير.تحميل(_) -> { أرجع الحالي + 1; }
        | _ -> { أرجع 0; };
    }
    أرجع 0;
}

// The analysis of the functions of one program: each source function's
// result, computed once (closures and compile-time blocks are reached from
// the function they are written in).
نوع حالة_شرعية_برنامج = {
    // Per function: 0 not analyzed, 1 accepted, 2 rejected (الأخطاء).
    الحالات: متجه طبيعي,
    الأخطاء: متجه اختياري خطأ_تدفق_سلامة,
    // Per function: its enclosing function (closure, compile-time block),
    // plus one.
    الآباء: متجه طبيعي,
    // With يجمع_النقول, where each use of a local's name moves its value out
    // or releases it (tooling's moved names, ownership_tooling.sn).
    يجمع_النقول: منطقي,
    النقول: متجه نطاق
};

// The name of every use that reads a whole owner's value to move it out or
// release it: the moved names tooling shows.
عرف اجمع_نقول_أسماء_شرعية(
    الدالة: &دالة_مسير,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    المداخل: &متجه متجه طبيعي,
    خانات_القيم: &متجه طبيعي,
    مالكة_الخانات: &متجه منطقي,
    المستهلكة: &متجه منطقي,
    المحررة: &متجه منطقي,
    النقول: &متغير متجه نطاق
): فراغ {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي) && ك < (الطول(*المداخل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي) && ت < (الطول((*المداخل)[ك]) مثل طبيعي)) {
            دع المدخل: طبيعي = (*المداخل)[ك][ت];
            إذا (المدخل > 0) {
                طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.تحميل(التحميل) -> {
                    دع المكان: طبيعي = التحميل.المكان.القيمة مثل طبيعي;
                    طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
                    | اختياري.موجود(القيمة) -> {
                        إذا (المكان < (الطول(*خانات_القيم) مثل طبيعي) && (*خانات_القيم)[المكان] > 0
                            && القيمة < (الطول(*المستهلكة) مثل طبيعي)) {
                            إذا ((*مالكة_الخانات)[(*خانات_القيم)[المكان] - 1]
                                && ((*المستهلكة)[القيمة] || (*المحررة)[القيمة])) {
                                ألحق(*النقول, (*الاستخدامات)[المدخل - 1].الاسم);
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

// Whether الحالة is a value moved out where الاستخدام states its move.
عرف نقل_بنفس_الموضع_شرعية(
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الحالة: طبيعي,
    الاستخدام: &استخدام_مصدري_مسير
): منطقي {
    إذا ((الحالة % 8) != 3) { أرجع خطأ; };
    دع الأصل: طبيعي = الحالة / 8;
    إذا (الأصل == 0 || الأصل > (الطول(*الاستخدامات) مثل طبيعي)) { أرجع خطأ; };
    أرجع نطاقان_متساويان((*الاستخدامات)[الأصل - 1].الاسم, (*الاستخدام).الاسم);
}

// The effect pass of one statement: moves, releases, captures, assignments,
// give-ups and nested bodies, in order, each against the current state.
عرف طبق_آثار_عبارة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    الحالة: &متغير متجه طبيعي,
    البرنامج_الكلي: &متغير حالة_شرعية_برنامج,
    حالة_الاستعارات: &متغير متجه طبيعي,
    المؤشر: &متغير طبيعي,
    المأخوذة: &متغير متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع ت: متغير طبيعي = البداية;
    طالما (ت < النهاية) {
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[ت];
        دع المدخل: طبيعي = مدخل_تعليمة_شرعية(الحقائق, الكتلة, ت);
        // An owner destroyed where its scope ends while a borrow of it is
        // used later.
        إذا (المدخل > 0 && (*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_إتلاف_نطاق_مسير()) {
            طابق خطأ_إتلاف_مستعار_شرعية(
                الحقائق, البرنامج, الاستخدامات, الكتلة, ت, &(*حالة_الاستعارات), &(*الاستخدامات)[المدخل - 1]
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        دع المصرح: طبيعي = خانة_ملكية_شرعية(الحقائق, &(*التعليمة).العملية, 1);
        إذا (المصرح > 0) { ضع_حالة_خانة_شرعية(الحقائق, الحالة, المصرح - 1, 1); };
        دع المسلم: طبيعي = خانة_ملكية_شرعية(الحقائق, &(*التعليمة).العملية, 3);
        إذا (المسلم > 0 && (*الحقائق).مالكة_الخانات[المسلم - 1]) {
            // A give-up of a value already moved out where it is stated (a
            // capture, a match binding the whole scrutinee) is that move.
            دع بعد_نقل: منطقي = المدخل > 0
                && نقل_بنفس_الموضع_شرعية(الاستخدامات, حالة_خانة_شرعية(الحقائق, &(*الحالة), المسلم - 1), &(*الاستخدامات)[المدخل - 1]);
            إذا (!بعد_نقل && المدخل > 0
                && (*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_تسليم_مسير()) {
                طابق تحقق_قراءة_شرعية(
                    الحقائق, الاستخدامات, المسلم - 1, حالة_خانة_شرعية(الحقائق, &(*الحالة), المسلم - 1), &(*الاستخدامات)[المدخل - 1]
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
            ضع_حالة_خانة_شرعية(الحقائق, الحالة, المسلم - 1, 3 + (8 * المدخل));
        };
        طابق (*التعليمة).العملية مع
        | عملية_مسير.تخزين(التخزين) -> {
            دع الخانة: طبيعي = خانة_تخزين_كامل_شرعية(الحقائق, &(*التعليمة).العملية);
            إذا (الخانة > 0) {
                // A local the dataflow does not follow is given only the
                // value it is declared with.
                إذا (المدخل > 0 && (*الحقائق).حالات_الخانات[الخانة - 1] > 0
                    && (*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_إسناد_ثابت_مسير()) {
                    دع السابقة: طبيعي = حالة_خانة_شرعية(الحقائق, &(*الحالة), الخانة - 1) % 8;
                    إذا (السابقة != 0 && السابقة != 1) {
                        أرجع اختياري.موجود(خطأ_تدفق_سلامة.إسناد_إلى_غير_متغير(
                            (*الحقائق).رموز_الخانات[الخانة - 1],
                            اختياري.موجود((*الاستخدامات)[المدخل - 1].التعبير)
                        ));
                    };
                };
                ضع_حالة_خانة_شرعية(الحقائق, الحالة, الخانة - 1, 2);
            };
        }
        | عملية_مسير.تحميل(التحميل) -> {
            طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
            | اختياري.موجود(القيمة) -> {
                إذا (المدخل > 0 && القيمة < (الطول((*الحقائق).المستهلكة) مثل طبيعي)) {
                    دع الاستخدام: &استخدام_مصدري_مسير = &(*الاستخدامات)[المدخل - 1];
                    دع الجذر: جذر_مكان_شرعية = جذر_مكان_شرعية_عند(الحقائق, البرنامج, التحميل.المكان);
                    // A capture reads the local where the closure is made.
                    إذا ((*الاستخدام).الصنف == صنف_استخدام_التقاط_مسير() && الجذر.الصنف == 1) {
                        طابق تحقق_قراءة_شرعية(
                            الحقائق, الاستخدامات, الجذر.الخانة, حالة_خانة_شرعية(الحقائق, &(*الحالة), الجذر.الخانة), الاستخدام
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                    إذا (!نقل_مؤجل_شرعية(الحقائق, الكتلة, القيمة)) {
                        طابق طبق_نقل_تحميل_شرعية(
                            الحقائق, البرنامج, الأنواع, الاستخدامات, الكتلة, ت, القيمة, &الجذر, الاستخدام,
                            الحالة
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.استخراج_حمولة(_) -> {
            طابق خطأ_مستخرج_شرعية(الحقائق, البرنامج, الأنواع, الاستخدامات, الكتلة, ت) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.استخراج_حقل(_) -> {
            طابق خطأ_مستخرج_شرعية(الحقائق, البرنامج, الأنواع, الاستخدامات, الكتلة, ت) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.استخراج_فهرس(_) -> {
            طابق خطأ_مستخرج_شرعية(الحقائق, البرنامج, الأنواع, الاستخدامات, الكتلة, ت) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.بناء_إغلاق(البناء) -> {
            طابق خطأ_دالة_داخلية_شرعية(البرنامج, الأنواع, البناء.الدالة.القيمة مثل طبيعي, د, البرنامج_الكلي) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.نداء(النداء) -> {
            طابق النداء.الهدف مع
            | هدف_نداء_مسير.دالة_سلطان(المستدعاة) -> {
                طابق خطأ_دالة_داخلية_شرعية(البرنامج, الأنواع, المستدعاة.القيمة مثل طبيعي, د, البرنامج_الكلي) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | _ -> { };
        طابق طبق_نقول_مؤجلة_شرعية(الحقائق, البرنامج, الأنواع, الاستخدامات, الكتلة, ت, الحالة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        طابق طبق_أحداث_موضع_شرعية(الحقائق, الكتلة, ت + 1, حالة_الاستعارات, المؤشر, المأخوذة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ت := ت + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The destruction at instruction الموضع of block الكتلة of an owner whose
// scope ends there (الاستخدام): rejected when a holder still holds a borrow
// of it (it is live there) and reads that borrow later, on some path, before
// it is given a new value. A holder kept alive only by its own destruction
// (an owning holder destroyed after the owner in the same scope) reads
// nothing and is not one.
عرف خطأ_إتلاف_مستعار_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    حالة_الاستعارات: &متجه طبيعي,
    الاستخدام: &استخدام_مصدري_مسير
): اختياري خطأ_تدفق_سلامة {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع الخانة: طبيعي = خانة_ملكية_شرعية(
        الحقائق, &(*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع].العملية, 4
    );
    إذا (الخانة == 0) { أرجع اختياري.لا_شيء(); };
    دع المحلي: طبيعي = (*الحقائق).استعارات_الخانات[الخانة - 1];
    إذا (المحلي == 0) { أرجع اختياري.لا_شيء(); };
    دع الوصف: &وصف_استعارات_مسير = &(*الحقائق).الاستعارات;
    دع الحوامل: متجه طبيعي = حوامل_استعارة_مالك_مسير(الوصف, حالة_الاستعارات, المحلي - 1);
    // A holder read itself later is named first, then one read through what
    // carries its borrow on.
    دع الدورة: متغير طبيعي = 0;
    طالما (الدورة < 2) {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحوامل) مثل طبيعي)) {
            دع ح: طبيعي = الحوامل[ف];
            إذا (ح < (الطول((*الوصف).أماكن_الاستخدام) مثل طبيعي)
                && (الطول((*الوصف).أماكن_الاستخدام[ح]) مثل طبيعي) > 0) {
                طابق استخدام_لاحق_حامل_شرعية(
                    الحقائق, البرنامج, الاستخدامات, الكتلة, الموضع, &(*الوصف).أماكن_الاستخدام[ح], الدورة == 0
                ) مع
                | اختياري.موجود(اللاحق) -> {
                    دع السياق: سياق_مرجع_بعد_إتلاف = {
                        الحامل: معرف_رمز_من((*الوصف).الرموز[ح] مثل طبيعي),
                        المالك: (*الحقائق).رموز_الخانات[الخانة - 1],
                        الإتلاف: اختياري.موجود((*الاستخدام).الاسم),
                        الاستخدام: اختياري.موجود(اللاحق)
                    };
                    أرجع اختياري.موجود(خطأ_تدفق_سلامة.مرجع_بعد_إتلاف(السياق));
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        الدورة := الدورة + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The first read, after instruction الموضع of block الكتلة on some path, of a
// place among الأماكن (a holder's own place first, then the places whose
// reads use it) that the source states (a read of a name), before the
// holder's own place is given a whole value or declared again.
عرف استخدام_لاحق_حامل_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    الأماكن: &متجه طبيعي,
    // Only reads of the holder's own place.
    نفسه_فقط: منطقي
): اختياري نطاق {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[د];
    دع المكان_نفسه: طبيعي = (*الأماكن)[0];
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المزارة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل) { ألحق(المزارة, خطأ); ف := ف + 1; }
    دع القائمة: متغير متجه طبيعي = [الكتلة];
    دع الرأس: متغير طبيعي = 0;
    طالما (الرأس < (الطول(القائمة) مثل طبيعي)) {
        دع ك: طبيعي = القائمة[الرأس];
        دع ت: متغير طبيعي = 0;
        إذا (الرأس == 0) { ت := الموضع + 1; };
        الرأس := الرأس + 1;
        دع متوقف: متغير منطقي = خطأ;
        دع العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        طالما (!متوقف && ت < العدد) {
            دع المقروء: متغير طبيعي = 4294967295;
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تخزين(التخزين) -> {
                إذا ((التخزين.المكان.القيمة مثل طبيعي) == المكان_نفسه) { متوقف := صواب; };
            }
            | عملية_مسير.ملكية_مكان(الملكية) -> {
                طابق الملكية.الحدث مع
                | حدث_ملكية_مسير.تصريح -> {
                    إذا ((الملكية.المكان.القيمة مثل طبيعي) == المكان_نفسه) { متوقف := صواب; };
                }
                | _ -> { };
            }
            | عملية_مسير.تحميل(التحميل) -> { المقروء := التحميل.المكان.القيمة مثل طبيعي; }
            | عملية_مسير.مكان_إلى_مرجع(المرجع) -> { المقروء := المرجع.المكان.القيمة مثل طبيعي; }
            | _ -> { };
            دع المدخل: طبيعي = مدخل_تعليمة_شرعية(الحقائق, ك, ت);
            إذا (المقروء != 4294967295 && المدخل > 0
                && ((*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_قراءة_مسير()
                    || (*الاستخدامات)[المدخل - 1].الصنف == صنف_استخدام_التقاط_مسير())) {
                دع المعرف: معرف_قيمة_مسير = معرف_قيمة_مسير_من((*الدالة).المعرف, المقروء);
                دع الجذر: جذر_مكان_شرعية = جذر_مكان_شرعية_عند(الحقائق, البرنامج, المعرف);
                إذا (الجذر.الصنف == 1) {
                    دع مكان_الجذر: طبيعي = (*الحقائق).أماكن_الخانات[الجذر.الخانة];
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(*الأماكن) مثل طبيعي) && (!نفسه_فقط || م == 0)) {
                        إذا ((*الأماكن)[م] == مكان_الجذر) {
                            أرجع اختياري.موجود((*الاستخدامات)[المدخل - 1].الاسم);
                        };
                        م := م + 1;
                    }
                };
            };
            ت := ت + 1;
        }
        إذا (!متوقف) {
            دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
            دع خ: متغير طبيعي = 0;
            طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
                دع الخلف: طبيعي = الخلفاء[خ].القيمة مثل طبيعي;
                إذا (الخلف < عدد_الكتل && !المزارة[الخلف]) {
                    المزارة[الخلف] := صواب;
                    ألحق(القائمة, الخلف);
                };
                خ := خ + 1;
            }
        };
    }
    أرجع اختياري.لا_شيء();
}

// The borrow events of block الكتلة at الموضع (from المؤشر on), each
// checked against the current state.
عرف طبق_أحداث_موضع_شرعية(
    الحقائق: &دالة_شرعية,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    حالة_الاستعارات: &متغير متجه طبيعي,
    المؤشر: &متغير طبيعي,
    المأخوذة: &متغير متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    دع الوصف: &وصف_استعارات_مسير = &(*الحقائق).الاستعارات;
    إذا (الكتلة >= (الطول((*الوصف).أحداث_الكتل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الأحداث: &متجه طبيعي = &(*الوصف).أحداث_الكتل[الكتلة];
    طالما (*المؤشر < (الطول(*الأحداث) مثل طبيعي)
        && (*الوصف).مواضع_الأحداث[(*الأحداث)[*المؤشر]] <= الموضع) {
        دع الرقم: طبيعي = (*الأحداث)[*المؤشر];
        *المؤشر := *المؤشر + 1;
        طابق طبق_حدث_استعارة_مسير(الوصف, الرقم, حالة_الاستعارات, المأخوذة, صواب) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
    }
    أرجع اختياري.لا_شيء();
}

// The moves النقول_المؤجلة puts at position الموضع of block الكتلة, each
// checked against the current state.
عرف طبق_نقول_مؤجلة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    الحالة: &متغير متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    إذا (الكتلة >= (الطول((*الحقائق).النقول_المؤجلة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع د: طبيعي = (*الحقائق).الدالة;
    دع ف: متغير طبيعي = 0;
    طالما ((ف + 1) < (الطول((*الحقائق).النقول_المؤجلة[الكتلة]) مثل طبيعي)) {
        إذا ((*الحقائق).النقول_المؤجلة[الكتلة][ف] == الموضع) {
            دع الحمل: طبيعي = (*الحقائق).النقول_المؤجلة[الكتلة][ف + 1];
            دع التعريف: طبيعي = (*الحقائق).التعريفات[الحمل];
            دع كتلة_الحمل: طبيعي = (التعريف - 1) / 4294967296;
            دع موضع_الحمل: طبيعي = (التعريف - 1) % 4294967296;
            دع المدخل: طبيعي = مدخل_تعليمة_شرعية(الحقائق, كتلة_الحمل, موضع_الحمل);
            إذا (المدخل > 0) {
                طابق (*البرنامج).الدوال[د].الكتل[كتلة_الحمل].التعليمات[موضع_الحمل].العملية مع
                | عملية_مسير.تحميل(التحميل) -> {
                    دع الجذر: جذر_مكان_شرعية = جذر_مكان_شرعية_عند(الحقائق, البرنامج, التحميل.المكان);
                    طابق طبق_نقل_تحميل_شرعية(
                        الحقائق, البرنامج, الأنواع, الاستخدامات, كتلة_الحمل, موضع_الحمل, الحمل, &الجذر,
                        &(*الاستخدامات)[المدخل - 1], الحالة
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            };
        };
        ف := ف + 2;
    }
    أرجع اختياري.لا_شيء();
}

// A load whose value moves out (or is released): the move of a whole owner,
// or the error moving that value is (طبق_نقل_قيمة_تعبير's cases).
عرف طبق_نقل_تحميل_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    القيمة: طبيعي,
    الجذر: &جذر_مكان_شرعية,
    الاستخدام: &استخدام_مصدري_مسير,
    الحالة: &متغير متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    إذا (!(*الحقائق).المستهلكة[القيمة]) { أرجع اختياري.لا_شيء(); };
    دع د: طبيعي = (*الحقائق).الدالة;
    دع رقم_المدخل: طبيعي = مدخل_تعليمة_شرعية(الحقائق, الكتلة, الموضع);
    دع يملك: منطقي = يملك_للشرعية(الأنواع, (*البرنامج).الدوال[د].القيم[القيمة].النوع);
    // A release (the release primitive's argument).
    دع صنف_الجذر: طبيعي = (*الجذر).الصنف;
    إذا ((*الحقائق).المحررة[القيمة]) {
        إذا (صنف_الجذر == 1) {
            دع الرمز: معرف_رمز = (*الحقائق).رموز_الخانات[(*الجذر).الخانة];
            إذا ((*الجذر).الإسقاط) {
                أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
            };
            طابق تحقق_تحرير_شرعية(
                الحقائق, الاستخدامات, (*الجذر).الخانة, حالة_خانة_شرعية(الحقائق, &(*الحالة), (*الجذر).الخانة), الاستخدام
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا (!يملك) {
                أرجع اختياري.موجود(خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
            };
            ضع_حالة_خانة_شرعية(الحقائق, الحالة, (*الجذر).الخانة, 4);
            أرجع اختياري.لا_شيء();
        };
        إذا (صنف_الجذر == 2) {
            طابق رمز_استخدام_شرعية(الاستخدام) مع
            | اختياري.موجود(الرمز) -> {
                إذا ((*الجذر).الإسقاط) {
                    أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
                };
                أرجع اختياري.موجود(خطأ_تدفق_سلامة.تحرير_غير_مملوك(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
        أرجع اختياري.لا_شيء();
    };
    إذا (!يملك) { أرجع اختياري.لا_شيء(); };
    إذا (صنف_الجذر == 1) {
        دع الخانة: طبيعي = (*الجذر).الخانة;
        دع الرمز: معرف_رمز = (*الحقائق).رموز_الخانات[الخانة];
        إذا (!(*الجذر).الإسقاط) {
            // A move of the whole local checks it first.
            طابق تحقق_قراءة_شرعية(الحقائق, الاستخدامات, الخانة, حالة_خانة_شرعية(الحقائق, &(*الحالة), الخانة), الاستخدام) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا (!(*الحقائق).مالكة_الخانات[الخانة]) {
                أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(اختياري.موجود(الرمز), (*الاستخدام).التعبير));
            };
            ضع_حالة_خانة_شرعية(الحقائق, الحالة, الخانة, 3 + (8 * رقم_المدخل));
            أرجع اختياري.لا_شيء();
        };
        إذا (!(*الحقائق).مالكة_الخانات[الخانة]) {
            أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(اختياري.موجود(الرمز), (*الاستخدام).التعبير));
        };
        // A returned member moves its whole local: lowering states the
        // give-up right after the read.
        دع التالي: طبيعي = الموضع + 1;
        إذا (التالي < (الطول((*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات) مثل طبيعي)) {
            دع المسلم: طبيعي = خانة_ملكية_شرعية(
                الحقائق, &(*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[التالي].العملية, 3
            );
            إذا (المسلم == الخانة + 1) { أرجع اختياري.لا_شيء(); };
        };
        أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
    };
    إذا (صنف_الجذر == 2) {
        طابق رمز_استخدام_شرعية(الاستخدام) مع
        | اختياري.موجود(الرمز) -> {
            إذا ((*الجذر).الإسقاط) {
                أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
            };
            أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(اختياري.موجود(الرمز), (*الاستخدام).التعبير));
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    إذا (صنف_الجذر == 3) {
        إذا ((*الجذر).الإسقاط) {
            أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(رمز_استخدام_شرعية(الاستخدام), (*الاستخدام).التعبير));
        };
        أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(اختياري.لا_شيء(), (*الاستخدام).التعبير));
    };
    إذا (صنف_الجذر == 4) {
        // Moving a box's payload moves the box (its own load).
        إذا ((*الجذر).الإسقاط) {
            أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(رمز_استخدام_شرعية(الاستخدام), (*الاستخدام).التعبير));
        };
    };
    أرجع اختياري.لا_شيء();
}

// A member, element or payload read out of a loaded value whose value moves
// out (طبق_نقل_قيمة_تعبير's projections): a member of an owned local moved
// out alone is a partial move (unless lowering states the whole local's
// give-up right after: a returned member), one of borrowed storage a move out
// of it. Without a source use it is a match binding taking part of the
// scrutinee: only a writable module value's rejects it (its binding would
// own part of the module value).
عرف خطأ_مستخرج_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    الكتلة_الحالية: طبيعي,
    الموضع_الحالي: طبيعي
): اختياري خطأ_تدفق_سلامة {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[الكتلة_الحالية].التعليمات[الموضع_الحالي];
    طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
    | اختياري.موجود(القيمة) -> {
        إذا (القيمة >= (الطول((*الحقائق).المستهلكة) مثل طبيعي) || !(*الحقائق).المستهلكة[القيمة]) {
            أرجع اختياري.لا_شيء();
        };
        إذا (!يملك_للشرعية(الأنواع, (*البرنامج).الدوال[د].القيم[القيمة].النوع)) { أرجع اختياري.لا_شيء(); };
        دع الحمل: طبيعي = حمل_أصل_مستخرج_شرعية(الحقائق, البرنامج, القيمة);
        إذا (الحمل == 0) { أرجع اختياري.لا_شيء(); };
        دع التعريف: طبيعي = (*الحقائق).التعريفات[الحمل - 1];
        دع الكتلة: طبيعي = (التعريف - 1) / 4294967296;
        دع الموضع: طبيعي = (التعريف - 1) % 4294967296;
        طابق (*البرنامج).الدوال[د].الكتل[الكتلة].التعليمات[الموضع].العملية مع
        | عملية_مسير.تحميل(التحميل) -> {
            دع الجذر: جذر_مكان_شرعية = جذر_مكان_شرعية_عند(الحقائق, البرنامج, التحميل.المكان);
            دع مدخل_المستخرج: طبيعي = مدخل_تعليمة_شرعية(الحقائق, الكتلة_الحالية, الموضع_الحالي);
            إذا (مدخل_المستخرج > 0
                && (*الاستخدامات)[مدخل_المستخرج - 1].الصنف == صنف_استخدام_قراءة_مسير()) {
                دع الاستخدام: &استخدام_مصدري_مسير = &(*الاستخدامات)[مدخل_المستخرج - 1];
                إذا (الجذر.الصنف == 1) {
                    دع الخانة: طبيعي = الجذر.الخانة;
                    دع الرمز: معرف_رمز = (*الحقائق).رموز_الخانات[الخانة];
                    إذا (!(*الحقائق).مالكة_الخانات[الخانة]) {
                        أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(اختياري.موجود(الرمز), (*الاستخدام).التعبير));
                    };
                    دع التالي: طبيعي = الموضع_الحالي + 1;
                    إذا (التالي < (الطول((*البرنامج).الدوال[د].الكتل[الكتلة_الحالية].التعليمات) مثل طبيعي)) {
                        دع المسلم: طبيعي = خانة_ملكية_شرعية(
                            الحقائق, &(*البرنامج).الدوال[د].الكتل[الكتلة_الحالية].التعليمات[التالي].العملية, 3
                        );
                        إذا (المسلم == الخانة + 1) { أرجع اختياري.لا_شيء(); };
                    };
                    أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
                };
                إذا (الجذر.الصنف == 2) {
                    طابق رمز_استخدام_شرعية(الاستخدام) مع
                    | اختياري.موجود(الرمز) -> {
                        أرجع اختياري.موجود(خطأ_تدفق_سلامة.نقل_غير_صالح(الرمز, اختياري.موجود((*الاستخدام).التعبير)));
                    }
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
                };
                إذا (الجذر.الصنف == 3 || الجذر.الصنف == 4) {
                    أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(رمز_استخدام_شرعية(الاستخدام), (*الاستخدام).التعبير));
                };
                أرجع اختياري.لا_شيء();
            };
            إذا (الجذر.الصنف != 2) { أرجع اختياري.لا_شيء(); };
            دع المدخل: طبيعي = مدخل_تعليمة_شرعية(الحقائق, الكتلة, الموضع);
            إذا (المدخل == 0) { أرجع اختياري.لا_شيء(); };
            دع الاستخدام: &استخدام_مصدري_مسير = &(*الاستخدامات)[المدخل - 1];
            أرجع اختياري.موجود(خطأ_نقل_من_مرجع_شرعية(رمز_استخدام_شرعية(الاستخدام), (*الاستخدام).التعبير));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// The result of a closure or compile-time block written in الأم, at its
// construction or call there (none for any other function).
عرف خطأ_دالة_داخلية_شرعية(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الدالة: طبيعي,
    الأم: طبيعي,
    الحالة: &متغير حالة_شرعية_برنامج
): اختياري خطأ_تدفق_سلامة {
    إذا (الدالة >= (الطول((*الحالة).الآباء) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((*الحالة).الآباء[الدالة] != الأم + 1) { أرجع اختياري.لا_شيء(); };
    أرجع حلل_دالة_شرعية(البرنامج, الأنواع, الدالة, الحالة);
}

// The blocks of a function in reverse postorder (the successors of a block
// visited last first, so a branch's first edge comes first), with each
// block's rank in it.
عرف رتب_كتل_شرعية(الدالة: &دالة_مسير, المدخل: طبيعي, الترتيب: &متغير متجه طبيعي): متجه طبيعي {
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع الحالة: متغير متجه طبيعي = [];
    دع الرتب: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الحالة, 0); ألحق(الرتب, العدد + 1); ف := ف + 1; }
    دع اللاحق: متغير متجه طبيعي = [];
    // An explicit stack of (block, next successor).
    دع المكدس_الكتل: متغير متجه طبيعي = [المدخل];
    دع المكدس_الخلف: متغير متجه طبيعي = [0];
    دع خلفاء_الكتل: متغير متجه متجه معرف_كتلة_مسير = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(خلفاء_الكتل, خلفاء_كتلة_مسير(&(*الدالة).الكتل[ف])); ف := ف + 1; }
    الحالة[المدخل] := 1;
    طالما ((الطول(المكدس_الكتل) مثل طبيعي) > 0) {
        دع القمة: طبيعي = (الطول(المكدس_الكتل) مثل طبيعي) - 1;
        دع ك: طبيعي = المكدس_الكتل[القمة];
        دع التالي: طبيعي = المكدس_الخلف[القمة];
        دع عدد_الخلفاء: طبيعي = الطول(خلفاء_الكتل[ك]) مثل طبيعي;
        إذا (التالي < عدد_الخلفاء) {
            المكدس_الخلف[القمة] := التالي + 1;
            // The last successor is visited first.
            دع الخلف: طبيعي = خلفاء_الكتل[ك][عدد_الخلفاء - 1 - التالي].القيمة مثل طبيعي;
            إذا (الخلف < العدد && الحالة[الخلف] == 0) {
                الحالة[الخلف] := 1;
                ألحق(المكدس_الكتل, الخلف);
                ألحق(المكدس_الخلف, 0);
            };
        } وإلا {
            ألحق(اللاحق, ك);
            اقتطع(المكدس_الكتل, القمة);
            اقتطع(المكدس_الخلف, القمة);
        };
    }
    دع ن: متغير طبيعي = الطول(اللاحق) مثل طبيعي;
    دع الرتبة: متغير طبيعي = 0;
    طالما (ن > 0) {
        ن := ن - 1;
        ألحق(*الترتيب, اللاحق[ن]);
        الرتب[اللاحق[ن]] := الرتبة;
        الرتبة := الرتبة + 1;
    }
    أرجع الرتب;
}

// The blocks of the loop whose header is الرأس: the header and every block
// that reaches one of its back edges without passing the header.
عرف جسم_حلقة_شرعية(
    الدالة: &دالة_مسير,
    الرأس: طبيعي,
    الرتب: &متجه طبيعي,
    السوابق: &متجه متجه طبيعي
): متجه منطقي {
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع العضو: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العضو, خطأ); ف := ف + 1; }
    العضو[الرأس] := صواب;
    دع القائمة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*السوابق)[الرأس]) مثل طبيعي)) {
        دع السابق: طبيعي = (*السوابق)[الرأس][ف];
        إذا ((*الرتب)[السابق] >= (*الرتب)[الرأس] && (*الرتب)[السابق] <= العدد && !العضو[السابق]) {
            العضو[السابق] := صواب;
            ألحق(القائمة, السابق);
        };
        ف := ف + 1;
    }
    طالما ((الطول(القائمة) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(القائمة) مثل طبيعي) - 1;
        دع ك: طبيعي = القائمة[الأخير];
        اقتطع(القائمة, الأخير);
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول((*السوابق)[ك]) مثل طبيعي)) {
            دع السابق: طبيعي = (*السوابق)[ك][س];
            إذا (!العضو[السابق] && (*الرتب)[السابق] <= العدد) {
                العضو[السابق] := صواب;
                ألحق(القائمة, السابق);
            };
            س := س + 1;
        }
    }
    أرجع العضو;
}

عرف كتل_مفحوصة_شرعية(
    الدالة: &دالة_مسير,
    المداخل: &متجه متجه طبيعي,
    الاستعارات: &وصف_استعارات_مسير,
    النقول_المؤجلة: &متجه متجه طبيعي
): متجه منطقي {
    دع الناتج: متغير متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع مفحوصة: متغير منطقي = خطأ;
        إذا (ك < (الطول((*الاستعارات).أحداث_الكتل) مثل طبيعي)
            && (الطول((*الاستعارات).أحداث_الكتل[ك]) مثل طبيعي) > 0) {
            مفحوصة := صواب;
        };
        إذا (ك < (الطول(*النقول_المؤجلة) مثل طبيعي) && (الطول((*النقول_المؤجلة)[ك]) مثل طبيعي) > 0) {
            مفحوصة := صواب;
        };
        دع ت: متغير طبيعي = 0;
        طالما (!مفحوصة && ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*المداخل)[ك][ت] > 0) { مفحوصة := صواب; };
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.استخراج_حمولة(_) -> { مفحوصة := صواب; }
            | عملية_مسير.استخراج_حقل(_) -> { مفحوصة := صواب; }
            | عملية_مسير.استخراج_فهرس(_) -> { مفحوصة := صواب; }
            | عملية_مسير.بناء_إغلاق(_) -> { مفحوصة := صواب; }
            | عملية_مسير.نداء(_) -> { مفحوصة := صواب; }
            | _ -> { };
            ت := ت + 1;
        }
        ألحق(الناتج, مفحوصة);
        ك := ك + 1;
    }
    أرجع الناتج;
}

// The facts of one walk over the blocks of a function.
نوع مسار_شرعية = {
    الترتيب: متجه طبيعي,
    الرتب: متجه طبيعي,
    السوابق: متجه متجه طبيعي,
    // Per block: whether it heads a loop (a back edge reaches it).
    الرؤوس: متجه منطقي,
    // The entry states before any loop body repeats, and of the fixed point.
    الأولى: متجه طبيعي,
    الكاملة: متجه طبيعي,
    العدد: طبيعي,
    // Per block: its summary.
    الملخصات: متجه متجه طبيعي,
    // The same for the borrow state.
    أولى_الاستعارات: متجه طبيعي,
    كاملة_الاستعارات: متجه طبيعي
};

// Checks block ك from its entry state (الكاملة or الأولى): each statement's
// reads, then its effects.
عرف تحقق_كتلة_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    ك: طبيعي,
    الدخول: &متجه طبيعي,
    العدد: طبيعي,
    الحالة_الكلية: &متغير حالة_شرعية_برنامج,
    دخول_الاستعارات: &متجه طبيعي
): اختياري خطأ_تدفق_سلامة {
    دع د: طبيعي = (*الحقائق).الدالة;
    دع الحالة: متغير متجه طبيعي = حالة_دخول_تفصيل(الدخول, ك, العدد);
    دع حالة_الاستعارات: متغير متجه طبيعي = [];
    إذا ((*الحقائق).الاستعارات.ساكنة) {
        دع م: متغير طبيعي = 0;
        طالما (م < (*الحقائق).الاستعارات.العرض) { ألحق(حالة_الاستعارات, 0); م := م + 1; }
    } وإلا {
        حالة_الاستعارات := حالة_دخول_تفصيل(دخول_الاستعارات, ك, (*الحقائق).الاستعارات.العرض);
    };
    دع المؤشر: متغير طبيعي = 0;
    دع المأخوذة: متغير متجه طبيعي = [];
    طابق طبق_أحداث_موضع_شرعية(الحقائق, ك, 0, &متغير حالة_الاستعارات, &متغير المؤشر, &متغير المأخوذة) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع عدد_التعليمات: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
    // Operands are evaluated left to right, and so are the instructions
    // that compute them: each instruction's reads are checked against the
    // state the instructions before it left, its moves applied before the
    // next one's reads.
    دع ت: متغير طبيعي = 0;
    طالما (ت < عدد_التعليمات) {
        دع النهاية: طبيعي = ت + 1;
        طابق تحقق_قراءات_عبارة_شرعية(
            الحقائق, البرنامج, الاستخدامات, ك, ت, النهاية, &الحالة, &حالة_الاستعارات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        طابق طبق_آثار_عبارة_شرعية(
            الحقائق, البرنامج, الأنواع, الاستخدامات, ك, ت, النهاية, &متغير الحالة, الحالة_الكلية,
            &متغير حالة_الاستعارات, &متغير المؤشر, &متغير المأخوذة
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ت := النهاية;
    }
    أرجع طبق_نقول_مؤجلة_شرعية(الحقائق, البرنامج, الأنواع, الاستخدامات, ك, عدد_التعليمات, &متغير الحالة);
}

// A join the source cannot make: a local in scope on two incoming edges
// (a state on both) holds no value on one and was moved out or released on
// the other, or was moved out on one and released on the other. The
// incoming states are folded in the order of the predecessors. The block
// every return goes through joins nothing the source merges.
عرف دمج_مرفوض_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    ك: طبيعي,
    الدخول: &متجه طبيعي,
    العدد: طبيعي,
    السوابق: &متجه متجه طبيعي,
    الملخصات: &متجه متجه طبيعي
): اختياري معرف_رمز {
    إذا (العدد == 0 || (الطول((*السوابق)[ك]) مثل طبيعي) < 2) { أرجع اختياري.لا_شيء(); };
    طابق (*البرنامج).الدوال[(*الحقائق).الدالة].الكتل[ك].المنهي مع
    | اختياري.موجود(منهي_مسير.إرجاع(_)) -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    دع المجمعة: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) { ألحق(المجمعة, 0); م := م + 1; }
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول((*السوابق)[ك]) مثل طبيعي)) {
        دع السابقة: طبيعي = (*السوابق)[ك][س];
        دع الخارجة: متغير متجه طبيعي = حالة_دخول_تفصيل(الدخول, السابقة, العدد);
        طبق_ملخص_كتلة_مسير(&(*الملخصات)[السابقة], &متغير الخارجة);
        م := 0;
        طالما (م < العدد) {
            دع أ: طبيعي = المجمعة[م];
            دع ب: طبيعي = الخارجة[م];
            إذا (أ != 0 && ب != 0 && صنفا_دمج_متنافران_شرعية(أ % 8, ب % 8)) {
                دع خ: متغير طبيعي = 0;
                طالما (خ < (الطول((*الحقائق).حالات_الخانات) مثل طبيعي)) {
                    إذا ((*الحقائق).حالات_الخانات[خ] == م + 1) { أرجع اختياري.موجود((*الحقائق).رموز_الخانات[خ]); };
                    خ := خ + 1;
                }
            };
            المجمعة[م] := ادمج_حالة_شرعية_مسير(أ, ب);
            م := م + 1;
        }
        س := س + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Two kinds of the legality lattice the source cannot merge: none of them
// a value, and of different kinds of absence (no value, moved, released).
عرف صنفا_دمج_متنافران_شرعية(أ: طبيعي, ب: طبيعي): منطقي {
    إذا (أ == 2 || ب == 2) { أرجع خطأ; };
    دع فئة_أ: طبيعي = فئة_دمج_شرعية(أ);
    دع فئة_ب: طبيعي = فئة_دمج_شرعية(ب);
    أرجع فئة_أ != فئة_ب;
}

عرف فئة_دمج_شرعية(الصنف: طبيعي): طبيعي {
    إذا (الصنف == 3 || الصنف == 6) { أرجع 2; };
    إذا (الصنف == 4 || الصنف == 7) { أرجع 3; };
    أرجع 1;
}

// Walks the blocks العضو marks (all when empty) in reverse postorder from
// rank البداية, with the entry states the walk names (الأولى when
// بالأولى). A loop met on the way, other than the one walked (الحلقة, a
// header plus one), is walked twice in its place: first with the states
// before its body repeats, then with those of the fixed point.
عرف امش_كتل_شرعية(
    الحقائق: &دالة_شرعية,
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    المسار: &مسار_شرعية,
    العضو: &متجه منطقي,
    الحلقة: طبيعي,
    بالأولى: منطقي,
    الحالة_الكلية: &متغير حالة_شرعية_برنامج,
    // Every block once, with the fixed point: whether any use is rejected.
    مرة_واحدة: منطقي
): اختياري خطأ_تدفق_سلامة {
    دع المزارة: متغير متجه منطقي = [];
    دع عدد_الكتل: طبيعي = الطول((*المسار).الرتب) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل) { ألحق(المزارة, خطأ); ف := ف + 1; }
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*المسار).الترتيب) مثل طبيعي)) {
        دع ك: طبيعي = (*المسار).الترتيب[ر];
        دع فيها: منطقي = (الطول(*العضو) مثل طبيعي) == 0 || (*العضو)[ك];
        إذا (فيها && !المزارة[ك]) {
            إذا (!مرة_واحدة && (*المسار).الرؤوس[ك] && الحلقة != ك + 1) {
                دع الجسم: متجه منطقي = جسم_حلقة_شرعية(
                    &(*البرنامج).الدوال[(*الحقائق).الدالة], ك, &(*المسار).الرتب, &(*المسار).السوابق
                );
                // Only the part inside the walked region.
                دع الجزء: متغير متجه منطقي = [];
                دع ب: متغير طبيعي = 0;
                طالما (ب < عدد_الكتل) {
                    ألحق(الجزء, الجسم[ب] && ((الطول(*العضو) مثل طبيعي) == 0 || (*العضو)[ب]));
                    إذا (الجزء[ب]) { المزارة[ب] := صواب; };
                    ب := ب + 1;
                }
                طابق امش_كتل_شرعية(
                    الحقائق, البرنامج, الأنواع, الاستخدامات, المسار, &الجزء, ك + 1, صواب, الحالة_الكلية, خطأ
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                طابق امش_كتل_شرعية(
                    الحقائق, البرنامج, الأنواع, الاستخدامات, المسار, &الجزء, ك + 1, خطأ, الحالة_الكلية, خطأ
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            } وإلا {
                المزارة[ك] := صواب;
                دع الدخول: متغير &متجه طبيعي = &(*المسار).الكاملة;
                دع دخول_الاستعارات: متغير &متجه طبيعي = &(*المسار).كاملة_الاستعارات;
                إذا (بالأولى) { الدخول := &(*المسار).الأولى; دخول_الاستعارات := &(*المسار).أولى_الاستعارات; };
                طابق دمج_مرفوض_شرعية(
                    الحقائق, البرنامج, ك, الدخول, (*المسار).العدد, &(*المسار).السوابق, &(*المسار).الملخصات
                ) مع
                | اختياري.موجود(الرمز) -> { أرجع اختياري.موجود(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز)); }
                | اختياري.لا_شيء -> { };
                // A join whose borrows cannot both hold.
                طابق دمج_مرفوض_استعارات_عند_مسير(&(*الحقائق).الاستعارات, دخول_الاستعارات, ك) مع
                | اختياري.موجود(الرمز) -> { أرجع اختياري.موجود(خطأ_تدفق_سلامة.دمج_غير_صالح(الرمز)); }
                | اختياري.لا_شيء -> { };
                إذا ((*الحقائق).المفحوصة[ك]) {
                    طابق تحقق_كتلة_شرعية(
                        الحقائق, البرنامج, الأنواع, الاستخدامات, ك, الدخول, (*المسار).العدد, الحالة_الكلية,
                        دخول_الاستعارات
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ر := ر + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The first rejected use of function د (memoized in الحالة).
عرف حلل_دالة_شرعية(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    الحالة: &متغير حالة_شرعية_برنامج
): اختياري خطأ_تدفق_سلامة {
    إذا ((*الحالة).الحالات[د] == 1) { أرجع اختياري.لا_شيء(); };
    إذا ((*الحالة).الحالات[د] == 2) { أرجع (*الحالة).الأخطاء[د]; };
    (*الحالة).الحالات[د] := 1;
    دع الناتج: اختياري خطأ_تدفق_سلامة = حلل_دالة_شرعية_مرة(البرنامج, الأنواع, د, الحالة);
    طابق الناتج مع
    | اختياري.موجود(_) -> {
        (*الحالة).الحالات[د] := 2;
        (*الحالة).الأخطاء[د] := الناتج;
    }
    | اختياري.لا_شيء -> { };
    أرجع الناتج;
}

عرف حلل_دالة_شرعية_مرة(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    الحالة_الكلية: &متغير حالة_شرعية_برنامج
): اختياري خطأ_تدفق_سلامة {
    دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[د];
    دع بلا_استخدامات: متجه استخدام_مصدري_مسير = [];
    دع الاستخدامات: متغير &متجه استخدام_مصدري_مسير = &بلا_استخدامات;
    إذا (د < (الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي)) {
        الاستخدامات := &(*البرنامج).مصادر_الاستخدامات[د];
    };
    دع المدخل: طبيعي;
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(الكتلة) -> { المدخل := الكتلة.القيمة مثل طبيعي; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع عدد_القيم: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    // Block identities are their positions (the builder appends them so).
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل) {
        إذا (((*الدالة).الكتل[ف].المعرف.القيمة مثل طبيعي) != ف) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    // Definitions, the places of source locals, and the uses by instruction.
    دع التعريفات: متغير متجه طبيعي = [];
    دع خانات_القيم: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { ألحق(التعريفات, 0); ألحق(خانات_القيم, 0); ف := ف + 1; }
    دع أماكن_الخانات: متغير متجه طبيعي = [];
    دع رموز_الخانات: متغير متجه معرف_رمز = [];
    دع المداخل: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع مداخل_الكتلة: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ألحق(مداخل_الكتلة, 0);
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(القيمة) -> {
                إذا (القيمة < عدد_القيم) {
                    التعريفات[القيمة] := رقم_تعريف_شرعية(ك, ت);
                    طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                    | عملية_مسير.مكان_محلي(المكان) -> {
                        طابق المكان.المحلي مع
                        | اختياري.موجود(الرمز) -> {
                            ألحق(أماكن_الخانات, القيمة);
                            ألحق(رموز_الخانات, الرمز);
                            خانات_القيم[القيمة] := الطول(أماكن_الخانات) مثل طبيعي;
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | _ -> { };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ألحق(المداخل, مداخل_الكتلة);
        ك := ك + 1;
    }
    دع عدد_الخانات: طبيعي = الطول(أماكن_الخانات) مثل طبيعي;
    دع مالكة_الخانات: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_الخانات) { ألحق(مالكة_الخانات, خطأ); ف := ف + 1; }
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*الاستخدامات) مثل طبيعي)) {
        دع الكتلة: طبيعي = (*الاستخدامات)[م].الكتلة مثل طبيعي;
        دع الموضع: طبيعي = (*الاستخدامات)[م].الموضع مثل طبيعي;
        إذا (الكتلة < عدد_الكتل && الموضع < (الطول(المداخل[الكتلة]) مثل طبيعي)) {
            إذا ((*الاستخدامات)[م].الصنف == صنف_استخدام_مالك_مسير()) {
                دع الخانة: طبيعي = خانة_ملكية_عند_شرعية(الدالة, &خانات_القيم, الكتلة, الموضع);
                إذا (الخانة > 0) { مالكة_الخانات[الخانة - 1] := صواب; };
            } وإلا إذا (المداخل[الكتلة][الموضع] == 0) {
                المداخل[الكتلة][الموضع] := م + 1;
            };
        };
        م := م + 1;
    }
    دع المالكة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { ألحق(المالكة, خطأ); ف := ف + 1; }
    ف := 0;
    طالما (ف < عدد_الخانات) {
        إذا (مالكة_الخانات[ف]) { المالكة[أماكن_الخانات[ف]] := صواب; };
        ف := ف + 1;
    }
    // What moves out: drop elaboration's derived values (a box payload, an
    // owned sequence retyped), with only the uses of the source passing a move
    // back to what they derive from (a payload the code lowering adds for
    // itself reads, such as the old value an assignment destroys or a swap
    // exchanges, moves nothing out of the box).
    دع الاستهلاك: متغير استهلاك_قيم_دالة_مسير = احسب_استهلاك_قيم_دالة_مسير(البرنامج, د, &المالكة, الأنواع);
    دع المحولة: متغير متجه طبيعي = [];
    بدّل(المحولة, الاستهلاك.المحولة);
    دع المستهلكة: متغير متجه منطقي = استهلاك_مصدري_شرعية(
        الدالة, الأنواع, &التعريفات, &خانات_القيم, &مالكة_الخانات, &المحولة, &المداخل
    );
    // The locals the dataflow follows: owners that may move out, and every
    // local some
    // declaration of which is not given its value right there.
    دع حالات_الخانات: متجه طبيعي = حالات_خانات_شرعية(
        الدالة, &التعريفات, &خانات_القيم, &مالكة_الخانات, الاستخدامات, &المستهلكة
    );
    دع عدد_المتتبعة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < عدد_الخانات) {
        إذا (حالات_الخانات[ف] > عدد_المتتبعة) { عدد_المتتبعة := حالات_الخانات[ف]; };
        ف := ف + 1;
    }
    دع المحررة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { ألحق(المحررة, خطأ); ف := ف + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.تحرير) -> {
                    إذا ((الطول(النداء.الحجج) مثل طبيعي) > 0) {
                        دع الحجة: طبيعي = النداء.الحجج[0].القيمة مثل طبيعي;
                        إذا (الحجة < عدد_القيم) { المحررة[الحجة] := صواب; };
                    };
                }
                | _ -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا ((*الحالة_الكلية).يجمع_النقول) {
        اجمع_نقول_أسماء_شرعية(
            الدالة, الاستخدامات, &المداخل, &خانات_القيم, &مالكة_الخانات, &المستهلكة, &المحررة,
            &متغير (*الحالة_الكلية).النقول
        );
    };
    دع النقول_المؤجلة: متجه متجه طبيعي = نقول_مؤجلة_دالة_شرعية(
        الدالة, &التعريفات, &خانات_القيم, &مالكة_الخانات, &المستهلكة
    );
    دع المؤجلة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { ألحق(المؤجلة, خطأ); ف := ف + 1; }
    ك := 0;
    طالما (ك < (الطول(النقول_المؤجلة) مثل طبيعي)) {
        دع ي: متغير طبيعي = 1;
        طالما (ي < (الطول(النقول_المؤجلة[ك]) مثل طبيعي)) { المؤجلة[النقول_المؤجلة[ك][ي]] := صواب; ي := ي + 2; }
        ك := ك + 1;
    }
    // The borrow state, when lowering recorded borrow events.
    دع وصف_الاستعارات: متغير وصف_استعارات_مسير = وصف_استعارات_فارغ_مسير();
    إذا (د < (الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي)
        && (الطول((*البرنامج).أحداث_الاستعارة[د]) مثل طبيعي) > 0) {
        دع التصريحات: متغير متجه طبيعي = [];
        ك := 0;
        طالما (ك < عدد_الكتل) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.ملكية_مكان(الملكية) -> {
                    طابق الملكية.الحدث مع
                    | حدث_ملكية_مسير.تصريح -> {
                        دع المكان: طبيعي = الملكية.المكان.القيمة مثل طبيعي;
                        إذا (المكان < عدد_القيم && خانات_القيم[المكان] > 0) {
                            ألحق(التصريحات, ك);
                            ألحق(التصريحات, ت + 1);
                            ألحق(التصريحات, رموز_الخانات[خانات_القيم[المكان] - 1].القيمة مثل طبيعي);
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        وصف_الاستعارات := ابن_وصف_استعارات_مسير(
            &(*البرنامج).أحداث_الاستعارة[د], &التصريحات, عدد_الكتل
        );
        // Where each holder's borrows end: its liveness on this MSIR
        // (borrow_liveness.sn), from the place of each followed local.
        دع أماكن_الاستعارات: متغير متجه طبيعي = [];
        ف := 0;
        طالما (ف < (الطول(وصف_الاستعارات.الرموز) مثل طبيعي)) { ألحق(أماكن_الاستعارات, 0); ف := ف + 1; }
        ف := 0;
        طالما (ف < عدد_الخانات) {
            دع المحلي: طبيعي = محلي_رمز_استعارة_مسير(&وصف_الاستعارات, رموز_الخانات[ف].القيمة مثل ط32);
            إذا (المحلي < (الطول(أماكن_الاستعارات) مثل طبيعي)) { أماكن_الاستعارات[المحلي] := أماكن_الخانات[ف] + 1; };
            ف := ف + 1;
        }
        أضف_نهايات_حياة_استعارات_مسير(&متغير وصف_الاستعارات, الدالة, الأنواع, &أماكن_الاستعارات);
    };
    دع استعارات_الخانات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الخانات) {
        دع المحلي: طبيعي = محلي_رمز_استعارة_مسير(&وصف_الاستعارات, رموز_الخانات[ف].القيمة مثل ط32);
        إذا (المحلي == 4294967295) { ألحق(استعارات_الخانات, 0); } وإلا { ألحق(استعارات_الخانات, المحلي + 1); };
        ف := ف + 1;
    }
    دع المفحوصة: متجه منطقي = كتل_مفحوصة_شرعية(الدالة, &المداخل, &وصف_الاستعارات, &النقول_المؤجلة);
    دع الحقائق: دالة_شرعية = {
        الدالة: د,
        التعريفات: التعريفات,
        خانات_القيم: خانات_القيم,
        المداخل: المداخل,
        أماكن_الخانات: أماكن_الخانات,
        رموز_الخانات: رموز_الخانات,
        مالكة_الخانات: مالكة_الخانات,
        حالات_الخانات: حالات_الخانات,
        المستهلكة: المستهلكة,
        المحولة: المحولة,
        المحررة: المحررة,
        النقول_المؤجلة: النقول_المؤجلة,
        المؤجلة: المؤجلة,
        الاستعارات: وصف_الاستعارات,
        استعارات_الخانات: استعارات_الخانات,
        المفحوصة: المفحوصة
    };
    // The block summaries, the order of the walk and its loops.
    دع الملخصات: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع الملخص: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ألحق_أثر_تعليمة_شرعية(&الحقائق, البرنامج, الأنواع, ك, ت, &متغير الملخص);
            ألحق_نقولا_مؤجلة_شرعية(&الحقائق, البرنامج, الأنواع, ك, ت, &متغير الملخص);
            ت := ت + 1;
        }
        ألحق_نقولا_مؤجلة_شرعية(&الحقائق, البرنامج, الأنواع, ك, ت, &متغير الملخص);
        ألحق(الملخصات, الملخص);
        ك := ك + 1;
    }
    دع الترتيب: متغير متجه طبيعي = [];
    دع الرتب: متجه طبيعي = رتب_كتل_شرعية(الدالة, المدخل, &متغير الترتيب);
    دع السوابق: متغير متجه متجه طبيعي = [];
    دع الرؤوس: متغير متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع فارغة: متجه طبيعي = []; ألحق(السوابق, فارغة); ألحق(الرؤوس, خطأ); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (الرتب[ك] < عدد_الكتل) {
            دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
            دع خ: متغير طبيعي = 0;
            طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
                دع الخلف: طبيعي = الخلفاء[خ].القيمة مثل طبيعي;
                إذا (الخلف < عدد_الكتل) {
                    ألحق(السوابق[الخلف], ك);
                    إذا (الرتب[الخلف] <= الرتب[ك]) { الرؤوس[الخلف] := صواب; };
                };
                خ := خ + 1;
            }
        };
        ك := ك + 1;
    }
    دع البداية: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_المتتبعة) { ألحق(البداية, 0); ف := ف + 1; }
    دع بلا_استعارات: وصف_استعارات_مسير = وصف_استعارات_فارغ_مسير();
    دع الكاملة: متجه طبيعي = احسب_حالات_دخول_شبكة_مسير(
        الدالة, المدخل, عدد_المتتبعة, &البداية, &الملخصات, شبكة_تهيئة_مسير.شرعية(), &الرتب, خطأ,
        &بلا_استعارات
    );
    دع عرض_الاستعارات: طبيعي = الحقائق.الاستعارات.العرض;
    دع بداية_الاستعارات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عرض_الاستعارات) { ألحق(بداية_الاستعارات, 0); ف := ف + 1; }
    دع كاملة_الاستعارات: متغير متجه طبيعي = [];
    إذا (!الحقائق.الاستعارات.ساكنة) {
        كاملة_الاستعارات := احسب_حالات_دخول_شبكة_مسير(
            الدالة, المدخل, عرض_الاستعارات, &بداية_الاستعارات, &الحقائق.الاستعارات.أحداث_الكتل,
            شبكة_تهيئة_مسير.استعارات(), &الرتب, خطأ, &الحقائق.الاستعارات
        );
    };
    دع الأولى_الفارغة: متجه طبيعي = [];
    دع أولى_الاستعارات_الفارغة: متجه طبيعي = [];
    دع المسار: متغير مسار_شرعية = {
        الترتيب: الترتيب,
        الرتب: الرتب,
        السوابق: السوابق,
        الرؤوس: الرؤوس,
        الأولى: الأولى_الفارغة,
        الكاملة: الكاملة,
        العدد: عدد_المتتبعة,
        الملخصات: الملخصات,
        أولى_الاستعارات: أولى_الاستعارات_الفارغة,
        كاملة_الاستعارات: كاملة_الاستعارات
    };
    دع الكل: متجه منطقي = [];
    // A state before a loop body repeats is never worse than the fixed
    // point's, so a function whose every use the fixed point accepts has no
    // error. Only a rejected function is walked in the source's order.
    طابق امش_كتل_شرعية(
        &الحقائق, البرنامج, الأنواع, الاستخدامات, &المسار, &الكل, 0, خطأ, الحالة_الكلية, صواب
    ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    دع له_حلقة: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < عدد_الكتل) { إذا (المسار.الرؤوس[ك]) { له_حلقة := صواب; }; ك := ك + 1; }
    إذا (له_حلقة) {
        المسار.الأولى := احسب_حالات_دخول_شبكة_مسير(
            الدالة, المدخل, عدد_المتتبعة, &البداية, &المسار.الملخصات, شبكة_تهيئة_مسير.شرعية(), &المسار.الرتب, صواب,
            &بلا_استعارات
        );
        إذا (!الحقائق.الاستعارات.ساكنة) {
            المسار.أولى_الاستعارات := احسب_حالات_دخول_شبكة_مسير(
                الدالة, المدخل, عرض_الاستعارات, &بداية_الاستعارات, &الحقائق.الاستعارات.أحداث_الكتل,
                شبكة_تهيئة_مسير.استعارات(), &المسار.الرتب, صواب, &الحقائق.الاستعارات
            );
        };
    };
    أرجع امش_كتل_شرعية(
        &الحقائق, البرنامج, الأنواع, الاستخدامات, &المسار, &الكل, 0, خطأ, الحالة_الكلية, خطأ
    );
}

// The values an instruction takes ownership of (drop elaboration's
// ألحق_قيم_مأخوذة_تعليمة_مسير), as positions; a store into the place of a
// tracked local that owns nothing takes none.
عرف ألحق_قيم_مستهلكة_شرعية(
    العملية: &عملية_مسير,
    خانات_القيم: &متجه طبيعي,
    مالكة_الخانات: &متجه منطقي,
    الناتج: &متغير متجه طبيعي
): فراغ {
    طابق *العملية مع
    | عملية_مسير.تخزين(ت) -> {
        دع المكان: طبيعي = ت.المكان.القيمة مثل طبيعي;
        إذا (المكان < (الطول(*خانات_القيم) مثل طبيعي) && (*خانات_القيم)[المكان] > 0) {
            إذا (!(*مالكة_الخانات)[(*خانات_القيم)[المكان] - 1]) { أرجع; };
        };
        ألحق(*الناتج, ت.القيمة.القيمة مثل طبيعي);
    }
    | _ -> {
        دع بلا_أماكن: متجه منطقي = [];
        ألحق_قيم_مأخوذة_تعليمة_مسير(العملية, &بلا_أماكن, الناتج);
    };
}

// The values moved out (دالة_شرعية.المستهلكة): those an owning use takes
// directly, and, to a fixed point, what a moved-out derived value with a
// source use derives from.
عرف استهلاك_مصدري_شرعية(
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    التعريفات: &متجه طبيعي,
    خانات_القيم: &متجه طبيعي,
    مالكة_الخانات: &متجه منطقي,
    المحولة: &متجه طبيعي,
    المداخل: &متجه متجه طبيعي
): متجه منطقي {
    دع عدد_القيم: طبيعي = الطول(*التعريفات) مثل طبيعي;
    دع الناتج: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(الناتج, خطأ); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        دع ت: متغير طبيعي = 0;
        طالما (ت <= العدد) {
            دع القيم: متغير متجه طبيعي = [];
            إذا (ت < العدد) {
                ألحق_قيم_مستهلكة_شرعية(&(*الدالة).الكتل[ك].التعليمات[ت].العملية, خانات_القيم, مالكة_الخانات, &متغير القيم);
            } وإلا {
                ألحق_قيم_مأخوذة_منهي_مسير(&(*الدالة).الكتل[ك].المنهي, &متغير القيم);
            };
            دع ق: متغير طبيعي = 0;
            طالما (ق < (الطول(القيم) مثل طبيعي)) {
                إذا (القيم[ق] < عدد_القيم) { الناتج[القيم[ق]] := صواب; };
                ق := ق + 1;
            }
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // Values are only marked, so a round that changes marks at least one
    // more: this reaches the fixed point.
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع ق: متغير طبيعي = 0;
        طالما (ق < عدد_القيم) {
            دع الأصل: طبيعي = (*المحولة)[ق];
            إذا (الأصل != 0 && الناتج[ق] && !الناتج[الأصل - 1]) {
                دع التعريف: طبيعي = (*التعريفات)[ق];
                إذا (التعريف != 0) {
                    دع الكتلة: طبيعي = (التعريف - 1) / 4294967296;
                    دع الموضع: طبيعي = (التعريف - 1) % 4294967296;
                    إذا ((*المداخل)[الكتلة][الموضع] > 0
                        && هل_نوع_يملك_تخزينا_مسير(الأنواع, (*الدالة).القيم[ق].النوع)) {
                        الناتج[الأصل - 1] := صواب;
                        تغير := صواب;
                    };
                };
            };
            ق := ق + 1;
        }
    }
    أرجع الناتج;
}

// The loads of a whole tracked local whose value moves out in a later block
// than the load's (دالة_شرعية.النقول_المؤجلة): where its first owning use is.
عرف نقول_مؤجلة_دالة_شرعية(
    الدالة: &دالة_مسير,
    التعريفات: &متجه طبيعي,
    خانات_القيم: &متجه طبيعي,
    مالكة_الخانات: &متجه منطقي,
    المستهلكة: &متجه منطقي
): متجه متجه طبيعي {
    دع عدد_القيم: طبيعي = الطول(*التعريفات) مثل طبيعي;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المستهلك: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(المستهلك, 0); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        دع ت: متغير طبيعي = 0;
        طالما (ت <= العدد) {
            دع القيم: متغير متجه طبيعي = [];
            إذا (ت < العدد) {
                ألحق_قيم_مستهلكة_شرعية(&(*الدالة).الكتل[ك].التعليمات[ت].العملية, خانات_القيم, مالكة_الخانات, &متغير القيم);
            } وإلا {
                ألحق_قيم_مأخوذة_منهي_مسير(&(*الدالة).الكتل[ك].المنهي, &متغير القيم);
            };
            دع ق: متغير طبيعي = 0;
            طالما (ق < (الطول(القيم) مثل طبيعي)) {
                دع القيمة: طبيعي = القيم[ق];
                إذا (القيمة < عدد_القيم && المستهلك[القيمة] == 0) {
                    المستهلك[القيمة] := رقم_تعريف_شرعية(ك, ت);
                };
                ق := ق + 1;
            }
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع الناتج: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع فارغة: متجه طبيعي = []; ألحق(الناتج, فارغة); ك := ك + 1; }
    دع القيمة: متغير طبيعي = 0;
    طالما (القيمة < عدد_القيم) {
        إذا ((*المستهلكة)[القيمة] && المستهلك[القيمة] != 0 && (*التعريفات)[القيمة] != 0) {
            دع التعريف: طبيعي = (*التعريفات)[القيمة];
            دع كتلة_الحمل: طبيعي = (التعريف - 1) / 4294967296;
            دع موضع_الحمل: طبيعي = (التعريف - 1) % 4294967296;
            طابق (*الدالة).الكتل[كتلة_الحمل].التعليمات[موضع_الحمل].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                دع المكان: طبيعي = التحميل.المكان.القيمة مثل طبيعي;
                إذا (المكان < (الطول(*خانات_القيم) مثل طبيعي) && (*خانات_القيم)[المكان] > 0) {
                    دع كتلة_المستهلك: طبيعي = (المستهلك[القيمة] - 1) / 4294967296;
                    دع موضع_المستهلك: طبيعي = (المستهلك[القيمة] - 1) % 4294967296;
                    إذا (كتلة_المستهلك != كتلة_الحمل) {
                        ألحق(الناتج[كتلة_المستهلك], موضع_المستهلك);
                        ألحق(الناتج[كتلة_المستهلك], القيمة);
                    };
                };
            }
            | _ -> { };
        };
        القيمة := القيمة + 1;
    }
    أرجع الناتج;
}

// The local whose place a place is (through members and elements), plus
// one.
عرف خانة_جذر_بسيط_شرعية(
    الدالة: &دالة_مسير,
    التعريفات: &متجه طبيعي,
    خانات_القيم: &متجه طبيعي,
    المكان: طبيعي
): طبيعي {
    دع الحالي: متغير طبيعي = المكان;
    دع الخطوات: متغير طبيعي = 0;
    طالما (الخطوات <= (الطول(*التعريفات) مثل طبيعي) && الحالي < (الطول(*التعريفات) مثل طبيعي)) {
        إذا ((*خانات_القيم)[الحالي] > 0) { أرجع (*خانات_القيم)[الحالي]; };
        دع التعريف: طبيعي = (*التعريفات)[الحالي];
        إذا (التعريف == 0) { أرجع 0; };
        طابق (*الدالة).الكتل[(التعريف - 1) / 4294967296].التعليمات[(التعريف - 1) % 4294967296].العملية مع
        | عملية_مسير.مكان_حقل(الحقل) -> { الحالي := الحقل.الأصل.القيمة مثل طبيعي; }
        | عملية_مسير.مكان_فهرس(الفهرس) -> { الحالي := الفهرس.الأصل.القيمة مثل طبيعي; }
        | _ -> { أرجع 0; };
        الخطوات := الخطوات + 1;
    }
    أرجع 0;
}

// The tracked local the whole store at instruction الموضع of block الكتلة
// writes, plus one.
عرف خانة_تخزين_كامل_شرعية_في(
    الدالة: &دالة_مسير,
    خانات_القيم: &متجه طبيعي,
    الكتلة: طبيعي,
    الموضع: طبيعي
): طبيعي {
    طابق (*الدالة).الكتل[الكتلة].التعليمات[الموضع].العملية مع
    | عملية_مسير.تخزين(التخزين) -> {
        دع المكان: طبيعي = التخزين.المكان.القيمة مثل طبيعي;
        إذا (المكان >= (الطول(*خانات_القيم) مثل طبيعي)) { أرجع 0; };
        أرجع (*خانات_القيم)[المكان];
    }
    | _ -> { أرجع 0; };
}

// The position among the states of each local the dataflow follows, plus one
// (دالة_شرعية.حالات_الخانات): an owner whose value may leave it, a local
// assigned again though declared without `mutable`, or a local some
// declaration (تصريح)
// of which a use or the end of its block follows before a store gives it its
// value.
عرف حالات_خانات_شرعية(
    الدالة: &دالة_مسير,
    التعريفات: &متجه طبيعي,
    خانات_القيم: &متجه طبيعي,
    مالكة_الخانات: &متجه منطقي,
    الاستخدامات: &متجه استخدام_مصدري_مسير,
    المستهلكة: &متجه منطقي
): متجه طبيعي {
    دع عدد_الخانات: طبيعي = الطول(*مالكة_الخانات) مثل طبيعي;
    دع متتبعة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الخانات) { ألحق(متتبعة, خطأ); ف := ف + 1; }
    // An owner whose value may leave it: a load of its whole place moves out,
    // or lowering states a give-up. Any other owner holds its value from its
    // declaration on, like a plain local.
    دع ك_نقل: متغير طبيعي = 0;
    طالما (ك_نقل < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك_نقل].التعليمات) مثل طبيعي)) {
            دع المكان: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك_نقل].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك_نقل].التعليمات[ت]) مع
                | اختياري.موجود(القيمة) -> {
                    إذا (القيمة < (الطول(*المستهلكة) مثل طبيعي) && (*المستهلكة)[القيمة]) {
                        المكان := (التحميل.المكان.القيمة مثل طبيعي) + 1;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | عملية_مسير.ملكية_مكان(الملكية) -> {
                طابق الملكية.الحدث مع
                | حدث_ملكية_مسير.تسليم -> { المكان := (الملكية.المكان.القيمة مثل طبيعي) + 1; }
                | _ -> { };
            }
            | _ -> { };
            إذا (المكان > 0 && (المكان - 1) < (الطول(*خانات_القيم) مثل طبيعي)) {
                دع الخانة: طبيعي = (*خانات_القيم)[المكان - 1];
                إذا (الخانة > 0 && (*مالكة_الخانات)[الخانة - 1]) { متتبعة[الخانة - 1] := صواب; };
            };
            ت := ت + 1;
        }
        ك_نقل := ك_نقل + 1;
    }
    // Per block and instruction: the store that gives a local its value
    // where it is declared.
    دع المهيئة: متغير متجه متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع أعلام: متغير متجه منطقي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) { ألحق(أعلام, خطأ); ت := ت + 1; }
        ألحق(المهيئة, أعلام);
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        دع ت: متغير طبيعي = 0;
        طالما (ت < العدد) {
            دع المصرح: متغير طبيعي = 0;
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ملكية_مكان(الملكية) -> {
                طابق الملكية.الحدث مع
                | حدث_ملكية_مسير.تصريح -> {
                    دع المكان: طبيعي = الملكية.المكان.القيمة مثل طبيعي;
                    إذا (المكان < (الطول(*خانات_القيم) مثل طبيعي)) { المصرح := (*خانات_القيم)[المكان]; };
                }
                | _ -> { };
            }
            | _ -> { };
            إذا (المصرح > 0 && !متتبعة[المصرح - 1]) {
                // Given its value before any use in the block?
                دع معطاة: متغير منطقي = خطأ;
                دع منتهية: متغير منطقي = خطأ;
                دع ي: متغير طبيعي = ت + 1;
                طالما (ي < العدد && !منتهية) {
                    دع المكان: متغير طبيعي = 0;
                    دع كامل: متغير منطقي = خطأ;
                    طابق (*الدالة).الكتل[ك].التعليمات[ي].العملية مع
                    | عملية_مسير.تخزين(التخزين) -> { المكان := (التخزين.المكان.القيمة مثل طبيعي) + 1; كامل := صواب; }
                    | عملية_مسير.تحميل(التحميل) -> { المكان := (التحميل.المكان.القيمة مثل طبيعي) + 1; }
                    | عملية_مسير.مكان_إلى_مرجع(المرجع) -> { المكان := (المرجع.المكان.القيمة مثل طبيعي) + 1; }
                    | عملية_مسير.ملكية_مكان(الملكية) -> {
                        طابق الملكية.الحدث مع
                        | حدث_ملكية_مسير.تصريح -> { المكان := (الملكية.المكان.القيمة مثل طبيعي) + 1; }
                        | _ -> { };
                    }
                    | _ -> { };
                    إذا (المكان > 0) {
                        دع الموضع: طبيعي = المكان - 1;
                        إذا (كامل && الموضع < (الطول(*خانات_القيم) مثل طبيعي) && (*خانات_القيم)[الموضع] == المصرح) {
                            معطاة := صواب;
                            منتهية := صواب;
                            المهيئة[ك][ي] := صواب;
                        } وإلا إذا (خانة_جذر_بسيط_شرعية(الدالة, التعريفات, خانات_القيم, الموضع) == المصرح) {
                            منتهية := صواب;
                        };
                    };
                    ي := ي + 1;
                }
                إذا (!معطاة) { متتبعة[المصرح - 1] := صواب; };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // An assignment to a local declared without `mutable` that is not the
    // value it is declared with: the analysis needs the local's state there.
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*الاستخدامات) مثل طبيعي)) {
        إذا ((*الاستخدامات)[م].الصنف == صنف_استخدام_إسناد_ثابت_مسير()) {
            دع الكتلة: طبيعي = (*الاستخدامات)[م].الكتلة مثل طبيعي;
            دع الموضع: طبيعي = (*الاستخدامات)[م].الموضع مثل طبيعي;
            إذا (الكتلة < (الطول(المهيئة) مثل طبيعي) && الموضع < (الطول(المهيئة[الكتلة]) مثل طبيعي)) {
                إذا (!المهيئة[الكتلة][الموضع]) {
                    دع الخانة: طبيعي = خانة_تخزين_كامل_شرعية_في(الدالة, خانات_القيم, الكتلة, الموضع);
                    إذا (الخانة > 0) { متتبعة[الخانة - 1] := صواب; };
                };
            };
        };
        م := م + 1;
    }
    دع الناتج: متغير متجه طبيعي = [];
    دع التالي: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < عدد_الخانات) {
        إذا (متتبعة[ف]) { التالي := التالي + 1; ألحق(الناتج, التالي); } وإلا { ألحق(الناتج, 0); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The tracked local a declaration at instruction الموضع of block الكتلة
// names, plus one.
عرف خانة_ملكية_عند_شرعية(
    الدالة: &دالة_مسير,
    خانات_القيم: &متجه طبيعي,
    الكتلة: طبيعي,
    الموضع: طبيعي
): طبيعي {
    طابق (*الدالة).الكتل[الكتلة].التعليمات[الموضع].العملية مع
    | عملية_مسير.ملكية_مكان(الملكية) -> {
        دع المكان: طبيعي = الملكية.المكان.القيمة مثل طبيعي;
        إذا (المكان >= (الطول(*خانات_القيم) مثل طبيعي)) { أرجع 0; };
        أرجع (*خانات_القيم)[المكان];
    }
    | _ -> { أرجع 0; };
}

// The ownership legality analysis of the whole program: for each source
// function lowering checks (a function declared without Type parameters,
// with its closures and compile-time blocks), its first rejected use, in the
// order of the functions. The uses lowering recorded are cleared.
عام عرف حلل_شرعية_ملكية_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع
): متجه خطأ_ملكية_دالة_مسير {
    دع الناتج: متجه خطأ_ملكية_دالة_مسير = حلل_شرعية_دوال_من_مسير(&(*البرنامج), الأنواع, 0);
    دع بلا_استخدامات: متجه متجه استخدام_مصدري_مسير = [];
    (*البرنامج).مصادر_الاستخدامات := بلا_استخدامات;
    دع بلا_دوال: متجه أصل_دالة_مصدرية_مسير = [];
    (*البرنامج).دوال_المصدر := بلا_دوال;
    دع بلا_أحداث: متجه متجه حدث_استعارة_مسير = [];
    (*البرنامج).أحداث_الاستعارة := بلا_أحداث;
    أرجع الناتج;
}

// The first rejected use of each source function from FunctionID البداية
// on, with the closures and compile-time blocks among them; the facts
// lowering recorded stay (template_legality.sn analyzes one template at a
// time).
عام عرف حلل_شرعية_دوال_من_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    البداية: طبيعي
): متجه خطأ_ملكية_دالة_مسير {
    دع النقول: متغير نقول_أسماء_مسير = نقول_أسماء_مسير_جديدة(خطأ);
    أرجع حلل_شرعية_دوال_مع_النقول_من_مسير(البرنامج, الأنواع, البداية, &متغير النقول);
}

// What tooling gathers, when يجمع: the moved names of the analyzed functions,
// and the source functions the analysis-only lowering left out (a function a
// partial program cannot lower, a generic template it cannot lower): the
// analysis checked nothing of theirs, so no error and no moved name of
// theirs is known.
عام نوع نقول_أسماء_مسير = {
    يجمع: منطقي,
    النقول: متجه نطاق,
    المتروكة: متجه معرف_رمز
};

عام عرف نقول_أسماء_مسير_جديدة(يجمع: منطقي): نقول_أسماء_مسير {
    دع الناتج: نقول_أسماء_مسير = { يجمع: يجمع, النقول: [], المتروكة: [] };
    أرجع الناتج;
}

// Records that source function الرمز was left out of the analysis.
عام عرف سجل_دالة_متروكة_مسير(النقول: &متغير نقول_أسماء_مسير, الرمز: معرف_رمز): فراغ {
    إذا (!(*النقول).يجمع) { أرجع; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النقول).المتروكة) مثل طبيعي)) {
        إذا ((*النقول).المتروكة[ف].القيمة == الرمز.القيمة) { أرجع; };
        ف := ف + 1;
    }
    ألحق((*النقول).المتروكة, الرمز);
}

عام عرف حلل_شرعية_دوال_مع_النقول_من_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    البداية: طبيعي,
    النقول: &متغير نقول_أسماء_مسير
): متجه خطأ_ملكية_دالة_مسير {
    دع العدد: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع الحالة: متغير حالة_شرعية_برنامج = {
        الحالات: [],
        الأخطاء: [],
        الآباء: [],
        يجمع_النقول: (*النقول).يجمع,
        النقول: []
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الحالة.الحالات, 0);
        ألحق(الحالة.الأخطاء, اختياري.لا_شيء());
        دع الأم: متغير طبيعي = 0;
        إذا (ف < (الطول((*البرنامج).دوال_المصدر) مثل طبيعي)) {
            إذا ((*البرنامج).دوال_المصدر[ف].الأم != بلا_ط32_شرعية()) {
                الأم := ((*البرنامج).دوال_المصدر[ف].الأم مثل طبيعي) + 1;
            };
        };
        ألحق(الحالة.الآباء, الأم);
        ف := ف + 1;
    }
    دع الناتج: متغير متجه خطأ_ملكية_دالة_مسير = [];
    ف := البداية;
    طالما (ف < العدد && ف < (الطول((*البرنامج).دوال_المصدر) مثل طبيعي)) {
        دع الرمز: ط32 = (*البرنامج).دوال_المصدر[ف].الرمز;
        إذا (الرمز != بلا_ط32_شرعية()) {
            طابق حلل_دالة_شرعية(&(*البرنامج), الأنواع, ف, &متغير الحالة) مع
            | اختياري.موجود(الخطأ) -> {
                دع الموجود: خطأ_ملكية_دالة_مسير = {
                    الرمز: معرف_رمز_من(الرمز مثل طبيعي),
                    الخطأ: الخطأ
                };
                ألحق(الناتج, الموجود);
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(الحالة.النقول) مثل طبيعي)) {
        ألحق((*النقول).النقول, الحالة.النقول[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
