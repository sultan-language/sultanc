// The ownership legality of generic templates
// (docs/en/internals/ownership-analysis.md, "Generic templates"). A template
// is checked before substitution: an instance with a plain Type argument
// accepts what the template rejects, and a template nobody instantiates is
// checked too. Each template is lowered once more for analysis only, with
// every Type parameter as itself (an owning Type, ownership_glue.sn, unless
// a plain bound says otherwise), every call to a generic function with a
// Type parameter among its arguments bound to a declaration without a body,
// analyzed (ownership_legality.sn) and discarded: nothing of it reaches the
// program that is elaborated, verified and executed. A template whose first
// error copies a value of exactly one of its Type parameters out of borrowed
// storage infers a plain bound on that parameter instead, and is lowered and
// analyzed again with the parameter plain. Inferred bounds then propagate from
// a generic callee to the caller's Type parameter it is instantiated with,
// and every call that instantiates a plain-bound parameter with an owning
// Type is rejected.

// What the analysis of the templates found: the first error of each rejected
// template, and the rejected calls of plain-bound Type parameters.
عام نوع ناتج_شرعية_قوالب_مسير = {
    الأخطاء: متجه خطأ_ملكية_دالة_مسير,
    القيود: متجه خطأ_تدفق_سلامة
};

عام عرف ناتج_شرعية_قوالب_مسير_فارغ(): ناتج_شرعية_قوالب_مسير {
    دع الناتج: ناتج_شرعية_قوالب_مسير = { الأخطاء: [], القيود: [] };
    أرجع الناتج;
}

// The sizes of the program's tables before the templates were lowered.
نوع أحجام_برنامج_قوالب = {
    الدوال: طبيعي,
    الخارجية: طبيعي,
    العوام: طبيعي,
    الفحوص: طبيعي,
    البيئات: طبيعي,
    المنصة: طبيعي,
    سي: طبيعي,
    الاستخدامات: طبيعي,
    المصادر: طبيعي,
    الأحداث: طبيعي
};

عرف أحجام_برنامج_قوالب_عند(البرنامج: &برنامج_مسير): أحجام_برنامج_قوالب {
    دع الأحجام: أحجام_برنامج_قوالب = {
        الدوال: الطول((*البرنامج).الدوال) مثل طبيعي,
        الخارجية: الطول((*البرنامج).الدوال_الخارجية) مثل طبيعي,
        العوام: الطول((*البرنامج).العوام) مثل طبيعي,
        الفحوص: الطول((*البرنامج).مواقع_فحوص_التشغيل) مثل طبيعي,
        البيئات: الطول((*البرنامج).البيئات_الساكنة) مثل طبيعي,
        المنصة: الطول((*البرنامج).دوال_اتفاقية_المنصة) مثل طبيعي,
        سي: الطول((*البرنامج).دوال_اتفاقية_سي) مثل طبيعي,
        الاستخدامات: الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي,
        المصادر: الطول((*البرنامج).دوال_المصدر) مثل طبيعي,
        الأحداث: الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي
    };
    أرجع الأحجام;
}

عرف أعد_برنامج_قوالب(البرنامج: &متغير برنامج_مسير, الأحجام: &أحجام_برنامج_قوالب): فراغ {
    اقتطع((*البرنامج).الدوال, (*الأحجام).الدوال);
    اقتطع((*البرنامج).الدوال_الخارجية, (*الأحجام).الخارجية);
    اقتطع((*البرنامج).العوام, (*الأحجام).العوام);
    اقتطع((*البرنامج).مواقع_فحوص_التشغيل, (*الأحجام).الفحوص);
    اقتطع((*البرنامج).البيئات_الساكنة, (*الأحجام).البيئات);
    اقتطع((*البرنامج).دوال_اتفاقية_المنصة, (*الأحجام).المنصة);
    اقتطع((*البرنامج).دوال_اتفاقية_سي, (*الأحجام).سي);
    اقتطع((*البرنامج).مصادر_الاستخدامات, (*الأحجام).الاستخدامات);
    اقتطع((*البرنامج).دوال_المصدر, (*الأحجام).المصادر);
    اقتطع((*البرنامج).أحداث_الاستعارة, (*الأحجام).الأحداث);
}

// The analyzed functions of one template give back their storage.
عرف أفرغ_دوال_قالب(البرنامج: &متغير برنامج_مسير, البداية: طبيعي): فراغ {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع بلا_كتل: متجه كتلة_مسير = [];
        (*البرنامج).الدوال[ف].الكتل := بلا_كتل;
        دع بلا_قيم: متجه قيمة_مسير = [];
        (*البرنامج).الدوال[ف].القيم := بلا_قيم;
        إذا (ف < (الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي)) {
            دع بلا_استخدامات: متجه استخدام_مصدري_مسير = [];
            (*البرنامج).مصادر_الاستخدامات[ف] := بلا_استخدامات;
        };
        إذا (ف < (الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي)) {
            دع بلا_أحداث: متجه حدث_استعارة_مسير = [];
            (*البرنامج).أحداث_الاستعارة[ف] := بلا_أحداث;
        };
        إذا (ف < (الطول((*البرنامج).دوال_المصدر) مثل طبيعي)) {
            (*البرنامج).دوال_المصدر[ف].الرمز := 0xFFFFFFFF;
        };
        ف := ف + 1;
    }
}

// Every call of the template to a generic function with a Type parameter
// among its Type arguments is bound to a declaration of that function with
// those arguments, without a body.
عرف أعلن_مستدعيات_قالب(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سياق_التعبيرات: &سياق_أنواع_تعبيرات,
    مواضع_الاستدعاءات: &متجه طبيعي,
    دوال_الخفض: &متغير سياق_دوال_خفض
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*مواضع_الاستدعاءات) مثل طبيعي)) {
        دع الموضع: طبيعي = (*مواضع_الاستدعاءات)[ف];
        إذا (الموضع < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل طبيعي)) {
            دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*سياق_التعبيرات).الاستدعاءات[الموضع];
            طابق (*مرجع_الحقيقة).الرمز مع
            | اختياري.موجود(الرمز) -> {
                إذا (الطول((*مرجع_الحقيقة).استبدالات_النوع) > 0) {
                    طابق موضع_دالة_خفض(دوال_الخفض, الرمز, &(*مرجع_الحقيقة).استبدالات_النوع) مع
                    | اختياري.موجود(_) -> { }
                    | اختياري.لا_شيء -> {
                        طابق مقبض_تصريح_عند(فهرس_التصريحات, الرمز) مع
                        | اختياري.لا_شيء -> { أرجع خطأ; }
                        | اختياري.موجود(المقبض) -> {
                            إذا (المقبض.موضع_الوحدة >= (الطول(*الوحدات) مثل طبيعي)
                                || المقبض.موضع_الوحدة >= (الطول(*روابط_الأسماء) مثل طبيعي)) {
                                أرجع خطأ;
                            };
                            دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                            إذا (المقبض.موضع_العنصر >= (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
                                أرجع خطأ;
                            };
                            دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[(*مرجع_الوحدة).معرف_المصدر];
                            طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                            | عنصر_وحدة.دالة(المستدعاة) -> {
                                طابق أعلن_دالة_للخفض(
                                    البرنامج, التصحيح, الأصول, مرجع_المصدر, &المستدعاة,
                                    الأنواع, أنواع_الرموز, &(*روابط_الأسماء)[المقبض.موضع_الوحدة],
                                    &(*مرجع_الحقيقة).استبدالات_النوع, دوال_الخفض
                                ) مع
                                | اختياري.موجود(_) -> { أرجع خطأ; }
                                | اختياري.لا_شيء -> { };
                            }
                            | _ -> { أرجع خطأ; };
                        };
                    };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The generic Type parameter whose value a rejected move copies out of
// borrowed storage, if the moved value has exactly that parameter Type and the
// parameter is not yet bound plain.
عرف معامل_نوع_منقول_من_مرجع_قالب(
    الخطأ: &خطأ_تدفق_سلامة,
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات
): اختياري معرف_نوع {
    طابق *الخطأ مع
    | خطأ_تدفق_سلامة.نقل_من_مرجع(السياق) -> {
        دع النوع: متغير اختياري معرف_نوع = نوع_تعبير_عند(أنواع_التعبيرات, السياق.الموضع);
        طابق السياق.الرمز مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.موجود(نوع_الرمز) -> { النوع := اختياري.موجود(نوع_الرمز); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق النوع مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المعرف) -> {
            طابق رمز_معامل_نوع_عند(الأنواع, المعرف) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(_) -> {
                طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, المعرف) مع
                | اختياري.موجود(الحقائق) -> {
                    إذا (الحقائق.يتطلب_تحريرا) { أرجع اختياري.موجود(المعرف); };
                }
                | اختياري.لا_شيء -> { };
                أرجع اختياري.لا_شيء();
            };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف معامل_نوع_مقيد_عاديا_قالب(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    المعامل: معرف_رمز
): منطقي {
    طابق نوع_معامل_مسجل_عند(الأنواع, المعامل) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(نوع_المعامل) -> {
        طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, نوع_المعامل) مع
        | اختياري.موجود(الحقائق) -> { أرجع !الحقائق.يتطلب_تحريرا; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

// Gives a Type parameter its inferred plain bound: its Memory facts, and
// lowering's ownership class of it (a Type built from it keeps its class, as
// its Memory facts do).
عرف قيد_معامل_عاديا_قالب(
    سياق_الذاكرة: &متغير سياق_ذاكرة_وحدة,
    الأنواع: &متغير سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    إذا (!قيد_معامل_نوع_عاديا(سياق_الذاكرة, النوع)) { أرجع خطأ; };
    ضع_تصنيف_ملكية_مسير(الأنواع, النوع, 1);
    أرجع صواب;
}

// Inferred plain bounds propagate from a generic callee to the caller's Type
// parameter it is instantiated with. Returns whether a bound was added.
عرف انشر_قيود_عادية_قوالب(
    سياق_الذاكرة: &متغير سياق_ذاكرة_وحدة,
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات
): منطقي {
    دع أضيف: متغير منطقي = خطأ;
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الوحدة).الاستدعاءات) مثل طبيعي)) {
            دع الاستدعاء: &حقيقة_استدعاء_نوعية = &(*الوحدة).الاستدعاءات[ك];
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول((*الاستدعاء).استبدالات_النوع) مثل طبيعي)) {
                دع المعامل: معرف_رمز = (*الاستدعاء).استبدالات_النوع[ي].المعامل;
                دع الحجة: معرف_نوع = (*الاستدعاء).استبدالات_النوع[ي].الحجة;
                إذا (معامل_نوع_مقيد_عاديا_قالب(سياق_الذاكرة, الأنواع, المعامل)) {
                    طابق رمز_معامل_نوع_عند(الأنواع, الحجة) مع
                    | اختياري.موجود(_) -> {
                        إذا (قيد_معامل_عاديا_قالب(سياق_الذاكرة, الأنواع, الحجة)) { أضيف := صواب; };
                    }
                    | اختياري.لا_شيء -> { };
                };
                ي := ي + 1;
            }
            ك := ك + 1;
        }
        و := و + 1;
    }
    أرجع أضيف;
}

// Every call that instantiates a plain-bound Type parameter with an owning Type
// would copy owned storage out of a reference inside the callee.
عرف تحقق_قيود_عادية_قوالب(
    سياق_الذاكرة: &سياق_ذاكرة_وحدة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    الأخطاء: &متغير متجه خطأ_تدفق_سلامة
): فراغ {
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الوحدة).الاستدعاءات) مثل طبيعي)) {
            دع الاستدعاء: &حقيقة_استدعاء_نوعية = &(*الوحدة).الاستدعاءات[ك];
            دع ي: متغير طبيعي = 0;
            دع مرفوض: متغير منطقي = خطأ;
            طالما ((ي < (الطول((*الاستدعاء).استبدالات_النوع) مثل طبيعي)) && !مرفوض) {
                دع المعامل: معرف_رمز = (*الاستدعاء).استبدالات_النوع[ي].المعامل;
                دع الحجة: معرف_نوع = (*الاستدعاء).استبدالات_النوع[ي].الحجة;
                إذا (معامل_نوع_مقيد_عاديا_قالب(سياق_الذاكرة, الأنواع, المعامل)) {
                    طابق حقائق_ذاكرة_نوع_عند(سياق_الذاكرة, الحجة) مع
                    | اختياري.موجود(الحقائق) -> {
                        إذا (الحقائق.يتطلب_تحريرا) {
                            دع السياق: سياق_قيد_عادي_منتهك = {
                                الموضع: (*الاستدعاء).النطاق,
                                الدالة: (*الاستدعاء).الرمز,
                                المعامل: المعامل,
                                الحجة: الحجة
                            };
                            ألحق(*الأخطاء, خطأ_تدفق_سلامة.قيد_عادي_منتهك(السياق));
                            مرفوض := صواب;
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
                ي := ي + 1;
            }
            ك := ك + 1;
        }
        و := و + 1;
    }
}

// One template: declared (again, for a later attempt) into a function of its
// own, its generic callees bound, its body lowered and analyzed. Nothing when
// it cannot be lowered or it is accepted; else its first error.
عرف حلل_قالب_مرة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    الدالة: &تصريح_دالة,
    الرمز: معرف_رمز,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الوحدة: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &متغير سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النقول: &متغير نقول_أسماء_مسير
): اختياري خطأ_تدفق_سلامة {
    دع بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    دع البداية: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    طابق موضع_دالة_خفض(دوال_الخفض, الرمز, &بلا_استبدالات) مع
    | اختياري.لا_شيء -> {
        طابق أعلن_دالة_للخفض(
            البرنامج, التصحيح, الأصول, المصدر, الدالة, الأنواع, أنواع_الرموز,
            روابط_الوحدة, &بلا_استبدالات, دوال_الخفض
        ) مع
        | اختياري.موجود(_) -> { سجل_دالة_متروكة_مسير(النقول, الرمز); أرجع اختياري.لا_شيء(); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.موجود(موضع_الربط) -> {
        // A later attempt lowers into a new function the binding names.
        دع المؤقت: متغير سياق_دوال_خفض = سياق_دوال_خفض_جديد();
        طابق أعلن_دالة_للخفض(
            البرنامج, التصحيح, الأصول, المصدر, الدالة, الأنواع, أنواع_الرموز,
            روابط_الوحدة, &بلا_استبدالات, &متغير المؤقت
        ) مع
        | اختياري.موجود(_) -> { سجل_دالة_متروكة_مسير(النقول, الرمز); أرجع اختياري.لا_شيء(); }
        | اختياري.لا_شيء -> { };
        دع الهدف: هدف_دالة_خفض = هدف_دالة_خفض.داخلية(معرف_دالة_مسير_من(البداية));
        (*دوال_الخفض).الدوال[موضع_الربط].الهدف := الهدف;
    };
    إذا ((الطول((*البرنامج).الدوال) مثل طبيعي) != البداية + 1) {
        سجل_دالة_متروكة_مسير(النقول, الرمز);
        أرجع اختياري.لا_شيء();
    };
    دع أنواع_رموز_فارغة: متجه ربط_نوع_رمز_خفض = [];
    طابق اخفض_جسم_دالة_إلى_مسير(
        البرنامج, التصحيح, الأصول, المصدر, الدالة, الأنواع, أنواع_الرموز, أنواع_رموز_فارغة,
        أنواع_التعبيرات, روابط_الوحدة, &بلا_استبدالات, سجل_الأنماط, تحققات_الأنماط,
        دوال_الخفض, هويات_البدائيات
    ) مع
    | اختياري.موجود(_) -> {
        أفرغ_دوال_قالب(البرنامج, البداية);
        سجل_دالة_متروكة_مسير(النقول, الرمز);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { };
    سجل_أصل_دالة_مصدرية_خفض(
        البرنامج, معرف_دالة_مسير_من(البداية), اختياري.موجود(الرمز), اختياري.لا_شيء()
    );
    دع الأخطاء: متجه خطأ_ملكية_دالة_مسير = حلل_شرعية_دوال_مع_النقول_من_مسير(
        &(*البرنامج), الأنواع, البداية, النقول
    );
    أفرغ_دوال_قالب(البرنامج, البداية);
    إذا ((الطول(الأخطاء) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأخطاء[0].الخطأ);
}

// Analyzes every generic template of the modules (in their order) and the
// plain bounds of every call, then leaves the program as it was before.
عام عرف حلل_قوالب_دوال_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &متغير سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    فهرس_حقائق_الدوال: &فهرس_حقائق_دوال_خفض,
    // Tooling's moved names, when it gathers them.
    النقول: &متغير نقول_أسماء_مسير
): ناتج_شرعية_قوالب_مسير {
    دع الناتج: متغير ناتج_شرعية_قوالب_مسير = ناتج_شرعية_قوالب_مسير_فارغ();
    دع الأحجام: أحجام_برنامج_قوالب = أحجام_برنامج_قوالب_عند(&(*البرنامج));
    دع عدد_الأنواع: طبيعي = عدد_الأنواع_المسجلة(الأنواع);
    // The analysis-only lowering keeps its debug data and source origins to
    // itself: they only group each statement's instructions.
    دع التصحيح: متغير بيانات_تصحيح_مسير = بيانات_تصحيح_مسير_جديدة();
    دع الأصول: متغير سجل_أصول_مصدر = سجل_أصول_مصدر_جديد();
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*روابط_الأسماء) مثل طبيعي)
        && و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[(*مرجع_الوحدة).معرف_المصدر];
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ع] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                دع له_جسم: متغير منطقي = خطأ;
                طابق الدالة.الجسم مع
                | اختياري.موجود(_) -> { له_جسم := صواب; }
                | اختياري.لا_شيء -> { };
                إذا (الطول(الدالة.معاملات_النوع) > 0 && له_جسم) {
                    طابق رمز_اسم_محلول_عند(روابط_الوحدة, الدالة.الاسم.النطاق) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(الرمز) -> {
                        طابق عرض_حقائق_دالة_خفض_عند(فهرس_حقائق_الدوال, الرمز) مع
                        | اختياري.لا_شيء -> { سجل_دالة_متروكة_مسير(النقول, الرمز); }
                        | اختياري.موجود(العرض) -> {
                            إذا (!أعلن_مستدعيات_قالب(
                                البرنامج, &متغير التصحيح, &متغير الأصول, الوحدات, فهرس_التصريحات,
                                خريطة_المصادر, الأنواع, أنواع_الرموز, روابط_الأسماء,
                                أنواع_تعبيرات_الوحدة, &العرض.مواضع_الاستدعاءات, دوال_الخفض
                            )) {
                                سجل_دالة_متروكة_مسير(النقول, الرمز);
                            } وإلا {
                                دع يعاد: متغير منطقي = صواب;
                                طالما (يعاد) {
                                    يعاد := خطأ;
                                    طابق حلل_قالب_مرة_للخفض(
                                        البرنامج, &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &الدالة,
                                        الرمز, الأنواع, أنواع_الرموز, أنواع_تعبيرات_الوحدة, روابط_الوحدة,
                                        سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات, النقول
                                    ) مع
                                    | اختياري.لا_شيء -> { }
                                    | اختياري.موجود(الخطأ) -> {
                                        طابق معامل_نوع_منقول_من_مرجع_قالب(
                                            &الخطأ, &(*دوال_الخفض).الذاكرة, الأنواع, أنواع_الرموز,
                                            أنواع_تعبيرات_الوحدة
                                        ) مع
                                        | اختياري.موجود(نوع_المعامل) -> {
                                            يعاد := قيد_معامل_عاديا_قالب(
                                                &متغير (*دوال_الخفض).الذاكرة, الأنواع, نوع_المعامل
                                            );
                                        }
                                        | اختياري.لا_شيء -> { };
                                        إذا (!يعاد) {
                                            دع المرفوض: خطأ_ملكية_دالة_مسير = { الرمز: الرمز, الخطأ: الخطأ };
                                            ألحق(الناتج.الأخطاء, المرفوض);
                                        };
                                    };
                                }
                            };
                        };
                    };
                };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
    أعد_برنامج_قوالب(البرنامج, &الأحجام);
    أعد_سجل_أنواع_إلى_عدد(الأنواع, عدد_الأنواع);
    طالما (انشر_قيود_عادية_قوالب(&متغير (*دوال_الخفض).الذاكرة, الأنواع, أنواع_التعبيرات)) { }
    تحقق_قيود_عادية_قوالب(&(*دوال_الخفض).الذاكرة, الأنواع, أنواع_التعبيرات, &متغير الناتج.القيود);
    أرجع الناتج;
}
