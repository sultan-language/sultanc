استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.drop_elaboration;
استورد compiler.msir.ssf.borrow_flow;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;

// Where each borrow ends (docs/en/internals/ownership-analysis.md,
// "Borrow regions"). A borrow is held by a local (a holder: a local an
// assignment gives a borrow-carrying value, or a borrowed view) and lasts
// while that holder is live: from where the borrow starts to the last use
// of the holder on every path that follows. The analysis computes that
// liveness on initial MSIR, before the legality walk, and adds to the
// borrow events (borrow_flow.sn) one that ends a holder's borrows where it
// dies. The source's scopes play no part.
//
// The uses of a holder are the MSIR uses of its place and of everything
// derived from it: every instruction (and terminator) that reads a value
// computed from a load, a reference or a projection of the place, the
// results of those instructions in turn, and a temporary lowering stores
// such a value into once. A value that reaches a join (a block parameter, a
// temporary stored more than once: what a `return` passes to the exit
// block) is followed only to the locals it is stored into; the edge or store
// that takes it there is the holder's last use on its path. A derived value stored into another
// local carries the borrow on when that local holds borrows or its Type
// may hold a reference: the uses of that local are uses of the holder too
// (a copy, a reborrow, a value a call returns from its argument). So are
// the uses of a local that reads through the holder (a reborrow `&*r`, a
// member of `*r`, a borrowed view behind `r`): the borrow `r` holds must
// stay while what reads through it is alive. A store of a whole value into
// the holder's place, and its declaration, end its liveness; a destruction
// of the holder (an owner's `إسقاط`) is a use, and its borrows end right
// after it, so a holder that owns storage (a vector of references, a
// record with a reference and an owning member) keeps its borrows until it
// is destroyed or moved.
//
// The liveness is a backward fixed point of the shared dataflow
// (drop_elaboration.sn, احسب_حالات_شبكة_على_خلفاء_مسير, lattice
// شبكة_تهيئة_مسير.حياة) over the predecessor graph, so loops are followed to
// their fixed point: a reference read in the next iteration is live across
// the back edge. A holder's borrows end:
//   right after its last use where it is not live afterwards;
//   where a block is entered on which it is not live, though a
//   predecessor reaches it live (it is used on another successor);
//   right after an event that gives it borrows where it is not live (a
//   borrow nothing uses);
//   right after its destruction.

// The facts of one function the liveness reads.
نوع حياة_دالة_استعارة = {
    عدد_الكتل: طبيعي,
    // Per value: the instructions that read it, as block * 2^32 + position
    // (the block's number of instructions for its terminator).
    المستخدمون: متجه متجه طبيعي,
    // Per value: the Symbol of the source local whose place it defines plus
    // one (0 for none), and whether it is a place lowering made for itself.
    رموز_الأماكن: متجه طبيعي,
    المؤقتة: متجه منطقي,
    // Per value: the place a projection is made from (plus one).
    أصول_الإسقاطات: متجه طبيعي,
    // Per value: the number of stores into it as a whole (a temporary
    // stored more than once joins values).
    مخازن_المؤقتة: متجه طبيعي,
    // The Types asked about (قد_يحمل_مرجعا_حياة): pairs TypeID, 1 holds
    // no reference or 2 may.
    الأنواع_المسؤولة: متجه طبيعي
};

عرف رقم_موضع_حياة(الكتلة: طبيعي, الموضع: طبيعي): طبيعي {
    أرجع (الكتلة * 4294967296) + الموضع;
}

// The values each instruction and terminator reads, and the places of the
// function.
عرف ابن_حياة_دالة_استعارة(الدالة: &دالة_مسير): حياة_دالة_استعارة {
    ليكن عدد_القيم: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    ليكن المستخدمون: متغير متجه متجه طبيعي = [];
    ليكن رموز_الأماكن: متغير متجه طبيعي = [];
    ليكن المؤقتة: متغير متجه منطقي = [];
    ليكن أصول_الإسقاطات: متغير متجه طبيعي = [];
    ليكن مخازن_المؤقتة: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) {
        ليكن فارغة: متجه طبيعي = [];
        ألحق(المستخدمون, فارغة);
        ألحق(رموز_الأماكن, 0);
        ألحق(المؤقتة, خطأ);
        ألحق(أصول_الإسقاطات, 0);
        ألحق(مخازن_المؤقتة, 0);
        ف := ف + 1;
    }
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ليكن العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < العدد) {
            ليكن التعليمة: &تعليمة_مسير = &(*الدالة).الكتل[ك].التعليمات[ت];
            ليكن المعاملات: متغير متجه طبيعي = [];
            ألحق_معاملات_عملية_مسير(&(*التعليمة).العملية, &متغير المعاملات);
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(المعاملات) مثل طبيعي)) {
                إذا (المعاملات[م] < عدد_القيم) { ألحق(المستخدمون[المعاملات[م]], رقم_موضع_حياة(ك, ت)); };
                م := م + 1;
            }
            طابق (*التعليمة).العملية مع
            | عملية_مسير.تخزين(التخزين) -> {
                ليكن المخزن_فيه: طبيعي = التخزين.المكان.القيمة مثل طبيعي;
                إذا (المخزن_فيه < عدد_القيم) { مخازن_المؤقتة[المخزن_فيه] := مخازن_المؤقتة[المخزن_فيه] + 1; };
            }
            | _ -> { };
            طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
            | اختياري.موجود(الناتج) -> {
                إذا (الناتج < عدد_القيم) {
                    طابق (*التعليمة).العملية مع
                    | عملية_مسير.مكان_محلي(المكان) -> {
                        طابق المكان.المحلي مع
                        | اختياري.موجود(الرمز) -> { رموز_الأماكن[الناتج] := (الرمز.القيمة مثل طبيعي) + 1; }
                        | اختياري.لا_شيء -> { المؤقتة[الناتج] := صواب; };
                    }
                    | عملية_مسير.مكان_حقل(الحقل) -> { أصول_الإسقاطات[الناتج] := (الحقل.الأصل.القيمة مثل طبيعي) + 1; }
                    | عملية_مسير.مكان_فهرس(الفهرس) -> { أصول_الإسقاطات[الناتج] := (الفهرس.الأصل.القيمة مثل طبيعي) + 1; }
                    | _ -> { };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ليكن المقروءة: متغير متجه طبيعي = [];
        ألحق_مقروءات_منهي_حياة(&(*الدالة).الكتل[ك].المنهي, &متغير المقروءة);
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < (الطول(المقروءة) مثل طبيعي)) {
            إذا (المقروءة[ن] < عدد_القيم) { ألحق(المستخدمون[المقروءة[ن]], رقم_موضع_حياة(ك, العدد)); };
            ن := ن + 1;
        }
        ك := ك + 1;
    }
    ليكن الناتج: حياة_دالة_استعارة = {
        عدد_الكتل: عدد_الكتل,
        المستخدمون: المستخدمون,
        رموز_الأماكن: رموز_الأماكن,
        المؤقتة: المؤقتة,
        أصول_الإسقاطات: أصول_الإسقاطات,
        مخازن_المؤقتة: مخازن_المؤقتة,
        الأنواع_المسؤولة: []
    };
    أرجع الناتج;
}

// The values a terminator reads: its condition or discriminant, its
// returned value, the arguments of its edges.
عرف ألحق_مقروءات_منهي_حياة(المنهي: &اختياري منهي_مسير, الناتج: &متغير متجه طبيعي): فراغ {
    طابق *المنهي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المنهي_الفعلي) -> {
        طابق المنهي_الفعلي مع
        | منهي_مسير.فرع(الحافة) -> { ألحق_حجج_حافة_حياة(&الحافة, الناتج); }
        | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
            ألحق(*الناتج, الشرط.القيمة مثل طبيعي);
            ألحق_حجج_حافة_حياة(&عند_الصواب, الناتج);
            ألحق_حجج_حافة_حياة(&عند_الخطأ, الناتج);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق(*الناتج, الفرع.المميز.القيمة مثل طبيعي);
            ألحق_حجج_حافة_حياة(&الفرع.الافتراضي, الناتج);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_حجج_حافة_حياة(&الفرع.الحالات[ف].الحافة, الناتج);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(القيمة) -> {
            طابق القيمة مع
            | اختياري.موجود(المعرف) -> { ألحق(*الناتج, المعرف.القيمة مثل طبيعي); }
            | اختياري.لا_شيء -> { };
        }
        | منهي_مسير.فخ -> { };
    };
}

عرف ألحق_حجج_حافة_حياة(الحافة: &حافة_مسير, الناتج: &متغير متجه طبيعي): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
        ألحق(*الناتج, (*الحافة).الحجج[ف].القيمة مثل طبيعي);
        ف := ف + 1;
    }
}

// The block parameters an edge of a terminator passes القيمة to.
عرف ألحق_معاملات_مستلمة_حياة(
    الدالة: &دالة_مسير,
    المنهي: &اختياري منهي_مسير,
    القيمة: طبيعي,
    الناتج: &متغير متجه طبيعي
): فراغ {
    طابق *المنهي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المنهي_الفعلي) -> {
        طابق المنهي_الفعلي مع
        | منهي_مسير.فرع(الحافة) -> { ألحق_مستلمات_حافة_حياة(الدالة, &الحافة, القيمة, الناتج); }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            ألحق_مستلمات_حافة_حياة(الدالة, &عند_الصواب, القيمة, الناتج);
            ألحق_مستلمات_حافة_حياة(الدالة, &عند_الخطأ, القيمة, الناتج);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق_مستلمات_حافة_حياة(الدالة, &الفرع.الافتراضي, القيمة, الناتج);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_مستلمات_حافة_حياة(الدالة, &الفرع.الحالات[ف].الحافة, القيمة, الناتج);
                ف := ف + 1;
            }
        }
        | _ -> { };
    };
}

عرف ألحق_مستلمات_حافة_حياة(
    الدالة: &دالة_مسير,
    الحافة: &حافة_مسير,
    القيمة: طبيعي,
    الناتج: &متغير متجه طبيعي
): فراغ {
    ليكن الهدف: طبيعي = (*الحافة).الهدف.القيمة مثل طبيعي;
    إذا (الهدف >= (الطول((*الدالة).الكتل) مثل طبيعي)) { أرجع; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
        إذا (((*الحافة).الحجج[ف].القيمة مثل طبيعي) == القيمة
            && ف < (الطول((*الدالة).الكتل[الهدف].المعاملات) مثل طبيعي)) {
            ألحق(*الناتج, (*الدالة).الكتل[الهدف].المعاملات[ف].المعرف.القيمة مثل طبيعي);
        };
        ف := ف + 1;
    }
}

// The place a projected place is made from, to the first that is no
// projection.
عرف جذر_إسقاط_حياة(الحقائق: &حياة_دالة_استعارة, المكان: طبيعي): طبيعي {
    ليكن الحالي: متغير طبيعي = المكان;
    ليكن الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < (الطول((*الحقائق).أصول_الإسقاطات) مثل طبيعي)
        && الحالي < (الطول((*الحقائق).أصول_الإسقاطات) مثل طبيعي)
        && (*الحقائق).أصول_الإسقاطات[الحالي] > 0) {
        الحالي := (*الحقائق).أصول_الإسقاطات[الحالي] - 1;
        الخطوات := الخطوات + 1;
    }
    أرجع الحالي;
}

// Whether a value of Type النوع may hold a reference (a reference, a slice,
// a Type parameter, or a member, element or payload that may); a Type whose
// shape is unknown may. A Type met again on the way adds nothing.
عرف قد_يحمل_مرجعا_حياة(
    الحقائق: &متغير حياة_دالة_استعارة,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    ليكن المعرف: طبيعي = النوع.القيمة مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف + 1) < (الطول((*الحقائق).الأنواع_المسؤولة) مثل طبيعي)) {
        إذا ((*الحقائق).الأنواع_المسؤولة[ف] == المعرف) { أرجع (*الحقائق).الأنواع_المسؤولة[ف + 1] == 2; };
        ف := ف + 2;
    }
    ليكن الزائرة: متغير متجه طبيعي = [];
    ليكن الناتج: منطقي = قد_يحمل_مرجعا_مع_حياة(الأنواع, النوع, &متغير الزائرة);
    ألحق((*الحقائق).الأنواع_المسؤولة, المعرف);
    إذا (الناتج) { ألحق((*الحقائق).الأنواع_المسؤولة, 2); } وإلا { ألحق((*الحقائق).الأنواع_المسؤولة, 1); };
    أرجع الناتج;
}

عرف قد_يحمل_مرجعا_مع_حياة(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الزائرة: &متغير متجه طبيعي
): منطقي {
    ليكن المعرف: طبيعي = النوع.القيمة مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الزائرة) مثل طبيعي)) {
        إذا ((*الزائرة)[ف] == المعرف) { أرجع خطأ; };
        ف := ف + 1;
    }
    إذا ((الطول(*الزائرة) مثل طبيعي) >= 64) { أرجع صواب; };
    ألحق(*الزائرة, المعرف);
    ليكن الناتج: منطقي = شكل_قد_يحمل_مرجعا_حياة(الأنواع, النوع, الزائرة);
    اقتطع(*الزائرة, (الطول(*الزائرة) مثل طبيعي) - 1);
    أرجع الناتج;
}

عرف عضو_قد_يحمل_مرجعا_حياة(
    الأنواع: &سجل_أنواع,
    العضو: اختياري معرف_نوع,
    الزائرة: &متغير متجه طبيعي
): منطقي {
    طابق العضو مع
    | اختياري.موجود(النوع) -> { أرجع قد_يحمل_مرجعا_مع_حياة(الأنواع, النوع, الزائرة); }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

عرف شكل_قد_يحمل_مرجعا_حياة(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الزائرة: &متغير متجه طبيعي
): منطقي {
    ليكن الصنف: صنف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> { الصنف := الوصف.الصنف; }
    | اختياري.لا_شيء -> { أرجع صواب; };
    طابق الصنف مع
    | صنف_شكل_نوع_دلالي.مرجع -> { أرجع صواب; }
    | صنف_شكل_نوع_دلالي.شريحة -> { أرجع صواب; }
    | صنف_شكل_نوع_دلالي.معامل_نوع -> { أرجع صواب; }
    | صنف_شكل_نوع_دلالي.صندوق -> {
        أرجع عضو_قد_يحمل_مرجعا_حياة(الأنواع, نوع_حمولة_صندوق_دلالي(الأنواع, النوع), الزائرة);
    }
    | صنف_شكل_نوع_دلالي.متجه -> {
        أرجع عضو_قد_يحمل_مرجعا_حياة(الأنواع, نوع_عنصر_متجه_دلالي(الأنواع, النوع), الزائرة);
    }
    | صنف_شكل_نوع_دلالي.صف -> {
        ليكن العدد: طبيعي;
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع صواب; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            إذا (عضو_قد_يحمل_مرجعا_حياة(الأنواع, نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف), الزائرة)) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    }
    | صنف_شكل_نوع_دلالي.سجل -> {
        ليكن العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع صواب; };
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            إذا (عضو_قد_يحمل_مرجعا_حياة(الأنواع, نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف), الزائرة)) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    }
    | صنف_شكل_نوع_دلالي.تعداد -> { أرجع حمولة_قد_تحمل_مرجعا_حياة(الأنواع, النوع, الزائرة); }
    | صنف_شكل_نوع_دلالي.اختيار -> { أرجع حمولة_قد_تحمل_مرجعا_حياة(الأنواع, النوع, الزائرة); }
    | صنف_شكل_نوع_دلالي.نتيجة -> { أرجع حمولة_قد_تحمل_مرجعا_حياة(الأنواع, النوع, الزائرة); }
    // A text, a scalar, a raw pointer (it holds no origin), a function value
    // (a closure cannot capture a reference) and an opaque Type.
    | _ -> { أرجع خطأ; };
}

عرف حمولة_قد_تحمل_مرجعا_حياة(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الزائرة: &متغير متجه طبيعي
): منطقي {
    ليكن عدد_المنشئات: طبيعي;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(ع) -> { عدد_المنشئات := ع; }
    | اختياري.لا_شيء -> { أرجع صواب; };
    ليكن م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) {
        ليكن عدد_الحمولات: طبيعي;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, م) مع
        | اختياري.موجود(ع) -> { عدد_الحمولات := ع; }
        | اختياري.لا_شيء -> { أرجع صواب; };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            إذا (عضو_قد_يحمل_مرجعا_حياة(الأنواع, نوع_حمولة_منشئ_دلالي_عند(الأنواع, النوع, م, ح), الزائرة)) {
                أرجع صواب;
            };
            ح := ح + 1;
        }
        م := م + 1;
    }
    أرجع خطأ;
}

// The uses of the place المكان of a source local and of what is derived from
// it, as points ((block * 2^32 + position) * 8 + kinds: 1 a use, 2 the
// place is given a whole value or declared, 4 it is destroyed), and the
// places of the other source locals a derived value is stored into that
// carry the borrow on (الحاملة).
//
// A value that reaches a join (a block parameter, a temporary stored more
// than once: the value a `return` passes to the exit block, the result of a
// branch) is derived on the paths through that edge or store only, which a
// liveness over the whole graph cannot tell apart: its uses would keep the
// borrow alive on every path into the join (every other `return`). Such a
// value, and what is computed from it, is followed only to the source locals
// it is stored into, which carry the borrow on; its other uses are none of
// the holder's. The edge or the store that takes the value there is.
عرف نقاط_مكان_حياة(
    الدالة: &دالة_مسير,
    الحقائق: &متغير حياة_دالة_استعارة,
    الأنواع: &سجل_أنواع,
    المكان: طبيعي,
    حامل_مكان: &متجه منطقي,
    المشتقة: &متغير متجه ط8,
    النقاط: &متغير متجه طبيعي,
    الحاملة: &متغير متجه طبيعي
): فراغ {
    ليكن عدد_القيم: طبيعي = الطول((*الحقائق).المستخدمون) مثل طبيعي;
    إذا (المكان >= عدد_القيم) { أرجع; };
    // المشتقة is all 0 on entry and left so: 1 derived, 2 derived through a
    // join only.
    ليكن القائمة: متغير متجه طبيعي = [المكان];
    ليكن المزارة: متغير متجه طبيعي = [المكان];
    (*المشتقة)[المكان] := 1;
    ليكن الرأس: متغير طبيعي = 0;
    طالما (الرأس < (الطول(القائمة) مثل طبيعي)) {
        ليكن القيمة: طبيعي = القائمة[الرأس];
        الرأس := الرأس + 1;
        ليكن مباشرة: منطقي = (*المشتقة)[القيمة] == 1;
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الحقائق).المستخدمون[القيمة]) مثل طبيعي)) {
            ليكن الرقم: طبيعي = (*الحقائق).المستخدمون[القيمة][ع];
            ع := ع + 1;
            ليكن الكتلة: طبيعي = الرقم / 4294967296;
            ليكن الموضع: طبيعي = الرقم % 4294967296;
            ليكن الأصناف: متغير طبيعي = 1;
            // The values derived from this use, and whether through a join.
            ليكن المضافة: متغير متجه طبيعي = [];
            ليكن عبر_التقاء: متغير منطقي = !مباشرة;
            إذا (الموضع >= (الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي)) {
                // A terminator: the parameters its edges pass the value to.
                ألحق_معاملات_مستلمة_حياة(الدالة, &(*الدالة).الكتل[الكتلة].المنهي, القيمة, &متغير المضافة);
                عبر_التقاء := صواب;
            } وإلا {
                ليكن التعليمة: &تعليمة_مسير = &(*الدالة).الكتل[الكتلة].التعليمات[الموضع];
                طابق (*التعليمة).العملية مع
                | عملية_مسير.تخزين(التخزين) -> {
                    ليكن وجهة: طبيعي = التخزين.المكان.القيمة مثل طبيعي;
                    ليكن مخزنة: طبيعي = التخزين.القيمة.القيمة مثل طبيعي;
                    الأصناف := 0;
                    إذا (وجهة == المكان && وجهة == القيمة) { الأصناف := 2; };
                    إذا (وجهة == القيمة && وجهة != المكان) { الأصناف := 1; };
                    إذا (مخزنة == القيمة) {
                        إذا ((الأصناف % 2) == 0) { الأصناف := الأصناف + 1; };
                        // Where the value goes: a temporary is followed as part
                        // of the value; another source local carries it on.
                        ليكن الجذر: طبيعي = جذر_إسقاط_حياة(&(*الحقائق), وجهة);
                        إذا (الجذر < عدد_القيم && الجذر != المكان) {
                            إذا ((*الحقائق).المؤقتة[الجذر]) {
                                ألحق(المضافة, الجذر);
                                إذا ((*الحقائق).مخازن_المؤقتة[الجذر] != 1) { عبر_التقاء := صواب; };
                            } وإلا إذا ((*الحقائق).رموز_الأماكن[الجذر] > 0) {
                                ليكن يحمل: متغير منطقي = الجذر < (الطول(*حامل_مكان) مثل طبيعي) && (*حامل_مكان)[الجذر];
                                إذا (!يحمل && مخزنة < (الطول((*الدالة).القيم) مثل طبيعي)) {
                                    يحمل := قد_يحمل_مرجعا_حياة(الحقائق, الأنواع, (*الدالة).القيم[مخزنة].النوع);
                                };
                                إذا (يحمل) { ألحق(*الحاملة, الجذر); };
                            };
                        };
                    };
                }
                | عملية_مسير.ملكية_مكان(الملكية) -> {
                    الأصناف := 0;
                    إذا (القيمة == المكان) {
                        طابق الملكية.الحدث مع
                        | حدث_ملكية_مسير.تصريح -> { الأصناف := 2; }
                        | حدث_ملكية_مسير.إسقاط -> { الأصناف := 1 + 4; }
                        | _ -> { };
                    };
                }
                | _ -> {
                    طابق موضع_ناتج_تعليمة_مسير(التعليمة) مع
                    | اختياري.موجود(الناتج) -> { ألحق(المضافة, الناتج); }
                    | اختياري.لا_شيء -> { };
                };
            };
            // Only what is derived on every path into it is a use.
            إذا (الأصناف != 0 && مباشرة) {
                ألحق(*النقاط, (رقم_موضع_حياة(الكتلة, الموضع) * 8) + الأصناف);
            };
            ليكن العلامة: متغير ط8 = 1;
            إذا (عبر_التقاء) { العلامة := 2; };
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(المضافة) مثل طبيعي)) {
                ليكن الجديدة: طبيعي = المضافة[م];
                إذا (الجديدة < عدد_القيم) {
                    ليكن السابقة: ط8 = (*المشتقة)[الجديدة];
                    إذا (السابقة == 0 || (السابقة == 2 && العلامة == 1)) {
                        إذا (السابقة == 0) { ألحق(المزارة, الجديدة); };
                        (*المشتقة)[الجديدة] := العلامة;
                        ألحق(القائمة, الجديدة);
                    };
                };
                م := م + 1;
            }
        }
    }
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المزارة) مثل طبيعي)) { (*المشتقة)[المزارة[ف]] := 0; ف := ف + 1; }
}

// The followed locals reading through each holder: pairs reader, holder
// (a borrowed view behind it, or a local whose origins may hold a read
// through it), from every event, whatever the path.
عرف قراء_عبر_حوامل_حياة(الوصف: &وصف_استعارات_مسير): متجه طبيعي {
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    ليكن العناصر: طبيعي = الطول((*الوصف).أصناف_العناصر) مثل طبيعي;
    // The origins a local may have on some path, by element (local-major).
    ليكن الممكنة: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (العدد * العناصر)) { ألحق(الممكنة, خطأ); ف := ف + 1; }
    ليكن الناتج: متغير متجه طبيعي = [];
    // Origins are only added, so each round that changes adds at least one
    // of the finitely many (local, element) pairs: this reaches the fixed
    // point.
    ليكن تغير: متغير منطقي = العناصر > 0;
    طالما (تغير) {
        تغير := خطأ;
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الوصف).أحداث_الكتل) مثل طبيعي)) {
            ليكن المأخوذة: متغير متجه منطقي = [];
            ف := 0;
            طالما (ف < العناصر) { ألحق(المأخوذة, خطأ); ف := ف + 1; }
            ليكن ي: متغير طبيعي = 0;
            طالما (ي < (الطول((*الوصف).أحداث_الكتل[ك]) مثل طبيعي)) {
                ليكن الحدث: &حدث_مفكك_استعارة = &(*الوصف).الأحداث[(*الوصف).أحداث_الكتل[ك][ي]];
                ي := ي + 1;
                ليكن الصنف: ط32 = (*الحدث).الصنف;
                ليكن أ: طبيعي = (*الحدث).أ;
                إذا (الصنف == صنف_استعارة_أصول_مسير()) {
                    إذا (((*الحدث).الأعلام % 2) == 0) {
                        ف := 0;
                        طالما (ف < العناصر) { المأخوذة[ف] := خطأ; ف := ف + 1; }
                    };
                    أضف_حدودا_ممكنة_حياة(الوصف, &الممكنة, &(*الحدث).الحدود, &متغير المأخوذة);
                } وإلا إذا (أ < العدد && الصنف == صنف_استعارة_إسناد_مسير()) {
                    // A raw pointer holds no origins.
                    إذا ((((*الحدث).الأعلام / 16) % 2) == 0) {
                        ف := 0;
                        طالما (ف < العناصر) {
                            إذا (المأخوذة[ف] && !الممكنة[(أ * العناصر) + ف]) {
                                الممكنة[(أ * العناصر) + ف] := صواب;
                                تغير := صواب;
                            };
                            ف := ف + 1;
                        }
                    };
                } وإلا إذا (أ < العدد && الصنف == صنف_استعارة_تصريح_مسير()) {
                    ليكن الواردة: متغير متجه منطقي = [];
                    ف := 0;
                    طالما (ف < العناصر) { ألحق(الواردة, خطأ); ف := ف + 1; }
                    أضف_حدودا_ممكنة_حياة(الوصف, &الممكنة, &(*الحدث).الحدود, &متغير الواردة);
                    ف := 0;
                    طالما (ف < العناصر) {
                        إذا (الواردة[ف] && !الممكنة[(أ * العناصر) + ف]) {
                            الممكنة[(أ * العناصر) + ف] := صواب;
                            تغير := صواب;
                        };
                        ف := ف + 1;
                    }
                };
            }
            ك := ك + 1;
        }
    }
    // A holder whose origins may read through another local.
    ليكن م: متغير طبيعي = 0;
    طالما (م < العدد && العناصر > 0) {
        إذا ((*الوصف).الحوامل[م] != 0) {
            ف := 0;
            طالما (ف < العناصر) {
                إذا (الممكنة[(م * العناصر) + ف] && (*الوصف).أصناف_العناصر[ف] == 2
                    && (*الوصف).محليات_العناصر[ف] != م) {
                    ألحق(الناتج, م);
                    ألحق(الناتج, (*الوصف).محليات_العناصر[ف]);
                };
                ف := ف + 1;
            }
        };
        م := م + 1;
    }
    // A borrowed view behind a reference local.
    ف := 0;
    طالما (ف < (الطول((*الوصف).الأحداث) مثل طبيعي)) {
        ليكن الحدث: &حدث_مفكك_استعارة = &(*الوصف).الأحداث[ف];
        إذا ((*الحدث).الصنف == صنف_استعارة_عرض_مسير() && (*الحدث).أ < العدد && (*الحدث).ب < العدد) {
            ألحق(الناتج, (*الحدث).أ);
            ألحق(الناتج, (*الحدث).ب);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The origins the terms of an event may make, added to الناتج.
عرف أضف_حدودا_ممكنة_حياة(
    الوصف: &وصف_استعارات_مسير,
    الممكنة: &متجه منطقي,
    الحدود: &متجه طبيعي,
    الناتج: &متغير متجه منطقي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    ليكن العناصر: طبيعي = الطول((*الوصف).أصناف_العناصر) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف + 2) < (الطول(*الحدود) مثل طبيعي)) {
        ليكن الصنف: طبيعي = (*الحدود)[ف];
        ليكن المحلي: طبيعي = (*الحدود)[ف + 1];
        ليكن العنصر: طبيعي = (*الحدود)[ف + 2];
        إذا ((الصنف == 0 || الصنف == 1) && المحلي < العدد) {
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < العناصر) {
                إذا ((*الممكنة)[(المحلي * العناصر) + ع]) { (*الناتج)[ع] := صواب; };
                ع := ع + 1;
            }
            إذا (المحلي < (الطول((*الوصف).الثابتة) مثل طبيعي) && (*الوصف).الثابتة[المحلي] > 0
                && ((*الوصف).الثابتة[المحلي] - 1) < العناصر) {
                (*الناتج)[(*الوصف).الثابتة[المحلي] - 1] := صواب;
            };
        };
        إذا (الصنف != 0 && العنصر < العناصر) { (*الناتج)[العنصر] := صواب; };
        ف := ف + 3;
    }
}

// Whether event رقم gives its local borrows.
عرف حدث_يعطي_استعارات_حياة(الوصف: &وصف_استعارات_مسير, رقم: طبيعي): منطقي {
    ليكن الحدث: &حدث_مفكك_استعارة = &(*الوصف).الأحداث[رقم];
    إذا ((*الحدث).الصنف == صنف_استعارة_عرض_مسير()) { أرجع صواب; };
    إذا ((*الحدث).الصنف == صنف_استعارة_إسناد_مسير()) { أرجع (((*الحدث).الأعلام / 2) % 2) == 1; };
    أرجع خطأ;
}

// Adds to الوصف where the borrows of each holder end, from the liveness of
// the holders in function الدالة. الأماكن: per followed local, its place plus
// one (0 for none: such a holder is taken as live everywhere).
عام عرف أضف_نهايات_حياة_استعارات_مسير(
    الوصف: &متغير وصف_استعارات_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأماكن: &متجه طبيعي
): فراغ {
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    إذا ((*الوصف).ساكنة || (*الوصف).عدد_الحوامل == 0 || العدد == 0) { أرجع; };
    ليكن الحقائق: متغير حياة_دالة_استعارة = ابن_حياة_دالة_استعارة(الدالة);
    ليكن عدد_القيم: طبيعي = الطول(الحقائق.المستخدمون) مثل طبيعي;
    ليكن عدد_الكتل: طبيعي = الحقائق.عدد_الكتل;
    // The followed local of each place plus one, and whether it is a
    // holder's (a value stored there carries a borrow on).
    ليكن محلي_المكان: متغير متجه طبيعي = [];
    ليكن حامل_مكان: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(محلي_المكان, 0); ألحق(حامل_مكان, خطأ); ف := ف + 1; }
    ليكن م: متغير طبيعي = 0;
    طالما (م < العدد) {
        ليكن المكان: طبيعي = مكان_محلي_حياة(الأماكن, م, عدد_القيم);
        إذا (المكان != بلا_مكان_حياة()) {
            محلي_المكان[المكان] := م + 1;
            حامل_مكان[المكان] := (*الوصف).الحوامل[م] != 0;
        };
        م := م + 1;
    }
    // The uses of every place reached: its own points, and the places that
    // carry what is derived from it on.
    ليكن نقاط_الأماكن: متغير متجه متجه طبيعي = [];
    ليكن حاملة_الأماكن: متغير متجه متجه طبيعي = [];
    ليكن محسوبة: متغير متجه منطقي = [];
    // Scratch, all false between uses.
    ليكن المشتقة: متغير متجه ط8 = [];
    ليكن المزارة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_القيم) {
        ليكن فارغة: متجه طبيعي = [];
        ألحق(نقاط_الأماكن, فارغة);
        ليكن فارغة_ثانية: متجه طبيعي = [];
        ألحق(حاملة_الأماكن, فارغة_ثانية);
        ألحق(محسوبة, خطأ);
        ألحق(المشتقة, 0);
        ألحق(المزارة, خطأ);
        ف := ف + 1;
    }
    // Readers through a holder carry its borrow on as well.
    ليكن القراء: متجه طبيعي = قراء_عبر_حوامل_حياة(&(*الوصف));
    // The points of each holder, by block: ((position * العدد) + local) * 8 +
    // kinds; a holder without a place is live everywhere.
    ليكن نقاط_الكتل: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الكتل) { ليكن فارغة: متجه طبيعي = []; ألحق(نقاط_الكتل, فارغة); ف := ف + 1; }
    ليكن دائمة: متغير متجه منطقي = [];
    // Per holder, the places whose reads use it.
    ليكن أماكن_الاستخدام: متغير متجه متجه طبيعي = [];
    م := 0;
    طالما (م < العدد) {
        ألحق(دائمة, خطأ);
        ليكن فارغة: متجه طبيعي = [];
        ألحق(أماكن_الاستخدام, فارغة);
        م := م + 1;
    }
    م := 0;
    طالما (م < العدد) {
        إذا ((*الوصف).الحوامل[م] != 0) {
            ليكن المكان: طبيعي = مكان_محلي_حياة(الأماكن, م, عدد_القيم);
            إذا (المكان == بلا_مكان_حياة()) {
                دائمة[م] := صواب;
            } وإلا {
                // Every place reached from the holder's: carried values and
                // readers through it.
                ليكن القائمة: متغير متجه طبيعي = [المكان];
                المزارة[المكان] := صواب;
                ليكن الرأس: متغير طبيعي = 0;
                طالما (الرأس < (الطول(القائمة) مثل طبيعي)) {
                    ليكن الحالي: طبيعي = القائمة[الرأس];
                    الرأس := الرأس + 1;
                    إذا (!محسوبة[الحالي]) {
                        محسوبة[الحالي] := صواب;
                        ليكن النقاط: متغير متجه طبيعي = [];
                        ليكن الحاملة: متغير متجه طبيعي = [];
                        نقاط_مكان_حياة(
                            الدالة, &متغير الحقائق, الأنواع, الحالي, &حامل_مكان, &متغير المشتقة, &متغير النقاط,
                            &متغير الحاملة
                        );
                        بدّل(نقاط_الأماكن[الحالي], النقاط);
                        بدّل(حاملة_الأماكن[الحالي], الحاملة);
                    };
                    ليكن ب: متغير طبيعي = 0;
                    طالما (ب < (الطول(حاملة_الأماكن[الحالي]) مثل طبيعي)) {
                        ليكن التالي: طبيعي = حاملة_الأماكن[الحالي][ب];
                        إذا (!المزارة[التالي]) { المزارة[التالي] := صواب; ألحق(القائمة, التالي); };
                        ب := ب + 1;
                    }
                    ليكن محلي_الحالي: طبيعي = محلي_المكان[الحالي];
                    ب := 0;
                    طالما (محلي_الحالي > 0 && (ب + 1) < (الطول(القراء) مثل طبيعي)) {
                        إذا (القراء[ب + 1] == محلي_الحالي - 1) {
                            ليكن القارئ: طبيعي = مكان_محلي_حياة(الأماكن, القراء[ب], عدد_القيم);
                            إذا (القارئ == بلا_مكان_حياة()) {
                                دائمة[م] := صواب;
                            } وإلا إذا (!المزارة[القارئ]) {
                                المزارة[القارئ] := صواب;
                                ألحق(القائمة, القارئ);
                            };
                        };
                        ب := ب + 2;
                    }
                    // The holder's own place counts every kind, another only
                    // its uses.
                    ليكن ن: متغير طبيعي = 0;
                    طالما (ن < (الطول(نقاط_الأماكن[الحالي]) مثل طبيعي)) {
                        ليكن النقطة: طبيعي = نقاط_الأماكن[الحالي][ن];
                        ليكن الأصناف: متغير طبيعي = النقطة % 8;
                        إذا (الحالي != المكان) { الأصناف := الأصناف % 2; };
                        إذا (الأصناف != 0) {
                            ليكن الرقم: طبيعي = النقطة / 8;
                            ليكن الكتلة: طبيعي = الرقم / 4294967296;
                            ليكن الموضع: طبيعي = الرقم % 4294967296;
                            إذا (الكتلة < عدد_الكتل) {
                                ألحق(نقاط_الكتل[الكتلة], (((الموضع * العدد) + م) * 8) + الأصناف);
                            };
                        };
                        ن := ن + 1;
                    }
                }
                ف := 0;
                طالما (ف < (الطول(القائمة) مثل طبيعي)) {
                    المزارة[القائمة[ف]] := خطأ;
                    ألحق(أماكن_الاستخدام[م], القائمة[ف]);
                    ف := ف + 1;
                }
            };
        };
        م := م + 1;
    }
    // Per block, in position order, one point per instruction and holder.
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) { رتب_ودمج_نقاط_حياة(&متغير نقاط_الكتل[ك]); ك := ك + 1; }
    // The backward transfer of each block for the dataflow: for each holder,
    // its first point in the block, a use (live where the block is entered)
    // or a whole value given (dead there). A later pair wins, so the points
    // are written last to first.
    ليكن الملخصات: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الملخص: متغير متجه طبيعي = [];
        ليكن ن: متغير طبيعي = الطول(نقاط_الكتل[ك]) مثل طبيعي;
        طالما (ن > 0) {
            ن := ن - 1;
            ليكن النقطة: طبيعي = نقاط_الكتل[ك][ن];
            ليكن الأصناف: طبيعي = النقطة % 8;
            ليكن المحلي: طبيعي = (النقطة / 8) % العدد;
            إذا ((الأصناف % 2) == 1) {
                ألحق(الملخص, المحلي); ألحق(الملخص, 1);
            } وإلا إذا (((الأصناف / 2) % 2) == 1) {
                ألحق(الملخص, المحلي); ألحق(الملخص, 0);
            };
        }
        ألحق(الملخصات, الملخص);
        ك := ك + 1;
    }
    // Backward: each block hands its state to its predecessors; every block
    // starts with every holder dead.
    ليكن السوابق: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ليكن فارغة: متجه طبيعي = []; ألحق(السوابق, فارغة); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        ليكن خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            ليكن الخلف: طبيعي = الخلفاء[خ].القيمة مثل طبيعي;
            إذا (الخلف < عدد_الكتل) { ألحق(السوابق[الخلف], ك); };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    ليكن المداخل: متغير متجه طبيعي = [];
    ك := عدد_الكتل;
    طالما (ك > 0) { ك := ك - 1; ألحق(المداخل, ك); }
    ليكن البداية: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < العدد) { ألحق(البداية, 0); م := م + 1; }
    ليكن بلا_رتب: متجه طبيعي = [];
    ليكن بلا_استعارات: وصف_استعارات_مسير = وصف_استعارات_فارغ_مسير();
    // The state each block ends with.
    ليكن الخارجة: متجه طبيعي = احسب_حالات_شبكة_على_خلفاء_مسير(
        عدد_الكتل, &السوابق, &المداخل, العدد, &البداية, &الملخصات, شبكة_تهيئة_مسير.حياة(), &بلا_رتب,
        &بلا_استعارات
    );
    // Each block backward from its end: where each holder dies, and its
    // liveness at its terminator and where it is entered.
    ليكن حية_المنهي: متغير متجه منطقي = [];
    ليكن حية_الدخول: متغير متجه منطقي = [];
    ليكن نهايات_الكتل: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ليكن الحية: متغير متجه منطقي = [];
        م := 0;
        طالما (م < العدد) {
            ألحق(الحية, دائمة[م] || الخارجة[(ك * العدد) + م] != 0);
            م := م + 1;
        }
        ليكن عدد_التعليمات: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
        // The events of the block that give a holder borrows, in order.
        ليكن المعطية: متغير متجه طبيعي = [];
        إذا (ك < (الطول((*الوصف).أحداث_الكتل) مثل طبيعي)) {
            ليكن ي: متغير طبيعي = 0;
            طالما (ي < (الطول((*الوصف).أحداث_الكتل[ك]) مثل طبيعي)) {
                ليكن الرقم: طبيعي = (*الوصف).أحداث_الكتل[ك][ي];
                ليكن المعطى: طبيعي = (*الوصف).الأحداث[الرقم].أ;
                إذا (حدث_يعطي_استعارات_حياة(&(*الوصف), الرقم) && المعطى < العدد
                    && (*الوصف).الحوامل[المعطى] != 0) {
                    ألحق(المعطية, (*الوصف).مواضع_الأحداث[الرقم]);
                    ألحق(المعطية, (*الوصف).الأحداث[الرقم].أ);
                };
                ي := ي + 1;
            }
        };
        ليكن النهايات: متغير متجه طبيعي = [];
        ليكن ن: متغير طبيعي = الطول(نقاط_الكتل[ك]) مثل طبيعي;
        ليكن ع: متغير طبيعي = الطول(المعطية) مثل طبيعي;
        // From the terminator to the first instruction.
        ليكن الموضع: متغير طبيعي = عدد_التعليمات + 1;
        طالما (الموضع > 0) {
            الموضع := الموضع - 1;
            // The points of the instruction at الموضع: a last use ends the
            // holder right after it, a destruction always does.
            طالما (ن > 0 && ((نقاط_الكتل[ك][ن - 1] / 8) / العدد) == الموضع) {
                ن := ن - 1;
                ليكن النقطة: طبيعي = نقاط_الكتل[ك][ن];
                ليكن الأصناف: طبيعي = النقطة % 8;
                ليكن المحلي: طبيعي = (النقطة / 8) % العدد;
                إذا ((الأصناف / 4) == 1 || ((الأصناف % 2) == 1 && !الحية[المحلي])) {
                    إذا (الموضع < عدد_التعليمات) { ألحق(النهايات, الموضع + 1); ألحق(النهايات, المحلي); };
                };
                إذا ((الأصناف % 2) == 1) {
                    الحية[المحلي] := صواب;
                } وإلا إذا (((الأصناف / 2) % 2) == 1 && !دائمة[المحلي]) {
                    الحية[المحلي] := خطأ;
                };
            }
            إذا (الموضع == عدد_التعليمات) {
                م := 0;
                طالما (م < العدد) { ألحق(حية_المنهي, الحية[م]); م := م + 1; }
            };
            // A borrow given where its holder is dead ends right away.
            طالما (ع >= 2 && المعطية[ع - 2] >= الموضع) {
                ع := ع - 2;
                إذا (المعطية[ع] == الموضع && !الحية[المعطية[ع + 1]]) {
                    ألحق(النهايات, الموضع);
                    ألحق(النهايات, المعطية[ع + 1]);
                };
            }
        }
        م := 0;
        طالما (م < العدد) { ألحق(حية_الدخول, الحية[م]); م := م + 1; }
        ألحق(نهايات_الكتل, النهايات);
        ك := ك + 1;
    }
    // Where a block is entered with a holder dead that a predecessor ends
    // with live, its borrows end there.
    ك := 0;
    طالما (ك < عدد_الكتل) {
        م := 0;
        طالما (م < العدد) {
            إذا ((*الوصف).الحوامل[م] != 0 && !حية_الدخول[(ك * العدد) + م]) {
                ليكن حية_في_سابقة: متغير منطقي = خطأ;
                ليكن س: متغير طبيعي = 0;
                طالما (س < (الطول(السوابق[ك]) مثل طبيعي)) {
                    إذا (حية_المنهي[(السوابق[ك][س] * العدد) + م]) { حية_في_سابقة := صواب; };
                    س := س + 1;
                }
                إذا (حية_في_سابقة) { ألحق(نهايات_الكتل[ك], 0); ألحق(نهايات_الكتل[ك], م); };
            };
            م := م + 1;
        }
        ليكن المرتبة: متغير متجه طبيعي = [];
        ليكن ي: متغير طبيعي = 0;
        طالما ((ي + 1) < (الطول(نهايات_الكتل[ك]) مثل طبيعي)) {
            ألحق(المرتبة, (نهايات_الكتل[ك][ي] * العدد) + نهايات_الكتل[ك][ي + 1]);
            ي := ي + 2;
        }
        رتب_تصاعديا_حياة(&متغير المرتبة);
        ليكن الأزواج: متغير متجه طبيعي = [];
        ي := 0;
        طالما (ي < (الطول(المرتبة) مثل طبيعي)) {
            إذا (ي == 0 || المرتبة[ي] != المرتبة[ي - 1]) {
                ألحق(الأزواج, المرتبة[ي] / العدد);
                ألحق(الأزواج, المرتبة[ي] % العدد);
            };
            ي := ي + 1;
        }
        أدرج_انتهاءات_حوامل_استعارة_مسير(الوصف, ك, &الأزواج);
        ك := ك + 1;
    }
    (*الوصف).حية_الدخول := حية_الدخول;
    (*الوصف).أماكن_الاستخدام := أماكن_الاستخدام;
}

عرف بلا_مكان_حياة(): طبيعي { أرجع 4294967295; }

عرف مكان_محلي_حياة(الأماكن: &متجه طبيعي, م: طبيعي, عدد_القيم: طبيعي): طبيعي {
    إذا (م >= (الطول(*الأماكن) مثل طبيعي)) { أرجع بلا_مكان_حياة(); };
    ليكن المكان: طبيعي = (*الأماكن)[م];
    إذا (المكان == 0 || (المكان - 1) >= عدد_القيم) { أرجع بلا_مكان_حياة(); };
    أرجع المكان - 1;
}

// Sorts the points of a block (رتب_تصاعديا_حياة) and merges those of one
// instruction and holder: their kinds together.
عرف رتب_ودمج_نقاط_حياة(النقاط: &متغير متجه طبيعي): فراغ {
    رتب_تصاعديا_حياة(النقاط);
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النقاط) مثل طبيعي)) {
        ليكن المفتاح: طبيعي = (*النقاط)[ف] / 8;
        ليكن الاستخدام: متغير منطقي = خطأ;
        ليكن الإعطاء: متغير منطقي = خطأ;
        ليكن الإسقاط: متغير منطقي = خطأ;
        طالما (ف < (الطول(*النقاط) مثل طبيعي) && ((*النقاط)[ف] / 8) == المفتاح) {
            ليكن الأصناف: طبيعي = (*النقاط)[ف] % 8;
            إذا ((الأصناف % 2) == 1) { الاستخدام := صواب; };
            إذا (((الأصناف / 2) % 2) == 1) { الإعطاء := صواب; };
            إذا ((الأصناف / 4) == 1) { الإسقاط := صواب; };
            ف := ف + 1;
        }
        ليكن المدمجة: متغير طبيعي = 0;
        إذا (الاستخدام) { المدمجة := المدمجة + 1; };
        إذا (الإعطاء) { المدمجة := المدمجة + 2; };
        إذا (الإسقاط) { المدمجة := المدمجة + 4; };
        ألحق(الناتج, (المفتاح * 8) + المدمجة);
    }
    *النقاط := الناتج;
}

// Sorts الأرقام in ascending order (insertion: the lists are short and
// nearly in order).
عرف رتب_تصاعديا_حياة(الأرقام: &متغير متجه طبيعي): فراغ {
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*الأرقام) مثل طبيعي)) {
        ليكن الحالي: طبيعي = (*الأرقام)[ف];
        ليكن ي: متغير طبيعي = ف;
        طالما (ي > 0 && (*الأرقام)[ي - 1] > الحالي) {
            (*الأرقام)[ي] := (*الأرقام)[ي - 1];
            ي := ي - 1;
        }
        (*الأرقام)[ي] := الحالي;
        ف := ف + 1;
    }
}
