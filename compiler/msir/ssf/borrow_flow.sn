استورد compiler.source.span;
استورد compiler.msir.msir_model;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.ownership_errors;

// The borrow state of a function's locals on MSIR (docs/en/internals/
// ownership-analysis.md, "Borrows"), followed over the blocks by the shared
// dataflow (drop_elaboration.sn, احسب_حالات_دخول_شبكة_مسير, lattice
// شبكة_تهيئة_مسير.استعارات) and checked by the legality analysis
// (ownership_legality.sn). It runs the borrow events lowering records
// (msir_model.sn, حدث_استعارة_مسير).
//
// The locals followed (المتتبعة) are those an event names. For each: where
// a write ended it, as a borrowed view or as a value reading through a
// reference, or where it moved out as an exclusive borrow (X: a span number
// plus one, 0 for none), whether it is a borrowed view (V), whether a join
// met borrows that cannot both hold (a shared and an exclusive one, or two
// exclusive ones: the source rejects that merge). A local an assignment
// gives origins (a target) has its origins: an ordered list over the
// function's origin elements (a borrow of a local, shared or exclusive; a
// read through a reference local; a parameter's own), one slot per element
// holding its position plus one. A local that can be borrowed (an owner)
// has, for each local that can hold a borrow (a holder), the borrow that
// holder holds on it: 0 none, 1 shared, 2 exclusive.
//
// A borrow lasts while the holder is live (borrow_liveness.sn): from where
// it starts to the holder's last use on every path, the uses of what is
// derived from it included, or to the holder's destruction when it is an
// owner. Where a holder dies, an ending event (صنف_انتهاء_حوامل_استعارة_مسير)
// ends its borrows; the events lowering records end none. The one scope
// event lowering records (صنف_استعارة_نهاية_نطاق_مسير: a borrowed local that
// no instruction destroys goes out of scope) changes no state: the legality
// analysis checks the holders that still borrow the local there
// (محلي_نهاية_نطاق_استعارة_مسير).

// One event, its Symbols turned into followed locals (0xFFFFFFFF for none):
// أ the local (الرمز), ب the second one or the borrow kind, الحدود the terms
// as triples kind, local, element.
عام نوع حدث_مفكك_استعارة = {
    الصنف: ط32,
    الرمز: ط32,
    أ: طبيعي,
    ب: طبيعي,
    الأعلام: ط32,
    النطاق: طبيعي,
    الحدود: متجه طبيعي
};

عام نوع وصف_استعارات_مسير = {
    // Per followed local: its Symbol, its index among targets, owners and
    // holders plus one (0 for none).
    الرموز: متجه ط32,
    الأهداف: متجه طبيعي,
    المالكون: متجه طبيعي,
    الحوامل: متجه طبيعي,
    عدد_الأهداف: طبيعي,
    عدد_المالكين: طبيعي,
    عدد_الحوامل: طبيعي,
    // Per origin element: kind (1 a borrow of a local, 2 a read through a
    // reference local, 3 a parameter), its local, exclusive, and for a
    // reference whether its Type carries a borrow.
    أصناف_العناصر: متجه ط32,
    محليات_العناصر: متجه طبيعي,
    حصرية_العناصر: متجه منطقي,
    حاملة_العناصر: متجه منطقي,
    // The events, and per block the events in order (the summaries).
    الأحداث: متجه حدث_مفكك_استعارة,
    مواضع_الأحداث: متجه طبيعي,
    أحداث_الكتل: متجه متجه طبيعي,
    النطاقات: متجه نطاق,
    العرض: طبيعي,
    // Per followed local that is no target: its one origin plus one (a
    // parameter whose own origin never changes), 0 for none.
    الثابتة: متجه طبيعي,
    // No event changes the state (no target, holder or exclusive reference
    // that moves): every block starts from the empty state.
    ساكنة: منطقي,
    // Per block and followed local (block-major, empty when no liveness was
    // computed): whether the local is live where the block is entered. A
    // join ignores the borrows of a holder that is not.
    حية_الدخول: متجه منطقي,
    // Per followed local that holds borrows (empty without liveness): the
    // places whose reads use it, its own first (borrow_liveness.sn).
    أماكن_الاستخدام: متجه متجه طبيعي
};

عام عرف وصف_استعارات_فارغ_مسير(): وصف_استعارات_مسير {
    ليكن الوصف: وصف_استعارات_مسير = {
        الرموز: [], الأهداف: [], المالكون: [], الحوامل: [],
        عدد_الأهداف: 0, عدد_المالكين: 0, عدد_الحوامل: 0,
        أصناف_العناصر: [], محليات_العناصر: [], حصرية_العناصر: [], حاملة_العناصر: [],
        الأحداث: [], مواضع_الأحداث: [], أحداث_الكتل: [], النطاقات: [],
        العرض: 0, الثابتة: [], ساكنة: صواب, حية_الدخول: [], أماكن_الاستخدام: []
    };
    أرجع الوصف;
}

عرف بلا_استعارة_مسير(): طبيعي { أرجع 4294967295; }

// The kind of the events the analysis adds where holders die (or are
// destroyed): الحدود names them as triples 0, local, none, and the borrows
// they hold end. Lowering records no event of this kind.
عام عرف صنف_انتهاء_حوامل_استعارة_مسير(): ط32 { أرجع 1; }

عرف بت_استعارة_مسير(القيمة: ط32, البت: ط32): منطقي {
    أرجع ((القيمة / البت) % 2) == 1;
}

// A slot of a state; a state of no slots (a function whose borrow state
// never changes, وصف_استعارات_مسير.ساكنة) reads 0 everywhere and keeps
// nothing written.
عرف قيمة_خانة_استعارة(الحالة: &متجه طبيعي, الخانة: طبيعي): طبيعي {
    إذا (الخانة >= (الطول(*الحالة) مثل طبيعي)) { أرجع 0; };
    أرجع (*الحالة)[الخانة];
}

عرف اكتب_خانة_استعارة(الحالة: &متغير متجه طبيعي, الخانة: طبيعي, القيمة: طبيعي): فراغ {
    إذا (الخانة < (الطول(*الحالة) مثل طبيعي)) { (*الحالة)[الخانة] := القيمة; };
}

// The slots of local ف.
عرف خانة_انتهاء_استعارة(ف: طبيعي): طبيعي { أرجع ف * 3; }
عرف خانة_عرض_استعارة(ف: طبيعي): طبيعي { أرجع (ف * 3) + 1; }
عرف خانة_تعارض_استعارة(ف: طبيعي): طبيعي { أرجع (ف * 3) + 2; }

عرف عدد_العناصر_استعارة(الوصف: &وصف_استعارات_مسير): طبيعي {
    أرجع الطول((*الوصف).أصناف_العناصر) مثل طبيعي;
}

// The first slot of the origins of target local ف (none when it is not a
// target).
عرف بداية_أصول_استعارة(الوصف: &وصف_استعارات_مسير, ف: طبيعي): طبيعي {
    ليكن الهدف: طبيعي = (*الوصف).الأهداف[ف];
    إذا (الهدف == 0) { أرجع بلا_استعارة_مسير(); };
    أرجع (3 * (الطول((*الوصف).الرموز) مثل طبيعي)) + ((الهدف - 1) * عدد_العناصر_استعارة(الوصف));
}

// The slot of the borrow holder ح holds on owner م (none when either is not
// one).
عرف خانة_استعارة_مسير(الوصف: &وصف_استعارات_مسير, م: طبيعي, ح: طبيعي): طبيعي {
    ليكن المالك: طبيعي = (*الوصف).المالكون[م];
    ليكن الحامل: طبيعي = (*الوصف).الحوامل[ح];
    إذا (المالك == 0 || الحامل == 0) { أرجع بلا_استعارة_مسير(); };
    أرجع (3 * (الطول((*الوصف).الرموز) مثل طبيعي)) + ((*الوصف).عدد_الأهداف * عدد_العناصر_استعارة(الوصف))
        + ((المالك - 1) * (*الوصف).عدد_الحوامل) + (الحامل - 1);
}

// The origins of local ف, in order (element numbers).
عام عرف أصول_محلي_استعارة(الوصف: &وصف_استعارات_مسير, الحالة: &متجه طبيعي, ف: طبيعي): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن البداية: طبيعي = بداية_أصول_استعارة(الوصف, ف);
    إذا (البداية == بلا_استعارة_مسير()) {
        إذا (ف < (الطول((*الوصف).الثابتة) مثل طبيعي) && (*الوصف).الثابتة[ف] > 0) {
            ألحق(الناتج, (*الوصف).الثابتة[ف] - 1);
        };
        أرجع الناتج;
    };
    ليكن العدد: طبيعي = عدد_العناصر_استعارة(الوصف);
    ليكن الطول: متغير طبيعي = 0;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < العدد) {
        إذا (قيمة_خانة_استعارة(الحالة, البداية + ع) > الطول) { الطول := قيمة_خانة_استعارة(الحالة, البداية + ع); };
        ع := ع + 1;
    }
    ع := 0;
    طالما (ع < الطول) { ألحق(الناتج, 0); ع := ع + 1; }
    ع := 0;
    طالما (ع < العدد) {
        ليكن الموضع: طبيعي = قيمة_خانة_استعارة(الحالة, البداية + ع);
        إذا (الموضع > 0) { الناتج[الموضع - 1] := ع; };
        ع := ع + 1;
    }
    أرجع الناتج;
}

عرف اكتب_أصول_محلي_استعارة(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متغير متجه طبيعي,
    ف: طبيعي,
    الأصول: &متجه طبيعي
): فراغ {
    ليكن البداية: طبيعي = بداية_أصول_استعارة(الوصف, ف);
    إذا (البداية == بلا_استعارة_مسير()) { أرجع; };
    ليكن العدد: طبيعي = عدد_العناصر_استعارة(الوصف);
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < العدد) { اكتب_خانة_استعارة(الحالة, البداية + ع, 0); ع := ع + 1; }
    ع := 0;
    طالما (ع < (الطول(*الأصول) مثل طبيعي)) {
        اكتب_خانة_استعارة(الحالة, البداية + (*الأصول)[ع], ع + 1);
        ع := ع + 1;
    }
}

عرف ألحق_عنصرا_فريدا_استعارة(القائمة: &متغير متجه طبيعي, العنصر: طبيعي): فراغ {
    إذا (عنصر_في_قائمة_استعارة(&(*القائمة), العنصر)) { أرجع; };
    ألحق(*القائمة, العنصر);
}

عرف عنصر_في_قائمة_استعارة(القائمة: &متجه طبيعي, العنصر: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا ((*القائمة)[ف] == العنصر) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The origins the terms of an event make, in order and each once: a
// local's own (kind 0), a borrow of a local (its origins, or the local
// itself when it has none: kind 1), a read through a reference or a
// parameter's own (kinds 2, 3).
عرف حل_حدود_استعارة(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متجه طبيعي,
    الحدود: &متجه طبيعي,
    الناتج: &متغير متجه طبيعي
): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف + 2) < (الطول(*الحدود) مثل طبيعي)) {
        ليكن الصنف: طبيعي = (*الحدود)[ف];
        ليكن المحلي: طبيعي = (*الحدود)[ف + 1];
        ليكن العنصر: طبيعي = (*الحدود)[ف + 2];
        إذا (الصنف == 0 || الصنف == 1) {
            ليكن أصول: متغير متجه طبيعي = [];
            إذا (المحلي != بلا_استعارة_مسير()) { أصول := أصول_محلي_استعارة(الوصف, الحالة, المحلي); };
            إذا (الصنف == 1 && (الطول(أصول) مثل طبيعي) == 0 && العنصر != بلا_استعارة_مسير()) {
                ألحق(أصول, العنصر);
            };
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(أصول) مثل طبيعي)) { ألحق_عنصرا_فريدا_استعارة(الناتج, أصول[ع]); ع := ع + 1; }
        } وإلا إذا (العنصر != بلا_استعارة_مسير()) {
            ألحق_عنصرا_فريدا_استعارة(الناتج, العنصر);
        };
        ف := ف + 3;
    }
}

// Whether owner م is borrowed: 0 no, 1 shared only, 2 exclusively.
عرف حالة_استعارات_مالك(الوصف: &وصف_استعارات_مسير, الحالة: &متجه طبيعي, م: طبيعي): طبيعي {
    إذا ((*الوصف).المالكون[م] == 0) { أرجع 0; };
    ليكن الناتج: متغير طبيعي = 0;
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, م, ح);
        إذا (الخانة != بلا_استعارة_مسير()) {
            إذا (قيمة_خانة_استعارة(الحالة, الخانة) == 2) { أرجع 2; };
            إذا (قيمة_خانة_استعارة(الحالة, الخانة) == 1) { الناتج := 1; };
        };
        ح := ح + 1;
    }
    أرجع الناتج;
}

// The holders that hold a borrow of owner م in الحالة.
عام عرف حوامل_استعارة_مالك_مسير(الوصف: &وصف_استعارات_مسير, الحالة: &متجه طبيعي, م: طبيعي): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    إذا (م >= (الطول((*الوصف).المالكون) مثل طبيعي)) { أرجع الناتج; };
    إذا ((*الوصف).المالكون[م] == 0) { أرجع الناتج; };
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, م, ح);
        إذا (الخانة != بلا_استعارة_مسير() && قيمة_خانة_استعارة(الحالة, الخانة) != 0) { ألحق(الناتج, ح); };
        ح := ح + 1;
    }
    أرجع الناتج;
}

// Event رقم when it is the end of the scope of a borrowed local
// (صنف_استعارة_نهاية_نطاق_مسير): that followed local plus one, else 0 (any
// other event, or a local no event follows: nothing borrows it).
عام عرف محلي_نهاية_نطاق_استعارة_مسير(الوصف: &وصف_استعارات_مسير, رقم: طبيعي): طبيعي {
    إذا (رقم >= (الطول((*الوصف).الأحداث) مثل طبيعي)) { أرجع 0; };
    ليكن الحدث: &حدث_مفكك_استعارة = &(*الوصف).الأحداث[رقم];
    إذا ((*الحدث).الصنف != صنف_استعارة_نهاية_نطاق_مسير()) { أرجع 0; };
    إذا ((*الحدث).أ == بلا_استعارة_مسير()) { أرجع 0; };
    أرجع (*الحدث).أ + 1;
}

// The source span event رقم names (where a value moves, a scope's end), if
// any.
عام عرف نطاق_حدث_استعارة_مسير(الوصف: &وصف_استعارات_مسير, رقم: طبيعي): اختياري نطاق {
    إذا (رقم >= (الطول((*الوصف).الأحداث) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع نطاق_رقم_استعارة(الوصف, (*الوصف).الأحداث[رقم].النطاق);
}

// The borrows holder ح holds end.
عرف أنه_استعارات_حامل_مسير(الوصف: &وصف_استعارات_مسير, الحالة: &متغير متجه طبيعي, ح: طبيعي): فراغ {
    إذا ((*الوصف).الحوامل[ح] == 0) { أرجع; };
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, م, ح);
        إذا (الخانة != بلا_استعارة_مسير()) { اكتب_خانة_استعارة(الحالة, الخانة, 0); };
        م := م + 1;
    }
}

عرف رمز_محلي_استعارة(الوصف: &وصف_استعارات_مسير, ف: طبيعي): معرف_رمز {
    أرجع معرف_رمز_من((*الوصف).الرموز[ف] مثل طبيعي);
}

عرف نطاق_رقم_استعارة(الوصف: &وصف_استعارات_مسير, الرقم: طبيعي): اختياري نطاق {
    إذا (الرقم == 0 || الرقم > (الطول((*الوصف).النطاقات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الوصف).النطاقات[الرقم - 1]);
}

// A use of local ف whose value a write ended or that moved out as an
// exclusive borrow.
عرف خطأ_انتهاء_استعارة(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متجه طبيعي,
    ف: طبيعي,
    الاستخدام: اختياري نطاق
): خطأ_تدفق_سلامة {
    ليكن السياق: سياق_استخدام_بعد_النقل = {
        الرمز: رمز_محلي_استعارة(الوصف, ف),
        أصل_النقل: نطاق_رقم_استعارة(الوصف, قيمة_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(ف))),
        الاستخدام: الاستخدام,
        على_عرض: قيمة_خانة_استعارة(الحالة, خانة_عرض_استعارة(ف)) == 1
    };
    أرجع خطأ_تدفق_سلامة.استخدام_بعد_النقل(السياق);
}

عرف خطأ_تعارض_استعارة(الوصف: &وصف_استعارات_مسير, ف: طبيعي, حصرية: منطقي): خطأ_تدفق_سلامة {
    إذا (حصرية) {
        أرجع خطأ_تدفق_سلامة.تعارض_استعارة(رمز_محلي_استعارة(الوصف, ف), نوع_استعارة.حصرية());
    };
    أرجع خطأ_تدفق_سلامة.تعارض_استعارة(رمز_محلي_استعارة(الوصف, ف), نوع_استعارة.مشتركة());
}

// A read of local ف (the source's use check, its value aside): a value a
// write ended, an exclusive borrow of it.
عام عرف تحقق_قراءة_استعارة_مسير(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متجه طبيعي,
    ف: طبيعي,
    الاستخدام: اختياري نطاق
): اختياري خطأ_تدفق_سلامة {
    إذا (قيمة_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(ف)) != 0) {
        أرجع اختياري.موجود(خطأ_انتهاء_استعارة(الوصف, الحالة, ف, الاستخدام));
    };
    إذا (حالة_استعارات_مالك(الوصف, الحالة, ف) == 2) {
        أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, ف, خطأ));
    };
    أرجع اختياري.لا_شيء();
}

// A read of local ف that may not find it borrowed at all (it is changed,
// moved, released or given a value).
عرف تحقق_تغيير_استعارة(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متجه طبيعي,
    ف: طبيعي,
    الاستخدام: اختياري نطاق
): اختياري خطأ_تدفق_سلامة {
    طابق تحقق_قراءة_استعارة_مسير(الوصف, الحالة, ف, الاستخدام) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    إذا (حالة_استعارات_مالك(الوصف, الحالة, ف) != 0) {
        أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, ف, صواب));
    };
    أرجع اختياري.لا_شيء();
}

// Holder ح starts a borrow of owner م.
عرف ابدأ_استعارة_مسير(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متغير متجه طبيعي,
    م: طبيعي,
    ح: طبيعي,
    حصرية: منطقي
): اختياري خطأ_تدفق_سلامة {
    إذا (حصرية) {
        طابق تحقق_تغيير_استعارة(الوصف, &(*الحالة), م, اختياري.لا_شيء()) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
    } وإلا {
        طابق تحقق_قراءة_استعارة_مسير(الوصف, &(*الحالة), م, اختياري.لا_شيء()) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, م, ح);
    إذا (الخانة != بلا_استعارة_مسير()) {
        إذا (حصرية) { اكتب_خانة_استعارة(الحالة, الخانة, 2); } وإلا إذا (قيمة_خانة_استعارة(الحالة, الخانة) == 0) { اكتب_خانة_استعارة(الحالة, الخانة, 1); };
    };
    أرجع اختياري.لا_شيء();
}

// Whether the value of reference local ف may leave the function, the
// origins its value reads through followed to العمق.
عرف هروب_أصول_مقبول_استعارة(
    الوصف: &وصف_استعارات_مسير,
    الحالة: &متجه طبيعي,
    ف: طبيعي,
    يحمل: منطقي,
    العمق: طبيعي
): منطقي {
    ليكن الأصول: متجه طبيعي = أصول_محلي_استعارة(الوصف, الحالة, ف);
    إذا (يحمل && (الطول(الأصول) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < (الطول(الأصول) مثل طبيعي)) {
        ليكن العنصر: طبيعي = الأصول[ع];
        ليكن الصنف: ط32 = (*الوصف).أصناف_العناصر[العنصر];
        إذا (الصنف == 1) { أرجع خطأ; };
        إذا (الصنف == 2 && (*الوصف).محليات_العناصر[العنصر] != ف) {
            إذا (العمق == 0) { أرجع خطأ; };
            إذا (!هروب_أصول_مقبول_استعارة(
                الوصف, الحالة, (*الوصف).محليات_العناصر[العنصر], (*الوصف).حاملة_العناصر[العنصر], العمق - 1
            )) {
                أرجع خطأ;
            };
        };
        ع := ع + 1;
    }
    أرجع صواب;
}

عرف خطأ_هروب_استعارة(الرمز: معرف_رمز): خطأ_تدفق_سلامة {
    أرجع خطأ_تدفق_سلامة.هروب_غير_صالح(الرمز);
}

// Applies event رقم to الحالة (with the origins last taken in المأخوذة),
// and, when يتحقق, returns the first error the source states there.
عام عرف طبق_حدث_استعارة_مسير(
    الوصف: &وصف_استعارات_مسير,
    رقم: طبيعي,
    الحالة: &متغير متجه طبيعي,
    المأخوذة: &متغير متجه طبيعي,
    يتحقق: منطقي
): اختياري خطأ_تدفق_سلامة {
    ليكن الحدث: &حدث_مفكك_استعارة = &(*الوصف).الأحداث[رقم];
    ليكن الصنف: ط32 = (*الحدث).الصنف;
    ليكن أ: طبيعي = (*الحدث).أ;
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    // A declaration (an MSIR one, kind 0): the local holds nothing.
    إذا (الصنف == 0) {
        إذا (أ == بلا_استعارة_مسير()) { أرجع اختياري.لا_شيء(); };
        اكتب_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(أ), 0);
        اكتب_خانة_استعارة(الحالة, خانة_عرض_استعارة(أ), 0);
        اكتب_خانة_استعارة(الحالة, خانة_تعارض_استعارة(أ), 0);
        ليكن بلا: متجه طبيعي = [];
        اكتب_أصول_محلي_استعارة(الوصف, الحالة, أ, &بلا);
        أنه_استعارات_حامل_مسير(الوصف, الحالة, أ);
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < العدد) {
            ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, أ, ح);
            إذا (الخانة != بلا_استعارة_مسير()) { اكتب_خانة_استعارة(الحالة, الخانة, 0); };
            ح := ح + 1;
        }
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_انتهاء_حوامل_استعارة_مسير()) {
        ليكن ف: متغير طبيعي = 0;
        طالما ((ف + 2) < (الطول((*الحدث).الحدود) مثل طبيعي)) {
            ليكن المحلي: طبيعي = (*الحدث).الحدود[ف + 1];
            إذا (المحلي != بلا_استعارة_مسير()) { أنه_استعارات_حامل_مسير(الوصف, الحالة, المحلي); };
            ف := ف + 3;
        }
        أرجع اختياري.لا_شيء();
    };
    // A scope's end changes nothing (the legality analysis checks it).
    إذا (الصنف == صنف_استعارة_نهاية_نطاق_مسير()) { أرجع اختياري.لا_شيء(); };
    إذا (الصنف == صنف_استعارة_أصول_مسير()) {
        إذا (!بت_استعارة_مسير((*الحدث).الأعلام, 1)) {
            ليكن بلا: متجه طبيعي = [];
            *المأخوذة := بلا;
        };
        حل_حدود_استعارة(الوصف, &(*الحالة), &(*الحدث).الحدود, المأخوذة);
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_مؤقتة_مسير()) {
        إذا (!يتحقق) { أرجع اختياري.لا_شيء(); };
        ليكن حصرية: منطقي = (*الحدث).ب == 1;
        إذا (أ != بلا_استعارة_مسير()) {
            ليكن الحال: طبيعي = حالة_استعارات_مالك(الوصف, &(*الحالة), أ);
            إذا (الحال == 1 && حصرية) { أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, أ, صواب)); };
            إذا (الحال == 2) { أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, أ, حصرية)); };
        };
        إذا (بت_استعارة_مسير((*الحدث).الأعلام, 1)) {
            أرجع اختياري.موجود(خطأ_تدفق_سلامة.تعارض_استعارة(
                معرف_رمز_من((*الحدث).الرمز مثل طبيعي),
                طابق_نوع_استعارة_مسير(حصرية)
            ));
        };
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_هروب_مسير()) {
        إذا (!يتحقق) { أرجع اختياري.لا_شيء(); };
        ليكن الأصول: متغير متجه طبيعي = [];
        حل_حدود_استعارة(الوصف, &(*الحالة), &(*الحدث).الحدود, &متغير الأصول);
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الأصول) مثل طبيعي)) {
            ليكن العنصر: طبيعي = الأصول[ع];
            ليكن صنف_العنصر: ط32 = (*الوصف).أصناف_العناصر[العنصر];
            ليكن محلي_العنصر: طبيعي = (*الوصف).محليات_العناصر[العنصر];
            إذا (صنف_العنصر == 1) {
                أرجع اختياري.موجود(خطأ_هروب_استعارة(رمز_محلي_استعارة(الوصف, محلي_العنصر)));
            };
            إذا (صنف_العنصر == 2) {
                إذا (!هروب_أصول_مقبول_استعارة(
                    الوصف, &(*الحالة), محلي_العنصر, (*الوصف).حاملة_العناصر[العنصر], 16
                )) {
                    أرجع اختياري.موجود(خطأ_هروب_استعارة(رمز_محلي_استعارة(الوصف, محلي_العنصر)));
                };
            };
            ع := ع + 1;
        }
        أرجع اختياري.لا_شيء();
    };
    // A module value given origins.
    إذا (الصنف == صنف_استعارة_إسناد_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 1)) {
        إذا (يتحقق && (الطول(*المأخوذة) مثل طبيعي) > 0) {
            أرجع اختياري.موجود(خطأ_هروب_استعارة(معرف_رمز_من((*الحدث).الرمز مثل طبيعي)));
        };
        أرجع اختياري.لا_شيء();
    };
    إذا (أ == بلا_استعارة_مسير()) {
        // A local nothing borrows and nothing gives origins: only the static
        // facts of an escape remain.
        إذا (الصنف == صنف_استعارة_هروب_محلي_مسير() && يتحقق && بت_استعارة_مسير((*الحدث).الأعلام, 1)) {
            أرجع اختياري.موجود(خطأ_هروب_استعارة(معرف_رمز_من((*الحدث).الرمز مثل طبيعي)));
        };
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_تغيير_مسير()) {
        إذا (يتحقق) { أرجع تحقق_تغيير_استعارة(الوصف, &(*الحالة), أ, اختياري.لا_شيء()); };
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_كتابة_مسير() || الصنف == صنف_استعارة_كتابة_مرجع_مسير()) {
        // Every value borrowing the written storage ends there: a borrowed
        // view of a local's storage, anything reading through a reference.
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < العدد) {
            ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, أ, ح);
            إذا (الخانة != بلا_استعارة_مسير() && قيمة_خانة_استعارة(الحالة, الخانة) != 0) {
                إذا (الصنف == صنف_استعارة_كتابة_مرجع_مسير() || قيمة_خانة_استعارة(الحالة, خانة_عرض_استعارة(ح)) == 1) {
                    اكتب_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(ح), (*الحدث).النطاق);
                    أنه_استعارات_حامل_مسير(الوصف, الحالة, ح);
                };
            };
            ح := ح + 1;
        }
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_نقل_مسير() || الصنف == صنف_استعارة_تحرير_مسير()) {
        إذا (يتحقق) {
            طابق تحقق_تغيير_استعارة(الوصف, &(*الحالة), أ, نطاق_رقم_استعارة(الوصف, (*الحدث).النطاق)) مع
            | اختياري.موجود(الخطأ) -> {
                // A release finds a borrow of the value before anything else.
                إذا (الصنف == صنف_استعارة_تحرير_مسير()
                    && قيمة_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(أ)) == 0) {
                    أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, أ, صواب));
                };
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };
        ليكن يستهلك: متغير منطقي = الصنف == صنف_استعارة_تحرير_مسير() || بت_استعارة_مسير((*الحدث).الأعلام, 1);
        إذا (!يستهلك && بت_استعارة_مسير((*الحدث).الأعلام, 2)) {
            ليكن الأصول: متجه طبيعي = أصول_محلي_استعارة(الوصف, &(*الحالة), أ);
            ليكن ع: متغير طبيعي = 0;
            طالما (ع < (الطول(الأصول) مثل طبيعي)) {
                إذا ((*الوصف).أصناف_العناصر[الأصول[ع]] == 1 && (*الوصف).حصرية_العناصر[الأصول[ع]]) {
                    يستهلك := صواب;
                };
                ع := ع + 1;
            }
        };
        إذا (!يستهلك) { أرجع اختياري.لا_شيء(); };
        // A value that owns no storage is followed here when it moves out.
        إذا (الصنف == صنف_استعارة_نقل_مسير() && !بت_استعارة_مسير((*الحدث).الأعلام, 4)) {
            اكتب_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(أ), (*الحدث).النطاق);
        };
        ليكن بلا: متجه طبيعي = [];
        اكتب_أصول_محلي_استعارة(الوصف, الحالة, أ, &بلا);
        أنه_استعارات_حامل_مسير(الوصف, الحالة, أ);
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_إسناد_مسير()) {
        // A part of the local given the value (bit 64: a member or element
        // written, a vector appended to): the rest keeps its value, so the
        // local keeps its origins and borrows, and gains the value's. The
        // change of its storage in place was checked before (its own event).
        ليكن جزئي: منطقي = بت_استعارة_مسير((*الحدث).الأعلام, 64);
        إذا (يتحقق && !جزئي && حالة_استعارات_مالك(الوصف, &(*الحالة), أ) != 0) {
            أرجع اختياري.موجود(خطأ_تعارض_استعارة(الوصف, أ, صواب));
        };
        ليكن القديمة: متغير متجه طبيعي = [];
        إذا (جزئي) {
            القديمة := أصول_محلي_استعارة(الوصف, &(*الحالة), أ);
        } وإلا {
            اكتب_خانة_استعارة(الحالة, خانة_انتهاء_استعارة(أ), 0);
        };
        ليكن الأصول: متغير متجه طبيعي = [];
        ليكن ع_ق: متغير طبيعي = 0;
        طالما (ع_ق < (الطول(القديمة) مثل طبيعي)) { ألحق(الأصول, القديمة[ع_ق]); ع_ق := ع_ق + 1; }
        // A raw pointer holds no origins.
        إذا (!بت_استعارة_مسير((*الحدث).الأعلام, 16)) {
            ليكن ع_م: متغير طبيعي = 0;
            طالما (ع_م < (الطول(*المأخوذة) مثل طبيعي)) {
                ألحق_عنصرا_فريدا_استعارة(&متغير الأصول, (*المأخوذة)[ع_م]);
                ع_م := ع_م + 1;
            }
        };
        اكتب_أصول_محلي_استعارة(الوصف, الحالة, أ, &الأصول);
        إذا (!جزئي) { أنه_استعارات_حامل_مسير(الوصف, الحالة, أ); };
        إذا (!بت_استعارة_مسير((*الحدث).الأعلام, 2)) { أرجع اختياري.لا_شيء(); };
        // The value's borrows: of each local it borrows (as the destination
        // reference states when it is one), of each reference it reads
        // through. A part given a value starts only those of its new origins.
        ليكن المحفوظة: متجه طبيعي = أصول_محلي_استعارة(الوصف, &(*الحالة), أ);
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(المحفوظة) مثل طبيعي)) {
            ليكن العنصر: طبيعي = المحفوظة[ع];
            ليكن جديد: منطقي = !جزئي || !عنصر_في_قائمة_استعارة(&القديمة, العنصر);
            ليكن صنف_العنصر: ط32 = (*الوصف).أصناف_العناصر[العنصر];
            ليكن محلي_العنصر: طبيعي = (*الوصف).محليات_العناصر[العنصر];
            ليكن الخطأ: متغير اختياري خطأ_تدفق_سلامة = اختياري.لا_شيء();
            إذا (جديد && صنف_العنصر == 2 && محلي_العنصر != أ) {
                الخطأ := ابدأ_استعارة_مسير(الوصف, الحالة, محلي_العنصر, أ, خطأ);
            } وإلا إذا (جديد && صنف_العنصر == 1) {
                ليكن حصرية: متغير منطقي = (*الوصف).حصرية_العناصر[العنصر];
                إذا (بت_استعارة_مسير((*الحدث).الأعلام, 4)) { حصرية := خطأ; };
                إذا (بت_استعارة_مسير((*الحدث).الأعلام, 8)) { حصرية := صواب; };
                الخطأ := ابدأ_استعارة_مسير(الوصف, الحالة, محلي_العنصر, أ, حصرية);
            };
            طابق الخطأ مع
            | اختياري.موجود(خ) -> { إذا (يتحقق) { أرجع اختياري.موجود(خ); }; }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_تصريح_مسير()) {
        ليكن الأصول: متغير متجه طبيعي = [];
        حل_حدود_استعارة(الوصف, &(*الحالة), &(*الحدث).الحدود, &متغير الأصول);
        اكتب_أصول_محلي_استعارة(الوصف, الحالة, أ, &الأصول);
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_عرض_مسير()) {
        اكتب_خانة_استعارة(الحالة, خانة_عرض_استعارة(أ), 1);
        ليكن المالكون: متغير متجه طبيعي = [];
        ليكن الأصول: متغير متجه طبيعي = [];
        حل_حدود_استعارة(الوصف, &(*الحالة), &(*الحدث).الحدود, &متغير الأصول);
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الأصول) مثل طبيعي)) {
            إذا ((*الوصف).أصناف_العناصر[الأصول[ع]] == 1) { ألحق(المالكون, (*الوصف).محليات_العناصر[الأصول[ع]]); };
            ع := ع + 1;
        }
        إذا ((*الحدث).ب != بلا_استعارة_مسير()) { ألحق(المالكون, (*الحدث).ب); };
        ع := 0;
        طالما (ع < (الطول(المالكون) مثل طبيعي)) {
            طابق ابدأ_استعارة_مسير(الوصف, الحالة, المالكون[ع], أ, خطأ) مع
            | اختياري.موجود(الخطأ) -> { إذا (يتحقق) { أرجع اختياري.موجود(الخطأ); }; }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_هروب_محلي_مسير()) {
        إذا (!يتحقق) { أرجع اختياري.لا_شيء(); };
        طابق تحقق_قراءة_استعارة_مسير(الوصف, &(*الحالة), أ, اختياري.لا_شيء()) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        إذا (!هروب_أصول_مقبول_استعارة(الوصف, &(*الحالة), أ, بت_استعارة_مسير((*الحدث).الأعلام, 1), 16)) {
            أرجع اختياري.موجود(خطأ_هروب_استعارة(رمز_محلي_استعارة(الوصف, أ)));
        };
        أرجع اختياري.لا_شيء();
    };
    إذا (الصنف == صنف_استعارة_التقاط_مسير()) {
        ليكن النطاق: اختياري نطاق = نطاق_رقم_استعارة(الوصف, (*الحدث).النطاق);
        إذا (يتحقق) {
            طابق تحقق_قراءة_استعارة_مسير(الوصف, &(*الحالة), أ, النطاق) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        ليكن الأعلام: ط32 = (*الحدث).الأعلام;
        إذا (بت_استعارة_مسير(الأعلام, 1)) {
            إذا (بت_استعارة_مسير(الأعلام, 4)) {
                إذا (يتحقق) { أرجع اختياري.موجود(خطأ_هروب_استعارة(رمز_محلي_استعارة(الوصف, أ))); };
                أرجع اختياري.لا_شيء();
            };
            إذا (يتحقق) {
                طابق تحقق_تغيير_استعارة(الوصف, &(*الحالة), أ, النطاق) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
            ليكن بلا: متجه طبيعي = [];
            اكتب_أصول_محلي_استعارة(الوصف, الحالة, أ, &بلا);
            أرجع اختياري.لا_شيء();
        };
        إذا (بت_استعارة_مسير(الأعلام, 2) && يتحقق) {
            أرجع اختياري.موجود(خطأ_هروب_استعارة(رمز_محلي_استعارة(الوصف, أ)));
        };
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.لا_شيء();
}

عرف طابق_نوع_استعارة_مسير(حصرية: منطقي): نوع_استعارة {
    إذا (حصرية) { أرجع نوع_استعارة.حصرية(); };
    أرجع نوع_استعارة.مشتركة();
}

// The summary of a block in the dataflow: its events in order.
عام عرف طبق_ملخص_استعارات_مسير(
    الوصف: &وصف_استعارات_مسير,
    الملخص: &متجه طبيعي,
    الحالة: &متغير متجه طبيعي
): فراغ {
    ليكن المأخوذة: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الملخص) مثل طبيعي)) {
        ليكن الخطأ: اختياري خطأ_تدفق_سلامة = طبق_حدث_استعارة_مسير(
            الوصف, (*الملخص)[ف], الحالة, &متغير المأخوذة, خطأ
        );
        ف := ف + 1;
    }
}

// The join of two states, as the source merges control flow: a local ended
// on either side is ended (where the first side states it), a view on
// either is one, origins are the first side's then what only the second
// holds, borrows those of both; a shared and an exclusive borrow of the same
// local, or two exclusive ones, mark the merge rejected. The first state is
// the block's (الدخول from الأساس on). Returns whether it changed.
عام عرف ادمج_حالتي_استعارات_مسير(
    الوصف: &وصف_استعارات_مسير,
    الدخول: &متغير متجه طبيعي,
    الأساس: طبيعي,
    الواردة: &متجه طبيعي
): منطقي {
    ليكن تغير: متغير منطقي = خطأ;
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن خ: طبيعي = خانة_انتهاء_استعارة(ف);
        إذا ((*الدخول)[الأساس + خ] == 0 && (*الواردة)[خ] != 0) {
            (*الدخول)[الأساس + خ] := (*الواردة)[خ];
            تغير := صواب;
        };
        ليكن ع: طبيعي = خانة_عرض_استعارة(ف);
        إذا ((*الدخول)[الأساس + ع] == 0 && (*الواردة)[ع] != 0) { (*الدخول)[الأساس + ع] := 1; تغير := صواب; };
        ليكن ت: طبيعي = خانة_تعارض_استعارة(ف);
        إذا ((*الدخول)[الأساس + ت] == 0 && (*الواردة)[ت] != 0) { (*الدخول)[الأساس + ت] := 1; تغير := صواب; };
        // Origins.
        ليكن البداية: طبيعي = بداية_أصول_استعارة(الوصف, ف);
        إذا (البداية != بلا_استعارة_مسير()) {
            ليكن عدد_العناصر: طبيعي = عدد_العناصر_استعارة(الوصف);
            ليكن الطول: متغير طبيعي = 0;
            ليكن واردة_الطول: متغير طبيعي = 0;
            ليكن س: متغير طبيعي = 0;
            طالما (س < عدد_العناصر) {
                إذا ((*الدخول)[الأساس + البداية + س] > الطول) { الطول := (*الدخول)[الأساس + البداية + س]; };
                إذا ((*الواردة)[البداية + س] > واردة_الطول) { واردة_الطول := (*الواردة)[البداية + س]; };
                س := س + 1;
            }
            ليكن ر: متغير طبيعي = 1;
            طالما (ر <= واردة_الطول) {
                س := 0;
                طالما (س < عدد_العناصر) {
                    إذا ((*الواردة)[البداية + س] == ر && (*الدخول)[الأساس + البداية + س] == 0) {
                        الطول := الطول + 1;
                        (*الدخول)[الأساس + البداية + س] := الطول;
                        تغير := صواب;
                    };
                    س := س + 1;
                }
                ر := ر + 1;
            }
        };
        // Borrows, of the holders live where the block is entered (the
        // others end there).
        إذا ((*الوصف).المالكون[ف] != 0) {
            ليكن حصري_الأساس: متغير طبيعي = بلا_استعارة_مسير();
            ليكن مشترك_الأساس: متغير منطقي = خطأ;
            ليكن حصري_الوارد: متغير طبيعي = بلا_استعارة_مسير();
            ليكن مشترك_الوارد: متغير منطقي = خطأ;
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < العدد) {
                ليكن الخانة: طبيعي = خانة_استعارة_مسير(الوصف, ف, ح);
                إذا (الخانة != بلا_استعارة_مسير() && حي_عند_دخول_استعارة(الوصف, الأساس, ح)) {
                    ليكن القديمة: طبيعي = (*الدخول)[الأساس + الخانة];
                    ليكن الجديدة: طبيعي = (*الواردة)[الخانة];
                    إذا (القديمة == 2) { حصري_الأساس := ح; };
                    إذا (القديمة == 1) { مشترك_الأساس := صواب; };
                    إذا (الجديدة == 2) { حصري_الوارد := ح; };
                    إذا (الجديدة == 1) { مشترك_الوارد := صواب; };
                    إذا (الجديدة > القديمة) { (*الدخول)[الأساس + الخانة] := الجديدة; تغير := صواب; };
                };
                ح := ح + 1;
            }
            ليكن متعارضة: منطقي =
                (حصري_الأساس != بلا_استعارة_مسير() && (مشترك_الوارد
                    || (حصري_الوارد != بلا_استعارة_مسير() && حصري_الوارد != حصري_الأساس)))
                || (حصري_الوارد != بلا_استعارة_مسير() && مشترك_الأساس);
            إذا (متعارضة && (*الدخول)[الأساس + ت] == 0) { (*الدخول)[الأساس + ت] := 1; تغير := صواب; };
        };
        ف := ف + 1;
    }
    أرجع تغير;
}

// Whether followed local ح is live where the block whose entry state starts
// at الأساس is entered (always, without liveness).
عرف حي_عند_دخول_استعارة(الوصف: &وصف_استعارات_مسير, الأساس: طبيعي, ح: طبيعي): منطقي {
    ليكن العدد: طبيعي = الطول((*الوصف).الرموز) مثل طبيعي;
    إذا ((*الوصف).العرض == 0 || العدد == 0) { أرجع صواب; };
    ليكن الموضع: طبيعي = ((الأساس / (*الوصف).العرض) * العدد) + ح;
    إذا (الموضع >= (الطول((*الوصف).حية_الدخول) مثل طبيعي)) { أرجع صواب; };
    أرجع (*الوصف).حية_الدخول[الموضع];
}

// The first local of الحالة whose borrows a join could not merge.
عام عرف دمج_مرفوض_استعارات_مسير(الوصف: &وصف_استعارات_مسير, الحالة: &متجه طبيعي): اختياري معرف_رمز {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        إذا (قيمة_خانة_استعارة(الحالة, خانة_تعارض_استعارة(ف)) != 0) { أرجع اختياري.موجود(رمز_محلي_استعارة(الوصف, ف)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The same at the entry of block الكتلة among the entry states الدخول.
عام عرف دمج_مرفوض_استعارات_عند_مسير(
    الوصف: &وصف_استعارات_مسير,
    الدخول: &متجه طبيعي,
    الكتلة: طبيعي
): اختياري معرف_رمز {
    إذا ((*الوصف).العرض == 0) { أرجع اختياري.لا_شيء(); };
    ليكن الأساس: طبيعي = الكتلة * (*الوصف).العرض;
    إذا (الأساس + (*الوصف).العرض > (الطول(*الدخول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        إذا ((*الدخول)[الأساس + خانة_تعارض_استعارة(ف)] != 0) { أرجع اختياري.موجود(رمز_محلي_استعارة(الوصف, ف)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The followed local of Symbol الرمز, if any.
عام عرف محلي_رمز_استعارة_مسير(الوصف: &وصف_استعارات_مسير, الرمز: ط32): طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوصف).الرموز) مثل طبيعي)) {
        إذا ((*الوصف).الرموز[ف] == الرمز) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع بلا_استعارة_مسير();
}

عرف أضف_محلي_استعارة(الرموز: &متغير متجه ط32, الرمز: ط32): طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        إذا ((*الرموز)[ف] == الرمز) { أرجع ف; };
        ف := ف + 1;
    }
    ألحق(*الرموز, الرمز);
    أرجع (الطول(*الرموز) مثل طبيعي) - 1;
}

// The element of origin kind الصنف (1, 2, 3) of local ف, exclusive or not.
عرف عنصر_استعارة(
    الوصف: &متغير وصف_استعارات_مسير,
    الصنف: ط32,
    ف: طبيعي,
    حصرية: منطقي,
    يحمل: منطقي
): طبيعي {
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < (الطول((*الوصف).أصناف_العناصر) مثل طبيعي)) {
        إذا ((*الوصف).أصناف_العناصر[ع] == الصنف && (*الوصف).محليات_العناصر[ع] == ف
            && (*الوصف).حصرية_العناصر[ع] == حصرية) {
            أرجع ع;
        };
        ع := ع + 1;
    }
    ألحق((*الوصف).أصناف_العناصر, الصنف);
    ألحق((*الوصف).محليات_العناصر, ف);
    ألحق((*الوصف).حصرية_العناصر, حصرية);
    ألحق((*الوصف).حاملة_العناصر, يحمل);
    أرجع (الطول((*الوصف).أصناف_العناصر) مثل طبيعي) - 1;
}

// The description of the borrow state of a function with الأحداث (its
// events by block, positions in order) and the MSIR declarations of the
// followed locals (التصريحات: triples block, position, Symbol, in block and
// position order).
عام عرف ابن_وصف_استعارات_مسير(
    الأحداث: &متجه حدث_استعارة_مسير,
    التصريحات: &متجه طبيعي,
    عدد_الكتل: طبيعي
): وصف_استعارات_مسير {
    ليكن الوصف: متغير وصف_استعارات_مسير = وصف_استعارات_فارغ_مسير();
    // The followed locals: every local an event names.
    ليكن الرموز: متغير متجه ط32 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأحداث) مثل طبيعي)) {
        ليكن الحدث: &حدث_استعارة_مسير = &(*الأحداث)[ف];
        ليكن الصنف: ط32 = (*الحدث).الصنف;
        // An assignment of no origins to a local nothing else names, and an
        // escape of one, are decided without following it.
        ليكن يتبع: متغير منطقي = (الصنف == صنف_استعارة_إسناد_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 32))
            || الصنف == صنف_استعارة_تصريح_مسير() || الصنف == صنف_استعارة_عرض_مسير();
        إذا (الصنف == صنف_استعارة_نقل_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 1)
            && !بت_استعارة_مسير((*الحدث).الأعلام, 4)) {
            يتبع := صواب;
        };
        إذا (الصنف == صنف_استعارة_إسناد_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 1)) { يتبع := خطأ; };
        إذا (يتبع && (*الحدث).الرمز != 0xFFFFFFFF) { ليكن م: طبيعي = أضف_محلي_استعارة(&متغير الرموز, (*الحدث).الرمز); };
        إذا (الصنف == صنف_استعارة_عرض_مسير() && (*الحدث).الثاني != 0xFFFFFFFF) {
            ليكن م: طبيعي = أضف_محلي_استعارة(&متغير الرموز, (*الحدث).الثاني);
        };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*الحدث).الحدود) مثل طبيعي)) {
            إذا ((*الحدث).الحدود[ح].الصنف != 0) {
                ليكن م: طبيعي = أضف_محلي_استعارة(&متغير الرموز, (*الحدث).الحدود[ح].الرمز);
            };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    ليكن العدد: طبيعي = الطول(الرموز) مثل طبيعي;
    ليكن الأهداف: متغير متجه طبيعي = [];
    ليكن المالكون: متغير متجه طبيعي = [];
    ليكن الحوامل: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(الأهداف, 0); ألحق(المالكون, 0); ألحق(الحوامل, 0); ف := ف + 1; }
    الوصف.الرموز := الرموز;
    ليكن الثابتة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(الثابتة, 0); ف := ف + 1; }
    ليكن ساكنة: متغير منطقي = صواب;
    // Targets (given origins), owners (borrowed), holders (holding a
    // borrow), and the origin elements.
    ف := 0;
    طالما (ف < (الطول(*الأحداث) مثل طبيعي)) {
        ليكن الحدث: &حدث_استعارة_مسير = &(*الأحداث)[ف];
        ليكن الصنف: ط32 = (*الحدث).الصنف;
        ليكن المحلي: طبيعي = محلي_رمز_استعارة_مسير(&الوصف, (*الحدث).الرمز);
        إذا (المحلي != بلا_استعارة_مسير()) {
            // A parameter's own origin alone never changes.
            ليكن أصل_ثابت: منطقي = الصنف == صنف_استعارة_تصريح_مسير()
                && (الطول((*الحدث).الحدود) مثل طبيعي) == 1
                && (*الحدث).الحدود[0].الصنف == 3 && (*الحدث).الحدود[0].الرمز == (*الحدث).الرمز;
            إذا (أصل_ثابت) {
                الثابتة[المحلي] := 1;
            } وإلا إذا ((الصنف == صنف_استعارة_إسناد_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 32))
                || الصنف == صنف_استعارة_تصريح_مسير()) {
                الأهداف[المحلي] := 1;
            };
            إذا ((الصنف == صنف_استعارة_إسناد_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 2)
                    && بت_استعارة_مسير((*الحدث).الأعلام, 32))
                || الصنف == صنف_استعارة_عرض_مسير()) {
                الحوامل[المحلي] := 1;
            };
            إذا (الصنف == صنف_استعارة_نقل_مسير() && بت_استعارة_مسير((*الحدث).الأعلام, 1)
                && !بت_استعارة_مسير((*الحدث).الأعلام, 4)) {
                ساكنة := خطأ;
            };
        };
        إذا (الصنف == صنف_استعارة_عرض_مسير() && (*الحدث).الثاني != 0xFFFFFFFF) {
            المالكون[محلي_رمز_استعارة_مسير(&الوصف, (*الحدث).الثاني)] := 1;
        };
        ليكن ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*الحدث).الحدود) مثل طبيعي)) {
            ليكن الحد: &حد_أصل_مسير = &(*الحدث).الحدود[ح];
            إذا ((*الحد).الصنف == 1 || (*الحد).الصنف == 2) {
                المالكون[محلي_رمز_استعارة_مسير(&الوصف, (*الحد).الرمز)] := 1;
            };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    ليكن عدد_الأهداف: متغير طبيعي = 0;
    ليكن عدد_المالكين: متغير طبيعي = 0;
    ليكن عدد_الحوامل: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < العدد) {
        إذا (الأهداف[ف] != 0) { عدد_الأهداف := عدد_الأهداف + 1; الأهداف[ف] := عدد_الأهداف; };
        إذا (المالكون[ف] != 0) { عدد_المالكين := عدد_المالكين + 1; المالكون[ف] := عدد_المالكين; };
        إذا (الحوامل[ف] != 0) { عدد_الحوامل := عدد_الحوامل + 1; الحوامل[ف] := عدد_الحوامل; };
        ف := ف + 1;
    }
    الوصف.الأهداف := الأهداف;
    الوصف.المالكون := المالكون;
    الوصف.الحوامل := الحوامل;
    الوصف.عدد_الأهداف := عدد_الأهداف;
    الوصف.عدد_المالكين := عدد_المالكين;
    الوصف.عدد_الحوامل := عدد_الحوامل;
    // The events, decoded, merged with the declarations by position.
    ليكن الكتل: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الكتل) { ليكن فارغة: متجه طبيعي = []; ألحق(الكتل, فارغة); ف := ف + 1; }
    ليكن ح_ص: متغير طبيعي = 0;
    // Events are kept in block order: sort them stably by block then position.
    ليكن المرتبة: متجه طبيعي = رتب_أحداث_استعارة(الأحداث);
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(المرتبة) مثل طبيعي) || ح_ص < (الطول(*التصريحات) مثل طبيعي)) {
        // The next declaration comes first when it is at or before the next
        // event (a declaration applies after its instruction).
        ليكن خذ_تصريحا: متغير منطقي = خطأ;
        إذا (ح_ص < (الطول(*التصريحات) مثل طبيعي)) {
            إذا (ر >= (الطول(المرتبة) مثل طبيعي)) {
                خذ_تصريحا := صواب;
            } وإلا {
                ليكن الحدث: &حدث_استعارة_مسير = &(*الأحداث)[المرتبة[ر]];
                ليكن كتلة_ت: طبيعي = (*التصريحات)[ح_ص];
                ليكن موضع_ت: طبيعي = (*التصريحات)[ح_ص + 1];
                ليكن كتلة_ح: طبيعي = (*الحدث).الكتلة مثل طبيعي;
                ليكن موضع_ح: طبيعي = (*الحدث).الموضع مثل طبيعي;
                خذ_تصريحا := كتلة_ت < كتلة_ح || (كتلة_ت == كتلة_ح && موضع_ت <= موضع_ح);
            };
        };
        إذا (خذ_تصريحا) {
            ليكن المفكك: حدث_مفكك_استعارة = {
                الصنف: 0, الرمز: (*التصريحات)[ح_ص + 2] مثل ط32,
                أ: محلي_رمز_استعارة_مسير(&الوصف, (*التصريحات)[ح_ص + 2] مثل ط32),
                ب: بلا_استعارة_مسير(), الأعلام: 0, النطاق: 0, الحدود: []
            };
            ليكن الكتلة: طبيعي = (*التصريحات)[ح_ص];
            ألحق(الوصف.الأحداث, المفكك);
            ألحق(الوصف.مواضع_الأحداث, (*التصريحات)[ح_ص + 1]);
            إذا (الكتلة < عدد_الكتل) { ألحق(الكتل[الكتلة], (الطول(الوصف.الأحداث) مثل طبيعي) - 1); };
            ح_ص := ح_ص + 3;
        } وإلا {
            ليكن الحدث: &حدث_استعارة_مسير = &(*الأحداث)[المرتبة[ر]];
            ليكن الحدود: متغير متجه طبيعي = [];
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < (الطول((*الحدث).الحدود) مثل طبيعي)) {
                ليكن الحد: &حد_أصل_مسير = &(*الحدث).الحدود[ح];
                ليكن المحلي: طبيعي = محلي_رمز_استعارة_مسير(&الوصف, (*الحد).الرمز);
                ليكن العنصر: متغير طبيعي = بلا_استعارة_مسير();
                إذا (المحلي != بلا_استعارة_مسير()) {
                    إذا ((*الحد).الصنف == 1) {
                        العنصر := عنصر_استعارة(&متغير الوصف, 1, المحلي, بت_استعارة_مسير((*الحد).الأعلام, 1), خطأ);
                    } وإلا إذا ((*الحد).الصنف == 2) {
                        العنصر := عنصر_استعارة(&متغير الوصف, 2, المحلي, خطأ, بت_استعارة_مسير((*الحد).الأعلام, 2));
                    } وإلا إذا ((*الحد).الصنف == 3) {
                        العنصر := عنصر_استعارة(&متغير الوصف, 3, المحلي, خطأ, خطأ);
                    };
                };
                ألحق(الحدود, (*الحد).الصنف مثل طبيعي);
                ألحق(الحدود, المحلي);
                ألحق(الحدود, العنصر);
                ح := ح + 1;
            }
            ليكن رقم_النطاق: متغير طبيعي = 0;
            إذا ((*الحدث).الصنف == صنف_استعارة_كتابة_مسير() || (*الحدث).الصنف == صنف_استعارة_كتابة_مرجع_مسير()
                || (*الحدث).الصنف == صنف_استعارة_نقل_مسير() || (*الحدث).الصنف == صنف_استعارة_تحرير_مسير()
                || (*الحدث).الصنف == صنف_استعارة_التقاط_مسير()
                || (*الحدث).الصنف == صنف_استعارة_نهاية_نطاق_مسير()) {
                ألحق(الوصف.النطاقات, (*الحدث).النطاق);
                رقم_النطاق := الطول(الوصف.النطاقات) مثل طبيعي;
            };
            ليكن الثاني: متغير طبيعي = (*الحدث).الثاني مثل طبيعي;
            إذا ((*الحدث).الصنف == صنف_استعارة_عرض_مسير()) {
                الثاني := بلا_استعارة_مسير();
                إذا ((*الحدث).الثاني != 0xFFFFFFFF) { الثاني := محلي_رمز_استعارة_مسير(&الوصف, (*الحدث).الثاني); };
            };
            ليكن المفكك: حدث_مفكك_استعارة = {
                الصنف: (*الحدث).الصنف, الرمز: (*الحدث).الرمز,
                أ: محلي_رمز_استعارة_مسير(&الوصف, (*الحدث).الرمز),
                ب: الثاني, الأعلام: (*الحدث).الأعلام, النطاق: رقم_النطاق, الحدود: الحدود
            };
            ليكن الكتلة: طبيعي = (*الحدث).الكتلة مثل طبيعي;
            ألحق(الوصف.الأحداث, المفكك);
            ألحق(الوصف.مواضع_الأحداث, (*الحدث).الموضع مثل طبيعي);
            إذا (الكتلة < عدد_الكتل) { ألحق(الكتل[الكتلة], (الطول(الوصف.الأحداث) مثل طبيعي) - 1); };
            ر := ر + 1;
        };
    }
    الوصف.أحداث_الكتل := الكتل;
    // The fixed origins of the parameters that are no target.
    ف := 0;
    طالما (ف < العدد) {
        إذا (الثابتة[ف] != 0 && الوصف.الأهداف[ف] == 0) {
            الثابتة[ف] := عنصر_استعارة(&متغير الوصف, 3, ف, خطأ, خطأ) + 1;
        } وإلا { الثابتة[ف] := 0; };
        ف := ف + 1;
    }
    الوصف.الثابتة := الثابتة;
    الوصف.ساكنة := ساكنة && عدد_الأهداف == 0 && عدد_الحوامل == 0;
    الوصف.العرض := (3 * العدد) + (عدد_الأهداف * عدد_العناصر_استعارة(&الوصف)) + (عدد_المالكين * عدد_الحوامل);
    إذا (الوصف.ساكنة) { الوصف.العرض := 0; };
    أرجع الوصف;
}

// Adds to block الكتلة the events that end the borrows of the holders that
// die there (borrow_liveness.sn): النهايات holds pairs position, followed
// local, in position order. Each comes after the events at its position, so
// a statement's events still find the borrows its last uses held.
عام عرف أدرج_انتهاءات_حوامل_استعارة_مسير(
    الوصف: &متغير وصف_استعارات_مسير,
    الكتلة: طبيعي,
    النهايات: &متجه طبيعي
): فراغ {
    إذا (الكتلة >= (الطول((*الوصف).أحداث_الكتل) مثل طبيعي)) { أرجع; };
    إذا ((الطول(*النهايات) مثل طبيعي) < 2) { أرجع; };
    ليكن القديمة: متغير متجه طبيعي = [];
    بدّل(القديمة, (*الوصف).أحداث_الكتل[الكتلة]);
    ليكن الجديدة: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    ليكن ن: متغير طبيعي = 0;
    طالما (ف < (الطول(القديمة) مثل طبيعي) || (ن + 1) < (الطول(*النهايات) مثل طبيعي)) {
        ليكن نهاية: متغير منطقي = (ن + 1) < (الطول(*النهايات) مثل طبيعي);
        إذا (نهاية && ف < (الطول(القديمة) مثل طبيعي)) {
            نهاية := (*الوصف).مواضع_الأحداث[القديمة[ف]] > (*النهايات)[ن];
        };
        إذا (نهاية) {
            ليكن الموضع: طبيعي = (*النهايات)[ن];
            ليكن الحدود: متغير متجه طبيعي = [];
            طالما ((ن + 1) < (الطول(*النهايات) مثل طبيعي) && (*النهايات)[ن] == الموضع) {
                ألحق(الحدود, 0);
                ألحق(الحدود, (*النهايات)[ن + 1]);
                ألحق(الحدود, بلا_استعارة_مسير());
                ن := ن + 2;
            }
            ليكن المفكك: حدث_مفكك_استعارة = {
                الصنف: صنف_انتهاء_حوامل_استعارة_مسير(), الرمز: 0xFFFFFFFF,
                أ: بلا_استعارة_مسير(), ب: بلا_استعارة_مسير(), الأعلام: 0, النطاق: 0, الحدود: الحدود
            };
            ألحق((*الوصف).الأحداث, المفكك);
            ألحق((*الوصف).مواضع_الأحداث, الموضع);
            ألحق(الجديدة, (الطول((*الوصف).الأحداث) مثل طبيعي) - 1);
        } وإلا {
            ألحق(الجديدة, القديمة[ف]);
            ف := ف + 1;
        };
    }
    بدّل((*الوصف).أحداث_الكتل[الكتلة], الجديدة);
}

// The events by block, then position, then recording order.
عرف رتب_أحداث_استعارة(الأحداث: &متجه حدث_استعارة_مسير): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأحداث) مثل طبيعي)) { ألحق(الناتج, ف); ف := ف + 1; }
    // Insertion sort: events are recorded nearly in order.
    ف := 1;
    طالما (ف < (الطول(الناتج) مثل طبيعي)) {
        ليكن الحالي: طبيعي = الناتج[ف];
        ليكن ي: متغير طبيعي = ف;
        طالما (ي > 0 && حدث_بعد_استعارة(الأحداث, الناتج[ي - 1], الحالي)) {
            الناتج[ي] := الناتج[ي - 1];
            ي := ي - 1;
        }
        الناتج[ي] := الحالي;
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حدث_بعد_استعارة(الأحداث: &متجه حدث_استعارة_مسير, أ: طبيعي, ب: طبيعي): منطقي {
    ليكن س: &حدث_استعارة_مسير = &(*الأحداث)[أ];
    ليكن ص: &حدث_استعارة_مسير = &(*الأحداث)[ب];
    إذا ((*س).الكتلة != (*ص).الكتلة) { أرجع (*س).الكتلة > (*ص).الكتلة; };
    أرجع (*س).الموضع > (*ص).الموضع;
}
