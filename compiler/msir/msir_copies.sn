استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_analysis;
استورد compiler.runtime.primitive_identity;

// Facts about copies of composite values for the native selectors: which
// reads may stand for their source's bytes and which built values may be
// built in the caller's result storage. Derived from verified MSIR only; the
// selector (backend/architectures/x86_64/selector.sn) decides from a value's
// layout whether a copy exists at all.

عرف زد_عدد_نسخ_مسير(المعرف: معرف_قيمة_مسير, الجدول: &متغير متجه طبيعي): فراغ {
    إذا ((المعرف.القيمة مثل طبيعي) < (الطول(*الجدول) مثل طبيعي)) {
        (*الجدول)[المعرف.القيمة] := (*الجدول)[المعرف.القيمة] + 1;
    };
}

// The length and capacity primitives only read their operand.
عرف نداء_قراءة_فقط_نسخ_مسير(النداء: &نداء_مسير): منطقي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
        طابق الهوية مع
        | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
        | هوية_بدائي_مترجم.سعة_متجه -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Whether the operation may write memory that a place holds.
عرف عملية_قد_تكتب_نسخ_مسير(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.تخزين(_) -> { أرجع صواب; }
    | عملية_مسير.نقل_تسلسل_مملوك(_) -> { أرجع صواب; }
    | عملية_مسير.نداء(النداء) -> { أرجع !نداء_قراءة_فقط_نسخ_مسير(&النداء); }
    | _ -> { أرجع خطأ; };
}

// رموز_نسخ_قيم_مسير gives each value ID one of:
// 0  nothing known;
// 1  the value of a load, or of a field, payload or element read, may stand
//    for its source's bytes instead of a copy of its own (the selector
//    aliases it): every use only reads it (a part of it, or all of it into
//    a store, an aggregate, a box, a closure, a call argument or the
//    return; never an edge argument), and those bytes cannot change before
//    the last use. The bytes of a value's own storage never change while a
//    value read from it is live: they are rewritten only when the defining
//    instruction runs again, and every path from there to a later use runs
//    the read again first, since the definition dominates the read and the
//    read the use. A read of a place's or a vector's bytes additionally
//    needs no store or call between it and each use, as
//    تحميلات_للطول_فقط_مسير requires.
// 2  an aggregate, a tagged value or the result of a call of a function
//    whose only use is the function's return: it may be built in (or the
//    callee may return it into) the caller's result storage. A block
//    parameter only returned gets 2 when every jump into its block passes
//    it such a value built in the jumping block, which gets 2 too.
// 3  an aggregate or tagged value whose only use is a member or payload of
//    another built where nothing reads its storage before it is built (the
//    result storage, a value built in place itself, or storage of its own
//    no edge passes on): it is built in place there, and the owner does not
//    copy it.
// 4  a load of a local place whose only uses are one store and whole loads,
//    the store before the load (in its block, or in a dominating one), of a
//    value in storage of its own: the load stands for the stored value,
//    whose bytes do not change, when every use only reads it (as for 1).
// 5  such a place whose every load is forwarded: nothing reads its store.
//    When its one load is returned by the block that builds the stored
//    value, stores and loads it, the stored value gets 2: the load stands
//    for the result storage.
// A value of a scalar Type may get 1 too; the selectors ignore it there.

// Bumps the count of each value the operation reads as a whole value or a
// part of one, in a way an aliased value supports.
عرف عد_قراءات_مقبولة_مسير(العملية: &عملية_مسير, الجدول: &متغير متجه طبيعي): فراغ {
    طابق *العملية مع
    | عملية_مسير.استخراج_حقل(ا) -> { زد_عدد_نسخ_مسير(ا.المصدر, الجدول); }
    | عملية_مسير.استخراج_فهرس(ا) -> { زد_عدد_نسخ_مسير(ا.المصدر, الجدول); }
    | عملية_مسير.استعلام_وسم(ا) -> { زد_عدد_نسخ_مسير(ا.المصدر, الجدول); }
    | عملية_مسير.استخراج_حمولة(ا) -> { زد_عدد_نسخ_مسير(ا.المصدر, الجدول); }
    | عملية_مسير.تخزين(ت) -> { زد_عدد_نسخ_مسير(ت.القيمة, الجدول); }
    | عملية_مسير.بناء_صندوق(ب) -> { زد_عدد_نسخ_مسير(ب.القيمة, الجدول); }
    | عملية_مسير.تجميع(ت) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ت.الأعضاء) مثل طبيعي)) { زد_عدد_نسخ_مسير(ت.الأعضاء[ف], الجدول); ف := ف + 1; }
    }
    | عملية_مسير.بناء_موسوم(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الحمولات) مثل طبيعي)) { زد_عدد_نسخ_مسير(ب.الحمولات[ف], الجدول); ف := ف + 1; }
    }
    | عملية_مسير.بناء_إغلاق(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الالتقاطات) مثل طبيعي)) { زد_عدد_نسخ_مسير(ب.الالتقاطات[ف], الجدول); ف := ف + 1; }
    }
    | عملية_مسير.نداء(النداء) -> {
        إذا (نداء_يقرأ_حججه_نسخا_مسير(&النداء)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(النداء.الحجج) مثل طبيعي)) { زد_عدد_نسخ_مسير(النداء.الحجج[ف], الجدول); ف := ف + 1; }
        } وإلا إذا (نداء_قراءة_فقط_نسخ_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) == 1) {
            زد_عدد_نسخ_مسير(النداء.الحجج[0], الجدول);
        } وإلا إذا (نداء_متجه_بمكانه_نسخ_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) > 0) {
            زد_عدد_نسخ_مسير(النداء.الحجج[0], الجدول);
        };
    }
    | _ -> { };
}

// The same count for one value.
عرف قراءات_مقبولة_في_عملية_مسير(العملية: &عملية_مسير, القيمة: طبيعي): طبيعي {
    دع ن: متغير طبيعي = 0;
    طابق *العملية مع
    | عملية_مسير.استخراج_حقل(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.استخراج_فهرس(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.استعلام_وسم(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.استخراج_حمولة(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.تخزين(ت) -> { إذا ((ت.القيمة.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.بناء_صندوق(ب) -> { إذا ((ب.القيمة.القيمة مثل طبيعي) == القيمة) { ن := 1; }; }
    | عملية_مسير.تجميع(ت) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ت.الأعضاء) مثل طبيعي)) { إذا ((ت.الأعضاء[ف].القيمة مثل طبيعي) == القيمة) { ن := ن + 1; }; ف := ف + 1; }
    }
    | عملية_مسير.بناء_موسوم(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الحمولات) مثل طبيعي)) { إذا ((ب.الحمولات[ف].القيمة مثل طبيعي) == القيمة) { ن := ن + 1; }; ف := ف + 1; }
    }
    | عملية_مسير.بناء_إغلاق(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الالتقاطات) مثل طبيعي)) { إذا ((ب.الالتقاطات[ف].القيمة مثل طبيعي) == القيمة) { ن := ن + 1; }; ف := ف + 1; }
    }
    | عملية_مسير.نداء(النداء) -> {
        إذا (نداء_يقرأ_حججه_نسخا_مسير(&النداء)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(النداء.الحجج) مثل طبيعي)) { إذا ((النداء.الحجج[ف].القيمة مثل طبيعي) == القيمة) { ن := ن + 1; }; ف := ف + 1; }
        } وإلا إذا (نداء_قراءة_فقط_نسخ_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) == 1
            && (النداء.الحجج[0].القيمة مثل طبيعي) == القيمة) {
            ن := 1;
        } وإلا إذا (نداء_متجه_بمكانه_نسخ_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) > 0
            && (النداء.الحجج[0].القيمة مثل طبيعي) == القيمة) {
            ن := 1;
        };
    }
    | _ -> { };
    أرجع ن;
}

// An append, extend or reserve primitive: it changes the vector through
// its place; the native selectors never read its first argument, the
// vector's value.
عرف نداء_متجه_بمكانه_نسخ_مسير(النداء: &نداء_مسير): منطقي {
    طابق (*النداء).مكان_التعديل مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { };
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
        طابق الهوية مع
        | هوية_بدائي_مترجم.إلحاق -> { أرجع صواب; }
        | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { أرجع صواب; }
        | هوية_بدائي_مترجم.حجز_سعة_متجه -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// The element an append copies (its second argument) from the value's
// bytes after the vector may have grown: a use a value in storage of its
// own (never the vector's buffer) supports.
عرف عد_عناصر_إلحاق_نسخ_مسير(العملية: &عملية_مسير, الجدول: &متغير متجه طبيعي): فراغ {
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
            طابق الهوية مع
            | هوية_بدائي_مترجم.إلحاق -> {
                إذا (نداء_متجه_بمكانه_نسخ_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) == 2
                    && النداء.الحجج[1].القيمة != النداء.الحجج[0].القيمة) {
                    زد_عدد_نسخ_مسير(النداء.الحجج[1], الجدول);
                };
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
}

// A call of a function (not a compiler primitive): its arguments are copied
// into the call's argument registers and stack before the callee runs.
عرف نداء_يقرأ_حججه_نسخا_مسير(النداء: &نداء_مسير): منطقي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(_) -> { }
    | هدف_نداء_مسير.دالة_خارجية(_) -> { }
    | هدف_نداء_مسير.قيمة_دالة(الدالة) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
            إذا ((*النداء).الحجج[ف].القيمة == الدالة.القيمة) { أرجع خطأ; };
            ف := ف + 1;
        }
    }
    | هدف_نداء_مسير.بدائي_مترجم(_) -> { أرجع خطأ; };
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    أرجع (الطول((*النداء).نطاقات_الذاكرة) مثل طبيعي) == 0;
}

عرف منهي_يرجع_قيمة_مسير(المنهي: &اختياري منهي_مسير, القيمة: طبيعي): منطقي {
    طابق *المنهي مع
    | اختياري.موجود(الموجود) -> {
        طابق الموجود مع
        | منهي_مسير.إرجاع(المرجعة) -> {
            طابق المرجعة مع
            | اختياري.موجود(المرجع) -> { أرجع (المرجع.القيمة مثل طبيعي) == القيمة; }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع خطأ;
}

// The walk of قراءات_بلا_كتابة_مسير for رموز_نسخ_قيم_مسير: the blocks
// entered only from the value's block (and from each other); a return of
// the value counts as a read. With حساس_للكتابة, no read may follow a store
// or call.
عرف قراءات_مقبولة_بلا_كتابة_مسير(
    الدالة: &دالة_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    القيمة: طبيعي,
    المطلوب: طبيعي,
    الأسلاف: &متجه طبيعي,
    زيارة: &متغير متجه طبيعي,
    الجولة: طبيعي
): منطقي {
    دع الوجدت: متغير طبيعي = 0;
    دع الفحوص: متغير طبيعي = 0;
    دع كتل_العمل: متغير متجه طبيعي = [الكتلة];
    دع بدايات_العمل: متغير متجه طبيعي = [الموضع + 1];
    دع كتابات_العمل: متغير متجه منطقي = [خطأ];
    (*زيارة)[الكتلة] := الجولة;
    طالما ((الطول(كتل_العمل) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(كتل_العمل) مثل طبيعي) - 1;
        دع ك: طبيعي = كتل_العمل[الأخير];
        دع البداية: طبيعي = بدايات_العمل[الأخير];
        دع كتب: متغير منطقي = كتابات_العمل[الأخير];
        اقتطع(كتل_العمل, الأخير);
        اقتطع(بدايات_العمل, الأخير);
        اقتطع(كتابات_العمل, الأخير);
        دع ت: متغير طبيعي = البداية;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            الفحوص := الفحوص + 1;
            إذا (الفحوص > 256) { أرجع خطأ; };
            دع العملية: &عملية_مسير = &(*الدالة).الكتل[ك].التعليمات[ت].العملية;
            دع ن: طبيعي = قراءات_مقبولة_في_عملية_مسير(العملية, القيمة);
            إذا (ن > 0) {
                إذا (كتب) { أرجع خطأ; };
                الوجدت := الوجدت + ن;
                إذا (الوجدت == المطلوب) { أرجع صواب; };
            };
            إذا (عملية_قد_تكتب_نسخ_مسير(العملية)) { كتب := صواب; };
            ت := ت + 1;
        }
        إذا (منهي_يرجع_قيمة_مسير(&(*الدالة).الكتل[ك].المنهي, القيمة)) {
            إذا (كتب) { أرجع خطأ; };
            الوجدت := الوجدت + 1;
            إذا (الوجدت == المطلوب) { أرجع صواب; };
        };
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            دع س: طبيعي = الخلفاء[خ].القيمة;
            إذا (س < (الطول(*الأسلاف) مثل طبيعي) && (*الأسلاف)[س] == 1 && (*زيارة)[س] != الجولة) {
                (*زيارة)[س] := الجولة;
                ألحق(كتل_العمل, س);
                ألحق(بدايات_العمل, 0);
                ألحق(كتابات_العمل, كتب);
            };
            خ := خ + 1;
        }
    }
    أرجع خطأ;
}

// The copy facts of one function (رموز_نسخ_قيم_مسير), indexed by value ID.
// المصادر: for code 4 the value stored in the place, for code 3 the value
// whose storage holds this one; الفهارس: for code 3 the member or payload
// position there; المنشئات: for code 3 the constructor of a tagged owner.
عام نوع حقائق_نسخ_قيم_مسير = {
    الرموز: متجه طبيعي,
    المصادر: متجه طبيعي,
    الفهارس: متجه طبيعي,
    المنشئات: متجه طبيعي
};

عام عرف حقائق_نسخ_فارغة_مسير(العدد: طبيعي): حقائق_نسخ_قيم_مسير {
    دع الرموز: متغير متجه طبيعي = [];
    دع المصادر: متغير متجه طبيعي = [];
    دع الفهارس: متغير متجه طبيعي = [];
    دع المنشئات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الرموز, 0); ألحق(المصادر, 0); ألحق(الفهارس, 0); ألحق(المنشئات, 0);
        ف := ف + 1;
    }
    دع الحقائق: حقائق_نسخ_قيم_مسير = {
        الرموز: الرموز, المصادر: المصادر, الفهارس: الفهارس, المنشئات: المنشئات
    };
    أرجع الحقائق;
}

// Counts the edge arguments of a terminator per value.
عرف عد_حجج_حواف_نسخ_مسير(المنهي: &اختياري منهي_مسير, الجدول: &متغير متجه طبيعي): فراغ {
    طابق *المنهي مع
    | اختياري.موجود(الموجود) -> {
        دع الحواف: متجه حافة_مسير = حواف_منهي_نسخ_مسير(&الموجود);
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الحواف) مثل طبيعي)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحواف[ح].الحجج) مثل طبيعي)) {
                زد_عدد_نسخ_مسير(الحواف[ح].الحجج[ف], الجدول);
                ف := ف + 1;
            }
            ح := ح + 1;
        }
    }
    | اختياري.لا_شيء -> { };
}

عرف حواف_منهي_نسخ_مسير(المنهي: &منهي_مسير): متجه حافة_مسير {
    دع الحواف: متغير متجه حافة_مسير = [];
    طابق *المنهي مع
    | منهي_مسير.فرع(الحافة) -> { ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الحافة)); }
    | منهي_مسير.فرع_شرطي(_, أ, ب) -> {
        ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&أ));
        ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&ب));
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
            ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الحالات[ف].الحافة));
            ف := ف + 1;
        }
        ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الافتراضي));
    }
    | _ -> { };
    أرجع الحواف;
}

// The value a block's only jump passes to the parameter at الفهرس of
// الهدف, when the block ends in an unconditional jump there (لا_شيء when it
// does not branch to الهدف at all; خطأ in الصالح when it branches there in
// another way).
عرف حجة_قفزة_إلى_مسير(
    المنهي: &اختياري منهي_مسير,
    الهدف: طبيعي,
    الفهرس: طبيعي,
    الصالح: &متغير منطقي
): اختياري طبيعي {
    طابق *المنهي مع
    | اختياري.موجود(الموجود) -> {
        طابق الموجود مع
        | منهي_مسير.فرع(الحافة) -> {
            إذا ((الحافة.الهدف.القيمة مثل طبيعي) == الهدف) {
                إذا (الفهرس < (الطول(الحافة.الحجج) مثل طبيعي)) {
                    أرجع اختياري.موجود(الحافة.الحجج[الفهرس].القيمة);
                };
                *الصالح := خطأ;
            };
        }
        | _ -> {
            دع الحواف: متجه حافة_مسير = حواف_منهي_نسخ_مسير(&الموجود);
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الحواف) مثل طبيعي)) {
                إذا ((الحواف[ح].الهدف.القيمة مثل طبيعي) == الهدف) { *الصالح := خطأ; };
                ح := ح + 1;
            }
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف علم_أعضاء_في_مكانها_مسير(
    الحقائق: &متغير حقائق_نسخ_قيم_مسير,
    الأعضاء: &متجه معرف_قيمة_مسير,
    المالك: طبيعي,
    المنشئ: طبيعي,
    المبنية: &متجه طبيعي,
    الاستخدامات: &متجه طبيعي
): فراغ {
    دع العدد: طبيعي = الطول((*الحقائق).الرموز) مثل طبيعي;
    دع ج: متغير طبيعي = 0;
    طالما (ج < (الطول(*الأعضاء) مثل طبيعي)) {
        دع ع: طبيعي = (*الأعضاء)[ج].القيمة;
        إذا (ع < العدد && ع < (الطول(*المبنية) مثل طبيعي) && ع < (الطول(*الاستخدامات) مثل طبيعي)
            && (*المبنية)[ع] != 0 && (*الاستخدامات)[ع] == 1 && (*الحقائق).الرموز[ع] == 0) {
            (*الحقائق).الرموز[ع] := 3;
            (*الحقائق).المصادر[ع] := المالك;
            (*الحقائق).الفهارس[ع] := ج;
            (*الحقائق).المنشئات[ع] := المنشئ;
        };
        ج := ج + 1;
    }
}

// Whether the block الكتلة returns its parameter القيمة, or reaches the
// block that returns it only through blocks (itself included) that build
// no value (no aggregate, tagged value or function call result: the drops
// of a function's exit), so nothing else is built in the result storage
// between them.
عرف إرجاع_بلا_بناء_مسير(
    الدالة: &دالة_مسير,
    الكتلة: طبيعي,
    القيمة: طبيعي,
    المبنية: &متجه طبيعي
): منطقي {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع المرجعة: متغير طبيعي = عدد_الكتل;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        إذا (منهي_يرجع_قيمة_مسير(&(*الدالة).الكتل[ك].المنهي, القيمة)) { المرجعة := ك; };
        ك := ك + 1;
    }
    إذا (المرجعة == عدد_الكتل) { أرجع خطأ; };
    إذا (المرجعة == الكتلة) { أرجع صواب; };
    دع مزارة: متغير متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(مزارة, خطأ); ك := ك + 1; }
    دع المعلقة: متغير متجه طبيعي = [الكتلة];
    مزارة[الكتلة] := صواب;
    دع العدد: متغير طبيعي = 0;
    طالما ((الطول(المعلقة) مثل طبيعي) > 0) {
        العدد := العدد + 1;
        إذا (العدد > 64) { أرجع خطأ; };
        دع الأخير: طبيعي = (الطول(المعلقة) مثل طبيعي) - 1;
        دع ب: طبيعي = المعلقة[الأخير];
        اقتطع(المعلقة, الأخير);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ب].التعليمات[ت]) مع
            | اختياري.موجود(الناتج) -> {
                دع ن: طبيعي = الناتج.المعرف.القيمة;
                إذا (ن >= (الطول(*المبنية) مثل طبيعي) || (*المبنية)[ن] != 0) { أرجع خطأ; };
                طابق (*الدالة).الكتل[ب].التعليمات[ت].العملية مع
                | عملية_مسير.نداء(_) -> { أرجع خطأ; }
                | عملية_مسير.تجميع(_) -> { أرجع خطأ; }
                | عملية_مسير.بناء_موسوم(_) -> { أرجع خطأ; }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ب]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            دع س: طبيعي = الخلفاء[خ].القيمة;
            إذا (س < عدد_الكتل && س != المرجعة && !مزارة[س]) {
                مزارة[س] := صواب;
                ألحق(المعلقة, س);
            };
            خ := خ + 1;
        }
    }
    أرجع صواب;
}

عام عرف رموز_نسخ_قيم_مسير(الدالة: &دالة_مسير): حقائق_نسخ_قيم_مسير {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع الحقائق: متغير حقائق_نسخ_قيم_مسير = حقائق_نسخ_فارغة_مسير(العدد);
    // 0 unknown, 1 own storage, 2 a place's or vector's bytes, 3 bytes of
    // some value's own storage.
    دع الجذور: متغير متجه طبيعي = [];
    دع المقبولة: متغير متجه طبيعي = [];
    دع المرجعة: متغير متجه طبيعي = [];
    دع حجج_الحواف: متغير متجه طبيعي = [];
    // 1 aggregate or tagged value, 2 call result, 0 anything else.
    دع المبنية: متغير متجه طبيعي = [];
    دع كتل_التعريف: متغير متجه طبيعي = [];
    // Local places stored once: the stored value + 1, the store's block and
    // position, the stores, the whole loads, and the loads forwarded.
    دع المخزنة: متغير متجه طبيعي = [];
    دع كتل_التخزين: متغير متجه طبيعي = [];
    دع مواضع_التخزين: متغير متجه طبيعي = [];
    دع عدد_التخزينات: متغير متجه طبيعي = [];
    دع عدد_التحميلات: متغير متجه طبيعي = [];
    دع المحولة: متغير متجه طبيعي = [];
    دع محلية: متغير متجه منطقي = [];
    دع المحمل_المحول: متغير متجه طبيعي = [];
    // المقبولة with the appended elements, which only a value in storage
    // of its own supports.
    دع المقبولة_للتخزين: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الجذور, 0); ألحق(المقبولة, 0); ألحق(المرجعة, 0); ألحق(حجج_الحواف, 0);
        ألحق(المبنية, 0); ألحق(كتل_التعريف, 0);
        ألحق(المخزنة, 0); ألحق(كتل_التخزين, 0); ألحق(مواضع_التخزين, 0);
        ألحق(عدد_التخزينات, 0); ألحق(عدد_التحميلات, 0); ألحق(المحولة, 0); ألحق(محلية, خطأ);
        ألحق(المحمل_المحول, 0); ألحق(المقبولة_للتخزين, 0);
        ف := ف + 1;
    }
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        إذا (((*الدالة).الكتل[ك].المعرف.القيمة مثل طبيعي) != ك) { أرجع الحقائق; };
        ك := ك + 1;
    }
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, العدد);
    دع الأسلاف: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(الأسلاف, 0); ك := ك + 1; }
    دع أي_مخزنة: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع العملية: &عملية_مسير = &(*الدالة).الكتل[ك].التعليمات[ت].العملية;
            عد_قراءات_مقبولة_مسير(العملية, &متغير المقبولة);
            عد_قراءات_مقبولة_مسير(العملية, &متغير المقبولة_للتخزين);
            عد_عناصر_إلحاق_نسخ_مسير(العملية, &متغير المقبولة_للتخزين);
            طابق *العملية مع
            | عملية_مسير.مكان_محلي(_) -> {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(الناتج) -> {
                    إذا ((الناتج.المعرف.القيمة مثل طبيعي) < العدد) { محلية[الناتج.المعرف.القيمة] := صواب; };
                }
                | اختياري.لا_شيء -> { };
            }
            | عملية_مسير.تخزين(التخزين) -> {
                دع م: طبيعي = التخزين.المكان.القيمة;
                إذا (م < العدد) {
                    عدد_التخزينات[م] := عدد_التخزينات[م] + 1;
                    المخزنة[م] := التخزين.القيمة.القيمة + 1;
                    كتل_التخزين[م] := ك;
                    مواضع_التخزين[م] := ت;
                };
            }
            | عملية_مسير.تحميل(التحميل) -> {
                دع م: طبيعي = التحميل.المكان.القيمة;
                إذا (م < العدد) { عدد_التحميلات[م] := عدد_التحميلات[م] + 1; };
            }
            | _ -> { };
            ت := ت + 1;
        }
        عد_حجج_حواف_نسخ_مسير(&(*الدالة).الكتل[ك].المنهي, &متغير حجج_الحواف);
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.إرجاع(المرجعة_اختياريا) -> {
                طابق المرجعة_اختياريا مع
                | اختياري.موجود(المرجع) -> {
                    زد_عدد_نسخ_مسير(المرجع, &متغير المقبولة);
                    زد_عدد_نسخ_مسير(المرجع, &متغير المقبولة_للتخزين);
                    زد_عدد_نسخ_مسير(المرجع, &متغير المرجعة);
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            إذا ((الخلفاء[خ].القيمة مثل طبيعي) < عدد_الكتل) {
                الأسلاف[الخلفاء[خ].القيمة] := الأسلاف[الخلفاء[خ].القيمة] + 1;
            };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    // A local place whose only uses are one store and whole loads.
    ف := 0;
    طالما (ف < العدد) {
        إذا (!محلية[ف] || عدد_التخزينات[ف] != 1
            || عدد_التخزينات[ف] + عدد_التحميلات[ف] != الاستخدامات[ف]
            || المخزنة[ف] == 0 || المخزنة[ف] > العدد) {
            المخزنة[ف] := 0;
        } وإلا {
            أي_مخزنة := صواب;
        };
        ف := ف + 1;
    }
    دع الهيمنة: متغير تحليل_هيمنة_مسير;
    إذا (أي_مخزنة) {
        الهيمنة := حلل_هيمنة_مسير(الدالة);
    } وإلا {
        دع فارغ_م: متجه منطقي = [];
        دع فارغ_ه: متجه اختياري معرف_كتلة_مسير = [];
        دع فارغ_ب: متجه طبيعي = [];
        دع فارغ_ن: متجه طبيعي = [];
        دع بلا_هيمنة: تحليل_هيمنة_مسير = { قابل_للوصول: فارغ_م, المهيمن_المباشر: فارغ_ه, بداية_هيمنة: فارغ_ب, نهاية_هيمنة: فارغ_ن };
        الهيمنة := بلا_هيمنة;
    };
    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع م: طبيعي = (*الدالة).المعاملات[ف].المعرف.القيمة;
        إذا (م < العدد) { الجذور[م] := 1; };
        ف := ف + 1;
    }
    // Blocks in an order that visits a block's dominators before it: each
    // is taken after an already-taken predecessor.
    دع الترتيب: متغير متجه طبيعي = [];
    دع مأخوذة: متغير متجه منطقي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(مأخوذة, خطأ); ك := ك + 1; }
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        إذا ((المدخل.القيمة مثل طبيعي) < عدد_الكتل) {
            مأخوذة[المدخل.القيمة] := صواب;
            دع المعلقة: متغير متجه طبيعي = [المدخل.القيمة];
            طالما ((الطول(المعلقة) مثل طبيعي) > 0) {
                دع الأخير: طبيعي = (الطول(المعلقة) مثل طبيعي) - 1;
                دع الكتلة: طبيعي = المعلقة[الأخير];
                اقتطع(المعلقة, الأخير);
                ألحق(الترتيب, الكتلة);
                دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[الكتلة]);
                دع خ: متغير طبيعي = 0;
                طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
                    دع س: طبيعي = الخلفاء[خ].القيمة;
                    إذا (س < عدد_الكتل && !مأخوذة[س]) {
                        مأخوذة[س] := صواب;
                        ألحق(المعلقة, س);
                    };
                    خ := خ + 1;
                }
            }
        };
    }
    | اختياري.لا_شيء -> { };
    دع زيارة: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(زيارة, 0); ك := ك + 1; }
    دع جولة: متغير طبيعي = 0;
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الترتيب) مثل طبيعي)) {
        دع ب: طبيعي = الترتيب[ر];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ب].التعليمات[ت]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الناتج) -> {
                دع ق: طبيعي = الناتج.المعرف.القيمة;
                إذا (ق < العدد) {
                    كتل_التعريف[ق] := ب;
                    دع مقروءة_فقط: منطقي = المقبولة[ق] == الاستخدامات[ق];
                    دع مقروءة_من_تخزين: منطقي = المقبولة_للتخزين[ق] == الاستخدامات[ق];
                    // 0 none, 1 own storage, 2 a place's or vector's bytes,
                    // 3 another value's storage.
                    دع المصدر: متغير طبيعي = 0;
                    دع قراءة: متغير منطقي = خطأ;
                    // A load of a place stored once, forwarded from the store.
                    دع محولة_من: متغير طبيعي = 0;
                    طابق (*الدالة).الكتل[ب].التعليمات[ت].العملية مع
                    | عملية_مسير.تحميل(التحميل) -> {
                        قراءة := صواب; المصدر := 2;
                        دع م: طبيعي = التحميل.المكان.القيمة;
                        إذا (م < العدد && المخزنة[م] != 0) {
                            دع ك_ت: طبيعي = كتل_التخزين[م];
                            دع قبله: منطقي = ك_ت == ب && مواضع_التخزين[م] < ت;
                            دع يهيمن: منطقي = ك_ت != ب && كتلة_تهيمن_على(
                                &الهيمنة, (*الدالة).الكتل[ك_ت].المعرف, (*الدالة).الكتل[ب].المعرف
                            );
                            دع المخزن: طبيعي = المخزنة[م] - 1;
                            إذا ((قبله || يهيمن) && (الجذور[المخزن] == 1 || الجذور[المخزن] == 3)) {
                                محولة_من := المخزنة[م];
                            };
                        };
                    }
                    | عملية_مسير.استخراج_فهرس(_) -> { قراءة := صواب; المصدر := 2; }
                    | عملية_مسير.استخراج_حقل(ا) -> {
                        قراءة := صواب;
                        إذا ((ا.المصدر.القيمة مثل طبيعي) < العدد) { المصدر := الجذور[ا.المصدر.القيمة]; };
                    }
                    | عملية_مسير.استخراج_حمولة(ا) -> {
                        قراءة := صواب;
                        إذا ((ا.المصدر.القيمة مثل طبيعي) < العدد) { المصدر := الجذور[ا.المصدر.القيمة]; };
                    }
                    | عملية_مسير.تجميع(_) -> { الجذور[ق] := 1; المبنية[ق] := 1; }
                    | عملية_مسير.بناء_موسوم(_) -> { الجذور[ق] := 1; المبنية[ق] := 1; }
                    | عملية_مسير.استخراج_التقاط(_) -> { الجذور[ق] := 1; }
                    | عملية_مسير.نداء(النداء) -> {
                        طابق النداء.الهدف مع
                        | هدف_نداء_مسير.بدائي_مترجم(_) -> { }
                        | هدف_نداء_مسير.دالة_سلطان(_) -> { الجذور[ق] := 1; المبنية[ق] := 2; }
                        | _ -> { الجذور[ق] := 1; };
                    }
                    | _ -> { };
                    إذا (قراءة) {
                        // A read that is not aliased copies into its own storage.
                        الجذور[ق] := 1;
                        إذا (محولة_من != 0 && مقروءة_من_تخزين) {
                            // The stored value's bytes, which do not change.
                            الحقائق.الرموز[ق] := 4;
                            الحقائق.المصادر[ق] := محولة_من - 1;
                            الجذور[ق] := 3;
                            طابق (*الدالة).الكتل[ب].التعليمات[ت].العملية مع
                            | عملية_مسير.تحميل(التحميل) -> {
                                المحولة[التحميل.المكان.القيمة] := المحولة[التحميل.المكان.القيمة] + 1;
                                المحمل_المحول[التحميل.المكان.القيمة] := ق;
                            }
                            | _ -> { };
                        } وإلا إذا (الاستخدامات[ق] == 0 || (مقروءة_من_تخزين && (المصدر == 1 || المصدر == 3))) {
                            // An unused value, or one read from storage that cannot change.
                            الحقائق.الرموز[ق] := 1;
                            الجذور[ق] := 3;
                        } وإلا إذا (مقروءة_فقط && المصدر == 2) {
                            جولة := جولة + 1;
                            إذا (قراءات_مقبولة_بلا_كتابة_مسير(
                                الدالة, ب, ت, ق, الاستخدامات[ق], &الأسلاف, &متغير زيارة, جولة
                            )) {
                                الحقائق.الرموز[ق] := 1;
                                الجذور[ق] := 2;
                            };
                        };
                    } وإلا إذا (المبنية[ق] != 0 && الاستخدامات[ق] == 1 && المرجعة[ق] == 1
                        && منهي_يرجع_قيمة_مسير(&(*الدالة).الكتل[ب].المنهي, ق)) {
                        // Returned by its own block: no other value built
                        // in the result storage can follow it there.
                        الحقائق.الرموز[ق] := 2;
                    };
                };
            };
            ت := ت + 1;
        }
        ر := ر + 1;
    }
    // 5: a place stored once whose every load is forwarded: the store is
    // never read.
    ف := 0;
    طالما (ف < العدد) {
        إذا (المخزنة[ف] != 0 && المحولة[ف] == عدد_التحميلات[ف]) {
            الحقائق.الرموز[ف] := 5;
            // The stored value is built in the result storage when the one
            // forwarded load is returned by the block that builds, stores
            // and loads it.
            دع المخزن: طبيعي = المخزنة[ف] - 1;
            دع المحمل: طبيعي = المحمل_المحول[ف];
            إذا (عدد_التحميلات[ف] == 1 && المبنية[المخزن] != 0 && الاستخدامات[المخزن] == 1
                && الحقائق.الرموز[المخزن] == 0
                && الاستخدامات[المحمل] == 1 && المرجعة[المحمل] == 1
                && كتل_التعريف[المخزن] == كتل_التخزين[ف] && كتل_التعريف[المحمل] == كتل_التخزين[ف]
                && منهي_يرجع_قيمة_مسير(&(*الدالة).الكتل[كتل_التخزين[ف]].المنهي, المحمل)) {
                الحقائق.الرموز[المخزن] := 2;
            };
        };
        ف := ف + 1;
    }
    // 2 for a block parameter only returned, when every jump into its block
    // passes it a value built just before in the jumping block that nothing
    // else uses: each is built in the result storage.
    ر := 0;
    طالما (ر < (الطول(الترتيب) مثل طبيعي)) {
        دع م: طبيعي = الترتيب[ر];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*الدالة).الكتل[م].المعاملات) مثل طبيعي)) {
            دع ق: طبيعي = (*الدالة).الكتل[م].المعاملات[ح].المعرف.القيمة;
            إذا (ق < العدد && الاستخدامات[ق] == 1 && المرجعة[ق] == 1
                && إرجاع_بلا_بناء_مسير(الدالة, م, ق, &المبنية)) {
                دع الصالح: متغير منطقي = صواب;
                دع الواردة: متغير متجه طبيعي = [];
                دع س: متغير طبيعي = 0;
                طالما (س < عدد_الكتل && الصالح) {
                    طابق حجة_قفزة_إلى_مسير(&(*الدالة).الكتل[س].المنهي, م, ح, &متغير الصالح) مع
                    | اختياري.موجود(أ) -> {
                        إذا (أ < العدد && المبنية[أ] != 0 && الاستخدامات[أ] == 1
                            && حجج_الحواف[أ] == 1 && كتل_التعريف[أ] == س && مأخوذة[س]) {
                            ألحق(الواردة, أ);
                        } وإلا إذا (مأخوذة[س]) {
                            الصالح := خطأ;
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    س := س + 1;
                }
                إذا (الصالح && (الطول(الواردة) مثل طبيعي) > 0) {
                    الحقائق.الرموز[ق] := 2;
                    دع و: متغير طبيعي = 0;
                    طالما (و < (الطول(الواردة) مثل طبيعي)) {
                        الحقائق.الرموز[الواردة[و]] := 2;
                        و := و + 1;
                    }
                };
            };
            ح := ح + 1;
        }
        ر := ر + 1;
    }
    // 3: an aggregate or tagged value whose only use is a member or payload
    // of another one built where nothing reads its storage before it is
    // built (the caller's result storage, or storage of its own that no
    // edge passes on): built in place there. Later blocks and instructions
    // first, so an owner's own code is known before its members'.
    دع رع: متغير طبيعي = الطول(الترتيب) مثل طبيعي;
    طالما (رع > 0) {
        رع := رع - 1;
        دع ب: طبيعي = الترتيب[رع];
        دع تع: متغير طبيعي = الطول((*الدالة).الكتل[ب].التعليمات) مثل طبيعي;
        طالما (تع > 0) {
            تع := تع - 1;
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ب].التعليمات[تع]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الناتج) -> {
                دع و: طبيعي = الناتج.المعرف.القيمة;
                إذا (و < العدد && المبنية[و] == 1) {
                    دع رمز_المالك: طبيعي = الحقائق.الرموز[و];
                    إذا (رمز_المالك == 2 || رمز_المالك == 3 || (رمز_المالك == 0 && حجج_الحواف[و] == 0)) {
                        طابق (*الدالة).الكتل[ب].التعليمات[تع].العملية مع
                        | عملية_مسير.تجميع(ت_) -> {
                            علم_أعضاء_في_مكانها_مسير(&متغير الحقائق, &ت_.الأعضاء, و, 0, &المبنية, &الاستخدامات);
                        }
                        | عملية_مسير.بناء_موسوم(ب_) -> {
                            علم_أعضاء_في_مكانها_مسير(&متغير الحقائق, &ب_.الحمولات, و, ب_.المنشئ, &المبنية, &الاستخدامات);
                        }
                        | _ -> { };
                    };
                };
            };
        }
    }
    أرجع الحقائق;
}

// ---- Hidden-reference arguments ---------------------------------------------
//
// SultanC's internal calling convention passes an aggregate argument larger
// than the target's threshold as a hidden reference (اتفاقية_نداء_واجهة,
// compiler/backend/abi/abi_model.sn): the address of storage holding the
// argument's bytes, which the callee reads in place as its parameter and
// never writes (MSIR values are immutable: a callee that changes its
// parameter stores it into a place of its own first). Passing the address is
// the ABI mechanism; whether the caller may point at the argument's own
// storage or must first copy it into storage made for the call is copy
// elision, decided here.
//
// مخازن_ثابتة_للنداء_مسير says, per value ID, whether the caller may pass
// the address of the bytes the value stands for (no copy). That holds when
// nothing can write those bytes while the callee runs, nor may they be the
// call's result storage:
// (E1) the callee does not write them: the internal convention's contract
//      (نسخة_للمستدعى false); the callee writes only storage it owns (its
//      values' slots, its places, its result storage);
// (E2) the bytes are in the caller's frame and the callee cannot reach
//      them, or are the caller's own parameter, which its caller guaranteed
//      the same way for the caller's whole run. That is the value is
//      - a parameter of the function, or
//      - defined by an instruction that builds or copies it into a slot of
//        its own (an aggregate, a tagged value, a vector, a constant, the
//        result of a call of a function, or a load or a field, payload or
//        element read with copy code 0), or
//      - a forwarded load (code 4) of a stored value that qualifies, or
//      - an aliased field or payload read (code 1) of a value that
//        qualifies, or
//      - an aliased whole load (code 1, no store or call between the load
//        and the call) of a local place, or a field of one, none of whose
//        uses can hand its storage out: every use of the place and of the
//        field places derived from it loads, stores, derives a field or
//        element place, or is a primitive's in-place operand, never a
//        reference (مكان_إلى_مرجع);
// (E3) the bytes are not the call's result storage. The result is built in
//      the result value's own slot, in the caller's result storage (code 2)
//      or in the storage of a value built after the call that no edge passes
//      on (code 3); none of those is a qualifying value's storage, because
//      a block parameter (whose register may alias a value of an earlier
//      iteration) never qualifies.
// Everything else (block parameters, captures, aliased element reads, loads
// through references, boxes, pointers and globals, the results of compiler
// primitives) gets false: the caller copies the bytes into storage of the
// call and passes that address. A copy is a byte copy of the same value:
// ownership, and so every drop, stays the MSIR value's, as with the copy
// the platform conventions make onto the stack.
// Backends without aliased reads (AArch64, LLVM) pass empty copy facts
// (حقائق_نسخ_فارغة_مسير): their loads and reads always copy.
عام عرف مخازن_ثابتة_للنداء_مسير(
    الدالة: &دالة_مسير,
    الحقائق: &حقائق_نسخ_قيم_مسير
): متجه منطقي {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع الثابتة: متغير متجه منطقي = [];
    // 1 copied into storage of its own, 2 a field or payload read of
    // المصدر, 3 a load of the place المصدر, 4 a field place of المصدر,
    // 5 an element read, 0 anything else.
    دع الصنف: متغير متجه طبيعي = [];
    دع المصدر: متغير متجه طبيعي = [];
    // Local places: the root local place + 1 of a place value, the uses of
    // each place that cannot hand its storage out.
    دع الجذور: متغير متجه طبيعي = [];
    دع الآمنة: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الثابتة, خطأ); ألحق(الصنف, 0); ألحق(المصدر, 0); ألحق(الجذور, 0); ألحق(الآمنة, 0);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع م: طبيعي = (*الدالة).المعاملات[ف].المعرف.القيمة;
        إذا (م < العدد) { الثابتة[م] := صواب; };
        ف := ف + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الناتج: متغير طبيعي = العدد;
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(القيمة) -> { الناتج := القيمة.المعرف.القيمة; }
            | اختياري.لا_شيء -> { };
            دع العملية: &عملية_مسير = &(*الدالة).الكتل[ك].التعليمات[ت].العملية;
            دع صنف: متغير طبيعي = 0;
            دع مصدر: متغير طبيعي = 0;
            دع آمن: متغير طبيعي = العدد;
            دع آمن_ثان: متغير طبيعي = العدد;
            طابق *العملية مع
            | عملية_مسير.مكان_محلي(_) -> {
                إذا (الناتج < العدد) { الجذور[الناتج] := الناتج + 1; };
            }
            | عملية_مسير.مكان_حقل(ا) -> { صنف := 4; مصدر := ا.الأصل.القيمة; آمن := ا.الأصل.القيمة; }
            | عملية_مسير.مكان_فهرس(ا) -> { آمن := ا.الأصل.القيمة; }
            | عملية_مسير.تحميل(ا) -> { صنف := 3; مصدر := ا.المكان.القيمة; آمن := ا.المكان.القيمة; }
            | عملية_مسير.تخزين(ا) -> { آمن := ا.المكان.القيمة; }
            | عملية_مسير.تجميع(_) -> { صنف := 1; }
            | عملية_مسير.بناء_موسوم(_) -> { صنف := 1; }
            | عملية_مسير.تهيئة_متجه(_) -> { صنف := 1; }
            | عملية_مسير.ثابت(_) -> { صنف := 1; }
            | عملية_مسير.استخراج_حقل(ا) -> { صنف := 2; مصدر := ا.المصدر.القيمة; }
            | عملية_مسير.استخراج_حمولة(ا) -> { صنف := 2; مصدر := ا.المصدر.القيمة; }
            | عملية_مسير.استخراج_فهرس(_) -> { صنف := 5; }
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.بدائي_مترجم(_) -> { }
                | _ -> { صنف := 1; };
                طابق النداء.مكان_التعديل مع
                | اختياري.موجود(المكان) -> { آمن_ثان := المكان.القيمة; }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            إذا (الناتج < العدد) { الصنف[الناتج] := صنف; المصدر[الناتج] := مصدر; };
            إذا (آمن < العدد) { الآمنة[آمن] := الآمنة[آمن] + 1; };
            إذا (آمن_ثان < العدد) { الآمنة[آمن_ثان] := الآمنة[آمن_ثان] + 1; };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // Field places take their base's root (a base may follow in block order).
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        ف := 0;
        طالما (ف < العدد) {
            إذا (الصنف[ف] == 4 && الجذور[ف] == 0 && المصدر[ف] < العدد && الجذور[المصدر[ف]] != 0) {
                الجذور[ف] := الجذور[المصدر[ف]];
                تغير := صواب;
            };
            ف := ف + 1;
        }
    }
    // A local place escapes when it or a field place of it has another use.
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, العدد);
    دع مفلتة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(مفلتة, خطأ); ف := ف + 1; }
    ف := 0;
    طالما (ف < العدد) {
        إذا (الجذور[ف] != 0 && الاستخدامات[ف] != الآمنة[ف]) { مفلتة[الجذور[ف] - 1] := صواب; };
        ف := ف + 1;
    }
    تغير := صواب;
    طالما (تغير) {
        تغير := خطأ;
        ف := 0;
        طالما (ف < العدد) {
            إذا (!الثابتة[ف]) {
                دع الرمز: متغير طبيعي = 0;
                إذا (ف < (الطول((*الحقائق).الرموز) مثل طبيعي)) { الرمز := (*الحقائق).الرموز[ف]; };
                دع ثابت: متغير منطقي = خطأ;
                إذا (الرمز == 0) {
                    ثابت := الصنف[ف] == 1 || الصنف[ف] == 2 || الصنف[ف] == 3 || الصنف[ف] == 5;
                } وإلا إذا (الرمز == 4) {
                    دع المخزن: طبيعي = (*الحقائق).المصادر[ف];
                    ثابت := المخزن < العدد && الثابتة[المخزن];
                } وإلا إذا (الرمز == 1) {
                    دع م: طبيعي = المصدر[ف];
                    إذا (الصنف[ف] == 2) {
                        ثابت := م < العدد && الثابتة[م];
                    } وإلا إذا (الصنف[ف] == 3) {
                        ثابت := م < العدد && الجذور[م] != 0 && !مفلتة[الجذور[م] - 1];
                    };
                };
                إذا (ثابت) { الثابتة[ف] := صواب; تغير := صواب; };
            };
            ف := ف + 1;
        }
    }
    أرجع الثابتة;
}
