استورد compiler.msir.msir_model;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;

// خط أنابيب التحسين المقنن لـ MSIR. يعمل على التمثيل نفسه ولا ينشئ تمثيلا موازيا.
عام نوع خيارات_تحسين_مسير = {
    مفعل: منطقي
};

عام نوع نتيجة_تحسين_مسير =
    | ناجح بنوع برنامج_مسير
    | مرفوض بنوع متجه خطأ_تحقق_مسير
;

نوع إعادة_ترقيم_قيمة_مسير = {
    القديم: معرف_قيمة_مسير,
    الجديد: معرف_قيمة_مسير
};

نوع إعادة_ترقيم_كتلة_مسير = {
    القديم: معرف_كتلة_مسير,
    الجديد: معرف_كتلة_مسير
};

عرف انسخ_دالة_للتحسين(الدالة: &دالة_مسير): دالة_مسير {
    أرجع *الدالة;
}
عرف انسخ_كتلة_للتحسين(الكتلة: &كتلة_مسير): كتلة_مسير {
    أرجع *الكتلة;
}
عرف انسخ_تعليمة_للتحسين(التعليمة: &تعليمة_مسير): تعليمة_مسير {
    أرجع *التعليمة;
}

عرف ابحث_إعادة_ترقيم_قيمة(
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير,
    القديم: معرف_قيمة_مسير
): معرف_قيمة_مسير {
    دع الحالة: متجه إعادة_ترقيم_قيمة_مسير = *الخريطة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (قيمتا_مسير_متساويتان(الحالة[ف].القديم, القديم)) {
            أرجع الحالة[ف].الجديد;
        };
        ف := ف + 1;
    }
    أرجع القديم;
}

عرف ابحث_إعادة_ترقيم_كتلة(
    الخريطة: &متجه إعادة_ترقيم_كتلة_مسير,
    القديم: معرف_كتلة_مسير
): معرف_كتلة_مسير {
    دع الحالة: متجه إعادة_ترقيم_كتلة_مسير = *الخريطة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (كتلتان_مسير_متساويتان(الحالة[ف].القديم, القديم)) {
            أرجع الحالة[ف].الجديد;
        };
        ف := ف + 1;
    }
    أرجع القديم;
}

عرف أعد_كتابة_حافة_قيم(
    الحافة: حافة_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): حافة_مسير {
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحافة.الحجج) مثل غير_موقع)) {
        ألحق(الحجج, ابحث_إعادة_ترقيم_قيمة(الخريطة, الحافة.الحجج[ف]));
        ف := ف + 1;
    }
    دع الناتج: حافة_مسير = { الهدف: الحافة.الهدف, الحجج: الحجج };
    أرجع الناتج;
}

عرف أعد_كتابة_حافة_كتل(
    الحافة: حافة_مسير,
    الخريطة: &متجه إعادة_ترقيم_كتلة_مسير
): حافة_مسير {
    دع الهدف_الجديد: معرف_كتلة_مسير = ابحث_إعادة_ترقيم_كتلة(الخريطة, الحافة.الهدف);
    دع الناتج: متغير حافة_مسير = الحافة;
    الناتج.الهدف := الهدف_الجديد;
    أرجع الناتج;
}

عرف أعد_كتابة_عملية_قيم(
    العملية: &عملية_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): عملية_مسير {
    دع الحالة: عملية_مسير = *العملية;
    طابق الحالة مع
    | عملية_مسير.ثابت(الثابت) -> {
        أرجع عملية_مسير.ثابت(الثابت);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع اليسار_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, الحساب.اليسار);
        دع اليمين_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, الحساب.اليمين);
        دع الجديد: متغير حساب_صحيح_مسير = الحساب;
        الجديد.اليسار := اليسار_الجديد;
        الجديد.اليمين := اليمين_الجديد;
        أرجع عملية_مسير.حساب_صحيح(الجديد);
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        دع الجديد: حساب_عشري_مسير = {
            العملية: الحساب.العملية,
            اليسار: ابحث_إعادة_ترقيم_قيمة(الخريطة, الحساب.اليسار),
            اليمين: ابحث_إعادة_ترقيم_قيمة(الخريطة, الحساب.اليمين)
        };
        أرجع عملية_مسير.حساب_عشري(الجديد);
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        دع الجديد: مقارنة_عشري_مسير = {
            العملية: المقارنة.العملية,
            اليسار: ابحث_إعادة_ترقيم_قيمة(الخريطة, المقارنة.اليسار),
            اليمين: ابحث_إعادة_ترقيم_قيمة(الخريطة, المقارنة.اليمين)
        };
        أرجع عملية_مسير.مقارنة_عشري(الجديد);
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        دع اليسار_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, المقارنة.اليسار);
        دع اليمين_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, المقارنة.اليمين);
        دع الجديد: متغير مقارنة_صحيح_مسير = المقارنة;
        الجديد.اليسار := اليسار_الجديد;
        الجديد.اليمين := اليمين_الجديد;
        أرجع عملية_مسير.مقارنة_صحيح(الجديد);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        دع المصدر_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, التحويل.المصدر);
        دع الجديد: متغير تحويل_صحيح_مسير = التحويل;
        الجديد.المصدر := المصدر_الجديد;
        أرجع عملية_مسير.تحويل_صحيح(الجديد);
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        دع الجديد: متغير مرجع_إلى_مؤشر_مسير = التحويل;
        الجديد.المرجع := ابحث_إعادة_ترقيم_قيمة(الخريطة, التحويل.المرجع);
        أرجع عملية_مسير.مرجع_إلى_مؤشر(الجديد);
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع الأعضاء: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
            ألحق(الأعضاء, ابحث_إعادة_ترقيم_قيمة(الخريطة, التجميع.الأعضاء[ف]));
            ف := ف + 1;
        }
        دع الجديد: تجميع_مسير = { الأعضاء: الأعضاء };
        أرجع عملية_مسير.تجميع(الجديد);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع العناصر: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(التهيئة.العناصر) مثل غير_موقع)) {
            ألحق(العناصر, ابحث_إعادة_ترقيم_قيمة(الخريطة, التهيئة.العناصر[ف]));
            ف := ف + 1;
        }
        دع الجديد: تهيئة_متجه_مسير = { العناصر: العناصر };
        أرجع عملية_مسير.تهيئة_متجه(الجديد);
    }
    | عملية_مسير.استخراج_حقل(الاستخراج) -> {
        دع الجديد: متغير استخراج_حقل_مسير = الاستخراج;
        الجديد.المصدر := ابحث_إعادة_ترقيم_قيمة(الخريطة, الاستخراج.المصدر);
        أرجع عملية_مسير.استخراج_حقل(الجديد);
    }
    | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
        دع الجديد: متغير استخراج_فهرس_مسير = الاستخراج;
        الجديد.المصدر := ابحث_إعادة_ترقيم_قيمة(الخريطة, الاستخراج.المصدر);
        الجديد.الفهرس := ابحث_إعادة_ترقيم_قيمة(الخريطة, الاستخراج.الفهرس);
        أرجع عملية_مسير.استخراج_فهرس(الجديد);
    }
    | عملية_مسير.مكان_محلي(المكان) -> {
        أرجع عملية_مسير.مكان_محلي(المكان);
    }
    | عملية_مسير.مرجع_إلى_مكان(المرجع) -> {
        دع الجديد: متغير مرجع_إلى_مكان_مسير = المرجع;
        الجديد.المرجع := ابحث_إعادة_ترقيم_قيمة(الخريطة, المرجع.المرجع);
        أرجع عملية_مسير.مرجع_إلى_مكان(الجديد);
    }
    | عملية_مسير.صندوق_إلى_مكان(الصندوق) -> {
        دع الجديد: متغير صندوق_إلى_مكان_مسير = الصندوق;
        الجديد.الصندوق := ابحث_إعادة_ترقيم_قيمة(الخريطة, الصندوق.الصندوق);
        أرجع عملية_مسير.صندوق_إلى_مكان(الجديد);
    }
    | عملية_مسير.مكان_حقل(المكان) -> {
        دع الجديد: متغير مكان_حقل_مسير = المكان;
        الجديد.الأصل := ابحث_إعادة_ترقيم_قيمة(الخريطة, المكان.الأصل);
        أرجع عملية_مسير.مكان_حقل(الجديد);
    }
    | عملية_مسير.مكان_فهرس(المكان) -> {
        دع الجديد: متغير مكان_فهرس_مسير = المكان;
        الجديد.الأصل := ابحث_إعادة_ترقيم_قيمة(الخريطة, المكان.الأصل);
        الجديد.الفهرس := ابحث_إعادة_ترقيم_قيمة(الخريطة, المكان.الفهرس);
        أرجع عملية_مسير.مكان_فهرس(الجديد);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(الموضع) -> {
        دع الجديد: متغير موضع_تخزين_عنصر_مؤشر_مسير = الموضع;
        الجديد.المؤشر := ابحث_إعادة_ترقيم_قيمة(الخريطة, الموضع.المؤشر);
        الجديد.الفهرس := ابحث_إعادة_ترقيم_قيمة(الخريطة, الموضع.الفهرس);
        أرجع عملية_مسير.موضع_تخزين_عنصر_مؤشر(الجديد);
    }
    | عملية_مسير.تحميل(التحميل) -> {
        دع الجديد: متغير تحميل_مسير = التحميل;
        الجديد.المكان := ابحث_إعادة_ترقيم_قيمة(الخريطة, التحميل.المكان);
        أرجع عملية_مسير.تحميل(الجديد);
    }
    | عملية_مسير.تخزين(التخزين) -> {
        دع الجديد: متغير تخزين_مسير = التخزين;
        الجديد.المكان := ابحث_إعادة_ترقيم_قيمة(الخريطة, التخزين.المكان);
        الجديد.القيمة := ابحث_إعادة_ترقيم_قيمة(الخريطة, التخزين.القيمة);
        أرجع عملية_مسير.تخزين(الجديد);
    }
    | عملية_مسير.مكان_إلى_مرجع(التحويل) -> {
        دع الجديد: متغير مكان_إلى_مرجع_مسير = التحويل;
        الجديد.المكان := ابحث_إعادة_ترقيم_قيمة(الخريطة, التحويل.المكان);
        أرجع عملية_مسير.مكان_إلى_مرجع(الجديد);
    }
    | عملية_مسير.بناء_موسوم(البناء) -> {
        دع الحمولات: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(البناء.الحمولات) مثل غير_موقع)) {
            ألحق(الحمولات, ابحث_إعادة_ترقيم_قيمة(الخريطة, البناء.الحمولات[ف]));
            ف := ف + 1;
        }
        دع الجديد: بناء_موسوم_مسير = { المنشئ: البناء.المنشئ, الحمولات: الحمولات };
        أرجع عملية_مسير.بناء_موسوم(الجديد);
    }
    | عملية_مسير.استعلام_وسم(الاستعلام) -> {
        دع الجديد: متغير استعلام_وسم_مسير = الاستعلام;
        الجديد.المصدر := ابحث_إعادة_ترقيم_قيمة(الخريطة, الاستعلام.المصدر);
        أرجع عملية_مسير.استعلام_وسم(الجديد);
    }
    | عملية_مسير.استخراج_حمولة(الاستخراج) -> {
        دع الجديد: متغير استخراج_حمولة_مسير = الاستخراج;
        الجديد.المصدر := ابحث_إعادة_ترقيم_قيمة(الخريطة, الاستخراج.المصدر);
        أرجع عملية_مسير.استخراج_حمولة(الجديد);
    }
    | عملية_مسير.بناء_صندوق(البناء) -> {
        دع الجديد: متغير بناء_صندوق_مسير = البناء;
        الجديد.القيمة := ابحث_إعادة_ترقيم_قيمة(الخريطة, البناء.القيمة);
        أرجع عملية_مسير.بناء_صندوق(الجديد);
    }
    | عملية_مسير.نداء(النداء) -> {
        دع الحجج: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(النداء.الحجج) مثل غير_موقع)) {
            ألحق(الحجج, ابحث_إعادة_ترقيم_قيمة(الخريطة, النداء.الحجج[ف]));
            ف := ف + 1;
        }
        دع مكان_التعديل: متغير اختيار معرف_قيمة_مسير = اختيار.لا_شيء();
        طابق النداء.مكان_التعديل مع
        | اختيار.بعض(المكان) -> {
            مكان_التعديل := اختيار.بعض(ابحث_إعادة_ترقيم_قيمة(الخريطة, المكان));
        }
        | اختيار.لا_شيء -> { };
        دع الهدف_الجديد: هدف_نداء_مسير = طابق النداء.الهدف مع
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> هدف_نداء_مسير.قيمة_دالة(
            ابحث_إعادة_ترقيم_قيمة(الخريطة, الدالة_القيمة)
        )
        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> هدف_نداء_مسير.دالة_سلطان(الهدف)
        | هدف_نداء_مسير.دالة_خارجية(الهدف) -> هدف_نداء_مسير.دالة_خارجية(الهدف)
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> هدف_نداء_مسير.بدائي_مترجم(البدائي);
        دع الجديد: نداء_مسير = {
            الهدف: الهدف_الجديد,
            الحجج: الحجج,
            مكان_التعديل: مكان_التعديل
        };
        أرجع عملية_مسير.نداء(الجديد);
    };
}

عرف أعد_كتابة_منهي_قيم(
    المنهي: &منهي_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): منهي_مسير {
    دع الحالة: منهي_مسير = *المنهي;
    طابق الحالة مع
    | منهي_مسير.فرع(الحافة) -> {
        أرجع منهي_مسير.فرع(أعد_كتابة_حافة_قيم(الحافة, الخريطة));
    }
    | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
        أرجع منهي_مسير.فرع_شرطي(
            ابحث_إعادة_ترقيم_قيمة(الخريطة, الشرط),
            أعد_كتابة_حافة_قيم(عند_الصواب, الخريطة),
            أعد_كتابة_حافة_قيم(عند_الخطأ, الخريطة)
        );
    }
    | منهي_مسير.إرجاع(القيمة) -> {
        طابق القيمة مع
        | اختيار.بعض(المعرف) -> {
            أرجع منهي_مسير.إرجاع(اختيار.بعض(ابحث_إعادة_ترقيم_قيمة(الخريطة, المعرف)));
        }
        | اختيار.لا_شيء -> {
            أرجع منهي_مسير.إرجاع(اختيار.لا_شيء());
        }
    }
    | منهي_مسير.فخ -> {
        أرجع منهي_مسير.فخ();
    }
}

عرف أعد_كتابة_تعليمة_قيم(
    التعليمة: &تعليمة_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): تعليمة_مسير {
    دع الحالة: متغير تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختيار.بعض(القيمة) -> {
        دع المعرف_الجديد: معرف_قيمة_مسير = ابحث_إعادة_ترقيم_قيمة(الخريطة, القيمة.المعرف);
        دع الجديدة: قيمة_مسير = { المعرف: المعرف_الجديد, النوع: القيمة.النوع };
        الحالة.الناتج := اختيار.بعض(الجديدة);
    }
    | اختيار.لا_شيء -> {
    }
    الحالة.العملية := أعد_كتابة_عملية_قيم(&الحالة.العملية, الخريطة);
    أرجع الحالة;
}

عرف أعد_كتابة_منهي_اختياري_قيم(
    المنهي: &اختيار منهي_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): اختيار منهي_مسير {
    دع الحالة: اختيار منهي_مسير = *المنهي;
    طابق الحالة مع
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(أعد_كتابة_منهي_قيم(&القيمة, الخريطة));
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
}

عرف أعد_تقنين_قيم_دالة(الدالة: &متغير دالة_مسير): منطقي {
    دع الأصل: دالة_مسير = *الدالة;
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع القيم_المقننة: متغير متجه قيمة_مسير = [];
    دع التالي: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل.المعاملات) مثل غير_موقع)) {
        دع الجديد: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الأصل.المعرف, التالي);
        دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: الأصل.المعاملات[ف].المعرف, الجديد: الجديد };
        ألحق(الخريطة, الربط);
        دع القيمة_المقننة: قيمة_مسير = { المعرف: الجديد, النوع: الأصل.المعاملات[ف].النوع };
        ألحق(القيم_المقننة, القيمة_المقننة);
        التالي := التالي + 1;
        ف := ف + 1;
    }
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الأصل.الكتل) مثل غير_موقع)) {
        ف := 0;
        بينما (ف < (الطول(الأصل.الكتل[ك].المعاملات) مثل غير_موقع)) {
            دع الجديد: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الأصل.المعرف, التالي);
            دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: الأصل.الكتل[ك].المعاملات[ف].المعرف, الجديد: الجديد };
            ألحق(الخريطة, الربط);
            دع القيمة_المقننة: قيمة_مسير = {
                المعرف: الجديد,
                النوع: الأصل.الكتل[ك].المعاملات[ف].النوع
            };
            ألحق(القيم_المقننة, القيمة_المقننة);
            التالي := التالي + 1;
            ف := ف + 1;
        }
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الأصل.الكتل[ك].التعليمات) مثل غير_موقع)) {
            طابق الأصل.الكتل[ك].التعليمات[ت].الناتج مع
            | اختيار.بعض(القيمة) -> {
                دع الجديد: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الأصل.المعرف, التالي);
                دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القيمة.المعرف, الجديد: الجديد };
                ألحق(الخريطة, الربط);
                دع القيمة_المقننة: قيمة_مسير = { المعرف: الجديد, النوع: القيمة.النوع };
                ألحق(القيم_المقننة, القيمة_المقننة);
                التالي := التالي + 1;
            }
            | اختيار.لا_شيء -> {
            }
            ت := ت + 1;
        }
        ك := ك + 1;
    }

    دع الحالة: متغير دالة_مسير = الأصل;
    ف := 0;
    بينما (ف < (الطول(الحالة.المعاملات) مثل غير_موقع)) {
        الحالة.المعاملات[ف].المعرف := ابحث_إعادة_ترقيم_قيمة(&الخريطة, الحالة.المعاملات[ف].المعرف);
        ف := ف + 1;
    }
    ك := 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        ف := 0;
        بينما (ف < (الطول(الحالة.الكتل[ك].المعاملات) مثل غير_موقع)) {
            الحالة.الكتل[ك].المعاملات[ف].المعرف := ابحث_إعادة_ترقيم_قيمة(&الخريطة, الحالة.الكتل[ك].المعاملات[ف].المعرف);
            ف := ف + 1;
        }
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل غير_موقع)) {
            الحالة.الكتل[ك].التعليمات[ت] := أعد_كتابة_تعليمة_قيم(
                &الحالة.الكتل[ك].التعليمات[ت], &الخريطة
            );
            ت := ت + 1;
        }
        الحالة.الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(
            &الحالة.الكتل[ك].المنهي, &الخريطة
        );
        ك := ك + 1;
    }
    الحالة.القيم := القيم_المقننة;
    الحالة.القيمة_التالية := التالي;
    *الدالة := الحالة;
    أرجع صواب;
}

عرف أعد_تقنين_كتل_دالة(الدالة: &متغير دالة_مسير): منطقي {
    دع الأصل: دالة_مسير = *الدالة;
    دع الخريطة: متغير متجه إعادة_ترقيم_كتلة_مسير = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الأصل.الكتل) مثل غير_موقع)) {
        دع الجديد: معرف_كتلة_مسير = معرف_كتلة_مسير_من(الأصل.المعرف, ك);
        دع الربط: إعادة_ترقيم_كتلة_مسير = { القديم: الأصل.الكتل[ك].المعرف, الجديد: الجديد };
        ألحق(الخريطة, الربط);
        ك := ك + 1;
    }
    دع الحالة: متغير دالة_مسير = الأصل;
    طابق الحالة.المدخل مع
    | اختيار.بعض(المدخل) -> {
        الحالة.المدخل := اختيار.بعض(ابحث_إعادة_ترقيم_كتلة(&الخريطة, المدخل));
    }
    | اختيار.لا_شيء -> {
    }
    ك := 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        الحالة.الكتل[ك].المعرف := ابحث_إعادة_ترقيم_كتلة(&الخريطة, الحالة.الكتل[ك].المعرف);
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                الحالة.الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(أعد_كتابة_حافة_كتل(الحافة, &الخريطة)));
            }
            | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
                الحالة.الكتل[ك].المنهي := اختيار.بعض(
                    منهي_مسير.فرع_شرطي(
                        الشرط,
                        أعد_كتابة_حافة_كتل(عند_الصواب, &الخريطة),
                        أعد_كتابة_حافة_كتل(عند_الخطأ, &الخريطة)
                    )
                );
            }
            | _ -> {
            }
        }
        | اختيار.لا_شيء -> {
        }
        ك := ك + 1;
    }
    *الدالة := الحالة;
    أرجع صواب;
}

عرف ثابتا_مسير_متساويان(أ: &ثابت_مسير, ب: &ثابت_مسير): منطقي {
    طابق *أ مع
    | ثابت_مسير.منطق(قيمة_أ) -> {
        طابق *ب مع
        | ثابت_مسير.منطق(قيمة_ب) -> {
            أرجع قيمة_أ == قيمة_ب;
        }
        | _ -> {
            أرجع خطأ;
        }
    }
    | ثابت_مسير.صحيح_موقع(قيمة_أ) -> {
        طابق *ب مع
        | ثابت_مسير.صحيح_موقع(قيمة_ب) -> {
            أرجع قيمة_أ == قيمة_ب;
        }
        | _ -> {
            أرجع خطأ;
        }
    }
    | ثابت_مسير.صحيح_غير_موقع(قيمة_أ) -> {
        طابق *ب مع
        | ثابت_مسير.صحيح_غير_موقع(قيمة_ب) -> {
            أرجع قيمة_أ == قيمة_ب;
        }
        | _ -> {
            أرجع خطأ;
        }
    }
    | ثابت_مسير.دالة(دالة_أ) -> {
        طابق *ب مع
        | ثابت_مسير.دالة(دالة_ب) -> { أرجع معرفا_دالة_مسير_متساويان(دالة_أ, دالة_ب); }
        | _ -> { أرجع خطأ; };
    }
    | ثابت_مسير.نص(بايتات_أ) -> {
        طابق *ب مع
        | ثابت_مسير.نص(بايتات_ب) -> {
            لو ((الطول(بايتات_أ) مثل غير_موقع) != (الطول(بايتات_ب) مثل غير_موقع)) {
                أرجع خطأ;
            };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(بايتات_أ) مثل غير_موقع)) {
                لو (بايتات_أ[ف] != بايتات_ب[ف]) {
                    أرجع خطأ;
                };
                ف := ف + 1;
            }
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        }
    };
}

عرف احسب_مقارنة_موقعة(
    العملية: عملية_مقارنة_صحيح,
    أ: عدد,
    ب: عدد
): منطقي {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع أ == ب;
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع أ != ب;
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        أرجع أ < ب;
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        أرجع أ <= ب;
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        أرجع أ > ب;
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        أرجع أ >= ب;
    }
}

عرف احسب_مقارنة_غير_موقعة(
    العملية: عملية_مقارنة_صحيح,
    أ: غير_موقع,
    ب: غير_موقع
): منطقي {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع أ == ب;
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع أ != ب;
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        أرجع أ < ب;
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        أرجع أ <= ب;
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        أرجع أ > ب;
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        أرجع أ >= ب;
    }
}

عرف اطو_مقارنة_ثابتة(
    المقارنة: مقارنة_صحيح_مسير,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير
): اختيار ثابت_مسير {
    طابق *اليسار مع
    | ثابت_مسير.صحيح_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_موقع(ب) -> {
            أرجع اختيار.بعض(ثابت_مسير.منطق(احسب_مقارنة_موقعة(المقارنة.العملية, أ, ب)));
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        }
    }
    | ثابت_مسير.صحيح_غير_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_غير_موقع(ب) -> {
            أرجع اختيار.بعض(ثابت_مسير.منطق(احسب_مقارنة_غير_موقعة(المقارنة.العملية, أ, ب)));
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        }
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    }
}

// عقد MSIR المقنن يجعل تجاوز العرض والقسمة أو الباقي المحظورين فخا.
// لا تطوى القسمة أو الباقي هنا، لذلك يبقى القاسم الصفري وأدنى موقع / -1 وأدنى موقع % -1 فخا.
// الجمع والطرح والضرب يطوي منها فقط ما يثبت أنه هوية لا يمكن أن تتجاوز العرض.
عرف اطو_حساب_ثابت_آمن(
    الحساب: حساب_صحيح_مسير,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير
): اختيار ثابت_مسير {
    طابق *اليسار مع
    | ثابت_مسير.صحيح_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_موقع(ب) -> {
            طابق الحساب.العملية مع
            | عملية_حساب_صحيح.جمع -> {
                لو (أ == 0) {
                    أرجع اختيار.بعض(*اليمين);
                };
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.طرح -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.ضرب -> {
                لو ((أ == 0) || (ب == 0)) {
                    أرجع اختيار.بعض(ثابت_مسير.صحيح_موقع(0));
                };
                لو (أ == 1) {
                    أرجع اختيار.بعض(*اليمين);
                };
                لو (ب == 1) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_يسرى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_يمنى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | _ -> {
            }
        }
        | _ -> {
        }
    }
    | ثابت_مسير.صحيح_غير_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_غير_موقع(ب) -> {
            طابق الحساب.العملية مع
            | عملية_حساب_صحيح.جمع -> {
                لو (أ == 0) {
                    أرجع اختيار.بعض(*اليمين);
                };
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.طرح -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.ضرب -> {
                لو ((أ == 0) || (ب == 0)) {
                    أرجع اختيار.بعض(ثابت_مسير.صحيح_غير_موقع(0));
                };
                لو (أ == 1) {
                    أرجع اختيار.بعض(*اليمين);
                };
                لو (ب == 1) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_يسرى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_يمنى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
                لو (ب == 0) {
                    أرجع اختيار.بعض(*اليسار);
                };
            }
            | _ -> {
            }
        }
        | _ -> {
        }
    }
    | _ -> {
    }
    أرجع اختيار.لا_شيء();
}

عرف سجل_ثابت_تعليمة_مباشر(
    التعليمة: &تعليمة_مسير,
    الجدول: &متغير متجه اختيار ثابت_مسير
): منطقي {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختيار.بعض(القيمة) -> {
        طابق الحالة.العملية مع
        | عملية_مسير.ثابت(الثابت) -> {
            دع الحالة_جدول: متغير متجه اختيار ثابت_مسير = *الجدول;
            الحالة_جدول[القيمة.المعرف.القيمة] := اختيار.بعض(الثابت);
            *الجدول := الحالة_جدول;
            أرجع صواب;
        }
        | _ -> {
        }
    }
    | اختيار.لا_شيء -> {
    }
    أرجع خطأ;
}

عرف أنشئ_جدول_ثوابت_مباشرة(الدالة: &دالة_مسير): متجه اختيار ثابت_مسير {
    دع العدد: غير_موقع = عدد_تعريفات_قيم_مسير(الدالة);
    دع الجدول: متغير متجه اختيار ثابت_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الجدول, اختيار.لا_شيء());
        ف := ف + 1;
    }
    دع الحالة: دالة_مسير = *الدالة;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل غير_موقع)) {
            سجل_ثابت_تعليمة_مباشر(&الحالة.الكتل[ك].التعليمات[ت], &متغير الجدول);
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الجدول;
}

عرف ثابت_معروف_لقيمة(
    الجدول: &متجه اختيار ثابت_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار ثابت_مسير {
    دع الحالة: متجه اختيار ثابت_مسير = *الجدول;
    لو (المعرف.القيمة >= (الطول(الحالة) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المرجع: &اختيار ثابت_مسير = &الحالة[المعرف.القيمة];
    أرجع *المرجع;
}

عرف أضف_حافة_إلى_ثابت_معامل(
    الحافة: &حافة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: غير_موقع,
    الجدول: &متجه اختيار ثابت_مسير,
    وجد: &متغير منطقي,
    صالح: &متغير منطقي,
    المرشح: &متغير اختيار ثابت_مسير
): منطقي {
    دع الحالة: حافة_مسير = *الحافة;
    لو (!كتلتان_مسير_متساويتان(الحالة.الهدف, الهدف)) {
        أرجع صواب;
    };
    لو (الفهرس >= (الطول(الحالة.الحجج) مثل غير_موقع)) {
        *صالح := خطأ;
        أرجع خطأ;
    };
    طابق ثابت_معروف_لقيمة(الجدول, الحالة.الحجج[الفهرس]) مع
    | اختيار.لا_شيء -> {
        *صالح := خطأ;
    }
    | اختيار.بعض(الثابت) -> {
        لو (!*وجد) {
            *وجد := صواب;
            *المرشح := اختيار.بعض(الثابت);
        } وإلا {
            طابق *المرشح مع
            | اختيار.بعض(الموجود) -> {
                لو (!ثابتا_مسير_متساويان(&الموجود, &الثابت)) {
                    *صالح := خطأ;
                };
            }
            | اختيار.لا_شيء -> {
                *صالح := خطأ;
            }
        };
    };
    أرجع *صالح;
}

عرف ثابت_معامل_كتلة_من_الحواف(
    الدالة: &دالة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: غير_موقع,
    الجدول: &متجه اختيار ثابت_مسير
): اختيار ثابت_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع وجد: متغير منطقي = خطأ;
    دع صالح: متغير منطقي = صواب;
    دع المرشح: متغير اختيار ثابت_مسير = اختيار.لا_شيء();
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                أضف_حافة_إلى_ثابت_معامل(&الحافة, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
            }
            | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
                أضف_حافة_إلى_ثابت_معامل(&عند_الصواب, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
                أضف_حافة_إلى_ثابت_معامل(&عند_الخطأ, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
            }
            | _ -> {
            }
        }
        | اختيار.لا_شيء -> {
        }
        ك := ك + 1;
    }
    لو (!وجد || !صالح) {
        أرجع اختيار.لا_شيء();
    };
    أرجع المرشح;
}

عرف أنشئ_جدول_ثوابت_منشورة(الدالة: &دالة_مسير): متجه اختيار ثابت_مسير {
    دع الجدول: متغير متجه اختيار ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(الدالة);
    دع تغير: متغير منطقي = صواب;
    بينما (تغير) {
        تغير := خطأ;
        دع الحالة: دالة_مسير = *الدالة;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الحالة.الكتل[ك].المعاملات) مثل غير_موقع)) {
                دع المعامل: قيمة_مسير = الحالة.الكتل[ك].المعاملات[ف];
                طابق الجدول[المعامل.المعرف.القيمة] مع
                | اختيار.بعض(_) -> {
                }
                | اختيار.لا_شيء -> {
                    طابق ثابت_معامل_كتلة_من_الحواف(&الحالة, الحالة.الكتل[ك].المعرف, ف, &الجدول) مع
                    | اختيار.بعض(الثابت) -> {
                        الجدول[المعامل.المعرف.القيمة] := اختيار.بعض(الثابت);
                        تغير := صواب;
                    }
                    | اختيار.لا_شيء -> {
                    }
                };
                ف := ف + 1;
            }
            ك := ك + 1;
        }
    }
    أرجع الجدول;
}

عرف اطو_تعليمة_من_جدول(
    التعليمة: &تعليمة_مسير,
    الجدول: &متجه اختيار ثابت_مسير
): اختيار ثابت_مسير {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.العملية مع
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق ثابت_معروف_لقيمة(الجدول, المقارنة.اليسار) مع
        | اختيار.بعض(اليسار) -> {
            طابق ثابت_معروف_لقيمة(الجدول, المقارنة.اليمين) مع
            | اختيار.بعض(اليمين) -> {
                أرجع اطو_مقارنة_ثابتة(المقارنة, &اليسار, &اليمين);
            }
            | اختيار.لا_شيء -> {
            }
        }
        | اختيار.لا_شيء -> {
        }
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق ثابت_معروف_لقيمة(الجدول, الحساب.اليسار) مع
        | اختيار.بعض(اليسار) -> {
            طابق ثابت_معروف_لقيمة(الجدول, الحساب.اليمين) مع
            | اختيار.بعض(اليمين) -> {
                أرجع اطو_حساب_ثابت_آمن(الحساب, &اليسار, &اليمين);
            }
            | اختيار.لا_شيء -> {
            }
        }
        | اختيار.لا_شيء -> {
        }
    }
    | _ -> {
    }
    أرجع اختيار.لا_شيء();
}

عرف تعليمة_مطوية_من_جدول(
    التعليمة: &تعليمة_مسير,
    الجدول: &متجه اختيار ثابت_مسير
): اختيار تعليمة_مسير {
    دع الحالة: متغير تعليمة_مسير = *التعليمة;
    طابق اطو_تعليمة_من_جدول(&الحالة, الجدول) مع
    | اختيار.بعض(الثابت) -> {
        الحالة.العملية := عملية_مسير.ثابت(الثابت);
        أرجع اختيار.بعض(الحالة);
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
}

عرف مرر_طي_الثوابت(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الجدول: متغير متجه اختيار ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) {
            دع ت: متغير غير_موقع = 0;
            بينما (ت < (الطول(الحالة.الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) {
                طابق تعليمة_مطوية_من_جدول(
                    &الحالة.الدوال[د].الكتل[ك].التعليمات[ت], &الجدول
                ) مع
                | اختيار.بعض(الجديدة) -> {
                    الحالة.الدوال[د].الكتل[ك].التعليمات[ت] := الجديدة;
                    سجل_ثابت_تعليمة_مباشر(
                        &الحالة.الدوال[د].الكتل[ك].التعليمات[ت], &متغير الجدول
                    );
                    تغير := صواب;
                }
                | اختيار.لا_شيء -> {
                }
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف مرر_نشر_الثوابت(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الجدول: متجه اختيار ثابت_مسير = أنشئ_جدول_ثوابت_منشورة(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) {
            دع ت: متغير غير_موقع = 0;
            بينما (ت < (الطول(الحالة.الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) {
                طابق تعليمة_مطوية_من_جدول(
                    &الحالة.الدوال[د].الكتل[ك].التعليمات[ت], &الجدول
                ) مع
                | اختيار.بعض(الجديدة) -> {
                    الحالة.الدوال[د].الكتل[ك].التعليمات[ت] := الجديدة;
                    تغير := صواب;
                }
                | اختيار.لا_شيء -> {
                }
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف حافتان_متساويتان(أ: &حافة_مسير, ب: &حافة_مسير): منطقي {
    دع حالة_أ: حافة_مسير = *أ;
    دع حالة_ب: حافة_مسير = *ب;
    لو (!كتلتان_مسير_متساويتان(حالة_أ.الهدف, حالة_ب.الهدف)) {
        أرجع خطأ;
    };
    لو ((الطول(حالة_أ.الحجج) مثل غير_موقع) != (الطول(حالة_ب.الحجج) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_أ.الحجج) مثل غير_موقع)) {
        لو (!قيمتا_مسير_متساويتان(حالة_أ.الحجج[ف], حالة_ب.الحجج[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مرر_تبسيط_الفروع_الزائدة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الثوابت: متجه اختيار ثابت_مسير = أنشئ_جدول_ثوابت_منشورة(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) {
            طابق الحالة.الدوال[د].الكتل[ك].المنهي مع
            | اختيار.بعض(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
                لو (حافتان_متساويتان(&عند_الصواب, &عند_الخطأ)) {
                    الحالة.الدوال[د].الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(عند_الصواب));
                    تغير := صواب;
                } وإلا {
                    طابق ثابت_معروف_لقيمة(&الثوابت, الشرط) مع
                    | اختيار.بعض(ثابت_مسير.منطق(الحقيقة)) -> {
                        لو (الحقيقة) {
                            الحالة.الدوال[د].الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(عند_الصواب));
                        } وإلا {
                            الحالة.الدوال[د].الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(عند_الخطأ));
                        };
                        تغير := صواب;
                    }
                    | _ -> {
                    }
                };
            }
            | _ -> {
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف احذف_كتلا_غير_قابلة_للوصول(الدالة: &متغير دالة_مسير): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع المزارة: متجه منطقي = الكتل_القابلة_للوصول_مسير(&الحالة);
    دع الكتل: متغير متجه كتلة_مسير = [];
    دع تغير: متغير منطقي = خطأ;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        لو (المزارة[ك]) {
            ألحق(الكتل, انسخ_كتلة_للتحسين(&الحالة.الكتل[ك]));
        } وإلا {
            تغير := صواب;
        };
        ك := ك + 1;
    }
    لو (تغير) {
        الحالة.الكتل := الكتل;
        أعد_تقنين_كتل_دالة(&متغير الحالة);
        أعد_تقنين_قيم_دالة(&متغير الحالة);
        *الدالة := الحالة;
    };
    أرجع تغير;
}

عرف مرر_حذف_الكتل_غير_القابلة_للوصول(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الدالة: متغير دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
        لو (احذف_كتلا_غير_قابلة_للوصول(&متغير الدالة)) {
            تغير := صواب;
        };
        الحالة.الدوال[د] := الدالة;
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف استبدل_قيمة_في_عملية(
    العملية: &عملية_مسير,
    القديم: معرف_قيمة_مسير,
    الجديد: معرف_قيمة_مسير
): عملية_مسير {
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القديم, الجديد: الجديد };
    ألحق(الخريطة, الربط);
    أرجع أعد_كتابة_عملية_قيم(العملية, &الخريطة);
}

عرف استبدل_استخدامات_قيمة_في_دالة(
    الدالة: &متغير دالة_مسير,
    القديم: معرف_قيمة_مسير,
    الجديد: معرف_قيمة_مسير
): منطقي {
    لو (قيمتا_مسير_متساويتان(القديم, الجديد)) {
        أرجع خطأ;
    };
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القديم, الجديد: الجديد };
    ألحق(الخريطة, الربط);
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل غير_موقع)) {
            الحالة.الكتل[ك].التعليمات[ت].العملية := استبدل_قيمة_في_عملية(
                &الحالة.الكتل[ك].التعليمات[ت].العملية, القديم, الجديد
            );
            ت := ت + 1;
        }
        الحالة.الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(
            &الحالة.الكتل[ك].المنهي, &الخريطة
        );
        ك := ك + 1;
    }
    *الدالة := الحالة;
    أرجع صواب;
}

عرف أضف_حافة_إلى_قيمة_موحدة(
    الحافة: &حافة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: غير_موقع,
    وجد: &متغير منطقي,
    صالح: &متغير منطقي,
    المرشح: &متغير اختيار معرف_قيمة_مسير
): منطقي {
    دع الحالة: حافة_مسير = *الحافة;
    لو (!كتلتان_مسير_متساويتان(الحالة.الهدف, الهدف)) {
        أرجع صواب;
    };
    لو (الفهرس >= (الطول(الحالة.الحجج) مثل غير_موقع)) {
        *صالح := خطأ;
        أرجع خطأ;
    };
    دع القيمة: معرف_قيمة_مسير = الحالة.الحجج[الفهرس];
    لو (!*وجد) {
        *وجد := صواب;
        *المرشح := اختيار.بعض(القيمة);
    } وإلا {
        طابق *المرشح مع
        | اختيار.بعض(الموجود) -> {
            لو (!قيمتا_مسير_متساويتان(الموجود, القيمة)) {
                *صالح := خطأ;
            };
        }
        | اختيار.لا_شيء -> {
            *صالح := خطأ;
        }
    };
    أرجع *صالح;
}

عرف قيمة_موحدة_لمعامل_كتلة(
    الدالة: &دالة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: غير_موقع
): اختيار معرف_قيمة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع وجد: متغير منطقي = خطأ;
    دع صالح: متغير منطقي = صواب;
    دع المرشح: متغير اختيار معرف_قيمة_مسير = اختيار.لا_شيء();
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(منهي_مسير.فرع(الحافة)) -> {
            أضف_حافة_إلى_قيمة_موحدة(&الحافة, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
        }
        | اختيار.بعض(منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ)) -> {
            أضف_حافة_إلى_قيمة_موحدة(&عند_الصواب, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
            أضف_حافة_إلى_قيمة_موحدة(&عند_الخطأ, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    لو (!وجد || !صالح) {
        أرجع اختيار.لا_شيء();
    };
    أرجع المرشح;
}

عرف مرر_نشر_القيم(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع نسخة: دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(نسخة.الكتل) مثل غير_موقع)) {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(نسخة.الكتل[ك].المعاملات) مثل غير_موقع)) {
                دع المعامل: معرف_قيمة_مسير = نسخة.الكتل[ك].المعاملات[ف].المعرف;
                طابق قيمة_موحدة_لمعامل_كتلة(&نسخة, نسخة.الكتل[ك].المعرف, ف) مع
                | اختيار.بعض(القيمة) -> {
                    لو (!قيمتا_مسير_متساويتان(المعامل, القيمة)) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
                        استبدل_استخدامات_قيمة_في_دالة(&متغير الدالة_المعدلة, المعامل, القيمة);
                        الحالة.الدوال[د] := الدالة_المعدلة;
                        تغير := صواب;
                    };
                }
                | اختيار.لا_شيء -> {
                }
                ف := ف + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف نداء_مسير_له_أثر_دلالي(النداء: &نداء_مسير): منطقي {
    دع الحالة: نداء_مسير = *النداء;
    طابق الحالة.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(_) -> {
        // لا يملك MSIR حاليا عقد أثر مقننا للدوال العادية، فتبقى محافظة.
        أرجع صواب;
    }
    | هدف_نداء_مسير.دالة_خارجية(_) -> {
        // لا نفترض نقاء دالة مضيف خارجية بلا عقد أثر صريح.
        أرجع صواب;
    }
    | هدف_نداء_مسير.قيمة_دالة(_) -> {
        أرجع صواب;
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(البدائي);
        طابق العقد.الأثر مع
        | تصنيف_أثر_بدائي.نقي -> {
            أرجع خطأ;
        }
        | _ -> {
            أرجع صواب;
        };
    };
}

عرف عملية_مسير_نقية_آمنة_للحذف(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.مقارنة_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.تحويل_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.نداء(النداء) -> {
        لو (نداء_مسير_له_أثر_دلالي(&النداء)) {
            أرجع خطأ;
        };
        // حتى البدائي المصنف نقيا (طول حاليا) يبقى غير قابل للحذف هنا.
        // خط تحسين النداءات لا يملك بعد إطار قيمة/أثر يثبت سلامة CSE/DCE للنداءات.
        أرجع خطأ;
    }
    | _ -> {
        // حسابات MSIR التي يصفها العقد بأنها قد تفخ لا تحذف حتى إن كان ناتجها ميتا.
        // عمليات الذاكرة تبقى كذلك لأنها قد تحمل أثرا مشاهدا.
        أرجع خطأ;
    };
}

عرف تعليمة_ميتة_قابلة_للحذف(
    التعليمة: &تعليمة_مسير,
    الاستخدامات: &متجه غير_موقع
): منطقي {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(القيمة) -> {
        دع جدول_الاستخدامات: متجه غير_موقع = *الاستخدامات;
        لو (جدول_الاستخدامات[القيمة.المعرف.القيمة] != 0) {
            أرجع خطأ;
        };
        أرجع عملية_مسير_نقية_آمنة_للحذف(&الحالة.العملية);
    };
}

عرف احذف_تعليمة_عند(
    الدالة: &متغير دالة_مسير,
    الكتلة: غير_موقع,
    الفهرس: غير_موقع
): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع التعليمات: متغير متجه تعليمة_مسير = [];
    دع ت: متغير غير_موقع = 0;
    بينما (ت < (الطول(الحالة.الكتل[الكتلة].التعليمات) مثل غير_موقع)) {
        لو (ت != الفهرس) {
            ألحق(التعليمات, انسخ_تعليمة_للتحسين(&الحالة.الكتل[الكتلة].التعليمات[ت]));
        };
        ت := ت + 1;
    }
    الحالة.الكتل[الكتلة].التعليمات := التعليمات;
    أعد_تقنين_قيم_دالة(&متغير الحالة);
    *الدالة := الحالة;
    أرجع صواب;
}

عرف مرر_حذف_الشيفرة_الميتة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير_كلي: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع استمر: متغير منطقي = صواب;
        بينما (استمر) {
            استمر := خطأ;
            دع الاستخدامات: متجه غير_موقع = جدول_استخدامات_قيم_مسير(&الحالة.الدوال[د]);
            دع ك: متغير غير_موقع = 0;
            بينما ((ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) && !استمر) {
                دع ت: متغير غير_موقع = 0;
                بينما ((ت < (الطول(الحالة.الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) && !استمر) {
                    لو (تعليمة_ميتة_قابلة_للحذف(&الحالة.الدوال[د].الكتل[ك].التعليمات[ت], &الاستخدامات)) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
                        احذف_تعليمة_عند(&متغير الدالة_المعدلة, ك, ت);
                        الحالة.الدوال[د] := الدالة_المعدلة;
                        استمر := صواب;
                        تغير_كلي := صواب;
                    };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير_كلي;
}

عرف احذف_حجة_حافة_عند(الحافة: &حافة_مسير, الفهرس: غير_موقع): حافة_مسير {
    دع الحالة_حافة: حافة_مسير = *الحافة;
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة_حافة.الحجج) مثل غير_موقع)) {
        لو (ف != الفهرس) {
            ألحق(الحجج, الحالة_حافة.الحجج[ف]);
        };
        ف := ف + 1;
    }
    دع الناتج: حافة_مسير = { الهدف: الحالة_حافة.الهدف, الحجج: الحجج };
    أرجع الناتج;
}

عرف احذف_معامل_كتلة_عند(
    الدالة: &متغير دالة_مسير,
    الكتلة: غير_موقع,
    الفهرس: غير_موقع
): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع الهدف: معرف_كتلة_مسير = الحالة.الكتل[الكتلة].المعرف;
    دع المعاملات: متغير متجه قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الكتل[الكتلة].المعاملات) مثل غير_موقع)) {
        لو (ف != الفهرس) {
            دع مرجع_المعامل: &قيمة_مسير = &الحالة.الكتل[الكتلة].المعاملات[ف];
            ألحق(المعاملات, *مرجع_المعامل);
        };
        ف := ف + 1;
    }
    الحالة.الكتل[الكتلة].المعاملات := المعاملات;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(منهي_مسير.فرع(الحافة)) -> {
            لو (كتلتان_مسير_متساويتان(الحافة.الهدف, الهدف)) {
                الحالة.الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(احذف_حجة_حافة_عند(&الحافة, الفهرس)));
            };
        }
        | اختيار.بعض(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
            دع يصيب_الصواب: منطقي = كتلتان_مسير_متساويتان(عند_الصواب.الهدف, الهدف);
            دع يصيب_الخطأ: منطقي = كتلتان_مسير_متساويتان(عند_الخطأ.الهدف, الهدف);
            دع صواب_جديد: متغير حافة_مسير = عند_الصواب;
            لو (يصيب_الصواب) {
                صواب_جديد := احذف_حجة_حافة_عند(&صواب_جديد, الفهرس);
            };
            دع خطأ_جديد: متغير حافة_مسير = عند_الخطأ;
            لو (يصيب_الخطأ) {
                خطأ_جديد := احذف_حجة_حافة_عند(&خطأ_جديد, الفهرس);
            };
            الحالة.الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع_شرطي(الشرط, صواب_جديد, خطأ_جديد));
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    أعد_تقنين_قيم_دالة(&متغير الحالة);
    *الدالة := الحالة;
    أرجع صواب;
}

عرف مرر_تبسيط_معاملات_الكتل(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير_كلي: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع استمر: متغير منطقي = صواب;
        بينما (استمر) {
            استمر := خطأ;
            دع الاستخدامات: متجه غير_موقع = جدول_استخدامات_قيم_مسير(&الحالة.الدوال[د]);
            دع ك: متغير غير_موقع = 0;
            بينما ((ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) && !استمر) {
                دع ف: متغير غير_موقع = 0;
                بينما ((ف < (الطول(الحالة.الدوال[د].الكتل[ك].المعاملات) مثل غير_موقع)) && !استمر) {
                    دع المعرف: معرف_قيمة_مسير = الحالة.الدوال[د].الكتل[ك].المعاملات[ف].المعرف;
                    لو (الاستخدامات[المعرف.القيمة] == 0) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
                        احذف_معامل_كتلة_عند(&متغير الدالة_المعدلة, ك, ف);
                        الحالة.الدوال[د] := الدالة_المعدلة;
                        استمر := صواب;
                        تغير_كلي := صواب;
                    };
                    ف := ف + 1;
                }
                ك := ك + 1;
            }
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير_كلي;
}

عرف موضع_معامل_كتلة_لقيمة(
    الكتلة: &كتلة_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار غير_موقع {
    دع الحالة: كتلة_مسير = *الكتلة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المعاملات) مثل غير_موقع)) {
        لو (قيمتا_مسير_متساويتان(الحالة.المعاملات[ف].المعرف, المعرف)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ركب_حافة_تمرير(
    الداخلة: &حافة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    الخارجة: &حافة_مسير
): اختيار حافة_مسير {
    دع حالة_الداخلة: حافة_مسير = *الداخلة;
    دع حالة_الكتلة: كتلة_مسير = *كتلة_التمرير;
    دع حالة_الخارجة: حافة_مسير = *الخارجة;
    لو (!كتلتان_مسير_متساويتان(حالة_الداخلة.الهدف, حالة_الكتلة.المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    لو (
        (الطول(حالة_الداخلة.الحجج) مثل غير_موقع)
        != (الطول(حالة_الكتلة.المعاملات) مثل غير_موقع)
    ) {
        أرجع اختيار.لا_شيء();
    };

    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_الخارجة.الحجج) مثل غير_موقع)) {
        دع الحجة: معرف_قيمة_مسير = حالة_الخارجة.الحجج[ف];
        طابق موضع_معامل_كتلة_لقيمة(&حالة_الكتلة, الحجة) مع
        | اختيار.بعض(الموضع) -> {
            ألحق(الحجج, حالة_الداخلة.الحجج[الموضع]);
        }
        | اختيار.لا_شيء -> {
            ألحق(الحجج, الحجة);
        }
        ف := ف + 1;
    }
    دع الناتج: حافة_مسير = {
        الهدف: حالة_الخارجة.الهدف,
        الحجج: الحجج
    };
    أرجع اختيار.بعض(الناتج);
}

عرف أعد_توجيه_حافة_تمرير(
    الحافة: حافة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): اختيار حافة_مسير {
    دع الحالة: كتلة_مسير = *كتلة_التمرير;
    لو (!كتلتان_مسير_متساويتان(الحافة.الهدف, الحالة.المعرف)) {
        أرجع اختيار.بعض(الحافة);
    };
    أرجع ركب_حافة_تمرير(&الحافة, &الحالة, البديل);
}

عرف عدد_ظهور_قيمة_في_حافة(
    الحافة: &حافة_مسير,
    المعرف: معرف_قيمة_مسير
): غير_موقع {
    دع الحالة: حافة_مسير = *الحافة;
    دع العدد: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحجج) مثل غير_موقع)) {
        لو (قيمتا_مسير_متساويتان(الحالة.الحجج[ف], المعرف)) {
            العدد := العدد + 1;
        };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف معاملات_كتلة_تمرير_مقصورة_على_الحافة(
    الدالة: &دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    الخارجة: &حافة_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع الاستخدامات: متجه غير_موقع = جدول_استخدامات_قيم_مسير(&الحالة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(التمرير.المعاملات) مثل غير_موقع)) {
        دع المعرف: معرف_قيمة_مسير = التمرير.المعاملات[ف].المعرف;
        دع استخدامات_الحافة: غير_موقع = عدد_ظهور_قيمة_في_حافة(
            الخارجة,
            المعرف
        );
        لو (الاستخدامات[المعرف.القيمة] != استخدامات_الحافة) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يمكن_إعادة_توجيه_أسلاف_كتلة_تمرير(
    الدالة: &دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(منهي_مسير.فرع(الحافة)) -> {
            لو (كتلتان_مسير_متساويتان(الحافة.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&الحافة, &التمرير, البديل) مع
                | اختيار.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختيار.بعض(_) -> {
                }
            };
        }
        | اختيار.بعض(منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ)) -> {
            لو (كتلتان_مسير_متساويتان(عند_الصواب.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&عند_الصواب, &التمرير, البديل) مع
                | اختيار.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختيار.بعض(_) -> {
                }
            };
            لو (كتلتان_مسير_متساويتان(عند_الخطأ.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&عند_الخطأ, &التمرير, البديل) مع
                | اختيار.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختيار.بعض(_) -> {
                }
            };
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    أرجع صواب;
}

عرف أعد_توجيه_أسلاف_كتلة_تمرير(
    الدالة: &متغير دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.بعض(منهي_مسير.فرع(الحافة)) -> {
            طابق أعد_توجيه_حافة_تمرير(الحافة, &التمرير, البديل) مع
            | اختيار.بعض(الجديدة) -> {
                الحالة.الكتل[ك].المنهي := اختيار.بعض(منهي_مسير.فرع(الجديدة));
            }
            | اختيار.لا_شيء -> {
                أرجع خطأ;
            }
        }
        | اختيار.بعض(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
            دع الصواب: اختيار حافة_مسير = أعد_توجيه_حافة_تمرير(
                عند_الصواب,
                &التمرير,
                البديل
            );
            دع الخطأ: اختيار حافة_مسير = أعد_توجيه_حافة_تمرير(
                عند_الخطأ,
                &التمرير,
                البديل
            );
            طابق الصواب مع
            | اختيار.بعض(صواب_جديد) -> {
                طابق الخطأ مع
                | اختيار.بعض(خطأ_جديد) -> {
                    الحالة.الكتل[ك].المنهي := اختيار.بعض(
                        منهي_مسير.فرع_شرطي(الشرط, صواب_جديد, خطأ_جديد)
                    );
                }
                | اختيار.لا_شيء -> {
                    أرجع خطأ;
                }
            }
            | اختيار.لا_شيء -> {
                أرجع خطأ;
            }
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    *الدالة := الحالة;
    أرجع صواب;
}

عرف بسط_كتلة_تمرير_واحدة(الدالة: &متغير دالة_مسير): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(&الحالة);
    دع المدخل: اختيار معرف_كتلة_مسير = الحالة.المدخل;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع الكتلة: كتلة_مسير = انسخ_كتلة_للتحسين(&الحالة.الكتل[ك]);
        دع هي_مدخل: متغير منطقي = خطأ;
        طابق المدخل مع
        | اختيار.بعض(المعرف) -> {
            هي_مدخل := كتلتان_مسير_متساويتان(المعرف, الكتلة.المعرف);
        }
        | اختيار.لا_شيء -> {
        }
        لو (
            الوصول[ك]
            && !هي_مدخل
            && ((الطول(الكتلة.التعليمات) مثل غير_موقع) == 0)
        ) {
            طابق الكتلة.المنهي مع
            | اختيار.بعض(منهي_مسير.فرع(البديل)) -> {
                لو (
                    !كتلتان_مسير_متساويتان(البديل.الهدف, الكتلة.المعرف)
                    && معاملات_كتلة_تمرير_مقصورة_على_الحافة(
                        &الحالة,
                        &الكتلة,
                        &البديل
                    )
                    && يمكن_إعادة_توجيه_أسلاف_كتلة_تمرير(
                        &الحالة,
                        &الكتلة,
                        &البديل
                    )
                ) {
                    دع المعدلة: متغير دالة_مسير = الحالة;
                    لو (أعد_توجيه_أسلاف_كتلة_تمرير(
                        &متغير المعدلة,
                        &الكتلة,
                        &البديل
                    )) {
                        *الدالة := المعدلة;
                        احذف_كتلا_غير_قابلة_للوصول(الدالة);
                        أرجع صواب;
                    };
                };
            }
            | _ -> {
            }
        };
        ك := ك + 1;
    }
    أرجع خطأ;
}

عرف أنشئ_خريطة_معاملات_دمج(
    الهدف: &كتلة_مسير,
    الحافة: &حافة_مسير
): اختيار متجه إعادة_ترقيم_قيمة_مسير {
    دع حالة_الهدف: كتلة_مسير = *الهدف;
    دع حالة_الحافة: حافة_مسير = *الحافة;
    لو (
        (الطول(حالة_الهدف.المعاملات) مثل غير_موقع)
        != (الطول(حالة_الحافة.الحجج) مثل غير_موقع)
    ) {
        أرجع اختيار.لا_شيء();
    };
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_الهدف.المعاملات) مثل غير_موقع)) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = {
            القديم: حالة_الهدف.المعاملات[ف].المعرف,
            الجديد: حالة_الحافة.الحجج[ف]
        };
        ألحق(الخريطة, الربط);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الخريطة);
}

عرف ادمج_كتلة_ذات_سلف_واحد(
    الدالة: &متغير دالة_مسير,
    موضع_الهدف: غير_موقع
): منطقي {
    دع الحالة: متغير دالة_مسير = *الدالة;
    لو (موضع_الهدف >= (الطول(الحالة.الكتل) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع الهدف: كتلة_مسير = انسخ_كتلة_للتحسين(&الحالة.الكتل[موضع_الهدف]);
    طابق الحالة.المدخل مع
    | اختيار.بعض(المدخل) -> {
        لو (كتلتان_مسير_متساويتان(المدخل, الهدف.المعرف)) {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
    }

    دع الأسلاف: متجه معرف_كتلة_مسير = أسلاف_كتلة_مسير(&الحالة, الهدف.المعرف);
    لو ((الطول(الأسلاف) مثل غير_موقع) != 1) {
        أرجع خطأ;
    };
    دع السلف: معرف_كتلة_مسير = الأسلاف[0];
    لو (كتلتان_مسير_متساويتان(السلف, الهدف.المعرف)) {
        أرجع خطأ;
    };
    دع موضع_السلف: غير_موقع = السلف.القيمة;
    لو (موضع_السلف >= (الطول(الحالة.الكتل) مثل غير_موقع)) {
        أرجع خطأ;
    };

    دع حافة_الدخول: متغير اختيار حافة_مسير = اختيار.لا_شيء();
    طابق الحالة.الكتل[موضع_السلف].المنهي مع
    | اختيار.بعض(منهي_مسير.فرع(الحافة)) -> {
        لو (كتلتان_مسير_متساويتان(الحافة.الهدف, الهدف.المعرف)) {
            حافة_الدخول := اختيار.بعض(الحافة);
        };
    }
    | _ -> {
    }
    طابق حافة_الدخول مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(الحافة) -> {
        طابق أنشئ_خريطة_معاملات_دمج(&الهدف, &الحافة) مع
        | اختيار.لا_شيء -> {
            أرجع خطأ;
        }
        | اختيار.بعض(الخريطة) -> {
            دع ر: متغير غير_موقع = 0;
            بينما (ر < (الطول(الخريطة) مثل غير_موقع)) {
                استبدل_استخدامات_قيمة_في_دالة(
                    &متغير الحالة,
                    الخريطة[ر].القديم,
                    الخريطة[ر].الجديد
                );
                ر := ر + 1;
            }
            دع الهدف_المحدث: كتلة_مسير =
                انسخ_كتلة_للتحسين(&الحالة.الكتل[موضع_الهدف]);
            دع التعليمات: متغير متجه تعليمة_مسير = [];
            دع ت: متغير غير_موقع = 0;
            بينما (
                ت < (الطول(الحالة.الكتل[موضع_السلف].التعليمات) مثل غير_موقع)
            ) {
                ألحق(
                    التعليمات,
                    انسخ_تعليمة_للتحسين(
                        &الحالة.الكتل[موضع_السلف].التعليمات[ت]
                    )
                );
                ت := ت + 1;
            }
            ت := 0;
            بينما (ت < (الطول(الهدف_المحدث.التعليمات) مثل غير_موقع)) {
                ألحق(
                    التعليمات,
                    انسخ_تعليمة_للتحسين(&الهدف_المحدث.التعليمات[ت])
                );
                ت := ت + 1;
            }
            الحالة.الكتل[موضع_السلف].التعليمات := التعليمات;
            الحالة.الكتل[موضع_السلف].المنهي := أعد_كتابة_منهي_اختياري_قيم(
                &الهدف_المحدث.المنهي,
                &الخريطة
            );
            *الدالة := الحالة;
            احذف_كتلا_غير_قابلة_للوصول(الدالة);
            أرجع صواب;
        }
    };
}

عرف مرر_تبسيط_التدفق(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الدالة_المعدلة: متغير دالة_مسير =
            انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
        لو (بسط_كتلة_تمرير_واحدة(&متغير الدالة_المعدلة)) {
            الحالة.الدوال[د] := الدالة_المعدلة;
            *البرنامج := الحالة;
            أرجع صواب;
        };

        دع الوصول: متجه منطقي =
            الكتل_القابلة_للوصول_مسير(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) {
            لو (الوصول[ك]) {
                دع الدالة_المدمجة: متغير دالة_مسير =
                    انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
                لو (ادمج_كتلة_ذات_سلف_واحد(&متغير الدالة_المدمجة, ك)) {
                    الحالة.الدوال[د] := الدالة_المدمجة;
                    *البرنامج := الحالة;
                    أرجع صواب;
                };
            };
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع خطأ;
}

عرف ثابت_صفر_مسير(الثابت: &ثابت_مسير): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        أرجع القيمة == 0;
    }
    | ثابت_مسير.صحيح_غير_موقع(القيمة) -> {
        أرجع القيمة == 0;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف قيمة_صفر_معروفة(
    الجدول: &متجه اختيار ثابت_مسير,
    المعرف: معرف_قيمة_مسير
): منطقي {
    طابق ثابت_معروف_لقيمة(الجدول, المعرف) مع
    | اختيار.بعض(الثابت) -> {
        أرجع ثابت_صفر_مسير(&الثابت);
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف بديل_جبري_آمن(
    العملية: &عملية_مسير,
    الجدول: &متجه اختيار ثابت_مسير
): اختيار معرف_قيمة_مسير {
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع يسار_صفر: منطقي = قيمة_صفر_معروفة(الجدول, الحساب.اليسار);
        دع يمين_صفر: منطقي = قيمة_صفر_معروفة(الجدول, الحساب.اليمين);
        طابق الحساب.العملية مع
        | عملية_حساب_صحيح.جمع -> {
            لو (يسار_صفر) {
                أرجع اختيار.بعض(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.طرح -> {
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.أو_بتي -> {
            لو (يسار_صفر) {
                أرجع اختيار.بعض(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.أو_حصري -> {
            لو (يسار_صفر) {
                أرجع اختيار.بعض(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_يسرى -> {
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_يمنى -> {
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
            لو (يمين_صفر) {
                أرجع اختيار.بعض(الحساب.اليسار);
            };
        }
        | _ -> {
        };
    }
    | _ -> {
    };
    أرجع اختيار.لا_شيء();
}

عرف مرر_التبسيط_الجبري(البرنامج: &متغير برنامج_مسير): منطقي {
    دع الحالة: متغير برنامج_مسير = *البرنامج;
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع الجدول: متجه اختيار ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(&الحالة.الدوال[د]);
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(الحالة.الدوال[د].الكتل) مثل غير_موقع)) {
            دع ت: متغير غير_موقع = 0;
            بينما (ت < (الطول(الحالة.الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) {
                دع مرجع_التعليمة: &تعليمة_مسير = &الحالة.الدوال[د].الكتل[ك].التعليمات[ت];
                دع التعليمة: تعليمة_مسير = انسخ_تعليمة_للتحسين(مرجع_التعليمة);
                طابق التعليمة.الناتج مع
                | اختيار.بعض(الناتج) -> {
                    طابق بديل_جبري_آمن(&التعليمة.العملية, &الجدول) مع
                    | اختيار.بعض(البديل) -> {
                        لو (!قيمتا_مسير_متساويتان(الناتج.المعرف, البديل)) {
                            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&الحالة.الدوال[د]);
                            استبدل_استخدامات_قيمة_في_دالة(&متغير الدالة_المعدلة, الناتج.المعرف, البديل);
                            الحالة.الدوال[د] := الدالة_المعدلة;
                            تغير := صواب;
                        };
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    *البرنامج := الحالة;
    أرجع تغير;
}

عرف عمليتا_حساب_صحيح_متساويتان(أ: عملية_حساب_صحيح, ب: عملية_حساب_صحيح): منطقي {
    طابق أ مع
    | عملية_حساب_صحيح.جمع -> {
        طابق ب مع
        | عملية_حساب_صحيح.جمع -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.طرح -> {
        طابق ب مع
        | عملية_حساب_صحيح.طرح -> {
            أرجع صواب;
        }
