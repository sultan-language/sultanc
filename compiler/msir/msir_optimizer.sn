استورد compiler.msir.msir_model;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_renumbering;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;

// خط أنابيب التحسين المقنن لـ MSIR. يعمل على التمثيل نفسه ولا ينشئ تمثيلا موازيا.
عام نوع خيارات_تحسين_مسير = {
    مفعل: منطقي
};

عام نوع نتيجة_تحسين_مسير =
    | ناجح بنوع برنامج_مسير
    | مرفوض بنوع متجه خطأ_تحقق_مسير
;

عرف انسخ_دالة_للتحسين(الدالة: &دالة_مسير): دالة_مسير {
    أرجع انسخ_مملوكا_دالة_مسير(الدالة);
}
عرف انسخ_كتلة_للتحسين(الكتلة: &كتلة_مسير): كتلة_مسير {
    أرجع انسخ_مملوكا_كتلة_مسير(الكتلة);
}
عرف انسخ_تعليمة_للتحسين(التعليمة: &تعليمة_مسير): تعليمة_مسير {
    أرجع انسخ_مملوكا_تعليمة_مسير(التعليمة);
}

عرف أكمل_خريطة_إعادة_ترقيم_بعد_استبدال(
    خريطة_التقنين: &متجه إعادة_ترقيم_قيمة_مسير,
    الاستبدالات: &متجه إعادة_ترقيم_قيمة_مسير
): متجه إعادة_ترقيم_قيمة_مسير {
    دع الناتج: متغير متجه إعادة_ترقيم_قيمة_مسير = انسخ_مملوكا_متجه_إعادة_ترقيم_قيمة_مسير(خريطة_التقنين);
    دع الحالة: متجه إعادة_ترقيم_قيمة_مسير = *الاستبدالات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة) مثل طبيعي)) {
        طابق ابحث_إعادة_ترقيم_قيمة_اختيارية(خريطة_التقنين, الحالة[ف].الجديد) مع
        | اختياري.موجود(الجديد) -> {
            دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: الحالة[ف].القديم, الجديد: الجديد };
            ألحق(الناتج, الربط);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أعد_ترقيم_تصحيح_دالة_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    الخريطة: &متجه إعادة_ترقيم_قيمة_مسير
): فراغ {
    دع فهرس_الدالة: طبيعي = الدالة.القيمة;
    لو (فهرس_الدالة >= (الطول((*التصحيح).العقد.متغيرات_القيم) مثل طبيعي)) { أرجع; };

    دع المتغيرات_القديمة: &متجه متجه معرف_متغير_تصحيح = &(*التصحيح).العقد.متغيرات_القيم[فهرس_الدالة];
    دع المواقع_القديمة: &متجه اختياري معرف_موقع_تصحيح = &(*التصحيح).العقد.مواقع_القيم[فهرس_الدالة];
    دع المتغيرات_الجديدة: متغير متجه متجه معرف_متغير_تصحيح = [];
    دع المواقع_الجديدة: متغير متجه اختياري معرف_موقع_تصحيح = [];

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الخريطة) مثل طبيعي)) {
        دع القديم: معرف_قيمة_مسير = (*الخريطة)[ف].القديم;
        دع الجديد: معرف_قيمة_مسير = (*الخريطة)[ف].الجديد;
        لو (دالتا_مسير_متساويتان(القديم.الدالة, الدالة)
            && دالتا_مسير_متساويتان(الجديد.الدالة, الدالة)) {
            طالما ((الطول(المتغيرات_الجديدة) مثل طبيعي) <= الجديد.القيمة) {
                دع فارغة: متجه معرف_متغير_تصحيح = [];
                دع بلا_موقع: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
                ألحق(المتغيرات_الجديدة, فارغة);
                ألحق(المواقع_الجديدة, بلا_موقع);
            }
            لو (القديم.القيمة < (الطول(*المتغيرات_القديمة) مثل طبيعي)) {
                دع متغيرات_المصدر: &متجه معرف_متغير_تصحيح =
                    &(*المتغيرات_القديمة)[القديم.القيمة];
                دع متغيرات_النسخة: متجه معرف_متغير_تصحيح = انسخ_مملوكا_متجه_معرف_متغير_تصحيح(متغيرات_المصدر);
                المتغيرات_الجديدة[الجديد.القيمة] := متغيرات_النسخة;
            };
            لو (القديم.القيمة < (الطول(*المواقع_القديمة) مثل طبيعي)) {
                المواقع_الجديدة[الجديد.القيمة] := (*المواقع_القديمة)[القديم.القيمة];
            };
        };
        ف := ف + 1;
    }

    (*التصحيح).العقد.متغيرات_القيم[فهرس_الدالة] := المتغيرات_الجديدة;
    (*التصحيح).العقد.مواقع_القيم[فهرس_الدالة] := المواقع_الجديدة;
}

عرف احسب_مقارنة_موقعة(
    العملية: عملية_مقارنة_صحيح,
    أ: عدد,
    ب: عدد
): منطقي {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع أ == ب;
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع أ != ب;
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        أرجع أ < ب;
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        أرجع أ <= ب;
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        أرجع أ > ب;
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        أرجع أ >= ب;
    }
}

عرف احسب_مقارنة_طبيعية(
    العملية: عملية_مقارنة_صحيح,
    أ: طبيعي,
    ب: طبيعي
): منطقي {
    طابق العملية مع
    | عملية_مقارنة_صحيح.يساوي -> {
        أرجع أ == ب;
    }
    | عملية_مقارنة_صحيح.لا_يساوي -> {
        أرجع أ != ب;
    }
    | عملية_مقارنة_صحيح.أصغر -> {
        أرجع أ < ب;
    }
    | عملية_مقارنة_صحيح.أصغر_أو_يساوي -> {
        أرجع أ <= ب;
    }
    | عملية_مقارنة_صحيح.أكبر -> {
        أرجع أ > ب;
    }
    | عملية_مقارنة_صحيح.أكبر_أو_يساوي -> {
        أرجع أ >= ب;
    }
}

عرف اطو_مقارنة_ثابتة(
    المقارنة: مقارنة_صحيح_مسير,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير
): اختياري ثابت_مسير {
    طابق *اليسار مع
    | ثابت_مسير.صحيح_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_موقع(ب) -> {
            أرجع اختياري.موجود(ثابت_مسير.منطق(احسب_مقارنة_موقعة(المقارنة.العملية, أ, ب)));
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        }
    }
    | ثابت_مسير.صحيح_طبيعي(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_طبيعي(ب) -> {
            أرجع اختياري.موجود(ثابت_مسير.منطق(احسب_مقارنة_طبيعية(المقارنة.العملية, أ, ب)));
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        }
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    }
}

// عقد MSIR المقنن يجعل تجاوز العرض والقسمة أو الباقي المحظورين فخا.
// لا تطوى القسمة أو الباقي هنا، لذلك يبقى القاسم الصفري وأدنى موقع / -1 وأدنى موقع % -1 فخا.
// الجمع والطرح والضرب يطوي منها فقط ما يثبت أنه هوية لا يمكن أن تتجاوز العرض.
عرف اطو_حساب_ثابت_آمن(
    الحساب: حساب_صحيح_مسير,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير
): اختياري ثابت_مسير {
    طابق *اليسار مع
    | ثابت_مسير.صحيح_موقع(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_موقع(ب) -> {
            طابق الحساب.العملية مع
            | عملية_حساب_صحيح.جمع -> {
                لو (أ == 0) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليمين));
                };
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.طرح -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.ضرب -> {
                لو ((أ == 0) || (ب == 0)) {
                    أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(0));
                };
                لو (أ == 1) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليمين));
                };
                لو (ب == 1) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_يسرى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_يمنى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | _ -> {
            }
        }
        | _ -> {
        }
    }
    | ثابت_مسير.صحيح_طبيعي(أ) -> {
        طابق *اليمين مع
        | ثابت_مسير.صحيح_طبيعي(ب) -> {
            طابق الحساب.العملية مع
            | عملية_حساب_صحيح.جمع -> {
                لو (أ == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليمين));
                };
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.طرح -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.ضرب -> {
                لو ((أ == 0) || (ب == 0)) {
                    أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(0));
                };
                لو (أ == 1) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليمين));
                };
                لو (ب == 1) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_يسرى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_يمنى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
                لو (ب == 0) {
                    أرجع اختياري.موجود(انسخ_ثابت_مسير(اليسار));
                };
            }
            | _ -> {
            }
        }
        | _ -> {
        }
    }
    | _ -> {
    }
    أرجع اختياري.لا_شيء();
}

عرف سجل_ثابت_تعليمة_مباشر(
    التعليمة: &تعليمة_مسير,
    الجدول: &متغير متجه اختياري ثابت_مسير
): منطقي {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختياري.موجود(القيمة) -> {
        طابق الحالة.العملية مع
        | عملية_مسير.ثابت(الثابت) -> {
            (*الجدول)[القيمة.المعرف.القيمة] := اختياري.موجود(انسخ_مملوكا_ثابت_مسير(&الثابت));
            أرجع صواب;
        }
        | _ -> {
        }
    }
    | اختياري.لا_شيء -> {
    }
    أرجع خطأ;
}

عرف أنشئ_جدول_ثوابت_مباشرة(الدالة: &دالة_مسير): متجه اختياري ثابت_مسير {
    دع العدد: طبيعي = عدد_تعريفات_قيم_مسير(الدالة);
    دع الجدول: متغير متجه اختياري ثابت_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الجدول, اختياري.لا_شيء());
        ف := ف + 1;
    }
    دع الحالة: دالة_مسير = *الدالة;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل طبيعي)) {
            سجل_ثابت_تعليمة_مباشر(&الحالة.الكتل[ك].التعليمات[ت], &متغير الجدول);
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الجدول;
}

عرف ثابت_معروف_لقيمة(
    الجدول: &متجه اختياري ثابت_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري ثابت_مسير {
    دع الحالة: متجه اختياري ثابت_مسير = *الجدول;
    لو (المعرف.القيمة >= (الطول(الحالة) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع المرجع: &اختياري ثابت_مسير = &الحالة[المعرف.القيمة];
    أرجع انسخ_مملوكا__اختيار_ثابت_مسير(المرجع);
}

عرف أضف_حافة_إلى_ثابت_معامل(
    الحافة: &حافة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: طبيعي,
    الجدول: &متجه اختياري ثابت_مسير,
    وجد: &متغير منطقي,
    صالح: &متغير منطقي,
    المرشح: &متغير اختياري ثابت_مسير
): منطقي {
    دع الحالة: حافة_مسير = *الحافة;
    لو (!كتلتان_مسير_متساويتان(الحالة.الهدف, الهدف)) {
        أرجع صواب;
    };
    لو (الفهرس >= (الطول(الحالة.الحجج) مثل طبيعي)) {
        *صالح := خطأ;
        أرجع خطأ;
    };
    طابق ثابت_معروف_لقيمة(الجدول, الحالة.الحجج[الفهرس]) مع
    | اختياري.لا_شيء -> {
        *صالح := خطأ;
    }
    | اختياري.موجود(الثابت) -> {
        لو (!*وجد) {
            *وجد := صواب;
            *المرشح := اختياري.موجود(الثابت);
        } وإلا {
            طابق *المرشح مع
            | اختياري.موجود(الموجود) -> {
                لو (!ثابتا_مسير_متساويان(&الموجود, &الثابت)) {
                    *صالح := خطأ;
                };
            }
            | اختياري.لا_شيء -> {
                *صالح := خطأ;
            }
        };
    };
    أرجع *صالح;
}

عرف ثابت_معامل_كتلة_من_الحواف(
    الدالة: &دالة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: طبيعي,
    الجدول: &متجه اختياري ثابت_مسير
): اختياري ثابت_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع وجد: متغير منطقي = خطأ;
    دع صالح: متغير منطقي = صواب;
    دع المرشح: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                أضف_حافة_إلى_ثابت_معامل(&الحافة, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
            }
            | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
                أضف_حافة_إلى_ثابت_معامل(&عند_الصواب, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
                أضف_حافة_إلى_ثابت_معامل(&عند_الخطأ, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
            }
            | منهي_مسير.فرع_متعدد(الفرع) -> {
                أضف_حافة_إلى_ثابت_معامل(&الفرع.الافتراضي, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                    أضف_حافة_إلى_ثابت_معامل(&الفرع.الحالات[ف].الحافة, الهدف, الفهرس, الجدول, &متغير وجد, &متغير صالح, &متغير المرشح);
                    ف := ف + 1;
                }
            }
            | _ -> {
            }
        }
        | اختياري.لا_شيء -> {
        }
        ك := ك + 1;
    }
    لو (!وجد || !صالح) {
        أرجع اختياري.لا_شيء();
    };
    أرجع المرشح;
}

عرف أنشئ_جدول_ثوابت_منشورة(الدالة: &دالة_مسير): متجه اختياري ثابت_مسير {
    دع الجدول: متغير متجه اختياري ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(الدالة);
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع الحالة: دالة_مسير = *الدالة;
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحالة.الكتل[ك].المعاملات) مثل طبيعي)) {
                دع المعامل: قيمة_مسير = الحالة.الكتل[ك].المعاملات[ف];
                طابق الجدول[المعامل.المعرف.القيمة] مع
                | اختياري.موجود(_) -> {
                }
                | اختياري.لا_شيء -> {
                    طابق ثابت_معامل_كتلة_من_الحواف(&الحالة, الحالة.الكتل[ك].المعرف, ف, &الجدول) مع
                    | اختياري.موجود(الثابت) -> {
                        الجدول[المعامل.المعرف.القيمة] := اختياري.موجود(الثابت);
                        تغير := صواب;
                    }
                    | اختياري.لا_شيء -> {
                    }
                };
                ف := ف + 1;
            }
            ك := ك + 1;
        }
    }
    أرجع الجدول;
}

عرف اطو_تعليمة_من_جدول(
    التعليمة: &تعليمة_مسير,
    الجدول: &متجه اختياري ثابت_مسير
): اختياري ثابت_مسير {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.العملية مع
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        طابق ثابت_معروف_لقيمة(الجدول, المقارنة.اليسار) مع
        | اختياري.موجود(اليسار) -> {
            طابق ثابت_معروف_لقيمة(الجدول, المقارنة.اليمين) مع
            | اختياري.موجود(اليمين) -> {
                أرجع اطو_مقارنة_ثابتة(المقارنة, &اليسار, &اليمين);
            }
            | اختياري.لا_شيء -> {
            }
        }
        | اختياري.لا_شيء -> {
        }
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        طابق ثابت_معروف_لقيمة(الجدول, الحساب.اليسار) مع
        | اختياري.موجود(اليسار) -> {
            طابق ثابت_معروف_لقيمة(الجدول, الحساب.اليمين) مع
            | اختياري.موجود(اليمين) -> {
                أرجع اطو_حساب_ثابت_آمن(الحساب, &اليسار, &اليمين);
            }
            | اختياري.لا_شيء -> {
            }
        }
        | اختياري.لا_شيء -> {
        }
    }
    | _ -> {
    }
    أرجع اختياري.لا_شيء();
}

عرف تعليمة_مطوية_من_جدول(
    التعليمة: &تعليمة_مسير,
    الجدول: &متجه اختياري ثابت_مسير
): اختياري تعليمة_مسير {
    دع الحالة: متغير تعليمة_مسير = انسخ_مملوكا_تعليمة_مسير(التعليمة);
    طابق اطو_تعليمة_من_جدول(&الحالة, الجدول) مع
    | اختياري.موجود(الثابت) -> {
        الحالة.العملية := عملية_مسير.ثابت(الثابت);
        أرجع اختياري.موجود(الحالة);
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
}

عرف مرر_طي_الثوابت(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الجدول: متغير متجه اختياري ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق تعليمة_مطوية_من_جدول(
                    &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], &الجدول
                ) مع
                | اختياري.موجود(الجديدة) -> {
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت] := الجديدة;
                    سجل_ثابت_تعليمة_مباشر(
                        &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], &متغير الجدول
                    );
                    تغير := صواب;
                }
                | اختياري.لا_شيء -> {
                }
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف مرر_نشر_الثوابت(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الجدول: متجه اختياري ثابت_مسير = أنشئ_جدول_ثوابت_منشورة(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق تعليمة_مطوية_من_جدول(
                    &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], &الجدول
                ) مع
                | اختياري.موجود(الجديدة) -> {
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت] := الجديدة;
                    تغير := صواب;
                }
                | اختياري.لا_شيء -> {
                }
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف حافتان_متساويتان(أ: &حافة_مسير, ب: &حافة_مسير): منطقي {
    دع حالة_أ: حافة_مسير = *أ;
    دع حالة_ب: حافة_مسير = *ب;
    لو (!كتلتان_مسير_متساويتان(حالة_أ.الهدف, حالة_ب.الهدف)) {
        أرجع خطأ;
    };
    لو ((الطول(حالة_أ.الحجج) مثل طبيعي) != (الطول(حالة_ب.الحجج) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(حالة_أ.الحجج) مثل طبيعي)) {
        لو (!قيمتا_مسير_متساويتان(حالة_أ.الحجج[ف], حالة_ب.الحجج[ف])) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مرر_تبسيط_الفروع_الزائدة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الثوابت: متجه اختياري ثابت_مسير = أنشئ_جدول_ثوابت_منشورة(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].المنهي مع
            | اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
                لو (حافتان_متساويتان(&عند_الصواب, &عند_الخطأ)) {
                    دع الحافة_الوحيدة: حافة_مسير = انسخ_مملوكا_حافة_مسير(&عند_الصواب);
                    (*البرنامج).الدوال[د].الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة_الوحيدة));
                    تغير := صواب;
                } وإلا {
                    طابق ثابت_معروف_لقيمة(&الثوابت, الشرط) مع
                    | اختياري.موجود(ثابت_مسير.منطق(الحقيقة)) -> {
                        لو (الحقيقة) {
                            دع الحافة_المختارة: حافة_مسير = انسخ_مملوكا_حافة_مسير(&عند_الصواب);
                            (*البرنامج).الدوال[د].الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة_المختارة));
                        } وإلا {
                            دع الحافة_المختارة: حافة_مسير = انسخ_مملوكا_حافة_مسير(&عند_الخطأ);
                            (*البرنامج).الدوال[د].الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة_المختارة));
                        };
                        تغير := صواب;
                    }
                    | _ -> {
                    }
                };
            }
            | _ -> {
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف احذف_كتلا_غير_قابلة_للوصول(
    الدالة: &متغير دالة_مسير,
    خريطة_القيم: &متغير متجه إعادة_ترقيم_قيمة_مسير
): منطقي {
    دع المزارة: متجه منطقي = الكتل_القابلة_للوصول_مسير(الدالة);
    دع الكتل: متغير متجه كتلة_مسير = [];
    دع تغير: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        لو (المزارة[ك]) {
            ألحق(الكتل, انسخ_كتلة_للتحسين(&(*الدالة).الكتل[ك]));
        } وإلا {
            تغير := صواب;
        };
        ك := ك + 1;
    }
    لو (تغير) {
        (*الدالة).الكتل := الكتل;
        أعد_تقنين_كتل_دالة(الدالة);
        *خريطة_القيم := أعد_تقنين_قيم_دالة(الدالة);

    };
    أرجع تغير;
}

عرف مرر_حذف_الكتل_غير_القابلة_للوصول(البرنامج: &متغير برنامج_مسير, التصحيح: &متغير بيانات_تصحيح_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الدالة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
        دع خريطة_القيم: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
        لو (احذف_كتلا_غير_قابلة_للوصول(&متغير الدالة, &متغير خريطة_القيم)) {
            دع معرف_المعدلة: معرف_دالة_مسير = الدالة.المعرف;
            (*البرنامج).الدوال[د] := الدالة;
            أعد_ترقيم_تصحيح_دالة_مسير(التصحيح, معرف_المعدلة, &خريطة_القيم);
            تغير := صواب;
        } وإلا {
            (*البرنامج).الدوال[د] := الدالة;
        };
        د := د + 1;
    }
    أرجع تغير;
}

عرف استبدل_قيمة_في_عملية(
    العملية: &عملية_مسير,
    القديم: معرف_قيمة_مسير,
    الجديد: معرف_قيمة_مسير
): عملية_مسير {
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القديم, الجديد: الجديد };
    ألحق(الخريطة, الربط);
    أرجع أعد_كتابة_عملية_قيم(العملية, &الخريطة);
}

عرف استبدل_استخدامات_قيمة_في_دالة(
    الدالة: &متغير دالة_مسير,
    القديم: معرف_قيمة_مسير,
    الجديد: معرف_قيمة_مسير
): منطقي {
    لو (قيمتا_مسير_متساويتان(القديم, الجديد)) {
        أرجع خطأ;
    };
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القديم, الجديد: الجديد };
    ألحق(الخريطة, الربط);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            (*الدالة).الكتل[ك].التعليمات[ت].العملية := استبدل_قيمة_في_عملية(
                &(*الدالة).الكتل[ك].التعليمات[ت].العملية, القديم, الجديد
            );
            ت := ت + 1;
        }
        (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(
            &(*الدالة).الكتل[ك].المنهي, &الخريطة
        );
        ك := ك + 1;
    }
    أرجع صواب;
}

عرف أضف_حافة_إلى_قيمة_موحدة(
    الحافة: &حافة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: طبيعي,
    وجد: &متغير منطقي,
    صالح: &متغير منطقي,
    المرشح: &متغير اختياري معرف_قيمة_مسير
): منطقي {
    دع الحالة: حافة_مسير = *الحافة;
    لو (!كتلتان_مسير_متساويتان(الحالة.الهدف, الهدف)) {
        أرجع صواب;
    };
    لو (الفهرس >= (الطول(الحالة.الحجج) مثل طبيعي)) {
        *صالح := خطأ;
        أرجع خطأ;
    };
    دع القيمة: معرف_قيمة_مسير = الحالة.الحجج[الفهرس];
    لو (!*وجد) {
        *وجد := صواب;
        *المرشح := اختياري.موجود(القيمة);
    } وإلا {
        طابق *المرشح مع
        | اختياري.موجود(الموجود) -> {
            لو (!قيمتا_مسير_متساويتان(الموجود, القيمة)) {
                *صالح := خطأ;
            };
        }
        | اختياري.لا_شيء -> {
            *صالح := خطأ;
        }
    };
    أرجع *صالح;
}

عرف قيمة_موحدة_لمعامل_كتلة(
    الدالة: &دالة_مسير,
    الهدف: معرف_كتلة_مسير,
    الفهرس: طبيعي
): اختياري معرف_قيمة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع وجد: متغير منطقي = خطأ;
    دع صالح: متغير منطقي = صواب;
    دع المرشح: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
            أضف_حافة_إلى_قيمة_موحدة(&الحافة, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
        }
        | اختياري.موجود(منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ)) -> {
            أضف_حافة_إلى_قيمة_موحدة(&عند_الصواب, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
            أضف_حافة_إلى_قيمة_موحدة(&عند_الخطأ, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
        }
        | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> {
            أضف_حافة_إلى_قيمة_موحدة(&الفرع.الافتراضي, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                أضف_حافة_إلى_قيمة_موحدة(&الفرع.الحالات[ف].الحافة, الهدف, الفهرس, &متغير وجد, &متغير صالح, &متغير المرشح);
                ف := ف + 1;
            }
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    لو (!وجد || !صالح) {
        أرجع اختياري.لا_شيء();
    };
    أرجع المرشح;
}

عرف مرر_نشر_القيم(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع نسخة: دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(نسخة.الكتل) مثل طبيعي)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(نسخة.الكتل[ك].المعاملات) مثل طبيعي)) {
                دع المعامل: معرف_قيمة_مسير = نسخة.الكتل[ك].المعاملات[ف].المعرف;
                طابق قيمة_موحدة_لمعامل_كتلة(&نسخة, نسخة.الكتل[ك].المعرف, ف) مع
                | اختياري.موجود(القيمة) -> {
                    لو (!قيمتا_مسير_متساويتان(المعامل, القيمة)) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                        استبدل_استخدامات_قيمة_في_دالة(&متغير الدالة_المعدلة, المعامل, القيمة);
                        (*البرنامج).الدوال[د] := الدالة_المعدلة;
                        تغير := صواب;
                    };
                }
                | اختياري.لا_شيء -> {
                }
                ف := ف + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف نداء_مسير_له_أثر_دلالي(النداء: &نداء_مسير): منطقي {
    دع الحالة: نداء_مسير = *النداء;
    طابق الحالة.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(_) -> {
        // لا يملك MSIR حاليا عقد أثر مقننا للدوال العادية، فتبقى محافظة.
        أرجع صواب;
    }
    | هدف_نداء_مسير.دالة_خارجية(_) -> {
        // لا نفترض نقاء دالة مضيف خارجية بلا عقد أثر صريح.
        أرجع صواب;
    }
    | هدف_نداء_مسير.قيمة_دالة(_) -> {
        أرجع صواب;
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(البدائي);
        طابق العقد.الأثر مع
        | تصنيف_أثر_بدائي.نقي -> {
            أرجع خطأ;
        }
        | _ -> {
            أرجع صواب;
        };
    };
}

عرف عملية_مسير_نقية_آمنة_للحذف(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.مقارنة_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.تحويل_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.نداء(النداء) -> {
        لو (نداء_مسير_له_أثر_دلالي(&النداء)) {
            أرجع خطأ;
        };
        // حتى البدائي المصنف نقيا (طول حاليا) يبقى غير قابل للحذف هنا.
        // خط تحسين النداءات لا يملك بعد إطار قيمة/أثر يثبت سلامة CSE/DCE للنداءات.
        أرجع خطأ;
    }
    | _ -> {
        // حسابات MSIR التي يصفها العقد بأنها قد تفخ لا تحذف حتى إن كان ناتجها ميتا.
        // عمليات الذاكرة تبقى كذلك لأنها قد تحمل أثرا مشاهدا.
        أرجع خطأ;
    };
}

عرف تعليمة_ميتة_قابلة_للحذف(
    التعليمة: &تعليمة_مسير,
    الاستخدامات: &متجه طبيعي
): منطقي {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(القيمة) -> {
        دع جدول_الاستخدامات: متجه طبيعي = *الاستخدامات;
        لو (جدول_الاستخدامات[القيمة.المعرف.القيمة] != 0) {
            أرجع خطأ;
        };
        أرجع عملية_مسير_نقية_آمنة_للحذف(&الحالة.العملية);
    };
}

عرف احذف_تعليمة_عند(
    الدالة: &متغير دالة_مسير,
    الكتلة: طبيعي,
    الفهرس: طبيعي,
    خريطة_القيم: &متغير متجه إعادة_ترقيم_قيمة_مسير
): منطقي {
    دع التعليمات: متغير متجه تعليمة_مسير = [];
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي)) {
        لو (ت != الفهرس) {
            ألحق(التعليمات, انسخ_تعليمة_للتحسين(&(*الدالة).الكتل[الكتلة].التعليمات[ت]));
        };
        ت := ت + 1;
    }
    (*الدالة).الكتل[الكتلة].التعليمات := التعليمات;
    *خريطة_القيم := أعد_تقنين_قيم_دالة(الدالة);
    أرجع صواب;
}

عرف مرر_حذف_الشيفرة_الميتة(البرنامج: &متغير برنامج_مسير, التصحيح: &متغير بيانات_تصحيح_مسير): منطقي {
    دع تغير_كلي: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع استمر: متغير منطقي = صواب;
        طالما (استمر) {
            استمر := خطأ;
            دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير(&(*البرنامج).الدوال[د]);
            دع ك: متغير طبيعي = 0;
            طالما ((ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) && !استمر) {
                دع ت: متغير طبيعي = 0;
                طالما ((ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) && !استمر) {
                    لو (تعليمة_ميتة_قابلة_للحذف(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], &الاستخدامات)) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                        دع خريطة_القيم: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
                        احذف_تعليمة_عند(&متغير الدالة_المعدلة, ك, ت, &متغير خريطة_القيم);
                        دع معرف_المعدلة: معرف_دالة_مسير = الدالة_المعدلة.المعرف;
                        (*البرنامج).الدوال[د] := الدالة_المعدلة;
                        أعد_ترقيم_تصحيح_دالة_مسير(التصحيح, معرف_المعدلة, &خريطة_القيم);
                        استمر := صواب;
                        تغير_كلي := صواب;
                    };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
        }
        د := د + 1;
    }
    أرجع تغير_كلي;
}

عرف احذف_حجة_حافة_عند(الحافة: &حافة_مسير, الفهرس: طبيعي): حافة_مسير {
    دع الحالة_حافة: حافة_مسير = *الحافة;
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة_حافة.الحجج) مثل طبيعي)) {
        لو (ف != الفهرس) {
            ألحق(الحجج, الحالة_حافة.الحجج[ف]);
        };
        ف := ف + 1;
    }
    دع الناتج: حافة_مسير = { الهدف: الحالة_حافة.الهدف, الحجج: الحجج };
    أرجع الناتج;
}

عرف احذف_معامل_كتلة_عند(
    الدالة: &متغير دالة_مسير,
    الكتلة: طبيعي,
    الفهرس: طبيعي,
    خريطة_القيم: &متغير متجه إعادة_ترقيم_قيمة_مسير
): منطقي {
    دع الهدف: معرف_كتلة_مسير = (*الدالة).الكتل[الكتلة].المعرف;
    دع المعاملات: متغير متجه قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).الكتل[الكتلة].المعاملات) مثل طبيعي)) {
        لو (ف != الفهرس) {
            دع مرجع_المعامل: &قيمة_مسير = &(*الدالة).الكتل[الكتلة].المعاملات[ف];
            ألحق(المعاملات, *مرجع_المعامل);
        };
        ف := ف + 1;
    }
    (*الدالة).الكتل[الكتلة].المعاملات := المعاملات;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
            لو (كتلتان_مسير_متساويتان(الحافة.الهدف, الهدف)) {
                دع الحافة_الجديدة: حافة_مسير = احذف_حجة_حافة_عند(&الحافة, الفهرس);
                (*الدالة).الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة_الجديدة));
            };
        }
        | اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
            دع يصيب_الصواب: منطقي = كتلتان_مسير_متساويتان(عند_الصواب.الهدف, الهدف);
            دع يصيب_الخطأ: منطقي = كتلتان_مسير_متساويتان(عند_الخطأ.الهدف, الهدف);
            دع صواب_جديد: متغير حافة_مسير = انسخ_مملوكا_حافة_مسير(&عند_الصواب);
            لو (يصيب_الصواب) {
                صواب_جديد := احذف_حجة_حافة_عند(&صواب_جديد, الفهرس);
            };
            دع خطأ_جديد: متغير حافة_مسير = انسخ_مملوكا_حافة_مسير(&عند_الخطأ);
            لو (يصيب_الخطأ) {
                خطأ_جديد := احذف_حجة_حافة_عند(&خطأ_جديد, الفهرس);
            };
            (*الدالة).الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, صواب_جديد, خطأ_جديد));
        }
        | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> {
            دع الحالات: متغير متجه حالة_فرع_متعدد_مسير = [];
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الفرع.الحالات) مثل طبيعي)) {
                دع الحالة_الحافة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[س];
                دع الحافة: متغير حافة_مسير = انسخ_مملوكا_حافة_مسير(&(*الحالة_الحافة).الحافة);
                لو (كتلتان_مسير_متساويتان(الحافة.الهدف, الهدف)) {
                    الحافة := احذف_حجة_حافة_عند(&الحافة, الفهرس);
                };
                دع الحالة_الجديدة: حالة_فرع_متعدد_مسير = { الوسم: (*الحالة_الحافة).الوسم, الحافة: الحافة };
                ألحق(الحالات, الحالة_الجديدة);
                س := س + 1;
            }
            دع الافتراضي: متغير حافة_مسير = انسخ_مملوكا_حافة_مسير(&الفرع.الافتراضي);
            لو (كتلتان_مسير_متساويتان(الافتراضي.الهدف, الهدف)) {
                الافتراضي := احذف_حجة_حافة_عند(&الافتراضي, الفهرس);
            };
            دع الجديد: فرع_متعدد_مسير = { المميز: الفرع.المميز, الحالات: الحالات, الافتراضي: الافتراضي };
            (*الدالة).الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع_متعدد(الجديد));
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    *خريطة_القيم := أعد_تقنين_قيم_دالة(الدالة);
    أرجع صواب;
}

عرف مرر_تبسيط_معاملات_الكتل(البرنامج: &متغير برنامج_مسير, التصحيح: &متغير بيانات_تصحيح_مسير): منطقي {
    دع تغير_كلي: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع استمر: متغير منطقي = صواب;
        طالما (استمر) {
            استمر := خطأ;
            دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير(&(*البرنامج).الدوال[د]);
            دع ك: متغير طبيعي = 0;
            طالما ((ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) && !استمر) {
                دع ف: متغير طبيعي = 0;
                طالما ((ف < (الطول((*البرنامج).الدوال[د].الكتل[ك].المعاملات) مثل طبيعي)) && !استمر) {
                    دع المعرف: معرف_قيمة_مسير = (*البرنامج).الدوال[د].الكتل[ك].المعاملات[ف].المعرف;
                    لو (الاستخدامات[المعرف.القيمة] == 0) {
            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                        دع خريطة_القيم: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
                        احذف_معامل_كتلة_عند(&متغير الدالة_المعدلة, ك, ف, &متغير خريطة_القيم);
                        دع معرف_المعدلة: معرف_دالة_مسير = الدالة_المعدلة.المعرف;
                        (*البرنامج).الدوال[د] := الدالة_المعدلة;
                        أعد_ترقيم_تصحيح_دالة_مسير(التصحيح, معرف_المعدلة, &خريطة_القيم);
                        استمر := صواب;
                        تغير_كلي := صواب;
                    };
                    ف := ف + 1;
                }
                ك := ك + 1;
            }
        }
        د := د + 1;
    }
    أرجع تغير_كلي;
}

عرف موضع_معامل_كتلة_لقيمة(
    الكتلة: &كتلة_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري طبيعي {
    دع الحالة: كتلة_مسير = *الكتلة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.المعاملات) مثل طبيعي)) {
        لو (قيمتا_مسير_متساويتان(الحالة.المعاملات[ف].المعرف, المعرف)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ركب_حافة_تمرير(
    الداخلة: &حافة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    الخارجة: &حافة_مسير
): اختياري حافة_مسير {
    دع حالة_الداخلة: حافة_مسير = *الداخلة;
    دع حالة_الكتلة: كتلة_مسير = *كتلة_التمرير;
    دع حالة_الخارجة: حافة_مسير = *الخارجة;
    لو (!كتلتان_مسير_متساويتان(حالة_الداخلة.الهدف, حالة_الكتلة.المعرف)) {
        أرجع اختياري.لا_شيء();
    };
    لو (
        (الطول(حالة_الداخلة.الحجج) مثل طبيعي)
        != (الطول(حالة_الكتلة.المعاملات) مثل طبيعي)
    ) {
        أرجع اختياري.لا_شيء();
    };

    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(حالة_الخارجة.الحجج) مثل طبيعي)) {
        دع الحجة: معرف_قيمة_مسير = حالة_الخارجة.الحجج[ف];
        طابق موضع_معامل_كتلة_لقيمة(&حالة_الكتلة, الحجة) مع
        | اختياري.موجود(الموضع) -> {
            ألحق(الحجج, حالة_الداخلة.الحجج[الموضع]);
        }
        | اختياري.لا_شيء -> {
            ألحق(الحجج, الحجة);
        }
        ف := ف + 1;
    }
    دع الناتج: حافة_مسير = {
        الهدف: حالة_الخارجة.الهدف,
        الحجج: الحجج
    };
    أرجع اختياري.موجود(الناتج);
}

عرف أعد_توجيه_حافة_تمرير(
    الحافة: حافة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): اختياري حافة_مسير {
    دع الحالة: كتلة_مسير = *كتلة_التمرير;
    لو (!كتلتان_مسير_متساويتان(الحافة.الهدف, الحالة.المعرف)) {
        أرجع اختياري.موجود(الحافة);
    };
    أرجع ركب_حافة_تمرير(&الحافة, &الحالة, البديل);
}

عرف عدد_ظهور_قيمة_في_حافة(
    الحافة: &حافة_مسير,
    المعرف: معرف_قيمة_مسير
): طبيعي {
    دع الحالة: حافة_مسير = *الحافة;
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.الحجج) مثل طبيعي)) {
        لو (قيمتا_مسير_متساويتان(الحالة.الحجج[ف], المعرف)) {
            العدد := العدد + 1;
        };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف معاملات_كتلة_تمرير_مقصورة_على_الحافة(
    الدالة: &دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    الخارجة: &حافة_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير(&الحالة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التمرير.المعاملات) مثل طبيعي)) {
        دع المعرف: معرف_قيمة_مسير = التمرير.المعاملات[ف].المعرف;
        دع استخدامات_الحافة: طبيعي = عدد_ظهور_قيمة_في_حافة(
            الخارجة,
            المعرف
        );
        لو (الاستخدامات[المعرف.القيمة] != استخدامات_الحافة) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يمكن_إعادة_توجيه_أسلاف_كتلة_تمرير(
    الدالة: &دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
        طابق الحالة.الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
            لو (كتلتان_مسير_متساويتان(الحافة.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&الحافة, &التمرير, البديل) مع
                | اختياري.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختياري.موجود(_) -> {
                }
            };
        }
        | اختياري.موجود(منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ)) -> {
            لو (كتلتان_مسير_متساويتان(عند_الصواب.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&عند_الصواب, &التمرير, البديل) مع
                | اختياري.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختياري.موجود(_) -> {
                }
            };
            لو (كتلتان_مسير_متساويتان(عند_الخطأ.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&عند_الخطأ, &التمرير, البديل) مع
                | اختياري.لا_شيء -> {
                    أرجع خطأ;
                }
                | اختياري.موجود(_) -> {
                }
            };
        }
        | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> {
            لو (كتلتان_مسير_متساويتان(الفرع.الافتراضي.الهدف, التمرير.المعرف)) {
                طابق ركب_حافة_تمرير(&الفرع.الافتراضي, &التمرير, البديل) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(_) -> { };
            };
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الفرع.الحالات) مثل طبيعي)) {
                لو (كتلتان_مسير_متساويتان(الفرع.الحالات[س].الحافة.الهدف, التمرير.المعرف)) {
                    طابق ركب_حافة_تمرير(&الفرع.الحالات[س].الحافة, &التمرير, البديل) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(_) -> { };
                };
                س := س + 1;
            }
        }
        | _ -> {
        }
        ك := ك + 1;
    }
    أرجع صواب;
}

عرف أعد_توجيه_أسلاف_كتلة_تمرير(
    الدالة: &متغير دالة_مسير,
    كتلة_التمرير: &كتلة_مسير,
    البديل: &حافة_مسير
): منطقي {
    دع التمرير: كتلة_مسير = *كتلة_التمرير;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
            طابق أعد_توجيه_حافة_تمرير(انسخ_مملوكا_حافة_مسير(&الحافة), &التمرير, البديل) مع
            | اختياري.موجود(الجديدة) -> {
                (*الدالة).الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(الجديدة));
            }
            | اختياري.لا_شيء -> {
                أرجع خطأ;
            }
        }
        | اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ)) -> {
            دع الصواب: اختياري حافة_مسير = أعد_توجيه_حافة_تمرير(
                انسخ_مملوكا_حافة_مسير(&عند_الصواب),
                &التمرير,
                البديل
            );
            دع الخطأ: اختياري حافة_مسير = أعد_توجيه_حافة_تمرير(
                انسخ_مملوكا_حافة_مسير(&عند_الخطأ),
                &التمرير,
                البديل
            );
            طابق الصواب مع
            | اختياري.موجود(صواب_جديد) -> {
                طابق الخطأ مع
                | اختياري.موجود(خطأ_جديد) -> {
                    (*الدالة).الكتل[ك].المنهي := اختياري.موجود(
                        منهي_مسير.فرع_شرطي(الشرط, صواب_جديد, خطأ_جديد)
                    );
                }
                | اختياري.لا_شيء -> {
                    أرجع خطأ;
                }
            }
            | اختياري.لا_شيء -> {
                أرجع خطأ;
            }
        }
        | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> {
            دع الحالات: متغير متجه حالة_فرع_متعدد_مسير = [];
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الفرع.الحالات) مثل طبيعي)) {
                دع الحالة_الحافة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[س];
                دع الحافة: حافة_مسير;
                طابق أعد_توجيه_حافة_تمرير(انسخ_مملوكا_حافة_مسير(&(*الحالة_الحافة).الحافة), &التمرير, البديل) مع
                | اختياري.موجود(الجديدة) -> { الحافة := الجديدة; }
                | اختياري.لا_شيء -> { أرجع خطأ; };
                دع الحالة_الجديدة: حالة_فرع_متعدد_مسير = { الوسم: (*الحالة_الحافة).الوسم, الحافة: الحافة };
                ألحق(الحالات, الحالة_الجديدة);
                س := س + 1;
            }
            دع الافتراضي: حافة_مسير;
            طابق أعد_توجيه_حافة_تمرير(انسخ_مملوكا_حافة_مسير(&الفرع.الافتراضي), &التمرير, البديل) مع
            | اختياري.موجود(الجديدة) -> { الافتراضي := الجديدة; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
            دع الجديد: فرع_متعدد_مسير = { المميز: الفرع.المميز, الحالات: الحالات, الافتراضي: الافتراضي };
            (*الدالة).الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع_متعدد(الجديد));
        }
        | _ -> {
        }
        ك := ك + 1;
    }

    أرجع صواب;
}

عرف بسط_كتلة_تمرير_واحدة(
    الدالة: &متغير دالة_مسير,
    خريطة_القيم: &متغير متجه إعادة_ترقيم_قيمة_مسير
): منطقي {
    دع الحالة: متغير دالة_مسير = انسخ_مملوكا_دالة_مسير(الدالة);
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(&الحالة);
    دع المدخل: اختياري معرف_كتلة_مسير = الحالة.المدخل;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
        دع الكتلة: كتلة_مسير = انسخ_كتلة_للتحسين(&الحالة.الكتل[ك]);
        دع هي_مدخل: متغير منطقي = خطأ;
        طابق المدخل مع
        | اختياري.موجود(المعرف) -> {
            هي_مدخل := كتلتان_مسير_متساويتان(المعرف, الكتلة.المعرف);
        }
        | اختياري.لا_شيء -> {
        }
        لو (
            الوصول[ك]
            && !هي_مدخل
            && ((الطول(الكتلة.التعليمات) مثل طبيعي) == 0)
        ) {
            طابق الكتلة.المنهي مع
            | اختياري.موجود(منهي_مسير.فرع(البديل)) -> {
                لو (
                    !كتلتان_مسير_متساويتان(البديل.الهدف, الكتلة.المعرف)
                    && معاملات_كتلة_تمرير_مقصورة_على_الحافة(
                        &الحالة,
                        &الكتلة,
                        &البديل
                    )
                    && يمكن_إعادة_توجيه_أسلاف_كتلة_تمرير(
                        &الحالة,
                        &الكتلة,
                        &البديل
                    )
                ) {
                    دع المعدلة: متغير دالة_مسير = الحالة;
                    لو (أعد_توجيه_أسلاف_كتلة_تمرير(
                        &متغير المعدلة,
                        &الكتلة,
                        &البديل
                    )) {
                        *الدالة := المعدلة;
                        احذف_كتلا_غير_قابلة_للوصول(الدالة, خريطة_القيم);
                        أرجع صواب;
                    };
                };
            }
            | _ -> {
            }
        };
        ك := ك + 1;
    }
    أرجع خطأ;
}

عرف أنشئ_خريطة_معاملات_دمج(
    الهدف: &كتلة_مسير,
    الحافة: &حافة_مسير
): اختياري متجه إعادة_ترقيم_قيمة_مسير {
    دع حالة_الهدف: كتلة_مسير = *الهدف;
    دع حالة_الحافة: حافة_مسير = *الحافة;
    لو (
        (الطول(حالة_الهدف.المعاملات) مثل طبيعي)
        != (الطول(حالة_الحافة.الحجج) مثل طبيعي)
    ) {
        أرجع اختياري.لا_شيء();
    };
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(حالة_الهدف.المعاملات) مثل طبيعي)) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = {
            القديم: حالة_الهدف.المعاملات[ف].المعرف,
            الجديد: حالة_الحافة.الحجج[ف]
        };
        ألحق(الخريطة, الربط);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الخريطة);
}

عرف ادمج_كتلة_ذات_سلف_واحد(
    الدالة: &متغير دالة_مسير,
    موضع_الهدف: طبيعي,
    خريطة_القيم: &متغير متجه إعادة_ترقيم_قيمة_مسير
): منطقي {
    لو (موضع_الهدف >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع الهدف: كتلة_مسير = انسخ_كتلة_للتحسين(&(*الدالة).الكتل[موضع_الهدف]);
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        لو (كتلتان_مسير_متساويتان(المدخل, الهدف.المعرف)) {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
    }

    دع الأسلاف: متجه معرف_كتلة_مسير = أسلاف_كتلة_مسير(الدالة, الهدف.المعرف);
    لو ((الطول(الأسلاف) مثل طبيعي) != 1) {
        أرجع خطأ;
    };
    دع السلف: معرف_كتلة_مسير = الأسلاف[0];
    لو (كتلتان_مسير_متساويتان(السلف, الهدف.المعرف)) {
        أرجع خطأ;
    };
    دع موضع_السلف: طبيعي = السلف.القيمة;
    لو (موضع_السلف >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
        أرجع خطأ;
    };

    دع حافة_الدخول: متغير اختياري حافة_مسير = اختياري.لا_شيء();
    طابق (*الدالة).الكتل[موضع_السلف].المنهي مع
    | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> {
        لو (كتلتان_مسير_متساويتان(الحافة.الهدف, الهدف.المعرف)) {
            حافة_الدخول := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&الحافة));
        };
    }
    | _ -> {
    }
    طابق حافة_الدخول مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(الحافة) -> {
        طابق أنشئ_خريطة_معاملات_دمج(&الهدف, &الحافة) مع
        | اختياري.لا_شيء -> {
            أرجع خطأ;
        }
        | اختياري.موجود(الخريطة) -> {
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول(الخريطة) مثل طبيعي)) {
                استبدل_استخدامات_قيمة_في_دالة(
                    الدالة,
                    الخريطة[ر].القديم,
                    الخريطة[ر].الجديد
                );
                ر := ر + 1;
            }
            دع الهدف_المحدث: كتلة_مسير =
                انسخ_كتلة_للتحسين(&(*الدالة).الكتل[موضع_الهدف]);
            دع التعليمات: متغير متجه تعليمة_مسير = [];
            دع ت: متغير طبيعي = 0;
            طالما (
                ت < (الطول((*الدالة).الكتل[موضع_السلف].التعليمات) مثل طبيعي)
            ) {
                ألحق(
                    التعليمات,
                    انسخ_تعليمة_للتحسين(
                        &(*الدالة).الكتل[موضع_السلف].التعليمات[ت]
                    )
                );
                ت := ت + 1;
            }
            ت := 0;
            طالما (ت < (الطول(الهدف_المحدث.التعليمات) مثل طبيعي)) {
                ألحق(
                    التعليمات,
                    انسخ_تعليمة_للتحسين(&الهدف_المحدث.التعليمات[ت])
                );
                ت := ت + 1;
            }
            (*الدالة).الكتل[موضع_السلف].التعليمات := التعليمات;
            (*الدالة).الكتل[موضع_السلف].المنهي := أعد_كتابة_منهي_اختياري_قيم(
                &الهدف_المحدث.المنهي,
                &الخريطة
            );

            دع خريطة_التقنين: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
            احذف_كتلا_غير_قابلة_للوصول(الدالة, &متغير خريطة_التقنين);
            *خريطة_القيم := أكمل_خريطة_إعادة_ترقيم_بعد_استبدال(&خريطة_التقنين, &الخريطة);
            أرجع صواب;
        }
    };
}

عرف مرر_تبسيط_التدفق(البرنامج: &متغير برنامج_مسير, التصحيح: &متغير بيانات_تصحيح_مسير): منطقي {
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الدالة_المعدلة: متغير دالة_مسير =
            انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
        دع خريطة_التمرير: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
        لو (بسط_كتلة_تمرير_واحدة(&متغير الدالة_المعدلة, &متغير خريطة_التمرير)) {
            دع معرف_المعدلة: معرف_دالة_مسير = الدالة_المعدلة.المعرف;
            (*البرنامج).الدوال[د] := الدالة_المعدلة;
            أعد_ترقيم_تصحيح_دالة_مسير(التصحيح, معرف_المعدلة, &خريطة_التمرير);

            أرجع صواب;
        };

        دع الوصول: متجه منطقي =
            الكتل_القابلة_للوصول_مسير(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            لو (الوصول[ك]) {
                دع الدالة_المدمجة: متغير دالة_مسير =
                    انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                دع خريطة_الدمج: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
                لو (ادمج_كتلة_ذات_سلف_واحد(&متغير الدالة_المدمجة, ك, &متغير خريطة_الدمج)) {
                    دع معرف_المدمجة: معرف_دالة_مسير = الدالة_المدمجة.المعرف;
                    (*البرنامج).الدوال[د] := الدالة_المدمجة;
                    أعد_ترقيم_تصحيح_دالة_مسير(التصحيح, معرف_المدمجة, &خريطة_الدمج);

                    أرجع صواب;
                };
            };
            ك := ك + 1;
        }
        د := د + 1;
    }

    أرجع خطأ;
}

عرف ثابت_صفر_مسير(الثابت: &ثابت_مسير): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        أرجع القيمة == 0;
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        أرجع القيمة == 0;
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف قيمة_صفر_معروفة(
    الجدول: &متجه اختياري ثابت_مسير,
    المعرف: معرف_قيمة_مسير
): منطقي {
    طابق ثابت_معروف_لقيمة(الجدول, المعرف) مع
    | اختياري.موجود(الثابت) -> {
        أرجع ثابت_صفر_مسير(&الثابت);
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف بديل_جبري_آمن(
    العملية: &عملية_مسير,
    الجدول: &متجه اختياري ثابت_مسير
): اختياري معرف_قيمة_مسير {
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        دع يسار_صفر: منطقي = قيمة_صفر_معروفة(الجدول, الحساب.اليسار);
        دع يمين_صفر: منطقي = قيمة_صفر_معروفة(الجدول, الحساب.اليمين);
        طابق الحساب.العملية مع
        | عملية_حساب_صحيح.جمع -> {
            لو (يسار_صفر) {
                أرجع اختياري.موجود(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.طرح -> {
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.أو_بتي -> {
            لو (يسار_صفر) {
                أرجع اختياري.موجود(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.أو_حصري -> {
            لو (يسار_صفر) {
                أرجع اختياري.موجود(الحساب.اليمين);
            };
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_يسرى -> {
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_يمنى -> {
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
            لو (يمين_صفر) {
                أرجع اختياري.موجود(الحساب.اليسار);
            };
        }
        | _ -> {
        };
    }
    | _ -> {
    };
    أرجع اختياري.لا_شيء();
}

عرف مرر_التبسيط_الجبري(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الجدول: متجه اختياري ثابت_مسير = أنشئ_جدول_ثوابت_مباشرة(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                دع مرجع_التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت];
                دع التعليمة: تعليمة_مسير = انسخ_تعليمة_للتحسين(مرجع_التعليمة);
                طابق التعليمة.الناتج مع
                | اختياري.موجود(الناتج) -> {
                    طابق بديل_جبري_آمن(&التعليمة.العملية, &الجدول) مع
                    | اختياري.موجود(البديل) -> {
                        لو (!قيمتا_مسير_متساويتان(الناتج.المعرف, البديل)) {
                            دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                            استبدل_استخدامات_قيمة_في_دالة(&متغير الدالة_المعدلة, الناتج.المعرف, البديل);
                            (*البرنامج).الدوال[د] := الدالة_المعدلة;
                            تغير := صواب;
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف عمليتا_حساب_صحيح_متساويتان(أ: عملية_حساب_صحيح, ب: عملية_حساب_صحيح): منطقي {
    طابق أ مع
    | عملية_حساب_صحيح.جمع -> {
        طابق ب مع
        | عملية_حساب_صحيح.جمع -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.طرح -> {
        طابق ب مع
        | عملية_حساب_صحيح.طرح -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.ضرب -> {
        طابق ب مع
        | عملية_حساب_صحيح.ضرب -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.قسمة_موقعة -> {
        طابق ب مع
        | عملية_حساب_صحيح.قسمة_موقعة -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.قسمة_طبيعية -> {
        طابق ب مع
        | عملية_حساب_صحيح.قسمة_طبيعية -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.باقي_موقع -> {
        طابق ب مع
        | عملية_حساب_صحيح.باقي_موقع -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.باقي_طبيعي -> {
        طابق ب مع
        | عملية_حساب_صحيح.باقي_طبيعي -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.أو_بتي -> {
        طابق ب مع
        | عملية_حساب_صحيح.أو_بتي -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.أو_حصري -> {
        طابق ب مع
        | عملية_حساب_صحيح.أو_حصري -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.و_بتي -> {
        طابق ب مع
        | عملية_حساب_صحيح.و_بتي -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.إزاحة_يسرى -> {
        طابق ب مع
        | عملية_حساب_صحيح.إزاحة_يسرى -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.إزاحة_يمنى -> {
        طابق ب مع
        | عملية_حساب_صحيح.إزاحة_يمنى -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
        طابق ب مع
        | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_حساب_صحيح.جمع_ملتف -> {
        طابق ب مع
        | عملية_حساب_صحيح.جمع_ملتف -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | عملية_حساب_صحيح.طرح_ملتف -> {
        طابق ب مع
        | عملية_حساب_صحيح.طرح_ملتف -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | عملية_حساب_صحيح.ضرب_ملتف -> {
        طابق ب مع
        | عملية_حساب_صحيح.ضرب_ملتف -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> {
        طابق ب مع
        | عملية_حساب_صحيح.إزاحة_يسرى_ملتفة -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

