عرف عملية_مسير_آمنة_لإعادة_الاستخدام(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.حساب_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.مقارنة_صحيح(_) -> {
        أرجع صواب;
    }
    | عملية_مسير.تحويل_صحيح(_) -> {
        أرجع صواب;
    }
    | _ -> {
        // عمليات الذاكرة والهوية والنداء والبناء ذي الهوية لا يعاد استعمالها عالميا.
        أرجع خطأ;
    };
}

عرف عمليتا_تعبير_قابل_لإعادة_الاستخدام_متساويتان(
    أ: &عملية_مسير,
    ب: &عملية_مسير
): منطقي {
    طابق *أ مع
    | عملية_مسير.ثابت(ثابت_أ) -> {
        طابق *ب مع
        | عملية_مسير.ثابت(ثابت_ب) -> {
            أرجع ثابتا_مسير_متساويان(&ثابت_أ, &ثابت_ب);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_مسير.حساب_صحيح(حساب_أ) -> {
        طابق *ب مع
        | عملية_مسير.حساب_صحيح(حساب_ب) -> {
            أرجع عمليتا_حساب_صحيح_متساويتان(حساب_أ.العملية, حساب_ب.العملية)
                && قيمتا_مسير_متساويتان(حساب_أ.اليسار, حساب_ب.اليسار)
                && قيمتا_مسير_متساويتان(حساب_أ.اليمين, حساب_ب.اليمين);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_مسير.مقارنة_صحيح(مقارنة_أ) -> {
        طابق *ب مع
        | عملية_مسير.مقارنة_صحيح(مقارنة_ب) -> {
            أرجع عمليتا_مقارنة_صحيح_متساويتان(مقارنة_أ.العملية, مقارنة_ب.العملية)
                && قيمتا_مسير_متساويتان(مقارنة_أ.اليسار, مقارنة_ب.اليسار)
                && قيمتا_مسير_متساويتان(مقارنة_أ.اليمين, مقارنة_ب.اليمين);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | عملية_مسير.تحويل_صحيح(تحويل_أ) -> {
        طابق *ب مع
        | عملية_مسير.تحويل_صحيح(تحويل_ب) -> {
            أرجع عمليتا_تحويل_صحيح_متساويتان(تحويل_أ.العملية, تحويل_ب.العملية)
                && قيمتا_مسير_متساويتان(تحويل_أ.المصدر, تحويل_ب.المصدر);
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف مرر_حذف_التعبيرات_المحلية_الزائدة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                دع مرجع_الحالية: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت];
                دع الحالية: تعليمة_مسير = انسخ_تعليمة_للتحسين(مرجع_الحالية);
                طابق الحالية.الناتج مع
                | اختياري.موجود(الناتج) -> {
                    دع س: متغير طبيعي = 0;
                    دع وجد: متغير منطقي = خطأ;
                    طالما ((س < ت) && !وجد) {
                        دع مرجع_السابقة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[س];
                        دع السابقة: تعليمة_مسير = انسخ_تعليمة_للتحسين(مرجع_السابقة);
                        طابق السابقة.الناتج مع
                        | اختياري.موجود(ناتج_سابق) -> {
                            لو (
                                معرفا_نوع_متساويان(ناتج_سابق.النوع, الناتج.النوع)
                                && عمليتا_تعبير_قابل_لإعادة_الاستخدام_متساويتان(
                                    &السابقة.العملية,
                                    &الحالية.العملية
                                )
                            ) {
                                دع الدالة_المعدلة: متغير دالة_مسير = انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                                استبدل_استخدامات_قيمة_في_دالة(&متغير الدالة_المعدلة, الناتج.المعرف, ناتج_سابق.المعرف);
                                (*البرنامج).الدوال[د] := الدالة_المعدلة;
                                تغير := صواب;
                                وجد := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        س := س + 1;
                    }
                }
                | اختياري.لا_شيء -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف ابحث_تعبيرا_مسيطرا_مكافئا(
    الدالة: &دالة_مسير,
    التحليل: &تحليل_هيمنة_مسير,
    كتلة_الحالية: طبيعي,
    التعليمة: &تعليمة_مسير
): اختياري معرف_قيمة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع الحالية: تعليمة_مسير = *التعليمة;
    لو (!عملية_مسير_آمنة_لإعادة_الاستخدام(&الحالية.العملية)) {
        أرجع اختياري.لا_شيء();
    };
    طابق الحالية.الناتج مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الناتج) -> {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الحالة.الكتل) مثل طبيعي)) {
            لو (
                (ك != كتلة_الحالية)
                && كتلة_تهيمن_على(
                    التحليل,
                    الحالة.الكتل[ك].المعرف,
                    الحالة.الكتل[كتلة_الحالية].المعرف
                )
            ) {
                دع ت: متغير طبيعي = 0;
                طالما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل طبيعي)) {
                    دع مرجع_السابقة: &تعليمة_مسير =
                        &الحالة.الكتل[ك].التعليمات[ت];
                    دع السابقة: تعليمة_مسير =
                        انسخ_تعليمة_للتحسين(مرجع_السابقة);
                    لو (عملية_مسير_آمنة_لإعادة_الاستخدام(&السابقة.العملية)) {
                        طابق السابقة.الناتج مع
                        | اختياري.موجود(ناتج_سابق) -> {
                            لو (
                                معرفا_نوع_متساويان(ناتج_سابق.النوع, الناتج.النوع)
                                && عمليتا_تعبير_قابل_لإعادة_الاستخدام_متساويتان(
                                    &السابقة.العملية,
                                    &الحالية.العملية
                                )
                            ) {
                                أرجع اختياري.موجود(ناتج_سابق.المعرف);
                            };
                        }
                        | اختياري.لا_شيء -> {
                        }
                    };
                    ت := ت + 1;
                }
            };
            ك := ك + 1;
        }
    };
    أرجع اختياري.لا_شيء();
}

عرف مرر_حذف_التعبيرات_العالمية_الزائدة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع التحليل: تحليل_هيمنة_مسير = حلل_هيمنة_مسير(&(*البرنامج).الدوال[د]);
        دع الاستخدامات: متغير متجه طبيعي = جدول_استخدامات_قيم_مسير(&(*البرنامج).الدوال[د]);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            لو (التحليل.قابل_للوصول[ك]) {
                دع ت: متغير طبيعي = 0;
                طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                    دع مرجع_الحالية: &تعليمة_مسير =
                        &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت];
                    دع الحالية: تعليمة_مسير =
                        انسخ_تعليمة_للتحسين(مرجع_الحالية);
                    طابق الحالية.الناتج مع
                    | اختياري.موجود(الناتج) -> {
                        طابق ابحث_تعبيرا_مسيطرا_مكافئا(
                            &(*البرنامج).الدوال[د],
                            &التحليل,
                            ك,
                            &الحالية
                        ) مع
                        | اختياري.موجود(البديل) -> {
                            دع عدد_الاستخدامات: طبيعي = الاستخدامات[الناتج.المعرف.القيمة];
                            لو (
                                !قيمتا_مسير_متساويتان(الناتج.المعرف, البديل)
                                && (عدد_الاستخدامات > 0)
                            ) {
                                دع الدالة_المعدلة: متغير دالة_مسير =
                                    انسخ_دالة_للتحسين(&(*البرنامج).الدوال[د]);
                                استبدل_استخدامات_قيمة_في_دالة(
                                    &متغير الدالة_المعدلة,
                                    الناتج.المعرف,
                                    البديل
                                );
                                (*البرنامج).الدوال[د] := الدالة_المعدلة;
                                الاستخدامات[البديل.القيمة] :=
                                    الاستخدامات[البديل.القيمة] + عدد_الاستخدامات;
                                الاستخدامات[الناتج.المعرف.القيمة] := 0;
                                تغير := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> {
                        }
                    }
                    | اختياري.لا_شيء -> {
                    }
                    ت := ت + 1;
                }
            };
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع تغير;
}

عرف تحقق_بعد_مرور(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_تحسين_مسير {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> {
        أرجع نتيجة_تحسين_مسير.ناجح(انسخ_مملوكا_برنامج_مسير(البرنامج));
    }
    | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
        أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
    }
}

عرف نظف_مسير_حتى_الثبات(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_تحسين_مسير {
    دع استمر: متغير منطقي = صواب;
    طالما (استمر) {
        استمر := خطأ;

        لو (مرر_تبسيط_الفروع_الزائدة(البرنامج)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };

        لو (مرر_تبسيط_التدفق(البرنامج, التصحيح)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };

        لو (مرر_حذف_الكتل_غير_القابلة_للوصول(البرنامج, التصحيح)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };

        لو (مرر_حذف_التعبيرات_العالمية_الزائدة(البرنامج)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };

        لو (مرر_حذف_الشيفرة_الميتة(البرنامج, التصحيح)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };

        لو (مرر_تبسيط_معاملات_الكتل(البرنامج, التصحيح)) {
            استمر := صواب;
            طابق تحقق_بعد_مرور(البرنامج, الأنواع) مع
            | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
                أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
            }
            | _ -> {
            }
        };
    }

    أرجع نتيجة_تحسين_مسير.ناجح(انسخ_مملوكا_برنامج_مسير(البرنامج));
}

// الحد العام الوحيد للتحسين. يتحقق من الدخل، ويتحقق بعد كل مرور غيّر MSIR،
// ولا يعيد أبدا برنامجا محسنا غير مقبول من verifier المقنن.
عام عرف حسن_برنامج_مسير(
    البرنامج: برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأنواع: &سجل_أنواع,
    الخيارات: خيارات_تحسين_مسير
): نتيجة_تحسين_مسير {
    دع الحالة: متغير برنامج_مسير = البرنامج;
    طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
    | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
        أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
    }
    | نتيجة_تحسين_مسير.ناجح(_) -> {
    }

    لو (!الخيارات.مفعل) {
        أرجع نتيجة_تحسين_مسير.ناجح(الحالة);
    };

    لو (مرر_طي_الثوابت(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_نشر_الثوابت(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_التبسيط_الجبري(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_حذف_التعبيرات_المحلية_الزائدة(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_حذف_التعبيرات_العالمية_الزائدة(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_تبسيط_الفروع_الزائدة(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_حذف_الكتل_غير_القابلة_للوصول(&متغير الحالة, التصحيح)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_نشر_القيم(&متغير الحالة)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_تبسيط_معاملات_الكتل(&متغير الحالة, التصحيح)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_حذف_الشيفرة_الميتة(&متغير الحالة, التصحيح)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };
    لو (مرر_تبسيط_التدفق(&متغير الحالة, التصحيح)) {
        طابق تحقق_بعد_مرور(&الحالة, الأنواع) مع
        | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
            أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
        }
        | _ -> {
        }
    };

    طابق نظف_مسير_حتى_الثبات(&متغير الحالة, التصحيح, الأنواع) مع
    | نتيجة_تحسين_مسير.مرفوض(الأخطاء) -> {
        أرجع نتيجة_تحسين_مسير.مرفوض(الأخطاء);
    }
    | نتيجة_تحسين_مسير.ناجح(المحسن) -> {
        الحالة := المحسن;
    }

    أرجع نتيجة_تحسين_مسير.ناجح(الحالة);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عرف انسخ_مملوكا__اختيار_ثابت_مسير(القيمة: &اختياري ثابت_مسير): اختياري ثابت_مسير {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_ثابت_مسير(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}
