استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_analysis;
استورد compiler.msir.msir_inlining;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.runtime.primitive_identity;
استورد compiler.msir.lowering.ownership_glue;
استورد compiler.msir.ssf.borrow_flow;

// Drop elaboration (docs/en/internals/ownership-analysis.md): the one pass
// that turns the destruction obligations of initial MSIR into the concrete
// destruction finalized MSIR performs. It runs on verified initial MSIR,
// after which ownership glue (lowering/ownership_glue.sn) gives every release
// its Type's drop glue, and before the canonical verification of finalized
// MSIR that every later consumer relies on.
//
// Lowering describes each owner (a local, a parameter, a match binding or a
// temporary that owns its value) by its function-local place and three
// ownership operations on it (msir_model.sn, ملكية_مكان_مسير): تهيئة after
// the store that gives it a value, تسليم where the value leaves it, and
// إسقاط where the value must be destroyed if it is still held (a scope exit,
// the function's exit block, the old value before an assignment). Which
// reads of an owner move its value out is derived here first, from the uses
// of each load of its place (see "Moves out of owners" below). Lowering also
// states تصريح at the declaration of every source local, owner or not; it is
// the legality analysis's and changes no state here (an owner's scope exit
// already left it holding none), and like every ownership operation it
// leaves no instruction.
//
// Initialization dataflow. For every owner and every block entry the pass
// computes whether the owner holds a value on every path that reaches it, on
// none, or on some only. The state is a small lattice (unreached < holds
// none, holds one < on some paths only); the entry block starts with every
// owner holding none, each operation sets the state it names, and a join
// takes the least state above both. A worklist iterates to the fixed point,
// so loops and their back edges converge (at most three changes per owner
// and block).
//
// Rewriting. Each obligation is then resolved with the state reaching it:
//   holds one          an unconditional destruction (load, release)
//   holds none         nothing: the obligation is dead and removed
//   on some paths only the owner gets a boolean flag, stored true at each
//                      تهيئة and false at each تسليم and destruction, and
//                      the obligation becomes `if flag { flag = false;
//                      release(load place) }`
// An owner gets a flag only when one of its obligations needs one; the
// operations of other owners leave no trace. Every ownership operation is
// removed. A value is destroyed only where the state says it is held, and the
// state is cleared at the destruction, so no moved or released value is
// destroyed and none is destroyed twice. A destruction is the release
// primitive (تحرير) on the value; ownership glue rewrites it into the value
// Type's drop glue, the one provider of Type-specific destruction.

عرف ادمج_حالة_مالك_تفصيل(الأولى: طبيعي, الثانية: طبيعي): طبيعي {
    إذا (الأولى == 0) { أرجع الثانية; };
    إذا (الثانية == 0) { أرجع الأولى; };
    إذا (الأولى == الثانية) { أرجع الأولى; };
    أرجع 3;
}

// The ownership operation an instruction performs, if it is one.
عرف ملكية_تعليمة_تفصيل(العملية: &عملية_مسير): اختياري ملكية_مكان_مسير {
    طابق *العملية مع
    | عملية_مسير.ملكية_مكان(الملكية) -> { أرجع اختياري.موجود(الملكية); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حدث_ملكية_تصريح_تفصيل(الحدث: حدث_ملكية_مسير): منطقي {
    طابق الحدث مع
    | حدث_ملكية_مسير.تصريح -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The owner number (its position plus one) of a place, or 0.
عرف رقم_مالك_تفصيل(الأرقام: &متجه طبيعي, المكان: معرف_قيمة_مسير): طبيعي {
    دع الموضع: طبيعي = المكان.القيمة مثل طبيعي;
    إذا (الموضع >= (الطول(*الأرقام) مثل طبيعي)) { أرجع 0; };
    أرجع (*الأرقام)[الموضع];
}

// The state after one instruction.
عرف طبق_تعليمة_تفصيل(
    العملية: &عملية_مسير,
    الأرقام: &متجه طبيعي,
    الحالة: &متغير متجه طبيعي
): فراغ {
    طابق ملكية_تعليمة_تفصيل(العملية) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الملكية) -> {
        دع الرقم: طبيعي = رقم_مالك_تفصيل(الأرقام, الملكية.المكان);
        إذا (الرقم > 0) {
            طابق الملكية.الحدث مع
            | حدث_ملكية_مسير.تصريح -> { }
            | حدث_ملكية_مسير.تهيئة -> { (*الحالة)[الرقم - 1] := 2; }
            | حدث_ملكية_مسير.تسليم -> { (*الحالة)[الرقم - 1] := 1; }
            | حدث_ملكية_مسير.إسقاط -> { (*الحالة)[الرقم - 1] := 1; };
        };
    };
}

// The state at the entry of block الكتلة.
عام عرف حالة_دخول_تفصيل(الدخول: &متجه طبيعي, الكتلة: طبيعي, العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) {
        ألحق(الناتج, (*الدخول)[(الكتلة * العدد) + م]);
        م := م + 1;
    }
    أرجع الناتج;
}

عرف قيمة_بناء_تفصيل(الناتج: نتيجة_بناء_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_بناء_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة.خطأ(خطأ_بناء_مسير.قيمة_غير_موجودة(معرف_قيمة_مسير_من(معرف_دالة_مسير_من(0), 0)));
    };
}

عرف بلا_قيمة_تفصيل(الناتج: نتيجة_بناء_قيمة_مسير): اختياري خطأ_بناء_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف منهي_تفصيل(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_بناء_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
}

// Stores a boolean constant into an owner's flag, in الكتلة.
عرف اكتب_علم_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    العلم: معرف_قيمة_مسير,
    القيمة: منطقي,
    نوع_المنطق: معرف_نوع
): اختياري خطأ_بناء_مسير {
    دع الثابت: معرف_قيمة_مسير;
    طابق قيمة_بناء_تفصيل(أصدر_ثابتا_مسير(
        البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.منطق(القيمة), نوع_المنطق
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الثابت := المعرف; };
    أرجع بلا_قيمة_تفصيل(أصدر_تخزين_مسير(البرنامج, البناء, الدالة, الكتلة, العلم, الثابت));
}

// Destroys the value held in المكان, in الكتلة: the release primitive on it.
عرف أصدر_تدمير_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    المكان: معرف_قيمة_مسير,
    النوع: معرف_نوع
): اختياري خطأ_بناء_مسير {
    دع القيمة: معرف_قيمة_مسير;
    طابق قيمة_بناء_تفصيل(أصدر_تحميل_مسير(البرنامج, البناء, الدالة, الكتلة, المكان, النوع)) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { القيمة := المعرف; };
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    أرجع بلا_قيمة_تفصيل(أصدر_نداء_بدائي_مسير(
        البرنامج, البناء, الدالة, الكتلة, هوية_بدائي_مترجم.تحرير(), &الحجج,
        اختياري.لا_شيء(), اختياري.لا_شيء()
    ));
}

// The owners of function د: every place an ownership operation names, in
// first-seen order. الأرقام maps a value position to its owner number.
عرف اجمع_مالكي_دالة_تفصيل(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    الأرقام: &متغير متجه طبيعي,
    الأماكن: &متغير متجه معرف_قيمة_مسير
): فراغ {
    دع عدد_القيم: طبيعي = الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي;
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_القيم) { ألحق(*الأرقام, 0); ق := ق + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق ملكية_تعليمة_تفصيل(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية) مع
            | اختياري.موجود(الملكية) -> {
                دع الموضع: طبيعي = الملكية.المكان.القيمة مثل طبيعي;
                // A declaration names every source local, owner or not.
                دع هو_تصريح: منطقي = حدث_ملكية_تصريح_تفصيل(الملكية.الحدث);
                إذا (!هو_تصريح && الموضع < عدد_القيم) {
                    إذا ((*الأرقام)[الموضع] == 0) {
                        ألحق(*الأماكن, الملكية.المكان);
                        (*الأرقام)[الموضع] := الطول(*الأماكن) مثل طبيعي;
                    };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

// The lattices of the initialization dataflow (احسب_حالات_دخول_شبكة_مسير):
// the owner states of drop elaboration (0 unreached, 1 holds none, 2 holds
// one, 3 on some paths only), the states of a source local in the ownership
// legality analysis (ssf/ownership_legality.sn, ادمج_حالة_شرعية_مسير), the
// borrow state of the locals (ssf/borrow_flow.sn, وصف_استعارات_مسير), and
// the liveness of the locals that hold borrows (ssf/borrow_liveness.sn: 0
// dead, 1 live; a join is live when either side is), followed backward.
عام نوع شبكة_تهيئة_مسير =
    | ملكية
    | شرعية
    | استعارات
    | حياة
;

// The state each block sets, as the last state each of its instructions
// writes, for every slot: pairs slot, state in instruction order (a later
// pair overrides an earlier one). احسب_حالات_دخول_شبكة_مسير takes one per block.
عام عرف طبق_ملخص_كتلة_مسير(الملخص: &متجه طبيعي, الحالة: &متغير متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما ((ف + 1) < (الطول(*الملخص) مثل طبيعي)) {
        (*الحالة)[(*الملخص)[ف]] := (*الملخص)[ف + 1];
        ف := ف + 2;
    }
}

عرف ادمج_حالة_شبكة_مسير(الشبكة: شبكة_تهيئة_مسير, الأولى: طبيعي, الثانية: طبيعي): طبيعي {
    طابق الشبكة مع
    | شبكة_تهيئة_مسير.ملكية -> { أرجع ادمج_حالة_مالك_تفصيل(الأولى, الثانية); }
    | شبكة_تهيئة_مسير.شرعية -> { أرجع ادمج_حالة_شرعية_مسير(الأولى, الثانية); }
    | شبكة_تهيئة_مسير.استعارات -> { أرجع الأولى; }
    | شبكة_تهيئة_مسير.حياة -> {
        إذا (الثانية > الأولى) { أرجع الثانية; };
        أرجع الأولى;
    };
}

// The legality lattice: a state is its kind (the value modulo 8) and, for a
// moved value, where it moved (the value divided by 8: a use number plus
// one, 0 for none). Kinds: 0 unreached, 1 holds none (declared, not yet
// given a value), 2 holds a value, 3 moved out, 4 released, 5 holds none on
// some paths, 6 moved out on some paths, 7 released on some paths. A join of
// two different kinds is a some-paths kind: moved out if either side may be,
// else released if either may be, else holds none. Where both sides moved
// out, the earlier use (the smaller number, the one written first) is kept.
عام عرف ادمج_حالة_شرعية_مسير(الأولى: طبيعي, الثانية: طبيعي): طبيعي {
    إذا (الأولى == 0) { أرجع الثانية; };
    إذا (الثانية == 0) { أرجع الأولى; };
    دع صنف_أ: طبيعي = الأولى % 8;
    دع صنف_ب: طبيعي = الثانية % 8;
    دع أصل_أ: طبيعي = الأولى / 8;
    دع أصل_ب: طبيعي = الثانية / 8;
    دع الأصل: متغير طبيعي = أصل_أ;
    إذا (الأصل == 0 || (أصل_ب != 0 && أصل_ب < الأصل)) { الأصل := أصل_ب; };
    إذا (صنف_أ == صنف_ب) { أرجع صنف_أ + (8 * الأصل); };
    دع منقولة: منطقي = صنف_أ == 3 || صنف_أ == 6 || صنف_ب == 3 || صنف_ب == 6;
    دع محررة: منطقي = صنف_أ == 4 || صنف_أ == 7 || صنف_ب == 4 || صنف_ب == 7;
    إذا (منقولة) { أرجع 6 + (8 * الأصل); };
    إذا (محررة) { أرجع 7; };
    أرجع 5;
}

// The fixed point of an initialization dataflow over the blocks of function
// الدالة: the state of each of العدد slots at each block entry (block-major).
// Each block applies its summary (الملخصات, طبق_ملخص_كتلة_مسير); a join
// takes the least state above both (الشبكة). The entry block starts with
// البداية, every other block unreached (0); a worklist iterates to the fixed
// point, so loops and their back edges converge. With بلا_رجوع, an edge to a
// block whose rank (الرتب) is not above the source's is left out: the states
// before any loop body repeats.
// For the borrow state (شبكة_تهيئة_مسير.استعارات, described by
// الاستعارات) a summary is a block's events (طبق_ملخص_استعارات_مسير), a
// join is the source's (ادمج_حالتي_استعارات_مسير), a state first reaching
// a block is taken whole, and the pending block of least rank goes first:
// the predecessors of an if or a match join in their order, a loop header
// receives its entry before its back edges.
عام عرف احسب_حالات_دخول_شبكة_مسير(
    الدالة: &دالة_مسير,
    المدخل: طبيعي,
    العدد: طبيعي,
    البداية: &متجه طبيعي,
    الملخصات: &متجه متجه طبيعي,
    الشبكة: شبكة_تهيئة_مسير,
    الرتب: &متجه طبيعي,
    بلا_رجوع: منطقي,
    الاستعارات: &وصف_استعارات_مسير
): متجه طبيعي {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    // The successors each block hands its state to, once.
    دع الخلفاء: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل && العدد > 0) {
        دع المعرفات: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ف]);
        دع الأرقام: متغير متجه طبيعي = [];
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(المعرفات) مثل طبيعي)) {
            دع الخلف: طبيعي = المعرفات[خ].القيمة مثل طبيعي;
            دع متروكة: متغير منطقي = الخلف >= عدد_الكتل;
            إذا (!متروكة && بلا_رجوع) { متروكة := (*الرتب)[الخلف] <= (*الرتب)[ف]; };
            إذا (!متروكة) { ألحق(الأرقام, الخلف); };
            خ := خ + 1;
        }
        ألحق(الخلفاء, الأرقام);
        ف := ف + 1;
    }
    دع المداخل: متجه طبيعي = [المدخل];
    أرجع احسب_حالات_شبكة_على_خلفاء_مسير(
        عدد_الكتل, &الخلفاء, &المداخل, العدد, البداية, الملخصات, الشبكة, الرتب, الاستعارات
    );
}

// The same fixed point over a graph given as the blocks each of عدد_الكتل
// blocks hands its state to (الخلفاء), from the blocks المداخل, each of which
// starts with البداية (every other block unreached). The liveness of the
// locals that hold borrows (ssf/borrow_liveness.sn) runs it backward: each
// block hands its state to its predecessors, every block starts dead, and the
// state at a block's "entry" is the one at its end.
عام عرف احسب_حالات_شبكة_على_خلفاء_مسير(
    عدد_الكتل: طبيعي,
    الخلفاء: &متجه متجه طبيعي,
    المداخل: &متجه طبيعي,
    العدد: طبيعي,
    البداية: &متجه طبيعي,
    الملخصات: &متجه متجه طبيعي,
    الشبكة: شبكة_تهيئة_مسير,
    الرتب: &متجه طبيعي,
    الاستعارات: &وصف_استعارات_مسير
): متجه طبيعي {
    دع استعارات: متغير منطقي = خطأ;
    طابق الشبكة مع
    | شبكة_تهيئة_مسير.استعارات -> { استعارات := صواب; }
    | _ -> { };
    دع الدخول: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (عدد_الكتل * العدد)) { ألحق(الدخول, 0); ف := ف + 1; }
    إذا (العدد == 0) { أرجع الدخول; };
    دع الواصلة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_الكتل) { ألحق(الواصلة, خطأ); ف := ف + 1; }
    دع في_القائمة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < عدد_الكتل) { ألحق(في_القائمة, خطأ); ف := ف + 1; }
    دع القائمة: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول(*المداخل) مثل طبيعي)) {
        دع المدخل: طبيعي = (*المداخل)[ف];
        إذا (المدخل < عدد_الكتل && !في_القائمة[المدخل]) {
            م := 0;
            طالما (م < العدد) { الدخول[(المدخل * العدد) + م] := (*البداية)[م]; م := م + 1; }
            الواصلة[المدخل] := صواب;
            في_القائمة[المدخل] := صواب;
            ألحق(القائمة, المدخل);
        };
        ف := ف + 1;
    }
    دع الحالة: متغير متجه طبيعي = [];
    م := 0;
    طالما (م < العدد) { ألحق(الحالة, 0); م := م + 1; }
    دع الرأس: متغير طبيعي = 0;
    طالما (الرأس < (الطول(القائمة) مثل طبيعي)) {
        إذا (استعارات) {
            دع الأدنى: متغير طبيعي = الرأس;
            دع ب: متغير طبيعي = الرأس + 1;
            طالما (ب < (الطول(القائمة) مثل طبيعي)) {
                إذا ((*الرتب)[القائمة[ب]] < (*الرتب)[القائمة[الأدنى]]) { الأدنى := ب; };
                ب := ب + 1;
            }
            دع المختارة: طبيعي = القائمة[الأدنى];
            القائمة[الأدنى] := القائمة[الرأس];
            القائمة[الرأس] := المختارة;
        };
        دع ك: طبيعي = القائمة[الرأس];
        الرأس := الرأس + 1;
        في_القائمة[ك] := خطأ;
        م := 0;
        طالما (م < العدد) { الحالة[م] := الدخول[(ك * العدد) + م]; م := م + 1; }
        إذا (استعارات) {
            طبق_ملخص_استعارات_مسير(الاستعارات, &(*الملخصات)[ك], &متغير الحالة);
        } وإلا {
            طبق_ملخص_كتلة_مسير(&(*الملخصات)[ك], &متغير الحالة);
        };
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول((*الخلفاء)[ك]) مثل طبيعي)) {
            دع الخلف: طبيعي = (*الخلفاء)[ك][خ];
            دع تغير: متغير منطقي = خطأ;
            دع القاعدة: طبيعي = الخلف * العدد;
            م := 0;
            // A state first reaching a block is taken whole (a reached
            // block is processed even when every slot is 0).
            إذا (!الواصلة[الخلف]) {
                الواصلة[الخلف] := صواب;
                تغير := صواب;
                طالما (م < العدد) { الدخول[القاعدة + م] := الحالة[م]; م := م + 1; }
            } وإلا إذا (استعارات) {
                تغير := ادمج_حالتي_استعارات_مسير(الاستعارات, &متغير الدخول, القاعدة, &الحالة);
                م := العدد;
            };
            طالما (م < العدد) {
                دع القديمة: طبيعي = الدخول[القاعدة + م];
                دع الواردة: طبيعي = الحالة[م];
                إذا (القديمة != الواردة) {
                    دع الجديدة: طبيعي = ادمج_حالة_شبكة_مسير(الشبكة, القديمة, الواردة);
                    إذا (الجديدة != القديمة) {
                        الدخول[القاعدة + م] := الجديدة;
                        تغير := صواب;
                    };
                };
                م := م + 1;
            }
            إذا (تغير && !في_القائمة[الخلف]) {
                ألحق(القائمة, الخلف);
                في_القائمة[الخلف] := صواب;
            };
            خ := خ + 1;
        }
    }
    أرجع الدخول;
}

// The summary of each block for the owner dataflow: the state each ownership
// operation sets (طبق_تعليمة_تفصيل).
عرف ملخصات_مالكين_تفصيل(البرنامج: &برنامج_مسير, د: طبيعي, الأرقام: &متجه طبيعي): متجه متجه طبيعي {
    دع الناتج: متغير متجه متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع الملخص: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق ملكية_تعليمة_تفصيل(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية) مع
            | اختياري.موجود(الملكية) -> {
                دع الرقم: طبيعي = رقم_مالك_تفصيل(الأرقام, الملكية.المكان);
                إذا (الرقم > 0) {
                    طابق الملكية.الحدث مع
                    | حدث_ملكية_مسير.تصريح -> { }
                    | حدث_ملكية_مسير.تهيئة -> { ألحق(الملخص, الرقم - 1); ألحق(الملخص, 2); }
                    | حدث_ملكية_مسير.تسليم -> { ألحق(الملخص, الرقم - 1); ألحق(الملخص, 1); }
                    | حدث_ملكية_مسير.إسقاط -> { ألحق(الملخص, الرقم - 1); ألحق(الملخص, 1); };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ألحق(الناتج, الملخص);
        ك := ك + 1;
    }
    أرجع الناتج;
}

// The fixed point of the owner dataflow: the state of each owner at each
// block entry (block-major, العدد owners per block). Every owner holds none
// at the function's entry.
عرف احسب_حالات_دخول_تفصيل(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    المدخل: طبيعي,
    الأرقام: &متجه طبيعي,
    العدد: طبيعي
): متجه طبيعي {
    دع البداية: متغير متجه طبيعي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) { ألحق(البداية, 1); م := م + 1; }
    دع الملخصات: متجه متجه طبيعي = ملخصات_مالكين_تفصيل(البرنامج, د, الأرقام);
    دع بلا_رتب: متجه طبيعي = [];
    دع بلا_استعارات: وصف_استعارات_مسير = وصف_استعارات_فارغ_مسير();
    أرجع احسب_حالات_دخول_شبكة_مسير(
        &(*البرنامج).الدوال[د], المدخل, العدد, &البداية, &الملخصات, شبكة_تهيئة_مسير.ملكية(),
        &بلا_رتب, خطأ, &بلا_استعارات
    );
}

// Which owners need a flag: those with an obligation reached on some paths
// holding a value and on others holding none.
عرف مالكون_بأعلام_تفصيل(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    الدخول: &متجه طبيعي,
    الأرقام: &متجه طبيعي,
    العدد: طبيعي
): متجه منطقي {
    دع الناتج: متغير متجه منطقي = [];
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) { ألحق(الناتج, خطأ); م := م + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع الحالة: متغير متجه طبيعي = حالة_دخول_تفصيل(الدخول, ك, العدد);
        إذا (الحالة[0] != 0) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق ملكية_تعليمة_تفصيل(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية) مع
                | اختياري.موجود(الملكية) -> {
                    دع الرقم: طبيعي = رقم_مالك_تفصيل(الأرقام, الملكية.المكان);
                    طابق الملكية.الحدث مع
                    | حدث_ملكية_مسير.إسقاط -> {
                        إذا (الرقم > 0) {
                            إذا (الحالة[الرقم - 1] == 3) { الناتج[الرقم - 1] := صواب; };
                        };
                    }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
                طبق_تعليمة_تفصيل(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية, الأرقام, &متغير الحالة);
                ت := ت + 1;
            }
        };
        ك := ك + 1;
    }
    أرجع الناتج;
}

// Allocates the flag of every owner that needs one at the start of the entry
// block, which dominates every use, each initialized false.
عرف أصدر_أعلام_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    د: طبيعي,
    المدخل: طبيعي,
    المحتاجة: &متجه منطقي,
    الأعلام: &متغير متجه اختياري معرف_قيمة_مسير,
    نوع_المنطق: معرف_نوع
): اختياري خطأ_بناء_مسير {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الكتلة: معرف_كتلة_مسير = (*البرنامج).الدوال[د].الكتل[المدخل].المعرف;
    دع القديمة: متغير متجه تعليمة_مسير = [];
    بدّل((*البرنامج).الدوال[د].الكتل[المدخل].التعليمات, القديمة);
    دع المنهي: متغير اختياري منهي_مسير = اختياري.لا_شيء();
    بدّل((*البرنامج).الدوال[د].الكتل[المدخل].المنهي, المنهي);
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(*المحتاجة) مثل طبيعي)) {
        إذا ((*المحتاجة)[م]) {
            دع العلم: معرف_قيمة_مسير;
            طابق قيمة_بناء_تفصيل(أصدر_مكان_محلي_مسير(
                البرنامج, &البناء, الدالة, الكتلة, نوع_المنطق, صواب
            )) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(المعرف) -> { العلم := المعرف; };
            طابق اكتب_علم_تفصيل(البرنامج, &البناء, الدالة, الكتلة, العلم, خطأ, نوع_المنطق) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
            (*الأعلام)[م] := اختياري.موجود(العلم);
        };
        م := م + 1;
    }
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول(القديمة) مثل طبيعي)) {
        دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
        بدّل(القديمة[ت], المنقولة);
        ألحق((*البرنامج).الدوال[د].الكتل[المدخل].التعليمات, المنقولة);
        ت := ت + 1;
    }
    (*البرنامج).الدوال[د].الكتل[المدخل].المنهي := المنهي;
    أرجع اختياري.لا_شيء();
}

// One obligation reached on some paths only: `if flag { flag = false;
// release(load place) }` starting in الكتلة. Returns the block where the
// rest of the original block continues.
عرف أصدر_تدمير_مشروط_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    العلم: معرف_قيمة_مسير,
    المكان: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    نوع_المنطق: معرف_نوع
): نتيجة معرف_كتلة_مسير, خطأ_بناء_مسير {
    دع قيمة_العلم: معرف_قيمة_مسير;
    طابق قيمة_بناء_تفصيل(أصدر_تحميل_مسير(البرنامج, البناء, الدالة, الكتلة, العلم, نوع_المنطق)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { قيمة_العلم := المعرف; };
    دع كتلة_التدمير: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { كتلة_التدمير := المعرف; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(خ) -> { أرجع نتيجة.خطأ(خ); };
    دع كتلة_المتابعة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { كتلة_المتابعة := المعرف; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(خ) -> { أرجع نتيجة.خطأ(خ); };
    دع بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    دع بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    دع إلى_التدمير: حافة_مسير = { الهدف: كتلة_التدمير, الحجج: بلا_حجج_أ };
    دع إلى_المتابعة: حافة_مسير = { الهدف: كتلة_المتابعة, الحجج: بلا_حجج_ب };
    طابق منهي_تفصيل(اختم_بفرع_شرطي_مسير(
        البرنامج, البناء, الدالة, الكتلة, قيمة_العلم, إلى_التدمير, إلى_المتابعة
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    // The flag is cleared before the destruction runs.
    طابق اكتب_علم_تفصيل(البرنامج, البناء, الدالة, كتلة_التدمير, العلم, خطأ, نوع_المنطق) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    طابق أصدر_تدمير_تفصيل(البرنامج, البناء, الدالة, كتلة_التدمير, المكان, النوع) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع بلا_حجج_ج: متجه معرف_قيمة_مسير = [];
    طابق منهي_تفصيل(اختم_بفرع_مسير(البرنامج, البناء, الدالة, كتلة_التدمير, كتلة_المتابعة, &بلا_حجج_ج)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(كتلة_المتابعة);
}

// Rewrites block ك of function د with the state reaching its entry: each
// ownership operation is replaced by what the state requires (see the top of
// this file). The block may be split at a conditional destruction; its
// terminator then ends the last part.
عرف أعد_كتابة_كتلة_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    د: طبيعي,
    ك: طبيعي,
    دخول_الكتلة: متجه طبيعي,
    الأرقام: &متجه طبيعي,
    الأعلام: &متجه اختياري معرف_قيمة_مسير,
    نوع_المنطق: معرف_نوع
): اختياري خطأ_بناء_مسير {
    دع الحالة: متغير متجه طبيعي = دخول_الكتلة;
    دع مبلوغة: منطقي = الحالة[0] != 0;
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع القديمة: متغير متجه تعليمة_مسير = [];
    بدّل((*البرنامج).الدوال[د].الكتل[ك].التعليمات, القديمة);
    دع المنهي: متغير اختياري منهي_مسير = اختياري.لا_شيء();
    بدّل((*البرنامج).الدوال[د].الكتل[ك].المنهي, المنهي);
    دع موقع_المنهي: مرجع_موقع_تصحيح_مسير = (*البرنامج).الدوال[د].الكتل[ك].موقع_تصحيح_المنهي;
    دع نطاق_المنهي: مرجع_نطاق_تصحيح_مسير = (*البرنامج).الدوال[د].الكتل[ك].نطاق_تصحيح_المنهي;
    دع الحالية: متغير معرف_كتلة_مسير = (*البرنامج).الدوال[د].الكتل[ك].المعرف;
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول(القديمة) مثل طبيعي)) {
        دع التعليمة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
        بدّل(القديمة[ت], التعليمة);
        دع الملكية: اختياري ملكية_مكان_مسير = ملكية_تعليمة_تفصيل(&التعليمة.العملية);
        طابق الملكية مع
        | اختياري.لا_شيء -> {
            ألحق((*البرنامج).الدوال[د].الكتل[الحالية.القيمة].التعليمات, التعليمة);
        }
        | اختياري.موجود(العملية) -> {
            دع الرقم: طبيعي = رقم_مالك_تفصيل(الأرقام, العملية.المكان);
            إذا (مبلوغة && (الرقم > 0)) {
                // What replaces the operation keeps its source line.
                دع البناء: متغير حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
                البناء.موقع_التصحيح_الحالي := موقع_تصحيح_من_مرجع_مسير(التعليمة.موقع_التصحيح);
                البناء.نطاق_التصحيح_الحالي := نطاق_تصحيح_من_مرجع_مسير(التعليمة.نطاق_التصحيح);
                دع العلم: اختياري معرف_قيمة_مسير = (*الأعلام)[الرقم - 1];
                دع نوع_المكان: معرف_نوع = (*البرنامج).الدوال[د].القيم[العملية.المكان.القيمة].النوع;
                طابق العملية.الحدث مع
                | حدث_ملكية_مسير.تصريح -> { }
                | حدث_ملكية_مسير.تهيئة -> {
                    طابق العلم مع
                    | اختياري.موجود(ع) -> {
                        طابق اكتب_علم_تفصيل(البرنامج, &البناء, الدالة, الحالية, ع, صواب, نوع_المنطق) مع
                        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    الحالة[الرقم - 1] := 2;
                }
                | حدث_ملكية_مسير.تسليم -> {
                    طابق العلم مع
                    | اختياري.موجود(ع) -> {
                        طابق اكتب_علم_تفصيل(البرنامج, &البناء, الدالة, الحالية, ع, خطأ, نوع_المنطق) مع
                        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    الحالة[الرقم - 1] := 1;
                }
                | حدث_ملكية_مسير.إسقاط -> {
                    دع الحالية_للمالك: طبيعي = الحالة[الرقم - 1];
                    إذا (الحالية_للمالك == 2) {
                        طابق العلم مع
                        | اختياري.موجود(ع) -> {
                            طابق اكتب_علم_تفصيل(البرنامج, &البناء, الدالة, الحالية, ع, خطأ, نوع_المنطق) مع
                            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                        طابق أصدر_تدمير_تفصيل(البرنامج, &البناء, الدالة, الحالية, العملية.المكان, نوع_المكان) مع
                        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                        | اختياري.لا_شيء -> { };
                    };
                    إذا (الحالية_للمالك == 3) {
                        طابق العلم مع
                        | اختياري.موجود(ع) -> {
                            طابق أصدر_تدمير_مشروط_تفصيل(
                                البرنامج, &البناء, الدالة, الحالية, ع, العملية.المكان,
                                نوع_المكان, نوع_المنطق
                            ) مع
                            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                            | نتيجة.نجح(التالية) -> { الحالية := التالية; };
                        }
                        | اختياري.لا_شيء -> {
                            أرجع اختياري.موجود(خطأ_بناء_مسير.قيمة_غير_موجودة(العملية.المكان));
                        };
                    };
                    الحالة[الرقم - 1] := 1;
                };
            };
        };
        ت := ت + 1;
    }
    (*البرنامج).الدوال[د].الكتل[الحالية.القيمة].المنهي := المنهي;
    (*البرنامج).الدوال[د].الكتل[الحالية.القيمة].موقع_تصحيح_المنهي := موقع_المنهي;
    (*البرنامج).الدوال[د].الكتل[الحالية.القيمة].نطاق_تصحيح_المنهي := نطاق_المنهي;
    أرجع اختياري.لا_شيء();
}

// Moves out of owners, derived from MSIR. A read of an owner's value is a
// load of its place; the read moves the value out when the loaded value
// reaches a use that takes ownership of it:
//   a store (into any place but that of a source local that is no owner: a
//   borrowed view initialized from the value leaves it to its owner), an argument of a call of a SultanC function, an
//   external function or a function value (parameters own their values), a
//   member of an aggregate, a vector, a tagged value or a box, a closure
//   capture, a block argument, a returned value, and the owning argument of
//   the three primitives that consume one (release, the appended element of
//   append, and leak).
// Two derived values pass the question back to their source: the retype of an
// owned sequence (نقل_تسلسل_مملوك) and the payload read out of an owned box
// (a load of صندوق_إلى_مكان): moving either out moves the source, the box
// itself in the second case. A derived value that owns nothing (a vector
// viewed as a slice, a plain payload) takes nothing. Every other use (a primitive that reads the value, a field
// or payload extraction, a tag query, a retain that copies a counted value)
// reads the value in place, and the owner keeps it. Each move becomes تسليم
// right after the load.
عرف علم_استهلاك_تفصيل(المستهلكة: &متغير متجه منطقي, القيمة: معرف_قيمة_مسير): فراغ {
    دع الموضع: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (الموضع < (الطول(*المستهلكة) مثل طبيعي)) { (*المستهلكة)[الموضع] := صواب; };
}

عرف علم_قيم_استهلاك_تفصيل(المستهلكة: &متغير متجه منطقي, القيم: &متجه معرف_قيمة_مسير): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        علم_استهلاك_تفصيل(المستهلكة, (*القيم)[ف]);
        ف := ف + 1;
    }
}

// Records that the value at الناتج derives from the value at المصدر
// (positions plus one, 0 for none).
عرف اربط_أصل_تفصيل(المحولة: &متغير متجه طبيعي, الناتج: اختياري طبيعي, المصدر: طبيعي): فراغ {
    طابق الناتج مع
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع < (الطول(*المحولة) مثل طبيعي)) { (*المحولة)[الموضع] := المصدر + 1; };
    }
    | اختياري.لا_شيء -> { };
}

عرف علم_عملية_استهلاك_تفصيل(
    العملية: &عملية_مسير,
    الناتج: اختياري طبيعي,
    المستهلكة: &متغير متجه منطقي,
    المحولة: &متغير متجه طبيعي
): فراغ {
    طابق *العملية مع
    | عملية_مسير.تخزين(ت) -> { علم_استهلاك_تفصيل(المستهلكة, ت.القيمة); }
    | عملية_مسير.تجميع(ت) -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &ت.الأعضاء); }
    | عملية_مسير.تهيئة_متجه(ت) -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &ت.العناصر); }
    | عملية_مسير.بناء_موسوم(ب) -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &ب.الحمولات); }
    | عملية_مسير.بناء_صندوق(ب) -> { علم_استهلاك_تفصيل(المستهلكة, ب.القيمة); }
    | عملية_مسير.بناء_إغلاق(ب) -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &ب.الالتقاطات); }
    | عملية_مسير.نقل_تسلسل_مملوك(ن) -> {
        اربط_أصل_تفصيل(المحولة, الناتج, ن.المصدر.القيمة مثل طبيعي);
    }
    | عملية_مسير.صندوق_إلى_مكان(ص) -> {
        اربط_أصل_تفصيل(المحولة, الناتج, ص.الصندوق.القيمة مثل طبيعي);
    }
    | عملية_مسير.تحميل(ت) -> {
        // A load through a box place reads the box's payload.
        دع المكان: طبيعي = ت.المكان.القيمة مثل طبيعي;
        إذا (المكان < (الطول(*المحولة) مثل طبيعي)) {
            دع أصل_المكان: طبيعي = (*المحولة)[المكان];
            إذا (أصل_المكان != 0) { اربط_أصل_تفصيل(المحولة, الناتج, أصل_المكان - 1); };
        };
    }
    | عملية_مسير.نداء(ن) -> {
        طابق ن.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            دع العدد: طبيعي = الطول(ن.الحجج) مثل طبيعي;
            طابق البدائي مع
            | هوية_بدائي_مترجم.تحرير -> { إذا (العدد > 0) { علم_استهلاك_تفصيل(المستهلكة, ن.الحجج[0]); }; }
            | هوية_بدائي_مترجم.سرب_قيمة -> { إذا (العدد > 0) { علم_استهلاك_تفصيل(المستهلكة, ن.الحجج[0]); }; }
            | هوية_بدائي_مترجم.إلحاق -> { إذا (العدد > 1) { علم_استهلاك_تفصيل(المستهلكة, ن.الحجج[1]); }; }
            | _ -> { };
        }
        | _ -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &ن.الحجج); };
    }
    | _ -> { };
}

عرف علم_منهي_استهلاك_تفصيل(المنهي: &اختياري منهي_مسير, المستهلكة: &متغير متجه منطقي): فراغ {
    طابق *المنهي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | منهي_مسير.فرع(الحافة) -> { علم_قيم_استهلاك_تفصيل(المستهلكة, &الحافة.الحجج); }
        | منهي_مسير.فرع_شرطي(_, أ, ب) -> {
            علم_قيم_استهلاك_تفصيل(المستهلكة, &أ.الحجج);
            علم_قيم_استهلاك_تفصيل(المستهلكة, &ب.الحجج);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            علم_قيم_استهلاك_تفصيل(المستهلكة, &الفرع.الافتراضي.الحجج);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                علم_قيم_استهلاك_تفصيل(المستهلكة, &الفرع.الحالات[ف].الحافة.الحجج);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(اختياري.موجود(ق)) -> { علم_استهلاك_تفصيل(المستهلكة, ق); }
        | _ -> { };
    };
}

// The values instruction العملية takes ownership of (the owning uses above),
// appended to الناتج as positions; a store into the place of a source local
// that is no owner (غير_مالكة, by place position) takes nothing.
عام عرف ألحق_قيم_مأخوذة_تعليمة_مسير(
    العملية: &عملية_مسير,
    غير_مالكة: &متجه منطقي,
    الناتج: &متغير متجه طبيعي
): فراغ {
    طابق *العملية مع
    | عملية_مسير.تخزين(ت) -> {
        دع المكان: طبيعي = ت.المكان.القيمة مثل طبيعي;
        إذا (المكان < (الطول(*غير_مالكة) مثل طبيعي) && (*غير_مالكة)[المكان]) { أرجع; };
        ألحق(*الناتج, ت.القيمة.القيمة مثل طبيعي);
    }
    | عملية_مسير.تجميع(ت) -> { ألحق_معرفات_مأخوذة_مسير(&ت.الأعضاء, الناتج); }
    | عملية_مسير.تهيئة_متجه(ت) -> { ألحق_معرفات_مأخوذة_مسير(&ت.العناصر, الناتج); }
    | عملية_مسير.بناء_موسوم(ب) -> { ألحق_معرفات_مأخوذة_مسير(&ب.الحمولات, الناتج); }
    | عملية_مسير.بناء_صندوق(ب) -> { ألحق(*الناتج, ب.القيمة.القيمة مثل طبيعي); }
    | عملية_مسير.بناء_إغلاق(ب) -> { ألحق_معرفات_مأخوذة_مسير(&ب.الالتقاطات, الناتج); }
    | عملية_مسير.نداء(ن) -> {
        طابق ن.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
            دع العدد: طبيعي = الطول(ن.الحجج) مثل طبيعي;
            طابق البدائي مع
            | هوية_بدائي_مترجم.تحرير -> { إذا (العدد > 0) { ألحق(*الناتج, ن.الحجج[0].القيمة مثل طبيعي); }; }
            | هوية_بدائي_مترجم.سرب_قيمة -> { إذا (العدد > 0) { ألحق(*الناتج, ن.الحجج[0].القيمة مثل طبيعي); }; }
            | هوية_بدائي_مترجم.إلحاق -> { إذا (العدد > 1) { ألحق(*الناتج, ن.الحجج[1].القيمة مثل طبيعي); }; }
            | _ -> { };
        }
        | _ -> { ألحق_معرفات_مأخوذة_مسير(&ن.الحجج, الناتج); };
    }
    | _ -> { };
}

عام عرف ألحق_معرفات_مأخوذة_مسير(القيم: &متجه معرف_قيمة_مسير, الناتج: &متغير متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) { ألحق(*الناتج, (*القيم)[ف].القيمة مثل طبيعي); ف := ف + 1; }
}

// The values a block's terminator takes ownership of: block arguments and the
// returned value.
عام عرف ألحق_قيم_مأخوذة_منهي_مسير(المنهي: &اختياري منهي_مسير, الناتج: &متغير متجه طبيعي): فراغ {
    طابق *المنهي مع
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | منهي_مسير.فرع(الحافة) -> { ألحق_معرفات_مأخوذة_مسير(&الحافة.الحجج, الناتج); }
        | منهي_مسير.فرع_شرطي(_, أ, ب) -> {
            ألحق_معرفات_مأخوذة_مسير(&أ.الحجج, الناتج);
            ألحق_معرفات_مأخوذة_مسير(&ب.الحجج, الناتج);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق_معرفات_مأخوذة_مسير(&الفرع.الافتراضي.الحجج, الناتج);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_معرفات_مأخوذة_مسير(&الفرع.الحالات[ف].الحافة.الحجج, الناتج);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(اختياري.موجود(ق)) -> { ألحق(*الناتج, ق.القيمة مثل طبيعي); }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
}

// Passes consumption from each derived value that owns storage back to its
// source, to a fixed point (a source may itself be derived).
عرف انشر_الاستهلاك_تفصيل(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    الأنواع: &سجل_أنواع,
    المستهلكة: &متغير متجه منطقي,
    الأصول: &متجه طبيعي
): فراغ {
    // Consumption is only added, so a round that changes adds at least one
    // more value: this reaches the fixed point.
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع ق: متغير طبيعي = 0;
        طالما (ق < (الطول(*الأصول) مثل طبيعي)) {
            دع الأصل: طبيعي = (*الأصول)[ق];
            إذا ((الأصل != 0) && (*المستهلكة)[ق]) {
                إذا (!(*المستهلكة)[الأصل - 1]) {
                    إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, (*البرنامج).الدوال[د].القيم[ق].النوع)) {
                        (*المستهلكة)[الأصل - 1] := صواب;
                        تغير := صواب;
                    };
                };
            };
            ق := ق + 1;
        }
    }
}

// The value a derived value comes from at the end of its chain (المحولة,
// positions plus one), or the value itself.
عرف جذر_مشتق_تفصيل(المحولة: &متجه طبيعي, القيمة: طبيعي): طبيعي {
    دع الحالي: متغير طبيعي = القيمة;
    دع الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < (الطول(*المحولة) مثل طبيعي) && (*المحولة)[الحالي] != 0) {
        الحالي := (*المحولة)[الحالي] - 1;
        الخطوات := الخطوات + 1;
    }
    أرجع الحالي;
}

// Inserts تسليم after every load of an owner whose value is moved out.
//
// Moves out of a box. A payload moved out of a box an owner holds (`let v =
// *b`, `append(items, *b)`, a box held in a box) moves the box itself, and so
// gives up its owner; the box's own cell would then never be released. Right
// after each such payload load the cell is released: the release primitive
// on a reference to the box's payload place, which owns nothing, so ownership
// glue leaves it the raw storage release the backends adapt (the one a box's
// drop glue ends with), and the payload is not destroyed. It happens exactly
// where the move happens, so on the paths that move only; on the others the
// owner still holds the box and destroys it whole.
// What the values of function د are used for: whether each is moved out
// (المستهلكة, after the passing back above), the value each derives from
// (المحولة, positions plus one, 0 for none), and which are box places
// (صندوق_إلى_مكان). المالكة tells which place values are owners: a store
// into the place of a source local that is no owner moves nothing (a
// borrowed view holds the value its source still owns). The ownership
// legality analysis (ssf/ownership_legality.sn) reads the same facts.
عام نوع استهلاك_قيم_دالة_مسير = {
    المستهلكة: متجه منطقي,
    المحولة: متجه طبيعي,
    أماكن_الصناديق: متجه منطقي,
    محليات_غير_مالكة: متجه منطقي
};

عام عرف احسب_استهلاك_قيم_دالة_مسير(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    المالكة: &متجه منطقي,
    الأنواع: &سجل_أنواع
): استهلاك_قيم_دالة_مسير {
    دع عدد_القيم: طبيعي = الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي;
    دع المستهلكة: متغير متجه منطقي = [];
    دع المحولة: متغير متجه طبيعي = [];
    دع أماكن_الصناديق: متغير متجه منطقي = [];
    دع محليات_غير_مالكة: متغير متجه منطقي = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_القيم) {
        ألحق(المستهلكة, خطأ); ألحق(المحولة, 0);
        ألحق(أماكن_الصناديق, خطأ); ألحق(محليات_غير_مالكة, خطأ);
        ق := ق + 1;
    }
    // Stores are decided once every place is known.
    دع قيم_التخزين: متغير متجه معرف_قيمة_مسير = [];
    دع أماكن_التخزين: متغير متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الناتج: اختياري طبيعي = موضع_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]);
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تخزين(التخزين) -> {
                ألحق(قيم_التخزين, التخزين.القيمة);
                ألحق(أماكن_التخزين, التخزين.المكان.القيمة مثل طبيعي);
            }
            | _ -> {
                علم_عملية_استهلاك_تفصيل(
                    &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية,
                    الناتج, &متغير المستهلكة, &متغير المحولة
                );
            };
            طابق الناتج مع
            | اختياري.موجود(الموضع) -> {
                إذا (الموضع < عدد_القيم) {
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
                    | عملية_مسير.صندوق_إلى_مكان(_) -> { أماكن_الصناديق[الموضع] := صواب; }
                    | عملية_مسير.مكان_محلي(المكان) -> {
                        طابق المكان.المحلي مع
                        | اختياري.موجود(_) -> {
                            إذا (!(الموضع < (الطول(*المالكة) مثل طبيعي) && (*المالكة)[الموضع])) {
                                محليات_غير_مالكة[الموضع] := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | _ -> { };
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        علم_منهي_استهلاك_تفصيل(&(*البرنامج).الدوال[د].الكتل[ك].المنهي, &متغير المستهلكة);
        ك := ك + 1;
    }
    ق := 0;
    طالما (ق < (الطول(قيم_التخزين) مثل طبيعي)) {
        دع المكان: طبيعي = أماكن_التخزين[ق];
        إذا (!(المكان < عدد_القيم && محليات_غير_مالكة[المكان])) {
            علم_استهلاك_تفصيل(&متغير المستهلكة, قيم_التخزين[ق]);
        };
        ق := ق + 1;
    }
    انشر_الاستهلاك_تفصيل(البرنامج, د, الأنواع, &متغير المستهلكة, &المحولة);
    دع الناتج: استهلاك_قيم_دالة_مسير = {
        المستهلكة: المستهلكة,
        المحولة: المحولة,
        أماكن_الصناديق: أماكن_الصناديق,
        محليات_غير_مالكة: محليات_غير_مالكة
    };
    أرجع الناتج;
}

عرف اشتق_تسليمات_دالة_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    د: طبيعي,
    الأرقام: &متجه طبيعي,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_بناء_مسير {
    دع عدد_القيم: طبيعي = الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي;
    دع المالكة: متغير متجه منطقي = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_القيم) { ألحق(المالكة, (*الأرقام)[ق] > 0); ق := ق + 1; }
    دع الاستهلاك: متغير استهلاك_قيم_دالة_مسير = احسب_استهلاك_قيم_دالة_مسير(&(*البرنامج), د, &المالكة, &(*الأنواع));
    دع المستهلكة: متغير متجه منطقي = [];
    بدّل(المستهلكة, الاستهلاك.المستهلكة);
    دع المحولة: متغير متجه طبيعي = [];
    بدّل(المحولة, الاستهلاك.المحولة);
    دع أماكن_الصناديق: متغير متجه منطقي = [];
    بدّل(أماكن_الصناديق, الاستهلاك.أماكن_الصناديق);
    دع غير_مالكة: متغير متجه منطقي = [];
    بدّل(غير_مالكة, الاستهلاك.محليات_غير_مالكة);
    // The loads of owner places.
    دع أحمال_المالكين: متغير متجه منطقي = [];
    ق := 0;
    طالما (ق < عدد_القيم) { ألحق(أحمال_المالكين, خطأ); ق := ق + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                إذا (رقم_مالك_تفصيل(الأرقام, التحميل.المكان) > 0) {
                    طابق موضع_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                    | اختياري.موجود(الموضع) -> {
                        إذا (الموضع < عدد_القيم) { أحمال_المالكين[الموضع] := صواب; };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // The payload loads after which a box's cell is released: a moved load of
    // a box place, owning storage, whose box comes from a moved owner load.
    دع تحرر_الخلية: متغير متجه منطقي = [];
    ق := 0;
    طالما (ق < عدد_القيم) { ألحق(تحرر_الخلية, خطأ); ق := ق + 1; }
    ك := 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                دع المكان: طبيعي = التحميل.المكان.القيمة مثل طبيعي;
                إذا (المكان < عدد_القيم && أماكن_الصناديق[المكان]) {
                    طابق موضع_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                    | اختياري.موجود(الموضع) -> {
                        إذا (الموضع < عدد_القيم && المستهلكة[الموضع]
                            && هل_نوع_يملك_تخزينا_مسير(الأنواع, (*البرنامج).الدوال[د].القيم[الموضع].النوع)) {
                            دع الجذر: طبيعي = جذر_مشتق_تفصيل(&المحولة, الموضع);
                            إذا (أحمال_المالكين[الجذر] && المستهلكة[الجذر]) { تحرر_الخلية[الموضع] := صواب; };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // A moved owner load whose value no owning use takes in the load's own
    // block moves at each of those uses instead, on the paths that reach
    // one: a match arm that binds the whole scrutinee takes it where the arm
    // is entered, and the arms that do not bind it leave it to its owner.
    // المؤجلة holds, per such load, its place's position plus one.
    دع المؤجلة: متغير متجه طبيعي = [];
    دع كتل_المستهلكين: متغير متجه منطقي = [];
    دع أي_مؤجل: متغير منطقي = خطأ;
    اجمع_نقولا_مؤجلة_تفصيل(
        البرنامج, د, &أحمال_المالكين, &المستهلكة, &المحولة, &غير_مالكة,
        &متغير المؤجلة, &متغير كتل_المستهلكين, &متغير أي_مؤجل
    );
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    ك := 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        // Only a block holding a moving load, or a use a deferred move
        // happens at, is rebuilt.
        دع فيها_نقل: متغير منطقي = خطأ;
        دع ت_فحص: متغير طبيعي = 0;
        طالما (!فيها_نقل && ت_فحص < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت_فحص].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                طابق موضع_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت_فحص]) مع
                | اختياري.موجود(الموضع) -> {
                    إذا (الموضع < عدد_القيم
                        && ((أحمال_المالكين[الموضع] && المستهلكة[الموضع]) || تحرر_الخلية[الموضع])) {
                        فيها_نقل := صواب;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت_فحص := ت_فحص + 1;
        }
        إذا (أي_مؤجل && كتل_المستهلكين[ك]) { فيها_نقل := صواب; };
        إذا (!فيها_نقل) { ك := ك + 1; تابع_حلقة; };
        // The block is refilled in place; the builder appends the releases.
        دع الكتلة: معرف_كتلة_مسير = (*البرنامج).الدوال[د].الكتل[ك].المعرف;
        دع القديمة: متغير متجه تعليمة_مسير = [];
        بدّل((*البرنامج).الدوال[د].الكتل[ك].التعليمات, القديمة);
        دع المنهي: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        بدّل((*البرنامج).الدوال[د].الكتل[ك].المنهي, المنهي);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(القديمة) مثل طبيعي)) {
            دع التعليمة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
            بدّل(القديمة[ت], التعليمة);
            دع المنقول: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            دع الخلية: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            دع نوع_الحمولة: متغير معرف_نوع = معرف_نوع_من(0);
            طابق التعليمة.العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                طابق موضع_ناتج_تعليمة_مسير(&التعليمة) مع
                | اختياري.موجود(الموضع) -> {
                    إذا (الموضع < عدد_القيم && أحمال_المالكين[الموضع] && المستهلكة[الموضع]
                        && !(أي_مؤجل && المؤجلة[الموضع] != 0)) {
                        المنقول := اختياري.موجود(التحميل.المكان);
                    };
                    إذا (الموضع < عدد_القيم && تحرر_الخلية[الموضع]) {
                        الخلية := اختياري.موجود(التحميل.المكان);
                        نوع_الحمولة := (*البرنامج).الدوال[د].القيم[الموضع].النوع;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            دع موقع_التحميل: مرجع_موقع_تصحيح_مسير = التعليمة.موقع_التصحيح;
            دع نطاق_التحميل: مرجع_نطاق_تصحيح_مسير = التعليمة.نطاق_التصحيح;
            إذا (أي_مؤجل && كتل_المستهلكين[ك]) {
                دع المأخوذة: متغير متجه طبيعي = [];
                ألحق_قيم_مأخوذة_تعليمة_مسير(&التعليمة.العملية, &غير_مالكة, &متغير المأخوذة);
                ألحق_تسليمات_مؤجلة_تفصيل(
                    البرنامج, د, ك, &المأخوذة, &المحولة, &المؤجلة, موقع_التحميل, نطاق_التحميل
                );
            };
            ألحق((*البرنامج).الدوال[د].الكتل[ك].التعليمات, التعليمة);
            طابق المنقول مع
            | اختياري.موجود(المكان) -> {
                دع الملكية: ملكية_مكان_مسير = { الحدث: حدث_ملكية_مسير.تسليم(), المكان: المكان };
                دع التسليم: تعليمة_مسير = {
                    الناتج: ناتج_تعليمة_مسير_من(اختياري.لا_شيء()),
                    موقع_التصحيح: موقع_التحميل,
                    العملية: عملية_مسير.ملكية_مكان(الملكية),
                    نطاق_التصحيح: نطاق_التحميل,
                    تقييم_وقت_الترجمة: خطأ
                };
                ألحق((*البرنامج).الدوال[د].الكتل[ك].التعليمات, التسليم);
            }
            | اختياري.لا_شيء -> { };
            طابق الخلية مع
            | اختياري.موجود(مكان_الحمولة) -> {
                دع البناء: متغير حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
                البناء.موقع_التصحيح_الحالي := موقع_تصحيح_من_مرجع_مسير(موقع_التحميل);
                البناء.نطاق_التصحيح_الحالي := نطاق_تصحيح_من_مرجع_مسير(نطاق_التحميل);
                دع نوع_المرجع: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_الحمولة, خطأ));
                دع المرجع: معرف_قيمة_مسير;
                طابق قيمة_بناء_تفصيل(أصدر_مكان_إلى_مرجع_مسير(
                    البرنامج, &البناء, الدالة, الكتلة, مكان_الحمولة, نوع_المرجع
                )) مع
                | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                | نتيجة.نجح(المعرف) -> { المرجع := المعرف; };
                دع الحجج: متجه معرف_قيمة_مسير = [المرجع];
                طابق بلا_قيمة_تفصيل(أصدر_نداء_بدائي_مسير(
                    البرنامج, &البناء, الدالة, الكتلة, هوية_بدائي_مترجم.تحرير(), &الحجج,
                    اختياري.لا_شيء(), اختياري.لا_شيء()
                )) مع
                | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        إذا (أي_مؤجل && كتل_المستهلكين[ك]) {
            دع المأخوذة: متغير متجه طبيعي = [];
            ألحق_قيم_مأخوذة_منهي_مسير(&المنهي, &متغير المأخوذة);
            دع موقع: مرجع_موقع_تصحيح_مسير = (*البرنامج).الدوال[د].الكتل[ك].موقع_تصحيح_المنهي;
            دع نطاق: مرجع_نطاق_تصحيح_مسير = (*البرنامج).الدوال[د].الكتل[ك].نطاق_تصحيح_المنهي;
            ألحق_تسليمات_مؤجلة_تفصيل(البرنامج, د, ك, &المأخوذة, &المحولة, &المؤجلة, موقع, نطاق);
        };
        (*البرنامج).الدوال[د].الكتل[ك].المنهي := المنهي;
        ك := ك + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The moved owner loads whose value no owning use takes in the load's own
// block (see اشتق_تسليمات_دالة_تفصيل): المؤجلة[v] is the place position plus
// one of each, كتل_المستهلكين the blocks holding a use one moves at. A use
// takes a load's value directly or through a value derived from it
// (المحولة).
عرف اجمع_نقولا_مؤجلة_تفصيل(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    أحمال_المالكين: &متجه منطقي,
    المستهلكة: &متجه منطقي,
    المحولة: &متجه طبيعي,
    غير_مالكة: &متجه منطقي,
    المؤجلة: &متغير متجه طبيعي,
    كتل_المستهلكين: &متغير متجه منطقي,
    أي_مؤجل: &متغير منطقي
): فراغ {
    دع عدد_القيم: طبيعي = الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي;
    دع عدد_الكتل: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
    // The block of each moved owner load, plus one, and its place.
    دع كتلة_الحمل: متغير متجه طبيعي = [];
    دع مكان_الحمل: متغير متجه طبيعي = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_القيم) { ألحق(كتلة_الحمل, 0); ألحق(مكان_الحمل, 0); ق := ق + 1; }
    دع كتل_الأحمال: متغير متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ألحق(كتل_الأحمال, خطأ);
        ألحق(*كتل_المستهلكين, خطأ);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                طابق موضع_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(الموضع) -> {
                    إذا (الموضع < عدد_القيم && (*أحمال_المالكين)[الموضع] && (*المستهلكة)[الموضع]) {
                        كتلة_الحمل[الموضع] := ك + 1;
                        مكان_الحمل[الموضع] := (التحميل.المكان.القيمة مثل طبيعي) + 1;
                        كتل_الأحمال[ك] := صواب;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // A load some use in its own block takes moves there.
    دع محلية: متغير متجه منطقي = [];
    ق := 0;
    طالما (ق < عدد_القيم) { ألحق(محلية, خطأ); ألحق(*المؤجلة, 0); ق := ق + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (كتل_الأحمال[ك]) {
            دع المأخوذة: متغير متجه طبيعي = [];
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                ألحق_قيم_مأخوذة_تعليمة_مسير(
                    &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية, غير_مالكة, &متغير المأخوذة
                );
                ت := ت + 1;
            }
            ألحق_قيم_مأخوذة_منهي_مسير(&(*البرنامج).الدوال[د].الكتل[ك].المنهي, &متغير المأخوذة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المأخوذة) مثل طبيعي)) {
                إذا (المأخوذة[ف] < عدد_القيم) {
                    دع الجذر: طبيعي = جذر_مشتق_تفصيل(المحولة, المأخوذة[ف]);
                    إذا (كتلة_الحمل[الجذر] == ك + 1) { محلية[الجذر] := صواب; };
                };
                ف := ف + 1;
            }
        };
        ك := ك + 1;
    }
    ق := 0;
    طالما (ق < عدد_القيم) {
        إذا (كتلة_الحمل[ق] != 0 && !محلية[ق]) {
            (*المؤجلة)[ق] := مكان_الحمل[ق];
            *أي_مؤجل := صواب;
        };
        ق := ق + 1;
    }
    إذا (!*أي_مؤجل) { أرجع; };
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع المأخوذة: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            ألحق_قيم_مأخوذة_تعليمة_مسير(
                &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية, غير_مالكة, &متغير المأخوذة
            );
            ت := ت + 1;
        }
        ألحق_قيم_مأخوذة_منهي_مسير(&(*البرنامج).الدوال[د].الكتل[ك].المنهي, &متغير المأخوذة);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المأخوذة) مثل طبيعي)) {
            إذا (المأخوذة[ف] < عدد_القيم && (*المؤجلة)[جذر_مشتق_تفصيل(المحولة, المأخوذة[ف])] != 0) {
                (*كتل_المستهلكين)[ك] := صواب;
            };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
}

// Appends, to block ك, تسليم of the owner of every deferred move one of
// المأخوذة takes (see اجمع_نقولا_مؤجلة_تفصيل).
عرف ألحق_تسليمات_مؤجلة_تفصيل(
    البرنامج: &متغير برنامج_مسير,
    د: طبيعي,
    ك: طبيعي,
    المأخوذة: &متجه طبيعي,
    المحولة: &متجه طبيعي,
    المؤجلة: &متجه طبيعي,
    الموقع: مرجع_موقع_تصحيح_مسير,
    النطاق: مرجع_نطاق_تصحيح_مسير
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المأخوذة) مثل طبيعي)) {
        إذا ((*المأخوذة)[ف] < (الطول(*المؤجلة) مثل طبيعي)) {
            دع المكان: طبيعي = (*المؤجلة)[جذر_مشتق_تفصيل(المحولة, (*المأخوذة)[ف])];
            إذا (المكان != 0) {
                دع الملكية: ملكية_مكان_مسير = {
                    الحدث: حدث_ملكية_مسير.تسليم(),
                    المكان: معرف_قيمة_مسير_من((*البرنامج).الدوال[د].المعرف, المكان - 1)
                };
                دع التسليم: تعليمة_مسير = {
                    الناتج: ناتج_تعليمة_مسير_من(اختياري.لا_شيء()),
                    موقع_التصحيح: الموقع,
                    العملية: عملية_مسير.ملكية_مكان(الملكية),
                    نطاق_التصحيح: النطاق,
                    تقييم_وقت_الترجمة: خطأ
                };
                ألحق((*البرنامج).الدوال[د].الكتل[ك].التعليمات, التسليم);
            };
        };
        ف := ف + 1;
    }
}

// Whether block ك of function د holds an ownership operation.
عرف كتلة_فيها_ملكية_تفصيل(البرنامج: &برنامج_مسير, د: طبيعي, ك: طبيعي): منطقي {
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
        | عملية_مسير.ملكية_مكان(_) -> { أرجع صواب; }
        | _ -> { };
        ت := ت + 1;
    }
    أرجع خطأ;
}

// A function without owners holds no ownership operation but the
// declarations of its locals, which leave no instruction.
عرف احذف_تصريحات_دالة_تفصيل(البرنامج: &متغير برنامج_مسير, د: طبيعي): فراغ {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        دع فيها: متغير منطقي = خطأ;
        دع ت: متغير طبيعي = 0;
        طالما (!فيها && ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ملكية_مكان(_) -> { فيها := صواب; }
            | _ -> { };
            ت := ت + 1;
        }
        إذا (فيها) {
            // Compacted in place: the kept instructions move down over the
            // declarations, which the truncation then drops.
            دع المكتوب: متغير طبيعي = ت - 1;
            دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
            طالما (ت < العدد) {
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.ملكية_مكان(_) -> { }
                | _ -> {
                    دع التعليمة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
                    بدّل((*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], التعليمة);
                    بدّل((*البرنامج).الدوال[د].الكتل[ك].التعليمات[المكتوب], التعليمة);
                    المكتوب := المكتوب + 1;
                };
                ت := ت + 1;
            }
            اقتطع((*البرنامج).الدوال[د].الكتل[ك].التعليمات, المكتوب);
        };
        ك := ك + 1;
    }
}

عرف فصل_إسقاط_دالة_مسير(
    البرنامج: &متغير برنامج_مسير,
    د: طبيعي,
    نوع_المنطق: معرف_نوع,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_بناء_مسير {
    دع الأرقام: متغير متجه طبيعي = [];
    دع الأماكن: متغير متجه معرف_قيمة_مسير = [];
    اجمع_مالكي_دالة_تفصيل(البرنامج, د, &متغير الأرقام, &متغير الأماكن);
    دع العدد: طبيعي = الطول(الأماكن) مثل طبيعي;
    إذا (العدد == 0) {
        احذف_تصريحات_دالة_تفصيل(البرنامج, د);
        أرجع اختياري.لا_شيء();
    };
    طابق اشتق_تسليمات_دالة_تفصيل(البرنامج, د, &الأرقام, الأنواع) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    دع المدخل: طبيعي;
    طابق (*البرنامج).الدوال[د].المدخل مع
    | اختياري.موجود(الكتلة) -> { المدخل := الكتلة.القيمة مثل طبيعي; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Block identities are their positions (the builder appends them so).
    دع عدد_الكتل: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الكتل) {
        إذا (((*البرنامج).الدوال[د].الكتل[ف].المعرف.القيمة مثل طبيعي) != ف) {
            أرجع اختياري.موجود(خطأ_بناء_مسير.كتلة_غير_موجودة((*البرنامج).الدوال[د].الكتل[ف].المعرف));
        };
        ف := ف + 1;
    }
    دع الدخول: متجه طبيعي = احسب_حالات_دخول_تفصيل(البرنامج, د, المدخل, &الأرقام, العدد);
    دع المحتاجة: متجه منطقي = مالكون_بأعلام_تفصيل(البرنامج, د, &الدخول, &الأرقام, العدد);
    دع الأعلام: متغير متجه اختياري معرف_قيمة_مسير = [];
    دع أي_علم: متغير منطقي = خطأ;
    دع م: متغير طبيعي = 0;
    طالما (م < العدد) {
        ألحق(الأعلام, اختياري.لا_شيء());
        إذا (المحتاجة[م]) { أي_علم := صواب; };
        م := م + 1;
    }
    إذا (أي_علم) {
        طابق أصدر_أعلام_تفصيل(البرنامج, د, المدخل, &المحتاجة, &متغير الأعلام, نوع_المنطق) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
    };
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        // A block without an ownership operation is left as it is.
        إذا (!كتلة_فيها_ملكية_تفصيل(البرنامج, د, ك)) { ك := ك + 1; تابع_حلقة; };
        طابق أعد_كتابة_كتلة_تفصيل(
            البرنامج, د, ك, حالة_دخول_تفصيل(&الدخول, ك, العدد), &الأرقام, &الأعلام, نوع_المنطق
        ) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        ك := ك + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Drop elaboration of the whole program: every function's ownership
// operations become its concrete destruction (see the top of this file).
عام عرف فصل_إسقاط_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_بناء_مسير {
    دع نوع_المنطق: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        طابق فصل_إسقاط_دالة_مسير(البرنامج, د, نوع_المنطق, الأنواع) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        د := د + 1;
    }
    أرجع اختياري.لا_شيء();
}
