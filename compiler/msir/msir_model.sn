استورد std.text.from_bytes;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.runtime.primitive_identity;
استورد compiler.runtime.primitive_semantic_contract;
استورد compiler.source.provenance;
استورد compiler.debuginfo.model;
استورد compiler.msir.debug_contract;
استورد std.process.panic;

// MSIR يحمل Type ID المقنن فقط؛ بنية Type والتخطيط الفيزيائي لا ينسخان هنا.
عام نوع قيمة_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

// ثابت النص يحمل بايتات الحرفي المفكوكة دلاليا كما سلّمها frontend.
// لا يعيد MSIR فك الهروب ولا يضيف تمثيلا تشغيليا أو ABI للنص.
عام نوع ثابت_مسير =
    | منطق بنوع منطقي
    | صحيح_موقع بنوع عدد
    | صحيح_طبيعي بنوع طبيعي
    | مؤشر_فارغ
    | عشري بنوع متجه ط8
    | نص بنوع متجه ط8
    | متجه بنوع متجه ثابت_مسير
    | دالة بنوع معرف_دالة_مسير
;

// Module-level scalar constants may be substituted by lowering. Aggregate
// constants retain canonical global storage and their source mutability.
// One linker-owned storage identity must have one canonical MSIR global.
// Repeated equivalent declarations across imported modules reuse that identity;
// distinct types must remain distinguishable for verification to reject them.
عام عرف اسما_عام_خارجي_متساويان_لمسير(الأول: &متجه ط8, الثاني: &متجه ط8): منطقي {
    إذا ((الطول(*الأول) مثل طبيعي) != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*الأول) مثل طبيعي)) {
        إذا ((*الأول)[الموضع] != (*الثاني)[الموضع]) { أرجع خطأ; };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

عام نوع عام_مسير = {
    المعرف: معرف_عام_مسير,
    النوع: معرف_نوع,
    التهيئة: ثابت_مسير,
    قابل_للكتابة: منطقي,
    // Nonempty only for imported linker storage. No initializer is emitted.
    الاسم_الخارجي: اختياري متجه ط8
};

عام عرف انسخ_ثابت_مسير(الثابت: &ثابت_مسير): ثابت_مسير {
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> { أرجع ثابت_مسير.منطق(القيمة); }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع ثابت_مسير.صحيح_موقع(القيمة); }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أرجع ثابت_مسير.صحيح_طبيعي(القيمة); }
    | ثابت_مسير.مؤشر_فارغ -> { أرجع ثابت_مسير.مؤشر_فارغ(); }
    | ثابت_مسير.عشري(البايتات) -> {
        دع المصدر: متجه ط8 = البايتات;
        دع النسخة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصدر) مثل طبيعي)) { ألحق(النسخة, المصدر[ف]); ف := ف + 1; }
        أرجع ثابت_مسير.عشري(النسخة);
    }
    | ثابت_مسير.نص(البايتات) -> {
        دع المصدر: متجه ط8 = البايتات;
        دع النسخة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصدر) مثل طبيعي)) { ألحق(النسخة, المصدر[ف]); ف := ف + 1; }
        أرجع ثابت_مسير.نص(النسخة);
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع النسخة: متغير متجه ثابت_مسير = [];
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            ألحق(النسخة, انسخ_ثابت_مسير(&العناصر[فهرس_العنصر]));
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        أرجع ثابت_مسير.متجه(النسخة);
    }
    | ثابت_مسير.دالة(المعرف) -> { أرجع ثابت_مسير.دالة(المعرف); };
}

عام نوع عملية_حساب_صحيح =
    | جمع
    | طرح
    | ضرب
    | قسمة_موقعة
    | قسمة_طبيعية
    | باقي_موقع
    | باقي_طبيعي
    | أو_بتي
    | أو_حصري
    | و_بتي
    | إزاحة_يسرى
    | إزاحة_يمنى
    | إزاحة_حسابية_يمنى
    // Wrapping (modular) arithmetic: the result modulo 2^N of the operand
    // type, never a trap (Rust's wrapping_add/sub/mul/shl).
    // The shift amount of إزاحة_يسرى_ملتفة is already below N (lowering
    // masks it, as wrapping_shl does).
    | جمع_ملتف
    | طرح_ملتف
    | ضرب_ملتف
    | إزاحة_يسرى_ملتفة
;

// عقد دلالة الأعداد الصحيحة المقنن في MSIR مستقل عن الهدف والمضيف.
// لا تحمل العمليات أعلام التفاف أو تشبع محلية؛ كل فشل عددي أدناه ينتهي بفخ.
عام نوع سلوك_فشل_حساب_صحيح_مسير =
    | فخ
;

عام نوع عقد_دلالة_حساب_صحيح_مسير = {
    تجاوز_العرض_الافتراضي: سلوك_فشل_حساب_صحيح_مسير,
    قسمة_على_صفر: سلوك_فشل_حساب_صحيح_مسير,
    باقي_على_صفر: سلوك_فشل_حساب_صحيح_مسير,
    قسمة_أدنى_موقع_على_سالب_واحد: سلوك_فشل_حساب_صحيح_مسير,
    باقي_أدنى_موقع_على_سالب_واحد: سلوك_فشل_حساب_صحيح_مسير
};

عام عرف عقد_دلالة_حساب_صحيح_مسير_المقنن(): عقد_دلالة_حساب_صحيح_مسير {
    دع الفخ: سلوك_فشل_حساب_صحيح_مسير = سلوك_فشل_حساب_صحيح_مسير.فخ();
    دع العقد: عقد_دلالة_حساب_صحيح_مسير = {
        تجاوز_العرض_الافتراضي: الفخ,
        قسمة_على_صفر: الفخ,
        باقي_على_صفر: الفخ,
        قسمة_أدنى_موقع_على_سالب_واحد: الفخ,
        باقي_أدنى_موقع_على_سالب_واحد: الفخ
    };
    أرجع العقد;
}

عام نوع حساب_صحيح_مسير = {
    العملية: عملية_حساب_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

عام نوع عملية_مقارنة_صحيح =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

عام نوع مقارنة_صحيح_مسير = {
    العملية: عملية_مقارنة_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};


عام نوع عملية_حساب_عشري =
    | جمع
    | طرح
    | ضرب
    | قسمة
;

عام نوع حساب_عشري_مسير = {
    العملية: عملية_حساب_عشري,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

عام نوع عملية_مقارنة_عشري =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

عام نوع مقارنة_عشري_مسير = {
    العملية: عملية_مقارنة_عشري,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

// هذه تحويلات أعداد صحيحة ذات معنى مستقل عن حجم المؤشر أو ABI أو Layout.
عام نوع عملية_تحويل_صحيح =
    | توسيع_بإشارة
    | توسيع_صفري
    | اقتطاع
    | إعادة_تفسير
;

عام نوع تحويل_صحيح_مسير = {
    العملية: عملية_تحويل_صحيح,
    المصدر: معرف_قيمة_مسير
};

// Conversions between a float and an integer, or between the two float
// widths, as Rust's `as` defines them since 1.45 (and Swift's
// Int(clamping:), Java's d2l):
// - float -> integer truncates toward zero and saturates: a value below the
//   integer type's range gives its minimum, above it its maximum, NaN gives 0;
// - integer -> float rounds to nearest, ties to even (IEEE 754
//   roundTiesToEven), as Go's and C's conversions do;
// - f32 -> f64 is exact; f64 -> f32 rounds to nearest, ties to even
//   (overflow gives an infinity, a NaN stays a NaN).
// The integer side's width comes from its value's Type; its signedness is
// part of the operation so no consumer re-derives it.
عام نوع عملية_تحويل_عائم =
    | عائم_إلى_موقع
    | عائم_إلى_طبيعي
    | موقع_إلى_عائم
    | طبيعي_إلى_عائم
    | عائم_إلى_عائم
;

عام نوع تحويل_عائم_مسير = {
    العملية: عملية_تحويل_عائم,
    المصدر: معرف_قيمة_مسير
};

// تحويل دلالي لقيمة مرجع إلى قيمة مؤشر، بلا تفاصيل تمثيل مادي.
عام نوع مرجع_إلى_مؤشر_مسير = {
    المرجع: معرف_قيمة_مسير
};

// A verified, explicit ownership move from an owned byte vector to text, or
// from text back to a byte vector (drop glue releases text buffers that way).
// The sequence header is unchanged and ownership of its buffer is transferred.
عام نوع نقل_تسلسل_مملوك_مسير = {
    المصدر: معرف_قيمة_مسير
};

// هوية هدف النداء المقننة في MSIR تحفظ الفرق الدلالي بين دالة سلطانC
// وبدائي المترجم. البدائي هنا ليس خدمة Runtime منخفضة المستوى.
عام نوع هدف_نداء_مسير =
    | دالة_سلطان بنوع معرف_دالة_مسير
    | دالة_خارجية بنوع معرف_دالة_خارجية_مسير
    | بدائي_مترجم بنوع هوية_بدائي_مترجم
    | قيمة_دالة بنوع معرف_قيمة_مسير
;

// A machine call keeps its ABI arguments unchanged. Memory access is a separate,
// verified semantic fact; a word does not become a pointer by numeric coincidence.
عام نوع إذن_ذاكرة_نداء_مسير =
    | قراءة
    | كتابة
    | قراءة_وكتابة
;

عام نوع نطاق_ذاكرة_نداء_مسير = {
    فهرس_الحجة: طبيعي,
    // The actual machine argument and its semantic storage origin remain distinct.
    المؤشر: معرف_قيمة_مسير,
    الأصل: معرف_قيمة_مسير,
    // Verified byte capacity of the live source allocation.
    الطول: معرف_قيمة_مسير,
    // Explicit maximum byte extent that the target OS call may access.
    // Absent until the source/OS contract supplies this independent witness.
    // This is NOT inferred from the allocation's capacity or syscall arguments.
    المطلوب: اختياري معرف_قيمة_مسير,
    الإذن: إذن_ذاكرة_نداء_مسير
};

// This is not an eighth machine argument. Only the frontend can produce the
// witness from resolved canonical selector + enum constructor identities.
عام نوع عقد_نواة_مسير = {
    المنشئ: معرف_رمز,
    الترتيب: طبيعي,
    المنتقي: معرف_دالة_مسير,
    الرقم: معرف_قيمة_مسير
};

// Attestation is minted from Frontend-resolved RootID+ModuleKey+SymbolIDs,
// never from the call's requested operation or a source-authored mask.
عام نوع مصدر_عقد_نواة_مسير = {
    المنشئ: معرف_رمز,
    الترتيب: طبيعي,
    المنتقي: معرف_دالة_مسير,
    التوقيع: توقيع_نداء_بدائي
};

عام نوع نداء_مسير = {
    الهدف: هدف_نداء_مسير,
    الحجج: متجه معرف_قيمة_مسير,
    // البدائيات ذات أثر lvalue تحمل المكان الدلالي صراحة. الحجج تبقى قيما
    // عادية، والمكان لا يتحول إلى قيمة من الدرجة الأولى. حاليا append فقط.
    مكان_التعديل: اختياري معرف_قيمة_مسير,
    // Empty only when no accessible machine-call buffers are declared.
    نطاقات_الذاكرة: متجه نطاق_ذاكرة_نداء_مسير,
    عقد_النواة: اختياري عقد_نواة_مسير
};

// Aggregate membership uses canonical semantic member order only; it carries no physical offsets.
عام نوع تجميع_مسير = {
    الأعضاء: متجه معرف_قيمة_مسير
};

// Vector initialization is semantically distinct from aggregate field construction.
// The elements are semantic vector members; physical data/length/capacity representation belongs to Backend/Layout.
عام نوع تهيئة_متجه_مسير = {
    العناصر: متجه معرف_قيمة_مسير
};

عام نوع استخراج_حقل_مسير = {
    المصدر: معرف_قيمة_مسير,
    الفهرس: طبيعي
};

عام نوع استخراج_فهرس_مسير = {
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

// Places are abstract typed storage identities in the value-id namespace. A place-producing
// instruction is never a first-class value; verifier enforces the distinction structurally.
عام نوع مكان_محلي_مسير = {
    قابل_للكتابة: منطقي
};

عام نوع مكان_عام_مسير = {
    العام: معرف_عام_مسير,
    قابل_للكتابة: منطقي
};

عام نوع مرجع_إلى_مكان_مسير = {
    المرجع: معرف_قيمة_مسير
};

عام نوع صندوق_إلى_مكان_مسير = {
    الصندوق: معرف_قيمة_مسير
};

عام نوع مكان_حقل_مسير = {
    الأصل: معرف_قيمة_مسير,
    الفهرس: طبيعي
};

عام نوع مكان_فهرس_مسير = {
    الأصل: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

// فهرسة المؤشر تحسب موضع تخزين عنصر دلاليا من قيمة المؤشر والفهرس.
// لا يحمل MSIR إزاحة بايتات أو تخطيط هدف؛ تحسبها خلفية المترجم من تخطيط النوع المستهدف.
عام نوع موضع_تخزين_عنصر_مؤشر_مسير = {
    المؤشر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

عام نوع تحميل_مسير = {
    المكان: معرف_قيمة_مسير
};

عام نوع تخزين_مسير = {
    المكان: معرف_قيمة_مسير,
    القيمة: معرف_قيمة_مسير
};

عام نوع مكان_إلى_مرجع_مسير = {
    المكان: معرف_قيمة_مسير
};

// Constructor indices are canonical semantic constructor ordinals, never physical tag encodings.
عام نوع بناء_موسوم_مسير = {
    المنشئ: طبيعي,
    الحمولات: متجه معرف_قيمة_مسير
};

// Tag inspection yields the canonical unsigned 32-bit semantic constructor ordinal.
// Physical tag width/encoding remains Backend/Layout ownership.
عام نوع استعلام_وسم_مسير = {
    المصدر: معرف_قيمة_مسير
};

عام نوع استخراج_حمولة_مسير = {
    المصدر: معرف_قيمة_مسير,
    المنشئ: طبيعي,
    الحمولة: طبيعي
};

عام نوع بناء_صندوق_مسير = {
    القيمة: معرف_قيمة_مسير
};

// A lexical closure keeps the target function identity and the values captured
// at the construction point. Physical environment layout belongs to Backend/Target.
// The environment is reference counted (docs/en/reference/ownership.md,
// "Closure environments"): المدمر names the capture-less-signature function
// `() -> ()` that destroys the owned captures when the last reference is
// released. Lowering leaves it empty; the ownership-glue pass assigns one to
// every construction before any backend sees the program.
عام نوع بناء_إغلاق_مسير = {
    الدالة: معرف_دالة_مسير,
    الالتقاطات: متجه معرف_قيمة_مسير,
    المدمر: اختياري معرف_دالة_مسير
};

عام نوع استخراج_التقاط_مسير = {
    الفهرس: طبيعي
};

عام نوع عملية_مسير =
    | ثابت بنوع ثابت_مسير
    | حساب_صحيح بنوع حساب_صحيح_مسير
    | مقارنة_صحيح بنوع مقارنة_صحيح_مسير
    | حساب_عشري بنوع حساب_عشري_مسير
    | مقارنة_عشري بنوع مقارنة_عشري_مسير
    | تحويل_صحيح بنوع تحويل_صحيح_مسير
    | تحويل_عائم بنوع تحويل_عائم_مسير
    | مرجع_إلى_مؤشر بنوع مرجع_إلى_مؤشر_مسير
    | نقل_تسلسل_مملوك بنوع نقل_تسلسل_مملوك_مسير
    | تجميع بنوع تجميع_مسير
    | تهيئة_متجه بنوع تهيئة_متجه_مسير
    | استخراج_حقل بنوع استخراج_حقل_مسير
    | استخراج_فهرس بنوع استخراج_فهرس_مسير
    | مكان_محلي بنوع مكان_محلي_مسير
    | مكان_عام بنوع مكان_عام_مسير
    | مرجع_إلى_مكان بنوع مرجع_إلى_مكان_مسير
    | صندوق_إلى_مكان بنوع صندوق_إلى_مكان_مسير
    | مكان_حقل بنوع مكان_حقل_مسير
    | مكان_فهرس بنوع مكان_فهرس_مسير
    | موضع_تخزين_عنصر_مؤشر بنوع موضع_تخزين_عنصر_مؤشر_مسير
    | تحميل بنوع تحميل_مسير
    | تخزين بنوع تخزين_مسير
    | مكان_إلى_مرجع بنوع مكان_إلى_مرجع_مسير
    | بناء_موسوم بنوع بناء_موسوم_مسير
    | استعلام_وسم بنوع استعلام_وسم_مسير
    | استخراج_حمولة بنوع استخراج_حمولة_مسير
    | بناء_صندوق بنوع بناء_صندوق_مسير
    | بناء_إغلاق بنوع بناء_إغلاق_مسير
    | استخراج_التقاط بنوع استخراج_التقاط_مسير
    | نداء بنوع نداء_مسير
;

// The debug location and the debug scope an instruction refers to, in 32
// bits each: the ID, or 0xFFFFFFFF for none (the compact form of an
// optional معرف_موقع_تصحيح / معرف_نطاق_تصحيح, which takes 16 bytes). Made
// only through the two constructors below, which check the ID.
عام نوع مرجع_موقع_تصحيح_مسير = {
    القيمة: ط32
};

عام نوع مرجع_نطاق_تصحيح_مسير = {
    القيمة: ط32
};

عرف بلا_مرجع_مضغوط_مسير(): ط32 { أرجع 0xFFFFFFFF; }

عرف مرجع_مضغوط_متحقق_مسير(القيمة: طبيعي): ط32 {
    إذا (القيمة >= 0xFFFFFFFF) {
        إنهيار(«SultanC: an MSIR debug location, debug scope or value position exceeds 2^32 - 2»);
    };
    أرجع القيمة مثل ط32;
}

عام عرف مرجع_موقع_تصحيح_مسير_من(الموقع: اختياري معرف_موقع_تصحيح): مرجع_موقع_تصحيح_مسير {
    دع القيمة: متغير ط32 = بلا_مرجع_مضغوط_مسير();
    طابق الموقع مع
    | اختياري.موجود(م) -> { القيمة := مرجع_مضغوط_متحقق_مسير(م.القيمة); }
    | اختياري.لا_شيء -> { };
    دع المرجع: مرجع_موقع_تصحيح_مسير = { القيمة: القيمة };
    أرجع المرجع;
}

عام عرف مرجع_نطاق_تصحيح_مسير_من(النطاق: اختياري معرف_نطاق_تصحيح): مرجع_نطاق_تصحيح_مسير {
    دع القيمة: متغير ط32 = بلا_مرجع_مضغوط_مسير();
    طابق النطاق مع
    | اختياري.موجود(ن) -> { القيمة := مرجع_مضغوط_متحقق_مسير(ن.القيمة); }
    | اختياري.لا_شيء -> { };
    دع المرجع: مرجع_نطاق_تصحيح_مسير = { القيمة: القيمة };
    أرجع المرجع;
}

عام عرف موقع_تصحيح_من_مرجع_مسير(المرجع: مرجع_موقع_تصحيح_مسير): اختياري معرف_موقع_تصحيح {
    إذا (المرجع.القيمة == بلا_مرجع_مضغوط_مسير()) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(معرف_موقع_تصحيح_من(المرجع.القيمة مثل طبيعي));
}

عام عرف نطاق_تصحيح_من_مرجع_مسير(المرجع: مرجع_نطاق_تصحيح_مسير): اختياري معرف_نطاق_تصحيح {
    إذا (المرجع.القيمة == بلا_مرجع_مضغوط_مسير()) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(معرف_نطاق_تصحيح_من(المرجع.القيمة مثل طبيعي));
}

// The value an instruction defines, by its position in the function's
// values (دالة_مسير.القيم, which holds its Type: the القيمة of its Value
// ID), or 0xFFFFFFFF when it defines none. 4 bytes instead of a 16-byte
// optional value; made through ناتج_تعليمة_مسير_من, read through
// قيمة_ناتج_تعليمة_مسير and معرف_ناتج_تعليمة_في_مسير.
عام نوع ناتج_تعليمة_مسير = {
    القيمة: ط32
};

عام عرف ناتج_تعليمة_مسير_من(الناتج: اختياري قيمة_مسير): ناتج_تعليمة_مسير {
    دع القيمة: متغير ط32 = بلا_مرجع_مضغوط_مسير();
    طابق الناتج مع
    | اختياري.موجود(ق) -> { القيمة := مرجع_مضغوط_متحقق_مسير(ق.المعرف.القيمة مثل طبيعي); }
    | اختياري.لا_شيء -> { };
    دع المرجع: ناتج_تعليمة_مسير = { القيمة: القيمة };
    أرجع المرجع;
}

// Whether the instruction defines a value.
عام عرف للتعليمة_ناتج_مسير(التعليمة: &تعليمة_مسير): منطقي {
    أرجع (*التعليمة).الناتج.القيمة != بلا_مرجع_مضغوط_مسير();
}

// The position of the value an instruction defines among its function's
// values (the القيمة of its Value ID).
عام عرف موضع_ناتج_تعليمة_مسير(التعليمة: &تعليمة_مسير): اختياري طبيعي {
    إذا (!للتعليمة_ناتج_مسير(التعليمة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*التعليمة).الناتج.القيمة مثل طبيعي);
}

// The Value ID an instruction of the function الدالة defines.
عام عرف معرف_ناتج_تعليمة_في_مسير(
    الدالة: معرف_دالة_مسير,
    التعليمة: &تعليمة_مسير
): اختياري معرف_قيمة_مسير {
    إذا (!للتعليمة_ناتج_مسير(التعليمة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(معرف_قيمة_مسير_من(الدالة, (*التعليمة).الناتج.القيمة مثل طبيعي));
}

// The value (ID and Type) an instruction of الدالة defines.
عام عرف قيمة_ناتج_تعليمة_مسير(
    الدالة: &دالة_مسير,
    التعليمة: &تعليمة_مسير
): اختياري قيمة_مسير {
    إذا (!للتعليمة_ناتج_مسير(التعليمة)) { أرجع اختياري.لا_شيء(); };
    دع الموضع: طبيعي = (*التعليمة).الناتج.القيمة مثل طبيعي;
    // Outside the values only in a malformed program, which the verifier
    // rejects (msir_verifier.sn, قيمة_غير_موجودة).
    إذا (الموضع >= (الطول((*الدالة).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الدالة).القيم[الموضع]);
}

// نتيجة التعليمة مملوكة للتعليمة نفسها. التعليمات عديمة الناتج لا تنشئ Value ID.
// An instruction's source origin is the origin of its debug location
// (برنامج_مسير.أصول_مواقع_التصحيح, أصل_تعليمة_مسير); it is not stored a second time here.
عام نوع تعليمة_مسير = {
    الناتج: ناتج_تعليمة_مسير,
    موقع_التصحيح: مرجع_موقع_تصحيح_مسير,
    العملية: عملية_مسير,
    نطاق_التصحيح: مرجع_نطاق_تصحيح_مسير,
    // Explicit frontend comptime obligation, discharged after complete MSIR lowering.
    // Never reaches a backend while still marked.
    تقييم_وقت_الترجمة: منطقي
};

// Block arguments هي تمثيل الدمج الوحيد؛ لا توجد PHI nodes موازية.
عام نوع حافة_مسير = {
    الهدف: معرف_كتلة_مسير,
    الحجج: متجه معرف_قيمة_مسير
};

// A target-neutral integer dispatch. Cases must have distinct keys;
// the default edge handles every key not explicitly present.
عام نوع حالة_فرع_متعدد_مسير = {
    الوسم: طبيعي,
    الحافة: حافة_مسير
};

عام نوع فرع_متعدد_مسير = {
    المميز: معرف_قيمة_مسير,
    الحالات: متجه حالة_فرع_متعدد_مسير,
    الافتراضي: حافة_مسير
};

عام نوع منهي_مسير =
    | فرع بنوع حافة_مسير
    | فرع_متعدد بنوع فرع_متعدد_مسير
    | فرع_شرطي بنوع (معرف_قيمة_مسير, حافة_مسير, حافة_مسير)
    | إرجاع بنوع اختياري معرف_قيمة_مسير
    | فخ
;

عام نوع كتلة_مسير = {
    المعرف: معرف_كتلة_مسير,
    المعاملات: متجه قيمة_مسير,
    التعليمات: متجه تعليمة_مسير,
    المنهي: اختياري منهي_مسير
};

عام نوع دالة_مسير = {
    المعرف: معرف_دالة_مسير,
    المعاملات: متجه قيمة_مسير,
    // Compile-time parameters remain attached to the canonical function
    // identity; callers must discharge these arguments before codegen.
    معاملات_وقت_الترجمة: متجه منطقي,
    // Capture Types form the lexical environment interface for closure-created functions.
    // They are not source parameters and therefore never enter the ordinary call ABI.
    الالتقاطات: متجه معرف_نوع,
    الناتج: اختياري معرف_نوع,
    المدخل: اختياري معرف_كتلة_مسير,
    الكتل: متجه كتلة_مسير,
    // Values are owned once by the function in dense ValueID order.
    // Parameters/instructions keep their structural placement, while all
    // type queries consume this canonical value sequence directly.
    القيم: متجه قيمة_مسير,
    القيمة_التالية: طبيعي
};


// External declarations are MSIR call-interface facts. They carry no body or blocks.
// الاسم is the exact linker symbol. المكتبة is the library the declaration
// names (a PE DLL, a Mach-O install name, a WebAssembly import module); none
// leaves the symbol to the target's default (see link/model.sn
// استيراد_مكتبة_مصرح_ربط and the object writers).
عام نوع دالة_خارجية_مسير = {
    المعرف: معرف_دالة_خارجية_مسير,
    الاسم: متجه ط8,
    المكتبة: اختياري متجه ط8,
    المعاملات: متجه معرف_نوع,
    الناتج: اختياري معرف_نوع,
    // A C variadic function (`printf`): the number of its fixed parameters.
    // المعاملات then lists one call shape, the fixed parameters followed by
    // the (already promoted) variadic arguments of the calls through this
    // declaration; each backend passes the arguments after the fixed ones
    // as the platform's variadic convention requires (System V x86-64 sets
    // AL, Apple arm64 puts them on the stack, Win64 copies a float in a
    // register slot to that slot's integer register, Windows on Arm passes
    // them all in x registers and then the stack). One symbol may have
    // several shapes.
    المعاملات_الثابتة: اختياري طبيعي
};

// The three bound allocation-service providers (all or none).
عام نوع مزودات_تخصيص_ذاكرة_مسير = {
    التخصيص: معرف_دالة_مسير,
    إعادة_التخصيص: معرف_دالة_مسير,
    التحرير: معرف_دالة_مسير
};

// Rich debug metadata is owned by compiler/debuginfo and connected through
// compiler/msir/debug_contract. MSIR itself keeps only compact IDs per instruction.
عام نوع برنامج_مسير = {
    الدوال: متجه دالة_مسير,
    أصول_النواة: متجه مصدر_عقد_نواة_مسير,
    الدوال_الخارجية: متجه دالة_خارجية_مسير,
    العوام: متجه عام_مسير,
    دالة_بدء_البرنامج: اختياري معرف_دالة_مسير,
    // The STD process-exit provider (std.os.process) called by a native
    // executable's startup after the language entry returns. A program fact,
    // so backends call the canonical definition directly, never by name.
    دالة_خروج_العملية: اختياري معرف_دالة_مسير,
    // The STD task context switch (std.async): backends that can switch
    // stacks replace its body with their fixed save/restore routine.
    دالة_تبديل_سياق_المهام: اختياري معرف_دالة_مسير,
    // The STD allocation-service providers (std os/allocation.sn) on targets
    // whose runtime has no C allocator. A program fact, like the exit
    // provider: backends call these definitions for the compiler's storage
    // services instead of an external malloc/realloc/free.
    مزودات_تخصيص_الذاكرة: اختياري مزودات_تخصيص_ذاكرة_مسير,
    // Loader-visible only for standalone objects: runs before main and before
    // the executable startup globals are populated. The verifier permits only
    // compiler-owned vector construction and stores into local empty headers.
    // Executable initialization instead calls the same generated routine at
    // language entry, after the process start has initialized its ABI data.
    دالة_تهيئة_الوحدة: اختياري معرف_دالة_مسير,
    // std.fmt's compile-time format checker (docs/en/reference/formatting.md), so the driver can
    // tell a format check among the compile-time obligations. Cleared once
    // compile-time work is discharged.
    دالة_تحقق_التنسيق: اختياري معرف_دالة_مسير,
    // std's allocation counters (os/allocation.sn, os/allocation_cache.sn),
    // in the order of أسماء_عدادات_التخصيص_أساسية: an interpreter that
    // serves storage itself answers them from its own counts.
    دوال_عدادات_التخصيص: متجه اختياري معرف_دالة_مسير,
    // The functions compiled from imported C (.c imports, compiler/jisr)
    // whose value is never taken, indexed by FunctionID (shorter when the
    // last functions are not): their calls keep the target's registered
    // register convention, the C placement of their records, instead of
    // SultanC's internal hidden references (اتفاقية_دالة_مسير_للواجهة in
    // compiler/backend/target/selection_query_context.sn).
    دوال_اتفاقية_المنصة: متجه منطقي,
    // The source origin of each debug location, by location ID: the origin
    // of every instruction that refers to that location. Lowering records it
    // once the program is built (semantic_lowering.sn).
    أصول_مواقع_التصحيح: متجه معرف_أصل_مصدر
};

// An instruction without debug location or scope (compiler-made code).
عام عرف تعليمة_مسير_بلا_تصحيح(الناتج: اختياري قيمة_مسير, العملية: عملية_مسير): تعليمة_مسير {
    دع التعليمة: تعليمة_مسير = {
        الناتج: ناتج_تعليمة_مسير_من(الناتج),
        موقع_التصحيح: مرجع_موقع_تصحيح_مسير_من(اختياري.لا_شيء()),
        العملية: العملية,
        نطاق_التصحيح: مرجع_نطاق_تصحيح_مسير_من(اختياري.لا_شيء()),
        تقييم_وقت_الترجمة: خطأ
    };
    أرجع التعليمة;
}

// The source origin of an instruction: that of its debug location.
عام عرف أصل_تعليمة_مسير(
    البرنامج: &برنامج_مسير,
    التعليمة: &تعليمة_مسير
): اختياري معرف_أصل_مصدر {
    دع الموقع: ط32 = (*التعليمة).موقع_التصحيح.القيمة;
    إذا (الموقع == بلا_مرجع_مضغوط_مسير()) { أرجع اختياري.لا_شيء(); };
    إذا ((الموقع مثل طبيعي) >= (الطول((*البرنامج).أصول_مواقع_التصحيح) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*البرنامج).أصول_مواقع_التصحيح[الموقع]);
}

عام عرف عدد_التقاطات_دالة_مسير(الدالة: &دالة_مسير): طبيعي {
    دع الحالة: دالة_مسير = *الدالة;
    أرجع الطول(الحالة.الالتقاطات) مثل طبيعي;
}

عام عرف نوع_التقاط_دالة_مسير_عند(
    الدالة: &دالة_مسير,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    دع الحالة: دالة_مسير = *الدالة;
    إذا (الفهرس >= (الطول(الحالة.الالتقاطات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الحالة.الالتقاطات[الفهرس]);
}


عام عرف عام_مسير_موجود(البرنامج: &برنامج_مسير, المعرف: معرف_عام_مسير): منطقي {
    دع الحالة: برنامج_مسير = *البرنامج;
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(الحالة.العوام) مثل طبيعي)) { أرجع خطأ; };
    أرجع عاما_مسير_متساويان(الحالة.العوام[المعرف.القيمة].المعرف, المعرف);
}

عام عرف عام_مسير_عند(البرنامج: &برنامج_مسير, المعرف: معرف_عام_مسير): اختياري عام_مسير {
    إذا (!عام_مسير_موجود(البرنامج, المعرف)) { أرجع اختياري.لا_شيء(); };
    دع الحالة: برنامج_مسير = *البرنامج;
    دع مرجع_العام: &عام_مسير = &الحالة.العوام[المعرف.القيمة];
    // Copy the whole record once, then replace its initializer with an
    // independent constant copy; no owned field is moved out of a record.
    دع تهيئة_العام: ثابت_مسير = انسخ_ثابت_مسير(&(*مرجع_العام).التهيئة);
    دع العام: متغير عام_مسير = انسخ_مملوكا_عام_مسير(مرجع_العام);
    العام.التهيئة := تهيئة_العام;
    أرجع اختياري.موجود(العام);
}

عام عرف دالة_خارجية_مسير_موجودة(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): منطقي {
    دع الحالة: برنامج_مسير = *البرنامج;
    أرجع (المعرف.القيمة مثل طبيعي) < (الطول(الحالة.الدوال_الخارجية) مثل طبيعي);
}

عام عرف دالة_خارجية_مسير_عند(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): اختياري دالة_خارجية_مسير {
    إذا (!دالة_خارجية_مسير_موجودة(البرنامج, المعرف)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_مملوكا_دالة_خارجية_مسير(&(*البرنامج).الدوال_الخارجية[المعرف.القيمة]));
}

// هوية بدء البرنامج المقننة على حد MSIR العام. وحدات المكتبة لا تملك دالة بدء.
عام عرف معرف_دالة_بدء_برنامج_مسير(
    البرنامج: &برنامج_مسير
): اختياري معرف_دالة_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    أرجع الحالة.دالة_بدء_البرنامج;
}

// مزود خروج العملية من المكتبة القياسية، إن كان ضمن البرنامج.
عام عرف معرف_دالة_خروج_عملية_مسير(
    البرنامج: &برنامج_مسير
): اختياري معرف_دالة_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    أرجع الحالة.دالة_خروج_العملية;
}

// استعلامات العضوية البنائية المقننة يملكها نموذج MSIR نفسه.
// Builder وVerifier يضيفان سياستهما فوق هذه الحقيقة ولا يعيدان تنفيذها.
عام عرف دالة_مسير_موجودة(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_مسير
): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع دالتا_مسير_متساويتان(
        (*البرنامج).الدوال[المعرف.القيمة].المعرف,
        المعرف
    );
}

عام عرف كتلة_مسير_موجودة(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    إذا (!دالتا_مسير_متساويتان(المعرف.الدالة, (*الدالة).المعرف)) {
        أرجع خطأ;
    };
