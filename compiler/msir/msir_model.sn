استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;

// MSIR يحمل Type ID المقنن فقط؛ بنية Type والتخطيط الفيزيائي لا ينسخان هنا.
عام نوع قيمة_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

// ثابت النص يحمل بايتات الحرفي المفكوكة دلاليا كما سلّمها frontend.
// لا يعيد MSIR فك الهروب ولا يضيف تمثيلا تشغيليا أو ABI للنص.
عام نوع ثابت_مسير =
    | منطق بنوع منطقي
    | صحيح_موقع بنوع عدد
    | صحيح_غير_موقع بنوع غير_موقع
    | عشري بنوع متجه غ8
    | نص بنوع متجه غ8
    | دالة بنوع معرف_دالة_مسير
;

عام نوع عملية_حساب_صحيح =
    | جمع
    | طرح
    | ضرب
    | قسمة_موقعة
    | قسمة_غير_موقعة
    | باقي_موقع
    | باقي_غير_موقع
    | أو_بتي
    | أو_حصري
    | و_بتي
    | إزاحة_يسرى
    | إزاحة_يمنى
    | إزاحة_حسابية_يمنى
;

// عقد دلالة الأعداد الصحيحة المقنن في MSIR مستقل عن الهدف والمضيف.
// لا تحمل العمليات أعلام التفاف أو تشبع محلية؛ كل فشل عددي أدناه ينتهي بفخ.
عام نوع سلوك_فشل_حساب_صحيح_مسير =
    | فخ
;

عام نوع عقد_دلالة_حساب_صحيح_مسير = {
    تجاوز_العرض_الافتراضي: سلوك_فشل_حساب_صحيح_مسير,
    قسمة_على_صفر: سلوك_فشل_حساب_صحيح_مسير,
    باقي_على_صفر: سلوك_فشل_حساب_صحيح_مسير,
    قسمة_أدنى_موقع_على_سالب_واحد: سلوك_فشل_حساب_صحيح_مسير,
    باقي_أدنى_موقع_على_سالب_واحد: سلوك_فشل_حساب_صحيح_مسير
};

عام عرف عقد_دلالة_حساب_صحيح_مسير_المقنن(): عقد_دلالة_حساب_صحيح_مسير {
    دع الفخ: سلوك_فشل_حساب_صحيح_مسير = سلوك_فشل_حساب_صحيح_مسير.فخ();
    دع العقد: عقد_دلالة_حساب_صحيح_مسير = {
        تجاوز_العرض_الافتراضي: الفخ,
        قسمة_على_صفر: الفخ,
        باقي_على_صفر: الفخ,
        قسمة_أدنى_موقع_على_سالب_واحد: الفخ,
        باقي_أدنى_موقع_على_سالب_واحد: الفخ
    };
    أرجع العقد;
}

عام نوع حساب_صحيح_مسير = {
    العملية: عملية_حساب_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

عام نوع عملية_مقارنة_صحيح =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

عام نوع مقارنة_صحيح_مسير = {
    العملية: عملية_مقارنة_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};


عام نوع عملية_حساب_عشري =
    | جمع
    | طرح
    | ضرب
    | قسمة
;

عام نوع حساب_عشري_مسير = {
    العملية: عملية_حساب_عشري,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

عام نوع عملية_مقارنة_عشري =
    | يساوي
    | لا_يساوي
    | أصغر
    | أصغر_أو_يساوي
    | أكبر
    | أكبر_أو_يساوي
;

عام نوع مقارنة_عشري_مسير = {
    العملية: عملية_مقارنة_عشري,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير
};

// هذه تحويلات أعداد صحيحة ذات معنى مستقل عن حجم المؤشر أو ABI أو Layout.
عام نوع عملية_تحويل_صحيح =
    | توسيع_بإشارة
    | توسيع_صفري
    | اقتطاع
    | إعادة_تفسير
;

عام نوع تحويل_صحيح_مسير = {
    العملية: عملية_تحويل_صحيح,
    المصدر: معرف_قيمة_مسير
};

// تحويل دلالي لقيمة مرجع إلى قيمة مؤشر، بلا تفاصيل تمثيل مادي.
عام نوع مرجع_إلى_مؤشر_مسير = {
    المرجع: معرف_قيمة_مسير
};

// هوية هدف النداء المقننة في MSIR تحفظ الفرق الدلالي بين دالة سلطانC
// وبدائي المترجم. البدائي هنا ليس خدمة Runtime منخفضة المستوى.
عام نوع هدف_نداء_مسير =
    | دالة_سلطان بنوع معرف_دالة_مسير
    | دالة_خارجية بنوع معرف_دالة_خارجية_مسير
    | بدائي_مترجم بنوع هوية_بدائي_مترجم
    | قيمة_دالة بنوع معرف_قيمة_مسير
;

عام نوع نداء_مسير = {
    الهدف: هدف_نداء_مسير,
    الحجج: متجه معرف_قيمة_مسير,
    // البدائيات ذات أثر lvalue تحمل المكان الدلالي صراحة. الحجج تبقى قيما
    // عادية، والمكان لا يتحول إلى قيمة من الدرجة الأولى. حاليا append فقط.
    مكان_التعديل: اختيار معرف_قيمة_مسير
};

// Aggregate membership uses canonical semantic member order only; it carries no physical offsets.
عام نوع تجميع_مسير = {
    الأعضاء: متجه معرف_قيمة_مسير
};

// Vector initialization is semantically distinct from aggregate field construction.
// The elements are semantic vector members; physical data/length/capacity representation belongs to Backend/Layout.
عام نوع تهيئة_متجه_مسير = {
    العناصر: متجه معرف_قيمة_مسير
};

عام نوع استخراج_حقل_مسير = {
    المصدر: معرف_قيمة_مسير,
    الفهرس: غير_موقع
};

عام نوع استخراج_فهرس_مسير = {
    المصدر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

// Places are abstract typed storage identities in the value-id namespace. A place-producing
// instruction is never a first-class value; verifier enforces the distinction structurally.
عام نوع مكان_محلي_مسير = {
    قابل_للكتابة: منطقي
};

عام نوع مرجع_إلى_مكان_مسير = {
    المرجع: معرف_قيمة_مسير
};

عام نوع صندوق_إلى_مكان_مسير = {
    الصندوق: معرف_قيمة_مسير
};

عام نوع مكان_حقل_مسير = {
    الأصل: معرف_قيمة_مسير,
    الفهرس: غير_موقع
};

عام نوع مكان_فهرس_مسير = {
    الأصل: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

// فهرسة المؤشر تحسب موضع تخزين عنصر دلاليا من قيمة المؤشر والفهرس.
// لا يحمل MSIR إزاحة بايتات أو تخطيط هدف؛ تحسبها خلفية المترجم من تخطيط النوع المستهدف.
عام نوع موضع_تخزين_عنصر_مؤشر_مسير = {
    المؤشر: معرف_قيمة_مسير,
    الفهرس: معرف_قيمة_مسير
};

عام نوع تحميل_مسير = {
    المكان: معرف_قيمة_مسير
};

عام نوع تخزين_مسير = {
    المكان: معرف_قيمة_مسير,
    القيمة: معرف_قيمة_مسير
};

عام نوع مكان_إلى_مرجع_مسير = {
    المكان: معرف_قيمة_مسير
};

// Constructor indices are canonical semantic constructor ordinals, never physical tag encodings.
عام نوع بناء_موسوم_مسير = {
    المنشئ: غير_موقع,
    الحمولات: متجه معرف_قيمة_مسير
};

// Tag inspection yields the canonical unsigned 32-bit semantic constructor ordinal.
// Physical tag width/encoding remains Backend/Layout ownership.
عام نوع استعلام_وسم_مسير = {
    المصدر: معرف_قيمة_مسير
};

عام نوع استخراج_حمولة_مسير = {
    المصدر: معرف_قيمة_مسير,
    المنشئ: غير_موقع,
    الحمولة: غير_موقع
};

عام نوع بناء_صندوق_مسير = {
    القيمة: معرف_قيمة_مسير
};

عام نوع عملية_مسير =
    | ثابت بنوع ثابت_مسير
    | حساب_صحيح بنوع حساب_صحيح_مسير
    | مقارنة_صحيح بنوع مقارنة_صحيح_مسير
    | حساب_عشري بنوع حساب_عشري_مسير
    | مقارنة_عشري بنوع مقارنة_عشري_مسير
    | تحويل_صحيح بنوع تحويل_صحيح_مسير
    | مرجع_إلى_مؤشر بنوع مرجع_إلى_مؤشر_مسير
    | تجميع بنوع تجميع_مسير
    | تهيئة_متجه بنوع تهيئة_متجه_مسير
    | استخراج_حقل بنوع استخراج_حقل_مسير
    | استخراج_فهرس بنوع استخراج_فهرس_مسير
    | مكان_محلي بنوع مكان_محلي_مسير
    | مرجع_إلى_مكان بنوع مرجع_إلى_مكان_مسير
    | صندوق_إلى_مكان بنوع صندوق_إلى_مكان_مسير
    | مكان_حقل بنوع مكان_حقل_مسير
    | مكان_فهرس بنوع مكان_فهرس_مسير
    | موضع_تخزين_عنصر_مؤشر بنوع موضع_تخزين_عنصر_مؤشر_مسير
    | تحميل بنوع تحميل_مسير
    | تخزين بنوع تخزين_مسير
    | مكان_إلى_مرجع بنوع مكان_إلى_مرجع_مسير
    | بناء_موسوم بنوع بناء_موسوم_مسير
    | استعلام_وسم بنوع استعلام_وسم_مسير
    | استخراج_حمولة بنوع استخراج_حمولة_مسير
    | بناء_صندوق بنوع بناء_صندوق_مسير
    | نداء بنوع نداء_مسير
;

// نتيجة التعليمة مملوكة للتعليمة نفسها. التعليمات عديمة الناتج لا تنشئ Value ID.
عام نوع تعليمة_مسير = {
    الناتج: اختيار قيمة_مسير,
    العملية: عملية_مسير
};

// Block arguments هي تمثيل الدمج الوحيد؛ لا توجد PHI nodes موازية.
عام نوع حافة_مسير = {
    الهدف: معرف_كتلة_مسير,
    الحجج: متجه معرف_قيمة_مسير
};

عام نوع منهي_مسير =
    | فرع بنوع حافة_مسير
    | فرع_شرطي بنوع (معرف_قيمة_مسير, حافة_مسير, حافة_مسير)
    | إرجاع بنوع اختيار معرف_قيمة_مسير
    | فخ
;

عام نوع كتلة_مسير = {
    المعرف: معرف_كتلة_مسير,
    المعاملات: متجه قيمة_مسير,
    التعليمات: متجه تعليمة_مسير,
    المنهي: اختيار منهي_مسير
};

عام نوع دالة_مسير = {
    المعرف: معرف_دالة_مسير,
    المعاملات: متجه قيمة_مسير,
    الناتج: اختيار معرف_نوع,
    المدخل: اختيار معرف_كتلة_مسير,
    الكتل: متجه كتلة_مسير,
    // Values are owned once by the function in dense ValueID order.
    // Parameters/instructions keep their structural placement, while all
    // type queries consume this canonical value sequence directly.
    القيم: متجه قيمة_مسير,
    القيمة_التالية: غير_موقع
};


// External declarations are MSIR call-interface facts. They carry no body or blocks.
عام نوع دالة_خارجية_مسير = {
    المعرف: معرف_دالة_خارجية_مسير,
    الاسم: متجه غ8,
    المعاملات: متجه معرف_نوع,
    الناتج: اختيار معرف_نوع
};

عام نوع برنامج_مسير = {
    الدوال: متجه دالة_مسير,
    الدوال_الخارجية: متجه دالة_خارجية_مسير,
    دالة_بدء_البرنامج: اختيار معرف_دالة_مسير
};

عام عرف دالة_خارجية_مسير_موجودة(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): منطقي {
    دع الحالة: برنامج_مسير = *البرنامج;
    أرجع المعرف.القيمة < (الطول(الحالة.الدوال_الخارجية) مثل غير_موقع);
}

عام عرف دالة_خارجية_مسير_عند(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_خارجية_مسير
): اختيار دالة_خارجية_مسير {
    لو (!دالة_خارجية_مسير_موجودة(البرنامج, المعرف)) { أرجع اختيار.لا_شيء(); };
    دع الحالة: برنامج_مسير = *البرنامج;
    دع مرجع_الدالة: &دالة_خارجية_مسير = &الحالة.الدوال_الخارجية[المعرف.القيمة];
    دع الدالة: دالة_خارجية_مسير = *مرجع_الدالة;
    أرجع اختيار.بعض(الدالة);
}

// هوية بدء البرنامج المقننة على حد MSIR العام. وحدات المكتبة لا تملك دالة بدء.
عام عرف معرف_دالة_بدء_برنامج_مسير(
    البرنامج: &برنامج_مسير
): اختيار معرف_دالة_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    أرجع الحالة.دالة_بدء_البرنامج;
}

// استعلامات العضوية البنائية المقننة يملكها نموذج MSIR نفسه.
// Builder وVerifier يضيفان سياستهما فوق هذه الحقيقة ولا يعيدان تنفيذها.
عام عرف دالة_مسير_موجودة(
    البرنامج: &برنامج_مسير,
    المعرف: معرف_دالة_مسير
): منطقي {
    دع الحالة: برنامج_مسير = *البرنامج;
    لو (المعرف.القيمة >= (الطول(الحالة.الدوال) مثل غير_موقع)) {
        أرجع خطأ;
    };
    أرجع دالتا_مسير_متساويتان(
        الحالة.الدوال[المعرف.القيمة].المعرف,
        المعرف
    );
}

عام عرف كتلة_مسير_موجودة(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    لو (!دالتا_مسير_متساويتان(المعرف.الدالة, الحالة.المعرف)) {
        أرجع خطأ;
    };
    لو (المعرف.القيمة >= (الطول(الحالة.الكتل) مثل غير_موقع)) {
        أرجع خطأ;
    };
    أرجع كتلتان_مسير_متساويتان(
        الحالة.الكتل[المعرف.القيمة].المعرف,
        المعرف
    );
}
