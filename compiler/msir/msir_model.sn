// Whether the function was defined with the C calling convention (@@c_abi).
عام عرف دالة_باتفاقية_سي_مسير(البرنامج: &برنامج_مسير, المعرف: معرف_دالة_مسير): منطقي {
    أرجع (المعرف.القيمة مثل طبيعي) < (الطول((*البرنامج).دوال_اتفاقية_سي) مثل طبيعي)
        && (*البرنامج).دوال_اتفاقية_سي[المعرف.القيمة];
}
