        الترتيب: (*القيمة).الترتيب,
        المنتقي: (*القيمة).المنتقي,
        التوقيع: انسخ_مملوكا_توقيع_نداء_بدائي(&(*القيمة).التوقيع)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_دالة_خارجية_مسير(القيمة: &متجه دالة_خارجية_مسير): متجه دالة_خارجية_مسير {
    ليكن الناتج: متغير متجه دالة_خارجية_مسير = [];
