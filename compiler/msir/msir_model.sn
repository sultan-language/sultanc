        المكتبة: انسخ_اختيار_بايتات(&(*القيمة).المكتبة),
        المعاملات: انسخ_مملوكا_متجه_معرف_نوع(&(*القيمة).المعاملات),
        الناتج: (*القيمة).الناتج,
        المعاملات_الثابتة: (*القيمة).المعاملات_الثابتة,
