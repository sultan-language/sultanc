استورد compiler.frontend.types.type_identity;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_analysis;

// Integer strength reduction on MSIR (msir_optimization_pipeline.sn runs it
// at every level but بلا, then flow simplification drops what it leaves
// dead). Every consumer (the native backends, LLVM, both interpreters)
// receives the cheaper operations:
//
// - x %u 2^k (k >= 1) is x & (2^k - 1);
// - x %s 2^k whose every use is a compare of it with 0 for equality is
//   x & (2^k - 1): a remainder is 0 exactly when the low k bits are, at any
//   sign (so `n % 2 == 0` is a bit test, which AArch64 branches on with
//   TBZ/TBNZ and x86-64 with AND and Jcc);
// - a remainder x % c after the quotient x / c of the same operands in the
//   same block, c a constant (not 0, not -1), is x -% (x / c) *% c: one
//   division by c instead of two. The quotient ran first, so the remainder
//   cannot trap where the quotient did not.
//
// No rewrite drops an operation that may trap: a remainder by a power of two
// or a constant c above never traps (runtime_checks.sn's test of its divisor
// folds away). Functions holding compile-time work and the module
// initializer are left as they are.

// The constant each value is defined by: its 64-bit pattern, and whether it
// is a signed constant.
نوع ثابت_تخفيف = {
    القيمة: طبيعي,
    موقع: منطقي
};

عرف ثوابت_دالة_تخفيف(الدالة: &دالة_مسير): متجه اختياري ثابت_تخفيف {
    ليكن الناتج: متغير متجه اختياري ثابت_تخفيف = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(الناتج, (الطول((*الدالة).القيم) مثل طبيعي));
    طالما (ف < (الطول((*الدالة).القيم) مثل طبيعي)) { ألحق(الناتج, اختياري.لا_شيء()); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق موضع_ناتج_تعليمة_مسير(&(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(ق) -> {
                طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.ثابت(الثابت) -> {
                    طابق الثابت مع
                    | ثابت_مسير.صحيح_موقع(س) -> {
                        ليكن الثابت_: ثابت_تخفيف = { القيمة: س مثل طبيعي, موقع: صواب };
                        إذا (ق < (الطول(الناتج) مثل طبيعي)) { الناتج[ق] := اختياري.موجود(الثابت_); };
                    }
                    | ثابت_مسير.صحيح_طبيعي(س) -> {
                        ليكن الثابت_: ثابت_تخفيف = { القيمة: س, موقع: خطأ };
                        إذا (ق < (الطول(الناتج) مثل طبيعي)) { الناتج[ق] := اختياري.موجود(الثابت_); };
                    }
                    | _ -> { };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ثابت_قيمة_تخفيف(الثوابت: &متجه اختياري ثابت_تخفيف, القيمة: معرف_قيمة_مسير): اختياري ثابت_تخفيف {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول(*الثوابت) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*الثوابت)[ق];
}

// k when the constant is 2^k with k >= 1 (a positive signed constant too).
عرف أس_اثنين_تخفيف(الثابت: اختياري ثابت_تخفيف): اختياري طبيعي {
    طابق الثابت مع
    | اختياري.موجود(ث) -> {
        ليكن ق: طبيعي = ث.القيمة;
        إذا (ق < 2 || (ق & (ق - 1)) != 0) { أرجع اختياري.لا_شيء(); };
        // A signed pattern with the top bit set is negative.
        إذا (ث.موقع && ق >= 0x8000000000000000) { أرجع اختياري.لا_شيء(); };
        ليكن ك: متغير طبيعي = 0;
        ليكن الباقي: متغير طبيعي = ق;
        طالما (الباقي > 1) { الباقي := الباقي >> 1; ك := ك + 1; }
        أرجع اختياري.موجود(ك);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// For each value, how many of its uses compare it with a constant 0 for
// equality or inequality.
عرف استخدامات_مقارنة_صفر_تخفيف(
    الدالة: &دالة_مسير,
    الثوابت: &متجه اختياري ثابت_تخفيف
): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    احجز_سعة(الناتج, (الطول((*الدالة).القيم) مثل طبيعي));
    طالما (ف < (الطول((*الدالة).القيم) مثل طبيعي)) { ألحق(الناتج, 0); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.مقارنة_صحيح(م) -> {
                ليكن مساواة: متغير منطقي = خطأ;
                طابق م.العملية مع
                | عملية_مقارنة_صحيح.يساوي -> { مساواة := صواب; }
                | عملية_مقارنة_صحيح.لا_يساوي -> { مساواة := صواب; }
                | _ -> { };
                إذا (مساواة) {
                    ليكن الأيسر: طبيعي = م.اليسار.القيمة مثل طبيعي;
                    ليكن الأيمن: طبيعي = م.اليمين.القيمة مثل طبيعي;
                    إذا (ثابت_صفر_تخفيف(ثابت_قيمة_تخفيف(الثوابت, م.اليمين)) && الأيسر < (الطول(الناتج) مثل طبيعي)) {
                        الناتج[الأيسر] := الناتج[الأيسر] + 1;
                    } وإلا إذا (ثابت_صفر_تخفيف(ثابت_قيمة_تخفيف(الثوابت, م.اليسار)) && الأيمن < (الطول(الناتج) مثل طبيعي)) {
                        الناتج[الأيمن] := الناتج[الأيمن] + 1;
                    };
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف ثابت_صفر_تخفيف(الثابت: اختياري ثابت_تخفيف): منطقي {
    طابق الثابت مع
    | اختياري.موجود(ث) -> { أرجع ث.القيمة == 0; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// A new value of النوع in الدالة, as the builder makes one.
عرف قيمة_جديدة_تخفيف(الدالة: &متغير دالة_مسير, النوع: معرف_نوع): قيمة_مسير {
    ليكن المعرف: معرف_قيمة_مسير = معرف_قيمة_مسير_من((*الدالة).المعرف, (*الدالة).القيمة_التالية);
    (*الدالة).القيمة_التالية := (*الدالة).القيمة_التالية + 1;
    ليكن القيمة: قيمة_مسير = { المعرف: المعرف, النوع: النوع };
    ألحق((*الدالة).القيم, القيمة);
    أرجع القيمة;
}

// Moves instruction م of block ك to the end of الباقية, leaving a placeholder.
عرف انقل_تعليمة_تخفيف(
    الدالة: &متغير دالة_مسير,
    ك: طبيعي,
    م: طبيعي,
    الباقية: &متغير متجه تعليمة_مسير
): فراغ {
    ليكن المنقولة: متغير تعليمة_مسير = {
        الناتج: ناتج_تعليمة_مسير_من(اختياري.لا_شيء()),
        موقع_التصحيح: (*الدالة).الكتل[ك].التعليمات[م].موقع_التصحيح,
        العملية: عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ)),
        نطاق_التصحيح: (*الدالة).الكتل[ك].التعليمات[م].نطاق_التصحيح,
        تقييم_وقت_الترجمة: خطأ
    };
    بدّل((*الدالة).الكتل[ك].التعليمات[م], المنقولة);
    ألحق(*الباقية, المنقولة);
}

// Inserts an instruction defining a new value of النوع by العملية before
// instruction ت of block ك, with that instruction's debug location and
// scope; the new value.
عرف أدرج_قبل_تخفيف(
    الدالة: &متغير دالة_مسير,
    ك: طبيعي,
    ت: طبيعي,
    العملية: عملية_مسير,
    النوع: معرف_نوع
): معرف_قيمة_مسير {
    ليكن القيمة: قيمة_مسير = قيمة_جديدة_تخفيف(الدالة, النوع);
    ليكن الجديدة: تعليمة_مسير = {
        الناتج: ناتج_تعليمة_مسير_من(اختياري.موجود(القيمة)),
        موقع_التصحيح: (*الدالة).الكتل[ك].التعليمات[ت].موقع_التصحيح,
        العملية: العملية,
        نطاق_التصحيح: (*الدالة).الكتل[ك].التعليمات[ت].نطاق_التصحيح,
        تقييم_وقت_الترجمة: خطأ
    };
    ليكن العدد: طبيعي = الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي;
    ليكن الباقية: متغير متجه تعليمة_مسير = [];
    ليكن م: متغير طبيعي = 0;
    // The instructions before ت, the new one, then ت and the rest.
    طالما (م < ت) {
        انقل_تعليمة_تخفيف(الدالة, ك, م, &متغير الباقية);
        م := م + 1;
    }
    ألحق(الباقية, الجديدة);
    طالما (م < العدد) {
        انقل_تعليمة_تخفيف(الدالة, ك, م, &متغير الباقية);
        م := م + 1;
    }
    (*الدالة).الكتل[ك].التعليمات := الباقية;
    أرجع القيمة.المعرف;
}

// A constant of the pattern القيمة, signed or not, of النوع, before
// instruction ت of block ك.
عرف أدرج_ثابتا_تخفيف(
    الدالة: &متغير دالة_مسير,
    ك: طبيعي,
    ت: طبيعي,
    القيمة: طبيعي,
    موقع: منطقي,
    النوع: معرف_نوع
): معرف_قيمة_مسير {
    ليكن الثابت: متغير ثابت_مسير = ثابت_مسير.صحيح_طبيعي(القيمة);
    إذا (موقع) { الثابت := ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
    أرجع أدرج_قبل_تخفيف(الدالة, ك, ت, عملية_مسير.ثابت(الثابت), النوع);
}

عرف نوع_قيمة_تخفيف(الدالة: &دالة_مسير, القيمة: معرف_قيمة_مسير): اختياري معرف_نوع {
    ليكن ق: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (ق >= (الطول((*الدالة).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الدالة).القيم[ق].النوع);
}

// A quotient seen in the current block: its operands and value.
نوع خارج_قسمة_تخفيف = {
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير,
    الناتج: معرف_قيمة_مسير,
    موقع: منطقي
};

// Rewrites one function; true when it changed.
عرف خفف_عمليات_دالة_مسير(الدالة: &متغير دالة_مسير): منطقي {
    ليكن الثوابت: متجه اختياري ثابت_تخفيف = ثوابت_دالة_تخفيف(الدالة);
    ليكن الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, الطول((*الدالة).القيم) مثل طبيعي);
    ليكن مقارنات_الصفر: متجه طبيعي = استخدامات_مقارنة_صفر_تخفيف(الدالة, &الثوابت);
    ليكن تغيرت: متغير منطقي = خطأ;
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن الخوارج: متغير متجه خارج_قسمة_تخفيف = [];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            ليكن الحساب: متغير اختياري حساب_صحيح_مسير = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.حساب_صحيح(ح) -> { الحساب := اختياري.موجود(ح); }
            | _ -> { };
            ليكن الناتج: اختياري معرف_قيمة_مسير = معرف_ناتج_تعليمة_في_مسير(
                (*الدالة).المعرف, &(*الدالة).الكتل[ك].التعليمات[ت]
            );
            طابق الحساب مع
            | اختياري.موجود(ح) -> {
                طابق الناتج مع
                | اختياري.موجود(ق) -> {
                    ليكن رقم: متغير طبيعي = 0;
                    طابق ح.العملية مع
                    | عملية_حساب_صحيح.قسمة_موقعة -> { رقم := 1; }
                    | عملية_حساب_صحيح.قسمة_طبيعية -> { رقم := 2; }
                    | عملية_حساب_صحيح.باقي_موقع -> { رقم := 3; }
                    | عملية_حساب_صحيح.باقي_طبيعي -> { رقم := 4; }
                    | _ -> { };
                    ليكن موقع: منطقي = رقم == 1 || رقم == 3;
                    إذا (رقم == 1 || رقم == 2) {
                        // A quotient by a constant other than 0 and -1.
                        طابق ثابت_قيمة_تخفيف(&الثوابت, ح.اليمين) مع
                        | اختياري.موجود(ث) -> {
                            ليكن الصفر: طبيعي = 0;
                            إذا (ث.القيمة != 0 && ث.القيمة != ~الصفر) {
                                ليكن الخارج: خارج_قسمة_تخفيف = {
                                    اليسار: ح.اليسار, اليمين: ح.اليمين, الناتج: ق, موقع: موقع
                                };
                                ألحق(الخوارج, الخارج);
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    };
                    إذا (رقم == 3 || رقم == 4) {
                        ليكن موضع_ق: طبيعي = ق.القيمة مثل طبيعي;
                        ليكن مقنع: متغير منطقي = خطأ;
                        طابق أس_اثنين_تخفيف(ثابت_قيمة_تخفيف(&الثوابت, ح.اليمين)) مع
                        | اختياري.موجود(الأس) -> {
                            // Unsigned always; signed when only compares with
                            // 0 for equality read it.
                            إذا (!موقع || (موضع_ق < (الطول(الاستخدامات) مثل طبيعي)
                                && الاستخدامات[موضع_ق] > 0 && الاستخدامات[موضع_ق] == مقارنات_الصفر[موضع_ق])) {
                                طابق نوع_قيمة_تخفيف(الدالة, ح.اليسار) مع
                                | اختياري.موجود(النوع) -> {
                                    ليكن الواحد: طبيعي = 1;
                                    ليكن القناع: معرف_قيمة_مسير = أدرج_ثابتا_تخفيف(
                                        الدالة, ك, ت, (الواحد << الأس) - 1, موقع, النوع
                                    );
                                    ت := ت + 1;
                                    ليكن و_: حساب_صحيح_مسير = {
                                        العملية: عملية_حساب_صحيح.و_بتي(), اليسار: ح.اليسار, اليمين: القناع
                                    };
                                    (*الدالة).الكتل[ك].التعليمات[ت].العملية := عملية_مسير.حساب_صحيح(و_);
                                    مقنع := صواب;
                                    تغيرت := صواب;
                                }
                                | اختياري.لا_شيء -> { };
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        // After the quotient of the same operands: x -% q *% c.
                        إذا (!مقنع) {
                            ليكن م: متغير طبيعي = 0;
                            ليكن وجد: متغير منطقي = خطأ;
                            طالما (م < (الطول(الخوارج) مثل طبيعي) && !وجد) {
                                إذا (الخوارج[م].اليسار.القيمة == ح.اليسار.القيمة
                                    && الخوارج[م].اليمين.القيمة == ح.اليمين.القيمة && الخوارج[م].موقع == موقع) {
                                    طابق نوع_قيمة_تخفيف(الدالة, ح.اليسار) مع
                                    | اختياري.موجود(النوع) -> {
                                        ليكن الضرب: حساب_صحيح_مسير = {
                                            العملية: عملية_حساب_صحيح.ضرب_ملتف(),
                                            اليسار: الخوارج[م].الناتج, اليمين: ح.اليمين
                                        };
                                        ليكن الجداء: معرف_قيمة_مسير = أدرج_قبل_تخفيف(
                                            الدالة, ك, ت, عملية_مسير.حساب_صحيح(الضرب), النوع
                                        );
                                        ت := ت + 1;
                                        ليكن الطرح: حساب_صحيح_مسير = {
                                            العملية: عملية_حساب_صحيح.طرح_ملتف(), اليسار: ح.اليسار, اليمين: الجداء
                                        };
                                        (*الدالة).الكتل[ك].التعليمات[ت].العملية := عملية_مسير.حساب_صحيح(الطرح);
                                        تغيرت := صواب;
                                        وجد := صواب;
                                    }
                                    | اختياري.لا_شيء -> { };
                                };
                                م := م + 1;
                            }
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع تغيرت;
}

// Whether a function is one the pass leaves alone: compile-time work.
عرف دالة_بعمل_وقت_ترجمة_تخفيف(الدالة: &دالة_مسير): منطقي {
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { أرجع صواب; };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

// Reduces every function المحسنة marks but the module initializer; the
// functions it changed, by position.
عام عرف خفف_عمليات_برنامج_مسير(البرنامج: &متغير برنامج_مسير, المحسنة: &متجه منطقي): متجه منطقي {
    ليكن المتغيرة: متغير متجه منطقي = [];
    ليكن د: متغير طبيعي = 0;
    احجز_سعة(المتغيرة, (الطول((*البرنامج).الدوال) مثل طبيعي));
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) { ألحق(المتغيرة, خطأ); د := د + 1; }
    د := 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي) && د < (الطول(*المحسنة) مثل طبيعي)) {
        ليكن مستثناة: متغير منطقي = !(*المحسنة)[د];
        طابق (*البرنامج).دالة_تهيئة_الوحدة مع
        | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) == د) { مستثناة := صواب; }; }
        | اختياري.لا_شيء -> { };
        إذا (!مستثناة && !دالة_بعمل_وقت_ترجمة_تخفيف(&(*البرنامج).الدوال[د])) {
            إذا (خفف_عمليات_دالة_مسير(&متغير (*البرنامج).الدوال[د])) { المتغيرة[د] := صواب; };
        };
        د := د + 1;
    }
    أرجع المتغيرة;
}
