// سياق الخفض المشترك وحالة الدالة واستعلامات الحقائق الدلالية المقننة.
عام عرف هل_نوع_بدائي_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == المتوقع;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف هل_نوع_فراغ_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.فراغ());
}

عام عرف هل_نوع_منطقي_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.منطقي());
}

عام عرف هل_نوع_نص_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.نص());
}

عام عرف هل_نوع_عشري_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف وصف_صحيح_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_صحيح_خفض {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الناتج: وصف_صحيح_خفض = {
                    موقع: صواب,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الناتج);
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الناتج: وصف_صحيح_خفض = {
                    موقع: خطأ,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الناتج);
            }
            | _ -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    };
}

// `متغير T` يصف قابلية موضع المصدر للتغيير، لا تمثيل قيمة MSIR.
// نزيل الغلاف الخارجي فقط؛ أي قابلية تغيير داخل مرجع/مؤشر تبقى جزءا من النوع.
عام عرف نوع_تمثيل_قيمة_مسير_للخفض(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    أرجع أزل_غلاف_متغير(الأنواع, النوع);
}

عام عرف نوع_تعبير_للخفض(
    الأنواع: &سجل_أنواع,
    الأنواع_الدلالية: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): نتيجة_حل_نوع_للخفض {
    دع النطاق: نطاق = نطاق_تعبير(التعبير);
    طابق نوع_تعبير_عند(الأنواع_الدلالية, النطاق) مع
    | اختياري.موجود(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(نوع_التمثيل) -> {
            أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حل_نوع_للخفض.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
            );
        };
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_حل_نوع_للخفض.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
        );
    };
}

عام عرف نوع_رمز_دلالي_للخفض(
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    الرمز: معرف_رمز
): نتيجة_حل_نوع_للخفض {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*أنواع_رموز_المثيل) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        دع المدخل: ربط_نوع_رمز_خفض = (*أنواع_رموز_المثيل)[الوسط];
        لو (المدخل.الرمز.القيمة < الرمز.القيمة) {
            البداية := الوسط + 1;
        } وإلا لو (المدخل.الرمز.القيمة > الرمز.القيمة) {
            النهاية := الوسط;
        } وإلا {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المدخل.النوع) مع
            | اختياري.موجود(نوع_التمثيل) -> { أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل); }
            | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
        };
    }
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختياري.موجود(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(نوع_التمثيل) -> { أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل); }
        | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
}

عام عرف رمز_اسم_للخفض(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_خفض_مسير {
    دع قيمة_الاسم: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.ربط_اسم_مفقود(قيمة_الاسم.النطاق));
    };
}

عام عرف سياق_دوال_خفض_جديد(): سياق_دوال_خفض {
    دع الدوال: متجه ربط_دالة_خفض = [];
    دع فهرس_الدوال: الخريطة<طلب_مثيل_دالة_خفض, طبيعي> = أنشئ_فهرس_مثيل_دالة_خفض();
    دع القيم_العليا: متجه ربط_قيمة_عليا_خفض = [];
    دع منشئات_لينكس: متجه منشئ_نواة_موثق_واجهة = [];
    دع رموز_لا_تعود: متجه معرف_رمز = [];
    دع رموز_التنسيق: متجه معرف_رمز = [];
    دع السياق: سياق_دوال_خفض = {
        الدوال: الدوال,
        فهرس_الدوال: فهرس_الدوال,
        القيم_العليا: القيم_العليا,
        منتقي_لينكس: اختياري.لا_شيء(),
        منشئات_لينكس: منشئات_لينكس,
        حقائق_الملكية: حقائق_ملكية_تدفق_جديدة(),
        رموز_لا_تعود: رموز_لا_تعود,
        رموز_التنسيق: رموز_التنسيق
    };
    أرجع السياق;
}

عام عرف قيمة_عليا_خفض_عند(السياق: &سياق_دوال_خفض, الرمز: معرف_رمز): اختياري ربط_قيمة_عليا_خفض {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).القيم_العليا) مثل طبيعي)) {
        لو (معرفا_رمز_متساويان((*السياق).القيم_العليا[ف].الرمز, الرمز)) {
            دع الهدف: هدف_قيمة_عليا_خفض = انسخ_هدف_قيمة_عليا_خفض(&(*السياق).القيم_العليا[ف].الهدف);
            دع الربط: ربط_قيمة_عليا_خفض = {
                الرمز: (*السياق).القيم_العليا[ف].الرمز,
                النوع: (*السياق).القيم_العليا[ف].النوع,
                قابل_للكتابة: (*السياق).القيم_العليا[ف].قابل_للكتابة,
                الهدف: الهدف
            };
            أرجع اختياري.موجود(الربط);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أضف_قيمة_عليا_خفض(السياق: &متغير سياق_دوال_خفض, الربط: ربط_قيمة_عليا_خفض): منطقي {
    طابق قيمة_عليا_خفض_عند(السياق, الربط.الرمز) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    ألحق((*السياق).القيم_العليا, الربط);
    أرجع صواب;
}

عام عرف موضع_دالة_خفض(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختياري طبيعي {
    دع استبدالات_المفتاح: متجه ربط_استبدال_نوع = انسخ_مملوكا_متجه_ربط_استبدال_نوع(الاستبدالات);
    دع المفتاح: طلب_مثيل_دالة_خفض = {
        الرمز: الرمز,
        استبدالات_النوع: استبدالات_المفتاح
    };
    أرجع ابحث_في_الخريطة(&(*السياق).فهرس_الدوال, &المفتاح);
}

عام عرف دالة_خفض_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز
): اختياري ربط_دالة_خفض {
    دع بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    أرجع دالة_خفض_بمثيل_عند(السياق, الرمز, &بلا_استبدالات);
}

عام عرف استبدالات_نوع_متساوية(
    أ: &متجه ربط_استبدال_نوع,
    ب: &متجه ربط_استبدال_نوع
): منطقي {
    أرجع استبدالات_مثيل_دالة_متساوية(أ, ب);
}

عام عرف دالة_خفض_بمثيل_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختياري ربط_دالة_خفض {
    طابق موضع_دالة_خفض(السياق, الرمز, الاستبدالات) مع
    | اختياري.موجود(الموضع) -> {
        دع مرجع_الربط: &ربط_دالة_خفض = &(*السياق).الدوال[الموضع];
        دع الربط: ربط_دالة_خفض = انسخ_مملوكا_ربط_دالة_خفض(مرجع_الربط);
        أرجع اختياري.موجود(الربط);
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف أضف_دالة_خفض(
    السياق: &متغير سياق_دوال_خفض,
    الربط: ربط_دالة_خفض
): نتيجة منطقي, خطأ_خفض_مسير {
    دع استبدالات_المفتاح: متجه ربط_استبدال_نوع = انسخ_استبدالات_مثيل_دالة(
        &الربط.استبدالات_النوع
    );
    دع مفتاح_البحث: طلب_مثيل_دالة_خفض = {
        الرمز: الربط.الرمز,
        استبدالات_النوع: استبدالات_المفتاح
    };
    طابق ابحث_في_الخريطة(&(*السياق).فهرس_الدوال, &مفتاح_البحث) مع
    | اختياري.موجود(_) -> { أرجع نتيجة.نجح(خطأ); }
    | اختياري.لا_شيء -> { };

    دع الموضع: طبيعي = الطول((*السياق).الدوال) مثل طبيعي;
    طابق أدرج_في_الخريطة(&متغير (*السياق).فهرس_الدوال, مفتاح_البحث, الموضع) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
    }
    | نتيجة.نجح(السابق) -> {
        طابق السابق مع
        | اختياري.لا_شيء -> {
            ألحق((*السياق).الدوال, الربط);
            أرجع نتيجة.نجح(صواب);
        }
        | اختياري.موجود(الموضع_السابق) -> {
            // Restore the canonical index if insertion replaced an existing key.
            دع مفتاح_سابق: طلب_مثيل_دالة_خفض = {
                الرمز: الربط.الرمز,
                استبدالات_النوع: انسخ_استبدالات_مثيل_دالة(&الربط.استبدالات_النوع)
            };
            طابق أدرج_في_الخريطة(&متغير (*السياق).فهرس_الدوال, مفتاح_سابق, الموضع_السابق) مع
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(خطأ); }
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
            };
        };
    };
}

عام عرف موضع_محلي_خفض(
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): اختياري طبيعي {
    // Local lookup borrows the canonical state; it never needs a flow snapshot.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        لو (معرفا_رمز_متساويان((*الحالة).المحليات[ف].الرمز, الرمز)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف تأكد_محليات_خفض_فريدة(الحالة: &متغير حالة_خفض_دالة): فراغ {
    لو (!(*الحالة).المحليات_مشتركة) { أرجع; };
    دع العدد: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    (*الحالة).المحليات := قص_محليات_خفض(&(*الحالة).المحليات, العدد);
    (*الحالة).المحليات_مشتركة := خطأ;
}

// Replaces the locals with a private copy of their first العدد entries.
// Scope exits used to make the table unique (a full copy when shared) and then
// copy its prefix again; the prefix copy alone already yields a private table.
// A private table that already ends at العدد is kept as is.
عام عرف اقصر_محليات_حالة_خفض(الحالة: &متغير حالة_خفض_دالة, العدد: طبيعي): فراغ {
    لو (!(*الحالة).المحليات_مشتركة && (الطول((*الحالة).المحليات) مثل طبيعي) <= العدد) { أرجع; };
    (*الحالة).المحليات := قص_محليات_خفض(&(*الحالة).المحليات, العدد);
    (*الحالة).المحليات_مشتركة := خطأ;
}

عام عرف أضف_محلي_خفض(
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: اختياري معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(_) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.محلي_مكرر(الرمز));
    }
    | اختياري.لا_شيء -> {
    };
    تأكد_محليات_خفض_فريدة(الحالة);
    دع لا_مكان: اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    دع لا_راية: اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    دع الربط: ربط_محلي_خفض = {
        الرمز: الرمز,
        النوع: النوع,
        القيمة: القيمة,
        المكان: لا_مكان,
        الراية: لا_راية
    };
    ألحق((*الحالة).المحليات, الربط);
    أرجع اختياري.لا_شيء();
}

عام عرف قيمة_محلي_خفض(
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): نتيجة_خفض_تعبير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الموضع) -> {
        دع مرجع_المحلي: &ربط_محلي_خفض = &(*الحالة).المحليات[الموضع];
        دع المحلي: ربط_محلي_خفض = *مرجع_المحلي;
        طابق المحلي.القيمة مع
        | اختياري.موجود(المعرف) -> {
            دع القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: المحلي.النوع };
            أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز));
        };
    };
}

عام عرف خفض_قيمة_محلي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): نتيجة_خفض_تعبير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الموضع) -> {
        دع المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
        طابق المحلي.القيمة مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز));
        }
        | اختياري.موجود(القيمة_المعلّمة) -> {
            طابق المحلي.المكان مع
            | اختياري.موجود(المكان) -> {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_تحميل_مسير(
                        البرنامج,
                        &(*الحالة).البناء,
                        (*الحالة).الدالة,
                        (*الحالة).الكتلة,
                        المكان,
                        المحلي.النوع
                    ),
                    المحلي.النوع
                );
            }
            | اختياري.لا_شيء -> {
                دع القيمة: قيمة_خفض_مسير = {
                    المعرف: القيمة_المعلّمة,
                    النوع: المحلي.النوع
                };
                أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
            };
        };
    };
}

عام عرف قص_محليات_خفض(
    المحليات: &متجه ربط_محلي_خفض,
    العدد: طبيعي
): متجه ربط_محلي_خفض {
    دع الناتج: متغير متجه ربط_محلي_خفض = [];
    دع ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (ف < (الطول(*المحليات) مثل طبيعي))) {
        ألحق(الناتج, (*المحليات)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_حالة_خفض(الحالة: &متغير حالة_خفض_دالة): حالة_خفض_دالة {
    // A branch snapshot owns an independent copy of the locals table (plain
    // bindings): it is mutated independently and dropped with the snapshot.
    دع المحليات_المشتركة: متجه ربط_محلي_خفض = انسخ_مملوكا_متجه_ربط_محلي_خفض(&(*الحالة).المحليات);
    دع النسخة: حالة_خفض_دالة = {
        الدالة: (*الحالة).الدالة,
        الكتلة: (*الحالة).الكتلة,
        نشطة: (*الحالة).نشطة,
        البناء: (*الحالة).البناء,
        المحليات: المحليات_المشتركة,
        له_هدف_خروج_حلقة: (*الحالة).له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: (*الحالة).هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: (*الحالة).له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: (*الحالة).هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: (*الحالة).عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: (*الحالة).إطار_الإسقاط
    };
    أرجع النسخة;
}

عام عرف قيمة_من_بناء_للخفض(
    النتيجة: نتيجة_بناء_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        دع القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف اختم_بفرع_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الهدف: معرف_كتلة_مسير,
    الحجج: &متجه معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    دع حالة_القراءة: حالة_خفض_دالة = *الحالة;
    طابق اختم_بفرع_مسير(
        البرنامج,
        حالة_القراءة.الدالة,
        حالة_القراءة.الكتلة,
        الهدف,
        الحجج
    ) مع
    | نتيجة_بناء_منهي_مسير.مبني -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف أضف_كتلة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(الكتلة) -> {
        أرجع نتيجة.نجح(الكتلة);
    }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}
