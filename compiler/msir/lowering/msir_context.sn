// سياق الخفض المشترك وحالة الدالة واستعلامات الحقائق الدلالية المقننة.
عام عرف هل_نوع_بدائي_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == المتوقع;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف هل_نوع_فراغ_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.فراغ());
}

عام عرف هل_نوع_منطقي_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.منطقي());
}

عام عرف هل_نوع_نص_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.نص());
}

عام عرف هل_نوع_عشري_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف وصف_صحيح_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_صحيح_خفض {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            ليكن الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                ليكن البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                ليكن الناتج: وصف_صحيح_خفض = {
                    موقع: صواب,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الناتج);
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                ليكن البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                ليكن الناتج: وصف_صحيح_خفض = {
                    موقع: خطأ,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الناتج);
            }
            | _ -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    };
}

// A character's integer reading: its Unicode scalar value as an unsigned
// integer of the char Type's width, the value `char as u32` gives. MSIR has no
// integer operation on char itself, so character comparisons, character
// patterns and their constant folding all read a char through this one rule
// (the run-time half is اخفض_حرف_إلى_قيمته_العددية_مسير). Nothing for any
// other Type.
عام عرف وصف_قيمة_حرف_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_صحيح_خفض {
    إذا (!هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.حرف())) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الوصف: وصف_صحيح_خفض = {
        موقع: خطأ,
        البتات: بتات_نوع_بدائي(نوع_بدائي_مقنن.حرف())
    };
    أرجع اختياري.موجود(الوصف);
}

// `متغير T` يصف قابلية موضع المصدر للتغيير، لا تمثيل قيمة MSIR.
// نزيل الغلاف الخارجي فقط؛ أي قابلية تغيير داخل مرجع/مؤشر تبقى جزءا من النوع.
عام عرف نوع_تمثيل_قيمة_مسير_للخفض(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    أرجع أزل_غلاف_متغير(الأنواع, النوع);
}

عام عرف نوع_تعبير_للخفض(
    الأنواع: &سجل_أنواع,
    الأنواع_الدلالية: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): نتيجة_حل_نوع_للخفض {
    ليكن النطاق: نطاق = نطاق_تعبير(التعبير);
    طابق نوع_تعبير_عند(الأنواع_الدلالية, النطاق) مع
    | اختياري.موجود(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(نوع_التمثيل) -> {
            أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حل_نوع_للخفض.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
            );
        };
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_حل_نوع_للخفض.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
        );
    };
}

عام عرف نوع_رمز_دلالي_للخفض(
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    الرمز: معرف_رمز
): نتيجة_حل_نوع_للخفض {
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = الطول(*أنواع_رموز_المثيل) مثل طبيعي;
    طالما (البداية < النهاية) {
        ليكن الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        ليكن المدخل: ربط_نوع_رمز_خفض = (*أنواع_رموز_المثيل)[الوسط];
        إذا (المدخل.الرمز.القيمة < الرمز.القيمة) {
            البداية := الوسط + 1;
        } وإلا إذا (المدخل.الرمز.القيمة > الرمز.القيمة) {
            النهاية := الوسط;
        } وإلا {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المدخل.النوع) مع
            | اختياري.موجود(نوع_التمثيل) -> { أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل); }
            | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
        };
    }
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختياري.موجود(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(نوع_التمثيل) -> { أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل); }
        | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_حل_نوع_للخفض.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
}

عام عرف رمز_اسم_للخفض(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_خفض_مسير {
    ليكن قيمة_الاسم: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
    | اختياري.موجود(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.ربط_اسم_مفقود(قيمة_الاسم.النطاق));
    };
}

عام عرف سياق_دوال_خفض_جديد(): سياق_دوال_خفض {
    ليكن الدوال: متجه ربط_دالة_خفض = [];
    ليكن فهرس_الدوال: الخريطة<طلب_مثيل_دالة_خفض, طبيعي> = أنشئ_فهرس_مثيل_دالة_خفض();
    ليكن القيم_العليا: متجه ربط_قيمة_عليا_خفض = [];
    ليكن منشئات_لينكس: متجه منشئ_نواة_موثق_واجهة = [];
    ليكن رموز_لا_تعود: متجه معرف_رمز = [];
    ليكن رموز_التنسيق: متجه معرف_رمز = [];
    ليكن دوال_التتبع: متجه دالة_تتبع_مستدع_خفض = [];
    ليكن مواقع_المستدعين: متجه موقع_مستدع_خفض = [];
    ليكن ملفات_المواقع: متجه ملف_موقع_خفض = [];
    ليكن السياق: سياق_دوال_خفض = {
        الدوال: الدوال,
        فهرس_الدوال: فهرس_الدوال,
        القيم_العليا: القيم_العليا,
        منتقي_لينكس: اختياري.لا_شيء(),
        منشئات_لينكس: منشئات_لينكس,
        الذاكرة: سياق_ذاكرة_وحدة_فارغ(),
        أصناف_الرموز: [],
        رموز_لا_تعود: رموز_لا_تعود,
        رموز_التنسيق: رموز_التنسيق,
        دوال_تتبع_المستدعي: دوال_التتبع,
        مواقع_المستدعين: مواقع_المستدعين,
        ملفات_المواقع: ملفات_المواقع,
        للتحليل: خطأ
    };
    أرجع السياق;
}

عام عرف قيمة_عليا_خفض_عند(السياق: &سياق_دوال_خفض, الرمز: معرف_رمز): اختياري ربط_قيمة_عليا_خفض {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).القيم_العليا) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*السياق).القيم_العليا[ف].الرمز, الرمز)) {
            ليكن الهدف: هدف_قيمة_عليا_خفض = انسخ_هدف_قيمة_عليا_خفض(&(*السياق).القيم_العليا[ف].الهدف);
            ليكن الربط: ربط_قيمة_عليا_خفض = {
                الرمز: (*السياق).القيم_العليا[ف].الرمز,
                النوع: (*السياق).القيم_العليا[ف].النوع,
                قابل_للكتابة: (*السياق).القيم_العليا[ف].قابل_للكتابة,
                الهدف: الهدف
            };
            أرجع اختياري.موجود(الربط);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف أضف_قيمة_عليا_خفض(السياق: &متغير سياق_دوال_خفض, الربط: ربط_قيمة_عليا_خفض): منطقي {
    طابق قيمة_عليا_خفض_عند(السياق, الربط.الرمز) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    ألحق((*السياق).القيم_العليا, الربط);
    أرجع صواب;
}

عام عرف موضع_دالة_خفض(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختياري طبيعي {
    ليكن استبدالات_المفتاح: متجه ربط_استبدال_نوع = انسخ_مملوكا_متجه_ربط_استبدال_نوع(الاستبدالات);
    ليكن المفتاح: طلب_مثيل_دالة_خفض = {
        الرمز: الرمز,
        استبدالات_النوع: استبدالات_المفتاح
    };
    أرجع ابحث_في_الخريطة(&(*السياق).فهرس_الدوال, &المفتاح);
}

عام عرف دالة_خفض_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز
): اختياري ربط_دالة_خفض {
    ليكن بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    أرجع دالة_خفض_بمثيل_عند(السياق, الرمز, &بلا_استبدالات);
}

عام عرف استبدالات_نوع_متساوية(
    أ: &متجه ربط_استبدال_نوع,
    ب: &متجه ربط_استبدال_نوع
): منطقي {
    أرجع استبدالات_مثيل_دالة_متساوية(أ, ب);
}

عام عرف دالة_خفض_بمثيل_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختياري ربط_دالة_خفض {
    طابق موضع_دالة_خفض(السياق, الرمز, الاستبدالات) مع
    | اختياري.موجود(الموضع) -> {
        ليكن مرجع_الربط: &ربط_دالة_خفض = &(*السياق).الدوال[الموضع];
        ليكن الربط: ربط_دالة_خفض = انسخ_مملوكا_ربط_دالة_خفض(مرجع_الربط);
        أرجع اختياري.موجود(الربط);
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف أضف_دالة_خفض(
    السياق: &متغير سياق_دوال_خفض,
    الربط: ربط_دالة_خفض
): نتيجة منطقي, خطأ_خفض_مسير {
    ليكن استبدالات_المفتاح: متجه ربط_استبدال_نوع = انسخ_استبدالات_مثيل_دالة(
        &الربط.استبدالات_النوع
    );
    ليكن مفتاح_البحث: طلب_مثيل_دالة_خفض = {
        الرمز: الربط.الرمز,
        استبدالات_النوع: استبدالات_المفتاح
    };
    طابق ابحث_في_الخريطة(&(*السياق).فهرس_الدوال, &مفتاح_البحث) مع
    | اختياري.موجود(_) -> { أرجع نتيجة.نجح(خطأ); }
    | اختياري.لا_شيء -> { };

    ليكن الموضع: طبيعي = الطول((*السياق).الدوال) مثل طبيعي;
    طابق أدرج_في_الخريطة(&متغير (*السياق).فهرس_الدوال, مفتاح_البحث, الموضع) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
    }
    | نتيجة.نجح(السابق) -> {
        طابق السابق مع
        | اختياري.لا_شيء -> {
            ألحق((*السياق).الدوال, الربط);
            أرجع نتيجة.نجح(صواب);
        }
        | اختياري.موجود(الموضع_السابق) -> {
            // Restore the canonical index if insertion replaced an existing key.
            ليكن مفتاح_سابق: طلب_مثيل_دالة_خفض = {
                الرمز: الربط.الرمز,
                استبدالات_النوع: انسخ_استبدالات_مثيل_دالة(&الربط.استبدالات_النوع)
            };
            طابق أدرج_في_الخريطة(&متغير (*السياق).فهرس_الدوال, مفتاح_سابق, الموضع_السابق) مع
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(خطأ); }
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
            };
        };
    };
}

عام عرف موضع_محلي_خفض(
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): اختياري طبيعي {
    // Local lookup borrows the canonical state; it never needs a flow snapshot.
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الحالة).المحليات[ف].الرمز, الرمز)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف تأكد_محليات_خفض_فريدة(الحالة: &متغير حالة_خفض_دالة): فراغ {
    إذا (!(*الحالة).المحليات_مشتركة) { أرجع; };
    ليكن العدد: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    (*الحالة).المحليات := قص_محليات_خفض(&(*الحالة).المحليات, العدد);
    (*الحالة).المحليات_مشتركة := خطأ;
}

// Replaces the locals with a private copy of their first العدد entries.
// Scope exits used to make the table unique (a full copy when shared) and then
// copy its prefix again; the prefix copy alone already yields a private table.
// A private table that already ends at العدد is kept as is.
عام عرف اقصر_محليات_حالة_خفض(الحالة: &متغير حالة_خفض_دالة, العدد: طبيعي): فراغ {
    إذا (!(*الحالة).المحليات_مشتركة && (الطول((*الحالة).المحليات) مثل طبيعي) <= العدد) { أرجع; };
    (*الحالة).المحليات := قص_محليات_خفض(&(*الحالة).المحليات, العدد);
    (*الحالة).المحليات_مشتركة := خطأ;
}

// Adds the local الرمز, bound with القيمة when it has one (a parameter, a
// pattern binding, a capture). It has no place yet: the caller gives it one
// (drops.sn, ثبّت_محلي_خفض), which also stores القيمة there.
عام عرف أضف_محلي_خفض(
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: اختياري معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(_) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.محلي_مكرر(الرمز));
    }
    | اختياري.لا_شيء -> {
    };
    تأكد_محليات_خفض_فريدة(الحالة);
    ليكن لا_مكان: اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    ليكن الربط: ربط_محلي_خفض = {
        الرمز: الرمز,
        النوع: النوع,
        المعلقة: القيمة,
        المكان: لا_مكان,
        مخزن: خطأ,
        مالك: خطأ
    };
    ألحق((*الحالة).المحليات, الربط);
    أرجع اختياري.لا_شيء();
}

// A read of the local الرمز: a load of its place. Whether the place holds a
// value there is not lowering's question: a read before any store loads a
// place that holds none, which the legality analysis rejects.
عام عرف خفض_قيمة_محلي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): نتيجة_خفض_تعبير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
    }
    | اختياري.موجود(الموضع) -> {
        ليكن المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
        طابق المحلي.المكان مع
        | اختياري.موجود(المكان) -> {
            أرجع قيمة_من_بناء_للخفض(
                أصدر_تحميل_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    (*الحالة).الدالة,
                    (*الحالة).الكتلة,
                    المكان,
                    المحلي.النوع
                ),
                المحلي.النوع
            );
        }
        | اختياري.لا_شيء -> {
            // Every local is given its place where it is bound.
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
        };
    };
}

عام عرف قص_محليات_خفض(
    المحليات: &متجه ربط_محلي_خفض,
    العدد: طبيعي
): متجه ربط_محلي_خفض {
    ليكن الناتج: متغير متجه ربط_محلي_خفض = [];
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (ف < (الطول(*المحليات) مثل طبيعي))) {
        ألحق(الناتج, (*المحليات)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_حالة_خفض(الحالة: &متغير حالة_خفض_دالة): حالة_خفض_دالة {
    // A branch snapshot owns an independent copy of the locals table (plain
    // bindings): it is mutated independently and dropped with the snapshot.
    ليكن المحليات_المشتركة: متجه ربط_محلي_خفض = انسخ_مملوكا_متجه_ربط_محلي_خفض(&(*الحالة).المحليات);
    ليكن النسخة: حالة_خفض_دالة = {
        الدالة: (*الحالة).الدالة,
        الكتلة: (*الحالة).الكتلة,
        نشطة: (*الحالة).نشطة,
        البناء: (*الحالة).البناء,
        المحليات: المحليات_المشتركة,
        له_هدف_خروج_حلقة: (*الحالة).له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: (*الحالة).هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: (*الحالة).له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: (*الحالة).هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: (*الحالة).عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: (*الحالة).إطار_الإسقاط,
        العروض: انسخ_عروض_خفض(&(*الحالة).العروض),
        يجد_العروض: (*الحالة).يجد_العروض,
        للتحليل: (*الحالة).للتحليل
    };
    أرجع النسخة;
}

// قيمة_من_بناء_للخفض for an integer operation of the source: its runtime
// check reports the place البداية (msir/runtime_checks.sn).
عام عرف قيمة_حساب_مفحوص_من_بناء_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    البداية: موضع,
    النتيجة: نتيجة_بناء_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        ليكن الموقع: موقع_فحص_تشغيل_مسير = {
            الدالة: الدالة, الكتلة: اختياري.لا_شيء(), القيمة: المعرف, الطول: المعرف,
            المصدر: البداية.المصدر, البايت: البداية.البايت
        };
        ألحق((*البرنامج).مواقع_فحوص_التشغيل, الموقع);
        ليكن القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف قيمة_من_بناء_للخفض(
    النتيجة: نتيجة_بناء_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        ليكن القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف اختم_بفرع_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الهدف: معرف_كتلة_مسير,
    الحجج: &متجه معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    ليكن حالة_القراءة: حالة_خفض_دالة = *الحالة;
    طابق اختم_بفرع_مسير(
        البرنامج, &حالة_القراءة.البناء,
        حالة_القراءة.الدالة,
        حالة_القراءة.الكتلة,
        الهدف,
        الحجج
    ) مع
    | نتيجة_بناء_منهي_مسير.مبني -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف أضف_كتلة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(الكتلة) -> {
        أرجع نتيجة.نجح(الكتلة);
    }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

// Sources of the uses the ownership legality analysis may report
// (msir/ssf/ownership_legality.sn; msir_model.sn, استخدام_مصدري_مسير): lowering
// records each one where it emits the instruction, and the analysis reads
// them before any pass changes a block.
عام عرف سجل_استخدام_مصدري_خفض(
    البرنامج: &متغير برنامج_مسير,
    الكتلة: معرف_كتلة_مسير,
    الموضع: طبيعي,
    الصنف: ط32,
    الرمز: اختياري معرف_رمز,
    الاسم: نطاق,
    التعبير: نطاق
): فراغ {
    ليكن الدالة: طبيعي = الكتلة.الدالة.القيمة مثل طبيعي;
    طالما ((الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي) <= الدالة) {
        ليكن فارغة: متجه استخدام_مصدري_مسير = [];
        ألحق((*البرنامج).مصادر_الاستخدامات, فارغة);
    }
    ليكن رقم_الرمز: متغير ط32 = 0xFFFFFFFF;
    طابق الرمز مع
    | اختياري.موجود(المعرف) -> { رقم_الرمز := المعرف.القيمة; }
    | اختياري.لا_شيء -> { };
    ليكن الاستخدام: استخدام_مصدري_مسير = {
        الكتلة: الكتلة.القيمة,
        الموضع: الموضع مثل ط32,
        الرمز: رقم_الرمز,
        الصنف: الصنف,
        الاسم: الاسم,
        التعبير: التعبير
    };
    ألحق((*البرنامج).مصادر_الاستخدامات[الدالة], الاستخدام);
}

// The last instruction emitted in the current block.
عام عرف سجل_آخر_استخدام_مصدري_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الصنف: ط32,
    الرمز: اختياري معرف_رمز,
    الاسم: نطاق,
    التعبير: نطاق
): فراغ {
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن الكتلة: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع; };
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع; };
    ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي;
    إذا (العدد == 0) { أرجع; };
    سجل_استخدام_مصدري_خفض(البرنامج, (*الحالة).الكتلة, العدد - 1, الصنف, الرمز, الاسم, التعبير);
}

// The give-up lowering just stated for a local, if it emitted one (an owner
// in code with drop elaboration): الاسم is where the value moves.
عام عرف سجل_تسليم_مصدري_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    الاسم: نطاق
): فراغ {
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن الكتلة: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع; };
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع; };
    ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي;
    إذا (العدد == 0) { أرجع; };
    طابق (*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[العدد - 1].العملية مع
    | عملية_مسير.ملكية_مكان(الملكية) -> {
        طابق الملكية.الحدث مع
        | حدث_ملكية_مسير.تسليم -> {
            سجل_استخدام_مصدري_خفض(
                البرنامج, (*الحالة).الكتلة, العدد - 1, صنف_استخدام_تسليم_مسير(),
                اختياري.موجود(الرمز), الاسم, الاسم
            );
        }
        | _ -> { };
    }
    | _ -> { };
}

// The store an assignment to the whole local الرمز just made, among the last
// instructions of the current block.
عام عرف سجل_إسناد_ثابت_مصدري_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    الاسم: نطاق,
    التعبير: نطاق
): فراغ {
    ليكن المكان: معرف_قيمة_مسير;
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(الموضع) -> {
        طابق (*الحالة).المحليات[الموضع].المكان مع
        | اختياري.موجود(القيمة) -> { المكان := القيمة; }
        | اختياري.لا_شيء -> { أرجع; };
    };
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن الكتلة: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع; };
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع; };
    ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي;
    ليكن الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < 8 && الخطوات < العدد) {
        ليكن الموضع: طبيعي = العدد - 1 - الخطوات;
        طابق (*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[الموضع].العملية مع
        | عملية_مسير.تخزين(التخزين) -> {
            إذا (التخزين.المكان.القيمة == المكان.القيمة) {
                سجل_استخدام_مصدري_خفض(
                    البرنامج, (*الحالة).الكتلة, الموضع, صنف_استخدام_إسناد_ثابت_مسير(),
                    اختياري.موجود(الرمز), الاسم, التعبير
                );
                أرجع;
            };
        }
        | _ -> { };
        الخطوات := الخطوات + 1;
    }
}

// The instruction of the current block that defines القيمة, among the last
// ones emitted (a read is lowered last); nothing when it is not there.
عام عرف سجل_استخدام_قيمة_مصدري_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: معرف_قيمة_مسير,
    الصنف: ط32,
    الرمز: اختياري معرف_رمز,
    الاسم: نطاق,
    التعبير: نطاق
): فراغ {
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن الكتلة: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    إذا (القيمة.الدالة.القيمة != (*الحالة).الدالة.القيمة) { أرجع; };
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع; };
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع; };
    ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي;
    ليكن الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < 8 && الخطوات < العدد) {
        ليكن الموضع: طبيعي = العدد - 1 - الخطوات;
        إذا ((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[الموضع].الناتج.القيمة == القيمة.القيمة) {
            سجل_استخدام_مصدري_خفض(البرنامج, (*الحالة).الكتلة, الموضع, الصنف, الرمز, الاسم, التعبير);
            أرجع;
        };
        الخطوات := الخطوات + 1;
    }
}

// The name a place expression is rooted at: through fields, elements,
// dereferences and borrows down to a name; none for any other root (a call,
// a literal).
عام عرف اسم_جذر_استخدام_للخفض(التعبير: &تعبير): اختياري اسم {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع اختياري.موجود(الاسم); }
    | تعبير.حقل(_, صندوق_الأصل, _) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الأصل)); }
    | تعبير.فهرس(_, صندوق_الأصل, _) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الأصل)); }
    | تعبير.فك_موضع(_, صندوق_الداخل) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الداخل)); }
    | تعبير.أحادي(_, عامل_أحادي.فك, صندوق_الداخل) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الداخل)); }
    | تعبير.أحادي(_, عامل_أحادي.عنوان, صندوق_الداخل) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الداخل)); }
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, صندوق_الداخل) -> { أرجع اسم_جذر_استخدام_للخفض(&(*صندوق_الداخل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Records the value an expression read from a place (a name, a member, an
// element, a dereference or a borrow of one) as a use of its root.
عام عرف سجل_قراءة_تعبير_مصدرية_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    القيمة: معرف_قيمة_مسير,
    روابط_الأسماء: &سياق_روابط_أسماء
): فراغ {
    طابق اسم_جذر_استخدام_للخفض(التعبير) مع
    | اختياري.موجود(الاسم) -> {
        سجل_استخدام_قيمة_مصدري_خفض(
            البرنامج, الحالة, القيمة, صنف_استخدام_قراءة_مسير(),
            رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق), الاسم.النطاق, نطاق_تعبير(التعبير)
        );
    }
    | اختياري.لا_شيء -> { };
}

// The source function of a lowered function (msir_model.sn,
// أصل_دالة_مصدرية_مسير).
عام عرف سجل_أصل_دالة_مصدرية_خفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الرمز: اختياري معرف_رمز,
    الأم: اختياري معرف_دالة_مسير
): فراغ {
    ليكن الموضع: طبيعي = الدالة.القيمة مثل طبيعي;
    طالما ((الطول((*البرنامج).دوال_المصدر) مثل طبيعي) <= الموضع) {
        ليكن بلا: أصل_دالة_مصدرية_مسير = { الرمز: 0xFFFFFFFF, الأم: 0xFFFFFFFF };
        ألحق((*البرنامج).دوال_المصدر, بلا);
    }
    طابق الرمز مع
    | اختياري.موجود(المعرف) -> { (*البرنامج).دوال_المصدر[الموضع].الرمز := المعرف.القيمة; }
    | اختياري.لا_شيء -> { };
    طابق الأم مع
    | اختياري.موجود(المعرف) -> { (*البرنامج).دوال_المصدر[الموضع].الأم := المعرف.القيمة; }
    | اختياري.لا_شيء -> { };
}
