استورد compiler.msir.lowering.model;
استورد std.collections.map;

// MSIR owns monomorphization: generic semantic templates remain Frontend facts,
// while only concrete function instances cross into target-neutral IR.
// Function-scoped semantic views are built once per lowering run. Concrete generic
// instances reuse these compact positions instead of rescanning whole unit fact tables.
عام نوع عرض_حقائق_دالة_خفض = {
    موضع_الوحدة: طبيعي,
    مواضع_حقائق_التعبيرات: متجه طبيعي,
    مواضع_الاستدعاءات: متجه طبيعي,
    مواضع_الإغلاقات: متجه طبيعي,
    مواضع_تحققات_الأنماط: متجه طبيعي,
    الرموز: متجه معرف_رمز
};

عام نوع فهرس_حقائق_دوال_خفض = {
    بالرمز: متجه اختياري عرض_حقائق_دالة_خفض
};


// Compact per-unit range ownership for generic top-level functions. Ranges are
// sorted by source byte start, so semantic fact construction is one pass over
// each unit instead of one complete fact-table scan per generic function.
نوع ربط_نطاق_دالة_خفض = {
    الرمز: معرف_رمز,
    النطاق: نطاق
};

نوع فهرس_نطاقات_دوال_وحدة_خفض = {
    الدوال: متجه ربط_نطاق_دالة_خفض
};

عرف أضف_نطاق_دالة_خفض_مرتبا(
    الدوال: &متغير متجه ربط_نطاق_دالة_خفض,
    الربط: ربط_نطاق_دالة_خفض
): فراغ {
    دع الموضع: متغير طبيعي = 0;
    طالما (
        الموضع < (الطول(*الدوال) مثل طبيعي)
        && (*الدوال)[الموضع].النطاق.البداية.البايت < الربط.النطاق.البداية.البايت
    ) {
        الموضع := الموضع + 1;
    }
    ألحق(*الدوال, الربط);
    دع ف: متغير طبيعي = الطول(*الدوال) مثل طبيعي;
    ف := ف - 1;
    طالما (ف > الموضع) {
        دع السابق: طبيعي = ف - 1;
        (*الدوال)[ف] := (*الدوال)[السابق];
        ف := السابق;
    }
    (*الدوال)[الموضع] := الربط;
}

عرف رمز_دالة_خفض_مالكة_لنطاق(
    الدوال: &متجه ربط_نطاق_دالة_خفض,
    النطاق: نطاق
): اختياري معرف_رمز {
    إذا ((الطول(*الدوال) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*الدوال) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا ((*الدوال)[الوسط].النطاق.البداية.البايت <= النطاق.البداية.البايت) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    إذا (البداية == 0) { أرجع اختياري.لا_شيء(); };
    دع موضع_المرشح: طبيعي = البداية - 1;
    دع المرشح: &ربط_نطاق_دالة_خفض = &(*الدوال)[موضع_المرشح];
    إذا (نطاق_داخل_نطاق(النطاق, (*المرشح).النطاق)) {
        أرجع اختياري.موجود((*المرشح).الرمز);
    };
    أرجع اختياري.لا_شيء();
}

عرف أضف_موضع_حقيقة_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختياري عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: طبيعي
): فراغ {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(*بالرمز) مثل طبيعي)) { أرجع; };
    // Take the slot, update the owned view, and store it back.
    دع الخانة: متغير اختياري عرض_حقائق_دالة_خفض = اختياري.لا_شيء();
    بدّل((*بالرمز)[الرمز.القيمة], الخانة);
    طابق الخانة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_حقائق_التعبيرات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختياري.موجود(المحدث);
    };
}

عرف أضف_موضع_استدعاء_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختياري عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: طبيعي
): فراغ {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(*بالرمز) مثل طبيعي)) { أرجع; };
    // Take the slot, update the owned view, and store it back.
    دع الخانة: متغير اختياري عرض_حقائق_دالة_خفض = اختياري.لا_شيء();
    بدّل((*بالرمز)[الرمز.القيمة], الخانة);
    طابق الخانة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_الاستدعاءات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختياري.موجود(المحدث);
    };
}

