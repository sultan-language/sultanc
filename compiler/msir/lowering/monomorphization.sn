    // Take the slot, update the owned view, and store it back.
    دع الخانة: متغير اختياري عرض_حقائق_دالة_خفض = اختياري.لا_شيء();
    بدّل((*بالرمز)[الرمز.القيمة], الخانة);
    طابق الخانة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_الإغلاقات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختياري.موجود(المحدث);
    };
}

عرف أضف_موضع_تحقق_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختياري عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: طبيعي
): فراغ {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول(*بالرمز) مثل طبيعي)) { أرجع; };
    // Take the slot, update the owned view, and store it back.
    دع الخانة: متغير اختياري عرض_حقائق_دالة_خفض = اختياري.لا_شيء();
    بدّل((*بالرمز)[الرمز.القيمة], الخانة);
    طابق الخانة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_تحققات_الأنماط, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختياري.موجود(المحدث);
    };
}

عرف أضف_رمز_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختياري عرض_حقائق_دالة_خفض,
    رمز_الدالة: معرف_رمز,
    الرمز: معرف_رمز
): فراغ {
    إذا ((رمز_الدالة.القيمة مثل طبيعي) >= (الطول(*بالرمز) مثل طبيعي)) { أرجع; };
    // Take the slot, update the owned view, and store it back.
    دع الخانة: متغير اختياري عرض_حقائق_دالة_خفض = اختياري.لا_شيء();
    بدّل((*بالرمز)[رمز_الدالة.القيمة], الخانة);
    طابق الخانة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        أضف_رمز_عرض_دالة_فريدا(&متغير المحدث.الرموز, الرمز);
        (*بالرمز)[رمز_الدالة.القيمة] := اختياري.موجود(المحدث);
    };
}

عرف هاش_مصدر_خفض(القيمة: &طبيعي): طبيعي { أرجع *القيمة; }
عرف مصدران_خفض_متساويان(أ: &طبيعي, ب: &طبيعي): منطقي { أرجع *أ == *ب; }

عرف نطاق_داخل_نطاق(الداخل: نطاق, الخارج: نطاق): منطقي {
    إذا (الداخل.البداية.المصدر != الخارج.البداية.المصدر) { أرجع خطأ; };
    إذا (الداخل.النهاية.المصدر != الخارج.النهاية.المصدر) { أرجع خطأ; };
    أرجع (الداخل.البداية.البايت >= الخارج.البداية.البايت)
        && (الداخل.النهاية.البايت <= الخارج.النهاية.البايت);
}


عرف أضف_رمز_عرض_دالة_فريدا(الرموز: &متغير متجه معرف_رمز, الرمز: معرف_رمز): فراغ {
    دع الموضع: متغير طبيعي = 0;
    طالما (
        الموضع < (الطول(*الرموز) مثل طبيعي)
        && (*الرموز)[الموضع].القيمة < الرمز.القيمة
    ) {
        الموضع := الموضع + 1;
    }
    إذا (
        الموضع < (الطول(*الرموز) مثل طبيعي)
        && معرفا_رمز_متساويان((*الرموز)[الموضع], الرمز)
    ) { أرجع; };
    ألحق(*الرموز, الرمز);
    دع ف: متغير طبيعي = الطول(*الرموز) مثل طبيعي;
    ف := ف - 1;
    طالما (ف > الموضع) {
        دع السابق: طبيعي = ف - 1;
        (*الرموز)[ف] := (*الرموز)[السابق];
        ف := السابق;
    }
    (*الرموز)[الموضع] := الرمز;
}

// Statements spliced into a function from text generated after the unit
// (the `؟` expansion, frontend/desugar/propagation.sn) lie outside the
// function's own span. Each such statement becomes one more owned range of
// the function, so the facts of a generic function's expansion stay with it.
عرف أضف_نطاقات_مولدة_كتلة_خفض(
    الكتلة: &كتلة_عبارات,
    الرمز: معرف_رمز,
    نطاق_الدالة: نطاق,
    الدوال: &متغير متجه ربط_نطاق_دالة_خفض
): فراغ {
    أضف_نطاقات_مولدة_عبارات_خفض(&(*الكتلة).العبارات, الرمز, نطاق_الدالة, الدوال);
}

عرف أضف_نطاقات_مولدة_عبارات_خفض(
    العبارات: &متجه صندوق عبارة,
    الرمز: معرف_رمز,
    نطاق_الدالة: نطاق,
    الدوال: &متغير متجه ربط_نطاق_دالة_خفض
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        دع مرجع_الصندوق: &صندوق عبارة = &(*العبارات)[ف];
        أضف_نطاقات_مولدة_عبارة_خفض(&(*(*مرجع_الصندوق)), الرمز, نطاق_الدالة, الدوال);
        ف := ف + 1;
    }
}

عرف أضف_نطاقات_مولدة_عبارة_خفض(
    العبارة: &عبارة,
    الرمز: معرف_رمز,
    نطاق_الدالة: نطاق,
    الدوال: &متغير متجه ربط_نطاق_دالة_خفض
): فراغ {
    دع نطاق_العبارة_الحالية: نطاق = نطاق_عبارة(العبارة);
    إذا (!نطاق_داخل_نطاق(نطاق_العبارة_الحالية, نطاق_الدالة)) {
        دع الربط: ربط_نطاق_دالة_خفض = { الرمز: الرمز, النطاق: نطاق_العبارة_الحالية };
        أضف_نطاق_دالة_خفض_مرتبا(الدوال, الربط);
        أرجع;
    };
    طابق *العبارة مع
    | عبارة.طالما(_, _, الجسم) -> { أضف_نطاقات_مولدة_كتلة_خفض(&الجسم, الرمز, نطاق_الدالة, الدوال); }
    | عبارة.لكل(_, البداية, _, _, الجسم) -> {
        أضف_نطاقات_مولدة_عبارات_خفض(&البداية, الرمز, نطاق_الدالة, الدوال);
        أضف_نطاقات_مولدة_كتلة_خفض(&الجسم, الرمز, نطاق_الدالة, الدوال);
    }
    | عبارة.إذا(_, _, الأول, الثاني) -> {
        أضف_نطاقات_مولدة_كتلة_خفض(&الأول, الرمز, نطاق_الدالة, الدوال);
        طابق الثاني مع
        | اختياري.موجود(الكتلة) -> { أضف_نطاقات_مولدة_كتلة_خفض(&الكتلة, الرمز, نطاق_الدالة, الدوال); }
        | اختياري.لا_شيء -> { };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            أضف_نطاقات_مولدة_كتلة_خفض(&الأذرع[ذ].الجسم, الرمز, نطاق_الدالة, الدوال);
            ذ := ذ + 1;
        }
    }
    | عبارة.غير_آمن(_, الجسم) -> { أضف_نطاقات_مولدة_كتلة_خفض(&الجسم, الرمز, نطاق_الدالة, الدوال); }
    | عبارة.وقت_الترجمة(_, الجسم) -> { أضف_نطاقات_مولدة_كتلة_خفض(&الجسم, الرمز, نطاق_الدالة, الدوال); }
    | عبارة.إسناد_وقت_الترجمة(_, _, الجسم, _) -> { أضف_نطاقات_مولدة_كتلة_خفض(&الجسم, الرمز, نطاق_الدالة, الدوال); }
    | _ -> { };
}

عام عرف ابن_فهرس_حقائق_دوال_خفض(
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة
): نتيجة فهرس_حقائق_دوال_خفض, خطأ_خفض_مسير {
    دع بالرمز: متغير متجه اختياري عرض_حقائق_دالة_خفض = [];
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*فهرس_التصريحات).بالرمز) مثل طبيعي)) {
        ألحق(بالرمز, اختياري.لا_شيء());
        ر := ر + 1;
    }

    دع نطاقات_الوحدات: متغير متجه فهرس_نطاقات_دوال_وحدة_خفض = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        دع فارغة: متجه ربط_نطاق_دالة_خفض = [];
        دع الفهرس: فهرس_نطاقات_دوال_وحدة_خفض = { الدوال: فارغة };
        ألحق(نطاقات_الوحدات, الفهرس);
        و := و + 1;
    }

    // First build the compact set of generic function owners. No semantic fact
    // table is scanned in this pass.
    ر := 0;
    طالما (ر < (الطول((*فهرس_التصريحات).بالرمز) مثل طبيعي)) {
        طابق (*فهرس_التصريحات).بالرمز[ر] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            إذا (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل طبيعي)
                && المقبض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل طبيعي)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل طبيعي)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                إذا (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        إذا (الطول(الدالة.معاملات_النوع) > 0) {
                            دع مواضع_الحقائق: متجه طبيعي = [];
                            دع مواضع_الاستدعاءات: متجه طبيعي = [];
                            دع مواضع_الإغلاقات: متجه طبيعي = [];
                            دع مواضع_التحققات: متجه طبيعي = [];
                            دع الرموز: متجه معرف_رمز = [];
                            دع العرض: عرض_حقائق_دالة_خفض = {
                                موضع_الوحدة: المقبض.موضع_الوحدة,
                                مواضع_حقائق_التعبيرات: مواضع_الحقائق,
                                مواضع_الاستدعاءات: مواضع_الاستدعاءات,
                                مواضع_الإغلاقات: مواضع_الإغلاقات,
                                مواضع_تحققات_الأنماط: مواضع_التحققات,
                                الرموز: الرموز
                            };
                            بالرمز[ر] := اختياري.موجود(العرض);
                            دع ربط_النطاق: ربط_نطاق_دالة_خفض = {
                                الرمز: معرف_رمز_من(ر),
                                النطاق: الدالة.النطاق
                            };
                            أضف_نطاق_دالة_خفض_مرتبا(
                                &متغير نطاقات_الوحدات[المقبض.موضع_الوحدة].الدوال,
                                ربط_النطاق
                            );
                            طابق الدالة.الجسم مع
                            | اختياري.موجود(الجسم) -> {
                                أضف_نطاقات_مولدة_كتلة_خفض(
                                    &الجسم, معرف_رمز_من(ر), الدالة.النطاق,
                                    &متغير نطاقات_الوحدات[المقبض.موضع_الوحدة].الدوال
                                );
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ر := ر + 1;
    }

    // SourceID -> unit position for units that actually contain generic
    // functions. This keeps the pattern-fact pass proportional to live owners.
    دع عدد_وحدات_عامة: متغير طبيعي = 0;
    و := 0;
    طالما (و < (الطول(نطاقات_الوحدات) مثل طبيعي)) {
        إذا ((الطول(نطاقات_الوحدات[و].الدوال) مثل طبيعي) > 0) {
            عدد_وحدات_عامة := عدد_وحدات_عامة + 1;
        };
        و := و + 1;
    }
    دع الوحدات_بالمصدر: متغير الخريطة<طبيعي, طبيعي> = أنشئ_الخريطة_بسعة(
        عدد_وحدات_عامة, هاش_مصدر_خفض, مصدران_خفض_متساويان
    );

    // Classify each unit-local semantic fact once. The binary owner lookup is
    // over only generic top-level functions in that unit; nested closure facts
    // remain attached to their enclosing generic function exactly as before.
    و := 0;
    طالما (و < (الطول(نطاقات_الوحدات) مثل طبيعي)) {
        دع نطاقات_الدوال: &متجه ربط_نطاق_دالة_خفض = &نطاقات_الوحدات[و].الدوال;
        إذا ((الطول(*نطاقات_الدوال) مثل طبيعي) > 0) {
            دع معرف_المصدر: طبيعي = (*الوحدات)[و].معرف_المصدر;
            دع موضع_الوحدة: طبيعي = و;
            طابق أدرج_في_الخريطة(&متغير الوحدات_بالمصدر, معرف_المصدر, موضع_الوحدة) مع
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
            }
            | نتيجة.نجح(السابق) -> {
                طابق السابق مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الموضع_السابق) -> {
                    // A repeated source identity must not replace the prior index.
                    طابق أدرج_في_الخريطة(
                        &متغير الوحدات_بالمصدر, معرف_المصدر, الموضع_السابق
                    ) مع
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة.خطأ(خطأ_خفض_مسير.فهرس_مصدر_مكرر());
                    }
                    | نتيجة.خطأ(_) -> {
                        أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
                    };
                };
            };

            دع سياق_التعبيرات: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*سياق_التعبيرات).الحقائق) مثل طبيعي)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الحقائق[ف].النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> { أضف_موضع_حقيقة_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل طبيعي)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الاستدعاءات[ف].النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> { أضف_موضع_استدعاء_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            ف := 0;
            طالما (ف < (الطول((*سياق_التعبيرات).الإغلاقات) مثل طبيعي)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الإغلاقات[ف].النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> { أضف_موضع_إغلاق_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }

            دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
            ف := 0;
            طالما (ف < (الطول((*روابط_الوحدة).الظهورات) مثل طبيعي)) {
                دع الظهور: &ظهور_اسم_محلول = &(*روابط_الوحدة).الظهورات[ف];
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*الظهور).النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> {
                    طابق (*الظهور).الرمز مع
                    | اختياري.موجود(الرمز) -> { أضف_رمز_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, الرمز); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
        };
        و := و + 1;
    }

    // Pattern validations are process-wide, so use the compact source->unit map
    // once and classify each validation into its owning generic function.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*تحققات_الأنماط) مثل طبيعي)) {
        طابق نطاق_نمط_عند(سجل_الأنماط, (*تحققات_الأنماط)[ف].التحقق.الجذر) مع
        | اختياري.موجود(النطاق) -> {
            دع معرف_المصدر: طبيعي = النطاق.البداية.المصدر;
            طابق ابحث_في_الخريطة(&الوحدات_بالمصدر, &معرف_المصدر) مع
            | اختياري.موجود(موضع_الوحدة) -> {
                دع نطاقات_الدوال: &متجه ربط_نطاق_دالة_خفض = &نطاقات_الوحدات[موضع_الوحدة].الدوال;
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, النطاق) مع
                | اختياري.موجود(رمز_الدالة) -> { أضف_موضع_تحقق_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    دع الناتج: فهرس_حقائق_دوال_خفض = { بالرمز: بالرمز };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف عرض_حقائق_دالة_خفض_عند(
    الفهرس: &فهرس_حقائق_دوال_خفض,
    الرمز: معرف_رمز
): اختياري عرض_حقائق_دالة_خفض {
    إذا ((الرمز.القيمة مثل طبيعي) >= (الطول((*الفهرس).بالرمز) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع مرجع_العرض: &اختياري عرض_حقائق_دالة_خفض = &(*الفهرس).بالرمز[الرمز.القيمة];
    طابق *مرجع_العرض مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العرض) -> {
        أرجع اختياري.موجود(انسخ_مملوكا_عرض_حقائق_دالة_خفض(&العرض));
    };
}

عام عرف استبدالات_نوع_ملموسة(
    الأنواع: &سجل_أنواع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): منطقي {
    دع القيم: متجه ربط_استبدال_نوع = *الاستبدالات;
    إذا (الطول(القيم) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        إذا (هل_نوع_يحوي_معامل_نوع(الأنواع, القيم[ف].الحجة)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_استبدالات_نوع(
    المصدر: &متجه ربط_استبدال_نوع
): متجه ربط_استبدال_نوع {
    أرجع انسخ_استبدالات_مثيل_دالة(المصدر);
}

عرف أضف_طلب_مثيل_فريدا(
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, طبيعي>,
    الطلب: طلب_مثيل_دالة_خفض
): نتيجة منطقي, خطأ_خفض_مسير {
    طابق ابحث_في_الخريطة(الفهرس, &الطلب) مع
    | اختياري.موجود(_) -> { أرجع نتيجة.نجح(خطأ); }
    | اختياري.لا_شيء -> { };

    دع الموضع: طبيعي = الطول(*الطلبات) مثل طبيعي;
    دع مفتاح_مخزن: طلب_مثيل_دالة_خفض = انسخ_طلب_مثيل_دالة_خفض(&الطلب);
    طابق أدرج_في_الخريطة(الفهرس, مفتاح_مخزن, الموضع) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
    }
    | نتيجة.نجح(السابق_المدرج) -> {
        طابق السابق_المدرج مع
        | اختياري.لا_شيء -> {
            ألحق(*الطلبات, الطلب);
            أرجع نتيجة.نجح(صواب);
        }
        | اختياري.موجود(الموضع_السابق) -> {
            // Restore the original index; no request is appended for a replacement.
            دع مفتاح_سابق: طلب_مثيل_دالة_خفض = انسخ_طلب_مثيل_دالة_خفض(&الطلب);
            طابق أدرج_في_الخريطة(الفهرس, مفتاح_سابق, الموضع_السابق) مع
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(خطأ); }
            | نتيجة.خطأ(_) -> {
                أرجع نتيجة.خطأ(خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل());
            };
        };
    };
}


عرف انسخ_طلب_مثيل_عند(
    الطلبات: &متجه طلب_مثيل_دالة_خفض,
    الموضع: طبيعي
): طلب_مثيل_دالة_خفض {
    دع الحالة: متجه طلب_مثيل_دالة_خفض = *الطلبات;
    دع الرمز: معرف_رمز = الحالة[الموضع].الرمز;
    دع الاستبدالات: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(&الحالة[الموضع].استبدالات_النوع);
    دع الناتج: طلب_مثيل_دالة_خفض = {
        الرمز: الرمز,
        استبدالات_النوع: الاستبدالات
    };
    أرجع الناتج;
}

عرف ركب_استبدالات_نوع(
    الأنواع: &متغير سجل_أنواع,
    الداخلية: &متجه ربط_استبدال_نوع,
    الخارجية: &متجه ربط_استبدال_نوع
): متجه ربط_استبدال_نوع {
    دع القيم: متجه ربط_استبدال_نوع = *الداخلية;
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع المعامل: معرف_رمز = القيم[ف].المعامل;
        دع الحجة_القديمة: معرف_نوع = القيم[ف].الحجة;
        دع الحجة: معرف_نوع = استبدل_نوعا(الأنواع, الحجة_القديمة, الخارجية);
        دع الربط: ربط_استبدال_نوع = {
            المعامل: المعامل,
            الحجة: الحجة
        };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_طلبات_من_استدعاءات(
    الأنواع: &سجل_أنواع,
    سياق_التعبيرات: &سياق_أنواع_تعبيرات,
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الأصول: &متغير متجه نطاق,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, طبيعي>
): نتيجة منطقي, خطأ_خفض_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل طبيعي)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*سياق_التعبيرات).الاستدعاءات[ف];
        طابق (*مرجع_الحقيقة).الرمز مع
        | اختياري.موجود(الرمز) -> {
            إذا (استبدالات_نوع_ملموسة(الأنواع, &(*مرجع_الحقيقة).استبدالات_النوع)) {
                دع الاستبدالات: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(&(*مرجع_الحقيقة).استبدالات_النوع);
                دع الطلب: طلب_مثيل_دالة_خفض = {
                    الرمز: الرمز,
                    استبدالات_النوع: الاستبدالات
                };
                طابق أضف_طلب_مثيل_فريدا(الطلبات, الفهرس, الطلب) مع
                | نتيجة.نجح(أضيف) -> {
                    إذا (أضيف) { ألحق(*الأصول, (*مرجع_الحقيقة).النطاق); };
                }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف أضف_طلبات_داخل_دالة(
    الأنواع: &متغير سجل_أنواع,
    سياق_التعبيرات: &سياق_أنواع_تعبيرات,
    مواضع_الاستدعاءات: &متجه طبيعي,
    استبدالات_الدالة: &متجه ربط_استبدال_نوع,
    الأصل: نطاق,
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الأصول: &متغير متجه نطاق,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, طبيعي>
): نتيجة منطقي, خطأ_خفض_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*مواضع_الاستدعاءات) مثل طبيعي)) {
        دع الموضع: طبيعي = (*مواضع_الاستدعاءات)[ف];
        إذا (الموضع < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل طبيعي)) {
            دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*سياق_التعبيرات).الاستدعاءات[الموضع];
            طابق (*مرجع_الحقيقة).الرمز مع
            | اختياري.موجود(الرمز) -> {
                إذا (الطول((*مرجع_الحقيقة).استبدالات_النوع) > 0) {
                    دع المركبة: متجه ربط_استبدال_نوع = ركب_استبدالات_نوع(
                        الأنواع, &(*مرجع_الحقيقة).استبدالات_النوع, استبدالات_الدالة
                    );
                    إذا (استبدالات_نوع_ملموسة(الأنواع, &المركبة)) {
                        دع الطلب: طلب_مثيل_دالة_خفض = {
                            الرمز: الرمز,
                            استبدالات_النوع: المركبة
                        };
                        طابق أضف_طلب_مثيل_فريدا(الطلبات, الفهرس, الطلب) مع
                        | نتيجة.نجح(أضيف) -> {
                            إذا (أضيف) { ألحق(*الأصول, الأصل); };
                        }
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
                    };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عام عرف ابن_طلبات_مثيلات_دوال(
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    فهرس_حقائق_الدوال: &فهرس_حقائق_دوال_خفض,
    // One entry per request: the concrete call that started its
    // instantiation chain (a request found inside another instance inherits
    // that instance's origin). Diagnostics only; not part of the request.
    الأصول: &متغير متجه نطاق
): نتيجة متجه طلب_مثيل_دالة_خفض, خطأ_خفض_مسير {
    دع الطلبات: متغير متجه طلب_مثيل_دالة_خفض = [];
    دع فهرس_الطلبات: متغير الخريطة<طلب_مثيل_دالة_خفض, طبيعي> = أنشئ_فهرس_مثيل_دالة_خفض();
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        طابق أضف_طلبات_من_استدعاءات(
            الأنواع, &(*أنواع_التعبيرات)[و], &متغير الطلبات, الأصول, &متغير فهرس_الطلبات
        ) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        و := و + 1;
    }

    // Calls inside a generic template may still carry outer type parameters.
    // Reuse the function-scoped call view for each concrete outer instance.
    دع مؤشر_الطلب: متغير طبيعي = 0;
    طالما (مؤشر_الطلب < (الطول(الطلبات) مثل طبيعي)) {
        دع نسخة_الطلب: طلب_مثيل_دالة_خفض = انسخ_طلب_مثيل_عند(&الطلبات, مؤشر_الطلب);
        دع رمز_الطلب: معرف_رمز = نسخة_الطلب.الرمز;
        دع استبدالات_الطلب: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(
            &نسخة_الطلب.استبدالات_النوع
        );
        طابق عرض_حقائق_دالة_خفض_عند(فهرس_حقائق_الدوال, رمز_الطلب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(العرض) -> {
            إذا (العرض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
                طابق أضف_طلبات_داخل_دالة(
                    الأنواع,
                    &(*أنواع_التعبيرات)[العرض.موضع_الوحدة],
                    &العرض.مواضع_الاستدعاءات,
                    &استبدالات_الطلب,
                    (*الأصول)[مؤشر_الطلب],
                    &متغير الطلبات,
                    الأصول,
                    &متغير فهرس_الطلبات
                ) مع
                | نتيجة.نجح(_) -> { }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
            };
        };
        مؤشر_الطلب := مؤشر_الطلب + 1;
    }
    أرجع نتيجة.نجح(الطلبات);
}



عام نوع استعمال_معتم_في_مثيل = {
    النطاق: نطاق,
    المعتم: معرف_نوع
};

// An instance with an opaque type argument is valid only while its body uses
// that type through pointers: any specialized expression or local whose Type
// holds an opaque type by value (a dereference, a reference for size_of or
// align_of, a construction, a copy, a vector or local that must be destroyed)
// needs a layout the type does not have. The first such use, at its span, or
// at the function's span for a local; nothing when no argument is opaque.
عام عرف أول_استعمال_معتم_في_مثيل(
    الأنواع: &سجل_أنواع,
    الاستبدالات: &متجه ربط_استبدال_نوع,
    أنواع_الرموز: &متجه ربط_نوع_رمز_خفض,
    أنواع_رموز_القالب: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    نطاق_الدالة: نطاق
): اختياري استعمال_معتم_في_مثيل {
    دع فيها_معتم: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاستبدالات) مثل طبيعي)) {
        إذا (يحوي_نوعا_معتما(الأنواع, (*الاستبدالات)[ف].الحجة)) { فيها_معتم := صواب; };
        ف := ف + 1;
    }
    إذا (!فيها_معتم) { أرجع اختياري.لا_شيء(); };
    ف := 0;
    طالما (ف < (الطول((*أنواع_التعبيرات).الحقائق) مثل طبيعي)) {
        دع الحقيقة: &حقيقة_تعبير_نوعية = &(*أنواع_التعبيرات).الحقائق[ف];
        طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, (*الحقيقة).النوع) مع
        | اختياري.موجود(الاستعمال) -> {
            دع الناتج: استعمال_معتم_في_مثيل = { النطاق: (*الحقيقة).النطاق, المعتم: الاستعمال.المعتم };
            أرجع اختياري.موجود(الناتج);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*أنواع_الرموز) مثل طبيعي)) {
        // A type parameter's own Symbol has the parameter as its Type: it is
        // the argument itself, not a value of it.
        دع معامل_نوع_نفسه: متغير منطقي = خطأ;
        طابق نوع_رمز_دلالي_عند(أنواع_رموز_القالب, (*أنواع_الرموز)[ف].الرمز) مع
        | اختياري.موجود(نوع_القالب) -> {
            طابق رمز_معامل_نوع_عند(الأنواع, نوع_القالب) مع
            | اختياري.موجود(رمز_المعامل) -> {
                معامل_نوع_نفسه := معرفا_رمز_متساويان(رمز_المعامل, (*أنواع_الرموز)[ف].الرمز);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (!معامل_نوع_نفسه) {
            طابق استعمال_معتم_ممنوع_في_نوع(الأنواع, (*أنواع_الرموز)[ف].النوع) مع
            | اختياري.موجود(الاستعمال) -> {
                دع الناتج: استعمال_معتم_في_مثيل = { النطاق: نطاق_الدالة, المعتم: الاستعمال.المعتم };
                أرجع اختياري.موجود(الناتج);
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف خصص_أنواع_رموز_دالة_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &سياق_أنواع_رموز,
    الرموز: &متجه معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه ربط_نوع_رمز_خفض {
    دع الناتج: متغير متجه ربط_نوع_رمز_خفض = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرموز) مثل طبيعي)) {
        دع الرمز: معرف_رمز = (*الرموز)[ف];
        طابق نوع_رمز_دلالي_عند(المصدر, الرمز) مع
        | اختياري.موجود(النوع) -> {
            دع المخصص: معرف_نوع = استبدل_نوعا(الأنواع, النوع, الاستبدالات);
            دع الربط: ربط_نوع_رمز_خفض = { الرمز: الرمز, النوع: المخصص };
            ألحق(الناتج, الربط);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}


عرف انسخ_نطاقات_خفض(المصدر: &متجه نطاق): متجه نطاق {
    دع القيم: متجه نطاق = *المصدر;
    دع الناتج: متغير متجه نطاق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        ألحق(الناتج, القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف خصص_حقائق_تعبيرات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه حقيقة_تعبير_نوعية,
    المواضع: &متجه طبيعي,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه حقيقة_تعبير_نوعية {
    دع الأصل: متجه حقيقة_تعبير_نوعية = *المصدر;
    دع الحقائق: متغير متجه حقيقة_تعبير_نوعية = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        دع موضع: طبيعي = (*المواضع)[ف];
        دع النطاق: نطاق = الأصل[موضع].النطاق;
        دع النوع: معرف_نوع = استبدل_نوعا(الأنواع, الأصل[موضع].النوع, الاستبدالات);
        دع نطاق_المنشئ: اختياري نطاق = الأصل[موضع].نطاق_المنشئ;
        دع المنشئ: اختياري هوية_منشئ_نوع = الأصل[موضع].المنشئ;
        دع الجديدة: حقيقة_تعبير_نوعية = {
            النطاق: النطاق,
            النوع: النوع,
            نطاق_المنشئ: نطاق_المنشئ,
            المنشئ: المنشئ
        };
        ألحق(الحقائق, الجديدة);
        ف := ف + 1;
    }
    أرجع الحقائق;
}

عرف خصص_حقائق_استدعاءات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه حقيقة_استدعاء_نوعية,
    المواضع: &متجه طبيعي,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه حقيقة_استدعاء_نوعية {
    دع الأصل: متجه حقيقة_استدعاء_نوعية = *المصدر;
    دع الاستدعاءات: متغير متجه حقيقة_استدعاء_نوعية = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المواضع) مثل طبيعي)) {
        دع موضع: طبيعي = (*المواضع)[ف];
        دع الجديدة_استبدالات: متجه ربط_استبدال_نوع = ركب_استبدالات_نوع(
            الأنواع, &الأصل[موضع].استبدالات_النوع, الاستبدالات
        );
        دع نطاقات_الحجج: متجه نطاق = انسخ_نطاقات_خفض(&الأصل[موضع].نطاقات_الحجج);
        دع نوع_المستدعى: معرف_نوع = استبدل_نوعا(
            الأنواع, الأصل[موضع].نوع_المستدعى, الاستبدالات
        );
        دع رمز_الاستدعاء: اختياري معرف_رمز = الأصل[موضع].الرمز;
        دع نطاق_الاستدعاء: نطاق = الأصل[موضع].النطاق;
        دع الجديدة: حقيقة_استدعاء_نوعية = {
            النطاق: نطاق_الاستدعاء,
            نوع_المستدعى: نوع_المستدعى,
            الرمز: رمز_الاستدعاء,
            نطاقات_الحجج: نطاقات_الحجج,
            استبدالات_النوع: الجديدة_استبدالات
        };
        ألحق(الاستدعاءات, الجديدة);
        ف := ف + 1;
    }
    أرجع الاستدعاءات;
}

عام عرف خصص_أنواع_تعبيرات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &سياق_أنواع_تعبيرات,
    العرض: &عرض_حقائق_دالة_خفض,
    الاستبدالات: &متجه ربط_استبدال_نوع
): سياق_أنواع_تعبيرات {
    دع الحقائق: متجه حقيقة_تعبير_نوعية = خصص_حقائق_تعبيرات_للمثيل(
        الأنواع, &(*المصدر).الحقائق, &(*العرض).مواضع_حقائق_التعبيرات, الاستبدالات
    );
    دع الاستدعاءات: متجه حقيقة_استدعاء_نوعية = خصص_حقائق_استدعاءات_للمثيل(
        الأنواع, &(*المصدر).الاستدعاءات, &(*العرض).مواضع_الاستدعاءات, الاستبدالات
    );
    دع الإغلاقات: متغير متجه حقيقة_إغلاق_نوعية = [];
    دع ه: متغير طبيعي = 0;
    طالما (ه < (الطول((*العرض).مواضع_الإغلاقات) مثل طبيعي)) {
        دع موضع_الإغلاق: طبيعي = (*العرض).مواضع_الإغلاقات[ه];
        دع مرجع_الإغلاق: &حقيقة_إغلاق_نوعية = &(*المصدر).الإغلاقات[موضع_الإغلاق];
        دع قيمة_الإغلاق: حقيقة_إغلاق_نوعية = *مرجع_الإغلاق;
        دع الالتقاطات: متغير متجه معرف_رمز = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(قيمة_الإغلاق.الالتقاطات) مثل طبيعي)) {
            ألحق(الالتقاطات, قيمة_الإغلاق.الالتقاطات[ح]); ح := ح + 1;
        }
        دع نسخة_الإغلاق: حقيقة_إغلاق_نوعية = { النطاق: قيمة_الإغلاق.النطاق, الالتقاطات: الالتقاطات };
        ألحق(الإغلاقات, نسخة_الإغلاق);
        ه := ه + 1;
    }
    أرجع سياق_أنواع_تعبيرات_من_حقائق(الحقائق, الاستدعاءات, الإغلاقات);
}

عرف انسخ_روابط_نمط_خفض(المصدر: &متجه ربط_نمط): متجه ربط_نمط {
    دع الأصل: متجه ربط_نمط = *المصدر;
    دع الناتج: متغير متجه ربط_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل) مثل طبيعي)) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف خصص_أنواع_عقد_نمط_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه نوع_عقدة_نمط,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه نوع_عقدة_نمط {
    دع الأصل: متجه نوع_عقدة_نمط = *المصدر;
    دع الناتج: متغير متجه نوع_عقدة_نمط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل) مثل طبيعي)) {
        دع النمط: معرف_نمط = الأصل[ف].النمط;
        دع النوع: معرف_نوع = استبدل_نوعا(الأنواع, الأصل[ف].النوع, الاستبدالات);
        دع المنشئ: اختياري هوية_منشئ_نوع = الأصل[ف].المنشئ;
        دع الجديدة: نوع_عقدة_نمط = {
            النمط: النمط,
            النوع: النوع,
            المنشئ: المنشئ
        };
        ألحق(الناتج, الجديدة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف خصص_تحققات_أنماط_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه ربط_تحقق_نمط_وحدة,
    العرض: &عرض_حقائق_دالة_خفض,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه ربط_تحقق_نمط_وحدة {
    دع الأصل: متجه ربط_تحقق_نمط_وحدة = *المصدر;
    دع الناتج: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*العرض).مواضع_تحققات_الأنماط) مثل طبيعي)) {
        دع موضع: طبيعي = (*العرض).مواضع_تحققات_الأنماط[ف];
        دع الروابط: متجه ربط_نمط = انسخ_روابط_نمط_خفض(&الأصل[موضع].التحقق.الروابط);
        دع أنواع_العقد: متجه نوع_عقدة_نمط = خصص_أنواع_عقد_نمط_للمثيل(
            الأنواع, &الأصل[موضع].التحقق.أنواع_العقد, الاستبدالات
        );
        دع التحقق: تحقق_نمط_نوعي = {
            الجذر: الأصل[موضع].التحقق.الجذر,
            الروابط: الروابط,
            أنواع_العقد: أنواع_العقد,
            غير_قابل_للدحض: الأصل[موضع].التحقق.غير_قابل_للدحض
        };
        دع الربط: ربط_تحقق_نمط_وحدة = { التحقق: التحقق };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_عرض_حقائق_دالة_خفض(القيمة: &عرض_حقائق_دالة_خفض): عرض_حقائق_دالة_خفض {
    دع الناتج: عرض_حقائق_دالة_خفض = {
        موضع_الوحدة: (*القيمة).موضع_الوحدة,
        مواضع_حقائق_التعبيرات: انسخ_مملوكا__متجه_طبيعي(&(*القيمة).مواضع_حقائق_التعبيرات),
        مواضع_الاستدعاءات: انسخ_مملوكا__متجه_طبيعي(&(*القيمة).مواضع_الاستدعاءات),
        مواضع_الإغلاقات: انسخ_مملوكا__متجه_طبيعي(&(*القيمة).مواضع_الإغلاقات),
        مواضع_تحققات_الأنماط: انسخ_مملوكا__متجه_طبيعي(&(*القيمة).مواضع_تحققات_الأنماط),
        الرموز: انسخ_مملوكا_متجه_معرف_رمز(&(*القيمة).الرموز)
    };
    أرجع الناتج;
}

عرف انسخ_مملوكا__متجه_طبيعي(القيمة: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
