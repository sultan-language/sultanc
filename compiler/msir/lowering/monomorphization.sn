استورد compiler.source.span;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.semantic_pipeline;
استورد compiler.frontend.types.expression_types;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.declaration_collection;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.pattern.type_validation;
استورد compiler.frontend.pattern.pattern_model;
استورد compiler.frontend.pattern.pattern_registry;
استورد compiler.msir.lowering.model;
استورد std.collections.map;

// MSIR owns monomorphization: generic semantic templates remain Frontend facts,
// while only concrete function instances cross into target-neutral IR.
// Function-scoped semantic views are built once per lowering run. Concrete generic
// instances reuse these compact positions instead of rescanning whole unit fact tables.
عام نوع عرض_حقائق_دالة_خفض = {
    موضع_الوحدة: غير_موقع,
    مواضع_حقائق_التعبيرات: متجه غير_موقع,
    مواضع_الاستدعاءات: متجه غير_موقع,
    مواضع_الإغلاقات: متجه غير_موقع,
    مواضع_تحققات_الأنماط: متجه غير_موقع,
    الرموز: متجه معرف_رمز
};

عام نوع فهرس_حقائق_دوال_خفض = {
    بالرمز: متجه اختيار عرض_حقائق_دالة_خفض
};


// Compact per-unit range ownership for generic top-level functions. Ranges are
// sorted by source byte start, so semantic fact construction is one pass over
// each unit instead of one complete fact-table scan per generic function.
نوع ربط_نطاق_دالة_خفض = {
    الرمز: معرف_رمز,
    النطاق: نطاق
};

نوع فهرس_نطاقات_دوال_وحدة_خفض = {
    الدوال: متجه ربط_نطاق_دالة_خفض
};

عرف أضف_نطاق_دالة_خفض_مرتبا(
    الدوال: &متغير متجه ربط_نطاق_دالة_خفض,
    الربط: ربط_نطاق_دالة_خفض
): فراغ {
    دع الموضع: متغير غير_موقع = 0;
    بينما (
        الموضع < (الطول(*الدوال) مثل غير_موقع)
        && (*الدوال)[الموضع].النطاق.البداية.البايت < الربط.النطاق.البداية.البايت
    ) {
        الموضع := الموضع + 1;
    }
    ألحق(*الدوال, الربط);
    دع ف: متغير غير_موقع = الطول(*الدوال) مثل غير_موقع;
    ف := ف - 1;
    بينما (ف > الموضع) {
        دع السابق: غير_موقع = ف - 1;
        (*الدوال)[ف] := (*الدوال)[السابق];
        ف := السابق;
    }
    (*الدوال)[الموضع] := الربط;
}

عرف رمز_دالة_خفض_مالكة_لنطاق(
    الدوال: &متجه ربط_نطاق_دالة_خفض,
    النطاق: نطاق
): اختيار معرف_رمز {
    لو ((الطول(*الدوال) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*الدوال) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        لو ((*الدوال)[الوسط].النطاق.البداية.البايت <= النطاق.البداية.البايت) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    لو (البداية == 0) { أرجع اختيار.لا_شيء(); };
    دع موضع_المرشح: غير_موقع = البداية - 1;
    دع المرشح: &ربط_نطاق_دالة_خفض = &(*الدوال)[موضع_المرشح];
    لو (نطاق_داخل_نطاق(النطاق, (*المرشح).النطاق)) {
        أرجع اختيار.بعض((*المرشح).الرمز);
    };
    أرجع اختيار.لا_شيء();
}

عرف أضف_موضع_حقيقة_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختيار عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: غير_موقع
): فراغ {
    لو (الرمز.القيمة >= (الطول(*بالرمز) مثل غير_موقع)) { أرجع; };
    طابق (*بالرمز)[الرمز.القيمة] مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_حقائق_التعبيرات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختيار.بعض(المحدث);
    };
}

عرف أضف_موضع_استدعاء_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختيار عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: غير_موقع
): فراغ {
    لو (الرمز.القيمة >= (الطول(*بالرمز) مثل غير_موقع)) { أرجع; };
    طابق (*بالرمز)[الرمز.القيمة] مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_الاستدعاءات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختيار.بعض(المحدث);
    };
}

عرف أضف_موضع_إغلاق_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختيار عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: غير_موقع
): فراغ {
    لو (الرمز.القيمة >= (الطول(*بالرمز) مثل غير_موقع)) { أرجع; };
    طابق (*بالرمز)[الرمز.القيمة] مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_الإغلاقات, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختيار.بعض(المحدث);
    };
}

عرف أضف_موضع_تحقق_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختيار عرض_حقائق_دالة_خفض,
    الرمز: معرف_رمز,
    الموضع: غير_موقع
): فراغ {
    لو (الرمز.القيمة >= (الطول(*بالرمز) مثل غير_موقع)) { أرجع; };
    طابق (*بالرمز)[الرمز.القيمة] مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        ألحق(المحدث.مواضع_تحققات_الأنماط, الموضع);
        (*بالرمز)[الرمز.القيمة] := اختيار.بعض(المحدث);
    };
}

عرف أضف_رمز_إلى_عرض_خفض(
    بالرمز: &متغير متجه اختيار عرض_حقائق_دالة_خفض,
    رمز_الدالة: معرف_رمز,
    الرمز: معرف_رمز
): فراغ {
    لو (رمز_الدالة.القيمة >= (الطول(*بالرمز) مثل غير_موقع)) { أرجع; };
    طابق (*بالرمز)[رمز_الدالة.القيمة] مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(العرض) -> {
        دع المحدث: متغير عرض_حقائق_دالة_خفض = العرض;
        أضف_رمز_عرض_دالة_فريدا(&متغير المحدث.الرموز, الرمز);
        (*بالرمز)[رمز_الدالة.القيمة] := اختيار.بعض(المحدث);
    };
}

عرف هاش_مصدر_خفض(القيمة: &غير_موقع): غير_موقع { أرجع *القيمة; }
عرف مصدران_خفض_متساويان(أ: &غير_موقع, ب: &غير_موقع): منطقي { أرجع *أ == *ب; }

عرف نطاق_داخل_نطاق(الداخل: نطاق, الخارج: نطاق): منطقي {
    لو (الداخل.البداية.المصدر != الخارج.البداية.المصدر) { أرجع خطأ; };
    لو (الداخل.النهاية.المصدر != الخارج.النهاية.المصدر) { أرجع خطأ; };
    أرجع (الداخل.البداية.البايت >= الخارج.البداية.البايت)
        && (الداخل.النهاية.البايت <= الخارج.النهاية.البايت);
}


عرف أضف_رمز_عرض_دالة_فريدا(الرموز: &متغير متجه معرف_رمز, الرمز: معرف_رمز): فراغ {
    دع الموضع: متغير غير_موقع = 0;
    بينما (
        الموضع < (الطول(*الرموز) مثل غير_موقع)
        && (*الرموز)[الموضع].القيمة < الرمز.القيمة
    ) {
        الموضع := الموضع + 1;
    }
    لو (
        الموضع < (الطول(*الرموز) مثل غير_موقع)
        && معرفا_رمز_متساويان((*الرموز)[الموضع], الرمز)
    ) { أرجع; };
    ألحق(*الرموز, الرمز);
    دع ف: متغير غير_موقع = الطول(*الرموز) مثل غير_موقع;
    ف := ف - 1;
    بينما (ف > الموضع) {
        دع السابق: غير_موقع = ف - 1;
        (*الرموز)[ف] := (*الرموز)[السابق];
        ف := السابق;
    }
    (*الرموز)[الموضع] := الرمز;
}

عام عرف ابن_فهرس_حقائق_دوال_خفض(
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة
): فهرس_حقائق_دوال_خفض {
    دع بالرمز: متغير متجه اختيار عرض_حقائق_دالة_خفض = [];
    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول((*فهرس_التصريحات).بالرمز) مثل غير_موقع)) {
        ألحق(بالرمز, اختيار.لا_شيء());
        ر := ر + 1;
    }

    دع نطاقات_الوحدات: متغير متجه فهرس_نطاقات_دوال_وحدة_خفض = [];
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(*الوحدات) مثل غير_موقع)) {
        دع فارغة: متجه ربط_نطاق_دالة_خفض = [];
        دع الفهرس: فهرس_نطاقات_دوال_وحدة_خفض = { الدوال: فارغة };
        ألحق(نطاقات_الوحدات, الفهرس);
        و := و + 1;
    }

    // First build the compact set of generic function owners. No semantic fact
    // table is scanned in this pass.
    ر := 0;
    بينما (ر < (الطول((*فهرس_التصريحات).بالرمز) مثل غير_موقع)) {
        طابق (*فهرس_التصريحات).بالرمز[ر] مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المقبض) -> {
            لو (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل غير_موقع)
                && المقبض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل غير_موقع)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل غير_موقع)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                لو (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        لو (الطول(الدالة.معاملات_النوع) > 0) {
                            دع مواضع_الحقائق: متجه غير_موقع = [];
                            دع مواضع_الاستدعاءات: متجه غير_موقع = [];
                            دع مواضع_الإغلاقات: متجه غير_موقع = [];
                            دع مواضع_التحققات: متجه غير_موقع = [];
                            دع الرموز: متجه معرف_رمز = [];
                            دع العرض: عرض_حقائق_دالة_خفض = {
                                موضع_الوحدة: المقبض.موضع_الوحدة,
                                مواضع_حقائق_التعبيرات: مواضع_الحقائق,
                                مواضع_الاستدعاءات: مواضع_الاستدعاءات,
                                مواضع_الإغلاقات: مواضع_الإغلاقات,
                                مواضع_تحققات_الأنماط: مواضع_التحققات,
                                الرموز: الرموز
                            };
                            بالرمز[ر] := اختيار.بعض(العرض);
                            دع ربط_النطاق: ربط_نطاق_دالة_خفض = {
                                الرمز: معرف_رمز_من(ر),
                                النطاق: الدالة.النطاق
                            };
                            أضف_نطاق_دالة_خفض_مرتبا(
                                &متغير نطاقات_الوحدات[المقبض.موضع_الوحدة].الدوال,
                                ربط_النطاق
                            );
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ر := ر + 1;
    }

    // SourceID -> unit position for units that actually contain generic
    // functions. This keeps the pattern-fact pass proportional to live owners.
    دع عدد_وحدات_عامة: متغير غير_موقع = 0;
    و := 0;
    بينما (و < (الطول(نطاقات_الوحدات) مثل غير_موقع)) {
        لو ((الطول(نطاقات_الوحدات[و].الدوال) مثل غير_موقع) > 0) {
            عدد_وحدات_عامة := عدد_وحدات_عامة + 1;
        };
        و := و + 1;
    }
    دع الوحدات_بالمصدر: متغير الخريطة<غير_موقع, غير_موقع> = أنشئ_الخريطة_بسعة(
        عدد_وحدات_عامة, هاش_مصدر_خفض, مصدران_خفض_متساويان
    );

    // Classify each unit-local semantic fact once. The binary owner lookup is
    // over only generic top-level functions in that unit; nested closure facts
    // remain attached to their enclosing generic function exactly as before.
    و := 0;
    بينما (و < (الطول(نطاقات_الوحدات) مثل غير_موقع)) {
        دع نطاقات_الدوال: &متجه ربط_نطاق_دالة_خفض = &نطاقات_الوحدات[و].الدوال;
        لو ((الطول(*نطاقات_الدوال) مثل غير_موقع) > 0) {
            دع معرف_المصدر: غير_موقع = (*الوحدات)[و].معرف_المصدر;
            دع موضع_الوحدة: غير_موقع = و;
            طابق أدرج_في_الخريطة(&متغير الوحدات_بالمصدر, معرف_المصدر, موضع_الوحدة) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(_) -> { };

            دع سياق_التعبيرات: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول((*سياق_التعبيرات).الحقائق) مثل غير_موقع)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الحقائق[ف].النطاق) مع
                | اختيار.بعض(رمز_الدالة) -> { أضف_موضع_حقيقة_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
            ف := 0;
            بينما (ف < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل غير_موقع)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الاستدعاءات[ف].النطاق) مع
                | اختيار.بعض(رمز_الدالة) -> { أضف_موضع_استدعاء_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
            ف := 0;
            بينما (ف < (الطول((*سياق_التعبيرات).الإغلاقات) مثل غير_موقع)) {
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*سياق_التعبيرات).الإغلاقات[ف].النطاق) مع
                | اختيار.بعض(رمز_الدالة) -> { أضف_موضع_إغلاق_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }

            دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
            ف := 0;
            بينما (ف < (الطول((*روابط_الوحدة).الظهورات) مثل غير_موقع)) {
                دع الظهور: &ظهور_اسم_محلول = &(*روابط_الوحدة).الظهورات[ف];
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, (*الظهور).النطاق) مع
                | اختيار.بعض(رمز_الدالة) -> {
                    طابق (*الظهور).الرمز مع
                    | اختيار.بعض(الرمز) -> { أضف_رمز_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, الرمز); }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 1;
            }
        };
        و := و + 1;
    }

    // Pattern validations are process-wide, so use the compact source->unit map
    // once and classify each validation into its owning generic function.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*تحققات_الأنماط) مثل غير_موقع)) {
        طابق نطاق_نمط_عند(سجل_الأنماط, (*تحققات_الأنماط)[ف].التحقق.الجذر) مع
        | اختيار.بعض(النطاق) -> {
            دع معرف_المصدر: غير_موقع = النطاق.البداية.المصدر;
            طابق ابحث_في_الخريطة(&الوحدات_بالمصدر, &معرف_المصدر) مع
            | اختيار.بعض(موضع_الوحدة) -> {
                دع نطاقات_الدوال: &متجه ربط_نطاق_دالة_خفض = &نطاقات_الوحدات[موضع_الوحدة].الدوال;
                طابق رمز_دالة_خفض_مالكة_لنطاق(نطاقات_الدوال, النطاق) مع
                | اختيار.بعض(رمز_الدالة) -> { أضف_موضع_تحقق_إلى_عرض_خفض(&متغير بالرمز, رمز_الدالة, ف); }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }

    دع الناتج: فهرس_حقائق_دوال_خفض = { بالرمز: بالرمز };
    أرجع الناتج;
}

عام عرف عرض_حقائق_دالة_خفض_عند(
    الفهرس: &فهرس_حقائق_دوال_خفض,
    الرمز: معرف_رمز
): اختيار عرض_حقائق_دالة_خفض {
    لو (الرمز.القيمة >= (الطول((*الفهرس).بالرمز) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع مرجع_العرض: &اختيار عرض_حقائق_دالة_خفض = &(*الفهرس).بالرمز[الرمز.القيمة];
    طابق *مرجع_العرض مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(العرض) -> {
        أرجع اختيار.بعض(العرض);
    };
}

عام عرف استبدالات_نوع_ملموسة(
    الأنواع: &سجل_أنواع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): منطقي {
    دع القيم: متجه ربط_استبدال_نوع = *الاستبدالات;
    لو (الطول(القيم) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (هل_نوع_يحوي_معامل_نوع(الأنواع, القيم[ف].الحجة)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_استبدالات_نوع(
    المصدر: &متجه ربط_استبدال_نوع
): متجه ربط_استبدال_نوع {
    أرجع انسخ_استبدالات_مثيل_دالة(المصدر);
}

عرف أضف_طلب_مثيل_فريدا(
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, غير_موقع>,
    الطلب: طلب_مثيل_دالة_خفض
): منطقي {
    طابق ابحث_في_الخريطة(الفهرس, &الطلب) مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };

    دع الموضع: غير_موقع = الطول(*الطلبات) مثل غير_موقع;
    دع مفتاح_مخزن: طلب_مثيل_دالة_خفض = انسخ_طلب_مثيل_دالة_خفض(&الطلب);
    طابق أدرج_في_الخريطة(الفهرس, مفتاح_مخزن, الموضع) مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };
    ألحق((*الطلبات), الطلب);
    أرجع صواب;
}


عرف انسخ_طلب_مثيل_عند(
    الطلبات: &متجه طلب_مثيل_دالة_خفض,
    الموضع: غير_موقع
): طلب_مثيل_دالة_خفض {
    دع الحالة: متجه طلب_مثيل_دالة_خفض = *الطلبات;
    دع الرمز: معرف_رمز = الحالة[الموضع].الرمز;
    دع الاستبدالات: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(&الحالة[الموضع].استبدالات_النوع);
    دع الناتج: طلب_مثيل_دالة_خفض = {
        الرمز: الرمز,
        استبدالات_النوع: الاستبدالات
    };
    أرجع الناتج;
}

عرف ركب_استبدالات_نوع(
    الأنواع: &متغير سجل_أنواع,
    الداخلية: &متجه ربط_استبدال_نوع,
    الخارجية: &متجه ربط_استبدال_نوع
): متجه ربط_استبدال_نوع {
    دع القيم: متجه ربط_استبدال_نوع = *الداخلية;
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع المعامل: معرف_رمز = القيم[ف].المعامل;
        دع الحجة_القديمة: معرف_نوع = القيم[ف].الحجة;
        دع الحجة: معرف_نوع = استبدل_نوعا(الأنواع, الحجة_القديمة, الخارجية);
        دع الربط: ربط_استبدال_نوع = {
            المعامل: المعامل,
            الحجة: الحجة
        };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أضف_طلبات_من_استدعاءات(
    الأنواع: &سجل_أنواع,
    سياق_التعبيرات: &سياق_أنواع_تعبيرات,
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, غير_موقع>
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل غير_موقع)) {
        دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*سياق_التعبيرات).الاستدعاءات[ف];
        طابق (*مرجع_الحقيقة).الرمز مع
        | اختيار.بعض(الرمز) -> {
            لو (استبدالات_نوع_ملموسة(الأنواع, &(*مرجع_الحقيقة).استبدالات_النوع)) {
                دع الاستبدالات: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(&(*مرجع_الحقيقة).استبدالات_النوع);
                دع الطلب: طلب_مثيل_دالة_خفض = {
                    الرمز: الرمز,
                    استبدالات_النوع: الاستبدالات
                };
                أضف_طلب_مثيل_فريدا(الطلبات, الفهرس, الطلب);
            };
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
}

عرف أضف_طلبات_داخل_دالة(
    الأنواع: &متغير سجل_أنواع,
    سياق_التعبيرات: &سياق_أنواع_تعبيرات,
    مواضع_الاستدعاءات: &متجه غير_موقع,
    استبدالات_الدالة: &متجه ربط_استبدال_نوع,
    الطلبات: &متغير متجه طلب_مثيل_دالة_خفض,
    الفهرس: &متغير الخريطة<طلب_مثيل_دالة_خفض, غير_موقع>
): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*مواضع_الاستدعاءات) مثل غير_موقع)) {
        دع الموضع: غير_موقع = (*مواضع_الاستدعاءات)[ف];
        لو (الموضع < (الطول((*سياق_التعبيرات).الاستدعاءات) مثل غير_موقع)) {
            دع مرجع_الحقيقة: &حقيقة_استدعاء_نوعية = &(*سياق_التعبيرات).الاستدعاءات[الموضع];
            طابق (*مرجع_الحقيقة).الرمز مع
            | اختيار.بعض(الرمز) -> {
                لو (الطول((*مرجع_الحقيقة).استبدالات_النوع) > 0) {
                    دع المركبة: متجه ربط_استبدال_نوع = ركب_استبدالات_نوع(
                        الأنواع, &(*مرجع_الحقيقة).استبدالات_النوع, استبدالات_الدالة
                    );
                    لو (استبدالات_نوع_ملموسة(الأنواع, &المركبة)) {
                        دع الطلب: طلب_مثيل_دالة_خفض = {
                            الرمز: الرمز,
                            استبدالات_النوع: المركبة
                        };
                        أضف_طلب_مثيل_فريدا(الطلبات, الفهرس, الطلب);
                    };
                };
            }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
}

عام عرف ابن_طلبات_مثيلات_دوال(
    الأنواع: &متغير سجل_أنواع,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    فهرس_حقائق_الدوال: &فهرس_حقائق_دوال_خفض
): متجه طلب_مثيل_دالة_خفض {
    دع الطلبات: متغير متجه طلب_مثيل_دالة_خفض = [];
    دع فهرس_الطلبات: متغير الخريطة<طلب_مثيل_دالة_خفض, غير_موقع> = أنشئ_فهرس_مثيل_دالة_خفض();
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(*أنواع_التعبيرات) مثل غير_موقع)) {
        أضف_طلبات_من_استدعاءات(
            الأنواع, &(*أنواع_التعبيرات)[و], &متغير الطلبات, &متغير فهرس_الطلبات
        );
        و := و + 1;
    }

    // Calls inside a generic template may still carry outer type parameters.
    // Reuse the function-scoped call view for each concrete outer instance.
    دع مؤشر_الطلب: متغير غير_موقع = 0;
    بينما (مؤشر_الطلب < (الطول(الطلبات) مثل غير_موقع)) {
        دع نسخة_الطلب: طلب_مثيل_دالة_خفض = انسخ_طلب_مثيل_عند(&الطلبات, مؤشر_الطلب);
        دع رمز_الطلب: معرف_رمز = نسخة_الطلب.الرمز;
        دع استبدالات_الطلب: متجه ربط_استبدال_نوع = انسخ_استبدالات_نوع(
            &نسخة_الطلب.استبدالات_النوع
        );
        طابق عرض_حقائق_دالة_خفض_عند(فهرس_حقائق_الدوال, رمز_الطلب) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(العرض) -> {
            لو (العرض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل غير_موقع)) {
                أضف_طلبات_داخل_دالة(
                    الأنواع,
                    &(*أنواع_التعبيرات)[العرض.موضع_الوحدة],
                    &العرض.مواضع_الاستدعاءات,
                    &استبدالات_الطلب,
                    &متغير الطلبات,
                    &متغير فهرس_الطلبات
                );
            };
        };
        مؤشر_الطلب := مؤشر_الطلب + 1;
    }
    أرجع الطلبات;
}



عام عرف خصص_أنواع_رموز_دالة_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &سياق_أنواع_رموز,
    الرموز: &متجه معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه ربط_نوع_رمز_خفض {
    دع الناتج: متغير متجه ربط_نوع_رمز_خفض = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: معرف_رمز = (*الرموز)[ف];
        طابق نوع_رمز_دلالي_عند(المصدر, الرمز) مع
        | اختيار.بعض(النوع) -> {
            دع المخصص: معرف_نوع = استبدل_نوعا(الأنواع, النوع, الاستبدالات);
            دع الربط: ربط_نوع_رمز_خفض = { الرمز: الرمز, النوع: المخصص };
            ألحق(الناتج, الربط);
        }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}


عرف انسخ_نطاقات_خفض(المصدر: &متجه نطاق): متجه نطاق {
    دع القيم: متجه نطاق = *المصدر;
    دع الناتج: متغير متجه نطاق = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        ألحق(الناتج, القيم[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف خصص_حقائق_تعبيرات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه حقيقة_تعبير_نوعية,
    المواضع: &متجه غير_موقع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه حقيقة_تعبير_نوعية {
    دع الأصل: متجه حقيقة_تعبير_نوعية = *المصدر;
    دع الحقائق: متغير متجه حقيقة_تعبير_نوعية = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المواضع) مثل غير_موقع)) {
        دع موضع: غير_موقع = (*المواضع)[ف];
        دع النطاق: نطاق = الأصل[موضع].النطاق;
        دع النوع: معرف_نوع = استبدل_نوعا(الأنواع, الأصل[موضع].النوع, الاستبدالات);
        دع نطاق_المنشئ: اختيار نطاق = الأصل[موضع].نطاق_المنشئ;
        دع المنشئ: اختيار هوية_منشئ_نوع = الأصل[موضع].المنشئ;
        دع الجديدة: حقيقة_تعبير_نوعية = {
            النطاق: النطاق,
            النوع: النوع,
            نطاق_المنشئ: نطاق_المنشئ,
            المنشئ: المنشئ
        };
        ألحق(الحقائق, الجديدة);
        ف := ف + 1;
    }
    أرجع الحقائق;
}

عرف خصص_حقائق_استدعاءات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه حقيقة_استدعاء_نوعية,
    المواضع: &متجه غير_موقع,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه حقيقة_استدعاء_نوعية {
    دع الأصل: متجه حقيقة_استدعاء_نوعية = *المصدر;
    دع الاستدعاءات: متغير متجه حقيقة_استدعاء_نوعية = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المواضع) مثل غير_موقع)) {
        دع موضع: غير_موقع = (*المواضع)[ف];
        دع الجديدة_استبدالات: متجه ربط_استبدال_نوع = ركب_استبدالات_نوع(
            الأنواع, &الأصل[موضع].استبدالات_النوع, الاستبدالات
        );
        دع نطاقات_الحجج: متجه نطاق = انسخ_نطاقات_خفض(&الأصل[موضع].نطاقات_الحجج);
        دع نوع_المستدعى: معرف_نوع = استبدل_نوعا(
            الأنواع, الأصل[موضع].نوع_المستدعى, الاستبدالات
        );
        دع رمز_الاستدعاء: اختيار معرف_رمز = الأصل[موضع].الرمز;
        دع نطاق_الاستدعاء: نطاق = الأصل[موضع].النطاق;
        دع الجديدة: حقيقة_استدعاء_نوعية = {
            النطاق: نطاق_الاستدعاء,
            نوع_المستدعى: نوع_المستدعى,
            الرمز: رمز_الاستدعاء,
            نطاقات_الحجج: نطاقات_الحجج,
            استبدالات_النوع: الجديدة_استبدالات
        };
        ألحق(الاستدعاءات, الجديدة);
        ف := ف + 1;
    }
    أرجع الاستدعاءات;
}

عام عرف خصص_أنواع_تعبيرات_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &سياق_أنواع_تعبيرات,
    العرض: &عرض_حقائق_دالة_خفض,
    الاستبدالات: &متجه ربط_استبدال_نوع
): سياق_أنواع_تعبيرات {
    دع الحقائق: متجه حقيقة_تعبير_نوعية = خصص_حقائق_تعبيرات_للمثيل(
        الأنواع, &(*المصدر).الحقائق, &(*العرض).مواضع_حقائق_التعبيرات, الاستبدالات
    );
    دع الاستدعاءات: متجه حقيقة_استدعاء_نوعية = خصص_حقائق_استدعاءات_للمثيل(
        الأنواع, &(*المصدر).الاستدعاءات, &(*العرض).مواضع_الاستدعاءات, الاستبدالات
    );
    دع الإغلاقات: متغير متجه حقيقة_إغلاق_نوعية = [];
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول((*العرض).مواضع_الإغلاقات) مثل غير_موقع)) {
        دع موضع_الإغلاق: غير_موقع = (*العرض).مواضع_الإغلاقات[ه];
        دع مرجع_الإغلاق: &حقيقة_إغلاق_نوعية = &(*المصدر).الإغلاقات[موضع_الإغلاق];
        دع قيمة_الإغلاق: حقيقة_إغلاق_نوعية = *مرجع_الإغلاق;
        دع الالتقاطات: متغير متجه معرف_رمز = [];
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(قيمة_الإغلاق.الالتقاطات) مثل غير_موقع)) {
            ألحق(الالتقاطات, قيمة_الإغلاق.الالتقاطات[ح]); ح := ح + 1;
        }
        دع نسخة_الإغلاق: حقيقة_إغلاق_نوعية = { النطاق: قيمة_الإغلاق.النطاق, الالتقاطات: الالتقاطات };
        ألحق(الإغلاقات, نسخة_الإغلاق);
        ه := ه + 1;
    }
    أرجع سياق_أنواع_تعبيرات_من_حقائق(الحقائق, الاستدعاءات, الإغلاقات);
}

عرف انسخ_روابط_نمط_خفض(المصدر: &متجه ربط_نمط): متجه ربط_نمط {
    دع الأصل: متجه ربط_نمط = *المصدر;
    دع الناتج: متغير متجه ربط_نمط = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل) مثل غير_موقع)) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف خصص_أنواع_عقد_نمط_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه نوع_عقدة_نمط,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه نوع_عقدة_نمط {
    دع الأصل: متجه نوع_عقدة_نمط = *المصدر;
    دع الناتج: متغير متجه نوع_عقدة_نمط = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأصل) مثل غير_موقع)) {
        دع النمط: معرف_نمط = الأصل[ف].النمط;
        دع النوع: معرف_نوع = استبدل_نوعا(الأنواع, الأصل[ف].النوع, الاستبدالات);
        دع المنشئ: اختيار هوية_منشئ_نوع = الأصل[ف].المنشئ;
        دع الجديدة: نوع_عقدة_نمط = {
            النمط: النمط,
            النوع: النوع,
            المنشئ: المنشئ
        };
        ألحق(الناتج, الجديدة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف خصص_تحققات_أنماط_للمثيل(
    الأنواع: &متغير سجل_أنواع,
    المصدر: &متجه ربط_تحقق_نمط_وحدة,
    العرض: &عرض_حقائق_دالة_خفض,
    الاستبدالات: &متجه ربط_استبدال_نوع
): متجه ربط_تحقق_نمط_وحدة {
    دع الأصل: متجه ربط_تحقق_نمط_وحدة = *المصدر;
    دع الناتج: متغير متجه ربط_تحقق_نمط_وحدة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*العرض).مواضع_تحققات_الأنماط) مثل غير_موقع)) {
        دع موضع: غير_موقع = (*العرض).مواضع_تحققات_الأنماط[ف];
        دع الروابط: متجه ربط_نمط = انسخ_روابط_نمط_خفض(&الأصل[موضع].التحقق.الروابط);
        دع أنواع_العقد: متجه نوع_عقدة_نمط = خصص_أنواع_عقد_نمط_للمثيل(
            الأنواع, &الأصل[موضع].التحقق.أنواع_العقد, الاستبدالات
        );
        دع التحقق: تحقق_نمط_نوعي = {
            الجذر: الأصل[موضع].التحقق.الجذر,
            الروابط: الروابط,
            أنواع_العقد: أنواع_العقد,
            غير_قابل_للدحض: الأصل[موضع].التحقق.غير_قابل_للدحض
        };
        دع الربط: ربط_تحقق_نمط_وحدة = { التحقق: التحقق };
        ألحق(الناتج, الربط);
        ف := ف + 1;
    }
    أرجع الناتج;
}
