استورد compiler.source.span;
استورد compiler.frontend.ast.unit;
استورد compiler.frontend.ast.declarations;
استورد compiler.frontend.ast.statements;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.semantic_pipeline;
استورد compiler.frontend.types.expression_types;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.declaration_collection;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.pattern.type_validation;
