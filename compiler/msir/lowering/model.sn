// مفردات داخلية موحدة لمحرك خفض MSIR. لا يملك هذا الملف Diagnostics المقننة.
عام نوع خطأ_خفض_مسير =
    | نوع_غير_محلول بنوع نطاق
    | ربط_اسم_مفقود بنوع نطاق
    | نوع_تعبير_مفقود بنوع نطاق
    | نوع_رمز_دلالي_مفقود بنوع معرف_رمز
    | توقيع_دالة_دلالي_مفقود بنوع معرف_رمز
    | نوع_رمز_دلالي_غير_متسق بنوع (معرف_رمز, معرف_نوع, معرف_نوع)
    | هوية_منشئ_مفقودة بنوع نطاق
    | دالة_خارجية_غير_مدعومة بنوع نطاق
    | دالة_دلالية_مفقودة بنوع معرف_رمز
    | رمز_محلي_مفقود بنوع معرف_رمز
    | محلي_غير_مهيأ بنوع معرف_رمز
    | محلي_مكرر بنوع معرف_رمز
    | عدد_حجج_غير_مطابق بنوع نطاق
    | نوع_حجة_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | نوع_إرجاع_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | مسار_بلا_إرجاع بنوع نطاق
    | عبارة_غير_مدعومة بنوع نطاق
    | تعبير_غير_مدعوم بنوع نطاق
    | نوع_تعبير_غير_مدعوم بنوع (نطاق, معرف_نوع)
    | بناء_مسير_مرفوض بنوع خطأ_بناء_مسير
;

عام نوع نتيجة_خفض_مسير =
    | ناجح بنوع برنامج_مسير
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع قيمة_خفض_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع مكان_خفض_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع نتيجة_خفض_مكان =
    | مكان بنوع مكان_خفض_مسير
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع نتيجة_خفض_تعبير =
    | قيمة بنوع قيمة_خفض_مسير
    | بلا_قيمة
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع نتيجة_حل_نوع_للخفض =
    | موجود بنوع معرف_نوع
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع ربط_محلي_خفض = {
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: اختيار معرف_قيمة_مسير,
    المكان: اختيار معرف_قيمة_مسير
};

عام نوع حالة_خفض_دالة = {
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    نشطة: منطقي,
    المحليات: متجه ربط_محلي_خفض,
    له_هدف_خروج_حلقة: منطقي,
    هدف_خروج_حلقة: معرف_كتلة_مسير,
    له_هدف_متابعة_حلقة: منطقي,
    هدف_متابعة_حلقة: معرف_كتلة_مسير,
    عدد_محليات_متابعة_حلقة: غير_موقع,
    // Branch snapshots share this immutable vector until a local mutation occurs.
    المحليات_مشتركة: منطقي
};

عام نوع هدف_دالة_خفض =
    | داخلية بنوع معرف_دالة_مسير
    | خارجية بنوع معرف_دالة_خارجية_مسير
;

عام نوع ربط_دالة_خفض = {
    الرمز: معرف_رمز,
    استبدالات_النوع: متجه ربط_استبدال_نوع,
    الهدف: هدف_دالة_خفض,
    المعاملات: متجه معرف_نوع,
    الناتج: اختيار معرف_نوع
};

عام نوع سياق_دوال_خفض = {
    الدوال: متجه ربط_دالة_خفض
};

عام نوع وصف_صحيح_خفض = {
    موقع: منطقي,
    البتات: غير_موقع
};
