استورد compiler.source.span;
استورد compiler.source.provenance;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.msir.msir_builder;
استورد compiler.msir.debug_contract;
استورد std.collections.map;
استورد compiler.frontend.ssf.ownership_facts;

// مفردات داخلية موحدة لمحرك خفض MSIR. لا يملك هذا الملف Diagnostics المقننة.
عام نوع خطأ_خفض_مسير =
    | نوع_غير_محلول بنوع نطاق
    | ربط_اسم_مفقود بنوع نطاق
    | نوع_تعبير_مفقود بنوع نطاق
    | نوع_رمز_دلالي_مفقود بنوع معرف_رمز
    | توقيع_دالة_دلالي_مفقود بنوع معرف_رمز
    | نوع_رمز_دلالي_غير_متسق بنوع (معرف_رمز, معرف_نوع, معرف_نوع)
    | هوية_منشئ_مفقودة بنوع نطاق
    | دالة_خارجية_غير_مدعومة بنوع نطاق
    | دالة_دلالية_مفقودة بنوع معرف_رمز
    | سعة_خريطة_غير_قابلة_للتمثيل
    | فهرس_مصدر_مكرر
    | رمز_محلي_مفقود بنوع معرف_رمز
    | محلي_غير_مهيأ بنوع معرف_رمز
    | محلي_مكرر بنوع معرف_رمز
    | عدد_حجج_غير_مطابق بنوع نطاق
    | نوع_حجة_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | نوع_إرجاع_غير_مطابق بنوع (نطاق, معرف_نوع, معرف_نوع)
    | مسار_بلا_إرجاع بنوع نطاق
    | عبارة_غير_مدعومة بنوع نطاق
    | تعبير_وقت_الترجمة_غير_ثابت بنوع نطاق
    // Constant evaluation of a module value or comptime expression hit an
    // operation that traps at run time (overflow, division by zero).
    | تقييم_ثابت_بفخ بنوع نطاق
    | تعبير_غير_مدعوم بنوع نطاق
    | نوع_تعبير_غير_مدعوم بنوع (نطاق, معرف_نوع)
    | بناء_مسير_مرفوض بنوع خطأ_بناء_مسير
;

عام نوع نتيجة_خفض_مسير =
    | ناجح بنوع (برنامج_مسير, بيانات_تصحيح_مسير, سجل_أصول_مصدر)
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع قيمة_خفض_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع مكان_خفض_مسير = {
    المعرف: معرف_قيمة_مسير,
    النوع: معرف_نوع
};

عام نوع نتيجة_خفض_مكان =
    | مكان بنوع مكان_خفض_مسير
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع نتيجة_خفض_تعبير =
    | قيمة بنوع قيمة_خفض_مسير
    | بلا_قيمة
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع نتيجة_حل_نوع_للخفض =
    | موجود بنوع معرف_نوع
    | مرفوض بنوع خطأ_خفض_مسير
;

عام نوع ربط_محلي_خفض = {
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: اختياري معرف_قيمة_مسير,
    المكان: اختياري معرف_قيمة_مسير,
    // Drop flag of an owner local (drops.sn): a function-wide boolean place,
    // true while the local holds a value it must destroy.
    الراية: اختياري معرف_قيمة_مسير
};

// The function-wide drop frame (drops.sn). The entry block holds the storage
// and drop flags of every owner local; the body starts in البداية; every
// return jumps to الخروج, which destroys the owners still holding a value.
عام نوع إطار_إسقاط_خفض = {
    التمهيد: معرف_كتلة_مسير,
    البداية: معرف_كتلة_مسير,
    الخروج: معرف_كتلة_مسير,
    معامل_الخروج: اختياري معرف_قيمة_مسير,
    نوع_المنطق: معرف_نوع
};

// Compact function-local specialized Symbol types for a concrete generic instance.
عام نوع ربط_نوع_رمز_خفض = { الرمز: معرف_رمز, النوع: معرف_نوع };

عام نوع حالة_خفض_دالة = {
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    نشطة: منطقي,
    البناء: حالة_بناء_مسير,
    المحليات: متجه ربط_محلي_خفض,
    له_هدف_خروج_حلقة: منطقي,
    هدف_خروج_حلقة: معرف_كتلة_مسير,
    له_هدف_متابعة_حلقة: منطقي,
    هدف_متابعة_حلقة: معرف_كتلة_مسير,
    عدد_محليات_متابعة_حلقة: طبيعي,
    // Branch snapshots share immutable lowering indexes until local mutation occurs.
    المحليات_مشتركة: منطقي,
    // Absent for code without drop elaboration (closure bodies, compile-time blocks).
    إطار_الإسقاط: اختياري إطار_إسقاط_خفض
};

عام نوع هدف_دالة_خفض =
    | داخلية بنوع معرف_دالة_مسير
    | خارجية بنوع معرف_دالة_خارجية_مسير
;



// Canonical concrete function-instance identity used by monomorphization and
// MSIR function lookup. The complete substitution set is part of the key.
عام نوع طلب_مثيل_دالة_خفض = {
    الرمز: معرف_رمز,
    استبدالات_النوع: متجه ربط_استبدال_نوع
};

عرف ربطا_استبدال_مثيل_متساويان(أ: ربط_استبدال_نوع, ب: ربط_استبدال_نوع): منطقي {
    أرجع معرفا_رمز_متساويان(أ.المعامل, ب.المعامل)
        && معرفا_نوع_متساويان(أ.الحجة, ب.الحجة);
}

عام عرف استبدالات_مثيل_دالة_متساوية(
    أ: &متجه ربط_استبدال_نوع,
    ب: &متجه ربط_استبدال_نوع
): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        دع عدد_أ: متغير طبيعي = 0;
        دع عدد_ب: متغير طبيعي = 0;
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(*أ) مثل طبيعي)) {
            لو (ربطا_استبدال_مثيل_متساويان((*أ)[ف], (*أ)[ي])) { عدد_أ := عدد_أ + 1; };
            ي := ي + 1;
        }
        ي := 0;
        طالما (ي < (الطول(*ب) مثل طبيعي)) {
            لو (ربطا_استبدال_مثيل_متساويان((*أ)[ف], (*ب)[ي])) { عدد_ب := عدد_ب + 1; };
            ي := ي + 1;
        }
        لو (عدد_أ != عدد_ب) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف امزج_هاش_مثيل_دالة(الهاش: طبيعي, القيمة: طبيعي): طبيعي {
    // Keep arithmetic bounded like the canonical frontend indexes; equality
    // remains authoritative for collisions.
    أرجع ((الهاش * 257) + (القيمة % 1048573)) % 1048573;
}

عام عرف هاش_طلب_مثيل_دالة_خفض(المفتاح: &طلب_مثيل_دالة_خفض): طبيعي {
    دع هاش_الرمز: طبيعي = امزج_هاش_مثيل_دالة(1, (*المفتاح).الرمز.القيمة);
    دع مجموع: متغير طبيعي = 0;
    دع خلط: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المفتاح).استبدالات_النوع) مثل طبيعي)) {
        دع الربط: ربط_استبدال_نوع = (*المفتاح).استبدالات_النوع[ف];
        دع هاش_الزوج: طبيعي = امزج_هاش_مثيل_دالة(
            امزج_هاش_مثيل_دالة(1, الربط.المعامل.القيمة),
            الربط.الحجة.القيمة
        );
        مجموع := (مجموع + هاش_الزوج) % 1048573;
        خلط := خلط ^ هاش_الزوج;
        ف := ف + 1;
    }
    دع الناتج: متغير طبيعي = امزج_هاش_مثيل_دالة(
        هاش_الرمز, الطول((*المفتاح).استبدالات_النوع) مثل طبيعي
    );
    الناتج := امزج_هاش_مثيل_دالة(الناتج, مجموع);
    الناتج := امزج_هاش_مثيل_دالة(الناتج, خلط);
    أرجع الناتج;
}

عام عرف مفتاحا_مثيل_دالة_خفض_متساويان(
    أ: &طلب_مثيل_دالة_خفض,
    ب: &طلب_مثيل_دالة_خفض
): منطقي {
    أرجع معرفا_رمز_متساويان((*أ).الرمز, (*ب).الرمز)
        && استبدالات_مثيل_دالة_متساوية(&(*أ).استبدالات_النوع, &(*ب).استبدالات_النوع);
}

عام عرف انسخ_استبدالات_مثيل_دالة(
    المصدر: &متجه ربط_استبدال_نوع
): متجه ربط_استبدال_نوع {
    دع الناتج: متغير متجه ربط_استبدال_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_فهرس_مثيل_دالة_خفض(): الخريطة<طلب_مثيل_دالة_خفض, طبيعي> {
    أرجع أنشئ_الخريطة(
        هاش_طلب_مثيل_دالة_خفض,
        مفتاحا_مثيل_دالة_خفض_متساويان
    );
}

عام عرف انسخ_طلب_مثيل_دالة_خفض(
    المصدر: &طلب_مثيل_دالة_خفض
): طلب_مثيل_دالة_خفض {
    دع الاستبدالات: متجه ربط_استبدال_نوع = انسخ_استبدالات_مثيل_دالة(
        &(*المصدر).استبدالات_النوع
    );
    دع الناتج: طلب_مثيل_دالة_خفض = {
        الرمز: (*المصدر).الرمز,
        استبدالات_النوع: الاستبدالات
    };
    أرجع الناتج;
}

عام نوع ربط_دالة_خفض = {
    الرمز: معرف_رمز,
    استبدالات_النوع: متجه ربط_استبدال_نوع,
    الهدف: هدف_دالة_خفض,
    المعاملات: متجه معرف_نوع,
    الناتج: اختياري معرف_نوع
};

عام نوع هدف_قيمة_عليا_خفض =
    | ثابت بنوع ثابت_مسير
    | عام بنوع معرف_عام_مسير
;

عام عرف انسخ_هدف_قيمة_عليا_خفض(الهدف: &هدف_قيمة_عليا_خفض): هدف_قيمة_عليا_خفض {
    طابق *الهدف مع
    | هدف_قيمة_عليا_خفض.ثابت(الثابت) -> {
        دع المنسوخ: ثابت_مسير = انسخ_ثابت_مسير(&الثابت);
        أرجع هدف_قيمة_عليا_خفض.ثابت(المنسوخ);
    }
    | هدف_قيمة_عليا_خفض.عام(المعرف) -> { أرجع هدف_قيمة_عليا_خفض.عام(المعرف); };
}

عام نوع ربط_قيمة_عليا_خفض = {
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    قابل_للكتابة: منطقي,
    الهدف: هدف_قيمة_عليا_خفض
};

عام نوع سياق_دوال_خفض = {
    الدوال: متجه ربط_دالة_خفض,
    فهرس_الدوال: الخريطة<طلب_مثيل_دالة_خفض, طبيعي>,
    القيم_العليا: متجه ربط_قيمة_عليا_خفض,
    منتقي_لينكس: اختياري معرف_رمز,
    منشئات_لينكس: متجه منشئ_نواة_موثق_واجهة,
    // SSF moves and borrowed views (compiler/frontend/ssf/ownership_facts.sn).
    حقائق_الملكية: حقائق_ملكية_تدفق,
    // Functions that never return (std.process.panic's إنهيار): a call
    // statement to one ends its block in a trap.
    رموز_لا_تعود: متجه معرف_رمز,
    // std.fmt's compile-time checker, then the format functions whose literal
    // format strings it checks (frontend/semantic_pipeline.sn).
    رموز_التنسيق: متجه معرف_رمز
};

عام نوع وصف_صحيح_خفض = {
    موقع: منطقي,
    البتات: طبيعي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_ربط_دالة_خفض(القيمة: &ربط_دالة_خفض): ربط_دالة_خفض {
    دع الناتج: ربط_دالة_خفض = {
        الرمز: (*القيمة).الرمز,
        استبدالات_النوع: انسخ_مملوكا_متجه_ربط_استبدال_نوع(&(*القيمة).استبدالات_النوع),
        الهدف: (*القيمة).الهدف,
        المعاملات: انسخ_مملوكا_متجه_معرف_نوع(&(*القيمة).المعاملات),
        الناتج: (*القيمة).الناتج
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_ربط_محلي_خفض(القيمة: &متجه ربط_محلي_خفض): متجه ربط_محلي_خفض {
    دع الناتج: متغير متجه ربط_محلي_خفض = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حالة_خفض_دالة(القيمة: &حالة_خفض_دالة): حالة_خفض_دالة {
    دع الناتج: حالة_خفض_دالة = {
        الدالة: (*القيمة).الدالة,
        الكتلة: (*القيمة).الكتلة,
        نشطة: (*القيمة).نشطة,
        البناء: (*القيمة).البناء,
        المحليات: انسخ_مملوكا_متجه_ربط_محلي_خفض(&(*القيمة).المحليات),
        له_هدف_خروج_حلقة: (*القيمة).له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: (*القيمة).هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: (*القيمة).له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: (*القيمة).هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: (*القيمة).عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: (*القيمة).المحليات_مشتركة,
        إطار_الإسقاط: (*القيمة).إطار_الإسقاط
    };
    أرجع الناتج;
}
