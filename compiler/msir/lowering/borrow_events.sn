// The borrow events of the source (msir_model.sn, حدث_استعارة_مسير):
// lowering records, where each statement ends, what the statement does to
// borrows in the order the source states it (docs/en/internals/
// ownership-analysis.md, "Borrows"): the places it writes and changes in
// place, the values it passes on, the borrows its calls take while they run,
// the origins it gives a local, the borrowed views it binds, the values that
// leave the function. The ownership legality analysis on MSIR
// (msir/ssf/ownership_legality.sn) follows them over the control flow and
// states the errors. Lowering only names what the source says; it decides
// nothing that depends on the flow of values, and records nothing where a
// scope ends: where a borrow ends is the analysis's (ssf/borrow_liveness.sn,
// from the uses of its holder on MSIR).

// The kind of each Symbol's declaration, by SymbolID: 1 a function, 2 an
// external function, 3 a module value, 4 an enum constructor, 5 a
// parameter, 6 a local binding, 0 anything else.
عام عرف أصناف_رموز_استعارة_خفض(الاستعلامات: &اختياري سياق_استعلامات_أسماء): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    طابق *الاستعلامات مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الحقائق) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقائق.الرموز) مثل طبيعي)) {
            ليكن الصنف: متغير ط8 = 0;
            طابق الحقائق.الرموز[ف].النوع مع
            | نوع_تصريح.دالة -> { الصنف := 1; }
            | نوع_تصريح.دالة_خارجية -> { الصنف := 2; }
            | نوع_تصريح.قيمة_عليا -> { الصنف := 3; }
            | نوع_تصريح.منشئ_تعداد -> { الصنف := 4; }
            | نوع_تصريح.معامل -> { الصنف := 5; }
            | نوع_تصريح.ربط_محلي -> { الصنف := 6; }
            | _ -> { };
            ألحق(الناتج, الصنف);
            ف := ف + 1;
        }
    };
    أرجع الناتج;
}

عرف صنف_رمز_استعارة_خفض(دوال_الخفض: &سياق_دوال_خفض, الرمز: معرف_رمز): ط8 {
    ليكن ف: طبيعي = الرمز.القيمة مثل طبيعي;
    إذا (ف >= (الطول((*دوال_الخفض).أصناف_الرموز) مثل طبيعي)) { أرجع 0; };
    أرجع (*دوال_الخفض).أصناف_الرموز[ف];
}

عرف بت_استعارة_خفض(القيمة: ط32, البت: ط32): منطقي {
    أرجع ((القيمة / البت) % 2) == 1;
}

// The Memory facts of a Type as flags: 1 it carries a borrow, 2 it owns
// storage, 4 it is a borrow, 8 it holds an exclusive borrow, 16 its value
// needs releasing.
عام عرف أعلام_ذاكرة_استعارة_خفض(دوال_الخفض: &سياق_دوال_خفض, النوع: معرف_نوع): ط32 {
    طابق حقائق_ذاكرة_نوع_مطلوبة(&(*دوال_الخفض).الذاكرة, النوع) مع
    | نتيجة.خطأ(_) -> { أرجع 0; }
    | نتيجة.نجح(الحقائق) -> {
        ليكن الأعلام: متغير ط32 = 0;
        إذا (الحقائق.يحتوي_مستعارا) { الأعلام := الأعلام + 1; };
        طابق الحقائق.الصنف مع
        | صنف_ذاكرة.مملوك -> { الأعلام := الأعلام + 2; }
        | صنف_ذاكرة.مستعار -> { الأعلام := الأعلام + 4; }
        | صنف_ذاكرة.عادي -> { };
        إذا (الحقائق.يحتوي_استعارة_حصرية) { الأعلام := الأعلام + 8; };
        إذا (الحقائق.يتطلب_تحريرا) { الأعلام := الأعلام + 16; };
        أرجع الأعلام;
    };
}

// The flags of an expression's Type (0 when it has none).
عرف أعلام_تعبير_استعارة_خفض(
    دوال_الخفض: &سياق_دوال_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): ط32 {
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
    | اختياري.موجود(النوع) -> { أرجع أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, النوع); }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// The Type of local الرمز in scope.
عرف نوع_محلي_استعارة_خفض(الحالة: &حالة_خفض_دالة, الرمز: معرف_رمز): اختياري معرف_نوع {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(الموضع) -> { أرجع اختياري.موجود((*الحالة).المحليات[الموضع].النوع); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف هل_محلي_استعارة_خفض(الحالة: &حالة_خفض_دالة, الرمز: معرف_رمز): منطقي {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف أعلام_محلي_استعارة_خفض(
    دوال_الخفض: &سياق_دوال_خفض,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): ط32 {
    طابق نوع_محلي_استعارة_خفض(الحالة, الرمز) مع
    | اختياري.موجود(النوع) -> { أرجع أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, النوع); }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// Records one event at the current position of the current block.
عام عرف سجل_حدث_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الصنف: ط32,
    الرمز: ط32,
    الثاني: ط32,
    الأعلام: ط32,
    النطاق: نطاق,
    الحدود: متجه حد_أصل_مسير
): فراغ {
    إذا (!(*الحالة).نشطة) { أرجع; };
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن الكتلة: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع; };
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع; };
    طالما ((الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي) <= الدالة) {
        ليكن فارغة: متجه حدث_استعارة_مسير = [];
        ألحق((*البرنامج).أحداث_الاستعارة, فارغة);
    }
    ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي;
    ليكن الحدث: حدث_استعارة_مسير = {
        الكتلة: (*الحالة).الكتلة.القيمة,
        الموضع: العدد مثل ط32,
        الصنف: الصنف,
        الرمز: الرمز,
        الثاني: الثاني,
        الأعلام: الأعلام,
        النطاق: النطاق,
        الحدود: الحدود
    };
    ألحق((*البرنامج).أحداث_الاستعارة[الدالة], الحدث);
}

عرف سجل_حدث_بسيط_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الصنف: ط32,
    الرمز: معرف_رمز,
    الثاني: ط32,
    الأعلام: ط32,
    النطاق: نطاق
): فراغ {
    ليكن بلا: متجه حد_أصل_مسير = [];
    سجل_حدث_استعارة_خفض(البرنامج, الحالة, الصنف, الرمز.القيمة, الثاني, الأعلام, النطاق, بلا);
}

// Places: the local a place is rooted at through members and elements; the
// local it is reached from through dereferences too; whether its path
// crosses a dereference.
عرف رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء: &سياق_روابط_أسماء, التعبير: &تعبير): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> { أرجع رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء: &سياق_روابط_أسماء, التعبير: &تعبير): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق); }
    | تعبير.حقل(_, الأصل, _) -> { أرجع رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)); }
    | تعبير.فك_موضع(_, الداخل) -> { أرجع رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, &(*الداخل)); }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل) -> { أرجع رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, &(*الداخل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف موضع_عبر_مرجع_استعارة_خفض(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> { أرجع موضع_عبر_مرجع_استعارة_خفض(&(*الأصل)); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع موضع_عبر_مرجع_استعارة_خفض(&(*الأصل)); }
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ألحق_حد_استعارة_خفض(الناتج: &متغير متجه حد_أصل_مسير, الصنف: ط32, الرمز: معرف_رمز, الأعلام: ط32): فراغ {
    ليكن الحد: حد_أصل_مسير = { الصنف: الصنف, الرمز: الرمز.القيمة, الأعلام: الأعلام };
    ألحق(*الناتج, الحد);
}

// The terms of the origins of التعبير, in the source's order: a local's
// own origins for its name; those of the base of a member, element or
// dereference; a borrow of a local (its origins, or the local itself when it
// has none); a read through a reference local; every argument of a call and
// member of a literal; nothing for a raw pointer cast or anything else.
عرف ألحق_حدود_أصول_استعارة_خفض(
    الحالة: &حالة_خفض_دالة,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    التعبير: &تعبير,
    الناتج: &متغير متجه حد_أصل_مسير
): فراغ {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) { ألحق_حد_استعارة_خفض(الناتج, 0, الرمز, 0); };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.حقل(_, الأصل, _) -> { ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &(*الأصل), الناتج); }
    | تعبير.فهرس(_, الأصل, _) -> { ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &(*الأصل), الناتج); }
    | تعبير.فك_موضع(_, الداخل) -> { ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &(*الداخل), الناتج); }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        ليكن حصرية: متغير منطقي = خطأ;
        ليكن استعارة: متغير منطقي = خطأ;
        طابق العامل مع
        | عامل_أحادي.عنوان -> { استعارة := صواب; }
        | عامل_أحادي.عنوان_متغير -> { استعارة := صواب; حصرية := صواب; }
        | _ -> { };
        إذا (!استعارة) {
            ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &(*الداخل), الناتج);
            أرجع;
        };
        طابق رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, &(*الداخل)) مع
        | اختياري.موجود(الرمز) -> {
            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
                ليكن الأعلام: متغير ط32 = 0;
                إذا (حصرية) { الأعلام := 1; };
                ألحق_حد_استعارة_خفض(الناتج, 1, الرمز, الأعلام);
            };
        }
        | اختياري.لا_شيء -> {
            إذا (موضع_عبر_مرجع_استعارة_خفض(&(*الداخل))) {
                طابق رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, &(*الداخل)) مع
                | اختياري.موجود(المرجع) -> {
                    إذا (هل_محلي_استعارة_خفض(الحالة, المرجع)) {
                        ليكن الأعلام: متغير ط32 = 0;
                        إذا (بت_استعارة_خفض(أعلام_محلي_استعارة_خفض(دوال_الخفض, الحالة, المرجع), 1)) {
                            الأعلام := 2;
                        };
                        ألحق_حد_استعارة_خفض(الناتج, 2, المرجع, الأعلام);
                    };
                }
                | اختياري.لا_شيء -> { };
            };
        };
    }
    | تعبير.استدعاء(_, _, الحجج) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &الحجج[ف], الناتج);
            ف := ف + 1;
        }
    }
    | تعبير.تحويل(_, الداخل, الهدف) -> {
        طابق *الهدف مع
        | نوع_تركيبي.مؤشر(_, _) -> { }
        | _ -> { ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &(*الداخل), الناتج); };
    }
    | تعبير.حرفي_متجه(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &العناصر[ف], الناتج);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &العناصر[ف], الناتج);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, &الحقول[ف].القيمة, الناتج);
            ف := ف + 1;
        }
    }
    | _ -> { };
}

// The terms of a value's origins when its Type carries a borrow, else none.
عرف حدود_قيمة_استعارة_خفض(
    الحالة: &حالة_خفض_دالة,
    روابط_الأسماء: &سياق_روابط_أسماء,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    دوال_الخفض: &سياق_دوال_خفض,
    التعبير: &تعبير
): متجه حد_أصل_مسير {
    ليكن الناتج: متغير متجه حد_أصل_مسير = [];
    إذا (!بت_استعارة_خفض(أعلام_تعبير_استعارة_خفض(دوال_الخفض, أنواع_التعبيرات, التعبير), 1)) {
        أرجع الناتج;
    };
    ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, التعبير, &متغير الناتج);
    أرجع الناتج;
}

// The origins of a statement's value are taken (before its effects).
عرف سجل_أصول_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الحدود: متجه حد_أصل_مسير,
    يضيف: منطقي
): فراغ {
    ليكن الأعلام: متغير ط32 = 0;
    إذا (يضيف) { الأعلام := 1; };
    سجل_حدث_استعارة_خفض(
        البرنامج, الحالة, صنف_استعارة_أصول_مسير(), 0xFFFFFFFF, 0xFFFFFFFF, الأعلام, نطاق_فارغ(), الحدود
    );
}

// A write into the place الوجهة: it ends the borrowed views of a local's
// storage, or every value reading through the reference the place is
// reached through.
عرف سجل_كتابة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    روابط_الأسماء: &سياق_روابط_أسماء,
    الوجهة: &تعبير
): فراغ {
    إذا (!موضع_عبر_مرجع_استعارة_خفض(الوجهة)) {
        طابق رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, الوجهة) مع
        | اختياري.موجود(المالك) -> {
            إذا (هل_محلي_استعارة_خفض(الحالة, المالك)) {
                سجل_حدث_بسيط_استعارة_خفض(
                    البرنامج, الحالة, صنف_استعارة_كتابة_مسير(), المالك, 0xFFFFFFFF, 0, نطاق_تعبير(الوجهة)
                );
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع;
    };
    طابق رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, الوجهة) مع
    | اختياري.موجود(المرجع) -> {
        إذا (هل_محلي_استعارة_خفض(الحالة, المرجع)) {
            سجل_حدث_بسيط_استعارة_خفض(
                البرنامج, الحالة, صنف_استعارة_كتابة_مرجع_مسير(), المرجع, 0xFFFFFFFF, 0, نطاق_تعبير(الوجهة)
            );
        };
    }
    | اختياري.لا_شيء -> { };
}

// The storage of the local a place is rooted at is changed in place.
عرف سجل_تغيير_جذر_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    الموضع: &تعبير
): فراغ {
    طابق رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, الموضع) مع
    | اختياري.موجود(الرمز) -> {
        إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
            سجل_حدث_بسيط_استعارة_خفض(
                البرنامج, الحالة, صنف_استعارة_تغيير_مسير(), الرمز, 0xFFFFFFFF, 0, نطاق_تعبير(الموضع)
            );
        };
    }
    | اختياري.لا_شيء -> { };
}

// A value passed on (a call argument, an assigned or returned value, a
// member of a new aggregate): a local passed by value.
عرف سجل_نقل_قيمة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (!هل_محلي_استعارة_خفض(الحالة, الرمز)) { أرجع; };
            ليكن الذاكرة: ط32 = أعلام_محلي_استعارة_خفض(دوال_الخفض, الحالة, الرمز);
            ليكن الأعلام: متغير ط32 = 0;
            إذا (بت_استعارة_خفض(الذاكرة, 2)) { الأعلام := الأعلام + 1 + 4; };
            إذا (بت_استعارة_خفض(الذاكرة, 4)) {
                إذا (بت_استعارة_خفض(الذاكرة, 8)) { الأعلام := الأعلام + 1; } وإلا { الأعلام := الأعلام + 2; };
            };
            سجل_حدث_بسيط_استعارة_خفض(
                البرنامج, الحالة, صنف_استعارة_نقل_مسير(), الرمز, 0xFFFFFFFF, الأعلام, الاسم.النطاق
            );
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.أحادي(_, عامل_أحادي.فك, الداخل) -> {
        إذا (!بت_استعارة_خفض(أعلام_تعبير_استعارة_خفض(دوال_الخفض, أنواع_التعبيرات, التعبير), 16)) { أرجع; };
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&(*الداخل))) مع
        | اختياري.موجود(النوع) -> {
            طابق نوع_حمولة_صندوق_دلالي(الأنواع, النوع) مع
            | اختياري.موجود(_) -> {
                سجل_نقل_قيمة_استعارة_خفض(
                    البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        سجل_نقل_قيمة_استعارة_خفض(
            البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        );
    }
    | _ -> { };
}

// A place a call borrows while it runs: its root and projections (a field
// name, or 0xFFFFFFFF for an element).
نوع مسار_استعارة_خفض = {
    المالك: معرف_رمز,
    الإسقاطات: متجه ط32
};

عرف مسار_موضع_استعارة_خفض(روابط_الأسماء: &سياق_روابط_أسماء, التعبير: &تعبير): اختياري مسار_استعارة_خفض {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(المالك) -> {
            ليكن المسار: مسار_استعارة_خفض = { المالك: المالك, الإسقاطات: [] };
            أرجع اختياري.موجود(المسار);
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | تعبير.حقل(_, الأصل, الاسم) -> {
        طابق مسار_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مسار_الأصل) -> {
            طابق معرف_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الحقل) -> {
                ليكن المسار: متغير مسار_استعارة_خفض = مسار_الأصل;
                ألحق(المسار.الإسقاطات, الحقل.القيمة);
                أرجع اختياري.موجود(المسار);
            };
        };
    }
    | تعبير.فهرس(_, الأصل, _) -> {
        طابق مسار_موضع_استعارة_خفض(روابط_الأسماء, &(*الأصل)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مسار_الأصل) -> {
            ليكن المسار: متغير مسار_استعارة_خفض = مسار_الأصل;
            ألحق(المسار.الإسقاطات, 0xFFFFFFFF);
            أرجع اختياري.موجود(المسار);
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Whether two borrowed places overlap: the same root, and no two different
// fields where their projections first differ (an element may be any).
عرف مساران_متداخلان_استعارة_خفض(أ: &مسار_استعارة_خفض, ب: &مسار_استعارة_خفض): منطقي {
    إذا ((*أ).المالك.القيمة != (*ب).المالك.القيمة) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*أ).الإسقاطات) مثل طبيعي) && ف < (الطول((*ب).الإسقاطات) مثل طبيعي)) {
        ليكن س: ط32 = (*أ).الإسقاطات[ف];
        ليكن ص: ط32 = (*ب).الإسقاطات[ف];
        إذا (س == 0xFFFFFFFF || ص == 0xFFFFFFFF) { أرجع صواب; };
        إذا (س != ص) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

نوع مؤقتة_استعارة_خفض = {
    المسار: مسار_استعارة_خفض,
    حصرية: منطقي
};

// The borrows a call's argument takes while the call runs: a borrow of a
// place, and those of the members of a literal (and of the payloads of an
// enum constructor among a vector literal's elements).
عرف سجل_مؤقتات_حجة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    المؤقتات: &متغير متجه مؤقتة_استعارة_خفض
): فراغ {
    طابق *التعبير مع
    | تعبير.أحادي(_, العامل, الداخل) -> {
        ليكن حصرية: متغير منطقي = خطأ;
        طابق العامل مع
        | عامل_أحادي.عنوان -> { }
        | عامل_أحادي.عنوان_متغير -> { حصرية := صواب; }
        | _ -> { أرجع; };
        طابق مسار_موضع_استعارة_خفض(روابط_الأسماء, &(*الداخل)) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المسار) -> {
            ليكن متعارضة: متغير منطقي = خطأ;
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*المؤقتات) مثل طبيعي) && !متعارضة) {
                إذا (مساران_متداخلان_استعارة_خفض(&(*المؤقتات)[ف].المسار, &المسار)
                    && ((*المؤقتات)[ف].حصرية || حصرية)) {
                    متعارضة := صواب;
                };
                ف := ف + 1;
            }
            ليكن الأعلام: متغير ط32 = 0;
            إذا (متعارضة) { الأعلام := 1; };
            ليكن النوع: متغير ط32 = 0;
            إذا (حصرية) { النوع := 1; };
            سجل_حدث_بسيط_استعارة_خفض(
                البرنامج, الحالة, صنف_استعارة_مؤقتة_مسير(), المسار.المالك, النوع, الأعلام, نطاق_تعبير(التعبير)
            );
            ليكن الجديدة: مؤقتة_استعارة_خفض = { المسار: المسار, حصرية: حصرية };
            ألحق(*المؤقتات, الجديدة);
        };
    }
    | تعبير.حرفي_متجه(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            سجل_مؤقتات_حجة_استعارة_خفض(البرنامج, الحالة, &العناصر[ف], روابط_الأسماء, دوال_الخفض, المؤقتات);
            ليكن منشئ: متغير منطقي = خطأ;
            طابق العناصر[ف] مع
            | تعبير.استدعاء(_, المستدعى, _) -> {
                طابق *المستدعى مع
                | تعبير.حقل(_, _, اسم_المنشئ) -> {
                    طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_المنشئ.النطاق) مع
                    | اختياري.موجود(الرمز) -> { منشئ := صنف_رمز_استعارة_خفض(دوال_الخفض, الرمز) == 4; }
                    | اختياري.لا_شيء -> { منشئ := صواب; };
                }
                | _ -> { };
            }
            | _ -> { };
            طابق العناصر[ف] مع
            | تعبير.استدعاء(_, _, حجج_العنصر) -> {
                ليكن ح: متغير طبيعي = 0;
                طالما (منشئ && ح < (الطول(حجج_العنصر) مثل طبيعي)) {
                    سجل_مؤقتات_حجة_استعارة_خفض(
                        البرنامج, الحالة, &حجج_العنصر[ح], روابط_الأسماء, دوال_الخفض, المؤقتات
                    );
                    ح := ح + 1;
                }
            }
            | _ -> { };
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            سجل_مؤقتات_حجة_استعارة_خفض(البرنامج, الحالة, &العناصر[ف], روابط_الأسماء, دوال_الخفض, المؤقتات);
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            سجل_مؤقتات_حجة_استعارة_خفض(
                البرنامج, الحالة, &الحقول[ف].القيمة, روابط_الأسماء, دوال_الخفض, المؤقتات
            );
            ف := ف + 1;
        }
    }
    | _ -> { };
}

عرف رمز_مستدعى_استعارة_خفض(روابط_الأسماء: &سياق_روابط_أسماء, المستدعى: &تعبير): اختياري معرف_رمز {
    أرجع رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_تعبير(المستدعى));
}

// Whether parameter الفهرس of the callee is a shared reference (an
// exclusive reference passed to it is only read).
عرف معامل_مرجع_مشترك_استعارة_خفض(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    المستدعى: &تعبير,
    الفهرس: طبيعي
): منطقي {
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(المستدعى)) مع
    | اختياري.موجود(نوع_المستدعى) -> {
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, الفهرس) مع
        | اختياري.موجود(نوع_المعامل) -> {
            طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, نوع_المعامل) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
            طابق نوع_داخل_مرجع_دلالي(الأنواع, نوع_المعامل) مع
            | اختياري.موجود(_) -> { أرجع صواب; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The mode of a direct reference Type: 1 shared, 2 exclusive, 0 not one.
عرف وضع_مرجع_مباشر_استعارة_خفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): ط32 {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع 2; }
    | اختياري.لا_شيء -> { };
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> { أرجع 1; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف هل_عرض_متجه_كشريحة_استعارة_خفض(الأنواع: &سجل_أنواع, المصدر: معرف_نوع, الهدف: معرف_نوع): منطقي {
    طابق نوع_عنصر_متجه_دلالي(الأنواع, المصدر) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> {
        طابق نوع_عنصر_شريحة_دلالي(الأنواع, الهدف) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(_) -> { أرجع صواب; };
    };
}

// What a call does to its arguments once they are evaluated: a primitive
// writes or changes its place argument, passes its values on, releases; any
// other call ends the views a mutable argument reads through, and takes
// each argument by value unless it is a reference a named function
// reborrows or a vector it views as a slice.
عرف سجل_آثار_نداء_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المستدعى: &تعبير,
    الحجج: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): فراغ {
    ليكن العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    طابق رمز_مستدعى_استعارة_خفض(روابط_الأسماء, المستدعى) مع
    | اختياري.موجود(رمز_المستدعى) -> {
        طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, رمز_المستدعى) مع
        | اختياري.موجود(الهوية) -> {
            ليكن يكتب: متغير منطقي = خطأ;
            ليكن ينقل_الثانية: متغير منطقي = خطأ;
            طابق الهوية مع
            | هوية_بدائي_مترجم.تحرير -> {
                إذا (العدد == 1) {
                    طابق (*الحجج)[0] مع
                    | تعبير.اسم(_, الاسم) -> {
                        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
                        | اختياري.موجود(الرمز) -> {
                            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
                                سجل_حدث_بسيط_استعارة_خفض(
                                    البرنامج, الحالة, صنف_استعارة_تحرير_مسير(), الرمز, 0xFFFFFFFF, 0,
                                    نطاق_تعبير(&(*الحجج)[0])
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | _ -> { };
                };
                أرجع;
            }
            | هوية_بدائي_مترجم.إلحاق -> { يكتب := صواب; ينقل_الثانية := صواب; }
            | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { يكتب := صواب; }
            | هوية_بدائي_مترجم.حجز_سعة_متجه -> { يكتب := صواب; }
            | هوية_بدائي_مترجم.إزالة_الأخير -> { يكتب := صواب; }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> { يكتب := صواب; ينقل_الثانية := صواب; }
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < العدد) {
                    سجل_كتابة_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, &(*الحجج)[ف]);
                    سجل_تغيير_جذر_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, دوال_الخفض, &(*الحجج)[ف]);
                    ف := ف + 1;
                }
                أرجع;
            }
            | هوية_بدائي_مترجم.سرب_قيمة -> {
                إذا (العدد >= 1) {
                    سجل_نقل_قيمة_استعارة_خفض(
                        البرنامج, الحالة, &(*الحجج)[0], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
                    );
                };
                أرجع;
            }
            | _ -> { أرجع; };
            إذا (يكتب && العدد >= 1) {
                سجل_كتابة_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, &(*الحجج)[0]);
                سجل_تغيير_جذر_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, دوال_الخفض, &(*الحجج)[0]);
            };
            إذا (ينقل_الثانية && العدد >= 2) {
                سجل_نقل_قيمة_استعارة_خفض(
                    البرنامج, الحالة, &(*الحجج)[1], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
                );
            };
            أرجع;
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    // A named function reborrows a direct reference argument for the call.
    ليكن يعيد_استعارة: متغير منطقي = خطأ;
    طابق رمز_مستدعى_استعارة_خفض(روابط_الأسماء, المستدعى) مع
    | اختياري.موجود(رمز_المستدعى) -> {
        ليكن الصنف: ط8 = صنف_رمز_استعارة_خفض(دوال_الخفض, رمز_المستدعى);
        يعيد_استعارة := الصنف == 1 || الصنف == 2;
    }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن الحجة: &تعبير = &(*الحجج)[ف];
        // A mutable argument may write the storage behind it.
        طابق *الحجة مع
        | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, الداخل) -> {
            سجل_كتابة_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, &(*الداخل));
        }
        | تعبير.اسم(_, الاسم) -> {
            إذا (!معامل_مرجع_مشترك_استعارة_خفض(الأنواع, أنواع_التعبيرات, المستدعى, ف)) {
                طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(الحجة)) مع
                | اختياري.موجود(النوع) -> {
                    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
                    | اختياري.موجود(_) -> {
                        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
                        | اختياري.موجود(الرمز) -> {
                            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
                                سجل_حدث_بسيط_استعارة_خفض(
                                    البرنامج, الحالة, صنف_استعارة_كتابة_مرجع_مسير(), الرمز, 0xFFFFFFFF, 0,
                                    نطاق_تعبير(الحجة)
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
        ليكن مرجع_مباشر: متغير منطقي = خطأ;
        ليكن نوع_الحجة: اختياري معرف_نوع = نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(الحجة));
        طابق نوع_الحجة مع
        | اختياري.موجود(النوع) -> { مرجع_مباشر := وضع_مرجع_مباشر_استعارة_خفض(الأنواع, النوع) != 0; }
        | اختياري.لا_شيء -> { };
        // A vector passed as a slice parameter is viewed for the call.
        ليكن عرض_شريحة: متغير منطقي = خطأ;
        طابق نوع_مستدعى_استدعاء_عند(أنواع_التعبيرات, النطاق) مع
        | اختياري.موجود(نوع_المستدعى) -> {
            طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_المستدعى, ف) مع
            | اختياري.موجود(نوع_المعامل) -> {
                طابق نوع_الحجة مع
                | اختياري.موجود(النوع) -> {
                    عرض_شريحة := هل_عرض_متجه_كشريحة_استعارة_خفض(الأنواع, النوع, نوع_المعامل);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (!(يعيد_استعارة && مرجع_مباشر) && !عرض_شريحة) {
            سجل_نقل_قيمة_استعارة_خفض(
                البرنامج, الحالة, الحجة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
            );
        };
        ف := ف + 1;
    }
}

// The effects of evaluating التعبير, in the source's order: nested calls
// (their arguments' effects, the borrows they take while they run, then
// what they do to their arguments), the members a literal takes, the locals
// a closure captures, a mutable borrow through a reference.
عام عرف سجل_آثار_تعبير_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): فراغ {
    طابق *التعبير مع
    | تعبير.حقل(_, الأصل, _) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الأصل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.فهرس(_, الأصل, الفهرس) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الأصل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الفهرس), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.فك_موضع(_, الداخل) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.ثنائي(_, _, اليسار, اليمين) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*اليسار), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*اليمين), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.أحادي(_, العامل, الداخل) -> {
        إذا ((العامل == عامل_أحادي.عنوان_متغير()) && موضع_عبر_مرجع_استعارة_خفض(&(*الداخل))) {
            سجل_كتابة_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, &(*الداخل));
        };
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.استدعاء(النطاق, المستدعى, الحجج) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*المستدعى), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            سجل_آثار_تعبير_استعارة_خفض(
                البرنامج, الحالة, &الحجج[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
            ف := ف + 1;
        }
        ليكن المؤقتات: متغير متجه مؤقتة_استعارة_خفض = [];
        ف := 0;
        طالما (ف < (الطول(الحجج) مثل طبيعي)) {
            سجل_مؤقتات_حجة_استعارة_خفض(
                البرنامج, الحالة, &الحجج[ف], روابط_الأسماء, دوال_الخفض, &متغير المؤقتات
            );
            ف := ف + 1;
        }
        سجل_آثار_نداء_استعارة_خفض(
            البرنامج, الحالة, النطاق, &(*المستدعى), &الحجج, الأنواع, أنواع_التعبيرات, روابط_الأسماء,
            دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.تحويل(_, الداخل, _) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.وقت_الترجمة(_, الداخل) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &(*الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            سجل_آثار_تعبير_استعارة_خفض(
                البرنامج, الحالة, &التعابير[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_متجه(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &العناصر[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_صف(_, العناصر) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &العناصر[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
            ف := ف + 1;
        }
    }
    | تعبير.حرفي_سجل(_, الحقول) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
            ف := ف + 1;
        }
    }
    | تعبير.إغلاق(النطاق, _, _, _) -> {
        طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, النطاق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الالتقاطات) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
                ليكن الذاكرة: ط32 = أعلام_محلي_استعارة_خفض(دوال_الخفض, الحالة, الالتقاطات[ف]);
                ليكن الأعلام: متغير ط32 = 0;
                إذا (بت_استعارة_خفض(الذاكرة, 2)) { الأعلام := الأعلام + 1; };
                إذا (بت_استعارة_خفض(الذاكرة, 4)) { الأعلام := الأعلام + 2; };
                إذا (بت_استعارة_خفض(الذاكرة, 8)) { الأعلام := الأعلام + 4; };
                إذا (هل_محلي_استعارة_خفض(الحالة, الالتقاطات[ف])) {
                    سجل_حدث_بسيط_استعارة_خفض(
                        البرنامج, الحالة, صنف_استعارة_التقاط_مسير(), الالتقاطات[ف], 0xFFFFFFFF, الأعلام, النطاق
                    );
                };
                ف := ف + 1;
            }
        };
    }
    | _ -> { };
}

// A value is evaluated and passed on.
عام عرف سجل_مصدر_قيمة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): فراغ {
    سجل_آثار_تعبير_استعارة_خفض(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    );
    سجل_نقل_قيمة_استعارة_خفض(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض);
}

// The name the destination of an assignment is, if it is one.
عرف اسم_وجهة_استعارة_خفض(الوجهة: &تعبير): اختياري اسم {
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> { أرجع اختياري.موجود(الاسم); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The assignment to the name الوجهة of the origins last taken: a local's,
// or a module value's (which may receive none).
عرف سجل_إسناد_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    الوجهة: &تعبير
): فراغ {
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_محلي_استعارة_خفض(الحالة, الرمز) مع
            | اختياري.موجود(النوع) -> {
                ليكن الأعلام: متغير ط32 = 0;
                إذا (بت_استعارة_خفض(أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, النوع), 1)) { الأعلام := الأعلام + 2; };
                ليكن الوضع: ط32 = وضع_مرجع_مباشر_استعارة_خفض(الأنواع, النوع);
                إذا (الوضع == 1) { الأعلام := الأعلام + 4; };
                إذا (الوضع == 2) { الأعلام := الأعلام + 8; };
                // A raw pointer holds no origins.
                إذا (هل_مؤشر_خام_استعارة_خفض(الأنواع, النوع)) { الأعلام := الأعلام + 16; };
                إذا (أصول_مأخوذة_استعارة_خفض(البرنامج, الحالة)) { الأعلام := الأعلام + 32; };
                سجل_حدث_بسيط_استعارة_خفض(
                    البرنامج, الحالة, صنف_استعارة_إسناد_مسير(), الرمز, 0xFFFFFFFF, الأعلام, نطاق_تعبير(الوجهة)
                );
            }
            | اختياري.لا_شيء -> {
                سجل_حدث_بسيط_استعارة_خفض(
                    البرنامج, الحالة, صنف_استعارة_إسناد_مسير(), الرمز, 0xFFFFFFFF, 1, نطاق_تعبير(الوجهة)
                );
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// Whether the origins this statement took last (its events at the current
// position, back to the one that started taking them) hold a term.
عرف أصول_مأخوذة_استعارة_خفض(البرنامج: &برنامج_مسير, الحالة: &حالة_خفض_دالة): منطقي {
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    إذا (الدالة >= (الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي)) { أرجع خطأ; };
    ليكن الأحداث: &متجه حدث_استعارة_مسير = &(*البرنامج).أحداث_الاستعارة[الدالة];
    ليكن ف: متغير طبيعي = الطول(*الأحداث) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن الحدث: &حدث_استعارة_مسير = &(*الأحداث)[ف];
        إذا ((*الحدث).الكتلة != (*الحالة).الكتلة.القيمة) { أرجع خطأ; };
        إذا ((*الحدث).الصنف == صنف_استعارة_أصول_مسير()) {
            إذا ((الطول((*الحدث).الحدود) مثل طبيعي) > 0) { أرجع صواب; };
            إذا (((*الحدث).الأعلام % 2) == 0) { أرجع خطأ; };
        };
    }
    أرجع خطأ;
}

عرف هل_مؤشر_خام_استعارة_خفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// Whether a destination local is a borrowed view of the place it is first
// given (اكتشف_عرض_إسناد_خفض).
عرف هل_عرض_استعارة_خفض(الحالة: &حالة_خفض_دالة, الرمز: معرف_رمز): منطقي {
    أرجع هل_عرض_محلي_خفض(الحالة, الرمز);
}

// The borrowed view الرمز binds: the locals among the origins of المصدر and
// the reference local it reads through.
عام عرف سجل_عرض_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    المصدر: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    ليكن الحدود: متغير متجه حد_أصل_مسير = [];
    ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, المصدر, &متغير الحدود);
    ليكن المرجع: متغير ط32 = 0xFFFFFFFF;
    طابق رمز_مرجع_موضع_استعارة_خفض(روابط_الأسماء, المصدر) مع
    | اختياري.موجود(الرمز_المرجع) -> {
        إذا (الرمز_المرجع.القيمة != الرمز.القيمة && هل_محلي_استعارة_خفض(الحالة, الرمز_المرجع)) {
            المرجع := الرمز_المرجع.القيمة;
        };
    }
    | اختياري.لا_شيء -> { };
    سجل_حدث_استعارة_خفض(
        البرنامج, الحالة, صنف_استعارة_عرض_مسير(), الرمز.القيمة, المرجع, 0, نطاق_تعبير(المصدر), الحدود
    );
}

// A local becomes a borrowed view that borrows nothing it can name (an owned
// capture a closure's body reads).
عام عرف سجل_عرض_فارغ_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): فراغ {
    سجل_حدث_بسيط_استعارة_خفض(
        البرنامج, الحالة, صنف_استعارة_عرض_مسير(), الرمز, 0xFFFFFFFF, 0, نطاق_فارغ()
    );
}

// A local declared with the origins of الحدود.
عام عرف سجل_تصريح_أصول_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    الحدود: متجه حد_أصل_مسير
): فراغ {
    إذا ((الطول(الحدود) مثل طبيعي) == 0) { أرجع; };
    سجل_حدث_استعارة_خفض(
        البرنامج, الحالة, صنف_استعارة_تصريح_مسير(), الرمز.القيمة, 0xFFFFFFFF, 0, نطاق_فارغ(), الحدود
    );
}

// A parameter (of a function or a closure) of Type النوع: its own origin
// when its Type carries a borrow.
عام عرف سجل_معامل_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    دوال_الخفض: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    النوع: معرف_نوع
): فراغ {
    إذا (!بت_استعارة_خفض(أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, النوع), 1)) { أرجع; };
    ليكن الحدود: متغير متجه حد_أصل_مسير = [];
    ألحق_حد_استعارة_خفض(&متغير الحدود, 3, الرمز, 0);
    سجل_تصريح_أصول_استعارة_خفض(البرنامج, الحالة, الرمز, الحدود);
}

// A value leaves the function (a `return`, a closure's body): the check of
// its origins when its Type carries a borrow. A name of a local is checked
// as that local.
عام عرف سجل_هروب_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    إذا (!بت_استعارة_خفض(أعلام_تعبير_استعارة_خفض(دوال_الخفض, أنواع_التعبيرات, التعبير), 1)) { أرجع; };
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
                ليكن الأعلام: متغير ط32 = 0;
                إذا (بت_استعارة_خفض(أعلام_محلي_استعارة_خفض(دوال_الخفض, الحالة, الرمز), 1)) { الأعلام := 1; };
                سجل_حدث_بسيط_استعارة_خفض(
                    البرنامج, الحالة, صنف_استعارة_هروب_محلي_مسير(), الرمز, 0xFFFFFFFF, الأعلام, الاسم.النطاق
                );
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع;
    }
    | _ -> { };
    ليكن الحدود: متغير متجه حد_أصل_مسير = [];
    ألحق_حدود_أصول_استعارة_خفض(الحالة, روابط_الأسماء, دوال_الخفض, التعبير, &متغير الحدود);
    إذا ((الطول(الحدود) مثل طبيعي) == 0) { أرجع; };
    سجل_حدث_استعارة_خفض(
        البرنامج, الحالة, صنف_استعارة_هروب_مسير(), 0xFFFFFFFF, 0xFFFFFFFF, 0, نطاق_تعبير(التعبير), الحدود
    );
}

// The value a `return` (or a closure's body) passes on: `return local.field`
// of an owned local moves the whole local; any other value is evaluated and
// passed on.
عام عرف سجل_قيمة_إرجاع_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): فراغ {
    طابق *التعبير مع
    | تعبير.حقل(_, أصل_الحقل, _) -> {
        طابق *أصل_الحقل مع
        | تعبير.اسم(_, _) -> {
            إذا (بت_استعارة_خفض(أعلام_تعبير_استعارة_خفض(دوال_الخفض, أنواع_التعبيرات, التعبير), 16)) {
                سجل_نقل_قيمة_استعارة_خفض(
                    البرنامج, الحالة, &(*أصل_الحقل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
                );
                أرجع;
            };
        }
        | _ -> { };
    }
    | _ -> { };
    سجل_مصدر_قيمة_استعارة_خفض(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    );
}

// The borrow events of one statement that ends here (assignments,
// initializers, calls; the parts of other statements are recorded where
// they are evaluated). في_بداية_حلقة: a loop's initializer, where only a
// plain assignment is followed, as a value.
عام عرف سجل_أحداث_عبارة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    العبارة: &عبارة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    في_بداية_حلقة: منطقي
): فراغ {
    إذا (!(*الحالة).نشطة) { أرجع; };
    طابق *العبارة مع
    | عبارة.نسخ(_, الوجهة, المصدر) -> {
        إذا (في_بداية_حلقة) {
            سجل_أصول_استعارة_خفض(
                البرنامج, الحالة,
                حدود_قيمة_استعارة_خفض(الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, &المصدر), خطأ
            );
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
            سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
            أرجع;
        };
        // The write ends the views of the written storage; a write into a
        // member changes the root in place.
        سجل_كتابة_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, &الوجهة);
        ليكن رمز_الوجهة: متغير اختياري معرف_رمز = اختياري.لا_شيء();
        طابق اسم_وجهة_استعارة_خفض(&الوجهة) مع
        | اختياري.موجود(الاسم) -> { رمز_الوجهة := رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق); }
        | اختياري.لا_شيء -> {
            سجل_تغيير_جذر_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, دوال_الخفض, &الوجهة);
        };
        ليكن الحدود: متغير متجه حد_أصل_مسير = حدود_قيمة_استعارة_خفض(
            الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, &المصدر
        );
        // A slice local given a vector place views the vector.
        ليكن عرض_شريحة: متغير منطقي = خطأ;
        ليكن هو_عرض: متغير منطقي = خطأ;
        طابق رمز_الوجهة مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_محلي_استعارة_خفض(الحالة, الرمز) مع
            | اختياري.موجود(نوع_الوجهة) -> {
                طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&المصدر)) مع
                | اختياري.موجود(نوع_المصدر) -> {
                    إذا (هل_عرض_متجه_كشريحة_استعارة_خفض(الأنواع, نوع_المصدر, نوع_الوجهة)) {
                        طابق رمز_جذر_موضع_استعارة_خفض(روابط_الأسماء, &المصدر) مع
                        | اختياري.موجود(رمز_المتجه) -> {
                            إذا (هل_محلي_استعارة_خفض(الحالة, رمز_المتجه)) {
                                عرض_شريحة := صواب;
                                ليكن بلا: متجه حد_أصل_مسير = [];
                                الحدود := بلا;
                                ألحق_حد_استعارة_خفض(&متغير الحدود, 1, رمز_المتجه, 0);
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | اختياري.لا_شيء -> { };
                هو_عرض := هل_عرض_استعارة_خفض(الحالة, الرمز)
                    && !هل_غلاف_نوع_متغير(الأنواع, نوع_الوجهة)
                    && بت_استعارة_خفض(أعلام_تعبير_استعارة_خفض(دوال_الخفض, أنواع_التعبيرات, &المصدر), 16);
                طابق المصدر مع
                | تعبير.اسم(_, _) -> { }
                | تعبير.حقل(_, _, _) -> { }
                | تعبير.فهرس(_, _, _) -> { }
                | تعبير.فك_موضع(_, _) -> { }
                | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { }
                | _ -> { هو_عرض := خطأ; };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        سجل_أصول_استعارة_خفض(البرنامج, الحالة, الحدود, خطأ);
        إذا (هو_عرض || عرض_شريحة) {
            سجل_آثار_تعبير_استعارة_خفض(
                البرنامج, الحالة, &المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        } وإلا {
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        };
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
        إذا (هو_عرض) {
            طابق رمز_الوجهة مع
            | اختياري.موجود(الرمز) -> {
                سجل_عرض_استعارة_خفض(البرنامج, الحالة, الرمز, &المصدر, روابط_الأسماء, دوال_الخفض);
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | عبارة.تهيئة_سجل(_, الوجهة, الحقول) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        ليكن بلا: متجه حد_أصل_مسير = [];
        سجل_أصول_استعارة_خفض(البرنامج, الحالة, بلا, خطأ);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            سجل_أصول_استعارة_خفض(
                البرنامج, الحالة,
                حدود_قيمة_استعارة_خفض(الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, &الحقول[ف].القيمة),
                صواب
            );
            سجل_مصدر_قيمة_استعارة_خفض(
                البرنامج, الحالة, &الحقول[ف].القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
            ف := ف + 1;
        }
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
    }
    | عبارة.تهيئة_صف(_, الوجهة, العناصر) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        سجل_عناصر_تهيئة_استعارة_خفض(
            البرنامج, الحالة, &العناصر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
    }
    | عبارة.تهيئة_متجه(_, الوجهة, العناصر) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        سجل_عناصر_تهيئة_استعارة_خفض(
            البرنامج, الحالة, &العناصر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
    }
    | عبارة.تهيئة_نص(_, الوجهة, _) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        ليكن بلا: متجه حد_أصل_مسير = [];
        سجل_أصول_استعارة_خفض(البرنامج, الحالة, بلا, خطأ);
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
    }
    | عبارة.تهيئة_صندوق(_, الوجهة, الحمولة) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        سجل_أصول_استعارة_خفض(
            البرنامج, الحالة,
            حدود_قيمة_استعارة_خفض(الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, &الحمولة), خطأ
        );
        سجل_مصدر_قيمة_استعارة_خفض(
            البرنامج, الحالة, &الحمولة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
    }
    | عبارة.إسناد_وقت_الترجمة(_, الوجهة, _, _) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        طابق اسم_وجهة_استعارة_خفض(&الوجهة) مع
        | اختياري.موجود(_) -> {
            ليكن بلا: متجه حد_أصل_مسير = [];
            سجل_أصول_استعارة_خفض(البرنامج, الحالة, بلا, خطأ);
            سجل_إسناد_استعارة_خفض(البرنامج, الحالة, الأنواع, روابط_الأسماء, دوال_الخفض, &الوجهة);
        }
        | اختياري.لا_شيء -> {
            سجل_تغيير_جذر_استعارة_خفض(البرنامج, الحالة, روابط_الأسماء, دوال_الخفض, &الوجهة);
        };
    }
    | عبارة.استدعاء(_, التعبير) -> {
        إذا (في_بداية_حلقة) { أرجع; };
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, &التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | _ -> { };
}

عرف سجل_عناصر_تهيئة_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): فراغ {
    ليكن بلا: متجه حد_أصل_مسير = [];
    سجل_أصول_استعارة_خفض(البرنامج, الحالة, بلا, خطأ);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        سجل_أصول_استعارة_خفض(
            البرنامج, الحالة,
            حدود_قيمة_استعارة_خفض(الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, &(*العناصر)[ف]), صواب
        );
        سجل_مصدر_قيمة_استعارة_خفض(
            البرنامج, الحالة, &(*العناصر)[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        ف := ف + 1;
    }
}

// The scrutinee of a match: its origins, kept in a stand-in Symbol (one
// per match, above every source Symbol) its arms' bindings read, then its
// effects. Returns the stand-in.
عام عرف سجل_مميز_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المميز: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): معرف_رمز {
    ليكن الدالة: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    ليكن العدد: متغير طبيعي = 0;
    إذا (الدالة < (الطول((*البرنامج).أحداث_الاستعارة) مثل طبيعي)) {
        العدد := الطول((*البرنامج).أحداث_الاستعارة[الدالة]) مثل طبيعي;
    };
    ليكن البديل: متغير معرف_رمز = معرف_رمز_من(0x80000000 + (العدد مثل ط32));
    ليكن حدود_المميز: متجه حد_أصل_مسير = حدود_قيمة_استعارة_خفض(
        الحالة, روابط_الأسماء, أنواع_التعبيرات, دوال_الخفض, المميز
    );
    // A scrutinee without origins gives its bindings none (no stand-in).
    إذا ((الطول(حدود_المميز) مثل طبيعي) == 0) { البديل := معرف_رمز_من(0); };
    سجل_تصريح_أصول_استعارة_خفض(البرنامج, الحالة, البديل, حدود_المميز);
    سجل_آثار_تعبير_استعارة_خفض(
        البرنامج, الحالة, المميز, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    );
    أرجع البديل;
}

// A match arm's bindings, where the arm is entered: each carries the
// scrutinee's origins (البديل); a binding the Frontend states a borrowed
// view borrows what the scrutinee reads; a binding that owns its value
// moves it out of a scrutinee local.
عام عرف سجل_روابط_ذراع_استعارة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المميز: &تعبير,
    البديل: معرف_رمز,
    البداية: طبيعي,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    ليكن ينقل: متغير منطقي = خطأ;
    ليكن عرض: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        ليكن الرمز: معرف_رمز = (*الحالة).المحليات[ف].الرمز;
        إذا (البديل.القيمة != 0) {
            ليكن حدود_الربط: متغير متجه حد_أصل_مسير = [];
            ألحق_حد_استعارة_خفض(&متغير حدود_الربط, 0, البديل, 0);
            سجل_تصريح_أصول_استعارة_خفض(البرنامج, الحالة, الرمز, حدود_الربط);
        };
        إذا (هل_عرض_استعارة_خفض(الحالة, الرمز)) {
            عرض := صواب;
            سجل_عرض_استعارة_خفض(البرنامج, الحالة, الرمز, المميز, روابط_الأسماء, دوال_الخفض);
        } وإلا إذا (بت_استعارة_خفض(أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, (*الحالة).المحليات[ف].النوع), 16)) {
            ينقل := صواب;
        };
        ف := ف + 1;
    }
    إذا (!ينقل || عرض) { أرجع; };
    طابق *المميز مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            إذا (هل_محلي_استعارة_خفض(الحالة, الرمز)) {
                ليكن الذاكرة: ط32 = أعلام_محلي_استعارة_خفض(دوال_الخفض, الحالة, الرمز);
                ليكن الأعلام: متغير ط32 = 0;
                إذا (بت_استعارة_خفض(الذاكرة, 2)) { الأعلام := الأعلام + 1 + 4; };
                إذا (بت_استعارة_خفض(الذاكرة, 4)) {
                    إذا (بت_استعارة_خفض(الذاكرة, 8)) { الأعلام := الأعلام + 1; } وإلا { الأعلام := الأعلام + 2; };
                };
                سجل_حدث_بسيط_استعارة_خفض(
                    البرنامج, الحالة, صنف_استعارة_نقل_مسير(), الرمز, 0xFFFFFFFF, الأعلام, نطاق_تعبير(المميز)
                );
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
}

// Where the instruction that defines القيمة is in the function being lowered
// (block * 2^32 + position, plus one; 0 for nowhere): looked for from the end
// of the current block, where a value just lowered is, then in every block
// from the last.
عرف موضع_قيمة_عروض_خفض(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: معرف_قيمة_مسير
): طبيعي {
    ليكن د: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    إذا (د >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع 0; };
    ليكن الدالة: &دالة_مسير = &(*البرنامج).الدوال[د];
    ليكن عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    ليكن الحالية: طبيعي = (*الحالة).الكتلة.القيمة مثل طبيعي;
    ليكن ك: متغير طبيعي = عدد_الكتل + 1;
    طالما (ك > 0) {
        ليكن الكتلة: متغير طبيعي = الحالية;
        إذا (ك <= عدد_الكتل) { الكتلة := ك - 1; };
        إذا (الكتلة < عدد_الكتل && (ك > عدد_الكتل || الكتلة != الحالية)) {
            ليكن التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة].التعليمات;
            ليكن ت: متغير طبيعي = الطول(*التعليمات) مثل طبيعي;
            طالما (ت > 0) {
                ت := ت - 1;
                إذا ((*التعليمات)[ت].الناتج.القيمة == القيمة.القيمة) {
                    أرجع الكتلة * 4294967296 + ت + 1;
                };
            }
        };
        ك := ك - 1;
    }
    أرجع 0;
}

// Whether a value of the lowered body was read from borrowed storage
// (docs/en/reference/ownership.md, "Borrowed views"), decided on the MSIR
// that computes it: the load of a place reached through a reference or a box
// anywhere on the way to its root (members and elements, as projected places
// or as extracted parts, lead to their root), or rooted at a borrowed view.
// For a match scrutinee (للمطابقة) a member or element is borrowed too, and
// so is an immutable module value (read as a constant when it is text, which
// the use lowering recorded names).
عرف قيمة_مستعارة_عروض_خفض(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    دوال_الخفض: &سياق_دوال_خفض,
    القيمة: معرف_قيمة_مسير,
    للمطابقة: منطقي
): منطقي {
    ليكن الحالي: متغير معرف_قيمة_مسير = القيمة;
    ليكن الأعلى: متغير منطقي = صواب;
    ليكن الخطوات: متغير طبيعي = 0;
    // A chain of definitions is no longer than the function's values.
    ليكن عدد_القيم: طبيعي = الطول((*البرنامج).الدوال[(*الحالة).الدالة.القيمة مثل طبيعي].القيم) مثل طبيعي;
    طالما (الخطوات <= عدد_القيم) {
        الخطوات := الخطوات + 1;
        ليكن الموضع: طبيعي = موضع_قيمة_عروض_خفض(البرنامج, الحالة, الحالي);
        إذا (الموضع == 0) { أرجع خطأ; };
        ليكن د: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
        ليكن ك: طبيعي = (الموضع - 1) / 4294967296;
        ليكن ت: طبيعي = (الموضع - 1) % 4294967296;
            طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
            // The loaded place is still the scrutinee's own form.
            | عملية_مسير.تحميل(التحميل) -> { الحالي := التحميل.المكان; الأعلى := صواب; }
            | عملية_مسير.استخراج_حقل(الاستخراج) -> {
                إذا (للمطابقة && الأعلى) { أرجع صواب; };
                الحالي := الاستخراج.المصدر; الأعلى := خطأ;
            }
            | عملية_مسير.استخراج_فهرس(الاستخراج) -> {
                إذا (للمطابقة && الأعلى) { أرجع صواب; };
                الحالي := الاستخراج.المصدر; الأعلى := خطأ;
            }
            | عملية_مسير.مكان_حقل(المكان) -> {
                إذا (للمطابقة && الأعلى) { أرجع صواب; };
                الحالي := المكان.الأصل; الأعلى := خطأ;
            }
            | عملية_مسير.مكان_فهرس(المكان) -> {
                إذا (للمطابقة && الأعلى) { أرجع صواب; };
                الحالي := المكان.الأصل; الأعلى := خطأ;
            }
            | عملية_مسير.موضع_تخزين_عنصر_مؤشر(الموضع) -> {
                إذا (للمطابقة && الأعلى) { أرجع صواب; };
                الحالي := الموضع.المؤشر; الأعلى := خطأ;
            }
            | عملية_مسير.مرجع_إلى_مكان(_) -> { أرجع صواب; }
            | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع صواب; }
            | عملية_مسير.مكان_محلي(المكان) -> {
                طابق المكان.المحلي مع
                | اختياري.موجود(الرمز) -> { أرجع هل_عرض_محلي_خفض(الحالة, الرمز); }
                | اختياري.لا_شيء -> { أرجع خطأ; };
            }
            | عملية_مسير.مكان_عام(المكان) -> { أرجع للمطابقة && !المكان.قابل_للكتابة; }
            | عملية_مسير.ثابت(_) -> {
                إذا (!للمطابقة || الخطوات != 1) { أرجع خطأ; };
                أرجع ثابت_قيمة_عليا_عروض_خفض(البرنامج, الحالة, دوال_الخفض);
            }
            | _ -> { أرجع خطأ; };
    }
    أرجع خطأ;
}

// Whether the constant the current block ends with is the read of a module
// value (the use lowering recorded on it names a module value).
عرف ثابت_قيمة_عليا_عروض_خفض(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    ليكن د: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    إذا (د >= (الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي)) { أرجع خطأ; };
    ليكن الاستخدامات: &متجه استخدام_مصدري_مسير = &(*البرنامج).مصادر_الاستخدامات[د];
    إذا ((الطول(*الاستخدامات) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن الأخير: &استخدام_مصدري_مسير = &(*الاستخدامات)[(الطول(*الاستخدامات) مثل طبيعي) - 1];
    إذا ((*الأخير).الرمز == 0xFFFFFFFF) { أرجع خطأ; };
    أرجع صنف_رمز_استعارة_خفض(دوال_الخفض, معرف_رمز_من((*الأخير).الرمز مثل طبيعي)) == 3;
}

// A statement `name := value` (a declaration's initialization or a later
// assignment) makes the local a borrowed view when it is declared without
// `mutable`, the value's Type needs releasing, and the value was read from
// borrowed storage (قيمة_مستعارة_عروض_خفض). Lowering placed the local as an
// owner at its declaration; it now owns nothing (drops.sn, اجعل_المحلي_عرضا_خفض).
عام عرف اكتشف_عرض_إسناد_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الوجهة: &تعبير,
    المصدر: &تعبير,
    القيمة: معرف_قيمة_مسير,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    إذا (!(*الحالة).يجد_العروض) { أرجع; };
    طابق اسم_وجهة_استعارة_خفض(الوجهة) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            إذا (صنف_رمز_استعارة_خفض(دوال_الخفض, الرمز) != 6) { أرجع; };
            إذا (هل_عرض_محلي_خفض(الحالة, الرمز)) { أرجع; };
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(النوع) -> {
                إذا (هل_غلاف_نوع_متغير(الأنواع, النوع)) { أرجع; };
                طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(المصدر)) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(نوع_المصدر) -> {
                    إذا (يتطلب_تحريرا_عروض_خفض(دوال_الخفض, نوع_المصدر)
                        && قيمة_مستعارة_عروض_خفض(&(*البرنامج), &(*الحالة), دوال_الخفض, القيمة, خطأ)) {
                        ألحق((*الحالة).العروض, الرمز);
                        اجعل_المحلي_عرضا_خفض(البرنامج, الحالة, الرمز);
                    };
                };
            };
        };
    };
}

// A local placed as an owner (drops.sn, ثبّت_محلي_خفض) that the value it is
// given makes a borrowed view owns nothing: its place moves from the
// prologue to the frame's الخانات block, where the place of a local that is
// no owner is, its declaration is no owner's any more, and its members are
// read as any other local's.
عرف اجعل_المحلي_عرضا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز
): فراغ {
    ليكن الموضع: طبيعي;
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { الموضع := القيمة; };
    ليكن د: طبيعي = (*الحالة).الدالة.القيمة مثل طبيعي;
    // The declaration of an owning local is a use (msir_context.sn); a
    // borrowed view's is not.
    إذا (د < (الطول((*البرنامج).مصادر_الاستخدامات) مثل طبيعي)) {
        ليكن العدد: طبيعي = الطول((*البرنامج).مصادر_الاستخدامات[د]) مثل طبيعي;
        ليكن ف: متغير طبيعي = العدد;
        ليكن وجد: متغير منطقي = خطأ;
        طالما (ف > 0 && !وجد) {
            ف := ف - 1;
            ليكن الاستخدام: &استخدام_مصدري_مسير = &(*البرنامج).مصادر_الاستخدامات[د][ف];
            إذا ((*الاستخدام).الصنف == صنف_استخدام_مالك_مسير() && (*الاستخدام).الرمز == الرمز.القيمة) {
                وجد := صواب;
            };
        }
        إذا (وجد) {
            ليكن ي: متغير طبيعي = ف;
            طالما (ي + 1 < العدد) {
                (*البرنامج).مصادر_الاستخدامات[د][ي] := (*البرنامج).مصادر_الاستخدامات[د][ي + 1];
                ي := ي + 1;
            }
            اقتطع((*البرنامج).مصادر_الاستخدامات[د], العدد - 1);
        };
    };
    إذا (!(*الحالة).المحليات[الموضع].مالك) { أرجع; };
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الإطار) -> {
        طابق (*الحالة).المحليات[الموضع].المكان مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المكان) -> {
            ليكن التمهيد: طبيعي = الإطار.التمهيد.القيمة مثل طبيعي;
            ليكن الخانات: طبيعي = الإطار.الخانات.القيمة مثل طبيعي;
            ليكن العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات) مثل طبيعي;
            ليكن ف: متغير طبيعي = العدد;
            ليكن وجد: متغير منطقي = خطأ;
            طالما (ف > 0 && !وجد) {
                ف := ف - 1;
                إذا ((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات[ف].الناتج.القيمة == المكان.القيمة) {
                    وجد := صواب;
                };
            }
            إذا (وجد) {
                ليكن التعليمة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
                بدّل((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات[ف], التعليمة);
                ليكن ي: متغير طبيعي = ف;
                طالما (ي + 1 < العدد) {
                    ليكن التالية: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
                    بدّل((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات[ي + 1], التالية);
                    بدّل((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات[ي], التالية);
                    ي := ي + 1;
                }
                اقتطع((*البرنامج).الدوال[د].الكتل[التمهيد].التعليمات, العدد - 1);
                ألحق((*البرنامج).الدوال[د].الكتل[الخانات].التعليمات, التعليمة);
            };
        };
    };
    تأكد_محليات_خفض_فريدة(الحالة);
    (*الحالة).المحليات[الموضع].مالك := خطأ;
    (*الحالة).المحليات[الموضع].مخزن := خطأ;
}

// The bindings of an arm, placed from المحليات[البداية] on, that a borrowed
// scrutinee (قيمة_مستعارة_عروض_خفض) makes borrowed views: those of a Type
// that needs releasing, before they are placed.
عام عرف اكتشف_عروض_ذراع_خفض(
    البرنامج: &برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    المميز: معرف_قيمة_مسير,
    البداية: طبيعي,
    أنواع_الرموز: &سياق_أنواع_رموز,
    دوال_الخفض: &سياق_دوال_خفض
): فراغ {
    إذا (!(*الحالة).يجد_العروض) { أرجع; };
    إذا (البداية >= (الطول((*الحالة).المحليات) مثل طبيعي)) { أرجع; };
    إذا (!قيمة_مستعارة_عروض_خفض(البرنامج, &(*الحالة), دوال_الخفض, المميز, صواب)) { أرجع; };
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        ليكن الرمز: معرف_رمز = (*الحالة).المحليات[ف].الرمز;
        طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
        | اختياري.موجود(النوع) -> {
            إذا (يتطلب_تحريرا_عروض_خفض(دوال_الخفض, النوع) && !هل_عرض_محلي_خفض(الحالة, الرمز)) {
                ألحق((*الحالة).العروض, الرمز);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}

// Borrowed views (docs/en/reference/ownership.md, "Borrowed views"): a local
// declared without `mutable` whose value is first given from borrowed
// storage of a Type that owns storage (a place reached through a
// dereference, or rooted at another borrowed view) is a view of that
// storage, not an owner; so is a match binding of such a Type taken from a
// borrowed scrutinee (through a dereference, rooted at a view, a member or
// element, or an immutable module value). Whether storage is borrowed is
// decided on the MSIR that reads the value (قيمة_مستعارة_عروض_خفض), as each
// such value is lowered, in the body's order: views own nothing and are never
// dropped.
عام عرف هل_عرض_محلي_خفض(الحالة: &حالة_خفض_دالة, الرمز: معرف_رمز): منطقي {
    أرجع هل_في_عروض_خفض(&(*الحالة).العروض, الرمز);
}

عرف هل_في_عروض_خفض(العروض: &متجه معرف_رمز, الرمز: معرف_رمز): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العروض) مثل طبيعي)) {
        إذا ((*العروض)[ف].القيمة == الرمز.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف يتطلب_تحريرا_عروض_خفض(دوال_الخفض: &سياق_دوال_خفض, النوع: معرف_نوع): منطقي {
    أرجع بت_استعارة_خفض(أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, النوع), 16);
}
