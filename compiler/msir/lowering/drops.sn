// Drop elaboration: automatic destruction of owned values, inserted while a
// function body is lowered (see docs/en/reference/ownership.md). Rust's MIR
// drop elaboration with dynamic drop flags is the model.
//
// Owners. A local, parameter or match binding of an owning Type
// (هل_نوع_يملك_تخزينا_مسير) that SSF did not mark as a borrowed view
// (ownership_facts.sn) owns its value. Its storage is a place allocated in the
// function's entry block, together with a boolean drop flag that is true while
// the place holds a value the local must destroy.
//   initialization or assignment   drop the old value if the flag is set,
//                                  store the new value, set the flag
//   a move SSF recorded (a value   clear the flag
//   transfer or an explicit release)
//   end of the local's block,      drop the value if the flag is set, clear it
//   break, continue
//   return                         jump to the function's exit block, which
//                                  drops every owner whose flag is set
// Other drops. An assignment to a place drops the place's old value; a call
// statement drops the owned value it discards.
//
// A drop is emitted as the release primitive (تحرير) on the value. The
// ownership-glue pass (ownership_glue.sn) rewrites each such call into the
// value Type's drop glue, so Native, LLVM and the interpreter destroy values
// with the same verified MSIR.
//
// Counted values. A function value owns a reference to its closure
// environment (هل_نوع_معدود_عادي_مسير: a function Type, or an aggregate of
// plain members and function values). The Frontend copies such a value by
// reading it, so SSF records no move of it; lowering keeps one reference per
// owner instead. Every place that takes ownership of a value — a store into a
// local or a place, an argument (parameters own their value), a return, an
// aggregate member, an appended element, a closure capture — receives a value
// with its own reference: a fresh one (a call result or a closure
// construction) is transferred, and any other read is copied through its copy
// glue (احتفظ_بقراءة_معدودة_خفض). Owners drop their reference like any other
// owned value; the last one destroys the environment.

عرف خطأ_بناء_إسقاط(الناتج: نتيجة_بناء_قيمة_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_بناء_إسقاط(الناتج: نتيجة_بناء_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ())); };
}

عرف منهي_إسقاط(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

// Emits the destruction of القيمة into الكتلة.
عرف أصدر_إسقاطا_في_كتلة(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    أرجع خطأ_بناء_إسقاط(أصدر_نداء_بدائي_مسير(
        البرنامج, البناء, الدالة, الكتلة, هوية_بدائي_مترجم.تحرير(), &الحجج,
        اختياري.لا_شيء(), اختياري.لا_شيء()
    ));
}

// Stores a boolean constant into a drop flag.
عرف اكتب_راية_في_كتلة(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الراية: معرف_قيمة_مسير,
    القيمة: منطقي,
    نوع_المنطق: معرف_نوع
): اختياري خطأ_خفض_مسير {
    دع الثابت: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_ثابتا_مسير(
        البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.منطق(القيمة), نوع_المنطق
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الثابت := المعرف; };
    أرجع خطأ_بناء_إسقاط(أصدر_تخزين_مسير(البرنامج, البناء, الدالة, الكتلة, الراية, الثابت));
}

// `if *flag { drop *slot; *flag = false }` starting in الكتلة. Returns the
// block where execution continues.
عرف أصدر_إسقاطا_مشروطا_في_كتلة(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الراية: معرف_قيمة_مسير,
    الخانة: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    نوع_المنطق: معرف_نوع
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    دع قيمة_الراية: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_تحميل_مسير(البرنامج, البناء, الدالة, الكتلة, الراية, نوع_المنطق)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { قيمة_الراية := المعرف; };
    دع كتلة_الإسقاط: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { كتلة_الإسقاط := المعرف; };
    دع كتلة_المتابعة: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { كتلة_المتابعة := المعرف; };
    دع بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    دع بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    دع إلى_الإسقاط: حافة_مسير = { الهدف: كتلة_الإسقاط, الحجج: بلا_حجج_أ };
    دع إلى_المتابعة: حافة_مسير = { الهدف: كتلة_المتابعة, الحجج: بلا_حجج_ب };
    طابق منهي_إسقاط(اختم_بفرع_شرطي_مسير(
        البرنامج, الدالة, الكتلة, قيمة_الراية, إلى_الإسقاط, إلى_المتابعة
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع القيمة: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_تحميل_مسير(البرنامج, البناء, الدالة, كتلة_الإسقاط, الخانة, النوع)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { القيمة := المعرف; };
    // The flag is cleared before the destruction runs.
    طابق اكتب_راية_في_كتلة(البرنامج, البناء, الدالة, كتلة_الإسقاط, الراية, خطأ, نوع_المنطق) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    طابق أصدر_إسقاطا_في_كتلة(البرنامج, البناء, الدالة, كتلة_الإسقاط, القيمة) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع بلا_حجج_ج: متجه معرف_قيمة_مسير = [];
    طابق منهي_إسقاط(اختم_بفرع_مسير(البرنامج, الدالة, كتلة_الإسقاط, كتلة_المتابعة, &بلا_حجج_ج)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(كتلة_المتابعة);
}

// Whether the value of التعبير has no other owner: a call result, a closure
// construction (a closure expression or a function used as a value), or a
// local whose use SSF recorded as a move (in a generic instance whose template
// treats the Type as owning), possibly through a field of such a local.
عام عرف هل_تعبير_طازج_للخفض(
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, _, _) -> { أرجع صواب; }
    | تعبير.إغلاق(_, _, _, _) -> { أرجع صواب; }
    | تعبير.حرفي_متجه(_, _) -> { أرجع صواب; }
    | تعبير.حرفي_سجل(_, _) -> { أرجع صواب; }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(_) -> { أرجع صواب; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع هل_نقل_ملكية(&(*دوال_الخفض).حقائق_الملكية, &الاسم.النطاق);
    }
    | تعبير.حقل(_, صندوق_الأصل, اسم_الحقل) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(_) -> { أرجع صواب; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        طابق *صندوق_الأصل مع
        | تعبير.اسم(_, اسم_الأصل) -> {
            أرجع هل_نقل_ملكية(&(*دوال_الخفض).حقائق_الملكية, &اسم_الأصل.النطاق);
        }
        | _ -> { أرجع هل_أصل_مؤقت_للخفض(&(*صندوق_الأصل)); };
    }
    | تعبير.فهرس(_, صندوق_الأصل, _) -> {
        أرجع هل_أصل_مؤقت_للخفض(&(*صندوق_الأصل));
    }
    | تعبير.تحويل(_, صندوق_المصدر, _) -> {
        أرجع هل_تعبير_طازج_للخفض(&(*صندوق_المصدر), روابط_الأسماء, دوال_الخفض);
    }
    | _ -> { أرجع خطأ; };
}

// Whether التعبير is a temporary no local owns: a call result or a vector
// literal expression, or a member
// or element of one. Rust's rules for temporaries apply to it (see
// أسقط_بقية_مؤقت_خفض): a member read from it is moved out, and the rest of
// the temporary is destroyed.
عام عرف هل_أصل_مؤقت_للخفض(التعبير: &تعبير): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, _, _) -> { أرجع صواب; }
    | تعبير.حرفي_متجه(_, _) -> { أرجع صواب; }
    | تعبير.حرفي_سجل(_, _) -> { أرجع صواب; }
    | تعبير.حقل(_, صندوق_الأصل, _) -> { أرجع هل_أصل_مؤقت_للخفض(&(*صندوق_الأصل)); }
    | تعبير.فهرس(_, صندوق_الأصل, _) -> { أرجع هل_أصل_مؤقت_للخفض(&(*صندوق_الأصل)); }
    | _ -> { أرجع خطأ; };
}

// A member (المنقول, the record field or tuple element ordinal) was read out
// of the temporary القيمة. An owning member is moved out, so the other owning
// members are destroyed here; a plain member is a copy, so the whole
// temporary is. Rust destroys the rest of a temporary at the end of the
// enclosing statement; nothing can name it after the member read, so
// destroying it right after the read is equivalent.
عام عرف أسقط_بقية_مؤقت_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: قيمة_خفض_مسير,
    المنقول: طبيعي,
    نوع_المنقول: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, القيمة.النوع)) { أرجع اختياري.لا_شيء(); };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_المنقول)) {
        أرجع أسقط_قيمة_خفض(البرنامج, الحالة, القيمة.المعرف, القيمة.النوع, الأنواع);
    };
    دع العدد: متغير طبيعي = 0;
    دع سجل: متغير منطقي = خطأ;
    طابق عدد_حقول_سجل_دلالي(الأنواع, القيمة.النوع) مع
    | اختياري.موجود(ع) -> { العدد := ع; سجل := صواب; }
    | اختياري.لا_شيء -> {
        طابق عدد_عناصر_صف_دلالي(الأنواع, القيمة.النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف != المنقول) {
            دع نوع_العضو: متغير اختياري معرف_نوع = اختياري.لا_شيء();
            إذا (سجل) { نوع_العضو := نوع_حقل_سجل_دلالي_عند(الأنواع, القيمة.النوع, ف); }
            وإلا { نوع_العضو := نوع_عنصر_صف_دلالي_عند(الأنواع, القيمة.النوع, ف); };
            طابق نوع_العضو مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(النوع) -> {
                إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع)) {
                    طابق قيمة_بناء_إسقاط(أصدر_استخراج_حقل_مسير(
                        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
                        القيمة.المعرف, ف, النوع
                    )) مع
                    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                    | نتيجة.نجح(العضو) -> {
                        طابق أسقط_قيمة_خفض(البرنامج, الحالة, العضو, النوع, الأنواع) مع
                        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// An element read out of a temporary vector: a vector does not let an
// element be moved out of it (Rust's E0507), so an owning element is copied
// (its copy glue) and the whole temporary vector is destroyed. Returns the
// element the reader keeps.
عام عرف أسقط_متجها_مؤقتا_بعد_عنصر_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المتجه: قيمة_خفض_مسير,
    العنصر: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): نتيجة قيمة_خفض_مسير, خطأ_خفض_مسير {
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(العنصر); }
    | اختياري.موجود(_) -> { };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, المتجه.النوع)) { أرجع نتيجة.نجح(العنصر); };
    دع المحفوظ: متغير قيمة_خفض_مسير = العنصر;
    إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, العنصر.النوع)) {
        دع الحجج: متجه معرف_قيمة_مسير = [العنصر.المعرف];
        طابق قيمة_بناء_إسقاط(أصدر_نداء_بدائي_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
            هوية_بدائي_مترجم.احتفاظ_بقيمة(), &الحجج, اختياري.موجود(العنصر.النوع), اختياري.لا_شيء()
        )) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> {
            دع النسخة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: العنصر.النوع };
            المحفوظ := النسخة;
        };
    };
    طابق أسقط_قيمة_خفض(البرنامج, الحالة, المتجه.المعرف, المتجه.النوع, الأنواع) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(المحفوظ);
}

// A counted value read from storage another owner keeps: its copy, which
// holds a reference of its own (the copy glue of the value's Type).
عام عرف انسخ_قيمة_معدودة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    القيمة: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_معدود_عادي_مسير(الأنواع, القيمة.النوع)) { أرجع نتيجة_خفض_تعبير.قيمة(القيمة); };
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة.المعرف];
    أرجع قيمة_من_بناء_للخفض(
        أصدر_نداء_بدائي_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
            هوية_بدائي_مترجم.احتفاظ_بقيمة(), &الحجج, اختياري.موجود(القيمة.النوع), اختياري.لا_شيء()
        ),
        القيمة.النوع
    );
}

// The value of التعبير, lowered to القيمة, as it enters a place that owns
// it: a counted value that is not fresh is copied (see "Counted values").
عام عرف احتفظ_بقراءة_معدودة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    القيمة: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_معدود_عادي_مسير(الأنواع, القيمة.النوع)) { أرجع نتيجة_خفض_تعبير.قيمة(القيمة); };
    إذا (هل_تعبير_طازج_للخفض(التعبير, روابط_الأسماء, دوال_الخفض)) { أرجع نتيجة_خفض_تعبير.قيمة(القيمة); };
    أرجع انسخ_قيمة_معدودة_خفض(البرنامج, الحالة, القيمة, الأنواع);
}

// Opens the drop frame of a function whose parameters are bound in
// كتلة_الدخول: that block becomes the storage prologue, the body continues in
// a fresh block, and returns jump to a fresh exit block.
عام عرف افتح_إطار_إسقاط_خفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    كتلة_الدخول: معرف_كتلة_مسير,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة إطار_إسقاط_خفض, خطأ_خفض_مسير {
    دع نوع_المنطق: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ())); };
    دع البداية: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { البداية := المعرف; };
    دع الخروج: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الخروج := المعرف; };
    دع معامل_الخروج: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    طابق نوع_الناتج مع
    | اختياري.موجود(النوع) -> {
        طابق قيمة_بناء_إسقاط(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الخروج, النوع)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { معامل_الخروج := اختياري.موجود(المعرف); };
    }
    | اختياري.لا_شيء -> { };
    دع الإطار: إطار_إسقاط_خفض = {
        التمهيد: كتلة_الدخول,
        البداية: البداية,
        الخروج: الخروج,
        معامل_الخروج: معامل_الخروج,
        نوع_المنطق: نوع_المنطق
    };
    أرجع نتيجة.نجح(الإطار);
}

// Closes the drop frame once the whole body is lowered. The prologue holds,
// for each owner in declaration order, exactly: its storage place, its flag
// place, the constant false and the flag store. The exit block destroys the
// owners in reverse order and returns; the prologue then enters the body.
// Whether any block of the function branches to the given block.
عرف كتلة_لها_سابق_للإسقاط(
    البرنامج: &برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الهدف: معرف_كتلة_مسير
): منطقي {
    دع الكتل: &متجه كتلة_مسير = &(*البرنامج).الدوال[الدالة.القيمة].الكتل;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(*الكتل) مثل طبيعي)) {
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الكتل)[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            إذا (الخلفاء[خ].القيمة == الهدف.القيمة) { أرجع صواب; };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

عام عرف اختم_إطار_إسقاط_خفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الإطار: &إطار_إسقاط_خفض
): اختياري خطأ_خفض_مسير {
    دع الخانات: متغير متجه قيمة_مسير = [];
    دع الرايات: متغير متجه معرف_قيمة_مسير = [];
    دع خانة_معلقة: متغير اختياري قيمة_مسير = اختياري.لا_شيء();
    دع د: طبيعي = الدالة.القيمة;
    دع ك: طبيعي = (*الإطار).التمهيد.القيمة;
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
        | عملية_مسير.مكان_محلي(_) -> {
            طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(الناتج) -> {
                طابق خانة_معلقة مع
                | اختياري.لا_شيء -> { خانة_معلقة := اختياري.موجود(الناتج); }
                | اختياري.موجود(الخانة) -> {
                    ألحق(الخانات, الخانة);
                    ألحق(الرايات, الناتج.المعرف);
                    خانة_معلقة := اختياري.لا_شيء();
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ت := ت + 1;
    }
    دع بلا_حجج_التمهيد: متجه معرف_قيمة_مسير = [];
    // When every path ends in a trap (for example a compile-time failure),
    // nothing reaches the exit: it has no values to destroy and must not use
    // prologue values it is not dominated by.
    إذا (!كتلة_لها_سابق_للإسقاط(البرنامج, الدالة, (*الإطار).الخروج)) {
        طابق منهي_إسقاط(اختم_بفخ_مسير(البرنامج, الدالة, (*الإطار).الخروج)) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        أرجع منهي_إسقاط(اختم_بفرع_مسير(
            البرنامج, الدالة, (*الإطار).التمهيد, (*الإطار).البداية, &بلا_حجج_التمهيد
        ));
    };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الكتلة: متغير معرف_كتلة_مسير = (*الإطار).الخروج;
    دع ف: متغير طبيعي = الطول(الخانات) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        طابق أصدر_إسقاطا_مشروطا_في_كتلة(
            البرنامج, &البناء, الدالة, الكتلة, الرايات[ف], الخانات[ف].المعرف,
            الخانات[ف].النوع, (*الإطار).نوع_المنطق
        ) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(التالية) -> { الكتلة := التالية; };
    }
    طابق منهي_إسقاط(اختم_بإرجاع_مسير(البرنامج, الدالة, الكتلة, (*الإطار).معامل_الخروج)) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    أرجع منهي_إسقاط(اختم_بفرع_مسير(
        البرنامج, الدالة, (*الإطار).التمهيد, (*الإطار).البداية, &بلا_حجج
    ));
}

// Ends the current path with a return: through the exit block when the
// function has a drop frame.
عام عرف اختم_بإرجاع_مع_إسقاط_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: اختياري معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> {
        أرجع منهي_إسقاط(اختم_بإرجاع_مسير(البرنامج, (*الحالة).الدالة, (*الحالة).الكتلة, القيمة));
    }
    | اختياري.موجود(الإطار) -> {
        دع الحجج: متغير متجه معرف_قيمة_مسير = [];
        طابق القيمة مع
        | اختياري.موجود(المعرف) -> { ألحق(الحجج, المعرف); }
        | اختياري.لا_شيء -> { };
        أرجع منهي_إسقاط(اختم_بفرع_مسير(
            البرنامج, (*الحالة).الدالة, (*الحالة).الكتلة, الإطار.الخروج, &الحجج
        ));
    };
}

// Makes the local الرمز an owner when its Type owns storage and SSF did not
// mark it a borrowed view: allocates its storage and flag in the prologue and
// moves the local into that storage. A local that already has a value (a
// parameter or a match binding) is stored there with its flag set, in the
// current block. Does nothing without a drop frame.
عام عرف سجل_مالكا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز,
    الأنواع: &سجل_أنواع,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    دع الإطار: إطار_إسقاط_خفض;
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الإطار := القيمة; };
    دع الموضع: طبيعي;
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز)); }
    | اختياري.موجود(القيمة) -> { الموضع := القيمة; };
    دع المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
    طابق المحلي.الراية مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, المحلي.النوع)) { أرجع اختياري.لا_شيء(); };
    إذا (هل_عرض_ملكية(&(*دوال_الخفض).حقائق_الملكية, &الرمز)) { أرجع اختياري.لا_شيء(); };
    دع الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    دع الخانة: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_مكان_محلي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, المحلي.النوع, صواب
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الخانة := المعرف; };
    دع الراية: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_مكان_محلي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, الإطار.نوع_المنطق, صواب
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الراية := المعرف; };
    طابق اكتب_راية_في_كتلة(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, الراية, خطأ, الإطار.نوع_المنطق
    ) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    طابق المحلي.القيمة مع
    | اختياري.موجود(القيمة) -> {
        // A bound value whose local also had a place lives in that place.
        دع الحالية: متغير معرف_قيمة_مسير = القيمة;
        طابق المحلي.المكان مع
        | اختياري.موجود(المكان) -> {
            طابق قيمة_بناء_إسقاط(أصدر_تحميل_مسير(
                البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, المكان, المحلي.النوع
            )) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(المعرف) -> { الحالية := المعرف; };
        }
        | اختياري.لا_شيء -> { };
        طابق خطأ_بناء_إسقاط(أصدر_تخزين_مسير(
            البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الخانة, الحالية
        )) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
        طابق اكتب_راية_في_كتلة(
            البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الراية, صواب, الإطار.نوع_المنطق
        ) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    تأكد_محليات_خفض_فريدة(الحالة);
    (*الحالة).المحليات[الموضع].المكان := اختياري.موجود(الخانة);
    (*الحالة).المحليات[الموضع].الراية := اختياري.موجود(الراية);
    أرجع اختياري.لا_شيء();
}

// Sets or clears the drop flag of the local الرمز, if it is an owner.
عام عرف اكتب_راية_محلي_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    القيمة: منطقي
): اختياري خطأ_خفض_مسير {
    دع الإطار: إطار_إسقاط_خفض;
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الإطار := ق; };
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        طابق (*الحالة).المحليات[الموضع].الراية مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الراية) -> {
            أرجع اكتب_راية_في_كتلة(
                البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
                الراية, القيمة, الإطار.نوع_المنطق
            );
        };
    };
}

// A local name use: when SSF recorded it as a move, the owner gives up its
// value here.
عام عرف طبق_نقل_محلي_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز,
    النطاق: &نطاق,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    إذا (!هل_نقل_ملكية(&(*دوال_الخفض).حقائق_الملكية, النطاق)) { أرجع اختياري.لا_شيء(); };
    أرجع اكتب_راية_محلي_خفض(البرنامج, الحالة, الرمز, خطأ);
}

// Drops the local at الموضع if it is an owner holding a value.
عرف أسقط_محليا_مشروطا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الموضع: طبيعي
): اختياري خطأ_خفض_مسير {
    دع الإطار: إطار_إسقاط_خفض;
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الإطار := ق; };
    دع المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
    طابق المحلي.الراية مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الراية) -> {
        طابق المحلي.المكان مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الخانة) -> {
            طابق أصدر_إسقاطا_مشروطا_في_كتلة(
                البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
                الراية, الخانة, المحلي.النوع, الإطار.نوع_المنطق
            ) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(التالية) -> {
                (*الحالة).الكتلة := التالية;
                أرجع اختياري.لا_شيء();
            };
        };
    };
}

// Drops, in reverse declaration order, the owners among the locals from
// البداية on: those of a block that ends, or of a loop body that is left.
عام عرف أسقط_محليات_من_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    البداية: طبيعي
): اختياري خطأ_خفض_مسير {
    إذا (!(*الحالة).نشطة) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    طالما (ف > البداية) {
        ف := ف - 1;
        طابق أسقط_محليا_مشروطا_خفض(البرنامج, الحالة, ف) مع
        | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
        | اختياري.لا_شيء -> { };
    }
    أرجع اختياري.لا_شيء();
}

// Before a value is stored into the local الرمز: an owner first destroys the
// value it holds. After the store, أكمل_إسناد_محلي_خفض sets its flag.
عام عرف أسقط_قبل_إسناد_محلي_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز
): اختياري خطأ_خفض_مسير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> { أرجع أسقط_محليا_مشروطا_خفض(البرنامج, الحالة, الموضع); };
}

عام عرف أكمل_إسناد_محلي_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): اختياري خطأ_خفض_مسير {
    أرجع اكتب_راية_محلي_خفض(البرنامج, الحالة, الرمز, صواب);
}

// Destroys an owned value that no local holds: the old value of an assigned
// place, or the result a call statement discards. Only in a function with a
// drop frame, and only for an owning Type.
عام عرف أسقط_قيمة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    أرجع أصدر_إسقاطا_في_كتلة(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, القيمة
    );
}

// Before a value is stored into a place that already holds one: the old value
// is loaded and destroyed.
عام عرف أسقط_قيمة_مكان_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المكان: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    دع القديمة: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المكان, النوع
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { القديمة := المعرف; };
    أرجع أصدر_إسقاطا_في_كتلة(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, القديمة
    );
}

// An owner with no source name: a temporary the lowering must destroy, such
// as a match scrutinee produced by a call. It is registered like a local owner
// (storage and flag in the prologue, value stored and flag set here), under a
// synthetic symbol that no name resolves to, so block ends, break/continue
// and the exit block destroy it.
عام عرف سجل_مالكا_مؤقتا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع الإطار: إطار_إسقاط_خفض;
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الإطار := ق; };
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع)) { أرجع اختياري.لا_شيء(); };
    دع الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    دع الخانة: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_مكان_محلي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, النوع, صواب
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الخانة := المعرف; };
    دع الراية: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(أصدر_مكان_محلي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, الإطار.نوع_المنطق, صواب
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الراية := المعرف; };
    طابق اكتب_راية_في_كتلة(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.التمهيد, الراية, خطأ, الإطار.نوع_المنطق
    ) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    طابق خطأ_بناء_إسقاط(أصدر_تخزين_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الخانة, القيمة
    )) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    طابق اكتب_راية_في_كتلة(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الراية, صواب, الإطار.نوع_المنطق
    ) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    تأكد_محليات_خفض_فريدة(الحالة);
    دع الرمز: معرف_رمز = معرف_رمز_مركب_من(الطول((*الحالة).المحليات) مثل طبيعي);
    دع المحلي: ربط_محلي_خفض = {
        الرمز: الرمز, النوع: النوع, القيمة: اختياري.لا_شيء(),
        المكان: اختياري.موجود(الخانة), الراية: اختياري.موجود(الراية)
    };
    ألحق((*الحالة).المحليات, المحلي);
    أرجع اختياري.لا_شيء();
}

// Destructuring an owned value. A match arm whose bindings move parts out of
// an owned scrutinee (an owner local, or a temporary) consumes it: the
// scrutinee no longer owns anything, so every part of it that no owning
// binding takes is destroyed on entry to the arm, exactly once. That covers a
// wildcard (`_`), a record field the pattern omits, a literal or range
// sub-pattern, a part bound only through plain or counted bindings (a counted
// binding holds a copy of its own, so the scrutinee's reference is released),
// and the unbound parts of nested record, tuple and constructor patterns.
// Nothing can name the consumed scrutinee in the arm, so destroying the parts
// on entry is equivalent to destroying them when the arm ends, and holds on
// every path out of the arm (a return, break or continue included). An arm
// that moves nothing leaves the scrutinee with its owner, and a scrutinee
// matched through a reference is never destroyed here.

// A binding of this Type owns its value (it becomes a drop-flagged owner).
عرف نوع_ربط_مالك_خفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_يملك_تخزينا_مسير(الأنواع, النوع) && !هل_نوع_معدود_عادي_مسير(الأنواع, النوع);
}

// Whether the pattern binds an owner anywhere.
عام عرف هل_نمط_يربط_مالكا_خفض(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    الأنواع: &سجل_أنواع,
    النمط: معرف_نمط
): منطقي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الدلالي) -> {
        طابق الدلالي مع
        | نمط_دلالي.ربط(_, _) -> {
            طابق نوع_عقدة_نمط_عند(التحقق, النمط) مع
            | اختياري.موجود(النوع) -> { أرجع نوع_ربط_مالك_خفض(الأنواع, النوع); }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | نمط_دلالي.بدائل(_, الأبناء) -> {
            أرجع أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء);
        }
        | نمط_دلالي.صف(_, الأبناء) -> {
            أرجع أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء);
        }
        | نمط_دلالي.منشئ(_, _, الأبناء) -> {
            أرجع أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء);
        }
        | نمط_دلالي.سجل(_, الحقول) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقول) مثل طبيعي)) {
                إذا (هل_نمط_يربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, الحقول[ف].النمط)) {
                    أرجع صواب;
                };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف أنماط_تربط_مالكا_خفض(
    التحقق: &تحقق_نمط_نوعي,
    سجل_الأنماط: &سجل_أنماط,
    الأنواع: &سجل_أنواع,
    الأنماط: &متجه معرف_نمط
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأنماط) مثل طبيعي)) {
        إذا (هل_نمط_يربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, (*الأنماط)[ف])) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// One part of القيمة: the payload at الفهرس of the matched constructor
// (المنشئ is its ordinal), or else the record field or tuple element at
// الفهرس. It is extracted only when its Type owns storage; with a
// sub-pattern its unbound parts are destroyed, without one (a record field
// the pattern omits) the whole part is.
عرف أسقط_جزءا_غير_مربوط_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    النمط_الفرعي: اختياري معرف_نمط,
    القيمة: قيمة_خفض_مسير,
    المنشئ: اختياري طبيعي,
    الفهرس: طبيعي,
    نوع_الجزء: معرف_نوع,
    الأنواع: &سجل_أنواع,
    سجل_الأنماط: &سجل_أنماط
): اختياري خطأ_خفض_مسير {
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_الجزء)) { أرجع اختياري.لا_شيء(); };
    دع الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    دع الكتلة: معرف_كتلة_مسير = (*الحالة).الكتلة;
    دع الناتج: متغير نتيجة_بناء_قيمة_مسير = نتيجة_بناء_قيمة_مسير.بلا_قيمة();
    طابق المنشئ مع
    | اختياري.موجود(الترتيب) -> {
        الناتج := أصدر_استخراج_حمولة_مسير(
            البرنامج, &(*الحالة).البناء, الدالة, الكتلة,
            القيمة.المعرف, الترتيب, الفهرس, نوع_الجزء
        );
    }
    | اختياري.لا_شيء -> {
        الناتج := أصدر_استخراج_حقل_مسير(
            البرنامج, &(*الحالة).البناء, الدالة, الكتلة,
            القيمة.المعرف, الفهرس, نوع_الجزء
        );
    };
    دع الجزء: معرف_قيمة_مسير;
    طابق قيمة_بناء_إسقاط(الناتج) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الجزء := المعرف; };
    دع قيمة_الجزء: قيمة_خفض_مسير = { المعرف: الجزء, النوع: نوع_الجزء };
    طابق النمط_الفرعي مع
    | اختياري.موجود(الابن) -> {
        أرجع أسقط_أجزاء_غير_مربوطة_خفض(
            البرنامج, الحالة, التحقق, الابن, قيمة_الجزء, الأنواع, سجل_الأنماط
        );
    }
    | اختياري.لا_شيء -> {
        أرجع أسقط_قيمة_خفض(البرنامج, الحالة, الجزء, نوع_الجزء, الأنواع);
    };
}

// Destroys, in the current block, every part of القيمة (matched by النمط)
// that no owning binding of النمط takes.
عام عرف أسقط_أجزاء_غير_مربوطة_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط,
    القيمة: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع,
    سجل_الأنماط: &سجل_أنماط
): اختياري خطأ_خفض_مسير {
    إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, القيمة.النوع)) { أرجع اختياري.لا_شيء(); };
    دع الدلالي: نمط_دلالي;
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الدلالي := ق; };
    طابق الدلالي مع
    | نمط_دلالي.ربط(_, _) -> {
        // The binding owns the whole value; a plain or counted one copied it.
        إذا (نوع_ربط_مالك_خفض(الأنواع, القيمة.النوع)) { أرجع اختياري.لا_شيء(); };
    }
    | نمط_دلالي.بدائل(_, الأبناء) -> {
        // Which alternative matched is not known here, so a value one of them
        // binds an owner of is left to that binding.
        إذا (أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء)) {
            أرجع اختياري.لا_شيء();
        };
    }
    | نمط_دلالي.منشئ(_, _, الأبناء) -> {
        إذا (أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء)) {
            دع الترتيب: طبيعي;
            طابق هوية_منشئ_نمط_محلولة_عند(التحقق, النمط) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الهوية) -> {
                طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, القيمة.النوع, الهوية) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الوسم) -> { الترتيب := الوسم; };
            };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
                طابق نوع_عقدة_نمط_عند(التحقق, الأبناء[ف]) مع
                | اختياري.موجود(نوع_الحمولة) -> {
                    طابق أسقط_جزءا_غير_مربوط_خفض(
                        البرنامج, الحالة, التحقق, اختياري.موجود(الأبناء[ف]), القيمة,
                        اختياري.موجود(الترتيب), ف, نوع_الحمولة, الأنواع, سجل_الأنماط
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    }
    | نمط_دلالي.صف(_, الأبناء) -> {
        إذا (أنماط_تربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, &الأبناء)) {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
                طابق نوع_عقدة_نمط_عند(التحقق, الأبناء[ف]) مع
                | اختياري.موجود(نوع_العنصر) -> {
                    طابق أسقط_جزءا_غير_مربوط_خفض(
                        البرنامج, الحالة, التحقق, اختياري.موجود(الأبناء[ف]), القيمة,
                        اختياري.لا_شيء(), ف, نوع_العنصر, الأنواع, سجل_الأنماط
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    }
    | نمط_دلالي.سجل(_, الحقول) -> {
        إذا (هل_نمط_يربط_مالكا_خفض(التحقق, سجل_الأنماط, الأنواع, النمط)) {
            // Every field of the Type, the ones the pattern omits included.
            دع العدد: طبيعي;
            طابق عدد_حقول_سجل_دلالي(الأنواع, القيمة.النوع) مع
            | اختياري.موجود(ع) -> { العدد := ع; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                دع الفرعي: متغير اختياري معرف_نمط = اختياري.لا_شيء();
                دع نوع_الحقل: متغير اختياري معرف_نوع = نوع_حقل_سجل_دلالي_عند(
                    الأنواع, القيمة.النوع, ف
                );
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحقول) مثل طبيعي)) {
                    طابق ترتيب_حقل_سجل_دلالي_بالاسم(الأنواع, القيمة.النوع, الحقول[ح].الاسم) مع
                    | اختياري.موجود(الترتيب) -> {
                        إذا (الترتيب == ف) {
                            الفرعي := اختياري.موجود(الحقول[ح].النمط);
                            نوع_الحقل := نوع_عقدة_نمط_عند(التحقق, الحقول[ح].النمط);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ح := ح + 1;
                }
                طابق نوع_الحقل مع
                | اختياري.موجود(النوع) -> {
                    طابق أسقط_جزءا_غير_مربوط_خفض(
                        البرنامج, الحالة, التحقق, الفرعي, القيمة,
                        اختياري.لا_شيء(), ف, النوع, الأنواع, سجل_الأنماط
                    ) مع
                    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 1;
            }
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> { };
    // Nothing in the value is bound to an owner: all of it is destroyed.
    أرجع أسقط_قيمة_خفض(البرنامج, الحالة, القيمة.المعرف, القيمة.النوع, الأنواع);
}
