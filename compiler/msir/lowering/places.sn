استورد compiler.frontend.types.type_context;
// MSIR place construction. Recursive AST traversal stays in expressions.sn so the
// lowering import graph remains acyclic; all concrete place/address/load emission lives here.
عام عرف اخفض_مكان_اسم_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الاسم: &اسم,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_خفض_مكان {
    طابق رمز_اسم_للخفض(روابط_الأسماء, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
    }
    | نتيجة.نجح(الرمز) -> {
        طابق موضع_محلي_خفض(الحالة, الرمز) مع
        | اختياري.لا_شيء -> {
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
            }
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.ثابت(_) -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                // Built where it is read: its place is a temporary's
                // (هل_اسم_ثابت_وحدة_للخفض), never this one.
                | هدف_قيمة_عليا_خفض.موسوم(_) -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | هدف_قيمة_عليا_خفض.عام(العام) -> {
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    طابق أصدر_مكان_عام_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        العام,
                        الربط.النوع,
                        الربط.قابل_للكتابة
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                        ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: الربط.النوع };
                        أرجع نتيجة_خفض_مكان.مكان(المكان);
                    }
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                };
            };
        }
        | اختياري.موجود(الموضع) -> {
            ليكن المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
            طابق المحلي.المكان مع
            | اختياري.موجود(المعرف) -> {
                // Its members are read through the place from now on.
                إذا (!المحلي.مخزن) {
                    تأكد_محليات_خفض_فريدة(الحالة);
                    (*الحالة).المحليات[الموضع].مخزن := صواب;
                };
                ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: المحلي.النوع };
                أرجع نتيجة_خفض_مكان.مكان(المكان);
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            };
        };
    };
}

// Whether an index into a value of this Type is bounds-checked: vectors and
// text own a length. Raw pointers are indexed only in unsafe code.
عام عرف نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.نص(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether the Type is a vector (not text, a slice or a pointer).
عام عرف هل_نوع_متجه_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// index < length, compared as unsigned 64-bit values (a negative index is
// out of range). An index outside the value traps: the program stops instead
// of reading or writing memory it does not own.
عرف تحقق_حدود_فهرس_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن القيمة_المحملة: متغير معرف_قيمة_مسير = قيمة_الفهرس.المعرف;
    طابق أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, مكان_الأصل.المعرف, مكان_الأصل.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { القيمة_المحملة := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    أرجع تحقق_حدود_فهرس_قيمة_للخفض(البرنامج, الحالة, النطاق, القيمة_المحملة, قيمة_الفهرس, الأنواع);
}

// The same check on a vector or text value (an index read).
عام عرف تحقق_حدود_فهرس_قيمة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    القيمة_المحملة: معرف_قيمة_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن نوع_العدد: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_ط64: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_المنطق: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن وصف_الفهرس: متغير وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, قيمة_الفهرس.النوع) مع
    | اختياري.موجود(الوصف) -> { وصف_الفهرس := الوصف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (وصف_الفهرس.البتات == 0 || وصف_الفهرس.البتات > 64) { أرجع اختياري.لا_شيء(); };

    ليكن الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    ليكن الكتلة: معرف_كتلة_مسير = (*الحالة).الكتلة;
    ليكن حجج_الطول: متغير متجه معرف_قيمة_مسير = [];
    ألحق(حجج_الطول, القيمة_المحملة);
    ليكن الطول_الموقع: متغير معرف_قيمة_مسير = القيمة_المحملة;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, هوية_بدائي_مترجم.طول(), حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الطول_الموقع := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن الطول: متغير معرف_قيمة_مسير = الطول_الموقع;
    طابق أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الطول := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن الفهرس: متغير معرف_قيمة_مسير = قيمة_الفهرس.المعرف;
    إذا (!معرفا_نوع_متساويان(قيمة_الفهرس.النوع, نوع_ط64)) {
        ليكن العملية: متغير عملية_تحويل_صحيح = عملية_تحويل_صحيح.إعادة_تفسير();
        إذا (وصف_الفهرس.البتات < 64) {
            إذا (وصف_الفهرس.موقع) { العملية := عملية_تحويل_صحيح.توسيع_بإشارة(); }
            وإلا { العملية := عملية_تحويل_صحيح.توسيع_صفري(); };
        };
        طابق أصدر_تحويل_صحيح_مسير(
            البرنامج, &(*الحالة).البناء, الدالة, الكتلة, العملية, قيمة_الفهرس.المعرف, نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الفهرس := ق; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    };
    ليكن الشرط: متغير معرف_قيمة_مسير = الفهرس;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أصغر(), الفهرس, الطول, نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الشرط := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    أرجع اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, الشرط, الفهرس, الطول, 1);
}

// Goes on in a new block when الشرط holds, and traps otherwise; the trap
// reports the kind الصنف with الأول and الثاني (an index and the length) and
// the place النطاق once runtime checks are lowered (msir/runtime_checks.sn).
عام عرف اختم_فحص_حدود_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الشرط: معرف_قيمة_مسير,
    الأول: معرف_قيمة_مسير,
    الثاني: معرف_قيمة_مسير,
    الصنف: عدد
): اختياري خطأ_خفض_مسير {
    ليكن الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    ليكن الكتلة: معرف_كتلة_مسير = (*الحالة).الكتلة;
    ليكن داخل_الحدود: متغير معرف_كتلة_مسير = الكتلة;
    ليكن خارج_الحدود: متغير معرف_كتلة_مسير = الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { داخل_الحدود := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { خارج_الحدود := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    ليكن بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    ليكن إلى_الداخل: حافة_مسير = { الهدف: داخل_الحدود, الحجج: بلا_حجج_أ };
    ليكن إلى_الخارج: حافة_مسير = { الهدف: خارج_الحدود, الحجج: بلا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(البرنامج, &(*الحالة).البناء, الدالة, الكتلة, الشرط, إلى_الداخل, إلى_الخارج) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    طابق اختم_بفخ_مسير(البرنامج, &(*الحالة).البناء, الدالة, خارج_الحدود) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    ليكن موقع_الفحص: موقع_فحص_تشغيل_مسير = {
        الدالة: الدالة, الكتلة: اختياري.موجود(خارج_الحدود), القيمة: الأول, الطول: الثاني, الصنف: الصنف,
        المصدر: النطاق.البداية.المصدر, البايت: النطاق.البداية.البايت
    };
    ألحق((*البرنامج).مواقع_فحوص_التشغيل, موقع_الفحص);
    (*الحالة).الكتلة := داخل_الحدود;
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_مكان_فهرس_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    إذا (نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع, مكان_الأصل.النوع)) {
        طابق تحقق_حدود_فهرس_للخفض(البرنامج, الحالة, النطاق, مكان_الأصل, قيمة_الفهرس, الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق أصدر_مكان_فهرس_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        مكان_الأصل.المعرف,
        قيمة_الفهرس.المعرف,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_مكان.مكان(المكان);
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عرف نوع_قيمة_عنصر_مؤشر_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): اختياري معرف_نوع {
    ليكن سجل_الأنواع: سجل_أنواع = *الأنواع;
    طابق معرف_نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            إذا ((نوع_العنصر.القيمة مثل طبيعي) >= (الطول(سجل_الأنواع.الأنواع) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            ليكن مرجع_النوع: &نوع_مقنن = &سجل_الأنواع.الأنواع[نوع_العنصر.القيمة];
            طابق *مرجع_النوع مع
            | نوع_مقنن.متغير(الداخل) -> {
                أرجع اختياري.موجود(الداخل);
            }
            | _ -> {
                أرجع اختياري.موجود(نوع_العنصر);
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    قيمة_المؤشر: قيمة_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    نوع_التعبير: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    طابق نوع_قيمة_عنصر_مؤشر_للخفض(الأنواع, قيمة_المؤشر.النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_المؤشر.النوع)
        );
    }
    | اختياري.موجود(نوع_العنصر) -> {
        إذا (!نوعان_متوافقان(الأنواع, نوع_التعبير, نوع_العنصر)) {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_التعبير)
            );
        };
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق أصدر_موضع_تخزين_عنصر_مؤشر_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            قيمة_المؤشر.المعرف,
            قيمة_الفهرس.المعرف,
            نوع_العنصر
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            ليكن موضع_التخزين: مكان_خفض_مسير = { المعرف: المعرف, النوع: نوع_العنصر };
            أرجع نتيجة_خفض_مكان.مكان(موضع_التخزين);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عام عرف اخفض_مكان_حقل_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    اسم_الحقل: &اسم,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء
): نتيجة_خفض_مكان {
    ليكن قيمة_اسم_الحقل: اسم = *اسم_الحقل;
    ليكن هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(روابط_الأسماء, قيمة_اسم_الحقل.النطاق) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.ربط_اسم_مفقود(قيمة_اسم_الحقل.النطاق));
    }
    | اختياري.موجود(المعرف) -> {
        هوية_الحقل := المعرف;
    };
    طابق وصف_حقل_سجل_دلالي_بالاسم(الأنواع, مكان_الأصل.النوع, هوية_الحقل) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, مكان_الأصل.النوع)
        );
    }
    | اختياري.موجود(الوصف) -> {
        إذا (!نوعان_متوافقان(الأنواع, الوصف.النوع, النوع)) {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق أصدر_مكان_حقل_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            مكان_الأصل.المعرف,
            الوصف.الترتيب,
            الوصف.النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: الوصف.النوع };
            أرجع نتيجة_خفض_مكان.مكان(المكان);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عام عرف اخفض_مكان_فك_مرجع_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    قيمة_المرجع: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق نوع_حمولة_صندوق_دلالي(الأنواع, قيمة_المرجع.النوع) مع
    | اختياري.موجود(_) -> {
        طابق أصدر_صندوق_إلى_مكان_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            قيمة_المرجع.المعرف,
            النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
            أرجع نتيجة_خفض_مكان.مكان(المكان);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    }
    | اختياري.لا_شيء -> { };
    // A raw pointer is not a reference. Lower *pointer as pointer[0],
    // preserving the canonical pointer-element place and MSIR type contract.
    طابق نوع_قيمة_عنصر_مؤشر_للخفض(الأنواع, قيمة_المرجع.النوع) مع
    | اختياري.موجود(_) -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_المرجع.النوع)
            );
        }
        | اختياري.موجود(نوع_الفهرس) -> {
            طابق أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                ثابت_مسير.صحيح_طبيعي(0),
                نوع_الفهرس
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(معرف_الفهرس) -> {
                ليكن الفهرس: قيمة_خفض_مسير = {
                    المعرف: معرف_الفهرس,
                    النوع: نوع_الفهرس
                };
                أرجع اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
                    البرنامج,
                    الحالة,
                    النطاق,
                    قيمة_المرجع,
                    الفهرس,
                    النوع,
                    الأنواع
                );
            }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع نتيجة_خفض_مكان.مرفوض(
                    خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                );
            }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
        };
    }
    | اختياري.لا_شيء -> { };
    طابق أصدر_مرجع_إلى_مكان_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        قيمة_المرجع.المعرف,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_مكان.مكان(المكان);
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عام عرف اخفض_تحميل_مكان_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المكان: مكان_خفض_مسير
): نتيجة_خفض_تعبير {
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_تحميل_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المكان.المعرف,
            المكان.النوع
        ),
        المكان.النوع
    );
}

عام عرف اخفض_مرجع_مكان_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المكان: مكان_خفض_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مكان_إلى_مرجع_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المكان.المعرف,
            النوع
        ),
        النوع
    );
}

// The value of a built instruction, or the lowering error for it.
عرف معرف_مبني_للخفض(النتيجة: نتيجة_بناء_قيمة_مسير, النطاق: نطاق): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
}

// An integer value as a 64-bit unsigned one: widened by its sign, or
// reinterpreted (a negative value becomes a large one, past every length).
عرف قيمة_ط64_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    القيمة: قيمة_خفض_مسير,
    نوع_ط64: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    إذا (معرفا_نوع_متساويان(القيمة.النوع, نوع_ط64)) { أرجع نتيجة.نجح(القيمة.المعرف); };
    ليكن العملية: متغير عملية_تحويل_صحيح = عملية_تحويل_صحيح.إعادة_تفسير();
    طابق وصف_صحيح_للخفض(الأنواع, القيمة.النوع) مع
    | اختياري.موجود(الوصف) -> {
        إذا (الوصف.البتات < 64) {
            إذا (الوصف.موقع) { العملية := عملية_تحويل_صحيح.توسيع_بإشارة(); }
            وإلا { العملية := عملية_تحويل_صحيح.توسيع_صفري(); };
        };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    أرجع معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, العملية, القيمة.المعرف, نوع_ط64
    ), النطاق);
}

// A byte offset of a slice of text `&s[a..b]` (its start a, or b + 1 past
// its end), already within [0, length], must fall on a character's
// boundary: the text's length, or a byte that does not continue a UTF-8
// character (not 0b10xxxxxx). المصدر is the text's header. When the program
// runs a failed check reports the offset and the place (kind 9). Lowering
// goes on in the block where the offset is a boundary.
عرف اختم_فحص_حد_حرف_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: معرف_قيمة_مسير,
    الإزاحة: معرف_قيمة_مسير,
    الطول: معرف_قيمة_مسير,
    نوع_المنطق: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن نوع_البايت: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8()) مع
    | اختياري.موجود(ن) -> { نوع_البايت := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    // The length itself is a boundary.
    ليكن عند_الطول: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, عملية_مقارنة_صحيح.يساوي(),
        الإزاحة, الطول, نوع_المنطق
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { عند_الطول := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن كتلة_البايت: متغير معرف_كتلة_مسير = (*الحالة).الكتلة;
    ليكن كتلة_الحد: متغير معرف_كتلة_مسير = (*الحالة).الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { كتلة_البايت := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { كتلة_الحد := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    ليكن بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    ليكن إلى_الحد: حافة_مسير = { الهدف: كتلة_الحد, الحجج: بلا_حجج_أ };
    ليكن إلى_البايت: حافة_مسير = { الهدف: كتلة_البايت, الحجج: بلا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, عند_الطول, إلى_الحد, إلى_البايت
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    // Inside the text: the byte at the offset starts a character.
    (*الحالة).الكتلة := كتلة_البايت;
    ليكن البايت: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_استخراج_فهرس_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, كتلة_البايت, المصدر, الإزاحة, نوع_البايت
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { البايت := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن القناع: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_ثابتا_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, كتلة_البايت, ثابت_مسير.صحيح_طبيعي(192), نوع_البايت
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { القناع := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن التتمة: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_ثابتا_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, كتلة_البايت, ثابت_مسير.صحيح_طبيعي(128), نوع_البايت
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { التتمة := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن الأعلى_بتين: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, كتلة_البايت, عملية_حساب_صحيح.و_بتي(), البايت, القناع, نوع_البايت
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الأعلى_بتين := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    ليكن يبدأ_حرفا: متغير معرف_قيمة_مسير = الإزاحة;
    طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, كتلة_البايت, عملية_مقارنة_صحيح.لا_يساوي(),
        الأعلى_بتين, التتمة, نوع_المنطق
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { يبدأ_حرفا := ق; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    طابق اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, يبدأ_حرفا, الإزاحة, الطول, 9) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    ليكن بلا_حجج_ج: متجه معرف_قيمة_مسير = [];
    طابق اختم_بفرع_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, كتلة_الحد, بلا_حجج_ج
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    (*الحالة).الكتلة := كتلة_الحد;
    أرجع اختياري.لا_شيء();
}

// `v[a..b]`, `v[a..]`, `v[..b]`, `v[..]`: the slice of the elements a through
// b of المصدر (a vector or a slice), both ends included, without a copy
// (مقطع_تسلسل). An absent start is 0 and an absent end the last element.
// When the program runs, each written bound is checked as an index is
// (lowering/places.sn): 0 <= a <= length (a = length gives the empty slice),
// -1 <= b < length, and b >= a - 1 (b = a - 1 is the empty slice); a failed
// check reports the slice's start, its end or both, and the place. A slice of
// text (النوع `&string`, المصدر the text's header) also checks that its start
// a and b + 1 past its end fall on character boundaries (kind 9,
// اختم_فحص_حد_حرف_للخفض); an absent start or end is one.
عام عرف أصدر_مقطعا_مفحوصا_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    الأدنى: اختياري قيمة_خفض_مسير,
    الأعلى: اختياري قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن نوع_العدد: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_ط64: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_المنطق: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    // The length, as a 64-bit unsigned value.
    ليكن حجج_الطول: متجه معرف_قيمة_مسير = [المصدر.المعرف];
    ليكن الطول_العددي: متغير معرف_قيمة_مسير = المصدر.المعرف;
    طابق معرف_مبني_للخفض(أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, هوية_بدائي_مترجم.طول(), حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الطول_العددي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الطول: متغير معرف_قيمة_مسير = الطول_العددي;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        الطول_العددي, نوع_ط64
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الطول := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };

    // The start: 0 <= a <= length.
    ليكن البداية: متغير معرف_قيمة_مسير = الطول;
    ليكن له_بداية: متغير منطقي = خطأ;
    طابق الأدنى مع
    | اختياري.موجود(القيمة) -> {
        له_بداية := صواب;
        طابق قيمة_ط64_للخفض(البرنامج, الحالة, النطاق, القيمة, نوع_ط64, الأنواع) مع
        | نتيجة.نجح(ق) -> { البداية := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        ليكن الشرط: متغير معرف_قيمة_مسير = البداية;
        طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_مقارنة_صحيح.أصغر_أو_يساوي(),
            البداية, الطول, نوع_المنطق
        ), النطاق) مع
        | نتيجة.نجح(ق) -> { الشرط := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        طابق اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, الشرط, البداية, الطول, 5) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> {
        طابق معرف_مبني_للخفض(أصدر_ثابتا_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, ثابت_مسير.صحيح_طبيعي(0), نوع_ط64
        ), النطاق) مع
        | نتيجة.نجح(ق) -> { البداية := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    };

    // The end, one past the last element: -1 <= b < length, b >= a - 1.
    ليكن النهاية: متغير معرف_قيمة_مسير = الطول;
    ليكن له_نهاية: متغير منطقي = خطأ;
    طابق الأعلى مع
    | اختياري.موجود(القيمة) -> {
        له_نهاية := صواب;
        ليكن الأخير: متغير معرف_قيمة_مسير = الطول;
        طابق قيمة_ط64_للخفض(البرنامج, الحالة, النطاق, القيمة, نوع_ط64, الأنواع) مع
        | نتيجة.نجح(ق) -> { الأخير := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        ليكن الواحد: متغير معرف_قيمة_مسير = الطول;
        طابق معرف_مبني_للخفض(أصدر_ثابتا_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, ثابت_مسير.صحيح_طبيعي(1), نوع_ط64
        ), النطاق) مع
        | نتيجة.نجح(ق) -> { الواحد := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        // b + 1, wrapping: b = -1 gives 0.
        طابق معرف_مبني_للخفض(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_حساب_صحيح.جمع_ملتف(),
            الأخير, الواحد, نوع_ط64
        ), النطاق) مع
        | نتيجة.نجح(ق) -> { النهاية := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        // A signed end may be -1 (b + 1 <= length); an unsigned one is an
        // index (b < length), so its largest value does not wrap to 0.
        ليكن موقع: متغير منطقي = صواب;
        طابق وصف_صحيح_للخفض(الأنواع, القيمة.النوع) مع
        | اختياري.موجود(الوصف) -> { موقع := الوصف.موقع; }
        | اختياري.لا_شيء -> { };
        ليكن الشرط: متغير معرف_قيمة_مسير = النهاية;
        ليكن المقارنة: متغير عملية_مقارنة_صحيح = عملية_مقارنة_صحيح.أصغر_أو_يساوي();
        ليكن المقارن: متغير معرف_قيمة_مسير = النهاية;
        إذا (!موقع) {
            المقارنة := عملية_مقارنة_صحيح.أصغر();
            المقارن := الأخير;
        };
        طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المقارنة, المقارن, الطول, نوع_المنطق
        ), النطاق) مع
        | نتيجة.نجح(ق) -> { الشرط := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        طابق اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, الشرط, الأخير, الطول, 6) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        // Both written: the end is not before the start (a <= b + 1); both
        // are now within [0, length].
        إذا (له_بداية) {
            ليكن شرط_الترتيب: متغير معرف_قيمة_مسير = النهاية;
            طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
                البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_مقارنة_صحيح.أصغر_أو_يساوي(),
                البداية, النهاية, نوع_المنطق
            ), النطاق) مع
            | نتيجة.نجح(ق) -> { شرط_الترتيب := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            طابق اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, شرط_الترتيب, البداية, الأخير, 7) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };

    // A slice of text cuts no character in two.
    إذا (هل_مرجع_نص_مشترك_دلالي(الأنواع, النوع)) {
        إذا (له_بداية) {
            طابق اختم_فحص_حد_حرف_للخفض(
                البرنامج, الحالة, النطاق, المصدر.المعرف, البداية, الطول, نوع_المنطق, الأنواع
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
        };
        إذا (له_نهاية) {
            طابق اختم_فحص_حد_حرف_للخفض(
                البرنامج, الحالة, النطاق, المصدر.المعرف, النهاية, الطول, نوع_المنطق, الأنواع
            ) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
        };
    };

    // The slice: its start and its length (end - start) as `int`.
    ليكن العدد_ط64: متغير معرف_قيمة_مسير = النهاية;
    طابق معرف_مبني_للخفض(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_حساب_صحيح.طرح_ملتف(),
        النهاية, البداية, نوع_ط64
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { العدد_ط64 := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن البداية_العددية: متغير معرف_قيمة_مسير = البداية;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        البداية, نوع_العدد
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { البداية_العددية := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن العدد: متغير معرف_قيمة_مسير = العدد_ط64;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        العدد_ط64, نوع_العدد
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { العدد := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    طابق معرف_مبني_للخفض(أصدر_مقطع_تسلسل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المصدر.المعرف, البداية_العددية, العدد, النوع
    ), النطاق) مع
    | نتيجة.نجح(ق) -> {
        ليكن الناتج: قيمة_خفض_مسير = { المعرف: ق, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(الناتج);
    }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
}

// `split_mutable(&mutable v, i)`: the pair of the elements of المصدر before i
// and from i on (two subslices, no copy), of the pair Type النوع. When the
// program runs 0 <= i <= length is checked; a failed check reports the split
// index, the length and the place (kind 8).
عام عرف أصدر_قسمة_مفحوصة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    الموقع: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن نوع_العدد: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_ط64: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_المنطق: متغير معرف_نوع = معرف_نوع_من(0);
    ليكن نوع_الشريحة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, 0) مع
    | اختياري.موجود(ن) -> { نوع_الشريحة := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    // The length and the split index, as 64-bit unsigned values.
    ليكن حجج_الطول: متجه معرف_قيمة_مسير = [المصدر.المعرف];
    ليكن الطول_العددي: متغير معرف_قيمة_مسير = المصدر.المعرف;
    طابق معرف_مبني_للخفض(أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, هوية_بدائي_مترجم.طول(), حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الطول_العددي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الطول: متغير معرف_قيمة_مسير = الطول_العددي;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        الطول_العددي, نوع_ط64
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الطول := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الحد: متغير معرف_قيمة_مسير = الطول;
    طابق قيمة_ط64_للخفض(البرنامج, الحالة, النطاق, الموقع, نوع_ط64, الأنواع) مع
    | نتيجة.نجح(ق) -> { الحد := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الشرط: متغير معرف_قيمة_مسير = الحد;
    طابق معرف_مبني_للخفض(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_مقارنة_صحيح.أصغر_أو_يساوي(),
        الحد, الطول, نوع_المنطق
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الشرط := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    طابق اختم_فحص_حدود_للخفض(البرنامج, الحالة, النطاق, الشرط, الحد, الطول, 8) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    // left = [0, i), right = [i, length).
    ليكن الصفر: متغير معرف_قيمة_مسير = الحد;
    طابق معرف_مبني_للخفض(أصدر_ثابتا_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, ثابت_مسير.صحيح_موقع(0), نوع_العدد
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الصفر := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الحد_العددي: متغير معرف_قيمة_مسير = الحد;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        الحد, نوع_العدد
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الحد_العددي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الباقي_ط64: متغير معرف_قيمة_مسير = الطول;
    طابق معرف_مبني_للخفض(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_حساب_صحيح.طرح_ملتف(),
        الطول, الحد, نوع_ط64
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الباقي_ط64 := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الباقي: متغير معرف_قيمة_مسير = الباقي_ط64;
    طابق معرف_مبني_للخفض(أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(),
        الباقي_ط64, نوع_العدد
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { الباقي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن اليسار: متغير معرف_قيمة_مسير = الحد;
    طابق معرف_مبني_للخفض(أصدر_مقطع_تسلسل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المصدر.المعرف, الصفر, الحد_العددي,
        نوع_الشريحة
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { اليسار := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن اليمين: متغير معرف_قيمة_مسير = الحد;
    طابق معرف_مبني_للخفض(أصدر_مقطع_تسلسل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المصدر.المعرف, الحد_العددي, الباقي,
        نوع_الشريحة
    ), النطاق) مع
    | نتيجة.نجح(ق) -> { اليمين := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الأعضاء: متجه معرف_قيمة_مسير = [اليسار, اليمين];
    طابق معرف_مبني_للخفض(أصدر_تجميع_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, الأعضاء, النوع
    ), النطاق) مع
    | نتيجة.نجح(ق) -> {
        ليكن الناتج: قيمة_خفض_مسير = { المعرف: ق, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(الناتج);
    }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
}
