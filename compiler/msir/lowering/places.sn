استورد compiler.frontend.types.type_context;
// MSIR place construction. Recursive AST traversal stays in expressions.sn so the
// lowering import graph remains acyclic; all concrete place/address/load emission lives here.
عام عرف اخفض_مكان_اسم_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الاسم: &اسم,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_خفض_مكان {
    طابق رمز_اسم_للخفض(روابط_الأسماء, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
    }
    | نتيجة.نجح(الرمز) -> {
        طابق موضع_محلي_خفض(الحالة, الرمز) مع
        | اختياري.لا_شيء -> {
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
            }
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.ثابت(_) -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | هدف_قيمة_عليا_خفض.عام(العام) -> {
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    طابق أصدر_مكان_عام_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        العام,
                        الربط.النوع,
                        الربط.قابل_للكتابة
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                        دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: الربط.النوع };
                        أرجع نتيجة_خفض_مكان.مكان(المكان);
                    }
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                };
            };
        }
        | اختياري.موجود(الموضع) -> {
            دع نسخة: حالة_خفض_دالة = *الحالة;
            دع المحلي: ربط_محلي_خفض = نسخة.المحليات[الموضع];
            طابق المحلي.المكان مع
            | اختياري.موجود(المعرف) -> {
                دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: المحلي.النوع };
                أرجع نتيجة_خفض_مكان.مكان(المكان);
            }
            | اختياري.لا_شيء -> {
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق أصدر_مكان_محلي_مسير(
                    البرنامج,
                    &حالة_الإصدار.البناء,
                    حالة_الإصدار.الدالة,
                    حالة_الإصدار.الكتلة,
                    المحلي.النوع,
                    صواب
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    طابق المحلي.القيمة مع
                    | اختياري.موجود(الحالي) -> {
                        طابق أصدر_تخزين_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            المعرف,
                            الحالي
                        ) مع
                        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                            أرجع نتيجة_خفض_مكان.مرفوض(
                                خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                            );
                        }
                        | _ -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    تأكد_محليات_خفض_فريدة(الحالة);
                    (*الحالة).المحليات[الموضع].المكان := اختياري.موجود(المعرف);
                    دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: المحلي.النوع };
                    أرجع نتيجة_خفض_مكان.مكان(المكان);
                };
            };
        };
    };
}

// Whether an index into a value of this Type is bounds-checked: vectors and
// text own a length. Raw pointers are indexed only in unsafe code.
عام عرف نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع صواب; }
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.نص(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether the Type is a vector (not text, a slice or a pointer).
عام عرف هل_نوع_متجه_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.متجه -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// index < length, compared as unsigned 64-bit values (a negative index is
// out of range). An index outside the value traps: the program stops instead
// of reading or writing memory it does not own.
عرف تحقق_حدود_فهرس_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع القيمة_المحملة: متغير معرف_قيمة_مسير = قيمة_الفهرس.المعرف;
    طابق أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, مكان_الأصل.المعرف, مكان_الأصل.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { القيمة_المحملة := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    أرجع تحقق_حدود_فهرس_قيمة_للخفض(البرنامج, الحالة, النطاق, القيمة_المحملة, قيمة_الفهرس, الأنواع);
}

// The same check on a vector or text value (an index read).
عام عرف تحقق_حدود_فهرس_قيمة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    القيمة_المحملة: معرف_قيمة_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع نوع_العدد: متغير معرف_نوع = معرف_نوع_من(0);
    دع نوع_ط64: متغير معرف_نوع = معرف_نوع_من(0);
    دع نوع_المنطق: متغير معرف_نوع = معرف_نوع_من(0);
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    دع وصف_الفهرس: متغير وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, قيمة_الفهرس.النوع) مع
    | اختياري.موجود(الوصف) -> { وصف_الفهرس := الوصف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    لو (وصف_الفهرس.البتات == 0 || وصف_الفهرس.البتات > 64) { أرجع اختياري.لا_شيء(); };

    دع الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    دع الكتلة: معرف_كتلة_مسير = (*الحالة).الكتلة;
    دع حجج_الطول: متغير متجه معرف_قيمة_مسير = [];
    ألحق(حجج_الطول, القيمة_المحملة);
    دع الطول_الموقع: متغير معرف_قيمة_مسير = القيمة_المحملة;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, هوية_بدائي_مترجم.طول(), &حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الطول_الموقع := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع الطول: متغير معرف_قيمة_مسير = الطول_الموقع;
    طابق أصدر_تحويل_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الطول := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع الفهرس: متغير معرف_قيمة_مسير = قيمة_الفهرس.المعرف;
    لو (!معرفا_نوع_متساويان(قيمة_الفهرس.النوع, نوع_ط64)) {
        دع العملية: متغير عملية_تحويل_صحيح = عملية_تحويل_صحيح.إعادة_تفسير();
        لو (وصف_الفهرس.البتات < 64) {
            لو (وصف_الفهرس.موقع) { العملية := عملية_تحويل_صحيح.توسيع_بإشارة(); }
            وإلا { العملية := عملية_تحويل_صحيح.توسيع_صفري(); };
        };
        طابق أصدر_تحويل_صحيح_مسير(
            البرنامج, &(*الحالة).البناء, الدالة, الكتلة, العملية, قيمة_الفهرس.المعرف, نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الفهرس := ق; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    };
    دع الشرط: متغير معرف_قيمة_مسير = الفهرس;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أصغر(), الفهرس, الطول, نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { الشرط := ق; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع داخل_الحدود: متغير معرف_كتلة_مسير = الكتلة;
    دع خارج_الحدود: متغير معرف_كتلة_مسير = الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { داخل_الحدود := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(ك) -> { خارج_الحدود := ك; }
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); };
    دع بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    دع بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    دع إلى_الداخل: حافة_مسير = { الهدف: داخل_الحدود, الحجج: بلا_حجج_أ };
    دع إلى_الخارج: حافة_مسير = { الهدف: خارج_الحدود, الحجج: بلا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(البرنامج, الدالة, الكتلة, الشرط, إلى_الداخل, إلى_الخارج) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    طابق اختم_بفخ_مسير(البرنامج, الدالة, خارج_الحدود) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(خ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    (*الحالة).الكتلة := داخل_الحدود;
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_مكان_فهرس_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    لو (نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع, مكان_الأصل.النوع)) {
        طابق تحقق_حدود_فهرس_للخفض(البرنامج, الحالة, النطاق, مكان_الأصل, قيمة_الفهرس, الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق أصدر_مكان_فهرس_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        مكان_الأصل.المعرف,
        قيمة_الفهرس.المعرف,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_مكان.مكان(المكان);
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عرف نوع_قيمة_عنصر_مؤشر_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): اختياري معرف_نوع {
    دع سجل_الأنواع: سجل_أنواع = *الأنواع;
    طابق معرف_نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            لو (نوع_العنصر.القيمة >= (الطول(سجل_الأنواع.الأنواع) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            دع مرجع_النوع: &نوع_مقنن = &سجل_الأنواع.الأنواع[نوع_العنصر.القيمة];
            طابق *مرجع_النوع مع
            | نوع_مقنن.متغير(الداخل) -> {
                أرجع اختياري.موجود(الداخل);
            }
            | _ -> {
                أرجع اختياري.موجود(نوع_العنصر);
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    قيمة_المؤشر: قيمة_خفض_مسير,
    قيمة_الفهرس: قيمة_خفض_مسير,
    نوع_التعبير: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    طابق نوع_قيمة_عنصر_مؤشر_للخفض(الأنواع, قيمة_المؤشر.النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_المؤشر.النوع)
        );
    }
    | اختياري.موجود(نوع_العنصر) -> {
        لو (!نوعان_متوافقان(الأنواع, نوع_التعبير, نوع_العنصر)) {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_التعبير)
            );
        };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق أصدر_موضع_تخزين_عنصر_مؤشر_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            قيمة_المؤشر.المعرف,
            قيمة_الفهرس.المعرف,
            نوع_العنصر
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            دع موضع_التخزين: مكان_خفض_مسير = { المعرف: المعرف, النوع: نوع_العنصر };
            أرجع نتيجة_خفض_مكان.مكان(موضع_التخزين);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عام عرف اخفض_مكان_حقل_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    مكان_الأصل: مكان_خفض_مسير,
    اسم_الحقل: &اسم,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء
): نتيجة_خفض_مكان {
    دع قيمة_اسم_الحقل: اسم = *اسم_الحقل;
    دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
    طابق معرف_اسم_محلول_عند(روابط_الأسماء, قيمة_اسم_الحقل.النطاق) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.ربط_اسم_مفقود(قيمة_اسم_الحقل.النطاق));
    }
    | اختياري.موجود(المعرف) -> {
        هوية_الحقل := المعرف;
    };
    طابق وصف_حقل_سجل_دلالي_بالاسم(الأنواع, مكان_الأصل.النوع, هوية_الحقل) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, مكان_الأصل.النوع)
        );
    }
    | اختياري.موجود(الوصف) -> {
        لو (!نوعان_متوافقان(الأنواع, الوصف.النوع, النوع)) {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق أصدر_مكان_حقل_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            مكان_الأصل.المعرف,
            الوصف.الترتيب,
            الوصف.النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: الوصف.النوع };
            أرجع نتيجة_خفض_مكان.مكان(المكان);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عام عرف اخفض_مكان_فك_مرجع_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    قيمة_المرجع: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_مكان {
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق نوع_حمولة_صندوق_دلالي(الأنواع, قيمة_المرجع.النوع) مع
    | اختياري.موجود(_) -> {
        طابق أصدر_صندوق_إلى_مكان_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            قيمة_المرجع.المعرف,
            النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
            دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
            أرجع نتيجة_خفض_مكان.مكان(المكان);
        }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    }
    | اختياري.لا_شيء -> { };
    // A raw pointer is not a reference. Lower *pointer as pointer[0],
    // preserving the canonical pointer-element place and MSIR type contract.
    طابق نوع_قيمة_عنصر_مؤشر_للخفض(الأنواع, قيمة_المرجع.النوع) مع
    | اختياري.موجود(_) -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_مكان.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_المرجع.النوع)
            );
        }
        | اختياري.موجود(نوع_الفهرس) -> {
            طابق أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                ثابت_مسير.صحيح_طبيعي(0),
                نوع_الفهرس
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(معرف_الفهرس) -> {
                دع الفهرس: قيمة_خفض_مسير = {
                    المعرف: معرف_الفهرس,
                    النوع: نوع_الفهرس
                };
                أرجع اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
                    البرنامج,
                    الحالة,
                    النطاق,
                    قيمة_المرجع,
                    الفهرس,
                    النوع,
                    الأنواع
                );
            }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع نتيجة_خفض_مكان.مرفوض(
                    خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                );
            }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
        };
    }
    | اختياري.لا_شيء -> { };
    طابق أصدر_مرجع_إلى_مكان_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        قيمة_المرجع.المعرف,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        دع المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_مكان.مكان(المكان);
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عام عرف اخفض_تحميل_مكان_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المكان: مكان_خفض_مسير
): نتيجة_خفض_تعبير {
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_تحميل_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المكان.المعرف,
            المكان.النوع
        ),
        المكان.النوع
    );
}

عام عرف اخفض_مرجع_مكان_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المكان: مكان_خفض_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مكان_إلى_مرجع_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المكان.المعرف,
            النوع
        ),
        النوع
    );
}
