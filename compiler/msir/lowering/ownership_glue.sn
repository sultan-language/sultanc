استورد compiler.source.span;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.frontend.types.type_context;
استورد compiler.runtime.primitive_identity;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_builder;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.msir_context;

// Ownership glue: the per-Type MSIR functions that implement explicit copy
// (`استنسخ`). The model is Rust's compiler-generated shims (Clone/Drop glue in
// rustc_mir_transform/src/shim.rs): one ordinary function per concrete Type,
// built from the Type's structure, so every backend and the interpreter run
// the same verified MSIR and no backend implements a deep copy of its own.
//
// Expression lowering emits each `استنسخ(&x)` as a call of the compiler
// primitive; اخفض_غراء_الملكية_مسير then rewrites that call, in place, into a
// call of the Type's reference wrapper. The wrapper loads the referenced value
// (a shallow read: MSIR values do not own) and calls the value glue, which
// rebuilds every owned buffer:
//   vector / text  new empty sequence, element-by-element append of copies
//   record / tuple field copies reassembled
//   enum           tag dispatch, payload copies, same constructor
//   box            new box holding a copy of the payload
// A Type that owns nothing is copied by the load alone. Glue functions are
// created before their bodies, so recursive Types (through boxes or vectors)
// call their own glue.
//
// Closure environments are reference counted (docs/OWNERSHIP_AND_DESTRUCTION.md,
// "Closure environments"). A function Type owns its environment: its copy
// glue counts one more reference, its drop glue one fewer, and the last drop
// runs the environment's destructor and releases it. Lowering emits a copy of
// a value that holds closures as the احتفاظ_بقيمة primitive, which this pass
// rewrites into the copy glue, and it assigns each closure construction the
// destructor of its environment.

نوع ربط_غراء_نوع = {
    النوع: معرف_نوع,
    الدالة: معرف_دالة_مسير
};

// The block a glue body ends in and the copy it produced there.
نوع ناتج_جسم_غراء = {
    الكتلة: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير
};

// The environment destructor generated for a closure-created function.
نوع ربط_مدمر_إغلاق = {
    الدالة: معرف_دالة_مسير,
    المدمر: معرف_دالة_مسير
};

نوع سياق_غراء_ملكية = {
    بالقيمة: متجه ربط_غراء_نوع,
    بالمرجع: متجه ربط_غراء_نوع,
    بالإسقاط: متجه ربط_غراء_نوع,
    المدمرات: متجه ربط_مدمر_إغلاق,
    // The destructor of environments that own nothing.
    المدمر_الفارغ: اختياري معرف_دالة_مسير,
    نوع_العدد: معرف_نوع,
    نوع_المنطق: معرف_نوع,
    نوع_الوسم: معرف_نوع,
    نوع_البايت: معرف_نوع
};

عرف خطأ_غراء(): خطأ_خفض_مسير {
    أرجع خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ());
}

عرف قيمة_غراء(الناتج: نتيجة_بناء_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
}

عرف بلا_قيمة_غراء(الناتج: نتيجة_بناء_قيمة_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف كتلة_غراء(البرنامج: &متغير برنامج_مسير, الدالة: معرف_دالة_مسير): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

عرف منهي_غراء(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

عرف ابحث_غراء(الروابط: &متجه ربط_غراء_نوع, النوع: معرف_نوع): اختياري معرف_دالة_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        لو (معرفا_نوع_متساويان((*الروابط)[ف].النوع, النوع)) {
            أرجع اختياري.موجود((*الروابط)[ف].الدالة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Whether a Type owns storage that a copy must duplicate: text, vectors and
// boxes own buffers, a function value owns a reference to its closure
// environment, and aggregates own storage when a member does. Every cycle of
// Types passes through a box or vector, which answers without recursing.
عام عرف يملك_تخزينا_للغراء(الأنواع: &سجل_أنواع, النوع: معرف_نوع): نتيجة منطقي, خطأ_خفض_مسير {
    أرجع يملك_تخزينا_بإغلاقات_للغراء(الأنواع, النوع, صواب);
}

// The same classification; without مع_الإغلاقات a function value owns
// nothing, which is the Frontend's classification (memory_classification.sn):
// there a function value is plain and copied by reading it.
عرف يملك_تخزينا_بإغلاقات_للغراء(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    مع_الإغلاقات: منطقي
): نتيجة منطقي, خطأ_خفض_مسير {
    // Lowering asks this of every value it stores, passes or drops; the
    // registry caches the answer per Type (املأ_تصنيفات_ملكية_مسير).
    دع المخزن: ط8 = تصنيف_ملكية_مسير_عند(الأنواع, النوع);
    لو (المخزن != 0) {
        لو (المخزن == 3) { أرجع نتيجة.نجح(صواب); };
        لو (المخزن == 2) { أرجع نتيجة.نجح(مع_الإغلاقات); };
        أرجع نتيجة.نجح(خطأ);
    };
    أرجع صنف_ملكية_بإغلاقات_للغراء(الأنواع, النوع, مع_الإغلاقات);
}

// The ownership class of a Type for the registry's cache: 1 owns nothing,
// 2 owns closure references only, 3 owns storage, 0 unresolved.
عرف صنف_ملكية_للتخزين(الأنواع: &سجل_أنواع, النوع: معرف_نوع): ط8 {
    طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, النوع, خطأ) مع
    | نتيجة.خطأ(_) -> { أرجع 0; }
    | نتيجة.نجح(يملك) -> { لو (يملك) { أرجع 3; }; };
    طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, النوع, صواب) مع
    | نتيجة.خطأ(_) -> { أرجع 0; }
    | نتيجة.نجح(يملك) -> { لو (يملك) { أرجع 2; }; };
    أرجع 1;
}

// Classifies every registered Type once, before function bodies are
// lowered. Types are classified in TypeID order, so the members of a Type,
// registered before it, are usually answered from the cache already filled.
// Types registered later are classified on demand.
عام عرف املأ_تصنيفات_ملكية_مسير(الأنواع: &متغير سجل_أنواع): فراغ {
    امسح_تصنيفات_ملكية_مسير(الأنواع);
    دع العدد: طبيعي = عدد_الأنواع_المسجلة(الأنواع);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الصنف: ط8 = صنف_ملكية_للتخزين(الأنواع, معرف_نوع_من(ف));
        ألحق_تصنيف_ملكية_مسير(الأنواع, الصنف);
        ف := ف + 1;
    }
}

عرف صنف_ملكية_بإغلاقات_للغراء(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    مع_الإغلاقات: منطقي
): نتيجة منطقي, خطأ_خفض_مسير {
    دع الصنف: صنف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> { الصنف := الوصف.الصنف; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    طابق الصنف مع
    | صنف_شكل_نوع_دلالي.بدائي(نوع_بدائي_مقنن.نص) -> { أرجع نتيجة.نجح(صواب); }
    | صنف_شكل_نوع_دلالي.متجه -> { أرجع نتيجة.نجح(صواب); }
    | صنف_شكل_نوع_دلالي.صندوق -> { أرجع نتيجة.نجح(صواب); }
    | صنف_شكل_نوع_دلالي.دالة -> { أرجع نتيجة.نجح(مع_الإغلاقات); }
    | صنف_شكل_نوع_دلالي.صف -> {
        دع العدد: طبيعي;
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(العضو) -> {
                طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, العضو, مع_الإغلاقات) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(يملك) -> { لو (يملك) { أرجع نتيجة.نجح(صواب); }; };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(خطأ);
    }
    | صنف_شكل_نوع_دلالي.سجل -> {
        دع العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(العضو) -> {
                طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, العضو, مع_الإغلاقات) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(يملك) -> { لو (يملك) { أرجع نتيجة.نجح(صواب); }; };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(خطأ);
    }
    | صنف_شكل_نوع_دلالي.تعداد -> { أرجع يملك_تخزينا_موسوم_للغراء(الأنواع, النوع, مع_الإغلاقات); }
    | صنف_شكل_نوع_دلالي.اختيار -> { أرجع يملك_تخزينا_موسوم_للغراء(الأنواع, النوع, مع_الإغلاقات); }
    | صنف_شكل_نوع_دلالي.نتيجة -> { أرجع يملك_تخزينا_موسوم_للغراء(الأنواع, النوع, مع_الإغلاقات); }
    | _ -> { أرجع نتيجة.نجح(خطأ); };
}

// The one ownership classification of MSIR lowering: drop elaboration
// (drops.sn) destroys exactly the values the glue copies deeply. A Type whose
// shape cannot be resolved is treated as owning nothing (never destroyed).
عام عرف هل_نوع_يملك_تخزينا_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق يملك_تخزينا_للغراء(الأنواع, النوع) مع
    | نتيجة.نجح(يملك) -> { أرجع يملك; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// A Type that owns closure references and nothing else: plain for the
// Frontend, which copies it by reading it (a function value, or an aggregate
// of plain members and function values). SSF records no move of such a
// value, so lowering copies it, through its copy glue, wherever a read of it
// is stored, passed, returned or captured.
عام عرف هل_نوع_معدود_عادي_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, النوع, صواب) مع
    | نتيجة.نجح(يملك) -> { لو (!يملك) { أرجع خطأ; }; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
    طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, النوع, خطأ) مع
    | نتيجة.نجح(يملك) -> { أرجع !يملك; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف يملك_تخزينا_موسوم_للغراء(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    مع_الإغلاقات: منطقي
): نتيجة منطقي, خطأ_خفض_مسير {
    دع عدد_المنشئات: طبيعي;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(ع) -> { عدد_المنشئات := ع; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) {
        دع عدد_الحمولات: طبيعي;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, م) مع
        | اختياري.موجود(ع) -> { عدد_الحمولات := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, النوع, م, ح) مع
            | اختياري.موجود(العضو) -> {
                طابق يملك_تخزينا_بإغلاقات_للغراء(الأنواع, العضو, مع_الإغلاقات) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(يملك) -> { لو (يملك) { أرجع نتيجة.نجح(صواب); }; };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            ح := ح + 1;
        }
        م := م + 1;
    }
    أرجع نتيجة.نجح(خطأ);
}

عرف تمثيل_للغراء(الأنواع: &سجل_أنواع, النوع: معرف_نوع): نتيجة معرف_نوع, خطأ_خفض_مسير {
    طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
}

// Emits a copy of القيمة (of Type النوع) into الكتلة: the value itself when the
// Type owns nothing, else a call of the Type's value glue.
عرف أصدر_نسخة_قيمة_غراء(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق يملك_تخزينا_للغراء(الأنواع, النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(يملك) -> { لو (!يملك) { أرجع نتيجة.نجح(القيمة); }; };
    دع الغراء: معرف_دالة_مسير;
    طابق غراء_استنساخ_بالقيمة(السياق, البرنامج, الأنواع, النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الغراء := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    أرجع قيمة_غراء(أصدر_نداء_مسير(البرنامج, &البناء, الدالة, الكتلة, الغراء, &الحجج));
}

// The reference wrapper `(&T) -> T`: loads through the reference and copies.
عرف غراء_استنساخ_بالمرجع(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    نوع_المرجع: معرف_نوع,
    النوع: معرف_نوع
): نتيجة معرف_دالة_مسير, خطأ_خفض_مسير {
    طابق ابحث_غراء(&(*السياق).بالمرجع, نوع_المرجع) مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { };
    دع المعاملات: متجه معرف_نوع = [نوع_المرجع];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &المعاملات, اختياري.موجود(النوع));
    دع الربط: ربط_غراء_نوع = { النوع: نوع_المرجع, الدالة: الدالة };
    ألحق((*السياق).بالمرجع, الربط);
    دع المرجع: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, 0);
    دع المدخل: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المدخل := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع المكان: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مرجع_إلى_مكان_مسير(البرنامج, &البناء, الدالة, المدخل, المرجع, النوع)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المكان := المعرف; };
    دع المحمل: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_تحميل_مسير(البرنامج, &البناء, الدالة, المدخل, المكان, النوع)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المحمل := المعرف; };
    دع النسخة: معرف_قيمة_مسير;
    طابق أصدر_نسخة_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, المدخل, المحمل, النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { النسخة := المعرف; };
    طابق منهي_غراء(اختم_بإرجاع_مسير(البرنامج, الدالة, المدخل, اختياري.موجود(النسخة))) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(الدالة);
}

// Copies the members of a record or tuple value and reassembles them.
عرف أصدر_جسم_غراء_تجميع(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    أنواع_الأعضاء: &متجه معرف_نوع
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الأعضاء: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أنواع_الأعضاء) مثل طبيعي)) {
        دع نوع_العضو: معرف_نوع = (*أنواع_الأعضاء)[ف];
        دع العضو: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_استخراج_حقل_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, ف, نوع_العضو)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { العضو := المعرف; };
        طابق أصدر_نسخة_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, المدخل, العضو, نوع_العضو) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { ألحق(الأعضاء, المعرف); };
        ف := ف + 1;
    }
    أرجع قيمة_غراء(أصدر_تجميع_مسير(البرنامج, &البناء, الدالة, المدخل, &الأعضاء, النوع));
}

// Copies a vector (or the bytes of text): a new empty sequence in a local slot,
// then one append of each element's copy. Returns the exit block and the copy.
عرف أصدر_جسم_غراء_تسلسل(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    نوع_الناتج: معرف_نوع,
    نوع_العنصر: معرف_نوع
): نتيجة ناتج_جسم_غراء, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع نوع_العدد: معرف_نوع = (*السياق).نوع_العدد;
    دع نوع_المنطق: معرف_نوع = (*السياق).نوع_المنطق;
    دع الخانة: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مكان_محلي_مسير(البرنامج, &البناء, الدالة, المدخل, نوع_الناتج, صواب)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الخانة := المعرف; };
    دع لا_عناصر: متجه معرف_قيمة_مسير = [];
    دع الفارغ: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_تهيئة_متجه_مسير(البرنامج, &البناء, الدالة, المدخل, &لا_عناصر, نوع_الناتج)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الفارغ := المعرف; };
    طابق بلا_قيمة_غراء(أصدر_تخزين_مسير(البرنامج, &البناء, الدالة, المدخل, الخانة, الفارغ)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع حجج_الطول: متجه معرف_قيمة_مسير = [القيمة];
    دع الطول_الكلي: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الطول_الكلي := المعرف; };
    دع الصفر: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_ثابتا_مسير(البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(0), نوع_العدد)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الصفر := المعرف; };

    دع الرأس: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الرأس := المعرف; };
    دع الجسم: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الجسم := المعرف; };
    دع المخرج: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المخرج := المعرف; };

    دع الفهرس: معرف_قيمة_مسير;
    طابق قيمة_غراء(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الرأس, نوع_العدد)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الفهرس := المعرف; };
    دع حجج_البدء: متجه معرف_قيمة_مسير = [الصفر];
    طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, المدخل, الرأس, &حجج_البدء)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };

    دع الشرط: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, الرأس, عملية_مقارنة_صحيح.أصغر(),
        الفهرس, الطول_الكلي, نوع_المنطق
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الشرط := المعرف; };
    دع لا_حجج_للجسم: متجه معرف_قيمة_مسير = [];
    دع لا_حجج_للمخرج: متجه معرف_قيمة_مسير = [];
    دع إلى_الجسم: حافة_مسير = { الهدف: الجسم, الحجج: لا_حجج_للجسم };
    دع إلى_المخرج: حافة_مسير = { الهدف: المخرج, الحجج: لا_حجج_للمخرج };
    طابق منهي_غراء(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, الرأس, الشرط, إلى_الجسم, إلى_المخرج)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };

    دع العنصر: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_استخراج_فهرس_مسير(البرنامج, &البناء, الدالة, الجسم, القيمة, الفهرس, نوع_العنصر)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { العنصر := المعرف; };
    دع نسخة_العنصر: معرف_قيمة_مسير;
    طابق أصدر_نسخة_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, الجسم, العنصر, نوع_العنصر) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { نسخة_العنصر := المعرف; };
    دع الحالي: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_تحميل_مسير(البرنامج, &البناء, الدالة, الجسم, الخانة, نوع_الناتج)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الحالي := المعرف; };
    دع حجج_الإلحاق: متجه معرف_قيمة_مسير = [الحالي, نسخة_العنصر];
    طابق بلا_قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, الجسم, هوية_بدائي_مترجم.إلحاق(), &حجج_الإلحاق,
        اختياري.لا_شيء(), اختياري.موجود(الخانة)
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع الواحد: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_ثابتا_مسير(البرنامج, &البناء, الدالة, الجسم, ثابت_مسير.صحيح_موقع(1), نوع_العدد)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الواحد := المعرف; };
    دع التالي: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &البناء, الدالة, الجسم, عملية_حساب_صحيح.جمع(), الفهرس, الواحد, نوع_العدد
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { التالي := المعرف; };
    دع حجج_التكرار: متجه معرف_قيمة_مسير = [التالي];
    طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, الجسم, الرأس, &حجج_التكرار)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };

    دع الناتج: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_تحميل_مسير(البرنامج, &البناء, الدالة, المخرج, الخانة, نوع_الناتج)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    دع الجسم_الناتج: ناتج_جسم_غراء = { الكتلة: المخرج, القيمة: الناتج };
    أرجع نتيجة.نجح(الجسم_الناتج);
}

// Copies a tagged value: dispatch on the tag; each constructor's block copies
// its payloads and rebuilds the same constructor, then joins the exit block.
عرف أصدر_جسم_غراء_موسوم(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة ناتج_جسم_غراء, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع عدد_المنشئات: طبيعي;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> { عدد_المنشئات := العدد; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    دع الوسم: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_استعلام_وسم_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, (*السياق).نوع_الوسم)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الوسم := المعرف; };
    دع المخرج: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المخرج := المعرف; };
    دع الناتج: معرف_قيمة_مسير;
    طابق قيمة_غراء(أضف_معامل_كتلة_مسير(البرنامج, الدالة, المخرج, النوع)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    دع الفخ: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الفخ := المعرف; };
    طابق منهي_غراء(اختم_بفخ_مسير(البرنامج, الدالة, الفخ)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };

    دع الحالات: متغير متجه حالة_فرع_متعدد_مسير = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الكتلة := المعرف; };
        دع عدد_الحمولات: طبيعي;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, م) مع
        | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع الحمولات: متغير متجه معرف_قيمة_مسير = [];
        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            دع نوع_الحمولة: معرف_نوع;
            طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, النوع, م, ح) مع
            | اختياري.موجود(المعرف) -> {
                طابق تمثيل_للغراء(الأنواع, المعرف) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(التمثيل) -> { نوع_الحمولة := التمثيل; };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            دع الحمولة: معرف_قيمة_مسير;
            طابق قيمة_غراء(أصدر_استخراج_حمولة_مسير(
                البرنامج, &البناء, الدالة, الكتلة, القيمة, م, ح, نوع_الحمولة
            )) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(المعرف) -> { الحمولة := المعرف; };
            طابق أصدر_نسخة_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, الكتلة, الحمولة, نوع_الحمولة) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(المعرف) -> { ألحق(الحمولات, المعرف); };
            ح := ح + 1;
        }
        دع المبني: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_بناء_موسوم_مسير(البرنامج, &البناء, الدالة, الكتلة, م, &الحمولات, النوع)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { المبني := المعرف; };
        دع حجج_المخرج: متجه معرف_قيمة_مسير = [المبني];
        طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, الكتلة, المخرج, &حجج_المخرج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        دع لا_حجج: متجه معرف_قيمة_مسير = [];
        دع الحافة: حافة_مسير = { الهدف: الكتلة, الحجج: لا_حجج };
        دع الحالة: حالة_فرع_متعدد_مسير = { الوسم: م, الحافة: الحافة };
        ألحق(الحالات, الحالة);
        م := م + 1;
    }
    دع لا_حجج_للفخ: متجه معرف_قيمة_مسير = [];
    دع الافتراضي: حافة_مسير = { الهدف: الفخ, الحجج: لا_حجج_للفخ };
    دع الفرع: فرع_متعدد_مسير = { المميز: الوسم, الحالات: الحالات, الافتراضي: الافتراضي };
    طابق منهي_غراء(اختم_بفرع_متعدد_مسير(البرنامج, الدالة, المدخل, الفرع)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع الجسم_الناتج: ناتج_جسم_غراء = { الكتلة: المخرج, القيمة: الناتج };
    أرجع نتيجة.نجح(الجسم_الناتج);
}

// The value glue `(T) -> T` of an owning Type.
عرف غراء_استنساخ_بالقيمة(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    النوع: معرف_نوع
): نتيجة معرف_دالة_مسير, خطأ_خفض_مسير {
    طابق ابحث_غراء(&(*السياق).بالقيمة, النوع) مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { };
    دع المعاملات: متجه معرف_نوع = [النوع];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &المعاملات, اختياري.موجود(النوع));
    دع الربط: ربط_غراء_نوع = { النوع: النوع, الدالة: الدالة };
    ألحق((*السياق).بالقيمة, الربط);
    دع القيمة: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, 0);
    دع المدخل: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المدخل := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();

    دع الصنف: صنف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> { الصنف := الوصف.الصنف; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };

    دع كتلة_الإرجاع: متغير معرف_كتلة_مسير = المدخل;
    دع الناتج: متغير معرف_قيمة_مسير = القيمة;
    طابق الصنف مع
    | صنف_شكل_نوع_دلالي.صف -> {
        دع الأعضاء: متغير متجه معرف_نوع = [];
        دع العدد: طبيعي;
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(المعرف) -> {
                طابق تمثيل_للغراء(الأنواع, المعرف) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(التمثيل) -> { ألحق(الأعضاء, التمثيل); };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            ف := ف + 1;
        }
        طابق أصدر_جسم_غراء_تجميع(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع, &الأعضاء) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    }
    | صنف_شكل_نوع_دلالي.سجل -> {
        دع الأعضاء: متغير متجه معرف_نوع = [];
        دع العدد: طبيعي;
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف) مع
            | اختياري.موجود(المعرف) -> {
                طابق تمثيل_للغراء(الأنواع, المعرف) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(التمثيل) -> { ألحق(الأعضاء, التمثيل); };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            ف := ف + 1;
        }
        طابق أصدر_جسم_غراء_تجميع(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع, &الأعضاء) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    }
    | صنف_شكل_نوع_دلالي.تعداد -> {
        طابق أصدر_جسم_غراء_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الجسم_الناتج) -> { كتلة_الإرجاع := الجسم_الناتج.الكتلة; الناتج := الجسم_الناتج.القيمة; };
    }
    | صنف_شكل_نوع_دلالي.اختيار -> {
        طابق أصدر_جسم_غراء_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الجسم_الناتج) -> { كتلة_الإرجاع := الجسم_الناتج.الكتلة; الناتج := الجسم_الناتج.القيمة; };
    }
    | صنف_شكل_نوع_دلالي.نتيجة -> {
        طابق أصدر_جسم_غراء_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الجسم_الناتج) -> { كتلة_الإرجاع := الجسم_الناتج.الكتلة; الناتج := الجسم_الناتج.القيمة; };
    }
    | صنف_شكل_نوع_دلالي.صندوق -> {
        دع نوع_الحمولة: معرف_نوع;
        طابق نوع_حمولة_صندوق_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> {
            طابق تمثيل_للغراء(الأنواع, المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(التمثيل) -> { نوع_الحمولة := التمثيل; };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع المكان: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_صندوق_إلى_مكان_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, نوع_الحمولة)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { المكان := المعرف; };
        دع الحمولة: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_تحميل_مسير(البرنامج, &البناء, الدالة, المدخل, المكان, نوع_الحمولة)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الحمولة := المعرف; };
        دع نسخة_الحمولة: معرف_قيمة_مسير;
        طابق أصدر_نسخة_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, المدخل, الحمولة, نوع_الحمولة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { نسخة_الحمولة := المعرف; };
        طابق قيمة_غراء(أصدر_بناء_صندوق_مسير(البرنامج, &البناء, الدالة, المدخل, نسخة_الحمولة, النوع)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    }
    | صنف_شكل_نوع_دلالي.متجه -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> {
            طابق تمثيل_للغراء(الأنواع, المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(التمثيل) -> { نوع_العنصر := التمثيل; };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        طابق أصدر_جسم_غراء_تسلسل(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع, نوع_العنصر) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الجسم_الناتج) -> { كتلة_الإرجاع := الجسم_الناتج.الكتلة; الناتج := الجسم_الناتج.القيمة; };
    }
    | صنف_شكل_نوع_دلالي.بدائي(نوع_بدائي_مقنن.نص) -> {
        // Text owns a byte buffer: copy the bytes, then transfer the new
        // buffer to a text value.
        دع نوع_البايتات: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متجه((*السياق).نوع_البايت));
        دع البايتات: معرف_قيمة_مسير;
        طابق أصدر_جسم_غراء_تسلسل(
            السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, نوع_البايتات, (*السياق).نوع_البايت
        ) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الجسم_الناتج) -> { كتلة_الإرجاع := الجسم_الناتج.الكتلة; البايتات := الجسم_الناتج.القيمة; };
        طابق قيمة_غراء(أصدر_نقل_تسلسل_مملوك_مسير(
            البرنامج, &البناء, الدالة, كتلة_الإرجاع, البايتات, النوع
        )) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };
    }
    | صنف_شكل_نوع_دلالي.دالة -> {
        // A copy of a closure value shares its environment, which counts one
        // more reference.
        دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
        طابق بلا_قيمة_غراء(أصدر_نداء_بدائي_مسير(
            البرنامج, &البناء, الدالة, المدخل, هوية_بدائي_مترجم.زيادة_مراجع_إغلاق(), &الحجج,
            اختياري.لا_شيء(), اختياري.لا_شيء()
        )) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> {
        // Types that own nothing never reach value glue.
        أرجع نتيجة.خطأ(خطأ_غراء());
    };
    طابق منهي_غراء(اختم_بإرجاع_مسير(البرنامج, الدالة, كتلة_الإرجاع, اختياري.موجود(الناتج))) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(الدالة);
}

// ---- Drop glue -------------------------------------------------------------
// One `(T) -> ()` function per owning Type destroys a value of it: owning
// members, elements and payloads first, then the storage the value itself
// holds. The storage release is the release primitive on the storage address,
// which the backends adapt to the canonical allocator provider
// (runtime_primitive_query_context.sn, نداء_تحرير_مكيف_للهدف):
//   box            the box itself
//   vector / text  a reference to the first element of a non-empty buffer
//                  (text transfers its buffer to a byte vector first)
// An empty vector or text holds no buffer. The provider ignores addresses that
// are not live heap blocks, such as the static bytes of a text literal.

// The release primitive on a storage address, in a glue body.
عرف أصدر_تحرير_تخزين_غراء(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    العنوان: معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الحجج: متجه معرف_قيمة_مسير = [العنوان];
    أرجع بلا_قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, الكتلة, هوية_بدائي_مترجم.تحرير(), &الحجج,
        اختياري.لا_شيء(), اختياري.لا_شيء()
    ));
}

// Destroys القيمة (of Type النوع) in الكتلة: a call of the Type's drop glue,
// nothing for a Type that owns nothing.
عرف أصدر_إسقاط_قيمة_غراء(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع
): اختياري خطأ_خفض_مسير {
    طابق يملك_تخزينا_للغراء(الأنواع, النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(يملك) -> { لو (!يملك) { أرجع اختياري.لا_شيء(); }; };
    دع الغراء: معرف_دالة_مسير;
    طابق غراء_إسقاط(السياق, البرنامج, الأنواع, النوع) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الغراء := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    أرجع بلا_قيمة_غراء(أصدر_نداء_مسير(البرنامج, &البناء, الدالة, الكتلة, الغراء, &الحجج));
}

// Releases the buffer of a non-empty vector value, in الكتلة, through a
// reference to its first element (the allocator provider's adaptation).
عرف أصدر_إطلاق_مخزن_تسلسل_غراء(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    الصفر: معرف_قيمة_مسير,
    نوع_المتجه: معرف_نوع,
    نوع_العنصر: معرف_نوع
): اختياري خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الخانة: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مكان_محلي_مسير(البرنامج, &البناء, الدالة, الكتلة, نوع_المتجه, صواب)) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الخانة := المعرف; };
    طابق بلا_قيمة_غراء(أصدر_تخزين_مسير(البرنامج, &البناء, الدالة, الكتلة, الخانة, القيمة)) مع
    | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
    | اختياري.لا_شيء -> { };
    دع الأول: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مكان_فهرس_مسير(البرنامج, &البناء, الدالة, الكتلة, الخانة, الصفر, نوع_العنصر)) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { الأول := المعرف; };
    دع نوع_مرجع_العنصر: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.مرجع(نوع_العنصر, خطأ));
    دع مرجع_الأول: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مكان_إلى_مرجع_مسير(البرنامج, &البناء, الدالة, الكتلة, الأول, نوع_مرجع_العنصر)) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(المعرف) -> { مرجع_الأول := المعرف; };
    أرجع أصدر_تحرير_تخزين_غراء(البرنامج, الدالة, الكتلة, مرجع_الأول);
}

// Destroys the elements of a vector value, then releases its buffer. Returns
// the block where the glue continues.
عرف أصدر_جسم_إسقاط_تسلسل(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    نوع_المتجه: معرف_نوع,
    نوع_العنصر: معرف_نوع
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع نوع_العدد: معرف_نوع = (*السياق).نوع_العدد;
    دع نوع_المنطق: معرف_نوع = (*السياق).نوع_المنطق;
    دع حجج_الطول: متجه معرف_قيمة_مسير = [القيمة];
    دع الطول_الكلي: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الطول_الكلي := المعرف; };
    دع الصفر: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_ثابتا_مسير(البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(0), نوع_العدد)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الصفر := المعرف; };
    دع الحالية: متغير معرف_كتلة_مسير = المدخل;

    دع العناصر_تملك: منطقي;
    طابق يملك_تخزينا_للغراء(الأنواع, نوع_العنصر) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(يملك) -> { العناصر_تملك := يملك; };
    لو (العناصر_تملك) {
        دع الرأس: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الرأس := المعرف; };
        دع الجسم: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الجسم := المعرف; };
        دع المخرج: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { المخرج := المعرف; };
        دع الفهرس: معرف_قيمة_مسير;
        طابق قيمة_غراء(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الرأس, نوع_العدد)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الفهرس := المعرف; };
        دع حجج_البدء: متجه معرف_قيمة_مسير = [الصفر];
        طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, المدخل, الرأس, &حجج_البدء)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        دع الشرط: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الرأس, عملية_مقارنة_صحيح.أصغر(),
            الفهرس, الطول_الكلي, نوع_المنطق
        )) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الشرط := المعرف; };
        دع لا_حجج_للجسم: متجه معرف_قيمة_مسير = [];
        دع لا_حجج_للمخرج: متجه معرف_قيمة_مسير = [];
        دع إلى_الجسم: حافة_مسير = { الهدف: الجسم, الحجج: لا_حجج_للجسم };
        دع إلى_المخرج: حافة_مسير = { الهدف: المخرج, الحجج: لا_حجج_للمخرج };
        طابق منهي_غراء(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, الرأس, الشرط, إلى_الجسم, إلى_المخرج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        دع العنصر: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_استخراج_فهرس_مسير(البرنامج, &البناء, الدالة, الجسم, القيمة, الفهرس, نوع_العنصر)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { العنصر := المعرف; };
        طابق أصدر_إسقاط_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, الجسم, العنصر, نوع_العنصر) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        دع الواحد: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_ثابتا_مسير(البرنامج, &البناء, الدالة, الجسم, ثابت_مسير.صحيح_موقع(1), نوع_العدد)) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الواحد := المعرف; };
        دع التالي: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الجسم, عملية_حساب_صحيح.جمع(), الفهرس, الواحد, نوع_العدد
        )) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { التالي := المعرف; };
        دع حجج_التكرار: متجه معرف_قيمة_مسير = [التالي];
        طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, الجسم, الرأس, &حجج_التكرار)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        الحالية := المخرج;
    };

    // A buffer with capacity is released through a reference to its first
    // element: an empty vector keeps its buffer after pop or truncate (as
    // Rust's Vec does), and a vector that never allocated has capacity zero.
    دع الإطلاق: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الإطلاق := المعرف; };
    دع النهاية: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { النهاية := المعرف; };
    دع حجج_السعة: متجه معرف_قيمة_مسير = [القيمة];
    دع السعة: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, الحالية, هوية_بدائي_مترجم.سعة_متجه(), &حجج_السعة,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { السعة := المعرف; };
    دع غير_فارغ: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, الحالية, عملية_مقارنة_صحيح.أصغر(),
        الصفر, السعة, نوع_المنطق
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { غير_فارغ := المعرف; };
    دع لا_حجج_للإطلاق: متجه معرف_قيمة_مسير = [];
    دع لا_حجج_للنهاية: متجه معرف_قيمة_مسير = [];
    دع إلى_الإطلاق: حافة_مسير = { الهدف: الإطلاق, الحجج: لا_حجج_للإطلاق };
    دع إلى_النهاية: حافة_مسير = { الهدف: النهاية, الحجج: لا_حجج_للنهاية };
    طابق منهي_غراء(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, الحالية, غير_فارغ, إلى_الإطلاق, إلى_النهاية)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    طابق أصدر_إطلاق_مخزن_تسلسل_غراء(
        السياق, البرنامج, الأنواع, الدالة, الإطلاق, القيمة, الصفر, نوع_المتجه, نوع_العنصر
    ) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع لا_حجج_بعد: متجه معرف_قيمة_مسير = [];
    طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, الإطلاق, النهاية, &لا_حجج_بعد)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(النهاية);
}

// Destroys the owning members of a record or tuple value.
عرف أصدر_جسم_إسقاط_تجميع(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    أنواع_الأعضاء: &متجه معرف_نوع
): اختياري خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أنواع_الأعضاء) مثل طبيعي)) {
        دع نوع_العضو: معرف_نوع = (*أنواع_الأعضاء)[ف];
        دع يملك_العضو: منطقي;
        طابق يملك_تخزينا_للغراء(الأنواع, نوع_العضو) مع
        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
        | نتيجة.نجح(يملك) -> { يملك_العضو := يملك; };
        لو (يملك_العضو) {
            دع العضو: معرف_قيمة_مسير;
            طابق قيمة_غراء(أصدر_استخراج_حقل_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, ف, نوع_العضو)) مع
            | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
            | نتيجة.نجح(المعرف) -> { العضو := المعرف; };
            طابق أصدر_إسقاط_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, المدخل, العضو, نوع_العضو) مع
            | اختياري.موجود(خ) -> { أرجع اختياري.موجود(خ); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Destroys the owning payloads of the active constructor of a tagged value.
// Returns the block where the glue continues.
عرف أصدر_جسم_إسقاط_موسوم(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع عدد_المنشئات: طبيعي;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(العدد) -> { عدد_المنشئات := العدد; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    دع الوسم: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_استعلام_وسم_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, (*السياق).نوع_الوسم)) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الوسم := المعرف; };
    دع المخرج: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المخرج := المعرف; };
    دع الفخ: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { الفخ := المعرف; };
    طابق منهي_غراء(اختم_بفخ_مسير(البرنامج, الدالة, الفخ)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع الحالات: متغير متجه حالة_فرع_متعدد_مسير = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المنشئات) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الدالة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { الكتلة := المعرف; };
        دع عدد_الحمولات: طبيعي;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, م) مع
        | اختياري.موجود(العدد) -> { عدد_الحمولات := العدد; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع ح: متغير طبيعي = 0;
        طالما (ح < عدد_الحمولات) {
            دع نوع_الحمولة: معرف_نوع;
            طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, النوع, م, ح) مع
            | اختياري.موجود(المعرف) -> {
                طابق تمثيل_للغراء(الأنواع, المعرف) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(التمثيل) -> { نوع_الحمولة := التمثيل; };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
            دع تملك_الحمولة: منطقي;
            طابق يملك_تخزينا_للغراء(الأنواع, نوع_الحمولة) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(يملك) -> { تملك_الحمولة := يملك; };
            لو (تملك_الحمولة) {
                دع الحمولة: معرف_قيمة_مسير;
                طابق قيمة_غراء(أصدر_استخراج_حمولة_مسير(
                    البرنامج, &البناء, الدالة, الكتلة, القيمة, م, ح, نوع_الحمولة
                )) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(المعرف) -> { الحمولة := المعرف; };
                طابق أصدر_إسقاط_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, الكتلة, الحمولة, نوع_الحمولة) مع
                | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
                | اختياري.لا_شيء -> { };
            };
            ح := ح + 1;
        }
        دع لا_حجج_للمخرج: متجه معرف_قيمة_مسير = [];
        طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, الكتلة, المخرج, &لا_حجج_للمخرج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        دع لا_حجج: متجه معرف_قيمة_مسير = [];
        دع الحافة: حافة_مسير = { الهدف: الكتلة, الحجج: لا_حجج };
        دع الحالة: حالة_فرع_متعدد_مسير = { الوسم: م, الحافة: الحافة };
        ألحق(الحالات, الحالة);
        م := م + 1;
    }
    دع لا_حجج_للفخ: متجه معرف_قيمة_مسير = [];
    دع الافتراضي: حافة_مسير = { الهدف: الفخ, الحجج: لا_حجج_للفخ };
    دع الفرع: فرع_متعدد_مسير = { المميز: الوسم, الحالات: الحالات, الافتراضي: الافتراضي };
    طابق منهي_غراء(اختم_بفرع_متعدد_مسير(البرنامج, الدالة, المدخل, الفرع)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(المخرج);
}

// The member Types of a record or tuple, as MSIR representations.
عرف أنواع_أعضاء_تجميع_للغراء(
    الأنواع: &متغير سجل_أنواع,
    النوع: معرف_نوع,
    سجل: منطقي
): نتيجة متجه معرف_نوع, خطأ_خفض_مسير {
    دع الأعضاء: متغير متجه معرف_نوع = [];
    دع العدد: طبيعي;
    لو (سجل) {
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    } وإلا {
        طابق عدد_عناصر_صف_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(ع) -> { العدد := ع; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع العضو: متغير اختياري معرف_نوع = اختياري.لا_شيء();
        لو (سجل) { العضو := نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, ف); }
        وإلا { العضو := نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, ف); };
        طابق العضو مع
        | اختياري.موجود(المعرف) -> {
            طابق تمثيل_للغراء(الأنواع, المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(التمثيل) -> { ألحق(الأعضاء, التمثيل); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الأعضاء);
}

// The drop glue `(T) -> ()` of an owning Type.
// Drops one reference to a closure environment: when none is left, its
// destructor destroys the owned captures and the environment is released.
//   if (closure-release(f)) { closure-destructor(f)(); release(f) }
// Returns the block where the glue continues.
عرف أصدر_جسم_إسقاط_إغلاق(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الدالة: معرف_دالة_مسير,
    المدخل: معرف_كتلة_مسير,
    القيمة: معرف_قيمة_مسير
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    دع لا_مراجع: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, المدخل, هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق(), &الحجج,
        اختياري.موجود((*السياق).نوع_المنطق), اختياري.لا_شيء()
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { لا_مراجع := المعرف; };
    دع كتلة_التدمير: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { كتلة_التدمير := المعرف; };
    دع كتلة_المتابعة: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { كتلة_المتابعة := المعرف; };
    دع بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
    دع بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
    دع إلى_التدمير: حافة_مسير = { الهدف: كتلة_التدمير, الحجج: بلا_حجج_أ };
    دع إلى_المتابعة: حافة_مسير = { الهدف: كتلة_المتابعة, الحجج: بلا_حجج_ب };
    طابق منهي_غراء(اختم_بفرع_شرطي_مسير(
        البرنامج, الدالة, المدخل, لا_مراجع, إلى_التدمير, إلى_المتابعة
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع بلا_معاملات: متجه معرف_نوع = [];
    دع الفراغ: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.فراغ());
    دع نوع_المدمر: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.دالة(بلا_معاملات, الفراغ));
    دع حجج_المدمر: متجه معرف_قيمة_مسير = [القيمة];
    دع المدمر: معرف_قيمة_مسير;
    طابق قيمة_غراء(أصدر_نداء_بدائي_مسير(
        البرنامج, &البناء, الدالة, كتلة_التدمير, هوية_بدائي_مترجم.مدمر_بيئة_إغلاق(), &حجج_المدمر,
        اختياري.موجود(نوع_المدمر), اختياري.لا_شيء()
    )) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المدمر := المعرف; };
    دع بلا_حجج_ج: متجه معرف_قيمة_مسير = [];
    طابق بلا_قيمة_غراء(أصدر_نداء_غير_مباشر_مسير(
        البرنامج, &البناء, الدالة, كتلة_التدمير, المدمر, &بلا_حجج_ج, اختياري.لا_شيء()
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    طابق أصدر_تحرير_تخزين_غراء(البرنامج, الدالة, كتلة_التدمير, القيمة) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    دع بلا_حجج_د: متجه معرف_قيمة_مسير = [];
    طابق منهي_غراء(اختم_بفرع_مسير(البرنامج, الدالة, كتلة_التدمير, كتلة_المتابعة, &بلا_حجج_د)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(كتلة_المتابعة);
}

// The destructor of the environment of closures built for الهدف: a function
// `() -> ()` with the same captures, so its capture extractions read that
// environment, which drops the owned captures. Environments that own nothing
// share one destructor that does nothing.
عرف مدمر_بيئة_إغلاق_للغراء(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    الهدف: معرف_دالة_مسير
): نتيجة معرف_دالة_مسير, خطأ_خفض_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).المدمرات) مثل طبيعي)) {
        لو ((*السياق).المدمرات[ف].الدالة.القيمة == الهدف.القيمة) {
            أرجع نتيجة.نجح((*السياق).المدمرات[ف].المدمر);
        };
        ف := ف + 1;
    }
    دع الالتقاطات: متجه معرف_نوع = انسخ_مملوكا_متجه_معرف_نوع(&(*البرنامج).الدوال[الهدف.القيمة].الالتقاطات);
    دع تملك: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
        طابق يملك_تخزينا_للغراء(الأنواع, الالتقاطات[ف]) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(يملك) -> { لو (يملك) { تملك := صواب; }; };
        ف := ف + 1;
    }
    دع بلا_معاملات: متجه معرف_نوع = [];
    لو (!تملك) {
        طابق (*السياق).المدمر_الفارغ مع
        | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
        | اختياري.لا_شيء -> { };
        دع الفارغ: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &بلا_معاملات, اختياري.لا_شيء());
        دع مدخل_الفارغ: معرف_كتلة_مسير;
        طابق كتلة_غراء(البرنامج, الفارغ) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { مدخل_الفارغ := المعرف; };
        طابق منهي_غراء(اختم_بإرجاع_مسير(البرنامج, الفارغ, مدخل_الفارغ, اختياري.لا_شيء())) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        (*السياق).المدمر_الفارغ := اختياري.موجود(الفارغ);
        أرجع نتيجة.نجح(الفارغ);
    };
    دع المدمر: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &بلا_معاملات, اختياري.لا_شيء());
    طابق عين_التقاطات_دالة_مسير(البرنامج, المدمر, &الالتقاطات) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | اختياري.لا_شيء -> { };
    دع الربط: ربط_مدمر_إغلاق = { الدالة: الهدف, المدمر: المدمر };
    ألحق((*السياق).المدمرات, الربط);
    دع المدخل: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, المدمر) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المدخل := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    // As in a closure body, every capture is extracted on entry, before any
    // call: the environment is an entry fact, not preserved across calls.
    دع المملوكة: متغير متجه معرف_قيمة_مسير = [];
    دع أنواع_المملوكة: متغير متجه معرف_نوع = [];
    ف := 0;
    طالما (ف < (الطول(الالتقاطات) مثل طبيعي)) {
        دع نوع_الالتقاط: معرف_نوع = الالتقاطات[ف];
        دع يملك_الالتقاط: منطقي;
        طابق يملك_تخزينا_للغراء(الأنواع, نوع_الالتقاط) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(يملك) -> { يملك_الالتقاط := يملك; };
        لو (يملك_الالتقاط) {
            طابق قيمة_غراء(أصدر_استخراج_التقاط_مسير(
                البرنامج, &البناء, المدمر, المدخل, ف, نوع_الالتقاط
            )) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(المعرف) -> { ألحق(المملوكة, المعرف); ألحق(أنواع_المملوكة, نوع_الالتقاط); };
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(المملوكة) مثل طبيعي)) {
        طابق أصدر_إسقاط_قيمة_غراء(السياق, البرنامج, الأنواع, المدمر, المدخل, المملوكة[ف], أنواع_المملوكة[ف]) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق منهي_غراء(اختم_بإرجاع_مسير(البرنامج, المدمر, المدخل, اختياري.لا_شيء())) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(المدمر);
}

// Whether the operation is a closure construction that has no destructor yet.
عرف هدف_بناء_إغلاق_بلا_مدمر(العملية: &عملية_مسير): اختياري معرف_دالة_مسير {
    طابق *العملية مع
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        طابق البناء.المدمر مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(البناء.الدالة); }
        | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The argument of an احتفاظ_بقيمة primitive call.
عرف حجة_احتفاظ_مسير(العملية: &عملية_مسير): اختياري معرف_قيمة_مسير {
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.احتفاظ_بقيمة) -> { }
        | _ -> { أرجع اختياري.لا_شيء(); };
        لو ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(النداء.الحجج[0]);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف غراء_إسقاط(
    السياق: &متغير سياق_غراء_ملكية,
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع,
    النوع: معرف_نوع
): نتيجة معرف_دالة_مسير, خطأ_خفض_مسير {
    طابق ابحث_غراء(&(*السياق).بالإسقاط, النوع) مع
    | اختياري.موجود(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | اختياري.لا_شيء -> { };
    دع المعاملات: متجه معرف_نوع = [النوع];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &المعاملات, اختياري.لا_شيء());
    دع الربط: ربط_غراء_نوع = { النوع: النوع, الدالة: الدالة };
    ألحق((*السياق).بالإسقاط, الربط);
    دع القيمة: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, 0);
    دع المدخل: معرف_كتلة_مسير;
    طابق كتلة_غراء(البرنامج, الدالة) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المعرف) -> { المدخل := المعرف; };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الصنف: صنف_شكل_نوع_دلالي;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> { الصنف := الوصف.الصنف; }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
    دع كتلة_الإرجاع: متغير معرف_كتلة_مسير = المدخل;
    طابق الصنف مع
    | صنف_شكل_نوع_دلالي.صف -> {
        طابق أنواع_أعضاء_تجميع_للغراء(الأنواع, النوع, خطأ) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الأعضاء) -> {
            طابق أصدر_جسم_إسقاط_تجميع(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, &الأعضاء) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | صنف_شكل_نوع_دلالي.سجل -> {
        طابق أنواع_أعضاء_تجميع_للغراء(الأنواع, النوع, صواب) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الأعضاء) -> {
            طابق أصدر_جسم_إسقاط_تجميع(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, &الأعضاء) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | صنف_شكل_نوع_دلالي.تعداد -> {
        طابق أصدر_جسم_إسقاط_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | صنف_شكل_نوع_دلالي.اختيار -> {
        طابق أصدر_جسم_إسقاط_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | صنف_شكل_نوع_دلالي.نتيجة -> {
        طابق أصدر_جسم_إسقاط_موسوم(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | صنف_شكل_نوع_دلالي.صندوق -> {
        دع نوع_الحمولة: معرف_نوع;
        طابق نوع_حمولة_صندوق_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> {
            طابق تمثيل_للغراء(الأنواع, المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(التمثيل) -> { نوع_الحمولة := التمثيل; };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        دع تملك_الحمولة: منطقي;
        طابق يملك_تخزينا_للغراء(الأنواع, نوع_الحمولة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(يملك) -> { تملك_الحمولة := يملك; };
        لو (تملك_الحمولة) {
            دع المكان: معرف_قيمة_مسير;
            طابق قيمة_غراء(أصدر_صندوق_إلى_مكان_مسير(البرنامج, &البناء, الدالة, المدخل, القيمة, نوع_الحمولة)) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(المعرف) -> { المكان := المعرف; };
            دع الحمولة: معرف_قيمة_مسير;
            طابق قيمة_غراء(أصدر_تحميل_مسير(البرنامج, &البناء, الدالة, المدخل, المكان, نوع_الحمولة)) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(المعرف) -> { الحمولة := المعرف; };
            طابق أصدر_إسقاط_قيمة_غراء(السياق, البرنامج, الأنواع, الدالة, المدخل, الحمولة, نوع_الحمولة) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
            | اختياري.لا_شيء -> { };
        };
        طابق أصدر_تحرير_تخزين_غراء(البرنامج, الدالة, المدخل, القيمة) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
        | اختياري.لا_شيء -> { };
    }
    | صنف_شكل_نوع_دلالي.متجه -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> {
            طابق تمثيل_للغراء(الأنواع, المعرف) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(التمثيل) -> { نوع_العنصر := التمثيل; };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غراء()); };
        طابق أصدر_جسم_إسقاط_تسلسل(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة, النوع, نوع_العنصر) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | صنف_شكل_نوع_دلالي.بدائي(نوع_بدائي_مقنن.نص) -> {
        // Text transfers its buffer back to a byte vector, which releases it.
        دع نوع_البايتات: معرف_نوع = قنن_نوعا(الأنواع, نوع_مقنن.متجه((*السياق).نوع_البايت));
        دع البايتات: معرف_قيمة_مسير;
        طابق قيمة_غراء(أصدر_نقل_تسلسل_مملوك_مسير(
            البرنامج, &البناء, الدالة, المدخل, القيمة, نوع_البايتات
        )) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(المعرف) -> { البايتات := المعرف; };
        طابق أصدر_جسم_إسقاط_تسلسل(
            السياق, البرنامج, الأنواع, الدالة, المدخل, البايتات, نوع_البايتات, (*السياق).نوع_البايت
        ) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | صنف_شكل_نوع_دلالي.دالة -> {
        طابق أصدر_جسم_إسقاط_إغلاق(السياق, البرنامج, الأنواع, الدالة, المدخل, القيمة) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
        | نتيجة.نجح(الكتلة) -> { كتلة_الإرجاع := الكتلة; };
    }
    | _ -> {
        // Types that own nothing never reach drop glue.
        أرجع نتيجة.خطأ(خطأ_غراء());
    };
    طابق منهي_غراء(اختم_بإرجاع_مسير(البرنامج, الدالة, كتلة_الإرجاع, اختياري.لا_شيء())) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(الدالة);
}

// The argument of a release primitive call whose value owns storage: the
// releases drop elaboration emits, and explicit `حرر` calls.
عرف نداء_تحرير_مالك_مسير(
    الدالة: &دالة_مسير,
    العملية: &عملية_مسير,
    الأنواع: &متغير سجل_أنواع
): اختياري معرف_قيمة_مسير {
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.تحرير) -> { }
        | _ -> { أرجع اختياري.لا_شيء(); };
        لو ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
        دع الحجة: معرف_قيمة_مسير = النداء.الحجج[0];
        دع النوع: معرف_نوع = (*الدالة).القيم[الحجة.القيمة].النوع;
        طابق يملك_تخزينا_للغراء(الأنواع, النوع) مع
        | نتيجة.نجح(يملك) -> {
            لو (يملك) { أرجع اختياري.موجود(الحجة); };
            أرجع اختياري.لا_شيء();
        }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف هل_نداء_استنساخ_مسير(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.استنساخ) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Rewrites every explicit-copy primitive call of the lowered program into a
// call of its Type's reference wrapper, and every release of an owning value
// (drop elaboration, drops.sn, or an explicit `حرر`) into a call of its Type's
// drop glue. Runs once, after all bodies and generic instances are lowered and
// before verification.
عام عرف اخفض_غراء_الملكية_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &متغير سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع بلا_غراء: متجه ربط_غراء_نوع = [];
    دع بلا_مراجع: متجه ربط_غراء_نوع = [];
    دع بلا_إسقاط: متجه ربط_غراء_نوع = [];
    دع بلا_مدمرات: متجه ربط_مدمر_إغلاق = [];
    دع السياق: متغير سياق_غراء_ملكية = {
        بالقيمة: بلا_غراء,
        بالمرجع: بلا_مراجع,
        بالإسقاط: بلا_إسقاط,
        المدمرات: بلا_مدمرات,
        المدمر_الفارغ: اختياري.لا_شيء(),
        نوع_العدد: قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.عدد()),
        نوع_المنطق: قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.منطقي()),
        نوع_الوسم: قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ط32()),
        نوع_البايت: قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ط8())
    };
    // Glue functions appended below contain no explicit-copy calls, and their
    // releases are the raw storage releases the backends adapt.
    دع عدد_الدوال: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع د: متغير طبيعي = 0;
    طالما (د < عدد_الدوال) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق نداء_تحرير_مالك_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية, الأنواع) مع
                | اختياري.موجود(الحجة_المسقطة) -> {
                    دع نوع_المسقط: معرف_نوع = (*البرنامج).الدوال[د].القيم[الحجة_المسقطة.القيمة].النوع;
                    طابق غراء_إسقاط(&متغير السياق, البرنامج, الأنواع, نوع_المسقط) مع
                    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                    | نتيجة.نجح(غراء_المسقط) -> {
                        دع حجج_الإسقاط: متجه معرف_قيمة_مسير = [الحجة_المسقطة];
                        دع بلا_ذاكرة_للإسقاط: متجه نطاق_ذاكرة_نداء_مسير = [];
                        دع نداء_الإسقاط: نداء_مسير = {
                            الهدف: هدف_نداء_مسير.دالة_سلطان(غراء_المسقط),
                            الحجج: حجج_الإسقاط,
                            مكان_التعديل: اختياري.لا_شيء(),
                            نطاقات_الذاكرة: بلا_ذاكرة_للإسقاط,
                            عقد_النواة: اختياري.لا_شيء()
                        };
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية :=
                            عملية_مسير.نداء(نداء_الإسقاط);
                    };
                }
                | اختياري.لا_شيء -> { };
                طابق حجة_احتفاظ_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية) مع
                | اختياري.موجود(المحتفظ) -> {
                    // A copy of a value that holds closures: its copy glue.
                    دع نوع_المحتفظ: معرف_نوع = (*البرنامج).الدوال[د].القيم[المحتفظ.القيمة].النوع;
                    طابق غراء_استنساخ_بالقيمة(&متغير السياق, البرنامج, الأنواع, نوع_المحتفظ) مع
                    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                    | نتيجة.نجح(غراء_النسخ) -> {
                        دع حجج_النسخ: متجه معرف_قيمة_مسير = [المحتفظ];
                        دع بلا_ذاكرة_للنسخ: متجه نطاق_ذاكرة_نداء_مسير = [];
                        دع نداء_النسخ: نداء_مسير = {
                            الهدف: هدف_نداء_مسير.دالة_سلطان(غراء_النسخ),
                            الحجج: حجج_النسخ,
                            مكان_التعديل: اختياري.لا_شيء(),
                            نطاقات_الذاكرة: بلا_ذاكرة_للنسخ,
                            عقد_النواة: اختياري.لا_شيء()
                        };
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية :=
                            عملية_مسير.نداء(نداء_النسخ);
                    };
                }
                | اختياري.لا_شيء -> { };
                لو (هل_نداء_استنساخ_مسير(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية)) {
                    دع الحجة: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية مع
                    | عملية_مسير.نداء(النداء) -> {
                        لو ((الطول(النداء.الحجج) مثل طبيعي) == 1) {
                            الحجة := اختياري.موجود(النداء.الحجج[0]);
                        };
                    }
                    | _ -> { };
                    دع نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].الناتج مع
                    | اختياري.موجود(القيمة) -> { نوع_الناتج := اختياري.موجود(القيمة.النوع); }
                    | اختياري.لا_شيء -> { };
                    دع المرجع: معرف_قيمة_مسير;
                    طابق الحجة مع
                    | اختياري.موجود(المعرف) -> { المرجع := المعرف; }
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_غراء()); };
                    طابق نوع_الناتج مع
                    | اختياري.موجود(النوع) -> {
                        دع نوع_المرجع: معرف_نوع = (*البرنامج).الدوال[د].القيم[المرجع.القيمة].النوع;
                        طابق غراء_استنساخ_بالمرجع(&متغير السياق, البرنامج, الأنواع, نوع_المرجع, النوع) مع
                        | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                        | نتيجة.نجح(الغلاف) -> {
                            دع الحجج: متجه معرف_قيمة_مسير = [المرجع];
                            دع بلا_ذاكرة: متجه نطاق_ذاكرة_نداء_مسير = [];
                            دع النداء_الجديد: نداء_مسير = {
                                الهدف: هدف_نداء_مسير.دالة_سلطان(الغلاف),
                                الحجج: الحجج,
                                مكان_التعديل: اختياري.لا_شيء(),
                                نطاقات_الذاكرة: بلا_ذاكرة,
                                عقد_النواة: اختياري.لا_شيء()
                            };
                            (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية :=
                                عملية_مسير.نداء(النداء_الجديد);
                        };
                    }
                    | _ -> { أرجع اختياري.موجود(خطأ_غراء()); };
                };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    // Every closure construction, in lowered bodies and glue alike, gets the
    // destructor of its environment.
    د := 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق هدف_بناء_إغلاق_بلا_مدمر(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية) مع
                | اختياري.موجود(الهدف) -> {
                    دع المدمر: معرف_دالة_مسير;
                    طابق مدمر_بيئة_إغلاق_للغراء(&متغير السياق, البرنامج, الأنواع, الهدف) مع
                    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
                    | نتيجة.نجح(المعرف) -> { المدمر := المعرف; };
                    دع العملية: متغير عملية_مسير = عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ));
                    بدّل(العملية, (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية);
                    طابق العملية مع
                    | عملية_مسير.بناء_إغلاق(البناء) -> {
                        دع المحدث: متغير بناء_إغلاق_مسير = البناء;
                        المحدث.المدمر := اختياري.موجود(المدمر);
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية :=
                            عملية_مسير.بناء_إغلاق(المحدث);
                    }
                    | _ -> {
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].العملية := العملية;
                    };
                }
                | اختياري.لا_شيء -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع اختياري.لا_شيء();
}
