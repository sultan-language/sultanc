// The link name of one call shape of a C variadic function: `SYMBOL...N`,
// N the number of fixed parameters (decimal). The SultanC declaration lists
// the fixed parameters and then the promoted variadic arguments of that
// shape, e.g. `extern def printf_int(f: *u8, v: i32): i32 = "printf...1";`.
// Jisr (compiler/jisr) writes these declarations for C variadic functions.

// N of a link name `SYMBOL...N`; none for any other link name.
عام عرف ثابتة_اسم_ربط_متغير_للخفض(الاسم: &متجه ط8): اختياري طبيعي {
    دع ن: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع ف: متغير طبيعي = ن;
    طالما (ف > 0 && (*الاسم)[ف - 1] >= 0x30 && (*الاسم)[ف - 1] <= 0x39) { ف := ف - 1; }
    إذا (ف == ن || ف < 4) { أرجع اختياري.لا_شيء(); };
    إذا ((*الاسم)[ف - 1] != 0x2E || (*الاسم)[ف - 2] != 0x2E || (*الاسم)[ف - 3] != 0x2E) { أرجع اختياري.لا_شيء(); };
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = ف;
    طالما (ك < ن) {
        إذا (العدد > 1000) { أرجع اختياري.لا_شيء(); };
        العدد := العدد * 10 + (((*الاسم)[ك] - 0x30) مثل طبيعي);
        ك := ك + 1;
    }
    أرجع اختياري.موجود(العدد);
}

// SYMBOL of a link name `SYMBOL...N`.
عام عرف رمز_اسم_ربط_متغير_للخفض(الاسم: &متجه ط8): متجه ط8 {
    دع ن: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع ف: متغير طبيعي = ن;
    طالما (ف > 0 && (*الاسم)[ف - 1] >= 0x30 && (*الاسم)[ف - 1] <= 0x39) { ف := ف - 1; }
    دع الناتج: متغير متجه ط8 = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك + 3 < ف) { ألحق(الناتج, (*الاسم)[ك]); ك := ك + 1; }
    أرجع الناتج;
}
