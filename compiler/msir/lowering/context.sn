// سياق الخفض المشترك وحالة الدالة واستعلامات الحقائق الدلالية المقننة.
عام عرف هل_نوع_بدائي_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == المتوقع;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف هل_نوع_فراغ_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.فراغ());
}

عام عرف هل_نوع_منطقي_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.منطقي());
}

عام عرف هل_نوع_نص_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_للخفض(الأنواع, المعرف, نوع_بدائي_مقنن.نص());
}

عام عرف هل_نوع_عشري_للخفض(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري(); }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف وصف_صحيح_للخفض(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار وصف_صحيح_خفض {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع الناتج: وصف_صحيح_خفض = {
                    موقع: صواب,
                    البتات: البتات
                };
                أرجع اختيار.بعض(الناتج);
            }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع الناتج: وصف_صحيح_خفض = {
                    موقع: خطأ,
                    البتات: البتات
                };
                أرجع اختيار.بعض(الناتج);
            }
            | _ -> {
                أرجع اختيار.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

// `متغير T` يصف قابلية موضع المصدر للتغيير، لا تمثيل قيمة MSIR.
// نزيل الغلاف الخارجي فقط؛ أي قابلية تغيير داخل مرجع/مؤشر تبقى جزءا من النوع.
عام عرف نوع_تمثيل_قيمة_مسير_للخفض(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    أرجع أزل_غلاف_متغير(الأنواع, النوع);
}

عام عرف نوع_تعبير_للخفض(
    الأنواع: &سجل_أنواع,
    الأنواع_الدلالية: &سياق_أنواع_تعبيرات,
    التعبير: &تعبير
): نتيجة_حل_نوع_للخفض {
    دع النطاق: نطاق = نطاق_تعبير(التعبير);
    طابق نوع_تعبير_عند(الأنواع_الدلالية, النطاق) مع
    | اختيار.بعض(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختيار.بعض(نوع_التمثيل) -> {
            أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_حل_نوع_للخفض.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
            );
        };
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_نوع_للخفض.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق)
        );
    };
}

عام عرف نوع_رمز_دلالي_للخفض(
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الرمز: معرف_رمز
): نتيجة_حل_نوع_للخفض {
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختيار.بعض(النوع) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع) مع
        | اختيار.بعض(نوع_التمثيل) -> {
            أرجع نتيجة_حل_نوع_للخفض.موجود(نوع_التمثيل);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_حل_نوع_للخفض.مرفوض(
                خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)
            );
        };
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_نوع_للخفض.مرفوض(
            خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)
        );
    };
}

عام عرف رمز_اسم_للخفض(
    الروابط: &سياق_روابط_أسماء,
    الاسم: &اسم
): نتيجة معرف_رمز, خطأ_خفض_مسير {
    دع قيمة_الاسم: اسم = *الاسم;
    طابق رمز_اسم_محلول_عند(الروابط, قيمة_الاسم.النطاق) مع
    | اختيار.بعض(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.ربط_اسم_مفقود(قيمة_الاسم.النطاق));
    };
}

عام عرف سياق_دوال_خفض_جديد(): سياق_دوال_خفض {
    دع الدوال: متجه ربط_دالة_خفض = [];
    دع السياق: سياق_دوال_خفض = { الدوال: الدوال };
    أرجع السياق;
}

عام عرف موضع_دالة_خفض(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختيار غير_موقع {
    دع الحالة: سياق_دوال_خفض = *السياق;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        لو (
            معرفا_رمز_متساويان(الحالة.الدوال[ف].الرمز, الرمز)
            && استبدالات_نوع_متساوية(&الحالة.الدوال[ف].استبدالات_النوع, الاستبدالات)
        ) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف دالة_خفض_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز
): اختيار ربط_دالة_خفض {
    دع بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    أرجع دالة_خفض_بمثيل_عند(السياق, الرمز, &بلا_استبدالات);
}

عام عرف استبدالات_نوع_متساوية(
    أ: &متجه ربط_استبدال_نوع,
    ب: &متجه ربط_استبدال_نوع
): منطقي {
    دع اليسار: متجه ربط_استبدال_نوع = *أ;
    دع اليمين: متجه ربط_استبدال_نوع = *ب;
    لو (الطول(اليسار) != الطول(اليمين)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(اليسار) مثل غير_موقع)) {
        دع وجد: متغير منطقي = خطأ;
        دع ي: متغير غير_موقع = 0;
        بينما (ي < (الطول(اليمين) مثل غير_موقع)) {
            لو (
                معرفا_رمز_متساويان(اليسار[ف].المعامل, اليمين[ي].المعامل)
                && معرفا_نوع_متساويان(اليسار[ف].الحجة, اليمين[ي].الحجة)
            ) {
                وجد := صواب;
                ي := الطول(اليمين) مثل غير_موقع;
            } وإلا {
                ي := ي + 1;
            };
        }
        لو (!وجد) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف دالة_خفض_بمثيل_عند(
    السياق: &سياق_دوال_خفض,
    الرمز: معرف_رمز,
    الاستبدالات: &متجه ربط_استبدال_نوع
): اختيار ربط_دالة_خفض {
    طابق موضع_دالة_خفض(السياق, الرمز, الاستبدالات) مع
    | اختيار.بعض(الموضع) -> {
        دع الحالة: سياق_دوال_خفض = *السياق;
        دع مرجع_الربط: &ربط_دالة_خفض = &الحالة.الدوال[الموضع];
        دع الربط: ربط_دالة_خفض = *مرجع_الربط;
        أرجع اختيار.بعض(الربط);
    }
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف أضف_دالة_خفض(
    السياق: &متغير سياق_دوال_خفض,
    الربط: ربط_دالة_خفض
): منطقي {
    طابق موضع_دالة_خفض(السياق, الربط.الرمز, &الربط.استبدالات_النوع) مع
    | اختيار.بعض(_) -> {
        أرجع خطأ;
    }
    | اختيار.لا_شيء -> {
    };
    دع الحالة: متغير سياق_دوال_خفض = *السياق;
    ألحق(الحالة.الدوال, الربط);
    *السياق := الحالة;
    أرجع صواب;
}

عام عرف موضع_محلي_خفض(
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): اختيار غير_موقع {
    دع القيمة: حالة_خفض_دالة = *الحالة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة.المحليات) مثل غير_موقع)) {
        لو (معرفا_رمز_متساويان(القيمة.المحليات[ف].الرمز, الرمز)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف تأكد_محليات_خفض_فريدة(الحالة: &متغير حالة_خفض_دالة): فراغ {
    دع النسخة: متغير حالة_خفض_دالة = *الحالة;
    لو (!النسخة.المحليات_مشتركة) { أرجع; };
    دع العدد: غير_موقع = الطول(النسخة.المحليات) مثل غير_موقع;
    النسخة.المحليات := قص_محليات_خفض(&النسخة.المحليات, العدد);
    النسخة.المحليات_مشتركة := خطأ;
    *الحالة := النسخة;
}

عام عرف أضف_محلي_خفض(
    الحالة: &متغير حالة_خفض_دالة,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    القيمة: اختيار معرف_قيمة_مسير
): اختيار خطأ_خفض_مسير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختيار.بعض(_) -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.محلي_مكرر(الرمز));
    }
    | اختيار.لا_شيء -> {
    };
    تأكد_محليات_خفض_فريدة(الحالة);
    دع النسخة: متغير حالة_خفض_دالة = *الحالة;
    دع لا_مكان: اختيار معرف_قيمة_مسير = اختيار.لا_شيء();
    دع الربط: ربط_محلي_خفض = {
        الرمز: الرمز,
        النوع: النوع,
        القيمة: القيمة,
        المكان: لا_مكان
    };
    ألحق(النسخة.المحليات, الربط);
    *الحالة := النسخة;
    أرجع اختيار.لا_شيء();
}

عام عرف قيمة_محلي_خفض(
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): نتيجة_خفض_تعبير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الموضع) -> {
        دع النسخة: حالة_خفض_دالة = *الحالة;
        دع مرجع_المحلي: &ربط_محلي_خفض = &النسخة.المحليات[الموضع];
        دع المحلي: ربط_محلي_خفض = *مرجع_المحلي;
        طابق المحلي.القيمة مع
        | اختيار.بعض(المعرف) -> {
            دع القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: المحلي.النوع };
            أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز));
        };
    };
}

عام عرف خفض_قيمة_محلي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الرمز: معرف_رمز
): نتيجة_خفض_تعبير {
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
    }
    | اختيار.بعض(الموضع) -> {
        دع النسخة: حالة_خفض_دالة = *الحالة;
        دع المحلي: ربط_محلي_خفض = النسخة.المحليات[الموضع];
        طابق المحلي.القيمة مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز));
        }
        | اختيار.بعض(القيمة_المعلّمة) -> {
            طابق المحلي.المكان مع
            | اختيار.بعض(المكان) -> {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_تحميل_مسير(
                        البرنامج,
                        النسخة.الدالة,
                        النسخة.الكتلة,
                        المكان,
                        المحلي.النوع
                    ),
                    المحلي.النوع
                );
            }
            | اختيار.لا_شيء -> {
                دع القيمة: قيمة_خفض_مسير = {
                    المعرف: القيمة_المعلّمة,
                    النوع: المحلي.النوع
                };
                أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
            };
        };
    };
}

عام عرف قص_محليات_خفض(
    المحليات: &متجه ربط_محلي_خفض,
    العدد: غير_موقع
): متجه ربط_محلي_خفض {
    دع الأصل: متجه ربط_محلي_خفض = *المحليات;
    دع الناتج: متغير متجه ربط_محلي_خفض = [];
    دع ف: متغير غير_موقع = 0;
    بينما ((ف < العدد) && (ف < (الطول(الأصل) مثل غير_موقع))) {
        ألحق(الناتج, الأصل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف شارك_محليات_خفض(المحليات: &متجه ربط_محلي_خفض): متجه ربط_محلي_خفض {
    دع النسخة: متجه ربط_محلي_خفض = *المحليات;
    أرجع النسخة;
}

عام عرف انسخ_حالة_خفض(الحالة: &متغير حالة_خفض_دالة): حالة_خفض_دالة {
    دع الأصل: متغير حالة_خفض_دالة = *الحالة;
    دع المحليات_المشتركة: متجه ربط_محلي_خفض = شارك_محليات_خفض(&الأصل.المحليات);
    دع النسخة: حالة_خفض_دالة = {
        الدالة: الأصل.الدالة,
        الكتلة: الأصل.الكتلة,
        نشطة: الأصل.نشطة,
        المحليات: المحليات_المشتركة,
        له_هدف_خروج_حلقة: الأصل.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: الأصل.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: الأصل.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: الأصل.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: الأصل.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: صواب
    };
    الأصل.المحليات_مشتركة := صواب;
    *الحالة := الأصل;
    أرجع النسخة;
}

عام عرف قيمة_من_بناء_للخفض(
    النتيجة: نتيجة_بناء_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        دع القيمة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: النوع };
        أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف اختم_بفرع_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الهدف: معرف_كتلة_مسير,
    الحجج: &متجه معرف_قيمة_مسير
): اختيار خطأ_خفض_مسير {
    دع حالة_القراءة: حالة_خفض_دالة = *الحالة;
    طابق اختم_بفرع_مسير(
        البرنامج,
        حالة_القراءة.الدالة,
        حالة_القراءة.الكتلة,
        الهدف,
        الحجج
    ) مع
    | نتيجة_بناء_منهي_مسير.مبني -> {
        أرجع اختيار.لا_شيء();
    }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف أضف_كتلة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(الكتلة) -> {
        أرجع نتيجة.نجح(الكتلة);
    }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}
