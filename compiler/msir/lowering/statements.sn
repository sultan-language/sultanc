استورد compiler.frontend.types.type_context;
// تنسيق خفض العبارات والكتل والفروع والحلقات والمطابقة مع بقاء الدلالات في Frontend.

// تدفق التحكم المتشعب قد يحتوي عمليات تعدّل lvalue من غير أن تنتج قيمة SSA جديدة.
// لذلك يجب تثبيت أماكن المحليات في الكتلة المهيمنة قبل نسخ حالة الخفض إلى الفروع،
// كي تبقى هوية التخزين نفسها مشتركة بين الفروع ونقاط الدمج والحلقات.
عرف ثبّت_أماكن_محليات_قبل_تفرع_التحكم(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة
): اختياري خطأ_خفض_مسير {
    تأكد_محليات_خفض_فريدة(الحالة);
    دع الحالية: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالية.المحليات) مثل طبيعي)) {
        دع المحلي: ربط_محلي_خفض = الحالية.المحليات[ف];
        طابق المحلي.المكان مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            طابق المحلي.القيمة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(القيمة) -> {
                طابق أصدر_مكان_محلي_مسير(
                    البرنامج,
                    &الحالية.البناء,
                    الحالية.الدالة,
                    الحالية.الكتلة,
                    المحلي.النوع,
                    صواب
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.محلي_غير_مهيأ(المحلي.الرمز));
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(المكان) -> {
                    طابق أصدر_تخزين_مسير(
                        البرنامج,
                        &الحالية.البناء,
                        الحالية.الدالة,
                        الحالية.الكتلة,
                        المكان,
                        القيمة
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | _ -> { };
                    الحالية.المحليات[ف].المكان := اختياري.موجود(المكان);
                };
            };
        };
        ف := ف + 1;
    }
    *الحالة := الحالية;
    أرجع اختياري.لا_شيء();
}

عرف اخفض_إذا_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الشرط: &تعبير,
    عند_الصواب: &كتلة_عبارات,
    عند_الخطأ: اختياري كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع الأصل: حالة_خفض_دالة = *الحالة;
    طابق خفض_تعبير_إلى_مسير(
        البرنامج,
        الحالة,
        الشرط,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(قيمة_الشرط) -> {
        طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع أصل_التفرع: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_الشرط.النوع)) {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الشرط.النوع)
            );
        };
        دع كتلة_صواب: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        دع كتلة_خطأ: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_صواب := الكتلة;
        };
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_خطأ := الكتلة;
        };
        دع لا_حجج_أ: متجه معرف_قيمة_مسير = [];
        دع لا_حجج_ب: متجه معرف_قيمة_مسير = [];
        دع حافة_صواب: حافة_مسير = { الهدف: كتلة_صواب, الحجج: لا_حجج_أ };
        دع حافة_خطأ: حافة_مسير = { الهدف: كتلة_خطأ, الحجج: لا_حجج_ب };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج,
            أصل_التفرع.الدالة,
            أصل_التفرع.الكتلة,
            قيمة_الشرط.المعرف,
            حافة_صواب,
            حافة_خطأ
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };

        دع حالة_صواب: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
        حالة_صواب.الكتلة := كتلة_صواب;
        حالة_صواب.نشطة := صواب;
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج,
            التصحيح,
            الأصول,
            &متغير حالة_صواب,
            عند_الصواب,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };

        دع حالة_خطأ: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
        حالة_خطأ.الكتلة := كتلة_خطأ;
        حالة_خطأ.نشطة := صواب;
        طابق عند_الخطأ مع
        | اختياري.موجود(الجسم) -> {
            طابق خفض_كتلة_عبارات_إلى_مسير(
                البرنامج,
                التصحيح,
                الأصول,
                &متغير حالة_خطأ,
                &الجسم,
                نوع_الناتج,
                الأنواع,
                أنواع_الرموز,
                أنواع_رموز_المثيل,
                أنواع_التعبيرات,
                روابط_الأسماء,
                سجل_الأنماط,
                تحققات_الأنماط,
                دوال_الخفض,
                هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };

        إذا ((!حالة_صواب.نشطة) && (!حالة_خطأ.نشطة)) {
            دع منتهية: حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
            دع نسخة: متغير حالة_خفض_دالة = منتهية;
            نسخة.نشطة := خطأ;
            *الحالة := نسخة;
            أرجع اختياري.لا_شيء();
        };
        إذا (حالة_صواب.نشطة && (!حالة_خطأ.نشطة)) {
            *الحالة := حالة_صواب;
            أرجع اختياري.لا_شيء();
        };
        إذا ((!حالة_صواب.نشطة) && حالة_خطأ.نشطة) {
            *الحالة := حالة_خطأ;
            أرجع اختياري.لا_شيء();
        };

        دع كتلة_دمج: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_دمج := الكتلة;
        };
        دع حجج_صواب: متغير متجه معرف_قيمة_مسير = [];
        دع حجج_خطأ: متغير متجه معرف_قيمة_مسير = [];
        دع محليات_الدمج: متغير متجه ربط_محلي_خفض = [];
        دع العدد: طبيعي = الطول(أصل_التفرع.المحليات) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            دع مرجع_أساس: &ربط_محلي_خفض = &أصل_التفرع.المحليات[ف];
            دع مرجع_أ: &ربط_محلي_خفض = &حالة_صواب.المحليات[ف];
            دع مرجع_ب: &ربط_محلي_خفض = &حالة_خطأ.المحليات[ف];
            دع أساس: ربط_محلي_خفض = *مرجع_أساس;
            دع أ: ربط_محلي_خفض = *مرجع_أ;
            دع ب: ربط_محلي_خفض = *مرجع_ب;
            دع مدمج: متغير ربط_محلي_خفض = أساس;
            طابق أ.القيمة مع
            | اختياري.موجود(قيمة_أ) -> {
                طابق ب.القيمة مع
                | اختياري.موجود(قيمة_ب) -> {
                    إذا (قيمتا_مسير_متساويتان(قيمة_أ, قيمة_ب)) {
                        مدمج.القيمة := اختياري.موجود(قيمة_أ);
                    } وإلا {
                        طابق أضف_معامل_كتلة_مسير(
                            البرنامج,
                            أصل_التفرع.الدالة,
                            كتلة_دمج,
                            أساس.النوع
                        ) مع
                        | نتيجة_بناء_قيمة_مسير.مبنية(المعامل) -> {
                            ألحق(حجج_صواب, قيمة_أ);
                            ألحق(حجج_خطأ, قيمة_ب);
                            مدمج.القيمة := اختياري.موجود(المعامل);
                        }
                        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                            أرجع اختياري.موجود(
                                خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                            );
                        }
                        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                            أرجع اختياري.موجود(
                                خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)
                            );
                        };
                    };
                }
                | اختياري.لا_شيء -> {
                    مدمج.القيمة := اختياري.لا_شيء();
                };
            }
            | اختياري.لا_شيء -> {
                مدمج.القيمة := اختياري.لا_شيء();
            };
            ألحق(محليات_الدمج, مدمج);
            ف := ف + 1;
        }
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_صواب, كتلة_دمج, &حجج_صواب) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_خطأ, كتلة_دمج, &حجج_خطأ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        دع التالية: حالة_خفض_دالة = {
            الدالة: أصل_التفرع.الدالة,
            الكتلة: كتلة_دمج,
            نشطة: صواب,
            البناء: أصل_التفرع.البناء,
            المحليات: محليات_الدمج,
            له_هدف_خروج_حلقة: أصل_التفرع.له_هدف_خروج_حلقة,
            هدف_خروج_حلقة: أصل_التفرع.هدف_خروج_حلقة,
            له_هدف_متابعة_حلقة: أصل_التفرع.له_هدف_متابعة_حلقة,
            هدف_متابعة_حلقة: أصل_التفرع.هدف_متابعة_حلقة,
            عدد_محليات_متابعة_حلقة: أصل_التفرع.عدد_محليات_متابعة_حلقة,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: أصل_التفرع.إطار_الإسقاط
        };
        *الحالة := التالية;
        أرجع اختياري.لا_شيء();
    };
}

// A loop whose condition is the literal true and whose own body never breaks
// out of it does not terminate normally: its exit block is unreachable.
عرف شرط_صواب_ثابت_للخفض(الشرط: &تعبير): منطقي {
    طابق *الشرط مع
    | تعبير.حرفي(_, الحرفي) -> {
        طابق الحرفي مع
        | حرفي.منطقي(القيمة) -> { أرجع القيمة; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف كتلة_تخرج_من_حلقتها_للخفض(الكتلة: &كتلة_عبارات): منطقي {
    دع العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        دع العبارة: عبارة = *(*العبارات)[ف];
        إذا (عبارة_تخرج_من_حلقتها_للخفض(&العبارة)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Inner loops own their own breaks; a comptime block is a separate function.
عرف عبارة_تخرج_من_حلقتها_للخفض(العبارة: &عبارة): منطقي {
    طابق *العبارة مع
    | عبارة.اخرج_من_حلقة(_) -> { أرجع صواب; }
    | عبارة.إذا(_, _, الأولى, الثانية) -> {
        إذا (كتلة_تخرج_من_حلقتها_للخفض(&الأولى)) { أرجع صواب; };
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { أرجع كتلة_تخرج_من_حلقتها_للخفض(&البديلة); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        دع ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            إذا (كتلة_تخرج_من_حلقتها_للخفض(&الأذرع[ذ].الجسم)) { أرجع صواب; };
            ذ := ذ + 1;
        }
        أرجع خطأ;
    }
    | عبارة.غير_آمن(_, الكتلة) -> { أرجع كتلة_تخرج_من_حلقتها_للخفض(&الكتلة); }
    | _ -> { أرجع خطأ; };
}

عرف اخفض_بينما_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الشرط: &تعبير,
    الجسم: &كتلة_عبارات,
    الخطوة: &اختياري صندوق عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع الأصل: حالة_خفض_دالة = *الحالة;
    دع الرأس: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    دع كتلة_الجسم: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    دع الخروج: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        الرأس := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الجسم := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        الخروج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    دع كتلة_المتابعة: متغير معرف_كتلة_مسير = الرأس;
    دع لها_خطوة: متغير منطقي = خطأ;
    طابق *الخطوة مع
    | اختياري.موجود(_) -> {
        لها_خطوة := صواب;
        طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
        | نتيجة.نجح(الكتلة) -> { كتلة_المتابعة := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    }
    | اختياري.لا_شيء -> { };

    دع حجج_الدخول: متغير متجه معرف_قيمة_مسير = [];
    دع محليات_الرأس: متغير متجه ربط_محلي_خفض = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل.المحليات) مثل طبيعي)) {
        دع مرجع_المحلي: &ربط_محلي_خفض = &الأصل.المحليات[ف];
        دع المحلي: ربط_محلي_خفض = *مرجع_المحلي;
        دع مرجع_نسخة_المحلي: &ربط_محلي_خفض = &المحلي;
        دع نسخة_المحلي: متغير ربط_محلي_خفض = *مرجع_نسخة_المحلي;
        طابق المحلي.القيمة مع
        | اختياري.موجود(القيمة) -> {
            طابق أضف_معامل_كتلة_مسير(
                البرنامج,
                الأصل.الدالة,
                الرأس,
                المحلي.النوع
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(المعامل) -> {
                ألحق(حجج_الدخول, القيمة);
                نسخة_المحلي.القيمة := اختياري.موجود(المعامل);
            }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            };
        }
        | اختياري.لا_شيء -> { };
        ألحق(محليات_الرأس, نسخة_المحلي);
        ف := ف + 1;
    }
    طابق اختم_بفرع_للخفض(البرنامج, &الأصل, الرأس, &حجج_الدخول) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | اختياري.لا_شيء -> { };

    دع عدد_محليات_الرأس: طبيعي = الطول(محليات_الرأس) مثل طبيعي;
    دع محليات_حالة_الرأس: متجه ربط_محلي_خفض = قص_محليات_خفض(
        &محليات_الرأس,
        عدد_محليات_الرأس
    );
    دع حالة_الرأس: متغير حالة_خفض_دالة = {
        الدالة: الأصل.الدالة,
        الكتلة: الرأس,
        نشطة: صواب,
        البناء: الأصل.البناء,
        المحليات: محليات_حالة_الرأس,
        له_هدف_خروج_حلقة: الأصل.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: الأصل.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: الأصل.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: الأصل.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: الأصل.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: الأصل.إطار_الإسقاط
    };
    دع محليات_المتابعة: متغير متجه ربط_محلي_خفض = [];
    إذا (لها_خطوة) {
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(محليات_الرأس) مثل طبيعي)) {
            دع المحلي: ربط_محلي_خفض = محليات_الرأس[م];
            دع نسخة_المحلي: متغير ربط_محلي_خفض = المحلي;
            طابق المحلي.القيمة مع
            | اختياري.موجود(_) -> {
                طابق أضف_معامل_كتلة_مسير(
                    البرنامج, الأصل.الدالة, كتلة_المتابعة, المحلي.النوع
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعامل) -> {
                    نسخة_المحلي.القيمة := اختياري.موجود(المعامل);
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                };
            }
            | اختياري.لا_شيء -> { };
            ألحق(محليات_المتابعة, نسخة_المحلي);
            م := م + 1;
        }
    };
    طابق خفض_تعبير_إلى_مسير(
        البرنامج,
        &متغير حالة_الرأس,
        الشرط,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(قيمة_الشرط) -> {
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_الشرط.النوع)) {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الشرط.النوع)
            );
        };
        دع بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
        دع بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
        دع إلى_الجسم: حافة_مسير = { الهدف: كتلة_الجسم, الحجج: بلا_حجج_أ };
        دع إلى_الخروج: حافة_مسير = { الهدف: الخروج, الحجج: بلا_حجج_ب };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج,
            الأصل.الدالة,
            حالة_الرأس.الكتلة,
            قيمة_الشرط.المعرف,
            إلى_الجسم,
            إلى_الخروج
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    };

    دع حالة_الجسم: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير حالة_الرأس);
    حالة_الجسم.الكتلة := كتلة_الجسم;
    حالة_الجسم.نشطة := صواب;
    حالة_الجسم.له_هدف_خروج_حلقة := صواب;
    حالة_الجسم.هدف_خروج_حلقة := الخروج;
    حالة_الجسم.له_هدف_متابعة_حلقة := صواب;
    حالة_الجسم.هدف_متابعة_حلقة := كتلة_المتابعة;
    حالة_الجسم.عدد_محليات_متابعة_حلقة := الطول(الأصل.المحليات) مثل طبيعي;
    طابق خفض_كتلة_عبارات_إلى_مسير(
        البرنامج,
        التصحيح,
        الأصول,
        &متغير حالة_الجسم,
        الجسم,
        نوع_الناتج,
        الأنواع,
        أنواع_الرموز,
        أنواع_رموز_المثيل,
        أنواع_التعبيرات,
        روابط_الأسماء,
        سجل_الأنماط,
        تحققات_الأنماط,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | اختياري.لا_شيء -> { };

    إذا (حالة_الجسم.نشطة) {
        دع حجج_العودة: متغير متجه معرف_قيمة_مسير = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الأصل.المحليات) مثل طبيعي)) {
            طابق الأصل.المحليات[ت].القيمة مع
            | اختياري.موجود(_) -> {
                طابق حالة_الجسم.المحليات[ت].القيمة مع
                | اختياري.موجود(القيمة) -> {
                    ألحق(حجج_العودة, القيمة);
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(
                        خطأ_خفض_مسير.محلي_غير_مهيأ(الأصل.المحليات[ت].الرمز)
                    );
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        إذا (لها_خطوة) {
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الجسم, كتلة_المتابعة, &حجج_العودة) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        } وإلا {
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الجسم, الرأس, &حجج_العودة) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };

    إذا (لها_خطوة) {
        دع حالة_الخطوة: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير حالة_الرأس);
        حالة_الخطوة.الكتلة := كتلة_المتابعة;
        حالة_الخطوة.المحليات := محليات_المتابعة;
        حالة_الخطوة.نشطة := صواب;
        حالة_الخطوة.له_هدف_خروج_حلقة := صواب;
        حالة_الخطوة.هدف_خروج_حلقة := الخروج;
        حالة_الخطوة.له_هدف_متابعة_حلقة := صواب;
        حالة_الخطوة.هدف_متابعة_حلقة := كتلة_المتابعة;
        حالة_الخطوة.عدد_محليات_متابعة_حلقة := الطول(الأصل.المحليات) مثل طبيعي;
        طابق *الخطوة مع
        | اختياري.موجود(صندوق_الخطوة) -> {
            دع عبارة_الخطوة: عبارة = *صندوق_الخطوة;
            طابق اخفض_عبارة_إلى_مسير(
                البرنامج, التصحيح, الأصول, &متغير حالة_الخطوة, &عبارة_الخطوة, نوع_الناتج, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (حالة_الخطوة.نشطة) {
            دع حجج_العودة: متغير متجه معرف_قيمة_مسير = [];
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول(الأصل.المحليات) مثل طبيعي)) {
                طابق الأصل.المحليات[ت].القيمة مع
                | اختياري.موجود(_) -> {
                    طابق حالة_الخطوة.المحليات[ت].القيمة مع
                    | اختياري.موجود(القيمة) -> { ألحق(حجج_العودة, القيمة); }
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.محلي_غير_مهيأ(الأصل.المحليات[ت].الرمز)); };
                }
                | اختياري.لا_شيء -> { };
                ت := ت + 1;
            }
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الخطوة, الرأس, &حجج_العودة) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };

    // `while (true)` without its own break: nothing reaches the exit block.
    دع بعد_الحلقة_نشطة: متغير منطقي = صواب;
    إذا (شرط_صواب_ثابت_للخفض(الشرط) && (!كتلة_تخرج_من_حلقتها_للخفض(الجسم))) {
        طابق اختم_بفخ_مسير(البرنامج, الأصل.الدالة, الخروج) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
        بعد_الحلقة_نشطة := خطأ;
    };
    دع التالية: حالة_خفض_دالة = {
        الدالة: الأصل.الدالة,
        الكتلة: الخروج,
        نشطة: بعد_الحلقة_نشطة,
        البناء: الأصل.البناء,
        المحليات: محليات_الرأس,
        له_هدف_خروج_حلقة: الأصل.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: الأصل.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: الأصل.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: الأصل.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: الأصل.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: الأصل.إطار_الإسقاط
    };
    *الحالة := التالية;
    أرجع اختياري.لا_شيء();
}

// A direct call of the compile-time failure primitive.
عرف استدعاء_فشل_وقت_الترجمة(
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.موجود(الرمز) -> {
            طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
            | اختياري.موجود(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// A direct call of a function that never returns (the stop primitive إنهيار,
// std.process.panic): the path after it ends, so a function returning a
// value needs no return after the call.
عرف استدعاء_دالة_لا_تعود(
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.موجود(الرمز) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*دوال_الخفض).رموز_لا_تعود) مثل طبيعي)) {
                إذا (معرفا_رمز_متساويان((*دوال_الخفض).رموز_لا_تعود[ف], الرمز)) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// A scrutinee that is a temporary (a call result, or a member or element of
// one): a fresh value no local owns.
عرف مميز_مؤقت_للخفض(المميز: &تعبير): منطقي {
    أرجع هل_أصل_مؤقت_للخفض(المميز);
}

// `return local.field` after SSF moved the whole owned local: the field is
// the returned value and the local's other owning fields are destroyed here.
عرف أسقط_بقية_سجل_مرجع_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    دع الأصل: تعبير;
    دع اسم_الحقل: اسم;
    طابق *التعبير مع
    | تعبير.حقل(_, صندوق_الأصل, الحقل) -> { الأصل := *صندوق_الأصل; اسم_الحقل := الحقل; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الاسم: اسم;
    طابق الأصل مع
    | تعبير.اسم(_, القيمة) -> { الاسم := القيمة; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا (!هل_نقل_ملكية(&(*دوال_الخفض).حقائق_الملكية, &الاسم.النطاق)) { أرجع اختياري.لا_شيء(); };
    دع الرمز: معرف_رمز;
    طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
    | اختياري.موجود(القيمة) -> { الرمز := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع الموضع: طبيعي;
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(القيمة) -> { الموضع := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
    دع المكان: معرف_قيمة_مسير;
    طابق المحلي.المكان مع
    | اختياري.موجود(القيمة) -> { المكان := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق المحلي.الراية مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع المنقول: طبيعي;
    طابق معرف_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
    | اختياري.موجود(الهوية) -> {
        طابق ترتيب_حقل_سجل_دلالي_بالاسم(الأنواع, المحلي.النوع, الهوية) مع
        | اختياري.موجود(الفهرس) -> { المنقول := الفهرس; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي;
    طابق عدد_حقول_سجل_دلالي(الأنواع, المحلي.النوع) مع
    | اختياري.موجود(القيمة) -> { العدد := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق اكتب_راية_محلي_خفض(البرنامج, الحالة, الرمز, خطأ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع السجل: معرف_قيمة_مسير;
    طابق أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المكان, المحلي.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { السجل := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف != المنقول) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, المحلي.النوع, ف) مع
            | اختياري.موجود(نوع_الحقل) -> {
                إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_الحقل)) {
                    طابق أصدر_استخراج_حقل_مسير(
                        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
                        السجل, ف, نوع_الحقل
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مبنية(قيمة_الحقل) -> {
                        طابق أسقط_قيمة_خفض(البرنامج, الحالة, قيمة_الحقل, نوع_الحقل, الأنواع) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
                    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اخفض_مطابقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المميز: &تعبير,
    الأذرع: &متجه ذراع_مطابقة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نتيجة_المميز: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, المميز, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    دع حالة_قبل_المميز: حالة_خفض_دالة = *الحالة;
    دع معرف_مؤقت: معرف_قيمة_مسير = معرف_قيمة_مسير_من(حالة_قبل_المميز.الدالة, 0);
    دع نوع_مؤقت: معرف_نوع = معرف_نوع_من(0);
    دع قيمة_المميز: متغير قيمة_خفض_مسير = { المعرف: معرف_مؤقت, النوع: نوع_مؤقت };
    طابق نتيجة_المميز مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_المميز := القيمة;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };

    طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع أصل_المحليات: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    دع كتلة_الفحص: متغير معرف_كتلة_مسير = أصل_المحليات.الكتلة;
    دع حالات_الأذرع: متغير متجه حالة_خفض_دالة = [];
    دع قائمة_الأذرع: متجه ذراع_مطابقة = *الأذرع;
    دع عدد_الأذرع: طبيعي = الطول(قائمة_الأذرع) مثل طبيعي;
    دع حقائق_تحقق_الأنماط: متجه ربط_تحقق_نمط_وحدة = *تحققات_الأنماط;

    // Inspect the complete arm set before choosing a lowering strategy.
    // Do not emit the sequential match chain and then discard it: large
    // self-hosted modules have many tagged matches and would retain an
    // unnecessary graph until optimization.
    // Tag dispatch (one MSIR multiway branch on the constructor tag, as rustc
    // switches on the discriminant before testing sub-patterns): every arm's
    // root is a constructor of the scrutinee's type, with or without payload
    // patterns, except that the last arm may be irrefutable. Arms are grouped
    // by tag in source order; the switch enters the first arm of a tag, and a
    // failing payload test continues with the next arm of the same tag, then
    // with the final irrefutable arm (or a trap). Grouping keeps the source
    // semantics: an arm whose root tag differs from the value's tag can never
    // match. A payload-free constructor arm ends its tag's chain, so a later
    // arm of the same tag (unreachable) keeps the sequential strategy.
    // Previously any payload pattern disabled the switch, so matches over
    // payload-carrying enums compared tags one by one (O(n) dispatch).
    دع مرشح_توجيه_وسم: متغير منطقي = عدد_الأذرع >= 2;
    // Integer dispatch: arms that are integer literals over a u32 scrutinee
    // switch on the value itself (a jump table where the backend makes one),
    // as an enum's arms switch on its tag.
    دع توجيه_صحيح: متغير منطقي = خطأ;
    دع مميز_ط32: متغير منطقي = خطأ;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(معرف_ط32) -> { مميز_ط32 := معرفا_نوع_متساويان(معرف_ط32, قيمة_المميز.النوع); }
    | اختياري.لا_شيء -> { };
    دع مدخل_التوجيه: معرف_كتلة_مسير = كتلة_الفحص;
    دع عدد_حالات_توجيه_الوسم: متغير طبيعي = 0;
    دع وسوم_التمهيد: متغير متجه طبيعي = [];
    دع وسوم_مغلقة: متغير متجه طبيعي = [];
    // Per arm: its root tag (unused for the final irrefutable arm), whether it
    // needs no payload test, and whether it is the final irrefutable arm.
    دع وسوم_الأذرع: متغير متجه طبيعي = [];
    دع أذرع_بلا_اختبار: متغير متجه منطقي = [];
    دع ذراع_شامل_أخير: متغير منطقي = خطأ;
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_الأذرع && مرشح_توجيه_وسم) {
        دع مرجع_ذراع_التمهيد: &ذراع_مطابقة = &قائمة_الأذرع[ق];
        طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, مرجع_ذراع_التمهيد) مع
        | اختياري.موجود(الجذر) -> {
            طابق فهرس_تحقق_ربط_نمط_وحدة_عند(&حقائق_تحقق_الأنماط, الجذر) مع
            | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
            | اختياري.موجود(فهرس_التحقق) -> {
                دع الشامل: منطقي =
                    حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق.غير_قابل_للدحض;
                طابق نمط_عند(سجل_الأنماط, الجذر) مع
                | اختياري.موجود(نمط_دلالي.منشئ(_, _, الحمولات)) -> {
                    دع بلا_حمولة: منطقي = (الطول(الحمولات) مثل طبيعي) == 0;
                    طابق هوية_منشئ_نمط_محلولة_عند(&حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق, الجذر) مع
                    | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                    | اختياري.موجود(الهوية) -> {
                        طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, قيمة_المميز.النوع, الهوية) مع
                        | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                        | اختياري.موجود(الوسم) -> {
                            دع س: متغير طبيعي = 0;
                            طالما (س < (الطول(وسوم_مغلقة) مثل طبيعي)) {
                                إذا (وسوم_مغلقة[س] == الوسم) { مرشح_توجيه_وسم := خطأ; };
                                س := س + 1;
                            }
                            دع جديد: متغير منطقي = صواب;
                            س := 0;
                            طالما (س < (الطول(وسوم_التمهيد) مثل طبيعي)) {
                                إذا (وسوم_التمهيد[س] == الوسم) { جديد := خطأ; };
                                س := س + 1;
                            }
                            إذا (جديد) {
                                ألحق(وسوم_التمهيد, الوسم);
                                عدد_حالات_توجيه_الوسم := عدد_حالات_توجيه_الوسم + 1;
                            };
                            إذا (بلا_حمولة) { ألحق(وسوم_مغلقة, الوسم); };
                            ألحق(وسوم_الأذرع, الوسم);
                            ألحق(أذرع_بلا_اختبار, بلا_حمولة);
                        };
                    };
                }
                | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
                    دع وسم_حرفي: متغير اختياري طبيعي = اختياري.لا_شيء();
                    إذا (مميز_ط32) {
                        طابق الحرفي مع
                        | قيمة_نمط_حرفي.عدد(القيمة) -> {
                            إذا (القيمة >= 0 && القيمة <= 4294967295) {
                                وسم_حرفي := اختياري.موجود(القيمة مثل طبيعي);
                            };
                        }
                        | قيمة_نمط_حرفي.عدد_طبيعي(القيمة) -> {
                            إذا (القيمة <= 4294967295) { وسم_حرفي := اختياري.موجود(القيمة); };
                        }
                        | _ -> { };
                    };
                    طابق وسم_حرفي مع
                    | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                    | اختياري.موجود(الوسم) -> {
                        توجيه_صحيح := صواب;
                        // A literal arm admits nothing else: a repeated value
                        // is unreachable and keeps the arm-by-arm tests.
                        دع س: متغير طبيعي = 0;
                        طالما (س < (الطول(وسوم_مغلقة) مثل طبيعي)) {
                            إذا (وسوم_مغلقة[س] == الوسم) { مرشح_توجيه_وسم := خطأ; };
                            س := س + 1;
                        }
                        ألحق(وسوم_التمهيد, الوسم);
                        عدد_حالات_توجيه_الوسم := عدد_حالات_توجيه_الوسم + 1;
                        ألحق(وسوم_مغلقة, الوسم);
                        ألحق(وسوم_الأذرع, الوسم);
                        ألحق(أذرع_بلا_اختبار, صواب);
                    };
                }
                | اختياري.موجود(نمط_دلالي.بدل(_)) -> {
                    إذا (ق + 1 != عدد_الأذرع) { مرشح_توجيه_وسم := خطأ; };
                    ذراع_شامل_أخير := صواب;
                    ألحق(وسوم_الأذرع, 0);
                    ألحق(أذرع_بلا_اختبار, صواب);
                }
                | _ -> {
                    إذا (!الشامل || ق + 1 != عدد_الأذرع) {
                        مرشح_توجيه_وسم := خطأ;
                    } وإلا {
                        // A final irrefutable binding still runs its pattern
                        // lowering to bind the value.
                        ذراع_شامل_أخير := صواب;
                        ألحق(وسوم_الأذرع, 0);
                        ألحق(أذرع_بلا_اختبار, خطأ);
                    };
                };
            };
        }
        | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; };
        ق := ق + 1;
    }
    إذا (عدد_حالات_توجيه_الوسم < 2) { مرشح_توجيه_وسم := خطأ; };

    // Blocks of the tag-dispatch strategy, created before any arm is lowered
    // so that a failing payload test can name the next arm of its tag.
    دع كتل_أجسام_التوجيه: متغير متجه معرف_كتلة_مسير = [];
    دع كتل_دخول_التوجيه: متغير متجه معرف_كتلة_مسير = [];
    دع دخول_افتراضي_التوجيه: متغير معرف_كتلة_مسير = كتلة_الفحص;
    إذا (مرشح_توجيه_وسم) {
        دع ب: متغير طبيعي = 0;
        طالما (ب < عدد_الأذرع) {
            دع كتلة_جسم: متغير معرف_كتلة_مسير = كتلة_الفحص;
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { كتلة_جسم := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            ألحق(كتل_أجسام_التوجيه, كتلة_جسم);
            إذا (أذرع_بلا_اختبار[ب]) {
                ألحق(كتل_دخول_التوجيه, كتلة_جسم);
            } وإلا {
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> { ألحق(كتل_دخول_التوجيه, الكتلة); }
                | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
            ب := ب + 1;
        }
        إذا (ذراع_شامل_أخير) {
            دخول_افتراضي_التوجيه := كتل_دخول_التوجيه[عدد_الأذرع - 1];
        } وإلا {
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { دخول_افتراضي_التوجيه := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            طابق اختم_بفخ_مسير(البرنامج, أصل_المحليات.الدالة, دخول_افتراضي_التوجيه) مع
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
            | نتيجة_بناء_منهي_مسير.مبني -> { };
        };
    };
    دع حالات_التوجيه: متغير متجه حالة_فرع_متعدد_مسير = [];

    إذا (عدد_الأذرع == 0) {
        طابق اختم_بفخ_مسير(البرنامج, أصل_المحليات.الدالة, كتلة_الفحص) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
        دع منتهية: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        منتهية.نشطة := خطأ;
        *الحالة := منتهية;
        أرجع اختياري.لا_شيء();
    };

    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأذرع) {
        دع مرجع_الذراع: &ذراع_مطابقة = &قائمة_الأذرع[ف];
        دع الجذر: متغير معرف_نمط = معرف_نمط_من(0);
        طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, مرجع_الذراع) مع
        | اختياري.موجود(المعرف) -> {
            الجذر := المعرف;
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };

        دع فهرس_التحقق: متغير طبيعي = 0;
        طابق فهرس_تحقق_ربط_نمط_وحدة_عند(&حقائق_تحقق_الأنماط, الجذر) مع
        | اختياري.موجود(المعرف) -> { فهرس_التحقق := المعرف; }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        دع مرجع_التحقق: &تحقق_نمط_نوعي = &حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق;
        دع تحقق_الجذر: تحقق_نمط_نوعي = *مرجع_التحقق;
        دع غير_قابل_للدحض: منطقي = تحقق_الجذر.غير_قابل_للدحض;
        دع الذراع_الشامل: منطقي = ذراع_شامل_أخير && (ف + 1) == عدد_الأذرع;

        دع كتلة_الجسم: متغير معرف_كتلة_مسير = كتلة_الفحص;
        إذا (مرشح_توجيه_وسم) {
            كتلة_الجسم := كتل_أجسام_التوجيه[ف];
        } وإلا {
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> {
                كتلة_الجسم := الكتلة;
            }
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            };
        };

        // النمط غير القابل للدحض لا يحتاج مسار فشل. القيمة هنا حارس بنيوي فقط
        // ولا يستهلكها خفض النمط المقنن عندما تكون دلالات النمط غير قابلة للدحض.
        دع كتلة_التالي: متغير معرف_كتلة_مسير = كتلة_الجسم;
        إذا (!غير_قابل_للدحض && !مرشح_توجيه_وسم) {
            إذا ((ف + 1) < عدد_الأذرع) {
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_التالي := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
            } وإلا {
                دع كتلة_غير_مطابق: متغير معرف_كتلة_مسير = كتلة_الجسم;
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_غير_مطابق := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
                طابق اختم_بفخ_مسير(
                    البرنامج, أصل_المحليات.الدالة, كتلة_غير_مطابق
                ) مع
                | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_منهي_مسير.مبني -> { };
                كتلة_التالي := كتلة_غير_مطابق;
            };
        };

        // Tag dispatch: the switch enters the first arm of each tag; a
        // failing payload test continues with the next arm of the same tag,
        // otherwise with the final irrefutable arm or the trap.
        دع كتلة_فشل_التوجيه: متغير معرف_كتلة_مسير = دخول_افتراضي_التوجيه;
        إذا (مرشح_توجيه_وسم && !الذراع_الشامل) {
            دع وسم_الذراع: طبيعي = وسوم_الأذرع[ف];
            دع أول_للوسم: متغير منطقي = صواب;
            دع سابق: متغير طبيعي = 0;
            طالما (سابق < ف) {
                إذا (وسوم_الأذرع[سابق] == وسم_الذراع) { أول_للوسم := خطأ; };
                سابق := سابق + 1;
            }
            إذا (أول_للوسم) {
                دع لا_حجج_حالة: متجه معرف_قيمة_مسير = [];
                دع حافة_الدخول: حافة_مسير = {
                    الهدف: كتل_دخول_التوجيه[ف],
                    الحجج: لا_حجج_حالة
                };
                دع حالة_مباشرة: حالة_فرع_متعدد_مسير = { الوسم: وسم_الذراع, الحافة: حافة_الدخول };
                ألحق(حالات_التوجيه, حالة_مباشرة);
            };
            دع لاحق: متغير طبيعي = ف + 1;
            دع وجد_لاحق: متغير منطقي = خطأ;
            طالما (لاحق < عدد_الأذرع && !وجد_لاحق) {
                دع لاحق_شامل: منطقي = ذراع_شامل_أخير && (لاحق + 1) == عدد_الأذرع;
                إذا (!لاحق_شامل && وسوم_الأذرع[لاحق] == وسم_الذراع) {
                    كتلة_فشل_التوجيه := كتل_دخول_التوجيه[لاحق];
                    وجد_لاحق := صواب;
                };
                لاحق := لاحق + 1;
            }
        };
        إذا (مرشح_توجيه_وسم && الذراع_الشامل) {
            // Irrefutable: the failure edge is a structural guard only.
            كتلة_فشل_التوجيه := كتلة_الجسم;
        };
        دع حالة_الفحص: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        حالة_الفحص.الكتلة := كتلة_الفحص;
        حالة_الفحص.نشطة := صواب;
        إذا (مرشح_توجيه_وسم && !أذرع_بلا_اختبار[ف]) {
            حالة_الفحص.الكتلة := كتل_دخول_التوجيه[ف];
            طابق اخفض_نمط_إلى_مسير(
                البرنامج, &متغير حالة_الفحص, مرجع_التحقق, الجذر, قيمة_المميز,
                كتلة_الجسم, كتلة_فشل_التوجيه, الأنواع, روابط_الأسماء, سجل_الأنماط
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };
        إذا (!مرشح_توجيه_وسم) {
            طابق اخفض_نمط_إلى_مسير(
                البرنامج, &متغير حالة_الفحص, مرجع_التحقق, الجذر, قيمة_المميز,
                كتلة_الجسم, كتلة_التالي, الأنواع, روابط_الأسماء, سجل_الأنماط
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };

        دع حالة_الجسم: متغير حالة_خفض_دالة = حالة_الفحص;
        حالة_الجسم.الكتلة := كتلة_الجسم;
        حالة_الجسم.نشطة := صواب;
        // The arm's bindings that own their value become owners when the arm
        // is entered. Such a binding moves out of a scrutinee local, which then
        // owns nothing more (SSF moves it in this arm).
        دع عدد_محليات_الأصل: طبيعي = الطول(أصل_المحليات.المحليات) مثل طبيعي;
        دع ذراع_مالكة: متغير منطقي = خطأ;
        دع ر_ربط: متغير طبيعي = عدد_محليات_الأصل;
        طالما (ر_ربط < (الطول(حالة_الجسم.المحليات) مثل طبيعي)) {
            دع رمز_الربط: معرف_رمز = حالة_الجسم.المحليات[ر_ربط].الرمز;
            // A counted binding (drops.sn, "Counted values") copies its part
            // of the scrutinee, which keeps it: it owns the copy and moves
            // nothing out.
            دع نوع_الربط: معرف_نوع = حالة_الجسم.المحليات[ر_ربط].النوع;
            دع ربط_معدود: منطقي = هل_نوع_معدود_عادي_مسير(الأنواع, نوع_الربط);
            دع يملك_الربط: متغير منطقي = !ربط_معدود;
            إذا (ربط_معدود) {
                دع قيمة_الربط: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
                طابق حالة_الجسم.المحليات[ر_ربط].المكان مع
                | اختياري.لا_شيء -> { قيمة_الربط := حالة_الجسم.المحليات[ر_ربط].القيمة; }
                | اختياري.موجود(_) -> { };
                طابق قيمة_الربط مع
                | اختياري.موجود(المعرف) -> {
                    دع المقروءة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: نوع_الربط };
                    طابق انسخ_قيمة_معدودة_خفض(البرنامج, &متغير حالة_الجسم, المقروءة, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(المنسوخة) -> {
                        تأكد_محليات_خفض_فريدة(&متغير حالة_الجسم);
                        حالة_الجسم.المحليات[ر_ربط].القيمة := اختياري.موجود(المنسوخة.المعرف);
                        يملك_الربط := صواب;
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            إذا (يملك_الربط) {
                طابق سجل_مالكا_خفض(البرنامج, &متغير حالة_الجسم, رمز_الربط, الأنواع, دوال_الخفض) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
            إذا (!ربط_معدود) {
                طابق حالة_الجسم.المحليات[ر_ربط].الراية مع
                | اختياري.موجود(_) -> { ذراع_مالكة := صواب; }
                | اختياري.لا_شيء -> { };
            };
            ر_ربط := ر_ربط + 1;
        }
        // The scrutinee gives up what the arm moves out; the rest of it is
        // destroyed here (C2). A call result that no arm binding takes is
        // owned by the arm like a local (C1).
        دع مميز_مؤقت: منطقي = مميز_مؤقت_للخفض(المميز)
            && هل_نوع_يملك_تخزينا_مسير(الأنواع, قيمة_المميز.النوع);
        دع مميز_مالك: متغير منطقي = مميز_مؤقت;
        إذا (ذراع_مالكة) {
            طابق *المميز مع
            | تعبير.اسم(_, اسم_المميز) -> {
                طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_المميز.النطاق) مع
                | اختياري.موجود(رمز_المميز) -> {
                    طابق موضع_محلي_خفض(&حالة_الجسم, رمز_المميز) مع
                    | اختياري.موجود(موضع_المميز) -> {
                        طابق حالة_الجسم.المحليات[موضع_المميز].الراية مع
                        | اختياري.موجود(_) -> { مميز_مالك := صواب; }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    طابق اكتب_راية_محلي_خفض(البرنامج, &حالة_الجسم, رمز_المميز, خطأ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            إذا (مميز_مالك) {
                // Every part no owning binding takes (drops.sn).
                طابق أسقط_أجزاء_غير_مربوطة_خفض(
                    البرنامج, &متغير حالة_الجسم, مرجع_التحقق, الجذر, قيمة_المميز,
                    الأنواع, سجل_الأنماط
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        } وإلا إذا (مميز_مؤقت) {
            طابق سجل_مالكا_مؤقتا_خفض(
                البرنامج, &متغير حالة_الجسم, قيمة_المميز.المعرف, قيمة_المميز.النوع, الأنواع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        دع مرجع_جسم_الذراع: &كتلة_عبارات = &قائمة_الأذرع[ف].الجسم;
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج, التصحيح, الأصول, &متغير حالة_الجسم, مرجع_جسم_الذراع, نوع_الناتج,
            الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
            سجل_الأنماط, تحققات_الأنماط, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        إذا (حالة_الجسم.نشطة) {
            طابق أسقط_محليات_من_خفض(البرنامج, &متغير حالة_الجسم, عدد_محليات_الأصل) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            اقصر_محليات_حالة_خفض(
                &متغير حالة_الجسم, الطول(أصل_المحليات.المحليات) مثل طبيعي
            );
            ألحق(حالات_الأذرع, حالة_الجسم);
        };

        إذا (مرشح_توجيه_وسم) {
            ف := ف + 1;
        } وإلا {
            إذا (غير_قابل_للدحض) {
                ف := عدد_الأذرع;
            } وإلا {
                كتلة_الفحص := كتلة_التالي;
                ف := ف + 1;
            };
        };
    }

    إذا (مرشح_توجيه_وسم) {
        دع نوع_الوسم: معرف_نوع;
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
        | اختياري.موجود(المعرف) -> { نوع_الوسم := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
        دع المميز: متغير معرف_قيمة_مسير = قيمة_المميز.المعرف;
        إذا (!توجيه_صحيح) {
            طابق أصدر_استعلام_وسم_مسير(
                البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة,
                مدخل_التوجيه, قيمة_المميز.المعرف, نوع_الوسم
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { المميز := المعرف; }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        };
        دع لا_حجج_افتراضي: متجه معرف_قيمة_مسير = [];
        دع الافتراضي: حافة_مسير = {
            الهدف: دخول_افتراضي_التوجيه,
            الحجج: لا_حجج_افتراضي
        };
        دع الفرع: فرع_متعدد_مسير = {
            المميز: المميز,
            الحالات: حالات_التوجيه,
            الافتراضي: الافتراضي
        };
        طابق اختم_بفرع_متعدد_مسير(البرنامج, أصل_المحليات.الدالة, مدخل_التوجيه, الفرع) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    };

    دع عدد_الحالات_النشطة: طبيعي = الطول(حالات_الأذرع) مثل طبيعي;
    إذا (عدد_الحالات_النشطة == 0) {
        دع منتهية: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        منتهية.نشطة := خطأ;
        *الحالة := منتهية;
        أرجع اختياري.لا_شيء();
    };

    // إذا لم يبق إلا مسار واحد مستمر فلا يوجد تقارب التحكم ولا حاجة إلى كتلة دمج.
    إذا (عدد_الحالات_النشطة == 1) {
        دع مرجع_الحالة: &حالة_خفض_دالة = &حالات_الأذرع[0];
        دع النهائية: حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(مرجع_الحالة);
        *الحالة := النهائية;
        أرجع اختياري.لا_شيء();
    };

    // كتلة الدمج تنشأ كسولا فقط بعد ثبوت وجود أكثر من مسار مستمر.
    دع كتلة_الدمج: متغير معرف_كتلة_مسير = أصل_المحليات.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الدمج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };

    دع عدد_المحليات: طبيعي = الطول(أصل_المحليات.المحليات) مثل طبيعي;
    دع يحتاج_معامل: متغير متجه منطقي = [];
    دع محليات_الدمج: متغير متجه ربط_محلي_خفض = [];
    دع م: متغير طبيعي = 0;
    طالما (م < عدد_المحليات) {
        دع مرجع_أساس: &ربط_محلي_خفض = &أصل_المحليات.المحليات[م];
        دع أساس: ربط_محلي_خفض = *مرجع_أساس;
        دع مدمج: متغير ربط_محلي_خفض = أساس;

        دع مرجع_الحالة_الأولى: &حالة_خفض_دالة = &حالات_الأذرع[0];
        دع الحالة_الأولى: حالة_خفض_دالة = *مرجع_الحالة_الأولى;
        دع مرجع_المحلي_الأول: &ربط_محلي_خفض = &الحالة_الأولى.المحليات[م];
        دع المحلي_الأول: ربط_محلي_خفض = *مرجع_المحلي_الأول;
        دع أول: اختياري معرف_قيمة_مسير = المحلي_الأول.القيمة;
        دع مختلف: متغير منطقي = خطأ;

        دع ح: متغير طبيعي = 1;
        طالما (ح < عدد_الحالات_النشطة) {
            دع مرجع_حالة: &حالة_خفض_دالة = &حالات_الأذرع[ح];
            دع نسخة_حالة: حالة_خفض_دالة = *مرجع_حالة;
            دع مرجع_محلي: &ربط_محلي_خفض = &نسخة_حالة.المحليات[م];
            دع محلي_حال: ربط_محلي_خفض = *مرجع_محلي;
            طابق أول مع
            | اختياري.لا_شيء -> {
                طابق محلي_حال.القيمة مع
                | اختياري.موجود(_) -> {
                    مختلف := صواب;
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.موجود(قيمة_أولى) -> {
                طابق محلي_حال.القيمة مع
                | اختياري.موجود(قيمة_حال) -> {
                    إذا (!قيمتا_مسير_متساويتان(قيمة_أولى, قيمة_حال)) {
                        مختلف := صواب;
                    };
                }
                | اختياري.لا_شيء -> {
                    مختلف := صواب;
                };
            };
            ح := ح + 1;
        }

        إذا (مختلف) {
            طابق أضف_معامل_كتلة_مسير(
                البرنامج, أصل_المحليات.الدالة, كتلة_الدمج, أساس.النوع
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(المعامل) -> {
                مدمج.القيمة := اختياري.موجود(المعامل);
            }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            };
        } وإلا {
            مدمج.القيمة := أول;
        };
        ألحق(يحتاج_معامل, مختلف);
        ألحق(محليات_الدمج, مدمج);
        م := م + 1;
    }

    دع ح: متغير طبيعي = 0;
    طالما (ح < عدد_الحالات_النشطة) {
        دع مرجع_حالة: &حالة_خفض_دالة = &حالات_الأذرع[ح];
        دع حالة_ذراع: حالة_خفض_دالة = *مرجع_حالة;
        دع حجج: متغير متجه معرف_قيمة_مسير = [];
        م := 0;
        طالما (م < عدد_المحليات) {
            إذا (يحتاج_معامل[م]) {
                دع مرجع_محلي: &ربط_محلي_خفض = &حالة_ذراع.المحليات[م];
                دع محلي_ذراع: ربط_محلي_خفض = *مرجع_محلي;
                طابق محلي_ذراع.القيمة مع
                | اختياري.موجود(القيمة) -> {
                    ألحق(حجج, القيمة);
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.محلي_غير_مهيأ(محلي_ذراع.الرمز));
                };
            };
            م := م + 1;
        }
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_ذراع, كتلة_الدمج, &حجج) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        ح := ح + 1;
    }

    دع النهائية: حالة_خفض_دالة = {
        الدالة: أصل_المحليات.الدالة,
        الكتلة: كتلة_الدمج,
        نشطة: صواب,
        البناء: أصل_المحليات.البناء,
        المحليات: محليات_الدمج,
        له_هدف_خروج_حلقة: أصل_المحليات.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: أصل_المحليات.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: أصل_المحليات.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: أصل_المحليات.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: أصل_المحليات.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: أصل_المحليات.إطار_الإسقاط
    };
    *الحالة := النهائية;
    أرجع اختياري.لا_شيء();
}

عرف اخفض_عبارة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع القيمة: عبارة = *العبارة;
    دع أصل_العبارة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, نطاق_عبارة(&القيمة));
    دع موقع_العبارة: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, أصل_العبارة, (*الحالة).البناء.نطاق_التصحيح_الحالي,
        صواب, خطأ, خطأ, 0
    );
    عين_مرجع_تصحيح_مسير(
        &متغير (*الحالة).البناء, موقع_العبارة, (*الحالة).البناء.نطاق_التصحيح_الحالي
    );
    طابق القيمة مع
    | عبارة.تصريح_متغير(_, الاسم, _) -> {
        دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.نجح(المعرف) -> {
            الرمز := المعرف;
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        };
        طابق نوع_رمز_دلالي_للخفض(الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, الرمز) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
            طابق أضف_محلي_خفض(الحالة, الرمز, النوع, اختياري.لا_شيء()) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            أرجع سجل_مالكا_خفض(البرنامج, الحالة, الرمز, الأنواع, دوال_الخفض);
        };
    }
    | عبارة.تهيئة_سجل(النطاق, الوجهة, الحقول) -> {
        أرجع اخفض_تهيئة_سجل_إلى_مسير(
            البرنامج,
            التصحيح_المتغير,
            الحالة,
            النطاق,
            &الوجهة,
            &الحقول,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.تهيئة_صف(النطاق, الوجهة, العناصر) -> {
        أرجع اخفض_تهيئة_صف_إلى_مسير(
            البرنامج,
            التصحيح_المتغير,
            الحالة,
            النطاق,
            &الوجهة,
            &العناصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.تهيئة_متجه(النطاق, الوجهة, العناصر) -> {
        أرجع اخفض_تهيئة_متجه_إلى_مسير(
            البرنامج,
            التصحيح_المتغير,
            الحالة,
            النطاق,
            &الوجهة,
            &العناصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.تهيئة_نص(النطاق, الوجهة, البايتات) -> {
        أرجع اخفض_تهيئة_نص_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &البايتات,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.تهيئة_صندوق(النطاق, الوجهة, الحمولة) -> {
        أرجع اخفض_تهيئة_صندوق_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &الحمولة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.نسخ(النطاق, الوجهة, المصدر) -> {
        أرجع اخفض_نسخ_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &المصدر,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.استدعاء(النطاق, التعبير) -> {
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &التعبير,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_خفض_تعبير.قيمة(الناتج_المهمل) -> {
            // The statement discards the call's owned result.
            إذا ((*الحالة).نشطة) {
                طابق أسقط_قيمة_خفض(البرنامج, الحالة, الناتج_المهمل.المعرف, الناتج_المهمل.النوع, الأنواع) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { };
        // A compile-time failure never continues: its block ends in a trap,
        // the only behaviour left once the driver has removed the call after
        // compile-time evaluation (driver/compile_time.sn).
        إذا ((استدعاء_فشل_وقت_الترجمة(&التعبير, روابط_الأسماء, هويات_البدائيات)
                || استدعاء_دالة_لا_تعود(&التعبير, روابط_الأسماء, دوال_الخفض))
            && (*الحالة).نشطة) {
            طابق اختم_بفخ_مسير(البرنامج, (*الحالة).الدالة, (*الحالة).الكتلة) مع
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            }
            | نتيجة_بناء_منهي_مسير.مبني -> { };
            دع منتهية: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            منتهية.نشطة := خطأ;
            *الحالة := منتهية;
        };
        أرجع اختياري.لا_شيء();
    }
    | عبارة.أرجع(النطاق, التعبير) -> {
        دع حالة_الإرجاع: حالة_خفض_دالة = *الحالة;
        طابق التعبير مع
        | اختياري.لا_شيء -> {
            طابق نوع_الناتج مع
            | اختياري.موجود(المتوقع) -> {
                أرجع اختياري.موجود(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, المتوقع)
                );
            }
            | اختياري.لا_شيء -> { };
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإرجاع, اختياري.لا_شيء()) مع
            | اختياري.لا_شيء -> {
                دع نسخة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
                نسخة.نشطة := خطأ;
                *الحالة := نسخة;
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            };
        }
        | اختياري.موجود(قيمة_التعبير) -> {
            دع المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
            طابق نوع_الناتج مع
            | اختياري.موجود(النوع) -> {
                المتوقع := النوع;
            }
            | اختياري.لا_شيء -> {
                // A void function returning a void expression (`return f()`,
                // or a generic instance whose result Type is void): evaluate
                // it for its effects, then return nothing.
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_خفض_تعبير.قيمة(_) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                إذا (!(*الحالة).نشطة) { أرجع اختياري.لا_شيء(); };
                طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, الحالة, اختياري.لا_شيء()) مع
                | اختياري.لا_شيء -> {
                    (*الحالة).نشطة := خطأ;
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
            // The caller owns the returned value.
            طابق خفض_تعبير_مملوكا_إلى_مسير(
                البرنامج,
                الحالة,
                &قيمة_التعبير,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(الناتج) -> {
                دع الناتج_المقنن: متغير قيمة_خفض_مسير = الناتج;
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, الناتج, المتوقع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { الناتج_المقنن := القيمة; }
                | نتيجة_خفض_تعبير.مرفوض(_) -> {
                    أرجع اختياري.موجود(
                        خطأ_خفض_مسير.نوع_إرجاع_غير_مطابق(
                            النطاق, الناتج.النوع, المتوقع
                        )
                    );
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                };
                طابق أسقط_بقية_سجل_مرجع_خفض(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, روابط_الأسماء, دوال_الخفض
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, الحالة, اختياري.موجود(الناتج_المقنن.المعرف)) مع
                | اختياري.لا_شيء -> {
                    (*الحالة).نشطة := خطأ;
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
            };
        };
    }
    | عبارة.طابق(النطاق, المميز, الأذرع) -> {
        أرجع اخفض_مطابقة_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول, الحالة, النطاق, &المميز, &الأذرع, نوع_الناتج,
            الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
            سجل_الأنماط, تحققات_الأنماط, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.إذا(النطاق, الشرط, عند_الصواب, عند_الخطأ) -> {
        أرجع اخفض_إذا_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &عند_الصواب,
            انسخ_مملوكا_اختيار_كتلة_عبارات(&عند_الخطأ),
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.طالما(النطاق, الشرط, الجسم) -> {
        دع بلا_خطوة: اختياري صندوق عبارة = اختياري.لا_شيء();
        أرجع اخفض_بينما_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &الجسم,
            &بلا_خطوة,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
        دع حالة_قبل_لكل: حالة_خفض_دالة = *الحالة;
        دع عدد_المحليات_الخارجية: طبيعي = الطول(حالة_قبل_لكل.المحليات) مثل طبيعي;
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(البداية) مثل طبيعي)) {
            دع عبارة_البداية: عبارة = *البداية[ب];
            طابق اخفض_عبارة_إلى_مسير(
                البرنامج, التصحيح_المتغير, الأصول, الحالة, &عبارة_البداية, نوع_الناتج, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
                دوال_الخفض, هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ب := ب + 1;
        }
        دع خطوة_اختيارية: اختياري صندوق عبارة = اختياري.موجود(انسخ_مملوكا_صندوق_عبارة(&الخطوة));
        طابق اخفض_بينما_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &الجسم,
            &خطوة_اختيارية,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            // The loop's init locals end with it: destroy their owners first.
            طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_المحليات_الخارجية) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            اقصر_محليات_حالة_خفض(الحالة, عدد_المحليات_الخارجية);
            أرجع اختياري.لا_شيء();
        };
    }
    | عبارة.اخرج_من_حلقة(النطاق) -> {
        إذا (!(*الحالة).له_هدف_خروج_حلقة) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        دع هدف_الخروج: معرف_كتلة_مسير = (*الحالة).هدف_خروج_حلقة;
        // Leaving the loop body destroys its owners.
        طابق أسقط_محليات_من_خفض(البرنامج, الحالة, (*الحالة).عدد_محليات_متابعة_حلقة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع بلا_حجج: متجه معرف_قيمة_مسير = [];
        طابق اختم_بفرع_للخفض(البرنامج, الحالة, هدف_الخروج, &بلا_حجج) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            دع منتهية: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            منتهية.نشطة := خطأ;
            *الحالة := منتهية;
            أرجع اختياري.لا_شيء();
        };
    }
    | عبارة.تابع_حلقة(النطاق) -> {
        إذا (!(*الحالة).له_هدف_متابعة_حلقة) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        // Continuing destroys the loop body's owners.
        طابق أسقط_محليات_من_خفض(البرنامج, الحالة, (*الحالة).عدد_محليات_متابعة_حلقة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع الحالية: حالة_خفض_دالة = *الحالة;
        دع الحجج: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الحالية.عدد_محليات_متابعة_حلقة) {
            طابق الحالية.المحليات[ف].القيمة مع
            | اختياري.موجود(القيمة) -> { ألحق(الحجج, القيمة); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        طابق اختم_بفرع_للخفض(البرنامج, الحالة, الحالية.هدف_متابعة_حلقة, &الحجج) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            (*الحالة).نشطة := خطأ;
            أرجع اختياري.لا_شيء();
        };
    }
    | عبارة.وقت_الترجمة(النطاق, الجسم) -> {
        // Statement-form comptime lowers into an ordinary isolated MSIR
        // function, with no runtime arguments or captured mutable state.
        // The driver executes this verified function exactly once and removes
        // its call before the Native/LLVM/normal-interpreter consumers run.
        دع بلا_معاملات: متجه معرف_نوع = [];
        دع بلا_ناتج: اختياري معرف_نوع = اختياري.لا_شيء();
        دع الدالة_المسبقة: معرف_دالة_مسير = أضف_دالة_مسير(
            البرنامج, &بلا_معاملات, بلا_ناتج
        );
        دع المدخل_المسبق: معرف_كتلة_مسير;
        طابق أضف_كتلة_للخفض(البرنامج, الدالة_المسبقة) مع
        | نتيجة.نجح(الكتلة) -> { المدخل_المسبق := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        دع المحليات_المسبقة: متجه ربط_محلي_خفض = [];
        دع حالة_مسبقة: متغير حالة_خفض_دالة = {
            الدالة: الدالة_المسبقة,
            الكتلة: المدخل_المسبق,
            نشطة: صواب,
            البناء: حالة_بناء_مسير_جديدة(),
            المحليات: المحليات_المسبقة,
            له_هدف_خروج_حلقة: خطأ,
            هدف_خروج_حلقة: المدخل_المسبق,
            له_هدف_متابعة_حلقة: خطأ,
            هدف_متابعة_حلقة: المدخل_المسبق,
            عدد_محليات_متابعة_حلقة: 0,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: اختياري.لا_شيء()
        };
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول, &متغير حالة_مسبقة,
            &الجسم, بلا_ناتج, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل,
            أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        إذا (حالة_مسبقة.نشطة) {
            طابق اختم_بإرجاع_مسير(
                البرنامج, الدالة_المسبقة, حالة_مسبقة.الكتلة,
                اختياري.لا_شيء()
            ) مع
            | نتيجة_بناء_منهي_مسير.مبني -> { }
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            };
        };
        دع لا_حجج: متجه معرف_قيمة_مسير = [];
        طابق أصدر_نداء_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة,
            (*الحالة).الكتلة, الدالة_المسبقة, &لا_حجج
        ) مع
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        دع عدد_التعليمات: طبيعي = الطول((*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات) مثل طبيعي;
        إذا (عدد_التعليمات == 0) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        (*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات[عدد_التعليمات - 1].تقييم_وقت_الترجمة := صواب;
        أرجع اختياري.لا_شيء();
    }
    | عبارة.إسناد_وقت_الترجمة(النطاق, الوجهة, الجسم, الناتج) -> {
        // The block and its result form an independent MSIR function
        // returning the destination's type, called once and marked for
        // compile-time evaluation; the driver replaces the call by its
        // constant result before any backend runs (driver/compile_time.sn).
        // The place then receives that value like an ordinary assignment.
        دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الوجهة) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_حل_نوع_للخفض.موجود(النوع) -> { نوع_الوجهة := النوع; };
        دع بلا_معاملات: متجه معرف_نوع = [];
        دع الدالة_المسبقة: معرف_دالة_مسير = أضف_دالة_مسير(
            البرنامج, &بلا_معاملات, اختياري.موجود(نوع_الوجهة)
        );
        دع المدخل_المسبق: معرف_كتلة_مسير;
        طابق أضف_كتلة_للخفض(البرنامج, الدالة_المسبقة) مع
        | نتيجة.نجح(الكتلة) -> { المدخل_المسبق := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        دع المحليات_المسبقة: متجه ربط_محلي_خفض = [];
        دع حالة_مسبقة: متغير حالة_خفض_دالة = {
            الدالة: الدالة_المسبقة,
            الكتلة: المدخل_المسبق,
            نشطة: صواب,
            البناء: حالة_بناء_مسير_جديدة(),
            المحليات: المحليات_المسبقة,
            له_هدف_خروج_حلقة: خطأ,
            هدف_خروج_حلقة: المدخل_المسبق,
            له_هدف_متابعة_حلقة: خطأ,
            هدف_متابعة_حلقة: المدخل_المسبق,
            عدد_محليات_متابعة_حلقة: 0,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: اختياري.لا_شيء()
        };
        // The statements are lowered directly in the frame's own state, not
        // as a nested lexical block: the trailing result expression belongs
        // to the same frame and must still see the block's locals. The frame
        // state is discarded afterwards, so nothing leaks to the caller.
        دع بلا_ناتج_للجسم: اختياري معرف_نوع = اختياري.لا_شيء();
        دع ع_مسبق: متغير طبيعي = 0;
        طالما (ع_مسبق < (الطول(الجسم.العبارات) مثل طبيعي) && حالة_مسبقة.نشطة) {
            دع مرجع_عبارة_مسبقة: &صندوق عبارة = &الجسم.العبارات[ع_مسبق];
            دع صندوق_مسبق: صندوق عبارة = *مرجع_عبارة_مسبقة;
            دع العبارة_المسبقة: عبارة = *صندوق_مسبق;
            طابق اخفض_عبارة_إلى_مسير(
                البرنامج, التصحيح_المتغير, الأصول, &متغير حالة_مسبقة,
                &العبارة_المسبقة, بلا_ناتج_للجسم, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
                سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ع_مسبق := ع_مسبق + 1;
        }
        إذا (حالة_مسبقة.نشطة) {
            دع قيمة_الناتج: متغير قيمة_خفض_مسير = {
                المعرف: معرف_قيمة_مسير_من(الدالة_المسبقة, 0),
                النوع: نوع_الوجهة
            };
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, &متغير حالة_مسبقة, &الناتج, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الناتج := القيمة; };
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, &حالة_مسبقة, النطاق, قيمة_الناتج, نوع_الوجهة, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(المقننة) -> { قيمة_الناتج := المقننة; }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            };
            طابق اختم_بإرجاع_مسير(
                البرنامج, الدالة_المسبقة, حالة_مسبقة.الكتلة,
                اختياري.موجود(قيمة_الناتج.المعرف)
            ) مع
            | نتيجة_بناء_منهي_مسير.مبني -> { }
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            };
        };
        دع لا_حجج_مسبقة: متجه معرف_قيمة_مسير = [];
        دع المعرف_الناتج: معرف_قيمة_مسير;
        طابق أصدر_نداء_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة,
            (*الحالة).الكتلة, الدالة_المسبقة, &لا_حجج_مسبقة
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { المعرف_الناتج := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        دع عدد_تعليمات_المستدعي: طبيعي = الطول((*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات) مثل طبيعي;
        إذا (عدد_تعليمات_المستدعي == 0) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        (*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات[عدد_تعليمات_المستدعي - 1].تقييم_وقت_الترجمة := صواب;
        دع القيمة_المسبقة: قيمة_خفض_مسير = { المعرف: المعرف_الناتج, النوع: نوع_الوجهة };
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, القيمة_المسبقة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.غير_آمن(_, الجسم) -> {
        أرجع خفض_كتلة_عبارات_إلى_مسير(
            البرنامج,
            التصحيح_المتغير,
            الأصول,
            الحالة,
            &الجسم,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | _ -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_فارغ()));
    };
}

عام عرف خفض_كتلة_عبارات_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    الجسم: &كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع الأصل: كتلة_عبارات = *الجسم;
    // Read the entry facts before the state is updated in place.
    دع النطاق_السابق: اختياري معرف_نطاق_تصحيح = (*الحالة).البناء.نطاق_التصحيح_الحالي;
    دع عدد_الخارجية: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    طابق نطاق_تصحيح_لنطاق_مصدر(&(*التصحيح).العقد, (*الحالة).الدالة, الأصل.النطاق) مع
    | اختياري.موجود(معرف_النطاق) -> { (*الحالة).البناء.نطاق_التصحيح_الحالي := اختياري.موجود(معرف_النطاق); }
    | اختياري.لا_شيء -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل.العبارات) مثل طبيعي)) {
        دع حالة_حالية: حالة_خفض_دالة = *الحالة;
        إذا (!حالة_حالية.نشطة) {
            اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
            (*الحالة).البناء.نطاق_التصحيح_الحالي := النطاق_السابق;
            أرجع اختياري.لا_شيء();
        };
        دع مرجع_صندوق_العبارة: &صندوق عبارة = &الأصل.العبارات[ف];
        دع صندوق_العبارة: صندوق عبارة = *مرجع_صندوق_العبارة;
        دع العبارة: عبارة = *صندوق_العبارة;
        طابق اخفض_عبارة_إلى_مسير(
            البرنامج, التصحيح, الأصول,
            الحالة,
            &العبارة,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // The block's owners are destroyed when it ends.
    طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_الخارجية) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
    (*الحالة).البناء.نطاق_التصحيح_الحالي := النطاق_السابق;
    أرجع اختياري.لا_شيء();
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

