// The `أرجع` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_أرجع_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.أرجع(النطاق, التعبير) -> {
        ليكن حالة_الإرجاع: حالة_خفض_دالة = *الحالة;
        طابق التعبير مع
        | اختياري.لا_شيء -> {
            طابق نوع_الناتج مع
            | اختياري.موجود(المتوقع) -> {
                أرجع اختياري.موجود(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, المتوقع)
                );
            }
            | اختياري.لا_شيء -> { };
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإرجاع, اختياري.لا_شيء()) مع
            | اختياري.لا_شيء -> {
                ليكن نسخة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
                نسخة.نشطة := خطأ;
                *الحالة := نسخة;
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            };
        }
        | اختياري.موجود(قيمة_التعبير) -> {
            ليكن المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
            طابق نوع_الناتج مع
            | اختياري.موجود(النوع) -> {
                المتوقع := النوع;
            }
            | اختياري.لا_شيء -> {
                // A void function returning a void expression (`return f()`,
                // or a generic instance whose result Type is void): evaluate
                // it for its effects, then return nothing.
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_خفض_تعبير.قيمة(_) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                سجل_هروب_استعارة_خفض(البرنامج, الحالة, &قيمة_التعبير, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض);
                سجل_قيمة_إرجاع_استعارة_خفض(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
                إذا (!(*الحالة).نشطة) { أرجع اختياري.لا_شيء(); };
                طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, الحالة, اختياري.لا_شيء()) مع
                | اختياري.لا_شيء -> {
                    (*الحالة).نشطة := خطأ;
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
            // The caller owns the returned value.
            طابق خفض_تعبير_مملوكا_إلى_مسير(
                البرنامج,
                الحالة,
                &قيمة_التعبير,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(الناتج) -> {
                ليكن الناتج_المقنن: متغير قيمة_خفض_مسير = الناتج;
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, الناتج, المتوقع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { الناتج_المقنن := القيمة; }
                | نتيجة_خفض_تعبير.مرفوض(_) -> {
                    أرجع اختياري.موجود(
                        خطأ_خفض_مسير.نوع_إرجاع_غير_مطابق(
                            النطاق, الناتج.النوع, المتوقع
                        )
                    );
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                };
                // The returned value leaves the function (borrow_events.sn).
                سجل_هروب_استعارة_خفض(البرنامج, الحالة, &قيمة_التعبير, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض);
                سجل_قيمة_إرجاع_استعارة_خفض(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
                طابق أسقط_بقية_سجل_مرجع_خفض(
                    البرنامج, الحالة, &قيمة_التعبير, الأنواع, روابط_الأسماء, دوال_الخفض
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, الحالة, اختياري.موجود(الناتج_المقنن.المعرف)) مع
                | اختياري.لا_شيء -> {
                    (*الحالة).نشطة := خطأ;
                    أرجع اختياري.لا_شيء();
                }
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
            };
        };
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `طالما` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_طالما_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.طالما(النطاق, الشرط, الجسم) -> {
        ليكن بلا_خطوة: اختياري صندوق عبارة = اختياري.لا_شيء();
        أرجع اخفض_بينما_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &الجسم,
            &بلا_خطوة,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `لكل` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_لكل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.لكل(النطاق, البداية, الشرط, الخطوة, الجسم) -> {
        ليكن حالة_قبل_لكل: حالة_خفض_دالة = *الحالة;
        ليكن عدد_المحليات_الخارجية: طبيعي = الطول(حالة_قبل_لكل.المحليات) مثل طبيعي;
        ليكن ب: متغير طبيعي = 0;
        // A `for`'s own locals are never borrowed views.
        ليكن يجد_العروض: منطقي = (*الحالة).يجد_العروض;
        (*الحالة).يجد_العروض := خطأ;
        طالما (ب < (الطول(البداية) مثل طبيعي)) {
            ليكن عبارة_البداية: عبارة = *البداية[ب];
            طابق اخفض_عبارة_بأحداث_إلى_مسير(
                البرنامج, التصحيح_المتغير, الأصول, الحالة, &عبارة_البداية, نوع_الناتج, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
                دوال_الخفض, هويات_البدائيات, صواب
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ب := ب + 1;
        }
        (*الحالة).يجد_العروض := يجد_العروض;
        ليكن خطوة_اختيارية: اختياري صندوق عبارة = اختياري.موجود(انسخ_مملوكا_صندوق_عبارة(&الخطوة));
        طابق اخفض_بينما_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &الجسم,
            &خطوة_اختيارية,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            // The loop's init locals end with it: destroy their owners first.
            طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_المحليات_الخارجية, نهاية_نطاق_خفض(النطاق)) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            اقصر_محليات_حالة_خفض(الحالة, عدد_المحليات_الخارجية);
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `اخرج_من_حلقة` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_اخرج_من_حلقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة
): اختياري خطأ_خفض_مسير {
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.اخرج_من_حلقة(النطاق) -> {
        إذا (!(*الحالة).له_هدف_خروج_حلقة) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        ليكن هدف_الخروج: معرف_كتلة_مسير = (*الحالة).هدف_خروج_حلقة;
        // Leaving the loop body destroys its owners.
        طابق أسقط_محليات_من_خفض(البرنامج, الحالة, (*الحالة).عدد_محليات_متابعة_حلقة, النطاق) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        طابق اختم_بفرع_للخفض(البرنامج, الحالة, هدف_الخروج, []) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            ليكن منتهية: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            منتهية.نشطة := خطأ;
            *الحالة := منتهية;
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `تابع_حلقة` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_تابع_حلقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة
): اختياري خطأ_خفض_مسير {
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.تابع_حلقة(النطاق) -> {
        إذا (!(*الحالة).له_هدف_متابعة_حلقة) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        // Continuing destroys the loop body's owners.
        طابق أسقط_محليات_من_خفض(البرنامج, الحالة, (*الحالة).عدد_محليات_متابعة_حلقة, النطاق) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ليكن الحالية: حالة_خفض_دالة = *الحالة;
        طابق اختم_بفرع_للخفض(البرنامج, الحالة, الحالية.هدف_متابعة_حلقة, []) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> {
            (*الحالة).نشطة := خطأ;
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `وقت_الترجمة` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_وقت_الترجمة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.وقت_الترجمة(النطاق, الجسم) -> {
        // Statement-form comptime lowers into an ordinary isolated MSIR
        // function, with no runtime arguments or captured mutable state.
        // The driver executes this verified function exactly once and removes
        // its call before the Native/LLVM/normal-interpreter consumers run.
        ليكن بلا_معاملات: متجه معرف_نوع = [];
        ليكن بلا_ناتج: اختياري معرف_نوع = اختياري.لا_شيء();
        ليكن الدالة_المسبقة: معرف_دالة_مسير = أضف_دالة_مسير(
            البرنامج, &بلا_معاملات, بلا_ناتج
        );
        سجل_أصل_دالة_مصدرية_خفض(البرنامج, الدالة_المسبقة, اختياري.لا_شيء(), اختياري.موجود((*الحالة).الدالة));
        ليكن المدخل_المسبق: معرف_كتلة_مسير;
        طابق أضف_كتلة_للخفض(البرنامج, الدالة_المسبقة) مع
        | نتيجة.نجح(الكتلة) -> { المدخل_المسبق := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        ليكن المحليات_المسبقة: متجه ربط_محلي_خفض = [];
        ليكن حالة_مسبقة: متغير حالة_خفض_دالة = {
            الدالة: الدالة_المسبقة,
            الكتلة: المدخل_المسبق,
            نشطة: صواب,
            البناء: حالة_بناء_مسير_جديدة(),
            المحليات: المحليات_المسبقة,
            له_هدف_خروج_حلقة: خطأ,
            هدف_خروج_حلقة: المدخل_المسبق,
            له_هدف_متابعة_حلقة: خطأ,
            هدف_متابعة_حلقة: المدخل_المسبق,
            عدد_محليات_متابعة_حلقة: 0,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: اختياري.لا_شيء(),
            العروض: انسخ_عروض_خفض(&(*الحالة).العروض),
            يجد_العروض: (*الحالة).يجد_العروض,
            للتحليل: (*الحالة).للتحليل
        };
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول, &متغير حالة_مسبقة,
            &الجسم, بلا_ناتج, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل,
            أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        إذا (حالة_مسبقة.نشطة) {
            طابق اختم_بإرجاع_مسير(
                البرنامج, &حالة_مسبقة.البناء, الدالة_المسبقة, حالة_مسبقة.الكتلة,
                اختياري.لا_شيء()
            ) مع
            | نتيجة_بناء_منهي_مسير.مبني -> { }
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            };
        };
        طابق أصدر_نداء_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة,
            (*الحالة).الكتلة, الدالة_المسبقة, []
        ) مع
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        ليكن عدد_التعليمات: طبيعي = الطول((*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات) مثل طبيعي;
        إذا (عدد_التعليمات == 0) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        (*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات[عدد_التعليمات - 1].تقييم_وقت_الترجمة := صواب;
        أرجع اختياري.لا_شيء();
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `إسناد_وقت_الترجمة` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_إسناد_وقت_الترجمة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.إسناد_وقت_الترجمة(النطاق, الوجهة, الجسم, الناتج) -> {
        // The block and its result form an independent MSIR function
        // returning the destination's type, called once and marked for
        // compile-time evaluation; the driver replaces the call by its
        // constant result before any backend runs (driver/compile_time.sn).
        // The place then receives that value like an ordinary assignment.
        ليكن نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الوجهة) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_حل_نوع_للخفض.موجود(النوع) -> { نوع_الوجهة := النوع; };
        ليكن بلا_معاملات: متجه معرف_نوع = [];
        ليكن الدالة_المسبقة: معرف_دالة_مسير = أضف_دالة_مسير(
            البرنامج, &بلا_معاملات, اختياري.موجود(نوع_الوجهة)
        );
        سجل_أصل_دالة_مصدرية_خفض(البرنامج, الدالة_المسبقة, اختياري.لا_شيء(), اختياري.موجود((*الحالة).الدالة));
        ليكن المدخل_المسبق: معرف_كتلة_مسير;
        طابق أضف_كتلة_للخفض(البرنامج, الدالة_المسبقة) مع
        | نتيجة.نجح(الكتلة) -> { المدخل_المسبق := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        ليكن المحليات_المسبقة: متجه ربط_محلي_خفض = [];
        ليكن حالة_مسبقة: متغير حالة_خفض_دالة = {
            الدالة: الدالة_المسبقة,
            الكتلة: المدخل_المسبق,
            نشطة: صواب,
            البناء: حالة_بناء_مسير_جديدة(),
            المحليات: المحليات_المسبقة,
            له_هدف_خروج_حلقة: خطأ,
            هدف_خروج_حلقة: المدخل_المسبق,
            له_هدف_متابعة_حلقة: خطأ,
            هدف_متابعة_حلقة: المدخل_المسبق,
            عدد_محليات_متابعة_حلقة: 0,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: اختياري.لا_شيء(),
            العروض: انسخ_عروض_خفض(&(*الحالة).العروض),
            يجد_العروض: (*الحالة).يجد_العروض,
            للتحليل: (*الحالة).للتحليل
        };
        // The statements are lowered directly in the frame's own state, not
        // as a nested lexical block: the trailing result expression belongs
        // to the same frame and must still see the block's locals. The frame
        // state is discarded afterwards, so nothing leaks to the caller.
        ليكن بلا_ناتج_للجسم: اختياري معرف_نوع = اختياري.لا_شيء();
        ليكن ع_مسبق: متغير طبيعي = 0;
        طالما (ع_مسبق < (الطول(الجسم.العبارات) مثل طبيعي) && حالة_مسبقة.نشطة) {
            ليكن مرجع_عبارة_مسبقة: &صندوق عبارة = &الجسم.العبارات[ع_مسبق];
            ليكن صندوق_مسبق: صندوق عبارة = *مرجع_عبارة_مسبقة;
            ليكن العبارة_المسبقة: عبارة = *صندوق_مسبق;
            طابق اخفض_عبارة_إلى_مسير(
                البرنامج, التصحيح_المتغير, الأصول, &متغير حالة_مسبقة,
                &العبارة_المسبقة, بلا_ناتج_للجسم, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
                سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ع_مسبق := ع_مسبق + 1;
        }
        إذا (حالة_مسبقة.نشطة) {
            ليكن قيمة_الناتج: متغير قيمة_خفض_مسير = {
                المعرف: معرف_قيمة_مسير_من(الدالة_المسبقة, 0),
                النوع: نوع_الوجهة
            };
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, &متغير حالة_مسبقة, &الناتج, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الناتج := القيمة; };
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, &حالة_مسبقة, النطاق, قيمة_الناتج, نوع_الوجهة, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(المقننة) -> { قيمة_الناتج := المقننة; }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
            };
            طابق اختم_بإرجاع_مسير(
                البرنامج, &حالة_مسبقة.البناء, الدالة_المسبقة, حالة_مسبقة.الكتلة,
                اختياري.موجود(قيمة_الناتج.المعرف)
            ) مع
            | نتيجة_بناء_منهي_مسير.مبني -> { }
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            };
        };
        ليكن المعرف_الناتج: معرف_قيمة_مسير;
        طابق أصدر_نداء_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة,
            (*الحالة).الكتلة, الدالة_المسبقة, []
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { المعرف_الناتج := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        ليكن عدد_تعليمات_المستدعي: طبيعي = الطول((*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات) مثل طبيعي;
        إذا (عدد_تعليمات_المستدعي == 0) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        (*البرنامج).الدوال[(*الحالة).الدالة.القيمة].الكتل[(*الحالة).الكتلة.القيمة].التعليمات[عدد_تعليمات_المستدعي - 1].تقييم_وقت_الترجمة := صواب;
        ليكن القيمة_المسبقة: قيمة_خفض_مسير = { المعرف: المعرف_الناتج, النوع: نوع_الوجهة };
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, القيمة_المسبقة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

// The `غير_آمن` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_غير_آمن_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.غير_آمن(_, الجسم) -> {
        أرجع خفض_كتلة_عبارات_إلى_مسير(
            البرنامج,
            التصحيح_المتغير,
            الأصول,
            الحالة,
            &الجسم,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}


// The places of the block's locals, recorded with their symbols as the block
// ends: at -O0 the slot of a local that is not an owner is the variable's
// memory; an owner's is recorded but not bound, since its value is valid
// only while the owner holds one (debug_contract.sn, مكان_محلي_تصحيح_مسير).
عرف سجل_أماكن_محليات_كتلة_تصحيح(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &حالة_خفض_دالة,
    عدد_الخارجية: طبيعي
): فراغ {
    ليكن ف: متغير طبيعي = عدد_الخارجية;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        طابق (*الحالة).المحليات[ف].المكان مع
        | اختياري.موجود(المكان) -> {
            // A temporary owner (drops.sn, سجل_مالكا_مؤقتا_خفض) is no source local.
            إذا (!هو_رمز_مركب((*الحالة).المحليات[ف].الرمز)) {
                سجل_مكان_محلي_تصحيح_مسير(
                    التصحيح, (*الحالة).الدالة, (*الحالة).المحليات[ف].الرمز, المكان, اختياري.لا_شيء(),
                    (*الحالة).المحليات[ف].مالك
                );
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
}

عام عرف خفض_كتلة_عبارات_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    الجسم: &كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن الأصل: كتلة_عبارات = *الجسم;
    // Read the entry facts before the state is updated in place.
    ليكن النطاق_السابق: اختياري معرف_نطاق_تصحيح = (*الحالة).البناء.نطاق_التصحيح_الحالي;
    ليكن عدد_الخارجية: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    طابق نطاق_تصحيح_لنطاق_مصدر(&(*التصحيح).العقد, (*الحالة).الدالة, الأصل.النطاق) مع
    | اختياري.موجود(معرف_النطاق) -> { (*الحالة).البناء.نطاق_التصحيح_الحالي := اختياري.موجود(معرف_النطاق); }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل.العبارات) مثل طبيعي)) {
        ليكن حالة_حالية: حالة_خفض_دالة = *الحالة;
        إذا (!حالة_حالية.نشطة) {
            سجل_أماكن_محليات_كتلة_تصحيح(التصحيح, الحالة, عدد_الخارجية);
            اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
            (*الحالة).البناء.نطاق_التصحيح_الحالي := النطاق_السابق;
            أرجع اختياري.لا_شيء();
        };
        ليكن مرجع_صندوق_العبارة: &صندوق عبارة = &الأصل.العبارات[ف];
        ليكن صندوق_العبارة: صندوق عبارة = *مرجع_صندوق_العبارة;
        ليكن العبارة: عبارة = *صندوق_العبارة;
        طابق اخفض_عبارة_إلى_مسير(
            البرنامج, التصحيح, الأصول,
            الحالة,
            &العبارة,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // The block's owners are destroyed when it ends.
    طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_الخارجية, نهاية_نطاق_خفض(الأصل.النطاق)) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    سجل_أماكن_محليات_كتلة_تصحيح(التصحيح, الحالة, عدد_الخارجية);
    اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
    (*الحالة).البناء.نطاق_التصحيح_الحالي := النطاق_السابق;
    أرجع اختياري.لا_شيء();
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

// ---- Match expressions ------------------------------------------------------
// The works a statement's match expressions left (expressions.sn,
// عمل_خفض_مؤجل) are lowered here once the statement is: each match is the
// match statement it extends (اخفض_مطابقة_إلى_مسير), lowered from the state
// saved where the expression was met, in the block that evaluates it; each
// arm's value goes to the match's join block (اخفض_جسم_ذراع_مطابقة_إلى_مسير).

// The values of the match expression being lowered, for its arms; the
// innermost last (a match expression in a statement of an arm is lowered
// while the arms after it wait).
نوع سياق_قيم_مطابقة_خفض = {
    النطاق: نطاق,
    القيم: متجه اختياري تعبير,
    الدمج: معرف_كتلة_مسير,
    النوع: اختياري معرف_نوع,
    من_إذا: منطقي
};

ليكن سياقات_قيم_المطابقة: متغير متجه سياق_قيم_مطابقة_خفض = [];

عرف انسخ_قيم_مطابقة_خفض(القيم: &متجه اختياري تعبير): متجه اختياري تعبير {
    ليكن الناتج: متغير متجه اختياري تعبير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        طابق (*القيم)[ف] مع
        | اختياري.موجود(القيمة) -> { ألحق(الناتج, اختياري.موجود(انسخ_مملوكا_تعبير(&القيمة))); }
        | اختياري.لا_شيء -> { ألحق(الناتج, اختياري.لا_شيء()); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The values of the match expression whose span is النطاق, when it is the
// one being lowered (a match statement has none).
عرف سياق_قيم_مطابقة_عند(النطاق: نطاق): اختياري سياق_قيم_مطابقة_خفض {
    ليكن الناتج: متغير اختياري سياق_قيم_مطابقة_خفض = اختياري.لا_شيء();
    غير_آمن {
        ليكن ف: متغير طبيعي = الطول(سياقات_قيم_المطابقة) مثل طبيعي;
        طالما (ف > 0) {
            ف := ف - 1;
            إذا (نطاقان_متساويان(سياقات_قيم_المطابقة[ف].النطاق, النطاق)) {
                ليكن السياق: سياق_قيم_مطابقة_خفض = {
                    النطاق: سياقات_قيم_المطابقة[ف].النطاق,
                    القيم: انسخ_قيم_مطابقة_خفض(&سياقات_قيم_المطابقة[ف].القيم),
                    الدمج: سياقات_قيم_المطابقة[ف].الدمج,
                    النوع: سياقات_قيم_المطابقة[ف].النوع,
                    من_إذا: سياقات_قيم_المطابقة[ف].من_إذا
                };
                الناتج := اختياري.موجود(السياق);
                ف := 0;
            };
        }
    }
    أرجع الناتج;
}

عرف اخفض_أعمال_مؤجلة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &حالة_خفض_دالة,
    البداية: طبيعي,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < عدد_أعمال_خفض_مؤجلة()) {
        ليكن الحد: طبيعي = عدد_أعمال_خفض_مؤجلة();
        ليكن الخطأ: متغير اختياري خطأ_خفض_مسير = اختياري.لا_شيء();
        طابق عمل_خفض_مؤجل_عند(ف) مع
        | اختياري.موجود(عمل_خفض_مؤجل.مطابقة(المؤجلة)) -> {
            الخطأ := اخفض_مطابقة_تعبيرية_مؤجلة_إلى_مسير(
                البرنامج, التصحيح, الأصول, الحالة, &المؤجلة, نوع_الناتج, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
                دوال_الخفض, هويات_البدائيات
            );
        }
        | اختياري.موجود(عمل_خفض_مؤجل.ختم_إطار(الدالة, الإطار)) -> {
            الخطأ := اختم_إطار_إسقاط_خفض(البرنامج, الدالة, &الإطار);
        }
        | اختياري.لا_شيء -> { };
        طابق الخطأ مع
        | اختياري.موجود(_) -> {
            اقطع_أعمال_خفض_مؤجلة(البداية);
            أرجع الخطأ;
        }
        | اختياري.لا_شيء -> { };
        // The works it left itself come before the next one.
        ليكن خطأ_الداخلة: اختياري خطأ_خفض_مسير = اخفض_أعمال_مؤجلة_إلى_مسير(
            البرنامج, التصحيح, الأصول, الحالة, الحد, نوع_الناتج, الأنواع, أنواع_الرموز,
            أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات
        );
        طابق خطأ_الداخلة مع
        | اختياري.موجود(_) -> {
            اقطع_أعمال_خفض_مؤجلة(البداية);
            أرجع خطأ_الداخلة;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    اقطع_أعمال_خفض_مؤجلة(البداية);
    أرجع اختياري.لا_شيء();
}

// One match expression: its scrutinee and arms from the state where it was
// met. A `return` in an arm leaves the code the match is in: a closure's
// body has its own return Type.
عرف اخفض_مطابقة_تعبيرية_مؤجلة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &حالة_خفض_دالة,
    المؤجلة: &مطابقة_تعبيرية_مؤجلة_خفض,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن دالة_المطابقة: طبيعي = (*المؤجلة).الحالة.الدالة.القيمة مثل طبيعي;
    ليكن نوع_ناتج_المطابقة: متغير اختياري معرف_نوع = نوع_الناتج;
    إذا (دالة_المطابقة != ((*الحالة).الدالة.القيمة مثل طبيعي)
        && دالة_المطابقة < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        نوع_ناتج_المطابقة := (*البرنامج).الدوال[دالة_المطابقة].الناتج;
    };
    ليكن حالة_المطابقة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(&(*المؤجلة).الحالة);
    طابق (*المؤجلة).التعبير مع
    | تعبير.مطابقة(النطاق, المطابقة) -> {
        ليكن السياق: سياق_قيم_مطابقة_خفض = {
            النطاق: النطاق,
            القيم: انسخ_قيم_مطابقة_خفض(&(*المطابقة).القيم),
            الدمج: (*المؤجلة).الدمج,
            النوع: (*المؤجلة).النوع,
            من_إذا: (*المطابقة).من_إذا
        };
        ليكن عدد_السياقات: متغير طبيعي = 0;
        غير_آمن {
            عدد_السياقات := الطول(سياقات_قيم_المطابقة) مثل طبيعي;
            ألحق(سياقات_قيم_المطابقة, السياق);
        }
        ليكن الناتج: اختياري خطأ_خفض_مسير = اخفض_مطابقة_إلى_مسير(
            البرنامج, التصحيح, الأصول, &متغير حالة_المطابقة, النطاق, &(*المطابقة).المميز,
            &(*المطابقة).الأذرع, نوع_ناتج_المطابقة, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل,
            أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض,
            هويات_البدائيات
        );
        غير_آمن {
            إذا ((الطول(سياقات_قيم_المطابقة) مثل طبيعي) > عدد_السياقات) {
                اقتطع(سياقات_قيم_المطابقة, عدد_السياقات);
            };
        }
        أرجع الناتج;
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(&(*المؤجلة).التعبير)));
}

// The body of the match arm الفهرس: a block, and in a match expression
// (سياق_قيم_مطابقة_عند) the block of an arm that gives the match its value.
عرف اخفض_جسم_ذراع_مطابقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    الجسم: &كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    نطاق_المطابقة: نطاق,
    الفهرس: طبيعي,
    عدد_محليات_الأصل: طبيعي
): اختياري خطأ_خفض_مسير {
    طابق سياق_قيم_مطابقة_عند(نطاق_المطابقة) مع
    | اختياري.لا_شيء -> {
        أرجع خفض_كتلة_عبارات_إلى_مسير(
            البرنامج, التصحيح, الأصول, الحالة, الجسم, نوع_الناتج, الأنواع, أنواع_الرموز,
            أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات
        );
    }
    | اختياري.موجود(السياق) -> {
        أرجع اخفض_جسم_ذراع_بقيمة_إلى_مسير(
            البرنامج, التصحيح, الأصول, الحالة, الجسم, نوع_الناتج, الأنواع, أنواع_الرموز,
            أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات, &السياق, الفهرس, عدد_محليات_الأصل
        );
    };
}

// An arm of a match expression: its statements as a block's
// (خفض_كتلة_عبارات_إلى_مسير); an arm that runs to its end then gives its
// value, in the block's scope: the value is lowered as the arm's owned
// result (its Type made the match's), it is passed on (borrow_events.sn),
// the block's locals and then the arm's bindings are destroyed, and the arm
// jumps to the match's join with the value. An arm without a value that can
// run to its end is ذراع_مطابقة_بلا_قيمة. The state is left inactive: no
// path of an arm goes on after the match statement form.
عرف اخفض_جسم_ذراع_بقيمة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    الجسم: &كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    السياق: &سياق_قيم_مطابقة_خفض,
    الفهرس: طبيعي,
    عدد_محليات_الأصل: طبيعي
): اختياري خطأ_خفض_مسير {
    ليكن الأصل: كتلة_عبارات = *الجسم;
    ليكن النطاق_السابق: اختياري معرف_نطاق_تصحيح = (*الحالة).البناء.نطاق_التصحيح_الحالي;
    ليكن عدد_الخارجية: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    طابق نطاق_تصحيح_لنطاق_مصدر(&(*التصحيح).العقد, (*الحالة).الدالة, الأصل.النطاق) مع
    | اختياري.موجود(معرف_النطاق) -> { (*الحالة).البناء.نطاق_التصحيح_الحالي := اختياري.موجود(معرف_النطاق); }
    | اختياري.لا_شيء -> { };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصل.العبارات) مثل طبيعي) && (*الحالة).نشطة) {
        ليكن مرجع_صندوق_العبارة: &صندوق عبارة = &الأصل.العبارات[ف];
        ليكن صندوق_العبارة: صندوق عبارة = *مرجع_صندوق_العبارة;
        ليكن العبارة: عبارة = *صندوق_العبارة;
        طابق اخفض_عبارة_إلى_مسير(
            البرنامج, التصحيح, الأصول, الحالة, &العبارة, نوع_الناتج, الأنواع, أنواع_الرموز,
            أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
            دوال_الخفض, هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا ((*الحالة).نشطة) {
        طابق (*السياق).القيم[الفهرس] مع
        | اختياري.لا_شيء -> {
            إذا ((*السياق).من_إذا) {
                أرجع اختياري.موجود(خطأ_خفض_مسير.فرع_إذا_بلا_قيمة(الأصل.النطاق));
            };
            أرجع اختياري.موجود(خطأ_خفض_مسير.ذراع_مطابقة_بلا_قيمة(الأصل.النطاق));
        }
        | اختياري.موجود(القيمة) -> {
            طابق أعط_قيمة_ذراع_مطابقة_إلى_مسير(
                البرنامج, التصحيح, الأصول, الحالة, &القيمة, السياق, عدد_الخارجية, عدد_محليات_الأصل,
                نهاية_نطاق_خفض(الأصل.النطاق), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };
    سجل_أماكن_محليات_كتلة_تصحيح(التصحيح, الحالة, عدد_الخارجية);
    اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
    (*الحالة).البناء.نطاق_التصحيح_الحالي := النطاق_السابق;
    (*الحالة).نشطة := خطأ;
    أرجع اختياري.لا_شيء();
}

// The value of an arm (see اخفض_جسم_ذراع_بقيمة_إلى_مسير), with its own
// source line.
عرف أعط_قيمة_ذراع_مطابقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    القيمة: &تعبير,
    السياق: &سياق_قيم_مطابقة_خفض,
    عدد_الخارجية: طبيعي,
    عدد_محليات_الأصل: طبيعي,
    نهاية_الذراع: نطاق,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن النطاق: نطاق = نطاق_تعبير(القيمة);
    ليكن أصل_القيمة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    ليكن موقع_القيمة: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
        &متغير (*التصحيح).الدلالي, أصل_القيمة, (*الحالة).البناء.نطاق_التصحيح_الحالي,
        صواب, خطأ, خطأ, 0
    );
    عين_مرجع_تصحيح_مسير(
        &متغير (*الحالة).البناء, موقع_القيمة, (*الحالة).البناء.نطاق_التصحيح_الحالي
    );
    ليكن الحجج: متغير متجه معرف_قيمة_مسير = [];
    طابق (*السياق).النوع مع
    | اختياري.موجود(نوع_الدمج) -> {
        ليكن المملوكة: متغير قيمة_خفض_مسير = { المعرف: معرف_قيمة_مسير_من((*الحالة).الدالة, 0), النوع: نوع_الدمج };
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج, الحالة, القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.قيمة(الناتج) -> { المملوكة := الناتج; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(البرنامج, الحالة, النطاق, المملوكة, نوع_الدمج, الأنواع) مع
        | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(الحجج, المقننة.المعرف); }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        // The value is passed on (borrow_events.sn).
        سجل_مصدر_قيمة_استعارة_خفض(
            البرنامج, الحالة, القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        // `binding.field` with an owning field takes the arm's local whole,
        // as a returned one does: its other owning fields are destroyed.
        إذا (محلي_ذراع_في_حقل_خفض(الحالة, القيمة, روابط_الأسماء, عدد_محليات_الأصل)) {
            طابق أسقط_بقية_سجل_مرجع_خفض(البرنامج, الحالة, القيمة, الأنواع, روابط_الأسماء, دوال_الخفض) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> {
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | _ -> { };
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, القيمة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    };
    إذا (!(*الحالة).نشطة) { أرجع اختياري.لا_شيء(); };
    طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_الخارجية, نهاية_الذراع) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    سجل_أماكن_محليات_كتلة_تصحيح(التصحيح, الحالة, عدد_الخارجية);
    اقصر_محليات_حالة_خفض(الحالة, عدد_الخارجية);
    طابق أسقط_محليات_من_خفض(البرنامج, الحالة, عدد_محليات_الأصل, نهاية_الذراع) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    اقصر_محليات_حالة_خفض(الحالة, عدد_محليات_الأصل);
    طابق اختم_بفرع_للخفض(البرنامج, &(*الحالة), (*السياق).الدمج, الحجج) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    (*الحالة).نشطة := خطأ;
    أرجع اختياري.لا_شيء();
}

// Whether القيمة is a field of a local the arm binds or declares (from
// البداية on in the locals), which dies with the arm.
عرف محلي_ذراع_في_حقل_خفض(
    الحالة: &حالة_خفض_دالة,
    القيمة: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    البداية: طبيعي
): منطقي {
    طابق *القيمة مع
    | تعبير.حقل(_, الأصل, _) -> {
        طابق *الأصل مع
        | تعبير.اسم(_, الاسم) -> {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> {
                طابق موضع_محلي_خفض(الحالة, الرمز) مع
                | اختياري.موجود(الموضع) -> { أرجع الموضع >= البداية; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع خطأ;
}
