// تنسيق خفض العبارات والكتل والفروع والحلقات والمطابقة مع بقاء الدلالات في Frontend.

// Every local already lives in its place (drops.sn, ثبّت_محلي_خفض), so
// branches, merges and loops share it and pass no value for it. Before
// control flow the locals in scope are marked to be read through their place
// (ربط_محلي_خفض.مخزن): a member read inside the branches and after them
// projects the place instead of loading the whole local.
عرف ثبّت_أماكن_محليات_قبل_تفرع_التحكم(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة
): اختياري خطأ_خفض_مسير {
    ليكن ف: متغير طبيعي = 0;
    ليكن كلها_مخزنة: متغير منطقي = صواب;
    طالما (كلها_مخزنة && ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        إذا (!(*الحالة).المحليات[ف].مخزن) { كلها_مخزنة := خطأ; };
        ف := ف + 1;
    }
    إذا (كلها_مخزنة) { أرجع اختياري.لا_شيء(); };
    تأكد_محليات_خفض_فريدة(الحالة);
    ف := 0;
    طالما (ف < (الطول((*الحالة).المحليات) مثل طبيعي)) {
        (*الحالة).المحليات[ف].مخزن := صواب;
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The debug location of a local's declaration (drops.sn, ثبّت_محلي_خفض):
// its name in the source, in the current debug scope.
عام عرف موقع_تصريح_محلي_للخفض(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق
): اختياري معرف_موقع_تصحيح {
    ليكن الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    ليكن الموقع: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
        &متغير (*التصحيح).الدلالي, الأصل, (*الحالة).البناء.نطاق_التصحيح_الحالي,
        خطأ, خطأ, خطأ, 0
    );
    أرجع اختياري.موجود(الموقع);
}

عرف اخفض_إذا_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الشرط: &تعبير,
    عند_الصواب: &كتلة_عبارات,
    عند_الخطأ: اختياري كتلة_عبارات,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    طابق خفض_تعبير_إلى_مسير(
        البرنامج,
        الحالة,
        الشرط,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(قيمة_الشرط) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, الحالة, الشرط, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ليكن أصل_التفرع: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_الشرط.النوع)) {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الشرط.النوع)
            );
        };
        ليكن كتلة_صواب: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        ليكن كتلة_خطأ: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_صواب := الكتلة;
        };
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_خطأ := الكتلة;
        };
        ليكن لا_حجج_أ: متجه معرف_قيمة_مسير = [];
        ليكن لا_حجج_ب: متجه معرف_قيمة_مسير = [];
        ليكن حافة_صواب: حافة_مسير = { الهدف: كتلة_صواب, الحجج: لا_حجج_أ };
        ليكن حافة_خطأ: حافة_مسير = { الهدف: كتلة_خطأ, الحجج: لا_حجج_ب };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج, &أصل_التفرع.البناء,
            أصل_التفرع.الدالة,
            أصل_التفرع.الكتلة,
            قيمة_الشرط.المعرف,
            حافة_صواب,
            حافة_خطأ
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };

        ليكن حالة_صواب: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
        حالة_صواب.الكتلة := كتلة_صواب;
        حالة_صواب.نشطة := صواب;
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج,
            التصحيح,
            الأصول,
            &متغير حالة_صواب,
            عند_الصواب,
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };

        ليكن حالة_خطأ: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
        حالة_خطأ.الكتلة := كتلة_خطأ;
        حالة_خطأ.نشطة := صواب;
        طابق عند_الخطأ مع
        | اختياري.موجود(الجسم) -> {
            طابق خفض_كتلة_عبارات_إلى_مسير(
                البرنامج,
                التصحيح,
                الأصول,
                &متغير حالة_خطأ,
                &الجسم,
                نوع_الناتج,
                الأنواع,
                أنواع_الرموز,
                أنواع_رموز_المثيل,
                أنواع_التعبيرات,
                روابط_الأسماء,
                سجل_الأنماط,
                تحققات_الأنماط,
                دوال_الخفض,
                هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };

        إذا ((!حالة_صواب.نشطة) && (!حالة_خطأ.نشطة)) {
            ليكن منتهية: حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_التفرع);
            ليكن نسخة: متغير حالة_خفض_دالة = منتهية;
            نسخة.نشطة := خطأ;
            *الحالة := نسخة;
            أرجع اختياري.لا_شيء();
        };
        إذا (حالة_صواب.نشطة && (!حالة_خطأ.نشطة)) {
            *الحالة := حالة_صواب;
            أرجع اختياري.لا_شيء();
        };
        إذا ((!حالة_صواب.نشطة) && حالة_خطأ.نشطة) {
            *الحالة := حالة_خطأ;
            أرجع اختياري.لا_شيء();
        };

        ليكن كتلة_دمج: متغير معرف_كتلة_مسير = أصل_التفرع.الكتلة;
        طابق أضف_كتلة_للخفض(البرنامج, أصل_التفرع.الدالة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الكتلة) -> {
            كتلة_دمج := الكتلة;
        };
        // The locals live in their places: the merge passes no value.
        ليكن محليات_الدمج: متجه ربط_محلي_خفض = قص_محليات_خفض(
            &أصل_التفرع.المحليات, الطول(أصل_التفرع.المحليات) مثل طبيعي
        );
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_صواب, كتلة_دمج, []) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_خطأ, كتلة_دمج, []) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        ليكن التالية: حالة_خفض_دالة = {
            الدالة: أصل_التفرع.الدالة,
            الكتلة: كتلة_دمج,
            نشطة: صواب,
            البناء: أصل_التفرع.البناء,
            المحليات: محليات_الدمج,
            له_هدف_خروج_حلقة: أصل_التفرع.له_هدف_خروج_حلقة,
            هدف_خروج_حلقة: أصل_التفرع.هدف_خروج_حلقة,
            له_هدف_متابعة_حلقة: أصل_التفرع.له_هدف_متابعة_حلقة,
            هدف_متابعة_حلقة: أصل_التفرع.هدف_متابعة_حلقة,
            عدد_محليات_متابعة_حلقة: أصل_التفرع.عدد_محليات_متابعة_حلقة,
            المحليات_مشتركة: خطأ,
            إطار_الإسقاط: أصل_التفرع.إطار_الإسقاط,
            العروض: انسخ_عروض_خفض(&أصل_التفرع.العروض),
            يجد_العروض: أصل_التفرع.يجد_العروض,
            للتحليل: أصل_التفرع.للتحليل
        };
        *الحالة := التالية;
        أرجع اختياري.لا_شيء();
    };
}

// A loop whose condition is the literal true and whose own body never breaks
// out of it does not terminate normally: its exit block is unreachable.
عرف شرط_صواب_ثابت_للخفض(الشرط: &تعبير): منطقي {
    طابق *الشرط مع
    | تعبير.حرفي(_, الحرفي) -> {
        طابق الحرفي مع
        | حرفي.منطقي(القيمة) -> { أرجع القيمة; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف كتلة_تخرج_من_حلقتها_للخفض(الكتلة: &كتلة_عبارات): منطقي {
    ليكن العبارات: &متجه صندوق عبارة = &(*الكتلة).العبارات;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العبارات) مثل طبيعي)) {
        ليكن العبارة: عبارة = *(*العبارات)[ف];
        إذا (عبارة_تخرج_من_حلقتها_للخفض(&العبارة)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Inner loops own their own breaks; a comptime block is a separate function.
عرف عبارة_تخرج_من_حلقتها_للخفض(العبارة: &عبارة): منطقي {
    طابق *العبارة مع
    | عبارة.اخرج_من_حلقة(_) -> { أرجع صواب; }
    | عبارة.إذا(_, _, الأولى, الثانية) -> {
        إذا (كتلة_تخرج_من_حلقتها_للخفض(&الأولى)) { أرجع صواب; };
        طابق الثانية مع
        | اختياري.موجود(البديلة) -> { أرجع كتلة_تخرج_من_حلقتها_للخفض(&البديلة); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | عبارة.طابق(_, _, الأذرع) -> {
        ليكن ذ: متغير طبيعي = 0;
        طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
            إذا (كتلة_تخرج_من_حلقتها_للخفض(&الأذرع[ذ].الجسم)) { أرجع صواب; };
            ذ := ذ + 1;
        }
        أرجع خطأ;
    }
    | عبارة.غير_آمن(_, الكتلة) -> { أرجع كتلة_تخرج_من_حلقتها_للخفض(&الكتلة); }
    | _ -> { };
    // A `break` in an arm of the statement's match expressions (a closure's
    // body is a function of its own).
    ليكن المطابقات: متجه تعبير = مطابقات_تعبيرية_متداخلة_عبارة(العبارة, خطأ);
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول(المطابقات) مثل طبيعي)) {
        ليكن مرجع_المطابقة: &تعبير = &المطابقات[م];
        طابق *مرجع_المطابقة مع
        | تعبير.مطابقة(_, المطابقة) -> {
            ليكن ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول((*المطابقة).الأذرع) مثل طبيعي)) {
                إذا (كتلة_تخرج_من_حلقتها_للخفض(&(*المطابقة).الأذرع[ذ].الجسم)) { أرجع صواب; };
                ذ := ذ + 1;
            }
        }
        | _ -> { };
        م := م + 1;
    }
    أرجع خطأ;
}

عرف اخفض_بينما_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الشرط: &تعبير,
    الجسم: &كتلة_عبارات,
    الخطوة: &اختياري صندوق عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن الرأس: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    ليكن كتلة_الجسم: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    ليكن الخروج: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        الرأس := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الجسم := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        الخروج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    ليكن كتلة_المتابعة: متغير معرف_كتلة_مسير = الرأس;
    ليكن لها_خطوة: متغير منطقي = خطأ;
    طابق *الخطوة مع
    | اختياري.موجود(_) -> {
        لها_خطوة := صواب;
        طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
        | نتيجة.نجح(الكتلة) -> { كتلة_المتابعة := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    }
    | اختياري.لا_شيء -> { };

    // The locals live in their places: the loop's blocks take no value.
    ليكن محليات_الرأس: متجه ربط_محلي_خفض = قص_محليات_خفض(
        &الأصل.المحليات, الطول(الأصل.المحليات) مثل طبيعي
    );
    طابق اختم_بفرع_للخفض(البرنامج, &الأصل, الرأس, []) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | اختياري.لا_شيء -> { };

    ليكن عدد_محليات_الرأس: طبيعي = الطول(محليات_الرأس) مثل طبيعي;
    ليكن محليات_حالة_الرأس: متجه ربط_محلي_خفض = قص_محليات_خفض(
        &محليات_الرأس,
        عدد_محليات_الرأس
    );
    ليكن حالة_الرأس: متغير حالة_خفض_دالة = {
        الدالة: الأصل.الدالة,
        الكتلة: الرأس,
        نشطة: صواب,
        البناء: الأصل.البناء,
        المحليات: محليات_حالة_الرأس,
        له_هدف_خروج_حلقة: الأصل.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: الأصل.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: الأصل.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: الأصل.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: الأصل.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: الأصل.إطار_الإسقاط,
        العروض: انسخ_عروض_خفض(&الأصل.العروض),
            يجد_العروض: الأصل.يجد_العروض,
            للتحليل: الأصل.للتحليل
    };
    ليكن محليات_المتابعة: متجه ربط_محلي_خفض = قص_محليات_خفض(
        &محليات_الرأس, الطول(محليات_الرأس) مثل طبيعي
    );
    طابق خفض_تعبير_إلى_مسير(
        البرنامج,
        &متغير حالة_الرأس,
        الشرط,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(قيمة_الشرط) -> {
        سجل_آثار_تعبير_استعارة_خفض(
            البرنامج, &حالة_الرأس, الشرط, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_الشرط.النوع)) {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الشرط.النوع)
            );
        };
        ليكن بلا_حجج_أ: متجه معرف_قيمة_مسير = [];
        ليكن بلا_حجج_ب: متجه معرف_قيمة_مسير = [];
        ليكن إلى_الجسم: حافة_مسير = { الهدف: كتلة_الجسم, الحجج: بلا_حجج_أ };
        ليكن إلى_الخروج: حافة_مسير = { الهدف: الخروج, الحجج: بلا_حجج_ب };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج, &الأصل.البناء,
            الأصل.الدالة,
            حالة_الرأس.الكتلة,
            قيمة_الشرط.المعرف,
            إلى_الجسم,
            إلى_الخروج
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    };

    ليكن حالة_الجسم: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير حالة_الرأس);
    حالة_الجسم.الكتلة := كتلة_الجسم;
    حالة_الجسم.نشطة := صواب;
    حالة_الجسم.له_هدف_خروج_حلقة := صواب;
    حالة_الجسم.هدف_خروج_حلقة := الخروج;
    حالة_الجسم.له_هدف_متابعة_حلقة := صواب;
    حالة_الجسم.هدف_متابعة_حلقة := كتلة_المتابعة;
    حالة_الجسم.عدد_محليات_متابعة_حلقة := الطول(الأصل.المحليات) مثل طبيعي;
    طابق خفض_كتلة_عبارات_إلى_مسير(
        البرنامج,
        التصحيح,
        الأصول,
        &متغير حالة_الجسم,
        الجسم,
        نوع_الناتج,
        الأنواع,
        أنواع_الرموز,
        أنواع_رموز_المثيل,
        أنواع_التعبيرات,
        روابط_الأسماء,
        سجل_الأنماط,
        تحققات_الأنماط,
        دوال_الخفض,
        هويات_البدائيات
    ) مع
    | اختياري.موجود(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | اختياري.لا_شيء -> { };

    إذا (حالة_الجسم.نشطة) {
        إذا (لها_خطوة) {
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الجسم, كتلة_المتابعة, []) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        } وإلا {
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الجسم, الرأس, []) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };

    إذا (لها_خطوة) {
        ليكن حالة_الخطوة: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير حالة_الرأس);
        حالة_الخطوة.الكتلة := كتلة_المتابعة;
        حالة_الخطوة.المحليات := محليات_المتابعة;
        حالة_الخطوة.نشطة := صواب;
        حالة_الخطوة.له_هدف_خروج_حلقة := صواب;
        حالة_الخطوة.هدف_خروج_حلقة := الخروج;
        حالة_الخطوة.له_هدف_متابعة_حلقة := صواب;
        حالة_الخطوة.هدف_متابعة_حلقة := كتلة_المتابعة;
        حالة_الخطوة.عدد_محليات_متابعة_حلقة := الطول(الأصل.المحليات) مثل طبيعي;
        طابق *الخطوة مع
        | اختياري.موجود(صندوق_الخطوة) -> {
            ليكن عبارة_الخطوة: عبارة = *صندوق_الخطوة;
            طابق اخفض_عبارة_إلى_مسير(
                البرنامج, التصحيح, الأصول, &متغير حالة_الخطوة, &عبارة_الخطوة, نوع_الناتج, الأنواع, أنواع_الرموز,
                أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        إذا (حالة_الخطوة.نشطة) {
            طابق اختم_بفرع_للخفض(البرنامج, &حالة_الخطوة, الرأس, []) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };

    // `while (true)` without its own break: nothing reaches the exit block.
    ليكن بعد_الحلقة_نشطة: متغير منطقي = صواب;
    إذا (شرط_صواب_ثابت_للخفض(الشرط) && (!كتلة_تخرج_من_حلقتها_للخفض(الجسم))) {
        طابق اختم_بفخ_مسير(البرنامج, &الأصل.البناء, الأصل.الدالة, الخروج) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
        بعد_الحلقة_نشطة := خطأ;
    };
    ليكن التالية: حالة_خفض_دالة = {
        الدالة: الأصل.الدالة,
        الكتلة: الخروج,
        نشطة: بعد_الحلقة_نشطة,
        البناء: الأصل.البناء,
        المحليات: محليات_الرأس,
        له_هدف_خروج_حلقة: الأصل.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: الأصل.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: الأصل.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: الأصل.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: الأصل.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: الأصل.إطار_الإسقاط,
        العروض: انسخ_عروض_خفض(&الأصل.العروض),
            يجد_العروض: الأصل.يجد_العروض,
            للتحليل: الأصل.للتحليل
    };
    *الحالة := التالية;
    أرجع اختياري.لا_شيء();
}

// A direct call of the compile-time failure primitive.
عرف استدعاء_فشل_وقت_الترجمة(
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.موجود(الرمز) -> {
            طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
            | اختياري.موجود(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// A direct call of a function that never returns (the stop primitive إنهيار,
// std.process.panic): the path after it ends, so a function returning a
// value needs no return after the call.
عرف استدعاء_دالة_لا_تعود(
    التعبير: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *التعبير مع
    | تعبير.استدعاء(_, المستدعى_المملوك, _) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_تعبير(&(*المستدعى_المملوك))) مع
        | اختياري.موجود(الرمز) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول((*دوال_الخفض).رموز_لا_تعود) مثل طبيعي)) {
                إذا (معرفا_رمز_متساويان((*دوال_الخفض).رموز_لا_تعود[ف], الرمز)) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// A scrutinee that is a temporary (a call result, or a member or element of
// one): a fresh value no local owns.
عرف مميز_مؤقت_للخفض(المميز: &تعبير): منطقي {
    أرجع هل_أصل_مؤقت_للخفض(المميز);
}

// `return local.field` with an owning field consumes the whole owned local:
// the field is the returned value and the local's other owning fields are
// destroyed here.
عرف أسقط_بقية_سجل_مرجع_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    ليكن الأصل: تعبير;
    ليكن اسم_الحقل: اسم;
    طابق *التعبير مع
    | تعبير.حقل(_, صندوق_الأصل, الحقل) -> { الأصل := *صندوق_الأصل; اسم_الحقل := الحقل; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الاسم: اسم;
    طابق الأصل مع
    | تعبير.اسم(_, القيمة) -> { الاسم := القيمة; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الرمز: معرف_رمز;
    طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
    | اختياري.موجود(القيمة) -> { الرمز := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن الموضع: طبيعي;
    طابق موضع_محلي_خفض(الحالة, الرمز) مع
    | اختياري.موجود(القيمة) -> { الموضع := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
    ليكن المكان: معرف_قيمة_مسير;
    طابق المحلي.المكان مع
    | اختياري.موجود(القيمة) -> { المكان := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (!المحلي.مالك) { أرجع اختياري.لا_شيء(); };
    ليكن المنقول: طبيعي;
    طابق معرف_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
    | اختياري.موجود(الهوية) -> {
        طابق ترتيب_حقل_سجل_دلالي_بالاسم(الأنواع, المحلي.النوع, الهوية) مع
        | اختياري.موجود(الفهرس) -> { المنقول := الفهرس; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Only an owning field moves the whole local out; a plain one is copied.
    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, المحلي.النوع, المنقول) مع
    | اختياري.موجود(نوع_المنقول) -> {
        إذا (!هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_المنقول)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن العدد: طبيعي;
    طابق عدد_حقول_سجل_دلالي(الأنواع, المحلي.النوع) مع
    | اختياري.موجود(القيمة) -> { العدد := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق أصدر_ملكية_محلي_خفض(البرنامج, الحالة, الرمز, حدث_ملكية_مسير.تسليم()) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    // The whole local moves where its name is read.
    سجل_تسليم_مصدري_خفض(البرنامج, الحالة, الرمز, الاسم.النطاق);
    ليكن السجل: معرف_قيمة_مسير;
    طابق أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, المكان, المحلي.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { السجل := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف != المنقول) {
            طابق نوع_حقل_سجل_دلالي_عند(الأنواع, المحلي.النوع, ف) مع
            | اختياري.موجود(نوع_الحقل) -> {
                إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_الحقل)) {
                    طابق أصدر_استخراج_حقل_مسير(
                        البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
                        السجل, ف, نوع_الحقل
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مبنية(قيمة_الحقل) -> {
                        طابق أسقط_قيمة_خفض(البرنامج, الحالة, قيمة_الحقل, نوع_الحقل, الأنواع) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
                    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The guard of a match arm (`| pattern if condition -> { … }`), in the block
// the pattern's success reaches (الكتلة). The pattern's bindings are placed
// for the condition as borrowed views of the scrutinee: the condition reads
// them and moves none of them (moving one out of a view is rejected,
// SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE), and nothing moves out of the
// scrutinee unless the arm is chosen. The temporaries the condition owns are
// destroyed on both of its edges. A false condition goes on to الفشل (the
// next arm's test, or the trap); a true one returns the block the arm's body
// starts in, where the bindings are placed again by the arm's own rules
// (owners, views or counted copies). حالة_الفحص is not changed.
عرف اخفض_حارس_ذراع_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    حالة_الفحص: &حالة_خفض_دالة,
    الكتلة: معرف_كتلة_مسير,
    الفشل: معرف_كتلة_مسير,
    الحارس: &تعبير,
    عدد_محليات_الأصل: طبيعي,
    المميز: &تعبير,
    بديل_المميز: معرف_رمز,
    بديل_حامل: منطقي,
    رموز_البقايا: &متجه معرف_رمز,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة معرف_كتلة_مسير, خطأ_خفض_مسير {
    ليكن الحالة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(حالة_الفحص);
    الحالة.الكتلة := الكتلة;
    الحالة.نشطة := صواب;
    تأكد_محليات_خفض_فريدة(&متغير الحالة);
    ليكن عدد_الروابط: طبيعي = الطول(الحالة.المحليات) مثل طبيعي;
    ليكن ر: متغير طبيعي = عدد_محليات_الأصل;
    طالما (ر < عدد_الروابط) {
        ليكن الرمز: معرف_رمز = الحالة.المحليات[ر].الرمز;
        إذا (!هل_عرض_محلي_خفض(&الحالة, الرمز)) { ألحق(الحالة.العروض, الرمز); };
        طابق ثبّت_محلي_خفض(
            البرنامج, &متغير الحالة, الرمز, الأنواع, دوال_الخفض, خطأ, اختياري.لا_شيء()
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        ر := ر + 1;
    }
    سجل_روابط_ذراع_استعارة_خفض(
        البرنامج, &الحالة, المميز, بديل_المميز, بديل_حامل, عدد_محليات_الأصل, رموز_البقايا, الأنواع,
        أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
    );
    ليكن عدد_محليات_الروابط: طبيعي = عدد_الروابط;
    ليكن الشرط: معرف_قيمة_مسير;
    طابق خفض_تعبير_إلى_مسير(
        البرنامج, &متغير الحالة, الحارس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(الحارس)));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, القيمة.النوع)) {
            أرجع نتيجة.خطأ(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(نطاق_تعبير(الحارس), القيمة.النوع));
        };
        الشرط := القيمة.المعرف;
    };
    سجل_آثار_تعبير_استعارة_خفض(
        البرنامج, &الحالة, الحارس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    );
    طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, &متغير الحالة) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن كتلة_الصواب: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الحالة.الدالة) مع
    | نتيجة.نجح(القيمة) -> { كتلة_الصواب := القيمة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
    ليكن كتلة_الخطأ: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الحالة.الدالة) مع
    | نتيجة.نجح(القيمة) -> { كتلة_الخطأ := القيمة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
    ليكن لا_حجج_أ: متجه معرف_قيمة_مسير = [];
    ليكن لا_حجج_ب: متجه معرف_قيمة_مسير = [];
    ليكن حافة_صواب: حافة_مسير = { الهدف: كتلة_الصواب, الحجج: لا_حجج_أ };
    ليكن حافة_خطأ: حافة_مسير = { الهدف: كتلة_الخطأ, الحجج: لا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج, &الحالة.البناء, الحالة.الدالة, الحالة.الكتلة, الشرط, حافة_صواب, حافة_خطأ
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    // The condition's temporaries, on each edge.
    ليكن نهاية_الحارس: نطاق = نهاية_نطاق_خفض(نطاق_تعبير(الحارس));
    ليكن حالة_الخطأ: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير الحالة);
    حالة_الخطأ.الكتلة := كتلة_الخطأ;
    حالة_الخطأ.نشطة := صواب;
    طابق أسقط_محليات_من_خفض(البرنامج, &متغير حالة_الخطأ, عدد_محليات_الروابط, نهاية_الحارس) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق اختم_بفرع_للخفض(البرنامج, &حالة_الخطأ, الفشل, []) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن حالة_الصواب: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير الحالة);
    حالة_الصواب.الكتلة := كتلة_الصواب;
    حالة_الصواب.نشطة := صواب;
    طابق أسقط_محليات_من_خفض(البرنامج, &متغير حالة_الصواب, عدد_محليات_الروابط, نهاية_الحارس) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(حالة_الصواب.الكتلة);
}

// The scrutinee's value. `match &mutable v with` reads v in place: the
// patterns match v itself (frontend/types/semantic_pipeline.sn,
// ابن_نوع_مميز_داخلي), and the borrow events give its named rest an exclusive
// borrow of v (borrow_events.sn).
عرف خفض_مميز_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    المميز: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    طابق *المميز مع
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, صندوق_الداخل) -> {
        أرجع خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &(*صندوق_الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | _ -> { };
    أرجع خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, المميز, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
}

// A temporary scrutinee that carries a borrow and owns no storage is kept in
// a place of its own under its stand-in (borrow_events.sn,
// سجل_حامل_مميز_استعارة_خفض): stored there, given its origins, and read
// back, so the stand-in holds the borrows its bindings carry for as long as
// any of them lives. القيمة becomes the value read back, and الحامل is set.
// The place is a plain local's (الإطار.الخانات), not an owner's: the exit
// destroys every place of the prologue, and that destruction would be a use
// keeping the borrows to the end of the function.
عرف احفظ_مميزا_حاملا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    المميز: &تعبير,
    البديل: معرف_رمز,
    القيمة: &متغير قيمة_خفض_مسير,
    الحامل: &متغير منطقي,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    إذا (!(*الحالة).نشطة) { أرجع اختياري.لا_شيء(); };
    إذا (!مميز_مؤقت_للخفض(المميز)) { أرجع اختياري.لا_شيء(); };
    إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, (*القيمة).النوع)) { أرجع اختياري.لا_شيء(); };
    إذا (!هل_مميز_حامل_استعارة_خفض(البديل, (*القيمة).النوع, دوال_الخفض)) { أرجع اختياري.لا_شيء(); };
    ليكن الإطار: إطار_إسقاط_خفض;
    طابق (*الحالة).إطار_الإسقاط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الإطار := ق; };
    ليكن الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    ليكن الخانة: معرف_قيمة_مسير;
    طابق أصدر_مكان_محلي_مصدري_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, الإطار.الخانات, (*القيمة).النوع, البديل
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الخانة := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.لا_شيء(); };
    طابق أصدر_تخزين_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الخانة, (*القيمة).المعرف
    ) مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { };
    سجل_حامل_مميز_استعارة_خفض(
        البرنامج, الحالة, المميز, البديل, (*القيمة).النوع, الأنواع, أنواع_التعبيرات, روابط_الأسماء,
        دوال_الخفض
    );
    طابق أصدر_تحميل_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, (*الحالة).الكتلة, الخانة, (*القيمة).النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المحمل) -> { (*القيمة).المعرف := المحمل; *الحامل := صواب; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { };
    أرجع اختياري.لا_شيء();
}

عرف اخفض_مطابقة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المميز: &تعبير,
    الأذرع: &متجه ذراع_مطابقة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن نتيجة_المميز: نتيجة_خفض_تعبير = خفض_مميز_إلى_مسير(
        البرنامج, الحالة, المميز, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    ليكن حالة_قبل_المميز: حالة_خفض_دالة = *الحالة;
    ليكن معرف_مؤقت: معرف_قيمة_مسير = معرف_قيمة_مسير_من(حالة_قبل_المميز.الدالة, 0);
    ليكن نوع_مؤقت: معرف_نوع = معرف_نوع_من(0);
    ليكن قيمة_المميز: متغير قيمة_خفض_مسير = { المعرف: معرف_مؤقت, النوع: نوع_مؤقت };
    ليكن بديل_المميز: متغير معرف_رمز = معرف_رمز_من(0);
    ليكن بديل_حامل: متغير منطقي = خطأ;
    طابق نتيجة_المميز مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_المميز := القيمة;
        بديل_المميز := سجل_مميز_استعارة_خفض(
            البرنامج, الحالة, المميز, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };
    طابق احفظ_مميزا_حاملا_خفض(
        البرنامج, الحالة, المميز, بديل_المميز, &متغير قيمة_المميز, &متغير بديل_حامل, الأنواع,
        أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };

    طابق ثبّت_أماكن_محليات_قبل_تفرع_التحكم(البرنامج, الحالة) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن أصل_المحليات: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    ليكن كتلة_الفحص: متغير معرف_كتلة_مسير = أصل_المحليات.الكتلة;
    ليكن حالات_الأذرع: متغير متجه حالة_خفض_دالة = [];
    ليكن قائمة_الأذرع: متجه ذراع_مطابقة = *الأذرع;
    ليكن عدد_الأذرع: طبيعي = الطول(قائمة_الأذرع) مثل طبيعي;
    ليكن حقائق_تحقق_الأنماط: متجه ربط_تحقق_نمط_وحدة = *تحققات_الأنماط;

    // Inspect the complete arm set before choosing a lowering strategy.
    // Do not emit the sequential match chain and then discard it: large
    // self-hosted modules have many tagged matches and would retain an
    // unnecessary graph until optimization.
    // Tag dispatch (one MSIR multiway branch on the constructor tag, before
    // sub-patterns are tested): every arm's
    // root is a constructor of the scrutinee's type, with or without payload
    // patterns, except that the last arm may be irrefutable. Arms are grouped
    // by tag in source order; the switch enters the first arm of a tag, and a
    // failing payload test continues with the next arm of the same tag, then
    // with the final irrefutable arm (or a trap). Grouping keeps the source
    // semantics: an arm whose root tag differs from the value's tag can never
    // match. A payload-free constructor arm ends its tag's chain, so a later
    // arm of the same tag (unreachable) keeps the sequential strategy.
    // Previously any payload pattern disabled the switch, so matches over
    // payload-carrying enums compared tags one by one (O(n) dispatch).
    ليكن مرشح_توجيه_وسم: متغير منطقي = عدد_الأذرع >= 2;
    // A guard can fail after its pattern matched: arms with guards are
    // tested one after the other.
    ليكن ح_حارس: متغير طبيعي = 0;
    طالما (ح_حارس < عدد_الأذرع) {
        طابق قائمة_الأذرع[ح_حارس].الحارس مع
        | اختياري.موجود(_) -> { مرشح_توجيه_وسم := خطأ; }
        | اختياري.لا_شيء -> { };
        ح_حارس := ح_حارس + 1;
    }
    // Integer dispatch: arms that are integer literals over a u32 scrutinee
    // switch on the value itself (a jump table where the backend makes one),
    // as an enum's arms switch on its tag.
    ليكن توجيه_صحيح: متغير منطقي = خطأ;
    ليكن مميز_ط32: متغير منطقي = خطأ;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(معرف_ط32) -> { مميز_ط32 := معرفا_نوع_متساويان(معرف_ط32, قيمة_المميز.النوع); }
    | اختياري.لا_شيء -> { };
    ليكن مدخل_التوجيه: معرف_كتلة_مسير = كتلة_الفحص;
    ليكن عدد_حالات_توجيه_الوسم: متغير طبيعي = 0;
    ليكن وسوم_التمهيد: متغير متجه طبيعي = [];
    ليكن وسوم_مغلقة: متغير متجه طبيعي = [];
    // Per arm: its root tag (unused for the final irrefutable arm), whether it
    // needs no payload test, and whether it is the final irrefutable arm.
    ليكن وسوم_الأذرع: متغير متجه طبيعي = [];
    ليكن أذرع_بلا_اختبار: متغير متجه منطقي = [];
    ليكن ذراع_شامل_أخير: متغير منطقي = خطأ;
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < عدد_الأذرع && مرشح_توجيه_وسم) {
        ليكن مرجع_ذراع_التمهيد: &ذراع_مطابقة = &قائمة_الأذرع[ق];
        طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, مرجع_ذراع_التمهيد) مع
        | اختياري.موجود(الجذر) -> {
            طابق فهرس_تحقق_ربط_نمط_وحدة_عند(&حقائق_تحقق_الأنماط, الجذر) مع
            | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
            | اختياري.موجود(فهرس_التحقق) -> {
                ليكن الشامل: منطقي =
                    حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق.غير_قابل_للدحض;
                طابق نمط_عند(سجل_الأنماط, الجذر) مع
                | اختياري.موجود(نمط_دلالي.منشئ(_, _, الحمولات)) -> {
                    ليكن بلا_حمولة: منطقي = (الطول(الحمولات) مثل طبيعي) == 0;
                    طابق هوية_منشئ_نمط_محلولة_عند(&حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق, الجذر) مع
                    | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                    | اختياري.موجود(الهوية) -> {
                        طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, قيمة_المميز.النوع, الهوية) مع
                        | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                        | اختياري.موجود(الوسم) -> {
                            ليكن س: متغير طبيعي = 0;
                            طالما (س < (الطول(وسوم_مغلقة) مثل طبيعي)) {
                                إذا (وسوم_مغلقة[س] == الوسم) { مرشح_توجيه_وسم := خطأ; };
                                س := س + 1;
                            }
                            ليكن جديد: متغير منطقي = صواب;
                            س := 0;
                            طالما (س < (الطول(وسوم_التمهيد) مثل طبيعي)) {
                                إذا (وسوم_التمهيد[س] == الوسم) { جديد := خطأ; };
                                س := س + 1;
                            }
                            إذا (جديد) {
                                ألحق(وسوم_التمهيد, الوسم);
                                عدد_حالات_توجيه_الوسم := عدد_حالات_توجيه_الوسم + 1;
                            };
                            إذا (بلا_حمولة) { ألحق(وسوم_مغلقة, الوسم); };
                            ألحق(وسوم_الأذرع, الوسم);
                            ألحق(أذرع_بلا_اختبار, بلا_حمولة);
                        };
                    };
                }
                | اختياري.موجود(نمط_دلالي.حرفي(_, الحرفي)) -> {
                    ليكن وسم_حرفي: متغير اختياري طبيعي = اختياري.لا_شيء();
                    إذا (مميز_ط32) {
                        طابق الحرفي مع
                        | قيمة_نمط_حرفي.عدد(القيمة) -> {
                            إذا (القيمة >= 0 && القيمة <= 4294967295) {
                                وسم_حرفي := اختياري.موجود(القيمة مثل طبيعي);
                            };
                        }
                        | قيمة_نمط_حرفي.عدد_طبيعي(القيمة) -> {
                            إذا (القيمة <= 4294967295) { وسم_حرفي := اختياري.موجود(القيمة); };
                        }
                        | _ -> { };
                    };
                    طابق وسم_حرفي مع
                    | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; }
                    | اختياري.موجود(الوسم) -> {
                        توجيه_صحيح := صواب;
                        // A literal arm admits nothing else: a repeated value
                        // is unreachable and keeps the arm-by-arm tests.
                        ليكن س: متغير طبيعي = 0;
                        طالما (س < (الطول(وسوم_مغلقة) مثل طبيعي)) {
                            إذا (وسوم_مغلقة[س] == الوسم) { مرشح_توجيه_وسم := خطأ; };
                            س := س + 1;
                        }
                        ألحق(وسوم_التمهيد, الوسم);
                        عدد_حالات_توجيه_الوسم := عدد_حالات_توجيه_الوسم + 1;
                        ألحق(وسوم_مغلقة, الوسم);
                        ألحق(وسوم_الأذرع, الوسم);
                        ألحق(أذرع_بلا_اختبار, صواب);
                    };
                }
                | اختياري.موجود(نمط_دلالي.بدل(_)) -> {
                    إذا (ق + 1 != عدد_الأذرع) { مرشح_توجيه_وسم := خطأ; };
                    ذراع_شامل_أخير := صواب;
                    ألحق(وسوم_الأذرع, 0);
                    ألحق(أذرع_بلا_اختبار, صواب);
                }
                | _ -> {
                    إذا (!الشامل || ق + 1 != عدد_الأذرع) {
                        مرشح_توجيه_وسم := خطأ;
                    } وإلا {
                        // A final irrefutable binding still runs its pattern
                        // lowering to bind the value.
                        ذراع_شامل_أخير := صواب;
                        ألحق(وسوم_الأذرع, 0);
                        ألحق(أذرع_بلا_اختبار, خطأ);
                    };
                };
            };
        }
        | اختياري.لا_شيء -> { مرشح_توجيه_وسم := خطأ; };
        ق := ق + 1;
    }
    إذا (عدد_حالات_توجيه_الوسم < 2) { مرشح_توجيه_وسم := خطأ; };

    // Blocks of the tag-dispatch strategy, created before any arm is lowered
    // so that a failing payload test can name the next arm of its tag.
    ليكن كتل_أجسام_التوجيه: متغير متجه معرف_كتلة_مسير = [];
    ليكن كتل_دخول_التوجيه: متغير متجه معرف_كتلة_مسير = [];
    ليكن دخول_افتراضي_التوجيه: متغير معرف_كتلة_مسير = كتلة_الفحص;
    إذا (مرشح_توجيه_وسم) {
        ليكن ب: متغير طبيعي = 0;
        طالما (ب < عدد_الأذرع) {
            ليكن كتلة_جسم: متغير معرف_كتلة_مسير = كتلة_الفحص;
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { كتلة_جسم := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            ألحق(كتل_أجسام_التوجيه, كتلة_جسم);
            إذا (أذرع_بلا_اختبار[ب]) {
                ألحق(كتل_دخول_التوجيه, كتلة_جسم);
            } وإلا {
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> { ألحق(كتل_دخول_التوجيه, الكتلة); }
                | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
            ب := ب + 1;
        }
        إذا (ذراع_شامل_أخير) {
            دخول_افتراضي_التوجيه := كتل_دخول_التوجيه[عدد_الأذرع - 1];
        } وإلا {
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { دخول_افتراضي_التوجيه := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            طابق اختم_بفخ_مسير(البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة, دخول_افتراضي_التوجيه) مع
            | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
            | نتيجة_بناء_منهي_مسير.مبني -> { };
        };
    };
    ليكن حالات_التوجيه: متغير متجه حالة_فرع_متعدد_مسير = [];

    إذا (عدد_الأذرع == 0) {
        طابق اختم_بفخ_مسير(البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة, كتلة_الفحص) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
        ليكن منتهية: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        منتهية.نشطة := خطأ;
        *الحالة := منتهية;
        أرجع اختياري.لا_شيء();
    };

    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأذرع) {
        ليكن مرجع_الذراع: &ذراع_مطابقة = &قائمة_الأذرع[ف];
        ليكن الجذر: متغير معرف_نمط = معرف_نمط_من(0);
        طابق معرف_نمط_ذراع_مطابقة_عند(سجل_الأنماط, مرجع_الذراع) مع
        | اختياري.موجود(المعرف) -> {
            الجذر := المعرف;
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };

        ليكن فهرس_التحقق: متغير طبيعي = 0;
        طابق فهرس_تحقق_ربط_نمط_وحدة_عند(&حقائق_تحقق_الأنماط, الجذر) مع
        | اختياري.موجود(المعرف) -> { فهرس_التحقق := المعرف; }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        ليكن مرجع_التحقق: &تحقق_نمط_نوعي = &حقائق_تحقق_الأنماط[فهرس_التحقق].التحقق;
        ليكن تحقق_الجذر: تحقق_نمط_نوعي = *مرجع_التحقق;
        // A guarded arm can fail even when its pattern cannot.
        ليكن له_حارس: متغير منطقي = خطأ;
        طابق قائمة_الأذرع[ف].الحارس مع
        | اختياري.موجود(_) -> { له_حارس := صواب; }
        | اختياري.لا_شيء -> { };
        ليكن غير_قابل_للدحض: منطقي = تحقق_الجذر.غير_قابل_للدحض && !له_حارس;
        ليكن الذراع_الشامل: منطقي = ذراع_شامل_أخير && (ف + 1) == عدد_الأذرع;

        ليكن كتلة_الجسم: متغير معرف_كتلة_مسير = كتلة_الفحص;
        إذا (مرشح_توجيه_وسم) {
            كتلة_الجسم := كتل_أجسام_التوجيه[ف];
        } وإلا {
            طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
            | نتيجة.نجح(الكتلة) -> {
                كتلة_الجسم := الكتلة;
            }
            | نتيجة.خطأ(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            };
        };

        // النمط غير القابل للدحض لا يحتاج مسار فشل. القيمة هنا حارس بنيوي فقط
        // ولا يستهلكها خفض النمط المقنن عندما تكون دلالات النمط غير قابلة للدحض.
        ليكن كتلة_التالي: متغير معرف_كتلة_مسير = كتلة_الجسم;
        إذا (!غير_قابل_للدحض && !مرشح_توجيه_وسم) {
            إذا ((ف + 1) < عدد_الأذرع) {
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_التالي := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
            } وإلا {
                ليكن كتلة_غير_مطابق: متغير معرف_كتلة_مسير = كتلة_الجسم;
                طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_غير_مطابق := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
                طابق اختم_بفخ_مسير(
                    البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة, كتلة_غير_مطابق
                ) مع
                | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_منهي_مسير.مبني -> { };
                كتلة_التالي := كتلة_غير_مطابق;
            };
        };

        // Tag dispatch: the switch enters the first arm of each tag; a
        // failing payload test continues with the next arm of the same tag,
        // otherwise with the final irrefutable arm or the trap.
        ليكن كتلة_فشل_التوجيه: متغير معرف_كتلة_مسير = دخول_افتراضي_التوجيه;
        إذا (مرشح_توجيه_وسم && !الذراع_الشامل) {
            ليكن وسم_الذراع: طبيعي = وسوم_الأذرع[ف];
            ليكن أول_للوسم: متغير منطقي = صواب;
            ليكن سابق: متغير طبيعي = 0;
            طالما (سابق < ف) {
                إذا (وسوم_الأذرع[سابق] == وسم_الذراع) { أول_للوسم := خطأ; };
                سابق := سابق + 1;
            }
            إذا (أول_للوسم) {
                ليكن لا_حجج_حالة: متجه معرف_قيمة_مسير = [];
                ليكن حافة_الدخول: حافة_مسير = {
                    الهدف: كتل_دخول_التوجيه[ف],
                    الحجج: لا_حجج_حالة
                };
                ليكن حالة_مباشرة: حالة_فرع_متعدد_مسير = { الوسم: وسم_الذراع, الحافة: حافة_الدخول };
                ألحق(حالات_التوجيه, حالة_مباشرة);
            };
            ليكن لاحق: متغير طبيعي = ف + 1;
            ليكن وجد_لاحق: متغير منطقي = خطأ;
            طالما (لاحق < عدد_الأذرع && !وجد_لاحق) {
                ليكن لاحق_شامل: منطقي = ذراع_شامل_أخير && (لاحق + 1) == عدد_الأذرع;
                إذا (!لاحق_شامل && وسوم_الأذرع[لاحق] == وسم_الذراع) {
                    كتلة_فشل_التوجيه := كتل_دخول_التوجيه[لاحق];
                    وجد_لاحق := صواب;
                };
                لاحق := لاحق + 1;
            }
        };
        إذا (مرشح_توجيه_وسم && الذراع_الشامل) {
            // Irrefutable: the failure edge is a structural guard only.
            كتلة_فشل_التوجيه := كتلة_الجسم;
        };
        ليكن حالة_الفحص: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        حالة_الفحص.الكتلة := كتلة_الفحص;
        حالة_الفحص.نشطة := صواب;
        // The alternative each or-pattern of the arm that binds names matched,
        // and the arm's `rest name`s (slices that view the scrutinee).
        ليكن البدائل_المختارة: متغير متجه بديل_مختار_خفض = [];
        ليكن رموز_البقايا: متجه معرف_رمز = رموز_بقايا_نمط_للخفض(سجل_الأنماط, روابط_الأسماء, الجذر);
        إذا (مرشح_توجيه_وسم && !أذرع_بلا_اختبار[ف]) {
            حالة_الفحص.الكتلة := كتل_دخول_التوجيه[ف];
            طابق اخفض_نمط_إلى_مسير(
                البرنامج, &متغير حالة_الفحص, مرجع_التحقق, الجذر, قيمة_المميز,
                كتلة_الجسم, كتلة_فشل_التوجيه, الأنواع, روابط_الأسماء, سجل_الأنماط, &متغير البدائل_المختارة
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };
        إذا (!مرشح_توجيه_وسم) {
            طابق اخفض_نمط_إلى_مسير(
                البرنامج, &متغير حالة_الفحص, مرجع_التحقق, الجذر, قيمة_المميز,
                كتلة_الجسم, كتلة_التالي, الأنواع, روابط_الأسماء, سجل_الأنماط, &متغير البدائل_المختارة
            ) مع
            | اختياري.موجود(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | اختياري.لا_شيء -> { };
        };

        // A guard: the pattern's success target is the guard's block, and the
        // arm's body starts where the guard held.
        طابق قائمة_الأذرع[ف].الحارس مع
        | اختياري.موجود(الحارس) -> {
            ليكن فشل_الحارس: متغير معرف_كتلة_مسير = كتلة_التالي;
            إذا (مرشح_توجيه_وسم) { فشل_الحارس := كتلة_فشل_التوجيه; };
            طابق اخفض_حارس_ذراع_إلى_مسير(
                البرنامج, &حالة_الفحص, كتلة_الجسم, فشل_الحارس, &الحارس,
                الطول(أصل_المحليات.المحليات) مثل طبيعي, المميز, بديل_المميز, بديل_حامل, &رموز_البقايا,
                الأنواع, أنواع_الرموز, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة.نجح(كتلة_الصواب) -> { كتلة_الجسم := كتلة_الصواب; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        }
        | اختياري.لا_شيء -> { };
        ليكن حالة_الجسم: متغير حالة_خفض_دالة = حالة_الفحص;
        حالة_الجسم.الكتلة := كتلة_الجسم;
        حالة_الجسم.نشطة := صواب;
        // The arm's bindings that own their value become owners when the arm
        // is entered. Such a binding moves out of a scrutinee local, which then
        // owns nothing more (SSF moves it in this arm).
        ليكن عدد_محليات_الأصل: طبيعي = الطول(أصل_المحليات.المحليات) مثل طبيعي;
        // A borrowed scrutinee makes the owning bindings borrowed views.
        اكتشف_عروض_ذراع_خفض(
            &(*البرنامج), &متغير حالة_الجسم, قيمة_المميز.المعرف, عدد_محليات_الأصل, أنواع_الرموز,
            دوال_الخفض
        );
        // An arm whose pattern would hold one owned storage twice borrows the
        // scrutinee (drops.sn, نمط_يستعير_المميز_خفض).
        إذا (نمط_يستعير_المميز_خفض(مرجع_التحقق, سجل_الأنماط, الأنواع, الجذر)) {
            ليكن المعدودة: متغير متجه معرف_رمز = [];
            ليكن ر_معدود: متغير طبيعي = عدد_محليات_الأصل;
            طالما (ر_معدود < (الطول(حالة_الجسم.المحليات) مثل طبيعي)) {
                إذا (هل_نوع_معدود_عادي_مسير(الأنواع, حالة_الجسم.المحليات[ر_معدود].النوع)) {
                    ألحق(المعدودة, حالة_الجسم.المحليات[ر_معدود].الرمز);
                };
                ر_معدود := ر_معدود + 1;
            }
            اجعل_روابط_الذراع_عروضا_خفض(&متغير حالة_الجسم, عدد_محليات_الأصل, &المعدودة, دوال_الخفض);
        };
        ليكن ذراع_مالكة: متغير منطقي = خطأ;
        ليكن ر_ربط: متغير طبيعي = عدد_محليات_الأصل;
        طالما (ر_ربط < (الطول(حالة_الجسم.المحليات) مثل طبيعي)) {
            ليكن رمز_الربط: معرف_رمز = حالة_الجسم.المحليات[ر_ربط].الرمز;
            // A counted binding (drops.sn, "Counted values") copies its part
            // of the scrutinee, which keeps it: it owns the copy and moves
            // nothing out.
            ليكن نوع_الربط: معرف_نوع = حالة_الجسم.المحليات[ر_ربط].النوع;
            ليكن ربط_معدود: منطقي = هل_نوع_معدود_عادي_مسير(الأنواع, نوع_الربط);
            ليكن يملك_الربط: متغير منطقي = !ربط_معدود;
            إذا (ربط_معدود) {
                طابق حالة_الجسم.المحليات[ر_ربط].المعلقة مع
                | اختياري.موجود(المعرف) -> {
                    ليكن المقروءة: قيمة_خفض_مسير = { المعرف: المعرف, النوع: نوع_الربط };
                    طابق انسخ_قيمة_معدودة_خفض(البرنامج, &متغير حالة_الجسم, المقروءة, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(المنسوخة) -> {
                        تأكد_محليات_خفض_فريدة(&متغير حالة_الجسم);
                        حالة_الجسم.المحليات[ر_ربط].المعلقة := اختياري.موجود(المنسوخة.المعرف);
                        يملك_الربط := صواب;
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            // The binding's place, where the arm is entered.
            طابق ثبّت_محلي_خفض(
                البرنامج, &متغير حالة_الجسم, رمز_الربط, الأنواع, دوال_الخفض, يملك_الربط,
                اختياري.لا_شيء()
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            إذا (!ربط_معدود && حالة_الجسم.المحليات[ر_ربط].مالك) {
                ذراع_مالكة := صواب;
            };
            ر_ربط := ر_ربط + 1;
        }
        سجل_روابط_ذراع_استعارة_خفض(
            البرنامج, &حالة_الجسم, المميز, بديل_المميز, بديل_حامل, عدد_محليات_الأصل, &رموز_البقايا,
            الأنواع,
            أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        );
        // The scrutinee gives up what the arm moves out; the rest of it is
        // destroyed here (C2). A call result that no arm binding takes is
        // owned by the arm like a local (C1).
        ليكن مميز_مؤقت: منطقي = مميز_مؤقت_للخفض(المميز)
            && هل_نوع_يملك_تخزينا_مسير(الأنواع, قيمة_المميز.النوع);
        ليكن مميز_مالك: متغير منطقي = مميز_مؤقت;
        إذا (ذراع_مالكة) {
            طابق *المميز مع
            | تعبير.اسم(_, اسم_المميز) -> {
                طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_المميز.النطاق) مع
                | اختياري.موجود(رمز_المميز) -> {
                    طابق موضع_محلي_خفض(&حالة_الجسم, رمز_المميز) مع
                    | اختياري.موجود(موضع_المميز) -> {
                        إذا (حالة_الجسم.المحليات[موضع_المميز].مالك) { مميز_مالك := صواب; };
                    }
                    | اختياري.لا_شيء -> { };
                    طابق أصدر_ملكية_محلي_خفض(البرنامج, &حالة_الجسم, رمز_المميز, حدث_ملكية_مسير.تسليم()) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    // The arm moves the scrutinee where the match reads it.
                    سجل_تسليم_مصدري_خفض(البرنامج, &حالة_الجسم, رمز_المميز, نطاق_تعبير(المميز));
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            إذا (مميز_مالك) {
                // Every part no owning binding takes (drops.sn).
                طابق أسقط_أجزاء_غير_مربوطة_خفض(
                    البرنامج, &متغير حالة_الجسم, مرجع_التحقق, الجذر, قيمة_المميز,
                    الأنواع, سجل_الأنماط, &البدائل_المختارة
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        } وإلا إذا (مميز_مؤقت) {
            طابق سجل_مالكا_مؤقتا_خفض(
                البرنامج, &متغير حالة_الجسم, قيمة_المميز.المعرف, قيمة_المميز.النوع, الأنواع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        ليكن مرجع_جسم_الذراع: &كتلة_عبارات = &قائمة_الأذرع[ف].الجسم;
        طابق اخفض_جسم_ذراع_مطابقة_إلى_مسير(
            البرنامج, التصحيح, الأصول, &متغير حالة_الجسم, مرجع_جسم_الذراع, نوع_الناتج,
            الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
            سجل_الأنماط, تحققات_الأنماط, دوال_الخفض,
            هويات_البدائيات, النطاق, ف, عدد_محليات_الأصل
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        إذا (حالة_الجسم.نشطة) {
            طابق أسقط_محليات_من_خفض(
                البرنامج, &متغير حالة_الجسم, عدد_محليات_الأصل, نهاية_نطاق_خفض((*مرجع_جسم_الذراع).النطاق)
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            اقصر_محليات_حالة_خفض(
                &متغير حالة_الجسم, الطول(أصل_المحليات.المحليات) مثل طبيعي
            );
            ألحق(حالات_الأذرع, حالة_الجسم);
        };

        إذا (مرشح_توجيه_وسم) {
            ف := ف + 1;
        } وإلا {
            إذا (غير_قابل_للدحض) {
                ف := عدد_الأذرع;
            } وإلا {
                كتلة_الفحص := كتلة_التالي;
                ف := ف + 1;
            };
        };
    }

    إذا (مرشح_توجيه_وسم) {
        ليكن نوع_الوسم: معرف_نوع;
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
        | اختياري.موجود(المعرف) -> { نوع_الوسم := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
        ليكن المميز: متغير معرف_قيمة_مسير = قيمة_المميز.المعرف;
        إذا (!توجيه_صحيح) {
            طابق أصدر_استعلام_وسم_مسير(
                البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة,
                مدخل_التوجيه, قيمة_المميز.المعرف, نوع_الوسم
            ) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { المميز := المعرف; }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        };
        ليكن لا_حجج_افتراضي: متجه معرف_قيمة_مسير = [];
        ليكن الافتراضي: حافة_مسير = {
            الهدف: دخول_افتراضي_التوجيه,
            الحجج: لا_حجج_افتراضي
        };
        ليكن الفرع: فرع_متعدد_مسير = {
            المميز: المميز,
            الحالات: حالات_التوجيه,
            الافتراضي: الافتراضي
        };
        طابق اختم_بفرع_متعدد_مسير(البرنامج, &أصل_المحليات.البناء, أصل_المحليات.الدالة, مدخل_التوجيه, الفرع) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    };

    ليكن عدد_الحالات_النشطة: طبيعي = الطول(حالات_الأذرع) مثل طبيعي;
    إذا (عدد_الحالات_النشطة == 0) {
        ليكن منتهية: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_المحليات);
        منتهية.نشطة := خطأ;
        *الحالة := منتهية;
        أرجع اختياري.لا_شيء();
    };

    // إذا لم يبق إلا مسار واحد مستمر فلا يوجد تقارب التحكم ولا حاجة إلى كتلة دمج.
    إذا (عدد_الحالات_النشطة == 1) {
        ليكن مرجع_الحالة: &حالة_خفض_دالة = &حالات_الأذرع[0];
        ليكن النهائية: حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(مرجع_الحالة);
        *الحالة := النهائية;
        أرجع اختياري.لا_شيء();
    };

    // كتلة الدمج تنشأ كسولا فقط بعد ثبوت وجود أكثر من مسار مستمر.
    ليكن كتلة_الدمج: متغير معرف_كتلة_مسير = أصل_المحليات.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, أصل_المحليات.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الدمج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };

    // The locals live in their places: the merge passes no value.
    ليكن محليات_الدمج: متجه ربط_محلي_خفض = قص_محليات_خفض(
        &أصل_المحليات.المحليات, الطول(أصل_المحليات.المحليات) مثل طبيعي
    );
    ليكن ح: متغير طبيعي = 0;
    طالما (ح < عدد_الحالات_النشطة) {
        ليكن مرجع_حالة: &حالة_خفض_دالة = &حالات_الأذرع[ح];
        ليكن حالة_ذراع: حالة_خفض_دالة = *مرجع_حالة;
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_ذراع, كتلة_الدمج, []) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        ح := ح + 1;
    }

    ليكن النهائية: حالة_خفض_دالة = {
        الدالة: أصل_المحليات.الدالة,
        الكتلة: كتلة_الدمج,
        نشطة: صواب,
        البناء: أصل_المحليات.البناء,
        المحليات: محليات_الدمج,
        له_هدف_خروج_حلقة: أصل_المحليات.له_هدف_خروج_حلقة,
        هدف_خروج_حلقة: أصل_المحليات.هدف_خروج_حلقة,
        له_هدف_متابعة_حلقة: أصل_المحليات.له_هدف_متابعة_حلقة,
        هدف_متابعة_حلقة: أصل_المحليات.هدف_متابعة_حلقة,
        عدد_محليات_متابعة_حلقة: أصل_المحليات.عدد_محليات_متابعة_حلقة,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: أصل_المحليات.إطار_الإسقاط,
        العروض: انسخ_عروض_خفض(&أصل_المحليات.العروض),
            يجد_العروض: أصل_المحليات.يجد_العروض,
            للتحليل: أصل_المحليات.للتحليل
    };
    *الحالة := النهائية;
    أرجع اختياري.لا_شيء();
}

// The name an assignment writes when its destination is a whole name.
عرف اسم_وجهة_للخفض(الوجهة: &تعبير): اختياري اسم {
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> { أرجع اختياري.موجود(الاسم); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// One statement. The store of an assignment to a whole local declared
// without `mutable` is recorded as a source use (the legality analysis
// allows it only as the local's first value; msir/ssf/ownership_legality.sn).
عرف اخفض_عبارة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    أرجع اخفض_عبارة_بأحداث_إلى_مسير(
        البرنامج, التصحيح, الأصول, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_الرموز,
        أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
        دوال_الخفض, هويات_البدائيات, خطأ
    );
}

// One statement, then the borrow events it states where it ends
// (borrow_events.sn); في_بداية_حلقة: a loop's initializer.
عرف اخفض_عبارة_بأحداث_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    في_بداية_حلقة: منطقي
): اختياري خطأ_خفض_مسير {
    // The works the statement's match expressions leave (expressions.sn,
    // عمل_خفض_مؤجل) are lowered once the statement is.
    ليكن أعمال_البداية: طبيعي = عدد_أعمال_خفض_مؤجلة();
    ليكن الناتج: اختياري خطأ_خفض_مسير = اخفض_عبارة_دون_مصدر_إلى_مسير(
        البرنامج, التصحيح, الأصول, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_الرموز,
        أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
        دوال_الخفض, هويات_البدائيات
    );
    طابق الناتج مع
    | اختياري.موجود(_) -> {
        اقطع_أعمال_خفض_مؤجلة(أعمال_البداية);
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> { };
    سجل_أحداث_عبارة_استعارة_خفض(
        البرنامج, الحالة, العبارة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات,
        في_بداية_حلقة
    );
    ليكن الوجهة: متغير اختياري اسم = اختياري.لا_شيء();
    ليكن نطاق_الوجهة: متغير نطاق = نطاق_فارغ();
    طابق *العبارة مع
    | عبارة.نسخ(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | عبارة.تهيئة_سجل(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | عبارة.تهيئة_صف(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | عبارة.تهيئة_متجه(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | عبارة.تهيئة_نص(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | عبارة.تهيئة_صندوق(_, الهدف, _) -> { الوجهة := اسم_وجهة_للخفض(&الهدف); نطاق_الوجهة := نطاق_تعبير(&الهدف); }
    | _ -> { };
    طابق الوجهة مع
    | اختياري.موجود(الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
            | اختياري.موجود(النوع) -> {
                إذا (!هل_غلاف_نوع_متغير(الأنواع, النوع)) {
                    سجل_إسناد_ثابت_مصدري_خفض(البرنامج, الحالة, الرمز, الاسم.النطاق, نطاق_الوجهة);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اخفض_أعمال_مؤجلة_إلى_مسير(
        البرنامج, التصحيح, الأصول, الحالة, أعمال_البداية, نوع_الناتج, الأنواع, أنواع_الرموز,
        أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط,
        دوال_الخفض, هويات_البدائيات
    );
}

عرف اخفض_عبارة_دون_مصدر_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    نوع_الناتج: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    ليكن أصل_العبارة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, نطاق_عبارة(&القيمة));
    ليكن موقع_العبارة: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, أصل_العبارة, (*الحالة).البناء.نطاق_التصحيح_الحالي,
        صواب, خطأ, خطأ, 0
    );
    عين_مرجع_تصحيح_مسير(
        &متغير (*الحالة).البناء, موقع_العبارة, (*الحالة).البناء.نطاق_التصحيح_الحالي
    );
    طابق القيمة مع
    | عبارة.تصريح_متغير(_, _, _) -> {
        أرجع اخفض_عبارة_تصريح_متغير_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء, دوال_الخفض);
    }
    | عبارة.تهيئة_سجل(_, _, _) -> {
        أرجع اخفض_عبارة_تهيئة_سجل_إلى_مسير(البرنامج, التصحيح_المتغير, الحالة, العبارة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.تهيئة_صف(_, _, _) -> {
        أرجع اخفض_عبارة_تهيئة_صف_إلى_مسير(البرنامج, التصحيح_المتغير, الحالة, العبارة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.تهيئة_متجه(_, _, _) -> {
        أرجع اخفض_عبارة_تهيئة_متجه_إلى_مسير(البرنامج, التصحيح_المتغير, الحالة, العبارة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.تهيئة_نص(النطاق, الوجهة, البايتات) -> {
        أرجع اخفض_تهيئة_نص_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &البايتات,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.تهيئة_صندوق(النطاق, الوجهة, الحمولة) -> {
        أرجع اخفض_تهيئة_صندوق_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &الحمولة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.نسخ(النطاق, الوجهة, المصدر) -> {
        أرجع اخفض_نسخ_إلى_مسير(
            البرنامج, التصحيح_المتغير, الحالة, النطاق, &الوجهة, &المصدر,
            الأنواع, أنواع_الرموز, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.استدعاء(_, _) -> {
        أرجع اخفض_عبارة_استدعاء_إلى_مسير(البرنامج, الحالة, العبارة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.أرجع(_, _) -> {
        أرجع اخفض_عبارة_أرجع_إلى_مسير(البرنامج, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.طابق(النطاق, المميز, الأذرع) -> {
        أرجع اخفض_مطابقة_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول, الحالة, النطاق, &المميز, &الأذرع, نوع_الناتج,
            الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء,
            سجل_الأنماط, تحققات_الأنماط, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.إذا(النطاق, الشرط, عند_الصواب, عند_الخطأ) -> {
        أرجع اخفض_إذا_إلى_مسير(
            البرنامج, التصحيح_المتغير, الأصول,
            الحالة,
            النطاق,
            &الشرط,
            &عند_الصواب,
            انسخ_مملوكا_اختيار_كتلة_عبارات(&عند_الخطأ),
            نوع_الناتج,
            الأنواع,
            أنواع_الرموز,
            أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        );
    }
    | عبارة.طالما(_, _, _) -> {
        أرجع اخفض_عبارة_طالما_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.لكل(_, _, _, _, _) -> {
        أرجع اخفض_عبارة_لكل_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.اخرج_من_حلقة(_) -> {
        أرجع اخفض_عبارة_اخرج_من_حلقة_إلى_مسير(البرنامج, الحالة, العبارة);
    }
    | عبارة.تابع_حلقة(_) -> {
        أرجع اخفض_عبارة_تابع_حلقة_إلى_مسير(البرنامج, الحالة, العبارة);
    }
    | عبارة.وقت_الترجمة(_, _) -> {
        أرجع اخفض_عبارة_وقت_الترجمة_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.إسناد_وقت_الترجمة(_, _, _, _) -> {
        أرجع اخفض_عبارة_إسناد_وقت_الترجمة_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات);
    }
    | عبارة.غير_آمن(_, _) -> {
        أرجع اخفض_عبارة_غير_آمن_إلى_مسير(البرنامج, التصحيح_المتغير, الأصول, الحالة, العبارة, نوع_الناتج, الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, دوال_الخفض, هويات_البدائيات);
    }
    // No backend compiles inline assembly yet: the user's construct, reported
    // on its span (previously an internal "statement not supported" failure).
    | عبارة.تجميع(النطاق, _) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تجميع_غير_مدعوم(النطاق));
    };
}

// The `تصريح_متغير` arm of اخفض_عبارة_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: nested blocks
// and else-if chains recurse through the dispatcher, whose frame held the
// locals of all its arms at once (11-18 KB a level).
عرف اخفض_عبارة_تصريح_متغير_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الحالة: &متغير حالة_خفض_دالة,
    العبارة: &عبارة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن القيمة: عبارة = *العبارة;
    طابق القيمة مع
    | عبارة.تصريح_متغير(_, الاسم, _) -> {
        ليكن الرمز: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.نجح(المعرف) -> {
            الرمز := المعرف;
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        };
        طابق نوع_رمز_دلالي_للخفض(الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, الرمز) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
            طابق أضف_محلي_خفض(الحالة, الرمز, النوع, اختياري.لا_شيء()) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            ليكن موقع_التصريح: اختياري معرف_موقع_تصحيح = موقع_تصريح_محلي_للخفض(
                التصحيح_المتغير, الأصول, الحالة, الاسم.النطاق
            );
            أرجع ثبّت_محلي_خفض(البرنامج, الحالة, الرمز, الأنواع, دوال_الخفض, صواب, موقع_التصريح);
        };
    }
    | _ -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_عبارة(العبارة)));
}

