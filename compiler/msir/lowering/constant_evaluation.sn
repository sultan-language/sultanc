استورد compiler.msir.msir_model;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.context;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.expression_types;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.types.type_identity;

// Compile-time evaluation is intentionally limited to pure scalar expressions.
// It consumes canonical semantic Type/Name facts and never executes runtime operations.
عام نوع نتيجة_تقييم_ثابت_خفض =
    | ثابت بنوع ثابت_مسير
    | مؤجل
    | غير_مدعوم
;

نوع نتيجة_قسمة_خام_ثابت =
    | صفر
    | حاصل بنوع (غير_موقع, غير_موقع)
;

عرف قناع_صحيح_ثابت(البتات: غير_موقع): غير_موقع {
    لو (البتات >= 64) {
        أرجع ((9223372036854775807 مثل غير_موقع) << 1) | 1;
    };
    أرجع ((1 مثل غير_موقع) << البتات) - 1;
}

عرف بت_إشارة_ثابت(البتات: غير_موقع): غير_موقع {
    أرجع (1 مثل غير_موقع) << (البتات - 1);
}

عرف هل_بت_مضبوط_ثابت(القيمة: غير_موقع, البت: غير_موقع): منطقي {
    دع الاختبار: غير_موقع = القيمة & البت;
    أرجع الاختبار != 0;
}

عرف جمع_خام_ثابت(أ: غير_موقع, ب: غير_موقع, البتات: غير_موقع): غير_موقع {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(البتات);
    دع س: غير_موقع = أ & القناع;
    دع ص: غير_موقع = ب & القناع;
    دع المتبقي: غير_موقع = القناع - س;
    لو (ص <= المتبقي) { أرجع س + ص; };
    أرجع ص - (المتبقي + 1);
}

عرف سالب_خام_ثابت(القيمة: غير_موقع, البتات: غير_موقع): غير_موقع {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(البتات);
    أرجع جمع_خام_ثابت((~القيمة) & القناع, 1, البتات);
}

عرف طرح_خام_ثابت(أ: غير_موقع, ب: غير_موقع, البتات: غير_موقع): غير_موقع {
    أرجع جمع_خام_ثابت(أ, سالب_خام_ثابت(ب, البتات), البتات);
}

عرف ضرب_خام_ثابت(أ: غير_موقع, ب: غير_موقع, البتات: غير_موقع): غير_موقع {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(البتات);
    دع المضروب: متغير غير_موقع = أ & القناع;
    دع العامل: متغير غير_موقع = ب & القناع;
    دع الناتج: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < البتات) {
        لو ((العامل & 1) != 0) {
            الناتج := جمع_خام_ثابت(الناتج, المضروب, البتات);
        };
        العامل := العامل >> 1;
        المضروب := جمع_خام_ثابت(المضروب, المضروب, البتات);
        ف := ف + 1;
    }
    أرجع الناتج & القناع;
}

عرف اقسم_خام_ثابت(
    البسط: غير_موقع,
    المقسوم_عليه: غير_موقع,
    البتات: غير_موقع
): نتيجة_قسمة_خام_ثابت {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(البتات);
    دع ب: غير_موقع = البسط & القناع;
    دع م: غير_موقع = المقسوم_عليه & القناع;
    لو (م == 0) { أرجع نتيجة_قسمة_خام_ثابت.صفر(); };
    دع الحاصل: متغير غير_موقع = 0;
    دع الباقي: متغير غير_موقع = ب;
    دع الموضع: متغير غير_موقع = البتات;
    بينما (الموضع > 0) {
        الموضع := الموضع - 1;
        لو (م <= (الباقي >> الموضع)) {
            الباقي := الباقي - (م << الموضع);
            الحاصل := الحاصل | ((1 مثل غير_موقع) << الموضع);
        };
    }
    أرجع نتيجة_قسمة_خام_ثابت.حاصل(الحاصل & القناع, الباقي & القناع);
}

عرف هل_تجاوز_جمع_ثابت(
    أ: غير_موقع,
    ب: غير_موقع,
    الناتج: غير_موقع,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (!الوصف.موقع) { أرجع الناتج < أ; };
    دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    دع ن_سالب: منطقي = هل_بت_مضبوط_ثابت(الناتج, الإشارة);
    أرجع (أ_سالب == ب_سالب) && (ن_سالب != أ_سالب);
}

عرف هل_تجاوز_طرح_ثابت(
    أ: غير_موقع,
    ب: غير_موقع,
    الناتج: غير_موقع,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (!الوصف.موقع) { أرجع أ < ب; };
    دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    دع ن_سالب: منطقي = هل_بت_مضبوط_ثابت(الناتج, الإشارة);
    أرجع (أ_سالب != ب_سالب) && (ن_سالب != أ_سالب);
}

عرف هل_تجاوز_ضرب_ثابت(
    أ: غير_موقع,
    ب: غير_موقع,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (أ == 0 || ب == 0) { أرجع خطأ; };
    دع الحد: متغير غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
    دع أ_قدر: متغير غير_موقع = أ;
    دع ب_قدر: متغير غير_موقع = ب;
    لو (الوصف.موقع) {
        دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
        دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
        دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
        لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
        لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
        لو (أ_سالب != ب_سالب) { الحد := الإشارة; } وإلا { الحد := الإشارة - 1; };
    };
    طابق اقسم_خام_ثابت(الحد, ب_قدر, الوصف.البتات) مع
    | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع خطأ; }
    | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> { أرجع أ_قدر > الحاصل; };
}

عرف هل_تجاوز_إزاحة_يسرى_ثابت(
    القيمة: غير_موقع,
    الإزاحة: غير_موقع,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (الإزاحة == 0) { أرجع خطأ; };
    دع القناع: غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
    دع الأصل: غير_موقع = القيمة & القناع;
    لو (!الوصف.موقع) {
        أرجع الأصل > (القناع >> الإزاحة);
    };
    دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
    لو (!هل_بت_مضبوط_ثابت(الأصل, الإشارة)) {
        أرجع الأصل > ((الإشارة - 1) >> الإزاحة);
    };
    دع القدر: غير_موقع = سالب_خام_ثابت(الأصل, الوصف.البتات);
    أرجع القدر > (الإشارة >> الإزاحة);
}

عرف ازح_يسارا_خام_ثابت(القيمة: غير_موقع, الإزاحة: غير_موقع, البتات: غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = القيمة & قناع_صحيح_ثابت(البتات);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الإزاحة) {
        الناتج := جمع_خام_ثابت(الناتج, الناتج, البتات);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ازح_يمينا_حسابيا_خام_ثابت(
    القيمة: غير_موقع,
    البتات: غير_موقع,
    الإزاحة: غير_موقع
): غير_موقع {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(البتات);
    دع المطبع: غير_موقع = القيمة & القناع;
    دع الناتج: متغير غير_موقع = المطبع >> الإزاحة;
    لو (الإزاحة > 0 && هل_بت_مضبوط_ثابت(المطبع, بت_إشارة_ثابت(البتات))) {
        دع المنخفضة: غير_موقع = قناع_صحيح_ثابت(البتات - الإزاحة);
        الناتج := الناتج | (القناع ^ المنخفضة);
    };
    أرجع الناتج & القناع;
}

عرف خام_ثابت_صحيح(الثابت: &ثابت_مسير, الوصف: وصف_صحيح_خفض): اختيار غير_موقع {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع اختيار.بعض((القيمة مثل غير_موقع) & القناع); }
    | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { أرجع اختيار.بعض(القيمة & القناع); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ثابت_صحيح_من_خام(الخام: غير_موقع, الوصف: وصف_صحيح_خفض): ثابت_مسير {
    دع القناع: غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
    دع القيمة: غير_موقع = الخام & القناع;
    لو (!الوصف.موقع) { أرجع ثابت_مسير.صحيح_غير_موقع(القيمة); };
    لو (الوصف.البتات == 64) { أرجع ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
    دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
    لو (!هل_بت_مضبوط_ثابت(القيمة, الإشارة)) { أرجع ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
    دع القدر: غير_موقع = سالب_خام_ثابت(القيمة, الوصف.البتات);
    أرجع ثابت_مسير.صحيح_موقع(0 - (القدر مثل عدد));
}

عرف قيمة_إزاحة_من_ثابت(الثابت: &ثابت_مسير): اختيار غير_موقع {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        لو (القيمة < 0) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(القيمة مثل غير_موقع);
    }
    | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { أرجع اختيار.بعض(القيمة); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قارن_خام_موقع_أصغر(أ: غير_موقع, ب: غير_موقع, البتات: غير_موقع): منطقي {
    دع الإشارة: غير_موقع = بت_إشارة_ثابت(البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    لو (أ_سالب != ب_سالب) { أرجع أ_سالب; };
    أرجع أ < ب;
}

عرف قارن_ثابتين_صحيحين(
    العامل: عامل_ثنائي,
    أ: غير_موقع,
    ب: غير_موقع,
    الوصف: وصف_صحيح_خفض
): اختيار منطقي {
    لو (العامل == عامل_ثنائي.يساوي()) { أرجع اختيار.بعض(أ == ب); };
    لو (العامل == عامل_ثنائي.لا_يساوي()) { أرجع اختيار.بعض(أ != ب); };
    دع أصغر: منطقي;
    دع أكبر: منطقي;
    لو (الوصف.موقع) {
        أصغر := قارن_خام_موقع_أصغر(أ, ب, الوصف.البتات);
        أكبر := قارن_خام_موقع_أصغر(ب, أ, الوصف.البتات);
    } وإلا {
        أصغر := أ < ب;
        أكبر := أ > ب;
    };
    لو (العامل == عامل_ثنائي.أصغر()) { أرجع اختيار.بعض(أصغر); };
    لو (العامل == عامل_ثنائي.أصغر_أو_يساوي()) { أرجع اختيار.بعض(!أكبر); };
    لو (العامل == عامل_ثنائي.أكبر()) { أرجع اختيار.بعض(أكبر); };
    لو (العامل == عامل_ثنائي.أكبر_أو_يساوي()) { أرجع اختيار.بعض(!أصغر); };
    أرجع اختيار.لا_شيء();
}

عرف قيم_حرفيا_ثابتا(
    الحرفي: حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_تقييم_ثابت_خفض {
    طابق الحرفي مع
    | حرفي.منطقي(القيمة) -> {
        لو (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(القيمة));
    }
    | حرفي.عدد(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | اختيار.بعض(الوصف) -> {
            لو (الوصف.موقع) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_موقع(القيمة)); };
            لو (القيمة < 0) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_غير_موقع(القيمة مثل غير_موقع));
        };
    }
    | حرفي.عدد_غير_موقع(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | اختيار.بعض(الوصف) -> {
            لو (الوصف.موقع) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_غير_موقع(القيمة));
        };
    }
    | حرفي.حرف(القيمة) -> {
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_غير_موقع(القيمة مثل غير_موقع));
    }
    | حرفي.عدد_عشري(البايتات) -> {
        لو (!هل_نوع_عشري_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.عشري(البايتات));
    }
    | حرفي.نص(البايتات) -> {
        لو (!هل_نوع_نص_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.نص(البايتات));
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
}

عرف قيم_حسابا_صحيحا_ثابتا(
    العامل: عامل_ثنائي,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير,
    الوصف: وصف_صحيح_خفض
): نتيجة_تقييم_ثابت_خفض {
    دع أ: غير_موقع;
    دع ب: غير_موقع;
    طابق خام_ثابت_صحيح(اليسار, الوصف) مع
    | اختيار.بعض(القيمة) -> { أ := القيمة; }
    | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    طابق خام_ثابت_صحيح(اليمين, الوصف) مع
    | اختيار.بعض(القيمة) -> { ب := القيمة; }
    | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

    طابق قارن_ثابتين_صحيحين(العامل, أ, ب, الوصف) مع
    | اختيار.بعض(القيمة) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(القيمة)); }
    | اختيار.لا_شيء -> { };

    دع الناتج: متغير غير_موقع = 0;
    طابق العامل مع
    | عامل_ثنائي.جمع -> {
        الناتج := جمع_خام_ثابت(أ, ب, الوصف.البتات);
        لو (هل_تجاوز_جمع_ثابت(أ, ب, الناتج, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | عامل_ثنائي.طرح -> {
        الناتج := طرح_خام_ثابت(أ, ب, الوصف.البتات);
        لو (هل_تجاوز_طرح_ثابت(أ, ب, الناتج, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | عامل_ثنائي.ضرب -> {
        لو (هل_تجاوز_ضرب_ثابت(أ, ب, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        الناتج := ضرب_خام_ثابت(أ, ب, الوصف.البتات);
    }
    | عامل_ثنائي.قسمة -> {
        لو (ب == 0) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الوصف.موقع) {
            دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
            دع القناع: غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
            لو (أ == الإشارة && ب == القناع) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
            دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
            دع أ_قدر: متغير غير_موقع = أ;
            دع ب_قدر: متغير غير_موقع = ب;
            لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
            لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
            طابق اقسم_خام_ثابت(أ_قدر, ب_قدر, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> {
                لو (أ_سالب != ب_سالب) { الناتج := سالب_خام_ثابت(الحاصل, الوصف.البتات); } وإلا { الناتج := الحاصل; };
            };
        } وإلا {
            طابق اقسم_خام_ثابت(أ, ب, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> { الناتج := الحاصل; };
        };
    }
    | عامل_ثنائي.باقي -> {
        لو (ب == 0) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الوصف.موقع) {
            دع الإشارة: غير_موقع = بت_إشارة_ثابت(الوصف.البتات);
            دع القناع: غير_موقع = قناع_صحيح_ثابت(الوصف.البتات);
            لو (أ == الإشارة && ب == القناع) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
            دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
            دع أ_قدر: متغير غير_موقع = أ;
            دع ب_قدر: متغير غير_موقع = ب;
            لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
            لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
            طابق اقسم_خام_ثابت(أ_قدر, ب_قدر, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(_, الباقي) -> {
                لو (أ_سالب) { الناتج := سالب_خام_ثابت(الباقي, الوصف.البتات); } وإلا { الناتج := الباقي; };
            };
        } وإلا {
            طابق اقسم_خام_ثابت(أ, ب, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(_, الباقي) -> { الناتج := الباقي; };
        };
    }
    | عامل_ثنائي.أو_بتي -> { الناتج := (أ | ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.أو_حصري -> { الناتج := (أ ^ ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.و_بتي -> { الناتج := (أ & ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.إزاحة_يسرى -> {
        دع الإزاحة: غير_موقع;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات || هل_تجاوز_إزاحة_يسرى_ثابت(أ, الإزاحة, الوصف)) {
            أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم();
        };
        الناتج := ازح_يسارا_خام_ثابت(أ, الإزاحة, الوصف.البتات);
    }
    | عامل_ثنائي.إزاحة_يمنى -> {
        دع الإزاحة: غير_موقع;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        الناتج := (أ >> الإزاحة) & قناع_صحيح_ثابت(الوصف.البتات);
    }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> {
        دع الإزاحة: غير_موقع;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        الناتج := ازح_يمينا_حسابيا_خام_ثابت(أ, الوصف.البتات, الإزاحة);
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الناتج, الوصف));
}

عام عرف قيم_تعبير_ثابت_للخفض(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_تقييم_ثابت_خفض {
    دع النوع: معرف_نوع;
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
    | اختيار.بعض(المعرف) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
        | اختيار.بعض(القيمة) -> { النوع := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

    طابق *التعبير مع
    | تعبير.حرفي(_, الحرفي) -> { أرجع قيم_حرفيا_ثابتا(الحرفي, النوع, الأنواع); }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | اختيار.بعض(الرمز) -> {
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
            | اختيار.بعض(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.ثابت(الثابت) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(الثابت); }
                | هدف_قيمة_عليا_خفض.عام(_) -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            };
        };
    }
    | تعبير.أحادي(_, العامل, صندوق_الداخل) -> {
        دع الداخل: تعبير = *صندوق_الداخل;
        دع ثابت_الداخل: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_الداخل := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        طابق العامل مع
        | عامل_أحادي.نفي -> {
            طابق ثابت_الداخل مع
            | ثابت_مسير.منطق(القيمة) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(!القيمة)); }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | عامل_أحادي.متمم -> {
            طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | اختيار.بعض(الوصف) -> {
                طابق خام_ثابت_صحيح(&ثابت_الداخل, الوصف) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
                | اختيار.بعض(الخام) -> {
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(
                        ثابت_صحيح_من_خام((~الخام) & قناع_صحيح_ثابت(الوصف.البتات), الوصف)
                    );
                };
            };
        }
        | عامل_أحادي.سالب -> {
            طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | اختيار.بعض(الوصف) -> {
                دع الخام: غير_موقع;
                طابق خام_ثابت_صحيح(&ثابت_الداخل, الوصف) مع
                | اختيار.بعض(القيمة) -> { الخام := القيمة; }
                | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
                دع الناتج: غير_موقع = طرح_خام_ثابت(0, الخام, الوصف.البتات);
                لو (هل_تجاوز_طرح_ثابت(0, الخام, الناتج, الوصف)) {
                    أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم();
                };
                أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الناتج, الوصف));
            };
        }
        | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | تعبير.ثنائي(_, العامل, صندوق_اليسار, صندوق_اليمين) -> {
        دع اليسار: تعبير = *صندوق_اليسار;
        دع اليمين: تعبير = *صندوق_اليمين;
        دع ثابت_اليسار: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&اليسار, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_اليسار := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

        لو (العامل == عامل_ثنائي.و()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(القيمة) -> { لو (!القيمة) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(خطأ)); }; }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };
        لو (العامل == عامل_ثنائي.أو()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(القيمة) -> { لو (القيمة) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(صواب)); }; }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };

        دع ثابت_اليمين: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&اليمين, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_اليمين := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

        لو (العامل == عامل_ثنائي.و() || العامل == عامل_ثنائي.أو()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(أ) -> {
                طابق ثابت_اليمين مع
                | ثابت_مسير.منطق(ب) -> {
                    لو (العامل == عامل_ثنائي.و()) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(أ && ب)); };
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(أ || ب));
                }
                | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };

        لو (العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(أ) -> {
                طابق ثابت_اليمين مع
                | ثابت_مسير.منطق(ب) -> {
                    دع متساويان: منطقي = أ == ب;
                    لو (العامل == عامل_ثنائي.يساوي()) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(متساويان)); };
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(!متساويان));
                }
                | _ -> { };
            }
            | _ -> { };
        };

        دع نوع_اليسار: معرف_نوع;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&اليسار)) مع
        | اختيار.بعض(المعرف) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
            | اختيار.بعض(القيمة) -> { نوع_اليسار := القيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        طابق وصف_صحيح_للخفض(الأنواع, نوع_اليسار) مع
        | اختيار.بعض(الوصف) -> { أرجع قيم_حسابا_صحيحا_ثابتا(العامل, &ثابت_اليسار, &ثابت_اليمين, الوصف); }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | تعبير.تحويل(_, صندوق_المصدر, _) -> {
        دع المصدر: تعبير = *صندوق_المصدر;
        دع ثابت_المصدر: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_المصدر := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&المصدر)) مع
        | اختيار.بعض(المعرف) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
            | اختيار.بعض(القيمة) -> { نوع_المصدر := القيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        دع وصف_المصدر: وصف_صحيح_خفض;
        دع وصف_الهدف: وصف_صحيح_خفض;
        طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
        | اختيار.بعض(القيمة) -> { وصف_المصدر := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختيار.بعض(القيمة) -> { وصف_الهدف := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        دع الخام_الأصل: غير_موقع;
        طابق خام_ثابت_صحيح(&ثابت_المصدر, وصف_المصدر) مع
        | اختيار.بعض(القيمة) -> { الخام_الأصل := القيمة; }
        | اختيار.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        دع الخام: متغير غير_موقع = الخام_الأصل & قناع_صحيح_ثابت(وصف_المصدر.البتات);
        لو (وصف_الهدف.البتات > وصف_المصدر.البتات && وصف_المصدر.موقع) {
            لو (هل_بت_مضبوط_ثابت(الخام, بت_إشارة_ثابت(وصف_المصدر.البتات))) {
                الخام := الخام | (قناع_صحيح_ثابت(وصف_الهدف.البتات) ^ قناع_صحيح_ثابت(وصف_المصدر.البتات));
            };
        };
        الخام := الخام & قناع_صحيح_ثابت(وصف_الهدف.البتات);
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الخام, وصف_الهدف));
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
}
