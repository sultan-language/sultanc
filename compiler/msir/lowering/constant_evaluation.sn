استورد compiler.msir.msir_model;
استورد compiler.msir.decimal_float_bits;
استورد compiler.interpreter.operations.float_software;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.msir_context;
استورد compiler.frontend.ast.expressions;
استورد compiler.frontend.ast.literals;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.expression_types;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_semantic_shape_queries;
استورد compiler.frontend.types.builtins_generated;

// Compile-time evaluation is pure. Vector elements use the same recursive
// evaluator as scalar module-level constants, without executing runtime code.
// It consumes canonical semantic Type/Name facts and never executes runtime operations.
عام نوع نتيجة_تقييم_ثابت_خفض =
    | ثابت بنوع ثابت_مسير
    | مؤجل
    | غير_مدعوم
    // The operation would trap at run time (integer overflow, division or
    // remainder by zero, a shift by the width or more): a compile-time
    // evaluation failure, as Rust's E0080 / arithmetic_overflow.
    | فخ
;

نوع نتيجة_قسمة_خام_ثابت =
    | صفر
    | حاصل بنوع (طبيعي, طبيعي)
;

عرف قناع_صحيح_ثابت(البتات: طبيعي): طبيعي {
    لو (البتات >= 64) {
        أرجع ((9223372036854775807 مثل طبيعي) << 1) | 1;
    };
    أرجع ((1 مثل طبيعي) << البتات) - 1;
}

عرف بت_إشارة_ثابت(البتات: طبيعي): طبيعي {
    أرجع (1 مثل طبيعي) << (البتات - 1);
}

عرف هل_بت_مضبوط_ثابت(القيمة: طبيعي, البت: طبيعي): منطقي {
    دع الاختبار: طبيعي = القيمة & البت;
    أرجع الاختبار != 0;
}

عرف جمع_خام_ثابت(أ: طبيعي, ب: طبيعي, البتات: طبيعي): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_ثابت(البتات);
    دع س: طبيعي = أ & القناع;
    دع ص: طبيعي = ب & القناع;
    دع المتبقي: طبيعي = القناع - س;
    لو (ص <= المتبقي) { أرجع س + ص; };
    أرجع ص - (المتبقي + 1);
}

عرف سالب_خام_ثابت(القيمة: طبيعي, البتات: طبيعي): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_ثابت(البتات);
    أرجع جمع_خام_ثابت((~القيمة) & القناع, 1, البتات);
}

عرف طرح_خام_ثابت(أ: طبيعي, ب: طبيعي, البتات: طبيعي): طبيعي {
    أرجع جمع_خام_ثابت(أ, سالب_خام_ثابت(ب, البتات), البتات);
}

عرف ضرب_خام_ثابت(أ: طبيعي, ب: طبيعي, البتات: طبيعي): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_ثابت(البتات);
    دع المضروب: متغير طبيعي = أ & القناع;
    دع العامل: متغير طبيعي = ب & القناع;
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البتات) {
        لو ((العامل & 1) != 0) {
            الناتج := جمع_خام_ثابت(الناتج, المضروب, البتات);
        };
        العامل := العامل >> 1;
        المضروب := جمع_خام_ثابت(المضروب, المضروب, البتات);
        ف := ف + 1;
    }
    أرجع الناتج & القناع;
}

عرف اقسم_خام_ثابت(
    البسط: طبيعي,
    المقسوم_عليه: طبيعي,
    البتات: طبيعي
): نتيجة_قسمة_خام_ثابت {
    دع القناع: طبيعي = قناع_صحيح_ثابت(البتات);
    دع ب: طبيعي = البسط & القناع;
    دع م: طبيعي = المقسوم_عليه & القناع;
    لو (م == 0) { أرجع نتيجة_قسمة_خام_ثابت.صفر(); };
    دع الحاصل: متغير طبيعي = 0;
    دع الباقي: متغير طبيعي = ب;
    دع الموضع: متغير طبيعي = البتات;
    طالما (الموضع > 0) {
        الموضع := الموضع - 1;
        لو (م <= (الباقي >> الموضع)) {
            الباقي := الباقي - (م << الموضع);
            الحاصل := الحاصل | ((1 مثل طبيعي) << الموضع);
        };
    }
    أرجع نتيجة_قسمة_خام_ثابت.حاصل(الحاصل & القناع, الباقي & القناع);
}

عرف هل_تجاوز_جمع_ثابت(
    أ: طبيعي,
    ب: طبيعي,
    الناتج: طبيعي,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (!الوصف.موقع) { أرجع الناتج < أ; };
    دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    دع ن_سالب: منطقي = هل_بت_مضبوط_ثابت(الناتج, الإشارة);
    أرجع (أ_سالب == ب_سالب) && (ن_سالب != أ_سالب);
}

عرف هل_تجاوز_طرح_ثابت(
    أ: طبيعي,
    ب: طبيعي,
    الناتج: طبيعي,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (!الوصف.موقع) { أرجع أ < ب; };
    دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    دع ن_سالب: منطقي = هل_بت_مضبوط_ثابت(الناتج, الإشارة);
    أرجع (أ_سالب != ب_سالب) && (ن_سالب != أ_سالب);
}

عرف هل_تجاوز_ضرب_ثابت(
    أ: طبيعي,
    ب: طبيعي,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (أ == 0 || ب == 0) { أرجع خطأ; };
    دع الحد: متغير طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
    دع أ_قدر: متغير طبيعي = أ;
    دع ب_قدر: متغير طبيعي = ب;
    لو (الوصف.موقع) {
        دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
        دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
        دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
        لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
        لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
        لو (أ_سالب != ب_سالب) { الحد := الإشارة; } وإلا { الحد := الإشارة - 1; };
    };
    طابق اقسم_خام_ثابت(الحد, ب_قدر, الوصف.البتات) مع
    | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع خطأ; }
    | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> { أرجع أ_قدر > الحاصل; };
}

عرف هل_تجاوز_إزاحة_يسرى_ثابت(
    القيمة: طبيعي,
    الإزاحة: طبيعي,
    الوصف: وصف_صحيح_خفض
): منطقي {
    لو (الإزاحة == 0) { أرجع خطأ; };
    دع القناع: طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
    دع الأصل: طبيعي = القيمة & القناع;
    لو (!الوصف.موقع) {
        أرجع الأصل > (القناع >> الإزاحة);
    };
    دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
    لو (!هل_بت_مضبوط_ثابت(الأصل, الإشارة)) {
        أرجع الأصل > ((الإشارة - 1) >> الإزاحة);
    };
    دع القدر: طبيعي = سالب_خام_ثابت(الأصل, الوصف.البتات);
    أرجع القدر > (الإشارة >> الإزاحة);
}

عرف ازح_يسارا_خام_ثابت(القيمة: طبيعي, الإزاحة: طبيعي, البتات: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = القيمة & قناع_صحيح_ثابت(البتات);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الإزاحة) {
        الناتج := جمع_خام_ثابت(الناتج, الناتج, البتات);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ازح_يمينا_حسابيا_خام_ثابت(
    القيمة: طبيعي,
    البتات: طبيعي,
    الإزاحة: طبيعي
): طبيعي {
    دع القناع: طبيعي = قناع_صحيح_ثابت(البتات);
    دع المطبع: طبيعي = القيمة & القناع;
    دع الناتج: متغير طبيعي = المطبع >> الإزاحة;
    لو (الإزاحة > 0 && هل_بت_مضبوط_ثابت(المطبع, بت_إشارة_ثابت(البتات))) {
        دع المنخفضة: طبيعي = قناع_صحيح_ثابت(البتات - الإزاحة);
        الناتج := الناتج | (القناع ^ المنخفضة);
    };
    أرجع الناتج & القناع;
}

عرف خام_ثابت_صحيح(الثابت: &ثابت_مسير, الوصف: وصف_صحيح_خفض): اختياري طبيعي {
    دع القناع: طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع اختياري.موجود((القيمة مثل طبيعي) & القناع); }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أرجع اختياري.موجود(القيمة & القناع); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ثابت_صحيح_من_خام(الخام: طبيعي, الوصف: وصف_صحيح_خفض): ثابت_مسير {
    دع القناع: طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
    دع القيمة: طبيعي = الخام & القناع;
    لو (!الوصف.موقع) { أرجع ثابت_مسير.صحيح_طبيعي(القيمة); };
    لو (الوصف.البتات == 64) { أرجع ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
    دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
    لو (!هل_بت_مضبوط_ثابت(القيمة, الإشارة)) { أرجع ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
    دع القدر: طبيعي = سالب_خام_ثابت(القيمة, الوصف.البتات);
    أرجع ثابت_مسير.صحيح_موقع(0 - (القدر مثل عدد));
}

عرف قيمة_إزاحة_من_ثابت(الثابت: &ثابت_مسير): اختياري طبيعي {
    طابق *الثابت مع
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        لو (القيمة < 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(القيمة مثل طبيعي);
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قارن_خام_موقع_أصغر(أ: طبيعي, ب: طبيعي, البتات: طبيعي): منطقي {
    دع الإشارة: طبيعي = بت_إشارة_ثابت(البتات);
    دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
    دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
    لو (أ_سالب != ب_سالب) { أرجع أ_سالب; };
    أرجع أ < ب;
}

عرف قارن_ثابتين_صحيحين(
    العامل: عامل_ثنائي,
    أ: طبيعي,
    ب: طبيعي,
    الوصف: وصف_صحيح_خفض
): اختياري منطقي {
    لو (العامل == عامل_ثنائي.يساوي()) { أرجع اختياري.موجود(أ == ب); };
    لو (العامل == عامل_ثنائي.لا_يساوي()) { أرجع اختياري.موجود(أ != ب); };
    دع أصغر: منطقي;
    دع أكبر: منطقي;
    لو (الوصف.موقع) {
        أصغر := قارن_خام_موقع_أصغر(أ, ب, الوصف.البتات);
        أكبر := قارن_خام_موقع_أصغر(ب, أ, الوصف.البتات);
    } وإلا {
        أصغر := أ < ب;
        أكبر := أ > ب;
    };
    لو (العامل == عامل_ثنائي.أصغر()) { أرجع اختياري.موجود(أصغر); };
    لو (العامل == عامل_ثنائي.أصغر_أو_يساوي()) { أرجع اختياري.موجود(!أكبر); };
    لو (العامل == عامل_ثنائي.أكبر()) { أرجع اختياري.موجود(أكبر); };
    لو (العامل == عامل_ثنائي.أكبر_أو_يساوي()) { أرجع اختياري.موجود(!أصغر); };
    أرجع اختياري.لا_شيء();
}

عرف هل_نوع_حرف_ثابت(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.حرف()) مع
    | اختياري.موجود(الحرف) -> { أرجع معرفا_نوع_متساويان(الحرف, النوع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف قيم_حرفيا_ثابتا(
    الحرفي: حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_تقييم_ثابت_خفض {
    طابق الحرفي مع
    | حرفي.منطقي(القيمة) -> {
        لو (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(القيمة));
    }
    | حرفي.عدد(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_موقع(القيمة)); };
            لو (القيمة < 0) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي));
        };
    }
    | حرفي.عدد_طبيعي(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_طبيعي(القيمة));
        };
    }
    | حرفي.حرف(القيمة) -> {
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي));
    }
    | حرفي.عدد_عشري(البايتات) -> {
        لو (!هل_نوع_عشري_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.عشري(البايتات));
    }
    | حرفي.نص(البايتات) -> {
        لو (!هل_نوع_نص_للخفض(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.نص(البايتات));
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
}

عرف قيم_حسابا_صحيحا_ثابتا(
    العامل: عامل_ثنائي,
    اليسار: &ثابت_مسير,
    اليمين: &ثابت_مسير,
    الوصف: وصف_صحيح_خفض
): نتيجة_تقييم_ثابت_خفض {
    دع أ: طبيعي;
    دع ب: طبيعي;
    طابق خام_ثابت_صحيح(اليسار, الوصف) مع
    | اختياري.موجود(القيمة) -> { أ := القيمة; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    طابق خام_ثابت_صحيح(اليمين, الوصف) مع
    | اختياري.موجود(القيمة) -> { ب := القيمة; }
    | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

    طابق قارن_ثابتين_صحيحين(العامل, أ, ب, الوصف) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(القيمة)); }
    | اختياري.لا_شيء -> { };

    دع الناتج: متغير طبيعي = 0;
    طابق العامل مع
    | عامل_ثنائي.جمع -> {
        الناتج := جمع_خام_ثابت(أ, ب, الوصف.البتات);
        لو (هل_تجاوز_جمع_ثابت(أ, ب, الناتج, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
    }
    | عامل_ثنائي.طرح -> {
        الناتج := طرح_خام_ثابت(أ, ب, الوصف.البتات);
        لو (هل_تجاوز_طرح_ثابت(أ, ب, الناتج, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
    }
    | عامل_ثنائي.ضرب -> {
        لو (هل_تجاوز_ضرب_ثابت(أ, ب, الوصف)) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        الناتج := ضرب_خام_ثابت(أ, ب, الوصف.البتات);
    }
    | عامل_ثنائي.قسمة -> {
        لو (ب == 0) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        لو (الوصف.موقع) {
            دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
            دع القناع: طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
            لو (أ == الإشارة && ب == القناع) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
            دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
            دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
            دع أ_قدر: متغير طبيعي = أ;
            دع ب_قدر: متغير طبيعي = ب;
            لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
            لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
            طابق اقسم_خام_ثابت(أ_قدر, ب_قدر, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> {
                لو (أ_سالب != ب_سالب) { الناتج := سالب_خام_ثابت(الحاصل, الوصف.البتات); } وإلا { الناتج := الحاصل; };
            };
        } وإلا {
            طابق اقسم_خام_ثابت(أ, ب, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(الحاصل, _) -> { الناتج := الحاصل; };
        };
    }
    | عامل_ثنائي.باقي -> {
        لو (ب == 0) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        لو (الوصف.موقع) {
            دع الإشارة: طبيعي = بت_إشارة_ثابت(الوصف.البتات);
            دع القناع: طبيعي = قناع_صحيح_ثابت(الوصف.البتات);
            لو (أ == الإشارة && ب == القناع) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
            دع أ_سالب: منطقي = هل_بت_مضبوط_ثابت(أ, الإشارة);
            دع ب_سالب: منطقي = هل_بت_مضبوط_ثابت(ب, الإشارة);
            دع أ_قدر: متغير طبيعي = أ;
            دع ب_قدر: متغير طبيعي = ب;
            لو (أ_سالب) { أ_قدر := سالب_خام_ثابت(أ, الوصف.البتات); };
            لو (ب_سالب) { ب_قدر := سالب_خام_ثابت(ب, الوصف.البتات); };
            طابق اقسم_خام_ثابت(أ_قدر, ب_قدر, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(_, الباقي) -> {
                لو (أ_سالب) { الناتج := سالب_خام_ثابت(الباقي, الوصف.البتات); } وإلا { الناتج := الباقي; };
            };
        } وإلا {
            طابق اقسم_خام_ثابت(أ, ب, الوصف.البتات) مع
            | نتيجة_قسمة_خام_ثابت.صفر -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); }
            | نتيجة_قسمة_خام_ثابت.حاصل(_, الباقي) -> { الناتج := الباقي; };
        };
    }
    | عامل_ثنائي.أو_بتي -> { الناتج := (أ | ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.أو_حصري -> { الناتج := (أ ^ ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.و_بتي -> { الناتج := (أ & ب) & قناع_صحيح_ثابت(الوصف.البتات); }
    | عامل_ثنائي.إزاحة_يسرى -> {
        دع الإزاحة: طبيعي;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختياري.موجود(القيمة) -> { الإزاحة := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات || هل_تجاوز_إزاحة_يسرى_ثابت(أ, الإزاحة, الوصف)) {
            أرجع نتيجة_تقييم_ثابت_خفض.فخ();
        };
        الناتج := ازح_يسارا_خام_ثابت(أ, الإزاحة, الوصف.البتات);
    }
    | عامل_ثنائي.إزاحة_يمنى -> {
        دع الإزاحة: طبيعي;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختياري.موجود(القيمة) -> { الإزاحة := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        الناتج := (أ >> الإزاحة) & قناع_صحيح_ثابت(الوصف.البتات);
    }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> {
        دع الإزاحة: طبيعي;
        طابق قيمة_إزاحة_من_ثابت(اليمين) مع
        | اختياري.موجود(القيمة) -> { الإزاحة := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (الإزاحة >= الوصف.البتات) { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        الناتج := ازح_يمينا_حسابيا_خام_ثابت(أ, الوصف.البتات, الإزاحة);
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الناتج, الوصف));
}

عام عرف قيم_تعبير_ثابت_للخفض(
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_تقييم_ثابت_خفض {
    دع النوع: معرف_نوع;
    طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(التعبير)) مع
    | اختياري.موجود(المعرف) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
        | اختياري.موجود(القيمة) -> { النوع := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };

    طابق *التعبير مع
    | تعبير.وقت_الترجمة(_, المملوك) -> {
        // Nested comptime shares this evaluator and never falls back to runtime.
        دع الداخل: تعبير = *المملوك;
        أرجع قيم_تعبير_ثابت_للخفض(
            &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        );
    }
    | تعبير.تسلسل_وقت_الترجمة(_, التعابير) -> {
        دع النتيجة: متغير نتيجة_تقييم_ثابت_خفض = نتيجة_تقييم_ثابت_خفض.غير_مدعوم();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            النتيجة := قيم_تعبير_ثابت_للخفض(
                &التعابير[ف], الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
            );
            طابق النتيجة مع
            | نتيجة_تقييم_ثابت_خفض.ثابت(_) -> { }
            | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            ف := ف + 1;
        }
        أرجع النتيجة;
    }
    | تعبير.حرفي(_, الحرفي) -> { أرجع قيم_حرفيا_ثابتا(انسخ_مملوكا_حرفي(&الحرفي), النوع, الأنواع); }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> {
            // The canonical Name occurrence must explicitly authorize null;
            // an unrelated unresolved raw-pointer name is never a constant.
            لو (!هل_ظهور_مؤشر_فارغ_سياقي(روابط_الأسماء, الاسم.النطاق)) {
                أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم();
            };
            طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(مرجع_النوع_33) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_33.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> {
                أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.مؤشر_فارغ());
            }
                | _ -> { };
            };
            أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم();
        }
        | اختياري.موجود(الرمز) -> {
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.ثابت(الثابت) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(انسخ_ثابت_مسير(&الثابت)); }
                | هدف_قيمة_عليا_خفض.عام(_) -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            };
        };
    }
    | تعبير.أحادي(_, العامل, صندوق_الداخل) -> {
        دع الداخل: تعبير = *صندوق_الداخل;
        دع ثابت_الداخل: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_الداخل := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        طابق العامل مع
        | عامل_أحادي.نفي -> {
            طابق ثابت_الداخل مع
            | ثابت_مسير.منطق(القيمة) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(!القيمة)); }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | عامل_أحادي.متمم -> {
            طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | اختياري.موجود(الوصف) -> {
                طابق خام_ثابت_صحيح(&ثابت_الداخل, الوصف) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
                | اختياري.موجود(الخام) -> {
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(
                        ثابت_صحيح_من_خام((~الخام) & قناع_صحيح_ثابت(الوصف.البتات), الوصف)
                    );
                };
            };
        }
        | عامل_أحادي.سالب -> {
            // Reuse the canonical decimal spelling and conversion rather
            // than computing a host-dependent floating-point negation.
            لو (هل_نوع_عشري_للخفض(الأنواع, النوع)) {
                طابق ثابت_الداخل مع
                | ثابت_مسير.عشري(البايتات) -> {
                    دع المقلوبة: متغير متجه ط8 = [];
                    دع بداية: متغير طبيعي = 0;
                    لو ((الطول(البايتات) مثل طبيعي) > 0
                        && البايتات[0] == 0x2D) {
                        بداية := 1;
                    } وإلا { ألحق(المقلوبة, 0x2D مثل ط8); };
                    دع فهرس_البايت: متغير طبيعي = بداية;
                    طالما (فهرس_البايت < (الطول(البايتات) مثل طبيعي)) {
                        ألحق(المقلوبة, البايتات[فهرس_البايت]);
                        فهرس_البايت := فهرس_البايت + 1;
                    }
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.عشري(المقلوبة));
                }
                | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            };
            طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
            | اختياري.موجود(الوصف) -> {
                دع الخام: طبيعي;
                طابق خام_ثابت_صحيح(&ثابت_الداخل, الوصف) مع
                | اختياري.موجود(القيمة) -> { الخام := القيمة; }
                | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
                دع الناتج: طبيعي = طرح_خام_ثابت(0, الخام, الوصف.البتات);
                لو (هل_تجاوز_طرح_ثابت(0, الخام, الناتج, الوصف)) {
                    أرجع نتيجة_تقييم_ثابت_خفض.فخ();
                };
                أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الناتج, الوصف));
            };
        }
        | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | تعبير.ثنائي(_, العامل, صندوق_اليسار, صندوق_اليمين) -> {
        دع اليسار: تعبير = *صندوق_اليسار;
        دع اليمين: تعبير = *صندوق_اليمين;
        دع ثابت_اليسار: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&اليسار, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_اليسار := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };

        لو (العامل == عامل_ثنائي.و()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(القيمة) -> { لو (!القيمة) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(خطأ)); }; }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };
        لو (العامل == عامل_ثنائي.أو()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(القيمة) -> { لو (القيمة) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(صواب)); }; }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };

        دع ثابت_اليمين: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&اليمين, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_اليمين := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };

        لو (العامل == عامل_ثنائي.و() || العامل == عامل_ثنائي.أو()) {
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(أ) -> {
                طابق ثابت_اليمين مع
                | ثابت_مسير.منطق(ب) -> {
                    لو (العامل == عامل_ثنائي.و()) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(أ && ب)); };
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(أ || ب));
                }
                | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            }
            | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        };

        لو (العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي()) {
            // Both operands were checked against the same raw-pointer Type.
            // A typed null is a pointer constant, never an integer zero.
            طابق ثابت_اليسار مع
            | ثابت_مسير.مؤشر_فارغ -> {
                طابق ثابت_اليمين مع
                | ثابت_مسير.مؤشر_فارغ -> {
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(
                        ثابت_مسير.منطق(العامل == عامل_ثنائي.يساوي())
                    );
                }
                | _ -> { };
            }
            | _ -> { };
            طابق ثابت_اليسار مع
            | ثابت_مسير.منطق(أ) -> {
                طابق ثابت_اليمين مع
                | ثابت_مسير.منطق(ب) -> {
                    دع متساويان: منطقي = أ == ب;
                    لو (العامل == عامل_ثنائي.يساوي()) { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(متساويان)); };
                    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.منطق(!متساويان));
                }
                | _ -> { };
            }
            | _ -> { };
        };

        دع نوع_اليسار: معرف_نوع;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&اليسار)) مع
        | اختياري.موجود(المعرف) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
            | اختياري.موجود(القيمة) -> { نوع_اليسار := القيمة; }
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        طابق وصف_صحيح_للخفض(الأنواع, نوع_اليسار) مع
        | اختياري.موجود(الوصف) -> { أرجع قيم_حسابا_صحيحا_ثابتا(العامل, &ثابت_اليسار, &ثابت_اليمين, الوصف); }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    }
    | تعبير.تحويل(_, صندوق_المصدر, _) -> {
        دع المصدر: تعبير = *صندوق_المصدر;
        دع ثابت_المصدر: ثابت_مسير;
        طابق قيم_تعبير_ثابت_للخفض(&المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { ثابت_المصدر := القيمة; }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        دع نوع_المصدر: معرف_نوع;
        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&المصدر)) مع
        | اختياري.موجود(المعرف) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
            | اختياري.موجود(القيمة) -> { نوع_المصدر := القيمة; }
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        لو (هل_نوع_عشري_للخفض(الأنواع, نوع_المصدر) || هل_نوع_عشري_للخفض(الأنواع, النوع)) {
            أرجع قيم_تحويل_عائم_ثابتا(&ثابت_المصدر, نوع_المصدر, النوع, الأنواع);
        };
        دع وصف_المصدر: وصف_صحيح_خفض;
        دع وصف_الهدف: وصف_صحيح_خفض;
        طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
        | اختياري.موجود(القيمة) -> { وصف_المصدر := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(القيمة) -> { وصف_الهدف := القيمة; }
        | اختياري.لا_شيء -> {
            // `u8 as char`: a char constant is its 32-bit unsigned code point.
            لو (!هل_نوع_حرف_ثابت(الأنواع, النوع)) { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
            دع وصف_الحرف: وصف_صحيح_خفض = { موقع: خطأ, البتات: 32 };
            وصف_الهدف := وصف_الحرف;
        };
        دع الخام_الأصل: طبيعي;
        طابق خام_ثابت_صحيح(&ثابت_المصدر, وصف_المصدر) مع
        | اختياري.موجود(القيمة) -> { الخام_الأصل := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        دع الخام: متغير طبيعي = الخام_الأصل & قناع_صحيح_ثابت(وصف_المصدر.البتات);
        لو (وصف_الهدف.البتات > وصف_المصدر.البتات && وصف_المصدر.موقع) {
            لو (هل_بت_مضبوط_ثابت(الخام, بت_إشارة_ثابت(وصف_المصدر.البتات))) {
                الخام := الخام | (قناع_صحيح_ثابت(وصف_الهدف.البتات) ^ قناع_صحيح_ثابت(وصف_المصدر.البتات));
            };
        };
        الخام := الخام & قناع_صحيح_ثابت(وصف_الهدف.البتات);
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الخام, وصف_الهدف));
    }
    | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
}

// A constant float conversion (`2.5 as i32`, `n as f64` with a constant n),
// computed with the interpreter's IEEE-754 software (the same results as
// at run time); a float result is kept as its exact decimal text.
عرف قيم_تحويل_عائم_ثابتا(
    الثابت: &ثابت_مسير,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_تقييم_ثابت_خفض {
    دع الخام: متغير طبيعي = 0;
    دع بتات_المصدر: متغير طبيعي = 0;
    دع مصدر_موقع: متغير منطقي = خطأ;
    دع مصدر_عائم: منطقي = هل_نوع_عشري_للخفض(الأنواع, نوع_المصدر);
    لو (مصدر_عائم) {
        بتات_المصدر := 64;
        لو (هل_نوع_بدائي_للخفض(الأنواع, نوع_المصدر, نوع_بدائي_مقنن.ع32())) { بتات_المصدر := 32; };
        طابق *الثابت مع
        | ثابت_مسير.عشري(البايتات) -> {
            طابق بتات_عائم_من_عشري(&البايتات, بتات_المصدر) مع
            | اختياري.موجود(ب) -> { الخام := ب; }
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | _ -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    } وإلا {
        طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
        | اختياري.موجود(الوصف) -> {
            بتات_المصدر := الوصف.البتات;
            مصدر_موقع := الوصف.موقع;
            طابق خام_ثابت_صحيح(الثابت, الوصف) مع
            | اختياري.موجود(ق) -> { الخام := ق; }
            | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    };
    لو (هل_نوع_عشري_للخفض(الأنواع, نوع_الهدف)) {
        دع بتات_الهدف: متغير طبيعي = 64;
        لو (هل_نوع_بدائي_للخفض(الأنواع, نوع_الهدف, نوع_بدائي_مقنن.ع32())) { بتات_الهدف := 32; };
        دع الناتج: متغير طبيعي = 0;
        لو (مصدر_عائم) {
            الناتج := عائم_إلى_عائم_برمجي(الخام, وصف_عائم_برمجي_من(بتات_المصدر), وصف_عائم_برمجي_من(بتات_الهدف));
        } وإلا {
            الناتج := صحيح_إلى_عائم_برمجي(الخام, بتات_المصدر, مصدر_موقع, وصف_عائم_برمجي_من(بتات_الهدف));
        };
        طابق نص_عشري_دقيق_من_بتات(الناتج, بتات_الهدف) مع
        | اختياري.موجود(النص) -> { أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.عشري(النص)); }
        | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
    };
    طابق وصف_صحيح_للخفض(الأنواع, نوع_الهدف) مع
    | اختياري.موجود(الوصف) -> {
        دع الناتج: طبيعي = عائم_إلى_صحيح_برمجي(الخام, وصف_عائم_برمجي_من(بتات_المصدر), الوصف.البتات, الوصف.موقع);
        أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_صحيح_من_خام(الناتج, الوصف));
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); };
}

// An integer constant stored in a declaration of another integer Type: the
// Frontend accepts only widening that keeps the value (`u8` into `int`), so
// the constant is the same number in the declared Type's signedness.
عام عرف ثابت_صحيح_بنوع_الوجهة(الثابت: ثابت_مسير, الأنواع: &سجل_أنواع, النوع: معرف_نوع): ثابت_مسير {
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع الثابت; }
    | اختياري.موجود(الوصف) -> {
        طابق الثابت مع
        | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
            لو (الوصف.موقع) { أرجع ثابت_مسير.صحيح_موقع(القيمة مثل عدد); };
            أرجع ثابت_مسير.صحيح_طبيعي(القيمة);
        }
        | ثابت_مسير.صحيح_موقع(القيمة) -> {
            لو (!الوصف.موقع && القيمة >= 0) { أرجع ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي); };
            أرجع ثابت_مسير.صحيح_موقع(القيمة);
        }
        | _ -> { أرجع الثابت; };
    };
}

// The element types are resolved and checked by Frontend before constant evaluation.
عام عرف قيم_متجه_ثابتا_للخفض(
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_تقييم_ثابت_خفض {
    دع الثوابت: متغير متجه ثابت_مسير = [];
    دع فهرس_العنصر: متغير طبيعي = 0;
    طالما (فهرس_العنصر < (الطول(*العناصر) مثل طبيعي)) {
        طابق قيم_تعبير_ثابت_للخفض(
            &(*العناصر)[فهرس_العنصر], الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض
        ) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(الثابت) -> { ألحق(الثوابت, الثابت); }
        | نتيجة_تقييم_ثابت_خفض.مؤجل -> { أرجع نتيجة_تقييم_ثابت_خفض.مؤجل(); }
        | نتيجة_تقييم_ثابت_خفض.غير_مدعوم -> { أرجع نتيجة_تقييم_ثابت_خفض.غير_مدعوم(); }
        | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_تقييم_ثابت_خفض.فخ(); };
        فهرس_العنصر := فهرس_العنصر + 1;
    }
    أرجع نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.متجه(الثوابت));
}
