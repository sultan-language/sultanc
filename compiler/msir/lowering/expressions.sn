استورد compiler.frontend.types.type_context;
// خفض التعبيرات وقلب الاجتياز التكراري للتعبير.
// Inspect the already-emitted SSA place rather than lowering a source index a
// second time. Re-evaluating an index or vector expression could duplicate
// side effects and would no longer describe the pointer passed to the kernel.
// Locate the already emitted SSA definition across blocks. A borrow can be
// constructed in an earlier block and forwarded to the syscall block; never
// evaluate the source expression again just to recover its provenance.
عرف عملية_تعريف_حجة_نداء_خام(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المعرف: معرف_قيمة_مسير
): اختياري عملية_مسير {
    ليكن الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    ليكن فهرس_كتلة: متغير طبيعي = 0;
    طالما (فهرس_كتلة < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن الكتلة: &كتلة_مسير = &(*الدالة).الكتل[فهرس_كتلة];
        ليكن فهرس_تعليمة: متغير طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
        طالما (فهرس_تعليمة > 0) {
            فهرس_تعليمة := فهرس_تعليمة - 1;
            ليكن التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[فهرس_تعليمة];
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
            | اختياري.موجود(القيمة) -> {
                إذا (قيمتا_مسير_متساويتان(القيمة.المعرف, المعرف)) {
                    ليكن مرجع_العملية: &عملية_مسير = &(*التعليمة).العملية;
                    ليكن العملية: عملية_مسير = انسخ_مملوكا_عملية_مسير(مرجع_العملية);
                    أرجع اختياري.موجود(العملية);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        فهرس_كتلة := فهرس_كتلة + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A source witness requires BOTH resolved canonical declarations: the Linux
// target selector and its exact enum constructor. Neither spelling, a number,
// nor the caller's module grants an operation identity.
عرف رمز_هدف_تعبير_نداء_لينكس(
    التعبير: &تعبير,
    الروابط: &سياق_روابط_أسماء
): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | تعبير.حقل(_, _, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عقد_عملية_لينكس_من_تعبير(
    المصدر: &تعبير,
    الرقم: معرف_قيمة_مسير,
    الروابط: &سياق_روابط_أسماء,
    الدوال: &سياق_دوال_خفض
): اختياري عقد_نواة_مسير {
    ليكن منتقي: معرف_رمز;
    طابق (*الدوال).منتقي_لينكس مع
    | اختياري.موجود(الرمز) -> { منتقي := الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن تعبير_المنتقي: تعبير;
    ليكن حجج_المنتقي: متجه تعبير;
    طابق *المصدر مع
    | تعبير.استدعاء(_, الهدف, الحجج) -> {
        تعبير_المنتقي := *الهدف;
        حجج_المنتقي := الحجج;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا ((الطول(حجج_المنتقي) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
    طابق رمز_هدف_تعبير_نداء_لينكس(&تعبير_المنتقي, الروابط) مع
    | اختياري.موجود(الرمز) -> {
        إذا (!معرفا_رمز_متساويان(منتقي, الرمز)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن تعبير_المنشئ: تعبير;
    ليكن حجج_المنشئ: متجه تعبير;
    طابق حجج_المنتقي[0] مع
    | تعبير.استدعاء(_, الهدف, الحجج) -> {
        تعبير_المنشئ := *الهدف;
        حجج_المنشئ := الحجج;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا (الطول(حجج_المنشئ) != 0) { أرجع اختياري.لا_شيء(); };
    ليكن رمز_المنشئ: معرف_رمز;
    طابق رمز_هدف_تعبير_نداء_لينكس(&تعبير_المنشئ, الروابط) مع
    | اختياري.موجود(الرمز) -> { رمز_المنشئ := الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدوال).منشئات_لينكس) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الدوال).منشئات_لينكس[ف].الرمز, رمز_المنشئ)) {
            ليكن الهدف: معرف_دالة_مسير;
            طابق دالة_خفض_عند(الدوال, منتقي) مع
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_دالة_خفض.داخلية(المعرف) -> { الهدف := المعرف; }
                | _ -> { أرجع اختياري.لا_شيء(); };
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ليكن العقد: عقد_نواة_مسير = {
                المنشئ: رمز_المنشئ,
                الترتيب: (*الدوال).منشئات_لينكس[ف].الترتيب,
                المنتقي: الهدف, الرقم: الرقم
            };
            أرجع اختياري.موجود(العقد);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Attach only complete, canonical contracts. Missing pointer provenance or an
// unsupported operation leaves the raw syscall untrusted (Interpreter rejects).
عرف أكمل_عقد_ذاكرة_نداء_لينكس(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    نوع_ط64: معرف_نوع,
    العقد: عقد_نواة_مسير,
    الحجج: &متجه معرف_قيمة_مسير,
    النطاقات: &متغير متجه نطاق_ذاكرة_نداء_مسير
): منطقي {
    ليكن توقيع_موثق: متغير اختياري توقيع_نداء_بدائي = اختياري.لا_شيء();
    ليكن م: متغير طبيعي = 0;
    طالما (م < (الطول((*البرنامج).أصول_النواة) مثل طبيعي)) {
        ليكن الأصل: &مصدر_عقد_نواة_مسير = &(*البرنامج).أصول_النواة[م];
        إذا (معرفا_رمز_متساويان((*الأصل).المنشئ, العقد.المنشئ)
            && (*الأصل).الترتيب == العقد.الترتيب
            && (*الأصل).المنتقي.القيمة == العقد.المنتقي.القيمة) {
            // Copy the authenticated signature through the borrow.
            ليكن مرجع_التوقيع: &توقيع_نداء_بدائي = &(*الأصل).التوقيع;
            ليكن التوقيع_المنسوخ: توقيع_نداء_بدائي = انسخ_مملوكا_توقيع_نداء_بدائي(مرجع_التوقيع);
            توقيع_موثق := اختياري.موجود(التوقيع_المنسوخ);
        };
        م := م + 1;
    }
    ليكن التوقيع: توقيع_نداء_بدائي;
    طابق توقيع_موثق مع
    | اختياري.موجود(الموثق) -> { التوقيع := الموثق; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    إذا (الطول(*الحجج) != 7 || الطول(التوقيع.الأدوار) != 6) { أرجع خطأ; };
    ليكن الموضع: متغير طبيعي = 1;
    طالما (الموضع <= 6) {
        ليكن مطابق: متغير طبيعي = 0;
        ليكن موضع_النطاق: متغير طبيعي = 0;
        طالما (موضع_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
            إذا ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                مطابق := مطابق + 1;
            };
            موضع_النطاق := موضع_النطاق + 1;
        }
        طابق التوقيع.الأدوار[الموضع - 1] مع
        | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
            إذا (مطابق != 1) { أرجع خطأ; };
            موضع_النطاق := 0;
            طالما (موضع_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
                إذا ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                    ليكن النطاق: متغير نطاق_ذاكرة_نداء_مسير = (*النطاقات)[موضع_النطاق];
                    طابق الاتجاه مع
                    | اتجاه_وصول_بدائي.قراءة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.قراءة(); }
                    | اتجاه_وصول_بدائي.كتابة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.كتابة(); }
                    | اتجاه_وصول_بدائي.قراءة_وكتابة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
                    طابق الحد مع
                    | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                        إذا (الفهرس == 0 || الفهرس > 6) { أرجع خطأ; };
                        النطاق.المطلوب := اختياري.موجود((*الحجج)[الفهرس]);
                    }
                    | حد_وصول_بدائي.سلسلة_صفرية -> {
                        // Bound search for NUL to the verified allocation extent.
                        النطاق.المطلوب := اختياري.موجود(النطاق.الطول);
                    }
                    | حد_وصول_بدائي.ثابت(العدد) -> {
                        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        طابق أصدر_ثابتا_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة, ثابت_مسير.صحيح_طبيعي(العدد), نوع_ط64
                        ) مع
                        | نتيجة_بناء_قيمة_مسير.مبنية(القيمة) -> { النطاق.المطلوب := اختياري.موجود(القيمة); }
                        | _ -> { أرجع خطأ; };
                    };
                    (*النطاقات)[موضع_النطاق] := النطاق;
                };
                موضع_النطاق := موضع_النطاق + 1;
            }
        }
        | دور_وسيطة_بدائي.عدد -> {
            إذا (مطابق != 0) { أرجع خطأ; };
        }
        | دور_وسيطة_بدائي.غير_مستخدم -> {
            إذا (مطابق != 0) { أرجع خطأ; };
        };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

// Raw syscall buffers may borrow an indexed fixed-width integer vector.
// Floating-point and pointer vectors are not given opaque byte semantics.
عرف حجم_عنصر_متجه_عدد_نداء_خام(
    الأنواع: &سجل_أنواع, النوع: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_29) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_29.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ص8 -> { أرجع اختياري.موجود(1); }
            | نوع_بدائي_مقنن.ط8 -> { أرجع اختياري.موجود(1); }
            | نوع_بدائي_مقنن.ص16 -> { أرجع اختياري.موجود(2); }
            | نوع_بدائي_مقنن.ط16 -> { أرجع اختياري.موجود(2); }
            | نوع_بدائي_مقنن.ص32 -> { أرجع اختياري.موجود(4); }
            | نوع_بدائي_مقنن.ط32 -> { أرجع اختياري.موجود(4); }
            | نوع_بدائي_مقنن.ص64 -> { أرجع اختياري.موجود(8); }
            | نوع_بدائي_مقنن.ط64 -> { أرجع اختياري.موجود(8); }
            | _ -> { };
        }
        | _ -> { };
    };
    أرجع اختياري.لا_شيء();
}

// Distinguish an indexed integer buffer from a scalar element. Failure to compute
// its dynamic extent must never silently turn it into a one-byte descriptor.
عرف هل_مرجع_عنصر_متجه_بايتات_نداء_خام(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    الأصل: معرف_قيمة_مسير
): منطقي {
    ليكن مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, الأصل) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المرجع)) -> { مكان_العنصر := المرجع.المكان; }
    | _ -> { أرجع خطأ; };
    ليكن مكان_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(الموضع)) -> { مكان_المتجه := الموضع.الأصل; }
    | _ -> { أرجع خطأ; };
    ليكن الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    إذا ((مكان_المتجه.القيمة مثل طبيعي) >= (الطول((*الدالة).القيم) مثل طبيعي)) {
        أرجع خطأ;
    };
    ليكن نوع_المتجه: معرف_نوع;
    طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, (*الدالة).القيم[مكان_المتجه.القيمة].النوع) مع
    | اختياري.موجود(المعرف) -> { نوع_المتجه := المعرف; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(المعرف) -> {
        طابق حجم_عنصر_متجه_عدد_نداء_خام(الأنواع, المعرف) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// A borrow of an integer-vector element carries a contiguous backing allocation.
// The accessible extent is computed from the same indexed place, not from a
// syscall number or from a guessed length argument. The interpreter must still
// check the live allocation and the range at the machine-call boundary.
عرف طول_باقي_متجه_بايتات_نداء_خام(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    الأصل: قيمة_خفض_مسير,
    نوع_ط64: معرف_نوع
): اختياري معرف_قيمة_مسير {
    ليكن مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, الأصل.المعرف) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المرجع)) -> { مكان_العنصر := المرجع.المكان; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن مكان_المتجه: معرف_قيمة_مسير;
    ليكن فهرس_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(الموضع)) -> {
        مكان_المتجه := الموضع.الأصل;
        فهرس_العنصر := الموضع.الفهرس;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    إذا ((مكان_المتجه.القيمة مثل طبيعي) >= (الطول((*الدالة).القيم) مثل طبيعي)
        || (فهرس_العنصر.القيمة مثل طبيعي) >= (الطول((*الدالة).القيم) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن نوع_المتجه: معرف_نوع;
    طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, (*الدالة).القيم[مكان_المتجه.القيمة].النوع) مع
    | اختياري.موجود(المعرف) -> { نوع_المتجه := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن عرض_العنصر: طبيعي;
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(المعرف) -> {
        طابق حجم_عنصر_متجه_عدد_نداء_خام(الأنواع, المعرف) مع
        | اختياري.موجود(العرض) -> { عرض_العنصر := العرض; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن نوع_الفهرس: معرف_نوع = (*الدالة).القيم[فهرس_العنصر.القيمة].النوع;
    ليكن وصف_الفهرس: وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, نوع_الفهرس) مع
    | اختياري.موجود(الوصف) -> {
        إذا (الوصف.البتات == 0 || الوصف.البتات > 64) { أرجع اختياري.لا_شيء(); };
        وصف_الفهرس := الوصف;
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن نوع_العدد: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن بناء: حالة_خفض_دالة = *الحالة;
    ليكن قيمة_المتجه: معرف_قيمة_مسير;
    طابق أصدر_تحميل_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        مكان_المتجه, نوع_المتجه
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_المتجه := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الحجج: متجه معرف_قيمة_مسير = [قيمة_المتجه];
    ليكن الطول_الموقع: معرف_قيمة_مسير;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        هوية_بدائي_مترجم.طول(), &الحجج,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الطول_الموقع := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن طول_المتجه: معرف_قيمة_مسير;
    طابق أصدر_تحويل_صحيح_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { طول_المتجه := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الفهرس_غير_الموقع: متغير معرف_قيمة_مسير = فهرس_العنصر;
    إذا (!معرفا_نوع_متساويان(نوع_الفهرس, نوع_ط64)) {
        ليكن عملية_الفهرس: عملية_تحويل_صحيح;
        إذا (وصف_الفهرس.البتات == 64) {
            عملية_الفهرس := عملية_تحويل_صحيح.إعادة_تفسير();
        } وإلا إذا (وصف_الفهرس.موقع) {
            عملية_الفهرس := عملية_تحويل_صحيح.توسيع_بإشارة();
        } وإلا {
            عملية_الفهرس := عملية_تحويل_صحيح.توسيع_صفري();
        };
        طابق أصدر_تحويل_صحيح_مسير(
            البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
            عملية_الفهرس, فهرس_العنصر, نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الفهرس_غير_الموقع := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    ليكن باقي_العناصر: معرف_قيمة_مسير;
    طابق أصدر_حسابا_صحيحا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_حساب_صحيح.طرح(), طول_المتجه, الفهرس_غير_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { باقي_العناصر := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا (عرض_العنصر == 1) { أرجع اختياري.موجود(باقي_العناصر); };
    ليكن حجم_العنصر: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        ثابت_مسير.صحيح_طبيعي(عرض_العنصر), نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { حجم_العنصر := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق أصدر_حسابا_صحيحا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_حساب_صحيح.ضرب(), باقي_العناصر, حجم_العنصر, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع اختياري.موجود(المعرف); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Descriptors are derived from the *source* reference, never from a raw
// machine word. A scalar gives exactly one element; an indexed integer vector
// may provide a checked runtime maximum. Neither guesses kernel direction or
// the request's actual transfer count.
عرف انشئ_نطاق_ذاكرة_حجة_خام(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    نوع_ط64: معرف_نوع,
    فهرس_الحجة: طبيعي,
    الأصل: قيمة_خفض_مسير,
    المؤشر: قيمة_خفض_مسير
): اختياري نطاق_ذاكرة_نداء_مسير {
    إذا (فهرس_الحجة == 0) { أرجع اختياري.لا_شيء(); };
    ليكن عنصر: معرف_نوع;
    ليكن متغير_الأصل: منطقي;
    طابق معرف_نوع_أساس_عند(الأنواع, الأصل.النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مرجع_النوع_30) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_30.القيمة] مع
        | نوع_مقنن.مرجع(داخل, قابل_للكتابة) -> {
            عنصر := داخل;
            متغير_الأصل := قابل_للكتابة;
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    طابق معرف_نوع_أساس_عند(الأنواع, المؤشر.النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مرجع_النوع_31) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_31.القيمة] مع
        | نوع_مقنن.مؤشر(داخل) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, داخل) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(مرجع_النوع_1) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
                | نوع_مقنن.بدائي(المؤشر_إليه) -> {
                    طابق معرف_نوع_أساس_عند(الأنواع, عنصر) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(مرجع_النوع_1) -> {
                        طابق (*الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
                        | نوع_مقنن.بدائي(المرجع_إليه) -> {
                            إذا (المؤشر_إليه != المرجع_إليه) {
                                أرجع اختياري.لا_شيء();
                            };
                        }
                        | _ -> { أرجع اختياري.لا_شيء(); };
                    };
                }
                | _ -> { أرجع اختياري.لا_شيء(); };
            };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    ليكن حجم: طبيعي;
    طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, عنصر) مع
    | اختياري.موجود(القيمة) -> { حجم := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    ليكن بناء: حالة_خفض_دالة = *الحالة;
    ليكن طول_النطاق: معرف_قيمة_مسير;
    إذا (هل_مرجع_عنصر_متجه_بايتات_نداء_خام(
        البرنامج, الحالة, الأنواع, الأصل.المعرف
    )) {
        // The byte extent is runtime length(vector) - index, with the
        // canonical checked subtraction contract (underflow traps).
        طابق طول_باقي_متجه_بايتات_نداء_خام(
            البرنامج, الحالة, الأنواع, الأصل, نوع_ط64
        ) مع
        | اختياري.موجود(المعرف) -> { طول_النطاق := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    } وإلا {
        طابق أصدر_ثابتا_مسير(
            البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
            ثابت_مسير.صحيح_طبيعي(حجم), نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { طول_النطاق := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    ليكن الإذن: إذن_ذاكرة_نداء_مسير;
    إذا (متغير_الأصل) {
        الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة();
    } وإلا {
        الإذن := إذن_ذاكرة_نداء_مسير.قراءة();
    };
    ليكن النطاق: نطاق_ذاكرة_نداء_مسير = {
        فهرس_الحجة: فهرس_الحجة,
        المؤشر: المؤشر.المعرف,
        الأصل: الأصل.المعرف,
        الطول: طول_النطاق,
        المطلوب: اختياري.لا_شيء(),
        الإذن: الإذن
    };
    أرجع اختياري.موجود(النطاق);
}

عرف خفض_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الحرفي: حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن حالة_القراءة: حالة_خفض_دالة = *الحالة;
    طابق الحرفي مع
    | حرفي.منطقي(القيمة) -> {
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.منطق(القيمة),
                النوع
            ),
            النوع
        );
    }
    | حرفي.عدد(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_ثابتا_مسير(
                        البرنامج,
                        &حالة_القراءة.البناء,
                        حالة_القراءة.الدالة,
                        حالة_القراءة.الكتلة,
                        ثابت_مسير.صحيح_موقع(القيمة),
                        النوع
                    ),
                    النوع
                );
            };
            إذا (القيمة < 0) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            أرجع قيمة_من_بناء_للخفض(
                أصدر_ثابتا_مسير(
                    البرنامج,
                    &حالة_القراءة.البناء,
                    حالة_القراءة.الدالة,
                    حالة_القراءة.الكتلة,
                    ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي),
                    النوع
                ),
                النوع
            );
        };
    }
    | حرفي.حرف(القيمة) -> {
        إذا (!هل_نوع_بدائي_للخفض(الأنواع, النوع, نوع_بدائي_مقنن.حرف())) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي),
                النوع
            ),
            النوع
        );
    }
    | حرفي.عدد_عشري(البايتات) -> {
        إذا (!هل_نوع_عشري_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(البرنامج, &حالة_القراءة.البناء, حالة_القراءة.الدالة, حالة_القراءة.الكتلة, ثابت_مسير.عشري(البايتات), النوع),
            النوع
        );
    }
    | حرفي.عدد_طبيعي(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            أرجع قيمة_من_بناء_للخفض(
                أصدر_ثابتا_مسير(
                    البرنامج,
                    &حالة_القراءة.البناء,
                    حالة_القراءة.الدالة,
                    حالة_القراءة.الكتلة,
                    ثابت_مسير.صحيح_طبيعي(القيمة),
                    النوع
                ),
                النوع
            );
        };
    }
    | حرفي.نص(البايتات) -> {
        إذا (!هل_نوع_نص_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.نص(البايتات),
                النوع
            ),
            النوع
        );
    }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عرف نوع_صحيح_موقع_بنفس_العرض_للخفض(
    الأنواع: &سجل_أنواع,
    الوصف: وصف_صحيح_خفض
): اختياري معرف_نوع {
    إذا (الوصف.البتات == 8) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص8());
    };
    إذا (الوصف.البتات == 16) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص16());
    };
    إذا (الوصف.البتات == 32) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص32());
    };
    إذا (الوصف.البتات == 64) {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص64()) مع
        | اختياري.موجود(النوع) -> {
            أرجع اختياري.موجود(النوع);
        }
        | اختياري.لا_شيء -> {
            أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد());
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف اخفض_متمم_صحيح_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن الوصف: متغير وصف_صحيح_خفض = { موقع: خطأ, البتات: 0 };
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوصف := القيمة;
    };

    ليكن كل_البتات: متغير قيمة_خفض_مسير = الداخل;
    إذا (الوصف.موقع) {
        طابق خفض_حرفي_إلى_مسير(
            البرنامج, الحالة, النطاق, حرفي.عدد(-1), النوع, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            كل_البتات := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    } وإلا {
        ليكن نوع_موقع: متغير معرف_نوع = النوع;
        طابق نوع_صحيح_موقع_بنفس_العرض_للخفض(الأنواع, الوصف) مع
        | اختياري.موجود(القيمة) -> {
            نوع_موقع := القيمة;
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        ليكن ناقص_واحد: متغير قيمة_خفض_مسير = الداخل;
        طابق خفض_حرفي_إلى_مسير(
            البرنامج, الحالة, النطاق, حرفي.عدد(-1), نوع_موقع, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            ناقص_واحد := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                عملية_تحويل_صحيح.إعادة_تفسير(),
                ناقص_واحد.المعرف,
                النوع
            ),
            النوع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            كل_البتات := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };

    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_حسابا_صحيحا_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            عملية_حساب_صحيح.أو_حصري(),
            الداخل.المعرف,
            كل_البتات.المعرف,
            النوع
        ),
        النوع
    );
}

عرف عملية_حساب_من_عامل_للخفض(
    العامل: عامل_ثنائي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري عملية_حساب_صحيح {
    طابق العامل مع
    | عامل_ثنائي.جمع -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.جمع());
    }
    | عامل_ثنائي.طرح -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.طرح());
    }
    | عامل_ثنائي.ضرب -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.ضرب());
    }
    | عامل_ثنائي.أو_بتي -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.أو_بتي());
    }
    | عامل_ثنائي.أو_حصري -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.أو_حصري());
    }
    | عامل_ثنائي.و_بتي -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.و_بتي());
    }
    | عامل_ثنائي.إزاحة_يسرى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يسرى());
    }
    | عامل_ثنائي.إزاحة_يمنى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يمنى());
    }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_حسابية_يمنى());
    }
    | عامل_ثنائي.قسمة -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(عملية_حساب_صحيح.قسمة_موقعة());
            };
            أرجع اختياري.موجود(عملية_حساب_صحيح.قسمة_طبيعية());
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | عامل_ثنائي.باقي -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(عملية_حساب_صحيح.باقي_موقع());
            };
            أرجع اختياري.موجود(عملية_حساب_صحيح.باقي_طبيعي());
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف عملية_حساب_عشري_من_عامل_للخفض(العامل: عامل_ثنائي): اختياري عملية_حساب_عشري {
    طابق العامل مع
    | عامل_ثنائي.جمع -> { أرجع اختياري.موجود(عملية_حساب_عشري.جمع()); }
    | عامل_ثنائي.طرح -> { أرجع اختياري.موجود(عملية_حساب_عشري.طرح()); }
    | عامل_ثنائي.ضرب -> { أرجع اختياري.موجود(عملية_حساب_عشري.ضرب()); }
    | عامل_ثنائي.قسمة -> { أرجع اختياري.موجود(عملية_حساب_عشري.قسمة()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_مقارنة_عشرية_من_عامل_للخفض(العامل: عامل_ثنائي): اختياري عملية_مقارنة_عشري {
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.يساوي()); }
    | عامل_ثنائي.لا_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.لا_يساوي()); }
    | عامل_ثنائي.أصغر -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أصغر()); }
    | عامل_ثنائي.أصغر_أو_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أصغر_أو_يساوي()); }
    | عامل_ثنائي.أكبر -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أكبر()); }
    | عامل_ثنائي.أكبر_أو_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أكبر_أو_يساوي()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_مقارنة_من_عامل_للخفض(
    العامل: عامل_ثنائي
): اختياري عملية_مقارنة_صحيح {
    طابق العامل مع
    | عامل_ثنائي.يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.يساوي());
    }
    | عامل_ثنائي.لا_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.لا_يساوي());
    }
    | عامل_ثنائي.أصغر -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أصغر());
    }
    | عامل_ثنائي.أصغر_أو_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أصغر_أو_يساوي());
    }
    | عامل_ثنائي.أكبر -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أكبر());
    }
    | عامل_ثنائي.أكبر_أو_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أكبر_أو_يساوي());
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف هل_نوع_موسوم_بلا_حمولات_للخفض(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    إذا (!هل_نوع_موسوم(الأنواع, النوع)) {
        أرجع خطأ;
    };
    ليكن العدد: متغير طبيعي = 0;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(القيمة) -> { العدد := القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(عدد_الحمولات) -> {
            إذا (عدد_الحمولات != 0) {
                أرجع خطأ;
            };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اخفض_مقارنة_وسمين_بلا_حمولات_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: قيمة_خفض_مسير,
    اليمين: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_موسوم_بلا_حمولات_للخفض(الأنواع, اليسار.النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن نوع_الوسم: متغير معرف_نوع = اليسار.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(المعرف) -> { نوع_الوسم := المعرف; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
    };
    ليكن العملية: متغير عملية_مقارنة_صحيح = عملية_مقارنة_صحيح.يساوي();
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { العملية := عملية_مقارنة_صحيح.يساوي(); }
    | عامل_ثنائي.لا_يساوي -> { العملية := عملية_مقارنة_صحيح.لا_يساوي(); }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن وسم_اليسار: متغير معرف_قيمة_مسير = اليسار.المعرف;
    طابق أصدر_استعلام_وسم_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        اليسار.المعرف,
        نوع_الوسم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { وسم_اليسار := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن وسم_اليمين: متغير معرف_قيمة_مسير = اليمين.المعرف;
    طابق أصدر_استعلام_وسم_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        اليمين.المعرف,
        نوع_الوسم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { وسم_اليمين := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مقارنة_صحيح_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            العملية,
            وسم_اليسار,
            وسم_اليمين,
            النوع
        ),
        النوع
    );
}

// The arithmetic, bitwise and shift operators (not a comparison).
عرف هل_عامل_ثنائي_ينتج_عددا_صحيحا_للخفض(العامل: عامل_ثنائي): منطقي {
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { أرجع خطأ; }
    | عامل_ثنائي.لا_يساوي -> { أرجع خطأ; }
    | عامل_ثنائي.أصغر -> { أرجع خطأ; }
    | عامل_ثنائي.أصغر_أو_يساوي -> { أرجع خطأ; }
    | عامل_ثنائي.أكبر -> { أرجع خطأ; }
    | عامل_ثنائي.أكبر_أو_يساوي -> { أرجع خطأ; }
    | _ -> { أرجع صواب; };
}

عرف قيمة_بناء_لمساواة_نصين(
    الناتج: نتيجة_بناء_قيمة_مسير,
    النطاق: نطاق
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
}

عرف منهي_لمساواة_نصين(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

// One text operand of `==` / `!=`, read without being moved: a place or a
// literal is read as it is; a fresh temporary (a call result) goes to a slot
// the block owns (اخفض_قيمة_إلى_مكان_مؤقت_مسير), so the block's exits
// destroy it after the comparison.
عرف اخفض_طرف_نص_للمقارنة(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الطرف: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    إذا (!هل_تعبير_طازج_للخفض(الطرف, روابط_الأسماء, دوال_الخفض)) {
        أرجع خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, الطرف, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    };
    طابق اخفض_قيمة_إلى_مكان_مؤقت_مسير(
        البرنامج, الحالة, نطاق_تعبير(الطرف), الطرف, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_مكان.مكان(المكان) -> {
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحميل_مسير(
                البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة, المكان.المعرف, المكان.النوع
            ),
            المكان.النوع
        );
    };
}

// `a == b` and `a != b` on text compare the contents byte by byte, as std's
// texts_equal (نصان_متساويان) does: different lengths differ; otherwise a
// loop over the bytes stops at the first that differs. The result is the
// merge block's parameter (النوع, bool):
//
//   entry:  len(a) == len(b) ? head(0) : merge(differ)
//   head(i): i < len(a) ? body : merge(same)
//   body:   a[i] == b[i] ? head(i + 1) : merge(differ)
//
// with same/differ true/false for `==` and false/true for `!=`.
عرف اخفض_مساواة_نصين_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: &تعبير,
    اليمين: &تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
    };
    ليكن أ: معرف_قيمة_مسير;
    طابق اخفض_طرف_نص_للمقارنة(
        البرنامج, الحالة, اليسار, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { أ := القيمة.المعرف; }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن ب: معرف_قيمة_مسير;
    طابق اخفض_طرف_نص_للمقارنة(
        البرنامج, الحالة, اليمين, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { ب := القيمة.المعرف; }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن نوع_العدد: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن نوع_البايت: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8()) مع
    | اختياري.موجود(المعرف) -> { نوع_البايت := المعرف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن هو_يساوي: منطقي = العامل == عامل_ثنائي.يساوي();

    ليكن الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن الدالة: معرف_دالة_مسير = الإصدار.الدالة;
    ليكن المدخل: معرف_كتلة_مسير = الإصدار.الكتلة;
    ليكن حجج_أ: متجه معرف_قيمة_مسير = [أ];
    ليكن طول_أ: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_نداء_بدائي_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_أ,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { طول_أ := المعرف; };
    ليكن حجج_ب: متجه معرف_قيمة_مسير = [ب];
    ليكن طول_ب: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_نداء_بدائي_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_ب,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { طول_ب := المعرف; };
    ليكن الطولان_متساويان: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, عملية_مقارنة_صحيح.يساوي(), طول_أ, طول_ب, النوع
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { الطولان_متساويان := المعرف; };
    ليكن قيمة_التطابق: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_ثابتا_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, ثابت_مسير.منطق(هو_يساوي), النوع
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { قيمة_التطابق := المعرف; };
    ليكن قيمة_الاختلاف: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_ثابتا_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, ثابت_مسير.منطق(!هو_يساوي), النوع
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { قيمة_الاختلاف := المعرف; };
    ليكن الصفر: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_ثابتا_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(0), نوع_العدد
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { الصفر := المعرف; };
    ليكن الواحد: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_ثابتا_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(1), نوع_العدد
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { الواحد := المعرف; };

    ليكن الرأس: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(الكتلة) -> { الرأس := الكتلة; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الجسم: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(الكتلة) -> { الجسم := الكتلة; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الدمج: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع
    | نتيجة.نجح(الكتلة) -> { الدمج := الكتلة; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الفهرس: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الرأس, نوع_العدد), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { الفهرس := المعرف; };
    ليكن الناتج: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الدمج, النوع), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { الناتج := المعرف; };

    // entry: equal lengths enter the loop at 0; others differ.
    ليكن حجج_البدء: متجه معرف_قيمة_مسير = [الصفر];
    ليكن حجج_الاختلاف: متجه معرف_قيمة_مسير = [قيمة_الاختلاف];
    ليكن إلى_الرأس: حافة_مسير = { الهدف: الرأس, الحجج: حجج_البدء };
    ليكن إلى_الاختلاف: حافة_مسير = { الهدف: الدمج, الحجج: حجج_الاختلاف };
    طابق منهي_لمساواة_نصين(اختم_بفرع_شرطي_مسير(
        البرنامج, &الإصدار.البناء, الدالة, المدخل, الطولان_متساويان, إلى_الرأس, إلى_الاختلاف
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    // head(i): every byte compared means the texts are equal.
    ليكن بقي: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الرأس, عملية_مقارنة_صحيح.أصغر(), الفهرس, طول_أ, النوع
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { بقي := المعرف; };
    ليكن بلا_حجج: متجه معرف_قيمة_مسير = [];
    ليكن حجج_التطابق: متجه معرف_قيمة_مسير = [قيمة_التطابق];
    ليكن إلى_الجسم: حافة_مسير = { الهدف: الجسم, الحجج: بلا_حجج };
    ليكن إلى_التطابق: حافة_مسير = { الهدف: الدمج, الحجج: حجج_التطابق };
    طابق منهي_لمساواة_نصين(اختم_بفرع_شرطي_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الرأس, بقي, إلى_الجسم, إلى_التطابق
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    // body: the first differing byte ends the loop.
    ليكن بايت_أ: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_استخراج_فهرس_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الجسم, أ, الفهرس, نوع_البايت
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { بايت_أ := المعرف; };
    ليكن بايت_ب: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_استخراج_فهرس_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الجسم, ب, الفهرس, نوع_البايت
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { بايت_ب := المعرف; };
    ليكن البايتان_متساويان: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الجسم, عملية_مقارنة_صحيح.يساوي(), بايت_أ, بايت_ب, النوع
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { البايتان_متساويان := المعرف; };
    ليكن التالي: معرف_قيمة_مسير;
    طابق قيمة_بناء_لمساواة_نصين(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الجسم, عملية_حساب_صحيح.جمع(), الفهرس, الواحد, نوع_العدد
    ), النطاق) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | نتيجة.نجح(المعرف) -> { التالي := المعرف; };
    ليكن حجج_التكرار: متجه معرف_قيمة_مسير = [التالي];
    ليكن حجج_اختلاف_البايت: متجه معرف_قيمة_مسير = [قيمة_الاختلاف];
    ليكن إلى_التكرار: حافة_مسير = { الهدف: الرأس, الحجج: حجج_التكرار };
    ليكن إلى_اختلاف_البايت: حافة_مسير = { الهدف: الدمج, الحجج: حجج_اختلاف_البايت };
    طابق منهي_لمساواة_نصين(اختم_بفرع_شرطي_مسير(
        البرنامج, &الإصدار.البناء, الدالة, الجسم, البايتان_متساويان, إلى_التكرار, إلى_اختلاف_البايت
    )) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    (*الحالة).الكتلة := الدمج;
    (*الحالة).نشطة := صواب;
    ليكن القيمة: قيمة_خفض_مسير = { المعرف: الناتج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
}

عرف اخفض_منطق_قصير_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: &تعبير,
    اليمين: &تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    };

    ليكن نتيجة_اليسار: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج,
        الحالة,
        اليسار,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    );
    ليكن دالة_فارغة_للمنطق: معرف_دالة_مسير = معرف_دالة_مسير_من(0);
    ليكن قيمة_فارغة_للمنطق: معرف_قيمة_مسير = معرف_قيمة_مسير_من(دالة_فارغة_للمنطق, 0);
    ليكن قيمة_اليسار: متغير قيمة_خفض_مسير = {
        المعرف: قيمة_فارغة_للمنطق,
        النوع: النوع
    };
    طابق نتيجة_اليسار مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_اليسار := القيمة;
    };
    أرجع أكمل_منطق_قصير_بيسار_إلى_مسير(
        البرنامج, الحالة, النطاق, العامل, اليمين, النوع, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات, قيمة_اليسار
    );
}

// The rest of a `&&` / `||` once its left operand is lowered (قيمة_اليسار):
// the short-circuit branch, the right operand and the join. A chain lowers
// each enclosing node through it with the value of the nodes inside
// (خفض_تعبير_ثنائي_إلى_مسير).
عرف أكمل_منطق_قصير_بيسار_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليمين: &تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    قيمة_اليسار: قيمة_خفض_مسير
): نتيجة_خفض_تعبير {
    إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_اليسار.النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_اليسار.النوع)
        );
    };

    ليكن القيمة_القصيرة: متغير منطقي = خطأ;
    طابق العامل مع
    | عامل_ثنائي.و -> {
        القيمة_القصيرة := خطأ;
    }
    | عامل_ثنائي.أو -> {
        القيمة_القصيرة := صواب;
    }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    ليكن نتيجة_الثابت: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(القيمة_القصيرة),
        النوع,
        الأنواع
    );
    ليكن قيمة_الثابت: متغير معرف_قيمة_مسير = قيمة_اليسار.المعرف;
    طابق نتيجة_الثابت مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_الثابت := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    طابق ابدأ_منطق_قصير_مسير(
        البرنامج,
        الحالة,
        النطاق,
        العامل,
        قيمة_اليسار,
        قيمة_الثابت,
        النوع
    ) مع
    | نتيجة_بدء_منطق_قصير_خفض.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_بدء_منطق_قصير_خفض.مبنية(السياق) -> {
        ليكن مرجع_أصل_اليمين: &حالة_خفض_دالة = &السياق.حالة_اليمين;
        ليكن أصل_اليمين: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(مرجع_أصل_اليمين);
        ليكن حالة_اليمين: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_اليمين);
        ليكن نتيجة_اليمين: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
            البرنامج,
            &متغير حالة_اليمين,
            اليمين,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
        ليكن قيمة_اليمين: متغير قيمة_خفض_مسير = قيمة_اليسار;
        طابق نتيجة_اليمين مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            قيمة_اليمين := القيمة;
        };
        إذا (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_اليمين.النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_اليمين.النوع)
            );
        };
        أرجع اختم_منطق_قصير_مسير(
            البرنامج,
            الحالة,
            &حالة_اليمين,
            السياق.كتلة_الدمج,
            السياق.معامل_الدمج,
            قيمة_اليمين,
            النوع
        );
    };
}

عرف اخفض_نفي_منطقي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    إذا ((!هل_نوع_منطقي_للخفض(الأنواع, الداخل.النوع))
        || (!هل_نوع_منطقي_للخفض(الأنواع, النوع))) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    };
    ليكن حالة_الفرع: حالة_خفض_دالة = *الحالة;
    ليكن نتيجة_صواب: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(صواب),
        النوع,
        الأنواع
    );
    ليكن قيمة_صواب: متغير معرف_قيمة_مسير = الداخل.المعرف;
    طابق نتيجة_صواب مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_صواب := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن نتيجة_خطأ: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(خطأ),
        النوع,
        الأنواع
    );
    ليكن قيمة_خطأ: متغير معرف_قيمة_مسير = الداخل.المعرف;
    طابق نتيجة_خطأ مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_خطأ := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    أرجع اخفض_نفي_منطقي_مقنن(
        البرنامج,
        الحالة,
        النطاق,
        الداخل,
        قيمة_صواب,
        قيمة_خطأ,
        النوع
    );
}

عرف هل_نوع_مؤشر_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Whether الاسم names a module value lowered by substitution
// (هدف_قيمة_عليا_خفض.ثابت: an immutable scalar or text global, whose every
// read is a fresh copy of its constant). It has no storage, so used as a
// place (`&name`, or a projection of it) it is a temporary like any other
// value without storage (اخفض_قيمة_إلى_مكان_مؤقت_مسير). A local of the same
// name shadows it; it is never written (the frontend rejects a write to or a
// mutable borrow of an immutable value).
عرف هل_اسم_ثابت_وحدة_للخفض(
    الحالة: &حالة_خفض_دالة,
    الاسم: &اسم,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق رمز_اسم_محلول_عند(روابط_الأسماء, (*الاسم).النطاق) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الرمز) -> {
        طابق موضع_محلي_خفض(الحالة, الرمز) مع
        | اختياري.موجود(_) -> { أرجع خطأ; }
        | اختياري.لا_شيء -> { };
        طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
        | اختياري.موجود(الربط) -> {
            طابق الربط.الهدف مع
            | هدف_قيمة_عليا_خفض.ثابت(_) -> { أرجع صواب; }
            // Built where it is read, so it has a temporary place.
            | هدف_قيمة_عليا_خفض.موسوم(_) -> { أرجع صواب; }
            | هدف_قيمة_عليا_خفض.عام(_) -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

// The place of a place expression. The place of a member, an element or a
// dereference is recorded as a source use of its root (a write into it reads
// the root; msir/ssf/ownership_legality.sn).
عام عرف خفض_مكان_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_مكان {
    ليكن الناتج: نتيجة_خفض_مكان = خفض_مكان_دون_مصدر_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    ليكن إسقاط: متغير منطقي = خطأ;
    طابق *التعبير مع
    | تعبير.حقل(_, _, _) -> { إسقاط := صواب; }
    | تعبير.فهرس(_, _, _) -> { إسقاط := صواب; }
    | تعبير.فك_موضع(_, _) -> { إسقاط := صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { إسقاط := صواب; }
    | _ -> { };
    إذا (إسقاط) {
        طابق الناتج مع
        | نتيجة_خفض_مكان.مكان(المكان) -> {
            سجل_قراءة_تعبير_مصدرية_خفض(البرنامج, الحالة, التعبير, المكان.المعرف, روابط_الأسماء);
        }
        | _ -> { };
    };
    أرجع الناتج;
}

عرف خفض_مكان_دون_مصدر_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_مكان {
    ليكن النوع_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, التعبير);
    ليكن النوع: متغير معرف_نوع = معرف_نوع_من(0);
    طابق النوع_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
        النوع := المعرف;
    }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
    };
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(النطاق, الاسم) -> {
        إذا (هل_اسم_ثابت_وحدة_للخفض(الحالة, &الاسم, روابط_الأسماء, دوال_الخفض)) {
            أرجع اخفض_قيمة_إلى_مكان_مؤقت_مسير(
                البرنامج, الحالة, النطاق, التعبير, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        };
        أرجع اخفض_مكان_اسم_مقنن(البرنامج, الحالة, النطاق, &الاسم, روابط_الأسماء, دوال_الخفض);
    }
    | تعبير.فهرس(النطاق, صندوق_الأصل, صندوق_الفهرس) -> {
        ليكن الأصل: تعبير = *صندوق_الأصل;
        ليكن الفهرس: تعبير = *صندوق_الفهرس;
        ليكن نوع_الأصل_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الأصل);
        ليكن نوع_الأصل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_الأصل_نتيجة مع
        | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> { نوع_الأصل := المعرف; }
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); };

        إذا (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الأصل)) {
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_المؤشر) -> {
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                    أرجع اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
                        البرنامج, الحالة, النطاق, قيمة_المؤشر, قيمة_الفهرس, النوع, الأنواع
                    );
                };
            };
        };

        طابق خفض_مكان_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_مكان.مكان(مكان_الأصل) -> {
            // An element of a tuple is a member of it: its constant position
            // names the member place (as a read of it extracts that member).
            طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأصل) مع
            | اختياري.موجود(عدد_العناصر) -> {
                ليكن الموضع: متغير طبيعي = 0;
                طابق الفهرس مع
                | تعبير.حرفي(_, حرفي.عدد(القيمة)) -> {
                    إذا (القيمة < 0) {
                        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                    الموضع := القيمة مثل طبيعي;
                }
                | تعبير.حرفي(_, حرفي.عدد_طبيعي(القيمة)) -> { الموضع := القيمة; }
                | _ -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                };
                إذا (الموضع >= عدد_العناصر) {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                };
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق أصدر_مكان_حقل_مسير(
                    البرنامج,
                    &حالة_الإصدار.البناء,
                    حالة_الإصدار.الدالة,
                    حالة_الإصدار.الكتلة,
                    مكان_الأصل.المعرف,
                    الموضع,
                    النوع
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    ليكن المكان: مكان_خفض_مسير = { المعرف: المعرف, النوع: النوع };
                    أرجع نتيجة_خفض_مكان.مكان(المكان);
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                };
            }
            | اختياري.لا_شيء -> { };
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                أرجع اخفض_مكان_فهرس_مقنن(
                    البرنامج, الحالة, النطاق, مكان_الأصل, قيمة_الفهرس, النوع, الأنواع
                );
            };
        };
    }
    | تعبير.حقل(النطاق, صندوق_الأصل, اسم_الحقل) -> {
        ليكن الأصل: تعبير = *صندوق_الأصل;
        طابق خفض_مكان_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_مكان.مكان(مكان_الأصل) -> {
            أرجع اخفض_مكان_حقل_مقنن(
                البرنامج, الحالة, النطاق, مكان_الأصل, &اسم_الحقل, النوع,
                الأنواع, روابط_الأسماء
            );
        };
    }
    | تعبير.فك_موضع(النطاق, صندوق_المرجع) -> {
        ليكن المرجع: تعبير = *صندوق_المرجع;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &المرجع, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المرجع) -> {
            أرجع اخفض_مكان_فك_مرجع_مقنن(
                البرنامج, الحالة, النطاق, قيمة_المرجع, النوع, الأنواع
            );
        };
    }
    | تعبير.أحادي(النطاق, عامل_أحادي.فك, صندوق_المرجع) -> {
        ليكن المرجع: تعبير = *صندوق_المرجع;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &المرجع, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المرجع) -> {
            أرجع اخفض_مكان_فك_مرجع_مقنن(
                البرنامج, الحالة, النطاق, قيمة_المرجع, النوع, الأنواع
            );
        };
    }
    | _ -> {
        // A value with no storage of its own (a call result, a literal) as
        // the base of a place, as in `&f()[i]` or `f().field` passed by
        // reference: its value goes to a block-owned temporary slot, which
        // the index or field then projects, as `&e` of a temporary does.
        إذا (!هل_تعبير_موضع_دلالي(التعبير)) {
            أرجع اخفض_قيمة_إلى_مكان_مؤقت_مسير(
                البرنامج, الحالة, نطاق_تعبير(التعبير), التعبير, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        };
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
        );
    };
}

// Whether التعبير names storage that already has a place: a dereference,
// a raw pointer element, a local that already lives in storage (an owner, or
// a local whose address was taken), or a global, reached through record
// field and vector element projections. A read of a projection of such an
// expression loads the member from its place, through a field or element
// place projection; loading the
// whole root and then extracting the member would copy the whole aggregate
// (in every backend and in the interpreter) to read one member. A local read
// only whole so far (ربط_محلي_خفض.مخزن false) is not a root: its whole load
// is what promotion turns back into its stored value, and extracting from
// the value copies nothing.
عرف جذر_مكان_قراءة_للخفض(
    الحالة: &حالة_خفض_دالة,
    الأصل: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *الأصل مع
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
            طابق موضع_محلي_خفض(الحالة, الرمز) مع
            | اختياري.موجود(الموضع) -> { أرجع (*الحالة).المحليات[الموضع].مخزن; }
            | اختياري.لا_شيء -> { };
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.عام(_) -> { أرجع صواب; }
                | _ -> { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        };
    }
    | تعبير.حقل(_, صندوق_الداخل, اسم_الحقل) -> {
        // A member that names a function (a module-qualified function) is
        // not storage.
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق دالة_خفض_عند(دوال_الخفض, رمز_العضو) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع جذر_مكان_قراءة_للخفض(
            الحالة, &(*صندوق_الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        );
    }
    | تعبير.فهرس(_, صندوق_الداخل, _) -> {
        طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &(*صندوق_الداخل)) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(_) -> { أرجع خطأ; }
        | نتيجة_حل_نوع_للخفض.موجود(نوع_الداخل) -> {
            إذا (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الداخل)) { أرجع صواب; };
            إذا (!هل_نوع_متجه_للخفض(الأنواع, نوع_الداخل)) { أرجع خطأ; };
            أرجع جذر_مكان_قراءة_للخفض(
                الحالة, &(*صندوق_الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
            );
        };
    }
    | _ -> { أرجع خطأ; };
}

// A projection read lowered through its place. Whether the read moves the
// root owner's value out is decided on MSIR (drop_elaboration.sn).
عرف خفض_قراءة_إسقاط_مكان_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
}

// The local whose storage a place expression lies in, through fields,
// elements and box dereferences (a reference dereference leaves the local's
// own storage, and so ends the walk at a local that owns nothing there).
عرف رمز_جذر_مالك_للخفض(التعبير: &تعبير, روابط_الأسماء: &سياق_روابط_أسماء): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق); }
    | تعبير.حقل(_, صندوق_الأصل, _) -> { أرجع رمز_جذر_مالك_للخفض(&(*صندوق_الأصل), روابط_الأسماء); }
    | تعبير.فهرس(_, صندوق_الأصل, _) -> { أرجع رمز_جذر_مالك_للخفض(&(*صندوق_الأصل), روابط_الأسماء); }
    | تعبير.فك_موضع(_, صندوق_الداخل) -> { أرجع رمز_جذر_مالك_للخفض(&(*صندوق_الداخل), روابط_الأسماء); }
    | تعبير.أحادي(_, عامل_أحادي.فك, صندوق_الداخل) -> { أرجع رمز_جذر_مالك_للخفض(&(*صندوق_الداخل), روابط_الأسماء); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف خفض_مكان_ثم_تحميل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    طابق خفض_مكان_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_مكان.مكان(المكان) -> {
        أرجع اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان);
    };
}

// A module-level value an enum constructor builds from constants
// (model.sn, ثابت_موسوم_خفض), read in a function: its payload constants,
// each nested constructor value built first, then the tagged construction,
// the instructions the constructor call itself lowers to.
عرف اخفض_ثابتا_موسوما_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    الثابت: &ثابت_موسوم_خفض
): نتيجة_خفض_تعبير {
    ليكن قيم_الحمولات: متغير متجه معرف_قيمة_مسير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الثابت).الحمولات) مثل طبيعي)) {
        ليكن نتيجة_الحمولة: متغير نتيجة_خفض_تعبير = نتيجة_خفض_تعبير.بلا_قيمة();
        طابق (*الثابت).الحمولات[ف] مع
        | حمولة_ثابت_موسوم_خفض.ثابت(القيمة, النوع) -> {
            ليكن حالة_الثابت: حالة_خفض_دالة = *الحالة;
            نتيجة_الحمولة := قيمة_من_بناء_للخفض(
                أصدر_ثابتا_مسير(
                    البرنامج,
                    &حالة_الثابت.البناء,
                    حالة_الثابت.الدالة,
                    حالة_الثابت.الكتلة,
                    انسخ_ثابت_مسير(&القيمة),
                    النوع
                ),
                النوع
            );
        }
        | حمولة_ثابت_موسوم_خفض.موسوم(الداخل) -> {
            نتيجة_الحمولة := اخفض_ثابتا_موسوما_إلى_مسير(البرنامج, الحالة, &(*الداخل));
        };
        طابق نتيجة_الحمولة مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> { ألحق(قيم_الحمولات, القيمة.المعرف); }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(نطاق_فارغ(), (*الثابت).النوع));
        };
        ف := ف + 1;
    }
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_بناء_موسوم_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            (*الثابت).الترتيب,
            &قيم_الحمولات,
            (*الثابت).النوع
        ),
        (*الثابت).النوع
    );
}

عرف اخفض_استدعاء_منشئ_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    اسم_المنشئ: &اسم,
    الحجج: &متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن قيمة_اسم_المنشئ: اسم = *اسم_المنشئ;
    ليكن الهوية: متغير هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
    طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(القيمة) -> {
        الهوية := القيمة;
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.هوية_منشئ_مفقودة(قيمة_اسم_المنشئ.النطاق)
        );
    };

    ليكن الوصف: متغير وصف_منشئ_نوع_دلالي = {
        الترتيب: 0,
        عدد_الحمولات: 0
    };
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوصف := القيمة;
    };

    ليكن قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
    ليكن قيم: متجه تعبير = *الحجج;
    إذا ((الطول(قيم) مثل طبيعي) != الوصف.عدد_الحمولات) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
        );
    };

    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الوصف.عدد_الحمولات) {
        ليكن المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(القيمة) -> {
            المتوقع := القيمة;
        };
        ليكن مرجع_الحجة: &تعبير = &قيم[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_الحجة,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_الحجة))
            );
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, نطاق_تعبير(مرجع_الحجة), القيمة, المتوقع, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(قيم_الحجج, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_الحجة))
                );
            };
        };
        ف := ف + 1;
    }

    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_بناء_موسوم_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            الوصف.الترتيب,
            &قيم_الحجج,
            النوع
        ),
        النوع
    );
}

عام عرف اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    النوع_الهدف: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن صالح: متغير منطقي = خطأ;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المصدر.النوع) مع
    | اختياري.موجود(وصف_المصدر) -> {
        طابق وصف_المصدر.الصنف مع
        | صنف_شكل_نوع_دلالي.مرجع -> {
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع_الهدف) مع
            | اختياري.موجود(وصف_الهدف) -> {
                طابق وصف_الهدف.الصنف مع
                | صنف_شكل_نوع_دلالي.مؤشر -> {
                    طابق صنف_تحويل_بين(الأنواع, المصدر.النوع, النوع_الهدف) مع
                    | صنف_تحويل_نوع.ضمني_آمن -> { صالح := صواب; }
                    | _ -> { };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        // `*mutable T` where `*T` is expected: the same address word.
        | صنف_شكل_نوع_دلالي.مؤشر -> {
            طابق صنف_تحويل_بين(الأنواع, المصدر.النوع, النوع_الهدف) مع
            | صنف_تحويل_نوع.ضمني_آمن -> { صالح := صواب; }
            | _ -> { };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    إذا (!صالح) {
        // The ownership analysis reads the operand as it is.
        إذا ((*الحالة).للتحليل) {
            ليكن كما_هي: قيمة_خفض_مسير = { المعرف: المصدر.المعرف, النوع: النوع_الهدف };
            أرجع نتيجة_خفض_تعبير.قيمة(كما_هي);
        };
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
        );
    };
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مرجع_إلى_مؤشر_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المصدر.المعرف,
            النوع_الهدف
        ), النوع_الهدف
    );
}

// The mirror of اخفض_تحويل_مرجع_إلى_مؤشر_مسير: the pointer's word read as a
// reference to the same address, by the same reinterpretation (مرجع_إلى_مؤشر).
// The reference owns nothing (no drop) and is not a borrow of any local the
// flow facts track: the unsafe block vouches for the address and its aliasing.
عرف اخفض_تحويل_مؤشر_إلى_مرجع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المصدر: قيمة_خفض_مسير,
    النوع_الهدف: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مرجع_إلى_مؤشر_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المصدر.المعرف,
            النوع_الهدف
        ), النوع_الهدف
    );
}

عرف عملية_تحويل_صحيح_من_وصف_للخفض(
    الوصف: وصف_تحويل_صحيح_دلالي
): عملية_تحويل_صحيح {
    طابق الوصف.تغيير_العرض مع
    | تغيير_عرض_صحيح_دلالي.حفظ -> {
        أرجع عملية_تحويل_صحيح.إعادة_تفسير();
    }
    | تغيير_عرض_صحيح_دلالي.توسيع_صفري -> {
        أرجع عملية_تحويل_صحيح.توسيع_صفري();
    }
    | تغيير_عرض_صحيح_دلالي.توسيع_بإشارة -> {
        أرجع عملية_تحويل_صحيح.توسيع_بإشارة();
    }
    | تغيير_عرض_صحيح_دلالي.اقتطاع -> {
        أرجع عملية_تحويل_صحيح.اقتطاع();
    };
}

// ---- Vector pop and truncate --------------------------------------------
// `أزل_الأخير(v)` / `pop` and `اقتطع(v, n)` / `truncate` (docs/en/reference/ownership.md,
// "Pop and truncate") are
// lowered here into ordinary MSIR on the vector's place:
//   pop       empty: none. Otherwise the last element is read out (moved:
//             the vector stops owning it) and returned as some.
//   truncate  n at or past the length: nothing. Otherwise the elements from
//             n on are dropped (their drop glue), in order.
// The new length is stored with the ضبط_طول_متجه primitive, which every
// backend writes into the header. The buffer and its capacity stay: a vector left empty still holds its buffer, which the next
// append reuses and drop glue releases (it releases a buffer whose capacity
// is above zero).

// An edge that passes no block arguments.
عرف حافة_بلا_حجج_خفض(الهدف: معرف_كتلة_مسير): حافة_مسير {
    ليكن بلا_حجج: متجه معرف_قيمة_مسير = [];
    ليكن الحافة: حافة_مسير = { الهدف: الهدف, الحجج: بلا_حجج };
    أرجع الحافة;
}

// A value result of a builder call in pop/truncate lowering.
عرف قيمة_إزالة_خفض(الناتج: نتيجة_بناء_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ())); };
}

عرف بلا_قيمة_إزالة_خفض(الناتج: نتيجة_بناء_قيمة_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف منهي_إزالة_خفض(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

// The vector at the place gets length الطول (below its length; zero empties
// it and keeps its buffer).
عرف اضبط_طول_متجه_مكان_خفض(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    المكان: معرف_قيمة_مسير,
    القيمة: معرف_قيمة_مسير,
    الطول: معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    ليكن الحجج: متجه معرف_قيمة_مسير = [القيمة, الطول];
    أرجع بلا_قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
        البرنامج, البناء, الدالة, الكتلة, هوية_بدائي_مترجم.ضبط_طول_متجه(), &الحجج,
        اختياري.لا_شيء(), اختياري.موجود(المكان)
    ));
}

عام عرف اخفض_إزالة_أو_اقتطاع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الهوية: هوية_بدائي_مترجم,
    الحجج: &متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن اقتطاع: منطقي = هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.اقتطاع_متجه());
    ليكن العدد_المتوقع: متغير طبيعي = 1;
    إذا (اقتطاع) { العدد_المتوقع := 2; };
    إذا ((الطول(*الحجج) مثل طبيعي) != العدد_المتوقع) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };
    ليكن المكان: مكان_خفض_مسير;
    طابق خفض_مكان_إلى_مسير(
        البرنامج, الحالة, &(*الحجج)[0], الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_مكان.مكان(القيمة) -> { المكان := القيمة; };
    ليكن نوع_المتجه: معرف_نوع = المكان.النوع;
    ليكن نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(العنصر) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, العنصر) مع
        | اختياري.موجود(التمثيل) -> { نوع_العنصر := التمثيل; }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_المتجه)); };
    ليكن نوع_العدد: معرف_نوع;
    ليكن نوع_ط64: معرف_نوع;
    ليكن نوع_المنطق: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    // Truncate's length, evaluated after the place (left to right), as a u64.
    ليكن الحد: متغير معرف_قيمة_مسير = المكان.المعرف;
    إذا (اقتطاع) {
        ليكن قيمة_الحد: قيمة_خفض_مسير;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &(*الحجج)[1], الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الحد := القيمة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        ليكن وصف_الحد: وصف_صحيح_خفض;
        طابق وصف_صحيح_للخفض(الأنواع, قيمة_الحد.النوع) مع
        | اختياري.موجود(الوصف) -> { وصف_الحد := الوصف; }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الحد.النوع)); };
        الحد := قيمة_الحد.المعرف;
        إذا (!معرفا_نوع_متساويان(قيمة_الحد.النوع, نوع_ط64)) {
            ليكن العملية: متغير عملية_تحويل_صحيح = عملية_تحويل_صحيح.إعادة_تفسير();
            إذا (وصف_الحد.البتات < 64) {
                إذا (وصف_الحد.موقع) { العملية := عملية_تحويل_صحيح.توسيع_بإشارة(); }
                وإلا { العملية := عملية_تحويل_صحيح.توسيع_صفري(); };
            };
            طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
                البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, العملية, قيمة_الحد.المعرف, نوع_ط64
            )) مع
            | نتيجة.نجح(ق) -> { الحد := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        };
    };

    ليكن الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    ليكن المدخل: معرف_كتلة_مسير = (*الحالة).الكتلة;
    ليكن المتجه: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_تحميل_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, المكان.المعرف, نوع_المتجه)) مع
    | نتيجة.نجح(ق) -> { المتجه := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن حجج_الطول: متجه معرف_قيمة_مسير = [المتجه];
    ليكن الطول_الحالي: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    )) مع
    | نتيجة.نجح(ق) -> { الطول_الحالي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الصفر: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_ثابتا_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(0), نوع_العدد)) مع
    | نتيجة.نجح(ق) -> { الصفر := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الواحد: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_ثابتا_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(1), نوع_العدد)) مع
    | نتيجة.نجح(ق) -> { الواحد := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };

    ليكن العمل: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { العمل := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن التخطي: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { التخطي := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن التقصير: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { التقصير := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الاتصال: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الاتصال := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };

    // The new length: pop's length - 1, or truncate's n.
    ليكن لا_حجج: متجه معرف_قيمة_مسير = [];
    ليكن الطول_الجديد: متغير معرف_قيمة_مسير = الصفر;
    ليكن العنصر_المزال: متغير معرف_قيمة_مسير = الصفر;
    ليكن حالة_البناء: حالة_بناء_مسير = (*الحالة).البناء;
    إذا (اقتطاع) {
        // n < length, compared as u64 (length is never negative).
        ليكن الطول64: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الحالي, نوع_ط64
        )) مع
        | نتيجة.نجح(ق) -> { الطول64 := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        ليكن يقصر: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_مقارنة_صحيح.أصغر(), الحد, الطول64, نوع_المنطق
        )) مع
        | نتيجة.نجح(ق) -> { يقصر := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        ليكن إلى_العمل: حافة_مسير = حافة_بلا_حجج_خفض(العمل);
        ليكن إلى_التخطي: حافة_مسير = حافة_بلا_حجج_خفض(التخطي);
        طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, يقصر, إلى_العمل, إلى_التخطي)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        ليكن البداية: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, العمل, عملية_تحويل_صحيح.إعادة_تفسير(), الحد, نوع_العدد
        )) مع
        | نتيجة.نجح(ق) -> { البداية := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        الطول_الجديد := البداية;
        // Drop the elements from n on, in order (owning elements only).
        ليكن بعد_الإسقاط: متغير معرف_كتلة_مسير = العمل;
        إذا (هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_العنصر)) {
            ليكن الرأس: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الرأس := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن الجسم: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الجسم := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن المخرج: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { المخرج := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن الفهرس: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الرأس, نوع_العدد)) مع
            | نتيجة.نجح(ق) -> { الفهرس := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن حجج_البدء: متجه معرف_قيمة_مسير = [البداية];
            طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, العمل, الرأس, &حجج_البدء)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            ليكن الشرط: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
                البرنامج, &حالة_البناء, الدالة, الرأس, عملية_مقارنة_صحيح.أصغر(), الفهرس, الطول_الحالي, نوع_المنطق
            )) مع
            | نتيجة.نجح(ق) -> { الشرط := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن إلى_الجسم: حافة_مسير = حافة_بلا_حجج_خفض(الجسم);
            ليكن إلى_المخرج: حافة_مسير = حافة_بلا_حجج_خفض(المخرج);
            طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, &(*الحالة).البناء, الدالة, الرأس, الشرط, إلى_الجسم, إلى_المخرج)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            ليكن العنصر: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_استخراج_فهرس_مسير(البرنامج, &حالة_البناء, الدالة, الجسم, المتجه, الفهرس, نوع_العنصر)) مع
            | نتيجة.نجح(ق) -> { العنصر := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن حجج_الإسقاط: متجه معرف_قيمة_مسير = [العنصر];
            طابق بلا_قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
                البرنامج, &حالة_البناء, الدالة, الجسم, هوية_بدائي_مترجم.تحرير(), &حجج_الإسقاط,
                اختياري.لا_شيء(), اختياري.لا_شيء()
            )) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            ليكن التالي: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_حسابا_صحيحا_مسير(
                البرنامج, &حالة_البناء, الدالة, الجسم, عملية_حساب_صحيح.جمع(), الفهرس, الواحد, نوع_العدد
            )) مع
            | نتيجة.نجح(ق) -> { التالي := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            ليكن حجج_التكرار: متجه معرف_قيمة_مسير = [التالي];
            طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, الجسم, الرأس, &حجج_التكرار)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            بعد_الإسقاط := المخرج;
        };
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, بعد_الإسقاط, التقصير, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
    } وإلا {
        // Pop: an empty vector gives none.
        ليكن فارغ: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_مقارنة_صحيح.يساوي(), الطول_الحالي, الصفر, نوع_المنطق
        )) مع
        | نتيجة.نجح(ق) -> { فارغ := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        ليكن إلى_التخطي: حافة_مسير = حافة_بلا_حجج_خفض(التخطي);
        ليكن إلى_العمل: حافة_مسير = حافة_بلا_حجج_خفض(العمل);
        طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, فارغ, إلى_التخطي, إلى_العمل)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        ليكن الأخير: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_البناء, الدالة, العمل, عملية_حساب_صحيح.طرح(), الطول_الحالي, الواحد, نوع_العدد
        )) مع
        | نتيجة.نجح(ق) -> { الأخير := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        الطول_الجديد := الأخير;
        // The element is moved out: the vector stops owning it below.
        طابق قيمة_إزالة_خفض(أصدر_استخراج_فهرس_مسير(البرنامج, &حالة_البناء, الدالة, العمل, المتجه, الأخير, نوع_العنصر)) مع
        | نتيجة.نجح(ق) -> { العنصر_المزال := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, العمل, التقصير, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
    };
    طابق اضبط_طول_متجه_مكان_خفض(البرنامج, &حالة_البناء, الدالة, التقصير, المكان.المعرف, المتجه, الطول_الجديد) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, التقصير, الاتصال, &لا_حجج)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    إذا (اقتطاع) {
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, التخطي, الاتصال, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        (*الحالة).الكتلة := الاتصال;
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    };

    // Pop's result: some(element) after the vector shrank, none when empty.
    ليكن موجود: وصف_منشئ_نوع_دلالي;
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, هوية_منشئ_نوع.اختيار_بعض()) مع
    | اختياري.موجود(الوصف) -> { موجود := الوصف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
    ليكن لا_شيء: وصف_منشئ_نوع_دلالي;
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, هوية_منشئ_نوع.اختيار_لا_شيء()) مع
    | اختياري.موجود(الوصف) -> { لا_شيء := الوصف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
    ليكن الدمج: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الدمج := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن الناتج: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الدمج, النوع)) مع
    | نتيجة.نجح(ق) -> { الناتج := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن بلا_حمولات: متجه معرف_قيمة_مسير = [];
    ليكن القيمة_الفارغة: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_بناء_موسوم_مسير(البرنامج, &حالة_البناء, الدالة, التخطي, لا_شيء.الترتيب, &بلا_حمولات, النوع)) مع
    | نتيجة.نجح(ق) -> { القيمة_الفارغة := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن حجج_الفارغة: متجه معرف_قيمة_مسير = [القيمة_الفارغة];
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, التخطي, الدمج, &حجج_الفارغة)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    ليكن الحمولات: متجه معرف_قيمة_مسير = [العنصر_المزال];
    ليكن القيمة_الموجودة: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_بناء_موسوم_مسير(البرنامج, &حالة_البناء, الدالة, الاتصال, موجود.الترتيب, &الحمولات, النوع)) مع
    | نتيجة.نجح(ق) -> { القيمة_الموجودة := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    ليكن حجج_الموجودة: متجه معرف_قيمة_مسير = [القيمة_الموجودة];
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, &(*الحالة).البناء, الدالة, الاتصال, الدمج, &حجج_الموجودة)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    (*الحالة).الكتلة := الدمج;
    ليكن النتيجة: قيمة_خفض_مسير = { المعرف: الناتج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(النتيجة);
}

// بدائي_عنوان_دالة_سي(f): the machine address of f, a function defined with
// the C calling convention (@@c_abi), as the function constant typed ط64,
// the address of a function with the C calling convention. C
// calls it there directly. The argument must name such a function; any
// other is rejected, so no address of an internal-convention function ever
// reaches C.
عرف اخفض_عنوان_دالة_سي_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الحجج: &متجه تعبير,
    النوع: معرف_نوع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): نتيجة_خفض_تعبير {
    إذا ((الطول(*الحجج) مثل طبيعي) != 1) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };
    ليكن الرمز: متغير اختياري معرف_رمز = اختياري.لا_شيء();
    طابق (*الحجج)[0] مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.نجح(ر) -> { الرمز := اختياري.موجود(ر); }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
    }
    | تعبير.حقل(_, _, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(ر) -> { الرمز := اختياري.موجود(ر); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    ليكن الدالة: متغير اختياري معرف_دالة_مسير = اختياري.لا_شيء();
    طابق الرمز مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(ر) -> {
        ليكن بلا_استبدالات: متجه ربط_استبدال_نوع = [];
        طابق دالة_خفض_بمثيل_عند(دوال_الخفض, ر, &بلا_استبدالات) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الربط) -> {
            طابق الربط.الهدف مع
            | هدف_دالة_خفض.داخلية(المعرف) -> {
                إذا (دالة_باتفاقية_سي_مسير(البرنامج, المعرف)) { الدالة := اختياري.موجود(المعرف); };
            }
            | هدف_دالة_خفض.خارجية(_) -> { };
        };
    };
    طابق الدالة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.استعمال_اتفاقية_سي_غير_صالح(نطاق_تعبير(&(*الحجج)[0])));
    }
    | اختياري.موجود(المعرف) -> {
        طابق أصدر_ثابتا_مسير(
            البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة,
            ثابت_مسير.دالة(المعرف), النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(القيمة) -> {
            ليكن النتيجة: قيمة_خفض_مسير = { المعرف: القيمة, النوع: النوع };
            أرجع نتيجة_خفض_تعبير.قيمة(النتيجة);
        }
        | _ -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

// The MSIR operation of a wrapping arithmetic primitive (the right shift's
// is chosen by the operand's signedness when it is lowered).
عرف عملية_بدائي_ملتف_للخفض(الهوية: هوية_بدائي_مترجم): اختياري عملية_حساب_صحيح {
    طابق الهوية مع
    | هوية_بدائي_مترجم.جمع_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.جمع_ملتف()); }
    | هوية_بدائي_مترجم.طرح_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.طرح_ملتف()); }
    | هوية_بدائي_مترجم.ضرب_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.ضرب_ملتف()); }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يسرى_ملتفة()); }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> { أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يمنى()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// a op b modulo 2^N. Shifts first take the amount modulo N, so the shift itself never traps.
عرف اخفض_حسابا_ملتفا_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الهوية: هوية_بدائي_مترجم,
    العملية_الأصلية: عملية_حساب_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن الوصف: وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.موجود(و) -> { الوصف := و; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن العملية: متغير عملية_حساب_صحيح = العملية_الأصلية;
    ليكن المقدار: متغير معرف_قيمة_مسير = اليمين;
    ليكن إزاحة: متغير منطقي = خطأ;
    طابق الهوية مع
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { إزاحة := صواب; }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        إزاحة := صواب;
        إذا (الوصف.موقع) { العملية := عملية_حساب_صحيح.إزاحة_حسابية_يمنى(); };
    }
    | _ -> { };
    إذا (إزاحة) {
        ليكن القناع_الخام: طبيعي = الوصف.البتات - 1;
        ليكن ثابت_القناع: متغير ثابت_مسير = ثابت_مسير.صحيح_طبيعي(القناع_الخام);
        إذا (الوصف.موقع) { ثابت_القناع := ثابت_مسير.صحيح_موقع(القناع_الخام مثل عدد); };
        ليكن القناع: معرف_قيمة_مسير;
        طابق أصدر_ثابتا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة, ثابت_القناع, النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(م) -> { القناع := م; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        طابق أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            عملية_حساب_صحيح.و_بتي(), اليمين, القناع, النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(م) -> { المقدار := م; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    };
    أرجع قيمة_من_بناء_للخفض(
        أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            العملية, اليسار, المقدار, النوع
        ),
        النوع
    );
}

// `x as T` between a float and an integer, or between f32 and f64
// (docs/en/reference/type-system.md, "Numeric casts"): the operation that converts.
عام عرف عملية_تحويل_عائم_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_عائم {
    ليكن مصدر_عائم: منطقي = هل_نوع_عشري_للخفض(الأنواع, نوع_المصدر);
    ليكن هدف_عائم: منطقي = هل_نوع_عشري_للخفض(الأنواع, نوع_الهدف);
    إذا (مصدر_عائم && هدف_عائم) {
        أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_عائم());
    };
    إذا (مصدر_عائم) {
        طابق وصف_صحيح_للخفض(الأنواع, نوع_الهدف) مع
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) { أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_موقع()); };
            أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_طبيعي());
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    إذا (هدف_عائم) {
        طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
        | اختياري.موجود(الوصف) -> {
            إذا (الوصف.موقع) { أرجع اختياري.موجود(عملية_تحويل_عائم.موقع_إلى_عائم()); };
            أرجع اختياري.موجود(عملية_تحويل_عائم.طبيعي_إلى_عائم());
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    أرجع اختياري.لا_شيء();
}

// An 8-bit unsigned value is always a Unicode scalar, so `u8 as char` is a
// zero extension. Wider integers are not: they may name a surrogate or exceed
// U+10FFFF, and stay rejected.
عرف عملية_تحويل_بايت_إلى_حرف_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_صحيح {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الهدف) مع
    | اختياري.موجود(وصف_الهدف) -> {
        طابق وصف_الهدف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي != نوع_بدائي_مقنن.حرف()) { أرجع اختياري.لا_شيء(); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
    | اختياري.موجود(وصف_المصدر) -> {
        إذا (وصف_المصدر.موقع || وصف_المصدر.البتات != 8) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(عملية_تحويل_صحيح.توسيع_صفري());
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_تحويل_حرف_إلى_صحيح_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_صحيح {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_المصدر) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(وصف_المصدر) -> {
        طابق وصف_المصدر.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي != نوع_بدائي_مقنن.حرف()) {
                أرجع اختياري.لا_شيء();
            };
            طابق وصف_صحيح_للخفض(الأنواع, نوع_الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(وصف_الهدف) -> {
                إذا (وصف_الهدف.موقع) {
                    أرجع اختياري.لا_شيء();
                };
                ليكن بتات_المصدر: طبيعي = بتات_نوع_بدائي(البدائي);
                إذا (وصف_الهدف.البتات < بتات_المصدر) {
                    أرجع اختياري.لا_شيء();
                };
                إذا (وصف_الهدف.البتات == بتات_المصدر) {
                    أرجع اختياري.موجود(عملية_تحويل_صحيح.إعادة_تفسير());
                };
                أرجع اختياري.موجود(عملية_تحويل_صحيح.توسيع_صفري());
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// The run-time half of وصف_قيمة_حرف_للخفض: a char value read as its Unicode
// scalar value, converted to ط32 by the same conversion `char as u32` lowers
// to. Character comparisons and character patterns compare that integer.
عام عرف اخفض_حرف_إلى_قيمته_العددية_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    القيمة: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    ليكن نوع_ط32: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(المعرف) -> { نوع_ط32 := المعرف; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
    };
    طابق عملية_تحويل_حرف_إلى_صحيح_للخفض(الأنواع, القيمة.النوع, نوع_ط32) مع
    | اختياري.موجود(العملية) -> {
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                العملية,
                القيمة.المعرف,
                نوع_ط32
            ),
            نوع_ط32
        );
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, القيمة.النوع)
        );
    };
}

// A fresh vector (a call result) viewed as a slice argument has no owner:
// an anonymous owner in the enclosing block keeps its buffer for the view.
عام عرف امتلك_متجها_معروضا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    القيمة: قيمة_خفض_مسير,
    المتوقع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    إذا (!هل_عرض_متجه_كشريحة(الأنواع, القيمة.النوع, المتوقع)) { أرجع اختياري.لا_شيء(); };
    إذا (هل_أصل_مؤقت_للخفض(التعبير)) {
        أرجع سجل_مالكا_مؤقتا_خفض(البرنامج, الحالة, القيمة.المعرف, القيمة.النوع, الأنواع);
    };
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    النوع_الهدف: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    إذا (معرفا_نوع_متساويان(المصدر.النوع, النوع_الهدف)) {
        أرجع نتيجة_خفض_تعبير.قيمة(المصدر);
    };
    // A vector viewed as a slice: the same header, retyped. The vector keeps
    // owning its buffer.
    إذا (هل_عرض_متجه_كشريحة(الأنواع, المصدر.النوع, النوع_الهدف)) {
        ليكن حالة_العرض: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_نقل_تسلسل_مملوك_مسير(
                البرنامج, &حالة_العرض.البناء, حالة_العرض.الدالة, حالة_العرض.الكتلة,
                المصدر.المعرف, النوع_الهدف
            ),
            النوع_الهدف
        );
    };

    إذا (!هل_تحويل_ضمني_آمن(الأنواع, المصدر.النوع, النوع_الهدف)) {
        // The ownership analysis reads the operand as it is.
        إذا ((*الحالة).للتحليل) {
            ليكن كما_هي: قيمة_خفض_مسير = { المعرف: المصدر.المعرف, النوع: النوع_الهدف };
            أرجع نتيجة_خفض_تعبير.قيمة(كما_هي);
        };
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
        );
    };

    طابق وصف_تحويل_صحيح_بين(الأنواع, المصدر.النوع, النوع_الهدف) مع
    | اختياري.موجود(الوصف) -> {
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                عملية_تحويل_صحيح_من_وصف_للخفض(الوصف),
                المصدر.المعرف,
                النوع_الهدف
            ),
            النوع_الهدف
        );
    }
    | اختياري.لا_شيء -> { };

    طابق عملية_تحويل_حرف_إلى_صحيح_للخفض(الأنواع, المصدر.النوع, النوع_الهدف) مع
    | اختياري.موجود(العملية) -> {
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                العملية,
                المصدر.المعرف,
                النوع_الهدف
            ),
            النوع_الهدف
        );
    }
    | اختياري.لا_شيء -> { };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع_الهدف) مع
    | اختياري.موجود(وصف_الهدف) -> {
        طابق وصف_الهدف.الصنف مع
        | صنف_شكل_نوع_دلالي.مؤشر -> {
            أرجع اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                البرنامج, الحالة, النطاق, المصدر, النوع_الهدف, الأنواع
            );
        }
        | صنف_شكل_نوع_دلالي.مرجع -> {
            طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع_الهدف) مع
            | اختياري.موجود(نوع_الداخل) -> {
                طابق اخفض_مكان_فك_مرجع_مقنن(
                    البرنامج, الحالة, النطاق, المصدر, نوع_الداخل, الأنواع
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> {
                    أرجع اخفض_مرجع_مكان_مقنن(
                        البرنامج, الحالة, المكان, النوع_الهدف
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };

    // The ownership analysis reads the operand as it is.
    إذا ((*الحالة).للتحليل) {
        ليكن كما_هي: قيمة_خفض_مسير = { المعرف: المصدر.المعرف, النوع: النوع_الهدف };
        أرجع نتيجة_خفض_تعبير.قيمة(كما_هي);
    };
    أرجع نتيجة_خفض_تعبير.مرفوض(
        خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
    );
}

عرف اخفض_استدعاء_غير_مباشر_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    تعبير_الدالة: &تعبير,
    الحجج: متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن نوع_الدالة_نتيجة: نتيجة_حل_نوع_للخفض =
        نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, تعبير_الدالة);
    ليكن نوع_الدالة: معرف_نوع;
    طابق نوع_الدالة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> { نوع_الدالة := المعرف; }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };

    ليكن عدد_المعاملات: طبيعي;
    طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | اختياري.موجود(العدد) -> { عدد_المعاملات := العدد; };
    إذا ((الطول(الحجج) مثل طبيعي) != عدد_المعاملات) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };

    ليكن قيمة_الدالة: قيمة_خفض_مسير;
    طابق خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, تعبير_الدالة, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الدالة := القيمة; };

    ليكن قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_المعاملات) {
        ليكن المتوقع: معرف_نوع;
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | اختياري.موجود(القيمة) -> { المتوقع := القيمة; };
        ليكن مرجع_الحجة: &تعبير = &الحجج[ف];
        ليكن الحجة: تعبير = *مرجع_الحجة;
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج, الحالة, &الحجة, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة)));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة) -> {
            طابق امتلك_متجها_معروضا_خفض(
                البرنامج, الحالة, &الحجة, قيمة_الحجة, المتوقع, الأنواع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, نطاق_تعبير(&الحجة), قيمة_الحجة, المتوقع, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(قيم_الحجج, المقننة.المعرف); }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة)));
            };
        };
        ف := ف + 1;
    }

    ليكن نوع_الناتج_الدلالي: معرف_نوع;
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | اختياري.موجود(القيمة) -> { نوع_الناتج_الدلالي := القيمة; };
    إذا (!معرفا_نوع_متساويان(نوع_الناتج_الدلالي, النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
    };
    ليكن نوع_ناتج_المسير: متغير اختياري معرف_نوع = اختياري.موجود(النوع);
    إذا (هل_نوع_فراغ_للخفض(الأنواع, النوع)) { نوع_ناتج_المسير := اختياري.لا_شيء(); };
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن نتيجة_النداء: نتيجة_بناء_قيمة_مسير = أصدر_نداء_غير_مباشر_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        قيمة_الدالة.المعرف,
        &قيم_الحجج,
        نوع_ناتج_المسير
    );
    // A callee no local owns (a call result, a closure expression) is
    // dropped once the call returns.
    إذا (هل_نوع_معدود_عادي_مسير(الأنواع, قيمة_الدالة.النوع)
        && هل_تعبير_طازج_للخفض(تعبير_الدالة, روابط_الأسماء, دوال_الخفض)) {
        طابق أسقط_قيمة_خفض(البرنامج, الحالة, قيمة_الدالة.المعرف, قيمة_الدالة.النوع, الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    طابق نوع_ناتج_المسير مع
    | اختياري.موجود(_) -> { أرجع قيمة_من_بناء_للخفض(نتيجة_النداء, النوع); }
    | اختياري.لا_شيء -> {
        طابق نتيجة_النداء مع
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.بلا_قيمة(); }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عرف اخفض_إغلاق_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المعاملات_النحوية: &متجه معامل_إغلاق,
    الجسم: &تعبير,
    نوع_الإغلاق: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن رموز_الالتقاط: متغير متجه معرف_رمز = [];
    طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, النطاق) مع
    | اختياري.موجود(القيم) -> { رموز_الالتقاط := القيم; }
    | اختياري.لا_شيء -> { };

    // Capture values are evaluated at closure construction, before the nested body exists.
    ليكن قيم_الالتقاط: متغير متجه معرف_قيمة_مسير = [];
    ليكن أنواع_الالتقاط: متغير متجه معرف_نوع = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(رموز_الالتقاط) مثل طبيعي)) {
        ليكن الرمز: معرف_رمز = رموز_الالتقاط[ف];
        طابق خفض_قيمة_محلي_إلى_مسير(البرنامج, الحالة, الرمز) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            // The capture reads the local where the closure is made.
            سجل_استخدام_قيمة_مصدري_خفض(
                البرنامج, الحالة, القيمة.المعرف, صنف_استخدام_التقاط_مسير(), اختياري.موجود(الرمز),
                النطاق, النطاق
            );
            // An owned capture moves into the environment: the local gives
            // up its value, and the environment's destructor drops it.
            ليكن ينقل: متغير منطقي = خطأ;
            إذا (!هل_نوع_معدود_عادي_مسير(الأنواع, القيمة.النوع)) {
                // An unresolved ownership class is an internal failure,
                // never a capture left undropped.
                طابق يملك_تخزينا_للغراء(الأنواع, القيمة.النوع) مع
                | نتيجة.نجح(يملك) -> { ينقل := يملك; }
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
                };
            };
            إذا (ينقل) {
                طابق أصدر_ملكية_محلي_خفض(البرنامج, الحالة, الرمز, حدث_ملكية_مسير.تسليم()) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | اختياري.لا_شيء -> { };
                سجل_تسليم_مصدري_خفض(البرنامج, الحالة, الرمز, النطاق);
            };
            // A plain capture stays owned by the local: the environment
            // holds its own copy of a counted one (a closure value), dropped
            // by the environment's destructor.
            طابق انسخ_قيمة_معدودة_خفض(البرنامج, الحالة, القيمة, الأنواع) مع
            | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> {
                ألحق(قيم_الالتقاط, المحتفظة.المعرف);
                ألحق(أنواع_الالتقاط, المحتفظة.النوع);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        ف := ف + 1;
    }

    ليكن أنواع_المعاملات: متغير متجه معرف_نوع = [];
    ليكن عدد_المعاملات: طبيعي;
    طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الإغلاق) مع
    | اختياري.موجود(العدد) -> { عدد_المعاملات := العدد; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };
    إذا (عدد_المعاملات != (الطول(*المعاملات_النحوية) مثل طبيعي)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };
    ف := 0;
    طالما (ف < عدد_المعاملات) {
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الإغلاق, ف) مع
        | اختياري.موجود(النوع_الدلالي) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
            | اختياري.موجود(نوع_المسير) -> { ألحق(أنواع_المعاملات, نوع_المسير); }
            | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع_الدلالي)); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };
        ف := ف + 1;
    }
    ليكن نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الإغلاق) مع
    | اختياري.موجود(النوع_الدلالي) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
        | اختياري.موجود(نوع_المسير) -> {
            إذا (!هل_نوع_فراغ_للخفض(الأنواع, نوع_المسير)) { نوع_الناتج := اختياري.موجود(نوع_المسير); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع_الدلالي)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };

    ليكن معرف_الإغلاق: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &أنواع_المعاملات, نوع_الناتج);
    سجل_أصل_دالة_مصدرية_خفض(البرنامج, معرف_الإغلاق, اختياري.لا_شيء(), اختياري.موجود((*الحالة).الدالة));
    طابق عين_التقاطات_دالة_مسير(البرنامج, معرف_الإغلاق, &أنواع_الالتقاط) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | اختياري.لا_شيء -> { };
    ليكن كتلة_الدخول: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, معرف_الإغلاق) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(الكتلة) -> { كتلة_الدخول := الكتلة; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
    ليكن محليات_فارغة: متجه ربط_محلي_خفض = [];
    ليكن حالة_الأصل: حالة_خفض_دالة = *الحالة;
    ليكن حالة_الإغلاق: متغير حالة_خفض_دالة = {
        الدالة: معرف_الإغلاق,
        الكتلة: كتلة_الدخول,
        نشطة: صواب,
        البناء: حالة_الأصل.البناء,
        المحليات: محليات_فارغة,
        له_هدف_خروج_حلقة: خطأ,
        هدف_خروج_حلقة: كتلة_الدخول,
        له_هدف_متابعة_حلقة: خطأ,
        هدف_متابعة_حلقة: كتلة_الدخول,
        عدد_محليات_متابعة_حلقة: 0,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: اختياري.لا_شيء(),
        العروض: [],
        يجد_العروض: خطأ,
        للتحليل: (*دوال_الخفض).للتحليل
    };
    // Drop elaboration, as for a function body (functions.sn): owner storage
    // in the entry block, the body in a fresh block, every return (falling
    // off the end, `أرجع`, `؟`) through the exit block that drops the owners.
    ليكن إطار_الإغلاق: إطار_إسقاط_خفض;
    طابق افتح_إطار_إسقاط_خفض(البرنامج, معرف_الإغلاق, كتلة_الدخول, نوع_الناتج, الأنواع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة.نجح(الإطار) -> { إطار_الإغلاق := الإطار; };
    حالة_الإغلاق.إطار_الإسقاط := اختياري.موجود(إطار_الإغلاق);
    حالة_الإغلاق.الكتلة := إطار_الإغلاق.البداية;

    ليكن المعاملات: متجه معامل_إغلاق = *المعاملات_النحوية;
    ف := 0;
    طالما (ف < عدد_المعاملات) {
        ليكن مرجع_المعامل: &معامل_إغلاق = &المعاملات[ف];
        ليكن المعامل: معامل_إغلاق = *مرجع_المعامل;
        ليكن رمز_المعامل: معرف_رمز;
        طابق رمز_اسم_للخفض(روابط_الأسماء, &المعامل.الاسم) مع
        | نتيجة.نجح(الرمز) -> { رمز_المعامل := الرمز; }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
        ليكن قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(معرف_الإغلاق, ف);
        طابق أضف_محلي_خفض(&متغير حالة_الإغلاق, رمز_المعامل, أنواع_المعاملات[ف], اختياري.موجود(قيمة_المعامل)) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // A parameter passed by value is owned by the closure body. Captures
        // are not: the environment owns them and its destructor drops them.
        طابق ثبّت_محلي_خفض(
            البرنامج, &متغير حالة_الإغلاق, رمز_المعامل, الأنواع, دوال_الخفض, صواب, اختياري.لا_شيء()
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        سجل_معامل_استعارة_خفض(البرنامج, &حالة_الإغلاق, دوال_الخفض, رمز_المعامل, أنواع_المعاملات[ف]);
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول(رموز_الالتقاط) مثل طبيعي)) {
        ليكن قيمة_الالتقاط: معرف_قيمة_مسير;
        طابق أصدر_استخراج_التقاط_مسير(
            البرنامج,
            &حالة_الإغلاق.البناء,
            معرف_الإغلاق,
            حالة_الإغلاق.الكتلة,
            ف,
            أنواع_الالتقاط[ف]
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_الالتقاط := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        طابق أضف_محلي_خفض(
            &متغير حالة_الإغلاق, رموز_الالتقاط[ف], أنواع_الالتقاط[ف], اختياري.موجود(قيمة_الالتقاط)
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // A capture is not an owner: the environment owns it.
        طابق ثبّت_محلي_خفض(
            البرنامج, &متغير حالة_الإغلاق, رموز_الالتقاط[ف], الأنواع, دوال_الخفض, خطأ, اختياري.لا_شيء()
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // An owned capture belongs to the environment every call shares: the
        // body reads it as a borrowed view.
        إذا (((أعلام_ذاكرة_استعارة_خفض(دوال_الخفض, أنواع_الالتقاط[ف]) / 2) % 2) == 1) {
            سجل_عرض_فارغ_استعارة_خفض(البرنامج, &حالة_الإغلاق, رموز_الالتقاط[ف]);
        };
        ف := ف + 1;
    }

    // The caller owns the value the body returns.
    طابق خفض_تعبير_مملوكا_إلى_مسير(
        البرنامج, &متغير حالة_الإغلاق, الجسم, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.قيمة(قيمة_الجسم) -> {
        إذا (حالة_الإغلاق.نشطة) {
            // The body's value leaves the closure (borrow_events.sn).
            سجل_هروب_استعارة_خفض(البرنامج, &حالة_الإغلاق, الجسم, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض);
            سجل_قيمة_إرجاع_استعارة_خفض(
                البرنامج, &حالة_الإغلاق, الجسم, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإغلاق, اختياري.موجود(قيمة_الجسم.المعرف)) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        إذا (حالة_الإغلاق.نشطة) {
            // The body's value leaves the closure (borrow_events.sn).
            سجل_هروب_استعارة_خفض(البرنامج, &حالة_الإغلاق, الجسم, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض);
            سجل_قيمة_إرجاع_استعارة_خفض(
                البرنامج, &حالة_الإغلاق, الجسم, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإغلاق, اختياري.لا_شيء()) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
    طابق اختم_إطار_إسقاط_خفض(البرنامج, معرف_الإغلاق, &إطار_الإغلاق) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };

    ليكن حالة_الخارج: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_بناء_إغلاق_مسير(
            البرنامج,
            &حالة_الخارج.البناء,
            حالة_الخارج.الدالة,
            حالة_الخارج.الكتلة,
            معرف_الإغلاق,
            &قيم_الالتقاط,
            نوع_الإغلاق
        ),
        نوع_الإغلاق
    );
}

// The value of التعبير for a place that takes ownership of it: a store, an
// argument, an aggregate member, a return. A counted value read from storage
// another owner keeps is copied (drops.sn, "Counted values").
عام عرف خفض_تعبير_مملوكا_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن الناتج: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    طابق الناتج مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        أرجع احتفظ_بقراءة_معدودة_خفض(
            البرنامج, الحالة, التعبير, القيمة, الأنواع, روابط_الأسماء, دوال_الخفض
        );
    }
    | _ -> { أرجع الناتج; };
}

// Whether المعرف is one of the function's compile-time parameters.
// Whether the value المعرف of الدالة comes from a run-time value: a
// parameter that is not a compile-time one, read directly or through the
// local slot it was stored in (every parameter is kept in a slot and read
// with `load`), through the operations compile-time evaluation folds
// (arithmetic, comparisons, casts, aggregates, call arguments). Such a value
// is no compile-time constant: `comptime x` of a run-time parameter is
// SULTANC-COMPTIME-NON-CONSTANT at the expression, not an operation the
// compile-time evaluation finds it cannot run (driver/compile_time.sn).
عرف قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة: &دالة_مسير, المعرف: معرف_قيمة_مسير, العمق: طبيعي): منطقي {
    إذا (العمق > 64) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا (قيمتا_مسير_متساويتان((*الدالة).المعاملات[ف].المعرف, المعرف)) {
            ليكن وقت_ترجمة: منطقي = ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)
                && (*الدالة).معاملات_وقت_الترجمة[ف];
            أرجع !وقت_ترجمة;
        };
        ف := ف + 1;
    }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(الناتج) -> {
                إذا (قيمتا_مسير_متساويتان(الناتج.المعرف, المعرف)) {
                    أرجع عملية_من_قيمة_تشغيل_للخفض(
                        الدالة, &(*الدالة).الكتل[ك].التعليمات[ت].العملية, العمق + 1
                    );
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

عرف قيم_من_قيمة_تشغيل_للخفض(الدالة: &دالة_مسير, القيم: &متجه معرف_قيمة_مسير, العمق: طبيعي): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا (قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, (*القيم)[ف], العمق)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عملية_من_قيمة_تشغيل_للخفض(الدالة: &دالة_مسير, العملية: &عملية_مسير, العمق: طبيعي): منطقي {
    طابق *العملية مع
    | عملية_مسير.تحميل(التحميل) -> {
        // A slot: run-time when any value stored in it is.
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
            ليكن ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.تخزين(التخزين) -> {
                    إذا (قيمتا_مسير_متساويتان(التخزين.المكان, التحميل.المكان)
                        && قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, التخزين.القيمة, العمق)) {
                        أرجع صواب;
                    };
                }
                | _ -> { };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        أرجع خطأ;
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليسار, العمق)
            || قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليمين, العمق);
    }
    | عملية_مسير.مقارنة_صحيح(ح) -> {
        أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليسار, العمق)
            || قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليمين, العمق);
    }
    | عملية_مسير.حساب_عشري(ح) -> {
        أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليسار, العمق)
            || قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليمين, العمق);
    }
    | عملية_مسير.مقارنة_عشري(ح) -> {
        أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليسار, العمق)
            || قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.اليمين, العمق);
    }
    | عملية_مسير.تحويل_صحيح(ح) -> { أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.المصدر, العمق); }
    | عملية_مسير.تحويل_عائم(ح) -> { أرجع قيمة_تشغيل_في_وقت_الترجمة_للخفض(الدالة, ح.المصدر, العمق); }
    | عملية_مسير.تجميع(ح) -> { أرجع قيم_من_قيمة_تشغيل_للخفض(الدالة, &ح.الأعضاء, العمق); }
    | عملية_مسير.تهيئة_متجه(ح) -> { أرجع قيم_من_قيمة_تشغيل_للخفض(الدالة, &ح.العناصر, العمق); }
    | عملية_مسير.نداء(ح) -> { أرجع قيم_من_قيمة_تشغيل_للخفض(الدالة, &ح.الحجج, العمق); }
    | _ -> { أرجع خطأ; };
}

عرف قيمة_معامل_وقت_ترجمة_للخفض(الدالة: &دالة_مسير, المعرف: معرف_قيمة_مسير): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)
            && (*الدالة).معاملات_وقت_الترجمة[ف]
            && قيمتا_مسير_متساويتان((*الدالة).المعاملات[ف].المعرف, المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف انسخ_بايتات_تحقق_للخفض(المصدر: &متجه ط8): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// docs/en/reference/formatting.md, "Compile-time check": a call of a std format function whose
// format string is a literal gets a compile-time obligation before it, the
// call of std.fmt's checker with the literal, the constructor index of each
// element of a vector literal argument vector (as text: `A` plus the index,
// `?` for an element that is not a constructor call) and the literal's
// position. The driver evaluates
// it, reports a nonzero result as a format-string diagnostic at the literal
// and removes it (driver/compile_time.sn). std.fmt's own parser runs at compile time, so
// the compile-time and run-time checks cannot disagree.
عرف أصدر_تحقق_تنسيق_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    رمز_الدالة: معرف_رمز,
    الحجج: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    ليكن الرموز: &متجه معرف_رمز = &(*دوال_الخفض).رموز_التنسيق;
    إذا ((الطول(*الرموز) مثل طبيعي) < 2) { أرجع اختياري.لا_شيء(); };
    ليكن منسقة: متغير منطقي = خطأ;
    ليكن ر: متغير طبيعي = 1;
    طالما (ر < (الطول(*الرموز) مثل طبيعي)) {
        إذا (معرفا_رمز_متساويان((*الرموز)[ر], رمز_الدالة)) { منسقة := صواب; };
        ر := ر + 1;
    }
    إذا (!منسقة) { أرجع اختياري.لا_شيء(); };
    ليكن العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    إذا (العدد < 2) { أرجع اختياري.لا_شيء(); };
    ليكن القالب: متغير متجه ط8 = [];
    ليكن نطاق_القالب: متغير نطاق;
    طابق (*الحجج)[العدد - 2] مع
    | تعبير.حرفي(النطاق, حرفي.نص(البايتات)) -> {
        القالب := انسخ_بايتات_تحقق_للخفض(&البايتات);
        نطاق_القالب := النطاق;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    ليكن الأنواع_الثابتة: متغير متجه ط8 = [];
    ليكن معروفة: متغير منطقي = خطأ;
    طابق (*الحجج)[العدد - 1] مع
    | تعبير.حرفي_متجه(_, العناصر) -> {
        معروفة := صواب;
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(العناصر) مثل طبيعي)) {
            // `A` plus the constructor index, `?` for an unknown one.
            ليكن الترتيب: متغير طبيعي = 0x3F;
            طابق العناصر[ع] مع
            | تعبير.استدعاء(_, المستدعى, _) -> {
                طابق *المستدعى مع
                | تعبير.حقل(_, _, اسم_المنشئ) -> {
                    طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, اسم_المنشئ.النطاق) مع
                    | اختياري.موجود(الهوية) -> {
                        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&العناصر[ع])) مع
                        | اختياري.موجود(نوع_العنصر) -> {
                            طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_العنصر, الهوية) مع
                            | اختياري.موجود(الوصف) -> {
                                إذا (الوصف.الترتيب < 26) { الترتيب := 0x41 + الوصف.الترتيب; };
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            }
            | _ -> { };
            ألحق(الأنواع_الثابتة, الترتيب مثل ط8);
            ع := ع + 1;
        }
    }
    | _ -> { };
    ليكن المدقق: معرف_دالة_مسير;
    طابق دالة_خفض_عند(دوال_الخفض, (*الرموز)[0]) مع
    | اختياري.موجود(الربط) -> {
        طابق الربط.الهدف مع
        | هدف_دالة_خفض.داخلية(المعرف) -> { المدقق := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا ((المدقق.القيمة مثل طبيعي) >= (الطول((*البرنامج).الدوال) مثل طبيعي)
        || (الطول((*البرنامج).الدوال[المدقق.القيمة].المعاملات) مثل طبيعي) != 6) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الثوابت: متغير متجه ثابت_مسير = [];
    ألحق(الثوابت, ثابت_مسير.نص(القالب));
    ألحق(الثوابت, ثابت_مسير.نص(الأنواع_الثابتة));
    ألحق(الثوابت, ثابت_مسير.منطق(معروفة));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.البداية.المصدر));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.البداية.البايت));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.النهاية.البايت));
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن القيم: متغير متجه معرف_قيمة_مسير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 6) {
        ليكن نوع_المعامل: معرف_نوع = (*البرنامج).الدوال[المدقق.القيمة].المعاملات[ف].النوع;
        طابق أصدر_ثابتا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            انسخ_ثابت_مسير(&الثوابت[ف]), نوع_المعامل
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ألحق(القيم, المعرف); }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    طابق أصدر_نداء_مسير(
        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
        المدقق, &القيم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(الناتج) -> {
        ليكن د: طبيعي = حالة_الإصدار.الدالة.القيمة;
        ليكن ك: طبيعي = حالة_الإصدار.الكتلة.القيمة;
        إذا (د < (الطول((*البرنامج).الدوال) مثل طبيعي) && ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            ليكن ت: متغير طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
            طالما (ت > 0) {
                ت := ت - 1;
                طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(الموجود) -> {
                    إذا (قيمتا_مسير_متساويتان(الموجود.المعرف, الناتج)) {
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                        ت := 0;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
        };
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { };
    أرجع اختياري.لا_شيء();
}

// Lowers `&e` of a temporary: the owned value of e goes to a block-owned
// temporary slot (اخفض_قيمة_إلى_مكان_مؤقت_مسير) and the result is a
// reference to the slot.
عرف اخفض_عنوان_مؤقت_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: &تعبير,
    نوع_المرجع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    طابق اخفض_قيمة_إلى_مكان_مؤقت_مسير(
        البرنامج, الحالة, النطاق, الداخل, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_مكان.مكان(المكان) -> {
        أرجع اخفض_مرجع_مكان_مقنن(البرنامج, الحالة, المكان, نوع_المرجع);
    };
}

// The place of a value that has no storage of its own: the owned value of e
// goes to a slot (in the drop frame's prologue, registered as a temporary
// owner when it owns storage, so the enclosing block's exits destroy it).
// `&e` of a temporary and a module constant used as a place
// (هل_اسم_ثابت_وحدة_للخفض) both get their place here.
عرف اخفض_قيمة_إلى_مكان_مؤقت_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_مكان {
    ليكن القيمة_المملوكة: معرف_قيمة_مسير;
    ليكن نوع_القيمة: معرف_نوع;
    طابق خفض_تعبير_مملوكا_إلى_مسير(
        البرنامج, الحالة, الداخل, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        القيمة_المملوكة := القيمة.المعرف;
        نوع_القيمة := القيمة.النوع;
    };
    ليكن عدد_قبل: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    طابق سجل_مالكا_مؤقتا_خفض(البرنامج, الحالة, القيمة_المملوكة, نوع_القيمة, الأنواع) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن عدد_بعد: طبيعي = الطول((*الحالة).المحليات) مثل طبيعي;
    إذا (عدد_بعد > عدد_قبل) {
        طابق (*الحالة).المحليات[عدد_بعد - 1].المكان مع
        | اختياري.موجود(الخانة) -> {
            ليكن المكان: مكان_خفض_مسير = { المعرف: الخانة, النوع: نوع_القيمة };
            أرجع نتيجة_خفض_مكان.مكان(المكان);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
    // A value that owns nothing: a plain slot in the current block, as for a
    // plain local (the drop frame's prologue holds only owner places, which
    // اختم_إطار_إسقاط_خفض reads as the owners).
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    ليكن الخانة: معرف_قيمة_مسير;
    طابق أصدر_مكان_محلي_مسير(
        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة, نوع_القيمة, صواب
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الخانة := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    طابق أصدر_تخزين_مسير(
        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة, الخانة, القيمة_المملوكة
    ) مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | _ -> { };
    ليكن المكان: مكان_خفض_مسير = { المعرف: الخانة, النوع: نوع_القيمة };
    أرجع نتيجة_خفض_مكان.مكان(المكان);
}

// Builds a record value of نوع_السجل from a record literal's fields: each
// declared field's value is lowered owned, converted to the field's Type and
// placed in declaration order. Shared by `let r: T = {..};` (aggregates.sn)
// and the record literal expression.
عام عرف اخفض_قيمة_سجل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    نوع_السجل: معرف_نوع,
    الحقول: &متجه حقل_تهيئة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن عدد_الحقول: متغير طبيعي = 0;
    طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_السجل) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_السجل));
    }
    | اختياري.موجود(العدد) -> { عدد_الحقول := العدد; };
    إذا ((الطول(*الحقول) مثل طبيعي) != عدد_الحقول) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };
    ليكن القيم_المرتبة: متغير متجه معرف_قيمة_مسير = [];
    ليكن الترتيب: متغير طبيعي = 0;
    طالما (الترتيب < عدد_الحقول) {
        ليكن وجد: متغير منطقي = خطأ;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الحقول) مثل طبيعي)) {
            ليكن مرجع_الحقل: &حقل_تهيئة = &(*الحقول)[ف];
            ليكن هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
            طابق معرف_اسم_محلول_عند(روابط_الأسماء, (*مرجع_الحقل).الاسم.النطاق) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.ربط_اسم_مفقود((*مرجع_الحقل).الاسم.النطاق));
            }
            | اختياري.موجود(المعرف) -> { هوية_الحقل := المعرف; };
            طابق وصف_حقل_سجل_دلالي_بالاسم(الأنواع, نوع_السجل, هوية_الحقل) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_السجل));
            }
            | اختياري.موجود(الوصف) -> {
                إذا (الوصف.الترتيب == الترتيب) {
                    إذا (وجد) {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                    };
                    ليكن مرجع_القيمة: &تعبير = &(*مرجع_الحقل).القيمة;
                    طابق خفض_تعبير_مملوكا_إلى_مسير(
                        البرنامج, الحالة, مرجع_القيمة, الأنواع, أنواع_التعبيرات,
                        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    ) مع
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
                    }
                    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                            البرنامج, الحالة, نطاق_تعبير(مرجع_القيمة), القيمة, الوصف.النوع, الأنواع
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                            ألحق(القيم_المرتبة, القيمة_المقننة.المعرف);
                            وجد := صواب;
                        }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> {
                            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_القيمة)));
                        };
                    };
                };
            };
            ف := ف + 1;
        }
        إذا (!وجد) {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        الترتيب := الترتيب + 1;
    }
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة, &القيم_المرتبة, نوع_السجل
        ),
        نوع_السجل
    );
}

// Builds a tuple value of نوع_الصف from a tuple literal expression's
// elements: each is lowered owned, converted to its element Type and placed
// in order, as `let p: T = (..);` does (aggregates.sn).
عرف اخفض_قيمة_صف_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    نوع_الصف: معرف_نوع,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن عدد_العناصر: متغير طبيعي = 0;
    طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الصف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الصف));
    }
    | اختياري.موجود(العدد) -> { عدد_العناصر := العدد; };
    إذا ((الطول(*العناصر) مثل طبيعي) != عدد_العناصر) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };
    ليكن القيم: متغير متجه معرف_قيمة_مسير = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_العناصر) {
        ليكن نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الصف, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الصف));
        }
        | اختياري.موجود(النوع) -> { نوع_العنصر := النوع; };
        ليكن مرجع_العنصر: &تعبير = &(*العناصر)[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج, الحالة, مرجع_العنصر, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر)));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, نطاق_تعبير(مرجع_العنصر), القيمة, نوع_العنصر, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(القيم, المقننة.المعرف); }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر)));
            };
        };
        ف := ف + 1;
    }
    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة, &القيم, نوع_الصف
        ),
        نوع_الصف
    );
}

// The value of an expression. A read from a place (a name, a member, an
// element, a dereference or a borrow of one) is recorded as a source use of
// the place's root, at the instruction that produced the value
// (msir/ssf/ownership_legality.sn).
عام عرف خفض_تعبير_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن الناتج: نتيجة_خفض_تعبير = خفض_تعبير_دون_مصدر_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    ليكن قراءة: متغير منطقي = خطأ;
    طابق *التعبير مع
    | تعبير.اسم(_, _) -> { قراءة := صواب; }
    | تعبير.حقل(_, _, _) -> { قراءة := صواب; }
    | تعبير.فهرس(_, _, _) -> { قراءة := صواب; }
    | تعبير.فك_موضع(_, _) -> { قراءة := صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { قراءة := صواب; }
    | تعبير.أحادي(_, عامل_أحادي.عنوان, _) -> { قراءة := صواب; }
    | تعبير.أحادي(_, عامل_أحادي.عنوان_متغير, _) -> { قراءة := صواب; }
    | _ -> { };
    إذا (قراءة) {
        طابق الناتج مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            سجل_قراءة_تعبير_مصدرية_خفض(البرنامج, الحالة, التعبير, القيمة.المعرف, روابط_الأسماء);
        }
        | _ -> { };
    };
    أرجع الناتج;
}

عرف خفض_تعبير_دون_مصدر_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن النوع_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, التعبير);
    ليكن النوع: متغير معرف_نوع = معرف_نوع_من(0);
    طابق النوع_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
        النوع := المعرف;
    }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    };

    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(النطاق, الحرفي) -> {
        أرجع خفض_حرفي_إلى_مسير(البرنامج, الحالة, النطاق, انسخ_مملوكا_حرفي(&الحرفي), النوع, الأنواع);
    }
    | تعبير.اسم(_, _) -> {
        أرجع خفض_تعبير_اسم_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, روابط_الأسماء, دوال_الخفض, النوع);
    }
    | تعبير.حقل(_, _, _) -> {
        أرجع خفض_تعبير_حقل_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.فهرس(_, _, _) -> {
        أرجع خفض_تعبير_فهرس_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.فك_موضع(_, _) -> {
        أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
            البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | تعبير.ثنائي(_, _, _, _) -> {
        أرجع خفض_تعبير_ثنائي_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.أحادي(_, _, _) -> {
        أرجع خفض_تعبير_أحادي_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.استدعاء(_, _, _) -> {
        أرجع خفض_تعبير_استدعاء_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.تسلسل_وقت_الترجمة(_, _) -> {
        أرجع خفض_تعبير_تسلسل_وقت_الترجمة_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات);
    }
    | تعبير.وقت_الترجمة(_, _) -> {
        أرجع خفض_تعبير_وقت_الترجمة_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.حرفي_متجه(_, _) -> {
        أرجع خفض_تعبير_حرفي_متجه_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    }
    | تعبير.حجج_نوع(_, الداخل_المملوك, _) -> {
        ليكن الداخل: تعبير = *الداخل_المملوك;
        أرجع خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    // A tuple literal expression is a fresh owned tuple (a temporary).
    | تعبير.حرفي_صف(النطاق, العناصر) -> {
        أرجع اخفض_قيمة_صف_إلى_مسير(
            البرنامج, الحالة, النطاق, النوع, &العناصر, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    // A record literal expression is a fresh owned record (a temporary).
    | تعبير.حرفي_سجل(النطاق, الحقول) -> {
        أرجع اخفض_قيمة_سجل_إلى_مسير(
            البرنامج, الحالة, النطاق, النوع, &الحقول, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.إغلاق(النطاق, المعاملات, _, الجسم_المملوك) -> {
        ليكن الجسم: تعبير = *الجسم_المملوك;
        أرجع اخفض_إغلاق_إلى_مسير(
            البرنامج, الحالة, النطاق, &المعاملات, &الجسم, النوع, الأنواع,
            أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.تحويل(_, _, _) -> {
        أرجع خفض_تعبير_تحويل_إلى_مسير(البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, النوع);
    };
}

// The `اسم` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_اسم_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن حالة_القراءة: حالة_خفض_دالة = *الحالة;
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(_, الاسم) -> {
        // Name authenticates the exact unbound null occurrence. A missing
        // symbol alone cannot authorize a typed null MSIR constant.
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> {
            إذا (هل_ظهور_مؤشر_فارغ_سياقي(روابط_الأسماء, الاسم.النطاق)
                && هل_نوع_مؤشر_للخفض(الأنواع, النوع)) {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_ثابتا_مسير(
                        البرنامج, &حالة_القراءة.البناء,
                        حالة_القراءة.الدالة, حالة_القراءة.الكتلة,
                        ثابت_مسير.مؤشر_فارغ(), النوع
                    ),
                    النوع
                );
            };
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
            );
        }
        | اختياري.موجود(_) -> { };
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(ربط_الدالة) -> {
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق ربط_الدالة.الهدف مع
                | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                    // A @@c_abi function is no function value: closure calls
                    // pass an environment in the internal convention. Its
                    // address is c_function_address(f).
                    إذا (دالة_باتفاقية_سي_مسير(البرنامج, معرف_الدالة)) {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.استعمال_اتفاقية_سي_غير_صالح(نطاق_تعبير(التعبير)));
                    };
                    ليكن الالتقاطات_الفارغة: متجه معرف_قيمة_مسير = [];
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_بناء_إغلاق_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            دالة_قيمة_خفض(دوال_الخفض, معرف_الدالة),
                            &الالتقاطات_الفارغة,
                            النوع
                        ),
                        النوع
                    );
                }
                | هدف_دالة_خفض.خارجية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                };
            }
            | اختياري.لا_شيء -> {
                طابق موضع_محلي_خفض(الحالة, الرمز) مع
                | اختياري.موجود(موضع_المحلي) -> {
                    // A local of the void Type (a generic instance) holds no value.
                    إذا (هل_نوع_فراغ_للخفض(الأنواع, (*الحالة).المحليات[موضع_المحلي].النوع)) {
                        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                    };
                    // An owner's read loads its place; whether it moves the
                    // value out is decided on MSIR (drop_elaboration.sn).
                    أرجع خفض_قيمة_محلي_إلى_مسير(البرنامج, الحالة, الرمز);
                }
                | اختياري.لا_شيء -> {
                    طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
                    }
                    | اختياري.موجود(الربط) -> {
                        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        طابق الربط.الهدف مع
                        | هدف_قيمة_عليا_خفض.موسوم(الموسوم) -> {
                            أرجع اخفض_ثابتا_موسوما_إلى_مسير(البرنامج, الحالة, &الموسوم);
                        }
                        | هدف_قيمة_عليا_خفض.ثابت(الثابت) -> {
                            أرجع قيمة_من_بناء_للخفض(
                                أصدر_ثابتا_مسير(
                                    البرنامج,
                                    &حالة_الإصدار.البناء,
                                    حالة_الإصدار.الدالة,
                                    حالة_الإصدار.الكتلة,
                                    انسخ_ثابت_مسير(&الثابت),
                                    الربط.النوع
                                ),
                                الربط.النوع
                            );
                        }
                        | هدف_قيمة_عليا_خفض.عام(العام) -> {
                            طابق أصدر_مكان_عام_مسير(
                                البرنامج,
                                &حالة_الإصدار.البناء,
                                حالة_الإصدار.الدالة,
                                حالة_الإصدار.الكتلة,
                                العام,
                                الربط.النوع,
                                الربط.قابل_للكتابة
                            ) مع
                            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                            }
                            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                            }
                            | نتيجة_بناء_قيمة_مسير.مبنية(المكان) -> {
                                أرجع قيمة_من_بناء_للخفض(
                                    أصدر_تحميل_مسير(
                                        البرنامج,
                                        &حالة_الإصدار.البناء,
                                        حالة_الإصدار.الدالة,
                                        حالة_الإصدار.الكتلة,
                                        المكان,
                                        الربط.النوع
                                    ),
                                    الربط.النوع
                                );
                            };
                        };
                    };
                };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `حقل` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_حقل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حقل(النطاق, صندوق_الأصل, اسم_الحقل) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق دالة_خفض_عند(دوال_الخفض, رمز_العضو) مع
            | اختياري.موجود(ربط_الدالة) -> {
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق ربط_الدالة.الهدف مع
                | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                    // A @@c_abi function is no function value: closure calls
                    // pass an environment in the internal convention. Its
                    // address is c_function_address(f).
                    إذا (دالة_باتفاقية_سي_مسير(البرنامج, معرف_الدالة)) {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.استعمال_اتفاقية_سي_غير_صالح(نطاق_تعبير(التعبير)));
                    };
                    ليكن الالتقاطات_الفارغة: متجه معرف_قيمة_مسير = [];
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_بناء_إغلاق_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            دالة_قيمة_خفض(دوال_الخفض, معرف_الدالة),
                            &الالتقاطات_الفارغة,
                            النوع
                        ),
                        النوع
                    );
                }
                | هدف_دالة_خفض.خارجية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        // A field of storage that has a place (`(*r).f`, `x.a.b` of an owner
        // `x`, `v[i].f`) is loaded from the field's place alone.
        إذا (جذر_مكان_قراءة_للخفض(
            الحالة, &(*صندوق_الأصل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        )) {
            أرجع خفض_قراءة_إسقاط_مكان_إلى_مسير(
                البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        };
        ليكن الأصل: تعبير = *صندوق_الأصل;
        ليكن هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
        طابق معرف_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.ربط_اسم_مفقود(اسم_الحقل.النطاق)
            );
        }
        | اختياري.موجود(المعرف) -> {
            هوية_الحقل := المعرف;
        };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
            طابق وصف_حقل_سجل_دلالي_بالاسم(الأنواع, قيمة_الأصل.النوع, هوية_الحقل) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الأصل.النوع)
                );
            }
            | اختياري.موجود(الوصف) -> {
                إذا (!نوعان_متوافقان(الأنواع, الوصف.النوع, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                ليكن المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                    أصدر_استخراج_حقل_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        قيمة_الأصل.المعرف,
                        الوصف.الترتيب,
                        الوصف.النوع
                    ),
                    الوصف.النوع
                );
                // A field of a temporary (`make().f`): the rest of it is
                // destroyed (drops.sn, أسقط_بقية_مؤقت_خفض).
                إذا (هل_أصل_مؤقت_للخفض(&الأصل)) {
                    طابق أسقط_بقية_مؤقت_خفض(
                        البرنامج, الحالة, قيمة_الأصل, الوصف.الترتيب, الوصف.النوع, الأنواع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
                أرجع المقروء;
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `فهرس` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_فهرس_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.فهرس(النطاق, صندوق_الأصل, صندوق_الفهرس) -> {
        ليكن الأصل: تعبير = *صندوق_الأصل;
        ليكن الفهرس: تعبير = *صندوق_الفهرس;
        ليكن نوع_الأصل_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الأصل);
        ليكن نوع_الأصل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_الأصل_نتيجة مع
        | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
            نوع_الأصل := المعرف;
        }
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        };
        طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأصل) مع
        | اختياري.موجود(عدد_العناصر) -> {
            ليكن الموضع: متغير طبيعي = 0;
            طابق الفهرس مع
            | تعبير.حرفي(_, حرفي.عدد(القيمة)) -> {
                إذا (القيمة < 0) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
                الموضع := القيمة مثل طبيعي;
            }
            | تعبير.حرفي(_, حرفي.عدد_طبيعي(القيمة)) -> {
                الموضع := القيمة;
            }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
            إذا (الموضع >= عدد_العناصر) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الأصل, الموضع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الأصل)
                );
            }
            | اختياري.موجود(نوع_العنصر) -> {
                إذا (!معرفا_نوع_متساويان(نوع_العنصر, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    ليكن المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                        أصدر_استخراج_حقل_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            قيمة_الأصل.المعرف,
                            الموضع,
                            نوع_العنصر
                        ),
                        نوع_العنصر
                    );
                    إذا (هل_أصل_مؤقت_للخفض(&الأصل)) {
                        طابق أسقط_بقية_مؤقت_خفض(
                            البرنامج, الحالة, قيمة_الأصل, الموضع, نوع_العنصر, الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                    أرجع المقروء;
                };
            };
        }
        | اختياري.لا_شيء -> {
            إذا (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الأصل)) {
                أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
                    البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                );
            };
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                    // An index read outside a vector or text traps.
                    إذا (نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع, قيمة_الأصل.النوع)) {
                        طابق تحقق_حدود_فهرس_قيمة_للخفض(
                            البرنامج, الحالة, النطاق, قيمة_الأصل.المعرف, قيمة_الفهرس, الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    ليكن المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                        أصدر_استخراج_فهرس_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            قيمة_الأصل.المعرف,
                            قيمة_الفهرس.المعرف,
                            النوع
                        ),
                        النوع
                    );
                    // An element of a temporary vector (`make()[i]`).
                    إذا (هل_أصل_مؤقت_للخفض(&الأصل)) {
                        طابق المقروء مع
                        | نتيجة_خفض_تعبير.قيمة(العنصر) -> {
                            طابق أسقط_متجها_مؤقتا_بعد_عنصر_خفض(
                                البرنامج, الحالة, قيمة_الأصل, العنصر, الأنواع
                            ) مع
                            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                            | نتيجة.نجح(المحفوظ) -> { أرجع نتيجة_خفض_تعبير.قيمة(المحفوظ); };
                        }
                        | _ -> { };
                    };
                    أرجع المقروء;
                };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `ثنائي` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
// A left-nested chain `((a + b) + c) + …` or `((a && b) && c) && …` (how
// the parser builds every left-associative operator) is lowered with a loop:
// references to the nodes whose left operand is again a binary node are
// collected outermost first and their operator checks run in that order,
// the innermost node is lowered as one, and each enclosing node then lowers
// its right operand onto the value of the nodes inside it. The instructions
// and their order are the recursion's, without a stack frame per operator:
// a chain of a few thousand operands overflowed the stack (8 MiB on macOS and
// Windows) before.
عرف خفض_تعبير_ثنائي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    // Each node is borrowed from the one before it (its left operand).
    // Raw pointers, not references: Stage0 has no lifetime for a vector of
    // references (bootstrap/src/semantic/body_initializer_check_vector_init.c).
    // Each points into the tree التعبير borrows, which outlives this walk.
    ليكن العقد: متغير متجه *تعبير = [];
    غير_آمن { ألحق(العقد, التعبير مثل *تعبير); };
    ليكن أنواع_العقد: متغير متجه معرف_نوع = [النوع];
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        ليكن مؤشر_الأخير: *تعبير = العقد[(الطول(العقد) مثل طبيعي) - 1];
        ليكن الأخير: &تعبير;
        غير_آمن { الأخير := &(*مؤشر_الأخير); };
        ليكن نوع_الأخير: معرف_نوع = أنواع_العقد[(الطول(أنواع_العقد) مثل طبيعي) - 1];
        طابق *الأخير مع
        | تعبير.ثنائي(النطاق, العامل, صندوق_اليسار, _) -> {
            ليكن اليسار: &تعبير = &(*صندوق_اليسار);
            ليكن تتسلسل: متغير منطقي = خطأ;
            طابق *اليسار مع
            | تعبير.ثنائي(_, _, _, _) -> { تتسلسل := صواب; }
            | _ -> { };
            ليكن منطقي_قصير: منطقي = العامل == عامل_ثنائي.و() || العامل == عامل_ثنائي.أو();
            إذا (تتسلسل && منطقي_قصير) {
                إذا (!هل_نوع_منطقي_للخفض(الأنواع, نوع_الأخير)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الأخير));
                };
            };
            إذا (تتسلسل && !منطقي_قصير) {
                طابق افحص_عقدة_ثنائية_للخفض(الأنواع, أنواع_التعبيرات, النطاق, العامل, اليسار) مع
                | فحص_عقدة_ثنائية_خفض.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                // Text equality lowers both operands itself: the chain stops here.
                | فحص_عقدة_ثنائية_خفض.مساواة_نصين -> { تتسلسل := خطأ; }
                | فحص_عقدة_ثنائية_خفض.عادية -> { };
            };
            إذا (تتسلسل) {
                طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, اليسار) مع
                | نتيجة_حل_نوع_للخفض.موجود(نوع_اليسار) -> {
                    غير_آمن { ألحق(العقد, اليسار مثل *تعبير); };
                    ألحق(أنواع_العقد, نوع_اليسار);
                    مستمر := صواب;
                }
                | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
            };
        }
        | _ -> { };
    }
    ليكن ف: متغير طبيعي = (الطول(العقد) مثل طبيعي) - 1;
    ليكن مؤشر_الأعمق: *تعبير = العقد[ف];
    ليكن الأعمق: &تعبير;
    غير_آمن { الأعمق := &(*مؤشر_الأعمق); };
    ليكن الناتج: متغير نتيجة_خفض_تعبير = خفض_تعبير_ثنائي_مفرد_إلى_مسير(
        البرنامج, الحالة, الأعمق, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات, أنواع_العقد[ف]
    );
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن مؤشر_العقدة_2: *تعبير = العقد[ف];
        ليكن العقدة_2: &تعبير;
        غير_آمن { العقدة_2 := &(*مؤشر_العقدة_2); };
        طابق *العقدة_2 مع
        | تعبير.ثنائي(النطاق, العامل, _, صندوق_اليمين) -> {
            ليكن أ: قيمة_خفض_مسير;
            طابق الناتج مع
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> { أ := القيمة; }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            };
            ليكن اليمين: &تعبير = &(*صندوق_اليمين);
            إذا (العامل == عامل_ثنائي.و() || العامل == عامل_ثنائي.أو()) {
                الناتج := أكمل_منطق_قصير_بيسار_إلى_مسير(
                    البرنامج, الحالة, النطاق, العامل, اليمين, أنواع_العقد[ف], الأنواع,
                    أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, أ
                );
            } وإلا {
                الناتج := أكمل_حساب_ثنائي_بيسار_إلى_مسير(
                    البرنامج, الحالة, النطاق, العامل, اليمين, أنواع_العقد[ف], الأنواع,
                    أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات, أ
                );
            };
        }
        | _ -> { };
    }
    أرجع الناتج;
}

عرف خفض_تعبير_ثنائي_مفرد_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.ثنائي(النطاق, العامل, صندوق_اليسار, صندوق_اليمين) -> {
        ليكن اليسار: تعبير = *صندوق_اليسار;
        ليكن اليمين: تعبير = *صندوق_اليمين;
        طابق العامل مع
        | عامل_ثنائي.و -> {
            أرجع اخفض_منطق_قصير_إلى_مسير(
                البرنامج,
                الحالة,
                النطاق,
                العامل,
                &اليسار,
                &اليمين,
                النوع,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            );
        }
        | عامل_ثنائي.أو -> {
            أرجع اخفض_منطق_قصير_إلى_مسير(
                البرنامج,
                الحالة,
                النطاق,
                العامل,
                &اليسار,
                &اليمين,
                النوع,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            );
        }
        | _ -> { };
        طابق افحص_عقدة_ثنائية_للخفض(الأنواع, أنواع_التعبيرات, النطاق, العامل, &اليسار) مع
        | فحص_عقدة_ثنائية_خفض.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | فحص_عقدة_ثنائية_خفض.مساواة_نصين -> {
            أرجع اخفض_مساواة_نصين_إلى_مسير(
                البرنامج, الحالة, النطاق, العامل, &اليسار, &اليمين, النوع, الأنواع,
                أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        }
        | فحص_عقدة_ثنائية_خفض.عادية -> { };
        ليكن نتيجة_أ: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &اليسار,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
        طابق نتيجة_أ مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(أ) -> {
            أرجع أكمل_حساب_ثنائي_بيسار_إلى_مسير(
                البرنامج, الحالة, النطاق, العامل, &اليمين, النوع, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات, أ
            );
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// What lowering a binary node of an arithmetic or comparison operator checks
// before it lowers an operand: an operator its operand Type does not define
// (in a generic instance), and text equality, which has its own lowering.
نوع فحص_عقدة_ثنائية_خفض =
    | عادية
    | مساواة_نصين
    | مرفوضة بنوع خطأ_خفض_مسير
;

عرف افحص_عقدة_ثنائية_للخفض(
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: &تعبير
): فحص_عقدة_ثنائية_خفض {
    // The type checker rejects an operator its operands' Type does not
    // define; in a generic instance the operand Type is known only here,
    // so the instantiation reports it (`>` is not defined for `Point`).
    // Text equality compares contents (اخفض_مساواة_نصين_إلى_مسير).
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, اليسار) مع
    | نتيجة_حل_نوع_للخفض.موجود(نوع_الطرف) -> {
        ليكن نوع_الطرف_الأساس: متغير معرف_نوع = نوع_الطرف;
        طابق أزل_غلاف_متغير(الأنواع, نوع_الطرف) مع
        | اختياري.موجود(الأساس) -> { نوع_الطرف_الأساس := الأساس; }
        | اختياري.لا_شيء -> { };
        // Arithmetic on scalars and raw pointers keeps its own lowering
        // rules below; comparisons and operators on aggregates are checked.
        ليكن يفحص_العامل: متغير منطقي = !هل_عامل_ثنائي_ينتج_عددا_صحيحا_للخفض(العامل);
        إذا (!يفحص_العامل) {
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الطرف_الأساس) مع
            | اختياري.موجود(الوصف) -> {
                طابق الوصف.الصنف مع
                | صنف_شكل_نوع_دلالي.بدائي(_) -> { }
                | صنف_شكل_نوع_دلالي.مؤشر -> { }
                | صنف_شكل_نوع_دلالي.معامل_نوع -> { }
                | _ -> { يفحص_العامل := صواب; };
            }
            | اختياري.لا_شيء -> { };
        };
        إذا (يفحص_العامل && !هل_عامل_ثنائي_معرف_للنوع(الأنواع, العامل, نوع_الطرف_الأساس)) {
            أرجع فحص_عقدة_ثنائية_خفض.مرفوضة(خطأ_خفض_مسير.عامل_غير_معرف_لنوع(
                النطاق, العامل, نوع_الطرف_الأساس, اختياري.لا_شيء()
            ));
        };
        إذا ((العامل == عامل_ثنائي.يساوي() || العامل == عامل_ثنائي.لا_يساوي())
            && هل_نوع_بدائي_للخفض(الأنواع, نوع_الطرف_الأساس, نوع_بدائي_مقنن.نص())) {
            أرجع فحص_عقدة_ثنائية_خفض.مساواة_نصين();
        };
    }
    | نتيجة_حل_نوع_للخفض.مرفوض(_) -> { };
    أرجع فحص_عقدة_ثنائية_خفض.عادية();
}

// The rest of an arithmetic or comparison node once its left operand is
// lowered (أ): its right operand and the operation. A chain lowers each
// enclosing node through it with the value of the nodes inside
// (خفض_تعبير_ثنائي_إلى_مسير).
عرف أكمل_حساب_ثنائي_بيسار_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليمين: &تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    أ: قيمة_خفض_مسير
): نتيجة_خفض_تعبير {
    ليكن نتيجة_ب: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج,
        الحالة,
        اليمين,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    );
    طابق نتيجة_ب مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(ب) -> {
        إذا (هل_نوع_عشري_للخفض(الأنواع, أ.النوع) && معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
            طابق عملية_حساب_عشري_من_عامل_للخفض(العامل) مع
            | اختياري.موجود(عملية_عشرية) -> {
                إذا (!معرفا_نوع_متساويان(أ.النوع, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
                };
                ليكن حالة_عشرية: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(أصدر_حسابا_عشريا_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, عملية_عشرية, أ.المعرف, ب.المعرف, النوع), النوع);
            }
            | اختياري.لا_شيء -> {
                طابق عملية_مقارنة_عشرية_من_عامل_للخفض(العامل) مع
                | اختياري.موجود(مقارنة_عشرية) -> {
                    إذا (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
                    ليكن حالة_عشرية: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(أصدر_مقارنة_عشرية_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, مقارنة_عشرية, أ.المعرف, ب.المعرف, النوع), النوع);
                }
                | اختياري.لا_شيء -> { };
            };
        };
        طابق عملية_حساب_من_عامل_للخفض(العامل, النوع, الأنواع) مع
        | اختياري.موجود(العملية) -> {
            // Frontend typing propagates an expected integer Type
            // into both operands and accepts implicitly-safe
            // widening there (e.g. طبيعي within a ط64 context).
            // Materialize exactly those canonical conversions here;
            // anything else remains unsupported.
            ليكن أ_المحول: متغير قيمة_خفض_مسير = أ;
            ليكن ب_المحول: متغير قيمة_خفض_مسير = ب;
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(البرنامج, الحالة, النطاق, أ, النوع, الأنواع) مع
            | نتيجة_خفض_تعبير.قيمة(المحول) -> { أ_المحول := المحول; }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(البرنامج, الحالة, النطاق, ب, النوع, الأنواع) مع
            | نتيجة_خفض_تعبير.قيمة(المحول) -> { ب_المحول := المحول; }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
            أرجع قيمة_حساب_مفحوص_من_بناء_للخفض(
                البرنامج, حالة_الإصدار.الدالة, النطاق.البداية,
                أصدر_حسابا_صحيحا_مسير(
                    البرنامج,
                    &حالة_الإصدار.البناء,
                    حالة_الإصدار.الدالة,
                    حالة_الإصدار.الكتلة,
                    العملية,
                    أ_المحول.المعرف,
                    ب_المحول.المعرف,
                    النوع
                ),
                النوع
            );
        }
        | اختياري.لا_شيء -> {
            طابق عملية_مقارنة_من_عامل_للخفض(العامل) مع
            | اختياري.موجود(المقارنة) -> {
                إذا ((!معرفا_نوع_متساويان(أ.النوع, ب.النوع))
                    || (!هل_نوع_منطقي_للخفض(الأنواع, النوع))) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                ليكن عامل_يساوي: عامل_ثنائي = عامل_ثنائي.يساوي();
                ليكن عامل_لا_يساوي: عامل_ثنائي = عامل_ثنائي.لا_يساوي();
                ليكن مساواة: متغير منطقي = خطأ;
                إذا (العامل == عامل_يساوي) { مساواة := صواب; };
                إذا (العامل == عامل_لا_يساوي) { مساواة := صواب; };
                إذا (مساواة && هل_نوع_منطقي_للخفض(الأنواع, أ.النوع)) {
                    أرجع اخفض_مساواة_منطقية_مسير(
                        البرنامج, الحالة, النطاق, العامل, أ, ب, النوع
                    );
                };
                إذا (مساواة && هل_نوع_موسوم_بلا_حمولات_للخفض(الأنواع, أ.النوع)) {
                    أرجع اخفض_مقارنة_وسمين_بلا_حمولات_إلى_مسير(
                        البرنامج, الحالة, النطاق, العامل, أ, ب, النوع, الأنواع
                    );
                };
                // A character compares as its Unicode scalar value
                // (وصف_قيمة_حرف_للخفض): both operands become that ط32
                // integer, as in character patterns, and compare as
                // unsigned integers.
                ليكن أ_المقارن: متغير قيمة_خفض_مسير = أ;
                ليكن ب_المقارن: متغير قيمة_خفض_مسير = ب;
                إذا (هل_نوع_بدائي_للخفض(الأنواع, أ.النوع, نوع_بدائي_مقنن.حرف())) {
                    طابق اخفض_حرف_إلى_قيمته_العددية_مسير(البرنامج, الحالة, النطاق, أ, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { أ_المقارن := القيمة; }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                    طابق اخفض_حرف_إلى_قيمته_العددية_مسير(البرنامج, الحالة, النطاق, ب, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { ب_المقارن := القيمة; }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                };
                إذا (هل_نوع_مؤشر_للخفض(الأنواع, أ_المقارن.النوع)) {
                    // Pointer identity uses the existing typed equality
                    // operation, never a pointer-to-integer conversion.
                    إذا (!مساواة) {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    };
                } وإلا {
                    طابق وصف_صحيح_للخفض(الأنواع, أ_المقارن.النوع) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                    }
                    | اختياري.موجود(_) -> { };
                };
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_مقارنة_صحيح_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        المقارنة,
                        أ_المقارن.المعرف,
                        ب_المقارن.المعرف,
                        النوع
                    ),
                    النوع
                );
            }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
        };
    };
}

// The `أحادي` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_أحادي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.أحادي(النطاق, العامل, صندوق_الداخل) -> {
        ليكن الداخل: تعبير = *صندوق_الداخل;
        طابق العامل مع
        | عامل_أحادي.عنوان -> {
            // `&e` of a temporary (a call argument; see يسمح_بعنوان_مؤقت_داخلي):
            // e's value is stored in a fresh slot the block owns, and the
            // argument borrows the slot.
            إذا (!هل_تعبير_موضع_دلالي(&الداخل)) {
                أرجع اخفض_عنوان_مؤقت_إلى_مسير(
                    البرنامج, الحالة, النطاق, &الداخل, النوع, الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            };
            طابق خفض_مكان_إلى_مسير(
                البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_مكان.مكان(المكان) -> {
                أرجع اخفض_مرجع_مكان_مقنن(البرنامج, الحالة, المكان, النوع);
            };
        }
        | عامل_أحادي.عنوان_متغير -> {
            طابق خفض_مكان_إلى_مسير(
                البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_مكان.مكان(المكان) -> {
                أرجع اخفض_مرجع_مكان_مقنن(البرنامج, الحالة, المكان, النوع);
            };
        }
        | عامل_أحادي.فك -> {
            أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
                البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        }
        | _ -> { };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &الداخل,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(الداخل_قيمة) -> {
            طابق العامل مع
            | عامل_أحادي.سالب -> {
                إذا (هل_نوع_عشري_للخفض(الأنواع, النوع)) {
                    // -x is -0.0 - x: the IEEE negation of every non-NaN
                    // value, zeros included (0.0 - x gave +0 for -(+0)).
                    ليكن صفر_بايتات: متجه ط8 = بايتات_من_نص(«-0.0»);
                    ليكن صفر_نتيجة: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(البرنامج, الحالة, النطاق, حرفي.عدد_عشري(صفر_بايتات), النوع, الأنواع);
                    طابق صفر_نتيجة مع
                    | نتيجة_خفض_تعبير.قيمة(صفر) -> {
                        ليكن حالة_عشرية: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_من_بناء_للخفض(أصدر_حسابا_عشريا_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, عملية_حساب_عشري.طرح(), صفر.المعرف, الداخل_قيمة.المعرف, النوع), النوع);
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
                };
                طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                }
                | اختياري.موجود(_) -> {
                    ليكن صفر_نتيجة: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
                        البرنامج,
                        الحالة,
                        النطاق,
                        حرفي.عدد(0),
                        النوع,
                        الأنواع
                    );
                    طابق صفر_نتيجة مع
                    | نتيجة_خفض_تعبير.قيمة(صفر) -> {
                        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_حساب_مفحوص_من_بناء_للخفض(
                            البرنامج, حالة_الإصدار.الدالة, النطاق.البداية,
                            أصدر_حسابا_صحيحا_مسير(
                                البرنامج,
                                &حالة_الإصدار.البناء,
                                حالة_الإصدار.الدالة,
                                حالة_الإصدار.الكتلة,
                                عملية_حساب_صحيح.طرح(),
                                صفر.المعرف,
                                الداخل_قيمة.المعرف,
                                النوع
                            ),
                            النوع
                        );
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                        );
                    };
                };
            }
            | عامل_أحادي.نفي -> {
                أرجع اخفض_نفي_منطقي_إلى_مسير(
                    البرنامج,
                    الحالة,
                    النطاق,
                    الداخل_قيمة,
                    النوع,
                    الأنواع
                );
            }
            | عامل_أحادي.متمم -> {
                أرجع اخفض_متمم_صحيح_إلى_مسير(
                    البرنامج, الحالة, النطاق, الداخل_قيمة, النوع, الأنواع
                );
            }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `استدعاء` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_استدعاء_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.استدعاء(النطاق, صندوق_الدالة, الحجج) -> {
        ليكن تعبير_الدالة: تعبير = مستدعى_بلا_حجج_نوع(&(*صندوق_الدالة));
        طابق تعبير_الدالة مع
        | تعبير.حقل(_, _, اسم_المنشئ) -> {
            // Constructor identity is the canonical distinction here. A qualified enum constructor
            // carries constructor identity on its field name; a function-valued record field does not.
            طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, اسم_المنشئ.النطاق) مع
            | اختياري.موجود(_) -> {
                أرجع اخفض_استدعاء_منشئ_إلى_مسير(
                    البرنامج,
                    الحالة,
                    النطاق,
                    &اسم_المنشئ,
                    &الحجج,
                    النوع,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ليكن استبدالات_النداء: متغير متجه ربط_استبدال_نوع = [];
        طابق استبدالات_نوع_استدعاء_عند(أنواع_التعبيرات, النطاق) مع
        | اختياري.موجود(القيم) -> { استبدالات_النداء := القيم; }
        | اختياري.لا_شيء -> { };
        ليكن رمز_الدالة: متغير معرف_رمز = معرف_رمز_من(0);
        طابق تعبير_الدالة مع
        | تعبير.اسم(_, الاسم) -> {
            طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
            | نتيجة.نجح(الرمز) -> {
                رمز_الدالة := الرمز;
                ليكن مباشر: متغير منطقي = خطأ;
                طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
                | اختياري.موجود(_) -> { مباشر := صواب; }
                | اختياري.لا_شيء -> {
                    طابق دالة_خفض_بمثيل_عند(دوال_الخفض, الرمز, &استبدالات_النداء) مع
                    | اختياري.موجود(_) -> { مباشر := صواب; }
                    | اختياري.لا_شيء -> { };
                };
                إذا (!مباشر) {
                    أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                        البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                        الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    );
                };
            }
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            };
        }
        | تعبير.حقل(_, _, الاسم) -> {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> {
                رمز_الدالة := الرمز;
                ليكن مباشر: متغير منطقي = خطأ;
                طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
                | اختياري.موجود(_) -> { مباشر := صواب; }
                | اختياري.لا_شيء -> {
                    طابق دالة_خفض_بمثيل_عند(دوال_الخفض, الرمز, &استبدالات_النداء) مع
                    | اختياري.موجود(_) -> { مباشر := صواب; }
                    | اختياري.لا_شيء -> { };
                };
                إذا (!مباشر) {
                    أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                        البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                        الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    );
                };
            }
            | اختياري.لا_شيء -> {
                أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                    البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            };
        }
        | _ -> {
            أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        };
        طابق أصدر_تحقق_تنسيق_خفض(
            البرنامج, الحالة, رمز_الدالة, &الحجج, الأنواع, أنواع_التعبيرات, دوال_الخفض
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // هوية البدائي تأتي حصرا من الاستعلام الدلالي المقنن في Frontend.
        // لا نشتقها من التهجئة ولا نحولها هنا إلى عقد خدمة Runtime.
        طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, رمز_الدالة) مع
        | اختياري.موجود(هوية_البدائي) -> {
            // Owned partial projections remain illegal in SSF. The private place-swap
            // intrinsic is the canonical atomic escape hatch: it never exposes a hole,
            // and lowers completely to ordinary verified MSIR place operations.
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.عنوان_دالة_سي -> {
                أرجع اخفض_عنوان_دالة_سي_مسير(
                    البرنامج, الحالة, النطاق, &الحجج, النوع, روابط_الأسماء, دوال_الخفض
                );
            }
            | هوية_بدائي_مترجم.إزالة_الأخير -> {
                أرجع اخفض_إزالة_أو_اقتطاع_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, &الحجج, النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> {
                أرجع اخفض_إزالة_أو_اقتطاع_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, &الحجج, النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            }
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                إذا ((الطول(الحجج) مثل طبيعي) != 2) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
                    );
                };
                ليكن المكان_الأول: متغير مكان_خفض_مسير;
                طابق خفض_مكان_إلى_مسير(
                    البرنامج, الحالة, &الحجج[0], الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> { المكان_الأول := المكان; };

                ليكن المكان_الثاني: متغير مكان_خفض_مسير;
                طابق خفض_مكان_إلى_مسير(
                    البرنامج, الحالة, &الحجج[1], الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> { المكان_الثاني := المكان; };

                ليكن القيمة_الأولى: متغير قيمة_خفض_مسير;
                طابق اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان_الأول) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { القيمة_الأولى := القيمة; };

                ليكن القيمة_الثانية: متغير قيمة_خفض_مسير;
                طابق اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان_الثاني) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { القيمة_الثانية := القيمة; };

                ليكن حالة_التبديل: حالة_خفض_دالة = *الحالة;
                طابق أصدر_تخزين_مسير(
                    البرنامج,
                    &حالة_التبديل.البناء,
                    حالة_التبديل.الدالة,
                    حالة_التبديل.الكتلة,
                    المكان_الأول.المعرف,
                    القيمة_الثانية.المعرف
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | _ -> { };
                طابق أصدر_تخزين_مسير(
                    البرنامج,
                    &حالة_التبديل.البناء,
                    حالة_التبديل.الدالة,
                    حالة_التبديل.الكتلة,
                    المكان_الثاني.المعرف,
                    القيمة_الأولى.المعرف
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | _ -> { };
                // An exchange moves nothing out: each owner the two places
                // belong to holds a value again after it.
                ليكن ف_التبديل: متغير طبيعي = 0;
                طالما (ف_التبديل < 2) {
                    طابق رمز_جذر_مالك_للخفض(&الحجج[ف_التبديل], روابط_الأسماء) مع
                    | اختياري.موجود(رمز_الجذر) -> {
                        طابق أصدر_ملكية_محلي_خفض(البرنامج, الحالة, رمز_الجذر, حدث_ملكية_مسير.تهيئة()) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    ف_التبديل := ف_التبديل + 1;
                }
                أرجع نتيجة_خفض_تعبير.بلا_قيمة();
            }
            | _ -> { };

            ليكن النوع_الصفري: معرف_نوع = معرف_نوع_من(0);
            ليكن القيم_المقننة_للبدائي: متغير أنواع_استدعاء_بدائي_مقننة = {
                النص: النوع_الصفري,
                العدد: النوع_الصفري,
                عدد_ط32: النوع_الصفري,
                عدد_ط64: النوع_الصفري,
                عائم_ع32: النوع_الصفري,
                عائم_ع64: النوع_الصفري,
                عدد_طبيعي: النوع_الصفري
            };
            طابق أنواع_استدعاء_بدائي_مقننة_من_سجل(الأنواع) مع
            | اختياري.موجود(القيم) -> { القيم_المقننة_للبدائي := القيم; }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
            };
            ليكن قيم_الحجج_البدائية: متغير متجه معرف_قيمة_مسير = [];
            ليكن أنواع_الحجج_البدائية: متغير متجه معرف_نوع = [];
            ليكن نطاقات_الذاكرة_البدائية: متغير متجه نطاق_ذاكرة_نداء_مسير = [];
            ليكن مكان_تعديل_البدائي: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            ليكن ف_بدائي: متغير طبيعي = 0;
            طالما (ف_بدائي < (الطول(الحجج) مثل طبيعي)) {
                ليكن مرجع_الحجة_البدائية: &تعبير = &الحجج[ف_بدائي];
                ليكن الحجة_البدائية: تعبير = *مرجع_الحجة_البدائية;

                // البدائيات المعدلة لقيمة تحتاج مكان lvalue المقنن إضافة إلى قيمة الحجة.
                // هذا يبقي المفسر والخلفيات على نفس موضع التعديل دون إعادة بناء الهوية.
                ليكن حجة_تعديل_بدائي: متغير منطقي = خطأ;
                طابق هوية_البدائي مع
                | هوية_بدائي_مترجم.إلحاق -> { حجة_تعديل_بدائي := ف_بدائي == 0; }
                | هوية_بدائي_مترجم.حجز_سعة_متجه -> { حجة_تعديل_بدائي := ف_بدائي == 0; }
                | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { حجة_تعديل_بدائي := ف_بدائي == 0; }
                | _ -> { };
                إذا (حجة_تعديل_بدائي) {
                    طابق خفض_مكان_إلى_مسير(
                        البرنامج, الحالة, &الحجة_البدائية, الأنواع,
                        أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    ) مع
                    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_مكان.مكان(المكان) -> {
                        مكان_تعديل_البدائي := اختياري.موجود(المكان.المعرف);
                    };
                };

                طابق خفض_تعبير_إلى_مسير(
                    البرنامج,
                    الحالة,
                    &الحجة_البدائية,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                    );
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة_المقروءة) -> {
                    // An appended element is owned by the vector.
                    ليكن قيمة_الحجة: متغير قيمة_خفض_مسير = قيمة_الحجة_المقروءة;
                    طابق هوية_البدائي مع
                    // The address of a closure keeps one reference of its own
                    // (the thread that runs it); the operand keeps its own.
                    | هوية_بدائي_مترجم.عنوان_دالة -> {
                        طابق احتفظ_بقراءة_معدودة_خفض(
                            البرنامج, الحالة, &الحجة_البدائية, قيمة_الحجة_المقروءة,
                            الأنواع, روابط_الأسماء, دوال_الخفض
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> { قيمة_الحجة := المحتفظة; }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                    }
                    | هوية_بدائي_مترجم.إلحاق -> {
                        إذا (ف_بدائي == 1) {
                            طابق احتفظ_بقراءة_معدودة_خفض(
                                البرنامج, الحالة, &الحجة_البدائية, قيمة_الحجة_المقروءة,
                                الأنواع, روابط_الأسماء, دوال_الخفض
                            ) مع
                            | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> { قيمة_الحجة := المحتفظة; }
                            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                            | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                        };
                    }
                    | _ -> { };
                    ليكن القيمة_المقننة: متغير قيمة_خفض_مسير = قيمة_الحجة;
                    طابق نوع_حجة_بدائية_متوقعة(
                        الأنواع,
                        &القيم_المقننة_للبدائي,
                        هوية_البدائي,
                        ف_بدائي,
                        &أنواع_الحجج_البدائية
                    ) مع
                    | اختياري.موجود(النوع_المتوقع) -> {
                        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                            البرنامج,
                            الحالة,
                            نطاق_تعبير(&الحجة_البدائية),
                            قيمة_الحجة,
                            النوع_المتوقع,
                            الأنواع
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                            القيمة_المقننة := القيمة;
                        }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                        }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> {
                            أرجع نتيجة_خفض_تعبير.مرفوض(
                                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                            );
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    طابق هوية_البدائي مع
                    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                        طابق معرف_نوع_أساس_عند(الأنواع, قيمة_الحجة.النوع) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(مرجع_النوع_32) -> {
                            طابق (*الأنواع).الأنواع[مرجع_النوع_32.القيمة] مع
                            | نوع_مقنن.مرجع(العنصر, مرجع_متغير) -> {
                                // The mutable inner wrapper has its own canonical
                                // Type identity; resolve it from the shared registry.
                                ليكن معرف_عنصر: متغير معرف_نوع = العنصر;
                                إذا (مرجع_متغير) {
                                    طابق معرف_نوع_مغلف_متغير_موجود(الأنواع, العنصر) مع
                                    | اختياري.موجود(المعرف) -> { معرف_عنصر := المعرف; }
                                    | اختياري.لا_شيء -> {
                                        أرجع نتيجة_خفض_تعبير.مرفوض(
                                            خطأ_خفض_مسير.نوع_غير_محلول(نطاق_تعبير(&الحجة_البدائية))
                                        );
                                    };
                                };
                                ليكن نوع_المؤشر: معرف_نوع;
                                طابق معرف_نوع_مؤشر_مقنن_موجود(الأنواع, معرف_عنصر) مع
                                | اختياري.موجود(المعرف) -> { نوع_المؤشر := المعرف; }
                                | اختياري.لا_شيء -> {
                                    أرجع نتيجة_خفض_تعبير.مرفوض(
                                        خطأ_خفض_مسير.نوع_غير_محلول(نطاق_تعبير(&الحجة_البدائية))
                                    );
                                };
                                طابق اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                                    البرنامج, الحالة, نطاق_تعبير(&الحجة_البدائية), قيمة_الحجة, نوع_المؤشر, الأنواع
                                ) مع
                                | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                                    القيمة_المقننة := القيمة;
                                }
                                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                                }
                                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                                    أرجع نتيجة_خفض_تعبير.مرفوض(
                                        خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                                    );
                                };
                            }
                            | _ -> { };
                        };
                        // A machine pointer is not evidence of storage. Only a
                        // directly converted, typed reference is eligible.
                        إذا (!قيمتا_مسير_متساويتان(قيمة_الحجة.المعرف, القيمة_المقننة.المعرف)) {
                            طابق انشئ_نطاق_ذاكرة_حجة_خام(
                                البرنامج, الحالة, الأنواع,
                                القيم_المقننة_للبدائي.عدد_ط64, ف_بدائي,
                                قيمة_الحجة, القيمة_المقننة
                            ) مع
                            | اختياري.موجود(النطاق) -> {
                                ألحق(نطاقات_الذاكرة_البدائية, النطاق);
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ألحق(قيم_الحجج_البدائية, القيمة_المقننة.المعرف);
                    ألحق(أنواع_الحجج_البدائية, القيمة_المقننة.النوع);
                };
                ف_بدائي := ف_بدائي + 1;
            }

            ليكن عقد_النواة_البدائية: متغير اختياري عقد_نواة_مسير = اختياري.لا_شيء();
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                إذا ((الطول(الحجج) مثل طبيعي) == 7 &&
                    (الطول(قيم_الحجج_البدائية) مثل طبيعي) == 7) {
                    طابق عقد_عملية_لينكس_من_تعبير(
                        &الحجج[0], قيم_الحجج_البدائية[0], روابط_الأسماء, دوال_الخفض
                    ) مع
                    | اختياري.موجود(العقد) -> {
                        إذا (أكمل_عقد_ذاكرة_نداء_لينكس(
                            البرنامج, الحالة, القيم_المقننة_للبدائي.عدد_ط64,
                            العقد, &قيم_الحجج_البدائية, &متغير نطاقات_الذاكرة_البدائية
                        )) { عقد_النواة_البدائية := اختياري.موجود(العقد); };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            // Wrapping arithmetic primitives are the non-trapping MSIR operations.
            طابق عملية_بدائي_ملتف_للخفض(هوية_البدائي) مع
            | اختياري.موجود(العملية_الملتفة) -> {
                إذا ((الطول(قيم_الحجج_البدائية) مثل طبيعي) != 2) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
                };
                أرجع اخفض_حسابا_ملتفا_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, العملية_الملتفة,
                    قيم_الحجج_البدائية[0], قيم_الحجج_البدائية[1], أنواع_الحجج_البدائية[0], الأنواع
                );
            }
            | اختياري.لا_شيء -> { };
            ليكن حالة_النداء_البدائي: حالة_خفض_دالة = *الحالة;
            ليكن نوع_ناتج_البدائي: متغير اختياري معرف_نوع = اختياري.موجود(النوع);
            إذا (هل_نوع_فراغ_للخفض(الأنواع, النوع)) {
                نوع_ناتج_البدائي := اختياري.لا_شيء();
            };
            ليكن نتيجة_النداء_البدائي: نتيجة_بناء_قيمة_مسير;
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                نتيجة_النداء_البدائي := أصدر_نداء_بدائي_بوصف_ذاكرة_مسير(
                    البرنامج, &حالة_النداء_البدائي.البناء,
                    حالة_النداء_البدائي.الدالة, حالة_النداء_البدائي.الكتلة,
                    هوية_البدائي, &قيم_الحجج_البدائية,
                    نوع_ناتج_البدائي, مكان_تعديل_البدائي,
                    &نطاقات_الذاكرة_البدائية, عقد_النواة_البدائية
                );
            }
            | _ -> {
                نتيجة_النداء_البدائي := أصدر_نداء_بدائي_مسير(
                    البرنامج, &حالة_النداء_البدائي.البناء,
                    حالة_النداء_البدائي.الدالة, حالة_النداء_البدائي.الكتلة,
                    هوية_البدائي, &قيم_الحجج_البدائية,
                    نوع_ناتج_البدائي, مكان_تعديل_البدائي
                );
            };
            // طول and استنساخ read their operand without consuming it. A call
            // result passed straight to them has no other owner (C5).
            ليكن بدائي_قارئ: متغير منطقي = خطأ;
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.طول -> { بدائي_قارئ := صواب; }
            | هوية_بدائي_مترجم.استنساخ -> { بدائي_قارئ := صواب; }
            | _ -> { };
            إذا (بدائي_قارئ && (الطول(الحجج) مثل طبيعي) == 1
                && (الطول(قيم_الحجج_البدائية) مثل طبيعي) == 1) {
                إذا (هل_أصل_مؤقت_للخفض(&الحجج[0])) {
                    طابق نتيجة_النداء_البدائي مع
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { }
                    | _ -> {
                        طابق أسقط_قيمة_خفض(
                            البرنامج, الحالة, قيم_الحجج_البدائية[0],
                            أنواع_الحجج_البدائية[0], الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
            طابق نوع_ناتج_البدائي مع
            | اختياري.موجود(_) -> {
                أرجع قيمة_من_بناء_للخفض(نتيجة_النداء_البدائي, النوع);
            }
            | اختياري.لا_شيء -> {
                طابق نتيجة_النداء_البدائي مع
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                    );
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
            };
        }
        | اختياري.لا_شيء -> { };

        طابق دالة_خفض_بمثيل_عند(دوال_الخفض, رمز_الدالة, &استبدالات_النداء) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_الدالة)
            );
        }
        | اختياري.موجود(ربط_الدالة) -> {
            // A `@@track_caller` function: the Type pass took one argument
            // fewer, its location, which is added below (caller_location.sn).
            ليكن موقع_المستدعي: متغير منطقي = خطأ;
            طابق ربط_الدالة.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_المتتبعة) -> {
                موقع_المستدعي := دالة_تتبع_مستدع_خفض(دوال_الخفض, معرف_المتتبعة)
                    && (الطول(الحجج) مثل طبيعي) + 1 == (الطول(ربط_الدالة.المعاملات) مثل طبيعي);
            }
            | _ -> { };
            إذا (!موقع_المستدعي && (الطول(الحجج) مثل طبيعي)
                != (الطول(ربط_الدالة.المعاملات) مثل طبيعي)) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
                );
            };
            ليكن قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                ليكن مرجع_الحجة: &تعبير = &الحجج[ف];
                ليكن الحجة: تعبير = *مرجع_الحجة;
                طابق خفض_تعبير_مملوكا_إلى_مسير(
                    البرنامج,
                    الحالة,
                    &الحجة,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة))
                    );
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة) -> {
                    ليكن المتوقع: معرف_نوع = ربط_الدالة.المعاملات[ف];
                    طابق امتلك_متجها_معروضا_خفض(
                        البرنامج, الحالة, &الحجة, قيمة_الحجة, المتوقع, الأنواع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                        البرنامج,
                        الحالة,
                        نطاق_تعبير(&الحجة),
                        قيمة_الحجة,
                        المتوقع,
                        الأنواع
                    ) مع
                    | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                        ألحق(قيم_الحجج, القيمة_المقننة.المعرف);
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة))
                        );
                    };
                };
                ف := ف + 1;
            }
            ليكن حالة_النداء: حالة_خفض_دالة = *الحالة;
            إذا (موقع_المستدعي) {
                طابق ربط_الدالة.الهدف مع
                | هدف_دالة_خفض.داخلية(معرف_المتتبعة) -> {
                    طابق حجة_موقع_المستدعي_خفض(
                        البرنامج, &حالة_النداء.البناء, حالة_النداء.الدالة, حالة_النداء.الكتلة,
                        الأنواع, دوال_الخفض, معرف_المتتبعة, النطاق.البداية
                    ) مع
                    | اختياري.موجود(قيمة_الموقع) -> { ألحق(قيم_الحجج, قيمة_الموقع); }
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
                    };
                }
                | _ -> { };
            };
            ليكن نتيجة_النداء: متغير نتيجة_بناء_قيمة_مسير = نتيجة_بناء_قيمة_مسير.بلا_قيمة();
            طابق ربط_الدالة.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                نتيجة_النداء := أصدر_نداء_مسير(
                    البرنامج,
                    &حالة_النداء.البناء,
                    حالة_النداء.الدالة,
                    حالة_النداء.الكتلة,
                    معرف_الدالة,
                    &قيم_الحجج
                );
            }
            | هدف_دالة_خفض.خارجية(معرف_الخارجية) -> {
                نتيجة_النداء := أصدر_نداء_خارجي_مسير(
                    البرنامج,
                    &حالة_النداء.البناء,
                    حالة_النداء.الدالة,
                    حالة_النداء.الكتلة,
                    معرف_الخارجية,
                    &قيم_الحجج
                );
            };
            طابق ربط_الدالة.الناتج مع
            | اختياري.موجود(نوع_الناتج) -> {
                إذا (!معرفا_نوع_متساويان(نوع_الناتج, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                أرجع قيمة_من_بناء_للخفض(نتيجة_النداء, النوع);
            }
            | اختياري.لا_شيء -> {
                طابق نتيجة_النداء مع
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                    );
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `تسلسل_وقت_الترجمة` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_تسلسل_وقت_الترجمة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.تسلسل_وقت_الترجمة(النطاق, التعابير) -> {
        ليكن الأخير: متغير اختياري قيمة_خفض_مسير = اختياري.لا_شيء();
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &التعابير[ف], الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                ليكن المعرف: معرف_قيمة_مسير = القيمة.المعرف;
                ليكن د: طبيعي = المعرف.الدالة.القيمة;
                ليكن وجد: متغير منطقي = خطأ;
                ليكن ك: متغير طبيعي = 0;
                طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
                    ليكن ت: متغير طبيعي = 0;
                    طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                        طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                        | اختياري.موجود(موجود) -> {
                            إذا (قيمتا_مسير_متساويتان(موجود.المعرف, المعرف)) {
                                إذا (قيمة_تشغيل_في_وقت_الترجمة_للخفض(&(*البرنامج).الدوال[د], المعرف, 0)) {
                                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق));
                                };
                                (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                                وجد := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        ت := ت + 1;
                    }
                    ك := ك + 1;
                }
                إذا (!وجد) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق));
                };
                الأخير := اختياري.موجود(القيمة);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق));
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
            ف := ف + 1;
        }
        طابق الأخير مع
        | اختياري.موجود(القيمة) -> { أرجع نتيجة_خفض_تعبير.قيمة(القيمة); }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)); };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `وقت_الترجمة` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_وقت_الترجمة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.وقت_الترجمة(النطاق, المملوك) -> {
        // A simple literal can be resolved before all functions have bodies.
        // All other typed expressions are lowered into canonical MSIR and
        // marked for mandatory bounded interpretation at the driver boundary.
        ليكن الداخل: تعبير = *المملوك;
        طابق قيم_تعبير_ثابت_للخفض(
            &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        ) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(الثابت) -> {
            ليكن البناء: حالة_خفض_دالة = *الحالة;
            ليكن الناتج: نتيجة_بناء_قيمة_مسير = أصدر_ثابتا_مسير(
                البرنامج, &البناء.البناء, البناء.الدالة, البناء.الكتلة, الثابت, النوع
            );
            أرجع قيمة_من_بناء_للخفض(الناتج, النوع);
        }
        | نتيجة_تقييم_ثابت_خفض.فخ -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تقييم_ثابت_بفخ(النطاق));
        }
        | _ -> { };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            ليكن المعرف: معرف_قيمة_مسير = القيمة.المعرف;
            ليكن د: طبيعي = المعرف.الدالة.القيمة;
            ليكن ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
                ليكن ت: متغير طبيعي = 0;
                طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                    طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت]) مع
                    | اختياري.موجود(موجود) -> {
                        إذا (قيمتا_مسير_متساويتان(موجود.المعرف, المعرف)) {
                            إذا (قيمة_تشغيل_في_وقت_الترجمة_للخفض(&(*البرنامج).الدوال[د], المعرف, 0)) {
                                أرجع نتيجة_خفض_تعبير.مرفوض(
                                    خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)
                                );
                            };
                            (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                            أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
            // A compile-time parameter used as the whole expression: every
            // specialized copy defines it as a constant, and the template
            // itself never runs (driver/compile_time.sn).
            إذا (قيمة_معامل_وقت_ترجمة_للخفض(&(*البرنامج).الدوال[د], المعرف)) {
                أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
            };
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)
            );
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)
            );
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        };
    }
    // A vector literal expression is a fresh owned vector (a temporary, like
    // a call result): its elements are moved in, in order, and the value goes
    // to its consumer; drops.sn treats it as a temporary where it is read.
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `حرفي_متجه` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_حرفي_متجه_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي_متجه(النطاق, العناصر) -> {
        ليكن نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(القيمة_النوعية) -> { نوع_العنصر := القيمة_النوعية; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
        };
        ليكن القيم: متغير متجه معرف_قيمة_مسير = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            ليكن مرجع_العنصر: &تعبير = &العناصر[ف];
            طابق خفض_تعبير_مملوكا_إلى_مسير(
                البرنامج, الحالة, مرجع_العنصر, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_العنصر)));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_العنصر) -> {
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, نطاق_تعبير(مرجع_العنصر), قيمة_العنصر, نوع_العنصر, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(القيم, المقننة.المعرف); }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_العنصر)));
                };
            };
            ف := ف + 1;
        }
        ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تهيئة_متجه_مسير(
                البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة, &القيم, النوع
            ),
            النوع
        );
    }
    // A callee with explicit type arguments read as a value: the callee.
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}

// The `تحويل` arm of خفض_تعبير_دون_مصدر_إلى_مسير, in a function of its own
// so that its locals occupy the stack only while it runs: every nested
// expression recurses through the dispatcher, whose frame held the locals of
// all its arms at once (35-49 KB a level, a stack overflow on deep chains).
عرف خفض_تعبير_تحويل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    ليكن القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.تحويل(النطاق, صندوق_المصدر, _) -> {
        ليكن المصدر: تعبير = *صندوق_المصدر;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &المصدر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المصدر) -> {
            إذا (معرفا_نوع_متساويان(قيمة_المصدر.النوع, النوع)) {
                أرجع نتيجة_خفض_تعبير.قيمة(قيمة_المصدر);
            };
            // A byte vector moved into text (its buffer changes owner; nothing
            // is copied). Not the reverse: a text literal's buffer is static
            // data, which a vector would grow in place.
            إذا (هل_نقل_متجه_بايتات_إلى_نص(الأنواع, قيمة_المصدر.النوع, النوع)) {
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_نقل_تسلسل_مملوك_مسير(
                        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة, قيمة_المصدر.المعرف, النوع
                    ), النوع
                );
            };
            // A raw pointer read as its address (`p as u64`), or an address taken as a raw pointer (`a as
            // *T`, inside unsafe): the word itself.
            // A raw pointer taken as another raw pointer (`p as *void`,
            // `p as *mutable T`, inside unsafe): the same word.
            إذا ((هل_مؤشر_خام_للخفض(الأنواع, قيمة_المصدر.النوع) && هل_نوع_عنوان_صحيح_للخفض(الأنواع, النوع))
                || (هل_نوع_عنوان_صحيح_للخفض(الأنواع, قيمة_المصدر.النوع) && هل_مؤشر_خام_للخفض(الأنواع, النوع))
                || (هل_مؤشر_خام_للخفض(الأنواع, قيمة_المصدر.النوع) && هل_مؤشر_خام_للخفض(الأنواع, النوع))) {
                ليكن حالة_العنوان: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_مرجع_إلى_مؤشر_مسير(
                        البرنامج, &حالة_العنوان.البناء, حالة_العنوان.الدالة, حالة_العنوان.الكتلة,
                        قيمة_المصدر.المعرف, النوع
                    ),
                    النوع
                );
            };
            // A raw pointer read as a reference (`p as &T`, inside unsafe).
            إذا (هل_تحويل_مؤشر_إلى_مرجع_لمسير(الأنواع, قيمة_المصدر.النوع, النوع)) {
                أرجع اخفض_تحويل_مؤشر_إلى_مرجع_مسير(
                    البرنامج, الحالة, قيمة_المصدر, النوع
                );
            };
            طابق وصف_تحويل_صحيح_بين(الأنواع, قيمة_المصدر.النوع, النوع) مع
            | اختياري.لا_شيء -> {
                طابق عملية_تحويل_حرف_إلى_صحيح_للخفض(
                    الأنواع, قيمة_المصدر.النوع, النوع
                ) مع
                | اختياري.موجود(العملية) -> {
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_صحيح_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            العملية,
                            قيمة_المصدر.المعرف,
                            النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                طابق عملية_تحويل_بايت_إلى_حرف_للخفض(
                    الأنواع, قيمة_المصدر.النوع, النوع
                ) مع
                | اختياري.موجود(العملية) -> {
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_صحيح_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
                            العملية, قيمة_المصدر.المعرف, النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                طابق عملية_تحويل_عائم_للخفض(الأنواع, قيمة_المصدر.النوع, النوع) مع
                | اختياري.موجود(العملية) -> {
                    ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_عائم_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
                            العملية, قيمة_المصدر.المعرف, النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                أرجع اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                    البرنامج, الحالة, النطاق, قيمة_المصدر, النوع, الأنواع
                );
            }
            | اختياري.موجود(الوصف) -> {
                ليكن العملية: عملية_تحويل_صحيح = عملية_تحويل_صحيح_من_وصف_للخفض(الوصف);
                ليكن حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_تحويل_صحيح_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        العملية,
                        قيمة_المصدر.المعرف,
                        النوع
                    ),
                    النوع
                );
            };
        };
    }
    | _ -> { };
    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
}


عرف هل_مؤشر_خام_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف هل_نوع_عنوان_صحيح_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ط64 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص64 -> { أرجع صواب; }
            // `0 as *T` (a C NULL): an untyped literal is عدد.
            | نوع_بدائي_مقنن.عدد -> { أرجع صواب; }
            | نوع_بدائي_مقنن.طبيعي -> { أرجع صواب; }
            // The address word of a 32-bit target (`p as u32`); the
            // frontend rejects it where pointers are wider.
            | نوع_بدائي_مقنن.ط32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص32 -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}
