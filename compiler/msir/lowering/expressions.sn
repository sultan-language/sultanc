استورد compiler.frontend.types.type_context;
// خفض التعبيرات وقلب الاجتياز التكراري للتعبير.
// Inspect the already-emitted SSA place rather than lowering a source index a
// second time. Re-evaluating an index or vector expression could duplicate
// side effects and would no longer describe the pointer passed to the kernel.
// Locate the already emitted SSA definition across blocks. A borrow can be
// constructed in an earlier block and forwarded to the syscall block; never
// evaluate the source expression again just to recover its provenance.
عرف عملية_تعريف_حجة_نداء_خام(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    المعرف: معرف_قيمة_مسير
): اختياري عملية_مسير {
    دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    دع فهرس_كتلة: متغير طبيعي = 0;
    طالما (فهرس_كتلة < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[فهرس_كتلة];
        دع فهرس_تعليمة: متغير طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
        طالما (فهرس_تعليمة > 0) {
            فهرس_تعليمة := فهرس_تعليمة - 1;
            دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[فهرس_تعليمة];
            طابق (*التعليمة).الناتج مع
            | اختياري.موجود(القيمة) -> {
                لو (قيمتا_مسير_متساويتان(القيمة.المعرف, المعرف)) {
                    دع مرجع_العملية: &عملية_مسير = &(*التعليمة).العملية;
                    دع العملية: عملية_مسير = انسخ_مملوكا_عملية_مسير(مرجع_العملية);
                    أرجع اختياري.موجود(العملية);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        فهرس_كتلة := فهرس_كتلة + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A source witness requires BOTH resolved canonical declarations: the Linux
// target selector and its exact enum constructor. Neither spelling, a number,
// nor the caller's module grants an operation identity.
عرف رمز_هدف_تعبير_نداء_لينكس(
    التعبير: &تعبير,
    الروابط: &سياق_روابط_أسماء
): اختياري معرف_رمز {
    طابق *التعبير مع
    | تعبير.اسم(_, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | تعبير.حقل(_, _, الاسم) -> { أرجع رمز_اسم_محلول_عند(الروابط, الاسم.النطاق); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عقد_عملية_لينكس_من_تعبير(
    المصدر: &تعبير,
    الرقم: معرف_قيمة_مسير,
    الروابط: &سياق_روابط_أسماء,
    الدوال: &سياق_دوال_خفض
): اختياري عقد_نواة_مسير {
    دع منتقي: معرف_رمز;
    طابق (*الدوال).منتقي_لينكس مع
    | اختياري.موجود(الرمز) -> { منتقي := الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع تعبير_المنتقي: تعبير;
    دع حجج_المنتقي: متجه تعبير;
    طابق *المصدر مع
    | تعبير.استدعاء(_, الهدف, الحجج) -> {
        تعبير_المنتقي := *الهدف;
        حجج_المنتقي := الحجج;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    لو ((الطول(حجج_المنتقي) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
    طابق رمز_هدف_تعبير_نداء_لينكس(&تعبير_المنتقي, الروابط) مع
    | اختياري.موجود(الرمز) -> {
        لو (!معرفا_رمز_متساويان(منتقي, الرمز)) { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع تعبير_المنشئ: تعبير;
    دع حجج_المنشئ: متجه تعبير;
    طابق حجج_المنتقي[0] مع
    | تعبير.استدعاء(_, الهدف, الحجج) -> {
        تعبير_المنشئ := *الهدف;
        حجج_المنشئ := الحجج;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    لو (الطول(حجج_المنشئ) != 0) { أرجع اختياري.لا_شيء(); };
    دع رمز_المنشئ: معرف_رمز;
    طابق رمز_هدف_تعبير_نداء_لينكس(&تعبير_المنشئ, الروابط) مع
    | اختياري.موجود(الرمز) -> { رمز_المنشئ := الرمز; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدوال).منشئات_لينكس) مثل طبيعي)) {
        لو (معرفا_رمز_متساويان((*الدوال).منشئات_لينكس[ف].الرمز, رمز_المنشئ)) {
            دع الهدف: معرف_دالة_مسير;
            طابق دالة_خفض_عند(الدوال, منتقي) مع
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_دالة_خفض.داخلية(المعرف) -> { الهدف := المعرف; }
                | _ -> { أرجع اختياري.لا_شيء(); };
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            دع العقد: عقد_نواة_مسير = {
                المنشئ: رمز_المنشئ,
                الترتيب: (*الدوال).منشئات_لينكس[ف].الترتيب,
                المنتقي: الهدف, الرقم: الرقم
            };
            أرجع اختياري.موجود(العقد);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Attach only complete, canonical contracts. Missing pointer provenance or an
// unsupported operation leaves the raw syscall untrusted (Interpreter rejects).
عرف أكمل_عقد_ذاكرة_نداء_لينكس(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    نوع_ط64: معرف_نوع,
    العقد: عقد_نواة_مسير,
    الحجج: &متجه معرف_قيمة_مسير,
    النطاقات: &متغير متجه نطاق_ذاكرة_نداء_مسير
): منطقي {
    دع توقيع_موثق: متغير اختياري توقيع_نداء_بدائي = اختياري.لا_شيء();
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*البرنامج).أصول_النواة) مثل طبيعي)) {
        دع الأصل: &مصدر_عقد_نواة_مسير = &(*البرنامج).أصول_النواة[م];
        لو (معرفا_رمز_متساويان((*الأصل).المنشئ, العقد.المنشئ)
            && (*الأصل).الترتيب == العقد.الترتيب
            && (*الأصل).المنتقي.القيمة == العقد.المنتقي.القيمة) {
            // Copy the authenticated signature through the borrow.
            دع مرجع_التوقيع: &توقيع_نداء_بدائي = &(*الأصل).التوقيع;
            دع التوقيع_المنسوخ: توقيع_نداء_بدائي = انسخ_مملوكا_توقيع_نداء_بدائي(مرجع_التوقيع);
            توقيع_موثق := اختياري.موجود(التوقيع_المنسوخ);
        };
        م := م + 1;
    }
    دع التوقيع: توقيع_نداء_بدائي;
    طابق توقيع_موثق مع
    | اختياري.موجود(الموثق) -> { التوقيع := الموثق; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    لو (الطول(*الحجج) != 7 || الطول(التوقيع.الأدوار) != 6) { أرجع خطأ; };
    دع الموضع: متغير طبيعي = 1;
    طالما (الموضع <= 6) {
        دع مطابق: متغير طبيعي = 0;
        دع موضع_النطاق: متغير طبيعي = 0;
        طالما (موضع_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
            لو ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                مطابق := مطابق + 1;
            };
            موضع_النطاق := موضع_النطاق + 1;
        }
        طابق التوقيع.الأدوار[الموضع - 1] مع
        | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
            لو (مطابق != 1) { أرجع خطأ; };
            موضع_النطاق := 0;
            طالما (موضع_النطاق < (الطول(*النطاقات) مثل طبيعي)) {
                لو ((*النطاقات)[موضع_النطاق].فهرس_الحجة == الموضع) {
                    دع النطاق: متغير نطاق_ذاكرة_نداء_مسير = (*النطاقات)[موضع_النطاق];
                    طابق الاتجاه مع
                    | اتجاه_وصول_بدائي.قراءة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.قراءة(); }
                    | اتجاه_وصول_بدائي.كتابة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.كتابة(); }
                    | اتجاه_وصول_بدائي.قراءة_وكتابة -> { النطاق.الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
                    طابق الحد مع
                    | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                        لو (الفهرس == 0 || الفهرس > 6) { أرجع خطأ; };
                        النطاق.المطلوب := اختياري.موجود((*الحجج)[الفهرس]);
                    }
                    | حد_وصول_بدائي.سلسلة_صفرية -> {
                        // Bound search for NUL to the verified allocation extent.
                        النطاق.المطلوب := اختياري.موجود(النطاق.الطول);
                    }
                    | حد_وصول_بدائي.ثابت(العدد) -> {
                        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        طابق أصدر_ثابتا_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة, ثابت_مسير.صحيح_طبيعي(العدد), نوع_ط64
                        ) مع
                        | نتيجة_بناء_قيمة_مسير.مبنية(القيمة) -> { النطاق.المطلوب := اختياري.موجود(القيمة); }
                        | _ -> { أرجع خطأ; };
                    };
                    (*النطاقات)[موضع_النطاق] := النطاق;
                };
                موضع_النطاق := موضع_النطاق + 1;
            }
        }
        | دور_وسيطة_بدائي.عدد -> {
            لو (مطابق != 0) { أرجع خطأ; };
        }
        | دور_وسيطة_بدائي.غير_مستخدم -> {
            لو (مطابق != 0) { أرجع خطأ; };
        };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

// Raw syscall buffers may borrow an indexed fixed-width integer vector.
// Floating-point and pointer vectors are not given opaque byte semantics.
عرف حجم_عنصر_متجه_عدد_نداء_خام(
    الأنواع: &سجل_أنواع, النوع: معرف_نوع
): اختياري طبيعي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مرجع_النوع_29) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_29.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
        طابق البدائي مع
        | نوع_بدائي_مقنن.ص8 -> { أرجع اختياري.موجود(1); }
        | نوع_بدائي_مقنن.ط8 -> { أرجع اختياري.موجود(1); }
        | نوع_بدائي_مقنن.ص16 -> { أرجع اختياري.موجود(2); }
        | نوع_بدائي_مقنن.ط16 -> { أرجع اختياري.موجود(2); }
        | نوع_بدائي_مقنن.ص32 -> { أرجع اختياري.موجود(4); }
        | نوع_بدائي_مقنن.ط32 -> { أرجع اختياري.موجود(4); }
        | نوع_بدائي_مقنن.ص64 -> { أرجع اختياري.موجود(8); }
        | نوع_بدائي_مقنن.ط64 -> { أرجع اختياري.موجود(8); }
        | _ -> { };
    }
        | _ -> { };
    };
    أرجع اختياري.لا_شيء();
}

// Distinguish an indexed integer buffer from a scalar element. Failure to compute
// its dynamic extent must never silently turn it into a one-byte descriptor.
عرف هل_مرجع_عنصر_متجه_بايتات_نداء_خام(
    البرنامج: &برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    الأصل: معرف_قيمة_مسير
): منطقي {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, الأصل) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المرجع)) -> { مكان_العنصر := المرجع.المكان; }
    | _ -> { أرجع خطأ; };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(الموضع)) -> { مكان_المتجه := الموضع.الأصل; }
    | _ -> { أرجع خطأ; };
    دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    لو (مكان_المتجه.القيمة >= (الطول((*الدالة).القيم) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, (*الدالة).القيم[مكان_المتجه.القيمة].النوع) مع
    | اختياري.موجود(المعرف) -> { نوع_المتجه := المعرف; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(المعرف) -> {
        طابق حجم_عنصر_متجه_عدد_نداء_خام(الأنواع, المعرف) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// A borrow of an integer-vector element carries a contiguous backing allocation.
// The accessible extent is computed from the same indexed place, not from a
// syscall number or from a guessed length argument. The interpreter must still
// check the live allocation and the range at the machine-call boundary.
عرف طول_باقي_متجه_بايتات_نداء_خام(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    الأصل: قيمة_خفض_مسير,
    نوع_ط64: معرف_نوع
): اختياري معرف_قيمة_مسير {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, الأصل.المعرف) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المرجع)) -> { مكان_العنصر := المرجع.المكان; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع مكان_المتجه: معرف_قيمة_مسير;
    دع فهرس_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_حجة_نداء_خام(البرنامج, الحالة, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(الموضع)) -> {
        مكان_المتجه := الموضع.الأصل;
        فهرس_العنصر := الموضع.الفهرس;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[(*الحالة).الدالة.القيمة];
    لو (مكان_المتجه.القيمة >= (الطول((*الدالة).القيم) مثل طبيعي)
        || فهرس_العنصر.القيمة >= (الطول((*الدالة).القيم) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع نوع_المتجه: معرف_نوع;
    طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, (*الدالة).القيم[مكان_المتجه.القيمة].النوع) مع
    | اختياري.موجود(المعرف) -> { نوع_المتجه := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع عرض_العنصر: طبيعي;
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(المعرف) -> {
        طابق حجم_عنصر_متجه_عدد_نداء_خام(الأنواع, المعرف) مع
        | اختياري.موجود(العرض) -> { عرض_العنصر := العرض; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع نوع_الفهرس: معرف_نوع = (*الدالة).القيم[فهرس_العنصر.القيمة].النوع;
    دع وصف_الفهرس: وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, نوع_الفهرس) مع
    | اختياري.موجود(الوصف) -> {
        لو (الوصف.البتات == 0 || الوصف.البتات > 64) { أرجع اختياري.لا_شيء(); };
        وصف_الفهرس := الوصف;
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع نوع_العدد: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع بناء: حالة_خفض_دالة = *الحالة;
    دع قيمة_المتجه: معرف_قيمة_مسير;
    طابق أصدر_تحميل_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        مكان_المتجه, نوع_المتجه
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_المتجه := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الحجج: متجه معرف_قيمة_مسير = [قيمة_المتجه];
    دع الطول_الموقع: معرف_قيمة_مسير;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        هوية_بدائي_مترجم.طول(), &الحجج,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الطول_الموقع := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع طول_المتجه: معرف_قيمة_مسير;
    طابق أصدر_تحويل_صحيح_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { طول_المتجه := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الفهرس_غير_الموقع: متغير معرف_قيمة_مسير = فهرس_العنصر;
    لو (!معرفا_نوع_متساويان(نوع_الفهرس, نوع_ط64)) {
        دع عملية_الفهرس: عملية_تحويل_صحيح;
        لو (وصف_الفهرس.البتات == 64) {
            عملية_الفهرس := عملية_تحويل_صحيح.إعادة_تفسير();
        } وإلا لو (وصف_الفهرس.موقع) {
            عملية_الفهرس := عملية_تحويل_صحيح.توسيع_بإشارة();
        } وإلا {
            عملية_الفهرس := عملية_تحويل_صحيح.توسيع_صفري();
        };
        طابق أصدر_تحويل_صحيح_مسير(
            البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
            عملية_الفهرس, فهرس_العنصر, نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الفهرس_غير_الموقع := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    دع باقي_العناصر: معرف_قيمة_مسير;
    طابق أصدر_حسابا_صحيحا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_حساب_صحيح.طرح(), طول_المتجه, الفهرس_غير_الموقع, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { باقي_العناصر := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    لو (عرض_العنصر == 1) { أرجع اختياري.موجود(باقي_العناصر); };
    دع حجم_العنصر: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        ثابت_مسير.صحيح_طبيعي(عرض_العنصر), نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { حجم_العنصر := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق أصدر_حسابا_صحيحا_مسير(
        البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
        عملية_حساب_صحيح.ضرب(), باقي_العناصر, حجم_العنصر, نوع_ط64
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع اختياري.موجود(المعرف); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Descriptors are derived from the *source* reference, never from a raw
// machine word. A scalar gives exactly one element; an indexed integer vector
// may provide a checked runtime maximum. Neither guesses kernel direction or
// the request's actual transfer count.
عرف انشئ_نطاق_ذاكرة_حجة_خام(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الأنواع: &سجل_أنواع,
    نوع_ط64: معرف_نوع,
    فهرس_الحجة: طبيعي,
    الأصل: قيمة_خفض_مسير,
    المؤشر: قيمة_خفض_مسير
): اختياري نطاق_ذاكرة_نداء_مسير {
    لو (فهرس_الحجة == 0) { أرجع اختياري.لا_شيء(); };
    دع عنصر: معرف_نوع;
    دع متغير_الأصل: منطقي;
    طابق معرف_نوع_أساس_عند(الأنواع, الأصل.النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مرجع_النوع_30) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_30.القيمة] مع
        | نوع_مقنن.مرجع(داخل, قابل_للكتابة) -> {
        عنصر := داخل;
        متغير_الأصل := قابل_للكتابة;
    }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    طابق معرف_نوع_أساس_عند(الأنواع, المؤشر.النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(مرجع_النوع_31) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_31.القيمة] مع
        | نوع_مقنن.مؤشر(داخل) -> {
        طابق معرف_نوع_أساس_عند(الأنواع, داخل) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مرجع_النوع_1) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
            | نوع_مقنن.بدائي(المؤشر_إليه) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, عنصر) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(مرجع_النوع_1) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
                | نوع_مقنن.بدائي(المرجع_إليه) -> {
                لو (المؤشر_إليه != المرجع_إليه) {
                    أرجع اختياري.لا_شيء();
                };
            }
                | _ -> { أرجع اختياري.لا_شيء(); };
            };
        }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
    }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    دع حجم: طبيعي;
    طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, عنصر) مع
    | اختياري.موجود(القيمة) -> { حجم := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع بناء: حالة_خفض_دالة = *الحالة;
    دع طول_النطاق: معرف_قيمة_مسير;
    لو (هل_مرجع_عنصر_متجه_بايتات_نداء_خام(
        البرنامج, الحالة, الأنواع, الأصل.المعرف
    )) {
        // The byte extent is runtime length(vector) - index, with the
        // canonical checked subtraction contract (underflow traps).
        طابق طول_باقي_متجه_بايتات_نداء_خام(
            البرنامج, الحالة, الأنواع, الأصل, نوع_ط64
        ) مع
        | اختياري.موجود(المعرف) -> { طول_النطاق := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    } وإلا {
        طابق أصدر_ثابتا_مسير(
            البرنامج, &بناء.البناء, بناء.الدالة, بناء.الكتلة,
            ثابت_مسير.صحيح_طبيعي(حجم), نوع_ط64
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { طول_النطاق := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
    دع الإذن: إذن_ذاكرة_نداء_مسير;
    لو (متغير_الأصل) {
        الإذن := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة();
    } وإلا {
        الإذن := إذن_ذاكرة_نداء_مسير.قراءة();
    };
    دع النطاق: نطاق_ذاكرة_نداء_مسير = {
        فهرس_الحجة: فهرس_الحجة,
        المؤشر: المؤشر.المعرف,
        الأصل: الأصل.المعرف,
        الطول: طول_النطاق,
        المطلوب: اختياري.لا_شيء(),
        الإذن: الإذن
    };
    أرجع اختياري.موجود(النطاق);
}

عرف خفض_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الحرفي: حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    دع حالة_القراءة: حالة_خفض_دالة = *الحالة;
    طابق الحرفي مع
    | حرفي.منطقي(القيمة) -> {
        لو (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.منطق(القيمة),
                النوع
            ),
            النوع
        );
    }
    | حرفي.عدد(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_ثابتا_مسير(
                        البرنامج,
                        &حالة_القراءة.البناء,
                        حالة_القراءة.الدالة,
                        حالة_القراءة.الكتلة,
                        ثابت_مسير.صحيح_موقع(القيمة),
                        النوع
                    ),
                    النوع
                );
            };
            لو (القيمة < 0) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            أرجع قيمة_من_بناء_للخفض(
                أصدر_ثابتا_مسير(
                    البرنامج,
                    &حالة_القراءة.البناء,
                    حالة_القراءة.الدالة,
                    حالة_القراءة.الكتلة,
                    ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي),
                    النوع
                ),
                النوع
            );
        };
    }
    | حرفي.حرف(القيمة) -> {
        لو (!هل_نوع_بدائي_للخفض(الأنواع, النوع, نوع_بدائي_مقنن.حرف())) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي),
                النوع
            ),
            النوع
        );
    }
    | حرفي.عدد_عشري(البايتات) -> {
        لو (!هل_نوع_عشري_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(البرنامج, &حالة_القراءة.البناء, حالة_القراءة.الدالة, حالة_القراءة.الكتلة, ثابت_مسير.عشري(البايتات), النوع),
            النوع
        );
    }
    | حرفي.عدد_طبيعي(القيمة) -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                );
            };
            أرجع قيمة_من_بناء_للخفض(
                أصدر_ثابتا_مسير(
                    البرنامج,
                    &حالة_القراءة.البناء,
                    حالة_القراءة.الدالة,
                    حالة_القراءة.الكتلة,
                    ثابت_مسير.صحيح_طبيعي(القيمة),
                    النوع
                ),
                النوع
            );
        };
    }
    | حرفي.نص(البايتات) -> {
        لو (!هل_نوع_نص_للخفض(الأنواع, النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        أرجع قيمة_من_بناء_للخفض(
            أصدر_ثابتا_مسير(
                البرنامج,
                &حالة_القراءة.البناء,
                حالة_القراءة.الدالة,
                حالة_القراءة.الكتلة,
                ثابت_مسير.نص(البايتات),
                النوع
            ),
            النوع
        );
    }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
}

عرف نوع_صحيح_موقع_بنفس_العرض_للخفض(
    الأنواع: &سجل_أنواع,
    الوصف: وصف_صحيح_خفض
): اختياري معرف_نوع {
    لو (الوصف.البتات == 8) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص8());
    };
    لو (الوصف.البتات == 16) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص16());
    };
    لو (الوصف.البتات == 32) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص32());
    };
    لو (الوصف.البتات == 64) {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ص64()) مع
        | اختياري.موجود(النوع) -> {
            أرجع اختياري.موجود(النوع);
        }
        | اختياري.لا_شيء -> {
            أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد());
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف اخفض_متمم_صحيح_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    دع الوصف: متغير وصف_صحيح_خفض = { موقع: خطأ, البتات: 0 };
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوصف := القيمة;
    };

    دع كل_البتات: متغير قيمة_خفض_مسير = الداخل;
    لو (الوصف.موقع) {
        طابق خفض_حرفي_إلى_مسير(
            البرنامج, الحالة, النطاق, حرفي.عدد(-1), النوع, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            كل_البتات := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    } وإلا {
        دع نوع_موقع: متغير معرف_نوع = النوع;
        طابق نوع_صحيح_موقع_بنفس_العرض_للخفض(الأنواع, الوصف) مع
        | اختياري.موجود(القيمة) -> {
            نوع_موقع := القيمة;
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        };
        دع ناقص_واحد: متغير قيمة_خفض_مسير = الداخل;
        طابق خفض_حرفي_إلى_مسير(
            البرنامج, الحالة, النطاق, حرفي.عدد(-1), نوع_موقع, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            ناقص_واحد := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                عملية_تحويل_صحيح.إعادة_تفسير(),
                ناقص_واحد.المعرف,
                النوع
            ),
            النوع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            كل_البتات := القيمة;
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_حسابا_صحيحا_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            عملية_حساب_صحيح.أو_حصري(),
            الداخل.المعرف,
            كل_البتات.المعرف,
            النوع
        ),
        النوع
    );
}

عرف عملية_حساب_من_عامل_للخفض(
    العامل: عامل_ثنائي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري عملية_حساب_صحيح {
    طابق العامل مع
    | عامل_ثنائي.جمع -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.جمع());
    }
    | عامل_ثنائي.طرح -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.طرح());
    }
    | عامل_ثنائي.ضرب -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.ضرب());
    }
    | عامل_ثنائي.أو_بتي -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.أو_بتي());
    }
    | عامل_ثنائي.أو_حصري -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.أو_حصري());
    }
    | عامل_ثنائي.و_بتي -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.و_بتي());
    }
    | عامل_ثنائي.إزاحة_يسرى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يسرى());
    }
    | عامل_ثنائي.إزاحة_يمنى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يمنى());
    }
    | عامل_ثنائي.إزاحة_حسابية_يمنى -> {
        أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_حسابية_يمنى());
    }
    | عامل_ثنائي.قسمة -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) {
                أرجع اختياري.موجود(عملية_حساب_صحيح.قسمة_موقعة());
            };
            أرجع اختياري.موجود(عملية_حساب_صحيح.قسمة_طبيعية());
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | عامل_ثنائي.باقي -> {
        طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) {
                أرجع اختياري.موجود(عملية_حساب_صحيح.باقي_موقع());
            };
            أرجع اختياري.موجود(عملية_حساب_صحيح.باقي_طبيعي());
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.لا_شيء();
        };
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف عملية_حساب_عشري_من_عامل_للخفض(العامل: عامل_ثنائي): اختياري عملية_حساب_عشري {
    طابق العامل مع
    | عامل_ثنائي.جمع -> { أرجع اختياري.موجود(عملية_حساب_عشري.جمع()); }
    | عامل_ثنائي.طرح -> { أرجع اختياري.موجود(عملية_حساب_عشري.طرح()); }
    | عامل_ثنائي.ضرب -> { أرجع اختياري.موجود(عملية_حساب_عشري.ضرب()); }
    | عامل_ثنائي.قسمة -> { أرجع اختياري.موجود(عملية_حساب_عشري.قسمة()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_مقارنة_عشرية_من_عامل_للخفض(العامل: عامل_ثنائي): اختياري عملية_مقارنة_عشري {
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.يساوي()); }
    | عامل_ثنائي.لا_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.لا_يساوي()); }
    | عامل_ثنائي.أصغر -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أصغر()); }
    | عامل_ثنائي.أصغر_أو_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أصغر_أو_يساوي()); }
    | عامل_ثنائي.أكبر -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أكبر()); }
    | عامل_ثنائي.أكبر_أو_يساوي -> { أرجع اختياري.موجود(عملية_مقارنة_عشري.أكبر_أو_يساوي()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_مقارنة_من_عامل_للخفض(
    العامل: عامل_ثنائي
): اختياري عملية_مقارنة_صحيح {
    طابق العامل مع
    | عامل_ثنائي.يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.يساوي());
    }
    | عامل_ثنائي.لا_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.لا_يساوي());
    }
    | عامل_ثنائي.أصغر -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أصغر());
    }
    | عامل_ثنائي.أصغر_أو_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أصغر_أو_يساوي());
    }
    | عامل_ثنائي.أكبر -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أكبر());
    }
    | عامل_ثنائي.أكبر_أو_يساوي -> {
        أرجع اختياري.موجود(عملية_مقارنة_صحيح.أكبر_أو_يساوي());
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف هل_نوع_موسوم_بلا_حمولات_للخفض(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): منطقي {
    لو (!هل_نوع_موسوم(الأنواع, النوع)) {
        أرجع خطأ;
    };
    دع العدد: متغير طبيعي = 0;
    طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(القيمة) -> { العدد := القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, النوع, ف) مع
        | اختياري.موجود(عدد_الحمولات) -> {
            لو (عدد_الحمولات != 0) {
                أرجع خطأ;
            };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اخفض_مقارنة_وسمين_بلا_حمولات_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: قيمة_خفض_مسير,
    اليمين: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    لو (!هل_نوع_موسوم_بلا_حمولات_للخفض(الأنواع, اليسار.النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع نوع_الوسم: متغير معرف_نوع = اليسار.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(المعرف) -> { نوع_الوسم := المعرف; }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
    };
    دع العملية: متغير عملية_مقارنة_صحيح = عملية_مقارنة_صحيح.يساوي();
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { العملية := عملية_مقارنة_صحيح.يساوي(); }
    | عامل_ثنائي.لا_يساوي -> { العملية := عملية_مقارنة_صحيح.لا_يساوي(); }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    دع وسم_اليسار: متغير معرف_قيمة_مسير = اليسار.المعرف;
    طابق أصدر_استعلام_وسم_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        اليسار.المعرف,
        نوع_الوسم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { وسم_اليسار := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع وسم_اليمين: متغير معرف_قيمة_مسير = اليمين.المعرف;
    طابق أصدر_استعلام_وسم_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        اليمين.المعرف,
        نوع_الوسم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { وسم_اليمين := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مقارنة_صحيح_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            العملية,
            وسم_اليسار,
            وسم_اليمين,
            النوع
        ),
        النوع
    );
}

عرف اخفض_منطق_قصير_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: &تعبير,
    اليمين: &تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    لو (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    };

    دع نتيجة_اليسار: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج,
        الحالة,
        اليسار,
        الأنواع,
        أنواع_التعبيرات,
        روابط_الأسماء,
        دوال_الخفض,
        هويات_البدائيات
    );
    دع دالة_فارغة_للمنطق: معرف_دالة_مسير = معرف_دالة_مسير_من(0);
    دع قيمة_فارغة_للمنطق: معرف_قيمة_مسير = معرف_قيمة_مسير_من(دالة_فارغة_للمنطق, 0);
    دع قيمة_اليسار: متغير قيمة_خفض_مسير = {
        المعرف: قيمة_فارغة_للمنطق,
        النوع: النوع
    };
    طابق نتيجة_اليسار مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_اليسار := القيمة;
    };
    لو (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_اليسار.النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_اليسار.النوع)
        );
    };

    دع القيمة_القصيرة: متغير منطقي = خطأ;
    طابق العامل مع
    | عامل_ثنائي.و -> {
        القيمة_القصيرة := خطأ;
    }
    | عامل_ثنائي.أو -> {
        القيمة_القصيرة := صواب;
    }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    دع نتيجة_الثابت: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(القيمة_القصيرة),
        النوع,
        الأنواع
    );
    دع قيمة_الثابت: متغير معرف_قيمة_مسير = قيمة_اليسار.المعرف;
    طابق نتيجة_الثابت مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_الثابت := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    طابق ابدأ_منطق_قصير_مسير(
        البرنامج,
        الحالة,
        النطاق,
        العامل,
        قيمة_اليسار,
        قيمة_الثابت,
        النوع
    ) مع
    | نتيجة_بدء_منطق_قصير_خفض.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_بدء_منطق_قصير_خفض.مبنية(السياق) -> {
        دع مرجع_أصل_اليمين: &حالة_خفض_دالة = &السياق.حالة_اليمين;
        دع أصل_اليمين: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(مرجع_أصل_اليمين);
        دع حالة_اليمين: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير أصل_اليمين);
        دع نتيجة_اليمين: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
            البرنامج,
            &متغير حالة_اليمين,
            اليمين,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
        دع قيمة_اليمين: متغير قيمة_خفض_مسير = قيمة_اليسار;
        طابق نتيجة_اليمين مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            قيمة_اليمين := القيمة;
        };
        لو (!هل_نوع_منطقي_للخفض(الأنواع, قيمة_اليمين.النوع)) {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_اليمين.النوع)
            );
        };
        أرجع اختم_منطق_قصير_مسير(
            البرنامج,
            الحالة,
            &حالة_اليمين,
            السياق.كتلة_الدمج,
            السياق.معامل_الدمج,
            قيمة_اليمين,
            النوع
        );
    };
}

عرف اخفض_نفي_منطقي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: قيمة_خفض_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    لو ((!هل_نوع_منطقي_للخفض(الأنواع, الداخل.النوع))
        || (!هل_نوع_منطقي_للخفض(الأنواع, النوع))) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    };
    دع حالة_الفرع: حالة_خفض_دالة = *الحالة;
    دع نتيجة_صواب: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(صواب),
        النوع,
        الأنواع
    );
    دع قيمة_صواب: متغير معرف_قيمة_مسير = الداخل.المعرف;
    طابق نتيجة_صواب مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_صواب := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع نتيجة_خطأ: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
        البرنامج,
        الحالة,
        النطاق,
        حرفي.منطقي(خطأ),
        النوع,
        الأنواع
    );
    دع قيمة_خطأ: متغير معرف_قيمة_مسير = الداخل.المعرف;
    طابق نتيجة_خطأ مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        قيمة_خطأ := القيمة.المعرف;
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    أرجع اخفض_نفي_منطقي_مقنن(
        البرنامج,
        الحالة,
        النطاق,
        الداخل,
        قيمة_صواب,
        قيمة_خطأ,
        النوع
    );
}

عرف هل_نوع_مؤشر_للخفض(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.مؤشر -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف خفض_مكان_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_مكان {
    دع النوع_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, التعبير);
    دع النوع: متغير معرف_نوع = معرف_نوع_من(0);
    طابق النوع_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
        النوع := المعرف;
    }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
    };
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.اسم(النطاق, الاسم) -> {
        أرجع اخفض_مكان_اسم_مقنن(البرنامج, الحالة, النطاق, &الاسم, روابط_الأسماء, دوال_الخفض);
    }
    | تعبير.فهرس(النطاق, صندوق_الأصل, صندوق_الفهرس) -> {
        دع الأصل: تعبير = *صندوق_الأصل;
        دع الفهرس: تعبير = *صندوق_الفهرس;
        دع نوع_الأصل_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الأصل);
        دع نوع_الأصل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_الأصل_نتيجة مع
        | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> { نوع_الأصل := المعرف; }
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); };

        لو (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الأصل)) {
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_المؤشر) -> {
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_مكان.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                    أرجع اخفض_موضع_تخزين_عنصر_مؤشر_مقنن(
                        البرنامج, الحالة, النطاق, قيمة_المؤشر, قيمة_الفهرس, النوع, الأنواع
                    );
                };
            };
        };

        طابق خفض_مكان_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_مكان.مكان(مكان_الأصل) -> {
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                أرجع اخفض_مكان_فهرس_مقنن(
                    البرنامج, الحالة, النطاق, مكان_الأصل, قيمة_الفهرس, النوع, الأنواع
                );
            };
        };
    }
    | تعبير.حقل(النطاق, صندوق_الأصل, اسم_الحقل) -> {
        دع الأصل: تعبير = *صندوق_الأصل;
        طابق خفض_مكان_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_مكان.مكان(مكان_الأصل) -> {
            أرجع اخفض_مكان_حقل_مقنن(
                البرنامج, الحالة, النطاق, مكان_الأصل, &اسم_الحقل, النوع,
                الأنواع, روابط_الأسماء
            );
        };
    }
    | تعبير.فك_موضع(النطاق, صندوق_المرجع) -> {
        دع المرجع: تعبير = *صندوق_المرجع;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &المرجع, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المرجع) -> {
            أرجع اخفض_مكان_فك_مرجع_مقنن(
                البرنامج, الحالة, النطاق, قيمة_المرجع, النوع, الأنواع
            );
        };
    }
    | تعبير.أحادي(النطاق, عامل_أحادي.فك, صندوق_المرجع) -> {
        دع المرجع: تعبير = *صندوق_المرجع;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &المرجع, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_مكان.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_مكان.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المرجع) -> {
            أرجع اخفض_مكان_فك_مرجع_مقنن(
                البرنامج, الحالة, النطاق, قيمة_المرجع, النوع, الأنواع
            );
        };
    }
    | _ -> {
        أرجع نتيجة_خفض_مكان.مرفوض(
            خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
        );
    };
}

// Whether التعبير names storage that already has a place: a dereference,
// a raw pointer element, a local that already lives in storage (an owner, or
// a local whose address was taken), or a global, reached through record
// field and vector element projections. A read of a projection of such an
// expression loads the member from its place, as rustc reads a field
// through a place projection (`_1.0`, `(*_2).f`, `_3[_4].f`); loading the
// whole root and then extracting the member would copy the whole aggregate
// (in every backend and in the interpreter) to read one member. A local that
// is still a plain SSA value (no place) is not a root: giving it storage
// would cost a store, and extracting from the value copies nothing.
عرف جذر_مكان_قراءة_للخفض(
    الحالة: &حالة_خفض_دالة,
    الأصل: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *الأصل مع
    | تعبير.فك_موضع(_, _) -> { أرجع صواب; }
    | تعبير.أحادي(_, عامل_أحادي.فك, _) -> { أرجع صواب; }
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
            طابق موضع_محلي_خفض(الحالة, الرمز) مع
            | اختياري.موجود(الموضع) -> {
                طابق (*الحالة).المحليات[الموضع].المكان مع
                | اختياري.موجود(_) -> { أرجع صواب; }
                | اختياري.لا_شيء -> { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { };
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.عام(_) -> { أرجع صواب; }
                | _ -> { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        };
    }
    | تعبير.حقل(_, صندوق_الداخل, اسم_الحقل) -> {
        // A member that names a function (a module-qualified function) is
        // not storage.
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق دالة_خفض_عند(دوال_الخفض, رمز_العضو) مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع جذر_مكان_قراءة_للخفض(
            الحالة, &(*صندوق_الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        );
    }
    | تعبير.فهرس(_, صندوق_الداخل, _) -> {
        طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &(*صندوق_الداخل)) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(_) -> { أرجع خطأ; }
        | نتيجة_حل_نوع_للخفض.موجود(نوع_الداخل) -> {
            لو (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الداخل)) { أرجع صواب; };
            لو (!هل_نوع_متجه_للخفض(الأنواع, نوع_الداخل)) { أرجع خطأ; };
            أرجع جذر_مكان_قراءة_للخفض(
                الحالة, &(*صندوق_الداخل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
            );
        };
    }
    | _ -> { أرجع خطأ; };
}

// The local at the root of a place-read projection chain, with the span of
// its name use.
عرف اسم_جذر_مكان_قراءة_للخفض(الأصل: &تعبير): اختياري اسم {
    طابق *الأصل مع
    | تعبير.اسم(_, الاسم) -> { أرجع اختياري.موجود(الاسم); }
    | تعبير.حقل(_, صندوق_الداخل, _) -> { أرجع اسم_جذر_مكان_قراءة_للخفض(&(*صندوق_الداخل)); }
    | تعبير.فهرس(_, صندوق_الداخل, _) -> { أرجع اسم_جذر_مكان_قراءة_للخفض(&(*صندوق_الداخل)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A projection read lowered through its place. A use of the root local that
// SSF recorded as a move gives up the owner's value, as the same read lowered
// through the root's value does.
عرف خفض_قراءة_إسقاط_مكان_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع المقروءة: نتيجة_خفض_تعبير = خفض_مكان_ثم_تحميل_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    طابق اسم_جذر_مكان_قراءة_للخفض(التعبير) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            طابق موضع_محلي_خفض(الحالة, الرمز) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(_) -> {
                طابق طبق_نقل_محلي_خفض(البرنامج, الحالة, الرمز, &الاسم.النطاق, دوال_الخفض) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        };
    };
    أرجع المقروءة;
}

عرف خفض_مكان_ثم_تحميل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    طابق خفض_مكان_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | نتيجة_خفض_مكان.مكان(المكان) -> {
        أرجع اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان);
    };
}

عرف اخفض_استدعاء_منشئ_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    اسم_المنشئ: &اسم,
    الحجج: &متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع قيمة_اسم_المنشئ: اسم = *اسم_المنشئ;
    دع الهوية: متغير هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
    طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, قيمة_اسم_المنشئ.النطاق) مع
    | اختياري.موجود(القيمة) -> {
        الهوية := القيمة;
    }
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.هوية_منشئ_مفقودة(قيمة_اسم_المنشئ.النطاق)
        );
    };

    دع الوصف: متغير وصف_منشئ_نوع_دلالي = {
        الترتيب: 0,
        عدد_الحمولات: 0
    };
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, الهوية) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
        );
    }
    | اختياري.موجود(القيمة) -> {
        الوصف := القيمة;
    };

    دع قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع قيم: متجه تعبير = *الحجج;
    لو ((الطول(قيم) مثل طبيعي) != الوصف.عدد_الحمولات) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
        );
    };

    دع ف: متغير طبيعي = 0;
    طالما (ف < الوصف.عدد_الحمولات) {
        دع المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_حمولة_منشئ_دلالي_بالهوية_عند(الأنواع, النوع, الهوية, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
            );
        }
        | اختياري.موجود(القيمة) -> {
            المتوقع := القيمة;
        };
        دع مرجع_الحجة: &تعبير = &قيم[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_الحجة,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_الحجة))
            );
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, نطاق_تعبير(مرجع_الحجة), القيمة, المتوقع, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(قيم_الحجج, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_الحجة))
                );
            };
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_بناء_موسوم_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            الوصف.الترتيب,
            &قيم_الحجج,
            النوع
        ),
        النوع
    );
}

عام عرف اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    النوع_الهدف: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    دع صالح: متغير منطقي = خطأ;
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المصدر.النوع) مع
    | اختياري.موجود(وصف_المصدر) -> {
        طابق وصف_المصدر.الصنف مع
        | صنف_شكل_نوع_دلالي.مرجع -> {
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع_الهدف) مع
            | اختياري.موجود(وصف_الهدف) -> {
                طابق وصف_الهدف.الصنف مع
                | صنف_شكل_نوع_دلالي.مؤشر -> {
                    طابق صنف_تحويل_بين(الأنواع, المصدر.النوع, النوع_الهدف) مع
                    | صنف_تحويل_نوع.ضمني_آمن -> { صالح := صواب; }
                    | _ -> { };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    لو (!صالح) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
        );
    };
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_مرجع_إلى_مؤشر_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المصدر.المعرف,
            النوع_الهدف
        ), النوع_الهدف
    );
}


عرف عملية_تحويل_صحيح_من_وصف_للخفض(
    الوصف: وصف_تحويل_صحيح_دلالي
): عملية_تحويل_صحيح {
    طابق الوصف.تغيير_العرض مع
    | تغيير_عرض_صحيح_دلالي.حفظ -> {
        أرجع عملية_تحويل_صحيح.إعادة_تفسير();
    }
    | تغيير_عرض_صحيح_دلالي.توسيع_صفري -> {
        أرجع عملية_تحويل_صحيح.توسيع_صفري();
    }
    | تغيير_عرض_صحيح_دلالي.توسيع_بإشارة -> {
        أرجع عملية_تحويل_صحيح.توسيع_بإشارة();
    }
    | تغيير_عرض_صحيح_دلالي.اقتطاع -> {
        أرجع عملية_تحويل_صحيح.اقتطاع();
    };
}

// ---- Vector pop and truncate --------------------------------------------
// `أزل_الأخير(v)` / `pop` and `اقتطع(v, n)` / `truncate` (Rust's Vec::pop and
// Vec::truncate, docs/OWNERSHIP_AND_DESTRUCTION.md "Pop and truncate") are
// lowered here into ordinary MSIR on the vector's place:
//   pop       empty: none. Otherwise the last element is read out (moved:
//             the vector stops owning it) and returned as some.
//   truncate  n at or past the length: nothing. Otherwise the elements from
//             n on are dropped (their drop glue), in order.
// The new length is stored with the ضبط_طول_متجه primitive, which every
// backend writes into the header. The buffer and its capacity stay, as Rust's
// Vec keeps them: a vector left empty still holds its buffer, which the next
// append reuses and drop glue releases (it releases a buffer whose capacity
// is above zero).

// An edge that passes no block arguments.
عرف حافة_بلا_حجج_خفض(الهدف: معرف_كتلة_مسير): حافة_مسير {
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    دع الحافة: حافة_مسير = { الهدف: الهدف, الحجج: بلا_حجج };
    أرجع الحافة;
}

// A value result of a builder call in pop/truncate lowering.
عرف قيمة_إزالة_خفض(الناتج: نتيجة_بناء_قيمة_مسير): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ())); };
}

عرف بلا_قيمة_إزالة_خفض(الناتج: نتيجة_بناء_قيمة_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف منهي_إزالة_خفض(الناتج: نتيجة_بناء_منهي_مسير): اختياري خطأ_خفض_مسير {
    طابق الناتج مع
    | نتيجة_بناء_منهي_مسير.مبني -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
}

// The vector at the place gets length الطول (below its length; zero empties
// it and keeps its buffer).
عرف اضبط_طول_متجه_مكان_خفض(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    المكان: معرف_قيمة_مسير,
    القيمة: معرف_قيمة_مسير,
    الطول: معرف_قيمة_مسير
): اختياري خطأ_خفض_مسير {
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة, الطول];
    أرجع بلا_قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
        البرنامج, البناء, الدالة, الكتلة, هوية_بدائي_مترجم.ضبط_طول_متجه(), &الحجج,
        اختياري.لا_شيء(), اختياري.موجود(المكان)
    ));
}

عام عرف اخفض_إزالة_أو_اقتطاع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الهوية: هوية_بدائي_مترجم,
    الحجج: &متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع اقتطاع: منطقي = هويتا_بدائي_مترجم_متساويتان(الهوية, هوية_بدائي_مترجم.اقتطاع_متجه());
    دع العدد_المتوقع: متغير طبيعي = 1;
    لو (اقتطاع) { العدد_المتوقع := 2; };
    لو ((الطول(*الحجج) مثل طبيعي) != العدد_المتوقع) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };
    دع المكان: مكان_خفض_مسير;
    طابق خفض_مكان_إلى_مسير(
        البرنامج, الحالة, &(*الحجج)[0], الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_مكان.مكان(القيمة) -> { المكان := القيمة; };
    دع نوع_المتجه: معرف_نوع = المكان.النوع;
    دع نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(العنصر) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, العنصر) مع
        | اختياري.موجود(التمثيل) -> { نوع_العنصر := التمثيل; }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_المتجه)); };
    دع نوع_العدد: معرف_نوع;
    دع نوع_ط64: معرف_نوع;
    دع نوع_المنطق: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
    | اختياري.موجود(ن) -> { نوع_ط64 := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(ن) -> { نوع_المنطق := ن; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    // Truncate's length, evaluated after the place (left to right), as a u64.
    دع الحد: متغير معرف_قيمة_مسير = المكان.المعرف;
    لو (اقتطاع) {
        دع قيمة_الحد: قيمة_خفض_مسير;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &(*الحجج)[1], الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الحد := القيمة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        دع وصف_الحد: وصف_صحيح_خفض;
        طابق وصف_صحيح_للخفض(الأنواع, قيمة_الحد.النوع) مع
        | اختياري.موجود(الوصف) -> { وصف_الحد := الوصف; }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الحد.النوع)); };
        الحد := قيمة_الحد.المعرف;
        لو (!معرفا_نوع_متساويان(قيمة_الحد.النوع, نوع_ط64)) {
            دع العملية: متغير عملية_تحويل_صحيح = عملية_تحويل_صحيح.إعادة_تفسير();
            لو (وصف_الحد.البتات < 64) {
                لو (وصف_الحد.موقع) { العملية := عملية_تحويل_صحيح.توسيع_بإشارة(); }
                وإلا { العملية := عملية_تحويل_صحيح.توسيع_صفري(); };
            };
            طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
                البرنامج, &(*الحالة).البناء, (*الحالة).الدالة, (*الحالة).الكتلة, العملية, قيمة_الحد.المعرف, نوع_ط64
            )) مع
            | نتيجة.نجح(ق) -> { الحد := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        };
    };

    دع الدالة: معرف_دالة_مسير = (*الحالة).الدالة;
    دع المدخل: معرف_كتلة_مسير = (*الحالة).الكتلة;
    دع المتجه: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_تحميل_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, المكان.المعرف, نوع_المتجه)) مع
    | نتيجة.نجح(ق) -> { المتجه := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع حجج_الطول: متجه معرف_قيمة_مسير = [المتجه];
    دع الطول_الحالي: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
        البرنامج, &(*الحالة).البناء, الدالة, المدخل, هوية_بدائي_مترجم.طول(), &حجج_الطول,
        اختياري.موجود(نوع_العدد), اختياري.لا_شيء()
    )) مع
    | نتيجة.نجح(ق) -> { الطول_الحالي := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع الصفر: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_ثابتا_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(0), نوع_العدد)) مع
    | نتيجة.نجح(ق) -> { الصفر := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع الواحد: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_ثابتا_مسير(البرنامج, &(*الحالة).البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(1), نوع_العدد)) مع
    | نتيجة.نجح(ق) -> { الواحد := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };

    دع العمل: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { العمل := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع التخطي: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { التخطي := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع التقصير: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { التقصير := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع الاتصال: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الاتصال := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };

    // The new length: pop's length - 1, or truncate's n.
    دع لا_حجج: متجه معرف_قيمة_مسير = [];
    دع الطول_الجديد: متغير معرف_قيمة_مسير = الصفر;
    دع العنصر_المزال: متغير معرف_قيمة_مسير = الصفر;
    دع حالة_البناء: حالة_بناء_مسير = (*الحالة).البناء;
    لو (اقتطاع) {
        // n < length, compared as u64 (length is never negative).
        دع الطول64: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_تحويل_صحيح.إعادة_تفسير(), الطول_الحالي, نوع_ط64
        )) مع
        | نتيجة.نجح(ق) -> { الطول64 := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        دع يقصر: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_مقارنة_صحيح.أصغر(), الحد, الطول64, نوع_المنطق
        )) مع
        | نتيجة.نجح(ق) -> { يقصر := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        دع إلى_العمل: حافة_مسير = حافة_بلا_حجج_خفض(العمل);
        دع إلى_التخطي: حافة_مسير = حافة_بلا_حجج_خفض(التخطي);
        طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, المدخل, يقصر, إلى_العمل, إلى_التخطي)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        دع البداية: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_تحويل_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, العمل, عملية_تحويل_صحيح.إعادة_تفسير(), الحد, نوع_العدد
        )) مع
        | نتيجة.نجح(ق) -> { البداية := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        الطول_الجديد := البداية;
        // Drop the elements from n on, in order (owning elements only).
        دع بعد_الإسقاط: متغير معرف_كتلة_مسير = العمل;
        لو (هل_نوع_يملك_تخزينا_مسير(الأنواع, نوع_العنصر)) {
            دع الرأس: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الرأس := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع الجسم: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الجسم := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع المخرج: معرف_كتلة_مسير;
            طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { المخرج := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع الفهرس: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الرأس, نوع_العدد)) مع
            | نتيجة.نجح(ق) -> { الفهرس := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع حجج_البدء: متجه معرف_قيمة_مسير = [البداية];
            طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, العمل, الرأس, &حجج_البدء)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            دع الشرط: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
                البرنامج, &حالة_البناء, الدالة, الرأس, عملية_مقارنة_صحيح.أصغر(), الفهرس, الطول_الحالي, نوع_المنطق
            )) مع
            | نتيجة.نجح(ق) -> { الشرط := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع إلى_الجسم: حافة_مسير = حافة_بلا_حجج_خفض(الجسم);
            دع إلى_المخرج: حافة_مسير = حافة_بلا_حجج_خفض(المخرج);
            طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, الرأس, الشرط, إلى_الجسم, إلى_المخرج)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            دع العنصر: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_استخراج_فهرس_مسير(البرنامج, &حالة_البناء, الدالة, الجسم, المتجه, الفهرس, نوع_العنصر)) مع
            | نتيجة.نجح(ق) -> { العنصر := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع حجج_الإسقاط: متجه معرف_قيمة_مسير = [العنصر];
            طابق بلا_قيمة_إزالة_خفض(أصدر_نداء_بدائي_مسير(
                البرنامج, &حالة_البناء, الدالة, الجسم, هوية_بدائي_مترجم.تحرير(), &حجج_الإسقاط,
                اختياري.لا_شيء(), اختياري.لا_شيء()
            )) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            دع التالي: معرف_قيمة_مسير;
            طابق قيمة_إزالة_خفض(أصدر_حسابا_صحيحا_مسير(
                البرنامج, &حالة_البناء, الدالة, الجسم, عملية_حساب_صحيح.جمع(), الفهرس, الواحد, نوع_العدد
            )) مع
            | نتيجة.نجح(ق) -> { التالي := ق; }
            | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
            دع حجج_التكرار: متجه معرف_قيمة_مسير = [التالي];
            طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, الجسم, الرأس, &حجج_التكرار)) مع
            | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
            | اختياري.لا_شيء -> { };
            بعد_الإسقاط := المخرج;
        };
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, بعد_الإسقاط, التقصير, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
    } وإلا {
        // Pop: an empty vector gives none.
        دع فارغ: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &حالة_البناء, الدالة, المدخل, عملية_مقارنة_صحيح.يساوي(), الطول_الحالي, الصفر, نوع_المنطق
        )) مع
        | نتيجة.نجح(ق) -> { فارغ := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        دع إلى_التخطي: حافة_مسير = حافة_بلا_حجج_خفض(التخطي);
        دع إلى_العمل: حافة_مسير = حافة_بلا_حجج_خفض(العمل);
        طابق منهي_إزالة_خفض(اختم_بفرع_شرطي_مسير(البرنامج, الدالة, المدخل, فارغ, إلى_التخطي, إلى_العمل)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        دع الأخير: معرف_قيمة_مسير;
        طابق قيمة_إزالة_خفض(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_البناء, الدالة, العمل, عملية_حساب_صحيح.طرح(), الطول_الحالي, الواحد, نوع_العدد
        )) مع
        | نتيجة.نجح(ق) -> { الأخير := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        الطول_الجديد := الأخير;
        // The element is moved out: the vector stops owning it below.
        طابق قيمة_إزالة_خفض(أصدر_استخراج_فهرس_مسير(البرنامج, &حالة_البناء, الدالة, العمل, المتجه, الأخير, نوع_العنصر)) مع
        | نتيجة.نجح(ق) -> { العنصر_المزال := ق; }
        | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, العمل, التقصير, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
    };
    طابق اضبط_طول_متجه_مكان_خفض(البرنامج, &حالة_البناء, الدالة, التقصير, المكان.المعرف, المتجه, الطول_الجديد) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, التقصير, الاتصال, &لا_حجج)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };

    لو (اقتطاع) {
        طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, التخطي, الاتصال, &لا_حجج)) مع
        | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
        | اختياري.لا_شيء -> { };
        (*الحالة).الكتلة := الاتصال;
        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
    };

    // Pop's result: some(element) after the vector shrank, none when empty.
    دع موجود: وصف_منشئ_نوع_دلالي;
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, هوية_منشئ_نوع.اختيار_بعض()) مع
    | اختياري.موجود(الوصف) -> { موجود := الوصف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
    دع لا_شيء: وصف_منشئ_نوع_دلالي;
    طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, النوع, هوية_منشئ_نوع.اختيار_لا_شيء()) مع
    | اختياري.موجود(الوصف) -> { لا_شيء := الوصف; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
    دع الدمج: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الدالة) مع | نتيجة.نجح(ك) -> { الدمج := ك; } | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع الناتج: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أضف_معامل_كتلة_مسير(البرنامج, الدالة, الدمج, النوع)) مع
    | نتيجة.نجح(ق) -> { الناتج := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع بلا_حمولات: متجه معرف_قيمة_مسير = [];
    دع القيمة_الفارغة: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_بناء_موسوم_مسير(البرنامج, &حالة_البناء, الدالة, التخطي, لا_شيء.الترتيب, &بلا_حمولات, النوع)) مع
    | نتيجة.نجح(ق) -> { القيمة_الفارغة := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع حجج_الفارغة: متجه معرف_قيمة_مسير = [القيمة_الفارغة];
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, التخطي, الدمج, &حجج_الفارغة)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    دع الحمولات: متجه معرف_قيمة_مسير = [العنصر_المزال];
    دع القيمة_الموجودة: معرف_قيمة_مسير;
    طابق قيمة_إزالة_خفض(أصدر_بناء_موسوم_مسير(البرنامج, &حالة_البناء, الدالة, الاتصال, موجود.الترتيب, &الحمولات, النوع)) مع
    | نتيجة.نجح(ق) -> { القيمة_الموجودة := ق; }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); };
    دع حجج_الموجودة: متجه معرف_قيمة_مسير = [القيمة_الموجودة];
    طابق منهي_إزالة_خفض(اختم_بفرع_مسير(البرنامج, الدالة, الاتصال, الدمج, &حجج_الموجودة)) مع
    | اختياري.موجود(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خ); }
    | اختياري.لا_شيء -> { };
    (*الحالة).الكتلة := الدمج;
    دع النتيجة: قيمة_خفض_مسير = { المعرف: الناتج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(النتيجة);
}

// The MSIR operation of a wrapping arithmetic primitive (the right shift's
// is chosen by the operand's signedness when it is lowered).
عرف عملية_بدائي_ملتف_للخفض(الهوية: هوية_بدائي_مترجم): اختياري عملية_حساب_صحيح {
    طابق الهوية مع
    | هوية_بدائي_مترجم.جمع_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.جمع_ملتف()); }
    | هوية_بدائي_مترجم.طرح_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.طرح_ملتف()); }
    | هوية_بدائي_مترجم.ضرب_ملتف -> { أرجع اختياري.موجود(عملية_حساب_صحيح.ضرب_ملتف()); }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يسرى_ملتفة()); }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> { أرجع اختياري.موجود(عملية_حساب_صحيح.إزاحة_يمنى()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// a op b modulo 2^N. Shifts first take the amount modulo N (Rust's
// wrapping_shl/shr), so the shift itself never traps.
عرف اخفض_حسابا_ملتفا_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الهوية: هوية_بدائي_مترجم,
    العملية_الأصلية: عملية_حساب_صحيح,
    اليسار: معرف_قيمة_مسير,
    اليمين: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    دع الوصف: وصف_صحيح_خفض;
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.موجود(و) -> { الوصف := و; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    دع العملية: متغير عملية_حساب_صحيح = العملية_الأصلية;
    دع المقدار: متغير معرف_قيمة_مسير = اليمين;
    دع إزاحة: متغير منطقي = خطأ;
    طابق الهوية مع
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { إزاحة := صواب; }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> {
        إزاحة := صواب;
        لو (الوصف.موقع) { العملية := عملية_حساب_صحيح.إزاحة_حسابية_يمنى(); };
    }
    | _ -> { };
    لو (إزاحة) {
        دع القناع_الخام: طبيعي = الوصف.البتات - 1;
        دع ثابت_القناع: متغير ثابت_مسير = ثابت_مسير.صحيح_طبيعي(القناع_الخام);
        لو (الوصف.موقع) { ثابت_القناع := ثابت_مسير.صحيح_موقع(القناع_الخام مثل عدد); };
        دع القناع: معرف_قيمة_مسير;
        طابق أصدر_ثابتا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة, ثابت_القناع, النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(م) -> { القناع := م; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        طابق أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            عملية_حساب_صحيح.و_بتي(), اليمين, القناع, النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(م) -> { المقدار := م; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(خ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(خ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    };
    أرجع قيمة_من_بناء_للخفض(
        أصدر_حسابا_صحيحا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            العملية, اليسار, المقدار, النوع
        ),
        النوع
    );
}

// `x as T` between a float and an integer, or between f32 and f64
// (docs/TYPE_SYSTEM.md, "Numeric casts"): the operation that converts.
عام عرف عملية_تحويل_عائم_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_عائم {
    دع مصدر_عائم: منطقي = هل_نوع_عشري_للخفض(الأنواع, نوع_المصدر);
    دع هدف_عائم: منطقي = هل_نوع_عشري_للخفض(الأنواع, نوع_الهدف);
    لو (مصدر_عائم && هدف_عائم) {
        أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_عائم());
    };
    لو (مصدر_عائم) {
        طابق وصف_صحيح_للخفض(الأنواع, نوع_الهدف) مع
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) { أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_موقع()); };
            أرجع اختياري.موجود(عملية_تحويل_عائم.عائم_إلى_طبيعي());
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    لو (هدف_عائم) {
        طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
        | اختياري.موجود(الوصف) -> {
            لو (الوصف.موقع) { أرجع اختياري.موجود(عملية_تحويل_عائم.موقع_إلى_عائم()); };
            أرجع اختياري.موجود(عملية_تحويل_عائم.طبيعي_إلى_عائم());
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    أرجع اختياري.لا_شيء();
}

// An 8-bit unsigned value is always a Unicode scalar, so `u8 as char` is a
// zero extension. Wider integers are not: they may name a surrogate or exceed
// U+10FFFF, and stay rejected.
عرف عملية_تحويل_بايت_إلى_حرف_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_صحيح {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_الهدف) مع
    | اختياري.موجود(وصف_الهدف) -> {
        طابق وصف_الهدف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (البدائي != نوع_بدائي_مقنن.حرف()) { أرجع اختياري.لا_شيء(); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق وصف_صحيح_للخفض(الأنواع, نوع_المصدر) مع
    | اختياري.موجود(وصف_المصدر) -> {
        لو (وصف_المصدر.موقع || وصف_المصدر.البتات != 8) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(عملية_تحويل_صحيح.توسيع_صفري());
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف عملية_تحويل_حرف_إلى_صحيح_للخفض(
    الأنواع: &سجل_أنواع,
    نوع_المصدر: معرف_نوع,
    نوع_الهدف: معرف_نوع
): اختياري عملية_تحويل_صحيح {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, نوع_المصدر) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(وصف_المصدر) -> {
        طابق وصف_المصدر.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (البدائي != نوع_بدائي_مقنن.حرف()) {
                أرجع اختياري.لا_شيء();
            };
            طابق وصف_صحيح_للخفض(الأنواع, نوع_الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.لا_شيء();
            }
            | اختياري.موجود(وصف_الهدف) -> {
                لو (وصف_الهدف.موقع) {
                    أرجع اختياري.لا_شيء();
                };
                دع بتات_المصدر: طبيعي = بتات_نوع_بدائي(البدائي);
                لو (وصف_الهدف.البتات < بتات_المصدر) {
                    أرجع اختياري.لا_شيء();
                };
                لو (وصف_الهدف.البتات == بتات_المصدر) {
                    أرجع اختياري.موجود(عملية_تحويل_صحيح.إعادة_تفسير());
                };
                أرجع اختياري.موجود(عملية_تحويل_صحيح.توسيع_صفري());
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

// A fresh vector (a call result) viewed as a slice argument has no owner:
// an anonymous owner in the enclosing block keeps its buffer for the view.
عام عرف امتلك_متجها_معروضا_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    القيمة: قيمة_خفض_مسير,
    المتوقع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    لو (!هل_عرض_متجه_كشريحة(الأنواع, القيمة.النوع, المتوقع)) { أرجع اختياري.لا_شيء(); };
    لو (هل_أصل_مؤقت_للخفض(التعبير)) {
        أرجع سجل_مالكا_مؤقتا_خفض(البرنامج, الحالة, القيمة.المعرف, القيمة.النوع, الأنواع);
    };
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المصدر: قيمة_خفض_مسير,
    النوع_الهدف: معرف_نوع,
    الأنواع: &سجل_أنواع
): نتيجة_خفض_تعبير {
    لو (معرفا_نوع_متساويان(المصدر.النوع, النوع_الهدف)) {
        أرجع نتيجة_خفض_تعبير.قيمة(المصدر);
    };
    // A vector viewed as a slice: the same header, retyped. The vector keeps
    // owning its buffer.
    لو (هل_عرض_متجه_كشريحة(الأنواع, المصدر.النوع, النوع_الهدف)) {
        دع حالة_العرض: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_نقل_تسلسل_مملوك_مسير(
                البرنامج, &حالة_العرض.البناء, حالة_العرض.الدالة, حالة_العرض.الكتلة,
                المصدر.المعرف, النوع_الهدف
            ),
            النوع_الهدف
        );
    };

    لو (!هل_تحويل_ضمني_آمن(الأنواع, المصدر.النوع, النوع_الهدف)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(
            خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
        );
    };

    طابق وصف_تحويل_صحيح_بين(الأنواع, المصدر.النوع, النوع_الهدف) مع
    | اختياري.موجود(الوصف) -> {
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                عملية_تحويل_صحيح_من_وصف_للخفض(الوصف),
                المصدر.المعرف,
                النوع_الهدف
            ),
            النوع_الهدف
        );
    }
    | اختياري.لا_شيء -> { };

    طابق عملية_تحويل_حرف_إلى_صحيح_للخفض(الأنواع, المصدر.النوع, النوع_الهدف) مع
    | اختياري.موجود(العملية) -> {
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تحويل_صحيح_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                العملية,
                المصدر.المعرف,
                النوع_الهدف
            ),
            النوع_الهدف
        );
    }
    | اختياري.لا_شيء -> { };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع_الهدف) مع
    | اختياري.موجود(وصف_الهدف) -> {
        طابق وصف_الهدف.الصنف مع
        | صنف_شكل_نوع_دلالي.مؤشر -> {
            أرجع اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                البرنامج, الحالة, النطاق, المصدر, النوع_الهدف, الأنواع
            );
        }
        | صنف_شكل_نوع_دلالي.مرجع -> {
            طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع_الهدف) مع
            | اختياري.موجود(نوع_الداخل) -> {
                طابق اخفض_مكان_فك_مرجع_مقنن(
                    البرنامج, الحالة, النطاق, المصدر, نوع_الداخل, الأنواع
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> {
                    أرجع اخفض_مرجع_مكان_مقنن(
                        البرنامج, الحالة, المكان, النوع_الهدف
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };

    أرجع نتيجة_خفض_تعبير.مرفوض(
        خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, النوع_الهدف, المصدر.النوع)
    );
}

عرف اخفض_استدعاء_غير_مباشر_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    تعبير_الدالة: &تعبير,
    الحجج: متجه تعبير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع نوع_الدالة_نتيجة: نتيجة_حل_نوع_للخفض =
        نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, تعبير_الدالة);
    دع نوع_الدالة: معرف_نوع;
    طابق نوع_الدالة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> { نوع_الدالة := المعرف; }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };

    دع عدد_المعاملات: طبيعي;
    طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | اختياري.موجود(العدد) -> { عدد_المعاملات := العدد; };
    لو ((الطول(الحجج) مثل طبيعي) != عدد_المعاملات) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };

    دع قيمة_الدالة: قيمة_خفض_مسير;
    طابق خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, تعبير_الدالة, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> { قيمة_الدالة := القيمة; };

    دع قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المعاملات) {
        دع المتوقع: معرف_نوع;
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة, ف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | اختياري.موجود(القيمة) -> { المتوقع := القيمة; };
        دع مرجع_الحجة: &تعبير = &الحجج[ف];
        دع الحجة: تعبير = *مرجع_الحجة;
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج, الحالة, &الحجة, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة)));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة) -> {
            طابق امتلك_متجها_معروضا_خفض(
                البرنامج, الحالة, &الحجة, قيمة_الحجة, المتوقع, الأنواع
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, نطاق_تعبير(&الحجة), قيمة_الحجة, المتوقع, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(قيم_الحجج, المقننة.المعرف); }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة)));
            };
        };
        ف := ف + 1;
    }

    دع نوع_الناتج_الدلالي: معرف_نوع;
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | اختياري.موجود(القيمة) -> { نوع_الناتج_الدلالي := القيمة; };
    لو (!معرفا_نوع_متساويان(نوع_الناتج_الدلالي, النوع)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
    };
    دع نوع_ناتج_المسير: متغير اختياري معرف_نوع = اختياري.موجود(النوع);
    لو (هل_نوع_فراغ_للخفض(الأنواع, النوع)) { نوع_ناتج_المسير := اختياري.لا_شيء(); };
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    دع نتيجة_النداء: نتيجة_بناء_قيمة_مسير = أصدر_نداء_غير_مباشر_مسير(
        البرنامج,
        &حالة_الإصدار.البناء,
        حالة_الإصدار.الدالة,
        حالة_الإصدار.الكتلة,
        قيمة_الدالة.المعرف,
        &قيم_الحجج,
        نوع_ناتج_المسير
    );
    // A callee no local owns (a call result, a closure expression) is
    // dropped once the call returns.
    لو (هل_نوع_معدود_عادي_مسير(الأنواع, قيمة_الدالة.النوع)
        && هل_تعبير_طازج_للخفض(تعبير_الدالة, روابط_الأسماء, دوال_الخفض)) {
        طابق أسقط_قيمة_خفض(البرنامج, الحالة, قيمة_الدالة.المعرف, قيمة_الدالة.النوع, الأنواع) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
    };
    طابق نوع_ناتج_المسير مع
    | اختياري.موجود(_) -> { أرجع قيمة_من_بناء_للخفض(نتيجة_النداء, النوع); }
    | اختياري.لا_شيء -> {
        طابق نتيجة_النداء مع
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.بلا_قيمة(); }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
}

عرف اخفض_إغلاق_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    المعاملات_النحوية: &متجه معامل_إغلاق,
    الجسم: &تعبير,
    نوع_الإغلاق: معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع رموز_الالتقاط: متغير متجه معرف_رمز = [];
    طابق التقاطات_إغلاق_عند(أنواع_التعبيرات, النطاق) مع
    | اختياري.موجود(القيم) -> { رموز_الالتقاط := القيم; }
    | اختياري.لا_شيء -> { };

    // Capture values are evaluated at closure construction, before the nested body exists.
    دع قيم_الالتقاط: متغير متجه معرف_قيمة_مسير = [];
    دع أنواع_الالتقاط: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(رموز_الالتقاط) مثل طبيعي)) {
        دع الرمز: معرف_رمز = رموز_الالتقاط[ف];
        طابق خفض_قيمة_محلي_إلى_مسير(البرنامج, الحالة, الرمز) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            // An owned capture SSF admitted moves into the environment: the
            // local gives up its value, and the environment's destructor
            // drops it.
            دع ينقل: متغير منطقي = خطأ;
            لو (!هل_نوع_معدود_عادي_مسير(الأنواع, القيمة.النوع)) {
                طابق يملك_تخزينا_للغراء(الأنواع, القيمة.النوع) مع
                | نتيجة.نجح(يملك) -> { ينقل := يملك; }
                | نتيجة.خطأ(_) -> { };
            };
            لو (ينقل) {
                طابق اكتب_راية_محلي_خفض(البرنامج, الحالة, الرمز, خطأ) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
            // A plain capture stays owned by the local: the environment
            // holds its own copy of a counted one (a closure value), dropped
            // by the environment's destructor.
            طابق انسخ_قيمة_معدودة_خفض(البرنامج, الحالة, القيمة, الأنواع) مع
            | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> {
                ألحق(قيم_الالتقاط, المحتفظة.المعرف);
                ألحق(أنواع_الالتقاط, المحتفظة.النوع);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        ف := ف + 1;
    }

    دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
    دع عدد_المعاملات: طبيعي;
    طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الإغلاق) مع
    | اختياري.موجود(العدد) -> { عدد_المعاملات := العدد; }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };
    لو (عدد_المعاملات != (الطول(*المعاملات_النحوية) مثل طبيعي)) {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
    };
    ف := 0;
    طالما (ف < عدد_المعاملات) {
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الإغلاق, ف) مع
        | اختياري.موجود(النوع_الدلالي) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
            | اختياري.موجود(نوع_المسير) -> { ألحق(أنواع_المعاملات, نوع_المسير); }
            | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع_الدلالي)); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };
        ف := ف + 1;
    }
    دع نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الإغلاق) مع
    | اختياري.موجود(النوع_الدلالي) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
        | اختياري.موجود(نوع_المسير) -> {
            لو (!هل_نوع_فراغ_للخفض(الأنواع, نوع_المسير)) { نوع_الناتج := اختياري.موجود(نوع_المسير); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع_الدلالي)); };
    }
    | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الإغلاق)); };

    دع معرف_الإغلاق: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &أنواع_المعاملات, نوع_الناتج);
    طابق عين_التقاطات_دالة_مسير(البرنامج, معرف_الإغلاق, &أنواع_الالتقاط) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | اختياري.لا_شيء -> { };
    دع كتلة_الدخول: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, معرف_الإغلاق) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(الكتلة) -> { كتلة_الدخول := الكتلة; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
    دع محليات_فارغة: متجه ربط_محلي_خفض = [];
    دع حالة_الأصل: حالة_خفض_دالة = *الحالة;
    دع حالة_الإغلاق: متغير حالة_خفض_دالة = {
        الدالة: معرف_الإغلاق,
        الكتلة: كتلة_الدخول,
        نشطة: صواب,
        البناء: حالة_الأصل.البناء,
        المحليات: محليات_فارغة,
        له_هدف_خروج_حلقة: خطأ,
        هدف_خروج_حلقة: كتلة_الدخول,
        له_هدف_متابعة_حلقة: خطأ,
        هدف_متابعة_حلقة: كتلة_الدخول,
        عدد_محليات_متابعة_حلقة: 0,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: اختياري.لا_شيء()
    };
    // Drop elaboration, as for a function body (functions.sn): owner storage
    // in the entry block, the body in a fresh block, every return (falling
    // off the end, `أرجع`, `؟`) through the exit block that drops the owners.
    دع إطار_الإغلاق: إطار_إسقاط_خفض;
    طابق افتح_إطار_إسقاط_خفض(البرنامج, معرف_الإغلاق, كتلة_الدخول, نوع_الناتج, الأنواع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | نتيجة.نجح(الإطار) -> { إطار_الإغلاق := الإطار; };
    حالة_الإغلاق.إطار_الإسقاط := اختياري.موجود(إطار_الإغلاق);
    حالة_الإغلاق.الكتلة := إطار_الإغلاق.البداية;

    دع المعاملات: متجه معامل_إغلاق = *المعاملات_النحوية;
    ف := 0;
    طالما (ف < عدد_المعاملات) {
        دع مرجع_المعامل: &معامل_إغلاق = &المعاملات[ف];
        دع المعامل: معامل_إغلاق = *مرجع_المعامل;
        دع رمز_المعامل: معرف_رمز;
        طابق رمز_اسم_للخفض(روابط_الأسماء, &المعامل.الاسم) مع
        | نتيجة.نجح(الرمز) -> { رمز_المعامل := الرمز; }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
        دع قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(معرف_الإغلاق, ف);
        طابق أضف_محلي_خفض(&متغير حالة_الإغلاق, رمز_المعامل, أنواع_المعاملات[ف], اختياري.موجود(قيمة_المعامل)) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // A parameter passed by value is owned by the closure body. Captures
        // are not: the environment owns them and its destructor drops them.
        طابق سجل_مالكا_خفض(البرنامج, &متغير حالة_الإغلاق, رمز_المعامل, الأنواع, دوال_الخفض) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول(رموز_الالتقاط) مثل طبيعي)) {
        دع قيمة_الالتقاط: معرف_قيمة_مسير;
        طابق أصدر_استخراج_التقاط_مسير(
            البرنامج,
            &حالة_الإغلاق.البناء,
            معرف_الإغلاق,
            حالة_الإغلاق.الكتلة,
            ف,
            أنواع_الالتقاط[ف]
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_الالتقاط := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
        طابق أضف_محلي_خفض(
            &متغير حالة_الإغلاق, رموز_الالتقاط[ف], أنواع_الالتقاط[ف], اختياري.موجود(قيمة_الالتقاط)
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }

    // The caller owns the value the body returns.
    طابق خفض_تعبير_مملوكا_إلى_مسير(
        البرنامج, &متغير حالة_الإغلاق, الجسم, الأنواع, أنواع_التعبيرات,
        روابط_الأسماء, دوال_الخفض, هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.قيمة(قيمة_الجسم) -> {
        لو (حالة_الإغلاق.نشطة) {
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإغلاق, اختياري.موجود(قيمة_الجسم.المعرف)) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        لو (حالة_الإغلاق.نشطة) {
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &حالة_الإغلاق, اختياري.لا_شيء()) مع
            | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
    طابق اختم_إطار_إسقاط_خفض(البرنامج, معرف_الإغلاق, &إطار_الإغلاق) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع حالة_الخارج: حالة_خفض_دالة = *الحالة;
    أرجع قيمة_من_بناء_للخفض(
        أصدر_بناء_إغلاق_مسير(
            البرنامج,
            &حالة_الخارج.البناء,
            حالة_الخارج.الدالة,
            حالة_الخارج.الكتلة,
            معرف_الإغلاق,
            &قيم_الالتقاط,
            نوع_الإغلاق
        ),
        نوع_الإغلاق
    );
}

// The value of التعبير for a place that takes ownership of it: a store, an
// argument, an aggregate member, a return. A counted value read from storage
// another owner keeps is copied (drops.sn, "Counted values").
عام عرف خفض_تعبير_مملوكا_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع الناتج: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    );
    طابق الناتج مع
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        أرجع احتفظ_بقراءة_معدودة_خفض(
            البرنامج, الحالة, التعبير, القيمة, الأنواع, روابط_الأسماء, دوال_الخفض
        );
    }
    | _ -> { أرجع الناتج; };
}


// Whether المعرف is one of the function's compile-time parameters.
عرف قيمة_معامل_وقت_ترجمة_للخفض(الدالة: &دالة_مسير, المعرف: معرف_قيمة_مسير): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        لو (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)
            && (*الدالة).معاملات_وقت_الترجمة[ف]
            && قيمتا_مسير_متساويتان((*الدالة).المعاملات[ف].المعرف, المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف انسخ_بايتات_تحقق_للخفض(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// docs/FMT.md, "Compile-time check": a call of a std format function whose
// format string is a literal gets a compile-time obligation before it, the
// call of std.fmt's checker with the literal, the constructor index of each
// element of a vector literal argument vector (as text: `A` plus the index,
// `?` for an element that is not a constructor call) and the literal's
// position. The driver evaluates
// it, reports a nonzero result as a format-string diagnostic at the literal
// and removes it (driver/compile_time.sn). Rust's format_args! checks the
// same at expansion time; here std.fmt's own parser runs at compile time, so
// the compile-time and run-time checks cannot disagree.
عرف أصدر_تحقق_تنسيق_خفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    رمز_الدالة: معرف_رمز,
    الحجج: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    دوال_الخفض: &سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    دع الرموز: &متجه معرف_رمز = &(*دوال_الخفض).رموز_التنسيق;
    لو ((الطول(*الرموز) مثل طبيعي) < 2) { أرجع اختياري.لا_شيء(); };
    دع منسقة: متغير منطقي = خطأ;
    دع ر: متغير طبيعي = 1;
    طالما (ر < (الطول(*الرموز) مثل طبيعي)) {
        لو (معرفا_رمز_متساويان((*الرموز)[ر], رمز_الدالة)) { منسقة := صواب; };
        ر := ر + 1;
    }
    لو (!منسقة) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = الطول(*الحجج) مثل طبيعي;
    لو (العدد < 2) { أرجع اختياري.لا_شيء(); };
    دع القالب: متغير متجه ط8 = [];
    دع نطاق_القالب: متغير نطاق;
    طابق (*الحجج)[العدد - 2] مع
    | تعبير.حرفي(النطاق, حرفي.نص(البايتات)) -> {
        القالب := انسخ_بايتات_تحقق_للخفض(&البايتات);
        نطاق_القالب := النطاق;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الأنواع_الثابتة: متغير متجه ط8 = [];
    دع معروفة: متغير منطقي = خطأ;
    طابق (*الحجج)[العدد - 1] مع
    | تعبير.حرفي_متجه(_, العناصر) -> {
        معروفة := صواب;
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(العناصر) مثل طبيعي)) {
            // `A` plus the constructor index, `?` for an unknown one.
            دع الترتيب: متغير طبيعي = 0x3F;
            طابق العناصر[ع] مع
            | تعبير.استدعاء(_, المستدعى, _) -> {
                طابق *المستدعى مع
                | تعبير.حقل(_, _, اسم_المنشئ) -> {
                    طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, اسم_المنشئ.النطاق) مع
                    | اختياري.موجود(الهوية) -> {
                        طابق نوع_تعبير_عند(أنواع_التعبيرات, نطاق_تعبير(&العناصر[ع])) مع
                        | اختياري.موجود(نوع_العنصر) -> {
                            طابق وصف_منشئ_نوع_دلالي_بالهوية(الأنواع, نوع_العنصر, الهوية) مع
                            | اختياري.موجود(الوصف) -> {
                                لو (الوصف.الترتيب < 26) { الترتيب := 0x41 + الوصف.الترتيب; };
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            }
            | _ -> { };
            ألحق(الأنواع_الثابتة, الترتيب مثل ط8);
            ع := ع + 1;
        }
    }
    | _ -> { };
    دع المدقق: معرف_دالة_مسير;
    طابق دالة_خفض_عند(دوال_الخفض, (*الرموز)[0]) مع
    | اختياري.موجود(الربط) -> {
        طابق الربط.الهدف مع
        | هدف_دالة_خفض.داخلية(المعرف) -> { المدقق := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    لو (المدقق.القيمة >= (الطول((*البرنامج).الدوال) مثل طبيعي)
        || (الطول((*البرنامج).الدوال[المدقق.القيمة].المعاملات) مثل طبيعي) != 6) {
        أرجع اختياري.لا_شيء();
    };
    دع الثوابت: متغير متجه ثابت_مسير = [];
    ألحق(الثوابت, ثابت_مسير.نص(القالب));
    ألحق(الثوابت, ثابت_مسير.نص(الأنواع_الثابتة));
    ألحق(الثوابت, ثابت_مسير.منطق(معروفة));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.البداية.المصدر));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.البداية.البايت));
    ألحق(الثوابت, ثابت_مسير.صحيح_طبيعي(نطاق_القالب.النهاية.البايت));
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6) {
        دع نوع_المعامل: معرف_نوع = (*البرنامج).الدوال[المدقق.القيمة].المعاملات[ف].النوع;
        طابق أصدر_ثابتا_مسير(
            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
            انسخ_ثابت_مسير(&الثوابت[ف]), نوع_المعامل
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ألحق(القيم, المعرف); }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    طابق أصدر_نداء_مسير(
        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
        المدقق, &القيم
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(الناتج) -> {
        دع د: طبيعي = حالة_الإصدار.الدالة.القيمة;
        دع ك: طبيعي = حالة_الإصدار.الكتلة.القيمة;
        لو (د < (الطول((*البرنامج).الدوال) مثل طبيعي) && ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ت: متغير طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
            طالما (ت > 0) {
                ت := ت - 1;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].الناتج مع
                | اختياري.موجود(الموجود) -> {
                    لو (قيمتا_مسير_متساويتان(الموجود.المعرف, الناتج)) {
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                        ت := 0;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
        };
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { };
    أرجع اختياري.لا_شيء();
}

عام عرف خفض_تعبير_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التعبير: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): نتيجة_خفض_تعبير {
    دع النوع_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, التعبير);
    دع النوع: متغير معرف_نوع = معرف_نوع_من(0);
    طابق النوع_نتيجة مع
    | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
        النوع := المعرف;
    }
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    };

    دع حالة_القراءة: حالة_خفض_دالة = *الحالة;
    دع القيمة: تعبير = *التعبير;
    طابق القيمة مع
    | تعبير.حرفي(النطاق, الحرفي) -> {
        أرجع خفض_حرفي_إلى_مسير(البرنامج, الحالة, النطاق, انسخ_مملوكا_حرفي(&الحرفي), النوع, الأنواع);
    }
    | تعبير.اسم(_, الاسم) -> {
        // Name authenticates the exact unbound null occurrence. A missing
        // symbol alone cannot authorize a typed null MSIR constant.
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.لا_شيء -> {
            لو (هل_ظهور_مؤشر_فارغ_سياقي(روابط_الأسماء, الاسم.النطاق)
                && هل_نوع_مؤشر_للخفض(الأنواع, النوع)) {
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_ثابتا_مسير(
                        البرنامج, &حالة_القراءة.البناء,
                        حالة_القراءة.الدالة, حالة_القراءة.الكتلة,
                        ثابت_مسير.مؤشر_فارغ(), النوع
                    ),
                    النوع
                );
            };
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير))
            );
        }
        | اختياري.موجود(_) -> { };
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(ربط_الدالة) -> {
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق ربط_الدالة.الهدف مع
                | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                    دع الالتقاطات_الفارغة: متجه معرف_قيمة_مسير = [];
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_بناء_إغلاق_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            معرف_الدالة,
                            &الالتقاطات_الفارغة,
                            النوع
                        ),
                        النوع
                    );
                }
                | هدف_دالة_خفض.خارجية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                };
            }
            | اختياري.لا_شيء -> {
                طابق موضع_محلي_خفض(الحالة, الرمز) مع
                | اختياري.موجود(موضع_المحلي) -> {
                    // A local of the void Type (a generic instance) holds no value.
                    لو (هل_نوع_فراغ_للخفض(الأنواع, (*الحالة).المحليات[موضع_المحلي].النوع)) {
                        أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                    };
                    دع المقروءة: نتيجة_خفض_تعبير = خفض_قيمة_محلي_إلى_مسير(البرنامج, الحالة, الرمز);
                    // A use SSF recorded as a move: the owner gives up the value.
                    طابق طبق_نقل_محلي_خفض(البرنامج, الحالة, الرمز, &الاسم.النطاق, دوال_الخفض) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    أرجع المقروءة;
                }
                | اختياري.لا_شيء -> {
                    طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
                    }
                    | اختياري.موجود(الربط) -> {
                        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        طابق الربط.الهدف مع
                        | هدف_قيمة_عليا_خفض.ثابت(الثابت) -> {
                            أرجع قيمة_من_بناء_للخفض(
                                أصدر_ثابتا_مسير(
                                    البرنامج,
                                    &حالة_الإصدار.البناء,
                                    حالة_الإصدار.الدالة,
                                    حالة_الإصدار.الكتلة,
                                    انسخ_ثابت_مسير(&الثابت),
                                    الربط.النوع
                                ),
                                الربط.النوع
                            );
                        }
                        | هدف_قيمة_عليا_خفض.عام(العام) -> {
                            طابق أصدر_مكان_عام_مسير(
                                البرنامج,
                                &حالة_الإصدار.البناء,
                                حالة_الإصدار.الدالة,
                                حالة_الإصدار.الكتلة,
                                العام,
                                الربط.النوع,
                                الربط.قابل_للكتابة
                            ) مع
                            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                            }
                            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                            }
                            | نتيجة_بناء_قيمة_مسير.مبنية(المكان) -> {
                                أرجع قيمة_من_بناء_للخفض(
                                    أصدر_تحميل_مسير(
                                        البرنامج,
                                        &حالة_الإصدار.البناء,
                                        حالة_الإصدار.الدالة,
                                        حالة_الإصدار.الكتلة,
                                        المكان,
                                        الربط.النوع
                                    ),
                                    الربط.النوع
                                );
                            };
                        };
                    };
                };
            };
        };
    }
    | تعبير.حقل(النطاق, صندوق_الأصل, اسم_الحقل) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.موجود(رمز_العضو) -> {
            طابق دالة_خفض_عند(دوال_الخفض, رمز_العضو) مع
            | اختياري.موجود(ربط_الدالة) -> {
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                طابق ربط_الدالة.الهدف مع
                | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                    دع الالتقاطات_الفارغة: متجه معرف_قيمة_مسير = [];
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_بناء_إغلاق_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            معرف_الدالة,
                            &الالتقاطات_الفارغة,
                            النوع
                        ),
                        النوع
                    );
                }
                | هدف_دالة_خفض.خارجية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(التعبير)));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        // A field of storage that has a place (`(*r).f`, `x.a.b` of an owner
        // `x`, `v[i].f`) is loaded from the field's place alone.
        لو (جذر_مكان_قراءة_للخفض(
            الحالة, &(*صندوق_الأصل), الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        )) {
            أرجع خفض_قراءة_إسقاط_مكان_إلى_مسير(
                البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        };
        دع الأصل: تعبير = *صندوق_الأصل;
        دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
        طابق معرف_اسم_محلول_عند(روابط_الأسماء, اسم_الحقل.النطاق) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.ربط_اسم_مفقود(اسم_الحقل.النطاق)
            );
        }
        | اختياري.موجود(المعرف) -> {
            هوية_الحقل := المعرف;
        };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
            طابق وصف_حقل_سجل_دلالي_بالاسم(الأنواع, قيمة_الأصل.النوع, هوية_الحقل) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, قيمة_الأصل.النوع)
                );
            }
            | اختياري.موجود(الوصف) -> {
                لو (!نوعان_متوافقان(الأنواع, الوصف.النوع, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                دع المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                    أصدر_استخراج_حقل_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        قيمة_الأصل.المعرف,
                        الوصف.الترتيب,
                        الوصف.النوع
                    ),
                    الوصف.النوع
                );
                // A field of a temporary (`make().f`): the rest of it is
                // destroyed (drops.sn, أسقط_بقية_مؤقت_خفض).
                لو (هل_أصل_مؤقت_للخفض(&الأصل)) {
                    طابق أسقط_بقية_مؤقت_خفض(
                        البرنامج, الحالة, قيمة_الأصل, الوصف.الترتيب, الوصف.النوع, الأنواع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
                أرجع المقروء;
            };
        };
    }
    | تعبير.فهرس(النطاق, صندوق_الأصل, صندوق_الفهرس) -> {
        دع الأصل: تعبير = *صندوق_الأصل;
        دع الفهرس: تعبير = *صندوق_الفهرس;
        دع نوع_الأصل_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, &الأصل);
        دع نوع_الأصل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_الأصل_نتيجة مع
        | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
            نوع_الأصل := المعرف;
        }
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        };
        طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الأصل) مع
        | اختياري.موجود(عدد_العناصر) -> {
            دع الموضع: متغير طبيعي = 0;
            طابق الفهرس مع
            | تعبير.حرفي(_, حرفي.عدد(القيمة)) -> {
                لو (القيمة < 0) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
                الموضع := القيمة مثل طبيعي;
            }
            | تعبير.حرفي(_, حرفي.عدد_طبيعي(القيمة)) -> {
                الموضع := القيمة;
            }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
            لو (الموضع >= عدد_العناصر) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
            طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الأصل, الموضع) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الأصل)
                );
            }
            | اختياري.موجود(نوع_العنصر) -> {
                لو (!معرفا_نوع_متساويان(نوع_العنصر, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    دع المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                        أصدر_استخراج_حقل_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            قيمة_الأصل.المعرف,
                            الموضع,
                            نوع_العنصر
                        ),
                        نوع_العنصر
                    );
                    لو (هل_أصل_مؤقت_للخفض(&الأصل)) {
                        طابق أسقط_بقية_مؤقت_خفض(
                            البرنامج, الحالة, قيمة_الأصل, الموضع, نوع_العنصر, الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                    أرجع المقروء;
                };
            };
        }
        | اختياري.لا_شيء -> {
            لو (هل_نوع_مؤشر_للخفض(الأنواع, نوع_الأصل)) {
                أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
                    البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                );
            };
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &الأصل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_الأصل) -> {
                طابق خفض_تعبير_إلى_مسير(
                    البرنامج, الحالة, &الفهرس, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الفهرس) -> {
                    // An index read outside a vector or text traps.
                    لو (نوع_يتحقق_من_حدود_فهرسه_للخفض(الأنواع, قيمة_الأصل.النوع)) {
                        طابق تحقق_حدود_فهرس_قيمة_للخفض(
                            البرنامج, الحالة, النطاق, قيمة_الأصل.المعرف, قيمة_الفهرس, الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    دع المقروء: نتيجة_خفض_تعبير = قيمة_من_بناء_للخفض(
                        أصدر_استخراج_فهرس_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            قيمة_الأصل.المعرف,
                            قيمة_الفهرس.المعرف,
                            النوع
                        ),
                        النوع
                    );
                    // An element of a temporary vector (`make()[i]`).
                    لو (هل_أصل_مؤقت_للخفض(&الأصل)) {
                        طابق المقروء مع
                        | نتيجة_خفض_تعبير.قيمة(العنصر) -> {
                            طابق أسقط_متجها_مؤقتا_بعد_عنصر_خفض(
                                البرنامج, الحالة, قيمة_الأصل, العنصر, الأنواع
                            ) مع
                            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                            | نتيجة.نجح(المحفوظ) -> { أرجع نتيجة_خفض_تعبير.قيمة(المحفوظ); };
                        }
                        | _ -> { };
                    };
                    أرجع المقروء;
                };
            };
        };
    }
    | تعبير.فك_موضع(_, _) -> {
        أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
            البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    }
    | تعبير.ثنائي(النطاق, العامل, صندوق_اليسار, صندوق_اليمين) -> {
        دع اليسار: تعبير = *صندوق_اليسار;
        دع اليمين: تعبير = *صندوق_اليمين;
        طابق العامل مع
        | عامل_ثنائي.و -> {
            أرجع اخفض_منطق_قصير_إلى_مسير(
                البرنامج,
                الحالة,
                النطاق,
                العامل,
                &اليسار,
                &اليمين,
                النوع,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            );
        }
        | عامل_ثنائي.أو -> {
            أرجع اخفض_منطق_قصير_إلى_مسير(
                البرنامج,
                الحالة,
                النطاق,
                العامل,
                &اليسار,
                &اليمين,
                النوع,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            );
        }
        | _ -> { };
        دع نتيجة_أ: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &اليسار,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
        طابق نتيجة_أ مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(أ) -> {
            دع نتيجة_ب: نتيجة_خفض_تعبير = خفض_تعبير_إلى_مسير(
                البرنامج,
                الحالة,
                &اليمين,
                الأنواع,
                أنواع_التعبيرات,
                روابط_الأسماء,
                دوال_الخفض,
                هويات_البدائيات
            );
            طابق نتيجة_ب مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
            }
            | نتيجة_خفض_تعبير.قيمة(ب) -> {
                لو (هل_نوع_عشري_للخفض(الأنواع, أ.النوع) && معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                    طابق عملية_حساب_عشري_من_عامل_للخفض(العامل) مع
                    | اختياري.موجود(عملية_عشرية) -> {
                        لو (!معرفا_نوع_متساويان(أ.النوع, النوع)) {
                            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
                        };
                        دع حالة_عشرية: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_من_بناء_للخفض(أصدر_حسابا_عشريا_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, عملية_عشرية, أ.المعرف, ب.المعرف, النوع), النوع);
                    }
                    | اختياري.لا_شيء -> {
                        طابق عملية_مقارنة_عشرية_من_عامل_للخفض(العامل) مع
                        | اختياري.موجود(مقارنة_عشرية) -> {
                            لو (!هل_نوع_منطقي_للخفض(الأنواع, النوع)) { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)); };
                            دع حالة_عشرية: حالة_خفض_دالة = *الحالة;
                            أرجع قيمة_من_بناء_للخفض(أصدر_مقارنة_عشرية_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, مقارنة_عشرية, أ.المعرف, ب.المعرف, النوع), النوع);
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
                طابق عملية_حساب_من_عامل_للخفض(العامل, النوع, الأنواع) مع
                | اختياري.موجود(العملية) -> {
                    // Frontend typing propagates an expected integer Type
                    // into both operands and accepts implicitly-safe
                    // widening there (e.g. طبيعي within a ط64 context).
                    // Materialize exactly those canonical conversions here;
                    // anything else remains unsupported.
                    دع أ_المحول: متغير قيمة_خفض_مسير = أ;
                    دع ب_المحول: متغير قيمة_خفض_مسير = ب;
                    طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(البرنامج, الحالة, النطاق, أ, النوع, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(المحول) -> { أ_المحول := المحول; }
                    | _ -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                        );
                    };
                    طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(البرنامج, الحالة, النطاق, ب, النوع, الأنواع) مع
                    | نتيجة_خفض_تعبير.قيمة(المحول) -> { ب_المحول := المحول; }
                    | _ -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                        );
                    };
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_حسابا_صحيحا_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            العملية,
                            أ_المحول.المعرف,
                            ب_المحول.المعرف,
                            النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> {
                    طابق عملية_مقارنة_من_عامل_للخفض(العامل) مع
                    | اختياري.موجود(المقارنة) -> {
                        لو ((!معرفا_نوع_متساويان(أ.النوع, ب.النوع))
                            || (!هل_نوع_منطقي_للخفض(الأنواع, النوع))) {
                            أرجع نتيجة_خفض_تعبير.مرفوض(
                                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                            );
                        };
                        دع عامل_يساوي: عامل_ثنائي = عامل_ثنائي.يساوي();
                        دع عامل_لا_يساوي: عامل_ثنائي = عامل_ثنائي.لا_يساوي();
                        دع مساواة: متغير منطقي = خطأ;
                        لو (العامل == عامل_يساوي) { مساواة := صواب; };
                        لو (العامل == عامل_لا_يساوي) { مساواة := صواب; };
                        لو (مساواة && هل_نوع_منطقي_للخفض(الأنواع, أ.النوع)) {
                            أرجع اخفض_مساواة_منطقية_مسير(
                                البرنامج, الحالة, النطاق, العامل, أ, ب, النوع
                            );
                        };
                        لو (مساواة && هل_نوع_موسوم_بلا_حمولات_للخفض(الأنواع, أ.النوع)) {
                            أرجع اخفض_مقارنة_وسمين_بلا_حمولات_إلى_مسير(
                                البرنامج, الحالة, النطاق, العامل, أ, ب, النوع, الأنواع
                            );
                        };
                        لو (هل_نوع_مؤشر_للخفض(الأنواع, أ.النوع)) {
                            // Pointer identity uses the existing typed equality
                            // operation, never a pointer-to-integer conversion.
                            لو (!مساواة) {
                                أرجع نتيجة_خفض_تعبير.مرفوض(
                                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                            };
                        } وإلا {
                            طابق وصف_صحيح_للخفض(الأنواع, أ.النوع) مع
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(
                                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                            }
                            | اختياري.موجود(_) -> { };
                        };
                        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_من_بناء_للخفض(
                            أصدر_مقارنة_صحيح_مسير(
                                البرنامج,
                                &حالة_الإصدار.البناء,
                                حالة_الإصدار.الدالة,
                                حالة_الإصدار.الكتلة,
                                المقارنة,
                                أ.المعرف,
                                ب.المعرف,
                                النوع
                            ),
                            النوع
                        );
                    }
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                        );
                    };
                };
            };
        };
    }
    | تعبير.أحادي(النطاق, العامل, صندوق_الداخل) -> {
        دع الداخل: تعبير = *صندوق_الداخل;
        طابق العامل مع
        | عامل_أحادي.عنوان -> {
            طابق خفض_مكان_إلى_مسير(
                البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_مكان.مكان(المكان) -> {
                أرجع اخفض_مرجع_مكان_مقنن(البرنامج, الحالة, المكان, النوع);
            };
        }
        | عامل_أحادي.عنوان_متغير -> {
            طابق خفض_مكان_إلى_مسير(
                البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            ) مع
            | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            }
            | نتيجة_خفض_مكان.مكان(المكان) -> {
                أرجع اخفض_مرجع_مكان_مقنن(البرنامج, الحالة, المكان, النوع);
            };
        }
        | عامل_أحادي.فك -> {
            أرجع خفض_مكان_ثم_تحميل_إلى_مسير(
                البرنامج, الحالة, التعبير, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        }
        | _ -> { };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &الداخل,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(الداخل_قيمة) -> {
            طابق العامل مع
            | عامل_أحادي.سالب -> {
                لو (هل_نوع_عشري_للخفض(الأنواع, النوع)) {
                    // -x is -0.0 - x: the IEEE negation of every non-NaN
                    // value, zeros included (0.0 - x gave +0 for -(+0)).
                    دع صفر_بايتات: متجه ط8 = بايتات_من_نص(«-0.0»);
                    دع صفر_نتيجة: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(البرنامج, الحالة, النطاق, حرفي.عدد_عشري(صفر_بايتات), النوع, الأنواع);
                    طابق صفر_نتيجة مع
                    | نتيجة_خفض_تعبير.قيمة(صفر) -> {
                        دع حالة_عشرية: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_من_بناء_للخفض(أصدر_حسابا_عشريا_مسير(البرنامج, &حالة_عشرية.البناء, حالة_عشرية.الدالة, حالة_عشرية.الكتلة, عملية_حساب_عشري.طرح(), صفر.المعرف, الداخل_قيمة.المعرف, النوع), النوع);
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
                };
                طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                }
                | اختياري.موجود(_) -> {
                    دع صفر_نتيجة: نتيجة_خفض_تعبير = خفض_حرفي_إلى_مسير(
                        البرنامج,
                        الحالة,
                        النطاق,
                        حرفي.عدد(0),
                        النوع,
                        الأنواع
                    );
                    طابق صفر_نتيجة مع
                    | نتيجة_خفض_تعبير.قيمة(صفر) -> {
                        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                        أرجع قيمة_من_بناء_للخفض(
                            أصدر_حسابا_صحيحا_مسير(
                                البرنامج,
                                &حالة_الإصدار.البناء,
                                حالة_الإصدار.الدالة,
                                حالة_الإصدار.الكتلة,
                                عملية_حساب_صحيح.طرح(),
                                صفر.المعرف,
                                الداخل_قيمة.المعرف,
                                النوع
                            ),
                            النوع
                        );
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                        );
                    };
                };
            }
            | عامل_أحادي.نفي -> {
                أرجع اخفض_نفي_منطقي_إلى_مسير(
                    البرنامج,
                    الحالة,
                    النطاق,
                    الداخل_قيمة,
                    النوع,
                    الأنواع
                );
            }
            | عامل_أحادي.متمم -> {
                أرجع اخفض_متمم_صحيح_إلى_مسير(
                    البرنامج, الحالة, النطاق, الداخل_قيمة, النوع, الأنواع
                );
            }
            | _ -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                );
            };
        };
    }
    | تعبير.استدعاء(النطاق, صندوق_الدالة, الحجج) -> {
        دع تعبير_الدالة: تعبير = *صندوق_الدالة;
        طابق تعبير_الدالة مع
        | تعبير.حقل(_, _, اسم_المنشئ) -> {
            // Constructor identity is the canonical distinction here. A qualified enum constructor
            // carries constructor identity on its field name; a function-valued record field does not.
            طابق هوية_منشئ_تعبير_عند(أنواع_التعبيرات, اسم_المنشئ.النطاق) مع
            | اختياري.موجود(_) -> {
                أرجع اخفض_استدعاء_منشئ_إلى_مسير(
                    البرنامج,
                    الحالة,
                    النطاق,
                    &اسم_المنشئ,
                    &الحجج,
                    النوع,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                );
            }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        دع استبدالات_النداء: متغير متجه ربط_استبدال_نوع = [];
        طابق استبدالات_نوع_استدعاء_عند(أنواع_التعبيرات, النطاق) مع
        | اختياري.موجود(القيم) -> { استبدالات_النداء := القيم; }
        | اختياري.لا_شيء -> { };
        دع رمز_الدالة: متغير معرف_رمز = معرف_رمز_من(0);
        طابق تعبير_الدالة مع
        | تعبير.اسم(_, الاسم) -> {
            طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
            | نتيجة.نجح(الرمز) -> {
                رمز_الدالة := الرمز;
                دع مباشر: متغير منطقي = خطأ;
                طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
                | اختياري.موجود(_) -> { مباشر := صواب; }
                | اختياري.لا_شيء -> {
                    طابق دالة_خفض_بمثيل_عند(دوال_الخفض, الرمز, &استبدالات_النداء) مع
                    | اختياري.موجود(_) -> { مباشر := صواب; }
                    | اختياري.لا_شيء -> { };
                };
                لو (!مباشر) {
                    أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                        البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                        الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    );
                };
            }
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
            };
        }
        | تعبير.حقل(_, _, الاسم) -> {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
            | اختياري.موجود(الرمز) -> {
                رمز_الدالة := الرمز;
                دع مباشر: متغير منطقي = خطأ;
                طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, الرمز) مع
                | اختياري.موجود(_) -> { مباشر := صواب; }
                | اختياري.لا_شيء -> {
                    طابق دالة_خفض_بمثيل_عند(دوال_الخفض, الرمز, &استبدالات_النداء) مع
                    | اختياري.موجود(_) -> { مباشر := صواب; }
                    | اختياري.لا_شيء -> { };
                };
                لو (!مباشر) {
                    أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                        البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                        الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    );
                };
            }
            | اختياري.لا_شيء -> {
                أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                    البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            };
        }
        | _ -> {
            أرجع اخفض_استدعاء_غير_مباشر_إلى_مسير(
                البرنامج, الحالة, النطاق, &تعبير_الدالة, انسخ_مملوكا_متجه_تعبير(&الحجج), النوع,
                الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            );
        };
        طابق أصدر_تحقق_تنسيق_خفض(
            البرنامج, الحالة, رمز_الدالة, &الحجج, الأنواع, أنواع_التعبيرات, دوال_الخفض
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
        | اختياري.لا_شيء -> { };
        // هوية البدائي تأتي حصرا من الاستعلام الدلالي المقنن في Frontend.
        // لا نشتقها من التهجئة ولا نحولها هنا إلى عقد خدمة Runtime.
        طابق هوية_بدائي_في_روابط_رموز(هويات_البدائيات, رمز_الدالة) مع
        | اختياري.موجود(هوية_البدائي) -> {
            // Owned partial projections remain illegal in SSF. The private place-swap
            // intrinsic is the canonical atomic escape hatch: it never exposes a hole,
            // and lowers completely to ordinary verified MSIR place operations.
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.إزالة_الأخير -> {
                أرجع اخفض_إزالة_أو_اقتطاع_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, &الحجج, النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            }
            | هوية_بدائي_مترجم.اقتطاع_متجه -> {
                أرجع اخفض_إزالة_أو_اقتطاع_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, &الحجج, النوع,
                    الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            }
            | هوية_بدائي_مترجم.تبديل_موضعين -> {
                لو ((الطول(الحجج) مثل طبيعي) != 2) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
                    );
                };
                دع المكان_الأول: متغير مكان_خفض_مسير;
                طابق خفض_مكان_إلى_مسير(
                    البرنامج, الحالة, &الحجج[0], الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> { المكان_الأول := المكان; };

                دع المكان_الثاني: متغير مكان_خفض_مسير;
                طابق خفض_مكان_إلى_مسير(
                    البرنامج, الحالة, &الحجج[1], الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                ) مع
                | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_مكان.مكان(المكان) -> { المكان_الثاني := المكان; };

                دع القيمة_الأولى: متغير قيمة_خفض_مسير;
                طابق اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان_الأول) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { القيمة_الأولى := القيمة; };

                دع القيمة_الثانية: متغير قيمة_خفض_مسير;
                طابق اخفض_تحميل_مكان_مقنن(البرنامج, الحالة, المكان_الثاني) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
                }
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { القيمة_الثانية := القيمة; };

                دع حالة_التبديل: حالة_خفض_دالة = *الحالة;
                طابق أصدر_تخزين_مسير(
                    البرنامج,
                    &حالة_التبديل.البناء,
                    حالة_التبديل.الدالة,
                    حالة_التبديل.الكتلة,
                    المكان_الأول.المعرف,
                    القيمة_الثانية.المعرف
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | _ -> { };
                طابق أصدر_تخزين_مسير(
                    البرنامج,
                    &حالة_التبديل.البناء,
                    حالة_التبديل.الدالة,
                    حالة_التبديل.الكتلة,
                    المكان_الثاني.المعرف,
                    القيمة_الأولى.المعرف
                ) مع
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | _ -> { };
                أرجع نتيجة_خفض_تعبير.بلا_قيمة();
            }
            | _ -> { };

            دع النوع_الصفري: معرف_نوع = معرف_نوع_من(0);
            دع القيم_المقننة_للبدائي: متغير أنواع_استدعاء_بدائي_مقننة = {
                النص: النوع_الصفري,
                العدد: النوع_الصفري,
                عدد_ط32: النوع_الصفري,
                عدد_ط64: النوع_الصفري,
                عائم_ع32: النوع_الصفري,
                عائم_ع64: النوع_الصفري,
                عدد_طبيعي: النوع_الصفري
            };
            طابق أنواع_استدعاء_بدائي_مقننة_من_سجل(الأنواع) مع
            | اختياري.موجود(القيم) -> { القيم_المقننة_للبدائي := القيم; }
            | اختياري.لا_شيء -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_غير_محلول(النطاق));
            };
            دع قيم_الحجج_البدائية: متغير متجه معرف_قيمة_مسير = [];
            دع أنواع_الحجج_البدائية: متغير متجه معرف_نوع = [];
            دع نطاقات_الذاكرة_البدائية: متغير متجه نطاق_ذاكرة_نداء_مسير = [];
            دع مكان_تعديل_البدائي: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            دع ف_بدائي: متغير طبيعي = 0;
            طالما (ف_بدائي < (الطول(الحجج) مثل طبيعي)) {
                دع مرجع_الحجة_البدائية: &تعبير = &الحجج[ف_بدائي];
                دع الحجة_البدائية: تعبير = *مرجع_الحجة_البدائية;

                // البدائيات المعدلة لقيمة تحتاج مكان lvalue المقنن إضافة إلى قيمة الحجة.
                // هذا يبقي المفسر والخلفيات على نفس موضع التعديل دون إعادة بناء الهوية.
                دع حجة_تعديل_بدائي: متغير منطقي = خطأ;
                طابق هوية_البدائي مع
                | هوية_بدائي_مترجم.إلحاق -> { حجة_تعديل_بدائي := ف_بدائي == 0; }
                | هوية_بدائي_مترجم.حجز_سعة_متجه -> { حجة_تعديل_بدائي := ف_بدائي == 0; }
                | _ -> { };
                لو (حجة_تعديل_بدائي) {
                    طابق خفض_مكان_إلى_مسير(
                        البرنامج, الحالة, &الحجة_البدائية, الأنواع,
                        أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                    ) مع
                    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_مكان.مكان(المكان) -> {
                        مكان_تعديل_البدائي := اختياري.موجود(المكان.المعرف);
                    };
                };

                طابق خفض_تعبير_إلى_مسير(
                    البرنامج,
                    الحالة,
                    &الحجة_البدائية,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                    );
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة_المقروءة) -> {
                    // An appended element is owned by the vector.
                    دع قيمة_الحجة: متغير قيمة_خفض_مسير = قيمة_الحجة_المقروءة;
                    طابق هوية_البدائي مع
                    // The address of a closure keeps one reference of its own
                    // (the thread that runs it); the operand keeps its own.
                    | هوية_بدائي_مترجم.عنوان_دالة -> {
                        طابق احتفظ_بقراءة_معدودة_خفض(
                            البرنامج, الحالة, &الحجة_البدائية, قيمة_الحجة_المقروءة,
                            الأنواع, روابط_الأسماء, دوال_الخفض
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> { قيمة_الحجة := المحتفظة; }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                    }
                    | هوية_بدائي_مترجم.إلحاق -> {
                        لو (ف_بدائي == 1) {
                            طابق احتفظ_بقراءة_معدودة_خفض(
                                البرنامج, الحالة, &الحجة_البدائية, قيمة_الحجة_المقروءة,
                                الأنواع, روابط_الأسماء, دوال_الخفض
                            ) مع
                            | نتيجة_خفض_تعبير.قيمة(المحتفظة) -> { قيمة_الحجة := المحتفظة; }
                            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                            | نتيجة_خفض_تعبير.بلا_قيمة -> { };
                        };
                    }
                    | _ -> { };
                    دع القيمة_المقننة: متغير قيمة_خفض_مسير = قيمة_الحجة;
                    طابق نوع_حجة_بدائية_متوقعة(
                        الأنواع,
                        &القيم_المقننة_للبدائي,
                        هوية_البدائي,
                        ف_بدائي,
                        &أنواع_الحجج_البدائية
                    ) مع
                    | اختياري.موجود(النوع_المتوقع) -> {
                        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                            البرنامج,
                            الحالة,
                            نطاق_تعبير(&الحجة_البدائية),
                            قيمة_الحجة,
                            النوع_المتوقع,
                            الأنواع
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                            القيمة_المقننة := القيمة;
                        }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                        }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> {
                            أرجع نتيجة_خفض_تعبير.مرفوض(
                                خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                            );
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    طابق هوية_البدائي مع
                    | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                        طابق معرف_نوع_أساس_عند(الأنواع, قيمة_الحجة.النوع) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(مرجع_النوع_32) -> {
                            طابق (*الأنواع).الأنواع[مرجع_النوع_32.القيمة] مع
                            | نوع_مقنن.مرجع(العنصر, مرجع_متغير) -> {
                            // The mutable inner wrapper has its own canonical
                            // Type identity; resolve it from the shared registry.
                            دع معرف_عنصر: متغير معرف_نوع = العنصر;
                            لو (مرجع_متغير) {
                                طابق معرف_نوع_مغلف_متغير_موجود(الأنواع, العنصر) مع
                                | اختياري.موجود(المعرف) -> { معرف_عنصر := المعرف; }
                                | اختياري.لا_شيء -> {
                                    أرجع نتيجة_خفض_تعبير.مرفوض(
                                        خطأ_خفض_مسير.نوع_غير_محلول(نطاق_تعبير(&الحجة_البدائية))
                                    );
                                };
                            };
                            دع نوع_المؤشر: معرف_نوع;
                            طابق معرف_نوع_مؤشر_مقنن_موجود(الأنواع, معرف_عنصر) مع
                            | اختياري.موجود(المعرف) -> { نوع_المؤشر := المعرف; }
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(
                                    خطأ_خفض_مسير.نوع_غير_محلول(نطاق_تعبير(&الحجة_البدائية))
                                );
                            };
                            طابق اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                                البرنامج, الحالة, نطاق_تعبير(&الحجة_البدائية), قيمة_الحجة, نوع_المؤشر, الأنواع
                            ) مع
                            | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                                القيمة_المقننة := القيمة;
                            }
                            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                            }
                            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                                أرجع نتيجة_خفض_تعبير.مرفوض(
                                    خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة_البدائية))
                                );
                            };
                        }
                            | _ -> { };
                        };
                        // A machine pointer is not evidence of storage. Only a
                        // directly converted, typed reference is eligible.
                        لو (!قيمتا_مسير_متساويتان(قيمة_الحجة.المعرف, القيمة_المقننة.المعرف)) {
                            طابق انشئ_نطاق_ذاكرة_حجة_خام(
                                البرنامج, الحالة, الأنواع,
                                القيم_المقننة_للبدائي.عدد_ط64, ف_بدائي,
                                قيمة_الحجة, القيمة_المقننة
                            ) مع
                            | اختياري.موجود(النطاق) -> {
                                ألحق(نطاقات_الذاكرة_البدائية, النطاق);
                            }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                    ألحق(قيم_الحجج_البدائية, القيمة_المقننة.المعرف);
                    ألحق(أنواع_الحجج_البدائية, القيمة_المقننة.النوع);
                };
                ف_بدائي := ف_بدائي + 1;
            }

            دع عقد_النواة_البدائية: متغير اختياري عقد_نواة_مسير = اختياري.لا_شيء();
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                لو ((الطول(الحجج) مثل طبيعي) == 7 &&
                    (الطول(قيم_الحجج_البدائية) مثل طبيعي) == 7) {
                    طابق عقد_عملية_لينكس_من_تعبير(
                        &الحجج[0], قيم_الحجج_البدائية[0], روابط_الأسماء, دوال_الخفض
                    ) مع
                    | اختياري.موجود(العقد) -> {
                        لو (أكمل_عقد_ذاكرة_نداء_لينكس(
                            البرنامج, الحالة, القيم_المقننة_للبدائي.عدد_ط64,
                            العقد, &قيم_الحجج_البدائية, &متغير نطاقات_الذاكرة_البدائية
                        )) { عقد_النواة_البدائية := اختياري.موجود(العقد); };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            // Wrapping arithmetic primitives are the non-trapping MSIR operations.
            طابق عملية_بدائي_ملتف_للخفض(هوية_البدائي) مع
            | اختياري.موجود(العملية_الملتفة) -> {
                لو ((الطول(قيم_الحجج_البدائية) مثل طبيعي) != 2) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق));
                };
                أرجع اخفض_حسابا_ملتفا_مسير(
                    البرنامج, الحالة, النطاق, هوية_البدائي, العملية_الملتفة,
                    قيم_الحجج_البدائية[0], قيم_الحجج_البدائية[1], أنواع_الحجج_البدائية[0], الأنواع
                );
            }
            | اختياري.لا_شيء -> { };
            دع حالة_النداء_البدائي: حالة_خفض_دالة = *الحالة;
            دع نوع_ناتج_البدائي: متغير اختياري معرف_نوع = اختياري.موجود(النوع);
            لو (هل_نوع_فراغ_للخفض(الأنواع, النوع)) {
                نوع_ناتج_البدائي := اختياري.لا_شيء();
            };
            دع نتيجة_النداء_البدائي: نتيجة_بناء_قيمة_مسير;
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.نداء_نواة_خام -> {
                نتيجة_النداء_البدائي := أصدر_نداء_بدائي_بوصف_ذاكرة_مسير(
                    البرنامج, &حالة_النداء_البدائي.البناء,
                    حالة_النداء_البدائي.الدالة, حالة_النداء_البدائي.الكتلة,
                    هوية_البدائي, &قيم_الحجج_البدائية,
                    نوع_ناتج_البدائي, مكان_تعديل_البدائي,
                    &نطاقات_الذاكرة_البدائية, عقد_النواة_البدائية
                );
            }
            | _ -> {
                نتيجة_النداء_البدائي := أصدر_نداء_بدائي_مسير(
                    البرنامج, &حالة_النداء_البدائي.البناء,
                    حالة_النداء_البدائي.الدالة, حالة_النداء_البدائي.الكتلة,
                    هوية_البدائي, &قيم_الحجج_البدائية,
                    نوع_ناتج_البدائي, مكان_تعديل_البدائي
                );
            };
            // طول and استنساخ read their operand without consuming it. A call
            // result passed straight to them has no other owner (C5).
            دع بدائي_قارئ: متغير منطقي = خطأ;
            طابق هوية_البدائي مع
            | هوية_بدائي_مترجم.طول -> { بدائي_قارئ := صواب; }
            | هوية_بدائي_مترجم.استنساخ -> { بدائي_قارئ := صواب; }
            | _ -> { };
            لو (بدائي_قارئ && (الطول(الحجج) مثل طبيعي) == 1
                && (الطول(قيم_الحجج_البدائية) مثل طبيعي) == 1) {
                لو (هل_أصل_مؤقت_للخفض(&الحجج[0])) {
                    طابق نتيجة_النداء_البدائي مع
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { }
                    | _ -> {
                        طابق أسقط_قيمة_خفض(
                            البرنامج, الحالة, قيم_الحجج_البدائية[0],
                            أنواع_الحجج_البدائية[0], الأنواع
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            };
            طابق نوع_ناتج_البدائي مع
            | اختياري.موجود(_) -> {
                أرجع قيمة_من_بناء_للخفض(نتيجة_النداء_البدائي, النوع);
            }
            | اختياري.لا_شيء -> {
                طابق نتيجة_النداء_البدائي مع
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                    );
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
            };
        }
        | اختياري.لا_شيء -> { };

        طابق دالة_خفض_بمثيل_عند(دوال_الخفض, رمز_الدالة, &استبدالات_النداء) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_الدالة)
            );
        }
        | اختياري.موجود(ربط_الدالة) -> {
            لو ((الطول(الحجج) مثل طبيعي)
                != (الطول(ربط_الدالة.المعاملات) مثل طبيعي)) {
                أرجع نتيجة_خفض_تعبير.مرفوض(
                    خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق)
                );
            };
            دع قيم_الحجج: متغير متجه معرف_قيمة_مسير = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                دع مرجع_الحجة: &تعبير = &الحجج[ف];
                دع الحجة: تعبير = *مرجع_الحجة;
                طابق خفض_تعبير_مملوكا_إلى_مسير(
                    البرنامج,
                    الحالة,
                    &الحجة,
                    الأنواع,
                    أنواع_التعبيرات,
                    روابط_الأسماء,
                    دوال_الخفض,
                    هويات_البدائيات
                ) مع
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة))
                    );
                }
                | نتيجة_خفض_تعبير.قيمة(قيمة_الحجة) -> {
                    دع المتوقع: معرف_نوع = ربط_الدالة.المعاملات[ف];
                    طابق امتلك_متجها_معروضا_خفض(
                        البرنامج, الحالة, &الحجة, قيمة_الحجة, المتوقع, الأنواع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                        البرنامج,
                        الحالة,
                        نطاق_تعبير(&الحجة),
                        قيمة_الحجة,
                        المتوقع,
                        الأنواع
                    ) مع
                    | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                        ألحق(قيم_الحجج, القيمة_المقننة.المعرف);
                    }
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع نتيجة_خفض_تعبير.مرفوض(
                            خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(&الحجة))
                        );
                    };
                };
                ف := ف + 1;
            }
            دع حالة_النداء: حالة_خفض_دالة = *الحالة;
            دع نتيجة_النداء: متغير نتيجة_بناء_قيمة_مسير = نتيجة_بناء_قيمة_مسير.بلا_قيمة();
            طابق ربط_الدالة.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_الدالة) -> {
                نتيجة_النداء := أصدر_نداء_مسير(
                    البرنامج,
                    &حالة_النداء.البناء,
                    حالة_النداء.الدالة,
                    حالة_النداء.الكتلة,
                    معرف_الدالة,
                    &قيم_الحجج
                );
            }
            | هدف_دالة_خفض.خارجية(معرف_الخارجية) -> {
                نتيجة_النداء := أصدر_نداء_خارجي_مسير(
                    البرنامج,
                    &حالة_النداء.البناء,
                    حالة_النداء.الدالة,
                    حالة_النداء.الكتلة,
                    معرف_الخارجية,
                    &قيم_الحجج
                );
            };
            طابق ربط_الدالة.الناتج مع
            | اختياري.موجود(نوع_الناتج) -> {
                لو (!معرفا_نوع_متساويان(نوع_الناتج, النوع)) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع)
                    );
                };
                أرجع قيمة_من_بناء_للخفض(نتيجة_النداء, النوع);
            }
            | اختياري.لا_شيء -> {
                طابق نتيجة_النداء مع
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.بلا_قيمة();
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
                    );
                }
                | نتيجة_بناء_قيمة_مسير.مبنية(_) -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(
                        خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
                    );
                };
            };
        };
    }
    | تعبير.تسلسل_وقت_الترجمة(النطاق, التعابير) -> {
        دع الأخير: متغير اختياري قيمة_خفض_مسير = اختياري.لا_شيء();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التعابير) مثل طبيعي)) {
            طابق خفض_تعبير_إلى_مسير(
                البرنامج, الحالة, &التعابير[ف], الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                دع المعرف: معرف_قيمة_مسير = القيمة.المعرف;
                دع د: طبيعي = المعرف.الدالة.القيمة;
                دع وجد: متغير منطقي = خطأ;
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
                    دع ت: متغير طبيعي = 0;
                    طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                        طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].الناتج مع
                        | اختياري.موجود(موجود) -> {
                            لو (قيمتا_مسير_متساويتان(موجود.المعرف, المعرف)) {
                                (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                                وجد := صواب;
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        ت := ت + 1;
                    }
                    ك := ك + 1;
                }
                لو (!وجد) {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق));
                };
                الأخير := اختياري.موجود(القيمة);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق));
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
            ف := ف + 1;
        }
        طابق الأخير مع
        | اختياري.موجود(القيمة) -> { أرجع نتيجة_خفض_تعبير.قيمة(القيمة); }
        | اختياري.لا_شيء -> { أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)); };
    }
    | تعبير.وقت_الترجمة(النطاق, المملوك) -> {
        // A simple literal can be resolved before all functions have bodies.
        // All other typed expressions are lowered into canonical MSIR and
        // marked for mandatory bounded interpretation at the driver boundary.
        دع الداخل: تعبير = *المملوك;
        طابق قيم_تعبير_ثابت_للخفض(
            &الداخل, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض
        ) مع
        | نتيجة_تقييم_ثابت_خفض.ثابت(الثابت) -> {
            دع البناء: حالة_خفض_دالة = *الحالة;
            دع الناتج: نتيجة_بناء_قيمة_مسير = أصدر_ثابتا_مسير(
                البرنامج, &البناء.البناء, البناء.الدالة, البناء.الكتلة, الثابت, النوع
            );
            أرجع قيمة_من_بناء_للخفض(الناتج, النوع);
        }
        | نتيجة_تقييم_ثابت_خفض.فخ -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تقييم_ثابت_بفخ(النطاق));
        }
        | _ -> { };
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, &الداخل, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            دع المعرف: معرف_قيمة_مسير = القيمة.المعرف;
            دع د: طبيعي = المعرف.الدالة.القيمة;
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
                دع ت: متغير طبيعي = 0;
                طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].الناتج مع
                    | اختياري.موجود(موجود) -> {
                        لو (قيمتا_مسير_متساويتان(موجود.المعرف, المعرف)) {
                            (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة := صواب;
                            أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ت := ت + 1;
                }
                ك := ك + 1;
            }
            // A compile-time parameter used as the whole expression: every
            // specialized copy defines it as a constant, and the template
            // itself never runs (driver/compile_time.sn).
            لو (قيمة_معامل_وقت_ترجمة_للخفض(&(*البرنامج).الدوال[د], المعرف)) {
                أرجع نتيجة_خفض_تعبير.قيمة(القيمة);
            };
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)
            );
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(
                خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق)
            );
        }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        };
    }
    // A vector literal expression is a fresh owned vector (a temporary, like
    // a call result): its elements are moved in, in order, and the value goes
    // to its consumer; drops.sn treats it as a temporary where it is read.
    | تعبير.حرفي_متجه(النطاق, العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(القيمة_النوعية) -> { نوع_العنصر := القيمة_النوعية; }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع));
        };
        دع القيم: متغير متجه معرف_قيمة_مسير = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            دع مرجع_العنصر: &تعبير = &العناصر[ف];
            طابق خفض_تعبير_مملوكا_إلى_مسير(
                البرنامج, الحالة, مرجع_العنصر, الأنواع, أنواع_التعبيرات,
                روابط_الأسماء, دوال_الخفض, هويات_البدائيات
            ) مع
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_العنصر)));
            }
            | نتيجة_خفض_تعبير.قيمة(قيمة_العنصر) -> {
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, نطاق_تعبير(مرجع_العنصر), قيمة_العنصر, نوع_العنصر, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(المقننة) -> { ألحق(القيم, المقننة.المعرف); }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> {
                    أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_تعبير(مرجع_العنصر)));
                };
            };
            ف := ف + 1;
        }
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        أرجع قيمة_من_بناء_للخفض(
            أصدر_تهيئة_متجه_مسير(
                البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة, &القيم, النوع
            ),
            النوع
        );
    }
    | تعبير.إغلاق(النطاق, المعاملات, _, الجسم_المملوك) -> {
        دع الجسم: تعبير = *الجسم_المملوك;
        أرجع اخفض_إغلاق_إلى_مسير(
            البرنامج, الحالة, النطاق, &المعاملات, &الجسم, النوع, الأنواع,
            أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    }
    | تعبير.تحويل(النطاق, صندوق_المصدر, _) -> {
        دع المصدر: تعبير = *صندوق_المصدر;
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            &المصدر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(قيمة_المصدر) -> {
            لو (معرفا_نوع_متساويان(قيمة_المصدر.النوع, النوع)) {
                أرجع نتيجة_خفض_تعبير.قيمة(قيمة_المصدر);
            };
            لو (هل_نقل_متجه_بايتات_إلى_نص(الأنواع, قيمة_المصدر.النوع, النوع)) {
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_نقل_تسلسل_مملوك_مسير(
                        البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة, قيمة_المصدر.المعرف, النوع
                    ), النوع
                );
            };
            طابق وصف_تحويل_صحيح_بين(الأنواع, قيمة_المصدر.النوع, النوع) مع
            | اختياري.لا_شيء -> {
                طابق عملية_تحويل_حرف_إلى_صحيح_للخفض(
                    الأنواع, قيمة_المصدر.النوع, النوع
                ) مع
                | اختياري.موجود(العملية) -> {
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_صحيح_مسير(
                            البرنامج,
                            &حالة_الإصدار.البناء,
                            حالة_الإصدار.الدالة,
                            حالة_الإصدار.الكتلة,
                            العملية,
                            قيمة_المصدر.المعرف,
                            النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                طابق عملية_تحويل_بايت_إلى_حرف_للخفض(
                    الأنواع, قيمة_المصدر.النوع, النوع
                ) مع
                | اختياري.موجود(العملية) -> {
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_صحيح_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
                            العملية, قيمة_المصدر.المعرف, النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                طابق عملية_تحويل_عائم_للخفض(الأنواع, قيمة_المصدر.النوع, النوع) مع
                | اختياري.موجود(العملية) -> {
                    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                    أرجع قيمة_من_بناء_للخفض(
                        أصدر_تحويل_عائم_مسير(
                            البرنامج, &حالة_الإصدار.البناء, حالة_الإصدار.الدالة, حالة_الإصدار.الكتلة,
                            العملية, قيمة_المصدر.المعرف, النوع
                        ),
                        النوع
                    );
                }
                | اختياري.لا_شيء -> { };
                أرجع اخفض_تحويل_مرجع_إلى_مؤشر_مسير(
                    البرنامج, الحالة, النطاق, قيمة_المصدر, النوع, الأنواع
                );
            }
            | اختياري.موجود(الوصف) -> {
                دع العملية: عملية_تحويل_صحيح = عملية_تحويل_صحيح_من_وصف_للخفض(الوصف);
                دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
                أرجع قيمة_من_بناء_للخفض(
                    أصدر_تحويل_صحيح_مسير(
                        البرنامج,
                        &حالة_الإصدار.البناء,
                        حالة_الإصدار.الدالة,
                        حالة_الإصدار.الكتلة,
                        العملية,
                        قيمة_المصدر.المعرف,
                        النوع
                    ),
                    النوع
                );
            };
        };
    };
}
