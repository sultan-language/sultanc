// جسر MSIR الضيق من فشل الخفض الداخلي إلى Diagnostics المقننة.
عرف أضف_هوية_فشل_خفض_مسير(
    التشخيص: &متغير تشخيص,
    السبب: سبب_تشخيص
): فراغ {
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-lowering»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(التشخيص, السبب
    );
}

عرف أضف_مرحلة_خفض_مسير(التشخيص: &متغير تشخيص): فراغ {
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-lowering»
    );
}

عرف أضف_اعتماد_خفض_مسير_من_نطاق(
    التشخيص: &متغير تشخيص,
    النطاق: نطاق
): فراغ {
    طابق مصدر_تشخيص_من_نطاق(النطاق) مع
    | اختياري.موجود(الاعتماد) -> {
        دع أضف_الاعتماد: منطقي = أضف_اعتماد_تشخيص(التشخيص, الاعتماد);
    }
    | اختياري.لا_شيء -> { };
}

عرف أصدر_خطأ_خفض_مسير(
    المجموعة: &متغير مجموعة_تشخيصات,
    الخطأ: &خطأ_خفض_مسير,
    الأنواع: &سجل_أنواع,
    الأسماء: &متجه اسم_مقنن,
    الرموز: &متجه رمز_دلالي
): فراغ {
    دع القيمة: خطأ_خفض_مسير = *الخطأ;
    طابق القيمة مع
    | خطأ_خفض_مسير.نوع_غير_محلول(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_غير_محلول(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_محلول_نوع());
        أضف_اعتماد_خفض_مسير_من_نطاق(&متغير التشخيص, النطاق);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.معتم_في_مثيل_عام(نطاق_الاستدعاء, نطاق_الاستعمال, المعتم) -> {
        // A user error: the instantiation is reported at the call, with the
        // use inside the generic body that needs the opaque type's layout.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_معتم_حجة_نوع(),
            مصدر_تشخيص_من_نطاق(نطاق_الاستدعاء)
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «type»
        );
        دع أضف_النوع: منطقي = أضف_نوع_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, الأسماء, الرموز, المعتم
        );
        طابق مصدر_تشخيص_من_نطاق(نطاق_الاستعمال) مع
        | اختياري.موجود(مصدر_الاستعمال) -> {
            دع أضف_الاستعمال: منطقي = أضف_نطاقا_مرتبطا(
                &متغير التشخيص, مصدر_الاستعمال, دور_نطاق_تشخيص.سياق_مرتبط()
            );
        }
        | اختياري.لا_شيء -> { };
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_المساعدة: منطقي = أضف_مساعدة(
            &متغير التشخيص, مفتاح_صياغة.مساعدة_مرر_نوع_مؤشر_حجة_نوع(), بلا_حجج
        );
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.ربط_اسم_مفقود(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.ربط_اسم_خفض_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_اسم_ربط_اسم());
        أضف_اعتماد_خفض_مسير_من_نطاق(&متغير التشخيص, النطاق);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_تعبير_نوع());
        أضف_اعتماد_خفض_مسير_من_نطاق(&متغير التشخيص, النطاق);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_رمز_نوع());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_دالة_توقيع());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_رمز_دلالي_غير_متسق(الرمز, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوعان_غير_متوافقين(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_متسق_رمز_نوع());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, الأسماء, الرموز, المتوقع);
        دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, الأسماء, الرموز, الموجود);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.هوية_منشئ_مفقودة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.هوية_منشئ_خفض_مفقودة(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_منشئ_هوية());
        أضف_اعتماد_خفض_مسير_من_نطاق(&متغير التشخيص, النطاق);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.دالة_خارجية_غير_مدعومة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_مدعوم_خارجي_دالة());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.رمز_خارجي_بتوقيعين(النطاق, الاسم) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.رمز_خارجي_بتوقيعين(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_خارجي_رمز_بتوقيعين());
        دع أضيف_الرمز: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), من_بايتات(&الاسم));
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.فهرس_مصدر_مكرر -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مكرر_مصدر_فهرس());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.سعة_خريطة_غير_قابلة_للتمثيل -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_خريطة_سعة_فيض());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.دالة_دلالية_مفقودة(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.دالة_خفض_مفقودة(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_دلالي_دالة());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_محلي_رمز());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.استخدام_قبل_التهيئة(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_مهيأ_محلي());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.محلي_مكرر(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختياري.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مكرر_محلي());
        دع أضيف_الرمز: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_استدعاء_حجة_عدد_عدم_تطابق());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_استدعاء_حجة_نوع_عدم_تطابق());
        دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, الأسماء, الرموز, المتوقع);
        دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, الأسماء, الرموز, الموجود);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_إرجاع_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_إرجاع_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_إرجاع_نوع_عدم_تطابق());
        دع أضيف_المتوقع: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), الأنواع, الأسماء, الرموز, المتوقع);
        دع أضيف_الموجود: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الأنواع, الأسماء, الرموز, الموجود);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.مسار_بلا_إرجاع(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.إرجاع_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_مفقود_إرجاع_مسار());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_عبارة_غير_مدعومة(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_مدعوم_عبارة());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.تعبير_وقت_الترجمة_غير_ثابت(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.تقييم_ثابت_بفخ(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_وقت_الترجمة_فخ_التنفيذ());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_مدعوم_تعبير());
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, سبب_تشخيص.سبب_مسير_خفض_غير_مدعوم_تعبير_نوع());
        دع أضيف_النوع: منطقي = أضف_نوع_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), الأنواع, الأسماء, الرموز, النوع);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.بناء_مسير_مرفوض(خطأ_البناء) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختياري.لا_شيء()
        );
        أضف_مرحلة_خفض_مسير(&متغير التشخيص);
        طابق خطأ_البناء مع
        | خطأ_بناء_مسير.دالة_غير_موجودة(الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_مفقود_دالة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        }
        | خطأ_بناء_مسير.دالة_خارجية_غير_موجودة(الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_مفقود_خارجي_دالة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_مفقود_كتلة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الكتلة.الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة, الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_عابر_دالة_كتلة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        }
        | خطأ_بناء_مسير.قيمة_غير_موجودة(القيمة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_مفقود_قيمة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), القيمة.الدالة.القيمة);
            دع أضيف_القيمة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        }
        | خطأ_بناء_مسير.قيمة_من_دالة_أخرى(القيمة, الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_عابر_دالة_قيمة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
            دع أضيف_القيمة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_منتهية(الكتلة) -> {
            دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_مسير_بناء_منته_كتلة());
            دع أضيف_الدالة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الكتلة.الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        };
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
}

عام عرف حول_فشل_خفض_إلى_تشخيصات(
    الخطأ: خطأ_خفض_مسير,
    الأنواع: &سجل_أنواع,
    الأسماء: &متجه اسم_مقنن,
    الرموز: &متجه رمز_دلالي
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_خطأ_خفض_مسير(&متغير المجموعة, &الخطأ, الأنواع, الأسماء, الرموز);
    أرجع المجموعة;
}
