استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.msir.lowering.model;

// جسر MSIR الضيق من فشل الخفض الداخلي إلى Diagnostics المقننة.
عرف أضف_هوية_فشل_خفض_مسير(
    التشخيص: &متغير تشخيص,
    السبب: نص
): فراغ {
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-lowering»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.السبب(), السبب
    );
}

عرف أضف_مرحلة_خفض_مسير(التشخيص: &متغير تشخيص): فراغ {
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-lowering»
    );
}

عرف أصدر_خطأ_خفض_مسير(
    المجموعة: &متغير مجموعة_تشخيصات,
    الخطأ: &خطأ_خفض_مسير
): فراغ {
    دع القيمة: خطأ_خفض_مسير = *الخطأ;
    طابق القيمة مع
    | خطأ_خفض_مسير.نوع_غير_محلول(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_غير_محلول(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.unresolved-type»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.ربط_اسم_مفقود(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.ربط_اسم_خفض_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-name-binding»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_تعبير_مفقود(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-expression-type»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-symbol-type»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_خفض_مفقود(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-function-signature»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_رمز_دلالي_غير_متسق(الرمز, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوعان_غير_متوافقين(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.inconsistent-symbol-type»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة);
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.هوية_منشئ_مفقودة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.هوية_منشئ_خفض_مفقودة(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-constructor-identity»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.دالة_خارجية_غير_مدعومة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.unsupported-external-function»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.دالة_دلالية_مفقودة(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.دالة_خفض_مفقودة(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-semantic-function»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-local-symbol»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.محلي_غير_مهيأ(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.استخدام_قبل_التهيئة(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.uninitialized-local»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.محلي_مكرر(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختيار.لا_شيء()
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.duplicate-local»);
        دع أضيف_الرمز: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), الرمز.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.عدد_حجج_غير_مطابق(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.عدد_حجج_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.call-argument-count-mismatch»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_حجة_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_حجة_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.call-argument-type-mismatch»);
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة);
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_إرجاع_غير_مطابق(النطاق, المتوقع, الموجود) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.نوع_إرجاع_غير_مطابق(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.return-type-mismatch»);
        دع أضيف_المتوقع: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع.القيمة);
        دع أضيف_الموجود: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.مسار_بلا_إرجاع(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.إرجاع_مفقود(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.missing-return-path»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_عبارة_غير_مدعومة(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.unsupported-statement»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.unsupported-expression»);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, النوع) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خفض_تعبير_غير_مدعوم(),
            مصدر_تشخيص_من_نطاق(النطاق)
        );
        أضف_هوية_فشل_خفض_مسير(&متغير التشخيص, «msir-lowering.unsupported-expression-type»);
        دع أضيف_النوع: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع.القيمة);
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
    | خطأ_خفض_مسير.بناء_مسير_مرفوض(خطأ_البناء) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.خطأ_سياق_داخلي(),
            اختيار.لا_شيء()
        );
        أضف_مرحلة_خفض_مسير(&متغير التشخيص);
        طابق خطأ_البناء مع
        | خطأ_بناء_مسير.دالة_غير_موجودة(الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.missing-function»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        }
        | خطأ_بناء_مسير.دالة_خارجية_غير_موجودة(الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.missing-external-function»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_غير_موجودة(الكتلة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.missing-block»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الكتلة.الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_من_دالة_أخرى(الكتلة, الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.cross-function-block»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        }
        | خطأ_بناء_مسير.قيمة_غير_موجودة(القيمة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.missing-value»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), القيمة.الدالة.القيمة);
            دع أضيف_القيمة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        }
        | خطأ_بناء_مسير.قيمة_من_دالة_أخرى(القيمة, الدالة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.cross-function-value»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
            دع أضيف_القيمة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        }
        | خطأ_بناء_مسير.كتلة_منتهية(الكتلة) -> {
            دع أضيف_السبب: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «msir-builder.terminated-block»);
            دع أضيف_الدالة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الكتلة.الدالة.القيمة);
            دع أضيف_الكتلة: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        };
        أصدر_تشخيصا(المجموعة, &التشخيص);
    }
}

عام عرف حول_فشل_خفض_إلى_تشخيصات(الخطأ: خطأ_خفض_مسير): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_خطأ_خفض_مسير(&متغير المجموعة, &الخطأ);
    أرجع المجموعة;
}
