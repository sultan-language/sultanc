// إعلان الدوال وخفض الأجسام وبناء برنامج MSIR والتحقق منه.
// External symbol spelling is copied from the declaration source once at the MSIR boundary.
عرف انسخ_اسم_للخفض(المصدر: &مصدر, الاسم: &اسم): متجه ط8 {
    دع قيمة_المصدر: مصدر = *المصدر;
    دع قيمة_الاسم: اسم = *الاسم;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = قيمة_الاسم.النطاق.البداية.البايت;
    طالما (ف < قيمة_الاسم.النطاق.النهاية.البايت && ف < قيمة_المصدر.الطول) {
        ألحق(البايتات, قيمة_المصدر.المحتوى[ف]);
        ف := ف + 1;
    }
    أرجع البايتات;
}

عام عرف أعلن_دالة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    الدالة_النحوية: &تصريح_دالة,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    روابط_الأسماء: &سياق_روابط_أسماء,
    استبدالات_النوع: &متجه ربط_استبدال_نوع,
    دوال_الخفض: &متغير سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    دع التصريح: تصريح_دالة = *الدالة_النحوية;
    دع الرمز: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_اسم_للخفض(روابط_الأسماء, &التصريح.الاسم) مع
    | نتيجة.نجح(المعرف) -> {
        الرمز := المعرف;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    دع نوع_الدالة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختياري.موجود(المعرف) -> {
        نوع_الدالة := استبدل_نوعا(الأنواع, المعرف, استبدالات_النوع);
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز));
    };
    دع عدد_المعاملات: متغير طبيعي = 0;
    طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة) مع
    | اختياري.موجود(العدد) -> {
        عدد_المعاملات := العدد;
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
    };
    لو (عدد_المعاملات != (الطول(التصريح.المعاملات) مثل طبيعي)) {
        أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
    };
    دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المعاملات) {
        طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة, ف) مع
        | اختياري.موجود(المعرف) -> {
            طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
            | اختياري.موجود(نوع_التمثيل) -> {
                ألحق(أنواع_المعاملات, نوع_التمثيل);
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
        };
        ف := ف + 1;
    }
    دع نوع_الناتج: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
    }
    | اختياري.موجود(المعرف) -> {
        طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, المعرف) مع
        | اختياري.موجود(نوع_التمثيل) -> {
            لو (!هل_نوع_فراغ_للخفض(الأنواع, نوع_التمثيل)) {
                نوع_الناتج := اختياري.موجود(نوع_التمثيل);
            };
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.توقيع_دالة_دلالي_مفقود(الرمز));
        };
    };
    دع هدف_الدالة: متغير هدف_دالة_خفض = هدف_دالة_خفض.داخلية(معرف_دالة_مسير_من(0));
    طابق التصريح.الجسم مع
    | اختياري.موجود(_) -> {
        دع معرف_الدالة: معرف_دالة_مسير = أضف_دالة_مسير(
            البرنامج, &أنواع_المعاملات, نوع_الناتج
        );
        دع فهرس_وقت_الترجمة: متغير طبيعي = 0;
        طالما (فهرس_وقت_الترجمة < (الطول(التصريح.المعاملات) مثل طبيعي)) {
            (*البرنامج).الدوال[معرف_الدالة.القيمة].معاملات_وقت_الترجمة[فهرس_وقت_الترجمة] :=
                التصريح.المعاملات[فهرس_وقت_الترجمة].مطلوب_مسبقا;
            فهرس_وقت_الترجمة := فهرس_وقت_الترجمة + 1;
        }
        دع اسم_التصحيح: متجه ط8 = انسخ_اسم_للخفض(المصدر, &التصريح.الاسم);
        دع أسماء_المعاملات_للتصحيح: متغير متجه متجه ط8 = [];
        دع نطاقات_المعاملات_للتصحيح: متغير متجه نطاق = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(التصريح.المعاملات) مثل طبيعي)) {
            دع مرجع_المعامل_للتصحيح: &معامل = &التصريح.المعاملات[م];
            دع المعامل_للتصحيح: معامل = *مرجع_المعامل_للتصحيح;
            دع اسم_المعامل_للتصحيح: متجه ط8 = انسخ_اسم_للخفض(المصدر, &المعامل_للتصحيح.الاسم);
            ألحق(أسماء_المعاملات_للتصحيح, اسم_المعامل_للتصحيح);
            ألحق(نطاقات_المعاملات_للتصحيح, المعامل_للتصحيح.الاسم.النطاق);
            م := م + 1;
        }
        سجل_تصحيح_دالة_مسير(
            التصحيح, الأصول, معرف_الدالة, اسم_التصحيح, التصريح.النطاق,
            &أسماء_المعاملات_للتصحيح, &نطاقات_المعاملات_للتصحيح,
            &أنواع_المعاملات, نوع_الناتج, التصريح.علني
        );
        هدف_الدالة := هدف_دالة_خفض.داخلية(معرف_الدالة);
    }
    | اختياري.لا_شيء -> {
        // The linker symbol is the declared link name, else the source name;
        // the declared library travels with it to the object writers and
        // linkers (WebAssembly import module, PE DLL, Mach-O dylib).
        دع الاسم_الخارجي: متجه ط8;
        طابق التصريح.اسم_الربط مع
        | اختياري.موجود(القيمة) -> { الاسم_الخارجي := انسخ_بايتات(&القيمة); }
        | اختياري.لا_شيء -> { الاسم_الخارجي := انسخ_اسم_للخفض(المصدر, &التصريح.الاسم); };
        دع معرف_الخارجية: معرف_دالة_خارجية_مسير = أضف_دالة_خارجية_مسير(
            البرنامج, الاسم_الخارجي, انسخ_اختيار_بايتات(&التصريح.المكتبة_الخارجية),
            &أنواع_المعاملات, نوع_الناتج
        );
        هدف_الدالة := هدف_دالة_خفض.خارجية(معرف_الخارجية);
    };
    دع نسخة_الاستبدالات: متجه ربط_استبدال_نوع = انسخ_مملوكا_متجه_ربط_استبدال_نوع(استبدالات_النوع);
    دع الربط: ربط_دالة_خفض = {
        الرمز: الرمز,
        استبدالات_النوع: نسخة_الاستبدالات,
        الهدف: هدف_الدالة,
        المعاملات: أنواع_المعاملات,
        الناتج: نوع_الناتج
    };
    طابق أضف_دالة_خفض(دوال_الخفض, الربط) مع
    | نتيجة.نجح(أضيفت) -> {
        لو (!أضيفت) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.دالة_دلالية_مفقودة(الرمز));
        };
    }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    أرجع اختياري.لا_شيء();
}

عرف سجل_متغير_تصحيح_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    الدالة: معرف_دالة_مسير,
    الاسم: &اسم,
    نطاق_الإحاطة: معرف_نطاق_تصحيح,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    روابط_الأسماء: &سياق_روابط_أسماء
): اختياري خطأ_خفض_مسير {
    طابق رمز_اسم_للخفض(روابط_الأسماء, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(الرمز) -> {
        طابق نوع_رمز_دلالي_للخفض(الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, الرمز) مع
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
            دع اسم_المتغير: متجه ط8 = انسخ_اسم_للخفض(المصدر, الاسم);
            دع قيمة_الاسم: اسم = *الاسم;
            سجل_متغير_تصحيح_مسير(
                التصحيح, الأصول, الدالة, الرمز, اسم_المتغير, النوع,
                قيمة_الاسم.النطاق, نطاق_الإحاطة
            );
            أرجع اختياري.لا_شيء();
        };
    };
}

// Registers lexical scopes and local declarations before code lowering mutates
// control-flow state. This keeps debug declaration ownership in MSIR metadata
// without introducing a second debug IR.
عرف سجل_تصحيح_كتلة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    الدالة: معرف_دالة_مسير,
    الكتلة: &كتلة_عبارات,
    الأب: اختياري معرف_نطاق_تصحيح,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: &متجه ربط_نوع_رمز_خفض,
    روابط_الأسماء: &سياق_روابط_أسماء
): اختياري خطأ_خفض_مسير {
    دع قيمة_الكتلة: كتلة_عبارات = *الكتلة;
    دع معرف_النطاق: متغير معرف_نطاق_تصحيح = معرف_نطاق_تصحيح_من(0);
    طابق سجل_نطاق_تصحيح_مسير(التصحيح, الأصول, الدالة, قيمة_الكتلة.النطاق, الأب) مع
    | اختياري.موجود(المعرف) -> { معرف_النطاق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(قيمة_الكتلة.العبارات) مثل طبيعي)) {
        دع العبارة: عبارة = *قيمة_الكتلة.العبارات[ف];
        طابق العبارة مع
        | عبارة.تصريح_متغير(_, الاسم, _) -> {
            طابق سجل_متغير_تصحيح_للخفض(
                البرنامج, التصحيح, الأصول, المصدر, الدالة, &الاسم, معرف_النطاق,
                الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.طالما(_, _, الجسم) -> {
            طابق سجل_تصحيح_كتلة_للخفض(
                البرنامج, التصحيح, الأصول, المصدر, الدالة, &الجسم, اختياري.موجود(معرف_النطاق),
                الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.لكل(نطاق_لكل, البداية, _, _, الجسم) -> {
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(البداية) مثل طبيعي)) {
                دع عبارة_البداية: عبارة = *البداية[ب];
                طابق عبارة_البداية مع
                | عبارة.تصريح_متغير(_, الاسم, _) -> {
                    طابق سجل_متغير_تصحيح_للخفض(
                        البرنامج, التصحيح, الأصول, المصدر, الدالة, &الاسم, معرف_النطاق,
                        الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
                ب := ب + 1;
            }
            طابق سجل_تصحيح_كتلة_للخفض(
                البرنامج, التصحيح, الأصول, المصدر, الدالة, &الجسم, اختياري.موجود(معرف_النطاق),
                الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.لو(_, _, عند_الصواب, عند_الخطأ) -> {
            طابق سجل_تصحيح_كتلة_للخفض(
                البرنامج, التصحيح, الأصول, المصدر, الدالة, &عند_الصواب, اختياري.موجود(معرف_النطاق),
                الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
            طابق عند_الخطأ مع
            | اختياري.موجود(الجسم) -> {
                طابق سجل_تصحيح_كتلة_للخفض(
                    البرنامج, التصحيح, الأصول, المصدر, الدالة, &الجسم, اختياري.موجود(معرف_النطاق),
                    الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | عبارة.طابق(_, _, الأذرع) -> {
            دع ذ: متغير طبيعي = 0;
            طالما (ذ < (الطول(الأذرع) مثل طبيعي)) {
                طابق سجل_تصحيح_كتلة_للخفض(
                    البرنامج, التصحيح, الأصول, المصدر, الدالة, &الأذرع[ذ].الجسم, اختياري.موجود(معرف_النطاق),
                    الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                ذ := ذ + 1;
            }
        }
        | عبارة.وقت_الترجمة(_, _) -> { }
        | عبارة.إسناد_وقت_الترجمة(_, _, _, _) -> { }
        | عبارة.غير_آمن(_, الجسم) -> {
            طابق سجل_تصحيح_كتلة_للخفض(
                البرنامج, التصحيح, الأصول, المصدر, الدالة, &الجسم, اختياري.موجود(معرف_النطاق),
                الأنواع, أنواع_الرموز, أنواع_رموز_المثيل, روابط_الأسماء
            ) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_جسم_دالة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    الدالة_النحوية: &تصريح_دالة,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_رموز_المثيل: متجه ربط_نوع_رمز_خفض,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    استبدالات_النوع: &متجه ربط_استبدال_نوع,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع التصريح: تصريح_دالة = *الدالة_النحوية;
    طابق التصريح.الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(_) -> { };
    دع رمز_الدالة: متغير معرف_رمز = معرف_رمز_من(0);
    طابق رمز_اسم_للخفض(روابط_الأسماء, &التصريح.الاسم) مع
    | نتيجة.نجح(الرمز) -> {
        رمز_الدالة := الرمز;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    دع دالة_فارغة: معرف_دالة_مسير = معرف_دالة_مسير_من(0);
    دع معاملات_فارغة: متجه معرف_نوع = [];
    دع ناتج_فارغ: اختياري معرف_نوع = اختياري.لا_شيء();
    دع نسخة_الاستبدالات: متجه ربط_استبدال_نوع = انسخ_مملوكا_متجه_ربط_استبدال_نوع(استبدالات_النوع);
    دع هدف_فارغ: هدف_دالة_خفض = هدف_دالة_خفض.داخلية(دالة_فارغة);
    دع الربط: متغير ربط_دالة_خفض = {
        الرمز: رمز_الدالة,
        استبدالات_النوع: نسخة_الاستبدالات,
        الهدف: هدف_فارغ,
        المعاملات: معاملات_فارغة,
        الناتج: ناتج_فارغ
    };
    طابق دالة_خفض_بمثيل_عند(دوال_الخفض, رمز_الدالة, استبدالات_النوع) مع
    | اختياري.موجود(الموجود) -> {
        الربط := الموجود;
    }
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_الدالة));
    };
    دع معرف_الدالة_الداخلية: متغير معرف_دالة_مسير = معرف_دالة_مسير_من(0);
    طابق الربط.الهدف مع
    | هدف_دالة_خفض.داخلية(المعرف) -> {
        معرف_الدالة_الداخلية := المعرف;
    }
    | هدف_دالة_خفض.خارجية(_) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.دالة_خارجية_غير_مدعومة(التصريح.النطاق));
    };
    دع كتلة_الدخول: متغير معرف_كتلة_مسير = معرف_كتلة_مسير_من(معرف_الدالة_الداخلية, 0);
    طابق أضف_كتلة_للخفض(البرنامج, معرف_الدالة_الداخلية) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الدخول := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    };
    دع المحليات: متجه ربط_محلي_خفض = [];
    دع حالة_البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الحالة: متغير حالة_خفض_دالة = {
        الدالة: معرف_الدالة_الداخلية,
        الكتلة: كتلة_الدخول,
        نشطة: صواب,
        البناء: حالة_البناء,
        المحليات: المحليات,
        له_هدف_خروج_حلقة: خطأ,
        هدف_خروج_حلقة: كتلة_الدخول,
        له_هدف_متابعة_حلقة: خطأ,
        هدف_متابعة_حلقة: كتلة_الدخول,
        عدد_محليات_متابعة_حلقة: 0,
        المحليات_مشتركة: خطأ,
        إطار_الإسقاط: اختياري.لا_شيء()
    };
    // Drop elaboration: owner storage in the entry block, the body in a fresh
    // block, returns through the exit block (drops.sn).
    دع إطار_الدالة: إطار_إسقاط_خفض;
    طابق افتح_إطار_إسقاط_خفض(البرنامج, معرف_الدالة_الداخلية, كتلة_الدخول, الربط.الناتج, الأنواع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة.نجح(الإطار) -> { إطار_الدالة := الإطار; };
    الحالة.إطار_الإسقاط := اختياري.موجود(إطار_الدالة);
    الحالة.الكتلة := إطار_الدالة.البداية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(التصريح.المعاملات) مثل طبيعي)) {
        دع مرجع_المعامل: &معامل = &التصريح.المعاملات[ف];
        دع المعامل: معامل = *مرجع_المعامل;
        دع رمز_المعامل: متغير معرف_رمز = معرف_رمز_من(0);
        طابق رمز_اسم_للخفض(روابط_الأسماء, &المعامل.الاسم) مع
        | نتيجة.نجح(الرمز) -> {
            رمز_المعامل := الرمز;
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        };
        دع نوع_المعامل: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_رمز_دلالي_للخفض(الأنواع, أنواع_الرموز, &أنواع_رموز_المثيل, رمز_المعامل) مع
        | نتيجة_حل_نوع_للخفض.موجود(المعرف) -> {
            نوع_المعامل := المعرف;
        }
        | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        };
        لو (!معرفا_نوع_متساويان(نوع_المعامل, الربط.المعاملات[ف])) {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_رمز_دلالي_غير_متسق(
                    رمز_المعامل, الربط.المعاملات[ف], نوع_المعامل
                )
            );
        };
        دع قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(معرف_الدالة_الداخلية, ف);
        طابق أضف_محلي_خفض(
            &متغير الحالة,
            رمز_المعامل,
            نوع_المعامل,
            اختياري.موجود(قيمة_المعامل)
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
        // A parameter passed by value is owned by the callee.
        طابق سجل_مالكا_خفض(البرنامج, &متغير الحالة, رمز_المعامل, الأنواع, دوال_الخفض) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق التصريح.الجسم مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.دالة_خارجية_غير_مدعومة(التصريح.النطاق));
    }
    | اختياري.موجود(الجسم) -> {
        دع أب_الجسم: اختياري معرف_نطاق_تصحيح = نطاق_جذري_لتصحيح_دالة_مسير(التصحيح, معرف_الدالة_الداخلية);
        طابق سجل_تصحيح_كتلة_للخفض(
            البرنامج, التصحيح, الأصول, المصدر, معرف_الدالة_الداخلية, &الجسم, أب_الجسم,
            الأنواع, أنواع_الرموز, &أنواع_رموز_المثيل, روابط_الأسماء
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        طابق خفض_كتلة_عبارات_إلى_مسير(
            البرنامج,
            التصحيح,
            الأصول,
            &متغير الحالة,
            &الجسم,
            الربط.الناتج,
            الأنواع,
            أنواع_الرموز,
            &أنواع_رموز_المثيل,
            أنواع_التعبيرات,
            روابط_الأسماء,
            سجل_الأنماط,
            تحققات_الأنماط,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | اختياري.موجود(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | اختياري.لا_شيء -> { };
    };
    لو (الحالة.نشطة) {
        طابق الربط.الناتج مع
        | اختياري.موجود(_) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.مسار_بلا_إرجاع(التصريح.النطاق));
        }
        | اختياري.لا_شيء -> {
            طابق اختم_بإرجاع_مع_إسقاط_خفض(البرنامج, &الحالة, اختياري.لا_شيء()) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
    };
    أرجع اختم_إطار_إسقاط_خفض(البرنامج, معرف_الدالة_الداخلية, &إطار_الدالة);
}
