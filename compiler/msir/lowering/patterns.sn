// ترجمة Pattern الدلالي المتحقق إلى MSIR. لا يعاد بناء صنف النمط أو نوعه أو هوية منشئه هنا.
// Literal Pattern lowering reuses the expected semantic Type already proven by Pattern validation.
عرف ابن_ثابت_عدد_نمط_مسير(
    الحرفي: &قيمة_نمط_حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري ثابت_مسير {
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الوصف) -> {
        ليكن القيمة: قيمة_نمط_حرفي = *الحرفي;
        طابق القيمة مع
        | قيمة_نمط_حرفي.عدد(العدد) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(العدد));
            };
            إذا (العدد < 0) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(العدد مثل طبيعي));
        }
        | قيمة_نمط_حرفي.عدد_طبيعي(العدد) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(العدد مثل عدد));
            };
            أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(العدد));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف اخفض_نمط_عدد_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الحرفي: &قيمة_نمط_حرفي,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن الثابت: ثابت_مسير;
    طابق ابن_ثابت_عدد_نمط_مسير(الحرفي, القيمة.النوع, الأنواع) مع
    | اختياري.موجود(الموجود) -> { الثابت := الموجود; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن معرف_الثابت: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        الثابت,
        القيمة.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الثابت := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن الشرط: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        عملية_مقارنة_صحيح.يساوي(),
        القيمة.المعرف,
        معرف_الثابت,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الشرط := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    أرجع اختم_اختبار_نمط_للخفض(البرنامج, الحالة, الشرط, عند_الصواب, عند_الخطأ);
}

عرف اخفض_نمط_حرف_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المحرف: ط32,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    // The scrutinee's scalar value, by the rule character comparisons use.
    ليكن قيمة_ط32: متغير قيمة_خفض_مسير = القيمة;
    طابق اخفض_حرف_إلى_قيمته_العددية_مسير(
        البرنامج, الحالة, النطاق, القيمة, الأنواع
    ) مع
    | نتيجة_خفض_تعبير.قيمة(المخفضة) -> { قيمة_ط32 := المخفضة; }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن الحرفي_العددي: قيمة_نمط_حرفي = قيمة_نمط_حرفي.عدد_طبيعي(المحرف مثل طبيعي);
    أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
        البرنامج, الحالة, النطاق, &الحرفي_العددي, قيمة_ط32,
        عند_الصواب, عند_الخطأ, الأنواع
    );
}

// `range a..b`: a ≤ value ≤ b, both ends included; an open end has no test.
// A character compares by its code.
عرف اخفض_نمط_مدى_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الأدنى: &اختياري قيمة_نمط_حرفي,
    الأعلى: &اختياري قيمة_نمط_حرفي,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن حد_أدنى: متغير اختياري قيمة_نمط_حرفي = انسخ_مملوكا_حد_مدى_دلالي(الأدنى);
    ليكن حد_أعلى: متغير اختياري قيمة_نمط_حرفي = انسخ_مملوكا_حد_مدى_دلالي(الأعلى);
    ليكن محارف: متغير منطقي = خطأ;
    طابق حد_أدنى مع
    | اختياري.موجود(قيمة_نمط_حرفي.حرف(المحرف)) -> {
        محارف := صواب;
        حد_أدنى := اختياري.موجود(قيمة_نمط_حرفي.عدد_طبيعي(المحرف مثل طبيعي));
    }
    | _ -> { };
    طابق حد_أعلى مع
    | اختياري.موجود(قيمة_نمط_حرفي.حرف(المحرف)) -> {
        محارف := صواب;
        حد_أعلى := اختياري.موجود(قيمة_نمط_حرفي.عدد_طبيعي(المحرف مثل طبيعي));
    }
    | _ -> { };
    ليكن قيمة_المقارنة: متغير قيمة_خفض_مسير = القيمة;
    إذا (محارف) {
        طابق اخفض_حرف_إلى_قيمته_العددية_مسير(
            البرنامج, الحالة, النطاق, القيمة, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(المخفضة) -> { قيمة_المقارنة := المخفضة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
    };
    ليكن له_أعلى: متغير منطقي = خطأ;
    طابق حد_أعلى مع
    | اختياري.موجود(_) -> { له_أعلى := صواب; }
    | اختياري.لا_شيء -> { };
    طابق حد_أدنى مع
    | اختياري.موجود(الحد) -> {
        // With an upper end its test follows in a block of its own.
        ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
        إذا (له_أعلى) {
            طابق أضف_كتلة_للخفض(البرنامج, (*الحالة).الدالة) مع
            | نتيجة.نجح(الكتلة) -> { التالي := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        طابق اختبر_حد_مدى_للخفض(
            البرنامج, الحالة, النطاق, &الحد, قيمة_المقارنة, عملية_مقارنة_صحيح.أكبر_أو_يساوي(),
            التالي, عند_الخطأ, الأنواع
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        إذا (!له_أعلى) { أرجع اختياري.لا_شيء(); };
        ليكن حالة_الأعلى: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
        حالة_الأعلى.الكتلة := التالي;
        حالة_الأعلى.نشطة := صواب;
        *الحالة := حالة_الأعلى;
    }
    | اختياري.لا_شيء -> { };
    طابق حد_أعلى مع
    | اختياري.موجود(الحد) -> {
        أرجع اختبر_حد_مدى_للخفض(
            البرنامج, الحالة, النطاق, &الحد, قيمة_المقارنة, عملية_مقارنة_صحيح.أصغر_أو_يساوي(),
            عند_الصواب, عند_الخطأ, الأنواع
        );
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
}

// One end of a range: the value compared with the bound الحد by المقارنة;
// on to عند_الصواب when it holds, to عند_الخطأ otherwise.
عرف اختبر_حد_مدى_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الحد: &قيمة_نمط_حرفي,
    قيمة_المقارنة: قيمة_خفض_مسير,
    المقارنة: عملية_مقارنة_صحيح,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن نوع_المنطق: متغير معرف_نوع = قيمة_المقارنة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    ليكن الثابت: ثابت_مسير;
    طابق ابن_ثابت_عدد_نمط_مسير(الحد, قيمة_المقارنة.النوع, الأنواع) مع
    | اختياري.موجود(القيمة) -> { الثابت := القيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن معرف_الحد: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, الثابت, قيمة_المقارنة.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الحد := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    ليكن الشرط: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, المقارنة,
        قيمة_المقارنة.المعرف, معرف_الحد, نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الشرط := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    أرجع اختم_اختبار_نمط_للخفض(البرنامج, الحالة, الشرط, عند_الصواب, عند_الخطأ);
}

عرف اخفض_نمط_نص_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    البايتات: &متجه ط8,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    ليكن قيم_البايتات: متجه ط8 = *البايتات;
    ليكن نوع_العدد: متغير معرف_نوع = القيمة.النوع;
    ليكن نوع_البايت: متغير معرف_نوع = القيمة.النوع;
    ليكن نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8()) مع
    | اختياري.موجود(المعرف) -> { نوع_البايت := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن حجج_الطول: متجه معرف_قيمة_مسير = [القيمة.المعرف];
    ليكن قيمة_الطول: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        هوية_بدائي_مترجم.طول(),
        حجج_الطول,
        اختياري.موجود(نوع_العدد),
        اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن ثابت_الطول: متغير معرف_قيمة_مسير = قيمة_الطول;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        ثابت_مسير.صحيح_موقع(الطول(قيم_البايتات)),
        نوع_العدد
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ثابت_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    ليكن شرط_الطول: متغير معرف_قيمة_مسير = قيمة_الطول;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        عملية_مقارنة_صحيح.يساوي(),
        قيمة_الطول,
        ثابت_الطول,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    ليكن العدد: طبيعي = الطول(قيم_البايتات) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع اختم_اختبار_نمط_للخفض(
            البرنامج, الحالة, شرط_الطول, عند_الصواب, عند_الخطأ
        );
    };
    ليكن كتلة_البايتات: متغير معرف_كتلة_مسير = عند_الصواب;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_البايتات := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    طابق اختم_اختبار_نمط_للخفض(
        البرنامج, الحالة, شرط_الطول, كتلة_البايتات, عند_الخطأ
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };

    ليكن حالة_بايت: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    حالة_بايت.الكتلة := كتلة_البايتات;
    حالة_بايت.نشطة := صواب;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن معرف_الفهرس: متغير معرف_قيمة_مسير = القيمة.المعرف;
        طابق أصدر_ثابتا_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            ثابت_مسير.صحيح_موقع(ف مثل عدد),
            نوع_العدد
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الفهرس := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        ليكن قيمة_البايت: متغير معرف_قيمة_مسير = القيمة.المعرف;
        طابق أصدر_استخراج_فهرس_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            القيمة.المعرف,
            معرف_الفهرس,
            نوع_البايت
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        ليكن ثابت_البايت: متغير معرف_قيمة_مسير = قيمة_البايت;
        طابق أصدر_ثابتا_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            ثابت_مسير.صحيح_طبيعي(قيم_البايتات[ف] مثل طبيعي),
            نوع_البايت
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ثابت_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        ليكن شرط_البايت: متغير معرف_قيمة_مسير = قيمة_البايت;
        طابق أصدر_مقارنة_صحيح_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            عملية_مقارنة_صحيح.يساوي(),
            قيمة_البايت,
            ثابت_البايت,
            نوع_المنطق
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
        إذا ((ف + 1) < العدد) {
            طابق أضف_كتلة_للخفض(البرنامج, حالة_بايت.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { التالي := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        طابق اختم_اختبار_نمط_للخفض(
            البرنامج, &حالة_بايت, شرط_البايت, التالي, عند_الخطأ
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        حالة_بايت.الكتلة := التالي;
        حالة_بايت.نشطة := صواب;
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اختم_اختبار_نمط_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الشرط: معرف_قيمة_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير
): اختياري خطأ_خفض_مسير {
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن لا_حجج_أ: متجه معرف_قيمة_مسير = [];
    ليكن لا_حجج_ب: متجه معرف_قيمة_مسير = [];
    ليكن حافة_أ: حافة_مسير = { الهدف: عند_الصواب, الحجج: لا_حجج_أ };
    ليكن حافة_ب: حافة_مسير = { الهدف: عند_الخطأ, الحجج: لا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, الشرط, حافة_أ, حافة_ب
    ) مع
    | نتيجة_بناء_منهي_مسير.مبني -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

// Whether a checked pattern matches every value of its Type (so the
// alternatives after it can never be tried and are not lowered: code that
// cannot be reached would use values it is not dominated by).
عام عرف نمط_غير_قابل_للدحض_للخفض(
    سجل_الأنماط: &سجل_أنماط,
    التحقق: &تحقق_نمط_نوعي,
    الأنواع: &سجل_أنواع,
    النمط: معرف_نمط
): منطقي {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | نمط_دلالي.بدل(_) -> { أرجع صواب; }
        | نمط_دلالي.ربط(_, _) -> { أرجع صواب; }
        | نمط_دلالي.حرفي(_, _) -> { أرجع خطأ; }
        | نمط_دلالي.مدى(_, _, _) -> { أرجع خطأ; }
        | نمط_دلالي.بدائل(_, البدائل) -> {
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(البدائل) مثل طبيعي)) {
                إذا (نمط_غير_قابل_للدحض_للخفض(سجل_الأنماط, التحقق, الأنواع, البدائل[ف])) { أرجع صواب; };
                ف := ف + 1;
            }
            أرجع خطأ;
        }
        | نمط_دلالي.تسلسل(_, السابقة, البقية, اللاحقة) -> {
            // `[..]` alone matches every length.
            طابق البقية مع
            | اختياري.موجود(_) -> {
                أرجع (الطول(السابقة) مثل طبيعي) == 0 && (الطول(اللاحقة) مثل طبيعي) == 0;
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | نمط_دلالي.منشئ(_, _, _) -> {
            طابق نوع_عقدة_نمط_عند(التحقق, النمط) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(النوع) -> {
                طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
                | اختياري.موجود(العدد) -> { إذا (العدد != 1) { أرجع خطأ; }; }
                | اختياري.لا_شيء -> { أرجع خطأ; };
            };
        }
        | _ -> { };
        ليكن الأبناء: متجه معرف_نمط = أبناء_نمط_دلالي(&القيمة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
            إذا (!نمط_غير_قابل_للدحض_للخفض(سجل_الأنماط, التحقق, الأنواع, الأبناء[ف])) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

// The Symbols a pattern binds, in source order (an or-pattern's are its first
// alternative's).
عام عرف رموز_روابط_نمط_للخفض(
    سجل_الأنماط: &سجل_أنماط,
    روابط_الأسماء: &سياق_روابط_أسماء,
    النمط: معرف_نمط
): متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    طابق روابط_نمط_دلالي(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الروابط) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الروابط) مثل طبيعي)) {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, الروابط[ف].النطاق) مع
            | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
    };
    أرجع الناتج;
}

// The names the `rest name`s of a pattern bind (a vector or slice pattern's
// rest), at any depth. Each is a slice viewing the scrutinee, whose borrow
// the arm records (borrow_events.sn, سجل_روابط_ذراع_استعارة_خفض).
عام عرف رموز_بقايا_نمط_للخفض(
    سجل_الأنماط: &سجل_أنماط,
    روابط_الأسماء: &سياق_روابط_أسماء,
    النمط: معرف_نمط
): متجه معرف_رمز {
    ليكن الناتج: متغير متجه معرف_رمز = [];
    ليكن العمل: متغير متجه معرف_نمط = [النمط];
    طالما ((الطول(العمل) مثل طبيعي) > 0) {
        ليكن الأخير: طبيعي = (الطول(العمل) مثل طبيعي) - 1;
        ليكن الحالي: معرف_نمط = العمل[الأخير];
        اقتطع(العمل, الأخير);
        طابق نمط_عند(سجل_الأنماط, الحالي) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القيمة) -> {
            ليكن الأبناء: متجه معرف_نمط = أبناء_نمط_دلالي(&القيمة);
            طابق القيمة مع
            | نمط_دلالي.تسلسل(_, _, اختياري.موجود(البقية), _) -> {
                طابق نمط_عند(سجل_الأنماط, البقية) مع
                | اختياري.موجود(نمط_دلالي.ربط(نطاق_الاسم, _)) -> {
                    طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_الاسم) مع
                    | اختياري.موجود(الرمز) -> { ألحق(الناتج, الرمز); }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            }
            | _ -> { };
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الأبناء) مثل طبيعي)) { ألحق(العمل, الأبناء[ف]); ف := ف + 1; }
        };
    }
    أرجع الناتج;
}

// The or-patterns that bind names inside النمط (not النمط itself), in
// preorder.
عرف ألحق_بدائل_رابطة_داخلية_للخفض(
    سجل_الأنماط: &سجل_أنماط,
    روابط_الأسماء: &سياق_روابط_أسماء,
    النمط: معرف_نمط,
    الناتج: &متغير متجه معرف_نمط
): فراغ {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        ليكن الأبناء: متجه معرف_نمط = أبناء_نمط_دلالي(&القيمة);
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
            طابق نمط_عند(سجل_الأنماط, الأبناء[ف]) مع
            | اختياري.موجود(نمط_دلالي.بدائل(_, البدائل)) -> {
                إذا ((الطول(البدائل) مثل طبيعي) > 0) {
                    ليكن الرموز: متجه معرف_رمز = رموز_روابط_نمط_للخفض(
                        سجل_الأنماط, روابط_الأسماء, البدائل[0]
                    );
                    إذا ((الطول(الرموز) مثل طبيعي) > 0) { ألحق(*الناتج, الأبناء[ف]); };
                };
            }
            | _ -> { };
            ألحق_بدائل_رابطة_داخلية_للخفض(سجل_الأنماط, روابط_الأسماء, الأبناء[ف], الناتج);
            ف := ف + 1;
        }
    };
}

// An `int` constant in the current block: the Type of a sequence's length
// (the `length` primitive's result) and of its positions.
عام عرف ثابت_عدد_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: طبيعي,
    نوع_العدد: معرف_نوع
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    طابق أصدر_ثابتا_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, ثابت_مسير.صحيح_موقع(القيمة مثل عدد), نوع_العدد
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ())); };
}

// A u32 constant in the current block.
عام عرف ثابت_ط32_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    القيمة: طبيعي,
    نوع_ط32: معرف_نوع
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    طابق أصدر_ثابتا_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, ثابت_مسير.صحيح_طبيعي(القيمة), نوع_ط32
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ())); };
}

// An or-pattern whose alternatives bind names (`| (0, x) | (x, 0) -> ...`).
// Each alternative is tested in turn, as for one without names; the
// alternative that matches passes the values it bound, the position of the
// alternative, and those of the or-patterns inside it that bind names (0 for
// the ones of other alternatives), to one join block whose parameters are the
// names' values in the arm. The join block goes on to عند_الصواب; the
// positions are recorded in البدائل_المختارة for the arm's drops.
عرف اخفض_بدائل_رابطة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط,
    نطاق_النمط: نطاق,
    البدائل: &متجه معرف_نمط,
    الرموز: &متجه معرف_رمز,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    البدائل_المختارة: &متغير متجه بديل_مختار_خفض
): اختياري خطأ_خفض_مسير {
    ليكن العدد: طبيعي = الطول(*البدائل) مثل طبيعي;
    ليكن نوع_ط32: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
    | اختياري.موجود(المعرف) -> { نوع_ط32 := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_النمط)); };
    ليكن الداخلية: متغير متجه معرف_نمط = [];
    ليكن ب: متغير طبيعي = 0;
    طالما (ب < العدد) {
        ألحق_بدائل_رابطة_داخلية_للخفض(سجل_الأنماط, روابط_الأسماء, (*البدائل)[ب], &متغير الداخلية);
        ب := ب + 1;
    }
    ليكن الأصل: حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    ليكن الدمج: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { الدمج := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    ليكن معاملات_الربط: متغير متجه معرف_قيمة_مسير = [];
    ليكن أنواع_الربط: متغير متجه معرف_نوع = [];
    ليكن معامل_الموضع: متغير معرف_قيمة_مسير = القيمة.المعرف;
    ليكن معاملات_الداخلية: متغير متجه معرف_قيمة_مسير = [];
    ليكن كتلة_الاختبار: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    ب := 0;
    ليكن الأخير: متغير منطقي = خطأ;
    طالما (ب < العدد && !الأخير) {
        // An alternative that matches every value is the last one tried.
        الأخير := (ب + 1) == العدد
            || نمط_غير_قابل_للدحض_للخفض(سجل_الأنماط, التحقق, الأنواع, (*البدائل)[ب]);
        ليكن الفشل: متغير معرف_كتلة_مسير = عند_الخطأ;
        إذا (!الأخير) {
            طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { الفشل := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        ليكن النجاح: معرف_كتلة_مسير;
        طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
        | نتيجة.نجح(الكتلة) -> { النجاح := الكتلة; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        ليكن حالة_البديل: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(&الأصل);
        حالة_البديل.الكتلة := كتلة_الاختبار;
        حالة_البديل.نشطة := صواب;
        ليكن مختارة_البديل: متغير متجه بديل_مختار_خفض = [];
        طابق اخفض_نمط_إلى_مسير(
            البرنامج, &متغير حالة_البديل, التحقق, (*البدائل)[ب], القيمة,
            النجاح, الفشل, الأنواع, روابط_الأسماء, سجل_الأنماط, &متغير مختارة_البديل
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        // The join block's parameters, typed as the first alternative bound.
        إذا (ب == 0) {
            ليكن ر: متغير طبيعي = 0;
            طالما (ر < (الطول(*الرموز) مثل طبيعي)) {
                طابق موضع_محلي_خفض(&حالة_البديل, (*الرموز)[ر]) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.رمز_محلي_مفقود((*الرموز)[ر]));
                }
                | اختياري.موجود(الموضع) -> {
                    ليكن نوع_الربط: معرف_نوع = حالة_البديل.المحليات[الموضع].النوع;
                    طابق أضف_معامل_كتلة_مسير(البرنامج, الأصل.الدالة, الدمج, نوع_الربط) مع
                    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                        ألحق(معاملات_الربط, المعرف);
                        ألحق(أنواع_الربط, نوع_الربط);
                    }
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                    };
                };
                ر := ر + 1;
            }
            طابق أضف_معامل_كتلة_مسير(البرنامج, الأصل.الدالة, الدمج, نوع_ط32) مع
            | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معامل_الموضع := المعرف; }
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            }
            | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            ليكن د: متغير طبيعي = 0;
            طالما (د < (الطول(الداخلية) مثل طبيعي)) {
                طابق أضف_معامل_كتلة_مسير(البرنامج, الأصل.الدالة, الدمج, نوع_ط32) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ألحق(معاملات_الداخلية, المعرف); }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                د := د + 1;
            }
        };
        // The matched alternative passes what it bound to the join block.
        ليكن حالة_النجاح: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(&حالة_البديل);
        حالة_النجاح.الكتلة := النجاح;
        حالة_النجاح.نشطة := صواب;
        ليكن الحجج: متغير متجه معرف_قيمة_مسير = [];
        ليكن ر: متغير طبيعي = 0;
        طالما (ر < (الطول(*الرموز) مثل طبيعي)) {
            طابق موضع_محلي_خفض(&حالة_البديل, (*الرموز)[ر]) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.رمز_محلي_مفقود((*الرموز)[ر]));
            }
            | اختياري.موجود(الموضع) -> {
                طابق حالة_البديل.المحليات[الموضع].المعلقة مع
                | اختياري.موجود(المعرف) -> { ألحق(الحجج, المعرف); }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.رمز_محلي_مفقود((*الرموز)[ر]));
                };
            };
            ر := ر + 1;
        }
        طابق ثابت_ط32_للخفض(البرنامج, &حالة_النجاح, ب, نوع_ط32) مع
        | نتيجة.نجح(المعرف) -> { ألحق(الحجج, المعرف); }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        ليكن د: متغير طبيعي = 0;
        طالما (د < (الطول(الداخلية) مثل طبيعي)) {
            ليكن وجد: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
            ليكن م: متغير طبيعي = 0;
            طالما (م < (الطول(مختارة_البديل) مثل طبيعي)) {
                إذا (معرفا_نمط_متساويان(مختارة_البديل[م].النمط, الداخلية[د])) {
                    وجد := اختياري.موجود(مختارة_البديل[م].القيمة);
                };
                م := م + 1;
            }
            طابق وجد مع
            | اختياري.موجود(المعرف) -> { ألحق(الحجج, المعرف); }
            | اختياري.لا_شيء -> {
                طابق ثابت_ط32_للخفض(البرنامج, &حالة_النجاح, 0, نوع_ط32) مع
                | نتيجة.نجح(المعرف) -> { ألحق(الحجج, المعرف); }
                | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
            د := د + 1;
        }
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_النجاح, الدمج, الحجج) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        كتلة_الاختبار := الفشل;
        ب := ب + 1;
    }
    // From the join block on, the names hold its parameters.
    ليكن النهائية: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(&الأصل);
    النهائية.الكتلة := الدمج;
    النهائية.نشطة := صواب;
    ليكن ر: متغير طبيعي = 0;
    طالما (ر < (الطول(*الرموز) مثل طبيعي)) {
        طابق أضف_محلي_خفض(
            &متغير النهائية, (*الرموز)[ر], أنواع_الربط[ر], اختياري.موجود(معاملات_الربط[ر])
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ر := ر + 1;
    }
    ليكن المختار: بديل_مختار_خفض = { النمط: النمط, القيمة: معامل_الموضع };
    ألحق(*البدائل_المختارة, المختار);
    ليكن د: متغير طبيعي = 0;
    طالما (د < (الطول(الداخلية) مثل طبيعي)) {
        ليكن الداخلي: بديل_مختار_خفض = { النمط: الداخلية[د], القيمة: معاملات_الداخلية[د] };
        ألحق(*البدائل_المختارة, الداخلي);
        د := د + 1;
    }
    طابق اختم_بفرع_للخفض(البرنامج, &النهائية, عند_الصواب, []) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    *الحالة := النهائية;
    أرجع اختياري.لا_شيء();
}

// The value an MSIR builder call made: a constant, a length, a comparison, or a difference.
عرف قيمة_بناء_للخفض(
    النتيجة: نتيجة_بناء_قيمة_مسير
): نتيجة معرف_قيمة_مسير, خطأ_خفض_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع نتيجة.نجح(المعرف); }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع نتيجة.خطأ(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ())); };
}

// A vector or slice pattern `[p, q, rest tail, r]`: one length test (exactly the
// elements written, or at least them with a rest), then each element by its
// index, from the front before the rest and from the end after it. The
// length test proves every index in bounds, so the elements are read without
// a check. A `rest name` is bound to the slice of the elements it stands for
// (مقطع_تسلسل: a view of the sequence's own memory, with no copy).
عرف اخفض_تسلسل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    نطاق_النمط: نطاق,
    السابقة: &متجه معرف_نمط,
    البقية: اختياري معرف_نمط,
    اللاحقة: &متجه معرف_نمط,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    البدائل_المختارة: &متغير متجه بديل_مختار_خفض
): اختياري خطأ_خفض_مسير {
    ليكن نوع_العنصر: معرف_نوع;
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, القيمة.النوع) مع
    | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_النمط)); };
    ليكن نوع_العدد_للمواضع: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد_للمواضع := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_النمط)); };
    ليكن نوع_المنطق: معرف_نوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_النمط)); };
    ليكن عدد_السابقة: طبيعي = الطول(*السابقة) مثل طبيعي;
    ليكن عدد_اللاحقة: طبيعي = الطول(*اللاحقة) مثل طبيعي;
    ليكن له_بقية: متغير منطقي = خطأ;
    طابق البقية مع
    | اختياري.موجود(_) -> { له_بقية := صواب; }
    | اختياري.لا_شيء -> { };
    // The length test, in the current block.
    ليكن الأصل: حالة_خفض_دالة = *الحالة;
    ليكن حجج_الطول: متجه معرف_قيمة_مسير = [القيمة.المعرف];
    ليكن الطول_القيمة: معرف_قيمة_مسير;
    طابق قيمة_بناء_للخفض(أصدر_نداء_بدائي_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, هوية_بدائي_مترجم.طول(),
        حجج_الطول, اختياري.موجود(نوع_العدد_للمواضع), اختياري.لا_شيء()
    )) مع
    | نتيجة.نجح(المعرف) -> { الطول_القيمة := المعرف; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    ليكن المطلوب: معرف_قيمة_مسير;
    طابق ثابت_عدد_للخفض(البرنامج, الحالة, عدد_السابقة + عدد_اللاحقة, نوع_العدد_للمواضع) مع
    | نتيجة.نجح(المعرف) -> { المطلوب := المعرف; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    ليكن المقارنة: متغير عملية_مقارنة_صحيح = عملية_مقارنة_صحيح.يساوي();
    إذا (له_بقية) { المقارنة := عملية_مقارنة_صحيح.أكبر_أو_يساوي(); };
    ليكن الشرط: معرف_قيمة_مسير;
    طابق قيمة_بناء_للخفض(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &الأصل.البناء, الأصل.الدالة, الأصل.الكتلة, المقارنة,
        الطول_القيمة, المطلوب, نوع_المنطق
    )) مع
    | نتيجة.نجح(المعرف) -> { الشرط := المعرف; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    ليكن كتلة_العناصر: معرف_كتلة_مسير;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_العناصر := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    طابق اختم_اختبار_نمط_للخفض(البرنامج, الحالة, الشرط, كتلة_العناصر, عند_الخطأ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    ليكن حالة_العناصر: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    حالة_العناصر.الكتلة := كتلة_العناصر;
    حالة_العناصر.نشطة := صواب;
    // `rest name`: the slice of the elements between the front and the end ones.
    طابق البقية مع
    | اختياري.موجود(ابن_البقية) -> {
        طابق نمط_عند(سجل_الأنماط, ابن_البقية) مع
        | اختياري.موجود(نمط_دلالي.ربط(نطاق_الاسم, _)) -> {
            ليكن نوع_الشريحة: معرف_نوع;
            طابق نوع_عقدة_نمط_عند(التحقق, ابن_البقية) مع
            | اختياري.موجود(النوع) -> { نوع_الشريحة := النوع; }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_الاسم)); };
            ليكن البداية: معرف_قيمة_مسير;
            طابق ثابت_عدد_للخفض(البرنامج, &حالة_العناصر, عدد_السابقة, نوع_العدد_للمواضع) مع
            | نتيجة.نجح(المعرف) -> { البداية := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            ليكن طول_البقية: معرف_قيمة_مسير;
            طابق قيمة_بناء_للخفض(أصدر_حسابا_صحيحا_مسير(
                البرنامج, &حالة_العناصر.البناء, حالة_العناصر.الدالة, حالة_العناصر.الكتلة,
                عملية_حساب_صحيح.طرح(), الطول_القيمة, المطلوب, نوع_العدد_للمواضع
            )) مع
            | نتيجة.نجح(المعرف) -> { طول_البقية := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            ليكن العرض: معرف_قيمة_مسير;
            طابق قيمة_بناء_للخفض(أصدر_مقطع_تسلسل_مسير(
                البرنامج, &حالة_العناصر.البناء, حالة_العناصر.الدالة, حالة_العناصر.الكتلة,
                القيمة.المعرف, البداية, طول_البقية, نوع_الشريحة
            )) مع
            | نتيجة.نجح(المعرف) -> { العرض := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_الاسم) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_الاسم)); }
            | اختياري.موجود(الرمز) -> {
                طابق أضف_محلي_خفض(&متغير حالة_العناصر, الرمز, نوع_الشريحة, اختياري.موجود(العرض)) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    // Each element: from the front, then from the end.
    ليكن العناصر: متغير متجه معرف_نمط = انسخ_مملوكا_متجه_معرف_نمط(السابقة);
    ليكن ل: متغير طبيعي = 0;
    طالما (ل < عدد_اللاحقة) { ألحق(العناصر, (*اللاحقة)[ل]); ل := ل + 1; }
    ليكن العدد: طبيعي = الطول(العناصر) مثل طبيعي;
    إذا (العدد == 0) {
        طابق اختم_بفرع_للخفض(البرنامج, &حالة_العناصر, عند_الصواب, []) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        *الحالة := حالة_العناصر;
        أرجع اختياري.لا_شيء();
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن الفهرس: متغير معرف_قيمة_مسير = القيمة.المعرف;
        إذا (ف < عدد_السابقة) {
            طابق ثابت_عدد_للخفض(البرنامج, &حالة_العناصر, ف, نوع_العدد_للمواضع) مع
            | نتيجة.نجح(المعرف) -> { الفهرس := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        } وإلا {
            // The element (العدد - ف) from the end.
            ليكن من_النهاية: معرف_قيمة_مسير;
            طابق ثابت_عدد_للخفض(البرنامج, &حالة_العناصر, العدد - ف, نوع_العدد_للمواضع) مع
            | نتيجة.نجح(المعرف) -> { من_النهاية := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            طابق قيمة_بناء_للخفض(أصدر_حسابا_صحيحا_مسير(
                البرنامج, &حالة_العناصر.البناء, حالة_العناصر.الدالة, حالة_العناصر.الكتلة,
                عملية_حساب_صحيح.طرح(), الطول_القيمة, من_النهاية, نوع_العدد_للمواضع
            )) مع
            | نتيجة.نجح(المعرف) -> { الفهرس := المعرف; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        ليكن الابن: معرف_نمط = العناصر[ف];
        ليكن نوع_الابن: متغير معرف_نوع = نوع_العنصر;
        طابق نوع_عقدة_نمط_عند(التحقق, الابن) مع
        | اختياري.موجود(النوع) -> { نوع_الابن := النوع; }
        | اختياري.لا_شيء -> { };
        ليكن قيمة_العنصر: معرف_قيمة_مسير;
        طابق قيمة_بناء_للخفض(أصدر_استخراج_فهرس_مسير(
            البرنامج, &حالة_العناصر.البناء, حالة_العناصر.الدالة, حالة_العناصر.الكتلة,
            القيمة.المعرف, الفهرس, نوع_الابن
        )) مع
        | نتيجة.نجح(المعرف) -> { قيمة_العنصر := المعرف; }
        | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
        إذا ((ف + 1) < العدد) {
            طابق أضف_كتلة_للخفض(البرنامج, حالة_العناصر.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { التالي := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        ليكن خفض_العنصر: قيمة_خفض_مسير = { المعرف: قيمة_العنصر, النوع: نوع_الابن };
        طابق اخفض_نمط_إلى_مسير(
            البرنامج, &متغير حالة_العناصر, التحقق, الابن, خفض_العنصر,
            التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        حالة_العناصر.الكتلة := التالي;
        حالة_العناصر.نشطة := صواب;
        ف := ف + 1;
    }
    *الحالة := حالة_العناصر;
    أرجع اختياري.لا_شيء();
}

عام عرف اخفض_نمط_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    البدائل_المختارة: &متغير متجه بديل_مختار_خفض
): اختياري خطأ_خفض_مسير {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ()));
    }
    | اختياري.موجود(النمط_الدلالي) -> {
        طابق النمط_الدلالي مع
        | نمط_دلالي.بدل(_) -> {
            أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, []);
        }
        | نمط_دلالي.تسلسل(نطاق_النمط, السابقة, البقية, اللاحقة) -> {
            أرجع اخفض_تسلسل_إلى_مسير(
                البرنامج, الحالة, التحقق, نطاق_النمط, &السابقة, البقية, &اللاحقة, القيمة,
                عند_الصواب, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
            );
        }
        | نمط_دلالي.مستعار(نطاق_النمط, الداخل, الربط) -> {
            // The name holds the whole value; then its pattern is tested.
            طابق نمط_عند(سجل_الأنماط, الربط) مع
            | اختياري.موجود(نمط_دلالي.ربط(نطاق_الربط, _)) -> {
                طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_الربط) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_الربط));
                }
                | اختياري.موجود(الرمز) -> {
                    طابق أضف_محلي_خفض(
                        الحالة, الرمز, القيمة.النوع, اختياري.موجود(القيمة.المعرف)
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط)); };
            أرجع اخفض_نمط_إلى_مسير(
                البرنامج, الحالة, التحقق, الداخل, القيمة, عند_الصواب, عند_الخطأ,
                الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
            );
        }
        | نمط_دلالي.ربط(نطاق_النمط, _) -> {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_النمط) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            }
            | اختياري.موجود(الرمز) -> {
                طابق أضف_محلي_خفض(
                    الحالة, الرمز, القيمة.النوع, اختياري.موجود(القيمة.المعرف)
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, []);
            };
        }
        | نمط_دلالي.حرفي(نطاق_النمط, الحرفي) -> {
            طابق الحرفي مع
            | قيمة_نمط_حرفي.منطقي(المطلوب) -> {
                إذا (المطلوب) {
                    أرجع اختم_اختبار_نمط_للخفض(
                        البرنامج, الحالة, القيمة.المعرف, عند_الصواب, عند_الخطأ
                    );
                };
                أرجع اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, القيمة.المعرف, عند_الخطأ, عند_الصواب
                );
            }
            | قيمة_نمط_حرفي.عدد(_) -> {
                أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &الحرفي, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.عدد_طبيعي(_) -> {
                أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &الحرفي, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.حرف(المحرف) -> {
                أرجع اخفض_نمط_حرف_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, المحرف, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.نص(البايتات) -> {
                أرجع اخفض_نمط_نص_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &البايتات, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            };
        }
        | نمط_دلالي.مدى(نطاق_النمط, الأدنى, الأعلى) -> {
            أرجع اخفض_نمط_مدى_إلى_مسير(
                البرنامج, الحالة, نطاق_النمط, &الأدنى, &الأعلى, القيمة,
                عند_الصواب, عند_الخطأ, الأنواع
            );
        }
        | نمط_دلالي.بدائل(نطاق_النمط, البدائل) -> {
            ليكن العدد: طبيعي = الطول(البدائل) مثل طبيعي;
            إذا (العدد == 0) {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            ليكن رموز_البدائل: متجه معرف_رمز = رموز_روابط_نمط_للخفض(
                سجل_الأنماط, روابط_الأسماء, البدائل[0]
            );
            إذا ((الطول(رموز_البدائل) مثل طبيعي) > 0) {
                أرجع اخفض_بدائل_رابطة_إلى_مسير(
                    البرنامج, الحالة, التحقق, النمط, نطاق_النمط, &البدائل, &رموز_البدائل, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
                );
            };
            ليكن حالة_بديل: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            ليكن ف: متغير طبيعي = 0;
            ليكن الأخير: متغير منطقي = خطأ;
            طالما (ف < العدد && !الأخير) {
                // An alternative that matches every value is the last one tried.
                الأخير := (ف + 1) == العدد
                    || نمط_غير_قابل_للدحض_للخفض(سجل_الأنماط, التحقق, الأنواع, البدائل[ف]);
                ليكن فشل_هذا: متغير معرف_كتلة_مسير = عند_الخطأ;
                إذا (!الأخير) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_بديل.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> { فشل_هذا := الكتلة; }
                    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_بديل, التحقق, البدائل[ف], القيمة,
                    عند_الصواب, فشل_هذا, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                إذا (!الأخير) {
                    حالة_بديل.الكتلة := فشل_هذا;
                    حالة_بديل.نشطة := صواب;
                };
                ف := ف + 1;
            }
            *الحالة := حالة_بديل;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.منشئ(نطاق_النمط, _, الحمولات) -> {
            ليكن الهوية: متغير هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
            طابق هوية_منشئ_نمط_محلولة_عند(التحقق, النمط) مع
            | اختياري.موجود(القيمة_الدلالية) -> {
                الهوية := القيمة_الدلالية;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            ليكن ترتيب: متغير طبيعي = 0;
            طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, القيمة.النوع, الهوية) مع
            | اختياري.موجود(الفهرس) -> {
                ترتيب := الفهرس;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            ليكن نوع_الوسم: متغير معرف_نوع = القيمة.النوع;
            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
            | اختياري.موجود(المعرف) -> {
                نوع_الوسم := المعرف;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ()));
            };
            ليكن نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
            | اختياري.موجود(المعرف) -> {
                نوع_المنطق := المعرف;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ()));
            };
            ليكن دالة_الأصل: معرف_دالة_مسير = (*الحالة).الدالة;
            ليكن كتلة_الأصل: معرف_كتلة_مسير = (*الحالة).الكتلة;
            // A constructor of a single-constructor type always matches its
            // tag: no test is emitted and the payload extraction stays in the
            // current block. (Previously the always-true test still branched
            // to the failure target, which for an irrefutable match arm is the
            // arm body itself, so payload bindings did not dominate their uses.)
            ليكن منشئ_وحيد: متغير منطقي = خطأ;
            طابق عدد_منشئات_نوع_دلالي(الأنواع, القيمة.النوع) مع
            | اختياري.موجود(عدد_المنشئات) -> { منشئ_وحيد := عدد_المنشئات == 1; }
            | اختياري.لا_شيء -> { };
            ليكن قيمة_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            ليكن ثابت_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            ليكن شرط_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            إذا (!منشئ_وحيد) {
                طابق أصدر_استعلام_وسم_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    القيمة.المعرف,
                    نوع_الوسم
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                طابق أصدر_ثابتا_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    ثابت_مسير.صحيح_طبيعي(ترتيب),
                    نوع_الوسم
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    ثابت_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                طابق أصدر_مقارنة_صحيح_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    عملية_مقارنة_صحيح.يساوي(),
                    قيمة_الوسم,
                    ثابت_الوسم,
                    نوع_المنطق
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    شرط_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
            };
            ليكن عدد_الحمولات: طبيعي = الطول(الحمولات) مثل طبيعي;
            إذا (عدد_الحمولات == 0) {
                إذا (منشئ_وحيد) {
                    أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, []);
                };
                أرجع اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, شرط_الوسم, عند_الصواب, عند_الخطأ
                );
            };
            ليكن كتلة_الحمولات: متغير معرف_كتلة_مسير = كتلة_الأصل;
            إذا (!منشئ_وحيد) {
                طابق أضف_كتلة_للخفض(البرنامج, دالة_الأصل) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_الحمولات := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
                طابق اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, شرط_الوسم, كتلة_الحمولات, عند_الخطأ
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            };
            ليكن حالة_حمولة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            حالة_حمولة.الكتلة := كتلة_الحمولات;
            حالة_حمولة.نشطة := صواب;
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < عدد_الحمولات) {
                ليكن الابن: معرف_نمط = الحمولات[ف];
                ليكن نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الابن) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن قيمة_الابن: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حمولة_مسير(
                    البرنامج,
                    &حالة_حمولة.البناء,
                    حالة_حمولة.الدالة,
                    حالة_حمولة.الكتلة,
                    القيمة.المعرف,
                    ترتيب,
                    ف,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الابن := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_الحمولات) {
                    طابق أضف_كتلة_للخفض(البرنامج, دالة_الأصل) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                ليكن خفض_الابن: قيمة_خفض_مسير = {
                    المعرف: قيمة_الابن,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_حمولة, التحقق, الابن, خفض_الابن,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_حمولة.الكتلة := التالي;
                حالة_حمولة.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_حمولة;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.سجل(نطاق_النمط, الحقول) -> {
            ليكن عدد_الحقول: طبيعي = الطول(الحقول) مثل طبيعي;
            إذا (عدد_الحقول == 0) {
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, []);
            };
            ليكن حالة_حقل: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < عدد_الحقول) {
                ليكن الحقل: حقل_نمط_دلالي = الحقول[ف];
                ليكن الترتيب: متغير طبيعي = 0;
                طابق ترتيب_حقل_سجل_دلالي_بالاسم(
                    الأنواع, القيمة.النوع, الحقل.الاسم
                ) مع
                | اختياري.موجود(الفهرس) -> {
                    الترتيب := الفهرس;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الحقل.النمط) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن قيمة_الحقل: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حقل_مسير(
                    البرنامج,
                    &حالة_حقل.البناء,
                    حالة_حقل.الدالة,
                    حالة_حقل.الكتلة,
                    القيمة.المعرف,
                    الترتيب,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الحقل := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_الحقول) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_حقل.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                ليكن خفض_الحقل: قيمة_خفض_مسير = {
                    المعرف: قيمة_الحقل,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_حقل, التحقق, الحقل.النمط, خفض_الحقل,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_حقل.الكتلة := التالي;
                حالة_حقل.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_حقل;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.صف(نطاق_النمط, العناصر) -> {
            ليكن عدد_العناصر: طبيعي = الطول(العناصر) مثل طبيعي;
            إذا (عدد_العناصر == 0) {
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, []);
            };
            ليكن حالة_عنصر: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < عدد_العناصر) {
                ليكن الابن: معرف_نمط = العناصر[ف];
                ليكن نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الابن) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن قيمة_العنصر: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حقل_مسير(
                    البرنامج,
                    &حالة_عنصر.البناء,
                    حالة_عنصر.الدالة,
                    حالة_عنصر.الكتلة,
                    القيمة.المعرف,
                    ف,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_العنصر := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                ليكن التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_العناصر) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_عنصر.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                ليكن خفض_العنصر: قيمة_خفض_مسير = {
                    المعرف: قيمة_العنصر,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_عنصر, التحقق, الابن, خفض_العنصر,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط, البدائل_المختارة
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_عنصر.الكتلة := التالي;
                حالة_عنصر.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_عنصر;
            أرجع اختياري.لا_شيء();
        };
    };
}
