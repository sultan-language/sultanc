استورد compiler.frontend.types.type_context;
// ترجمة Pattern الدلالي المتحقق إلى MSIR. لا يعاد بناء صنف النمط أو نوعه أو هوية منشئه هنا.
// Literal Pattern lowering reuses the expected semantic Type already proven by Pattern validation.
عرف ابن_ثابت_عدد_نمط_مسير(
    الحرفي: &قيمة_نمط_حرفي,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري ثابت_مسير {
    طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الوصف) -> {
        دع القيمة: قيمة_نمط_حرفي = *الحرفي;
        طابق القيمة مع
        | قيمة_نمط_حرفي.عدد(العدد) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(العدد));
            };
            إذا (العدد < 0) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(العدد مثل طبيعي));
        }
        | قيمة_نمط_حرفي.عدد_طبيعي(العدد) -> {
            إذا (الوصف.موقع) {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(العدد مثل عدد));
            };
            أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(العدد));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف اخفض_نمط_عدد_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    الحرفي: &قيمة_نمط_حرفي,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    دع الثابت: ثابت_مسير;
    طابق ابن_ثابت_عدد_نمط_مسير(الحرفي, القيمة.النوع, الأنواع) مع
    | اختياري.موجود(الموجود) -> { الثابت := الموجود; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع الأصل: حالة_خفض_دالة = *الحالة;
    دع معرف_الثابت: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        الثابت,
        القيمة.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الثابت := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع الشرط: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        عملية_مقارنة_صحيح.يساوي(),
        القيمة.المعرف,
        معرف_الثابت,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الشرط := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    أرجع اختم_اختبار_نمط_للخفض(البرنامج, الحالة, الشرط, عند_الصواب, عند_الخطأ);
}

عرف اخفض_نمط_حرف_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    المحرف: ط32,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    // The scrutinee's scalar value, by the rule character comparisons use.
    دع قيمة_ط32: متغير قيمة_خفض_مسير = القيمة;
    طابق اخفض_حرف_إلى_قيمته_العددية_مسير(
        البرنامج, الحالة, النطاق, القيمة, الأنواع
    ) مع
    | نتيجة_خفض_تعبير.قيمة(المخفضة) -> { قيمة_ط32 := المخفضة; }
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع الحرفي_العددي: قيمة_نمط_حرفي = قيمة_نمط_حرفي.عدد_طبيعي(المحرف مثل طبيعي);
    أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
        البرنامج, الحالة, النطاق, &الحرفي_العددي, قيمة_ط32,
        عند_الصواب, عند_الخطأ, الأنواع
    );
}

عرف اخفض_نمط_مدى_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الأدنى: &قيمة_نمط_حرفي,
    الأعلى: &قيمة_نمط_حرفي,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع قيمة_المقارنة: متغير قيمة_خفض_مسير = القيمة;
    دع حد_أدنى: متغير قيمة_نمط_حرفي = انسخ_مملوكا_قيمة_نمط_حرفي(الأدنى);
    دع حد_أعلى: متغير قيمة_نمط_حرفي = انسخ_مملوكا_قيمة_نمط_حرفي(الأعلى);
    طابق حد_أدنى مع
    | قيمة_نمط_حرفي.حرف(المحرف) -> {
        طابق اخفض_حرف_إلى_قيمته_العددية_مسير(
            البرنامج, الحالة, النطاق, القيمة, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(المخفضة) -> { قيمة_المقارنة := المخفضة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        حد_أدنى := قيمة_نمط_حرفي.عدد_طبيعي(المحرف مثل طبيعي);
        طابق حد_أعلى مع
        | قيمة_نمط_حرفي.حرف(المحرف_الأعلى) -> {
            حد_أعلى := قيمة_نمط_حرفي.عدد_طبيعي(المحرف_الأعلى مثل طبيعي);
        }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    }
    | _ -> { };

    دع نوع_المنطق: متغير معرف_نوع = قيمة_المقارنة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    دع ثابت_أدنى: ثابت_مسير;
    دع ثابت_أعلى: ثابت_مسير;
    طابق ابن_ثابت_عدد_نمط_مسير(&حد_أدنى, قيمة_المقارنة.النوع, الأنواع) مع
    | اختياري.موجود(الثابت) -> { ثابت_أدنى := الثابت; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    طابق ابن_ثابت_عدد_نمط_مسير(&حد_أعلى, قيمة_المقارنة.النوع, الأنواع) مع
    | اختياري.موجود(الثابت) -> { ثابت_أعلى := الثابت; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };

    دع الأصل: حالة_خفض_دالة = *الحالة;
    دع معرف_الأدنى: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        ثابت_أدنى,
        قيمة_المقارنة.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الأدنى := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع شرط_الأدنى: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        عملية_مقارنة_صحيح.أكبر_أو_يساوي(),
        قيمة_المقارنة.المعرف,
        معرف_الأدنى,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_الأدنى := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };

    دع كتلة_الأعلى: متغير معرف_كتلة_مسير = عند_الصواب;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_الأعلى := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    طابق اختم_اختبار_نمط_للخفض(
        البرنامج, الحالة, شرط_الأدنى, كتلة_الأعلى, عند_الخطأ
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع حالة_الأعلى: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    حالة_الأعلى.الكتلة := كتلة_الأعلى;
    حالة_الأعلى.نشطة := صواب;
    دع معرف_الأعلى: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &حالة_الأعلى.البناء,
        حالة_الأعلى.الدالة,
        حالة_الأعلى.الكتلة,
        ثابت_أعلى,
        قيمة_المقارنة.النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الأعلى := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    دع شرط_الأعلى: متغير معرف_قيمة_مسير = قيمة_المقارنة.المعرف;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &حالة_الأعلى.البناء,
        حالة_الأعلى.الدالة,
        حالة_الأعلى.الكتلة,
        عملية_مقارنة_صحيح.أصغر_أو_يساوي(),
        قيمة_المقارنة.المعرف,
        معرف_الأعلى,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_الأعلى := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)); };
    *الحالة := حالة_الأعلى;
    أرجع اختم_اختبار_نمط_للخفض(
        البرنامج, الحالة, شرط_الأعلى, عند_الصواب, عند_الخطأ
    );
}

عرف اخفض_نمط_نص_حرفي_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    البايتات: &متجه ط8,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع
): اختياري خطأ_خفض_مسير {
    دع قيم_البايتات: متجه ط8 = *البايتات;
    دع نوع_العدد: متغير معرف_نوع = القيمة.النوع;
    دع نوع_البايت: متغير معرف_نوع = القيمة.النوع;
    دع نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.عدد()) مع
    | اختياري.موجود(المعرف) -> { نوع_العدد := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8()) مع
    | اختياري.موجود(المعرف) -> { نوع_البايت := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };
    طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
    | اختياري.موجود(المعرف) -> { نوع_المنطق := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(النطاق)); };

    دع الأصل: حالة_خفض_دالة = *الحالة;
    دع حجج_الطول: متجه معرف_قيمة_مسير = [القيمة.المعرف];
    دع قيمة_الطول: متغير معرف_قيمة_مسير = القيمة.المعرف;
    طابق أصدر_نداء_بدائي_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        هوية_بدائي_مترجم.طول(),
        &حجج_الطول,
        اختياري.موجود(نوع_العدد),
        اختياري.لا_شيء()
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع ثابت_الطول: متغير معرف_قيمة_مسير = قيمة_الطول;
    طابق أصدر_ثابتا_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        ثابت_مسير.صحيح_موقع(الطول(قيم_البايتات)),
        نوع_العدد
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ثابت_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع شرط_الطول: متغير معرف_قيمة_مسير = قيمة_الطول;
    طابق أصدر_مقارنة_صحيح_مسير(
        البرنامج,
        &الأصل.البناء,
        الأصل.الدالة,
        الأصل.الكتلة,
        عملية_مقارنة_صحيح.يساوي(),
        قيمة_الطول,
        ثابت_الطول,
        نوع_المنطق
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_الطول := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    دع العدد: طبيعي = الطول(قيم_البايتات) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع اختم_اختبار_نمط_للخفض(
            البرنامج, الحالة, شرط_الطول, عند_الصواب, عند_الخطأ
        );
    };
    دع كتلة_البايتات: متغير معرف_كتلة_مسير = عند_الصواب;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_البايتات := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
    طابق اختم_اختبار_نمط_للخفض(
        البرنامج, الحالة, شرط_الطول, كتلة_البايتات, عند_الخطأ
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع حالة_بايت: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
    حالة_بايت.الكتلة := كتلة_البايتات;
    حالة_بايت.نشطة := صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع معرف_الفهرس: متغير معرف_قيمة_مسير = القيمة.المعرف;
        طابق أصدر_ثابتا_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            ثابت_مسير.صحيح_موقع(ف مثل عدد),
            نوع_العدد
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معرف_الفهرس := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        دع قيمة_البايت: متغير معرف_قيمة_مسير = القيمة.المعرف;
        طابق أصدر_استخراج_فهرس_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            القيمة.المعرف,
            معرف_الفهرس,
            نوع_البايت
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        دع ثابت_البايت: متغير معرف_قيمة_مسير = قيمة_البايت;
        طابق أصدر_ثابتا_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            ثابت_مسير.صحيح_طبيعي(قيم_البايتات[ف] مثل طبيعي),
            نوع_البايت
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { ثابت_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        دع شرط_البايت: متغير معرف_قيمة_مسير = قيمة_البايت;
        طابق أصدر_مقارنة_صحيح_مسير(
            البرنامج,
            &حالة_بايت.البناء,
            حالة_بايت.الدالة,
            حالة_بايت.الكتلة,
            عملية_مقارنة_صحيح.يساوي(),
            قيمة_البايت,
            ثابت_البايت,
            نوع_المنطق
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { شرط_البايت := المعرف; }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
        };
        دع التالي: متغير معرف_كتلة_مسير = عند_الصواب;
        إذا ((ف + 1) < العدد) {
            طابق أضف_كتلة_للخفض(البرنامج, حالة_بايت.الدالة) مع
            | نتيجة.نجح(الكتلة) -> { التالي := الكتلة; }
            | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
        };
        طابق اختم_اختبار_نمط_للخفض(
            البرنامج, &حالة_بايت, شرط_البايت, التالي, عند_الخطأ
        ) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        حالة_بايت.الكتلة := التالي;
        حالة_بايت.نشطة := صواب;
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اختم_اختبار_نمط_للخفض(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    الشرط: معرف_قيمة_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير
): اختياري خطأ_خفض_مسير {
    دع الأصل: حالة_خفض_دالة = *الحالة;
    دع لا_حجج_أ: متجه معرف_قيمة_مسير = [];
    دع لا_حجج_ب: متجه معرف_قيمة_مسير = [];
    دع حافة_أ: حافة_مسير = { الهدف: عند_الصواب, الحجج: لا_حجج_أ };
    دع حافة_ب: حافة_مسير = { الهدف: عند_الخطأ, الحجج: لا_حجج_ب };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج, الأصل.الدالة, الأصل.الكتلة, الشرط, حافة_أ, حافة_ب
    ) مع
    | نتيجة_بناء_منهي_مسير.مبني -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    };
}

عام عرف اخفض_نمط_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    التحقق: &تحقق_نمط_نوعي,
    النمط: معرف_نمط,
    القيمة: قيمة_خفض_مسير,
    عند_الصواب: معرف_كتلة_مسير,
    عند_الخطأ: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    روابط_الأسماء: &سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط
): اختياري خطأ_خفض_مسير {
    طابق نمط_عند(سجل_الأنماط, النمط) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_فارغ()));
    }
    | اختياري.موجود(النمط_الدلالي) -> {
        طابق النمط_الدلالي مع
        | نمط_دلالي.بدل(_) -> {
            دع لا_حجج: متجه معرف_قيمة_مسير = [];
            أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, &لا_حجج);
        }
        | نمط_دلالي.ربط(نطاق_النمط, _) -> {
            طابق رمز_اسم_محلول_عند(روابط_الأسماء, نطاق_النمط) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            }
            | اختياري.موجود(الرمز) -> {
                طابق أضف_محلي_خفض(
                    الحالة, الرمز, القيمة.النوع, اختياري.موجود(القيمة.المعرف)
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                دع لا_حجج: متجه معرف_قيمة_مسير = [];
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, &لا_حجج);
            };
        }
        | نمط_دلالي.حرفي(نطاق_النمط, الحرفي) -> {
            طابق الحرفي مع
            | قيمة_نمط_حرفي.منطقي(المطلوب) -> {
                إذا (المطلوب) {
                    أرجع اختم_اختبار_نمط_للخفض(
                        البرنامج, الحالة, القيمة.المعرف, عند_الصواب, عند_الخطأ
                    );
                };
                أرجع اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, القيمة.المعرف, عند_الخطأ, عند_الصواب
                );
            }
            | قيمة_نمط_حرفي.عدد(_) -> {
                أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &الحرفي, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.عدد_طبيعي(_) -> {
                أرجع اخفض_نمط_عدد_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &الحرفي, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.حرف(المحرف) -> {
                أرجع اخفض_نمط_حرف_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, المحرف, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            }
            | قيمة_نمط_حرفي.نص(البايتات) -> {
                أرجع اخفض_نمط_نص_حرفي_إلى_مسير(
                    البرنامج, الحالة, نطاق_النمط, &البايتات, القيمة,
                    عند_الصواب, عند_الخطأ, الأنواع
                );
            };
        }
        | نمط_دلالي.مدى(نطاق_النمط, الأدنى, الأعلى) -> {
            أرجع اخفض_نمط_مدى_إلى_مسير(
                البرنامج, الحالة, نطاق_النمط, &الأدنى, &الأعلى, القيمة,
                عند_الصواب, عند_الخطأ, الأنواع
            );
        }
        | نمط_دلالي.بدائل(نطاق_النمط, البدائل) -> {
            دع العدد: طبيعي = الطول(البدائل) مثل طبيعي;
            إذا (العدد == 0) {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            دع حالة_بديل: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                دع فشل_هذا: متغير معرف_كتلة_مسير = عند_الخطأ;
                إذا ((ف + 1) < العدد) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_بديل.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> { فشل_هذا := الكتلة; }
                    | نتيجة.خطأ(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_بديل, التحقق, البدائل[ف], القيمة,
                    عند_الصواب, فشل_هذا, الأنواع, روابط_الأسماء, سجل_الأنماط
                ) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                إذا ((ف + 1) < العدد) {
                    حالة_بديل.الكتلة := فشل_هذا;
                    حالة_بديل.نشطة := صواب;
                };
                ف := ف + 1;
            }
            *الحالة := حالة_بديل;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.منشئ(نطاق_النمط, _, الحمولات) -> {
            دع الهوية: متغير هوية_منشئ_نوع = هوية_منشئ_نوع.اختيار_لا_شيء();
            طابق هوية_منشئ_نمط_محلولة_عند(التحقق, النمط) مع
            | اختياري.موجود(القيمة_الدلالية) -> {
                الهوية := القيمة_الدلالية;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            دع ترتيب: متغير طبيعي = 0;
            طابق ترتيب_منشئ_نوع_دلالي_بالهوية(الأنواع, القيمة.النوع, الهوية) مع
            | اختياري.موجود(الفهرس) -> {
                ترتيب := الفهرس;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
            };
            دع نوع_الوسم: متغير معرف_نوع = القيمة.النوع;
            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
            | اختياري.موجود(المعرف) -> {
                نوع_الوسم := المعرف;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ()));
            };
            دع نوع_المنطق: متغير معرف_نوع = القيمة.النوع;
            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.منطقي()) مع
            | اختياري.موجود(المعرف) -> {
                نوع_المنطق := المعرف;
            }
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_غير_محلول(نطاق_فارغ()));
            };
            دع دالة_الأصل: معرف_دالة_مسير = (*الحالة).الدالة;
            دع كتلة_الأصل: معرف_كتلة_مسير = (*الحالة).الكتلة;
            // A constructor of a single-constructor type always matches its
            // tag: no test is emitted and the payload extraction stays in the
            // current block. (Previously the always-true test still branched
            // to the failure target, which for an irrefutable match arm is the
            // arm body itself, so payload bindings did not dominate their uses.)
            دع منشئ_وحيد: متغير منطقي = خطأ;
            طابق عدد_منشئات_نوع_دلالي(الأنواع, القيمة.النوع) مع
            | اختياري.موجود(عدد_المنشئات) -> { منشئ_وحيد := عدد_المنشئات == 1; }
            | اختياري.لا_شيء -> { };
            دع قيمة_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            دع ثابت_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            دع شرط_الوسم: متغير معرف_قيمة_مسير = القيمة.المعرف;
            إذا (!منشئ_وحيد) {
                طابق أصدر_استعلام_وسم_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    القيمة.المعرف,
                    نوع_الوسم
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                طابق أصدر_ثابتا_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    ثابت_مسير.صحيح_طبيعي(ترتيب),
                    نوع_الوسم
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    ثابت_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                طابق أصدر_مقارنة_صحيح_مسير(
                    البرنامج,
                    &(*الحالة).البناء,
                    دالة_الأصل,
                    كتلة_الأصل,
                    عملية_مقارنة_صحيح.يساوي(),
                    قيمة_الوسم,
                    ثابت_الوسم,
                    نوع_المنطق
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    شرط_الوسم := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
            };
            دع عدد_الحمولات: طبيعي = الطول(الحمولات) مثل طبيعي;
            إذا (عدد_الحمولات == 0) {
                إذا (منشئ_وحيد) {
                    دع لا_حجج: متجه معرف_قيمة_مسير = [];
                    أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, &لا_حجج);
                };
                أرجع اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, شرط_الوسم, عند_الصواب, عند_الخطأ
                );
            };
            دع كتلة_الحمولات: متغير معرف_كتلة_مسير = كتلة_الأصل;
            إذا (!منشئ_وحيد) {
                طابق أضف_كتلة_للخفض(البرنامج, دالة_الأصل) مع
                | نتيجة.نجح(الكتلة) -> {
                    كتلة_الحمولات := الكتلة;
                }
                | نتيجة.خطأ(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                };
                طابق اختم_اختبار_نمط_للخفض(
                    البرنامج, الحالة, شرط_الوسم, كتلة_الحمولات, عند_الخطأ
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
            };
            دع حالة_حمولة: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            حالة_حمولة.الكتلة := كتلة_الحمولات;
            حالة_حمولة.نشطة := صواب;
            دع ف: متغير طبيعي = 0;
            طالما (ف < عدد_الحمولات) {
                دع الابن: معرف_نمط = الحمولات[ف];
                دع نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الابن) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع قيمة_الابن: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حمولة_مسير(
                    البرنامج,
                    &حالة_حمولة.البناء,
                    حالة_حمولة.الدالة,
                    حالة_حمولة.الكتلة,
                    القيمة.المعرف,
                    ترتيب,
                    ف,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الابن := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_الحمولات) {
                    طابق أضف_كتلة_للخفض(البرنامج, دالة_الأصل) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                دع خفض_الابن: قيمة_خفض_مسير = {
                    المعرف: قيمة_الابن,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_حمولة, التحقق, الابن, خفض_الابن,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_حمولة.الكتلة := التالي;
                حالة_حمولة.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_حمولة;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.سجل(نطاق_النمط, الحقول) -> {
            دع عدد_الحقول: طبيعي = الطول(الحقول) مثل طبيعي;
            إذا (عدد_الحقول == 0) {
                دع لا_حجج: متجه معرف_قيمة_مسير = [];
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, &لا_حجج);
            };
            دع حالة_حقل: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < عدد_الحقول) {
                دع الحقل: حقل_نمط_دلالي = الحقول[ف];
                دع الترتيب: متغير طبيعي = 0;
                طابق ترتيب_حقل_سجل_دلالي_بالاسم(
                    الأنواع, القيمة.النوع, الحقل.الاسم
                ) مع
                | اختياري.موجود(الفهرس) -> {
                    الترتيب := الفهرس;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الحقل.النمط) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع قيمة_الحقل: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حقل_مسير(
                    البرنامج,
                    &حالة_حقل.البناء,
                    حالة_حقل.الدالة,
                    حالة_حقل.الكتلة,
                    القيمة.المعرف,
                    الترتيب,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_الحقل := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_الحقول) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_حقل.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                دع خفض_الحقل: قيمة_خفض_مسير = {
                    المعرف: قيمة_الحقل,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_حقل, التحقق, الحقل.النمط, خفض_الحقل,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_حقل.الكتلة := التالي;
                حالة_حقل.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_حقل;
            أرجع اختياري.لا_شيء();
        }
        | نمط_دلالي.صف(نطاق_النمط, العناصر) -> {
            دع عدد_العناصر: طبيعي = الطول(العناصر) مثل طبيعي;
            إذا (عدد_العناصر == 0) {
                دع لا_حجج: متجه معرف_قيمة_مسير = [];
                أرجع اختم_بفرع_للخفض(البرنامج, الحالة, عند_الصواب, &لا_حجج);
            };
            دع حالة_عنصر: متغير حالة_خفض_دالة = انسخ_مملوكا_حالة_خفض_دالة(الحالة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < عدد_العناصر) {
                دع الابن: معرف_نمط = العناصر[ف];
                دع نوع_الابن: متغير معرف_نوع = القيمة.النوع;
                طابق نوع_عقدة_نمط_عند(التحقق, الابن) مع
                | اختياري.موجود(النوع) -> {
                    نوع_الابن := النوع;
                }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع قيمة_العنصر: متغير معرف_قيمة_مسير = القيمة.المعرف;
                طابق أصدر_استخراج_حقل_مسير(
                    البرنامج,
                    &حالة_عنصر.البناء,
                    حالة_عنصر.الدالة,
                    حالة_عنصر.الكتلة,
                    القيمة.المعرف,
                    ف,
                    نوع_الابن
                ) مع
                | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
                    قيمة_العنصر := المعرف;
                }
                | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                }
                | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
                    أرجع اختياري.موجود(خطأ_خفض_مسير.تعبير_غير_مدعوم(نطاق_النمط));
                };
                دع التالي: متغير معرف_كتلة_مسير = عند_الصواب;
                إذا ((ف + 1) < عدد_العناصر) {
                    طابق أضف_كتلة_للخفض(البرنامج, حالة_عنصر.الدالة) مع
                    | نتيجة.نجح(الكتلة) -> {
                        التالي := الكتلة;
                    }
                    | نتيجة.خطأ(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    };
                };
                دع خفض_العنصر: قيمة_خفض_مسير = {
                    المعرف: قيمة_العنصر,
                    النوع: نوع_الابن
                };
                طابق اخفض_نمط_إلى_مسير(
                    البرنامج, &متغير حالة_عنصر, التحقق, الابن, خفض_العنصر,
                    التالي, عند_الخطأ, الأنواع, روابط_الأسماء, سجل_الأنماط
                ) مع
                | اختياري.موجود(الخطأ) -> {
                    أرجع اختياري.موجود(الخطأ);
                }
                | اختياري.لا_شيء -> { };
                حالة_عنصر.الكتلة := التالي;
                حالة_عنصر.نشطة := صواب;
                ف := ف + 1;
            }
            *الحالة := حالة_عنصر;
            أرجع اختياري.لا_شيء();
        };
    };
}
