// `@@track_caller` (`@@يتتبع_المستدعي`, docs/en/reference/testing.md): a
// marked function reports its caller's place. A marked function's last parameter is a
// std.debug.location `موقع_مصدر`: { a reference to the file's path, the
// line, the column }, a plain record. The Type pass gives every use of the
// function its Type without that parameter (types/semantic_pipeline.sn,
// نوع_رمز_لتعبير_داخلي), so a call passes every other argument and lowering
// adds the location, an ordinary constant argument (no backend or
// interpreter knows of it):
//   - a direct call passes the place of the call;
//   - a direct call inside another marked function passes the location that
//     function received, so a helper reports its own caller's place;
//   - a function value of a marked function is its shim, a function of the
//     other parameters that calls it with the place of its definition.
// Each file's path is one immutable text global; the location refers to it.

عرف معرف_نوع_نص_موقع(): معرف_نوع { أرجع معرف_نوع_من(رقم_نوع_بدائي(نوع_بدائي_مقنن.نص())); }

// The global holding the path of source المصدر, made once.
عرف عام_ملف_موقع(
    البرنامج: &متغير برنامج_مسير,
    دوال_الخفض: &متغير سياق_دوال_خفض,
    خريطة_المصادر: &خريطة_مصادر,
    المصدر: ط32
): اختياري معرف_عام_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوال_الخفض).ملفات_المواقع) مثل طبيعي)) {
        إذا ((*دوال_الخفض).ملفات_المواقع[ف].المصدر == المصدر) {
            أرجع اختياري.موجود((*دوال_الخفض).ملفات_المواقع[ف].العام);
        };
        ف := ف + 1;
    }
    طابق اسم_مصدر_من_الخريطة(خريطة_المصادر, المصدر مثل طبيعي) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع العام: معرف_عام_مسير = أضف_عاما_مسير(
            البرنامج, معرف_نوع_نص_موقع(), ثابت_مسير.نص(بايتات_من_نص(الاسم)), خطأ
        );
        دع الملف: ملف_موقع_خفض = { المصدر: المصدر, العام: العام };
        ألحق((*دوال_الخفض).ملفات_المواقع, الملف);
        أرجع اختياري.موجود(العام);
    };
}

// Line indexes of the sources seen so far (by source), built once each.
عام نوع فهرس_مصدر_موقع = { المصدر: ط32, الفهرس: فهرس_سطور };

عام عرف موقع_في_مصدر(
    الفهارس: &متغير متجه فهرس_مصدر_موقع,
    خريطة_المصادر: &خريطة_مصادر,
    الموضع: موضع
): اختياري موقع_مستدع_خفض {
    دع المصدر: طبيعي = الموضع.المصدر مثل طبيعي;
    إذا (المصدر >= (الطول((*خريطة_المصادر).المصادر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الموضع_في_الفهارس: متغير طبيعي = الطول(*الفهارس) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الفهارس) مثل طبيعي)) {
        إذا ((*الفهارس)[ف].المصدر == الموضع.المصدر) { الموضع_في_الفهارس := ف; };
        ف := ف + 1;
    }
    إذا (الموضع_في_الفهارس == (الطول(*الفهارس) مثل طبيعي)) {
        دع الجديد: فهرس_مصدر_موقع = {
            المصدر: الموضع.المصدر,
            الفهرس: ابن_فهرس_السطور(&(*خريطة_المصادر).المصادر[المصدر].المحتوى)
        };
        ألحق(*الفهارس, الجديد);
    };
    طابق إحداثي_مصدر_عند_بفهرس(
        &(*خريطة_المصادر).المصادر[المصدر], &(*الفهارس)[الموضع_في_الفهارس].الفهرس,
        الموضع.البايت مثل طبيعي
    ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الإحداثي) -> {
        دع الموقع: موقع_مستدع_خفض = {
            المصدر: الموضع.المصدر, البايت: الموضع.البايت,
            السطر: الإحداثي.السطر مثل طبيعي, العمود: (الإحداثي.العمود مثل طبيعي) + 1
        };
        أرجع اختياري.موجود(الموقع);
    };
}

// The location value for الموقع, built in الكتلة: the path's text global
// by reference, the line and the column, as the record النوع_الموقع.
عام عرف أصدر_قيمة_موقع_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    نوع_الموقع: معرف_نوع,
    العام: معرف_عام_مسير,
    الموقع: &موقع_مستدع_خفض
): اختياري معرف_قيمة_مسير {
    دع نوع_المرجع: معرف_نوع;
    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, نوع_الموقع, 0) مع
    | اختياري.موجود(ن) -> { نوع_المرجع := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع نوع_العدد: معرف_نوع;
    طابق نوع_حقل_سجل_دلالي_عند(الأنواع, نوع_الموقع, 1) مع
    | اختياري.موجود(ن) -> { نوع_العدد := ن; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع المكان: معرف_قيمة_مسير;
    طابق أصدر_مكان_عام_مسير(البرنامج, البناء, الدالة, الكتلة, العام, معرف_نوع_نص_موقع(), خطأ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { المكان := ق; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع المرجع: معرف_قيمة_مسير;
    طابق أصدر_مكان_إلى_مرجع_مسير(البرنامج, البناء, الدالة, الكتلة, المكان, نوع_المرجع) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { المرجع := ق; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع السطر: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_طبيعي((*الموقع).السطر), نوع_العدد) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { السطر := ق; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع العمود: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_طبيعي((*الموقع).العمود), نوع_العدد) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { العمود := ق; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الأعضاء: متجه معرف_قيمة_مسير = [المرجع, السطر, العمود];
    طابق أصدر_تجميع_مسير(البرنامج, البناء, الدالة, الكتلة, &الأعضاء, نوع_الموقع) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { أرجع اختياري.موجود(ق); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The place of the call whose span starts at البداية.
عام عرف موقع_مستدع_خفض_عند(
    دوال_الخفض: &سياق_دوال_خفض, البداية: موضع
): اختياري موقع_مستدع_خفض {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوال_الخفض).مواقع_المستدعين) مثل طبيعي)) {
        دع الموقع: موقع_مستدع_خفض = (*دوال_الخفض).مواقع_المستدعين[ف];
        إذا (الموقع.المصدر == البداية.المصدر && الموقع.البايت == البداية.البايت) {
            أرجع اختياري.موجود(الموقع);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف عام_ملف_موقع_خفض_عند(دوال_الخفض: &سياق_دوال_خفض, المصدر: ط32): اختياري معرف_عام_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوال_الخفض).ملفات_المواقع) مثل طبيعي)) {
        إذا ((*دوال_الخفض).ملفات_المواقع[ف].المصدر == المصدر) {
            أرجع اختياري.موجود((*دوال_الخفض).ملفات_المواقع[ف].العام);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Whether MSIR function الدالة is a marked function (its last parameter is
// its caller's location).
عام عرف دالة_تتبع_مستدع_خفض(دوال_الخفض: &سياق_دوال_خفض, الدالة: معرف_دالة_مسير): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوال_الخفض).دوال_تتبع_المستدعي) مثل طبيعي)) {
        إذا ((*دوال_الخفض).دوال_تتبع_المستدعي[ف].الدالة.القيمة == الدالة.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The function a function value of الدالة refers to: its shim when it is
// marked, else itself.
عام عرف دالة_قيمة_خفض(دوال_الخفض: &سياق_دوال_خفض, الدالة: معرف_دالة_مسير): معرف_دالة_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*دوال_الخفض).دوال_تتبع_المستدعي) مثل طبيعي)) {
        إذا ((*دوال_الخفض).دوال_تتبع_المستدعي[ف].الدالة.القيمة == الدالة.القيمة) {
            أرجع (*دوال_الخفض).دوال_تتبع_المستدعي[ف].الغلاف;
        };
        ف := ف + 1;
    }
    أرجع الدالة;
}

// The location argument of a call (span starting at البداية) to the marked
// function المستدعاة, in the function being lowered: its own received
// location when that function is marked, else the call's place.
عام عرف حجة_موقع_المستدعي_خفض(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    دوال_الخفض: &سياق_دوال_خفض,
    المستدعاة: معرف_دالة_مسير,
    البداية: موضع
): اختياري معرف_قيمة_مسير {
    إذا (دالة_تتبع_مستدع_خفض(دوال_الخفض, الدالة)) {
        دع العدد: طبيعي = الطول((*البرنامج).الدوال[الدالة.القيمة].المعاملات) مثل طبيعي;
        إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود((*البرنامج).الدوال[الدالة.القيمة].المعاملات[العدد - 1].المعرف);
    };
    دع عدد_المستدعاة: طبيعي = الطول((*البرنامج).الدوال[المستدعاة.القيمة].المعاملات) مثل طبيعي;
    إذا (عدد_المستدعاة == 0) { أرجع اختياري.لا_شيء(); };
    دع نوع_الموقع: معرف_نوع = (*البرنامج).الدوال[المستدعاة.القيمة].المعاملات[عدد_المستدعاة - 1].النوع;
    طابق موقع_مستدع_خفض_عند(دوال_الخفض, البداية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموقع) -> {
        طابق عام_ملف_موقع_خفض_عند(دوال_الخفض, الموقع.المصدر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العام) -> {
            أرجع أصدر_قيمة_موقع_مسير(
                البرنامج, البناء, الدالة, الكتلة, الأنواع, نوع_الموقع, العام, &الموقع
            );
        };
    };
}

// Before function bodies are lowered: the marked functions, the place of
// every call that passes a location (the Type facts: a call of a marked
// function with one argument fewer than its parameters), their files'
// globals, and each marked function's shim. Nothing when no function is
// marked. خطأ when a shim cannot be built (a compiler fault).
عام عرف جهز_مواقع_المستدعين_للخفض(
    البرنامج: &متغير برنامج_مسير,
    دوال_الخفض: &متغير سياق_دوال_خفض,
    الوحدات: &متجه وحدة_مصدر,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز
): منطقي {
    // The marked functions and their definitions' places.
    دع الدوال: متغير متجه معرف_دالة_مسير = [];
    دع التعاريف: متغير متجه موضع = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي) && و < (الطول(*روابط_الأسماء) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الوحدات)[و].العناصر) مثل طبيعي)) {
            طابق (*الوحدات)[و].العناصر[ع] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                إذا (الدالة.يتتبع_المستدعي) {
                    طابق رمز_اسم_محلول_عند(&(*روابط_الأسماء)[و], الدالة.الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
                        | اختياري.موجود(الربط) -> {
                            طابق الربط.الهدف مع
                            | هدف_دالة_خفض.داخلية(المعرف) -> {
                                ألحق(الدوال, المعرف);
                                ألحق(التعاريف, الدالة.الاسم.النطاق.البداية);
                            }
                            | _ -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ع := ع + 1;
        }
        و := و + 1;
    }
    إذا ((الطول(الدوال) مثل طبيعي) == 0) { أرجع صواب; };

    // The calls that pass a location.
    دع الفهارس: متغير متجه فهرس_مصدر_موقع = [];
    و := 0;
    طالما (و < (الطول(*أنواع_التعبيرات) مثل طبيعي)) {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*أنواع_التعبيرات)[و].الاستدعاءات) مثل طبيعي)) {
            طابق (*أنواع_التعبيرات)[و].الاستدعاءات[ف].الرمز مع
            | اختياري.موجود(الرمز) -> {
                إذا (رمز_يتتبع_المستدعي(أنواع_الرموز, الرمز)) {
                    دع البداية: موضع = (*أنواع_التعبيرات)[و].الاستدعاءات[ف].النطاق.البداية;
                    طابق موقع_مستدع_خفض_عند(دوال_الخفض, البداية) مع
                    | اختياري.موجود(_) -> { }
                    | اختياري.لا_شيء -> {
                        طابق موقع_في_مصدر(&متغير الفهارس, خريطة_المصادر, البداية) مع
                        | اختياري.موجود(الموقع) -> {
                            ألحق((*دوال_الخفض).مواقع_المستدعين, الموقع);
                            دع _العام: اختياري معرف_عام_مسير = عام_ملف_موقع(
                                البرنامج, دوال_الخفض, خريطة_المصادر, البداية.المصدر
                            );
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }

    // The shims: a function of all but the last parameter that calls the
    // marked function with its definition's place.
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول(الدوال) مثل طبيعي)) {
        دع المستدعاة: معرف_دالة_مسير = الدوال[د];
        دع العدد: طبيعي = الطول((*البرنامج).الدوال[المستدعاة.القيمة].المعاملات) مثل طبيعي;
        إذا (العدد == 0) { أرجع خطأ; };
        دع أنواع_المعاملات: متغير متجه معرف_نوع = [];
        دع م: متغير طبيعي = 0;
        طالما (م + 1 < العدد) {
            ألحق(أنواع_المعاملات, (*البرنامج).الدوال[المستدعاة.القيمة].المعاملات[م].النوع);
            م := م + 1;
        }
        دع نوع_الموقع: معرف_نوع = (*البرنامج).الدوال[المستدعاة.القيمة].المعاملات[العدد - 1].النوع;
        دع الناتج: اختياري معرف_نوع = (*البرنامج).الدوال[المستدعاة.القيمة].الناتج;
        دع الغلاف: معرف_دالة_مسير = أضف_دالة_مسير(البرنامج, &أنواع_المعاملات, الناتج);
        دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
        دع الكتلة: معرف_كتلة_مسير;
        طابق أضف_كتلة_مسير(البرنامج, الغلاف) مع
        | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> { الكتلة := ك; }
        | _ -> { أرجع خطأ; };
        دع الحجج: متغير متجه معرف_قيمة_مسير = [];
        م := 0;
        طالما (م + 1 < العدد) {
            ألحق(الحجج, (*البرنامج).الدوال[الغلاف.القيمة].المعاملات[م].المعرف);
            م := م + 1;
        }
        دع الموقع: موقع_مستدع_خفض;
        طابق موقع_في_مصدر(&متغير الفهارس, خريطة_المصادر, التعاريف[د]) مع
        | اختياري.موجود(ق) -> { الموقع := ق; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع العام: معرف_عام_مسير;
        طابق عام_ملف_موقع(البرنامج, دوال_الخفض, خريطة_المصادر, التعاريف[د].المصدر) مع
        | اختياري.موجود(ق) -> { العام := ق; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        طابق أصدر_قيمة_موقع_مسير(
            البرنامج, &البناء, الغلاف, الكتلة, الأنواع, نوع_الموقع, العام, &الموقع
        ) مع
        | اختياري.موجود(ق) -> { ألحق(الحجج, ق); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع النداء: اختياري معرف_قيمة_مسير;
        طابق أصدر_نداء_مسير(البرنامج, &البناء, الغلاف, الكتلة, المستدعاة, &الحجج) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { النداء := اختياري.موجود(ق); }
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { النداء := اختياري.لا_شيء(); }
        | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { أرجع خطأ; };
        طابق اختم_بإرجاع_مسير(البرنامج, &البناء, الغلاف, الكتلة, النداء) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(_) -> { أرجع خطأ; }
        | _ -> { };
        دع التتبع: دالة_تتبع_مستدع_خفض = { الدالة: المستدعاة, الغلاف: الغلاف };
        ألحق((*دوال_الخفض).دوال_تتبع_المستدعي, التتبع);
        د := د + 1;
    }
    أرجع صواب;
}
