استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.frontend.ast.operators;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_builder;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.context;

// Target-neutral CFG mechanisms shared by structured lowering. Recursive AST traversal
// remains in expressions/statements to keep the Stage0 import graph acyclic.
عام نوع سياق_منطق_قصير_خفض = {
    حالة_اليمين: حالة_خفض_دالة,
    كتلة_الدمج: معرف_كتلة_مسير,
    معامل_الدمج: معرف_قيمة_مسير
};

عام نوع نتيجة_بدء_منطق_قصير_خفض =
    | مبنية بنوع سياق_منطق_قصير_خفض
    | مرفوضة بنوع خطأ_خفض_مسير
;

عام عرف ابدأ_منطق_قصير_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    قيمة_اليسار: قيمة_خفض_مسير,
    قيمة_الاختصار: معرف_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_بدء_منطق_قصير_خفض {
    دع حالة_الفرع: متغير حالة_خفض_دالة = *الحالة;
    دع كتلة_اليمين: متغير معرف_كتلة_مسير = حالة_الفرع.الكتلة;
    دع كتلة_الدمج: متغير معرف_كتلة_مسير = حالة_الفرع.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, حالة_الفرع.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_اليمين := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(الخطأ);
    };
    طابق أضف_كتلة_للخفض(البرنامج, حالة_الفرع.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الدمج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(الخطأ);
    };

    دع معامل_الدمج: متغير معرف_قيمة_مسير = قيمة_اليسار.المعرف;
    طابق أضف_معامل_كتلة_مسير(
        البرنامج,
        حالة_الفرع.الدالة,
        كتلة_الدمج,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        معامل_الدمج := المعرف;
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(
            خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
        );
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(
            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
        );
    };

    طابق العامل مع
    | عامل_ثنائي.و -> {
        دع بلا_حجج_صواب: متجه معرف_قيمة_مسير = [];
        دع حجة_خطأ: متجه معرف_قيمة_مسير = [قيمة_الاختصار];
        دع حافة_الصواب: حافة_مسير = {
            الهدف: كتلة_اليمين,
            الحجج: بلا_حجج_صواب
        };
        دع حافة_الخطأ: حافة_مسير = {
            الهدف: كتلة_الدمج,
            الحجج: حجة_خطأ
        };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج,
            حالة_الفرع.الدالة,
            حالة_الفرع.الكتلة,
            قيمة_اليسار.المعرف,
            حافة_الصواب,
            حافة_الخطأ
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(
                خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
            );
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    }
    | عامل_ثنائي.أو -> {
        دع حجة_صواب: متجه معرف_قيمة_مسير = [قيمة_الاختصار];
        دع بلا_حجج_خطأ: متجه معرف_قيمة_مسير = [];
        دع حافة_الصواب: حافة_مسير = {
            الهدف: كتلة_الدمج,
            الحجج: حجة_صواب
        };
        دع حافة_الخطأ: حافة_مسير = {
            الهدف: كتلة_اليمين,
            الحجج: بلا_حجج_خطأ
        };
        طابق اختم_بفرع_شرطي_مسير(
            البرنامج,
            حالة_الفرع.الدالة,
            حالة_الفرع.الكتلة,
            قيمة_اليسار.المعرف,
            حافة_الصواب,
            حافة_الخطأ
        ) مع
        | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
            أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(
                خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)
            );
        }
        | نتيجة_بناء_منهي_مسير.مبني -> { };
    }
    | _ -> {
        أرجع نتيجة_بدء_منطق_قصير_خفض.مرفوضة(
            خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق)
        );
    };

    دع حالة_اليمين: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير حالة_الفرع);
    حالة_اليمين.الكتلة := كتلة_اليمين;
    حالة_اليمين.نشطة := صواب;
    دع السياق: سياق_منطق_قصير_خفض = {
        حالة_اليمين: حالة_اليمين,
        كتلة_الدمج: كتلة_الدمج,
        معامل_الدمج: معامل_الدمج
    };
    أرجع نتيجة_بدء_منطق_قصير_خفض.مبنية(السياق);
}

عام عرف اختم_منطق_قصير_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    حالة_اليمين: &حالة_خفض_دالة,
    كتلة_الدمج: معرف_كتلة_مسير,
    معامل_الدمج: معرف_قيمة_مسير,
    قيمة_اليمين: قيمة_خفض_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    دع حالة_الفرع: متغير حالة_خفض_دالة = *حالة_اليمين;
    دع حجة_اليمين: متجه معرف_قيمة_مسير = [قيمة_اليمين.المعرف];
    طابق اختم_بفرع_للخفض(
        البرنامج,
        &متغير حالة_الفرع,
        كتلة_الدمج,
        &حجة_اليمين
    ) مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    }
    | اختيار.لا_شيء -> { };

    // The short-circuit edge can reach the merge without evaluating the RHS.
    // RHS lowering may lazily materialize local places, so carrying its local-state cache
    // across the merge would expose values that do not dominate the shortcut path.
    // Source expressions do not assign locals; preserve the pre-branch canonical local state
    // and merge only the expression result through the block argument.
    دع التالية: متغير حالة_خفض_دالة = *الحالة;
    التالية.الكتلة := كتلة_الدمج;
    التالية.نشطة := صواب;
    *الحالة := التالية;
    دع الناتج: قيمة_خفض_مسير = { المعرف: معامل_الدمج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(الناتج);
}

عام عرف اخفض_نفي_منطقي_مقنن(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الداخل: قيمة_خفض_مسير,
    قيمة_صواب: معرف_قيمة_مسير,
    قيمة_خطأ: معرف_قيمة_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    دع بعد_الثوابت: حالة_خفض_دالة = *الحالة;
    دع كتلة_الدمج: متغير معرف_كتلة_مسير = بعد_الثوابت.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, بعد_الثوابت.الدالة) مع
    | نتيجة.نجح(الكتلة) -> {
        كتلة_الدمج := الكتلة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ);
    };
    دع معامل_الدمج: متغير معرف_قيمة_مسير = الداخل.المعرف;
    طابق أضف_معامل_كتلة_مسير(
        البرنامج,
        بعد_الثوابت.الدالة,
        كتلة_الدمج,
        النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> {
        معامل_الدمج := المعرف;
    }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع حجج_الصواب: متجه معرف_قيمة_مسير = [قيمة_خطأ];
    دع حجج_الخطأ: متجه معرف_قيمة_مسير = [قيمة_صواب];
    دع عند_الصواب: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجج_الصواب };
    دع عند_الخطأ: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجج_الخطأ };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج,
        بعد_الثوابت.الدالة,
        بعد_الثوابت.الكتلة,
        الداخل.المعرف,
        عند_الصواب,
        عند_الخطأ
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    دع التالية: متغير حالة_خفض_دالة = بعد_الثوابت;
    التالية.الكتلة := كتلة_الدمج;
    التالية.نشطة := صواب;
    *الحالة := التالية;
    دع الناتج: قيمة_خفض_مسير = { المعرف: معامل_الدمج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(الناتج);
}

// Boolean equality is represented with target-neutral control flow and one merge block
// argument. Block arguments remain the only SSA merge mechanism.
عام عرف اخفض_مساواة_منطقية_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    العامل: عامل_ثنائي,
    اليسار: قيمة_خفض_مسير,
    اليمين: قيمة_خفض_مسير,
    النوع: معرف_نوع
): نتيجة_خفض_تعبير {
    دع الأصل: متغير حالة_خفض_دالة = *الحالة;
    دع قيمة_صواب: متغير معرف_قيمة_مسير = اليسار.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج, الأصل.الدالة, الأصل.الكتلة, ثابت_مسير.منطق(صواب), النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_صواب := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع قيمة_خطأ: متغير معرف_قيمة_مسير = اليمين.المعرف;
    طابق أصدر_ثابتا_مسير(
        البرنامج, الأصل.الدالة, الأصل.الكتلة, ثابت_مسير.منطق(خطأ), النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { قيمة_خطأ := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    دع كتلة_اليسار_صواب: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    دع كتلة_اليسار_خطأ: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    دع كتلة_الدمج: متغير معرف_كتلة_مسير = الأصل.الكتلة;
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_اليسار_صواب := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_اليسار_خطأ := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };
    طابق أضف_كتلة_للخفض(البرنامج, الأصل.الدالة) مع
    | نتيجة.نجح(الكتلة) -> { كتلة_الدمج := الكتلة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_تعبير.مرفوض(الخطأ); };

    دع معامل_الدمج: متغير معرف_قيمة_مسير = اليسار.المعرف;
    طابق أضف_معامل_كتلة_مسير(
        البرنامج, الأصل.الدالة, كتلة_الدمج, النوع
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { معامل_الدمج := المعرف; }
    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };

    دع بلا_حجج_يسار_صواب: متجه معرف_قيمة_مسير = [];
    دع بلا_حجج_يسار_خطأ: متجه معرف_قيمة_مسير = [];
    دع حافة_يسار_صواب: حافة_مسير = { الهدف: كتلة_اليسار_صواب, الحجج: بلا_حجج_يسار_صواب };
    دع حافة_يسار_خطأ: حافة_مسير = { الهدف: كتلة_اليسار_خطأ, الحجج: بلا_حجج_يسار_خطأ };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج,
        الأصل.الدالة,
        الأصل.الكتلة,
        اليسار.المعرف,
        حافة_يسار_صواب,
        حافة_يسار_خطأ
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_منهي_مسير.مبني -> { };

    دع ناتج_يمين_صواب_من_يسار_صواب: متغير معرف_قيمة_مسير = قيمة_صواب;
    دع ناتج_يمين_خطأ_من_يسار_صواب: متغير معرف_قيمة_مسير = قيمة_خطأ;
    دع ناتج_يمين_صواب_من_يسار_خطأ: متغير معرف_قيمة_مسير = قيمة_خطأ;
    دع ناتج_يمين_خطأ_من_يسار_خطأ: متغير معرف_قيمة_مسير = قيمة_صواب;
    طابق العامل مع
    | عامل_ثنائي.يساوي -> { }
    | عامل_ثنائي.لا_يساوي -> {
        ناتج_يمين_صواب_من_يسار_صواب := قيمة_خطأ;
        ناتج_يمين_خطأ_من_يسار_صواب := قيمة_صواب;
        ناتج_يمين_صواب_من_يسار_خطأ := قيمة_صواب;
        ناتج_يمين_خطأ_من_يسار_خطأ := قيمة_خطأ;
    }
    | _ -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    };
    دع حجة_يمين_صواب_من_يسار_صواب: متجه معرف_قيمة_مسير = [ناتج_يمين_صواب_من_يسار_صواب];
    دع حجة_يمين_خطأ_من_يسار_صواب: متجه معرف_قيمة_مسير = [ناتج_يمين_خطأ_من_يسار_صواب];
    دع حجة_يمين_صواب_من_يسار_خطأ: متجه معرف_قيمة_مسير = [ناتج_يمين_صواب_من_يسار_خطأ];
    دع حجة_يمين_خطأ_من_يسار_خطأ: متجه معرف_قيمة_مسير = [ناتج_يمين_خطأ_من_يسار_خطأ];
    دع يمين_صواب_من_يسار_صواب: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجة_يمين_صواب_من_يسار_صواب };
    دع يمين_خطأ_من_يسار_صواب: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجة_يمين_خطأ_من_يسار_صواب };
    دع يمين_صواب_من_يسار_خطأ: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجة_يمين_صواب_من_يسار_خطأ };
    دع يمين_خطأ_من_يسار_خطأ: حافة_مسير = { الهدف: كتلة_الدمج, الحجج: حجة_يمين_خطأ_من_يسار_خطأ };

    طابق اختم_بفرع_شرطي_مسير(
        البرنامج,
        الأصل.الدالة,
        كتلة_اليسار_صواب,
        اليمين.المعرف,
        يمين_صواب_من_يسار_صواب,
        يمين_خطأ_من_يسار_صواب
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_منهي_مسير.مبني -> { };
    طابق اختم_بفرع_شرطي_مسير(
        البرنامج,
        الأصل.الدالة,
        كتلة_اليسار_خطأ,
        اليمين.المعرف,
        يمين_صواب_من_يسار_خطأ,
        يمين_خطأ_من_يسار_خطأ
    ) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_تعبير.مرفوض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
    }
    | نتيجة_بناء_منهي_مسير.مبني -> { };

    دع التالية: متغير حالة_خفض_دالة = انسخ_حالة_خفض(&متغير الأصل);
    التالية.الكتلة := كتلة_الدمج;
    التالية.نشطة := صواب;
    *الحالة := التالية;
    دع الناتج: قيمة_خفض_مسير = { المعرف: معامل_الدمج, النوع: النوع };
    أرجع نتيجة_خفض_تعبير.قيمة(الناتج);
}

