استورد compiler.frontend.types.type_context;
// A destination rooted at an extern module value (through fields and
// indices, not through a dereference).
عرف وجهة_عام_خارجي_للخفض(
    البرنامج: &برنامج_مسير,
    الوجهة: &تعبير,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): منطقي {
    طابق *الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_محلول_عند(روابط_الأسماء, الاسم.النطاق) مع
        | اختياري.موجود(الرمز) -> {
            طابق قيمة_عليا_خفض_عند(دوال_الخفض, الرمز) مع
            | اختياري.موجود(الربط) -> {
                طابق الربط.الهدف مع
                | هدف_قيمة_عليا_خفض.عام(العام) -> {
                    لو (العام.القيمة < (الطول((*البرنامج).العوام) مثل طبيعي)) {
                        طابق (*البرنامج).العوام[العام.القيمة].الاسم_الخارجي مع
                        | اختياري.موجود(_) -> { أرجع صواب; }
                        | اختياري.لا_شيء -> { };
                    };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        أرجع خطأ;
    }
    | تعبير.حقل(_, الأصل, _) -> { أرجع وجهة_عام_خارجي_للخفض(البرنامج, &(*الأصل), روابط_الأسماء, دوال_الخفض); }
    | تعبير.فهرس(_, الأصل, _) -> { أرجع وجهة_عام_خارجي_للخفض(البرنامج, &(*الأصل), روابط_الأسماء, دوال_الخفض); }
    | _ -> { أرجع خطأ; };
}

// بناء الوجهات والنسخ والتجميع والسجلات والصناديق من حقائق Frontend المقننة.
// Stores a lowered value through the destination's MSIR place: fields,
// indices, dereferences and writable module values (global places).
عرف اخفض_قيمة_إلى_مكان_وجهة(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    المصدر: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    طابق خفض_مكان_إلى_مسير(
        البرنامج, الحالة, الوجهة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_مكان.مكان(المكان) -> {
        دع المصدر_المقنن: متغير قيمة_خفض_مسير = المصدر;
        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
            البرنامج, الحالة, النطاق, المصدر, المكان.النوع, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> { المصدر_المقنن := القيمة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        // The place's old value is destroyed before it is overwritten. A
        // program-defined global always holds a value it owns (its initial
        // value is scalar, an empty vector header, or a heap vector built by
        // the module initializer), so its drop needs no flag. Linker-owned
        // (extern) storage was never owned by the program: it is not destroyed.
        لو (!وجهة_عام_خارجي_للخفض(&(*البرنامج), الوجهة, روابط_الأسماء, دوال_الخفض)) {
            طابق أسقط_قيمة_مكان_خفض(البرنامج, الحالة, المكان.المعرف, المكان.النوع, الأنواع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق أصدر_تخزين_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            المكان.المعرف,
            المصدر_المقنن.المعرف
        ) مع
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}

عام عرف اخفض_قيمة_إلى_وجهة(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    المصدر: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع قيمة_الوجهة: تعبير = *الوجهة;
    طابق قيمة_الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق موضع_محلي_خفض(الحالة, الرمز) مع
            | اختياري.لا_شيء -> {
                // Not a local: a writable module value, stored through its
                // global place (the place lowering rejects anything else).
                أرجع اخفض_قيمة_إلى_مكان_وجهة(
                    البرنامج, الحالة, النطاق, الوجهة, المصدر, الأنواع, أنواع_التعبيرات,
                    روابط_الأسماء, دوال_الخفض, هويات_البدائيات
                );
            }
            | اختياري.موجود(الموضع) -> {
                دع المحلي: ربط_محلي_خفض = (*الحالة).المحليات[الموضع];
                دع المصدر_المقنن: متغير قيمة_خفض_مسير = المصدر;
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, المصدر, المحلي.النوع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { المصدر_المقنن := القيمة; }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
                // An owner destroys its old value first. The drop is gated by the
                // local's run-time drop flag, so it is emitted even where lowering
                // no longer tracks the value (loop bodies, after merges, locals
                // declared without an initializer): an unset flag skips it.
                طابق أسقط_قبل_إسناد_محلي_خفض(البرنامج, الحالة, الرمز) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                طابق المحلي.المكان مع
                | اختياري.موجود(المكان) -> {
                    طابق أصدر_تخزين_مسير(
                        البرنامج,
                        &(*الحالة).البناء,
                        (*الحالة).الدالة,
                        (*الحالة).الكتلة,
                        المكان,
                        المصدر_المقنن.المعرف
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
                طابق أكمل_إسناد_محلي_خفض(البرنامج, الحالة, الرمز) مع
                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | اختياري.لا_شيء -> { };
                تأكد_محليات_خفض_فريدة(الحالة);
                (*الحالة).المحليات[الموضع].القيمة := اختياري.موجود(المصدر_المقنن.المعرف);
                دع دالة_التصحيح: معرف_دالة_مسير = (*الحالة).الدالة;
                اربط_رمز_بقيمة_تصحيح_مسير(
                    التصحيح, دالة_التصحيح, الرمز, المصدر_المقنن.المعرف,
                    (*الحالة).البناء.موقع_التصحيح_الحالي
                );
                أرجع اختياري.لا_شيء();
            };
        };
    }
    | _ -> {
        أرجع اخفض_قيمة_إلى_مكان_وجهة(
            البرنامج, الحالة, النطاق, الوجهة, المصدر, الأنواع, أنواع_التعبيرات,
            روابط_الأسماء, دوال_الخفض, هويات_البدائيات
        );
    };
}

عام عرف اخفض_نسخ_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    المصدر: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    طابق خفض_تعبير_مملوكا_إلى_مسير(
        البرنامج, الحالة, المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        // A void initializer (`let r: R = f()` in a generic instance whose R
        // is void) only binds a local of the void Type: it was evaluated for
        // its effects and the local holds no value (reading it reads none).
        طابق *الوجهة مع
        | تعبير.اسم(_, _) -> { أرجع اختياري.لا_شيء(); }
        | _ -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        // `let s: [] T = f()`: the declaration owns the viewed call result.
        طابق *الوجهة مع
        | تعبير.اسم(نطاق_الوجهة, _) -> {
            لو (نطاقان_متساويان(نطاق_الوجهة, النطاق)) {
                طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
                | نتيجة_حل_نوع_للخفض.موجود(نوع_الوجهة) -> {
                    طابق امتلك_متجها_معروضا_خفض(
                        البرنامج, الحالة, المصدر, القيمة, نوع_الوجهة, الأنواع
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                }
                | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); };
            };
        }
        | _ -> { };
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح, الحالة, النطاق, الوجهة, القيمة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_نص_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    البايتات: &متجه ط8,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };
    لو (!هل_نوع_نص_للخفض(الأنواع, نوع_الوجهة)) {
        أرجع اختياري.موجود(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    };
    دع نسخة_البايتات: متجه ط8 = انسخ_بايتات(البايتات);
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_ثابتا_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            ثابت_مسير.نص(نسخة_البايتات),
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(النص) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح, الحالة, النطاق, الوجهة, النص,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_تجميع_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    نوع_العنصر: اختياري معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة);
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_الوجهة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(عناصر_القيم) مثل طبيعي)) {
        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج, الحالة, مرجع_العنصر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            دع القيمة_المقننة: متغير قيمة_خفض_مسير = القيمة;
            طابق نوع_العنصر مع
            | اختياري.موجود(المتوقع) -> {
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, القيمة, المتوقع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(المقننة) -> { القيمة_المقننة := المقننة; }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
            }
            | اختياري.لا_شيء -> { };
            ألحق(القيم, القيمة_المقننة.المعرف);
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(المجمع) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح, الحالة, النطاق, الوجهة, المجمع,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}


عام عرف اخفض_تهيئة_متجه_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.لا_شيء -> {
        // A slice literal builds the viewed sequence with the slice's own
        // (vector-shaped) layout; the slice does not own it.
        طابق نوع_عنصر_شريحة_دلالي(الأنواع, نوع_الوجهة) مع
        | اختياري.موجود(النوع) -> { نوع_العنصر := النوع; }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
            );
        };
    }
    | اختياري.موجود(النوع) -> {
        نوع_العنصر := النوع;
    };
    // `let s: [] T = [...]` builds a vector with an anonymous owner in the
    // enclosing block (as Rust extends a temporary's lifetime) and the slice
    // views it. The initializer's destination spans the whole declaration.
    دع نوع_البناء: متغير معرف_نوع = نوع_الوجهة;
    دع بناء_مملوك: متغير منطقي = خطأ;
    طابق نوع_عنصر_شريحة_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.موجود(_) -> {
        طابق *الوجهة مع
        | تعبير.اسم(نطاق_الوجهة, _) -> {
            لو (نطاقان_متساويان(نطاق_الوجهة, النطاق)) {
                طابق معرف_نوع_متجه_مقنن_موجود(الأنواع, نوع_العنصر) مع
                | اختياري.موجود(نوع_المتجه) -> { نوع_البناء := نوع_المتجه; بناء_مملوك := صواب; }
                | اختياري.لا_شيء -> { };
            };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(عناصر_القيم) مثل طبيعي)) {
        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_العنصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج,
                الحالة,
                نطاق_تعبير(مرجع_العنصر),
                القيمة,
                نوع_العنصر,
                الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(القيم, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(
                    خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر))
                );
            };
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تهيئة_متجه_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_البناء
        ),
        نوع_البناء
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(المتجه) -> {
        لو (بناء_مملوك) {
            طابق سجل_مالكا_مؤقتا_خفض(البرنامج, الحالة, المتجه.المعرف, المتجه.النوع, الأنواع) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج,
            التصحيح,
            الحالة,
            النطاق,
            الوجهة,
            المتجه,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_صف_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عدد_العناصر: متغير طبيعي = 0;
    طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    }
    | اختياري.موجود(العدد) -> {
        عدد_العناصر := العدد;
    };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    لو ((الطول(عناصر_القيم) مثل طبيعي) != عدد_العناصر) {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };

    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_العناصر) {
        دع النوع_المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الوجهة, ف) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
            );
        }
        | اختياري.موجود(النوع) -> {
            النوع_المتوقع := النوع;
        };

        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_مملوكا_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_العنصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج,
                الحالة,
                نطاق_تعبير(مرجع_العنصر),
                القيمة,
                النوع_المتوقع,
                الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(القيم, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختياري.موجود(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر)));
            };
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(الصف) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج,
            التصحيح,
            الحالة,
            النطاق,
            الوجهة,
            الصف,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_سجل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    الحقول: &متجه حقل_تهيئة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عدد_الحقول: متغير طبيعي = 0;
    طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    }
    | اختياري.موجود(العدد) -> {
        عدد_الحقول := العدد;
    };

    دع قيم_الحقول: متجه حقل_تهيئة = *الحقول;
    لو ((الطول(قيم_الحقول) مثل طبيعي) != عدد_الحقول) {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };

    دع القيم_المرتبة: متغير متجه معرف_قيمة_مسير = [];
    دع الترتيب: متغير طبيعي = 0;
    طالما (الترتيب < عدد_الحقول) {
        دع وجد: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(قيم_الحقول) مثل طبيعي)) {
            دع مرجع_الحقل: &حقل_تهيئة = &قيم_الحقول[ف];
            دع الحقل: حقل_تهيئة = *مرجع_الحقل;
            دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
            طابق معرف_اسم_محلول_عند(روابط_الأسماء, الحقل.الاسم.النطاق) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_خفض_مسير.ربط_اسم_مفقود(الحقل.الاسم.النطاق)
                );
            }
            | اختياري.موجود(المعرف) -> {
                هوية_الحقل := المعرف;
            };
            طابق وصف_حقل_سجل_دلالي_بالاسم(
                الأنواع, نوع_الوجهة, هوية_الحقل
            ) مع
            | اختياري.لا_شيء -> {
                أرجع اختياري.موجود(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
                );
            }
            | اختياري.موجود(الوصف) -> {
                لو (الوصف.الترتيب == الترتيب) {
                    لو (وجد) {
                        أرجع اختياري.موجود(
                            خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)
                        );
                    };
                    طابق خفض_تعبير_مملوكا_إلى_مسير(
                        البرنامج,
                        الحالة,
                        &الحقل.القيمة,
                        الأنواع,
                        أنواع_التعبيرات,
                        روابط_الأسماء,
                        دوال_الخفض,
                        هويات_البدائيات
                    ) مع
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع اختياري.موجود(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع اختياري.موجود(
                            خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)
                        );
                    }
                    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                            البرنامج,
                            الحالة,
                            نطاق_تعبير(&الحقل.القيمة),
                            القيمة,
                            الوصف.النوع,
                            الأنواع
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                            ألحق(القيم_المرتبة, القيمة_المقننة.المعرف);
                            وجد := صواب;
                        }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                            أرجع اختياري.موجود(الخطأ);
                        }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> {
                            أرجع اختياري.موجود(
                                خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(&الحقل.القيمة))
                            );
                        };
                    };
                };
            };
            ف := ف + 1;
        }
        لو (!وجد) {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        الترتيب := الترتيب + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            &حالة_الإصدار.البناء,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم_المرتبة,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(السجل) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, التصحيح, الحالة, النطاق, الوجهة, السجل,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_صندوق_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    الحمولة: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختياري خطأ_خفض_مسير {
    دع نوع_الوجهة_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة);
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_الوجهة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع نوع_الحمولة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_حمولة_صندوق_دلالي(الأنواع, نوع_الوجهة) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة));
    }
    | اختياري.موجود(النوع) -> {
        نوع_الحمولة := النوع;
    };

    طابق خفض_تعبير_مملوكا_إلى_مسير(
        البرنامج, الحالة, الحمولة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختياري.موجود(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        دع القيمة_المقننة: متغير قيمة_خفض_مسير = القيمة;
        // A `box mut T` payload is a `T`; only the box records mutability.
        دع نوع_الحمولة_المقنن: متغير معرف_نوع = نوع_الحمولة;
        طابق معرف_نوع_أساس_عند(الأنواع, نوع_الحمولة) مع
        | اختياري.موجود(الأساس) -> { نوع_الحمولة_المقنن := الأساس; }
        | اختياري.لا_شيء -> { };
        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
            البرنامج, الحالة, النطاق, القيمة, نوع_الحمولة_المقنن, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(المقننة) -> { القيمة_المقننة := المقننة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق قيمة_من_بناء_للخفض(
            أصدر_بناء_صندوق_مسير(
                البرنامج,
                &حالة_الإصدار.البناء,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                القيمة_المقننة.المعرف,
                نوع_الوجهة
            ),
            نوع_الوجهة
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختياري.موجود(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختياري.موجود(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(الصندوق) -> {
            أرجع اخفض_قيمة_إلى_وجهة(
                البرنامج, التصحيح, الحالة, النطاق, الوجهة, الصندوق,
                الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        };
    };
}

