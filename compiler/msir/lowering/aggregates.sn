// بناء الوجهات والنسخ والتجميع والسجلات والصناديق من حقائق Frontend المقننة.
عام عرف اخفض_قيمة_إلى_وجهة(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    المصدر: قيمة_خفض_مسير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع قيمة_الوجهة: تعبير = *الوجهة;
    طابق قيمة_الوجهة مع
    | تعبير.اسم(_, الاسم) -> {
        طابق رمز_اسم_للخفض(روابط_الأسماء, &الاسم) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة.نجح(الرمز) -> {
            طابق موضع_محلي_خفض(الحالة, الرمز) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(خطأ_خفض_مسير.رمز_محلي_مفقود(الرمز));
            }
            | اختيار.بعض(الموضع) -> {
                دع النسخة: حالة_خفض_دالة = *الحالة;
                دع المحلي: ربط_محلي_خفض = النسخة.المحليات[الموضع];
                دع المصدر_المقنن: متغير قيمة_خفض_مسير = المصدر;
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, المصدر, المحلي.النوع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(القيمة) -> { المصدر_المقنن := القيمة; }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
                طابق المحلي.المكان مع
                | اختيار.بعض(المكان) -> {
                    طابق أصدر_تخزين_مسير(
                        البرنامج, النسخة.الدالة, النسخة.الكتلة, المكان, المصدر_المقنن.المعرف
                    ) مع
                    | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                        أرجع اختيار.بعض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
                    }
                    | _ -> { };
                }
                | اختيار.لا_شيء -> { };
                دع الحالة_المحدثة: متغير حالة_خفض_دالة = *الحالة;
                تأكد_محليات_خفض_فريدة(&متغير الحالة_المحدثة);
                الحالة_المحدثة.المحليات[الموضع].القيمة := اختيار.بعض(المصدر_المقنن.المعرف);
                *الحالة := الحالة_المحدثة;
                أرجع اختيار.لا_شيء();
            };
        };
    }
    | _ -> {
        طابق خفض_مكان_إلى_مسير(
            البرنامج, الحالة, الوجهة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_مكان.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_خفض_مكان.مكان(المكان) -> {
            دع المصدر_المقنن: متغير قيمة_خفض_مسير = المصدر;
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج, الحالة, النطاق, المصدر, المكان.النوع, الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة) -> { المصدر_المقنن := القيمة; }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
            | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
            دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
            طابق أصدر_تخزين_مسير(
                البرنامج,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                المكان.المعرف,
                المصدر_المقنن.المعرف
            ) مع
            | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> {
                أرجع اختيار.بعض(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ));
            }
            | _ -> {
                أرجع اختيار.لا_شيء();
            };
        };
    };
}

عام عرف اخفض_نسخ_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    المصدر: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    طابق خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, المصدر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, الحالة, النطاق, الوجهة, القيمة,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_نص_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    البايتات: &متجه غ8,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };
    لو (!هل_نوع_نص_للخفض(الأنواع, نوع_الوجهة)) {
        أرجع اختيار.بعض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    };
    دع نسخة_البايتات: متجه غ8 = *البايتات;
    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_ثابتا_مسير(
            البرنامج,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            ثابت_مسير.نص(نسخة_البايتات),
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(النص) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, الحالة, النطاق, الوجهة, النص,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_تجميع_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    نوع_العنصر: اختيار معرف_نوع,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة);
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_الوجهة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(عناصر_القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_إلى_مسير(
            البرنامج, الحالة, مرجع_العنصر, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            دع القيمة_المقننة: متغير قيمة_خفض_مسير = القيمة;
            طابق نوع_العنصر مع
            | اختيار.بعض(المتوقع) -> {
                طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                    البرنامج, الحالة, النطاق, القيمة, المتوقع, الأنواع
                ) مع
                | نتيجة_خفض_تعبير.قيمة(المقننة) -> { القيمة_المقننة := المقننة; }
                | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
            }
            | اختيار.لا_شيء -> { };
            ألحق(القيم, القيمة_المقننة.المعرف);
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(المجمع) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, الحالة, النطاق, الوجهة, المجمع,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}


عام عرف اخفض_تهيئة_متجه_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع نوع_العنصر: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    }
    | اختيار.بعض(النوع) -> {
        نوع_العنصر := النوع;
    };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(عناصر_القيم) مثل غير_موقع)) {
        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_العنصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج,
                الحالة,
                نطاق_تعبير(مرجع_العنصر),
                القيمة,
                نوع_العنصر,
                الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(القيم, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختيار.بعض(
                    خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر))
                );
            };
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تهيئة_متجه_مسير(
            البرنامج,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(المتجه) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج,
            الحالة,
            النطاق,
            الوجهة,
            المتجه,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_صف_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    العناصر: &متجه تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عدد_العناصر: متغير غير_موقع = 0;
    طابق عدد_عناصر_صف_دلالي(الأنواع, نوع_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    }
    | اختيار.بعض(العدد) -> {
        عدد_العناصر := العدد;
    };

    دع عناصر_القيم: متجه تعبير = *العناصر;
    لو ((الطول(عناصر_القيم) مثل غير_موقع) != عدد_العناصر) {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };

    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_العناصر) {
        دع النوع_المتوقع: متغير معرف_نوع = معرف_نوع_من(0);
        طابق نوع_عنصر_صف_دلالي_عند(الأنواع, نوع_الوجهة, ف) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(
                خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
            );
        }
        | اختيار.بعض(النوع) -> {
            النوع_المتوقع := النوع;
        };

        دع مرجع_العنصر: &تعبير = &عناصر_القيم[ف];
        طابق خفض_تعبير_إلى_مسير(
            البرنامج,
            الحالة,
            مرجع_العنصر,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
            طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                البرنامج,
                الحالة,
                نطاق_تعبير(مرجع_العنصر),
                القيمة,
                النوع_المتوقع,
                الأنواع
            ) مع
            | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                ألحق(القيم, القيمة_المقننة.المعرف);
            }
            | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                أرجع اختيار.بعض(الخطأ);
            }
            | نتيجة_خفض_تعبير.بلا_قيمة -> {
                أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(مرجع_العنصر)));
            };
        };
        ف := ف + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(الصف) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج,
            الحالة,
            النطاق,
            الوجهة,
            الصف,
            الأنواع,
            أنواع_التعبيرات,
            روابط_الأسماء,
            دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_سجل_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    الحقول: &متجه حقل_تهيئة,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة) مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع عدد_الحقول: متغير غير_موقع = 0;
    طابق عدد_حقول_سجل_دلالي(الأنواع, نوع_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(
            خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
        );
    }
    | اختيار.بعض(العدد) -> {
        عدد_الحقول := العدد;
    };

    دع قيم_الحقول: متجه حقل_تهيئة = *الحقول;
    لو ((الطول(قيم_الحقول) مثل غير_موقع) != عدد_الحقول) {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    };

    دع القيم_المرتبة: متغير متجه معرف_قيمة_مسير = [];
    دع الترتيب: متغير غير_موقع = 0;
    بينما (الترتيب < عدد_الحقول) {
        دع وجد: متغير منطقي = خطأ;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(قيم_الحقول) مثل غير_موقع)) {
            دع مرجع_الحقل: &حقل_تهيئة = &قيم_الحقول[ف];
            دع الحقل: حقل_تهيئة = *مرجع_الحقل;
            دع هوية_الحقل: متغير معرف_اسم = معرف_اسم_من(0);
            طابق معرف_اسم_محلول_عند(روابط_الأسماء, الحقل.الاسم.النطاق) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_خفض_مسير.ربط_اسم_مفقود(الحقل.الاسم.النطاق)
                );
            }
            | اختيار.بعض(المعرف) -> {
                هوية_الحقل := المعرف;
            };
            طابق وصف_حقل_سجل_دلالي_بالاسم(
                الأنواع, نوع_الوجهة, هوية_الحقل
            ) مع
            | اختيار.لا_شيء -> {
                أرجع اختيار.بعض(
                    خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة)
                );
            }
            | اختيار.بعض(الوصف) -> {
                لو (الوصف.الترتيب == الترتيب) {
                    لو (وجد) {
                        أرجع اختيار.بعض(
                            خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)
                        );
                    };
                    طابق خفض_تعبير_إلى_مسير(
                        البرنامج,
                        الحالة,
                        &الحقل.القيمة,
                        الأنواع,
                        أنواع_التعبيرات,
                        روابط_الأسماء,
                        دوال_الخفض,
                        هويات_البدائيات
                    ) مع
                    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                        أرجع اختيار.بعض(الخطأ);
                    }
                    | نتيجة_خفض_تعبير.بلا_قيمة -> {
                        أرجع اختيار.بعض(
                            خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)
                        );
                    }
                    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
                        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
                            البرنامج,
                            الحالة,
                            نطاق_تعبير(&الحقل.القيمة),
                            القيمة,
                            الوصف.النوع,
                            الأنواع
                        ) مع
                        | نتيجة_خفض_تعبير.قيمة(القيمة_المقننة) -> {
                            ألحق(القيم_المرتبة, القيمة_المقننة.المعرف);
                            وجد := صواب;
                        }
                        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
                            أرجع اختيار.بعض(الخطأ);
                        }
                        | نتيجة_خفض_تعبير.بلا_قيمة -> {
                            أرجع اختيار.بعض(
                                خطأ_خفض_مسير.عبارة_غير_مدعومة(نطاق_تعبير(&الحقل.القيمة))
                            );
                        };
                    };
                };
            };
            ف := ف + 1;
        }
        لو (!وجد) {
            أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        };
        الترتيب := الترتيب + 1;
    }

    دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
    طابق قيمة_من_بناء_للخفض(
        أصدر_تجميع_مسير(
            البرنامج,
            حالة_الإصدار.الدالة,
            حالة_الإصدار.الكتلة,
            &القيم_المرتبة,
            نوع_الوجهة
        ),
        نوع_الوجهة
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(السجل) -> {
        أرجع اخفض_قيمة_إلى_وجهة(
            البرنامج, الحالة, النطاق, الوجهة, السجل,
            الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
            هويات_البدائيات
        );
    };
}

عام عرف اخفض_تهيئة_صندوق_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    الحالة: &متغير حالة_خفض_دالة,
    النطاق: نطاق,
    الوجهة: &تعبير,
    الحمولة: &تعبير,
    الأنواع: &سجل_أنواع,
    أنواع_التعبيرات: &سياق_أنواع_تعبيرات,
    روابط_الأسماء: &سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم
): اختيار خطأ_خفض_مسير {
    دع نوع_الوجهة_نتيجة: نتيجة_حل_نوع_للخفض = نوع_تعبير_للخفض(الأنواع, أنواع_التعبيرات, الوجهة);
    دع نوع_الوجهة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_الوجهة_نتيجة مع
    | نتيجة_حل_نوع_للخفض.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_حل_نوع_للخفض.موجود(النوع) -> {
        نوع_الوجهة := النوع;
    };

    دع نوع_الحمولة: متغير معرف_نوع = معرف_نوع_من(0);
    طابق نوع_حمولة_صندوق_دلالي(الأنواع, نوع_الوجهة) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.نوع_تعبير_غير_مدعوم(النطاق, نوع_الوجهة));
    }
    | اختيار.بعض(النوع) -> {
        نوع_الحمولة := النوع;
    };

    طابق خفض_تعبير_إلى_مسير(
        البرنامج, الحالة, الحمولة, الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
        هويات_البدائيات
    ) مع
    | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
        أرجع اختيار.بعض(الخطأ);
    }
    | نتيجة_خفض_تعبير.بلا_قيمة -> {
        أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
    }
    | نتيجة_خفض_تعبير.قيمة(القيمة) -> {
        دع القيمة_المقننة: متغير قيمة_خفض_مسير = القيمة;
        طابق اخفض_قيمة_ضمنيا_إلى_نوع_مسير(
            البرنامج, الحالة, النطاق, القيمة, نوع_الحمولة, الأنواع
        ) مع
        | نتيجة_خفض_تعبير.قيمة(المقننة) -> { القيمة_المقننة := المقننة; }
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | نتيجة_خفض_تعبير.بلا_قيمة -> { أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق)); };
        دع حالة_الإصدار: حالة_خفض_دالة = *الحالة;
        طابق قيمة_من_بناء_للخفض(
            أصدر_بناء_صندوق_مسير(
                البرنامج,
                حالة_الإصدار.الدالة,
                حالة_الإصدار.الكتلة,
                القيمة_المقننة.المعرف,
                نوع_الوجهة
            ),
            نوع_الوجهة
        ) مع
        | نتيجة_خفض_تعبير.مرفوض(الخطأ) -> {
            أرجع اختيار.بعض(الخطأ);
        }
        | نتيجة_خفض_تعبير.بلا_قيمة -> {
            أرجع اختيار.بعض(خطأ_خفض_مسير.عبارة_غير_مدعومة(النطاق));
        }
        | نتيجة_خفض_تعبير.قيمة(الصندوق) -> {
            أرجع اخفض_قيمة_إلى_وجهة(
                البرنامج, الحالة, النطاق, الوجهة, الصندوق,
                الأنواع, أنواع_التعبيرات, روابط_الأسماء, دوال_الخفض,
                هويات_البدائيات
            );
        };
    };
}

