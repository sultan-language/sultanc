استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_renumbering;
استورد compiler.msir.msir_promotion;
استورد compiler.msir.debug_contract;
استورد compiler.debuginfo.model;
استورد compiler.debuginfo.inlining;
استورد compiler.runtime.primitive_identity;

// Inlining of small functions (every consumer receives the result: native
// and LLVM code generation and the interpreters). A direct
// call to a function of at most حد_تعليمات_التضمين instructions is replaced
// by a copy of its blocks: the caller's block is split at the call, the
// copy's entry follows the first half, each return jumps to the second half,
// whose block parameter is the call's result. The callee may make calls of
// its own (a wrapper, a counter update that calls a helper); a few rounds,
// so a function whose calls were inlined is inlined in turn, each round
// copying the callees as they were when it started. Native code then saves
// the call, the argument and result moves, the prologue and the
// callee-saved registers, and the selector and the control-flow
// simplification (msir_flow.sn) see the caller's values (constants,
// compares) in the callee: a test of a parameter the caller passes a
// constant for folds.
//
// The pass runs on promoted MSIR in the optimization pipeline
// (msir_optimization_pipeline.sn), before the canonical verification, so the
// verifier checks its result. Each inlined call opens an inlined-call debug
// scope (compiler/debuginfo/inlining.sn) holding copies of the callee's
// scopes and variables: a copied instruction keeps the callee's debug
// location, and with it its source origin (أصل_تعليمة_مسير), in the copy of
// its callee scope; only an instruction without a location takes the
// call's. Each callee variable is bound to the caller value its value
// became, arguments included.

عرف حد_تعليمات_التضمين(): طبيعي { أرجع 16; }
// A callee that compares or branches on a parameter its caller passes a
// constant for: most of it folds away in the caller (msir_flow.sn).
عرف حد_تعليمات_التضمين_بثابت(): طبيعي { أرجع 40; }
عرف حد_كتل_التضمين(): طبيعي { أرجع 12; }
عرف عدد_جولات_التضمين(): طبيعي { أرجع 3; }
// Bound on the call sites inlined into one function per round.
عرف حد_تضمينات_الدالة(): طبيعي { أرجع 200; }

عرف دالة_حقيقة_برنامج(البرنامج: &برنامج_مسير, الدالة: معرف_دالة_مسير): منطقي {
    دع الحقائق: متغير متجه اختياري معرف_دالة_مسير = [];
    ألحق(الحقائق, (*البرنامج).دالة_بدء_البرنامج);
    ألحق(الحقائق, (*البرنامج).دالة_خروج_العملية);
    ألحق(الحقائق, (*البرنامج).دالة_تبديل_سياق_المهام);
    ألحق(الحقائق, (*البرنامج).دالة_تهيئة_الوحدة);
    ألحق(الحقائق, (*البرنامج).دالة_تحقق_التنسيق);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحقائق) مثل طبيعي)) {
        طابق الحقائق[ف] مع
        | اختياري.موجود(د) -> { إذا (د.القيمة == الدالة.القيمة) { أرجع صواب; }; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    // A kernel call's operation number is attested as the result of a call
    // to its selector (msir_verifier.sn تحقق_عقد_نواة_مسير): that call stays.
    ف := 0;
    طالما (ف < (الطول((*البرنامج).أصول_النواة) مثل طبيعي)) {
        إذا ((*البرنامج).أصول_النواة[ف].المنتقي.القيمة == الدالة.القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    طابق (*البرنامج).مزودات_تخصيص_الذاكرة مع
    | اختياري.موجود(م) -> {
        إذا (م.التخصيص.القيمة == الدالة.القيمة || م.إعادة_التخصيص.القيمة == الدالة.القيمة
            || م.التحرير.القيمة == الدالة.القيمة) { أرجع صواب; };
    }
    | اختياري.لا_شيء -> { };
    // std's allocation counters: an interpreter that serves storage itself
    // answers a call to one from its own counts (machine_program.sn), so the
    // call stays; inlined, it would read std's counts, which only std's
    // allocator updates.
    ف := 0;
    طالما (ف < (الطول((*البرنامج).دوال_عدادات_التخصيص) مثل طبيعي)) {
        طابق (*البرنامج).دوال_عدادات_التخصيص[ف] مع
        | اختياري.موجود(د) -> { إذا (د.القيمة == الدالة.القيمة) { أرجع صواب; }; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Primitives whose meaning depends on the function they run in (a closure's
// environment, a kernel call's attestation, compile-time state).
عرف بدائي_مرتبط_بالدالة(البدائي: هوية_بدائي_مترجم): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع صواب; }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> { أرجع صواب; }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { أرجع صواب; }
    | هوية_بدائي_مترجم.ميزانية_وقت_الترجمة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Whether a call instruction carries machine-call or kernel facts tied to
// its own function.
عرف نداء_بحقائق_خاصة(النداء: &نداء_مسير): منطقي {
    إذا ((الطول((*النداء).نطاقات_الذاكرة) مثل طبيعي) > 0) { أرجع صواب; };
    طابق (*النداء).عقد_النواة مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { };
    طابق (*النداء).مكان_التعديل مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { };
    أرجع خطأ;
}

// The instruction count of a function whose body may be copied into its
// callers (at most حد_تعليمات_التضمين_بثابت), 0 for any other.
عرف حجم_دالة_قابلة_للتضمين(البرنامج: &برنامج_مسير, الدالة: &دالة_مسير): طبيعي {
    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(_) -> { };
    إذا ((الطول((*الدالة).الالتقاطات) مثل طبيعي) > 0) { أرجع 0; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)) {
        إذا ((*الدالة).معاملات_وقت_الترجمة[ف]) { أرجع 0; };
        ف := ف + 1;
    }
    إذا (دالة_حقيقة_برنامج(البرنامج, (*الدالة).المعرف)) { أرجع 0; };
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    إذا (عدد_الكتل == 0 || عدد_الكتل > حد_كتل_التضمين()) { أرجع 0; };
    // Block identities are their positions (the copy relies on it).
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        إذا (((*الدالة).الكتل[ك].المعرف.القيمة مثل طبيعي) != ك) { أرجع 0; };
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            العدد := العدد + 1;
            إذا (العدد > حد_تعليمات_التضمين_بثابت()) { أرجع 0; };
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { أرجع 0; };
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.استخراج_التقاط(_) -> { أرجع 0; }
            | عملية_مسير.نداء(النداء) -> {
                إذا (نداء_بحقائق_خاصة(&النداء)) { أرجع 0; };
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.دالة_سلطان(_) -> { }
                | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
                    إذا (بدائي_مرتبط_بالدالة(البدائي)) { أرجع 0; };
                }
                | _ -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    إذا (العدد == 0) { أرجع 1; };
    أرجع العدد;
}

// For each parameter of الدالة, whether an integer compare reads it or a
// conditional or multiway branch tests it.
عرف معاملات_مختبرة_للتضمين(الدالة: &دالة_مسير): متجه منطقي {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    // The parameter index + 1 of each value (0 for other values).
    دع رقم_المعامل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(رقم_المعامل, 0); ف := ف + 1; }
    دع الناتج: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع ق: طبيعي = (*الدالة).المعاملات[ف].المعرف.القيمة;
        إذا (ق < العدد) { رقم_المعامل[ق] := ف + 1; };
        ألحق(الناتج, خطأ);
        ف := ف + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع المختبرة: متغير متجه طبيعي = [];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.مقارنة_صحيح(م) -> { ألحق(المختبرة, م.اليسار.القيمة); ألحق(المختبرة, م.اليمين.القيمة); }
            | _ -> { };
            ت := ت + 1;
        }
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع_شرطي(الشرط, _, _)) -> { ألحق(المختبرة, الشرط.القيمة); }
        | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> { ألحق(المختبرة, الفرع.المميز.القيمة); }
        | _ -> { };
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المختبرة) مثل طبيعي)) {
            دع ق: طبيعي = المختبرة[م];
            إذا (ق < العدد && رقم_المعامل[ق] != 0) { الناتج[رقم_المعامل[ق] - 1] := صواب; };
            م := م + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

// Whether each value of الدالة is an integer or bool constant.
عرف قيم_ثابتة_للتضمين(الدالة: &دالة_مسير): متجه منطقي {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع الناتج: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, خطأ); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ثابت(الثابت) -> {
                دع عددي: متغير منطقي = خطأ;
                طابق الثابت مع
                | ثابت_مسير.منطق(_) -> { عددي := صواب; }
                | ثابت_مسير.صحيح_موقع(_) -> { عددي := صواب; }
                | ثابت_مسير.صحيح_طبيعي(_) -> { عددي := صواب; }
                | _ -> { };
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(ن) -> { إذا (عددي && (ن.المعرف.القيمة مثل طبيعي) < العدد) { الناتج[ن.المعرف.القيمة] := صواب; }; }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

// The callee of an inlinable call instruction (by its position in
// البرنامج.الدوال), or none.
عرف هدف_نداء_قابل_للتضمين(
    التعليمة: &تعليمة_مسير,
    المستدعي: معرف_دالة_مسير,
    القابلة: &متجه طبيعي,
    المختبرة: &متجه متجه منطقي,
    الثوابت: &متجه منطقي,
    البرنامج: &برنامج_مسير
): اختياري طبيعي {
    طابق (*التعليمة).العملية مع
    | عملية_مسير.نداء(النداء) -> {
        إذا (نداء_بحقائق_خاصة(&النداء)) { أرجع اختياري.لا_شيء(); };
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
            دع ف: طبيعي = الهدف.القيمة;
            إذا (ف == (المستدعي.القيمة مثل طبيعي) || ف >= (الطول(*القابلة) مثل طبيعي) || (*القابلة)[ف] == 0) {
                أرجع اختياري.لا_شيء();
            };
            إذا ((الطول(النداء.الحجج) مثل طبيعي) != (الطول((*البرنامج).الدوال[ف].المعاملات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            إذا ((*القابلة)[ف] > حد_تعليمات_التضمين()) {
                // Only when a constant argument meets a test of its parameter.
                دع مطوي: متغير منطقي = خطأ;
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(النداء.الحجج) مثل طبيعي)) {
                    دع ق: طبيعي = النداء.الحجج[ح].القيمة;
                    إذا (ق < (الطول(*الثوابت) مثل طبيعي) && (*الثوابت)[ق]
                        && ح < (الطول((*المختبرة)[ف]) مثل طبيعي) && (*المختبرة)[ف][ح]) {
                        مطوي := صواب;
                    };
                    ح := ح + 1;
                }
                إذا (!مطوي) { أرجع اختياري.لا_شيء(); };
            };
            إذا (للتعليمة_ناتج_مسير(التعليمة)) {
                طابق (*البرنامج).الدوال[ف].الناتج مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(_) -> { };
            };
            أرجع اختياري.موجود(ف);
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف تعليمة_فارغة_للتضمين(): تعليمة_مسير {
    دع الناتج: تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(
        اختياري.لا_شيء(), عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ))
    );
    أرجع الناتج;
}

// Inlines المستدعى (a copy) at instruction الموضع of block الكتلة of
// الدالة. The copy's blocks, then the block that holds the rest of the split
// block, are appended to the function (no other block moves, so the cost is
// the callee's, not the caller's); returns the rest's position. The round
// orders the blocks once after its last inline (رتب_كتل_بعد_التضمين).
عرف ضمّن_نداء_مسير(
    الدالة: &متغير دالة_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    المستدعى: &دالة_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير
): طبيعي {
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع عدد_المستدعى: طبيعي = الطول((*المستدعى).الكتل) مثل طبيعي;
    // Take the call instruction out.
    دع النداء_المأخوذ: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
    بدّل((*الدالة).الكتل[الكتلة].التعليمات[الموضع], النداء_المأخوذ);
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    طابق النداء_المأخوذ.العملية مع
    | عملية_مسير.نداء(النداء) -> {
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(النداء.الحجج) مثل طبيعي)) { ألحق(الحجج, النداء.الحجج[ح]); ح := ح + 1; }
    }
    | _ -> { };
    // Debug facts: the copy gets its own inlined-call scope with copies of
    // the callee's scopes and variables (compiler/debuginfo/inlining.sn), so
    // the debugger still sees the callee, its lines and its variables.
    دع خريطة_التصحيح: متغير خريطة_تضمين_تصحيح = خريطة_تضمين_تصحيح_فارغة();
    دع له_تضمين_تصحيح: متغير منطقي = خطأ;
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, معرف_الدالة) مع
    | اختياري.موجود(دالة_المستدعي) -> {
        طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, (*المستدعى).المعرف) مع
        | اختياري.موجود(دالة_المستدعى) -> {
            خريطة_التصحيح := افتح_تضمين_تصحيح(
                &متغير (*التصحيح).الدلالي, دالة_المستدعي, دالة_المستدعى,
                نطاق_تصحيح_من_مرجع_مسير(النداء_المأخوذ.نطاق_التصحيح),
                موقع_تصحيح_من_مرجع_مسير(النداء_المأخوذ.موقع_التصحيح)
            );
            له_تضمين_تصحيح := صواب;
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    // Values: the callee's parameters become the arguments, every other
    // callee value a new caller value (appended, in the callee's order).
    دع عدد_القيم: طبيعي = (*المستدعى).القيمة_التالية;
    دع معامل_رقم: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(معامل_رقم, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*المستدعى).المعاملات) مثل طبيعي)) {
        دع القيمة: طبيعي = (*المستدعى).المعاملات[ف].المعرف.القيمة;
        إذا (القيمة < عدد_القيم) { معامل_رقم[القيمة] := ف + 1; };
        ف := ف + 1;
    }
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    ف := 0;
    طالما (ف < عدد_القيم) {
        دع القديم: معرف_قيمة_مسير = معرف_قيمة_مسير_من((*المستدعى).المعرف, ف);
        دع الجديد: متغير معرف_قيمة_مسير = القديم;
        إذا (معامل_رقم[ف] != 0) {
            الجديد := الحجج[معامل_رقم[ف] - 1];
        } وإلا {
            الجديد := معرف_قيمة_مسير_من(معرف_الدالة, (*الدالة).القيمة_التالية);
            (*الدالة).القيمة_التالية := (*الدالة).القيمة_التالية + 1;
            دع القيمة: قيمة_مسير = { المعرف: الجديد, النوع: (*المستدعى).القيم[ف].النوع };
            ألحق((*الدالة).القيم, القيمة);
        };
        // The callee's variables of this value are its copies' in the caller
        // (an argument included: the parameter's variable follows it).
        إذا (له_تضمين_تصحيح) {
            دع المتغيرات: متجه معرف_متغير_تصحيح = متغيرات_تصحيح_لقيمة(&(*التصحيح).العقد, القديم);
            دع موقع_القيمة: اختياري معرف_موقع_تصحيح = موقع_تصحيح_لقيمة(&(*التصحيح).العقد, القديم);
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(المتغيرات) مثل طبيعي)) {
                طابق متغير_مضمن_تصحيح(&خريطة_التصحيح, المتغيرات[م]) مع
                | اختياري.موجود(النسخة) -> {
                    اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح).العقد, الجديد, النسخة, موقع_القيمة);
                }
                | اختياري.لا_شيء -> { };
                م := م + 1;
            }
        };
        دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: القديم, الجديد: الجديد };
        ألحق(الخريطة, الربط);
        ف := ف + 1;
    }
    // Positions: the copy's block k at عدد_الكتل + k, the rest after it.
    دع موقع_الباقي: طبيعي = عدد_الكتل + عدد_المستدعى;
    // The rest of the split block: the call's result as its parameter, the
    // instructions after the call and the terminator.
    دع البقية: متغير متجه تعليمة_مسير = [];
    دع الأولى: متغير متجه تعليمة_مسير = [];
    دع عدد_التعليمات: طبيعي = الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي;
    ف := 0;
    طالما (ف < عدد_التعليمات) {
        إذا (ف != الموضع) {
            دع المنقولة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
            بدّل((*الدالة).الكتل[الكتلة].التعليمات[ف], المنقولة);
            إذا (ف < الموضع) { ألحق(الأولى, المنقولة); } وإلا { ألحق(البقية, المنقولة); };
        };
        ف := ف + 1;
    }
    دع المنهي_المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
    بدّل((*الدالة).الكتل[الكتلة].المنهي, المنهي_المأخوذ);
    دع معاملات_الباقي: متغير متجه قيمة_مسير = [];
    دع حجج_العودة: متغير منطقي = خطأ;
    طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &النداء_المأخوذ) مع
    | اختياري.موجود(الناتج) -> { ألحق(معاملات_الباقي, الناتج); حجج_العودة := صواب; }
    | اختياري.لا_شيء -> { };
    دع الباقي: متغير كتلة_مسير = {
        المعرف: معرف_كتلة_مسير_من(معرف_الدالة, موقع_الباقي),
        المعاملات: معاملات_الباقي,
        التعليمات: البقية,
        المنهي: المنهي_المأخوذ
    };
    // The callee's entry (an inlinable function has one).
    دع مدخل_المستدعى: متغير طبيعي = 0;
    طابق (*المستدعى).المدخل مع
    | اختياري.موجود(م) -> { مدخل_المستدعى := م.القيمة; }
    | اختياري.لا_شيء -> { };
    دع حجج_فارغة: متجه معرف_قيمة_مسير = [];
    دع إلى_المدخل: حافة_مسير = {
        الهدف: معرف_كتلة_مسير_من(معرف_الدالة, عدد_الكتل + مدخل_المستدعى),
        الحجج: حجج_فارغة
    };
    (*الدالة).الكتل[الكتلة].المنهي := اختياري.موجود(منهي_مسير.فرع(إلى_المدخل));
    (*الدالة).الكتل[الكتلة].التعليمات := الأولى;
    // The copy: values renamed, each return a jump to the rest.
    دع إزاحة_الأهداف: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_المستدعى) { ألحق(إزاحة_الأهداف, عدد_الكتل + ف); ف := ف + 1; }
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_المستدعى) {
        دع الأصلية: &كتلة_مسير = &(*المستدعى).الكتل[ك];
        دع المعاملات: متغير متجه قيمة_مسير = [];
        ف := 0;
        طالما (ف < (الطول((*الأصلية).المعاملات) مثل طبيعي)) {
            دع القيمة: قيمة_مسير = {
                المعرف: ابحث_إعادة_ترقيم_قيمة(&الخريطة, (*الأصلية).المعاملات[ف].المعرف),
                النوع: (*الأصلية).المعاملات[ف].النوع
            };
            ألحق(المعاملات, القيمة);
            ف := ف + 1;
        }
        دع التعليمات: متغير متجه تعليمة_مسير = [];
        ف := 0;
        طالما (ف < (الطول((*الأصلية).التعليمات) مثل طبيعي)) {
            دع المنسوخة: متغير تعليمة_مسير = أعد_كتابة_تعليمة_قيم(المستدعى, &(*الأصلية).التعليمات[ف], &الخريطة);
            // The copy keeps the callee's debug location, and so its source
            // origin (برنامج_مسير.أصول_مواقع_التصحيح, أصل_تعليمة_مسير): its
            // line in the callee, and a trap in it names the callee. Only an
            // instruction without one takes the call's. Its scope is the
            // copy of its callee scope.
            إذا (المنسوخة.موقع_التصحيح.القيمة == مرجع_موقع_تصحيح_مسير_من(اختياري.لا_شيء()).القيمة) {
                المنسوخة.موقع_التصحيح := النداء_المأخوذ.موقع_التصحيح;
            };
            إذا (له_تضمين_تصحيح) {
                المنسوخة.نطاق_التصحيح := مرجع_نطاق_تصحيح_مسير_من(اختياري.موجود(
                    نطاق_مضمن_تصحيح(&خريطة_التصحيح, نطاق_تصحيح_من_مرجع_مسير(المنسوخة.نطاق_التصحيح))
                ));
            } وإلا {
                المنسوخة.نطاق_التصحيح := النداء_المأخوذ.نطاق_التصحيح;
            };
            ألحق(التعليمات, المنسوخة);
            ف := ف + 1;
        }
        دع المنهي: متغير اختياري منهي_مسير = أعد_كتابة_منهي_اختياري_قيم(&(*الأصلية).المنهي, &الخريطة);
        دع المنهي_الجديد: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        طابق المنهي مع
        | اختياري.موجود(م) -> {
            طابق م مع
            | منهي_مسير.إرجاع(القيمة) -> {
                دع حجج_الباقي: متغير متجه معرف_قيمة_مسير = [];
                طابق القيمة مع
                | اختياري.موجود(ق) -> { إذا (حجج_العودة) { ألحق(حجج_الباقي, ق); }; }
                | اختياري.لا_شيء -> { };
                دع الحافة: حافة_مسير = {
                    الهدف: معرف_كتلة_مسير_من(معرف_الدالة, موقع_الباقي),
                    الحجج: حجج_الباقي
                };
                المنهي_الجديد := اختياري.موجود(منهي_مسير.فرع(الحافة));
            }
            | الآخر -> {
                المنهي_الجديد := اختياري.موجود(منهي_منقول_بكتل_جديدة(الآخر, &إزاحة_الأهداف, معرف_الدالة));
            };
        }
        | اختياري.لا_شيء -> { };
        دع النسخة: كتلة_مسير = {
            المعرف: معرف_كتلة_مسير_من(معرف_الدالة, عدد_الكتل + ك),
            المعاملات: المعاملات,
            التعليمات: التعليمات,
            المنهي: المنهي_الجديد
        };
        ألحق((*الدالة).الكتل, النسخة);
        ك := ك + 1;
    }
    ألحق((*الدالة).الكتل, الباقي);
    أرجع موقع_الباقي;
}

// The terminator (taken, not copied) with its edge targets renamed through
// المواقع.
عام عرف منهي_منقول_بكتل_جديدة(المنهي: منهي_مسير, المواقع: &متجه طبيعي, الدالة: معرف_دالة_مسير): منهي_مسير {
    طابق المنهي مع
    | منهي_مسير.فرع(الحافة) -> {
        دع ح: متغير حافة_مسير = الحافة;
        ح.الهدف := معرف_كتلة_مسير_من(الدالة, (*المواقع)[ح.الهدف.القيمة]);
        أرجع منهي_مسير.فرع(ح);
    }
    | منهي_مسير.فرع_شرطي(الشرط, الصواب, الخطأ) -> {
        دع ص: متغير حافة_مسير = الصواب;
        دع خ: متغير حافة_مسير = الخطأ;
        ص.الهدف := معرف_كتلة_مسير_من(الدالة, (*المواقع)[ص.الهدف.القيمة]);
        خ.الهدف := معرف_كتلة_مسير_من(الدالة, (*المواقع)[خ.الهدف.القيمة]);
        أرجع منهي_مسير.فرع_شرطي(الشرط, ص, خ);
    }
    | منهي_مسير.فرع_متعدد(الفرع) -> {
        دع الجديد: متغير فرع_متعدد_مسير = الفرع;
        الجديد.الافتراضي.الهدف := معرف_كتلة_مسير_من(الدالة, (*المواقع)[الجديد.الافتراضي.الهدف.القيمة]);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الجديد.الحالات) مثل طبيعي)) {
            الجديد.الحالات[ف].الحافة.الهدف := معرف_كتلة_مسير_من(الدالة, (*المواقع)[الجديد.الحالات[ف].الحافة.الهدف.القيمة]);
            ف := ف + 1;
        }
        أرجع منهي_مسير.فرع_متعدد(الجديد);
    }
    | الآخر -> { أرجع الآخر; };
}

// Orders the blocks of a function the round inlined into: each split block
// is followed by its callee's copy and then by the rest of it (which may be
// split again), as if every copy had been inserted where its call was. The
// copies and rests the inlines appended are those from عدد_الأصلية on;
// اللاحقة[b] is the position of the first block appended for a split of b
// (0: not split), and the rest is the last of them, at بقية_الكتلة[b].
عرف رتب_كتل_بعد_التضمين(
    الدالة: &متغير دالة_مسير,
    عدد_الأصلية: طبيعي,
    اللاحقة: &متجه طبيعي,
    بقية_الكتلة: &متجه طبيعي
): فراغ {
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع الترتيب: متغير متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الأصلية) {
        دع الحالية: متغير طبيعي = ك;
        دع استمر: متغير منطقي = صواب;
        طالما (استمر) {
            ألحق(الترتيب, الحالية);
            إذا (الحالية < (الطول(*اللاحقة) مثل طبيعي) && (*اللاحقة)[الحالية] != 0) {
                دع ب: متغير طبيعي = (*اللاحقة)[الحالية];
                دع البقية: طبيعي = (*بقية_الكتلة)[الحالية];
                طالما (ب < البقية) { ألحق(الترتيب, ب); ب := ب + 1; }
                الحالية := البقية;
            } وإلا {
                استمر := خطأ;
            };
        }
        ك := ك + 1;
    }
    دع المواقع: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < العدد) { ألحق(المواقع, 0); ك := ك + 1; }
    ك := 0;
    طالما (ك < (الطول(الترتيب) مثل طبيعي)) { المواقع[الترتيب[ك]] := ك; ك := ك + 1; }
    دع الجديدة: متغير متجه كتلة_مسير = [];
    ك := 0;
    طالما (ك < (الطول(الترتيب) مثل طبيعي)) {
        دع فارغة_ت: متجه تعليمة_مسير = [];
        دع فارغة_م: متجه قيمة_مسير = [];
        دع المنقولة: متغير كتلة_مسير = {
            المعرف: معرف_كتلة_مسير_من(معرف_الدالة, 0), المعاملات: فارغة_م,
            التعليمات: فارغة_ت, المنهي: اختياري.لا_شيء()
        };
        بدّل((*الدالة).الكتل[الترتيب[ك]], المنقولة);
        المنقولة.المعرف := معرف_كتلة_مسير_من(معرف_الدالة, ك);
        دع المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        بدّل(المنقولة.المنهي, المأخوذ);
        طابق المأخوذ مع
        | اختياري.موجود(م) -> { المنقولة.المنهي := اختياري.موجود(منهي_منقول_بكتل_جديدة(م, &المواقع, معرف_الدالة)); }
        | اختياري.لا_شيء -> { };
        ألحق(الجديدة, المنقولة);
        ك := ك + 1;
    }
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(م) -> { (*الدالة).المدخل := اختياري.موجود(معرف_كتلة_مسير_من(معرف_الدالة, المواقع[م.القيمة])); }
    | اختياري.لا_شيء -> { };
    (*الدالة).الكتل := الجديدة;
}

// One round over the program; true when something was inlined.
عرف جولة_تضمين_مسير(
    البرنامج: &متغير برنامج_مسير,
    المحسنة: &متجه منطقي,
    المعدلة: &متغير متجه منطقي,
    التصحيح: &متغير بيانات_تصحيح_مسير
): منطقي {
    دع عدد_الدوال: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    // Each function's size when it is inlinable (0 otherwise) and which of
    // its parameters it tests.
    دع القابلة: متغير متجه طبيعي = [];
    دع المختبرة: متغير متجه متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    دع أي_قابلة: متغير منطقي = خطأ;
    طالما (ف < عدد_الدوال) {
        دع الحجم: متغير طبيعي = 0;
        // A function outside المحسنة is called by none inside it.
        إذا (((*البرنامج).الدوال[ف].المعرف.القيمة مثل طبيعي) == ف && ف < (الطول(*المحسنة) مثل طبيعي) && (*المحسنة)[ف]) {
            الحجم := حجم_دالة_قابلة_للتضمين(البرنامج, &(*البرنامج).الدوال[ف]);
        };
        ألحق(القابلة, الحجم);
        إذا (الحجم > حد_تعليمات_التضمين()) {
            ألحق(المختبرة, معاملات_مختبرة_للتضمين(&(*البرنامج).الدوال[ف]));
        } وإلا {
            دع لا_شيء: متجه منطقي = [];
            ألحق(المختبرة, لا_شيء);
        };
        إذا (الحجم != 0) { أي_قابلة := صواب; };
        ف := ف + 1;
    }
    إذا (!أي_قابلة) { أرجع خطأ; };
    // The inlinable functions as the round starts: a callee inlined into
    // another function in this round is copied as it was, not with the calls
    // it gained earlier in the round.
    دع الأصول: متغير متجه اختياري دالة_مسير = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        إذا (القابلة[ف] != 0) {
            ألحق(الأصول, اختياري.موجود(انسخ_مملوكا_دالة_مسير(&(*البرنامج).الدوال[ف])));
        } وإلا {
            ألحق(الأصول, اختياري.لا_شيء());
        };
        ف := ف + 1;
    }
    دع تغير: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < عدد_الدوال) {
        دع المعرف: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
        دع مؤهلة: متغير منطقي = (المعرف.القيمة مثل طبيعي) == د && د < (الطول(*المحسنة) مثل طبيعي) && (*المحسنة)[د];
        طابق (*البرنامج).دالة_تهيئة_الوحدة مع
        | اختياري.موجود(م) -> { إذا ((م.القيمة مثل طبيعي) == د) { مؤهلة := خطأ; }; }
        | اختياري.لا_شيء -> { };
        طابق (*البرنامج).الدوال[د].المدخل مع
        | اختياري.لا_شيء -> { مؤهلة := خطأ; }
        | اختياري.موجود(_) -> { };
        // A function still holding compile-time work is left as lowered.
        دع ك: متغير طبيعي = 0;
        طالما (مؤهلة && ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            إذا (((*البرنامج).الدوال[د].الكتل[ك].المعرف.القيمة مثل طبيعي) != ك) { مؤهلة := خطأ; };
            دع ت: متغير طبيعي = 0;
            طالما (مؤهلة && ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                إذا ((*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { مؤهلة := خطأ; };
                ت := ت + 1;
            }
            ك := ك + 1;
        }
        دع ثوابت_المستدعي: متغير متجه منطقي = [];
        إذا (مؤهلة) { ثوابت_المستدعي := قيم_ثابتة_للتضمين(&(*البرنامج).الدوال[د]); };
        دع عدد_المضمنة: متغير طبيعي = 0;
        دع عدد_الأصلية: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
        دع اللاحقة: متغير متجه طبيعي = [];
        دع بقية_الكتلة: متغير متجه طبيعي = [];
        // The block being scanned: an original block, then the rest of it
        // after each inline (a copy is not scanned in the round that made it).
        دع الأصلية: متغير طبيعي = 0;
        ك := 0;
        طالما (مؤهلة && الأصلية < عدد_الأصلية && عدد_المضمنة < حد_تضمينات_الدالة()) {
            دع وجد: متغير اختياري طبيعي = اختياري.لا_شيء();
            دع الموضع: متغير طبيعي = 0;
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق هدف_نداء_قابل_للتضمين(&(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت], المعرف, &القابلة, &المختبرة, &ثوابت_المستدعي, البرنامج) مع
                | اختياري.موجود(ه) -> {
                    وجد := اختياري.موجود(ه);
                    الموضع := ت;
                    ت := الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
                }
                | اختياري.لا_شيء -> { ت := ت + 1; };
            }
            طابق وجد مع
            | اختياري.موجود(ه) -> {
                طابق الأصول[ه] مع
                | اختياري.موجود(المستدعى) -> {
                    دع الأول: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
                    دع الباقي: طبيعي = ضمّن_نداء_مسير(&متغير (*البرنامج).الدوال[د], ك, الموضع, &المستدعى, التصحيح);
                    طالما ((الطول(اللاحقة) مثل طبيعي) <= الباقي) { ألحق(اللاحقة, 0); ألحق(بقية_الكتلة, 0); }
                    اللاحقة[ك] := الأول;
                    بقية_الكتلة[ك] := الباقي;
                    ك := الباقي;
                    عدد_المضمنة := عدد_المضمنة + 1;
                }
                | اختياري.لا_شيء -> { الأصلية := الأصلية + 1; ك := الأصلية; };
            }
            | اختياري.لا_شيء -> { الأصلية := الأصلية + 1; ك := الأصلية; };
        }
        إذا (عدد_المضمنة > 0) {
            رتب_كتل_بعد_التضمين(&متغير (*البرنامج).الدوال[د], عدد_الأصلية, &اللاحقة, &بقية_الكتلة);
            (*المعدلة)[د] := صواب;
            تغير := صواب;
        };
        د := د + 1;
    }
    أرجع تغير;
}

// Inlines into the functions المحسنة marks (by position) and returns which
// functions it changed. A changed function's blocks are numbered by position
// and its values are defined once, each below القيمة_التالية, but they are
// not renumbered densely: the control-flow simplification that follows
// (msir_flow.sn) does that once for both passes.
عام عرف ضمّن_الدوال_الصغيرة_مسير(
    البرنامج: &متغير برنامج_مسير,
    المحسنة: &متجه منطقي,
    التصحيح: &متغير بيانات_تصحيح_مسير
): متجه منطقي {
    دع المعدلة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال) مثل طبيعي)) { ألحق(المعدلة, خطأ); ف := ف + 1; }
    دع الجولة: متغير طبيعي = 0;
    طالما (الجولة < عدد_جولات_التضمين()) {
        إذا (!جولة_تضمين_مسير(البرنامج, المحسنة, &متغير المعدلة, التصحيح)) { أرجع المعدلة; };
        الجولة := الجولة + 1;
    }
    أرجع المعدلة;
}
