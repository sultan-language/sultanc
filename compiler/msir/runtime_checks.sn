استورد compiler.source.span;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد compiler.source.source_file;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.builtins_generated;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_inlining;
استورد compiler.msir.msir_optimization_pipeline;
استورد compiler.msir.lowering.model;
استورد compiler.msir.lowering.msir_context;
استورد compiler.msir.lowering.caller_location;
استورد المكتبة.نصوص.من_بايتات;

// Runtime checks that report (docs/en/reference/errors.md, "Runtime
// checks"), as Rust's overflow and bounds-check panics. MSIR's checked
// integer operations and lowering's bounds checks trap; a trap ends the
// program with no word of why. This pass, which the driver runs once
// compile-time work is discharged and before the optimization pipeline
// (driver/compiler_driver.sn), so every consumer (the native backends, LLVM,
// wasm32 and both interpreters) receives the same checks, gives each check
// a branch to one cold block of its own that calls std's report
// (std/process/runtime_check.sn, برنامج_مسير.دالة_فشل_فحص_التشغيل) with the
// kind, the source file (one text global per file), line and column, and
// the index and the length of a bounds check, then traps; the report
// panics, so the panic handler prints it in the program's language. No
// message is formatted at the check.
//
// What reports:
//   - add, subtract and multiply of every integer width up to 64 bits,
//     signed and unsigned (so `uint` going below zero, and `-x`): add and
//     subtract compute the wrapping result and test it, multiply widens
//     (32 bits and below) or tests the operands (64 bits);
//   - division and remainder by zero, and the signed minimum divided by -1
//     (an overflow);
//   - an index past the end of a vector or a text (lowering/places.sn).
// What still traps: shifts by the width or more, conversions that do not
// fit, 128-bit operations, a check whose place is unknown, functions that
// hold compile-time work, the module initializer, std's task switch, std's
// allocator and the report itself; and every check of a program without std (bare metal), which
// has no report to call.
//
// The place of an operation the source wrote is its expression's start, as
// lowering recorded it (برنامج_مسير.مواقع_فحوص_التشغيل); any other
// operation's is its statement's (its debug location's origin). The new
// instructions keep the checked instruction's debug location and scope. The
// blocks of a changed function are ordered so each path's continuations
// follow it and the cold blocks come last.

عام نوع نتيجة_فحوص_تشغيل_مسير =
    // By position, the functions the pass changed.
    | أضيفت بنوع متجه منطقي
    // An MSIR construction was refused: a compiler fault.
    | أخفقت
;

// The report's parameter Types (its signature is fixed by std).
نوع مبلغ_فحص_تشغيل = {
    الدالة: معرف_دالة_مسير,
    نوع_الصنف: معرف_نوع,
    نوع_المرجع: معرف_نوع,
    نوع_السطر: معرف_نوع,
    نوع_العمود: معرف_نوع,
    نوع_الأول: معرف_نوع,
    نوع_الثاني: معرف_نوع
};

// A check's place: the file's text global, the 1-based line and column.
نوع مكان_فحص_تشغيل = {
    العام: معرف_عام_مسير,
    السطر: طبيعي,
    العمود: طبيعي
};

// Where scanning goes on after a check: the block and the instruction.
نوع متابعة_فحص_تشغيل = {
    الكتلة: طبيعي,
    التعليمة: طبيعي
};

// The kinds the report takes (process.failure_text, نص_فحص_تشغيل).
عرف صنف_تجاوز_فحص(): عدد { أرجع 0; }
عرف صنف_فهرس_فحص(): عدد { أرجع 1; }
عرف صنف_قسمة_فحص(): عدد { أرجع 2; }

عرف نوع_بدائي_فحص(البدائي: نوع_بدائي_مقنن): معرف_نوع {
    أرجع معرف_نوع_من(رقم_نوع_بدائي(البدائي));
}

عرف حافة_فحص(الهدف: معرف_كتلة_مسير): حافة_مسير {
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    دع الحافة: حافة_مسير = { الهدف: الهدف, الحجج: بلا_حجج };
    أرجع الحافة;
}

عرف ناتج_فحص(النتيجة: نتيجة_بناء_قيمة_مسير, الدالة: معرف_دالة_مسير, أخفق: &متغير منطقي): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(ق) -> { أرجع ق; }
    | _ -> {
        *أخفق := صواب;
        أرجع معرف_قيمة_مسير_من(الدالة, 0);
    };
}

عرف منهي_فحص(النتيجة: نتيجة_بناء_منهي_مسير, أخفق: &متغير منطقي): فراغ {
    طابق النتيجة مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | نتيجة_بناء_منهي_مسير.مرفوض(_) -> { *أخفق := صواب; };
}

// The builder state of a check: the checked instruction's debug location
// and scope.
عرف بناء_فحص(الموقع: مرجع_موقع_تصحيح_مسير, النطاق: مرجع_نطاق_تصحيح_مسير): حالة_بناء_مسير {
    دع البناء: متغير حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    البناء.موقع_التصحيح_الحالي := موقع_تصحيح_من_مرجع_مسير(الموقع);
    البناء.نطاق_التصحيح_الحالي := نطاق_تصحيح_من_مرجع_مسير(النطاق);
    أرجع البناء;
}

// The constant القيمة of the integer Type الوصف describes.
عرف ثابت_صحيح_فحص(الوصف: وصف_صحيح_خفض, القيمة: عدد): ثابت_مسير {
    إذا (الوصف.موقع) { أرجع ثابت_مسير.صحيح_موقع(القيمة); };
    أرجع ثابت_مسير.صحيح_طبيعي(القيمة مثل طبيعي);
}

// The least signed value of البتات bits, -2^(bits-1).
عرف أدنى_موقع_فحص(البتات: طبيعي): عدد {
    دع القيمة: متغير عدد = -1;
    دع ف: متغير طبيعي = 1;
    طالما (ف < البتات) {
        القيمة := القيمة * 2;
        ف := ف + 1;
    }
    أرجع القيمة;
}

// The greatest unsigned value of البتات bits, below 64.
عرف أعلى_طبيعي_فحص(البتات: طبيعي): طبيعي {
    دع القيمة: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البتات) {
        القيمة := القيمة * 2;
        ف := ف + 1;
    }
    أرجع القيمة - 1;
}

عرف نوع_قيمة_فحص(البرنامج: &برنامج_مسير, د: طبيعي, القيمة: معرف_قيمة_مسير): اختياري معرف_نوع {
    دع الموضع: طبيعي = القيمة.القيمة مثل طبيعي;
    إذا (الموضع >= (الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*البرنامج).الدوال[د].القيم[الموضع].النوع);
}

// The report's signature: (kind: int, file: &string, line: uint,
// column: uint, first: int, second: int), nothing returned.
عرف مبلغ_فحص_للبرنامج(البرنامج: &برنامج_مسير): اختياري مبلغ_فحص_تشغيل {
    دع الدالة: معرف_دالة_مسير;
    طابق (*البرنامج).دالة_فشل_فحص_التشغيل مع
    | اختياري.موجود(د) -> { الدالة := د; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع د: طبيعي = الدالة.القيمة مثل طبيعي;
    إذا (د >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((الطول((*البرنامج).الدوال[د].المعاملات) مثل طبيعي) != 6) { أرجع اختياري.لا_شيء(); };
    طابق (*البرنامج).الدوال[د].الناتج مع
    | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
    | اختياري.لا_شيء -> { };
    دع المبلغ: مبلغ_فحص_تشغيل = {
        الدالة: الدالة,
        نوع_الصنف: (*البرنامج).الدوال[د].المعاملات[0].النوع,
        نوع_المرجع: (*البرنامج).الدوال[د].المعاملات[1].النوع,
        نوع_السطر: (*البرنامج).الدوال[د].المعاملات[2].النوع,
        نوع_العمود: (*البرنامج).الدوال[د].المعاملات[3].النوع,
        نوع_الأول: (*البرنامج).الدوال[د].المعاملات[4].النوع,
        نوع_الثاني: (*البرنامج).الدوال[د].المعاملات[5].النوع
    };
    أرجع اختياري.موجود(المبلغ);
}

// The place of the source position الموضع: its file's text global (made
// once per file) and its line and column.
// std's allocator (std/os/allocation*.sn, allocator_platform.sn) keeps its
// traps: it stops on a bad release with a deliberate checked subtraction, and
// a report would allocate on the heap it found corrupted.
عرف ملف_مخصص_المكتبة_فحص(الاسم: &نص): منطقي {
    دع الأسماء: متجه نص = [«std/os/allocation.sn», «std/os/allocation_cache.sn», «std/os/allocator_platform.sn»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        إذا (اسم_مصدر_ينتهي_بمسار(الاسم, &الأسماء[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف مكان_فحص_عند(
    البرنامج: &متغير برنامج_مسير,
    خريطة_المصادر: &خريطة_مصادر,
    الفهارس: &متغير متجه فهرس_مصدر_موقع,
    الملفات: &متغير متجه ملف_موقع_خفض,
    الموضع: موضع
): اختياري مكان_فحص_تشغيل {
    دع الموقع: موقع_مستدع_خفض;
    طابق موقع_في_مصدر(الفهارس, خريطة_المصادر, الموضع) مع
    | اختياري.موجود(م) -> { الموقع := م; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع العام: متغير اختياري معرف_عام_مسير = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الملفات) مثل طبيعي)) {
        إذا ((*الملفات)[ف].المصدر == الموضع.المصدر) { العام := اختياري.موجود((*الملفات)[ف].العام); };
        ف := ف + 1;
    }
    طابق العام مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طابق اسم_مصدر_من_الخريطة(خريطة_المصادر, الموضع.المصدر مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الاسم) -> {
            إذا (ملف_مخصص_المكتبة_فحص(&الاسم)) { أرجع اختياري.لا_شيء(); };
            دع الجديد: معرف_عام_مسير = أضف_عاما_مسير(
                البرنامج, نوع_بدائي_فحص(نوع_بدائي_مقنن.نص()), ثابت_مسير.نص(بايتات_من_نص(مسار_بشرطة_أمامية(&الاسم))), خطأ
            );
            دع الملف: ملف_موقع_خفض = { المصدر: الموضع.المصدر, العام: الجديد };
            ألحق(*الملفات, الملف);
            العام := اختياري.موجود(الجديد);
        };
    };
    طابق العام مع
    | اختياري.موجود(ع) -> {
        دع المكان: مكان_فحص_تشغيل = { العام: ع, السطر: الموقع.السطر, العمود: الموقع.العمود };
        أرجع اختياري.موجود(المكان);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// A new block of function د: الأصل is the original block whose path it
// continues, or none for a cold block (ordered last).
عرف كتلة_جديدة_فحص(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الإضافات: &متغير متجه اختياري طبيعي,
    الأصل: اختياري طبيعي,
    أخفق: &متغير منطقي
): معرف_كتلة_مسير {
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> {
        ألحق(*الإضافات, الأصل);
        أرجع ك;
    }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(_) -> {
        *أخفق := صواب;
        أرجع معرف_كتلة_مسير_من(الدالة, 0);
    };
}

// Moves the instructions of block ك from position من on, and its
// terminator, to the new block الجديدة.
عرف انقل_بقية_كتلة_فحص(البرنامج: &متغير برنامج_مسير, د: طبيعي, ك: طبيعي, البداية_من: طبيعي, الجديدة: طبيعي): فراغ {
    دع الباقية: متغير متجه تعليمة_مسير = [];
    دع المنقولة: متغير متجه تعليمة_مسير = [];
    دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع المأخوذة: متغير تعليمة_مسير = تعليمة_فارغة_للتضمين();
        بدّل((*البرنامج).الدوال[د].الكتل[ك].التعليمات[ف], المأخوذة);
        إذا (ف < البداية_من) { ألحق(الباقية, المأخوذة); } وإلا { ألحق(المنقولة, المأخوذة); };
        ف := ف + 1;
    }
    (*البرنامج).الدوال[د].الكتل[ك].التعليمات := الباقية;
    (*البرنامج).الدوال[د].الكتل[الجديدة].التعليمات := المنقولة;
    دع المنهي: متغير اختياري منهي_مسير = اختياري.لا_شيء();
    بدّل((*البرنامج).الدوال[د].الكتل[ك].المنهي, المنهي);
    (*البرنامج).الدوال[د].الكتل[الجديدة].المنهي := المنهي;
    (*البرنامج).الدوال[د].الكتل[الجديدة].موقع_تصحيح_المنهي := (*البرنامج).الدوال[د].الكتل[ك].موقع_تصحيح_المنهي;
    (*البرنامج).الدوال[د].الكتل[الجديدة].نطاق_تصحيح_المنهي := (*البرنامج).الدوال[د].الكتل[ك].نطاق_تصحيح_المنهي;
}

// القيمة as the report's 64-bit parameter Type الهدف, or 0 when it is none
// or not a 64-bit integer.
عرف حجة_فحص(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    القيمة: اختياري معرف_قيمة_مسير,
    الهدف: معرف_نوع,
    أخفق: &متغير منطقي
): معرف_قيمة_مسير {
    دع د: طبيعي = الدالة.القيمة مثل طبيعي;
    طابق القيمة مع
    | اختياري.موجود(ق) -> {
        طابق نوع_قيمة_فحص(البرنامج, د, ق) مع
        | اختياري.موجود(النوع) -> {
            إذا (معرفا_نوع_متساويان(النوع, الهدف)) { أرجع ق; };
            طابق وصف_صحيح_للخفض(الأنواع, النوع) مع
            | اختياري.موجود(الوصف) -> {
                إذا (الوصف.البتات == 64) {
                    أرجع ناتج_فحص(أصدر_تحويل_صحيح_مسير(
                        البرنامج, البناء, الدالة, الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(), ق, الهدف
                    ), الدالة, أخفق);
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع ناتج_فحص(أصدر_ثابتا_مسير(البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(0), الهدف), الدالة, أخفق);
}

// The cold block's body: the report's one call, then the trap.
عرف أصدر_بلاغ_فحص(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الأنواع: &سجل_أنواع,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الصنف: عدد,
    الأول: اختياري معرف_قيمة_مسير,
    الثاني: اختياري معرف_قيمة_مسير,
    أخفق: &متغير منطقي
): فراغ {
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    ألحق(الحجج, ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(الصنف), (*المبلغ).نوع_الصنف
    ), الدالة, أخفق));
    دع مكان_الملف: معرف_قيمة_مسير = ناتج_فحص(أصدر_مكان_عام_مسير(
        البرنامج, البناء, الدالة, الكتلة, (*المكان).العام, نوع_بدائي_فحص(نوع_بدائي_مقنن.نص()), خطأ
    ), الدالة, أخفق);
    ألحق(الحجج, ناتج_فحص(أصدر_مكان_إلى_مرجع_مسير(
        البرنامج, البناء, الدالة, الكتلة, مكان_الملف, (*المبلغ).نوع_المرجع
    ), الدالة, أخفق));
    ألحق(الحجج, ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_طبيعي((*المكان).السطر), (*المبلغ).نوع_السطر
    ), الدالة, أخفق));
    ألحق(الحجج, ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, البناء, الدالة, الكتلة, ثابت_مسير.صحيح_طبيعي((*المكان).العمود), (*المبلغ).نوع_العمود
    ), الدالة, أخفق));
    ألحق(الحجج, حجة_فحص(البرنامج, البناء, الدالة, الكتلة, الأنواع, الأول, (*المبلغ).نوع_الأول, أخفق));
    ألحق(الحجج, حجة_فحص(البرنامج, البناء, الدالة, الكتلة, الأنواع, الثاني, (*المبلغ).نوع_الثاني, أخفق));
    طابق أصدر_نداء_مسير(البرنامج, البناء, الدالة, الكتلة, (*المبلغ).الدالة, &الحجج) مع
    | نتيجة_بناء_قيمة_مسير.مرفوضة(_) -> { *أخفق := صواب; }
    | _ -> { };
    منهي_فحص(اختم_بفخ_مسير(البرنامج, البناء, الدالة, الكتلة), أخفق);
}

// A cold block reporting الصنف at المكان.
عرف كتلة_بلاغ_فحص(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الأنواع: &سجل_أنواع,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الصنف: عدد,
    الإضافات: &متغير متجه اختياري طبيعي,
    أخفق: &متغير منطقي
): معرف_كتلة_مسير {
    دع الكتلة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
    إذا (*أخفق) { أرجع الكتلة; };
    أصدر_بلاغ_فحص(
        البرنامج, البناء, الدالة, الكتلة, الأنواع, المبلغ, المكان, الصنف,
        اختياري.لا_شيء(), اختياري.لا_شيء(), أخفق
    );
    أرجع الكتلة;
}

// add or subtract: the wrapping result, then whether it overflowed.
عرف افحص_جمعا_أو_طرحا(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    ك: طبيعي,
    ت: طبيعي,
    الحساب: حساب_صحيح_مسير,
    جمع: منطقي,
    النوع: معرف_نوع,
    الوصف: وصف_صحيح_خفض,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الأصل: طبيعي,
    الإضافات: &متغير متجه اختياري طبيعي,
    أخفق: &متغير منطقي
): متابعة_فحص_تشغيل {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(الدالة, ك);
    دع البناء: حالة_بناء_مسير = بناء_فحص(
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].موقع_التصحيح,
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].نطاق_التصحيح
    );
    // The checked operation itself stays, unchanged, at the head of the
    // continuation, which the test guards: proofs that read its defining
    // operation (the verifier's memory-range lengths) still see it. The
    // test uses a wrapping copy of it.
    دع عملية_الملتف: متغير عملية_حساب_صحيح = عملية_حساب_صحيح.طرح_ملتف();
    إذا (جمع) { عملية_الملتف := عملية_حساب_صحيح.جمع_ملتف(); };
    دع المتابعة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    دع البارد: معرف_كتلة_مسير = كتلة_بلاغ_فحص(
        البرنامج, &البناء, الدالة, الأنواع, المبلغ, المكان, صنف_تجاوز_فحص(), الإضافات, أخفق
    );
    دع لا_متابعة: متابعة_فحص_تشغيل = { الكتلة: ك, التعليمة: ت + 1 };
    إذا (*أخفق) { أرجع لا_متابعة; };
    انقل_بقية_كتلة_فحص(البرنامج, د, ك, ت, المتابعة.القيمة مثل طبيعي);
    دع نوع_المنطق: معرف_نوع = نوع_بدائي_فحص(نوع_بدائي_مقنن.منطقي());
    دع أ: معرف_قيمة_مسير = الحساب.اليسار;
    دع ب: معرف_قيمة_مسير = الحساب.اليمين;
    دع الملتف_ناتج: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_الملتف, أ, ب, النوع
    ), الدالة, أخفق);
    دع التجاوز: متغير معرف_قيمة_مسير = الملتف_ناتج;
    إذا (الوصف.موقع) {
        // Signed: the result's sign differs from both operands' (add), or
        // from the left's while the operands' signs differ (subtract).
        دع س1: معرف_قيمة_مسير;
        دع س2: معرف_قيمة_مسير;
        إذا (جمع) {
            س1 := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_حصري(), أ, الملتف_ناتج, النوع), الدالة, أخفق);
            س2 := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_حصري(), ب, الملتف_ناتج, النوع), الدالة, أخفق);
        } وإلا {
            س1 := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_حصري(), أ, ب, النوع), الدالة, أخفق);
            س2 := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_حصري(), أ, الملتف_ناتج, النوع), الدالة, أخفق);
        };
        دع المشترك: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.و_بتي(), س1, س2, النوع
        ), الدالة, أخفق);
        دع الصفر: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, ثابت_صحيح_فحص(الوصف, 0), النوع
        ), الدالة, أخفق);
        التجاوز := ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أصغر(), المشترك, الصفر, نوع_المنطق
        ), الدالة, أخفق);
    } وإلا إذا (جمع) {
        // Unsigned add: the sum wrapped below the left operand.
        التجاوز := ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أصغر(), الملتف_ناتج, أ, نوع_المنطق
        ), الدالة, أخفق);
    } وإلا {
        // Unsigned subtract: below zero.
        التجاوز := ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أصغر(), أ, ب, نوع_المنطق
        ), الدالة, أخفق);
    };
    منهي_فحص(اختم_بفرع_شرطي_مسير(
        البرنامج, &البناء, الدالة, الكتلة, التجاوز, حافة_فحص(البارد), حافة_فحص(المتابعة)
    ), أخفق);
    // Past the checked operation, which the test now guards.
    دع التالية: متابعة_فحص_تشغيل = { الكتلة: المتابعة.القيمة مثل طبيعي, التعليمة: 1 };
    أرجع التالية;
}

// multiply of 32 bits or fewer: the exact product in 64 bits, then whether
// it fits; the operation becomes the truncation of that product.
عرف افحص_ضربا_ضيقا(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    ك: طبيعي,
    ت: طبيعي,
    الحساب: حساب_صحيح_مسير,
    الوصف: وصف_صحيح_خفض,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الأصل: طبيعي,
    الإضافات: &متغير متجه اختياري طبيعي,
    أخفق: &متغير منطقي
): متابعة_فحص_تشغيل {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(الدالة, ك);
    دع البناء: حالة_بناء_مسير = بناء_فحص(
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].موقع_التصحيح,
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].نطاق_التصحيح
    );
    دع الواسع: معرف_نوع;
    دع التوسيع: عملية_تحويل_صحيح;
    دع وصف_الواسع: وصف_صحيح_خفض = { موقع: الوصف.موقع, البتات: 64 };
    إذا (الوصف.موقع) {
        الواسع := نوع_بدائي_فحص(نوع_بدائي_مقنن.عدد());
        التوسيع := عملية_تحويل_صحيح.توسيع_بإشارة();
    } وإلا {
        الواسع := نوع_بدائي_فحص(نوع_بدائي_مقنن.طبيعي());
        التوسيع := عملية_تحويل_صحيح.توسيع_صفري();
    };
    // Signed: a second test, of the least value, on the hot path.
    دع الثانية: متغير معرف_كتلة_مسير = الكتلة;
    إذا (الوصف.موقع) {
        الثانية := كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    };
    دع المتابعة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    دع البارد: معرف_كتلة_مسير = كتلة_بلاغ_فحص(
        البرنامج, &البناء, الدالة, الأنواع, المبلغ, المكان, صنف_تجاوز_فحص(), الإضافات, أخفق
    );
    دع لا_متابعة: متابعة_فحص_تشغيل = { الكتلة: ك, التعليمة: ت + 1 };
    إذا (*أخفق) { أرجع لا_متابعة; };
    // The operation itself moves to the continuation, as it is.
    انقل_بقية_كتلة_فحص(البرنامج, د, ك, ت, المتابعة.القيمة مثل طبيعي);
    دع نوع_المنطق: معرف_نوع = نوع_بدائي_فحص(نوع_بدائي_مقنن.منطقي());
    دع أ: معرف_قيمة_مسير = ناتج_فحص(أصدر_تحويل_صحيح_مسير(
        البرنامج, &البناء, الدالة, الكتلة, التوسيع, الحساب.اليسار, الواسع
    ), الدالة, أخفق);
    دع ب: معرف_قيمة_مسير = ناتج_فحص(أصدر_تحويل_صحيح_مسير(
        البرنامج, &البناء, الدالة, الكتلة, التوسيع, الحساب.اليمين, الواسع
    ), الدالة, أخفق);
    دع الجداء: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.ضرب_ملتف(), أ, ب, الواسع
    ), الدالة, أخفق);
    دع الأعلى_القيمة: متغير عدد = 0;
    إذا (الوصف.موقع) {
        الأعلى_القيمة := 0 - (أدنى_موقع_فحص(الوصف.البتات) + 1);
    } وإلا {
        الأعلى_القيمة := أعلى_طبيعي_فحص(الوصف.البتات) مثل عدد;
    };
    دع الأعلى: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, ثابت_صحيح_فحص(وصف_الواسع, الأعلى_القيمة), الواسع
    ), الدالة, أخفق);
    دع فوق: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أكبر(), الجداء, الأعلى, نوع_المنطق
    ), الدالة, أخفق);
    إذا (الوصف.موقع) {
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الكتلة, فوق, حافة_فحص(البارد), حافة_فحص(الثانية)
        ), أخفق);
        دع الأدنى: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, الثانية, ثابت_صحيح_فحص(وصف_الواسع, أدنى_موقع_فحص(الوصف.البتات)), الواسع
        ), الدالة, أخفق);
        دع تحت: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الثانية, عملية_مقارنة_صحيح.أصغر(), الجداء, الأدنى, نوع_المنطق
        ), الدالة, أخفق);
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الثانية, تحت, حافة_فحص(البارد), حافة_فحص(المتابعة)
        ), أخفق);
    } وإلا {
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الكتلة, فوق, حافة_فحص(البارد), حافة_فحص(المتابعة)
        ), أخفق);
    };
    // The checked multiply stays, unchanged, at the continuation's head: the
    // test guards it, and proofs that read it still see it.
    دع م: طبيعي = المتابعة.القيمة مثل طبيعي;
    دع التالية: متابعة_فحص_تشغيل = { الكتلة: م, التعليمة: 1 };
    أرجع التالية;
}

// multiply of 64 bits: the wrapping product; operands that both fit in 32
// bits cannot overflow (one test on the hot path), others are tested by
// dividing the product back (a cold path).
عرف افحص_ضربا_عريضا(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    ك: طبيعي,
    ت: طبيعي,
    الحساب: حساب_صحيح_مسير,
    النوع: معرف_نوع,
    الوصف: وصف_صحيح_خفض,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الأصل: طبيعي,
    الإضافات: &متغير متجه اختياري طبيعي,
    أخفق: &متغير منطقي
): متابعة_فحص_تشغيل {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(الدالة, ك);
    دع البناء: حالة_بناء_مسير = بناء_فحص(
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].موقع_التصحيح,
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].نطاق_التصحيح
    );
    دع المتابعة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    دع البطيئة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
    دع القسمة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
    دع السالب: متغير معرف_كتلة_مسير = القسمة;
    دع الحد: متغير معرف_كتلة_مسير = القسمة;
    إذا (الوصف.موقع) {
        السالب := كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
        الحد := كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
    };
    دع البارد: معرف_كتلة_مسير = كتلة_بلاغ_فحص(
        البرنامج, &البناء, الدالة, الأنواع, المبلغ, المكان, صنف_تجاوز_فحص(), الإضافات, أخفق
    );
    دع لا_متابعة: متابعة_فحص_تشغيل = { الكتلة: ك, التعليمة: ت + 1 };
    إذا (*أخفق) { أرجع لا_متابعة; };
    // The checked multiply stays, unchanged, at the continuation's head; the
    // tests use a wrapping copy of it.
    انقل_بقية_كتلة_فحص(البرنامج, د, ك, ت, المتابعة.القيمة مثل طبيعي);
    دع نوع_المنطق: معرف_نوع = نوع_بدائي_فحص(نوع_بدائي_مقنن.منطقي());
    دع أ: معرف_قيمة_مسير = الحساب.اليسار;
    دع ب: معرف_قيمة_مسير = الحساب.اليمين;
    دع الناتج: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.ضرب_ملتف(), أ, ب, النوع
    ), الدالة, أخفق);
    // The hot test: (a | b) below 2^32 unsigned; signed operands are moved
    // by 2^31 first, so both lie in [-2^31, 2^31).
    دع الطبيعي: معرف_نوع = نوع_بدائي_فحص(نوع_بدائي_مقنن.طبيعي());
    دع وصف_الطبيعي: وصف_صحيح_خفض = { موقع: خطأ, البتات: 64 };
    دع المجموع: متغير معرف_قيمة_مسير = أ;
    دع نوع_المجموع: متغير معرف_نوع = النوع;
    إذا (الوصف.موقع) {
        دع أ_ط: معرف_قيمة_مسير = ناتج_فحص(أصدر_تحويل_صحيح_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(), أ, الطبيعي
        ), الدالة, أخفق);
        دع ب_ط: معرف_قيمة_مسير = ناتج_فحص(أصدر_تحويل_صحيح_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_تحويل_صحيح.إعادة_تفسير(), ب, الطبيعي
        ), الدالة, أخفق);
        دع النصف: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, ثابت_صحيح_فحص(وصف_الطبيعي, 2147483648), الطبيعي
        ), الدالة, أخفق);
        دع أ_م: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.جمع_ملتف(), أ_ط, النصف, الطبيعي
        ), الدالة, أخفق);
        دع ب_م: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.جمع_ملتف(), ب_ط, النصف, الطبيعي
        ), الدالة, أخفق);
        المجموع := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_بتي(), أ_م, ب_م, الطبيعي
        ), الدالة, أخفق);
        نوع_المجموع := الطبيعي;
    } وإلا {
        المجموع := ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
            البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.أو_بتي(), أ, ب, النوع
        ), الدالة, أخفق);
    };
    دع الحد_الأعلى: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, ثابت_صحيح_فحص(وصف_الطبيعي, 4294967295), نوع_المجموع
    ), الدالة, أخفق);
    دع كبير: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.أكبر(), المجموع, الحد_الأعلى, نوع_المنطق
    ), الدالة, أخفق);
    منهي_فحص(اختم_بفرع_شرطي_مسير(
        البرنامج, &البناء, الدالة, الكتلة, كبير, حافة_فحص(البطيئة), حافة_فحص(المتابعة)
    ), أخفق);
    // The slow path: a zero operand never overflows.
    دع الصفر: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, &البناء, الدالة, البطيئة, ثابت_صحيح_فحص(الوصف, 0), النوع
    ), الدالة, أخفق);
    دع صفري: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, البطيئة, عملية_مقارنة_صحيح.يساوي(), أ, الصفر, نوع_المنطق
    ), الدالة, أخفق);
    منهي_فحص(اختم_بفرع_شرطي_مسير(
        البرنامج, &البناء, الدالة, البطيئة, صفري, حافة_فحص(المتابعة), حافة_فحص(السالب)
    ), أخفق);
    إذا (الوصف.موقع) {
        // a = -1: the product overflows only for b = the least value (and
        // dividing by -1 would trap).
        دع سالب_واحد: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, السالب, ثابت_صحيح_فحص(الوصف, -1), النوع
        ), الدالة, أخفق);
        دع هو_سالب: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, السالب, عملية_مقارنة_صحيح.يساوي(), أ, سالب_واحد, نوع_المنطق
        ), الدالة, أخفق);
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, السالب, هو_سالب, حافة_فحص(الحد), حافة_فحص(القسمة)
        ), أخفق);
        دع الأدنى: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, الحد, ثابت_صحيح_فحص(الوصف, أدنى_موقع_فحص(64)), النوع
        ), الدالة, أخفق);
        دع هو_الأدنى: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الحد, عملية_مقارنة_صحيح.يساوي(), ب, الأدنى, نوع_المنطق
        ), الدالة, أخفق);
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الحد, هو_الأدنى, حافة_فحص(البارد), حافة_فحص(المتابعة)
        ), أخفق);
    };
    // The product divided by a is b unless it wrapped.
    دع عملية_القسمة: متغير عملية_حساب_صحيح = عملية_حساب_صحيح.قسمة_طبيعية();
    إذا (الوصف.موقع) { عملية_القسمة := عملية_حساب_صحيح.قسمة_موقعة(); };
    دع الحاصل: معرف_قيمة_مسير = ناتج_فحص(أصدر_حسابا_صحيحا_مسير(
        البرنامج, &البناء, الدالة, القسمة, عملية_القسمة, الناتج, أ, النوع
    ), الدالة, أخفق);
    دع مختلف: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, القسمة, عملية_مقارنة_صحيح.لا_يساوي(), الحاصل, ب, نوع_المنطق
    ), الدالة, أخفق);
    منهي_فحص(اختم_بفرع_شرطي_مسير(
        البرنامج, &البناء, الدالة, القسمة, مختلف, حافة_فحص(البارد), حافة_فحص(المتابعة)
    ), أخفق);
    دع التالية: متابعة_فحص_تشغيل = { الكتلة: المتابعة.القيمة مثل طبيعي, التعليمة: 1 };
    أرجع التالية;
}

// division or remainder: by zero, and (signed) the least value by -1, each
// reported before the operation, which stays as it is.
عرف افحص_قسمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    د: طبيعي,
    ك: طبيعي,
    ت: طبيعي,
    الحساب: حساب_صحيح_مسير,
    النوع: معرف_نوع,
    الوصف: وصف_صحيح_خفض,
    المبلغ: &مبلغ_فحص_تشغيل,
    المكان: &مكان_فحص_تشغيل,
    الأصل: طبيعي,
    الإضافات: &متغير متجه اختياري طبيعي,
    أخفق: &متغير منطقي
): متابعة_فحص_تشغيل {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الكتلة: معرف_كتلة_مسير = معرف_كتلة_مسير_من(الدالة, ك);
    دع البناء: حالة_بناء_مسير = بناء_فحص(
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].موقع_التصحيح,
        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ت].نطاق_التصحيح
    );
    دع غير_صفر: متغير معرف_كتلة_مسير = الكتلة;
    إذا (الوصف.موقع) {
        غير_صفر := كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    };
    دع المتابعة: معرف_كتلة_مسير = كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.موجود(الأصل), أخفق);
    دع الحد: متغير معرف_كتلة_مسير = الكتلة;
    إذا (الوصف.موقع) {
        الحد := كتلة_جديدة_فحص(البرنامج, الدالة, الإضافات, اختياري.لا_شيء(), أخفق);
    };
    دع بارد_الصفر: معرف_كتلة_مسير = كتلة_بلاغ_فحص(
        البرنامج, &البناء, الدالة, الأنواع, المبلغ, المكان, صنف_قسمة_فحص(), الإضافات, أخفق
    );
    دع بارد_التجاوز: متغير معرف_كتلة_مسير = بارد_الصفر;
    إذا (الوصف.موقع) {
        بارد_التجاوز := كتلة_بلاغ_فحص(
            البرنامج, &البناء, الدالة, الأنواع, المبلغ, المكان, صنف_تجاوز_فحص(), الإضافات, أخفق
        );
    };
    دع لا_متابعة: متابعة_فحص_تشغيل = { الكتلة: ك, التعليمة: ت + 1 };
    إذا (*أخفق) { أرجع لا_متابعة; };
    // The operation itself moves to the continuation.
    انقل_بقية_كتلة_فحص(البرنامج, د, ك, ت, المتابعة.القيمة مثل طبيعي);
    دع نوع_المنطق: معرف_نوع = نوع_بدائي_فحص(نوع_بدائي_مقنن.منطقي());
    دع أ: معرف_قيمة_مسير = الحساب.اليسار;
    دع ب: معرف_قيمة_مسير = الحساب.اليمين;
    دع الصفر: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
        البرنامج, &البناء, الدالة, الكتلة, ثابت_صحيح_فحص(الوصف, 0), النوع
    ), الدالة, أخفق);
    دع صفري: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
        البرنامج, &البناء, الدالة, الكتلة, عملية_مقارنة_صحيح.يساوي(), ب, الصفر, نوع_المنطق
    ), الدالة, أخفق);
    إذا (الوصف.موقع) {
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الكتلة, صفري, حافة_فحص(بارد_الصفر), حافة_فحص(غير_صفر)
        ), أخفق);
        دع سالب_واحد: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, غير_صفر, ثابت_صحيح_فحص(الوصف, -1), النوع
        ), الدالة, أخفق);
        دع هو_سالب: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, غير_صفر, عملية_مقارنة_صحيح.يساوي(), ب, سالب_واحد, نوع_المنطق
        ), الدالة, أخفق);
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, غير_صفر, هو_سالب, حافة_فحص(الحد), حافة_فحص(المتابعة)
        ), أخفق);
        دع الأدنى: معرف_قيمة_مسير = ناتج_فحص(أصدر_ثابتا_مسير(
            البرنامج, &البناء, الدالة, الحد, ثابت_صحيح_فحص(الوصف, أدنى_موقع_فحص(الوصف.البتات)), النوع
        ), الدالة, أخفق);
        دع هو_الأدنى: معرف_قيمة_مسير = ناتج_فحص(أصدر_مقارنة_صحيح_مسير(
            البرنامج, &البناء, الدالة, الحد, عملية_مقارنة_صحيح.يساوي(), أ, الأدنى, نوع_المنطق
        ), الدالة, أخفق);
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الحد, هو_الأدنى, حافة_فحص(بارد_التجاوز), حافة_فحص(المتابعة)
        ), أخفق);
    } وإلا {
        منهي_فحص(اختم_بفرع_شرطي_مسير(
            البرنامج, &البناء, الدالة, الكتلة, صفري, حافة_فحص(بارد_الصفر), حافة_فحص(المتابعة)
        ), أخفق);
    };
    دع التالية: متابعة_فحص_تشغيل = { الكتلة: المتابعة.القيمة مثل طبيعي, التعليمة: 1 };
    أرجع التالية;
}

// Whether a function holds compile-time work (left as lowered).
عرف دالة_بعمل_وقت_ترجمة_فحص(الدالة: &دالة_مسير): منطقي {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { أرجع صواب; };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

عرف دالة_تساوي_فحص(الحقيقة: اختياري معرف_دالة_مسير, د: طبيعي): منطقي {
    طابق الحقيقة مع
    | اختياري.موجود(ف) -> { أرجع (ف.القيمة مثل طبيعي) == د; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Orders the blocks of a changed function: each original block, then the
// continuations of its path in the order they were made, then the cold
// blocks.
عرف رتب_كتل_فحص(البرنامج: &متغير برنامج_مسير, د: طبيعي, عدد_الأصلية: طبيعي, الإضافات: &متجه اختياري طبيعي): فراغ {
    دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
    دع المسارات: متغير متجه متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأصلية) {
        دع فارغ: متجه طبيعي = [];
        ألحق(المسارات, فارغ);
        ف := ف + 1;
    }
    دع الباردة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(*الإضافات) مثل طبيعي) && عدد_الأصلية + ف < العدد) {
        طابق (*الإضافات)[ف] مع
        | اختياري.موجود(الأصل) -> {
            إذا (الأصل < عدد_الأصلية) { ألحق(المسارات[الأصل], عدد_الأصلية + ف); }
            وإلا { ألحق(الباردة, عدد_الأصلية + ف); };
        }
        | اختياري.لا_شيء -> { ألحق(الباردة, عدد_الأصلية + ف); };
        ف := ف + 1;
    }
    دع الترتيب: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الأصلية) {
        ألحق(الترتيب, ف);
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المسارات[ف]) مثل طبيعي)) { ألحق(الترتيب, المسارات[ف][م]); م := م + 1; }
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(الباردة) مثل طبيعي)) { ألحق(الترتيب, الباردة[ف]); ف := ف + 1; }
    إذا ((الطول(الترتيب) مثل طبيعي) != العدد) { أرجع; };
    دع المواقع: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) { ألحق(المواقع, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < العدد) { المواقع[الترتيب[ف]] := ف; ف := ف + 1; }
    دع معرف_الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع الجديدة: متغير متجه كتلة_مسير = [];
    ف := 0;
    طالما (ف < العدد) {
        دع فارغة_ت: متجه تعليمة_مسير = [];
        دع فارغة_م: متجه قيمة_مسير = [];
        دع المنقولة: متغير كتلة_مسير = {
            المعرف: معرف_كتلة_مسير_من(معرف_الدالة, 0), المعاملات: فارغة_م,
            التعليمات: فارغة_ت, المنهي: اختياري.لا_شيء(),
            موقع_تصحيح_المنهي: مرجع_موقع_تصحيح_مسير_من(اختياري.لا_شيء()),
            نطاق_تصحيح_المنهي: مرجع_نطاق_تصحيح_مسير_من(اختياري.لا_شيء())
        };
        بدّل((*البرنامج).الدوال[د].الكتل[الترتيب[ف]], المنقولة);
        المنقولة.المعرف := معرف_كتلة_مسير_من(معرف_الدالة, ف);
        دع المأخوذ: متغير اختياري منهي_مسير = اختياري.لا_شيء();
        بدّل(المنقولة.المنهي, المأخوذ);
        طابق المأخوذ مع
        | اختياري.موجود(م) -> {
            المنقولة.المنهي := اختياري.موجود(منهي_منقول_بكتل_جديدة(م, &المواقع, معرف_الدالة));
        }
        | اختياري.لا_شيء -> { };
        ألحق(الجديدة, المنقولة);
        ف := ف + 1;
    }
    طابق (*البرنامج).الدوال[د].المدخل مع
    | اختياري.موجود(م) -> {
        (*البرنامج).الدوال[د].المدخل := اختياري.موجود(معرف_كتلة_مسير_من(معرف_الدالة, المواقع[م.القيمة]));
    }
    | اختياري.لا_شيء -> { };
    (*البرنامج).الدوال[د].الكتل := الجديدة;
}

// The checks of function د. صواب when it changed.
عرف أضف_فحوص_دالة_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    خريطة_المصادر: &خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    د: طبيعي,
    المبلغ: &مبلغ_فحص_تشغيل,
    المواقع: &متجه موقع_فحص_تشغيل_مسير,
    مواقع_الدالة: &متجه طبيعي,
    الفهارس: &متغير متجه فهرس_مصدر_موقع,
    الملفات: &متغير متجه ملف_موقع_خفض,
    أخفق: &متغير منطقي
): منطقي {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[د].المعرف;
    دع عدد_الأصلية: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
    دع الإضافات: متغير متجه اختياري طبيعي = [];
    دع تغيرت: متغير منطقي = خطأ;

    // The places lowering gave this function's operations, by result.
    دع مواضع_القيم: متغير متجه اختياري موضع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي)) {
        دع لا_موضع: اختياري موضع = اختياري.لا_شيء();
        ألحق(مواضع_القيم, لا_موضع);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(*مواقع_الدالة) مثل طبيعي)) {
        دع الموقع: موقع_فحص_تشغيل_مسير = (*المواقع)[(*مواقع_الدالة)[ف]];
        دع الموضع: موضع = { المصدر: الموقع.المصدر, البايت: الموقع.البايت };
        طابق الموقع.الكتلة مع
        | اختياري.لا_شيء -> {
            دع ق: طبيعي = الموقع.القيمة.القيمة مثل طبيعي;
            إذا (ق < (الطول(مواضع_القيم) مثل طبيعي)) { مواضع_القيم[ق] := اختياري.موجود(الموضع); };
        }
        | اختياري.موجود(الكتلة) -> {
            // A bounds check: its trap block reports the index and the length.
            دع ك: طبيعي = الكتلة.القيمة مثل طبيعي;
            إذا (ك < عدد_الأصلية && (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي) == 0) {
                دع ينتهي_بفخ: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].المنهي مع
                | اختياري.موجود(منهي_مسير.فخ) -> { ينتهي_بفخ := صواب; }
                | _ -> { };
                إذا (ينتهي_بفخ) {
                    طابق مكان_فحص_عند(البرنامج, خريطة_المصادر, الفهارس, الملفات, الموضع) مع
                    | اختياري.موجود(المكان) -> {
                        دع البناء: حالة_بناء_مسير = بناء_فحص(
                            (*البرنامج).الدوال[د].الكتل[ك].موقع_تصحيح_المنهي,
                            (*البرنامج).الدوال[د].الكتل[ك].نطاق_تصحيح_المنهي
                        );
                        (*البرنامج).الدوال[د].الكتل[ك].المنهي := اختياري.لا_شيء();
                        أصدر_بلاغ_فحص(
                            البرنامج, &البناء, الدالة, الكتلة, الأنواع, المبلغ, &المكان, صنف_فهرس_فحص(),
                            اختياري.موجود(الموقع.القيمة), اختياري.موجود(الموقع.الطول), أخفق
                        );
                        تغيرت := صواب;
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ف := ف + 1;
    }
    إذا (*أخفق) { أرجع تغيرت; };

    // The integer operations, block by block; a split block's path goes on
    // in its continuation.
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الأصلية && !(*أخفق)) {
        دع الحالية: متغير طبيعي = ك;
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[د].الكتل[الحالية].التعليمات) مثل طبيعي) && !(*أخفق)) {
            دع الحساب: متغير اختياري حساب_صحيح_مسير = اختياري.لا_شيء();
            طابق (*البرنامج).الدوال[د].الكتل[الحالية].التعليمات[ت].العملية مع
            | عملية_مسير.حساب_صحيح(ح) -> {
                طابق ح.العملية مع
                | عملية_حساب_صحيح.جمع -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.طرح -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.ضرب -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.قسمة_موقعة -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.قسمة_طبيعية -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.باقي_موقع -> { الحساب := اختياري.موجود(ح); }
                | عملية_حساب_صحيح.باقي_طبيعي -> { الحساب := اختياري.موجود(ح); }
                | _ -> { };
            }
            | _ -> { };
            دع التالية: متغير متابعة_فحص_تشغيل = { الكتلة: الحالية, التعليمة: ت + 1 };
            طابق الحساب مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ح) -> {
                دع ق: طبيعي = (*البرنامج).الدوال[د].الكتل[الحالية].التعليمات[ت].الناتج.القيمة مثل طبيعي;
                دع النوع: متغير اختياري معرف_نوع = اختياري.لا_شيء();
                إذا (ق < (الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي)) {
                    النوع := اختياري.موجود((*البرنامج).الدوال[د].القيم[ق].النوع);
                };
                دع الوصف: متغير اختياري وصف_صحيح_خفض = اختياري.لا_شيء();
                طابق النوع مع
                | اختياري.موجود(ن) -> {
                    طابق وصف_صحيح_للخفض(الأنواع, ن) مع
                    | اختياري.موجود(و) -> {
                        إذا (و.البتات > 0 && و.البتات <= 64) { الوصف := اختياري.موجود(و); };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                // The place: the expression's, else the statement's.
                دع الموضع: متغير اختياري موضع = اختياري.لا_شيء();
                إذا (ق < (الطول(مواضع_القيم) مثل طبيعي)) { الموضع := مواضع_القيم[ق]; };
                طابق الموضع مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    طابق أصل_تعليمة_مسير(البرنامج, &(*البرنامج).الدوال[د].الكتل[الحالية].التعليمات[ت]) مع
                    | اختياري.موجود(الأصل) -> {
                        طابق أصل_مصدر_بالمعرف(الأصول, الأصل) مع
                        | اختياري.موجود(السجل) -> { الموضع := اختياري.موجود(السجل.النطاق.البداية); }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
                دع المكان: متغير اختياري مكان_فحص_تشغيل = اختياري.لا_شيء();
                طابق الموضع مع
                | اختياري.موجود(م) -> {
                    طابق الوصف مع
                    | اختياري.موجود(_) -> { المكان := مكان_فحص_عند(البرنامج, خريطة_المصادر, الفهارس, الملفات, م); }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
                طابق المكان مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(المكان_المعروف) -> {
                    دع بلا_وصف: وصف_صحيح_خفض = { موقع: خطأ, البتات: 64 };
                    دع و: متغير وصف_صحيح_خفض = بلا_وصف;
                    دع ن: معرف_نوع;
                    طابق الوصف مع
                    | اختياري.موجود(قيمة_الوصف) -> { و := قيمة_الوصف; }
                    | اختياري.لا_شيء -> { };
                    طابق النوع مع
                    | اختياري.موجود(قيمة_النوع) -> { ن := قيمة_النوع; }
                    | اختياري.لا_شيء -> { ن := نوع_بدائي_فحص(نوع_بدائي_مقنن.عدد()); };
                    طابق ح.العملية مع
                    | عملية_حساب_صحيح.ضرب -> {
                        إذا (و.البتات <= 32) {
                            التالية := افحص_ضربا_ضيقا(
                                البرنامج, الأنواع, د, الحالية, ت, ح, و, المبلغ, &المكان_المعروف, ك, &متغير الإضافات, أخفق
                            );
                        } وإلا {
                            التالية := افحص_ضربا_عريضا(
                                البرنامج, الأنواع, د, الحالية, ت, ح, ن, و, المبلغ, &المكان_المعروف, ك, &متغير الإضافات, أخفق
                            );
                        };
                    }
                    | عملية_حساب_صحيح.جمع -> {
                        التالية := افحص_جمعا_أو_طرحا(
                            البرنامج, الأنواع, د, الحالية, ت, ح, صواب, ن, و, المبلغ, &المكان_المعروف, ك, &متغير الإضافات, أخفق
                        );
                    }
                    | عملية_حساب_صحيح.طرح -> {
                        التالية := افحص_جمعا_أو_طرحا(
                            البرنامج, الأنواع, د, الحالية, ت, ح, خطأ, ن, و, المبلغ, &المكان_المعروف, ك, &متغير الإضافات, أخفق
                        );
                    }
                    | _ -> {
                        التالية := افحص_قسمة(
                            البرنامج, الأنواع, د, الحالية, ت, ح, ن, و, المبلغ, &المكان_المعروف, ك, &متغير الإضافات, أخفق
                        );
                    };
                    تغيرت := صواب;
                };
            };
            الحالية := التالية.الكتلة;
            ت := التالية.التعليمة;
        }
        ك := ك + 1;
    }
    إذا (تغيرت && !(*أخفق)) { رتب_كتل_فحص(البرنامج, د, عدد_الأصلية, &الإضافات); };
    أرجع تغيرت;
}

// The pass, over the functions the request keeps (msir_optimization_pipeline.sn,
// دوال_محسنة_مسير). Without std's report it changes nothing.
عام عرف أضف_فحوص_التشغيل_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    خريطة_المصادر: &خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    النطاق: نطاق_تحسين_مسير
): نتيجة_فحوص_تشغيل_مسير {
    دع عدد_الدوال: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع المتغيرة: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الدوال) { ألحق(المتغيرة, خطأ); ف := ف + 1; }
    // The places are read once, here.
    دع المواقع: متغير متجه موقع_فحص_تشغيل_مسير = [];
    بدّل((*البرنامج).مواقع_فحوص_التشغيل, المواقع);
    دع المبلغ: مبلغ_فحص_تشغيل;
    طابق مبلغ_فحص_للبرنامج(البرنامج) مع
    | اختياري.موجود(م) -> { المبلغ := م; }
    | اختياري.لا_شيء -> { أرجع نتيجة_فحوص_تشغيل_مسير.أضيفت(المتغيرة); };
    دع المختارة: متجه منطقي = دوال_محسنة_مسير(البرنامج, النطاق);
    // The places by function.
    دع مواقع_الدوال: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_الدوال) {
        دع فارغ: متجه طبيعي = [];
        ألحق(مواقع_الدوال, فارغ);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(المواقع) مثل طبيعي)) {
        دع د: طبيعي = المواقع[ف].الدالة.القيمة مثل طبيعي;
        إذا (د < عدد_الدوال) { ألحق(مواقع_الدوال[د], ف); };
        ف := ف + 1;
    }
    دع الفهارس: متغير متجه فهرس_مصدر_موقع = [];
    دع الملفات: متغير متجه ملف_موقع_خفض = [];
    دع أخفق: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < عدد_الدوال) {
        دع مختارة: منطقي = د < (الطول(المختارة) مثل طبيعي) && المختارة[د];
        دع مستثناة: منطقي = (المبلغ.الدالة.القيمة مثل طبيعي) == د
            || دالة_تساوي_فحص((*البرنامج).دالة_تهيئة_الوحدة, د)
            || دالة_تساوي_فحص((*البرنامج).دالة_تبديل_سياق_المهام, د)
            || ((*البرنامج).الدوال[د].المعرف.القيمة مثل طبيعي) != د;
        إذا (مختارة && !مستثناة && !دالة_بعمل_وقت_ترجمة_فحص(&(*البرنامج).الدوال[د])) {
            إذا (أضف_فحوص_دالة_مسير(
                البرنامج, الأنواع, خريطة_المصادر, الأصول, د, &المبلغ, &المواقع, &مواقع_الدوال[د],
                &متغير الفهارس, &متغير الملفات, &متغير أخفق
            )) {
                المتغيرة[د] := صواب;
            };
            إذا (أخفق) { أرجع نتيجة_فحوص_تشغيل_مسير.أخفقت(); };
        };
        د := د + 1;
    }
    أرجع نتيجة_فحوص_تشغيل_مسير.أضيفت(المتغيرة);
}
