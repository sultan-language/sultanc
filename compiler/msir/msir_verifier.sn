عرف تحقق_تخزين_مسير(
    العملية: تخزين_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    تحقق_تعليمة_بلا_ناتج_مسير(التعليمة, الموضع, الأخطاء);
    دع المكان: اختيار قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    لو (!هل_مكان_قابل_للكتابة_لمسير(الدالة, العملية.المكان, الأنواع, فهرس_التعريفات)) {
        طابق المكان مع
        | اختيار.بعض(قيمة_المكان) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, قيمة_المكان.النوع));
        }
        | اختيار.لا_شيء -> { };
    };
    طابق المكان مع
    | اختيار.بعض(قيمة_المكان) -> {
        طابق القيمة مع
        | اختيار.بعض(القيمة_المخزنة) -> {
            لو (!معرفا_نوع_متساويان(قيمة_المكان.النوع, القيمة_المخزنة.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, القيمة_المخزنة.النوع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مكان_إلى_مرجع_مسير(
    العملية: مكان_إلى_مرجع_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المكان: اختيار قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المكان مع
    | اختيار.بعض(قيمة_المكان) -> {
        طابق الناتج مع
        | اختيار.بعض(قيمة_الناتج) -> {
            طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_الناتج.النوع) مع
            | اختيار.بعض(الداخل) -> {
                لو (!معرفا_نوع_متساويان(الداخل, قيمة_المكان.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مرجع_غير_مطابق(الموضع, قيمة_المكان.النوع, الداخل));
                };
                لو (هل_مرجع_متغير_لمسير(الأنواع, قيمة_الناتج.النوع) && !هل_مكان_قابل_للكتابة_لمسير(
                    الدالة,
                    العملية.المكان,
                    الأنواع,
                فهرس_التعريفات)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_موسوم_مسير(
    العملية: &بناء_موسوم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(قيمة_الناتج) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة_الناتج.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع));
            أرجع خطأ;
        };
        دع حالة_العملية: بناء_موسوم_مسير = *العملية;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع, حالة_العملية.المنشئ));
        }
        | اختيار.بعض(المتوقع) -> {
            دع الفعلي: غير_موقع = الطول(حالة_العملية.الحمولات) مثل غير_موقع;
            لو (المتوقع != الفعلي) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حمولات_غير_مطابق(الموضع, المتوقع, الفعلي));
            };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < الفعلي) {
                دع الحمولة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                    الدالة,
                    حالة_العملية.الحمولات[ف],
                    الموضع.الكتلة,
                    الموضع.الفهرس,
                    الأخطاء,
                فهرس_التعريفات, تحليل_الهيمنة);
                لو (ف < المتوقع) {
                    طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ, ف) مع
                    | اختيار.بعض(نوع_متوقع) -> {
                        طابق الحمولة مع
                        | اختيار.بعض(قيمة) -> {
                            لو (!معرفا_نوع_متساويان(قيمة.النوع, نوع_متوقع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(الموضع, ف, نوع_متوقع, قيمة.النوع)
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
                ف := ف + 1;
            }
        };
        أرجع صواب;
    };
}

عرف تحقق_استعلام_وسم_مسير(
    العملية: استعلام_وسم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    طابق المصدر مع
    | اختيار.بعض(قيمة) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    طابق نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء) مع
    | اختيار.بعض(قيمة) -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ32()) مع
        | اختيار.بعض(المتوقع) -> {
            لو (!معرفا_نوع_متساويان(قيمة.النوع, المتوقع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
            };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_استخراج_حمولة_مسير(
    العملية: استخراج_حمولة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(قيمة_المصدر) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة_المصدر.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_المصدر.النوع));
        } وإلا {
            طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_المصدر.النوع, العملية.المنشئ) مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(
                        الموضع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ
                    )
                );
            }
            | اختيار.بعض(عدد_الحمولات) -> {
                لو (العملية.الحمولة >= عدد_الحمولات) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                            الموضع,
                            قيمة_المصدر.النوع,
                            العملية.المنشئ,
                            العملية.الحمولة
                        )
                    );
                } وإلا {
                    طابق نوع_حمولة_منشئ_دلالي_عند(
                        الأنواع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ,
                        العملية.الحمولة
                    ) مع
                    | اختيار.بعض(المتوقع) -> {
                        طابق الناتج مع
                        | اختيار.بعض(قيمة_الناتج) -> {
                            لو (!معرفا_نوع_متساويان(المتوقع, قيمة_الناتج.النوع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(
                                        الموضع,
                                        العملية.الحمولة,
                                        المتوقع,
                                        قيمة_الناتج.النوع
                                    )
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                                الموضع,
                                قيمة_المصدر.النوع,
                                العملية.المنشئ,
                                العملية.الحمولة
                            )
                        );
                    };
                };
            };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_صندوق_مسير(
    العملية: بناء_صندوق_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.بعض(قيمة_الناتج) -> {
        طابق نوع_داخل_صندوق_لمسير(الأنواع, قيمة_الناتج.النوع) مع
        | اختيار.بعض(المتوقع) -> {
            طابق القيمة مع
            | اختيار.بعض(قيمة_المصدر) -> {
                لو (!معرفا_نوع_متساويان(المتوقع, قيمة_المصدر.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_إغلاق_مسير(
    البرنامج: &برنامج_مسير,
    العملية: &بناء_إغلاق_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع البناء: بناء_إغلاق_مسير = *العملية;
    نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    لو (!دالة_مسير_موجودة(البرنامج, البناء.الدالة)) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.هدف_نداء_غير_صالح(الموضع, البناء.الدالة));
        أرجع خطأ;
    };
    دع الهدف: &دالة_مسير = &(*البرنامج).الدوال[البناء.الدالة.القيمة];
    دع المتوقع: غير_موقع = عدد_التقاطات_دالة_مسير(الهدف);
    دع الموجود: غير_موقع = الطول(البناء.الالتقاطات) مثل غير_موقع;
    لو (المتوقع != الموجود) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الموجود));
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الموجود) {
        دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة, البناء.الالتقاطات[ف], الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        لو (ف < المتوقع) {
            طابق القيمة مع
            | اختيار.بعض(ق) -> {
                طابق نوع_التقاط_دالة_مسير_عند(الهدف, ف) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(نوع_متوقع) -> {
                    لو (!معرفا_نوع_متساويان(ق.النوع, نوع_متوقع)) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                            الموضع, ف, نوع_متوقع, ق.النوع
                        ));
                    };
                };
            }
            | اختيار.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف تحقق_استخراج_التقاط_مسير(
    العملية: استخراج_التقاط_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    دع عدد_الالتقاطات: غير_موقع = عدد_التقاطات_دالة_مسير(الدالة);
    لو (العملية.الفهرس >= عدد_الالتقاطات) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(
            الموضع, عدد_الالتقاطات, العملية.الفهرس + 1
        ));
        أرجع خطأ;
    };
    طابق الناتج مع
    | اختيار.بعض(ق) -> {
        طابق نوع_التقاط_دالة_مسير_عند(الدالة, العملية.الفهرس) مع
        | اختيار.بعض(المتوقع) -> {
            لو (!معرفا_نوع_متساويان(المتوقع, ق.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                    الموضع, العملية.الفهرس, المتوقع, ق.النوع
                ));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_حجج_نداء_هيكليا(
    النداء: &نداء_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_النداء.الحجج) مثل غير_موقع)) {
        تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        ف := ف + 1;
    }
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(المكان) -> {
        تحقق_استخدام_مكان_مسير(
            الدالة, المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_نداء_دالة_سلطان_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };
    لو (!دالة_مسير_موجودة(البرنامج, الهدف_معرف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
        أرجع خطأ;
    };

    دع مرجع_الهدف: &دالة_مسير = &(*البرنامج).الدوال[الهدف_معرف.القيمة];
    دع المتوقع: غير_موقع = الطول((*مرجع_الهدف).المعاملات) مثل غير_موقع;
    دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
    لو (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
        );
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الفعلي) {
        دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        لو (ف < المتوقع) {
            طابق الحجة مع
            | اختيار.بعض(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = (*مرجع_الهدف).المعاملات[ف].النوع;
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                            الموضع,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }

    دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
    طابق (*مرجع_الهدف).الناتج مع
    | اختيار.لا_شيء -> {
        طابق حالة_التعليمة.الناتج مع
        | اختيار.بعض(_) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختيار.لا_شيء -> {
        };
    }
    | اختيار.بعض(نوع_المتوقع) -> {
        طابق حالة_التعليمة.الناتج مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختيار.بعض(القيمة) -> {
            لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                        الموضع,
                        نوع_المتوقع,
                        القيمة.النوع
                    )
                );
            };
        };
    };
    أرجع صواب;
}


عرف تحقق_نداء_دالة_خارجية_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_خارجية_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };
    طابق دالة_خارجية_مسير_عند(البرنامج, الهدف_معرف) مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_خارجي_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
        أرجع خطأ;
    }
    | اختيار.بعض(الهدف) -> {
        دع المتوقع: غير_موقع = الطول(الهدف.المعاملات) مثل غير_موقع;
        دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الفعلي) {
            دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة,
                حالة_النداء.الحجج[ف],
                الموضع.الكتلة,
                الموضع.الفهرس,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            لو (ف < المتوقع) {
                طابق الحجة مع
                | اختيار.بعض(القيمة) -> {
                    دع نوع_المتوقع: معرف_نوع = الهدف.المعاملات[ف];
                    لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, القيمة.النوع
                            )
                        );
                    };
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق الهدف.الناتج مع
        | اختيار.لا_شيء -> {
            طابق حالة_التعليمة.الناتج مع
            | اختيار.بعض(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.بعض(نوع_المتوقع) -> {
            طابق حالة_التعليمة.الناتج مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختيار.بعض(القيمة) -> {
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_المتوقع, القيمة.النوع
                        )
                    );
                };
            };
        };
        أرجع صواب;
    };
}

عرف هل_نوع_فراغ_لتحقق_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف تحقق_نداء_قيمة_دالة_مسير(
    النداء: &نداء_مسير,
    الدالة_القيمة: معرف_قيمة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الحالة: نداء_مسير = *النداء;
    طابق الحالة.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };

    دع الدالة_المتحققة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, الدالة_القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع نوع_الدالة: متغير اختيار معرف_نوع = اختيار.لا_شيء();
    طابق الدالة_المتحققة مع
    | اختيار.بعض(القيمة) -> {
        طابق عدد_معاملات_دالة_دلالية(الأنواع, القيمة.النوع) مع
        | اختيار.بعض(_) -> { نوع_الدالة := اختيار.بعض(القيمة.النوع); }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(الدالة_القيمة, القيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };

    تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    طابق نوع_الدالة مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(نوع_الدالة_المقنن) -> {
        دع المتوقع: متغير غير_موقع = 0;
        طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة_المقنن) مع
        | اختيار.بعض(العدد) -> { المتوقع := العدد; }
        | اختيار.لا_شيء -> { };
        دع الفعلي: غير_موقع = الطول(الحالة.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي));
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الفعلي) {
            لو (ف < المتوقع) {
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة_المقنن, ف) مع
                | اختيار.بعض(نوع_المتوقع) -> {
                    طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, الحالة.الحجج[ف]) مع
                    | اختيار.بعض(التعريف) -> {
                        لو (!معرفا_نوع_متساويان(نوع_المتوقع, التعريف.القيمة.النوع)) {
                            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, التعريف.القيمة.النوع
                            ));
                        };
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة_المقنن) مع
        | اختيار.بعض(نوع_الناتج) -> {
            دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
            لو (هل_نوع_فراغ_لتحقق_مسير(الأنواع, نوع_الناتج)) {
                طابق حالة_التعليمة.الناتج مع
                | اختيار.بعض(_) -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); }
                | اختيار.لا_شيء -> { };
            } وإلا {
                طابق حالة_التعليمة.الناتج مع
                | اختيار.بعض(القيمة) -> {
                    لو (!معرفا_نوع_متساويان(نوع_الناتج, القيمة.النوع)) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_الناتج, القيمة.النوع
                        ));
                    };
                }
                | اختيار.لا_شيء -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); };
            };
        }
        | اختيار.لا_شيء -> { };
        أرجع صواب;
    };
}

// Semantic memory annotations are not machine ABI arguments. They must name
// typed pointer operands, a live provenance reference and a typed extent.
// Scalar extents use literal bounds. Indexed byte vectors must prove the
// same root, index and runtime length through their MSIR definitions. Numeric
// lengths without storage provenance are never trusted.
عرف طول_نطاق_ذاكرة_ثابت_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار غير_موقع {
    // Implicitly converted zero constants remain zero under any integer
    // conversion. Do not generally fold nonzero integer casts here: a narrow
    // conversion can truncate and must not forge a larger memory capacity.
    دع الحالي: متغير معرف_قيمة_مسير = المعرف;
    دع تحويلات: متغير غير_موقع = 0;
    بينما (تحويلات < (الطول((*الدالة).القيم) مثل غير_موقع)) {
        تحويلات := تحويلات + 1;
        طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, الحالي) مع
        | اختيار.بعض(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                    أرجع اختيار.لا_شيء();
                };
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                    أرجع اختيار.لا_شيء();
                };
                طابق (*التعليمات)[الفهرس].العملية مع
                | عملية_مسير.ثابت(الثابت) -> {
                    طابق الثابت مع
                    | ثابت_مسير.صحيح_غير_موقع(الحجم) -> {
                        لو (تحويلات == 1 || الحجم == 0) {
                            أرجع اختيار.بعض(الحجم);
                        };
                    }
                    | _ -> { };
                    أرجع اختيار.لا_شيء();
                }
                | عملية_مسير.تحويل_صحيح(التحويل) -> {
                    الحالي := التحويل.المصدر;
                }
                | _ -> { أرجع اختيار.لا_شيء(); };
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    }
    أرجع اختيار.لا_شيء();
}

// A dynamic byte extent is accepted only when its SSA definition is exactly
// `length(the source byte vector) - the index used by this very borrow`.
// The runtime memory owner must still validate the live allocation and range.
عرف عملية_تعريف_طول_نطاق_نداء(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار عملية_مسير {
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المعرف) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
            لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            دع مرجع_القيمة_المعادة_2939: &عملية_مسير = &(*التعليمات)[الفهرس].العملية;
            دع القيمة_المعادة_2939: عملية_مسير = *مرجع_القيمة_المعادة_2939;
            أرجع اختيار.بعض(القيمة_المعادة_2939);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف أصل_إعادة_تفسير_طول_نداء(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    القيمة: معرف_قيمة_مسير
