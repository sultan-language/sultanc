    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, القيمة) مع
    | اختيار.بعض(عملية_مسير.تحويل_صحيح(التحويل)) -> {
        طابق التحويل.العملية مع
        | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع اختيار.بعض(التحويل.المصدر); }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

