عرف تحقق_مقارنة_صحيح_مسير(
    المقارنة: مقارنة_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع اليسار: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        المقارنة.اليسار,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع اليمين: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        المقارنة.اليمين,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    طابق اليسار مع
    | اختياري.موجود(أ) -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختياري.لا_شيء -> {
            طابق معرف_نوع_أساس_عند(الأنواع, أ.النوع) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء,
                    خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
            }
            | اختياري.موجود(مرجع_النوع_36) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_36.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> {
                إذا (المقارنة.العملية != عملية_مقارنة_صحيح.يساوي()
                    && المقارنة.العملية != عملية_مقارنة_صحيح.لا_يساوي()) {
                    سجل_خطأ_مسير(الأخطاء,
                        خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
                };
            }
                | _ -> {
                سجل_خطأ_مسير(الأخطاء,
                    خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
            };
            };
        }
        | اختياري.موجود(_) -> { };
        طابق اليمين مع
        | اختياري.موجود(ب) -> {
            إذا (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع)
                );
            };
        }
        | اختياري.لا_شيء -> {
        };
    }
    | اختياري.لا_شيء -> {
    };
    طابق اليمين مع
    | اختياري.موجود(ب) -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختياري.لا_شيء -> {
            طابق معرف_نوع_أساس_عند(الأنواع, ب.النوع) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء,
                    خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
            }
            | اختياري.موجود(مرجع_النوع_37) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_37.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> {
                إذا (المقارنة.العملية != عملية_مقارنة_صحيح.يساوي()
                    && المقارنة.العملية != عملية_مقارنة_صحيح.لا_يساوي()) {
                    سجل_خطأ_مسير(الأخطاء,
                        خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
                };
            }
                | _ -> {
                سجل_خطأ_مسير(الأخطاء,
                    خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
            };
            };
        }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> {
    };
    طابق نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء) مع
    | اختياري.موجود(الناتج) -> {
        إذا (!هل_نوع_مسير_منطقي(الأنواع, الناتج.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_ناتج_مقارنة_غير_منطقي(الموضع, الناتج.النوع)
            );
        };
    }
    | اختياري.لا_شيء -> {
    };
    أرجع صواب;
}

عرف تحويل_صحيح_مسموح_لمسير(
    العملية: عملية_تحويل_صحيح,
    المصدر: وصف_صحيح_مسير,
    الهدف: وصف_صحيح_مسير
): منطقي {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        طابق المصدر.الإشارة مع
        | إشارة_صحيح_مسير.موقع -> {
            // Sign extension is a width transformation; the result Type owns its interpretation.
            أرجع المصدر.البتات < الهدف.البتات;
        }
        | إشارة_صحيح_مسير.طبيعي -> {
            أرجع خطأ;
        };
    }
    | عملية_تحويل_صحيح.توسيع_صفري -> {
        طابق المصدر.الإشارة مع
        | إشارة_صحيح_مسير.طبيعي -> {
            // Zero extension is a width transformation; the result Type owns its interpretation.
            أرجع المصدر.البتات < الهدف.البتات;
        }
        | إشارة_صحيح_مسير.موقع -> {
            أرجع خطأ;
        };
    }
    | عملية_تحويل_صحيح.اقتطاع -> {
        // Truncation preserves low bits; the result Type owns signed/unsigned interpretation.
        أرجع المصدر.البتات > الهدف.البتات;
    }
    | عملية_تحويل_صحيح.إعادة_تفسير -> {
        // Same-width conversion preserves bits; the result Type owns interpretation.
        أرجع المصدر.البتات == الهدف.البتات;
    };
}

عرف تحقق_تحويل_صحيح_مسير(
    التحويل: تحويل_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        التحويل.المصدر,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختياري.موجود(أ) -> {
        طابق الناتج مع
        | اختياري.موجود(ب) -> {
            دع وصف_أ: اختياري وصف_صحيح_مسير = وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, أ.النوع);
            دع وصف_ب: متغير اختياري وصف_صحيح_مسير = وصف_صحيح_لمسير(الأنواع, ب.النوع);
            // `char` is a target only for zero-extending an 8-bit unsigned value
            // (`u8 as char`): every byte value is a Unicode scalar.
            طابق وصف_ب مع
            | اختياري.لا_شيء -> {
                طابق التحويل.العملية مع
                | عملية_تحويل_صحيح.توسيع_صفري -> {
                    طابق وصف_أ مع
                    | اختياري.موجود(وصف_المصدر_البايت) -> {
                        إذا (وصف_المصدر_البايت.البتات == 8) {
                            وصف_ب := وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, ب.النوع);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | _ -> { };
            }
            | اختياري.موجود(_) -> { };
            طابق وصف_أ مع
            | اختياري.موجود(س) -> {
                طابق وصف_ب مع
                | اختياري.موجود(ه) -> {
                    إذا (!تحويل_صحيح_مسموح_لمسير(التحويل.العملية, س, ه)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                        );
                    };
                }
                | اختياري.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                    );
                };
            }
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                );
            };
        }
        | اختياري.لا_شيء -> {
        };
    }
    | اختياري.لا_شيء -> {
    };
    أرجع صواب;
}

// A float conversion's source and result Types follow its operation: a float
// and an integer of the stated signedness, or two floats.
عرف تحقق_تحويل_عائم_مسير(
    التحويل: تحويل_عائم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, التحويل.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    دع أ: قيمة_مسير;
    طابق المصدر مع | اختياري.موجود(ق) -> { أ := ق; } | اختياري.لا_شيء -> { أرجع صواب; };
    دع ب: قيمة_مسير;
    طابق الناتج مع | اختياري.موجود(ق) -> { ب := ق; } | اختياري.لا_شيء -> { أرجع صواب; };
    دع صالح: متغير منطقي = خطأ;
    طابق التحويل.العملية مع
    | عملية_تحويل_عائم.عائم_إلى_موقع -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختياري.موجود(الوصف) -> {
            صالح := هل_نوع_مسير_عشري(الأنواع, أ.النوع) && الوصف.الإشارة == إشارة_صحيح_مسير.موقع();
        }
        | اختياري.لا_شيء -> { };
    }
    | عملية_تحويل_عائم.عائم_إلى_طبيعي -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختياري.موجود(الوصف) -> {
            صالح := هل_نوع_مسير_عشري(الأنواع, أ.النوع) && الوصف.الإشارة == إشارة_صحيح_مسير.طبيعي();
        }
        | اختياري.لا_شيء -> { };
    }
    | عملية_تحويل_عائم.موقع_إلى_عائم -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختياري.موجود(الوصف) -> {
            صالح := هل_نوع_مسير_عشري(الأنواع, ب.النوع) && الوصف.الإشارة == إشارة_صحيح_مسير.موقع();
        }
        | اختياري.لا_شيء -> { };
    }
    | عملية_تحويل_عائم.طبيعي_إلى_عائم -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختياري.موجود(الوصف) -> {
            صالح := هل_نوع_مسير_عشري(الأنواع, ب.النوع) && الوصف.الإشارة == إشارة_صحيح_مسير.طبيعي();
        }
        | اختياري.لا_شيء -> { };
    }
    | عملية_تحويل_عائم.عائم_إلى_عائم -> {
        صالح := هل_نوع_مسير_عشري(الأنواع, أ.النوع) && هل_نوع_مسير_عشري(الأنواع, ب.النوع);
    };
    إذا (!صالح) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع));
    };
    أرجع صواب;
}

عرف تحقق_تعليمة_بلا_ناتج_مسير(
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    إذا (!للتعليمة_ناتج_مسير(التعليمة)) { أرجع صواب; };
    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تعليمة_بناتج_غير_متوقع(الموضع));
    أرجع خطأ;
}

عرف نوع_حقل_دلالي_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الفهرس: طبيعي
): اختياري معرف_نوع {
    طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, الفهرس) مع
    | اختياري.موجود(الموجود) -> {
        أرجع اختياري.موجود(الموجود);
    }
    | اختياري.لا_شيء -> { };
    أرجع نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, الفهرس);
}

// The element Type an index of a value of النوع names, for an index read
// (استخراج_فهرس) and an index place (مكان_فهرس) alike: a vector's or a
// slice's element, and for text its UTF-8 bytes (ط8; text has the byte
// vector's layout). Nothing for any other Type.
عرف نوع_عنصر_فهرسة_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> {
        أرجع اختياري.موجود(الداخل);
    }
    | اختياري.لا_شيء -> { };
    إذا (هل_نوع_نص_لمسير(الأنواع, النوع)) {
        أرجع معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط8());
    };
    أرجع نوع_عنصر_شريحة_دلالي(الأنواع, النوع);
}

عرف هل_نوع_بدائي_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == المتوقع;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف هل_نوع_نص_لمسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_لمسير(الأنواع, النوع, نوع_بدائي_مقنن.نص());
}

عرف نوع_داخل_مرجع_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(الداخل) -> {
        أرجع اختياري.موجود(الداخل);
    }
    | اختياري.لا_شيء -> {
        أرجع نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع);
    };
}

عرف هل_مرجع_متغير_لمسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختياري.موجود(_) -> {
        أرجع صواب;
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عام عرف هل_نوع_عنوان_صحيح_لمسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ط64 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص64 -> { أرجع صواب; }
            // `0 as *T` (a C NULL): an untyped literal is عدد.
            | نوع_بدائي_مقنن.عدد -> { أرجع صواب; }
            | نوع_بدائي_مقنن.طبيعي -> { أرجع صواب; }
            // The address word of a 32-bit target (`p as u32`).
            | نوع_بدائي_مقنن.ط32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص32 -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف نوع_قيمة_عنصر_مؤشر_لمسير(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): اختياري معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            إذا ((نوع_العنصر.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            دع مرجع_النوع: &نوع_مقنن = &(*الأنواع).الأنواع[نوع_العنصر.القيمة];
            دع نوع_العنصر_المقنن: نوع_مقنن = *مرجع_النوع;
            طابق نوع_العنصر_المقنن مع
            | نوع_مقنن.متغير(الداخل) -> { أرجع اختياري.موجود(الداخل); }
            | _ -> { أرجع اختياري.موجود(نوع_العنصر); };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف هل_عنصر_مؤشر_قابل_للكتابة_لمسير(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأساس) -> {
        طابق (*الأنواع).الأنواع[الأساس.القيمة] مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            إذا ((نوع_العنصر.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) {
                أرجع خطأ;
            };
            دع مرجع_النوع: &نوع_مقنن = &(*الأنواع).الأنواع[نوع_العنصر.القيمة];
            دع نوع_العنصر_المقنن: نوع_مقنن = *مرجع_النوع;
            طابق نوع_العنصر_المقنن مع
            | نوع_مقنن.متغير(_) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف نوع_داخل_صندوق_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختياري معرف_نوع {
    أرجع نوع_حمولة_صندوق_دلالي(الأنواع, النوع);
}

عرف هل_مكان_قابل_للكتابة_لمسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الأنواع: &سجل_أنواع,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير
): منطقي {
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                أرجع خطأ;
            };
            دع حالة_الكتلة: &كتلة_مسير = &(*الدالة).الكتل[الكتلة.القيمة];
            إذا (الفهرس >= (الطول((*حالة_الكتلة).التعليمات) مثل طبيعي)) {
                أرجع خطأ;
            };
            طابق (*حالة_الكتلة).التعليمات[الفهرس].العملية مع
            | عملية_مسير.مكان_محلي(المكان) -> {
                أرجع المكان.قابل_للكتابة;
            }
            | عملية_مسير.مكان_عام(المكان) -> {
                أرجع المكان.قابل_للكتابة;
            }
            | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
                طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, العملية.المرجع) مع
                | اختياري.موجود(تعريف_المرجع) -> {
                    أرجع هل_مرجع_متغير_لمسير(الأنواع, تعريف_المرجع.القيمة.النوع);
                }
                | اختياري.لا_شيء -> {
                    أرجع خطأ;
                };
            }
            | عملية_مسير.صندوق_إلى_مكان(_) -> {
                أرجع صواب;
            }
            | عملية_مسير.مكان_حقل(العملية) -> {
                أرجع هل_مكان_قابل_للكتابة_لمسير(الدالة, العملية.الأصل, الأنواع, فهرس_التعريفات);
            }
            | عملية_مسير.مكان_فهرس(العملية) -> {
                أرجع هل_مكان_قابل_للكتابة_لمسير(الدالة, العملية.الأصل, الأنواع, فهرس_التعريفات);
            }
            | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
                طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, العملية.المؤشر) مع
                | اختياري.موجود(تعريف_المؤشر) -> {
                    أرجع هل_عنصر_مؤشر_قابل_للكتابة_لمسير(
                        الأنواع, تعريف_المؤشر.القيمة.النوع
                    );
                }
                | اختياري.لا_شيء -> { أرجع خطأ; };
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف تحقق_أعضاء_تجميع_مسير(
    الأعضاء: &متجه معرف_قيمة_مسير,
    العدد: طبيعي,
    النوع_المتوقع: &متجه معرف_نوع,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع أعضاء_القيم: متجه معرف_قيمة_مسير = *الأعضاء;
    دع المتوقعات: متجه معرف_نوع = *النوع_المتوقع;
    دع صالح: متغير منطقي = صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق تحقق_استخدام_قيمة_مسير(
            الدالة,
            أعضاء_القيم[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة) مع
        | اختياري.موجود(القيمة) -> {
            إذا (ف < (الطول(المتوقعات) مثل طبيعي)) {
                دع المتوقع: معرف_نوع = المتوقعات[ف];
                إذا (!معرفا_نوع_متساويان(القيمة.النوع, المتوقع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.عضو_تجميع_غير_مطابق(
                            الموضع,
                            ف,
                            المتوقع,
                            القيمة.النوع
                        )
                    );
                    صالح := خطأ;
                };
            };
        }
        | اختياري.لا_شيء -> {
            صالح := خطأ;
        };
        ف := ف + 1;
    }
    أرجع صالح;
}

عرف تحقق_نقل_تسلسل_مملوك_مسير(
    النقل: نقل_تسلسل_مملوك_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, النقل.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة
    );
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختياري.موجود(قيمة_المصدر) -> {
        طابق الناتج مع
        | اختياري.موجود(قيمة_الناتج) -> {
            // Byte vector to text, or back (drop glue releases a text buffer
            // as a byte vector).
            // A vector viewed as a slice of the same elements.
            إذا (!هل_نقل_متجه_بايتات_إلى_نص(الأنواع, قيمة_المصدر.النوع, قيمة_الناتج.النوع)
                && !هل_نقل_متجه_بايتات_إلى_نص(الأنواع, قيمة_الناتج.النوع, قيمة_المصدر.النوع)
                && !هل_عرض_متجه_كشريحة(الأنواع, قيمة_المصدر.النوع, قيمة_الناتج.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نقل_تسلسل_مملوك_غير_صالح(
                    الموضع, قيمة_المصدر.النوع, قيمة_الناتج.النوع
                ));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

// A raw pointer read as a reference to the same address (`p as &T`): the one
// conversion the frontend gates behind unsafe (صنف_تحويل_بين's
// يتطلب_غير_آمن class). The one rule lowering emits the reinterpretation by
// (اخفض_تحويل_مؤشر_إلى_مرجع_مسير) and this verifier accepts it by.
عام عرف هل_تحويل_مؤشر_إلى_مرجع_لمسير(
    الأنواع: &سجل_أنواع,
    المصدر: معرف_نوع,
    الناتج: معرف_نوع
): منطقي {
    طابق صنف_تحويل_بين(الأنواع, المصدر, الناتج) مع
    | صنف_تحويل_نوع.يتطلب_غير_آمن -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف تحقق_مرجع_إلى_مؤشر_مسير(
    التحويل: مرجع_إلى_مؤشر_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, التحويل.المرجع, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختياري.موجود(قيمة_المصدر) -> {
        طابق الناتج مع
        | اختياري.موجود(قيمة_الناتج) -> {
            دع صالح: متغير منطقي = خطأ;
            طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_المصدر.النوع) مع
            | اختياري.موجود(داخل_المرجع) -> {
                طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_الناتج.النوع) مع
                | اختياري.موجود(داخل_المؤشر) -> {
                    إذا (معرفا_نوع_متساويان(داخل_المرجع, داخل_المؤشر)) {
                        صالح := صواب;
                        إذا (
                            هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, قيمة_الناتج.النوع)
                            && !هل_مرجع_متغير_لمسير(الأنواع, قيمة_المصدر.النوع)
                        ) {
                            صالح := خطأ;
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            // A raw pointer read as its address (`p as u64`, or `p as u32`
            // on a 32-bit target), or taken as another raw pointer.
            طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_المصدر.النوع) مع
            | اختياري.موجود(_) -> {
                إذا (هل_نوع_عنوان_صحيح_لمسير(الأنواع, قيمة_الناتج.النوع)) { صالح := صواب; };
                طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_الناتج.النوع) مع
                | اختياري.موجود(_) -> { صالح := صواب; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            إذا (هل_نوع_عنوان_صحيح_لمسير(الأنواع, قيمة_المصدر.النوع)) {
                طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_الناتج.النوع) مع
                | اختياري.موجود(_) -> { صالح := صواب; }
                | اختياري.لا_شيء -> { };
            };
            // A raw pointer read as a reference to the same address (`p as
            // &T`, inside unsafe): the conversion the frontend classifies
            // يتطلب_غير_آمن, the rule lowering emits it by.
            إذا (هل_تحويل_مؤشر_إلى_مرجع_لمسير(الأنواع, قيمة_المصدر.النوع, قيمة_الناتج.النوع)) {
                صالح := صواب;
            };
            إذا (!صالح) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تحويل_مرجع_إلى_مؤشر_غير_صالح(
                        الموضع, قيمة_المصدر.النوع, قيمة_الناتج.النوع
                    )
                );
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_تجميع_مسير(
    العملية: &تجميع_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(القيمة_الناتجة) -> {
        دع حالة_العملية: تجميع_مسير = *العملية;
        دع العدد: طبيعي = الطول(حالة_العملية.الأعضاء) مثل طبيعي;
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة_الناتجة.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.تجميع_غير_صالح(الموضع, القيمة_الناتجة.النوع)
            );
            أرجع خطأ;
        }
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.صف -> {
                دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
                طابق عدد_عناصر_صف_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
                | اختياري.موجود(المتوقع) -> {
                    إذا (المتوقع != العدد) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تجميع_غير_صالح(
                                الموضع,
                                القيمة_الناتجة.النوع
                            )
                        );
                    };
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < المتوقع) {
                        طابق نوع_عنصر_صف_دلالي_عند(
                            الأنواع,
                            القيمة_الناتجة.النوع,
                            ف
                        ) مع
                        | اختياري.موجود(نوع_العضو) -> {
                            ألحق(الأنواع_المتوقعة, نوع_العضو);
                        }
                        | اختياري.لا_شيء -> {
                            أرجع خطأ;
                        };
                        ف := ف + 1;
                    }
                    دع صالح_الأعضاء: منطقي = تحقق_أعضاء_تجميع_مسير(
                        &حالة_العملية.الأعضاء,
                        العدد,
                        &الأنواع_المتوقعة,
                        الموضع,
                        الدالة,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    أرجع (المتوقع == العدد) && صالح_الأعضاء;
                }
                | اختياري.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تجميع_غير_صالح(
                            الموضع,
                            القيمة_الناتجة.النوع
                        )
                    );
                    أرجع خطأ;
                };
            }
            | صنف_شكل_نوع_دلالي.سجل -> {
                دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
                طابق عدد_حقول_سجل_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
                | اختياري.موجود(المتوقع) -> {
                    إذا (المتوقع != العدد) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تجميع_غير_صالح(
                                الموضع,
                                القيمة_الناتجة.النوع
                            )
                        );
                    };
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < المتوقع) {
                        طابق نوع_حقل_سجل_دلالي_عند(
                            الأنواع,
                            القيمة_الناتجة.النوع,
                            ف
                        ) مع
                        | اختياري.موجود(نوع_الحقل) -> {
                            ألحق(الأنواع_المتوقعة, نوع_الحقل);
                        }
                        | اختياري.لا_شيء -> {
                            أرجع خطأ;
                        };
                        ف := ف + 1;
                    }
                    دع صالح_الأعضاء: منطقي = تحقق_أعضاء_تجميع_مسير(
                        &حالة_العملية.الأعضاء,
                        العدد,
                        &الأنواع_المتوقعة,
                        الموضع,
                        الدالة,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    أرجع (المتوقع == العدد) && صالح_الأعضاء;
                }
                | اختياري.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تجميع_غير_صالح(
                            الموضع,
                            القيمة_الناتجة.النوع
                        )
                    );
                    أرجع خطأ;
                };
            }
            | _ -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تجميع_غير_صالح(
                        الموضع,
                        القيمة_الناتجة.النوع
                    )
                );
                أرجع خطأ;
            };
        };
    };
}


عرف تحقق_تهيئة_متجه_مسير(
    العملية: &تهيئة_متجه_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة_الناتجة) -> {
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.تجميع_غير_صالح(الموضع, القيمة_الناتجة.النوع)
            );
            أرجع خطأ;
        }
        | اختياري.موجود(نوع_العنصر) -> {
            دع حالة_العملية: تهيئة_متجه_مسير = *العملية;
            دع العدد: طبيعي = الطول(حالة_العملية.العناصر) مثل طبيعي;
            دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد) {
                ألحق(الأنواع_المتوقعة, نوع_العنصر);
                ف := ف + 1;
            }
            أرجع تحقق_أعضاء_تجميع_مسير(
                &حالة_العملية.العناصر,
                العدد,
                &الأنواع_المتوقعة,
                الموضع,
                الدالة,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
        };
    };
}

عرف تحقق_استخراج_حقل_مسير(
    العملية: استخراج_حقل_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختياري.موجود(قيمة_المصدر) -> {
        طابق نوع_حقل_دلالي_لمسير(الأنواع, قيمة_المصدر.النوع, العملية.الفهرس) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.حقل_غير_صالح(الموضع, قيمة_المصدر.النوع, العملية.الفهرس));
        }
        | اختياري.موجود(المتوقع) -> {
            طابق الناتج مع
            | اختياري.موجود(قيمة_الناتج) -> {
                إذا (!معرفا_نوع_متساويان(المتوقع, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حقل_غير_مطابق(الموضع, المتوقع, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_فهرس_مسير(
    المصدر_معرف: معرف_قيمة_مسير,
    الفهرس_معرف: معرف_قيمة_مسير,
    الناتج_المتوقع: اختياري قيمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, المصدر_معرف, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الفهرس: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الفهرس_معرف, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    طابق الفهرس مع
    | اختياري.موجود(قيمة_الفهرس) -> {
        طابق وصف_صحيح_لمسير(الأنواع, قيمة_الفهرس.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_فهرس_غير_صحيح(الموضع, قيمة_الفهرس.النوع));
        }
        | اختياري.موجود(الوصف) -> { };
    }
    | اختياري.لا_شيء -> { };
    طابق المصدر مع
    | اختياري.موجود(قيمة_المصدر) -> {
        طابق نوع_عنصر_فهرسة_لمسير(الأنواع, قيمة_المصدر.النوع) مع
        | اختياري.موجود(نوع_العنصر) -> {
            طابق الناتج_المتوقع مع
            | اختياري.موجود(قيمة_الناتج) -> {
                إذا (!معرفا_نوع_متساويان(نوع_العنصر, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_عنصر_فهرس_غير_مطابق(الموضع, نوع_العنصر, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_المصدر.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مرجع_إلى_مكان_مسير(
    العملية: مرجع_إلى_مكان_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المرجع: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المرجع, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع المكان: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المرجع مع
    | اختياري.موجود(قيمة_المرجع) -> {
        طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_المرجع.النوع) مع
        | اختياري.موجود(الداخل) -> {
            طابق المكان مع
            | اختياري.موجود(قيمة_المكان) -> {
                إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, الداخل, قيمة_المكان.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(الموضع, الداخل, قيمة_المكان.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_المرجع.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_صندوق_إلى_مكان_مسير(
    العملية: صندوق_إلى_مكان_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الصندوق: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, العملية.الصندوق, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع المكان: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الصندوق مع
    | اختياري.موجود(قيمة_الصندوق) -> {
        طابق نوع_داخل_صندوق_لمسير(الأنواع, قيمة_الصندوق.النوع) مع
        | اختياري.موجود(الداخل) -> {
            طابق المكان مع
            | اختياري.موجود(قيمة_المكان) -> {
                إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, الداخل, قيمة_المكان.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(الموضع, الداخل, قيمة_المكان.النوع)
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الصندوق.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مكان_حقل_مسير(
    العملية: مكان_حقل_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الأصل: اختياري قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.الأصل, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الأصل مع
    | اختياري.موجود(قيمة_الأصل) -> {
        طابق نوع_حقل_دلالي_لمسير(الأنواع, قيمة_الأصل.النوع, العملية.الفهرس) مع
        | اختياري.موجود(المتوقع) -> {
            طابق الناتج مع
            | اختياري.موجود(قيمة_الناتج) -> {
                إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, المتوقع, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(الموضع, المتوقع, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.حقل_غير_صالح(الموضع, قيمة_الأصل.النوع, العملية.الفهرس));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مكان_فهرس_مسير(
    العملية: مكان_فهرس_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الأصل: اختياري قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.الأصل, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الفهرس: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.الفهرس, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الفهرس مع
    | اختياري.موجود(قيمة_الفهرس) -> {
        طابق وصف_صحيح_لمسير(الأنواع, قيمة_الفهرس.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_فهرس_غير_صحيح(الموضع, قيمة_الفهرس.النوع));
        }
        | اختياري.موجود(الوصف) -> { };
    }
    | اختياري.لا_شيء -> { };
    طابق الأصل مع
    | اختياري.موجود(قيمة_الأصل) -> {
        طابق نوع_عنصر_فهرسة_لمسير(الأنواع, قيمة_الأصل.النوع) مع
        | اختياري.موجود(المتوقع) -> {
            طابق الناتج مع
            | اختياري.موجود(قيمة_الناتج) -> {
                إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, المتوقع, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(الموضع, المتوقع, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_الأصل.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_موضع_تخزين_عنصر_مؤشر_مسير(
    العملية: موضع_تخزين_عنصر_مؤشر_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المؤشر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, العملية.المؤشر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع الفهرس: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, العملية.الفهرس, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع موضع_التخزين: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الفهرس مع
    | اختياري.موجود(قيمة_الفهرس) -> {
        طابق وصف_صحيح_لمسير(الأنواع, قيمة_الفهرس.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_فهرس_غير_صحيح(الموضع, قيمة_الفهرس.النوع)
            );
        }
        | اختياري.موجود(_) -> { };
    }
    | اختياري.لا_شيء -> { };
    طابق المؤشر مع
    | اختياري.موجود(قيمة_المؤشر) -> {
        طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_المؤشر.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_المؤشر.النوع)
            );
        }
        | اختياري.موجود(المتوقع) -> {
            طابق موضع_التخزين مع
            | اختياري.موجود(قيمة_الموضع) -> {
                إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, المتوقع, قيمة_الموضع.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(
                            الموضع, المتوقع, قيمة_الموضع.النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_تحميل_مسير(
    العملية: تحميل_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المكان: اختياري قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المكان مع
    | اختياري.موجود(قيمة_المكان) -> {
        طابق الناتج مع
        | اختياري.موجود(قيمة_الناتج) -> {
            إذا (!معرفا_نوع_متساويان(قيمة_المكان.النوع, قيمة_الناتج.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(الموضع, قيمة_المكان.النوع, قيمة_الناتج.النوع));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_تخزين_مسير(
    العملية: تخزين_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    تحقق_تعليمة_بلا_ناتج_مسير(التعليمة, الموضع, الأخطاء);
    دع المكان: اختياري قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع القيمة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    إذا (!هل_مكان_قابل_للكتابة_لمسير(الدالة, العملية.المكان, الأنواع, فهرس_التعريفات)) {
        طابق المكان مع
        | اختياري.موجود(قيمة_المكان) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, قيمة_المكان.النوع));
        }
        | اختياري.لا_شيء -> { };
    };
    طابق المكان مع
    | اختياري.موجود(قيمة_المكان) -> {
        طابق القيمة مع
        | اختياري.موجود(القيمة_المخزنة) -> {
            إذا (!نوعان_مسير_متساويان_بلا_متغير(الأنواع, قيمة_المكان.النوع, القيمة_المخزنة.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, القيمة_المخزنة.النوع));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مكان_إلى_مرجع_مسير(
    العملية: مكان_إلى_مرجع_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المكان: اختياري قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المكان مع
    | اختياري.موجود(قيمة_المكان) -> {
        طابق الناتج مع
        | اختياري.موجود(قيمة_الناتج) -> {
            طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_الناتج.النوع) مع
            | اختياري.موجود(الداخل) -> {
                إذا (!معرفا_نوع_متساويان(الداخل, قيمة_المكان.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مرجع_غير_مطابق(الموضع, قيمة_المكان.النوع, الداخل));
                };
                إذا (هل_مرجع_متغير_لمسير(الأنواع, قيمة_الناتج.النوع) && !هل_مكان_قابل_للكتابة_لمسير(
                    الدالة,
                    العملية.المكان,
                    الأنواع,
                فهرس_التعريفات)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_موسوم_مسير(
    العملية: &بناء_موسوم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(قيمة_الناتج) -> {
        إذا (!هل_نوع_موسوم(الأنواع, قيمة_الناتج.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع));
            أرجع خطأ;
        };
        دع حالة_العملية: بناء_موسوم_مسير = *العملية;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع, حالة_العملية.المنشئ));
        }
        | اختياري.موجود(المتوقع) -> {
            دع الفعلي: طبيعي = الطول(حالة_العملية.الحمولات) مثل طبيعي;
            إذا (المتوقع != الفعلي) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حمولات_غير_مطابق(الموضع, المتوقع, الفعلي));
            };
            دع ف: متغير طبيعي = 0;
            طالما (ف < الفعلي) {
                دع الحمولة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                    الدالة,
                    حالة_العملية.الحمولات[ف],
                    الموضع.الكتلة,
                    الموضع.الفهرس,
                    الأخطاء,
                فهرس_التعريفات, تحليل_الهيمنة);
                إذا (ف < المتوقع) {
                    طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ, ف) مع
                    | اختياري.موجود(نوع_متوقع) -> {
                        طابق الحمولة مع
                        | اختياري.موجود(قيمة) -> {
                            إذا (!معرفا_نوع_متساويان(قيمة.النوع, نوع_متوقع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(الموضع, ف, نوع_متوقع, قيمة.النوع)
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
                ف := ف + 1;
            }
        };
        أرجع صواب;
    };
}

عرف تحقق_استعلام_وسم_مسير(
    العملية: استعلام_وسم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    طابق المصدر مع
    | اختياري.موجود(قيمة) -> {
        إذا (!هل_نوع_موسوم(الأنواع, قيمة.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    طابق نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء) مع
    | اختياري.موجود(قيمة) -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط32()) مع
        | اختياري.موجود(المتوقع) -> {
            إذا (!معرفا_نوع_متساويان(قيمة.النوع, المتوقع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
            };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_استخراج_حمولة_مسير(
    العملية: استخراج_حمولة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع المصدر: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختياري.موجود(قيمة_المصدر) -> {
        إذا (!هل_نوع_موسوم(الأنواع, قيمة_المصدر.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_المصدر.النوع));
        } وإلا {
            طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_المصدر.النوع, العملية.المنشئ) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(
                        الموضع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ
                    )
                );
            }
            | اختياري.موجود(عدد_الحمولات) -> {
                إذا (العملية.الحمولة >= عدد_الحمولات) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                            الموضع,
                            قيمة_المصدر.النوع,
                            العملية.المنشئ,
                            العملية.الحمولة
                        )
                    );
                } وإلا {
                    طابق نوع_حمولة_منشئ_دلالي_عند(
                        الأنواع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ,
                        العملية.الحمولة
                    ) مع
                    | اختياري.موجود(المتوقع) -> {
                        طابق الناتج مع
                        | اختياري.موجود(قيمة_الناتج) -> {
                            إذا (!معرفا_نوع_متساويان(المتوقع, قيمة_الناتج.النوع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(
                                        الموضع,
                                        العملية.الحمولة,
                                        المتوقع,
                                        قيمة_الناتج.النوع
                                    )
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                                الموضع,
                                قيمة_المصدر.النوع,
                                العملية.المنشئ,
                                العملية.الحمولة
                            )
                        );
                    };
                };
            };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

// The outer `mutable` wrapper records source mutability only; it is not a
// representation difference, so place and payload types compare without it.
عرف نوعان_مسير_متساويان_بلا_متغير(
    الأنواع: &سجل_أنواع, الأول: معرف_نوع, الثاني: معرف_نوع
): منطقي {
    إذا (معرفا_نوع_متساويان(الأول, الثاني)) { أرجع صواب; };
    طابق معرف_نوع_أساس_عند(الأنواع, الأول) مع
    | اختياري.موجود(أ) -> {
        طابق معرف_نوع_أساس_عند(الأنواع, الثاني) مع
        | اختياري.موجود(ب) -> { أرجع معرفا_نوع_متساويان(أ, ب); }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف تحقق_بناء_صندوق_مسير(
    العملية: بناء_صندوق_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع القيمة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختياري.موجود(قيمة_الناتج) -> {
        طابق نوع_داخل_صندوق_لمسير(الأنواع, قيمة_الناتج.النوع) مع
        | اختياري.موجود(المتوقع) -> {
            طابق القيمة مع
            | اختياري.موجود(قيمة_المصدر) -> {
                // `box mut T` holds a `T`: mutability is not a representation difference.
                إذا (!معرفا_نوع_متساويان(المتوقع, قيمة_المصدر.النوع)
                    && !نوعان_مسير_متساويان_بلا_متغير(الأنواع, المتوقع, قيمة_المصدر.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_إغلاق_مسير(
    البرنامج: &برنامج_مسير,
    العملية: &بناء_إغلاق_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع البناء: بناء_إغلاق_مسير = *العملية;
    نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    إذا (!دالة_مسير_موجودة(البرنامج, البناء.الدالة)) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.هدف_نداء_غير_صالح(الموضع, البناء.الدالة));
        أرجع خطأ;
    };
    دع الهدف: &دالة_مسير = &(*البرنامج).الدوال[البناء.الدالة.القيمة];
    دع المتوقع: طبيعي = عدد_التقاطات_دالة_مسير(الهدف);
    دع الموجود: طبيعي = الطول(البناء.الالتقاطات) مثل طبيعي;
    إذا (المتوقع != الموجود) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الموجود));
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الموجود) {
        دع القيمة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة, البناء.الالتقاطات[ف], الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        إذا (ف < المتوقع) {
            طابق القيمة مع
            | اختياري.موجود(ق) -> {
                طابق نوع_التقاط_دالة_مسير_عند(الهدف, ف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(نوع_متوقع) -> {
                    إذا (!معرفا_نوع_متساويان(ق.النوع, نوع_متوقع)) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                            الموضع, ف, نوع_متوقع, ق.النوع
                        ));
                    };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف تحقق_استخراج_التقاط_مسير(
    العملية: استخراج_التقاط_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    دع عدد_الالتقاطات: طبيعي = عدد_التقاطات_دالة_مسير(الدالة);
    إذا (العملية.الفهرس >= عدد_الالتقاطات) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(
            الموضع, عدد_الالتقاطات, العملية.الفهرس + 1
        ));
        أرجع خطأ;
    };
    طابق الناتج مع
    | اختياري.موجود(ق) -> {
        طابق نوع_التقاط_دالة_مسير_عند(الدالة, العملية.الفهرس) مع
        | اختياري.موجود(المتوقع) -> {
            إذا (!معرفا_نوع_متساويان(المتوقع, ق.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                    الموضع, العملية.الفهرس, المتوقع, ق.النوع
                ));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_حجج_نداء_هيكليا(
    النداء: &نداء_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(حالة_النداء.الحجج) مثل طبيعي)) {
        تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        ف := ف + 1;
    }
    طابق حالة_النداء.مكان_التعديل مع
    | اختياري.موجود(المكان) -> {
        تحقق_استخدام_مكان_مسير(
            الدالة, المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_نداء_دالة_سلطان_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختياري.موجود(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختياري.لا_شيء -> { };
    إذا (!دالة_مسير_موجودة(البرنامج, الهدف_معرف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
        أرجع خطأ;
    };

    دع مرجع_الهدف: &دالة_مسير = &(*البرنامج).الدوال[الهدف_معرف.القيمة];
    دع المتوقع: طبيعي = الطول((*مرجع_الهدف).المعاملات) مثل طبيعي;
    دع الفعلي: طبيعي = الطول(حالة_النداء.الحجج) مثل طبيعي;
    إذا (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
        );
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الفعلي) {
        دع الحجة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        إذا (ف < المتوقع) {
            طابق الحجة مع
            | اختياري.موجود(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = (*مرجع_الهدف).المعاملات[ف].النوع;
                إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                            الموضع,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }

    دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
    طابق (*مرجع_الهدف).الناتج مع
    | اختياري.لا_شيء -> {
        طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
        | اختياري.موجود(_) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختياري.لا_شيء -> {
        };
    }
    | اختياري.موجود(نوع_المتوقع) -> {
        طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختياري.موجود(القيمة) -> {
            إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                        الموضع,
                        نوع_المتوقع,
                        القيمة.النوع
                    )
                );
            };
        };
    };
    أرجع صواب;
}


عرف تحقق_نداء_دالة_خارجية_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_خارجية_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختياري.موجود(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختياري.لا_شيء -> { };
    طابق دالة_خارجية_مسير_عند(البرنامج, الهدف_معرف) مع
    | اختياري.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_خارجي_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
        أرجع خطأ;
    }
    | اختياري.موجود(الهدف) -> {
        دع المتوقع: طبيعي = الطول(الهدف.المعاملات) مثل طبيعي;
        دع الفعلي: طبيعي = الطول(حالة_النداء.الحجج) مثل طبيعي;
        إذا (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < الفعلي) {
            دع الحجة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة,
                حالة_النداء.الحجج[ف],
                الموضع.الكتلة,
                الموضع.الفهرس,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            إذا (ف < المتوقع) {
                طابق الحجة مع
                | اختياري.موجود(القيمة) -> {
                    دع نوع_المتوقع: معرف_نوع = الهدف.المعاملات[ف];
                    إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, القيمة.النوع
                            )
                        );
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق الهدف.الناتج مع
        | اختياري.لا_شيء -> {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
            | اختياري.موجود(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.موجود(نوع_المتوقع) -> {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختياري.موجود(القيمة) -> {
                إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_المتوقع, القيمة.النوع
                        )
                    );
                };
            };
        };
        أرجع صواب;
    };
}

عرف هل_نوع_فراغ_لتحقق_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(مرجع_النوع_38) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_38.القيمة] مع
        | نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف تحقق_نداء_قيمة_دالة_مسير(
    النداء: &نداء_مسير,
    الدالة_القيمة: معرف_قيمة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الحالة: نداء_مسير = *النداء;
    طابق الحالة.مكان_التعديل مع
    | اختياري.موجود(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختياري.لا_شيء -> { };

    دع الدالة_المتحققة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, الدالة_القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع نوع_الدالة: متغير اختياري معرف_نوع = اختياري.لا_شيء();
    طابق الدالة_المتحققة مع
    | اختياري.موجود(القيمة) -> {
        طابق عدد_معاملات_دالة_دلالية(الأنواع, القيمة.النوع) مع
        | اختياري.موجود(_) -> { نوع_الدالة := اختياري.موجود(القيمة.النوع); }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(الدالة_القيمة, القيمة.النوع));
        };
    }
    | اختياري.لا_شيء -> { };

    تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    طابق نوع_الدالة مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(نوع_الدالة_المقنن) -> {
        دع المتوقع: متغير طبيعي = 0;
        طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة_المقنن) مع
        | اختياري.موجود(العدد) -> { المتوقع := العدد; }
        | اختياري.لا_شيء -> { };
        دع الفعلي: طبيعي = الطول(الحالة.الحجج) مثل طبيعي;
        إذا (المتوقع != الفعلي) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي));
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < الفعلي) {
            إذا (ف < المتوقع) {
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة_المقنن, ف) مع
                | اختياري.موجود(نوع_المتوقع) -> {
                    طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, الحالة.الحجج[ف]) مع
                    | اختياري.موجود(التعريف) -> {
                        إذا (!معرفا_نوع_متساويان(نوع_المتوقع, التعريف.القيمة.النوع)) {
                            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, التعريف.القيمة.النوع
                            ));
                        };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة_المقنن) مع
        | اختياري.موجود(نوع_الناتج) -> {
            دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
            إذا (هل_نوع_فراغ_لتحقق_مسير(الأنواع, نوع_الناتج)) {
                طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
                | اختياري.موجود(_) -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); }
                | اختياري.لا_شيء -> { };
            } وإلا {
                طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
                | اختياري.موجود(القيمة) -> {
                    إذا (!معرفا_نوع_متساويان(نوع_الناتج, القيمة.النوع)) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_الناتج, القيمة.النوع
                        ));
                    };
                }
                | اختياري.لا_شيء -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); };
            };
        }
        | اختياري.لا_شيء -> { };
        أرجع صواب;
    };
}

// Semantic memory annotations are not machine ABI arguments. They must name
// typed pointer operands, a live provenance reference and a typed extent.
// Scalar extents use literal bounds. Indexed byte vectors must prove the
// same root, index and runtime length through their MSIR definitions. Numeric
// lengths without storage provenance are never trusted.
عرف طول_نطاق_ذاكرة_ثابت_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري طبيعي {
    // Implicitly converted zero constants remain zero under any integer
    // conversion. Do not generally fold nonzero integer casts here: a narrow
    // conversion can truncate and must not forge a larger memory capacity.
    دع الحالي: متغير معرف_قيمة_مسير = المعرف;
    دع تحويلات: متغير طبيعي = 0;
    طالما (تحويلات < (الطول((*الدالة).القيم) مثل طبيعي)) {
        تحويلات := تحويلات + 1;
        طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, الحالي) مع
        | اختياري.موجود(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                    أرجع اختياري.لا_شيء();
                };
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                    أرجع اختياري.لا_شيء();
                };
                طابق (*التعليمات)[الفهرس].العملية مع
                | عملية_مسير.ثابت(الثابت) -> {
                    طابق الثابت مع
                    | ثابت_مسير.صحيح_طبيعي(الحجم) -> {
                        إذا (تحويلات == 1 || الحجم == 0) {
                            أرجع اختياري.موجود(الحجم);
                        };
                    }
                    // A signed zero literal (`0 مثل ط64`) is zero after any conversion.
                    | ثابت_مسير.صحيح_موقع(القيمة) -> {
                        إذا (القيمة == 0) { أرجع اختياري.موجود(0); };
                    }
                    | _ -> { };
                    أرجع اختياري.لا_شيء();
                }
                | عملية_مسير.تحويل_صحيح(التحويل) -> {
                    الحالي := التحويل.المصدر;
                }
                | _ -> { أرجع اختياري.لا_شيء(); };
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.لا_شيء();
}

// A dynamic byte extent is accepted only when its SSA definition is exactly
// `length(the source byte vector) - the index used by this very borrow`.
// The runtime memory owner must still validate the live allocation and range.
عرف عملية_تعريف_طول_نطاق_نداء(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري عملية_مسير {
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
            إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                أرجع اختياري.لا_شيء();
            };
            دع مرجع_القيمة_المعادة_2939: &عملية_مسير = &(*التعليمات)[الفهرس].العملية;
            دع القيمة_المعادة_2939: عملية_مسير = انسخ_مملوكا_عملية_مسير(مرجع_القيمة_المعادة_2939);
            أرجع اختياري.موجود(القيمة_المعادة_2939);
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف أصل_إعادة_تفسير_طول_نداء(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    القيمة: معرف_قيمة_مسير
): اختياري معرف_قيمة_مسير {
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, القيمة) مع
    | اختياري.موجود(عملية_مسير.تحويل_صحيح(التحويل)) -> {
        طابق التحويل.العملية مع
        | عملية_تحويل_صحيح.إعادة_تفسير -> { أرجع اختياري.موجود(التحويل.المصدر); }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// A source byte-vector element is not an independent one-byte allocation.
// Its descriptor must carry the actual remaining vector extent.
عرف هل_مرجع_عنصر_متجه_بايتات_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الأنواع: &سجل_أنواع,
    المرجع: معرف_قيمة_مسير
): منطقي {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, المرجع) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المصدر)) -> { مكان_العنصر := المصدر.المكان; }
    | _ -> { أرجع خطأ; };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(المكان)) -> { مكان_المتجه := المكان.الأصل; }
    | _ -> { أرجع خطأ; };
    دع تعريف_المتجه: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
        التعريفات, مكان_المتجه
    );
    دع نوع_المتجه: معرف_نوع;
    طابق تعريف_المتجه مع
    | اختياري.موجود(التعريف) -> {
        طابق أزل_غلاف_متغير(الأنواع, التعريف.القيمة.النوع) مع
        | اختياري.موجود(النوع) -> { نوع_المتجه := النوع; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق نوع_عنصر_تسلسل_دلالي(الأنواع, نوع_المتجه) مع
    | اختياري.موجود(النوع) -> {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(مرجع_النوع_39) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_39.القيمة] مع
            | نوع_مقنن.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ص8 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ط8 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص16 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ط16 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ط32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص64 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ط64 -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
            | _ -> { أرجع خطأ; };
        };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف هل_طول_متجه_بايتات_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الأنواع: &سجل_أنواع,
    المرجع: معرف_قيمة_مسير,
    الطول_الديناميكي: معرف_قيمة_مسير
): منطقي {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, المرجع) مع
    | اختياري.موجود(عملية_مسير.مكان_إلى_مرجع(المصدر)) -> { مكان_العنصر := المصدر.المكان; }
    | _ -> { أرجع خطأ; };
    دع مكان_المتجه: معرف_قيمة_مسير;
    دع فهرس_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, مكان_العنصر) مع
    | اختياري.موجود(عملية_مسير.مكان_فهرس(المكان)) -> {
        مكان_المتجه := المكان.الأصل;
        فهرس_العنصر := المكان.الفهرس;
    }
    | _ -> { أرجع خطأ; };
    إذا (!هل_مرجع_عنصر_متجه_بايتات_نداء_موثوق(
        الدالة, التعريفات, الأنواع, المرجع
    )) { أرجع خطأ; };
    دع عرض_العنصر: طبيعي;
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المرجع) مع
    | اختياري.موجود(التعريف) -> {
        طابق معرف_نوع_أساس_عند(الأنواع, التعريف.القيمة.النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(مرجع_النوع_40) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_40.القيمة] مع
            | نوع_مقنن.مرجع(العنصر, _) -> {
            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, العنصر) مع
            | اختياري.موجود(العرض) -> { عرض_العنصر := العرض; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
            | _ -> { أرجع خطأ; };
        };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع طول_العناصر: متغير معرف_قيمة_مسير = الطول_الديناميكي;
    إذا (عرض_العنصر != 1) {
        طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, الطول_الديناميكي) مع
        | اختياري.موجود(عملية_مسير.حساب_صحيح(الضرب)) -> {
            طابق الضرب.العملية مع
            | عملية_حساب_صحيح.ضرب -> { }
            | _ -> { أرجع خطأ; };
            طابق طول_نطاق_ذاكرة_ثابت_موثوق(الدالة, التعريفات, الضرب.اليمين) مع
            | اختياري.موجود(القيمة) -> {
                إذا (القيمة != عرض_العنصر) { أرجع خطأ; };
            }
            | اختياري.لا_شيء -> { أرجع خطأ; };
            طول_العناصر := الضرب.اليسار;
        }
        | _ -> { أرجع خطأ; };
    };
    دع الطول_المسجل: حساب_صحيح_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, طول_العناصر) مع
    | اختياري.موجود(عملية_مسير.حساب_صحيح(الحساب)) -> {
        طابق الحساب.العملية مع
        | عملية_حساب_صحيح.طرح -> { الطول_المسجل := الحساب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    // Exact index SSA identity is required. Narrower indices may only be
    // widened according to their original signedness; same-width signed
    // indices are reinterpreted. No unrelated arithmetic establishes an offset.
    إذا (!قيمتا_مسير_متساويتان(الطول_المسجل.اليمين, فهرس_العنصر)) {
        دع تحويل_الفهرس: تحويل_صحيح_مسير;
        طابق عملية_تعريف_طول_نطاق_نداء(
            الدالة, التعريفات, الطول_المسجل.اليمين
        ) مع
        | اختياري.موجود(عملية_مسير.تحويل_صحيح(التحويل)) -> {
            تحويل_الفهرس := التحويل;
        }
        | _ -> { أرجع خطأ; };
        إذا (!قيمتا_مسير_متساويتان(تحويل_الفهرس.المصدر, فهرس_العنصر)) {
            أرجع خطأ;
        };
        دع تعريف_الفهرس: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
            التعريفات, فهرس_العنصر
        );
        دع وصف_الفهرس: وصف_صحيح_مسير;
        طابق تعريف_الفهرس مع
        | اختياري.موجود(التعريف) -> {
            طابق وصف_صحيح_لمسير(الأنواع, التعريف.القيمة.النوع) مع
            | اختياري.موجود(الوصف) -> { وصف_الفهرس := الوصف; }
            | اختياري.لا_شيء -> { أرجع خطأ; };
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (وصف_الفهرس.البتات > 64 || وصف_الفهرس.البتات == 0) {
            أرجع خطأ;
        };
        إذا (وصف_الفهرس.البتات == 64) {
            طابق تحويل_الفهرس.العملية مع
            | عملية_تحويل_صحيح.إعادة_تفسير -> { }
            | _ -> { أرجع خطأ; };
        } وإلا {
            طابق وصف_الفهرس.الإشارة مع
            | إشارة_صحيح_مسير.موقع -> {
                طابق تحويل_الفهرس.العملية مع
                | عملية_تحويل_صحيح.توسيع_بإشارة -> { }
                | _ -> { أرجع خطأ; };
            }
            | إشارة_صحيح_مسير.طبيعي -> {
                طابق تحويل_الفهرس.العملية مع
                | عملية_تحويل_صحيح.توسيع_صفري -> { }
                | _ -> { أرجع خطأ; };
            };
        };
    };
    دع ناتج_طول_التسلسل: معرف_قيمة_مسير;
    طابق أصل_إعادة_تفسير_طول_نداء(
        الدالة, التعريفات, الطول_المسجل.اليسار
    ) مع
    | اختياري.موجود(المعرف) -> { ناتج_طول_التسلسل := المعرف; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع قيمة_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(
        الدالة, التعريفات, ناتج_طول_التسلسل
    ) مع
    | اختياري.موجود(عملية_مسير.نداء(النداء)) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.طول) -> {
            إذا ((الطول(النداء.الحجج) مثل طبيعي) != 1) { أرجع خطأ; };
            قيمة_المتجه := النداء.الحجج[0];
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, قيمة_المتجه) مع
    | اختياري.موجود(عملية_مسير.تحميل(التحميل)) -> {
        أرجع قيمتا_مسير_متساويتان(التحميل.المكان, مكان_المتجه);
    }
    | _ -> { أرجع خطأ; };
}

// Trace the storage behind a call-site borrow. A raw pointer-indexed place
// cannot establish allocation provenance merely because it was reborrowed.
// Function parameters and foreign references are checked for liveness by the
// interpreter; the verifier never treats an integer as a storage root.
عرف هل_مكان_نطاق_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المكان: معرف_قيمة_مسير
): منطقي {
    دع الحالي: متغير معرف_قيمة_مسير = المكان;
    دع الزيارات: متغير طبيعي = 0;
    طالما (الزيارات < (الطول((*الدالة).القيم) مثل طبيعي)) {
        الزيارات := الزيارات + 1;
        طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, الحالي) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                    أرجع خطأ;
                };
                دع التعليمات: &متجه تعليمة_مسير =
                    &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                    أرجع خطأ;
                };
                طابق (*التعليمات)[الفهرس].العملية مع
                | عملية_مسير.مكان_محلي(_) -> { أرجع صواب; }
                | عملية_مسير.مكان_عام(_) -> { أرجع صواب; }
                | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع صواب; }
                | عملية_مسير.مرجع_إلى_مكان(_) -> {
                    // The incoming reference is validated against live storage
                    // by the runtime memory owner at the execution boundary.
                    أرجع صواب;
                }
                | عملية_مسير.مكان_حقل(الحقل) -> { الحالي := الحقل.الأصل; }
                | عملية_مسير.مكان_فهرس(العنصر) -> { الحالي := العنصر.الأصل; }
                | _ -> { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
        };
    };
    أرجع خطأ;
}

عرف هل_مرجع_نطاق_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المرجع: معرف_قيمة_مسير
): منطقي {
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المرجع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.معامل_دالة -> { أرجع صواب; }
        | موضع_تعريف_قيمة_مسير.معامل_كتلة(_) -> {
            // A block parameter preserves an incoming typed reference; the
            // interpreter must still resolve its live allocation.
            أرجع صواب;
        }
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                أرجع خطأ;
            };
            دع التعليمات: &متجه تعليمة_مسير =
                &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
            إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                أرجع خطأ;
            };
            طابق (*التعليمات)[الفهرس].العملية مع
            | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
                أرجع هل_مكان_نطاق_نداء_موثوق(
                    الدالة, التعريفات, العملية.المكان
                );
            }
            | _ -> { أرجع خطأ; };
        };
    };
}

// Actual accessible byte counts still require source-established bounds and
// an interpreter memory check; a numeric length alone is not such a proof.
// Opaque word->address conversions cannot acquire provenance by annotation.
عرف تحقق_نطاقات_ذاكرة_نداء_مسير(
    النداء: &نداء_مسير,
    بدائي_نواة: منطقي,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الهيمنة: &تحليل_هيمنة_مسير
): فراغ {
    دع قيمة_النداء: نداء_مسير = *النداء;
    دع العدد: طبيعي = الطول(قيمة_النداء.الحجج) مثل طبيعي;
    دع موضع_الحجة: متغير طبيعي = 0;
    طالما (موضع_الحجة < العدد) {
        دع القيمة: معرف_قيمة_مسير = قيمة_النداء.الحجج[موضع_الحجة];
        دع تعريف_الحجة: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, القيمة);
        دع مؤشر_فعلي: متغير منطقي = خطأ;
        طابق تعريف_الحجة مع
        | اختياري.موجود(التعريف) -> {
            طابق معرف_نوع_أساس_عند(الأنواع, التعريف.القيمة.النوع) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(مرجع_النوع_41) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_41.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> { مؤشر_فعلي := صواب; }
                | _ -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        دع مطابقات: متغير طبيعي = 0;
        دع فهرس_النطاق: متغير طبيعي = 0;
        طالما (فهرس_النطاق < (الطول(قيمة_النداء.نطاقات_الذاكرة) مثل طبيعي)) {
            دع النطاق: نطاق_ذاكرة_نداء_مسير = قيمة_النداء.نطاقات_الذاكرة[فهرس_النطاق];
            إذا (النطاق.فهرس_الحجة == موضع_الحجة) {
                مطابقات := مطابقات + 1;
                دع صالح: متغير منطقي = بدائي_نواة && موضع_الحجة > 0 && مؤشر_فعلي
                    && قيمتا_مسير_متساويتان(القيمة, النطاق.المؤشر);
                إذا (صالح) {
                    دع أصل: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة, النطاق.الأصل, الموضع.الكتلة, الموضع.الفهرس,
                        الأخطاء, التعريفات, الهيمنة
                    );
                    دع طول_النطاق: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة, النطاق.الطول, الموضع.الكتلة, الموضع.الفهرس,
                        الأخطاء, التعريفات, الهيمنة
                    );
                    // Only the matching address-of-reference conversion provides
                    // provenance. A fabricated machine integer is not storage.
                    دع تعريف_المؤشر: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
                        التعريفات, النطاق.المؤشر
                    );
                    دع أصل_صحيح: متغير منطقي = خطأ;
                    طابق تعريف_المؤشر مع
                    | اختياري.موجود(التعريف) -> {
                        طابق التعريف.الموضع مع
                        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                            إذا ((الكتلة.القيمة مثل طبيعي) < (الطول((*الدالة).الكتل) مثل طبيعي)) {
                                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                                إذا (الفهرس < (الطول(*التعليمات) مثل طبيعي)) {
                                    طابق (*التعليمات)[الفهرس].العملية مع
                                    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
                                        أصل_صحيح := قيمتا_مسير_متساويتان(التحويل.المرجع, النطاق.الأصل);
                                    }
                                    | _ -> { };
                                };
                            };
                        }
                        | _ -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    صالح := أصل_صحيح && هل_مرجع_نطاق_نداء_موثوق(
                        الدالة, التعريفات, النطاق.الأصل
                    );
                    طابق أصل مع
                    | اختياري.موجود(القيمة_الأصل) -> {
                        طابق معرف_نوع_أساس_عند(الأنواع, القيمة_الأصل.النوع) مع
                        | اختياري.لا_شيء -> { صالح := خطأ; }
                        | اختياري.موجود(مرجع_النوع_42) -> {
                            طابق (*الأنواع).الأنواع[مرجع_النوع_42.القيمة] مع
                            | نوع_مقنن.مرجع(العنصر, مرجع_متغير) -> {
                            // A mutable raw pointer does not make an immutable
                            // borrow writable. Check both source permission and
                            // the maximum provable number of accessible bytes.
                            طابق النطاق.الإذن مع
                            | إذن_ذاكرة_نداء_مسير.قراءة -> { }
                            | _ -> {
                                إذا (!مرجع_متغير) { صالح := خطأ; };
                            };
                            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, العنصر) مع
                            | اختياري.موجود(الحد) -> {
                                طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                                    الدالة, التعريفات, النطاق.الطول
                                ) مع
                                | اختياري.موجود(الحجم) -> {
                                    // Canonical scalar descriptors cover exactly
                                    // their referenced object. They cannot mask
                                    // a dynamic byte-vector borrow as one byte.
                                    إذا (الحجم != الحد || هل_مرجع_عنصر_متجه_بايتات_نداء_موثوق(
                                        الدالة, التعريفات, الأنواع, النطاق.الأصل
                                    )) { صالح := خطأ; };
                                }
                                | اختياري.لا_شيء -> {
                                    // Dynamic byte-vector extents have their own
                                    // SSA provenance proof, not an arbitrary size.
                                    إذا (!هل_طول_متجه_بايتات_نداء_موثوق(
                                        الدالة, التعريفات, الأنواع,
                                        النطاق.الأصل, النطاق.الطول
                                    )) { صالح := خطأ; };
                                };
                            }
                            | اختياري.لا_شيء -> {
                                // No scalar or byte-vector witness for aggregates.
                                صالح := خطأ;
                            };
                        }
                            | _ -> { صالح := خطأ; };
                        };
                    }
                    | اختياري.لا_شيء -> { صالح := خطأ; };
                    طابق طول_النطاق مع
                    | اختياري.موجود(قيمة_الطول) -> {
                        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
                        | اختياري.موجود(النوع) -> {
                            إذا (!معرفا_نوع_متساويان(قيمة_الطول.النوع, النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختياري.لا_شيء -> { صالح := خطأ; };
                    }
                    | اختياري.لا_شيء -> { صالح := خطأ; };
                    طابق النطاق.المطلوب مع
                    | اختياري.موجود(معرف_الطلب) -> {
                        دع قيمة_الطلب: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                            الدالة, معرف_الطلب, الموضع.الكتلة, الموضع.الفهرس,
                            الأخطاء, التعريفات, الهيمنة
                        );
                        طابق قيمة_الطلب مع
                        | اختياري.موجود(القيمة) -> {
                            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.ط64()) مع
                            | اختياري.موجود(النوع) -> {
                                إذا (!معرفا_نوع_متساويان(القيمة.النوع, النوع)) {
                                    صالح := خطأ;
                                };
                            }
                            | اختياري.لا_شيء -> { صالح := خطأ; };
                        }
                        | اختياري.لا_شيء -> { صالح := خطأ; };
                        // An independently supplied request may not exceed a
                        // statically known source extent. Runtime values still
                        // require the Interpreter's live allocation check.
                        طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                            الدالة, التعريفات, النطاق.الطول
                        ) مع
                        | اختياري.موجود(الحد_الثابت) -> {
                            طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                                الدالة, التعريفات, معرف_الطلب
                            ) مع
                            | اختياري.موجود(الطلب_الثابت) -> {
                                إذا (الطلب_الثابت > الحد_الثابت) { صالح := خطأ; };
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    طابق النطاق.الإذن مع
                    | إذن_ذاكرة_نداء_مسير.قراءة -> { }
                    | إذن_ذاكرة_نداء_مسير.كتابة -> {
                        طابق تعريف_الحجة مع
                        | اختياري.موجود(التعريف) -> {
                            إذا (!هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, التعريف.القيمة.النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختياري.لا_شيء -> { صالح := خطأ; };
                    }
                    | إذن_ذاكرة_نداء_مسير.قراءة_وكتابة -> {
                        طابق تعريف_الحجة مع
                        | اختياري.موجود(التعريف) -> {
                            إذا (!هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, التعريف.القيمة.النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختياري.لا_شيء -> { صالح := خطأ; };
                    };
                };
                إذا (!صالح) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, موضع_الحجة));
                };
            };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
        // A pointer operand of an attested (contracted) kernel call must carry
        // exactly one proven descriptor. A raw kernel call without a contract
        // is valid but untrusted MSIR (lowering/expressions.sn,
        // أكمل_عقد_ذاكرة_نداء_لينكس): compiled code executes it as written and
        // the Interpreter refuses it at the call (وثق_توقيع_نداء_نواة_مفسر).
        // Previously every pointer operand of every kernel call required a
        // descriptor, which rejected whole programs containing an untrusted
        // call (std's execve argv/envp) once code generation was verified.
        دع عقد_موثق: متغير منطقي = خطأ;
        طابق قيمة_النداء.عقد_النواة مع
        | اختياري.موجود(_) -> { عقد_موثق := صواب; }
        | اختياري.لا_شيء -> { };
        إذا ((مطابقات > 1) || (بدائي_نواة && عقد_موثق && مؤشر_فعلي && مطابقات != 1)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, موضع_الحجة));
        };
        موضع_الحجة := موضع_الحجة + 1;
    }
    // Descriptors with no corresponding call operand must also be rejected.
    دع فهرس_النطاق: متغير طبيعي = 0;
    طالما (فهرس_النطاق < (الطول(قيمة_النداء.نطاقات_الذاكرة) مثل طبيعي)) {
        دع النطاق: نطاق_ذاكرة_نداء_مسير = قيمة_النداء.نطاقات_الذاكرة[فهرس_النطاق];
        إذا (النطاق.فهرس_الحجة >= العدد) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, النطاق.فهرس_الحجة));
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
}

// Re-prove the complete six-slot contract against the canonical Linux STD
// operation signature. SSA producer identity prevents a forged operation
// number, and the constructor ordinal binds the selector to its operand.
عرف تحقق_عقد_نواة_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    نواة: منطقي,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير
): فراغ {
    دع العقد: عقد_نواة_مسير;
    طابق (*النداء).عقد_النواة مع
    | اختياري.موجود(القيمة) -> { العقد := القيمة; }
    | اختياري.لا_شيء -> { أرجع; };
    دع صالح: متغير منطقي = نواة;
    إذا ((الطول((*النداء).الحجج) مثل طبيعي) != 7) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
        أرجع;
    };
    إذا (!قيمتا_مسير_متساويتان(العقد.الرقم, (*النداء).الحجج[0])) {
        صالح := خطأ;
    };
    دع تعريف_الرقم: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
        التعريفات, العقد.الرقم
    );
    دع قيمة_العملية: متغير معرف_قيمة_مسير = العقد.الرقم;
    طابق تعريف_الرقم مع
    | اختياري.موجود(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                صالح := خطأ;
            } وإلا {
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                    صالح := خطأ;
                } وإلا {
                    طابق (*التعليمات)[الفهرس].العملية مع
                    | عملية_مسير.نداء(الانتقاء) -> {
                        إذا ((الطول(الانتقاء.الحجج) مثل طبيعي) != 1) {
                            صالح := خطأ;
                        } وإلا {
                            قيمة_العملية := الانتقاء.الحجج[0];
                        };
                        طابق الانتقاء.الهدف مع
                        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                            إذا (الهدف.القيمة != العقد.المنتقي.القيمة) { صالح := خطأ; };
                        }
                        | _ -> { صالح := خطأ; };
                    }
                    | _ -> { صالح := خطأ; };
                };
            }
        }
        | _ -> { صالح := خطأ; };
    }
    | اختياري.لا_شيء -> { صالح := خطأ; };
    // The attested source table is derived independently at the Frontend
    // boundary from canonical module keys and resolved declarations.
    دع توقيع_موثق: متغير اختياري توقيع_نداء_بدائي = اختياري.لا_شيء();
    دع مطابقات_الأصل: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).أصول_النواة) مثل طبيعي)) {
        دع الأصل: &مصدر_عقد_نواة_مسير = &(*البرنامج).أصول_النواة[ف];
        إذا (معرفا_رمز_متساويان((*الأصل).المنشئ, العقد.المنشئ)
            && (*الأصل).الترتيب == العقد.الترتيب
            && (*الأصل).المنتقي.القيمة == العقد.المنتقي.القيمة) {
            مطابقات_الأصل := مطابقات_الأصل + 1;
            // Copy the authenticated signature through the borrow.
            دع مرجع_التوقيع: &توقيع_نداء_بدائي = &(*الأصل).التوقيع;
            دع التوقيع_المنسوخ: توقيع_نداء_بدائي = انسخ_مملوكا_توقيع_نداء_بدائي(مرجع_التوقيع);
            توقيع_موثق := اختياري.موجود(التوقيع_المنسوخ);
        };
        ف := ف + 1;
    }
    إذا (مطابقات_الأصل != 1) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
        أرجع;
    };
    دع التوقيع: توقيع_نداء_بدائي;
    طابق توقيع_موثق مع
    | اختياري.موجود(الموثق) -> { التوقيع := الموثق; }
    | اختياري.لا_شيء -> { أرجع; };
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, قيمة_العملية) مع
    | اختياري.موجود(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
                صالح := خطأ;
            } وإلا {
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                إذا (الفهرس >= (الطول(*التعليمات) مثل طبيعي)) {
                    صالح := خطأ;
                } وإلا {
                    طابق (*التعليمات)[الفهرس].العملية مع
                    | عملية_مسير.بناء_موسوم(المنشئ) -> {
                        إذا (المنشئ.المنشئ != العقد.الترتيب || الطول(المنشئ.الحمولات) != 0) {
                            صالح := خطأ;
                        };
                    }
                    | _ -> { صالح := خطأ; };
                };
            }
        }
        | _ -> { صالح := خطأ; };
    }
    | اختياري.لا_شيء -> { صالح := خطأ; };
    إذا ((الطول(التوقيع.الأدوار) مثل طبيعي) != 6) { صالح := خطأ; } وإلا {
        دع الوسيط: متغير طبيعي = 1;
        طالما (الوسيط <= 6) {
            دع مطابقات: متغير طبيعي = 0;
            دع النطاق_المطابق: متغير اختياري نطاق_ذاكرة_نداء_مسير = اختياري.لا_شيء();
            دع ن: متغير طبيعي = 0;
            طالما (ن < (الطول((*النداء).نطاقات_الذاكرة) مثل طبيعي)) {
                دع الوصف: نطاق_ذاكرة_نداء_مسير = (*النداء).نطاقات_الذاكرة[ن];
                إذا (الوصف.فهرس_الحجة == الوسيط) {
                    مطابقات := مطابقات + 1;
                    النطاق_المطابق := اختياري.موجود(الوصف);
                };
                ن := ن + 1;
            }
            طابق التوقيع.الأدوار[الوسيط - 1] مع
            | دور_وسيطة_بدائي.عدد -> {
                إذا (مطابقات != 0) { صالح := خطأ; };
            }
            | دور_وسيطة_بدائي.غير_مستخدم -> {
                إذا (مطابقات != 0) { صالح := خطأ; };
                طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                    الدالة, التعريفات, (*النداء).الحجج[الوسيط]
                ) مع
                | اختياري.موجود(القيمة) -> { إذا (القيمة != 0) { صالح := خطأ; }; }
                | اختياري.لا_شيء -> { صالح := خطأ; };
            }
            | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
                إذا (مطابقات != 1) { صالح := خطأ; };
                طابق النطاق_المطابق مع
                | اختياري.موجود(الوصف) -> {
                    إذا (!قيمتا_مسير_متساويتان(الوصف.المؤشر, (*النداء).الحجج[الوسيط])) {
                        صالح := خطأ;
                    };
                    دع الإذن_المطلوب: إذن_ذاكرة_نداء_مسير;
                    طابق الاتجاه مع
                    | اتجاه_وصول_بدائي.قراءة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.قراءة(); }
                    | اتجاه_وصول_بدائي.كتابة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.كتابة(); }
                    | اتجاه_وصول_بدائي.قراءة_وكتابة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
                    إذا (الوصف.الإذن != الإذن_المطلوب) { صالح := خطأ; };
                    طابق الوصف.المطلوب مع
                    | اختياري.موجود(المطلوب) -> {
                        طابق الحد مع
                        | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                            إذا (الفهرس == 0 || الفهرس > 6) {
                                صالح := خطأ;
                            } وإلا إذا (!قيمتا_مسير_متساويتان(المطلوب, (*النداء).الحجج[الفهرس])) {
                                صالح := خطأ;
                            };
                        }
                        | حد_وصول_بدائي.سلسلة_صفرية -> {
                            إذا (!قيمتا_مسير_متساويتان(المطلوب, الوصف.الطول)) { صالح := خطأ; };
                        }
                        | حد_وصول_بدائي.ثابت(الثابت) -> {
                            طابق طول_نطاق_ذاكرة_ثابت_موثوق(الدالة, التعريفات, المطلوب) مع
                            | اختياري.موجود(القيمة) -> { إذا (القيمة != الثابت) { صالح := خطأ; }; }
                            | اختياري.لا_شيء -> { صالح := خطأ; };
                        };
                    }
                    | اختياري.لا_شيء -> { صالح := خطأ; };
                }
                | اختياري.لا_شيء -> { صالح := خطأ; };
            };
            الوسيط := الوسيط + 1;
        }
    };
    إذا (!صالح) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
    };
}

عرف تحقق_نداء_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    دع نواة: متغير منطقي = خطأ;
    طابق حالة_النداء.الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.نداء_نواة_خام -> { نواة := صواب; }
        | _ -> { };
    }
    | _ -> { };
    تحقق_عقد_نواة_مسير(
        البرنامج, النداء, نواة, الموضع, الدالة, الأخطاء, فهرس_التعريفات
    );
    تحقق_نطاقات_ذاكرة_نداء_مسير(
        النداء, نواة, الموضع, الدالة, الأنواع,
        الأخطاء, فهرس_التعريفات, تحليل_الهيمنة
    );
    طابق حالة_النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
        أرجع تحقق_نداء_دالة_سلطان_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.دالة_خارجية(الهدف) -> {
        أرجع تحقق_نداء_دالة_خارجية_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
        أرجع تحقق_نداء_قيمة_دالة_مسير(
            النداء, الدالة_القيمة, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(البدائي);
        دع المتوقع: طبيعي = العقد.عدد_الحجج;
        دع الفعلي: طبيعي = الطول(حالة_النداء.الحجج) مثل طبيعي;
        إذا (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };

        دع يعدل_مكانا: منطقي = هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.إلحاق())
            || هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.ضبط_طول_متجه())
            || هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.حجز_سعة_متجه())
            || هويتا_بدائي_مترجم_متساويتان(البدائي, هوية_بدائي_مترجم.إلحاق_نطاق_متجه());
        إذا (يعدل_مكانا) {
            طابق حالة_النداء.مكان_التعديل مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        };
        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> { }
        | هوية_بدائي_مترجم.ضبط_طول_متجه -> { }
        | هوية_بدائي_مترجم.حجز_سعة_متجه -> { }
        | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { }
        | _ -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختياري.موجود(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
            }
            | اختياري.لا_شيء -> { };
        };

        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);

        // Exact primitive Type legality is owned by Frontend Type. MSIR contributes only
        // already-lowered ValueIDs and requires all source-level conversions to be explicit.
        دع الأنواع_المقننة_للبدائي: اختياري أنواع_استدعاء_بدائي_مقننة =
            أنواع_استدعاء_بدائي_مقننة_من_سجل(الأنواع);
        دع أنواع_حجج_البدائي: متغير متجه معرف_نوع = [];
        دع أنواع_الحجج_مكتملة: متغير منطقي = صواب;
        دع ف_نوع: متغير طبيعي = 0;
        طالما (ف_نوع < الفعلي) {
            طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, حالة_النداء.الحجج[ف_نوع]) مع
            | اختياري.موجود(التعريف) -> {
                ألحق(أنواع_حجج_البدائي, التعريف.القيمة.النوع);
            }
            | اختياري.لا_شيء -> { أنواع_الحجج_مكتملة := خطأ; };
            ف_نوع := ف_نوع + 1;
        }
        طابق الأنواع_المقننة_للبدائي مع
        | اختياري.موجود(القيم_المقننة) -> {
            إذا (أنواع_الحجج_مكتملة) {
                طابق تحقق_استدعاء_بدائي_مقنن(
                    الأنواع, &القيم_المقننة, البدائي, &أنواع_حجج_البدائي
                ) مع
                | نتيجة_استدعاء_بدائي.صالح(_) -> { }
                | نتيجة_استدعاء_بدائي.مرفوض(خطأ_النوع) -> {
                    طابق خطأ_النوع مع
                    | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(_, _) -> {
                        // Runtime arity was already reported above.
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, نوع_المتوقع, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, الفهرس, نوع_المتوقع, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_بدائية_غير_صالحة(
                                الموضع, البدائي, الفهرس, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
                        );
                    };
                };
            };
        }
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
            );
        };

        دع فهرس_حجة_التعديل: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> { فهرس_حجة_التعديل := اختياري.موجود(0); }
        | هوية_بدائي_مترجم.ضبط_طول_متجه -> { فهرس_حجة_التعديل := اختياري.موجود(0); }
        | هوية_بدائي_مترجم.حجز_سعة_متجه -> { فهرس_حجة_التعديل := اختياري.موجود(0); }
        | هوية_بدائي_مترجم.إلحاق_نطاق_متجه -> { فهرس_حجة_التعديل := اختياري.موجود(0); }
        | _ -> { };
        طابق فهرس_حجة_التعديل مع
        | اختياري.موجود(فهرس_التعديل) -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختياري.موجود(المكان) -> {
                إذا (!هل_مكان_قابل_للكتابة_لمسير(الدالة, المكان, الأنواع, فهرس_التعريفات)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_قابل_للكتابة(الموضع)
                    );
                };
                إذا (الفعلي > فهرس_التعديل) {
                    طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, حالة_النداء.الحجج[فهرس_التعديل]) مع
                    | اختياري.موجود(تعريف_الحجة) -> {
                        طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, المكان) مع
                        | اختياري.موجود(تعريف_المكان) -> {
                            إذا (!معرفا_نوع_متساويان(
                                تعريف_الحجة.القيمة.النوع,
                                تعريف_المكان.القيمة.النوع
                            )) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_مكان_تعديل_نداء_غير_مطابق(
                                        الموضع,
                                        تعريف_الحجة.القيمة.النوع,
                                        تعريف_المكان.القيمة.النوع
                                    )
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };

        // Runtime owns the broad result category; Type resolves it to the exact
        // canonical TypeID consumed here without a parallel primitive table.
        دع يتطلب_ناتج_قيمة: متغير منطقي = صواب;
        طابق العقد.فئة_الناتج مع
        | فئة_ناتج_بدائي.بلا_قيمة -> {
            يتطلب_ناتج_قيمة := خطأ;
        }
        | _ -> { };

        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق قيمة_ناتج_تعليمة_مسير(الدالة, &حالة_التعليمة) مع
        | اختياري.موجود(قيمة_الناتج) -> {
            إذا (!يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            } وإلا {
                // A result of the first argument's Type (the float operations,
                // the only such primitives that reach MSIR) is checked against it.
                دع ناتج_بنوع_الحجة: متغير منطقي = خطأ;
                طابق العقد.فئة_الناتج مع
                | فئة_ناتج_بدائي.قيمة_الحجة -> {
                    إذا ((الطول(أنواع_حجج_البدائي) مثل طبيعي) >= 1) {
                        ناتج_بنوع_الحجة := معرفا_نوع_متساويان(قيمة_الناتج.النوع, أنواع_حجج_البدائي[0]);
                    };
                }
                | _ -> { };
                طابق الأنواع_المقننة_للبدائي مع
                | اختياري.موجود(القيم_المقننة) -> {
                    إذا (!ناتج_بنوع_الحجة && !هل_نوع_ناتج_استدعاء_بدائي_مقنن(
                        الأنواع, &القيم_المقننة, العقد.فئة_الناتج, قيمة_الناتج.النوع
                    )) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ناتج_بدائي_غير_مطابق(
                                الموضع, البدائي, قيمة_الناتج.النوع
                            )
                        );
                    };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> {
            إذا (يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            };
        };
        أرجع صواب;
    };
}

عرف تحقق_تعليمة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الفهرس: طبيعي,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[الفهرس];
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع معرف_الكتلة: معرف_كتلة_مسير = (*الكتلة).المعرف;
    دع الموضع: موضع_تعليمة_مسير = {
        الدالة: معرف_الدالة,
        الكتلة: معرف_الكتلة,
        الفهرس: الفهرس
    };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        تحقق_ثابت_مسير(الدالة, &الثابت, التعليمة, الموضع, الأنواع, الأخطاء);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        تحقق_حساب_صحيح_مسير(
            الحساب,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        تحقق_حساب_عشري_مسير(الحساب, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        تحقق_مقارنة_عشرية_مسير(المقارنة, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        تحقق_مقارنة_صحيح_مسير(
            المقارنة,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        تحقق_تحويل_صحيح_مسير(
            التحويل,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        تحقق_تحويل_عائم_مسير(
            التحويل, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        تحقق_نقل_تسلسل_مملوك_مسير(
            النقل, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة
        );
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        تحقق_مرجع_إلى_مؤشر_مسير(
            التحويل, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تجميع(العملية) -> {
        تحقق_تجميع_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تهيئة_متجه(العملية) -> {
        تحقق_تهيئة_متجه_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_حقل(العملية) -> {
        تحقق_استخراج_حقل_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_فهرس(العملية) -> {
        دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
        تحقق_فهرس_مسير(العملية.المصدر, العملية.الفهرس, الناتج, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_محلي(العملية) -> {
        نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    }
    | عملية_مسير.مكان_عام(العملية) -> {
        نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        تحقق_مرجع_إلى_مكان_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        تحقق_صندوق_إلى_مكان_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        تحقق_مكان_حقل_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        تحقق_مكان_فهرس_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        تحقق_موضع_تخزين_عنصر_مؤشر_مسير(
            العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تحميل(العملية) -> {
        تحقق_تحميل_مسير(العملية, التعليمة, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تخزين(العملية) -> {
        تحقق_تخزين_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        تحقق_مكان_إلى_مرجع_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_موسوم(العملية) -> {
        تحقق_بناء_موسوم_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        تحقق_استعلام_وسم_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        تحقق_استخراج_حمولة_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        تحقق_بناء_صندوق_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_إغلاق(العملية) -> {
        تحقق_بناء_إغلاق_مسير(البرنامج, &العملية, التعليمة, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_التقاط(العملية) -> {
        تحقق_استخراج_التقاط_مسير(العملية, التعليمة, الموضع, الدالة, الأخطاء);
    }
    | عملية_مسير.نداء(النداء) -> {
        تحقق_نداء_مسير(
            البرنامج,
            &النداء,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    };
    أرجع صواب;
}

عرف تحقق_حافة_مسير(
    الدالة: &دالة_مسير,
    الكتلة_المصدر: معرف_كتلة_مسير,
    الحافة: &حافة_مسير,
    موضع_الاستخدام: طبيعي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {

    إذا (!كتلة_مسير_موجودة(الدالة, (*الحافة).الهدف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_فرع_غير_صالح(الكتلة_المصدر, (*الحافة).الهدف)
        );
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
            تحقق_استخدام_قيمة_مسير(
                الدالة,
                (*الحافة).الحجج[ف],
                الكتلة_المصدر,
                موضع_الاستخدام,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            ف := ف + 1;
        }
        أرجع خطأ;
    };
    دع معرف_الهدف: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع موضع_الهدف: طبيعي = معرف_الهدف.القيمة;
    دع الهدف: &كتلة_مسير = &(*الدالة).الكتل[موضع_الهدف];
    دع المتوقع: طبيعي = الطول((*الهدف).المعاملات) مثل طبيعي;
    دع الفعلي: طبيعي = الطول((*الحافة).الحجج) مثل طبيعي;
    إذا (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_فرع_غير_مطابق(الكتلة_المصدر, (*الحافة).الهدف, المتوقع, الفعلي)
        );
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الفعلي) {
        دع الحجة: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة,
            (*الحافة).الحجج[ف],
            الكتلة_المصدر,
            موضع_الاستخدام,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        إذا (ف < المتوقع) {
            طابق الحجة مع
            | اختياري.موجود(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = (*الهدف).المعاملات[ف].النوع;
                إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_فرع_غير_مطابق(
                            الكتلة_المصدر,
                            (*الحافة).الهدف,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف تحقق_منهي_مسير(
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الموضع: طبيعي = الطول((*الكتلة).التعليمات) مثل طبيعي;
    طابق (*الكتلة).المنهي مع
    | اختياري.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.كتلة_بلا_منهي((*الكتلة).المعرف)
        );
        أرجع خطأ;
    }
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &الحافة,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
        }
        | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
            دع قيمة_الشرط: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة,
                الشرط,
                (*الكتلة).المعرف,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            طابق قيمة_الشرط مع
            | اختياري.موجود(القيمة) -> {
                إذا (!هل_نوع_مسير_منطقي(الأنواع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شرط_فرع_غير_منطقي(
                            (*الكتلة).المعرف,
                            الشرط,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختياري.لا_شيء -> {
            };
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &عند_الصواب,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &عند_الخطأ,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            دع المميز: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة, الفرع.المميز, (*الكتلة).المعرف, الموضع,
                الأخطاء, فهرس_التعريفات, تحليل_الهيمنة
            );
            // Case keys are bit patterns of the selector's width W, as an
            // LLVM switch's cases have the condition's own type: 0 <= key
            // < 2^W, a negative signed key written in W-bit two's complement.
            // A wider key would alias a different case once a backend
            // compares W bits, so every backend reads keys the same way.
            دع عرض_المميز: متغير طبيعي = 64;
            طابق المميز مع
            | اختياري.موجود(القيمة) -> {
                طابق وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, القيمة.النوع) مع
                | اختياري.لا_شيء -> {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مميز_فرع_غير_صحيح(
                        (*الكتلة).المعرف, الفرع.المميز, القيمة.النوع
                    ));
                }
                | اختياري.موجود(الوصف) -> { عرض_المميز := الوصف.البتات; };
            }
            | اختياري.لا_شيء -> { };
            تحقق_حافة_مسير(الدالة, (*الكتلة).المعرف, &الفرع.الافتراضي,
                الموضع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                دع الحالة: &حالة_فرع_متعدد_مسير = &الفرع.الحالات[ف];
                إذا (!هل_قيمة_طبيعية_تلائم((*الحالة).الوسم, عرض_المميز)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.وسم_فرع_خارج_عرض_المميز(
                        (*الكتلة).المعرف, (*الحالة).الوسم
                    ));
                };
                دع س: متغير طبيعي = 0;
                طالما (س < ف) {
                    إذا (الفرع.الحالات[س].الوسم == (*الحالة).الوسم) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.وسم_فرع_مكرر(
                            (*الكتلة).المعرف, (*الحالة).الوسم
                        ));
                    };
                    س := س + 1;
                }
                تحقق_حافة_مسير(الدالة, (*الكتلة).المعرف, &(*الحالة).الحافة,
                    الموضع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(القيمة) -> {
            طابق (*الدالة).الناتج مع
            | اختياري.لا_شيء -> {
                طابق القيمة مع
                | اختياري.موجود(المعرف) -> {
                    تحقق_استخدام_قيمة_مسير(
                        الدالة,
                        المعرف,
                        (*الكتلة).المعرف,
                        الموضع,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق((*الكتلة).المعرف)
                    );
                }
                | اختياري.لا_شيء -> {
                };
            }
            | اختياري.موجود(نوع_المتوقع) -> {
                طابق القيمة مع
                | اختياري.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق((*الكتلة).المعرف)
                    );
                }
                | اختياري.موجود(المعرف) -> {
                    دع قيمة_الإرجاع: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة,
                        المعرف,
                        (*الكتلة).المعرف,
                        الموضع,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    طابق قيمة_الإرجاع مع
                    | اختياري.موجود(الموجود) -> {
                        إذا (!معرفا_نوع_متساويان(نوع_المتوقع, الموجود.النوع)) {
                            سجل_خطأ_مسير(
                                الأخطاء,
                                خطأ_تحقق_مسير.نوع_إرجاع_غير_مطابق(
                                    (*الكتلة).المعرف,
                                    نوع_المتوقع,
                                    الموجود.النوع
                                )
                            );
                        };
                    }
                    | اختياري.لا_شيء -> {
                    };
                };
            };
        }
        | منهي_مسير.فخ -> {
        };
    };
    أرجع صواب;
}

// Verify each defining occurrence directly from the canonical function.
// Materializing a second value-definition vector here used to retain one
// copy of every SSA value and its definition location alongside the index.
عرف تحقق_تعريف_قيمة_مسير_مباشر(
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    القيمة: &قيمة_مسير,
    عدد_التعريفات: طبيعي,
    عدد_القيم_المقننة: طبيعي,
    المرئية: &متغير متجه منطقي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): فراغ {
    إذا (!دالتا_مسير_متساويتان((*القيمة).المعرف.الدالة, (*الدالة).المعرف)) {
        سجل_خطأ_مسير(الأخطاء,
            خطأ_تحقق_مسير.قيمة_من_دالة_أخرى((*القيمة).المعرف, (*الدالة).المعرف));
    };
    إذا (((*القيمة).المعرف.القيمة مثل طبيعي) >= عدد_التعريفات) {
        سجل_خطأ_مسير(الأخطاء,
            خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن((*الدالة).المعرف, (*القيمة).المعرف.القيمة));
    } وإلا {
        إذا ((*المرئية)[(*القيمة).المعرف.القيمة]) {
            سجل_خطأ_مسير(الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_مكرر((*القيمة).المعرف));
        } وإلا {
            (*المرئية)[(*القيمة).المعرف.القيمة] := صواب;
        };
        إذا (((*القيمة).المعرف.القيمة مثل طبيعي) < عدد_القيم_المقننة) {
            دع المقننة: قيمة_مسير = (*الدالة).القيم[(*القيمة).المعرف.القيمة];
            إذا (!قيمتا_مسير_متساويتان(المقننة.المعرف, (*القيمة).المعرف)
                || !معرفا_نوع_متساويان(المقننة.النوع, (*القيمة).النوع)) {
                سجل_خطأ_مسير(الأخطاء,
                    خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(
                        (*الدالة).المعرف, (*القيمة).المعرف.القيمة));
            };
        };
    };
    إذا (!نوع_مسير_صالح(الأنواع, (*القيمة).النوع)) {
        سجل_خطأ_مسير(الأخطاء,
            خطأ_تحقق_مسير.نوع_قيمة_غير_صالح((*القيمة).المعرف, (*القيمة).النوع));
    };
}

عرف تحقق_تعريفات_قيم_مسير(
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    // Count definitions without copying their values or locations.
    دع عدد_التعريفات: متغير طبيعي = الطول((*الدالة).المعاملات) مثل طبيعي;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        عدد_التعريفات := عدد_التعريفات + (الطول((*الكتلة).المعاملات) مثل طبيعي);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[ت];
            إذا (للتعليمة_ناتج_مسير(التعليمة)) {
                عدد_التعريفات := عدد_التعريفات + 1;
                // The value an instruction defines is one of its function's values.
                طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
                | اختياري.لا_شيء -> {
                    طابق معرف_ناتج_تعليمة_في_مسير((*الدالة).المعرف, التعليمة) مع
                    | اختياري.موجود(المعرف) -> {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.قيمة_غير_موجودة(المعرف));
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.موجود(_) -> { };
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع عدد_القيم_المقننة: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    إذا (عدد_التعريفات != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(الأخطاء,
            خطأ_تحقق_مسير.عدد_قيم_دالة_غير_متطابق(
                (*الدالة).المعرف, عدد_التعريفات, عدد_القيم_المقننة));
    };
    إذا ((*الدالة).القيمة_التالية != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(الأخطاء,
            خطأ_تحقق_مسير.عداد_قيم_دالة_غير_متطابق(
                (*الدالة).المعرف, عدد_القيم_المقننة, (*الدالة).القيمة_التالية));
    };

    دع المرئية: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_التعريفات) { ألحق(المرئية, خطأ); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        تحقق_تعريف_قيمة_مسير_مباشر(
            الدالة, الأنواع, &(*الدالة).المعاملات[ف],
            عدد_التعريفات, عدد_القيم_المقننة, &متغير المرئية, الأخطاء);
        ف := ف + 1;
    }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        ف := 0;
        طالما (ف < (الطول((*الكتلة).المعاملات) مثل طبيعي)) {
            تحقق_تعريف_قيمة_مسير_مباشر(
                الدالة, الأنواع, &(*الكتلة).المعاملات[ف],
                عدد_التعريفات, عدد_القيم_المقننة, &متغير المرئية, الأخطاء);
            ف := ف + 1;
        }
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &(*الكتلة).التعليمات[ت]) مع
            | اختياري.موجود(القيمة) -> {
                تحقق_تعريف_قيمة_مسير_مباشر(
                    الدالة, الأنواع, &القيمة,
                    عدد_التعريفات, عدد_القيم_المقننة, &متغير المرئية, الأخطاء);
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع المتوقع: متغير طبيعي = 0;
    طالما (المتوقع < عدد_التعريفات) {
        إذا (!المرئية[المتوقع]) {
            سجل_خطأ_مسير(الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن((*الدالة).المعرف, المتوقع));
        };
        المتوقع := المتوقع + 1;
    }

    دع م: متغير طبيعي = 0;
    طالما (م < عدد_القيم_المقننة) {
        دع المقننة: قيمة_مسير = (*الدالة).القيم[م];
        إذا (!دالتا_مسير_متساويتان(المقننة.المعرف.الدالة, (*الدالة).المعرف)
            || ((المقننة.المعرف.القيمة مثل طبيعي) != م)) {
            سجل_خطأ_مسير(الأخطاء,
                خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة((*الدالة).المعرف, م));
        };
        إذا (!نوع_مسير_صالح(الأنواع, المقننة.النوع)) {
            سجل_خطأ_مسير(الأخطاء,
                خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(المقننة.المعرف, المقننة.النوع));
        };
        م := م + 1;
    }
    أرجع صواب;
}

عرف تحقق_دالة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الفهرس: طبيعي,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    الفهرس_المشترك: &متغير فهرس_تعريفات_قيم_مسير
): منطقي {
    أعد_بناء_فهرس_تعريفات_قيم_مسير(الفهرس_المشترك, الدالة);
    دع فهرس_التعريفات: فهرس_تعريفات_قيم_مسير = *الفهرس_المشترك;
    دع تحليل_الهيمنة: تحليل_هيمنة_مسير = حلل_هيمنة_مسير(الدالة);
    إذا (((*الدالة).المعرف.القيمة مثل طبيعي) != الفهرس) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.معرف_دالة_غير_مقنن((*الدالة).المعرف, الفهرس)
        );
    };
    طابق (*الدالة).الناتج مع
    | اختياري.موجود(النوع) -> {
        إذا (!نوع_مسير_صالح(الأنواع, النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_ناتج_دالة_غير_صالح((*الدالة).المعرف, النوع)
            );
        };
    }
    | اختياري.لا_شيء -> {
    };

    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.دالة_بلا_مدخل((*الدالة).المعرف));
    }
    | اختياري.موجود(المدخل) -> {
        دع المدخل_صالح: منطقي = كتلة_مسير_موجودة(الدالة, المدخل);
        إذا (!المدخل_صالح) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.مدخل_غير_صالح((*الدالة).المعرف, المدخل)
            );
        };
        إذا (المدخل_صالح) {
            إذا ((الطول((*الدالة).الكتل[المدخل.القيمة].المعاملات) مثل طبيعي) > 0) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.كتلة_مدخل_بمعاملات(المدخل)
                );
            };
        };
    };

    تحقق_تعريفات_قيم_مسير(الدالة, الأنواع, الأخطاء);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        إذا (!دالتا_مسير_متساويتان((*الكتلة).المعرف.الدالة, (*الدالة).المعرف)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.كتلة_من_دالة_أخرى((*الكتلة).المعرف, (*الدالة).المعرف)
            );
        };
        إذا (((*الكتلة).المعرف.القيمة مثل طبيعي) != ك) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_كتلة_غير_مقنن((*الكتلة).المعرف, ك)
            );
        };
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            تحقق_تعليمة_مسير(
                البرنامج,
                الدالة,
                الكتلة,
                ت,
                الأنواع,
                الأخطاء,
            &فهرس_التعريفات, &تحليل_الهيمنة);
            ت := ت + 1;
        }
        تحقق_منهي_مسير(الدالة, الكتلة, الأنواع, الأخطاء, &فهرس_التعريفات, &تحليل_الهيمنة);
        ك := ك + 1;
    }
    أرجع صواب;
}

// Global constant function addresses are link-time references to MSIR
// definitions. Validate them recursively before either backend emits data
// relocations; unresolved external functions use a different call identity.
عرف مراجع_دوال_ثابت_عام_صحيحة(
    البرنامج: &برنامج_مسير,
    الثابت: &ثابت_مسير
): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.دالة(المعرف) -> {
        أرجع دالة_مسير_موجودة(البرنامج, المعرف);
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            إذا (!مراجع_دوال_ثابت_عام_صحيحة(البرنامج, &العناصر[فهرس_العنصر])) {
                أرجع خطأ;
            };
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع صواب; };
}

// A loader-visible constructor runs before the process start enters main. It cannot
// observe process argc/argv/envp: those globals are populated by the executable
// entry wrapper, not by the loader. Only the compiler-produced, straight-line
// owned-vector initializer is permitted at this boundary. In particular, even
// a well-typed call or load may reach startup globals indirectly, so neither
// calls nor memory reads are admitted here.
نوع قيمة_تهيئة_وحدة_مسير =
    | غير_مقننة
    | ثابتة
    | متجه_مملوك
    | مكان_عام بنوع معرف_عام_مسير
;

عرف نوع_قيمة_تهيئة_وحدة_مسير_عند(
    القيم: &متجه قيمة_تهيئة_وحدة_مسير,
    المعرف: معرف_قيمة_مسير,
    الدالة: معرف_دالة_مسير
): قيمة_تهيئة_وحدة_مسير {
    إذا (!دالتا_مسير_متساويتان(المعرف.الدالة, الدالة)
        || (المعرف.القيمة مثل طبيعي) >= (الطول(*القيم) مثل طبيعي)) {
        أرجع قيمة_تهيئة_وحدة_مسير.غير_مقننة();
    };
    أرجع (*القيم)[المعرف.القيمة];
}

عام عرف هل_تهيئة_وحدة_قبل_الإقلاع_آمنة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الأنواع: &سجل_أنواع
): منطقي {
    إذا (!دالة_مسير_موجودة(البرنامج, الدالة)) { أرجع خطأ; };
    // Executables run language initialization after their startup wrapper;
    // standalone objects have no such wrapper and use a loader constructor.
    طابق (*البرنامج).دالة_بدء_البرنامج مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    دع التهيئة: &دالة_مسير = &(*البرنامج).الدوال[الدالة.القيمة];
    إذا ((الطول((*التهيئة).المعاملات) مثل طبيعي) != 0
        || (الطول((*التهيئة).الالتقاطات) مثل طبيعي) != 0
        || (الطول((*التهيئة).الكتل) مثل طبيعي) != 1) {
        أرجع خطأ;
    };
    طابق (*التهيئة).الناتج مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    دع الكتلة: &كتلة_مسير = &(*التهيئة).الكتل[0];
    طابق (*التهيئة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        إذا (!كتلتان_مسير_متساويتان(المدخل, (*الكتلة).المعرف)) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    طابق (*الكتلة).المنهي مع
    | اختياري.موجود(منهي_مسير.إرجاع(اختياري.لا_شيء)) -> { }
    | _ -> { أرجع خطأ; };
    إذا ((الطول((*الكتلة).المعاملات) مثل طبيعي) != 0) { أرجع خطأ; };

    // ValueID is dense and owned by the function. A value receives its safe
    // class only after its defining instruction has been inspected. This also
    // rejects references to a later value, a parameter, or a foreign function.
    دع القيم: متغير متجه قيمة_تهيئة_وحدة_مسير = [];
    دع موضع_قيمة: متغير طبيعي = 0;
    طالما (موضع_قيمة < (الطول((*التهيئة).القيم) مثل طبيعي)) {
        ألحق(القيم, قيمة_تهيئة_وحدة_مسير.غير_مقننة());
        موضع_قيمة := موضع_قيمة + 1;
    }
    // Owned vectors must be moved exactly once into their parent vector or
    // final global. Reusing an owned value would duplicate buffer ownership.
    دع المستهلكة: متغير متجه منطقي = [];
    موضع_قيمة := 0;
    طالما (موضع_قيمة < (الطول(القيم) مثل طبيعي)) {
        ألحق(المستهلكة, خطأ);
        موضع_قيمة := موضع_قيمة + 1;
    }
    دع المكتوبة: متغير متجه منطقي = [];
    دع موضع_عام: متغير طبيعي = 0;
    طالما (موضع_عام < (الطول((*البرنامج).العوام) مثل طبيعي)) {
        ألحق(المكتوبة, خطأ);
        موضع_عام := موضع_عام + 1;
    }
    دع عدد_التخزينات: متغير طبيعي = 0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
        دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[الموضع];
        دع الحالة: متغير قيمة_تهيئة_وحدة_مسير = قيمة_تهيئة_وحدة_مسير.غير_مقننة();
        دع لها_ناتج: متغير منطقي = صواب;
        طابق (*التعليمة).العملية مع
        | عملية_مسير.ثابت(الثابت) -> {
            // Function addresses may be copied as data, but never called.
            // Static text backing is not a valid owned-vector element.
            طابق الثابت مع
            | ثابت_مسير.منطق(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.صحيح_موقع(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.صحيح_طبيعي(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.مؤشر_فارغ -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.عشري(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.دالة(المعرف) -> {
                إذا (!دالة_مسير_موجودة(البرنامج, المعرف)) { أرجع خطأ; };
                الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة();
            }
            | _ -> { أرجع خطأ; };
        }
        | عملية_مسير.تهيئة_متجه(المتجه) -> {
            دع فهرس_العنصر: متغير طبيعي = 0;
            طالما (فهرس_العنصر < (الطول(المتجه.العناصر) مثل طبيعي)) {
                طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, المتجه.العناصر[فهرس_العنصر], الدالة) مع
                | قيمة_تهيئة_وحدة_مسير.ثابتة -> { }
                | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
                    دع المعرف: معرف_قيمة_مسير = المتجه.العناصر[فهرس_العنصر];
                    إذا (المستهلكة[المعرف.القيمة]) { أرجع خطأ; };
                    المستهلكة[المعرف.القيمة] := صواب;
                }
                | _ -> { أرجع خطأ; };
                فهرس_العنصر := فهرس_العنصر + 1;
            }
            الحالة := قيمة_تهيئة_وحدة_مسير.متجه_مملوك();
        }
        | عملية_مسير.مكان_عام(المكان) -> {
            إذا (!المكان.قابل_للكتابة
                || (المكان.العام.القيمة مثل طبيعي) >= (الطول((*البرنامج).العوام) مثل طبيعي)) {
                أرجع خطأ;
            };
            دع العام: &عام_مسير = &(*البرنامج).العوام[المكان.العام.القيمة];
            إذا (!(*العام).قابل_للكتابة) { أرجع خطأ; };
            طابق (*العام).الاسم_الخارجي مع
            | اختياري.موجود(_) -> { أرجع خطأ; }
            | اختياري.لا_شيء -> { };
            // Only a compiler-created empty mutable vector header can be
            // replaced. No startup ABI globals, imported globals or unrelated
            // program state can be written by this constructor.
            طابق (*العام).التهيئة مع
            | ثابت_مسير.متجه(العناصر) -> {
                إذا ((الطول(العناصر) مثل طبيعي) != 0) { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
            طابق نوع_عنصر_تسلسل_دلالي(الأنواع, (*العام).النوع) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(_) -> { };
            الحالة := قيمة_تهيئة_وحدة_مسير.مكان_عام(المكان.العام);
        }
        | عملية_مسير.تخزين(التخزين) -> {
            لها_ناتج := خطأ;
            دع العام_الهدف: معرف_عام_مسير;
            طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, التخزين.المكان, الدالة) مع
            | قيمة_تهيئة_وحدة_مسير.مكان_عام(المعرف) -> { العام_الهدف := المعرف; }
            | _ -> { أرجع خطأ; };
            طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, التخزين.القيمة, الدالة) مع
            | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
                إذا (المستهلكة[التخزين.القيمة.القيمة]) { أرجع خطأ; };
                المستهلكة[التخزين.القيمة.القيمة] := صواب;
            }
            | _ -> { أرجع خطأ; };
            إذا ((العام_الهدف.القيمة مثل طبيعي) >= (الطول(المكتوبة) مثل طبيعي)
                || المكتوبة[العام_الهدف.القيمة]) { أرجع خطأ; };
            المكتوبة[العام_الهدف.القيمة] := صواب;
            عدد_التخزينات := عدد_التخزينات + 1;
        }
        // Calls, loads, pointer conversions, branches, and all other
        // operations are prohibited during loader initialization.
        | _ -> { أرجع خطأ; };
        طابق معرف_ناتج_تعليمة_في_مسير(الدالة, التعليمة) مع
        | اختياري.موجود(القيمة) -> {
            إذا (!لها_ناتج
                || (القيمة.القيمة مثل طبيعي) >= (الطول(القيم) مثل طبيعي)) {
                أرجع خطأ;
            };
            طابق القيم[القيمة.القيمة] مع
            | قيمة_تهيئة_وحدة_مسير.غير_مقننة -> { }
            | _ -> { أرجع خطأ; };
            القيم[القيمة.القيمة] := الحالة;
        }
        | اختياري.لا_شيء -> {
            إذا (لها_ناتج) { أرجع خطأ; };
        };
        الموضع := الموضع + 1;
    }
    موضع_قيمة := 0;
    طالما (موضع_قيمة < (الطول(القيم) مثل طبيعي)) {
        طابق القيم[موضع_قيمة] مع
        | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
            إذا (!المستهلكة[موضع_قيمة]) { أرجع خطأ; };
        }
        | _ -> { };
        موضع_قيمة := موضع_قيمة + 1;
    }
    أرجع عدد_التخزينات > 0;
}

// The canonical verifier: the program-level facts (the entry, the module
// initializer, the globals) and every function.
عام عرف تحقق_برنامج_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_تحقق_مسير {
    دع لا_قناع: متجه منطقي = [];
    أرجع تحقق_برنامج_مسير_مع_قناع(البرنامج, الأنواع, صواب, &لا_قناع);
}

// The same verifier for a program of which only the functions القناع marks
// (by position; none past its end) may have changed since a verification
// that accepted it. It gives what the full verifier gives, in the same
// order, by checking:
// - the program-level facts, always: the program start exists, the module
//   initializer is safe before start (its body, whatever the mask), every
//   global's Type, initializer and external name;
// - every marked function in full, which covers what a changed function
//   relies on: its calls into unchanged functions (their declarations), the
//   globals it reads and writes, the Types it names, its own blocks;
// - in every unmarked function, each reference whose check reads a marked
//   function: a call to one (its arity, argument and result Types) and a
//   closure built from one (its captures' count and Types). This is the one
//   way a function's check depends on another function, so a marked
//   function whose declaration changed is caught at the unchanged callers
//   as the full verifier would catch it.
// The rest of an unmarked function is what was accepted before. The driver
// passes the set the optimization pipeline changed
// (msir_optimization_pipeline.sn, حسن_برنامج_مسير).
عام عرف تحقق_دوال_برنامج_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    القناع: &متجه منطقي
): نتيجة_تحقق_مسير {
    أرجع تحقق_برنامج_مسير_مع_قناع(البرنامج, الأنواع, خطأ, القناع);
}

عرف معلمة_في_قناع_مسير(القناع: &متجه منطقي, الموضع: طبيعي): منطقي {
    أرجع الموضع < (الطول(*القناع) مثل طبيعي) && (*القناع)[الموضع];
}

// The Type of a value of a function that verified before (its values are
// dense by ID); none for an ID outside them.
عرف نوع_قيمة_مقبولة_مسير(الدالة: &دالة_مسير, القيمة: معرف_قيمة_مسير): اختياري معرف_نوع {
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول((*الدالة).القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الدالة).القيم[القيمة.القيمة].النوع);
}

// In a function that verified before and has not changed, the references
// whose check reads a function القناع marks, checked against that
// function's declaration as تحقق_نداء_دالة_سلطان_مسير and
// تحقق_بناء_إغلاق_مسير check them (see تحقق_دوال_برنامج_مسير).
عرف تحقق_مراجع_دوال_معلمة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    القناع: &متجه منطقي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): فراغ {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[ت];
            دع الموضع: موضع_تعليمة_مسير = {
                الدالة: (*الدالة).المعرف, الكتلة: (*الكتلة).المعرف, الفهرس: ت
            };
            طابق (*التعليمة).العملية مع
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                    إذا (معلمة_في_قناع_مسير(القناع, الهدف.القيمة مثل طبيعي) && دالة_مسير_موجودة(البرنامج, الهدف)) {
                        دع مرجع_الهدف: &دالة_مسير = &(*البرنامج).الدوال[الهدف.القيمة];
                        دع المتوقع: طبيعي = الطول((*مرجع_الهدف).المعاملات) مثل طبيعي;
                        دع الفعلي: طبيعي = الطول(النداء.الحجج) مثل طبيعي;
                        إذا (المتوقع != الفعلي) {
                            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي));
                        };
                        دع ف: متغير طبيعي = 0;
                        طالما (ف < الفعلي && ف < المتوقع) {
                            طابق نوع_قيمة_مقبولة_مسير(الدالة, النداء.الحجج[ف]) مع
                            | اختياري.موجود(النوع) -> {
                                دع نوع_المتوقع: معرف_نوع = (*مرجع_الهدف).المعاملات[ف].النوع;
                                إذا (!معرفا_نوع_متساويان(نوع_المتوقع, النوع)) {
                                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                        الموضع, ف, نوع_المتوقع, النوع
                                    ));
                                };
                            }
                            | اختياري.لا_شيء -> { };
                            ف := ف + 1;
                        }
                        طابق (*مرجع_الهدف).الناتج مع
                        | اختياري.لا_شيء -> {
                            طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
                            | اختياري.موجود(_) -> {
                                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
                            }
                            | اختياري.لا_شيء -> { };
                        }
                        | اختياري.موجود(نوع_المتوقع) -> {
                            طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
                            | اختياري.لا_شيء -> {
                                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
                            }
                            | اختياري.موجود(القيمة) -> {
                                إذا (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                                        الموضع, نوع_المتوقع, القيمة.النوع
                                    ));
                                };
                            };
                        };
                    };
                }
                | _ -> { };
            }
            | عملية_مسير.بناء_إغلاق(البناء) -> {
                إذا (معلمة_في_قناع_مسير(القناع, البناء.الدالة.القيمة مثل طبيعي) && دالة_مسير_موجودة(البرنامج, البناء.الدالة)) {
                    دع الهدف: &دالة_مسير = &(*البرنامج).الدوال[البناء.الدالة.القيمة];
                    دع المتوقع: طبيعي = عدد_التقاطات_دالة_مسير(الهدف);
                    دع الموجود: طبيعي = الطول(البناء.الالتقاطات) مثل طبيعي;
                    إذا (المتوقع != الموجود) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الموجود));
                    };
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < الموجود && ف < المتوقع) {
                        طابق نوع_قيمة_مقبولة_مسير(الدالة, البناء.الالتقاطات[ف]) مع
                        | اختياري.موجود(النوع) -> {
                            طابق نوع_التقاط_دالة_مسير_عند(الهدف, ف) مع
                            | اختياري.لا_شيء -> { }
                            | اختياري.موجود(نوع_متوقع) -> {
                                إذا (!معرفا_نوع_متساويان(النوع, نوع_متوقع)) {
                                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                        الموضع, ف, نوع_متوقع, النوع
                                    ));
                                };
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        ف := ف + 1;
                    }
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
}

عرف تحقق_برنامج_مسير_مع_قناع(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الكل: منطقي,
    القناع: &متجه منطقي
): نتيجة_تحقق_مسير {
    دع الأخطاء: متغير متجه خطأ_تحقق_مسير = [];
    طابق (*البرنامج).دالة_بدء_البرنامج مع
    | اختياري.موجود(الدالة) -> {
        إذا (!دالة_مسير_موجودة(البرنامج, الدالة)) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.دالة_بدء_برنامج_غير_موجودة(الدالة)
            );
        };
    }
    | اختياري.لا_شيء -> { };
    طابق (*البرنامج).دالة_تهيئة_الوحدة مع
    | اختياري.موجود(الدالة) -> {
        إذا (!هل_تهيئة_وحدة_قبل_الإقلاع_آمنة_مسير(البرنامج, الدالة, الأنواع)) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.تهيئة_وحدة_قبل_الإقلاع_غير_آمنة(الدالة)
            );
        };
    }
    | اختياري.لا_شيء -> { };
    دع مؤشر_العام: متغير طبيعي = 0;
    طالما (مؤشر_العام < (الطول((*البرنامج).العوام) مثل طبيعي)) {
        دع العام: &عام_مسير = &(*البرنامج).العوام[مؤشر_العام];
        دع تهيئة_مطلوبة: متغير منطقي = صواب;
        طابق (*العام).الاسم_الخارجي مع
        | اختياري.موجود(الاسم) -> {
            // External storage cannot be initialized or written by the module.
            تهيئة_مطلوبة := خطأ;
            دع اسم_صالح: متغير منطقي = (الطول(الاسم) مثل طبيعي) != 0;
            دع فهرس_الاسم: متغير طبيعي = 0;
            طالما (فهرس_الاسم < (الطول(الاسم) مثل طبيعي)) {
                إذا (الاسم[فهرس_الاسم] == 0) { اسم_صالح := خطأ; };
                فهرس_الاسم := فهرس_الاسم + 1;
            }
            // Separate MSIR globals must not claim the same external
            // linker symbol. The builder interns compatible declarations; a
            // duplicate here is an ABI conflict or malformed imported MSIR.
            دع السابق_الفهرس: متغير طبيعي = 0;
            طالما (السابق_الفهرس < مؤشر_العام) {
                دع السابق: &عام_مسير = &(*البرنامج).العوام[السابق_الفهرس];
                طابق (*السابق).الاسم_الخارجي مع
                | اختياري.موجود(الاسم_السابق) -> {
                    إذا (اسما_عام_خارجي_متساويان_لمسير(&الاسم_السابق, &الاسم)) {
                        اسم_صالح := خطأ;
                    };
                }
                | اختياري.لا_شيء -> { };
                السابق_الفهرس := السابق_الفهرس + 1;
            }
            // Code and data share a linker-symbol namespace. An external
            // function with this name cannot also be imported as storage.
            دع فهرس_الدالة_الخارجية: متغير طبيعي = 0;
            طالما (فهرس_الدالة_الخارجية < (الطول((*البرنامج).الدوال_الخارجية) مثل طبيعي)) {
                دع الدالة_الخارجية: &دالة_خارجية_مسير =
                    &(*البرنامج).الدوال_الخارجية[فهرس_الدالة_الخارجية];
                إذا (اسما_عام_خارجي_متساويان_لمسير(&(*الدالة_الخارجية).الاسم, &الاسم)) {
                    اسم_صالح := خطأ;
                };
                فهرس_الدالة_الخارجية := فهرس_الدالة_الخارجية + 1;
            }
            إذا (!اسم_صالح) {
                سجل_خطأ_مسير(&متغير الأخطاء,
                    خطأ_تحقق_مسير.تهيئة_عام_غير_مطابقة((*العام).المعرف, (*العام).النوع));
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (((*العام).المعرف.القيمة مثل طبيعي) != مؤشر_العام
            || (تهيئة_مطلوبة && !هل_ثابت_مجمع_متوافق_مسير(&(*العام).التهيئة, (*العام).النوع, الأنواع))
            || (تهيئة_مطلوبة && !مراجع_دوال_ثابت_عام_صحيحة(البرنامج, &(*العام).التهيئة))) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.تهيئة_عام_غير_مطابقة((*العام).المعرف, (*العام).النوع)
            );
        };
        مؤشر_العام := مؤشر_العام + 1;
    }
    دع فهرس_التعريفات: متغير فهرس_تعريفات_قيم_مسير = فهرس_تعريفات_قيم_مسير_فارغ();
    دع أي_معلم: متغير منطقي = خطأ;
    دع ق: متغير طبيعي = 0;
    طالما (!الكل && ق < (الطول(*القناع) مثل طبيعي)) {
        إذا ((*القناع)[ق]) { أي_معلم := صواب; };
        ق := ق + 1;
    }
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[ف];
        إذا (الكل || معلمة_في_قناع_مسير(القناع, ف)) {
            تحقق_دالة_مسير(البرنامج, الدالة, ف, الأنواع, &متغير الأخطاء, &متغير فهرس_التعريفات);
        } وإلا إذا (أي_معلم) {
            تحقق_مراجع_دوال_معلمة_مسير(البرنامج, الدالة, القناع, &متغير الأخطاء);
        };
        ف := ف + 1;
    }
    إذا ((الطول(الأخطاء) مثل طبيعي) == 0) {
        أرجع نتيجة_تحقق_مسير.صالح();
    };
    أرجع نتيجة_تحقق_مسير.مرفوض(الأخطاء);
}
