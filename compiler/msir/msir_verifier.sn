            );
        }
        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
    طابق المؤشر مع
    | اختيار.بعض(قيمة_المؤشر) -> {
        طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_المؤشر.النوع) مع
        | اختيار.لا_شيء -> {
