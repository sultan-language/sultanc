    | عضو_تجميع_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, معرف_نوع, معرف_نوع)
    | حقل_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, غير_موقع)
    | نوع_حقل_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | فهرسة_غير_صالحة بنوع (موضع_تعليمة_مسير, معرف_نوع)
