}

عرف تحقق_تخزين_مسير(
    العملية: تخزين_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    تحقق_تعليمة_بلا_ناتج_مسير(التعليمة, الموضع, الأخطاء);
    دع المكان: اختيار قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    لو (!هل_مكان_قابل_للكتابة_لمسير(الدالة, العملية.المكان, الأنواع)) {
        طابق المكان مع
        | اختيار.بعض(قيمة_المكان) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, قيمة_المكان.النوع));
        }
        | اختيار.لا_شيء -> { };
    };
    طابق المكان مع
    | اختيار.بعض(قيمة_المكان) -> {
        طابق القيمة مع
        | اختيار.بعض(القيمة_المخزنة) -> {
            لو (!معرفا_نوع_متساويان(قيمة_المكان.النوع, القيمة_المخزنة.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تخزين_غير_متوافق(الموضع, قيمة_المكان.النوع, القيمة_المخزنة.النوع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مكان_إلى_مرجع_مسير(
    العملية: مكان_إلى_مرجع_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المكان: اختيار قيمة_مسير = تحقق_استخدام_مكان_مسير(الدالة, العملية.المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المكان مع
    | اختيار.بعض(قيمة_المكان) -> {
        طابق الناتج مع
        | اختيار.بعض(قيمة_الناتج) -> {
            طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_الناتج.النوع) مع
            | اختيار.بعض(الداخل) -> {
                لو (!معرفا_نوع_متساويان(الداخل, قيمة_المكان.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_مرجع_غير_مطابق(الموضع, قيمة_المكان.النوع, الداخل));
                };
                لو (هل_مرجع_متغير_لمسير(الأنواع, قيمة_الناتج.النوع) && !هل_مكان_قابل_للكتابة_لمسير(
                    الدالة,
                    العملية.المكان,
                    الأنواع
                )) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مرجع_غير_صالح(الموضع, قيمة_الناتج.النوع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_موسوم_مسير(
    العملية: &بناء_موسوم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(قيمة_الناتج) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة_الناتج.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع));
            أرجع خطأ;
        };
        دع حالة_العملية: بناء_موسوم_مسير = *العملية;
        طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(الموضع, قيمة_الناتج.النوع, حالة_العملية.المنشئ));
        }
        | اختيار.بعض(المتوقع) -> {
            دع الفعلي: غير_موقع = الطول(حالة_العملية.الحمولات) مثل غير_موقع;
            لو (المتوقع != الفعلي) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حمولات_غير_مطابق(الموضع, المتوقع, الفعلي));
            };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < الفعلي) {
                دع الحمولة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                    الدالة,
                    حالة_العملية.الحمولات[ف],
                    الموضع.الكتلة,
                    الموضع.الفهرس,
                    الأخطاء
                );
                لو (ف < المتوقع) {
                    طابق نوع_حمولة_منشئ_دلالي_عند(الأنواع, قيمة_الناتج.النوع, حالة_العملية.المنشئ, ف) مع
                    | اختيار.بعض(نوع_متوقع) -> {
                        طابق الحمولة مع
                        | اختيار.بعض(قيمة) -> {
                            لو (!معرفا_نوع_متساويان(قيمة.النوع, نوع_متوقع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(الموضع, ف, نوع_متوقع, قيمة.النوع)
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
                ف := ف + 1;
            }
        };
        أرجع صواب;
    };
}

عرف تحقق_استعلام_وسم_مسير(
    العملية: استعلام_وسم_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(قيمة) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    طابق نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء) مع
    | اختيار.بعض(قيمة) -> {
        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ32()) مع
        | اختيار.بعض(المتوقع) -> {
            لو (!معرفا_نوع_متساويان(قيمة.النوع, المتوقع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
            };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_وسم_غير_صحيح(الموضع, قيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_استخراج_حمولة_مسير(
    العملية: استخراج_حمولة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(قيمة_المصدر) -> {
        لو (!هل_نوع_موسوم(الأنواع, قيمة_المصدر.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_موسوم_غير_صالح(الموضع, قيمة_المصدر.النوع));
        } وإلا {
            طابق عدد_حمولات_منشئ_دلالي_عند(الأنواع, قيمة_المصدر.النوع, العملية.المنشئ) مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.منشئ_موسوم_غير_صالح(
                        الموضع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ
                    )
                );
            }
            | اختيار.بعض(عدد_الحمولات) -> {
                لو (العملية.الحمولة >= عدد_الحمولات) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                            الموضع,
                            قيمة_المصدر.النوع,
                            العملية.المنشئ,
                            العملية.الحمولة
                        )
                    );
                } وإلا {
                    طابق نوع_حمولة_منشئ_دلالي_عند(
                        الأنواع,
                        قيمة_المصدر.النوع,
                        العملية.المنشئ,
                        العملية.الحمولة
                    ) مع
                    | اختيار.بعض(المتوقع) -> {
                        طابق الناتج مع
                        | اختيار.بعض(قيمة_الناتج) -> {
                            لو (!معرفا_نوع_متساويان(المتوقع, قيمة_الناتج.النوع)) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_حمولة_غير_مطابق(
                                        الموضع,
                                        العملية.الحمولة,
                                        المتوقع,
                                        قيمة_الناتج.النوع
                                    )
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.حمولة_موسومة_غير_صالحة(
                                الموضع,
                                قيمة_المصدر.النوع,
                                العملية.المنشئ,
                                العملية.الحمولة
                            )
                        );
                    };
                };
            };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_بناء_صندوق_مسير(
    العملية: بناء_صندوق_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.بعض(قيمة_الناتج) -> {
        طابق نوع_داخل_صندوق_لمسير(الأنواع, قيمة_الناتج.النوع) مع
        | اختيار.بعض(المتوقع) -> {
            طابق القيمة مع
            | اختيار.بعض(قيمة_المصدر) -> {
                لو (!معرفا_نوع_متساويان(المتوقع, قيمة_المصدر.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.صندوق_غير_صالح(الموضع, قيمة_الناتج.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_حجج_نداء_هيكليا(
    النداء: &نداء_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_النداء.الحجج) مثل غير_موقع)) {
        تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء
        );
        ف := ف + 1;
    }
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(المكان) -> {
        تحقق_استخدام_مكان_مسير(
            الدالة, المكان, الموضع.الكتلة, الموضع.الفهرس, الأخطاء
        );
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_نداء_دالة_سلطان_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };
    لو (!دالة_مسير_موجودة(البرنامج, الهدف_معرف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء);
        أرجع خطأ;
    };

    دع حالة_البرنامج: برنامج_مسير = *البرنامج;
    دع مرجع_الهدف: &دالة_مسير = &حالة_البرنامج.الدوال[الهدف_معرف.القيمة];
    دع الهدف: دالة_مسير = *مرجع_الهدف;
    دع المتوقع: غير_موقع = الطول(الهدف.المعاملات) مثل غير_موقع;
    دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
    لو (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
        );
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الفعلي) {
        دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة,
            حالة_النداء.الحجج[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء
        );
        لو (ف < المتوقع) {
            طابق الحجة مع
            | اختيار.بعض(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = الهدف.المعاملات[ف].النوع;
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                            الموضع,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }

    دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
    طابق الهدف.الناتج مع
    | اختيار.لا_شيء -> {
        طابق حالة_التعليمة.الناتج مع
        | اختيار.بعض(_) -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختيار.لا_شيء -> {
        };
    }
    | اختيار.بعض(نوع_المتوقع) -> {
        طابق حالة_التعليمة.الناتج مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
        }
        | اختيار.بعض(القيمة) -> {
            لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                        الموضع,
                        نوع_المتوقع,
                        القيمة.النوع
                    )
                );
            };
        };
    };
    أرجع صواب;
}


عرف تحقق_نداء_دالة_خارجية_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    الهدف_معرف: معرف_دالة_خارجية_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };
    طابق دالة_خارجية_مسير_عند(البرنامج, الهدف_معرف) مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_نداء_خارجي_غير_صالح(الموضع, الهدف_معرف)
        );
        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء);
        أرجع خطأ;
    }
    | اختيار.بعض(الهدف) -> {
        دع المتوقع: غير_موقع = الطول(الهدف.المعاملات) مثل غير_موقع;
        دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الفعلي) {
            دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة,
                حالة_النداء.الحجج[ف],
                الموضع.الكتلة,
                الموضع.الفهرس,
                الأخطاء
            );
            لو (ف < المتوقع) {
                طابق الحجة مع
                | اختيار.بعض(القيمة) -> {
                    دع نوع_المتوقع: معرف_نوع = الهدف.المعاملات[ف];
                    لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, القيمة.النوع
                            )
                        );
                    };
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق الهدف.الناتج مع
        | اختيار.لا_شيء -> {
            طابق حالة_التعليمة.الناتج مع
            | اختيار.بعض(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.بعض(نوع_المتوقع) -> {
            طابق حالة_التعليمة.الناتج مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع));
            }
            | اختيار.بعض(القيمة) -> {
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_المتوقع, القيمة.النوع
                        )
                    );
                };
            };
        };
        أرجع صواب;
    };
}

عرف هل_نوع_فراغ_لتحقق_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.بدائي(نوع_بدائي_مقنن.فراغ)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف تحقق_نداء_قيمة_دالة_مسير(
    النداء: &نداء_مسير,
    الدالة_القيمة: معرف_قيمة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الحالة: نداء_مسير = *النداء;
    طابق الحالة.مكان_التعديل مع
    | اختيار.بعض(_) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
    }
    | اختيار.لا_شيء -> { };

    دع الدالة_المتحققة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, الدالة_القيمة, الموضع.الكتلة, الموضع.الفهرس, الأخطاء
    );
    دع نوع_الدالة: متغير اختيار معرف_نوع = اختيار.لا_شيء();
    طابق الدالة_المتحققة مع
    | اختيار.بعض(القيمة) -> {
        طابق عدد_معاملات_دالة_دلالية(الأنواع, القيمة.النوع) مع
        | اختيار.بعض(_) -> { نوع_الدالة := اختيار.بعض(القيمة.النوع); }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(الدالة_القيمة, القيمة.النوع));
        };
    }
    | اختيار.لا_شيء -> { };

    تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء);
    طابق نوع_الدالة مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(نوع_الدالة_المقنن) -> {
        دع المتوقع: متغير غير_موقع = 0;
        طابق عدد_معاملات_دالة_دلالية(الأنواع, نوع_الدالة_المقنن) مع
        | اختيار.بعض(العدد) -> { المتوقع := العدد; }
        | اختيار.لا_شيء -> { };
        دع الفعلي: غير_موقع = الطول(الحالة.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي));
        };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الفعلي) {
            لو (ف < المتوقع) {
                طابق نوع_معامل_دالة_دلالي_عند(الأنواع, نوع_الدالة_المقنن, ف) مع
                | اختيار.بعض(نوع_المتوقع) -> {
                    طابق ابحث_تعريف_قيمة_مسير(الدالة, الحالة.الحجج[ف]) مع
                    | اختيار.بعض(التعريف) -> {
                        لو (!معرفا_نوع_متساويان(نوع_المتوقع, التعريف.القيمة.النوع)) {
                            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, ف, نوع_المتوقع, التعريف.القيمة.النوع
                            ));
                        };
                    }
                    | اختيار.لا_شيء -> { };
                }
                | اختيار.لا_شيء -> { };
            };
            ف := ف + 1;
        }
        طابق نوع_ناتج_دالة_دلالي(الأنواع, نوع_الدالة_المقنن) مع
        | اختيار.بعض(نوع_الناتج) -> {
            دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
            لو (هل_نوع_فراغ_لتحقق_مسير(الأنواع, نوع_الناتج)) {
                طابق حالة_التعليمة.الناتج مع
                | اختيار.بعض(_) -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); }
                | اختيار.لا_شيء -> { };
            } وإلا {
                طابق حالة_التعليمة.الناتج مع
                | اختيار.بعض(القيمة) -> {
                    لو (!معرفا_نوع_متساويان(نوع_الناتج, القيمة.النوع)) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_نداء_غير_مطابق(
                            الموضع, نوع_الناتج, القيمة.النوع
                        ));
                    };
                }
                | اختيار.لا_شيء -> { سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)); };
            };
        }
        | اختيار.لا_شيء -> { };
        أرجع صواب;
    };
}

عرف تحقق_نداء_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    طابق حالة_النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
        أرجع تحقق_نداء_دالة_سلطان_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء
        );
    }
    | هدف_نداء_مسير.دالة_خارجية(الهدف) -> {
        أرجع تحقق_نداء_دالة_خارجية_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء
        );
    }
    | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
        أرجع تحقق_نداء_قيمة_دالة_مسير(
            النداء, الدالة_القيمة, التعليمة, الموضع, الدالة, الأنواع, الأخطاء
        );
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(البدائي);
        دع المتوقع: غير_موقع = العقد.عدد_الحجج;
        دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };

        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        }
        | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        }
        | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        }
        | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        }
        | _ -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
            }
            | اختيار.لا_شيء -> { };
        };

        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء);

        // Exact primitive Type legality is owned by Frontend Type. MSIR contributes only
        // already-lowered ValueIDs and requires all source-level conversions to be explicit.
        دع الأنواع_المقننة_للبدائي: اختيار أنواع_استدعاء_بدائي_مقننة =
            أنواع_استدعاء_بدائي_مقننة_من_سجل(الأنواع);
        دع أنواع_حجج_البدائي: متغير متجه معرف_نوع = [];
        دع أنواع_الحجج_مكتملة: متغير منطقي = صواب;
        دع ف_نوع: متغير غير_موقع = 0;
        بينما (ف_نوع < الفعلي) {
            طابق ابحث_تعريف_قيمة_مسير(الدالة, حالة_النداء.الحجج[ف_نوع]) مع
            | اختيار.بعض(التعريف) -> {
                ألحق(أنواع_حجج_البدائي, التعريف.القيمة.النوع);
            }
            | اختيار.لا_شيء -> { أنواع_الحجج_مكتملة := خطأ; };
            ف_نوع := ف_نوع + 1;
        }
        طابق الأنواع_المقننة_للبدائي مع
        | اختيار.بعض(القيم_المقننة) -> {
            لو (أنواع_الحجج_مكتملة) {
                طابق تحقق_استدعاء_بدائي_مقنن(
                    الأنواع, &القيم_المقننة, البدائي, &أنواع_حجج_البدائي
                ) مع
                | نتيجة_استدعاء_بدائي.صالح(_) -> { }
                | نتيجة_استدعاء_بدائي.مرفوض(خطأ_النوع) -> {
                    طابق خطأ_النوع مع
                    | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(_, _) -> {
                        // Runtime arity was already reported above.
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, نوع_المتوقع, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, الفهرس, نوع_المتوقع, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_بدائية_غير_صالحة(
                                الموضع, البدائي, الفهرس, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
                        );
                    };
                };
            };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
            );
        };

        دع فهرس_حجة_التعديل: متغير اختيار غير_موقع = اختيار.لا_شيء();
        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> { فهرس_حجة_التعديل := اختيار.بعض(0); }
        | هوية_بدائي_مترجم.قراءة_مقطع_ملف -> { فهرس_حجة_التعديل := اختيار.بعض(1); }
        | هوية_بدائي_مترجم.قراءة_مدخل_دليل -> { فهرس_حجة_التعديل := اختيار.بعض(1); }
        | هوية_بدائي_مترجم.قراءة_مقطع_الدخل_القياسي -> { فهرس_حجة_التعديل := اختيار.بعض(0); }
        | _ -> { };
        طابق فهرس_حجة_التعديل مع
        | اختيار.بعض(فهرس_التعديل) -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(المكان) -> {
                لو (!هل_مكان_قابل_للكتابة_لمسير(الدالة, المكان, الأنواع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_قابل_للكتابة(الموضع)
                    );
                };
                لو (الفعلي > فهرس_التعديل) {
                    طابق ابحث_تعريف_قيمة_مسير(الدالة, حالة_النداء.الحجج[فهرس_التعديل]) مع
                    | اختيار.بعض(تعريف_الحجة) -> {
                        طابق ابحث_تعريف_قيمة_مسير(الدالة, المكان) مع
                        | اختيار.بعض(تعريف_المكان) -> {
                            لو (!معرفا_نوع_متساويان(
                                تعريف_الحجة.القيمة.النوع,
                                تعريف_المكان.القيمة.النوع
                            )) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_مكان_تعديل_نداء_غير_مطابق(
                                        الموضع,
                                        تعريف_الحجة.القيمة.النوع,
                                        تعريف_المكان.القيمة.النوع
                                    )
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };

        // Runtime يملك شكل الناتج الواسع وسلوك العودة؛ Type يحول الفئة نفسها إلى
        // عقد TypeID دقيق يستهلكه هذا المتحقق بلا جدول مواز.
        // عدم العودة طبيعيا يمنع كذلك قيمة ناتج للنداء، لكن MSIR الحالي لا يملك
        // منهي "لا يعود" يمكنه إثبات عدم استمرار التحكم بعد التعليمة.
        دع يتطلب_ناتج_قيمة: متغير منطقي = صواب;
        طابق العقد.فئة_الناتج مع
        | فئة_ناتج_بدائي.بلا_قيمة -> {
            يتطلب_ناتج_قيمة := خطأ;
        }
        | _ -> {
        };
        طابق العقد.سلوك_العودة مع
        | سلوك_عودة_بدائي.لا_يعود_طبيعيا -> {
            يتطلب_ناتج_قيمة := خطأ;
        }
        | سلوك_عودة_بدائي.يعود_طبيعيا -> {
        };

        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق حالة_التعليمة.الناتج مع
        | اختيار.بعض(قيمة_الناتج) -> {
            لو (!يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            } وإلا {
                طابق الأنواع_المقننة_للبدائي مع
                | اختيار.بعض(القيم_المقننة) -> {
                    لو (!هل_نوع_ناتج_استدعاء_بدائي_مقنن(
                        الأنواع, &القيم_المقننة, العقد.فئة_الناتج, قيمة_الناتج.النوع
                    )) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ناتج_بدائي_غير_مطابق(
                                الموضع, البدائي, قيمة_الناتج.النوع
                            )
                        );
                    };
                }
                | اختيار.لا_شيء -> { };
            };
        }
        | اختيار.لا_شيء -> {
            لو (يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            };
        };
        أرجع صواب;
    };
}

عرف تحقق_تعليمة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الفهرس: غير_موقع,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_الكتلة: كتلة_مسير = *الكتلة;
    دع التعليمة: &تعليمة_مسير = &حالة_الكتلة.التعليمات[الفهرس];
    دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
    دع حالة_الدالة: دالة_مسير = *الدالة;
    دع الموضع: موضع_تعليمة_مسير = {
        الدالة: حالة_الدالة.المعرف,
        الكتلة: حالة_الكتلة.المعرف,
        الفهرس: الفهرس
    };
    طابق حالة_التعليمة.العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        تحقق_ثابت_مسير(&الثابت, التعليمة, الموضع, الأنواع, الأخطاء);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        تحقق_حساب_صحيح_مسير(
            الحساب,
            التعليمة,
            الموضع,
            &حالة_الدالة,
            الأنواع,
            الأخطاء
        );
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        تحقق_حساب_عشري_مسير(الحساب, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        تحقق_مقارنة_عشرية_مسير(المقارنة, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        تحقق_مقارنة_صحيح_مسير(
            المقارنة,
            التعليمة,
            الموضع,
            &حالة_الدالة,
            الأنواع,
            الأخطاء
        );
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        تحقق_تحويل_صحيح_مسير(
            التحويل,
            التعليمة,
            الموضع,
            &حالة_الدالة,
            الأنواع,
            الأخطاء
        );
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        تحقق_مرجع_إلى_مؤشر_مسير(
            التحويل, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء
        );
    }
    | عملية_مسير.تجميع(العملية) -> {
        تحقق_تجميع_مسير(&العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.تهيئة_متجه(العملية) -> {
        تحقق_تهيئة_متجه_مسير(&العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.استخراج_حقل(العملية) -> {
        تحقق_استخراج_حقل_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.استخراج_فهرس(العملية) -> {
        دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
        تحقق_فهرس_مسير(العملية.المصدر, العملية.الفهرس, الناتج, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مكان_محلي(العملية) -> {
        نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        تحقق_مرجع_إلى_مكان_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        تحقق_صندوق_إلى_مكان_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        تحقق_مكان_حقل_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        تحقق_مكان_فهرس_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        تحقق_موضع_تخزين_عنصر_مؤشر_مسير(
            العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء
        );
    }
    | عملية_مسير.تحميل(العملية) -> {
        تحقق_تحميل_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأخطاء);
    }
    | عملية_مسير.تخزين(العملية) -> {
        تحقق_تخزين_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        تحقق_مكان_إلى_مرجع_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.بناء_موسوم(العملية) -> {
        تحقق_بناء_موسوم_مسير(&العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        تحقق_استعلام_وسم_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        تحقق_استخراج_حمولة_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        تحقق_بناء_صندوق_مسير(العملية, التعليمة, الموضع, &حالة_الدالة, الأنواع, الأخطاء);
    }
    | عملية_مسير.نداء(النداء) -> {
        تحقق_نداء_مسير(
            البرنامج,
            &النداء,
            التعليمة,
            الموضع,
            &حالة_الدالة,
            الأنواع,
            الأخطاء
        );
    };
    أرجع صواب;
}

عرف تحقق_حافة_مسير(
    الدالة: &دالة_مسير,
    الكتلة_المصدر: معرف_كتلة_مسير,
    الحافة: &حافة_مسير,
    موضع_الاستخدام: غير_موقع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع حالة_الحافة: حافة_مسير = *الحافة;
    لو (!كتلة_مسير_موجودة(&الحالة, حالة_الحافة.الهدف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_فرع_غير_صالح(الكتلة_المصدر, حالة_الحافة.الهدف)
        );
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(حالة_الحافة.الحجج) مثل غير_موقع)) {
            تحقق_استخدام_قيمة_مسير(
                &الحالة,
                حالة_الحافة.الحجج[ف],
                الكتلة_المصدر,
                موضع_الاستخدام,
                الأخطاء
            );
            ف := ف + 1;
        }
        أرجع خطأ;
    };
    دع مرجع_الهدف: &كتلة_مسير = &الحالة.الكتل[حالة_الحافة.الهدف.القيمة];
    دع الهدف: كتلة_مسير = *مرجع_الهدف;
    دع المتوقع: غير_موقع = الطول(الهدف.المعاملات) مثل غير_موقع;
    دع الفعلي: غير_موقع = الطول(حالة_الحافة.الحجج) مثل غير_موقع;
    لو (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_فرع_غير_مطابق(الكتلة_المصدر, حالة_الحافة.الهدف, المتوقع, الفعلي)
        );
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الفعلي) {
        دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            &الحالة,
            حالة_الحافة.الحجج[ف],
            الكتلة_المصدر,
            موضع_الاستخدام,
            الأخطاء
        );
        لو (ف < المتوقع) {
            طابق الحجة مع
            | اختيار.بعض(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = الهدف.المعاملات[ف].النوع;
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_فرع_غير_مطابق(
                            الكتلة_المصدر,
                            حالة_الحافة.الهدف,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف تحقق_منهي_مسير(
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع حالة_الدالة: دالة_مسير = *الدالة;
    دع حالة_الكتلة: كتلة_مسير = *الكتلة;
    دع الموضع: غير_موقع = الطول(حالة_الكتلة.التعليمات) مثل غير_موقع;
    طابق حالة_الكتلة.المنهي مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.كتلة_بلا_منهي(حالة_الكتلة.المعرف)
        );
        أرجع خطأ;
    }
    | اختيار.بعض(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            تحقق_حافة_مسير(
                &حالة_الدالة,
                حالة_الكتلة.المعرف,
                &الحافة,
                الموضع,
                الأخطاء
            );
        }
        | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
            دع قيمة_الشرط: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                &حالة_الدالة,
                الشرط,
                حالة_الكتلة.المعرف,
                الموضع,
                الأخطاء
            );
            طابق قيمة_الشرط مع
            | اختيار.بعض(القيمة) -> {
                لو (!هل_نوع_مسير_منطقي(الأنواع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شرط_فرع_غير_منطقي(
                            حالة_الكتلة.المعرف,
                            الشرط,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
            تحقق_حافة_مسير(
                &حالة_الدالة,
                حالة_الكتلة.المعرف,
                &عند_الصواب,
                الموضع,
                الأخطاء
            );
            تحقق_حافة_مسير(
                &حالة_الدالة,
                حالة_الكتلة.المعرف,
                &عند_الخطأ,
                الموضع,
                الأخطاء
            );
        }
        | منهي_مسير.إرجاع(القيمة) -> {
            طابق حالة_الدالة.الناتج مع
            | اختيار.لا_شيء -> {
                طابق القيمة مع
                | اختيار.بعض(المعرف) -> {
                    تحقق_استخدام_قيمة_مسير(
                        &حالة_الدالة,
                        المعرف,
                        حالة_الكتلة.المعرف,
                        الموضع,
                        الأخطاء
                    );
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق(حالة_الكتلة.المعرف)
                    );
                }
                | اختيار.لا_شيء -> {
                };
            }
            | اختيار.بعض(نوع_المتوقع) -> {
                طابق القيمة مع
                | اختيار.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق(حالة_الكتلة.المعرف)
                    );
                }
                | اختيار.بعض(المعرف) -> {
                    دع قيمة_الإرجاع: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        &حالة_الدالة,
                        المعرف,
                        حالة_الكتلة.المعرف,
                        الموضع,
                        الأخطاء
                    );
                    طابق قيمة_الإرجاع مع
                    | اختيار.بعض(الموجود) -> {
                        لو (!معرفا_نوع_متساويان(نوع_المتوقع, الموجود.النوع)) {
                            سجل_خطأ_مسير(
                                الأخطاء,
                                خطأ_تحقق_مسير.نوع_إرجاع_غير_مطابق(
                                    حالة_الكتلة.المعرف,
                                    نوع_المتوقع,
                                    الموجود.النوع
                                )
                            );
                        };
                    }
                    | اختيار.لا_شيء -> {
                    };
                };
            };
        }
        | منهي_مسير.فخ -> {
        };
    };
    أرجع صواب;
}

عرف تحقق_تعريفات_قيم_مسير(
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع التعريفات: متجه تعريف_قيمة_مسير = اجمع_تعريفات_قيم_مسير(&الحالة);
    دع عدد_التعريفات: غير_موقع = الطول(التعريفات) مثل غير_موقع;
    دع عدد_القيم_المقننة: غير_موقع = الطول(الحالة.القيم) مثل غير_موقع;

    لو (عدد_التعريفات != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_قيم_دالة_غير_متطابق(
                الحالة.المعرف, عدد_التعريفات, عدد_القيم_المقننة
            )
        );
    };
    لو (الحالة.القيمة_التالية != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عداد_قيم_دالة_غير_متطابق(
                الحالة.المعرف, عدد_القيم_المقننة, الحالة.القيمة_التالية
            )
        );
    };

    دع المرئية: متغير متجه منطقي = [];
    دع تهيئة: متغير غير_موقع = 0;
    بينما (تهيئة < عدد_التعريفات) {
        ألحق(المرئية, خطأ);
        تهيئة := تهيئة + 1;
    }

    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_التعريفات) {
        دع القيمة: قيمة_مسير = التعريفات[ف].القيمة;
        لو (!دالتا_مسير_متساويتان(القيمة.المعرف.الدالة, الحالة.المعرف)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(القيمة.المعرف, الحالة.المعرف)
            );
        };
        لو (القيمة.المعرف.القيمة >= عدد_التعريفات) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن(الحالة.المعرف, القيمة.المعرف.القيمة)
            );
        } وإلا {
            لو (المرئية[القيمة.المعرف.القيمة]) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.معرف_قيمة_مكرر(القيمة.المعرف)
                );
            } وإلا {
                المرئية[القيمة.المعرف.القيمة] := صواب;
            };
            لو (القيمة.المعرف.القيمة < عدد_القيم_المقننة) {
                دع المقننة: قيمة_مسير = الحالة.القيم[القيمة.المعرف.القيمة];
                لو (
                    !قيمتا_مسير_متساويتان(المقننة.المعرف, القيمة.المعرف)
                    || !معرفا_نوع_متساويان(المقننة.النوع, القيمة.النوع)
                ) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(
                            الحالة.المعرف, القيمة.المعرف.القيمة
                        )
                    );
                };
            };
        };
        لو (!نوع_مسير_صالح(الأنواع, القيمة.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(القيمة.المعرف, القيمة.النوع)
            );
        };
        ف := ف + 1;
    }

    دع المتوقع: متغير غير_موقع = 0;
    بينما (المتوقع < عدد_التعريفات) {
        لو (!المرئية[المتوقع]) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن(الحالة.المعرف, المتوقع)
            );
        };
        المتوقع := المتوقع + 1;
    }

    دع م: متغير غير_موقع = 0;
    بينما (م < عدد_القيم_المقننة) {
        دع المقننة: قيمة_مسير = الحالة.القيم[م];
        لو (
            !دالتا_مسير_متساويتان(المقننة.المعرف.الدالة, الحالة.المعرف)
            || (المقننة.المعرف.القيمة != م)
        ) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(الحالة.المعرف, م)
            );
        };
        لو (!نوع_مسير_صالح(الأنواع, المقننة.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(المقننة.المعرف, المقننة.النوع)
            );
        };
        م := م + 1;
    }
    أرجع صواب;
}

عرف تحقق_دالة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الفهرس: غير_موقع,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    لو (الحالة.المعرف.القيمة != الفهرس) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.معرف_دالة_غير_مقنن(الحالة.المعرف, الفهرس)
        );
    };
    طابق الحالة.الناتج مع
    | اختيار.بعض(النوع) -> {
        لو (!نوع_مسير_صالح(الأنواع, النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_ناتج_دالة_غير_صالح(الحالة.المعرف, النوع)
            );
        };
    }
    | اختيار.لا_شيء -> {
    };

    طابق الحالة.المدخل مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.دالة_بلا_مدخل(الحالة.المعرف));
    }
    | اختيار.بعض(المدخل) -> {
        دع المدخل_صالح: منطقي = كتلة_مسير_موجودة(&الحالة, المدخل);
        لو (!المدخل_صالح) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.مدخل_غير_صالح(الحالة.المعرف, المدخل)
            );
        };
        لو (المدخل_صالح) {
            لو ((الطول(الحالة.الكتل[المدخل.القيمة].المعاملات) مثل غير_موقع) > 0) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.كتلة_مدخل_بمعاملات(المدخل)
                );
            };
        };
    };

    تحقق_تعريفات_قيم_مسير(&الحالة, الأنواع, الأخطاء);
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع مرجع_الكتلة: &كتلة_مسير = &الحالة.الكتل[ك];
        دع الكتلة: كتلة_مسير = *مرجع_الكتلة;
        لو (!دالتا_مسير_متساويتان(الكتلة.المعرف.الدالة, الحالة.المعرف)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.كتلة_من_دالة_أخرى(الكتلة.المعرف, الحالة.المعرف)
            );
        };
        لو (الكتلة.المعرف.القيمة != ك) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_كتلة_غير_مقنن(الكتلة.المعرف, ك)
            );
        };
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الكتلة.التعليمات) مثل غير_موقع)) {
            تحقق_تعليمة_مسير(
                البرنامج,
                &الحالة,
                &الكتلة,
                ت,
                الأنواع,
                الأخطاء
            );
            ت := ت + 1;
        }
        تحقق_منهي_مسير(&الحالة, &الكتلة, الأنواع, الأخطاء);
        ك := ك + 1;
    }
    أرجع صواب;
}

عام عرف تحقق_برنامج_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_تحقق_مسير {
    دع الحالة: برنامج_مسير = *البرنامج;
    دع الأخطاء: متغير متجه خطأ_تحقق_مسير = [];
    طابق الحالة.دالة_بدء_البرنامج مع
    | اختيار.بعض(الدالة) -> {
        لو (!دالة_مسير_موجودة(&الحالة, الدالة)) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.دالة_بدء_برنامج_غير_موجودة(الدالة)
            );
        };
    }
    | اختيار.لا_شيء -> { };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الدوال) مثل غير_موقع)) {
        دع مرجع_الدالة: &دالة_مسير = &الحالة.الدوال[ف];
        دع الدالة: دالة_مسير = *مرجع_الدالة;
        تحقق_دالة_مسير(&الحالة, &الدالة, ف, الأنواع, &متغير الأخطاء);
        ف := ف + 1;
    }
    لو ((الطول(الأخطاء) مثل غير_موقع) == 0) {
        أرجع نتيجة_تحقق_مسير.صالح();
    };
    أرجع نتيجة_تحقق_مسير.مرفوض(الأخطاء);
}
