استورد compiler.frontend.types.type_context;
عام نوع موضع_تعليمة_مسير = {
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: غير_موقع
};

عام نوع خطأ_تحقق_مسير =
    | دالة_بدء_برنامج_غير_موجودة بنوع معرف_دالة_مسير
    | معرف_دالة_غير_مقنن بنوع (معرف_دالة_مسير, غير_موقع)
    | دالة_بلا_مدخل بنوع معرف_دالة_مسير
    | مدخل_غير_صالح بنوع (معرف_دالة_مسير, معرف_كتلة_مسير)
    | كتلة_مدخل_بمعاملات بنوع معرف_كتلة_مسير
    | نوع_ناتج_دالة_غير_صالح بنوع (معرف_دالة_مسير, معرف_نوع)
    | معرف_كتلة_غير_مقنن بنوع (معرف_كتلة_مسير, غير_موقع)
    | كتلة_من_دالة_أخرى بنوع (معرف_كتلة_مسير, معرف_دالة_مسير)
    | كتلة_بلا_منهي بنوع معرف_كتلة_مسير
    | معرف_قيمة_مكرر بنوع معرف_قيمة_مسير
    | معرف_قيمة_غير_مقنن بنوع (معرف_دالة_مسير, غير_موقع)
    | عدد_قيم_دالة_غير_متطابق بنوع (معرف_دالة_مسير, غير_موقع, غير_موقع)
    | قيمة_مقننة_غير_متطابقة بنوع (معرف_دالة_مسير, غير_موقع)
    | عداد_قيم_دالة_غير_متطابق بنوع (معرف_دالة_مسير, غير_موقع, غير_موقع)
    | قيمة_من_دالة_أخرى بنوع (معرف_قيمة_مسير, معرف_دالة_مسير)
    | قيمة_غير_موجودة بنوع معرف_قيمة_مسير
    | نوع_قيمة_غير_صالح بنوع (معرف_قيمة_مسير, معرف_نوع)
    | استخدام_قبل_التعريف بنوع (معرف_قيمة_مسير, موضع_تعليمة_مسير)
    | تعريف_لا_يهيمن بنوع (معرف_قيمة_مسير, معرف_كتلة_مسير)
    | تعليمة_بلا_ناتج بنوع موضع_تعليمة_مسير
    | نوع_ثابت_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | معامل_حساب_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوعا_معاملين_غير_متطابقين بنوع موضع_تعليمة_مسير
    | إشارة_عملية_حساب_غير_مطابقة بنوع (موضع_تعليمة_مسير, عملية_حساب_صحيح, معرف_نوع)
    | نوع_ناتج_حساب_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_ناتج_مقارنة_غير_منطقي بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | تحويل_صحيح_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | تحويل_مرجع_إلى_مؤشر_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | مكان_مستخدم_كقيمة بنوع (موضع_تعليمة_مسير, معرف_قيمة_مسير)
    | قيمة_مستخدمة_كمكان بنوع (موضع_تعليمة_مسير, معرف_قيمة_مسير)
    | تعليمة_بناتج_غير_متوقع بنوع موضع_تعليمة_مسير
    | تجميع_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | عضو_تجميع_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, معرف_نوع, معرف_نوع)
    | حقل_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, غير_موقع)
    | نوع_حقل_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | فهرسة_غير_صالحة بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_فهرس_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_عنصر_فهرس_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | مرجع_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_مكان_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | تخزين_غير_متوافق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_مرجع_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_موسوم_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | منشئ_موسوم_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, غير_موقع)
    | حمولة_موسومة_غير_صالحة بنوع (موضع_تعليمة_مسير, معرف_نوع, غير_موقع, غير_موقع)
    | عدد_حمولات_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, غير_موقع)
    | نوع_حمولة_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, معرف_نوع, معرف_نوع)
    | نوع_وسم_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | صندوق_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | هدف_نداء_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_دالة_مسير)
    | هدف_نداء_خارجي_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_دالة_خارجية_مسير)
    | عدد_حجج_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, غير_موقع)
    | نوع_حجة_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, غير_موقع, معرف_نوع, معرف_نوع)
    | شكل_ناتج_نداء_غير_مطابق بنوع موضع_تعليمة_مسير
    | نوع_ناتج_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_حجة_بدائية_غير_صالحة بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم, غير_موقع, معرف_نوع)
    | عقد_نوع_بدائي_غير_متاح بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم)
    | نوع_ناتج_بدائي_غير_مطابق بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم, معرف_نوع)
    | مكان_تعديل_نداء_مفقود بنوع موضع_تعليمة_مسير
    | مكان_تعديل_نداء_غير_متوقع بنوع موضع_تعليمة_مسير
    | مكان_تعديل_نداء_غير_قابل_للكتابة بنوع موضع_تعليمة_مسير
    | نوع_مكان_تعديل_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | هدف_فرع_غير_صالح بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير)
    | عدد_حجج_فرع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير, غير_موقع, غير_موقع)
    | نوع_حجة_فرع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير, غير_موقع, معرف_نوع, معرف_نوع)
    | شرط_فرع_غير_منطقي بنوع (معرف_كتلة_مسير, معرف_قيمة_مسير, معرف_نوع)
    | شكل_إرجاع_غير_مطابق بنوع معرف_كتلة_مسير
    | نوع_إرجاع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_نوع, معرف_نوع)
;

عام نوع نتيجة_تحقق_مسير =
    | صالح
    | مرفوض بنوع متجه خطأ_تحقق_مسير
;

نوع موضع_تعريف_قيمة_مسير =
    | معامل_دالة
    | معامل_كتلة بنوع معرف_كتلة_مسير
    | تعليمة بنوع (معرف_كتلة_مسير, غير_موقع)
;

نوع تعريف_قيمة_مسير = {
    القيمة: قيمة_مسير,
    الموضع: موضع_تعريف_قيمة_مسير
};

نوع إشارة_صحيح_مسير =
    | موقع
    | غير_موقع
;

نوع وصف_صحيح_مسير = {
    الإشارة: إشارة_صحيح_مسير,
    البتات: غير_موقع
};

عرف سجل_خطأ_مسير(
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    المشكلة: خطأ_تحقق_مسير
): منطقي {
    دع الحالة: متغير متجه خطأ_تحقق_مسير = *الأخطاء;
    ألحق(الحالة, المشكلة);
    *الأخطاء := الحالة;
    أرجع صواب;
}

عرف نوع_مسير_صالح(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع معرف_نوع_صالح(الأنواع, المعرف);
}

عرف هل_نوع_مسير_منطقي(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.منطقي -> {
                أرجع صواب;
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف هل_نوع_مسير_عشري(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف وصف_صحيح_لمسير(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار وصف_صحيح_مسير {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(وصف_النوع) -> {
        طابق وصف_النوع.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.موقع();
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختيار.بعض(الوصف);
            }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.غير_موقع();
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختيار.بعض(الوصف);
            }
            | _ -> {
                أرجع اختيار.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختيار.لا_شيء();
        };
    };
}


عرف وصف_مصدر_تحويل_صحيح_لمسير(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختيار وصف_صحيح_مسير {
    طابق وصف_صحيح_لمسير(الأنواع, المعرف) مع
    | اختيار.بعض(الوصف) -> {
        أرجع اختيار.بعض(الوصف);
    }
    | اختيار.لا_شيء -> { };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختيار.بعض(وصف_النوع) -> {
        طابق وصف_النوع.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            لو (البدائي == نوع_بدائي_مقنن.حرف()) {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.غير_موقع();
                دع البتات: غير_موقع = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختيار.بعض(الوصف);
            };
        }
        | _ -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}

عرف اجمع_تعريفات_قيم_مسير(الدالة: &دالة_مسير): متجه تعريف_قيمة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع التعريفات: متغير متجه تعريف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.المعاملات) مثل غير_موقع)) {
        دع موضع_المعامل: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.معامل_دالة();
        دع التعريف: تعريف_قيمة_مسير = {
            القيمة: الحالة.المعاملات[ف],
            الموضع: موضع_المعامل
        };
        ألحق(التعريفات, التعريف);
        ف := ف + 1;
    }

    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع مرجع_الكتلة: &كتلة_مسير = &الحالة.الكتل[ك];
        دع الكتلة: كتلة_مسير = *مرجع_الكتلة;
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول(الكتلة.المعاملات) مثل غير_موقع)) {
            دع موضع_المعامل: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.معامل_كتلة(الكتلة.المعرف);
            دع التعريف: تعريف_قيمة_مسير = {
                القيمة: الكتلة.المعاملات[م],
                الموضع: موضع_المعامل
            };
            ألحق(التعريفات, التعريف);
            م := م + 1;
        }
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الكتلة.التعليمات) مثل غير_موقع)) {
            طابق الكتلة.التعليمات[ت].الناتج مع
            | اختيار.بعض(القيمة) -> {
                دع موضع_التعليمة: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.تعليمة(الكتلة.المعرف, ت);
                دع التعريف: تعريف_قيمة_مسير = {
                    القيمة: القيمة,
                    الموضع: موضع_التعليمة
                };
                ألحق(التعريفات, التعريف);
            }
            | اختيار.لا_شيء -> {
            };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع التعريفات;
}

عرف ابحث_تعريف_قيمة_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير
): اختيار تعريف_قيمة_مسير {
    دع التعريفات: متجه تعريف_قيمة_مسير = اجمع_تعريفات_قيم_مسير(الدالة);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(التعريفات) مثل غير_موقع)) {
        لو (قيمتا_مسير_متساويتان(التعريفات[ف].القيمة.المعرف, المعرف)) {
            أرجع اختيار.بعض(التعريفات[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف تحتوي_معرفات_كتل_مسير(
    القيم: &متجه معرف_كتلة_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    دع الحالة: متجه معرف_كتلة_مسير = *القيم;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (كتلتان_مسير_متساويتان(الحالة[ف], المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف هل_كتلة_محظورة_لمسير(
    المعرف: معرف_كتلة_مسير,
    المحظورة: &اختيار معرف_كتلة_مسير
): منطقي {
    دع الحالة: اختيار معرف_كتلة_مسير = *المحظورة;
    طابق الحالة مع
    | اختيار.بعض(القيمة) -> {
        أرجع كتلتان_مسير_متساويتان(المعرف, القيمة);
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف يمكن_الوصول_في_مسير(
    الدالة: &دالة_مسير,
    البداية: معرف_كتلة_مسير,
    الهدف: معرف_كتلة_مسير,
    المحظورة: اختيار معرف_كتلة_مسير
): منطقي {
    لو (!كتلة_مسير_موجودة(الدالة, البداية) || !كتلة_مسير_موجودة(الدالة, الهدف)) {
        أرجع خطأ;
    };
    لو (هل_كتلة_محظورة_لمسير(البداية, &المحظورة)) {
        أرجع خطأ;
    };
    دع الانتظار: متغير متجه معرف_كتلة_مسير = [];
    دع المزارة: متغير متجه معرف_كتلة_مسير = [];
    ألحق(الانتظار, البداية);
    دع موضع: متغير غير_موقع = 0;
    دع الحالة: دالة_مسير = *الدالة;

    بينما (موضع < (الطول(الانتظار) مثل غير_موقع)) {
        دع الحالية: معرف_كتلة_مسير = الانتظار[موضع];
        موضع := موضع + 1;
        لو (!تحتوي_معرفات_كتل_مسير(&المزارة, الحالية)) {
            ألحق(المزارة, الحالية);
            لو (كتلتان_مسير_متساويتان(الحالية, الهدف)) {
                أرجع صواب;
            };
            دع الكتلة: &كتلة_مسير = &الحالة.الكتل[الحالية.القيمة];
            دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(الكتلة);
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الخلفاء) مثل غير_موقع)) {
                دع التالي: معرف_كتلة_مسير = الخلفاء[ف];
                لو (
                    كتلة_مسير_موجودة(&الحالة, التالي)
                    && !هل_كتلة_محظورة_لمسير(التالي, &المحظورة)
                    && !تحتوي_معرفات_كتل_مسير(&المزارة, التالي)
                ) {
                    ألحق(الانتظار, التالي);
                };
                ف := ف + 1;
            }
        };
    }
    أرجع خطأ;
}

عرف هل_كتلة_تهيمن_في_مسير(
    الدالة: &دالة_مسير,
    المهيمنة: معرف_كتلة_مسير,
    التابعة: معرف_كتلة_مسير
): منطقي {
    لو (كتلتان_مسير_متساويتان(المهيمنة, التابعة)) {
        أرجع صواب;
    };
    دع الحالة: دالة_مسير = *الدالة;
    طابق الحالة.المدخل مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(المدخل) -> {
        دع بلا_حظر: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
        لو (!يمكن_الوصول_في_مسير(&الحالة, المدخل, التابعة, بلا_حظر)) {
            أرجع خطأ;
        };
        لو (كتلتان_مسير_متساويتان(المهيمنة, المدخل)) {
            أرجع صواب;
        };
        دع بلا_حظر_للمهيمنة: اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
        لو (!يمكن_الوصول_في_مسير(&الحالة, المدخل, المهيمنة, بلا_حظر_للمهيمنة)) {
            أرجع خطأ;
        };
        دع الحظر: اختيار معرف_كتلة_مسير = اختيار.بعض(المهيمنة);
        أرجع !يمكن_الوصول_في_مسير(&الحالة, المدخل, التابعة, الحظر);
    };
}

عرف هل_تعريف_مكان_مسير(
    الدالة: &دالة_مسير,
    التعريف: &تعريف_قيمة_مسير
): منطقي {
    دع حالة_الدالة: دالة_مسير = *الدالة;
    دع حالة_التعريف: تعريف_قيمة_مسير = *التعريف;
    طابق حالة_التعريف.الموضع مع
    | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
        لو (الكتلة.القيمة >= (الطول(حالة_الدالة.الكتل) مثل غير_موقع)) {
            أرجع خطأ;
        };
        دع مرجع_الكتلة: &كتلة_مسير = &حالة_الدالة.الكتل[الكتلة.القيمة];
        دع حالة_الكتلة: كتلة_مسير = *مرجع_الكتلة;
        لو (الفهرس >= (الطول(حالة_الكتلة.التعليمات) مثل غير_موقع)) {
            أرجع خطأ;
        };
        طابق حالة_الكتلة.التعليمات[الفهرس].العملية مع
        | عملية_مسير.مكان_محلي(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مكان_حقل(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مكان_فهرس(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف تحقق_استخدام_هوية_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: غير_موقع,
    يقبل_مكانا: منطقي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): اختيار قيمة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    لو (!دالتا_مسير_متساويتان(المعرف.الدالة, الحالة.المعرف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(المعرف, الحالة.المعرف)
        );
        أرجع اختيار.لا_شيء();
    };
    دع التعريف: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير(&الحالة, المعرف);
    طابق التعريف مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.قيمة_غير_موجودة(المعرف));
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الموجود) -> {
        طابق الموجود.الموضع مع
        | موضع_تعريف_قيمة_مسير.معامل_دالة -> {
        }
        | موضع_تعريف_قيمة_مسير.معامل_كتلة(كتلة_التعريف) -> {
            لو (!كتلتان_مسير_متساويتان(كتلة_التعريف, الكتلة)) {
                لو (!هل_كتلة_تهيمن_في_مسير(&الحالة, كتلة_التعريف, الكتلة)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تعريف_لا_يهيمن(المعرف, الكتلة)
                    );
                };
            };
        }
        | موضع_تعريف_قيمة_مسير.تعليمة(كتلة_التعريف, موضع_التعريف) -> {
            لو (كتلتان_مسير_متساويتان(كتلة_التعريف, الكتلة)) {
                لو (موضع_التعريف >= موضع_الاستخدام) {
                    دع الموضع: موضع_تعليمة_مسير = {
                        الدالة: الحالة.المعرف,
                        الكتلة: الكتلة,
                        الفهرس: موضع_الاستخدام
                    };
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.استخدام_قبل_التعريف(المعرف, الموضع)
                    );
                };
            } وإلا {
                لو (!هل_كتلة_تهيمن_في_مسير(&الحالة, كتلة_التعريف, الكتلة)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تعريف_لا_يهيمن(المعرف, الكتلة)
                    );
                };
            };
        };
        لو (!يقبل_مكانا && هل_تعريف_مكان_مسير(&الحالة, &الموجود)) {
            دع الموضع: موضع_تعليمة_مسير = {
                الدالة: الحالة.المعرف,
                الكتلة: الكتلة,
                الفهرس: موضع_الاستخدام
            };
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.مكان_مستخدم_كقيمة(الموضع, المعرف)
            );
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(الموجود.القيمة);
    };
}

عرف تحقق_استخدام_قيمة_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: غير_موقع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): اختيار قيمة_مسير {
    أرجع تحقق_استخدام_هوية_مسير(
        الدالة, المعرف, الكتلة, موضع_الاستخدام, خطأ, الأخطاء
    );
}

عرف تحقق_استخدام_مكان_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: غير_موقع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): اختيار قيمة_مسير {
    دع القيمة: اختيار قيمة_مسير = تحقق_استخدام_هوية_مسير(
        الدالة, المعرف, الكتلة, موضع_الاستخدام, صواب, الأخطاء
    );
    طابق القيمة مع
    | اختيار.لا_شيء -> {
        أرجع اختيار.لا_شيء();
    }
    | اختيار.بعض(الموجودة) -> {
        طابق ابحث_تعريف_قيمة_مسير(الدالة, المعرف) مع
        | اختيار.بعض(التعريف) -> {
            لو (هل_تعريف_مكان_مسير(الدالة, &التعريف)) {
                أرجع اختيار.بعض(الموجودة);
            };
        }
        | اختيار.لا_شيء -> { };
        دع حالة_الدالة: دالة_مسير = *الدالة;
        دع الموضع: موضع_تعليمة_مسير = {
            الدالة: حالة_الدالة.المعرف,
            الكتلة: الكتلة,
            الفهرس: موضع_الاستخدام
        };
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.قيمة_مستخدمة_كمكان(الموضع, المعرف)
        );
        أرجع اختيار.لا_شيء();
    };
}

عرف نتيجة_تعليمة_مسير(
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): اختيار قيمة_مسير {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(القيمة);
    }
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تعليمة_بلا_ناتج(الموضع));
        أرجع اختيار.لا_شيء();
    };
}

عرف هل_موقعان_متساويان(أ: إشارة_صحيح_مسير, ب: إشارة_صحيح_مسير): منطقي {
    طابق أ مع
    | إشارة_صحيح_مسير.موقع -> {
        طابق ب مع
        | إشارة_صحيح_مسير.موقع -> {
            أرجع صواب;
        }
        | إشارة_صحيح_مسير.غير_موقع -> {
            أرجع خطأ;
        };
    }
    | إشارة_صحيح_مسير.غير_موقع -> {
        طابق ب مع
        | إشارة_صحيح_مسير.غير_موقع -> {
            أرجع صواب;
        }
        | إشارة_صحيح_مسير.موقع -> {
            أرجع خطأ;
        };
    };
}

عرف هل_قيمة_موقعة_تلائم(القيمة: عدد, البتات: غير_موقع): منطقي {
    لو (البتات == 8) {
        أرجع (القيمة >= -128) && (القيمة <= 127);
    };
    لو (البتات == 16) {
        أرجع (القيمة >= -32768) && (القيمة <= 32767);
    };
    لو (البتات == 32) {
        أرجع (القيمة >= -2147483648) && (القيمة <= 2147483647);
    };
    أرجع البتات == 64;
}

عرف هل_قيمة_غير_موقعة_تلائم(القيمة: غير_موقع, البتات: غير_موقع): منطقي {
    لو (البتات == 8) {
        أرجع القيمة <= 255;
    };
    لو (البتات == 16) {
        أرجع القيمة <= 65535;
    };
    لو (البتات == 32) {
        أرجع القيمة <= 4294967295;
    };
    أرجع البتات == 64;
}

عرف تحقق_ثابت_مسير(
    الثابت: &ثابت_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(القيمة) -> {
        طابق *الثابت مع
        | ثابت_مسير.منطق(الحقيقة) -> {
            لو (!هل_نوع_مسير_منطقي(الأنواع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.صحيح_موقع(العدد) -> {
            طابق وصف_صحيح_لمسير(الأنواع, القيمة.النوع) مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            }
            | اختيار.بعض(الوصف) -> {
                طابق الوصف.الإشارة مع
                | إشارة_صحيح_مسير.موقع -> {
                    لو (!هل_قيمة_موقعة_تلائم(العدد, الوصف.البتات)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | إشارة_صحيح_مسير.غير_موقع -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            };
        }
        | ثابت_مسير.صحيح_غير_موقع(العدد) -> {
            طابق وصف_صحيح_لمسير(الأنواع, القيمة.النوع) مع
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            }
            | اختيار.بعض(الوصف) -> {
                طابق الوصف.الإشارة مع
                | إشارة_صحيح_مسير.غير_موقع -> {
                    لو (!هل_قيمة_غير_موقعة_تلائم(العدد, الوصف.البتات)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | إشارة_صحيح_مسير.موقع -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            };
        }
        | ثابت_مسير.دالة(الهدف) -> {
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة.النوع) مع
            | اختيار.بعض(الوصف) -> {
                طابق الوصف.الصنف مع
                | صنف_شكل_نوع_دلالي.دالة -> { }
                | _ -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.عشري(البايتات) -> {
            لو (!هل_نوع_مسير_عشري(الأنواع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.نص(البايتات) -> {
            // البايتات مقننة ومفكوكة قبل MSIR؛ verifier يتحقق من Type فقط ولا يعيد تفسير المحتوى.
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة.النوع) مع
            | اختيار.بعض(الوصف) -> {
                طابق الوصف.الصنف مع
                | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                    طابق البدائي مع
                    | نوع_بدائي_مقنن.نص -> { }
                    | _ -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | _ -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        };
        أرجع صواب;
    };
}

عرف إشارة_مطلوبة_لعملية_حساب_مسير(
    العملية: عملية_حساب_صحيح
): اختيار إشارة_صحيح_مسير {
    طابق العملية مع
    | عملية_حساب_صحيح.قسمة_موقعة -> {
        أرجع اختيار.بعض(إشارة_صحيح_مسير.موقع());
    }
    | عملية_حساب_صحيح.باقي_موقع -> {
        أرجع اختيار.بعض(إشارة_صحيح_مسير.موقع());
    }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> {
        أرجع اختيار.بعض(إشارة_صحيح_مسير.غير_موقع());
    }
    | عملية_حساب_صحيح.باقي_غير_موقع -> {
        أرجع اختيار.بعض(إشارة_صحيح_مسير.غير_موقع());
    }
    | _ -> {
        أرجع اختيار.لا_شيء();
    };
}

عرف تحقق_إشارة_عملية_حساب_مسير(
    الحساب: حساب_صحيح_مسير,
    الوصف: وصف_صحيح_مسير,
    النوع: معرف_نوع,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    طابق إشارة_مطلوبة_لعملية_حساب_مسير(الحساب.العملية) مع
    | اختيار.لا_شيء -> {
        أرجع صواب;
    }
    | اختيار.بعض(المطلوبة) -> {
        لو (!هل_موقعان_متساويان(الوصف.الإشارة, المطلوبة)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.إشارة_عملية_حساب_غير_مطابقة(
                    الموضع,
                    الحساب.العملية,
                    النوع
                )
            );
            أرجع خطأ;
        };
        أرجع صواب;
    };
}

عرف تحقق_حساب_صحيح_مسير(
    الحساب: حساب_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع اليسار: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        الحساب.اليسار,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء
    );
    دع اليمين: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        الحساب.اليمين,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء
    );
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق اليسار مع
    | اختيار.بعض(أ) -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع)
            );
        }
        | اختيار.بعض(الوصف) -> {
            تحقق_إشارة_عملية_حساب_مسير(
                الحساب,
                الوصف,
                أ.النوع,
                الموضع,
                الأخطاء
            );
        };
        طابق اليمين مع
        | اختيار.بعض(ب) -> {
            لو (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع)
                );
            };
        }
        | اختيار.لا_شيء -> {
        };
        طابق الناتج مع
        | اختيار.بعض(ن) -> {
            لو (!معرفا_نوع_متساويان(أ.النوع, ن.النوع)) {
                دع مرجع_نوع_المعامل: &معرف_نوع = &أ.النوع;
                دع مرجع_نوع_الناتج: &معرف_نوع = &ن.النوع;
                دع نوع_المعامل: معرف_نوع = *مرجع_نوع_المعامل;
                دع نوع_الناتج: معرف_نوع = *مرجع_نوع_الناتج;
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, نوع_المعامل, نوع_الناتج)
                );
            };
        }
        | اختيار.لا_شيء -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    طابق اليمين مع
    | اختيار.بعض(ب) -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع)
            );
        }
        | اختيار.بعض(الوصف) -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    أرجع صواب;
}

عرف تحقق_حساب_عشري_مسير(
    الحساب: حساب_عشري_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع اليسار: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الحساب.اليسار, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع اليمين: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الحساب.اليمين, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق اليسار مع
    | اختيار.بعض(أ) -> {
        لو (!هل_نوع_مسير_عشري(الأنواع, أ.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
        };
        طابق اليمين مع
        | اختيار.بعض(ب) -> {
            لو (!هل_نوع_مسير_عشري(الأنواع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
            };
            لو (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع));
            };
        }
        | اختيار.لا_شيء -> { };
        طابق الناتج مع
        | اختيار.بعض(ن) -> {
            لو (!معرفا_نوع_متساويان(أ.النوع, ن.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, أ.النوع, ن.النوع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مقارنة_عشرية_مسير(
    المقارنة: مقارنة_عشري_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع اليسار: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, المقارنة.اليسار, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع اليمين: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, المقارنة.اليمين, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    طابق اليسار مع
    | اختيار.بعض(أ) -> {
        لو (!هل_نوع_مسير_عشري(الأنواع, أ.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
        };
        طابق اليمين مع
        | اختيار.بعض(ب) -> {
            لو (!هل_نوع_مسير_عشري(الأنواع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
            };
            لو (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع));
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    طابق نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء) مع
    | اختيار.بعض(ن) -> {
        لو (!هل_نوع_مسير_منطقي(الأنواع, ن.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_مقارنة_غير_منطقي(الموضع, ن.النوع));
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مقارنة_صحيح_مسير(
    المقارنة: مقارنة_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع اليسار: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        المقارنة.اليسار,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء
    );
    دع اليمين: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        المقارنة.اليمين,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء
    );
    طابق اليسار مع
    | اختيار.بعض(أ) -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع)
            );
        }
        | اختيار.بعض(الوصف) -> {
        };
        طابق اليمين مع
        | اختيار.بعض(ب) -> {
            لو (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع)
                );
            };
        }
        | اختيار.لا_شيء -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    طابق اليمين مع
    | اختيار.بعض(ب) -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع)
            );
        }
        | اختيار.بعض(الوصف) -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    طابق نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء) مع
    | اختيار.بعض(الناتج) -> {
        لو (!هل_نوع_مسير_منطقي(الأنواع, الناتج.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_ناتج_مقارنة_غير_منطقي(الموضع, الناتج.النوع)
            );
        };
    }
    | اختيار.لا_شيء -> {
    };
    أرجع صواب;
}

عرف تحويل_صحيح_مسموح_لمسير(
    العملية: عملية_تحويل_صحيح,
    المصدر: وصف_صحيح_مسير,
    الهدف: وصف_صحيح_مسير
): منطقي {
    طابق العملية مع
    | عملية_تحويل_صحيح.توسيع_بإشارة -> {
        طابق المصدر.الإشارة مع
        | إشارة_صحيح_مسير.موقع -> {
            // Sign extension is a width transformation; the result Type owns its interpretation.
            أرجع المصدر.البتات < الهدف.البتات;
        }
        | إشارة_صحيح_مسير.غير_موقع -> {
            أرجع خطأ;
        };
    }
    | عملية_تحويل_صحيح.توسيع_صفري -> {
        طابق المصدر.الإشارة مع
        | إشارة_صحيح_مسير.غير_موقع -> {
            // Zero extension is a width transformation; the result Type owns its interpretation.
            أرجع المصدر.البتات < الهدف.البتات;
        }
        | إشارة_صحيح_مسير.موقع -> {
            أرجع خطأ;
        };
    }
    | عملية_تحويل_صحيح.اقتطاع -> {
        // Truncation preserves low bits; the result Type owns signed/unsigned interpretation.
        أرجع المصدر.البتات > الهدف.البتات;
    }
    | عملية_تحويل_صحيح.إعادة_تفسير -> {
        // Same-width conversion preserves bits; the result Type owns interpretation.
        أرجع المصدر.البتات == الهدف.البتات;
    };
}

عرف تحقق_تحويل_صحيح_مسير(
    التحويل: تحويل_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        التحويل.المصدر,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء
    );
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(أ) -> {
        طابق الناتج مع
        | اختيار.بعض(ب) -> {
            دع وصف_أ: اختيار وصف_صحيح_مسير = وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, أ.النوع);
            دع وصف_ب: اختيار وصف_صحيح_مسير = وصف_صحيح_لمسير(الأنواع, ب.النوع);
            طابق وصف_أ مع
            | اختيار.بعض(س) -> {
                طابق وصف_ب مع
                | اختيار.بعض(ه) -> {
                    لو (!تحويل_صحيح_مسموح_لمسير(التحويل.العملية, س, ه)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                        );
                    };
                }
                | اختيار.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                    );
                };
            }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, أ.النوع, ب.النوع)
                );
            };
        }
        | اختيار.لا_شيء -> {
        };
    }
    | اختيار.لا_شيء -> {
    };
    أرجع صواب;
}

عرف تحقق_تعليمة_بلا_ناتج_مسير(
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الحالة: تعليمة_مسير = *التعليمة;
    طابق الحالة.الناتج مع
    | اختيار.لا_شيء -> {
        أرجع صواب;
    }
    | اختيار.بعض(القيمة) -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تعليمة_بناتج_غير_متوقع(الموضع));
        أرجع خطأ;
    };
}

عرف نوع_حقل_دلالي_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    الفهرس: غير_موقع
): اختيار معرف_نوع {
    طابق نوع_عنصر_صف_دلالي_عند(الأنواع, النوع, الفهرس) مع
    | اختيار.بعض(الموجود) -> {
        أرجع اختيار.بعض(الموجود);
    }
    | اختيار.لا_شيء -> { };
    أرجع نوع_حقل_سجل_دلالي_عند(الأنواع, النوع, الفهرس);
}

عرف نوع_عنصر_فهرسة_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
    | اختيار.بعض(الداخل) -> {
        أرجع اختيار.بعض(الداخل);
    }
    | اختيار.لا_شيء -> { };
    أرجع نوع_عنصر_شريحة_دلالي(الأنواع, النوع);
}

عرف هل_نوع_بدائي_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    المتوقع: نوع_بدائي_مقنن
): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختيار.بعض(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع البدائي == المتوقع;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف هل_نوع_نص_لمسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    أرجع هل_نوع_بدائي_لمسير(الأنواع, النوع, نوع_بدائي_مقنن.نص());
}

عرف نوع_داخل_مرجع_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_داخل_مرجع_دلالي(الأنواع, النوع) مع
    | اختيار.بعض(الداخل) -> {
        أرجع اختيار.بعض(الداخل);
    }
    | اختيار.لا_شيء -> {
        أرجع نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع);
    };
}

عرف هل_مرجع_متغير_لمسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق نوع_داخل_مرجع_متغير_دلالي(الأنواع, النوع) مع
    | اختيار.بعض(_) -> {
        أرجع صواب;
    }
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف نوع_قيمة_عنصر_مؤشر_لمسير(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): اختيار معرف_نوع {
    طابق نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الأساس) -> {
        طابق الأساس مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            دع الحالة: سجل_أنواع = *الأنواع;
            لو (نوع_العنصر.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
                أرجع اختيار.لا_شيء();
            };
            دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[نوع_العنصر.القيمة];
            دع نوع_العنصر_المقنن: نوع_مقنن = *مرجع_النوع;
            طابق نوع_العنصر_المقنن مع
            | نوع_مقنن.متغير(الداخل) -> { أرجع اختيار.بعض(الداخل); }
            | _ -> { أرجع اختيار.بعض(نوع_العنصر); };
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف هل_عنصر_مؤشر_قابل_للكتابة_لمسير(
    الأنواع: &سجل_أنواع,
    نوع_المؤشر: معرف_نوع
): منطقي {
    طابق نوع_أساس_عند(الأنواع, نوع_المؤشر) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الأساس) -> {
        طابق الأساس مع
        | نوع_مقنن.مؤشر(نوع_العنصر) -> {
            دع الحالة: سجل_أنواع = *الأنواع;
            لو (نوع_العنصر.القيمة >= (الطول(الحالة.الأنواع) مثل غير_موقع)) {
                أرجع خطأ;
            };
            دع مرجع_النوع: &نوع_مقنن = &الحالة.الأنواع[نوع_العنصر.القيمة];
            دع نوع_العنصر_المقنن: نوع_مقنن = *مرجع_النوع;
            طابق نوع_العنصر_المقنن مع
            | نوع_مقنن.متغير(_) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف نوع_داخل_صندوق_لمسير(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): اختيار معرف_نوع {
    أرجع نوع_حمولة_صندوق_دلالي(الأنواع, النوع);
}

عرف هل_مكان_قابل_للكتابة_لمسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الأنواع: &سجل_أنواع
): منطقي {
    دع حالة_الدالة: دالة_مسير = *الدالة;
    طابق ابحث_تعريف_قيمة_مسير(&حالة_الدالة, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            لو (الكتلة.القيمة >= (الطول(حالة_الدالة.الكتل) مثل غير_موقع)) {
                أرجع خطأ;
            };
            دع مرجع_الكتلة: &كتلة_مسير = &حالة_الدالة.الكتل[الكتلة.القيمة];
            دع حالة_الكتلة: كتلة_مسير = *مرجع_الكتلة;
            لو (الفهرس >= (الطول(حالة_الكتلة.التعليمات) مثل غير_موقع)) {
                أرجع خطأ;
            };
            طابق حالة_الكتلة.التعليمات[الفهرس].العملية مع
            | عملية_مسير.مكان_محلي(المكان) -> {
                أرجع المكان.قابل_للكتابة;
            }
            | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
                طابق ابحث_تعريف_قيمة_مسير(&حالة_الدالة, العملية.المرجع) مع
                | اختيار.بعض(تعريف_المرجع) -> {
                    أرجع هل_مرجع_متغير_لمسير(الأنواع, تعريف_المرجع.القيمة.النوع);
                }
                | اختيار.لا_شيء -> {
                    أرجع خطأ;
                };
            }
            | عملية_مسير.صندوق_إلى_مكان(_) -> {
                أرجع صواب;
            }
            | عملية_مسير.مكان_حقل(العملية) -> {
                أرجع هل_مكان_قابل_للكتابة_لمسير(&حالة_الدالة, العملية.الأصل, الأنواع);
            }
            | عملية_مسير.مكان_فهرس(العملية) -> {
                أرجع هل_مكان_قابل_للكتابة_لمسير(&حالة_الدالة, العملية.الأصل, الأنواع);
            }
            | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
                طابق ابحث_تعريف_قيمة_مسير(&حالة_الدالة, العملية.المؤشر) مع
                | اختيار.بعض(تعريف_المؤشر) -> {
                    أرجع هل_عنصر_مؤشر_قابل_للكتابة_لمسير(
                        الأنواع, تعريف_المؤشر.القيمة.النوع
                    );
                }
                | اختيار.لا_شيء -> { أرجع خطأ; };
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف تحقق_أعضاء_تجميع_مسير(
    الأعضاء: &متجه معرف_قيمة_مسير,
    العدد: غير_موقع,
    النوع_المتوقع: &متجه معرف_نوع,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع أعضاء_القيم: متجه معرف_قيمة_مسير = *الأعضاء;
    دع المتوقعات: متجه معرف_نوع = *النوع_المتوقع;
    دع صالح: متغير منطقي = صواب;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        طابق تحقق_استخدام_قيمة_مسير(
            الدالة,
            أعضاء_القيم[ف],
            الموضع.الكتلة,
            الموضع.الفهرس,
            الأخطاء
        ) مع
        | اختيار.بعض(القيمة) -> {
            لو (ف < (الطول(المتوقعات) مثل غير_موقع)) {
                دع المتوقع: معرف_نوع = المتوقعات[ف];
                لو (!معرفا_نوع_متساويان(القيمة.النوع, المتوقع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.عضو_تجميع_غير_مطابق(
                            الموضع,
                            ف,
                            المتوقع,
                            القيمة.النوع
                        )
                    );
                    صالح := خطأ;
                };
            };
        }
        | اختيار.لا_شيء -> {
            صالح := خطأ;
        };
        ف := ف + 1;
    }
    أرجع صالح;
}

عرف تحقق_مرجع_إلى_مؤشر_مسير(
    التحويل: مرجع_إلى_مؤشر_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, التحويل.المرجع, الموضع.الكتلة, الموضع.الفهرس, الأخطاء
    );
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(قيمة_المصدر) -> {
        طابق الناتج مع
        | اختيار.بعض(قيمة_الناتج) -> {
            دع صالح: متغير منطقي = خطأ;
            طابق نوع_داخل_مرجع_لمسير(الأنواع, قيمة_المصدر.النوع) مع
            | اختيار.بعض(داخل_المرجع) -> {
                طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_الناتج.النوع) مع
                | اختيار.بعض(داخل_المؤشر) -> {
                    لو (معرفا_نوع_متساويان(داخل_المرجع, داخل_المؤشر)) {
                        صالح := صواب;
                        لو (
                            هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, قيمة_الناتج.النوع)
                            && !هل_مرجع_متغير_لمسير(الأنواع, قيمة_المصدر.النوع)
                        ) {
                            صالح := خطأ;
                        };
                    };
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
            لو (!صالح) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تحويل_مرجع_إلى_مؤشر_غير_صالح(
                        الموضع, قيمة_المصدر.النوع, قيمة_الناتج.النوع
                    )
                );
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_تجميع_مسير(
    العملية: &تجميع_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.لا_شيء -> {
        أرجع خطأ;
    }
    | اختيار.بعض(القيمة_الناتجة) -> {
        دع حالة_العملية: تجميع_مسير = *العملية;
        دع العدد: غير_موقع = الطول(حالة_العملية.الأعضاء) مثل غير_موقع;
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة_الناتجة.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.تجميع_غير_صالح(الموضع, القيمة_الناتجة.النوع)
            );
            أرجع خطأ;
        }
        | اختيار.بعض(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.صف -> {
                دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
                طابق عدد_عناصر_صف_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
                | اختيار.بعض(المتوقع) -> {
                    لو (المتوقع != العدد) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تجميع_غير_صالح(
                                الموضع,
                                القيمة_الناتجة.النوع
                            )
                        );
                    };
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < المتوقع) {
                        طابق نوع_عنصر_صف_دلالي_عند(
                            الأنواع,
                            القيمة_الناتجة.النوع,
                            ف
                        ) مع
                        | اختيار.بعض(نوع_العضو) -> {
                            ألحق(الأنواع_المتوقعة, نوع_العضو);
                        }
                        | اختيار.لا_شيء -> {
                            أرجع خطأ;
                        };
                        ف := ف + 1;
                    }
                    دع صالح_الأعضاء: منطقي = تحقق_أعضاء_تجميع_مسير(
                        &حالة_العملية.الأعضاء,
                        العدد,
                        &الأنواع_المتوقعة,
                        الموضع,
                        الدالة,
                        الأخطاء
                    );
                    أرجع (المتوقع == العدد) && صالح_الأعضاء;
                }
                | اختيار.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تجميع_غير_صالح(
                            الموضع,
                            القيمة_الناتجة.النوع
                        )
                    );
                    أرجع خطأ;
                };
            }
            | صنف_شكل_نوع_دلالي.سجل -> {
                دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
                طابق عدد_حقول_سجل_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
                | اختيار.بعض(المتوقع) -> {
                    لو (المتوقع != العدد) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.تجميع_غير_صالح(
                                الموضع,
                                القيمة_الناتجة.النوع
                            )
                        );
                    };
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < المتوقع) {
                        طابق نوع_حقل_سجل_دلالي_عند(
                            الأنواع,
                            القيمة_الناتجة.النوع,
                            ف
                        ) مع
                        | اختيار.بعض(نوع_الحقل) -> {
                            ألحق(الأنواع_المتوقعة, نوع_الحقل);
                        }
                        | اختيار.لا_شيء -> {
                            أرجع خطأ;
                        };
                        ف := ف + 1;
                    }
                    دع صالح_الأعضاء: منطقي = تحقق_أعضاء_تجميع_مسير(
                        &حالة_العملية.الأعضاء,
                        العدد,
                        &الأنواع_المتوقعة,
                        الموضع,
                        الدالة,
                        الأخطاء
                    );
                    أرجع (المتوقع == العدد) && صالح_الأعضاء;
                }
                | اختيار.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تجميع_غير_صالح(
                            الموضع,
                            القيمة_الناتجة.النوع
                        )
                    );
                    أرجع خطأ;
                };
            }
            | _ -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.تجميع_غير_صالح(
                        الموضع,
                        القيمة_الناتجة.النوع
                    )
                );
                أرجع خطأ;
            };
        };
    };
}


عرف تحقق_تهيئة_متجه_مسير(
    العملية: &تهيئة_متجه_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة_الناتجة) -> {
        طابق نوع_عنصر_متجه_دلالي(الأنواع, القيمة_الناتجة.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.تجميع_غير_صالح(الموضع, القيمة_الناتجة.النوع)
            );
            أرجع خطأ;
        }
        | اختيار.بعض(نوع_العنصر) -> {
            دع حالة_العملية: تهيئة_متجه_مسير = *العملية;
            دع العدد: غير_موقع = الطول(حالة_العملية.العناصر) مثل غير_موقع;
            دع الأنواع_المتوقعة: متغير متجه معرف_نوع = [];
            دع ف: متغير غير_موقع = 0;
            بينما (ف < العدد) {
                ألحق(الأنواع_المتوقعة, نوع_العنصر);
                ف := ف + 1;
            }
            أرجع تحقق_أعضاء_تجميع_مسير(
                &حالة_العملية.العناصر,
                العدد,
                &الأنواع_المتوقعة,
                الموضع,
                الدالة,
                الأخطاء
            );
        };
    };
}

عرف تحقق_استخراج_حقل_مسير(
    العملية: استخراج_حقل_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, العملية.المصدر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق المصدر مع
    | اختيار.بعض(قيمة_المصدر) -> {
        طابق نوع_حقل_دلالي_لمسير(الأنواع, قيمة_المصدر.النوع, العملية.الفهرس) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.حقل_غير_صالح(الموضع, قيمة_المصدر.النوع, العملية.الفهرس));
        }
        | اختيار.بعض(المتوقع) -> {
            طابق الناتج مع
            | اختيار.بعض(قيمة_الناتج) -> {
                لو (!معرفا_نوع_متساويان(المتوقع, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_حقل_غير_مطابق(الموضع, المتوقع, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> { };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_فهرس_مسير(
    المصدر_معرف: معرف_قيمة_مسير,
    الفهرس_معرف: معرف_قيمة_مسير,
    الناتج_المتوقع: اختيار قيمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المصدر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, المصدر_معرف, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    دع الفهرس: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الفهرس_معرف, الموضع.الكتلة, الموضع.الفهرس, الأخطاء);
    طابق الفهرس مع
    | اختيار.بعض(قيمة_الفهرس) -> {
        طابق وصف_صحيح_لمسير(الأنواع, قيمة_الفهرس.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_فهرس_غير_صحيح(الموضع, قيمة_الفهرس.النوع));
        }
        | اختيار.بعض(الوصف) -> { };
    }
    | اختيار.لا_شيء -> { };
    طابق المصدر مع
    | اختيار.بعض(قيمة_المصدر) -> {
        طابق نوع_عنصر_فهرسة_لمسير(الأنواع, قيمة_المصدر.النوع) مع
        | اختيار.بعض(نوع_العنصر) -> {
            طابق الناتج_المتوقع مع
            | اختيار.بعض(قيمة_الناتج) -> {
                لو (!معرفا_نوع_متساويان(نوع_العنصر, قيمة_الناتج.النوع)) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_عنصر_فهرس_غير_مطابق(الموضع, نوع_العنصر, قيمة_الناتج.النوع));
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> {
            لو (هل_نوع_نص_لمسير(الأنواع, قيمة_المصدر.النوع)) {
                طابق الناتج_المتوقع مع
                | اختيار.بعض(قيمة_الناتج) -> {
                    لو (!هل_نوع_بدائي_لمسير(الأنواع, قيمة_الناتج.النوع, نوع_بدائي_مقنن.غ8())) {
                        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_المصدر.النوع));
                    };
                }
                | اختيار.لا_شيء -> { };
            } وإلا {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_المصدر.النوع));
            };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

عرف تحقق_مرجع_إلى_مكان_مسير(
