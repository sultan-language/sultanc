// Its descriptor must carry the actual remaining vector extent.
عرف هل_مرجع_عنصر_متجه_بايتات_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الأنواع: &سجل_أنواع,
    المرجع: معرف_قيمة_مسير
): منطقي {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, المرجع) مع
    | اختيار.بعض(عملية_مسير.مكان_إلى_مرجع(المصدر)) -> { مكان_العنصر := المصدر.المكان; }
    | _ -> { أرجع خطأ; };
    دع مكان_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, مكان_العنصر) مع
    | اختيار.بعض(عملية_مسير.مكان_فهرس(المكان)) -> { مكان_المتجه := المكان.الأصل; }
    | _ -> { أرجع خطأ; };
    دع تعريف_المتجه: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
        التعريفات, مكان_المتجه
    );
    دع نوع_المتجه: معرف_نوع;
    طابق تعريف_المتجه مع
    | اختيار.بعض(التعريف) -> {
        طابق أزل_غلاف_متغير(الأنواع, التعريف.القيمة.النوع) مع
        | اختيار.بعض(النوع) -> { نوع_المتجه := النوع; }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
    طابق نوع_عنصر_متجه_دلالي(الأنواع, نوع_المتجه) مع
    | اختيار.بعض(النوع) -> {
        طابق نوع_أساس_عند(الأنواع, النوع) مع
        | اختيار.بعض(نوع_مقنن.بدائي(البدائي)) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.ص8 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.غ8 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص16 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.غ16 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.غ32 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.ص64 -> { أرجع صواب; }
            | نوع_بدائي_مقنن.غ64 -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف هل_طول_متجه_بايتات_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الأنواع: &سجل_أنواع,
    المرجع: معرف_قيمة_مسير,
    الطول_الديناميكي: معرف_قيمة_مسير
): منطقي {
    دع مكان_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, المرجع) مع
    | اختيار.بعض(عملية_مسير.مكان_إلى_مرجع(المصدر)) -> { مكان_العنصر := المصدر.المكان; }
    | _ -> { أرجع خطأ; };
    دع مكان_المتجه: معرف_قيمة_مسير;
    دع فهرس_العنصر: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, مكان_العنصر) مع
    | اختيار.بعض(عملية_مسير.مكان_فهرس(المكان)) -> {
        مكان_المتجه := المكان.الأصل;
        فهرس_العنصر := المكان.الفهرس;
