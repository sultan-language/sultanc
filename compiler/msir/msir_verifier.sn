    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المرجع) مع
    | اختيار.بعض(التعريف) -> {
        طابق نوع_أساس_عند(الأنواع, التعريف.القيمة.النوع) مع
        | اختيار.بعض(نوع_مقنن.مرجع(العنصر, _)) -> {
            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, العنصر) مع
            | اختيار.بعض(العرض) -> { عرض_العنصر := العرض; }
            | اختيار.لا_شيء -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
    دع طول_العناصر: متغير معرف_قيمة_مسير = الطول_الديناميكي;
    لو (عرض_العنصر != 1) {
        طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, الطول_الديناميكي) مع
        | اختيار.بعض(عملية_مسير.حساب_صحيح(الضرب)) -> {
            طابق الضرب.العملية مع
            | عملية_حساب_صحيح.ضرب -> { }
            | _ -> { أرجع خطأ; };
            طابق طول_نطاق_ذاكرة_ثابت_موثوق(الدالة, التعريفات, الضرب.اليمين) مع
            | اختيار.بعض(القيمة) -> {
                لو (القيمة != عرض_العنصر) { أرجع خطأ; };
            }
            | اختيار.لا_شيء -> { أرجع خطأ; };
            طول_العناصر := الضرب.اليسار;
        }
        | _ -> { أرجع خطأ; };
    };
    دع الطول_المسجل: حساب_صحيح_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, طول_العناصر) مع
    | اختيار.بعض(عملية_مسير.حساب_صحيح(الحساب)) -> {
        طابق الحساب.العملية مع
        | عملية_حساب_صحيح.طرح -> { الطول_المسجل := الحساب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    // Exact index SSA identity is required. Narrower indices may only be
    // widened according to their original signedness; same-width signed
    // indices are reinterpreted. No unrelated arithmetic establishes an offset.
    لو (!قيمتا_مسير_متساويتان(الطول_المسجل.اليمين, فهرس_العنصر)) {
        دع تحويل_الفهرس: تحويل_صحيح_مسير;
        طابق عملية_تعريف_طول_نطاق_نداء(
            الدالة, التعريفات, الطول_المسجل.اليمين
        ) مع
        | اختيار.بعض(عملية_مسير.تحويل_صحيح(التحويل)) -> {
            تحويل_الفهرس := التحويل;
        }
        | _ -> { أرجع خطأ; };
        لو (!قيمتا_مسير_متساويتان(تحويل_الفهرس.المصدر, فهرس_العنصر)) {
            أرجع خطأ;
        };
        دع تعريف_الفهرس: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
            التعريفات, فهرس_العنصر
        );
        دع وصف_الفهرس: وصف_صحيح_مسير;
        طابق تعريف_الفهرس مع
        | اختيار.بعض(التعريف) -> {
            طابق وصف_صحيح_لمسير(الأنواع, التعريف.القيمة.النوع) مع
            | اختيار.بعض(الوصف) -> { وصف_الفهرس := الوصف; }
            | اختيار.لا_شيء -> { أرجع خطأ; };
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
        لو (وصف_الفهرس.البتات > 64 || وصف_الفهرس.البتات == 0) {
            أرجع خطأ;
        };
        لو (وصف_الفهرس.البتات == 64) {
            طابق تحويل_الفهرس.العملية مع
            | عملية_تحويل_صحيح.إعادة_تفسير -> { }
            | _ -> { أرجع خطأ; };
        } وإلا {
            طابق وصف_الفهرس.الإشارة مع
            | إشارة_صحيح_مسير.موقع -> {
                طابق تحويل_الفهرس.العملية مع
                | عملية_تحويل_صحيح.توسيع_بإشارة -> { }
                | _ -> { أرجع خطأ; };
            }
            | إشارة_صحيح_مسير.غير_موقع -> {
                طابق تحويل_الفهرس.العملية مع
                | عملية_تحويل_صحيح.توسيع_صفري -> { }
                | _ -> { أرجع خطأ; };
            };
        };
    };
    دع ناتج_طول_التسلسل: معرف_قيمة_مسير;
    طابق أصل_إعادة_تفسير_طول_نداء(
        الدالة, التعريفات, الطول_المسجل.اليسار
    ) مع
    | اختيار.بعض(المعرف) -> { ناتج_طول_التسلسل := المعرف; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
    دع قيمة_المتجه: معرف_قيمة_مسير;
    طابق عملية_تعريف_طول_نطاق_نداء(
        الدالة, التعريفات, ناتج_طول_التسلسل
    ) مع
    | اختيار.بعض(عملية_مسير.نداء(النداء)) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.طول) -> {
            لو ((الطول(النداء.الحجج) مثل غير_موقع) != 1) { أرجع خطأ; };
            قيمة_المتجه := النداء.الحجج[0];
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    طابق عملية_تعريف_طول_نطاق_نداء(الدالة, التعريفات, قيمة_المتجه) مع
    | اختيار.بعض(عملية_مسير.تحميل(التحميل)) -> {
        أرجع قيمتا_مسير_متساويتان(التحميل.المكان, مكان_المتجه);
    }
    | _ -> { أرجع خطأ; };
