// Trace the storage behind a call-site borrow. A raw pointer-indexed place
// cannot establish allocation provenance merely because it was reborrowed.
// Function parameters and foreign references are checked for liveness by the
// interpreter; the verifier never treats an integer as a storage root.
عرف هل_مكان_نطاق_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المكان: معرف_قيمة_مسير
): منطقي {
    دع الحالي: متغير معرف_قيمة_مسير = المكان;
    دع الزيارات: متغير غير_موقع = 0;
    بينما (الزيارات < (الطول((*الدالة).القيم) مثل غير_موقع)) {
        الزيارات := الزيارات + 1;
        طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, الحالي) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                    أرجع خطأ;
                };
                دع التعليمات: &متجه تعليمة_مسير =
                    &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                    أرجع خطأ;
                };
                طابق (*التعليمات)[الفهرس].العملية مع
                | عملية_مسير.مكان_محلي(_) -> { أرجع صواب; }
                | عملية_مسير.مكان_عام(_) -> { أرجع صواب; }
                | عملية_مسير.صندوق_إلى_مكان(_) -> { أرجع صواب; }
                | عملية_مسير.مرجع_إلى_مكان(_) -> {
                    // The incoming reference is validated against live storage
                    // by the runtime memory owner at the execution boundary.
                    أرجع صواب;
                }
                | عملية_مسير.مكان_حقل(الحقل) -> { الحالي := الحقل.الأصل; }
                | عملية_مسير.مكان_فهرس(العنصر) -> { الحالي := العنصر.الأصل; }
                | _ -> { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
        };
    };
    أرجع خطأ;
}

عرف هل_مرجع_نطاق_نداء_موثوق(
    الدالة: &دالة_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    المرجع: معرف_قيمة_مسير
): منطقي {
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, المرجع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.معامل_دالة -> { أرجع صواب; }
        | موضع_تعريف_قيمة_مسير.معامل_كتلة(_) -> {
            // A block parameter preserves an incoming typed reference; the
            // interpreter must still resolve its live allocation.
            أرجع صواب;
        }
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                أرجع خطأ;
            };
            دع التعليمات: &متجه تعليمة_مسير =
                &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
            لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                أرجع خطأ;
            };
            طابق (*التعليمات)[الفهرس].العملية مع
            | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
                أرجع هل_مكان_نطاق_نداء_موثوق(
                    الدالة, التعريفات, العملية.المكان
                );
            }
            | _ -> { أرجع خطأ; };
        };
    };
}

// Actual accessible byte counts still require source-established bounds and
// an interpreter memory check; a numeric length alone is not such a proof.
// Opaque word->address conversions cannot acquire provenance by annotation.
عرف تحقق_نطاقات_ذاكرة_نداء_مسير(
    النداء: &نداء_مسير,
    بدائي_نواة: منطقي,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير,
    الهيمنة: &تحليل_هيمنة_مسير
): فراغ {
    دع قيمة_النداء: نداء_مسير = *النداء;
    دع العدد: غير_موقع = الطول(قيمة_النداء.الحجج) مثل غير_موقع;
    دع موضع_الحجة: متغير غير_موقع = 0;
    بينما (موضع_الحجة < العدد) {
        دع القيمة: معرف_قيمة_مسير = قيمة_النداء.الحجج[موضع_الحجة];
        دع تعريف_الحجة: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, القيمة);
        دع مؤشر_فعلي: متغير منطقي = خطأ;
        طابق تعريف_الحجة مع
        | اختيار.بعض(التعريف) -> {
            طابق نوع_أساس_عند(الأنواع, التعريف.القيمة.النوع) مع
            | اختيار.بعض(نوع_مقنن.مؤشر(_)) -> { مؤشر_فعلي := صواب; }
            | _ -> { };
        }
        | اختيار.لا_شيء -> { };
        دع مطابقات: متغير غير_موقع = 0;
        دع فهرس_النطاق: متغير غير_موقع = 0;
        بينما (فهرس_النطاق < (الطول(قيمة_النداء.نطاقات_الذاكرة) مثل غير_موقع)) {
            دع النطاق: نطاق_ذاكرة_نداء_مسير = قيمة_النداء.نطاقات_الذاكرة[فهرس_النطاق];
            لو (النطاق.فهرس_الحجة == موضع_الحجة) {
                مطابقات := مطابقات + 1;
                دع صالح: متغير منطقي = بدائي_نواة && موضع_الحجة > 0 && مؤشر_فعلي
                    && قيمتا_مسير_متساويتان(القيمة, النطاق.المؤشر);
                لو (صالح) {
                    دع أصل: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة, النطاق.الأصل, الموضع.الكتلة, الموضع.الفهرس,
                        الأخطاء, التعريفات, الهيمنة
                    );
                    دع طول_النطاق: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة, النطاق.الطول, الموضع.الكتلة, الموضع.الفهرس,
                        الأخطاء, التعريفات, الهيمنة
                    );
                    // Only the matching address-of-reference conversion provides
                    // provenance. A fabricated machine integer is not storage.
                    دع تعريف_المؤشر: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
                        التعريفات, النطاق.المؤشر
                    );
                    دع أصل_صحيح: متغير منطقي = خطأ;
                    طابق تعريف_المؤشر مع
                    | اختيار.بعض(التعريف) -> {
                        طابق التعريف.الموضع مع
                        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
                            لو (الكتلة.القيمة < (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                                لو (الفهرس < (الطول(*التعليمات) مثل غير_موقع)) {
                                    طابق (*التعليمات)[الفهرس].العملية مع
                                    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
                                        أصل_صحيح := قيمتا_مسير_متساويتان(التحويل.المرجع, النطاق.الأصل);
                                    }
                                    | _ -> { };
                                };
                            };
                        }
                        | _ -> { };
                    }
                    | اختيار.لا_شيء -> { };
                    صالح := أصل_صحيح && هل_مرجع_نطاق_نداء_موثوق(
                        الدالة, التعريفات, النطاق.الأصل
                    );
                    طابق أصل مع
                    | اختيار.بعض(القيمة_الأصل) -> {
                        طابق نوع_أساس_عند(الأنواع, القيمة_الأصل.النوع) مع
                        | اختيار.بعض(نوع_مقنن.مرجع(العنصر, مرجع_متغير)) -> {
                            // A mutable raw pointer does not make an immutable
                            // borrow writable. Check both source permission and
                            // the maximum provable number of accessible bytes.
                            طابق النطاق.الإذن مع
                            | إذن_ذاكرة_نداء_مسير.قراءة -> { }
                            | _ -> {
                                لو (!مرجع_متغير) { صالح := خطأ; };
                            };
                            طابق حجم_نوع_بدائي_ثابت_بالبايتات(الأنواع, العنصر) مع
                            | اختيار.بعض(الحد) -> {
                                طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                                    الدالة, التعريفات, النطاق.الطول
                                ) مع
                                | اختيار.بعض(الحجم) -> {
                                    // Canonical scalar descriptors cover exactly
                                    // their referenced object. They cannot mask
                                    // a dynamic byte-vector borrow as one byte.
                                    لو (الحجم != الحد || هل_مرجع_عنصر_متجه_بايتات_نداء_موثوق(
                                        الدالة, التعريفات, الأنواع, النطاق.الأصل
                                    )) { صالح := خطأ; };
                                }
                                | اختيار.لا_شيء -> {
                                    // Dynamic byte-vector extents have their own
                                    // SSA provenance proof, not an arbitrary size.
                                    لو (!هل_طول_متجه_بايتات_نداء_موثوق(
                                        الدالة, التعريفات, الأنواع,
                                        النطاق.الأصل, النطاق.الطول
                                    )) { صالح := خطأ; };
                                };
                            }
                            | اختيار.لا_شيء -> {
                                // No scalar or byte-vector witness for aggregates.
                                صالح := خطأ;
                            };
                        }
                        | _ -> { صالح := خطأ; };
                    }
                    | اختيار.لا_شيء -> { صالح := خطأ; };
                    طابق طول_النطاق مع
                    | اختيار.بعض(قيمة_الطول) -> {
                        طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ64()) مع
                        | اختيار.بعض(النوع) -> {
                            لو (!معرفا_نوع_متساويان(قيمة_الطول.النوع, النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختيار.لا_شيء -> { صالح := خطأ; };
                    }
                    | اختيار.لا_شيء -> { صالح := خطأ; };
                    طابق النطاق.المطلوب مع
                    | اختيار.بعض(معرف_الطلب) -> {
                        دع قيمة_الطلب: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                            الدالة, معرف_الطلب, الموضع.الكتلة, الموضع.الفهرس,
                            الأخطاء, التعريفات, الهيمنة
                        );
                        طابق قيمة_الطلب مع
                        | اختيار.بعض(القيمة) -> {
                            طابق معرف_نوع_بدائي_دلالي(الأنواع, نوع_بدائي_مقنن.غ64()) مع
                            | اختيار.بعض(النوع) -> {
                                لو (!معرفا_نوع_متساويان(القيمة.النوع, النوع)) {
                                    صالح := خطأ;
                                };
                            }
                            | اختيار.لا_شيء -> { صالح := خطأ; };
                        }
                        | اختيار.لا_شيء -> { صالح := خطأ; };
                        // An independently supplied request may not exceed a
                        // statically known source extent. Runtime values still
                        // require the Interpreter's live allocation check.
                        طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                            الدالة, التعريفات, النطاق.الطول
                        ) مع
                        | اختيار.بعض(الحد_الثابت) -> {
                            طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                                الدالة, التعريفات, معرف_الطلب
                            ) مع
                            | اختيار.بعض(الطلب_الثابت) -> {
                                لو (الطلب_الثابت > الحد_الثابت) { صالح := خطأ; };
                            }
                            | اختيار.لا_شيء -> { };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                    طابق النطاق.الإذن مع
                    | إذن_ذاكرة_نداء_مسير.قراءة -> { }
                    | إذن_ذاكرة_نداء_مسير.كتابة -> {
                        طابق تعريف_الحجة مع
                        | اختيار.بعض(التعريف) -> {
                            لو (!هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, التعريف.القيمة.النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختيار.لا_شيء -> { صالح := خطأ; };
                    }
                    | إذن_ذاكرة_نداء_مسير.قراءة_وكتابة -> {
                        طابق تعريف_الحجة مع
                        | اختيار.بعض(التعريف) -> {
                            لو (!هل_عنصر_مؤشر_قابل_للكتابة_لمسير(الأنواع, التعريف.القيمة.النوع)) {
                                صالح := خطأ;
                            };
                        }
                        | اختيار.لا_شيء -> { صالح := خطأ; };
                    };
                };
                لو (!صالح) {
                    سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, موضع_الحجة));
                };
            };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
        // A pointer operand of an attested (contracted) kernel call must carry
        // exactly one proven descriptor. A raw kernel call without a contract
        // is valid but untrusted MSIR (lowering/expressions.sn,
        // أكمل_عقد_ذاكرة_نداء_لينكس): compiled code executes it as written and
        // the Interpreter refuses it at the call (وثق_توقيع_نداء_نواة_مفسر).
        // Previously every pointer operand of every kernel call required a
        // descriptor, which rejected whole programs containing an untrusted
        // call (std's execve argv/envp) once code generation was verified.
        دع عقد_موثق: متغير منطقي = خطأ;
        طابق قيمة_النداء.عقد_النواة مع
        | اختيار.بعض(_) -> { عقد_موثق := صواب; }
        | اختيار.لا_شيء -> { };
        لو ((مطابقات > 1) || (بدائي_نواة && عقد_موثق && مؤشر_فعلي && مطابقات != 1)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, موضع_الحجة));
        };
        موضع_الحجة := موضع_الحجة + 1;
    }
    // Descriptors with no corresponding call operand must also be rejected.
    دع فهرس_النطاق: متغير غير_موقع = 0;
    بينما (فهرس_النطاق < (الطول(قيمة_النداء.نطاقات_الذاكرة) مثل غير_موقع)) {
        دع النطاق: نطاق_ذاكرة_نداء_مسير = قيمة_النداء.نطاقات_الذاكرة[فهرس_النطاق];
        لو (النطاق.فهرس_الحجة >= العدد) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, النطاق.فهرس_الحجة));
        };
        فهرس_النطاق := فهرس_النطاق + 1;
    }
}

// Re-prove the complete six-slot contract against the canonical Linux STD
// operation signature. SSA producer identity prevents a forged operation
// number, and the constructor ordinal binds the selector to its operand.
عرف تحقق_عقد_نواة_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    نواة: منطقي,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    التعريفات: &فهرس_تعريفات_قيم_مسير
): فراغ {
    دع العقد: عقد_نواة_مسير;
    طابق (*النداء).عقد_النواة مع
    | اختيار.بعض(القيمة) -> { العقد := القيمة; }
    | اختيار.لا_شيء -> { أرجع; };
    دع صالح: متغير منطقي = نواة;
    لو ((الطول((*النداء).الحجج) مثل غير_موقع) != 7) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
        أرجع;
    };
    لو (!قيمتا_مسير_متساويتان(العقد.الرقم, (*النداء).الحجج[0])) {
        صالح := خطأ;
    };
    دع تعريف_الرقم: اختيار تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(
        التعريفات, العقد.الرقم
    );
    دع قيمة_العملية: متغير معرف_قيمة_مسير = العقد.الرقم;
    طابق تعريف_الرقم مع
    | اختيار.بعض(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                صالح := خطأ;
            } وإلا {
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                    صالح := خطأ;
                } وإلا {
                    طابق (*التعليمات)[الفهرس].العملية مع
                    | عملية_مسير.نداء(الانتقاء) -> {
                        لو ((الطول(الانتقاء.الحجج) مثل غير_موقع) != 1) {
                            صالح := خطأ;
                        } وإلا {
                            قيمة_العملية := الانتقاء.الحجج[0];
                        };
                        طابق الانتقاء.الهدف مع
                        | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
                            لو (الهدف.القيمة != العقد.المنتقي.القيمة) { صالح := خطأ; };
                        }
                        | _ -> { صالح := خطأ; };
                    }
                    | _ -> { صالح := خطأ; };
                };
            }
        }
        | _ -> { صالح := خطأ; };
    }
    | اختيار.لا_شيء -> { صالح := خطأ; };
    // The attested source table is derived independently at the Frontend
    // boundary from canonical module keys and resolved declarations.
    دع توقيع_موثق: متغير اختيار توقيع_نداء_بدائي = اختيار.لا_شيء();
    دع مطابقات_الأصل: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*البرنامج).أصول_النواة) مثل غير_موقع)) {
        دع الأصل: &مصدر_عقد_نواة_مسير = &(*البرنامج).أصول_النواة[ف];
        لو (معرفا_رمز_متساويان((*الأصل).المنشئ, العقد.المنشئ)
            && (*الأصل).الترتيب == العقد.الترتيب
            && (*الأصل).المنتقي.القيمة == العقد.المنتقي.القيمة) {
            مطابقات_الأصل := مطابقات_الأصل + 1;
            // Copy the authenticated signature through the borrow.
            دع مرجع_التوقيع: &توقيع_نداء_بدائي = &(*الأصل).التوقيع;
            دع التوقيع_المنسوخ: توقيع_نداء_بدائي = *مرجع_التوقيع;
            توقيع_موثق := اختيار.بعض(التوقيع_المنسوخ);
        };
        ف := ف + 1;
    }
    لو (مطابقات_الأصل != 1) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
        أرجع;
    };
    دع التوقيع: توقيع_نداء_بدائي;
    طابق توقيع_موثق مع
    | اختيار.بعض(الموثق) -> { التوقيع := الموثق; }
    | اختيار.لا_شيء -> { أرجع; };
    طابق ابحث_تعريف_قيمة_مسير_مفهرس(التعريفات, قيمة_العملية) مع
    | اختيار.بعض(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
            لو (الكتلة.القيمة >= (الطول((*الدالة).الكتل) مثل غير_موقع)) {
                صالح := خطأ;
            } وإلا {
                دع التعليمات: &متجه تعليمة_مسير = &(*الدالة).الكتل[الكتلة.القيمة].التعليمات;
                لو (الفهرس >= (الطول(*التعليمات) مثل غير_موقع)) {
                    صالح := خطأ;
                } وإلا {
                    طابق (*التعليمات)[الفهرس].العملية مع
                    | عملية_مسير.بناء_موسوم(المنشئ) -> {
                        لو (المنشئ.المنشئ != العقد.الترتيب || الطول(المنشئ.الحمولات) != 0) {
                            صالح := خطأ;
                        };
                    }
                    | _ -> { صالح := خطأ; };
                };
            }
        }
        | _ -> { صالح := خطأ; };
    }
    | اختيار.لا_شيء -> { صالح := خطأ; };
    لو ((الطول(التوقيع.الأدوار) مثل غير_موقع) != 6) { صالح := خطأ; } وإلا {
        دع الوسيط: متغير غير_موقع = 1;
        بينما (الوسيط <= 6) {
            دع مطابقات: متغير غير_موقع = 0;
            دع النطاق_المطابق: متغير اختيار نطاق_ذاكرة_نداء_مسير = اختيار.لا_شيء();
            دع ن: متغير غير_موقع = 0;
            بينما (ن < (الطول((*النداء).نطاقات_الذاكرة) مثل غير_موقع)) {
                دع الوصف: نطاق_ذاكرة_نداء_مسير = (*النداء).نطاقات_الذاكرة[ن];
                لو (الوصف.فهرس_الحجة == الوسيط) {
                    مطابقات := مطابقات + 1;
                    النطاق_المطابق := اختيار.بعض(الوصف);
                };
                ن := ن + 1;
            }
            طابق التوقيع.الأدوار[الوسيط - 1] مع
            | دور_وسيطة_بدائي.عدد -> {
                لو (مطابقات != 0) { صالح := خطأ; };
            }
            | دور_وسيطة_بدائي.غير_مستخدم -> {
                لو (مطابقات != 0) { صالح := خطأ; };
                طابق طول_نطاق_ذاكرة_ثابت_موثوق(
                    الدالة, التعريفات, (*النداء).الحجج[الوسيط]
                ) مع
                | اختيار.بعض(القيمة) -> { لو (القيمة != 0) { صالح := خطأ; }; }
                | اختيار.لا_شيء -> { صالح := خطأ; };
            }
            | دور_وسيطة_بدائي.مخزن(الاتجاه, الحد) -> {
                لو (مطابقات != 1) { صالح := خطأ; };
                طابق النطاق_المطابق مع
                | اختيار.بعض(الوصف) -> {
                    لو (!قيمتا_مسير_متساويتان(الوصف.المؤشر, (*النداء).الحجج[الوسيط])) {
                        صالح := خطأ;
                    };
                    دع الإذن_المطلوب: إذن_ذاكرة_نداء_مسير;
                    طابق الاتجاه مع
                    | اتجاه_وصول_بدائي.قراءة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.قراءة(); }
                    | اتجاه_وصول_بدائي.كتابة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.كتابة(); }
                    | اتجاه_وصول_بدائي.قراءة_وكتابة -> { الإذن_المطلوب := إذن_ذاكرة_نداء_مسير.قراءة_وكتابة(); };
                    لو (الوصف.الإذن != الإذن_المطلوب) { صالح := خطأ; };
                    طابق الوصف.المطلوب مع
                    | اختيار.بعض(المطلوب) -> {
                        طابق الحد مع
                        | حد_وصول_بدائي.وسيطة(الفهرس) -> {
                            لو (الفهرس == 0 || الفهرس > 6) {
                                صالح := خطأ;
                            } وإلا لو (!قيمتا_مسير_متساويتان(المطلوب, (*النداء).الحجج[الفهرس])) {
                                صالح := خطأ;
                            };
                        }
                        | حد_وصول_بدائي.سلسلة_صفرية -> {
                            لو (!قيمتا_مسير_متساويتان(المطلوب, الوصف.الطول)) { صالح := خطأ; };
                        }
                        | حد_وصول_بدائي.ثابت(الثابت) -> {
                            طابق طول_نطاق_ذاكرة_ثابت_موثوق(الدالة, التعريفات, المطلوب) مع
                            | اختيار.بعض(القيمة) -> { لو (القيمة != الثابت) { صالح := خطأ; }; }
                            | اختيار.لا_شيء -> { صالح := خطأ; };
                        };
                    }
                    | اختيار.لا_شيء -> { صالح := خطأ; };
                }
                | اختيار.لا_شيء -> { صالح := خطأ; };
            };
            الوسيط := الوسيط + 1;
        }
    };
    لو (!صالح) {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.عقد_ذاكرة_نداء_غير_صالح(الموضع, 0));
    };
}

عرف تحقق_نداء_مسير(
    البرنامج: &برنامج_مسير,
    النداء: &نداء_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع حالة_النداء: نداء_مسير = *النداء;
    دع نواة: متغير منطقي = خطأ;
    طابق حالة_النداء.الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.نداء_نواة_خام -> { نواة := صواب; }
        | _ -> { };
    }
    | _ -> { };
    تحقق_عقد_نواة_مسير(
        البرنامج, النداء, نواة, الموضع, الدالة, الأخطاء, فهرس_التعريفات
    );
    تحقق_نطاقات_ذاكرة_نداء_مسير(
        النداء, نواة, الموضع, الدالة, الأنواع,
        الأخطاء, فهرس_التعريفات, تحليل_الهيمنة
    );
    طابق حالة_النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(الهدف) -> {
        أرجع تحقق_نداء_دالة_سلطان_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.دالة_خارجية(الهدف) -> {
        أرجع تحقق_نداء_دالة_خارجية_مسير(
            البرنامج,
            النداء,
            الهدف,
            التعليمة,
            الموضع,
            الدالة,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> {
        أرجع تحقق_نداء_قيمة_دالة_مسير(
            النداء, الدالة_القيمة, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
        دع العقد: عقد_دلالي_بدائي = العقد_الدلالي_للبدائي(البدائي);
        دع المتوقع: غير_موقع = العقد.عدد_الحجج;
        دع الفعلي: غير_موقع = الطول(حالة_النداء.الحجج) مثل غير_موقع;
        لو (المتوقع != الفعلي) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عدد_حجج_نداء_غير_مطابق(الموضع, المتوقع, الفعلي)
            );
        };

        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_مفقود(الموضع));
            };
        }
        | _ -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(_) -> {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_متوقع(الموضع));
            }
            | اختيار.لا_شيء -> { };
        };

        تحقق_حجج_نداء_هيكليا(النداء, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);

        // Exact primitive Type legality is owned by Frontend Type. MSIR contributes only
        // already-lowered ValueIDs and requires all source-level conversions to be explicit.
        دع الأنواع_المقننة_للبدائي: اختيار أنواع_استدعاء_بدائي_مقننة =
            أنواع_استدعاء_بدائي_مقننة_من_سجل(الأنواع);
        دع أنواع_حجج_البدائي: متغير متجه معرف_نوع = [];
        دع أنواع_الحجج_مكتملة: متغير منطقي = صواب;
        دع ف_نوع: متغير غير_موقع = 0;
        بينما (ف_نوع < الفعلي) {
            طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, حالة_النداء.الحجج[ف_نوع]) مع
            | اختيار.بعض(التعريف) -> {
                ألحق(أنواع_حجج_البدائي, التعريف.القيمة.النوع);
            }
            | اختيار.لا_شيء -> { أنواع_الحجج_مكتملة := خطأ; };
            ف_نوع := ف_نوع + 1;
        }
        طابق الأنواع_المقننة_للبدائي مع
        | اختيار.بعض(القيم_المقننة) -> {
            لو (أنواع_الحجج_مكتملة) {
                طابق تحقق_استدعاء_بدائي_مقنن(
                    الأنواع, &القيم_المقننة, البدائي, &أنواع_حجج_البدائي
                ) مع
                | نتيجة_استدعاء_بدائي.صالح(_) -> { }
                | نتيجة_استدعاء_بدائي.مرفوض(خطأ_النوع) -> {
                    طابق خطأ_النوع مع
                    | خطأ_استدعاء_بدائي.عدد_حجج_غير_مطابق(_, _) -> {
                        // Runtime arity was already reported above.
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_مطابق(الفهرس, نوع_المتوقع, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_نداء_غير_مطابق(
                                الموضع, الفهرس, نوع_المتوقع, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.نوع_حجة_غير_صالح(الفهرس, نوع_الموجود) -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_حجة_بدائية_غير_صالحة(
                                الموضع, البدائي, الفهرس, نوع_الموجود
                            )
                        );
                    }
                    | خطأ_استدعاء_بدائي.دلالة_مصدرية_غير_متاحة -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
                        );
                    };
                };
            };
        }
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.عقد_نوع_بدائي_غير_متاح(الموضع, البدائي)
            );
        };

        دع فهرس_حجة_التعديل: متغير اختيار غير_موقع = اختيار.لا_شيء();
        طابق البدائي مع
        | هوية_بدائي_مترجم.إلحاق -> { فهرس_حجة_التعديل := اختيار.بعض(0); }
        | _ -> { };
        طابق فهرس_حجة_التعديل مع
        | اختيار.بعض(فهرس_التعديل) -> {
            طابق حالة_النداء.مكان_التعديل مع
            | اختيار.بعض(المكان) -> {
                لو (!هل_مكان_قابل_للكتابة_لمسير(الدالة, المكان, الأنواع, فهرس_التعريفات)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.مكان_تعديل_نداء_غير_قابل_للكتابة(الموضع)
                    );
                };
                لو (الفعلي > فهرس_التعديل) {
                    طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, حالة_النداء.الحجج[فهرس_التعديل]) مع
                    | اختيار.بعض(تعريف_الحجة) -> {
                        طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, المكان) مع
                        | اختيار.بعض(تعريف_المكان) -> {
                            لو (!معرفا_نوع_متساويان(
                                تعريف_الحجة.القيمة.النوع,
                                تعريف_المكان.القيمة.النوع
                            )) {
                                سجل_خطأ_مسير(
                                    الأخطاء,
                                    خطأ_تحقق_مسير.نوع_مكان_تعديل_نداء_غير_مطابق(
                                        الموضع,
                                        تعريف_الحجة.القيمة.النوع,
                                        تعريف_المكان.القيمة.النوع
                                    )
                                );
                            };
                        }
                        | اختيار.لا_شيء -> { };
                    }
                    | اختيار.لا_شيء -> { };
                };
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };

        // Runtime owns the broad result category; Type resolves it to the exact
        // canonical TypeID consumed here without a parallel primitive table.
        دع يتطلب_ناتج_قيمة: متغير منطقي = صواب;
        طابق العقد.فئة_الناتج مع
        | فئة_ناتج_بدائي.بلا_قيمة -> {
            يتطلب_ناتج_قيمة := خطأ;
        }
        | _ -> { };

        دع حالة_التعليمة: تعليمة_مسير = *التعليمة;
        طابق حالة_التعليمة.الناتج مع
        | اختيار.بعض(قيمة_الناتج) -> {
            لو (!يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            } وإلا {
                طابق الأنواع_المقننة_للبدائي مع
                | اختيار.بعض(القيم_المقننة) -> {
                    لو (!هل_نوع_ناتج_استدعاء_بدائي_مقنن(
                        الأنواع, &القيم_المقننة, العقد.فئة_الناتج, قيمة_الناتج.النوع
                    )) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ناتج_بدائي_غير_مطابق(
                                الموضع, البدائي, قيمة_الناتج.النوع
                            )
                        );
                    };
                }
                | اختيار.لا_شيء -> { };
            };
        }
        | اختيار.لا_شيء -> {
            لو (يتطلب_ناتج_قيمة) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.شكل_ناتج_نداء_غير_مطابق(الموضع)
                );
            };
        };
        أرجع صواب;
    };
}

عرف تحقق_تعليمة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الفهرس: غير_موقع,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[الفهرس];
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع معرف_الكتلة: معرف_كتلة_مسير = (*الكتلة).المعرف;
    دع الموضع: موضع_تعليمة_مسير = {
        الدالة: معرف_الدالة,
        الكتلة: معرف_الكتلة,
        الفهرس: الفهرس
    };
    طابق (*التعليمة).العملية مع
    | عملية_مسير.ثابت(الثابت) -> {
        تحقق_ثابت_مسير(&الثابت, التعليمة, الموضع, الأنواع, الأخطاء);
    }
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        تحقق_حساب_صحيح_مسير(
            الحساب,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.حساب_عشري(الحساب) -> {
        تحقق_حساب_عشري_مسير(الحساب, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مقارنة_عشري(المقارنة) -> {
        تحقق_مقارنة_عشرية_مسير(المقارنة, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        تحقق_مقارنة_صحيح_مسير(
            المقارنة,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        تحقق_تحويل_صحيح_مسير(
            التحويل,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.نقل_تسلسل_مملوك(النقل) -> {
        تحقق_نقل_تسلسل_مملوك_مسير(
            النقل, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة
        );
    }
    | عملية_مسير.مرجع_إلى_مؤشر(التحويل) -> {
        تحقق_مرجع_إلى_مؤشر_مسير(
            التحويل, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تجميع(العملية) -> {
        تحقق_تجميع_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تهيئة_متجه(العملية) -> {
        تحقق_تهيئة_متجه_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_حقل(العملية) -> {
        تحقق_استخراج_حقل_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_فهرس(العملية) -> {
        دع الناتج: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
        تحقق_فهرس_مسير(العملية.المصدر, العملية.الفهرس, الناتج, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_محلي(العملية) -> {
        نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    }
    | عملية_مسير.مكان_عام(العملية) -> {
        نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    }
    | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
        تحقق_مرجع_إلى_مكان_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
        تحقق_صندوق_إلى_مكان_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_حقل(العملية) -> {
        تحقق_مكان_حقل_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_فهرس(العملية) -> {
        تحقق_مكان_فهرس_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
        تحقق_موضع_تخزين_عنصر_مؤشر_مسير(
            العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تحميل(العملية) -> {
        تحقق_تحميل_مسير(العملية, التعليمة, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.تخزين(العملية) -> {
        تحقق_تخزين_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.مكان_إلى_مرجع(العملية) -> {
        تحقق_مكان_إلى_مرجع_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_موسوم(العملية) -> {
        تحقق_بناء_موسوم_مسير(&العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استعلام_وسم(العملية) -> {
        تحقق_استعلام_وسم_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_حمولة(العملية) -> {
        تحقق_استخراج_حمولة_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_صندوق(العملية) -> {
        تحقق_بناء_صندوق_مسير(العملية, التعليمة, الموضع, الدالة, الأنواع, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.بناء_إغلاق(العملية) -> {
        تحقق_بناء_إغلاق_مسير(البرنامج, &العملية, التعليمة, الموضع, الدالة, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    }
    | عملية_مسير.استخراج_التقاط(العملية) -> {
        تحقق_استخراج_التقاط_مسير(العملية, التعليمة, الموضع, الدالة, الأخطاء);
    }
    | عملية_مسير.نداء(النداء) -> {
        تحقق_نداء_مسير(
            البرنامج,
            &النداء,
            التعليمة,
            الموضع,
            الدالة,
            الأنواع,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    };
    أرجع صواب;
}

عرف تحقق_حافة_مسير(
    الدالة: &دالة_مسير,
    الكتلة_المصدر: معرف_كتلة_مسير,
    الحافة: &حافة_مسير,
    موضع_الاستخدام: غير_موقع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {

    لو (!كتلة_مسير_موجودة(الدالة, (*الحافة).الهدف)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.هدف_فرع_غير_صالح(الكتلة_المصدر, (*الحافة).الهدف)
        );
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*الحافة).الحجج) مثل غير_موقع)) {
            تحقق_استخدام_قيمة_مسير(
                الدالة,
                (*الحافة).الحجج[ف],
                الكتلة_المصدر,
                موضع_الاستخدام,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            ف := ف + 1;
        }
        أرجع خطأ;
    };
    دع معرف_الهدف: معرف_كتلة_مسير = (*الحافة).الهدف;
    دع موضع_الهدف: غير_موقع = معرف_الهدف.القيمة;
    دع الهدف: &كتلة_مسير = &(*الدالة).الكتل[موضع_الهدف];
    دع المتوقع: غير_موقع = الطول((*الهدف).المعاملات) مثل غير_موقع;
    دع الفعلي: غير_موقع = الطول((*الحافة).الحجج) مثل غير_موقع;
    لو (المتوقع != الفعلي) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_حجج_فرع_غير_مطابق(الكتلة_المصدر, (*الحافة).الهدف, المتوقع, الفعلي)
        );
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الفعلي) {
        دع الحجة: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
            الدالة,
            (*الحافة).الحجج[ف],
            الكتلة_المصدر,
            موضع_الاستخدام,
            الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
        لو (ف < المتوقع) {
            طابق الحجة مع
            | اختيار.بعض(القيمة) -> {
                دع نوع_المتوقع: معرف_نوع = (*الهدف).المعاملات[ف].النوع;
                لو (!معرفا_نوع_متساويان(نوع_المتوقع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_حجة_فرع_غير_مطابق(
                            الكتلة_المصدر,
                            (*الحافة).الهدف,
                            ف,
                            نوع_المتوقع,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف تحقق_منهي_مسير(
    الدالة: &دالة_مسير,
    الكتلة: &كتلة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع الموضع: غير_موقع = الطول((*الكتلة).التعليمات) مثل غير_موقع;
    طابق (*الكتلة).المنهي مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.كتلة_بلا_منهي((*الكتلة).المعرف)
        );
        أرجع خطأ;
    }
    | اختيار.بعض(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &الحافة,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
        }
        | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
            دع قيمة_الشرط: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                الدالة,
                الشرط,
                (*الكتلة).المعرف,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            طابق قيمة_الشرط مع
            | اختيار.بعض(القيمة) -> {
                لو (!هل_نوع_مسير_منطقي(الأنواع, القيمة.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شرط_فرع_غير_منطقي(
                            (*الكتلة).المعرف,
                            الشرط,
                            القيمة.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> {
            };
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &عند_الصواب,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
            تحقق_حافة_مسير(
                الدالة,
                (*الكتلة).المعرف,
                &عند_الخطأ,
                الموضع,
                الأخطاء,
            فهرس_التعريفات, تحليل_الهيمنة);
        }
        | منهي_مسير.إرجاع(القيمة) -> {
            طابق (*الدالة).الناتج مع
            | اختيار.لا_شيء -> {
                طابق القيمة مع
                | اختيار.بعض(المعرف) -> {
                    تحقق_استخدام_قيمة_مسير(
                        الدالة,
                        المعرف,
                        (*الكتلة).المعرف,
                        الموضع,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق((*الكتلة).المعرف)
                    );
                }
                | اختيار.لا_شيء -> {
                };
            }
            | اختيار.بعض(نوع_المتوقع) -> {
                طابق القيمة مع
                | اختيار.لا_شيء -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق((*الكتلة).المعرف)
                    );
                }
                | اختيار.بعض(المعرف) -> {
                    دع قيمة_الإرجاع: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
                        الدالة,
                        المعرف,
                        (*الكتلة).المعرف,
                        الموضع,
                        الأخطاء,
                    فهرس_التعريفات, تحليل_الهيمنة);
                    طابق قيمة_الإرجاع مع
                    | اختيار.بعض(الموجود) -> {
                        لو (!معرفا_نوع_متساويان(نوع_المتوقع, الموجود.النوع)) {
                            سجل_خطأ_مسير(
                                الأخطاء,
                                خطأ_تحقق_مسير.نوع_إرجاع_غير_مطابق(
                                    (*الكتلة).المعرف,
                                    نوع_المتوقع,
                                    الموجود.النوع
                                )
                            );
                        };
                    }
                    | اختيار.لا_شيء -> {
                    };
                };
            };
        }
        | منهي_مسير.فخ -> {
        };
    };
    أرجع صواب;
}

عرف تحقق_تعريفات_قيم_مسير(
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع التعريفات: متجه تعريف_قيمة_مسير = اجمع_تعريفات_قيم_مسير(الدالة);
    دع عدد_التعريفات: غير_موقع = الطول(التعريفات) مثل غير_موقع;
    دع عدد_القيم_المقننة: غير_موقع = الطول((*الدالة).القيم) مثل غير_موقع;

    لو (عدد_التعريفات != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عدد_قيم_دالة_غير_متطابق(
                (*الدالة).المعرف, عدد_التعريفات, عدد_القيم_المقننة
            )
        );
    };
    لو ((*الدالة).القيمة_التالية != عدد_القيم_المقننة) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.عداد_قيم_دالة_غير_متطابق(
                (*الدالة).المعرف, عدد_القيم_المقننة, (*الدالة).القيمة_التالية
            )
        );
    };

    دع المرئية: متغير متجه منطقي = [];
    دع تهيئة: متغير غير_موقع = 0;
    بينما (تهيئة < عدد_التعريفات) {
        ألحق(المرئية, خطأ);
        تهيئة := تهيئة + 1;
    }

    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_التعريفات) {
        دع القيمة: قيمة_مسير = التعريفات[ف].القيمة;
        لو (!دالتا_مسير_متساويتان(القيمة.المعرف.الدالة, (*الدالة).المعرف)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(القيمة.المعرف, (*الدالة).المعرف)
            );
        };
        لو (القيمة.المعرف.القيمة >= عدد_التعريفات) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن((*الدالة).المعرف, القيمة.المعرف.القيمة)
            );
        } وإلا {
            لو (المرئية[القيمة.المعرف.القيمة]) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.معرف_قيمة_مكرر(القيمة.المعرف)
                );
            } وإلا {
                المرئية[القيمة.المعرف.القيمة] := صواب;
            };
            لو (القيمة.المعرف.القيمة < عدد_القيم_المقننة) {
                دع المقننة: قيمة_مسير = (*الدالة).القيم[القيمة.المعرف.القيمة];
                لو (
                    !قيمتا_مسير_متساويتان(المقننة.المعرف, القيمة.المعرف)
                    || !معرفا_نوع_متساويان(المقننة.النوع, القيمة.النوع)
                ) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(
                            (*الدالة).المعرف, القيمة.المعرف.القيمة
                        )
                    );
                };
            };
        };
        لو (!نوع_مسير_صالح(الأنواع, القيمة.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(القيمة.المعرف, القيمة.النوع)
            );
        };
        ف := ف + 1;
    }

    دع المتوقع: متغير غير_موقع = 0;
    بينما (المتوقع < عدد_التعريفات) {
        لو (!المرئية[المتوقع]) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن((*الدالة).المعرف, المتوقع)
            );
        };
        المتوقع := المتوقع + 1;
    }

    دع م: متغير غير_موقع = 0;
    بينما (م < عدد_القيم_المقننة) {
        دع المقننة: قيمة_مسير = (*الدالة).القيم[م];
        لو (
            !دالتا_مسير_متساويتان(المقننة.المعرف.الدالة, (*الدالة).المعرف)
            || (المقننة.المعرف.القيمة != م)
        ) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة((*الدالة).المعرف, م)
            );
        };
        لو (!نوع_مسير_صالح(الأنواع, المقننة.النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(المقننة.المعرف, المقننة.النوع)
            );
        };
        م := م + 1;
    }
    أرجع صواب;
}

عرف تحقق_دالة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: &دالة_مسير,
    الفهرس: غير_موقع,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع فهرس_التعريفات: فهرس_تعريفات_قيم_مسير = ابن_فهرس_تعريفات_قيم_مسير(الدالة);
    دع تحليل_الهيمنة: تحليل_هيمنة_مسير = حلل_هيمنة_مسير(الدالة);
    لو ((*الدالة).المعرف.القيمة != الفهرس) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.معرف_دالة_غير_مقنن((*الدالة).المعرف, الفهرس)
        );
    };
    طابق (*الدالة).الناتج مع
    | اختيار.بعض(النوع) -> {
        لو (!نوع_مسير_صالح(الأنواع, النوع)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_ناتج_دالة_غير_صالح((*الدالة).المعرف, النوع)
            );
        };
    }
    | اختيار.لا_شيء -> {
    };

    طابق (*الدالة).المدخل مع
    | اختيار.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.دالة_بلا_مدخل((*الدالة).المعرف));
    }
    | اختيار.بعض(المدخل) -> {
        دع المدخل_صالح: منطقي = كتلة_مسير_موجودة(الدالة, المدخل);
        لو (!المدخل_صالح) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.مدخل_غير_صالح((*الدالة).المعرف, المدخل)
            );
        };
        لو (المدخل_صالح) {
            لو ((الطول((*الدالة).الكتل[المدخل.القيمة].المعاملات) مثل غير_موقع) > 0) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.كتلة_مدخل_بمعاملات(المدخل)
                );
            };
        };
    };

    تحقق_تعريفات_قيم_مسير(الدالة, الأنواع, الأخطاء);
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول((*الدالة).الكتل) مثل غير_موقع)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        لو (!دالتا_مسير_متساويتان((*الكتلة).المعرف.الدالة, (*الدالة).المعرف)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.كتلة_من_دالة_أخرى((*الكتلة).المعرف, (*الدالة).المعرف)
            );
        };
        لو ((*الكتلة).المعرف.القيمة != ك) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معرف_كتلة_غير_مقنن((*الكتلة).المعرف, ك)
            );
        };
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول((*الكتلة).التعليمات) مثل غير_موقع)) {
            تحقق_تعليمة_مسير(
                البرنامج,
                الدالة,
                الكتلة,
                ت,
                الأنواع,
                الأخطاء,
            &فهرس_التعريفات, &تحليل_الهيمنة);
            ت := ت + 1;
        }
        تحقق_منهي_مسير(الدالة, الكتلة, الأنواع, الأخطاء, &فهرس_التعريفات, &تحليل_الهيمنة);
        ك := ك + 1;
    }
    أرجع صواب;
}

// Global constant function addresses are link-time references to MSIR
// definitions. Validate them recursively before either backend emits data
// relocations; unresolved external functions use a different call identity.
عرف مراجع_دوال_ثابت_عام_صحيحة(
    البرنامج: &برنامج_مسير,
    الثابت: &ثابت_مسير
): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.دالة(المعرف) -> {
        أرجع دالة_مسير_موجودة(البرنامج, المعرف);
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع فهرس_العنصر: متغير غير_موقع = 0;
        بينما (فهرس_العنصر < (الطول(العناصر) مثل غير_موقع)) {
            لو (!مراجع_دوال_ثابت_عام_صحيحة(البرنامج, &العناصر[فهرس_العنصر])) {
                أرجع خطأ;
            };
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع صواب; };
}

// A loader-visible constructor runs before the CRT enters main. It cannot
// observe process argc/argv/envp: those globals are populated by the executable
// entry wrapper, not by the loader. Only the compiler-produced, straight-line
// owned-vector initializer is permitted at this boundary. In particular, even
// a well-typed call or load may reach startup globals indirectly, so neither
// calls nor memory reads are admitted here.
نوع قيمة_تهيئة_وحدة_مسير =
    | غير_مقننة
    | ثابتة
    | متجه_مملوك
    | مكان_عام بنوع معرف_عام_مسير
;

عرف نوع_قيمة_تهيئة_وحدة_مسير_عند(
    القيم: &متجه قيمة_تهيئة_وحدة_مسير,
    المعرف: معرف_قيمة_مسير,
    الدالة: معرف_دالة_مسير
): قيمة_تهيئة_وحدة_مسير {
    لو (!دالتا_مسير_متساويتان(المعرف.الدالة, الدالة)
        || المعرف.القيمة >= (الطول(*القيم) مثل غير_موقع)) {
        أرجع قيمة_تهيئة_وحدة_مسير.غير_مقننة();
    };
    أرجع (*القيم)[المعرف.القيمة];
}

عام عرف هل_تهيئة_وحدة_قبل_الإقلاع_آمنة_مسير(
    البرنامج: &برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    الأنواع: &سجل_أنواع
): منطقي {
    لو (!دالة_مسير_موجودة(البرنامج, الدالة)) { أرجع خطأ; };
    // Executables run language initialization after their startup wrapper;
    // standalone objects have no such wrapper and use a loader constructor.
    طابق (*البرنامج).دالة_بدء_البرنامج مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };
    دع التهيئة: &دالة_مسير = &(*البرنامج).الدوال[الدالة.القيمة];
    لو ((الطول((*التهيئة).المعاملات) مثل غير_موقع) != 0
        || (الطول((*التهيئة).الالتقاطات) مثل غير_موقع) != 0
        || (الطول((*التهيئة).الكتل) مثل غير_موقع) != 1) {
        أرجع خطأ;
    };
    طابق (*التهيئة).الناتج مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };
    دع الكتلة: &كتلة_مسير = &(*التهيئة).الكتل[0];
    طابق (*التهيئة).المدخل مع
    | اختيار.بعض(المدخل) -> {
        لو (!كتلتان_مسير_متساويتان(المدخل, (*الكتلة).المعرف)) { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { أرجع خطأ; };
    طابق (*الكتلة).المنهي مع
    | اختيار.بعض(منهي_مسير.إرجاع(اختيار.لا_شيء)) -> { }
    | _ -> { أرجع خطأ; };
    لو ((الطول((*الكتلة).المعاملات) مثل غير_موقع) != 0) { أرجع خطأ; };

    // ValueID is dense and owned by the function. A value receives its safe
    // class only after its defining instruction has been inspected. This also
    // rejects references to a later value, a parameter, or a foreign function.
    دع القيم: متغير متجه قيمة_تهيئة_وحدة_مسير = [];
    دع موضع_قيمة: متغير غير_موقع = 0;
    بينما (موضع_قيمة < (الطول((*التهيئة).القيم) مثل غير_موقع)) {
        ألحق(القيم, قيمة_تهيئة_وحدة_مسير.غير_مقننة());
        موضع_قيمة := موضع_قيمة + 1;
    }
    // Owned vectors must be moved exactly once into their parent vector or
    // final global. Reusing an owned value would duplicate buffer ownership.
    دع المستهلكة: متغير متجه منطقي = [];
    موضع_قيمة := 0;
    بينما (موضع_قيمة < (الطول(القيم) مثل غير_موقع)) {
        ألحق(المستهلكة, خطأ);
        موضع_قيمة := موضع_قيمة + 1;
    }
    دع المكتوبة: متغير متجه منطقي = [];
    دع موضع_عام: متغير غير_موقع = 0;
    بينما (موضع_عام < (الطول((*البرنامج).العوام) مثل غير_موقع)) {
        ألحق(المكتوبة, خطأ);
        موضع_عام := موضع_عام + 1;
    }
    دع عدد_التخزينات: متغير غير_موقع = 0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول((*الكتلة).التعليمات) مثل غير_موقع)) {
        دع التعليمة: &تعليمة_مسير = &(*الكتلة).التعليمات[الموضع];
        دع الحالة: متغير قيمة_تهيئة_وحدة_مسير = قيمة_تهيئة_وحدة_مسير.غير_مقننة();
        دع لها_ناتج: متغير منطقي = صواب;
        طابق (*التعليمة).العملية مع
        | عملية_مسير.ثابت(الثابت) -> {
            // Function addresses may be copied as data, but never called.
            // Static text backing is not a valid owned-vector element.
            طابق الثابت مع
            | ثابت_مسير.منطق(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.صحيح_موقع(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.صحيح_غير_موقع(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.مؤشر_فارغ -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.عشري(_) -> { الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة(); }
            | ثابت_مسير.دالة(المعرف) -> {
                لو (!دالة_مسير_موجودة(البرنامج, المعرف)) { أرجع خطأ; };
                الحالة := قيمة_تهيئة_وحدة_مسير.ثابتة();
            }
            | _ -> { أرجع خطأ; };
        }
        | عملية_مسير.تهيئة_متجه(المتجه) -> {
            دع فهرس_العنصر: متغير غير_موقع = 0;
            بينما (فهرس_العنصر < (الطول(المتجه.العناصر) مثل غير_موقع)) {
                طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, المتجه.العناصر[فهرس_العنصر], الدالة) مع
                | قيمة_تهيئة_وحدة_مسير.ثابتة -> { }
                | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
                    دع المعرف: معرف_قيمة_مسير = المتجه.العناصر[فهرس_العنصر];
                    لو (المستهلكة[المعرف.القيمة]) { أرجع خطأ; };
                    المستهلكة[المعرف.القيمة] := صواب;
                }
                | _ -> { أرجع خطأ; };
                فهرس_العنصر := فهرس_العنصر + 1;
            }
            الحالة := قيمة_تهيئة_وحدة_مسير.متجه_مملوك();
        }
        | عملية_مسير.مكان_عام(المكان) -> {
            لو (!المكان.قابل_للكتابة
                || المكان.العام.القيمة >= (الطول((*البرنامج).العوام) مثل غير_موقع)) {
                أرجع خطأ;
            };
            دع العام: &عام_مسير = &(*البرنامج).العوام[المكان.العام.القيمة];
            لو (!(*العام).قابل_للكتابة) { أرجع خطأ; };
            طابق (*العام).الاسم_الخارجي مع
            | اختيار.بعض(_) -> { أرجع خطأ; }
            | اختيار.لا_شيء -> { };
            // Only a compiler-created empty mutable vector header can be
            // replaced. No startup ABI globals, imported globals or unrelated
            // program state can be written by this constructor.
            طابق (*العام).التهيئة مع
            | ثابت_مسير.متجه(العناصر) -> {
                لو ((الطول(العناصر) مثل غير_موقع) != 0) { أرجع خطأ; };
            }
            | _ -> { أرجع خطأ; };
            طابق نوع_عنصر_متجه_دلالي(الأنواع, (*العام).النوع) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(_) -> { };
            الحالة := قيمة_تهيئة_وحدة_مسير.مكان_عام(المكان.العام);
        }
        | عملية_مسير.تخزين(التخزين) -> {
            لها_ناتج := خطأ;
            دع العام_الهدف: معرف_عام_مسير;
            طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, التخزين.المكان, الدالة) مع
            | قيمة_تهيئة_وحدة_مسير.مكان_عام(المعرف) -> { العام_الهدف := المعرف; }
            | _ -> { أرجع خطأ; };
            طابق نوع_قيمة_تهيئة_وحدة_مسير_عند(&القيم, التخزين.القيمة, الدالة) مع
            | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
                لو (المستهلكة[التخزين.القيمة.القيمة]) { أرجع خطأ; };
                المستهلكة[التخزين.القيمة.القيمة] := صواب;
            }
            | _ -> { أرجع خطأ; };
            لو (العام_الهدف.القيمة >= (الطول(المكتوبة) مثل غير_موقع)
                || المكتوبة[العام_الهدف.القيمة]) { أرجع خطأ; };
            المكتوبة[العام_الهدف.القيمة] := صواب;
            عدد_التخزينات := عدد_التخزينات + 1;
        }
        // Calls, loads, pointer conversions, branches, and all other
        // operations are prohibited during loader initialization.
        | _ -> { أرجع خطأ; };
        طابق (*التعليمة).الناتج مع
        | اختيار.بعض(القيمة) -> {
            لو (!لها_ناتج
                || !دالتا_مسير_متساويتان(القيمة.المعرف.الدالة, الدالة)
                || القيمة.المعرف.القيمة >= (الطول(القيم) مثل غير_موقع)) {
                أرجع خطأ;
            };
            طابق القيم[القيمة.المعرف.القيمة] مع
            | قيمة_تهيئة_وحدة_مسير.غير_مقننة -> { }
            | _ -> { أرجع خطأ; };
            القيم[القيمة.المعرف.القيمة] := الحالة;
        }
        | اختيار.لا_شيء -> {
            لو (لها_ناتج) { أرجع خطأ; };
        };
        الموضع := الموضع + 1;
    }
    موضع_قيمة := 0;
    بينما (موضع_قيمة < (الطول(القيم) مثل غير_موقع)) {
        طابق القيم[موضع_قيمة] مع
        | قيمة_تهيئة_وحدة_مسير.متجه_مملوك -> {
            لو (!المستهلكة[موضع_قيمة]) { أرجع خطأ; };
        }
        | _ -> { };
        موضع_قيمة := موضع_قيمة + 1;
    }
    أرجع عدد_التخزينات > 0;
}

عام عرف تحقق_برنامج_مسير(
    البرنامج: &برنامج_مسير,
    الأنواع: &سجل_أنواع
): نتيجة_تحقق_مسير {
    دع الأخطاء: متغير متجه خطأ_تحقق_مسير = [];
    طابق (*البرنامج).دالة_بدء_البرنامج مع
    | اختيار.بعض(الدالة) -> {
        لو (!دالة_مسير_موجودة(البرنامج, الدالة)) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.دالة_بدء_برنامج_غير_موجودة(الدالة)
            );
        };
    }
    | اختيار.لا_شيء -> { };
    طابق (*البرنامج).دالة_تهيئة_الوحدة مع
    | اختيار.بعض(الدالة) -> {
        لو (!هل_تهيئة_وحدة_قبل_الإقلاع_آمنة_مسير(البرنامج, الدالة, الأنواع)) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.تهيئة_وحدة_قبل_الإقلاع_غير_آمنة(الدالة)
            );
        };
    }
    | اختيار.لا_شيء -> { };
    دع مؤشر_العام: متغير غير_موقع = 0;
    بينما (مؤشر_العام < (الطول((*البرنامج).العوام) مثل غير_موقع)) {
        دع العام: &عام_مسير = &(*البرنامج).العوام[مؤشر_العام];
        دع تهيئة_مطلوبة: متغير منطقي = صواب;
        طابق (*العام).الاسم_الخارجي مع
        | اختيار.بعض(الاسم) -> {
            // External storage cannot be initialized or written by the module.
            تهيئة_مطلوبة := خطأ;
            دع اسم_صالح: متغير منطقي = (الطول(الاسم) مثل غير_موقع) != 0;
            دع فهرس_الاسم: متغير غير_موقع = 0;
            بينما (فهرس_الاسم < (الطول(الاسم) مثل غير_موقع)) {
                لو (الاسم[فهرس_الاسم] == 0) { اسم_صالح := خطأ; };
                فهرس_الاسم := فهرس_الاسم + 1;
            }
            // Separate MSIR globals must not claim the same external
            // linker symbol. The builder interns compatible declarations; a
            // duplicate here is an ABI conflict or malformed imported MSIR.
            دع السابق_الفهرس: متغير غير_موقع = 0;
            بينما (السابق_الفهرس < مؤشر_العام) {
                دع السابق: &عام_مسير = &(*البرنامج).العوام[السابق_الفهرس];
                طابق (*السابق).الاسم_الخارجي مع
                | اختيار.بعض(الاسم_السابق) -> {
                    لو (اسما_عام_خارجي_متساويان_لمسير(&الاسم_السابق, &الاسم)) {
                        اسم_صالح := خطأ;
                    };
                }
                | اختيار.لا_شيء -> { };
                السابق_الفهرس := السابق_الفهرس + 1;
            }
            // Code and data share a linker-symbol namespace. An external
            // function with this name cannot also be imported as storage.
            دع فهرس_الدالة_الخارجية: متغير غير_موقع = 0;
            بينما (فهرس_الدالة_الخارجية < (الطول((*البرنامج).الدوال_الخارجية) مثل غير_موقع)) {
                دع الدالة_الخارجية: &دالة_خارجية_مسير =
                    &(*البرنامج).الدوال_الخارجية[فهرس_الدالة_الخارجية];
                لو (اسما_عام_خارجي_متساويان_لمسير(&(*الدالة_الخارجية).الاسم, &الاسم)) {
                    اسم_صالح := خطأ;
                };
                فهرس_الدالة_الخارجية := فهرس_الدالة_الخارجية + 1;
            }
            لو (!اسم_صالح) {
                سجل_خطأ_مسير(&متغير الأخطاء,
                    خطأ_تحقق_مسير.تهيئة_عام_غير_مطابقة((*العام).المعرف, (*العام).النوع));
            };
        }
        | اختيار.لا_شيء -> { };
        لو ((*العام).المعرف.القيمة != مؤشر_العام
            || (تهيئة_مطلوبة && !هل_ثابت_مجمع_متوافق_مسير(&(*العام).التهيئة, (*العام).النوع, الأنواع))
            || (تهيئة_مطلوبة && !مراجع_دوال_ثابت_عام_صحيحة(البرنامج, &(*العام).التهيئة))) {
            سجل_خطأ_مسير(
                &متغير الأخطاء,
                خطأ_تحقق_مسير.تهيئة_عام_غير_مطابقة((*العام).المعرف, (*العام).النوع)
            );
        };
        مؤشر_العام := مؤشر_العام + 1;
    }
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*البرنامج).الدوال) مثل غير_موقع)) {
        دع الدالة: &دالة_مسير = &(*البرنامج).الدوال[ف];
        تحقق_دالة_مسير(البرنامج, الدالة, ف, الأنواع, &متغير الأخطاء);
        ف := ف + 1;
    }
    لو ((الطول(الأخطاء) مثل غير_موقع) == 0) {
        أرجع نتيجة_تحقق_مسير.صالح();
    };
    أرجع نتيجة_تحقق_مسير.مرفوض(الأخطاء);
}
