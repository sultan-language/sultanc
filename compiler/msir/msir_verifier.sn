استورد compiler.frontend.types.type_context;
عام نوع موضع_تعليمة_مسير = {
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الفهرس: طبيعي
};

عام نوع خطأ_تحقق_مسير =
    | دالة_بدء_برنامج_غير_موجودة بنوع معرف_دالة_مسير
    | تهيئة_وحدة_قبل_الإقلاع_غير_آمنة بنوع معرف_دالة_مسير
    | معرف_دالة_غير_مقنن بنوع (معرف_دالة_مسير, طبيعي)
    | دالة_بلا_مدخل بنوع معرف_دالة_مسير
    | مدخل_غير_صالح بنوع (معرف_دالة_مسير, معرف_كتلة_مسير)
    | كتلة_مدخل_بمعاملات بنوع معرف_كتلة_مسير
    | نوع_ناتج_دالة_غير_صالح بنوع (معرف_دالة_مسير, معرف_نوع)
    | معرف_كتلة_غير_مقنن بنوع (معرف_كتلة_مسير, طبيعي)
    | كتلة_من_دالة_أخرى بنوع (معرف_كتلة_مسير, معرف_دالة_مسير)
    | كتلة_بلا_منهي بنوع معرف_كتلة_مسير
    | معرف_قيمة_مكرر بنوع معرف_قيمة_مسير
    | معرف_قيمة_غير_مقنن بنوع (معرف_دالة_مسير, طبيعي)
    | عدد_قيم_دالة_غير_متطابق بنوع (معرف_دالة_مسير, طبيعي, طبيعي)
    | قيمة_مقننة_غير_متطابقة بنوع (معرف_دالة_مسير, طبيعي)
    | عداد_قيم_دالة_غير_متطابق بنوع (معرف_دالة_مسير, طبيعي, طبيعي)
    | قيمة_من_دالة_أخرى بنوع (معرف_قيمة_مسير, معرف_دالة_مسير)
    | قيمة_غير_موجودة بنوع معرف_قيمة_مسير
    | نوع_قيمة_غير_صالح بنوع (معرف_قيمة_مسير, معرف_نوع)
    | استخدام_قبل_التعريف بنوع (معرف_قيمة_مسير, موضع_تعليمة_مسير)
    | تعريف_لا_يهيمن بنوع (معرف_قيمة_مسير, معرف_كتلة_مسير)
    | تعليمة_بلا_ناتج بنوع موضع_تعليمة_مسير
    | نوع_ثابت_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | تهيئة_عام_غير_مطابقة بنوع (معرف_عام_مسير, معرف_نوع)
    | معامل_حساب_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوعا_معاملين_غير_متطابقين بنوع موضع_تعليمة_مسير
    | إشارة_عملية_حساب_غير_مطابقة بنوع (موضع_تعليمة_مسير, عملية_حساب_صحيح, معرف_نوع)
    | نوع_ناتج_حساب_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_ناتج_مقارنة_غير_منطقي بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | تحويل_صحيح_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | تحويل_مرجع_إلى_مؤشر_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نقل_تسلسل_مملوك_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | مكان_مستخدم_كقيمة بنوع (موضع_تعليمة_مسير, معرف_قيمة_مسير)
    | قيمة_مستخدمة_كمكان بنوع (موضع_تعليمة_مسير, معرف_قيمة_مسير)
    | تعليمة_بناتج_غير_متوقع بنوع موضع_تعليمة_مسير
    | تجميع_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | عضو_تجميع_غير_مطابق بنوع (موضع_تعليمة_مسير, طبيعي, معرف_نوع, معرف_نوع)
    | حقل_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, طبيعي)
    | نوع_حقل_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | فهرسة_غير_صالحة بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_فهرس_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_عنصر_فهرس_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | مرجع_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | نوع_مكان_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | تخزين_غير_متوافق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_مرجع_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_موسوم_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | منشئ_موسوم_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع, طبيعي)
    | حمولة_موسومة_غير_صالحة بنوع (موضع_تعليمة_مسير, معرف_نوع, طبيعي, طبيعي)
    | عدد_حمولات_غير_مطابق بنوع (موضع_تعليمة_مسير, طبيعي, طبيعي)
    | نوع_حمولة_غير_مطابق بنوع (موضع_تعليمة_مسير, طبيعي, معرف_نوع, معرف_نوع)
    | نوع_وسم_غير_صحيح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | صندوق_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_نوع)
    | هدف_نداء_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_دالة_مسير)
    | هدف_نداء_خارجي_غير_صالح بنوع (موضع_تعليمة_مسير, معرف_دالة_خارجية_مسير)
    | عدد_حجج_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, طبيعي, طبيعي)
    | نوع_حجة_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, طبيعي, معرف_نوع, معرف_نوع)
    | شكل_ناتج_نداء_غير_مطابق بنوع موضع_تعليمة_مسير
    | نوع_ناتج_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | نوع_حجة_بدائية_غير_صالحة بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم, طبيعي, معرف_نوع)
    | عقد_نوع_بدائي_غير_متاح بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم)
    | عقد_ذاكرة_نداء_غير_صالح بنوع (موضع_تعليمة_مسير, طبيعي)
    | نوع_ناتج_بدائي_غير_مطابق بنوع (موضع_تعليمة_مسير, هوية_بدائي_مترجم, معرف_نوع)
    | مكان_تعديل_نداء_مفقود بنوع موضع_تعليمة_مسير
    | مكان_تعديل_نداء_غير_متوقع بنوع موضع_تعليمة_مسير
    | مكان_تعديل_نداء_غير_قابل_للكتابة بنوع موضع_تعليمة_مسير
    | نوع_مكان_تعديل_نداء_غير_مطابق بنوع (موضع_تعليمة_مسير, معرف_نوع, معرف_نوع)
    | هدف_فرع_غير_صالح بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير)
    | عدد_حجج_فرع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير, طبيعي, طبيعي)
    | نوع_حجة_فرع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_كتلة_مسير, طبيعي, معرف_نوع, معرف_نوع)
    | شرط_فرع_غير_منطقي بنوع (معرف_كتلة_مسير, معرف_قيمة_مسير, معرف_نوع)
    | مميز_فرع_غير_صحيح بنوع (معرف_كتلة_مسير, معرف_قيمة_مسير, معرف_نوع)
    | وسم_فرع_مكرر بنوع (معرف_كتلة_مسير, طبيعي)
    // A case key that is not a bit pattern of the selector's width.
    | وسم_فرع_خارج_عرض_المميز بنوع (معرف_كتلة_مسير, طبيعي)
    | شكل_إرجاع_غير_مطابق بنوع معرف_كتلة_مسير
    | نوع_إرجاع_غير_مطابق بنوع (معرف_كتلة_مسير, معرف_نوع, معرف_نوع)
;

عام نوع نتيجة_تحقق_مسير =
    | صالح
    | مرفوض بنوع متجه خطأ_تحقق_مسير
;

نوع موضع_تعريف_قيمة_مسير =
    | معامل_دالة
    | معامل_كتلة بنوع معرف_كتلة_مسير
    | تعليمة بنوع (معرف_كتلة_مسير, طبيعي)
;

نوع تعريف_قيمة_مسير = {
    القيمة: قيمة_مسير,
    الموضع: موضع_تعريف_قيمة_مسير
};

// Definition index of the function being verified. تحقق_برنامج_مسير owns one
// index for the whole program and rebuilds it in place per function: entries
// past العدد are stale capacity from a larger earlier function. Building a
// fresh vector per function retained one dead index per function, because the
// compiler never releases vectors.
نوع فهرس_تعريفات_قيم_مسير = {
    التعريفات: متجه اختياري تعريف_قيمة_مسير,
    العدد: طبيعي
};

نوع إشارة_صحيح_مسير =
    | موقع
    | طبيعي
;

نوع وصف_صحيح_مسير = {
    الإشارة: إشارة_صحيح_مسير,
    البتات: طبيعي
};

عرف سجل_خطأ_مسير(
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    المشكلة: خطأ_تحقق_مسير
): منطقي {
    ألحق(*الأخطاء, المشكلة);
    أرجع صواب;
}

عرف نوع_مسير_صالح(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    أرجع معرف_نوع_صالح(الأنواع, المعرف);
}

عرف هل_نوع_مسير_منطقي(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            طابق البدائي مع
            | نوع_بدائي_مقنن.منطقي -> {
                أرجع صواب;
            }
            | _ -> {
                أرجع خطأ;
            };
        }
        | _ -> {
            أرجع خطأ;
        };
    };
}

عرف هل_نوع_مسير_عشري(الأنواع: &سجل_أنواع, المعرف: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            أرجع صنف_النوع_البدائي(البدائي) == صنف_نوع_بدائي.عشري();
        }
        | _ -> { أرجع خطأ; };
    };
}

عرف وصف_صحيح_لمسير(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_صحيح_مسير {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(وصف_النوع) -> {
        طابق وصف_النوع.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
            طابق الصنف مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.موقع();
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الوصف);
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.طبيعي();
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الوصف);
            }
            | _ -> {
                أرجع اختياري.لا_شيء();
            };
        }
        | _ -> {
            أرجع اختياري.لا_شيء();
        };
    };
}


عرف وصف_مصدر_تحويل_صحيح_لمسير(
    الأنواع: &سجل_أنواع,
    المعرف: معرف_نوع
): اختياري وصف_صحيح_مسير {
    طابق وصف_صحيح_لمسير(الأنواع, المعرف) مع
    | اختياري.موجود(الوصف) -> {
        أرجع اختياري.موجود(الوصف);
    }
    | اختياري.لا_شيء -> { };

    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
    | اختياري.موجود(وصف_النوع) -> {
        طابق وصف_النوع.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
            إذا (البدائي == نوع_بدائي_مقنن.حرف()) {
                دع الإشارة: إشارة_صحيح_مسير = إشارة_صحيح_مسير.طبيعي();
                دع البتات: طبيعي = بتات_نوع_بدائي(البدائي);
                دع الوصف: وصف_صحيح_مسير = {
                    الإشارة: الإشارة,
                    البتات: البتات
                };
                أرجع اختياري.موجود(الوصف);
            };
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف ابحث_تعريف_قيمة_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري تعريف_قيمة_مسير {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        إذا (قيمتا_مسير_متساويتان((*الدالة).المعاملات[ف].المعرف, المعرف)) {
            دع الموضع: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.معامل_دالة();
            دع قيمة_المعامل: قيمة_مسير = (*الدالة).المعاملات[ف];
            دع التعريف: تعريف_قيمة_مسير = {
                القيمة: قيمة_المعامل,
                الموضع: الموضع
            };
            أرجع اختياري.موجود(التعريف);
        };
        ف := ف + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        ف := 0;
        طالما (ف < (الطول((*الكتلة).المعاملات) مثل طبيعي)) {
            إذا (قيمتا_مسير_متساويتان((*الكتلة).المعاملات[ف].المعرف, المعرف)) {
                دع الموضع: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.معامل_كتلة((*الكتلة).المعرف);
                دع قيمة_المعامل: قيمة_مسير = (*الكتلة).المعاملات[ف];
                دع التعريف: تعريف_قيمة_مسير = {
                    القيمة: قيمة_المعامل,
                    الموضع: الموضع
                };
                أرجع اختياري.موجود(التعريف);
            };
            ف := ف + 1;
        }
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &(*الكتلة).التعليمات[ت]) مع
            | اختياري.موجود(القيمة) -> {
                إذا (قيمتا_مسير_متساويتان(القيمة.المعرف, المعرف)) {
                    دع الموضع: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.تعليمة((*الكتلة).المعرف, ت);
                    دع التعريف: تعريف_قيمة_مسير = { القيمة: القيمة, الموضع: الموضع };
                    أرجع اختياري.موجود(التعريف);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف فهرس_تعريفات_قيم_مسير_فارغ(): فهرس_تعريفات_قيم_مسير {
    دع التعريفات: متجه اختياري تعريف_قيمة_مسير = [];
    دع الناتج: فهرس_تعريفات_قيم_مسير = { التعريفات: التعريفات, العدد: 0 };
    أرجع الناتج;
}

عرف أعد_بناء_فهرس_تعريفات_قيم_مسير(
    الفهرس: &متغير فهرس_تعريفات_قيم_مسير,
    الدالة: &دالة_مسير
): فراغ {
    دع العدد: طبيعي = الطول((*الدالة).القيم) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف < (الطول((*الفهرس).التعريفات) مثل طبيعي)) {
            (*الفهرس).التعريفات[ف] := اختياري.لا_شيء();
        } وإلا {
            ألحق((*الفهرس).التعريفات, اختياري.لا_شيء());
        };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع القيمة: قيمة_مسير = (*الدالة).المعاملات[ف];
        إذا ((القيمة.المعرف.القيمة مثل طبيعي) < العدد) {
            دع الموضع: موضع_تعريف_قيمة_مسير = موضع_تعريف_قيمة_مسير.معامل_دالة();
            دع التعريف: تعريف_قيمة_مسير = { القيمة: القيمة, الموضع: الموضع };
            (*الفهرس).التعريفات[القيمة.المعرف.القيمة] := اختياري.موجود(التعريف);
        };
        ف := ف + 1;
    }

    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[ك];
        ف := 0;
        طالما (ف < (الطول((*الكتلة).المعاملات) مثل طبيعي)) {
            دع القيمة: قيمة_مسير = (*الكتلة).المعاملات[ف];
            إذا ((القيمة.المعرف.القيمة مثل طبيعي) < العدد) {
                دع الموضع: موضع_تعريف_قيمة_مسير =
                    موضع_تعريف_قيمة_مسير.معامل_كتلة((*الكتلة).المعرف);
                دع التعريف: تعريف_قيمة_مسير = { القيمة: القيمة, الموضع: الموضع };
                (*الفهرس).التعريفات[القيمة.المعرف.القيمة] := اختياري.موجود(التعريف);
            };
            ف := ف + 1;
        }
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الكتلة).التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, &(*الكتلة).التعليمات[ت]) مع
            | اختياري.موجود(القيمة) -> {
                إذا ((القيمة.المعرف.القيمة مثل طبيعي) < العدد) {
                    دع الموضع: موضع_تعريف_قيمة_مسير =
                        موضع_تعريف_قيمة_مسير.تعليمة((*الكتلة).المعرف, ت);
                    دع التعريف: تعريف_قيمة_مسير = { القيمة: القيمة, الموضع: الموضع };
                    (*الفهرس).التعريفات[القيمة.المعرف.القيمة] := اختياري.موجود(التعريف);
                };
            }
            | اختياري.لا_شيء -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }

    (*الفهرس).العدد := العدد;
}

عرف ابحث_تعريف_قيمة_مسير_مفهرس(
    الفهرس: &فهرس_تعريفات_قيم_مسير,
    المعرف: معرف_قيمة_مسير
): اختياري تعريف_قيمة_مسير {
    إذا ((المعرف.القيمة مثل طبيعي) >= (*الفهرس).العدد) {
        أرجع اختياري.لا_شيء();
    };
    أرجع (*الفهرس).التعريفات[المعرف.القيمة];
}


عرف تحتوي_معرفات_كتل_مسير(
    القيم: &متجه معرف_كتلة_مسير,
    المعرف: معرف_كتلة_مسير
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا (كتلتان_مسير_متساويتان((*القيم)[ف], المعرف)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف هل_كتلة_محظورة_لمسير(
    المعرف: معرف_كتلة_مسير,
    المحظورة: &اختياري معرف_كتلة_مسير
): منطقي {
    دع الحالة: اختياري معرف_كتلة_مسير = *المحظورة;
    طابق الحالة مع
    | اختياري.موجود(القيمة) -> {
        أرجع كتلتان_مسير_متساويتان(المعرف, القيمة);
    }
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    };
}

عرف يمكن_الوصول_في_مسير(
    الدالة: &دالة_مسير,
    البداية: معرف_كتلة_مسير,
    الهدف: معرف_كتلة_مسير,
    المحظورة: اختياري معرف_كتلة_مسير
): منطقي {
    إذا (!كتلة_مسير_موجودة(الدالة, البداية) || !كتلة_مسير_موجودة(الدالة, الهدف)) {
        أرجع خطأ;
    };
    إذا (هل_كتلة_محظورة_لمسير(البداية, &المحظورة)) {
        أرجع خطأ;
    };
    دع الانتظار: متغير متجه معرف_كتلة_مسير = [];
    دع المزارة: متغير متجه معرف_كتلة_مسير = [];
    ألحق(الانتظار, البداية);
    دع موضع: متغير طبيعي = 0;

    طالما (موضع < (الطول(الانتظار) مثل طبيعي)) {
        دع الحالية: معرف_كتلة_مسير = الانتظار[موضع];
        موضع := موضع + 1;
        إذا (!تحتوي_معرفات_كتل_مسير(&المزارة, الحالية)) {
            ألحق(المزارة, الحالية);
            إذا (كتلتان_مسير_متساويتان(الحالية, الهدف)) {
                أرجع صواب;
            };
            دع الكتلة: &كتلة_مسير = &(*الدالة).الكتل[الحالية.القيمة];
            دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(الكتلة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الخلفاء) مثل طبيعي)) {
                دع التالي: معرف_كتلة_مسير = الخلفاء[ف];
                إذا (
                    كتلة_مسير_موجودة(الدالة, التالي)
                    && !هل_كتلة_محظورة_لمسير(التالي, &المحظورة)
                    && !تحتوي_معرفات_كتل_مسير(&المزارة, التالي)
                ) {
                    ألحق(الانتظار, التالي);
                };
                ف := ف + 1;
            }
        };
    }
    أرجع خطأ;
}

عرف هل_كتلة_تهيمن_في_مسير(
    الدالة: &دالة_مسير,
    المهيمنة: معرف_كتلة_مسير,
    التابعة: معرف_كتلة_مسير
): منطقي {
    إذا (كتلتان_مسير_متساويتان(المهيمنة, التابعة)) {
        أرجع صواب;
    };
    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(المدخل) -> {
        دع بلا_حظر: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
        إذا (!يمكن_الوصول_في_مسير(الدالة, المدخل, التابعة, بلا_حظر)) {
            أرجع خطأ;
        };
        إذا (كتلتان_مسير_متساويتان(المهيمنة, المدخل)) {
            أرجع صواب;
        };
        دع بلا_حظر_للمهيمنة: اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
        إذا (!يمكن_الوصول_في_مسير(الدالة, المدخل, المهيمنة, بلا_حظر_للمهيمنة)) {
            أرجع خطأ;
        };
        دع الحظر: اختياري معرف_كتلة_مسير = اختياري.موجود(المهيمنة);
        أرجع !يمكن_الوصول_في_مسير(الدالة, المدخل, التابعة, الحظر);
    };
}

عرف هل_تعريف_مكان_مسير(
    الدالة: &دالة_مسير,
    التعريف: &تعريف_قيمة_مسير
): منطقي {
    طابق (*التعريف).الموضع مع
    | موضع_تعريف_قيمة_مسير.تعليمة(الكتلة, الفهرس) -> {
        إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول((*الدالة).الكتل) مثل طبيعي)) {
            أرجع خطأ;
        };
        دع حالة_الكتلة: &كتلة_مسير = &(*الدالة).الكتل[الكتلة.القيمة];
        إذا (الفهرس >= (الطول((*حالة_الكتلة).التعليمات) مثل طبيعي)) {
            أرجع خطأ;
        };
        طابق (*حالة_الكتلة).التعليمات[الفهرس].العملية مع
        | عملية_مسير.مكان_محلي(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مكان_عام(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مرجع_إلى_مكان(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.صندوق_إلى_مكان(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مكان_حقل(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.مكان_فهرس(العملية) -> {
            أرجع صواب;
        }
        | عملية_مسير.موضع_تخزين_عنصر_مؤشر(العملية) -> {
            أرجع صواب;
        }
        | _ -> {
            أرجع خطأ;
        };
    }
    | _ -> {
        أرجع خطأ;
    };
}

عرف تحقق_استخدام_هوية_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: طبيعي,
    يقبل_مكانا: منطقي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): اختياري قيمة_مسير {
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    إذا (!دالتا_مسير_متساويتان(المعرف.الدالة, معرف_الدالة)) {
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(المعرف, معرف_الدالة)
        );
        أرجع اختياري.لا_شيء();
    };
    دع التعريف: اختياري تعريف_قيمة_مسير = ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, المعرف);
    طابق التعريف مع
    | اختياري.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.قيمة_غير_موجودة(المعرف));
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الموجود) -> {
        طابق الموجود.الموضع مع
        | موضع_تعريف_قيمة_مسير.معامل_دالة -> {
        }
        | موضع_تعريف_قيمة_مسير.معامل_كتلة(كتلة_التعريف) -> {
            إذا (!كتلتان_مسير_متساويتان(كتلة_التعريف, الكتلة)) {
                إذا (!كتلة_تهيمن_على(تحليل_الهيمنة, كتلة_التعريف, الكتلة)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تعريف_لا_يهيمن(المعرف, الكتلة)
                    );
                };
            };
        }
        | موضع_تعريف_قيمة_مسير.تعليمة(كتلة_التعريف, موضع_التعريف) -> {
            إذا (كتلتان_مسير_متساويتان(كتلة_التعريف, الكتلة)) {
                إذا (موضع_التعريف >= موضع_الاستخدام) {
                    دع الموضع: موضع_تعليمة_مسير = {
                        الدالة: معرف_الدالة,
                        الكتلة: الكتلة,
                        الفهرس: موضع_الاستخدام
                    };
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.استخدام_قبل_التعريف(المعرف, الموضع)
                    );
                };
            } وإلا {
                إذا (!كتلة_تهيمن_على(تحليل_الهيمنة, كتلة_التعريف, الكتلة)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.تعريف_لا_يهيمن(المعرف, الكتلة)
                    );
                };
            };
        };
        إذا (!يقبل_مكانا && هل_تعريف_مكان_مسير(الدالة, &الموجود)) {
            دع الموضع: موضع_تعليمة_مسير = {
                الدالة: معرف_الدالة,
                الكتلة: الكتلة,
                الفهرس: موضع_الاستخدام
            };
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.مكان_مستخدم_كقيمة(الموضع, المعرف)
            );
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(الموجود.القيمة);
    };
}

عرف تحقق_استخدام_قيمة_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: طبيعي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): اختياري قيمة_مسير {
    أرجع تحقق_استخدام_هوية_مسير(
        الدالة, المعرف, الكتلة, موضع_الاستخدام, خطأ, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
}

عرف تحقق_استخدام_مكان_مسير(
    الدالة: &دالة_مسير,
    المعرف: معرف_قيمة_مسير,
    الكتلة: معرف_كتلة_مسير,
    موضع_الاستخدام: طبيعي,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): اختياري قيمة_مسير {
    دع معرف_الدالة: معرف_دالة_مسير = (*الدالة).المعرف;
    دع القيمة: اختياري قيمة_مسير = تحقق_استخدام_هوية_مسير(
        الدالة, المعرف, الكتلة, موضع_الاستخدام, صواب, الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    طابق القيمة مع
    | اختياري.لا_شيء -> {
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(الموجودة) -> {
        طابق ابحث_تعريف_قيمة_مسير_مفهرس(فهرس_التعريفات, المعرف) مع
        | اختياري.موجود(التعريف) -> {
            إذا (هل_تعريف_مكان_مسير(الدالة, &التعريف)) {
                أرجع اختياري.موجود(الموجودة);
            };
        }
        | اختياري.لا_شيء -> { };
        دع الموضع: موضع_تعليمة_مسير = {
            الدالة: معرف_الدالة,
            الكتلة: الكتلة,
            الفهرس: موضع_الاستخدام
        };
        سجل_خطأ_مسير(
            الأخطاء,
            خطأ_تحقق_مسير.قيمة_مستخدمة_كمكان(الموضع, المعرف)
        );
        أرجع اختياري.لا_شيء();
    };
}

عرف نتيجة_تعليمة_مسير(
    الدالة: &دالة_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): اختياري قيمة_مسير {
    طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | اختياري.لا_شيء -> {
        سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.تعليمة_بلا_ناتج(الموضع));
        أرجع اختياري.لا_شيء();
    };
}

عرف هل_موقعان_متساويان(أ: إشارة_صحيح_مسير, ب: إشارة_صحيح_مسير): منطقي {
    طابق أ مع
    | إشارة_صحيح_مسير.موقع -> {
        طابق ب مع
        | إشارة_صحيح_مسير.موقع -> {
            أرجع صواب;
        }
        | إشارة_صحيح_مسير.طبيعي -> {
            أرجع خطأ;
        };
    }
    | إشارة_صحيح_مسير.طبيعي -> {
        طابق ب مع
        | إشارة_صحيح_مسير.طبيعي -> {
            أرجع صواب;
        }
        | إشارة_صحيح_مسير.موقع -> {
            أرجع خطأ;
        };
    };
}

عرف هل_قيمة_موقعة_تلائم(القيمة: عدد, البتات: طبيعي): منطقي {
    إذا (البتات == 8) {
        أرجع (القيمة >= -128) && (القيمة <= 127);
    };
    إذا (البتات == 16) {
        أرجع (القيمة >= -32768) && (القيمة <= 32767);
    };
    إذا (البتات == 32) {
        أرجع (القيمة >= -2147483648) && (القيمة <= 2147483647);
    };
    أرجع البتات == 64;
}

عرف هل_قيمة_طبيعية_تلائم(القيمة: طبيعي, البتات: طبيعي): منطقي {
    إذا (البتات == 8) {
        أرجع القيمة <= 255;
    };
    إذا (البتات == 16) {
        أرجع القيمة <= 65535;
    };
    إذا (البتات == 32) {
        أرجع القيمة <= 4294967295;
    };
    أرجع البتات == 64;
}

// A constant of the char Type is a Unicode scalar value: not a surrogate
// (U+D800..DFFF) and not past U+10FFFF. Constant evaluation already refuses
// to make another; the verifier enforces it for every producer of MSIR.
عرف هل_نوع_حرف_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع): منطقي {
    طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
    | اختياري.موجود(وصف_النوع) -> {
        طابق وصف_النوع.الصنف مع
        | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> { أرجع البدائي == نوع_بدائي_مقنن.حرف(); }
        | _ -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف ثابت_حرف_صالح_مسير(الأنواع: &سجل_أنواع, النوع: معرف_نوع, القيمة: طبيعي): منطقي {
    إذا (!هل_نوع_حرف_مسير(الأنواع, النوع)) { أرجع صواب; };
    أرجع القيمة <= 0x10FFFF && (القيمة < 0xD800 || القيمة > 0xDFFF);
}

// Validate aggregate constant elements against the canonical semantic type,
// including integer widths. This is also used recursively for nested vectors.
عرف هل_ثابت_مجمع_متوافق_مسير(
    الثابت: &ثابت_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.منطق(_) -> { أرجع هل_نوع_مسير_منطقي(الأنواع, النوع); }
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        طابق وصف_صحيح_لمسير(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            أرجع الوصف.الإشارة == إشارة_صحيح_مسير.موقع()
                && هل_قيمة_موقعة_تلائم(القيمة, الوصف.البتات);
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | ثابت_مسير.مؤشر_فارغ -> {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(مرجع_النوع_34) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_34.القيمة] مع
            | نوع_مقنن.مؤشر(_) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        طابق وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, النوع) مع
        | اختياري.موجود(الوصف) -> {
            أرجع الوصف.الإشارة == إشارة_صحيح_مسير.طبيعي()
                && هل_قيمة_طبيعية_تلائم(القيمة, الوصف.البتات)
                && ثابت_حرف_صالح_مسير(الأنواع, النوع, القيمة);
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | ثابت_مسير.عشري(_) -> { أرجع هل_نوع_مسير_عشري(الأنواع, النوع); }
    | ثابت_مسير.نص(_) -> { أرجع هل_نوع_بدائي_لمسير(الأنواع, النوع, نوع_بدائي_مقنن.نص()); }
    | ثابت_مسير.دالة(_) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.دالة -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    }
    | ثابت_مسير.متجه(العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(القيمة) -> { نوع_العنصر := القيمة; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            إذا (!هل_ثابت_مجمع_متوافق_مسير(&العناصر[فهرس_العنصر], نوع_العنصر, الأنواع)) {
                أرجع خطأ;
            };
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        أرجع صواب;
    };
}

عرف تحقق_ثابت_مسير(
    الدالة: &دالة_مسير,
    الثابت: &ثابت_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق الناتج مع
    | اختياري.لا_شيء -> {
        أرجع خطأ;
    }
    | اختياري.موجود(القيمة) -> {
        طابق *الثابت مع
        | ثابت_مسير.منطق(الحقيقة) -> {
            إذا (!هل_نوع_مسير_منطقي(الأنواع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.صحيح_موقع(العدد) -> {
            طابق وصف_صحيح_لمسير(الأنواع, القيمة.النوع) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            }
            | اختياري.موجود(الوصف) -> {
                طابق الوصف.الإشارة مع
                | إشارة_صحيح_مسير.موقع -> {
                    إذا (!هل_قيمة_موقعة_تلائم(العدد, الوصف.البتات)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | إشارة_صحيح_مسير.طبيعي -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            };
        }
        | ثابت_مسير.صحيح_طبيعي(العدد) -> {
            طابق وصف_مصدر_تحويل_صحيح_لمسير(الأنواع, القيمة.النوع) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            }
            | اختياري.موجود(الوصف) -> {
                طابق الوصف.الإشارة مع
                | إشارة_صحيح_مسير.طبيعي -> {
                    إذا (!هل_قيمة_طبيعية_تلائم(العدد, الوصف.البتات)
                        || !ثابت_حرف_صالح_مسير(الأنواع, القيمة.النوع, العدد)) {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | إشارة_صحيح_مسير.موقع -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            };
        }
        | ثابت_مسير.مؤشر_فارغ -> {
            طابق معرف_نوع_أساس_عند(الأنواع, القيمة.النوع) مع
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء, خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            }
            | اختياري.موجود(مرجع_النوع_35) -> {
                طابق (*الأنواع).الأنواع[مرجع_النوع_35.القيمة] مع
                | نوع_مقنن.مؤشر(_) -> { }
                | _ -> {
                سجل_خطأ_مسير(
                    الأخطاء, خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
            };
        }
        | ثابت_مسير.دالة(الهدف) -> {
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة.النوع) مع
            | اختياري.موجود(الوصف) -> {
                طابق الوصف.الصنف مع
                | صنف_شكل_نوع_دلالي.دالة -> { }
                | _ -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            }
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.متجه(_) -> {
            إذا (!هل_ثابت_مجمع_متوافق_مسير(الثابت, القيمة.النوع, الأنواع)) {
                سجل_خطأ_مسير(
                    الأخطاء, خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.عشري(البايتات) -> {
            إذا (!هل_نوع_مسير_عشري(الأنواع, القيمة.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        }
        | ثابت_مسير.نص(البايتات) -> {
            // البايتات مقننة ومفكوكة قبل MSIR؛ verifier يتحقق من Type فقط ولا يعيد تفسير المحتوى.
            طابق وصف_شكل_نوع_دلالي_عند(الأنواع, القيمة.النوع) مع
            | اختياري.موجود(الوصف) -> {
                طابق الوصف.الصنف مع
                | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                    طابق البدائي مع
                    | نوع_بدائي_مقنن.نص -> { }
                    | _ -> {
                        سجل_خطأ_مسير(
                            الأخطاء,
                            خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                        );
                        أرجع خطأ;
                    };
                }
                | _ -> {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                    );
                    أرجع خطأ;
                };
            }
            | اختياري.لا_شيء -> {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, القيمة.النوع)
                );
                أرجع خطأ;
            };
        };
        أرجع صواب;
    };
}

عرف إشارة_مطلوبة_لعملية_حساب_مسير(
    العملية: عملية_حساب_صحيح
): اختياري إشارة_صحيح_مسير {
    طابق العملية مع
    | عملية_حساب_صحيح.قسمة_موقعة -> {
        أرجع اختياري.موجود(إشارة_صحيح_مسير.موقع());
    }
    | عملية_حساب_صحيح.باقي_موقع -> {
        أرجع اختياري.موجود(إشارة_صحيح_مسير.موقع());
    }
    | عملية_حساب_صحيح.قسمة_طبيعية -> {
        أرجع اختياري.موجود(إشارة_صحيح_مسير.طبيعي());
    }
    | عملية_حساب_صحيح.باقي_طبيعي -> {
        أرجع اختياري.موجود(إشارة_صحيح_مسير.طبيعي());
    }
    | _ -> {
        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_إشارة_عملية_حساب_مسير(
    الحساب: حساب_صحيح_مسير,
    الوصف: وصف_صحيح_مسير,
    النوع: معرف_نوع,
    الموضع: موضع_تعليمة_مسير,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    طابق إشارة_مطلوبة_لعملية_حساب_مسير(الحساب.العملية) مع
    | اختياري.لا_شيء -> {
        أرجع صواب;
    }
    | اختياري.موجود(المطلوبة) -> {
        إذا (!هل_موقعان_متساويان(الوصف.الإشارة, المطلوبة)) {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.إشارة_عملية_حساب_غير_مطابقة(
                    الموضع,
                    الحساب.العملية,
                    النوع
                )
            );
            أرجع خطأ;
        };
        أرجع صواب;
    };
}

عرف تحقق_حساب_صحيح_مسير(
    الحساب: حساب_صحيح_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع اليسار: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        الحساب.اليسار,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع اليمين: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة,
        الحساب.اليمين,
        الموضع.الكتلة,
        الموضع.الفهرس,
        الأخطاء,
        فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق اليسار مع
    | اختياري.موجود(أ) -> {
        طابق وصف_صحيح_لمسير(الأنواع, أ.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
            تحقق_إشارة_عملية_حساب_مسير(
                الحساب,
                الوصف,
                أ.النوع,
                الموضع,
                الأخطاء
            );
        };
        طابق اليمين مع
        | اختياري.موجود(ب) -> {
            إذا (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع)
                );
            };
        }
        | اختياري.لا_شيء -> {
        };
        طابق الناتج مع
        | اختياري.موجود(ن) -> {
            إذا (!معرفا_نوع_متساويان(أ.النوع, ن.النوع)) {
                دع مرجع_نوع_المعامل: &معرف_نوع = &أ.النوع;
                دع مرجع_نوع_الناتج: &معرف_نوع = &ن.النوع;
                دع نوع_المعامل: معرف_نوع = *مرجع_نوع_المعامل;
                دع نوع_الناتج: معرف_نوع = *مرجع_نوع_الناتج;
                سجل_خطأ_مسير(
                    الأخطاء,
                    خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, نوع_المعامل, نوع_الناتج)
                );
            };
        }
        | اختياري.لا_شيء -> {
        };
    }
    | اختياري.لا_شيء -> {
    };
    طابق اليمين مع
    | اختياري.موجود(ب) -> {
        طابق وصف_صحيح_لمسير(الأنواع, ب.النوع) مع
        | اختياري.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع)
            );
        }
        | اختياري.موجود(الوصف) -> {
        };
    }
    | اختياري.لا_شيء -> {
    };
    أرجع صواب;
}

عرف تحقق_حساب_عشري_مسير(
    الحساب: حساب_عشري_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير,
    فهرس_التعريفات: &فهرس_تعريفات_قيم_مسير,
    تحليل_الهيمنة: &تحليل_هيمنة_مسير
): منطقي {
    دع اليسار: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الحساب.اليسار, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع اليمين: اختياري قيمة_مسير = تحقق_استخدام_قيمة_مسير(الدالة, الحساب.اليمين, الموضع.الكتلة, الموضع.الفهرس, الأخطاء, فهرس_التعريفات, تحليل_الهيمنة);
    دع الناتج: اختياري قيمة_مسير = نتيجة_تعليمة_مسير(الدالة, التعليمة, الموضع, الأخطاء);
    طابق اليسار مع
    | اختياري.موجود(أ) -> {
        إذا (!هل_نوع_مسير_عشري(الأنواع, أ.النوع)) {
            سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, أ.النوع));
        };
        طابق اليمين مع
        | اختياري.موجود(ب) -> {
            إذا (!هل_نوع_مسير_عشري(الأنواع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, ب.النوع));
            };
            إذا (!معرفا_نوع_متساويان(أ.النوع, ب.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع));
            };
        }
        | اختياري.لا_شيء -> { };
        طابق الناتج مع
        | اختياري.موجود(ن) -> {
            إذا (!معرفا_نوع_متساويان(أ.النوع, ن.النوع)) {
                سجل_خطأ_مسير(الأخطاء, خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, أ.النوع, ن.النوع));
            };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

