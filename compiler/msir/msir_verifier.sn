عرف تحقق_موضع_تخزين_عنصر_مؤشر_مسير(
    العملية: موضع_تخزين_عنصر_مؤشر_مسير,
    التعليمة: &تعليمة_مسير,
    الموضع: موضع_تعليمة_مسير,
    الدالة: &دالة_مسير,
    الأنواع: &سجل_أنواع,
    الأخطاء: &متغير متجه خطأ_تحقق_مسير
): منطقي {
    دع المؤشر: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, العملية.المؤشر, الموضع.الكتلة, الموضع.الفهرس, الأخطاء
    );
    دع الفهرس: اختيار قيمة_مسير = تحقق_استخدام_قيمة_مسير(
        الدالة, العملية.الفهرس, الموضع.الكتلة, الموضع.الفهرس, الأخطاء
    );
    دع موضع_التخزين: اختيار قيمة_مسير = نتيجة_تعليمة_مسير(التعليمة, الموضع, الأخطاء);
    طابق الفهرس مع
    | اختيار.بعض(قيمة_الفهرس) -> {
        طابق وصف_صحيح_لمسير(الأنواع, قيمة_الفهرس.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.نوع_فهرس_غير_صحيح(الموضع, قيمة_الفهرس.النوع)
            );
        }
        | اختيار.بعض(_) -> { };
    }
    | اختيار.لا_شيء -> { };
    طابق المؤشر مع
    | اختيار.بعض(قيمة_المؤشر) -> {
        طابق نوع_قيمة_عنصر_مؤشر_لمسير(الأنواع, قيمة_المؤشر.النوع) مع
        | اختيار.لا_شيء -> {
            سجل_خطأ_مسير(
                الأخطاء,
                خطأ_تحقق_مسير.فهرسة_غير_صالحة(الموضع, قيمة_المؤشر.النوع)
            );
        }
        | اختيار.بعض(المتوقع) -> {
            طابق موضع_التخزين مع
            | اختيار.بعض(قيمة_الموضع) -> {
                لو (!معرفا_نوع_متساويان(المتوقع, قيمة_الموضع.النوع)) {
                    سجل_خطأ_مسير(
                        الأخطاء,
                        خطأ_تحقق_مسير.نوع_مكان_غير_مطابق(
                            الموضع, المتوقع, قيمة_الموضع.النوع
                        )
                    );
                };
            }
            | اختيار.لا_شيء -> { };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع صواب;
}

