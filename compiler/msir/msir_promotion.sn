استورد compiler.frontend.types.type_model;

// Promotion of scalar local places to SSA values (LLVM's mem2reg, after
// Cytron et al., "Efficiently Computing Static Single Assignment Form and the
// Control Dependence Graph", TOPLAS 1991). Lowering keeps every local that
// lives across control flow in a place (statements.sn
// ثبّت_أماكن_محليات_قبل_تفرع_التحكم), so without this pass every loop counter
// is a load and a store per use in the native backends and the interpreter.
//
// A local place is promoted when its Type is an integer, a float or a bool,
// every use of it is a whole load or store, and its loads, its stored values
// and the place itself have one exact Type (an address taken, a member place,
// a mutated-place call argument or any other use keeps it in storage). Block
// parameters are added at the iterated dominance frontier of the blocks that
// store it, the dominator tree is walked once to replace each load by the
// reaching value, and parameters nothing reads are removed (pruned SSA)
// unless a debug variable is bound to them: that parameter is the local's
// location in its block, so it is kept with the values that feed it. An
// edge where the local holds no value yet (a parameter on a path that never
// stored) passes the Type's zero, as LLVM passes undef. The debug variables
// of a promoted place are bound to the values stored into it and to its
// block parameters, so the backends still describe the local.
//
// A local of any other Type (a reference, a pointer, a record, ...) is
// promoted when it is stored exactly once, before every load of it (earlier in
// the same block, or in a block that dominates the load's): each load becomes
// that value, and it needs neither block parameters nor a zero value, which
// such Types may not have. Lowering keeps every parameter and every `let` in a
// place, so without this a reference parameter is stored and reloaded on
// every use and an aggregate local is copied in and out of its storage.
//
// The pass runs once on lowered MSIR, before the one canonical verification
// (driver/compiler_driver.sn), so the verifier checks its result.


نوع مرشح_ترقية_مسير = {
    المكان: معرف_قيمة_مسير,
    النوع: معرف_نوع,
    // 0 trunc integer signed, 1 unsigned, 2 float, 3 bool; صنف_تخزين_مفرد
    // for a single-store local of any other Type.
    الصنف: طبيعي,
    الاستخدامات: طبيعي,
    صالح: منطقي,
    // Stores, and the block and position of the last one.
    التخزينات: طبيعي,
    كتلة_التخزين: طبيعي,
    موضع_التخزين: طبيعي
};

// The class of a local promoted only through its single store.
عرف صنف_تخزين_مفرد(): طبيعي { أرجع 4; }

// A promotable scalar Type: 0 signed integer, 1 unsigned integer, 2 float,
// 3 bool; لا_شيء otherwise.
عرف صنف_نوع_قابل_للترقية(الأنواع: &سجل_أنواع, النوع: معرف_نوع): اختياري طبيعي {
    طابق أزل_غلاف_متغير(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        طابق وصف_شكل_نوع_دلالي_عند(الأنواع, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الوصف) -> {
            طابق الوصف.الصنف مع
            | صنف_شكل_نوع_دلالي.بدائي(البدائي) -> {
                دع الصنف: صنف_نوع_بدائي = صنف_النوع_البدائي(البدائي);
                إذا (الصنف == صنف_نوع_بدائي.عدد_موقع()) { أرجع اختياري.موجود(0); };
                إذا (الصنف == صنف_نوع_بدائي.عدد_صحيح_طبيعي()) { أرجع اختياري.موجود(1); };
                إذا (الصنف == صنف_نوع_بدائي.عشري()) { أرجع اختياري.موجود(2); };
                إذا (الصنف == صنف_نوع_بدائي.منطقي()) { أرجع اختياري.موجود(3); };
                أرجع اختياري.لا_شيء();
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
    };
}

عرف ثابت_صفر_للترقية(الصنف: طبيعي): ثابت_مسير {
    إذا (الصنف == 0) { أرجع ثابت_مسير.صحيح_موقع(0); };
    إذا (الصنف == 1) { أرجع ثابت_مسير.صحيح_طبيعي(0); };
    إذا (الصنف == 2) {
        دع البايتات: متجه ط8 = [0x30, 0x2E, 0x30];
        أرجع ثابت_مسير.عشري(البايتات);
    };
    أرجع ثابت_مسير.منطق(خطأ);
}

عرف انسخ_منهيا_اختياريا_للترقية(المنهي: &اختياري منهي_مسير): اختياري منهي_مسير {
    طابق *المنهي مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> { أرجع اختياري.موجود(انسخ_مملوكا_منهي_مسير(&م)); };
}

// Every outgoing edge of a terminator in edge order (a multiway branch's
// default first), each copied once. Reading all edges in one pass keeps the
// edge walks linear in the number of edges; one terminator match per edge
// made a multiway branch quadratic.
عام عرف حواف_منهي_للترقية(المنهي: &اختياري منهي_مسير): متجه حافة_مسير {
    دع الحواف: متغير متجه حافة_مسير = [];
    طابق *المنهي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(م) -> {
        طابق م مع
        | منهي_مسير.فرع(الحافة) -> { ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الحافة)); }
        | منهي_مسير.فرع_شرطي(_, الصواب, الخطأ) -> {
            ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الصواب));
            ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الخطأ));
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الافتراضي));
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الحالات[ف].الحافة));
                ف := ف + 1;
            }
        }
        | _ -> { };
    };
    أرجع الحواف;
}

// The terminator with its edges replaced by الحواف (the order and count
// حواف_منهي_للترقية gives).
عام عرف منهي_بحواف_للترقية(المنهي: &اختياري منهي_مسير, الحواف: &متجه حافة_مسير): اختياري منهي_مسير {
    طابق *المنهي مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        طابق م مع
        | منهي_مسير.فرع(_) -> {
            أرجع اختياري.موجود(منهي_مسير.فرع(انسخ_مملوكا_حافة_مسير(&(*الحواف)[0])));
        }
        | منهي_مسير.فرع_شرطي(الشرط, _, _) -> {
            أرجع اختياري.موجود(منهي_مسير.فرع_شرطي(
                الشرط,
                انسخ_مملوكا_حافة_مسير(&(*الحواف)[0]),
                انسخ_مملوكا_حافة_مسير(&(*الحواف)[1])
            ));
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            دع الجديد: متغير فرع_متعدد_مسير = انسخ_مملوكا_فرع_متعدد_مسير(&الفرع);
            الجديد.الافتراضي := انسخ_مملوكا_حافة_مسير(&(*الحواف)[0]);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الجديد.الحالات) مثل طبيعي)) {
                الجديد.الحالات[ف].الحافة := انسخ_مملوكا_حافة_مسير(&(*الحواف)[ف + 1]);
                ف := ف + 1;
            }
            أرجع اختياري.موجود(منهي_مسير.فرع_متعدد(الجديد));
        }
        | _ -> { أرجع انسخ_منهيا_اختياريا_للترقية(المنهي); };
    };
}

// State of one function's promotion.
نوع حالة_ترقية_مسير = {
    // Candidate index + 1 of each place value (0 when not a candidate).
    مرشح_القيمة: متجه طبيعي,
    المرشحون: متجه مرشح_ترقية_مسير,
    // Per block: the promoted candidates whose parameters it gained, in order,
    // and those parameters.
    مرشحو_المعاملات: متجه متجه طبيعي,
    معاملات_مضافة: متجه متجه معرف_قيمة_مسير,
    // The value each promoted candidate holds at the current point of the walk.
    الحالية: متجه معرف_قيمة_مسير,
    // Undo log of the walk: candidate and the value it held before.
    سجل_المرشح: متجه طبيعي,
    سجل_القديم: متجه معرف_قيمة_مسير,
    // Dense replacement map: the value each load becomes.
    الاستبدال: متجه إعادة_ترقيم_قيمة_مسير
};

عرف اربط_متغيرات_مكان_بقيمة(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    المكان: معرف_قيمة_مسير,
    القيمة: معرف_قيمة_مسير
): فراغ {
    دع المتغيرات: متجه معرف_متغير_تصحيح = متغيرات_تصحيح_لقيمة(&(*التصحيح).العقد, المكان);
    إذا ((الطول(المتغيرات) مثل طبيعي) == 0) { أرجع; };
    دع الموقع: اختياري معرف_موقع_تصحيح = موقع_تصحيح_لقيمة(&(*التصحيح).العقد, المكان);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
        اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح).العقد, القيمة, المتغيرات[ف], الموقع);
        ف := ف + 1;
    }
}

// Processes one block's instructions: loads of promoted candidates take the
// current value, stores set it, both disappear with the places; then the
// block's outgoing edges pass the current values to their targets' added
// parameters. Pushes every change on the undo log.
عرف رقّ_كتلة_مسير(
    الدالة: &متغير دالة_مسير,
    الحالة: &متغير حالة_ترقية_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الكتلة: طبيعي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحالة).مرشحو_المعاملات[الكتلة]) مثل طبيعي)) {
        دع المرشح: طبيعي = (*الحالة).مرشحو_المعاملات[الكتلة][ف];
        ألحق((*الحالة).سجل_المرشح, المرشح);
        ألحق((*الحالة).سجل_القديم, (*الحالة).الحالية[المرشح]);
        (*الحالة).الحالية[المرشح] := (*الحالة).معاملات_مضافة[الكتلة][ف];
        ف := ف + 1;
    }
    // Which instructions go; the block is rebuilt only when one does.
    دع المحذوفة: متغير متجه منطقي = [];
    دع أي_محذوف: متغير منطقي = خطأ;
    دع ت: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي;
    طالما (ت < العدد) {
        دع احذف: متغير منطقي = خطأ;
        طابق (*الدالة).الكتل[الكتلة].التعليمات[ت].العملية مع
        | عملية_مسير.مكان_محلي(_) -> {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[الكتلة].التعليمات[ت]) مع
            | اختياري.موجود(الناتج) -> {
                إذا ((الناتج.المعرف.القيمة مثل طبيعي) < (الطول((*الحالة).مرشح_القيمة) مثل طبيعي)) {
                    دع رقم: طبيعي = (*الحالة).مرشح_القيمة[الناتج.المعرف.القيمة];
                    إذا (رقم != 0 && (*الحالة).المرشحون[رقم - 1].صالح) { احذف := صواب; };
                };
            }
            | اختياري.لا_شيء -> { };
        }
        | عملية_مسير.تحميل(التحميل) -> {
            دع رقم: متغير طبيعي = 0;
            إذا ((التحميل.المكان.القيمة مثل طبيعي) < (الطول((*الحالة).مرشح_القيمة) مثل طبيعي)) {
                رقم := (*الحالة).مرشح_القيمة[التحميل.المكان.القيمة];
            };
            إذا (رقم != 0 && (*الحالة).المرشحون[رقم - 1].صالح) {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[الكتلة].التعليمات[ت]) مع
                | اختياري.موجود(الناتج) -> {
                    دع الربط: إعادة_ترقيم_قيمة_مسير = {
                        القديم: الناتج.المعرف, الجديد: (*الحالة).الحالية[رقم - 1]
                    };
                    (*الحالة).الاستبدال[الناتج.المعرف.القيمة] := الربط;
                    احذف := صواب;
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | عملية_مسير.تخزين(التخزين) -> {
            دع رقم: متغير طبيعي = 0;
            إذا ((التخزين.المكان.القيمة مثل طبيعي) < (الطول((*الحالة).مرشح_القيمة) مثل طبيعي)) {
                رقم := (*الحالة).مرشح_القيمة[التخزين.المكان.القيمة];
            };
            إذا (رقم != 0 && (*الحالة).المرشحون[رقم - 1].صالح) {
                ألحق((*الحالة).سجل_المرشح, رقم - 1);
                ألحق((*الحالة).سجل_القديم, (*الحالة).الحالية[رقم - 1]);
                (*الحالة).الحالية[رقم - 1] := التخزين.القيمة;
                اربط_متغيرات_مكان_بقيمة(التصحيح, التخزين.المكان, التخزين.القيمة);
                احذف := صواب;
            };
        }
        | _ -> { };
        ألحق(المحذوفة, احذف);
        إذا (احذف) { أي_محذوف := صواب; };
        ت := ت + 1;
    }
    إذا (أي_محذوف) {
        دع الباقية: متغير متجه تعليمة_مسير = [];
        ت := 0;
        طالما (ت < العدد) {
            إذا (!المحذوفة[ت]) {
                ألحق(الباقية, انسخ_مملوكا_تعليمة_مسير(&(*الدالة).الكتل[الكتلة].التعليمات[ت]));
            };
            ت := ت + 1;
        }
        (*الدالة).الكتل[الكتلة].التعليمات := الباقية;
    };
    // Outgoing edges: an edge into a block that gained parameters passes the
    // current values of their candidates.
    دع الحواف: متغير متجه حافة_مسير = حواف_منهي_للترقية(&(*الدالة).الكتل[الكتلة].المنهي);
    دع تغيرت: متغير منطقي = خطأ;
    دع ح: متغير طبيعي = 0;
    طالما (ح < (الطول(الحواف) مثل طبيعي)) {
        دع الهدف: طبيعي = الحواف[ح].الهدف.القيمة;
        إذا ((الطول((*الحالة).مرشحو_المعاملات[الهدف]) مثل طبيعي) > 0) {
            دع الجديدة: متغير حافة_مسير = انسخ_مملوكا_حافة_مسير(&الحواف[ح]);
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*الحالة).مرشحو_المعاملات[الهدف]) مثل طبيعي)) {
                ألحق(الجديدة.الحجج, (*الحالة).الحالية[(*الحالة).مرشحو_المعاملات[الهدف][م]]);
                م := م + 1;
            }
            الحواف[ح] := الجديدة;
            تغيرت := صواب;
        };
        ح := ح + 1;
    }
    إذا (تغيرت) {
        دع المنهي: اختياري منهي_مسير = منهي_بحواف_للترقية(&(*الدالة).الكتل[الكتلة].المنهي, &الحواف);
        (*الدالة).الكتل[الكتلة].المنهي := المنهي;
    };
}

عرف تراجع_سجل_الترقية(الحالة: &متغير حالة_ترقية_مسير, الطول_المحفوظ: طبيعي): فراغ {
    طالما ((الطول((*الحالة).سجل_المرشح) مثل طبيعي) > الطول_المحفوظ) {
        دع الأخير: طبيعي = (الطول((*الحالة).سجل_المرشح) مثل طبيعي) - 1;
        (*الحالة).الحالية[(*الحالة).سجل_المرشح[الأخير]] := (*الحالة).سجل_القديم[الأخير];
        اقتطع((*الحالة).سجل_المرشح, الأخير);
        اقتطع((*الحالة).سجل_القديم, الأخير);
    }
}

// The final value of a chain of load replacements.
عام عرف حل_استبدال_ترقية(الاستبدال: &متجه إعادة_ترقيم_قيمة_مسير, القيمة: معرف_قيمة_مسير): معرف_قيمة_مسير {
    دع الحالي: متغير معرف_قيمة_مسير = القيمة;
    دع خطوات: متغير طبيعي = 0;
    طالما ((الحالي.القيمة مثل طبيعي) < (الطول(*الاستبدال) مثل طبيعي) && خطوات < (الطول(*الاستبدال) مثل طبيعي)) {
        دع التالي: معرف_قيمة_مسير = (*الاستبدال)[الحالي.القيمة].الجديد;
        إذا (التالي.القيمة == الحالي.القيمة) { أرجع الحالي; };
        الحالي := التالي;
        خطوات := خطوات + 1;
    }
    أرجع الحالي;
}

// Renames the function's values densely (parameters, block parameters,
// instruction results, in order) after deletions, and moves their debug
// bindings with them.
عام عرف أعد_تقنين_دالة_مرقاة(
    الدالة: &متغير دالة_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير
): فراغ {
    دع العدد_القديم: طبيعي = (*الدالة).القيمة_التالية;
    دع المعرف: معرف_دالة_مسير = (*الدالة).المعرف;
    دع الخريطة: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد_القديم) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: معرف_قيمة_مسير_من(المعرف, ف), الجديد: معرف_قيمة_مسير_من(المعرف, ف) };
        ألحق(الخريطة, الربط);
        ف := ف + 1;
    }
    دع محدد: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد_القديم) { ألحق(محدد, خطأ); ف := ف + 1; }
    دع القيم: متغير متجه قيمة_مسير = [];
    دع التالي: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول((*الدالة).المعاملات) مثل طبيعي)) {
        دع القديم: طبيعي = (*الدالة).المعاملات[ف].المعرف.القيمة;
        الخريطة[القديم].الجديد := معرف_قيمة_مسير_من(المعرف, التالي);
        محدد[القديم] := صواب;
        دع الجديدة: قيمة_مسير = { المعرف: معرف_قيمة_مسير_من(المعرف, التالي), النوع: (*الدالة).المعاملات[ف].النوع };
        ألحق(القيم, الجديدة);
        (*الدالة).المعاملات[ف].المعرف := معرف_قيمة_مسير_من(المعرف, التالي);
        التالي := التالي + 1;
        ف := ف + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            دع القديم: طبيعي = (*الدالة).الكتل[ك].المعاملات[ف].المعرف.القيمة;
            الخريطة[القديم].الجديد := معرف_قيمة_مسير_من(المعرف, التالي);
            محدد[القديم] := صواب;
            دع الجديدة: قيمة_مسير = { المعرف: معرف_قيمة_مسير_من(المعرف, التالي), النوع: (*الدالة).الكتل[ك].المعاملات[ف].النوع };
            ألحق(القيم, الجديدة);
            (*الدالة).الكتل[ك].المعاملات[ف].المعرف := معرف_قيمة_مسير_من(المعرف, التالي);
            التالي := التالي + 1;
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ف]) مع
            | اختياري.موجود(الناتج) -> {
                الخريطة[الناتج.المعرف.القيمة].الجديد := معرف_قيمة_مسير_من(المعرف, التالي);
                محدد[الناتج.المعرف.القيمة] := صواب;
                دع الجديدة: قيمة_مسير = { المعرف: معرف_قيمة_مسير_من(المعرف, التالي), النوع: الناتج.النوع };
                ألحق(القيم, الجديدة);
                التالي := التالي + 1;
            }
            | اختياري.لا_شيء -> { };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            (*الدالة).الكتل[ك].التعليمات[ف] := أعد_كتابة_تعليمة_قيم(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ف], &الخريطة);
            ف := ف + 1;
        }
        (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(&(*الدالة).الكتل[ك].المنهي, &الخريطة);
        ك := ك + 1;
    }
    (*الدالة).القيم := القيم;
    (*الدالة).القيمة_التالية := التالي;
    // Debug bindings follow their values; deleted values lose theirs.
    دع فهرس_الدالة: طبيعي = المعرف.القيمة;
    إذا (فهرس_الدالة >= (الطول((*التصحيح).العقد.متغيرات_القيم) مثل طبيعي)) { أرجع; };
    دع المتغيرات_الجديدة: متغير متجه متجه معرف_متغير_تصحيح = [];
    دع المواقع_الجديدة: متغير متجه اختياري معرف_موقع_تصحيح = [];
    ف := 0;
    طالما (ف < التالي) {
        دع فارغة: متجه معرف_متغير_تصحيح = [];
        ألحق(المتغيرات_الجديدة, فارغة);
        ألحق(المواقع_الجديدة, اختياري.لا_شيء());
        ف := ف + 1;
    }
    دع عدد_المتغيرات_القديمة: طبيعي = الطول((*التصحيح).العقد.متغيرات_القيم[فهرس_الدالة]) مثل طبيعي;
    دع عدد_المواقع_القديمة: طبيعي = الطول((*التصحيح).العقد.مواقع_القيم[فهرس_الدالة]) مثل طبيعي;
    ف := 0;
    طالما (ف < العدد_القديم) {
        دع الجديد: طبيعي = الخريطة[ف].الجديد.القيمة;
        // Only values still defined keep their bindings.
        إذا (محدد[ف] && الجديد < التالي) {
            إذا (ف < عدد_المتغيرات_القديمة) {
                دع النسخة: متجه معرف_متغير_تصحيح =
                    انسخ_مملوكا_متجه_معرف_متغير_تصحيح(&(*التصحيح).العقد.متغيرات_القيم[فهرس_الدالة][ف]);
                المتغيرات_الجديدة[الجديد] := النسخة;
            };
            إذا (ف < عدد_المواقع_القديمة) {
                المواقع_الجديدة[الجديد] := (*التصحيح).العقد.مواقع_القيم[فهرس_الدالة][ف];
            };
        };
        ف := ف + 1;
    }
    (*التصحيح).العقد.متغيرات_القيم[فهرس_الدالة] := المتغيرات_الجديدة;
    (*التصحيح).العقد.مواقع_القيم[فهرس_الدالة] := المواقع_الجديدة;
}

عرف رقّ_محليات_دالة_مسير(
    الدالة: &متغير دالة_مسير,
    الأنواع: &سجل_أنواع,
    التصحيح: &متغير بيانات_تصحيح_مسير
): منطقي {
    دع المدخل: طبيعي;
    طابق (*الدالة).المدخل مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(م) -> { المدخل := م.القيمة; };
    دع عدد_القيم: طبيعي = (*الدالة).القيمة_التالية;
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    إذا (المدخل >= عدد_الكتل) { أرجع خطأ; };
    // 1. Candidates.
    دع مرشح_القيمة: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(مرشح_القيمة, 0); ف := ف + 1; }
    دع المرشحون: متغير متجه مرشح_ترقية_مسير = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            إذا ((*الدالة).الكتل[ك].التعليمات[ت].تقييم_وقت_الترجمة) { أرجع خطأ; };
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.مكان_محلي(_) -> {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(الناتج) -> {
                    دع الصنف: متغير طبيعي = صنف_تخزين_مفرد();
                    طابق صنف_نوع_قابل_للترقية(الأنواع, الناتج.النوع) مع
                    | اختياري.موجود(ص) -> { الصنف := ص; }
                    | اختياري.لا_شيء -> { };
                    إذا ((الناتج.المعرف.القيمة مثل طبيعي) < عدد_القيم) {
                        دع المرشح: مرشح_ترقية_مسير = {
                            المكان: الناتج.المعرف, النوع: الناتج.النوع, الصنف: الصنف,
                            الاستخدامات: 0, صالح: صواب,
                            التخزينات: 0, كتلة_التخزين: 0, موضع_التخزين: 0
                        };
                        ألحق(المرشحون, المرشح);
                        مرشح_القيمة[الناتج.المعرف.القيمة] := الطول(المرشحون) مثل طبيعي;
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع عدد_المرشحين: طبيعي = الطول(المرشحون) مثل طبيعي;
    إذا (عدد_المرشحين == 0) { أرجع خطأ; };
    // 2. Every use must be a whole load or store of one exact Type.
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, (*الدالة).القيمة_التالية);
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                إذا ((التحميل.المكان.القيمة مثل طبيعي) < عدد_القيم) {
                    دع رقم: طبيعي = مرشح_القيمة[التحميل.المكان.القيمة];
                    إذا (رقم != 0) {
                        المرشحون[رقم - 1].الاستخدامات := المرشحون[رقم - 1].الاستخدامات + 1;
                        طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                        | اختياري.موجود(الناتج) -> {
                            إذا (!معرفا_نوع_متساويان(الناتج.النوع, المرشحون[رقم - 1].النوع)) {
                                المرشحون[رقم - 1].صالح := خطأ;
                            };
                        }
                        | اختياري.لا_شيء -> { المرشحون[رقم - 1].صالح := خطأ; };
                    };
                };
            }
            | عملية_مسير.تخزين(التخزين) -> {
                إذا ((التخزين.المكان.القيمة مثل طبيعي) < عدد_القيم) {
                    دع رقم: طبيعي = مرشح_القيمة[التخزين.المكان.القيمة];
                    إذا (رقم != 0) {
                        المرشحون[رقم - 1].الاستخدامات := المرشحون[رقم - 1].الاستخدامات + 1;
                        المرشحون[رقم - 1].التخزينات := المرشحون[رقم - 1].التخزينات + 1;
                        المرشحون[رقم - 1].كتلة_التخزين := ك;
                        المرشحون[رقم - 1].موضع_التخزين := ت;
                        إذا ((التخزين.القيمة.القيمة مثل طبيعي) >= عدد_القيم
                            || !معرفا_نوع_متساويان((*الدالة).القيم[التخزين.القيمة.القيمة].النوع, المرشحون[رقم - 1].النوع)) {
                            المرشحون[رقم - 1].صالح := خطأ;
                        };
                    };
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    دع أي_صالح: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < عدد_المرشحين) {
        إذا (المرشحون[ف].الاستخدامات != الاستخدامات[المرشحون[ف].المكان.القيمة]) {
            المرشحون[ف].صالح := خطأ;
        };
        إذا (المرشحون[ف].الصنف == صنف_تخزين_مفرد() && المرشحون[ف].التخزينات != 1) {
            المرشحون[ف].صالح := خطأ;
        };
        إذا (المرشحون[ف].صالح) { أي_صالح := صواب; };
        ف := ف + 1;
    }
    إذا (!أي_صالح) { أرجع خطأ; };
    // 3. The control-flow graph and dominators. The entry block takes no
    // parameters, so a function whose entry has predecessors is left alone.
    دع الأسلاف: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(الأسلاف, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            دع الهدف: طبيعي = الخلفاء[خ].القيمة;
            إذا (الهدف >= عدد_الكتل) { أرجع خطأ; };
            دع موجود: متغير منطقي = خطأ;
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الأسلاف[الهدف]) مثل طبيعي)) {
                إذا (الأسلاف[الهدف][س] == ك) { موجود := صواب; };
                س := س + 1;
            }
            إذا (!موجود) { ألحق(الأسلاف[الهدف], ك); };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    إذا ((الطول(الأسلاف[المدخل]) مثل طبيعي) > 0) { أرجع خطأ; };
    دع الهيمنة: تحليل_هيمنة_مسير = حلل_هيمنة_مسير(الدالة);
    // A single-store local's store must come before every load of it, and
    // every load must be reachable (unreachable blocks have no reaching value).
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                إذا ((التحميل.المكان.القيمة مثل طبيعي) < عدد_القيم && مرشح_القيمة[التحميل.المكان.القيمة] != 0) {
                    دع م: طبيعي = مرشح_القيمة[التحميل.المكان.القيمة] - 1;
                    إذا (المرشحون[م].صالح && المرشحون[م].الصنف == صنف_تخزين_مفرد()) {
                        دع كتلة_التخزين: طبيعي = المرشحون[م].كتلة_التخزين;
                        دع قبلها: منطقي = كتلة_التخزين == ك && المرشحون[م].موضع_التخزين < ت;
                        دع مهيمنة: منطقي = كتلة_التخزين != ك
                            && الهيمنة.قابل_للوصول[ك]
                            && كتلة_تهيمن_على(&الهيمنة, (*الدالة).الكتل[كتلة_التخزين].المعرف, (*الدالة).الكتل[ك].المعرف);
                        إذا (!قبلها && !مهيمنة) { المرشحون[م].صالح := خطأ; };
                    };
                };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    // Immediate dominators as indices (عدد_الكتل for none).
    دع المباشر: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        طابق الهيمنة.المهيمن_المباشر[ك] مع
        | اختياري.موجود(م) -> { ألحق(المباشر, م.القيمة); }
        | اختياري.لا_شيء -> { ألحق(المباشر, عدد_الكتل); };
        ك := ك + 1;
    }
    // Dominance frontiers (Cooper, Harvey & Kennedy).
    دع الحدود: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(الحدود, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (الهيمنة.قابل_للوصول[ك] && (الطول(الأسلاف[ك]) مثل طبيعي) >= 2) {
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الأسلاف[ك]) مثل طبيعي)) {
                دع العداء: متغير طبيعي = الأسلاف[ك][س];
                إذا (الهيمنة.قابل_للوصول[العداء]) {
                    دع خطوات: متغير طبيعي = 0;
                    طالما (العداء != المباشر[ك] && العداء < عدد_الكتل && خطوات <= عدد_الكتل) {
                        دع موجود: متغير منطقي = خطأ;
                        دع ح: متغير طبيعي = 0;
                        طالما (ح < (الطول(الحدود[العداء]) مثل طبيعي)) {
                            إذا (الحدود[العداء][ح] == ك) { موجود := صواب; };
                            ح := ح + 1;
                        }
                        إذا (!موجود) { ألحق(الحدود[العداء], ك); };
                        العداء := المباشر[العداء];
                        خطوات := خطوات + 1;
                    }
                };
                س := س + 1;
            }
        };
        ك := ك + 1;
    }
    // 4. Zero values, at the head of the entry block.
    دع الحالية: متغير متجه معرف_قيمة_مسير = [];
    دع الأصفار: متغير متجه تعليمة_مسير = [];
    دع المعرف: معرف_دالة_مسير = (*الدالة).المعرف;
    ف := 0;
    طالما (ف < عدد_المرشحين) {
        دع قيمة_الصفر: معرف_قيمة_مسير = معرف_قيمة_مسير_من(المعرف, (*الدالة).القيمة_التالية);
        ألحق(الحالية, قيمة_الصفر);
        // A single-store local is read only after its store: no zero.
        إذا (المرشحون[ف].صالح && المرشحون[ف].الصنف != صنف_تخزين_مفرد()) {
            (*الدالة).القيمة_التالية := (*الدالة).القيمة_التالية + 1;
            دع الناتج: قيمة_مسير = { المعرف: قيمة_الصفر, النوع: المرشحون[ف].النوع };
            ألحق((*الدالة).القيم, الناتج);
            دع التعليمة: تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(
                اختياري.موجود(الناتج), عملية_مسير.ثابت(ثابت_صفر_للترقية(المرشحون[ف].الصنف))
            );
            ألحق(الأصفار, التعليمة);
        };
        ف := ف + 1;
    }
    دع عدد_الأصفار: طبيعي = الطول(الأصفار) مثل طبيعي;
    دع تعليمات_المدخل: متغير متجه تعليمة_مسير = الأصفار;
    ف := 0;
    طالما (ف < (الطول((*الدالة).الكتل[المدخل].التعليمات) مثل طبيعي)) {
        ألحق(تعليمات_المدخل, انسخ_مملوكا_تعليمة_مسير(&(*الدالة).الكتل[المدخل].التعليمات[ف]));
        ف := ف + 1;
    }
    (*الدالة).الكتل[المدخل].التعليمات := تعليمات_المدخل;
    // 5. Block parameters at the iterated dominance frontier of the stores.
    دع مرشحو_المعاملات: متغير متجه متجه طبيعي = [];
    دع معاملات_مضافة: متغير متجه متجه معرف_قيمة_مسير = [];
    دع عدد_الأصلية: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع صف1: متجه طبيعي = []; ألحق(مرشحو_المعاملات, صف1);
        دع صف2: متجه معرف_قيمة_مسير = []; ألحق(معاملات_مضافة, صف2);
        ألحق(عدد_الأصلية, الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي);
        ك := ك + 1;
    }
    // Store blocks of each candidate.
    دع كتل_التخزين: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_المرشحين) { دع صف: متجه طبيعي = []; ألحق(كتل_التخزين, صف); ف := ف + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (الهيمنة.قابل_للوصول[ك]) {
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
                طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
                | عملية_مسير.تخزين(التخزين) -> {
                    إذا ((التخزين.المكان.القيمة مثل طبيعي) < عدد_القيم) {
                        دع رقم: طبيعي = مرشح_القيمة[التخزين.المكان.القيمة];
                        إذا (رقم != 0 && المرشحون[رقم - 1].صالح) {
                            دع الصف: طبيعي = رقم - 1;
                            دع الطول_: طبيعي = الطول(كتل_التخزين[الصف]) مثل طبيعي;
                            إذا (الطول_ == 0 || كتل_التخزين[الصف][الطول_ - 1] != ك) {
                                ألحق(كتل_التخزين[الصف], ك);
                            };
                        };
                    };
                }
                | _ -> { };
                ت := ت + 1;
            }
        };
        ك := ك + 1;
    }
    دع علامة_المعامل: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(علامة_المعامل, 0); ك := ك + 1; }
    ف := 0;
    طالما (ف < عدد_المرشحين) {
        إذا (المرشحون[ف].صالح && المرشحون[ف].الصنف != صنف_تخزين_مفرد()) {
            دع العمل: متغير متجه طبيعي = انسخ_مملوكا_متجه_طبيعي_ترقية(&كتل_التخزين[ف]);
            طالما ((الطول(العمل) مثل طبيعي) > 0) {
                دع الأخير: طبيعي = (الطول(العمل) مثل طبيعي) - 1;
                دع الكتلة: طبيعي = العمل[الأخير];
                اقتطع(العمل, الأخير);
                دع ح: متغير طبيعي = 0;
                طالما (ح < (الطول(الحدود[الكتلة]) مثل طبيعي)) {
                    دع الحد: طبيعي = الحدود[الكتلة][ح];
                    // علامة_المعامل holds ف + 1 for a block that already has
                    // this candidate's parameter.
                    إذا (علامة_المعامل[الحد] != ف + 1 && الحد != المدخل) {
                        علامة_المعامل[الحد] := ف + 1;
                        دع المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(المعرف, (*الدالة).القيمة_التالية);
                        (*الدالة).القيمة_التالية := (*الدالة).القيمة_التالية + 1;
                        دع القيمة: قيمة_مسير = { المعرف: المعامل, النوع: المرشحون[ف].النوع };
                        ألحق((*الدالة).القيم, القيمة);
                        ألحق((*الدالة).الكتل[الحد].المعاملات, القيمة);
                        ألحق(مرشحو_المعاملات[الحد], ف);
                        ألحق(معاملات_مضافة[الحد], المعامل);
                        اربط_متغيرات_مكان_بقيمة(التصحيح, المرشحون[ف].المكان, المعامل);
                        ألحق(العمل, الحد);
                    };
                    ح := ح + 1;
                }
            }
        };
        ف := ف + 1;
    }
    // 6. Rename along the dominator tree (an explicit stack: enter, then exit).
    دع الاستبدال: متغير متجه إعادة_ترقيم_قيمة_مسير = [];
    ف := 0;
    طالما (ف < (*الدالة).القيمة_التالية) {
        دع الربط: إعادة_ترقيم_قيمة_مسير = { القديم: معرف_قيمة_مسير_من(المعرف, ف), الجديد: معرف_قيمة_مسير_من(المعرف, ف) };
        ألحق(الاستبدال, الربط);
        ف := ف + 1;
    }
    دع سجل_مرشح_فارغ: متجه طبيعي = [];
    دع سجل_قديم_فارغ: متجه معرف_قيمة_مسير = [];
    دع الحالة: متغير حالة_ترقية_مسير = {
        مرشح_القيمة: مرشح_القيمة,
        المرشحون: المرشحون,
        مرشحو_المعاملات: مرشحو_المعاملات,
        معاملات_مضافة: معاملات_مضافة,
        الحالية: الحالية,
        سجل_المرشح: سجل_مرشح_فارغ,
        سجل_القديم: سجل_قديم_فارغ,
        الاستبدال: الاستبدال
    };
    دع الأبناء: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(الأبناء, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (المباشر[ك] < عدد_الكتل && الهيمنة.قابل_للوصول[ك]) { ألحق(الأبناء[المباشر[ك]], ك); };
        ك := ك + 1;
    }
    // Stack entries: block * 2 (enter) or block * 2 + 1 (exit).
    دع المكدس: متغير متجه طبيعي = [المدخل * 2];
    دع المحفوظ: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(المحفوظ, 0); ك := ك + 1; }
    طالما ((الطول(المكدس) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(المكدس) مثل طبيعي) - 1;
        دع البند: طبيعي = المكدس[الأخير];
        اقتطع(المكدس, الأخير);
        دع الكتلة: طبيعي = البند / 2;
        إذا ((البند % 2) == 1) {
            تراجع_سجل_الترقية(&متغير الحالة, المحفوظ[الكتلة]);
        } وإلا {
            المحفوظ[الكتلة] := الطول(الحالة.سجل_المرشح) مثل طبيعي;
            رقّ_كتلة_مسير(الدالة, &متغير الحالة, التصحيح, الكتلة);
            ألحق(المكدس, (الكتلة * 2) + 1);
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(الأبناء[الكتلة]) مثل طبيعي)) {
                ألحق(المكدس, الأبناء[الكتلة][ب] * 2);
                ب := ب + 1;
            }
        };
    }
    // Unreachable blocks see every promoted candidate as its zero value.
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (!الهيمنة.قابل_للوصول[ك]) {
            دع المحفوظ_هنا: طبيعي = الطول(الحالة.سجل_المرشح) مثل طبيعي;
            رقّ_كتلة_مسير(الدالة, &متغير الحالة, التصحيح, ك);
            تراجع_سجل_الترقية(&متغير الحالة, المحفوظ_هنا);
        };
        ك := ك + 1;
    }
    // 7. Resolve chains of replaced loads, then rewrite every operand.
    ف := 0;
    طالما (ف < (الطول(الحالة.الاستبدال) مثل طبيعي)) {
        دع النهائي: معرف_قيمة_مسير = حل_استبدال_ترقية(&الحالة.الاستبدال, الحالة.الاستبدال[ف].القديم);
        الحالة.الاستبدال[ف].الجديد := النهائي;
        ف := ف + 1;
    }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            (*الدالة).الكتل[ك].التعليمات[ت] := أعد_كتابة_تعليمة_قيم(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت], &الحالة.الاستبدال);
            ت := ت + 1;
        }
        (*الدالة).الكتل[ك].المنهي := أعد_كتابة_منهي_اختياري_قيم(&(*الدالة).الكتل[ك].المنهي, &الحالة.الاستبدال);
        ك := ك + 1;
    }
    // 8. Prune the added parameters nothing reads. A parameter is live when an
    // instruction or a terminator operand uses it, or when it is passed on an
    // edge to a live parameter.
    احذف_معاملات_مرقاة_ميتة(الدالة, &متغير الحالة, &الأسلاف, &عدد_الأصلية, التصحيح);
    // 9. Zero values nothing reads.
    دع استخدامات_نهائية: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, (*الدالة).القيمة_التالية);
    دع الباقية: متغير متجه تعليمة_مسير = [];
    ف := 0;
    طالما (ف < (الطول((*الدالة).الكتل[المدخل].التعليمات) مثل طبيعي)) {
        دع احذف: متغير منطقي = خطأ;
        إذا (ف < عدد_الأصفار) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[المدخل].التعليمات[ف]) مع
            | اختياري.موجود(الناتج) -> {
                إذا ((الناتج.المعرف.القيمة مثل طبيعي) < (الطول(استخدامات_نهائية) مثل طبيعي)
                    && استخدامات_نهائية[الناتج.المعرف.القيمة] == 0) { احذف := صواب; };
            }
            | اختياري.لا_شيء -> { };
        };
        إذا (!احذف) { ألحق(الباقية, انسخ_مملوكا_تعليمة_مسير(&(*الدالة).الكتل[المدخل].التعليمات[ف])); };
        ف := ف + 1;
    }
    (*الدالة).الكتل[المدخل].التعليمات := الباقية;
    // 10. Dense identities again.
    أعد_تقنين_دالة_مرقاة(الدالة, التصحيح);
    أرجع صواب;
}

عرف احذف_معاملات_مرقاة_ميتة(
    الدالة: &متغير دالة_مسير,
    الحالة: &متغير حالة_ترقية_مسير,
    الأسلاف: &متجه متجه طبيعي,
    عدد_الأصلية: &متجه طبيعي,
    التصحيح: &متغير بيانات_تصحيح_مسير
): فراغ {
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع عدد_القيم: طبيعي = (*الدالة).القيمة_التالية;
    // Where each added parameter lives: block + 1 (0 for other values), position.
    دع كتلة_المعامل: متغير متجه طبيعي = [];
    دع موضع_المعامل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_القيم) { ألحق(كتلة_المعامل, 0); ألحق(موضع_المعامل, 0); ف := ف + 1; }
    دع أي_مضاف: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) {
        ف := 0;
        طالما (ف < (الطول((*الحالة).معاملات_مضافة[ك]) مثل طبيعي)) {
            دع القيمة: طبيعي = (*الحالة).معاملات_مضافة[ك][ف].القيمة;
            كتلة_المعامل[القيمة] := ك + 1;
            موضع_المعامل[القيمة] := (*عدد_الأصلية)[ك] + ف;
            أي_مضاف := صواب;
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    إذا (!أي_مضاف) { أرجع; };
    // Uses that are not edge arguments make a parameter live.
    دع الكل: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, (*الدالة).القيمة_التالية);
    // Every edge once: the flat list, where each block's edges start, and
    // each block's incoming edges.
    دع الحواف_كلها: متغير متجه حافة_مسير = [];
    دع بداية_الحواف: متغير متجه طبيعي = [];
    دع الواردة: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { دع صف: متجه طبيعي = []; ألحق(الواردة, صف); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        ألحق(بداية_الحواف, الطول(الحواف_كلها) مثل طبيعي);
        دع حواف_الكتلة: متجه حافة_مسير = حواف_منهي_للترقية(&(*الدالة).الكتل[ك].المنهي);
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(حواف_الكتلة) مثل طبيعي)) {
            ألحق(الواردة[حواف_الكتلة[ح].الهدف.القيمة], الطول(الحواف_كلها) مثل طبيعي);
            ألحق(الحواف_كلها, انسخ_مملوكا_حافة_مسير(&حواف_الكتلة[ح]));
            ح := ح + 1;
        }
        ك := ك + 1;
    }
    ألحق(بداية_الحواف, الطول(الحواف_كلها) مثل طبيعي);
    دع على_الحواف: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_القيم) { ألحق(على_الحواف, 0); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(الحواف_كلها) مثل طبيعي)) {
        // Only arguments of added parameters can be dead; an argument of
        // a parameter lowering made is a real use.
        دع ج: متغير طبيعي = (*عدد_الأصلية)[الحواف_كلها[ف].الهدف.القيمة];
        طالما (ج < (الطول(الحواف_كلها[ف].الحجج) مثل طبيعي)) {
            دع القيمة: طبيعي = الحواف_كلها[ف].الحجج[ج].القيمة;
            إذا (القيمة < عدد_القيم) { على_الحواف[القيمة] := على_الحواف[القيمة] + 1; };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    دع حي: متغير متجه منطقي = [];
    دع العمل: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < عدد_القيم) {
        دع مضاف: منطقي = كتلة_المعامل[ف] != 0;
        // A parameter bound to a debug variable is the variable's location
        // from its block on: pruning it would leave the local without one
        // while it is in scope. It stays, with the edge values that feed it
        // (the worklist below), as LLVM keeps every local at -O0.
        دع له_ربط_تصحيح: منطقي = مضاف
            && (الطول(متغيرات_تصحيح_لقيمة(&(*التصحيح).العقد, معرف_قيمة_مسير_من((*الدالة).المعرف, ف))) مثل طبيعي) > 0;
        دع حي_مباشرة: منطقي = مضاف && (الكل[ف] > على_الحواف[ف] || له_ربط_تصحيح);
        ألحق(حي, حي_مباشرة);
        إذا (حي_مباشرة) { ألحق(العمل, ف); };
        ف := ف + 1;
    }
    طالما ((الطول(العمل) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(العمل) مثل طبيعي) - 1;
        دع المعامل: طبيعي = العمل[الأخير];
        اقتطع(العمل, الأخير);
        دع الكتلة: طبيعي = كتلة_المعامل[المعامل] - 1;
        دع الموضع: طبيعي = موضع_المعامل[المعامل];
        دع س: متغير طبيعي = 0;
        طالما (س < (الطول(الواردة[الكتلة]) مثل طبيعي)) {
            دع الفهرس: طبيعي = الواردة[الكتلة][س];
            إذا (الموضع < (الطول(الحواف_كلها[الفهرس].الحجج) مثل طبيعي)) {
                دع الحجة: طبيعي = الحواف_كلها[الفهرس].الحجج[الموضع].القيمة;
                إذا (الحجة < عدد_القيم && كتلة_المعامل[الحجة] != 0 && !حي[الحجة]) {
                    حي[الحجة] := صواب;
                    ألحق(العمل, الحجة);
                };
            };
            س := س + 1;
        }
    }
    // Remove dead added parameters and their edge arguments.
    دع أبق: متغير متجه متجه منطقي = [];
    دع أي_ميت: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع صف: متغير متجه منطقي = [];
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            دع القيمة: طبيعي = (*الدالة).الكتل[ك].المعاملات[ف].المعرف.القيمة;
            دع ابق_هذا: منطقي = القيمة >= عدد_القيم || كتلة_المعامل[القيمة] == 0 || حي[القيمة];
            إذا (!ابق_هذا) { أي_ميت := صواب; };
            ألحق(صف, ابق_هذا);
            ف := ف + 1;
        }
        ألحق(أبق, صف);
        ك := ك + 1;
    }
    إذا (!أي_ميت) { أرجع; };
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع الحواف: متغير متجه حافة_مسير = [];
        دع تغيرت: متغير منطقي = خطأ;
        دع ح: متغير طبيعي = بداية_الحواف[ك];
        طالما (ح < بداية_الحواف[ك + 1]) {
            دع الهدف: طبيعي = الحواف_كلها[ح].الهدف.القيمة;
            دع حجج_فارغة: متجه معرف_قيمة_مسير = [];
            دع الجديدة: متغير حافة_مسير = { الهدف: الحواف_كلها[ح].الهدف, الحجج: حجج_فارغة };
            دع ج: متغير طبيعي = 0;
            طالما (ج < (الطول(الحواف_كلها[ح].الحجج) مثل طبيعي)) {
                إذا (ج >= (الطول(أبق[الهدف]) مثل طبيعي) || أبق[الهدف][ج]) {
                    ألحق(الجديدة.الحجج, الحواف_كلها[ح].الحجج[ج]);
                } وإلا {
                    تغيرت := صواب;
                };
                ج := ج + 1;
            }
            ألحق(الحواف, الجديدة);
            ح := ح + 1;
        }
        إذا (تغيرت) {
            دع المنهي: اختياري منهي_مسير = منهي_بحواف_للترقية(&(*الدالة).الكتل[ك].المنهي, &الحواف);
            (*الدالة).الكتل[ك].المنهي := المنهي;
        };
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع المعاملات: متغير متجه قيمة_مسير = [];
        ف := 0;
        طالما (ف < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
            إذا (أبق[ك][ف]) { ألحق(المعاملات, (*الدالة).الكتل[ك].المعاملات[ف]); };
            ف := ف + 1;
        }
        (*الدالة).الكتل[ك].المعاملات := المعاملات;
        ك := ك + 1;
    }
}

عرف انسخ_مملوكا_متجه_طبيعي_ترقية(القيمة: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) { ألحق(الناتج, (*القيمة)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// Promotes the scalar local places of every function المحسنة marks (by
// position; see the header). Returns, by position, the functions it changed.
عام عرف رقّ_محليات_برنامج_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    المحسنة: &متجه منطقي
): متجه منطقي {
    دع المرقاة: متغير متجه منطقي = [];
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع رقيت: متغير منطقي = خطأ;
        إذا (د < (الطول(*المحسنة) مثل طبيعي) && (*المحسنة)[د]) {
            رقيت := رقّ_محليات_دالة_مسير(&متغير (*البرنامج).الدوال[د], الأنواع, التصحيح);
        };
        ألحق(المرقاة, رقيت);
        د := د + 1;
    }
    أرجع المرقاة;
}
