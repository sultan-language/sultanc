// Generic functions remain semantic templates until MSIR requests concrete instances.
عرف قيمة_ثابت_تصحيح_من_ثابت_مسير(الثابت: &ثابت_مسير): اختيار قيمة_ثابت_تصحيح {
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> { أرجع اختيار.بعض(قيمة_ثابت_تصحيح.منطق(القيمة)); }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع اختيار.بعض(قيمة_ثابت_تصحيح.صحيح_موقع(القيمة)); }
    | ثابت_مسير.صحيح_غير_موقع(القيمة) -> { أرجع اختيار.بعض(قيمة_ثابت_تصحيح.صحيح_غير_موقع(القيمة)); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف أعلن_مثيلات_دوال_عامة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الطلبات: &متجه طلب_مثيل_دالة_خفض,
    دوال_الخفض: &متغير سياق_دوال_خفض
): اختيار خطأ_خفض_مسير {
    دع ط: متغير غير_موقع = 0;
    بينما (ط < (الطول(*الطلبات) مثل غير_موقع)) {
        دع مرجع_الطلب: &طلب_مثيل_دالة_خفض = &(*الطلبات)[ط];
        دع رمز_الطلب: معرف_رمز = (*مرجع_الطلب).الرمز;
        طابق مقبض_تصريح_عند(فهرس_التصريحات, رمز_الطلب) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المقبض) -> {
            لو (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل غير_موقع)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل غير_موقع)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                لو (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
                    دع معرف_المصدر: غير_موقع = (*مرجع_الوحدة).معرف_المصدر;
                    دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
                    دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[المقبض.موضع_الوحدة];
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        لو (الطول(الدالة.معاملات_النوع) > 0) {
                            طابق أعلن_دالة_للخفض(
                                البرنامج, التصحيح, الأصول, مرجع_المصدر, &الدالة,
                                الأنواع, أنواع_الرموز, روابط_الوحدة,
                                &(*مرجع_الطلب).استبدالات_النوع, دوال_الخفض
                            ) مع
                            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                            | اختيار.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ط := ط + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اخفض_مثيلات_دوال_عامة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    الطلبات: &متجه طلب_مثيل_دالة_خفض
): اختيار خطأ_خفض_مسير {
    دع ط: متغير غير_موقع = 0;
    بينما (ط < (الطول(*الطلبات) مثل غير_موقع)) {
        دع مرجع_الطلب: &طلب_مثيل_دالة_خفض = &(*الطلبات)[ط];
        دع رمز_الطلب: معرف_رمز = (*مرجع_الطلب).الرمز;
        طابق مقبض_تصريح_عند(فهرس_التصريحات, رمز_الطلب) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المقبض) -> {
            لو (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل غير_موقع)
                && المقبض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل غير_موقع)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل غير_موقع)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                لو (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
                    دع معرف_المصدر: غير_موقع = (*مرجع_الوحدة).معرف_المصدر;
                    دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
                    دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[المقبض.موضع_الوحدة];
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        لو (الطول(الدالة.معاملات_النوع) > 0) {
                            دع أنواع_رموز_المثيل: سياق_أنواع_رموز = خصص_أنواع_رموز_للمثيل(
                                الأنواع, أنواع_الرموز, &(*مرجع_الطلب).استبدالات_النوع
                            );
                            دع أنواع_تعبيرات_المثيل: سياق_أنواع_تعبيرات = خصص_أنواع_تعبيرات_للمثيل(
                                الأنواع, &(*أنواع_التعبيرات)[المقبض.موضع_الوحدة],
                                &(*مرجع_الطلب).استبدالات_النوع
                            );
                            دع تحققات_المثيل: متجه ربط_تحقق_نمط_وحدة = خصص_تحققات_أنماط_للمثيل(
                                الأنواع, تحققات_الأنماط, &(*مرجع_الطلب).استبدالات_النوع
                            );
                            طابق اخفض_جسم_دالة_إلى_مسير(
                                البرنامج, التصحيح, الأصول, مرجع_المصدر, &الدالة, الأنواع,
                                &أنواع_رموز_المثيل, &أنواع_تعبيرات_المثيل, روابط_الوحدة,
                                &(*مرجع_الطلب).استبدالات_النوع, سجل_الأنماط,
                                &تحققات_المثيل, دوال_الخفض, هويات_البدائيات
                            ) مع
                            | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                            | اختيار.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ط := ط + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Runtime globals currently serialize scalar bool/integer initializers. Immutable top-level
// constants may carry any constant kind supported by compile-time evaluation.
عرف هل_ثابت_تهيئة_عام_مدعوم_للخفض(الثابت: &ثابت_مسير): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.منطق(_) -> { أرجع صواب; }
    | ثابت_مسير.صحيح_موقع(_) -> { أرجع صواب; }
    | ثابت_مسير.صحيح_غير_موقع(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر: &مصدر, الاسم: &اسم): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = (*الاسم).النطاق.البداية.البايت;
    بينما (ف < (*الاسم).النطاق.النهاية.البايت && ف < (*المصدر).الطول) {
        ألحق(الناتج, (*المصدر).المحتوى[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Preserve source spelling for named Types before Frontend Name state is released.
// This is debug metadata only: Type remains the semantic owner and Target/Layout
// remains the physical representation owner.
عرف سجل_تصحيح_تصريح_نوع_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    التصريح: &تصريح_نوع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الروابط: &سياق_روابط_أسماء
): فراغ {
    دع الرمز: معرف_رمز;
    طابق رمز_اسم_محلول_عند(الروابط, (*التصريح).الاسم.النطاق) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(المعرف) -> { الرمز := المعرف; };
    دع النوع: معرف_نوع;
    طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(المعرف) -> { النوع := المعرف; };
    دع الاسم: متجه غ8 = انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &(*التصريح).الاسم);
    دع أصل_التصريح: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, (*التصريح).النطاق);
    دع أصل_اختياري: اختيار معرف_أصل_مصدر = اختيار.بعض(أصل_التصريح);
    دع الأعضاء: متغير متجه متجه غ8 = [];
    دع البدائل: متغير متجه متجه غ8 = [];
    دع أسماء_معاملات_النوع: متغير متجه متجه غ8 = [];
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول((*التصريح).معاملات_النوع) مثل غير_موقع)) {
        ألحق(أسماء_معاملات_النوع, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &(*التصريح).معاملات_النوع[م]));
        م := م + 1;
    }
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.سجل(الحقول) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الحقول) مثل غير_موقع)) {
            ألحق(الأعضاء, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &الحقول[ف].الاسم));
            ف := ف + 1;
        }
    }
    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المنشئات) مثل غير_موقع)) {
            ألحق(البدائل, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &المنشئات[ف].الاسم));
            ف := ف + 1;
        }
    }
    | شكل_تصريح_نوع.مرادف(_) -> {
        // Alias spelling is a distinct DebugTypeID that references the canonical target TypeID.
        سجل_اسم_مستعار_تصحيح_مسير(التصحيح, النوع, &الاسم, أصل_اختياري);
        أرجع;
    };
    سجل_تصحيح_نوع_مسير(
        التصحيح, النوع, الرمز, &الاسم, &الأعضاء, &البدائل,
        &أسماء_معاملات_النوع, أصل_اختياري
    );
}

// Whole-unit assembly is private to the canonical semantic lowering boundary.
عرف اخفض_وحدات_دلالية_إلى_مسير(
    الوحدات: &متجه وحدة_مصدر,
    الوحدات_الدلالية: &متجه وحدة_دلالية,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    رمز_بدء_البرنامج: اختيار معرف_رمز
): نتيجة_خفض_مسير {
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع التصحيح: متغير بيانات_تصحيح_مسير = بيانات_تصحيح_مسير_جديدة();
    دع الأصول: متغير سجل_أصول_مصدر = سجل_أصول_مصدر_جديد();
    دع دوال_الخفض: متغير سياق_دوال_خفض = سياق_دوال_خفض_جديد();
    دع بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    سجل_وحدات_تصحيح_مسير(&متغير التصحيح, الوحدات_الدلالية, خريطة_المصادر);
    دع طلبات_المثيلات: متجه طلب_مثيل_دالة_خفض = ابن_طلبات_مثيلات_دوال(
        الوحدات, فهرس_التصريحات, الأنواع, أنواع_التعبيرات
    );

    // Declare every semantic function before lowering any body. Cross-module calls therefore
    // consume the same canonical Symbol -> FunctionID map and are independent of module order.
    دع و: متغير غير_موقع = 0;
    بينما (و < (الطول(*الوحدات) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع معرف_المصدر: غير_موقع = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                لو (الطول(الدالة.معاملات_النوع) == 0) {
                    طابق أعلن_دالة_للخفض(
                        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &الدالة, الأنواع, أنواع_الرموز,
                        روابط_الوحدة, &بلا_استبدالات, &متغير دوال_الخفض
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                دع الرمز: معرف_رمز;
                طابق رمز_اسم_محلول_عند(روابط_الوحدة, التصريح.الاسم.النطاق) مع
                | اختيار.بعض(المعرف) -> { الرمز := المعرف; }
                | اختيار.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.ربط_اسم_مفقود(التصريح.الاسم.النطاق)); };
                دع النوع_الدلالي: معرف_نوع;
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                | اختيار.بعض(المعرف) -> { النوع_الدلالي := المعرف; }
                | اختيار.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
                دع نوع_القيمة: معرف_نوع;
                طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
                | اختيار.بعض(المعرف) -> { نوع_القيمة := المعرف; }
                | اختيار.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
                دع الثابت: ثابت_مسير;
                طابق قيم_تعبير_ثابت_للخفض(
                    &التصريح.التهيئة, الأنواع, أنواع_تعبيرات_الوحدة, روابط_الوحدة, &دوال_الخفض
                ) مع
                | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { الثابت := القيمة; }
                | _ -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(التصريح.النطاق)); };
                دع قابل_للكتابة: منطقي = هل_غلاف_نوع_متغير(الأنواع, النوع_الدلالي);
                دع الهدف: هدف_قيمة_عليا_خفض;
                دع اسم_القيمة_العليا: متجه غ8 = انسخ_تهجئة_اسم_تصحيح_نوع_مسير(مرجع_المصدر, &التصريح.الاسم);
                لو (قابل_للكتابة) {
                    لو (!هل_ثابت_تهيئة_عام_مدعوم_للخفض(&الثابت)) {
                        أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(التصريح.النطاق));
                    };
                    دع العام: معرف_عام_مسير = أضف_عاما_مسير(&متغير البرنامج, نوع_القيمة, الثابت, صواب);
                    الهدف := هدف_قيمة_عليا_خفض.عام(العام);
                    سجل_عام_تصحيح_مسير(
                        &متغير التصحيح, &متغير الأصول, العام, الرمز, النوع_الدلالي,
                        &اسم_القيمة_العليا, التصريح.النطاق, التصريح.علني
                    );
                } وإلا {
                    دع قيمة_التصحيح: اختيار قيمة_ثابت_تصحيح = قيمة_ثابت_تصحيح_من_ثابت_مسير(&الثابت);
                    الهدف := هدف_قيمة_عليا_خفض.ثابت(الثابت);
                    سجل_ثابت_تصحيح_مسير(
                        &متغير التصحيح, &متغير الأصول, الرمز, النوع_الدلالي,
                        &اسم_القيمة_العليا, التصريح.النطاق, قيمة_التصحيح, التصريح.علني
                    );
                };
                دع الربط: ربط_قيمة_عليا_خفض = {
                    الرمز: الرمز, النوع: نوع_القيمة, قابل_للكتابة: قابل_للكتابة, الهدف: الهدف
                };
                لو (!أضف_قيمة_عليا_خفض(&متغير دوال_الخفض, الربط)) {
                    أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(الرمز));
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                سجل_تصحيح_تصريح_نوع_مسير(
                    &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &التصريح, أنواع_الرموز, روابط_الوحدة
                );
            }
            | عنصر_وحدة.تجميع(_, _) -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }

    طابق أعلن_مثيلات_دوال_عامة_للخفض(
        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, الوحدات, فهرس_التصريحات,
        خريطة_المصادر, الأنواع, أنواع_الرموز, روابط_الأسماء,
        &طلبات_المثيلات, &متغير دوال_الخفض
    ) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
    | اختيار.لا_شيء -> { };

    طابق رمز_بدء_البرنامج مع
    | اختيار.بعض(رمز_البدء) -> {
        طابق دالة_خفض_عند(&دوال_الخفض, رمز_البدء) مع
        | اختيار.بعض(ربط_البدء) -> {
            طابق ربط_البدء.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_البدء) -> {
                طابق عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, معرف_البدء) مع
                | اختيار.بعض(_) -> {
                    أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
                }
                | اختيار.لا_شيء -> { };
            }
            | هدف_دالة_خفض.خارجية(_) -> {
                أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
            };
        }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
        };
    }
    | اختيار.لا_شيء -> { };

    و := 0;
    بينما (و < (الطول(*الوحدات) مثل غير_موقع)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع معرف_المصدر: غير_موقع = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل غير_موقع)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                لو (الطول(الدالة.معاملات_النوع) == 0) {
                    طابق اخفض_جسم_دالة_إلى_مسير(
                        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &الدالة, الأنواع, أنواع_الرموز, أنواع_تعبيرات_الوحدة,
                        روابط_الوحدة, &بلا_استبدالات, سجل_الأنماط, تحققات_الأنماط,
                        &دوال_الخفض, هويات_البدائيات
                    ) مع
                    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }

    طابق اخفض_مثيلات_دوال_عامة_إلى_مسير(
        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, الوحدات, فهرس_التصريحات,
        خريطة_المصادر, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
        روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, &دوال_الخفض,
        هويات_البدائيات, &طلبات_المثيلات
    ) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
    | اختيار.لا_شيء -> { };

    // Builder/lowering own construction invariants. Production lowering must not
    // rescan the complete MSIR program with dominance/definition verification.
    أرجع نتيجة_خفض_مسير.ناجح(البرنامج, التصحيح, الأصول);
}

// Canonical owned payload transferred from Frontend lowering to Driver consumers.
// MSIR owns this shape so Driver composes the lifecycle without duplicating the handoff.
عام نوع حمولة_مسير_مخفضة = {
    المسير: برنامج_مسير,
    الأنواع: سجل_أنواع,
    المصادر: خريطة_مصادر,
    الأصول: سجل_أصول_مصدر,
    التصحيح: بيانات_تصحيح_مسير
};

// الحد العام الوحيد من Frontend المقنن إلى MSIR المتحقق.
// The public MSIR boundary exposes canonical diagnostics, never MSIR-internal failures.
عام نوع نتيجة_خفض_واجهة_مسير =
    | ناجح بنوع حمولة_مسير_مخفضة
    | مرفوض بنوع مجموعة_تشخيصات
;

// Public Frontend -> MSIR handoff. Driver passes the canonical whole-unit semantic result
// without unpacking owner-specific contexts. MSIR consumes the semantic facts internally.
عام عرف اخفض_واجهة_وحدة_إلى_مسير(
    الواجهة: متغير نتيجة_واجهة_وحدة
): نتيجة_خفض_واجهة_مسير {
    // Lower directly from the owned Frontend result. The previous boundary copied
    // every large semantic field into a second aggregate before lowering, keeping
    // both copies alive at once. Borrow the canonical fields in place instead.
    طابق اخفض_وحدات_دلالية_إلى_مسير(
        &الواجهة.الوحدات,
        &الواجهة.الوحدات_الدلالية,
        &الواجهة.فهرس_التصريحات,
        &الواجهة.خريطة_المصادر,
        &متغير الواجهة.سياقات_الأنواع.الأنواع,
        &الواجهة.سياقات_الأنواع.أنواع_الرموز,
        &الواجهة.سياقات_الأنواع.أنواع_التعبيرات,
        &الواجهة.روابط_الأسماء,
        &الواجهة.سياق_الأنماط.الأنماط,
        &الواجهة.سياق_الأنماط.التحققات,
        &الواجهة.هويات_البدائيات,
        الواجهة.رمز_بدء_البرنامج
    ) مع
    | نتيجة_خفض_مسير.ناجح(البرنامج, التصحيح, الأصول) -> {
        // Lowering is the final consumer of AST/Name/Pattern/Memory/SSF state.
        // Move the two surviving canonical owners out of the Frontend payload
        // exactly once; all other Frontend-only fields end at this boundary.
        طابق الواجهة مع
        | {
            الوحدات: _,
            الوحدات_الدلالية: _,
            خريطة_المصادر: خريطة_الناتج,
            هويات_البدائيات: _,
            روابط_الأسماء: _,
            فهرس_التصريحات: _,
            استعلامات_الأسماء: _,
            رمز_بدء_البرنامج: _,
            سياقات_الأنواع: سياقات_الأنواع_الناتج,
            سياق_الأنماط: _,
            كاملة_دلاليا: _,
            تشخيصات_الأدوات: _
        } -> {
            طابق سياقات_الأنواع_الناتج مع
            | {
                الأنواع: أنواع_الناتج,
                أنواع_التعبيرات: _,
                أنواع_الرموز: _,
                علاقات_هرم_الأنواع: _
            } -> {
                دع الحمولة: حمولة_مسير_مخفضة = {
                    المسير: البرنامج,
                    الأنواع: أنواع_الناتج,
                    المصادر: خريطة_الناتج,
                    الأصول: الأصول,
                    التصحيح: التصحيح
                };
                أرجع نتيجة_خفض_واجهة_مسير.ناجح(الحمولة);
            };
        };
    }
    | نتيجة_خفض_مسير.مرفوض(الخطأ) -> {
        أرجع نتيجة_خفض_واجهة_مسير.مرفوض(حول_فشل_خفض_إلى_تشخيصات(الخطأ));
    };
}

// Driver-facing observation of the lowering result. Driver owns sequencing and
// presentation only; it does not import or inspect the MSIR program payload.
عام عرف خفض_واجهة_مسير_ناجح(النتيجة: &نتيجة_خفض_واجهة_مسير): منطقي {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(_) -> {
        أرجع صواب;
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(_) -> {
        أرجع خطأ;
    };
}

// Driver-facing entry identity query. The private Symbol→FunctionID lowering map never escapes MSIR.
عام عرف معرف_دالة_بدء_خفض_واجهة_مسير(
    النتيجة: &نتيجة_خفض_واجهة_مسير
): اختيار معرف_دالة_مسير {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(الحمولة) -> {
        أرجع معرف_دالة_بدء_برنامج_مسير(&الحمولة.المسير);
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(_) -> {
        أرجع اختيار.لا_شيء();
    };
}

عام عرف تشخيصات_خفض_واجهة_مسير(
    النتيجة: &نتيجة_خفض_واجهة_مسير
): اختيار مجموعة_تشخيصات {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(_) -> {
        أرجع اختيار.لا_شيء();
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات) -> {
        أرجع اختيار.بعض(التشخيصات);
    };
}
