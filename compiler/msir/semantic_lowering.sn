// Generic functions remain semantic templates until MSIR requests concrete instances.
عرف قيمة_ثابت_تصحيح_من_ثابت_مسير(الثابت: &ثابت_مسير): اختياري قيمة_ثابت_تصحيح {
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> { أرجع اختياري.موجود(قيمة_ثابت_تصحيح.منطق(القيمة)); }
    | ثابت_مسير.صحيح_موقع(القيمة) -> { أرجع اختياري.موجود(قيمة_ثابت_تصحيح.صحيح_موقع(القيمة)); }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> { أرجع اختياري.موجود(قيمة_ثابت_تصحيح.صحيح_طبيعي(القيمة)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف أعلن_مثيلات_دوال_عامة_للخفض(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    الطلبات: &متجه طلب_مثيل_دالة_خفض,
    دوال_الخفض: &متغير سياق_دوال_خفض
): اختياري خطأ_خفض_مسير {
    دع ط: متغير طبيعي = 0;
    طالما (ط < (الطول(*الطلبات) مثل طبيعي)) {
        دع مرجع_الطلب: &طلب_مثيل_دالة_خفض = &(*الطلبات)[ط];
        دع رمز_الطلب: معرف_رمز = (*مرجع_الطلب).الرمز;
        طابق مقبض_تصريح_عند(فهرس_التصريحات, رمز_الطلب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            إذا (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل طبيعي)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل طبيعي)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                إذا (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
                    دع معرف_المصدر: طبيعي = (*مرجع_الوحدة).معرف_المصدر;
                    دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
                    دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[المقبض.موضع_الوحدة];
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        إذا (الطول(الدالة.معاملات_النوع) > 0) {
                            طابق أعلن_دالة_للخفض(
                                البرنامج, التصحيح, الأصول, مرجع_المصدر, &الدالة,
                                الأنواع, أنواع_الرموز, روابط_الوحدة,
                                &(*مرجع_الطلب).استبدالات_النوع, دوال_الخفض
                            ) مع
                            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                            | اختياري.لا_شيء -> { };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ط := ط + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اخفض_مثيلات_دوال_عامة_إلى_مسير(
    البرنامج: &متغير برنامج_مسير,
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الوحدات: &متجه وحدة_مصدر,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    دوال_الخفض: &سياق_دوال_خفض,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    الطلبات: &متجه طلب_مثيل_دالة_خفض,
    فهرس_حقائق_الدوال: &فهرس_حقائق_دوال_خفض,
    // The call that started each request's instantiation (same order).
    أصول_الطلبات: &متجه نطاق
): اختياري خطأ_خفض_مسير {
    دع ط: متغير طبيعي = 0;
    طالما (ط < (الطول(*الطلبات) مثل طبيعي)) {
        دع مرجع_الطلب: &طلب_مثيل_دالة_خفض = &(*الطلبات)[ط];
        دع رمز_الطلب: معرف_رمز = (*مرجع_الطلب).الرمز;
        طابق مقبض_تصريح_عند(فهرس_التصريحات, رمز_الطلب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            إذا (
                المقبض.موضع_الوحدة < (الطول(*الوحدات) مثل طبيعي)
                && المقبض.موضع_الوحدة < (الطول(*أنواع_التعبيرات) مثل طبيعي)
                && المقبض.موضع_الوحدة < (الطول(*روابط_الأسماء) مثل طبيعي)
            ) {
                دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[المقبض.موضع_الوحدة];
                إذا (المقبض.موضع_العنصر < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
                    دع معرف_المصدر: طبيعي = (*مرجع_الوحدة).معرف_المصدر;
                    دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
                    دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[المقبض.موضع_الوحدة];
                    طابق (*مرجع_الوحدة).العناصر[المقبض.موضع_العنصر] مع
                    | عنصر_وحدة.دالة(الدالة) -> {
                        إذا (الطول(الدالة.معاملات_النوع) > 0) {
                            طابق عرض_حقائق_دالة_خفض_عند(فهرس_حقائق_الدوال, رمز_الطلب) مع
                            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_الطلب)); }
                            | اختياري.موجود(العرض) -> {
                                دع أنواع_رموز_المثيل: متجه ربط_نوع_رمز_خفض = خصص_أنواع_رموز_دالة_للمثيل(
                                    الأنواع, أنواع_الرموز, &العرض.الرموز, &(*مرجع_الطلب).استبدالات_النوع
                                );
                                دع أنواع_تعبيرات_المثيل: سياق_أنواع_تعبيرات = خصص_أنواع_تعبيرات_للمثيل(
                                    الأنواع, &(*أنواع_التعبيرات)[المقبض.موضع_الوحدة], &العرض,
                                    &(*مرجع_الطلب).استبدالات_النوع
                                );
                                دع تحققات_المثيل: متجه ربط_تحقق_نمط_وحدة = خصص_تحققات_أنماط_للمثيل(
                                    الأنواع, تحققات_الأنماط, &العرض, &(*مرجع_الطلب).استبدالات_النوع
                                );
                                طابق أول_استعمال_معتم_في_مثيل(
                                    الأنواع, &(*مرجع_الطلب).استبدالات_النوع, &أنواع_رموز_المثيل,
                                    أنواع_الرموز, &أنواع_تعبيرات_المثيل, الدالة.الاسم.النطاق
                                ) مع
                                | اختياري.موجود(الاستعمال) -> {
                                    دع أصل_الطلب: متغير نطاق = الدالة.الاسم.النطاق;
                                    إذا (ط < (الطول(*أصول_الطلبات) مثل طبيعي)) { أصل_الطلب := (*أصول_الطلبات)[ط]; };
                                    أرجع اختياري.موجود(خطأ_خفض_مسير.معتم_في_مثيل_عام(
                                        أصل_الطلب, الاستعمال.النطاق, الاستعمال.المعتم
                                    ));
                                }
                                | اختياري.لا_شيء -> { };
                                طابق اخفض_جسم_دالة_إلى_مسير(
                                    البرنامج, التصحيح, الأصول, مرجع_المصدر, &الدالة, الأنواع,
                                    أنواع_الرموز, أنواع_رموز_المثيل, &أنواع_تعبيرات_المثيل, روابط_الوحدة,
                                    &(*مرجع_الطلب).استبدالات_النوع, سجل_الأنماط,
                                    &تحققات_المثيل, دوال_الخفض, هويات_البدائيات
                                ) مع
                                | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                                | اختياري.لا_شيء -> { };
                            };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        ط := ط + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Dynamic module-global vector construction uses the canonical MSIR vector
// initializer, which obtains owned storage through the selected runtime. Never
// point a mutable vector at immutable image data.
نوع تهيئة_عام_متجه_مملوك = {
    العام: معرف_عام_مسير,
    النوع: معرف_نوع,
    الثابت: ثابت_مسير,
    النطاق: نطاق
};

عرف أصدر_عنصر_عام_مملوك_مسير(
    البرنامج: &متغير برنامج_مسير,
    البناء: &حالة_بناء_مسير,
    الدالة: معرف_دالة_مسير,
    الكتلة: معرف_كتلة_مسير,
    الثابت: &ثابت_مسير,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري معرف_قيمة_مسير {
    دع النتيجة: نتيجة_بناء_قيمة_مسير;
    طابق *الثابت مع
    | ثابت_مسير.متجه(العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_تسلسل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع المعرفات: متغير متجه معرف_قيمة_مسير = [];
        دع فهرس_العنصر: متغير طبيعي = 0;
        طالما (فهرس_العنصر < (الطول(العناصر) مثل طبيعي)) {
            طابق أصدر_عنصر_عام_مملوك_مسير(
                البرنامج, البناء, الدالة, الكتلة,
                &العناصر[فهرس_العنصر], نوع_العنصر, الأنواع
            ) مع
            | اختياري.موجود(المعرف) -> { ألحق(المعرفات, المعرف); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            فهرس_العنصر := فهرس_العنصر + 1;
        }
        النتيجة := أصدر_تهيئة_متجه_مسير(
            البرنامج, البناء, الدالة, الكتلة, &المعرفات, النوع
        );
    }
    | ثابت_مسير.نص(_) -> {
        // Literal text is static-backed. It must not be installed into a
        // heap-owned nested vector without an explicit deep-copy operation.
        أرجع اختياري.لا_شيء();
    }
    | _ -> {
        النتيجة := أصدر_ثابتا_مسير(
            البرنامج, البناء, الدالة, الكتلة, انسخ_ثابت_مسير(الثابت), النوع
        );
    };
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع اختياري.موجود(المعرف); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف أصدر_تهيئة_عوام_مملوكة_مسير(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الطلبات: &متجه تهيئة_عام_متجه_مملوك
): اختياري نطاق {
    إذا ((الطول(*الطلبات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الدالة_الأصلية: اختياري معرف_دالة_مسير = (*البرنامج).دالة_بدء_البرنامج;

    دع بلا_معاملات: متجه معرف_نوع = [];
    دع بلا_ناتج: اختياري معرف_نوع = اختياري.لا_شيء();
    دع دالة_التهيئة: معرف_دالة_مسير = أضف_دالة_مسير(
        البرنامج, &بلا_معاملات, بلا_ناتج
    );
    دع كتلة_التهيئة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, دالة_التهيئة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { كتلة_التهيئة := المعرف; }
    | _ -> { أرجع اختياري.موجود((*الطلبات)[0].النطاق); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الطلبات) مثل طبيعي)) {
        دع الطلب: &تهيئة_عام_متجه_مملوك = &(*الطلبات)[الفهرس];
        دع القيمة: معرف_قيمة_مسير;
        طابق أصدر_عنصر_عام_مملوك_مسير(
            البرنامج, &البناء, دالة_التهيئة, كتلة_التهيئة,
            &(*الطلب).الثابت, (*الطلب).النوع, الأنواع
        ) مع
        | اختياري.موجود(المعرف) -> { القيمة := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود((*الطلب).النطاق); };
        دع المكان: معرف_قيمة_مسير;
        طابق أصدر_مكان_عام_مسير(
            البرنامج, &البناء, دالة_التهيئة, كتلة_التهيئة,
            (*الطلب).العام, (*الطلب).النوع, صواب
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { المكان := المعرف; }
        | _ -> { أرجع اختياري.موجود((*الطلب).النطاق); };
        طابق أصدر_تخزين_مسير(
            البرنامج, &البناء, دالة_التهيئة, كتلة_التهيئة, المكان, القيمة
        ) مع
        | نتيجة_بناء_قيمة_مسير.بلا_قيمة -> { }
        | _ -> { أرجع اختياري.موجود((*الطلب).النطاق); };
        الفهرس := الفهرس + 1;
    }
    // The initializer returns no value: an absent value ID, not an absent Type.
    دع بلا_قيمة_إرجاع: اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    طابق اختم_بإرجاع_مسير(البرنامج, دالة_التهيئة, كتلة_التهيئة, بلا_قيمة_إرجاع) مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | _ -> { أرجع اختياري.موجود((*الطلبات)[0].النطاق); };
    // Standalone objects have no executable entry and run this code as a
    // loader-visible constructor, before process argc/argv/envp are available.
    // Keep it strictly compiler-generated: constant elements, owned-vector
    // construction, and stores to new local vector headers only. The canonical
    // MSIR verifier enforces this restriction even after optimizer rewrites.
    // Executables call this routine at language entry, after the process start.
    طابق الدالة_الأصلية مع
    | اختياري.لا_شيء -> {
        (*البرنامج).دالة_تهيئة_الوحدة := اختياري.موجود(دالة_التهيئة);
        أرجع اختياري.لا_شيء();
    }
    | اختياري.موجود(_) -> { };
    دع معرف_الدخول: معرف_دالة_مسير;
    طابق الدالة_الأصلية مع
    | اختياري.موجود(المعرف) -> { معرف_الدخول := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود((*الطلبات)[0].النطاق); };
    دع المدخل_الأصلي: معرف_كتلة_مسير;
    طابق (*البرنامج).الدوال[معرف_الدخول.القيمة].المدخل مع
    | اختياري.موجود(المعرف) -> { المدخل_الأصلي := المعرف; }
    | اختياري.لا_شيء -> { أرجع اختياري.موجود((*الطلبات)[0].النطاق); };
    دع حجج_فارغة: متجه معرف_قيمة_مسير = [];
    دع مكان_فارغ: اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
    دع نطاقات_فارغة: متجه نطاق_ذاكرة_نداء_مسير = [];
    دع النداء: نداء_مسير = {
        الهدف: هدف_نداء_مسير.دالة_سلطان(دالة_التهيئة),
        الحجج: حجج_فارغة, مكان_التعديل: مكان_فارغ, نطاقات_الذاكرة: نطاقات_فارغة, عقد_النواة: اختياري.لا_شيء()
    };
    دع التعليمة: تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(اختياري.لا_شيء(), عملية_مسير.نداء(النداء));
    // Prepend the initializer call in place: append it, then rotate it to the
    // front with element swaps. Instructions stay owned by the entry block.
    ألحق((*البرنامج).الدوال[معرف_الدخول.القيمة].الكتل[المدخل_الأصلي.القيمة].التعليمات, التعليمة);
    دع فهرس_تعليمة: متغير طبيعي =
        (الطول((*البرنامج).الدوال[معرف_الدخول.القيمة].الكتل[المدخل_الأصلي.القيمة].التعليمات) مثل طبيعي) - 1;
    طالما (فهرس_تعليمة > 0) {
        بدّل(
            (*البرنامج).الدوال[معرف_الدخول.القيمة].الكتل[المدخل_الأصلي.القيمة].التعليمات[فهرس_تعليمة],
            (*البرنامج).الدوال[معرف_الدخول.القيمة].الكتل[المدخل_الأصلي.القيمة].التعليمات[فهرس_تعليمة - 1]
        );
        فهرس_تعليمة := فهرس_تعليمة - 1;
    }
    أرجع اختياري.لا_شيء();
}

// Runtime globals currently serialize scalar bool/integer initializers. Immutable top-level
// constants may carry any constant kind supported by compile-time evaluation.
عرف هل_ثابت_تهيئة_عام_مدعوم_للخفض(الثابت: &ثابت_مسير): منطقي {
    طابق *الثابت مع
    | ثابت_مسير.منطق(_) -> { أرجع صواب; }
    | ثابت_مسير.صحيح_موقع(_) -> { أرجع صواب; }
    | ثابت_مسير.صحيح_طبيعي(_) -> { أرجع صواب; }
    | ثابت_مسير.مؤشر_فارغ -> { أرجع صواب; }
    | ثابت_مسير.متجه(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر: &مصدر, الاسم: &اسم): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = (*الاسم).النطاق.البداية.البايت;
    طالما (ف < ((*الاسم).النطاق.النهاية.البايت مثل طبيعي) && ف < (*المصدر).الطول) {
        ألحق(الناتج, (*المصدر).المحتوى[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Preserve source spelling for named Types before Frontend Name state is released.
// This is debug metadata only: Type remains the semantic owner and Target/Layout
// remains the physical representation owner.
عرف سجل_تصحيح_تصريح_نوع_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    المصدر: &مصدر,
    التصريح: &تصريح_نوع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    الروابط: &سياق_روابط_أسماء,
    الأنواع: &سجل_أنواع
): فراغ {
    دع الرمز: معرف_رمز;
    طابق رمز_اسم_محلول_عند(الروابط, (*التصريح).الاسم.النطاق) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المعرف) -> { الرمز := المعرف; };
    // A type declaration's Symbol names a Type, not a value: its TypeID is
    // its named-Type binding (سجل_أنواع.المسماة), which value Symbols lack.
    دع النوع: متغير اختياري معرف_نوع = نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز);
    طابق النوع مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        إذا ((الرمز.القيمة مثل طبيعي) < (الطول((*الأنواع).المسماة) مثل طبيعي)) {
            طابق (*الأنواع).المسماة[الرمز.القيمة] مع
            | اختياري.موجود(الربط) -> { النوع := اختياري.موجود(الربط.المعرف); }
            | اختياري.لا_شيء -> { };
        };
    };
    دع معرف_النوع: معرف_نوع;
    طابق النوع مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المعرف) -> { معرف_النوع := المعرف; };
    دع الاسم: متجه ط8 = انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &(*التصريح).الاسم);
    دع أصل_التصريح: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, (*التصريح).النطاق);
    دع أصل_اختياري: اختياري معرف_أصل_مصدر = اختياري.موجود(أصل_التصريح);
    دع الأعضاء: متغير متجه متجه ط8 = [];
    دع البدائل: متغير متجه متجه ط8 = [];
    دع أسماء_معاملات_النوع: متغير متجه متجه ط8 = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*التصريح).معاملات_النوع) مثل طبيعي)) {
        ألحق(أسماء_معاملات_النوع, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &(*التصريح).معاملات_النوع[م]));
        م := م + 1;
    }
    طابق (*التصريح).الشكل مع
    | شكل_تصريح_نوع.سجل(الحقول) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            ألحق(الأعضاء, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &الحقول[ف].الاسم));
            ف := ف + 1;
        }
    }
    | شكل_تصريح_نوع.تعداد(المنشئات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المنشئات) مثل طبيعي)) {
            ألحق(البدائل, انسخ_تهجئة_اسم_تصحيح_نوع_مسير(المصدر, &المنشئات[ف].الاسم));
            ف := ف + 1;
        }
    }
    // An opaque type is recorded by name alone: no members, no alternatives.
    | شكل_تصريح_نوع.معتم(_) -> { }
    | شكل_تصريح_نوع.مرادف(_) -> {
        // Alias spelling is a distinct DebugTypeID that references the canonical target TypeID.
        سجل_اسم_مستعار_تصحيح_مسير(التصحيح, معرف_النوع, &الاسم, أصل_اختياري);
        أرجع;
    };
    سجل_تصحيح_نوع_مسير(
        التصحيح, معرف_النوع, الرمز, &الاسم, &الأعضاء, &البدائل,
        &أسماء_معاملات_النوع, أصل_اختياري
    );
}

// Source provenance selects the installed canonical declarations. Resolved
// The Frontend, not MSIR path inspection, owns canonical RootID/ModuleKey
// provenance. Missing Frontend evidence never authenticates a raw syscall.
عرف اجمع_رموز_عقد_نواة_لينكس(
    السياق: &متغير سياق_دوال_خفض,
    الأصل: &اختياري أصل_نواة_موثق_واجهة
): فراغ {
    طابق *الأصل مع
    | اختياري.موجود(الموثق) -> {
        (*السياق).منتقي_لينكس := اختياري.موجود(الموثق.المنتقي);
        // Read the Frontend-owned list through a borrow (no field move).
        دع مرجع_المنشئات: &متجه منشئ_نواة_موثق_واجهة = &الموثق.المنشئات;
        (*السياق).منشئات_لينكس := انسخ_مملوكا_متجه_منشئ_نواة_موثق_واجهة(مرجع_المنشئات);
    }
    | اختياري.لا_شيء -> { };
}

// The selected lowered function is a separate source-owned identity. Its
// constructor signatures were already checked by the Frontend and STD owner.
عرف احفظ_أصول_نواة_مسير(
    البرنامج: &متغير برنامج_مسير,
    السياق: &سياق_دوال_خفض
): فراغ {
    دع المنتقي: معرف_رمز;
    طابق (*السياق).منتقي_لينكس مع
    | اختياري.موجود(القيمة) -> { المنتقي := القيمة; }
    | اختياري.لا_شيء -> { أرجع; };
    دع الدالة: معرف_دالة_مسير;
    طابق دالة_خفض_عند(السياق, المنتقي) مع
    | اختياري.موجود(الربط) -> {
        طابق الربط.الهدف مع
        | هدف_دالة_خفض.داخلية(المعرف) -> { الدالة := المعرف; }
        | _ -> { أرجع; };
    }
    | اختياري.لا_شيء -> { أرجع; };
    دع فهرس: متغير طبيعي = 0;
    طالما (فهرس < (الطول((*السياق).منشئات_لينكس) مثل طبيعي)) {
        // Borrow the Frontend-owned constructor; copy its signature through
        // the borrow so MSIR owns an independent record.
        دع المنشئ: &منشئ_نواة_موثق_واجهة = &(*السياق).منشئات_لينكس[فهرس];
        دع مرجع_التوقيع: &توقيع_نداء_بدائي = &(*المنشئ).التوقيع;
        دع التوقيع: توقيع_نداء_بدائي = انسخ_مملوكا_توقيع_نداء_بدائي(مرجع_التوقيع);
        دع الأصل: مصدر_عقد_نواة_مسير = {
            المنشئ: (*المنشئ).الرمز,
            الترتيب: (*المنشئ).الترتيب,
            المنتقي: الدالة,
            التوقيع: التوقيع
        };
        ألحق((*البرنامج).أصول_النواة, الأصل);
        فهرس := فهرس + 1;
    }
}

// Whole-unit assembly is private to the canonical semantic lowering boundary.
عرف اخفض_وحدات_دلالية_إلى_مسير(
    الوحدات: &متجه وحدة_مصدر,
    الوحدات_الدلالية: &متجه وحدة_دلالية,
    فهرس_التصريحات: &فهرس_تصريحات,
    خريطة_المصادر: &خريطة_مصادر,
    الأنواع: &متغير سجل_أنواع,
    أنواع_الرموز: &سياق_أنواع_رموز,
    أنواع_التعبيرات: &متجه سياق_أنواع_تعبيرات,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    سجل_الأنماط: &سجل_أنماط,
    تحققات_الأنماط: &متجه ربط_تحقق_نمط_وحدة,
    هويات_البدائيات: &متجه ربط_رمز_بدائي_مترجم,
    رمز_بدء_البرنامج: اختياري معرف_رمز,
    أصل_نواة_لينكس: &اختياري أصل_نواة_موثق_واجهة,
    رموز_لا_تعود: &متجه معرف_رمز,
    رموز_التنسيق: &متجه معرف_رمز,
    حقائق_الملكية: حقائق_ملكية_تدفق
): نتيجة_خفض_مسير {
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    // Lowering asks for the ownership class of a Type at every store,
    // argument and drop: classify each Type once (ownership_glue.sn).
    املأ_تصنيفات_ملكية_مسير(الأنواع);
    دع تهيئات_مملوكة: متغير متجه تهيئة_عام_متجه_مملوك = [];
    دع التصحيح: متغير بيانات_تصحيح_مسير = بيانات_تصحيح_مسير_جديدة();
    دع الأصول: متغير سجل_أصول_مصدر = سجل_أصول_مصدر_جديد();
    دع دوال_الخفض: متغير سياق_دوال_خفض = سياق_دوال_خفض_جديد();
    دوال_الخفض.حقائق_الملكية := حقائق_الملكية;
    دع ر_لا_تعود: متغير طبيعي = 0;
    طالما (ر_لا_تعود < (الطول(*رموز_لا_تعود) مثل طبيعي)) {
        ألحق(دوال_الخفض.رموز_لا_تعود, (*رموز_لا_تعود)[ر_لا_تعود]);
        ر_لا_تعود := ر_لا_تعود + 1;
    }
    دع ر_تنسيق: متغير طبيعي = 0;
    طالما (ر_تنسيق < (الطول(*رموز_التنسيق) مثل طبيعي)) {
        ألحق(دوال_الخفض.رموز_التنسيق, (*رموز_التنسيق)[ر_تنسيق]);
        ر_تنسيق := ر_تنسيق + 1;
    }
    دع بلا_استبدالات: متجه ربط_استبدال_نوع = [];
    اجمع_رموز_عقد_نواة_لينكس(&متغير دوال_الخفض, أصل_نواة_لينكس);
    سجل_وحدات_تصحيح_مسير(&متغير التصحيح, الوحدات_الدلالية, خريطة_المصادر);
    دع فهرس_حقائق_الدوال: فهرس_حقائق_دوال_خفض;
    طابق ابن_فهرس_حقائق_دوال_خفض(
        الوحدات, فهرس_التصريحات, أنواع_التعبيرات, روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط
    ) مع
    | نتيجة.نجح(الفهرس) -> { فهرس_حقائق_الدوال := الفهرس; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); };
    دع طلبات_المثيلات: متجه طلب_مثيل_دالة_خفض;
    دع أصول_المثيلات: متغير متجه نطاق = [];
    طابق ابن_طلبات_مثيلات_دوال(
        الأنواع, أنواع_التعبيرات, &فهرس_حقائق_الدوال, &متغير أصول_المثيلات
    ) مع
    | نتيجة.نجح(الطلبات) -> { طلبات_المثيلات := الطلبات; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); };

    // Declare every semantic function before lowering any body. Cross-module calls therefore
    // consume the same canonical Symbol -> FunctionID map and are independent of module order.
    دع خارجيات_سي: متغير متجه دالة_سي_للخفض = [];
    دع تعريفات_سي: متغير متجه دالة_سي_للخفض = [];
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع معرف_المصدر: طبيعي = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                إذا (الطول(الدالة.معاملات_النوع) == 0) {
                    طابق أعلن_دالة_للخفض(
                        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &الدالة, الأنواع, أنواع_الرموز,
                        روابط_الوحدة, &بلا_استبدالات, &متغير دوال_الخفض
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                    سجل_دالة_سي_للخفض(مرجع_المصدر, &الدالة, &دوال_الخفض, &متغير خارجيات_سي, &متغير تعريفات_سي);
                    علم_دالة_مترجمة_من_سي_للخفض(مرجع_المصدر, &الدالة, &دوال_الخفض, &متغير البرنامج.دوال_اتفاقية_المنصة);
                };
            }
            | عنصر_وحدة.قيمة_عليا(التصريح) -> {
                دع الرمز: معرف_رمز;
                طابق رمز_اسم_محلول_عند(روابط_الوحدة, التصريح.الاسم.النطاق) مع
                | اختياري.موجود(المعرف) -> { الرمز := المعرف; }
                | اختياري.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.ربط_اسم_مفقود(التصريح.الاسم.النطاق)); };
                دع النوع_الدلالي: معرف_نوع;
                طابق نوع_رمز_دلالي_عند(أنواع_الرموز, الرمز) مع
                | اختياري.موجود(المعرف) -> { النوع_الدلالي := المعرف; }
                | اختياري.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
                دع نوع_القيمة: معرف_نوع;
                طابق نوع_تمثيل_قيمة_مسير_للخفض(الأنواع, النوع_الدلالي) مع
                | اختياري.موجود(المعرف) -> { نوع_القيمة := المعرف; }
                | اختياري.لا_شيء -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.نوع_رمز_دلالي_مفقود(الرمز)); };
                // External variables are linker-owned data, not constant expressions.
                دع اسم_خارجي: متغير اختياري متجه ط8 = اختياري.لا_شيء();
                طابق التصريح.التهيئة مع
                | تهيئة_قيمة_عليا.خارجية(الاسم) -> { اسم_خارجي := اختياري.موجود(انسخ_بايتات(&الاسم)); }
                | _ -> { };
                دع الثابت: ثابت_مسير;
                دع نتيجة_الثابت: نتيجة_تقييم_ثابت_خفض;
                طابق التصريح.التهيئة مع
                | تهيئة_قيمة_عليا.خارجية(_) -> {
                    نتيجة_الثابت := نتيجة_تقييم_ثابت_خفض.ثابت(ثابت_مسير.صحيح_طبيعي(0));
                }
                | تهيئة_قيمة_عليا.تعبير(التعبير) -> {
                    نتيجة_الثابت := قيم_تعبير_ثابت_للخفض(
                        &التعبير, الأنواع, أنواع_تعبيرات_الوحدة, روابط_الوحدة, &دوال_الخفض
                    );
                }
                | تهيئة_قيمة_عليا.متجه(العناصر) -> {
                    نتيجة_الثابت := قيم_متجه_ثابتا_للخفض(
                        &العناصر, الأنواع, أنواع_تعبيرات_الوحدة, روابط_الوحدة, &دوال_الخفض
                    );
                };
                طابق نتيجة_الثابت مع
                | نتيجة_تقييم_ثابت_خفض.ثابت(القيمة) -> { الثابت := ثابت_صحيح_بنوع_الوجهة(القيمة, الأنواع, نوع_القيمة); }
                | نتيجة_تقييم_ثابت_خفض.فخ -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تقييم_ثابت_بفخ(التصريح.النطاق)); }
                | _ -> { أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(التصريح.النطاق)); };
                دع قابل_للكتابة: منطقي = هل_غلاف_نوع_متغير(الأنواع, النوع_الدلالي);
                دع الهدف: هدف_قيمة_عليا_خفض;
                دع اسم_القيمة_العليا: متجه ط8 = انسخ_تهجئة_اسم_تصحيح_نوع_مسير(مرجع_المصدر, &التصريح.الاسم);
                طابق اسم_خارجي مع
                | اختياري.موجود(اسم_الربط) -> {
                    // External storage is linker-owned. The declared mutability
                    // is part of its canonical MSIR identity, not an initializer.
                    دع العام: معرف_عام_مسير = أضف_عاما_خارجيا_مسير(
                        &متغير البرنامج, نوع_القيمة, اسم_الربط, قابل_للكتابة
                    );
                    الهدف := هدف_قيمة_عليا_خفض.عام(العام);
                    سجل_عام_تصحيح_مسير(
                        &متغير التصحيح, &متغير الأصول, العام, الرمز, النوع_الدلالي,
                        &اسم_القيمة_العليا, التصريح.النطاق, التصريح.علني
                    );
                }
                | اختياري.لا_شيء -> {
                إذا (قابل_للكتابة) {
                    إذا (!هل_ثابت_تهيئة_عام_مدعوم_للخفض(&الثابت)) {
                        أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(التصريح.النطاق));
                    };
                    دع تهيئة_ساكنة: متغير ثابت_مسير = انسخ_ثابت_مسير(&الثابت);
                    طابق عدد_عناصر_ثابت_متجه_مسير(&الثابت) مع
                    | اختياري.موجود(عدد_العناصر) -> {
                        إذا (عدد_العناصر > 0) {
                            // An empty header has no foreign backing to release.
                            دع عناصر_فارغة: متجه ثابت_مسير = [];
                            تهيئة_ساكنة := ثابت_مسير.متجه(عناصر_فارغة);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    دع العام: معرف_عام_مسير = أضف_عاما_مسير(&متغير البرنامج, نوع_القيمة, تهيئة_ساكنة, صواب);
                    طابق عدد_عناصر_ثابت_متجه_مسير(&الثابت) مع
                    | اختياري.موجود(عدد_العناصر) -> {
                        إذا (عدد_العناصر > 0) {
                            دع الطلب: تهيئة_عام_متجه_مملوك = {
                                العام: العام, النوع: نوع_القيمة,
                                الثابت: انسخ_ثابت_مسير(&الثابت), النطاق: التصريح.النطاق
                            };
                            ألحق(تهيئات_مملوكة, الطلب);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    الهدف := هدف_قيمة_عليا_خفض.عام(العام);
                    سجل_عام_تصحيح_مسير(
                        &متغير التصحيح, &متغير الأصول, العام, الرمز, النوع_الدلالي,
                        &اسم_القيمة_العليا, التصريح.النطاق, التصريح.علني
                    );
                } وإلا {
                    // Immutable aggregates have static storage and stable identity.
                    // Scalar immutable values still use compile-time substitution.
                    دع يحتاج_عاما_ثابتا: متغير منطقي = خطأ;
                    طابق الثابت مع
                    | ثابت_مسير.متجه(_) -> { يحتاج_عاما_ثابتا := صواب; }
                    | _ -> { };
                    إذا (يحتاج_عاما_ثابتا) {
                        دع العام: معرف_عام_مسير = أضف_عاما_مسير(&متغير البرنامج, نوع_القيمة, الثابت, خطأ);
                        الهدف := هدف_قيمة_عليا_خفض.عام(العام);
                        سجل_عام_تصحيح_مسير(
                            &متغير التصحيح, &متغير الأصول, العام, الرمز, النوع_الدلالي,
                            &اسم_القيمة_العليا, التصريح.النطاق, التصريح.علني
                        );
                    } وإلا {
                        دع قيمة_التصحيح: اختياري قيمة_ثابت_تصحيح = قيمة_ثابت_تصحيح_من_ثابت_مسير(&الثابت);
                        الهدف := هدف_قيمة_عليا_خفض.ثابت(الثابت);
                        سجل_ثابت_تصحيح_مسير(
                            &متغير التصحيح, &متغير الأصول, الرمز, النوع_الدلالي,
                            &اسم_القيمة_العليا, التصريح.النطاق, قيمة_التصحيح, التصريح.علني
                        );
                    };
                };
                };
                دع الربط: ربط_قيمة_عليا_خفض = {
                    الرمز: الرمز, النوع: نوع_القيمة, قابل_للكتابة: قابل_للكتابة, الهدف: الهدف
                };
                إذا (!أضف_قيمة_عليا_خفض(&متغير دوال_الخفض, الربط)) {
                    أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(الرمز));
                };
            }
            | عنصر_وحدة.نوع(التصريح) -> {
                سجل_تصحيح_تصريح_نوع_مسير(
                    &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &التصريح, أنواع_الرموز, روابط_الوحدة, الأنواع
                );
            }
            | عنصر_وحدة.تجميع(_, _) -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }

    // C linkage between C imports (lowering/functions.sn).
    اربط_خارجيات_سي_للخفض(الأنواع, &متغير دوال_الخفض, &خارجيات_سي, &تعريفات_سي);

    طابق أعلن_مثيلات_دوال_عامة_للخفض(
        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, الوحدات, فهرس_التصريحات,
        خريطة_المصادر, الأنواع, أنواع_الرموز, روابط_الأسماء,
        &طلبات_المثيلات, &متغير دوال_الخفض
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };

    // A native executable's startup terminates through the STD process-exit
    // provider. Bind its canonical definition once as a program fact; the ABI
    // spelling is owned by compiler.runtime.primitive_runtime_abi.
    البرنامج.دالة_خروج_العملية := مزود_خروج_عملية_مسير(&البرنامج, &التصحيح);
    // The std task context switch, when std.async is loaded.
    دع اسم_تبديل_السياق: متجه ط8 = اسم_تبديل_سياق_المهام_أساسي();
    البرنامج.دالة_تبديل_سياق_المهام := دالة_علنية_وحيدة_باسم_مسير(&البرنامج, &التصحيح, &اسم_تبديل_السياق);
    // Likewise the std allocation-service providers, bound only as a set.
    البرنامج.مزودات_تخصيص_الذاكرة := مزودات_تخصيص_ذاكرة_مسير_من_البرنامج(&البرنامج, &التصحيح);
    // And std's allocation counters, each when loaded.
    دع أسماء_العدادات: متجه متجه ط8 = أسماء_عدادات_التخصيص_أساسية();
    دع ع_: متغير طبيعي = 0;
    طالما (ع_ < (الطول(أسماء_العدادات) مثل طبيعي)) {
        ألحق(البرنامج.دوال_عدادات_التخصيص, دالة_علنية_وحيدة_باسم_مسير(&البرنامج, &التصحيح, &أسماء_العدادات[ع_]));
        ع_ := ع_ + 1;
    }
    // std.fmt's compile-time format checker, when std.fmt is loaded.
    إذا ((الطول(دوال_الخفض.رموز_التنسيق) مثل طبيعي) > 0) {
        طابق دالة_خفض_عند(&دوال_الخفض, دوال_الخفض.رموز_التنسيق[0]) مع
        | اختياري.موجود(الربط) -> {
            طابق الربط.الهدف مع
            | هدف_دالة_خفض.داخلية(المعرف) -> { البرنامج.دالة_تحقق_التنسيق := اختياري.موجود(المعرف); }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
    };

    طابق رمز_بدء_البرنامج مع
    | اختياري.موجود(رمز_البدء) -> {
        طابق دالة_خفض_عند(&دوال_الخفض, رمز_البدء) مع
        | اختياري.موجود(ربط_البدء) -> {
            طابق ربط_البدء.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_البدء) -> {
                طابق عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, معرف_البدء) مع
                | اختياري.موجود(_) -> {
                    أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
                }
                | اختياري.لا_شيء -> { };
            }
            | هدف_دالة_خفض.خارجية(_) -> {
                أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
            };
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.دالة_دلالية_مفقودة(رمز_البدء));
        };
    }
    | اختياري.لا_شيء -> { };

    احفظ_أصول_نواة_مسير(&متغير البرنامج, &دوال_الخفض);

    و := 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع روابط_الوحدة: &سياق_روابط_أسماء = &(*روابط_الأسماء)[و];
        دع أنواع_تعبيرات_الوحدة: &سياق_أنواع_تعبيرات = &(*أنواع_التعبيرات)[و];
        دع معرف_المصدر: طبيعي = (*مرجع_الوحدة).معرف_المصدر;
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[معرف_المصدر];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                إذا (الطول(الدالة.معاملات_النوع) == 0) {
                    دع أنواع_رموز_فارغة: متجه ربط_نوع_رمز_خفض = [];
                    طابق اخفض_جسم_دالة_إلى_مسير(
                        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, مرجع_المصدر, &الدالة, الأنواع, أنواع_الرموز, أنواع_رموز_فارغة, أنواع_تعبيرات_الوحدة,
                        روابط_الوحدة, &بلا_استبدالات, سجل_الأنماط, تحققات_الأنماط,
                        &دوال_الخفض, هويات_البدائيات
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }

    طابق اخفض_مثيلات_دوال_عامة_إلى_مسير(
        &متغير البرنامج, &متغير التصحيح, &متغير الأصول, الوحدات, فهرس_التصريحات,
        خريطة_المصادر, الأنواع, أنواع_الرموز, أنواع_التعبيرات,
        روابط_الأسماء, سجل_الأنماط, تحققات_الأنماط, &دوال_الخفض,
        هويات_البدائيات, &طلبات_المثيلات, &فهرس_حقائق_الدوال, &أصول_المثيلات
    ) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };

    طابق أصدر_تهيئة_عوام_مملوكة_مسير(&متغير البرنامج, الأنواع, &تهيئات_مملوكة) مع
    | اختياري.موجود(النطاق) -> {
        أرجع نتيجة_خفض_مسير.مرفوض(خطأ_خفض_مسير.تعبير_غير_مدعوم(النطاق));
    }
    | اختياري.لا_شيء -> { };

    // Explicit copies become calls of per-Type clone glue
    // (compiler/msir/lowering/ownership_glue.sn).
    طابق اخفض_غراء_الملكية_مسير(&متغير البرنامج, الأنواع) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
    | اختياري.لا_شيء -> { };
    امسح_تصنيفات_ملكية_مسير(الأنواع);
    أسقط_دوال_سي_المأخوذة_قيمها_للخفض(&متغير البرنامج);

    // Definition-time decorators (frontend/annotations/definition_decorators.sn):
    // the entry calls every registration function before its own body.
    طابق رمز_بدء_البرنامج مع
    | اختياري.موجود(رمز_البدء) -> {
        طابق دالة_خفض_عند(&دوال_الخفض, رمز_البدء) مع
        | اختياري.موجود(ربط_البدء) -> {
            طابق ربط_البدء.الهدف مع
            | هدف_دالة_خفض.داخلية(معرف_البدء) -> {
                دع المسجلات: متجه معرف_دالة_مسير = مسجلات_التعريف_مسير(
                    الوحدات, خريطة_المصادر, روابط_الأسماء, &دوال_الخفض
                );
                طابق شغل_مسجلات_التعريف_مسير(&متغير البرنامج, معرف_البدء, &المسجلات) مع
                | اختياري.موجود(الخطأ) -> { أرجع نتيجة_خفض_مسير.مرفوض(الخطأ); }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };

    // Builder/lowering own construction invariants. Production lowering must not
    // rescan the complete MSIR program with dominance/definition verification.
    سجل_أصول_مواقع_تصحيح_مسير(&متغير البرنامج, &التصحيح);
    أرجع نتيجة_خفض_مسير.ناجح(البرنامج, التصحيح, الأصول);
}

// The source origin of each debug location, as an MSIR program fact: an
// instruction's origin is that of its location (أصل_تعليمة_مسير), so a
// consumer of the program needs no debug data to name it.
عرف سجل_أصول_مواقع_تصحيح_مسير(البرنامج: &متغير برنامج_مسير, التصحيح: &بيانات_تصحيح_مسير): فراغ {
    دع الأصول: متغير متجه معرف_أصل_مصدر = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التصحيح).الدلالي.المواقع) مثل طبيعي)) {
        ألحق(الأصول, (*التصحيح).الدلالي.المواقع[ف].الأصل);
        ف := ف + 1;
    }
    (*البرنامج).أصول_مواقع_التصحيح := الأصول;
}

// Canonical owned payload transferred from Frontend lowering to Driver consumers.
// MSIR owns this shape so Driver composes the lifecycle without duplicating the handoff.
عام نوع حمولة_مسير_مخفضة = {
    المسير: برنامج_مسير,
    الأنواع: سجل_أنواع,
    المصادر: خريطة_مصادر,
    الأصول: سجل_أصول_مصدر,
    التصحيح: بيانات_تصحيح_مسير
};

// الحد العام الوحيد من Frontend المقنن إلى MSIR المتحقق.
// The public MSIR boundary exposes canonical diagnostics, never MSIR-internal failures.
عام نوع نتيجة_خفض_واجهة_مسير =
    | ناجح بنوع حمولة_مسير_مخفضة
    | مرفوض بنوع مجموعة_تشخيصات
;

// Public Frontend -> MSIR handoff. Driver passes the canonical whole-unit semantic result
// without unpacking owner-specific contexts. MSIR consumes the semantic facts internally.
عام عرف اخفض_واجهة_وحدة_إلى_مسير(
    الواجهة: متغير نتيجة_واجهة_وحدة
): نتيجة_خفض_واجهة_مسير {
    // Lowering takes the SSF ownership facts out of the Frontend result.
    دع حقائق_الملكية: متغير حقائق_ملكية_تدفق = حقائق_ملكية_تدفق_جديدة();
    بدّل(حقائق_الملكية, الواجهة.حقائق_الملكية);
    // Lower directly from the owned Frontend result. The previous boundary copied
    // every large semantic field into a second aggregate before lowering, keeping
    // both copies alive at once. Borrow the canonical fields in place instead.
    طابق اخفض_وحدات_دلالية_إلى_مسير(
        &الواجهة.الوحدات,
        &الواجهة.الوحدات_الدلالية,
        &الواجهة.فهرس_التصريحات,
        &الواجهة.خريطة_المصادر,
        &متغير الواجهة.سياقات_الأنواع.الأنواع,
        &الواجهة.سياقات_الأنواع.أنواع_الرموز,
        &الواجهة.سياقات_الأنواع.أنواع_التعبيرات,
        &الواجهة.روابط_الأسماء,
        &الواجهة.سياق_الأنماط.الأنماط,
        &الواجهة.سياق_الأنماط.التحققات,
        &الواجهة.هويات_البدائيات,
        الواجهة.رمز_بدء_البرنامج,
        &الواجهة.أصل_نواة_لينكس,
        &الواجهة.رموز_لا_تعود,
        &الواجهة.رموز_التنسيق,
        حقائق_الملكية
    ) مع
    | نتيجة_خفض_مسير.ناجح(البرنامج, التصحيح, الأصول) -> {
        // Verification (including the loader-exposed module-initializer
        // restriction) is the Driver's single canonical boundary that follows
        // this handoff (compiler_driver.sn, تحقق_برنامج_مسير); lowering no
        // longer checks a subset of it separately.
        // Lowering is the final consumer of AST/Name/Pattern/Memory/SSF state.
        // Move the two surviving canonical owners out of the Frontend payload
        // exactly once; all other Frontend-only fields end at this boundary
        // (the arm consumes the payload, so the fields matched with `_` are
        // destroyed on entry to it).
        طابق الواجهة مع
        | {
            الوحدات: _,
            أصل_نواة_لينكس: _,
            رموز_لا_تعود: _,
            رموز_التنسيق: _,
            الوحدات_الدلالية: _,
            خريطة_المصادر: خريطة_الناتج,
            هويات_البدائيات: _,
            روابط_الأسماء: _,
            فهرس_التصريحات: _,
            استعلامات_الأسماء: _,
            رمز_بدء_البرنامج: _,
            سياقات_الأنواع: سياقات_الأنواع_الناتج,
            سياق_الأنماط: _,
            كاملة_دلاليا: _,
            تشخيصات_الأدوات: _,
            حقائق_الملكية: _,
            حقائق_الأدوات: _
        } -> {
            طابق سياقات_الأنواع_الناتج مع
            | {
                الأنواع: أنواع_الناتج,
                أنواع_التعبيرات: _,
                أنواع_الرموز: _,
                علاقات_هرم_الأنواع: _
            } -> {
                دع الحمولة: حمولة_مسير_مخفضة = {
                    المسير: البرنامج,
                    الأنواع: أنواع_الناتج,
                    المصادر: خريطة_الناتج,
                    الأصول: الأصول,
                    التصحيح: التصحيح
                };
                أرجع نتيجة_خفض_واجهة_مسير.ناجح(الحمولة);
            };
        };
    }
    | نتيجة_خفض_مسير.مرفوض(الخطأ) -> {
        // Named Types print only when Name facts were retained; otherwise the
        // Type ID is kept (primitive and structural Types always print).
        دع أسماء_فارغة: متجه اسم_مقنن = [];
        دع رموز_فارغة: متجه رمز_دلالي = [];
        دع مرجع_الاستعلامات: &اختياري سياق_استعلامات_أسماء = &الواجهة.استعلامات_الأسماء;
        دع الاستعلامات: اختياري سياق_استعلامات_أسماء = *مرجع_الاستعلامات;
        طابق الاستعلامات مع
        | اختياري.موجود(الأسماء) -> {
            دع التشخيصات: متغير مجموعة_تشخيصات = حول_فشل_خفض_إلى_تشخيصات(
                الخطأ, &الواجهة.سياقات_الأنواع.الأنواع, &الأسماء.الأسماء, &الأسماء.الرموز
            );
            أرفق_مصادر_تشخيصات_خفض(&متغير التشخيصات, &الواجهة.خريطة_المصادر);
            أرجع نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات);
        }
        | اختياري.لا_شيء -> {
            دع التشخيصات: متغير مجموعة_تشخيصات = حول_فشل_خفض_إلى_تشخيصات(
                الخطأ, &الواجهة.سياقات_الأنواع.الأنواع, &أسماء_فارغة, &رموز_فارغة
            );
            أرفق_مصادر_تشخيصات_خفض(&متغير التشخيصات, &الواجهة.خريطة_المصادر);
            أرجع نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات);
        };
    };
}

// Exactly one public declared function spelled with the canonical process-exit
// ABI name is the provider. None (module not loaded) or several leave it
// unbound; a native executable entry then fails closed in the backend.
عرف مزود_خروج_عملية_مسير(
    البرنامج: &برنامج_مسير,
    التصحيح: &بيانات_تصحيح_مسير
): اختياري معرف_دالة_مسير {
    دع الاسم: متجه ط8 = اسم_خروج_عملية_نظام_أساسي();
    أرجع دالة_علنية_وحيدة_باسم_مسير(البرنامج, التصحيح, &الاسم);
}

// The allocation providers are bound only when all three canonical
// definitions are present exactly once (the module is loaded); otherwise a
// backend that needs them fails closed.
عرف مزودات_تخصيص_ذاكرة_مسير_من_البرنامج(
    البرنامج: &برنامج_مسير,
    التصحيح: &بيانات_تصحيح_مسير
): اختياري مزودات_تخصيص_ذاكرة_مسير {
    دع اسم_التخصيص: متجه ط8 = اسم_مزود_تخصيص_ذاكرة_أساسي();
    دع اسم_إعادة_التخصيص: متجه ط8 = اسم_مزود_إعادة_تخصيص_ذاكرة_أساسي();
    دع اسم_التحرير: متجه ط8 = اسم_مزود_تحرير_ذاكرة_أساسي();
    دع التخصيص: معرف_دالة_مسير;
    طابق دالة_علنية_وحيدة_باسم_مسير(البرنامج, التصحيح, &اسم_التخصيص) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> { التخصيص := المعرف; };
    دع إعادة_التخصيص: معرف_دالة_مسير;
    طابق دالة_علنية_وحيدة_باسم_مسير(البرنامج, التصحيح, &اسم_إعادة_التخصيص) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> { إعادة_التخصيص := المعرف; };
    دع التحرير: معرف_دالة_مسير;
    طابق دالة_علنية_وحيدة_باسم_مسير(البرنامج, التصحيح, &اسم_التحرير) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> { التحرير := المعرف; };
    دع المزودات: مزودات_تخصيص_ذاكرة_مسير = {
        التخصيص: التخصيص,
        إعادة_التخصيص: إعادة_التخصيص,
        التحرير: التحرير
    };
    أرجع اختياري.موجود(المزودات);
}

// The element count of a vector constant, read in place.
عرف عدد_عناصر_ثابت_متجه_مسير(الثابت: &ثابت_مسير): اختياري طبيعي {
    طابق *الثابت مع
    | ثابت_مسير.متجه(العناصر) -> { أرجع اختياري.موجود(الطول(العناصر) مثل طبيعي); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Exactly one public declared function with this canonical ABI spelling.
عرف دالة_علنية_وحيدة_باسم_مسير(
    البرنامج: &برنامج_مسير,
    التصحيح: &بيانات_تصحيح_مسير,
    الاسم_المطلوب: &متجه ط8
): اختياري معرف_دالة_مسير {
    دع الموجود: متغير اختياري معرف_دالة_مسير = اختياري.لا_شيء();
    دع العدد: متغير طبيعي = 0;
    دع عدد_الدوال: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع عدد_الروابط: طبيعي = الطول((*التصحيح).العقد.دوال) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الدوال && ف < عدد_الروابط) {
        دع مرجع_الربط: &اختياري معرف_دالة_تصحيح = &(*التصحيح).العقد.دوال[ف];
        دع الربط: اختياري معرف_دالة_تصحيح = *مرجع_الربط;
        طابق الربط مع
        | اختياري.موجود(معرف_التصحيح) -> {
            إذا (معرف_التصحيح.القيمة < (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) {
                دع الدالة: &دالة_تصحيح = &(*التصحيح).الدلالي.الدوال[معرف_التصحيح.القيمة];
                إذا ((*الدالة).علني && بايتات_اسم_متساوية_للخفض(&(*الدالة).الاسم, الاسم_المطلوب)) {
                    الموجود := اختياري.موجود(معرف_دالة_مسير_من(ف));
                    العدد := العدد + 1;
                };
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا (العدد != 1) { أرجع اختياري.لا_شيء(); };
    أرجع الموجود;
}

عرف بايتات_اسم_متساوية_للخفض(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Lowering failures carry only a span. Attach the loaded source identity
// (name, snippet and coordinates) from the canonical Frontend source map, the
// same owner the Frontend diagnostics use, so lowering errors are locatable.
عرف أرفق_مصادر_تشخيصات_خفض(
    المجموعة: &متغير مجموعة_تشخيصات,
    المصادر: &خريطة_مصادر
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعة).التشخيصات) مثل طبيعي)) {
        دع مرجع_الرئيسي: &اختياري نطاق_مصدر_تشخيص = &(*المجموعة).التشخيصات[ف].المصدر_الرئيسي;
        دع الرئيسي: اختياري نطاق_مصدر_تشخيص = *مرجع_الرئيسي;
        طابق الرئيسي مع
        | اختياري.موجود(المصدر) -> {
            طابق المصدر.اسم_المصدر مع
            | اختياري.لا_شيء -> {
                طابق مصدر_تشخيص_من_نطاق_محمل(المصادر, المصدر.النطاق) مع
                | اختياري.موجود(المسمى) -> {
                    (*المجموعة).التشخيصات[ف].المصدر_الرئيسي := اختياري.موجود(المسمى);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.موجود(_) -> { };
        }
        | اختياري.لا_شيء -> { };
        // Related spans (an opaque-type use inside a generic instance) are
        // named through the same map.
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*المجموعة).التشخيصات[ف].النطاقات_المرتبطة) مثل طبيعي)) {
            دع المرتبط: نطاق_مرتبط_بتشخيص = (*المجموعة).التشخيصات[ف].النطاقات_المرتبطة[م];
            طابق المرتبط.المصدر.اسم_المصدر مع
            | اختياري.لا_شيء -> {
                طابق مصدر_تشخيص_من_نطاق_محمل(المصادر, المرتبط.المصدر.النطاق) مع
                | اختياري.موجود(المسمى) -> {
                    دع المسمى_المرتبط: نطاق_مرتبط_بتشخيص = { المصدر: المسمى, الدور: المرتبط.الدور };
                    (*المجموعة).التشخيصات[ف].النطاقات_المرتبطة[م] := المسمى_المرتبط;
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.موجود(_) -> { };
            م := م + 1;
        }
        ف := ف + 1;
    }
}

// Driver-facing observation of the lowering result. Driver owns sequencing and
// presentation only; it does not import or inspect the MSIR program payload.
عام عرف خفض_واجهة_مسير_ناجح(النتيجة: &نتيجة_خفض_واجهة_مسير): منطقي {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(_) -> {
        أرجع صواب;
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(_) -> {
        أرجع خطأ;
    };
}

// Driver-facing entry identity query. The private Symbol→FunctionID lowering map never escapes MSIR.
عام عرف معرف_دالة_بدء_خفض_واجهة_مسير(
    النتيجة: &نتيجة_خفض_واجهة_مسير
): اختياري معرف_دالة_مسير {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(الحمولة) -> {
        أرجع معرف_دالة_بدء_برنامج_مسير(&الحمولة.المسير);
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(_) -> {
        أرجع اختياري.لا_شيء();
    };
}

عام عرف تشخيصات_خفض_واجهة_مسير(
    النتيجة: &نتيجة_خفض_واجهة_مسير
): اختياري مجموعة_تشخيصات {
    طابق *النتيجة مع
    | نتيجة_خفض_واجهة_مسير.ناجح(_) -> {
        أرجع اختياري.لا_شيء();
    }
    | نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات) -> {
        أرجع اختياري.موجود(انسخ_مملوكا_مجموعة_تشخيصات(&التشخيصات));
    };
}

// The registration functions of definition-time decorators, in module and
// declaration order: functions whose name starts with بادئة_مسجل_تعريف.
عرف مسجلات_التعريف_مسير(
    الوحدات: &متجه وحدة_مصدر,
    خريطة_المصادر: &خريطة_مصادر,
    روابط_الأسماء: &متجه سياق_روابط_أسماء,
    دوال_الخفض: &سياق_دوال_خفض
): متجه معرف_دالة_مسير {
    دع الناتج: متغير متجه معرف_دالة_مسير = [];
    دع البادئة: نص = بادئة_مسجل_تعريف();
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    دع و: متغير طبيعي = 0;
    طالما (و < (الطول(*الوحدات) مثل طبيعي)) {
        دع مرجع_الوحدة: &وحدة_مصدر = &(*الوحدات)[و];
        دع مرجع_المصدر: &مصدر = &(*خريطة_المصادر).المصادر[(*مرجع_الوحدة).معرف_المصدر];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*مرجع_الوحدة).العناصر) مثل طبيعي)) {
            طابق (*مرجع_الوحدة).العناصر[ف] مع
            | عنصر_وحدة.دالة(الدالة) -> {
                دع البداية: طبيعي = الدالة.الاسم.النطاق.البداية.البايت;
                دع النهاية: طبيعي = الدالة.الاسم.النطاق.النهاية.البايت;
                دع مطابق: متغير منطقي = النهاية - البداية > طول_البادئة
                    && النهاية <= (الطول((*مرجع_المصدر).المحتوى) مثل طبيعي);
                دع ك: متغير طبيعي = 0;
                طالما (مطابق && ك < طول_البادئة) {
                    إذا ((*مرجع_المصدر).المحتوى[البداية + ك] != البادئة[ك]) { مطابق := خطأ; };
                    ك := ك + 1;
                }
                إذا (مطابق) {
                    طابق رمز_اسم_محلول_عند(&(*روابط_الأسماء)[و], الدالة.الاسم.النطاق) مع
                    | اختياري.موجود(الرمز) -> {
                        طابق دالة_خفض_عند(دوال_الخفض, الرمز) مع
                        | اختياري.موجود(الربط) -> {
                            طابق الربط.الهدف مع
                            | هدف_دالة_خفض.داخلية(المعرف) -> { ألحق(الناتج, المعرف); }
                            | _ -> { };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        و := و + 1;
    }
    أرجع الناتج;
}

// A new block calls the registration functions and goes on to where the
// entry's prologue went; the prologue goes to it instead.
عرف شغل_مسجلات_التعريف_مسير(
    البرنامج: &متغير برنامج_مسير,
    الدالة: معرف_دالة_مسير,
    المسجلات: &متجه معرف_دالة_مسير
): اختياري خطأ_خفض_مسير {
    إذا ((الطول(*المسجلات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع د: طبيعي = الدالة.القيمة;
    دع الوجهة: معرف_كتلة_مسير;
    طابق (*البرنامج).الدوال[د].الكتل[0].المنهي مع
    | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> { الوجهة := الحافة.الهدف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الكتلة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(البرنامج, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(ك) -> { الكتلة := ك; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسجلات) مثل طبيعي)) {
        طابق أصدر_نداء_مسير(البرنامج, &البناء, الدالة, الكتلة, (*المسجلات)[ف], &بلا_حجج) مع
        | نتيجة_بناء_قيمة_مسير.مرفوضة(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
        | _ -> { };
        ف := ف + 1;
    }
    طابق اختم_بفرع_مسير(البرنامج, الدالة, الكتلة, الوجهة, &بلا_حجج) مع
    | نتيجة_بناء_منهي_مسير.مرفوض(الخطأ) -> { أرجع اختياري.موجود(خطأ_خفض_مسير.بناء_مسير_مرفوض(الخطأ)); }
    | _ -> { };
    دع الحافة: حافة_مسير = { الهدف: الكتلة, الحجج: بلا_حجج };
    (*البرنامج).الدوال[د].الكتل[0].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة));
    أرجع اختياري.لا_شيء();
}
