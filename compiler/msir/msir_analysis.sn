استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;

// حقائق تحليل MSIR المشتقة من الكتل والحواف المقننة. لا يملك هذا الملف سياسة verifier
// ولا ينشئ CFG موازيا؛ النتائج فهارس/علاقات مشتقة فقط من النموذج المقنن.
عام نوع تحليل_هيمنة_مسير = {
    قابل_للوصول: متجه منطقي,
    المهيمن_المباشر: متجه اختياري معرف_كتلة_مسير,
    بداية_هيمنة: متجه طبيعي,
    نهاية_هيمنة: متجه طبيعي
};

عرف ألحق_هدف_إن_جديد(
    الأهداف: &متغير متجه معرف_كتلة_مسير,
    الهدف: معرف_كتلة_مسير
): منطقي {
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الأهداف) مثل طبيعي;
    طالما (ف < العدد) {
        // كتلتان_مسير_متساويتان, written out: a switch's successors are
        // checked pairwise.
        دع الموجود: &معرف_كتلة_مسير = &(*الأهداف)[ف];
        إذا ((*الموجود).القيمة == الهدف.القيمة && (*الموجود).الدالة.القيمة == الهدف.الدالة.القيمة) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    ألحق(*الأهداف, الهدف);
    أرجع صواب;
}

عام عرف خلفاء_كتلة_مسير(الكتلة: &كتلة_مسير): متجه معرف_كتلة_مسير {
    دع الناتج: متغير متجه معرف_كتلة_مسير = [];
    طابق (*الكتلة).المنهي مع
    | اختياري.لا_شيء -> {
    }
    | اختياري.موجود(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            ألحق_هدف_إن_جديد(&متغير الناتج, الحافة.الهدف);
        }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            ألحق_هدف_إن_جديد(&متغير الناتج, عند_الصواب.الهدف);
            ألحق_هدف_إن_جديد(&متغير الناتج, عند_الخطأ.الهدف);
        }
        | منهي_مسير.فرع_متعدد(الفرع) -> {
            ألحق_هدف_إن_جديد(&متغير الناتج, الفرع.الافتراضي.الهدف);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                ألحق_هدف_إن_جديد(&متغير الناتج, الفرع.الحالات[ف].الحافة.الهدف);
                ف := ف + 1;
            }
        }
        | منهي_مسير.إرجاع(_) -> {
        }
        | منهي_مسير.فخ -> {
        };
    };
    أرجع الناتج;
}

عرف علّم_الوصول(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير,
    الأعلام: &متغير متجه منطقي
): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الأعلام) مثل طبيعي)) {
        أرجع خطأ;
    };
    إذا ((*الأعلام)[المعرف.القيمة]) {
        أرجع خطأ;
    };
    // A worklist, not recursion: a function with tens of thousands of
    // blocks in a chain would otherwise need as many stack frames.
    (*الأعلام)[المعرف.القيمة] := صواب;
    دع المعلقة: متغير متجه معرف_كتلة_مسير = [المعرف];
    طالما ((الطول(المعلقة) مثل طبيعي) > 0) {
        دع الكتلة: معرف_كتلة_مسير;
        طابق أزل_الأخير(المعلقة) مع
        | اختياري.موجود(القيمة) -> { الكتلة := القيمة; }
        | اختياري.لا_شيء -> { أرجع صواب; };
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[الكتلة.القيمة]);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الخلفاء) مثل طبيعي)) {
            دع الخلف: معرف_كتلة_مسير = الخلفاء[ف];
            إذا ((الخلف.القيمة مثل طبيعي) < (الطول(*الأعلام) مثل طبيعي) && !(*الأعلام)[الخلف.القيمة]) {
                (*الأعلام)[الخلف.القيمة] := صواب;
                ألحق(المعلقة, الخلف);
            };
            ف := ف + 1;
        }
    }
    أرجع صواب;
}

عام عرف الكتل_القابلة_للوصول_مسير(الدالة: &دالة_مسير): متجه منطقي {
    دع الأعلام: متغير متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        ألحق(الأعلام, خطأ);
        ك := ك + 1;
    }
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        علّم_الوصول(الدالة, المدخل, &متغير الأعلام);
    }
    | اختياري.لا_شيء -> {
    };
    أرجع الأعلام;
}

عام عرف عدد_تعريفات_قيم_مسير(الدالة: &دالة_مسير): طبيعي {
    دع العدد: متغير طبيعي = الطول((*الدالة).المعاملات) مثل طبيعي;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        العدد := العدد + (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي);
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
            | اختياري.موجود(_) -> {
                العدد := العدد + 1;
            }
            | اختياري.لا_شيء -> {
            }
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدد;
}

عرف زد_استخدام_مسير(المعرف: معرف_قيمة_مسير, الاستخدامات: &متغير متجه طبيعي): منطقي {
    إذا ((المعرف.القيمة مثل طبيعي) < (الطول(*الاستخدامات) مثل طبيعي)) {
        (*الاستخدامات)[المعرف.القيمة] := (*الاستخدامات)[المعرف.القيمة] + 1;
    };
    أرجع صواب;
}

عرف عد_استخدامات_عملية_مسير(
    العملية: &عملية_مسير,
    الاستخدامات: &متغير متجه طبيعي
): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> {
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        زد_استخدام_مسير(ح.اليسار, الاستخدامات);
        زد_استخدام_مسير(ح.اليمين, الاستخدامات);
    }
    | عملية_مسير.حساب_عشري(ح) -> {
        زد_استخدام_مسير(ح.اليسار, الاستخدامات);
        زد_استخدام_مسير(ح.اليمين, الاستخدامات);
    }
    | عملية_مسير.مقارنة_عشري(م) -> {
        زد_استخدام_مسير(م.اليسار, الاستخدامات);
        زد_استخدام_مسير(م.اليمين, الاستخدامات);
    }
    | عملية_مسير.مقارنة_صحيح(م) -> {
        زد_استخدام_مسير(م.اليسار, الاستخدامات);
        زد_استخدام_مسير(م.اليمين, الاستخدامات);
    }
    | عملية_مسير.تحويل_صحيح(ح) -> {
        زد_استخدام_مسير(ح.المصدر, الاستخدامات);
    }
    | عملية_مسير.تحويل_عائم(ح) -> {
        زد_استخدام_مسير(ح.المصدر, الاستخدامات);
    }
    | عملية_مسير.نقل_تسلسل_مملوك(ح) -> {
        زد_استخدام_مسير(ح.المصدر, الاستخدامات);
    }
    | عملية_مسير.مرجع_إلى_مؤشر(ح) -> {
        زد_استخدام_مسير(ح.المرجع, الاستخدامات);
    }
    | عملية_مسير.تجميع(ت) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ت.الأعضاء) مثل طبيعي)) {
            زد_استخدام_مسير(ت.الأعضاء[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.تهيئة_متجه(ت) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ت.العناصر) مثل طبيعي)) {
            زد_استخدام_مسير(ت.العناصر[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.استخراج_حقل(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.استخراج_فهرس(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
        زد_استخدام_مسير(ا.الفهرس, الاستخدامات);
    }
    | عملية_مسير.مكان_محلي(_) -> {
    }
    | عملية_مسير.مكان_عام(_) -> {
    }
    | عملية_مسير.مرجع_إلى_مكان(م) -> {
        زد_استخدام_مسير(م.المرجع, الاستخدامات);
    }
    | عملية_مسير.صندوق_إلى_مكان(م) -> {
        زد_استخدام_مسير(م.الصندوق, الاستخدامات);
    }
    | عملية_مسير.مكان_حقل(م) -> {
        زد_استخدام_مسير(م.الأصل, الاستخدامات);
    }
    | عملية_مسير.مكان_فهرس(م) -> {
        زد_استخدام_مسير(م.الأصل, الاستخدامات);
        زد_استخدام_مسير(م.الفهرس, الاستخدامات);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(م) -> {
        زد_استخدام_مسير(م.المؤشر, الاستخدامات);
        زد_استخدام_مسير(م.الفهرس, الاستخدامات);
    }
    | عملية_مسير.تحميل(ت) -> {
        زد_استخدام_مسير(ت.المكان, الاستخدامات);
    }
    | عملية_مسير.تخزين(ت) -> {
        زد_استخدام_مسير(ت.المكان, الاستخدامات);
        زد_استخدام_مسير(ت.القيمة, الاستخدامات);
    }
    | عملية_مسير.مكان_إلى_مرجع(م) -> {
        زد_استخدام_مسير(م.المكان, الاستخدامات);
    }
    | عملية_مسير.بناء_موسوم(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الحمولات) مثل طبيعي)) {
            زد_استخدام_مسير(ب.الحمولات[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.استعلام_وسم(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.استخراج_حمولة(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.بناء_صندوق(ب) -> {
        زد_استخدام_مسير(ب.القيمة, الاستخدامات);
    }
    | عملية_مسير.بناء_إغلاق(ب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ب.الالتقاطات) مثل طبيعي)) {
            زد_استخدام_مسير(ب.الالتقاطات[ف], الاستخدامات); ف := ف + 1;
        }
    }
    | عملية_مسير.استخراج_التقاط(_) -> { }
    | عملية_مسير.نداء(ن) -> {
        طابق ن.الهدف مع
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> { زد_استخدام_مسير(الدالة_القيمة, الاستخدامات); }
        | _ -> { };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ن.الحجج) مثل طبيعي)) {
            زد_استخدام_مسير(ن.الحجج[ف], الاستخدامات);
            ف := ف + 1;
        }
        طابق ن.مكان_التعديل مع
        | اختياري.موجود(المكان) -> { زد_استخدام_مسير(المكان, الاستخدامات); }
        | اختياري.لا_شيء -> { };
        طابق ن.عقد_النواة مع
        | اختياري.موجود(العقد) -> { زد_استخدام_مسير(العقد.الرقم, الاستخدامات); }
        | اختياري.لا_شيء -> { };
        دع فهرس_النطاق: متغير طبيعي = 0;
        طالما (فهرس_النطاق < (الطول(ن.نطاقات_الذاكرة) مثل طبيعي)) {
            دع النطاق: نطاق_ذاكرة_نداء_مسير = ن.نطاقات_الذاكرة[فهرس_النطاق];
            زد_استخدام_مسير(النطاق.المؤشر, الاستخدامات);
            زد_استخدام_مسير(النطاق.الأصل, الاستخدامات);
            زد_استخدام_مسير(النطاق.الطول, الاستخدامات);
            طابق النطاق.المطلوب مع
            | اختياري.موجود(المعرف) -> { زد_استخدام_مسير(المعرف, الاستخدامات); }
            | اختياري.لا_شيء -> { };
            فهرس_النطاق := فهرس_النطاق + 1;
        }
    };
    أرجع صواب;
}

عرف عد_استخدامات_حافة_مسير(
    الحافة: &حافة_مسير,
    الاستخدامات: &متغير متجه طبيعي
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحافة).الحجج) مثل طبيعي)) {
        زد_استخدام_مسير((*الحافة).الحجج[ف], الاستخدامات);
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف جدول_استخدامات_قيم_مسير(الدالة: &دالة_مسير): متجه طبيعي {
    أرجع جدول_استخدامات_قيم_مسير_بحجم(الدالة, عدد_تعريفات_قيم_مسير(الدالة));
}

// The use counts of value IDs below العدد (a function whose IDs are not dense
// after deletions passes its next free ID).
عام عرف جدول_استخدامات_قيم_مسير_بحجم(الدالة: &دالة_مسير, العدد: طبيعي): متجه طبيعي {
    دع الاستخدامات: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الاستخدامات, 0);
        ف := ف + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            عد_استخدامات_عملية_مسير(
                &(*الدالة).الكتل[ك].التعليمات[ت].العملية,
                &متغير الاستخدامات
            );
            ت := ت + 1;
        }
        طابق (*الدالة).الكتل[ك].المنهي مع
        | اختياري.لا_شيء -> {
        }
        | اختياري.موجود(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                عد_استخدامات_حافة_مسير(&الحافة, &متغير الاستخدامات);
            }
            | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
                زد_استخدام_مسير(الشرط, &متغير الاستخدامات);
                عد_استخدامات_حافة_مسير(&عند_الصواب, &متغير الاستخدامات);
                عد_استخدامات_حافة_مسير(&عند_الخطأ, &متغير الاستخدامات);
            }
            | منهي_مسير.فرع_متعدد(الفرع) -> {
                زد_استخدام_مسير(الفرع.المميز, &متغير الاستخدامات);
                عد_استخدامات_حافة_مسير(&الفرع.الافتراضي, &متغير الاستخدامات);
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                    عد_استخدامات_حافة_مسير(&الفرع.الحالات[ف].الحافة, &متغير الاستخدامات);
                    ف := ف + 1;
                }
            }
            | منهي_مسير.إرجاع(القيمة) -> {
                طابق القيمة مع
                | اختياري.لا_شيء -> {
                }
                | اختياري.موجود(المعرف) -> {
                    زد_استخدام_مسير(المعرف, &متغير الاستخدامات);
                };
            }
            | منهي_مسير.فخ -> {
            };
        };
        ك := ك + 1;
    }
    أرجع الاستخدامات;
}

// Loads a native backend may read through the place instead of copying the
// whole value first (the selectors alias the loaded value to the place).
// Every use of the loaded value must read part of it (a field, an element,
// the tag or a payload, the length or capacity primitive), in the load's
// block after it or in blocks entered only from there (a bounds check's
// in-bounds block), with nothing that may write memory (a store or a call
// other than those primitives) between the load and the use. The value then
// equals the place's contents wherever it is read. Indexed by value ID.
عام عرف تحميلات_للطول_فقط_مسير(الدالة: &دالة_مسير): متجه منطقي {
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع الناتج: متغير متجه منطقي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, خطأ); ف := ف + 1; }
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير_بحجم(الدالة, العدد);
    دع عدد_الكتل: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    // Edges into each block (block identities are positions here).
    دع الأسلاف: متغير متجه طبيعي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكتل) { ألحق(الأسلاف, 0); ك := ك + 1; }
    ك := 0;
    طالما (ك < عدد_الكتل) {
        إذا (((*الدالة).الكتل[ك].المعرف.القيمة مثل طبيعي) != ك) { أرجع الناتج; };
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            إذا ((الخلفاء[خ].القيمة مثل طبيعي) < عدد_الكتل) {
                الأسلاف[الخلفاء[خ].القيمة] := الأسلاف[الخلفاء[خ].القيمة] + 1;
            };
            خ := خ + 1;
        }
        ك := ك + 1;
    }
    دع زيارة: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكتل) { ألحق(زيارة, 0); ك := ك + 1; }
    دع جولة: متغير طبيعي = 0;
    ك := 0;
    طالما (ك < عدد_الكتل) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.تحميل(_) -> {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ت]) مع
                | اختياري.موجود(المحمل) -> {
                    دع رقم: طبيعي = المحمل.المعرف.القيمة;
                    إذا (رقم < العدد && الاستخدامات[رقم] >= 1) {
                        جولة := جولة + 1;
                        الناتج[رقم] := قراءات_بلا_كتابة_مسير(
                            الدالة, ك, ت, رقم, الاستخدامات[رقم], &الأسلاف, &متغير زيارة, جولة
                        );
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

// How many times the instruction reads part of value القيمة (0 for any
// other use, which the caller's count then misses).
عرف قراءة_جزئية_مسير(العملية: &عملية_مسير, القيمة: طبيعي): طبيعي {
    طابق *العملية مع
    | عملية_مسير.استخراج_حقل(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { أرجع 1; }; }
    | عملية_مسير.استخراج_فهرس(ا) -> {
        إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة && (ا.الفهرس.القيمة مثل طبيعي) != القيمة) { أرجع 1; };
    }
    | عملية_مسير.استعلام_وسم(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { أرجع 1; }; }
    | عملية_مسير.استخراج_حمولة(ا) -> { إذا ((ا.المصدر.القيمة مثل طبيعي) == القيمة) { أرجع 1; }; }
    | عملية_مسير.نداء(النداء) -> {
        إذا (نداء_قراءة_فقط_مسير(&النداء) && (الطول(النداء.الحجج) مثل طبيعي) == 1
            && (النداء.الحجج[0].القيمة مثل طبيعي) == القيمة) { أرجع 1; };
    }
    | _ -> { };
    أرجع 0;
}

// The length and capacity primitives only read their operand.
عرف نداء_قراءة_فقط_مسير(النداء: &نداء_مسير): منطقي {
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
        طابق الهوية مع
        | هوية_بدائي_مترجم.طول -> { أرجع صواب; }
        | هوية_بدائي_مترجم.سعة_متجه -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

// Whether the operation may write memory that a place holds.
عرف عملية_قد_تكتب_مسير(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.تخزين(_) -> { أرجع صواب; }
    | عملية_مسير.نقل_تسلسل_مملوك(_) -> { أرجع صواب; }
    | عملية_مسير.نداء(النداء) -> { أرجع !نداء_قراءة_فقط_مسير(&النداء); }
    | _ -> { أرجع خطأ; };
}

// The search behind تحميلات_للطول_فقط_مسير for one load: a walk of the
// blocks entered only from the load's block (and from each other), each with
// whether a writer was passed on its path; زيارة marks blocks with الجولة.
عرف قراءات_بلا_كتابة_مسير(
    الدالة: &دالة_مسير,
    الكتلة: طبيعي,
    الموضع: طبيعي,
    القيمة: طبيعي,
    المطلوب: طبيعي,
    الأسلاف: &متجه طبيعي,
    زيارة: &متغير متجه طبيعي,
    الجولة: طبيعي
): منطقي {
    دع الوجدت: متغير طبيعي = 0;
    دع الفحوص: متغير طبيعي = 0;
    دع كتل_العمل: متغير متجه طبيعي = [الكتلة];
    دع بدايات_العمل: متغير متجه طبيعي = [الموضع + 1];
    دع كتابات_العمل: متغير متجه منطقي = [خطأ];
    (*زيارة)[الكتلة] := الجولة;
    طالما ((الطول(كتل_العمل) مثل طبيعي) > 0) {
        دع الأخير: طبيعي = (الطول(كتل_العمل) مثل طبيعي) - 1;
        دع ك: طبيعي = كتل_العمل[الأخير];
        دع البداية: طبيعي = بدايات_العمل[الأخير];
        دع كتب: متغير منطقي = كتابات_العمل[الأخير];
        اقتطع(كتل_العمل, الأخير);
        اقتطع(بدايات_العمل, الأخير);
        اقتطع(كتابات_العمل, الأخير);
        دع ت: متغير طبيعي = البداية;
        طالما (ت < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            الفحوص := الفحوص + 1;
            إذا (الفحوص > 256) { أرجع خطأ; };
            دع العملية: &عملية_مسير = &(*الدالة).الكتل[ك].التعليمات[ت].العملية;
            دع ن: طبيعي = قراءة_جزئية_مسير(العملية, القيمة);
            إذا (ن > 0) {
                إذا (كتب) { أرجع خطأ; };
                الوجدت := الوجدت + ن;
                إذا (الوجدت == المطلوب) { أرجع صواب; };
            };
            إذا (عملية_قد_تكتب_مسير(العملية)) { كتب := صواب; };
            ت := ت + 1;
        }
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع خ: متغير طبيعي = 0;
        طالما (خ < (الطول(الخلفاء) مثل طبيعي)) {
            دع س: طبيعي = الخلفاء[خ].القيمة;
            إذا (س < (الطول(*الأسلاف) مثل طبيعي) && (*الأسلاف)[س] == 1 && (*زيارة)[س] != الجولة) {
                (*زيارة)[س] := الجولة;
                ألحق(كتل_العمل, س);
                ألحق(بدايات_العمل, 0);
                ألحق(كتابات_العمل, كتب);
            };
            خ := خ + 1;
        }
    }
    أرجع الوجدت == المطلوب;
}

// تبني هذه الدالة ترتيب ما بعد العمق دون تخزين مصفوفة مهيمنات مربعة.
عرف ابن_ترتيب_ما_بعد_الهيمنة(
    كل_الخلفاء: &متجه متجه معرف_كتلة_مسير,
    الكتلة: معرف_كتلة_مسير,
    المرئي: &متغير متجه منطقي,
    الترتيب: &متغير متجه معرف_كتلة_مسير
): منطقي {
    إذا ((الكتلة.القيمة مثل طبيعي) >= (الطول(*المرئي) مثل طبيعي)) { أرجع خطأ; };
    إذا ((*المرئي)[الكتلة.القيمة]) { أرجع صواب; };
    // Depth-first with an explicit stack of (block, next successor), the
    // same visiting order and post-order as the recursive walk it replaces.
    (*المرئي)[الكتلة.القيمة] := صواب;
    دع الكتل: متغير متجه معرف_كتلة_مسير = [الكتلة];
    دع التالي: متغير متجه طبيعي = [0];
    طالما ((الطول(الكتل) مثل طبيعي) > 0) {
        دع القمة: طبيعي = (الطول(الكتل) مثل طبيعي) - 1;
        دع الحالية: معرف_كتلة_مسير = الكتل[القمة];
        // Each block's successors, computed once by the caller.
        دع الخلفاء: &متجه معرف_كتلة_مسير = &(*كل_الخلفاء)[الحالية.القيمة];
        إذا (التالي[القمة] < (الطول(*الخلفاء) مثل طبيعي)) {
            دع الخلف: معرف_كتلة_مسير = (*الخلفاء)[التالي[القمة]];
            التالي[القمة] := التالي[القمة] + 1;
            إذا ((الخلف.القيمة مثل طبيعي) < (الطول(*المرئي) مثل طبيعي) && !(*المرئي)[الخلف.القيمة]) {
                (*المرئي)[الخلف.القيمة] := صواب;
                ألحق(الكتل, الخلف);
                ألحق(التالي, 0);
            };
        } وإلا {
            ألحق(*الترتيب, الحالية);
            دع تجاهل_كتلة: اختياري معرف_كتلة_مسير = أزل_الأخير(الكتل);
            دع تجاهل_موضع: اختياري طبيعي = أزل_الأخير(التالي);
        };
    }
    أرجع صواب;
}

// Cooper-Harvey-Kennedy: تقاطع سلسلتي المهيمن المباشر بترتيب DFS العكسي.
عرف تقاطع_مهيمنات_مسير(
    البداية: معرف_كتلة_مسير,
    الأخرى: معرف_كتلة_مسير,
    المباشر: &متجه اختياري معرف_كتلة_مسير,
    الرتب: &متجه طبيعي
): اختياري معرف_كتلة_مسير {
    دع أ: متغير معرف_كتلة_مسير = البداية;
    دع ب: متغير معرف_كتلة_مسير = الأخرى;
    طالما (!كتلتان_مسير_متساويتان(أ, ب)) {
        طالما ((*الرتب)[أ.القيمة] > (*الرتب)[ب.القيمة]) {
            طابق (*المباشر)[أ.القيمة] مع
            | اختياري.موجود(الأب) -> { أ := الأب; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        }
        طالما ((*الرتب)[ب.القيمة] > (*الرتب)[أ.القيمة]) {
            طابق (*المباشر)[ب.القيمة] مع
            | اختياري.موجود(الأب) -> { ب := الأب; }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        }
    }
    أرجع اختياري.موجود(أ);
}

// ترقيم دخـول وخروج شجرة الهيمنة يتيح اختبار الهيمنة في وقت ثابت.
عرف رقّم_شجرة_هيمنة_مسير(
    الكتلة: معرف_كتلة_مسير,
    الأبناء: &متجه متجه معرف_كتلة_مسير,
    البداية: &متغير متجه طبيعي,
    النهاية: &متغير متجه طبيعي,
    الساعة: &متغير طبيعي
): منطقي {
    // Entry and exit numbers with an explicit stack: the dominator tree of a
    // long chain of blocks is as deep as the chain.
    *الساعة := *الساعة + 1;
    (*البداية)[الكتلة.القيمة] := *الساعة;
    دع العقد: متغير متجه معرف_كتلة_مسير = [الكتلة];
    دع التالي: متغير متجه طبيعي = [0];
    طالما ((الطول(العقد) مثل طبيعي) > 0) {
        دع القمة: طبيعي = (الطول(العقد) مثل طبيعي) - 1;
        دع الحالية: معرف_كتلة_مسير = العقد[القمة];
        إذا (التالي[القمة] < (الطول((*الأبناء)[الحالية.القيمة]) مثل طبيعي)) {
            دع الابن: معرف_كتلة_مسير = (*الأبناء)[الحالية.القيمة][التالي[القمة]];
            التالي[القمة] := التالي[القمة] + 1;
            *الساعة := *الساعة + 1;
            (*البداية)[الابن.القيمة] := *الساعة;
            ألحق(العقد, الابن);
            ألحق(التالي, 0);
        } وإلا {
            (*النهاية)[الحالية.القيمة] := *الساعة;
            دع تجاهل_عقدة: اختياري معرف_كتلة_مسير = أزل_الأخير(العقد);
            دع تجاهل_موضع: اختياري طبيعي = أزل_الأخير(التالي);
        };
    }
    أرجع صواب;
}

عام عرف حلل_هيمنة_مسير(الدالة: &دالة_مسير): تحليل_هيمنة_مسير {
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(الدالة);
    دع العدد: طبيعي = الطول((*الدالة).الكتل) مثل طبيعي;
    دع الأسلاف: متغير متجه متجه معرف_كتلة_مسير = [];
    دع المباشر: متغير متجه اختياري معرف_كتلة_مسير = [];
    دع الرتب: متغير متجه طبيعي = [];
    دع البداية: متغير متجه طبيعي = [];
    دع النهاية: متغير متجه طبيعي = [];
    دع كل_الخلفاء: متغير متجه متجه معرف_كتلة_مسير = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < العدد) {
        دع صف: متجه معرف_كتلة_مسير = [];
        ألحق(الأسلاف, صف);
        ألحق(المباشر, اختياري.لا_شيء());
        ألحق(الرتب, العدد);
        ألحق(البداية, 0);
        ألحق(النهاية, 0);
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < العدد) {
        دع المصدر: معرف_كتلة_مسير = (*الدالة).الكتل[ك].المعرف;
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&(*الدالة).الكتل[ك]);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الخلفاء) مثل طبيعي)) {
            دع الهدف: معرف_كتلة_مسير = الخلفاء[ف];
            إذا ((الهدف.القيمة مثل طبيعي) < العدد) {
                ألحق(الأسلاف[الهدف.القيمة], المصدر);
            };
            ف := ف + 1;
        }
        ألحق(كل_الخلفاء, الخلفاء);
        ك := ك + 1;
    }
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المدخل) -> {
        إذا ((المدخل.القيمة مثل طبيعي) < العدد) {
            دع المرئي: متغير متجه منطقي = [];
            ك := 0;
            طالما (ك < العدد) { ألحق(المرئي, خطأ); ك := ك + 1; }
            دع ما_بعد: متغير متجه معرف_كتلة_مسير = [];
            ابن_ترتيب_ما_بعد_الهيمنة(&كل_الخلفاء, المدخل, &متغير المرئي, &متغير ما_بعد);
            دع العكسي: متغير متجه معرف_كتلة_مسير = [];
            ك := الطول(ما_بعد) مثل طبيعي;
            طالما (ك > 0) {
                ك := ك - 1;
                ألحق(العكسي, ما_بعد[ك]);
                الرتب[ما_بعد[ك].القيمة] := الطول(العكسي) مثل طبيعي;
            }
            // المدخل يهيمن على نفسه أثناء حل المعادلات، ويستثنى من الناتج النهائي.
            المباشر[المدخل.القيمة] := اختياري.موجود(المدخل);
            دع تغير: متغير منطقي = صواب;
            طالما (تغير) {
                تغير := خطأ;
                ك := 1;
                طالما (ك < (الطول(العكسي) مثل طبيعي)) {
                    دع الكتلة: معرف_كتلة_مسير = العكسي[ك];
                    دع المرشح: متغير اختياري معرف_كتلة_مسير = اختياري.لا_شيء();
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < (الطول(الأسلاف[الكتلة.القيمة]) مثل طبيعي)) {
                        دع السلف: معرف_كتلة_مسير = الأسلاف[الكتلة.القيمة][ف];
                        إذا ((السلف.القيمة مثل طبيعي) < العدد && الوصول[السلف.القيمة]) {
                            طابق المباشر[السلف.القيمة] مع
                            | اختياري.موجود(_) -> {
                                طابق المرشح مع
                                | اختياري.موجود(الموجود) -> {
                                    المرشح := تقاطع_مهيمنات_مسير(الموجود, السلف, &المباشر, &الرتب);
                                }
                                | اختياري.لا_شيء -> { المرشح := اختياري.موجود(السلف); };
                            }
                            | اختياري.لا_شيء -> { };
                        };
                        ف := ف + 1;
                    }
                    طابق المرشح مع
                    | اختياري.موجود(الجديد) -> {
                        دع مختلف: متغير منطقي = صواب;
                        طابق المباشر[الكتلة.القيمة] مع
                        | اختياري.موجود(القديم) -> { مختلف := !كتلتان_مسير_متساويتان(القديم, الجديد); }
                        | اختياري.لا_شيء -> { };
                        إذا (مختلف) {
                            المباشر[الكتلة.القيمة] := اختياري.موجود(الجديد);
                            تغير := صواب;
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ك := ك + 1;
                }
            }
            دع الأبناء: متغير متجه متجه معرف_كتلة_مسير = [];
            ك := 0;
            طالما (ك < العدد) {
                دع صف: متجه معرف_كتلة_مسير = [];
                ألحق(الأبناء, صف);
                ك := ك + 1;
            }
            ك := 1;
            طالما (ك < (الطول(العكسي) مثل طبيعي)) {
                دع الكتلة: معرف_كتلة_مسير = العكسي[ك];
                طابق المباشر[الكتلة.القيمة] مع
                | اختياري.موجود(الأب) -> { ألحق(الأبناء[الأب.القيمة], الكتلة); }
                | اختياري.لا_شيء -> { };
                ك := ك + 1;
            }
            دع الساعة: متغير طبيعي = 0;
            رقّم_شجرة_هيمنة_مسير(المدخل, &الأبناء, &متغير البداية, &متغير النهاية, &متغير الساعة);
            المباشر[المدخل.القيمة] := اختياري.لا_شيء();
        };
    }
    | اختياري.لا_شيء -> { };
    دع الناتج: تحليل_هيمنة_مسير = {
        قابل_للوصول: الوصول,
        المهيمن_المباشر: المباشر,
        بداية_هيمنة: البداية,
        نهاية_هيمنة: النهاية
    };
    أرجع الناتج;
}

عام عرف كتلة_تهيمن_على(
    التحليل: &تحليل_هيمنة_مسير,
    المهيمنة: معرف_كتلة_مسير,
    التابعة: معرف_كتلة_مسير
): منطقي {
    إذا ((التابعة.القيمة مثل طبيعي) >= (الطول((*التحليل).بداية_هيمنة) مثل طبيعي)
        || (المهيمنة.القيمة مثل طبيعي) >= (الطول((*التحليل).بداية_هيمنة) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع أول: طبيعي = (*التحليل).بداية_هيمنة[المهيمنة.القيمة];
    دع ثان: طبيعي = (*التحليل).بداية_هيمنة[التابعة.القيمة];
    أرجع أول != 0 && ثان != 0 && أول <= ثان
        && (*التحليل).نهاية_هيمنة[التابعة.القيمة] <= (*التحليل).نهاية_هيمنة[المهيمنة.القيمة];
}
