استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;

// حقائق تحليل MSIR المشتقة من الكتل والحواف المقننة. لا يملك هذا الملف سياسة verifier
// ولا ينشئ CFG موازيا؛ النتائج فهارس/علاقات مشتقة فقط من النموذج المقنن.
عام نوع تحليل_هيمنة_مسير = {
    قابل_للوصول: متجه منطقي,
    المهيمنات: متجه متجه منطقي,
    المهيمن_المباشر: متجه اختيار معرف_كتلة_مسير
};

عام عرف مدخل_دالة_مسير(الدالة: دالة_مسير): اختيار معرف_كتلة_مسير {
    دع الحالة: دالة_مسير = الدالة;
    أرجع الحالة.المدخل;
}

عام عرف ابحث_كتلة_مسير_في_دالة(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير
): اختيار كتلة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    لو (!كتلة_مسير_موجودة(&الحالة, المعرف)) {
        أرجع اختيار.لا_شيء();
    };
    دع مرجع_الكتلة: &كتلة_مسير = &الحالة.الكتل[المعرف.القيمة];
    أرجع اختيار.بعض(*مرجع_الكتلة);
}

عرف ألحق_هدف_إن_جديد(
    الأهداف: &متغير متجه معرف_كتلة_مسير,
    الهدف: معرف_كتلة_مسير
): منطقي {
    دع الحالة: متجه معرف_كتلة_مسير = *الأهداف;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        لو (كتلتان_مسير_متساويتان(الحالة[ف], الهدف)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    دع الجديد: متغير متجه معرف_كتلة_مسير = الحالة;
    ألحق(الجديد, الهدف);
    *الأهداف := الجديد;
    أرجع صواب;
}

عام عرف هدف_حافة_مسير(الحافة: &حافة_مسير): معرف_كتلة_مسير {
    دع الحالة: حافة_مسير = *الحافة;
    أرجع الحالة.الهدف;
}

عام عرف حجة_حافة_مسير_عند(
    الحافة: &حافة_مسير,
    الفهرس: غير_موقع
): اختيار معرف_قيمة_مسير {
    دع الحالة: حافة_مسير = *الحافة;
    لو (الفهرس >= (الطول(الحالة.الحجج) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(الحالة.الحجج[الفهرس]);
}

عام عرف خلفاء_كتلة_مسير(الكتلة: &كتلة_مسير): متجه معرف_كتلة_مسير {
    دع الناتج: متغير متجه معرف_كتلة_مسير = [];
    دع الحالة: كتلة_مسير = *الكتلة;
    طابق الحالة.المنهي مع
    | اختيار.لا_شيء -> {
    }
    | اختيار.بعض(المنهي) -> {
        طابق المنهي مع
        | منهي_مسير.فرع(الحافة) -> {
            ألحق_هدف_إن_جديد(&متغير الناتج, الحافة.الهدف);
        }
        | منهي_مسير.فرع_شرطي(_, عند_الصواب, عند_الخطأ) -> {
            ألحق_هدف_إن_جديد(&متغير الناتج, عند_الصواب.الهدف);
            ألحق_هدف_إن_جديد(&متغير الناتج, عند_الخطأ.الهدف);
        }
        | منهي_مسير.إرجاع(_) -> {
        }
        | منهي_مسير.فخ -> {
        };
    };
    أرجع الناتج;
}

عام عرف أسلاف_كتلة_مسير(
    الدالة: &دالة_مسير,
    الهدف: معرف_كتلة_مسير
): متجه معرف_كتلة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع الناتج: متغير متجه معرف_كتلة_مسير = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&الحالة.الكتل[ك]);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الخلفاء) مثل غير_موقع)) {
            لو (كتلتان_مسير_متساويتان(الخلفاء[ف], الهدف)) {
                ألحق(الناتج, الحالة.الكتل[ك].المعرف);
            };
            ف := ف + 1;
        }
        ك := ك + 1;
    }
    أرجع الناتج;
}

عرف علّم_الوصول(
    الدالة: &دالة_مسير,
    المعرف: معرف_كتلة_مسير,
    الأعلام: &متغير متجه منطقي
): منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع القيم: متغير متجه منطقي = *الأعلام;
    لو (المعرف.القيمة >= (الطول(القيم) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو (القيم[المعرف.القيمة]) {
        أرجع خطأ;
    };
    القيم[المعرف.القيمة] := صواب;
    *الأعلام := القيم;
    دع الخلفاء: متجه معرف_كتلة_مسير = خلفاء_كتلة_مسير(&الحالة.الكتل[المعرف.القيمة]);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الخلفاء) مثل غير_موقع)) {
        علّم_الوصول(&الحالة, الخلفاء[ف], الأعلام);
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف انسخ_صف_منطقي_مسير(الصف: &متجه منطقي): متجه منطقي {
    دع المصدر: متجه منطقي = *الصف;
    دع الناتج: متغير متجه منطقي = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف الكتل_القابلة_للوصول_مسير(الدالة: &دالة_مسير): متجه منطقي {
    دع الحالة: دالة_مسير = *الدالة;
    دع الأعلام: متغير متجه منطقي = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        ألحق(الأعلام, خطأ);
        ك := ك + 1;
    }
    طابق الحالة.المدخل مع
    | اختيار.بعض(المدخل) -> {
        علّم_الوصول(&الحالة, المدخل, &متغير الأعلام);
    }
    | اختيار.لا_شيء -> {
    };
    أرجع الأعلام;
}

عام عرف ترتيب_الوصول_مسير(الدالة: &دالة_مسير): متجه معرف_كتلة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(&الحالة);
    دع الناتج: متغير متجه معرف_كتلة_مسير = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        لو (الوصول[ك]) {
            ألحق(الناتج, الحالة.الكتل[ك].المعرف);
        };
        ك := ك + 1;
    }
    أرجع الناتج;
}

عام عرف عدد_تعريفات_قيم_مسير(الدالة: &دالة_مسير): غير_موقع {
    دع الحالة: دالة_مسير = *الدالة;
    دع العدد: متغير غير_موقع = الطول(الحالة.المعاملات) مثل غير_موقع;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        العدد := العدد + (الطول(الحالة.الكتل[ك].المعاملات) مثل غير_موقع);
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل غير_موقع)) {
            طابق الحالة.الكتل[ك].التعليمات[ت].الناتج مع
            | اختيار.بعض(_) -> {
                العدد := العدد + 1;
            }
            | اختيار.لا_شيء -> {
            }
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدد;
}

عرف زد_استخدام_مسير(المعرف: معرف_قيمة_مسير, الاستخدامات: &متغير متجه غير_موقع): منطقي {
    دع الحالة: متغير متجه غير_موقع = *الاستخدامات;
    لو (المعرف.القيمة < (الطول(الحالة) مثل غير_موقع)) {
        الحالة[المعرف.القيمة] := الحالة[المعرف.القيمة] + 1;
        *الاستخدامات := الحالة;
    };
    أرجع صواب;
}

عرف عد_استخدامات_عملية_مسير(
    العملية: &عملية_مسير,
    الاستخدامات: &متغير متجه غير_موقع
): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> {
    }
    | عملية_مسير.حساب_صحيح(ح) -> {
        زد_استخدام_مسير(ح.اليسار, الاستخدامات);
        زد_استخدام_مسير(ح.اليمين, الاستخدامات);
    }
    | عملية_مسير.حساب_عشري(ح) -> {
        زد_استخدام_مسير(ح.اليسار, الاستخدامات);
        زد_استخدام_مسير(ح.اليمين, الاستخدامات);
    }
    | عملية_مسير.مقارنة_عشري(م) -> {
        زد_استخدام_مسير(م.اليسار, الاستخدامات);
        زد_استخدام_مسير(م.اليمين, الاستخدامات);
    }
    | عملية_مسير.مقارنة_صحيح(م) -> {
        زد_استخدام_مسير(م.اليسار, الاستخدامات);
        زد_استخدام_مسير(م.اليمين, الاستخدامات);
    }
    | عملية_مسير.تحويل_صحيح(ح) -> {
        زد_استخدام_مسير(ح.المصدر, الاستخدامات);
    }
    | عملية_مسير.مرجع_إلى_مؤشر(ح) -> {
        زد_استخدام_مسير(ح.المرجع, الاستخدامات);
    }
    | عملية_مسير.تجميع(ت) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ت.الأعضاء) مثل غير_موقع)) {
            زد_استخدام_مسير(ت.الأعضاء[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.تهيئة_متجه(ت) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ت.العناصر) مثل غير_موقع)) {
            زد_استخدام_مسير(ت.العناصر[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.استخراج_حقل(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.استخراج_فهرس(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
        زد_استخدام_مسير(ا.الفهرس, الاستخدامات);
    }
    | عملية_مسير.مكان_محلي(_) -> {
    }
    | عملية_مسير.مرجع_إلى_مكان(م) -> {
        زد_استخدام_مسير(م.المرجع, الاستخدامات);
    }
    | عملية_مسير.صندوق_إلى_مكان(م) -> {
        زد_استخدام_مسير(م.الصندوق, الاستخدامات);
    }
    | عملية_مسير.مكان_حقل(م) -> {
        زد_استخدام_مسير(م.الأصل, الاستخدامات);
    }
    | عملية_مسير.مكان_فهرس(م) -> {
        زد_استخدام_مسير(م.الأصل, الاستخدامات);
        زد_استخدام_مسير(م.الفهرس, الاستخدامات);
    }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(م) -> {
        زد_استخدام_مسير(م.المؤشر, الاستخدامات);
        زد_استخدام_مسير(م.الفهرس, الاستخدامات);
    }
    | عملية_مسير.تحميل(ت) -> {
        زد_استخدام_مسير(ت.المكان, الاستخدامات);
    }
    | عملية_مسير.تخزين(ت) -> {
        زد_استخدام_مسير(ت.المكان, الاستخدامات);
        زد_استخدام_مسير(ت.القيمة, الاستخدامات);
    }
    | عملية_مسير.مكان_إلى_مرجع(م) -> {
        زد_استخدام_مسير(م.المكان, الاستخدامات);
    }
    | عملية_مسير.بناء_موسوم(ب) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ب.الحمولات) مثل غير_موقع)) {
            زد_استخدام_مسير(ب.الحمولات[ف], الاستخدامات);
            ف := ف + 1;
        }
    }
    | عملية_مسير.استعلام_وسم(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.استخراج_حمولة(ا) -> {
        زد_استخدام_مسير(ا.المصدر, الاستخدامات);
    }
    | عملية_مسير.بناء_صندوق(ب) -> {
        زد_استخدام_مسير(ب.القيمة, الاستخدامات);
    }
    | عملية_مسير.نداء(ن) -> {
        طابق ن.الهدف مع
        | هدف_نداء_مسير.قيمة_دالة(الدالة_القيمة) -> { زد_استخدام_مسير(الدالة_القيمة, الاستخدامات); }
        | _ -> { };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ن.الحجج) مثل غير_موقع)) {
            زد_استخدام_مسير(ن.الحجج[ف], الاستخدامات);
            ف := ف + 1;
        }
        طابق ن.مكان_التعديل مع
        | اختيار.بعض(المكان) -> { زد_استخدام_مسير(المكان, الاستخدامات); }
        | اختيار.لا_شيء -> { };
    };
    أرجع صواب;
}

عرف عد_استخدامات_حافة_مسير(
    الحافة: &حافة_مسير,
    الاستخدامات: &متغير متجه غير_موقع
): منطقي {
    دع الحالة: حافة_مسير = *الحافة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحجج) مثل غير_موقع)) {
        زد_استخدام_مسير(الحالة.الحجج[ف], الاستخدامات);
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف جدول_استخدامات_قيم_مسير(الدالة: &دالة_مسير): متجه غير_موقع {
    دع العدد: غير_موقع = عدد_تعريفات_قيم_مسير(الدالة);
    دع الاستخدامات: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الاستخدامات, 0);
        ف := ف + 1;
    }
    دع الحالة: دالة_مسير = *الدالة;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < (الطول(الحالة.الكتل) مثل غير_موقع)) {
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الكتل[ك].التعليمات) مثل غير_موقع)) {
            عد_استخدامات_عملية_مسير(
                &الحالة.الكتل[ك].التعليمات[ت].العملية,
                &متغير الاستخدامات
            );
            ت := ت + 1;
        }
        طابق الحالة.الكتل[ك].المنهي مع
        | اختيار.لا_شيء -> {
        }
        | اختيار.بعض(المنهي) -> {
            طابق المنهي مع
            | منهي_مسير.فرع(الحافة) -> {
                عد_استخدامات_حافة_مسير(&الحافة, &متغير الاستخدامات);
            }
            | منهي_مسير.فرع_شرطي(الشرط, عند_الصواب, عند_الخطأ) -> {
                زد_استخدام_مسير(الشرط, &متغير الاستخدامات);
                عد_استخدامات_حافة_مسير(&عند_الصواب, &متغير الاستخدامات);
                عد_استخدامات_حافة_مسير(&عند_الخطأ, &متغير الاستخدامات);
            }
            | منهي_مسير.إرجاع(القيمة) -> {
                طابق القيمة مع
                | اختيار.لا_شيء -> {
                }
                | اختيار.بعض(المعرف) -> {
                    زد_استخدام_مسير(المعرف, &متغير الاستخدامات);
                };
            }
            | منهي_مسير.فخ -> {
            };
        };
        ك := ك + 1;
    }
    أرجع الاستخدامات;
}

عام عرف حلل_هيمنة_مسير(الدالة: &دالة_مسير): تحليل_هيمنة_مسير {
    دع الحالة: دالة_مسير = *الدالة;
    دع الوصول: متجه منطقي = الكتل_القابلة_للوصول_مسير(&الحالة);
    دع العدد: غير_موقع = الطول(الحالة.الكتل) مثل غير_موقع;
    دع المهيمنات: متغير متجه متجه منطقي = [];
    دع ك: متغير غير_موقع = 0;
    بينما (ك < العدد) {
        دع الصف: متغير متجه منطقي = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            ألحق(الصف, الوصول[ك] && الوصول[ف]);
            ف := ف + 1;
        }
        لو (الوصول[ك]) {
            الصف[ك] := صواب;
        };
        ألحق(المهيمنات, الصف);
        ك := ك + 1;
    }
    طابق الحالة.المدخل مع
    | اختيار.بعض(المدخل) -> {
        دع صف_المدخل: متغير متجه منطقي =
            انسخ_صف_منطقي_مسير(&المهيمنات[المدخل.القيمة]);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < العدد) {
            صف_المدخل[ف] := خطأ;
            ف := ف + 1;
        }
        صف_المدخل[المدخل.القيمة] := صواب;
        المهيمنات[المدخل.القيمة] := صف_المدخل;
    }
    | اختيار.لا_شيء -> { };

    دع تغير: متغير منطقي = صواب;
    بينما (تغير) {
        تغير := خطأ;
        ك := 0;
        بينما (ك < العدد) {
            دع هو_المدخل: متغير منطقي = خطأ;
            طابق الحالة.المدخل مع
            | اختيار.بعض(م) -> {
                هو_المدخل := كتلتان_مسير_متساويتان(الحالة.الكتل[ك].المعرف, م);
            }
            | _ -> {
            };
            لو (الوصول[ك] && !هو_المدخل) {
                دع الأسلاف: متجه معرف_كتلة_مسير = أسلاف_كتلة_مسير(&الحالة, الحالة.الكتل[ك].المعرف);
                دع الجديد: متغير متجه منطقي = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < العدد) {
                    ألحق(الجديد, صواب);
                    ف := ف + 1;
                }
                دع أ: متغير غير_موقع = 0;
                بينما (أ < (الطول(الأسلاف) مثل غير_موقع)) {
                    لو (الوصول[الأسلاف[أ].القيمة]) {
                        ف := 0;
                        بينما (ف < العدد) {
                            الجديد[ف] := الجديد[ف] && المهيمنات[الأسلاف[أ].القيمة][ف];
                            ف := ف + 1;
                        }
                    };
                    أ := أ + 1;
                }
                الجديد[ك] := صواب;
                ف := 0;
                بينما (ف < العدد) {
                    لو (الجديد[ف] != المهيمنات[ك][ف]) {
                        تغير := صواب;
                    };
                    ف := ف + 1;
                }
                المهيمنات[ك] := الجديد;
            };
            ك := ك + 1;
        }
    }

    دع المباشر: متغير متجه اختيار معرف_كتلة_مسير = [];
    ك := 0;
    بينما (ك < العدد) {
        دع المرشح: متغير اختيار معرف_كتلة_مسير = اختيار.لا_شيء();
        لو (الوصول[ك]) {
            دع د: متغير غير_موقع = 0;
            بينما (د < العدد) {
                لو ((د != ك) && المهيمنات[ك][د]) {
                    دع أعمق: متغير منطقي = صواب;
                    دع هـ: متغير غير_موقع = 0;
                    بينما (هـ < العدد) {
                        لو (
                            (هـ != ك)
                            && (هـ != د)
                            && المهيمنات[ك][هـ]
                            && !المهيمنات[د][هـ]
                        ) {
                            أعمق := خطأ;
                        };
                        هـ := هـ + 1;
                    }
                    لو (أعمق) {
                        المرشح := اختيار.بعض(الحالة.الكتل[د].المعرف);
                    };
                };
                د := د + 1;
            }
        };
        ألحق(المباشر, المرشح);
        ك := ك + 1;
    }
    دع الناتج: تحليل_هيمنة_مسير = {
        قابل_للوصول: الوصول,
        المهيمنات: المهيمنات,
        المهيمن_المباشر: المباشر
    };
    أرجع الناتج;
}

عام عرف كتلة_تهيمن_على(
    التحليل: &تحليل_هيمنة_مسير,
    المهيمنة: معرف_كتلة_مسير,
    التابعة: معرف_كتلة_مسير
): منطقي {
    دع الحالة: تحليل_هيمنة_مسير = *التحليل;
    لو (التابعة.القيمة >= (الطول(الحالة.المهيمنات) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو (
        المهيمنة.القيمة >= (الطول(الحالة.المهيمنات[التابعة.القيمة]) مثل غير_موقع)
    ) {
        أرجع خطأ;
    };
    أرجع الحالة.المهيمنات[التابعة.القيمة][المهيمنة.القيمة];
}
