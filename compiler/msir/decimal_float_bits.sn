// تحويل عشري دقيق إلى بتات IEEE-754 دون الاعتماد على عائم المضيف.
عام نوع عمل_عشري = {
    الأرقام: متجه ط8,
    النقطة: عدد
};


عام نوع نتيجة_دلالة_عشرية = {
    البتات: طبيعي,
    الحارس: منطقي,
    اللاصق: منطقي
};

عرف أي_رقم_غير_صفري(الأرقام: &متجه ط8): منطقي {
    دع القيم: متجه ط8 = *الأرقام;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (القيم[ف] != 0) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عشري_أكبر_أو_يساوي_واحد(القيمة: &عمل_عشري): منطقي {
    دع الحالة: عمل_عشري = *القيمة;
    لو (الحالة.النقطة <= 0) { أرجع خطأ; };
    دع الحد: متغير طبيعي = الحالة.النقطة مثل طبيعي;
    لو (الحد > (الطول(الحالة.الأرقام) مثل طبيعي)) { الحد := الطول(الحالة.الأرقام) مثل طبيعي; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        لو (الحالة.الأرقام[ف] != 0) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عشري_أكبر_أو_يساوي_اثنين(القيمة: &عمل_عشري): منطقي {
    دع الحالة: عمل_عشري = *القيمة;
    لو (الحالة.النقطة <= 0) { أرجع خطأ; };
    دع الحد: متغير طبيعي = الحالة.النقطة مثل طبيعي;
    لو (الحد > (الطول(الحالة.الأرقام) مثل طبيعي)) { الحد := الطول(الحالة.الأرقام) مثل طبيعي; };
    دع الأول: متغير طبيعي = الحد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحد) {
        لو (الحالة.الأرقام[ف] != 0 && الأول == الحد) { الأول := ف; };
        ف := ف + 1;
    }
    لو (الأول == الحد) { أرجع خطأ; };
    دع عدد_الأرقام_الصحيحة: طبيعي = الحد - الأول;
    لو (عدد_الأرقام_الصحيحة > 1) { أرجع صواب; };
    أرجع الحالة.الأرقام[الأول] >= 2;
}

عرف انسخ_أرقام_عشرية(الأرقام: &متجه ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *الأرقام;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف اضرب_عشريا_في_اثنين(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع الناتج: متغير متجه ط8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    دع الحمل: متغير طبيعي = 0;
    دع طول_الناتج: عدد = الطول(الناتج) مثل عدد;
    دع الفهرس: متغير عدد = طول_الناتج - 1;
    طالما (الفهرس >= 0) {
        دع الموضع: طبيعي = الفهرس مثل طبيعي;
        دع الرقم: طبيعي = الناتج[الموضع] مثل طبيعي;
        دع المضاعف: طبيعي = الرقم * 2 + الحمل;
        الناتج[الموضع] := (المضاعف % 10) مثل ط8;
        الحمل := المضاعف / 10;
        الفهرس := الفهرس - 1;
    }
    دع النقطة: متغير عدد = الحالة.النقطة;
    لو (الحمل != 0) {
        دع مع_الحمل: متغير متجه ط8 = [];
        ألحق(مع_الحمل, الحمل مثل ط8);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الناتج) مثل طبيعي)) { ألحق(مع_الحمل, الناتج[ف]); ف := ف + 1; }
        الناتج := مع_الحمل;
        النقطة := النقطة + 1;
    };
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: النقطة };
    أرجع النتيجة;
}

عرف اقسم_عشريا_على_اثنين(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع المصدر: متجه ط8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    دع الناتج: متغير متجه ط8 = [];
    دع الباقي: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع الحالي: طبيعي = الباقي * 10 + (المصدر[ف] مثل طبيعي);
        ألحق(الناتج, (الحالي / 2) مثل ط8);
        الباقي := الحالي % 2;
        ف := ف + 1;
    }
    لو (الباقي != 0) { ألحق(الناتج, 5); };
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
    أرجع النتيجة;
}

عرف اطرح_واحدا_عشريا(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع الناتج: متغير متجه ط8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    لو (الحالة.النقطة <= 0) {
        دع نفسه: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
        أرجع نفسه;
    };
    دع الفهرس: متغير عدد = الحالة.النقطة - 1;
    طالما (الفهرس >= 0) {
        دع الموضع: طبيعي = الفهرس مثل طبيعي;
        لو (الناتج[الموضع] > 0) {
            الناتج[الموضع] := الناتج[الموضع] - 1;
            دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
            أرجع النتيجة;
        };
        الناتج[الموضع] := 9;
        الفهرس := الفهرس - 1;
    }
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
    أرجع النتيجة;
}

عرف حضر_عشريا(البايتات: &متجه ط8, الرتبة: &متغير عدد): عمل_عشري {
    دع المصدر: متجه ط8 = *البايتات;
    دع الأرقام: متغير متجه ط8 = [];
    دع النقطة_قبل_الأس: متغير عدد = 0;
    دع بعد_النقطة: متغير منطقي = خطأ;
    دع في_الأس: متغير منطقي = خطأ;
    دع الأس_سالب: متغير منطقي = خطأ;
    دع قيمة_الأس: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع ب: ط8 = المصدر[ف];
        لو (ب == 0x2E) {
            بعد_النقطة := صواب;
        } وإلا لو (ب == 0x65 || ب == 0x45) {
            في_الأس := صواب;
        } وإلا لو (في_الأس && ب == 0x2D) {
            الأس_سالب := صواب;
        } وإلا لو (في_الأس && ب == 0x2B) {
        } وإلا لو (ب >= 0x30 && ب <= 0x39) {
            لو (في_الأس) {
                لو (قيمة_الأس < 100000) { قيمة_الأس := قيمة_الأس * 10 + ((ب - 0x30) مثل عدد); };
            } وإلا {
                ألحق(الأرقام, ب - 0x30);
                لو (!بعد_النقطة) { النقطة_قبل_الأس := النقطة_قبل_الأس + 1; };
            };
        };
        ف := ف + 1;
    }
    دع الأس_الموقع: متغير عدد = قيمة_الأس;
    لو (الأس_سالب) { الأس_الموقع := 0 - قيمة_الأس; };
    دع النقطة_الخام: عدد = النقطة_قبل_الأس + الأس_الموقع;
    دع أول_غير_صفري: متغير عدد = -1;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول(الأرقام) مثل طبيعي)) {
        لو (الأرقام[د] != 0 && أول_غير_صفري < 0) { أول_غير_صفري := د مثل عدد; };
        د := د + 1;
    }
    لو (أول_غير_صفري < 0) {
        دع أرقام_صفر: متجه ط8 = [0];
        دع صفر: عمل_عشري = { الأرقام: أرقام_صفر, النقطة: 1 };
        *الرتبة := -1000000;
        أرجع صفر;
    };
    دع رتبة_عشرية: عدد = النقطة_الخام - أول_غير_صفري - 1;
    دع المهيأ: متغير متجه ط8 = [];
    دع النقطة: متغير عدد = النقطة_الخام;
    لو (النقطة < 0) {
        دع ص: متغير عدد = 0;
        طالما (ص < (0 - النقطة)) { ألحق(المهيأ, 0); ص := ص + 1; }
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الأرقام) مثل طبيعي)) { ألحق(المهيأ, الأرقام[ج]); ج := ج + 1; }
        النقطة := 0;
    } وإلا {
        المهيأ := الأرقام;
        طالما (النقطة > (الطول(المهيأ) مثل عدد)) { ألحق(المهيأ, 0); }
    };
    دع الحالة: عمل_عشري = { الأرقام: المهيأ, النقطة: النقطة };
    *الرتبة := رتبة_عشرية;
    أرجع الحالة;
}

عرف بتات_دلالة_عشرية(المطبع: عمل_عشري, العدد: طبيعي): نتيجة_دلالة_عشرية {
    دع الكسر: متغير عمل_عشري = اطرح_واحدا_عشريا(&المطبع);
    دع الدلالة: متغير طبيعي = 1;
    دع المولد: متغير طبيعي = 1;
    طالما (المولد < العدد) {
        الكسر := اضرب_عشريا_في_اثنين(&الكسر);
        الدلالة := الدلالة << 1;
        لو (عشري_أكبر_أو_يساوي_واحد(&الكسر)) {
            الدلالة := الدلالة | 1;
            الكسر := اطرح_واحدا_عشريا(&الكسر);
        };
        المولد := المولد + 1;
    }
    الكسر := اضرب_عشريا_في_اثنين(&الكسر);
    دع الحارس: متغير منطقي = خطأ;
    لو (عشري_أكبر_أو_يساوي_واحد(&الكسر)) {
        الحارس := صواب;
        الكسر := اطرح_واحدا_عشريا(&الكسر);
    };
    دع اللاصق: منطقي = أي_رقم_غير_صفري(&الكسر.الأرقام);
    دع النتيجة: نتيجة_دلالة_عشرية = { البتات: الدلالة, الحارس: الحارس, اللاصق: اللاصق };
    أرجع النتيجة;
}

عرف بتات_عائم_مطلق_من_عشري(البايتات: &متجه ط8, العرض: طبيعي): اختياري طبيعي {
    لو (العرض != 32 && العرض != 64) { أرجع اختياري.لا_شيء(); };
    دع الرتبة_العشرية: متغير عدد = 0;
    دع القيمة: متغير عمل_عشري = حضر_عشريا(البايتات, &متغير الرتبة_العشرية);
    لو (الرتبة_العشرية == -1000000) { أرجع اختياري.موجود(0); };
    دع الدقة: متغير طبيعي = 53;
    دع الانحياز: متغير عدد = 1023;
    دع أصغر_أس: متغير عدد = -1022;
    دع أكبر_أس: متغير عدد = 1023;
    دع أكبر_رتبة_عشرية: متغير عدد = 400;
    دع أصغر_رتبة_عشرية: متغير عدد = -500;
    لو (العرض == 32) {
        الدقة := 24; الانحياز := 127; أصغر_أس := -126; أكبر_أس := 127;
        أكبر_رتبة_عشرية := 50; أصغر_رتبة_عشرية := -60;
    };
    لو (الرتبة_العشرية > أكبر_رتبة_عشرية) {
        دع كل_الأس: متغير طبيعي = 0x7FF;
        لو (العرض == 32) { كل_الأس := 0xFF; };
        أرجع اختياري.موجود(كل_الأس << (الدقة - 1));
    };
    لو (الرتبة_العشرية < أصغر_رتبة_عشرية) { أرجع اختياري.موجود(0); };
    دع الأس2: متغير عدد = 0;
    طالما (عشري_أكبر_أو_يساوي_اثنين(&القيمة)) {
        القيمة := اقسم_عشريا_على_اثنين(&القيمة);
        الأس2 := الأس2 + 1;
        لو (الأس2 > أكبر_أس + 2) {
            دع كل_الأس: متغير طبيعي = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
            أرجع اختياري.موجود(كل_الأس << (الدقة - 1));
        };
    }
    طالما (!عشري_أكبر_أو_يساوي_واحد(&القيمة)) {
        القيمة := اضرب_عشريا_في_اثنين(&القيمة);
        الأس2 := الأس2 - 1;
        دع الدقة_موقعة: عدد = الدقة مثل عدد;
        لو (الأس2 < أصغر_أس - الدقة_موقعة - 2) { أرجع اختياري.موجود(0); };
    }
    لو (الأس2 > أكبر_أس) {
        دع كل_الأس: متغير طبيعي = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
        أرجع اختياري.موجود(كل_الأس << (الدقة - 1));
    };
    لو (الأس2 >= أصغر_أس) {
        دع الأجزاء: نتيجة_دلالة_عشرية = بتات_دلالة_عشرية(القيمة, الدقة);
        دع الدلالة: متغير طبيعي = الأجزاء.البتات;
        لو (الأجزاء.الحارس && (الأجزاء.اللاصق || ((الدلالة & 1) != 0))) { الدلالة := الدلالة + 1; };
        لو (الدلالة == (1 << الدقة)) {
            الدلالة := الدلالة >> 1; الأس2 := الأس2 + 1;
            لو (الأس2 > أكبر_أس) {
                دع كل_الأس: متغير طبيعي = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
                أرجع اختياري.موجود(كل_الأس << (الدقة - 1));
            };
        };
        دع حد_الكسر: طبيعي = 1 << (الدقة - 1);
        دع قناع_الكسر: طبيعي = حد_الكسر - 1;
        دع الأس_المنحاز: عدد = الأس2 + الانحياز;
        دع حقل_الأس: طبيعي = الأس_المنحاز مثل طبيعي;
        أرجع اختياري.موجود((حقل_الأس << (الدقة - 1)) | (الدلالة & قناع_الكسر));
    };
    دع الدقة_موقعة_دون_طبيعي: عدد = الدقة مثل عدد;
    دع المحتفظ: عدد = الدقة_موقعة_دون_طبيعي + الأس2 - أصغر_أس;
    لو (المحتفظ <= 0) {
        القيمة := اضرب_عشريا_في_اثنين(&القيمة);
        لو (!عشري_أكبر_أو_يساوي_واحد(&القيمة)) { أرجع اختياري.موجود(0); };
        القيمة := اطرح_واحدا_عشريا(&القيمة);
        لو (أي_رقم_غير_صفري(&القيمة.الأرقام)) { أرجع اختياري.موجود(1); };
        أرجع اختياري.موجود(0);
    };
    دع أجزاء_دون_طبيعي: نتيجة_دلالة_عشرية = بتات_دلالة_عشرية(القيمة, المحتفظ مثل طبيعي);
    دع دلالة_دون_طبيعية: متغير طبيعي = أجزاء_دون_طبيعي.البتات;
    لو (أجزاء_دون_طبيعي.الحارس && (أجزاء_دون_طبيعي.اللاصق || ((دلالة_دون_طبيعية & 1) != 0))) { دلالة_دون_طبيعية := دلالة_دون_طبيعية + 1; };
    دع أصغر_عادي_عائم: طبيعي = 1 << (الدقة - 1);
    لو (دلالة_دون_طبيعية >= أصغر_عادي_عائم) { أرجع اختياري.موجود(أصغر_عادي_عائم); };
    أرجع اختياري.موجود(دلالة_دون_طبيعية);
}

// The lexical sign is not part of the magnitude's decimal normalization.
// Preserve IEEE-754 negative zero, subnormals and infinities with the same
// sign-bit rule across Native, LLVM and the interpreter.
عام عرف بتات_عائم_من_عشري(البايتات: &متجه ط8, العرض: طبيعي): اختياري طبيعي {
    لو (العرض != 32 && العرض != 64) { أرجع اختياري.لا_شيء(); };
    دع سالب: منطقي = (الطول(*البايتات) مثل طبيعي) > 0
        && (*البايتات)[0] == 0x2D;
    طابق بتات_عائم_مطلق_من_عشري(البايتات, العرض) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        لو (!سالب) { أرجع اختياري.موجود(القيمة); };
        دع بت_الإشارة: طبيعي = (1 مثل طبيعي) << (العرض - 1);
        أرجع اختياري.موجود(القيمة | بت_الإشارة);
    };
}

// The exact decimal text of a finite float's bits (every binary float is a
// finite decimal), which بتات_عائم_من_عشري reads back to the same bits. An
// infinity is a decimal beyond the format's range (1e39 / 1e309), which reads
// back as that infinity; a NaN has no decimal and gives none.
عام عرف نص_عشري_دقيق_من_بتات(البتات: طبيعي, العرض: طبيعي): اختياري متجه ط8 {
    دع بتات_الكسر: متغير طبيعي = 52;
    دع بتات_الأس: متغير طبيعي = 11;
    دع الانحياز: متغير عدد = 1023;
    لو (العرض == 32) { بتات_الكسر := 23; بتات_الأس := 8; الانحياز := 127; };
    دع واحد: طبيعي = 1;
    دع الأس_الخام: طبيعي = (البتات >> بتات_الكسر) & ((واحد << بتات_الأس) - 1);
    دع الكسر: طبيعي = البتات & ((واحد << بتات_الكسر) - 1);
    دع سالب: منطقي = ((البتات >> (العرض - 1)) & 1) != 0;
    دع الناتج: متغير متجه ط8 = [];
    لو (سالب) { ألحق(الناتج, 0x2D); };
    لو (الأس_الخام == (واحد << بتات_الأس) - 1) {
        لو (الكسر != 0) { أرجع اختياري.لا_شيء(); };
        ألحق(الناتج, 0x31); ألحق(الناتج, 0x65); ألحق(الناتج, 0x33);
        لو (العرض == 32) { ألحق(الناتج, 0x39); } وإلا { ألحق(الناتج, 0x30); ألحق(الناتج, 0x39); };
        أرجع اختياري.موجود(الناتج);
    };
    // value = الدلالة * 2^الأس
    دع الدلالة: متغير طبيعي = الكسر;
    دع الأس: متغير عدد = 1 - الانحياز - (بتات_الكسر مثل عدد);
    لو (الأس_الخام != 0) {
        الدلالة := الكسر | (واحد << بتات_الكسر);
        الأس := (الأس_الخام مثل عدد) - الانحياز - (بتات_الكسر مثل عدد);
    };
    // The significand's decimal digits, most significant first.
    دع المعكوسة: متغير متجه ط8 = [];
    دع ق: متغير طبيعي = الدلالة;
    لو (ق == 0) { ألحق(المعكوسة, 0); };
    طالما (ق != 0) { ألحق(المعكوسة, (ق % 10) مثل ط8); ق := ق / 10; }
    دع الأرقام: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = الطول(المعكوسة) مثل طبيعي;
    طالما (ف > 0) { ف := ف - 1; ألحق(الأرقام, المعكوسة[ف]); }
    دع عدد_الأرقام: عدد = الطول(الأرقام) مثل عدد;
    دع العمل: متغير عمل_عشري = { الأرقام: الأرقام, النقطة: عدد_الأرقام };
    طالما (الأس > 0) { العمل := اضرب_عشريا_في_اثنين(&العمل); الأس := الأس - 1; }
    طالما (الأس < 0) { العمل := اقسم_عشريا_على_اثنين(&العمل); الأس := الأس + 1; }
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(العمل.الأرقام) مثل طبيعي)) {
        لو ((ي مثل عدد) == العمل.النقطة) { ألحق(الناتج, 0x2E); };
        ألحق(الناتج, العمل.الأرقام[ي] + 0x30);
        ي := ي + 1;
    }
    لو (العمل.النقطة <= 0) {
        // A value below one: 0.<zeros><digits>.
        دع البادئة: متغير متجه ط8 = [];
        لو (سالب) { ألحق(البادئة, 0x2D); };
        ألحق(البادئة, 0x30); ألحق(البادئة, 0x2E);
        دع ص: متغير عدد = 0;
        طالما (ص < (0 - العمل.النقطة)) { ألحق(البادئة, 0x30); ص := ص + 1; }
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(العمل.الأرقام) مثل طبيعي)) { ألحق(البادئة, العمل.الأرقام[ج] + 0x30); ج := ج + 1; }
        أرجع اختياري.موجود(البادئة);
    };
    أرجع اختياري.موجود(الناتج);
}
