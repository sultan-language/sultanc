// تحويل عشري دقيق إلى بتات IEEE-754 دون الاعتماد على عائم المضيف.
عام نوع عمل_عشري = {
    الأرقام: متجه غ8,
    النقطة: عدد
};


عام نوع نتيجة_دلالة_عشرية = {
    البتات: غير_موقع,
    الحارس: منطقي,
    اللاصق: منطقي
};

عرف أي_رقم_غير_صفري(الأرقام: &متجه غ8): منطقي {
    دع القيم: متجه غ8 = *الأرقام;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (القيم[ف] != 0) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عشري_أكبر_أو_يساوي_واحد(القيمة: &عمل_عشري): منطقي {
    دع الحالة: عمل_عشري = *القيمة;
    لو (الحالة.النقطة <= 0) { أرجع خطأ; };
    دع الحد: متغير غير_موقع = الحالة.النقطة مثل غير_موقع;
    لو (الحد > (الطول(الحالة.الأرقام) مثل غير_موقع)) { الحد := الطول(الحالة.الأرقام) مثل غير_موقع; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحد) {
        لو (الحالة.الأرقام[ف] != 0) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عشري_أكبر_أو_يساوي_اثنين(القيمة: &عمل_عشري): منطقي {
    دع الحالة: عمل_عشري = *القيمة;
    لو (الحالة.النقطة <= 0) { أرجع خطأ; };
    دع الحد: متغير غير_موقع = الحالة.النقطة مثل غير_موقع;
    لو (الحد > (الطول(الحالة.الأرقام) مثل غير_موقع)) { الحد := الطول(الحالة.الأرقام) مثل غير_موقع; };
    دع الأول: متغير غير_موقع = الحد;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحد) {
        لو (الحالة.الأرقام[ف] != 0 && الأول == الحد) { الأول := ف; };
        ف := ف + 1;
    }
    لو (الأول == الحد) { أرجع خطأ; };
    دع عدد_الأرقام_الصحيحة: غير_موقع = الحد - الأول;
    لو (عدد_الأرقام_الصحيحة > 1) { أرجع صواب; };
    أرجع الحالة.الأرقام[الأول] >= 2;
}

عرف انسخ_أرقام_عشرية(الأرقام: &متجه غ8): متجه غ8 {
    دع المصدر: متجه غ8 = *الأرقام;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف اضرب_عشريا_في_اثنين(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع الناتج: متغير متجه غ8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    دع الحمل: متغير غير_موقع = 0;
    دع طول_الناتج: عدد = الطول(الناتج) مثل عدد;
    دع الفهرس: متغير عدد = طول_الناتج - 1;
    بينما (الفهرس >= 0) {
        دع الموضع: غير_موقع = الفهرس مثل غير_موقع;
        دع الرقم: غير_موقع = الناتج[الموضع] مثل غير_موقع;
        دع المضاعف: غير_موقع = الرقم * 2 + الحمل;
        الناتج[الموضع] := (المضاعف % 10) مثل غ8;
        الحمل := المضاعف / 10;
        الفهرس := الفهرس - 1;
    }
    دع النقطة: متغير عدد = الحالة.النقطة;
    لو (الحمل != 0) {
        دع مع_الحمل: متغير متجه غ8 = [];
        ألحق(مع_الحمل, الحمل مثل غ8);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الناتج) مثل غير_موقع)) { ألحق(مع_الحمل, الناتج[ف]); ف := ف + 1; }
        الناتج := مع_الحمل;
        النقطة := النقطة + 1;
    };
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: النقطة };
    أرجع النتيجة;
}

عرف اقسم_عشريا_على_اثنين(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع المصدر: متجه غ8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    دع الناتج: متغير متجه غ8 = [];
    دع الباقي: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع الحالي: غير_موقع = الباقي * 10 + (المصدر[ف] مثل غير_موقع);
        ألحق(الناتج, (الحالي / 2) مثل غ8);
        الباقي := الحالي % 2;
        ف := ف + 1;
    }
    لو (الباقي != 0) { ألحق(الناتج, 5); };
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
    أرجع النتيجة;
}

عرف اطرح_واحدا_عشريا(القيمة: &عمل_عشري): عمل_عشري {
    دع الحالة: عمل_عشري = *القيمة;
    دع الناتج: متغير متجه غ8 = انسخ_أرقام_عشرية(&الحالة.الأرقام);
    لو (الحالة.النقطة <= 0) {
        دع نفسه: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
        أرجع نفسه;
    };
    دع الفهرس: متغير عدد = الحالة.النقطة - 1;
    بينما (الفهرس >= 0) {
        دع الموضع: غير_موقع = الفهرس مثل غير_موقع;
        لو (الناتج[الموضع] > 0) {
            الناتج[الموضع] := الناتج[الموضع] - 1;
            دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
            أرجع النتيجة;
        };
        الناتج[الموضع] := 9;
        الفهرس := الفهرس - 1;
    }
    دع النتيجة: عمل_عشري = { الأرقام: الناتج, النقطة: الحالة.النقطة };
    أرجع النتيجة;
}

عرف حضر_عشريا(البايتات: &متجه غ8, الرتبة: &متغير عدد): عمل_عشري {
    دع المصدر: متجه غ8 = *البايتات;
    دع الأرقام: متغير متجه غ8 = [];
    دع النقطة_قبل_الأس: متغير عدد = 0;
    دع بعد_النقطة: متغير منطقي = خطأ;
    دع في_الأس: متغير منطقي = خطأ;
    دع الأس_سالب: متغير منطقي = خطأ;
    دع قيمة_الأس: متغير عدد = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع ب: غ8 = المصدر[ف];
        لو (ب == 0x2E) {
            بعد_النقطة := صواب;
        } وإلا لو (ب == 0x65 || ب == 0x45) {
            في_الأس := صواب;
        } وإلا لو (في_الأس && ب == 0x2D) {
            الأس_سالب := صواب;
        } وإلا لو (في_الأس && ب == 0x2B) {
        } وإلا لو (ب >= 0x30 && ب <= 0x39) {
            لو (في_الأس) {
                لو (قيمة_الأس < 100000) { قيمة_الأس := قيمة_الأس * 10 + ((ب - 0x30) مثل عدد); };
            } وإلا {
                ألحق(الأرقام, ب - 0x30);
                لو (!بعد_النقطة) { النقطة_قبل_الأس := النقطة_قبل_الأس + 1; };
            };
        };
        ف := ف + 1;
    }
    دع الأس_الموقع: متغير عدد = قيمة_الأس;
    لو (الأس_سالب) { الأس_الموقع := 0 - قيمة_الأس; };
    دع النقطة_الخام: عدد = النقطة_قبل_الأس + الأس_الموقع;
    دع أول_غير_صفري: متغير عدد = -1;
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول(الأرقام) مثل غير_موقع)) {
        لو (الأرقام[د] != 0 && أول_غير_صفري < 0) { أول_غير_صفري := د مثل عدد; };
        د := د + 1;
    }
    لو (أول_غير_صفري < 0) {
        دع أرقام_صفر: متجه غ8 = [0];
        دع صفر: عمل_عشري = { الأرقام: أرقام_صفر, النقطة: 1 };
        *الرتبة := -1000000;
        أرجع صفر;
    };
    دع رتبة_عشرية: عدد = النقطة_الخام - أول_غير_صفري - 1;
    دع المهيأ: متغير متجه غ8 = [];
    دع النقطة: متغير عدد = النقطة_الخام;
    لو (النقطة < 0) {
        دع ص: متغير عدد = 0;
        بينما (ص < (0 - النقطة)) { ألحق(المهيأ, 0); ص := ص + 1; }
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول(الأرقام) مثل غير_موقع)) { ألحق(المهيأ, الأرقام[ج]); ج := ج + 1; }
        النقطة := 0;
    } وإلا {
        المهيأ := الأرقام;
        بينما (النقطة > (الطول(المهيأ) مثل عدد)) { ألحق(المهيأ, 0); }
    };
    دع الحالة: عمل_عشري = { الأرقام: المهيأ, النقطة: النقطة };
    *الرتبة := رتبة_عشرية;
    أرجع الحالة;
}

عرف بتات_دلالة_عشرية(المطبع: عمل_عشري, العدد: غير_موقع): نتيجة_دلالة_عشرية {
    دع الكسر: متغير عمل_عشري = اطرح_واحدا_عشريا(&المطبع);
    دع الدلالة: متغير غير_موقع = 1;
    دع المولد: متغير غير_موقع = 1;
    بينما (المولد < العدد) {
        الكسر := اضرب_عشريا_في_اثنين(&الكسر);
        الدلالة := الدلالة << 1;
        لو (عشري_أكبر_أو_يساوي_واحد(&الكسر)) {
            الدلالة := الدلالة | 1;
            الكسر := اطرح_واحدا_عشريا(&الكسر);
        };
        المولد := المولد + 1;
    }
    الكسر := اضرب_عشريا_في_اثنين(&الكسر);
    دع الحارس: متغير منطقي = خطأ;
    لو (عشري_أكبر_أو_يساوي_واحد(&الكسر)) {
        الحارس := صواب;
        الكسر := اطرح_واحدا_عشريا(&الكسر);
    };
    دع اللاصق: منطقي = أي_رقم_غير_صفري(&الكسر.الأرقام);
    دع النتيجة: نتيجة_دلالة_عشرية = { البتات: الدلالة, الحارس: الحارس, اللاصق: اللاصق };
    أرجع النتيجة;
}

عام عرف بتات_عائم_من_عشري(البايتات: &متجه غ8, العرض: غير_موقع): اختيار غير_موقع {
    لو (العرض != 32 && العرض != 64) { أرجع اختيار.لا_شيء(); };
    دع الرتبة_العشرية: متغير عدد = 0;
    دع القيمة: متغير عمل_عشري = حضر_عشريا(البايتات, &متغير الرتبة_العشرية);
    لو (الرتبة_العشرية == -1000000) { أرجع اختيار.بعض(0); };
    دع الدقة: متغير غير_موقع = 53;
    دع الانحياز: متغير عدد = 1023;
    دع أصغر_أس: متغير عدد = -1022;
    دع أكبر_أس: متغير عدد = 1023;
    دع أكبر_رتبة_عشرية: متغير عدد = 400;
    دع أصغر_رتبة_عشرية: متغير عدد = -500;
    لو (العرض == 32) {
        الدقة := 24; الانحياز := 127; أصغر_أس := -126; أكبر_أس := 127;
        أكبر_رتبة_عشرية := 50; أصغر_رتبة_عشرية := -60;
    };
    لو (الرتبة_العشرية > أكبر_رتبة_عشرية) {
        دع كل_الأس: متغير غير_موقع = 0x7FF;
        لو (العرض == 32) { كل_الأس := 0xFF; };
        أرجع اختيار.بعض(كل_الأس << (الدقة - 1));
    };
    لو (الرتبة_العشرية < أصغر_رتبة_عشرية) { أرجع اختيار.بعض(0); };
    دع الأس2: متغير عدد = 0;
    بينما (عشري_أكبر_أو_يساوي_اثنين(&القيمة)) {
        القيمة := اقسم_عشريا_على_اثنين(&القيمة);
        الأس2 := الأس2 + 1;
        لو (الأس2 > أكبر_أس + 2) {
            دع كل_الأس: متغير غير_موقع = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
            أرجع اختيار.بعض(كل_الأس << (الدقة - 1));
        };
    }
    بينما (!عشري_أكبر_أو_يساوي_واحد(&القيمة)) {
        القيمة := اضرب_عشريا_في_اثنين(&القيمة);
        الأس2 := الأس2 - 1;
        دع الدقة_موقعة: عدد = الدقة مثل عدد;
        لو (الأس2 < أصغر_أس - الدقة_موقعة - 2) { أرجع اختيار.بعض(0); };
    }
    لو (الأس2 > أكبر_أس) {
        دع كل_الأس: متغير غير_موقع = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
        أرجع اختيار.بعض(كل_الأس << (الدقة - 1));
    };
    لو (الأس2 >= أصغر_أس) {
        دع الأجزاء: نتيجة_دلالة_عشرية = بتات_دلالة_عشرية(القيمة, الدقة);
        دع الدلالة: متغير غير_موقع = الأجزاء.البتات;
        لو (الأجزاء.الحارس && (الأجزاء.اللاصق || ((الدلالة & 1) != 0))) { الدلالة := الدلالة + 1; };
        لو (الدلالة == (1 << الدقة)) {
            الدلالة := الدلالة >> 1; الأس2 := الأس2 + 1;
            لو (الأس2 > أكبر_أس) {
                دع كل_الأس: متغير غير_موقع = 0x7FF; لو (العرض == 32) { كل_الأس := 0xFF; };
                أرجع اختيار.بعض(كل_الأس << (الدقة - 1));
            };
        };
        دع حد_الكسر: غير_موقع = 1 << (الدقة - 1);
        دع قناع_الكسر: غير_موقع = حد_الكسر - 1;
        دع الأس_المنحاز: عدد = الأس2 + الانحياز;
        دع حقل_الأس: غير_موقع = الأس_المنحاز مثل غير_موقع;
        أرجع اختيار.بعض((حقل_الأس << (الدقة - 1)) | (الدلالة & قناع_الكسر));
    };
    دع الدقة_موقعة_دون_طبيعي: عدد = الدقة مثل عدد;
    دع المحتفظ: عدد = الدقة_موقعة_دون_طبيعي + الأس2 - أصغر_أس;
    لو (المحتفظ <= 0) {
        القيمة := اضرب_عشريا_في_اثنين(&القيمة);
        لو (!عشري_أكبر_أو_يساوي_واحد(&القيمة)) { أرجع اختيار.بعض(0); };
        القيمة := اطرح_واحدا_عشريا(&القيمة);
        لو (أي_رقم_غير_صفري(&القيمة.الأرقام)) { أرجع اختيار.بعض(1); };
        أرجع اختيار.بعض(0);
    };
    دع أجزاء_دون_طبيعي: نتيجة_دلالة_عشرية = بتات_دلالة_عشرية(القيمة, المحتفظ مثل غير_موقع);
    دع دلالة_دون_طبيعية: متغير غير_موقع = أجزاء_دون_طبيعي.البتات;
    لو (أجزاء_دون_طبيعي.الحارس && (أجزاء_دون_طبيعي.اللاصق || ((دلالة_دون_طبيعية & 1) != 0))) { دلالة_دون_طبيعية := دلالة_دون_طبيعية + 1; };
    دع أصغر_طبيعي: غير_موقع = 1 << (الدقة - 1);
    لو (دلالة_دون_طبيعية >= أصغر_طبيعي) { أرجع اختيار.بعض(أصغر_طبيعي); };
    أرجع اختيار.بعض(دلالة_دون_طبيعية);
}
