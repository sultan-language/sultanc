استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.debuginfo.location;
استورد compiler.debuginfo.scope;
استورد compiler.debuginfo.function;
استورد compiler.debuginfo.variable;
استورد compiler.debuginfo.types;
استورد compiler.debuginfo.global;
استورد compiler.debuginfo.module;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.provenance;
استورد compiler.source.span;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.source_file;

عام نوع سلوك_تحويل_تصحيح_مسير =
    | حفظ
    | استبدال بنوع معرف_موقع_تصحيح
    | دمج بنوع معرف_موقع_تصحيح
    | إسقاط
;

عام نوع ربط_نطاق_مصدر_تصحيح = {
    المصدر: غير_موقع,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    النطاق: معرف_نطاق_تصحيح
};

// Compact MSIR bridge. Rich records stay in compiler/debuginfo; this contract only
// maps dense MSIR identities to stable debug identities.
عام نوع عقد_تصحيح_مسير = {
    دوال: متجه اختيار معرف_دالة_تصحيح,
    متغيرات_القيم: متجه متجه متجه معرف_متغير_تصحيح,
    مواقع_القيم: متجه متجه اختيار معرف_موقع_تصحيح,
    متغيرات_بالرمز: متجه متجه اختيار معرف_متغير_تصحيح,
    نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح,
    العوام: متجه اختيار معرف_عام_تصحيح
};

عام نوع بيانات_تصحيح_مسير = {
    الدلالي: سياق_تصحيح,
    العقد: عقد_تصحيح_مسير
};

عام عرف بيانات_تصحيح_مسير_جديدة(): بيانات_تصحيح_مسير {
    دع الدلالي: سياق_تصحيح = سياق_تصحيح_جديد();
    دع الدوال: متجه اختيار معرف_دالة_تصحيح = [];
    دع المتغيرات: متجه متجه متجه معرف_متغير_تصحيح = [];
    دع المواقع: متجه متجه اختيار معرف_موقع_تصحيح = [];
    دع بالرمز: متجه متجه اختيار معرف_متغير_تصحيح = [];
    دع نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح = [];
    دع العوام: متجه اختيار معرف_عام_تصحيح = [];
    دع العقد: عقد_تصحيح_مسير = {
        دوال: الدوال,
        متغيرات_القيم: المتغيرات,
        مواقع_القيم: المواقع,
        متغيرات_بالرمز: بالرمز,
        نطاقات_المصدر: نطاقات_المصدر,
        العوام: العوام
    };
    دع البيانات: بيانات_تصحيح_مسير = { الدلالي: الدلالي, العقد: العقد };
    أرجع البيانات;
}

عرف ضمن_دالة_تصحيح_مسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): فراغ {
    بينما ((الطول((*العقد).دوال) مثل غير_موقع) <= الدالة.القيمة) {
        دع بلا_دالة: اختيار معرف_دالة_تصحيح = اختيار.لا_شيء();
        دع متغيرات_فارغة: متجه متجه معرف_متغير_تصحيح = [];
        دع مواقع_فارغة: متجه اختيار معرف_موقع_تصحيح = [];
        ألحق((*العقد).دوال, بلا_دالة);
        ألحق((*العقد).متغيرات_القيم, متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم, مواقع_فارغة);
        دع رموز_فارغة: متجه اختيار معرف_متغير_تصحيح = [];
        ألحق((*العقد).متغيرات_بالرمز, رموز_فارغة);
        دع نطاقات_فارغة: متجه ربط_نطاق_مصدر_تصحيح = [];
        ألحق((*العقد).نطاقات_المصدر, نطاقات_فارغة);
    }
}

عام عرف اربط_دالة_تصحيح_بمسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    التصحيح: معرف_دالة_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, الدالة);
    (*العقد).دوال[الدالة.القيمة] := اختيار.بعض(التصحيح);
}

عام عرف دالة_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختيار معرف_دالة_تصحيح {
    لو (الدالة.القيمة >= (الطول((*العقد).دوال) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*العقد).دوال[الدالة.القيمة];
}

عام عرف اربط_قيمة_بمتغير_تصحيح(
    العقد: &متغير عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير,
    المتغير: معرف_متغير_تصحيح,
    الموقع: اختيار معرف_موقع_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, القيمة.الدالة);
    دع فهرس_الدالة: غير_موقع = القيمة.الدالة.القيمة;
    بينما ((الطول((*العقد).متغيرات_القيم[فهرس_الدالة]) مثل غير_موقع) <= القيمة.القيمة) {
        دع متغيرات_فارغة: متجه معرف_متغير_تصحيح = [];
        دع بلا_موقع: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
        ألحق((*العقد).متغيرات_القيم[فهرس_الدالة], متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم[فهرس_الدالة], بلا_موقع);
    }
    ألحق((*العقد).متغيرات_القيم[فهرس_الدالة][القيمة.القيمة], المتغير);
    (*العقد).مواقع_القيم[فهرس_الدالة][القيمة.القيمة] := الموقع;
}

عام عرف متغيرات_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): متجه معرف_متغير_تصحيح {
    لو (القيمة.الدالة.القيمة >= (الطول((*العقد).متغيرات_القيم) مثل غير_موقع)) {
        دع فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة;
    };
    دع جدول: &متجه متجه معرف_متغير_تصحيح = &(*العقد).متغيرات_القيم[القيمة.الدالة.القيمة];
    لو (القيمة.القيمة >= (الطول(*جدول) مثل غير_موقع)) { دع فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة; };
    دع المتغيرات: &متجه معرف_متغير_تصحيح = &(*جدول)[القيمة.القيمة];
    دع النسخة: متجه معرف_متغير_تصحيح = *المتغيرات;
    أرجع النسخة;
}

عام عرف موقع_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): اختيار معرف_موقع_تصحيح {
    لو (القيمة.الدالة.القيمة >= (الطول((*العقد).مواقع_القيم) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع جدول: &متجه اختيار معرف_موقع_تصحيح = &(*العقد).مواقع_القيم[القيمة.الدالة.القيمة];
    لو (القيمة.القيمة >= (الطول(*جدول) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*جدول)[القيمة.القيمة];
}


عام عرف سجل_تصحيح_نوع_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الرمز: معرف_رمز,
    الاسم: &متجه غ8,
    أسماء_الأعضاء: &متجه متجه غ8,
    أسماء_البدائل: &متجه متجه غ8,
    أسماء_معاملات_النوع: &متجه متجه غ8,
    الأصل: اختيار معرف_أصل_مصدر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع الدلالي: &متغير سياق_تصحيح = &متغير (*التصحيح_المتغير).الدلالي;
    طابق معرف_نوع_تصحيح_لنوع(الدلالي, النوع) مع
    | اختيار.بعض(_) -> { أرجع; }
    | اختيار.لا_شيء -> { };
    دع اسم_النوع: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    دع الأعضاء: متغير متجه اسم_عضو_تصحيح_نوع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أسماء_الأعضاء) مثل غير_موقع)) {
        دع الاسم_المنسوخ: متجه غ8 = انسخ_اسم_تصحيح(&(*أسماء_الأعضاء)[ف]);
        دع العضو: اسم_عضو_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(الأعضاء, العضو); ف := ف + 1;
    }
    دع البدائل: متغير متجه اسم_بديل_تصحيح_نوع = [];
    ف := 0;
    بينما (ف < (الطول(*أسماء_البدائل) مثل غير_موقع)) {
        دع الاسم_المنسوخ: متجه غ8 = انسخ_اسم_تصحيح(&(*أسماء_البدائل)[ف]);
        دع البديل: اسم_بديل_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(البدائل, البديل); ف := ف + 1;
    }
    دع معاملات: متجه معرف_نوع = [];
    دع أسماء_المعاملات: متغير متجه متجه غ8 = [];
    ف := 0;
    بينما (ف < (الطول(*أسماء_معاملات_النوع) مثل غير_موقع)) {
        دع اسم_المعامل: متجه غ8 = انسخ_اسم_تصحيح(&(*أسماء_معاملات_النوع)[ف]);
        ألحق(أسماء_المعاملات, اسم_المعامل);
        ف := ف + 1;
    }
    دع بلا_اسم_مستعار: اختيار معرف_نوع = اختيار.لا_شيء();
    أضف_نوع_تصحيح(
        الدلالي, النوع, اختيار.بعض(الرمز), اسم_النوع,
        الأعضاء, البدائل, معاملات, أسماء_المعاملات, بلا_اسم_مستعار, الأصل, خطأ
    );
}

عام عرف سجل_اسم_مستعار_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع_الهدف: معرف_نوع,
    الاسم: &متجه غ8,
    الأصل: اختيار معرف_أصل_مصدر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع اسم_النوع: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    أضف_اسم_مستعار_نوع_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, النوع_الهدف, اسم_النوع, الأصل, خطأ);
}

عام عرف سجل_عام_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    العام: معرف_عام_مسير,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه غ8,
    النطاق: نطاق,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_العام: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_العام: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    دع اسم_الربط: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    دع المعرف_المؤقت: معرف_عام_تصحيح = معرف_عام_تصحيح_من(0);
    دع رمز_العام: اختيار معرف_رمز = اختيار.بعض(الرمز);
    دع الوصف: عام_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_العام, الاسم: اسم_العام, اسم_الربط: اسم_الربط,
        النوع: النوع, الأصل: أصل_العام, قابل_للكتابة: صواب,
        إعلان_فقط: خطأ, علني: علني, اصطناعي: خطأ
    };
    دع معرف_التصحيح: معرف_عام_تصحيح = أضف_عام_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
    بينما ((الطول((*التصحيح_المتغير).العقد.العوام) مثل غير_موقع) <= العام.القيمة) {
        دع بلا_عام: اختيار معرف_عام_تصحيح = اختيار.لا_شيء();
        ألحق((*التصحيح_المتغير).العقد.العوام, بلا_عام);
    }
    (*التصحيح_المتغير).العقد.العوام[العام.القيمة] := اختيار.بعض(معرف_التصحيح);
}

عام عرف عام_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    العام: معرف_عام_مسير
): اختيار معرف_عام_تصحيح {
    لو (العام.القيمة >= (الطول((*العقد).العوام) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*العقد).العوام[العام.القيمة];
}

عام عرف سجل_ثابت_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه غ8,
    النطاق: نطاق,
    القيمة: اختيار قيمة_ثابت_تصحيح,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_الثابت: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_الثابت: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    دع المعرف_المؤقت: معرف_ثابت_تصحيح = معرف_ثابت_تصحيح_من(0);
    دع رمز_الثابت: اختيار معرف_رمز = اختيار.بعض(الرمز);
    دع الوصف: ثابت_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_الثابت, الاسم: اسم_الثابت,
        النوع: النوع, الأصل: أصل_الثابت, القيمة: القيمة, علني: علني, اصطناعي: خطأ
    };
    أضف_ثابت_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
}

عام عرف سجل_وحدات_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الوحدات: &متجه وحدة_دلالية,
    الخريطة: &خريطة_مصادر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الوحدات) مثل غير_موقع)) {
        دع الوحدة: &وحدة_دلالية = &(*الوحدات)[ف];
        لو ((*الوحدة).معرف_المصدر < (الطول((*الخريطة).المصادر) مثل غير_موقع)) {
            دع المصادر: &متجه مصدر = &(*الخريطة).المصادر;
            دع معرف_المصدر: غير_موقع = (*الوحدة).معرف_المصدر;
            دع المصدر: &مصدر = &(*المصادر)[معرف_المصدر];
            دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
            دع الاسم: متغير متجه غ8 = [];
            دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول(*مرجع_الاسم) مثل غير_موقع)) {
                ألحق(الاسم, (*مرجع_الاسم)[ب] مثل غ8);
                ب := ب + 1;
            }
            أضف_وحدة_تصحيح(
                &متغير (*التصحيح_المتغير).الدلالي, (*الوحدة).المعرف, &الاسم,
                (*الوحدة).معرف_المصدر, خطأ
            );
        };
        ف := ف + 1;
    }
}

عام عرف سجل_تصحيح_دالة_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الاسم: متجه غ8,
    النطاق: نطاق,
    أسماء_المعاملات: &متجه متجه غ8,
    نطاقات_المعاملات: &متجه نطاق,
    أنواع_المعاملات: &متجه معرف_نوع,
    الناتج: اختيار معرف_نوع,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_الدالة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_الربط: متجه غ8 = انسخ_اسم_تصحيح(&الاسم);
    دع معرف_التصحيح: معرف_دالة_تصحيح = أضف_دالة_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, الاسم, اسم_الربط, أصل_الدالة, الناتج, خطأ, علني, خطأ
    );
    اربط_دالة_تصحيح_بمسير(&متغير (*التصحيح_المتغير).العقد, الدالة, معرف_التصحيح);
    دع بلا_أب: اختيار معرف_نطاق_تصحيح = اختيار.لا_شيء();
    دع بلا_تضمين: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
    دع النطاق_الجذري: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, أصل_الدالة, النطاق, معرف_التصحيح, بلا_أب, بلا_تضمين
    );
    (*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].النطاق_الجذري := اختيار.بعض(النطاق_الجذري);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أنواع_المعاملات) مثل غير_موقع) && ف < (الطول(*أسماء_المعاملات) مثل غير_موقع) && ف < (الطول(*نطاقات_المعاملات) مثل غير_موقع)) {
        دع أصل_المعامل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, (*نطاقات_المعاملات)[ف]);
        دع اسم_المعامل: متجه غ8 = انسخ_اسم_تصحيح(&(*أسماء_المعاملات)[ف]);
        دع بلا_رمز: اختيار معرف_رمز = اختيار.لا_شيء();
        دع نوع_المعامل: معرف_نوع = (*أنواع_المعاملات)[ف];
        دع المتغير: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, بلا_رمز, اسم_المعامل, نوع_المعامل,
            أصل_المعامل, النطاق_الجذري, صنف_متغير_تصحيح.معامل(), خطأ
        );
        ألحق((*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].المعاملات, المتغير);
        دع الموقع: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, أصل_المعامل, اختيار.بعض(النطاق_الجذري), خطأ, خطأ, خطأ, 0
        );
        دع قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, ف);
        اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, قيمة_المعامل, المتغير, اختيار.بعض(الموقع));
        ف := ف + 1;
    }
}

عام عرف نطاق_جذري_لتصحيح_دالة_مسير(
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختيار معرف_نطاق_تصحيح {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المعرف) -> {
        لو (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
        أرجع (*التصحيح).الدلالي.الدوال[المعرف.القيمة].النطاق_الجذري;
    };
}

عام عرف سجل_نطاق_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    النطاق: نطاق,
    الأب: اختيار معرف_نطاق_تصحيح
): اختيار معرف_نطاق_تصحيح {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    طابق دالة_تصحيح_لمسير(&(*التصحيح_المتغير).العقد, الدالة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(معرف_الدالة) -> {
        دع الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
        طابق نطاق_تصحيح_لأصل(&(*التصحيح_المتغير).الدلالي, الأصل) مع
        | اختيار.بعض(الموجود) -> { أرجع اختيار.بعض(الموجود); }
        | اختيار.لا_شيء -> { };
        دع بلا_تضمين: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
        دع المعرف: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, الأصل, النطاق, معرف_الدالة, الأب, بلا_تضمين
        );
        ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
        دع الربط: ربط_نطاق_مصدر_تصحيح = {
            المصدر: النطاق.البداية.المصدر,
            البداية: النطاق.البداية.البايت,
            النهاية: النطاق.النهاية.البايت,
            النطاق: المعرف
        };
        ألحق((*التصحيح_المتغير).العقد.نطاقات_المصدر[الدالة.القيمة], الربط);
        أرجع اختيار.بعض(المعرف);
    };
}

عام عرف نطاق_تصحيح_لنطاق_مصدر(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    المدى: نطاق
): اختيار معرف_نطاق_تصحيح {
    لو (الدالة.القيمة >= (الطول((*العقد).نطاقات_المصدر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع القيم: &متجه ربط_نطاق_مصدر_تصحيح = &(*العقد).نطاقات_المصدر[الدالة.القيمة];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيم) مثل غير_موقع)) {
        لو ((*القيم)[ف].المصدر == المدى.البداية.المصدر
            && (*القيم)[ف].البداية == المدى.البداية.البايت
            && (*القيم)[ف].النهاية == المدى.النهاية.البايت) {
            أرجع اختيار.بعض((*القيم)[ف].النطاق);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف سجل_متغير_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    الاسم: متجه غ8,
    النوع: معرف_نوع,
    نطاق_التصريح: نطاق,
    نطاق_الإحاطة: معرف_نطاق_تصحيح
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, نطاق_التصريح);
    دع اسم_المتغير: متجه غ8 = انسخ_اسم_تصحيح(&الاسم);
    دع بعض_الرمز: اختيار معرف_رمز = اختيار.بعض(الرمز);
    دع المعرف: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, بعض_الرمز, اسم_المتغير, النوع, الأصل,
        نطاق_الإحاطة, صنف_متغير_تصحيح.محلي(), خطأ
    );
    ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
    دع فهرس_الدالة: غير_موقع = الدالة.القيمة;
    بينما ((الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز[فهرس_الدالة]) مثل غير_موقع) <= الرمز.القيمة) {
        دع فارغ: اختيار معرف_متغير_تصحيح = اختيار.لا_شيء(); ألحق((*التصحيح_المتغير).العقد.متغيرات_بالرمز[فهرس_الدالة], فارغ);
    }
    (*التصحيح_المتغير).العقد.متغيرات_بالرمز[فهرس_الدالة][الرمز.القيمة] := اختيار.بعض(المعرف);
}

عام عرف اربط_رمز_بقيمة_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    القيمة: معرف_قيمة_مسير,
    الموقع: اختيار معرف_موقع_تصحيح
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    لو (الدالة.القيمة >= (الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز) مثل غير_موقع)) { أرجع; };
    لو (الرمز.القيمة >= (الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة]) مثل غير_موقع)) { أرجع; };
    دع الربط: اختيار معرف_متغير_تصحيح = (*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة][الرمز.القيمة];
    طابق الربط مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(المتغير) -> { اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, القيمة, المتغير, الموقع); };
}
