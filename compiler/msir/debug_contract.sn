استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.debuginfo.location;
استورد compiler.debuginfo.scope;
استورد compiler.debuginfo.function;
استورد compiler.debuginfo.variable;
استورد compiler.debuginfo.types;
استورد compiler.debuginfo.global;
استورد compiler.debuginfo.module;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.provenance;
استورد compiler.source.span;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.source_file;

عام نوع سلوك_تحويل_تصحيح_مسير =
    | حفظ
    | استبدال بنوع معرف_موقع_تصحيح
    | دمج بنوع معرف_موقع_تصحيح
    | إسقاط
;

عام نوع ربط_نطاق_مصدر_تصحيح = {
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    النطاق: معرف_نطاق_تصحيح
};

// Debug variables of one MSIR function keyed by source symbol ID. Symbol IDs
// are program-wide while one function's symbols form a narrow range, so the
// dense table starts at the function's smallest symbol instead of ID zero
// (indexing from zero cost every function a table as large as the program's
// symbol count).
عام نوع جدول_رموز_متغيرات_تصحيح = {
    البداية: طبيعي,
    المتغيرات: متجه اختياري معرف_متغير_تصحيح
};

// The place of a source local (every local lowering declares has one,
// msir_model.sn, مكان_محلي_مسير): its function, source symbol and slot (the
// place value). The pipeline binds the slot of a local that is not an owner
// to its variable (اربط_أماكن_محليات_تصحيح_مسير): at -O0 it is the
// variable's memory for the rest of the function; at other levels the
// binding comes before promotion, which passes it to the values stored into
// the slot and to the block parameters it adds, and a slot it keeps stays the
// variable's memory. An owner's slot is recorded with its symbol but not
// bound: its value is valid only while the owner holds one.
عام نوع مكان_محلي_تصحيح_مسير = {
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    المكان: معرف_قيمة_مسير,
    الموقع: اختياري معرف_موقع_تصحيح,
    المالك: منطقي
};

// Compact MSIR bridge. Rich records stay in compiler/debuginfo; this contract only
// maps dense MSIR identities to stable debug identities.
عام نوع عقد_تصحيح_مسير = {
    دوال: متجه اختياري معرف_دالة_تصحيح,
    متغيرات_القيم: متجه متجه متجه معرف_متغير_تصحيح,
    مواقع_القيم: متجه متجه اختياري معرف_موقع_تصحيح,
    متغيرات_بالرمز: متجه جدول_رموز_متغيرات_تصحيح,
    نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح,
    العوام: متجه اختياري معرف_عام_تصحيح,
    أماكن_المحليات: متجه مكان_محلي_تصحيح_مسير,
    أماكن_المعاملات: متجه مكان_معامل_تصحيح_مسير
};

// A parameter lowering keeps in a frame slot (an owned aggregate's owner
// slot, which the incoming bytes are copied into): the parameter's value and
// its slot. Above -O0 the slot has the parameter's variables
// (اربط_أماكن_معاملات_تصحيح_مسير): where the incoming value is gone, the
// debugger reads the slot. At -O0 the parameter's value stays live where its
// variable is in scope, so the record is not used (and -O0 code, whose
// liveness follows the debug bindings, is unchanged).
عام نوع مكان_معامل_تصحيح_مسير = {
    المعامل: معرف_قيمة_مسير,
    المكان: معرف_قيمة_مسير
};

عام نوع بيانات_تصحيح_مسير = {
    الدلالي: سياق_تصحيح,
    العقد: عقد_تصحيح_مسير
};

عام عرف بيانات_تصحيح_مسير_جديدة(): بيانات_تصحيح_مسير {
    ليكن الدلالي: سياق_تصحيح = سياق_تصحيح_جديد();
    ليكن الدوال: متجه اختياري معرف_دالة_تصحيح = [];
    ليكن المتغيرات: متجه متجه متجه معرف_متغير_تصحيح = [];
    ليكن المواقع: متجه متجه اختياري معرف_موقع_تصحيح = [];
    ليكن بالرمز: متجه جدول_رموز_متغيرات_تصحيح = [];
    ليكن نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح = [];
    ليكن العوام: متجه اختياري معرف_عام_تصحيح = [];
    ليكن أماكن_المحليات: متجه مكان_محلي_تصحيح_مسير = [];
    ليكن أماكن_المعاملات: متجه مكان_معامل_تصحيح_مسير = [];
    ليكن العقد: عقد_تصحيح_مسير = {
        دوال: الدوال,
        متغيرات_القيم: المتغيرات,
        مواقع_القيم: المواقع,
        متغيرات_بالرمز: بالرمز,
        نطاقات_المصدر: نطاقات_المصدر,
        العوام: العوام,
        أماكن_المحليات: أماكن_المحليات,
        أماكن_المعاملات: أماكن_المعاملات
    };
    ليكن البيانات: بيانات_تصحيح_مسير = { الدلالي: الدلالي, العقد: العقد };
    أرجع البيانات;
}

عرف ضمن_دالة_تصحيح_مسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): فراغ {
    طالما ((الطول((*العقد).دوال) مثل طبيعي) <= (الدالة.القيمة مثل طبيعي)) {
        ليكن بلا_دالة: اختياري معرف_دالة_تصحيح = اختياري.لا_شيء();
        ليكن متغيرات_فارغة: متجه متجه معرف_متغير_تصحيح = [];
        ليكن مواقع_فارغة: متجه اختياري معرف_موقع_تصحيح = [];
        ألحق((*العقد).دوال, بلا_دالة);
        ألحق((*العقد).متغيرات_القيم, متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم, مواقع_فارغة);
        ليكن رموز_فارغة: متجه اختياري معرف_متغير_تصحيح = [];
        ليكن جدول_فارغ: جدول_رموز_متغيرات_تصحيح = { البداية: 0, المتغيرات: رموز_فارغة };
        ألحق((*العقد).متغيرات_بالرمز, جدول_فارغ);
        ليكن نطاقات_فارغة: متجه ربط_نطاق_مصدر_تصحيح = [];
        ألحق((*العقد).نطاقات_المصدر, نطاقات_فارغة);
    }
}

عام عرف اربط_دالة_تصحيح_بمسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    التصحيح: معرف_دالة_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, الدالة);
    (*العقد).دوال[الدالة.القيمة] := اختياري.موجود(التصحيح);
}

عام عرف دالة_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختياري معرف_دالة_تصحيح {
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).دوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*العقد).دوال[الدالة.القيمة];
}

عام عرف اربط_قيمة_بمتغير_تصحيح(
    العقد: &متغير عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير,
    المتغير: معرف_متغير_تصحيح,
    الموقع: اختياري معرف_موقع_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, القيمة.الدالة);
    ليكن فهرس_الدالة: طبيعي = القيمة.الدالة.القيمة;
    طالما ((الطول((*العقد).متغيرات_القيم[فهرس_الدالة]) مثل طبيعي) <= (القيمة.القيمة مثل طبيعي)) {
        ليكن متغيرات_فارغة: متجه معرف_متغير_تصحيح = [];
        ليكن بلا_موقع: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
        ألحق((*العقد).متغيرات_القيم[فهرس_الدالة], متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم[فهرس_الدالة], بلا_موقع);
    }
    ألحق((*العقد).متغيرات_القيم[فهرس_الدالة][القيمة.القيمة], المتغير);
    (*العقد).مواقع_القيم[فهرس_الدالة][القيمة.القيمة] := الموقع;
}

عام عرف متغيرات_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): متجه معرف_متغير_تصحيح {
    إذا ((القيمة.الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).متغيرات_القيم) مثل طبيعي)) {
        ليكن فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة;
    };
    ليكن جدول: &متجه متجه معرف_متغير_تصحيح = &(*العقد).متغيرات_القيم[القيمة.الدالة.القيمة];
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*جدول) مثل طبيعي)) { ليكن فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة; };
    ليكن المتغيرات: &متجه معرف_متغير_تصحيح = &(*جدول)[القيمة.القيمة];
    ليكن النسخة: متجه معرف_متغير_تصحيح = انسخ_مملوكا_متجه_معرف_متغير_تصحيح(المتغيرات);
    أرجع النسخة;
}

عام عرف موقع_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): اختياري معرف_موقع_تصحيح {
    إذا ((القيمة.الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).مواقع_القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن جدول: &متجه اختياري معرف_موقع_تصحيح = &(*العقد).مواقع_القيم[القيمة.الدالة.القيمة];
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*جدول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*جدول)[القيمة.القيمة];
}

عام عرف سجل_تصحيح_نوع_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الرمز: معرف_رمز,
    الاسم: &متجه ط8,
    أسماء_الأعضاء: &متجه متجه ط8,
    أسماء_البدائل: &متجه متجه ط8,
    أسماء_معاملات_النوع: &متجه متجه ط8,
    الأصل: اختياري معرف_أصل_مصدر
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن الدلالي: &متغير سياق_تصحيح = &متغير (*التصحيح_المتغير).الدلالي;
    طابق معرف_نوع_تصحيح_لنوع(الدلالي, النوع) مع
    | اختياري.موجود(_) -> { أرجع; }
    | اختياري.لا_شيء -> { };
    ليكن اسم_النوع: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    ليكن الأعضاء: متغير متجه اسم_عضو_تصحيح_نوع = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أسماء_الأعضاء) مثل طبيعي)) {
        ليكن الاسم_المنسوخ: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_الأعضاء)[ف]);
        ليكن العضو: اسم_عضو_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(الأعضاء, العضو); ف := ف + 1;
    }
    ليكن البدائل: متغير متجه اسم_بديل_تصحيح_نوع = [];
    ف := 0;
    طالما (ف < (الطول(*أسماء_البدائل) مثل طبيعي)) {
        ليكن الاسم_المنسوخ: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_البدائل)[ف]);
        ليكن البديل: اسم_بديل_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(البدائل, البديل); ف := ف + 1;
    }
    ليكن معاملات: متجه معرف_نوع = [];
    ليكن أسماء_المعاملات: متغير متجه متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(*أسماء_معاملات_النوع) مثل طبيعي)) {
        ليكن اسم_المعامل: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_معاملات_النوع)[ف]);
        ألحق(أسماء_المعاملات, اسم_المعامل);
        ف := ف + 1;
    }
    ليكن بلا_اسم_مستعار: اختياري معرف_نوع = اختياري.لا_شيء();
    أضف_نوع_تصحيح(
        الدلالي, النوع, اختياري.موجود(الرمز), اسم_النوع,
        الأعضاء, البدائل, معاملات, أسماء_المعاملات, بلا_اسم_مستعار, الأصل, خطأ
    );
}

عام عرف سجل_اسم_مستعار_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع_الهدف: معرف_نوع,
    الاسم: &متجه ط8,
    الأصل: اختياري معرف_أصل_مصدر
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن اسم_النوع: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    أضف_اسم_مستعار_نوع_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, النوع_الهدف, اسم_النوع, الأصل, خطأ);
}

عام عرف سجل_عام_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    العام: معرف_عام_مسير,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه ط8,
    النطاق: نطاق,
    علني: منطقي
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن أصل_العام: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    ليكن اسم_العام: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    ليكن اسم_الربط: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    ليكن المعرف_المؤقت: معرف_عام_تصحيح = معرف_عام_تصحيح_من(0);
    ليكن رمز_العام: اختياري معرف_رمز = اختياري.موجود(الرمز);
    ليكن الوصف: عام_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_العام, الاسم: اسم_العام, اسم_الربط: اسم_الربط,
        النوع: النوع, الأصل: أصل_العام, قابل_للكتابة: صواب,
        إعلان_فقط: خطأ, علني: علني, اصطناعي: خطأ
    };
    ليكن معرف_التصحيح: معرف_عام_تصحيح = أضف_عام_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
    طالما ((الطول((*التصحيح_المتغير).العقد.العوام) مثل طبيعي) <= (العام.القيمة مثل طبيعي)) {
        ليكن بلا_عام: اختياري معرف_عام_تصحيح = اختياري.لا_شيء();
        ألحق((*التصحيح_المتغير).العقد.العوام, بلا_عام);
    }
    (*التصحيح_المتغير).العقد.العوام[العام.القيمة] := اختياري.موجود(معرف_التصحيح);
}

عام عرف عام_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    العام: معرف_عام_مسير
): اختياري معرف_عام_تصحيح {
    إذا ((العام.القيمة مثل طبيعي) >= (الطول((*العقد).العوام) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*العقد).العوام[العام.القيمة];
}

عام عرف سجل_ثابت_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه ط8,
    النطاق: نطاق,
    القيمة: اختياري قيمة_ثابت_تصحيح,
    علني: منطقي
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن أصل_الثابت: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    ليكن اسم_الثابت: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    ليكن المعرف_المؤقت: معرف_ثابت_تصحيح = معرف_ثابت_تصحيح_من(0);
    ليكن رمز_الثابت: اختياري معرف_رمز = اختياري.موجود(الرمز);
    ليكن الوصف: ثابت_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_الثابت, الاسم: اسم_الثابت,
        النوع: النوع, الأصل: أصل_الثابت, القيمة: القيمة, علني: علني, اصطناعي: خطأ
    };
    أضف_ثابت_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
}

عام عرف سجل_وحدات_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الوحدات: &متجه وحدة_دلالية,
    الخريطة: &خريطة_مصادر
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ليكن الوحدة: &وحدة_دلالية = &(*الوحدات)[ف];
        إذا ((*الوحدة).معرف_المصدر < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
            ليكن المصادر: &متجه مصدر = &(*الخريطة).المصادر;
            ليكن معرف_المصدر: طبيعي = (*الوحدة).معرف_المصدر;
            ليكن المصدر: &مصدر = &(*المصادر)[معرف_المصدر];
            ليكن مرجع_الاسم: &نص = &(*المصدر).الاسم;
            ليكن الاسم: متغير متجه ط8 = [];
            ليكن ب: متغير طبيعي = 0;
            طالما (ب < (الطول(*مرجع_الاسم) مثل طبيعي)) {
                ألحق(الاسم, (*مرجع_الاسم)[ب] مثل ط8);
                ب := ب + 1;
            }
            أضف_وحدة_تصحيح(
                &متغير (*التصحيح_المتغير).الدلالي, (*الوحدة).المعرف, &الاسم,
                (*الوحدة).معرف_المصدر, خطأ
            );
        };
        ف := ف + 1;
    }
}

عام عرف سجل_تصحيح_دالة_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الاسم: متجه ط8,
    النطاق: نطاق,
    أسماء_المعاملات: &متجه متجه ط8,
    نطاقات_المعاملات: &متجه نطاق,
    أنواع_المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع,
    علني: منطقي
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن أصل_الدالة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    ليكن اسم_الربط: متجه ط8 = انسخ_اسم_تصحيح(&الاسم);
    ليكن معرف_التصحيح: معرف_دالة_تصحيح = أضف_دالة_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, الاسم, اسم_الربط, أصل_الدالة, الناتج, خطأ, علني, خطأ
    );
    اربط_دالة_تصحيح_بمسير(&متغير (*التصحيح_المتغير).العقد, الدالة, معرف_التصحيح);
    ليكن بلا_أب: اختياري معرف_نطاق_تصحيح = اختياري.لا_شيء();
    ليكن بلا_تضمين: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
    ليكن النطاق_الجذري: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, أصل_الدالة, النطاق, معرف_التصحيح, بلا_أب, بلا_تضمين
    );
    (*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].النطاق_الجذري := اختياري.موجود(النطاق_الجذري);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أنواع_المعاملات) مثل طبيعي) && ف < (الطول(*أسماء_المعاملات) مثل طبيعي) && ف < (الطول(*نطاقات_المعاملات) مثل طبيعي)) {
        ليكن أصل_المعامل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, (*نطاقات_المعاملات)[ف]);
        ليكن اسم_المعامل: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_المعاملات)[ف]);
        ليكن بلا_رمز: اختياري معرف_رمز = اختياري.لا_شيء();
        ليكن نوع_المعامل: معرف_نوع = (*أنواع_المعاملات)[ف];
        ليكن المتغير: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, بلا_رمز, اسم_المعامل, نوع_المعامل,
            أصل_المعامل, النطاق_الجذري, صنف_متغير_تصحيح.معامل(), خطأ
        );
        ألحق((*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].المعاملات, المتغير);
        ليكن الموقع: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, أصل_المعامل, اختياري.موجود(النطاق_الجذري), خطأ, خطأ, خطأ, 0
        );
        ليكن قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, ف);
        اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, قيمة_المعامل, المتغير, اختياري.موجود(الموقع));
        ف := ف + 1;
    }
}

عام عرف نطاق_جذري_لتصحيح_دالة_مسير(
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختياري معرف_نطاق_تصحيح {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع (*التصحيح).الدلالي.الدوال[المعرف.القيمة].النطاق_الجذري;
    };
}

عام عرف سجل_نطاق_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    النطاق: نطاق,
    الأب: اختياري معرف_نطاق_تصحيح
): اختياري معرف_نطاق_تصحيح {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    طابق دالة_تصحيح_لمسير(&(*التصحيح_المتغير).العقد, الدالة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(معرف_الدالة) -> {
        ليكن الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
        طابق نطاق_تصحيح_لأصل(&(*التصحيح_المتغير).الدلالي, الأصل) مع
        | اختياري.موجود(الموجود) -> { أرجع اختياري.موجود(الموجود); }
        | اختياري.لا_شيء -> { };
        ليكن بلا_تضمين: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
        ليكن المعرف: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, الأصل, النطاق, معرف_الدالة, الأب, بلا_تضمين
        );
        ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
        ليكن الربط: ربط_نطاق_مصدر_تصحيح = {
            المصدر: النطاق.البداية.المصدر,
            البداية: النطاق.البداية.البايت,
            النهاية: النطاق.النهاية.البايت,
            النطاق: المعرف
        };
        ألحق((*التصحيح_المتغير).العقد.نطاقات_المصدر[الدالة.القيمة], الربط);
        أرجع اختياري.موجود(المعرف);
    };
}

عام عرف نطاق_تصحيح_لنطاق_مصدر(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    المدى: نطاق
): اختياري معرف_نطاق_تصحيح {
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).نطاقات_المصدر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن القيم: &متجه ربط_نطاق_مصدر_تصحيح = &(*العقد).نطاقات_المصدر[الدالة.القيمة];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا ((*القيم)[ف].المصدر == (المدى.البداية.المصدر مثل طبيعي)
            && (*القيم)[ف].البداية == (المدى.البداية.البايت مثل طبيعي)
            && (*القيم)[ف].النهاية == (المدى.النهاية.البايت مثل طبيعي)) {
            أرجع اختياري.موجود((*القيم)[ف].النطاق);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف سجل_متغير_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    الاسم: متجه ط8,
    النوع: معرف_نوع,
    نطاق_التصريح: نطاق,
    نطاق_الإحاطة: معرف_نطاق_تصحيح
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    ليكن الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, نطاق_التصريح);
    // The name is the caller's own copy: it moves into the record as it is.
    ليكن بعض_الرمز: اختياري معرف_رمز = اختياري.موجود(الرمز);
    ليكن المعرف: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, بعض_الرمز, الاسم, النوع, الأصل,
        نطاق_الإحاطة, صنف_متغير_تصحيح.محلي(), خطأ
    );
    ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
    ليكن فهرس_الدالة: طبيعي = الدالة.القيمة;
    ليكن الجدول: &متغير جدول_رموز_متغيرات_تصحيح = &متغير (*التصحيح_المتغير).العقد.متغيرات_بالرمز[فهرس_الدالة];
    إذا ((الطول((*الجدول).المتغيرات) مثل طبيعي) == 0) {
        (*الجدول).البداية := الرمز.القيمة;
    } وإلا إذا ((الرمز.القيمة مثل طبيعي) < (*الجدول).البداية) {
        // Rebase once for a symbol below the current range.
        ليكن الموسع: متغير متجه اختياري معرف_متغير_تصحيح = [];
        ليكن ف: متغير طبيعي = الرمز.القيمة;
        طالما (ف < (*الجدول).البداية) {
            ليكن فارغ: اختياري معرف_متغير_تصحيح = اختياري.لا_شيء();
            ألحق(الموسع, فارغ);
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول((*الجدول).المتغيرات) مثل طبيعي)) {
            ليكن القديم: اختياري معرف_متغير_تصحيح = (*الجدول).المتغيرات[ف];
            ألحق(الموسع, القديم);
            ف := ف + 1;
        }
        (*الجدول).المتغيرات := الموسع;
        (*الجدول).البداية := الرمز.القيمة;
    };
    ليكن الموضع: طبيعي = (الرمز.القيمة مثل طبيعي) - (*الجدول).البداية;
    طالما ((الطول((*الجدول).المتغيرات) مثل طبيعي) <= الموضع) {
        ليكن فارغ: اختياري معرف_متغير_تصحيح = اختياري.لا_شيء(); ألحق((*الجدول).المتغيرات, فارغ);
    }
    (*الجدول).المتغيرات[الموضع] := اختياري.موجود(المعرف);
}

عام عرف اربط_رمز_بقيمة_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    القيمة: معرف_قيمة_مسير,
    الموقع: اختياري معرف_موقع_تصحيح
): فراغ {
    ليكن التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز) مثل طبيعي)) { أرجع; };
    // Plain values only: no borrow of the table outlives the lookup.
    ليكن البداية: طبيعي = (*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].البداية;
    ليكن الطول_المسجل: طبيعي =
        الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].المتغيرات) مثل طبيعي;
    إذا ((الرمز.القيمة مثل طبيعي) < البداية) { أرجع; };
    إذا ((الرمز.القيمة مثل طبيعي) - البداية >= الطول_المسجل) { أرجع; };
    ليكن الربط: اختياري معرف_متغير_تصحيح =
        (*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].المتغيرات[(الرمز.القيمة مثل طبيعي) - البداية];
    طابق الربط مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المتغير) -> { اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, القيمة, المتغير, الموقع); };
}

// Records a parameter kept in a frame slot (مكان_معامل_تصحيح_مسير).
عام عرف سجل_مكان_معامل_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    المعامل: معرف_قيمة_مسير,
    المكان: معرف_قيمة_مسير
): فراغ {
    ليكن السجل: مكان_معامل_تصحيح_مسير = { المعامل: المعامل, المكان: المكان };
    ألحق((*التصحيح).العقد.أماكن_المعاملات, السجل);
}

// Above -O0 (msir_optimization_pipeline.sn): each parameter's slot has the
// parameter's variables.
عام عرف اربط_أماكن_معاملات_تصحيح_مسير(التصحيح: &متغير بيانات_تصحيح_مسير): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التصحيح).العقد.أماكن_المعاملات) مثل طبيعي)) {
        ليكن السجل: مكان_معامل_تصحيح_مسير = (*التصحيح).العقد.أماكن_المعاملات[ف];
        ليكن المتغيرات: متجه معرف_متغير_تصحيح = متغيرات_تصحيح_لقيمة(&(*التصحيح).العقد, السجل.المعامل);
        ليكن الموقع: اختياري معرف_موقع_تصحيح = موقع_تصحيح_لقيمة(&(*التصحيح).العقد, السجل.المعامل);
        ليكن م: متغير طبيعي = 0;
        طالما (م < (الطول(المتغيرات) مثل طبيعي)) {
            اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح).العقد, السجل.المكان, المتغيرات[م], الموقع);
            م := م + 1;
        }
        ف := ف + 1;
    }
}

// Records the place of a source local (مكان_محلي_تصحيح_مسير).
عام عرف سجل_مكان_محلي_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    المكان: معرف_قيمة_مسير,
    الموقع: اختياري معرف_موقع_تصحيح,
    المالك: منطقي
): فراغ {
    ليكن السجل: مكان_محلي_تصحيح_مسير = {
        الدالة: الدالة, الرمز: الرمز, المكان: المكان, الموقع: الموقع, المالك: المالك
    };
    ألحق((*التصحيح).العقد.أماكن_المحليات, السجل);
}

// Each local's slot, but an owner's, is bound to its variable
// (msir_optimization_pipeline.sn, every level): at -O0 its memory for the
// rest of the function, so a debugger reads the variable in the loop on every
// iteration; at other levels before promotion (see مكان_محلي_تصحيح_مسير).
عام عرف اربط_أماكن_محليات_تصحيح_مسير(التصحيح: &متغير بيانات_تصحيح_مسير): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التصحيح).العقد.أماكن_المحليات) مثل طبيعي)) {
        ليكن السجل: مكان_محلي_تصحيح_مسير = (*التصحيح).العقد.أماكن_المحليات[ف];
        إذا (!السجل.المالك) {
            اربط_رمز_بقيمة_تصحيح_مسير(التصحيح, السجل.الدالة, السجل.الرمز, السجل.المكان, السجل.الموقع);
        };
        ف := ف + 1;
    }
}
