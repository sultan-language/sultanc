استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.debuginfo.location;
استورد compiler.debuginfo.scope;
استورد compiler.debuginfo.function;
استورد compiler.debuginfo.variable;
استورد compiler.debuginfo.types;
استورد compiler.debuginfo.global;
استورد compiler.debuginfo.module;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.modules;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.provenance;
استورد compiler.source.span;
استورد compiler.msir.identifiers;
استورد compiler.source.source_map;
استورد compiler.source.source_file;

عام نوع سلوك_تحويل_تصحيح_مسير =
    | حفظ
    | استبدال بنوع معرف_موقع_تصحيح
    | دمج بنوع معرف_موقع_تصحيح
    | إسقاط
;

عام نوع ربط_نطاق_مصدر_تصحيح = {
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    النطاق: معرف_نطاق_تصحيح
};

// Debug variables of one MSIR function keyed by source symbol ID. Symbol IDs
// are program-wide while one function's symbols form a narrow range, so the
// dense table starts at the function's smallest symbol instead of ID zero
// (indexing from zero cost every function a table as large as the program's
// symbol count).
عام نوع جدول_رموز_متغيرات_تصحيح = {
    البداية: طبيعي,
    المتغيرات: متجه اختياري معرف_متغير_تصحيح
};

// Compact MSIR bridge. Rich records stay in compiler/debuginfo; this contract only
// maps dense MSIR identities to stable debug identities.
عام نوع عقد_تصحيح_مسير = {
    دوال: متجه اختياري معرف_دالة_تصحيح,
    متغيرات_القيم: متجه متجه متجه معرف_متغير_تصحيح,
    مواقع_القيم: متجه متجه اختياري معرف_موقع_تصحيح,
    متغيرات_بالرمز: متجه جدول_رموز_متغيرات_تصحيح,
    نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح,
    العوام: متجه اختياري معرف_عام_تصحيح
};

عام نوع بيانات_تصحيح_مسير = {
    الدلالي: سياق_تصحيح,
    العقد: عقد_تصحيح_مسير
};

عام عرف بيانات_تصحيح_مسير_جديدة(): بيانات_تصحيح_مسير {
    دع الدلالي: سياق_تصحيح = سياق_تصحيح_جديد();
    دع الدوال: متجه اختياري معرف_دالة_تصحيح = [];
    دع المتغيرات: متجه متجه متجه معرف_متغير_تصحيح = [];
    دع المواقع: متجه متجه اختياري معرف_موقع_تصحيح = [];
    دع بالرمز: متجه جدول_رموز_متغيرات_تصحيح = [];
    دع نطاقات_المصدر: متجه متجه ربط_نطاق_مصدر_تصحيح = [];
    دع العوام: متجه اختياري معرف_عام_تصحيح = [];
    دع العقد: عقد_تصحيح_مسير = {
        دوال: الدوال,
        متغيرات_القيم: المتغيرات,
        مواقع_القيم: المواقع,
        متغيرات_بالرمز: بالرمز,
        نطاقات_المصدر: نطاقات_المصدر,
        العوام: العوام
    };
    دع البيانات: بيانات_تصحيح_مسير = { الدلالي: الدلالي, العقد: العقد };
    أرجع البيانات;
}

عرف ضمن_دالة_تصحيح_مسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): فراغ {
    طالما ((الطول((*العقد).دوال) مثل طبيعي) <= (الدالة.القيمة مثل طبيعي)) {
        دع بلا_دالة: اختياري معرف_دالة_تصحيح = اختياري.لا_شيء();
        دع متغيرات_فارغة: متجه متجه معرف_متغير_تصحيح = [];
        دع مواقع_فارغة: متجه اختياري معرف_موقع_تصحيح = [];
        ألحق((*العقد).دوال, بلا_دالة);
        ألحق((*العقد).متغيرات_القيم, متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم, مواقع_فارغة);
        دع رموز_فارغة: متجه اختياري معرف_متغير_تصحيح = [];
        دع جدول_فارغ: جدول_رموز_متغيرات_تصحيح = { البداية: 0, المتغيرات: رموز_فارغة };
        ألحق((*العقد).متغيرات_بالرمز, جدول_فارغ);
        دع نطاقات_فارغة: متجه ربط_نطاق_مصدر_تصحيح = [];
        ألحق((*العقد).نطاقات_المصدر, نطاقات_فارغة);
    }
}

عام عرف اربط_دالة_تصحيح_بمسير(
    العقد: &متغير عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    التصحيح: معرف_دالة_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, الدالة);
    (*العقد).دوال[الدالة.القيمة] := اختياري.موجود(التصحيح);
}

عام عرف دالة_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختياري معرف_دالة_تصحيح {
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).دوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*العقد).دوال[الدالة.القيمة];
}

عام عرف اربط_قيمة_بمتغير_تصحيح(
    العقد: &متغير عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير,
    المتغير: معرف_متغير_تصحيح,
    الموقع: اختياري معرف_موقع_تصحيح
): فراغ {
    ضمن_دالة_تصحيح_مسير(العقد, القيمة.الدالة);
    دع فهرس_الدالة: طبيعي = القيمة.الدالة.القيمة;
    طالما ((الطول((*العقد).متغيرات_القيم[فهرس_الدالة]) مثل طبيعي) <= (القيمة.القيمة مثل طبيعي)) {
        دع متغيرات_فارغة: متجه معرف_متغير_تصحيح = [];
        دع بلا_موقع: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
        ألحق((*العقد).متغيرات_القيم[فهرس_الدالة], متغيرات_فارغة);
        ألحق((*العقد).مواقع_القيم[فهرس_الدالة], بلا_موقع);
    }
    ألحق((*العقد).متغيرات_القيم[فهرس_الدالة][القيمة.القيمة], المتغير);
    (*العقد).مواقع_القيم[فهرس_الدالة][القيمة.القيمة] := الموقع;
}

عام عرف متغيرات_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): متجه معرف_متغير_تصحيح {
    إذا ((القيمة.الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).متغيرات_القيم) مثل طبيعي)) {
        دع فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة;
    };
    دع جدول: &متجه متجه معرف_متغير_تصحيح = &(*العقد).متغيرات_القيم[القيمة.الدالة.القيمة];
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*جدول) مثل طبيعي)) { دع فارغة: متجه معرف_متغير_تصحيح = []; أرجع فارغة; };
    دع المتغيرات: &متجه معرف_متغير_تصحيح = &(*جدول)[القيمة.القيمة];
    دع النسخة: متجه معرف_متغير_تصحيح = انسخ_مملوكا_متجه_معرف_متغير_تصحيح(المتغيرات);
    أرجع النسخة;
}

عام عرف موقع_تصحيح_لقيمة(
    العقد: &عقد_تصحيح_مسير,
    القيمة: معرف_قيمة_مسير
): اختياري معرف_موقع_تصحيح {
    إذا ((القيمة.الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).مواقع_القيم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع جدول: &متجه اختياري معرف_موقع_تصحيح = &(*العقد).مواقع_القيم[القيمة.الدالة.القيمة];
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*جدول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*جدول)[القيمة.القيمة];
}


عام عرف سجل_تصحيح_نوع_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع: معرف_نوع,
    الرمز: معرف_رمز,
    الاسم: &متجه ط8,
    أسماء_الأعضاء: &متجه متجه ط8,
    أسماء_البدائل: &متجه متجه ط8,
    أسماء_معاملات_النوع: &متجه متجه ط8,
    الأصل: اختياري معرف_أصل_مصدر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع الدلالي: &متغير سياق_تصحيح = &متغير (*التصحيح_المتغير).الدلالي;
    طابق معرف_نوع_تصحيح_لنوع(الدلالي, النوع) مع
    | اختياري.موجود(_) -> { أرجع; }
    | اختياري.لا_شيء -> { };
    دع اسم_النوع: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    دع الأعضاء: متغير متجه اسم_عضو_تصحيح_نوع = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أسماء_الأعضاء) مثل طبيعي)) {
        دع الاسم_المنسوخ: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_الأعضاء)[ف]);
        دع العضو: اسم_عضو_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(الأعضاء, العضو); ف := ف + 1;
    }
    دع البدائل: متغير متجه اسم_بديل_تصحيح_نوع = [];
    ف := 0;
    طالما (ف < (الطول(*أسماء_البدائل) مثل طبيعي)) {
        دع الاسم_المنسوخ: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_البدائل)[ف]);
        دع البديل: اسم_بديل_تصحيح_نوع = { الفهرس: ف, الاسم: الاسم_المنسوخ };
        ألحق(البدائل, البديل); ف := ف + 1;
    }
    دع معاملات: متجه معرف_نوع = [];
    دع أسماء_المعاملات: متغير متجه متجه ط8 = [];
    ف := 0;
    طالما (ف < (الطول(*أسماء_معاملات_النوع) مثل طبيعي)) {
        دع اسم_المعامل: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_معاملات_النوع)[ف]);
        ألحق(أسماء_المعاملات, اسم_المعامل);
        ف := ف + 1;
    }
    دع بلا_اسم_مستعار: اختياري معرف_نوع = اختياري.لا_شيء();
    أضف_نوع_تصحيح(
        الدلالي, النوع, اختياري.موجود(الرمز), اسم_النوع,
        الأعضاء, البدائل, معاملات, أسماء_المعاملات, بلا_اسم_مستعار, الأصل, خطأ
    );
}

عام عرف سجل_اسم_مستعار_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    النوع_الهدف: معرف_نوع,
    الاسم: &متجه ط8,
    الأصل: اختياري معرف_أصل_مصدر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع اسم_النوع: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    أضف_اسم_مستعار_نوع_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, النوع_الهدف, اسم_النوع, الأصل, خطأ);
}

عام عرف سجل_عام_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    العام: معرف_عام_مسير,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه ط8,
    النطاق: نطاق,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_العام: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_العام: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    دع اسم_الربط: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    دع المعرف_المؤقت: معرف_عام_تصحيح = معرف_عام_تصحيح_من(0);
    دع رمز_العام: اختياري معرف_رمز = اختياري.موجود(الرمز);
    دع الوصف: عام_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_العام, الاسم: اسم_العام, اسم_الربط: اسم_الربط,
        النوع: النوع, الأصل: أصل_العام, قابل_للكتابة: صواب,
        إعلان_فقط: خطأ, علني: علني, اصطناعي: خطأ
    };
    دع معرف_التصحيح: معرف_عام_تصحيح = أضف_عام_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
    طالما ((الطول((*التصحيح_المتغير).العقد.العوام) مثل طبيعي) <= (العام.القيمة مثل طبيعي)) {
        دع بلا_عام: اختياري معرف_عام_تصحيح = اختياري.لا_شيء();
        ألحق((*التصحيح_المتغير).العقد.العوام, بلا_عام);
    }
    (*التصحيح_المتغير).العقد.العوام[العام.القيمة] := اختياري.موجود(معرف_التصحيح);
}

عام عرف عام_تصحيح_لمسير(
    العقد: &عقد_تصحيح_مسير,
    العام: معرف_عام_مسير
): اختياري معرف_عام_تصحيح {
    إذا ((العام.القيمة مثل طبيعي) >= (الطول((*العقد).العوام) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*العقد).العوام[العام.القيمة];
}

عام عرف سجل_ثابت_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الرمز: معرف_رمز,
    النوع: معرف_نوع,
    الاسم: &متجه ط8,
    النطاق: نطاق,
    القيمة: اختياري قيمة_ثابت_تصحيح,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_الثابت: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_الثابت: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    دع المعرف_المؤقت: معرف_ثابت_تصحيح = معرف_ثابت_تصحيح_من(0);
    دع رمز_الثابت: اختياري معرف_رمز = اختياري.موجود(الرمز);
    دع الوصف: ثابت_تصحيح = {
        المعرف: المعرف_المؤقت, الرمز: رمز_الثابت, الاسم: اسم_الثابت,
        النوع: النوع, الأصل: أصل_الثابت, القيمة: القيمة, علني: علني, اصطناعي: خطأ
    };
    أضف_ثابت_تصحيح(&متغير (*التصحيح_المتغير).الدلالي, الوصف);
}

عام عرف سجل_وحدات_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الوحدات: &متجه وحدة_دلالية,
    الخريطة: &خريطة_مصادر
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        دع الوحدة: &وحدة_دلالية = &(*الوحدات)[ف];
        إذا ((*الوحدة).معرف_المصدر < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
            دع المصادر: &متجه مصدر = &(*الخريطة).المصادر;
            دع معرف_المصدر: طبيعي = (*الوحدة).معرف_المصدر;
            دع المصدر: &مصدر = &(*المصادر)[معرف_المصدر];
            دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
            دع الاسم: متغير متجه ط8 = [];
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(*مرجع_الاسم) مثل طبيعي)) {
                ألحق(الاسم, (*مرجع_الاسم)[ب] مثل ط8);
                ب := ب + 1;
            }
            أضف_وحدة_تصحيح(
                &متغير (*التصحيح_المتغير).الدلالي, (*الوحدة).المعرف, &الاسم,
                (*الوحدة).معرف_المصدر, خطأ
            );
        };
        ف := ف + 1;
    }
}

عام عرف سجل_تصحيح_دالة_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الاسم: متجه ط8,
    النطاق: نطاق,
    أسماء_المعاملات: &متجه متجه ط8,
    نطاقات_المعاملات: &متجه نطاق,
    أنواع_المعاملات: &متجه معرف_نوع,
    الناتج: اختياري معرف_نوع,
    علني: منطقي
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع أصل_الدالة: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
    دع اسم_الربط: متجه ط8 = انسخ_اسم_تصحيح(&الاسم);
    دع معرف_التصحيح: معرف_دالة_تصحيح = أضف_دالة_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, الاسم, اسم_الربط, أصل_الدالة, الناتج, خطأ, علني, خطأ
    );
    اربط_دالة_تصحيح_بمسير(&متغير (*التصحيح_المتغير).العقد, الدالة, معرف_التصحيح);
    دع بلا_أب: اختياري معرف_نطاق_تصحيح = اختياري.لا_شيء();
    دع بلا_تضمين: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
    دع النطاق_الجذري: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, أصل_الدالة, النطاق, معرف_التصحيح, بلا_أب, بلا_تضمين
    );
    (*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].النطاق_الجذري := اختياري.موجود(النطاق_الجذري);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أنواع_المعاملات) مثل طبيعي) && ف < (الطول(*أسماء_المعاملات) مثل طبيعي) && ف < (الطول(*نطاقات_المعاملات) مثل طبيعي)) {
        دع أصل_المعامل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, (*نطاقات_المعاملات)[ف]);
        دع اسم_المعامل: متجه ط8 = انسخ_اسم_تصحيح(&(*أسماء_المعاملات)[ف]);
        دع بلا_رمز: اختياري معرف_رمز = اختياري.لا_شيء();
        دع نوع_المعامل: معرف_نوع = (*أنواع_المعاملات)[ف];
        دع المتغير: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, بلا_رمز, اسم_المعامل, نوع_المعامل,
            أصل_المعامل, النطاق_الجذري, صنف_متغير_تصحيح.معامل(), خطأ
        );
        ألحق((*التصحيح_المتغير).الدلالي.الدوال[معرف_التصحيح.القيمة].المعاملات, المتغير);
        دع الموقع: معرف_موقع_تصحيح = سجل_موقع_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, أصل_المعامل, اختياري.موجود(النطاق_الجذري), خطأ, خطأ, خطأ, 0
        );
        دع قيمة_المعامل: معرف_قيمة_مسير = معرف_قيمة_مسير_من(الدالة, ف);
        اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, قيمة_المعامل, المتغير, اختياري.موجود(الموقع));
        ف := ف + 1;
    }
}

عام عرف نطاق_جذري_لتصحيح_دالة_مسير(
    التصحيح: &بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير
): اختياري معرف_نطاق_تصحيح {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة >= (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        أرجع (*التصحيح).الدلالي.الدوال[المعرف.القيمة].النطاق_الجذري;
    };
}

عام عرف سجل_نطاق_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    النطاق: نطاق,
    الأب: اختياري معرف_نطاق_تصحيح
): اختياري معرف_نطاق_تصحيح {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    طابق دالة_تصحيح_لمسير(&(*التصحيح_المتغير).العقد, الدالة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(معرف_الدالة) -> {
        دع الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, النطاق);
        طابق نطاق_تصحيح_لأصل(&(*التصحيح_المتغير).الدلالي, الأصل) مع
        | اختياري.موجود(الموجود) -> { أرجع اختياري.موجود(الموجود); }
        | اختياري.لا_شيء -> { };
        دع بلا_تضمين: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
        دع المعرف: معرف_نطاق_تصحيح = أضف_نطاق_تصحيح(
            &متغير (*التصحيح_المتغير).الدلالي, الأصل, النطاق, معرف_الدالة, الأب, بلا_تضمين
        );
        ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
        دع الربط: ربط_نطاق_مصدر_تصحيح = {
            المصدر: النطاق.البداية.المصدر,
            البداية: النطاق.البداية.البايت,
            النهاية: النطاق.النهاية.البايت,
            النطاق: المعرف
        };
        ألحق((*التصحيح_المتغير).العقد.نطاقات_المصدر[الدالة.القيمة], الربط);
        أرجع اختياري.موجود(المعرف);
    };
}

عام عرف نطاق_تصحيح_لنطاق_مصدر(
    العقد: &عقد_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    المدى: نطاق
): اختياري معرف_نطاق_تصحيح {
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*العقد).نطاقات_المصدر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع القيم: &متجه ربط_نطاق_مصدر_تصحيح = &(*العقد).نطاقات_المصدر[الدالة.القيمة];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا ((*القيم)[ف].المصدر == (المدى.البداية.المصدر مثل طبيعي)
            && (*القيم)[ف].البداية == (المدى.البداية.البايت مثل طبيعي)
            && (*القيم)[ف].النهاية == (المدى.النهاية.البايت مثل طبيعي)) {
            أرجع اختياري.موجود((*القيم)[ف].النطاق);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف سجل_متغير_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الأصول: &متغير سجل_أصول_مصدر,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    الاسم: متجه ط8,
    النوع: معرف_نوع,
    نطاق_التصريح: نطاق,
    نطاق_الإحاطة: معرف_نطاق_تصحيح
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    دع الأصل: معرف_أصل_مصدر = سجل_أصل_مصدر(الأصول, نطاق_التصريح);
    دع اسم_المتغير: متجه ط8 = انسخ_اسم_تصحيح(&الاسم);
    دع بعض_الرمز: اختياري معرف_رمز = اختياري.موجود(الرمز);
    دع المعرف: معرف_متغير_تصحيح = أضف_متغير_تصحيح(
        &متغير (*التصحيح_المتغير).الدلالي, بعض_الرمز, اسم_المتغير, النوع, الأصل,
        نطاق_الإحاطة, صنف_متغير_تصحيح.محلي(), خطأ
    );
    ضمن_دالة_تصحيح_مسير(&متغير (*التصحيح_المتغير).العقد, الدالة);
    دع فهرس_الدالة: طبيعي = الدالة.القيمة;
    دع الجدول: &متغير جدول_رموز_متغيرات_تصحيح = &متغير (*التصحيح_المتغير).العقد.متغيرات_بالرمز[فهرس_الدالة];
    إذا ((الطول((*الجدول).المتغيرات) مثل طبيعي) == 0) {
        (*الجدول).البداية := الرمز.القيمة;
    } وإلا إذا ((الرمز.القيمة مثل طبيعي) < (*الجدول).البداية) {
        // Rebase once for a symbol below the current range.
        دع الموسع: متغير متجه اختياري معرف_متغير_تصحيح = [];
        دع ف: متغير طبيعي = الرمز.القيمة;
        طالما (ف < (*الجدول).البداية) {
            دع فارغ: اختياري معرف_متغير_تصحيح = اختياري.لا_شيء();
            ألحق(الموسع, فارغ);
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول((*الجدول).المتغيرات) مثل طبيعي)) {
            دع القديم: اختياري معرف_متغير_تصحيح = (*الجدول).المتغيرات[ف];
            ألحق(الموسع, القديم);
            ف := ف + 1;
        }
        (*الجدول).المتغيرات := الموسع;
        (*الجدول).البداية := الرمز.القيمة;
    };
    دع الموضع: طبيعي = (الرمز.القيمة مثل طبيعي) - (*الجدول).البداية;
    طالما ((الطول((*الجدول).المتغيرات) مثل طبيعي) <= الموضع) {
        دع فارغ: اختياري معرف_متغير_تصحيح = اختياري.لا_شيء(); ألحق((*الجدول).المتغيرات, فارغ);
    }
    (*الجدول).المتغيرات[الموضع] := اختياري.موجود(المعرف);
}

عام عرف اربط_رمز_بقيمة_تصحيح_مسير(
    التصحيح: &متغير بيانات_تصحيح_مسير,
    الدالة: معرف_دالة_مسير,
    الرمز: معرف_رمز,
    القيمة: معرف_قيمة_مسير,
    الموقع: اختياري معرف_موقع_تصحيح
): فراغ {
    دع التصحيح_المتغير: متغير &متغير بيانات_تصحيح_مسير = التصحيح;
    إذا ((الدالة.القيمة مثل طبيعي) >= (الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز) مثل طبيعي)) { أرجع; };
    // Plain values only: no borrow of the table outlives the lookup.
    دع البداية: طبيعي = (*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].البداية;
    دع الطول_المسجل: طبيعي =
        الطول((*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].المتغيرات) مثل طبيعي;
    إذا ((الرمز.القيمة مثل طبيعي) < البداية) { أرجع; };
    إذا ((الرمز.القيمة مثل طبيعي) - البداية >= الطول_المسجل) { أرجع; };
    دع الربط: اختياري معرف_متغير_تصحيح =
        (*التصحيح_المتغير).العقد.متغيرات_بالرمز[الدالة.القيمة].المتغيرات[(الرمز.القيمة مثل طبيعي) - البداية];
    طابق الربط مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المتغير) -> { اربط_قيمة_بمتغير_تصحيح(&متغير (*التصحيح_المتغير).العقد, القيمة, المتغير, الموقع); };
}
