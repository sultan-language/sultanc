استورد std.fs.metadata;
استورد std.text.from_bytes;
استورد compiler.backend.target.target_model;

// cc-style library search for -l <name>. For each -L directory, then the
// target's standard library directories, the candidate file names of the
// target's object format are tried in order. A GNU ld script (Linux libc.so)
// is a valid result: the linker plan follows its GROUP/INPUT entries.

عرف ضم_نصوص_بحث(الأجزاء: &متجه نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف ضم_ثلاثة_بحث(الأول: نص, الاسم: &نص, الأخير: نص): نص {
    دع الأجزاء: متغير متجه نص = [];
    ألحق(الأجزاء, الأول);
    ألحق(الأجزاء, انسخ_نص(الاسم));
    ألحق(الأجزاء, الأخير);
    أرجع ضم_نصوص_بحث(&الأجزاء);
}

عرف أسماء_ملفات_مكتبة_للهدف(الاسم: &نص, الهدف: &واصف_هدف): متجه نص {
    دع الناتج: متغير متجه نص = [];
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> {
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.tbd»));
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.dylib»));
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.a»));
    }
    | هوية_منصة.ويندوز -> {
        ألحق(الناتج, ضم_ثلاثة_بحث(«», الاسم, «.lib»));
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.a»));
    }
    | _ -> {
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.so»));
        ألحق(الناتج, ضم_ثلاثة_بحث(«lib», الاسم, «.a»));
    };
    أرجع الناتج;
}

// Standard directories, most specific first (Debian multiarch, then the
// lib64 and plain layouts used by other distributions and the BSDs).
عرف أدلة_مكتبات_افتراضية_للهدف(الهدف: &واصف_هدف): متجه نص {
    دع الناتج: متغير متجه نص = [];
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> {
        ألحق(الناتج, «/usr/lib»);
        ألحق(الناتج, «/usr/local/lib»);
        ألحق(الناتج, «/opt/homebrew/lib»);
        ألحق(الناتج, «/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib»);
    }
    | هوية_منصة.ويندوز -> { }
    | _ -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            ألحق(الناتج, «/lib/x86_64-linux-gnu»);
            ألحق(الناتج, «/usr/lib/x86_64-linux-gnu»);
        }
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            ألحق(الناتج, «/lib/aarch64-linux-gnu»);
            ألحق(الناتج, «/usr/lib/aarch64-linux-gnu»);
        }
        | هوية_معمارية.رايسك_في_أربعة_وستون -> {
            ألحق(الناتج, «/lib/riscv64-linux-gnu»);
            ألحق(الناتج, «/usr/lib/riscv64-linux-gnu»);
        }
        | _ -> { };
        ألحق(الناتج, «/lib64»);
        ألحق(الناتج, «/usr/lib64»);
        ألحق(الناتج, «/lib»);
        ألحق(الناتج, «/usr/lib»);
        ألحق(الناتج, «/usr/local/lib»);
    };
    أرجع الناتج;
}

عرف ملف_موجود_للبحث(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.ملف) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ابحث_عن_مكتبة(
    الاسم: &نص, الأدلة: &متجه نص, الهدف: &واصف_هدف
): اختياري نص {
    دع الملفات: متجه نص = أسماء_ملفات_مكتبة_للهدف(الاسم, الهدف);
    دع الافتراضية: متجه نص = أدلة_مكتبات_افتراضية_للهدف(الهدف);
    دع الكل: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأدلة) مثل طبيعي)) { ألحق(الكل, انسخ_نص(&(*الأدلة)[ف])); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(الافتراضية) مثل طبيعي)) { ألحق(الكل, انسخ_نص(&الافتراضية[ف])); ف := ف + 1; }
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول(الكل) مثل طبيعي)) {
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الملفات) مثل طبيعي)) {
            دع الأجزاء: متغير متجه نص = [];
            ألحق(الأجزاء, انسخ_نص(&الكل[د]));
            ألحق(الأجزاء, «/»);
            ألحق(الأجزاء, انسخ_نص(&الملفات[م]));
            دع المسار: نص = ضم_نصوص_بحث(&الأجزاء);
            لو (ملف_موجود_للبحث(&المسار)) { أرجع اختياري.موجود(المسار); };
            م := م + 1;
        }
        د := د + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Resolves every -l name to a file, in command-line order, appending each
// path to الناتج. Returns the first name that no directory provides.
عام عرف حل_مكتبات_الربط(
    الأسماء: &متجه نص, الأدلة: &متجه نص, الهدف: &واصف_هدف,
    الناتج: &متغير متجه نص
): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        طابق ابحث_عن_مكتبة(&(*الأسماء)[ف], الأدلة, الهدف) مع
        | اختياري.موجود(المسار) -> { ألحق(*الناتج, المسار); }
        | اختياري.لا_شيء -> {
            دع الأجزاء: متغير متجه نص = [];
            ألحق(الأجزاء, «-l»);
            ألحق(الأجزاء, انسخ_نص(&(*الأسماء)[ف]));
            أرجع اختياري.موجود(ضم_نصوص_بحث(&الأجزاء));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
