استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.encoding.utf8;

// Generic TOML document model. Package semantics belong to package_manifest.sn.
// Tables/arrays are arena-indexed so recursive TOML values do not require a
// recursive value layout in the language type system.
عام نوع قيمة_تومل =
    | سلسلة بنوع نص
    | منطق بنوع منطقي
    | عدد بنوع نص
    | تاريخ_وقت بنوع نص
    | مصفوفة بنوع غير_موقع
    | جدول بنوع غير_موقع
;

عام نوع مدخل_جدول_تومل = {
    المفتاح: نص,
    القيمة: قيمة_تومل,
    الإزاحة: غير_موقع
};

عام نوع جدول_تومل = {
    المداخل: متجه مدخل_جدول_تومل,
    معلن: منطقي,
    مغلق: منطقي
};

عام نوع مصفوفة_تومل = {
    القيم: متجه قيمة_تومل
};

عام نوع وثيقة_تومل = {
    الجذر: غير_موقع,
    الجداول: متجه جدول_تومل,
    المصفوفات: متجه مصفوفة_تومل
};

عام نوع صنف_خطأ_تومل =
    | نهاية_غير_متوقعة
    | رمز_غير_متوقع
    | مفتاح_غير_صالح
    | قيمة_غير_صالحة
    | هروب_غير_صالح
    | يونيكود_غير_صالح
    | مفتاح_مكرر
    | جدول_مكرر
    | تعارض_نوع
    | جدول_ضمني_مغلق
    | نص_لاحق
;

عام نوع خطأ_تومل = {
    الصنف: صنف_خطأ_تومل,
    الإزاحة: غير_موقع
};

نوع محلل_تومل = {
    النص: نص,
    الموضع: غير_موقع,
    الجدول_الحالي: غير_موقع,
    الجذر: غير_موقع,
    الجداول: متجه جدول_تومل,
    المصفوفات: متجه مصفوفة_تومل
};

عرف خطأ_تومل_عند(الصنف: صنف_خطأ_تومل, الموضع: غير_موقع): خطأ_تومل {
    دع الخطأ: خطأ_تومل = { الصنف: الصنف, الإزاحة: الموضع };
    أرجع الخطأ;
}

عرف جدول_تومل_جديد(معلن: منطقي, مغلق: منطقي): جدول_تومل {
    دع المداخل: متجه مدخل_جدول_تومل = [];
    دع الجدول: جدول_تومل = { المداخل: المداخل, معلن: معلن, مغلق: مغلق };
    أرجع الجدول;
}

عرف مصفوفة_تومل_جديدة(): مصفوفة_تومل {
    دع القيم: متجه قيمة_تومل = [];
    دع المصفوفة: مصفوفة_تومل = { القيم: القيم };
    أرجع المصفوفة;
}

عرف أضف_جدول_تومل(المحلل: &متغير محلل_تومل, معلن: منطقي, مغلق: منطقي): غير_موقع {
    دع الفهرس: غير_موقع = الطول((*المحلل).الجداول) مثل غير_موقع;
    ألحق((*المحلل).الجداول, جدول_تومل_جديد(معلن, مغلق));
    أرجع الفهرس;
}

عرف أضف_مصفوفة_تومل(المحلل: &متغير محلل_تومل): غير_موقع {
    دع الفهرس: غير_موقع = الطول((*المحلل).المصفوفات) مثل غير_موقع;
    ألحق((*المحلل).المصفوفات, مصفوفة_تومل_جديدة());
    أرجع الفهرس;
}

عرف موضع_مدخل_تومل(الجدول: &جدول_تومل, المفتاح: &نص): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الجدول).المداخل) مثل غير_موقع)) {
        لو (نصان_متساويان(&(*الجدول).المداخل[ف].المفتاح, المفتاح)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف قيمة_مدخل_تومل_داخلية(
    المحلل: &محلل_تومل,
    فهرس_الجدول: غير_موقع,
    المفتاح: &نص
): اختيار قيمة_تومل {
    لو (فهرس_الجدول >= (الطول((*المحلل).الجداول) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الجدول: &جدول_تومل = &(*المحلل).الجداول[فهرس_الجدول];
    طابق موضع_مدخل_تومل(الجدول, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        دع مرجع_القيمة: &قيمة_تومل = &(*الجدول).المداخل[الموضع].القيمة;
        دع القيمة: قيمة_تومل = *مرجع_القيمة;
        أرجع اختيار.بعض(القيمة);
    };
}

عرف أضف_مدخل_تومل(
    المحلل: &متغير محلل_تومل,
    فهرس_الجدول: غير_موقع,
    المفتاح: نص,
    القيمة: قيمة_تومل,
    الإزاحة: غير_موقع
): منطقي {
    لو (فهرس_الجدول >= (الطول((*المحلل).الجداول) مثل غير_موقع)) { أرجع خطأ; };
    طابق موضع_مدخل_تومل(&(*المحلل).الجداول[فهرس_الجدول], &المفتاح) مع
    | اختيار.بعض(_) -> { أرجع خطأ; }
    | اختيار.لا_شيء -> { };
    دع المدخل: مدخل_جدول_تومل = { المفتاح: المفتاح, القيمة: القيمة, الإزاحة: الإزاحة };
    ألحق((*المحلل).الجداول[فهرس_الجدول].المداخل, المدخل);
    أرجع صواب;
}

عرف اضبط_جدول_معلنا(
    المحلل: &متغير محلل_تومل,
    الفهرس: غير_موقع
): منطقي {
    لو (الفهرس >= (الطول((*المحلل).الجداول) مثل غير_موقع)) { أرجع خطأ; };
    لو ((*المحلل).الجداول[الفهرس].مغلق || (*المحلل).الجداول[الفهرس].معلن) { أرجع خطأ; };
    (*المحلل).الجداول[الفهرس].معلن := صواب;
    أرجع صواب;
}

عرف أغلق_جدول_تومل(المحلل: &متغير محلل_تومل, الفهرس: غير_موقع): فراغ {
    لو (الفهرس < (الطول((*المحلل).الجداول) مثل غير_موقع)) {
        (*المحلل).الجداول[الفهرس].مغلق := صواب;
    };
}

عرف ألحق_مصفوفة_تومل(
    المحلل: &متغير محلل_تومل,
    الفهرس: غير_موقع,
    القيمة: قيمة_تومل
): منطقي {
    لو (الفهرس >= (الطول((*المحلل).المصفوفات) مثل غير_موقع)) { أرجع خطأ; };
    ألحق((*المحلل).المصفوفات[الفهرس].القيم, القيمة);
    أرجع صواب;
}

عرف في_نهاية_تومل(المحلل: &محلل_تومل): منطقي {
    أرجع (*المحلل).الموضع >= (الطول((*المحلل).النص) مثل غير_موقع);
}

عرف بايت_تومل_عند(المحلل: &محلل_تومل, الموضع: غير_موقع): غ8 {
    أرجع (*المحلل).النص[الموضع];
}

عرف بايت_تومل_الحالي(المحلل: &محلل_تومل): اختيار غ8 {
    لو (في_نهاية_تومل(المحلل)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(بايت_تومل_عند(المحلل, (*المحلل).الموضع));
}

عرف تقدم_تومل(المحلل: &متغير محلل_تومل): فراغ {
    لو ((*المحلل).الموضع < (الطول((*المحلل).النص) مثل غير_موقع)) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
    };
}

عرف تجاوز_مسافة_تومل(المحلل: &متغير محلل_تومل): فراغ {
    دع مستمر: متغير منطقي = صواب;
    بينما (!في_نهاية_تومل(المحلل) && مستمر) {
        دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        لو ((ب == 0x20) || (ب == 0x09)) { تقدم_تومل(المحلل); }
        وإلا { مستمر := خطأ; };
    }
}

عرف تجاوز_تعليق_تومل(المحلل: &متغير محلل_تومل): فراغ {
    لو (في_نهاية_تومل(المحلل)) { أرجع; };
    لو (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x23) { أرجع; };
    بينما (!في_نهاية_تومل(المحلل)) {
        دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        لو ((ب == 0x0A) || (ب == 0x0D)) { أرجع; };
        تقدم_تومل(المحلل);
    }
}

عرف تجاوز_نهاية_سطر_تومل(المحلل: &متغير محلل_تومل): منطقي {
    لو (في_نهاية_تومل(المحلل)) { أرجع صواب; };
    دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
    لو (ب == 0x0A) { تقدم_تومل(المحلل); أرجع صواب; };
    لو (ب == 0x0D) {
        تقدم_تومل(المحلل);
        لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x0A)) {
            تقدم_تومل(المحلل);
            أرجع صواب;
        };
        أرجع خطأ;
    };
    أرجع خطأ;
}

عرف تجاوز_فراغ_وتعليقات_مصفوفة(المحلل: &متغير محلل_تومل): منطقي {
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        تجاوز_مسافة_تومل(المحلل);
        لو (في_نهاية_تومل(المحلل)) { أرجع صواب; };
        دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        لو (ب == 0x23) {
            تجاوز_تعليق_تومل(المحلل);
        } وإلا لو ((ب == 0x0A) || (ب == 0x0D)) {
            لو (!تجاوز_نهاية_سطر_تومل(المحلل)) { أرجع خطأ; };
        } وإلا {
            مستمر := خطأ;
        };
    }
    أرجع صواب;
}

عرف يطابق_تومل_عند(المحلل: &محلل_تومل, الموضع: غير_موقع, النص: نص): منطقي {
    دع الهدف: نص = النص;
    لو ((الموضع + (الطول(الهدف) مثل غير_موقع)) > (الطول((*المحلل).النص) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الهدف) مثل غير_موقع)) {
        لو (بايت_تومل_عند(المحلل, الموضع + ف) != الهدف[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_سداسية_تومل(البايت: غ8): اختيار غ32 {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع اختيار.بعض((البايت - 0x30) مثل غ32); };
    لو ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع اختيار.بعض(((البايت - 0x41) مثل غ32) + 10); };
    لو ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع اختيار.بعض(((البايت - 0x61) مثل غ32) + 10); };
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_يونيكود_تومل(
    المحلل: &متغير محلل_تومل,
    العدد: غير_موقع
): نتيجة غ32, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو ((البداية + العدد) > (الطول((*المحلل).النص) مثل غير_موقع)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), البداية));
    };
    دع القيمة: متغير غ32 = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        طابق قيمة_سداسية_تومل(بايت_تومل_عند(المحلل, البداية + ف)) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), البداية + ف));
        }
        | اختيار.بعض(الرقم) -> { القيمة := (القيمة << 4) | الرقم; };
        ف := ف + 1;
    }
    (*المحلل).الموضع := البداية + العدد;
    أرجع نتيجة.نجح(القيمة);
}

عرف ألحق_سلم_تومل(البايتات: &متغير متجه غ8, القيمة: غ32): منطقي {
    طابق ألحق_محرف_يوتيف8(*البايتات, القيمة) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع خطأ; }
    | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { *البايتات := الناتج; أرجع صواب; };
}

عرف حلل_سلسلة_أساسية_تومل(
    المحلل: &متغير محلل_تومل,
    متعددة: منطقي
): نتيجة نص, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو (متعددة) {
        لو (!يطابق_تومل_عند(المحلل, البداية, «"""»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        (*المحلل).الموضع := البداية + 3;
        لو (!في_نهاية_تومل(المحلل)) {
            دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            لو ((ب == 0x0A) || (ب == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); };
        };
    } وإلا {
        لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x22)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        تقدم_تومل(المحلل);
    };

    دع الناتج: متغير متجه غ8 = [];
    بينما (!في_نهاية_تومل(المحلل)) {
        دع الموضع: غير_موقع = (*المحلل).الموضع;
        لو (متعددة && يطابق_تومل_عند(المحلل, الموضع, «"""»)) {
            دع عدد_الاقتباسات: متغير غير_موقع = 3;
            بينما (((الموضع + عدد_الاقتباسات) < (الطول((*المحلل).النص) مثل غير_موقع))
                && (بايت_تومل_عند(المحلل, الموضع + عدد_الاقتباسات) == 0x22)) {
                عدد_الاقتباسات := عدد_الاقتباسات + 1;
            }
            لو (عدد_الاقتباسات > 5) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
            };
            دع داخلية: متغير غير_موقع = عدد_الاقتباسات - 3;
            بينما (داخلية > 0) { ألحق(الناتج, 0x22); داخلية := داخلية - 1; }
            (*المحلل).الموضع := الموضع + عدد_الاقتباسات;
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        دع ب: غ8 = بايت_تومل_عند(المحلل, الموضع);
        لو (!متعددة && (ب == 0x22)) {
            تقدم_تومل(المحلل);
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        لو (!متعددة && ((ب == 0x0A) || (ب == 0x0D))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        لو (((ب < 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)) || (ب == 0x7F)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        لو (ب != 0x5C) {
            ألحق(الناتج, ب);
            تقدم_تومل(المحلل);
        } وإلا {
            تقدم_تومل(المحلل);
            لو (في_نهاية_تومل(المحلل)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
            };
            دع هـ: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            لو (متعددة && ((هـ == 0x0A) || (هـ == 0x0D))) {
                لو (!تجاوز_نهاية_سطر_تومل(المحلل)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.هروب_غير_صالح(), (*المحلل).الموضع));
                };
                دع مستمر: متغير منطقي = صواب;
                بينما (!في_نهاية_تومل(المحلل) && مستمر) {
                    دع فاصل: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
                    لو ((فاصل == 0x20) || (فاصل == 0x09) || (فاصل == 0x0A) || (فاصل == 0x0D)) {
                        لو ((فاصل == 0x0A) || (فاصل == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); }
                        وإلا { تقدم_تومل(المحلل); };
                    } وإلا { مستمر := خطأ; };
                }
            } وإلا {
                تقدم_تومل(المحلل);
                لو (هـ == 0x22) { ألحق(الناتج, 0x22); }
                وإلا لو (هـ == 0x5C) { ألحق(الناتج, 0x5C); }
                وإلا لو (هـ == 0x62) { ألحق(الناتج, 0x08); }
                وإلا لو (هـ == 0x74) { ألحق(الناتج, 0x09); }
                وإلا لو (هـ == 0x6E) { ألحق(الناتج, 0x0A); }
                وإلا لو (هـ == 0x66) { ألحق(الناتج, 0x0C); }
                وإلا لو (هـ == 0x72) { ألحق(الناتج, 0x0D); }
                وإلا لو ((هـ == 0x75) || (هـ == 0x55)) {
                    دع أرقام: متغير غير_موقع = 4;
                    لو (هـ == 0x55) { أرقام := 8; };
                    طابق اقرأ_يونيكود_تومل(المحلل, أرقام) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(السلم) -> {
                        لو (!ألحق_سلم_تومل(&متغير الناتج, السلم)) {
                            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), الموضع));
                        };
                    };
                } وإلا {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.هروب_غير_صالح(), الموضع));
                };
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف حلل_سلسلة_حرفية_تومل(
    المحلل: &متغير محلل_تومل,
    متعددة: منطقي
): نتيجة نص, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو (متعددة) {
        لو (!يطابق_تومل_عند(المحلل, البداية, «'''»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        (*المحلل).الموضع := البداية + 3;
        لو (!في_نهاية_تومل(المحلل)) {
            دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            لو ((ب == 0x0A) || (ب == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); };
        };
    } وإلا {
        لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x27)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        تقدم_تومل(المحلل);
    };
    دع الناتج: متغير متجه غ8 = [];
    بينما (!في_نهاية_تومل(المحلل)) {
        دع الموضع: غير_موقع = (*المحلل).الموضع;
        لو (متعددة && يطابق_تومل_عند(المحلل, الموضع, «'''»)) {
            دع عدد_الاقتباسات: متغير غير_موقع = 3;
            بينما (((الموضع + عدد_الاقتباسات) < (الطول((*المحلل).النص) مثل غير_موقع))
                && (بايت_تومل_عند(المحلل, الموضع + عدد_الاقتباسات) == 0x27)) {
                عدد_الاقتباسات := عدد_الاقتباسات + 1;
            }
            لو (عدد_الاقتباسات > 5) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
            };
            دع داخلية: متغير غير_موقع = عدد_الاقتباسات - 3;
            بينما (داخلية > 0) { ألحق(الناتج, 0x27); داخلية := داخلية - 1; }
            (*المحلل).الموضع := الموضع + عدد_الاقتباسات;
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        دع ب: غ8 = بايت_تومل_عند(المحلل, الموضع);
        لو (!متعددة && (ب == 0x27)) {
            تقدم_تومل(المحلل);
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        لو (!متعددة && ((ب == 0x0A) || (ب == 0x0D))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        لو (((ب < 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)) || (ب == 0x7F)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        ألحق(الناتج, ب);
        تقدم_تومل(المحلل);
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف بايت_مفتاح_عار_تومل(ب: غ8): منطقي {
    أرجع ((ب >= 0x41) && (ب <= 0x5A))
        || ((ب >= 0x61) && (ب <= 0x7A))
        || ((ب >= 0x30) && (ب <= 0x39))
        || (ب == 0x5F)
        || (ب == 0x2D);
}

عرف حلل_مفتاح_واحد_تومل(المحلل: &متغير محلل_تومل): نتيجة نص, خطأ_تومل {
    لو (في_نهاية_تومل(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
    };
    دع ب: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
    لو (ب == 0x22) { أرجع حلل_سلسلة_أساسية_تومل(المحلل, خطأ); };
    لو (ب == 0x27) { أرجع حلل_سلسلة_حرفية_تومل(المحلل, خطأ); };
    دع الناتج: متغير متجه غ8 = [];
    بينما (!في_نهاية_تومل(المحلل) && بايت_مفتاح_عار_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
        ألحق(الناتج, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
        تقدم_تومل(المحلل);
    }
    لو ((الطول(الناتج) مثل غير_موقع) == 0) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
    };
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}

عرف حلل_مسار_مفتاح_تومل(المحلل: &متغير محلل_تومل): نتيجة متجه نص, خطأ_تومل {
    دع الأجزاء: متغير متجه نص = [];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        تجاوز_مسافة_تومل(المحلل);
        طابق حلل_مفتاح_واحد_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجزء) -> { ألحق(الأجزاء, الجزء); };
        تجاوز_مسافة_تومل(المحلل);
        لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x2E)) {
            تقدم_تومل(المحلل);
        } وإلا {
            مستمر := خطأ;
        };
    }
    لو ((الطول(الأجزاء) مثل غير_موقع) == 0) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
    };
    أرجع نتيجة.نجح(الأجزاء);
}

عرف آخر_جدول_في_مصفوفة_تومل(
    المحلل: &محلل_تومل,
    فهرس_المصفوفة: غير_موقع
): اختيار غير_موقع {
    لو (فهرس_المصفوفة >= (الطول((*المحلل).المصفوفات) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع مرجع_القيم: &متجه قيمة_تومل = &(*المحلل).المصفوفات[فهرس_المصفوفة].القيم;
    دع القيم: متجه قيمة_تومل = *مرجع_القيم;
    لو ((الطول(القيم) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الأخير: غير_موقع = (الطول(القيم) مثل غير_موقع) - 1;
    طابق القيم[الأخير] مع
    | قيمة_تومل.جدول(الجدول) -> { أرجع اختيار.بعض(الجدول); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف حل_جدول_مسار_تومل(
    المحلل: &متغير محلل_تومل,
    البداية: غير_موقع,
    الأجزاء: &متجه نص,
    العدد: غير_موقع,
    أنشئ: منطقي,
    مغلق: منطقي
): نتيجة غير_موقع, خطأ_تومل {
    دع الحالي: متغير غير_موقع = البداية;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع مرجع_المفتاح: &نص = &(*الأجزاء)[ف];
        دع المفتاح: نص = *مرجع_المفتاح;
        طابق قيمة_مدخل_تومل_داخلية(المحلل, الحالي, &المفتاح) مع
        | اختيار.لا_شيء -> {
            لو (!أنشئ) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
            };
            لو ((*المحلل).الجداول[الحالي].مغلق) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.جدول_ضمني_مغلق(), (*المحلل).الموضع));
            };
            دع الجديد: غير_موقع = أضف_جدول_تومل(المحلل, خطأ, مغلق);
            لو (!أضف_مدخل_تومل(المحلل, الحالي, المفتاح, قيمة_تومل.جدول(الجديد), (*المحلل).الموضع)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
            };
            الحالي := الجديد;
        }
        | اختيار.بعض(القيمة) -> {
            طابق القيمة مع
            | قيمة_تومل.جدول(الجدول) -> { الحالي := الجدول; }
            | قيمة_تومل.مصفوفة(المصفوفة) -> {
                طابق آخر_جدول_في_مصفوفة_تومل(المحلل, المصفوفة) مع
                | اختيار.بعض(الجدول) -> { الحالي := الجدول; }
                | اختيار.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
                };
            }
            | _ -> {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الحالي);
}


عرف حلل_مصفوفة_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x5B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    تقدم_تومل(المحلل);
    دع الفهرس: غير_موقع = أضف_مصفوفة_تومل(المحلل);
    لو (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
    };
    لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x5D)) {
        تقدم_تومل(المحلل);
        أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
    };
    دع يتوقع_قيمة: متغير منطقي = صواب;
    بينما (!في_نهاية_تومل(المحلل)) {
        لو (!يتوقع_قيمة) {
            دع فاصل: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            لو (فاصل == 0x5D) {
                تقدم_تومل(المحلل);
                أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
            };
            لو (فاصل != 0x2C) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            تقدم_تومل(المحلل);
            يتوقع_قيمة := صواب;
            لو (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x5D)) {
                تقدم_تومل(المحلل);
                أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
            };
        };
        طابق حلل_قيمة_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            لو (!ألحق_مصفوفة_تومل(المحلل, الفهرس, القيمة)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
            };
        };
        يتوقع_قيمة := خطأ;
        لو (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف حلل_جدول_ضمني_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x7B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    تقدم_تومل(المحلل);
    دع الفهرس: غير_موقع = أضف_جدول_تومل(المحلل, صواب, خطأ);
    تجاوز_مسافة_تومل(المحلل);
    لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x7D)) {
        تقدم_تومل(المحلل);
        أغلق_جدول_تومل(المحلل, الفهرس);
        أرجع نتيجة.نجح(قيمة_تومل.جدول(الفهرس));
    };
    بينما (!في_نهاية_تومل(المحلل)) {
        طابق حلل_مسار_مفتاح_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الأجزاء) -> {
            تجاوز_مسافة_تومل(المحلل);
            لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x3D)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            تقدم_تومل(المحلل);
            تجاوز_مسافة_تومل(المحلل);
            طابق حلل_قيمة_تومل(المحلل) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> {
                دع العدد: غير_موقع = الطول(الأجزاء) مثل غير_موقع;
                دع المالك: متغير غير_موقع = الفهرس;
                لو (العدد > 1) {
                    طابق حل_جدول_مسار_تومل(المحلل, الفهرس, &الأجزاء, العدد - 1, صواب, صواب) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(الجدول) -> { المالك := الجدول; };
                };
                دع موضع_المفتاح: غير_موقع = العدد - 1;
                دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
                دع المفتاح: نص = *مرجع_المفتاح;
                لو (!أضف_مدخل_تومل(المحلل, المالك, المفتاح, القيمة, (*المحلل).الموضع)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
                };
            };
        };
        تجاوز_مسافة_تومل(المحلل);
        لو (في_نهاية_تومل(المحلل)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
        };
        دع فاصل: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        لو (فاصل == 0x7D) {
            تقدم_تومل(المحلل);
            أغلق_جدول_تومل(المحلل, الفهرس);
            أرجع نتيجة.نجح(قيمة_تومل.جدول(الفهرس));
        };
        لو (فاصل != 0x2C) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        تجاوز_مسافة_تومل(المحلل);
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف بايت_قيمة_عارية_تومل(ب: غ8): منطقي {
    أرجع (ب != 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)
        && (ب != 0x23) && (ب != 0x2C) && (ب != 0x5D) && (ب != 0x7D);
}

عرف بايت_رقم_تومل(البايت: غ8, الأساس: غير_موقع): منطقي {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) {
        أرجع (((البايت - 0x30) مثل غير_موقع) < الأساس);
    };
    لو (الأساس == 16) {
        لو ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع صواب; };
        لو ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع صواب; };
    };
    أرجع خطأ;
}

عرف قيمة_رقم_تومل(البايت: غ8): غير_موقع {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع (البايت - 0x30) مثل غير_موقع; };
    لو ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع ((البايت - 0x41) مثل غير_موقع) + 10; };
    أرجع ((البايت - 0x61) مثل غير_موقع) + 10;
}

عرف تحقق_تسلسل_أرقام_تومل(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الأساس: غير_موقع
): منطقي {
    لو (البداية >= النهاية) { أرجع خطأ; };
    دع رأى_رقما: متغير منطقي = خطأ;
    دع السابق_رقم: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        دع ب: غ8 = (*النص)[ف];
        لو (بايت_رقم_تومل(ب, الأساس)) {
            رأى_رقما := صواب;
            السابق_رقم := صواب;
        } وإلا لو (ب == 0x5F) {
            دع التالي: غير_موقع = ف + 1;
            لو (!السابق_رقم || (التالي >= النهاية)) {
                أرجع خطأ;
            };
            لو (!بايت_رقم_تومل((*النص)[التالي], الأساس)) {
                أرجع خطأ;
            };
            السابق_رقم := خطأ;
        } وإلا {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع رأى_رقما && السابق_رقم;
}

عرف عدد_أرقام_تومل_دون_فواصل(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع
): غير_موقع {
    دع العدد: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        لو ((*النص)[ف] != 0x5F) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف تحقق_جزء_عشري_تومل(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    يسمح_بأصفار_بادئة: منطقي
): منطقي {
    لو (!تحقق_تسلسل_أرقام_تومل(النص, البداية, النهاية, 10)) { أرجع خطأ; };
    لو (!يسمح_بأصفار_بادئة) {
        دع العدد: غير_موقع = عدد_أرقام_تومل_دون_فواصل(النص, البداية, النهاية);
        لو ((العدد > 1) && ((*النص)[البداية] == 0x30)) { أرجع خطأ; };
    };
    أرجع صواب;
}

عرف صحيح_تومل_ضمن_ص64(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    الأساس: غير_موقع,
    سالب: منطقي
): منطقي {
    دع الحد_الموجب: غ64 = (~(0 مثل غ64)) >> 1;
    دع الحد: متغير غ64 = الحد_الموجب;
    لو (سالب) { الحد := الحد_الموجب + 1; };
    دع القيمة: متغير غ64 = 0;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        دع ب: غ8 = (*النص)[ف];
        لو (ب != 0x5F) {
            دع الرقم: غ64 = قيمة_رقم_تومل(ب) مثل غ64;
            دع القاعدة: غ64 = الأساس مثل غ64;
            لو (القيمة > ((الحد - الرقم) / القاعدة)) { أرجع خطأ; };
            القيمة := (القيمة * القاعدة) + الرقم;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

نوع تصنيف_رقم_تومل =
    | غير_صالح
    | صحيح
    | عائم
;

عرف صنف_رقم_تومل(النص: &نص): تصنيف_رقم_تومل {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو (العدد == 0) { أرجع تصنيف_رقم_تومل.غير_صالح(); };

    دع البداية: متغير غير_موقع = 0;
    دع سالب: متغير منطقي = خطأ;
    دع له_إشارة: متغير منطقي = خطأ;
    لو (((*النص)[0] == 0x2B) || ((*النص)[0] == 0x2D)) {
        له_إشارة := صواب;
        سالب := (*النص)[0] == 0x2D;
        البداية := 1;
        لو (البداية >= العدد) { أرجع تصنيف_رقم_تومل.غير_صالح(); };
    };

    دع الباقي: متغير متجه غ8 = [];
    دع ر: متغير غير_موقع = البداية;
    بينما (ر < العدد) { ألحق(الباقي, (*النص)[ر]); ر := ر + 1; }
    دع نص_الباقي: نص = من_بايتات(&الباقي);
    دع نان: نص = «nan»;
    دع لانهاية: نص = «inf»;
    لو (نصان_متساويان(&نص_الباقي, &نان) || نصان_متساويان(&نص_الباقي, &لانهاية)) {
        أرجع تصنيف_رقم_تومل.عائم();
    };

    لو (!له_إشارة && ((البداية + 2) <= العدد) && ((*النص)[البداية] == 0x30)) {
        دع موضع_النوع: غير_موقع = البداية + 1;
        دع النوع: غ8 = (*النص)[موضع_النوع];
        دع الأساس: متغير غير_موقع = 0;
        لو (النوع == 0x78) { الأساس := 16; }
        وإلا لو (النوع == 0x6F) { الأساس := 8; }
        وإلا لو (النوع == 0x62) { الأساس := 2; };
        لو (الأساس != 0) {
            دع بداية_الأرقام: غير_موقع = البداية + 2;
            لو (!تحقق_تسلسل_أرقام_تومل(النص, بداية_الأرقام, العدد, الأساس)) {
                أرجع تصنيف_رقم_تومل.غير_صالح();
            };
            لو (!صحيح_تومل_ضمن_ص64(النص, بداية_الأرقام, العدد, الأساس, خطأ)) {
                أرجع تصنيف_رقم_تومل.غير_صالح();
            };
            أرجع تصنيف_رقم_تومل.صحيح();
        };
    };

    دع نهاية_الصحيح: متغير غير_موقع = البداية;
    بينما ((نهاية_الصحيح < العدد) && ((*النص)[نهاية_الصحيح] != 0x2E)
        && ((*النص)[نهاية_الصحيح] != 0x65) && ((*النص)[نهاية_الصحيح] != 0x45)) {
        نهاية_الصحيح := نهاية_الصحيح + 1;
    }
    لو (!تحقق_جزء_عشري_تومل(النص, البداية, نهاية_الصحيح, خطأ)) {
        أرجع تصنيف_رقم_تومل.غير_صالح();
    };
    لو (نهاية_الصحيح == العدد) {
        لو (!صحيح_تومل_ضمن_ص64(النص, البداية, العدد, 10, سالب)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        أرجع تصنيف_رقم_تومل.صحيح();
    };

    دع الموضع: متغير غير_موقع = نهاية_الصحيح;
    دع له_كسر: متغير منطقي = خطأ;
    دع له_أس: متغير منطقي = خطأ;
    لو ((*النص)[الموضع] == 0x2E) {
        له_كسر := صواب;
        الموضع := الموضع + 1;
        دع نهاية_الكسر: متغير غير_موقع = الموضع;
        بينما ((نهاية_الكسر < العدد) && ((*النص)[نهاية_الكسر] != 0x65) && ((*النص)[نهاية_الكسر] != 0x45)) {
            نهاية_الكسر := نهاية_الكسر + 1;
        }
        لو (!تحقق_تسلسل_أرقام_تومل(النص, الموضع, نهاية_الكسر, 10)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        الموضع := نهاية_الكسر;
    };
    لو ((الموضع < العدد) && (((*النص)[الموضع] == 0x65) || ((*النص)[الموضع] == 0x45))) {
        له_أس := صواب;
        الموضع := الموضع + 1;
        لو ((الموضع < العدد) && (((*النص)[الموضع] == 0x2B) || ((*النص)[الموضع] == 0x2D))) {
            الموضع := الموضع + 1;
        };
        لو (!تحقق_تسلسل_أرقام_تومل(النص, الموضع, العدد, 10)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        الموضع := العدد;
    };
    لو ((الموضع != العدد) || (!له_كسر && !له_أس)) {
        أرجع تصنيف_رقم_تومل.غير_صالح();
    };
    أرجع تصنيف_رقم_تومل.عائم();
}

عرف قيمة_أرقام_ثابتة_تومل(
    النص: &نص,
    البداية: غير_موقع,
    العدد: غير_موقع
): اختيار غير_موقع {
    لو ((البداية + العدد) > (الطول(*النص) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الموضع: غير_موقع = البداية + ف;
        دع ب: غ8 = (*النص)[الموضع];
        لو ((ب < 0x30) || (ب > 0x39)) { أرجع اختيار.لا_شيء(); };
        القيمة := (القيمة * 10) + ((ب - 0x30) مثل غير_موقع);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(القيمة);
}

عرف سنة_كبيسة_تومل(السنة: غير_موقع): منطقي {
    لو ((السنة % 400) == 0) { أرجع صواب; };
    لو ((السنة % 100) == 0) { أرجع خطأ; };
    أرجع (السنة % 4) == 0;
}

عرف أيام_شهر_تومل(السنة: غير_موقع, الشهر: غير_موقع): غير_موقع {
    لو ((الشهر == 1) || (الشهر == 3) || (الشهر == 5) || (الشهر == 7)
        || (الشهر == 8) || (الشهر == 10) || (الشهر == 12)) { أرجع 31; };
    لو ((الشهر == 4) || (الشهر == 6) || (الشهر == 9) || (الشهر == 11)) { أرجع 30; };
    لو (الشهر == 2) {
        لو (سنة_كبيسة_تومل(السنة)) { أرجع 29; };
        أرجع 28;
    };
    أرجع 0;
}

عرف تحقق_تاريخ_تومل_عند(النص: &نص, البداية: غير_موقع): منطقي {
    لو ((البداية + 10) > (الطول(*النص) مثل غير_موقع)) { أرجع خطأ; };
    دع موضع_فاصل_السنة: غير_موقع = البداية + 4;
    دع موضع_فاصل_الشهر: غير_موقع = البداية + 7;
    لو (((*النص)[موضع_فاصل_السنة] != 0x2D) || ((*النص)[موضع_فاصل_الشهر] != 0x2D)) { أرجع خطأ; };
    دع السنة: غير_موقع;
    دع الشهر: غير_موقع;
    دع اليوم: غير_موقع;
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية, 4) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { السنة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 5, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الشهر := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 8, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { اليوم := القيمة; };
    دع الحد: غير_موقع = أيام_شهر_تومل(السنة, الشهر);
    أرجع (الحد != 0) && (اليوم >= 1) && (اليوم <= الحد);
}

عرف تحقق_وقت_تومل(
    النص: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    يسمح_بمنطقة: منطقي
): منطقي {
    لو ((البداية + 8) > النهاية) { أرجع خطأ; };
    دع موضع_فاصل_الساعة: غير_موقع = البداية + 2;
    دع موضع_فاصل_الدقيقة: غير_موقع = البداية + 5;
    لو (((*النص)[موضع_فاصل_الساعة] != 0x3A) || ((*النص)[موضع_فاصل_الدقيقة] != 0x3A)) { أرجع خطأ; };
    دع الساعة: غير_موقع;
    دع الدقيقة: غير_موقع;
    دع الثانية: غير_موقع;
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الساعة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 3, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الدقيقة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 6, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الثانية := القيمة; };
    لو ((الساعة > 23) || (الدقيقة > 59) || (الثانية > 60)) { أرجع خطأ; };

    دع الموضع: متغير غير_موقع = البداية + 8;
    لو ((الموضع < النهاية) && ((*النص)[الموضع] == 0x2E)) {
        الموضع := الموضع + 1;
        دع بداية_الكسر: غير_موقع = الموضع;
        بينما ((الموضع < النهاية) && ((*النص)[الموضع] >= 0x30) && ((*النص)[الموضع] <= 0x39)) {
            الموضع := الموضع + 1;
        }
        لو (الموضع == بداية_الكسر) { أرجع خطأ; };
    };
    لو (الموضع == النهاية) { أرجع صواب; };
    لو (!يسمح_بمنطقة) { أرجع خطأ; };
    لو (((*النص)[الموضع] == 0x5A) || ((*النص)[الموضع] == 0x7A)) {
        أرجع (الموضع + 1) == النهاية;
    };
    لو (((*النص)[الموضع] != 0x2B) && ((*النص)[الموضع] != 0x2D)) { أرجع خطأ; };
    لو ((الموضع + 6) != النهاية) { أرجع خطأ; };
    دع موضع_فاصل_المنطقة: غير_موقع = الموضع + 3;
    لو ((*النص)[موضع_فاصل_المنطقة] != 0x3A) { أرجع خطأ; };
    دع ساعة_المنطقة: غير_موقع;
    دع دقيقة_المنطقة: غير_موقع;
    طابق قيمة_أرقام_ثابتة_تومل(النص, الموضع + 1, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { ساعة_المنطقة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, الموضع + 4, 2) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { دقيقة_المنطقة := القيمة; };
    أرجع (ساعة_المنطقة <= 23) && (دقيقة_المنطقة <= 59);
}

عرف قيمة_تاريخ_وقت_صالحة_تومل(النص: &نص): منطقي {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو ((العدد >= 10) && تحقق_تاريخ_تومل_عند(النص, 0)) {
        لو (العدد == 10) { أرجع صواب; };
        دع الفاصل: غ8 = (*النص)[10];
        لو ((الفاصل != 0x54) && (الفاصل != 0x74) && (الفاصل != 0x20)) { أرجع خطأ; };
        أرجع تحقق_وقت_تومل(النص, 11, العدد, صواب);
    };
    أرجع تحقق_وقت_تومل(النص, 0, العدد, خطأ);
}

عرف حلل_قيمة_عارية_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    دع البايتات: متغير متجه غ8 = [];
    بينما (!في_نهاية_تومل(المحلل) && بايت_قيمة_عارية_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
        ألحق(البايتات, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
        تقدم_تومل(المحلل);
    }
    // RFC3339 date-times may use one space instead of T. Keep that one space
    // inside the scalar only when it separates a date from a time token.
    لو (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x20)) {
        دع حفظ: غير_موقع = (*المحلل).الموضع;
        دع الحالي: نص = من_بايتات(&البايتات);
        لو ((الطول(الحالي) مثل غير_موقع) == 10 && تحقق_تاريخ_تومل_عند(&الحالي, 0)) {
            (*المحلل).الموضع := حفظ + 1;
            لو (!في_نهاية_تومل(المحلل)) {
                دع التالي: غ8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
                لو ((التالي >= 0x30) && (التالي <= 0x39)) {
                    ألحق(البايتات, 0x20);
                    بينما (!في_نهاية_تومل(المحلل) && بايت_قيمة_عارية_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
                        ألحق(البايتات, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
                        تقدم_تومل(المحلل);
                    }
                } وإلا {
                    (*المحلل).الموضع := حفظ;
                };
            };
        };
    };
    دع النص: نص = من_بايتات(&البايتات);
    دع صواب_نص: نص = «true»;
    دع خطأ_نص: نص = «false»;
    لو (نصان_متساويان(&النص, &صواب_نص)) { أرجع نتيجة.نجح(قيمة_تومل.منطق(صواب)); };
    لو (نصان_متساويان(&النص, &خطأ_نص)) { أرجع نتيجة.نجح(قيمة_تومل.منطق(خطأ)); };
    لو (قيمة_تاريخ_وقت_صالحة_تومل(&النص)) { أرجع نتيجة.نجح(قيمة_تومل.تاريخ_وقت(النص)); };
    طابق صنف_رقم_تومل(&النص) مع
    | تصنيف_رقم_تومل.صحيح -> { أرجع نتيجة.نجح(قيمة_تومل.عدد(النص)); }
    | تصنيف_رقم_تومل.عائم -> { أرجع نتيجة.نجح(قيمة_تومل.عدد(النص)); }
    | تصنيف_رقم_تومل.غير_صالح -> { };
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.قيمة_غير_صالحة(), البداية));
}

عرف حلل_قيمة_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    تجاوز_مسافة_تومل(المحلل);
    لو (في_نهاية_تومل(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
    };
    دع الموضع: غير_موقع = (*المحلل).الموضع;
    دع ب: غ8 = بايت_تومل_عند(المحلل, الموضع);
    لو (ب == 0x22) {
        لو (يطابق_تومل_عند(المحلل, الموضع, «"""»)) {
            طابق حلل_سلسلة_أساسية_تومل(المحلل, صواب) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص)); };
        };
        طابق حلل_سلسلة_أساسية_تومل(المحلل, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص)); };
    };
    لو (ب == 0x27) {
        لو (يطابق_تومل_عند(المحلل, الموضع, «'''»)) {
            طابق حلل_سلسلة_حرفية_تومل(المحلل, صواب) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص)); };
        };
        طابق حلل_سلسلة_حرفية_تومل(المحلل, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص)); };
    };
    لو (ب == 0x5B) { أرجع حلل_مصفوفة_تومل(المحلل); };
    لو (ب == 0x7B) { أرجع حلل_جدول_ضمني_تومل(المحلل); };
    أرجع حلل_قيمة_عارية_تومل(المحلل);
}

عرف حلل_تعيين_تومل(المحلل: &متغير محلل_تومل): نتيجة منطقي, خطأ_تومل {
    طابق حلل_مسار_مفتاح_تومل(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الأجزاء) -> {
        تجاوز_مسافة_تومل(المحلل);
        لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x3D)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        تجاوز_مسافة_تومل(المحلل);
        طابق حلل_قيمة_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع العدد: غير_موقع = الطول(الأجزاء) مثل غير_موقع;
            دع المالك: متغير غير_موقع = (*المحلل).الجدول_الحالي;
            لو (العدد > 1) {
                طابق حل_جدول_مسار_تومل(
                    المحلل, المالك, &الأجزاء, العدد - 1, صواب, صواب
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الجدول) -> { المالك := الجدول; };
            };
            دع موضع_المفتاح: غير_موقع = العدد - 1;
            دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
            دع المفتاح: نص = *مرجع_المفتاح;
            لو (!أضف_مدخل_تومل(المحلل, المالك, المفتاح, القيمة, (*المحلل).الموضع)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
            };
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عرف حلل_رأس_جدول_تومل(المحلل: &متغير محلل_تومل): نتيجة منطقي, خطأ_تومل {
    دع البداية: غير_موقع = (*المحلل).الموضع;
    لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x5B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    دع مصفوفة_جداول: منطقي = يطابق_تومل_عند(المحلل, البداية, «[[»);
    لو (مصفوفة_جداول) { (*المحلل).الموضع := البداية + 2; }
    وإلا { (*المحلل).الموضع := البداية + 1; };
    تجاوز_مسافة_تومل(المحلل);
    دع الأجزاء: متجه نص;
    طابق حلل_مسار_مفتاح_تومل(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الأجزاء := القيمة; };
    تجاوز_مسافة_تومل(المحلل);
    لو (مصفوفة_جداول) {
        لو (!يطابق_تومل_عند(المحلل, (*المحلل).الموضع, «]]»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        (*المحلل).الموضع := (*المحلل).الموضع + 2;
        دع العدد: غير_موقع = الطول(الأجزاء) مثل غير_موقع;
        دع الأب: متغير غير_موقع = (*المحلل).الجذر;
        لو (العدد > 1) {
            طابق حل_جدول_مسار_تومل(المحلل, الأب, &الأجزاء, العدد - 1, صواب, خطأ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الجدول) -> { الأب := الجدول; };
        };
        دع موضع_المفتاح: غير_موقع = العدد - 1;
        دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
        دع المفتاح: نص = *مرجع_المفتاح;
        دع فهرس_المصفوفة: متغير غير_موقع = 0;
        طابق قيمة_مدخل_تومل_داخلية(المحلل, الأب, &المفتاح) مع
        | اختيار.لا_شيء -> {
            فهرس_المصفوفة := أضف_مصفوفة_تومل(المحلل);
            لو (!أضف_مدخل_تومل(المحلل, الأب, المفتاح, قيمة_تومل.مصفوفة(فهرس_المصفوفة), البداية)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), البداية));
            };
        }
        | اختيار.بعض(القيمة) -> {
            طابق القيمة مع
            | قيمة_تومل.مصفوفة(الفهرس) -> { فهرس_المصفوفة := الفهرس; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), البداية)); };
        };
        دع الجدول: غير_موقع = أضف_جدول_تومل(المحلل, صواب, خطأ);
        لو (!ألحق_مصفوفة_تومل(المحلل, فهرس_المصفوفة, قيمة_تومل.جدول(الجدول))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), البداية));
        };
        (*المحلل).الجدول_الحالي := الجدول;
    } وإلا {
        لو (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x5D)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        طابق حل_جدول_مسار_تومل(
            المحلل, (*المحلل).الجذر, &الأجزاء, الطول(الأجزاء) مثل غير_موقع, صواب, خطأ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجدول) -> {
            لو (!اضبط_جدول_معلنا(المحلل, الجدول)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.جدول_مكرر(), البداية));
            };
            (*المحلل).الجدول_الحالي := الجدول;
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عام عرف حلل_تومل(النص: &نص): نتيجة وثيقة_تومل, خطأ_تومل {
    دع الجداول: متجه جدول_تومل = [];
    دع المصفوفات: متجه مصفوفة_تومل = [];
    دع المحلل: متغير محلل_تومل = {
        النص: *النص,
        الموضع: 0,
        الجدول_الحالي: 0,
        الجذر: 0,
        الجداول: الجداول,
        المصفوفات: المصفوفات
    };
    دع الجذر: غير_موقع = أضف_جدول_تومل(&متغير المحلل, صواب, خطأ);
    المحلل.الجذر := الجذر;
    المحلل.الجدول_الحالي := الجذر;

    بينما (!في_نهاية_تومل(&المحلل)) {
        تجاوز_مسافة_تومل(&متغير المحلل);
        لو (في_نهاية_تومل(&المحلل)) { } وإلا {
            دع ب: غ8 = بايت_تومل_عند(&المحلل, المحلل.الموضع);
            لو (ب == 0x23) {
                تجاوز_تعليق_تومل(&متغير المحلل);
            } وإلا لو ((ب == 0x0A) || (ب == 0x0D)) {
                لو (!تجاوز_نهاية_سطر_تومل(&متغير المحلل)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), المحلل.الموضع));
                };
            } وإلا {
                لو (ب == 0x5B) {
                    طابق حلل_رأس_جدول_تومل(&متغير المحلل) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                } وإلا {
                    طابق حلل_تعيين_تومل(&متغير المحلل) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                };
                تجاوز_مسافة_تومل(&متغير المحلل);
                تجاوز_تعليق_تومل(&متغير المحلل);
                لو (!في_نهاية_تومل(&المحلل)) {
                    دع نهاية: غ8 = بايت_تومل_عند(&المحلل, المحلل.الموضع);
                    لو ((نهاية != 0x0A) && (نهاية != 0x0D)) {
                        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نص_لاحق(), المحلل.الموضع));
                    };
                    لو (!تجاوز_نهاية_سطر_تومل(&متغير المحلل)) {
                        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), المحلل.الموضع));
                    };
                };
            };
        };
    }

    دع الجذر_النهائي: غير_موقع = المحلل.الجذر;
    دع الجداول_النهائية: متغير متجه جدول_تومل = [];
    دع المصفوفات_النهائية: متغير متجه مصفوفة_تومل = [];
    بدّل(المحلل.الجداول, الجداول_النهائية);
    بدّل(المحلل.المصفوفات, المصفوفات_النهائية);
    دع الوثيقة: وثيقة_تومل = {
        الجذر: الجذر_النهائي,
        الجداول: الجداول_النهائية,
        المصفوفات: المصفوفات_النهائية
    };
    أرجع نتيجة.نجح(الوثيقة);
}

عام عرف قيمة_مفتاح_تومل(
    الوثيقة: &وثيقة_تومل,
    فهرس_الجدول: غير_موقع,
    المفتاح: &نص
): اختيار قيمة_تومل {
    لو (فهرس_الجدول >= (الطول((*الوثيقة).الجداول) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع الجدول: &جدول_تومل = &(*الوثيقة).الجداول[فهرس_الجدول];
    طابق موضع_مدخل_تومل(الجدول, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        دع مرجع_القيمة: &قيمة_تومل = &(*الجدول).المداخل[الموضع].القيمة;
        دع القيمة: قيمة_تومل = *مرجع_القيمة;
        أرجع اختيار.بعض(القيمة);
    };
}

عام عرف جدول_مفتاح_تومل(
    الوثيقة: &وثيقة_تومل,
    فهرس_الجدول: غير_موقع,
    المفتاح: &نص
): اختيار غير_موقع {
    طابق قيمة_مفتاح_تومل(الوثيقة, فهرس_الجدول, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق القيمة مع
        | قيمة_تومل.جدول(الجدول) -> { أرجع اختيار.بعض(الجدول); }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف مداخل_جدول_تومل(الوثيقة: &وثيقة_تومل, الفهرس: غير_موقع): متجه مدخل_جدول_تومل {
    لو (الفهرس >= (الطول((*الوثيقة).الجداول) مثل غير_موقع)) {
        دع فارغة: متجه مدخل_جدول_تومل = [];
        أرجع فارغة;
    };
    دع مرجع_المداخل: &متجه مدخل_جدول_تومل = &(*الوثيقة).الجداول[الفهرس].المداخل;
    دع المداخل: متجه مدخل_جدول_تومل = *مرجع_المداخل;
    أرجع المداخل;
}

عام عرف قيم_مصفوفة_تومل(الوثيقة: &وثيقة_تومل, الفهرس: غير_موقع): متجه قيمة_تومل {
    لو (الفهرس >= (الطول((*الوثيقة).المصفوفات) مثل غير_موقع)) {
        دع فارغة: متجه قيمة_تومل = [];
        أرجع فارغة;
    };
    دع مرجع_القيم: &متجه قيمة_تومل = &(*الوثيقة).المصفوفات[الفهرس].القيم;
    دع القيم: متجه قيمة_تومل = *مرجع_القيم;
    أرجع القيم;
}
