استورد std.env.system;
استورد compiler.backend.target.target_model;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.schema;
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.interpreter.interpreter;
استورد compiler.interpreter.values.runtime_values;
استورد compiler.interpreter.runtime_failures;

// Driver-level models only. CLI syntax, rendering and compiler execution stay
// in their canonical owners.

عام نوع اختيار_هدف_عملية =
    | تلقائي
    | صريح بنوع معرف_هدف
;

عام نوع اختيار_مزود_خلفية_عملية =
    | تلقائي
    | صريح بنوع هوية_مزود_خلفية
;

عام نوع نوع_مخرج_تجميع_عملية =
    | تنفيذي
    | كائن
    | مكتبة_مشتركة
    | كائن_مترابط
    | وحدة_هدف
    // Target assembly text (--emit=asm), as llc -filetype=asm / rustc --emit=asm.
    | نص_تجميع
    // The optimized LLVM IR of the module (--emit=llvm-ir), as rustc --emit=llvm-ir.
    | نص_وحدة_إل_إل_في_إم
;

عام نوع اختيار_لغة_تشخيص_عملية =
    // No --lang option: the historical Arabic default.
    | غير_محدد
    // --lang=auto: the host locale (LC_ALL, then LC_MESSAGES, then LANG).
    | تلقائي
    | العربية
    | الإنجليزية
;

عام نوع صيغة_تشخيص_عملية =
    | طرفي
    | مختصر
    | جيسون
;

عام نوع سياسة_لون_تشخيص_عملية =
    | تلقائي
    | دائما
    | أبدا
;

عام نوع إعداد_عرض_عملية = {
    اللغة: اختيار_لغة_تشخيص_عملية,
    الصيغة: صيغة_تشخيص_عملية,
    اللون: سياسة_لون_تشخيص_عملية
};

عام عرف إعداد_عرض_عملية_افتراضي(): إعداد_عرض_عملية {
    دع اللغة: اختيار_لغة_تشخيص_عملية = اختيار_لغة_تشخيص_عملية.غير_محدد();
    دع الصيغة: صيغة_تشخيص_عملية = صيغة_تشخيص_عملية.طرفي();
    دع اللون: سياسة_لون_تشخيص_عملية = سياسة_لون_تشخيص_عملية.تلقائي();
    دع الناتج: إعداد_عرض_عملية = {
        اللغة: اللغة,
        الصيغة: الصيغة,
        اللون: اللون
    };
    أرجع الناتج;
}

// The first set locale variable in POSIX precedence decides: a value starting
// with `ar` (ar, ar_SA.UTF-8, ar_EG, ...) selects Arabic, anything else English.
// With no locale variable set, auto is English as well.
عرف لغة_من_بيئة_المضيف(): لغة_تشخيص {
    دع الأسماء: متغير متجه نص = [];
    ألحق(الأسماء, «LC_ALL»);
    ألحق(الأسماء, «LC_MESSAGES»);
    ألحق(الأسماء, «LANG»);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        طابق متغير_بيئة_النظام(&الأسماء[ف]) مع
        | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
            لو ((الطول(القيمة) مثل طبيعي) > 0) {
                لو ((الطول(القيمة) مثل طبيعي) >= 2 && القيمة[0] == 0x61 && القيمة[1] == 0x72) {
                    أرجع لغة_تشخيص.العربية();
                };
                أرجع لغة_تشخيص.الإنجليزية();
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع لغة_تشخيص.الإنجليزية();
}

// Without --lang the compiler keeps its historical Arabic default; an explicit
// --lang=auto follows the host locale.
عام عرف حل_لغة_عرض_عملية(الاختيار: اختيار_لغة_تشخيص_عملية): لغة_تشخيص {
    طابق الاختيار مع
    | اختيار_لغة_تشخيص_عملية.غير_محدد -> { أرجع لغة_تشخيص.العربية(); }
    | اختيار_لغة_تشخيص_عملية.تلقائي -> { أرجع لغة_من_بيئة_المضيف(); }
    | اختيار_لغة_تشخيص_عملية.العربية -> { أرجع لغة_تشخيص.العربية(); }
    | اختيار_لغة_تشخيص_عملية.الإنجليزية -> { أرجع لغة_تشخيص.الإنجليزية(); };
}

// Terminal compilation mode. Check consumes the exact Frontend -> MSIR path and
// stops only after canonical MSIR verification.
عام نوع نوع_خرج_ربط_مترجم =
    | تنفيذي
    | مكتبة_مشتركة
    | كائن_مترابط
    | وحدة_هدف
;

// The form of an object request: a binary object, target assembly text
// (--emit=asm) or the optimized LLVM IR (--emit=llvm-ir).
عام نوع نص_مخرج_كائن_مترجم =
    | ثنائي
    | تجميع
    | وحدة_إل_إل_في_إم
;

عام نوع طلب_تجميع_مترجم =
    // `check` for a registered target: target guards select its declarations.
    | تحقق بنوع معرف_هدف
    | تفسير بنوع معرف_هدف
    // The last field asks for target assembly text or LLVM IR instead of an object.
    | كائن بنوع (معرف_هدف, هوية_مزود_خلفية, نص_مخرج_كائن_مترجم)
    | ربط بنوع (
        معرف_هدف,
        هوية_مزود_خلفية,
        نوع_خرج_ربط_مترجم,
        متجه نص,
        اختياري نص
    )
;

عام نوع نتيجة_تجميع_مترجم =
    | تحقق_مكتمل
    | نتيجة_تفسير بنوع نتيجة_تفسير_مسير
    | فشل_تفسير بنوع مجموعة_تشخيصات
    | كائن_مكتمل بنوع متجه ط8
    | تنفيذي_مكتمل بنوع متجه ط8
    | مكتبة_مشتركة_مكتملة بنوع متجه ط8
    | كائن_مترابط_مكتمل بنوع متجه ط8
    | وحدة_هدف_مكتملة بنوع متجه ط8
    | ملغى
    | فشل_إعداد بنوع مجموعة_تشخيصات
    | فشل_واجهة بنوع مجموعة_تشخيصات
    | فشل_مسير بنوع مجموعة_تشخيصات
    | فشل_داخلي بنوع مجموعة_تشخيصات
    | مدخل_تفسير_غير_متاح
    | هدف_غير_مسجل
    | هدف_تفسير_غير_متوافق
    | فشل_خلفية بنوع مجموعة_تشخيصات
;

// One explicit source for a logical module (--module-source=<module>=<file>).
// It is configuration input to the canonical logical environment, recorded as
// that module's explicit source location (logical_environment.sn
// أضف_موقع_مصدر_وحدة) before the Frontend loads anything: the option names
// the file that is the source of that module. A build uses it to select
// compiler-build capabilities of the program it compiles: a Native-only
// SultanC compiler binds compiler.backend.provider.llvm.llvm_codegen to
// compiler/backend/provider/llvm/unavailable.sn. It never selects a backend,
// a target or a library of the current compilation.
عام نوع ربط_مصدر_وحدة_عملية = {
    الوحدة: نص,
    المصدر: نص
};

// Process request owns normalized external orchestration facts. CLI spellings
// such as -c and --emit=obj collapse into the same output kind here, while
// backend selection remains auto or explicit until Target policy resolves it.
عام نوع طلب_عملية_مترجم =
    | مساعدة
    | إصدار
    | أهداف
    | شرح بنوع نص
    | تحقق بنوع (نص, متجه نص, متجه ربط_مصدر_وحدة_عملية, اختيار_هدف_عملية)
    | تفسير بنوع (نص, متجه نص, متجه متجه ط8, اختيار_هدف_عملية, متجه ربط_مصدر_وحدة_عملية)
    | تجميع بنوع (
        نص,
        متجه نص,
        متجه نص,
        نص,
        اختيار_هدف_عملية,
        اختيار_مزود_خلفية_عملية,
        نوع_مخرج_تجميع_عملية,
        متجه ربط_مصدر_وحدة_عملية,
        // -l library names and -L search directories, resolved against the
        // target once it is known.
        متجه نص,
        متجه نص
    )
;

عام نوع نتيجة_عملية_مترجم =
    | أمر_مكتمل
    | تحقق_مكتمل
    | نتيجة_تفسير بنوع نتيجة_تفسير_مسير
    | فشل_تفسير بنوع مجموعة_تشخيصات
    | كائن_مكتمل
    | تنفيذي_مكتمل
    | مكتبة_مشتركة_مكتملة
    | كائن_مترابط_مكتمل
    | وحدة_هدف_مكتملة
    | استدعاء_غير_صالح بنوع مجموعة_تشخيصات
    | هدف_غير_معروف بنوع مجموعة_تشخيصات
    | هدف_المضيف_غير_متاح بنوع مجموعة_تشخيصات
    | فشل_تجميع بنوع نتيجة_تجميع_مترجم
    | فشل_بيئة_أو_مخرج بنوع مجموعة_تشخيصات
;

عام نوع نتيجة_تحليل_استدعاء_مترجم =
    | صالح بنوع (طلب_عملية_مترجم, إعداد_عرض_عملية)
    | غير_صالح بنوع (مجموعة_تشخيصات, إعداد_عرض_عملية)
    | هدف_غير_معروف بنوع (مجموعة_تشخيصات, إعداد_عرض_عملية)
;
