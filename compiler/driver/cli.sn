                | أمر_واجهة_مترجم.مساعدة -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.إصدار -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.أهداف -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.شرح -> {
                    لو (وجد_شرح) {
                        دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                            مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                        );
                        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                    };
                    كود_الشرح := الحجة;
                    وجد_شرح := صواب;
                }
                | _ -> {
                    مسار_المصدر := الحجة;
                    وجد_مصدر := صواب;
                };
            } وإلا {
                طابق الأمر مع
                | أمر_واجهة_مترجم.تجميع -> {
                    ألحق(مسارات_مدخلات_الربط, الحجة);
                }
                | _ -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.مصدر_رئيسي_متعدد(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(
                        التشخيصات,
                        الإعداد
                    );
                };
            };
            ف := ف + 1;
        };
    }

    طابق الأمر مع
    | أمر_واجهة_مترجم.مساعدة -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.مساعدة(), الإعداد);
    }
    | أمر_واجهة_مترجم.إصدار -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.إصدار(), الإعداد);
    }
    | أمر_واجهة_مترجم.أهداف -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.أهداف(), الإعداد);
    }
    | أمر_واجهة_مترجم.شرح -> {
        لو (!وجد_شرح) {
            // `explain` without the code to explain.
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                مفتاح_حجة_تشخيص.القيمة(), «explain», خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        طابق معرف_تشخيص_من_كود(&كود_الشرح) مع
        | اختياري.لا_شيء -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.القيمة(), كود_الشرح, خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختياري.موجود(_) -> {
            أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.شرح(كود_الشرح), الإعداد);
        };
    }
    | _ -> { };

    لو (!وجد_مصدر) {
        دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
            معرف_تشخيص.مصدر_مترجم_مفقود()
        );
        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
    };

    طابق الأمر مع
    | أمر_واجهة_مترجم.تحقق -> {
        // `check` accepts --target: target guards are checked for it.
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_مزود_خلفية) {
            دع بلا_هدف: نص = «»;
            دع بلا_مصدر: نص = «»;
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &بلا_هدف, &بلا_مصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        دع اختيار_هدف_الفحص: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
        لو (وجد_هدف) {
            طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
            | نتيجة_تهجئة_هدف.غير_معروفة -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.هدف_مترجم_غير_معروف(),
                    مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
            }
            | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
                اختيار_هدف_الفحص := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            };
        };
        دع إضافية: متجه نص = [];
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تحقق(مسار_المصدر, إضافية, روابط_مصادر_الوحدات, اختيار_هدف_الفحص), الإعداد
        );
    }
    | أمر_واجهة_مترجم.تفسير -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_مزود_خلفية) {
            دع بلا_هدف: نص = «»;
            دع بلا_مصدر: نص = «»;
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &بلا_هدف, &بلا_مصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        // Only options parsed before `run` select the execution target.
        // Arguments following the source remain the program's argv.
        دع اختيار_الهدف: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
        لو (وجد_هدف) {
            طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
            | نتيجة_تهجئة_هدف.غير_معروفة -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.هدف_مترجم_غير_معروف(),
                    مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
            }
            | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
                اختيار_الهدف := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            };
        };
        دع إضافية: متجه نص = [];
        // The interpreted program's argv: its own path first, as the kernel
        // gives a native executable its image path, then its arguments.
        دع وسائط_البرنامج_الكاملة: متغير متجه متجه ط8 = [];
        دع مسار_البرنامج: متجه ط8 = بايتات_وسيط_برنامج_من_حجة(&مسار_المصدر);
        ألحق(وسائط_البرنامج_الكاملة, مسار_البرنامج);
        دع فهرس_الوسيط: متغير طبيعي = 0;
        طالما (فهرس_الوسيط < (الطول(وسائط_التفسير) مثل طبيعي)) {
            دع الوسيط: متجه ط8 = انسخ_بايتات(&وسائط_التفسير[فهرس_الوسيط]);
            ألحق(وسائط_البرنامج_الكاملة, الوسيط);
            فهرس_الوسيط := فهرس_الوسيط + 1;
        }
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تفسير(
                مسار_المصدر, إضافية, وسائط_البرنامج_الكاملة, اختيار_الهدف, روابط_مصادر_الوحدات
            ), الإعداد
        );
    }
    | _ -> { };

    دع اختيار_الهدف: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
    دع صيغة_الهدف: متغير اختياري صيغة_كائن_هدف = اختياري.لا_شيء();
    لو (وجد_هدف) {
        طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
        | نتيجة_تهجئة_هدف.غير_معروفة -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.هدف_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
        }
        | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
            اختيار_الهدف := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            صيغة_الهدف := اختياري.موجود(الهدف.صيغة_الكائن);
        };
    };

    لو (!وجد_إخراج) {
        مسار_الإخراج := ابن_مسار_إخراج_افتراضي(&مسار_المصدر, نوع_المخرج, صيغة_الهدف);
    };
    دع إضافية: متجه نص = [];
    أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
        طلب_عملية_مترجم.تجميع(
            مسار_المصدر,
            إضافية,
            مسارات_مدخلات_الربط,
            مسار_الإخراج,
            اختيار_الهدف,
            اختيار_مزود_الخلفية,
            نوع_المخرج,
            روابط_مصادر_الوحدات,
            أسماء_مكتبات_الربط,
            أدلة_مكتبات_الربط
        ),
        الإعداد
    );
}
