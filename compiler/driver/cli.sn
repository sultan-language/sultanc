                    معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة(),
                    مفتاح_حجة_تشخيص.القيمة(), القيمة, خطأ, صواب
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            ف := ف + 2;
        } وإلا لو ((الطول(الحجة) مثل غير_موقع) > 20 && يطابق_عند(&الحجة, 0, «--diagnostic-format=»)) {
            دع القيمة: نص = ذيل_حجة_من(&الحجة, 20);
            طابق صيغة_واجهة_من_نص(&القيمة) مع
            | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
            | نتيجة_صيغة_واجهة.غير_صالحة -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة(),
                    مفتاح_حجة_تشخيص.القيمة(), القيمة, خطأ, صواب
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «--color»)) {
            لو (ف + 1 >= عدد_الحجج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            دع القيمة: نص;
            طابق وسيطة(ف + 1) مع
            | اختيار.لا_شيء -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | اختيار.بعض(المدخل) -> { القيمة := المدخل; };
            طابق لون_واجهة_من_نص(&القيمة) مع
            | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
            | نتيجة_لون_واجهة.غير_صالحة -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح(),
                    مفتاح_حجة_تشخيص.القيمة(), القيمة, خطأ, صواب
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            ف := ف + 2;
        } وإلا لو ((الطول(الحجة) مثل غير_موقع) > 8 && يطابق_عند(&الحجة, 0, «--color=»)) {
            دع القيمة: نص = ذيل_حجة_من(&الحجة, 8);
            طابق لون_واجهة_من_نص(&القيمة) مع
            | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
            | نتيجة_لون_واجهة.غير_صالحة -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح(),
                    مفتاح_حجة_تشخيص.القيمة(), القيمة, خطأ, صواب
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            ف := ف + 1;
        } وإلا لو (((الطول(الحجة) مثل غير_موقع) > 0) && الحجة[0] == 0x2D) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.خيار_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        } وإلا {
            لو (!وجد_مصدر && !وجد_أمر) {
                طابق أمر_من_موضعي(&الحجة) مع
                | اختيار.بعض(أمر_جديد) -> {
                    لو (حجة_تساوي(&الحجة, «run») || حجة_تساوي(&الحجة, «interpret»)) {
                        بعد_أمر_التفسير := صواب;
                    };
                    الأمر := أمر_جديد;
                    وجد_أمر := صواب;
                }
                | اختيار.لا_شيء -> {
                    مسار_المصدر := الحجة;
                    وجد_مصدر := صواب;
                };
            } وإلا لو (!وجد_مصدر) {
                طابق الأمر مع
                | أمر_واجهة_مترجم.مساعدة -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.إصدار -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.أهداف -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                }
                | أمر_واجهة_مترجم.شرح -> {
                    لو (وجد_شرح) {
                        دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.معامل_موضعي_غير_متوقع(),
                            مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                        );
                        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                    };
                    كود_الشرح := الحجة;
                    وجد_شرح := صواب;
                }
                | _ -> {
                    مسار_المصدر := الحجة;
                    وجد_مصدر := صواب;
                };
            } وإلا {
                طابق الأمر مع
                | أمر_واجهة_مترجم.تجميع -> {
                    ألحق(مسارات_مدخلات_الربط, الحجة);
                }
                | _ -> {
                    دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.مصدر_رئيسي_متعدد(),
                        مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                    );
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(
                        التشخيصات,
                        الإعداد
                    );
                };
            };
            ف := ف + 1;
        };
    }

    طابق الأمر مع
    | أمر_واجهة_مترجم.مساعدة -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.مساعدة(), الإعداد);
    }
    | أمر_واجهة_مترجم.إصدار -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.إصدار(), الإعداد);
    }
    | أمر_واجهة_مترجم.أهداف -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.أهداف(), الإعداد);
    }
    | أمر_واجهة_مترجم.شرح -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || !وجد_شرح) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        طابق معرف_تشخيص_من_كود(&كود_الشرح) مع
        | اختيار.لا_شيء -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.القيمة(), كود_الشرح, خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختيار.بعض(_) -> {
            أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.شرح(كود_الشرح), الإعداد);
        };
    }
    | _ -> { };

    لو (!وجد_مصدر) {
        دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
            معرف_تشخيص.مصدر_مترجم_مفقود()
        );
        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
    };

    طابق الأمر مع
    | أمر_واجهة_مترجم.تحقق -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        دع إضافية: متجه نص = [];
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تحقق(مسار_المصدر, إضافية), الإعداد
        );
    }
    | أمر_واجهة_مترجم.تفسير -> {
        لو (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية) {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.أوضاع_مترجم_متعارضة()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        دع إضافية: متجه نص = [];
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تفسير(مسار_المصدر, إضافية, وسائط_التفسير), الإعداد
        );
    }
    | _ -> { };

    دع اختيار_الهدف: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
    لو (وجد_هدف) {
        طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
        | نتيجة_تهجئة_هدف.غير_معروفة -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.هدف_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
        }
        | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
            اختيار_الهدف := اختيار_هدف_عملية.صريح(الهدف.المعرف);
        };
    };

    دع كائن: منطقي = نوع_المخرج == نوع_مخرج_تجميع_عملية.كائن()
        || نوع_المخرج == نوع_مخرج_تجميع_عملية.كائن_مترابط()
        || نوع_المخرج == نوع_مخرج_تجميع_عملية.وحدة_هدف();
    لو (!وجد_إخراج) {
        مسار_الإخراج := ابن_مسار_إخراج_افتراضي(&مسار_المصدر, كائن);
    };
    دع إضافية: متجه نص = [];
    أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
        طلب_عملية_مترجم.تجميع(
            مسار_المصدر,
            إضافية,
            مسارات_مدخلات_الربط,
            مسار_الإخراج,
            اختيار_الهدف,
            اختيار_مزود_الخلفية,
            نوع_المخرج
        ),
        الإعداد
    );
}
