    إذا (فحص_التنسيق && الأمر != أمر_واجهة_مترجم.تنسيق()) {
        ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
            «--check», سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
        );
        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
    };

    // -l/-L name libraries for the linker, or for `run` and `interpret` the
    // libraries the running program loads (process_driver.sn). A command or
    // output kind that links nothing (check, help, -c, --emit=asm, ...)
    // would drop them silently, so it rejects them instead.
    إذا ((الطول(أول_خيار_ربط) مثل طبيعي) > 0) {
        ليكن يربط: منطقي = ((الأمر == أمر_واجهة_مترجم.تجميع())
            && ((نوع_المخرج == نوع_مخرج_تجميع_عملية.تنفيذي()) || (نوع_المخرج == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة())))
            || ((الأمر == أمر_واجهة_مترجم.تفسير()) && !وجد_نوع_مخرج)
            || ((الأمر == أمر_واجهة_مترجم.اختبار()) && !وجد_نوع_مخرج);
        إذا (!يربط) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_ربط, سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
    };

    طابق الأمر مع
    | أمر_واجهة_مترجم.مساعدة -> {
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.مساعدة(), الإعداد);
    }
    | أمر_واجهة_مترجم.إصدار -> {
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.إصدار(), الإعداد);
    }
    | أمر_واجهة_مترجم.أهداف -> {
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.أهداف(), الإعداد);
    }
    | أمر_واجهة_مترجم.شرح -> {
        إذا (!وجد_شرح) {
            // `explain` without the code to explain.
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                مفتاح_حجة_تشخيص.القيمة(), «explain», خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        طابق معرف_تشخيص_من_كود(&كود_الشرح) مع
        | اختياري.لا_شيء -> {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.القيمة(), كود_الشرح, خطأ, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختياري.موجود(_) -> {
            أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.شرح(كود_الشرح), الإعداد);
        };
    }
    | أمر_واجهة_مترجم.تنسيق -> {
        // `fmt` formats source text only: no build, target or module option
        // applies to it.
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_هدف || وجد_مزود_خلفية || وجد_مصدر || (الطول(روابط_مصادر_الوحدات) مثل طبيعي) > 0) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &حجة_الهدف, &مسار_المصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        ليكن طلب_التنسيق: طلب_تنسيق = { المسارات: مسارات_التنسيق, فحص_فقط: فحص_التنسيق };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(طلب_عملية_مترجم.تنسيق(طلب_التنسيق), الإعداد);
    }
    | _ -> { };

    // Without --comptime-budget, $SULTANC_COMPTIME_BUDGET sets it: read here
    // only (compile_time.sn reads no environment), and a value that is no
    // positive count is an error, not a silent default.
    إذا (الإعداد.ميزانية_وقت_الترجمة == 0) {
        ليكن اسم_الميزانية: نص = «SULTANC_COMPTIME_BUDGET»;
        طابق متغير_بيئة_النظام(&اسم_الميزانية) مع
        | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
            إذا ((الطول(القيمة) مثل طبيعي) > 0) {
                طابق عدد_موجب_بفواصل(&القيمة) مع
                | اختياري.موجود(الميزانية) -> { الإعداد.ميزانية_وقت_الترجمة := الميزانية; }
                | اختياري.لا_شيء -> {
                    ليكن الإسناد: متغير متجه ط8 = بايتات_من_نص(«SULTANC_COMPTIME_BUDGET=»);
                    ليكن ب: متغير طبيعي = 0;
                    طالما (ب < (الطول(القيمة) مثل طبيعي)) { ألحق(الإسناد, القيمة[ب]); ب := ب + 1; }
                    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                        معرف_تشخيص.قيمة_متغير_بيئة_غير_مقبولة(), اختياري.لا_شيء()
                    );
                    ليكن أضيفت_القيمة: منطقي = أضف_حجة_تشخيص(
                        &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&الإسناد)
                    );
                    ليكن بلا_حجج: متجه حجة_تشخيص = [];
                    ليكن أضيفت_المساعدة: منطقي = أضف_مساعدة(
                        &متغير التشخيص, مفتاح_صياغة.مساعدة_عدد_موجب_بفواصل(), بلا_حجج
                    );
                    ليكن التشخيصات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
                    أصدر_تشخيصا(&متغير التشخيصات, &التشخيص);
                    أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
                };
            };
        }
        | _ -> { };
    };

    إذا (!وجد_مصدر) {
        ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
            معرف_تشخيص.مصدر_مترجم_مفقود()
        );
        أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
    };

    طابق الأمر مع
    | أمر_واجهة_مترجم.تحقق -> {
        // `check` accepts --target: target guards are checked for it.
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_مزود_خلفية) {
            ليكن بلا_هدف: نص = «»;
            ليكن بلا_مصدر: نص = «»;
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &بلا_هدف, &بلا_مصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        ليكن اختيار_هدف_الفحص: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
        إذا (وجد_هدف) {
            طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
            | نتيجة_تهجئة_هدف.غير_معروفة -> {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.هدف_مترجم_غير_معروف(),
                    مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
            }
            | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
                اختيار_هدف_الفحص := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            };
        };
        ليكن إضافية: متجه نص = [];
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تحقق(مسار_المصدر, إضافية, روابط_مصادر_الوحدات, اختيار_هدف_الفحص, مستوى_التحسين), الإعداد
        );
    }
    | أمر_واجهة_مترجم.تفسير -> {
        إذا (وجد_نوع_مخرج || وجد_إخراج || وجد_مزود_خلفية) {
            ليكن بلا_هدف: نص = «»;
            ليكن بلا_مصدر: نص = «»;
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &بلا_هدف, &بلا_مصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        // Only options parsed before `run` select the execution target.
        // Arguments following the source remain the program's argv.
        ليكن اختيار_الهدف: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
        إذا (وجد_هدف) {
            طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
            | نتيجة_تهجئة_هدف.غير_معروفة -> {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.هدف_مترجم_غير_معروف(),
                    مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
            }
            | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
                اختيار_الهدف := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            };
        };
        ليكن إضافية: متجه نص = [];
        // The interpreted program's argv: its own path first, as the kernel
        // gives a native executable its image path, then its arguments.
        ليكن وسائط_البرنامج_الكاملة: متغير متجه متجه ط8 = [];
        ليكن مسار_البرنامج: متجه ط8 = بايتات_وسيط_برنامج_من_حجة(&مسار_المصدر);
        ألحق(وسائط_البرنامج_الكاملة, مسار_البرنامج);
        ليكن فهرس_الوسيط: متغير طبيعي = 0;
        طالما (فهرس_الوسيط < (الطول(وسائط_التفسير) مثل طبيعي)) {
            ليكن الوسيط: متجه ط8 = انسخ_بايتات(&وسائط_التفسير[فهرس_الوسيط]);
            ألحق(وسائط_البرنامج_الكاملة, الوسيط);
            فهرس_الوسيط := فهرس_الوسيط + 1;
        }
        ليكن مستوى_التشغيل: متغير مستوى_تحسين_مزود_إل_إل_في_إم = مستوى_التحسين;
        إذا (!حدد_التحسين) { مستوى_التشغيل := مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي(); };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.تفسير(
                مسار_المصدر, إضافية, وسائط_البرنامج_الكاملة, اختيار_الهدف, روابط_مصادر_الوحدات,
                أسماء_مكتبات_الربط, أدلة_مكتبات_الربط, مستوى_التشغيل
            ), الإعداد
        );
    }
    | أمر_واجهة_مترجم.اختبار -> {
        // `test` builds its own executable and runs it: --emit names an
        // output it does not write. --target, -b and -O apply; with
        // --interpret the interpreter runs the tests, so -b does not.
        إذا (وجد_نوع_مخرج || (تفسير_الاختبارات && وجد_مزود_خلفية)) {
            ليكن بلا_هدف: نص = «»;
            ليكن بلا_مصدر: نص = «»;
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                أول_خيار_لا_يناسب_الأمر(&أول_خيار_بناء, &بلا_هدف, &بلا_مصدر),
                سبب_تشخيص.سبب_واجهة_خيار_لا_يناسب_الأمر()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        // `--no-run -o <path>` keeps the test program at <path> and runs
        // nothing (docs/en/reference/command-line.md): -o alone would build a
        // program that is deleted after its run, --no-run alone one with no
        // place, and --list, --interpret and --test-index all run or list.
        ليكن مخرج_الاختبار: متغير اختياري نص = اختياري.لا_شيء();
        إذا (منع_تشغيل_الاختبارات) {
            إذا (!وجد_إخراج) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    «--no-run», سبب_تشخيص.سبب_واجهة_منع_التشغيل_يتطلب_إخراجا()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            ليكن يشغل_أو_يسرد: منطقي = قائمة_الاختبارات || تفسير_الاختبارات;
            ليكن بفهرس: متغير منطقي = خطأ;
            طابق فهرس_الاختبار مع
            | اختياري.موجود(_) -> { بفهرس := صواب; }
            | اختياري.لا_شيء -> { };
            إذا (يشغل_أو_يسرد || بفهرس) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    «--no-run», سبب_تشخيص.سبب_واجهة_منع_التشغيل_يعارض_التشغيل()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            مخرج_الاختبار := اختياري.موجود(انسخ_نص(&مسار_الإخراج));
        } وإلا إذا (وجد_إخراج) {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                «-o», سبب_تشخيص.سبب_واجهة_إخراج_اختبار_يتطلب_منع_التشغيل()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        };
        ليكن اختيار_هدف_الاختبار: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
        إذا (وجد_هدف) {
            طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
            | نتيجة_تهجئة_هدف.غير_معروفة -> {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.هدف_مترجم_غير_معروف(),
                    مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
            }
            | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
                اختيار_هدف_الاختبار := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            };
        };
        ليكن إضافية: متجه نص = [];
        ليكن اختيار_الاختبارات: اختيار_اختبارات = {
            المرشح: مرشح_الاختبار, الأسماء: أسماء_الاختبارات, الملفات: ملفات_الاختبارات
        };
        أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
            طلب_عملية_مترجم.اختبار(
                مسار_المصدر, إضافية, اختيار_هدف_الاختبار, اختيار_مزود_الخلفية,
                روابط_مصادر_الوحدات, أسماء_مكتبات_الربط, أدلة_مكتبات_الربط,
                مستوى_التحسين, اختيار_الاختبارات, قائمة_الاختبارات, تفسير_الاختبارات,
                فهرس_الاختبار, مخرج_الاختبار
            ), الإعداد
        );
    }
    | _ -> { };

    ليكن اختيار_الهدف: متغير اختيار_هدف_عملية = اختيار_هدف_عملية.تلقائي();
    ليكن صيغة_الهدف: متغير اختياري صيغة_كائن_هدف = اختياري.لا_شيء();
    إذا (وجد_هدف) {
        طابق حل_تهجئة_هدف_مسجل(&تهجئة_الهدف) مع
        | نتيجة_تهجئة_هدف.غير_معروفة -> {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.هدف_مترجم_غير_معروف(),
                مفتاح_حجة_تشخيص.الهدف(), تهجئة_الهدف, صواب, خطأ
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد);
        }
        | نتيجة_تهجئة_هدف.معروفة(الهدف) -> {
            اختيار_الهدف := اختيار_هدف_عملية.صريح(الهدف.المعرف);
            صيغة_الهدف := اختياري.موجود(الهدف.صيغة_الكائن);
        };
    };

    إذا (!وجد_إخراج) {
        مسار_الإخراج := ابن_مسار_إخراج_افتراضي(&مسار_المصدر, نوع_المخرج, صيغة_الهدف);
        // The MSIR text is read, not kept: stdout unless -o names a file.
        إذا (نوع_المخرج == نوع_مخرج_تجميع_عملية.نص_مسير()) { مسار_الإخراج := مسار_الخرج_القياسي_لمسير(); };
    };
    ليكن إضافية: متجه نص = [];
    أرجع نتيجة_تحليل_استدعاء_مترجم.صالح(
        طلب_عملية_مترجم.تجميع(
            مسار_المصدر,
            إضافية,
            مسارات_مدخلات_الربط,
            مسار_الإخراج,
            اختيار_الهدف,
            اختيار_مزود_الخلفية,
            نوع_المخرج,
            روابط_مصادر_الوحدات,
            أسماء_مكتبات_الربط,
            أدلة_مكتبات_الربط,
            مستوى_التحسين
        ),
        الإعداد
    );
}
