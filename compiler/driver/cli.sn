// CLI owns external command syntax only. Target spelling belongs to Target;
// orchestration belongs to Driver; diagnostics remain structured.

نوع أمر_واجهة_مترجم =
    | تجميع
    | تحقق
    | تفسير
    | مساعدة
    | إصدار
    | أهداف
    | شرح
    | تنسيق
    // `sultanc test` (docs/en/reference/testing.md).
    | اختبار
;

نوع نتيجة_لغة_واجهة =
    | صالحة بنوع اختيار_لغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مخرج_واجهة =
    | صالح بنوع نوع_مخرج_تجميع_عملية
    | غير_صالح
;

نوع نتيجة_صيغة_واجهة =
    | صالحة بنوع صيغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_لون_واجهة =
    | صالحة بنوع سياسة_لون_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مزود_خلفية_واجهة =
    | صالحة بنوع هوية_مزود_خلفية
    | غير_صالحة
;

عرف حجة_تساوي(الحجة: &نص, المطلوب: نص): منطقي {
    ليكن القيمة: نص = المطلوب;
    أرجع نصان_متساويان(الحجة, &القيمة);
}

عرف ذيل_حجة_من(الحجة: &نص, البداية: طبيعي): نص {
    ليكن القيمة: نص = *الحجة;
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    ليكن العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// Splits a --module-source value `<module>=<file>` at its first '='. Both
// parts must be non-empty; the module part is a dotted logical module path as
// written in an import (validated by the canonical resolver, not here).
عرف ربط_مصدر_وحدة_من_نص(القيمة: &نص): اختياري ربط_مصدر_وحدة_عملية {
    ليكن الأصل: نص = *القيمة;
    ليكن العدد: طبيعي = الطول(الأصل) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد && الأصل[ف] != 0x3D) {
        ف := ف + 1;
    }
    إذا (ف == 0 || ف + 1 >= العدد) {
        أرجع اختياري.لا_شيء();
    };
    ليكن بايتات_الوحدة: متغير متجه ط8 = [];
    ليكن م: متغير طبيعي = 0;
    طالما (م < ف) {
        ألحق(بايتات_الوحدة, الأصل[م]);
        م := م + 1;
    }
    ليكن الوحدة: نص = من_بايتات(&بايتات_الوحدة);
    ليكن المصدر: نص = ذيل_حجة_من(القيمة, ف + 1);
    ليكن الربط: ربط_مصدر_وحدة_عملية = {
        الوحدة: الوحدة,
        المصدر: المصدر
    };
    أرجع اختياري.موجود(الربط);
}

عرف لغة_واجهة_من_نص(القيمة: &نص): نتيجة_لغة_واجهة {
    إذا (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.تلقائي());
    };
    إذا (حجة_تساوي(القيمة, «ar»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.العربية());
    };
    إذا (حجة_تساوي(القيمة, «en»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.الإنجليزية());
    };
    أرجع نتيجة_لغة_واجهة.غير_صالحة();
}

عرف مخرج_واجهة_من_نص(القيمة: &نص): نتيجة_مخرج_واجهة {
    إذا (حجة_تساوي(القيمة, «exe»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.تنفيذي());
    };
    إذا (حجة_تساوي(القيمة, «obj»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن());
    };
    إذا (حجة_تساوي(القيمة, «shared»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.مكتبة_مشتركة());
    };
    إذا (حجة_تساوي(القيمة, «reloc»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن_مترابط());
    };
    إذا (حجة_تساوي(القيمة, «module»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.وحدة_هدف());
    };
    إذا (حجة_تساوي(القيمة, «asm»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.نص_تجميع());
    };
    إذا (حجة_تساوي(القيمة, «llvm-ir»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم());
    };
    إذا (حجة_تساوي(القيمة, «msir»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.نص_مسير());
    };
    أرجع نتيجة_مخرج_واجهة.غير_صالح();
}

عرف صيغة_واجهة_من_نص(القيمة: &نص): نتيجة_صيغة_واجهة {
    إذا (حجة_تساوي(القيمة, «human»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.طرفي());
    };
    إذا (حجة_تساوي(القيمة, «short»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.مختصر());
    };
    إذا (حجة_تساوي(القيمة, «json»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.جيسون());
    };
    أرجع نتيجة_صيغة_واجهة.غير_صالحة();
}

عرف لون_واجهة_من_نص(القيمة: &نص): نتيجة_لون_واجهة {
    إذا (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.تلقائي());
    };
    إذا (حجة_تساوي(القيمة, «always»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.دائما());
    };
    إذا (حجة_تساوي(القيمة, «never»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.أبدا());
    };
    أرجع نتيجة_لون_واجهة.غير_صالحة();
}

عرف مزود_خلفية_واجهة_من_نص(القيمة: &نص): نتيجة_مزود_خلفية_واجهة {
    إذا (حجة_تساوي(القيمة, «native»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.أصلي());
    };
    إذا (حجة_تساوي(القيمة, «llvm»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.إل_إل_في_إم());
    };
    أرجع نتيجة_مزود_خلفية_واجهة.غير_صالحة();
}

عام عرف تشخيصات_واجهة_بقيمة(
    المعرف: معرف_تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص,
    مساعدة_الأهداف: منطقي,
    مساعدة_القيمة: منطقي
): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    ليكن أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, المفتاح, القيمة);
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    إذا (مساعدة_الأهداف) {
        ليكن أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
            بلا_حجج
        );
    } وإلا إذا (مساعدة_القيمة) {
        ليكن أضف_مساعدة_قيمة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار(),
            بلا_حجج
        );
    } وإلا {
        ليكن أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
            بلا_حجج
        );
    };
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The first argument a command does not accept: an output, backend or target
// option, else the source path. Empty when none was recorded.
عرف أول_خيار_لا_يناسب_الأمر(البناء: &نص, الهدف: &نص, المصدر: &نص): نص {
    إذا ((الطول(*البناء) مثل طبيعي) > 0) { أرجع انسخ_نص(البناء); };
    إذا ((الطول(*الهدف) مثل طبيعي) > 0) { أرجع انسخ_نص(الهدف); };
    أرجع انسخ_نص(المصدر);
}

// `<option> <value>` as the user typed the two arguments.
عرف نص_خيار_وقيمة(الخيار: &نص, القيمة: &نص): نص {
    ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
    ليكن الفاصل: نص = « »;
    ليكن أ: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, الخيار);
    ليكن ب: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, &الفاصل);
    ليكن ج: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, القيمة);
    أرجع نص_باني_النص(&الباني);
}

// A known option with a value it does not accept, named as written.
عرف تشخيصات_قيمة_خيار_غير_مقبولة(الخيار: نص): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.خيار_مترجم_غير_معروف(), اختياري.لا_شيء());
    ليكن أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الخيار);
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_واجهة_قيمة_خيار_غير_مقبولة());
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_مساعدة_قيمة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار(),
        بلا_حجج
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// A conflicting option named as written, with why it conflicts.
عرف تشخيصات_تعارض_واجهة(القيمة: نص, السبب: سبب_تشخيص): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.أوضاع_مترجم_متعارضة(), اختياري.لا_شيء());
    ليكن أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة);
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
        بلا_حجج
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_واجهة_بلا_قيمة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
        بلا_حجج
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Presentation controls are scanned before validation so even malformed CLI
// invocations can be rendered in the requested language/format. This is a
// deliberately narrow pre-scan, not a second command parser.
عرف استخرج_إعداد_عرض_مبكر(): إعداد_عرض_عملية {
    ليكن الإعداد: متغير إعداد_عرض_عملية = إعداد_عرض_عملية_افتراضي();
    ليكن العدد: طبيعي = عدد_الوسائط();
    ليكن بعد_التفسير: متغير منطقي = خطأ;
    // std.process counts argv[0], the program image; options start at 1.
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        طابق وسيطة(ف) مع
        | اختياري.لا_شيء -> { ف := ف + 1; }
        | اختياري.موجود(الحجة) -> {
            إذا (بعد_التفسير && !(((الطول(الحجة) مثل طبيعي) > 0) && الحجة[0] == 0x2D)) {
                // The source path after `run` ends compiler-option scanning.
                // Everything after it belongs to the interpreted program,
                // including values that look like SultanC options.
                ف := العدد;
            } وإلا إذا (حجة_تساوي(&الحجة, «run») || حجة_تساوي(&الحجة, «interpret»)) {
                // Options between `run` and its source are compiler options.
                بعد_التفسير := صواب;
                ف := ف + 1;
            } وإلا إذا (حجة_تساوي(&الحجة, «--lang») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق لغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                    | نتيجة_لغة_واجهة.غير_صالحة -> { الإعداد.اللغة := اختيار_لغة_تشخيص_عملية.الإنجليزية(); };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا إذا ((الطول(الحجة) مثل طبيعي) > 7 && يطابق_عند(&الحجة, 0, &«--lang=»)) {
                ليكن القيمة: نص = ذيل_حجة_من(&الحجة, 7);
                طابق لغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                // A language the compiler cannot speak is reported in English.
                | نتيجة_لغة_واجهة.غير_صالحة -> { الإعداد.اللغة := اختيار_لغة_تشخيص_عملية.الإنجليزية(); };
                ف := ف + 1;
            } وإلا إذا (حجة_تساوي(&الحجة, «--diagnostic-format») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق صيغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                    | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا إذا ((الطول(الحجة) مثل طبيعي) > 20 && يطابق_عند(&الحجة, 0, &«--diagnostic-format=»)) {
                ليكن القيمة: نص = ذيل_حجة_من(&الحجة, 20);
                طابق صيغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا إذا (حجة_تساوي(&الحجة, «--color») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق لون_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                    | نتيجة_لون_واجهة.غير_صالحة -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا إذا ((الطول(الحجة) مثل طبيعي) > 8 && يطابق_عند(&الحجة, 0, &«--color=»)) {
                ليكن القيمة: نص = ذيل_حجة_من(&الحجة, 8);
                طابق لون_واجهة_من_نص(&القيمة) مع
                | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                | نتيجة_لون_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا {
                ف := ف + 1;
            };
        };
    }
    أرجع الإعداد;
}

// Default product name: the source stem plus the suffix the target's object
// format conventionally uses for this output kind. WebAssembly executables
// and modules are `.wasm` (relocatable objects stay `.o`); COFF/PE uses
// `.exe`, `.dll` and `.obj`; ELF and Mach-O executables carry no suffix, and
// objects use `.o`. Without an explicit target (the host) and a source that
// is not `*.sn`, an executable is named `<source>.out`.
عرف ابن_مسار_إخراج_افتراضي(
    المصدر: &نص, النوع: نوع_مخرج_تجميع_عملية, الصيغة: اختياري صيغة_كائن_هدف
): نص {
    ليكن القيمة: نص = *المصدر;
    ليكن العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    ليكن نهاية_الجذر: متغير طبيعي = العدد;
    ليكن له_لاحقة_سن: متغير منطقي = خطأ;
    إذا (العدد >= 3) {
        ليكن موضع_النقطة: طبيعي = العدد - 3;
        ليكن موضع_سين: طبيعي = العدد - 2;
        ليكن موضع_نون: طبيعي = العدد - 1;
        له_لاحقة_سن := القيمة[موضع_النقطة] == 0x2E
            && القيمة[موضع_سين] == 0x73
            && القيمة[موضع_نون] == 0x6E;
    };
    إذا (له_لاحقة_سن) {
        نهاية_الجذر := العدد - 3;
    };
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < نهاية_الجذر) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    ليكن كائن: منطقي = النوع == نوع_مخرج_تجميع_عملية.كائن()
        || النوع == نوع_مخرج_تجميع_عملية.كائن_مترابط();
    ليكن اللاحقة: متغير نص = «»;
    ليكن ويب: متغير منطقي = خطأ;
    ليكن كوف: متغير منطقي = خطأ;
    ليكن ماتشو: متغير منطقي = خطأ;
    طابق الصيغة مع
    | اختياري.موجود(الصيغة_المحددة) -> {
        ويب := الصيغة_المحددة == صيغة_كائن_هدف.ويب_أسمبلي();
        كوف := الصيغة_المحددة == صيغة_كائن_هدف.كوف();
        ماتشو := الصيغة_المحددة == صيغة_كائن_هدف.ماتشو();
    }
    | اختياري.لا_شيء -> { };
    // Text outputs name their content on every format:
    // assembly .s, LLVM IR .ll.
    إذا (النوع == نوع_مخرج_تجميع_عملية.نص_تجميع()) {
        اللاحقة := «.s»;
    } وإلا إذا (النوع == نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم()) {
        اللاحقة := «.ll»;
    } وإلا إذا (ويب) {
        إذا (كائن) { اللاحقة := «.o»; } وإلا { اللاحقة := «.wasm»; };
    } وإلا إذا (كوف) {
        إذا (كائن || النوع == نوع_مخرج_تجميع_عملية.وحدة_هدف()) {
            اللاحقة := «.obj»;
        } وإلا إذا (النوع == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة()) {
            اللاحقة := «.dll»;
        } وإلا {
            اللاحقة := «.exe»;
        };
    } وإلا {
        إذا (كائن || النوع == نوع_مخرج_تجميع_عملية.وحدة_هدف()) {
            اللاحقة := «.o»;
        } وإلا إذا (النوع == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة()) {
            إذا (ماتشو) { اللاحقة := «.dylib»; } وإلا { اللاحقة := «.so»; };
        } وإلا إذا (!له_لاحقة_سن) {
            اللاحقة := «.out»;
        };
    };
    ف := 0;
    طالما (ف < (الطول(اللاحقة) مثل طبيعي)) {
        ألحق(البايتات, اللاحقة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف بايتات_وسيط_برنامج_من_حجة(الحجة: &نص): متجه ط8 {
    ليكن القيمة: نص = *الحجة;
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أمر_من_موضعي(القيمة: &نص): اختياري أمر_واجهة_مترجم {
    إذا (حجة_تساوي(القيمة, «check»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تحقق()); };
    إذا (حجة_تساوي(القيمة, «run»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تفسير()); };
    // Hidden compatibility alias; primary help advertises only `run`.
    إذا (حجة_تساوي(القيمة, «interpret»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تفسير()); };
    إذا (حجة_تساوي(القيمة, «help»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.مساعدة()); };
    إذا (حجة_تساوي(القيمة, «version»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.إصدار()); };
    إذا (حجة_تساوي(القيمة, «targets»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.أهداف()); };
    إذا (حجة_تساوي(القيمة, «explain»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.شرح()); };
    إذا (حجة_تساوي(القيمة, «fmt»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تنسيق()); };
    إذا (حجة_تساوي(القيمة, «test»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.اختبار()); };
    أرجع اختياري.لا_شيء();
}

// A positive decimal count (digits, `_` separators allowed:
// driver_model.sn عدد_موجب_بفواصل); 0 when the text is not one.
عرف ميزانية_من_نص_واجهة(النص: &نص): طبيعي {
    طابق عدد_موجب_بفواصل(النص) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عام عرف حلل_استدعاء_المترجم(): نتيجة_تحليل_استدعاء_مترجم {
    ليكن الإعداد: متغير إعداد_عرض_عملية = استخرج_إعداد_عرض_مبكر();
    ليكن عدد_الحجج: طبيعي = عدد_الوسائط();
    ليكن الأمر: متغير أمر_واجهة_مترجم = أمر_واجهة_مترجم.تجميع();
    ليكن وجد_أمر: متغير منطقي = خطأ;
    ليكن مسار_المصدر: متغير نص = «»;
    ليكن وجد_مصدر: متغير منطقي = خطأ;
    ليكن مسار_الإخراج: متغير نص = «»;
    ليكن وجد_إخراج: متغير منطقي = خطأ;
    ليكن تهجئة_الهدف: متغير نص = «»;
    ليكن وجد_هدف: متغير منطقي = خطأ;
    ليكن اختيار_مزود_الخلفية: متغير اختيار_مزود_خلفية_عملية = اختيار_مزود_خلفية_عملية.تلقائي();
    // -O0 .. -O3 (and --opt-level=N); the last one given counts. Without
    // one a build is not optimized (as with -O0), while `run` optimizes as
    // with -O2: a program run directly is run for its speed.
    ليكن مستوى_التحسين: متغير مستوى_تحسين_مزود_إل_إل_في_إم = مستوى_تحسين_مزود_إل_إل_في_إم.بلا();
    ليكن حدد_التحسين: متغير منطقي = خطأ;
    ليكن وجد_مزود_خلفية: متغير منطقي = خطأ;
    ليكن نوع_المخرج: متغير نوع_مخرج_تجميع_عملية = نوع_مخرج_تجميع_عملية.تنفيذي();
    ليكن وجد_نوع_مخرج: متغير منطقي = خطأ;
    ليكن كود_الشرح: متغير نص = «»;
    ليكن وجد_شرح: متغير منطقي = خطأ;
    ليكن بعد_أمر_التفسير: متغير منطقي = خطأ;
    ليكن وسائط_التفسير: متغير متجه متجه ط8 = [];
    ليكن فاصل_الوسائط_مستهلك: متغير منطقي = خطأ;
    ليكن مسارات_مدخلات_الربط: متغير متجه نص = [];
    ليكن أسماء_مكتبات_الربط: متغير متجه نص = [];
    ليكن أدلة_مكتبات_الربط: متغير متجه نص = [];
    // The first -l/-L as written: only a linked output (an executable or a
    // shared library) uses them, so anything else rejects them by name.
    ليكن أول_خيار_ربط: متغير نص = «»;
    ليكن روابط_مصادر_الوحدات: متغير متجه ربط_مصدر_وحدة_عملية = [];
    // The first output, backend or target option as written, for conflicts
    // found after every option is read.
    ليكن أول_خيار_بناء: متغير نص = «»;
    ليكن حجة_الهدف: متغير نص = «»;
    // `fmt`: its paths (`-` is standard input) and --check.
    ليكن مسارات_التنسيق: متغير متجه نص = [];
    ليكن فحص_التنسيق: متغير منطقي = خطأ;
    // `test`: --filter <text> and --list, the first of them as written.
    ليكن مرشح_الاختبار: متغير نص = «»;
    // --test and --tests-in, in order, each repeatable.
    ليكن أسماء_الاختبارات: متغير متجه نص = [];
    ليكن ملفات_الاختبارات: متغير متجه نص = [];
    ليكن قائمة_الاختبارات: متغير منطقي = خطأ;
    ليكن تفسير_الاختبارات: متغير منطقي = خطأ;
    ليكن فهرس_الاختبار: متغير اختياري طبيعي = اختياري.لا_شيء();
    // --no-run: the test program is written to -o and not run.
    ليكن منع_تشغيل_الاختبارات: متغير منطقي = خطأ;
    ليكن أول_خيار_اختبار: متغير نص = «»;

    // std.process counts argv[0], the program image; options start at 1.
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < عدد_الحجج) {
        ليكن الحجة: نص;
        طابق وسيطة(ف) مع
        | اختياري.لا_شيء -> {
            ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.استدعاء_مترجم_غير_صالح()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختياري.موجود(القيمة) -> { الحجة := القيمة; };

        // Once `run` is selected, the next non-option token is the source and
        // every token after that is guest argv. Do not interpret guest values as compiler flags.
        // Options between `run` and its source are still compiler options.
        ليكن حجة_خيار: منطقي = ((الطول(الحجة) مثل طبيعي) > 0) && الحجة[0] == 0x2D;
        إذا (بعد_أمر_التفسير && (وجد_مصدر || !حجة_خيار)) {
            إذا (!وجد_مصدر) {
                مسار_المصدر := الحجة;
                وجد_مصدر := صواب;
            } وإلا إذا (!فاصل_الوسائط_مستهلك && الطول(وسائط_التفسير) == 0 && حجة_تساوي(&الحجة, «--»)) {
                // `run file.sn -- args`: the first `--` after the source only
                // separates the program's arguments; it is not one of them.
                فاصل_الوسائط_مستهلك := صواب;
            } وإلا {
                ليكن بايتات_الوسيط: متجه ط8 = بايتات_وسيط_برنامج_من_حجة(&الحجة);
                ألحق(وسائط_التفسير, بايتات_الوسيط);
            };
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «--help»)) {
            إذا (وجد_أمر) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            الأمر := أمر_واجهة_مترجم.مساعدة();
            وجد_أمر := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «--version»)) {
            إذا (وجد_أمر) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            الأمر := أمر_واجهة_مترجم.إصدار();
            وجد_أمر := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «--explain»)) {
            إذا (وجد_أمر || وجد_شرح) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            إذا (ف + 1 >= عدد_الحجج) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            طابق وسيطة(ف + 1) مع
            | اختياري.لا_شيء -> {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | اختياري.موجود(القيمة) -> { كود_الشرح := القيمة; };
            الأمر := أمر_واجهة_مترجم.شرح();
            وجد_أمر := صواب;
            وجد_شرح := صواب;
            ف := ف + 2;
        } وإلا إذا ((الطول(الحجة) مثل طبيعي) > 10 && يطابق_عند(&الحجة, 0, &«--explain=»)) {
            إذا (وجد_أمر || وجد_شرح) {
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            كود_الشرح := ذيل_حجة_من(&الحجة, 10);
            الأمر := أمر_واجهة_مترجم.شرح();
            وجد_أمر := صواب;
            وجد_شرح := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «-O0») || حجة_تساوي(&الحجة, «--opt-level=0»)) {
            مستوى_التحسين := مستوى_تحسين_مزود_إل_إل_في_إم.بلا();
            حدد_التحسين := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «-O1») || حجة_تساوي(&الحجة, «--opt-level=1»)) {
            مستوى_التحسين := مستوى_تحسين_مزود_إل_إل_في_إم.منخفض();
            حدد_التحسين := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «-O2») || حجة_تساوي(&الحجة, «--opt-level=2»)) {
            مستوى_التحسين := مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي();
            حدد_التحسين := صواب;
            ف := ف + 1;
        } وإلا إذا (حجة_تساوي(&الحجة, «-O3») || حجة_تساوي(&الحجة, «--opt-level=3»)) {
            مستوى_التحسين := مستوى_تحسين_مزود_إل_إل_في_إم.عال();
            حدد_التحسين := صواب;
            ف := ف + 1;
        } وإلا إذا ((الطول(الحجة) مثل طبيعي) > 18 && يطابق_عند(&الحجة, 0, &«--comptime-budget=»)) {
            ليكن القيمة: نص = ذيل_حجة_من(&الحجة, 18);
            ليكن الميزانية: طبيعي = ميزانية_من_نص_واجهة(&القيمة);
            إذا (الميزانية == 0) {
                // A value was given; it is not a positive number.
                ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_قيمة_خيار_غير_مقبولة(انسخ_نص(&الحجة));
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            الإعداد.ميزانية_وقت_الترجمة := الميزانية;
            ف := ف + 1;
