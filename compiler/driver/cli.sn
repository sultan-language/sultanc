استورد compiler.driver.driver_model;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_spelling;
استورد std.process.argument_count;
استورد std.process.argument;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.schema;

// CLI owns external command syntax only. Target spelling belongs to Target;
// orchestration belongs to Driver; diagnostics remain structured.

نوع أمر_واجهة_مترجم =
    | تجميع
    | تحقق
    | تفسير
    | مساعدة
    | إصدار
    | أهداف
    | شرح
;

نوع نتيجة_لغة_واجهة =
    | صالحة بنوع اختيار_لغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مخرج_واجهة =
    | صالح بنوع نوع_مخرج_تجميع_عملية
    | غير_صالح
;

نوع نتيجة_صيغة_واجهة =
    | صالحة بنوع صيغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_لون_واجهة =
    | صالحة بنوع سياسة_لون_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مزود_خلفية_واجهة =
    | صالحة بنوع هوية_مزود_خلفية
    | غير_صالحة
;

عرف حجة_تساوي(الحجة: &نص, المطلوب: نص): منطقي {
    دع القيمة: نص = المطلوب;
    أرجع نصان_متساويان(الحجة, &القيمة);
}

عرف ذيل_حجة_من(الحجة: &نص, البداية: غير_موقع): نص {
    دع القيمة: نص = *الحجة;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    بينما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف لغة_واجهة_من_نص(القيمة: &نص): نتيجة_لغة_واجهة {
    لو (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.تلقائي());
    };
    لو (حجة_تساوي(القيمة, «ar»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.العربية());
    };
    لو (حجة_تساوي(القيمة, «en»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.الإنجليزية());
    };
    أرجع نتيجة_لغة_واجهة.غير_صالحة();
}

عرف مخرج_واجهة_من_نص(القيمة: &نص): نتيجة_مخرج_واجهة {
    لو (حجة_تساوي(القيمة, «exe»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.تنفيذي());
    };
    لو (حجة_تساوي(القيمة, «obj»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن());
    };
    لو (حجة_تساوي(القيمة, «shared»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.مكتبة_مشتركة());
    };
    لو (حجة_تساوي(القيمة, «reloc»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن_مترابط());
    };
    لو (حجة_تساوي(القيمة, «module»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.وحدة_هدف());
    };
    أرجع نتيجة_مخرج_واجهة.غير_صالح();
}

عرف صيغة_واجهة_من_نص(القيمة: &نص): نتيجة_صيغة_واجهة {
    لو (حجة_تساوي(القيمة, «human»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.طرفي());
    };
    لو (حجة_تساوي(القيمة, «short»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.مختصر());
    };
    لو (حجة_تساوي(القيمة, «json»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.جيسون());
    };
    أرجع نتيجة_صيغة_واجهة.غير_صالحة();
}

عرف لون_واجهة_من_نص(القيمة: &نص): نتيجة_لون_واجهة {
    لو (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.تلقائي());
    };
    لو (حجة_تساوي(القيمة, «always»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.دائما());
    };
    لو (حجة_تساوي(القيمة, «never»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.أبدا());
    };
    أرجع نتيجة_لون_واجهة.غير_صالحة();
}

عرف مزود_خلفية_واجهة_من_نص(القيمة: &نص): نتيجة_مزود_خلفية_واجهة {
    لو (حجة_تساوي(القيمة, «native»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.أصلي());
    };
    لو (حجة_تساوي(القيمة, «llvm»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.إل_إل_في_إم());
    };
    أرجع نتيجة_مزود_خلفية_واجهة.غير_صالحة();
}

عرف تشخيصات_واجهة_بقيمة(
    المعرف: معرف_تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص,
    مساعدة_الأهداف: منطقي,
    مساعدة_القيمة: منطقي
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختيار.لا_شيء());
    دع أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, المفتاح, القيمة);
    دع بلا_حجج: متجه حجة_تشخيص = [];
    لو (مساعدة_الأهداف) {
        دع أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
            بلا_حجج
        );
    } وإلا لو (مساعدة_القيمة) {
        دع أضف_مساعدة_قيمة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار(),
            بلا_حجج
        );
    } وإلا {
        دع أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
            بلا_حجج
        );
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_واجهة_بلا_قيمة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختيار.لا_شيء());
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Presentation controls are scanned before validation so even malformed CLI
// invocations can be rendered in the requested language/format. This is a
// deliberately narrow pre-scan, not a second command parser.
عرف استخرج_إعداد_عرض_مبكر(): إعداد_عرض_عملية {
    دع الإعداد: متغير إعداد_عرض_عملية = إعداد_عرض_عملية_افتراضي();
    دع العدد: غير_موقع = عدد_الوسائط();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        طابق وسيطة(ف) مع
        | اختيار.لا_شيء -> { ف := ف + 1; }
        | اختيار.بعض(الحجة) -> {
            لو (حجة_تساوي(&الحجة, «run») || حجة_تساوي(&الحجة, «interpret»)) {
                // `run` terminates compiler-option scanning. Everything after the
                // source path belongs to the interpreted program, including values
                // that look like SultanC options.
                ف := العدد;
            } وإلا لو (حجة_تساوي(&الحجة, «--lang») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختيار.بعض(القيمة) -> {
                    طابق لغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                    | نتيجة_لغة_واجهة.غير_صالحة -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل غير_موقع) > 7 && يطابق_عند(&الحجة, 0, «--lang=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 7);
                طابق لغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                | نتيجة_لغة_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا لو (حجة_تساوي(&الحجة, «--diagnostic-format») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختيار.بعض(القيمة) -> {
                    طابق صيغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                    | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل غير_موقع) > 20 && يطابق_عند(&الحجة, 0, «--diagnostic-format=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 20);
                طابق صيغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا لو (حجة_تساوي(&الحجة, «--color») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختيار.بعض(القيمة) -> {
                    طابق لون_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                    | نتيجة_لون_واجهة.غير_صالحة -> { };
                }
                | اختيار.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل غير_موقع) > 8 && يطابق_عند(&الحجة, 0, «--color=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 8);
                طابق لون_واجهة_من_نص(&القيمة) مع
                | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                | نتيجة_لون_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا {
                ف := ف + 1;
            };
        };
    }
    أرجع الإعداد;
}

عرف ابن_مسار_إخراج_افتراضي(المصدر: &نص, كائن: منطقي): نص {
    دع القيمة: نص = *المصدر;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع نهاية_الجذر: متغير غير_موقع = العدد;
    دع له_لاحقة_سن: متغير منطقي = خطأ;
    لو (العدد >= 3) {
        دع موضع_النقطة: غير_موقع = العدد - 3;
        دع موضع_سين: غير_موقع = العدد - 2;
        دع موضع_نون: غير_موقع = العدد - 1;
        له_لاحقة_سن := القيمة[موضع_النقطة] == 0x2E
            && القيمة[موضع_سين] == 0x73
            && القيمة[موضع_نون] == 0x6E;
    };
    لو (له_لاحقة_سن) {
        نهاية_الجذر := العدد - 3;
    };
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < نهاية_الجذر) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    لو (كائن) {
        ألحق(البايتات, 0x2E);
        ألحق(البايتات, 0x6F);
    } وإلا لو (!له_لاحقة_سن) {
        ألحق(البايتات, 0x2E);
        ألحق(البايتات, 0x6F);
        ألحق(البايتات, 0x75);
        ألحق(البايتات, 0x74);
    };
    أرجع من_بايتات(&البايتات);
}

عرف بايتات_وسيط_برنامج_من_حجة(الحجة: &نص): متجه غ8 {
    دع القيمة: نص = *الحجة;
    دع الناتج: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أمر_من_موضعي(القيمة: &نص): اختيار أمر_واجهة_مترجم {
    لو (حجة_تساوي(القيمة, «check»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.تحقق()); };
    لو (حجة_تساوي(القيمة, «run»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.تفسير()); };
    // Hidden compatibility alias; primary help advertises only `run`.
    لو (حجة_تساوي(القيمة, «interpret»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.تفسير()); };
    لو (حجة_تساوي(القيمة, «help»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.مساعدة()); };
    لو (حجة_تساوي(القيمة, «version»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.إصدار()); };
    لو (حجة_تساوي(القيمة, «targets»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.أهداف()); };
    لو (حجة_تساوي(القيمة, «explain»)) { أرجع اختيار.بعض(أمر_واجهة_مترجم.شرح()); };
    أرجع اختيار.لا_شيء();
}

عام عرف حلل_استدعاء_المترجم(): نتيجة_تحليل_استدعاء_مترجم {
    دع الإعداد: متغير إعداد_عرض_عملية = استخرج_إعداد_عرض_مبكر();
    دع عدد_الحجج: غير_موقع = عدد_الوسائط();
    دع الأمر: متغير أمر_واجهة_مترجم = أمر_واجهة_مترجم.تجميع();
    دع وجد_أمر: متغير منطقي = خطأ;
    دع مسار_المصدر: متغير نص = «»;
    دع وجد_مصدر: متغير منطقي = خطأ;
    دع مسار_الإخراج: متغير نص = «»;
    دع وجد_إخراج: متغير منطقي = خطأ;
    دع تهجئة_الهدف: متغير نص = «»;
    دع وجد_هدف: متغير منطقي = خطأ;
    دع اختيار_مزود_الخلفية: متغير اختيار_مزود_خلفية_عملية = اختيار_مزود_خلفية_عملية.تلقائي();
    دع وجد_مزود_خلفية: متغير منطقي = خطأ;
    دع نوع_المخرج: متغير نوع_مخرج_تجميع_عملية = نوع_مخرج_تجميع_عملية.تنفيذي();
    دع وجد_نوع_مخرج: متغير منطقي = خطأ;
    دع كود_الشرح: متغير نص = «»;
    دع وجد_شرح: متغير منطقي = خطأ;
    دع بعد_أمر_التفسير: متغير منطقي = خطأ;
    دع وسائط_التفسير: متغير متجه متجه غ8 = [];
    دع مسارات_مدخلات_الربط: متغير متجه نص = [];

    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الحجج) {
        دع الحجة: نص;
        طابق وسيطة(ف) مع
        | اختيار.لا_شيء -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.استدعاء_مترجم_غير_صالح()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختيار.بعض(القيمة) -> { الحجة := القيمة; };

        // Once `run` is selected, the next token is the source and every token
        // after that is guest argv. Do not interpret guest values as compiler flags.
        لو (بعد_أمر_التفسير) {
            لو (!وجد_مصدر) {
                مسار_المصدر := الحجة;
                وجد_مصدر := صواب;
            } وإلا {
                دع بايتات_الوسيط: متجه غ8 = بايتات_وسيط_برنامج_من_حجة(&الحجة);
