// CLI owns external command syntax only. Target spelling belongs to Target;
// orchestration belongs to Driver; diagnostics remain structured.

نوع أمر_واجهة_مترجم =
    | تجميع
    | تحقق
    | تفسير
    | مساعدة
    | إصدار
    | أهداف
    | شرح
;

نوع نتيجة_لغة_واجهة =
    | صالحة بنوع اختيار_لغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مخرج_واجهة =
    | صالح بنوع نوع_مخرج_تجميع_عملية
    | غير_صالح
;

نوع نتيجة_صيغة_واجهة =
    | صالحة بنوع صيغة_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_لون_واجهة =
    | صالحة بنوع سياسة_لون_تشخيص_عملية
    | غير_صالحة
;

نوع نتيجة_مزود_خلفية_واجهة =
    | صالحة بنوع هوية_مزود_خلفية
    | غير_صالحة
;

عرف حجة_تساوي(الحجة: &نص, المطلوب: نص): منطقي {
    دع القيمة: نص = المطلوب;
    أرجع نصان_متساويان(الحجة, &القيمة);
}

عرف ذيل_حجة_من(الحجة: &نص, البداية: طبيعي): نص {
    دع القيمة: نص = *الحجة;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// Splits a --module-source value `<module>=<file>` at its first '='. Both
// parts must be non-empty; the module part is a dotted logical module path as
// written in an import (validated by the canonical resolver, not here).
عرف ربط_مصدر_وحدة_من_نص(القيمة: &نص): اختياري ربط_مصدر_وحدة_عملية {
    دع الأصل: نص = *القيمة;
    دع العدد: طبيعي = الطول(الأصل) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && الأصل[ف] != 0x3D) {
        ف := ف + 1;
    }
    لو (ف == 0 || ف + 1 >= العدد) {
        أرجع اختياري.لا_شيء();
    };
    دع بايتات_الوحدة: متغير متجه ط8 = [];
    دع م: متغير طبيعي = 0;
    طالما (م < ف) {
        ألحق(بايتات_الوحدة, الأصل[م]);
        م := م + 1;
    }
    دع الوحدة: نص = من_بايتات(&بايتات_الوحدة);
    دع المصدر: نص = ذيل_حجة_من(القيمة, ف + 1);
    دع الربط: ربط_مصدر_وحدة_عملية = {
        الوحدة: الوحدة,
        المصدر: المصدر
    };
    أرجع اختياري.موجود(الربط);
}

عرف لغة_واجهة_من_نص(القيمة: &نص): نتيجة_لغة_واجهة {
    لو (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.تلقائي());
    };
    لو (حجة_تساوي(القيمة, «ar»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.العربية());
    };
    لو (حجة_تساوي(القيمة, «en»)) {
        أرجع نتيجة_لغة_واجهة.صالحة(اختيار_لغة_تشخيص_عملية.الإنجليزية());
    };
    أرجع نتيجة_لغة_واجهة.غير_صالحة();
}

عرف مخرج_واجهة_من_نص(القيمة: &نص): نتيجة_مخرج_واجهة {
    لو (حجة_تساوي(القيمة, «exe»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.تنفيذي());
    };
    لو (حجة_تساوي(القيمة, «obj»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن());
    };
    لو (حجة_تساوي(القيمة, «shared»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.مكتبة_مشتركة());
    };
    لو (حجة_تساوي(القيمة, «reloc»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.كائن_مترابط());
    };
    لو (حجة_تساوي(القيمة, «module»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.وحدة_هدف());
    };
    لو (حجة_تساوي(القيمة, «asm»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.نص_تجميع());
    };
    لو (حجة_تساوي(القيمة, «llvm-ir»)) {
        أرجع نتيجة_مخرج_واجهة.صالح(نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم());
    };
    أرجع نتيجة_مخرج_واجهة.غير_صالح();
}

عرف صيغة_واجهة_من_نص(القيمة: &نص): نتيجة_صيغة_واجهة {
    لو (حجة_تساوي(القيمة, «human»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.طرفي());
    };
    لو (حجة_تساوي(القيمة, «short»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.مختصر());
    };
    لو (حجة_تساوي(القيمة, «json»)) {
        أرجع نتيجة_صيغة_واجهة.صالحة(صيغة_تشخيص_عملية.جيسون());
    };
    أرجع نتيجة_صيغة_واجهة.غير_صالحة();
}

عرف لون_واجهة_من_نص(القيمة: &نص): نتيجة_لون_واجهة {
    لو (حجة_تساوي(القيمة, «auto»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.تلقائي());
    };
    لو (حجة_تساوي(القيمة, «always»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.دائما());
    };
    لو (حجة_تساوي(القيمة, «never»)) {
        أرجع نتيجة_لون_واجهة.صالحة(سياسة_لون_تشخيص_عملية.أبدا());
    };
    أرجع نتيجة_لون_واجهة.غير_صالحة();
}

عرف مزود_خلفية_واجهة_من_نص(القيمة: &نص): نتيجة_مزود_خلفية_واجهة {
    لو (حجة_تساوي(القيمة, «native»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.أصلي());
    };
    لو (حجة_تساوي(القيمة, «llvm»)) {
        أرجع نتيجة_مزود_خلفية_واجهة.صالحة(هوية_مزود_خلفية.إل_إل_في_إم());
    };
    أرجع نتيجة_مزود_خلفية_واجهة.غير_صالحة();
}

عام عرف تشخيصات_واجهة_بقيمة(
    المعرف: معرف_تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص,
    مساعدة_الأهداف: منطقي,
    مساعدة_القيمة: منطقي
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    دع أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, المفتاح, القيمة);
    دع بلا_حجج: متجه حجة_تشخيص = [];
    لو (مساعدة_الأهداف) {
        دع أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
            بلا_حجج
        );
    } وإلا لو (مساعدة_القيمة) {
        دع أضف_مساعدة_قيمة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار(),
            بلا_حجج
        );
    } وإلا {
        دع أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
            بلا_حجج
        );
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// The first argument a command does not accept: an output, backend or target
// option, else the source path. Empty when none was recorded.
عرف أول_خيار_لا_يناسب_الأمر(البناء: &نص, الهدف: &نص, المصدر: &نص): نص {
    لو ((الطول(*البناء) مثل طبيعي) > 0) { أرجع انسخ_نص(البناء); };
    لو ((الطول(*الهدف) مثل طبيعي) > 0) { أرجع انسخ_نص(الهدف); };
    أرجع انسخ_نص(المصدر);
}

// `<option> <value>` as the user typed the two arguments.
عرف نص_خيار_وقيمة(الخيار: &نص, القيمة: &نص): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    دع الفاصل: نص = « »;
    دع أ: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, الخيار);
    دع ب: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, &الفاصل);
    دع ج: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, القيمة);
    أرجع نص_باني_النص(&الباني);
}

// A known option with a value it does not accept, named as written.
عرف تشخيصات_قيمة_خيار_غير_مقبولة(الخيار: نص): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.خيار_مترجم_غير_معروف(), اختياري.لا_شيء());
    دع أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الخيار);
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_واجهة_قيمة_خيار_غير_مقبولة());
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_قيمة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// A conflicting option named as written, with why it conflicts.
عرف تشخيصات_تعارض_واجهة(القيمة: نص, السبب: سبب_تشخيص): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.أوضاع_مترجم_متعارضة(), اختياري.لا_شيء());
    دع أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة);
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_واجهة_بلا_قيمة(المعرف: معرف_تشخيص): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_عامة: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Presentation controls are scanned before validation so even malformed CLI
// invocations can be rendered in the requested language/format. This is a
// deliberately narrow pre-scan, not a second command parser.
عرف استخرج_إعداد_عرض_مبكر(): إعداد_عرض_عملية {
    دع الإعداد: متغير إعداد_عرض_عملية = إعداد_عرض_عملية_افتراضي();
    دع العدد: طبيعي = عدد_الوسائط();
    دع بعد_التفسير: متغير منطقي = خطأ;
    // std.process counts argv[0], the program image; options start at 1.
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        طابق وسيطة(ف) مع
        | اختياري.لا_شيء -> { ف := ف + 1; }
        | اختياري.موجود(الحجة) -> {
            لو (بعد_التفسير && !(((الطول(الحجة) مثل طبيعي) > 0) && الحجة[0] == 0x2D)) {
                // The source path after `run` ends compiler-option scanning.
                // Everything after it belongs to the interpreted program,
                // including values that look like SultanC options.
                ف := العدد;
            } وإلا لو (حجة_تساوي(&الحجة, «run») || حجة_تساوي(&الحجة, «interpret»)) {
                // Options between `run` and its source are compiler options.
                بعد_التفسير := صواب;
                ف := ف + 1;
            } وإلا لو (حجة_تساوي(&الحجة, «--lang») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق لغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                    | نتيجة_لغة_واجهة.غير_صالحة -> { الإعداد.اللغة := اختيار_لغة_تشخيص_عملية.الإنجليزية(); };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل طبيعي) > 7 && يطابق_عند(&الحجة, 0, «--lang=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 7);
                طابق لغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_لغة_واجهة.صالحة(اللغة) -> { الإعداد.اللغة := اللغة; }
                // A language the compiler cannot speak is reported in English.
                | نتيجة_لغة_واجهة.غير_صالحة -> { الإعداد.اللغة := اختيار_لغة_تشخيص_عملية.الإنجليزية(); };
                ف := ف + 1;
            } وإلا لو (حجة_تساوي(&الحجة, «--diagnostic-format») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق صيغة_واجهة_من_نص(&القيمة) مع
                    | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                    | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل طبيعي) > 20 && يطابق_عند(&الحجة, 0, «--diagnostic-format=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 20);
                طابق صيغة_واجهة_من_نص(&القيمة) مع
                | نتيجة_صيغة_واجهة.صالحة(الصيغة) -> { الإعداد.الصيغة := الصيغة; }
                | نتيجة_صيغة_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا لو (حجة_تساوي(&الحجة, «--color») && (ف + 1 < العدد)) {
                طابق وسيطة(ف + 1) مع
                | اختياري.موجود(القيمة) -> {
                    طابق لون_واجهة_من_نص(&القيمة) مع
                    | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                    | نتيجة_لون_واجهة.غير_صالحة -> { };
                }
                | اختياري.لا_شيء -> { };
                ف := ف + 2;
            } وإلا لو ((الطول(الحجة) مثل طبيعي) > 8 && يطابق_عند(&الحجة, 0, «--color=»)) {
                دع القيمة: نص = ذيل_حجة_من(&الحجة, 8);
                طابق لون_واجهة_من_نص(&القيمة) مع
                | نتيجة_لون_واجهة.صالحة(اللون) -> { الإعداد.اللون := اللون; }
                | نتيجة_لون_واجهة.غير_صالحة -> { };
                ف := ف + 1;
            } وإلا {
                ف := ف + 1;
            };
        };
    }
    أرجع الإعداد;
}

// Default product name: the source stem plus the suffix the target's object
// format conventionally uses for this output kind. WebAssembly executables
// and modules are `.wasm` (relocatable objects stay `.o`); COFF/PE uses
// `.exe`, `.dll` and `.obj`; ELF and Mach-O executables carry no suffix, and
// objects use `.o`. Without an explicit target (the host) and a source that
// is not `*.sn`, an executable is named `<source>.out`.
عرف ابن_مسار_إخراج_افتراضي(
    المصدر: &نص, النوع: نوع_مخرج_تجميع_عملية, الصيغة: اختياري صيغة_كائن_هدف
): نص {
    دع القيمة: نص = *المصدر;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع نهاية_الجذر: متغير طبيعي = العدد;
    دع له_لاحقة_سن: متغير منطقي = خطأ;
    لو (العدد >= 3) {
        دع موضع_النقطة: طبيعي = العدد - 3;
        دع موضع_سين: طبيعي = العدد - 2;
        دع موضع_نون: طبيعي = العدد - 1;
        له_لاحقة_سن := القيمة[موضع_النقطة] == 0x2E
            && القيمة[موضع_سين] == 0x73
            && القيمة[موضع_نون] == 0x6E;
    };
    لو (له_لاحقة_سن) {
        نهاية_الجذر := العدد - 3;
    };
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < نهاية_الجذر) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    دع كائن: منطقي = النوع == نوع_مخرج_تجميع_عملية.كائن()
        || النوع == نوع_مخرج_تجميع_عملية.كائن_مترابط();
    دع اللاحقة: متغير نص = «»;
    دع ويب: متغير منطقي = خطأ;
    دع كوف: متغير منطقي = خطأ;
    طابق الصيغة مع
    | اختياري.موجود(الصيغة_المحددة) -> {
        ويب := الصيغة_المحددة == صيغة_كائن_هدف.ويب_أسمبلي();
        كوف := الصيغة_المحددة == صيغة_كائن_هدف.كوف();
    }
    | اختياري.لا_شيء -> { };
    لو (ويب) {
        لو (كائن) { اللاحقة := «.o»; } وإلا { اللاحقة := «.wasm»; };
    } وإلا لو (كوف) {
        لو (كائن || النوع == نوع_مخرج_تجميع_عملية.وحدة_هدف()) {
            اللاحقة := «.obj»;
        } وإلا لو (النوع == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة()) {
            اللاحقة := «.dll»;
        } وإلا {
            اللاحقة := «.exe»;
        };
    } وإلا {
        لو (كائن || النوع == نوع_مخرج_تجميع_عملية.وحدة_هدف()) {
            اللاحقة := «.o»;
        } وإلا لو (النوع == نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم()) {
            اللاحقة := «.ll»;
        } وإلا لو (!له_لاحقة_سن) {
            اللاحقة := «.out»;
        };
    };
    ف := 0;
    طالما (ف < (الطول(اللاحقة) مثل طبيعي)) {
        ألحق(البايتات, اللاحقة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف بايتات_وسيط_برنامج_من_حجة(الحجة: &نص): متجه ط8 {
    دع القيمة: نص = *الحجة;
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف أمر_من_موضعي(القيمة: &نص): اختياري أمر_واجهة_مترجم {
    لو (حجة_تساوي(القيمة, «check»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تحقق()); };
    لو (حجة_تساوي(القيمة, «run»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تفسير()); };
    // Hidden compatibility alias; primary help advertises only `run`.
    لو (حجة_تساوي(القيمة, «interpret»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.تفسير()); };
    لو (حجة_تساوي(القيمة, «help»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.مساعدة()); };
    لو (حجة_تساوي(القيمة, «version»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.إصدار()); };
    لو (حجة_تساوي(القيمة, «targets»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.أهداف()); };
    لو (حجة_تساوي(القيمة, «explain»)) { أرجع اختياري.موجود(أمر_واجهة_مترجم.شرح()); };
    أرجع اختياري.لا_شيء();
}

عام عرف حلل_استدعاء_المترجم(): نتيجة_تحليل_استدعاء_مترجم {
    دع الإعداد: متغير إعداد_عرض_عملية = استخرج_إعداد_عرض_مبكر();
    دع عدد_الحجج: طبيعي = عدد_الوسائط();
    دع الأمر: متغير أمر_واجهة_مترجم = أمر_واجهة_مترجم.تجميع();
    دع وجد_أمر: متغير منطقي = خطأ;
    دع مسار_المصدر: متغير نص = «»;
    دع وجد_مصدر: متغير منطقي = خطأ;
    دع مسار_الإخراج: متغير نص = «»;
    دع وجد_إخراج: متغير منطقي = خطأ;
    دع تهجئة_الهدف: متغير نص = «»;
    دع وجد_هدف: متغير منطقي = خطأ;
    دع اختيار_مزود_الخلفية: متغير اختيار_مزود_خلفية_عملية = اختيار_مزود_خلفية_عملية.تلقائي();
    دع وجد_مزود_خلفية: متغير منطقي = خطأ;
    دع نوع_المخرج: متغير نوع_مخرج_تجميع_عملية = نوع_مخرج_تجميع_عملية.تنفيذي();
    دع وجد_نوع_مخرج: متغير منطقي = خطأ;
    دع كود_الشرح: متغير نص = «»;
    دع وجد_شرح: متغير منطقي = خطأ;
    دع بعد_أمر_التفسير: متغير منطقي = خطأ;
    دع وسائط_التفسير: متغير متجه متجه ط8 = [];
    دع فاصل_الوسائط_مستهلك: متغير منطقي = خطأ;
    دع مسارات_مدخلات_الربط: متغير متجه نص = [];
    دع أسماء_مكتبات_الربط: متغير متجه نص = [];
    دع أدلة_مكتبات_الربط: متغير متجه نص = [];
    دع روابط_مصادر_الوحدات: متغير متجه ربط_مصدر_وحدة_عملية = [];
    // The first output, backend or target option as written, for conflicts
    // found after every option is read.
    دع أول_خيار_بناء: متغير نص = «»;
    دع حجة_الهدف: متغير نص = «»;

    // std.process counts argv[0], the program image; options start at 1.
    دع ف: متغير طبيعي = 1;
    طالما (ف < عدد_الحجج) {
        دع الحجة: نص;
        طابق وسيطة(ف) مع
        | اختياري.لا_شيء -> {
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بلا_قيمة(
                معرف_تشخيص.استدعاء_مترجم_غير_صالح()
            );
            أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
        }
        | اختياري.موجود(القيمة) -> { الحجة := القيمة; };

        // Once `run` is selected, the next non-option token is the source and
        // every token after that is guest argv. Do not interpret guest values as compiler flags.
        // Options between `run` and its source are still compiler options.
        دع حجة_خيار: منطقي = ((الطول(الحجة) مثل طبيعي) > 0) && الحجة[0] == 0x2D;
        لو (بعد_أمر_التفسير && (وجد_مصدر || !حجة_خيار)) {
            لو (!وجد_مصدر) {
                مسار_المصدر := الحجة;
                وجد_مصدر := صواب;
            } وإلا لو (!فاصل_الوسائط_مستهلك && الطول(وسائط_التفسير) == 0 && حجة_تساوي(&الحجة, «--»)) {
                // `run file.sn -- args`: the first `--` after the source only
                // separates the program's arguments; it is not one of them.
                فاصل_الوسائط_مستهلك := صواب;
            } وإلا {
                دع بايتات_الوسيط: متجه ط8 = بايتات_وسيط_برنامج_من_حجة(&الحجة);
                ألحق(وسائط_التفسير, بايتات_الوسيط);
            };
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «--help»)) {
            لو (وجد_أمر) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            الأمر := أمر_واجهة_مترجم.مساعدة();
            وجد_أمر := صواب;
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «--version»)) {
            لو (وجد_أمر) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            الأمر := أمر_واجهة_مترجم.إصدار();
            وجد_أمر := صواب;
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «--explain»)) {
            لو (وجد_أمر || وجد_شرح) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            لو (ف + 1 >= عدد_الحجج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            طابق وسيطة(ف + 1) مع
            | اختياري.لا_شيء -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | اختياري.موجود(القيمة) -> { كود_الشرح := القيمة; };
            الأمر := أمر_واجهة_مترجم.شرح();
            وجد_أمر := صواب;
            وجد_شرح := صواب;
            ف := ف + 2;
        } وإلا لو ((الطول(الحجة) مثل طبيعي) > 10 && يطابق_عند(&الحجة, 0, «--explain=»)) {
            لو (وجد_أمر || وجد_شرح) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_أمر_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            كود_الشرح := ذيل_حجة_من(&الحجة, 10);
            الأمر := أمر_واجهة_مترجم.شرح();
            وجد_أمر := صواب;
            وجد_شرح := صواب;
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «-c»)) {
            لو (وجد_نوع_مخرج && نوع_المخرج == نوع_مخرج_تجميع_عملية.تنفيذي()) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_نوع_مخرج_متعارض()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            نوع_المخرج := نوع_مخرج_تجميع_عملية.كائن();
            وجد_نوع_مخرج := صواب;
            لو ((الطول(أول_خيار_بناء) مثل طبيعي) == 0) { أول_خيار_بناء := انسخ_نص(&الحجة); };
            ف := ف + 1;
        } وإلا لو ((الطول(الحجة) مثل طبيعي) > 7 && يطابق_عند(&الحجة, 0, «--emit=»)) {
            دع القيمة: نص = ذيل_حجة_من(&الحجة, 7);
            دع المخرج_الجديد: نوع_مخرج_تجميع_عملية;
            طابق مخرج_واجهة_من_نص(&القيمة) مع
            | نتيجة_مخرج_واجهة.غير_صالح -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_قيمة_خيار_غير_مقبولة(الحجة);
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | نتيجة_مخرج_واجهة.صالح(المخرج) -> { المخرج_الجديد := المخرج; };
            لو (وجد_نوع_مخرج && المخرج_الجديد != نوع_المخرج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_نوع_مخرج_متعارض()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            نوع_المخرج := المخرج_الجديد;
            وجد_نوع_مخرج := صواب;
            لو ((الطول(أول_خيار_بناء) مثل طبيعي) == 0) { أول_خيار_بناء := انسخ_نص(&الحجة); };
            ف := ف + 1;
        } وإلا لو (حجة_تساوي(&الحجة, «-o»)) {
            لو (وجد_إخراج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_خيار_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            لو (ف + 1 >= عدد_الحجج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            طابق وسيطة(ف + 1) مع
            | اختياري.لا_شيء -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | اختياري.موجود(القيمة) -> { مسار_الإخراج := القيمة; };
            وجد_إخراج := صواب;
            لو ((الطول(أول_خيار_بناء) مثل طبيعي) == 0) { أول_خيار_بناء := انسخ_نص(&الحجة); };
            ف := ف + 2;
        } وإلا لو (حجة_تساوي(&الحجة, «--target») || حجة_تساوي(&الحجة, «-t»)) {
            لو (وجد_هدف) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_خيار_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            لو (ف + 1 >= عدد_الحجج) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
            طابق وسيطة(ف + 1) مع
            | اختياري.لا_شيء -> {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_واجهة_بقيمة(
                    معرف_تشخيص.قيمة_خيار_مترجم_مفقودة(),
                    مفتاح_حجة_تشخيص.القيمة(), الحجة, خطأ, خطأ
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            }
            | اختياري.موجود(القيمة) -> { تهجئة_الهدف := القيمة; };
            وجد_هدف := صواب;
            لو ((الطول(حجة_الهدف) مثل طبيعي) == 0) { حجة_الهدف := انسخ_نص(&الحجة); };
            ف := ف + 2;
        } وإلا لو ((الطول(الحجة) مثل طبيعي) > 9 && يطابق_عند(&الحجة, 0, «--target=»)) {
            لو (وجد_هدف) {
                دع التشخيصات: مجموعة_تشخيصات = تشخيصات_تعارض_واجهة(
                    الحجة, سبب_تشخيص.سبب_واجهة_خيار_مكرر()
                );
                أرجع نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد);
            };
