// The driver discharges explicit comptime obligations after all functions
// have been lowered. The only executor is the verified MSIR interpreter.
// No unmarked call is evaluated or rewritten by this pass.
عرف علم_تابعا_لوقت_الترجمة(
    المطلوب: &متغير متجه منطقي,
    القيمة: معرف_قيمة_مسير
): فراغ {
    لو (القيمة.القيمة < (الطول(*المطلوب) مثل غير_موقع)) {
        (*المطلوب)[القيمة.القيمة] := صواب;
    };
}

عرف اجمع_تبعيات_وقت_الترجمة(
    العملية: &عملية_مسير,
    المطلوب: &متغير متجه منطقي
): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> { أرجع صواب; }
    | عملية_مسير.حساب_صحيح(ح) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليسار);
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليمين);
    }
    | عملية_مسير.مقارنة_صحيح(ح) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليسار);
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليمين);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, التحويل.المصدر);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(التهيئة.العناصر) مثل غير_موقع)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, التهيئة.العناصر[ف]);
            ف := ف + 1;
        }
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, التجميع.الأعضاء[ف]);
            ف := ف + 1;
        }
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(_) -> { }
        | _ -> { أرجع خطأ; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(النداء.الحجج) مثل غير_موقع)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, النداء.الحجج[ف]);
            ف := ف + 1;
        }
    }
    | _ -> { أرجع خطأ; };
    أرجع صواب;
}

عرف ثابت_إلى_قيمة_وقت_ترجمة(الثابت: &ثابت_مسير): اختيار قيمة_تشغيل {
    طابق *الثابت مع
    | ثابت_مسير.منطق(قيمة) -> { أرجع اختيار.بعض(قيمة_تشغيل.منطق(قيمة)); }
    | ثابت_مسير.صحيح_موقع(قيمة) -> { أرجع اختيار.بعض(قيمة_تشغيل.بتات_عدد(قيمة مثل غير_موقع)); }
    | ثابت_مسير.صحيح_غير_موقع(قيمة) -> { أرجع اختيار.بعض(قيمة_تشغيل.بتات_عدد(قيمة)); }
    | ثابت_مسير.نص(قيمة) -> { أرجع اختيار.بعض(قيمة_تشغيل.نص(قيمة)); }
    | ثابت_مسير.مؤشر_فارغ -> { أرجع اختيار.بعض(قيمة_تشغيل.مؤشر_فارغ()); }
    | ثابت_مسير.دالة(قيمة) -> { أرجع اختيار.بعض(قيمة_تشغيل.دالة(قيمة)); }
    | ثابت_مسير.متجه(القيم) -> {
        دع الأعضاء: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(القيم) مثل غير_موقع)) {
            طابق ثابت_إلى_قيمة_وقت_ترجمة(&القيم[ف]) مع
            | اختيار.بعض(العنصر) -> { ألحق(الأعضاء, العنصر); }
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختيار.بعض(قيمة_تشغيل.تجميع(الأعضاء));
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قيمة_إلى_ثابت_وقت_ترجمة(
    القيمة: &قيمة_تشغيل,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختيار ثابت_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.منطق(قيمة) -> { أرجع اختيار.بعض(ثابت_مسير.منطق(قيمة)); }
    | قيمة_تشغيل.محرف(قيمة) -> { أرجع اختيار.بعض(ثابت_مسير.صحيح_غير_موقع(قيمة مثل غير_موقع)); }
    | قيمة_تشغيل.نص(قيمة) -> { أرجع اختيار.بعض(ثابت_مسير.نص(قيمة)); }
    | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختيار.بعض(ثابت_مسير.مؤشر_فارغ()); }
    | قيمة_تشغيل.دالة(معرف) -> { أرجع اختيار.بعض(ثابت_مسير.دالة(معرف)); }
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختيار.بعض(المعرف) -> { نوع_العنصر := المعرف; }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
        دع الثوابت: متغير متجه ثابت_مسير = [];
        دع موضع_العنصر: متغير غير_موقع = 0;
        بينما (موضع_العنصر < (الطول(العناصر) مثل غير_موقع)) {
            طابق قيمة_إلى_ثابت_وقت_ترجمة(&العناصر[موضع_العنصر], نوع_العنصر, الأنواع) مع
            | اختيار.بعض(ثابت) -> { ألحق(الثوابت, ثابت); }
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
            موضع_العنصر := موضع_العنصر + 1;
        }
        أرجع اختيار.بعض(ثابت_مسير.متجه(الثوابت));
    }
    | قيمة_تشغيل.بتات_عدد(الخام) -> {
        طابق نوع_أساس_عند(الأنواع, النوع) مع
        | اختيار.بعض(نوع_مقنن.بدائي(البدائي)) -> {
            دع العرض: غير_موقع = بتات_نوع_بدائي(البدائي);
            دع القناع: متغير غير_موقع = ((9223372036854775807 مثل غير_موقع) << 1) | 1;
            لو (العرض < 64) {
                القناع := ((1 مثل غير_موقع) << العرض) - 1;
            };
            دع القيمة_المحدودة: غير_موقع = الخام & القناع;
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع الإشارة: غير_موقع = (1 مثل غير_موقع) << (العرض - 1);
                دع الممددة: متغير غير_موقع = القيمة_المحدودة;
                لو ((القيمة_المحدودة & الإشارة) != 0) {
                    الممددة := القيمة_المحدودة | (~القناع);
                };
                أرجع اختيار.بعض(ثابت_مسير.صحيح_موقع(الممددة مثل عدد));
            }
            | صنف_نوع_بدائي.عدد_صحيح_غير_موقع -> {
                أرجع اختيار.بعض(ثابت_مسير.صحيح_غير_موقع(القيمة_المحدودة));
            }
            | صنف_نوع_بدائي.حرف -> {
                أرجع اختيار.بعض(ثابت_مسير.صحيح_غير_موقع(القيمة_المحدودة));
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

// Why compile-time work was rejected: a stable reason for the
// nonconstant-expression diagnostic, or the message of a compile-time failure
// the program requested (بدائي_فشل_وقت_الترجمة).
عام نوع رفض_وقت_الترجمة =
    | سبب بنوع نص
    | فشل_مطلوب بنوع متجه غ8
;

عرف رفض_بسبب(السبب: نص): رفض_وقت_الترجمة {
    أرجع رفض_وقت_الترجمة.سبب(السبب);
}

// The interpreter owns failure identity; the driver translates it into
// stable compile-time diagnostic reasons instead of hiding all CTFE failures
// behind the same nonconstant-expression message.
نوع نتيجة_نداء_مسبق =
    | ثابت بنوع ثابت_مسير
    | مرفوض بنوع رفض_وقت_الترجمة
;

عرف سبب_فشل_نداء_مسبق(الفشل: &فشل_تفسير_مسير): رفض_وقت_الترجمة {
    طابق *الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(خطأ_التنفيذ) -> {
        طابق خطأ_التنفيذ مع
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(الرسالة) -> {
            أرجع رفض_وقت_الترجمة.فشل_مطلوب(الرسالة);
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع رفض_بسبب(نص_سبب_فشل_نداء_مسبق(الفشل));
}

عرف نص_سبب_فشل_نداء_مسبق(الفشل: &فشل_تفسير_مسير): نص {
    طابق *الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد -> { أرجع «comptime.instruction-budget-exhausted»; }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء -> { أرجع «comptime.call-depth-exhausted»; }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع -> { أرجع «comptime.prohibited-effect»; }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة -> { أرجع «comptime.argument-not-closed»; }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة -> { أرجع «comptime.result-not-closed»; }
        | _ -> { أرجع «comptime.execution-failed»; };
    }
    | فشل_تفسير_مسير.فخ_مسير(_, _) -> { أرجع «comptime.execution-trapped»; }
    | فشل_تفسير_مسير.خلل_داخلي(_) -> { أرجع «comptime.interpreter-failure»; };
}

// The call must have known, closed SSA operands. The interpreter additionally
// checks all reachable effects and instruction/recursion budgets.
عرف نفذ_نداء_وقت_الترجمة(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    النداء: &نداء_مسير,
    الجدول: &متجه اختيار ثابت_مسير,
    نوع_الناتج: معرف_نوع
): نتيجة_نداء_مسبق {
    دع الدالة: معرف_دالة_مسير;
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الدالة := المعرف; }
    | _ -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.unsupported-callee»)); };
    دع الحجج: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*النداء).الحجج) مثل غير_موقع)) {
        دع المعرف: معرف_قيمة_مسير = (*النداء).الحجج[ف];
        لو (المعرف.القيمة >= (الطول(*الجدول) مثل غير_موقع)) {
            أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.nonconstant-argument»));
        };
        طابق (*الجدول)[المعرف.القيمة] مع
        | اختيار.بعض(الثابت) -> {
            طابق ثابت_إلى_قيمة_وقت_ترجمة(&الثابت) مع
            | اختيار.بعض(القيمة) -> { ألحق(الحجج, القيمة); }
            | اختيار.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.nonconstant-argument»)); };
        }
        | اختيار.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.nonconstant-argument»)); };
        ف := ف + 1;
    }
    طابق فسر_وقت_الترجمة_مسير(
        البرنامج, الأنواع, الهدف, الدالة, الحجج, 100000, 128
    ) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(الناتج) -> {
            طابق الناتج مع
            | اختيار.بعض(القيمة) -> {
                طابق قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع) مع
                | اختيار.بعض(الثابت) -> { أرجع نتيجة_نداء_مسبق.ثابت(الثابت); }
                | اختيار.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.unrepresentable-result»)); };
            }
            | اختيار.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.missing-result»)); };
        }
        | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
            أرجع نتيجة_نداء_مسبق.مرفوض(سبب_فشل_نداء_مسبق(&الفشل.الفشل));
        }
        | نتيجة_تفسير_مسير.هدف_غير_متوافق -> {
            أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.unknown-target»));
        }
        | _ -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.execution-failed»)); };
    }
    | نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(_) -> {
        أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(«comptime.invalid-msir»));
    };
}

// A non-call MSIR expression is evaluated by the same interpreter. Construct
// a temporary, verified one-operation MSIR function with its already-known
// operands, rather than reimplementing integer arithmetic or comparisons in
// the driver. The original program and all its canonical identities survive
// unchanged. This path is only needed for explicit comptime expressions.
عرف نفذ_عملية_ثابتة_وقت_الترجمة(
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير,
    الجدول: &متجه اختيار ثابت_مسير,
    الدالة_المصدر: &دالة_مسير,
    نوع_الناتج: معرف_نوع
): اختيار ثابت_مسير {
    دع المصدر_الأول: معرف_قيمة_مسير;
    دع المصدر_الثاني: معرف_قيمة_مسير;
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        المصدر_الأول := الحساب.اليسار;
        المصدر_الثاني := الحساب.اليمين;
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        المصدر_الأول := المقارنة.اليسار;
        المصدر_الثاني := المقارنة.اليمين;
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        المصدر_الأول := التحويل.المصدر;
        المصدر_الثاني := التحويل.المصدر;
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
    لو (المصدر_الأول.القيمة >= (الطول(*الجدول) مثل غير_موقع)
        || المصدر_الثاني.القيمة >= (الطول(*الجدول) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع ثابت_الأول: ثابت_مسير;
    دع ثابت_الثاني: ثابت_مسير;
    طابق (*الجدول)[المصدر_الأول.القيمة] مع
    | اختيار.بعض(قيمة) -> { ثابت_الأول := قيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    طابق (*الجدول)[المصدر_الثاني.القيمة] مع
    | اختيار.بعض(قيمة) -> { ثابت_الثاني := قيمة; }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    // Isolated, canonical MSIR program: never clone the whole compiler IR for
    // a constant arithmetic operation. The shared interpreter verifies it.
    دع المؤقت: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع بلا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(
        &متغير المؤقت, &بلا_معاملات, اختيار.بعض(نوع_الناتج)
    );
    دع الكتلة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(&متغير المؤقت, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { الكتلة := المعرف; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع النوع_الأول: معرف_نوع = (*الدالة_المصدر).القيم[المصدر_الأول.القيمة].النوع;
    دع النوع_الثاني: معرف_نوع = (*الدالة_المصدر).القيم[المصدر_الثاني.القيمة].النوع;
    دع الأول: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        &متغير المؤقت, &البناء, الدالة, الكتلة,
        انسخ_ثابت_مسير(&ثابت_الأول), النوع_الأول
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الأول := المعرف; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع الثاني: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        &متغير المؤقت, &البناء, الدالة, الكتلة,
        انسخ_ثابت_مسير(&ثابت_الثاني), النوع_الثاني
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الثاني := المعرف; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع الناتج: معرف_قيمة_مسير;
    دع الناتج_العملية: نتيجة_بناء_قيمة_مسير;
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        الناتج_العملية := أصدر_حسابا_صحيحا_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            الحساب.العملية, الأول, الثاني, نوع_الناتج
        );
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        الناتج_العملية := أصدر_مقارنة_صحيح_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            المقارنة.العملية, الأول, الثاني, نوع_الناتج
        );
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        الناتج_العملية := أصدر_تحويل_صحيح_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            التحويل.العملية, الأول, نوع_الناتج
        );
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
    طابق الناتج_العملية مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الناتج := المعرف; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    طابق اختم_بإرجاع_مسير(&متغير المؤقت, الدالة, الكتلة, اختيار.بعض(الناتج)) مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع الحجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(المؤقت, الأنواع, الهدف, الدالة, الحجج, 100000, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(الناتج_المفسر) -> {
            طابق الناتج_المفسر مع
            | اختيار.بعض(القيمة) -> {
                أرجع قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع);
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

// Execute a closed aggregate construction with the same verified MSIR
// interpreter used for ordinary comptime calls. Rebuild only the independent
// instruction slice; never copy the entire lowered program.
عرف نفذ_تجميع_ثابت_وقت_الترجمة(
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير,
    الجدول: &متجه اختيار ثابت_مسير,
    الدالة_المصدر: &دالة_مسير,
    نوع_الناتج: معرف_نوع
): اختيار ثابت_مسير {
    دع أعضاء_المصدر: متغير متجه معرف_قيمة_مسير = [];
    دع متجه_مملوك: منطقي;
    طابق *العملية مع
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        متجه_مملوك := صواب;
        دع موضع: متغير غير_موقع = 0;
        بينما (موضع < (الطول(التهيئة.العناصر) مثل غير_موقع)) {
            ألحق(أعضاء_المصدر, التهيئة.العناصر[موضع]);
            موضع := موضع + 1;
        }
    }
    | عملية_مسير.تجميع(التجميع) -> {
        متجه_مملوك := خطأ;
        دع موضع: متغير غير_موقع = 0;
        بينما (موضع < (الطول(التجميع.الأعضاء) مثل غير_موقع)) {
            ألحق(أعضاء_المصدر, التجميع.الأعضاء[موضع]);
            موضع := موضع + 1;
        }
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع المؤقت: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع المعاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(
        &متغير المؤقت, &المعاملات, اختيار.بعض(نوع_الناتج)
    );
    دع الكتلة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(&متغير المؤقت, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { الكتلة := المعرف; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الأعضاء: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أعضاء_المصدر) مثل غير_موقع)) {
        دع المعرف: معرف_قيمة_مسير = أعضاء_المصدر[ف];
        لو (المعرف.القيمة >= (الطول(*الجدول) مثل غير_موقع)
            || المعرف.القيمة >= (الطول((*الدالة_المصدر).القيم) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        دع الثابت: ثابت_مسير;
        طابق (*الجدول)[المعرف.القيمة] مع
        | اختيار.بعض(القيمة) -> { الثابت := انسخ_ثابت_مسير(&القيمة); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
        دع المضاف: معرف_قيمة_مسير;
        طابق أصدر_ثابتا_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, الثابت,
            (*الدالة_المصدر).القيم[المعرف.القيمة].النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(الهوية) -> { المضاف := الهوية; }
        | _ -> { أرجع اختيار.لا_شيء(); };
        ألحق(الأعضاء, المضاف);
        ف := ف + 1;
    }
    دع العملية_المضافة: نتيجة_بناء_قيمة_مسير;
    لو (متجه_مملوك) {
        العملية_المضافة := أصدر_تهيئة_متجه_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, &الأعضاء, نوع_الناتج
        );
    } وإلا {
        العملية_المضافة := أصدر_تجميع_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, &الأعضاء, نوع_الناتج
        );
    };
    دع الناتج: معرف_قيمة_مسير;
    طابق العملية_المضافة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(الهوية) -> { الناتج := الهوية; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    طابق اختم_بإرجاع_مسير(&متغير المؤقت, الدالة, الكتلة, اختيار.بعض(الناتج)) مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع الحجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(المؤقت, الأنواع, الهدف, الدالة, الحجج, 100000, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(اختيار.بعض(القيمة)) -> {
            أرجع قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع);
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

// Statement-form comptime is an isolated, void MSIR function. Execute it
// through the same verified interpreter with the same bounded effect policy.
// It has no runtime operands and cannot capture the caller's local storage.
عرف نفذ_عبارة_وقت_الترجمة(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير
): اختيار رفض_وقت_الترجمة {
    دع الدالة: معرف_دالة_مسير;
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        لو ((الطول(النداء.الحجج) مثل غير_موقع) != 0) {
            أرجع اختيار.بعض(رفض_بسبب(«comptime.nonconstant-argument»));
        };
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الدالة := المعرف; }
        | _ -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unsupported-callee»)); };
    }
    | _ -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unsupported-operation»)); };
    دع بلا_حجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(البرنامج, الأنواع, الهدف, الدالة, بلا_حجج, 100000, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(_) -> {
        أرجع اختيار.بعض(رفض_بسبب(«comptime.invalid-msir»));
    }
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(اختيار.لا_شيء) -> { أرجع اختيار.لا_شيء(); }
        | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
            أرجع اختيار.بعض(سبب_فشل_نداء_مسبق(&الفشل.الفشل));
        }
        | نتيجة_تفسير_مسير.هدف_غير_متوافق -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unknown-target»)); }
        | _ -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unexpected-result»)); };
    };
}

// Remove only a successfully executed, value-less comptime marker. Value IDs
// and block identities remain unchanged; no runtime consumer sees this call.
عرف أزل_عبارة_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الدالة: غير_موقع,
    الكتلة: غير_موقع,
    الفهرس: غير_موقع
): فراغ {
    دع الجديدة: متغير متجه تعليمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل غير_موقع)) {
        لو (ف != الفهرس) {
            // Move the instruction's owned payload without copying it.
            دع المنقول: متغير تعليمة_مسير = {
                الناتج: اختيار.لا_شيء(),
                العملية: عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ)),
                الأصل: اختيار.لا_شيء(),
                موقع_التصحيح: اختيار.لا_شيء(),
                نطاق_التصحيح: اختيار.لا_شيء(),
                تقييم_وقت_الترجمة: خطأ
            };
            بدّل((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[ف], المنقول);
            ألحق(الجديدة, المنقول);
        };
        ف := ف + 1;
    }
    (*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات := الجديدة;
}

// The dependency slice of الجذور inside block ك, up to and including
// instruction النهاية, evaluated through the shared interpreter. Every
// evaluated instruction is rewritten into its constant (value IDs and block
// identities are unchanged). A dependency on a parameter, a block argument, an
// unsupported operation or a prohibited effect rejects the slice.
نوع نتيجة_شريحة_وقت_الترجمة =
    | محلولة بنوع متجه اختيار ثابت_مسير
    | مرفوضة بنوع رفض_وقت_الترجمة
;

عرف حل_شريحة_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: غير_موقع,
    ك: غير_موقع,
    النهاية: غير_موقع,
    الجذور: &متجه معرف_قيمة_مسير
): نتيجة_شريحة_وقت_الترجمة {
    دع المطلوب: متغير متجه منطقي = [];
    دع ح: متغير غير_موقع = 0;
    بينما (ح < ((*البرنامج).الدوال[د].القيمة_التالية)) {
        ألحق(المطلوب, خطأ);
        ح := ح + 1;
    }
    ح := 0;
    بينما (ح < (الطول(*الجذور) مثل غير_موقع)) {
        علم_تابعا_لوقت_الترجمة(&متغير المطلوب, (*الجذور)[ح]);
        ح := ح + 1;
    }
    دع ع: متغير غير_موقع = النهاية + 1;
    بينما (ع > 0) {
        ع := ع - 1;
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع];
        طابق (*التعليمة).الناتج مع
        | اختيار.بعض(القيمة) -> {
            لو (المطلوب[القيمة.المعرف.القيمة]) {
                لو (!اجمع_تبعيات_وقت_الترجمة(&(*التعليمة).العملية, &متغير المطلوب)) {
                    أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(«comptime.unsupported-operation»));
                };
            };
        }
        | اختيار.لا_شيء -> { };
    }
    دع الجدول: متغير متجه اختيار ثابت_مسير = [];
    ح := 0;
    بينما (ح < ((*البرنامج).الدوال[د].القيمة_التالية)) {
        ألحق(الجدول, اختيار.لا_شيء());
        ح := ح + 1;
    }
    ع := 0;
    بينما (ع <= النهاية) {
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع];
        طابق (*التعليمة).الناتج مع
        | اختيار.بعض(القيمة) -> {
            لو (المطلوب[القيمة.المعرف.القيمة]) {
                دع الثابت: متغير اختيار ثابت_مسير = اختيار.لا_شيء();
                طابق (*التعليمة).العملية مع
                | عملية_مسير.ثابت(القيمة_الثابتة) -> {
                    الثابت := اختيار.بعض(القيمة_الثابتة);
                }
                | عملية_مسير.تهيئة_متجه(_) -> {
                    الثابت := نفذ_تجميع_ثابت_وقت_الترجمة(
                        الأنواع, الهدف, &(*التعليمة).العملية,
                        &الجدول, &(*البرنامج).الدوال[د], القيمة.النوع
                    );
                }
                | عملية_مسير.تجميع(_) -> {
                    الثابت := نفذ_تجميع_ثابت_وقت_الترجمة(
                        الأنواع, الهدف, &(*التعليمة).العملية,
                        &الجدول, &(*البرنامج).الدوال[د], القيمة.النوع
                    );
                }
                | عملية_مسير.نداء(النداء) -> {
                    طابق نفذ_نداء_وقت_الترجمة(
                        *البرنامج, الأنواع, الهدف, &النداء, &الجدول, القيمة.النوع
                    ) مع
                    | نتيجة_نداء_مسبق.ثابت(معروف) -> { الثابت := اختيار.بعض(معروف); }
                    | نتيجة_نداء_مسبق.مرفوض(السبب) -> {
                        أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب);
                    };
                }
                | _ -> {
                    الثابت := نفذ_عملية_ثابتة_وقت_الترجمة(
                        الأنواع, الهدف,
                        &(*التعليمة).العملية, &الجدول,
                        &(*البرنامج).الدوال[د], القيمة.النوع
                    );
                };
                طابق الثابت مع
                | اختيار.بعض(معروف) -> {
                    الجدول[القيمة.المعرف.القيمة] := اختيار.بعض(انسخ_ثابت_مسير(&معروف));
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع].العملية := عملية_مسير.ثابت(معروف);
                }
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(«comptime.nonconstant-or-prohibited-effect»));
                };
            };
        }
        | اختيار.لا_شيء -> { };
        ع := ع + 1;
    }
    // A root no instruction of the slice defined (a parameter or block
    // argument) is not compile-time known.
    ح := 0;
    بينما (ح < (الطول(*الجذور) مثل غير_موقع)) {
        دع الجذر: معرف_قيمة_مسير = (*الجذور)[ح];
        لو (الجذر.القيمة >= (الطول(الجدول) مثل غير_موقع)) {
            أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(«comptime.nonconstant-argument»));
        };
        طابق الجدول[الجذر.القيمة] مع
        | اختيار.بعض(_) -> { }
        | اختيار.لا_شيء -> {
            أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(«comptime.nonconstant-argument»));
        };
        ح := ح + 1;
    }
    أرجع نتيجة_شريحة_وقت_الترجمة.محلولة(الجدول);
}

// Compile-time parameters (CT-01). A function with any `comptime` parameter
// is a template: it is never called at runtime with those arguments.
// - Every parameter compile-time: the call is evaluated entirely at compile
//   time (the existing CTFE path).
// - Mixed parameters: the compile-time arguments must be compile-time known;
//   the call is redirected to a specialized copy of the function in which each
//   compile-time parameter is the known value (a constant, or a capture-free
//   function value) and only the runtime parameters remain. Specializations
//   are shared per (function, compile-time arguments), as in Zig's comptime
//   parameter instantiation. The template body itself is not discharged: its
//   compile-time obligations depend on arguments it does not have.
// Previously every call to such a function had to be fully evaluated at
// compile time, so any runtime argument was rejected.
نوع ربط_معامل_وقت_الترجمة =
    | ثابت بنوع ثابت_مسير
    | دالة بنوع معرف_دالة_مسير
;

نوع تخصيص_وقت_الترجمة = {
    الأصل: غير_موقع,
    الروابط: متجه ربط_معامل_وقت_الترجمة,
    المخصصة: غير_موقع
};

// Bounds the specializations one compilation may create, so a template that
// recurses on a compile-time parameter without a compile-time base case is
// diagnosed instead of expanding forever.
عرف حد_تخصيصات_وقت_الترجمة(): غير_موقع {
    أرجع 4096;
}

عرف دالة_قالب_وقت_الترجمة(الدالة: &دالة_مسير): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل غير_موقع)) {
        لو ((*الدالة).معاملات_وقت_الترجمة[ف]) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف كل_معاملات_الدالة_وقت_ترجمة(الدالة: &دالة_مسير): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل غير_موقع)) {
        لو (!(*الدالة).معاملات_وقت_الترجمة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ربطا_معامل_وقت_الترجمة_متساويان(
    أ: &ربط_معامل_وقت_الترجمة,
    ب: &ربط_معامل_وقت_الترجمة
): منطقي {
    طابق *أ مع
    | ربط_معامل_وقت_الترجمة.ثابت(ثابت_أ) -> {
        طابق *ب مع
        | ربط_معامل_وقت_الترجمة.ثابت(ثابت_ب) -> { أرجع ثابتا_مسير_متساويان(&ثابت_أ, &ثابت_ب); }
        | _ -> { أرجع خطأ; };
    }
    | ربط_معامل_وقت_الترجمة.دالة(دالة_أ) -> {
        طابق *ب مع
        | ربط_معامل_وقت_الترجمة.دالة(دالة_ب) -> { أرجع دالتا_مسير_متساويتان(دالة_أ, دالة_ب); }
        | _ -> { أرجع خطأ; };
    };
}

عرف ابحث_تخصيص_وقت_الترجمة(
    التخصيصات: &متجه تخصيص_وقت_الترجمة,
    الأصل: غير_موقع,
    الروابط: &متجه ربط_معامل_وقت_الترجمة
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*التخصيصات) مثل غير_موقع)) {
        دع التخصيص: &تخصيص_وقت_الترجمة = &(*التخصيصات)[ف];
        لو ((*التخصيص).الأصل == الأصل
            && (الطول((*التخصيص).الروابط) مثل غير_موقع) == (الطول(*الروابط) مثل غير_موقع)) {
            دع متطابق: متغير منطقي = صواب;
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(*الروابط) مثل غير_موقع)) {
                لو (!ربطا_معامل_وقت_الترجمة_متساويان(&(*التخصيص).الروابط[م], &(*الروابط)[م])) {
                    متطابق := خطأ;
                };
                م := م + 1;
            }
            لو (متطابق) { أرجع اختيار.بعض((*التخصيص).المخصصة); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_ربط_معامل_وقت_الترجمة(
    الربط: &ربط_معامل_وقت_الترجمة
): ربط_معامل_وقت_الترجمة {
    طابق *الربط مع
    | ربط_معامل_وقت_الترجمة.ثابت(الثابت) -> {
        أرجع ربط_معامل_وقت_الترجمة.ثابت(انسخ_ثابت_مسير(&الثابت));
    }
    | ربط_معامل_وقت_الترجمة.دالة(الدالة) -> {
        أرجع ربط_معامل_وقت_الترجمة.دالة(الدالة);
    };
}

// The specialized copy: compile-time parameters become entry-block
// definitions of the same values, the copy is re-identified under its new
// MSIR function identity (msir_renumbering.sn), and it has only runtime
// parameters.
عرف أنشئ_تخصيص_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأصل: غير_موقع,
    الروابط: &متجه ربط_معامل_وقت_الترجمة
): غير_موقع {
    دع مرجع_الأصل: &دالة_مسير = &(*البرنامج).الدوال[الأصل];
    دع النسخة: متغير دالة_مسير = *مرجع_الأصل;
    دع الجديد: غير_موقع = الطول((*البرنامج).الدوال) مثل غير_موقع;
    دع فهرس_المدخل: متغير غير_موقع = 0;
    طابق النسخة.المدخل مع
    | اختيار.بعض(المدخل) -> {
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول(النسخة.الكتل) مثل غير_موقع)) {
            لو (كتلتان_مسير_متساويتان(النسخة.الكتل[ك].المعرف, المدخل)) { فهرس_المدخل := ك; };
            ك := ك + 1;
        }
    }
    | اختيار.لا_شيء -> { };
    دع المعاملات: متغير متجه قيمة_مسير = [];
    دع الأعلام: متغير متجه منطقي = [];
    دع التعريفات: متغير متجه تعليمة_مسير = [];
    دع ف: متغير غير_موقع = 0;
    دع م: متغير غير_موقع = 0;
    بينما (ف < (الطول(النسخة.المعاملات) مثل غير_موقع)) {
        دع وقت_ترجمة: منطقي = ف < (الطول(النسخة.معاملات_وقت_الترجمة) مثل غير_موقع)
            && النسخة.معاملات_وقت_الترجمة[ف];
        لو (وقت_ترجمة && م < (الطول(*الروابط) مثل غير_موقع)) {
            دع العملية: متغير عملية_مسير = عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ));
            طابق (*الروابط)[م] مع
            | ربط_معامل_وقت_الترجمة.ثابت(الثابت) -> {
                العملية := عملية_مسير.ثابت(انسخ_ثابت_مسير(&الثابت));
            }
            | ربط_معامل_وقت_الترجمة.دالة(الدالة) -> {
                دع بلا_التقاطات: متجه معرف_قيمة_مسير = [];
                دع البناء: بناء_إغلاق_مسير = { الدالة: الدالة, الالتقاطات: بلا_التقاطات };
                العملية := عملية_مسير.بناء_إغلاق(البناء);
            };
            دع التعريف: تعليمة_مسير = {
                الناتج: اختيار.بعض(النسخة.المعاملات[ف]),
                العملية: العملية,
                الأصل: اختيار.لا_شيء(),
                موقع_التصحيح: اختيار.لا_شيء(),
                نطاق_التصحيح: اختيار.لا_شيء(),
                تقييم_وقت_الترجمة: خطأ
            };
            ألحق(التعريفات, التعريف);
            م := م + 1;
        } وإلا {
            ألحق(المعاملات, النسخة.المعاملات[ف]);
            ألحق(الأعلام, خطأ);
        };
        ف := ف + 1;
    }
    لو (فهرس_المدخل < (الطول(النسخة.الكتل) مثل غير_موقع)) {
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(النسخة.الكتل[فهرس_المدخل].التعليمات) مثل غير_موقع)) {
            دع المنقولة: متغير تعليمة_مسير = {
                الناتج: اختيار.لا_شيء(),
                العملية: عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ)),
                الأصل: اختيار.لا_شيء(),
                موقع_التصحيح: اختيار.لا_شيء(),
                نطاق_التصحيح: اختيار.لا_شيء(),
                تقييم_وقت_الترجمة: خطأ
            };
            بدّل(النسخة.الكتل[فهرس_المدخل].التعليمات[ت], المنقولة);
            ألحق(التعريفات, المنقولة);
            ت := ت + 1;
        }
        النسخة.الكتل[فهرس_المدخل].التعليمات := التعريفات;
    };
    النسخة.المعاملات := المعاملات;
    النسخة.معاملات_وقت_الترجمة := الأعلام;
    النسخة.المعرف := معرف_دالة_مسير_من(الجديد);
    أعد_تعريف_دالة_مسير_بمعرفها(&متغير النسخة);
    ألحق((*البرنامج).الدوال, النسخة);
    أرجع الجديد;
}

// The defining operation of a value in block ك before instruction ر.
عرف عملية_تعريف_في_الكتلة(
    البرنامج: &متغير برنامج_مسير,
    د: غير_موقع,
    ك: غير_موقع,
    ر: غير_موقع,
    القيمة: معرف_قيمة_مسير
): اختيار عملية_مسير {
    دع ع: متغير غير_موقع = 0;
    بينما (ع < ر) {
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع];
        طابق (*التعليمة).الناتج مع
        | اختيار.بعض(الناتج) -> {
            لو (قيمتا_مسير_متساويتان(الناتج.المعرف, القيمة)) {
                دع مرجع_العملية: &عملية_مسير = &(*التعليمة).العملية;
                أرجع اختيار.بعض(*مرجع_العملية);
            };
        }
        | اختيار.لا_شيء -> { };
        ع := ع + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف خصص_نداء_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: غير_موقع,
    ك: غير_موقع,
    ر: غير_موقع,
    التخصيصات: &متغير متجه تخصيص_وقت_الترجمة
): اختيار رفض_وقت_الترجمة {
    دع النداء: متغير نداء_مسير;
    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
    | عملية_مسير.نداء(القيمة) -> { النداء := القيمة; }
    | _ -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unsupported-operation»)); };
    دع الأصل: غير_موقع;
    طابق النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الأصل := المعرف.القيمة; }
    | _ -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unsupported-callee»)); };
    دع مرجع_الأعلام: &متجه منطقي = &(*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة;
    دع الأعلام: متجه منطقي = *مرجع_الأعلام;
    لو ((الطول(الأعلام) مثل غير_موقع) != (الطول(النداء.الحجج) مثل غير_موقع)) {
        أرجع اختيار.بعض(رفض_بسبب(«comptime.argument-count-mismatch»));
    };
    دع الروابط: متغير متجه ربط_معامل_وقت_الترجمة = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأعلام) مثل غير_موقع)) {
        لو (الأعلام[ف]) {
            دع الحجة: معرف_قيمة_مسير = النداء.الحجج[ف];
            دع رُبط: متغير منطقي = خطأ;
            طابق عملية_تعريف_في_الكتلة(البرنامج, د, ك, ر, الحجة) مع
            | اختيار.بعض(عملية_مسير.بناء_إغلاق(البناء)) -> {
                لو ((الطول(البناء.الالتقاطات) مثل غير_موقع) == 0) {
                    ألحق(الروابط, ربط_معامل_وقت_الترجمة.دالة(البناء.الدالة));
                    رُبط := صواب;
                };
            }
            | _ -> { };
            لو (!رُبط) {
                لو (ر == 0) { أرجع اختيار.بعض(رفض_بسبب(«comptime.nonconstant-argument»)); };
                دع الجذور: متجه معرف_قيمة_مسير = [الحجة];
                طابق حل_شريحة_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, ك, ر - 1, &الجذور) مع
                | نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب) -> { أرجع اختيار.بعض(السبب); }
                | نتيجة_شريحة_وقت_الترجمة.محلولة(الجدول) -> {
                    طابق الجدول[الحجة.القيمة] مع
                    | اختيار.بعض(الثابت) -> {
                        ألحق(الروابط, ربط_معامل_وقت_الترجمة.ثابت(انسخ_ثابت_مسير(&الثابت)));
                    }
                    | اختيار.لا_شيء -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.nonconstant-argument»)); };
                };
            };
        };
        ف := ف + 1;
    }
    دع المخصصة: متغير غير_موقع = 0;
    طابق ابحث_تخصيص_وقت_الترجمة(التخصيصات, الأصل, &الروابط) مع
    | اختيار.بعض(الموجودة) -> { المخصصة := الموجودة; }
    | اختيار.لا_شيء -> {
        لو ((الطول(*التخصيصات) مثل غير_موقع) >= حد_تخصيصات_وقت_الترجمة()) {
            أرجع اختيار.بعض(رفض_بسبب(«comptime.specialization-limit-exceeded»));
        };
        المخصصة := أنشئ_تخصيص_وقت_الترجمة(البرنامج, الأصل, &الروابط);
        دع روابط_المفتاح: متغير متجه ربط_معامل_وقت_الترجمة = [];
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(الروابط) مثل غير_موقع)) {
            ألحق(روابط_المفتاح, انسخ_ربط_معامل_وقت_الترجمة(&الروابط[ب]));
            ب := ب + 1;
        }
        دع التخصيص: تخصيص_وقت_الترجمة = {
            الأصل: الأصل,
            الروابط: روابط_المفتاح,
            المخصصة: المخصصة
        };
        ألحق(*التخصيصات, التخصيص);
    };
    // The call keeps only its runtime arguments; a memory range of a runtime
    // argument follows that argument's new position.
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع المواضع_الجديدة: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < (الطول(الأعلام) مثل غير_موقع)) {
        ألحق(المواضع_الجديدة, الطول(الحجج) مثل غير_موقع);
        لو (!الأعلام[ف]) { ألحق(الحجج, النداء.الحجج[ف]); };
        ف := ف + 1;
    }
    دع النطاقات: متغير متجه نطاق_ذاكرة_نداء_مسير = [];
    ف := 0;
    بينما (ف < (الطول(النداء.نطاقات_الذاكرة) مثل غير_موقع)) {
        دع النطاق: نطاق_ذاكرة_نداء_مسير = النداء.نطاقات_الذاكرة[ف];
        لو (النطاق.فهرس_الحجة < (الطول(الأعلام) مثل غير_موقع)
            && !الأعلام[النطاق.فهرس_الحجة]) {
            دع المنقول: متغير نطاق_ذاكرة_نداء_مسير = النطاق;
            المنقول.فهرس_الحجة := المواضع_الجديدة[النطاق.فهرس_الحجة];
            ألحق(النطاقات, المنقول);
        };
        ف := ف + 1;
    }
    النداء.الهدف := هدف_نداء_مسير.دالة_سلطان(معرف_دالة_مسير_من(المخصصة));
    النداء.الحجج := الحجج;
    النداء.نطاقات_الذاكرة := النطاقات;
    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية := عملية_مسير.نداء(النداء);
    أرجع اختيار.لا_شيء();
}

// Reflection facts (CT-03) are folded once, for the selected target, before
// any compile-time execution or code generation: the argument is a reference
// and the fact belongs to the type it refers to. Size and alignment come from
// the canonical layout owner (backend/layout); a type whose physical layout is
// intentionally unfrozen (text, vector, slice, function values) has none and is
// rejected. Field count is that of a record or tuple, constructor count that of
// an enum; any other type has 0 of either.
عرف نوع_مرجع_بدائي_انعكاس(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): معرف_نوع {
    طابق نوع_أساس_عند(الأنواع, النوع) مع
    | اختيار.بعض(نوع_مقنن.مرجع(العنصر, _)) -> { أرجع العنصر; }
    | _ -> { أرجع النوع; };
}

عرف قيمة_بدائي_انعكاس(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة غير_موقع, رفض_وقت_الترجمة {
    طابق البدائي مع
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> {
        طابق نوع_أساس_عند(الأنواع, النوع) مع
        | اختيار.بعض(نوع_مقنن.صف(العناصر)) -> { أرجع نتيجة.نجح(الطول(العناصر) مثل غير_موقع); }
        | _ -> { };
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختيار.بعض(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); };
    }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> {
        طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
        | اختيار.بعض(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); };
    }
    | _ -> { };
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(الواصف) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع نتيجة.نجح(الواصف.المحاذاة); }
        | _ -> { أرجع نتيجة.نجح(الواصف.الحجم); };
    }
    | نتيجة_تخطيط.مؤجل(_) -> {
        أرجع نتيجة.خطأ(رفض_بسبب(«comptime.layout-not-fixed»));
    }
    | نتيجة_تخطيط.مرفوض(_) -> {
        أرجع نتيجة.خطأ(رفض_بسبب(«comptime.layout-unavailable»));
    };
}

عرف بدائي_انعكاس(البدائي: هوية_بدائي_مترجم): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف اطو_بدائيات_الانعكاس(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف
): اختيار رفض_وقت_الترجمة {
    دع الواصف: واصف_هدف;
    طابق حل_بمعرف_هدف(الهدف) مع
    | نتيجة_حل_هدف.محلول(القيمة) -> { الواصف := القيمة; }
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختيار.بعض(رفض_بسبب(«comptime.unknown-target»)); };
    دع سجل_التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول((*البرنامج).الدوال) مثل غير_موقع)) {
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل غير_موقع)) {
            دع ر: متغير غير_موقع = 0;
            بينما (ر < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) {
                دع المطوي: متغير اختيار ثابت_مسير = اختيار.لا_شيء();
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
                        لو (بدائي_انعكاس(البدائي)
                            && (الطول(النداء.الحجج) مثل غير_موقع) == 1
                            && النداء.الحجج[0].القيمة < (الطول((*البرنامج).الدوال[د].القيم) مثل غير_موقع)) {
                            دع نوع_الحجة: معرف_نوع = (*البرنامج).الدوال[د].القيم[النداء.الحجج[0].القيمة].النوع;
                            دع النوع: معرف_نوع = نوع_مرجع_بدائي_انعكاس(الأنواع, نوع_الحجة);
                            طابق قيمة_بدائي_انعكاس(الأنواع, &الواصف, &متغير سجل_التخطيط, البدائي, النوع) مع
                            | نتيجة.نجح(العدد) -> {
                                المطوي := اختيار.بعض(ثابت_مسير.صحيح_غير_موقع(العدد));
                            }
                            | نتيجة.خطأ(الرفض) -> { أرجع اختيار.بعض(الرفض); };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                طابق المطوي مع
                | اختيار.بعض(الثابت) -> {
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية := عملية_مسير.ثابت(الثابت);
                }
                | اختيار.لا_شيء -> { };
                ر := ر + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع اختيار.لا_شيء();
}

// After compile-time evaluation no compile-time failure call remains: its
// block already ends with a trap (msir/lowering/statements.sn), which is all a
// run-time path through it does. Value IDs are unaffected; the call has no
// result.
عرف أزل_نداءات_فشل_وقت_الترجمة(البرنامج: &متغير برنامج_مسير): فراغ {
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول((*البرنامج).الدوال) مثل غير_موقع)) {
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل غير_موقع)) {
            دع ر: متغير غير_موقع = 0;
            بينما (ر < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع)) {
                دع فشل: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> { فشل := صواب; }
                    | _ -> { };
                }
                | _ -> { };
                لو (فشل) {
                    أزل_عبارة_وقت_الترجمة(البرنامج, د, ك, ر);
                } وإلا {
                    ر := ر + 1;
                };
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
}

// Explicit comptime results, statement-form blocks and calls to compile-time
// templates are discharged here, function by function; specialized copies are
// appended and processed by the same loop. One local SSA slice is evaluated
// per explicit result, traversed backwards, so unrelated runtime calls are not
// executed.
عام عرف نفذ_طلبات_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف
): اختيار رفض_وقت_الترجمة {
    طابق اطو_بدائيات_الانعكاس(البرنامج, الأنواع, الهدف) مع
    | اختيار.بعض(الرفض) -> { أرجع اختيار.بعض(الرفض); }
    | اختيار.لا_شيء -> { };
    دع التخصيصات: متغير متجه تخصيص_وقت_الترجمة = [];
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول((*البرنامج).الدوال) مثل غير_موقع)) {
        لو (!دالة_قالب_وقت_الترجمة(&(*البرنامج).الدوال[د])) {
        دع ك: متغير غير_موقع = 0;
        بينما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل غير_موقع)) {
            دع عدد_التعليمات: متغير غير_موقع = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل غير_موقع;
            دع ر: متغير غير_موقع = 0;
            بينما (ر < عدد_التعليمات) {
                // A call to a template: all-compile-time parameters are
                // evaluated; mixed parameters are specialized.
                دع يخصص: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.دالة_سلطان(هدف_الدالة) -> {
                        لو (هدف_الدالة.القيمة < (الطول((*البرنامج).الدوال) مثل غير_موقع)
                            && !(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة) {
                            لو (دالة_قالب_وقت_الترجمة(&(*البرنامج).الدوال[هدف_الدالة.القيمة])) {
                                لو (كل_معاملات_الدالة_وقت_ترجمة(&(*البرنامج).الدوال[هدف_الدالة.القيمة])) {
                                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة := صواب;
                                } وإلا {
                                    يخصص := صواب;
                                };
                            };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                لو (يخصص) {
                    طابق خصص_نداء_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, ك, ر, &متغير التخصيصات) مع
                    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                    | اختيار.لا_شيء -> { };
                };
                دع حُذفت_تعليمة: متغير منطقي = خطأ;
                لو ((*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة) {
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].الناتج مع
                    | اختيار.لا_شيء -> {
                        طابق نفذ_عبارة_وقت_الترجمة(
                            *البرنامج, الأنواع, الهدف,
                            &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية
                        ) مع
                        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                        | اختيار.لا_شيء -> {
                            أزل_عبارة_وقت_الترجمة(البرنامج, د, ك, ر);
                            حُذفت_تعليمة := صواب;
                        };
                    }
                    | اختيار.بعض(القيمة) -> {
                        دع الجذور: متجه معرف_قيمة_مسير = [القيمة.المعرف];
                        طابق حل_شريحة_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, ك, ر, &الجذور) مع
                        | نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب) -> { أرجع اختيار.بعض(السبب); }
                        | نتيجة_شريحة_وقت_الترجمة.محلولة(_) -> { };
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة := خطأ;
                    };
                };
                لو (حُذفت_تعليمة) {
                    عدد_التعليمات := عدد_التعليمات - 1;
                } وإلا {
                    ر := ر + 1;
                };
            }
            ك := ك + 1;
        }
        };
        د := د + 1;
    }
    أزل_نداءات_فشل_وقت_الترجمة(البرنامج);
    أرجع اختيار.لا_شيء();
}
