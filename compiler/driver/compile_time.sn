// The driver discharges explicit comptime obligations after all functions
// have been lowered. The only executor is the verified MSIR interpreter.
// No unmarked call is evaluated or rewritten by this pass.
عرف علم_تابعا_لوقت_الترجمة(
    المطلوب: &متغير متجه منطقي,
    القيمة: معرف_قيمة_مسير
): فراغ {
    إذا ((القيمة.القيمة مثل طبيعي) < (الطول(*المطلوب) مثل طبيعي)) {
        (*المطلوب)[القيمة.القيمة] := صواب;
    };
}

عرف اجمع_تبعيات_وقت_الترجمة(
    العملية: &عملية_مسير,
    المطلوب: &متغير متجه منطقي
): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> { أرجع صواب; }
    | عملية_مسير.حساب_صحيح(ح) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليسار);
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليمين);
    }
    | عملية_مسير.مقارنة_صحيح(ح) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليسار);
        علم_تابعا_لوقت_الترجمة(المطلوب, ح.اليمين);
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, التحويل.المصدر);
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        علم_تابعا_لوقت_الترجمة(المطلوب, التحويل.المصدر);
    }
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التهيئة.العناصر) مثل طبيعي)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, التهيئة.العناصر[ف]);
            ف := ف + 1;
        }
    }
    | عملية_مسير.تجميع(التجميع) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(التجميع.الأعضاء) مثل طبيعي)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, التجميع.الأعضاء[ف]);
            ف := ف + 1;
        }
    }
    // A function used as a value with nothing captured is that function.
    | عملية_مسير.بناء_إغلاق(البناء) -> {
        أرجع (الطول(البناء.الالتقاطات) مثل طبيعي) == 0;
    }
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(_) -> { }
        | _ -> { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(النداء.الحجج) مثل طبيعي)) {
            علم_تابعا_لوقت_الترجمة(المطلوب, النداء.الحجج[ف]);
            ف := ف + 1;
        }
    }
    | _ -> { أرجع خطأ; };
    أرجع صواب;
}

عرف ثابت_إلى_قيمة_وقت_ترجمة(الثابت: &ثابت_مسير): اختياري قيمة_تشغيل {
    طابق *الثابت مع
    | ثابت_مسير.منطق(قيمة) -> { أرجع اختياري.موجود(قيمة_تشغيل.منطق(قيمة)); }
    | ثابت_مسير.صحيح_موقع(قيمة) -> { أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(قيمة مثل طبيعي)); }
    | ثابت_مسير.صحيح_طبيعي(قيمة) -> { أرجع اختياري.موجود(قيمة_تشغيل.بتات_عدد(قيمة)); }
    | ثابت_مسير.نص(قيمة) -> { أرجع اختياري.موجود(قيمة_تشغيل.نص(انسخ_بايتات(&قيمة))); }
    | ثابت_مسير.مؤشر_فارغ -> { أرجع اختياري.موجود(قيمة_تشغيل.مؤشر_فارغ()); }
    | ثابت_مسير.دالة(قيمة) -> { أرجع اختياري.موجود(قيمة_تشغيل.دالة(قيمة)); }
    | ثابت_مسير.متجه(القيم) -> {
        دع الأعضاء: متغير متجه قيمة_تشغيل = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            طابق ثابت_إلى_قيمة_وقت_ترجمة(&القيم[ف]) مع
            | اختياري.موجود(العنصر) -> { ألحق(الأعضاء, العنصر); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        أرجع اختياري.موجود(قيمة_تشغيل.تجميع(الأعضاء));
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_إلى_ثابت_وقت_ترجمة(
    القيمة: &قيمة_تشغيل,
    النوع: معرف_نوع,
    الأنواع: &سجل_أنواع
): اختياري ثابت_مسير {
    طابق *القيمة مع
    | قيمة_تشغيل.منطق(قيمة) -> { أرجع اختياري.موجود(ثابت_مسير.منطق(قيمة)); }
    | قيمة_تشغيل.محرف(قيمة) -> { أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(قيمة مثل طبيعي)); }
    | قيمة_تشغيل.نص(قيمة) -> { أرجع اختياري.موجود(ثابت_مسير.نص(انسخ_بايتات(&قيمة))); }
    | قيمة_تشغيل.مؤشر_فارغ -> { أرجع اختياري.موجود(ثابت_مسير.مؤشر_فارغ()); }
    | قيمة_تشغيل.دالة(معرف) -> { أرجع اختياري.موجود(ثابت_مسير.دالة(معرف)); }
    | قيمة_تشغيل.تجميع(العناصر) -> {
        دع نوع_العنصر: معرف_نوع;
        طابق نوع_عنصر_متجه_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(المعرف) -> { نوع_العنصر := المعرف; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع الثوابت: متغير متجه ثابت_مسير = [];
        دع موضع_العنصر: متغير طبيعي = 0;
        طالما (موضع_العنصر < (الطول(العناصر) مثل طبيعي)) {
            طابق قيمة_إلى_ثابت_وقت_ترجمة(&العناصر[موضع_العنصر], نوع_العنصر, الأنواع) مع
            | اختياري.موجود(ثابت) -> { ألحق(الثوابت, ثابت); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            موضع_العنصر := موضع_العنصر + 1;
        }
        أرجع اختياري.موجود(ثابت_مسير.متجه(الثوابت));
    }
    | قيمة_تشغيل.بتات_عدد(الخام) -> {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(مرجع_النوع_1) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_1.القيمة] مع
            | نوع_مقنن.بدائي(البدائي) -> {
            دع العرض: طبيعي = بتات_نوع_بدائي(البدائي);
            دع القناع: متغير طبيعي = ((9223372036854775807 مثل طبيعي) << 1) | 1;
            إذا (العرض < 64) {
                القناع := ((1 مثل طبيعي) << العرض) - 1;
            };
            دع القيمة_المحدودة: طبيعي = الخام & القناع;
            طابق صنف_النوع_البدائي(البدائي) مع
            | صنف_نوع_بدائي.عدد_موقع -> {
                دع الإشارة: طبيعي = (1 مثل طبيعي) << (العرض - 1);
                دع الممددة: متغير طبيعي = القيمة_المحدودة;
                إذا ((القيمة_المحدودة & الإشارة) != 0) {
                    الممددة := القيمة_المحدودة | (~القناع);
                };
                أرجع اختياري.موجود(ثابت_مسير.صحيح_موقع(الممددة مثل عدد));
            }
            | صنف_نوع_بدائي.عدد_صحيح_طبيعي -> {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(القيمة_المحدودة));
            }
            | صنف_نوع_بدائي.حرف -> {
                أرجع اختياري.موجود(ثابت_مسير.صحيح_طبيعي(القيمة_المحدودة));
            }
            | _ -> { أرجع اختياري.لا_شيء(); };
        }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// Why compile-time work was rejected: a stable reason for the
// nonconstant-expression diagnostic, or the message of a compile-time failure
// the program requested (بدائي_فشل_وقت_الترجمة).
عام نوع رفض_وقت_الترجمة =
    | سبب بنوع سبب_تشخيص
    | فشل_مطلوب بنوع متجه ط8
    // std.fmt's compile-time check rejected a literal format string: the
    // checker's packed result and the literal's source, start and end bytes.
    | تنسيق بنوع (ط64, طبيعي, طبيعي, طبيعي)
    // A failure inside the evaluation with its site, the call chain to it
    // and the instructions spent, and the instruction budget it ran with.
    | مفصل بنوع (سبب_تشخيص, فشل_تفسير_موضعي, طبيعي)
;

// The instruction budget of one compile-time evaluation: --comptime-budget,
// or $SULTANC_COMPTIME_BUDGET, which the CLI reads (المطلوبة > 0), else ten
// million. A block can raise its own (std.meta.comptime_budget).
عرف ميزانية_وقت_الترجمة_افتراضية(): طبيعي { أرجع 10000000; }

عام عرف ميزانية_وقت_الترجمة_الفعلية(المطلوبة: طبيعي): طبيعي {
    إذا (المطلوبة > 0) { أرجع المطلوبة; };
    أرجع ميزانية_وقت_الترجمة_افتراضية();
}

عرف رفض_بسبب(السبب: سبب_تشخيص): رفض_وقت_الترجمة {
    أرجع رفض_وقت_الترجمة.سبب(السبب);
}

// The interpreter owns failure identity; the driver translates it into
// stable compile-time diagnostic reasons instead of hiding all CTFE failures
// behind the same nonconstant-expression message.
نوع نتيجة_نداء_مسبق =
    | ثابت بنوع ثابت_مسير
    | مرفوض بنوع رفض_وقت_الترجمة
;

عرف سبب_فشل_نداء_مسبق(الفشل: &فشل_تفسير_مسير): رفض_وقت_الترجمة {
    طابق *الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(خطأ_التنفيذ) -> {
        طابق خطأ_التنفيذ مع
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_فشل_مطلوب(الرسالة) -> {
            أرجع رفض_وقت_الترجمة.فشل_مطلوب(انسخ_بايتات(&الرسالة));
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع رفض_بسبب(نص_سبب_فشل_نداء_مسبق(الفشل));
}

// The reason of a failure, with where it happened when there is a reason.
عرف رفض_فشل_موضعي(الفشل: فشل_تفسير_موضعي, الحد: طبيعي): رفض_وقت_الترجمة {
    دع الأساسي: رفض_وقت_الترجمة = سبب_فشل_نداء_مسبق(&الفشل.الفشل);
    طابق الأساسي مع
    | رفض_وقت_الترجمة.سبب(السبب) -> { أرجع رفض_وقت_الترجمة.مفصل(السبب, الفشل, الحد); }
    | _ -> { أرجع الأساسي; };
}

عرف نص_سبب_فشل_نداء_مسبق(الفشل: &فشل_تفسير_مسير): سبب_تشخيص {
    طابق *الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_الحد -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_نفاد_ميزانية_التعليمات(); }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_تجاوز_عمق_النداء -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_نفاد_عمق_الاستدعاء(); }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_أثر_ممنوع -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_أثر_ممنوع(); }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_حجة_غير_ثابتة -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_مغلقة(); }
        | خطأ_وقت_تشغيل_مفسر.وقت_الترجمة_نتيجة_غير_ثابتة -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_نتيجة_غير_مغلقة(); }
        | _ -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_فشل_التنفيذ(); };
    }
    | فشل_تفسير_مسير.فخ_مسير(_, _) -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_فخ_التنفيذ(); }
    | فشل_تفسير_مسير.خلل_داخلي(_) -> { أرجع سبب_تشخيص.سبب_وقت_الترجمة_خلل_المفسر(); };
}

// The call must have known, closed SSA operands. The interpreter additionally
// checks all reachable effects and instruction/recursion budgets.
عرف نفذ_نداء_وقت_الترجمة(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    النداء: &نداء_مسير,
    الجدول: &متجه اختياري ثابت_مسير,
    نوع_الناتج: معرف_نوع,
    الميزانية: طبيعي
): نتيجة_نداء_مسبق {
    دع الدالة: معرف_دالة_مسير;
    طابق (*النداء).الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الدالة := المعرف; }
    | _ -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_مستدعى_غير_مدعوم())); };
    دع الحجج: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النداء).الحجج) مثل طبيعي)) {
        دع المعرف: معرف_قيمة_مسير = (*النداء).الحجج[ف];
        إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)) {
            أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة()));
        };
        طابق (*الجدول)[المعرف.القيمة] مع
        | اختياري.موجود(الثابت) -> {
            طابق ثابت_إلى_قيمة_وقت_ترجمة(&الثابت) مع
            | اختياري.موجود(القيمة) -> { ألحق(الحجج, القيمة); }
            | اختياري.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة())); };
        }
        | اختياري.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة())); };
        ف := ف + 1;
    }
    طابق فسر_وقت_الترجمة_مسير(
        البرنامج, الأنواع, الهدف, الدالة, الحجج, الميزانية, 128
    ) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(الناتج) -> {
            طابق الناتج مع
            | اختياري.موجود(القيمة) -> {
                طابق قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع) مع
                | اختياري.موجود(الثابت) -> { أرجع نتيجة_نداء_مسبق.ثابت(الثابت); }
                | اختياري.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_غير_قابل_للتمثيل())); };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_مفقود())); };
        }
        | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
            أرجع نتيجة_نداء_مسبق.مرفوض(رفض_فشل_موضعي(الفشل, الميزانية));
        }
        | نتيجة_تفسير_مسير.هدف_غير_متوافق -> {
            أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_هدف_غير_معروف()));
        }
        | _ -> { أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_فشل_التنفيذ())); };
    }
    | نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(_) -> {
        أرجع نتيجة_نداء_مسبق.مرفوض(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_مسير_غير_صالح()));
    };
}

// A non-call MSIR expression is evaluated by the same interpreter. Construct
// a temporary, verified one-operation MSIR function with its already-known
// operands, rather than reimplementing integer arithmetic or comparisons in
// the driver. The original program and all its canonical identities survive
// unchanged. This path is only needed for explicit comptime expressions.
عرف نفذ_عملية_ثابتة_وقت_الترجمة(
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير,
    الجدول: &متجه اختياري ثابت_مسير,
    الدالة_المصدر: &دالة_مسير,
    نوع_الناتج: معرف_نوع,
    الميزانية: طبيعي
): اختياري ثابت_مسير {
    دع المصدر_الأول: معرف_قيمة_مسير;
    دع المصدر_الثاني: معرف_قيمة_مسير;
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        المصدر_الأول := الحساب.اليسار;
        المصدر_الثاني := الحساب.اليمين;
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        المصدر_الأول := المقارنة.اليسار;
        المصدر_الثاني := المقارنة.اليمين;
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        المصدر_الأول := التحويل.المصدر;
        المصدر_الثاني := التحويل.المصدر;
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        المصدر_الأول := التحويل.المصدر;
        المصدر_الثاني := التحويل.المصدر;
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    إذا ((المصدر_الأول.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)
        || (المصدر_الثاني.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع ثابت_الأول: ثابت_مسير;
    دع ثابت_الثاني: ثابت_مسير;
    طابق (*الجدول)[المصدر_الأول.القيمة] مع
    | اختياري.موجود(قيمة) -> { ثابت_الأول := قيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق (*الجدول)[المصدر_الثاني.القيمة] مع
    | اختياري.موجود(قيمة) -> { ثابت_الثاني := قيمة; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    // Isolated, canonical MSIR program: never clone the whole compiler IR for
    // a constant arithmetic operation. The shared interpreter verifies it.
    دع المؤقت: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع بلا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(
        &متغير المؤقت, &بلا_معاملات, اختياري.موجود(نوع_الناتج)
    );
    دع الكتلة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(&متغير المؤقت, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { الكتلة := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع النوع_الأول: معرف_نوع = (*الدالة_المصدر).القيم[المصدر_الأول.القيمة].النوع;
    دع النوع_الثاني: معرف_نوع = (*الدالة_المصدر).القيم[المصدر_الثاني.القيمة].النوع;
    دع الأول: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        &متغير المؤقت, &البناء, الدالة, الكتلة,
        انسخ_ثابت_مسير(&ثابت_الأول), النوع_الأول
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الأول := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الثاني: معرف_قيمة_مسير;
    طابق أصدر_ثابتا_مسير(
        &متغير المؤقت, &البناء, الدالة, الكتلة,
        انسخ_ثابت_مسير(&ثابت_الثاني), النوع_الثاني
    ) مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الثاني := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الناتج: معرف_قيمة_مسير;
    دع الناتج_العملية: نتيجة_بناء_قيمة_مسير;
    طابق *العملية مع
    | عملية_مسير.حساب_صحيح(الحساب) -> {
        الناتج_العملية := أصدر_حسابا_صحيحا_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            الحساب.العملية, الأول, الثاني, نوع_الناتج
        );
    }
    | عملية_مسير.مقارنة_صحيح(المقارنة) -> {
        الناتج_العملية := أصدر_مقارنة_صحيح_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            المقارنة.العملية, الأول, الثاني, نوع_الناتج
        );
    }
    | عملية_مسير.تحويل_صحيح(التحويل) -> {
        الناتج_العملية := أصدر_تحويل_صحيح_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            التحويل.العملية, الأول, نوع_الناتج
        );
    }
    | عملية_مسير.تحويل_عائم(التحويل) -> {
        الناتج_العملية := أصدر_تحويل_عائم_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة,
            التحويل.العملية, الأول, نوع_الناتج
        );
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق الناتج_العملية مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { الناتج := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق اختم_بإرجاع_مسير(&متغير المؤقت, الدالة, الكتلة, اختياري.موجود(الناتج)) مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الحجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(المؤقت, الأنواع, الهدف, الدالة, الحجج, الميزانية, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(الناتج_المفسر) -> {
            طابق الناتج_المفسر مع
            | اختياري.موجود(القيمة) -> {
                أرجع قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع);
            }
            | _ -> { };
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// Execute a closed aggregate construction with the same verified MSIR
// interpreter used for ordinary comptime calls. Rebuild only the independent
// instruction slice; never copy the entire lowered program.
عرف نفذ_تجميع_ثابت_وقت_الترجمة(
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير,
    الجدول: &متجه اختياري ثابت_مسير,
    الدالة_المصدر: &دالة_مسير,
    نوع_الناتج: معرف_نوع,
    الميزانية: طبيعي
): اختياري ثابت_مسير {
    دع أعضاء_المصدر: متغير متجه معرف_قيمة_مسير = [];
    دع متجه_مملوك: منطقي;
    طابق *العملية مع
    | عملية_مسير.تهيئة_متجه(التهيئة) -> {
        متجه_مملوك := صواب;
        دع موضع: متغير طبيعي = 0;
        طالما (موضع < (الطول(التهيئة.العناصر) مثل طبيعي)) {
            ألحق(أعضاء_المصدر, التهيئة.العناصر[موضع]);
            موضع := موضع + 1;
        }
    }
    | عملية_مسير.تجميع(التجميع) -> {
        متجه_مملوك := خطأ;
        دع موضع: متغير طبيعي = 0;
        طالما (موضع < (الطول(التجميع.الأعضاء) مثل طبيعي)) {
            ألحق(أعضاء_المصدر, التجميع.الأعضاء[موضع]);
            موضع := موضع + 1;
        }
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع المؤقت: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع المعاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(
        &متغير المؤقت, &المعاملات, اختياري.موجود(نوع_الناتج)
    );
    دع الكتلة: معرف_كتلة_مسير;
    طابق أضف_كتلة_مسير(&متغير المؤقت, الدالة) مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { الكتلة := المعرف; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع الأعضاء: متغير متجه معرف_قيمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أعضاء_المصدر) مثل طبيعي)) {
        دع المعرف: معرف_قيمة_مسير = أعضاء_المصدر[ف];
        إذا ((المعرف.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)
            || (المعرف.القيمة مثل طبيعي) >= (الطول((*الدالة_المصدر).القيم) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        دع الثابت: ثابت_مسير;
        طابق (*الجدول)[المعرف.القيمة] مع
        | اختياري.موجود(القيمة) -> { الثابت := انسخ_ثابت_مسير(&القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        دع المضاف: معرف_قيمة_مسير;
        طابق أصدر_ثابتا_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, الثابت,
            (*الدالة_المصدر).القيم[المعرف.القيمة].النوع
        ) مع
        | نتيجة_بناء_قيمة_مسير.مبنية(الهوية) -> { المضاف := الهوية; }
        | _ -> { أرجع اختياري.لا_شيء(); };
        ألحق(الأعضاء, المضاف);
        ف := ف + 1;
    }
    دع العملية_المضافة: نتيجة_بناء_قيمة_مسير;
    إذا (متجه_مملوك) {
        العملية_المضافة := أصدر_تهيئة_متجه_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, &الأعضاء, نوع_الناتج
        );
    } وإلا {
        العملية_المضافة := أصدر_تجميع_مسير(
            &متغير المؤقت, &البناء, الدالة, الكتلة, &الأعضاء, نوع_الناتج
        );
    };
    دع الناتج: معرف_قيمة_مسير;
    طابق العملية_المضافة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(الهوية) -> { الناتج := الهوية; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق اختم_بإرجاع_مسير(&متغير المؤقت, الدالة, الكتلة, اختياري.موجود(الناتج)) مع
    | نتيجة_بناء_منهي_مسير.مبني -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الحجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(المؤقت, الأنواع, الهدف, الدالة, الحجج, الميزانية, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(اختياري.موجود(القيمة)) -> {
            أرجع قيمة_إلى_ثابت_وقت_ترجمة(&القيمة, نوع_الناتج, الأنواع);
        }
        | _ -> { };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// Statement-form comptime is an isolated, void MSIR function. Execute it
// through the same verified interpreter with the same bounded effect policy.
// It has no runtime operands and cannot capture the caller's local storage.
عرف نفذ_عبارة_وقت_الترجمة(
    البرنامج: برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    العملية: &عملية_مسير,
    الميزانية: طبيعي
): اختياري رفض_وقت_الترجمة {
    دع الدالة: معرف_دالة_مسير;
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        إذا ((الطول(النداء.الحجج) مثل طبيعي) != 0) {
            أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة()));
        };
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الدالة := المعرف; }
        | _ -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_مستدعى_غير_مدعوم())); };
    }
    | _ -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة())); };
    دع بلا_حجج: متجه قيمة_تشغيل = [];
    طابق فسر_وقت_الترجمة_مسير(البرنامج, الأنواع, الهدف, الدالة, بلا_حجج, الميزانية, 128) مع
    | نتيجة_تقييم_وقت_الترجمة_مسير.مسير_غير_صالح(_) -> {
        أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_مسير_غير_صالح()));
    }
    | نتيجة_تقييم_وقت_الترجمة_مسير.منفذ(النتيجة) -> {
        طابق النتيجة مع
        | نتيجة_تفسير_مسير.نجح(اختياري.لا_شيء) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
            أرجع اختياري.موجود(رفض_فشل_موضعي(الفشل, الميزانية));
        }
        | نتيجة_تفسير_مسير.هدف_غير_متوافق -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_هدف_غير_معروف())); }
        | _ -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_غير_متوقع())); };
    };
}

// Remove only a successfully executed, value-less comptime marker. Value IDs
// and block identities remain unchanged; no runtime consumer sees this call.
عرف أزل_عبارة_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الدالة: طبيعي,
    الكتلة: طبيعي,
    الفهرس: طبيعي
): فراغ {
    دع الجديدة: متغير متجه تعليمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي)) {
        إذا (ف != الفهرس) {
            // Move the instruction's owned payload without copying it.
            دع المنقول: متغير تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(
                اختياري.لا_شيء(), عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ))
            );
            بدّل((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[ف], المنقول);
            ألحق(الجديدة, المنقول);
        };
        ف := ف + 1;
    }
    (*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات := الجديدة;
}

// The dependency slice of الجذور inside block ك, up to and including
// instruction النهاية, evaluated through the shared interpreter. Every
// evaluated instruction is rewritten into its constant (value IDs and block
// identities are unchanged). A dependency on a parameter, a block argument, an
// unsupported operation or a prohibited effect rejects the slice.
عرف عملية_حسابية_بحتة_وقت_الترجمة(العملية: &عملية_مسير): منطقي {
    طابق *العملية مع
    | عملية_مسير.ثابت(_) -> { أرجع صواب; }
    | عملية_مسير.حساب_صحيح(_) -> { أرجع صواب; }
    | عملية_مسير.مقارنة_صحيح(_) -> { أرجع صواب; }
    | عملية_مسير.تحويل_صحيح(_) -> { أرجع صواب; }
    | عملية_مسير.تحويل_عائم(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Constants of a whole function: every value a constant instruction defines,
// and every block parameter that all incoming edges (of reachable blocks
// when المزارة is given) pass the same known constant. SSA values have one
// definition, so such a value is that constant wherever it is used: a
// specialized copy's compile-time parameter, defined in the entry block, is
// known in every later block.
عرف ثوابت_دالة_وقت_الترجمة(
    الدالة: &دالة_مسير,
    المزارة: &متجه منطقي
): متجه اختياري ثابت_مسير {
    دع الجدول: متغير متجه اختياري ثابت_مسير = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < (*الدالة).القيمة_التالية) {
        ألحق(الجدول, اختياري.لا_شيء());
        ح := ح + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع التعليمة: &تعليمة_مسير = &(*الدالة).الكتل[ك].التعليمات[ع];
            طابق قيمة_ناتج_تعليمة_مسير(الدالة, التعليمة) مع
            | اختياري.موجود(القيمة) -> {
                طابق (*التعليمة).العملية مع
                | عملية_مسير.ثابت(الثابت) -> {
                    إذا ((القيمة.المعرف.القيمة مثل طبيعي) < (الطول(الجدول) مثل طبيعي)) {
                        الجدول[القيمة.المعرف.القيمة] := اختياري.موجود(انسخ_ثابت_مسير(&الثابت));
                    };
                }
                | _ -> { };
            }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        ك := ك + 1;
    }
    // Block parameters, to a fixpoint (each round settles at least one more
    // parameter or stops).
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        ك := 0;
        طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول((*الدالة).الكتل[ك].المعاملات) مثل طبيعي)) {
                دع المعامل: معرف_قيمة_مسير = (*الدالة).الكتل[ك].المعاملات[م].المعرف;
                إذا ((المعامل.القيمة مثل طبيعي) < (الطول(الجدول) مثل طبيعي)) {
                    طابق الجدول[المعامل.القيمة] مع
                    | اختياري.موجود(_) -> { }
                    | اختياري.لا_شيء -> {
                        طابق ثابت_معامل_كتلة_وقت_الترجمة(الدالة, المزارة, (*الدالة).الكتل[ك].المعرف, م, &الجدول) مع
                        | اختياري.موجود(الثابت) -> {
                            الجدول[المعامل.القيمة] := اختياري.موجود(الثابت);
                            تغير := صواب;
                        }
                        | اختياري.لا_شيء -> { };
                    };
                };
                م := م + 1;
            }
            ك := ك + 1;
        }
    }
    أرجع الجدول;
}

// The constant every incoming edge passes for parameter م of block الهدف.
عرف ثابت_معامل_كتلة_وقت_الترجمة(
    الدالة: &دالة_مسير,
    المزارة: &متجه منطقي,
    الهدف: معرف_كتلة_مسير,
    م: طبيعي,
    الجدول: &متجه اختياري ثابت_مسير
): اختياري ثابت_مسير {
    دع الحواف: متغير متجه حافة_مسير = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع مزارة: منطقي = ك >= (الطول(*المزارة) مثل طبيعي) || (*المزارة)[ك];
        إذا (مزارة) {
            طابق (*الدالة).الكتل[ك].المنهي مع
            | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> { ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الحافة)); }
            | اختياري.موجود(منهي_مسير.فرع_شرطي(_, الأولى, الثانية)) -> {
                ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الأولى));
                ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الثانية));
            }
            | اختياري.موجود(منهي_مسير.فرع_متعدد(الفرع)) -> {
                ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الافتراضي));
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(الفرع.الحالات) مثل طبيعي)) {
                    ألحق(الحواف, انسخ_مملوكا_حافة_مسير(&الفرع.الحالات[ف].الحافة));
                    ف := ف + 1;
                }
            }
            | _ -> { };
        };
        ك := ك + 1;
    }
    دع المرشح: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
    دع وجد: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحواف) مثل طبيعي)) {
        إذا (كتلتان_مسير_متساويتان(الحواف[ف].الهدف, الهدف)) {
            إذا (م >= (الطول(الحواف[ف].الحجج) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            دع الحجة: معرف_قيمة_مسير = الحواف[ف].الحجج[م];
            إذا ((الحجة.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
            طابق (*الجدول)[الحجة.القيمة] مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الثابت) -> {
                إذا (!وجد) {
                    وجد := صواب;
                    المرشح := اختياري.موجود(انسخ_ثابت_مسير(&الثابت));
                } وإلا {
                    دع مرجع_المرشح: &اختياري ثابت_مسير = &المرشح;
                    طابق *مرجع_المرشح مع
                    | اختياري.موجود(السابق) -> {
                        إذا (!ثابتا_مسير_متساويان(&السابق, &الثابت)) { أرجع اختياري.لا_شيء(); };
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
        };
        ف := ف + 1;
    }
    أرجع المرشح;
}

// A slice root may depend on values another block defines (a specialized
// copy's compile-time parameters live in its entry block). Those that are
// constants of the function are seeded into the slice's table; the rest stay
// unknown and reject the slice as before.
عرف ابذر_ثوابت_خارج_شريحة_وقت_الترجمة(
    الدالة: &دالة_مسير,
    ك: طبيعي,
    النهاية: طبيعي,
    المطلوب: &متجه منطقي,
    الجدول: &متغير متجه اختياري ثابت_مسير,
    المزارة: &متجه منطقي
): فراغ {
    دع داخلية: متغير متجه منطقي = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < (الطول(*المطلوب) مثل طبيعي)) {
        ألحق(داخلية, خطأ);
        ح := ح + 1;
    }
    دع ع: متغير طبيعي = 0;
    طالما (ع <= النهاية && ع < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
        طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ع]) مع
        | اختياري.موجود(القيمة) -> {
            إذا ((القيمة.المعرف.القيمة مثل طبيعي) < (الطول(داخلية) مثل طبيعي)) {
                داخلية[القيمة.المعرف.القيمة] := صواب;
            };
        }
        | اختياري.لا_شيء -> { };
        ع := ع + 1;
    }
    دع ناقصة: متغير منطقي = خطأ;
    ح := 0;
    طالما (ح < (الطول(*المطلوب) مثل طبيعي)) {
        إذا ((*المطلوب)[ح] && !داخلية[ح]) { ناقصة := صواب; };
        ح := ح + 1;
    }
    إذا (!ناقصة) { أرجع; };
    دع الثوابت: متجه اختياري ثابت_مسير = ثوابت_دالة_وقت_الترجمة(الدالة, المزارة);
    ح := 0;
    طالما (ح < (الطول(*المطلوب) مثل طبيعي) && ح < (الطول(الثوابت) مثل طبيعي) && ح < (الطول(*الجدول) مثل طبيعي)) {
        إذا ((*المطلوب)[ح] && !داخلية[ح]) {
            طابق الثوابت[ح] مع
            | اختياري.موجود(الثابت) -> { (*الجدول)[ح] := اختياري.موجود(انسخ_ثابت_مسير(&الثابت)); }
            | اختياري.لا_شيء -> { };
        };
        ح := ح + 1;
    }
}

نوع نتيجة_شريحة_وقت_الترجمة =
    | محلولة بنوع متجه اختياري ثابت_مسير
    | مرفوضة بنوع رفض_وقت_الترجمة
;

عرف حل_شريحة_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    النهاية: طبيعي,
    الجذور: &متجه معرف_قيمة_مسير,
    الميزانية: طبيعي
): نتيجة_شريحة_وقت_الترجمة {
    دع الكل_مزار: متجه منطقي = [];
    أرجع حل_شريحة_وقت_الترجمة_بنمط(البرنامج, الأنواع, الهدف, د, ك, النهاية, الجذور, خطأ, &الكل_مزار, الميزانية);
}

// بلا_نداءات: only constants, integer arithmetic, comparisons and casts may
// be evaluated (the branch folding of specialized copies); a slice needing a
// call or an aggregate is rejected without executing anything. المزارة, when
// not empty, limits the constants seeded from other blocks to edges of
// reachable blocks.
عرف حل_شريحة_وقت_الترجمة_بنمط(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    النهاية: طبيعي,
    الجذور: &متجه معرف_قيمة_مسير,
    بلا_نداءات: منطقي,
    المزارة: &متجه منطقي,
    الميزانية: طبيعي
): نتيجة_شريحة_وقت_الترجمة {
    دع المطلوب: متغير متجه منطقي = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < ((*البرنامج).الدوال[د].القيمة_التالية)) {
        ألحق(المطلوب, خطأ);
        ح := ح + 1;
    }
    ح := 0;
    طالما (ح < (الطول(*الجذور) مثل طبيعي)) {
        علم_تابعا_لوقت_الترجمة(&متغير المطلوب, (*الجذور)[ح]);
        ح := ح + 1;
    }
    دع ع: متغير طبيعي = النهاية + 1;
    طالما (ع > 0) {
        ع := ع - 1;
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع];
        طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], التعليمة) مع
        | اختياري.موجود(القيمة) -> {
            إذا (المطلوب[القيمة.المعرف.القيمة]) {
                إذا (بلا_نداءات && !عملية_حسابية_بحتة_وقت_الترجمة(&(*التعليمة).العملية)) {
                    أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة()));
                };
                إذا (!اجمع_تبعيات_وقت_الترجمة(&(*التعليمة).العملية, &متغير المطلوب)) {
                    أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة()));
                };
            };
        }
        | اختياري.لا_شيء -> { };
    }
    دع الجدول: متغير متجه اختياري ثابت_مسير = [];
    ح := 0;
    طالما (ح < ((*البرنامج).الدوال[د].القيمة_التالية)) {
        ألحق(الجدول, اختياري.لا_شيء());
        ح := ح + 1;
    }
    ابذر_ثوابت_خارج_شريحة_وقت_الترجمة(&(*البرنامج).الدوال[د], ك, النهاية, &المطلوب, &متغير الجدول, المزارة);
    ع := 0;
    طالما (ع <= النهاية) {
        دع التعليمة: &تعليمة_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع];
        طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], التعليمة) مع
        | اختياري.موجود(القيمة) -> {
            إذا (المطلوب[القيمة.المعرف.القيمة]) {
                دع الثابت: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
                طابق (*التعليمة).العملية مع
                | عملية_مسير.ثابت(القيمة_الثابتة) -> {
                    الثابت := اختياري.موجود(انسخ_مملوكا_ثابت_مسير(&القيمة_الثابتة));
                }
                | عملية_مسير.بناء_إغلاق(البناء) -> {
                    إذا ((الطول(البناء.الالتقاطات) مثل طبيعي) == 0) {
                        الثابت := اختياري.موجود(ثابت_مسير.دالة(البناء.الدالة));
                    };
                }
                | عملية_مسير.تهيئة_متجه(_) -> {
                    الثابت := نفذ_تجميع_ثابت_وقت_الترجمة(
                        الأنواع, الهدف, &(*التعليمة).العملية,
                        &الجدول, &(*البرنامج).الدوال[د], القيمة.النوع, الميزانية
                    );
                }
                | عملية_مسير.تجميع(_) -> {
                    الثابت := نفذ_تجميع_ثابت_وقت_الترجمة(
                        الأنواع, الهدف, &(*التعليمة).العملية,
                        &الجدول, &(*البرنامج).الدوال[د], القيمة.النوع, الميزانية
                    );
                }
                | عملية_مسير.نداء(النداء) -> {
                    طابق نفذ_نداء_وقت_الترجمة(
                        انسخ_مملوكا_برنامج_مسير(البرنامج), الأنواع, الهدف, &النداء, &الجدول, القيمة.النوع, الميزانية
                    ) مع
                    | نتيجة_نداء_مسبق.ثابت(معروف) -> { الثابت := اختياري.موجود(معروف); }
                    | نتيجة_نداء_مسبق.مرفوض(السبب) -> {
                        أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب);
                    };
                }
                | _ -> {
                    الثابت := نفذ_عملية_ثابتة_وقت_الترجمة(
                        الأنواع, الهدف,
                        &(*التعليمة).العملية, &الجدول,
                        &(*البرنامج).الدوال[د], القيمة.النوع, الميزانية
                    );
                };
                طابق الثابت مع
                | اختياري.موجود(معروف) -> {
                    الجدول[القيمة.المعرف.القيمة] := اختياري.موجود(انسخ_ثابت_مسير(&معروف));
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع].العملية := عملية_مسير.ثابت(معروف);
                }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_قيمة_غير_ثابتة_أو_أثر_ممنوع()));
                };
            };
        }
        | اختياري.لا_شيء -> { };
        ع := ع + 1;
    }
    // A root no instruction of the slice defined (a parameter or block
    // argument) is not compile-time known.
    ح := 0;
    طالما (ح < (الطول(*الجذور) مثل طبيعي)) {
        دع الجذر: معرف_قيمة_مسير = (*الجذور)[ح];
        إذا ((الجذر.القيمة مثل طبيعي) >= (الطول(الجدول) مثل طبيعي)) {
            أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة()));
        };
        طابق الجدول[الجذر.القيمة] مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            أرجع نتيجة_شريحة_وقت_الترجمة.مرفوضة(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة()));
        };
        ح := ح + 1;
    }
    أرجع نتيجة_شريحة_وقت_الترجمة.محلولة(الجدول);
}

// Compile-time parameters (CT-01). A function with any `comptime` parameter
// is a template: it is never called at runtime with those arguments.
// - Every parameter compile-time: the call is evaluated entirely at compile
//   time (the existing CTFE path).
// - Mixed parameters: the compile-time arguments must be compile-time known;
//   the call is redirected to a specialized copy of the function in which each
//   compile-time parameter is the known value (a constant, or a capture-free
//   function value) and only the runtime parameters remain. Specializations
//   are shared per (function, compile-time arguments): each distinct set of
//   compile-time arguments is instantiated once. The template body itself is not discharged: its
//   compile-time obligations depend on arguments it does not have.
// Previously every call to such a function had to be fully evaluated at
// compile time, so any runtime argument was rejected.
نوع ربط_معامل_وقت_الترجمة =
    | ثابت بنوع ثابت_مسير
    // The function and the environment destructor of its closure value.
    | دالة بنوع (معرف_دالة_مسير, اختياري معرف_دالة_مسير)
;

نوع تخصيص_وقت_الترجمة = {
    الأصل: طبيعي,
    الروابط: متجه ربط_معامل_وقت_الترجمة,
    المخصصة: طبيعي,
    التالي_بنفس_الهاش: اختياري طبيعي
};

// Bounds the specializations one compilation may create, so a template that
// recurses on a compile-time parameter without a compile-time base case is
// diagnosed instead of expanding forever.
عرف حد_تخصيصات_وقت_الترجمة(): طبيعي {
    أرجع 4096;
}

عرف دالة_قالب_وقت_الترجمة(الدالة: &دالة_مسير): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)) {
        إذا ((*الدالة).معاملات_وقت_الترجمة[ف]) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف كل_معاملات_الدالة_وقت_ترجمة(الدالة: &دالة_مسير): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الدالة).معاملات_وقت_الترجمة) مثل طبيعي)) {
        إذا (!(*الدالة).معاملات_وقت_الترجمة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ربطا_معامل_وقت_الترجمة_متساويان(
    أ: &ربط_معامل_وقت_الترجمة,
    ب: &ربط_معامل_وقت_الترجمة
): منطقي {
    طابق *أ مع
    | ربط_معامل_وقت_الترجمة.ثابت(ثابت_أ) -> {
        طابق *ب مع
        | ربط_معامل_وقت_الترجمة.ثابت(ثابت_ب) -> { أرجع ثابتا_مسير_متساويان(&ثابت_أ, &ثابت_ب); }
        | _ -> { أرجع خطأ; };
    }
    | ربط_معامل_وقت_الترجمة.دالة(دالة_أ, _) -> {
        طابق *ب مع
        | ربط_معامل_وقت_الترجمة.دالة(دالة_ب, _) -> { أرجع دالتا_مسير_متساويتان(دالة_أ, دالة_ب); }
        | _ -> { أرجع خطأ; };
    };
}

// Hash the same structural constant identity used by ثابتا_مسير_متساويان.
// Hashes only filter candidates; map equality resolves all collisions.
عرف هاش_ثابت_وقت_الترجمة(الثابت: &ثابت_مسير): طبيعي {
    دع هاش: متغير طبيعي = بذرة_هاش_مركب();
    طابق *الثابت مع
    | ثابت_مسير.منطق(القيمة) -> {
        هاش := ادمج_هاشا(هاش, 1);
        إذا (القيمة) { هاش := ادمج_هاشا(هاش, 1); };
    }
    | ثابت_مسير.صحيح_موقع(القيمة) -> {
        هاش := ادمج_هاشا(هاش, 2);
        هاش := ادمج_هاشا(هاش, القيمة مثل طبيعي);
    }
    | ثابت_مسير.صحيح_طبيعي(القيمة) -> {
        هاش := ادمج_هاشا(هاش, 3);
        هاش := ادمج_هاشا(هاش, القيمة);
    }
    | ثابت_مسير.مؤشر_فارغ -> { هاش := ادمج_هاشا(هاش, 4); }
    | ثابت_مسير.عشري(البايتات) -> {
        هاش := ادمج_هاشا(هاش, 5);
        هاش := ادمج_هاشا(هاش, الطول(البايتات) مثل طبيعي);
        هاش := ادمج_هاشا(هاش, هاش_فنڤ1أ_طبيعي_للبايتات(&البايتات));
    }
    | ثابت_مسير.نص(البايتات) -> {
        هاش := ادمج_هاشا(هاش, 6);
        هاش := ادمج_هاشا(هاش, الطول(البايتات) مثل طبيعي);
        هاش := ادمج_هاشا(هاش, هاش_فنڤ1أ_طبيعي_للبايتات(&البايتات));
    }
    | ثابت_مسير.متجه(العناصر) -> {
        هاش := ادمج_هاشا(هاش, 7);
        هاش := ادمج_هاشا(هاش, الطول(العناصر) مثل طبيعي);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            هاش := ادمج_هاشا(هاش, هاش_ثابت_وقت_الترجمة(&العناصر[ف]));
            ف := ف + 1;
        }
    }
    | ثابت_مسير.دالة(المعرف) -> {
        هاش := ادمج_هاشا(هاش, 8);
        هاش := ادمج_هاشا(هاش, المعرف.القيمة);
    };
    أرجع هاش;
}

عرف هاش_تخصيص_وقت_الترجمة(
    الأصل: طبيعي,
    الروابط: &متجه ربط_معامل_وقت_الترجمة
): طبيعي {
    دع هاش: متغير طبيعي = ادمج_هاشا(بذرة_هاش_مركب(), الأصل);
    هاش := ادمج_هاشا(هاش, الطول(*الروابط) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الروابط) مثل طبيعي)) {
        طابق (*الروابط)[ف] مع
        | ربط_معامل_وقت_الترجمة.ثابت(الثابت) -> {
            هاش := ادمج_هاشا(هاش, 1);
            هاش := ادمج_هاشا(هاش, هاش_ثابت_وقت_الترجمة(&الثابت));
        }
        | ربط_معامل_وقت_الترجمة.دالة(المعرف, _) -> {
            هاش := ادمج_هاشا(هاش, 2);
            هاش := ادمج_هاشا(هاش, المعرف.القيمة);
        };
        ف := ف + 1;
    }
    أرجع هاش;
}

// Canonical specialization records own their bindings exactly once. The map
// indexes only a deterministic structural hash; collisions chain by position
// and are resolved with the original full structural equality.
عرف ابحث_تخصيص_وقت_الترجمة(
    التخصيصات: &متجه تخصيص_وقت_الترجمة,
    الفهرس: &الخريطة<طبيعي, طبيعي>,
    الهاش: طبيعي,
    الأصل: طبيعي,
    الروابط: &متجه ربط_معامل_وقت_الترجمة
): اختياري طبيعي {
    دع الموضع: متغير اختياري طبيعي = ابحث_في_الخريطة(الفهرس, &الهاش);
    طالما (صواب) {
        طابق الموضع مع
        | اختياري.موجود(ف) -> {
            دع المسجل: &تخصيص_وقت_الترجمة = &(*التخصيصات)[ف];
            إذا ((*المسجل).الأصل == الأصل
                && (الطول((*المسجل).الروابط) مثل طبيعي) == (الطول(*الروابط) مثل طبيعي)) {
                دع متطابق: متغير منطقي = صواب;
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(*الروابط) مثل طبيعي)) {
                    إذا (!ربطا_معامل_وقت_الترجمة_متساويان(&(*المسجل).الروابط[م], &(*الروابط)[م])) {
                        متطابق := خطأ;
                    };
                    م := م + 1;
                }
                إذا (متطابق) { أرجع اختياري.موجود((*المسجل).المخصصة); };
            };
            الموضع := (*المسجل).التالي_بنفس_الهاش;
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.لا_شيء();
}

عرف هاش_عدد_تخصيص(القيمة: &طبيعي): طبيعي { أرجع *القيمة; }
عرف عددان_تخصيص_متساويان(أ: &طبيعي, ب: &طبيعي): منطقي { أرجع *أ == *ب; }

// The specialized copy: compile-time parameters become entry-block
// definitions of the same values, the copy is re-identified under its new
// MSIR function identity (msir_renumbering.sn), and it has only runtime
// parameters.
عرف أنشئ_تخصيص_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأصل: طبيعي,
    الروابط: &متجه ربط_معامل_وقت_الترجمة
): طبيعي {
    دع مرجع_الأصل: &دالة_مسير = &(*البرنامج).الدوال[الأصل];
    // The specialization starts as an independent copy of the generic body.
    دع النسخة: متغير دالة_مسير = انسخ_مملوكا_دالة_مسير(مرجع_الأصل);
    دع الجديد: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع فهرس_المدخل: متغير طبيعي = 0;
    طابق النسخة.المدخل مع
    | اختياري.موجود(المدخل) -> {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(النسخة.الكتل) مثل طبيعي)) {
            إذا (كتلتان_مسير_متساويتان(النسخة.الكتل[ك].المعرف, المدخل)) { فهرس_المدخل := ك; };
            ك := ك + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    دع المعاملات: متغير متجه قيمة_مسير = [];
    دع الأعلام: متغير متجه منطقي = [];
    دع التعريفات: متغير متجه تعليمة_مسير = [];
    دع ف: متغير طبيعي = 0;
    دع م: متغير طبيعي = 0;
    طالما (ف < (الطول(النسخة.المعاملات) مثل طبيعي)) {
        دع وقت_ترجمة: منطقي = ف < (الطول(النسخة.معاملات_وقت_الترجمة) مثل طبيعي)
            && النسخة.معاملات_وقت_الترجمة[ف];
        إذا (وقت_ترجمة && م < (الطول(*الروابط) مثل طبيعي)) {
            دع العملية: متغير عملية_مسير = عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ));
            طابق (*الروابط)[م] مع
            | ربط_معامل_وقت_الترجمة.ثابت(الثابت) -> {
                العملية := عملية_مسير.ثابت(انسخ_ثابت_مسير(&الثابت));
            }
            | ربط_معامل_وقت_الترجمة.دالة(الدالة, المدمر) -> {
                دع بلا_التقاطات: متجه معرف_قيمة_مسير = [];
                دع البناء: بناء_إغلاق_مسير = { الدالة: الدالة, الالتقاطات: بلا_التقاطات, المدمر: المدمر };
                العملية := عملية_مسير.بناء_إغلاق(البناء);
            };
            دع التعريف: تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(
                اختياري.موجود(النسخة.المعاملات[ف]), العملية
            );
            ألحق(التعريفات, التعريف);
            م := م + 1;
        } وإلا {
            ألحق(المعاملات, النسخة.المعاملات[ف]);
            ألحق(الأعلام, خطأ);
        };
        ف := ف + 1;
    }
    إذا (فهرس_المدخل < (الطول(النسخة.الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(النسخة.الكتل[فهرس_المدخل].التعليمات) مثل طبيعي)) {
            دع المنقولة: متغير تعليمة_مسير = تعليمة_مسير_بلا_تصحيح(
                اختياري.لا_شيء(), عملية_مسير.ثابت(ثابت_مسير.منطق(خطأ))
            );
            بدّل(النسخة.الكتل[فهرس_المدخل].التعليمات[ت], المنقولة);
            ألحق(التعريفات, المنقولة);
            ت := ت + 1;
        }
        النسخة.الكتل[فهرس_المدخل].التعليمات := التعريفات;
    };
    النسخة.المعاملات := المعاملات;
    النسخة.معاملات_وقت_الترجمة := الأعلام;
    النسخة.المعرف := معرف_دالة_مسير_من(الجديد);
    أعد_تعريف_دالة_مسير_بمعرفها(&متغير النسخة);
    ألحق((*البرنامج).الدوال, النسخة);
    أرجع الجديد;
}

// SSA ValueIDs are dense and canonical. Build a prefix-only definition index
// once, at the first mixed-template call in a block; later instructions update
// it as they are processed. A removed value-less marker cannot invalidate it.
عرف ابن_فهرس_تعريفات_وقت_الترجمة(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    ك: طبيعي,
    النهاية: طبيعي
): متجه اختياري طبيعي {
    دع الفهرس: متغير متجه اختياري طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*البرنامج).الدوال[د].القيمة_التالية) {
        ألحق(الفهرس, اختياري.لا_شيء());
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < النهاية) {
        طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ف]) مع
        | اختياري.موجود(القيمة) -> {
            إذا ((القيمة.المعرف.القيمة مثل طبيعي) < (الطول(الفهرس) مثل طبيعي)) {
                الفهرس[القيمة.المعرف.القيمة] := اختياري.موجود(ف);
            };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع الفهرس;
}

عرف عملية_تعريف_في_الكتلة(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    ك: طبيعي,
    ر: طبيعي,
    القيمة: معرف_قيمة_مسير,
    الفهرس: &متجه اختياري طبيعي
): اختياري عملية_مسير {
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*الفهرس) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*الفهرس)[القيمة.القيمة] مع
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع < ر) {
            دع مرجع_العملية: &عملية_مسير = &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[الموضع].العملية;
            أرجع اختياري.موجود(انسخ_مملوكا_عملية_مسير(مرجع_العملية));
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف خصص_نداء_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    ر: طبيعي,
    التخصيصات: &متغير متجه تخصيص_وقت_الترجمة,
    فهرس_التخصيصات: &متغير الخريطة<طبيعي, طبيعي>,
    فهرس_التعاريف: &متجه اختياري طبيعي,
    الميزانية: طبيعي
): اختياري رفض_وقت_الترجمة {
    دع النداء: متغير نداء_مسير;
    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
    | عملية_مسير.نداء(القيمة) -> { النداء := انسخ_مملوكا_نداء_مسير(&القيمة); }
    | _ -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة())); };
    دع الأصل: طبيعي;
    طابق النداء.الهدف مع
    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { الأصل := المعرف.القيمة; }
    | _ -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_مستدعى_غير_مدعوم())); };
    إذا ((الطول((*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة) مثل طبيعي) != (الطول(النداء.الحجج) مثل طبيعي)) {
        أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_عدد_حجج_غير_مطابق()));
    };
    دع الروابط: متغير متجه ربط_معامل_وقت_الترجمة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة) مثل طبيعي)) {
        إذا ((*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة[ف]) {
            دع الحجة: معرف_قيمة_مسير = النداء.الحجج[ف];
            دع رُبط: متغير منطقي = خطأ;
            طابق عملية_تعريف_في_الكتلة(البرنامج, د, ك, ر, الحجة, فهرس_التعاريف) مع
            | اختياري.موجود(عملية_مسير.بناء_إغلاق(البناء)) -> {
                إذا ((الطول(البناء.الالتقاطات) مثل طبيعي) == 0) {
                    ألحق(الروابط, ربط_معامل_وقت_الترجمة.دالة(البناء.الدالة, البناء.المدمر));
                    رُبط := صواب;
                };
            }
            | _ -> { };
            إذا (!رُبط) {
                إذا (ر == 0) { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة())); };
                دع الجذور: متجه معرف_قيمة_مسير = [الحجة];
                طابق حل_شريحة_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, ك, ر - 1, &الجذور, الميزانية) مع
                | نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب) -> { أرجع اختياري.موجود(السبب); }
                | نتيجة_شريحة_وقت_الترجمة.محلولة(الجدول) -> {
                    طابق الجدول[الحجة.القيمة] مع
                    | اختياري.موجود(الثابت) -> {
                        ألحق(الروابط, ربط_معامل_وقت_الترجمة.ثابت(انسخ_ثابت_مسير(&الثابت)));
                    }
                    | اختياري.لا_شيء -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة())); };
                };
            };
        };
        ف := ف + 1;
    }
    دع الهاش: طبيعي = هاش_تخصيص_وقت_الترجمة(الأصل, &الروابط);
    دع المخصصة: متغير طبيعي = 0;
    طابق ابحث_تخصيص_وقت_الترجمة(التخصيصات, فهرس_التخصيصات, الهاش, الأصل, &الروابط) مع
    | اختياري.موجود(الموجودة) -> { المخصصة := الموجودة; }
    | اختياري.لا_شيء -> {
        إذا ((الطول(*التخصيصات) مثل طبيعي) >= حد_تخصيصات_وقت_الترجمة()) {
            أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_حد_التخصيصات()));
        };
        إذا (!احجز_للخريطة(فهرس_التخصيصات, 1)) {
            أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_حد_التخصيصات()));
        };
        المخصصة := أنشئ_تخصيص_وقت_الترجمة(البرنامج, الأصل, &الروابط);
        دع التالي: اختياري طبيعي = ابحث_في_الخريطة(فهرس_التخصيصات, &الهاش);
        دع الموضع: طبيعي = الطول(*التخصيصات) مثل طبيعي;
        دع المسجل: تخصيص_وقت_الترجمة = {
            الأصل: الأصل,
            الروابط: الروابط,
            المخصصة: المخصصة,
            التالي_بنفس_الهاش: التالي
        };
        ألحق(*التخصيصات, المسجل);
        طابق أدرج_في_الخريطة(فهرس_التخصيصات, الهاش, الموضع) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> {
            أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_حد_التخصيصات()));
        };
    };
    // The call keeps only its runtime arguments; a memory range of a runtime
    // argument follows that argument's new position.
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع المواضع_الجديدة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول((*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة) مثل طبيعي)) {
        ألحق(المواضع_الجديدة, الطول(الحجج) مثل طبيعي);
        إذا (!(*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة[ف]) { ألحق(الحجج, النداء.الحجج[ف]); };
        ف := ف + 1;
    }
    دع النطاقات: متغير متجه نطاق_ذاكرة_نداء_مسير = [];
    ف := 0;
    طالما (ف < (الطول(النداء.نطاقات_الذاكرة) مثل طبيعي)) {
        دع النطاق: نطاق_ذاكرة_نداء_مسير = النداء.نطاقات_الذاكرة[ف];
        إذا (النطاق.فهرس_الحجة < (الطول((*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة) مثل طبيعي)
            && !(*البرنامج).الدوال[الأصل].معاملات_وقت_الترجمة[النطاق.فهرس_الحجة]) {
            دع المنقول: متغير نطاق_ذاكرة_نداء_مسير = النطاق;
            المنقول.فهرس_الحجة := المواضع_الجديدة[النطاق.فهرس_الحجة];
            ألحق(النطاقات, المنقول);
        };
        ف := ف + 1;
    }
    النداء.الهدف := هدف_نداء_مسير.دالة_سلطان(معرف_دالة_مسير_من(المخصصة));
    النداء.الحجج := الحجج;
    النداء.نطاقات_الذاكرة := النطاقات;
    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية := عملية_مسير.نداء(النداء);
    أرجع اختياري.لا_شيء();
}

// Reflection facts (CT-03) are folded once, for the selected target, before
// any compile-time execution or code generation: the argument is a reference
// and the fact belongs to the type it refers to. Size and alignment come from
// the canonical layout owner (backend/layout); a type whose physical layout is
// intentionally unfrozen (text, vector, slice, function values) has none and is
// rejected. Field count is that of a record or tuple, constructor count that of
// an enum; any other type has 0 of either.
عرف نوع_مرجع_بدائي_انعكاس(
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): معرف_نوع {
    طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
    | اختياري.لا_شيء -> { أرجع النوع; }
    | اختياري.موجود(مرجع_النوع_2) -> {
        طابق (*الأنواع).الأنواع[مرجع_النوع_2.القيمة] مع
        | نوع_مقنن.مرجع(العنصر, _) -> { أرجع العنصر; }
        | _ -> { أرجع النوع; };
    };
}

عرف قيمة_بدائي_انعكاس(
    الأنواع: &سجل_أنواع,
    الهدف: &واصف_هدف,
    سجل_التخطيط: &متغير سجل_تخطيط,
    البدائي: هوية_بدائي_مترجم,
    النوع: معرف_نوع
): نتيجة طبيعي, رفض_وقت_الترجمة {
    طابق البدائي مع
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> {
        طابق معرف_نوع_أساس_عند(الأنواع, النوع) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(مرجع_النوع_3) -> {
            طابق (*الأنواع).الأنواع[مرجع_النوع_3.القيمة] مع
            | نوع_مقنن.صف(العناصر) -> { أرجع نتيجة.نجح(الطول(العناصر) مثل طبيعي); }
            | _ -> { };
        };
        طابق عدد_حقول_سجل_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(0); };
    }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> {
        طابق عدد_منشئات_نوع_دلالي(الأنواع, النوع) مع
        | اختياري.موجود(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(0); };
    }
    | _ -> { };
    طابق حل_تخطيط_نوع(الأنواع, الهدف, سجل_التخطيط, النوع) مع
    | نتيجة_تخطيط.مكتمل(الواصف) -> {
        طابق البدائي مع
        | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع نتيجة.نجح(الواصف.المحاذاة); }
        | _ -> { أرجع نتيجة.نجح(الواصف.الحجم); };
    }
    | نتيجة_تخطيط.مؤجل(_) -> {
        أرجع نتيجة.خطأ(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_مثبت()));
    }
    | نتيجة_تخطيط.مرفوض(_) -> {
        أرجع نتيجة.خطأ(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_متاح()));
    };
}

عرف بدائي_انعكاس(البدائي: هوية_بدائي_مترجم): منطقي {
    طابق البدائي مع
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع صواب; }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف اطو_بدائيات_الانعكاس(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    طوي: &متغير منطقي
): اختياري رفض_وقت_الترجمة {
    دع الواصف: واصف_هدف;
    طابق حل_بمعرف_هدف(الهدف) مع
    | نتيجة_حل_هدف.محلول(القيمة) -> { الواصف := القيمة; }
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.موجود(رفض_بسبب(سبب_تشخيص.سبب_وقت_الترجمة_هدف_غير_معروف())); };
    دع سجل_التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                دع المطوي: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.بدائي_مترجم(البدائي) -> {
                        إذا (بدائي_انعكاس(البدائي)
                            && (الطول(النداء.الحجج) مثل طبيعي) == 1
                            && (النداء.الحجج[0].القيمة مثل طبيعي) < (الطول((*البرنامج).الدوال[د].القيم) مثل طبيعي)) {
                            دع نوع_الحجة: معرف_نوع = (*البرنامج).الدوال[د].القيم[النداء.الحجج[0].القيمة].النوع;
                            دع النوع: معرف_نوع = نوع_مرجع_بدائي_انعكاس(الأنواع, نوع_الحجة);
                            طابق قيمة_بدائي_انعكاس(الأنواع, &الواصف, &متغير سجل_التخطيط, البدائي, النوع) مع
                            | نتيجة.نجح(العدد) -> {
                                المطوي := اختياري.موجود(ثابت_مسير.صحيح_طبيعي(العدد));
                            }
                            | نتيجة.خطأ(الرفض) -> { أرجع اختياري.موجود(الرفض); };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                طابق المطوي مع
                | اختياري.موجود(الثابت) -> {
                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية := عملية_مسير.ثابت(الثابت);
                    *طوي := صواب;
                }
                | اختياري.لا_شيء -> { };
                ر := ر + 1;
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع اختياري.لا_شيء();
}

// After compile-time evaluation no compile-time failure call remains: its
// block already ends with a trap (msir/lowering/statements.sn), which is all a
// run-time path through it does. Value IDs are unaffected; the call has no
// result. Whether any was removed.
عرف أزل_نداءات_فشل_وقت_الترجمة(البرنامج: &متغير برنامج_مسير): منطقي {
    دع أزيل: متغير منطقي = خطأ;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                دع فشل: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> { فشل := صواب; }
                    // A budget request matters only inside an evaluation.
                    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.ميزانية_وقت_الترجمة) -> { فشل := صواب; }
                    | _ -> { };
                }
                | _ -> { };
                إذا (فشل) {
                    أزل_عبارة_وقت_الترجمة(البرنامج, د, ك, ر);
                    أزيل := صواب;
                } وإلا {
                    ر := ر + 1;
                };
            }
            ك := ك + 1;
        }
        د := د + 1;
    }
    أرجع أزيل;
}

// Specialized copies (CT-01): a branch whose condition the compile-time
// arguments decide is folded into a jump to the taken edge before the copy's
// compile-time work, so only the taken branch of a condition known at
// compile time is analyzed. Only constants, integer arithmetic, comparisons
// and casts are evaluated; a condition that needs a call or run-time data
// stays a run-time branch. Returns which blocks remain reachable.
عرف اطو_فروع_تخصيص_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    الميزانية: طبيعي
): متجه منطقي {
    دع تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        دع المزارة: متجه منطقي = الكتل_القابلة_للوصول_مسير(&(*البرنامج).الدوال[د]);
        إذا (امرر_مخازن_محلية_ثابتة(&متغير (*البرنامج).الدوال[د], &المزارة)) { تغير := صواب; };
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            إذا (ك < (الطول(المزارة) مثل طبيعي) && المزارة[ك]) {
                // Values a block passes along its edges (a short-circuit
                // operand merged into a block parameter) become constants
                // where the copy's constants decide them.
                اطو_حجج_حواف_تخصيص(البرنامج, الأنواع, الهدف, د, ك, &المزارة, الميزانية);
                دع الشرط: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
                طابق (*البرنامج).الدوال[د].الكتل[ك].المنهي مع
                | اختياري.موجود(منهي_مسير.فرع_شرطي(القيمة, _, _)) -> { الشرط := اختياري.موجود(القيمة); }
                | _ -> { };
                طابق الشرط مع
                | اختياري.موجود(القيمة) -> {
                    طابق شرط_ثابت_في_تخصيص(البرنامج, الأنواع, الهدف, د, ك, القيمة, &المزارة, الميزانية) مع
                    | اختياري.موجود(المأخوذ) -> {
                        دع الحافة: متغير اختياري حافة_مسير = اختياري.لا_شيء();
                        طابق (*البرنامج).الدوال[د].الكتل[ك].المنهي مع
                        | اختياري.موجود(منهي_مسير.فرع_شرطي(_, الأولى, الثانية)) -> {
                            إذا (المأخوذ) {
                                الحافة := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&الأولى));
                            } وإلا {
                                الحافة := اختياري.موجود(انسخ_مملوكا_حافة_مسير(&الثانية));
                            };
                        }
                        | _ -> { };
                        طابق الحافة مع
                        | اختياري.موجود(المختارة) -> {
                            (*البرنامج).الدوال[د].الكتل[ك].المنهي := اختياري.موجود(منهي_مسير.فرع(المختارة));
                            تغير := صواب;
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            ك := ك + 1;
        }
    }
    أرجع الكتل_القابلة_للوصول_مسير(&(*البرنامج).الدوال[د]);
}

// The blocks of specialized copy د that branch folding left unreachable
// (المزارة false) are dropped and the copy renumbered canonically, as a
// fresh copy is. A dropped block's values were used only in blocks it
// dominated, which are dropped too; its compile-time work and failure calls,
// on a branch not taken, go with it. The program then verifies before
// optimization like any other.
عرف أسقط_كتل_تخصيص_ميتة(البرنامج: &متغير برنامج_مسير, د: طبيعي, المزارة: &متجه منطقي): منطقي {
    دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي;
    دع أي_ميتة: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < العدد) {
        إذا (ك < (الطول(*المزارة) مثل طبيعي) && !(*المزارة)[ك]) { أي_ميتة := صواب; };
        ك := ك + 1;
    }
    إذا (!أي_ميتة) { أرجع خطأ; };
    دع الباقية: متغير متجه كتلة_مسير = [];
    ك := 0;
    طالما (ك < العدد) {
        إذا (ك >= (الطول(*المزارة) مثل طبيعي) || (*المزارة)[ك]) {
            // Move the block out without copying its instructions.
            دع بلا_تعليمات: متجه تعليمة_مسير = [];
            دع بلا_معاملات: متجه قيمة_مسير = [];
            دع المنقولة: متغير كتلة_مسير = {
                المعرف: (*البرنامج).الدوال[د].الكتل[ك].المعرف, المعاملات: بلا_معاملات,
                التعليمات: بلا_تعليمات, المنهي: اختياري.لا_شيء()
            };
            بدّل((*البرنامج).الدوال[د].الكتل[ك], المنقولة);
            ألحق(الباقية, المنقولة);
        };
        ك := ك + 1;
    }
    (*البرنامج).الدوال[د].الكتل := الباقية;
    أعد_تعريف_دالة_مسير_بمعرفها(&متغير (*البرنامج).الدوال[د]);
    أرجع صواب;
}

// A local that lowering pins to a place before control flow (a parameter
// read after an `if`) is stored once and then only loaded. When that one
// store writes a constant of the copy, each load is that constant. A place
// used any other way (a reference to it, a projection) is left alone.
عرف امرر_مخازن_محلية_ثابتة(الدالة: &متغير دالة_مسير, المزارة: &متجه منطقي): منطقي {
    دع الاستخدامات: متجه طبيعي = جدول_استخدامات_قيم_مسير(الدالة);
    دع العدد: طبيعي = (*الدالة).القيمة_التالية;
    دع محلية: متغير متجه منطقي = [];
    دع المخازن: متغير متجه طبيعي = [];
    دع القراءات: متغير متجه طبيعي = [];
    دع المخزن: متغير متجه معرف_قيمة_مسير = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < العدد) {
        ألحق(محلية, خطأ);
        ألحق(المخازن, 0);
        ألحق(القراءات, 0);
        ألحق(المخزن, معرف_قيمة_مسير_من((*الدالة).المعرف, 0));
        ح := ح + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[ك].التعليمات[ع].العملية مع
            | عملية_مسير.مكان_محلي(_) -> {
                طابق قيمة_ناتج_تعليمة_مسير(&(*الدالة), &(*الدالة).الكتل[ك].التعليمات[ع]) مع
                | اختياري.موجود(القيمة) -> {
                    إذا ((القيمة.المعرف.القيمة مثل طبيعي) < العدد) { محلية[القيمة.المعرف.القيمة] := صواب; };
                }
                | اختياري.لا_شيء -> { };
            }
            | عملية_مسير.تخزين(التخزين) -> {
                إذا ((التخزين.المكان.القيمة مثل طبيعي) < العدد) {
                    المخازن[التخزين.المكان.القيمة] := المخازن[التخزين.المكان.القيمة] + 1;
                    المخزن[التخزين.المكان.القيمة] := التخزين.القيمة;
                };
            }
            | عملية_مسير.تحميل(التحميل) -> {
                إذا ((التحميل.المكان.القيمة مثل طبيعي) < العدد) {
                    القراءات[التحميل.المكان.القيمة] := القراءات[التحميل.المكان.القيمة] + 1;
                };
            }
            | _ -> { };
            ع := ع + 1;
        }
        ك := ك + 1;
    }
    دع الثوابت: متجه اختياري ثابت_مسير = ثوابت_دالة_وقت_الترجمة(الدالة, المزارة);
    دع تغير: متغير منطقي = خطأ;
    ك := 0;
    طالما (ك < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الدالة).الكتل[ك].التعليمات) مثل طبيعي)) {
            دع الجديد: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
            طابق (*الدالة).الكتل[ك].التعليمات[ع].العملية مع
            | عملية_مسير.تحميل(التحميل) -> {
                دع م: طبيعي = التحميل.المكان.القيمة;
                إذا (م < العدد && محلية[م] && المخازن[م] == 1
                    && م < (الطول(الاستخدامات) مثل طبيعي)
                    && الاستخدامات[م] == المخازن[م] + القراءات[م]) {
                    دع المخزنة: طبيعي = المخزن[م].القيمة;
                    إذا (المخزنة < (الطول(الثوابت) مثل طبيعي)) {
                        طابق الثوابت[المخزنة] مع
                        | اختياري.موجود(الثابت) -> { الجديد := اختياري.موجود(انسخ_ثابت_مسير(&الثابت)); }
                        | اختياري.لا_شيء -> { };
                    };
                };
            }
            | _ -> { };
            طابق الجديد مع
            | اختياري.موجود(الثابت) -> {
                (*الدالة).الكتل[ك].التعليمات[ع].العملية := عملية_مسير.ثابت(الثابت);
                تغير := صواب;
            }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        ك := ك + 1;
    }
    أرجع تغير;
}

// Rewrites into constants the pure values a reachable block of a specialized
// copy passes to its successors, one value at a time (حل_شريحة rewrites what
// it evaluates). A value that needs run-time data stays as it is.
عرف اطو_حجج_حواف_تخصيص(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    المزارة: &متجه منطقي,
    الميزانية: طبيعي
): فراغ {
    دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
    إذا (العدد == 0) { أرجع; };
    دع القيم: متغير متجه معرف_قيمة_مسير = [];
    طابق (*البرنامج).الدوال[د].الكتل[ك].المنهي مع
    | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> { القيم := انسخ_مملوكا_حافة_مسير(&الحافة).الحجج; }
    | اختياري.موجود(منهي_مسير.فرع_شرطي(_, الأولى, الثانية)) -> {
        القيم := انسخ_مملوكا_حافة_مسير(&الأولى).الحجج;
        دع الثانية_حجج: متجه معرف_قيمة_مسير = انسخ_مملوكا_حافة_مسير(&الثانية).الحجج;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الثانية_حجج) مثل طبيعي)) {
            ألحق(القيم, الثانية_حجج[ف]);
            ف := ف + 1;
        }
    }
    | _ -> { };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع معرفة_هنا: متغير منطقي = خطأ;
        دع ع: متغير طبيعي = 0;
        طالما (ع < العدد) {
            طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع]) مع
            | اختياري.موجود(القيمة) -> {
                إذا (قيمتا_مسير_متساويتان(القيمة.المعرف, القيم[ف])) {
                    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع].العملية مع
                    | عملية_مسير.ثابت(_) -> { }
                    | _ -> { معرفة_هنا := صواب; };
                };
            }
            | اختياري.لا_شيء -> { };
            ع := ع + 1;
        }
        إذا (معرفة_هنا) {
            دع الجذور: متجه معرف_قيمة_مسير = [القيم[ف]];
            طابق حل_شريحة_وقت_الترجمة_بنمط(البرنامج, الأنواع, الهدف, د, ك, العدد - 1, &الجذور, صواب, المزارة, الميزانية) مع
            | _ -> { };
        };
        ف := ف + 1;
    }
}

// The value of a branch condition when the copy's constants decide it.
عرف شرط_ثابت_في_تخصيص(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    الشرط: معرف_قيمة_مسير,
    المزارة: &متجه منطقي,
    الميزانية: طبيعي
): اختياري منطقي {
    دع العدد: طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
    دع المعروف: متغير اختياري ثابت_مسير = اختياري.لا_شيء();
    إذا (العدد > 0) {
        دع الجذور: متجه معرف_قيمة_مسير = [الشرط];
        طابق حل_شريحة_وقت_الترجمة_بنمط(البرنامج, الأنواع, الهدف, د, ك, العدد - 1, &الجذور, صواب, المزارة, الميزانية) مع
        | نتيجة_شريحة_وقت_الترجمة.محلولة(الجدول) -> {
            إذا ((الشرط.القيمة مثل طبيعي) < (الطول(الجدول) مثل طبيعي)) {
                طابق الجدول[الشرط.القيمة] مع
                | اختياري.موجود(الثابت) -> { المعروف := اختياري.موجود(انسخ_ثابت_مسير(&الثابت)); }
                | اختياري.لا_شيء -> { };
            };
        }
        | نتيجة_شريحة_وقت_الترجمة.مرفوضة(_) -> { };
    } وإلا {
        دع الثوابت: متجه اختياري ثابت_مسير = ثوابت_دالة_وقت_الترجمة(&(*البرنامج).الدوال[د], المزارة);
        إذا ((الشرط.القيمة مثل طبيعي) < (الطول(الثوابت) مثل طبيعي)) {
            طابق الثوابت[الشرط.القيمة] مع
            | اختياري.موجود(الثابت) -> { المعروف := اختياري.موجود(انسخ_ثابت_مسير(&الثابت)); }
            | اختياري.لا_شيء -> { };
        };
    };
    طابق المعروف مع
    | اختياري.موجود(ثابت_مسير.منطق(القيمة)) -> { أرجع اختياري.موجود(القيمة); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A one-parameter function that unconditionally calls the compile-time
// failure primitive: the primitive is in its entry block or in a block the
// entry reaches through plain jumps (std.meta.reflect's فشل_وقت_الترجمة /
// compile_error, which passes its message on).
عرف دالة_فشل_وقت_الترجمة(الدالة: &دالة_مسير): منطقي {
    إذا ((الطول((*الدالة).المعاملات) مثل طبيعي) != 1) { أرجع خطأ; };
    دع الكتلة: متغير طبيعي;
    طابق (*الدالة).المدخل مع
    | اختياري.موجود(المعرف) -> { الكتلة := المعرف.القيمة; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع الخطوات: متغير طبيعي = 0;
    طالما (الخطوات < 8 && الكتلة < (الطول((*الدالة).الكتل) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الدالة).الكتل[الكتلة].التعليمات) مثل طبيعي)) {
            طابق (*الدالة).الكتل[الكتلة].التعليمات[ع].العملية مع
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> {
                    أرجع (الطول(النداء.الحجج) مثل طبيعي) == 1;
                }
                | _ -> { };
            }
            | _ -> { };
            ع := ع + 1;
        }
        دع التالية: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق (*الدالة).الكتل[الكتلة].المنهي مع
        | اختياري.موجود(منهي_مسير.فرع(الحافة)) -> { التالية := اختياري.موجود(الحافة.الهدف.القيمة); }
        | _ -> { };
        طابق التالية مع
        | اختياري.موجود(ك) -> { الكتلة := ك; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        الخطوات := الخطوات + 1;
    }
    أرجع خطأ;
}

// After folding, a compile-time failure left on a reachable path of a
// specialized copy fails the compilation with its message: in a copy every
// compile-time argument is known, so the path is either taken for these
// arguments or decided by run-time data, and both are rejected. A failure on a
// folded-away path never fires.
عرف فشل_وقت_الترجمة_في_تخصيص(
    البرنامج: &برنامج_مسير,
    د: طبيعي,
    المزارة: &متجه منطقي
): اختياري رفض_وقت_الترجمة {
    دع الثوابت: متغير اختياري متجه اختياري ثابت_مسير = اختياري.لا_شيء();
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
        إذا (ك < (الطول(*المزارة) مثل طبيعي) && (*المزارة)[ك]) {
            دع ع: متغير طبيعي = 0;
            طالما (ع < (الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي)) {
                دع الرسالة: متغير اختياري معرف_قيمة_مسير = اختياري.لا_شيء();
                دع فشل: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ع].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.فشل_وقت_الترجمة) -> { فشل := صواب; }
                    | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
                        إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*البرنامج).الدوال) مثل طبيعي)
                            && دالة_فشل_وقت_الترجمة(&(*البرنامج).الدوال[المعرف.القيمة])) {
                            فشل := صواب;
                        };
                    }
                    | _ -> { };
                    إذا (فشل && (الطول(النداء.الحجج) مثل طبيعي) == 1) {
                        الرسالة := اختياري.موجود(النداء.الحجج[0]);
                    };
                }
                | _ -> { };
                إذا (فشل) {
                    دع النص: متغير متجه ط8 = [];
                    طابق الرسالة مع
                    | اختياري.موجود(القيمة) -> {
                        طابق الثوابت مع
                        | اختياري.لا_شيء -> {
                            دع الكل_مزار: متجه منطقي = [];
                            الثوابت := اختياري.موجود(ثوابت_دالة_وقت_الترجمة(&(*البرنامج).الدوال[د], &الكل_مزار));
                        }
                        | اختياري.موجود(_) -> { };
                        طابق الثوابت مع
                        | اختياري.موجود(الجدول) -> {
                            إذا ((القيمة.القيمة مثل طبيعي) < (الطول(الجدول) مثل طبيعي)) {
                                طابق الجدول[القيمة.القيمة] مع
                                | اختياري.موجود(ثابت_مسير.نص(البايتات)) -> { النص := انسخ_بايتات(&البايتات); }
                                | _ -> { };
                            };
                        }
                        | اختياري.لا_شيء -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    أرجع اختياري.موجود(رفض_وقت_الترجمة.فشل_مطلوب(النص));
                };
                ع := ع + 1;
            }
        };
        ك := ك + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A compile-time obligation that calls std.fmt's format checker
// (msir/lowering/expressions.sn أصدر_تحقق_تنسيق_خفض).
عرف نداء_تحقق_تنسيق(البرنامج: &برنامج_مسير, د: طبيعي, ك: طبيعي, ر: طبيعي): منطقي {
    طابق (*البرنامج).دالة_تحقق_التنسيق مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المدقق) -> {
        طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
        | عملية_مسير.نداء(النداء) -> {
            طابق النداء.الهدف مع
            | هدف_نداء_مسير.دالة_سلطان(المعرف) -> {
                أرجع دالتا_مسير_متساويتان(المعرف, المدقق) && (الطول(النداء.الحجج) مثل طبيعي) == 6;
            }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// Evaluates one format check. A nonzero result rejects the format string; a
// check that cannot finish (a budget, an unexpected operand) is dropped and
// the run-time check of the same call still applies. Either way the call is
// replaced by a constant: nothing uses its value. All checks of a
// compilation share one verified interpreter context (السياق), built at the
// first: the checker and what it calls do not change while compile-time work
// is discharged.
عرف احسم_تحقق_تنسيق(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    د: طبيعي,
    ك: طبيعي,
    ر: طبيعي,
    السياق: &متغير اختياري سياق_مستهلك_مسير,
    الميزانية: طبيعي
): اختياري رفض_وقت_الترجمة {
    دع الحجج: متغير متجه معرف_قيمة_مسير = [];
    دع المدقق: متغير معرف_دالة_مسير = معرف_دالة_مسير_من(0);
    طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
    | عملية_مسير.نداء(النداء) -> {
        الحجج := انسخ_مملوكا_نداء_مسير(&النداء).الحجج;
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_سلطان(المعرف) -> { المدقق := المعرف; }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية := عملية_مسير.ثابت(ثابت_مسير.صحيح_طبيعي(0));
    إذا (ر == 0 || (الطول(الحجج) مثل طبيعي) != 6) { أرجع اختياري.لا_شيء(); };
    // The arguments are constants of this block (msir/lowering/expressions.sn).
    دع الجدول: متجه اختياري ثابت_مسير;
    دع الكل_مزار: متجه منطقي = [];
    طابق حل_شريحة_وقت_الترجمة_بنمط(البرنامج, الأنواع, الهدف, د, ك, ر - 1, &الحجج, صواب, &الكل_مزار, الميزانية) مع
    | نتيجة_شريحة_وقت_الترجمة.مرفوضة(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_شريحة_وقت_الترجمة.محلولة(القيم) -> { الجدول := القيم; };
    دع القيم: متغير متجه قيمة_تشغيل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6) {
        إذا ((الحجج[ف].القيمة مثل طبيعي) >= (الطول(الجدول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        طابق الجدول[الحجج[ف].القيمة] مع
        | اختياري.موجود(الثابت) -> {
            طابق ثابت_إلى_قيمة_وقت_ترجمة(&الثابت) مع
            | اختياري.موجود(القيمة) -> { ألحق(القيم, القيمة); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    طابق *السياق مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        *السياق := اختياري.موجود(أنشئ_سياق_وقت_الترجمة_مسير(انسخ_مملوكا_برنامج_مسير(البرنامج)));
    };
    دع الناتج: متغير ط64 = 0;
    طابق *السياق مع
    | اختياري.موجود(المسير) -> {
        طابق فسر_وقت_الترجمة_بسياق_مسير(&المسير, الأنواع, الهدف, المدقق, القيم, ميزانية_تحقق_تنسيق(الميزانية), 128) مع
        | اختياري.موجود(نتيجة_تفسير_مسير.نجح(اختياري.موجود(قيمة_تشغيل.بتات_عدد(البتات)))) -> {
            الناتج := البتات مثل ط64;
        }
        | _ -> { };
    }
    | اختياري.لا_شيء -> { };
    إذا (الناتج == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(رفض_وقت_الترجمة.تنسيق(
        الناتج,
        ط64_ثابت_في_جدول(&الجدول, الحجج[3]) مثل طبيعي,
        ط64_ثابت_في_جدول(&الجدول, الحجج[4]) مثل طبيعي,
        ط64_ثابت_في_جدول(&الجدول, الحجج[5]) مثل طبيعي
    ));
}

// std.fmt's literal checks keep at least their own budget of a million
// instructions (a long format string needs it), or the configured one.
عرف ميزانية_تحقق_تنسيق(الميزانية: طبيعي): طبيعي {
    إذا (الميزانية > 1000000) { أرجع الميزانية; };
    أرجع 1000000;
}

عرف ط64_ثابت_في_جدول(الجدول: &متجه اختياري ثابت_مسير, القيمة: معرف_قيمة_مسير): ط64 {
    إذا ((القيمة.القيمة مثل طبيعي) >= (الطول(*الجدول) مثل طبيعي)) { أرجع 0; };
    طابق (*الجدول)[القيمة.القيمة] مع
    | اختياري.موجود(ثابت_مسير.صحيح_طبيعي(س)) -> { أرجع س مثل ط64; }
    | اختياري.موجود(ثابت_مسير.صحيح_موقع(س)) -> { أرجع س مثل ط64; }
    | _ -> { أرجع 0; };
}

// Explicit comptime results, statement-form blocks and calls to compile-time
// templates are discharged here, function by function; specialized copies are
// appended and processed by the same loop. One local SSA slice is evaluated
// per explicit result, traversed backwards, so unrelated runtime calls are not
// executed.
// عدلت: set when the program changed (a reflection fact folded, an
// evaluation's result or a specialization written, a marker or a failure
// call removed), so the driver verifies it again before optimizing it.
عام عرف نفذ_طلبات_وقت_الترجمة(
    البرنامج: &متغير برنامج_مسير,
    الأنواع: &سجل_أنواع,
    الهدف: معرف_هدف,
    الميزانية: طبيعي,
    عدلت: &متغير منطقي
): اختياري رفض_وقت_الترجمة {
    طابق (*البرنامج).دالة_تحقق_التنسيق مع
    | اختياري.موجود(_) -> { *عدلت := صواب; }
    | اختياري.لا_شيء -> { };
    طابق اطو_بدائيات_الانعكاس(البرنامج, الأنواع, الهدف, عدلت) مع
    | اختياري.موجود(الرفض) -> { أرجع اختياري.موجود(الرفض); }
    | اختياري.لا_شيء -> { };
    دع التخصيصات: متغير متجه تخصيص_وقت_الترجمة = [];
    دع فهرس_التخصيصات: متغير الخريطة<طبيعي, طبيعي> = أنشئ_الخريطة(
        هاش_عدد_تخصيص, عددان_تخصيص_متساويان
    );
    دع سياق_التنسيق: متغير اختياري سياق_مستهلك_مسير = اختياري.لا_شيء();
    // Functions from this position on are specialized copies.
    دع أول_تخصيص: طبيعي = الطول((*البرنامج).الدوال) مثل طبيعي;
    دع د: متغير طبيعي = 0;
    طالما (د < (الطول((*البرنامج).الدوال) مثل طبيعي)) {
        إذا (!دالة_قالب_وقت_الترجمة(&(*البرنامج).الدوال[د])) {
        دع المزارة: متغير متجه منطقي = [];
        إذا (د >= أول_تخصيص) {
            المزارة := اطو_فروع_تخصيص_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, الميزانية);
            طابق فشل_وقت_الترجمة_في_تخصيص(البرنامج, د, &المزارة) مع
            | اختياري.موجود(الرفض) -> { أرجع اختياري.موجود(الرفض); }
            | اختياري.لا_شيء -> { };
            إذا (أسقط_كتل_تخصيص_ميتة(البرنامج, د, &المزارة)) {
                *عدلت := صواب;
                دع كلها_مزارة: متجه منطقي = [];
                المزارة := كلها_مزارة;
            };
        };
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول((*البرنامج).الدوال[د].الكتل) مثل طبيعي)) {
            دع عدد_التعليمات: متغير طبيعي = الطول((*البرنامج).الدوال[د].الكتل[ك].التعليمات) مثل طبيعي;
            // A folded-away block of a specialized copy is never analyzed.
            إذا (ك < (الطول(المزارة) مثل طبيعي) && !المزارة[ك]) {
                عدد_التعليمات := 0;
            };
            دع ر: متغير طبيعي = 0;
            دع فهرس_التعاريف: متغير متجه اختياري طبيعي = [];
            طالما (ر < عدد_التعليمات) {
                // A call to a template: all-compile-time parameters are
                // evaluated; mixed parameters are specialized.
                دع يخصص: متغير منطقي = خطأ;
                طابق (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية مع
                | عملية_مسير.نداء(النداء) -> {
                    طابق النداء.الهدف مع
                    | هدف_نداء_مسير.دالة_سلطان(هدف_الدالة) -> {
                        إذا ((هدف_الدالة.القيمة مثل طبيعي) < (الطول((*البرنامج).الدوال) مثل طبيعي)
                            && !(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة) {
                            إذا (دالة_قالب_وقت_الترجمة(&(*البرنامج).الدوال[هدف_الدالة.القيمة])) {
                                إذا (كل_معاملات_الدالة_وقت_ترجمة(&(*البرنامج).الدوال[هدف_الدالة.القيمة])) {
                                    (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة := صواب;
                                } وإلا {
                                    يخصص := صواب;
                                };
                            };
                        };
                    }
                    | _ -> { };
                }
                | _ -> { };
                إذا (يخصص) {
                    *عدلت := صواب;
                    إذا ((الطول(فهرس_التعاريف) مثل طبيعي) == 0) {
                        فهرس_التعاريف := ابن_فهرس_تعريفات_وقت_الترجمة(البرنامج, د, ك, ر);
                    };
                    طابق خصص_نداء_وقت_الترجمة(
                        البرنامج, الأنواع, الهدف, د, ك, ر,
                        &متغير التخصيصات, &متغير فهرس_التخصيصات, &فهرس_التعاريف, الميزانية
                    ) مع
                    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                    | اختياري.لا_شيء -> { };
                };
                دع حُذفت_تعليمة: متغير منطقي = خطأ;
                إذا ((*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة) {
                    *عدلت := صواب;
                    طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر]) مع
                    | اختياري.لا_شيء -> {
                        طابق نفذ_عبارة_وقت_الترجمة(
                            انسخ_مملوكا_برنامج_مسير(البرنامج), الأنواع, الهدف,
                            &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].العملية, الميزانية
                        ) مع
                        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
                        | اختياري.لا_شيء -> {
                            أزل_عبارة_وقت_الترجمة(البرنامج, د, ك, ر);
                            حُذفت_تعليمة := صواب;
                        };
                    }
                    | اختياري.موجود(القيمة) -> {
                        دع الجذور: متجه معرف_قيمة_مسير = [القيمة.المعرف];
                        إذا (نداء_تحقق_تنسيق(البرنامج, د, ك, ر)) {
                            طابق احسم_تحقق_تنسيق(البرنامج, الأنواع, الهدف, د, ك, ر, &متغير سياق_التنسيق, الميزانية) مع
                            | اختياري.موجود(الرفض) -> { أرجع اختياري.موجود(الرفض); }
                            | اختياري.لا_شيء -> { };
                        } وإلا {
                            طابق حل_شريحة_وقت_الترجمة(البرنامج, الأنواع, الهدف, د, ك, ر, &الجذور, الميزانية) مع
                            | نتيجة_شريحة_وقت_الترجمة.مرفوضة(السبب) -> { أرجع اختياري.موجود(السبب); }
                            | نتيجة_شريحة_وقت_الترجمة.محلولة(_) -> { };
                        };
                        (*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر].تقييم_وقت_الترجمة := خطأ;
                    };
                };
                إذا (!حُذفت_تعليمة && (الطول(فهرس_التعاريف) مثل طبيعي) > 0) {
                    طابق قيمة_ناتج_تعليمة_مسير(&(*البرنامج).الدوال[د], &(*البرنامج).الدوال[د].الكتل[ك].التعليمات[ر]) مع
                    | اختياري.موجود(القيمة) -> {
                        إذا ((القيمة.المعرف.القيمة مثل طبيعي) < (الطول(فهرس_التعاريف) مثل طبيعي)) {
                            فهرس_التعاريف[القيمة.المعرف.القيمة] := اختياري.موجود(ر);
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
                إذا (حُذفت_تعليمة) {
                    عدد_التعليمات := عدد_التعليمات - 1;
                } وإلا {
                    ر := ر + 1;
                };
            }
            ك := ك + 1;
        }
        };
        د := د + 1;
    }
    إذا (أزل_نداءات_فشل_وقت_الترجمة(البرنامج)) { *عدلت := صواب; };
    (*البرنامج).دالة_تحقق_التنسيق := اختياري.لا_شيء();
    أرجع اختياري.لا_شيء();
}
