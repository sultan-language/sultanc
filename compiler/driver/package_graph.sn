استورد std.toml.parser;
استورد std.fs.read_file;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.frontend.lexer.identifier_queries;
استورد compiler.frontend.lexer.keywords.keyword_registry;
استورد compiler.frontend.lexer.keywords.matching;
استورد compiler.source.source_map;
استورد compiler.source.span;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.ispeak.keys.surface;

// The package graph: the one description of packages the compiler reads
// (--package-graph=<file>). The standard library needs none: the compiler
// knows std itself (std_location.sn). Supax resolves, fetches and locks packages
// and writes this file; the compiler never reads Supax.toml or Supax.lock,
// never discovers manifests and never walks dependencies. It only registers
// what the graph states (package_environment.sn):
//
//   version = 1
//   root = "app"                     # the package that owns the entry file
//
//   [[package]]
//   id = "app"                       # unique and opaque; "std" is reserved
//   source_root = "src"              # absolute, or relative to this file
//   name = "app"                     # the canonical root spelling
//   spellings = { ar = "تطبيق" }     # more root spellings, by language
//   entry = "lib"                    # optional: the module the spellings name
//
//   [[edge]]
//   from = "app"
//   to = "json"
//   name = "json"                    # the dependency's name inside from
//
// One reader, اقرأ_رسم_حزم_من_نص, takes the text and the path it is named by;
// the file variant reads the file and calls it. The text is registered in a
// SourceMap, so every error carries a source span: path:line:column and the
// line itself, like a source error.
//
// Spellings of the modules inside a package are no part of the graph: a
// folder's root file declares them with `module` (module_spellings.sn).
// A source_root is cleaned lexically (std.fs.path نظف_المسار, as Cargo
// does), so `app/../util` is `util` in every source name and diagnostic,
// and two packages whose source roots clean to one directory are an error.

عام نوع تهجئة_رسم_حزم = {
    اللغة: نص,
    التهجئة: نص
};

عام نوع حزمة_رسم = {
    المعرف: نص,
    // Normalized; joined to the graph file's directory when written relative.
    جذر_المصدر: نص,
    الاسم: نص,
    التهجئات: متجه تهجئة_رسم_حزم,
    // The module the root spellings name (slash-separated), or none.
    المدخل: اختياري نص,
    // Where the [[package]] entry is, for registration errors.
    النطاق: اختياري نطاق_مصدر_تشخيص
};

عام نوع حافة_رسم = {
    المستوردة: طبيعي,
    المعتمدة: طبيعي,
    الاسم: نص,
    النطاق: اختياري نطاق_مصدر_تشخيص
};

عام نوع رسم_حزم = {
    المسار: نص,
    // The package owning the entry file.
    الجذر: اختياري طبيعي,
    الحزم: متجه حزمة_رسم,
    الحواف: متجه حافة_رسم
};

// A package graph that is invalid (SULTANC-PACKAGE-GRAPH-INVALID), or a
// standard library that is not where the compiler looks
// (SULTANC-STD-NOT-FOUND).
عام نوع صنف_خطأ_رسم_حزم =
    | رسم
    | مكتبة_قياسية_مفقودة
;

عام نوع خطأ_رسم_حزم = {
    الصنف: صنف_خطأ_رسم_حزم,
    المسار: نص,
    النطاق: اختياري نطاق_مصدر_تشخيص,
    السبب: مفتاح_نص_مترجم
};

عام عرف خطأ_رسم_بلا_موقع(المسار: &نص, السبب: مفتاح_نص_مترجم): خطأ_رسم_حزم {
    دع الخطأ: خطأ_رسم_حزم = {
        الصنف: صنف_خطأ_رسم_حزم.رسم(), المسار: انسخ_نص(المسار), النطاق: اختياري.لا_شيء(), السبب: السبب
    };
    أرجع الخطأ;
}

عام عرف خطأ_رسم_في(
    المسار: &نص,
    النطاق: &اختياري نطاق_مصدر_تشخيص,
    السبب: مفتاح_نص_مترجم
): خطأ_رسم_حزم {
    دع الخطأ: خطأ_رسم_حزم = {
        الصنف: صنف_خطأ_رسم_حزم.رسم(), المسار: انسخ_نص(المسار),
        النطاق: انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(النطاق), السبب: السبب
    };
    أرجع الخطأ;
}

// المسار is the std folder looked for (std_location.sn).
عام عرف خطأ_مكتبة_قياسية_مفقودة(المسار: &نص): خطأ_رسم_حزم {
    دع الخطأ: خطأ_رسم_حزم = {
        الصنف: صنف_خطأ_رسم_حزم.مكتبة_قياسية_مفقودة(), المسار: انسخ_نص(المسار),
        النطاق: اختياري.لا_شيء(), السبب: مفتاح_نص_مترجم.جذر_مصدر_حزمة_رسم_مفقود()
    };
    أرجع الخطأ;
}

// The text and its SourceMap identity while one graph is read.
نوع قارئ_رسم = {
    المسار: نص,
    الخريطة: خريطة_مصادر,
    المعرف: طبيعي,
    الطول: طبيعي
};

// The span of the line that starts at byte البداية (to its end), so a
// diagnostic underlines the whole `key = value`.
عرف نطاق_سطر_رسم(القارئ: &قارئ_رسم, البداية: طبيعي): اختياري نطاق_مصدر_تشخيص {
    دع المصدر: &نص = &(*القارئ).الخريطة.المصادر[(*القارئ).المعرف].المحتوى;
    دع الأول: متغير طبيعي = البداية;
    إذا (الأول > (*القارئ).الطول) { الأول := (*القارئ).الطول; };
    دع النهاية: متغير طبيعي = الأول;
    طالما (النهاية < (*القارئ).الطول && (*المصدر)[النهاية] != 0x0A && (*المصدر)[النهاية] != 0x0D) {
        النهاية := النهاية + 1;
    }
    دع البداية_موضع: موضع = { المصدر: (*القارئ).المعرف مثل ط32, البايت: الأول مثل ط32 };
    دع النهاية_موضع: موضع = { المصدر: (*القارئ).المعرف مثل ط32, البايت: النهاية مثل ط32 };
    دع النطاق: نطاق = نطاق_بين(البداية_موضع, النهاية_موضع);
    دع المقتطف: اختياري نص = مقتطف_من_الخريطة(&(*القارئ).الخريطة, &النطاق);
    أرجع نطاق_مصدر_تشخيص_من_خريطة(النطاق, &(*القارئ).الخريطة, (*القارئ).المعرف, المقتطف);
}

عرف خطأ_عند(القارئ: &قارئ_رسم, البداية: طبيعي, السبب: مفتاح_نص_مترجم): خطأ_رسم_حزم {
    دع النطاق: اختياري نطاق_مصدر_تشخيص = نطاق_سطر_رسم(القارئ, البداية);
    أرجع خطأ_رسم_في(&(*القارئ).المسار, &النطاق, السبب);
}

عرف نص_يساوي_رسما(الأول: &نص, الثاني: نص): منطقي {
    دع ب: نص = الثاني;
    أرجع نصان_متساويان(الأول, &ب);
}

عرف قيمة_نص_تومل(القيمة: &قيمة_تومل): اختياري نص {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_جدول_تومل(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.جدول(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_مصفوفة_تومل(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.مصفوفة(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف موقع_مدخل_تومل_في_جدول(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: &نص,
    البديل: طبيعي
): طبيعي {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        إذا (نصان_متساويان(&المداخل[ف].المفتاح, المفتاح)) { أرجع المداخل[ف].الإزاحة; };
        ف := ف + 1;
    }
    أرجع البديل;
}

// Whether a name, or any component of a dotted spelling, is a reserved word
// of the language, by the canonical keyword registry (the lexer's own). Supax
// checks only the identifier characters, so this is where a reserved word as
// a package name, a spelling or an edge name is refused.
عرف فيه_كلمة_محجوزة(النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        إذا (ف == العدد || القيمة[ف] == 0x2E) {
            إذا (ف > البداية) {
                طابق كلمة_مسجلة(&القيمة, البداية, ف) مع
                | مطابقة_كلمة.غير_محجوزة -> { }
                | _ -> { أرجع صواب; };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// A slash-separated module path from a dotted spelling, each component a
// source identifier; none for anything else.
عام عرف مسار_استيراد_من_نص_رسم(النص: &نص): اختياري نص {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع الجزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        إذا (!نهاية) {
            دع ب: ط8 = القيمة[ف];
            إذا ((ب == 0x2F) || (ب == 0x5C) || (ب == 0)) { أرجع اختياري.لا_شيء(); };
            نهاية := ب == 0x2E;
        };
        إذا (نهاية) {
            إذا ((الطول(الجزء) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
            دع اسم_الجزء: نص = من_بايتات(&الجزء);
            إذا (!تهجئة_معرف_مصدر_صالحة(&اسم_الجزء)) { أرجع اختياري.لا_شيء(); };
            إذا ((الطول(الناتج) مثل طبيعي) > 0) { ألحق(الناتج, 0x2F); };
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الجزء) مثل طبيعي)) { ألحق(الناتج, الجزء[ح]); ح := ح + 1; }
            دع جزء_فارغ: متجه ط8 = [];
            الجزء := جزء_فارغ;
        } وإلا {
            ألحق(الجزء, القيمة[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(من_بايتات(&الناتج));
}

// Every key of the table must be one of المعروفة.
عرف تحقق_مفاتيح_جدول_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المعروفة: &متجه نص
): اختياري خطأ_رسم_حزم {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع معروف: متغير منطقي = خطأ;
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(*المعروفة) مثل طبيعي)) {
            إذا (نصان_متساويان(&المداخل[ف].المفتاح, &(*المعروفة)[ح])) { معروف := صواب; };
            ح := ح + 1;
        }
        إذا (!معروف) {
            أرجع اختياري.موجود(خطأ_عند(القارئ, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.حقل_رسم_حزم_غير_معروف()));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A string field; a missing one is reported at إزاحة_الفقد.
عرف نص_حقل_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص,
    إزاحة_الفقد: طبيعي
): نتيجة نص, خطأ_رسم_حزم {
    دع اسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &اسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_الفقد, مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود()));
    }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_نص_تومل(&القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_عند(
                القارئ, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &اسم, إزاحة_الفقد), مفتاح_نص_مترجم.حقل_رسم_حزم_ليس_نصا()
            ));
        }
        | اختياري.موجود(النص) -> { أرجع نتيجة.نجح(النص); };
    };
}

// The [[name]] array of tables of the root (its table indexes), or an empty
// list when it is absent.
عرف جداول_مصفوفة_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    المفتاح: نص
): نتيجة متجه طبيعي, خطأ_رسم_حزم {
    دع الناتج: متغير متجه طبيعي = [];
    دع اسم: نص = المفتاح;
    دع الجذر: طبيعي = (*الوثيقة).الجذر;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجذر, &اسم) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختياري.موجود(القيمة) -> {
        دع الإزاحة: طبيعي = موقع_مدخل_تومل_في_جدول(الوثيقة, الجذر, &اسم, 0);
        طابق قيمة_مصفوفة_تومل(&القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.مدخلات_رسم_حزم_ليست_جداول()));
        }
        | اختياري.موجود(المصفوفة) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, المصفوفة);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القيم) مثل طبيعي)) {
                طابق قيمة_جدول_تومل(&القيم[ف]) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.مدخلات_رسم_حزم_ليست_جداول()));
                }
                | اختياري.موجود(الجدول) -> { ألحق(الناتج, الجدول); };
                ف := ف + 1;
            }
        };
    };
    أرجع نتيجة.نجح(الناتج);
}

// Where a missing field of a table is reported: its first entry, or the
// array it belongs to when it has none.
عرف إزاحة_جدول_رسم(الوثيقة: &وثيقة_تومل, الجدول: طبيعي, البديل: طبيعي): طبيعي {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    إذا ((الطول(المداخل) مثل طبيعي) > 0) { أرجع المداخل[0].الإزاحة; };
    أرجع البديل;
}

// A `spellings = { <language> = "<spelling>" }` table of root identifiers.
عرف اقرأ_تهجئات_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي
): نتيجة متجه تهجئة_رسم_حزم, خطأ_رسم_حزم {
    دع الناتج: متغير متجه تهجئة_رسم_حزم = [];
    دع اسم: نص = «spellings»;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &اسم) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختياري.موجود(القيمة) -> {
        دع الإزاحة: طبيعي = موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &اسم, 0);
        دع اللغات: طبيعي;
        طابق قيمة_جدول_تومل(&القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.تهجئات_رسم_حزم_ليست_جدولا()));
        }
        | اختياري.موجود(الفهرس) -> { اللغات := الفهرس; };
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, اللغات);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع مرجع_اللغة: &نص = &(*مرجع_المدخل).المفتاح;
            دع اللغة: نص = انسخ_نص(مرجع_اللغة);
            طابق قيمة_نص_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.حقل_رسم_حزم_ليس_نصا()));
            }
            | اختياري.موجود(النص) -> {
                دع التهجئة: نص = انسخ_نص(&النص);
                إذا (فيه_كلمة_محجوزة(&النص)) {
                    أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.كلمة_محجوزة_في_رسم_حزم()));
                };
                إذا (!تهجئة_معرف_مصدر_صالحة(&النص)) {
                    أرجع نتيجة.خطأ(خطأ_عند(القارئ, الإزاحة, مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة()));
                };
                دع العنصر: تهجئة_رسم_حزم = { اللغة: اللغة, التهجئة: التهجئة };
                ألحق(الناتج, العنصر);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

// A path as written: absolute, or relative to the graph file's directory,
// cleaned lexically without following symbolic links (as Cargo does), so
// `app/../util` is `util`: source names and diagnostics never carry `..`.
عرف مسار_نسبة_إلى_رسم(مسار_الرسم: &نص, المكتوب: &نص): نص {
    إذا (مسار_مطلق(المكتوب)) { أرجع نظف_المسار(المكتوب); };
    طابق أب_المسار(مسار_الرسم) مع
    | اختياري.لا_شيء -> { أرجع نظف_المسار(المكتوب); }
    | اختياري.موجود(الدليل) -> {
        دع الموصول: نص = صل_المسار(&الدليل, المكتوب);
        أرجع نظف_المسار(&الموصول);
    };
}

عرف ملف_مصدر_موجود(جذر_المصدر: &نص, المسار_المنطقي: &نص): منطقي {
    دع الأساس: نص = صل_المسار(جذر_المصدر, المسار_المنطقي);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأساس) مثل طبيعي)) { ألحق(البايتات, الأساس[ف]); ف := ف + 1; }
    ألحق_بايتات_نص(&متغير البايتات, «.sn»);
    دع الملف: نص = من_بايتات(&البايتات);
    طابق حاول_مسار_ملف(&الملف) مع
    | نتيجة.نجح(موجود) -> { أرجع موجود; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف اقرأ_حزمة_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    إزاحة_المصفوفة: طبيعي
): نتيجة حزمة_رسم, خطأ_رسم_حزم {
    دع المعروفة: متجه نص = [«id», «source_root», «name», «spellings», «entry»];
    طابق تحقق_مفاتيح_جدول_رسم(القارئ, الوثيقة, الجدول, &المعروفة) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };
    دع إزاحة_الجدول: طبيعي = إزاحة_جدول_رسم(الوثيقة, الجدول, إزاحة_المصفوفة);
    دع المعرف: نص = نص_حقل_رسم(القارئ, الوثيقة, الجدول, «id», إزاحة_الجدول)؟;
    دع حقل_المعرف: نص = «id»;
    دع نطاق_الحزمة: اختياري نطاق_مصدر_تشخيص = نطاق_سطر_رسم(
        القارئ, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل_المعرف, إزاحة_الجدول)
    );
    إذا ((الطول(المعرف) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(خطأ_رسم_في(&(*القارئ).المسار, &نطاق_الحزمة, مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود()));
    };
    دع المكتوب: نص = نص_حقل_رسم(القارئ, الوثيقة, الجدول, «source_root», إزاحة_الجدول)؟;
    دع حقل_الجذر: نص = «source_root»;
    دع إزاحة_الجذر: طبيعي = موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل_الجذر, إزاحة_الجدول);
    دع جذر_المصدر: نص = مسار_نسبة_إلى_رسم(&(*القارئ).المسار, &المكتوب);
    طابق حاول_مسار_دليل(&جذر_المصدر) مع
    | نتيجة.نجح(صواب) -> { }
    | _ -> { أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_الجذر, مفتاح_نص_مترجم.جذر_مصدر_حزمة_رسم_مفقود())); };
    دع الاسم: نص = نص_حقل_رسم(القارئ, الوثيقة, الجدول, «name», إزاحة_الجدول)؟;
    دع حقل_الاسم: نص = «name»;
    دع إزاحة_الاسم: طبيعي = موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل_الاسم, إزاحة_الجدول);
    إذا (فيه_كلمة_محجوزة(&الاسم)) {
        أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_الاسم, مفتاح_نص_مترجم.كلمة_محجوزة_في_رسم_حزم()));
    };
    إذا (!تهجئة_معرف_مصدر_صالحة(&الاسم)) {
        أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_الاسم, مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة()));
    };
    دع التهجئات: متجه تهجئة_رسم_حزم = اقرأ_تهجئات_رسم(القارئ, الوثيقة, الجدول)؟;
    دع المدخل: متغير اختياري نص = اختياري.لا_شيء();
    دع حقل_المدخل: نص = «entry»;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &حقل_المدخل) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        دع إزاحة_المدخل: طبيعي = موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل_المدخل, إزاحة_الجدول);
        دع المكتوب_للمدخل: نص = نص_حقل_رسم(القارئ, الوثيقة, الجدول, «entry», إزاحة_الجدول)؟;
        طابق مسار_استيراد_من_نص_رسم(&المكتوب_للمدخل) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_المدخل, مفتاح_نص_مترجم.مدخل_حزمة_رسم_مفقود()));
        }
        | اختياري.موجود(المسار) -> {
            إذا (!ملف_مصدر_موجود(&جذر_المصدر, &المسار)) {
                أرجع نتيجة.خطأ(خطأ_عند(القارئ, إزاحة_المدخل, مفتاح_نص_مترجم.مدخل_حزمة_رسم_مفقود()));
            };
            المدخل := اختياري.موجود(المسار);
        };
    };
    دع الحزمة: حزمة_رسم = {
        المعرف: المعرف,
        جذر_المصدر: جذر_المصدر,
        الاسم: الاسم,
        التهجئات: التهجئات,
        المدخل: المدخل,
        النطاق: نطاق_الحزمة
    };
    أرجع نتيجة.نجح(الحزمة);
}

عرف موضع_حزمة_بمعرف(الحزم: &متجه حزمة_رسم, المعرف: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحزم) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الحزم)[ف].المعرف, المعرف)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A package id named by field المفتاح of the table.
عرف حزمة_حقل_رسم(
    القارئ: &قارئ_رسم,
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص,
    إزاحة_الجدول: طبيعي,
    الحزم: &متجه حزمة_رسم
): نتيجة طبيعي, خطأ_رسم_حزم {
    دع اسم: نص = انسخ_نص(&المفتاح);
    دع المعرف: نص = نص_حقل_رسم(القارئ, الوثيقة, الجدول, المفتاح, إزاحة_الجدول)؟;
    طابق موضع_حزمة_بمعرف(الحزم, &المعرف) مع
    | اختياري.موجود(الموضع) -> { أرجع نتيجة.نجح(الموضع); }
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_عند(
            القارئ, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &اسم, إزاحة_الجدول), مفتاح_نص_مترجم.حزمة_رسم_غير_معروفة()
        ));
    };
}

// The graph in النص, named المسار (in diagnostics and for relative paths).
// The id "std" is the standard library's, which no graph describes.
عام عرف اقرأ_رسم_حزم_من_نص(
    المسار: &نص,
    النص: &نص
): نتيجة رسم_حزم, خطأ_رسم_حزم {
    دع الخريطة: متغير خريطة_مصادر = خريطة_مصادر_جديدة();
    دع المعرف: طبيعي = أضف_مصدر_إلى_خريطة(&متغير الخريطة, انسخ_نص(المسار), انسخ_نص(النص));
    دع القارئ: قارئ_رسم = {
        المسار: انسخ_نص(المسار), الخريطة: الخريطة, المعرف: المعرف, الطول: الطول(*النص) مثل طبيعي
    };

    دع الوثيقة: وثيقة_تومل;
    طابق حلل_تومل(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عند(&القارئ, الخطأ.الإزاحة, مفتاح_نص_مترجم.صياغة_تومل_غير_صالحة())); }
    | نتيجة.نجح(القيمة) -> { الوثيقة := القيمة; };
    دع الجذر: طبيعي = الوثيقة.الجذر;

    دع العلوية: متجه نص = [«version», «root», «package», «edge»];
    طابق تحقق_مفاتيح_جدول_رسم(&القارئ, &الوثيقة, الجذر, &العلوية) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع مفتاح_الإصدار: نص = «version»;
    دع إصدار_مدعوم: متغير منطقي = خطأ;
    طابق قيمة_مفتاح_تومل(&الوثيقة, الجذر, &مفتاح_الإصدار) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_تومل.عدد(النص_العددي) -> {
            إصدار_مدعوم := نص_يساوي_رسما(&النص_العددي, «1») || نص_يساوي_رسما(&النص_العددي, «+1»);
        }
        | _ -> { };
    };
    إذا (!إصدار_مدعوم) {
        أرجع نتيجة.خطأ(خطأ_عند(
            &القارئ, موقع_مدخل_تومل_في_جدول(&الوثيقة, الجذر, &مفتاح_الإصدار, 0), مفتاح_نص_مترجم.إصدار_رسم_حزم_غير_مدعوم()
        ));
    };

    دع مفتاح_الحزم: نص = «package»;
    دع إزاحة_الحزم: طبيعي = موقع_مدخل_تومل_في_جدول(&الوثيقة, الجذر, &مفتاح_الحزم, 0);
    دع جداول_الحزم: متجه طبيعي = جداول_مصفوفة_رسم(&القارئ, &الوثيقة, «package»)؟;
    دع الحزم: متغير متجه حزمة_رسم = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(جداول_الحزم) مثل طبيعي)) {
        دع الحزمة: حزمة_رسم = اقرأ_حزمة_رسم(&القارئ, &الوثيقة, جداول_الحزم[ف], إزاحة_الحزم)؟;
        دع المكتبة: نص = «std»;
        إذا (نصان_متساويان(&الحزمة.المعرف, &المكتبة)) {
            أرجع نتيجة.خطأ(خطأ_رسم_في(&القارئ.المسار, &الحزمة.النطاق, مفتاح_نص_مترجم.معرف_حزمة_رسم_محجوز()));
        };
        طابق موضع_حزمة_بمعرف(&الحزم, &الحزمة.المعرف) مع
        | اختياري.موجود(_) -> {
            أرجع نتيجة.خطأ(خطأ_رسم_في(&القارئ.المسار, &الحزمة.النطاق, مفتاح_نص_مترجم.معرف_حزمة_رسم_مكرر()));
        }
        | اختياري.لا_شيء -> { };
        // One directory is one root: two packages whose source roots clean
        // to it would give one file two module names.
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الحزم) مثل طبيعي)) {
            إذا (نصان_متساويان(&الحزم[ح].جذر_المصدر, &الحزمة.جذر_المصدر)) {
                دع حقل_الجذر: نص = «source_root»;
                دع إزاحة_الجذر: طبيعي = موقع_مدخل_تومل_في_جدول(
                    &الوثيقة, جداول_الحزم[ف], &حقل_الجذر, إزاحة_الحزم
                );
                أرجع نتيجة.خطأ(خطأ_عند(&القارئ, إزاحة_الجذر, مفتاح_نص_مترجم.جذر_مصدر_حزمة_رسم_مكرر()));
            };
            ح := ح + 1;
        }
        ألحق(الحزم, الحزمة);
        ف := ف + 1;
    }

    دع جداول_الحواف: متجه طبيعي = جداول_مصفوفة_رسم(&القارئ, &الوثيقة, «edge»)؟;
    دع مفتاح_الحواف: نص = «edge»;
    دع إزاحة_الحواف: طبيعي = موقع_مدخل_تومل_في_جدول(&الوثيقة, الجذر, &مفتاح_الحواف, 0);
    دع الحواف: متغير متجه حافة_رسم = [];
    ف := 0;
    طالما (ف < (الطول(جداول_الحواف) مثل طبيعي)) {
        دع الجدول: طبيعي = جداول_الحواف[ف];
        دع المعروفة: متجه نص = [«from», «to», «name»];
        طابق تحقق_مفاتيح_جدول_رسم(&القارئ, &الوثيقة, الجدول, &المعروفة) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        دع إزاحة_الجدول: طبيعي = إزاحة_جدول_رسم(&الوثيقة, الجدول, إزاحة_الحواف);
        دع المستوردة: طبيعي = حزمة_حقل_رسم(&القارئ, &الوثيقة, الجدول, «from», إزاحة_الجدول, &الحزم)؟;
        دع المعتمدة: طبيعي = حزمة_حقل_رسم(&القارئ, &الوثيقة, الجدول, «to», إزاحة_الجدول, &الحزم)؟;
        دع الاسم: نص = نص_حقل_رسم(&القارئ, &الوثيقة, الجدول, «name», إزاحة_الجدول)؟;
        دع حقل_الاسم: نص = «name»;
        دع إزاحة_الاسم: طبيعي = موقع_مدخل_تومل_في_جدول(&الوثيقة, الجدول, &حقل_الاسم, إزاحة_الجدول);
        إذا (فيه_كلمة_محجوزة(&الاسم)) {
            أرجع نتيجة.خطأ(خطأ_عند(&القارئ, إزاحة_الاسم, مفتاح_نص_مترجم.كلمة_محجوزة_في_رسم_حزم()));
        };
        إذا (!تهجئة_معرف_مصدر_صالحة(&الاسم)) {
            أرجع نتيجة.خطأ(خطأ_عند(&القارئ, إزاحة_الاسم, مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة()));
        };
        دع الحافة: حافة_رسم = {
            المستوردة: المستوردة, المعتمدة: المعتمدة, الاسم: الاسم, النطاق: نطاق_سطر_رسم(&القارئ, إزاحة_الاسم)
        };
        ألحق(الحواف, الحافة);
        ف := ف + 1;
    }

    دع مفتاح_الجذر: نص = «root»;
    دع إزاحة_الجذر: طبيعي = موقع_مدخل_تومل_في_جدول(&الوثيقة, الجذر, &مفتاح_الجذر, 0);
    دع موضع_الجذر: طبيعي = حزمة_حقل_رسم(&القارئ, &الوثيقة, الجذر, «root», إزاحة_الجذر, &الحزم)؟;
    دع حزمة_الجذر: اختياري طبيعي = اختياري.موجود(موضع_الجذر);

    دع الرسم: رسم_حزم = {
        المسار: انسخ_نص(المسار),
        الجذر: حزمة_الجذر,
        الحزم: الحزم,
        الحواف: الحواف
    };
    أرجع نتيجة.نجح(الرسم);
}

// The graph in the file المسار.
عام عرف اقرأ_رسم_حزم(المسار: &نص): نتيجة رسم_حزم, خطأ_رسم_حزم {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_رسم_بلا_موقع(المسار, مفتاح_نص_مترجم.تعذر_قراءة_رسم_حزم()));
    }
    | نتيجة.نجح(النص) -> { أرجع اقرأ_رسم_حزم_من_نص(المسار, &النص); };
}
