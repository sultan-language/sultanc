استورد compiler.driver.driver_model;
استورد compiler.driver.source_inputs;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.msir.semantic_lowering;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_consumer;
استورد compiler.source.source_map;
استورد compiler.source.provenance;
استورد compiler.msir.debug_contract;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.selection_query_context;
استورد compiler.backend.layout.layout_model;

// Per-compilation composition owner. Driver remains the only pipeline executor;
// lower layers own semantic work and never depend on this file.
عام نوع حمولة_خلفية_تجميع = {
    المسير: سياق_مستهلك_مسير,
    حقائق_الخلفية: سياق_استعلام_اختيار_خلفية,
    المصادر: خريطة_مصادر,
    الأصول: سجل_أصول_مصدر,
    التصحيح: بيانات_تصحيح_مسير,
    الهدف: واصف_هدف,
    التخطيط: سجل_تخطيط,
    دالة_الدخول: اختيار معرف_دالة_مسير
};

// Exactly one phase payload is owned at a time. Transfer states retain their
// originating phase so the lifecycle API can enforce the only valid successor.
عام نوع حالة_سياق_التجميع =
    | مهيأ بنوع إعداد_تجميع_مباشر
    | واجهة_جاهزة بنوع نتيجة_واجهة_وحدة
    | مسير_جاهز بنوع حمولة_مسير_مخفضة
    | خلفية_جاهزة بنوع حمولة_خلفية_تجميع
    | نقل_إعداد
    | نقل_واجهة
    | نقل_مسير
    | نقل_خلفية
    | منتهي بنوع نتيجة_تجميع_مترجم
    | ملغى
    | مستهلك
;

عام نوع سياق_التجميع = {
    الطلب: طلب_تجميع_مترجم,
    الإلغاء: حالة_إلغاء_واجهة,
    الحالة: حالة_سياق_التجميع
};

عام نوع نتيجة_خذ_إعداد_التجميع =
    | ناجح بنوع (سياق_التجميع, إعداد_تجميع_مباشر)
    | غير_صالح
;

عام نوع نتيجة_خذ_واجهة_التجميع =
    | ناجح بنوع (سياق_التجميع, نتيجة_واجهة_وحدة)
    | غير_صالح
;

عام نوع نتيجة_خذ_مسير_التجميع =
    | ناجح بنوع (سياق_التجميع, حمولة_مسير_مخفضة)
    | غير_صالح
;

عام نوع نتيجة_خذ_خلفية_التجميع =
    | ناجح بنوع (سياق_التجميع, حمولة_خلفية_تجميع)
    | غير_صالح
;

عام نوع نتيجة_خذ_نتيجة_التجميع =
    | ناجح بنوع (سياق_التجميع, نتيجة_تجميع_مترجم)
    | ملغى بنوع سياق_التجميع
    | غير_صالح
;

عرف ابن_سياق_تجميع_بحالة(
    الطلب: طلب_تجميع_مترجم,
    الإلغاء: حالة_إلغاء_واجهة,
    الحالة: حالة_سياق_التجميع
): سياق_التجميع {
    دع السياق: سياق_التجميع = {
        الطلب: الطلب,
        الإلغاء: الإلغاء,
        الحالة: الحالة
    };
    أرجع السياق;
}

عام عرف أنشئ_سياق_التجميع(
    الطلب: طلب_تجميع_مترجم,
    الإعداد: إعداد_تجميع_مباشر
): سياق_التجميع {
    دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    دع الحالة: حالة_سياق_التجميع = حالة_سياق_التجميع.مهيأ(الإعداد);
    أرجع ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, الحالة);
}

عام عرف اطلب_إلغاء_التجميع(السياق: &متغير سياق_التجميع): فراغ {
    دع الإلغاء: متغير حالة_إلغاء_واجهة = (*السياق).الإلغاء;
    اطلب_إلغاء_واجهة(&متغير الإلغاء);
    (*السياق).الإلغاء := الإلغاء;
}

عام عرف هل_التجميع_ملغى(السياق: &سياق_التجميع): منطقي {
    أرجع هل_واجهة_ملغاة(&(*السياق).الإلغاء);
}

عام عرف خذ_إعداد_التجميع(
    السياق: سياق_التجميع
): نتيجة_خذ_إعداد_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.مهيأ(الإعداد) -> {
            دع حالة_النقل: حالة_سياق_التجميع = حالة_سياق_التجميع.نقل_إعداد();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_النقل
            );
            أرجع نتيجة_خذ_إعداد_التجميع.ناجح(التالي, الإعداد);
        }
        | _ -> { أرجع نتيجة_خذ_إعداد_التجميع.غير_صالح(); };
    };
}

عام عرف ثبت_واجهة_التجميع(
    السياق: سياق_التجميع,
    الواجهة: نتيجة_واجهة_وحدة
): اختيار سياق_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.نقل_إعداد -> {
            دع حالة_الواجهة: حالة_سياق_التجميع = حالة_سياق_التجميع.واجهة_جاهزة(الواجهة);
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_الواجهة
            );
            أرجع اختيار.بعض(التالي);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف خذ_واجهة_التجميع(
    السياق: سياق_التجميع
): نتيجة_خذ_واجهة_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.واجهة_جاهزة(الواجهة) -> {
            دع حالة_النقل: حالة_سياق_التجميع = حالة_سياق_التجميع.نقل_واجهة();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_النقل
            );
            أرجع نتيجة_خذ_واجهة_التجميع.ناجح(التالي, الواجهة);
        }
        | _ -> { أرجع نتيجة_خذ_واجهة_التجميع.غير_صالح(); };
    };
}

عام عرف ثبت_مسير_التجميع(
    السياق: سياق_التجميع,
    الحمولة: حمولة_مسير_مخفضة
): اختيار سياق_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.نقل_واجهة -> {
            دع حالة_المسير: حالة_سياق_التجميع = حالة_سياق_التجميع.مسير_جاهز(الحمولة);
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_المسير
            );
            أرجع اختيار.بعض(التالي);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف خذ_مسير_التجميع(
    السياق: سياق_التجميع
): نتيجة_خذ_مسير_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.مسير_جاهز(الحمولة) -> {
            دع حالة_النقل: حالة_سياق_التجميع = حالة_سياق_التجميع.نقل_مسير();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_النقل
            );
            أرجع نتيجة_خذ_مسير_التجميع.ناجح(التالي, الحمولة);
        }
        | _ -> { أرجع نتيجة_خذ_مسير_التجميع.غير_صالح(); };
    };
}

عام عرف ثبت_خلفية_التجميع(
    السياق: سياق_التجميع,
    الحمولة: حمولة_خلفية_تجميع
): اختيار سياق_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.نقل_مسير -> {
            دع حالة_الخلفية: حالة_سياق_التجميع = حالة_سياق_التجميع.خلفية_جاهزة(الحمولة);
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_الخلفية
            );
            أرجع اختيار.بعض(التالي);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف خذ_خلفية_التجميع(
    السياق: سياق_التجميع
): نتيجة_خذ_خلفية_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.خلفية_جاهزة(الحمولة) -> {
            دع حالة_النقل: حالة_سياق_التجميع = حالة_سياق_التجميع.نقل_خلفية();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_النقل
            );
            أرجع نتيجة_خذ_خلفية_التجميع.ناجح(التالي, الحمولة);
        }
        | _ -> { أرجع نتيجة_خذ_خلفية_التجميع.غير_صالح(); };
    };
}

عام عرف أنه_سياق_التجميع(
    السياق: سياق_التجميع,
    النتيجة: نتيجة_تجميع_مترجم
): اختيار سياق_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.نقل_إعداد -> {
            دع حالة_النهاية: حالة_سياق_التجميع = حالة_سياق_التجميع.منتهي(النتيجة);
            أرجع اختيار.بعض(ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, حالة_النهاية));
        }
        | حالة_سياق_التجميع.نقل_واجهة -> {
            دع حالة_النهاية: حالة_سياق_التجميع = حالة_سياق_التجميع.منتهي(النتيجة);
            أرجع اختيار.بعض(ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, حالة_النهاية));
        }
        | حالة_سياق_التجميع.نقل_مسير -> {
            دع حالة_النهاية: حالة_سياق_التجميع = حالة_سياق_التجميع.منتهي(النتيجة);
            أرجع اختيار.بعض(ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, حالة_النهاية));
        }
        | حالة_سياق_التجميع.نقل_خلفية -> {
            دع حالة_النهاية: حالة_سياق_التجميع = حالة_سياق_التجميع.منتهي(النتيجة);
            أرجع اختيار.بعض(ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, حالة_النهاية));
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف علم_سياق_التجميع_ملغى(
    السياق: سياق_التجميع
): اختيار سياق_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.نقل_إعداد -> {
            دع حالة_الإلغاء: حالة_سياق_التجميع = حالة_سياق_التجميع.ملغى();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(الطلب, الإلغاء, حالة_الإلغاء);
            أرجع اختيار.بعض(التالي);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف خذ_نتيجة_التجميع(
    السياق: سياق_التجميع
): نتيجة_خذ_نتيجة_التجميع {
    طابق السياق مع
    | { الطلب: الطلب, الإلغاء: الإلغاء, الحالة: الحالة } -> {
        طابق الحالة مع
        | حالة_سياق_التجميع.منتهي(النتيجة) -> {
            دع حالة_الاستهلاك: حالة_سياق_التجميع = حالة_سياق_التجميع.مستهلك();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_الاستهلاك
            );
            أرجع نتيجة_خذ_نتيجة_التجميع.ناجح(التالي, النتيجة);
        }
        | حالة_سياق_التجميع.ملغى -> {
            دع حالة_الاستهلاك: حالة_سياق_التجميع = حالة_سياق_التجميع.مستهلك();
            دع التالي: سياق_التجميع = ابن_سياق_تجميع_بحالة(
                الطلب, الإلغاء, حالة_الاستهلاك
            );
            أرجع نتيجة_خذ_نتيجة_التجميع.ملغى(التالي);
        }
        | _ -> { أرجع نتيجة_خذ_نتيجة_التجميع.غير_صالح(); };
    };
}
