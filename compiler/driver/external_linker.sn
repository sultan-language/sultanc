استورد std.env.system;
استورد std.fs.metadata;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.fs.mutation;
استورد std.process.child;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.os.entropy;

// System linking for ELF executables SultanC's own ELF linker does not lay
// out (link/elf/target_policy.sn يستخدم_رابط_إلف_خارجي). The program object
// already carries SultanC's `_start` and the process-start globals, so the
// link is a plain static one: `ld.lld -static -e _start <object> <inputs>`.
// The linker is $SULTANC_LINKER when set, otherwise `ld.lld` on PATH.

عرف ضم_نصوص_ربط_خارجي(الأجزاء: &متجه نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف ملف_موجود_لرابط(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.ملف) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The first PATH directory holding `ld.lld`.
عرف ابحث_في_المسار_عن_رابط(): اختياري نص {
    دع اسم_المسار: نص = «PATH»;
    دع المسارات: نص;
    طابق متغير_بيئة_النظام(&اسم_المسار) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { المسارات := القيمة; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الطول_الكلي: طبيعي = الطول(المسارات) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        دع نهاية: منطقي = ف == الطول_الكلي;
        دع فاصل: متغير منطقي = نهاية;
        لو (!نهاية) { فاصل := المسارات[ف] == (0x3A مثل ط8); };
        لو (فاصل) {
            لو (ف > البداية) {
                دع البايتات: متغير متجه ط8 = [];
                دع ك: متغير طبيعي = البداية;
                طالما (ك < ف) { ألحق(البايتات, المسارات[ك]); ك := ك + 1; }
                ألحق_بايتات_نص(&متغير البايتات, «/ld.lld»);
                دع المرشح: نص = من_بايتات(&البايتات);
                لو (ملف_موجود_لرابط(&المرشح)) { أرجع اختياري.موجود(المرشح); };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف رابط_خارجي_متاح(): اختياري نص {
    دع الاسم: نص = «SULTANC_LINKER»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        لو (الطول(القيمة) > 0) { أرجع اختياري.موجود(القيمة); };
    }
    | _ -> { };
    أرجع ابحث_في_المسار_عن_رابط();
}

// A fresh name in the temporary directory for this link's files.
عرف بادئة_ملفات_ربط_خارجي(): نص {
    دع الدليل: متغير نص = «/tmp»;
    طابق الدليل_المؤقت_للنظام() مع
    | نتيجة.نجح(القيمة) -> { لو (الطول(القيمة) > 0) { الدليل := القيمة; }; }
    | نتيجة.خطأ(_) -> { };
    دع العشوائية: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    دع القيمة: متغير طبيعي = 0;
    طابق املأ_بايتات_عشوائية_النظام(&متغير العشوائية) مع
    | نتيجة.نجح(_) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < 8) {
            القيمة := (القيمة << 8) | (العشوائية[ف] مثل طبيعي);
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    دع الأجزاء: متغير متجه نص = [];
    ألحق(الأجزاء, الدليل);
    ألحق(الأجزاء, «/sultanc-link-»);
    ألحق(الأجزاء, عدد_إلى_نص((القيمة & 0x7fffffffffffffff) مثل عدد));
    أرجع ضم_نصوص_ربط_خارجي(&الأجزاء);
}

عام نوع نتيجة_ربط_خارجي =
    | نجح بنوع متجه ط8
    | لا_رابط
    | فشل بنوع نص
;

// Links the program object with the command-line link inputs into an
// executable and returns its bytes. Temporary files are removed afterwards.
عام عرف اربط_برابط_خارجي(
    الكائن: &متجه ط8, المدخلات: &متجه نص
): نتيجة_ربط_خارجي {
    دع الرابط: نص;
    طابق رابط_خارجي_متاح() مع
    | اختياري.موجود(القيمة) -> { الرابط := القيمة; }
    | اختياري.لا_شيء -> { أرجع نتيجة_ربط_خارجي.لا_رابط(); };
    دع البادئة: نص = بادئة_ملفات_ربط_خارجي();
    دع أجزاء_الكائن: متغير متجه نص = [];
    ألحق(أجزاء_الكائن, انسخ_نص(&البادئة));
    ألحق(أجزاء_الكائن, «.o»);
    دع مسار_الكائن: نص = ضم_نصوص_ربط_خارجي(&أجزاء_الكائن);
    دع أجزاء_الناتج: متغير متجه نص = [];
    ألحق(أجزاء_الناتج, انسخ_نص(&البادئة));
    ألحق(أجزاء_الناتج, «.out»);
    دع مسار_الناتج: نص = ضم_نصوص_ربط_خارجي(&أجزاء_الناتج);
    طابق اكتب_البايتات(&مسار_الكائن, الكائن) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_ربط_خارجي.فشل(مسار_الكائن); }
    | نتيجة.نجح(_) -> { };
    // The program path is argv[0]; these are the arguments after it.
    دع الوسائط: متغير متجه نص = [];
    ألحق(الوسائط, «-static»);
    ألحق(الوسائط, «-e»);
    ألحق(الوسائط, «_start»);
    ألحق(الوسائط, «-o»);
    ألحق(الوسائط, انسخ_نص(&مسار_الناتج));
    ألحق(الوسائط, انسخ_نص(&مسار_الكائن));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المدخلات) مثل طبيعي)) {
        ألحق(الوسائط, انسخ_نص(&(*المدخلات)[ف]));
        ف := ف + 1;
    }
    دع الحالة: نتيجة حالة_إنهاء, عدد = شغل_وانتظر(&الرابط, &الوسائط);
    دع حذف_الكائن: نتيجة عدد, عدد = أزل_ملفا(&مسار_الكائن);
    دع نجح_الربط: متغير منطقي = خطأ;
    طابق الحالة مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> { نجح_الربط := الرمز == 0; }
    | _ -> { };
    لو (!نجح_الربط) {
        دع حذف_الناتج: نتيجة عدد, عدد = أزل_ملفا(&مسار_الناتج);
        أرجع نتيجة_ربط_خارجي.فشل(الرابط);
    };
    طابق اقرأ_بايتات_ملف(&مسار_الناتج) مع
    | نتيجة.نجح(البايتات) -> {
        دع حذف_الناتج: نتيجة عدد, عدد = أزل_ملفا(&مسار_الناتج);
        أرجع نتيجة_ربط_خارجي.نجح(البايتات);
    }
    | نتيجة.خطأ(_) -> { أرجع نتيجة_ربط_خارجي.فشل(مسار_الناتج); };
}
