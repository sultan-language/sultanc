استورد std.env.system;
استورد std.fs.metadata;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.fs.mutation;
استورد std.process.child;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.fs.temporary;
استورد compiler.backend.provider.llvm.llvm_codegen;
استورد compiler.backend.target.target_model;
استورد compiler.link.linker;

// System linking for ELF executables SultanC's own ELF linker does not lay
// out (link/elf/target_policy.sn يستخدم_رابط_إلف_خارجي). The program object
// already carries SultanC's `_start` and the process-start globals, so the
// link is a plain static one: `ld.lld -static -e _start <object> <inputs>`.
// The linker is, in order: $SULTANC_LINKER; the `ld.lld` of the LLVM the
// compiler is linked with (`bin/ld.lld` beside the `lib/` holding libLLVM,
// the layout of an LLVM install); `ld.lld` on PATH.

عرف ضم_نصوص_ربط_خارجي(الأجزاء: &متجه نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف ملف_موجود_لرابط(المسار: &نص): منطقي {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(نوع_مسار.ملف) -> { أرجع صواب; }
    | نتيجة.نجح(نوع_مسار.وصلة_رمزية) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The first PATH directory holding `ld.lld`.
عرف ابحث_في_المسار_عن_رابط(): اختياري نص {
    دع اسم_المسار: نص = «PATH»;
    دع المسارات: نص;
    طابق متغير_بيئة_النظام(&اسم_المسار) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { المسارات := القيمة; }
    | _ -> { أرجع اختياري.لا_شيء(); };
    دع الطول_الكلي: طبيعي = الطول(المسارات) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        دع نهاية: منطقي = ف == الطول_الكلي;
        دع فاصل: متغير منطقي = نهاية;
        إذا (!نهاية) { فاصل := المسارات[ف] == (0x3A مثل ط8); };
        إذا (فاصل) {
            إذا (ف > البداية) {
                دع البايتات: متغير متجه ط8 = [];
                دع ك: متغير طبيعي = البداية;
                طالما (ك < ف) { ألحق(البايتات, المسارات[ك]); ك := ك + 1; }
                ألحق_بايتات_نص(&متغير البايتات, «/ld.lld»);
                دع المرشح: نص = من_بايتات(&البايتات);
                إذا (ملف_موجود_لرابط(&المرشح)) { أرجع اختياري.موجود(المرشح); };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// `<prefix>/bin/ld.lld` for the libLLVM at `<prefix>/lib/<name>`.
عرف رابط_بجوار_مكتبة_إل_إل_في_إم(): اختياري نص {
    طابق موقع_مكتبة_إل_إل_في_إم_المضيف() مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المكتبة) -> {
        // Drop the file name, then the `lib` directory.
        دع النهاية: متغير طبيعي = الطول(المكتبة) مثل طبيعي;
        دع الفواصل: متغير طبيعي = 0;
        طالما (النهاية > 0 && الفواصل < 2) {
            النهاية := النهاية - 1;
            إذا (المكتبة[النهاية] == (0x2F مثل ط8)) { الفواصل := الفواصل + 1; };
        }
        إذا (الفواصل < 2) { أرجع اختياري.لا_شيء(); };
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < النهاية) { ألحق(البايتات, المكتبة[ف]); ف := ف + 1; }
        ألحق_بايتات_نص(&متغير البايتات, «/bin/ld.lld»);
        دع المرشح: نص = من_بايتات(&البايتات);
        إذا (ملف_موجود_لرابط(&المرشح)) { أرجع اختياري.موجود(المرشح); };
        أرجع اختياري.لا_شيء();
    };
}

عام عرف رابط_خارجي_متاح(): اختياري نص {
    دع الاسم: نص = «SULTANC_LINKER»;
    طابق متغير_بيئة_النظام(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا (الطول(القيمة) > 0) { أرجع اختياري.موجود(القيمة); };
    }
    | _ -> { };
    طابق رابط_بجوار_مكتبة_إل_إل_في_إم() مع
    | اختياري.موجود(المسار) -> { أرجع اختياري.موجود(المسار); }
    | اختياري.لا_شيء -> { };
    أرجع ابحث_في_المسار_عن_رابط();
}

عام نوع نتيجة_ربط_خارجي =
    | نجح بنوع متجه ط8
    | لا_رابط
    // The linker ran and failed (its own messages are on stderr): its path
    // and exit status, or -1 when it could not be started or a signal ended
    // it.
    | فشل_الرابط بنوع (نص, عدد)
    // A file of the link (the program object, the output) could not be
    // written or read: its path.
    | فشل_ملف بنوع نص
;

// The link error for a failed external link (link/diagnostic_translation.sn
// reports it): ld.lld not found, ld.lld failed, or a file of the link.
عام عرف خطأ_ربط_لنتيجة_ربط_خارجي(
    النتيجة: نتيجة_ربط_خارجي,
    الهدف: معرف_هدف
): خطأ_ربط {
    طابق النتيجة مع
    | نتيجة_ربط_خارجي.لا_رابط -> { أرجع خطأ_ربط.رابط_خارجي_غير_موجود(الهدف); }
    | نتيجة_ربط_خارجي.فشل_الرابط(الرابط, الحالة) -> {
        أرجع خطأ_ربط.رابط_خارجي_فشل(الهدف, الرابط, الحالة);
    }
    | نتيجة_ربط_خارجي.فشل_ملف(المسار) -> { أرجع خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, 5); }
    | نتيجة_ربط_خارجي.نجح(_) -> { أرجع خطأ_ربط.خطة_غير_مدعومة(); };
}

// Links the program object with the command-line link inputs into an
// executable and returns its bytes. Temporary files are removed afterwards.
عام عرف اربط_برابط_خارجي(
    الكائن: &متجه ط8, المدخلات: &متجه نص
): نتيجة_ربط_خارجي {
    دع الرابط: نص;
    طابق رابط_خارجي_متاح() مع
    | اختياري.موجود(القيمة) -> { الرابط := القيمة; }
    | اختياري.لا_شيء -> { أرجع نتيجة_ربط_خارجي.لا_رابط(); };
    // The link's files live in a new private directory (std.fs.temporary:
    // a CSPRNG name, created exclusively), removed afterwards.
    دع بادئة_الدليل: نص = «sultanc-link-»;
    دع الدليل: نص;
    طابق أنشئ_دليلا_مؤقتا(&بادئة_الدليل) مع
    | نتيجة.نجح(القيمة) -> { الدليل := القيمة; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة_ربط_خارجي.فشل_ملف(بادئة_الدليل); };
    دع أجزاء_الكائن: متغير متجه نص = [];
    ألحق(أجزاء_الكائن, انسخ_نص(&الدليل));
    ألحق(أجزاء_الكائن, «/program.o»);
    دع مسار_الكائن: نص = ضم_نصوص_ربط_خارجي(&أجزاء_الكائن);
    دع أجزاء_الناتج: متغير متجه نص = [];
    ألحق(أجزاء_الناتج, انسخ_نص(&الدليل));
    ألحق(أجزاء_الناتج, «/program.out»);
    دع مسار_الناتج: نص = ضم_نصوص_ربط_خارجي(&أجزاء_الناتج);
    طابق اكتب_البايتات(&مسار_الكائن, الكائن) مع
    | نتيجة.خطأ(_) -> {
        دع حذف_الدليل: نتيجة عدد, عدد = أزل_دليلا(&الدليل);
        أرجع نتيجة_ربط_خارجي.فشل_ملف(مسار_الكائن);
    }
    | نتيجة.نجح(_) -> { };
    // The program path is argv[0]; these are the arguments after it.
    دع الوسائط: متغير متجه نص = [];
    ألحق(الوسائط, «-static»);
    ألحق(الوسائط, «-e»);
    ألحق(الوسائط, «_start»);
    ألحق(الوسائط, «-o»);
    ألحق(الوسائط, انسخ_نص(&مسار_الناتج));
    ألحق(الوسائط, انسخ_نص(&مسار_الكائن));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المدخلات) مثل طبيعي)) {
        ألحق(الوسائط, انسخ_نص(&(*المدخلات)[ف]));
        ف := ف + 1;
    }
    دع الحالة: نتيجة حالة_إنهاء, عدد = شغل_وانتظر(&الرابط, &الوسائط);
    دع حذف_الكائن: نتيجة عدد, عدد = أزل_ملفا(&مسار_الكائن);
    دع حالة_الخروج: متغير عدد = -1;
    طابق الحالة مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> { حالة_الخروج := الرمز; }
    | _ -> { };
    إذا (حالة_الخروج != 0) {
        دع حذف_الناتج: نتيجة عدد, عدد = أزل_ملفا(&مسار_الناتج);
        دع حذف_الدليل: نتيجة عدد, عدد = أزل_دليلا(&الدليل);
        أرجع نتيجة_ربط_خارجي.فشل_الرابط(الرابط, حالة_الخروج);
    };
    دع المقروء: نتيجة متجه ط8, عدد = اقرأ_بايتات_ملف(&مسار_الناتج);
    دع حذف_الناتج: نتيجة عدد, عدد = أزل_ملفا(&مسار_الناتج);
    دع حذف_الدليل: نتيجة عدد, عدد = أزل_دليلا(&الدليل);
    طابق المقروء مع
    | نتيجة.نجح(البايتات) -> { أرجع نتيجة_ربط_خارجي.نجح(البايتات); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة_ربط_خارجي.فشل_ملف(مسار_الناتج); };
}
