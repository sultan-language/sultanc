استورد std.text.from_bytes;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_metadata;
استورد compiler.frontend.module_loading.import_resolution;
استورد compiler.frontend.module_loading.source_locator;
استورد compiler.driver.driver_model;
استورد compiler.driver.package_graph;
استورد compiler.driver.package_environment;
استورد compiler.driver.std_location;
استورد std.fs.read_file;
استورد compiler.source.source_kind;
استورد std.bytes.compare;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.canonical;
استورد std.env.environment;
استورد std.text.compare;
استورد compiler.ispeak.keys.surface;
// Driver source-input ownership only: filesystem paths -> canonical Frontend module environment.
// Canonical module identity/loading semantics remain in Frontend.
// Direct/bootstrap source-file paths are configuration input only. They are reduced
// to a common configured root before any canonical Module Key is constructed.
نوع جزء_مسار_ملف_مصدر_مباشر = {
    البايتات: متجه ط8
};

// Every source path is made absolute before it is split (std.fs.canonical:
// the working directory joined to a relative path), so a ".." can be folded
// against real parents instead of being rejected or left to disagree with
// std.fs.path. الأجزاء[0] is the root as written in the host flavor ("/",
// "C:\\", a UNC share): paths on different drives never share a root.
// مطلق records whether the caller wrote an absolute path; عمق_دليل_العمل is
// the number of parts of the working directory, the configured root of
// relative inputs.
نوع مسار_ملف_مصدر_مباشر = {
    مطلق: منطقي,
    الأجزاء: متجه جزء_مسار_ملف_مصدر_مباشر,
    عمق_دليل_العمل: طبيعي
};

نوع نتيجة_مسار_ملف_مصدر_مباشر =
    | صالح بنوع مسار_ملف_مصدر_مباشر
    | غير_صالح
;

عام نوع إعداد_تجميع_مباشر = {
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    // Canonical keys for every explicitly supplied project source, in caller order.
    // Import-discovered modules remain owned by Frontend's Module loader.
    المفاتيح_المباشرة: متجه مفتاح_وحدة_مقنن
};

عام نوع نتيجة_إعداد_تجميع_مباشر =
    | جاهز بنوع إعداد_تجميع_مباشر
    | غير_صالح
;

عام نوع نتيجة_إعداد_تجميع_مباشر_مفصلة =
    | جاهز بنوع إعداد_تجميع_مباشر
    | مدخل_غير_صالح
    | رسم_غير_صالح بنوع خطأ_رسم_حزم
;

عرف انسخ_جزء_مسار_ملف_مصدر_مباشر(
    الأصل: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): جزء_مسار_ملف_مصدر_مباشر {
    دع النص: نص = *الأصل;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }
    دع الجزء: جزء_مسار_ملف_مصدر_مباشر = { البايتات: البايتات };
    أرجع الجزء;
}

عرف جزء_مسار_ملف_مصدر_نقطة(
    الجزء: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع القيمة: جزء_مسار_ملف_مصدر_مباشر = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل طبيعي) == 1)
        && (القيمة.البايتات[0] == 0x2E);
}

عرف جزء_مسار_ملف_مصدر_نقطتان(
    الجزء: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع القيمة: جزء_مسار_ملف_مصدر_مباشر = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل طبيعي) == 2)
        && (القيمة.البايتات[0] == 0x2E)
        && (القيمة.البايتات[1] == 0x2E);
}

عرف احذف_آخر_جزء_مسار_ملف_مصدر(
    الأصل: &متجه جزء_مسار_ملف_مصدر_مباشر
): متجه جزء_مسار_ملف_مصدر_مباشر {
    دع القيم: متجه جزء_مسار_ملف_مصدر_مباشر = *الأصل;
    دع الناتج: متغير متجه جزء_مسار_ملف_مصدر_مباشر = [];
    دع العدد: طبيعي = الطول(القيم) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما ((ف + 1) < العدد) {
        دع المرجع: &جزء_مسار_ملف_مصدر_مباشر = &القيم[ف];
        دع القيمة: جزء_مسار_ملف_مصدر_مباشر = انسخ_مملوكا_جزء_مسار_ملف_مصدر_مباشر(المرجع);
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The root of an absolute host path, with a Windows drive letter in upper
// case so "c:\\x" and "C:\\x" are one root.
عرف جزء_جذر_مسار_مصدر(المطلق: &نص): اختياري جزء_مسار_ملف_مصدر_مباشر {
    طابق جذر_المسار_بصيغة(المطلق, صيغة_مسار_المضيف()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجذر) -> {
        دع البايتات: متغير متجه ط8 = بايتات_من_نص(الجذر);
        إذا ((الطول(البايتات) مثل طبيعي) >= 2 && البايتات[1] == 0x3A
            && البايتات[0] >= 0x61 && البايتات[0] <= 0x7A) {
            البايتات[0] := البايتات[0] - 0x20;
        };
        دع الجزء: جزء_مسار_ملف_مصدر_مباشر = { البايتات: البايتات };
        أرجع اختياري.موجود(الجزء);
    };
}

// The parts of an absolute path: its root, then each component with "."
// dropped and ".." removing the previous one ("/.." stays "/", as POSIX).
عرف أجزاء_مسار_مطلق_مصدر(المطلق: &نص): اختياري متجه جزء_مسار_ملف_مصدر_مباشر {
    دع الأجزاء: متغير متجه جزء_مسار_ملف_مصدر_مباشر = [];
    طابق جزء_جذر_مسار_مصدر(المطلق) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجذر) -> { ألحق(الأجزاء, الجذر); };
    دع المكونات: متجه نص = مكونات_المسار(المطلق);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكونات) مثل طبيعي)) {
        دع المكون: نص = انسخ_نص(&المكونات[ف]);
        دع الجزء: جزء_مسار_ملف_مصدر_مباشر = انسخ_جزء_مسار_ملف_مصدر_مباشر(&المكون, 0, الطول(المكون) مثل طبيعي);
        إذا (جزء_مسار_ملف_مصدر_نقطة(&الجزء)) {
        } وإلا إذا (جزء_مسار_ملف_مصدر_نقطتان(&الجزء)) {
            إذا ((الطول(الأجزاء) مثل طبيعي) > 1) {
                الأجزاء := احذف_آخر_جزء_مسار_ملف_مصدر(&الأجزاء);
            };
        } وإلا {
            ألحق(الأجزاء, الجزء);
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الأجزاء);
}

عرف قنن_مسار_ملف_مصدر_مباشر(
    الأصل: &نص
): نتيجة_مسار_ملف_مصدر_مباشر {
    إذا ((الطول(*الأصل) مثل طبيعي) == 0) {
        أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح();
    };
    دع مطلق: منطقي = مسار_مطلق(الأصل);
    دع المطلق: نص;
    طابق حول_إلى_مسار_مطلق(الأصل) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح(); }
    | نتيجة.نجح(القيمة) -> { المطلق := القيمة; };
    دع الأجزاء: متجه جزء_مسار_ملف_مصدر_مباشر;
    طابق أجزاء_مسار_مطلق_مصدر(&المطلق) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح(); }
    | اختياري.موجود(القيمة) -> { الأجزاء := القيمة; };
    دع عمق_دليل_العمل: متغير طبيعي = 0;
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { إذا (!مطلق) { أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح(); }; }
    | نتيجة.نجح(الدليل) -> {
        طابق أجزاء_مسار_مطلق_مصدر(&الدليل) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(أجزاء_الدليل) -> { عمق_دليل_العمل := الطول(أجزاء_الدليل) مثل طبيعي; };
    };
    دع الناتج: مسار_ملف_مصدر_مباشر = {
        مطلق: مطلق,
        الأجزاء: الأجزاء,
        عمق_دليل_العمل: عمق_دليل_العمل
    };
    أرجع نتيجة_مسار_ملف_مصدر_مباشر.صالح(الناتج);
}

عرف جزءا_مسار_ملف_مصدر_متساويان(
    الأول: &جزء_مسار_ملف_مصدر_مباشر,
    الثاني: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع أ: جزء_مسار_ملف_مصدر_مباشر = *الأول;
    دع ب: جزء_مسار_ملف_مصدر_مباشر = *الثاني;
    أرجع متجها_بايتات_متساويان(&أ.البايتات, &ب.البايتات);
}

عرف عدد_أجزاء_مجلد_مسار_ملف_مصدر(
    المسار: &مسار_ملف_مصدر_مباشر
): طبيعي {
    دع القيمة: مسار_ملف_مصدر_مباشر = *المسار;
    دع العدد: طبيعي = الطول(القيمة.الأجزاء) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع 0;
    };
    أرجع العدد - 1;
}

// The number of leading parts the configured root takes. Relative CLI
// sources stay rooted at the invocation directory while they lie under it,
// so a root-only compile of compiler/main.sn keeps compiler/ in its logical
// path and imports that reach library/std do not escape the root. Otherwise
// (absolute inputs, or a relative one reaching above the working directory
// with "..") the root is the inputs' common directory. Different drives, or
// several sources sharing only the filesystem root, have no stable root.
عرف طول_جذر_مسار_ملف_المصدر_المشترك(
    المسارات: &متجه مسار_ملف_مصدر_مباشر
): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*المسارات) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع اختياري.لا_شيء();
    };
    دع الأول: &مسار_ملف_مصدر_مباشر = &(*المسارات)[0];
    دع المشترك: متغير طبيعي = عدد_أجزاء_مجلد_مسار_ملف_مصدر(الأول);
    دع كلها_نسبية: متغير منطقي = !(*الأول).مطلق;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        دع الحالي: &مسار_ملف_مصدر_مباشر = &(*المسارات)[ف];
        إذا ((*الحالي).مطلق) { كلها_نسبية := خطأ; };
        دع مجلد_الحالي: طبيعي = عدد_أجزاء_مجلد_مسار_ملف_مصدر(الحالي);
        إذا (المشترك > مجلد_الحالي) {
            المشترك := مجلد_الحالي;
        };
        دع ح: متغير طبيعي = 0;
        طالما (ح < المشترك) {
            إذا (!جزءا_مسار_ملف_مصدر_متساويان(&(*الأول).الأجزاء[ح], &(*الحالي).الأجزاء[ح])) {
                المشترك := ح;
            };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    إذا (المشترك == 0) { أرجع اختياري.لا_شيء(); };
    // Every input written relative and still inside the working directory:
    // the working directory is the root.
    دع العمق: طبيعي = (*الأول).عمق_دليل_العمل;
    إذا (كلها_نسبية && العمق > 0 && المشترك >= العمق) {
        أرجع اختياري.موجود(العمق);
    };
    إذا ((العدد > 1) && (المشترك <= 1)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(المشترك);
}

// The configured root as a host path, built from the folded parts (not by
// walking the parents of the text as written, which a ".." would mislead).
// A root at or below the working directory, from a relative source, keeps a
// relative spelling ("." or "compiler"): module files are then opened by
// relative paths, the same ones the source names. The working directory's
// absolute path only decides which parts are its own; it never reaches the
// filesystem, so a host whose getcwd is not the real directory (the WASI
// host reports "/", bootstrap-wasm/wasi.c, with "." preopened) reads the same
// files as a native one.
عرف مسار_جذر_مصادر_مباشرة(
    مسار_ملف_المصدر_الأول: &نص,
    المسار_الأول: &مسار_ملف_مصدر_مباشر,
    طول_الجذر: طبيعي
): اختياري نص {
    إذا (طول_الجذر == 0 || طول_الجذر > (الطول((*المسار_الأول).الأجزاء) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع العمق: طبيعي = (*المسار_الأول).عمق_دليل_العمل;
    إذا (!(*المسار_الأول).مطلق && العمق > 0 && طول_الجذر >= العمق) {
        دع النسبي: متغير نص = «.»;
        دع ح: متغير طبيعي = العمق;
        طالما (ح < طول_الجذر) {
            دع الجزء: نص = من_بايتات(&(*المسار_الأول).الأجزاء[ح].البايتات);
            النسبي := صل_المسار(&النسبي, &الجزء);
            ح := ح + 1;
        }
        أرجع اختياري.موجود(طبع_المسار(&النسبي));
    };
    دع الجذر: متغير نص = من_بايتات(&(*المسار_الأول).الأجزاء[0].البايتات);
    دع ف: متغير طبيعي = 1;
    طالما (ف < طول_الجذر) {
        دع الجزء: نص = من_بايتات(&(*المسار_الأول).الأجزاء[ف].البايتات);
        الجذر := صل_المسار(&الجذر, &الجزء);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(طبع_المسار(&الجذر));
}

عرف بايتات_مسار_منطقي_من_مسار_ملف_مصدر(
    المسار: &مسار_ملف_مصدر_مباشر,
    بداية_الجذر: طبيعي
): اختياري متجه ط8 {
    دع القيمة: مسار_ملف_مصدر_مباشر = *المسار;
    دع العدد: طبيعي = الطول(القيمة.الأجزاء) مثل طبيعي;
    إذا (بداية_الجذر >= العدد) {
        أرجع اختياري.لا_شيء();
    };

    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = بداية_الجذر;
    طالما (ف < العدد) {
        إذا (ف > بداية_الجذر) {
            ألحق(الناتج, 0x2F);
        };
        دع مرجع_الجزء: &جزء_مسار_ملف_مصدر_مباشر = &القيمة.الأجزاء[ف];
        دع الجزء: جزء_مسار_ملف_مصدر_مباشر = *مرجع_الجزء;
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(الجزء.البايتات) مثل طبيعي)) {
            ألحق(الناتج, الجزء.البايتات[ح]);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عرف انسخ_بايتات_إعداد_مباشر(
    الأصل: &متجه ط8
): متجه ط8 {
    دع القيمة: متجه ط8 = *الأصل;
    دع النسخة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        ألحق(النسخة, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع النسخة;
}

عرف أول_جزء_مسار_منطقي_مباشر(
    المسار: &متجه ط8
): اختياري متجه ط8 {
    دع القيمة: متجه ط8 = *المسار;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع اختياري.لا_شيء();
    };
    دع الجزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (القيمة[ف] != 0x2F)) {
        ألحق(الجزء, القيمة[ف]);
        ف := ف + 1;
    }
    إذا ((الطول(الجزء) مثل طبيعي) == 0) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الجزء);
}

عرف سجل_تهجئة_مسار_مباشر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    المسار: &متجه ط8,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    // The common root spelling is registered once by ابن_إعداد_تجميع_مباشر.
    دع المسار_العام: متجه ط8 = انسخ_بايتات_إعداد_مباشر(المسار);
    طابق أضف_مسارا_عاما_لوحدة(البيئة, الجذر, المسار_العام, المفتاح) مع
    | نتيجة_ربط_مسار_عام.أضيف -> {
        أرجع صواب;
    }
    | نتيجة_ربط_مسار_عام.موجود -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}


// Without a package graph: the file, its relative imports and std. The
// configured root is the common directory of the inputs (the working
// directory for relative ones); no manifest is looked for.
عرف ابن_إعداد_تجميع_مباشر_بلا_رسم_داخلي(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص,
    رسم_المكتبة: &رسم_حزم
): نتيجة_إعداد_تجميع_مباشر_مفصلة {
    دع المدخلات: متغير متجه نص = [];
    دع مسار_الدخول: نص = انسخ_نص(مسار_ملف_الدخول);
    ألحق(المدخلات, مسار_الدخول);
    دع الإضافية: متجه نص = *مسارات_ملفات_المصدر_الإضافية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الإضافية) مثل طبيعي)) {
        دع مرجع_مسار_ملف_المصدر: &نص = &الإضافية[ف];
        دع مسار_ملف_المصدر: نص = انسخ_نص(مرجع_مسار_ملف_المصدر);
        ألحق(المدخلات, مسار_ملف_المصدر);
        ف := ف + 1;
    }

    دع المسارات: متغير متجه مسار_ملف_مصدر_مباشر = [];
    ف := 0;
    طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
        طابق قنن_مسار_ملف_مصدر_مباشر(&المدخلات[ف]) مع
        | نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح -> {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        }
        | نتيجة_مسار_ملف_مصدر_مباشر.صالح(المسار) -> {
            // A filesystem root alone names a directory, not a source file.
            إذا ((الطول(المسار.الأجزاء) مثل طبيعي) <= 1) {
                أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
            };
            ألحق(المسارات, المسار);
        };
        ف := ف + 1;
    }

    دع بداية_الجذر: متغير طبيعي = 0;
    طابق طول_جذر_مسار_ملف_المصدر_المشترك(&المسارات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
    }
    | اختياري.موجود(الطول_المشترك) -> {
        بداية_الجذر := الطول_المشترك;
    };

    دع البيئة: متغير بيئة_وحدات_منطقية = بيئة_وحدات_منطقية_جديدة();
    دع الجذر: معرف_جذر_مكتبة = خصص_جذر_مكتبة(&متغير البيئة);
    دع مسار_جذر_المشروع: نص;
    طابق مسار_جذر_مصادر_مباشرة(&المدخلات[0], &المسارات[0], بداية_الجذر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح(); }
    | اختياري.موجود(القيمة) -> { مسار_جذر_المشروع := القيمة; };
    طابق أضف_جذر_مصدر(&متغير البيئة, الجذر, &مسار_جذر_المشروع) مع
    | نتيجة_تسجيل_جذر_مصدر.أضيف -> { }
    | نتيجة_تسجيل_جذر_مصدر.موجود -> { }
    | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح(); };
    دع المفتاح_الجذري: متغير مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
        الجذر,
        مسار_وحدة_منطقي_فارغ()
    );
    دع المفاتيح_المباشرة: متغير متجه مفتاح_وحدة_مقنن = [];

    ف := 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) {
        دع البايتات: متغير متجه ط8 = [];
        طابق بايتات_مسار_منطقي_من_مسار_ملف_مصدر(&المسارات[ف], بداية_الجذر) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        }
        | اختياري.موجود(القيمة) -> {
            البايتات := القيمة;
        };

        دع المسار_المنطقي: متغير مسار_وحدة_منطقي = مسار_وحدة_منطقي_فارغ();
        طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
            المسار_المنطقي := المسار;
        };

        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            الجذر,
            المسار_المنطقي
        );
        دع مرجع_المفتاح_المباشر: &مفتاح_وحدة_مقنن = &المفتاح;
        دع مفتاح_للقائمة: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(مرجع_المفتاح_المباشر);
        دع مفتاح_للجذر: مفتاح_وحدة_مقنن = انسخ_مملوكا_مفتاح_وحدة_مقنن(مرجع_المفتاح_المباشر);
        إذا (ف == 0) {
            طابق أول_جزء_مسار_منطقي_مباشر(&البايتات) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
            }
            | اختياري.موجود(التهجئة) -> {
                طابق أضف_ربط_اسم_جذر(&متغير البيئة, الجذر, التهجئة, الجذر) مع
                | نتيجة_ربط_جذر.أضيف -> { }
                | نتيجة_ربط_جذر.موجود -> { }
                | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح(); };
            };
        };
        دع مرجع_مسار_ملف_المصدر: &نص = &المدخلات[ف];
        دع مسار_ملف_المصدر: نص = انسخ_نص(مرجع_مسار_ملف_المصدر);
        طابق أضف_موقع_مصدر_وحدة(
            &متغير البيئة,
            &المفتاح,
            مسار_ملف_المصدر
        ) مع
        | نتيجة_تسجيل_موقع_مصدر.أضيف -> { }
        | نتيجة_تسجيل_موقع_مصدر.موجود -> { }
        | _ -> {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        };

        إذا (!سجل_تهجئة_مسار_مباشر(
            &متغير البيئة,
            الجذر,
            &البايتات,
            &المفتاح
        )) {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        };

        ألحق(المفاتيح_المباشرة, مفتاح_للقائمة);
        إذا (ف == 0) {
            المفتاح_الجذري := مفتاح_للجذر;
        };
        ف := ف + 1;
    }

    طابق جهز_بيئة_حزم_بلا_رسم(&متغير البيئة, الجذر, رسم_المكتبة) مع
    | نتيجة_إعداد_حزم.جاهز -> { }
    | نتيجة_إعداد_حزم.خطأ(الخطأ) -> {
        أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ);
    };

    دع الإعداد: إعداد_تجميع_مباشر = {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        المفاتيح_المباشرة: المفاتيح_المباشرة
    };
    أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.جاهز(الإعداد);
}


عرف مسار_مصدر_نسبة_إلى_جذر_بيان(
    مسار_المصدر: &نص,
    جذر_المصدر: &نص
): اختياري متجه ط8 {
    دع المصدر: مسار_ملف_مصدر_مباشر;
    طابق قنن_مسار_ملف_مصدر_مباشر(مسار_المصدر) مع
    | نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_مسار_ملف_مصدر_مباشر.صالح(القيمة) -> { المصدر := القيمة; };

    // Both are made absolute and folded the same way (قنن_مسار_ملف_مصدر_مباشر),
    // so a manifest directory written with ".." or "." matches its sources.
    دع جذر_محلل: مسار_ملف_مصدر_مباشر;
    طابق قنن_مسار_ملف_مصدر_مباشر(جذر_المصدر) مع
    | نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_مسار_ملف_مصدر_مباشر.صالح(القيمة) -> { جذر_محلل := القيمة; };
    دع عدد_أجزاء_الجذر: طبيعي = الطول(جذر_محلل.الأجزاء) مثل طبيعي;
    إذا ((الطول(المصدر.الأجزاء) مثل طبيعي) <= عدد_أجزاء_الجذر) {
        أرجع اختياري.لا_شيء();
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_أجزاء_الجذر) {
        إذا (!جزءا_مسار_ملف_مصدر_متساويان(
            &المصدر.الأجزاء[ف], &جذر_محلل.الأجزاء[ف]
        )) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع بايتات_مسار_منطقي_من_مسار_ملف_مصدر(
        &المصدر, عدد_أجزاء_الجذر
    );
}

// The direct sources of a prepared root package (package_environment.sn): each
// lies under its source root, and is keyed by its path there.
عرف ابن_إعداد_تجميع_لحزمة_جذر_داخلي(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص,
    البيئة_المعدة: بيئة_وحدات_منطقية,
    المعدة: &حزمة_جذر_معدة,
    مسار_الرسم: &نص
): نتيجة_إعداد_تجميع_مباشر_مفصلة {
    دع البيئة: متغير بيئة_وحدات_منطقية = البيئة_المعدة;
    دع الجذر: معرف_جذر_مكتبة = (*المعدة).الجذر;
    دع جذر_المصدر: &نص = &(*المعدة).جذر_المصدر;
    دع المدخلات: متغير متجه نص = [];
    دع مسار_الدخول: نص = انسخ_نص(مسار_ملف_الدخول);
    ألحق(المدخلات, مسار_الدخول);
    دع الإضافية: متجه نص = *مسارات_ملفات_المصدر_الإضافية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الإضافية) مثل طبيعي)) {
        دع مرجع_المسار: &نص = &الإضافية[ف];
        دع المسار: نص = انسخ_نص(مرجع_المسار);
        ألحق(المدخلات, المسار);
        ف := ف + 1;
    }

    دع المفتاح_الجذري: متغير مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
        الجذر, مسار_وحدة_منطقي_فارغ()
    );
    دع المفاتيح_المباشرة: متغير متجه مفتاح_وحدة_مقنن = [];
    ف := 0;
    طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
        دع البايتات: متجه ط8;
        طابق مسار_مصدر_نسبة_إلى_جذر_بيان(&المدخلات[ف], جذر_المصدر) مع
        | اختياري.لا_شيء -> {
            // A source outside the root package is not one of its modules.
            إذا ((الطول(*مسار_الرسم) مثل طبيعي) > 0) {
                أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(خطأ_رسم_بلا_موقع(
                    مسار_الرسم, مفتاح_نص_مترجم.مصدر_خارج_حزمة_الجذر()
                ));
            };
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        }
        | اختياري.موجود(القيمة) -> { البايتات := القيمة; };
        دع المسار_المنطقي: مسار_وحدة_منطقي;
        طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح();
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> { المسار_المنطقي := المسار; };
        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            الجذر, المسار_المنطقي
        );
        دع مرجع_مسار_المدخل: &نص = &المدخلات[ف];
        دع مسار_المدخل: نص = انسخ_نص(مرجع_مسار_المدخل);
        طابق أضف_موقع_مصدر_وحدة(
            &متغير البيئة, &المفتاح, مسار_المدخل
        ) مع
        | نتيجة_تسجيل_موقع_مصدر.أضيف -> { }
        | نتيجة_تسجيل_موقع_مصدر.موجود -> { }
        | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح(); };
        إذا (!سجل_تهجئة_مسار_مباشر(
            &متغير البيئة, الجذر, &البايتات, &المفتاح
        )) { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح(); };
        دع نسخة_المفتاح: مفتاح_وحدة_مقنن = انسخ_مفتاح_وحدة_مقنن(&المفتاح);
        ألحق(المفاتيح_المباشرة, نسخة_المفتاح);
        إذا (ف == 0) { المفتاح_الجذري := انسخ_مفتاح_وحدة_مقنن(&المفتاح); };
        ف := ف + 1;
    }

    دع الإعداد: إعداد_تجميع_مباشر = {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        المفاتيح_المباشرة: المفاتيح_المباشرة
    };
    أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.جاهز(الإعداد);
}

// The standard library, which the compiler knows and finds by its layout
// ($SULTANC_STD, ./library or next to the compiler: std_location.sn).
عرف اقرأ_رسم_المكتبة_القياسية(): نتيجة رسم_حزم, خطأ_رسم_حزم {
    أرجع رسم_المكتبة_القياسية();
}

// A compilation without a package graph. A source of the standard library
// itself is compiled as std, the root package; any other as a standalone file.
عام عرف ابن_إعداد_تجميع_مباشر_مفصل(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص
): نتيجة_إعداد_تجميع_مباشر_مفصلة {
    دع رسم_المكتبة: رسم_حزم;
    طابق اقرأ_رسم_المكتبة_القياسية() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ); }
    | نتيجة.نجح(القيمة) -> { رسم_المكتبة := القيمة; };
    دع جذر_المكتبة: &نص = &رسم_المكتبة.الحزم[0].جذر_المصدر;
    طابق مسار_مصدر_نسبة_إلى_جذر_بيان(مسار_ملف_الدخول, جذر_المكتبة) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> {
        دع البيئة: متغير بيئة_وحدات_منطقية = بيئة_وحدات_منطقية_جديدة();
        طابق جهز_بيئة_المكتبة_مشروعا(&متغير البيئة, &رسم_المكتبة) مع
        | نتيجة_إعداد_رسم.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ); }
        | نتيجة_إعداد_رسم.جاهز(المعدة) -> {
            دع بلا_رسم: نص = «»;
            أرجع ابن_إعداد_تجميع_لحزمة_جذر_داخلي(
                مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية, البيئة, &المعدة, &بلا_رسم
            );
        };
    };
    أرجع ابن_إعداد_تجميع_مباشر_بلا_رسم_داخلي(
        مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية, &رسم_المكتبة
    );
}

// A compilation with the package graph whose text is نص_الرسم, named
// مسار_الرسم (in diagnostics, and for its relative paths). Tooling passes an
// unsaved graph this way; the file variant below reads the file and calls it.
عام عرف ابن_إعداد_تجميع_مباشر_مفصل_برسم_نصي(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص,
    مسار_الرسم: &نص,
    نص_الرسم: &نص
): نتيجة_إعداد_تجميع_مباشر_مفصلة {
    دع الرسم: رسم_حزم;
    طابق اقرأ_رسم_حزم_من_نص(مسار_الرسم, نص_الرسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الرسم := القيمة; };
    دع رسم_المكتبة: رسم_حزم;
    طابق اقرأ_رسم_المكتبة_القياسية() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ); }
    | نتيجة.نجح(القيمة) -> { رسم_المكتبة := القيمة; };
    دع البيئة: متغير بيئة_وحدات_منطقية = بيئة_وحدات_منطقية_جديدة();
    طابق جهز_بيئة_حزم_لرسم(&متغير البيئة, &الرسم, &رسم_المكتبة) مع
    | نتيجة_إعداد_رسم.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(الخطأ); }
    | نتيجة_إعداد_رسم.جاهز(المعدة) -> {
        أرجع ابن_إعداد_تجميع_لحزمة_جذر_داخلي(
            مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية, البيئة, &المعدة, مسار_الرسم
        );
    };
}

// The same with the package graph in the file مسار_الرسم (--package-graph);
// «» compiles without one.
عام عرف ابن_إعداد_تجميع_مباشر_مفصل_برسم(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص,
    مسار_الرسم: &نص
): نتيجة_إعداد_تجميع_مباشر_مفصلة {
    إذا ((الطول(*مسار_الرسم) مثل طبيعي) == 0) {
        أرجع ابن_إعداد_تجميع_مباشر_مفصل(مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية);
    };
    طابق اقرأ_الملف(مسار_الرسم) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة_إعداد_تجميع_مباشر_مفصلة.رسم_غير_صالح(خطأ_رسم_بلا_موقع(
            مسار_الرسم, مفتاح_نص_مترجم.تعذر_قراءة_رسم_حزم()
        ));
    }
    | نتيجة.نجح(النص) -> {
        أرجع ابن_إعداد_تجميع_مباشر_مفصل_برسم_نصي(
            مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية, مسار_الرسم, &النص
        );
    };
}

عام عرف ابن_إعداد_تجميع_مباشر(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص
): نتيجة_إعداد_تجميع_مباشر {
    طابق ابن_إعداد_تجميع_مباشر_مفصل(
        مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية
    ) مع
    | نتيجة_إعداد_تجميع_مباشر_مفصلة.جاهز(الإعداد) -> {
        أرجع نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد);
    }
    | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح(); };
}


// Explicit module sources (--module-source=<module>=<file>).
//
// Each binding names a logical module exactly as an import of the root module
// would spell it (dotted, never relative) and the file to compile as that
// module's source. The module is resolved by the canonical import resolver
// from the root ModuleKey, so the binding has the same ModuleKey as every
// import of the module, and is recorded as the explicit source location of
// that key (logical_environment.sn أضف_موقع_مصدر_وحدة), which the source
// locator consults before deriving a path from the root. Nothing else about
// module identity, loading or target selection changes.
//
// A binding replaces the source of an existing module of a non-std root: an
// unknown module is reported (no silently unused binding), the trusted std
// root cannot be rebound, a module may be bound once, and a direct input
// keeps its own source. Builds use this to choose compiler-build capabilities
// of the program they compile, such as binding the LLVM provider to a stub
// for a Native-only compiler (docs/en/internals/compiler-architecture.md,
// "Compiler-build capabilities").
عام نوع نتيجة_ربط_مصادر_وحدات =
    | نجح
    | وحدة_غير_موجودة بنوع نص
    | مصدر_غير_مقروء بنوع نص
    | نوع_مصدر_غير_معروف بنوع نص
    | تعارض بنوع نص
;

عرف مرجع_وحدة_مسماة_من_تهجئة(التهجئة: &نص): اختياري متجه ط8 {
    دع الأصل: نص = *التهجئة;
    دع العدد: طبيعي = الطول(الأصل) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع البايت: ط8 = الأصل[ف];
        // A logical module spelling is dotted; a path spelling (or a relative
        // ./ ../ reference) is not a module name.
        إذا (البايت == 0x2F || البايت == 0x5C) { أرجع اختياري.لا_شيء(); };
        إذا (البايت == 0x2E) {
            إذا (ف == 0 || ف + 1 >= العدد || الأصل[ف - 1] == 0x2E) {
                أرجع اختياري.لا_شيء();
            };
            ألحق(الناتج, 0x2F);
        } وإلا {
            ألحق(الناتج, البايت);
        };
        ف := ف + 1;
    }
    // Exactly the reference a named import produces
    // (module_loader.sn مرجع_مسار_استيراد_مسمى_كبايتات).
    ألحق(الناتج, 0x2E);
    ألحق(الناتج, 0x73);
    ألحق(الناتج, 0x6E);
    أرجع اختياري.موجود(الناتج);
}

عام عرف اربط_مصادر_وحدات_صريحة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    المفتاح_الجذري: &مفتاح_وحدة_مقنن,
    الروابط: &متجه ربط_مصدر_وحدة_عملية
): نتيجة_ربط_مصادر_وحدات {
    دع العدد: طبيعي = الطول(*الروابط) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع مرجع_الربط: &ربط_مصدر_وحدة_عملية = &(*الروابط)[ف];
        دع مرجع_اسم_الوحدة: &نص = &(*مرجع_الربط).الوحدة;
        دع مرجع_مسار_المصدر: &نص = &(*مرجع_الربط).المصدر;
        دع اسم_الوحدة: نص = انسخ_نص(مرجع_اسم_الوحدة);
        دع مسار_المصدر: نص = انسخ_نص(مرجع_مسار_المصدر);
        دع المرجع: متجه ط8;
        طابق مرجع_وحدة_مسماة_من_تهجئة(&اسم_الوحدة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_ربط_مصادر_وحدات.وحدة_غير_موجودة(اسم_الوحدة); }
        | اختياري.موجود(القيمة) -> { المرجع := القيمة; };
        دع المفتاح: مفتاح_وحدة_مقنن;
        طابق حل_استيراد_بجذر_مسمى(البيئة, المفتاح_الجذري, &المرجع) مع
        | نتيجة_حل_استيراد.خطأ(_) -> {
            أرجع نتيجة_ربط_مصادر_وحدات.وحدة_غير_موجودة(اسم_الوحدة);
        }
        | نتيجة_حل_استيراد.محلول(القيمة) -> { المفتاح := القيمة; };
        طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
        | اختياري.موجود(الجذر_القياسي) -> {
            إذا (معرفا_جذر_مكتبة_متساويان(الجذر_القياسي, المفتاح.الجذر)) {
                أرجع نتيجة_ربط_مصادر_وحدات.تعارض(اسم_الوحدة);
            };
        }
        | اختياري.لا_شيء -> { };
        // Direct inputs and earlier bindings already own an explicit source.
        طابق موقع_مصدر_لمفتاح(البيئة, &المفتاح) مع
        | اختياري.موجود(_) -> { أرجع نتيجة_ربط_مصادر_وحدات.تعارض(اسم_الوحدة); }
        | اختياري.لا_شيء -> { };
        طابق حدد_مصدر_وحدة(البيئة, &المفتاح) مع
        | نتيجة_تحديد_مصدر.خطأ(_) -> {
            أرجع نتيجة_ربط_مصادر_وحدات.وحدة_غير_موجودة(اسم_الوحدة);
        }
        | نتيجة_تحديد_مصدر.موجود(_) -> { };
        إذا (!هو_مسار_مصدر_سلطان(&مسار_المصدر)) {
            أرجع نتيجة_ربط_مصادر_وحدات.نوع_مصدر_غير_معروف(مسار_المصدر);
        };
        دع مسار_للتسجيل: نص = انسخ_نص(مرجع_مسار_المصدر);
        طابق أضف_موقع_مصدر_وحدة(البيئة, &المفتاح, مسار_للتسجيل) مع
        | نتيجة_تسجيل_موقع_مصدر.أضيف -> { }
        | _ -> { أرجع نتيجة_ربط_مصادر_وحدات.تعارض(اسم_الوحدة); };
        طابق حدد_مصدر_وحدة(البيئة, &المفتاح) مع
        | نتيجة_تحديد_مصدر.خطأ(_) -> {
            أرجع نتيجة_ربط_مصادر_وحدات.مصدر_غير_مقروء(مسار_المصدر);
        }
        | نتيجة_تحديد_مصدر.موجود(_) -> { };
        ف := ف + 1;
    }
    أرجع نتيجة_ربط_مصادر_وحدات.نجح();
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_جزء_مسار_ملف_مصدر_مباشر(القيمة: &جزء_مسار_ملف_مصدر_مباشر): جزء_مسار_ملف_مصدر_مباشر {
    دع الناتج: جزء_مسار_ملف_مصدر_مباشر = {
        البايتات: انسخ_بايتات(&(*القيمة).البايتات)
    };
    أرجع الناتج;
}

