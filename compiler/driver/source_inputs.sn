استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_metadata;
استورد std.bytes.compare;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.text.compare;
// Driver source-input ownership only: filesystem paths -> canonical Frontend module environment.
// Canonical module identity/loading semantics remain in Frontend.
// Direct/bootstrap source-file paths are configuration input only. They are reduced
// to a common configured root before any canonical Module Key is constructed.
نوع جزء_مسار_ملف_مصدر_مباشر = {
    البايتات: متجه غ8
};

نوع مسار_ملف_مصدر_مباشر = {
    مطلق: منطقي,
    الأجزاء: متجه جزء_مسار_ملف_مصدر_مباشر
};

نوع نتيجة_مسار_ملف_مصدر_مباشر =
    | صالح بنوع مسار_ملف_مصدر_مباشر
    | غير_صالح
;

عام نوع إعداد_تجميع_مباشر = {
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    // Canonical keys for every explicitly supplied project source, in caller order.
    // Import-discovered modules remain owned by Frontend's Module loader.
    المفاتيح_المباشرة: متجه مفتاح_وحدة_مقنن
};

عام نوع نتيجة_إعداد_تجميع_مباشر =
    | جاهز بنوع إعداد_تجميع_مباشر
    | غير_صالح
;

عرف انسخ_جزء_مسار_ملف_مصدر_مباشر(
    الأصل: &نص,
    البداية: غير_موقع,
    النهاية: غير_موقع
): جزء_مسار_ملف_مصدر_مباشر {
    دع النص: نص = *الأصل;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }
    دع الجزء: جزء_مسار_ملف_مصدر_مباشر = { البايتات: البايتات };
    أرجع الجزء;
}

عرف جزء_مسار_ملف_مصدر_نقطة(
    الجزء: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع القيمة: جزء_مسار_ملف_مصدر_مباشر = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل غير_موقع) == 1)
        && (القيمة.البايتات[0] == 0x2E);
}

عرف جزء_مسار_ملف_مصدر_نقطتان(
    الجزء: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع القيمة: جزء_مسار_ملف_مصدر_مباشر = *الجزء;
    أرجع ((الطول(القيمة.البايتات) مثل غير_موقع) == 2)
        && (القيمة.البايتات[0] == 0x2E)
        && (القيمة.البايتات[1] == 0x2E);
}

عرف احذف_آخر_جزء_مسار_ملف_مصدر(
    الأصل: &متجه جزء_مسار_ملف_مصدر_مباشر
): متجه جزء_مسار_ملف_مصدر_مباشر {
    دع القيم: متجه جزء_مسار_ملف_مصدر_مباشر = *الأصل;
    دع الناتج: متغير متجه جزء_مسار_ملف_مصدر_مباشر = [];
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما ((ف + 1) < العدد) {
        دع المرجع: &جزء_مسار_ملف_مصدر_مباشر = &القيم[ف];
        دع القيمة: جزء_مسار_ملف_مصدر_مباشر = *المرجع;
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف قنن_مسار_ملف_مصدر_مباشر(
    الأصل: &نص
): نتيجة_مسار_ملف_مصدر_مباشر {
    دع النص: نص = *الأصل;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح();
    };

    دع مطلق: منطقي = النص[0] == 0x2F;
    دع الأجزاء: متغير متجه جزء_مسار_ملف_مصدر_مباشر = [];
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف <= العدد) {
        دع نهاية_جزء: متغير منطقي = ف == العدد;
        لو (!نهاية_جزء) {
            نهاية_جزء := النص[ف] == 0x2F;
        };
        لو (نهاية_جزء) {
            لو (ف > البداية) {
                دع الجزء: جزء_مسار_ملف_مصدر_مباشر =
                    انسخ_جزء_مسار_ملف_مصدر_مباشر(&النص, البداية, ف);
                لو (جزء_مسار_ملف_مصدر_نقطة(&الجزء)) {
                } وإلا لو (جزء_مسار_ملف_مصدر_نقطتان(&الجزء)) {
                    لو ((الطول(الأجزاء) مثل غير_موقع) == 0) {
                        أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح();
                    };
                    الأجزاء := احذف_آخر_جزء_مسار_ملف_مصدر(&الأجزاء);
                } وإلا {
                    ألحق(الأجزاء, الجزء);
                };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }

    لو ((الطول(الأجزاء) مثل غير_موقع) == 0) {
        أرجع نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح();
    };
    دع الناتج: مسار_ملف_مصدر_مباشر = {
        مطلق: مطلق,
        الأجزاء: الأجزاء
    };
    أرجع نتيجة_مسار_ملف_مصدر_مباشر.صالح(الناتج);
}

عرف جزءا_مسار_ملف_مصدر_متساويان(
    الأول: &جزء_مسار_ملف_مصدر_مباشر,
    الثاني: &جزء_مسار_ملف_مصدر_مباشر
): منطقي {
    دع أ: جزء_مسار_ملف_مصدر_مباشر = *الأول;
    دع ب: جزء_مسار_ملف_مصدر_مباشر = *الثاني;
    أرجع متجها_بايتات_متساويان(&أ.البايتات, &ب.البايتات);
}

عرف عدد_أجزاء_مجلد_مسار_ملف_مصدر(
    المسار: &مسار_ملف_مصدر_مباشر
): غير_موقع {
    دع القيمة: مسار_ملف_مصدر_مباشر = *المسار;
    دع العدد: غير_موقع = الطول(القيمة.الأجزاء) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع 0;
    };
    أرجع العدد - 1;
}

عرف طول_جذر_مسار_ملف_المصدر_المشترك(
    المسارات: &متجه مسار_ملف_مصدر_مباشر
): اختيار غير_موقع {
    دع القيم: متجه مسار_ملف_مصدر_مباشر = *المسارات;
    لو ((الطول(القيم) مثل غير_موقع) == 0) {
        أرجع اختيار.لا_شيء();
    };

    دع مرجع_الأول: &مسار_ملف_مصدر_مباشر = &القيم[0];
    دع الأول: مسار_ملف_مصدر_مباشر = *مرجع_الأول;
    دع مطلق: منطقي = الأول.مطلق;

    // Relative CLI source paths are rooted at the invocation directory. Keep that
    // configured root stable regardless of how many source paths the caller supplied;
    // otherwise a root-only compile of compiler/main.sn incorrectly makes compiler/
    // the logical root and imports that reach library/std escape it.
    لو (!مطلق) {
        أرجع اختيار.بعض(0);
    };

    دع المشترك: متغير غير_موقع = عدد_أجزاء_مجلد_مسار_ملف_مصدر(&الأول);
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع مرجع_الحالي: &مسار_ملف_مصدر_مباشر = &القيم[ف];
        دع الحالي: مسار_ملف_مصدر_مباشر = *مرجع_الحالي;
        لو (الحالي.مطلق != مطلق) {
            أرجع اختيار.لا_شيء();
        };
        دع مجلد_الحالي: غير_موقع = عدد_أجزاء_مجلد_مسار_ملف_مصدر(&الحالي);
        لو (المشترك > مجلد_الحالي) {
            المشترك := مجلد_الحالي;
        };
        دع ح: متغير غير_موقع = 0;
        بينما (ح < المشترك) {
            لو (!جزءا_مسار_ملف_مصدر_متساويان(&الأول.الأجزاء[ح], &الحالي.الأجزاء[ح])) {
                المشترك := ح;
            };
            ح := ح + 1;
        }
        ف := ف + 1;
    }

    // Multiple unrelated absolute trees have no relocation-stable configured root.
    لو (مطلق && ((الطول(القيم) مثل غير_موقع) > 1) && (المشترك == 0)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(المشترك);
}

عرف مسار_جذر_مصادر_مباشرة(
    مسار_ملف_المصدر_الأول: &نص,
    المسار_الأول: &مسار_ملف_مصدر_مباشر,
    طول_الجذر: غير_موقع
): اختيار نص {
    دع العمق_الكلي: غير_موقع = عدد_أجزاء_مجلد_مسار_ملف_مصدر(المسار_الأول);
    لو (طول_الجذر > العمق_الكلي) { أرجع اختيار.لا_شيء(); };
    دع الجذر: متغير نص;
    طابق أب_المسار(مسار_ملف_المصدر_الأول) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الجذر := القيمة; };
    دع العمق: متغير غير_موقع = العمق_الكلي;
    بينما (العمق > طول_الجذر) {
        طابق أب_المسار(&الجذر) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الجذر := القيمة; };
        العمق := العمق - 1;
    }
    أرجع اختيار.بعض(طبع_المسار(&الجذر));
}

عرف بايتات_مسار_منطقي_من_مسار_ملف_مصدر(
    المسار: &مسار_ملف_مصدر_مباشر,
    بداية_الجذر: غير_موقع
): اختيار متجه غ8 {
    دع القيمة: مسار_ملف_مصدر_مباشر = *المسار;
    دع العدد: غير_موقع = الطول(القيمة.الأجزاء) مثل غير_موقع;
    لو (بداية_الجذر >= العدد) {
        أرجع اختيار.لا_شيء();
    };

    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = بداية_الجذر;
    بينما (ف < العدد) {
        لو (ف > بداية_الجذر) {
            ألحق(الناتج, 0x2F);
        };
        دع مرجع_الجزء: &جزء_مسار_ملف_مصدر_مباشر = &القيمة.الأجزاء[ف];
        دع الجزء: جزء_مسار_ملف_مصدر_مباشر = *مرجع_الجزء;
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(الجزء.البايتات) مثل غير_موقع)) {
            ألحق(الناتج, الجزء.البايتات[ح]);
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف انسخ_بايتات_إعداد_مباشر(
    الأصل: &متجه غ8
): متجه غ8 {
    دع القيمة: متجه غ8 = *الأصل;
    دع النسخة: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        ألحق(النسخة, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع النسخة;
}

عرف أول_جزء_مسار_منطقي_مباشر(
    المسار: &متجه غ8
): اختيار متجه غ8 {
    دع القيمة: متجه غ8 = *المسار;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع اختيار.لا_شيء();
    };
    دع الجزء: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما ((ف < العدد) && (القيمة[ف] != 0x2F)) {
        ألحق(الجزء, القيمة[ف]);
        ف := ف + 1;
    }
    لو ((الطول(الجزء) مثل غير_موقع) == 0) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(الجزء);
}

عرف سجل_تهجئة_مسار_مباشر(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    المسار: &متجه غ8,
    المفتاح: &مفتاح_وحدة_مقنن
): منطقي {
    // The common root spelling is registered once by ابن_إعداد_تجميع_مباشر.
    دع المسار_العام: متجه غ8 = انسخ_بايتات_إعداد_مباشر(المسار);
    طابق أضف_مسارا_عاما_لوحدة(البيئة, الجذر, المسار_العام, المفتاح) مع
    | نتيجة_ربط_مسار_عام.أضيف -> {
        أرجع صواب;
    }
    | نتيجة_ربط_مسار_عام.موجود -> {
        أرجع صواب;
    }
    | _ -> {
        أرجع خطأ;
    };
}


عام عرف ابن_إعداد_تجميع_مباشر(
    مسار_ملف_الدخول: &نص,
    مسارات_ملفات_المصدر_الإضافية: &متجه نص
): نتيجة_إعداد_تجميع_مباشر {
    دع المدخلات: متغير متجه نص = [];
    دع مسار_الدخول: نص = *مسار_ملف_الدخول;
    ألحق(المدخلات, مسار_الدخول);
    دع الإضافية: متجه نص = *مسارات_ملفات_المصدر_الإضافية;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الإضافية) مثل غير_موقع)) {
        دع مرجع_مسار_ملف_المصدر: &نص = &الإضافية[ف];
        دع مسار_ملف_المصدر: نص = *مرجع_مسار_ملف_المصدر;
        ألحق(المدخلات, مسار_ملف_المصدر);
        ف := ف + 1;
    }

    دع المسارات: متغير متجه مسار_ملف_مصدر_مباشر = [];
    ف := 0;
    بينما (ف < (الطول(المدخلات) مثل غير_موقع)) {
        طابق قنن_مسار_ملف_مصدر_مباشر(&المدخلات[ف]) مع
        | نتيجة_مسار_ملف_مصدر_مباشر.غير_صالح -> {
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        }
        | نتيجة_مسار_ملف_مصدر_مباشر.صالح(المسار) -> {
            ألحق(المسارات, المسار);
        };
        ف := ف + 1;
    }

    دع بداية_الجذر: متغير غير_موقع = 0;
    طابق طول_جذر_مسار_ملف_المصدر_المشترك(&المسارات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
    }
    | اختيار.بعض(الطول_المشترك) -> {
        بداية_الجذر := الطول_المشترك;
    };

    دع البيئة: متغير بيئة_وحدات_منطقية = بيئة_وحدات_منطقية_جديدة();
    دع الجذر: معرف_جذر_مكتبة = خصص_جذر_مكتبة(&متغير البيئة);
    دع مسار_جذر_المشروع: نص;
    طابق مسار_جذر_مصادر_مباشرة(&المدخلات[0], &المسارات[0], بداية_الجذر) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح(); }
    | اختيار.بعض(القيمة) -> { مسار_جذر_المشروع := القيمة; };
    طابق أضف_جذر_مصدر(&متغير البيئة, الجذر, &مسار_جذر_المشروع) مع
    | نتيجة_تسجيل_جذر_مصدر.أضيف -> { }
    | نتيجة_تسجيل_جذر_مصدر.موجود -> { }
    | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح(); };
    دع المفتاح_الجذري: متغير مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
        الجذر,
        مسار_وحدة_منطقي_فارغ()
    );
    دع المفاتيح_المباشرة: متغير متجه مفتاح_وحدة_مقنن = [];

    ف := 0;
    بينما (ف < (الطول(المسارات) مثل غير_موقع)) {
        دع البايتات: متغير متجه غ8 = [];
        طابق بايتات_مسار_منطقي_من_مسار_ملف_مصدر(&المسارات[ف], بداية_الجذر) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        }
        | اختيار.بعض(القيمة) -> {
            البايتات := القيمة;
        };

        دع المسار_المنطقي: متغير مسار_وحدة_منطقي = مسار_وحدة_منطقي_فارغ();
        طابق قنن_مسار_وحدة_منطقي(&البايتات) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> {
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        }
        | نتيجة_مسار_وحدة_منطقي.صالح(المسار) -> {
            المسار_المنطقي := المسار;
        };

        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            الجذر,
            المسار_المنطقي
        );
        دع مرجع_المفتاح_المباشر: &مفتاح_وحدة_مقنن = &المفتاح;
        دع مفتاح_للقائمة: مفتاح_وحدة_مقنن = *مرجع_المفتاح_المباشر;
        دع مفتاح_للجذر: مفتاح_وحدة_مقنن = *مرجع_المفتاح_المباشر;
        لو (ف == 0) {
            طابق أول_جزء_مسار_منطقي_مباشر(&البايتات) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
            }
            | اختيار.بعض(التهجئة) -> {
                طابق أضف_ربط_اسم_جذر(&متغير البيئة, الجذر, التهجئة, الجذر) مع
                | نتيجة_ربط_جذر.أضيف -> { }
                | نتيجة_ربط_جذر.موجود -> { }
                | _ -> { أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح(); };
            };
        };
        دع مرجع_مسار_ملف_المصدر: &نص = &المدخلات[ف];
        دع مسار_ملف_المصدر: نص = *مرجع_مسار_ملف_المصدر;
        طابق أضف_موقع_مصدر_وحدة_مضمنة(
            &متغير البيئة,
            &المفتاح,
            مسار_ملف_المصدر
        ) مع
        | نتيجة_تسجيل_موقع_مصدر.أضيف -> { }
        | نتيجة_تسجيل_موقع_مصدر.موجود -> { }
        | _ -> {
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        };

        لو (!سجل_تهجئة_مسار_مباشر(
            &متغير البيئة,
            الجذر,
            &البايتات,
            &المفتاح
        )) {
            أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
        };

        ألحق(المفاتيح_المباشرة, مفتاح_للقائمة);
        لو (ف == 0) {
            المفتاح_الجذري := مفتاح_للجذر;
        };
        ف := ف + 1;
    }

    دع مسار_جذر_المكتبة_القياسية: نص = «library/std»;
    لو (!سجل_مكتبة_سلطان_القياسية(&متغير البيئة, الجذر, &مسار_جذر_المكتبة_القياسية)) {
        أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
    };

    دع الإعداد: إعداد_تجميع_مباشر = {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        المفاتيح_المباشرة: المفاتيح_المباشرة
    };
    أرجع نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد);
}


// Project source inventory remains compiler-owned. Tooling supplies workspace roots;
// this owner turns filesystem inventory into the same explicit source inputs consumed
// by the canonical Module environment. Symlinks are deliberately not traversed.
عام نوع نتيجة_اكتشاف_مصادر_مشروع =
    | مكتملة بنوع متجه نص
    | فشل بنوع عدد
;

عرف مسارا_مصدر_مشروع_متساويان(
    الأول: &نص,
    الثاني: &نص
): منطقي {
    دع أ: نص = طبع_المسار(الأول);
    دع ب: نص = طبع_المسار(الثاني);
    أرجع نصان_متساويان(&أ, &ب);
}

عرف يحتوي_مسار_مصدر_مشروع(
    المسارات: &متجه نص,
    المطلوب: &نص
): منطقي {
    دع القيم: متجه نص = *المسارات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (مسارا_مصدر_مشروع_متساويان(&القيم[ف], المطلوب)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف أضف_مسار_مصدر_مشروع_فريدا(
    المسارات: &متغير متجه نص,
    المسار: &نص
): فراغ {
    دع الحالية: متجه نص = *المسارات;
    لو (يحتوي_مسار_مصدر_مشروع(&الحالية, المسار)) { أرجع; };
    دع القيمة: نص = *المسار;
    دع الجديدة: متغير متجه نص = الحالية;
    ألحق(الجديدة, القيمة);
    *المسارات := الجديدة;
}

عرف مسار_مصدر_سلطان(المسار: &نص): منطقي {
    طابق امتداد_المسار(المسار) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الامتداد) -> {
        دع المطلوب: نص = «sn»;
        أرجع نصان_متساويان(&الامتداد, &المطلوب);
    };
}

عرف اجمع_مصادر_دليل_مشروع(
    الدليل: &نص,
    الناتج: &متغير متجه نص
): اختيار عدد {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
    | نتيجة.نجح(المدخلات) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المدخلات) مثل غير_موقع)) {
            دع مرجع_المدخل: &مدخل_دليل = &المدخلات[ف];
            دع المدخل: مدخل_دليل = *مرجع_المدخل;
            دع مرجع_الاسم: &نص = &المدخل.الاسم;
            دع الاسم: نص = *مرجع_الاسم;
            دع المسار: نص = صل_المسار(الدليل, &الاسم);
            طابق المدخل.النوع مع
            | نوع_مدخل_دليل.دليل -> {
                طابق اجمع_مصادر_دليل_مشروع(&المسار, الناتج) مع
                | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
                | اختيار.لا_شيء -> { };
            }
            | نوع_مدخل_دليل.ملف -> {
                لو (مسار_مصدر_سلطان(&المسار)) {
                    أضف_مسار_مصدر_مشروع_فريدا(الناتج, &المسار);
                };
            }
            | نوع_مدخل_دليل.وصلة_رمزية -> { }
            | نوع_مدخل_دليل.آخر -> { };
            ف := ف + 1;
        }
    };
    أرجع اختيار.لا_شيء();
}

عام عرف اكتشف_مصادر_مشروع(
    جذور_المشروع: &متجه نص
): نتيجة_اكتشاف_مصادر_مشروع {
    دع الجذور: متجه نص = *جذور_المشروع;
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الجذور) مثل غير_موقع)) {
        دع مرجع_الجذر: &نص = &الجذور[ف];
        طابق اجمع_مصادر_دليل_مشروع(مرجع_الجذر, &متغير الناتج) مع
        | اختيار.بعض(الخطأ) -> { أرجع نتيجة_اكتشاف_مصادر_مشروع.فشل(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة_اكتشاف_مصادر_مشروع.مكتملة(الناتج);
}

عام عرف ابن_إعداد_مشروع_مباشر(
    مسار_ملف_الدخول: &نص,
    جذور_المشروع: &متجه نص,
    مسارات_المصادر_المفتوحة: &متجه نص
): نتيجة_إعداد_تجميع_مباشر {
    دع الإضافية: متغير متجه نص = [];
    طابق اكتشف_مصادر_مشروع(جذور_المشروع) مع
    | نتيجة_اكتشاف_مصادر_مشروع.فشل(_) -> {
        أرجع نتيجة_إعداد_تجميع_مباشر.غير_صالح();
    }
    | نتيجة_اكتشاف_مصادر_مشروع.مكتملة(المكتشفة) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المكتشفة) مثل غير_موقع)) {
            لو (!مسارا_مصدر_مشروع_متساويان(&المكتشفة[ف], مسار_ملف_الدخول)) {
                أضف_مسار_مصدر_مشروع_فريدا(&متغير الإضافية, &المكتشفة[ف]);
            };
            ف := ف + 1;
        }
    };

    دع المفتوحة: متجه نص = *مسارات_المصادر_المفتوحة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المفتوحة) مثل غير_موقع)) {
        لو (!مسارا_مصدر_مشروع_متساويان(&المفتوحة[ف], مسار_ملف_الدخول)) {
            أضف_مسار_مصدر_مشروع_فريدا(&متغير الإضافية, &المفتوحة[ف]);
        };
        ف := ف + 1;
    }
    أرجع ابن_إعداد_تجميع_مباشر(مسار_ملف_الدخول, &الإضافية);
}
