// Process orchestration only: parsed request -> Driver -> output/diagnostics/status.
// Target facts come from Target; compiler semantics stay in compiler_driver.sn.


عرف اكتب_خرج_عملية(النص: نص): فراغ {
    دع المكتوب_المهمل: نتيجة عدد, عدد = اطبع(النص);
}

عرف لون_تشخيص_طرفي_مفعل(الإعداد: إعداد_عرض_عملية): منطقي {
    لو (الإعداد.الصيغة == صيغة_تشخيص_عملية.جيسون()) {
        أرجع خطأ;
    };
    طابق الإعداد.اللون مع
    | سياسة_لون_تشخيص_عملية.دائما -> { أرجع صواب; }
    | سياسة_لون_تشخيص_عملية.أبدا -> { أرجع خطأ; }
    | سياسة_لون_تشخيص_عملية.تلقائي -> {
        // Runtime terminal-capability detection is deliberately not guessed here.
        // AUTO remains conservative until the canonical Runtime owner exposes it.
        أرجع خطأ;
    };
}

عرف اعرض_تشخيصات_عملية_المترجم(
    التشخيصات: &مجموعة_تشخيصات,
    الإعداد: إعداد_عرض_عملية
): فراغ {
    دع أنسي: منطقي = لون_تشخيص_طرفي_مفعل(الإعداد);
    دع النمط_الكامل: نمط_طرفية_تشخيص = {
        أنسي: أنسي,
        اعرض_المصدر: صواب
    };
    دع النمط_المختصر: نمط_طرفية_تشخيص = {
        أنسي: أنسي,
        اعرض_المصدر: خطأ
    };
    طابق الإعداد.الصيغة مع
    | صيغة_تشخيص_عملية.بشري -> {
        اعرض_مجموعة_تشخيصات_طرفيا(التشخيصات, الإعداد.اللغة, النمط_الكامل);
    }
    | صيغة_تشخيص_عملية.مختصر -> {
        اعرض_مجموعة_تشخيصات_مختصرة(التشخيصات, الإعداد.اللغة, النمط_المختصر);
    }
    | صيغة_تشخيص_عملية.جيسون -> {
        اعرض_مجموعة_تشخيصات_جيسون(التشخيصات, الإعداد.اللغة);
    };
}

عرف تشخيصات_هدف_مضيف_غير_متاح(): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح(), اختيار.لا_شيء()
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_كتابة_مخرج(المسار: نص, الحالة: عدد): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), اختيار.لا_شيء()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»
    );
    دع أضف_سبب: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «output.write-failed»
    );
    دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), المسار
    );
    دع أضف_الحالة: منطقي = أضف_حجة_موقعة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الحالة
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف حل_اختيار_هدف_عملية(
    الاختيار: اختيار_هدف_عملية
): نتيجة_حل_هدف {
    طابق الاختيار مع
    | اختيار_هدف_عملية.صريح(المعمارية, المنصة, البيئة) -> {
        أرجع حل_بالتكوين(المعمارية, المنصة, البيئة);
    }
    | اختيار_هدف_عملية.تلقائي -> {
        أرجع حل_هدف_المضيف_المسجل();
    };
}

عرف اطبع_مساعدة_المترجم(اللغة: لغة_تشخيص): فراغ {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> {
        اكتب_خرج_عملية("SultanC compiler\n\n");
        اكتب_خرج_عملية("Usage:\n");
        اكتب_خرج_عملية("    sultanc <file.sn> [options]\n");
        اكتب_خرج_عملية("    sultanc -c <file.sn> [options]\n");
        اكتب_خرج_عملية("    sultanc check <file.sn> [options]\n");
        اكتب_خرج_عملية("    sultanc interpret <file.sn> [options]\n");
        اكتب_خرج_عملية("    sultanc targets\n");
        اكتب_خرج_عملية("    sultanc version\n\n");
        اكتب_خرج_عملية("Options:\n");
        اكتب_خرج_عملية("    -o <path>                         Output path\n");
        اكتب_خرج_عملية("    -c                                Emit an object file\n");
        اكتب_خرج_عملية("    --target <target>                 Select a registered target\n");
        اكتب_خرج_عملية("    --lang ar|en                      Compiler interface language\n");
        اكتب_خرج_عملية("    --diagnostic-format human|short|json\n");
        اكتب_خرج_عملية("    --color auto|always|never         Diagnostic color policy\n");
        اكتب_خرج_عملية("    --help                            Show this help\n");
        اكتب_خرج_عملية("    --version                         Show compiler version\n");
    }
    | لغة_تشخيص.العربية -> {
        اكتب_خرج_عملية("مترجم سلطان سي\n\n");
        اكتب_خرج_عملية("الاستخدام:\n");
        اكتب_خرج_عملية("    sultanc <ملف.sn> [الخيارات]\n");
        اكتب_خرج_عملية("    sultanc -c <ملف.sn> [الخيارات]\n");
        اكتب_خرج_عملية("    sultanc check <ملف.sn> [الخيارات]\n");
        اكتب_خرج_عملية("    sultanc interpret <ملف.sn> [الخيارات]\n");
        اكتب_خرج_عملية("    sultanc targets\n");
        اكتب_خرج_عملية("    sultanc version\n\n");
        اكتب_خرج_عملية("الخيارات:\n");
        اكتب_خرج_عملية("    -o <مسار>                         مسار المخرج\n");
        اكتب_خرج_عملية("    -c                                إنشاء ملف كائني\n");
        اكتب_خرج_عملية("    --target <هدف>                    اختيار هدف مسجل\n");
        اكتب_خرج_عملية("    --lang ar|en                      لغة واجهة المترجم\n");
        اكتب_خرج_عملية("    --diagnostic-format human|short|json\n");
        اكتب_خرج_عملية("    --color auto|always|never         سياسة ألوان التشخيص\n");
        اكتب_خرج_عملية("    --help                            عرض هذه المساعدة\n");
        اكتب_خرج_عملية("    --version                         عرض إصدار المترجم\n");
    };
}

عرف اطبع_إصدار_المترجم(): فراغ {
    اكتب_خرج_عملية(«SultanC »);
    اكتب_خرج_عملية(إصدار_سلطان_سي());
    اكتب_خرج_عملية("\n");
}

عرف اطبع_أهداف_المترجم(اللغة: لغة_تشخيص): فراغ {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> {
        اكتب_خرج_عملية("Target          Architecture    OS       Object   Support\n");
    }
    | لغة_تشخيص.العربية -> {
        اكتب_خرج_عملية("الهدف           المعمارية       النظام   الكائن   الدعم\n");
    };
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        اكتب_خرج_عملية(تهجئة_هدف_مسجل(&الأهداف[ف])); اكتب_خرج_عملية(«    »);
        اكتب_خرج_عملية(تهجئة_معمارية_هدف(الأهداف[ف].المعمارية.الهوية)); اكتب_خرج_عملية(«    »);
        اكتب_خرج_عملية(تهجئة_منصة_هدف(الأهداف[ف].المنصة.المنصة)); اكتب_خرج_عملية(«    »);
        اكتب_خرج_عملية(تهجئة_صيغة_كائن_هدف(الأهداف[ف].صيغة_الكائن)); اكتب_خرج_عملية(«    »);
        اكتب_خرج_عملية(تهجئة_دعم_هدف(الأهداف[ف].الدعم)); اكتب_خرج_عملية("\n");
        ف := ف + 1;
    }
}

عام عرف نفذ_طلب_عملية_مترجم(
    الطلب: طلب_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    طابق الطلب مع
    | طلب_عملية_مترجم.مساعدة -> {
        اطبع_مساعدة_المترجم(الإعداد.اللغة);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.إصدار -> {
        اطبع_إصدار_المترجم();
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.أهداف -> {
        اطبع_أهداف_المترجم(الإعداد.اللغة);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.تحقق(المصدر, المصادر_الإضافية) -> {
        دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم(
            المصدر, المصادر_الإضافية, طلب_تجميع_مترجم.تحقق()
        );
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.تحقق_مكتمل -> {
            أرجع نتيجة_عملية_مترجم.تحقق_مكتمل();
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.تفسير(المصدر, المصادر_الإضافية) -> {
        دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم(
            المصدر, المصادر_الإضافية, طلب_تجميع_مترجم.تفسير()
        );
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر);
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.كائن_أصلي(المصدر, المصادر_الإضافية, مسار_الإخراج, اختيار_الهدف) -> {
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(الهدف) -> {
            دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم(
                المصدر,
                المصادر_الإضافية,
                طلب_تجميع_مترجم.كائن_أصلي(
                    الهدف.المعمارية.الهوية,
                    الهدف.المنصة.المنصة,
                    الهدف.المنصة.البيئة
                )
            );
            طابق النتيجة مع
            | نتيجة_تجميع_مترجم.كائن_أصلي_مكتمل(البايتات) -> {
                طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                | نتيجة.خطأ(الحالة) -> {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                    );
                }
                | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_أصلي_مكتمل(); };
            }
            | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
        };
    }
    | طلب_عملية_مترجم.تنفيذي_أصلي(المصدر, المصادر_الإضافية, مسار_الإخراج, اختيار_الهدف) -> {
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(الهدف) -> {
            دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم(
                المصدر,
                المصادر_الإضافية,
                طلب_تجميع_مترجم.تنفيذي_أصلي(
                    الهدف.المعمارية.الهوية,
                    الهدف.المنصة.المنصة,
                    الهدف.المنصة.البيئة
                )
            );
            طابق النتيجة مع
            | نتيجة_تجميع_مترجم.تنفيذي_أصلي_مكتمل(البايتات) -> {
                طابق اكتب_بايتات_تنفيذية_مضيف(&مسار_الإخراج, &البايتات) مع
                | نتيجة.خطأ(الحالة) -> {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                    );
                }
                | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.تنفيذي_أصلي_مكتمل(); };
            }
            | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
        };
    };
}

عرف رمز_نتيجة_تفسير_عملية(
    النتيجة: &نتيجة_تفسير_مسير,
    الإعداد: إعداد_عرض_عملية
): عدد {
    طابق *النتيجة مع
    | نتيجة_تفسير_مسير.خرج(الحالة) -> { أرجع الحالة مثل عدد; }
    | نتيجة_تفسير_مسير.نجح(القيمة_الاختيارية) -> {
        طابق القيمة_الاختيارية مع
        | اختيار.لا_شيء -> { أرجع 0; }
        | اختيار.بعض(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(الحالة) -> { أرجع الحالة مثل عدد; }
            | _ -> { أرجع 0; };
        };
    }
    | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
        دع التشخيصات: مجموعة_تشخيصات = حول_فشل_تفسير_مسير_إلى_تشخيصات(&الفشل);
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    };
}

عرف رمز_فشل_تشخيصات(التشخيصات: &مجموعة_تشخيصات): عدد {
    لو (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.داخلي())) { أرجع 4; };
    لو (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.بيئة())) { أرجع 3; };
    أرجع 1;
}

عرف رمز_نتيجة_عملية_مترجم(
    النتيجة: &نتيجة_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): عدد {
    طابق *النتيجة مع
    | نتيجة_عملية_مترجم.أمر_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تحقق_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.كائن_أصلي_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تنفيذي_أصلي_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
        أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر, الإعداد);
    }
    | نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 2;
    }
    | نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.فشل_تجميع(نتيجة_التجميع) -> {
        طابق نتيجة_التجميع مع
        | نتيجة_تجميع_مترجم.فشل_إعداد(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_واجهة(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_مسير(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 4;
        }
        | نتيجة_تجميع_مترجم.مدخل_تفسير_غير_متاح -> { أرجع 1; }
        | نتيجة_تجميع_مترجم.هدف_غير_مسجل -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.فشل_مخرج_أصلي(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
        }
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر, الإعداد);
        }
        | نتيجة_تجميع_مترجم.تحقق_مكتمل -> { أرجع 0; }
        | نتيجة_تجميع_مترجم.كائن_أصلي_مكتمل(_) -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.تنفيذي_أصلي_مكتمل(_) -> { أرجع 3; };
    };
}

عام عرف شغل_عملية_المترجم(): عدد {
    طابق حلل_استدعاء_المترجم() مع
    | نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.صالح(الطلب, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم(الطلب, الإعداد);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    };
}
