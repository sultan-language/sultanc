عرف اكتب_بايتات_تنفيذية_عملية(
    المسار: &نص,
    المحتوى: &متجه ط8
): نتيجة عدد, خطأ_حد_نظام {
    أرجع اكتب_بايتات_تنفيذية_للنظام(المسار, المحتوى);
}
// Process orchestration only: parsed request -> Driver -> output/diagnostics/status.
// Target facts come from Target; compiler semantics stay in compiler_driver.sn.

عرف اكتب_خرج_عملية(النص: نص): فراغ {
    ليكن المكتوب_المهمل: نتيجة عدد, عدد = اطبع(&النص);
}

عرف لون_تشخيص_طرفي_مفعل(الإعداد: &إعداد_عرض_عملية): منطقي {
    إذا ((*الإعداد).الصيغة == صيغة_تشخيص_عملية.جيسون()) {
        أرجع خطأ;
    };
    طابق (*الإعداد).اللون مع
    | سياسة_لون_تشخيص_عملية.دائما -> { أرجع صواب; }
    | سياسة_لون_تشخيص_عملية.أبدا -> { أرجع خطأ; }
    | سياسة_لون_تشخيص_عملية.تلقائي -> {
        // Runtime terminal-capability detection is deliberately not guessed here.
        // AUTO remains conservative until the canonical Runtime owner exposes it.
        أرجع خطأ;
    };
}

عرف اعرض_تشخيصات_عملية_المترجم(
    التشخيصات_المعطاة: &مجموعة_تشخيصات,
    الإعداد: إعداد_عرض_عملية
): فراغ {
    // C diagnostics reported after the last emitted one are shown too.
    ليكن الكاملة: متغير مجموعة_تشخيصات = انسخ_مملوكا_مجموعة_تشخيصات(التشخيصات_المعطاة);
    أضف_تشخيصات_سي_المعلقة(&متغير الكاملة);
    // The one renderer (diagnostics/output/render.sn), which a failure on
    // another thread of a running program also goes through.
    ليكن العرض: عرض_فشل_تفسير = عرض_فشل_تفسير_عملية(&الإعداد);
    اعرض_مجموعة_تشخيصات_بصيغة(&الكاملة, العرض.اللغة, العرض.الصيغة, العرض.أنسي);
}

// The process's display settings as the shared renderer takes them.
عرف عرض_فشل_تفسير_عملية(الإعداد: &إعداد_عرض_عملية): عرض_فشل_تفسير {
    ليكن الصيغة: متغير صيغة_عرض_تشخيص = صيغة_عرض_تشخيص.طرفي();
    طابق (*الإعداد).الصيغة مع
    | صيغة_تشخيص_عملية.طرفي -> { }
    | صيغة_تشخيص_عملية.مختصر -> { الصيغة := صيغة_عرض_تشخيص.مختصر(); }
    | صيغة_تشخيص_عملية.جيسون -> { الصيغة := صيغة_عرض_تشخيص.جيسون(); };
    ليكن العرض: عرض_فشل_تفسير = {
        اللغة: حل_لغة_عرض_عملية((*الإعداد).اللغة),
        الصيغة: الصيغة,
        أنسي: لون_تشخيص_طرفي_مفعل(الإعداد)
    };
    أرجع العرض;
}

عرف تشخيصات_هدف_مضيف_غير_متاح(): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح(), اختياري.لا_شيء()
    );
    ليكن بلا_حجج: متجه حجة_تشخيص = [];
    ليكن أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
        بلا_حجج
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_كتابة_مخرج(المسار: نص, الحالة: عدد): مجموعة_تشخيصات {
    ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), اختياري.لا_شيء()
    );
    ليكن أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»
    );
    ليكن أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إخراج_كتابة_فشل()
    );
    ليكن أضف_مسار: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), المسار
    );
    ليكن أضف_الحالة: منطقي = أضف_حجة_موقعة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الحالة
    );
    ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Preserve the native status when the selected OS provider reports it.
// Validation and resource errors have no native errno; emit the established
// output-write diagnostic without inventing a numeric system error.
عرف تشخيصات_فشل_كتابة_مخرج_نظام(
    المسار: نص,
    الخطأ: خطأ_حد_نظام
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_حد_نظام.فشل_تشغيل(الحالة) -> {
        أرجع تشخيصات_فشل_كتابة_مخرج(المسار, الحالة);
    }
    | _ -> {
        ليكن التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), اختياري.لا_شيء()
        );
        ليكن المرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»
        );
        ليكن السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إخراج_كتابة_فشل()
        );
        ليكن حجة_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), المسار
        );
        ليكن المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
}

عرف حل_اختيار_هدف_عملية(
    الاختيار: اختيار_هدف_عملية
): نتيجة_حل_هدف {
    طابق الاختيار مع
    | اختيار_هدف_عملية.صريح(المعرف) -> {
        أرجع حل_بمعرف_هدف(المعرف);
    }
    | اختيار_هدف_عملية.تلقائي -> {
        أرجع حل_هدف_المضيف_المسجل();
    };
}

عرف اطبع_مساعدة_المترجم(اللغة: لغة_تشخيص): فراغ {
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_المساعدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الاستخدام()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.سطر_استخدام_المترجم()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الأوامر()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التشغيل()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.توضيح_وسائط_التشغيل()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التحقق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الأهداف()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الشرح()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التنسيق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الاختبار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_المساعدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الإصدار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الخيارات_الشائعة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_المخرج()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الهدف()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الكائن()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الخيارات_المتقدمة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الخلفية()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_نوع_الإخراج()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_اللغة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_التشخيص()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الألوان()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_فحص_التنسيق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_مرشح_الاختبار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_اسم_الاختبار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_ملفات_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_قائمة_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_تفسير_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_فهرس_الاختبار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_منع_تشغيل_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_مصدر_الوحدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.توضيح_مصدر_الوحدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_رسم_الحزم()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_مكتبة_الربط()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_دليل_المكتبات()));
}

// The version also states which code-generation backends this compiler was
// built with (a compiler-build capability, see compiler_driver.sn
// مزود_خلفية_مضمن_في_المترجم); it says nothing about target coverage.
عرف اطبع_إصدار_المترجم(اللغة: لغة_تشخيص): فراغ {
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.بادئة_الإصدار()));
    طابق إصدار_السلطان() مع
    | اختياري.موجود(الرقم) -> { اكتب_خرج_عملية(الرقم); }
    | اختياري.لا_شيء -> { اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.حالة_إصدار_تطويري())); };
    اكتب_خرج_عملية("\n");
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_الخلفيات()));
    اكتب_خرج_عملية(" native");
    إذا (مزود_خلفية_مضمن_في_المترجم(هوية_مزود_خلفية.إل_إل_في_إم())) {
        اكتب_خرج_عملية(" llvm");
    };
    اكتب_خرج_عملية("\n");
}

عرف اطبع_شرح_تشخيص(الكود: &نص, اللغة: لغة_تشخيص): فراغ {
    طابق شرح_كود_عام(اللغة, الكود) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الشرح) -> {
        اكتب_خرج_عملية(انسخ_نص(الكود));
        اكتب_خرج_عملية("\n\n");
        اكتب_خرج_عملية(الشرح);
        اكتب_خرج_عملية("\n");
    };
}

// The `targets` table names platforms and support levels in the selected
// language; triples, architectures and object formats are not localized.
عرف مفتاح_منصة_هدف(المنصة: هوية_منصة): مفتاح_نص_مترجم {
    طابق المنصة مع
    | هوية_منصة.غير_محددة -> { أرجع مفتاح_نص_مترجم.منصة_هدف_غير_محددة(); }
    | هوية_منصة.ماك_أو_إس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_داروين(); }
    | هوية_منصة.آي_أو_إس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_آي_أو_إس(); }
    | هوية_منصة.لينكس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_لينكس(); }
    | هوية_منصة.ويندوز -> { أرجع مفتاح_نص_مترجم.منصة_هدف_ويندوز(); }
    | هوية_منصة.أندرويد -> { أرجع مفتاح_نص_مترجم.منصة_هدف_أندرويد(); }
    | هوية_منصة.فري_بي_إس_دي -> { أرجع مفتاح_نص_مترجم.منصة_هدف_فري_بي_إس_دي(); }
    | هوية_منصة.واسي -> { أرجع مفتاح_نص_مترجم.منصة_هدف_واسي(); }
    | هوية_منصة.متصفح -> { أرجع مفتاح_نص_مترجم.منصة_هدف_متصفح(); }
    | هوية_منصة.عتاد_مباشر -> { أرجع مفتاح_نص_مترجم.منصة_هدف_عتاد_مباشر(); };
}

عرف مفتاح_دعم_هدف(الدعم: مستوى_دعم_هدف): مفتاح_نص_مترجم {
    طابق الدعم مع
    | مستوى_دعم_هدف.مضيف_ذاتي -> { أرجع مفتاح_نص_مترجم.دعم_هدف_مضيف_ذاتي(); }
    | مستوى_دعم_هدف.مخرج_متحقق_كليا -> { أرجع مفتاح_نص_مترجم.دعم_هدف_مخرج_متحقق(); }
    | مستوى_دعم_هدف.ترجمة_متقاطعة -> { أرجع مفتاح_نص_مترجم.دعم_هدف_ترجمة_متقاطعة(); }
    | مستوى_دعم_هدف.تجريبي -> { أرجع مفتاح_نص_مترجم.دعم_هدف_تجريبي(); };
}

// Display width of a cell: its extended grapheme clusters (UAX #29), so an
// Arabic word with harakat counts its letters, not its scalars.
عرف عرض_خلية_أهداف(النص: &نص): طبيعي {
    طابق حدود_عناقيد_بايتات_يونيكود(النص) مع
    | نتيجة.خطأ(_) -> { أرجع الطول(*النص) مثل طبيعي; }
    | نتيجة.نجح(الحدود) -> {
        إذا ((الطول(الحدود) مثل طبيعي) == 0) { أرجع 0; };
        أرجع (الطول(الحدود) مثل طبيعي) - 1;
    };
}

// The localized header is one line whose cells are separated by runs of
// two or more spaces; its cells, without the trailing newline.
عرف خلايا_ترويسة_أهداف(الترويسة: &نص): متجه نص {
    ليكن الخلايا: متغير متجه نص = [];
    ليكن الجارية: متغير متجه ط8 = [];
    ليكن مسافات: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الترويسة) مثل طبيعي)) {
        ليكن ب: ط8 = (*الترويسة)[ف];
        إذا (ب == 0x20) { مسافات := مسافات + 1; }
        وإلا إذا (ب != 0x0A && ب != 0x0D) {
            إذا (مسافات >= 2 && (الطول(الجارية) مثل طبيعي) > 0) {
                ألحق(الخلايا, من_بايتات(&الجارية));
                ليكن فارغة: متجه ط8 = [];
                الجارية := فارغة;
            } وإلا إذا (مسافات == 1 && (الطول(الجارية) مثل طبيعي) > 0) {
                ألحق(الجارية, 0x20);
            };
            مسافات := 0;
            ألحق(الجارية, ب);
        };
        ف := ف + 1;
    }
    إذا ((الطول(الجارية) مثل طبيعي) > 0) { ألحق(الخلايا, من_بايتات(&الجارية)); };
    أرجع الخلايا;
}

// One row: every cell but the last padded to its column's width plus two
// spaces. In Arabic each cell is a first-strong isolate (U+2068..U+2069),
// so in a right-to-left line a Latin cell such as "x86_64-linux" keeps its
// own order and does not pull its neighbours across the column gap; a
// terminal without bidi support shows the isolates as nothing.
عرف اكتب_صف_أهداف(الخلايا: &متجه نص, العروض: &متجه طبيعي, عربي: منطقي): فراغ {
    ليكن ف: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول(*الخلايا) مثل طبيعي;
    طالما (ف < العدد) {
        إذا (عربي) { اكتب_خرج_عملية("\u2068"); };
        اكتب_خرج_عملية(انسخ_نص(&(*الخلايا)[ف]));
        إذا (عربي) { اكتب_خرج_عملية("\u2069"); };
        إذا (ف + 1 < العدد) {
            ليكن الحشو: متغير طبيعي = 2;
            ليكن العرض: طبيعي = عرض_خلية_أهداف(&(*الخلايا)[ف]);
            إذا (ف < (الطول(*العروض) مثل طبيعي) && (*العروض)[ف] > العرض) {
                الحشو := الحشو + ((*العروض)[ف] - العرض);
            };
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < الحشو) { اكتب_خرج_عملية(« »); ح := ح + 1; }
        };
        ف := ف + 1;
    }
    اكتب_خرج_عملية("\n");
}

عرف اطبع_أهداف_المترجم(اللغة: لغة_تشخيص): فراغ {
    ليكن الترويسة_كاملة: نص = نص_المترجم(اللغة, مفتاح_نص_مترجم.ترويسة_جدول_الأهداف());
    ليكن الصفوف: متغير متجه متجه نص = [];
    ألحق(الصفوف, خلايا_ترويسة_أهداف(&الترويسة_كاملة));
    ليكن الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        ليكن الصف: متجه نص = [
            تهجئة_هدف_مسجل(&الأهداف[ف]),
            تهجئة_معمارية_هدف(الأهداف[ف].المعمارية.الهوية),
            نص_المترجم(اللغة, مفتاح_منصة_هدف(الأهداف[ف].المنصة.المنصة)),
            تهجئة_صيغة_كائن_هدف(الأهداف[ف].صيغة_الكائن),
            نص_المترجم(اللغة, مفتاح_دعم_هدف(الأهداف[ف].الدعم))
        ];
        ألحق(الصفوف, الصف);
        ف := ف + 1;
    }
    // Column widths from the content, header included.
    ليكن العروض: متغير متجه طبيعي = [];
    ليكن ص: متغير طبيعي = 0;
    طالما (ص < (الطول(الصفوف) مثل طبيعي)) {
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الصفوف[ص]) مثل طبيعي)) {
            ليكن العرض: طبيعي = عرض_خلية_أهداف(&الصفوف[ص][ع]);
            إذا (ع >= (الطول(العروض) مثل طبيعي)) { ألحق(العروض, العرض); }
            وإلا إذا (العرض > العروض[ع]) { العروض[ع] := العرض; };
            ع := ع + 1;
        }
        ص := ص + 1;
    }
    ليكن عربي: منطقي = اللغة == لغة_تشخيص.العربية();
    ص := 0;
    طالما (ص < (الطول(الصفوف) مثل طبيعي)) {
        اكتب_صف_أهداف(&الصفوف[ص], &العروض, عربي);
        ص := ص + 1;
    }
}

// Warnings are shown as soon as the compilation returns, before its result.
// A compilation that showed any is not stored in the compilation cache (a
// hit would show none).
عرف اعرض_تحذيرات_عملية(التحذيرات: &مجموعة_تشخيصات, الإعداد: &إعداد_عرض_عملية): فراغ {
    إذا ((الطول((*التحذيرات).التشخيصات) مثل طبيعي) > 0 || توجد_تشخيصات_سي_معلقة()) {
        علّم_تجميعا_لا_يخزن();
        اعرض_تشخيصات_عملية_المترجم(التحذيرات, انسخ_إعداد_عرض_عملية(الإعداد));
    };
}

عرف نفذ_تجميع_عملية_بتحذيرات(
    الإعداد: &إعداد_عرض_عملية,
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الطلب: طلب_تجميع_مترجم,
    مستوى_التحسين: مستوى_تحسين_مزود_إل_إل_في_إم
): نتيجة_تجميع_مترجم {
    ليكن التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم_بتحذيرات(
        المصدر, المصادر_الإضافية, روابط_المصادر, الطلب,
        حل_لغة_عرض_عملية((*الإعداد).اللغة), &متغير التحذيرات, مستوى_التحسين,
        (*الإعداد).ميزانية_وقت_الترجمة, انسخ_نص(&(*الإعداد).رسم_الحزم)
    );
    اعرض_تحذيرات_عملية(&التحذيرات, الإعداد);
    أرجع النتيجة;
}

// `run` of a program with imported C: build it as an executable in the
// temporary directory, run it with the program's arguments on this
// process's standard streams, and answer its exit status.
// The libraries an executable built for `run` links: the C and math
// libraries, where a program's own C functions find them, on a target whose
// programs name them (هدف_يسمي_مكتبة_سي; natively they are named with
// -l c -l m); macOS and Windows link their system libraries anyway.
عرف مكتبات_تشغيل_تنفيذي_عملية(الهدف: معرف_هدف): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    طابق حل_بمعرف_هدف(الهدف) مع
    | نتيجة_حل_هدف.محلول(الواصف) -> {
        إذا (هدف_يسمي_مكتبة_سي(&الواصف)) {
            ألحق(الناتج, «c»);
            ألحق(الناتج, «m»);
        };
    }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    أرجع الناتج;
}

// The libraries `run` and `interpret` load: the command line's -l names,
// meaning what they mean for a build.
//   * -l c and -l m name the C and math libraries, which the interpreter
//     process already provides: they are satisfied without a search, valid
//     as they are for a build. (A program that runs as an executable links
//     them anyway: مكتبات_تشغيل_تنفيذي_عملية.)
//   * Every other name is resolved as a build resolves it
//     (حل_مكتبات_الربط: the -L directories, then the target's; a directory
//     that does not exist holds nothing, a repeated name is loaded again,
//     and a name nothing provides is the same error), and the file found is
//     read as a build reads it (مكتبات_تحميل_من_مسارات_تفسير). A static
//     archive is linked when the program runs as an executable and is an
//     error when the interpreter runs it, which loads shared libraries only.
//   * On Windows the loader opens <name>.dll (مكتبة_ويندوز_للتحميل).
// Whether a load path names a folder (a -L directory found it).
عرف يحتوي_فاصل_مسار_تحميل(المسار: &نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        إذا ((*المسار)[ف] == 0x2F || (*المسار)[ف] == 0x5C) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف حل_مكتبات_تحميل_تفسير_عملية(
    الأسماء: &متجه نص,
    الأدلة: &متجه نص,
    الهدف: &واصف_هدف
): نتيجة_مكتبات_تحميل_تفسير {
    ليكن مكتبة_سي: نص = «c»;
    ليكن مكتبة_الرياضيات: نص = «m»;
    ليكن المطلوبة: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        إذا (!نصان_متساويان(&(*الأسماء)[ف], &مكتبة_سي) && !نصان_متساويان(&(*الأسماء)[ف], &مكتبة_الرياضيات)) {
            ألحق(المطلوبة, انسخ_نص(&(*الأسماء)[ف]));
        };
        ف := ف + 1;
    }
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ويندوز -> {
        ليكن الناتج: متغير متجه مكتبة_تحميل_تفسير = [];
        ف := 0;
        طالما (ف < (الطول(المطلوبة) مثل طبيعي)) {
            ليكن مسار_المكتبة: نص = مكتبة_ويندوز_للتحميل(&المطلوبة[ف], الأدلة);
            // A bare name no -L directory holds that the system cannot find
            // either: the same error as a name nothing provides elsewhere.
            إذا (!يحتوي_فاصل_مسار_تحميل(&مسار_المكتبة) && !دي_إل_إل_يجده_النظام(&مسار_المكتبة)) {
                أرجع نتيجة_مكتبات_تحميل_تفسير.فشل(
                    تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                        مفتاح_حجة_تشخيص.القيمة(), انسخ_نص(&المطلوبة[ف]), خطأ, خطأ
                    )
                );
            };
            ليكن المكتبة: مكتبة_تحميل_تفسير = {
                الاسم: انسخ_نص(&المطلوبة[ف]), المسار: مسار_المكتبة,
                الصنف: صنف_مكتبة_تحميل_تفسير.مشتركة()
            };
            ألحق(الناتج, المكتبة);
            ف := ف + 1;
        }
        أرجع نتيجة_مكتبات_تحميل_تفسير.جاهزة(الناتج);
    }
    | _ -> { };
    ليكن المسارات: متغير متجه نص = [];
    طابق حل_مكتبات_الربط(&المطلوبة, الأدلة, الهدف, &متغير المسارات) مع
    | اختياري.موجود(المكتبة) -> {
        أرجع نتيجة_مكتبات_تحميل_تفسير.فشل(
            تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                مفتاح_حجة_تشخيص.القيمة(), المكتبة, خطأ, خطأ
            )
        );
    }
    | اختياري.لا_شيء -> { };
    أرجع مكتبات_تحميل_من_مسارات_تفسير(&المطلوبة, &المسارات, الهدف);
}

عرف شغل_كتنفيذي_عملية(
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الهدف: معرف_هدف,
    وسائط_البرنامج: &متجه متجه ط8,
    // The command line's -l names and -L directories, linked as a build
    // links them, after the C and math libraries.
    أسماء_المكتبات: متجه نص,
    أدلة_المكتبات: متجه نص,
    // The -O level of the `run` (or `test --interpret`) command.
    مستوى_التحسين: مستوى_تحسين_مزود_إل_إل_في_إم,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    ليكن التنفيذي: نص = مسار_مؤقت_سي(«.run»);
    ليكن بلا_مدخلات: متجه نص = [];
    ليكن المكتبات: متغير متجه نص = مكتبات_تشغيل_تنفيذي_عملية(الهدف);
    ليكن ف_المكتبة: متغير طبيعي = 0;
    طالما (ف_المكتبة < (الطول(أسماء_المكتبات) مثل طبيعي)) {
        ألحق(المكتبات, انسخ_نص(&أسماء_المكتبات[ف_المكتبة]));
        ف_المكتبة := ف_المكتبة + 1;
    }
    ليكن الطلب: طلب_عملية_مترجم = طلب_عملية_مترجم.تجميع(
        المصدر, المصادر_الإضافية, بلا_مدخلات, انسخ_نص(&التنفيذي),
        اختيار_هدف_عملية.صريح(الهدف), اختيار_مزود_خلفية_عملية.تلقائي(),
        نوع_مخرج_تجميع_عملية.تنفيذي(), روابط_المصادر, المكتبات, أدلة_المكتبات,
        مستوى_التحسين
    );
    // A program built to be run once, at a temporary path: not cached.
    ليكن إعداد_البناء: متغير إعداد_عرض_عملية = الإعداد;
    إعداد_البناء.بلا_خزن := صواب;
    ليكن البناء: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم(الطلب, إعداد_البناء);
    طابق البناء مع
    | نتيجة_عملية_مترجم.تنفيذي_مكتمل -> { }
    | _ -> {
        ليكن الحذف: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
        أرجع البناء;
    };
    ليكن الوسائط: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*وسائط_البرنامج) مثل طبيعي)) {
        ألحق(الوسائط, انسخ_بايتات(&(*وسائط_البرنامج)[ف]) مثل نص);
        ف := ف + 1;
    }
    ليكن الحالة: نتيجة حالة_إنهاء, عدد = شغل_وانتظر(&التنفيذي, &الوسائط);
    ليكن الحذف: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
    طابق الحالة مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج((الرمز & 255) مثل طبيعي));
    }
    | نتيجة.نجح(حالة_إنهاء.إشارة(الإشارة)) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج((128 + الإشارة) مثل طبيعي));
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج(127));
    };
}

// The backend a build without -b uses (as for تجميع of an executable).
عرف مزود_خلفية_لاختيار_عملية(
    الاختيار: اختيار_مزود_خلفية_عملية,
    الهدف: &واصف_هدف
): هوية_مزود_خلفية {
    طابق الاختيار مع
    | اختيار_مزود_خلفية_عملية.تلقائي -> { أرجع مزود_الخلفية_المفضل(الهدف); }
    | اختيار_مزود_خلفية_عملية.صريح(المزود) -> { أرجع المزود; };
}

// Captured output of a failed test, each line indented under its report.
عرف اكتب_خرج_اختبار_مزاحا(البايتات: &متجه ط8): فراغ {
    ليكن السطر: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        ليكن ب: ط8 = (*البايتات)[ف];
        إذا (ب == 0x0A) {
            اكتب_خرج_عملية("    ");
            اكتب_خرج_عملية(من_بايتات(&السطر));
            اكتب_خرج_عملية("\n");
            ليكن فارغ: متجه ط8 = [];
            السطر := فارغ;
        } وإلا {
            ألحق(السطر, ب);
        };
        ف := ف + 1;
    }
    إذا ((الطول(السطر) مثل طبيعي) > 0) {
        اكتب_خرج_عملية("    ");
        اكتب_خرج_عملية(من_بايتات(&السطر));
        اكتب_خرج_عملية("\n");
    };
}

// The place a failed test reported: the first line of its standard error
// that is `--> <place>` after its indentation (std.debug.assert writes one
// for a failed assertion: the place of the `@@track_caller` call), and the
// standard error without that line.
نوع موقع_مبلغ_اختبار = { الموقع: نص, الباقي: متجه ط8 };

عرف موقع_مبلغ_من_خرج_اختبار(الخطأ: &متجه ط8): اختياري موقع_مبلغ_اختبار {
    ليكن ن: طبيعي = الطول(*الخطأ) مثل طبيعي;
    ليكن البداية: متغير طبيعي = 0;
    طالما (البداية < ن) {
        ليكن النهاية: متغير طبيعي = البداية;
        طالما (النهاية < ن && (*الخطأ)[النهاية] != 0x0A) { النهاية := النهاية + 1; }
        ليكن ف: متغير طبيعي = البداية;
        طالما (ف < النهاية && (*الخطأ)[ف] == 0x20) { ف := ف + 1; }
        إذا (ف + 4 < النهاية && (*الخطأ)[ف] == 0x2D && (*الخطأ)[ف + 1] == 0x2D
            && (*الخطأ)[ف + 2] == 0x3E && (*الخطأ)[ف + 3] == 0x20) {
            ليكن الموقع: متغير متجه ط8 = [];
            ليكن م: متغير طبيعي = ف + 4;
            طالما (م < النهاية) { ألحق(الموقع, (*الخطأ)[م]); م := م + 1; }
            ليكن الباقي: متغير متجه ط8 = [];
            م := 0;
            طالما (م < ن) {
                إذا (م < البداية || م > النهاية) { ألحق(الباقي, (*الخطأ)[م]); };
                م := م + 1;
            }
            ليكن الناتج: موقع_مبلغ_اختبار = { الموقع: من_بايتات(&الموقع), الباقي: الباقي };
            أرجع اختياري.موجود(الناتج);
        };
        البداية := النهاية + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Where the failed test is declared, as a diagnostic shows a place.
عرف اكتب_موقع_اختبار(الموقع: &نص): فراغ {
    إذا ((الطول(*الموقع) مثل طبيعي) > 0) {
        اكتب_خرج_عملية("    --> ");
        اكتب_خرج_عملية(انسخ_نص(الموقع));
        اكتب_خرج_عملية("\n");
    };
}

// One test, in its own process (الأمر: `<executable> <index>`, or for
// --interpret this compiler with --test-index). Prints PASS or FAIL with
// what ended it (its returned error, a stop or failed assertion as
// std.process.failure wrote it, an exit status or a signal) and answers
// whether it passed. Statuses: std/testing/harness.sn.
عرف شغل_اختبارا_عملية(
    الأمر: &أمر,
    الاسم: &نص,
    الموقع: &نص,
    اللغة: لغة_تشخيص
): منطقي {
    طابق اجمع_خرج_الأمر(الأمر) مع
    | نتيجة.نجح(الناتج) -> {
        طابق الناتج.الحالة مع
        | حالة_إنهاء.خرج(0) -> {
            اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_اختبار_ناجح()));
            اكتب_خرج_عملية(« »);
            اكتب_خرج_عملية(انسخ_نص(الاسم));
            اكتب_خرج_عملية("\n");
            أرجع صواب;
        }
        | _ -> { };
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_اختبار_فاشل()));
        اكتب_خرج_عملية(« »);
        اكتب_خرج_عملية(انسخ_نص(الاسم));
        اكتب_خرج_عملية(": ");
        طابق الناتج.الحالة مع
        | حالة_إنهاء.خرج(3) -> {
            اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_اختبار_أرجع_خطأ()));
        }
        | حالة_إنهاء.خرج(الرمز) -> {
            اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_حالة_خروج_اختبار()));
            اكتب_خرج_عملية(« »);
            اكتب_خرج_عملية(عدد_إلى_نص(الرمز));
        }
        | حالة_إنهاء.إشارة(الإشارة) -> {
            اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_إشارة_اختبار()));
            اكتب_خرج_عملية(« »);
            اكتب_خرج_عملية(عدد_إلى_نص(الإشارة));
        };
        اكتب_خرج_عملية("\n");
        // The place the test reported (a failed assertion's call) is the
        // `-->`; the declaration then follows as a note.
        طابق موقع_مبلغ_من_خرج_اختبار(&الناتج.الخطأ) مع
        | اختياري.موجود(المبلغ) -> {
            اكتب_موقع_اختبار(&المبلغ.الموقع);
            إذا ((الطول(*الموقع) مثل طبيعي) > 0) {
                اكتب_خرج_عملية("    ");
                اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.ملاحظة_تصريح_الاختبار()));
                اكتب_خرج_عملية(انسخ_نص(الموقع));
                اكتب_خرج_عملية("\n");
            };
            اكتب_خرج_اختبار_مزاحا(&الناتج.الخرج);
            اكتب_خرج_اختبار_مزاحا(&المبلغ.الباقي);
        }
        | اختياري.لا_شيء -> {
            اكتب_موقع_اختبار(الموقع);
            اكتب_خرج_اختبار_مزاحا(&الناتج.الخرج);
            اكتب_خرج_اختبار_مزاحا(&الناتج.الخطأ);
        };
        أرجع خطأ;
    }
    | نتيجة.خطأ(_) -> {
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_اختبار_فاشل()));
        اكتب_خرج_عملية(« »);
        اكتب_خرج_عملية(انسخ_نص(الاسم));
        اكتب_خرج_عملية(": ");
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_اختبار_لم_يبدأ()));
        اكتب_خرج_عملية("\n");
        أرجع خطأ;
    };
}

// `test result: ok. passed: 3; failed: 0; filtered out: 1`, in the
// language of the output.
عرف اكتب_ملخص_اختبارات(اللغة: لغة_تشخيص, الناجحة: طبيعي, الفاشلة: طبيعي, المستبعدة: طبيعي): فراغ {
    اكتب_خرج_عملية("\n");
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_نتيجة_الاختبارات()));
    اكتب_خرج_عملية(« »);
    إذا (الفاشلة == 0) {
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.نتيجة_اختبارات_ناجحة()));
    } وإلا {
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.نتيجة_اختبارات_فاشلة()));
    };
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.فاصل_جملة_ملخص_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_الاختبارات_الناجحة()));
    اكتب_خرج_عملية(": ");
    اكتب_خرج_عملية(طبيعي_إلى_نص(الناجحة));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.فاصل_ملخص_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_الاختبارات_الفاشلة()));
    اكتب_خرج_عملية(": ");
    اكتب_خرج_عملية(طبيعي_إلى_نص(الفاشلة));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.فاصل_ملخص_الاختبارات()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_الاختبارات_المستبعدة()));
    اكتب_خرج_عملية(": ");
    اكتب_خرج_عملية(طبيعي_إلى_نص(المستبعدة));
    اكتب_خرج_عملية("\n");
}

// The indices of the tests the build kept (the compiler applied --filter,
// --test and --tests-in: test_mode/selection.sn), in run order.
عرف اختبارات_مختارة(الأسماء: &متجه نص): متجه طبيعي {
    ليكن المختارة: متغير متجه طبيعي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        ألحق(المختارة, ف);
        ف := ف + 1;
    }
    أرجع المختارة;
}

عرف اكتب_أسماء_اختبارات(الأسماء: &متجه نص, المختارة: &متجه طبيعي): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المختارة) مثل طبيعي)) {
        اكتب_خرج_عملية(انسخ_نص(&(*الأسماء)[(*المختارة)[ف]]));
        اكتب_خرج_عملية("\n");
        ف := ف + 1;
    }
}

// `--no-run`: `<index> <name>` per kept test, the index the program takes
// as its argument. Machine-readable, the same in every language.
عرف اكتب_فهارس_اختبارات(الأسماء: &متجه نص, المختارة: &متجه طبيعي): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المختارة) مثل طبيعي)) {
        اكتب_خرج_عملية(طبيعي_إلى_نص((*المختارة)[ف]));
        اكتب_خرج_عملية(« »);
        اكتب_خرج_عملية(انسخ_نص(&(*الأسماء)[(*المختارة)[ف]]));
        اكتب_خرج_عملية("\n");
        ف := ف + 1;
    }
}

عرف موقع_اختبار_عند(المواقع: &متجه نص, الفهرس: طبيعي): نص {
    إذا (الفهرس < (الطول(*المواقع) مثل طبيعي)) { أرجع انسخ_نص(&(*المواقع)[الفهرس]); };
    أرجع «»;
}

// The exit status of a run of one test in this process (--test-index).
عرف حالة_إنهاء_كرمز(الحالة: نتيجة حالة_إنهاء, عدد): طبيعي {
    طابق الحالة مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> { أرجع (الرمز & 255) مثل طبيعي; }
    | نتيجة.نجح(حالة_إنهاء.إشارة(الإشارة)) -> { أرجع (128 + الإشارة) مثل طبيعي; }
    | نتيجة.خطأ(_) -> { أرجع 127; };
}

// `sultanc test` (docs/en/reference/testing.md): one build through the
// one pipeline, as an executable whose entry the compiler synthesizes
// (test_mode/harness.sn), then each selected test in its own process. For a
// target this host cannot run, the tests are built (and listed with --list)
// and not run. With --interpret the interpreter runs them
// (نفذ_اختبارات_مفسرة_عملية); with --test-index only that test runs, in
// this process, on its standard streams.
عرف نفذ_اختبارات_عملية(
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    اختيار_الهدف: اختيار_هدف_عملية,
    اختيار_المزود: اختيار_مزود_خلفية_عملية,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    أسماء_المكتبات: متجه نص,
    أدلة_المكتبات: متجه نص,
    مستوى_التحسين: مستوى_تحسين_مزود_إل_إل_في_إم,
    الاختيار: اختيار_اختبارات,
    القائمة: منطقي,
    التفسير: منطقي,
    الفهرس: اختياري طبيعي,
    // `--no-run -o <path>`: the path the test program is written to.
    المخرج: اختياري نص,
    الإعداد: &إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    ليكن اللغة: لغة_تشخيص = حل_لغة_عرض_عملية((*الإعداد).اللغة);
    ليكن الهدف: واصف_هدف;
    طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
    }
    | نتيجة_حل_هدف.محلول(المحدد) -> { الهدف := المحدد; };
    إذا (التفسير) {
        أرجع نفذ_اختبارات_مفسرة_عملية(
            المصدر, المصادر_الإضافية, &الهدف, روابط_المصادر, أسماء_المكتبات,
            أدلة_المكتبات, مستوى_التحسين, الاختيار, القائمة, الفهرس, الإعداد
        );
    };
    ليكن مدخلات_الربط: متغير متجه نص = [];
    طابق حل_مكتبات_الربط(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف, &متغير مدخلات_الربط) مع
    | اختياري.موجود(المكتبة) -> {
        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
            تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                مفتاح_حجة_تشخيص.القيمة(), المكتبة, خطأ, خطأ
            )
        );
    }
    | اختياري.لا_شيء -> { };
    ليكن مزود_الخلفية: هوية_مزود_خلفية = مزود_خلفية_لاختيار_عملية(اختيار_المزود, &الهدف);
    ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
        الإعداد, المصدر, المصادر_الإضافية, روابط_المصادر,
        طلب_تجميع_مترجم.ربط(
            الهدف.المعرف, مزود_الخلفية, نوع_خرج_ربط_مترجم.تنفيذي(),
            مدخلات_الربط, أدلة_المكتبات, اختياري.لا_شيء(), اختياري.موجود(الاختيار)
        ),
        مستوى_التحسين
    );
    ليكن البايتات: متجه ط8;
    ليكن الأسماء: متجه نص;
    ليكن المواقع: متجه نص;
    ليكن المستبعدة: متغير طبيعي = 0;
    طابق النتيجة مع
    | نتيجة_تجميع_مترجم.اختبارات_مبنية(ب, أ, م, ع) -> { البايتات := ب; الأسماء := أ; المواقع := م; المستبعدة := ع; }
    | _ -> { أرجع نتيجة_عملية_مترجم.فشل_بناء_اختبارات(النتيجة); };

    ليكن المختارة: متجه طبيعي = اختبارات_مختارة(&الأسماء);
    إذا (القائمة) {
        اكتب_أسماء_اختبارات(&الأسماء, &المختارة);
        أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
    };
    // `--no-run -o <path>`: the program is kept at the path, for any target,
    // and nothing runs. One line per kept test, `<index> <name>`, says how
    // to run it alone: `<path> <index>` (the index --list's order gives).
    طابق المخرج مع
    | اختياري.موجود(مسار_المخرج) -> {
        طابق اكتب_بايتات_تنفيذية_عملية(&مسار_المخرج, &البايتات) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                تشخيصات_فشل_كتابة_مخرج_نظام(انسخ_نص(&مسار_المخرج), الخطأ)
            );
        }
        | نتيجة.نجح(_) -> { };
        اكتب_فهارس_اختبارات(&الأسماء, &المختارة);
        أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
    }
    | اختياري.لا_شيء -> { };
    // Never run a program built for another target.
    ليكن على_المضيف: متغير منطقي = خطأ;
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.محلول(المضيف) -> { على_المضيف := معرفا_هدف_متساويان(المضيف.المعرف, الهدف.المعرف); }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    إذا (!على_المضيف) {
        اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.ملاحظة_اختبارات_مبنية_غير_مشغلة()));
        اكتب_خرج_عملية(تهجئة_هدف_مسجل(&الهدف));
        اكتب_خرج_عملية("\n");
        أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
    };
    ليكن التنفيذي: نص = مسار_مؤقت_سي(«.test»);
    طابق اكتب_بايتات_تنفيذية_عملية(&التنفيذي, &البايتات) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
            تشخيصات_فشل_كتابة_مخرج_نظام(انسخ_نص(&التنفيذي), الخطأ)
        );
    }
    | نتيجة.نجح(_) -> { };
    طابق الفهرس مع
    | اختياري.موجود(الواحد) -> {
        ليكن الوسائط: متغير متجه نص = [];
        ألحق(الوسائط, طبيعي_إلى_نص(الواحد));
        ليكن الحالة: نتيجة حالة_إنهاء, عدد = شغل_وانتظر(&التنفيذي, &الوسائط);
        ليكن حذف_الواحد: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
        أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(حالة_إنهاء_كرمز(الحالة));
    }
    | اختياري.لا_شيء -> { };
    ليكن الناجحة: متغير طبيعي = 0;
    ليكن الفاشلة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المختارة) مثل طبيعي)) {
        ليكن الأمر: متغير أمر = أنشئ_أمرا(&التنفيذي);
        ليكن الوسيطة: نص = طبيعي_إلى_نص(المختارة[ف]);
        أضف_وسيطة_للأمر(&متغير الأمر, &الوسيطة);
        ليكن الموقع: نص = موقع_اختبار_عند(&المواقع, المختارة[ف]);
        إذا (شغل_اختبارا_عملية(&الأمر, &الأسماء[المختارة[ف]], &الموقع, اللغة)) {
            الناجحة := الناجحة + 1;
        } وإلا {
            الفاشلة := الفاشلة + 1;
        };
        ف := ف + 1;
    }
    ليكن الحذف: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
    اكتب_ملخص_اختبارات(اللغة, الناجحة, الفاشلة, المستبعدة);
    إذا (الفاشلة > 0) { أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(1); };
    أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
}

// `sultanc test --interpret`: the interpreter builds the harness and
// answers the tests' names; each selected test then runs in its own process,
// this compiler started again with the same arguments and
// --test-index=<index>, which interprets the harness with that index as the
// program's argument (as `run` would, on the host). A program the
// interpreter runs as an executable instead (imported C, -l libraries it
// cannot load: process_driver شغل_كتنفيذي_عملية) runs its test natively.
عرف نفذ_اختبارات_مفسرة_عملية(
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    الهدف: &واصف_هدف,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    أسماء_المكتبات: متجه نص,
    أدلة_المكتبات: متجه نص,
    مستوى_التحسين: مستوى_تحسين_مزود_إل_إل_في_إم,
    الاختيار: اختيار_اختبارات,
    القائمة: منطقي,
    الفهرس: اختياري طبيعي,
    الإعداد: &إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    ليكن اللغة: لغة_تشخيص = حل_لغة_عرض_عملية((*الإعداد).اللغة);
    ليكن مكتبات_التحميل: متجه مكتبة_تحميل_تفسير;
    طابق حل_مكتبات_تحميل_تفسير_عملية(&أسماء_المكتبات, &أدلة_المكتبات, الهدف) مع
    | نتيجة_مكتبات_تحميل_تفسير.فشل(التشخيصات) -> {
        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات);
    }
    | نتيجة_مكتبات_تحميل_تفسير.جاهزة(المكتبات) -> { مكتبات_التحميل := المكتبات; };
    // Copies for a native run of one test (a program the interpreter runs
    // as an executable).
    ليكن مصدر_التنفيذي: نص = انسخ_نص(&المصدر);
    ليكن إضافية_التنفيذي: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر_الإضافية) مثل طبيعي)) {
        ألحق(إضافية_التنفيذي, انسخ_نص(&المصادر_الإضافية[ف])); ف := ف + 1;
    }
    ليكن روابط_التنفيذي: متغير متجه ربط_مصدر_وحدة_عملية = [];
    ف := 0;
    طالما (ف < (الطول(روابط_المصادر) مثل طبيعي)) {
        ليكن الربط: ربط_مصدر_وحدة_عملية = {
            الوحدة: انسخ_نص(&روابط_المصادر[ف].الوحدة), المصدر: انسخ_نص(&روابط_المصادر[ف].المصدر)
        };
        ألحق(روابط_التنفيذي, الربط); ف := ف + 1;
    }
    ليكن الوسائط: متغير متجه متجه ط8 = [];
    ألحق(الوسائط, بايتات_من_نص(انسخ_نص(&المصدر)));
    ليكن اختيار_التنفيذي: اختيار_اختبارات = انسخ_اختيار_اختبارات(&الاختيار);
    ليكن الوضع: متغير وضع_اختبار_تفسير = وضع_اختبار_تفسير.أسماء(انسخ_اختيار_اختبارات(&الاختيار));
    طابق الفهرس مع
    | اختياري.موجود(الواحد) -> {
        ألحق(الوسائط, بايتات_من_نص(طبيعي_إلى_نص(الواحد)));
        الوضع := وضع_اختبار_تفسير.تشغيل(انسخ_اختيار_اختبارات(&الاختيار));
    }
    | اختياري.لا_شيء -> { };
    ليكن التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تفسير_مترجم(
        المصدر, المصادر_الإضافية, روابط_المصادر, (*الهدف).المعرف, الوسائط,
        مكتبات_التحميل, عرض_فشل_تفسير_عملية(الإعداد), اللغة, &متغير التحذيرات,
        مستوى_التحسين, (*الإعداد).ميزانية_وقت_الترجمة, انسخ_نص(&(*الإعداد).رسم_الحزم), الوضع
    );
    اعرض_تحذيرات_عملية(&التحذيرات, الإعداد);
    طابق الفهرس مع
    | اختياري.موجود(الواحد) -> {
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر);
        }
        | نتيجة_تجميع_مترجم.تفسير_بتنفيذي -> {
            أرجع نفذ_اختبارات_عملية(
                مصدر_التنفيذي, إضافية_التنفيذي,
                اختيار_هدف_عملية.صريح((*الهدف).المعرف), اختيار_مزود_خلفية_عملية.تلقائي(),
                روابط_التنفيذي, أسماء_المكتبات, أدلة_المكتبات,
                مستوى_التحسين, اختيار_التنفيذي, خطأ, خطأ,
                اختياري.موجود(الواحد), اختياري.لا_شيء(), الإعداد
            );
        }
        | نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات) -> {
            أرجع نتيجة_عملية_مترجم.فشل_تفسير(التشخيصات);
        }
        | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_بناء_اختبارات(النتيجة); };
    }
    | اختياري.لا_شيء -> { };
    ليكن الأسماء: متجه نص;
    ليكن المواقع: متجه نص;
    ليكن المستبعدة: متغير طبيعي = 0;
    طابق النتيجة مع
    | نتيجة_تجميع_مترجم.اختبارات_مبنية(_, أ, م, ع) -> { الأسماء := أ; المواقع := م; المستبعدة := ع; }
    | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> {
        أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
    }
    | _ -> { أرجع نتيجة_عملية_مترجم.فشل_بناء_اختبارات(النتيجة); };
    ليكن المختارة: متجه طبيعي = اختبارات_مختارة(&الأسماء);
    إذا (القائمة) {
        اكتب_أسماء_اختبارات(&الأسماء, &المختارة);
        أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
    };
    // This compiler, started again with its own arguments.
    ليكن المترجم: متغير نص = «»;
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.نجح(المسار) -> { المترجم := المسار; }
    | نتيجة.خطأ(_) -> { };
    ليكن وسائط_المترجم: متغير متجه نص = [];
    ليكن و: متغير طبيعي = 1;
    طالما (و < عدد_الوسائط()) {
        طابق وسيطة(و) مع
        | اختياري.موجود(الوسيطة) -> { ألحق(وسائط_المترجم, الوسيطة); }
        | اختياري.لا_شيء -> { };
        و := و + 1;
    }
    // `--package-graph=-`: each process reads the graph this one read from
    // standard input (compiler_driver/source_inputs.sn), on its own.
    ليكن رسم_الدخل_موجود: متغير منطقي = خطأ;
    ليكن رسم_الدخل: متغير متجه ط8 = [];
    إذا (رسم_الحزم_من_الدخل_القياسي(&(*الإعداد).رسم_الحزم)) {
        طابق نص_رسم_الحزم_من_الدخل() مع
        | اختياري.موجود(النص) -> { رسم_الدخل := بايتات_من_نص(النص); رسم_الدخل_موجود := صواب; }
        | اختياري.لا_شيء -> { };
    };
    ليكن الناجحة: متغير طبيعي = 0;
    ليكن الفاشلة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول(المختارة) مثل طبيعي)) {
        ليكن الأمر: متغير أمر = أنشئ_أمرا(&المترجم);
        أضف_وسائط_للأمر(&متغير الأمر, &وسائط_المترجم);
        إذا (رسم_الدخل_موجود) { اضبط_بيانات_دخل_الأمر(&متغير الأمر, &رسم_الدخل); };
        ليكن بايتات_الخيار: متغير متجه ط8 = بايتات_من_نص(«--test-index=»);
        ليكن بايتات_الفهرس: متجه ط8 = بايتات_من_نص(طبيعي_إلى_نص(المختارة[ف]));
        ليكن ب: متغير طبيعي = 0;
        طالما (ب < (الطول(بايتات_الفهرس) مثل طبيعي)) { ألحق(بايتات_الخيار, بايتات_الفهرس[ب]); ب := ب + 1; }
        ليكن خيار_الفهرس: نص = من_بايتات(&بايتات_الخيار);
        أضف_وسيطة_للأمر(&متغير الأمر, &خيار_الفهرس);
        ليكن الموقع: نص = موقع_اختبار_عند(&المواقع, المختارة[ف]);
        إذا (شغل_اختبارا_عملية(&الأمر, &الأسماء[المختارة[ف]], &الموقع, اللغة)) {
            الناجحة := الناجحة + 1;
        } وإلا {
            الفاشلة := الفاشلة + 1;
        };
        ف := ف + 1;
    }
    اكتب_ملخص_اختبارات(اللغة, الناجحة, الفاشلة, المستبعدة);
    إذا (الفاشلة > 0) { أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(1); };
    أرجع نتيجة_عملية_مترجم.اختبارات_منتهية(0);
}

// --- the compilation cache (compile_cache.sn) --------------------------------

// A compilation the cache may serve: its request key, its output path and kind.
نوع مفتاح_تجميع_مخزن = { المفتاح: نص, الإخراج: نص, النوع: نوع_مخرج_تجميع_عملية };

عرف هو_طلب_تجميع_قابل_للخزن(الطلب: &طلب_عملية_مترجم): منطقي {
    طابق *الطلب مع
    | طلب_عملية_مترجم.تجميع(_, _, _, _, _, _, نوع_المخرج, _, _, _, _) -> {
        // The products written to a file; assembly, LLVM IR and MSIR text are
        // read, not built on.
        أرجع نوع_المخرج == نوع_مخرج_تجميع_عملية.تنفيذي() || نوع_المخرج == نوع_مخرج_تجميع_عملية.كائن()
            || نوع_المخرج == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة() || نوع_المخرج == نوع_مخرج_تجميع_عملية.كائن_مترابط()
            || نوع_المخرج == نوع_مخرج_تجميع_عملية.وحدة_هدف();
    }
    | _ -> { أرجع خطأ; };
}

عرف سطر_مفتاح(الأجزاء: &متغير متجه نص, الاسم: نص, القيمة: نص): فراغ {
    ألحق(*الأجزاء, الاسم);
    ألحق(*الأجزاء, "\t");
    ألحق(*الأجزاء, القيمة);
    ألحق(*الأجزاء, "\n");
}

عرف نص_مستوى_للخزن(المستوى: مستوى_تحسين_مزود_إل_إل_في_إم): نص {
    طابق المستوى مع
    | مستوى_تحسين_مزود_إل_إل_في_إم.بلا -> { أرجع «0»; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.منخفض -> { أرجع «1»; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي -> { أرجع «2»; }
    | مستوى_تحسين_مزود_إل_إل_في_إم.عال -> { أرجع «3»; };
}

عرف نص_مخرج_للخزن(النوع: نوع_مخرج_تجميع_عملية): نص {
    إذا (النوع == نوع_مخرج_تجميع_عملية.تنفيذي()) { أرجع «exe»; };
    إذا (النوع == نوع_مخرج_تجميع_عملية.كائن()) { أرجع «obj»; };
    إذا (النوع == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة()) { أرجع «shared»; };
    إذا (النوع == نوع_مخرج_تجميع_عملية.كائن_مترابط()) { أرجع «reloc»; };
    أرجع «module»;
}

عرف قيمة_بيئة_للخزن(الاسم: &نص): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع «-»; };
}

// The request key of a compilation (compile_cache.sn): this compiler's
// identity, the normalized request, the environment that reaches it and the
// working directory. لا_شيء when the compilation cannot be keyed (an
// unregistered target, a library -l does not find, a link input that cannot
// be read, a package graph on standard input): it then runs uncached and
// reports whatever it reports.
عرف مفتاح_خزن_طلب(
    الخزن: &خزن_تجميع,
    الطلب: &طلب_عملية_مترجم,
    الإعداد: &إعداد_عرض_عملية
): اختياري مفتاح_تجميع_مخزن {
    ليكن الأجزاء: متغير متجه نص = ["sultanc-cache-key 1\n"];
    طابق بصمة_المترجم_الجاري(الخزن) مع
    | اختياري.موجود(البصمة) -> { سطر_مفتاح(&متغير الأجزاء, «compiler», البصمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    طابق مكتبة_إل_إل_في_إم_المضيف_للخزن() مع
    | اختياري.موجود(المكتبة) -> {
        طابق بصمة_ملف_كبير(الخزن, &المكتبة) مع
        | اختياري.موجود(البصمة) -> { سطر_مفتاح(&متغير الأجزاء, «libllvm», البصمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    }
    | اختياري.لا_شيء -> { };
    طابق دليل_العمل() مع
    | نتيجة.نجح(الدليل) -> { سطر_مفتاح(&متغير الأجزاء, «cwd», الدليل); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    ليكن اسم_std: نص = «SULTANC_STD»;
    ليكن اسم_الرابط: نص = «SULTANC_LINKER»;
    سطر_مفتاح(&متغير الأجزاء, «SULTANC_STD», قيمة_بيئة_للخزن(&اسم_std));
    سطر_مفتاح(&متغير الأجزاء, «SULTANC_LINKER», قيمة_بيئة_للخزن(&اسم_الرابط));
    ليكن اللغة: نص = «en»;
    طابق حل_لغة_عرض_عملية((*الإعداد).اللغة) مع
    | لغة_تشخيص.العربية -> { سطر_مفتاح(&متغير الأجزاء, «language», «ar»); }
    | _ -> { سطر_مفتاح(&متغير الأجزاء, «language», اللغة); };
    سطر_مفتاح(&متغير الأجزاء, «comptime-budget», طبيعي_إلى_نص((*الإعداد).ميزانية_وقت_الترجمة));
    إذا ((الطول((*الإعداد).رسم_الحزم) مثل طبيعي) > 0) {
        إذا (رسم_الحزم_من_الدخل_القياسي(&(*الإعداد).رسم_الحزم)) { أرجع اختياري.لا_شيء(); };
        سطر_مفتاح(&متغير الأجزاء, «package-graph», انسخ_نص(&(*الإعداد).رسم_الحزم));
        سطر_مفتاح(&متغير الأجزاء, «package-graph-content», بصمة_محتوى_ملف(&(*الإعداد).رسم_الحزم));
    };
    طابق *الطلب مع
    | طلب_عملية_مترجم.تجميع(
        المصدر, المصادر_الإضافية, مدخلات_الربط_المباشرة, مسار_الإخراج, اختيار_الهدف, اختيار_المزود,
        نوع_المخرج, روابط_المصادر, أسماء_المكتبات, أدلة_المكتبات, مستوى_التحسين
    ) -> {
        ليكن الهدف: واصف_هدف;
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.محلول(الواصف) -> { الهدف := الواصف; }
        | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); };
        سطر_مفتاح(&متغير الأجزاء, «target», انسخ_نص(&الهدف.الثلاثي_المقنن));
        طابق اختيار_المزود مع
        | اختيار_مزود_خلفية_عملية.تلقائي -> { سطر_مفتاح(&متغير الأجزاء, «backend», «auto»); }
        | اختيار_مزود_خلفية_عملية.صريح(المزود) -> {
            إذا (المزود == هوية_مزود_خلفية.إل_إل_في_إم()) {
                سطر_مفتاح(&متغير الأجزاء, «backend», «llvm»);
            } وإلا {
                سطر_مفتاح(&متغير الأجزاء, «backend», «native»);
            };
        };
        سطر_مفتاح(&متغير الأجزاء, «opt», نص_مستوى_للخزن(مستوى_التحسين));
        سطر_مفتاح(&متغير الأجزاء, «emit», نص_مخرج_للخزن(نوع_المخرج));
        سطر_مفتاح(&متغير الأجزاء, «output», انسخ_نص(&مسار_الإخراج));
        سطر_مفتاح(&متغير الأجزاء, «source», انسخ_نص(&المصدر));
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصادر_الإضافية) مثل طبيعي)) {
            سطر_مفتاح(&متغير الأجزاء, «extra-source», انسخ_نص(&المصادر_الإضافية[ف]));
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(روابط_المصادر) مثل طبيعي)) {
            سطر_مفتاح(&متغير الأجزاء, «module-source», انسخ_نص(&روابط_المصادر[ف].الوحدة));
            سطر_مفتاح(&متغير الأجزاء, «module-source-file», انسخ_نص(&روابط_المصادر[ف].المصدر));
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(أسماء_المكتبات) مثل طبيعي)) {
            سطر_مفتاح(&متغير الأجزاء, «-l», انسخ_نص(&أسماء_المكتبات[ف]));
            ف := ف + 1;
        }
        ف := 0;
        طالما (ف < (الطول(أدلة_المكتبات) مثل طبيعي)) {
            سطر_مفتاح(&متغير الأجزاء, «-L», انسخ_نص(&أدلة_المكتبات[ف]));
            ف := ف + 1;
        }
        // Every file the link reads: the direct link inputs and what each -l
        // resolves to, by content.
        ليكن ملفات_الربط: متغير متجه نص = [];
        ف := 0;
        طالما (ف < (الطول(مدخلات_الربط_المباشرة) مثل طبيعي)) {
            ألحق(ملفات_الربط, انسخ_نص(&مدخلات_الربط_المباشرة[ف]));
            ف := ف + 1;
        }
        طابق حل_مكتبات_الربط(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف, &متغير ملفات_الربط) مع
        | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
        | اختياري.لا_شيء -> { };
        ف := 0;
        طالما (ف < (الطول(ملفات_الربط) مثل طبيعي)) {
            طابق بصمة_ملف_كبير(الخزن, &ملفات_الربط[ف]) مع
            | اختياري.موجود(البصمة) -> {
                سطر_مفتاح(&متغير الأجزاء, «link-input», انسخ_نص(&ملفات_الربط[ف]));
                سطر_مفتاح(&متغير الأجزاء, «link-input-content», البصمة);
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        ليكن النص: نص = صل_النصوص(&الأجزاء, &«»);
        ليكن المفتاح: مفتاح_تجميع_مخزن = {
            المفتاح: بصمة_نص_خزن(&النص), الإخراج: انسخ_نص(&مسار_الإخراج), النوع: نوع_المخرج
        };
        أرجع اختياري.موجود(المفتاح);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// The result of a compilation the cache served: as the compilation would
// have answered.
عرف نتيجة_مخزنة(النوع: نوع_مخرج_تجميع_عملية): نتيجة_عملية_مترجم {
    إذا (النوع == نوع_مخرج_تجميع_عملية.تنفيذي()) { أرجع نتيجة_عملية_مترجم.تنفيذي_مكتمل(); };
    إذا (النوع == نوع_مخرج_تجميع_عملية.مكتبة_مشتركة()) { أرجع نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة(); };
    إذا (النوع == نوع_مخرج_تجميع_عملية.كائن_مترابط()) { أرجع نتيجة_عملية_مترجم.كائن_مترابط_مكتمل(); };
    إذا (النوع == نوع_مخرج_تجميع_عملية.وحدة_هدف()) { أرجع نتيجة_عملية_مترجم.وحدة_هدف_مكتملة(); };
    أرجع نتيجة_عملية_مترجم.كائن_مكتمل();
}

عرف نتيجة_بناء_ناجحة(النتيجة: &نتيجة_عملية_مترجم): منطقي {
    طابق *النتيجة مع
    | نتيجة_عملية_مترجم.كائن_مكتمل -> { أرجع صواب; }
    | نتيجة_عملية_مترجم.تنفيذي_مكتمل -> { أرجع صواب; }
    | نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة -> { أرجع صواب; }
    | نتيجة_عملية_مترجم.كائن_مترابط_مكتمل -> { أرجع صواب; }
    | نتيجة_عملية_مترجم.وحدة_هدف_مكتملة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A request: a compilation the cache may serve is looked up first (a hit
// writes the stored output and answers as the compilation would), and a
// compilation that succeeded without warnings is stored after it ran.
// --no-cache and SULTANC_CACHE=off skip both.
عام عرف نفذ_طلب_عملية_مترجم(
    الطلب: طلب_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    إذا (الإعداد.بلا_خزن || !هو_طلب_تجميع_قابل_للخزن(&الطلب)) {
        أرجع نفذ_طلب_عملية_مترجم_مباشرة(الطلب, الإعداد);
    };
    ليكن الخزن: خزن_تجميع;
    طابق افتح_خزن_التجميع() مع
    | اختياري.موجود(خ) -> { الخزن := خ; }
    | اختياري.لا_شيء -> { أرجع نفذ_طلب_عملية_مترجم_مباشرة(الطلب, الإعداد); };
    ليكن المفتاح: مفتاح_تجميع_مخزن;
    طابق مفتاح_خزن_طلب(&الخزن, &الطلب, &الإعداد) مع
    | اختياري.موجود(م) -> { المفتاح := م; }
    | اختياري.لا_شيء -> { أرجع نفذ_طلب_عملية_مترجم_مباشرة(الطلب, الإعداد); };
    ليكن لغة_التقرير: لغة_تشخيص = حل_لغة_عرض_عملية(الإعداد.اللغة);
    إذا (استرجع_تجميعا(&الخزن, &المفتاح.المفتاح, &المفتاح.الإخراج)) {
        أبلغ_عن_الخزن(لغة_التقرير, مفتاح_نص_مترجم.تقرير_خزن_مسترجع(), &المفتاح.المفتاح);
        أرجع نتيجة_مخزنة(المفتاح.النوع);
    };
    ابدأ_تسجيل_مصادر_التجميع();
    ليكن النتيجة: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم_مباشرة(الطلب, الإعداد);
    إذا (نتيجة_بناء_ناجحة(&النتيجة)) {
        إذا (خزن_تجميعا(&الخزن, &المفتاح.المفتاح, &المفتاح.الإخراج)) {
            أبلغ_عن_الخزن(لغة_التقرير, مفتاح_نص_مترجم.تقرير_خزن_مخزن(), &المفتاح.المفتاح);
        } وإلا {
            أبلغ_عن_الخزن(لغة_التقرير, مفتاح_نص_مترجم.تقرير_خزن_غير_مخزن(), &المفتاح.المفتاح);
        };
    };
    أوقف_تسجيل_مصادر_التجميع();
    أرجع النتيجة;
}

// SULTANC_CACHE_REPORT=1: what the compilation cache did, with the request
// key, on standard error (in the diagnostics' language).
عرف أبلغ_عن_الخزن(اللغة: لغة_تشخيص, المفتاح_النصي: مفتاح_نص_مترجم, المفتاح: &نص): فراغ {
    ليكن الاسم: نص = «SULTANC_CACHE_REPORT»;
    ليكن واحد: نص = «1»;
    ليكن القيمة: نص = قيمة_بيئة_للخزن(&الاسم);
    إذا (!نصان_متساويان(&القيمة, &واحد)) { أرجع; };
    ليكن الأجزاء: متجه نص = [نص_المترجم(اللغة, المفتاح_النصي), « », انسخ_نص(المفتاح), "\n"];
    ليكن السطر: نص = صل_النصوص(&الأجزاء, &«»);
    ليكن المكتوب: نتيجة عدد, عدد = اطبع_خطأ(&السطر);
}

// A request, without the compilation cache.
عرف نفذ_طلب_عملية_مترجم_مباشرة(
    الطلب: طلب_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    ليكن لغة_العرض: لغة_تشخيص = حل_لغة_عرض_عملية(الإعداد.اللغة);
    طابق الطلب مع
    | طلب_عملية_مترجم.مساعدة -> {
        اطبع_مساعدة_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.إصدار -> {
        اطبع_إصدار_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.أهداف -> {
        اطبع_أهداف_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.تنسيق(طلب_التنسيق) -> {
        طابق نفذ_أمر_التنسيق(&طلب_التنسيق) مع
        | نتيجة_أمر_تنسيق.منسقة -> { أرجع نتيجة_عملية_مترجم.أمر_مكتمل(); }
        | نتيجة_أمر_تنسيق.تحتاج_تنسيقا(التشخيصات) -> { أرجع نتيجة_عملية_مترجم.تنسيق_مطلوب(التشخيصات); }
        | نتيجة_أمر_تنسيق.فشلت(التشخيصات) -> { أرجع نتيجة_عملية_مترجم.فشل_تنسيق(التشخيصات); };
    }
    | طلب_عملية_مترجم.شرح(الكود) -> {
        اطبع_شرح_تشخيص(&الكود, لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.اختبار(
        المصدر, المصادر_الإضافية, اختيار_الهدف, اختيار_المزود, روابط_المصادر,
        أسماء_المكتبات, أدلة_المكتبات, مستوى_التحسين, الاختيار, القائمة, التفسير, الفهرس,
        المخرج
    ) -> {
        أرجع نفذ_اختبارات_عملية(
            المصدر, المصادر_الإضافية, اختيار_الهدف, اختيار_المزود, روابط_المصادر,
            أسماء_المكتبات, أدلة_المكتبات, مستوى_التحسين, الاختيار, القائمة, التفسير, الفهرس,
            المخرج, &الإعداد
        );
    }
    | طلب_عملية_مترجم.تحقق(المصدر, المصادر_الإضافية, روابط_المصادر, اختيار_الهدف, مستوى_التحسين) -> {
        // Without --target, `check` checks for the host.
        ليكن الهدف: واصف_هدف;
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(المحدد) -> { الهدف := المحدد; };
        ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
            &الإعداد,
            المصدر, المصادر_الإضافية, روابط_المصادر, طلب_تجميع_مترجم.تحقق(الهدف.المعرف),
            مستوى_التحسين
        );
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.تحقق_مكتمل -> {
            أرجع نتيجة_عملية_مترجم.تحقق_مكتمل();
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.تفسير(
        المصدر, المصادر_الإضافية, وسائط_البرنامج, اختيار_الهدف, روابط_المصادر,
        أسماء_المكتبات, أدلة_المكتبات, مستوى_التحسين
    ) -> {
        // Resolve the target independently of backend selection. The shared
        // compiler driver enforces host compatibility for every caller.
        ليكن الهدف: واصف_هدف;
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(المحدد) -> { الهدف := المحدد; };
        ليكن مكتبات_التحميل: متجه مكتبة_تحميل_تفسير;
        طابق حل_مكتبات_تحميل_تفسير_عملية(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف) مع
        | نتيجة_مكتبات_تحميل_تفسير.فشل(التشخيصات) -> {
            أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات);
        }
        | نتيجة_مكتبات_تحميل_تفسير.جاهزة(المكتبات) -> { مكتبات_التحميل := المكتبات; };
        ليكن التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        // Copies for a run as an executable (شغل_كتنفيذي_عملية).
        ليكن مصدر_التنفيذي: نص = انسخ_نص(&المصدر);
        ليكن إضافية_التنفيذي: متغير متجه نص = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصادر_الإضافية) مثل طبيعي)) {
            ألحق(إضافية_التنفيذي, انسخ_نص(&المصادر_الإضافية[ف])); ف := ف + 1;
        }
        ليكن روابط_التنفيذي: متغير متجه ربط_مصدر_وحدة_عملية = [];
        ف := 0;
        طالما (ف < (الطول(روابط_المصادر) مثل طبيعي)) {
            ليكن الربط: ربط_مصدر_وحدة_عملية = {
                الوحدة: انسخ_نص(&روابط_المصادر[ف].الوحدة), المصدر: انسخ_نص(&روابط_المصادر[ف].المصدر)
            };
            ألحق(روابط_التنفيذي, الربط); ف := ف + 1;
        }
        ليكن وسائط_التنفيذي: متغير متجه متجه ط8 = [];
        ف := 0;
        طالما (ف < (الطول(وسائط_البرنامج) مثل طبيعي)) {
            ألحق(وسائط_التنفيذي, انسخ_بايتات(&وسائط_البرنامج[ف])); ف := ف + 1;
        }
        ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تفسير_مترجم(
            المصدر, المصادر_الإضافية, روابط_المصادر, الهدف.المعرف, وسائط_البرنامج,
            مكتبات_التحميل, عرض_فشل_تفسير_عملية(&الإعداد), حل_لغة_عرض_عملية(الإعداد.اللغة), &متغير التحذيرات,
            مستوى_التحسين, الإعداد.ميزانية_وقت_الترجمة,
            انسخ_نص(&الإعداد.رسم_الحزم), وضع_اختبار_تفسير.بلا()
        );
        اعرض_تحذيرات_عملية(&التحذيرات, &الإعداد);
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر);
        }
        | نتيجة_تجميع_مترجم.تفسير_بتنفيذي -> {
            أرجع شغل_كتنفيذي_عملية(
                مصدر_التنفيذي, إضافية_التنفيذي, روابط_التنفيذي, الهدف.المعرف, &وسائط_التنفيذي,
                أسماء_المكتبات, أدلة_المكتبات, مستوى_التحسين, الإعداد
            );
        }
        | نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات) -> {
            أرجع نتيجة_عملية_مترجم.فشل_تفسير(التشخيصات);
        }
        | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(
                تشخيصات_هدف_مضيف_غير_متاح()
            );
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.تجميع(
        المصدر,
        المصادر_الإضافية,
        مدخلات_الربط_المباشرة,
        مسار_الإخراج,
        اختيار_الهدف,
        اختيار_المزود,
        نوع_المخرج,
        روابط_المصادر,
        أسماء_المكتبات,
        أدلة_المكتبات,
        مستوى_التحسين
    ) -> {
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(الهدف) -> {
            // Direct link inputs first, then the -l libraries in order.
            ليكن مدخلات_الربط: متغير متجه نص = مدخلات_الربط_المباشرة;
            طابق حل_مكتبات_الربط(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف, &متغير مدخلات_الربط) مع
            | اختياري.موجود(المكتبة) -> {
                أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                    تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                        مفتاح_حجة_تشخيص.القيمة(), المكتبة, خطأ, خطأ
                    )
                );
            }
            | اختياري.لا_شيء -> { };
            ليكن مزود_الخلفية: هوية_مزود_خلفية;
            طابق اختيار_المزود مع
            | اختيار_مزود_خلفية_عملية.تلقائي -> {
                // Assembly text comes from LLVM (the native encoders write
                // machine code directly).
                إذا (نوع_المخرج == نوع_مخرج_تجميع_عملية.نص_تجميع()
                    || نوع_المخرج == نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم()) {
                    مزود_الخلفية := هوية_مزود_خلفية.إل_إل_في_إم();
                } وإلا {
                    مزود_الخلفية := مزود_الخلفية_المفضل(&الهدف);
                };
            }
            | اختيار_مزود_خلفية_عملية.صريح(المزود) -> {
                مزود_الخلفية := المزود;
            };
            طابق نوع_المخرج مع
            | نوع_مخرج_تجميع_عملية.نص_تجميع -> {
                إذا (مزود_الخلفية != هوية_مزود_خلفية.إل_إل_في_إم()) {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.أوضاع_مترجم_متعارضة(),
                            مفتاح_حجة_تشخيص.القيمة(), «--emit=asm --backend=native», خطأ, خطأ
                        )
                    );
                };
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.تجميع()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.نص_مسير -> {
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.مسير()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    ليكن الخرج_القياسي: نص = مسار_الخرج_القياسي_لمسير();
                    إذا (نصان_متساويان(&مسار_الإخراج, &الخرج_القياسي)) {
                        ليكن المكتوب_المهمل: نتيجة عدد, عدد = اكتب_بايتات_خرج(&البايتات);
                        أرجع نتيجة_عملية_مترجم.كائن_مكتمل();
                    };
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم -> {
                إذا (مزود_الخلفية != هوية_مزود_خلفية.إل_إل_في_إم()) {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.أوضاع_مترجم_متعارضة(),
                            مفتاح_حجة_تشخيص.القيمة(), «--emit=llvm-ir --backend=native», خطأ, خطأ
                        )
                    );
                };
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.وحدة_إل_إل_في_إم()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.كائن -> {
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.ثنائي()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.تنفيذي -> {
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.تنفيذي(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء(),
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.تنفيذي_مكتمل(البايتات) -> {
                    طابق اكتب_بايتات_تنفيذية_عملية(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج_نظام(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.تنفيذي_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.مكتبة_مشتركة -> {
                ليكن اسم_المكتبة: اختياري نص = اسم_الملف(&مسار_الإخراج);
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.مكتبة_مشتركة(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اسم_المكتبة,
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.مكتبة_مشتركة_مكتملة(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.كائن_مترابط -> {
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.كائن_مترابط(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء(),
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مترابط_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.كائن_مترابط_مكتمل();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };

            }
            | نوع_مخرج_تجميع_عملية.وحدة_هدف -> {
                ليكن النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.وحدة_هدف(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء(),
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.وحدة_هدف_مكتملة(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.وحدة_هدف_مكتملة();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            };
        };
    };
}

عرف رمز_نتيجة_تفسير_عملية(
    النتيجة: &نتيجة_تفسير_مسير
): عدد {
    طابق *النتيجة مع
    | نتيجة_تفسير_مسير.خرج(الحالة) -> { أرجع الحالة مثل عدد; }
    | نتيجة_تفسير_مسير.نجح(القيمة_الاختيارية) -> {
        طابق القيمة_الاختيارية مع
        | اختياري.لا_شيء -> { أرجع 0; }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(الحالة) -> { أرجع الحالة مثل عدد; }
            | _ -> { أرجع 0; };
        };
    }
    | نتيجة_تفسير_مسير.هدف_غير_متوافق -> { أرجع 3; }
    | نتيجة_تفسير_مسير.أخفق(_) -> {
        // Compiler Driver translates failures while source/provenance/debug facts are live.
        أرجع 4;
    };
}

// The status of an interpretation that failed: 101 when the program trapped
// (the status a trap on one of its threads ends the process with,
// compiler/interpreter/machine/thread_failure.sn), so a trap reads the same
// on the main thread and on a spawned one; otherwise as for diagnostics.
عرف رمز_فشل_تفسير(التشخيصات: &مجموعة_تشخيصات): عدد {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التشخيصات).التشخيصات) مثل طبيعي)) {
        إذا ((*التشخيصات).التشخيصات[ف].المعرف == معرف_تشخيص.فخ_تفسير()) { أرجع 101; };
        ف := ف + 1;
    }
    أرجع رمز_فشل_تشخيصات(التشخيصات);
}

عرف رمز_فشل_تشخيصات(التشخيصات: &مجموعة_تشخيصات): عدد {
    إذا (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.داخلي())) { أرجع 4; };
    إذا (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.بيئة())) { أرجع 3; };
    أرجع 1;
}

// The status of a compilation that did not produce what was asked, its
// diagnostics shown.
عرف رمز_فشل_تجميع_عملية(
    نتيجة_التجميع: &نتيجة_تجميع_مترجم,
    الإعداد: إعداد_عرض_عملية
): عدد {
    طابق *نتيجة_التجميع مع
    | نتيجة_تجميع_مترجم.ملغى -> { أرجع 1; }
    | نتيجة_تجميع_مترجم.فشل_إعداد(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_تجميع_مترجم.فشل_واجهة(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_تجميع_مترجم.فشل_مسير(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 4;
    }
    | نتيجة_تجميع_مترجم.مدخل_تفسير_غير_متاح -> {
        // `run` of a program without an entry function said nothing.
        ليكن التشخيصات: مجموعة_تشخيصات = تشخيصات_نقطة_دخول_مفقودة();
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع 1;
    }
    | نتيجة_تجميع_مترجم.هدف_غير_مسجل -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تفسير(&التشخيصات);
    }
    | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
        أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر);
    }
    | نتيجة_تجميع_مترجم.تحقق_مكتمل -> { أرجع 0; }
    | نتيجة_تجميع_مترجم.تفسير_بتنفيذي -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.كائن_مكتمل(_) -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.تنفيذي_مكتمل(_) -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.مكتبة_مشتركة_مكتملة(_) -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.كائن_مترابط_مكتمل(_) -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.وحدة_هدف_مكتملة(_) -> { أرجع 3; }
    | نتيجة_تجميع_مترجم.اختبارات_مبنية(_, _, _, _) -> { أرجع 3; };
}

عرف رمز_نتيجة_عملية_مترجم(
    النتيجة: &نتيجة_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): عدد {
    طابق *النتيجة مع
    | نتيجة_عملية_مترجم.أمر_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تحقق_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.كائن_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تنفيذي_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة -> { أرجع 0; }
    | نتيجة_عملية_مترجم.كائن_مترابط_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.وحدة_هدف_مكتملة -> { أرجع 0; }
    | نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
        أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر);
    }
    | نتيجة_عملية_مترجم.فشل_تفسير(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تفسير(&التشخيصات);
    }
    | نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 2;
    }
    | نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.تنسيق_مطلوب(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 1;
    }
    | نتيجة_عملية_مترجم.فشل_تنسيق(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_عملية_مترجم.اختبارات_منتهية(الرمز) -> { أرجع الرمز مثل عدد; }
    // `test` that could not build: 2 for the program's own errors (1 is
    // "a test failed"); environment and internal failures keep 3 and 4.
    | نتيجة_عملية_مترجم.فشل_بناء_اختبارات(نتيجة_التجميع) -> {
        ليكن الرمز: عدد = رمز_فشل_تجميع_عملية(&نتيجة_التجميع, الإعداد);
        إذا (الرمز == 1) { أرجع 2; };
        أرجع الرمز;
    }
    | نتيجة_عملية_مترجم.فشل_تجميع(نتيجة_التجميع) -> {
        أرجع رمز_فشل_تجميع_عملية(&نتيجة_التجميع, الإعداد);
    };
}

عام عرف شغل_عملية_المترجم(): عدد {
    // Deeply nested source recurses deeply in every compiler phase; the
    // default 8 MiB main stack is not enough. Raise the soft limit (Linux)
    // to 64 MiB, within the hard limit. Elsewhere this changes nothing.
    ليكن المكدس_كاف: منطقي = اطلب_مكدسا_بحجم_نظام(67108864 مثل ط64);
    طابق حلل_استدعاء_المترجم() مع
    | نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد) -> {
        ليكن النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد) -> {
        ليكن النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.صالح(الطلب, الإعداد) -> {
        ليكن النتيجة: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم(الطلب, انسخ_إعداد_عرض_عملية(&الإعداد));
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    };
}
