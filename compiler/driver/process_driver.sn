عرف اكتب_بايتات_تنفيذية_عملية(
    المسار: &نص,
    المحتوى: &متجه ط8
): نتيجة عدد, خطأ_حد_نظام {
    أرجع اكتب_بايتات_تنفيذية_للنظام(المسار, المحتوى);
}
// Process orchestration only: parsed request -> Driver -> output/diagnostics/status.
// Target facts come from Target; compiler semantics stay in compiler_driver.sn.


عرف اكتب_خرج_عملية(النص: نص): فراغ {
    دع المكتوب_المهمل: نتيجة عدد, عدد = اطبع(النص);
}

عرف لون_تشخيص_طرفي_مفعل(الإعداد: &إعداد_عرض_عملية): منطقي {
    إذا ((*الإعداد).الصيغة == صيغة_تشخيص_عملية.جيسون()) {
        أرجع خطأ;
    };
    طابق (*الإعداد).اللون مع
    | سياسة_لون_تشخيص_عملية.دائما -> { أرجع صواب; }
    | سياسة_لون_تشخيص_عملية.أبدا -> { أرجع خطأ; }
    | سياسة_لون_تشخيص_عملية.تلقائي -> {
        // Runtime terminal-capability detection is deliberately not guessed here.
        // AUTO remains conservative until the canonical Runtime owner exposes it.
        أرجع خطأ;
    };
}

عرف اعرض_تشخيصات_عملية_المترجم(
    التشخيصات_المعطاة: &مجموعة_تشخيصات,
    الإعداد: إعداد_عرض_عملية
): فراغ {
    // C diagnostics reported after the last emitted one are shown too.
    دع الكاملة: متغير مجموعة_تشخيصات = انسخ_مملوكا_مجموعة_تشخيصات(التشخيصات_المعطاة);
    أضف_تشخيصات_سي_المعلقة(&متغير الكاملة);
    // The one renderer (diagnostics/output/render.sn), which a failure on
    // another thread of a running program also goes through.
    دع العرض: عرض_فشل_تفسير = عرض_فشل_تفسير_عملية(&الإعداد);
    اعرض_مجموعة_تشخيصات_بصيغة(&الكاملة, العرض.اللغة, العرض.الصيغة, العرض.أنسي);
}

// The process's display settings as the shared renderer takes them.
عرف عرض_فشل_تفسير_عملية(الإعداد: &إعداد_عرض_عملية): عرض_فشل_تفسير {
    دع الصيغة: متغير صيغة_عرض_تشخيص = صيغة_عرض_تشخيص.طرفي();
    طابق (*الإعداد).الصيغة مع
    | صيغة_تشخيص_عملية.طرفي -> { }
    | صيغة_تشخيص_عملية.مختصر -> { الصيغة := صيغة_عرض_تشخيص.مختصر(); }
    | صيغة_تشخيص_عملية.جيسون -> { الصيغة := صيغة_عرض_تشخيص.جيسون(); };
    دع العرض: عرض_فشل_تفسير = {
        اللغة: حل_لغة_عرض_عملية((*الإعداد).اللغة),
        الصيغة: الصيغة,
        أنسي: لون_تشخيص_طرفي_مفعل(الإعداد)
    };
    أرجع العرض;
}

عرف تشخيصات_هدف_مضيف_غير_متاح(): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح(), اختياري.لا_شيء()
    );
    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_هدف: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم(),
        بلا_حجج
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_فشل_كتابة_مخرج(المسار: نص, الحالة: عدد): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), اختياري.لا_شيء()
    );
    دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»
    );
    دع أضف_سبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إخراج_كتابة_فشل()
    );
    دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), المسار
    );
    دع أضف_الحالة: منطقي = أضف_حجة_موقعة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), الحالة
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Preserve the native status when the selected OS provider reports it.
// Validation and resource errors have no native errno; emit the established
// output-write diagnostic without inventing a numeric system error.
عرف تشخيصات_فشل_كتابة_مخرج_نظام(
    المسار: نص,
    الخطأ: خطأ_حد_نظام
): مجموعة_تشخيصات {
    طابق الخطأ مع
    | خطأ_حد_نظام.فشل_تشغيل(الحالة) -> {
        أرجع تشخيصات_فشل_كتابة_مخرج(المسار, الحالة);
    }
    | _ -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.فشل_كتابة_مخرج_مترجم(), اختياري.لا_شيء()
        );
        دع المرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «output-write»
        );
        دع السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_إخراج_كتابة_فشل()
        );
        دع حجة_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), المسار
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع المجموعة;
    };
}

عرف حل_اختيار_هدف_عملية(
    الاختيار: اختيار_هدف_عملية
): نتيجة_حل_هدف {
    طابق الاختيار مع
    | اختيار_هدف_عملية.صريح(المعرف) -> {
        أرجع حل_بمعرف_هدف(المعرف);
    }
    | اختيار_هدف_عملية.تلقائي -> {
        أرجع حل_هدف_المضيف_المسجل();
    };
}

عرف اطبع_مساعدة_المترجم(اللغة: لغة_تشخيص): فراغ {
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_المساعدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الاستخدام()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.سطر_استخدام_المترجم()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الأوامر()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التشغيل()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.توضيح_وسائط_التشغيل()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التحقق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الأهداف()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الشرح()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_التنسيق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_المساعدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.أمر_الإصدار()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الخيارات_الشائعة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_المخرج()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الهدف()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الكائن()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.عنوان_الخيارات_المتقدمة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الخلفية()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_نوع_الإخراج()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_اللغة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_التشخيص()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_الألوان()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_فحص_التنسيق()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_مصدر_الوحدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.توضيح_مصدر_الوحدة()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_مكتبة_الربط()));
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.خيار_دليل_المكتبات()));
}

// The version also states which code-generation backends this compiler was
// built with (a compiler-build capability, see compiler_driver.sn
// مزود_خلفية_مضمن_في_المترجم); it says nothing about target coverage.
عرف اطبع_إصدار_المترجم(اللغة: لغة_تشخيص): فراغ {
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.بادئة_الإصدار()));
    طابق إصدار_السلطان() مع
    | اختياري.موجود(الرقم) -> { اكتب_خرج_عملية(الرقم); }
    | اختياري.لا_شيء -> { اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.حالة_إصدار_تطويري())); };
    اكتب_خرج_عملية("\n");
    اكتب_خرج_عملية(نص_المترجم(اللغة, مفتاح_نص_مترجم.تسمية_الخلفيات()));
    اكتب_خرج_عملية(" native");
    إذا (مزود_خلفية_مضمن_في_المترجم(هوية_مزود_خلفية.إل_إل_في_إم())) {
        اكتب_خرج_عملية(" llvm");
    };
    اكتب_خرج_عملية("\n");
}

عرف اطبع_شرح_تشخيص(الكود: &نص, اللغة: لغة_تشخيص): فراغ {
    طابق شرح_كود_عام(اللغة, الكود) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الشرح) -> {
        اكتب_خرج_عملية(انسخ_نص(الكود));
        اكتب_خرج_عملية("\n\n");
        اكتب_خرج_عملية(الشرح);
        اكتب_خرج_عملية("\n");
    };
}

// The `targets` table names platforms and support levels in the selected
// language; triples, architectures and object formats are not localized.
عرف مفتاح_منصة_هدف(المنصة: هوية_منصة): مفتاح_نص_مترجم {
    طابق المنصة مع
    | هوية_منصة.غير_محددة -> { أرجع مفتاح_نص_مترجم.منصة_هدف_غير_محددة(); }
    | هوية_منصة.ماك_أو_إس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_داروين(); }
    | هوية_منصة.آي_أو_إس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_آي_أو_إس(); }
    | هوية_منصة.لينكس -> { أرجع مفتاح_نص_مترجم.منصة_هدف_لينكس(); }
    | هوية_منصة.ويندوز -> { أرجع مفتاح_نص_مترجم.منصة_هدف_ويندوز(); }
    | هوية_منصة.أندرويد -> { أرجع مفتاح_نص_مترجم.منصة_هدف_أندرويد(); }
    | هوية_منصة.فري_بي_إس_دي -> { أرجع مفتاح_نص_مترجم.منصة_هدف_فري_بي_إس_دي(); }
    | هوية_منصة.واسي -> { أرجع مفتاح_نص_مترجم.منصة_هدف_واسي(); }
    | هوية_منصة.متصفح -> { أرجع مفتاح_نص_مترجم.منصة_هدف_متصفح(); }
    | هوية_منصة.عتاد_مباشر -> { أرجع مفتاح_نص_مترجم.منصة_هدف_عتاد_مباشر(); };
}

عرف مفتاح_دعم_هدف(الدعم: مستوى_دعم_هدف): مفتاح_نص_مترجم {
    طابق الدعم مع
    | مستوى_دعم_هدف.مضيف_ذاتي -> { أرجع مفتاح_نص_مترجم.دعم_هدف_مضيف_ذاتي(); }
    | مستوى_دعم_هدف.مخرج_متحقق_كليا -> { أرجع مفتاح_نص_مترجم.دعم_هدف_مخرج_متحقق(); }
    | مستوى_دعم_هدف.ترجمة_متقاطعة -> { أرجع مفتاح_نص_مترجم.دعم_هدف_ترجمة_متقاطعة(); }
    | مستوى_دعم_هدف.تجريبي -> { أرجع مفتاح_نص_مترجم.دعم_هدف_تجريبي(); };
}

// Display width of a cell: its extended grapheme clusters (UAX #29), so an
// Arabic word with harakat counts its letters, not its scalars.
عرف عرض_خلية_أهداف(النص: &نص): طبيعي {
    طابق حدود_عناقيد_بايتات_يونيكود(النص) مع
    | نتيجة.خطأ(_) -> { أرجع الطول(*النص) مثل طبيعي; }
    | نتيجة.نجح(الحدود) -> {
        إذا ((الطول(الحدود) مثل طبيعي) == 0) { أرجع 0; };
        أرجع (الطول(الحدود) مثل طبيعي) - 1;
    };
}

// The localized header is one line whose cells are separated by runs of
// two or more spaces; its cells, without the trailing newline.
عرف خلايا_ترويسة_أهداف(الترويسة: &نص): متجه نص {
    دع الخلايا: متغير متجه نص = [];
    دع الجارية: متغير متجه ط8 = [];
    دع مسافات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الترويسة) مثل طبيعي)) {
        دع ب: ط8 = (*الترويسة)[ف];
        إذا (ب == 0x20) { مسافات := مسافات + 1; }
        وإلا إذا (ب != 0x0A && ب != 0x0D) {
            إذا (مسافات >= 2 && (الطول(الجارية) مثل طبيعي) > 0) {
                ألحق(الخلايا, من_بايتات(&الجارية));
                دع فارغة: متجه ط8 = [];
                الجارية := فارغة;
            } وإلا إذا (مسافات == 1 && (الطول(الجارية) مثل طبيعي) > 0) {
                ألحق(الجارية, 0x20);
            };
            مسافات := 0;
            ألحق(الجارية, ب);
        };
        ف := ف + 1;
    }
    إذا ((الطول(الجارية) مثل طبيعي) > 0) { ألحق(الخلايا, من_بايتات(&الجارية)); };
    أرجع الخلايا;
}

// One row: every cell but the last padded to its column's width plus two
// spaces. In Arabic each cell is a first-strong isolate (U+2068..U+2069),
// so in a right-to-left line a Latin cell such as "x86_64-linux" keeps its
// own order and does not pull its neighbours across the column gap; a
// terminal without bidi support shows the isolates as nothing.
عرف اكتب_صف_أهداف(الخلايا: &متجه نص, العروض: &متجه طبيعي, عربي: منطقي): فراغ {
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الخلايا) مثل طبيعي;
    طالما (ف < العدد) {
        إذا (عربي) { اكتب_خرج_عملية("\u2068"); };
        اكتب_خرج_عملية(انسخ_نص(&(*الخلايا)[ف]));
        إذا (عربي) { اكتب_خرج_عملية("\u2069"); };
        إذا (ف + 1 < العدد) {
            دع الحشو: متغير طبيعي = 2;
            دع العرض: طبيعي = عرض_خلية_أهداف(&(*الخلايا)[ف]);
            إذا (ف < (الطول(*العروض) مثل طبيعي) && (*العروض)[ف] > العرض) {
                الحشو := الحشو + ((*العروض)[ف] - العرض);
            };
            دع ح: متغير طبيعي = 0;
            طالما (ح < الحشو) { اكتب_خرج_عملية(« »); ح := ح + 1; }
        };
        ف := ف + 1;
    }
    اكتب_خرج_عملية("\n");
}

عرف اطبع_أهداف_المترجم(اللغة: لغة_تشخيص): فراغ {
    دع الترويسة_كاملة: نص = نص_المترجم(اللغة, مفتاح_نص_مترجم.ترويسة_جدول_الأهداف());
    دع الصفوف: متغير متجه متجه نص = [];
    ألحق(الصفوف, خلايا_ترويسة_أهداف(&الترويسة_كاملة));
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        دع الصف: متجه نص = [
            تهجئة_هدف_مسجل(&الأهداف[ف]),
            تهجئة_معمارية_هدف(الأهداف[ف].المعمارية.الهوية),
            نص_المترجم(اللغة, مفتاح_منصة_هدف(الأهداف[ف].المنصة.المنصة)),
            تهجئة_صيغة_كائن_هدف(الأهداف[ف].صيغة_الكائن),
            نص_المترجم(اللغة, مفتاح_دعم_هدف(الأهداف[ف].الدعم))
        ];
        ألحق(الصفوف, الصف);
        ف := ف + 1;
    }
    // Column widths from the content, header included.
    دع العروض: متغير متجه طبيعي = [];
    دع ص: متغير طبيعي = 0;
    طالما (ص < (الطول(الصفوف) مثل طبيعي)) {
        دع ع: متغير طبيعي = 0;
        طالما (ع < (الطول(الصفوف[ص]) مثل طبيعي)) {
            دع العرض: طبيعي = عرض_خلية_أهداف(&الصفوف[ص][ع]);
            إذا (ع >= (الطول(العروض) مثل طبيعي)) { ألحق(العروض, العرض); }
            وإلا إذا (العرض > العروض[ع]) { العروض[ع] := العرض; };
            ع := ع + 1;
        }
        ص := ص + 1;
    }
    دع عربي: منطقي = اللغة == لغة_تشخيص.العربية();
    ص := 0;
    طالما (ص < (الطول(الصفوف) مثل طبيعي)) {
        اكتب_صف_أهداف(&الصفوف[ص], &العروض, عربي);
        ص := ص + 1;
    }
}

// Warnings are shown as soon as the compilation returns, before its result.
عرف اعرض_تحذيرات_عملية(التحذيرات: &مجموعة_تشخيصات, الإعداد: &إعداد_عرض_عملية): فراغ {
    إذا ((الطول((*التحذيرات).التشخيصات) مثل طبيعي) > 0 || توجد_تشخيصات_سي_معلقة()) {
        اعرض_تشخيصات_عملية_المترجم(التحذيرات, انسخ_إعداد_عرض_عملية(الإعداد));
    };
}

عرف نفذ_تجميع_عملية_بتحذيرات(
    الإعداد: &إعداد_عرض_عملية,
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الطلب: طلب_تجميع_مترجم,
    مستوى_التحسين: مستوى_تحسين_مزود_إل_إل_في_إم
): نتيجة_تجميع_مترجم {
    دع التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تجميع_مترجم_بتحذيرات(
        المصدر, المصادر_الإضافية, روابط_المصادر, الطلب,
        حل_لغة_عرض_عملية((*الإعداد).اللغة), &متغير التحذيرات, مستوى_التحسين,
        (*الإعداد).ميزانية_وقت_الترجمة, انسخ_نص(&(*الإعداد).رسم_الحزم)
    );
    اعرض_تحذيرات_عملية(&التحذيرات, الإعداد);
    أرجع النتيجة;
}

// `run` of a program with imported C: build it as an executable in the
// temporary directory, run it with the program's arguments on this
// process's standard streams, and answer its exit status.
// The libraries an executable built for `run` links: the C and math
// libraries, where a program's own C functions find them, on a target whose
// programs name them (هدف_يسمي_مكتبة_سي; natively they are named with
// -l c -l m); macOS and Windows link their system libraries anyway.
عرف مكتبات_تشغيل_تنفيذي_عملية(الهدف: معرف_هدف): متجه نص {
    دع الناتج: متغير متجه نص = [];
    طابق حل_بمعرف_هدف(الهدف) مع
    | نتيجة_حل_هدف.محلول(الواصف) -> {
        إذا (هدف_يسمي_مكتبة_سي(&الواصف)) {
            ألحق(الناتج, «c»);
            ألحق(الناتج, «m»);
        };
    }
    | نتيجة_حل_هدف.غير_مسجل -> { };
    أرجع الناتج;
}

// The libraries `run` and `interpret` load: the command line's -l names,
// meaning what they mean for a build.
//   * -l c and -l m name the C and math libraries, which the interpreter
//     process already provides: they are satisfied without a search, valid
//     as they are for a build. (A program that runs as an executable links
//     them anyway: مكتبات_تشغيل_تنفيذي_عملية.)
//   * Every other name is resolved as a build resolves it
//     (حل_مكتبات_الربط: the -L directories, then the target's; a directory
//     that does not exist holds nothing, a repeated name is loaded again,
//     and a name nothing provides is the same error), and the file found is
//     read as a build reads it (مكتبات_تحميل_من_مسارات_تفسير). A static
//     archive is linked when the program runs as an executable and is an
//     error when the interpreter runs it, which loads shared libraries only.
//   * On Windows the loader opens <name>.dll (مكتبة_ويندوز_للتحميل).
عرف حل_مكتبات_تحميل_تفسير_عملية(
    الأسماء: &متجه نص,
    الأدلة: &متجه نص,
    الهدف: &واصف_هدف
): نتيجة_مكتبات_تحميل_تفسير {
    دع مكتبة_سي: نص = «c»;
    دع مكتبة_الرياضيات: نص = «m»;
    دع المطلوبة: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        إذا (!نصان_متساويان(&(*الأسماء)[ف], &مكتبة_سي) && !نصان_متساويان(&(*الأسماء)[ف], &مكتبة_الرياضيات)) {
            ألحق(المطلوبة, انسخ_نص(&(*الأسماء)[ف]));
        };
        ف := ف + 1;
    }
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ويندوز -> {
        دع الناتج: متغير متجه مكتبة_تحميل_تفسير = [];
        ف := 0;
        طالما (ف < (الطول(المطلوبة) مثل طبيعي)) {
            دع المكتبة: مكتبة_تحميل_تفسير = {
                الاسم: انسخ_نص(&المطلوبة[ف]), المسار: مكتبة_ويندوز_للتحميل(&المطلوبة[ف], الأدلة),
                الصنف: صنف_مكتبة_تحميل_تفسير.مشتركة()
            };
            ألحق(الناتج, المكتبة);
            ف := ف + 1;
        }
        أرجع نتيجة_مكتبات_تحميل_تفسير.جاهزة(الناتج);
    }
    | _ -> { };
    دع المسارات: متغير متجه نص = [];
    طابق حل_مكتبات_الربط(&المطلوبة, الأدلة, الهدف, &متغير المسارات) مع
    | اختياري.موجود(المكتبة) -> {
        أرجع نتيجة_مكتبات_تحميل_تفسير.فشل(
            تشخيصات_واجهة_بقيمة(
                معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                مفتاح_حجة_تشخيص.القيمة(), المكتبة, خطأ, خطأ
            )
        );
    }
    | اختياري.لا_شيء -> { };
    أرجع مكتبات_تحميل_من_مسارات_تفسير(&المطلوبة, &المسارات, الهدف);
}

عرف شغل_كتنفيذي_عملية(
    المصدر: نص,
    المصادر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الهدف: معرف_هدف,
    وسائط_البرنامج: &متجه متجه ط8,
    // The command line's -l names and -L directories, linked as a build
    // links them, after the C and math libraries.
    أسماء_المكتبات: متجه نص,
    أدلة_المكتبات: متجه نص,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    دع التنفيذي: نص = مسار_مؤقت_سي(«.run»);
    دع بلا_مدخلات: متجه نص = [];
    دع المكتبات: متغير متجه نص = مكتبات_تشغيل_تنفيذي_عملية(الهدف);
    دع ف_المكتبة: متغير طبيعي = 0;
    طالما (ف_المكتبة < (الطول(أسماء_المكتبات) مثل طبيعي)) {
        ألحق(المكتبات, انسخ_نص(&أسماء_المكتبات[ف_المكتبة]));
        ف_المكتبة := ف_المكتبة + 1;
    }
    دع الطلب: طلب_عملية_مترجم = طلب_عملية_مترجم.تجميع(
        المصدر, المصادر_الإضافية, بلا_مدخلات, انسخ_نص(&التنفيذي),
        اختيار_هدف_عملية.صريح(الهدف), اختيار_مزود_خلفية_عملية.تلقائي(),
        نوع_مخرج_تجميع_عملية.تنفيذي(), روابط_المصادر, المكتبات, أدلة_المكتبات,
        مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي()
    );
    دع البناء: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم(الطلب, الإعداد);
    طابق البناء مع
    | نتيجة_عملية_مترجم.تنفيذي_مكتمل -> { }
    | _ -> {
        دع الحذف: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
        أرجع البناء;
    };
    دع الوسائط: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*وسائط_البرنامج) مثل طبيعي)) {
        ألحق(الوسائط, انسخ_بايتات(&(*وسائط_البرنامج)[ف]) مثل نص);
        ف := ف + 1;
    }
    دع الحالة: نتيجة حالة_إنهاء, عدد = شغل_وانتظر(&التنفيذي, &الوسائط);
    دع الحذف: نتيجة عدد, عدد = أزل_ملفا(&التنفيذي);
    طابق الحالة مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج((الرمز & 255) مثل طبيعي));
    }
    | نتيجة.نجح(حالة_إنهاء.إشارة(الإشارة)) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج((128 + الإشارة) مثل طبيعي));
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_تفسير_مسير.خرج(127));
    };
}

عام عرف نفذ_طلب_عملية_مترجم(
    الطلب: طلب_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): نتيجة_عملية_مترجم {
    دع لغة_العرض: لغة_تشخيص = حل_لغة_عرض_عملية(الإعداد.اللغة);
    طابق الطلب مع
    | طلب_عملية_مترجم.مساعدة -> {
        اطبع_مساعدة_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.إصدار -> {
        اطبع_إصدار_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.أهداف -> {
        اطبع_أهداف_المترجم(لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.تنسيق(طلب_التنسيق) -> {
        طابق نفذ_أمر_التنسيق(&طلب_التنسيق) مع
        | نتيجة_أمر_تنسيق.منسقة -> { أرجع نتيجة_عملية_مترجم.أمر_مكتمل(); }
        | نتيجة_أمر_تنسيق.تحتاج_تنسيقا(التشخيصات) -> { أرجع نتيجة_عملية_مترجم.تنسيق_مطلوب(التشخيصات); }
        | نتيجة_أمر_تنسيق.فشلت(التشخيصات) -> { أرجع نتيجة_عملية_مترجم.فشل_تنسيق(التشخيصات); };
    }
    | طلب_عملية_مترجم.شرح(الكود) -> {
        اطبع_شرح_تشخيص(&الكود, لغة_العرض);
        أرجع نتيجة_عملية_مترجم.أمر_مكتمل();
    }
    | طلب_عملية_مترجم.تحقق(المصدر, المصادر_الإضافية, روابط_المصادر, اختيار_الهدف) -> {
        // Without --target, `check` checks for the host.
        دع الهدف: واصف_هدف;
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(المحدد) -> { الهدف := المحدد; };
        دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
            &الإعداد,
            المصدر, المصادر_الإضافية, روابط_المصادر, طلب_تجميع_مترجم.تحقق(الهدف.المعرف),
            مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي()
        );
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.تحقق_مكتمل -> {
            أرجع نتيجة_عملية_مترجم.تحقق_مكتمل();
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.تفسير(
        المصدر, المصادر_الإضافية, وسائط_البرنامج, اختيار_الهدف, روابط_المصادر,
        أسماء_المكتبات, أدلة_المكتبات
    ) -> {
        // Resolve the target independently of backend selection. The shared
        // compiler driver enforces host compatibility for every caller.
        دع الهدف: واصف_هدف;
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(المحدد) -> { الهدف := المحدد; };
        دع مكتبات_التحميل: متجه مكتبة_تحميل_تفسير;
        طابق حل_مكتبات_تحميل_تفسير_عملية(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف) مع
        | نتيجة_مكتبات_تحميل_تفسير.فشل(التشخيصات) -> {
            أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات);
        }
        | نتيجة_مكتبات_تحميل_تفسير.جاهزة(المكتبات) -> { مكتبات_التحميل := المكتبات; };
        دع التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        // Copies for a run as an executable (شغل_كتنفيذي_عملية).
        دع مصدر_التنفيذي: نص = انسخ_نص(&المصدر);
        دع إضافية_التنفيذي: متغير متجه نص = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المصادر_الإضافية) مثل طبيعي)) {
            ألحق(إضافية_التنفيذي, انسخ_نص(&المصادر_الإضافية[ف])); ف := ف + 1;
        }
        دع روابط_التنفيذي: متغير متجه ربط_مصدر_وحدة_عملية = [];
        ف := 0;
        طالما (ف < (الطول(روابط_المصادر) مثل طبيعي)) {
            دع الربط: ربط_مصدر_وحدة_عملية = {
                الوحدة: انسخ_نص(&روابط_المصادر[ف].الوحدة), المصدر: انسخ_نص(&روابط_المصادر[ف].المصدر)
            };
            ألحق(روابط_التنفيذي, الربط); ف := ف + 1;
        }
        دع وسائط_التنفيذي: متغير متجه متجه ط8 = [];
        ف := 0;
        طالما (ف < (الطول(وسائط_البرنامج) مثل طبيعي)) {
            ألحق(وسائط_التنفيذي, انسخ_بايتات(&وسائط_البرنامج[ف])); ف := ف + 1;
        }
        دع النتيجة: نتيجة_تجميع_مترجم = نفذ_طلب_تفسير_مترجم(
            المصدر, المصادر_الإضافية, روابط_المصادر, الهدف.المعرف, وسائط_البرنامج,
            مكتبات_التحميل, عرض_فشل_تفسير_عملية(&الإعداد), حل_لغة_عرض_عملية(الإعداد.اللغة), &متغير التحذيرات, الإعداد.ميزانية_وقت_الترجمة,
            انسخ_نص(&الإعداد.رسم_الحزم)
        );
        اعرض_تحذيرات_عملية(&التحذيرات, &الإعداد);
        طابق النتيجة مع
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر);
        }
        | نتيجة_تجميع_مترجم.تفسير_بتنفيذي -> {
            أرجع شغل_كتنفيذي_عملية(
                مصدر_التنفيذي, إضافية_التنفيذي, روابط_التنفيذي, الهدف.المعرف, &وسائط_التنفيذي,
                أسماء_المكتبات, أدلة_المكتبات, الإعداد
            );
        }
        | نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات) -> {
            أرجع نتيجة_عملية_مترجم.فشل_تفسير(التشخيصات);
        }
        | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(
                تشخيصات_هدف_مضيف_غير_متاح()
            );
        }
        | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
    }
    | طلب_عملية_مترجم.تجميع(
        المصدر,
        المصادر_الإضافية,
        مدخلات_الربط_المباشرة,
        مسار_الإخراج,
        اختيار_الهدف,
        اختيار_المزود,
        نوع_المخرج,
        روابط_المصادر,
        أسماء_المكتبات,
        أدلة_المكتبات,
        مستوى_التحسين
    ) -> {
        طابق حل_اختيار_هدف_عملية(اختيار_الهدف) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(تشخيصات_هدف_مضيف_غير_متاح());
        }
        | نتيجة_حل_هدف.محلول(الهدف) -> {
            // Direct link inputs first, then the -l libraries in order.
            دع مدخلات_الربط: متغير متجه نص = مدخلات_الربط_المباشرة;
            طابق حل_مكتبات_الربط(&أسماء_المكتبات, &أدلة_المكتبات, &الهدف, &متغير مدخلات_الربط) مع
            | اختياري.موجود(المكتبة) -> {
                أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                    تشخيصات_واجهة_بقيمة(
                        معرف_تشخيص.مكتبة_ربط_غير_موجودة(),
                        مفتاح_حجة_تشخيص.القيمة(), المكتبة, خطأ, خطأ
                    )
                );
            }
            | اختياري.لا_شيء -> { };
            دع مزود_الخلفية: هوية_مزود_خلفية;
            طابق اختيار_المزود مع
            | اختيار_مزود_خلفية_عملية.تلقائي -> {
                // Assembly text comes from LLVM (the native encoders write
                // machine code directly).
                إذا (نوع_المخرج == نوع_مخرج_تجميع_عملية.نص_تجميع()
                    || نوع_المخرج == نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم()) {
                    مزود_الخلفية := هوية_مزود_خلفية.إل_إل_في_إم();
                } وإلا {
                    مزود_الخلفية := مزود_الخلفية_المفضل(&الهدف);
                };
            }
            | اختيار_مزود_خلفية_عملية.صريح(المزود) -> {
                مزود_الخلفية := المزود;
            }
            | اختيار_مزود_خلفية_عملية.إصدار -> {
                إذا (مزود_خلفية_مضمن_في_المترجم(هوية_مزود_خلفية.إل_إل_في_إم())
                    && يدعم_مزود_الخلفية(&الهدف, هوية_مزود_خلفية.إل_إل_في_إم())) {
                    مزود_الخلفية := هوية_مزود_خلفية.إل_إل_في_إم();
                } وإلا {
                    مزود_الخلفية := مزود_الخلفية_المفضل(&الهدف);
                };
            };
            طابق نوع_المخرج مع
            | نوع_مخرج_تجميع_عملية.نص_تجميع -> {
                إذا (مزود_الخلفية != هوية_مزود_خلفية.إل_إل_في_إم()) {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.أوضاع_مترجم_متعارضة(),
                            مفتاح_حجة_تشخيص.القيمة(), «--emit=asm --backend=native», خطأ, خطأ
                        )
                    );
                };
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.تجميع()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.نص_وحدة_إل_إل_في_إم -> {
                إذا (مزود_الخلفية != هوية_مزود_خلفية.إل_إل_في_إم()) {
                    أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                        تشخيصات_واجهة_بقيمة(
                            معرف_تشخيص.أوضاع_مترجم_متعارضة(),
                            مفتاح_حجة_تشخيص.القيمة(), «--emit=llvm-ir --backend=native», خطأ, خطأ
                        )
                    );
                };
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.وحدة_إل_إل_في_إم()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.كائن -> {
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.كائن(الهدف.المعرف, مزود_الخلفية, نص_مخرج_كائن_مترجم.ثنائي()),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.كائن_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.تنفيذي -> {
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.تنفيذي(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.تنفيذي_مكتمل(البايتات) -> {
                    طابق اكتب_بايتات_تنفيذية_عملية(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج_نظام(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> { أرجع نتيجة_عملية_مترجم.تنفيذي_مكتمل(); };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.مكتبة_مشتركة -> {
                دع اسم_المكتبة: اختياري نص = اسم_الملف(&مسار_الإخراج);
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.مكتبة_مشتركة(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اسم_المكتبة
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.مكتبة_مشتركة_مكتملة(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            }
            | نوع_مخرج_تجميع_عملية.كائن_مترابط -> {
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.كائن_مترابط(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.كائن_مترابط_مكتمل(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.كائن_مترابط_مكتمل();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            
            }
            | نوع_مخرج_تجميع_عملية.وحدة_هدف -> {
                دع النتيجة: نتيجة_تجميع_مترجم = نفذ_تجميع_عملية_بتحذيرات(
                    &الإعداد,
                    المصدر,
                    المصادر_الإضافية,
                    روابط_المصادر,
                    طلب_تجميع_مترجم.ربط(
                        الهدف.المعرف,
                        مزود_الخلفية,
                        نوع_خرج_ربط_مترجم.وحدة_هدف(),
                        مدخلات_الربط,
                        أدلة_المكتبات,
                        اختياري.لا_شيء()
                    ),
                    مستوى_التحسين
                );
                طابق النتيجة مع
                | نتيجة_تجميع_مترجم.وحدة_هدف_مكتملة(البايتات) -> {
                    طابق اكتب_البايتات(&مسار_الإخراج, &البايتات) مع
                    | نتيجة.خطأ(الحالة) -> {
                        أرجع نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(
                            تشخيصات_فشل_كتابة_مخرج(مسار_الإخراج, الحالة)
                        );
                    }
                    | نتيجة.نجح(_) -> {
                        أرجع نتيجة_عملية_مترجم.وحدة_هدف_مكتملة();
                    };
                }
                | _ -> { أرجع نتيجة_عملية_مترجم.فشل_تجميع(النتيجة); };
            };
        };
    };
}

عرف رمز_نتيجة_تفسير_عملية(
    النتيجة: &نتيجة_تفسير_مسير
): عدد {
    طابق *النتيجة مع
    | نتيجة_تفسير_مسير.خرج(الحالة) -> { أرجع الحالة مثل عدد; }
    | نتيجة_تفسير_مسير.نجح(القيمة_الاختيارية) -> {
        طابق القيمة_الاختيارية مع
        | اختياري.لا_شيء -> { أرجع 0; }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة مع
            | قيمة_تشغيل.بتات_عدد(الحالة) -> { أرجع الحالة مثل عدد; }
            | _ -> { أرجع 0; };
        };
    }
    | نتيجة_تفسير_مسير.هدف_غير_متوافق -> { أرجع 3; }
    | نتيجة_تفسير_مسير.أخفق(_) -> {
        // Compiler Driver translates failures while source/provenance/debug facts are live.
        أرجع 4;
    };
}

عرف رمز_فشل_تشخيصات(التشخيصات: &مجموعة_تشخيصات): عدد {
    إذا (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.داخلي())) { أرجع 4; };
    إذا (مجموعة_تشخيصات_تحوي_فئة(التشخيصات, فئة_تشخيص.بيئة())) { أرجع 3; };
    أرجع 1;
}

عرف رمز_نتيجة_عملية_مترجم(
    النتيجة: &نتيجة_عملية_مترجم,
    الإعداد: إعداد_عرض_عملية
): عدد {
    طابق *النتيجة مع
    | نتيجة_عملية_مترجم.أمر_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تحقق_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.كائن_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.تنفيذي_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.مكتبة_مشتركة_مكتملة -> { أرجع 0; }
    | نتيجة_عملية_مترجم.كائن_مترابط_مكتمل -> { أرجع 0; }
    | نتيجة_عملية_مترجم.وحدة_هدف_مكتملة -> { أرجع 0; }
    | نتيجة_عملية_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
        أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر);
    }
    | نتيجة_عملية_مترجم.فشل_تفسير(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 2;
    }
    | نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.هدف_المضيف_غير_متاح(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.فشل_بيئة_أو_مخرج(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
    }
    | نتيجة_عملية_مترجم.تنسيق_مطلوب(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 1;
    }
    | نتيجة_عملية_مترجم.فشل_تنسيق(التشخيصات) -> {
        اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
        أرجع رمز_فشل_تشخيصات(&التشخيصات);
    }
    | نتيجة_عملية_مترجم.فشل_تجميع(نتيجة_التجميع) -> {
        طابق نتيجة_التجميع مع
        | نتيجة_تجميع_مترجم.ملغى -> { أرجع 1; }
        | نتيجة_تجميع_مترجم.فشل_إعداد(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_واجهة(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_مسير(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 4;
        }
        | نتيجة_تجميع_مترجم.مدخل_تفسير_غير_متاح -> {
            // `run` of a program without an entry function said nothing.
            دع التشخيصات: مجموعة_تشخيصات = تشخيصات_نقطة_دخول_مفقودة();
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع 1;
        }
        | نتيجة_تجميع_مترجم.هدف_غير_مسجل -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد); أرجع 3;
        }
        | نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات) -> {
            اعرض_تشخيصات_عملية_المترجم(&التشخيصات, الإعداد);
            أرجع رمز_فشل_تشخيصات(&التشخيصات);
        }
        | نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر) -> {
            أرجع رمز_نتيجة_تفسير_عملية(&نتيجة_المفسر);
        }
        | نتيجة_تجميع_مترجم.تحقق_مكتمل -> { أرجع 0; }
        | نتيجة_تجميع_مترجم.تفسير_بتنفيذي -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.كائن_مكتمل(_) -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.تنفيذي_مكتمل(_) -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.مكتبة_مشتركة_مكتملة(_) -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.كائن_مترابط_مكتمل(_) -> { أرجع 3; }
        | نتيجة_تجميع_مترجم.وحدة_هدف_مكتملة(_) -> { أرجع 3; };
    };
}

عام عرف شغل_عملية_المترجم(): عدد {
    // Deeply nested source recurses deeply in every compiler phase; the
    // default 8 MiB main stack is not enough. Raise the soft limit (Linux)
    // to 64 MiB, within the hard limit. Elsewhere this changes nothing.
    دع المكدس_كاف: منطقي = اطلب_مكدسا_بحجم_نظام(67108864 مثل ط64);
    طابق حلل_استدعاء_المترجم() مع
    | نتيجة_تحليل_استدعاء_مترجم.غير_صالح(التشخيصات, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.استدعاء_غير_صالح(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.هدف_غير_معروف(التشخيصات, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نتيجة_عملية_مترجم.هدف_غير_معروف(التشخيصات);
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    }
    | نتيجة_تحليل_استدعاء_مترجم.صالح(الطلب, الإعداد) -> {
        دع النتيجة: نتيجة_عملية_مترجم = نفذ_طلب_عملية_مترجم(الطلب, انسخ_إعداد_عرض_عملية(&الإعداد));
        أرجع رمز_نتيجة_عملية_مترجم(&النتيجة, الإعداد);
    };
}
