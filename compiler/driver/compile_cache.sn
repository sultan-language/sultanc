استورد std.fs.metadata;
استورد std.fs.directory;
استورد std.fs.mutation;
استورد std.fs.permissions;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.fs.write_file;
استورد std.env.environment;
استورد std.env.variables;
استورد std.env.executable;
استورد std.process.id;
استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد std.text.from_bytes;
استورد std.text.transform;
استورد std.collections.sort;
استورد std.crypto.sha256;
استورد std.hash.xxh64;
استورد std.encoding.hex;
استورد compiler.source.source_map;
استورد compiler.source.source_file;

// The content-addressed compilation cache (docs/en/internals/compile-cache.md).
//
// The compiler is a whole-program pipeline: every module of a program is
// loaded, analysed and lowered to one MSIR program together, and one object
// (or executable) comes out. What is cached is therefore one compilation: its
// output bytes, under the identity of everything that decides them.
//
//   الطلب    the request key (process_driver.sn مفتاح_خزن_طلب): the identity
//            of this compiler (the hash of its executable, and of the libLLVM
//            it runs with), the normalized request (sources as given, target,
//            backend, -O, output kind and path, module-source bindings, -l/-L
//            and the files they resolve to, link inputs by content, the
//            package graph by content, the language), the environment that
//            reaches the compilation (SULTANC_STD, SULTANC_LINKER) and the
//            working directory.
//   البيان   a manifest under the request key: the hash of every module
//            source the compilation read (from its source map: exactly the
//            text it compiled), the listing of each directory those sources
//            come from and of their ancestors (a file added or removed next
//            to a loaded module), the folder root files and Supax.toml files
//            of those directories (module spellings, package identity), the
//            output's hash and mode.
//
// A lookup takes the request key's manifests and accepts the first one whose
// files all still hash the same; its output bytes are then copied to the
// output path. So the output of a hit is the output of the compilation that
// stored it, byte for byte, and that compilation read exactly the inputs the
// manifest checks. A compilation that could have read anything else is not
// stored: one with warnings (a hit would print none), a C import (its headers
// are read by the C bridge, outside the source map), an embedded file
// (`ضمن_ملف`, `embed_file`), an external linker, or a source whose text is not
// the file's (an editor overlay; the one generated source accepted is std's
// process/failure_text.sn, a function of the language in the request key).
//
// Directory (SULTANC_CACHE, else the user cache directory):
//   objects/<2>/<hash>            output bytes, named by their SHA-256
//   manifests/<2>/<key>/<hash>    manifests, named by the SHA-256 of their text
//   identities/<2>/<hash>         the hash of a large file (the compiler, a
//                                 libLLVM, a link input) by path, size and
//                                 modification time
//   tmp/                          files being written; every entry is
//                                 written there and renamed into place, so
//                                 concurrent compilers never see half a file
// Size: SULTANC_CACHE_LIMIT MiB (default 2048). At most once an hour a store
// removes the oldest entries until the cache is under 80% of the limit.

عام نوع خزن_تجميع = {
    الدليل: نص,
    // Bytes.
    الحد: طبيعي
};

// One module source a compilation read.
عام نوع مصدر_مستعمل = {
    الاسم: نص,
    البصمة: نص
};

// What the compiler driver records while a compilation that may be stored
// runs (compiler_driver.sn, after the Frontend): the sources and whether
// anything makes the compilation unfit to store.
ليكن تسجيل_مصادر_مفعل: متغير منطقي = خطأ;
ليكن مصادر_التجميع: متغير متجه مصدر_مستعمل = [];
ليكن تجميع_لا_يخزن: متغير منطقي = خطأ;
ليكن عداد_المؤقت: متغير طبيعي = 0;

// --- texts and hashes ------------------------------------------------------------

عرف صل_خزن(الأجزاء: &متجه نص): نص {
    ليكن فارغ: نص = «»;
    أرجع صل_النصوص(الأجزاء, &فارغ);
}

// Keys and manifest names: SHA-256 (small texts).
عام عرف بصمة_بايتات_خزن(البايتات: &متجه ط8): نص {
    ليكن الملخص: متجه ط8 = شا256(البايتات);
    أرجع رمز_سداسي(&الملخص);
}

عرف سداسي16(القيمة: طبيعي): نص {
    ليكن الأرقام: نص = «0123456789abcdef»;
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        ليكن الإزاحة: طبيعي = (15 - ف) * 4;
        ألحق(البايتات, الأرقام[(القيمة >> الإزاحة) & 15]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// Contents (sources, outputs, large files): two XXH64 lanes with different
// seeds, 128 bits, 32 hexadecimal digits. Every compilation hashes the text
// of every module it loads, so the content hash is the fast one; what it
// guards is a stale entry, not an adversary (the cache is the user's own).
عام عرف بصمة_محتوى(البايتات: &متجه ط8): نص {
    ليكن الأول: طبيعي = هاش_إكس_إكس_إتش64_ببذرة(البايتات, 0);
    ليكن الثاني: طبيعي = هاش_إكس_إكس_إتش64_ببذرة(البايتات, 11400714785074694791);
    أرجع صل_خزن(&[سداسي16(الأول), سداسي16(الثاني)]);
}

عرف بصمة_نص_محتوى(النص: &نص): نص {
    ليكن البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(النص));
    أرجع بصمة_محتوى(&البايتات);
}

عام عرف بصمة_نص_خزن(النص: &نص): نص {
    ليكن البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(النص));
    أرجع بصمة_بايتات_خزن(&البايتات);
}

عرف أول_محرفين(النص: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    إذا ((الطول(*النص) مثل طبيعي) >= 2) {
        ألحق(البايتات, (*النص)[0]);
        ألحق(البايتات, (*النص)[1]);
    };
    أرجع من_بايتات(&البايتات);
}

// --- files -----------------------------------------------------------------------

عرف يوجد_خزن(المسار: &نص): منطقي {
    طابق موجود(المسار) مع
    | نتيجة.نجح(الحالة) -> { أرجع الحالة; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// Creates المسار and every missing directory above it.
عرف أنشئ_مسار_خزن(المسار: &نص): منطقي {
    إذا (يوجد_خزن(المسار)) { أرجع صواب; };
    ليكن البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(المسار));
    ليكن العدد: طبيعي = الطول(البايتات) مثل طبيعي;
    ليكن الجزء: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        ليكن عند_فاصل: منطقي = ف == العدد || البايتات[ف] == 0x2F || البايتات[ف] == 0x5C;
        إذا (عند_فاصل && (الطول(الجزء) مثل طبيعي) > 0) {
            ليكن المقطع: نص = من_بايتات(&الجزء);
            إذا (!يوجد_خزن(&المقطع)) {
                طابق أنشئ_دليلا(&المقطع) مع
                | نتيجة.نجح(_) -> { }
                | نتيجة.خطأ(_) -> { إذا (!يوجد_خزن(&المقطع)) { أرجع خطأ; }; };
            };
        };
        إذا (ف < العدد) { ألحق(الجزء, البايتات[ف]); };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A fresh name in the cache's tmp/ (this process's id and a counter).
عرف مسار_مؤقت_خزن(الخزن: &خزن_تجميع): نص {
    ليكن العدد: متغير طبيعي = 0;
    غير_آمن {
        عداد_المؤقت := عداد_المؤقت + 1;
        العدد := عداد_المؤقت;
    }
    ليكن المعرف: عدد = معرف_العملية() مثل عدد;
    أرجع صل_خزن(&[
        انسخ_نص(&(*الخزن).الدليل), «/tmp/», عدد_إلى_نص(المعرف), «-», طبيعي_إلى_نص(العدد)
    ]);
}

// Writes البايتات to الوجهة through tmp/ and a rename: a reader sees the
// whole file or none.
عرف اكتب_بالتبديل(الخزن: &خزن_تجميع, الوجهة: &نص, البايتات: &متجه ط8): منطقي {
    ليكن المؤقت: نص = مسار_مؤقت_خزن(الخزن);
    طابق اكتب_البايتات(&المؤقت, البايتات) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
    طابق أعد_تسمية(&المؤقت, الوجهة) مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> {
        طابق أزل_ملفا(&المؤقت) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        أرجع خطأ;
    };
}

// The names in a directory, sorted (none when it cannot be read).
عرف أسماء_دليل_خزن(المسار: &نص): متجه نص {
    ليكن الأسماء: متغير متجه نص = [];
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) { ألحق(الأسماء, انسخ_نص(&المداخل[ف].الاسم)); ف := ف + 1; }
    }
    | نتيجة.خطأ(_) -> { };
    رتب_نصوص(&متغير الأسماء);
    أرجع الأسماء;
}

// What of a directory can change how modules resolve: its subdirectories
// (folder modules), its .sn files and its Supax.toml, by name, sorted. Other
// files (outputs written beside a source) do not count.
عرف أسماء_وحدات_دليل_خزن(المسار: &نص): متجه نص {
    ليكن الأسماء: متغير متجه نص = [];
    ليكن لاحقة: نص = «.sn»;
    ليكن الحزمة: نص = «Supax.toml»;
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            ليكن يعد: متغير منطقي = ينتهي_بـ(&المداخل[ف].الاسم, &لاحقة) || نصان_متساويان(&المداخل[ف].الاسم, &الحزمة);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { يعد := صواب; }
            | _ -> { };
            إذا (يعد) { ألحق(الأسماء, انسخ_نص(&المداخل[ف].الاسم)); };
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    رتب_نصوص(&متغير الأسماء);
    أرجع الأسماء;
}

// The hash of a directory's module listing (أسماء_وحدات_دليل_خزن).
عرف بصمة_دليل_خزن(المسار: &نص): نص {
    ليكن الأسماء: متجه نص = أسماء_وحدات_دليل_خزن(المسار);
    ليكن السطر: نص = "\n";
    ليكن النص: نص = صل_النصوص(&الأسماء, &السطر);
    أرجع بصمة_نص_محتوى(&النص);
}

// The hash of a file's content, or «-» when there is none.
عرف بصمة_ملف_أو_غياب(المسار: &نص): نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.نجح(البايتات) -> { أرجع بصمة_محتوى(&البايتات); }
    | نتيجة.خطأ(_) -> { أرجع «-»; };
}

// The hash of a file's content («-» when there is none): the package graph
// in the request key.
عام عرف بصمة_محتوى_ملف(المسار: &نص): نص { أرجع بصمة_ملف_أو_غياب(المسار); }

// The directory part of a path ("" for a bare name).
عرف دليل_مسار_خزن(المسار: &نص): نص {
    ليكن الفاصل: نص = «/»;
    طابق ابحث_نصا_عكسيا(المسار, &الفاصل) مع
    | اختياري.موجود(الموضع) -> {
        ليكن البايتات: متغير متجه ط8 = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < الموضع) { ألحق(البايتات, (*المسار)[ف]); ف := ف + 1; }
        أرجع من_بايتات(&البايتات);
    }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف آخر_جزء_خزن(المسار: &نص): نص {
    ليكن الفاصل: نص = «/»;
    طابق ابحث_نصا_عكسيا(المسار, &الفاصل) مع
    | اختياري.موجود(الموضع) -> {
        ليكن البايتات: متغير متجه ط8 = [];
        ليكن ف: متغير طبيعي = الموضع + 1;
        طالما (ف < (الطول(*المسار) مثل طبيعي)) { ألحق(البايتات, (*المسار)[ف]); ف := ف + 1; }
        أرجع من_بايتات(&البايتات);
    }
    | اختياري.لا_شيء -> { أرجع انسخ_نص(المسار); };
}

// --- the cache directory ------------------------------------------------------------

عرف بيئة_خزن(الاسم: &نص): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع «»; };
}

// The user cache directory's sultanc/: $XDG_CACHE_HOME, else
// ~/Library/Caches on macOS, %LOCALAPPDATA% on Windows, ~/.cache elsewhere.
إذا (الهدف.المنصة == «macos») {
    عرف دليل_خزن_المستخدم(): نص {
        ليكن xdg: نص = «XDG_CACHE_HOME»;
        ليكن القيمة: نص = بيئة_خزن(&xdg);
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع صل_خزن(&[القيمة, «/sultanc»]); };
        طابق الدليل_الرئيسي() مع
        | نتيجة.نجح(اختياري.موجود(البيت)) -> { أرجع صل_خزن(&[البيت, «/Library/Caches/sultanc»]); }
        | _ -> { أرجع «»; };
    }
}
إذا (الهدف.المنصة == «windows») {
    عرف دليل_خزن_المستخدم(): نص {
        ليكن المحلي: نص = «LOCALAPPDATA»;
        ليكن القيمة: نص = بيئة_خزن(&المحلي);
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع صل_خزن(&[القيمة, «/sultanc»]); };
        أرجع «»;
    }
}
إذا (الهدف.المنصة != «macos» && الهدف.المنصة != «windows») {
    عرف دليل_خزن_المستخدم(): نص {
        ليكن xdg: نص = «XDG_CACHE_HOME»;
        ليكن القيمة: نص = بيئة_خزن(&xdg);
        إذا ((الطول(القيمة) مثل طبيعي) > 0) { أرجع صل_خزن(&[القيمة, «/sultanc»]); };
        طابق الدليل_الرئيسي() مع
        | نتيجة.نجح(اختياري.موجود(البيت)) -> { أرجع صل_خزن(&[البيت, «/.cache/sultanc»]); }
        | _ -> { أرجع «»; };
    }
}

// The cache this compilation uses: SULTANC_CACHE names its directory («off»
// turns it off), else the user cache directory; لا_شيء when there is none or
// it cannot be created (the compilation then runs without a cache).
عام عرف افتح_خزن_التجميع(): اختياري خزن_تجميع {
    ليكن الاسم: نص = «SULTANC_CACHE»;
    ليكن المحدد: نص = بيئة_خزن(&الاسم);
    ليكن مطفأ: نص = «off»;
    إذا (نصان_متساويان(&المحدد, &مطفأ)) { أرجع اختياري.لا_شيء(); };
    ليكن الدليل: متغير نص = المحدد;
    إذا ((الطول(الدليل) مثل طبيعي) == 0) { الدليل := دليل_خزن_المستخدم(); };
    إذا ((الطول(الدليل) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    ليكن المؤقت: نص = صل_خزن(&[انسخ_نص(&الدليل), «/tmp»]);
    إذا (!أنشئ_مسار_خزن(&المؤقت)) { أرجع اختياري.لا_شيء(); };
    ليكن اسم_الحد: نص = «SULTANC_CACHE_LIMIT»;
    ليكن نص_الحد: نص = بيئة_خزن(&اسم_الحد);
    ليكن الميغا: متغير طبيعي = 2048;
    إذا ((الطول(نص_الحد) مثل طبيعي) > 0) {
        طابق حلل_عدد(&نص_الحد) مع
        | نتيجة.نجح(القيمة) -> { إذا (القيمة > 0) { الميغا := القيمة مثل طبيعي; }; }
        | نتيجة.خطأ(_) -> { };
    };
    ليكن الخزن: خزن_تجميع = { الدليل: الدليل, الحد: الميغا * 1048576 };
    أرجع اختياري.موجود(الخزن);
}

// --- identities of large files ----------------------------------------------------

// The SHA-256 of a file's content, kept under identities/ by its path, size
// and modification time, so a compiler, a libLLVM or a link input is hashed
// once per version and not at every compilation. لا_شيء when it cannot be read.
عام عرف بصمة_ملف_كبير(الخزن: &خزن_تجميع, المسار: &نص): اختياري نص {
    ليكن الحجم: عدد;
    طابق حجم_المسار(المسار) مع
    | نتيجة.نجح(ح) -> { الحجم := ح; }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    ليكن الوقت: عدد;
    طابق وقت_تعديل_المسار_نانو(المسار) مع
    | نتيجة.نجح(و) -> { الوقت := و; }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    ليكن الوصف: نص = صل_خزن(&[انسخ_نص(المسار), "\n", عدد_إلى_نص(الحجم), "\n", عدد_إلى_نص(الوقت)]);
    ليكن المفتاح: نص = بصمة_نص_خزن(&الوصف);
    ليكن الدليل: نص = صل_خزن(&[انسخ_نص(&(*الخزن).الدليل), «/identities/», أول_محرفين(&المفتاح)]);
    ليكن المدخل: نص = صل_خزن(&[انسخ_نص(&الدليل), «/», انسخ_نص(&المفتاح)]);
    طابق اقرأ_الملف(&المدخل) مع
    | نتيجة.نجح(المحفوظ) -> {
        إذا ((الطول(المحفوظ) مثل طبيعي) == 32) { أرجع اختياري.موجود(المحفوظ); };
    }
    | نتيجة.خطأ(_) -> { };
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.نجح(البايتات) -> {
        ليكن البصمة: نص = بصمة_محتوى(&البايتات);
        إذا (أنشئ_مسار_خزن(&الدليل)) {
            ليكن بايتات_البصمة: متجه ط8 = بايتات_من_نص(انسخ_نص(&البصمة));
            ليكن كتب: منطقي = اكتب_بالتبديل(الخزن, &المدخل, &بايتات_البصمة);
        };
        أرجع اختياري.موجود(البصمة);
    }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// The identity of the running compiler: the hash of its executable.
عام عرف بصمة_المترجم_الجاري(الخزن: &خزن_تجميع): اختياري نص {
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.نجح(المسار) -> { أرجع بصمة_ملف_كبير(الخزن, &المسار); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// --- recording a compilation's sources ----------------------------------------------

// Called before a compilation that may be stored: the compiler driver then
// records its sources.
عام عرف ابدأ_تسجيل_مصادر_التجميع(): فراغ {
    غير_آمن {
        تسجيل_مصادر_مفعل := صواب;
        ليكن فارغ: متجه مصدر_مستعمل = [];
        مصادر_التجميع := فارغ;
        تجميع_لا_يخزن := خطأ;
    }
}

عام عرف أوقف_تسجيل_مصادر_التجميع(): فراغ {
    غير_آمن { تسجيل_مصادر_مفعل := خطأ; }
}

// Something the cache cannot see decides this compilation (an external
// linker, warnings, a C import): it is not stored.
عام عرف علّم_تجميعا_لا_يخزن(): فراغ {
    غير_آمن {
        إذا (تسجيل_مصادر_مفعل) { تجميع_لا_يخزن := صواب; };
    }
}

عرف ينتهي_بأحد(النص: &نص, الأول: &نص, الثاني: &نص): منطقي {
    أرجع ينتهي_بـ(النص, الأول) || ينتهي_بـ(النص, الثاني);
}

// The compiler driver hands the Frontend's source map here: every module
// source the compilation read, exactly as it read it.
عام عرف سجل_مصادر_الواجهة_للخزن(الخريطة: &خريطة_مصادر): فراغ {
    ليكن مفعل: متغير منطقي = خطأ;
    غير_آمن { مفعل := تسجيل_مصادر_مفعل; }
    إذا (!مفعل) { أرجع; };
    ليكن المسجلة: متغير متجه مصدر_مستعمل = [];
    ليكن لا_يخزن: متغير منطقي = خطأ;
    ليكن سي_ح: نص = «.h»;
    ليكن سي_ج: نص = «.c»;
    ليكن تضمين_عربي: نص = «ضمن_ملف»;
    ليكن تضمين_إنجليزي: نص = «embed_file»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخريطة).المصادر) مثل طبيعي)) {
        ليكن المصدر: &مصدر = &(*الخريطة).المصادر[ف];
        إذا (ينتهي_بأحد(&(*المصدر).الاسم, &سي_ح, &سي_ج)) { لا_يخزن := صواب; };
        إذا (يحتوي_نصا(&(*المصدر).المحتوى, &تضمين_عربي) || يحتوي_نصا(&(*المصدر).المحتوى, &تضمين_إنجليزي)) {
            لا_يخزن := صواب;
        };
        ليكن المستعمل: مصدر_مستعمل = {
            الاسم: انسخ_نص(&(*المصدر).الاسم), البصمة: بصمة_نص_محتوى(&(*المصدر).المحتوى)
        };
        ألحق(المسجلة, المستعمل);
        ف := ف + 1;
    }
    غير_آمن {
        ليكن م: متغير طبيعي = 0;
        طالما (م < (الطول(المسجلة) مثل طبيعي)) {
            ليكن النسخة: مصدر_مستعمل = { الاسم: انسخ_نص(&المسجلة[م].الاسم), البصمة: انسخ_نص(&المسجلة[م].البصمة) };
            ألحق(مصادر_التجميع, النسخة);
            م := م + 1;
        }
        إذا (لا_يخزن) { تجميع_لا_يخزن := صواب; };
    }
}

// --- manifests -------------------------------------------------------------------

عرف دليل_بيانات_المفتاح(الخزن: &خزن_تجميع, المفتاح: &نص): نص {
    أرجع صل_خزن(&[
        انسخ_نص(&(*الخزن).الدليل), «/manifests/», أول_محرفين(المفتاح), «/», انسخ_نص(المفتاح)
    ]);
}

عرف مسار_كائن_خزن(الخزن: &خزن_تجميع, البصمة: &نص): نص {
    أرجع صل_خزن(&[
        انسخ_نص(&(*الخزن).الدليل), «/objects/», أول_محرفين(البصمة), «/», انسخ_نص(البصمة)
    ]);
}

// Whether every line of a manifest still holds; then its output's hash and
// mode in البصمة and الوضع.
عرف بيان_صالح(النص: &نص, البصمة: &متغير نص, الوضع: &متغير طبيعي): منطقي {
    ليكن الأسطر: متجه نص = أسطر_النص(النص);
    ليكن الترويسة: نص = «sultanc-cache 1»;
    إذا ((الطول(الأسطر) مثل طبيعي) < 2 || !نصان_متساويان(&الأسطر[0], &الترويسة)) { أرجع خطأ; };
    ليكن المسافة: نص = "\t";
    ليكن وجد_الناتج: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        ليكن الأجزاء: متجه نص = قسم_النص(&الأسطر[ف], &المسافة);
        إذا ((الطول(الأجزاء) مثل طبيعي) == 3) {
            ليكن النوع: نص = انسخ_نص(&الأجزاء[0]);
            ليكن المسار: نص = انسخ_نص(&الأجزاء[1]);
            ليكن المتوقع: نص = انسخ_نص(&الأجزاء[2]);
            ليكن مصدر_ن: نص = «source»;
            ليكن مولد_ن: نص = «derived»;
            ليكن دليل_ن: نص = «dir»;
            ليكن ملف_ن: نص = «file»;
            ليكن ناتج_ن: نص = «output»;
            إذا (نصان_متساويان(&النوع, &مصدر_ن) || نصان_متساويان(&النوع, &ملف_ن)) {
                ليكن الفعلي: نص = بصمة_ملف_أو_غياب(&المسار);
                إذا (!نصان_متساويان(&الفعلي, &المتوقع)) { أرجع خطأ; };
            } وإلا إذا (نصان_متساويان(&النوع, &دليل_ن)) {
                ليكن الفعلي: نص = بصمة_دليل_خزن(&المسار);
                إذا (!نصان_متساويان(&الفعلي, &المتوقع)) { أرجع خطأ; };
            } وإلا إذا (نصان_متساويان(&النوع, &ناتج_ن)) {
                *البصمة := المتوقع;
                طابق حلل_عدد(&المسار) مع
                | نتيجة.نجح(القيمة) -> { *الوضع := القيمة مثل طبيعي; }
                | نتيجة.خطأ(_) -> { أرجع خطأ; };
                وجد_الناتج := صواب;
            } وإلا إذا (!نصان_متساويان(&النوع, &مولد_ن)) {
                أرجع خطأ;
            };
        } وإلا إذا ((الطول(الأسطر[ف]) مثل طبيعي) > 0) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع وجد_الناتج;
}

// A hit: the output of a stored compilation whose manifest still holds is
// written to الإخراج (through a temporary beside it and a rename), with the
// mode it had.
عام عرف استرجع_تجميعا(الخزن: &خزن_تجميع, المفتاح: &نص, الإخراج: &نص): منطقي {
    ليكن الدليل: نص = دليل_بيانات_المفتاح(الخزن, المفتاح);
    ليكن البيانات: متجه نص = أسماء_دليل_خزن(&الدليل);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البيانات) مثل طبيعي)) {
        ليكن المسار: نص = صل_خزن(&[انسخ_نص(&الدليل), «/», انسخ_نص(&البيانات[ف])]);
        طابق اقرأ_الملف(&المسار) مع
        | نتيجة.نجح(النص) -> {
            ليكن البصمة: متغير نص = «»;
            ليكن الوضع: متغير طبيعي = 0;
            إذا (بيان_صالح(&النص, &متغير البصمة, &متغير الوضع)) {
                ليكن الكائن: نص = مسار_كائن_خزن(الخزن, &البصمة);
                طابق اقرأ_بايتات_ملف(&الكائن) مع
                | نتيجة.نجح(البايتات) -> {
                    إذا (نصان_متساويان(&بصمة_محتوى(&البايتات), &البصمة)) {
                        ليكن المؤقت: نص = صل_خزن(&[انسخ_نص(الإخراج), «.sultanc-cache»]);
                        طابق اكتب_البايتات(&المؤقت, &البايتات) مع
                        | نتيجة.نجح(_) -> {
                            طابق اضبط_أذونات(&المؤقت, الوضع) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
                            طابق أعد_تسمية(&المؤقت, الإخراج) مع
                            | نتيجة.نجح(_) -> { أرجع صواب; }
                            | نتيجة.خطأ(_) -> {
                                طابق أزل_ملفا(&المؤقت) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
                            };
                        }
                        | نتيجة.خطأ(_) -> { };
                    };
                }
                | نتيجة.خطأ(_) -> { };
            };
        }
        | نتيجة.خطأ(_) -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The directories a manifest lists: every directory a source comes from and
// its ancestors (at most 8 levels), each once.
عرف أدلة_المصادر(المصادر: &متجه مصدر_مستعمل): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المصادر) مثل طبيعي)) {
        ليكن الدليل: متغير نص = دليل_مسار_خزن(&(*المصادر)[ف].الاسم);
        ليكن المستوى: متغير طبيعي = 0;
        طالما ((الطول(الدليل) مثل طبيعي) > 0 && المستوى < 8) {
            ليكن موجود_قبلا: متغير منطقي = خطأ;
            ليكن ك: متغير طبيعي = 0;
            طالما (ك < (الطول(الناتج) مثل طبيعي)) {
                إذا (نصان_متساويان(&الناتج[ك], &الدليل)) { موجود_قبلا := صواب; };
                ك := ك + 1;
            }
            إذا (!موجود_قبلا) { ألحق(الناتج, انسخ_نص(&الدليل)); };
            الدليل := دليل_مسار_خزن(&الدليل);
            المستوى := المستوى + 1;
        }
        ف := ف + 1;
    }
    رتب_نصوص(&متغير الناتج);
    أرجع الناتج;
}

// A store, after a compilation that wrote الإخراج without warnings: the
// output bytes under objects/ and the manifest of what it read under the
// request key. False, and nothing stored, when the compilation is unfit to
// store (see above) or a source's text is not its file's.
عام عرف خزن_تجميعا(الخزن: &خزن_تجميع, المفتاح: &نص, الإخراج: &نص): منطقي {
    ليكن لا_يخزن: متغير منطقي = خطأ;
    ليكن المصادر: متغير متجه مصدر_مستعمل = [];
    غير_آمن {
        لا_يخزن := تجميع_لا_يخزن;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(مصادر_التجميع) مثل طبيعي)) {
            ليكن النسخة: مصدر_مستعمل = {
                الاسم: انسخ_نص(&مصادر_التجميع[ف].الاسم), البصمة: انسخ_نص(&مصادر_التجميع[ف].البصمة)
            };
            ألحق(المصادر, النسخة);
            ف := ف + 1;
        }
    }
    إذا (لا_يخزن || (الطول(المصادر) مثل طبيعي) == 0) { أرجع خطأ; };
    ليكن البايتات: متجه ط8;
    طابق اقرأ_بايتات_ملف(الإخراج) مع
    | نتيجة.نجح(ب) -> { البايتات := ب; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
    ليكن الوضع: متغير طبيعي = 420;
    طابق اقرأ_أذونات(الإخراج) مع
    | نتيجة.نجح(و) -> { الوضع := و; }
    | نتيجة.خطأ(_) -> { };
    ليكن بصمة_الناتج: نص = بصمة_محتوى(&البايتات);
    ليكن الأسطر: متغير متجه نص = ["sultanc-cache 1\n"];
    ليكن مولد: نص = «process/failure_text.sn»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصادر) مثل طبيعي)) {
        ليكن على_القرص: نص = بصمة_ملف_أو_غياب(&المصادر[ف].الاسم);
        إذا (نصان_متساويان(&على_القرص, &المصادر[ف].البصمة)) {
            ألحق(الأسطر, صل_خزن(&["source\t", انسخ_نص(&المصادر[ف].الاسم), "\t", انسخ_نص(&المصادر[ف].البصمة), "\n"]));
        } وإلا إذا (ينتهي_بـ(&المصادر[ف].الاسم, &مولد)) {
            ألحق(الأسطر, صل_خزن(&["derived\t", انسخ_نص(&المصادر[ف].الاسم), "\t", انسخ_نص(&المصادر[ف].البصمة), "\n"]));
        } وإلا {
            // Read from somewhere other than its file: not stored.
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    ليكن الأدلة: متجه نص = أدلة_المصادر(&المصادر);
    ف := 0;
    طالما (ف < (الطول(الأدلة) مثل طبيعي)) {
        ألحق(الأسطر, صل_خزن(&["dir\t", انسخ_نص(&الأدلة[ف]), "\t", بصمة_دليل_خزن(&الأدلة[ف]), "\n"]));
        ليكن الجذر: نص = صل_خزن(&[انسخ_نص(&الأدلة[ف]), «/», آخر_جزء_خزن(&الأدلة[ف]), «.sn»]);
        ألحق(الأسطر, صل_خزن(&["file\t", انسخ_نص(&الجذر), "\t", بصمة_ملف_أو_غياب(&الجذر), "\n"]));
        ليكن الحزمة: نص = صل_خزن(&[انسخ_نص(&الأدلة[ف]), «/Supax.toml»]);
        ألحق(الأسطر, صل_خزن(&["file\t", انسخ_نص(&الحزمة), "\t", بصمة_ملف_أو_غياب(&الحزمة), "\n"]));
        ف := ف + 1;
    }
    ألحق(الأسطر, صل_خزن(&["output\t", طبيعي_إلى_نص(الوضع), "\t", انسخ_نص(&بصمة_الناتج), "\n"]));
    ليكن البيان: نص = صل_خزن(&الأسطر);

    ليكن دليل_الكائن: نص = صل_خزن(&[انسخ_نص(&(*الخزن).الدليل), «/objects/», أول_محرفين(&بصمة_الناتج)]);
    ليكن الكائن: نص = مسار_كائن_خزن(الخزن, &بصمة_الناتج);
    إذا (!يوجد_خزن(&الكائن)) {
        إذا (!أنشئ_مسار_خزن(&دليل_الكائن)) { أرجع خطأ; };
        إذا (!اكتب_بالتبديل(الخزن, &الكائن, &البايتات)) { أرجع خطأ; };
    };
    ليكن دليل_البيان: نص = دليل_بيانات_المفتاح(الخزن, المفتاح);
    إذا (!أنشئ_مسار_خزن(&دليل_البيان)) { أرجع خطأ; };
    ليكن بصمة_البيان: نص = بصمة_نص_خزن(&البيان);
    ليكن مسار_البيان: نص = صل_خزن(&[انسخ_نص(&دليل_البيان), «/», بصمة_البيان]);
    ليكن بايتات_البيان: متجه ط8 = بايتات_من_نص(البيان);
    إذا (!اكتب_بالتبديل(الخزن, &مسار_البيان, &بايتات_البيان)) { أرجع خطأ; };
    قلص_الخزن(الخزن);
    أرجع صواب;
}

// --- size ------------------------------------------------------------------------

نوع ملف_خزن = { المسار: نص, الحجم: طبيعي, الوقت: عدد };

عرف اجمع_ملفات_خزن(الدليل: &نص, الناتج: &متغير متجه ملف_خزن): فراغ {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            ليكن المسار: نص = صل_خزن(&[انسخ_نص(الدليل), «/», انسخ_نص(&المداخل[ف].الاسم)]);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { اجمع_ملفات_خزن(&المسار, الناتج); }
            | نوع_مدخل_دليل.ملف -> {
                ليكن الحجم: متغير طبيعي = 0;
                طابق حجم_المسار(&المسار) مع | نتيجة.نجح(ح) -> { الحجم := ح مثل طبيعي; } | نتيجة.خطأ(_) -> { };
                ليكن الوقت: متغير عدد = 0;
                طابق وقت_تعديل_المسار_نانو(&المسار) مع | نتيجة.نجح(و) -> { الوقت := و; } | نتيجة.خطأ(_) -> { };
                ليكن الملف: ملف_خزن = { المسار: المسار, الحجم: الحجم, الوقت: الوقت };
                ألحق(*الناتج, الملف);
            }
            | _ -> { };
            ف := ف + 1;
        }
    };
}

// At most once an hour (the time of the file last-trim): when objects/,
// manifests/ and identities/ hold more than the limit, the oldest files go
// until they hold less than 80% of it. Concurrent compilers may trim at the
// same time; a removed file is a miss for a reader, never a wrong output.
عرف قلص_الخزن(الخزن: &خزن_تجميع): فراغ {
    ليكن الختم: نص = صل_خزن(&[انسخ_نص(&(*الخزن).الدليل), «/last-trim»]);
    ليكن الآن: عدد;
    // The cache's own clock: the modification time of a file written now.
    ليكن المؤقت: نص = مسار_مؤقت_خزن(الخزن);
    ليكن فارغ: نص = «»;
    طابق اكتب_الملف(&المؤقت, &فارغ) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع; };
    طابق وقت_تعديل_المسار_نانو(&المؤقت) مع
    | نتيجة.نجح(و) -> { الآن := و; }
    | نتيجة.خطأ(_) -> {
        طابق أزل_ملفا(&المؤقت) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        أرجع;
    };
    ليكن الساعة: عدد = 3600 * 1000000000;
    طابق وقت_تعديل_المسار_نانو(&الختم) مع
    | نتيجة.نجح(السابق) -> {
        إذا (الآن - السابق < الساعة) {
            طابق أزل_ملفا(&المؤقت) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
            أرجع;
        };
    }
    | نتيجة.خطأ(_) -> { };
    طابق أعد_تسمية(&المؤقت, &الختم) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    ليكن الملفات: متغير متجه ملف_خزن = [];
    ليكن الأقسام: متجه نص = [«objects», «manifests», «identities»];
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < (الطول(الأقسام) مثل طبيعي)) {
        ليكن الدليل: نص = صل_خزن(&[انسخ_نص(&(*الخزن).الدليل), «/», انسخ_نص(&الأقسام[ق])]);
        اجمع_ملفات_خزن(&الدليل, &متغير الملفات);
        ق := ق + 1;
    }
    ليكن الكلي: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) { الكلي := الكلي + الملفات[ف].الحجم; ف := ف + 1; }
    إذا (الكلي <= (*الخزن).الحد) { أرجع; };
    ليكن الهدف: طبيعي = ((*الخزن).الحد / 10) * 8;
    // Oldest first.
    رتب_بالمقارنة(&متغير الملفات, قارن_ملفي_خزن);
    ف := 0;
    طالما (الكلي > الهدف && ف < (الطول(الملفات) مثل طبيعي)) {
        طابق أزل_ملفا(&الملفات[ف].المسار) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        إذا (الملفات[ف].الحجم <= الكلي) { الكلي := الكلي - الملفات[ف].الحجم; } وإلا { الكلي := 0; };
        ف := ف + 1;
    }
}

// Older first; then by path, so the order is the same everywhere.
عرف قارن_ملفي_خزن(أ: &ملف_خزن, ب: &ملف_خزن): عدد {
    إذا ((*أ).الوقت < (*ب).الوقت) { أرجع -1; };
    إذا ((*أ).الوقت > (*ب).الوقت) { أرجع 1; };
    أرجع قارن_نصين_معجميا(&(*أ).المسار, &(*ب).المسار);
}
