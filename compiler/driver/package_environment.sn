استورد std.text.from_bytes;
استورد compiler.driver.package_manifest;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_metadata;
استورد std.fs.path;
استورد std.text.compare;
استورد compiler.ispeak.keys.surface;

// Driver-only package graph preparation. It translates validated package
// metadata into the existing logical environment; source membership remains
// demand-discovered by Frontend.
عام نوع خطأ_إعداد_حزم = {
    المسار: نص,
    الإزاحة: طبيعي,
    السبب: مفتاح_نص_مترجم
};

عام نوع نتيجة_إعداد_حزم =
    | جاهز
    | خطأ بنوع خطأ_إعداد_حزم
;

نوع سجل_حزم_إعداد = {
    مسارات_البيانات: متجه نص,
    الجذور: متجه معرف_جذر_مكتبة,
    نشطة: متجه منطقي,
    مكتملة: متجه منطقي
};

عرف سجل_حزم_إعداد_جديد(): سجل_حزم_إعداد {
    دع المسارات: متجه نص = [];
    دع الجذور: متجه معرف_جذر_مكتبة = [];
    دع نشطة: متجه منطقي = [];
    دع مكتملة: متجه منطقي = [];
    دع السجل: سجل_حزم_إعداد = {
        مسارات_البيانات: المسارات,
        الجذور: الجذور,
        نشطة: نشطة,
        مكتملة: مكتملة
    };
    أرجع السجل;
}

عرف خطأ_إعداد_حزم_من_بيان(الخطأ: &خطأ_بيان_حزمة): خطأ_إعداد_حزم {
    دع مرجع_المسار: &نص = &(*الخطأ).المسار;
    دع المسار: نص = انسخ_نص(مرجع_المسار);
    دع السبب: مفتاح_نص_مترجم = (*الخطأ).السبب;
    دع الناتج: خطأ_إعداد_حزم = {
        المسار: المسار,
        الإزاحة: (*الخطأ).الإزاحة,
        السبب: السبب
    };
    أرجع الناتج;
}

عرف خطأ_إعداد_حزم_بسبب(المسار: &نص, السبب: مفتاح_نص_مترجم): خطأ_إعداد_حزم {
    دع الناتج: خطأ_إعداد_حزم = { المسار: انسخ_نص(المسار), الإزاحة: 0, السبب: السبب };
    أرجع الناتج;
}

عرف انسخ_اختيار_نص_إعداد(القيمة: &اختياري نص): اختياري نص {
    طابق *القيمة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); };
}

عرف موضع_حزمة_مسجلة(السجل: &سجل_حزم_إعداد, مسار_البيان: &نص): اختياري طبيعي {
    دع المطلوب: نص = طبع_المسار(مسار_البيان);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السجل).مسارات_البيانات) مثل طبيعي)) {
        دع الحالي: نص = طبع_المسار(&(*السجل).مسارات_البيانات[ف]);
        لو (نصان_متساويان(&الحالي, &المطلوب)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_حزمة_إلى_السجل(
    السجل: &متغير سجل_حزم_إعداد,
    مسار_البيان: &نص,
    الجذر: معرف_جذر_مكتبة
): طبيعي {
    دع الموضع: طبيعي = الطول((*السجل).مسارات_البيانات) مثل طبيعي;
    دع المسار: نص = طبع_المسار(مسار_البيان);
    ألحق((*السجل).مسارات_البيانات, المسار);
    ألحق((*السجل).الجذور, الجذر);
    ألحق((*السجل).نشطة, صواب);
    ألحق((*السجل).مكتملة, خطأ);
    أرجع الموضع;
}

عرف سجل_تهجئة_جذر_حزمة_واحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    الجذر_الهدف: معرف_جذر_مكتبة,
    الإعداد: &إعداد_بيان_حزمة,
    التهجئة: &نص
): منطقي {
    لو (!سجل_تهجئة_جذر_معلنة(
        البيئة, الجذر_المرئي, الجذر_الهدف, التهجئة, صواب
    )) { أرجع خطأ; };

    // A file-valued [lib].path is the package's explicit root entry. Bind each
    // declared root spelling to that existing module key; directory libraries
    // intentionally have no synthetic root module.
    طابق (*الإعداد).مدخل_المكتبة مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(اسم_المدخل) -> {
        دع بايتات_المدخل: متجه ط8 = بايتات_نص_بيانات_وحدة(&اسم_المدخل);
        دع المسار: مسار_وحدة_منطقي;
        طابق قنن_مسار_وحدة_منطقي(&بايتات_المدخل) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; }
        | نتيجة_مسار_وحدة_منطقي.صالح(القيمة) -> { المسار := القيمة; };
        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            الجذر_الهدف, المسار
        );
        دع المسار_العام: متجه ط8 = بايتات_نص_بيانات_وحدة(التهجئة);
        طابق أضف_مسارا_عاما_لوحدة(
            البيئة, الجذر_المرئي, المسار_العام, &المفتاح
        ) مع
        | نتيجة_ربط_مسار_عام.أضيف -> { أرجع صواب; }
        | نتيجة_ربط_مسار_عام.موجود -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف سجل_تهجئات_جذر_الحزمة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    الجذر_الهدف: معرف_جذر_مكتبة,
    الإعداد: &إعداد_بيان_حزمة,
    اسم_اعتماد: نص
): منطقي {
    لو ((الطول(اسم_اعتماد) مثل طبيعي) > 0) {
        لو (!سجل_تهجئة_جذر_حزمة_واحدة(
            البيئة, الجذر_المرئي, الجذر_الهدف, الإعداد, &اسم_اعتماد
        )) { أرجع خطأ; };
    };
    لو (!سجل_تهجئة_جذر_حزمة_واحدة(
        البيئة, الجذر_المرئي, الجذر_الهدف, الإعداد, &(*الإعداد).الاسم
    )) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الإعداد).الأسماء) مثل طبيعي)) {
        لو (!سجل_تهجئة_جذر_حزمة_واحدة(
            البيئة,
            الجذر_المرئي,
            الجذر_الهدف,
            الإعداد,
            &(*الإعداد).الأسماء[ف].التهجئة
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سجل_روابط_استيراد_الحزمة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر: معرف_جذر_مكتبة,
    الإعداد: &إعداد_بيان_حزمة
): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الإعداد).روابط_الاستيراد) مثل طبيعي)) {
        دع الربط: &ربط_استيراد_حزمة = &(*الإعداد).روابط_الاستيراد[ف];
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول((*الربط).التهجئات) مثل طبيعي)) {
            لو (!سجل_تهجئة_حزمة_معلنة(
                البيئة,
                الجذر,
                &(*الربط).المسار_المقنن,
                &(*الربط).التهجئات[ح].المسار
            )) { أرجع خطأ; };
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سجل_جذر_حزمة_جديد(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الإعداد: &إعداد_بيان_حزمة,
    يتطلب_مكتبة: منطقي
): نتيجة معرف_جذر_مكتبة, خطأ_إعداد_حزم {
    دع مسار_المصدر: نص;
    طابق (*الإعداد).مسار_المكتبة مع
    | اختياري.موجود(المسار) -> { مسار_المصدر := طبع_المسار(&المسار); }
    | اختياري.لا_شيء -> {
        لو (يتطلب_مكتبة) {
            أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
                &(*الإعداد).مسار_البيان,
                مفتاح_نص_مترجم.اعتماد_مسار_بلا_هدف_مكتبة()
            ));
        };
        مسار_المصدر := طبع_المسار(&(*الإعداد).دليل_البيان);
    };

    دع الجذر: معرف_جذر_مكتبة = خصص_جذر_مكتبة(البيئة);
    طابق أضف_جذر_مصدر(البيئة, الجذر, &مسار_المصدر) مع
    | نتيجة_تسجيل_جذر_مصدر.أضيف -> { }
    | نتيجة_تسجيل_جذر_مصدر.موجود -> { }
    | _ -> {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            &(*الإعداد).مسار_البيان, مفتاح_نص_مترجم.تعارض_جذر_مصدر_الحزمة()
        ));
    };
    لو (!سجل_تهجئات_جذر_الحزمة(
        البيئة, الجذر, الجذر, الإعداد, «»
    )) {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            &(*الإعداد).مسار_البيان, مفتاح_نص_مترجم.تعارض_تهجئة_جذر_الحزمة()
        ));
    };
    لو (!سجل_روابط_استيراد_الحزمة(البيئة, الجذر, الإعداد)) {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            &(*الإعداد).مسار_البيان, مفتاح_نص_مترجم.تعارض_مرادف_استيراد_الحزمة()
        ));
    };
    أرجع نتيجة.نجح(الجذر);
}

عرف مسار_بيان_اعتماد(المسار: &نص): نص {
    دع الاسم: نص = «Supax.toml»;
    أرجع صل_المسار(المسار, &الاسم);
}

عرف سجل_حزمة_اعتماد(
    البيئة: &متغير بيئة_وحدات_منطقية,
    السجل: &متغير سجل_حزم_إعداد,
    مسار_البيان: &نص,
    جذر_المستورد: معرف_جذر_مكتبة,
    اسم_الاعتماد: &نص,
    جذر_المكتبة_القياسية: معرف_جذر_مكتبة,
    إعداد_المكتبة_القياسية: &إعداد_بيان_حزمة
): نتيجة معرف_جذر_مكتبة, خطأ_إعداد_حزم {
    طابق موضع_حزمة_مسجلة(السجل, مسار_البيان) مع
    | اختياري.موجود(الموضع) -> {
        لو ((*السجل).نشطة[الموضع]) {
            أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
                مسار_البيان, مفتاح_نص_مترجم.دورة_اعتماديات_الحزمة()
            ));
        };
        دع الجذر: معرف_جذر_مكتبة = (*السجل).الجذور[الموضع];
        دع الإعداد: إعداد_بيان_حزمة;
        طابق اقرأ_بيان_حزمة(مسار_البيان) مع
        | نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_إعداد_حزم_من_بيان(&الخطأ));
        }
        | نتيجة_قراءة_بيان_حزمة.جاهز(القيمة) -> { الإعداد := القيمة; };
        لو (!سجل_تهجئات_جذر_الحزمة(
            البيئة, جذر_المستورد, الجذر, &الإعداد, انسخ_نص(اسم_الاعتماد)
        )) {
            أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
                مسار_البيان, مفتاح_نص_مترجم.التباس_جذر_الاعتمادية()
            ));
        };
        أرجع نتيجة.نجح(الجذر);
    }
    | اختياري.لا_شيء -> { };

    دع الإعداد: إعداد_بيان_حزمة;
    طابق اقرأ_بيان_حزمة(مسار_البيان) مع
    | نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_من_بيان(&الخطأ));
    }
    | نتيجة_قراءة_بيان_حزمة.جاهز(القيمة) -> { الإعداد := القيمة; };

    دع الجذر: معرف_جذر_مكتبة;
    طابق سجل_جذر_حزمة_جديد(البيئة, &الإعداد, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الجذر := القيمة; };
    دع الموضع: طبيعي = أضف_حزمة_إلى_السجل(
        السجل, مسار_البيان, الجذر
    );

    لو (!سجل_تهجئات_جذر_الحزمة(
        البيئة, جذر_المستورد, الجذر, &الإعداد, انسخ_نص(اسم_الاعتماد)
    )) {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_البيان, مفتاح_نص_مترجم.التباس_جذر_الاعتمادية()
        ));
    };
    لو (!سجل_تهجئات_جذر_الحزمة(
        البيئة,
        الجذر,
        جذر_المكتبة_القياسية,
        إعداد_المكتبة_القياسية,
        «»
    )) {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_البيان, مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_الاعتمادية()
        ));
    };

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الإعداد.الاعتمادات) مثل طبيعي)) {
        دع الاعتماد: &اعتماد_مسار_حزمة = &الإعداد.الاعتمادات[ف];
        دع بيان_الاعتماد: نص = مسار_بيان_اعتماد(&(*الاعتماد).المسار);
        طابق سجل_حزمة_اعتماد(
            البيئة,
            السجل,
            &بيان_الاعتماد,
            الجذر,
            &(*الاعتماد).الاسم,
            جذر_المكتبة_القياسية,
            إعداد_المكتبة_القياسية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    (*السجل).نشطة[الموضع] := خطأ;
    (*السجل).مكتملة[الموضع] := صواب;
    أرجع نتيجة.نجح(الجذر);
}

عرف سجل_المكتبة_القياسية(
    البيئة: &متغير بيئة_وحدات_منطقية,
    السجل: &متغير سجل_حزم_إعداد,
    مسار_بيان_المكتبة_القياسية: &نص
): نتيجة إعداد_بيان_حزمة, خطأ_إعداد_حزم {
    دع الإعداد: إعداد_بيان_حزمة;
    طابق اقرأ_بيان_حزمة(مسار_بيان_المكتبة_القياسية) مع
    | نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_من_بيان(&الخطأ));
    }
    | نتيجة_قراءة_بيان_حزمة.جاهز(القيمة) -> { الإعداد := القيمة; };
    دع مسار_المكتبة: اختياري نص = انسخ_اختيار_نص_إعداد(&الإعداد.مسار_المكتبة);
    طابق مسار_المكتبة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.بيان_المكتبة_بلا_جدول_مكتبة()
        ));
    }
    | اختياري.موجود(_) -> { };
    دع الجذر: معرف_جذر_مكتبة;
    طابق سجل_جذر_حزمة_جديد(البيئة, &الإعداد, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الجذر := القيمة; };
    // The root just returned by canonical package registration, not the
    // manifest's name or an importing package alias, is the trusted STD root.
    لو (!عيّن_جذر_قياسي_موثوق(البيئة, الجذر)) {
        أرجع نتيجة.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.تعارض_جذر_مكتبة_موثوق()
        ));
    };
    دع الموضع: طبيعي = أضف_حزمة_إلى_السجل(
        السجل, مسار_بيان_المكتبة_القياسية, الجذر
    );
    (*السجل).نشطة[الموضع] := خطأ;
    (*السجل).مكتملة[الموضع] := صواب;
    أرجع نتيجة.نجح(الإعداد);
}

عام عرف جهز_بيئة_حزم_بلا_بيان_مشروع(
    البيئة: &متغير بيئة_وحدات_منطقية,
    جذر_المشروع: معرف_جذر_مكتبة,
    مسار_بيان_المكتبة_القياسية: &نص
): نتيجة_إعداد_حزم {
    دع السجل: متغير سجل_حزم_إعداد = سجل_حزم_إعداد_جديد();
    دع إعداد_المكتبة: إعداد_بيان_حزمة;
    طابق سجل_المكتبة_القياسية(
        البيئة, &متغير السجل, مسار_بيان_المكتبة_القياسية
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_حزم.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { إعداد_المكتبة := القيمة; };

    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق موضع_حزمة_مسجلة(&السجل, مسار_بيان_المكتبة_القياسية) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.جذر_المكتبة_غير_مسجل()
        ));
    }
    | اختياري.موجود(الموضع) -> { جذر_المكتبة := السجل.الجذور[الموضع]; };

    لو (!سجل_تهجئات_جذر_الحزمة(
        البيئة, جذر_المشروع, جذر_المكتبة, &إعداد_المكتبة, «»
    )) {
        أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
            مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_المشروع()
        ));
    };
    أرجع نتيجة_إعداد_حزم.جاهز();
}

عام عرف جهز_بيئة_حزم_لبيان_مشروع(
    البيئة: &متغير بيئة_وحدات_منطقية,
    جذر_المشروع: معرف_جذر_مكتبة,
    إعداد_المشروع: &إعداد_بيان_حزمة,
    مسار_بيان_المكتبة_القياسية: &نص
): نتيجة_إعداد_حزم {
    لو (!سجل_تهجئات_جذر_الحزمة(
        البيئة, جذر_المشروع, جذر_المشروع, إعداد_المشروع, «»
    )) {
        أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
            &(*إعداد_المشروع).مسار_البيان, مفتاح_نص_مترجم.تعارض_جذر_الحزمة_مع_نفسه()
        ));
    };
    لو (!سجل_روابط_استيراد_الحزمة(البيئة, جذر_المشروع, إعداد_المشروع)) {
        أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
            &(*إعداد_المشروع).مسار_البيان, مفتاح_نص_مترجم.تعارض_مرادف_استيراد_الحزمة()
        ));
    };

    دع السجل: متغير سجل_حزم_إعداد = سجل_حزم_إعداد_جديد();
    دع مسار_المشروع: نص = طبع_المسار(&(*إعداد_المشروع).مسار_البيان);
    دع موضع_المشروع: طبيعي = أضف_حزمة_إلى_السجل(
        &متغير السجل, &مسار_المشروع, جذر_المشروع
    );

    دع مسار_المكتبة: نص = طبع_المسار(مسار_بيان_المكتبة_القياسية);
    دع المشروع_هو_المكتبة: منطقي = نصان_متساويان(&مسار_المشروع, &مسار_المكتبة);
    دع إعداد_المكتبة: إعداد_بيان_حزمة;
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    لو (المشروع_هو_المكتبة) {
        إعداد_المكتبة := *إعداد_المشروع;
        جذر_المكتبة := جذر_المشروع;
        لو (!عيّن_جذر_قياسي_موثوق(البيئة, جذر_المكتبة)) {
            أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
                مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.تعارض_جذر_مكتبة_موثوق()
            ));
        };
    } وإلا {
        طابق سجل_المكتبة_القياسية(
            البيئة, &متغير السجل, مسار_بيان_المكتبة_القياسية
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_حزم.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { إعداد_المكتبة := القيمة; };
        طابق موضع_حزمة_مسجلة(&السجل, مسار_بيان_المكتبة_القياسية) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
                مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.جذر_المكتبة_غير_مسجل()
            ));
        }
        | اختياري.موجود(الموضع) -> { جذر_المكتبة := السجل.الجذور[الموضع]; };
        لو (!سجل_تهجئات_جذر_الحزمة(
            البيئة, جذر_المشروع, جذر_المكتبة, &إعداد_المكتبة, «»
        )) {
            أرجع نتيجة_إعداد_حزم.خطأ(خطأ_إعداد_حزم_بسبب(
                مسار_بيان_المكتبة_القياسية, مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_المشروع()
            ));
        };
    };

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*إعداد_المشروع).الاعتمادات) مثل طبيعي)) {
        دع الاعتماد: &اعتماد_مسار_حزمة = &(*إعداد_المشروع).الاعتمادات[ف];
        دع بيان_الاعتماد: نص = مسار_بيان_اعتماد(&(*الاعتماد).المسار);
        طابق سجل_حزمة_اعتماد(
            البيئة,
            &متغير السجل,
            &بيان_الاعتماد,
            جذر_المشروع,
            &(*الاعتماد).الاسم,
            جذر_المكتبة,
            &إعداد_المكتبة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_حزم.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    السجل.نشطة[موضع_المشروع] := خطأ;
    السجل.مكتملة[موضع_المشروع] := صواب;
    أرجع نتيجة_إعداد_حزم.جاهز();
}

