استورد std.text.from_bytes;
استورد compiler.driver.package_graph;
استورد compiler.frontend.module_loading.library_root_identity;
استورد compiler.frontend.module_loading.module_paths;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.module_loading.module_metadata;
استورد compiler.diagnostics.record;
استورد compiler.ispeak.keys.surface;

// Driver-only package setup: the packages a package graph states
// (package_graph.sn) become roots of the logical environment. Nothing is
// discovered or walked: every package gets a root with its source root, its
// name and its root spellings; every package sees the standard library;
// every edge makes its target visible inside its source under the target's
// spellings and the edge's own name. Source membership stays
// demand-discovered by Frontend, and so do the spellings of the modules in a
// package: its root file <source root>/<name>.sn declares them with `module`
// (module_spellings.sn).

عام نوع نتيجة_إعداد_حزم =
    | جاهز
    | خطأ بنوع خطأ_رسم_حزم
;

// The package that owns the compilation's direct sources.
عام نوع حزمة_جذر_معدة = {
    الجذر: معرف_جذر_مكتبة,
    جذر_المصدر: نص
};

عام نوع نتيجة_إعداد_رسم =
    | جاهز بنوع حزمة_جذر_معدة
    | خطأ بنوع خطأ_رسم_حزم
;

عرف خطأ_حزمة_رسم(
    مسار_الرسم: &نص,
    النطاق: &اختياري نطاق_مصدر_تشخيص,
    السبب: مفتاح_نص_مترجم
): خطأ_رسم_حزم {
    أرجع خطأ_رسم_في(مسار_الرسم, النطاق, السبب);
}

عرف سجل_تهجئة_جذر_حزمة_واحدة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    الجذر_الهدف: معرف_جذر_مكتبة,
    الحزمة: &حزمة_رسم,
    التهجئة: &نص
): منطقي {
    إذا (!سجل_تهجئة_جذر_معلنة(
        البيئة, الجذر_المرئي, الجذر_الهدف, التهجئة, صواب
    )) { أرجع خطأ; };

    // A package's entry is its root module: each root spelling names that
    // module. A package without one has no synthetic root module.
    طابق (*الحزمة).المدخل مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(اسم_المدخل) -> {
        دع بايتات_المدخل: متجه ط8 = بايتات_نص_بيانات_وحدة(&اسم_المدخل);
        دع المسار: مسار_وحدة_منطقي;
        طابق قنن_مسار_وحدة_منطقي(&بايتات_المدخل) مع
        | نتيجة_مسار_وحدة_منطقي.غير_صالح -> { أرجع خطأ; }
        | نتيجة_مسار_وحدة_منطقي.صالح(القيمة) -> { المسار := القيمة; };
        دع المفتاح: مفتاح_وحدة_مقنن = مفتاح_وحدة_مقنن_من(
            الجذر_الهدف, المسار
        );
        دع المسار_العام: متجه ط8 = بايتات_نص_بيانات_وحدة(التهجئة);
        طابق أضف_مسارا_عاما_لوحدة(
            البيئة, الجذر_المرئي, المسار_العام, &المفتاح
        ) مع
        | نتيجة_ربط_مسار_عام.أضيف -> { أرجع صواب; }
        | نتيجة_ربط_مسار_عام.موجود -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// The spellings under which الجذر_المرئي sees the package: an edge's own
// name (when not «»), the package's name and every one of its spellings.
عرف سجل_تهجئات_جذر_الحزمة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الجذر_المرئي: معرف_جذر_مكتبة,
    الجذر_الهدف: معرف_جذر_مكتبة,
    الحزمة: &حزمة_رسم,
    اسم_محلي: نص
): منطقي {
    إذا ((الطول(اسم_محلي) مثل طبيعي) > 0) {
        إذا (!سجل_تهجئة_جذر_حزمة_واحدة(
            البيئة, الجذر_المرئي, الجذر_الهدف, الحزمة, &اسم_محلي
        )) { أرجع خطأ; };
    };
    إذا (!سجل_تهجئة_جذر_حزمة_واحدة(
        البيئة, الجذر_المرئي, الجذر_الهدف, الحزمة, &(*الحزمة).الاسم
    )) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحزمة).التهجئات) مثل طبيعي)) {
        إذا (!سجل_تهجئة_جذر_حزمة_واحدة(
            البيئة,
            الجذر_المرئي,
            الجذر_الهدف,
            الحزمة,
            &(*الحزمة).التهجئات[ف].التهجئة
        )) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A package's own root: its source root, its name (which names its root
// file) and its spellings inside itself (a package imports itself by name).
عرف سجل_جذر_حزمة(
    البيئة: &متغير بيئة_وحدات_منطقية,
    مسار_الرسم: &نص,
    الحزمة: &حزمة_رسم
): نتيجة معرف_جذر_مكتبة, خطأ_رسم_حزم {
    دع الجذر: معرف_جذر_مكتبة = خصص_جذر_مكتبة(البيئة);
    طابق أضف_جذر_مصدر(البيئة, الجذر, &(*الحزمة).جذر_المصدر) مع
    | نتيجة_تسجيل_جذر_مصدر.أضيف -> { }
    | نتيجة_تسجيل_جذر_مصدر.موجود -> { }
    | _ -> {
        أرجع نتيجة.خطأ(خطأ_حزمة_رسم(
            مسار_الرسم, &(*الحزمة).النطاق, مفتاح_نص_مترجم.تعارض_جذر_مصدر_الحزمة()
        ));
    };
    إذا (!سجل_تهجئات_جذر_الحزمة(البيئة, الجذر, الجذر, الحزمة, «»)) {
        أرجع نتيجة.خطأ(خطأ_حزمة_رسم(
            مسار_الرسم, &(*الحزمة).النطاق, مفتاح_نص_مترجم.تعارض_تهجئة_جذر_الحزمة()
        ));
    };
    إذا (!سجل_اسم_حزمة_معلن(البيئة, الجذر, &(*الحزمة).الاسم)) {
        أرجع نتيجة.خطأ(خطأ_حزمة_رسم(
            مسار_الرسم, &(*الحزمة).النطاق, مفتاح_نص_مترجم.تعارض_تهجئة_جذر_الحزمة()
        ));
    };
    أرجع نتيجة.نجح(الجذر);
}

// The standard library's one package, made the trusted std root. The trust
// comes from where the compiler found std (std_location.sn), never from a
// package's id or name.
عرف سجل_المكتبة_القياسية(
    البيئة: &متغير بيئة_وحدات_منطقية,
    رسم_المكتبة: &رسم_حزم
): نتيجة معرف_جذر_مكتبة, خطأ_رسم_حزم {
    دع الحزمة: &حزمة_رسم = &(*رسم_المكتبة).الحزم[0];
    دع الجذر: معرف_جذر_مكتبة = سجل_جذر_حزمة(البيئة, &(*رسم_المكتبة).المسار, الحزمة)؟;
    إذا (!عيّن_جذر_قياسي_موثوق(البيئة, الجذر)) {
        أرجع نتيجة.خطأ(خطأ_حزمة_رسم(
            &(*رسم_المكتبة).المسار, &(*الحزمة).النطاق, مفتاح_نص_مترجم.تعارض_جذر_مكتبة_موثوق()
        ));
    };
    أرجع نتيجة.نجح(الجذر);
}

// Without a package graph: the configured project root (source_inputs.sn)
// sees the standard library, and nothing else is registered.
عام عرف جهز_بيئة_حزم_بلا_رسم(
    البيئة: &متغير بيئة_وحدات_منطقية,
    جذر_المشروع: معرف_جذر_مكتبة,
    رسم_المكتبة: &رسم_حزم
): نتيجة_إعداد_حزم {
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق سجل_المكتبة_القياسية(البيئة, رسم_المكتبة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_حزم.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { جذر_المكتبة := القيمة; };
    إذا (!سجل_تهجئات_جذر_الحزمة(
        البيئة, جذر_المشروع, جذر_المكتبة, &(*رسم_المكتبة).الحزم[0], «»
    )) {
        أرجع نتيجة_إعداد_حزم.خطأ(خطأ_حزمة_رسم(
            &(*رسم_المكتبة).المسار, &(*رسم_المكتبة).الحزم[0].النطاق,
            مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_المشروع()
        ));
    };
    أرجع نتيجة_إعداد_حزم.جاهز();
}

// A direct source of the standard library itself (`sultanc check
// library/std/io/println.sn`): std is the root package.
عام عرف جهز_بيئة_المكتبة_مشروعا(
    البيئة: &متغير بيئة_وحدات_منطقية,
    رسم_المكتبة: &رسم_حزم
): نتيجة_إعداد_رسم {
    طابق سجل_المكتبة_القياسية(البيئة, رسم_المكتبة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_رسم.خطأ(الخطأ); }
    | نتيجة.نجح(الجذر) -> {
        دع مرجع_جذر_المصدر: &نص = &(*رسم_المكتبة).الحزم[0].جذر_المصدر;
        دع المعدة: حزمة_جذر_معدة = { الجذر: الجذر, جذر_المصدر: انسخ_نص(مرجع_جذر_المصدر) };
        أرجع نتيجة_إعداد_رسم.جاهز(المعدة);
    };
}

// A package graph (--package-graph): std, every package, std inside every
// package, then every edge. The result is the graph's root package.
عام عرف جهز_بيئة_حزم_لرسم(
    البيئة: &متغير بيئة_وحدات_منطقية,
    الرسم: &رسم_حزم,
    رسم_المكتبة: &رسم_حزم
): نتيجة_إعداد_رسم {
    دع جذر_المكتبة: معرف_جذر_مكتبة;
    طابق سجل_المكتبة_القياسية(البيئة, رسم_المكتبة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_رسم.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { جذر_المكتبة := القيمة; };
    دع حزمة_المكتبة: &حزمة_رسم = &(*رسم_المكتبة).الحزم[0];

    دع الجذور: متغير متجه معرف_جذر_مكتبة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الرسم).الحزم) مثل طبيعي)) {
        دع الحزمة: &حزمة_رسم = &(*الرسم).الحزم[ف];
        طابق سجل_جذر_حزمة(البيئة, &(*الرسم).المسار, الحزمة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_إعداد_رسم.خطأ(الخطأ); }
        | نتيجة.نجح(الجذر) -> { ألحق(الجذور, الجذر); };
        إذا (!سجل_تهجئات_جذر_الحزمة(البيئة, الجذور[ف], جذر_المكتبة, حزمة_المكتبة, «»)) {
            أرجع نتيجة_إعداد_رسم.خطأ(خطأ_حزمة_رسم(
                &(*الرسم).المسار, &(*الحزمة).النطاق, مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_الاعتمادية()
            ));
        };
        ف := ف + 1;
    }

    ف := 0;
    طالما (ف < (الطول((*الرسم).الحواف) مثل طبيعي)) {
        دع الحافة: &حافة_رسم = &(*الرسم).الحواف[ف];
        دع الهدف: &حزمة_رسم = &(*الرسم).الحزم[(*الحافة).المعتمدة];
        إذا (!سجل_تهجئات_جذر_الحزمة(
            البيئة, الجذور[(*الحافة).المستوردة], الجذور[(*الحافة).المعتمدة], الهدف, انسخ_نص(&(*الحافة).الاسم)
        )) {
            أرجع نتيجة_إعداد_رسم.خطأ(خطأ_حزمة_رسم(
                &(*الرسم).المسار, &(*الحافة).النطاق, مفتاح_نص_مترجم.التباس_جذر_الاعتمادية()
            ));
        };
        ف := ف + 1;
    }

    طابق (*الرسم).الجذر مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_إعداد_رسم.خطأ(خطأ_رسم_بلا_موقع(
            &(*الرسم).المسار, مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود()
        ));
    }
    | اختياري.موجود(الموضع) -> {
        دع مرجع_جذر_المصدر: &نص = &(*الرسم).الحزم[الموضع].جذر_المصدر;
        دع المعدة: حزمة_جذر_معدة = {
            الجذر: الجذور[الموضع], جذر_المصدر: انسخ_نص(مرجع_جذر_المصدر)
        };
        أرجع نتيجة_إعداد_رسم.جاهز(المعدة);
    };
}
