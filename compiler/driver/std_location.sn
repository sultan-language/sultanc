// Where the standard library is:
//
//   1. $SULTANC_STD, the library directory (the one holding std/). Set, it
//      is the answer even when it is wrong, so its error names it.
//   2. ./library, the checkout the compiler is run from: the stage builds and
//      the self-host check run there and keep their exact paths.
//   3. Next to the running compiler: <bin>/library, <bin>/../library (a
//      build/sultanc in a checkout) and <bin>/../lib/sultanc/library (an
//      install prefix: <prefix>/bin/sultanc).
//
// The marker is the layout itself: a candidate counts only if it holds a
// std/ folder, so a project's own library/ directory without one is passed
// over. No file describes std. The compiler knows it (the table below):
// canonical name std, Arabic spelling المكتبة, sources in <library>/std, root
// file std/std.sn; beside it the libraries beneath std, <library>/alloc
// (التخصيص, root file alloc.sn) and <library>/core (الأساس, core.sn), each a
// package of its own (docs/en/reference/std-layers.md). Spellings of the modules inside it
// are declared there with `module` (module_spellings.sn). Without any
// candidate, the answer is ./library, whose missing std/ the package setup
// then reports (SULTANC-STD-NOT-FOUND).
استورد المكتبة.بيئة.بيئة_العمل;
استورد المكتبة.بيئة.البرنامج_الحالي;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.مجلد;
استورد المكتبة.نصوص.من_بايتات;
استورد compiler.driver.package_graph;

// The one table of std's names: its canonical name, which is also its
// folder, and its spellings by language.
عام عرف اسم_المكتبة_القياسية(): نص { أرجع «std»; }

عرف تهجئات_المكتبة_القياسية(): متجه تهجئة_رسم_حزم {
    ليكن الناتج: متغير متجه تهجئة_رسم_حزم = [];
    ليكن العربية: تهجئة_رسم_حزم = { اللغة: «ar», التهجئة: «المكتبة» };
    ألحق(الناتج, العربية);
    أرجع الناتج;
}

عرف مجلد_المكتبة_في(الدليل: &نص): نص {
    ليكن الاسم: نص = اسم_المكتبة_القياسية();
    ليكن الموصول: نص = صل_المسار(الدليل, &الاسم);
    أرجع نظف_المسار(&الموصول);
}

عرف فيه_مجلد_المكتبة(الدليل: &نص): منطقي {
    ليكن المجلد: نص = مجلد_المكتبة_في(الدليل);
    طابق حاول_مسار_دليل(&المجلد) مع
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The library directory (the one holding std/).
عام عرف حدد_دليل_المكتبة_القياسية(): نص {
    ليكن اسم_المتغير: نص = «SULTANC_STD»;
    طابق متغير_بيئة(&اسم_المتغير) مع
    | نتيجة.نجح(اختياري.موجود(الدليل)) -> {
        إذا ((الطول(الدليل) مثل طبيعي) > 0) { أرجع الدليل; };
    }
    | _ -> { };

    ليكن المحلي: نص = «library»;
    إذا (فيه_مجلد_المكتبة(&المحلي)) { أرجع المحلي; };

    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(البرنامج) -> {
        طابق أب_المسار(&البرنامج) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(دليل_البرنامج) -> {
            ليكن المرشحات: متجه نص = [«library», «../library», «../lib/sultanc/library»];
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < (الطول(المرشحات) مثل طبيعي)) {
                ليكن المضموم: نص = صل_المسار(&دليل_البرنامج, &المرشحات[ف]);
                ليكن الدليل: نص = نظف_المسار(&المضموم);
                إذا (فيه_مجلد_المكتبة(&الدليل)) { أرجع الدليل; };
                ف := ف + 1;
            }
        };
    };
    أرجع المحلي;
}

// The standard library as a package graph (std, then the libraries beneath
// it that exist) and no root, for
// the package setup (package_environment.sn). Its المسار is the library
// directory, named by SULTANC-STD-NOT-FOUND when std/ is not in it.
عام عرف رسم_المكتبة_القياسية(): نتيجة رسم_حزم, خطأ_رسم_حزم {
    ليكن الدليل: نص = حدد_دليل_المكتبة_القياسية();
    ليكن المجلد: نص = مجلد_المكتبة_في(&الدليل);
    إذا (!فيه_مجلد_المكتبة(&الدليل)) {
        أرجع نتيجة.خطأ(خطأ_مكتبة_قياسية_مفقودة(&المجلد));
    };
    ليكن الحزمة: حزمة_رسم = {
        المعرف: اسم_المكتبة_القياسية(),
        جذر_المصدر: المجلد,
        الاسم: اسم_المكتبة_القياسية(),
        التهجئات: تهجئات_المكتبة_القياسية(),
        المدخل: اختياري.لا_شيء(),
        النطاق: اختياري.لا_شيء()
    };
    ليكن الحزم: متغير متجه حزمة_رسم = [];
    ألحق(الحزم, الحزمة);
    // The libraries beneath std, when the library directory has them (alloc
    // and core): alloc/ (التخصيص) and core/ (الأساس), in that order.
    // std sees both, alloc sees core, core sees nothing else
    // (package_environment.sn).
    ليكن السفلى: متجه نص = [«alloc», «core»];
    ليكن التهجئات_العربية: متجه نص = [«التخصيص», «الأساس»];
    ليكن س: متغير طبيعي = 0;
    طالما (س < 2) {
        ليكن الموصول: نص = صل_المسار(&الدليل, &السفلى[س]);
        ليكن مجلد_السفلى: نص = نظف_المسار(&الموصول);
        طابق حاول_مسار_دليل(&مجلد_السفلى) مع
        | نتيجة.نجح(صواب) -> {
            ليكن التهجئات: متغير متجه تهجئة_رسم_حزم = [];
            ليكن العربية: تهجئة_رسم_حزم = { اللغة: «ar», التهجئة: انسخ_نص(&التهجئات_العربية[س]) };
            ألحق(التهجئات, العربية);
            ليكن حزمة_السفلى: حزمة_رسم = {
                المعرف: انسخ_نص(&السفلى[س]),
                جذر_المصدر: مجلد_السفلى,
                الاسم: انسخ_نص(&السفلى[س]),
                التهجئات: التهجئات,
                المدخل: اختياري.لا_شيء(),
                النطاق: اختياري.لا_شيء()
            };
            ألحق(الحزم, حزمة_السفلى);
        }
        | _ -> { };
        س := س + 1;
    }
    ليكن الحواف: متجه حافة_رسم = [];
    ليكن الرسم: رسم_حزم = {
        المسار: الدليل,
        الجذر: اختياري.لا_شيء(),
        الحزم: الحزم,
        الحواف: الحواف
    };
    أرجع نتيجة.نجح(الرسم);
}
