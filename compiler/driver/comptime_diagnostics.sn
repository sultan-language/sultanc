// A compile-time evaluation that failed inside the evaluated code
// (driver/compile_time.sn, رفض_وقت_الترجمة.مفصل): the diagnostic points at
// the failing source, names the function it was in and the operation that
// was refused, shows each call on the way there ("called from here"), and
// for the instruction budget says how much was spent and how to raise it.

عرف أضف_نص_تشخيص_وقت_الترجمة(التشخيص: &متغير تشخيص, المفتاح: مفتاح_حجة_تشخيص, النص: نص): فراغ {
    دع أضيف: منطقي = أضف_حجة_تشخيص(التشخيص, المفتاح, النص);
}


// The source name of an MSIR function, from its debug record.
عرف اسم_دالة_وقت_الترجمة(التصحيح: &بيانات_تصحيح_مسير, الدالة: معرف_دالة_مسير): اختياري نص {
    طابق دالة_تصحيح_لمسير(&(*التصحيح).العقد, الدالة) مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة < (الطول((*التصحيح).الدلالي.الدوال) مثل طبيعي)) {
            دع الاسم: &متجه ط8 = &(*التصحيح).الدلالي.الدوال[المعرف.القيمة].الاسم;
            إذا ((الطول(*الاسم) مثل طبيعي) > 0) { أرجع اختياري.موجود(من_بايتات(الاسم)); };
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// What the instruction at الموقع does, when it is one compile-time
// evaluation can refuse: a call to an external function or to a primitive
// (with its name), a call through a function value, the address of a
// global, a raw pointer. iSpeak words the operation (مفتاح_نص_مترجم).
نوع عملية_وقت_الترجمة_مرفوضة = {
    العملية: مفتاح_نص_مترجم,
    الاسم: اختياري نص
};

عرف عملية_مرفوضة(العملية: مفتاح_نص_مترجم, الاسم: اختياري نص): اختياري عملية_وقت_الترجمة_مرفوضة {
    دع الناتج: عملية_وقت_الترجمة_مرفوضة = { العملية: العملية, الاسم: الاسم };
    أرجع اختياري.موجود(الناتج);
}

عرف وصف_عملية_وقت_الترجمة(البرنامج: &برنامج_مسير, الموقع: &موقع_فشل_تفسير_مسير): اختياري عملية_وقت_الترجمة_مرفوضة {
    دع الدالة: طبيعي = (*الموقع).الدالة.القيمة;
    إذا (الدالة >= (الطول((*البرنامج).الدوال) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الكتلة: طبيعي = (*الموقع).الكتلة.القيمة;
    إذا (الكتلة >= (الطول((*البرنامج).الدوال[الدالة].الكتل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الفهرس: طبيعي;
    طابق (*الموقع).التعليمة مع
    | اختياري.موجود(ف) -> { الفهرس := ف; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    إذا (الفهرس >= (الطول((*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع العملية: &عملية_مسير = &(*البرنامج).الدوال[الدالة].الكتل[الكتلة].التعليمات[الفهرس].العملية;
    طابق *العملية مع
    | عملية_مسير.نداء(النداء) -> {
        طابق النداء.الهدف مع
        | هدف_نداء_مسير.دالة_خارجية(المعرف) -> {
            إذا ((المعرف.القيمة مثل طبيعي) < (الطول((*البرنامج).الدوال_الخارجية) مثل طبيعي)) {
                أرجع عملية_مرفوضة(
                    مفتاح_نص_مترجم.عملية_نداء_دالة_خارجية(),
                    اختياري.موجود(من_بايتات(&(*البرنامج).الدوال_الخارجية[المعرف.القيمة].الاسم))
                );
            };
            أرجع عملية_مرفوضة(مفتاح_نص_مترجم.عملية_نداء_دالة_خارجية(), اختياري.لا_شيء());
        }
        | هدف_نداء_مسير.بدائي_مترجم(الهوية) -> {
            أرجع عملية_مرفوضة(
                مفتاح_نص_مترجم.عملية_نداء_بدائي(), اختياري.موجود(نص_هوية_بدائي_تشخيصية(الهوية))
            );
        }
        | هدف_نداء_مسير.قيمة_دالة(_) -> { أرجع عملية_مرفوضة(مفتاح_نص_مترجم.عملية_نداء_قيمة_دالة(), اختياري.لا_شيء()); }
        | هدف_نداء_مسير.دالة_سلطان(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | عملية_مسير.مكان_عام(_) -> { أرجع عملية_مرفوضة(مفتاح_نص_مترجم.عملية_عنوان_عام(), اختياري.لا_شيء()); }
    | عملية_مسير.مرجع_إلى_مؤشر(_) -> { أرجع عملية_مرفوضة(مفتاح_نص_مترجم.عملية_مؤشر_خام_من_مرجع(), اختياري.لا_شيء()); }
    | عملية_مسير.موضع_تخزين_عنصر_مؤشر(_) -> { أرجع عملية_مرفوضة(مفتاح_نص_مترجم.عملية_تخزين_عبر_مؤشر_خام(), اختياري.لا_شيء()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف موقعا_نداء_متساويان(أ: &موقع_فشل_تفسير_مسير, ب: &موقع_فشل_تفسير_مسير): منطقي {
    إذا ((*أ).الكتلة.الدالة.القيمة != (*ب).الكتلة.الدالة.القيمة || (*أ).الكتلة.القيمة != (*ب).الكتلة.القيمة) { أرجع خطأ; };
    طابق (*أ).التعليمة مع
    | اختياري.موجود(س) -> {
        طابق (*ب).التعليمة مع
        | اختياري.موجود(ص) -> { أرجع س == ص; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف حجج_فارغة_وقت_الترجمة(): متجه حجة_تشخيص { دع الناتج: متجه حجة_تشخيص = []; أرجع الناتج; }

عرف سبب_ميزانية_وقت_الترجمة(السبب: &سبب_تشخيص): منطقي {
    طابق *السبب مع
    | سبب_تشخيص.سبب_وقت_الترجمة_نفاد_ميزانية_التعليمات -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف سبب_عمق_وقت_الترجمة(السبب: &سبب_تشخيص): منطقي {
    طابق *السبب مع
    | سبب_تشخيص.سبب_وقت_الترجمة_نفاد_عمق_الاستدعاء -> { أرجع صواب; }
    | سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_عمق_الاستدعاء -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف سبب_أثر_وقت_الترجمة(السبب: &سبب_تشخيص): منطقي {
    طابق *السبب مع
    | سبب_تشخيص.سبب_وقت_الترجمة_أثر_ممنوع -> { أرجع صواب; }
    | سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف تشخيص_رفض_وقت_الترجمة_مفصل(
    السبب: سبب_تشخيص,
    الفشل: &فشل_تفسير_موضعي,
    الحد: طبيعي,
    البرنامج: &برنامج_مسير,
    المصادر: &خريطة_مصادر,
    الأصول: &سجل_أصول_مصدر,
    التصحيح: &بيانات_تصحيح_مسير
): تشخيص {
    // The failing site; without an origin of its own, the nearest call
    // site that has one.
    دع الرئيسي: متغير اختياري نطاق_مصدر_تشخيص = مصدر_تشخيص_لفشل_تفسير(الفشل, المصادر, الأصول, التصحيح);
    دع أول_نداء: متغير طبيعي = 0;
    طابق الرئيسي مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        طالما (أول_نداء < (الطول((*الفشل).النداءات) مثل طبيعي)) {
            دع المصدر: اختياري نطاق_مصدر_تشخيص = مصدر_تشخيص_لموقع_فشل_تفسير(
                &(*الفشل).النداءات[أول_نداء], المصادر, الأصول, التصحيح
            );
            أول_نداء := أول_نداء + 1;
            طابق المصدر مع
            | اختياري.موجود(_) -> { الرئيسي := المصدر; اخرج_من_حلقة; }
            | اختياري.لا_شيء -> { };
        }
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت(), الرئيسي);
    دع سجل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    طابق (*الفشل).الموقع مع
    | اختياري.موجود(الموقع) -> {
        طابق اسم_دالة_وقت_الترجمة(التصحيح, الموقع.الدالة) مع
        | اختياري.موجود(الاسم) -> { أضف_نص_تشخيص_وقت_الترجمة(&متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الاسم); }
        | اختياري.لا_شيء -> { };
        إذا (سبب_أثر_وقت_الترجمة(&السبب)) {
            طابق وصف_عملية_وقت_الترجمة(البرنامج, &الموقع) مع
            | اختياري.موجود(الوصف) -> {
                دع أضيفت: منطقي = أضف_نص_مترجم_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.العملية(), الوصف.العملية);
                طابق الوصف.الاسم مع
                | اختياري.موجود(الاسم) -> { أضف_نص_تشخيص_وقت_الترجمة(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), انسخ_نص(&الاسم)); }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> { };
    إذا (سبب_ميزانية_وقت_الترجمة(&السبب)) {
        // The budget it ran out of: the evaluation's, or the one a
        // comptime_budget call set (all of it was spent).
        دع البلغ: متغير طبيعي = الحد;
        إذا ((*الفشل).المنفذ > 0) { البلغ := (*الفشل).المنفذ; };
        دع ح: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), البلغ);
        دع م: منطقي = أضف_مساعدة(&متغير التشخيص, مفتاح_صياغة.مساعدة_ارفع_ميزانية_وقت_الترجمة(), حجج_فارغة_وقت_الترجمة());
    };
    إذا (سبب_عمق_وقت_الترجمة(&السبب)) {
        دع ح: منطقي = أضف_حجة_طبيعية(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), 128);
    };
    إذا (سبب_أثر_وقت_الترجمة(&السبب)) {
        دع م: منطقي = أضف_مساعدة(&متغير التشخيص, مفتاح_صياغة.مساعدة_انقل_الأثر_إلى_وقت_التشغيل(), حجج_فارغة_وقت_الترجمة());
    };
    // The call chain, innermost first; a deep recursion shows its first
    // sixteen calls.
    // A recursion repeats one call site: it is shown once.
    دع ف: متغير طبيعي = أول_نداء;
    دع المعروض: متغير طبيعي = 0;
    طالما (ف < (الطول((*الفشل).النداءات) مثل طبيعي) && المعروض < 16) {
        إذا (ف > 0 && موقعا_نداء_متساويان(&(*الفشل).النداءات[ف], &(*الفشل).النداءات[ف - 1])) {
            ف := ف + 1;
            تابع_حلقة;
        };
        طابق مصدر_تشخيص_لموقع_فشل_تفسير(&(*الفشل).النداءات[ف], المصادر, الأصول, التصحيح) مع
        | اختياري.موجود(المصدر) -> {
            دع أ: منطقي = أضف_نطاقا_مرتبطا(&متغير التشخيص, المصدر, دور_نطاق_تشخيص.استدعاء_وقت_الترجمة());
            المعروض := المعروض + 1;
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع التشخيص;
}
