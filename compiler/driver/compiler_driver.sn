// Canonical Driver compiler orchestration. Source setup is delegated to source_inputs.sn.
// CLI parsing, process arguments, filesystem output, and process-wide dispatch are not owned here.

// The one environment-level compiler sequence. Frontend semantics execute for every mode,
// then Interpreter/native compilation continue through MSIR and the canonical consumer boundary.
عام عرف نفذ_تجميع_مترجم_في_بيئة(
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    الطلب_المقنن: طلب_تجميع_مترجم
): نتيجة_تجميع_مترجم {
    دع الطلب: طلب_واجهة_وحدة = {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        احتفظ_بحقائق_الأدوات: خطأ
    };

    طابق ابن_واجهة_وحدة(الطلب) مع
    | نتيجة_بناء_واجهة_وحدة.مرفوضة(التشخيصات) -> {
        أرجع نتيجة_تجميع_مترجم.فشل_واجهة(التشخيصات);
    }
    | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
        طابق اخفض_واجهة_وحدة_إلى_مسير(الواجهة) مع
        | نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات) -> {
            أرجع نتيجة_تجميع_مترجم.فشل_مسير(التشخيصات);
        }
        | نتيجة_خفض_واجهة_مسير.ناجح(البرنامج, الأنواع) -> {

            // `check` and `interpret` consume only verified MSIR. Native
            // object/executable compilation preserves the already-proven pipeline
            // and is not silently changed into a new mandatory verifier gate.
            طابق الطلب_المقنن مع
            | طلب_تجميع_مترجم.تحقق -> {
                طابق تحقق_برنامج_مسير(&البرنامج, &الأنواع) مع
                | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
                    دع التشخيصات: مجموعة_تشخيصات = حول_أخطاء_تحقق_مسير_إلى_تشخيصات(
                        &الأخطاء
                    );
                    أرجع نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات);
                }
                | نتيجة_تحقق_مسير.صالح -> {
                    أرجع نتيجة_تجميع_مترجم.تحقق_مكتمل();
                };
            }
            | طلب_تجميع_مترجم.تفسير -> {
                طابق تحقق_برنامج_مسير(&البرنامج, &الأنواع) مع
                | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
                    دع التشخيصات: مجموعة_تشخيصات = حول_أخطاء_تحقق_مسير_إلى_تشخيصات(
                        &الأخطاء
                    );
                    أرجع نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات);
                }
                | نتيجة_تحقق_مسير.صالح -> { };
            }
            | _ -> { };

            // Capture the canonical program-entry FunctionID before the MSIR program
            // is transferred into the consumer context.
            دع دالة_بدء_البرنامج: اختيار معرف_دالة_مسير =
                معرف_دالة_بدء_برنامج_مسير(&البرنامج);
            دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
            طابق الطلب_المقنن مع
                // `تحقق` returned above before MSIR consumer construction. This
                // arm is retained only because the current exhaustiveness checker
                // does not use the earlier return for narrowing.
                | طلب_تجميع_مترجم.تحقق -> {
                    أرجع نتيجة_تجميع_مترجم.تحقق_مكتمل();
                }
                | طلب_تجميع_مترجم.تفسير -> {
                    طابق دالة_بدء_البرنامج مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تجميع_مترجم.مدخل_تفسير_غير_متاح();
                    }
                    | اختيار.بعض(دالة_الدخول) -> {
                        // Compiler CLI arguments are not program-function arguments.
                        // The current canonical entry contract takes no ordinary MSIR args.
                        دع حجج_الدخول: متجه قيمة_تشغيل = [];
                        // `interpret` executes a distinct program process context. The current
                        // CLI surface accepts no program argv after the source, so its canonical
                        // argv is empty rather than the compiler process argv.
                        دع وسائط_البرنامج: متجه متجه غ8 = [];
                        دع نتيجة_المفسر: نتيجة_تفسير_مسير = فسر_سياق_مسير(
                            &المسير,
                            &الأنواع,
                            دالة_الدخول,
                            حجج_الدخول,
                            وسائط_البرنامج
                        );
                        أرجع نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر);
                    };
                }
                | طلب_تجميع_مترجم.كائن_أصلي(المعمارية, المنصة, البيئة) -> {
                    طابق حل_بالتكوين(المعمارية, المنصة, البيئة) مع
                    | نتيجة_حل_هدف.غير_مسجل -> {
                        أرجع نتيجة_تجميع_مترجم.هدف_غير_مسجل();
                    }
                    | نتيجة_حل_هدف.محلول(الهدف) -> {
                        دع حقائق_الخلفية: سياق_استعلام_اختيار_خلفية =
                            أنشئ_سياق_استعلام_اختيار_خلفية(الأنواع);
                        دع سجل_التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();
                        دع نتيجة_الخلفية: نتيجة_مخرج_أصلي = ابن_مخرج_أصلي(
                            &المسير,
                            &حقائق_الخلفية,
                            &الهدف,
                            &متغير سجل_التخطيط,
                            دالة_بدء_البرنامج
                        );
                        طابق نتيجة_الخلفية مع
                        | نتيجة_مخرج_أصلي.نجح(البايتات) -> {
                            أرجع نتيجة_تجميع_مترجم.كائن_أصلي_مكتمل(البايتات);
                        }
                        | نتيجة_مخرج_أصلي.أخفق(الفشل) -> {
                            دع التشخيصات: مجموعة_تشخيصات = حول_فشل_مخرج_أصلي_إلى_تشخيصات(&الفشل);
                            أرجع نتيجة_تجميع_مترجم.فشل_مخرج_أصلي(التشخيصات);
                        };
                    };
                }
                | طلب_تجميع_مترجم.تنفيذي_أصلي(المعمارية, المنصة, البيئة) -> {
                    طابق حل_بالتكوين(المعمارية, المنصة, البيئة) مع
                    | نتيجة_حل_هدف.غير_مسجل -> {
                        أرجع نتيجة_تجميع_مترجم.هدف_غير_مسجل();
                    }
                    | نتيجة_حل_هدف.محلول(الهدف) -> {
                        دع حقائق_الخلفية: سياق_استعلام_اختيار_خلفية =
                            أنشئ_سياق_استعلام_اختيار_خلفية(الأنواع);
                        دع سجل_التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();
                        دع نتيجة_الخلفية: نتيجة_مخرج_أصلي = ابن_تنفيذي_أصلي(
                            &المسير,
                            &حقائق_الخلفية,
                            &الهدف,
                            &متغير سجل_التخطيط,
                            دالة_بدء_البرنامج
                        );
                        طابق نتيجة_الخلفية مع
                        | نتيجة_مخرج_أصلي.نجح(البايتات) -> {
                            أرجع نتيجة_تجميع_مترجم.تنفيذي_أصلي_مكتمل(البايتات);
                        }
                        | نتيجة_مخرج_أصلي.أخفق(الفشل) -> {
                            دع التشخيصات: مجموعة_تشخيصات = حول_فشل_مخرج_أصلي_إلى_تشخيصات(&الفشل);
                            أرجع نتيجة_تجميع_مترجم.فشل_مخرج_أصلي(التشخيصات);
                        };
                    };
                };
        };
    };
}

// Direct compilation performs source setup once, then enters the shared environment sequence.
عام عرف نفذ_طلب_تجميع_مترجم(
    مسار_ملف_الدخول: نص,
    مسارات_ملفات_المصدر_الإضافية: متجه نص,
    الطلب: طلب_تجميع_مترجم
): نتيجة_تجميع_مترجم {
    طابق ابن_إعداد_تجميع_مباشر(
        &مسار_ملف_الدخول,
        &مسارات_ملفات_المصدر_الإضافية
    ) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.ملف_إدخال_مفقود(), اختيار.لا_شيء()
        );
        دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), مسار_ملف_الدخول
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع نتيجة_تجميع_مترجم.فشل_إعداد(المجموعة);
    }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        دع مرجع_البيئة: &بيئة_وحدات_منطقية = &الإعداد.البيئة;
        دع البيئة: بيئة_وحدات_منطقية = *مرجع_البيئة;
        دع مرجع_المفتاح: &مفتاح_وحدة_مقنن = &الإعداد.المفتاح_الجذري;
        دع المفتاح: مفتاح_وحدة_مقنن = *مرجع_المفتاح;
        أرجع نفذ_تجميع_مترجم_في_بيئة(البيئة, المفتاح, الطلب);
    };
}
