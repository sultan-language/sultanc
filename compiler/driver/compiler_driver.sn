عام نوع نتيجة_إضافة_مدخلات_ربط_ملفات =
    | نجح
    | خطأ بنوع (نص, عدد)
    // A text input that is a linker script SultanC cannot apply (a command
    // other than the input-script ones, or malformed): its path, and the
    // command the script parser stopped at (none when malformed).
    | سكربت_غير_مدعوم بنوع (نص, اختياري نص)
;

عرف انسخ_نص_مسار_ربط_مترجم(القيمة: &نص): نص {
    دع النسخة: نص = انسخ_نص(القيمة);
    أرجع النسخة;
}

// Link inputs are added in command order. On an ELF target a GNU input
// script (an INPUT/GROUP script, link/elf/linker_script.sn) stays an
// input at its position and the files it names are added right after it, in
// order, each resolved as LLD's ScriptParser::addFile/addLibrary resolve
// them, in the script's directory and the script's SEARCH_DIR.
// A named file that cannot be found or read fails the link, as in GNU ld;
// nested scripts are followed to a fixed depth, past which the link fails
// (ELOOP) instead of linking a partial set. Every input records its
// provenance in the plan (link/model.sn أصل_مدخل_ربط): the script is marked
// as such and each file it names records that script as its parent and
// whether it is linked as needed, so consumers read AS_NEEDED and nesting
// from the plan and a script cannot change which libraries become
// dependencies behind their back. A text input that is a linker script with
// unsupported commands fails the link.
// Previously the script was replaced by a flat list of its files, losing
// AS_NEEDED, and scripts were expanded for every object format although
// only ELF linkers accept them.
عرف أضف_سكربت_جنو_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    المسار: نص,
    البايتات: متجه ط8,
    السكربت: سكربت_إدخال_جنو,
    العمق: طبيعي,
    الأصل: أصل_مدخل_ربط
): نتيجة_إضافة_مدخلات_ربط_ملفات {
    لو (العمق >= 8) {
        // -ELOOP: the script nesting does not terminate within the bound.
        أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(المسار, -40);
    };
    دع دليل_السكربت: متجه ط8 = دليل_مسار_سكربت_جنو(&المسار);

    // The script itself keeps its place; its files follow it and name it as
    // their parent. A script read as needed passes that on to its files.
    دع السكربت_حسب_الحاجة: منطقي;
    طابق الأصل مع
    | أصل_مدخل_ربط.من_سكربت(_, حسب_الحاجة) -> { السكربت_حسب_الحاجة := حسب_الحاجة; }
    | أصل_مدخل_ربط.مباشر -> { السكربت_حسب_الحاجة := خطأ; };
    دع معرف_السكربت: معرف_مدخل_ربط = أضف_مدخل_بمصدر_إلى_خطة_ربط(
        الخطة,
        صنف_مدخل_ربط.كائن(),
        البايتات,
        اختياري.موجود(المسار),
        الأصل,
        صواب
    );
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(السكربت.المدخلات) مثل طبيعي)) {
        دع المرشحون: متجه نص = مرشحو_مدخل_سكربت_جنو(
            &السكربت,
            &السكربت.المدخلات[ف],
            &دليل_السكربت
        );
        دع الموجود: متغير منطقي = خطأ;
        // -ENOENT when there is no candidate at all.
        دع الحالة_الأخيرة: متغير عدد = -2;
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(المرشحون) مثل طبيعي) && !الموجود) {
            دع المرشح: نص = انسخ_نص_مسار_ربط_مترجم(&المرشحون[م]);
            طابق اقرأ_بايتات_ملف(&المرشح) مع
            | نتيجة.خطأ(الحالة) -> { الحالة_الأخيرة := الحالة; }
            | نتيجة.نجح(المحتوى) -> {
                الموجود := صواب;
                طابق أضف_مدخل_ربط_ملف_مقروء(
                    الخطة,
                    المرشح,
                    المحتوى,
                    العمق + 1,
                    صواب,
                    أصل_مدخل_ربط.من_سكربت(
                        معرف_السكربت,
                        السكربت_حسب_الحاجة || السكربت.المدخلات[ف].حسب_الحاجة
                    )
                ) مع
                | نتيجة_إضافة_مدخلات_ربط_ملفات.نجح -> { }
                | نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(مسار_الخطأ, حالة_الخطأ) -> {
                    أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(
                        مسار_الخطأ,
                        حالة_الخطأ
                    );
                }
                | نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(مسار_الخطأ, أمر_الخطأ) -> {
                    أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(
                        مسار_الخطأ,
                        أمر_الخطأ
                    );
                };
            };
            م := م + 1;
        }
        لو (!الموجود) {
            دع المطلوب: متغير متجه ط8 = [];
            لو (السكربت.المدخلات[ف].مكتبة) {
                المطلوب := بايتات_من_نص(«-l»);
            };
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(السكربت.المدخلات[ف].الاسم) مثل طبيعي)) {
                ألحق(المطلوب, السكربت.المدخلات[ف].الاسم[ب]);
                ب := ب + 1;
            }
            أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(
                من_بايتات(&المطلوب),
                الحالة_الأخيرة
            );
        };
        ف := ف + 1;
    }
    أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.نجح();
}

عرف أضف_مدخل_ربط_ملف_مقروء(
    الخطة: &متغير خطة_ربط,
    المسار: نص,
    البايتات: متجه ط8,
    العمق: طبيعي,
    يقبل_سكربتات_جنو: منطقي,
    الأصل: أصل_مدخل_ربط
): نتيجة_إضافة_مدخلات_ربط_ملفات {
    طابق صنف_ملف_مدخل_ربط(&البايتات) مع
    | نوع_ملف_مدخل_ربط.أرشيف -> {
        أضف_مدخل_بمصدر_إلى_خطة_ربط(
            الخطة,
            صنف_مدخل_ربط.أرشيف(),
            البايتات,
            اختياري.موجود(المسار),
            الأصل,
            خطأ
        );
    }
    | نوع_ملف_مدخل_ربط.مكتبة_ديناميكية -> {
        أضف_مدخل_بمصدر_إلى_خطة_ربط(
            الخطة,
            صنف_مدخل_ربط.مكتبة_ديناميكية(),
            البايتات,
            اختياري.موجود(المسار),
            الأصل,
            خطأ
        );
    }
    | _ -> {
        دع سكربت_محلل: متغير نتيجة_تحليل_سكربت_جنو =
            نتيجة_تحليل_سكربت_جنو.ليس_سكربت();
        لو (يقبل_سكربتات_جنو) {
            سكربت_محلل := حلل_نص_سكربت_جنو(&البايتات);
        };
        طابق سكربت_محلل مع
        | نتيجة_تحليل_سكربت_جنو.ليس_سكربت -> {
            أضف_مدخل_بمصدر_إلى_خطة_ربط(
                الخطة,
                صنف_مدخل_ربط.كائن(),
                البايتات,
                اختياري.موجود(المسار),
                الأصل,
                خطأ
            );
        }
        | نتيجة_تحليل_سكربت_جنو.غير_مدعوم(الأمر) -> {
            دع أمر_النص: متغير اختياري نص = اختياري.لا_شيء();
            طابق الأمر مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(بايتات_الأمر) -> {
                أمر_النص := اختياري.موجود(من_بايتات(&بايتات_الأمر));
            };
            أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(
                المسار,
                أمر_النص
            );
        }
        | نتيجة_تحليل_سكربت_جنو.سكربت(السكربت) -> {
            أرجع أضف_سكربت_جنو_إلى_خطة_ربط(
                الخطة,
                المسار,
                البايتات,
                السكربت,
                العمق,
                الأصل
            );
        };
    };
    أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.نجح();
}

عرف أضف_مدخلات_ربط_ملفات(
    الخطة: &متغير خطة_ربط,
    المسارات: &متجه نص,
    يقبل_سكربتات_جنو: منطقي
): نتيجة_إضافة_مدخلات_ربط_ملفات {
    دع فهرس_المسار: متغير طبيعي = 0;
    طالما (فهرس_المسار < (الطول(*المسارات) مثل طبيعي)) {
        دع المسار: نص = انسخ_نص_مسار_ربط_مترجم(&(*المسارات)[فهرس_المسار]);
        دع البايتات: متجه ط8;
        طابق اقرأ_بايتات_ملف(&المسار) مع
        | نتيجة.خطأ(الحالة) -> {
            أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(المسار, الحالة);
        }
        | نتيجة.نجح(المحتوى) -> { البايتات := المحتوى; };
        طابق أضف_مدخل_ربط_ملف_مقروء(
            الخطة,
            المسار,
            البايتات,
            0,
            يقبل_سكربتات_جنو,
            أصل_مدخل_ربط.مباشر()
        ) مع
        | نتيجة_إضافة_مدخلات_ربط_ملفات.نجح -> { }
        | نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(مسار_الخطأ, حالة_الخطأ) -> {
            أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(مسار_الخطأ, حالة_الخطأ);
        }
        | نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(مسار_الخطأ, أمر_الخطأ) -> {
            أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(
                مسار_الخطأ,
                أمر_الخطأ
            );
        };
        فهرس_المسار := فهرس_المسار + 1;
    }
    أرجع نتيجة_إضافة_مدخلات_ربط_ملفات.نجح();
}

// The libLLVM this compiler runs with is a fact about its host
// (backend/provider/llvm/toolchain.sn, reached through the LLVM inclusion
// boundary; a compiler built without LLVM has none), recorded together with the compiler's
// registered host target. The link uses it only for an output whose target is
// that host target and that calls the LLVM C API (link/dependency/llvm.sn);
// it is never a fact about other targets. Previously the Driver recorded the
// compiler's library name, directory and LLVM major for every link, whatever
// its target, and a WASI-hosted compiler carried those of its builder.
عرف ثبت_مكتبة_إل_إل_في_إم_المضيف_في_خطة_السياق(
    الخطة: &متغير خطة_ربط
): فراغ {
    دع بايتات_المسار: متجه ط8;
    طابق موقع_مكتبة_إل_إل_في_إم_المضيف() مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(المسار) -> { بايتات_المسار := المسار; };
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { }
    | نتيجة_حل_هدف.محلول(المضيف) -> {
        ثبت_مكتبة_إل_إل_في_إم_المضيف_في_خطة_ربط(
            الخطة,
            من_بايتات(&بايتات_المسار),
            المضيف.المعرف
        );
    };
}

// The libraries the program's external declarations name, handed to the
// linker with each symbol (link/model.sn استيراد_مكتبة_مصرح_ربط). std
// declares the library of every platform function it calls, so the linkers
// hold no per-target symbol tables.
عرف ثبت_الاستيرادات_المصرحة_في_خطة_السياق(
    الخطة: &متغير خطة_ربط,
    المسير: &سياق_مستهلك_مسير
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*المسير).المسير.الدوال_الخارجية) مثل طبيعي)) {
        دع الخارجية: &دالة_خارجية_مسير = &(*المسير).المسير.الدوال_الخارجية[الفهرس];
        طابق (*الخارجية).المكتبة مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المكتبة) -> {
            أضف_استيراد_مكتبة_مصرح_إلى_خطة_ربط(
                الخطة, انسخ_بايتات(&(*الخارجية).الاسم), انسخ_بايتات(&المكتبة)
            );
        };
        الفهرس := الفهرس + 1;
    }
}

// Only an executable may drop functions its entry does not reach; libraries,
// relocatable objects and target modules keep every definition
// (msir_consumer.sn, دوال_مسير_مطلوبة_لمخرج). Both backends receive this.
// The program declares no entry function (`الرئيسية` or `main`): a user error,
// for `run` and for an executable alike.
عام عرف تشخيصات_نقطة_دخول_مفقودة(): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.نقطة_دخول_مفقودة(), اختياري.لا_شيء());
    دع أ: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), «main», «الرئيسية»
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف مخرج_تنفيذي_لربط(النوع: نوع_خرج_ربط_مترجم): منطقي {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.تنفيذي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// SultanC links no C runtime anywhere, so an executable carries its own
// process start, emitted by the selected backend (the native encoder or the
// LLVM provider), and that start exits through the std process-exit
// provider: raw kernel calls on Linux (the internal ELF linker's targets),
// ExitProcess from kernel32 on Windows (the PE entry `_start`), proc_exit on
// WASI. Mach-O is the one exception to a SultanC start: dyld itself calls
// main through LC_MAIN and passes its status to libSystem's exit, the macOS
// system interface. Previously PE executables entered through the C
// runtime's mainCRTStartup, and delegated ELF links used the platform C
// runtime's startup objects. This one predicate decides both the backend
// start and the std provider root loaded below.
عرف بدء_عملية_ذاتي_لربط(
    النوع: نوع_خرج_ربط_مترجم,
    الهدف: &واصف_هدف
): منطقي {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.تنفيذي -> { }
    | _ -> { أرجع خطأ; };
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.ويب_أسمبلي()) {
        أرجع (*الهدف).مزود_التشغيل == مزود_تشغيل_هدف.واسي();
    };
    لو ((*الهدف).صيغة_الكائن == صيغة_كائن_هدف.كوف()) {
        أرجع (*الهدف).المنصة.المنصة == هوية_منصة.ويندوز();
    };
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.إلف()) { أرجع خطأ; };
    أرجع يستخدم_رابط_إلف_الداخلي(الهدف) || يستخدم_رابط_إلف_خارجي(الهدف);
}

// Compiler-required module roots of a compile request. A self-started process
// needs the std process-exit provider (see the runtime ABI owner,
// compiler/runtime/primitive_runtime_abi.sn): every executable for such a
// target, and every native object for it, because the native encoder places
// the process start in the object of a program with an entry. The provider
// module joins the same module graph so programs need not import it. When the
// environment has no trusted std root nothing is added and the backend fails
// closed on the missing provider instead of inventing one.
عرف مفاتيح_جذور_مطلوبة_لطلب(
    الطلب: &طلب_تجميع_مترجم,
    الهدف: &واصف_هدف,
    البيئة: &بيئة_وحدات_منطقية
): متجه مفتاح_وحدة_مقنن {
    دع الناتج: متغير متجه مفتاح_وحدة_مقنن = [];
    دع يحتاج_مزود_الخروج: متغير منطقي = خطأ;
    طابق *الطلب مع
    | طلب_تجميع_مترجم.ربط(_, _, نوع_المخرج, _, _) -> {
        يحتاج_مزود_الخروج := بدء_عملية_ذاتي_لربط(نوع_المخرج, الهدف);
    }
    | طلب_تجميع_مترجم.كائن(_, مزود_الخلفية, _) -> {
        طابق مزود_الخلفية مع
        | هوية_مزود_خلفية.أصلي -> {
            يحتاج_مزود_الخروج := بدء_عملية_ذاتي_لربط(
                نوع_خرج_ربط_مترجم.تنفيذي(), الهدف
            );
        }
        | _ -> { };
    }
    | _ -> { };
    لو (يحتاج_مزود_الخروج) {
        دع المسار: متجه ط8 = مسار_وحدة_خروج_عملية_نظام_أساسي();
        طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &المسار) مع
        | اختياري.موجود(المفتاح) -> { ألحق(الناتج, المفتاح); }
        | اختياري.لا_شيء -> { };
    };
    // Where std implements the storage services (wasm32), every object or
    // linked output may allocate: load the provider module the same way.
    دع يولد_شفرة: متغير منطقي = خطأ;
    طابق *الطلب مع
    | طلب_تجميع_مترجم.ربط(_, _, _, _, _) -> { يولد_شفرة := صواب; }
    | طلب_تجميع_مترجم.كائن(_, _, _) -> { يولد_شفرة := صواب; }
    | _ -> { };
    لو (يولد_شفرة && خدمات_الذاكرة_من_المكتبة_القياسية(الهدف)) {
        دع مسار_المزودات: متجه ط8 = مسار_وحدة_مزودات_الذاكرة_أساسي();
        طابق حل_وحدة_مكتبة_قياسية_موثوقة(البيئة, &مسار_المزودات) مع
        | اختياري.موجود(المفتاح) -> { ألحق(الناتج, المفتاح); }
        | اختياري.لا_شيء -> { };
    };
    أرجع الناتج;
}

// A shared library is position-independent code for both backends: the LLVM
// provider gets the PIC relocation model below, and the native provider the
// same fact (consulted by its wasm32 path, which emits WebAssembly PIC code
// for dylink.0 shared modules).
عرف مخرج_مستقل_الموضع_لربط(النوع: نوع_خرج_ربط_مترجم): منطقي {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.مكتبة_مشتركة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف سياسة_تموضع_إل_إل_في_إم_لربط(
    النوع: نوع_خرج_ربط_مترجم,
    الهدف: &واصف_هدف
): سياسة_تموضع_شفرة_إل_إل_في_إم {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.مكتبة_مشتركة -> {
        أرجع سياسة_تموضع_شفرة_إل_إل_في_إم.مستقلة_الموضع();
    }
    | _ -> { };
    أرجع سياسة_تموضع_شفرة_إل_إل_في_إم.افتراضية();
}

عرف بايتات_نص_ربط_مترجم(النص: &نص): متجه ط8 {
    دع البايتات: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*النص) مثل طبيعي)) {
        ألحق(البايتات, (*النص)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع البايتات;
}

عرف نوع_خطة_ربط_من_طلب_مترجم(
    النوع: نوع_خرج_ربط_مترجم
): نوع_خرج_ربط {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.تنفيذي -> { أرجع نوع_خرج_ربط.تنفيذي(); }
    | نوع_خرج_ربط_مترجم.مكتبة_مشتركة -> {
        أرجع نوع_خرج_ربط.مكتبة_مشتركة();
    }
    | نوع_خرج_ربط_مترجم.كائن_مترابط -> {
        أرجع نوع_خرج_ربط.كائن_مترابط();
    }
    | نوع_خرج_ربط_مترجم.وحدة_هدف -> {
        أرجع نوع_خرج_ربط.وحدة_هدف();
    };
}

عرف نتيجة_ربط_مترجم_مكتملة(
    النوع: نوع_خرج_ربط_مترجم,
    البايتات: متجه ط8
): نتيجة_تجميع_مترجم {
    طابق النوع مع
    | نوع_خرج_ربط_مترجم.تنفيذي -> {
        أرجع نتيجة_تجميع_مترجم.تنفيذي_مكتمل(البايتات);
    }
    | نوع_خرج_ربط_مترجم.مكتبة_مشتركة -> {
        أرجع نتيجة_تجميع_مترجم.مكتبة_مشتركة_مكتملة(البايتات);
    }
    | نوع_خرج_ربط_مترجم.كائن_مترابط -> {
        أرجع نتيجة_تجميع_مترجم.كائن_مترابط_مكتمل(البايتات);
    }
    | نوع_خرج_ربط_مترجم.وحدة_هدف -> {
        أرجع نتيجة_تجميع_مترجم.وحدة_هدف_مكتملة(البايتات);
    };
}

// Canonical Driver compiler orchestration. Source setup is delegated to source_inputs.sn.
// The per-compilation context owns lifecycle and payload transfer; this file remains
// the only executor of Frontend -> MSIR -> consumer/backend sequencing.

عرف نتيجة_خطأ_سياق_تجميع(): نتيجة_تجميع_مترجم {
    دع التشخيص: تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_سياق_داخلي(), اختياري.لا_شيء()
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع نتيجة_تجميع_مترجم.فشل_داخلي(المجموعة);
}

عرف اختم_سياق_التجميع(
    السياق: سياق_التجميع,
    النتيجة: نتيجة_تجميع_مترجم
): نتيجة_تجميع_مترجم {
    طابق أنه_سياق_التجميع(السياق, النتيجة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
    | اختياري.موجود(المنتهي) -> {
        طابق خذ_نتيجة_التجميع(المنتهي) مع
        | نتيجة_خذ_نتيجة_التجميع.غير_صالح -> {
            أرجع نتيجة_خطأ_سياق_تجميع();
        }
        | نتيجة_خذ_نتيجة_التجميع.ملغى(_) -> {
            أرجع نتيجة_تجميع_مترجم.ملغى();
        }
        | نتيجة_خذ_نتيجة_التجميع.ناجح(_, الناتج) -> {
            أرجع الناتج;
        };
    };
}

// The target is a property of the compilation request, not backend output.
// Resolve it before invoking Frontend; backend selection stays independent.
عرف حل_هدف_طلب_تجميع_مترجم(
    الطلب: &طلب_تجميع_مترجم
): نتيجة_حل_هدف {
    طابق *الطلب مع
    | طلب_تجميع_مترجم.كائن(المعرف, _, _) -> {
        أرجع حل_بمعرف_هدف(المعرف);
    }
    | طلب_تجميع_مترجم.ربط(المعرف, _, _, _, _) -> {
        أرجع حل_بمعرف_هدف(المعرف);
    }
    | طلب_تجميع_مترجم.تحقق(المعرف) -> { أرجع حل_بمعرف_هدف(المعرف); }
    | طلب_تجميع_مترجم.تفسير(المعرف) -> { أرجع حل_بمعرف_هدف(المعرف); };
}

// Whether this compiler contains the provider at all. The native provider is
// part of every SultanC compiler; the LLVM provider is a compiler-build
// capability answered by its inclusion boundary (llvm_codegen.sn or
// unavailable.sn). This is independent of the requested target, whose
// admission of a provider is the Target fact يدعم_مزود_الخلفية.
عام عرف مزود_خلفية_مضمن_في_المترجم(المزود: هوية_مزود_خلفية): منطقي {
    طابق المزود مع
    | هوية_مزود_خلفية.أصلي -> { أرجع صواب; }
    | هوية_مزود_خلفية.إل_إل_في_إم -> { أرجع مزود_إل_إل_في_إم_مضمن(); };
}

// An unavailable backend names its target as spelled on the command line
// (`x86_64-linux`), not by the registry's internal number.
عرف تشخيصات_خلفية_غير_متاحة_لهدف(
    الهدف: &واصف_هدف,
    المزود: هوية_مزود_خلفية,
    غير_مضمن: منطقي
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خلفية_مترجم_غير_متاحة(), اختياري.لا_شيء()
    );
    دع السبب: متغير سبب_تشخيص = سبب_تشخيص.سبب_خلفية_أصلية_غير_مضمنة();
    طابق المزود مع
    | هوية_مزود_خلفية.أصلي -> {
        لو (!غير_مضمن) { السبب := سبب_تشخيص.سبب_أصلي_خلفية_غير_متاح_ل_هدف(); };
    }
    | هوية_مزود_خلفية.إل_إل_في_إم -> {
        السبب := سبب_تشخيص.سبب_خلفية_إل_إل_في_إم_غير_مضمنة();
        لو (!غير_مضمن) { السبب := سبب_تشخيص.سبب_إل_إل_في_إم_خلفية_غير_متاح_ل_هدف(); };
    };
    دع أ: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «backend-select»);
    دع ب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    دع ج: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), تهجئة_هدف_مسجل(الهدف)
    );
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

عرف تشخيصات_توفر_مزود_خلفية(
    الهدف: &واصف_هدف,
    المزود: هوية_مزود_خلفية
): اختياري مجموعة_تشخيصات {
    لو (!مزود_خلفية_مضمن_في_المترجم(المزود)) {
        أرجع اختياري.موجود(تشخيصات_خلفية_غير_متاحة_لهدف(الهدف, المزود, صواب));
    };
    لو (!يدعم_مزود_الخلفية(الهدف, المزود)) {
        أرجع اختياري.موجود(تشخيصات_خلفية_غير_متاحة_لهدف(الهدف, المزود, خطأ));
    };
    أرجع اختياري.لا_شيء();
}


// The diagnostic of a format string std.fmt's compile-time check rejected.
// الرمز is the checker's packed result: (variant + 1) << 48, the placeholder
// offset + 1 << 24, and the payload (a byte offset for the syntax errors, an
// argument position for the others). Offsets count bytes of the string's
// value; they are mapped into the literal unless it contains an escape, and
// then the whole literal is shown.
عرف تشخيص_سلسلة_تنسيق(
    المصادر: &خريطة_مصادر,
    الرمز: ط64,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): تشخيص {
    دع الصنف: ط64 = الرمز >> 48;
    دع الموضع: طبيعي = ((الرمز >> 24) & 0xFFFFFF) مثل طبيعي;
    دع الحمولة: طبيعي = (الرمز & 0xFFFFFF) مثل طبيعي;
    دع السبب: متغير سبب_تشخيص = سبب_تشخيص.سبب_تنسيق_مواصفة_غير_صالحة();
    دع إزاحة: متغير اختياري طبيعي = اختياري.لا_شيء();
    لو (الصنف == 1) { السبب := سبب_تشخيص.سبب_تنسيق_قوس_غير_مغلق(); إزاحة := اختياري.موجود(الحمولة); }
    وإلا لو (الصنف == 2) { السبب := سبب_تشخيص.سبب_تنسيق_قوس_إغلاق_منفرد(); إزاحة := اختياري.موجود(الحمولة); }
    وإلا لو (الصنف == 3) { السبب := سبب_تشخيص.سبب_تنسيق_مواصفة_غير_صالحة(); إزاحة := اختياري.موجود(الحمولة); }
    وإلا لو (الصنف == 4) { السبب := سبب_تشخيص.سبب_تنسيق_نوع_غير_معروف(); إزاحة := اختياري.موجود(الحمولة); }
    وإلا لو (الصنف == 5) { السبب := سبب_تشخيص.سبب_تنسيق_وسيط_مسمى(); إزاحة := اختياري.موجود(الحمولة); }
    وإلا لو (الصنف == 6) { السبب := سبب_تشخيص.سبب_تنسيق_وسيط_مفقود(); }
    وإلا لو (الصنف == 7) { السبب := سبب_تشخيص.سبب_تنسيق_وسيط_غير_مستخدم(); }
    وإلا لو (الصنف == 8) { السبب := سبب_تشخيص.سبب_تنسيق_نوع_غير_مناسب(); }
    وإلا لو (الصنف == 9) { السبب := سبب_تشخيص.سبب_تنسيق_عدد_غير_صالح(); };
    لو (الصنف >= 6 && الموضع > 0) { إزاحة := اختياري.موجود(الموضع - 1); };
    دع بداية_الموضع: موضع = { المصدر: المصدر, البايت: البداية };
    دع نهاية_الموضع: موضع = { المصدر: المصدر, البايت: النهاية };
    دع النطاق: متغير نطاق = { البداية: بداية_الموضع, النهاية: نهاية_الموضع };
    طابق إزاحة مع
    | اختياري.موجود(القيمة) -> {
        طابق موضع_في_حرفي_نص(المصادر, المصدر, البداية, النهاية, القيمة) مع
        | اختياري.موجود(البايت) -> {
            دع أول: موضع = { المصدر: المصدر, البايت: البايت };
            دع آخر: موضع = { المصدر: المصدر, البايت: البايت + 1 };
            دع الضيق: نطاق = { البداية: أول, النهاية: آخر };
            النطاق := الضيق;
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.سلسلة_تنسيق_غير_صالحة(), مصدر_تشخيص_من_نطاق_محمل(المصادر, النطاق)
    );
    دع سجل_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
    لو (الصنف >= 6) {
        دع سجل_الفهرس: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الحمولة
        );
    };
    أرجع التشخيص;
}

// The source byte of value byte الإزاحة of the string literal at
// [البداية, النهاية), when the literal has no escape before it.
عرف موضع_في_حرفي_نص(
    المصادر: &خريطة_مصادر,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي,
    الإزاحة: طبيعي
): اختياري طبيعي {
    لو (المصدر >= (الطول((*المصادر).المصادر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع المحتوى: &نص = &(*المصادر).المصادر[المصدر].المحتوى;
    لو (النهاية > (الطول(*المحتوى) مثل طبيعي) || البداية >= النهاية) { أرجع اختياري.لا_شيء(); };
    // The opening quote: `"` or `«` (two bytes).
    دع الأول: متغير طبيعي = البداية + 1;
    لو ((*المحتوى)[البداية] == 0xC2) { الأول := البداية + 2; };
    دع ف: متغير طبيعي = الأول;
    طالما (ف < الأول + الإزاحة) {
        لو (ف >= النهاية || (*المحتوى)[ف] == 0x5C) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    لو (ف >= النهاية) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(ف);
}

عرف نفذ_سياق_تجميع(
    السياق_المدخل: سياق_التجميع,
    الطلب: طلب_تجميع_مترجم,
    وسائط_البرنامج: متجه متجه ط8,
    // Diagnostics that did not stop the compilation (warnings).
    التحذيرات: &متغير مجموعة_تشخيصات
): نتيجة_تجميع_مترجم {
    دع السياق: متغير سياق_التجميع;
    دع الإعداد: متغير إعداد_تجميع_مباشر;
    طابق خذ_إعداد_التجميع(السياق_المدخل) مع
    | نتيجة_خذ_إعداد_التجميع.غير_صالح -> {
        أرجع نتيجة_خطأ_سياق_تجميع();
    }
    | نتيجة_خذ_إعداد_التجميع.ناجح(التالي, القيمة_المعدة) -> {
        السياق := التالي;
        الإعداد := القيمة_المعدة;
    };

    // Resolve the canonical requested target before the frontend loads any
    // module. Cross-compilation must never select sources using host facts.
    دع الهدف_المحدد: واصف_هدف;
    دع حل_الهدف_المحدد: نتيجة_حل_هدف = حل_هدف_طلب_تجميع_مترجم(&الطلب);
    طابق حل_الهدف_المحدد مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع اختم_سياق_التجميع(
            السياق, نتيجة_تجميع_مترجم.هدف_غير_مسجل()
        );
    }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف_المحدد := الوصف; };

    // Backend availability is two independent facts, both settled here before
    // any module is loaded: the provider must be included in this compiler (a
    // compiler-build capability, owned by the provider's inclusion boundary)
    // and the registered target must admit it (Target, يدعم_مزود_الخلفية).
    // Neither failure ever falls back to the other provider. Previously the
    // target check ran only after MSIR lowering.
    طابق الطلب مع
    | طلب_تجميع_مترجم.كائن(_, مزود_الطلب, _) -> {
        طابق تشخيصات_توفر_مزود_خلفية(&الهدف_المحدد, مزود_الطلب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التشخيصات) -> {
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
            );
        };
    }
    | طلب_تجميع_مترجم.ربط(_, مزود_الطلب, _, _, _) -> {
        طابق تشخيصات_توفر_مزود_خلفية(&الهدف_المحدد, مزود_الطلب) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(التشخيصات) -> {
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
            );
        };
    }
    | _ -> { };

    // The Interpreter owns execution compatibility for all callers, including
    // direct entry points. Reject an incompatible target before lowering.
    طابق الطلب مع
    | طلب_تجميع_مترجم.تفسير(_) -> {
        طابق حل_هدف_تفسير_متوافق(الهدف_المحدد.المعرف) مع
        | اختياري.لا_شيء -> {
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق()
            );
        }
        | اختياري.موجود(_) -> { };
    }
    | _ -> { };

    طابق الإعداد مع
    | {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        المفاتيح_المباشرة: _
    } -> {
        دع طلب_الواجهة: طلب_واجهة_وحدة = {
            البيئة: البيئة,
            المفتاح_الجذري: المفتاح_الجذري,
            احتفظ_بحقائق_الأدوات: خطأ
        };
        // The current language cannot pass a mutable reference to a nested field.
        // Move only the tiny cancellation owner through Frontend, then restore it.
        // The Frontend owns its own resolved descriptor; the Driver keeps
        // الهدف_المحدد for backend and Interpreter selection afterwards.
        دع هدف_الواجهة: واصف_هدف;
        طابق حل_هدف_طلب_تجميع_مترجم(&الطلب) مع
        | نتيجة_حل_هدف.غير_مسجل -> {
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.هدف_غير_مسجل()
            );
        }
        | نتيجة_حل_هدف.محلول(الوصف) -> { هدف_الواجهة := الوصف; };
        دع الجذور_المطلوبة: متجه مفتاح_وحدة_مقنن =
            مفاتيح_جذور_مطلوبة_لطلب(&الطلب, &هدف_الواجهة, &طلب_الواجهة.البيئة);
        دع إلغاء_الواجهة: متغير حالة_إلغاء_واجهة = السياق.الإلغاء;
        دع نتيجة_الواجهة: نتيجة_بناء_واجهة_قابلة_للإلغاء =
            ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(
                طلب_الواجهة, اختياري.موجود(هدف_الواجهة), &الجذور_المطلوبة,
                &متغير إلغاء_الواجهة
            );
        السياق.الإلغاء := إلغاء_الواجهة;
        طابق نتيجة_الواجهة مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> {
            طابق علم_سياق_التجميع_ملغى(السياق) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
            | اختياري.موجود(الملغى) -> {
                طابق خذ_نتيجة_التجميع(الملغى) مع
                | نتيجة_خذ_نتيجة_التجميع.ملغى(_) -> {
                    أرجع نتيجة_تجميع_مترجم.ملغى();
                }
                | _ -> { أرجع نتيجة_خطأ_سياق_تجميع(); };
            };
        }
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات) -> {
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.فشل_واجهة(التشخيصات)
            );
        }
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
            // A completed Frontend reports only non-fatal diagnostics here.
            ادمج_مجموعة_تشخيصات(التحذيرات, &الواجهة.تشخيصات_الأدوات);
            طابق ثبت_واجهة_التجميع(السياق, الواجهة) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
            | اختياري.موجود(التالي) -> { السياق := التالي; };
        };
    };

    دع الواجهة: نتيجة_واجهة_وحدة;
    طابق خذ_واجهة_التجميع(السياق) مع
    | نتيجة_خذ_واجهة_التجميع.غير_صالح -> {
        أرجع نتيجة_خطأ_سياق_تجميع();
    }
    | نتيجة_خذ_واجهة_التجميع.ناجح(التالي, القيمة) -> {
        السياق := التالي;
        الواجهة := القيمة;
    };

    طابق اخفض_واجهة_وحدة_إلى_مسير(الواجهة) مع
    | نتيجة_خفض_واجهة_مسير.مرفوض(التشخيصات) -> {
        أرجع اختم_سياق_التجميع(
            السياق, نتيجة_تجميع_مترجم.فشل_مسير(التشخيصات)
        );
    }
    | نتيجة_خفض_واجهة_مسير.ناجح(الحمولة) -> {
        طابق ثبت_مسير_التجميع(السياق, الحمولة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
        | اختياري.موجود(التالي) -> { السياق := التالي; };
    };

    دع الحمولة_المخفضة: متغير حمولة_مسير_مخفضة;
    طابق خذ_مسير_التجميع(السياق) مع
    | نتيجة_خذ_مسير_التجميع.غير_صالح -> {
        أرجع نتيجة_خطأ_سياق_تجميع();
    }
    | نتيجة_خذ_مسير_التجميع.ناجح(التالي, الحمولة) -> {
        السياق := التالي;
        الحمولة_المخفضة := الحمولة;
    };

    // Scalar locals kept in places by lowering become SSA values
    // (msir/msir_promotion.sn, LLVM's mem2reg), before the verification below.
    رقّ_محليات_برنامج_مسير(
        &متغير الحمولة_المخفضة.المسير, &الحمولة_المخفضة.الأنواع, &متغير الحمولة_المخفضة.التصحيح
    );

    // The single canonical verified-MSIR boundary. Every consumer — `check`,
    // the interpreter, and Native and LLVM code generation for objects,
    // executables and libraries — receives only a program the canonical
    // verifier accepted, verified exactly once here. (Previously only `check`
    // and the interpreter ran the verifier; code generation consumed lowered
    // MSIR with only the module-initializer restriction checked in lowering.)
    طابق تحقق_برنامج_مسير(&الحمولة_المخفضة.المسير, &الحمولة_المخفضة.الأنواع) مع
    | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> {
        دع التشخيصات: مجموعة_تشخيصات = حول_أخطاء_تحقق_مسير_إلى_تشخيصات(
            &الأخطاء
        );
        أرجع اختم_سياق_التجميع(
            السياق, نتيجة_تجميع_مترجم.فشل_داخلي(التشخيصات)
        );
    }
    | نتيجة_تحقق_مسير.صالح -> { };

    // Fully typed functions are available only after the canonical MSIR
    // handoff. Discharge explicit comptime results before any codegen path.
    دع مسير_وقت_الترجمة: متغير برنامج_مسير;
    دع أنواع_وقت_الترجمة: سجل_أنواع;
    دع مصادر_وقت_الترجمة: خريطة_مصادر;
    دع أصول_وقت_الترجمة: سجل_أصول_مصدر;
    دع تصحيح_وقت_الترجمة: بيانات_تصحيح_مسير;
    طابق الحمولة_المخفضة مع
    | { المسير: مسير, الأنواع: الأنواع, المصادر: المصادر, الأصول: الأصول, التصحيح: التصحيح } -> {
        مسير_وقت_الترجمة := مسير;
        أنواع_وقت_الترجمة := الأنواع;
        مصادر_وقت_الترجمة := المصادر;
        أصول_وقت_الترجمة := الأصول;
        تصحيح_وقت_الترجمة := التصحيح;
    };
    طابق نفذ_طلبات_وقت_الترجمة(
        &متغير مسير_وقت_الترجمة,
        &أنواع_وقت_الترجمة,
        الهدف_المحدد.المعرف
    ) مع
    | اختياري.موجود(الرفض) -> {
        دع التشخيص: متغير تشخيص;
        طابق الرفض مع
        | رفض_وقت_الترجمة.سبب(السبب) -> {
            التشخيص := ابدأ_تشخيصا(
                معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت(), اختياري.لا_شيء()
            );
            دع سجل: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
        }
        | رفض_وقت_الترجمة.فشل_مطلوب(الرسالة) -> {
            // The program's own compile-time failure (CT-03).
            التشخيص := ابدأ_تشخيصا(
                معرف_تشخيص.فشل_وقت_الترجمة_مطلوب(), اختياري.لا_شيء()
            );
            دع سجل_الرسالة: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), من_بايتات(&الرسالة)
            );
        }
        | رفض_وقت_الترجمة.تنسيق(الرمز, المصدر, البداية, النهاية) -> {
            // std.fmt's compile-time check (docs/FMT.md): at the literal, or
            // at the offending position inside it.
            التشخيص := تشخيص_سلسلة_تنسيق(&مصادر_وقت_الترجمة, الرمز, المصدر, البداية, النهاية);
        };
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع اختم_سياق_التجميع(
            السياق, نتيجة_تجميع_مترجم.فشل_مسير(المجموعة)
        );
    }
    | اختياري.لا_شيء -> { };

    دع الحمولة_الجاهزة: حمولة_مسير_مخفضة = {
        المسير: مسير_وقت_الترجمة,
        الأنواع: أنواع_وقت_الترجمة,
        المصادر: مصادر_وقت_الترجمة,
        الأصول: أصول_وقت_الترجمة,
        التصحيح: تصحيح_وقت_الترجمة
    };

    طابق الطلب مع
    | طلب_تجميع_مترجم.تحقق(_) -> {
        أرجع اختم_سياق_التجميع(
            السياق, نتيجة_تجميع_مترجم.تحقق_مكتمل()
        );
    }
    | طلب_تجميع_مترجم.تفسير(_) -> {
        طابق الحمولة_الجاهزة مع
        | {
            المسير: البرنامج,
            الأنواع: الأنواع,
            المصادر: المصادر, الأصول: الأصول, التصحيح: التصحيح
        } -> {
            دع دالة_بدء_البرنامج: اختياري معرف_دالة_مسير =
                معرف_دالة_بدء_برنامج_مسير(&البرنامج);
            طابق دالة_بدء_البرنامج مع
            | اختياري.لا_شيء -> {
                أرجع اختم_سياق_التجميع(
                    السياق, نتيجة_تجميع_مترجم.مدخل_تفسير_غير_متاح()
                );
            }
            | اختياري.موجود(دالة_الدخول) -> {
                دع حجج_الدخول: متجه قيمة_تشغيل = [];
                دع نتيجة_المفسر: نتيجة_تفسير_مسير = فسر_برنامج_مسير(
                    البرنامج,
                    &الأنواع,
                    الهدف_المحدد.المعرف,
                    دالة_الدخول,
                    حجج_الدخول,
                    وسائط_البرنامج
                );
                طابق نتيجة_المفسر مع
                | نتيجة_تفسير_مسير.هدف_غير_متوافق -> {
                    أرجع اختم_سياق_التجميع(
                        السياق, نتيجة_تجميع_مترجم.هدف_تفسير_غير_متوافق()
                    );
                }
                | نتيجة_تفسير_مسير.أخفق(الفشل) -> {
                    دع التشخيصات: مجموعة_تشخيصات = حول_فشل_تفسير_مسير_إلى_تشخيصات(
                        &الفشل, &المصادر, &الأصول, &التصحيح
                    );
                    أرجع اختم_سياق_التجميع(
                        السياق, نتيجة_تجميع_مترجم.فشل_تفسير(التشخيصات)
                    );
                }
                | _ -> {
                    أرجع اختم_سياق_التجميع(
                        السياق, نتيجة_تجميع_مترجم.نتيجة_تفسير(نتيجة_المفسر)
                    );
                };
            };
        };
    }
    | طلب_تجميع_مترجم.كائن(معرف_الهدف, مزود_الخلفية, صيغة_النص) -> {
        دع نص_التجميع: منطقي = صيغة_النص == نص_مخرج_كائن_مترجم.تجميع();
        دع نص_الوحدة_مطلوب: منطقي = صيغة_النص == نص_مخرج_كائن_مترجم.وحدة_إل_إل_في_إم();
        دع الهدف: واصف_هدف = الهدف_المحدد;
        // The target's declared emission capability decides up front: an
        // assembly-output target (NVPTX, XCore) has no binary object form,
        // only assembly text (--emit=asm).
        طابق الهدف.نوع_مخرج_الآلة مع
        | نوع_مخرج_آلة_هدف.كائن -> { }
        | نوع_مخرج_آلة_هدف.تجميع -> {
            لو (!نص_التجميع && !نص_الوحدة_مطلوب) {
                دع فشل_القدرة: فشل_مزود_إل_إل_في_إم = فشل_مزود_إل_إل_في_إم.مخرج_كائن_غير_مدعوم();
                دع تشخيصات_القدرة: مجموعة_تشخيصات =
                    حول_فشل_مزود_إل_إل_في_إم_إلى_تشخيصات(&فشل_القدرة);
                أرجع اختم_سياق_التجميع(
                    السياق, نتيجة_تجميع_مترجم.فشل_خلفية(تشخيصات_القدرة)
                );
            };
        };

        طابق الحمولة_الجاهزة مع
        | {
            المسير: البرنامج,
            الأنواع: الأنواع,
            المصادر: المصادر,
            الأصول: الأصول,
            التصحيح: التصحيح
        } -> {
            دع دالة_بدء_البرنامج: اختياري معرف_دالة_مسير =
                معرف_دالة_بدء_برنامج_مسير(&البرنامج);
            دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
            دع حقائق_الخلفية: سياق_استعلام_اختيار_خلفية =
                أنشئ_سياق_استعلام_اختيار_خلفية(الأنواع);
            دع التخطيط: سجل_تخطيط = سجل_تخطيط_جديد();
            دع حمولة_الخلفية: حمولة_خلفية_تجميع = {
                المسير: المسير,
                حقائق_الخلفية: حقائق_الخلفية,
                المصادر: المصادر,
                الأصول: الأصول,
                التصحيح: التصحيح,
                الهدف: الهدف,
                التخطيط: التخطيط,
                دالة_الدخول: دالة_بدء_البرنامج
            };
            طابق ثبت_خلفية_التجميع(السياق, حمولة_الخلفية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
            | اختياري.موجود(التالي) -> { السياق := التالي; };
        };

        طابق خذ_خلفية_التجميع(السياق) مع
        | نتيجة_خذ_خلفية_التجميع.غير_صالح -> {
            أرجع نتيجة_خطأ_سياق_تجميع();
        }
        | نتيجة_خذ_خلفية_التجميع.ناجح(التالي, حمولة_الخلفية) -> {
            السياق := التالي;
            طابق حمولة_الخلفية مع
            | {
                المسير: المسير,
                حقائق_الخلفية: حقائق_الخلفية,
                المصادر: المصادر,
                الأصول: الأصول,
                التصحيح: التصحيح,
                الهدف: هدف_الخلفية,
                التخطيط: التخطيط,
                دالة_الدخول: دالة_الدخول
            } -> {
                دع مصادر_الإخراج: متغير خريطة_مصادر = المصادر;
                دع سجل_التخطيط: متغير سجل_تخطيط = التخطيط;
                طابق مزود_الخلفية مع
                | هوية_مزود_خلفية.أصلي -> {
                    دع نتيجة_الخلفية: نتيجة_مخرج_أصلي = ابن_مخرج_أصلي(
                        &المسير,
                        &متغير مصادر_الإخراج,
                        &الأصول,
                        &التصحيح,
                        &حقائق_الخلفية,
                        &هدف_الخلفية,
                        &متغير سجل_التخطيط,
                        دالة_الدخول
                    );
                    طابق نتيجة_الخلفية مع
                    | نتيجة_مخرج_أصلي.نجح(البايتات) -> {
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.كائن_مكتمل(البايتات)
                        );
                    }
                    | نتيجة_مخرج_أصلي.أخفق(الفشل) -> {
                        دع التشخيصات: مجموعة_تشخيصات =
                            حول_فشل_مخرج_أصلي_إلى_تشخيصات(&الفشل);
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                        );
                    };
                }
                | هوية_مزود_خلفية.إل_إل_في_إم -> {
                    دع نتيجة_الخلفية: نتيجة_مزود_إل_إل_في_إم =
                        ولد_مخرج_بمزود_إل_إل_في_إم(
                            &المسير,
                            &حقائق_الخلفية,
                            &متغير مصادر_الإخراج,
                            &الأصول,
                            &التصحيح,
                            &هدف_الخلفية,
                            &متغير سجل_التخطيط,
                            &دالة_الدخول,
                            مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي(),
                            سياسة_تموضع_شفرة_إل_إل_في_إم.افتراضية(),
                            نص_الوحدة_مطلوب,
                            خطأ,
                            خطأ,
                            نص_التجميع
                        );
                    طابق نتيجة_الخلفية مع
                    | نتيجة_مزود_إل_إل_في_إم.نجح({ البايتات: _, النوع: _, نص_الوحدة: اختياري.موجود(نص_الوحدة) }) -> {
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.كائن_مكتمل(نص_الوحدة)
                        );
                    }
                    | نتيجة_مزود_إل_إل_في_إم.نجح({ البايتات: بايتات_الناتج, النوع: نوع_الناتج, نص_الوحدة: _ }) -> {
                        // Only a binary object is reported as an object. Previously
                        // assembly text (NVPTX PTX, XCore) was written as an object.
                        طابق نوع_الناتج مع
                        | نوع_ناتج_مزود_إل_إل_في_إم.كائن -> { }
                        | نوع_ناتج_مزود_إل_إل_في_إم.تجميع -> {
                            لو (!نص_التجميع) {
                                دع الفشل_الكائني: فشل_مزود_إل_إل_في_إم =
                                    فشل_مزود_إل_إل_في_إم.مخرج_كائن_غير_مدعوم();
                                دع تشخيصات_المخرج: مجموعة_تشخيصات =
                                    حول_فشل_مزود_إل_إل_في_إم_إلى_تشخيصات(&الفشل_الكائني);
                                أرجع اختم_سياق_التجميع(
                                    السياق, نتيجة_تجميع_مترجم.فشل_خلفية(تشخيصات_المخرج)
                                );
                            };
                        };
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.كائن_مكتمل(بايتات_الناتج)
                        );
                    }
                    | نتيجة_مزود_إل_إل_في_إم.خطأ(الفشل) -> {
                        دع التشخيصات: مجموعة_تشخيصات =
                            حول_فشل_مزود_إل_إل_في_إم_إلى_تشخيصات(&الفشل);
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                        );
                    };
                };
            };
        };
    }
    | طلب_تجميع_مترجم.ربط(
        معرف_الهدف,
        مزود_الخلفية,
        نوع_المخرج,
        مدخلات_الربط,
        اسم_المخرج_الديناميكي
    ) -> {
        دع الهدف: واصف_هدف = الهدف_المحدد;

        دع نوع_خطة_الربط: نوع_خرج_ربط =
            نوع_خطة_ربط_من_طلب_مترجم(نوع_المخرج);
        دع ربط_خارجي: منطقي = مخرج_تنفيذي_لربط(نوع_المخرج)
            && يستخدم_رابط_إلف_خارجي(&الهدف);
        لو (!يدعم_مزود_الربط(&الهدف, نوع_خطة_الربط) && !ربط_خارجي) {
            دع خطأ_الربط: خطأ_ربط = خطأ_ربط.خرج_هدف_غير_مدعوم(
                الهدف.المعرف,
                نوع_خطة_الربط
            );
            دع التشخيصات: مجموعة_تشخيصات =
                حول_خطأ_ربط_إلى_تشخيصات(&خطأ_الربط);
            أرجع اختم_سياق_التجميع(
                السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
            );
        };

        طابق الحمولة_الجاهزة مع
        | {
            المسير: البرنامج,
            الأنواع: الأنواع,
            المصادر: المصادر,
            الأصول: الأصول,
            التصحيح: التصحيح
        } -> {
            دع دالة_بدء_البرنامج: اختياري معرف_دالة_مسير =
                معرف_دالة_بدء_برنامج_مسير(&البرنامج);
            // An executable needs the program's entry function. Its absence is
            // the user's missing entry point, reported before the linker
            // looks for the target's entry symbol.
            لو (مخرج_تنفيذي_لربط(نوع_المخرج)) {
                طابق دالة_بدء_البرنامج مع
                | اختياري.لا_شيء -> {
                    أرجع اختم_سياق_التجميع(
                        السياق, نتيجة_تجميع_مترجم.فشل_مسير(تشخيصات_نقطة_دخول_مفقودة())
                    );
                }
                | اختياري.موجود(_) -> { };
            };
            دع المسير: سياق_مستهلك_مسير = أنشئ_سياق_مستهلك_مسير(البرنامج);
            دع حقائق_الخلفية: سياق_استعلام_اختيار_خلفية =
                أنشئ_سياق_استعلام_اختيار_خلفية(الأنواع);
            دع التخطيط: سجل_تخطيط = سجل_تخطيط_جديد();
            دع حمولة_الخلفية: حمولة_خلفية_تجميع = {
                المسير: المسير,
                حقائق_الخلفية: حقائق_الخلفية,
                المصادر: المصادر,
                الأصول: الأصول,
                التصحيح: التصحيح,
                الهدف: الهدف,
                التخطيط: التخطيط,
                دالة_الدخول: دالة_بدء_البرنامج
            };
            طابق ثبت_خلفية_التجميع(السياق, حمولة_الخلفية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_خطأ_سياق_تجميع(); }
            | اختياري.موجود(التالي) -> { السياق := التالي; };
        };

        طابق خذ_خلفية_التجميع(السياق) مع
        | نتيجة_خذ_خلفية_التجميع.غير_صالح -> {
            أرجع نتيجة_خطأ_سياق_تجميع();
        }
        | نتيجة_خذ_خلفية_التجميع.ناجح(التالي, حمولة_الخلفية) -> {
            السياق := التالي;
            طابق حمولة_الخلفية مع
            | {
                المسير: المسير,
                حقائق_الخلفية: حقائق_الخلفية,
                المصادر: المصادر,
                الأصول: الأصول,
                التصحيح: التصحيح,
                الهدف: هدف_الخلفية,
                التخطيط: التخطيط,
                دالة_الدخول: دالة_الدخول
            } -> {
                دع مصادر_الإخراج: متغير خريطة_مصادر = المصادر;
                دع سجل_التخطيط: متغير سجل_تخطيط = التخطيط;
                دع بايتات_الكائن: متجه ط8;
                طابق مزود_الخلفية مع
                | هوية_مزود_خلفية.أصلي -> {
                    طابق ابن_كائن_أصلي_للربط(
                        &المسير,
                        &متغير مصادر_الإخراج,
                        &الأصول,
                        &التصحيح,
                        &حقائق_الخلفية,
                        &هدف_الخلفية,
                        &متغير سجل_التخطيط,
                        دالة_الدخول,
                        مخرج_تنفيذي_لربط(نوع_المخرج),
                        مخرج_مستقل_الموضع_لربط(نوع_المخرج)
                    ) مع
                    | نتيجة_مخرج_أصلي_مفصل.نجح({ البايتات: بايتات_الناتج }) -> {
                        بايتات_الكائن := بايتات_الناتج;
                    }
                    | نتيجة_مخرج_أصلي_مفصل.أخفق(الفشل) -> {
                        دع التشخيصات: مجموعة_تشخيصات =
                            حول_فشل_مخرج_أصلي_إلى_تشخيصات(&الفشل);
                        أرجع اختم_سياق_التجميع(
                            السياق,
                            نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                        );
                    };
                }
                | هوية_مزود_خلفية.إل_إل_في_إم -> {
                    دع نتيجة_الخلفية: نتيجة_مزود_إل_إل_في_إم =
                        ولد_مخرج_بمزود_إل_إل_في_إم(
                            &المسير,
                            &حقائق_الخلفية,
                            &متغير مصادر_الإخراج,
                            &الأصول,
                            &التصحيح,
                            &هدف_الخلفية,
                            &متغير سجل_التخطيط,
                            &دالة_الدخول,
                            مستوى_تحسين_مزود_إل_إل_في_إم.افتراضي(),
                            سياسة_تموضع_إل_إل_في_إم_لربط(
                                نوع_المخرج,
                                &هدف_الخلفية
                            ),
                            خطأ,
                            بدء_عملية_ذاتي_لربط(نوع_المخرج, &هدف_الخلفية),
                            مخرج_تنفيذي_لربط(نوع_المخرج),
                            خطأ
                        );
                    طابق نتيجة_الخلفية مع
                    | نتيجة_مزود_إل_إل_في_إم.نجح({ البايتات: بايتات_الناتج, النوع: نوع_الناتج, نص_الوحدة: _ }) -> {
                        طابق نوع_الناتج مع
                        | نوع_ناتج_مزود_إل_إل_في_إم.كائن -> {
                            بايتات_الكائن := بايتات_الناتج;
                        }
                        | نوع_ناتج_مزود_إل_إل_في_إم.تجميع -> {
                            دع خطأ_الربط: خطأ_ربط =
                                خطأ_ربط.خرج_هدف_غير_مدعوم(
                                    هدف_الخلفية.المعرف,
                                    نوع_خطة_الربط
                                );
                            دع التشخيصات: مجموعة_تشخيصات =
                                حول_خطأ_ربط_إلى_تشخيصات(&خطأ_الربط);
                            أرجع اختم_سياق_التجميع(
                                السياق,
                                نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                            );
                        };
                    }
                    | نتيجة_مزود_إل_إل_في_إم.خطأ(الفشل) -> {
                        دع التشخيصات: مجموعة_تشخيصات =
                            حول_فشل_مزود_إل_إل_في_إم_إلى_تشخيصات(&الفشل);
                        أرجع اختم_سياق_التجميع(
                            السياق,
                            نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                        );
                    };
                };

                لو (ربط_خارجي) {
                    طابق اربط_برابط_خارجي(&بايتات_الكائن, &مدخلات_الربط) مع
                    | نتيجة_ربط_خارجي.نجح(البايتات) -> {
                        أرجع اختم_سياق_التجميع(
                            السياق,
                            نتيجة_ربط_مترجم_مكتملة(نوع_المخرج, البايتات)
                        );
                    }
                    | _ -> {
                        دع خطأ_الربط: خطأ_ربط = خطأ_ربط.خرج_هدف_غير_مدعوم(
                            هدف_الخلفية.المعرف,
                            نوع_خطة_الربط
                        );
                        دع التشخيصات: مجموعة_تشخيصات =
                            حول_خطأ_ربط_إلى_تشخيصات(&خطأ_الربط);
                        أرجع اختم_سياق_التجميع(
                            السياق, نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                        );
                    };
                };
                دع طلب_الربط: متغير طلب_ربط = جهز_طلب_ربط_بنوع(
                    بايتات_الكائن,
                    &هدف_الخلفية,
                    نوع_خطة_الربط
                );
                ثبت_مكتبة_إل_إل_في_إم_المضيف_في_خطة_السياق(
                    &متغير طلب_الربط.الخطة
                );
                ثبت_الاستيرادات_المصرحة_في_خطة_السياق(
                    &متغير طلب_الربط.الخطة, &المسير
                );
                طابق اسم_المخرج_الديناميكي مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الاسم) -> {
                    دع بايتات_الاسم: متجه ط8 = بايتات_نص_ربط_مترجم(&الاسم);
                    ثبت_اسم_مخرج_ديناميكي_في_خطة_ربط(
                        &متغير طلب_الربط.الخطة,
                        بايتات_الاسم
                    );
                };
                طابق أضف_مدخلات_ربط_ملفات(
                    &متغير طلب_الربط.الخطة,
                    &مدخلات_الربط,
                    هدف_الخلفية.صيغة_الكائن == صيغة_كائن_هدف.إلف()
                ) مع
                | نتيجة_إضافة_مدخلات_ربط_ملفات.نجح -> { }
                | نتيجة_إضافة_مدخلات_ربط_ملفات.خطأ(المسار, الحالة) -> {
                    دع خطأ_الربط: خطأ_ربط =
                        خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, الحالة);
                    دع التشخيصات: مجموعة_تشخيصات =
                        حول_خطأ_ربط_إلى_تشخيصات(&خطأ_الربط);
                    أرجع اختم_سياق_التجميع(
                        السياق,
                        نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                    );
                }
                | نتيجة_إضافة_مدخلات_ربط_ملفات.سكربت_غير_مدعوم(المسار, الأمر) -> {
                    // The script's path and the command SultanC cannot apply
                    // (link/diagnostic_translation.sn).
                    دع خطأ_الربط: خطأ_ربط =
                        خطأ_ربط.سكربت_جنو_غير_مدعوم(المسار, الأمر);
                    دع التشخيصات: مجموعة_تشخيصات =
                        حول_خطأ_ربط_إلى_تشخيصات(&خطأ_الربط);
                    أرجع اختم_سياق_التجميع(
                        السياق,
                        نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                    );
                };
                طابق اربط(طلب_الربط) مع
                | نتيجة_ربط.نجح(البايتات) -> {
                    أرجع اختم_سياق_التجميع(
                        السياق,
                        نتيجة_ربط_مترجم_مكتملة(نوع_المخرج, البايتات)
                    );
                }
                | نتيجة_ربط.خطأ(الخطأ) -> {
                    دع التشخيصات: مجموعة_تشخيصات =
                        حول_خطأ_ربط_إلى_تشخيصات(&الخطأ);
                    أرجع اختم_سياق_التجميع(
                        السياق,
                        نتيجة_تجميع_مترجم.فشل_خلفية(التشخيصات)
                    );
                };
            };
        };
    };
}

// Environment compilation remains an adapter into the one context-driven pipeline.
عام عرف نفذ_تجميع_مترجم_في_بيئة(
    البيئة: بيئة_وحدات_منطقية,
    المفتاح_الجذري: مفتاح_وحدة_مقنن,
    الطلب: طلب_تجميع_مترجم
): نتيجة_تجميع_مترجم {
    دع المفاتيح_المباشرة: متجه مفتاح_وحدة_مقنن = [];
    دع الإعداد: إعداد_تجميع_مباشر = {
        البيئة: البيئة,
        المفتاح_الجذري: المفتاح_الجذري,
        المفاتيح_المباشرة: المفاتيح_المباشرة
    };
    دع السياق: سياق_التجميع = أنشئ_سياق_التجميع(الإعداد);
    دع وسائط_فارغة: متجه متجه ط8 = [];
    دع التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أرجع نفذ_سياق_تجميع(السياق, الطلب, وسائط_فارغة, &متغير التحذيرات);
}

// The words of the program's runtime failures (driver/program_failure_text.sn)
// become the text of the std module process.failure_text for this
// compilation, with the language the program is compiled with.
عرف ضع_كلمات_فشل_البرنامج(البيئة: &متغير بيئة_وحدات_منطقية, اللغة: لغة_تشخيص): فراغ {
    طابق جذر_قياسي_موثوق_لبيئة(البيئة) مع
    | اختياري.موجود(الجذر) -> {
        طابق جذر_مصدر_لمعرف(البيئة, الجذر) مع
        | اختياري.موجود(جذر_المصدر) -> {
            دع المسار_المنطقي: نص = «process/failure_text.sn»;
            دع المسار: نص = صل_المسار(&جذر_المصدر, &المسار_المنطقي);
            ضع_تراكب_مصدر_في_البيئة(البيئة, المسار, نص_وحدة_كلمات_فشل_البرنامج(اللغة));
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
}

// A --module-source binding that cannot be honored is a setup failure of the
// request, reported before the Frontend loads any module.
عرف تشخيصات_ربط_مصدر_وحدة(
    المعرف: معرف_تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    دع أضف_قيمة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, المفتاح, القيمة);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}

// Direct source setup is shared by compilation and interpretation. Guest argv
// stays outside the compilation request identity and is consumed only by the
// interpreter branch after canonical MSIR verification.
عرف نفذ_طلب_مترجم_بوسائط(
    مسار_ملف_الدخول: نص,
    مسارات_ملفات_المصدر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الطلب: طلب_تجميع_مترجم,
    وسائط_البرنامج: متجه متجه ط8,
    لغة_البرنامج: لغة_تشخيص,
    التحذيرات: &متغير مجموعة_تشخيصات
): نتيجة_تجميع_مترجم {
    // A missing entry file is named before module loading turns it into an
    // unreadable module without a path.
    طابق موجود(&مسار_ملف_الدخول) مع
    | نتيجة.نجح(الحالة) -> {
        لو (!الحالة) {
            دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
                معرف_تشخيص.ملف_إدخال_مفقود(), اختياري.لا_شيء()
            );
            دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
                &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), انسخ_نص(&مسار_ملف_الدخول)
            );
            دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
            أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
            أرجع نتيجة_تجميع_مترجم.فشل_إعداد(المجموعة);
        };
    }
    | نتيجة.خطأ(_) -> { };
    طابق ابن_إعداد_تجميع_مباشر_مفصل(
        &مسار_ملف_الدخول,
        &مسارات_ملفات_المصدر_الإضافية
    ) مع
    | نتيجة_إعداد_تجميع_مباشر_مفصلة.مدخل_غير_صالح -> {
        // An existing file whose path cannot name a module (a directory such
        // as `my-project`) is not a missing file.
        دع موجود_فعلا: متغير منطقي = خطأ;
        طابق موجود(&مسار_ملف_الدخول) مع
        | نتيجة.نجح(الحالة) -> { موجود_فعلا := الحالة; }
        | نتيجة.خطأ(_) -> { };
        دع معرف_الخطأ: متغير معرف_تشخيص = معرف_تشخيص.ملف_إدخال_مفقود();
        لو (موجود_فعلا) { معرف_الخطأ := معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح(); };
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_الخطأ, اختياري.لا_شيء());
        لو (موجود_فعلا) {
            دع أضف_السبب: منطقي = أضف_سبب_تشخيص(
                &متغير التشخيص, سبب_تشخيص.سبب_وحدة_مسار_ملف_ليس_اسم_وحدة()
            );
        };
        دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), مسار_ملف_الدخول
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع نتيجة_تجميع_مترجم.فشل_إعداد(المجموعة);
    }
    | نتيجة_إعداد_تجميع_مباشر_مفصلة.بيان_غير_صالح(الخطأ) -> {
        دع مرجع_مسار_الخطأ: &نص = &الخطأ.المسار;
        دع مسار_الخطأ: نص = انسخ_نص(مرجع_مسار_الخطأ);
        دع سبب_الخطأ: مفتاح_نص_مترجم = الخطأ.السبب;
        دع إزاحة_الخطأ: طبيعي = الخطأ.الإزاحة;
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.بيان_حزمة_غير_صالح(), اختياري.لا_شيء()
        );
        دع أضف_مسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المسار(), مسار_الخطأ
        );
        دع أضف_موضع: منطقي = أضف_حجة_طبيعية(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), إزاحة_الخطأ
        );
        // The manifest reason is a typed iSpeak key.
        دع أضف_سبب: منطقي = أضف_نص_مترجم_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), سبب_الخطأ
        );
        دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        أرجع نتيجة_تجميع_مترجم.فشل_إعداد(المجموعة);
    }
    | نتيجة_إعداد_تجميع_مباشر_مفصلة.جاهز(الإعداد_المعد) -> {
        طابق الإعداد_المعد مع
        | {
            البيئة: البيئة_المعدة,
            المفتاح_الجذري: المفتاح_الجذري,
            المفاتيح_المباشرة: المفاتيح_المباشرة
        } -> {
            دع البيئة: متغير بيئة_وحدات_منطقية = البيئة_المعدة;
            طابق اربط_مصادر_وحدات_صريحة(
                &متغير البيئة, &المفتاح_الجذري, &روابط_المصادر
            ) مع
            | نتيجة_ربط_مصادر_وحدات.نجح -> { }
            | نتيجة_ربط_مصادر_وحدات.وحدة_غير_موجودة(الوحدة) -> {
                أرجع نتيجة_تجميع_مترجم.فشل_إعداد(تشخيصات_ربط_مصدر_وحدة(
                    معرف_تشخيص.وحدة_مصدر_غير_موجودة(), مفتاح_حجة_تشخيص.المسار(), الوحدة
                ));
            }
            | نتيجة_ربط_مصادر_وحدات.مصدر_غير_مقروء(المسار) -> {
                أرجع نتيجة_تجميع_مترجم.فشل_إعداد(تشخيصات_ربط_مصدر_وحدة(
                    معرف_تشخيص.ملف_إدخال_مفقود(), مفتاح_حجة_تشخيص.المسار(), المسار
                ));
            }
            | نتيجة_ربط_مصادر_وحدات.نوع_مصدر_غير_معروف(المسار) -> {
                أرجع نتيجة_تجميع_مترجم.فشل_إعداد(تشخيصات_ربط_مصدر_وحدة(
                    معرف_تشخيص.نوع_ملف_إدخال_غير_معروف(), مفتاح_حجة_تشخيص.المسار(), المسار
                ));
            }
            | نتيجة_ربط_مصادر_وحدات.تعارض(الوحدة) -> {
                أرجع نتيجة_تجميع_مترجم.فشل_إعداد(تشخيصات_ربط_مصدر_وحدة(
                    معرف_تشخيص.تعارض_مصدر_وحدة(), مفتاح_حجة_تشخيص.المسار(), الوحدة
                ));
            };
            ضع_كلمات_فشل_البرنامج(&متغير البيئة, لغة_البرنامج);
            دع الإعداد: إعداد_تجميع_مباشر = {
                البيئة: البيئة,
                المفتاح_الجذري: المفتاح_الجذري,
                المفاتيح_المباشرة: المفاتيح_المباشرة
            };
            دع السياق: سياق_التجميع = أنشئ_سياق_التجميع(الإعداد);
            أرجع نفذ_سياق_تجميع(السياق, الطلب, وسائط_البرنامج, التحذيرات);
        };
    };
}

عام عرف نفذ_طلب_تجميع_مترجم(
    مسار_ملف_الدخول: نص,
    مسارات_ملفات_المصدر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الطلب: طلب_تجميع_مترجم
): نتيجة_تجميع_مترجم {
    دع التحذيرات: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أرجع نفذ_طلب_تجميع_مترجم_بتحذيرات(
        مسار_ملف_الدخول, مسارات_ملفات_المصدر_الإضافية, روابط_المصادر, الطلب,
        لغة_تشخيص.العربية(), &متغير التحذيرات
    );
}

// The same request; diagnostics that did not stop it (warnings) are added to
// `التحذيرات` for the caller to show.
عام عرف نفذ_طلب_تجميع_مترجم_بتحذيرات(
    مسار_ملف_الدخول: نص,
    مسارات_ملفات_المصدر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    الطلب: طلب_تجميع_مترجم,
    لغة_البرنامج: لغة_تشخيص,
    التحذيرات: &متغير مجموعة_تشخيصات
): نتيجة_تجميع_مترجم {
    دع وسائط_فارغة: متجه متجه ط8 = [];
    أرجع نفذ_طلب_مترجم_بوسائط(
        مسار_ملف_الدخول,
        مسارات_ملفات_المصدر_الإضافية,
        روابط_المصادر,
        الطلب,
        وسائط_فارغة,
        لغة_البرنامج,
        التحذيرات
    );
}

عام عرف نفذ_طلب_تفسير_مترجم(
    مسار_ملف_الدخول: نص,
    مسارات_ملفات_المصدر_الإضافية: متجه نص,
    روابط_المصادر: متجه ربط_مصدر_وحدة_عملية,
    معرف_الهدف: معرف_هدف,
    وسائط_البرنامج: متجه متجه ط8,
    لغة_البرنامج: لغة_تشخيص,
    التحذيرات: &متغير مجموعة_تشخيصات
): نتيجة_تجميع_مترجم {
    أرجع نفذ_طلب_مترجم_بوسائط(
        مسار_ملف_الدخول,
        مسارات_ملفات_المصدر_الإضافية,
        روابط_المصادر,
        طلب_تجميع_مترجم.تفسير(معرف_الهدف),
        وسائط_البرنامج,
        لغة_البرنامج,
        التحذيرات
    );
}
