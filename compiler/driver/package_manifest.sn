استورد std.toml.parser;
استورد compiler.frontend.lexer.identifier_queries;
استورد compiler.source.source_kind;
استورد std.fs.read_file;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.ispeak.keys.surface;

// Typed package metadata consumed by Driver. The TOML document is retained so
// descriptive/package.metadata data is not lost even when it has no compiler
// behavior in this import correction.
عام نوع تهجئة_اسم_حزمة = {
    اللغة: نص,
    التهجئة: نص
};

عام نوع تهجئة_استيراد_حزمة = {
    اللغة: نص,
    المسار: نص
};

عام نوع ربط_استيراد_حزمة = {
    المسار_المقنن: نص,
    التهجئات: متجه تهجئة_استيراد_حزمة
};

عام نوع اعتماد_مسار_حزمة = {
    الاسم: نص,
    المسار: نص
};

عام نوع إعداد_بيان_حزمة = {
    مسار_البيان: نص,
    دليل_البيان: نص,
    الاسم: نص,
    الإصدار: اختياري نص,
    المؤلفون: متجه نص,
    الوصف: اختياري نص,
    الصفحة_الرئيسية: اختياري نص,
    المستودع: اختياري نص,
    القراءة: اختياري نص,
    الكلمات_المفتاحية: متجه نص,
    الرخصة: اختياري نص,
    الأسماء: متجه تهجئة_اسم_حزمة,
    روابط_الاستيراد: متجه ربط_استيراد_حزمة,
    مسار_المكتبة: اختياري نص,
    مدخل_المكتبة: اختياري نص,
    الاعتمادات: متجه اعتماد_مسار_حزمة,
    الوثيقة: وثيقة_تومل
};

عام نوع خطأ_بيان_حزمة = {
    المسار: نص,
    الإزاحة: طبيعي,
    السبب: مفتاح_نص_مترجم
};

عام نوع نتيجة_قراءة_بيان_حزمة =
    | جاهز بنوع إعداد_بيان_حزمة
    | خطأ بنوع خطأ_بيان_حزمة
;

عام نوع نتيجة_اكتشاف_بيان_حزمة =
    | غير_موجود
    | موجود بنوع نص
    | خطأ بنوع خطأ_بيان_حزمة
;

عرف خطأ_بيان(
    المسار: &نص,
    الإزاحة: طبيعي,
    السبب: مفتاح_نص_مترجم
): خطأ_بيان_حزمة {
    دع الخطأ: خطأ_بيان_حزمة = { المسار: انسخ_نص(المسار), الإزاحة: الإزاحة, السبب: السبب };
    أرجع الخطأ;
}

عرف نص_يساوي_بيانا(الأول: &نص, الثاني: نص): منطقي {
    دع ب: نص = الثاني;
    أرجع نصان_متساويان(الأول, &ب);
}

عرف قيمة_نص_تومل(القيمة: &قيمة_تومل): اختياري نص {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف انسخ_اختيار_نص_بيان(القيمة: &اختياري نص): اختياري نص {
    طابق *القيمة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النص) -> { أرجع اختياري.موجود(انسخ_نص(&النص)); };
}

عرف قيمة_جدول_تومل(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.جدول(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_مصفوفة_تومل(القيمة: &قيمة_تومل): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_تومل.مصفوفة(الفهرس) -> { أرجع اختياري.موجود(الفهرس); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف موقع_مدخل_تومل_في_جدول(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: &نص
): طبيعي {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        لو (نصان_متساويان(&المداخل[ف].المفتاح, المفتاح)) { أرجع المداخل[ف].الإزاحة; };
        ف := ف + 1;
    }
    أرجع 0;
}

عرف نص_مفتاح_مطلوب(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص,
    المسار: &نص
): نتيجة نص, خطأ_بيان_حزمة {
    دع اسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &اسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.حقل_بيان_مطلوب_مفقود()));
    }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_نص_تومل(&القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &اسم), مفتاح_نص_مترجم.حقل_بيان_ليس_نصا()
            ));
        }
        | اختياري.موجود(النص) -> { أرجع نتيجة.نجح(النص); };
    };
}

عرف قيمة_اختيارية_موجودة(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص
): منطقي {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { أرجع صواب; };
}

عرف تحقق_مصفوفة_نصوص_اختيارية(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص,
    المسار: &نص
): اختياري خطأ_بيان_حزمة {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_مصفوفة_تومل(&القيمة) مع
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), مفتاح_نص_مترجم.حقل_بيان_ليس_مصفوفة_نصوص()
            ));
        }
        | اختياري.موجود(الفهرس) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القيم) مثل طبيعي)) {
                طابق قيمة_نص_تومل(&القيم[ف]) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_بيان(
                        المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), مفتاح_نص_مترجم.مصفوفة_بيان_بعنصر_غير_نصي()
                    ));
                };
                ف := ف + 1;
            }
        };
    };
    أرجع اختياري.لا_شيء();
}

عرف تحقق_نص_اختياري(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص,
    المسار: &نص
): اختياري خطأ_بيان_حزمة {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_نص_تومل(&القيمة) مع
        | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), مفتاح_نص_مترجم.حقل_بيان_ليس_نصا()
            ));
        };
    };
}

عرف اقرأ_نص_اختياري_بيان(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص
): اختياري نص {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع قيمة_نص_تومل(&القيمة); };
}

عرف اقرأ_مصفوفة_نصوص_بيان(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المفتاح: نص
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(القيمة) -> {
        طابق قيمة_مصفوفة_تومل(&القيمة) مع
        | اختياري.لا_شيء -> { أرجع الناتج; }
        | اختياري.موجود(الفهرس) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القيم) مثل طبيعي)) {
                طابق قيمة_نص_تومل(&القيم[ف]) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(النص) -> { ألحق(الناتج, النص); };
                ف := ف + 1;
            }
        };
    };
    أرجع الناتج;
}

عرف مسار_استيراد_من_نص_بيان(النص: &نص): اختياري نص {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع الجزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        لو (!نهاية) {
            دع ب: ط8 = القيمة[ف];
            لو ((ب == 0x2F) || (ب == 0x5C) || (ب == 0)) { أرجع اختياري.لا_شيء(); };
            نهاية := ب == 0x2E;
        };
        لو (نهاية) {
            لو ((الطول(الجزء) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
            دع اسم_الجزء: نص = من_بايتات(&الجزء);
            لو (!تهجئة_معرف_مصدر_صالحة(&اسم_الجزء)) { أرجع اختياري.لا_شيء(); };
            لو ((الطول(الناتج) مثل طبيعي) > 0) { ألحق(الناتج, 0x2F); };
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(الجزء) مثل طبيعي)) { ألحق(الناتج, الجزء[ح]); ح := ح + 1; }
            دع جزء_فارغ: متجه ط8 = [];
            الجزء := جزء_فارغ;
        } وإلا {
            ألحق(الجزء, القيمة[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(من_بايتات(&الناتج));
}

عرف تهجئة_جذر_بيان_صالحة(النص: &نص): منطقي {
    أرجع تهجئة_معرف_مصدر_صالحة(النص);
}

عرف جدول_فارغ_تومل(الوثيقة: &وثيقة_تومل, الفهرس: طبيعي): منطقي {
    أرجع (الطول(مداخل_جدول_تومل(الوثيقة, الفهرس)) مثل طبيعي) == 0;
}

عرف تحقق_حقول_الحزمة(
    الوثيقة: &وثيقة_تومل,
    الجدول: طبيعي,
    المسار: &نص
): اختياري خطأ_بيان_حزمة {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        دع مسموح: منطقي = نص_يساوي_بيانا(المفتاح, «name»)
            || نص_يساوي_بيانا(المفتاح, «version»)
            || نص_يساوي_بيانا(المفتاح, «authors»)
            || نص_يساوي_بيانا(المفتاح, «description»)
            || نص_يساوي_بيانا(المفتاح, «homepage»)
            || نص_يساوي_بيانا(المفتاح, «repository»)
            || نص_يساوي_بيانا(المفتاح, «readme»)
            || نص_يساوي_بيانا(المفتاح, «keywords»)
            || نص_يساوي_بيانا(المفتاح, «license»)
            || نص_يساوي_بيانا(المفتاح, «names»)
            || نص_يساوي_بيانا(المفتاح, «metadata»);
        لو (!مسموح) {
            لو (نص_يساوي_بيانا(المفتاح, «edition») || نص_يساوي_بيانا(المفتاح, «sultanc-version») || نص_يساوي_بيانا(المفتاح, «build»)) {
                أرجع اختياري.موجود(خطأ_بيان(المسار, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.إعداد_بيان_معروف_غير_مدعوم()));
            };
            أرجع اختياري.موجود(خطأ_بيان(المسار, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.حقل_بيان_غير_معروف()));
        };
        ف := ف + 1;
    }

    دع نصوص: متجه نص = [«version», «description», «homepage», «repository», «readme», «license»];
    ف := 0;
    طالما (ف < (الطول(نصوص) مثل طبيعي)) {
        دع مرجع_مفتاح_النص: &نص = &نصوص[ف];
        دع مفتاح_النص: نص = انسخ_نص(مرجع_مفتاح_النص);
        طابق تحقق_نص_اختياري(الوثيقة, الجدول, مفتاح_النص, المسار) مع
        | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق تحقق_مصفوفة_نصوص_اختيارية(الوثيقة, الجدول, «authors», المسار) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    طابق تحقق_مصفوفة_نصوص_اختيارية(الوثيقة, الجدول, «keywords», المسار) مع
    | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_أسماء_الحزمة(
    الوثيقة: &وثيقة_تومل,
    جدول_الحزمة: طبيعي,
    المسار: &نص
): نتيجة متجه تهجئة_اسم_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه تهجئة_اسم_حزمة = [];
    دع مفتاح: نص = «names»;
    طابق جدول_مفتاح_تومل(الوثيقة, جدول_الحزمة, &مفتاح) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختياري.موجود(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع مرجع_اللغة: &نص = &(*مرجع_المدخل).المفتاح;
            دع اللغة: نص = انسخ_نص(مرجع_اللغة);
            دع الإزاحة: طبيعي = (*مرجع_المدخل).الإزاحة;
            لو ((الطول(اللغة) مثل طبيعي) == 0) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.تسمية_لغة_حزمة_فارغة()));
            };
            طابق قيمة_نص_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.قيم_أسماء_حزمة_غير_نصية()));
            }
            | اختياري.موجود(التهجئة) -> {
                لو (!تهجئة_جذر_بيان_صالحة(&التهجئة)) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة()));
                };
                دع الاسم: تهجئة_اسم_حزمة = { اللغة: اللغة, التهجئة: التهجئة };
                ألحق(الناتج, الاسم);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_روابط_الاستيراد(
    الوثيقة: &وثيقة_تومل,
    الجذر: طبيعي,
    المسار: &نص
): نتيجة متجه ربط_استيراد_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه ربط_استيراد_حزمة = [];
    دع مفتاح: نص = «imports-alias»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختياري.موجود(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع الإزاحة: طبيعي = (*مرجع_المدخل).الإزاحة;
            دع المقنن: نص;
            طابق مسار_استيراد_من_نص_بيان(&(*مرجع_المدخل).المفتاح) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.مفتاح_مرادف_استيراد_غير_صالح()));
            }
            | اختياري.موجود(القيمة) -> { المقنن := القيمة; };
            دع جدول_اللغات: طبيعي;
            طابق قيمة_جدول_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.قيمة_مرادف_استيراد_ليست_خريطة()));
            }
            | اختياري.موجود(القيمة) -> { جدول_اللغات := القيمة; };
            دع تهجئات: متغير متجه تهجئة_استيراد_حزمة = [];
            دع اللغات: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_اللغات);
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول(اللغات) مثل طبيعي)) {
                دع مرجع_اللغة_المدخل: &مدخل_جدول_تومل = &اللغات[ح];
                دع مرجع_اللغة: &نص = &(*مرجع_اللغة_المدخل).المفتاح;
                دع اللغة: نص = انسخ_نص(مرجع_اللغة);
                دع إزاحة_اللغة: طبيعي = (*مرجع_اللغة_المدخل).الإزاحة;
                لو ((الطول(اللغة) مثل طبيعي) == 0) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, مفتاح_نص_مترجم.تسمية_لغة_مرادف_فارغة()));
                };
                طابق قيمة_نص_تومل(&(*مرجع_اللغة_المدخل).القيمة) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, مفتاح_نص_مترجم.قيم_لغة_مرادف_غير_نصية()));
                }
                | اختياري.موجود(التهجئة_النصية) -> {
                    طابق مسار_استيراد_من_نص_بيان(&التهجئة_النصية) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, مفتاح_نص_مترجم.تهجئة_مرادف_استيراد_غير_صالحة()));
                    }
                    | اختياري.موجود(التهجئة) -> {
                        دع الاسم: تهجئة_استيراد_حزمة = { اللغة: اللغة, المسار: التهجئة };
                        ألحق(تهجئات, الاسم);
                    };
                };
                ح := ح + 1;
            }
            دع الربط: ربط_استيراد_حزمة = { المسار_المقنن: المقنن, التهجئات: تهجئات };
            ألحق(الناتج, الربط);
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_الاعتمادات(
    الوثيقة: &وثيقة_تومل,
    الجذر: طبيعي,
    الدليل: &نص,
    المسار: &نص
): نتيجة متجه اعتماد_مسار_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه اعتماد_مسار_حزمة = [];
    دع مفتاح: نص = «dependencies»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختياري.موجود(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع مرجع_اسم_الاعتماد: &نص = &(*مرجع_المدخل).المفتاح;
            دع اسم_الاعتماد: نص = انسخ_نص(مرجع_اسم_الاعتماد);
            دع الإزاحة: طبيعي = (*مرجع_المدخل).الإزاحة;
            لو (!تهجئة_جذر_بيان_صالحة(&اسم_الاعتماد)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.مفتاح_اعتمادية_غير_صالح()));
            };
            دع جدول_الاعتماد: طبيعي;
            طابق قيمة_جدول_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.اعتمادية_غير_محلية()));
            }
            | اختياري.موجود(القيمة) -> { جدول_الاعتماد := القيمة; };
            دع مداخل_الاعتماد: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_الاعتماد);
            لو ((الطول(مداخل_الاعتماد) مثل طبيعي) != 1 || !نص_يساوي_بيانا(&مداخل_الاعتماد[0].المفتاح, «path»)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, مفتاح_نص_مترجم.حقل_اعتمادية_غير_المسار()));
            };
            طابق قيمة_نص_تومل(&مداخل_الاعتماد[0].القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل_الاعتماد[0].الإزاحة, مفتاح_نص_مترجم.مسار_اعتمادية_غير_نصي()));
            }
            | اختياري.موجود(المسار_النسبي) -> {
                لو (مسار_مطلق(&المسار_النسبي)) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل_الاعتماد[0].الإزاحة, مفتاح_نص_مترجم.مسار_اعتمادية_غير_نسبي()));
                };
                دع المحلول: نص = صل_المسار(الدليل, &المسار_النسبي);
                دع الاعتماد: اعتماد_مسار_حزمة = { الاسم: اسم_الاعتماد, المسار: المحلول };
                ألحق(الناتج, الاعتماد);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_مسار_المكتبة(
    الوثيقة: &وثيقة_تومل,
    الجذر: طبيعي,
    الدليل: &نص,
    المسار: &نص
): نتيجة اختياري نص, خطأ_بيان_حزمة {
    دع مفتاح: نص = «lib»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | اختياري.موجود(الجدول) -> {
        دع مداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(مداخل) مثل طبيعي)) {
            لو (!نص_يساوي_بيانا(&مداخل[ف].المفتاح, «path»)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل[ف].الإزاحة, مفتاح_نص_مترجم.حقل_هدف_مكتبة_غير_معروف()));
            };
            ف := ف + 1;
        }
        دع مسار_هدف: متغير نص = «.»;
        دع حقل: نص = «path»;
        طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &حقل) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القيمة) -> {
            طابق قيمة_نص_تومل(&القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل), مفتاح_نص_مترجم.مسار_هدف_مكتبة_غير_نصي()));
            }
            | اختياري.موجود(النص) -> { مسار_هدف := النص; };
        };
        لو (مسار_مطلق(&مسار_هدف)) {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل), مفتاح_نص_مترجم.مسار_هدف_مكتبة_غير_نسبي()));
        };
        دع المحلول: نص = صل_المسار(الدليل, &مسار_هدف);
        طابق حاول_نوع_مدخل_المسار(&المحلول) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.تعذر_فحص_مسار_هدف_مكتبة()));
        }
        | نتيجة.نجح(المدخل) -> {
            طابق المدخل مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.مسار_هدف_مكتبة_مفقود()));
            }
            | اختياري.موجود(النوع) -> {
                طابق النوع مع
                | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(اختياري.موجود(المحلول)); }
                | نوع_مدخل_دليل.ملف -> {
                    لو (!هو_مسار_مصدر_سلطان(&المحلول)) {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.ملف_مكتبة_ليس_مصدر_سلطان()));
                    };
                    طابق أب_المسار(&المحلول) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.هدف_مكتبة_بلا_دليل_مصدر())); }
                    | اختياري.موجود(الأب) -> { أرجع نتيجة.نجح(اختياري.موجود(الأب)); };
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.هدف_مكتبة_ليس_دليلا_ولا_ملفا())); };
            };
        };
    };
}

عرف اقرأ_مدخل_المكتبة(
    الوثيقة: &وثيقة_تومل,
    الجذر: طبيعي,
    الدليل: &نص,
    المسار: &نص
): نتيجة اختياري نص, خطأ_بيان_حزمة {
    دع مفتاح: نص = «lib»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | اختياري.موجود(الجدول) -> {
        دع حقل: نص = «path»;
        دع مسار_هدف: متغير نص = «.»;
        طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &حقل) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | اختياري.موجود(القيمة) -> {
            طابق قيمة_نص_تومل(&القيمة) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(
                    المسار,
                    موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل),
                    مفتاح_نص_مترجم.مسار_هدف_مكتبة_غير_نصي()
                ));
            }
            | اختياري.موجود(النص) -> { مسار_هدف := النص; };
        };
        لو (مسار_مطلق(&مسار_هدف)) {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.مسار_هدف_مكتبة_غير_نسبي()));
        };
        دع المحلول: نص = صل_المسار(الدليل, &مسار_هدف);
        طابق حاول_نوع_مدخل_المسار(&المحلول) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.تعذر_فحص_مسار_هدف_مكتبة())); }
        | نتيجة.نجح(المدخل) -> {
            طابق المدخل مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.مسار_هدف_مكتبة_مفقود())); }
            | اختياري.موجود(النوع) -> {
                طابق النوع مع
                | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
                | نوع_مدخل_دليل.ملف -> {
                    لو (!هو_مسار_مصدر_سلطان(&المحلول)) {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.ملف_مكتبة_ليس_مصدر_سلطان()));
                    };
                    طابق اسم_الملف(&المحلول) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.ملف_مكتبة_بلا_اسم())); }
                    | اختياري.موجود(الاسم) -> {
                        دع العدد: طبيعي = الطول(الاسم) مثل طبيعي;
                        لو (العدد <= 3) { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.اسم_ملف_مكتبة_غير_صالح())); };
                        دع البايتات: متغير متجه ط8 = [];
                        دع ف: متغير طبيعي = 0;
                        طالما ((ف + 3) < العدد) { ألحق(البايتات, الاسم[ف]); ف := ف + 1; }
                        دع المدخل: نص = من_بايتات(&البايتات);
                        لو (!تهجئة_معرف_مصدر_صالحة(&المدخل)) {
                            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.اسم_وحدة_مكتبة_غير_صالح()));
                        };
                        أرجع نتيجة.نجح(اختياري.موجود(المدخل));
                    };
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, مفتاح_نص_مترجم.هدف_مكتبة_ليس_دليلا_ولا_ملفا())); };
            };
        };
    };
}

عرف مسار_هدف_بيان_موجود(
    جذر_المصدر: &نص,
    المسار_المنطقي: &نص
): نتيجة منطقي, عدد {
    دع مسار_الدليل: نص = صل_المسار(جذر_المصدر, المسار_المنطقي);
    دع دليل_موجود: منطقي = حاول_مسار_دليل(&مسار_الدليل)؟;
    لو (دليل_موجود) { أرجع نتيجة.نجح(صواب); };
    دع لاحقة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(مسار_الدليل) مثل طبيعي)) { ألحق(لاحقة, مسار_الدليل[ف]); ف := ف + 1; }
    ألحق_بايتات_نص(&متغير لاحقة, «.sn»);
    دع مسار_الملف: نص = من_بايتات(&لاحقة);
    أرجع حاول_مسار_ملف(&مسار_الملف);
}

عرف تحقق_روابط_الاستيراد(
    الروابط: &متجه ربط_استيراد_حزمة,
    جذر_المصدر: &نص,
    مسار_البيان: &نص
): اختياري خطأ_بيان_حزمة {
    دع القيم: متجه ربط_استيراد_حزمة = *الروابط;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        طابق مسار_هدف_بيان_موجود(جذر_المصدر, &القيم[ف].المسار_المقنن) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.تعذر_فحص_هدف_مرادف_استيراد())); }
        | نتيجة.نجح(موجود) -> {
            لو (!موجود) { أرجع اختياري.موجود(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.هدف_مرادف_استيراد_مفقود())); };
        };
        دع ح: متغير طبيعي = 0;
        طالما (ح < (الطول(القيم[ف].التهجئات) مثل طبيعي)) {
            دع المرئي: &نص = &القيم[ف].التهجئات[ح].المسار;
            لو (!نصان_متساويان(المرئي, &القيم[ف].المسار_المقنن)) {
                طابق مسار_هدف_بيان_موجود(جذر_المصدر, المرئي) مع
                | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.تعذر_فحص_تصادم_مرادف())); }
                | نتيجة.نجح(موجود) -> {
                    لو (موجود) { أرجع اختياري.موجود(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.مرادف_يتعارض_مع_مسار_أصلي())); };
                };
            };
            دع ز: متغير طبيعي = 0;
            طالما (ز < ف) {
                دع د: متغير طبيعي = 0;
                طالما (د < (الطول(القيم[ز].التهجئات) مثل طبيعي)) {
                    لو (نصان_متساويان(المرئي, &القيم[ز].التهجئات[د].المسار)
                        && !نصان_متساويان(&القيم[ف].المسار_المقنن, &القيم[ز].المسار_المقنن)) {
                        أرجع اختياري.موجود(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.مرادف_يشير_إلى_مسارين()));
                    };
                    د := د + 1;
                }
                ز := ز + 1;
            }
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف تحقق_جذر_البيان(
    الوثيقة: &وثيقة_تومل,
    المسار: &نص
): اختياري خطأ_بيان_حزمة {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, (*الوثيقة).الجذر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        دع مسموح: منطقي = نص_يساوي_بيانا(المفتاح, «package»)
            || نص_يساوي_بيانا(المفتاح, «imports-alias»)
            || نص_يساوي_بيانا(المفتاح, «dependencies»)
            || نص_يساوي_بيانا(المفتاح, «dev-dependencies»)
            || نص_يساوي_بيانا(المفتاح, «lib»);
        لو (!مسموح) {
            أرجع اختياري.موجود(خطأ_بيان(المسار, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.إعداد_بيان_علوي_غير_مدعوم()));
        };
        لو (نص_يساوي_بيانا(المفتاح, «dev-dependencies»)) {
            طابق قيمة_جدول_تومل(&المداخل[ف].القيمة) مع
            | اختياري.موجود(الجدول) -> {
                لو (!جدول_فارغ_تومل(الوثيقة, الجدول)) {
                    أرجع اختياري.موجود(خطأ_بيان(المسار, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.اعتماديات_تطوير_غير_مدعومة()));
                };
            }
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(خطأ_بيان(المسار, المداخل[ف].الإزاحة, مفتاح_نص_مترجم.اعتماديات_تطوير_ليست_جدولا())); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// A manifest is identified by its exact directory-entry name. stat-based
// lookup is case-insensitive on default macOS (APFS) and Windows volumes, where
// the repository's distinct legacy lowercase supax.toml would otherwise be
// taken for Supax.toml. List the parent directory and compare names exactly;
// a matching entry must still resolve to a regular file.
عرف ملف_بيان_باسم_دقيق(مسار_البيان: &نص): نتيجة منطقي, عدد {
    دع الاسم: نص;
    طابق اسم_الملف(مسار_البيان) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
    دع الدليل: متغير نص = «.»;
    طابق أب_المسار(مسار_البيان) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الأب) -> {
        لو (الطول(الأب) > 0) { الدليل := الأب; };
    };
    دع دليل_موجود: منطقي = حاول_مسار_دليل(&الدليل)؟;
    لو (!دليل_موجود) { أرجع نتيجة.نجح(خطأ); };
    دع المداخل: متجه مدخل_دليل = اقرأ_مدخلات_الدليل(&الدليل)؟;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(المداخل) مثل طبيعي)) {
        لو (نصان_متساويان(&المداخل[الموضع].الاسم, &الاسم)) {
            أرجع حاول_مسار_ملف(مسار_البيان);
        };
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(خطأ);
}

عام عرف اقرأ_بيان_حزمة(مسار_البيان: &نص): نتيجة_قراءة_بيان_حزمة {
    // Verify the exact directory entry before reading (see ملف_بيان_باسم_دقيق).
    طابق ملف_بيان_باسم_دقيق(مسار_البيان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.تعذر_فحص_بيان_حزمة())); }
    | نتيجة.نجح(موجود) -> {
        لو (!موجود) { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.بيان_حزمة_بالاسم_المطلوب_مفقود())); };
    };

    دع النص: نص;
    طابق اقرأ_الملف(مسار_البيان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.تعذر_قراءة_بيان_حزمة())); }
    | نتيجة.نجح(القيمة) -> { النص := القيمة; };

    دع الوثيقة: وثيقة_تومل;
    طابق حلل_تومل(&النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, الخطأ.الإزاحة, مفتاح_نص_مترجم.صياغة_تومل_غير_صالحة())); }
    | نتيجة.نجح(القيمة) -> { الوثيقة := القيمة; };

    طابق تحقق_جذر_البيان(&الوثيقة, مسار_البيان) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع مفتاح_الحزمة: نص = «package»;
    دع جدول_الحزمة: طبيعي;
    طابق جدول_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &مفتاح_الحزمة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.جدول_حزمة_مطلوب())); }
    | اختياري.موجود(القيمة) -> { جدول_الحزمة := القيمة; };
    طابق تحقق_حقول_الحزمة(&الوثيقة, جدول_الحزمة, مسار_البيان) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    دع الاسم: نص;
    طابق نص_مفتاح_مطلوب(&الوثيقة, جدول_الحزمة, «name», مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الاسم := القيمة; };
    لو (!تهجئة_جذر_بيان_صالحة(&الاسم)) {
        أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.اسم_حزمة_غير_صالح()));
    };

    دع الدليل: نص;
    طابق أب_المسار(مسار_البيان) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, مفتاح_نص_مترجم.بيان_حزمة_بلا_دليل_أصل())); }
    | اختياري.موجود(القيمة) -> { الدليل := القيمة; };

    دع الأسماء: متجه تهجئة_اسم_حزمة;
    طابق اقرأ_أسماء_الحزمة(&الوثيقة, جدول_الحزمة, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الأسماء := القيمة; };

    دع الروابط: متجه ربط_استيراد_حزمة;
    طابق اقرأ_روابط_الاستيراد(&الوثيقة, الوثيقة.الجذر, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الروابط := القيمة; };

    دع مسار_المكتبة: اختياري نص;
    طابق اقرأ_مسار_المكتبة(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مسار_المكتبة := القيمة; };

    دع مدخل_المكتبة: اختياري نص;
    طابق اقرأ_مدخل_المكتبة(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مدخل_المكتبة := القيمة; };

    دع الاعتمادات: متجه اعتماد_مسار_حزمة;
    طابق اقرأ_الاعتمادات(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الاعتمادات := القيمة; };

    دع جذر_تحقق_الروابط: متغير نص = طبع_المسار(&الدليل);
    دع نسخة_مسار_المكتبة: اختياري نص = انسخ_اختيار_نص_بيان(&مسار_المكتبة);
    طابق نسخة_مسار_المكتبة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الجذر) -> { جذر_تحقق_الروابط := الجذر; };
    طابق تحقق_روابط_الاستيراد(&الروابط, &جذر_تحقق_الروابط, مسار_البيان) مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { };

    // Descriptive package metadata is retained as typed data but has no import
    // or authorization effect.
    دع الإصدار: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «version»);
    دع المؤلفون: متجه نص = اقرأ_مصفوفة_نصوص_بيان(&الوثيقة, جدول_الحزمة, «authors»);
    دع الوصف: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «description»);
    دع الصفحة_الرئيسية: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «homepage»);
    دع المستودع: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «repository»);
    دع القراءة: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «readme»);
    دع الكلمات_المفتاحية: متجه نص = اقرأ_مصفوفة_نصوص_بيان(&الوثيقة, جدول_الحزمة, «keywords»);
    دع الرخصة: اختياري نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «license»);

    دع الإعداد: إعداد_بيان_حزمة = {
        مسار_البيان: انسخ_نص(مسار_البيان),
        دليل_البيان: الدليل,
        الاسم: الاسم,
        الإصدار: الإصدار,
        المؤلفون: المؤلفون,
        الوصف: الوصف,
        الصفحة_الرئيسية: الصفحة_الرئيسية,
        المستودع: المستودع,
        القراءة: القراءة,
        الكلمات_المفتاحية: الكلمات_المفتاحية,
        الرخصة: الرخصة,
        الأسماء: الأسماء,
        روابط_الاستيراد: الروابط,
        مسار_المكتبة: مسار_المكتبة,
        مدخل_المكتبة: مدخل_المكتبة,
        الاعتمادات: الاعتمادات,
        الوثيقة: الوثيقة
    };
    أرجع نتيجة_قراءة_بيان_حزمة.جاهز(الإعداد);
}

عام عرف اكتشف_بيان_حزمة_لمصدر(مسار_المصدر: &نص): نتيجة_اكتشاف_بيان_حزمة {
    دع الدليل: نص;
    طابق أب_المسار(مسار_المصدر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_اكتشاف_بيان_حزمة.غير_موجود(); }
    | اختياري.موجود(القيمة) -> { الدليل := طبع_المسار(&القيمة); };
    دع الحالي: متغير نص = الدليل;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع الاسم: نص = «Supax.toml»;
        دع المرشح: نص = صل_المسار(&الحالي, &الاسم);
        طابق ملف_بيان_باسم_دقيق(&المرشح) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_اكتشاف_بيان_حزمة.خطأ(خطأ_بيان(&المرشح, 0, مفتاح_نص_مترجم.تعذر_فحص_بيان_مرشح())); }
        | نتيجة.نجح(موجود) -> {
            لو (موجود) { أرجع نتيجة_اكتشاف_بيان_حزمة.موجود(المرشح); };
        };
        طابق أب_المسار(&الحالي) مع
        | اختياري.لا_شيء -> { مستمر := خطأ; }
        | اختياري.موجود(الأب) -> {
            دع المطبع: نص = طبع_المسار(&الأب);
            لو (نصان_متساويان(&المطبع, &الحالي)) { مستمر := خطأ; }
            وإلا { الحالي := المطبع; };
        };
    }
    أرجع نتيجة_اكتشاف_بيان_حزمة.غير_موجود();
}
