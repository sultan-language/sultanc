استورد compiler.driver.toml;
استورد compiler.frontend.lexer.identifier_queries;
استورد compiler.source.source_kind;
استورد std.fs.read_file;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.text.compare;
استورد std.text.from_bytes;

// Typed package metadata consumed by Driver. The TOML document is retained so
// descriptive/package.metadata data is not lost even when it has no compiler
// behavior in this import correction.
عام نوع تهجئة_اسم_حزمة = {
    اللغة: نص,
    التهجئة: نص
};

عام نوع تهجئة_استيراد_حزمة = {
    اللغة: نص,
    المسار: نص
};

عام نوع ربط_استيراد_حزمة = {
    المسار_المقنن: نص,
    التهجئات: متجه تهجئة_استيراد_حزمة
};

عام نوع اعتماد_مسار_حزمة = {
    الاسم: نص,
    المسار: نص
};

عام نوع إعداد_بيان_حزمة = {
    مسار_البيان: نص,
    دليل_البيان: نص,
    الاسم: نص,
    الإصدار: اختيار نص,
    المؤلفون: متجه نص,
    الوصف: اختيار نص,
    الصفحة_الرئيسية: اختيار نص,
    المستودع: اختيار نص,
    القراءة: اختيار نص,
    الكلمات_المفتاحية: متجه نص,
    الرخصة: اختيار نص,
    الأسماء: متجه تهجئة_اسم_حزمة,
    روابط_الاستيراد: متجه ربط_استيراد_حزمة,
    مسار_المكتبة: اختيار نص,
    مدخل_المكتبة: اختيار نص,
    الاعتمادات: متجه اعتماد_مسار_حزمة,
    الوثيقة: وثيقة_تومل
};

عام نوع خطأ_بيان_حزمة = {
    المسار: نص,
    الإزاحة: غير_موقع,
    السبب: نص
};

عام نوع نتيجة_قراءة_بيان_حزمة =
    | جاهز بنوع إعداد_بيان_حزمة
    | خطأ بنوع خطأ_بيان_حزمة
;

عام نوع نتيجة_اكتشاف_بيان_حزمة =
    | غير_موجود
    | موجود بنوع نص
    | خطأ بنوع خطأ_بيان_حزمة
;

عرف خطأ_بيان(
    المسار: &نص,
    الإزاحة: غير_موقع,
    السبب: نص
): خطأ_بيان_حزمة {
    دع الخطأ: خطأ_بيان_حزمة = { المسار: *المسار, الإزاحة: الإزاحة, السبب: السبب };
    أرجع الخطأ;
}

عرف نص_يساوي_بيانا(الأول: &نص, الثاني: نص): منطقي {
    دع ب: نص = الثاني;
    أرجع نصان_متساويان(الأول, &ب);
}

عرف قيمة_نص_تومل(القيمة: &قيمة_تومل): اختيار نص {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { أرجع اختيار.بعض(النص); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف انسخ_اختيار_نص_بيان(القيمة: &اختيار نص): اختيار نص {
    طابق *القيمة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النص) -> { أرجع اختيار.بعض(النص); };
}

عرف قيمة_جدول_تومل(القيمة: &قيمة_تومل): اختيار غير_موقع {
    طابق *القيمة مع
    | قيمة_تومل.جدول(الفهرس) -> { أرجع اختيار.بعض(الفهرس); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قيمة_مصفوفة_تومل(القيمة: &قيمة_تومل): اختيار غير_موقع {
    طابق *القيمة مع
    | قيمة_تومل.مصفوفة(الفهرس) -> { أرجع اختيار.بعض(الفهرس); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف موقع_مدخل_تومل_في_جدول(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: &نص
): غير_موقع {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
        لو (نصان_متساويان(&المداخل[ف].المفتاح, المفتاح)) { أرجع المداخل[ف].الإزاحة; };
        ف := ف + 1;
    }
    أرجع 0;
}

عرف نص_مفتاح_مطلوب(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص,
    المسار: &نص
): نتيجة نص, خطأ_بيان_حزمة {
    دع اسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &اسم) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «required manifest field is missing»));
    }
    | اختيار.بعض(القيمة) -> {
        طابق قيمة_نص_تومل(&القيمة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &اسم), «manifest field must be a string»
            ));
        }
        | اختيار.بعض(النص) -> { أرجع نتيجة.نجح(النص); };
    };
}

عرف قيمة_اختيارية_موجودة(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص
): منطقي {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { أرجع صواب; };
}

عرف تحقق_مصفوفة_نصوص_اختيارية(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص,
    المسار: &نص
): اختيار خطأ_بيان_حزمة {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق قيمة_مصفوفة_تومل(&القيمة) مع
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), «manifest field must be an array of strings»
            ));
        }
        | اختيار.بعض(الفهرس) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(القيم) مثل غير_موقع)) {
                طابق قيمة_نص_تومل(&القيم[ف]) مع
                | اختيار.بعض(_) -> { }
                | اختيار.لا_شيء -> {
                    أرجع اختيار.بعض(خطأ_بيان(
                        المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), «manifest array contains a non-string value»
                    ));
                };
                ف := ف + 1;
            }
        };
    };
    أرجع اختيار.لا_شيء();
}

عرف تحقق_نص_اختياري(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص,
    المسار: &نص
): اختيار خطأ_بيان_حزمة {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        طابق قيمة_نص_تومل(&القيمة) مع
        | اختيار.بعض(_) -> { أرجع اختيار.لا_شيء(); }
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض(خطأ_بيان(
                المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &الاسم), «manifest field must be a string»
            ));
        };
    };
}

عرف اقرأ_نص_اختياري_بيان(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص
): اختيار نص {
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع قيمة_نص_تومل(&القيمة); };
}

عرف اقرأ_مصفوفة_نصوص_بيان(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المفتاح: نص
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الاسم: نص = المفتاح;
    طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع الناتج; }
    | اختيار.بعض(القيمة) -> {
        طابق قيمة_مصفوفة_تومل(&القيمة) مع
        | اختيار.لا_شيء -> { أرجع الناتج; }
        | اختيار.بعض(الفهرس) -> {
            دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(القيم) مثل غير_موقع)) {
                طابق قيمة_نص_تومل(&القيم[ف]) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(النص) -> { ألحق(الناتج, النص); };
                ف := ف + 1;
            }
        };
    };
    أرجع الناتج;
}

عرف مسار_استيراد_من_نص_بيان(النص: &نص): اختيار نص {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع الجزء: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        لو (!نهاية) {
            دع ب: غ8 = القيمة[ف];
            لو ((ب == 0x2F) || (ب == 0x5C) || (ب == 0)) { أرجع اختيار.لا_شيء(); };
            نهاية := ب == 0x2E;
        };
        لو (نهاية) {
            لو ((الطول(الجزء) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
            دع اسم_الجزء: نص = من_بايتات(&الجزء);
            لو (!تهجئة_معرف_مصدر_صالحة(&اسم_الجزء)) { أرجع اختيار.لا_شيء(); };
            لو ((الطول(الناتج) مثل غير_موقع) > 0) { ألحق(الناتج, 0x2F); };
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(الجزء) مثل غير_موقع)) { ألحق(الناتج, الجزء[ح]); ح := ح + 1; }
            دع جزء_فارغ: متجه غ8 = [];
            الجزء := جزء_فارغ;
        } وإلا {
            ألحق(الجزء, القيمة[ف]);
        };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(من_بايتات(&الناتج));
}

عرف تهجئة_جذر_بيان_صالحة(النص: &نص): منطقي {
    أرجع تهجئة_معرف_مصدر_صالحة(النص);
}

عرف جدول_فارغ_تومل(الوثيقة: &وثيقة_تومل, الفهرس: غير_موقع): منطقي {
    أرجع (الطول(مداخل_جدول_تومل(الوثيقة, الفهرس)) مثل غير_موقع) == 0;
}

عرف تحقق_حقول_الحزمة(
    الوثيقة: &وثيقة_تومل,
    الجدول: غير_موقع,
    المسار: &نص
): اختيار خطأ_بيان_حزمة {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        دع مسموح: منطقي = نص_يساوي_بيانا(المفتاح, «name»)
            || نص_يساوي_بيانا(المفتاح, «version»)
            || نص_يساوي_بيانا(المفتاح, «authors»)
            || نص_يساوي_بيانا(المفتاح, «description»)
            || نص_يساوي_بيانا(المفتاح, «homepage»)
            || نص_يساوي_بيانا(المفتاح, «repository»)
            || نص_يساوي_بيانا(المفتاح, «readme»)
            || نص_يساوي_بيانا(المفتاح, «keywords»)
            || نص_يساوي_بيانا(المفتاح, «license»)
            || نص_يساوي_بيانا(المفتاح, «names»)
            || نص_يساوي_بيانا(المفتاح, «metadata»);
        لو (!مسموح) {
            لو (نص_يساوي_بيانا(المفتاح, «edition») || نص_يساوي_بيانا(المفتاح, «sultanc-version») || نص_يساوي_بيانا(المفتاح, «build»)) {
                أرجع اختيار.بعض(خطأ_بيان(المسار, المداخل[ف].الإزاحة, «manifest setting is recognized but not supported by this compiler yet»));
            };
            أرجع اختيار.بعض(خطأ_بيان(المسار, المداخل[ف].الإزاحة, «unknown package manifest field»));
        };
        ف := ف + 1;
    }

    دع نصوص: متجه نص = [«version», «description», «homepage», «repository», «readme», «license»];
    ف := 0;
    بينما (ف < (الطول(نصوص) مثل غير_موقع)) {
        دع مرجع_مفتاح_النص: &نص = &نصوص[ف];
        دع مفتاح_النص: نص = *مرجع_مفتاح_النص;
        طابق تحقق_نص_اختياري(الوثيقة, الجدول, مفتاح_النص, المسار) مع
        | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    طابق تحقق_مصفوفة_نصوص_اختيارية(الوثيقة, الجدول, «authors», المسار) مع
    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
    | اختيار.لا_شيء -> { };
    طابق تحقق_مصفوفة_نصوص_اختيارية(الوثيقة, الجدول, «keywords», المسار) مع
    | اختيار.بعض(الخطأ) -> { أرجع اختيار.بعض(الخطأ); }
    | اختيار.لا_شيء -> { };
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_أسماء_الحزمة(
    الوثيقة: &وثيقة_تومل,
    جدول_الحزمة: غير_موقع,
    المسار: &نص
): نتيجة متجه تهجئة_اسم_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه تهجئة_اسم_حزمة = [];
    دع مفتاح: نص = «names»;
    طابق جدول_مفتاح_تومل(الوثيقة, جدول_الحزمة, &مفتاح) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختيار.بعض(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع مرجع_اللغة: &نص = &(*مرجع_المدخل).المفتاح;
            دع اللغة: نص = *مرجع_اللغة;
            دع الإزاحة: غير_موقع = (*مرجع_المدخل).الإزاحة;
            لو ((الطول(اللغة) مثل غير_موقع) == 0) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «package.names language label cannot be empty»));
            };
            طابق قيمة_نص_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «package.names values must be strings»));
            }
            | اختيار.بعض(التهجئة) -> {
                لو (!تهجئة_جذر_بيان_صالحة(&التهجئة)) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «package root spelling is not a valid source identifier»));
                };
                دع الاسم: تهجئة_اسم_حزمة = { اللغة: اللغة, التهجئة: التهجئة };
                ألحق(الناتج, الاسم);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_روابط_الاستيراد(
    الوثيقة: &وثيقة_تومل,
    الجذر: غير_موقع,
    المسار: &نص
): نتيجة متجه ربط_استيراد_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه ربط_استيراد_حزمة = [];
    دع مفتاح: نص = «imports-alias»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختيار.بعض(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع الإزاحة: غير_موقع = (*مرجع_المدخل).الإزاحة;
            دع المقنن: نص;
            طابق مسار_استيراد_من_نص_بيان(&(*مرجع_المدخل).المفتاح) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «imports-alias key is not a valid dotted import path»));
            }
            | اختيار.بعض(القيمة) -> { المقنن := القيمة; };
            دع جدول_اللغات: غير_موقع;
            طابق قيمة_جدول_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «imports-alias value must be an inline language map»));
            }
            | اختيار.بعض(القيمة) -> { جدول_اللغات := القيمة; };
            دع تهجئات: متغير متجه تهجئة_استيراد_حزمة = [];
            دع اللغات: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_اللغات);
            دع ح: متغير غير_موقع = 0;
            بينما (ح < (الطول(اللغات) مثل غير_موقع)) {
                دع مرجع_اللغة_المدخل: &مدخل_جدول_تومل = &اللغات[ح];
                دع مرجع_اللغة: &نص = &(*مرجع_اللغة_المدخل).المفتاح;
                دع اللغة: نص = *مرجع_اللغة;
                دع إزاحة_اللغة: غير_موقع = (*مرجع_اللغة_المدخل).الإزاحة;
                لو ((الطول(اللغة) مثل غير_موقع) == 0) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, «imports-alias language label cannot be empty»));
                };
                طابق قيمة_نص_تومل(&(*مرجع_اللغة_المدخل).القيمة) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, «imports-alias language values must be strings»));
                }
                | اختيار.بعض(التهجئة_النصية) -> {
                    طابق مسار_استيراد_من_نص_بيان(&التهجئة_النصية) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, إزاحة_اللغة, «imports-alias spelling is not a valid dotted import path»));
                    }
                    | اختيار.بعض(التهجئة) -> {
                        دع الاسم: تهجئة_استيراد_حزمة = { اللغة: اللغة, المسار: التهجئة };
                        ألحق(تهجئات, الاسم);
                    };
                };
                ح := ح + 1;
            }
            دع الربط: ربط_استيراد_حزمة = { المسار_المقنن: المقنن, التهجئات: تهجئات };
            ألحق(الناتج, الربط);
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_الاعتمادات(
    الوثيقة: &وثيقة_تومل,
    الجذر: غير_موقع,
    الدليل: &نص,
    المسار: &نص
): نتيجة متجه اعتماد_مسار_حزمة, خطأ_بيان_حزمة {
    دع الناتج: متغير متجه اعتماد_مسار_حزمة = [];
    دع مفتاح: نص = «dependencies»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(الناتج); }
    | اختيار.بعض(الجدول) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع مرجع_المدخل: &مدخل_جدول_تومل = &المداخل[ف];
            دع مرجع_اسم_الاعتماد: &نص = &(*مرجع_المدخل).المفتاح;
            دع اسم_الاعتماد: نص = *مرجع_اسم_الاعتماد;
            دع الإزاحة: غير_موقع = (*مرجع_المدخل).الإزاحة;
            لو (!تهجئة_جذر_بيان_صالحة(&اسم_الاعتماد)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «dependency key is not a valid import-root identifier»));
            };
            دع جدول_الاعتماد: غير_موقع;
            طابق قيمة_جدول_تومل(&(*مرجع_المدخل).القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «only local path dependencies are supported»));
            }
            | اختيار.بعض(القيمة) -> { جدول_الاعتماد := القيمة; };
            دع مداخل_الاعتماد: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, جدول_الاعتماد);
            لو ((الطول(مداخل_الاعتماد) مثل غير_موقع) != 1 || !نص_يساوي_بيانا(&مداخل_الاعتماد[0].المفتاح, «path»)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, الإزاحة, «dependency table supports only the path field»));
            };
            طابق قيمة_نص_تومل(&مداخل_الاعتماد[0].القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل_الاعتماد[0].الإزاحة, «dependency path must be a string»));
            }
            | اختيار.بعض(المسار_النسبي) -> {
                لو (مسار_مطلق(&المسار_النسبي)) {
                    أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل_الاعتماد[0].الإزاحة, «dependency path must be relative to its manifest»));
                };
                دع المحلول: نص = صل_المسار(الدليل, &المسار_النسبي);
                دع الاعتماد: اعتماد_مسار_حزمة = { الاسم: اسم_الاعتماد, المسار: المحلول };
                ألحق(الناتج, الاعتماد);
            };
            ف := ف + 1;
        }
    };
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_مسار_المكتبة(
    الوثيقة: &وثيقة_تومل,
    الجذر: غير_موقع,
    الدليل: &نص,
    المسار: &نص
): نتيجة اختيار نص, خطأ_بيان_حزمة {
    دع مفتاح: نص = «lib»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
    | اختيار.بعض(الجدول) -> {
        دع مداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الجدول);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(مداخل) مثل غير_موقع)) {
            لو (!نص_يساوي_بيانا(&مداخل[ف].المفتاح, «path»)) {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, مداخل[ف].الإزاحة, «unknown lib target field»));
            };
            ف := ف + 1;
        }
        دع مسار_هدف: متغير نص = «.»;
        دع حقل: نص = «path»;
        طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &حقل) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(القيمة) -> {
            طابق قيمة_نص_تومل(&القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل), «lib.path must be a string»));
            }
            | اختيار.بعض(النص) -> { مسار_هدف := النص; };
        };
        لو (مسار_مطلق(&مسار_هدف)) {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل), «lib.path must be relative to its manifest»));
        };
        دع المحلول: نص = صل_المسار(الدليل, &مسار_هدف);
        طابق حاول_نوع_مدخل_المسار(&المحلول) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path could not be inspected»));
        }
        | نتيجة.نجح(المدخل) -> {
            طابق المدخل مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path does not exist»));
            }
            | اختيار.بعض(النوع) -> {
                طابق النوع مع
                | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(اختيار.بعض(المحلول)); }
                | نوع_مدخل_دليل.ملف -> {
                    لو (!هو_مسار_مصدر_سلطان(&المحلول)) {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path source file is not a SultanC source file»));
                    };
                    طابق أب_المسار(&المحلول) مع
                    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path has no source directory»)); }
                    | اختيار.بعض(الأب) -> { أرجع نتيجة.نجح(اختيار.بعض(الأب)); };
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path must name a directory or SultanC source file»)); };
            };
        };
    };
}

عرف اقرأ_مدخل_المكتبة(
    الوثيقة: &وثيقة_تومل,
    الجذر: غير_موقع,
    الدليل: &نص,
    المسار: &نص
): نتيجة اختيار نص, خطأ_بيان_حزمة {
    دع مفتاح: نص = «lib»;
    طابق جدول_مفتاح_تومل(الوثيقة, الجذر, &مفتاح) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
    | اختيار.بعض(الجدول) -> {
        دع حقل: نص = «path»;
        دع مسار_هدف: متغير نص = «.»;
        طابق قيمة_مفتاح_تومل(الوثيقة, الجدول, &حقل) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
        | اختيار.بعض(القيمة) -> {
            طابق قيمة_نص_تومل(&القيمة) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_بيان(
                    المسار,
                    موقع_مدخل_تومل_في_جدول(الوثيقة, الجدول, &حقل),
                    «lib.path must be a string»
                ));
            }
            | اختيار.بعض(النص) -> { مسار_هدف := النص; };
        };
        لو (مسار_مطلق(&مسار_هدف)) {
            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path must be relative to its manifest»));
        };
        دع المحلول: نص = صل_المسار(الدليل, &مسار_هدف);
        طابق حاول_نوع_مدخل_المسار(&المحلول) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path could not be inspected»)); }
        | نتيجة.نجح(المدخل) -> {
            طابق المدخل مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path does not exist»)); }
            | اختيار.بعض(النوع) -> {
                طابق النوع مع
                | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
                | نوع_مدخل_دليل.ملف -> {
                    لو (!هو_مسار_مصدر_سلطان(&المحلول)) {
                        أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path source file is not a SultanC source file»));
                    };
                    طابق اسم_الملف(&المحلول) مع
                    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path source file has no filename»)); }
                    | اختيار.بعض(الاسم) -> {
                        دع العدد: غير_موقع = الطول(الاسم) مثل غير_موقع;
                        لو (العدد <= 3) { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path source filename is invalid»)); };
                        دع البايتات: متغير متجه غ8 = [];
                        دع ف: متغير غير_موقع = 0;
                        بينما ((ف + 3) < العدد) { ألحق(البايتات, الاسم[ف]); ف := ف + 1; }
                        دع المدخل: نص = من_بايتات(&البايتات);
                        لو (!تهجئة_معرف_مصدر_صالحة(&المدخل)) {
                            أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path source filename is not a valid module identifier»));
                        };
                        أرجع نتيجة.نجح(اختيار.بعض(المدخل));
                    };
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_بيان(المسار, 0, «lib.path must name a directory or SultanC source file»)); };
            };
        };
    };
}

عرف مسار_هدف_بيان_موجود(
    جذر_المصدر: &نص,
    المسار_المنطقي: &نص
): نتيجة منطقي, عدد {
    دع مسار_الدليل: نص = صل_المسار(جذر_المصدر, المسار_المنطقي);
    طابق حاول_مسار_دليل(&مسار_الدليل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(موجود) -> { لو (موجود) { أرجع نتيجة.نجح(صواب); }; };
    دع لاحقة: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(مسار_الدليل) مثل غير_موقع)) { ألحق(لاحقة, مسار_الدليل[ف]); ف := ف + 1; }
    ألحق(لاحقة, 0x2E); ألحق(لاحقة, 0x73); ألحق(لاحقة, 0x6E);
    دع مسار_الملف: نص = من_بايتات(&لاحقة);
    أرجع حاول_مسار_ملف(&مسار_الملف);
}

عرف تحقق_روابط_الاستيراد(
    الروابط: &متجه ربط_استيراد_حزمة,
    جذر_المصدر: &نص,
    مسار_البيان: &نص
): اختيار خطأ_بيان_حزمة {
    دع القيم: متجه ربط_استيراد_حزمة = *الروابط;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق مسار_هدف_بيان_موجود(جذر_المصدر, &القيم[ف].المسار_المقنن) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(خطأ_بيان(مسار_البيان, 0, «canonical imports-alias target could not be inspected»)); }
        | نتيجة.نجح(موجود) -> {
            لو (!موجود) { أرجع اختيار.بعض(خطأ_بيان(مسار_البيان, 0, «canonical imports-alias target does not exist»)); };
        };
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(القيم[ف].التهجئات) مثل غير_موقع)) {
            دع المرئي: &نص = &القيم[ف].التهجئات[ح].المسار;
            لو (!نصان_متساويان(المرئي, &القيم[ف].المسار_المقنن)) {
                طابق مسار_هدف_بيان_موجود(جذر_المصدر, المرئي) مع
                | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(خطأ_بيان(مسار_البيان, 0, «imports-alias spelling could not be inspected for collision»)); }
                | نتيجة.نجح(موجود) -> {
                    لو (موجود) { أرجع اختيار.بعض(خطأ_بيان(مسار_البيان, 0, «imports-alias spelling conflicts with a canonical source path»)); };
                };
            };
            دع ز: متغير غير_موقع = 0;
            بينما (ز < ف) {
                دع د: متغير غير_موقع = 0;
                بينما (د < (الطول(القيم[ز].التهجئات) مثل غير_موقع)) {
                    لو (نصان_متساويان(المرئي, &القيم[ز].التهجئات[د].المسار)
                        && !نصان_متساويان(&القيم[ف].المسار_المقنن, &القيم[ز].المسار_المقنن)) {
                        أرجع اختيار.بعض(خطأ_بيان(مسار_البيان, 0, «one imports-alias spelling names two canonical paths»));
                    };
                    د := د + 1;
                }
                ز := ز + 1;
            }
            ح := ح + 1;
        }
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف تحقق_جذر_البيان(
    الوثيقة: &وثيقة_تومل,
    المسار: &نص
): اختيار خطأ_بيان_حزمة {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, (*الوثيقة).الجذر);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
        دع المفتاح: &نص = &المداخل[ف].المفتاح;
        دع مسموح: منطقي = نص_يساوي_بيانا(المفتاح, «package»)
            || نص_يساوي_بيانا(المفتاح, «imports-alias»)
            || نص_يساوي_بيانا(المفتاح, «dependencies»)
            || نص_يساوي_بيانا(المفتاح, «dev-dependencies»)
            || نص_يساوي_بيانا(المفتاح, «lib»);
        لو (!مسموح) {
            أرجع اختيار.بعض(خطأ_بيان(المسار, المداخل[ف].الإزاحة, «unsupported or unknown top-level manifest setting»));
        };
        لو (نص_يساوي_بيانا(المفتاح, «dev-dependencies»)) {
            طابق قيمة_جدول_تومل(&المداخل[ف].القيمة) مع
            | اختيار.بعض(الجدول) -> {
                لو (!جدول_فارغ_تومل(الوثيقة, الجدول)) {
                    أرجع اختيار.بعض(خطأ_بيان(المسار, المداخل[ف].الإزاحة, «dev-dependencies are not supported by this command»));
                };
            }
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(خطأ_بيان(المسار, المداخل[ف].الإزاحة, «dev-dependencies must be a table»)); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف اقرأ_بيان_حزمة(مسار_البيان: &نص): نتيجة_قراءة_بيان_حزمة {
    // Verify the exact directory entry before reading. This keeps the manifest
    // filename case-sensitive even on hosts whose path lookup is case-insensitive
    // (the repository also has a distinct legacy lowercase supax.toml).
    طابق حاول_مسار_ملف(مسار_البيان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «package manifest could not be inspected»)); }
    | نتيجة.نجح(موجود) -> {
        لو (!موجود) { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «package manifest does not exist with the required exact filename»)); };
    };

    دع النص: نص;
    طابق اقرأ_الملف(مسار_البيان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «package manifest could not be read»)); }
    | نتيجة.نجح(القيمة) -> { النص := القيمة; };

    دع الوثيقة: وثيقة_تومل;
    طابق حلل_تومل(&النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, الخطأ.الإزاحة, «invalid TOML syntax»)); }
    | نتيجة.نجح(القيمة) -> { الوثيقة := القيمة; };

    طابق تحقق_جذر_البيان(&الوثيقة, مسار_البيان) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع مفتاح_الحزمة: نص = «package»;
    دع جدول_الحزمة: غير_موقع;
    طابق جدول_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &مفتاح_الحزمة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «[package] table is required»)); }
    | اختيار.بعض(القيمة) -> { جدول_الحزمة := القيمة; };
    طابق تحقق_حقول_الحزمة(&الوثيقة, جدول_الحزمة, مسار_البيان) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    دع الاسم: نص;
    طابق نص_مفتاح_مطلوب(&الوثيقة, جدول_الحزمة, «name», مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الاسم := القيمة; };
    لو (!تهجئة_جذر_بيان_صالحة(&الاسم)) {
        أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «package.name is not a valid import-root identifier»));
    };

    دع الدليل: نص;
    طابق أب_المسار(مسار_البيان) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(خطأ_بيان(مسار_البيان, 0, «package manifest has no parent directory»)); }
    | اختيار.بعض(القيمة) -> { الدليل := القيمة; };

    دع الأسماء: متجه تهجئة_اسم_حزمة;
    طابق اقرأ_أسماء_الحزمة(&الوثيقة, جدول_الحزمة, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الأسماء := القيمة; };

    دع الروابط: متجه ربط_استيراد_حزمة;
    طابق اقرأ_روابط_الاستيراد(&الوثيقة, الوثيقة.الجذر, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الروابط := القيمة; };

    دع مسار_المكتبة: اختيار نص;
    طابق اقرأ_مسار_المكتبة(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مسار_المكتبة := القيمة; };

    دع مدخل_المكتبة: اختيار نص;
    طابق اقرأ_مدخل_المكتبة(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مدخل_المكتبة := القيمة; };

    دع الاعتمادات: متجه اعتماد_مسار_حزمة;
    طابق اقرأ_الاعتمادات(&الوثيقة, الوثيقة.الجذر, &الدليل, مسار_البيان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الاعتمادات := القيمة; };

    دع جذر_تحقق_الروابط: متغير نص = طبع_المسار(&الدليل);
    دع نسخة_مسار_المكتبة: اختيار نص = انسخ_اختيار_نص_بيان(&مسار_المكتبة);
    طابق نسخة_مسار_المكتبة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الجذر) -> { جذر_تحقق_الروابط := الجذر; };
    طابق تحقق_روابط_الاستيراد(&الروابط, &جذر_تحقق_الروابط, مسار_البيان) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_قراءة_بيان_حزمة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };

    // Descriptive package metadata is retained as typed data but has no import
    // or authorization effect.
    دع الإصدار: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «version»);
    دع المؤلفون: متجه نص = اقرأ_مصفوفة_نصوص_بيان(&الوثيقة, جدول_الحزمة, «authors»);
    دع الوصف: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «description»);
    دع الصفحة_الرئيسية: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «homepage»);
    دع المستودع: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «repository»);
    دع القراءة: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «readme»);
    دع الكلمات_المفتاحية: متجه نص = اقرأ_مصفوفة_نصوص_بيان(&الوثيقة, جدول_الحزمة, «keywords»);
    دع الرخصة: اختيار نص = اقرأ_نص_اختياري_بيان(&الوثيقة, جدول_الحزمة, «license»);

    دع الإعداد: إعداد_بيان_حزمة = {
        مسار_البيان: *مسار_البيان,
        دليل_البيان: الدليل,
        الاسم: الاسم,
        الإصدار: الإصدار,
        المؤلفون: المؤلفون,
        الوصف: الوصف,
        الصفحة_الرئيسية: الصفحة_الرئيسية,
        المستودع: المستودع,
        القراءة: القراءة,
        الكلمات_المفتاحية: الكلمات_المفتاحية,
        الرخصة: الرخصة,
        الأسماء: الأسماء,
        روابط_الاستيراد: الروابط,
        مسار_المكتبة: مسار_المكتبة,
        مدخل_المكتبة: مدخل_المكتبة,
        الاعتمادات: الاعتمادات,
        الوثيقة: الوثيقة
    };
    أرجع نتيجة_قراءة_بيان_حزمة.جاهز(الإعداد);
}

عام عرف اكتشف_بيان_حزمة_لمصدر(مسار_المصدر: &نص): نتيجة_اكتشاف_بيان_حزمة {
    دع الدليل: نص;
    طابق أب_المسار(مسار_المصدر) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_اكتشاف_بيان_حزمة.غير_موجود(); }
    | اختيار.بعض(القيمة) -> { الدليل := طبع_المسار(&القيمة); };
    دع الحالي: متغير نص = الدليل;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الاسم: نص = «Supax.toml»;
        دع المرشح: نص = صل_المسار(&الحالي, &الاسم);
        طابق حاول_مسار_ملف(&المرشح) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_اكتشاف_بيان_حزمة.خطأ(خطأ_بيان(&المرشح, 0, «could not inspect candidate package manifest»)); }
        | نتيجة.نجح(موجود) -> {
            لو (موجود) { أرجع نتيجة_اكتشاف_بيان_حزمة.موجود(المرشح); };
        };
        طابق أب_المسار(&الحالي) مع
        | اختيار.لا_شيء -> { مستمر := خطأ; }
        | اختيار.بعض(الأب) -> {
            دع المطبع: نص = طبع_المسار(&الأب);
            لو (نصان_متساويان(&المطبع, &الحالي)) { مستمر := خطأ; }
            وإلا { الحالي := المطبع; };
        };
    }
    أرجع نتيجة_اكتشاف_بيان_حزمة.غير_موجود();
}
