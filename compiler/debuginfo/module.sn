استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.frontend.names.module_identity;

عام عرف أضف_وحدة_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الوحدة: معرف_وحدة,
    الاسم: &متجه غ8,
    معرف_المصدر: غير_موقع,
    اصطناعي: منطقي
): معرف_وحدة_تصحيح {
    بينما ((الطول((*السياق).فهرس_الوحدات) مثل غير_موقع) <= الوحدة.القيمة) {
        دع بلا_وحدة: اختيار معرف_وحدة_تصحيح = اختيار.لا_شيء();
        ألحق((*السياق).فهرس_الوحدات, بلا_وحدة);
    }
    طابق (*السياق).فهرس_الوحدات[الوحدة.القيمة] مع
    | اختيار.بعض(المعرف) -> { أرجع المعرف; }
    | اختيار.لا_شيء -> { };
    دع المعرف: معرف_وحدة_تصحيح = معرف_وحدة_تصحيح_من(الطول((*السياق).الوحدات) مثل غير_موقع);
    دع اسم_الوحدة: متجه غ8 = انسخ_اسم_تصحيح(الاسم);
    دع الوصف: وحدة_تصحيح = {
        المعرف: المعرف,
        الوحدة: الوحدة,
        الاسم: اسم_الوحدة,
        معرف_المصدر: معرف_المصدر,
        اصطناعي: اصطناعي
    };
    ألحق((*السياق).الوحدات, الوصف);
    (*السياق).فهرس_الوحدات[الوحدة.القيمة] := اختيار.بعض(المعرف);
    أرجع المعرف;
}
