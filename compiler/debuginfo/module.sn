استورد compiler.debuginfo.model;
استورد compiler.debuginfo.builder;
استورد compiler.frontend.names.module_identity;

عام عرف أضف_وحدة_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الوحدة: معرف_وحدة,
    الاسم: &متجه ط8,
    معرف_المصدر: طبيعي,
    اصطناعي: منطقي
): معرف_وحدة_تصحيح {
    طالما ((الطول((*السياق).فهرس_الوحدات) مثل طبيعي) <= (الوحدة.القيمة مثل طبيعي)) {
        دع بلا_وحدة: اختياري معرف_وحدة_تصحيح = اختياري.لا_شيء();
        ألحق((*السياق).فهرس_الوحدات, بلا_وحدة);
    }
    طابق (*السياق).فهرس_الوحدات[الوحدة.القيمة] مع
    | اختياري.موجود(المعرف) -> { أرجع المعرف; }
    | اختياري.لا_شيء -> { };
    دع المعرف: معرف_وحدة_تصحيح = معرف_وحدة_تصحيح_من(الطول((*السياق).الوحدات) مثل طبيعي);
    دع اسم_الوحدة: متجه ط8 = انسخ_اسم_تصحيح(الاسم);
    دع الوصف: وحدة_تصحيح = {
        المعرف: المعرف,
        الوحدة: الوحدة,
        الاسم: اسم_الوحدة,
        معرف_المصدر: معرف_المصدر,
        اصطناعي: اصطناعي
    };
    ألحق((*السياق).الوحدات, الوصف);
    (*السياق).فهرس_الوحدات[الوحدة.القيمة] := اختياري.موجود(المعرف);
    أرجع المعرف;
}
