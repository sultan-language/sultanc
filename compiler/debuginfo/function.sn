استورد compiler.debuginfo.model;
استورد compiler.debuginfo.scope;
استورد compiler.source.provenance;
استورد compiler.frontend.types.type_identity;

عام عرف أضف_دالة_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الاسم: متجه غ8,
    اسم_الربط: متجه غ8,
    الأصل: معرف_أصل_مصدر,
    الناتج: اختيار معرف_نوع,
    إعلان_فقط: منطقي,
    علني: منطقي,
    اصطناعي: منطقي
): معرف_دالة_تصحيح {
    دع المعرف: معرف_دالة_تصحيح = معرف_دالة_تصحيح_من(الطول((*السياق).الدوال) مثل غير_موقع);
    دع المعاملات: متجه معرف_متغير_تصحيح = [];
    دع بلا_نطاق: اختيار معرف_نطاق_تصحيح = اختيار.لا_شيء();
    دع الدالة: دالة_تصحيح = {
        المعرف: المعرف, الاسم: الاسم, اسم_الربط: اسم_الربط, الأصل: الأصل,
        المعاملات: المعاملات, الناتج: الناتج, النطاق_الجذري: بلا_نطاق,
        إعلان_فقط: إعلان_فقط, علني: علني, اصطناعي: اصطناعي
    };
    ألحق((*السياق).الدوال, الدالة);
    أرجع المعرف;
}
