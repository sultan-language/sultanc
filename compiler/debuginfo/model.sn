استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.module_identity;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.provenance;
استورد compiler.source.span;

// Stable dense debug identities. The numeric value is an index into the
// canonical table owned by سياق_تصحيح; consumers never own duplicate records.
عام نوع معرف_موقع_تصحيح = { القيمة: طبيعي };
عام نوع معرف_نطاق_تصحيح = { القيمة: طبيعي };
عام نوع معرف_دالة_تصحيح = { القيمة: طبيعي };
عام نوع معرف_متغير_تصحيح = { القيمة: طبيعي };
عام نوع معرف_نوع_تصحيح = { القيمة: طبيعي };
عام نوع معرف_تعبير_تصحيح = { القيمة: طبيعي };
عام نوع معرف_عام_تصحيح = { القيمة: طبيعي };
عام نوع معرف_ثابت_تصحيح = { القيمة: طبيعي };
عام نوع معرف_وحدة_تصحيح = { القيمة: طبيعي };

عام عرف معرف_موقع_تصحيح_من(القيمة: طبيعي): معرف_موقع_تصحيح { دع م: معرف_موقع_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_نطاق_تصحيح_من(القيمة: طبيعي): معرف_نطاق_تصحيح { دع م: معرف_نطاق_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_دالة_تصحيح_من(القيمة: طبيعي): معرف_دالة_تصحيح { دع م: معرف_دالة_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_متغير_تصحيح_من(القيمة: طبيعي): معرف_متغير_تصحيح { دع م: معرف_متغير_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_نوع_تصحيح_من(القيمة: طبيعي): معرف_نوع_تصحيح { دع م: معرف_نوع_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_تعبير_تصحيح_من(القيمة: طبيعي): معرف_تعبير_تصحيح { دع م: معرف_تعبير_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_عام_تصحيح_من(القيمة: طبيعي): معرف_عام_تصحيح { دع م: معرف_عام_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_ثابت_تصحيح_من(القيمة: طبيعي): معرف_ثابت_تصحيح { دع م: معرف_ثابت_تصحيح = { القيمة: القيمة }; أرجع م; }
عام عرف معرف_وحدة_تصحيح_من(القيمة: طبيعي): معرف_وحدة_تصحيح { دع م: معرف_وحدة_تصحيح = { القيمة: القيمة }; أرجع م; }

// Statement/debugger stepping identity is explicit. The source provenance owns
// the span; this record only classifies how the debugger should treat it.
عام نوع موقع_تصحيح = {
    المعرف: معرف_موقع_تصحيح,
    الأصل: معرف_أصل_مصدر,
    النطاق: اختياري معرف_نطاق_تصحيح,
    هو_عبارة: منطقي,
    نهاية_مقدمة: منطقي,
    بداية_خاتمة: منطقي,
    المميز: طبيعي
};

عام نوع نطاق_تصحيح = {
    المعرف: معرف_نطاق_تصحيح,
    الأصل: معرف_أصل_مصدر,
    المدى: نطاق,
    الأب: اختياري معرف_نطاق_تصحيح,
    الأبناء: متجه معرف_نطاق_تصحيح,
    المحليات: متجه معرف_متغير_تصحيح,
    الدالة: معرف_دالة_تصحيح,
    مضمن_عند: اختياري معرف_موقع_تصحيح
};

عام نوع صنف_متغير_تصحيح =
    | معامل
    | محلي
    | التقاط
    | عام
    | ثابت
    | اصطناعي
;

عام نوع متغير_تصحيح = {
    المعرف: معرف_متغير_تصحيح,
    الرمز: اختياري معرف_رمز,
    الاسم: متجه ط8,
    النوع: معرف_نوع,
    الأصل: معرف_أصل_مصدر,
    النطاق: معرف_نطاق_تصحيح,
    الصنف: صنف_متغير_تصحيح,
    اصطناعي: منطقي
};

عام نوع دالة_تصحيح = {
    المعرف: معرف_دالة_تصحيح,
    الاسم: متجه ط8,
    اسم_الربط: متجه ط8,
    الأصل: معرف_أصل_مصدر,
    المعاملات: متجه معرف_متغير_تصحيح,
    الناتج: اختياري معرف_نوع,
    النطاق_الجذري: اختياري معرف_نطاق_تصحيح,
    إعلان_فقط: منطقي,
    علني: منطقي,
    اصطناعي: منطقي
};

عام نوع اسم_عضو_تصحيح_نوع = {
    الفهرس: طبيعي,
    الاسم: متجه ط8
};

عام نوع اسم_بديل_تصحيح_نوع = {
    الفهرس: طبيعي,
    الاسم: متجه ط8
};

// Source-facing type metadata deliberately carries no layout. Canonical Type
// and Target layout owners provide size/offset/ABI facts later.
عام نوع نوع_تصحيح = {
    المعرف: معرف_نوع_تصحيح,
    النوع: معرف_نوع,
    الرمز: اختياري معرف_رمز,
    الاسم: متجه ط8,
    الأعضاء: متجه اسم_عضو_تصحيح_نوع,
    البدائل: متجه اسم_بديل_تصحيح_نوع,
    معاملات_النوع: متجه معرف_نوع,
    أسماء_معاملات_النوع: متجه متجه ط8,
    اسم_مستعار_لـ: اختياري معرف_نوع,
    الأصل: اختياري معرف_أصل_مصدر,
    اصطناعي: منطقي
};

عام نوع عام_تصحيح = {
    المعرف: معرف_عام_تصحيح,
    الرمز: اختياري معرف_رمز,
    الاسم: متجه ط8,
    اسم_الربط: متجه ط8,
    النوع: معرف_نوع,
    الأصل: معرف_أصل_مصدر,
    قابل_للكتابة: منطقي,
    إعلان_فقط: منطقي,
    علني: منطقي,
    اصطناعي: منطقي
};

عام نوع قيمة_ثابت_تصحيح =
    | منطق بنوع منطقي
    | صحيح_موقع بنوع عدد
    | صحيح_طبيعي بنوع طبيعي
;

عام نوع ثابت_تصحيح = {
    المعرف: معرف_ثابت_تصحيح,
    الرمز: اختياري معرف_رمز,
    الاسم: متجه ط8,
    النوع: معرف_نوع,
    الأصل: معرف_أصل_مصدر,
    القيمة: اختياري قيمة_ثابت_تصحيح,
    علني: منطقي,
    اصطناعي: منطقي
};

عام نوع وحدة_تصحيح = {
    المعرف: معرف_وحدة_تصحيح,
    الوحدة: معرف_وحدة,
    الاسم: متجه ط8,
    معرف_المصدر: طبيعي,
    اصطناعي: منطقي
};

// Generic semantic debug expressions intentionally contain no target register
// numbers or frame policy. Machine lowering creates target-backed expressions.
عام نوع عملية_تعبير_تصحيح =
    | قيمة_ثابتة بنوع طبيعي
    | عنوان_رمزي بنوع طبيعي
    | إضافة_ثابت بنوع طبيعي
    | جزء بنوع (طبيعي, طبيعي)
;

عام نوع تعبير_تصحيح = {
    المعرف: معرف_تعبير_تصحيح,
    العمليات: متجه عملية_تعبير_تصحيح
};

// Canonical owner for all rich source-language debug facts.
عام نوع سياق_تصحيح = {
    المواقع: متجه موقع_تصحيح,
    فهرس_المواقع_بالأصل: متجه اختياري معرف_موقع_تصحيح,
    النطاقات: متجه نطاق_تصحيح,
    فهرس_النطاقات_بالأصل: متجه اختياري معرف_نطاق_تصحيح,
    الدوال: متجه دالة_تصحيح,
    المتغيرات: متجه متغير_تصحيح,
    الأنواع: متجه نوع_تصحيح,
    فهرس_الأنواع_الدلالية: متجه اختياري معرف_نوع_تصحيح,
    فهرس_الأنواع_بالرمز: متجه اختياري معرف_نوع_تصحيح,
    العوام: متجه عام_تصحيح,
    الثوابت: متجه ثابت_تصحيح,
    الوحدات: متجه وحدة_تصحيح,
    فهرس_الوحدات: متجه اختياري معرف_وحدة_تصحيح,
    التعابير: متجه تعبير_تصحيح
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_متجه_معرف_متغير_تصحيح(القيمة: &متجه معرف_متغير_تصحيح): متجه معرف_متغير_تصحيح {
    دع الناتج: متغير متجه معرف_متغير_تصحيح = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
