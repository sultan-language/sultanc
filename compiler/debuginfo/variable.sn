استورد compiler.debuginfo.model;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_identity;
استورد compiler.source.provenance;

عام عرف أضف_متغير_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الرمز: اختيار معرف_رمز,
    الاسم: متجه غ8,
    النوع: معرف_نوع,
    الأصل: معرف_أصل_مصدر,
    النطاق: معرف_نطاق_تصحيح,
    الصنف: صنف_متغير_تصحيح,
    اصطناعي: منطقي
): معرف_متغير_تصحيح {
    دع المعرف: معرف_متغير_تصحيح = معرف_متغير_تصحيح_من(الطول((*السياق).المتغيرات) مثل غير_موقع);
    دع المتغير: متغير_تصحيح = {
        المعرف: المعرف, الرمز: الرمز, الاسم: الاسم, النوع: النوع,
        الأصل: الأصل, النطاق: النطاق, الصنف: الصنف, اصطناعي: اصطناعي
    };
    ألحق((*السياق).المتغيرات, المتغير);
    لو (النطاق.القيمة < (الطول((*السياق).النطاقات) مثل غير_موقع)) {
        ألحق((*السياق).النطاقات[النطاق.القيمة].المحليات, المعرف);
    };
    أرجع المعرف;
}
