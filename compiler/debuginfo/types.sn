استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.names.identifiers;
استورد compiler.source.provenance;

عام عرف أضف_نوع_تصحيح(
    السياق: &متغير سياق_تصحيح,
    النوع: معرف_نوع,
    الرمز: اختيار معرف_رمز,
    الاسم: متجه غ8,
    الأعضاء: متجه اسم_عضو_تصحيح_نوع,
    البدائل: متجه اسم_بديل_تصحيح_نوع,
    معاملات_النوع: متجه معرف_نوع,
    أسماء_معاملات_النوع: متجه متجه غ8,
    اسم_مستعار_لـ: اختيار معرف_نوع,
    الأصل: اختيار معرف_أصل_مصدر,
    اصطناعي: منطقي
): معرف_نوع_تصحيح {
    دع المعرف: معرف_نوع_تصحيح = معرف_نوع_تصحيح_من(الطول((*السياق).الأنواع) مثل غير_موقع);
    دع الوصف: نوع_تصحيح = {
        المعرف: المعرف, النوع: النوع, الرمز: الرمز, الاسم: الاسم,
        الأعضاء: الأعضاء, البدائل: البدائل, معاملات_النوع: معاملات_النوع,
        أسماء_معاملات_النوع: أسماء_معاملات_النوع,
        اسم_مستعار_لـ: اسم_مستعار_لـ, الأصل: الأصل, اصطناعي: اصطناعي
    };
    ألحق((*السياق).الأنواع, الوصف);
    بينما ((الطول((*السياق).فهرس_الأنواع_الدلالية) مثل غير_موقع) <= النوع.القيمة) {
        دع فارغ: اختيار معرف_نوع_تصحيح = اختيار.لا_شيء(); ألحق((*السياق).فهرس_الأنواع_الدلالية, فارغ);
    }
    (*السياق).فهرس_الأنواع_الدلالية[النوع.القيمة] := اختيار.بعض(المعرف);
    طابق الرمز مع
    | اختيار.بعض(معرف_الرمز) -> {
        بينما ((الطول((*السياق).فهرس_الأنواع_بالرمز) مثل غير_موقع) <= معرف_الرمز.القيمة) {
            دع فارغ_رمز: اختيار معرف_نوع_تصحيح = اختيار.لا_شيء();
            ألحق((*السياق).فهرس_الأنواع_بالرمز, فارغ_رمز);
        }
        (*السياق).فهرس_الأنواع_بالرمز[معرف_الرمز.القيمة] := اختيار.بعض(المعرف);
    }
    | اختيار.لا_شيء -> { };
    أرجع المعرف;
}

// Source aliases are separate debug identities that reference one canonical semantic TypeID.
// They never replace the canonical TypeID -> DebugTypeID index because many aliases may
// name the same semantic type.
عام عرف أضف_اسم_مستعار_نوع_تصحيح(
    السياق: &متغير سياق_تصحيح,
    النوع_الهدف: معرف_نوع,
    الاسم: متجه غ8,
    الأصل: اختيار معرف_أصل_مصدر,
    اصطناعي: منطقي
): معرف_نوع_تصحيح {
    دع المعرف: معرف_نوع_تصحيح = معرف_نوع_تصحيح_من(الطول((*السياق).الأنواع) مثل غير_موقع);
    دع أعضاء: متجه اسم_عضو_تصحيح_نوع = [];
    دع بدائل: متجه اسم_بديل_تصحيح_نوع = [];
    دع معاملات: متجه معرف_نوع = [];
    دع أسماء_معاملات: متجه متجه غ8 = [];
    دع بلا_رمز: اختيار معرف_رمز = اختيار.لا_شيء();
    دع الاسم_المستعار: اختيار معرف_نوع = اختيار.بعض(النوع_الهدف);
    دع الوصف: نوع_تصحيح = {
        المعرف: المعرف, النوع: النوع_الهدف, الرمز: بلا_رمز, الاسم: الاسم,
        الأعضاء: أعضاء, البدائل: بدائل, معاملات_النوع: معاملات,
        أسماء_معاملات_النوع: أسماء_معاملات,
        اسم_مستعار_لـ: الاسم_المستعار, الأصل: الأصل, اصطناعي: اصطناعي
    };
    ألحق((*السياق).الأنواع, الوصف);
    أرجع المعرف;
}

عام عرف معرف_نوع_تصحيح_لنوع(السياق: &سياق_تصحيح, النوع: معرف_نوع): اختيار معرف_نوع_تصحيح {
    لو (النوع.القيمة >= (الطول((*السياق).فهرس_الأنواع_الدلالية) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*السياق).فهرس_الأنواع_الدلالية[النوع.القيمة];
}

عام عرف معرف_نوع_تصحيح_لرمز(السياق: &سياق_تصحيح, الرمز: معرف_رمز): اختيار معرف_نوع_تصحيح {
    لو (الرمز.القيمة >= (الطول((*السياق).فهرس_الأنواع_بالرمز) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*السياق).فهرس_الأنواع_بالرمز[الرمز.القيمة];
}
