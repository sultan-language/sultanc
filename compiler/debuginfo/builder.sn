استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;

عام عرف سياق_تصحيح_جديد(): سياق_تصحيح {
    ليكن المواقع: متجه موقع_تصحيح = [];
    ليكن فهرس_المواقع: متجه اختياري معرف_موقع_تصحيح = [];
    ليكن النطاقات: متجه نطاق_تصحيح = [];
    ليكن فهرس_النطاقات: متجه اختياري معرف_نطاق_تصحيح = [];
    ليكن الدوال: متجه دالة_تصحيح = [];
    ليكن المتغيرات: متجه متغير_تصحيح = [];
    ليكن الأنواع: متجه نوع_تصحيح = [];
    ليكن فهرس_الأنواع: متجه اختياري معرف_نوع_تصحيح = [];
    ليكن فهرس_الأنواع_بالرمز: متجه اختياري معرف_نوع_تصحيح = [];
    ليكن العوام: متجه عام_تصحيح = [];
    ليكن الثوابت: متجه ثابت_تصحيح = [];
    ليكن الوحدات: متجه وحدة_تصحيح = [];
    ليكن فهرس_الوحدات: متجه اختياري معرف_وحدة_تصحيح = [];
    ليكن التعابير: متجه تعبير_تصحيح = [];
    ليكن السياق: سياق_تصحيح = {
        المواقع: المواقع, فهرس_المواقع_بالأصل: فهرس_المواقع,
        النطاقات: النطاقات, فهرس_النطاقات_بالأصل: فهرس_النطاقات,
        الدوال: الدوال, المتغيرات: المتغيرات,
        الأنواع: الأنواع, فهرس_الأنواع_الدلالية: فهرس_الأنواع,
        فهرس_الأنواع_بالرمز: فهرس_الأنواع_بالرمز,
        العوام: العوام, الثوابت: الثوابت,
        الوحدات: الوحدات, فهرس_الوحدات: فهرس_الوحدات,
        التعابير: التعابير
    };
    أرجع السياق;
}

عام عرف انسخ_اسم_تصحيح(الاسم: &متجه ط8): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}
