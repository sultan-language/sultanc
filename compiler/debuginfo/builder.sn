استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;

عام عرف سياق_تصحيح_جديد(): سياق_تصحيح {
    دع المواقع: متجه موقع_تصحيح = [];
    دع فهرس_المواقع: متجه اختيار معرف_موقع_تصحيح = [];
    دع النطاقات: متجه نطاق_تصحيح = [];
    دع فهرس_النطاقات: متجه اختيار معرف_نطاق_تصحيح = [];
    دع الدوال: متجه دالة_تصحيح = [];
    دع المتغيرات: متجه متغير_تصحيح = [];
    دع الأنواع: متجه نوع_تصحيح = [];
    دع فهرس_الأنواع: متجه اختيار معرف_نوع_تصحيح = [];
    دع فهرس_الأنواع_بالرمز: متجه اختيار معرف_نوع_تصحيح = [];
    دع العوام: متجه عام_تصحيح = [];
    دع الثوابت: متجه ثابت_تصحيح = [];
    دع الوحدات: متجه وحدة_تصحيح = [];
    دع فهرس_الوحدات: متجه اختيار معرف_وحدة_تصحيح = [];
    دع التعابير: متجه تعبير_تصحيح = [];
    دع السياق: سياق_تصحيح = {
        المواقع: المواقع, فهرس_المواقع_بالأصل: فهرس_المواقع,
        النطاقات: النطاقات, فهرس_النطاقات_بالأصل: فهرس_النطاقات,
        الدوال: الدوال, المتغيرات: المتغيرات,
        الأنواع: الأنواع, فهرس_الأنواع_الدلالية: فهرس_الأنواع,
        فهرس_الأنواع_بالرمز: فهرس_الأنواع_بالرمز,
        العوام: العوام, الثوابت: الثوابت,
        الوحدات: الوحدات, فهرس_الوحدات: فهرس_الوحدات,
        التعابير: التعابير
    };
    أرجع السياق;
}

عام عرف انسخ_اسم_تصحيح(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}
