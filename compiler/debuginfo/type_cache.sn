استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;

عام نوع مخبأ_أنواع_تصحيح = {
    بالنوع: متجه اختياري معرف_نوع_تصحيح
};

عام عرف ابن_مخبأ_أنواع_تصحيح(السياق: &سياق_تصحيح): مخبأ_أنواع_تصحيح {
    دع الفهرس: متغير متجه اختياري معرف_نوع_تصحيح = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الأنواع) مثل طبيعي)) {
        دع سجل_النوع: &نوع_تصحيح = &(*السياق).الأنواع[ف];
        طابق (*سجل_النوع).اسم_مستعار_لـ مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            دع النوع: معرف_نوع = (*سجل_النوع).النوع;
            طالما ((الطول(الفهرس) مثل طبيعي) <= النوع.القيمة) {
                دع فارغ: اختياري معرف_نوع_تصحيح = اختياري.لا_شيء(); ألحق(الفهرس, فارغ);
            }
            الفهرس[النوع.القيمة] := اختياري.موجود((*سجل_النوع).المعرف);
        };
        ف := ف + 1;
    }
    دع المخبأ: مخبأ_أنواع_تصحيح = { بالنوع: الفهرس };
    أرجع المخبأ;
}

عام عرف نوع_تصحيح_لنوع(المخبأ: &مخبأ_أنواع_تصحيح, النوع: معرف_نوع): اختياري معرف_نوع_تصحيح {
    إذا (النوع.القيمة >= (الطول((*المخبأ).بالنوع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*المخبأ).بالنوع[النوع.القيمة];
}
