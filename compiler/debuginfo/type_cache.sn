استورد compiler.debuginfo.model;
استورد compiler.frontend.types.type_identity;

عام نوع مخبأ_أنواع_تصحيح = {
    بالنوع: متجه اختيار معرف_نوع_تصحيح
};

عام عرف ابن_مخبأ_أنواع_تصحيح(السياق: &سياق_تصحيح): مخبأ_أنواع_تصحيح {
    دع الفهرس: متغير متجه اختيار معرف_نوع_تصحيح = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الأنواع) مثل غير_موقع)) {
        دع سجل_النوع: &نوع_تصحيح = &(*السياق).الأنواع[ف];
        طابق (*سجل_النوع).اسم_مستعار_لـ مع
        | اختيار.بعض(_) -> { }
        | اختيار.لا_شيء -> {
            دع النوع: معرف_نوع = (*سجل_النوع).النوع;
            بينما ((الطول(الفهرس) مثل غير_موقع) <= النوع.القيمة) {
                دع فارغ: اختيار معرف_نوع_تصحيح = اختيار.لا_شيء(); ألحق(الفهرس, فارغ);
            }
            الفهرس[النوع.القيمة] := اختيار.بعض((*سجل_النوع).المعرف);
        };
        ف := ف + 1;
    }
    دع المخبأ: مخبأ_أنواع_تصحيح = { بالنوع: الفهرس };
    أرجع المخبأ;
}

عام عرف نوع_تصحيح_لنوع(المخبأ: &مخبأ_أنواع_تصحيح, النوع: معرف_نوع): اختيار معرف_نوع_تصحيح {
    لو (النوع.القيمة >= (الطول((*المخبأ).بالنوع) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*المخبأ).بالنوع[النوع.القيمة];
}
