استورد compiler.debuginfo.model;

// Globals and source-visible constants are canonical semantic debug facts.
// Current lowering can append them when their source declarations are preserved.
عام عرف أضف_عام_تصحيح(السياق: &متغير سياق_تصحيح, العام: عام_تصحيح): معرف_عام_تصحيح {
    دع المعرف: معرف_عام_تصحيح = معرف_عام_تصحيح_من(الطول((*السياق).العوام) مثل غير_موقع);
    دع القيمة: متغير عام_تصحيح = العام;
    القيمة.المعرف := المعرف;
    ألحق((*السياق).العوام, القيمة);
    أرجع المعرف;
}

عام عرف أضف_ثابت_تصحيح(السياق: &متغير سياق_تصحيح, الثابت: ثابت_تصحيح): معرف_ثابت_تصحيح {
    دع المعرف: معرف_ثابت_تصحيح = معرف_ثابت_تصحيح_من(الطول((*السياق).الثوابت) مثل غير_موقع);
    دع القيمة: متغير ثابت_تصحيح = الثابت;
    القيمة.المعرف := المعرف;
    ألحق((*السياق).الثوابت, القيمة);
    أرجع المعرف;
}
