استورد compiler.debuginfo.model;
استورد compiler.debuginfo.types;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.builtins_generated;
استورد std.text.from_bytes;

// Readable Type names for debuggers, shared by the DWARF writer and the LLVM
// provider. A declared Type keeps its source spelling (UTF-8, Arabic or
// English as written); builtin Types use SultanC's canonical spelling, as the
// compiler's own diagnostics print them: عدد, نص, متجه عدد, اختياري نقطة,
// نتيجة عدد, نص, (عدد, منطقي), &متغير نقطة, *ط8, دالة(عدد): منطقي.

عرف ألحق_نص_اسم_نوع_تصحيح(الناتج: &متغير متجه ط8, النص: نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) { ألحق(*الناتج, النص[ف]); ف := ف + 1; }
}

عرف ألحق_بايتات_اسم_نوع_تصحيح(الناتج: &متغير متجه ط8, البايتات: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) { ألحق(*الناتج, (*البايتات)[ف]); ف := ف + 1; }
}

عرف ألحق_رقم_اسم_نوع_تصحيح(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة >= 10) { ألحق_رقم_اسم_نوع_تصحيح(الناتج, القيمة / 10); };
    ألحق(*الناتج, (0x30 + القيمة % 10) مثل ط8);
}

// The declared name of a named Type, by its Symbol.
عرف ألحق_اسم_مصرح_تصحيح(
    الناتج: &متغير متجه ط8,
    السياق: &سياق_تصحيح,
    الرمز: معرف_رمز,
    النوع: معرف_نوع
): فراغ {
    طابق معرف_نوع_تصحيح_لرمز(السياق, الرمز) مع
    | اختياري.موجود(المعرف) -> {
        إذا (المعرف.القيمة < (الطول((*السياق).الأنواع) مثل طبيعي)) {
            ألحق_بايتات_اسم_نوع_تصحيح(الناتج, &(*السياق).الأنواع[المعرف.القيمة].الاسم);
            أرجع;
        };
    }
    | اختياري.لا_شيء -> { };
    // No declaration reached the debug context (a Type of a module whose
    // declarations were not lowered): its identity.
    ألحق_نص_اسم_نوع_تصحيح(الناتج, «نوع#»);
    ألحق_رقم_اسم_نوع_تصحيح(الناتج, النوع.القيمة);
}

عرف ألحق_اسم_نوع_تصحيح(
    الناتج: &متغير متجه ط8,
    السياق: &سياق_تصحيح,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع,
    العمق: طبيعي
): فراغ {
    إذا (العمق > 8 || (النوع.القيمة مثل طبيعي) >= (الطول((*الأنواع).الأنواع) مثل طبيعي)) {
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «…»);
        أرجع;
    };
    طابق (*الأنواع).الأنواع[النوع.القيمة] مع
    | نوع_مقنن.بدائي(البدائي) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, تهجئة_عرض_نوع_بدائي(البدائي)); }
    | نوع_مقنن.صف(العناصر) -> {
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «(»);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(العناصر) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_نص_اسم_نوع_تصحيح(الناتج, «, »); };
            ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, العناصر[ف], العمق + 1);
            ف := ف + 1;
        }
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «)»);
    }
    | نوع_مقنن.صندوق(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «صندوق »); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); }
    | نوع_مقنن.اختيار(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «اختياري »); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); }
    | نوع_مقنن.نتيجة(النجاح, الفشل) -> {
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «نتيجة »);
        ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, النجاح, العمق + 1);
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «, »);
        ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الفشل, العمق + 1);
    }
    | نوع_مقنن.دالة(المعاملات, الناتج_الدالة) -> {
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «دالة(»);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعاملات) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_نص_اسم_نوع_تصحيح(الناتج, «, »); };
            ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, المعاملات[ف], العمق + 1);
            ف := ف + 1;
        }
        ألحق_نص_اسم_نوع_تصحيح(الناتج, «): »);
        ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الناتج_الدالة, العمق + 1);
    }
    | نوع_مقنن.معامل_نوع(الرمز) -> { ألحق_اسم_مصرح_تصحيح(الناتج, السياق, الرمز, النوع); }
    | نوع_مقنن.مسمى(الرمز, _, الحجج) -> {
        ألحق_اسم_مصرح_تصحيح(الناتج, السياق, الرمز, النوع);
        إذا ((الطول(الحجج) مثل طبيعي) > 0) {
            ألحق_نص_اسم_نوع_تصحيح(الناتج, «<»);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحجج) مثل طبيعي)) {
                إذا (ف > 0) { ألحق_نص_اسم_نوع_تصحيح(الناتج, «, »); };
                ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الحجج[ف], العمق + 1);
                ف := ف + 1;
            }
            ألحق_نص_اسم_نوع_تصحيح(الناتج, «>»);
        };
    }
    | نوع_مقنن.مؤشر(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «*»); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); }
    | نوع_مقنن.مرجع(الداخل, متغير_المرجع) -> {
        إذا (متغير_المرجع) { ألحق_نص_اسم_نوع_تصحيح(الناتج, «&متغير »); } وإلا { ألحق_نص_اسم_نوع_تصحيح(الناتج, «&»); };
        ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1);
    }
    | نوع_مقنن.شريحة(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «شريحة »); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); }
    | نوع_مقنن.متجه(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «متجه »); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); }
    | نوع_مقنن.متغير(الداخل) -> { ألحق_نص_اسم_نوع_تصحيح(الناتج, «متغير »); ألحق_اسم_نوع_تصحيح(الناتج, السياق, الأنواع, الداخل, العمق + 1); };
}

// The debugger-facing name of a Type.
عام عرف اسم_نوع_تصحيح_معروض(
    السياق: &سياق_تصحيح,
    الأنواع: &سجل_أنواع,
    النوع: معرف_نوع
): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_اسم_نوع_تصحيح(&متغير الناتج, السياق, الأنواع, النوع, 0);
    أرجع الناتج;
}

// The name of constructor الفهرس of a builtin tagged Type (option,
// result), as the language spells it: لا_شيء and موجود, نجح and خطأ.
عام عرف اسم_منشئ_مدمج_تصحيح(الهوية: &هوية_منشئ_نوع): اختياري متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    طابق *الهوية مع
    | هوية_منشئ_نوع.اختيار_لا_شيء -> { ألحق_نص_اسم_نوع_تصحيح(&متغير الناتج, «لا_شيء»); }
    | هوية_منشئ_نوع.اختيار_بعض -> { ألحق_نص_اسم_نوع_تصحيح(&متغير الناتج, «موجود»); }
    | هوية_منشئ_نوع.نتيجة_نجاح -> { ألحق_نص_اسم_نوع_تصحيح(&متغير الناتج, «نجح»); }
    | هوية_منشئ_نوع.نتيجة_خطأ -> { ألحق_نص_اسم_نوع_تصحيح(&متغير الناتج, «خطأ»); }
    | هوية_منشئ_نوع.تعداد(_) -> { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الناتج);
}
