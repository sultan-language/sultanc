استورد compiler.debuginfo.model;
استورد compiler.source.provenance;

عام عرف سجل_موقع_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الأصل: معرف_أصل_مصدر,
    النطاق: اختياري معرف_نطاق_تصحيح,
    هو_عبارة: منطقي,
    نهاية_مقدمة: منطقي,
    بداية_خاتمة: منطقي,
    المميز: طبيعي
): معرف_موقع_تصحيح {
    طالما ((الطول((*السياق).فهرس_المواقع_بالأصل) مثل طبيعي) <= الأصل.القيمة) {
        دع فارغ: اختياري معرف_موقع_تصحيح = اختياري.لا_شيء();
        ألحق((*السياق).فهرس_المواقع_بالأصل, فارغ);
    }
    طابق (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] مع
    | اختياري.موجود(الموجود) -> {
        إذا (الموجود.القيمة < (الطول((*السياق).المواقع) مثل طبيعي)) {
            دع السابق: &موقع_تصحيح = &(*السياق).المواقع[الموجود.القيمة];
            دع نفس_النطاق: متغير منطقي = خطأ;
            طابق (*السابق).النطاق مع
            | اختياري.لا_شيء -> {
                طابق النطاق مع
                | اختياري.لا_شيء -> { نفس_النطاق := صواب; }
                | اختياري.موجود(_) -> { };
            }
            | اختياري.موجود(أ) -> {
                طابق النطاق مع
                | اختياري.موجود(ب) -> { نفس_النطاق := أ.القيمة == ب.القيمة; }
                | اختياري.لا_شيء -> { };
            };
            إذا (نفس_النطاق
                && (*السابق).هو_عبارة == هو_عبارة
                && (*السابق).نهاية_مقدمة == نهاية_مقدمة
                && (*السابق).بداية_خاتمة == بداية_خاتمة
                && (*السابق).المميز == المميز) {
                أرجع الموجود;
            };
        };
    }
    | اختياري.لا_شيء -> { };
    دع المعرف: معرف_موقع_تصحيح = معرف_موقع_تصحيح_من(الطول((*السياق).المواقع) مثل طبيعي);
    دع الموقع: موقع_تصحيح = {
        المعرف: المعرف,
        الأصل: الأصل,
        النطاق: النطاق,
        هو_عبارة: هو_عبارة,
        نهاية_مقدمة: نهاية_مقدمة,
        بداية_خاتمة: بداية_خاتمة,
        المميز: المميز
    };
    ألحق((*السياق).المواقع, الموقع);
    طابق (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] مع
    | اختياري.لا_شيء -> { (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] := اختياري.موجود(المعرف); }
    | اختياري.موجود(_) -> { };
    أرجع المعرف;
}

عام عرف موقع_تصحيح_لأصل(
    السياق: &سياق_تصحيح,
    الأصل: معرف_أصل_مصدر
): اختياري معرف_موقع_تصحيح {
    إذا (الأصل.القيمة >= (الطول((*السياق).فهرس_المواقع_بالأصل) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة];
}
