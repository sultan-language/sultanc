استورد compiler.debuginfo.model;
استورد compiler.source.provenance;

عام عرف سجل_موقع_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الأصل: معرف_أصل_مصدر,
    النطاق: اختيار معرف_نطاق_تصحيح,
    هو_عبارة: منطقي,
    نهاية_مقدمة: منطقي,
    بداية_خاتمة: منطقي,
    المميز: غير_موقع
): معرف_موقع_تصحيح {
    بينما ((الطول((*السياق).فهرس_المواقع_بالأصل) مثل غير_موقع) <= الأصل.القيمة) {
        دع فارغ: اختيار معرف_موقع_تصحيح = اختيار.لا_شيء();
        ألحق((*السياق).فهرس_المواقع_بالأصل, فارغ);
    }
    طابق (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] مع
    | اختيار.بعض(الموجود) -> {
        لو (الموجود.القيمة < (الطول((*السياق).المواقع) مثل غير_موقع)) {
            دع السابق: &موقع_تصحيح = &(*السياق).المواقع[الموجود.القيمة];
            دع نفس_النطاق: متغير منطقي = خطأ;
            طابق (*السابق).النطاق مع
            | اختيار.لا_شيء -> {
                طابق النطاق مع
                | اختيار.لا_شيء -> { نفس_النطاق := صواب; }
                | اختيار.بعض(_) -> { };
            }
            | اختيار.بعض(أ) -> {
                طابق النطاق مع
                | اختيار.بعض(ب) -> { نفس_النطاق := أ.القيمة == ب.القيمة; }
                | اختيار.لا_شيء -> { };
            };
            لو (نفس_النطاق
                && (*السابق).هو_عبارة == هو_عبارة
                && (*السابق).نهاية_مقدمة == نهاية_مقدمة
                && (*السابق).بداية_خاتمة == بداية_خاتمة
                && (*السابق).المميز == المميز) {
                أرجع الموجود;
            };
        };
    }
    | اختيار.لا_شيء -> { };
    دع المعرف: معرف_موقع_تصحيح = معرف_موقع_تصحيح_من(الطول((*السياق).المواقع) مثل غير_موقع);
    دع الموقع: موقع_تصحيح = {
        المعرف: المعرف,
        الأصل: الأصل,
        النطاق: النطاق,
        هو_عبارة: هو_عبارة,
        نهاية_مقدمة: نهاية_مقدمة,
        بداية_خاتمة: بداية_خاتمة,
        المميز: المميز
    };
    ألحق((*السياق).المواقع, الموقع);
    طابق (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] مع
    | اختيار.لا_شيء -> { (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة] := اختيار.بعض(المعرف); }
    | اختيار.بعض(_) -> { };
    أرجع المعرف;
}

عام عرف موقع_تصحيح_لأصل(
    السياق: &سياق_تصحيح,
    الأصل: معرف_أصل_مصدر
): اختيار معرف_موقع_تصحيح {
    لو (الأصل.القيمة >= (الطول((*السياق).فهرس_المواقع_بالأصل) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*السياق).فهرس_المواقع_بالأصل[الأصل.القيمة];
}
