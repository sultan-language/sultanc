استورد compiler.debuginfo.model;
استورد compiler.source.provenance;
استورد compiler.source.span;

عام عرف أضف_نطاق_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الأصل: معرف_أصل_مصدر,
    المدى: نطاق,
    الدالة: معرف_دالة_تصحيح,
    الأب: اختيار معرف_نطاق_تصحيح,
    مضمن_عند: اختيار معرف_موقع_تصحيح
): معرف_نطاق_تصحيح {
    دع المعرف: معرف_نطاق_تصحيح = معرف_نطاق_تصحيح_من(الطول((*السياق).النطاقات) مثل غير_موقع);
    دع الأبناء: متجه معرف_نطاق_تصحيح = [];
    دع المحليات: متجه معرف_متغير_تصحيح = [];
    دع النطاق: نطاق_تصحيح = {
        المعرف: المعرف, الأصل: الأصل, المدى: المدى, الأب: الأب,
        الأبناء: الأبناء, المحليات: المحليات,
        الدالة: الدالة, مضمن_عند: مضمن_عند
    };
    ألحق((*السياق).النطاقات, النطاق);
    بينما ((الطول((*السياق).فهرس_النطاقات_بالأصل) مثل غير_موقع) <= الأصل.القيمة) {
        دع فارغ: اختيار معرف_نطاق_تصحيح = اختيار.لا_شيء(); ألحق((*السياق).فهرس_النطاقات_بالأصل, فارغ);
    }
    (*السياق).فهرس_النطاقات_بالأصل[الأصل.القيمة] := اختيار.بعض(المعرف);
    طابق الأب مع
    | اختيار.بعض(معرف_الأب) -> {
        لو (معرف_الأب.القيمة < (الطول((*السياق).النطاقات) مثل غير_موقع)) {
            ألحق((*السياق).النطاقات[معرف_الأب.القيمة].الأبناء, المعرف);
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع المعرف;
}

عام عرف نطاق_تصحيح_لأصل(السياق: &سياق_تصحيح, الأصل: معرف_أصل_مصدر): اختيار معرف_نطاق_تصحيح {
    لو (الأصل.القيمة >= (الطول((*السياق).فهرس_النطاقات_بالأصل) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع (*السياق).فهرس_النطاقات_بالأصل[الأصل.القيمة];
}
