استورد compiler.debuginfo.model;
استورد compiler.source.provenance;
استورد compiler.source.span;

// Debug facts of one inlined call. The inliner (msir_inlining.sn) copies a
// callee's body into its caller; this owner gives the copy its own scope tree
// and variables, so the debugger still sees the callee: an inlined-call scope
// (its function is the caller, its inlined function the callee, its
// مضمن_عند the call's location) holds a copy of each callee scope and
// variable. The callee's own records are never changed: the callee may still
// be called, or inlined elsewhere.
عام نوع خريطة_تضمين_تصحيح = {
    // The inlined-call scope (the copy of the callee's root scope).
    الجذر: معرف_نطاق_تصحيح,
    // Callee scope and variable identities and their copies, in parallel.
    نطاقات_المستدعى: متجه طبيعي,
    النطاقات_الجديدة: متجه طبيعي,
    متغيرات_المستدعى: متجه طبيعي,
    المتغيرات_الجديدة: متجه طبيعي
};

// The map of no inlined call (before one is opened).
عام عرف خريطة_تضمين_تصحيح_فارغة(): خريطة_تضمين_تصحيح {
    دع نطاقات: متجه طبيعي = [];
    دع نطاقات_جديدة: متجه طبيعي = [];
    دع متغيرات: متجه طبيعي = [];
    دع متغيرات_جديدة: متجه طبيعي = [];
    دع الخريطة: خريطة_تضمين_تصحيح = {
        الجذر: معرف_نطاق_تصحيح_من(0),
        نطاقات_المستدعى: نطاقات, النطاقات_الجديدة: نطاقات_جديدة,
        متغيرات_المستدعى: متغيرات, المتغيرات_الجديدة: متغيرات_جديدة
    };
    أرجع الخريطة;
}

// Appends a scope without registering it in the by-origin index: a copy
// shares its origin with the callee's scope, which keeps that index entry.
عرف ألحق_نطاق_منسوخ_تصحيح(
    السياق: &متغير سياق_تصحيح,
    الأصل: معرف_أصل_مصدر,
    المدى: نطاق,
    الدالة: معرف_دالة_تصحيح,
    الأب: اختياري معرف_نطاق_تصحيح,
    مضمن_عند: اختياري معرف_موقع_تصحيح,
    الدالة_المضمنة: اختياري معرف_دالة_تصحيح
): معرف_نطاق_تصحيح {
    دع المعرف: معرف_نطاق_تصحيح = معرف_نطاق_تصحيح_من(الطول((*السياق).النطاقات) مثل طبيعي);
    دع الأبناء: متجه معرف_نطاق_تصحيح = [];
    دع المحليات: متجه معرف_متغير_تصحيح = [];
    دع النطاق: نطاق_تصحيح = {
        المعرف: المعرف, الأصل: الأصل, المدى: المدى, الأب: الأب,
        الأبناء: الأبناء, المحليات: المحليات,
        الدالة: الدالة, مضمن_عند: مضمن_عند, الدالة_المضمنة: الدالة_المضمنة
    };
    ألحق((*السياق).النطاقات, النطاق);
    طابق الأب مع
    | اختياري.موجود(معرف_الأب) -> {
        إذا (معرف_الأب.القيمة < (الطول((*السياق).النطاقات) مثل طبيعي)) {
            ألحق((*السياق).النطاقات[معرف_الأب.القيمة].الأبناء, المعرف);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع المعرف;
}

عرف انسخ_متغيرات_نطاق_تصحيح(
    السياق: &متغير سياق_تصحيح,
    النطاق_الأصلي: طبيعي,
    النطاق_الجديد: معرف_نطاق_تصحيح,
    الخريطة: &متغير خريطة_تضمين_تصحيح
): فراغ {
    دع ل: متغير طبيعي = 0;
    طالما (ل < (الطول((*السياق).النطاقات[النطاق_الأصلي].المحليات) مثل طبيعي)) {
        دع القديم: طبيعي = (*السياق).النطاقات[النطاق_الأصلي].المحليات[ل].القيمة;
        إذا (القديم < (الطول((*السياق).المتغيرات) مثل طبيعي)) {
            دع الجديد: معرف_متغير_تصحيح = معرف_متغير_تصحيح_من(الطول((*السياق).المتغيرات) مثل طبيعي);
            دع الاسم: متغير متجه ط8 = [];
            دع ح: متغير طبيعي = 0;
            طالما (ح < (الطول((*السياق).المتغيرات[القديم].الاسم) مثل طبيعي)) {
                ألحق(الاسم, (*السياق).المتغيرات[القديم].الاسم[ح]);
                ح := ح + 1;
            }
            دع المتغير: متغير_تصحيح = {
                المعرف: الجديد,
                الرمز: (*السياق).المتغيرات[القديم].الرمز,
                الاسم: الاسم,
                النوع: (*السياق).المتغيرات[القديم].النوع,
                الأصل: (*السياق).المتغيرات[القديم].الأصل,
                النطاق: النطاق_الجديد,
                الصنف: (*السياق).المتغيرات[القديم].الصنف,
                اصطناعي: (*السياق).المتغيرات[القديم].اصطناعي
            };
            ألحق((*السياق).المتغيرات, المتغير);
            ألحق((*السياق).النطاقات[النطاق_الجديد.القيمة].المحليات, الجديد);
            ألحق((*الخريطة).متغيرات_المستدعى, القديم);
            ألحق((*الخريطة).المتغيرات_الجديدة, الجديد.القيمة);
        };
        ل := ل + 1;
    }
}

// Copies the scope tree below النطاق_الأصلي (already copied as
// النطاق_الجديد), depth first, with the variables of every scope.
عرف انسخ_أبناء_نطاق_تصحيح(
    السياق: &متغير سياق_تصحيح,
    النطاق_الأصلي: طبيعي,
    النطاق_الجديد: معرف_نطاق_تصحيح,
    المستدعي: معرف_دالة_تصحيح,
    الخريطة: &متغير خريطة_تضمين_تصحيح
): فراغ {
    انسخ_متغيرات_نطاق_تصحيح(السياق, النطاق_الأصلي, النطاق_الجديد, الخريطة);
    دع عدد_الأبناء: طبيعي = الطول((*السياق).النطاقات[النطاق_الأصلي].الأبناء) مثل طبيعي;
    دع ط: متغير طبيعي = 0;
    طالما (ط < عدد_الأبناء) {
        دع الابن: طبيعي = (*السياق).النطاقات[النطاق_الأصلي].الأبناء[ط].القيمة;
        إذا (الابن < (الطول((*السياق).النطاقات) مثل طبيعي)) {
            دع الأصل: معرف_أصل_مصدر = (*السياق).النطاقات[الابن].الأصل;
            دع المدى: نطاق = (*السياق).النطاقات[الابن].المدى;
            دع مضمن_عند: اختياري معرف_موقع_تصحيح = (*السياق).النطاقات[الابن].مضمن_عند;
            دع الدالة_المضمنة: اختياري معرف_دالة_تصحيح = (*السياق).النطاقات[الابن].الدالة_المضمنة;
            دع النسخة: معرف_نطاق_تصحيح = ألحق_نطاق_منسوخ_تصحيح(
                السياق, الأصل, المدى, المستدعي, اختياري.موجود(النطاق_الجديد), مضمن_عند, الدالة_المضمنة
            );
            ألحق((*الخريطة).نطاقات_المستدعى, الابن);
            ألحق((*الخريطة).النطاقات_الجديدة, النسخة.القيمة);
            انسخ_أبناء_نطاق_تصحيح(السياق, الابن, النسخة, المستدعي, الخريطة);
        };
        ط := ط + 1;
    }
}

// Opens the debug facts of one inlined call of المستدعى into المستدعي, at
// the call's scope and location. Without a root scope for the callee the
// inlined-call scope is still made (a copy of nothing), so the inlined code
// is never attributed to the caller's own scopes.
عام عرف افتح_تضمين_تصحيح(
    السياق: &متغير سياق_تصحيح,
    المستدعي: معرف_دالة_تصحيح,
    المستدعى: معرف_دالة_تصحيح,
    نطاق_النداء: اختياري معرف_نطاق_تصحيح,
    موقع_النداء: اختياري معرف_موقع_تصحيح
): خريطة_تضمين_تصحيح {
    دع نطاقات: متجه طبيعي = [];
    دع نطاقات_جديدة: متجه طبيعي = [];
    دع متغيرات: متجه طبيعي = [];
    دع متغيرات_جديدة: متجه طبيعي = [];
    دع الخريطة: متغير خريطة_تضمين_تصحيح = {
        الجذر: معرف_نطاق_تصحيح_من(0),
        نطاقات_المستدعى: نطاقات, النطاقات_الجديدة: نطاقات_جديدة,
        متغيرات_المستدعى: متغيرات, المتغيرات_الجديدة: متغيرات_جديدة
    };
    دع جذر_المستدعى: متغير اختياري معرف_نطاق_تصحيح = اختياري.لا_شيء();
    دع أصل_المستدعى: متغير معرف_أصل_مصدر = { القيمة: 0 };
    إذا (المستدعى.القيمة < (الطول((*السياق).الدوال) مثل طبيعي)) {
        جذر_المستدعى := (*السياق).الدوال[المستدعى.القيمة].النطاق_الجذري;
        أصل_المستدعى := (*السياق).الدوال[المستدعى.القيمة].الأصل;
    };
    دع المضمنة: اختياري معرف_دالة_تصحيح = اختياري.موجود(المستدعى);
    طابق جذر_المستدعى مع
    | اختياري.موجود(الجذر) -> {
        إذا (الجذر.القيمة < (الطول((*السياق).النطاقات) مثل طبيعي)) {
            دع الأصل: معرف_أصل_مصدر = (*السياق).النطاقات[الجذر.القيمة].الأصل;
            دع المدى: نطاق = (*السياق).النطاقات[الجذر.القيمة].المدى;
            دع النسخة: معرف_نطاق_تصحيح = ألحق_نطاق_منسوخ_تصحيح(
                السياق, الأصل, المدى, المستدعي, نطاق_النداء, موقع_النداء, المضمنة
            );
            الخريطة.الجذر := النسخة;
            ألحق(الخريطة.نطاقات_المستدعى, الجذر.القيمة);
            ألحق(الخريطة.النطاقات_الجديدة, النسخة.القيمة);
            انسخ_أبناء_نطاق_تصحيح(السياق, الجذر.القيمة, النسخة, المستدعي, &متغير الخريطة);
            أرجع الخريطة;
        };
    }
    | اختياري.لا_شيء -> { };
    // No callee scope tree: an empty inlined-call scope.
    دع بلا_موضع: موضع = { المصدر: 0, البايت: 0 };
    دع بلا_مدى: نطاق = { البداية: بلا_موضع, النهاية: بلا_موضع };
    الخريطة.الجذر := ألحق_نطاق_منسوخ_تصحيح(السياق, أصل_المستدعى, بلا_مدى, المستدعي, نطاق_النداء, موقع_النداء, المضمنة);
    أرجع الخريطة;
}

// The copy of a callee scope, or the inlined-call scope for an instruction
// with no scope or with a scope outside the callee's tree.
عام عرف نطاق_مضمن_تصحيح(
    الخريطة: &خريطة_تضمين_تصحيح,
    النطاق: اختياري معرف_نطاق_تصحيح
): معرف_نطاق_تصحيح {
    طابق النطاق مع
    | اختياري.موجود(المعرف) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الخريطة).نطاقات_المستدعى) مثل طبيعي)) {
            إذا ((*الخريطة).نطاقات_المستدعى[ف] == المعرف.القيمة) {
                أرجع معرف_نطاق_تصحيح_من((*الخريطة).النطاقات_الجديدة[ف]);
            };
            ف := ف + 1;
        }
    }
    | اختياري.لا_شيء -> { };
    أرجع (*الخريطة).الجذر;
}

// The copy of a callee variable.
عام عرف متغير_مضمن_تصحيح(
    الخريطة: &خريطة_تضمين_تصحيح,
    المتغير: معرف_متغير_تصحيح
): اختياري معرف_متغير_تصحيح {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخريطة).متغيرات_المستدعى) مثل طبيعي)) {
        إذا ((*الخريطة).متغيرات_المستدعى[ف] == المتغير.القيمة) {
            أرجع اختياري.موجود(معرف_متغير_تصحيح_من((*الخريطة).المتغيرات_الجديدة[ف]));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
