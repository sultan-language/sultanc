استورد compiler.debuginfo.model;

عام عرف أضف_تعبير_تصحيح(
    السياق: &متغير سياق_تصحيح,
    العمليات: متجه عملية_تعبير_تصحيح
): معرف_تعبير_تصحيح {
    دع المعرف: معرف_تعبير_تصحيح = معرف_تعبير_تصحيح_من(الطول((*السياق).التعابير) مثل غير_موقع);
    دع التعبير: تعبير_تصحيح = { المعرف: المعرف, العمليات: العمليات };
    ألحق((*السياق).التعابير, التعبير);
    أرجع المعرف;
}
