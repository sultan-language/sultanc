عرف أضف_سبب_ترميز_ذراع(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_ترميز_ذراع_أربعة_وستون
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64»);
    طابق الخطأ مع
    | خطأ_ترميز_ذراع_أربعة_وستون.هدف_غير_صالح(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.invalid-target»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.سجل_فعلي_غير_صالح(السجل) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.invalid-physical-register»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.سجل_واجهة_غير_متطابق(السجل) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.abi-register-mismatch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فوري_حساب_خارج_المدى(القيمة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.arithmetic-immediate-out-of-range»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_ذاكرة_خارج_المدى(الإزاحة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.memory-offset-out-of-range»); أضف_عدد_موقع_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), الإزاحة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(العرض) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-memory-width»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_ذراع_أربعة_وستون.عرض_عدد_غير_مدعوم(العرض) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-integer-width»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_ذراع_أربعة_وستون.موقع_واجهة_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-abi-location»); }
    | خطأ_ترميز_ذراع_أربعة_وستون.موضع_إطار_مفقود(الموضع) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.missing-frame-slot»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الموضع); }
    | خطأ_ترميز_ذراع_أربعة_وستون.إزاحة_انسكاب_خارج_المدى(الإزاحة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.spill-offset-out-of-range»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), الإزاحة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.هدف_كتلة_مفقود(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.missing-block-target»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فرع_غير_محاذى(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unaligned-branch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.فرع_خارج_المدى(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.branch-out-of-range»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_ذراع_أربعة_وستون.نقل_حافة_غير_قابل_للترميز -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unencodable-edge-move»); }
    | خطأ_ترميز_ذراع_أربعة_وستون.تخصيص_ذاكرة_غير_متاح -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.memory-allocation-unavailable»); };
}

عرف أضف_سبب_ترميز_إكس(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «x86_64»);
    طابق الخطأ مع
