استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.diagnostics.primitive_identity_presentation;
استورد compiler.backend.native_output;
استورد compiler.backend.provider.native.native_codegen;
