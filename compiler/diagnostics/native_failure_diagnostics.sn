    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تحويل_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-conversion»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.حساب_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-arithmetic»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_غير_مدعومة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-compare»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.مقارنة_ليست_شرط_المنهي -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.compare-not-terminator-condition»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.عملية_غير_مدعومة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-operation»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.منهي_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-terminator»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.معاملات_كتلة_غير_مدعومة(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-block-parameters»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.واجهة_دالة_غير_مدعومة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.function-abi-unavailable»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.فشل_حل_واجهة(الخطأ) -> { أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نداء_دالة_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-call»); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unlowered-primitive»); أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)); }
    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.تخطيط_غير_متاح(سبب_التخطيط) -> { أضف_سبب_تخطيط_إكس(التشخيص, سبب_التخطيط); };
}

عرف أضف_فشل_اختيار_أصلي(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_شفرة_منتقاة_أصلية
): فراغ {
    طابق الفشل مع
    | فشل_شفرة_منتقاة_أصلية.اختيار_ذراع_أربعة_وستون(فشل_ذراع) -> {
        أضف_سياق_اختيار_ذراع(التشخيص, &فشل_ذراع);
        أضف_سبب_اختيار_ذراع(التشخيص, فشل_ذراع.السبب);
    }
    | فشل_شفرة_منتقاة_أصلية.اختيار_إكس_ستة_وثمانون_أربعة_وستون(فشل_إكس) -> {
        أضف_سياق_اختيار_إكس(التشخيص, &فشل_إكس);
        أضف_سبب_اختيار_إكس(التشخيص, فشل_إكس.السبب);
    }
    | فشل_شفرة_منتقاة_أصلية.قدرة_منتق_أصلي_غير_متاحة(الهدف) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.native-selector-capability-unavailable»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
    };
}

عرف أضف_فشل_تخصيص_ذراع(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_تخصيص_ذراع_أربعة_وستون
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64»);
    طابق الفشل مع
    | فشل_تخصيص_ذراع_أربعة_وستون.يحتاج_انسكاب(السبب) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «allocation.needs-spill»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السبب.السجل.القيمة); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), السبب.عند_الموضع); }
    | فشل_تخصيص_ذراع_أربعة_وستون.فشل_قيود(السجل) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «allocation.constraint-failure»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_ذراع_أربعة_وستون.حالة_انسكاب_غير_مدعومة(السجل) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «allocation.unsupported-spill-state»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | فشل_تخصيص_ذراع_أربعة_وستون.سياسة_إطار_غير_متاحة(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «allocation.frame-policy-unavailable»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | فشل_تخصيص_ذراع_أربعة_وستون.هدف_غير_صالح(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «allocation.invalid-target»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); };
}

