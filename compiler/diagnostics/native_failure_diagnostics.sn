عرف أضف_سبب_اختيار_ذراع(
    التشخيص: &متغير تشخيص,
    السبب: خطأ_اختيار_ذراع_أربعة_وستون
): فراغ {
    طابق السبب مع
    | خطأ_اختيار_ذراع_أربعة_وستون.هدف_ليس_ذراع_أربعة_وستون(الهدف) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.target-mismatch»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.دالة_مسير_مفقودة(الدالة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.missing-msir-function»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.كتلة_مسير_مفقودة(الكتلة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.missing-msir-block»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.قيمة_مسير_مفقودة(القيمة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.missing-msir-value»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.ناتج_تعليمة_مفقود -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.missing-instruction-result»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.نوع_قيمة_مفقود(القيمة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.missing-value-type»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.نوع_غير_صحيح -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.non-integer-type»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.عملية_غير_مدعومة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-operation»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.ثابت_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-constant»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.حساب_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-arithmetic»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.منهي_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-terminator»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.حافة_غير_صالحة(الكتلة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.invalid-edge»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_اختيار_ذراع_أربعة_وستون.واجهة_دالة_غير_متاحة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.function-abi-unavailable»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.فشل_حل_واجهة(الخطأ) -> { أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ); }
    | خطأ_اختيار_ذراع_أربعة_وستون.بدائي_مسير_غير_مخفض(البدائي) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unlowered-primitive»); أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي)); }
    | خطأ_اختيار_ذراع_أربعة_وستون.ثابت_نص_يحتاج_مقطع_بيانات -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.text-constant-needs-data-section»); }
    | خطأ_اختيار_ذراع_أربعة_وستون.تخطيط_غير_متاح(سبب_التخطيط) -> { أضف_سبب_تخطيط_ذراع(التشخيص, سبب_التخطيط); };
}

عرف أضف_سبب_اختيار_إكس(
    التشخيص: &متغير تشخيص,
    السبب: خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون
