    | خطأ_اختيار_إكس_ستة_وثمانون_أربعة_وستون.نوع_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unsupported-type»); }
