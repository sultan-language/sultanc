    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_فعلي_غير_صالح(السجل) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.invalid-physical-register»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), السجل.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.دالة_مكررة(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.duplicate-function»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.كتلة_مكررة(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.duplicate-block»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.هدف_كتلة_مفقود(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.missing-block-target»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.فرع_خارج_مدى_نسبي_32(الكتلة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.rel32-branch-out-of-range»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجل_واجهة_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-abi-register»); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عنوان_ذاكرة_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-memory-address»); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.عرض_ذاكرة_غير_مدعوم(العرض) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unsupported-memory-width»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), العرض); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نقل_حافة_غير_قابل_للترميز -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.unencodable-edge-move»); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.سجلات_عمل_غير_كافية -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.insufficient-work-registers»); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.موضع_محلي_مفقود(الموضع) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.missing-local-slot»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الموضع); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.تخصيص_ذاكرة_غير_متاح -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.memory-allocation-unavailable»); }
    | خطأ_ترميز_إكس_ستة_وثمانون_أربعة_وستون.نداء_تشغيل_خارج_المدى -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «encoding.runtime-call-out-of-range»); };
}


عرف أضف_فشل_دخول_أصلي(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_حل_دخول_أصلي
): فراغ {
    طابق الفشل مع
    | فشل_حل_دخول_أصلي.دالة_مسير_مفقودة(الدالة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «entry.missing-msir-function»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | فشل_حل_دخول_أصلي.واجهة_دخول_غير_متاحة(الدالة, الخطأ) -> {
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        أضف_خطأ_حل_واجهة_اختيار_أصلي(التشخيص, الخطأ);
    }
    | فشل_حل_دخول_أصلي.هدف_دخول_غير_متاح(الهدف) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «entry.target-capability-unavailable»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
    }
    | فشل_حل_دخول_أصلي.مهايئ_دخول_مطلوب(الدالة) -> {
        أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «entry.adapter-required»);
        أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    };
}

عرف أضف_خطأ_ماتشو_أصلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_ماتشو
): فراغ {
    طابق الخطأ مع
    | خطأ_ماتشو.هدف_غير_متوافق(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.target-mismatch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_ماتشو.دالة_مكررة(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.duplicate-function»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.كلمة_تعليمة_خارج_نطاق_غ32(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.instruction-word-out-of-range»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.تثبيت_غير_صالح(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.invalid-fixup»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.إضافة_تثبيت_غير_مدعومة(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.unsupported-fixup-addend»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.طلب_إزاحة_غير_صالح(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.invalid-relocation-request»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_ماتشو.نوع_إزاحة_غير_مدعوم -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.unsupported-relocation-kind»); }
    | خطأ_ماتشو.رمز_تشغيل_غير_متاح -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.runtime-symbol-unavailable»); }
    | خطأ_ماتشو.بيانات_ثابتة_مكررة(القيمة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.duplicate-static-data»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة); }
    | خطأ_ماتشو.حدود_صيغة_متجاوزة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.format-limit-exceeded»); }
    | خطأ_ماتشو.قسم_نص_مفقود -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.missing-text-section»); }
    | خطأ_ماتشو.رمز_إزاحة_مفقود -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.missing-relocation-symbol»); }
    | خطأ_ماتشو.رمز_دخول_مفقود(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.macho.missing-entry-symbol»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); };
}

عرف أضف_فشل_كائن_ذراع(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_إصدار_كائن_ذراع
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64/macho»);
    طابق الفشل مع
    | فشل_إصدار_كائن_ذراع.قدرة_مخرج_غير_متاحة(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.capability-unavailable»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | فشل_إصدار_كائن_ذراع.هدف_غير_متطابق(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.target-mismatch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | فشل_إصدار_كائن_ذراع.خطأ_ماتشو(الخطأ) -> { أضف_خطأ_ماتشو_أصلي(التشخيص, الخطأ); };
}

عرف أضف_خطأ_إلف_أصلي(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_إلف
): فراغ {
    طابق الخطأ مع
    | خطأ_إلف.هدف_غير_متوافق(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.target-mismatch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_إلف.معمارية_غير_مدعومة(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.unsupported-architecture»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_إلف.صيغة_كائن_غير_مدعومة(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.unsupported-object-format»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_إلف.نموذج_بيانات_غير_مدعوم(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.unsupported-data-model»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | خطأ_إلف.رمز_مكرر -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.duplicate-symbol»); }
    | خطأ_إلف.إزاحة_نداء_خارج_النص -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.call-relocation-outside-text»); }
    | خطأ_إلف.إضافة_إزاحة_غير_مدعومة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.unsupported-relocation-addend»); }
    | خطأ_إلف.رمز_إزاحة_مفقود -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.missing-relocation-symbol»); }
    | خطأ_إلف.رمز_دخول_مفقود(الدالة) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.missing-entry-symbol»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة); }
    | خطأ_إلف.حدود_صيغة_متجاوزة -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.elf.format-limit-exceeded»); };
}

عرف أضف_فشل_كائن_إكس(
    التشخيص: &متغير تشخيص,
    الفشل: فشل_إصدار_كائن_إكس
): فراغ {
    أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السياق(), «x86_64/elf»);
    طابق الفشل مع
    | فشل_إصدار_كائن_إكس.قدرة_مخرج_غير_متاحة(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.capability-unavailable»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | فشل_إصدار_كائن_إكس.هدف_غير_متطابق(الهدف) -> { أضف_نص_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.السبب(), «object.target-mismatch»); أضف_عدد_فشل_أصلي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة); }
    | فشل_إصدار_كائن_إكس.خطأ_إلف(الخطأ) -> { أضف_خطأ_إلف_أصلي(التشخيص, الخطأ); };
}

عام عرف حول_فشل_مخرج_أصلي_إلى_تشخيصات(
    الفشل: &فشل_مخرج_أصلي
): مجموعة_تشخيصات {
    دع الحالة: فشل_مخرج_أصلي = *الفشل;
    دع التشخيص: متغير تشخيص;
    طابق الحالة مع
    | فشل_مخرج_أصلي.قدرة_مخرج_غير_متاحة(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-output»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «native-output.capability-unavailable»);
        أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
    }
    | فشل_مخرج_أصلي.بدائي_مسير_غير_مخفض(البدائي) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.unlowered-primitive»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.البدائي(), نص_هوية_بدائي_تشخيصية(البدائي));
    }
    | فشل_مخرج_أصلي.دخول_تنفيذي(فشل_الدخول) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-entry»);
        أضف_فشل_دخول_أصلي(&متغير التشخيص, فشل_الدخول);
    }
    | فشل_مخرج_أصلي.اختيار(فشل_الاختيار) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_فشل_اختيار_أصلي(&متغير التشخيص, فشل_الاختيار);
    }
    | فشل_مخرج_أصلي.اختيار_غير_متطابق(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-selection»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «selection.target-result-mismatch»);
        أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
    }
    | فشل_مخرج_أصلي.تخصيص_ذراع(فشل_التخصيص) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-allocation»);
        أضف_فشل_تخصيص_ذراع(&متغير التشخيص, فشل_التخصيص);
    }
    | فشل_مخرج_أصلي.ترميز_ذراع(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-encoding»);
        أضف_سبب_ترميز_ذراع(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.إكمال_تشغيل_ذراع(خطأ_الإكمال) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-runtime-encoding»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السياق(), «arm64/darwin»);
        طابق خطأ_الإكمال مع
        | خطأ_إكمال_ترميز_تشغيل_ذراع.هدف_غير_متطابق(الهدف) -> {
            أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «runtime-encoding.target-mismatch»);
            أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
        }
        | خطأ_إكمال_ترميز_تشغيل_ذراع.بدائي_غير_مدعوم(البدائي) -> {
            أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «runtime-encoding.unsupported-primitive»);
            أضف_نص_فشل_أصلي(
                &متغير التشخيص,
                مفتاح_حجة_تشخيص.البدائي(),
                نص_هوية_بدائي_تشخيصية(البدائي)
            );
        }
        | خطأ_إكمال_ترميز_تشغيل_ذراع.نداء_تشغيل_خارج_المدى -> {
            أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «runtime-encoding.call-out-of-range»);
        };
    }
    | فشل_مخرج_أصلي.كائن_ذراع(فشل_الكائن) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-object»);
        أضف_فشل_كائن_ذراع(&متغير التشخيص, فشل_الكائن);
    }
    | فشل_مخرج_أصلي.تخصيص_إكس(فشل_التخصيص) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-allocation»);
        أضف_فشل_تخصيص_إكس(&متغير التشخيص, فشل_التخصيص);
    }
    | فشل_مخرج_أصلي.ترميز_إكس(الخطأ) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-encoding»);
        أضف_سبب_ترميز_إكس(&متغير التشخيص, الخطأ);
    }
    | فشل_مخرج_أصلي.إكمال_تشغيل_إكس(خطأ_الإكمال) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-runtime-encoding»);
        أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السياق(), «x86_64/linux»);
        طابق خطأ_الإكمال مع
        | خطأ_إكمال_ترميز_تشغيل_إكس.هدف_غير_متطابق(الهدف) -> {
            أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «runtime-encoding.target-mismatch»);
            أضف_عدد_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة);
        }
        | خطأ_إكمال_ترميز_تشغيل_إكس.نداء_تشغيل_خارج_المدى -> {
            أضف_نص_فشل_أصلي(&متغير التشخيص, مفتاح_حجة_تشخيص.السبب(), «runtime-encoding.call-out-of-range»);
        };
    }
    | فشل_مخرج_أصلي.كائن_إكس(فشل_الكائن) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي(«native-object»);
        أضف_فشل_كائن_إكس(&متغير التشخيص, فشل_الكائن);
    }
    | فشل_مخرج_أصلي.إنهاء_هدف_غير_مسجل(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسبب_وهدف(
            «native-finalization», «finalize.unregistered-target», الهدف.القيمة
        );
    }
    | فشل_مخرج_أصلي.إنهاء_مزود_غير_متطابق(الهدف) -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسبب_وهدف(
            «native-finalization», «finalize.provider-mismatch», الهدف.القيمة
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_كائن_تنفيذي_غير_صالح -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.invalid-object»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_رمز_دخول_مفقود -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.missing-entry-symbol»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_رمز_خارجي_غير_مدعوم -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.unsupported-external-symbol»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_إزاحة_غير_مدعومة -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.unsupported-relocation»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_إزاحة_خارج_النطاق -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.relocation-out-of-range»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_ماتشو_توقيع_فشل -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «macho», «finalize.macho.signing-failure»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_إلف_كائن_تنفيذي_غير_صالح -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «elf», «finalize.elf.invalid-object»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_إلف_رمز_دخول_مفقود -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «elf», «finalize.elf.missing-entry-symbol»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_إلف_بدائي_تشغيل_غير_مخفض -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «elf», «finalize.elf.unlowered-runtime-primitive»
        );
    }
    | فشل_مخرج_أصلي.إنهاء_إلف_رمز_خارجي_غير_معروف -> {
        التشخيص := ابدأ_تشخيص_فشل_أصلي_بسياق_وسبب(
            «native-finalization», «elf», «finalize.elf.unknown-external-symbol»
        );
    };

    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
