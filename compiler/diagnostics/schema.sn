// Shared diagnostic vocabulary used by records, localization and outputs.
// These are schema identities, not semantic error ownership.

عام نوع مفتاح_صياغة =
    | تسمية_خطأ
    | تسمية_تحذير
    | تسمية_ملاحظة
    | تسمية_مساعدة
    | تسمية_إصلاح
    | تسمية_أثر
    | تسمية_متعلق
    | تسمية_متوقع
    | تسمية_موجود
    | تسمية_قيمة
    | تسمية_فهرس
    | تسمية_طول
    | تسمية_مجال
    | تسمية_نمط
    | تسمية_مسار
    | تسمية_رمز
    | تسمية_نوع
    | تسمية_سياق
    | تسمية_مرحلة
    | تسمية_هدف
    | تسمية_دالة
    | تسمية_كتلة
    | تسمية_تعليمة
    | تسمية_عملية
    | تسمية_بدائي
    | تسمية_مصدر_قيمة
    | تسمية_وجهة_قيمة
    | تسمية_سبب
    | تسمية_مصدر
    | تسمية_استخدام_غير_صالح
    | تسمية_أصل_النقل
    | تسمية_أصل_التحرير
    | تسمية_المالك_الأصلي
    | تسمية_استعارة_متعارضة
    | تسمية_موضع_متوقع
    | تسمية_اكتشاف_المحلل
    | تسمية_هل_تقصد
    | تسمية_استبدال
    | تسمية_فاصلة_منقوطة_في_غير_موضعها
    | تسمية_وجهة_فاصلة_منقوطة
    | تسمية_عبارة_بلا_عملية
    | تسمية_نمط_غير_قابل_للوصول
    | تسمية_تغطية_نمط_سابقة
    | تسمية_سياق_مرتبط
    | تسمية_استدعاء_وقت_الترجمة
    | تسمية_تصريح_غير_قابل_للتغيير
    | تسمية_مضمن_من
    | تسمية_تصريح_سابق
    | تسمية_إصلاح_آلي
    | تسمية_إصلاح_بعناصر_نائبة
    | تسمية_إصلاح_تقريبي
    | تسمية_إصلاح_غير_محدد
    | مساعدة_اعرض_خيارات_المترجم
    | مساعدة_اعرض_أهداف_المترجم
    | مساعدة_تحقق_من_قيمة_الخيار
    | مساعدة_أبلغ_عن_خلل_المترجم
    | مساعدة_أضف_فاصلة_منقوطة
    | مساعدة_انقل_فاصلة_منقوطة
    | مساعدة_استبدل_تهجئة_الكلمة_المشتبهة
    | مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد
    | مساعدة_أضف_نوع_ناتج_دالة
    | مساعدة_اجعل_التصريح_عاما
    | ملاحظة_التصريح_السابق
    | مساعدة_ارفع_ميزانية_وقت_الترجمة
    | مساعدة_انقل_الأثر_إلى_وقت_التشغيل
    // An unknown name: a visible name of the same namespace with a close
    // spelling (fact الاستبدال), or a loaded std module that declares the
    // name public (fact المسار). frontend/names/suggestions.sn.
    | مساعدة_اسم_مشابه_مرئي
    | مساعدة_استورد_وحدة_تصرح_بالاسم
    // The C error a read-only header met (SULTANC-C-READ-HEADER-UNTRANSLATED):
    // facts السبب (its C reason), السياق (its public code) and its own facts.
    | ملاحظة_خطأ_سي_غير_مترجم
    // A -l library `run`/`interpret` found only as a static archive
    // (SULTANC-RUN-LIBRARY-STATIC-ONLY).
    | مساعدة_ابن_تنفيذيا_لمكتبة_ساكنة
    // A git dependency the dependency map does not resolve
    // (SULTANC-PACKAGE-GIT-DEPENDENCY-UNRESOLVED): Supax fetches it.
    // Structured suggestions with an edit (frontend/suggestion_edits.sn):
    // add `mutable` to the declaration written to; convert a number with `as`;
    // borrow with `&`; read through a reference with `*`.
    | مساعدة_اجعل_التصريح_متغيرا
    | مساعدة_حول_القيمة_صراحة
    | مساعدة_استعر_القيمة
    | مساعدة_اقرأ_القيمة_عبر_المرجع
    // A keyword where a name is expected (a field, a parameter, ...).
    | مساعدة_اختر_اسما_غير_محجوز
    // A top-level `let` initialized with a record, tuple or box literal.
    | مساعدة_صرح_بالقيمة_داخل_دالة
    // SULTANC-C-COMPILER-HOST-ONLY: Jisr compiles C for any target.
    | مساعدة_اترك_مترجم_سي_الخارجي
    // SULTANC-LINK-LIBC-NOT-FOUND: name the C library's directory with -L.
    | مساعدة_أضف_دليل_مكتبة_سي
    // SULTANC-CLI-ENV-VALUE-INVALID: the form of a count setting.
    | مساعدة_عدد_موجب_بفواصل
    // Opaque types (SULTANC-TYPE-OPAQUE-*): what to write instead.
    | مساعدة_استعمل_مؤشرا_إلى_نوع_معتم
    | مساعدة_مرر_نوع_مؤشر_حجة_نوع
    | مساعدة_مرر_المؤشر_المعتم_إلى_مالكه
    | مساعدة_حول_المؤشر_المعتم_إلى_عدد
    | مساعدة_سم_النوع_أو_استعمل_مرادف_اسم
    // A cast the pointer rules gate behind unsafe (SULTANC-SAFETY-UNSAFE-OPERATION).
    | مساعدة_لف_التحويل_بغير_آمن
    // No standard library where the compiler looks (SULTANC-STD-NOT-FOUND).
    | مساعدة_حدد_المكتبة_القياسية
    // A file `sultanc fmt --check` would change (SULTANC-FMT-UNFORMATTED).
    | مساعدة_نسق_الملف
    | قيمة_منطقية_صواب
    | قيمة_منطقية_خطأ
;

عام نوع لغة_تشخيص =
    | الإنجليزية
    | العربية
;

عام نوع مفتاح_حجة_تشخيص =
    | القيمة
    | المتوقع
    | الاستبدال
    | الموجود
    | الفهرس
    | الطول
    | المجال
    | النمط
    | المسار
    | الرمز
    | النوع
    | السياق
    | المرحلة
    | الهدف
    | الدالة
    | الكتلة
    | التعليمة
    | العملية
    | البدائي
    | المصدر
    | الوجهة
    | السبب
;

عام نوع دور_نطاق_تشخيص =
    | رئيسي
    | استخدام_غير_صالح
    | أصل_النقل
    | أصل_التحرير
    | المالك_الأصلي
    | استعارة_متعارضة
    | موضع_متوقع
    | اكتشاف_المحلل
    | فاصلة_منقوطة_في_غير_موضعها
    | وجهة_فاصلة_منقوطة
    | عبارة_بلا_عملية
    | نمط_غير_قابل_للوصول
    | تغطية_نمط_سابقة
    | سياق_مرتبط
    | استدعاء_وقت_الترجمة
    | تصريح_غير_قابل_للتغيير
    // The `#include` that brought a C file in (foreign_c.sn), innermost first.
    | مضمن_من
    // An earlier declaration of the same name (C redefinitions and conflicts).
    | تصريح_سابق
;

عام نوع قابلية_تطبيق_إصلاح =
    | آلي
    | يحتوي_عناصر_نائبة
    | قد_يكون_غير_صحيح
    | غير_محدد
;

