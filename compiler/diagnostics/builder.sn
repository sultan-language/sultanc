استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.source.source_map;
استورد std.encoding.positions;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.keys.surface;


// Construction helpers mutate one canonical diagnostic record.
// Producers remain responsible for choosing the correct identity and source facts.

// هوية المصدر الرقمية تبقى في نطاق Frontend؛ الاسم والمقتطف بيانات عرض اختيارية فقط.
عام عرف نطاق_مصدر_تشخيص_بأصل(
    النطاق: نطاق,
    اسم_المصدر: اختياري نص,
    المقتطف: اختياري نص
): نطاق_مصدر_تشخيص {
    دع الاسم: متغير اختياري نص = اختياري.لا_شيء();
    طابق اسم_المصدر مع
    | اختياري.موجود(القيمة) -> {
        إذا ((الطول(القيمة) مثل طبيعي) > 0) {
            الاسم := اختياري.موجود(القيمة);
        };
    }
    | اختياري.لا_شيء -> { };
    دع بلا_بداية: اختياري إحداثي_مصدر = اختياري.لا_شيء();
    دع بلا_نهاية: اختياري إحداثي_مصدر = اختياري.لا_شيء();
    دع بلا_بداية_يوتيف16: اختياري موضع_نصي_يوتيف16 = اختياري.لا_شيء();
    دع بلا_نهاية_يوتيف16: اختياري موضع_نصي_يوتيف16 = اختياري.لا_شيء();
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف,
        بداية_العرض: بلا_بداية,
        نهاية_العرض: بلا_نهاية,
        بداية_يوتيف16: بلا_بداية_يوتيف16,
        نهاية_يوتيف16: بلا_نهاية_يوتيف16
    };
    أرجع الناتج;
}


// The LSP position (0-based line, UTF-16 column) of a byte of the source;
// none past the end or on a line that is not valid UTF-8.
عرف موضع_يوتيف16_في_مصدر(المصدر: &مصدر, الفهرس: &فهرس_سطور, البايت: ط32): اختياري موضع_نصي_يوتيف16 {
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(المصدر, الفهرس, البايت مثل طبيعي);
}

// Preferred construction path when the canonical source file is available.
// Human coordinates are derived here from compiler/source and are never stored in Span.
عام عرف نطاق_مصدر_تشخيص_من_مصدر(
    النطاق: نطاق,
    المصدر: &مصدر,
    المقتطف: اختياري نص
): نطاق_مصدر_تشخيص {
    // One line index for both ends, read through the reference: the source
    // is neither copied nor scanned twice.
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    دع الفهرس_المستعمل: &فهرس_سطور = &الفهرس;
    دع بداية_العرض: اختياري إحداثي_مصدر = إحداثي_مصدر_عند_بفهرس(المصدر, &الفهرس, النطاق.البداية.البايت);
    دع نهاية_العرض: اختياري إحداثي_مصدر = إحداثي_مصدر_عند_بفهرس(المصدر, &الفهرس, النطاق.النهاية.البايت);
    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع نسخة_الاسم: نص = انسخ_نص(مرجع_الاسم);
    دع الاسم: اختياري نص = اختياري.موجود(نسخة_الاسم);
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف,
        بداية_العرض: بداية_العرض,
        نهاية_العرض: نهاية_العرض,
        بداية_يوتيف16: موضع_يوتيف16_في_مصدر(المصدر, الفهرس_المستعمل, النطاق.البداية.البايت),
        نهاية_يوتيف16: موضع_يوتيف16_في_مصدر(المصدر, الفهرس_المستعمل, النطاق.النهاية.البايت)
    };
    أرجع الناتج;
}

// The same from the compiler's source map: the map's cached line index is
// used when it is built, so emitting many diagnostics in one file does not
// rescan the file each time; otherwise one index serves both ends. None when
// the map has no such source.
عام عرف نطاق_مصدر_تشخيص_من_خريطة(
    النطاق: نطاق,
    الخريطة: &خريطة_مصادر,
    المعرف: طبيعي,
    المقتطف: اختياري نص
): اختياري نطاق_مصدر_تشخيص {
    إذا (المعرف >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((*الخريطة).المصادر[المعرف].المعرف != المعرف) { أرجع اختياري.لا_شيء(); };
    دع المصدر: &مصدر = &(*الخريطة).المصادر[المعرف];
    دع جاهز: منطقي = المعرف < (الطول((*الخريطة).فهارس_السطور_جاهزة) مثل طبيعي)
        && المعرف < (الطول((*الخريطة).فهارس_السطور) مثل طبيعي)
        && (*الخريطة).فهارس_السطور_جاهزة[المعرف];
    إذا (!جاهز) { أرجع اختياري.موجود(نطاق_مصدر_تشخيص_من_مصدر(النطاق, المصدر, المقتطف)); };
    دع الفهرس: &فهرس_سطور = &(*الخريطة).فهارس_السطور[المعرف];
    دع الفهرس_المستعمل: &فهرس_سطور = الفهرس;
    دع بداية_العرض: اختياري إحداثي_مصدر = إحداثي_مصدر_عند_بفهرس(المصدر, الفهرس, النطاق.البداية.البايت);
    دع نهاية_العرض: اختياري إحداثي_مصدر = إحداثي_مصدر_عند_بفهرس(المصدر, الفهرس, النطاق.النهاية.البايت);
    دع مرجع_الاسم: &نص = &(*المصدر).الاسم;
    دع الاسم: اختياري نص = اختياري.موجود(انسخ_نص(مرجع_الاسم));
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف,
        بداية_العرض: بداية_العرض,
        نهاية_العرض: نهاية_العرض,
        بداية_يوتيف16: موضع_يوتيف16_في_مصدر(المصدر, الفهرس_المستعمل, النطاق.البداية.البايت),
        نهاية_يوتيف16: موضع_يوتيف16_في_مصدر(المصدر, الفهرس_المستعمل, النطاق.النهاية.البايت)
    };
    أرجع اختياري.موجود(الناتج);
}

// يبقى هذا المنشئ متوافقا مع المنتجين الذين يمررون اسما نصيا مباشرا.
// الاسم الفارغ يعني أن اسم الملف غير متاح، ولا يتحول إلى اسم مصدر مختلق.
عام عرف نطاق_مصدر_تشخيص_جديد(
    النطاق: نطاق,
    اسم_المصدر: نص,
    المقتطف: اختياري نص
): نطاق_مصدر_تشخيص {
    أرجع نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختياري.موجود(اسم_المصدر),
        المقتطف
    );
}

// التحويل العام من نطاق مصدر إلى واصف تشخيص افتراضي يملكه Diagnostics وحده.
// المالك الدلالي يقرر أي نطاق فشل؛ هذا المساعد لا يقرر سبب التشخيص.
عام عرف مصدر_تشخيص_من_نطاق(
    النطاق: نطاق
): اختياري نطاق_مصدر_تشخيص {
    دع المصدر: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختياري.لا_شيء(),
        اختياري.لا_شيء()
    );
    أرجع اختياري.موجود(المصدر);
}

عام عرف ابدأ_تشخيصا(
    المعرف: معرف_تشخيص,
    المصدر: اختياري نطاق_مصدر_تشخيص
): تشخيص {
    دع الحجج: متجه حجة_تشخيص = [];
    دع المرتبطة: متجه نطاق_مرتبط_بتشخيص = [];
    دع الملاحظات: متجه تعليق_تشخيص = [];
    دع المساعدة: متجه تعليق_تشخيص = [];
    دع الإصلاحات: متجه إصلاح_تشخيص = [];
    دع الأثر: متجه مدخل_أثر_تشخيص = [];
    دع الاعتمادات: متجه نطاق_مصدر_تشخيص = [];
    دع الدور_الرئيسي: دور_نطاق_تشخيص = دور_نطاق_تشخيص.رئيسي();
    دع الناتج: تشخيص = {
        المعرف: المعرف,
        المصدر_الرئيسي: المصدر,
        الدور_الرئيسي: الدور_الرئيسي,
        الحجج: الحجج,
        النطاقات_المرتبطة: المرتبطة,
        الملاحظات: الملاحظات,
        المساعدة: المساعدة,
        الإصلاحات: الإصلاحات,
        الأثر: الأثر,
        الاعتمادات: الاعتمادات
    };
    أرجع الناتج;
}

عام عرف ضع_دور_النطاق_الرئيسي(
    التشخيص: &متغير تشخيص,
    الدور: دور_نطاق_تشخيص
): فراغ {
    (*التشخيص).الدور_الرئيسي := الدور;
}

عرف أضف_قيمة_حجة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
): منطقي {
    دع الحجة: حجة_تشخيص = {
        المفتاح: المفتاح,
        القيمة: القيمة
    };
    ألحق((*التشخيص).الحجج, الحجة);
    أرجع صواب;
}

عام عرف أضف_حجة_تشخيص(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.نصية(القيمة)
    );
}

عام عرف أضف_حجة_ثنائية_اللغة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    الإنجليزية: نص,
    العربية: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية)
    );
}

عام عرف أضف_حجة_طبيعية(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: طبيعي
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.طبيعية(القيمة)
    );
}

عام عرف أضف_حجة_موقعة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: عدد
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.موقعة(القيمة)
    );
}

عام عرف أضف_حجة_منطقية(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: منطقي
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.منطقية(القيمة)
    );
}

// The contextual reason of a diagnostic (one per diagnostic, key السبب).
عام عرف أضف_نص_مترجم_تشخيص(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    النص: مفتاح_نص_مترجم
): منطقي {
    أرجع أضف_قيمة_حجة(التشخيص, المفتاح, قيمة_حجة_تشخيص.نص_مترجم(النص));
}

عام عرف أضف_سبب_تشخيص(
    التشخيص: &متغير تشخيص,
    السبب: سبب_تشخيص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        مفتاح_حجة_تشخيص.السبب(),
        قيمة_حجة_تشخيص.سبب(السبب)
    );
}

عام عرف أضف_نطاقا_مرتبطا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
): منطقي {
    دع المرتبط: نطاق_مرتبط_بتشخيص = {
        المصدر: المصدر,
        الدور: الدور
    };
    ألحق((*التشخيص).النطاقات_المرتبطة, المرتبط);
    أرجع صواب;
}

عام عرف أضف_ملاحظة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع الملاحظة: تعليق_تشخيص = {
        المفتاح: المفتاح,
        الحجج: الحجج
    };
    ألحق((*التشخيص).الملاحظات, الملاحظة);
    أرجع صواب;
}

عام عرف أضف_مساعدة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع المساعدة: تعليق_تشخيص = {
        المفتاح: المفتاح,
        الحجج: الحجج
    };
    ألحق((*التشخيص).المساعدة, المساعدة);
    أرجع صواب;
}

عام عرف أضف_إصلاحا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص = [];
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر,
        الاستبدال: الاستبدال,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق((*التشخيص).الإصلاحات, الإصلاح);
    أرجع صواب;
}

عام عرف أضف_إصلاحا_مركبا_من_تعديلين(
    التشخيص: &متغير تشخيص,
    المصدر_الأول: نطاق_مصدر_تشخيص,
    الاستبدال_الأول: نص,
    المصدر_الثاني: نطاق_مصدر_تشخيص,
    الاستبدال_الثاني: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع التعديلات_الإضافية: متغير متجه تعديل_إصلاح_تشخيص = [];
    دع التعديل_الثاني: تعديل_إصلاح_تشخيص = {
        المصدر: المصدر_الثاني,
        الاستبدال: الاستبدال_الثاني
    };
    ألحق(التعديلات_الإضافية, التعديل_الثاني);
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر_الأول,
        الاستبدال: الاستبدال_الأول,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق((*التشخيص).الإصلاحات, الإصلاح);
    أرجع صواب;
}


// Marks this diagnostic as causally derived from an earlier source failure.
// The engine suppresses it only when an error covering this dependency was
// actually emitted; producers must opt in explicitly.
عام عرف أضف_اعتماد_تشخيص(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص
): منطقي {
    ألحق((*التشخيص).الاعتمادات, المصدر);
    أرجع صواب;
}

عام عرف أضف_أثرا(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع المدخل: مدخل_أثر_تشخيص = {
        المفتاح: المفتاح,
        المصدر: المصدر,
        الحجج: الحجج
    };
    ألحق((*التشخيص).الأثر, المدخل);
    أرجع صواب;
}

