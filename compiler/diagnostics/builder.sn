استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;


// Construction helpers mutate one canonical diagnostic record.
// Producers remain responsible for choosing the correct identity and source facts.

// هوية المصدر الرقمية تبقى في نطاق Frontend؛ الاسم والمقتطف بيانات عرض اختيارية فقط.
عام عرف نطاق_مصدر_تشخيص_بأصل(
    النطاق: نطاق,
    اسم_المصدر: اختيار نص,
    المقتطف: اختيار نص
): نطاق_مصدر_تشخيص {
    دع الاسم: متغير اختيار نص = اختيار.لا_شيء();
    طابق اسم_المصدر مع
    | اختيار.بعض(القيمة) -> {
        لو ((الطول(القيمة) مثل غير_موقع) > 0) {
            الاسم := اختيار.بعض(القيمة);
        };
    }
    | اختيار.لا_شيء -> { };
    دع بلا_بداية: اختيار إحداثي_مصدر = اختيار.لا_شيء();
    دع بلا_نهاية: اختيار إحداثي_مصدر = اختيار.لا_شيء();
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف,
        بداية_العرض: بلا_بداية,
        نهاية_العرض: بلا_نهاية
    };
    أرجع الناتج;
}


// Preferred construction path when the canonical source file is available.
// Human coordinates are derived here from compiler/source and are never stored in Span.
عام عرف نطاق_مصدر_تشخيص_من_مصدر(
    النطاق: نطاق,
    المصدر: &مصدر,
    المقتطف: اختيار نص
): نطاق_مصدر_تشخيص {
    دع قيمة: مصدر = *المصدر;
    دع بداية_العرض: اختيار إحداثي_مصدر = إحداثي_مصدر_عند(&قيمة, النطاق.البداية.البايت);
    دع نهاية_العرض: اختيار إحداثي_مصدر = إحداثي_مصدر_عند(&قيمة, النطاق.النهاية.البايت);
    دع مرجع_الاسم: &نص = &قيمة.الاسم;
    دع نسخة_الاسم: نص = *مرجع_الاسم;
    دع الاسم: اختيار نص = اختيار.بعض(نسخة_الاسم);
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف,
        بداية_العرض: بداية_العرض,
        نهاية_العرض: نهاية_العرض
    };
    أرجع الناتج;
}

// يبقى هذا المنشئ متوافقا مع المنتجين الذين يمررون اسما نصيا مباشرا.
// الاسم الفارغ يعني أن اسم الملف غير متاح، ولا يتحول إلى اسم مصدر مختلق.
عام عرف نطاق_مصدر_تشخيص_جديد(
    النطاق: نطاق,
    اسم_المصدر: نص,
    المقتطف: اختيار نص
): نطاق_مصدر_تشخيص {
    أرجع نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختيار.بعض(اسم_المصدر),
        المقتطف
    );
}

// التحويل العام من نطاق مصدر إلى واصف تشخيص افتراضي يملكه Diagnostics وحده.
// المالك الدلالي يقرر أي نطاق فشل؛ هذا المساعد لا يقرر سبب التشخيص.
عام عرف مصدر_تشخيص_من_نطاق(
    النطاق: نطاق
): اختيار نطاق_مصدر_تشخيص {
    دع المصدر: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختيار.لا_شيء(),
        اختيار.لا_شيء()
    );
    أرجع اختيار.بعض(المصدر);
}

عام عرف ابدأ_تشخيصا(
    المعرف: معرف_تشخيص,
    المصدر: اختيار نطاق_مصدر_تشخيص
): تشخيص {
    دع الحجج: متجه حجة_تشخيص = [];
    دع المرتبطة: متجه نطاق_مرتبط_بتشخيص = [];
    دع الملاحظات: متجه تعليق_تشخيص = [];
    دع المساعدة: متجه تعليق_تشخيص = [];
    دع الإصلاحات: متجه إصلاح_تشخيص = [];
    دع الأثر: متجه مدخل_أثر_تشخيص = [];
    دع الاعتمادات: متجه نطاق_مصدر_تشخيص = [];
    دع الدور_الرئيسي: دور_نطاق_تشخيص = دور_نطاق_تشخيص.رئيسي();
    دع الناتج: تشخيص = {
        المعرف: المعرف,
        المصدر_الرئيسي: المصدر,
        الدور_الرئيسي: الدور_الرئيسي,
        الحجج: الحجج,
        النطاقات_المرتبطة: المرتبطة,
        الملاحظات: الملاحظات,
        المساعدة: المساعدة,
        الإصلاحات: الإصلاحات,
        الأثر: الأثر,
        الاعتمادات: الاعتمادات
    };
    أرجع الناتج;
}

عام عرف ضع_دور_النطاق_الرئيسي(
    التشخيص: &متغير تشخيص,
    الدور: دور_نطاق_تشخيص
): فراغ {
    دع الحالة: متغير تشخيص = *التشخيص;
    الحالة.الدور_الرئيسي := الدور;
    *التشخيص := الحالة;
}

عرف أضف_قيمة_حجة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع الحجة: حجة_تشخيص = {
        المفتاح: المفتاح,
        القيمة: القيمة
    };
    ألحق(الحالة.الحجج, الحجة);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_حجة_تشخيص(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.نصية(القيمة)
    );
}

عام عرف أضف_حجة_ثنائية_اللغة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    الإنجليزية: نص,
    العربية: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية)
    );
}

عام عرف أضف_حجة_غير_موقعة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: غير_موقع
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.غير_موقعة(القيمة)
    );
}

عام عرف أضف_حجة_موقعة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: عدد
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.موقعة(القيمة)
    );
}

عام عرف أضف_حجة_منطقية(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: منطقي
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.منطقية(القيمة)
    );
}

عام عرف أضف_نطاقا_مرتبطا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع المرتبط: نطاق_مرتبط_بتشخيص = {
        المصدر: المصدر,
        الدور: الدور
    };
    ألحق(الحالة.النطاقات_المرتبطة, المرتبط);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_ملاحظة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع الملاحظة: تعليق_تشخيص = {
        المفتاح: المفتاح,
        الحجج: الحجج
    };
    ألحق(الحالة.الملاحظات, الملاحظة);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_مساعدة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع المساعدة: تعليق_تشخيص = {
        المفتاح: المفتاح,
        الحجج: الحجج
    };
    ألحق(الحالة.المساعدة, المساعدة);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_إصلاحا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص = [];
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر,
        الاستبدال: الاستبدال,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق(الحالة.الإصلاحات, الإصلاح);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_إصلاحا_مركبا_من_تعديلين(
    التشخيص: &متغير تشخيص,
    المصدر_الأول: نطاق_مصدر_تشخيص,
    الاستبدال_الأول: نص,
    المصدر_الثاني: نطاق_مصدر_تشخيص,
    الاستبدال_الثاني: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع التعديلات_الإضافية: متغير متجه تعديل_إصلاح_تشخيص = [];
    دع التعديل_الثاني: تعديل_إصلاح_تشخيص = {
        المصدر: المصدر_الثاني,
        الاستبدال: الاستبدال_الثاني
    };
    ألحق(التعديلات_الإضافية, التعديل_الثاني);
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر_الأول,
        الاستبدال: الاستبدال_الأول,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق(الحالة.الإصلاحات, الإصلاح);
    *التشخيص := الحالة;
    أرجع صواب;
}


// Marks this diagnostic as causally derived from an earlier source failure.
// The engine suppresses it only when an error covering this dependency was
// actually emitted; producers must opt in explicitly.
عام عرف أضف_اعتماد_تشخيص(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    ألحق(الحالة.الاعتمادات, المصدر);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_أثرا(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    المصدر: اختيار نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع المدخل: مدخل_أثر_تشخيص = {
        المفتاح: المفتاح,
        المصدر: المصدر,
        الحجج: الحجج
    };
    ألحق(الحالة.الأثر, المدخل);
    *التشخيص := الحالة;
    أرجع صواب;
}

