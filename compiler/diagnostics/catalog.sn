استورد compiler.diagnostics.diagnostic_model;

// One compiler source of truth for stable diagnostic code, severity, failure class, and wording.
عام نوع فئة_تشخيص =
    | مستخدم
    | بيئة
    | داخلي
;

عام نوع تعريف_تشخيص = {
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص,
    الصياغة: مفتاح_صياغة
};

عرف أنشئ_تعريف_تشخيص(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    دع التعريف: تعريف_تشخيص = {
        المعرف: المعرف,
        الكود: الكود,
        النوع_الآلي: النوع_الآلي,
        الشدة: الشدة,
        الفئة: الفئة,
        الصياغة: الصياغة
    };
    أرجع التعريف;
}

عرف تعريف_خطأ(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف,
        الكود,
        النوع_الآلي,
        شدة_تشخيص.خطأ(),
        فئة_تشخيص.مستخدم(),
        الصياغة
    );
}

عرف تعريف_خطأ_بيئي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.بيئة(), الصياغة
    );
}

عرف تعريف_خطأ_داخلي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.داخلي(), الصياغة
    );
}

عام عرف تعريف_التشخيص(المعرف: معرف_تشخيص): تعريف_تشخيص {
    طابق المعرف مع
    | معرف_تشخيص.خطأ_نحوي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0001», «syntax-error», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0001», «misplaced-semicolon», مفتاح_صياغة.رسالة_فاصلة_منقوطة_في_غير_موضعها());
    }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0001», «keyword-typo», مفتاح_صياغة.رسالة_تهجئة_كلمة_محجوزة_غير_معروفة());
    }
    | معرف_تشخيص.عبارة_بلا_عملية -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0001», «statement-without-operation», مفتاح_صياغة.رسالة_عبارة_بلا_عملية());
    }
    | معرف_تشخيص.نوع_ناتج_دالة_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0001», «missing-function-return-type», مفتاح_صياغة.رسالة_نوع_ناتج_دالة_مفقود());
    }
    | معرف_تشخيص.خطأ_معجمي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0004», «lexical-error», مفتاح_صياغة.رسالة_خطأ_معجمي());
    }
    | معرف_تشخيص.رفض_تحليل -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0002», «parse-rejected», مفتاح_صياغة.رسالة_رفض_تحليل());
    }
    | معرف_تشخيص.لا_ناتج_تحليل -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0003», «parser-no-result», مفتاح_صياغة.رسالة_لا_ناتج_تحليل());
    }
    | معرف_تشخيص.استدعاء_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0100», «invalid-invocation», مفتاح_صياغة.رسالة_استدعاء_مترجم_غير_صالح());
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0101», «unknown-target», مفتاح_صياغة.رسالة_هدف_مترجم_غير_معروف());
    }
    | معرف_تشخيص.مصدر_مترجم_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0102», «missing-source», مفتاح_صياغة.رسالة_مصدر_مترجم_مفقود());
    }
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0105», «unknown-option», مفتاح_صياغة.رسالة_خيار_مترجم_غير_معروف());
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0106», «missing-option-value», مفتاح_صياغة.رسالة_قيمة_خيار_مترجم_مفقودة());
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0107», «invalid-language», مفتاح_صياغة.رسالة_لغة_تشخيص_مترجم_غير_صالحة());
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0108», «invalid-diagnostic-format», مفتاح_صياغة.رسالة_صيغة_تشخيص_مترجم_غير_صالحة());
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0109», «invalid-diagnostic-color», مفتاح_صياغة.رسالة_لون_تشخيص_مترجم_غير_صالح());
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0110», «multiple-primary-sources», مفتاح_صياغة.رسالة_مصدر_رئيسي_متعدد());
    }
    | معرف_تشخيص.أوضاع_مترجم_متعارضة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0111», «conflicting-modes», مفتاح_صياغة.رسالة_أوضاع_مترجم_متعارضة());
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0112», «unexpected-positional-argument», مفتاح_صياغة.رسالة_معامل_موضعي_غير_متوقع());
    }
    | معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-E0113», «host-target-unavailable», مفتاح_صياغة.رسالة_هدف_مضيف_مترجم_غير_متاح());
    }
    | معرف_تشخيص.فشل_كتابة_مخرج_مترجم -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-E0114», «output-write-failure», مفتاح_صياغة.رسالة_فشل_كتابة_مخرج_مترجم());
    }
    | معرف_تشخيص.فشل_مترجم_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E9000», «internal-compiler-failure», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.ملف_إدخال_مفقود -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-E0103», «missing-input-file», مفتاح_صياغة.رسالة_ملف_إدخال_مفقود());
    }
    | معرف_تشخيص.نوع_ملف_إدخال_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0104», «unknown-input-file-type», مفتاح_صياغة.رسالة_نوع_ملف_إدخال_غير_معروف());
    }
    | معرف_تشخيص.وحدة_مصدر_غير_موجودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0201», «missing-source-module», مفتاح_صياغة.رسالة_وحدة_مصدر_غير_موجودة());
    }
    | معرف_تشخيص.تصريح_مكرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0205», «duplicate-declaration», مفتاح_صياغة.رسالة_تصريح_مكرر());
    }
    | معرف_تشخيص.اسم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0300», «unknown-name», مفتاح_صياغة.رسالة_اسم_غير_معروف());
    }
    | معرف_تشخيص.اسم_غير_محلول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0303», «unresolved-name», مفتاح_صياغة.رسالة_اسم_غير_محلول());
    }
    | معرف_تشخيص.استيراد_غامض -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0310», «ambiguous-import», مفتاح_صياغة.رسالة_استيراد_غامض());
    }
    | معرف_تشخيص.دورة_استيراد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0311», «import-cycle», مفتاح_صياغة.رسالة_دورة_استيراد());
    }
    | معرف_تشخيص.نوعان_غير_متوافقين -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0400», «type-mismatch», مفتاح_صياغة.رسالة_نوعين_غير_متوافقين());
    }
    | معرف_تشخيص.نوع_غير_محلول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0409», «unresolved-type», مفتاح_صياغة.رسالة_نوع_غير_محلول());
    }
    | معرف_تشخيص.حقل_سجل_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0502», «unknown-record-field», مفتاح_صياغة.رسالة_حقل_سجل_غير_معروف());
    }
    | معرف_تشخيص.منشئ_نوع_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0505», «invalid-constructor», مفتاح_صياغة.رسالة_منشئ_نوع_غير_صالح());
    }
    | معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0506», «pattern-payload-count-mismatch», مفتاح_صياغة.رسالة_عدد_حمولات_نمط_غير_مطابق());
    }
    | معرف_تشخيص.نمط_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0510», «invalid-pattern», مفتاح_صياغة.رسالة_نمط_غير_صالح());
    }
    | معرف_تشخيص.خفض_تعبير_غير_مدعوم -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0602», «unsupported-expression-lowering», مفتاح_صياغة.رسالة_خفض_تعبير_غير_مدعوم());
    }
    | معرف_تشخيص.خفض_عبارة_غير_مدعومة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0606», «unsupported-statement-lowering», مفتاح_صياغة.رسالة_خفض_عبارة_غير_مدعومة());
    }
    | معرف_تشخيص.دالة_خفض_مفقودة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0607», «missing-function-semantic-fact», مفتاح_صياغة.رسالة_دالة_خفض_مفقودة());
    }
    | معرف_تشخيص.ربط_اسم_خفض_مفقود -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0616», «missing-name-binding», مفتاح_صياغة.رسالة_ربط_اسم_خفض_مفقود());
    }
    | معرف_تشخيص.نوع_خفض_مفقود -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0617», «missing-type-fact», مفتاح_صياغة.رسالة_نوع_خفض_مفقود());
    }
    | معرف_تشخيص.هوية_منشئ_خفض_مفقودة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E0618», «missing-constructor-identity», مفتاح_صياغة.رسالة_هوية_منشئ_خفض_مفقودة());
    }
    | معرف_تشخيص.عدد_حجج_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0619», «argument-count-mismatch», مفتاح_صياغة.رسالة_عدد_حجج_غير_مطابق());
    }
    | معرف_تشخيص.نوع_حجة_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0620», «argument-type-mismatch», مفتاح_صياغة.رسالة_نوع_حجة_غير_مطابق());
    }
    | معرف_تشخيص.نوع_إرجاع_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E0621», «return-type-mismatch», مفتاح_صياغة.رسالة_نوع_إرجاع_غير_مطابق());
    }
    | معرف_تشخيص.استخدام_قبل_التهيئة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1300», «use-before-initialization», مفتاح_صياغة.رسالة_استخدام_قبل_التهيئة());
    }
    | معرف_تشخيص.استخدام_بعد_النقل -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1301», «use-after-move», مفتاح_صياغة.رسالة_استخدام_بعد_النقل());
    }
    | معرف_تشخيص.تعارض_استعارة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1302», «borrow-conflict», مفتاح_صياغة.رسالة_تعارض_استعارة());
    }
    | معرف_تشخيص.هروب_مرجع -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1303», «reference-escape», مفتاح_صياغة.رسالة_هروب_مرجع());
    }
    | معرف_تشخيص.عملية_غير_آمنة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1304», «unsafe-operation», مفتاح_صياغة.رسالة_عملية_غير_آمنة());
    }
    | معرف_تشخيص.فهرس_خارج_الحدود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1305», «out-of-bounds», مفتاح_صياغة.رسالة_فهرس_خارج_الحدود());
    }
    | معرف_تشخيص.نمط_غير_شامل -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1306», «non-exhaustive-pattern», مفتاح_صياغة.رسالة_نمط_غير_شامل());
    }
    | معرف_تشخيص.نمط_غير_قابل_للوصول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1307», «unreachable-pattern», مفتاح_صياغة.رسالة_نمط_غير_قابل_للوصول());
    }
    | معرف_تشخيص.إرجاع_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1308», «missing-return», مفتاح_صياغة.رسالة_إرجاع_مفقود());
    }
    | معرف_تشخيص.مورد_محرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1309», «released-resource», مفتاح_صياغة.رسالة_مورد_محرر());
    }
    | معرف_تشخيص.نقل_جزئي_مملوك -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1312», «partial-owned-move», مفتاح_صياغة.رسالة_نقل_جزئي_مملوك());
    }
    | معرف_تشخيص.خطأ_ذاكرة_نوع -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1313», «invalid-type-memory», مفتاح_صياغة.رسالة_خطأ_ذاكرة_نوع());
    }
    | معرف_تشخيص.مسير_غير_صالح -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E1400», «invalid-msir», مفتاح_صياغة.رسالة_مسير_غير_صالح());
    }
    | معرف_تشخيص.خطأ_سياق_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E1100», «internal-context-error», مفتاح_صياغة.رسالة_خطأ_سياق_داخلي());
    }
    | معرف_تشخيص.حقيقة_دلالية_مفقودة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-E1101», «missing-semantic-fact», مفتاح_صياغة.رسالة_حقيقة_دلالية_مفقودة());
    }
    | معرف_تشخيص.فشل_تفسير_وقت_تشغيل -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1500», «interpreter-runtime-failure», مفتاح_صياغة.رسالة_فشل_تفسير_وقت_تشغيل());
    }
    | معرف_تشخيص.فخ_تفسير -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-E1501», «interpreter-trap», مفتاح_صياغة.رسالة_فخ_تفسير());
    }
    | معرف_تشخيص.تحذير_عام -> {
        أرجع أنشئ_تعريف_تشخيص(
            المعرف,
            «SULTANC-W0001»,
            «compiler-warning»,
            شدة_تشخيص.تحذير(),
            فئة_تشخيص.مستخدم(),
            مفتاح_صياغة.رسالة_تحذير_عام()
        );
    };
}

عام عرف مجموعة_تشخيصات_تحوي_فئة(
    المجموعة: &مجموعة_تشخيصات,
    الفئة: فئة_تشخيص
): منطقي {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.التشخيصات) مثل غير_موقع)) {
        دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.التشخيصات[ف].المعرف);
        لو (التعريف.الفئة == الفئة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف أصدر_تشخيصا(
    المجموعة: &متغير مجموعة_تشخيصات,
    التشخيص: &تشخيص
): فراغ {
    دع نسخة_للتعريف: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(نسخة_للتعريف.المعرف);
    دع نسخة_للتخزين: تشخيص = *التشخيص;
    دع الحالة: متغير مجموعة_تشخيصات = *المجموعة;
    ألحق(الحالة.التشخيصات, نسخة_للتخزين);
    طابق التعريف.الشدة مع
    | شدة_تشخيص.خطأ -> {
        الحالة.عدد_الأخطاء := الحالة.عدد_الأخطاء + 1;
    }
    | شدة_تشخيص.تحذير -> {
        الحالة.عدد_التحذيرات := الحالة.عدد_التحذيرات + 1;
    }
    | شدة_تشخيص.ملاحظة -> {
        الحالة.عدد_الملاحظات := الحالة.عدد_الملاحظات + 1;
    };
    *المجموعة := الحالة;
}

// الدمج يحافظ على ترتيب الإصدار؛ الكتالوج المقنن يعيد احتساب العدادات.
عام عرف ادمج_مجموعة_تشخيصات(
    الوجهة: &متغير مجموعة_تشخيصات,
    المصدر: &مجموعة_تشخيصات
): فراغ {
    دع المصدر_الحالي: مجموعة_تشخيصات = *المصدر;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر_الحالي.التشخيصات) مثل غير_موقع)) {
        دع مرجع_التشخيص: &تشخيص = &المصدر_الحالي.التشخيصات[ف];
        أصدر_تشخيصا(الوجهة, مرجع_التشخيص);
        ف := ف + 1;
    }
}

عام عرف يجب_فشل_الترجمة(المجموعة: &مجموعة_تشخيصات): منطقي {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    أرجع الحالة.عدد_الأخطاء > 0;
}
