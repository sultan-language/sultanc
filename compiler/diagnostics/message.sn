استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.registry;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.format.facts;
استورد compiler.ispeak.keys.surface;

// Adapter from the compiler's diagnostic record to iSpeak's typed facts.
// The compiler owns which facts are present; iSpeak owns every word.
// Output transports consume the finished message and never switch on identity.
//
// The record's arguments are read once into iSpeak's 22-fact context. A
// specialised template may then phrase some facts as the headline; it clears
// exactly the facts it used, and every other fact (the reason included) is
// still added by the shared composer. A template never discards a fact.

عرف انسخ_نص_رسالة(القيمة: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        ألحق(البايتات, النص[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

// Bilingual and iSpeak-owned text is resolved to the requested language here, once.
عرف قيمة_رسالة_من_حجة(اللغة: لغة_تشخيص, القيمة: &قيمة_حجة_تشخيص): قيمة_حجة_رسالة {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع قيمة_حجة_رسالة.نصية(انسخ_نص_رسالة(&النص)); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        طابق اللغة مع
        | لغة_تشخيص.الإنجليزية -> { أرجع قيمة_حجة_رسالة.نصية(انسخ_نص_رسالة(&الإنجليزية)); }
        | لغة_تشخيص.العربية -> { أرجع قيمة_حجة_رسالة.نصية(انسخ_نص_رسالة(&العربية)); };
    }
    | قيمة_حجة_تشخيص.طبيعية(العدد) -> { أرجع قيمة_حجة_رسالة.طبيعية(العدد); }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> { أرجع قيمة_حجة_رسالة.موقعة(العدد); }
    | قيمة_حجة_تشخيص.منطقية(الحالة) -> { أرجع قيمة_حجة_رسالة.منطقية(الحالة); }
    | قيمة_حجة_تشخيص.سبب(السبب) -> { أرجع قيمة_حجة_رسالة.سبب_محدد(السبب); }
    | قيمة_حجة_تشخيص.نص_مترجم(المفتاح) -> { أرجع قيمة_حجة_رسالة.نصية(نص_المترجم(اللغة, المفتاح)); };
}

// The first argument of a key is the fact; a repeated key keeps the first value.
عرف ضع_حقيقة_إن_غابت(الحقل: &متغير اختياري قيمة_حجة_رسالة, القيمة: قيمة_حجة_رسالة): فراغ {
    طابق *الحقل مع
    | اختياري.لا_شيء -> { *الحقل := اختياري.موجود(القيمة); }
    | اختياري.موجود(_) -> { };
}

عام عرف سياق_رسالة_خال(): حقائق_سياق_رسالة {
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.لا_شيء(),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.لا_شيء()
    };
    أرجع السياق;
}

// One pass over a record's (or a note's) arguments into the fixed fact shape.
عام عرف سياق_حجج_تشخيص(اللغة: لغة_تشخيص, الحجج: &متجه حجة_تشخيص): حقائق_سياق_رسالة {
    دع السياق: متغير حقائق_سياق_رسالة = سياق_رسالة_خال();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        دع القيمة: قيمة_حجة_رسالة = قيمة_رسالة_من_حجة(اللغة, &(*الحجج)[ف].القيمة);
        طابق (*الحجج)[ف].المفتاح مع
        | مفتاح_حجة_تشخيص.القيمة -> { ضع_حقيقة_إن_غابت(&متغير السياق.القيمة, القيمة); }
        | مفتاح_حجة_تشخيص.المتوقع -> { ضع_حقيقة_إن_غابت(&متغير السياق.المتوقع, القيمة); }
        | مفتاح_حجة_تشخيص.الاستبدال -> { ضع_حقيقة_إن_غابت(&متغير السياق.الاستبدال, القيمة); }
        | مفتاح_حجة_تشخيص.الموجود -> { ضع_حقيقة_إن_غابت(&متغير السياق.الموجود, القيمة); }
        | مفتاح_حجة_تشخيص.الفهرس -> { ضع_حقيقة_إن_غابت(&متغير السياق.الفهرس, القيمة); }
        | مفتاح_حجة_تشخيص.الطول -> { ضع_حقيقة_إن_غابت(&متغير السياق.الطول, القيمة); }
        | مفتاح_حجة_تشخيص.المجال -> { ضع_حقيقة_إن_غابت(&متغير السياق.المجال, القيمة); }
        | مفتاح_حجة_تشخيص.النمط -> { ضع_حقيقة_إن_غابت(&متغير السياق.النمط, القيمة); }
        | مفتاح_حجة_تشخيص.المسار -> { ضع_حقيقة_إن_غابت(&متغير السياق.المسار, القيمة); }
        | مفتاح_حجة_تشخيص.الرمز -> { ضع_حقيقة_إن_غابت(&متغير السياق.الرمز, القيمة); }
        | مفتاح_حجة_تشخيص.النوع -> { ضع_حقيقة_إن_غابت(&متغير السياق.النوع, القيمة); }
        | مفتاح_حجة_تشخيص.السياق -> { ضع_حقيقة_إن_غابت(&متغير السياق.السياق, القيمة); }
        | مفتاح_حجة_تشخيص.المرحلة -> { ضع_حقيقة_إن_غابت(&متغير السياق.المرحلة, القيمة); }
        | مفتاح_حجة_تشخيص.الهدف -> { ضع_حقيقة_إن_غابت(&متغير السياق.الهدف, القيمة); }
        | مفتاح_حجة_تشخيص.الدالة -> { ضع_حقيقة_إن_غابت(&متغير السياق.الدالة, القيمة); }
        | مفتاح_حجة_تشخيص.الكتلة -> { ضع_حقيقة_إن_غابت(&متغير السياق.الكتلة, القيمة); }
        | مفتاح_حجة_تشخيص.التعليمة -> { ضع_حقيقة_إن_غابت(&متغير السياق.التعليمة, القيمة); }
        | مفتاح_حجة_تشخيص.العملية -> { ضع_حقيقة_إن_غابت(&متغير السياق.العملية, القيمة); }
        | مفتاح_حجة_تشخيص.البدائي -> { ضع_حقيقة_إن_غابت(&متغير السياق.البدائي, القيمة); }
        | مفتاح_حجة_تشخيص.المصدر -> { ضع_حقيقة_إن_غابت(&متغير السياق.المصدر, القيمة); }
        | مفتاح_حجة_تشخيص.الوجهة -> { ضع_حقيقة_إن_غابت(&متغير السياق.الوجهة, القيمة); }
        | مفتاح_حجة_تشخيص.السبب -> { ضع_حقيقة_إن_غابت(&متغير السياق.السبب, القيمة); };
        ف := ف + 1;
    }
    أرجع السياق;
}

// A text fact as owned text; لا_شيء when absent or not text.
عرف نص_حقيقة(الحقل: &اختياري قيمة_حجة_رسالة): اختياري نص {
    طابق *الحقل مع
    | اختياري.موجود(قيمة_حجة_رسالة.نصية(النص)) -> { أرجع اختياري.موجود(انسخ_نص_رسالة(&النص)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حقيقة_نصية(الحقل: &اختياري قيمة_حجة_رسالة): منطقي {
    طابق *الحقل مع
    | اختياري.موجود(قيمة_حجة_رسالة.نصية(_)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف حقيقة_حاضرة(الحقل: &اختياري قيمة_حجة_رسالة): منطقي {
    طابق *الحقل مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف عدد_حقيقة(الحقل: &اختياري قيمة_حجة_رسالة): اختياري طبيعي {
    طابق *الحقل مع
    | اختياري.موجود(قيمة_حجة_رسالة.طبيعية(العدد)) -> { أرجع اختياري.موجود(العدد); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حقيقة_عددية(الحقل: &اختياري قيمة_حجة_رسالة): منطقي {
    طابق *الحقل مع
    | اختياري.موجود(قيمة_حجة_رسالة.طبيعية(_)) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// The typed iSpeak key a record argument carries, before it is resolved to text.
عرف نص_مترجم_في_حجج(الحجج: &متجه حجة_تشخيص, المفتاح: مفتاح_حجة_تشخيص): اختياري مفتاح_نص_مترجم {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحجج) مثل طبيعي)) {
        إذا ((*الحجج)[ف].المفتاح == المفتاح) {
            طابق (*الحجج)[ف].القيمة مع
            | قيمة_حجة_تشخيص.نص_مترجم(القيمة) -> { أرجع اختياري.موجود(القيمة); }
            | _ -> { أرجع اختياري.لا_شيء(); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Pipeline stage names are internal; they are shown only for internal failures.
عرف فئة_تعرض_المرحلة(الفئة: فئة_تشخيص): منطقي {
    طابق الفئة مع
    | فئة_تشخيص.داخلي -> { أرجع صواب; }
    | فئة_تشخيص.غير_منفذ -> { أرجع صواب; }
    | فئة_تشخيص.مستخدم -> { أرجع خطأ; }
    | فئة_تشخيص.بيئة -> { أرجع خطأ; };
}

// A template headline over one text fact, the القيمة fact by default.
عرف عنوان_نص_محدد(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقل: &متغير اختياري قيمة_حجة_رسالة
): اختياري نص {
    طابق نص_حقيقة(الحقل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النص) -> {
        دع القيم: حقائق_نص_محدد = { القيمة: النص };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.نص_محدد(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            *الحقل := اختياري.لا_شيء();
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_بدائي_تفسير(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة,
    يقارن_العدد: منطقي
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).البدائي) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(البدائي) -> {
        // A count comparison is left to the shared count grammar.
        دع المتوقع: متغير اختياري طبيعي = عدد_حقيقة(&(*السياق).المتوقع);
        دع الموجود: متغير اختياري طبيعي = عدد_حقيقة(&(*السياق).الموجود);
        إذا (يقارن_العدد) {
            المتوقع := اختياري.لا_شيء();
            الموجود := اختياري.لا_شيء();
        };
        دع يستهلك_المتوقع: منطقي = (!يقارن_العدد) && حقيقة_عددية(&(*السياق).المتوقع);
        دع يستهلك_الموجود: منطقي = (!يقارن_العدد) && حقيقة_عددية(&(*السياق).الموجود);
        دع القيم: حقائق_بدائي_تفسير = {
            البدائي: البدائي, الفهرس: عدد_حقيقة(&(*السياق).الفهرس),
            المتوقع: المتوقع, الموجود: الموجود
        };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.بدائي_تفسير(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).البدائي := اختياري.لا_شيء();
            إذا (حقيقة_عددية(&(*السياق).الفهرس)) { (*السياق).الفهرس := اختياري.لا_شيء(); };
            إذا (يستهلك_المتوقع) { (*السياق).المتوقع := اختياري.لا_شيء(); };
            إذا (يستهلك_الموجود) { (*السياق).الموجود := اختياري.لا_شيء(); };
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_ربط_إل_إل_في_إم(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الهدف) -> {
        طابق نص_حقيقة(&(*السياق).الرمز) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الرمز) -> {
            دع القيم: حقائق_ربط_إل_إل_في_إم = { الهدف: الهدف, الرمز: الرمز };
            طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.ربط_إل_إل_في_إم(القيم)) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(العنوان) -> {
                (*السياق).الهدف := اختياري.لا_شيء();
                (*السياق).الرمز := اختياري.لا_شيء();
                أرجع اختياري.موجود(العنوان);
            };
        };
    };
}

عرف عنوان_فشل_وقت_الترجمة(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرسالة) -> {
        دع القيم: حقائق_فشل_وقت_الترجمة = { الرسالة: الرسالة };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.فشل_وقت_الترجمة(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).القيمة := اختياري.لا_شيء();
            أرجع اختياري.موجود(العنوان);
        };
    };
}

// The manifest reason, when present, is a typed iSpeak key the template words.
عرف عنوان_بيان_حزمة(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحجج: &متجه حجة_تشخيص,
    السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    دع سبب_البيان: اختياري مفتاح_نص_مترجم = نص_مترجم_في_حجج(الحجج, مفتاح_حجة_تشخيص.السبب());
    دع سبب_مترجم: متغير منطقي = خطأ;
    طابق سبب_البيان مع
    | اختياري.موجود(_) -> { سبب_مترجم := صواب; }
    | اختياري.لا_شيء -> { };
    إذا (حقيقة_حاضرة(&(*السياق).السبب) && !سبب_مترجم) { أرجع اختياري.لا_شيء(); };
    طابق نص_حقيقة(&(*السياق).المسار) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار) -> {
        دع القيم: حقائق_بيان_حزمة = {
            المسار: المسار, البايت: عدد_حقيقة(&(*السياق).الفهرس), السبب: سبب_البيان
        };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.بيان_حزمة(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).المسار := اختياري.لا_شيء();
            إذا (حقيقة_عددية(&(*السياق).الفهرس)) { (*السياق).الفهرس := اختياري.لا_شيء(); };
            إذا (سبب_مترجم) { (*السياق).السبب := اختياري.لا_شيء(); };
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_اقتراح_كلمة(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).الاستبدال) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاستبدال) -> {
        دع القيم: حقائق_اقتراح_كلمة = { الاستبدال: الاستبدال };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.اقتراح_كلمة(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).الاستبدال := اختياري.لا_شيء();
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_توقع_نحوي(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).المتوقع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المتوقع) -> {
        دع يستهلك_الموجود: منطقي = حقيقة_نصية(&(*السياق).الموجود);
        دع القيم: حقائق_توقع_نحوي = { المتوقع: المتوقع, الموجود: نص_حقيقة(&(*السياق).الموجود) };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.توقع_نحوي(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).المتوقع := اختياري.لا_شيء();
            إذا (يستهلك_الموجود) { (*السياق).الموجود := اختياري.لا_شيء(); };
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_اسم_غير_معروف(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).القيمة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع القيم: حقائق_اسم_غير_معروف = { الاسم: الاسم };
        طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.اسم_غير_معروف(القيم)) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(العنوان) -> {
            (*السياق).القيمة := اختياري.لا_شيء();
            أرجع اختياري.موجود(العنوان);
        };
    };
}

عرف عنوان_نوعين_غير_متوافقين(
    اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    طابق نص_حقيقة(&(*السياق).المتوقع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المتوقع) -> {
        طابق نص_حقيقة(&(*السياق).الموجود) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموجود) -> {
            دع القيم: حقائق_نوعان_غير_متوافقين = { المتوقع: المتوقع, الموجود: الموجود };
            طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, حقائق_رسالة.نوعان_غير_متوافقين(القيم)) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(العنوان) -> {
                (*السياق).المتوقع := اختياري.لا_شيء();
                (*السياق).الموجود := اختياري.لا_شيء();
                أرجع اختياري.موجود(العنوان);
            };
        };
    };
}

// The headline a specialised template gives when the producer supplied the
// facts it needs. It clears exactly those facts; لا_شيء keeps the identity's
// fixed headline. The call-argument count has no template: the shared
// composer words it with the locale's count grammar (CLDR categories).
عرف عنوان_قالب_تشخيص(
    اللغة: لغة_تشخيص, المعرف: معرف_تشخيص, المفتاح: مفتاح_رسالة_تشخيص,
    الحجج: &متجه حجة_تشخيص, السياق: &متغير حقائق_سياق_رسالة
): اختياري نص {
    // A C diagnostic (Jisr): its title, then Jisr's text of the problem.
    // A typed C diagnostic (a C reason and its facts, foreign_c.sn) is worded
    // like every other diagnostic: its title, the reason, then its facts.
    إذا (هو_تشخيص_سي(المعرف) && !حقيقة_حاضرة(&(*السياق).السبب)) {
        أرجع عنوان_فشل_وقت_الترجمة(اللغة, المفتاح, السياق);
    };
    طابق المعرف مع
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).القيمة); }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> { أرجع عنوان_نص_محدد(اللغة, المفتاح, &متغير (*السياق).الهدف); }
    | معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة -> { أرجع عنوان_ربط_إل_إل_في_إم(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول -> { أرجع عنوان_ربط_إل_إل_في_إم(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.فشل_وقت_الترجمة_مطلوب -> { أرجع عنوان_فشل_وقت_الترجمة(اللغة, المفتاح, السياق); }
    // The package graph's headline: its path, and the reason.
    | معرف_تشخيص.رسم_حزم_غير_صالح -> { أرجع عنوان_بيان_حزمة(اللغة, المفتاح, الحجج, السياق); }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> { أرجع عنوان_اقتراح_كلمة(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.خطأ_نحوي -> { أرجع عنوان_توقع_نحوي(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.اسم_غير_معروف -> { أرجع عنوان_اسم_غير_معروف(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.نوعان_غير_متوافقين -> { أرجع عنوان_نوعين_غير_متوافقين(اللغة, المفتاح, السياق); }
    // The new (المتوقع) and the old (الموجود) spelling: the same pair of facts.
    | معرف_تشخيص.تهجئة_مهجورة -> { أرجع عنوان_نوعين_غير_متوافقين(اللغة, المفتاح, السياق); }
    | معرف_تشخيص.حجة_بدائي_تفسير_غير_صالحة -> { أرجع عنوان_بدائي_تفسير(اللغة, المفتاح, السياق, خطأ); }
    | معرف_تشخيص.عدد_حجج_بدائي_تفسير_غير_مطابق -> { أرجع عنوان_بدائي_تفسير(اللغة, المفتاح, السياق, صواب); }
    // Every other identity has a fixed headline; its facts are context sentences.
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف نص_رسالة_تشخيص(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): نص {
    دع المعرف: معرف_تشخيص = (*التشخيص).المعرف;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرف);
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(المعرف);
    دع السياق: متغير حقائق_سياق_رسالة = سياق_حجج_تشخيص(اللغة, &(*التشخيص).الحجج);
    إذا (!فئة_تعرض_المرحلة(التعريف.الفئة)) { السياق.المرحلة := اختياري.لا_شيء(); };
    دع العنوان: متغير نص = «»;
    طابق عنوان_قالب_تشخيص(اللغة, المعرف, المفتاح, &(*التشخيص).الحجج, &متغير السياق) مع
    | اختياري.موجود(النص) -> { العنوان := النص; }
    | اختياري.لا_شيء -> { العنوان := رسالة_تشخيص(اللغة, المفتاح); };
    أرجع رسالة_تشخيص_بعنوان_وسياق(اللغة, المفتاح, العنوان, السياق);
}

// A note, help line or trace entry with its arguments, as one localized text.
عام عرف نص_تعليق_تشخيص(اللغة: لغة_تشخيص, المفتاح: مفتاح_صياغة, الحجج: &متجه حجة_تشخيص): نص {
    إذا ((الطول(*الحجج) مثل طبيعي) == 0) { أرجع نص_تفصيل_ثابت(اللغة, المفتاح); };
    دع السياق: حقائق_سياق_رسالة = سياق_حجج_تشخيص(اللغة, الحجج);
    طابق نص_تفصيل_بحجج(اللغة, المفتاح, السياق) مع
    | اختياري.موجود(النص) -> { أرجع النص; }
    | اختياري.لا_شيء -> { أرجع نص_تفصيل_ثابت(اللغة, المفتاح); };
}
