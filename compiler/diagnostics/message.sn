استورد std.text.from_bytes;
استورد std.text.number;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.localization;

// Message composition owns how structured diagnostic facts become localized prose.
// Output transports consume the completed message and never switch on diagnostic identity.

عرف ألحق_نص_رسالة(الناتج: &متغير متجه غ8, القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع الحالية: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(الحالية, النص[ف]);
        ف := ف + 1;
    }
    *الناتج := الحالية;
}

عرف ألحق_ثابتا_لرسالة(الناتج: &متغير متجه غ8, النص: نص): فراغ {
    ألحق_نص_رسالة(الناتج, &النص);
}

عام عرف ابحث_حجة_تشخيص(
    التشخيص: &تشخيص,
    المفتاح: مفتاح_حجة_تشخيص
): اختيار قيمة_حجة_تشخيص {
    دع الحالة: تشخيص = *التشخيص;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحجج) مثل غير_موقع)) {
        لو (الحالة.الحجج[ف].المفتاح == المفتاح) {
            دع مرجع_القيمة: &قيمة_حجة_تشخيص = &الحالة.الحجج[ف].القيمة;
            دع القيمة: قيمة_حجة_تشخيص = *مرجع_القيمة;
            أرجع اختيار.بعض(القيمة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف نص_قيمة_حجة_تشخيص(
    اللغة: لغة_تشخيص,
    القيمة: &قيمة_حجة_تشخيص
): نص {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { أرجع النص; }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        طابق اللغة مع
        | لغة_تشخيص.الإنجليزية -> { أرجع الإنجليزية; }
        | لغة_تشخيص.العربية -> { أرجع العربية; };
    }
    | قيمة_حجة_تشخيص.غير_موقعة(العدد) -> { أرجع غير_موقع_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> { أرجع عدد_إلى_نص(العدد); }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        لو (القيمة_المنطقية) {
            أرجع صياغة_تشخيص(اللغة, مفتاح_صياغة.قيمة_منطقية_صواب());
        };
        أرجع صياغة_تشخيص(اللغة, مفتاح_صياغة.قيمة_منطقية_خطأ());
    };
}

عرف ألحق_حجة_رسالة(
    الناتج: &متغير متجه غ8,
    التشخيص: &تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    اللغة: لغة_تشخيص,
    اقتباس: منطقي
): منطقي {
    طابق ابحث_حجة_تشخيص(التشخيص, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> {
        لو (اقتباس) { ألحق_ثابتا_لرسالة(الناتج, «`»); };
        دع النص: نص = نص_قيمة_حجة_تشخيص(اللغة, &القيمة);
        ألحق_نص_رسالة(الناتج, &النص);
        لو (اقتباس) { ألحق_ثابتا_لرسالة(الناتج, «`»); };
        أرجع صواب;
    };
}

عرف ألحق_تفصيل_تشخيص(
    الناتج: &متغير متجه غ8,
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    طابق الحالة.المعرف مع
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        ألحق_ثابتا_لرسالة(الناتج, «: »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب
        );
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        ألحق_ثابتا_لرسالة(الناتج, « »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.الهدف(), اللغة, صواب
        );
    }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الاستبدال()) مع
        | اختيار.بعض(الاستبدال) -> {
            ألحق_ثابتا_لرسالة(الناتج, «: »);
            دع النص: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_هل_تقصد());
            ألحق_نص_رسالة(الناتج, &النص);
            ألحق_ثابتا_لرسالة(الناتج, « `»);
            دع القيمة: نص = نص_قيمة_حجة_تشخيص(اللغة, &الاستبدال);
            ألحق_نص_رسالة(الناتج, &القيمة);
            ألحق_ثابتا_لرسالة(الناتج, «`?»);
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.خطأ_نحوي -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.المتوقع()) مع
        | اختيار.بعض(المتوقع) -> {
            ألحق_ثابتا_لرسالة(الناتج, «: »);
            دع تسمية_المتوقع: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_متوقع());
            ألحق_نص_رسالة(الناتج, &تسمية_المتوقع);
            ألحق_ثابتا_لرسالة(الناتج, « `»);
            دع نص_المتوقع: نص = نص_قيمة_حجة_تشخيص(اللغة, &المتوقع);
            ألحق_نص_رسالة(الناتج, &نص_المتوقع);
            ألحق_ثابتا_لرسالة(الناتج, «`»);
            طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الموجود()) مع
            | اختيار.بعض(الموجود) -> {
                ألحق_ثابتا_لرسالة(الناتج, «, »);
                دع تسمية_الموجود: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_موجود());
                ألحق_نص_رسالة(الناتج, &تسمية_الموجود);
                ألحق_ثابتا_لرسالة(الناتج, « `»);
                دع نص_الموجود: نص = نص_قيمة_حجة_تشخيص(اللغة, &الموجود);
                ألحق_نص_رسالة(الناتج, &نص_الموجود);
                ألحق_ثابتا_لرسالة(الناتج, «`»);
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.عدد_حجج_غير_مطابق -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.المتوقع()) مع
        | اختيار.بعض(المتوقع) -> {
            ألحق_ثابتا_لرسالة(الناتج, «: »);
            دع تسمية_المتوقع: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_متوقع());
            ألحق_نص_رسالة(الناتج, &تسمية_المتوقع);
            ألحق_ثابتا_لرسالة(الناتج, « »);
            دع نص_المتوقع: نص = نص_قيمة_حجة_تشخيص(اللغة, &المتوقع);
            ألحق_نص_رسالة(الناتج, &نص_المتوقع);
            طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الموجود()) مع
            | اختيار.بعض(الموجود) -> {
                ألحق_ثابتا_لرسالة(الناتج, «, »);
                دع تسمية_الموجود: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_موجود());
                ألحق_نص_رسالة(الناتج, &تسمية_الموجود);
                ألحق_ثابتا_لرسالة(الناتج, « »);
                دع نص_الموجود: نص = نص_قيمة_حجة_تشخيص(اللغة, &الموجود);
                ألحق_نص_رسالة(الناتج, &نص_الموجود);
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.بدائي_مضيف_تفسير_غير_مدعوم -> {
        ألحق_ثابتا_لرسالة(الناتج, «: »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.البدائي(), اللغة, صواب
        );
    }
    | معرف_تشخيص.جسر_نص_مضيف_تفسير_غير_متاح -> {
        ألحق_ثابتا_لرسالة(الناتج, «: »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.البدائي(), اللغة, صواب
        );
    }
    | معرف_تشخيص.حجة_بدائي_تفسير_غير_صالحة -> {
        ألحق_ثابتا_لرسالة(الناتج, «: »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.البدائي(), اللغة, صواب
        );
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الفهرس()) مع
        | اختيار.بعض(الفهرس) -> {
            ألحق_ثابتا_لرسالة(الناتج, «, »);
            دع التسمية: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_فهرس());
            ألحق_نص_رسالة(الناتج, &التسمية);
            ألحق_ثابتا_لرسالة(الناتج, « »);
            دع النص: نص = نص_قيمة_حجة_تشخيص(اللغة, &الفهرس);
            ألحق_نص_رسالة(الناتج, &النص);
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.عدد_حجج_بدائي_تفسير_غير_مطابق -> {
        ألحق_ثابتا_لرسالة(الناتج, «: »);
        دع كتب: منطقي = ألحق_حجة_رسالة(
            الناتج, التشخيص, مفتاح_حجة_تشخيص.البدائي(), اللغة, صواب
        );
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.المتوقع()) مع
        | اختيار.بعض(المتوقع) -> {
            ألحق_ثابتا_لرسالة(الناتج, «, »);
            دع التسمية: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_متوقع());
            ألحق_نص_رسالة(الناتج, &التسمية);
            ألحق_ثابتا_لرسالة(الناتج, « »);
            دع النص: نص = نص_قيمة_حجة_تشخيص(اللغة, &المتوقع);
            ألحق_نص_رسالة(الناتج, &النص);
        }
        | اختيار.لا_شيء -> { };
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الموجود()) مع
        | اختيار.بعض(الموجود) -> {
            ألحق_ثابتا_لرسالة(الناتج, «, »);
            دع التسمية: نص = صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_موجود());
            ألحق_نص_رسالة(الناتج, &التسمية);
            ألحق_ثابتا_لرسالة(الناتج, « »);
            دع النص: نص = نص_قيمة_حجة_تشخيص(اللغة, &الموجود);
            ألحق_نص_رسالة(الناتج, &النص);
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };
}

عام عرف نص_رسالة_تشخيص(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): نص {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    دع المفتاح: متغير مفتاح_صياغة = التعريف.الصياغة;
    لو (التعريف.الفئة == فئة_تشخيص.داخلي()) {
        المفتاح := مفتاح_صياغة.رسالة_فشل_مترجم_داخلي();
    };
    دع الأساس: نص = صياغة_تشخيص(اللغة, المفتاح);
    دع البايتات: متغير متجه غ8 = [];
    ألحق_نص_رسالة(&متغير البايتات, &الأساس);
    لو (التعريف.الفئة != فئة_تشخيص.داخلي()) {
        ألحق_تفصيل_تشخيص(&متغير البايتات, التشخيص, اللغة);
    };
    أرجع من_بايتات(&البايتات);
}
