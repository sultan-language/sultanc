عام عرف معرف_تشخيص_من_كود(الكود: &نص): اختياري معرف_تشخيص {
    دع المعرفات: متجه معرف_تشخيص = كل_معرفات_التشخيص();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
        دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرفات[ف]);
        لو (نصان_متساويان(&التعريف.الكود, الكود)) { أرجع اختياري.موجود(المعرفات[ف]); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
