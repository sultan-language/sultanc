    ألحق(الناتج, معرف_تشخيص.تحذير_عام());
    أرجع الناتج;
}

عام عرف معرف_تشخيص_من_كود(الكود: &نص): اختيار معرف_تشخيص {
    دع المعرفات: متجه معرف_تشخيص = كل_معرفات_التشخيص();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المعرفات) مثل غير_موقع)) {
        دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرفات[ف]);
        لو (نصان_متساويان(&التعريف.الكود, الكود)) { أرجع اختيار.بعض(المعرفات[ف]); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}
