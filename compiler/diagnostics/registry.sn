استورد std.text.compare;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;

// Single compiler-owned registry for public code, machine kind, severity and class.
// Public codes are descriptive and stable; numeric E-codes are intentionally retired.
عام نوع تعريف_تشخيص = {
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص
};

عرف أنشئ_تعريف_تشخيص(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص
): تعريف_تشخيص {
    دع التعريف: تعريف_تشخيص = {
        المعرف: المعرف,
        الكود: الكود,
        النوع_الآلي: النوع_الآلي,
        الشدة: الشدة,
        الفئة: الفئة
    };
    أرجع التعريف;
}

عرف تعريف_خطأ(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف,
        الكود,
        النوع_الآلي,
        شدة_تشخيص.خطأ(),
        فئة_تشخيص.مستخدم()
    );
}

عرف تعريف_خطأ_بيئي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.بيئة()
    );
}

عرف تعريف_خطأ_داخلي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.داخلي()
    );
}

عام عرف تعريف_التشخيص(المعرف: معرف_تشخيص): تعريف_تشخيص {
    طابق المعرف مع
    | معرف_تشخيص.خطأ_نحوي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-SYNTAX», «syntax-error»);
    }
    | معرف_تشخيص.تعبير_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-EXPRESSION», «invalid-expression-syntax»);
    }
    | معرف_تشخيص.نوع_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-TYPE», «invalid-type-syntax»);
    }
    | معرف_تشخيص.نمط_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-PATTERN», «invalid-pattern-syntax»);
    }
    | معرف_تشخيص.عنصر_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-ITEM», «invalid-item-syntax»);
    }
    | معرف_تشخيص.خلل_محلل_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-PARSER-FAILURE», «parser-internal-failure»);
    }
    | معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-MISPLACED-SEMICOLON», «misplaced-semicolon»);
    }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-KEYWORD-TYPO», «keyword-typo»);
    }
    | معرف_تشخيص.تهجئة_مهجورة -> {
        // An old spelling kept for one release (token_registry.def,
        // SULTANC__KEYWORD_DEPRECATED__) compiles as the new one, with a warning.
        أرجع أنشئ_تعريف_تشخيص(
            المعرف, «SULTANC-SYNTAX-DEPRECATED-SPELLING», «deprecated-spelling»,
            شدة_تشخيص.تحذير(), فئة_تشخيص.مستخدم()
        );
    }
    | معرف_تشخيص.عبارة_بلا_عملية -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-INCOMPLETE-STATEMENT», «statement-without-operation»);
    }
    | معرف_تشخيص.نوع_ناتج_دالة_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-MISSING-RETURN-TYPE», «missing-function-return-type»);
    }
    | معرف_تشخيص.خطأ_معجمي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-LEX-INVALID-TOKEN», «lexical-error»);
    }
    | معرف_تشخيص.نص_مصدر_يوتيف8_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-LEX-INVALID-UTF8», «invalid-source-utf8»);
    }
    | معرف_تشخيص.خلل_معجمي_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LEXER-FAILURE», «lexer-internal-failure»);
    }
    | معرف_تشخيص.لا_ناتج_تحليل -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-PARSER-NO-RESULT», «parser-no-result»);
    }
    | معرف_تشخيص.استدعاء_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-INVOCATION», «invalid-invocation»);
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TARGET-UNKNOWN», «unknown-target»);
    }
    | معرف_تشخيص.مصدر_مترجم_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MISSING-SOURCE», «missing-source»);
    }
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-OPTION», «unknown-option»);
    }
    | معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-DIAGNOSTIC-CODE», «unknown-diagnostic-code»);
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MISSING-OPTION-VALUE», «missing-option-value»);
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-LANGUAGE», «invalid-language»);
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-FORMAT», «invalid-diagnostic-format»);
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-COLOR», «invalid-diagnostic-color»);
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MULTIPLE-PRIMARY-SOURCES», «multiple-primary-sources»);
    }
    | معرف_تشخيص.أوضاع_مترجم_متعارضة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-CONFLICTING-MODES», «conflicting-modes»);
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNEXPECTED-ARGUMENT», «unexpected-positional-argument»);
    }
    | معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-TARGET-HOST-UNAVAILABLE», «host-target-unavailable»);
    }
    | معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-LINK-LLVM-LIBRARY-MISSING», «link-llvm-library-missing»);
    }
    | معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-LINK-LLVM-SYMBOL-UNRESOLVED», «link-llvm-symbol-unresolved»);
    }
    | معرف_تشخيص.خلفية_مترجم_غير_متاحة -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-BACKEND-UNAVAILABLE», «backend-unavailable»);
    }
    | معرف_تشخيص.فشل_كتابة_مخرج_مترجم -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-IO-OUTPUT-WRITE-FAILED», «output-write-failure»);
    }
    | معرف_تشخيص.فشل_مترجم_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-COMPILER-FAILURE», «internal-compiler-failure»);
    }
    | معرف_تشخيص.ملف_إدخال_مفقود -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-IO-INPUT-NOT-FOUND», «missing-input-file»);
    }
    | معرف_تشخيص.بيان_حزمة_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PACKAGE-MANIFEST-INVALID», «invalid-package-manifest»);
    }
    | معرف_تشخيص.نوع_ملف_إدخال_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-INPUT-TYPE», «unknown-input-file-type»);
    }
    | معرف_تشخيص.وحدة_مصدر_غير_موجودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-NOT-FOUND», «missing-source-module»);
    }
    | معرف_تشخيص.وحدة_مصدر_غير_مقروءة -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-MODULE-SOURCE-UNREADABLE», «unreadable-source-module»);
    }
    | معرف_تشخيص.مرجع_استيراد_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-INVALID-REFERENCE», «invalid-import-reference»);
    }
    | معرف_تشخيص.جذر_مكتبة_غير_مسجل -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-MODULE-LIBRARY-ROOT-UNREGISTERED», «unregistered-library-root»);
    }
    | معرف_تشخيص.استيراد_يهرب_من_الجذر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-ESCAPES-ROOT», «import-escapes-root»);
    }
    | معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-INVALID-LOGICAL-PATH», «invalid-logical-module-path»);
    }
    | معرف_تشخيص.تعارض_مسار_وحدة_عام -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-PUBLIC-PATH-CONFLICT», «public-module-path-conflict»);
    }
    | معرف_تشخيص.تعارض_مصدر_وحدة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-SOURCE-CONFLICT», «module-source-conflict»);
    }
    | معرف_تشخيص.وحدة_مستوردة_غير_محملة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-MODULE-IMPORT-NOT-LOADED», «import-module-not-loaded»);
    }
    | معرف_تشخيص.رسم_وحدات_مرفوض -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-MODULE-GRAPH-REJECTED», «module-graph-rejected»);
    }
    | معرف_تشخيص.تصدير_انتقائي_غير_موجود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-SELECTIVE-EXPORT-NOT-FOUND», «selective-export-not-found»);
    }
    | معرف_تشخيص.نقطة_دخول_مفقودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-ENTRYPOINT-NOT-FOUND», «entrypoint-not-found»);
    }
    | معرف_تشخيص.نقطة_دخول_بتوقيع_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-ENTRYPOINT-INVALID-SIGNATURE», «invalid-entrypoint-signature»);
    }
    | معرف_تشخيص.تصريح_خاص_غير_متاح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-PRIVATE», «private-declaration»);
    }
    | معرف_تشخيص.نوع_تكراري_لانهائي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-INFINITE-RECURSION», «infinite-recursive-type»);
    }
    | معرف_تشخيص.فك_مرجع_غير_مؤشر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-DEREFERENCE-NON-POINTER», «dereference-non-pointer»);
    }
    | معرف_تشخيص.أخذ_عنوان_غير_قيمة_يسرى -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-ADDRESS-OF-NON-LVALUE», «address-of-non-lvalue»);
    }
    | معرف_تشخيص.حقل_سجل_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-MISSING-RECORD-FIELD», «missing-record-field»);
    }
    | معرف_تشخيص.حقل_سجل_مكرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-DUPLICATE-RECORD-FIELD», «duplicate-record-field»);
    }
    | معرف_تشخيص.كتابة_إلى_غير_متغير -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE», «write-to-immutable»);
    }
    | معرف_تشخيص.تصريح_مكرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-DUPLICATE-DECLARATION», «duplicate-declaration»);
    }
    | معرف_تشخيص.اسم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-UNKNOWN», «unknown-name»);
    }
    | معرف_تشخيص.اسم_غير_محلول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-UNRESOLVED», «unresolved-name»);
    }
    | معرف_تشخيص.استيراد_غامض -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-AMBIGUOUS», «ambiguous-import»);
    }
    | معرف_تشخيص.دورة_استيراد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-CYCLE», «import-cycle»);
    }
    | معرف_تشخيص.نوعان_غير_متوافقين -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-MISMATCH», «type-mismatch»);
    }
    | معرف_تشخيص.نوع_غير_محلول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-UNRESOLVED», «unresolved-type»);
    }
    | معرف_تشخيص.تعريف_نوع_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-INVALID-DEFINITION», «invalid-type-definition»);
    }
    | معرف_تشخيص.تعبير_نوعي_غير_مدعوم -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-TYPE-UNSUPPORTED-EXPRESSION», «unsupported-expression-type-analysis»);
    }
    | معرف_تشخيص.تعبير_غير_قابل_للاستدعاء -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CALL-NOT-CALLABLE», «expression-not-callable»);
    }
    | معرف_تشخيص.حقل_سجل_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-UNKNOWN-RECORD-FIELD», «unknown-record-field»);
    }
    | معرف_تشخيص.منشئ_نوع_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-INVALID-CONSTRUCTOR», «invalid-constructor»);
    }
    | معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PATTERN-PAYLOAD-COUNT-MISMATCH», «pattern-payload-count-mismatch»);
    }
    | معرف_تشخيص.نمط_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PATTERN-INVALID», «invalid-pattern»);
    }
    | معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-COMPTIME-NON-CONSTANT», «comptime-non-constant»);
    }
    | معرف_تشخيص.فشل_وقت_الترجمة_مطلوب -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-COMPTIME-FAILED», «comptime-failed»);
    }
    | معرف_تشخيص.سمة_تصريح_غير_مدعومة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-ANNOTATION-UNSUPPORTED», «annotation-processing-unavailable»);
    }
    | معرف_تشخيص.خفض_تعبير_غير_مدعوم -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-UNSUPPORTED-EXPRESSION», «unsupported-expression-lowering»);
    }
    | معرف_تشخيص.خفض_عبارة_غير_مدعومة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-UNSUPPORTED-STATEMENT», «unsupported-statement-lowering»);
    }
    | معرف_تشخيص.دالة_خفض_مفقودة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-MISSING-FUNCTION-FACT», «missing-function-semantic-fact»);
    }
    | معرف_تشخيص.ربط_اسم_خفض_مفقود -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-MISSING-NAME-BINDING», «missing-name-binding»);
    }
    | معرف_تشخيص.نوع_خفض_مفقود -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-MISSING-TYPE-FACT», «missing-type-fact»);
    }
    | معرف_تشخيص.هوية_منشئ_خفض_مفقودة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-MISSING-CONSTRUCTOR», «missing-constructor-identity»);
    }
    | معرف_تشخيص.عدد_حجج_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CALL-ARGUMENT-COUNT-MISMATCH», «argument-count-mismatch»);
    }
    | معرف_تشخيص.نوع_حجة_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CALL-ARGUMENT-TYPE-MISMATCH», «argument-type-mismatch»);
    }
    | معرف_تشخيص.نوع_إرجاع_غير_مطابق -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-RETURN-MISMATCH», «return-type-mismatch»);
    }
    | معرف_تشخيص.استخدام_قبل_التهيئة -> {
