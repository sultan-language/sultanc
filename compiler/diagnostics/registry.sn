    ألحق(الناتج, معرف_تشخيص.هوية_منشئ_خفض_مفقودة());
    ألحق(الناتج, معرف_تشخيص.عدد_حجج_غير_مطابق());
    ألحق(الناتج, معرف_تشخيص.نوع_حجة_غير_مطابق());
    ألحق(الناتج, معرف_تشخيص.نوع_إرجاع_غير_مطابق());
    ألحق(الناتج, معرف_تشخيص.استخدام_قبل_التهيئة());
    ألحق(الناتج, معرف_تشخيص.استخدام_بعد_النقل());
    ألحق(الناتج, معرف_تشخيص.مورد_محرر());
    ألحق(الناتج, معرف_تشخيص.تعارض_استعارة());
    ألحق(الناتج, معرف_تشخيص.هروب_مرجع());
    ألحق(الناتج, معرف_تشخيص.عملية_غير_آمنة());
    ألحق(الناتج, معرف_تشخيص.فهرس_خارج_الحدود());
    ألحق(الناتج, معرف_تشخيص.نمط_غير_شامل());
    ألحق(الناتج, معرف_تشخيص.نمط_غير_قابل_للوصول());
    ألحق(الناتج, معرف_تشخيص.إرجاع_مفقود());
    ألحق(الناتج, معرف_تشخيص.نقل_جزئي_مملوك());
    ألحق(الناتج, معرف_تشخيص.خطأ_ذاكرة_نوع());
    ألحق(الناتج, معرف_تشخيص.مسير_غير_صالح());
