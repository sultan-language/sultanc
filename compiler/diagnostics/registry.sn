استورد std.text.compare;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;

// Single compiler-owned registry for public code, machine kind, severity and class.
// Public codes are descriptive and stable; numeric E-codes are intentionally retired.
عام نوع تعريف_تشخيص = {
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص,
    الصياغة: مفتاح_صياغة
};

عرف أنشئ_تعريف_تشخيص(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الشدة: شدة_تشخيص,
    الفئة: فئة_تشخيص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    دع التعريف: تعريف_تشخيص = {
        المعرف: المعرف,
        الكود: الكود,
        النوع_الآلي: النوع_الآلي,
        الشدة: الشدة,
        الفئة: الفئة,
        الصياغة: الصياغة
    };
    أرجع التعريف;
}

عرف تعريف_خطأ(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف,
        الكود,
        النوع_الآلي,
        شدة_تشخيص.خطأ(),
        فئة_تشخيص.مستخدم(),
        الصياغة
    );
}

عرف تعريف_خطأ_بيئي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.بيئة(), الصياغة
    );
}

عرف تعريف_خطأ_داخلي(
    المعرف: معرف_تشخيص,
    الكود: نص,
    النوع_الآلي: نص,
    الصياغة: مفتاح_صياغة
): تعريف_تشخيص {
    أرجع أنشئ_تعريف_تشخيص(
        المعرف, الكود, النوع_الآلي, شدة_تشخيص.خطأ(), فئة_تشخيص.داخلي(), الصياغة
    );
}

عام عرف تعريف_التشخيص(المعرف: معرف_تشخيص): تعريف_تشخيص {
    طابق المعرف مع
    | معرف_تشخيص.خطأ_نحوي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-SYNTAX», «syntax-error», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.تعبير_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-EXPRESSION», «invalid-expression-syntax», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.نوع_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-TYPE», «invalid-type-syntax», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.نمط_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-PATTERN», «invalid-pattern-syntax», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.عنصر_نحوي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-ITEM», «invalid-item-syntax», مفتاح_صياغة.رسالة_خطأ_نحوي());
    }
    | معرف_تشخيص.خلل_محلل_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-PARSER-FAILURE», «parser-internal-failure», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-MISPLACED-SEMICOLON», «misplaced-semicolon», مفتاح_صياغة.رسالة_فاصلة_منقوطة_في_غير_موضعها());
    }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-KEYWORD-TYPO», «keyword-typo», مفتاح_صياغة.رسالة_تهجئة_كلمة_محجوزة_غير_معروفة());
    }
    | معرف_تشخيص.عبارة_بلا_عملية -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-INCOMPLETE-STATEMENT», «statement-without-operation», مفتاح_صياغة.رسالة_عبارة_بلا_عملية());
    }
    | معرف_تشخيص.نوع_ناتج_دالة_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-MISSING-RETURN-TYPE», «missing-function-return-type», مفتاح_صياغة.رسالة_نوع_ناتج_دالة_مفقود());
    }
    | معرف_تشخيص.خطأ_معجمي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-LEX-INVALID-TOKEN», «lexical-error», مفتاح_صياغة.رسالة_خطأ_معجمي());
    }
    | معرف_تشخيص.نص_مصدر_يوتيف8_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-LEX-INVALID-UTF8», «invalid-source-utf8», مفتاح_صياغة.رسالة_نص_مصدر_يوتيف8_غير_صالح());
    }
    | معرف_تشخيص.خلل_معجمي_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LEXER-FAILURE», «lexer-internal-failure», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.رفض_تحليل -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-PARSE-REJECTED», «parse-rejected», مفتاح_صياغة.رسالة_رفض_تحليل());
    }
    | معرف_تشخيص.لا_ناتج_تحليل -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-PARSER-NO-RESULT», «parser-no-result», مفتاح_صياغة.رسالة_لا_ناتج_تحليل());
    }
    | معرف_تشخيص.استدعاء_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-INVOCATION», «invalid-invocation», مفتاح_صياغة.رسالة_استدعاء_مترجم_غير_صالح());
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TARGET-UNKNOWN», «unknown-target», مفتاح_صياغة.رسالة_هدف_مترجم_غير_معروف());
    }
    | معرف_تشخيص.مصدر_مترجم_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MISSING-SOURCE», «missing-source», مفتاح_صياغة.رسالة_مصدر_مترجم_مفقود());
    }
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-OPTION», «unknown-option», مفتاح_صياغة.رسالة_خيار_مترجم_غير_معروف());
    }
    | معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-DIAGNOSTIC-CODE», «unknown-diagnostic-code», مفتاح_صياغة.رسالة_رمز_تشخيص_مترجم_غير_معروف());
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MISSING-OPTION-VALUE», «missing-option-value», مفتاح_صياغة.رسالة_قيمة_خيار_مترجم_مفقودة());
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-LANGUAGE», «invalid-language», مفتاح_صياغة.رسالة_لغة_تشخيص_مترجم_غير_صالحة());
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-FORMAT», «invalid-diagnostic-format», مفتاح_صياغة.رسالة_صيغة_تشخيص_مترجم_غير_صالحة());
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-INVALID-DIAGNOSTIC-COLOR», «invalid-diagnostic-color», مفتاح_صياغة.رسالة_لون_تشخيص_مترجم_غير_صالح());
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-MULTIPLE-PRIMARY-SOURCES», «multiple-primary-sources», مفتاح_صياغة.رسالة_مصدر_رئيسي_متعدد());
    }
    | معرف_تشخيص.أوضاع_مترجم_متعارضة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-CONFLICTING-MODES», «conflicting-modes», مفتاح_صياغة.رسالة_أوضاع_مترجم_متعارضة());
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNEXPECTED-ARGUMENT», «unexpected-positional-argument», مفتاح_صياغة.رسالة_معامل_موضعي_غير_متوقع());
    }
    | معرف_تشخيص.هدف_مضيف_مترجم_غير_متاح -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-TARGET-HOST-UNAVAILABLE», «host-target-unavailable», مفتاح_صياغة.رسالة_هدف_مضيف_مترجم_غير_متاح());
    }
    | معرف_تشخيص.فشل_كتابة_مخرج_مترجم -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-IO-OUTPUT-WRITE-FAILED», «output-write-failure», مفتاح_صياغة.رسالة_فشل_كتابة_مخرج_مترجم());
    }
    | معرف_تشخيص.فشل_مترجم_داخلي -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-COMPILER-FAILURE», «internal-compiler-failure», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.ملف_إدخال_مفقود -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-IO-INPUT-NOT-FOUND», «missing-input-file», مفتاح_صياغة.رسالة_ملف_إدخال_مفقود());
    }
    | معرف_تشخيص.نوع_ملف_إدخال_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-CLI-UNKNOWN-INPUT-TYPE», «unknown-input-file-type», مفتاح_صياغة.رسالة_نوع_ملف_إدخال_غير_معروف());
    }
    | معرف_تشخيص.وحدة_مصدر_غير_موجودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-NOT-FOUND», «missing-source-module», مفتاح_صياغة.رسالة_وحدة_مصدر_غير_موجودة());
    }
    | معرف_تشخيص.وحدة_مصدر_غير_مقروءة -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-MODULE-SOURCE-UNREADABLE», «unreadable-source-module», مفتاح_صياغة.رسالة_وحدة_مصدر_غير_مقروءة());
    }
    | معرف_تشخيص.مرجع_استيراد_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-INVALID-REFERENCE», «invalid-import-reference», مفتاح_صياغة.رسالة_مرجع_استيراد_غير_صالح());
    }
    | معرف_تشخيص.جذر_مكتبة_غير_مسجل -> {
        أرجع تعريف_خطأ_بيئي(المعرف, «SULTANC-MODULE-LIBRARY-ROOT-UNREGISTERED», «unregistered-library-root», مفتاح_صياغة.رسالة_جذر_مكتبة_غير_مسجل());
    }
    | معرف_تشخيص.استيراد_يهرب_من_الجذر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-ESCAPES-ROOT», «import-escapes-root», مفتاح_صياغة.رسالة_استيراد_يهرب_من_الجذر());
    }
    | معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-INVALID-LOGICAL-PATH», «invalid-logical-module-path», مفتاح_صياغة.رسالة_مسار_وحدة_منطقي_غير_صالح());
    }
    | معرف_تشخيص.تعارض_مسار_وحدة_عام -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-PUBLIC-PATH-CONFLICT», «public-module-path-conflict», مفتاح_صياغة.رسالة_تعارض_مسار_وحدة_عام());
    }
    | معرف_تشخيص.تعارض_مصدر_وحدة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MODULE-SOURCE-CONFLICT», «module-source-conflict», مفتاح_صياغة.رسالة_تعارض_مصدر_وحدة());
    }
    | معرف_تشخيص.وحدة_مستوردة_غير_محملة -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-MODULE-IMPORT-NOT-LOADED», «import-module-not-loaded», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.رسم_وحدات_مرفوض -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-MODULE-GRAPH-REJECTED», «module-graph-rejected», مفتاح_صياغة.رسالة_فشل_مترجم_داخلي());
    }
    | معرف_تشخيص.تصدير_انتقائي_غير_موجود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-SELECTIVE-EXPORT-NOT-FOUND», «selective-export-not-found», مفتاح_صياغة.رسالة_تصدير_انتقائي_غير_موجود());
    }
    | معرف_تشخيص.نقطة_دخول_مفقودة -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-ENTRYPOINT-NOT-FOUND», «entrypoint-not-found», مفتاح_صياغة.رسالة_نقطة_دخول_مفقودة());
    }
    | معرف_تشخيص.نقطة_دخول_بتوقيع_غير_صالح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-ENTRYPOINT-INVALID-SIGNATURE», «invalid-entrypoint-signature», مفتاح_صياغة.رسالة_نقطة_دخول_بتوقيع_غير_صالح());
    }
    | معرف_تشخيص.تصريح_خاص_غير_متاح -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-PRIVATE», «private-declaration», مفتاح_صياغة.رسالة_تصريح_خاص_غير_متاح());
    }
    | معرف_تشخيص.نوع_تكراري_لانهائي -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-INFINITE-RECURSION», «infinite-recursive-type», مفتاح_صياغة.رسالة_نوع_تكراري_لانهائي());
    }
    | معرف_تشخيص.تحقق_نوعي_غير_مدعوم -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-TYPECHECK-UNSUPPORTED», «unsupported-typecheck», مفتاح_صياغة.رسالة_تحقق_نوعي_غير_مدعوم());
    }
    | معرف_تشخيص.حرفي_خفض_غير_معرف -> {
        أرجع تعريف_خطأ_داخلي(المعرف, «SULTANC-ICE-LOWERING-UNDEFINED-LITERAL», «undefined-literal-lowering», مفتاح_صياغة.رسالة_حرفي_خفض_غير_معرف());
    }
    | معرف_تشخيص.فك_مرجع_غير_مؤشر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-DEREFERENCE-NON-POINTER», «dereference-non-pointer», مفتاح_صياغة.رسالة_فك_مرجع_غير_مؤشر());
    }
    | معرف_تشخيص.أخذ_عنوان_غير_قيمة_يسرى -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-ADDRESS-OF-NON-LVALUE», «address-of-non-lvalue», مفتاح_صياغة.رسالة_أخذ_عنوان_غير_قيمة_يسرى());
    }
    | معرف_تشخيص.حقل_سجل_مفقود -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-MISSING-RECORD-FIELD», «missing-record-field», مفتاح_صياغة.رسالة_حقل_سجل_مفقود());
    }
    | معرف_تشخيص.حقل_سجل_مكرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-TYPE-DUPLICATE-RECORD-FIELD», «duplicate-record-field», مفتاح_صياغة.رسالة_حقل_سجل_مكرر());
    }
    | معرف_تشخيص.كتابة_إلى_غير_متغير -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE», «write-to-immutable», مفتاح_صياغة.رسالة_كتابة_إلى_غير_متغير());
    }
    | معرف_تشخيص.تصريح_مكرر -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-DUPLICATE-DECLARATION», «duplicate-declaration», مفتاح_صياغة.رسالة_تصريح_مكرر());
    }
    | معرف_تشخيص.اسم_غير_معروف -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-UNKNOWN», «unknown-name», مفتاح_صياغة.رسالة_اسم_غير_معروف());
    }
    | معرف_تشخيص.اسم_غير_محلول -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-NAME-UNRESOLVED», «unresolved-name», مفتاح_صياغة.رسالة_اسم_غير_محلول());
    }
    | معرف_تشخيص.استيراد_غامض -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-AMBIGUOUS», «ambiguous-import», مفتاح_صياغة.رسالة_استيراد_غامض());
    }
    | معرف_تشخيص.دورة_استيراد -> {
        أرجع تعريف_خطأ(المعرف, «SULTANC-IMPORT-CYCLE», «import-cycle», مفتاح_صياغة.رسالة_دورة_استيراد());
    }
    | معرف_تشخيص.نوعان_غير_متوافقين -> {
