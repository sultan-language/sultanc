استورد std.text.from_bytes;
استورد compiler.runtime.host_service_adapter;


عرف اكتب_خطأ_داخلي(النص: نص): عدد {
    أرجع اكتب_خطأ_مضيف(النص);
}

عرف اكتب_خطأ_مرجع_داخلي(النص: &نص): عدد {
    أرجع اكتب_خطأ_مضيف(*النص);
}

استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;
استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.diagnostics.wording;

عام نوع نمط_طرفية_تشخيص = {
    أنسي: منطقي,
    اعرض_المصدر: منطقي
};

عرف اكتب_رقما_تشخيصيا(القيمة: غير_موقع): فراغ {
    لو (القيمة >= 10) {
        اكتب_رقما_تشخيصيا(القيمة / 10);
    };
    دع الرقم: غير_موقع = القيمة % 10;
    لو (الرقم == 0) {
        اكتب_خطأ_داخلي(«0»);
    };
    لو (الرقم == 1) {
        اكتب_خطأ_داخلي(«1»);
    };
    لو (الرقم == 2) {
        اكتب_خطأ_داخلي(«2»);
    };
    لو (الرقم == 3) {
        اكتب_خطأ_داخلي(«3»);
    };
    لو (الرقم == 4) {
        اكتب_خطأ_داخلي(«4»);
    };
    لو (الرقم == 5) {
        اكتب_خطأ_داخلي(«5»);
    };
    لو (الرقم == 6) {
        اكتب_خطأ_داخلي(«6»);
    };
    لو (الرقم == 7) {
        اكتب_خطأ_داخلي(«7»);
    };
    لو (الرقم == 8) {
        اكتب_خطأ_داخلي(«8»);
    };
    لو (الرقم == 9) {
        اكتب_خطأ_داخلي(«9»);
    };
}

عرف اكتب_رقما_موقعا_تشخيصيا(القيمة: عدد): فراغ {
    لو (القيمة < 0) {
        اكتب_خطأ_داخلي(«-»);
        // Add one before negation so the minimum signed value is printable without overflow.
        دع دون_أدنى: عدد = 0 - (القيمة + 1);
        دع المقدار_الأولي: غير_موقع = دون_أدنى مثل غير_موقع;
        دع المقدار: غير_موقع = المقدار_الأولي + 1;
        اكتب_رقما_تشخيصيا(المقدار);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(القيمة مثل غير_موقع);
}

عرف عدد_خانات_رقم(القيمة: غير_موقع): غير_موقع {
    دع الباقي: متغير غير_موقع = القيمة;
    دع الخانات: متغير غير_موقع = 1;
    بينما (الباقي >= 10) {
        الباقي := الباقي / 10;
        الخانات := الخانات + 1;
    }
    أرجع الخانات;
}

عرف عرض_رقم_سطر_مصدر(السطر: غ32): غير_موقع {
    لو (السطر < 1) {
        أرجع 1;
    };
    أرجع عدد_خانات_رقم(السطر مثل غير_موقع);
}

عرف اكتب_مسافات(العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        اكتب_خطأ_داخلي(« »);
        ف := ف + 1;
    }
}

عرف اكتب_علامات(العدد: غير_موقع): فراغ {
    دع النهاية: متغير غير_موقع = العدد;
    لو (النهاية == 0) {
        النهاية := 1;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < النهاية) {
        اكتب_خطأ_داخلي(«^»);
        ف := ف + 1;
    }
}

عرف مفتاح_شدة(الشدة: شدة_تشخيص): مفتاح_صياغة {
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        أرجع مفتاح_صياغة.تسمية_خطأ();
    }
    | شدة_تشخيص.تحذير -> {
        أرجع مفتاح_صياغة.تسمية_تحذير();
    }
    | شدة_تشخيص.ملاحظة -> {
        أرجع مفتاح_صياغة.تسمية_ملاحظة();
    };
}

عرف ابدأ_لون_شدة(الشدة: شدة_تشخيص, النمط: نمط_طرفية_تشخيص): فراغ {
    لو (!النمط.أنسي) {
        أرجع;
    };
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        اكتب_خطأ_داخلي("\x1b[1;31m");
    }
    | شدة_تشخيص.تحذير -> {
        اكتب_خطأ_داخلي("\x1b[1;33m");
    }
    | شدة_تشخيص.ملاحظة -> {
        اكتب_خطأ_داخلي("\x1b[1;36m");
    };
}

عرف أنه_لون(النمط: نمط_طرفية_تشخيص): فراغ {
    لو (النمط.أنسي) {
        اكتب_خطأ_داخلي("\x1b[0m");
    };
}

عرف اكتب_سطر_مصدر(السطر: غ32): فراغ {
    لو (السطر < 1) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(السطر مثل غير_موقع);
}

عرف اكتب_عمود_مصدر(العمود: غ32): فراغ {
    لو (العمود < 0) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    اكتب_رقما_تشخيصيا((العمود مثل غير_موقع) + 1);
}

عرف اكتب_هوية_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.اسم_المصدر مع
    | اختيار.بعض(الاسم) -> {
        اكتب_خطأ_مرجع_داخلي(&الاسم);
    }
    | اختيار.لا_شيء -> {
        اكتب_خطأ_داخلي(«<»);
        اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_مصدر()));
        اكتب_خطأ_داخلي(«#»);
        اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.المصدر);
        اكتب_خطأ_داخلي(«>»);
    };
}

عرف اكتب_إحداثي_مصدر(السطر: غ32, العمود: غ32): فراغ {
    اكتب_سطر_مصدر(السطر);
    اكتب_خطأ_داخلي(«:»);
    اكتب_عمود_مصدر(العمود);
}

عرف نطاق_مصدر_له_نهاية(النطاق: &نطاق): منطقي {
    دع الحالة: نطاق = *النطاق;
    أرجع (الحالة.البداية.المصدر == الحالة.النهاية.المصدر)
        && (الحالة.النهاية.البايت > الحالة.البداية.البايت);
}

عرف اكتب_موقع_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    اكتب_هوية_مصدر(اللغة, المصدر);
    اكتب_خطأ_داخلي(«:»);
    اكتب_إحداثي_مصدر(
        الحالة.النطاق.البداية.السطر,
        الحالة.النطاق.البداية.العمود
    );
    لو (نطاق_مصدر_له_نهاية(&الحالة.النطاق)) {
        اكتب_خطأ_داخلي(«..»);
        اكتب_إحداثي_مصدر(
            الحالة.النطاق.النهاية.السطر,
            الحالة.النطاق.النهاية.العمود
        );
    };
}

عرف اكتب_قيمة_حجة(
    اللغة: لغة_تشخيص,
    القيمة: &قيمة_حجة_تشخيص
): فراغ {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> {
        اكتب_خطأ_مرجع_داخلي(&النص);
    }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        طابق اللغة مع
        | لغة_تشخيص.الإنجليزية -> { اكتب_خطأ_مرجع_داخلي(&الإنجليزية); }
        | لغة_تشخيص.العربية -> { اكتب_خطأ_مرجع_داخلي(&العربية); };
    }
    | قيمة_حجة_تشخيص.غير_موقعة(العدد) -> {
        اكتب_رقما_تشخيصيا(العدد);
    }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> {
        اكتب_رقما_موقعا_تشخيصيا(العدد);
    }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        لو (القيمة_المنطقية) {
            اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.قيمة_منطقية_صواب()));
        } وإلا {
            اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.قيمة_منطقية_خطأ()));
        };
    };
}

عرف ابحث_حجة_تشخيص(
    التشخيص: &تشخيص,
    المفتاح: مفتاح_حجة_تشخيص
): اختيار قيمة_حجة_تشخيص {
    دع الحالة: تشخيص = *التشخيص;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الحجج) مثل غير_موقع)) {
        لو (الحالة.الحجج[ف].المفتاح == المفتاح) {
            دع مرجع_القيمة: &قيمة_حجة_تشخيص = &الحالة.الحجج[ف].القيمة;
            دع القيمة: قيمة_حجة_تشخيص = *مرجع_القيمة;
            أرجع اختيار.بعض(القيمة);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اكتب_حجة_مختارة(
    التشخيص: &تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    اللغة: لغة_تشخيص,
    اقتباس: منطقي
): منطقي {
    طابق ابحث_حجة_تشخيص(التشخيص, المفتاح) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> {
        لو (اقتباس) { اكتب_خطأ_داخلي(«`»); };
        اكتب_قيمة_حجة(اللغة, &القيمة);
        لو (اقتباس) { اكتب_خطأ_داخلي(«`»); };
        أرجع صواب;
    };
}

// Human prose consumes only arguments that are meaningful to a source user.
// Internal phase/reason/index metadata remains available to JSON but is never
// dumped automatically into terminal diagnostics.
عرف اكتب_تفصيل_رسالة_بشرية(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    طابق الحالة.المعرف مع
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        اكتب_خطأ_داخلي(«: »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), اللغة, صواب);
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        اكتب_خطأ_داخلي(« »);
        دع كتب: منطقي = اكتب_حجة_مختارة(التشخيص, مفتاح_حجة_تشخيص.الهدف(), اللغة, صواب);
    }
    | معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الاستبدال()) مع
        | اختيار.بعض(الاستبدال) -> {
            اكتب_خطأ_داخلي(«: »);
            اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_هل_تقصد()));
            اكتب_خطأ_داخلي(« `»);
            اكتب_قيمة_حجة(اللغة, &الاستبدال);
            اكتب_خطأ_داخلي(«`?»);
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.خطأ_نحوي -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.المتوقع()) مع
        | اختيار.بعض(المتوقع) -> {
            اكتب_خطأ_داخلي(«: »);
            اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_متوقع()));
            اكتب_خطأ_داخلي(« `»); اكتب_قيمة_حجة(اللغة, &المتوقع); اكتب_خطأ_داخلي(«`»);
            طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الموجود()) مع
            | اختيار.بعض(الموجود) -> {
                اكتب_خطأ_داخلي(«, »);
                اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_موجود()));
                اكتب_خطأ_داخلي(« `»); اكتب_قيمة_حجة(اللغة, &الموجود); اكتب_خطأ_داخلي(«`»);
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    }
    | معرف_تشخيص.عدد_حجج_غير_مطابق -> {
        طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.المتوقع()) مع
        | اختيار.بعض(المتوقع) -> {
            اكتب_خطأ_داخلي(«: »);
            اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_متوقع()));
            اكتب_خطأ_داخلي(« »); اكتب_قيمة_حجة(اللغة, &المتوقع);
            طابق ابحث_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.الموجود()) مع
            | اختيار.بعض(الموجود) -> {
                اكتب_خطأ_داخلي(«, »);
                اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_موجود()));
                اكتب_خطأ_داخلي(« »); اكتب_قيمة_حجة(اللغة, &الموجود);
            }
            | اختيار.لا_شيء -> { };
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };
}

عرف تسمية_دور_نطاق_بشرية(
    اللغة: لغة_تشخيص,
    الدور: دور_نطاق_تشخيص
): اختيار نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع اختيار.لا_شيء(); }
    | _ -> { أرجع اختيار.بعض(صياغة_دور_نطاق(اللغة, الدور)); };
}

عرف اكتب_مقتطف_مصدر_بتسمية(
    المصدر: &نطاق_مصدر_تشخيص,
    التسمية: اختيار نص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.المقتطف مع
    | اختيار.بعض(السطر) -> {
        دع عرض_السطر: غير_موقع = عرض_رقم_سطر_مصدر(الحالة.النطاق.البداية.السطر);
        اكتب_مسافات(عرض_السطر + 2);
        اكتب_خطأ_داخلي("|\n");
        اكتب_خطأ_داخلي(« »);
        اكتب_سطر_مصدر(الحالة.النطاق.البداية.السطر);
        اكتب_خطأ_داخلي(« | »);
        اكتب_خطأ_مرجع_داخلي(&السطر);
        اكتب_خطأ_داخلي("\n");
        اكتب_مسافات(عرض_السطر + 2);
        اكتب_خطأ_داخلي(«| »);
        لو (الحالة.النطاق.البداية.العمود > 0) {
            اكتب_مسافات(الحالة.النطاق.البداية.العمود مثل غير_موقع);
        };
        دع العرض: متغير غير_موقع = 1;
        لو (
            نطاق_مصدر_له_نهاية(&الحالة.النطاق)
            && (الحالة.النطاق.البداية.السطر == الحالة.النطاق.النهاية.السطر)
            && (الحالة.النطاق.النهاية.العمود > الحالة.النطاق.البداية.العمود)
        ) {
            العرض := (
                الحالة.النطاق.النهاية.العمود - الحالة.النطاق.البداية.العمود
            ) مثل غير_موقع;
        };
        اكتب_علامات(العرض);
        طابق التسمية مع
        | اختيار.بعض(النص) -> {
            اكتب_خطأ_داخلي(« »);
            اكتب_خطأ_مرجع_داخلي(&النص);
        }
        | اختيار.لا_شيء -> { };
        اكتب_خطأ_داخلي("\n");
        اكتب_مسافات(عرض_السطر + 2);
        اكتب_خطأ_داخلي("|\n");
    }
    | اختيار.لا_شيء -> { };
}

عرف اكتب_مقتطف_مصدر(المصدر: &نطاق_مصدر_تشخيص): فراغ {
    اكتب_مقتطف_مصدر_بتسمية(المصدر, اختيار.لا_شيء());
}

عرف اكتب_تعليقا(
    اللغة: لغة_تشخيص,
    التسمية: مفتاح_صياغة,
    التعليق: &تعليق_تشخيص
): فراغ {
    دع القيمة: تعليق_تشخيص = *التعليق;
    اكتب_خطأ_داخلي(«  = »);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, التسمية));
    اكتب_خطأ_داخلي(«: »);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, القيمة.المفتاح));
    اكتب_خطأ_داخلي("\n");
}

عرف مفتاح_رسالة_بشرية(التعريف: &تعريف_تشخيص): مفتاح_صياغة {
    دع الحالة: تعريف_تشخيص = *التعريف;
    لو (الحالة.الفئة == فئة_تشخيص.داخلي()) {
        أرجع مفتاح_صياغة.رسالة_فشل_مترجم_داخلي();
    };
    أرجع الحالة.الصياغة;
}

عام عرف اعرض_تشخيصا_طرفيا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع مفتاح_الرسالة: مفتاح_صياغة = مفتاح_رسالة_بشرية(&التعريف);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_الرسالة));
    لو (التعريف.الفئة != فئة_تشخيص.داخلي()) {
        اكتب_تفصيل_رسالة_بشرية(التشخيص, اللغة);
    };
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");

    لو (النمط.اعرض_المصدر) {
        طابق الحالة.المصدر_الرئيسي مع
        | اختيار.بعض(المصدر) -> {
            اكتب_خطأ_داخلي(«  --> »);
            اكتب_موقع_مصدر(اللغة, &المصدر);
            اكتب_خطأ_داخلي("\n");
            دع تسمية_الرئيسي: اختيار نص = تسمية_دور_نطاق_بشرية(
                اللغة, الحالة.الدور_الرئيسي
            );
            اكتب_مقتطف_مصدر_بتسمية(&المصدر, تسمية_الرئيسي);
        }
        | اختيار.لا_شيء -> { };
    };

    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول(الحالة.النطاقات_المرتبطة) مثل غير_موقع)) {
        دع تسمية_المرتبط: اختيار نص = تسمية_دور_نطاق_بشرية(
            اللغة, الحالة.النطاقات_المرتبطة[ر].الدور
        );
        لو (النمط.اعرض_المصدر) {
            اكتب_خطأ_داخلي(«  ::: »);
            اكتب_موقع_مصدر(اللغة, &الحالة.النطاقات_المرتبطة[ر].المصدر);
            اكتب_خطأ_داخلي("\n");
            اكتب_مقتطف_مصدر_بتسمية(
                &الحالة.النطاقات_المرتبطة[ر].المصدر, تسمية_المرتبط
            );
        } وإلا {
            طابق تسمية_المرتبط مع
            | اختيار.بعض(النص) -> {
                اكتب_خطأ_داخلي(«  = »);
                اكتب_خطأ_مرجع_داخلي(&النص);
                اكتب_خطأ_داخلي("\n");
            }
            | اختيار.لا_شيء -> { };
        };
        ر := ر + 1;
    }

    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(الحالة.الملاحظات) مثل غير_موقع)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_ملاحظة(),
            &الحالة.الملاحظات[م]
        );
        م := م + 1;
    }

    دع هـ: متغير غير_موقع = 0;
    بينما (هـ < (الطول(الحالة.المساعدة) مثل غير_موقع)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_مساعدة(),
            &الحالة.المساعدة[هـ]
        );
        هـ := هـ + 1;
    }

    // Fix edits are machine data for JSON/LSP. Human terminal output uses the
    // corresponding help text instead of exposing applicability metadata.

    // Detailed trace is intentionally reserved for structured machine output.
}

عام عرف اعرض_مجموعة_تشخيصات_طرفيا(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.التشخيصات) مثل غير_موقع)) {
        لو (ف > 0) {
            اكتب_خطأ_داخلي("\n");
        };
        اعرض_تشخيصا_طرفيا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

عام عرف اعرض_تشخيصا_مختصرا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    طابق الحالة.المصدر_الرئيسي مع
    | اختيار.بعض(المصدر) -> {
        اكتب_موقع_مصدر(اللغة, &المصدر);
        اكتب_خطأ_داخلي(«: »);
    }
    | اختيار.لا_شيء -> { };
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع مفتاح_الرسالة: مفتاح_صياغة = مفتاح_رسالة_بشرية(&التعريف);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_الرسالة));
    لو (التعريف.الفئة != فئة_تشخيص.داخلي()) {
        اكتب_تفصيل_رسالة_بشرية(التشخيص, اللغة);
    };
    اكتب_خطأ_داخلي(« [»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.النوع_الآلي);
    اكتب_خطأ_داخلي(«]»);
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");
}

عام عرف اعرض_مجموعة_تشخيصات_مختصرة(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.التشخيصات) مثل غير_موقع)) {
        اعرض_تشخيصا_مختصرا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

عرف رقم_سداسي_إلى_بايت(القيمة: غ8): غ8 {
    لو (القيمة < 10) { أرجع 0x30 + القيمة; };
    أرجع 0x61 + (القيمة - 10);
}

عرف اكتب_نص_جيسون(القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع الناتج: متغير متجه غ8 = [];
    ألحق(الناتج, 0x22);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        دع ب: غ8 = النص[ف];
        لو (ب == 0x22) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x22);
        } وإلا لو (ب == 0x5C) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x5C);
        } وإلا لو (ب == 0x0A) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x6E);
        } وإلا لو (ب == 0x0D) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x72);
        } وإلا لو (ب == 0x09) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x74);
        } وإلا لو (ب < 0x20) {
            ألحق(الناتج, 0x5C); ألحق(الناتج, 0x75);
            ألحق(الناتج, 0x30); ألحق(الناتج, 0x30);
            ألحق(الناتج, رقم_سداسي_إلى_بايت((ب >> 4) & 0x0F));
            ألحق(الناتج, رقم_سداسي_إلى_بايت(ب & 0x0F));
        } وإلا {
            ألحق(الناتج, ب);
        };
        ف := ف + 1;
    }
    ألحق(الناتج, 0x22);
    اكتب_خطأ_داخلي(من_بايتات(&الناتج));
}

عرف مفتاح_حجة_آلي(المفتاح: مفتاح_حجة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_حجة_تشخيص.القيمة -> { أرجع «value»; }
    | مفتاح_حجة_تشخيص.المتوقع -> { أرجع «expected»; }
    | مفتاح_حجة_تشخيص.الاستبدال -> { أرجع «replacement»; }
    | مفتاح_حجة_تشخيص.الموجود -> { أرجع «found»; }
    | مفتاح_حجة_تشخيص.الفهرس -> { أرجع «index»; }
    | مفتاح_حجة_تشخيص.الطول -> { أرجع «length»; }
    | مفتاح_حجة_تشخيص.المجال -> { أرجع «range»; }
    | مفتاح_حجة_تشخيص.النمط -> { أرجع «pattern»; }
    | مفتاح_حجة_تشخيص.المسار -> { أرجع «path»; }
    | مفتاح_حجة_تشخيص.الرمز -> { أرجع «symbol»; }
    | مفتاح_حجة_تشخيص.النوع -> { أرجع «type»; }
    | مفتاح_حجة_تشخيص.السياق -> { أرجع «context»; }
    | مفتاح_حجة_تشخيص.المرحلة -> { أرجع «phase»; }
    | مفتاح_حجة_تشخيص.الهدف -> { أرجع «target»; }
    | مفتاح_حجة_تشخيص.الدالة -> { أرجع «function»; }
    | مفتاح_حجة_تشخيص.الكتلة -> { أرجع «block»; }
    | مفتاح_حجة_تشخيص.التعليمة -> { أرجع «instruction»; }
    | مفتاح_حجة_تشخيص.العملية -> { أرجع «operation»; }
    | مفتاح_حجة_تشخيص.البدائي -> { أرجع «primitive»; }
    | مفتاح_حجة_تشخيص.المصدر -> { أرجع «source»; }
    | مفتاح_حجة_تشخيص.الوجهة -> { أرجع «destination»; }
    | مفتاح_حجة_تشخيص.السبب -> { أرجع «reason»; };
}

عرف دور_نطاق_آلي(الدور: دور_نطاق_تشخيص): نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع «primary»; }
    | دور_نطاق_تشخيص.استخدام_غير_صالح -> { أرجع «invalid-use»; }
    | دور_نطاق_تشخيص.أصل_النقل -> { أرجع «move-origin»; }
    | دور_نطاق_تشخيص.أصل_التحرير -> { أرجع «release-origin»; }
    | دور_نطاق_تشخيص.المالك_الأصلي -> { أرجع «original-owner»; }
    | دور_نطاق_تشخيص.استعارة_متعارضة -> { أرجع «conflicting-borrow»; }
    | دور_نطاق_تشخيص.موضع_متوقع -> { أرجع «expected-location»; }
    | دور_نطاق_تشخيص.اكتشاف_المحلل -> { أرجع «parser-found»; }
    | دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> { أرجع «misplaced-semicolon»; }
    | دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة -> { أرجع «semicolon-destination»; }
    | دور_نطاق_تشخيص.عبارة_بلا_عملية -> { أرجع «statement-without-operation»; }
    | دور_نطاق_تشخيص.نمط_غير_قابل_للوصول -> { أرجع «unreachable-pattern»; }
    | دور_نطاق_تشخيص.تغطية_نمط_سابقة -> { أرجع «previous-pattern-coverage»; }
    | دور_نطاق_تشخيص.سياق_مرتبط -> { أرجع «related-context»; };
}

عرف قابلية_إصلاح_آلية(القابلية: قابلية_تطبيق_إصلاح): نص {
    طابق القابلية مع
    | قابلية_تطبيق_إصلاح.آلي -> { أرجع «machine-applicable»; }
    | قابلية_تطبيق_إصلاح.يحتوي_عناصر_نائبة -> { أرجع «has-placeholders»; }
    | قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح -> { أرجع «maybe-incorrect»; }
    | قابلية_تطبيق_إصلاح.غير_محدد -> { أرجع «unspecified»; };
}

عرف فئة_تشخيص_آلية(الفئة: فئة_تشخيص): نص {
    طابق الفئة مع
    | فئة_تشخيص.مستخدم -> { أرجع «user»; }
    | فئة_تشخيص.بيئة -> { أرجع «environment»; }
    | فئة_تشخيص.داخلي -> { أرجع «internal»; };
}

عرف اكتب_قيمة_حجة_جيسون(القيمة: &قيمة_حجة_تشخيص): فراغ {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { اكتب_نص_جيسون(&النص); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        اكتب_خطأ_داخلي("{\"en\":"); اكتب_نص_جيسون(&الإنجليزية);
        اكتب_خطأ_داخلي(",\"ar\":"); اكتب_نص_جيسون(&العربية); اكتب_خطأ_داخلي(«}»);
    }
    | قيمة_حجة_تشخيص.غير_موقعة(العدد) -> { اكتب_رقما_تشخيصيا(العدد); }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> { اكتب_رقما_موقعا_تشخيصيا(العدد); }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        لو (القيمة_المنطقية) { اكتب_خطأ_داخلي(«true»); } وإلا { اكتب_خطأ_داخلي(«false»); };
    };
}

عرف اكتب_نطاق_جيسون(المصدر: &نطاق_مصدر_تشخيص): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    اكتب_خطأ_داخلي("{\"file\":");
    طابق الحالة.اسم_المصدر مع
    | اختيار.بعض(الاسم) -> { اكتب_نص_جيسون(&الاسم); }
    | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(",\"source_id\":"); اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.المصدر);
    اكتب_خطأ_داخلي(",\"line\":"); اكتب_سطر_مصدر(الحالة.النطاق.البداية.السطر);
    اكتب_خطأ_داخلي(",\"column\":"); اكتب_عمود_مصدر(الحالة.النطاق.البداية.العمود);
    اكتب_خطأ_داخلي(",\"end_line\":"); اكتب_سطر_مصدر(الحالة.النطاق.النهاية.السطر);
    اكتب_خطأ_داخلي(",\"end_column\":"); اكتب_عمود_مصدر(الحالة.النطاق.النهاية.العمود);
    اكتب_خطأ_داخلي(",\"snippet\":");
    طابق الحالة.المقتطف مع
    | اختيار.بعض(المقتطف) -> { اكتب_نص_جيسون(&المقتطف); }
    | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(«}»);
}

عام عرف اعرض_تشخيصا_جيسون(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    دع الشدة: نص;
    طابق التعريف.الشدة مع
    | شدة_تشخيص.خطأ -> { الشدة := «error»; }
    | شدة_تشخيص.تحذير -> { الشدة := «warning»; }
    | شدة_تشخيص.ملاحظة -> { الشدة := «note»; };
    دع الرسالة: نص = صياغة_تشخيص(اللغة, التعريف.الصياغة);

    اكتب_خطأ_داخلي("{\"schema\":2,\"id\":"); اكتب_نص_جيسون(&التعريف.الكود);
    اكتب_خطأ_داخلي(",\"kind\":"); اكتب_نص_جيسون(&التعريف.النوع_الآلي);
    اكتب_خطأ_داخلي(",\"severity\":"); اكتب_نص_جيسون(&الشدة);
    دع الفئة: نص = فئة_تشخيص_آلية(التعريف.الفئة);
    اكتب_خطأ_داخلي(",\"category\":"); اكتب_نص_جيسون(&الفئة);
    اكتب_خطأ_داخلي(",\"message\":"); اكتب_نص_جيسون(&الرسالة);
    اكتب_خطأ_داخلي(",\"primary_span\":");
    طابق الحالة.المصدر_الرئيسي مع
    | اختيار.بعض(المصدر) -> { اكتب_نطاق_جيسون(&المصدر); }
    | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    دع الدور_الرئيسي_الآلي: نص = دور_نطاق_آلي(الحالة.الدور_الرئيسي);
    اكتب_خطأ_داخلي(",\"primary_role\":"); اكتب_نص_جيسون(&الدور_الرئيسي_الآلي);
    اكتب_خطأ_داخلي(",\"primary_label\":");
    دع تسمية_الرئيسي_جيسون: اختيار نص = تسمية_دور_نطاق_بشرية(
        اللغة, الحالة.الدور_الرئيسي
    );
    طابق تسمية_الرئيسي_جيسون مع
    | اختيار.بعض(النص) -> { اكتب_نص_جيسون(&النص); }
    | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };

    اكتب_خطأ_داخلي(",\"arguments\":[");
    دع أ: متغير غير_موقع = 0;
    بينما (أ < (الطول(الحالة.الحجج) مثل غير_موقع)) {
        لو (أ > 0) { اكتب_خطأ_داخلي(«,»); };
        دع المفتاح: نص = مفتاح_حجة_آلي(الحالة.الحجج[أ].المفتاح);
        اكتب_خطأ_داخلي("{\"key\":"); اكتب_نص_جيسون(&المفتاح); اكتب_خطأ_داخلي(",\"value\":");
        اكتب_قيمة_حجة_جيسون(&الحالة.الحجج[أ].القيمة); اكتب_خطأ_داخلي(«}»);
        أ := أ + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"related_spans\":[");
    دع ر: متغير غير_موقع = 0;
    بينما (ر < (الطول(الحالة.النطاقات_المرتبطة) مثل غير_موقع)) {
        لو (ر > 0) { اكتب_خطأ_داخلي(«,»); };
        دع الدور: نص = دور_نطاق_آلي(الحالة.النطاقات_المرتبطة[ر].الدور);
        دع تسمية_المرتبط_جيسون: اختيار نص = تسمية_دور_نطاق_بشرية(
            اللغة, الحالة.النطاقات_المرتبطة[ر].الدور
        );
        اكتب_خطأ_داخلي("{\"role\":"); اكتب_نص_جيسون(&الدور);
        اكتب_خطأ_داخلي(",\"label\":");
        طابق تسمية_المرتبط_جيسون مع
        | اختيار.بعض(النص) -> { اكتب_نص_جيسون(&النص); }
        | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        اكتب_خطأ_داخلي(",\"span\":");
        اكتب_نطاق_جيسون(&الحالة.النطاقات_المرتبطة[ر].المصدر); اكتب_خطأ_داخلي(«}»);
        ر := ر + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"notes\":[");
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(الحالة.الملاحظات) مثل غير_موقع)) {
        لو (م > 0) { اكتب_خطأ_داخلي(«,»); };
        دع النص: نص = صياغة_تشخيص(اللغة, الحالة.الملاحظات[م].المفتاح);
        اكتب_نص_جيسون(&النص);
        م := م + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"help\":[");
    دع هـ: متغير غير_موقع = 0;
    بينما (هـ < (الطول(الحالة.المساعدة) مثل غير_موقع)) {
        لو (هـ > 0) { اكتب_خطأ_داخلي(«,»); };
        دع النص: نص = صياغة_تشخيص(اللغة, الحالة.المساعدة[هـ].المفتاح);
        اكتب_نص_جيسون(&النص);
        هـ := هـ + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"fixes\":[");
    دع ص: متغير غير_موقع = 0;
    بينما (ص < (الطول(الحالة.الإصلاحات) مثل غير_موقع)) {
        لو (ص > 0) { اكتب_خطأ_داخلي(«,»); };
        دع القابلية: نص = قابلية_إصلاح_آلية(الحالة.الإصلاحات[ص].القابلية);
        دع رسالة_الإصلاح: نص = صياغة_تشخيص(اللغة, الحالة.الإصلاحات[ص].المفتاح);
        اكتب_خطأ_داخلي("{\"span\":"); اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].المصدر);
        اكتب_خطأ_داخلي(",\"replacement\":"); اكتب_نص_جيسون(&الحالة.الإصلاحات[ص].الاستبدال);
        اكتب_خطأ_داخلي(",\"message\":"); اكتب_نص_جيسون(&رسالة_الإصلاح);
        اكتب_خطأ_داخلي(",\"applicability\":"); اكتب_نص_جيسون(&القابلية);
        اكتب_خطأ_داخلي(",\"edits\":[{\"span\":");
        اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].المصدر);
        اكتب_خطأ_داخلي(",\"replacement\":");
        اكتب_نص_جيسون(&الحالة.الإصلاحات[ص].الاستبدال);
        اكتب_خطأ_داخلي(«}»);
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الحالة.الإصلاحات[ص].التعديلات_الإضافية) مثل غير_موقع)) {
            اكتب_خطأ_داخلي(",{\"span\":");
            اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].التعديلات_الإضافية[ت].المصدر);
            اكتب_خطأ_داخلي(",\"replacement\":");
            اكتب_نص_جيسون(&الحالة.الإصلاحات[ص].التعديلات_الإضافية[ت].الاستبدال);
            اكتب_خطأ_داخلي(«}»);
            ت := ت + 1;
        }
        اكتب_خطأ_داخلي(«]}»);
        ص := ص + 1;
    }
    اكتب_خطأ_داخلي("],\"trace\":[");
    دع ث: متغير غير_موقع = 0;
    بينما (ث < (الطول(الحالة.الأثر) مثل غير_موقع)) {
        لو (ث > 0) { اكتب_خطأ_داخلي(«,»); };
        دع مرجع_مدخل: &مدخل_أثر_تشخيص = &الحالة.الأثر[ث];
        دع مدخل: مدخل_أثر_تشخيص = *مرجع_مدخل;
        دع رسالة_الأثر: نص = صياغة_تشخيص(اللغة, مدخل.المفتاح);
        اكتب_خطأ_داخلي("{\"message\":"); اكتب_نص_جيسون(&رسالة_الأثر);
        اكتب_خطأ_داخلي(",\"span\":");
        طابق مدخل.المصدر مع
        | اختيار.بعض(المصدر) -> { اكتب_نطاق_جيسون(&المصدر); }
        | اختيار.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        اكتب_خطأ_داخلي(",\"arguments\":[");
        دع ح: متغير غير_موقع = 0;
        بينما (ح < (الطول(مدخل.الحجج) مثل غير_موقع)) {
            لو (ح > 0) { اكتب_خطأ_داخلي(«,»); };
            دع مفتاح_الأثر: نص = مفتاح_حجة_آلي(مدخل.الحجج[ح].المفتاح);
            اكتب_خطأ_داخلي("{\"key\":"); اكتب_نص_جيسون(&مفتاح_الأثر);
            اكتب_خطأ_داخلي(",\"value\":"); اكتب_قيمة_حجة_جيسون(&مدخل.الحجج[ح].القيمة);
            اكتب_خطأ_داخلي(«}»);
            ح := ح + 1;
        }
        اكتب_خطأ_داخلي(«]}»);
        ث := ث + 1;
    }
    اكتب_خطأ_داخلي("],\"trace_count\":"); اكتب_رقما_تشخيصيا(الطول(الحالة.الأثر) مثل غير_موقع);
    اكتب_خطأ_داخلي("}\n");
}

عام عرف اعرض_مجموعة_تشخيصات_جيسون(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.التشخيصات) مثل غير_موقع)) {
        اعرض_تشخيصا_جيسون(&الحالة.التشخيصات[ف], اللغة);
        ف := ف + 1;
    }
}
