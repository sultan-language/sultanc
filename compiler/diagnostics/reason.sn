// Grouping policy: the public identity a reason belongs to when its meaning
// matches that identity exactly. لا_شيء keeps the identity the producer chose.
// Applied once, when a diagnostic is emitted (engine.sn).
عام عرف تشخيص_عام_لسبب(السبب: سبب_تشخيص): اختياري معرف_تشخيص {
    طابق السبب مع
    | سبب_تشخيص.سبب_واجهة_الاستدعاء_هدف_قدرة_غير_متاح -> { أرجع اختياري.موجود(معرف_تشخيص.واجهة_استدعاء_غير_متاحة_للهدف()); }
    | سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_مدعوم_نوع -> { أرجع اختياري.موجود(معرف_تشخيص.بناء_غير_مدعوم_في_الخلفية()); }
    | سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_مدعوم_نوع_حجم -> { أرجع اختياري.موجود(معرف_تشخيص.بناء_غير_مدعوم_في_الخلفية()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_عدد_حجج_غير_مطابق -> { أرجع اختياري.موجود(معرف_تشخيص.عدد_حجج_وقت_الترجمة_غير_مطابق()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_مغلقة -> { أرجع اختياري.موجود(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_ثابتة -> { أرجع اختياري.موجود(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_عمق_الاستدعاء -> { أرجع اختياري.موجود(معرف_تشخيص.حد_وقت_الترجمة_متجاوز()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_نفاد_عمق_الاستدعاء -> { أرجع اختياري.موجود(معرف_تشخيص.حد_وقت_الترجمة_متجاوز()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_فشل_مطلوب -> { أرجع اختياري.موجود(معرف_تشخيص.فشل_وقت_الترجمة_مطلوب()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_فشل_التنفيذ -> { أرجع اختياري.موجود(معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_فخ_التنفيذ -> { أرجع اختياري.موجود(معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_نفاد_ميزانية_التعليمات -> { أرجع اختياري.موجود(معرف_تشخيص.حد_وقت_الترجمة_متجاوز()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_مثبت -> { أرجع اختياري.موجود(معرف_تشخيص.تخطيط_غير_متاح_وقت_الترجمة()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_متاح -> { أرجع اختياري.موجود(معرف_تشخيص.تخطيط_غير_متاح_وقت_الترجمة()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_ناتج_مفقود -> { أرجع اختياري.موجود(معرف_تشخيص.ناتج_وقت_الترجمة_غير_ثابت()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة -> { أرجع اختياري.موجود(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت()); }
    | سبب_تشخيص.سبب_وقت_الترجمة_قيمة_غير_ثابتة_أو_أثر_ممنوع -> { أرجع اختياري.موجود(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت()); }
