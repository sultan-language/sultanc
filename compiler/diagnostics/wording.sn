استورد compiler.diagnostics.diagnostic_model;

عرف صياغة_إنجليزية(المفتاح: مفتاح_صياغة): نص {
    طابق المفتاح مع
    | مفتاح_صياغة.رسالة_خطأ_نحوي -> {
        أرجع «syntax error»;
    }
    | مفتاح_صياغة.رسالة_فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع «semicolon is in the wrong place»;
    }
    | مفتاح_صياغة.رسالة_تهجئة_كلمة_محجوزة_غير_معروفة -> {
        أرجع «unknown keyword»;
    }
    | مفتاح_صياغة.رسالة_عبارة_بلا_عملية -> {
        أرجع «expected a function call or assignment»;
    }
    | مفتاح_صياغة.رسالة_نوع_ناتج_دالة_مفقود -> {
        أرجع «missing function return type»;
    }
    | مفتاح_صياغة.رسالة_خطأ_معجمي -> {
        أرجع «lexical error»;
    }
    | مفتاح_صياغة.رسالة_رفض_تحليل -> {
        أرجع «source could not be parsed»;
    }
    | مفتاح_صياغة.رسالة_لا_ناتج_تحليل -> {
        أرجع «parser produced no result»;
    }
    | مفتاح_صياغة.رسالة_استدعاء_مترجم_غير_صالح -> {
        أرجع «invalid compiler invocation»;
    }
    | مفتاح_صياغة.رسالة_هدف_مترجم_غير_معروف -> {
        أرجع «unknown target»;
    }
    | مفتاح_صياغة.رسالة_مصدر_مترجم_مفقود -> {
        أرجع «no source file was specified»;
    }
    | مفتاح_صياغة.رسالة_خيار_مترجم_غير_معروف -> {
        أرجع «unknown option»;
    }
    | مفتاح_صياغة.رسالة_قيمة_خيار_مترجم_مفقودة -> {
        أرجع «option requires a value»;
    }
    | مفتاح_صياغة.رسالة_لغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع «invalid diagnostic language»;
    }
    | مفتاح_صياغة.رسالة_صيغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع «invalid diagnostic format»;
    }
    | مفتاح_صياغة.رسالة_لون_تشخيص_مترجم_غير_صالح -> {
        أرجع «invalid diagnostic color policy»;
    }
    | مفتاح_صياغة.رسالة_مصدر_رئيسي_متعدد -> {
        أرجع «multiple primary source files are not supported»;
    }
    | مفتاح_صياغة.رسالة_أوضاع_مترجم_متعارضة -> {
        أرجع «compiler modes conflict»;
    }
    | مفتاح_صياغة.رسالة_معامل_موضعي_غير_متوقع -> {
        أرجع «unexpected positional argument»;
    }
    | مفتاح_صياغة.رسالة_هدف_مضيف_مترجم_غير_متاح -> {
        أرجع «no native host target is available»;
    }
    | مفتاح_صياغة.رسالة_فشل_كتابة_مخرج_مترجم -> {
        أرجع «could not write compiler output»;
    }
    | مفتاح_صياغة.رسالة_فشل_مترجم_داخلي -> {
        أرجع «SultanC encountered an internal compiler failure»;
    }
    | مفتاح_صياغة.رسالة_ملف_إدخال_مفقود -> {
        أرجع «input file was not found»;
    }
    | مفتاح_صياغة.رسالة_نوع_ملف_إدخال_غير_معروف -> {
        أرجع «unrecognized input file type»;
    }
    | مفتاح_صياغة.رسالة_وحدة_مصدر_غير_موجودة -> {
        أرجع «source module was not found»;
    }
    | مفتاح_صياغة.رسالة_تصريح_مكرر -> {
        أرجع «duplicate declaration»;
    }
    | مفتاح_صياغة.رسالة_اسم_غير_معروف -> {
        أرجع «unknown name»;
    }
    | مفتاح_صياغة.رسالة_اسم_غير_محلول -> {
        أرجع «unresolved name»;
    }
    | مفتاح_صياغة.رسالة_استيراد_غامض -> {
        أرجع «ambiguous import»;
    }
    | مفتاح_صياغة.رسالة_دورة_استيراد -> {
        أرجع «import cycle»;
    }
    | مفتاح_صياغة.رسالة_نوعين_غير_متوافقين -> {
        أرجع «mismatched types»;
    }
    | مفتاح_صياغة.رسالة_نوع_غير_محلول -> {
        أرجع «unresolved type»;
    }
    | مفتاح_صياغة.رسالة_حقل_سجل_غير_معروف -> {
        أرجع «unknown record field»;
    }
    | مفتاح_صياغة.رسالة_منشئ_نوع_غير_صالح -> {
        أرجع «invalid tagged constructor»;
    }
    | مفتاح_صياغة.رسالة_عدد_حمولات_نمط_غير_مطابق -> {
        أرجع «pattern constructor payload count does not match»;
    }
    | مفتاح_صياغة.رسالة_نمط_غير_صالح -> {
        أرجع «invalid pattern»;
    }
    | مفتاح_صياغة.رسالة_خفض_تعبير_غير_مدعوم -> {
        أرجع «expression is not supported by semantic lowering»;
    }
    | مفتاح_صياغة.رسالة_خفض_عبارة_غير_مدعومة -> {
        أرجع «statement is not supported by semantic lowering»;
    }
    | مفتاح_صياغة.رسالة_دالة_خفض_مفقودة -> {
        أرجع «canonical function semantic fact is missing»;
    }
    | مفتاح_صياغة.رسالة_ربط_اسم_خفض_مفقود -> {
        أرجع «canonical name binding is missing»;
    }
    | مفتاح_صياغة.رسالة_نوع_خفض_مفقود -> {
        أرجع «canonical type fact is missing»;
    }
    | مفتاح_صياغة.رسالة_هوية_منشئ_خفض_مفقودة -> {
        أرجع «canonical constructor identity is missing»;
    }
    | مفتاح_صياغة.رسالة_عدد_حجج_غير_مطابق -> {
        أرجع «call argument count does not match»;
    }
    | مفتاح_صياغة.رسالة_نوع_حجة_غير_مطابق -> {
        أرجع «call argument type does not match»;
    }
    | مفتاح_صياغة.رسالة_نوع_إرجاع_غير_مطابق -> {
        أرجع «return type does not match»;
    }
    | مفتاح_صياغة.رسالة_استخدام_قبل_التهيئة -> {
        أرجع «use before initialization»;
    }
    | مفتاح_صياغة.رسالة_استخدام_بعد_النقل -> {
        أرجع «use after move»;
    }
    | مفتاح_صياغة.رسالة_مورد_محرر -> {
        أرجع «resource was already released»;
    }
    | مفتاح_صياغة.رسالة_تعارض_استعارة -> {
        أرجع «borrow conflict»;
    }
    | مفتاح_صياغة.رسالة_هروب_مرجع -> {
        أرجع «reference escapes its valid scope»;
    }
    | مفتاح_صياغة.رسالة_عملية_غير_آمنة -> {
        أرجع «operation requires an explicit unsafe scope»;
    }
    | مفتاح_صياغة.رسالة_فهرس_خارج_الحدود -> {
        أرجع «index is outside the valid bounds»;
    }
    | مفتاح_صياغة.رسالة_نمط_غير_شامل -> {
        أرجع «non-exhaustive pattern»;
    }
    | مفتاح_صياغة.رسالة_نمط_غير_قابل_للوصول -> {
        أرجع «unreachable pattern»;
    }
    | مفتاح_صياغة.رسالة_إرجاع_مفقود -> {
        أرجع «not all execution paths return a value»;
    }
    | مفتاح_صياغة.رسالة_نقل_جزئي_مملوك -> {
        أرجع «partial move of an owned aggregate member is not allowed»;
    }
    | مفتاح_صياغة.رسالة_خطأ_ذاكرة_نوع -> {
        أرجع «invalid memory classification for type»;
    }
    | مفتاح_صياغة.رسالة_مسير_غير_صالح -> {
        أرجع «invalid MSIR»;
    }
    | مفتاح_صياغة.رسالة_خطأ_سياق_داخلي -> {
        أرجع «internal compiler error»;
    }
    | مفتاح_صياغة.رسالة_حقيقة_دلالية_مفقودة -> {
        أرجع «required canonical semantic fact is missing»;
    }
    | مفتاح_صياغة.رسالة_فشل_تفسير_وقت_تشغيل -> {
        أرجع «program failed during interpretation»;
    }
    | مفتاح_صياغة.رسالة_فخ_تفسير -> {
        أرجع «program trapped during interpretation»;
    }
    | مفتاح_صياغة.رسالة_تحذير_عام -> {
        أرجع «compiler warning»;
    }
    | مفتاح_صياغة.تسمية_خطأ -> {
        أرجع «error»;
    }
    | مفتاح_صياغة.تسمية_تحذير -> {
        أرجع «warning»;
    }
    | مفتاح_صياغة.تسمية_ملاحظة -> {
        أرجع «note»;
    }
    | مفتاح_صياغة.تسمية_مساعدة -> {
        أرجع «help»;
    }
    | مفتاح_صياغة.تسمية_إصلاح -> {
        أرجع «fix»;
    }
    | مفتاح_صياغة.تسمية_أثر -> {
        أرجع «trace»;
    }
    | مفتاح_صياغة.تسمية_متعلق -> {
        أرجع «related»;
    }
    | مفتاح_صياغة.تسمية_متوقع -> {
        أرجع «expected»;
    }
    | مفتاح_صياغة.تسمية_موجود -> {
        أرجع «found»;
    }
    | مفتاح_صياغة.تسمية_قيمة -> {
        أرجع «value»;
    }
    | مفتاح_صياغة.تسمية_فهرس -> {
        أرجع «index»;
    }
    | مفتاح_صياغة.تسمية_طول -> {
        أرجع «length»;
    }
    | مفتاح_صياغة.تسمية_مجال -> {
        أرجع «range»;
    }
    | مفتاح_صياغة.تسمية_نمط -> {
        أرجع «pattern»;
    }
    | مفتاح_صياغة.تسمية_مسار -> {
        أرجع «path»;
    }
    | مفتاح_صياغة.تسمية_رمز -> {
        أرجع «symbol»;
    }
    | مفتاح_صياغة.تسمية_نوع -> {
        أرجع «type»;
    }
    | مفتاح_صياغة.تسمية_سياق -> {
        أرجع «context»;
    }
    | مفتاح_صياغة.تسمية_مرحلة -> {
        أرجع «phase»;
    }
    | مفتاح_صياغة.تسمية_هدف -> {
        أرجع «target»;
    }
    | مفتاح_صياغة.تسمية_دالة -> {
        أرجع «function»;
    }
    | مفتاح_صياغة.تسمية_كتلة -> {
        أرجع «block»;
    }
    | مفتاح_صياغة.تسمية_تعليمة -> {
        أرجع «instruction»;
    }
    | مفتاح_صياغة.تسمية_عملية -> {
        أرجع «operation»;
    }
    | مفتاح_صياغة.تسمية_بدائي -> {
        أرجع «primitive»;
    }
    | مفتاح_صياغة.تسمية_مصدر_قيمة -> {
        أرجع «source»;
    }
    | مفتاح_صياغة.تسمية_وجهة_قيمة -> {
        أرجع «destination»;
    }
    | مفتاح_صياغة.تسمية_سبب -> {
        أرجع «cause»;
    }
    | مفتاح_صياغة.تسمية_مصدر -> {
        أرجع «source»;
    }
    | مفتاح_صياغة.تسمية_استخدام_غير_صالح -> {
        أرجع «invalid use»;
    }
    | مفتاح_صياغة.تسمية_أصل_النقل -> {
        أرجع «value moved here»;
    }
    | مفتاح_صياغة.تسمية_أصل_التحرير -> {
        أرجع «resource released here»;
    }
    | مفتاح_صياغة.تسمية_المالك_الأصلي -> {
        أرجع «original owner»;
    }
    | مفتاح_صياغة.تسمية_استعارة_متعارضة -> {
        أرجع «conflicting borrow»;
    }
    | مفتاح_صياغة.تسمية_موضع_متوقع -> {
        أرجع «expected here»;
    }
    | مفتاح_صياغة.تسمية_اكتشاف_المحلل -> {
        أرجع «parser discovered the problem here»;
    }
    | مفتاح_صياغة.تسمية_هل_تقصد -> {
        أرجع «did you mean»;
    }
    | مفتاح_صياغة.تسمية_استبدال -> {
        أرجع «replacement»;
    }
    | مفتاح_صياغة.تسمية_فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع «this `;` is misplaced»;
    }
    | مفتاح_صياغة.تسمية_وجهة_فاصلة_منقوطة -> {
        أرجع «move `;` here»;
    }
    | مفتاح_صياغة.تسمية_عبارة_بلا_عملية -> {
        أرجع «this expression is used by itself»;
    }
    | مفتاح_صياغة.تسمية_نمط_غير_قابل_للوصول -> {
        أرجع «unreachable pattern»;
    }
    | مفتاح_صياغة.تسمية_تغطية_نمط_سابقة -> {
        أرجع «covered by an earlier pattern»;
    }
    | مفتاح_صياغة.تسمية_سياق_مرتبط -> {
        أرجع «related context»;
    }
    | مفتاح_صياغة.تسمية_إصلاح_آلي -> {
        أرجع «machine-applicable»;
    }
    | مفتاح_صياغة.تسمية_إصلاح_بعناصر_نائبة -> {
        أرجع «has placeholders»;
    }
    | مفتاح_صياغة.تسمية_إصلاح_تقريبي -> {
        أرجع «may be incorrect»;
    }
    | مفتاح_صياغة.تسمية_إصلاح_غير_محدد -> {
        أرجع «unspecified»;
    }
    | مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم -> {
        أرجع «run `sultanc --help` for available options»;
    }
    | مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم -> {
        أرجع «run `sultanc targets` to list available targets»;
    }
    | مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار -> {
        أرجع «check the option value and try again»;
    }
    | مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم -> {
        أرجع «rerun with JSON diagnostics when reporting this compiler bug»;
    }
    | مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة -> {
        أرجع «insert `;` after this construct»;
    }
    | مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة -> {
        أرجع «move `;` before the closing `}`»;
    }
    | مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة -> {
        أرجع «replace this spelling with the suggested keyword»;
    }
    | مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد -> {
        أرجع «add `()` before `;` to call it, or use `:= value` to assign to it»;
    }
    | مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة -> {
        أرجع «add a return type after `:` (for example, `i32`)»;
    }
    | مفتاح_صياغة.ملاحظة_التصريح_السابق -> {
        أرجع «the previous declaration is shown as related source»;
    }
    | مفتاح_صياغة.قيمة_منطقية_صواب -> {
        أرجع «true»;
    }
    | مفتاح_صياغة.قيمة_منطقية_خطأ -> {
        أرجع «false»;
    };
}

عرف صياغة_عربية(المفتاح: مفتاح_صياغة): نص {
    طابق المفتاح مع
    | مفتاح_صياغة.رسالة_خطأ_نحوي -> {
        أرجع «خطأ نحوي»;
    }
    | مفتاح_صياغة.رسالة_فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع «الفاصلة المنقوطة في موضع غير صحيح»;
    }
    | مفتاح_صياغة.رسالة_تهجئة_كلمة_محجوزة_غير_معروفة -> {
        أرجع «كلمة محجوزة غير معروفة»;
    }
    | مفتاح_صياغة.رسالة_عبارة_بلا_عملية -> {
        أرجع «المتوقع استدعاء دالة أو إسناد قيمة»;
    }
    | مفتاح_صياغة.رسالة_نوع_ناتج_دالة_مفقود -> {
        أرجع «نوع إرجاع الدالة مفقود»;
    }
    | مفتاح_صياغة.رسالة_خطأ_معجمي -> {
        أرجع «خطأ معجمي»;
    }
    | مفتاح_صياغة.رسالة_رفض_تحليل -> {
        أرجع «تعذر تحليل المصدر»;
    }
    | مفتاح_صياغة.رسالة_لا_ناتج_تحليل -> {
        أرجع «لم ينتج المحلل نتيجة»;
    }
    | مفتاح_صياغة.رسالة_استدعاء_مترجم_غير_صالح -> {
        أرجع «استدعاء المترجم غير صالح»;
    }
    | مفتاح_صياغة.رسالة_هدف_مترجم_غير_معروف -> {
        أرجع «هدف غير معروف»;
    }
    | مفتاح_صياغة.رسالة_مصدر_مترجم_مفقود -> {
        أرجع «لم يتم تحديد ملف مصدر»;
    }
    | مفتاح_صياغة.رسالة_خيار_مترجم_غير_معروف -> {
        أرجع «خيار غير معروف»;
    }
    | مفتاح_صياغة.رسالة_قيمة_خيار_مترجم_مفقودة -> {
        أرجع «الخيار يتطلب قيمة»;
    }
    | مفتاح_صياغة.رسالة_لغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع «لغة التشخيص غير صالحة»;
    }
    | مفتاح_صياغة.رسالة_صيغة_تشخيص_مترجم_غير_صالحة -> {
        أرجع «صيغة التشخيص غير صالحة»;
    }
    | مفتاح_صياغة.رسالة_لون_تشخيص_مترجم_غير_صالح -> {
        أرجع «سياسة ألوان التشخيص غير صالحة»;
    }
    | مفتاح_صياغة.رسالة_مصدر_رئيسي_متعدد -> {
        أرجع «لا يمكن تحديد أكثر من ملف مصدر رئيسي»;
    }
    | مفتاح_صياغة.رسالة_أوضاع_مترجم_متعارضة -> {
        أرجع «أوضاع المترجم متعارضة»;
    }
    | مفتاح_صياغة.رسالة_معامل_موضعي_غير_متوقع -> {
        أرجع «معامل موضعي غير متوقع»;
    }
    | مفتاح_صياغة.رسالة_هدف_مضيف_مترجم_غير_متاح -> {
        أرجع «لا يتوفر هدف أصلي مطابق للمضيف»;
    }
    | مفتاح_صياغة.رسالة_فشل_كتابة_مخرج_مترجم -> {
        أرجع «تعذرت كتابة مخرج المترجم»;
    }
