    }
    | خطأ_تحقق_مسير.شرط_فرع_غير_منطقي(الكتلة, القيمة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.branch-condition-not-bool»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.شكل_إرجاع_غير_مطابق(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.return-shape-mismatch»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.نوع_إرجاع_غير_مطابق(الكتلة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.return-type-mismatch»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); };

    دع بلا_حجج: متجه حجة_تشخيص = [];
    دع أضف_مساعدة_خلل: منطقي = أضف_مساعدة(
        &متغير التشخيص,
        مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم(),
        بلا_حجج
    );
    أرجع التشخيص;
}

عام عرف حول_أخطاء_تحقق_مسير_إلى_تشخيصات(
    الأخطاء: &متجه خطأ_تحقق_مسير
): مجموعة_تشخيصات {
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    دع الحالة: متجه خطأ_تحقق_مسير = *الأخطاء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة) مثل غير_موقع)) {
        دع مرجع_الخطأ: &خطأ_تحقق_مسير = &الحالة[ف];
        دع الخطأ: خطأ_تحقق_مسير = *مرجع_الخطأ;
        دع التشخيص: متغير تشخيص = حول_خطأ_تحقق_مسير_إلى_تشخيص(الخطأ);
        أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
        ف := ف + 1;
    }
    أرجع المجموعة;
}
