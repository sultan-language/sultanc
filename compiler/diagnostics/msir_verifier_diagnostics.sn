استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.diagnostics.primitive_identity_presentation;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_model;
استورد compiler.frontend.types.type_identity;
استورد compiler.runtime.primitive_identity;

عرف أضف_سبب_تحقق_مسير(التشخيص: &متغير تشخيص, السبب: نص): فراغ {
    دع أ: منطقي = أضف_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.السبب(), السبب);
}

عرف أضف_دالة_تحقق_مسير(التشخيص: &متغير تشخيص, الدالة: معرف_دالة_مسير): فراغ {
    دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
}

عرف أضف_كتلة_تحقق_مسير(التشخيص: &متغير تشخيص, الكتلة: معرف_كتلة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, الكتلة.الدالة);
    دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
}

عرف أضف_قيمة_تحقق_مسير(التشخيص: &متغير تشخيص, القيمة: معرف_قيمة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, القيمة.الدالة);
    دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
}

عرف أضف_نوع_تحقق_مسير(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    النوع: معرف_نوع
): فراغ {
    دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, المفتاح, النوع.القيمة);
}

عرف أضف_موضع_تحقق_مسير(التشخيص: &متغير تشخيص, الموضع: موضع_تعليمة_مسير): فراغ {
    أضف_دالة_تحقق_مسير(التشخيص, الموضع.الدالة);
    دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الموضع.الكتلة.القيمة);
    دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الموضع.الفهرس);
}

عرف أضف_بدائي_تحقق_مسير(التشخيص: &متغير تشخيص, البدائي: هوية_بدائي_مترجم): فراغ {
    دع النص: نص = نص_هوية_بدائي_تشخيصية(البدائي);
    دع أ: منطقي = أضف_حجة_تشخيص(التشخيص, مفتاح_حجة_تشخيص.البدائي(), النص);
}

عرف نص_عملية_حساب_مسير(العملية: عملية_حساب_صحيح): نص {
    طابق العملية مع
    | عملية_حساب_صحيح.جمع -> { أرجع «add»; }
    | عملية_حساب_صحيح.طرح -> { أرجع «subtract»; }
    | عملية_حساب_صحيح.ضرب -> { أرجع «multiply»; }
    | عملية_حساب_صحيح.قسمة_موقعة -> { أرجع «signed-divide»; }
    | عملية_حساب_صحيح.قسمة_غير_موقعة -> { أرجع «unsigned-divide»; }
    | عملية_حساب_صحيح.باقي_موقع -> { أرجع «signed-remainder»; }
    | عملية_حساب_صحيح.باقي_غير_موقع -> { أرجع «unsigned-remainder»; }
    | عملية_حساب_صحيح.أو_بتي -> { أرجع «bitwise-or»; }
    | عملية_حساب_صحيح.أو_حصري -> { أرجع «bitwise-xor»; }
    | عملية_حساب_صحيح.و_بتي -> { أرجع «bitwise-and»; }
    | عملية_حساب_صحيح.إزاحة_يسرى -> { أرجع «shift-left»; }
    | عملية_حساب_صحيح.إزاحة_يمنى -> { أرجع «shift-right»; }
    | عملية_حساب_صحيح.إزاحة_حسابية_يمنى -> { أرجع «arithmetic-shift-right»; };
}

عرف ابدأ_تشخيص_تحقق_مسير(): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.مسير_غير_صالح(), اختيار.لا_شيء()
    );
    دع أ: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «msir-verifier»
    );
    أرجع التشخيص;
}

عرف حول_خطأ_تحقق_مسير_إلى_تشخيص(الخطأ: خطأ_تحقق_مسير): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_تحقق_مسير();
    طابق الخطأ مع
    | خطأ_تحقق_مسير.دالة_بدء_برنامج_غير_موجودة(الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.missing-program-entry-function»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.معرف_دالة_غير_مقنن(الدالة, الفهرس) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.noncanonical-function-id»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
        دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_تحقق_مسير.دالة_بلا_مدخل(الدالة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.function-without-entry»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); }
    | خطأ_تحقق_مسير.مدخل_غير_صالح(الدالة, الكتلة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-function-entry»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
        دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خطأ_تحقق_مسير.كتلة_مدخل_بمعاملات(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.entry-block-has-parameters»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.نوع_ناتج_دالة_غير_صالح(الدالة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-function-result-type»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.معرف_كتلة_غير_مقنن(الكتلة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.noncanonical-block-id»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.كتلة_من_دالة_أخرى(الكتلة, الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.block-from-other-function»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), الكتلة.الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.كتلة_بلا_منهي(الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.block-without-terminator»); أضف_كتلة_تحقق_مسير(&متغير التشخيص, الكتلة); }
    | خطأ_تحقق_مسير.معرف_قيمة_مكرر(القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.duplicate-value-id»); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.معرف_قيمة_غير_مقنن(الدالة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.noncanonical-value-id»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.عدد_قيم_دالة_غير_متطابق(الدالة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.function-value-count-mismatch»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ1: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); دع أ2: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.قيمة_مقننة_غير_متطابقة(الدالة, الفهرس) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.canonical-value-table-mismatch»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس); }
    | خطأ_تحقق_مسير.عداد_قيم_دالة_غير_متطابق(الدالة, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.function-next-value-mismatch»); أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة); دع أ1: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); دع أ2: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.قيمة_من_دالة_أخرى(القيمة, الدالة) -> {
        أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.value-from-other-function»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), القيمة.الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة);
        أضف_دالة_تحقق_مسير(&متغير التشخيص, الدالة);
    }
    | خطأ_تحقق_مسير.قيمة_غير_موجودة(القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.missing-value»); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.نوع_قيمة_غير_صالح(القيمة, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-value-type»); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.استخدام_قبل_التعريف(القيمة, الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.use-before-definition»); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.تعريف_لا_يهيمن(القيمة, الكتلة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.definition-does-not-dominate»); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); دع أ: منطقي = أضف_حجة_غير_موقعة(&متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة); }
    | خطأ_تحقق_مسير.تعليمة_بلا_ناتج(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.instruction-missing-result»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.نوع_ثابت_غير_مطابق(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.constant-type-mismatch»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.معامل_حساب_غير_صحيح(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.non-integer-arithmetic-operand»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.نوعا_معاملين_غير_متطابقين(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.arithmetic-operand-type-mismatch»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.إشارة_عملية_حساب_غير_مطابقة(الموضع, العملية, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.arithmetic-signedness-mismatch»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); دع نص_العملية: نص = نص_عملية_حساب_مسير(العملية); دع أ: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.العملية(), نص_العملية); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
    | خطأ_تحقق_مسير.نوع_ناتج_حساب_غير_مطابق(الموضع, المتوقع, الموجود) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.arithmetic-result-type-mismatch»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود); }
    | خطأ_تحقق_مسير.نوع_ناتج_مقارنة_غير_منطقي(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.compare-result-not-bool»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الموجود(), النوع); }
    | خطأ_تحقق_مسير.تحويل_صحيح_غير_صالح(الموضع, المصدر, الوجهة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-integer-conversion»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), المصدر); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الوجهة(), الوجهة); }
    | خطأ_تحقق_مسير.تحويل_مرجع_إلى_مؤشر_غير_صالح(الموضع, المصدر, الوجهة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-reference-to-pointer-conversion»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.المصدر(), المصدر); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.الوجهة(), الوجهة); }
    | خطأ_تحقق_مسير.مكان_مستخدم_كقيمة(الموضع, القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.place-used-as-value»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.قيمة_مستخدمة_كمكان(الموضع, القيمة) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.value-used-as-place»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_قيمة_تحقق_مسير(&متغير التشخيص, القيمة); }
    | خطأ_تحقق_مسير.تعليمة_بناتج_غير_متوقع(الموضع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.unexpected-instruction-result»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); }
    | خطأ_تحقق_مسير.تجميع_غير_صالح(الموضع, النوع) -> { أضف_سبب_تحقق_مسير(&متغير التشخيص, «msir.invalid-aggregate»); أضف_موضع_تحقق_مسير(&متغير التشخيص, الموضع); أضف_نوع_تحقق_مسير(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), النوع); }
