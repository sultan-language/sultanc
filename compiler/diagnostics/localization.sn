استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Localization selects auxiliary wording (labels, notes, help) by language.
// The words themselves are owned by iSpeak (compiler/ispeak).

عام عرف صياغة_تشخيص(
    اللغة: لغة_تشخيص,
    المفتاح: مفتاح_صياغة
): نص {
    أرجع نص_تفصيل_ثابت(اللغة, المفتاح);
}

عرف مفتاح_حجة_إلى_صياغة(المفتاح: مفتاح_حجة_تشخيص): مفتاح_صياغة {
    طابق المفتاح مع
    | مفتاح_حجة_تشخيص.القيمة -> {
        أرجع مفتاح_صياغة.تسمية_قيمة();
    }
    | مفتاح_حجة_تشخيص.المتوقع -> {
        أرجع مفتاح_صياغة.تسمية_متوقع();
    }
    | مفتاح_حجة_تشخيص.الاستبدال -> {
        أرجع مفتاح_صياغة.تسمية_استبدال();
    }
    | مفتاح_حجة_تشخيص.الموجود -> {
        أرجع مفتاح_صياغة.تسمية_موجود();
    }
    | مفتاح_حجة_تشخيص.الفهرس -> {
        أرجع مفتاح_صياغة.تسمية_فهرس();
    }
    | مفتاح_حجة_تشخيص.الطول -> {
        أرجع مفتاح_صياغة.تسمية_طول();
    }
    | مفتاح_حجة_تشخيص.المجال -> {
        أرجع مفتاح_صياغة.تسمية_مجال();
    }
    | مفتاح_حجة_تشخيص.النمط -> {
        أرجع مفتاح_صياغة.تسمية_نمط();
    }
    | مفتاح_حجة_تشخيص.المسار -> {
        أرجع مفتاح_صياغة.تسمية_مسار();
    }
    | مفتاح_حجة_تشخيص.الرمز -> {
        أرجع مفتاح_صياغة.تسمية_رمز();
    }
    | مفتاح_حجة_تشخيص.النوع -> {
        أرجع مفتاح_صياغة.تسمية_نوع();
    }
    | مفتاح_حجة_تشخيص.السياق -> {
        أرجع مفتاح_صياغة.تسمية_سياق();
    }
    | مفتاح_حجة_تشخيص.المرحلة -> {
        أرجع مفتاح_صياغة.تسمية_مرحلة();
    }
    | مفتاح_حجة_تشخيص.الهدف -> {
        أرجع مفتاح_صياغة.تسمية_هدف();
    }
    | مفتاح_حجة_تشخيص.الدالة -> {
        أرجع مفتاح_صياغة.تسمية_دالة();
    }
    | مفتاح_حجة_تشخيص.الكتلة -> {
        أرجع مفتاح_صياغة.تسمية_كتلة();
    }
    | مفتاح_حجة_تشخيص.التعليمة -> {
        أرجع مفتاح_صياغة.تسمية_تعليمة();
    }
    | مفتاح_حجة_تشخيص.العملية -> {
        أرجع مفتاح_صياغة.تسمية_عملية();
    }
    | مفتاح_حجة_تشخيص.البدائي -> {
        أرجع مفتاح_صياغة.تسمية_بدائي();
    }
    | مفتاح_حجة_تشخيص.المصدر -> {
        أرجع مفتاح_صياغة.تسمية_مصدر_قيمة();
    }
    | مفتاح_حجة_تشخيص.الوجهة -> {
        أرجع مفتاح_صياغة.تسمية_وجهة_قيمة();
    }
    | مفتاح_حجة_تشخيص.السبب -> {
        أرجع مفتاح_صياغة.تسمية_سبب();
    };
}

عام عرف صياغة_مفتاح_حجة(
    اللغة: لغة_تشخيص,
    المفتاح: مفتاح_حجة_تشخيص
): نص {
    دع الصياغة: مفتاح_صياغة = مفتاح_حجة_إلى_صياغة(المفتاح);
    أرجع صياغة_تشخيص(اللغة, الصياغة);
}

عرف دور_نطاق_إلى_صياغة(الدور: دور_نطاق_تشخيص): مفتاح_صياغة {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> {
        أرجع مفتاح_صياغة.تسمية_متعلق();
    }
    | دور_نطاق_تشخيص.استخدام_غير_صالح -> {
        أرجع مفتاح_صياغة.تسمية_استخدام_غير_صالح();
    }
    | دور_نطاق_تشخيص.أصل_النقل -> {
        أرجع مفتاح_صياغة.تسمية_أصل_النقل();
    }
    | دور_نطاق_تشخيص.أصل_التحرير -> {
        أرجع مفتاح_صياغة.تسمية_أصل_التحرير();
    }
    | دور_نطاق_تشخيص.المالك_الأصلي -> {
        أرجع مفتاح_صياغة.تسمية_المالك_الأصلي();
    }
    | دور_نطاق_تشخيص.استعارة_متعارضة -> {
        أرجع مفتاح_صياغة.تسمية_استعارة_متعارضة();
    }
    | دور_نطاق_تشخيص.موضع_متوقع -> {
        أرجع مفتاح_صياغة.تسمية_موضع_متوقع();
    }
    | دور_نطاق_تشخيص.اكتشاف_المحلل -> {
        أرجع مفتاح_صياغة.تسمية_اكتشاف_المحلل();
    }
    | دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> {
        أرجع مفتاح_صياغة.تسمية_فاصلة_منقوطة_في_غير_موضعها();
    }
    | دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة -> {
        أرجع مفتاح_صياغة.تسمية_وجهة_فاصلة_منقوطة();
    }
    | دور_نطاق_تشخيص.عبارة_بلا_عملية -> {
        أرجع مفتاح_صياغة.تسمية_عبارة_بلا_عملية();
    }
    | دور_نطاق_تشخيص.نمط_غير_قابل_للوصول -> {
        أرجع مفتاح_صياغة.تسمية_نمط_غير_قابل_للوصول();
    }
    | دور_نطاق_تشخيص.تغطية_نمط_سابقة -> {
        أرجع مفتاح_صياغة.تسمية_تغطية_نمط_سابقة();
    }
    | دور_نطاق_تشخيص.سياق_مرتبط -> {
        أرجع مفتاح_صياغة.تسمية_سياق_مرتبط();
    }
    | دور_نطاق_تشخيص.تصريح_غير_قابل_للتغيير -> {
        أرجع مفتاح_صياغة.تسمية_تصريح_غير_قابل_للتغيير();
    };
}

عام عرف صياغة_دور_نطاق(
    اللغة: لغة_تشخيص,
    الدور: دور_نطاق_تشخيص
): نص {
    دع الصياغة: مفتاح_صياغة = دور_نطاق_إلى_صياغة(الدور);
    أرجع صياغة_تشخيص(اللغة, الصياغة);
}

عرف قابلية_إصلاح_إلى_صياغة(القابلية: قابلية_تطبيق_إصلاح): مفتاح_صياغة {
    طابق القابلية مع
    | قابلية_تطبيق_إصلاح.آلي -> {
        أرجع مفتاح_صياغة.تسمية_إصلاح_آلي();
    }
    | قابلية_تطبيق_إصلاح.يحتوي_عناصر_نائبة -> {
        أرجع مفتاح_صياغة.تسمية_إصلاح_بعناصر_نائبة();
    }
    | قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح -> {
        أرجع مفتاح_صياغة.تسمية_إصلاح_تقريبي();
    }
    | قابلية_تطبيق_إصلاح.غير_محدد -> {
        أرجع مفتاح_صياغة.تسمية_إصلاح_غير_محدد();
    };
}

عام عرف صياغة_قابلية_إصلاح(
    اللغة: لغة_تشخيص,
    القابلية: قابلية_تطبيق_إصلاح
): نص {
    دع الصياغة: مفتاح_صياغة = قابلية_إصلاح_إلى_صياغة(القابلية);
    أرجع صياغة_تشخيص(اللغة, الصياغة);
}

// A primary span needs no redundant label; every other role resolves through localization.
عام عرف تسمية_دور_نطاق(
    اللغة: لغة_تشخيص,
    الدور: دور_نطاق_تشخيص
): اختياري نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع اختياري.لا_شيء(); }
    | _ -> { أرجع اختياري.موجود(صياغة_دور_نطاق(اللغة, الدور)); };
}
