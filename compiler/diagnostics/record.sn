استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد std.encoding.positions;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.keys.surface;

// Canonical structured diagnostic record shared by compiler, interpreter and tooling.
// No rendering or semantic ownership lives here.
عام نوع قيمة_حجة_تشخيص =
    | نصية بنوع نص
    | ثنائية_اللغة بنوع (نص, نص)
    | طبيعية بنوع طبيعي
    | موقعة بنوع عدد
    | منطقية بنوع منطقي
    // A typed contextual reason (reason.sn); its words come from iSpeak.
    | سبب بنوع سبب_تشخيص
    // Compiler text owned by iSpeak (for example a package-manifest reason).
    | نص_مترجم بنوع مفتاح_نص_مترجم
;

عام نوع حجة_تشخيص = {
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
};

// Diagnostics keeps the canonical byte span plus optional display coordinates derived
// from compiler/source. Source identity itself never depends on rendered line/column data.
عام نوع نطاق_مصدر_تشخيص = {
    النطاق: نطاق,
    اسم_المصدر: اختياري نص,
    المقتطف: اختياري نص,
    بداية_العرض: اختياري إحداثي_مصدر,
    نهاية_العرض: اختياري إحداثي_مصدر,
    // The same two ends as editors count them (LSP positions): the 0-based
    // line and the 0-based column in UTF-16 code units, derived from the
    // source when the span is built from it. None without the source, or on
    // a line that is not valid UTF-8.
    بداية_يوتيف16: اختياري موضع_نصي_يوتيف16,
    نهاية_يوتيف16: اختياري موضع_نصي_يوتيف16
};

عام نوع نطاق_مرتبط_بتشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
};

عام نوع تعليق_تشخيص = {
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
};

عام نوع تعديل_إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص
};

عام نوع إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
};

عام نوع مدخل_أثر_تشخيص = {
    المفتاح: مفتاح_صياغة,
    المصدر: اختياري نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
};

عام نوع تشخيص = {
    المعرف: معرف_تشخيص,
    المصدر_الرئيسي: اختياري نطاق_مصدر_تشخيص,
    الدور_الرئيسي: دور_نطاق_تشخيص,
    الحجج: متجه حجة_تشخيص,
    النطاقات_المرتبطة: متجه نطاق_مرتبط_بتشخيص,
    الملاحظات: متجه تعليق_تشخيص,
    المساعدة: متجه تعليق_تشخيص,
    الإصلاحات: متجه إصلاح_تشخيص,
    الأثر: متجه مدخل_أثر_تشخيص,
    // Explicit causal dependencies identify diagnostics derived only from an
    // already-reported source failure. Engine suppression consumes these spans;
    // unrelated diagnostics are never hidden by source proximity alone.
    الاعتمادات: متجه نطاق_مصدر_تشخيص
};

عام نوع مجموعة_تشخيصات = {
    التشخيصات: متجه تشخيص,
    عدد_الأخطاء: طبيعي,
    عدد_التحذيرات: طبيعي,
    عدد_الملاحظات: طبيعي,
    حد_الأخطاء: طبيعي,
    بلغ_حد_الأخطاء: منطقي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_مجموعة_تشخيصات(القيمة: &مجموعة_تشخيصات): مجموعة_تشخيصات {
    دع الناتج: مجموعة_تشخيصات = {
        التشخيصات: انسخ_مملوكا_متجه_تشخيص(&(*القيمة).التشخيصات),
        عدد_الأخطاء: (*القيمة).عدد_الأخطاء,
        عدد_التحذيرات: (*القيمة).عدد_التحذيرات,
        عدد_الملاحظات: (*القيمة).عدد_الملاحظات,
        حد_الأخطاء: (*القيمة).حد_الأخطاء,
        بلغ_حد_الأخطاء: (*القيمة).بلغ_حد_الأخطاء
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_تشخيص(القيمة: &متجه تشخيص): متجه تشخيص {
    دع الناتج: متغير متجه تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تشخيص(القيمة: &تشخيص): تشخيص {
    دع الناتج: تشخيص = {
        المعرف: (*القيمة).المعرف,
        المصدر_الرئيسي: انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&(*القيمة).المصدر_الرئيسي),
        الدور_الرئيسي: (*القيمة).الدور_الرئيسي,
        الحجج: انسخ_مملوكا_متجه_حجة_تشخيص(&(*القيمة).الحجج),
        النطاقات_المرتبطة: انسخ_مملوكا_متجه_نطاق_مرتبط_بتشخيص(&(*القيمة).النطاقات_المرتبطة),
        الملاحظات: انسخ_مملوكا_متجه_تعليق_تشخيص(&(*القيمة).الملاحظات),
        المساعدة: انسخ_مملوكا_متجه_تعليق_تشخيص(&(*القيمة).المساعدة),
        الإصلاحات: انسخ_مملوكا_متجه_إصلاح_تشخيص(&(*القيمة).الإصلاحات),
        الأثر: انسخ_مملوكا_متجه_مدخل_أثر_تشخيص(&(*القيمة).الأثر),
        الاعتمادات: انسخ_مملوكا_متجه_نطاق_مصدر_تشخيص(&(*القيمة).الاعتمادات)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(القيمة: &اختياري نطاق_مصدر_تشخيص): اختياري نطاق_مصدر_تشخيص {
    طابق *القيمة مع
    | اختياري.موجود(الداخل) -> { أرجع اختياري.موجود(انسخ_مملوكا_نطاق_مصدر_تشخيص(&الداخل)); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف انسخ_مملوكا_نطاق_مصدر_تشخيص(القيمة: &نطاق_مصدر_تشخيص): نطاق_مصدر_تشخيص {
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: (*القيمة).النطاق,
        اسم_المصدر: انسخ_اختيار_نص(&(*القيمة).اسم_المصدر),
        المقتطف: انسخ_اختيار_نص(&(*القيمة).المقتطف),
        بداية_العرض: (*القيمة).بداية_العرض,
        نهاية_العرض: (*القيمة).نهاية_العرض,
        بداية_يوتيف16: (*القيمة).بداية_يوتيف16,
        نهاية_يوتيف16: (*القيمة).نهاية_يوتيف16
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_حجة_تشخيص(القيمة: &متجه حجة_تشخيص): متجه حجة_تشخيص {
    دع الناتج: متغير متجه حجة_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_حجة_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_حجة_تشخيص(القيمة: &حجة_تشخيص): حجة_تشخيص {
    دع الناتج: حجة_تشخيص = {
        المفتاح: (*القيمة).المفتاح,
        القيمة: انسخ_مملوكا_قيمة_حجة_تشخيص(&(*القيمة).القيمة)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_قيمة_حجة_تشخيص(القيمة: &قيمة_حجة_تشخيص): قيمة_حجة_تشخيص {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(ح0) -> { أرجع قيمة_حجة_تشخيص.نصية(انسخ_نص(&ح0)); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(ح0, ح1) -> { أرجع قيمة_حجة_تشخيص.ثنائية_اللغة(انسخ_نص(&ح0), انسخ_نص(&ح1)); }
    | قيمة_حجة_تشخيص.طبيعية(ح0) -> { أرجع قيمة_حجة_تشخيص.طبيعية(ح0); }
    | قيمة_حجة_تشخيص.موقعة(ح0) -> { أرجع قيمة_حجة_تشخيص.موقعة(ح0); }
    | قيمة_حجة_تشخيص.منطقية(ح0) -> { أرجع قيمة_حجة_تشخيص.منطقية(ح0); }
    | قيمة_حجة_تشخيص.سبب(ح0) -> { أرجع قيمة_حجة_تشخيص.سبب(ح0); }
    | قيمة_حجة_تشخيص.نص_مترجم(ح0) -> { أرجع قيمة_حجة_تشخيص.نص_مترجم(ح0); };
}

عام عرف انسخ_مملوكا_متجه_نطاق_مرتبط_بتشخيص(القيمة: &متجه نطاق_مرتبط_بتشخيص): متجه نطاق_مرتبط_بتشخيص {
    دع الناتج: متغير متجه نطاق_مرتبط_بتشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_نطاق_مرتبط_بتشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_نطاق_مرتبط_بتشخيص(القيمة: &نطاق_مرتبط_بتشخيص): نطاق_مرتبط_بتشخيص {
    دع الناتج: نطاق_مرتبط_بتشخيص = {
        المصدر: انسخ_مملوكا_نطاق_مصدر_تشخيص(&(*القيمة).المصدر),
        الدور: (*القيمة).الدور
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_تعليق_تشخيص(القيمة: &متجه تعليق_تشخيص): متجه تعليق_تشخيص {
    دع الناتج: متغير متجه تعليق_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تعليق_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تعليق_تشخيص(القيمة: &تعليق_تشخيص): تعليق_تشخيص {
    دع الناتج: تعليق_تشخيص = {
        المفتاح: (*القيمة).المفتاح,
        الحجج: انسخ_مملوكا_متجه_حجة_تشخيص(&(*القيمة).الحجج)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_إصلاح_تشخيص(القيمة: &متجه إصلاح_تشخيص): متجه إصلاح_تشخيص {
    دع الناتج: متغير متجه إصلاح_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_إصلاح_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_إصلاح_تشخيص(القيمة: &إصلاح_تشخيص): إصلاح_تشخيص {
    دع الناتج: إصلاح_تشخيص = {
        المصدر: انسخ_مملوكا_نطاق_مصدر_تشخيص(&(*القيمة).المصدر),
        الاستبدال: انسخ_نص(&(*القيمة).الاستبدال),
        التعديلات_الإضافية: انسخ_مملوكا_متجه_تعديل_إصلاح_تشخيص(&(*القيمة).التعديلات_الإضافية),
        القابلية: (*القيمة).القابلية,
        المفتاح: (*القيمة).المفتاح
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_تعديل_إصلاح_تشخيص(القيمة: &متجه تعديل_إصلاح_تشخيص): متجه تعديل_إصلاح_تشخيص {
    دع الناتج: متغير متجه تعديل_إصلاح_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_تعديل_إصلاح_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تعديل_إصلاح_تشخيص(القيمة: &تعديل_إصلاح_تشخيص): تعديل_إصلاح_تشخيص {
    دع الناتج: تعديل_إصلاح_تشخيص = {
        المصدر: انسخ_مملوكا_نطاق_مصدر_تشخيص(&(*القيمة).المصدر),
        الاستبدال: انسخ_نص(&(*القيمة).الاستبدال)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_مدخل_أثر_تشخيص(القيمة: &متجه مدخل_أثر_تشخيص): متجه مدخل_أثر_تشخيص {
    دع الناتج: متغير متجه مدخل_أثر_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_مدخل_أثر_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_مدخل_أثر_تشخيص(القيمة: &مدخل_أثر_تشخيص): مدخل_أثر_تشخيص {
    دع الناتج: مدخل_أثر_تشخيص = {
        المفتاح: (*القيمة).المفتاح,
        المصدر: انسخ_مملوكا_اختيار_نطاق_مصدر_تشخيص(&(*القيمة).المصدر),
        الحجج: انسخ_مملوكا_متجه_حجة_تشخيص(&(*القيمة).الحجج)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_نطاق_مصدر_تشخيص(القيمة: &متجه نطاق_مصدر_تشخيص): متجه نطاق_مصدر_تشخيص {
    دع الناتج: متغير متجه نطاق_مصدر_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, انسخ_مملوكا_نطاق_مصدر_تشخيص(&(*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}
