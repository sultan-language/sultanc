استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;

// Canonical structured diagnostic record shared by compiler, interpreter and tooling.
// No rendering or semantic ownership lives here.
عام نوع قيمة_حجة_تشخيص =
    | نصية بنوع نص
    | ثنائية_اللغة بنوع (نص, نص)
    | غير_موقعة بنوع غير_موقع
    | موقعة بنوع عدد
    | منطقية بنوع منطقي
;

عام نوع حجة_تشخيص = {
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
};

// Diagnostics keeps the canonical byte span plus optional display coordinates derived
// from compiler/source. Source identity itself never depends on rendered line/column data.
عام نوع نطاق_مصدر_تشخيص = {
    النطاق: نطاق,
    اسم_المصدر: اختيار نص,
    المقتطف: اختيار نص,
    بداية_العرض: اختيار إحداثي_مصدر,
    نهاية_العرض: اختيار إحداثي_مصدر
};

عام نوع نطاق_مرتبط_بتشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
};

عام نوع تعليق_تشخيص = {
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
};

عام نوع تعديل_إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص
};

عام نوع إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
};

عام نوع مدخل_أثر_تشخيص = {
    المفتاح: مفتاح_صياغة,
    المصدر: اختيار نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
};

عام نوع تشخيص = {
    المعرف: معرف_تشخيص,
    المصدر_الرئيسي: اختيار نطاق_مصدر_تشخيص,
    الدور_الرئيسي: دور_نطاق_تشخيص,
    الحجج: متجه حجة_تشخيص,
    النطاقات_المرتبطة: متجه نطاق_مرتبط_بتشخيص,
    الملاحظات: متجه تعليق_تشخيص,
    المساعدة: متجه تعليق_تشخيص,
    الإصلاحات: متجه إصلاح_تشخيص,
    الأثر: متجه مدخل_أثر_تشخيص,
    // Explicit causal dependencies identify diagnostics derived only from an
    // already-reported source failure. Engine suppression consumes these spans;
    // unrelated diagnostics are never hidden by source proximity alone.
    الاعتمادات: متجه نطاق_مصدر_تشخيص
};

عام نوع مجموعة_تشخيصات = {
    التشخيصات: متجه تشخيص,
    عدد_الأخطاء: غير_موقع,
    عدد_التحذيرات: غير_موقع,
    عدد_الملاحظات: غير_موقع,
    حد_الأخطاء: غير_موقع,
    بلغ_حد_الأخطاء: منطقي
};
