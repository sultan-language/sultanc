استورد std.text.from_bytes;
استورد std.encoding.positions;
استورد compiler.source.span;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.localization;

// Structured suggestions of a diagnostic, for editors and tools (the LSP
// server, `--diagnostic-format=json`): the fixes of the record with their
// wording, their stable machine kind, their applicability and every edit as
// byte offsets and as LSP positions. The JSON "fixes" array is written from
// the same data (output/json.sn), so a tool reading either sees one truth.
// No suggestion is made here: producers attach a fix only with evidence.

// One edit: replace the bytes [بايت_البداية, بايت_النهاية) of الملف with
// الاستبدال (equal offsets insert). البداية and النهاية are the same ends as
// LSP positions (0-based line, UTF-16 column); none when the source was not
// available or the line is not valid UTF-8, and the byte offsets stay exact.
عام نوع تعديل_اقتراح_تشخيص = {
    الملف: اختياري نص,
    بايت_البداية: طبيعي,
    بايت_النهاية: طبيعي,
    البداية: اختياري موضع_نصي_يوتيف16,
    النهاية: اختياري موضع_نصي_يوتيف16,
    الاستبدال: نص
};

// One suggestion. The edits apply together or not at all; they never
// overlap. المفتاح is the typed wording key, النوع_الآلي its stable machine
// name (`insert-semicolon`, `import-module`, ...), الرسالة its words in the
// requested language.
عام نوع اقتراح_تشخيص = {
    المفتاح: مفتاح_صياغة,
    النوع_الآلي: اختياري نص,
    الرسالة: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    القابلية_الآلية: نص,
    التعديلات: متجه تعديل_اقتراح_تشخيص
};

// The stable machine name of an applicability, as JSON writes it.
عام عرف قابلية_إصلاح_آلية(القابلية: قابلية_تطبيق_إصلاح): نص {
    طابق القابلية مع
    | قابلية_تطبيق_إصلاح.آلي -> { أرجع «machine-applicable»; }
    | قابلية_تطبيق_إصلاح.يحتوي_عناصر_نائبة -> { أرجع «has-placeholders»; }
    | قابلية_تطبيق_إصلاح.قد_يكون_غير_صحيح -> { أرجع «maybe-incorrect»; }
    | قابلية_تطبيق_إصلاح.غير_محدد -> { أرجع «unspecified»; };
}

// The stable machine name of a help key, independent of the message
// language. Every help key has one (check_suggestions.sn); a key that is
// not a help has none.
عام عرف نوع_اقتراح_آلي(المفتاح: مفتاح_صياغة): اختياري نص {
    طابق المفتاح مع
    | مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم -> { أرجع اختياري.موجود(«show-compiler-options»); }
    | مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم -> { أرجع اختياري.موجود(«show-compiler-targets»); }
    | مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار -> { أرجع اختياري.موجود(«check-option-value»); }
    | مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم -> { أرجع اختياري.موجود(«report-compiler-bug»); }
    | مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة -> { أرجع اختياري.موجود(«insert-semicolon»); }
    | مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة -> { أرجع اختياري.موجود(«move-semicolon»); }
    | مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة -> { أرجع اختياري.موجود(«replace-keyword-spelling»); }
    | مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد -> { أرجع اختياري.موجود(«complete-statement»); }
    | مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة -> { أرجع اختياري.موجود(«add-return-type»); }
    | مفتاح_صياغة.مساعدة_اجعل_التصريح_عاما -> { أرجع اختياري.موجود(«make-public»); }
    | مفتاح_صياغة.مساعدة_ارفع_ميزانية_وقت_الترجمة -> { أرجع اختياري.موجود(«raise-comptime-budget»); }
    | مفتاح_صياغة.مساعدة_انقل_الأثر_إلى_وقت_التشغيل -> { أرجع اختياري.موجود(«move-effect-to-runtime»); }
    | مفتاح_صياغة.مساعدة_اسم_مشابه_مرئي -> { أرجع اختياري.موجود(«similar-name»); }
    | مفتاح_صياغة.مساعدة_استورد_وحدة_تصرح_بالاسم -> { أرجع اختياري.موجود(«import-module»); }
    | مفتاح_صياغة.مساعدة_ابن_تنفيذيا_لمكتبة_ساكنة -> { أرجع اختياري.موجود(«build-executable»); }
    | مفتاح_صياغة.مساعدة_حدد_المكتبة_القياسية -> { أرجع اختياري.موجود(«locate-standard-library»); }
    | مفتاح_صياغة.مساعدة_اجعل_التصريح_متغيرا -> { أرجع اختياري.موجود(«declare-mutable»); }
    | مفتاح_صياغة.مساعدة_حول_القيمة_صراحة -> { أرجع اختياري.موجود(«explicit-cast»); }
    | مفتاح_صياغة.مساعدة_استعر_القيمة -> { أرجع اختياري.موجود(«borrow»); }
    | مفتاح_صياغة.مساعدة_اقرأ_القيمة_عبر_المرجع -> { أرجع اختياري.موجود(«dereference»); }
    | مفتاح_صياغة.مساعدة_اختر_اسما_غير_محجوز -> { أرجع اختياري.موجود(«choose-another-name»); }
    | مفتاح_صياغة.مساعدة_صرح_بالقيمة_داخل_دالة -> { أرجع اختياري.موجود(«declare-in-function»); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف تعديل_من_نطاق(المصدر: &نطاق_مصدر_تشخيص, الاستبدال: &نص): تعديل_اقتراح_تشخيص {
    دع البداية: طبيعي = (*المصدر).النطاق.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = (*المصدر).النطاق.النهاية.البايت مثل طبيعي;
    دع الناتج: تعديل_اقتراح_تشخيص = {
        الملف: انسخ_اختيار_نص(&(*المصدر).اسم_المصدر),
        بايت_البداية: البداية,
        بايت_النهاية: النهاية,
        البداية: (*المصدر).بداية_يوتيف16,
        النهاية: (*المصدر).نهاية_يوتيف16,
        الاستبدال: انسخ_نص(الاستبدال)
    };
    أرجع الناتج;
}

// The suggestion of one fix of a diagnostic, worded in اللغة.
عام عرف اقتراح_من_إصلاح(الإصلاح: &إصلاح_تشخيص, اللغة: لغة_تشخيص): اقتراح_تشخيص {
    دع التعديلات: متغير متجه تعديل_اقتراح_تشخيص = [];
    ألحق(التعديلات, تعديل_من_نطاق(&(*الإصلاح).المصدر, &(*الإصلاح).الاستبدال));
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*الإصلاح).التعديلات_الإضافية) مثل طبيعي)) {
        ألحق(التعديلات, تعديل_من_نطاق(
            &(*الإصلاح).التعديلات_الإضافية[ت].المصدر, &(*الإصلاح).التعديلات_الإضافية[ت].الاستبدال
        ));
        ت := ت + 1;
    }
    دع الناتج: اقتراح_تشخيص = {
        المفتاح: (*الإصلاح).المفتاح,
        النوع_الآلي: نوع_اقتراح_آلي((*الإصلاح).المفتاح),
        الرسالة: صياغة_تشخيص(اللغة, (*الإصلاح).المفتاح),
        القابلية: (*الإصلاح).القابلية,
        القابلية_الآلية: قابلية_إصلاح_آلية((*الإصلاح).القابلية),
        التعديلات: التعديلات
    };
    أرجع الناتج;
}

// Every suggestion of a diagnostic, in the order the producer made them.
عام عرف اقتراحات_تشخيص(التشخيص: &تشخيص, اللغة: لغة_تشخيص): متجه اقتراح_تشخيص {
    دع الناتج: متغير متجه اقتراح_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التشخيص).الإصلاحات) مثل طبيعي)) {
        ألحق(الناتج, اقتراح_من_إصلاح(&(*التشخيص).الإصلاحات[ف], اللغة));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Only the suggestions a tool may apply without asking (machine-applicable).
عام عرف اقتراحات_آلية_لتشخيص(التشخيص: &تشخيص, اللغة: لغة_تشخيص): متجه اقتراح_تشخيص {
    دع الكل: متجه اقتراح_تشخيص = اقتراحات_تشخيص(التشخيص, اللغة);
    دع الناتج: متغير متجه اقتراح_تشخيص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكل) مثل طبيعي)) {
        طابق الكل[ف].القابلية مع
        | قابلية_تطبيق_إصلاح.آلي -> { ألحق(الناتج, اقتراح_من_إصلاح(&(*التشخيص).الإصلاحات[ف], اللغة)); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The text of a file after the edits of one suggestion: none when an edit
// lies outside النص or two edits overlap (the suggestion is not applied in
// part). The edits must all belong to the file النص is.
عام عرف طبق_اقتراحا_على_نص(النص: &نص, الاقتراح: &اقتراح_تشخيص): اختياري نص {
    دع العدد: طبيعي = الطول((*الاقتراح).التعديلات) مثل طبيعي;
    دع الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    // Order of the edits by start byte (a stable selection sort: few edits).
    دع الترتيب: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الترتيب, ف); ف := ف + 1; }
    دع أ: متغير طبيعي = 0;
    طالما (أ < العدد) {
        دع الأصغر: متغير طبيعي = أ;
        دع ب: متغير طبيعي = أ + 1;
        طالما (ب < العدد) {
            إذا ((*الاقتراح).التعديلات[الترتيب[ب]].بايت_البداية
                < (*الاقتراح).التعديلات[الترتيب[الأصغر]].بايت_البداية) { الأصغر := ب; };
            ب := ب + 1;
        }
        دع المؤقت: طبيعي = الترتيب[أ];
        الترتيب[أ] := الترتيب[الأصغر];
        الترتيب[الأصغر] := المؤقت;
        أ := أ + 1;
    }
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < العدد) {
        دع التعديل: &تعديل_اقتراح_تشخيص = &(*الاقتراح).التعديلات[الترتيب[ك]];
        إذا ((*التعديل).بايت_البداية < الموضع
            || (*التعديل).بايت_النهاية < (*التعديل).بايت_البداية
            || (*التعديل).بايت_النهاية > الطول_الكلي) { أرجع اختياري.لا_شيء(); };
        طالما (الموضع < (*التعديل).بايت_البداية) { ألحق(الناتج, (*النص)[الموضع]); الموضع := الموضع + 1; }
        ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&(*التعديل).الاستبدال));
        الموضع := (*التعديل).بايت_النهاية;
        ك := ك + 1;
    }
    طالما (الموضع < الطول_الكلي) { ألحق(الناتج, (*النص)[الموضع]); الموضع := الموضع + 1; }
    أرجع اختياري.موجود(الناتج مثل نص);
}
