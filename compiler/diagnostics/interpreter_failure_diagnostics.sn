استورد compiler.diagnostics.diagnostic_model;
استورد compiler.diagnostics.catalog;
استورد compiler.diagnostics.primitive_identity_presentation;
استورد compiler.interpreter.diagnostics.runtime_failures;
استورد compiler.msir.identifiers;
استورد compiler.runtime.primitive_identity;

عرف أضف_سبب_مفسر(التشخيص: &متغير تشخيص, السبب: نص): فراغ {
    دع أضيف: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.السبب(), السبب
    );
}

عرف أضف_قيمة_مفسر(التشخيص: &متغير تشخيص, القيمة: معرف_قيمة_مسير): فراغ {
    دع أضيف: منطقي = أضف_حجة_غير_موقعة(
        التشخيص, مفتاح_حجة_تشخيص.القيمة(), القيمة.القيمة
    );
}

عرف أضف_بدائي_مفسر(التشخيص: &متغير تشخيص, البدائي: هوية_بدائي_مترجم): فراغ {
    دع النص: نص = نص_هوية_بدائي_تشخيصية(البدائي);
    دع أضيف: منطقي = أضف_حجة_تشخيص(
        التشخيص, مفتاح_حجة_تشخيص.البدائي(), النص
    );
}

عرف أضف_خطأ_وقت_تشغيل_مفسر(
    التشخيص: &متغير تشخيص,
    الخطأ: خطأ_وقت_تشغيل_مفسر
): فراغ {
    طابق الخطأ مع
    | خطأ_وقت_تشغيل_مفسر.إزاحة_غير_صالحة(القيمة, الإزاحة, الطول) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.invalid-offset»);
        أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_إزاحة: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الإزاحة);
        دع أضف_طول: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.فهرس_سالب(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.negative-index»);
        أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.فهرس_خارج_المدى(القيمة, الفهرس, الطول) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.index-out-of-range»);
        أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
        دع أضف_طول: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_غير_مهيأة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.uninitialized-slot»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_قيمة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.slot-not-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.خانة_ليست_مكانا(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.slot-not-place»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.مكان_للقراءة_فقط(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.read-only-place»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.محاولة_كتابة_مكان_للقراءة_فقط -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.write-read-only-place»);
    }
    | خطأ_وقت_تشغيل_مفسر.جذر_مكان_تالف -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.corrupt-place-root»);
    }
    | خطأ_وقت_تشغيل_مفسر.إسقاط_مكان_تالف(الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.corrupt-place-projection»);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.مرجع_تالف(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.corrupt-reference»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.صندوق_تالف(الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.corrupt-box»);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صندوق_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-box-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_صحيح_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-integer-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_تجميع_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-aggregate-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_نص_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-text-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_موسومة_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-tagged-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.منشئ_موسوم_غير_مطابق(المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.tagged-constructor-mismatch»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_وقت_تشغيل_مفسر.حمولة_موسومة_خارج_المدى(الفهرس, الطول) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.tagged-payload-out-of-range»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الطول(), الطول);
    }
    | خطأ_وقت_تشغيل_مفسر.قيمة_منطقية_متوقعة(القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.expected-bool-value»); أضف_قيمة_مفسر(التشخيص, القيمة);
    }
    | خطأ_وقت_تشغيل_مفسر.نص_يوتيف8_غير_صالح(القيمة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.invalid-utf8»); أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.عدد_حجج_بدائي_غير_متسق(البدائي, المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.primitive-argument-count-mismatch»); أضف_بدائي_مفسر(التشخيص, البدائي);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خطأ_وقت_تشغيل_مفسر.حجة_بدائي_غير_صالحة(البدائي, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.invalid-primitive-argument»); أضف_بدائي_مفسر(التشخيص, البدائي);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خطأ_وقت_تشغيل_مفسر.جسر_نص_مضيف_غير_متاح(البدائي) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.host-text-bridge-unavailable»); أضف_بدائي_مفسر(التشخيص, البدائي);
    }
    | خطأ_وقت_تشغيل_مفسر.بدائي_مضيف_غير_مدعوم(البدائي) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.unsupported-host-primitive»); أضف_بدائي_مفسر(التشخيص, البدائي);
    }
    | خطأ_وقت_تشغيل_مفسر.فهرس_وسيط_عملية_خارج_المدى(الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.runtime.process-argument-index-out-of-range»);
        دع أضف_فهرس: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    };
}

عرف أضف_خلل_داخلي_مفسر(
    التشخيص: &متغير تشخيص,
    الخطأ: خلل_داخلي_مفسر
): فراغ {
    طابق الخطأ مع
    | خلل_داخلي_مفسر.دالة_مفقودة(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-function»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.كتلة_مفقودة(الكتلة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-block»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خلل_داخلي_مفسر.تعليمة_مفقودة(الكتلة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-instruction»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.التعليمة(), الفهرس);
    }
    | خلل_داخلي_مفسر.منهي_مفقود(الكتلة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-terminator»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
    }
    | خلل_داخلي_مفسر.قيمة_مسير_مفقودة(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-msir-value»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.معرف_خانة_من_دالة_أخرى(الدالة, القيمة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.slot-from-other-function»); أضف_قيمة_مفسر(التشخيص, القيمة);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.معرف_خانة_خارج_المدى(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.slot-id-out-of-range»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.معامل_دالة_مفقود(الدالة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-function-parameter»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خلل_داخلي_مفسر.معامل_كتلة_مفقود(الكتلة, الفهرس) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-block-parameter»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الفهرس(), الفهرس);
    }
    | خلل_داخلي_مفسر.عدد_حجج_غير_متسق(المتوقع, الموجود) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.argument-count-mismatch»);
        دع أ1: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), المتوقع);
        دع أ2: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الموجود(), الموجود);
    }
    | خلل_داخلي_مفسر.مدخل_دالة_مفقود(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-function-entry»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.مكدس_نداءات_فارغ -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.empty-call-stack»); }
    | خلل_داخلي_مفسر.تفعيل_مفقود(التفعيل) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-activation»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.القيمة(), التفعيل);
    }
    | خلل_داخلي_مفسر.شكل_إرجاع_غير_متسق(الدالة) -> {
        أضف_سبب_مفسر(التشخيص, «interpreter.internal.return-shape-mismatch»);
        دع أ: منطقي = أضف_حجة_غير_موقعة(التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة);
    }
    | خلل_داخلي_مفسر.نوع_صحيح_مفقود(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-integer-type»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_عشري_مفقود(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-float-type»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_فهرسة_غير_متسق(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.index-type-mismatch»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نوع_مرجع_غير_متسق(القيمة) -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.reference-type-mismatch»); أضف_قيمة_مفسر(التشخيص, القيمة); }
    | خلل_داخلي_مفسر.نتيجة_تعليمة_مفقودة -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.missing-instruction-result»); }
    | خلل_داخلي_مفسر.نتيجة_تعليمة_غير_متوقعة -> { أضف_سبب_مفسر(التشخيص, «interpreter.internal.unexpected-instruction-result»); };
}

// Interpreter owns failure facts. Diagnostics alone owns their user/machine presentation.
عام عرف حول_فشل_تفسير_مسير_إلى_تشخيصات(
    الفشل: &فشل_تفسير_مسير
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص;
    طابق *الفشل مع
    | فشل_تفسير_مسير.وقت_تشغيل(الخطأ) -> {
        التشخيص := ابدأ_تشخيصا(
            معرف_تشخيص.فشل_تفسير_وقت_تشغيل(), اختيار.لا_شيء()
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_خطأ_وقت_تشغيل_مفسر(&متغير التشخيص, الخطأ);
    }
    | فشل_تفسير_مسير.فخ_مسير(الدالة, الكتلة) -> {
        التشخيص := ابدأ_تشخيصا(
            معرف_تشخيص.فخ_تفسير(), اختيار.لا_شيء()
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_سبب_مفسر(&متغير التشخيص, «interpreter.trap»);
        دع أضف_دالة: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الدالة(), الدالة.القيمة
        );
        دع أضف_كتلة: منطقي = أضف_حجة_غير_موقعة(
            &متغير التشخيص, مفتاح_حجة_تشخيص.الكتلة(), الكتلة.القيمة
        );
    }
    | فشل_تفسير_مسير.خلل_داخلي(الخطأ) -> {
        التشخيص := ابدأ_تشخيصا(
            معرف_تشخيص.فشل_مترجم_داخلي(), اختيار.لا_شيء()
        );
        دع أضف_مرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «interpreter»
        );
        أضف_خلل_داخلي_مفسر(&متغير التشخيص, الخطأ);
        دع بلا_حجج: متجه حجة_تشخيص = [];
        دع أضف_مساعدة_خلل: منطقي = أضف_مساعدة(
            &متغير التشخيص,
            مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم(),
            بلا_حجج
        );
    };
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
