عام عرف شرح_كود_تشخيص(الكود: &نص, اللغة: لغة_تشخيص): اختيار نص {
    طابق معرف_تشخيص_من_كود(الكود) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المعرف) -> { أرجع اختيار.بعض(شرح_معرف_تشخيص(المعرف, اللغة)); };
}
