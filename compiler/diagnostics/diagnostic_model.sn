عام نوع لغة_تشخيص =
    | الإنجليزية
    | العربية
;

عام نوع مفتاح_حجة_تشخيص =
    | القيمة
    | المتوقع
    | الاستبدال
    | الموجود
    | الفهرس
    | الطول
    | المجال
    | النمط
    | المسار
    | الرمز
    | النوع
    | السياق
    | المرحلة
    | الهدف
    | الدالة
    | الكتلة
    | التعليمة
    | العملية
    | البدائي
    | المصدر
    | الوجهة
    | السبب
;

عام نوع قيمة_حجة_تشخيص =
    | نصية بنوع نص
    | ثنائية_اللغة بنوع (نص, نص)
    | غير_موقعة بنوع غير_موقع
    | موقعة بنوع عدد
    | منطقية بنوع منطقي
;

عام نوع حجة_تشخيص = {
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
};

عام نوع دور_نطاق_تشخيص =
    | رئيسي
    | استخدام_غير_صالح
    | أصل_النقل
    | أصل_التحرير
    | المالك_الأصلي
    | استعارة_متعارضة
    | موضع_متوقع
    | اكتشاف_المحلل
    | فاصلة_منقوطة_في_غير_موضعها
    | وجهة_فاصلة_منقوطة
    | عبارة_بلا_عملية
    | نمط_غير_قابل_للوصول
    | تغطية_نمط_سابقة
    | سياق_مرتبط
;

// Source identity/coordinates remain owned by frontend/source. Diagnostics only captures display metadata.
عام نوع نطاق_مصدر_تشخيص = {
    النطاق: نطاق,
    اسم_المصدر: اختيار نص,
    المقتطف: اختيار نص
};

عام نوع نطاق_مرتبط_بتشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
};

عام نوع تعليق_تشخيص = {
    المفتاح: مفتاح_صياغة,
    الحجج: متجه حجة_تشخيص
};

عام نوع قابلية_تطبيق_إصلاح =
    | آلي
    | يحتوي_عناصر_نائبة
    | قد_يكون_غير_صحيح
    | غير_محدد
;

عام نوع تعديل_إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص
};

عام نوع إصلاح_تشخيص = {
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
};

عام نوع مدخل_أثر_تشخيص = {
    المفتاح: مفتاح_صياغة,
    المصدر: اختيار نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
};

عام نوع تشخيص = {
    المعرف: معرف_تشخيص,
    المصدر_الرئيسي: اختيار نطاق_مصدر_تشخيص,
    الدور_الرئيسي: دور_نطاق_تشخيص,
    الحجج: متجه حجة_تشخيص,
    النطاقات_المرتبطة: متجه نطاق_مرتبط_بتشخيص,
    الملاحظات: متجه تعليق_تشخيص,
    المساعدة: متجه تعليق_تشخيص,
    الإصلاحات: متجه إصلاح_تشخيص,
    الأثر: متجه مدخل_أثر_تشخيص
};

عام نوع مجموعة_تشخيصات = {
    التشخيصات: متجه تشخيص,
    عدد_الأخطاء: غير_موقع,
    عدد_التحذيرات: غير_موقع,
    عدد_الملاحظات: غير_موقع
};

// هوية المصدر الرقمية تبقى في نطاق Frontend؛ الاسم والمقتطف بيانات عرض اختيارية فقط.
عام عرف نطاق_مصدر_تشخيص_بأصل(
    النطاق: نطاق,
    اسم_المصدر: اختيار نص,
    المقتطف: اختيار نص
): نطاق_مصدر_تشخيص {
    دع الاسم: متغير اختيار نص = اختيار.لا_شيء();
    طابق اسم_المصدر مع
    | اختيار.بعض(القيمة) -> {
        لو ((الطول(القيمة) مثل غير_موقع) > 0) {
            الاسم := اختيار.بعض(القيمة);
        };
    }
    | اختيار.لا_شيء -> { };
    دع الناتج: نطاق_مصدر_تشخيص = {
        النطاق: النطاق,
        اسم_المصدر: الاسم,
        المقتطف: المقتطف
    };
    أرجع الناتج;
}

// يبقى هذا المنشئ متوافقا مع المنتجين الذين يمررون اسما نصيا مباشرا.
// الاسم الفارغ يعني أن اسم الملف غير متاح، ولا يتحول إلى اسم مصدر مختلق.
عام عرف نطاق_مصدر_تشخيص_جديد(
    النطاق: نطاق,
    اسم_المصدر: نص,
    المقتطف: اختيار نص
): نطاق_مصدر_تشخيص {
    أرجع نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختيار.بعض(اسم_المصدر),
        المقتطف
    );
}

// التحويل العام من نطاق مصدر إلى واصف تشخيص افتراضي يملكه Diagnostics وحده.
// المالك الدلالي يقرر أي نطاق فشل؛ هذا المساعد لا يقرر سبب التشخيص.
عام عرف مصدر_تشخيص_من_نطاق(
    النطاق: نطاق
): اختيار نطاق_مصدر_تشخيص {
    دع المصدر: نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
        النطاق,
        اختيار.لا_شيء(),
        اختيار.لا_شيء()
    );
    أرجع اختيار.بعض(المصدر);
}

عام عرف ابدأ_تشخيصا(
    المعرف: معرف_تشخيص,
    المصدر: اختيار نطاق_مصدر_تشخيص
): تشخيص {
    دع الحجج: متجه حجة_تشخيص = [];
    دع المرتبطة: متجه نطاق_مرتبط_بتشخيص = [];
    دع الملاحظات: متجه تعليق_تشخيص = [];
    دع المساعدة: متجه تعليق_تشخيص = [];
    دع الإصلاحات: متجه إصلاح_تشخيص = [];
    دع الأثر: متجه مدخل_أثر_تشخيص = [];
    دع الدور_الرئيسي: دور_نطاق_تشخيص = دور_نطاق_تشخيص.رئيسي();
    دع الناتج: تشخيص = {
        المعرف: المعرف,
        المصدر_الرئيسي: المصدر,
        الدور_الرئيسي: الدور_الرئيسي,
        الحجج: الحجج,
        النطاقات_المرتبطة: المرتبطة,
        الملاحظات: الملاحظات,
        المساعدة: المساعدة,
        الإصلاحات: الإصلاحات,
        الأثر: الأثر
    };
    أرجع الناتج;
}

عام عرف ضع_دور_النطاق_الرئيسي(
    التشخيص: &متغير تشخيص,
    الدور: دور_نطاق_تشخيص
): فراغ {
    دع الحالة: متغير تشخيص = *التشخيص;
    الحالة.الدور_الرئيسي := الدور;
    *التشخيص := الحالة;
}

عرف أضف_قيمة_حجة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: قيمة_حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع الحجة: حجة_تشخيص = {
        المفتاح: المفتاح,
        القيمة: القيمة
    };
    ألحق(الحالة.الحجج, الحجة);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_حجة_تشخيص(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.نصية(القيمة)
    );
}

عام عرف أضف_حجة_ثنائية_اللغة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    الإنجليزية: نص,
    العربية: نص
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية)
    );
}

عام عرف أضف_حجة_غير_موقعة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: غير_موقع
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.غير_موقعة(القيمة)
    );
}

عام عرف أضف_حجة_موقعة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: عدد
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.موقعة(القيمة)
    );
}

عام عرف أضف_حجة_منطقية(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: منطقي
): منطقي {
    أرجع أضف_قيمة_حجة(
        التشخيص,
        المفتاح,
        قيمة_حجة_تشخيص.منطقية(القيمة)
    );
}

عام عرف أضف_نطاقا_مرتبطا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الدور: دور_نطاق_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع المرتبط: نطاق_مرتبط_بتشخيص = {
        المصدر: المصدر,
        الدور: الدور
    };
    ألحق(الحالة.النطاقات_المرتبطة, المرتبط);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_ملاحظة(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
