عام عرف أضف_إصلاحا(
    التشخيص: &متغير تشخيص,
    المصدر: نطاق_مصدر_تشخيص,
    الاستبدال: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع التعديلات_الإضافية: متجه تعديل_إصلاح_تشخيص = [];
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر,
        الاستبدال: الاستبدال,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق(الحالة.الإصلاحات, الإصلاح);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_إصلاحا_مركبا_من_تعديلين(
    التشخيص: &متغير تشخيص,
    المصدر_الأول: نطاق_مصدر_تشخيص,
    الاستبدال_الأول: نص,
    المصدر_الثاني: نطاق_مصدر_تشخيص,
    الاستبدال_الثاني: نص,
    القابلية: قابلية_تطبيق_إصلاح,
    المفتاح: مفتاح_صياغة
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع التعديلات_الإضافية: متغير متجه تعديل_إصلاح_تشخيص = [];
    دع التعديل_الثاني: تعديل_إصلاح_تشخيص = {
        المصدر: المصدر_الثاني,
        الاستبدال: الاستبدال_الثاني
    };
    ألحق(التعديلات_الإضافية, التعديل_الثاني);
    دع الإصلاح: إصلاح_تشخيص = {
        المصدر: المصدر_الأول,
        الاستبدال: الاستبدال_الأول,
        التعديلات_الإضافية: التعديلات_الإضافية,
        القابلية: القابلية,
        المفتاح: المفتاح
    };
    ألحق(الحالة.الإصلاحات, الإصلاح);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف أضف_أثرا(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_صياغة,
    المصدر: اختيار نطاق_مصدر_تشخيص,
    الحجج: متجه حجة_تشخيص
): منطقي {
    دع الحالة: متغير تشخيص = *التشخيص;
    دع المدخل: مدخل_أثر_تشخيص = {
        المفتاح: المفتاح,
        المصدر: المصدر,
        الحجج: الحجج
    };
    ألحق(الحالة.الأثر, المدخل);
    *التشخيص := الحالة;
    أرجع صواب;
}

عام عرف مجموعة_تشخيصات_جديدة(): مجموعة_تشخيصات {
    دع التشخيصات: متجه تشخيص = [];
    دع الناتج: مجموعة_تشخيصات = {
        التشخيصات: التشخيصات,
        عدد_الأخطاء: 0,
        عدد_التحذيرات: 0,
        عدد_الملاحظات: 0
    };
    أرجع الناتج;
}
