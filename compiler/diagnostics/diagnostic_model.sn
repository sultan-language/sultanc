استورد compiler.frontend.source.position;
استورد compiler.frontend.source.scope;

// Diagnostics owns structured reporting facts only. Semantic owners decide why a diagnostic exists.
عام نوع شدة_تشخيص =
    | خطأ
    | تحذير
    | ملاحظة
;

// Stable compiler diagnostic identities. Codes are assigned only by catalog.sn.
