استورد compiler.runtime.primitive_identity;

// Diagnostics owns the stable machine name of the canonical Runtime primitive identity.
// This table does not redefine typing, effects, lowering, or provider semantics.
عام عرف نص_هوية_بدائي_تشخيصية(البدائي: هوية_بدائي_مترجم): نص {
    طابق البدائي مع
    | هوية_بدائي_مترجم.نداء_نواة_خام -> { أرجع «raw-kernel-call»; }
    | هوية_بدائي_مترجم.طول -> { أرجع «length»; }
    | هوية_بدائي_مترجم.إلحاق -> { أرجع «append»; }
    | هوية_بدائي_مترجم.إزالة_الأخير -> { أرجع «pop»; }
    | هوية_بدائي_مترجم.اقتطاع_متجه -> { أرجع «truncate»; }
    | هوية_بدائي_مترجم.ضبط_طول_متجه -> { أرجع «set-vector-length»; }
    | هوية_بدائي_مترجم.سعة_متجه -> { أرجع «capacity»; }
    | هوية_بدائي_مترجم.حجز_سعة_متجه -> { أرجع «reserve_exact»; }
    | هوية_بدائي_مترجم.تبديل_موضعين -> { أرجع «swap-places»; }
    | هوية_بدائي_مترجم.تحرير -> { أرجع «release»; }
    | هوية_بدائي_مترجم.معمارية_المضيف -> { أرجع «host-architecture»; }
    | هوية_بدائي_مترجم.منصة_المضيف -> { أرجع «host-platform»; }
    | هوية_بدائي_مترجم.بيئة_المضيف -> { أرجع «host-environment»; }
    | هوية_بدائي_مترجم.بتات_ع64 -> { أرجع «f64-to-bits»; }
    | هوية_بدائي_مترجم.ع64_من_بتات -> { أرجع «f64-from-bits»; }
    | هوية_بدائي_مترجم.بتات_ع32 -> { أرجع «f32-to-bits»; }
    | هوية_بدائي_مترجم.ع32_من_بتات -> { أرجع «f32-from-bits»; }
    | هوية_بدائي_مترجم.جمع_ملتف -> { أرجع «wrapping-add»; }
    | هوية_بدائي_مترجم.طرح_ملتف -> { أرجع «wrapping-sub»; }
    | هوية_بدائي_مترجم.ضرب_ملتف -> { أرجع «wrapping-mul»; }
    | هوية_بدائي_مترجم.إزاحة_يسرى_ملتفة -> { أرجع «wrapping-shl»; }
    | هوية_بدائي_مترجم.إزاحة_يمنى_ملتفة -> { أرجع «wrapping-shr»; }
    | هوية_بدائي_مترجم.نمو_ذاكرة_خطية -> { أرجع «linear-memory-grow»; }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_خطية -> { أرجع «linear-memory-load32»; }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_خطية -> { أرجع «linear-memory-store32»; }
    | هوية_بدائي_مترجم.نسخ_ذاكرة_خطية -> { أرجع «linear-memory-copy»; }
    | هوية_بدائي_مترجم.قاعدة_كومة_خطية -> { أرجع «linear-memory-heap-base»; }
    | هوية_بدائي_مترجم.قراءة_ذاكرة_آلة -> { أرجع «machine-memory-load64»; }
    | هوية_بدائي_مترجم.كتابة_ذاكرة_آلة -> { أرجع «machine-memory-store64»; }
    | هوية_بدائي_مترجم.حجم_النوع -> { أرجع «size-of»; }
    | هوية_بدائي_مترجم.محاذاة_النوع -> { أرجع «align-of»; }
    | هوية_بدائي_مترجم.عدد_حقول_النوع -> { أرجع «field-count»; }
    | هوية_بدائي_مترجم.عدد_منشئات_النوع -> { أرجع «constructor-count»; }
    | هوية_بدائي_مترجم.فشل_وقت_الترجمة -> { أرجع «compile-error»; }
    | هوية_بدائي_مترجم.استنساخ -> { أرجع «clone»; }
    | هوية_بدائي_مترجم.احتفاظ_بقيمة -> { أرجع «retain»; }
    | هوية_بدائي_مترجم.زيادة_مراجع_إغلاق -> { أرجع «closure-retain»; }
    | هوية_بدائي_مترجم.إنقاص_مراجع_إغلاق -> { أرجع «closure-release»; }
    | هوية_بدائي_مترجم.مدمر_بيئة_إغلاق -> { أرجع «closure-destructor»; }
    | هوية_بدائي_مترجم.عملية_عائمة(العملية) -> {
        طابق العملية مع
        | عملية_عائمة_بدائية.جذر_تربيعي -> { أرجع «float-sqrt»; }
        | عملية_عائمة_بدائية.قيمة_مطلقة -> { أرجع «float-abs»; }
        | عملية_عائمة_بدائية.أرضية -> { أرجع «float-floor»; }
        | عملية_عائمة_بدائية.سقف -> { أرجع «float-ceil»; }
        | عملية_عائمة_بدائية.بتر -> { أرجع «float-trunc»; }
        | عملية_عائمة_بدائية.تقريب_زوجي -> { أرجع «float-round-ties-even»; }
        | عملية_عائمة_بدائية.أدنى -> { أرجع «float-minimum»; }
        | عملية_عائمة_بدائية.أقصى -> { أرجع «float-maximum»; }
        | عملية_عائمة_بدائية.نسخ_إشارة -> { أرجع «float-copysign»; }
        | عملية_عائمة_بدائية.ضرب_جمع_مدمج -> { أرجع «float-fma»; };
    }
    | هوية_بدائي_مترجم.ذري_حمل -> { أرجع «atomic-load»; }
    | هوية_بدائي_مترجم.ذري_خزن -> { أرجع «atomic-store»; }
    | هوية_بدائي_مترجم.ذري_تبديل -> { أرجع «atomic-swap»; }
    | هوية_بدائي_مترجم.ذري_قارن_وبدل -> { أرجع «atomic-compare-exchange»; }
    | هوية_بدائي_مترجم.ذري_جلب_جمع -> { أرجع «atomic-fetch-add»; }
    | هوية_بدائي_مترجم.ذري_جلب_و -> { أرجع «atomic-fetch-and»; }
    | هوية_بدائي_مترجم.ذري_جلب_أو -> { أرجع «atomic-fetch-or»; }
    | هوية_بدائي_مترجم.ذري_جلب_أو_حصري -> { أرجع «atomic-fetch-xor»; }
    | هوية_بدائي_مترجم.سياج_ذاكرة -> { أرجع «atomic-fence»; }
    | هوية_بدائي_مترجم.سرب_قيمة -> { أرجع «leak-value»; }
    | هوية_بدائي_مترجم.عنوان_دالة -> { أرجع «closure-address»; }
    | هوية_بدائي_مترجم.دالة_من_عنوان -> { أرجع «closure-from-address»; }
    | هوية_بدائي_مترجم.مدخل_سي_لدالة -> { أرجع «closure-c-entry»; }
    | هوية_بدائي_مترجم.استنساخ_خيط_نواة -> { أرجع «kernel-thread-clone»; }
    | هوية_بدائي_مترجم.نداء_عنوان_سي -> { أرجع «c-address-call»; }
    ;
}
