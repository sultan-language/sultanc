// Diagnostic classification is stable metadata, independent of presentation.
عام نوع فئة_تشخيص =
    | مستخدم
    | بيئة
    | داخلي
    // A compiler limitation that is neither the user's mistake nor an internal
    // failure (GCC's "sorry, unimplemented"). Shown in full, like a user error.
    | غير_منفذ
;

