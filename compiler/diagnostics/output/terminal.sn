استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.message;
استورد compiler.diagnostics.output.writer;
استورد compiler.diagnostics.schema;
استورد std.encoding.utf8;
استورد std.unicode.grapheme;

// Terminal output owns rich and compact terminal layout only.

عام نوع نمط_طرفية_تشخيص = {
    أنسي: منطقي,
    اعرض_المصدر: منطقي
};

عرف مفتاح_شدة(الشدة: شدة_تشخيص): مفتاح_صياغة {
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        أرجع مفتاح_صياغة.تسمية_خطأ();
    }
    | شدة_تشخيص.تحذير -> {
        أرجع مفتاح_صياغة.تسمية_تحذير();
    }
    | شدة_تشخيص.ملاحظة -> {
        أرجع مفتاح_صياغة.تسمية_ملاحظة();
    };
}

عرف ابدأ_لون_شدة(الشدة: شدة_تشخيص, النمط: نمط_طرفية_تشخيص): فراغ {
    إذا (!النمط.أنسي) {
        أرجع;
    };
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        اكتب_خطأ_داخلي("\x1b[1;31m");
    }
    | شدة_تشخيص.تحذير -> {
        اكتب_خطأ_داخلي("\x1b[1;33m");
    }
    | شدة_تشخيص.ملاحظة -> {
        اكتب_خطأ_داخلي("\x1b[1;36m");
    };
}

عرف أنه_لون(النمط: نمط_طرفية_تشخيص): فراغ {
    إذا (النمط.أنسي) {
        اكتب_خطأ_داخلي("\x1b[0m");
    };
}

عرف اكتب_هوية_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.اسم_المصدر مع
    | اختياري.موجود(الاسم) -> {
        اكتب_خطأ_مرجع_داخلي(&الاسم);
    }
    | اختياري.لا_شيء -> {
        اكتب_خطأ_داخلي(«<»);
        اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_مصدر()));
        اكتب_خطأ_داخلي(«#»);
        اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.المصدر);
        اكتب_خطأ_داخلي(«>»);
    };
}

عرف اكتب_إحداثي_مصدر(الإحداثي: إحداثي_مصدر): فراغ {
    اكتب_سطر_مصدر(الإحداثي.السطر);
    اكتب_خطأ_داخلي(«:»);
    اكتب_عمود_مصدر(الإحداثي.العمود);
}

عرف نطاق_مصدر_له_نهاية(النطاق: &نطاق): منطقي {
    دع الحالة: نطاق = *النطاق;
    أرجع (الحالة.البداية.المصدر == الحالة.النهاية.المصدر)
        && (الحالة.النهاية.البايت > الحالة.البداية.البايت);
}

عرف اكتب_موقع_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    اكتب_هوية_مصدر(اللغة, المصدر);
    طابق الحالة.بداية_العرض مع
    | اختياري.موجود(البداية) -> {
        اكتب_خطأ_داخلي(«:»);
        اكتب_إحداثي_مصدر(البداية);
        إذا (نطاق_مصدر_له_نهاية(&الحالة.النطاق)) {
            طابق الحالة.نهاية_العرض مع
            | اختياري.موجود(النهاية) -> {
                اكتب_خطأ_داخلي(«..»);
                اكتب_إحداثي_مصدر(النهاية);
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> {
        اكتب_خطأ_داخلي(«@»);
        اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.البايت);
    };
}

// The source line as Unicode scalars (columns count scalars), or none for
// bytes that are not UTF-8.
عرف سلالم_سطر_مقتطف(السطر: &نص): اختياري متجه ط32 {
    دع الناتج: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السطر) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(السطر, ف);
        إذا (!المفكوك.صالح || المفكوك.العرض == 0) { أرجع اختياري.لا_شيء(); };
        ألحق(الناتج, المفكوك.القيمة);
        ف := ف + المفكوك.العرض;
    }
    أرجع اختياري.موجود(الناتج);
}

// A scalar the snippet must not print as itself: a bidirectional embedding,
// override or isolate control (U+202A..202E, U+2066..2069, "Trojan Source",
// CVE-2021-42574), which would reorder the shown line, and a C0/C1 control or
// DEL other than a tab, which a terminal would act on. It is shown as its
// escape (`\u{202E}`), as rustc shows these characters in a snippet; the
// diagnostic's span and columns stay those of the source.
عرف محرف_مقتطف_مهرب(القيمة: ط32): منطقي {
    إذا ((القيمة >= 0x202A) && (القيمة <= 0x202E)) { أرجع صواب; };
    إذا ((القيمة >= 0x2066) && (القيمة <= 0x2069)) { أرجع صواب; };
    إذا (القيمة == 9) { أرجع خطأ; };
    إذا (القيمة < 0x20) { أرجع صواب; };
    أرجع (القيمة >= 0x7F) && (القيمة <= 0x9F);
}

عرف رقم_ست_عشري(القيمة: طبيعي): ط8 {
    إذا (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    أرجع (0x41 + القيمة - 10) مثل ط8;
}

// The hexadecimal digits of القيمة, at least الأدنى of them, appended.
عرف ألحق_ست_عشري_بخانات(الناتج: &متغير متجه ط8, القيمة: طبيعي, الأدنى: طبيعي): فراغ {
    دع الخانات: متغير متجه ط8 = [];
    دع الباقي: متغير طبيعي = القيمة;
    طالما (الباقي > 0 || (الطول(الخانات) مثل طبيعي) < الأدنى) {
        ألحق(الخانات, رقم_ست_عشري(الباقي % 16));
        الباقي := الباقي / 16;
    }
    دع ف: متغير طبيعي = الطول(الخانات) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        ألحق(*الناتج, الخانات[ف]);
    }
}

عرف تهريب_محرف_مقتطف(القيمة: ط32): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «\u{»);
    ألحق_ست_عشري_بخانات(&متغير الناتج, القيمة مثل طبيعي, 4);
    ألحق_بايتات_نص(&متغير الناتج, «}»);
    أرجع من_بايتات(&الناتج);
}

// A byte that is not part of a UTF-8 character, as `\xFF`.
عرف تهريب_بايت_مقتطف(البايت: ط8): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, «\x»);
    ألحق_ست_عشري_بخانات(&متغير الناتج, البايت مثل طبيعي, 2);
    أرجع من_بايتات(&الناتج);
}

// The cells a scalar takes in the shown line: its escape's, or one.
عرف خلايا_محرف_مقتطف(القيمة: ط32): طبيعي {
    إذا (محرف_مقتطف_مهرب(القيمة)) {
        أرجع الطول(تهريب_محرف_مقتطف(القيمة)) مثل طبيعي;
    };
    أرجع 1;
}

عرف سطر_يحتاج_تهريبا(السلالم: &متجه ط32): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السلالم) مثل طبيعي)) {
        إذا (محرف_مقتطف_مهرب((*السلالم)[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The shown line of a UTF-8 line: the source bytes, with every scalar that
// must not print as itself replaced by its escape. A line without one is
// written unchanged.
عرف اكتب_سطر_مقتطف_مهربا(السطر: &نص, السلالم: &متجه ط32): فراغ {
    إذا (!سطر_يحتاج_تهريبا(السلالم)) {
        اكتب_خطأ_مرجع_داخلي(السطر);
        أرجع;
    };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السطر) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(السطر, ف);
        إذا (محرف_مقتطف_مهرب(المفكوك.القيمة)) {
            ألحق_بايتات_نص(&متغير الناتج, تهريب_محرف_مقتطف(المفكوك.القيمة));
        } وإلا {
            دع ب: متغير طبيعي = 0;
            طالما (ب < المفكوك.العرض) {
                ألحق(الناتج, (*السطر)[ف + ب]);
                ب := ب + 1;
            }
        };
        ف := ف + المفكوك.العرض;
    }
    اكتب_خطأ_داخلي(من_بايتات(&الناتج));
}

// The caret line's indent: one space per extended grapheme cluster before
// the span (UAX #29), a tab where the line has a tab and the escape's width
// where the shown line has an escape, so the caret stands under the span
// however many scalars each letter takes.
عرف اكتب_إزاحة_علامات_بعناقيد(السلالم: &متجه ط32, الحدود: &متجه طبيعي, البداية: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < (الطول(*الحدود) مثل طبيعي) && (*الحدود)[ف + 1] <= البداية) {
        دع الأول: ط32 = (*السلالم)[(*الحدود)[ف]];
        إذا (الأول == 9) { اكتب_خطأ_داخلي("\t"); }
        وإلا { اكتب_مسافات(خلايا_محرف_مقتطف(الأول)); };
        ف := ف + 1;
    }
}

// The carets under the span: one per cluster ending in (البداية, النهاية],
// an escape taking its width. اكتب_علامات writes at least one.
عرف علامات_بعناقيد(السلالم: &متجه ط32, الحدود: &متجه طبيعي, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < (الطول(*الحدود) مثل طبيعي)) {
        دع حد_النهاية: طبيعي = (*الحدود)[ف + 1];
        إذا (حد_النهاية > البداية && حد_النهاية <= النهاية) {
            العدد := العدد + خلايا_محرف_مقتطف((*السلالم)[(*الحدود)[ف]]);
        };
        ف := ف + 1;
    }
    أرجع العدد;
}

// A line that is not UTF-8: each character or stray byte is one unit, a
// stray byte shown as `\xFF`. Columns count the bytes that do not continue
// a UTF-8 sequence (compiler/source/source_file.sn), so a unit's column is
// the count of such bytes before it. Writes the shown line, the gutter of
// the caret line and its indent and carets.
عرف اكتب_مقتطف_سطر_غير_صالح(السطر: &نص, البداية: طبيعي, النهاية: طبيعي, عرض_السطر: طبيعي): فراغ {
    // An empty span marks the unit at its column.
    دع آخر_عمود: متغير طبيعي = النهاية;
    إذا (آخر_عمود <= البداية) { آخر_عمود := البداية + 1; };
    دع المعروض: متغير متجه ط8 = [];
    دع الإزاحة: متغير متجه ط8 = [];
    دع العلامات: متغير طبيعي = 0;
    دع العمود: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السطر) مثل طبيعي)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(السطر, ف);
        دع الخلايا: متغير طبيعي = 1;
        دع العرض: متغير طبيعي = 1;
        دع عمود_الوحدة: طبيعي = العمود;
        دع البايت: ط8 = (*السطر)[ف];
        إذا (المفكوك.صالح && المفكوك.العرض > 0) {
            العرض := المفكوك.العرض;
            إذا (محرف_مقتطف_مهرب(المفكوك.القيمة)) {
                دع التهريب: نص = تهريب_محرف_مقتطف(المفكوك.القيمة);
                الخلايا := الطول(التهريب) مثل طبيعي;
                ألحق_بايتات_نص(&متغير المعروض, التهريب);
            } وإلا {
                دع ب: متغير طبيعي = 0;
                طالما (ب < العرض) { ألحق(المعروض, (*السطر)[ف + ب]); ب := ب + 1; }
            };
            العمود := العمود + 1;
        } وإلا {
            دع التهريب: نص = تهريب_بايت_مقتطف(البايت);
            الخلايا := الطول(التهريب) مثل طبيعي;
            ألحق_بايتات_نص(&متغير المعروض, التهريب);
            إذا (!بايت_استمرار_يوتيف8(البايت)) { العمود := العمود + 1; };
        };
        إذا (عمود_الوحدة < البداية) {
            دع خ: متغير طبيعي = 0;
            طالما (خ < الخلايا) {
                إذا (البايت == 9) { ألحق(الإزاحة, 9 مثل ط8); } وإلا { ألحق(الإزاحة, 0x20 مثل ط8); };
                خ := خ + 1;
            }
        } وإلا إذا (عمود_الوحدة < آخر_عمود) {
            العلامات := العلامات + الخلايا;
        };
        ف := ف + العرض;
    }
    اكتب_خطأ_داخلي(من_بايتات(&المعروض));
    اكتب_خطأ_داخلي("\n");
    اكتب_مسافات(عرض_السطر + 2);
    اكتب_خطأ_داخلي(«| »);
    اكتب_خطأ_داخلي(من_بايتات(&الإزاحة));
    اكتب_علامات(العلامات);
}

عرف اكتب_مقتطف_مصدر_بتسمية(
    المصدر: &نطاق_مصدر_تشخيص,
    التسمية: اختياري نص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.المقتطف مع
    | اختياري.موجود(السطر) -> {
        طابق الحالة.بداية_العرض مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(البداية) -> {
            دع عرض_السطر: طبيعي = عرض_رقم_سطر_مصدر(البداية.السطر);
            اكتب_مسافات(عرض_السطر + 2);
            اكتب_خطأ_داخلي("|\n");
            اكتب_خطأ_داخلي(« »);
            اكتب_سطر_مصدر(البداية.السطر);
            اكتب_خطأ_داخلي(« | »);
            دع عمود_البداية: طبيعي = البداية.العمود مثل طبيعي;
            دع عمود_النهاية: متغير طبيعي = عمود_البداية;
            طابق الحالة.نهاية_العرض مع
            | اختياري.موجود(النهاية) -> {
                إذا (
                    نطاق_مصدر_له_نهاية(&الحالة.النطاق)
                    && (البداية.السطر == النهاية.السطر)
                    && (النهاية.العمود > البداية.العمود)
                ) {
                    عمود_النهاية := النهاية.العمود مثل طبيعي;
                };
            }
            | اختياري.لا_شيء -> { };
            // Columns count scalars; the caret line counts grapheme
            // clusters of the shown line instead (a line that is not UTF-8
            // counts its characters and stray bytes).
            طابق سلالم_سطر_مقتطف(&السطر) مع
            | اختياري.موجود(السلالم) -> {
                اكتب_سطر_مقتطف_مهربا(&السطر, &السلالم);
                اكتب_خطأ_داخلي("\n");
                اكتب_مسافات(عرض_السطر + 2);
                اكتب_خطأ_داخلي(«| »);
                دع الحدود: متجه طبيعي = حدود_عناقيد_يونيكود(&السلالم);
                اكتب_إزاحة_علامات_بعناقيد(&السلالم, &الحدود, عمود_البداية);
                اكتب_علامات(علامات_بعناقيد(&السلالم, &الحدود, عمود_البداية, عمود_النهاية));
            }
            | اختياري.لا_شيء -> {
                اكتب_مقتطف_سطر_غير_صالح(&السطر, عمود_البداية, عمود_النهاية, عرض_السطر);
            };
            طابق التسمية مع
            | اختياري.موجود(النص) -> {
                اكتب_خطأ_داخلي(« »);
                اكتب_خطأ_مرجع_داخلي(&النص);
            }
            | اختياري.لا_شيء -> { };
            اكتب_خطأ_داخلي("\n");
            اكتب_مسافات(عرض_السطر + 2);
            اكتب_خطأ_داخلي("|\n");
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف اكتب_مقتطف_مصدر(المصدر: &نطاق_مصدر_تشخيص): فراغ {
    اكتب_مقتطف_مصدر_بتسمية(المصدر, اختياري.لا_شيء());
}

// Terminal layout for right-to-left messages: every quoted fact (`x86_64-linux`,
// `i32`, a path) is wrapped in a Unicode first-strong isolate (U+2068 … U+2069),
// so a left-to-right fact keeps its own order inside an Arabic sentence and the
// punctuation around it stays in place. Structured JSON output never gets
// these marks; English terminal output needs none.
عرف اعزل_الحقائق_المقتبسة(القيمة: &نص): نص {
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع فيها_علامة: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !فيها_علامة) {
        إذا ((*القيمة)[ف] == 0x60) { فيها_علامة := صواب; };
        ف := ف + 1;
    }
    إذا (!فيها_علامة) { أرجع انسخ_نص(القيمة); };
    دع الناتج: متغير متجه ط8 = [];
    دع داخل: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < العدد) {
        دع البايت: ط8 = (*القيمة)[ف];
        إذا (داخل && البايت == 0x5C && (ف + 1) < العدد) {
            // An escaped delimiter or backslash inside a quoted fact.
            ألحق(الناتج, البايت);
            ألحق(الناتج, (*القيمة)[ف + 1]);
            ف := ف + 2;
        } وإلا إذا (البايت == 0x60) {
            إذا (داخل) {
                ألحق(الناتج, البايت);
                ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA9 مثل ط8);
                داخل := خطأ;
            } وإلا {
                ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA8 مثل ط8);
                ألحق(الناتج, البايت);
                داخل := صواب;
            };
            ف := ف + 1;
        } وإلا {
            ألحق(الناتج, البايت);
            ف := ف + 1;
        };
    }
    إذا (داخل) { ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA9 مثل ط8); };
    أرجع من_بايتات(&الناتج);
}

عرف نص_طرفي_للغة(اللغة: لغة_تشخيص, القيمة: نص): نص {
    طابق اللغة مع
    | لغة_تشخيص.العربية -> { أرجع اعزل_الحقائق_المقتبسة(&القيمة); }
    | لغة_تشخيص.الإنجليزية -> { أرجع القيمة; };
}

عرف اكتب_تعليقا(
    اللغة: لغة_تشخيص,
    التسمية: مفتاح_صياغة,
    التعليق: &تعليق_تشخيص
): فراغ {
    اكتب_خطأ_داخلي(«  = »);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, التسمية));
    اكتب_خطأ_داخلي(«: »);
    دع النص: نص = نص_تعليق_تشخيص(اللغة, (*التعليق).المفتاح, &(*التعليق).الحجج);
    اكتب_خطأ_داخلي(نص_طرفي_للغة(اللغة, النص));
    اكتب_خطأ_داخلي("\n");
}

// The headline of a diagnostic as one text, without colors:
// `<severity>[<code>]: <message>`, with the quoted facts of an Arabic message
// isolated. The one frame for every printer of a diagnostic headline (the
// runtime failure frames of driver/program_failure_text.sn too).
عام عرف سطر_عنوان_تشخيص_طرفي(التشخيص: &تشخيص, اللغة: لغة_تشخيص): نص {
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص((*التشخيص).المعرف);
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الناتج, صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    ألحق_بايتات_نص(&متغير الناتج, «[»);
    ألحق_بايتات_نص(&متغير الناتج, انسخ_نص(&التعريف.الكود));
    ألحق_بايتات_نص(&متغير الناتج, «]: »);
    ألحق_بايتات_نص(&متغير الناتج, نص_طرفي_للغة(اللغة, نص_رسالة_تشخيص(التشخيص, اللغة)));
    أرجع من_بايتات(&الناتج);
}

عام عرف اعرض_تشخيصا_طرفيا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع الرسالة: نص = نص_طرفي_للغة(اللغة, نص_رسالة_تشخيص(التشخيص, اللغة));
    اكتب_خطأ_مرجع_داخلي(&الرسالة);
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");

    إذا (النمط.اعرض_المصدر) {
        طابق الحالة.المصدر_الرئيسي مع
        | اختياري.موجود(المصدر) -> {
            اكتب_خطأ_داخلي(«  --> »);
            اكتب_موقع_مصدر(اللغة, &المصدر);
            اكتب_خطأ_داخلي("\n");
            دع تسمية_الرئيسي: اختياري نص = تسمية_دور_نطاق(
                اللغة, الحالة.الدور_الرئيسي
            );
            اكتب_مقتطف_مصدر_بتسمية(&المصدر, تسمية_الرئيسي);
        }
        | اختياري.لا_شيء -> { };
    };

    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الحالة.النطاقات_المرتبطة) مثل طبيعي)) {
        دع تسمية_المرتبط: اختياري نص = تسمية_دور_نطاق(
            اللغة, الحالة.النطاقات_المرتبطة[ر].الدور
        );
        إذا (النمط.اعرض_المصدر) {
            اكتب_خطأ_داخلي(«  ::: »);
            اكتب_موقع_مصدر(اللغة, &الحالة.النطاقات_المرتبطة[ر].المصدر);
            اكتب_خطأ_داخلي("\n");
            اكتب_مقتطف_مصدر_بتسمية(
                &الحالة.النطاقات_المرتبطة[ر].المصدر, تسمية_المرتبط
            );
        } وإلا {
            طابق تسمية_المرتبط مع
            | اختياري.موجود(النص) -> {
                اكتب_خطأ_داخلي(«  = »);
                اكتب_خطأ_مرجع_داخلي(&النص);
                اكتب_خطأ_داخلي("\n");
            }
            | اختياري.لا_شيء -> { };
        };
        ر := ر + 1;
    }

    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الحالة.الملاحظات) مثل طبيعي)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_ملاحظة(),
            &الحالة.الملاحظات[م]
        );
        م := م + 1;
    }

    دع هـ: متغير طبيعي = 0;
    طالما (هـ < (الطول(الحالة.المساعدة) مثل طبيعي)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_مساعدة(),
            &الحالة.المساعدة[هـ]
        );
        هـ := هـ + 1;
    }

    // Fix edits are machine data for JSON/LSP. Human terminal output uses the
    // corresponding help text instead of exposing applicability metadata.

    // Detailed trace is intentionally reserved for structured machine output.
    اصرف_كتابة_التشخيص();
}

عام عرف اعرض_مجموعة_تشخيصات_طرفيا(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.التشخيصات) مثل طبيعي)) {
        إذا (ف > 0) {
            اكتب_خطأ_داخلي("\n");
        };
        اعرض_تشخيصا_طرفيا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

عام عرف اعرض_تشخيصا_مختصرا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    طابق الحالة.المصدر_الرئيسي مع
    | اختياري.موجود(المصدر) -> {
        اكتب_موقع_مصدر(اللغة, &المصدر);
        اكتب_خطأ_داخلي(«: »);
    }
    | اختياري.لا_شيء -> { };
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع الرسالة: نص = نص_طرفي_للغة(اللغة, نص_رسالة_تشخيص(التشخيص, اللغة));
    اكتب_خطأ_مرجع_داخلي(&الرسالة);
    اكتب_خطأ_داخلي(« [»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.النوع_الآلي);
    اكتب_خطأ_داخلي(«]»);
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");
    اصرف_كتابة_التشخيص();
}

عام عرف اعرض_مجموعة_تشخيصات_مختصرة(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.التشخيصات) مثل طبيعي)) {
        اعرض_تشخيصا_مختصرا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

