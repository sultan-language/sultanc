استورد std.text.from_bytes;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.message;
استورد compiler.diagnostics.output.writer;
استورد compiler.diagnostics.schema;

// Terminal output owns rich and compact terminal layout only.

عام نوع نمط_طرفية_تشخيص = {
    أنسي: منطقي,
    اعرض_المصدر: منطقي
};

عرف مفتاح_شدة(الشدة: شدة_تشخيص): مفتاح_صياغة {
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        أرجع مفتاح_صياغة.تسمية_خطأ();
    }
    | شدة_تشخيص.تحذير -> {
        أرجع مفتاح_صياغة.تسمية_تحذير();
    }
    | شدة_تشخيص.ملاحظة -> {
        أرجع مفتاح_صياغة.تسمية_ملاحظة();
    };
}

عرف ابدأ_لون_شدة(الشدة: شدة_تشخيص, النمط: نمط_طرفية_تشخيص): فراغ {
    لو (!النمط.أنسي) {
        أرجع;
    };
    طابق الشدة مع
    | شدة_تشخيص.خطأ -> {
        اكتب_خطأ_داخلي("\x1b[1;31m");
    }
    | شدة_تشخيص.تحذير -> {
        اكتب_خطأ_داخلي("\x1b[1;33m");
    }
    | شدة_تشخيص.ملاحظة -> {
        اكتب_خطأ_داخلي("\x1b[1;36m");
    };
}

عرف أنه_لون(النمط: نمط_طرفية_تشخيص): فراغ {
    لو (النمط.أنسي) {
        اكتب_خطأ_داخلي("\x1b[0m");
    };
}

عرف اكتب_هوية_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.اسم_المصدر مع
    | اختياري.موجود(الاسم) -> {
        اكتب_خطأ_مرجع_داخلي(&الاسم);
    }
    | اختياري.لا_شيء -> {
        اكتب_خطأ_داخلي(«<»);
        اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_صياغة.تسمية_مصدر()));
        اكتب_خطأ_داخلي(«#»);
        اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.المصدر);
        اكتب_خطأ_داخلي(«>»);
    };
}

عرف اكتب_إحداثي_مصدر(الإحداثي: إحداثي_مصدر): فراغ {
    اكتب_سطر_مصدر(الإحداثي.السطر);
    اكتب_خطأ_داخلي(«:»);
    اكتب_عمود_مصدر(الإحداثي.العمود);
}

عرف نطاق_مصدر_له_نهاية(النطاق: &نطاق): منطقي {
    دع الحالة: نطاق = *النطاق;
    أرجع (الحالة.البداية.المصدر == الحالة.النهاية.المصدر)
        && (الحالة.النهاية.البايت > الحالة.البداية.البايت);
}

عرف اكتب_موقع_مصدر(
    اللغة: لغة_تشخيص,
    المصدر: &نطاق_مصدر_تشخيص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    اكتب_هوية_مصدر(اللغة, المصدر);
    طابق الحالة.بداية_العرض مع
    | اختياري.موجود(البداية) -> {
        اكتب_خطأ_داخلي(«:»);
        اكتب_إحداثي_مصدر(البداية);
        لو (نطاق_مصدر_له_نهاية(&الحالة.النطاق)) {
            طابق الحالة.نهاية_العرض مع
            | اختياري.موجود(النهاية) -> {
                اكتب_خطأ_داخلي(«..»);
                اكتب_إحداثي_مصدر(النهاية);
            }
            | اختياري.لا_شيء -> { };
        };
    }
    | اختياري.لا_شيء -> {
        اكتب_خطأ_داخلي(«@»);
        اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.البايت);
    };
}

عرف اكتب_مقتطف_مصدر_بتسمية(
    المصدر: &نطاق_مصدر_تشخيص,
    التسمية: اختياري نص
): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    طابق الحالة.المقتطف مع
    | اختياري.موجود(السطر) -> {
        طابق الحالة.بداية_العرض مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(البداية) -> {
            دع عرض_السطر: طبيعي = عرض_رقم_سطر_مصدر(البداية.السطر);
            اكتب_مسافات(عرض_السطر + 2);
            اكتب_خطأ_داخلي("|\n");
            اكتب_خطأ_داخلي(« »);
            اكتب_سطر_مصدر(البداية.السطر);
            اكتب_خطأ_داخلي(« | »);
            اكتب_خطأ_مرجع_داخلي(&السطر);
            اكتب_خطأ_داخلي("\n");
            اكتب_مسافات(عرض_السطر + 2);
            اكتب_خطأ_داخلي(«| »);
            لو (البداية.العمود > 0) {
                اكتب_مسافات(البداية.العمود مثل طبيعي);
            };
            دع العرض: متغير طبيعي = 1;
            طابق الحالة.نهاية_العرض مع
            | اختياري.موجود(النهاية) -> {
                لو (
                    نطاق_مصدر_له_نهاية(&الحالة.النطاق)
                    && (البداية.السطر == النهاية.السطر)
                    && (النهاية.العمود > البداية.العمود)
                ) {
                    العرض := (النهاية.العمود - البداية.العمود) مثل طبيعي;
                };
            }
            | اختياري.لا_شيء -> { };
            اكتب_علامات(العرض);
            طابق التسمية مع
            | اختياري.موجود(النص) -> {
                اكتب_خطأ_داخلي(« »);
                اكتب_خطأ_مرجع_داخلي(&النص);
            }
            | اختياري.لا_شيء -> { };
            اكتب_خطأ_داخلي("\n");
            اكتب_مسافات(عرض_السطر + 2);
            اكتب_خطأ_داخلي("|\n");
        };
    }
    | اختياري.لا_شيء -> { };
}

عرف اكتب_مقتطف_مصدر(المصدر: &نطاق_مصدر_تشخيص): فراغ {
    اكتب_مقتطف_مصدر_بتسمية(المصدر, اختياري.لا_شيء());
}

// Terminal layout for right-to-left messages: every quoted fact (`x86_64-linux`,
// `i32`, a path) is wrapped in a Unicode first-strong isolate (U+2068 … U+2069),
// so a left-to-right fact keeps its own order inside an Arabic sentence and the
// punctuation around it stays in place. Structured JSON output never gets
// these marks; English terminal output needs none.
عرف اعزل_الحقائق_المقتبسة(القيمة: &نص): نص {
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع فيها_علامة: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !فيها_علامة) {
        لو ((*القيمة)[ف] == 0x60) { فيها_علامة := صواب; };
        ف := ف + 1;
    }
    لو (!فيها_علامة) { أرجع انسخ_نص(القيمة); };
    دع الناتج: متغير متجه ط8 = [];
    دع داخل: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < العدد) {
        دع البايت: ط8 = (*القيمة)[ف];
        لو (داخل && البايت == 0x5C && (ف + 1) < العدد) {
            // An escaped delimiter or backslash inside a quoted fact.
            ألحق(الناتج, البايت);
            ألحق(الناتج, (*القيمة)[ف + 1]);
            ف := ف + 2;
        } وإلا لو (البايت == 0x60) {
            لو (داخل) {
                ألحق(الناتج, البايت);
                ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA9 مثل ط8);
                داخل := خطأ;
            } وإلا {
                ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA8 مثل ط8);
                ألحق(الناتج, البايت);
                داخل := صواب;
            };
            ف := ف + 1;
        } وإلا {
            ألحق(الناتج, البايت);
            ف := ف + 1;
        };
    }
    لو (داخل) { ألحق(الناتج, 0xE2 مثل ط8); ألحق(الناتج, 0x81 مثل ط8); ألحق(الناتج, 0xA9 مثل ط8); };
    أرجع من_بايتات(&الناتج);
}

عرف نص_طرفي_للغة(اللغة: لغة_تشخيص, القيمة: نص): نص {
    طابق اللغة مع
    | لغة_تشخيص.العربية -> { أرجع اعزل_الحقائق_المقتبسة(&القيمة); }
    | لغة_تشخيص.الإنجليزية -> { أرجع القيمة; };
}

عرف اكتب_تعليقا(
    اللغة: لغة_تشخيص,
    التسمية: مفتاح_صياغة,
    التعليق: &تعليق_تشخيص
): فراغ {
    اكتب_خطأ_داخلي(«  = »);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, التسمية));
    اكتب_خطأ_داخلي(«: »);
    دع النص: نص = نص_تعليق_تشخيص(اللغة, (*التعليق).المفتاح, &(*التعليق).الحجج);
    اكتب_خطأ_داخلي(نص_طرفي_للغة(اللغة, النص));
    اكتب_خطأ_داخلي("\n");
}

عام عرف اعرض_تشخيصا_طرفيا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع الرسالة: نص = نص_طرفي_للغة(اللغة, نص_رسالة_تشخيص(التشخيص, اللغة));
    اكتب_خطأ_مرجع_داخلي(&الرسالة);
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");

    لو (النمط.اعرض_المصدر) {
        طابق الحالة.المصدر_الرئيسي مع
        | اختياري.موجود(المصدر) -> {
            اكتب_خطأ_داخلي(«  --> »);
            اكتب_موقع_مصدر(اللغة, &المصدر);
            اكتب_خطأ_داخلي("\n");
            دع تسمية_الرئيسي: اختياري نص = تسمية_دور_نطاق(
                اللغة, الحالة.الدور_الرئيسي
            );
            اكتب_مقتطف_مصدر_بتسمية(&المصدر, تسمية_الرئيسي);
        }
        | اختياري.لا_شيء -> { };
    };

    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الحالة.النطاقات_المرتبطة) مثل طبيعي)) {
        دع تسمية_المرتبط: اختياري نص = تسمية_دور_نطاق(
            اللغة, الحالة.النطاقات_المرتبطة[ر].الدور
        );
        لو (النمط.اعرض_المصدر) {
            اكتب_خطأ_داخلي(«  ::: »);
            اكتب_موقع_مصدر(اللغة, &الحالة.النطاقات_المرتبطة[ر].المصدر);
            اكتب_خطأ_داخلي("\n");
            اكتب_مقتطف_مصدر_بتسمية(
                &الحالة.النطاقات_المرتبطة[ر].المصدر, تسمية_المرتبط
            );
        } وإلا {
            طابق تسمية_المرتبط مع
            | اختياري.موجود(النص) -> {
                اكتب_خطأ_داخلي(«  = »);
                اكتب_خطأ_مرجع_داخلي(&النص);
                اكتب_خطأ_داخلي("\n");
            }
            | اختياري.لا_شيء -> { };
        };
        ر := ر + 1;
    }

    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الحالة.الملاحظات) مثل طبيعي)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_ملاحظة(),
            &الحالة.الملاحظات[م]
        );
        م := م + 1;
    }

    دع هـ: متغير طبيعي = 0;
    طالما (هـ < (الطول(الحالة.المساعدة) مثل طبيعي)) {
        اكتب_تعليقا(
            اللغة,
            مفتاح_صياغة.تسمية_مساعدة(),
            &الحالة.المساعدة[هـ]
        );
        هـ := هـ + 1;
    }

    // Fix edits are machine data for JSON/LSP. Human terminal output uses the
    // corresponding help text instead of exposing applicability metadata.

    // Detailed trace is intentionally reserved for structured machine output.
}

عام عرف اعرض_مجموعة_تشخيصات_طرفيا(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.التشخيصات) مثل طبيعي)) {
        لو (ف > 0) {
            اكتب_خطأ_داخلي("\n");
        };
        اعرض_تشخيصا_طرفيا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

عام عرف اعرض_تشخيصا_مختصرا(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    طابق الحالة.المصدر_الرئيسي مع
    | اختياري.موجود(المصدر) -> {
        اكتب_موقع_مصدر(اللغة, &المصدر);
        اكتب_خطأ_داخلي(«: »);
    }
    | اختياري.لا_شيء -> { };
    ابدأ_لون_شدة(التعريف.الشدة, النمط);
    اكتب_خطأ_داخلي(صياغة_تشخيص(اللغة, مفتاح_شدة(التعريف.الشدة)));
    اكتب_خطأ_داخلي(«[»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.الكود);
    اكتب_خطأ_داخلي(«]: »);
    دع الرسالة: نص = نص_طرفي_للغة(اللغة, نص_رسالة_تشخيص(التشخيص, اللغة));
    اكتب_خطأ_مرجع_داخلي(&الرسالة);
    اكتب_خطأ_داخلي(« [»);
    اكتب_خطأ_مرجع_داخلي(&التعريف.النوع_الآلي);
    اكتب_خطأ_داخلي(«]»);
    أنه_لون(النمط);
    اكتب_خطأ_داخلي("\n");
}

عام عرف اعرض_مجموعة_تشخيصات_مختصرة(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص,
    النمط: نمط_طرفية_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.التشخيصات) مثل طبيعي)) {
        اعرض_تشخيصا_مختصرا(&الحالة.التشخيصات[ف], اللغة, النمط);
        ف := ف + 1;
    }
}

