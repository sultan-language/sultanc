استورد std.text.from_bytes;
// Low-level diagnostic output writer. No diagnostic meaning lives here.
استورد std.io.print;


عام عرف اكتب_خطأ_داخلي(النص: نص): عدد {
    طابق اطبع_خطأ(النص) مع
    | نتيجة.نجح(المكتوب) -> { أرجع المكتوب; }
    | نتيجة.خطأ(الخطأ) -> { أرجع الخطأ; };
}

عام عرف اكتب_خطأ_مرجع_داخلي(النص: &نص): عدد {
    أرجع اكتب_خطأ_داخلي(انسخ_نص(النص));
}



عام عرف اكتب_رقما_تشخيصيا(القيمة: طبيعي): فراغ {
    لو (القيمة >= 10) {
        اكتب_رقما_تشخيصيا(القيمة / 10);
    };
    دع الرقم: طبيعي = القيمة % 10;
    لو (الرقم == 0) {
        اكتب_خطأ_داخلي(«0»);
    };
    لو (الرقم == 1) {
        اكتب_خطأ_داخلي(«1»);
    };
    لو (الرقم == 2) {
        اكتب_خطأ_داخلي(«2»);
    };
    لو (الرقم == 3) {
        اكتب_خطأ_داخلي(«3»);
    };
    لو (الرقم == 4) {
        اكتب_خطأ_داخلي(«4»);
    };
    لو (الرقم == 5) {
        اكتب_خطأ_داخلي(«5»);
    };
    لو (الرقم == 6) {
        اكتب_خطأ_داخلي(«6»);
    };
    لو (الرقم == 7) {
        اكتب_خطأ_داخلي(«7»);
    };
    لو (الرقم == 8) {
        اكتب_خطأ_داخلي(«8»);
    };
    لو (الرقم == 9) {
        اكتب_خطأ_داخلي(«9»);
    };
}

عام عرف اكتب_رقما_موقعا_تشخيصيا(القيمة: عدد): فراغ {
    لو (القيمة < 0) {
        اكتب_خطأ_داخلي(«-»);
        // Add one before negation so the minimum signed value is printable without overflow.
        دع دون_أدنى: عدد = 0 - (القيمة + 1);
        دع المقدار_الأولي: طبيعي = دون_أدنى مثل طبيعي;
        دع المقدار: طبيعي = المقدار_الأولي + 1;
        اكتب_رقما_تشخيصيا(المقدار);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(القيمة مثل طبيعي);
}

عام عرف عدد_خانات_رقم(القيمة: طبيعي): طبيعي {
    دع الباقي: متغير طبيعي = القيمة;
    دع الخانات: متغير طبيعي = 1;
    طالما (الباقي >= 10) {
        الباقي := الباقي / 10;
        الخانات := الخانات + 1;
    }
    أرجع الخانات;
}

عام عرف عرض_رقم_سطر_مصدر(السطر: ط32): طبيعي {
    لو (السطر < 1) {
        أرجع 1;
    };
    أرجع عدد_خانات_رقم(السطر مثل طبيعي);
}

عام عرف اكتب_مسافات(العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        اكتب_خطأ_داخلي(« »);
        ف := ف + 1;
    }
}

عام عرف اكتب_علامات(العدد: طبيعي): فراغ {
    دع النهاية: متغير طبيعي = العدد;
    لو (النهاية == 0) {
        النهاية := 1;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < النهاية) {
        اكتب_خطأ_داخلي(«^»);
        ف := ف + 1;
    }
}

عام عرف اكتب_سطر_مصدر(السطر: ط32): فراغ {
    لو (السطر < 1) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(السطر مثل طبيعي);
}

عام عرف اكتب_عمود_مصدر(العمود: ط32): فراغ {
    لو (العمود < 0) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    دع عمود_المصدر: طبيعي = العمود مثل طبيعي;
    اكتب_رقما_تشخيصيا(عمود_المصدر + 1);
}
