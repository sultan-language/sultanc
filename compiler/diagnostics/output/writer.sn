// Low-level diagnostic output writer. No diagnostic meaning lives here.
استورد std.io.print;


عام عرف اكتب_خطأ_داخلي(النص: نص): عدد {
    طابق اطبع_خطأ(النص) مع
    | نتيجة.نجح(المكتوب) -> { أرجع المكتوب; }
    | نتيجة.خطأ(الخطأ) -> { أرجع الخطأ; };
}

عام عرف اكتب_خطأ_مرجع_داخلي(النص: &نص): عدد {
    أرجع اكتب_خطأ_داخلي(*النص);
}



عام عرف اكتب_رقما_تشخيصيا(القيمة: غير_موقع): فراغ {
    لو (القيمة >= 10) {
        اكتب_رقما_تشخيصيا(القيمة / 10);
    };
    دع الرقم: غير_موقع = القيمة % 10;
    لو (الرقم == 0) {
        اكتب_خطأ_داخلي(«0»);
    };
    لو (الرقم == 1) {
        اكتب_خطأ_داخلي(«1»);
    };
    لو (الرقم == 2) {
        اكتب_خطأ_داخلي(«2»);
    };
    لو (الرقم == 3) {
        اكتب_خطأ_داخلي(«3»);
    };
    لو (الرقم == 4) {
        اكتب_خطأ_داخلي(«4»);
    };
    لو (الرقم == 5) {
        اكتب_خطأ_داخلي(«5»);
    };
    لو (الرقم == 6) {
        اكتب_خطأ_داخلي(«6»);
    };
    لو (الرقم == 7) {
        اكتب_خطأ_داخلي(«7»);
    };
    لو (الرقم == 8) {
        اكتب_خطأ_داخلي(«8»);
    };
    لو (الرقم == 9) {
        اكتب_خطأ_داخلي(«9»);
    };
}

عام عرف اكتب_رقما_موقعا_تشخيصيا(القيمة: عدد): فراغ {
    لو (القيمة < 0) {
        اكتب_خطأ_داخلي(«-»);
        // Add one before negation so the minimum signed value is printable without overflow.
        دع دون_أدنى: عدد = 0 - (القيمة + 1);
        دع المقدار_الأولي: غير_موقع = دون_أدنى مثل غير_موقع;
        دع المقدار: غير_موقع = المقدار_الأولي + 1;
        اكتب_رقما_تشخيصيا(المقدار);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(القيمة مثل غير_موقع);
}

عام عرف عدد_خانات_رقم(القيمة: غير_موقع): غير_موقع {
    دع الباقي: متغير غير_موقع = القيمة;
    دع الخانات: متغير غير_موقع = 1;
    بينما (الباقي >= 10) {
        الباقي := الباقي / 10;
        الخانات := الخانات + 1;
    }
    أرجع الخانات;
}

عام عرف عرض_رقم_سطر_مصدر(السطر: غ32): غير_موقع {
    لو (السطر < 1) {
        أرجع 1;
    };
    أرجع عدد_خانات_رقم(السطر مثل غير_موقع);
}

عام عرف اكتب_مسافات(العدد: غير_موقع): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        اكتب_خطأ_داخلي(« »);
        ف := ف + 1;
    }
}

عام عرف اكتب_علامات(العدد: غير_موقع): فراغ {
    دع النهاية: متغير غير_موقع = العدد;
    لو (النهاية == 0) {
        النهاية := 1;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < النهاية) {
        اكتب_خطأ_داخلي(«^»);
        ف := ف + 1;
    }
}

عام عرف اكتب_سطر_مصدر(السطر: غ32): فراغ {
    لو (السطر < 1) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(السطر مثل غير_موقع);
}

عام عرف اكتب_عمود_مصدر(العمود: غ32): فراغ {
    لو (العمود < 0) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    دع عمود_المصدر: غير_موقع = العمود مثل غير_موقع;
    اكتب_رقما_تشخيصيا(عمود_المصدر + 1);
}
