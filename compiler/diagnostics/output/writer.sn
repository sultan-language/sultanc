استورد std.text.from_bytes;
// Low-level diagnostic output writer. No diagnostic meaning lives here.
استورد std.io.print;
استورد std.text.number;


// Diagnostic text is collected here and written to standard error once per
// diagnostic (اصرف_كتابة_التشخيص, called by every renderer when it ends),
// instead of one write per fragment: a diagnostic took dozens of writes,
// one per digit of a line number.
دع مخزن_كتابة_التشخيص: متغير متجه ط8 = [];

عام عرف اكتب_خطأ_داخلي(النص: نص): عدد {
    دع العدد: عدد = الطول(النص) مثل عدد;
    غير_آمن { ألحق_بايتات_نص(&متغير مخزن_كتابة_التشخيص, النص); }
    أرجع العدد;
}

عام عرف اكتب_خطأ_مرجع_داخلي(النص: &نص): عدد {
    أرجع اكتب_خطأ_داخلي(انسخ_نص(النص));
}

// Writes the collected text and empties the buffer.
عام عرف اصرف_كتابة_التشخيص(): فراغ {
    دع المكتوب: متغير نص = «»;
    غير_آمن {
        إذا ((الطول(مخزن_كتابة_التشخيص) مثل طبيعي) == 0) { أرجع; };
        المكتوب := من_بايتات(&مخزن_كتابة_التشخيص);
        دع فارغ: متجه ط8 = [];
        مخزن_كتابة_التشخيص := فارغ;
    }
    دع النتيجة: نتيجة عدد, عدد = اطبع_خطأ(المكتوب);
}

عام عرف اكتب_رقما_تشخيصيا(القيمة: طبيعي): فراغ {
    اكتب_خطأ_داخلي(طبيعي_إلى_نص(القيمة));
}

عام عرف اكتب_رقما_موقعا_تشخيصيا(القيمة: عدد): فراغ {
    اكتب_خطأ_داخلي(عدد_إلى_نص(القيمة));
}

عام عرف عدد_خانات_رقم(القيمة: طبيعي): طبيعي {
    دع الباقي: متغير طبيعي = القيمة;
    دع الخانات: متغير طبيعي = 1;
    طالما (الباقي >= 10) {
        الباقي := الباقي / 10;
        الخانات := الخانات + 1;
    }
    أرجع الخانات;
}

عام عرف عرض_رقم_سطر_مصدر(السطر: ط32): طبيعي {
    إذا (السطر < 1) {
        أرجع 1;
    };
    أرجع عدد_خانات_رقم(السطر مثل طبيعي);
}

عام عرف اكتب_مسافات(العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        اكتب_خطأ_داخلي(« »);
        ف := ف + 1;
    }
}

عام عرف اكتب_علامات(العدد: طبيعي): فراغ {
    دع النهاية: متغير طبيعي = العدد;
    إذا (النهاية == 0) {
        النهاية := 1;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < النهاية) {
        اكتب_خطأ_داخلي(«^»);
        ف := ف + 1;
    }
}

عام عرف اكتب_سطر_مصدر(السطر: ط32): فراغ {
    إذا (السطر < 1) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    اكتب_رقما_تشخيصيا(السطر مثل طبيعي);
}

عام عرف اكتب_عمود_مصدر(العمود: ط32): فراغ {
    إذا (العمود < 0) {
        اكتب_خطأ_داخلي(«?»);
        أرجع;
    };
    دع عمود_المصدر: طبيعي = العمود مثل طبيعي;
    اكتب_رقما_تشخيصيا(عمود_المصدر + 1);
}
