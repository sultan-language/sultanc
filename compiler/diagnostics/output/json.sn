استورد std.json.escape;
استورد std.text.from_bytes;
استورد std.text.number;
استورد compiler.source.span;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.localization;
استورد compiler.diagnostics.message;
استورد compiler.diagnostics.output.writer;
استورد compiler.diagnostics.schema;
استورد compiler.source.source_file;
استورد std.encoding.utf8;
استورد compiler.ispeak.ispeak;
استورد compiler.diagnostics.suggestions;
استورد std.encoding.positions;

// JSON output is the stable structured diagnostic transport for tools and LSP bridges.

عرف اكتب_نص_جيسون(القيمة: &نص): فراغ {
    دع الناتج: متغير متجه ط8 = [];
    دع تجاهل: منطقي = ألحق_سلسلة_جسون_بنمط(
        &متغير الناتج, القيمة, نمط_هروب_سلسلة_جسون.تشخيص()
    );
    // Diagnostic mode is byte-preserving, so it cannot reject the input.
    اكتب_خطأ_داخلي(من_بايتات(&الناتج));
}

عرف مفتاح_حجة_آلي(المفتاح: مفتاح_حجة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_حجة_تشخيص.القيمة -> { أرجع «value»; }
    | مفتاح_حجة_تشخيص.المتوقع -> { أرجع «expected»; }
    | مفتاح_حجة_تشخيص.الاستبدال -> { أرجع «replacement»; }
    | مفتاح_حجة_تشخيص.الموجود -> { أرجع «found»; }
    | مفتاح_حجة_تشخيص.الفهرس -> { أرجع «index»; }
    | مفتاح_حجة_تشخيص.الطول -> { أرجع «length»; }
    | مفتاح_حجة_تشخيص.المجال -> { أرجع «range»; }
    | مفتاح_حجة_تشخيص.النمط -> { أرجع «pattern»; }
    | مفتاح_حجة_تشخيص.المسار -> { أرجع «path»; }
    | مفتاح_حجة_تشخيص.الرمز -> { أرجع «symbol»; }
    | مفتاح_حجة_تشخيص.النوع -> { أرجع «type»; }
    | مفتاح_حجة_تشخيص.السياق -> { أرجع «context»; }
    | مفتاح_حجة_تشخيص.المرحلة -> { أرجع «phase»; }
    | مفتاح_حجة_تشخيص.الهدف -> { أرجع «target»; }
    | مفتاح_حجة_تشخيص.الدالة -> { أرجع «function»; }
    | مفتاح_حجة_تشخيص.الكتلة -> { أرجع «block»; }
    | مفتاح_حجة_تشخيص.التعليمة -> { أرجع «instruction»; }
    | مفتاح_حجة_تشخيص.العملية -> { أرجع «operation»; }
    | مفتاح_حجة_تشخيص.البدائي -> { أرجع «primitive»; }
    | مفتاح_حجة_تشخيص.المصدر -> { أرجع «source»; }
    | مفتاح_حجة_تشخيص.الوجهة -> { أرجع «destination»; }
    | مفتاح_حجة_تشخيص.السبب -> { أرجع «reason»; };
}

عرف دور_نطاق_آلي(الدور: دور_نطاق_تشخيص): نص {
    طابق الدور مع
    | دور_نطاق_تشخيص.رئيسي -> { أرجع «primary»; }
    | دور_نطاق_تشخيص.استخدام_غير_صالح -> { أرجع «invalid-use»; }
    | دور_نطاق_تشخيص.أصل_النقل -> { أرجع «move-origin»; }
    | دور_نطاق_تشخيص.أصل_التحرير -> { أرجع «release-origin»; }
    | دور_نطاق_تشخيص.المالك_الأصلي -> { أرجع «original-owner»; }
    | دور_نطاق_تشخيص.استعارة_متعارضة -> { أرجع «conflicting-borrow»; }
    | دور_نطاق_تشخيص.موضع_متوقع -> { أرجع «expected-location»; }
    | دور_نطاق_تشخيص.اكتشاف_المحلل -> { أرجع «parser-found»; }
    | دور_نطاق_تشخيص.فاصلة_منقوطة_في_غير_موضعها -> { أرجع «misplaced-semicolon»; }
    | دور_نطاق_تشخيص.وجهة_فاصلة_منقوطة -> { أرجع «semicolon-destination»; }
    | دور_نطاق_تشخيص.عبارة_بلا_عملية -> { أرجع «statement-without-operation»; }
    | دور_نطاق_تشخيص.نمط_غير_قابل_للوصول -> { أرجع «unreachable-pattern»; }
    | دور_نطاق_تشخيص.تغطية_نمط_سابقة -> { أرجع «previous-pattern-coverage»; }
    | دور_نطاق_تشخيص.سياق_مرتبط -> { أرجع «related-context»; }
    | دور_نطاق_تشخيص.استدعاء_وقت_الترجمة -> { أرجع «comptime-call-site»; }
    | دور_نطاق_تشخيص.تصريح_غير_قابل_للتغيير -> { أرجع «immutable-declaration»; }
    | دور_نطاق_تشخيص.مضمن_من -> { أرجع «included-from»; }
    | دور_نطاق_تشخيص.تصريح_سابق -> { أرجع «previous-declaration»; };
}

عرف فئة_تشخيص_آلية(الفئة: فئة_تشخيص): نص {
    طابق الفئة مع
    | فئة_تشخيص.مستخدم -> { أرجع «user»; }
    | فئة_تشخيص.بيئة -> { أرجع «environment»; }
    | فئة_تشخيص.داخلي -> { أرجع «internal»; }
    | فئة_تشخيص.غير_منفذ -> { أرجع «unimplemented»; };
}

// Schema 3: every argument is {"key", "type", "value"} and "value" is always a
// string, in one place for every type. "type" names how to read it:
//   text       the fact as the producer gave it;
//   localized  compiler wording: "value" in the message language, plus "en" and "ar";
//   unsigned / signed  a decimal integer;
//   boolean    "true" or "false";
//   reason     the reason's stable machine key, plus "text" in the message language.
عرف اكتب_نوع_وقيمة_جيسون(النوع: نص, القيمة: &نص): فراغ {
    اكتب_خطأ_داخلي(",\"type\":"); اكتب_نص_جيسون(&النوع);
    اكتب_خطأ_داخلي(",\"value\":"); اكتب_نص_جيسون(القيمة);
}

عرف اكتب_ترجمتين_جيسون(الإنجليزية: &نص, العربية: &نص): فراغ {
    اكتب_خطأ_داخلي(",\"en\":"); اكتب_نص_جيسون(الإنجليزية);
    اكتب_خطأ_داخلي(",\"ar\":"); اكتب_نص_جيسون(العربية);
}

عرف نص_بلغة(اللغة: لغة_تشخيص, الإنجليزية: &نص, العربية: &نص): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع انسخ_نص(الإنجليزية); }
    | لغة_تشخيص.العربية -> { أرجع انسخ_نص(العربية); };
}

// Writes the fields after "key" of one argument object.
عرف اكتب_قيمة_حجة_جيسون(اللغة: لغة_تشخيص, القيمة: &قيمة_حجة_تشخيص): فراغ {
    طابق *القيمة مع
    | قيمة_حجة_تشخيص.نصية(النص) -> { اكتب_نوع_وقيمة_جيسون(«text», &النص); }
    | قيمة_حجة_تشخيص.ثنائية_اللغة(الإنجليزية, العربية) -> {
        دع المختار: نص = نص_بلغة(اللغة, &الإنجليزية, &العربية);
        اكتب_نوع_وقيمة_جيسون(«localized», &المختار);
        اكتب_ترجمتين_جيسون(&الإنجليزية, &العربية);
    }
    | قيمة_حجة_تشخيص.طبيعية(العدد) -> {
        دع النص: نص = طبيعي_إلى_نص(العدد);
        اكتب_نوع_وقيمة_جيسون(«unsigned», &النص);
    }
    | قيمة_حجة_تشخيص.موقعة(العدد) -> {
        دع النص: نص = عدد_إلى_نص(العدد);
        اكتب_نوع_وقيمة_جيسون(«signed», &النص);
    }
    | قيمة_حجة_تشخيص.منطقية(القيمة_المنطقية) -> {
        دع النص: متغير نص = «false»;
        إذا (القيمة_المنطقية) { النص := «true»; };
        اكتب_نوع_وقيمة_جيسون(«boolean», &النص);
    }
    | قيمة_حجة_تشخيص.سبب(السبب) -> {
        // Machine-readable output keeps the reason's stable machine key.
        دع المفتاح: نص = مفتاح_آلي_لسبب_تشخيص(السبب);
        اكتب_نوع_وقيمة_جيسون(«reason», &المفتاح);
        دع الوصف: نص = رسالة_تشخيص(اللغة, مفتاح_رسالة_تشخيص.سبب(السبب));
        اكتب_خطأ_داخلي(",\"text\":"); اكتب_نص_جيسون(&الوصف);
    }
    | قيمة_حجة_تشخيص.نص_مترجم(المفتاح) -> {
        دع الإنجليزية: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), المفتاح);
        دع العربية: نص = نص_المترجم(لغة_تشخيص.العربية(), المفتاح);
        دع المختار: نص = نص_بلغة(اللغة, &الإنجليزية, &العربية);
        اكتب_نوع_وقيمة_جيسون(«localized», &المختار);
        اكتب_ترجمتين_جيسون(&الإنجليزية, &العربية);
    };
}

عرف اكتب_حجج_جيسون(اللغة: لغة_تشخيص, الحجج: &متجه حجة_تشخيص): فراغ {
    اكتب_خطأ_داخلي(«[»);
    دع أ: متغير طبيعي = 0;
    طالما (أ < (الطول(*الحجج) مثل طبيعي)) {
        إذا (أ > 0) { اكتب_خطأ_داخلي(«,»); };
        دع المفتاح: نص = مفتاح_حجة_آلي((*الحجج)[أ].المفتاح);
        اكتب_خطأ_داخلي("{\"key\":"); اكتب_نص_جيسون(&المفتاح);
        اكتب_قيمة_حجة_جيسون(اللغة, &(*الحجج)[أ].القيمة); اكتب_خطأ_داخلي(«}»);
        أ := أ + 1;
    }
    اكتب_خطأ_داخلي(«]»);
}

// A note or help line: its text with the arguments composed in, and the
// arguments themselves.
عرف اكتب_تعليق_جيسون(اللغة: لغة_تشخيص, التعليق: &تعليق_تشخيص): فراغ {
    دع النص: نص = نص_تعليق_تشخيص(اللغة, (*التعليق).المفتاح, &(*التعليق).الحجج);
    اكتب_خطأ_داخلي("{\"message\":"); اكتب_نص_جيسون(&النص);
    اكتب_خطأ_داخلي(",\"arguments\":"); اكتب_حجج_جيسون(اللغة, &(*التعليق).الحجج);
    اكتب_خطأ_داخلي(«}»);
}

عرف رمز_لغة_جيسون(اللغة: لغة_تشخيص): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع «en»; }
    | لغة_تشخيص.العربية -> { أرجع «ar»; };
}

// The UTF-16 column (0-based) of the scalar column العمود of the shown
// source line, for editors and LSP clients: a scalar above U+FFFF takes two
// code units. None when the line is not UTF-8 or shorter than the column.
عرف عمود_يوتيف16_من_مقتطف(السطر: &نص, العمود: طبيعي): اختياري طبيعي {
    دع الوحدات: متغير طبيعي = 0;
    دع السلالم: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (السلالم < العمود) {
        إذا (ف >= (الطول(*السطر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(السطر, ف);
        إذا (!المفكوك.صالح || المفكوك.العرض == 0) { أرجع اختياري.لا_شيء(); };
        إذا (المفكوك.القيمة > 0xFFFF) { الوحدات := الوحدات + 2; } وإلا { الوحدات := الوحدات + 1; };
        السلالم := السلالم + 1;
        ف := ف + المفكوك.العرض;
    }
    أرجع اختياري.موجود(الوحدات);
}

// A 1-based UTF-16 column, like "column", or null.
عرف اكتب_عمود_يوتيف16_جيسون(المقتطف: &اختياري نص, الإحداثي: &اختياري إحداثي_مصدر, السطر_المطلوب: ط32): فراغ {
    طابق *المقتطف مع
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); }
    | اختياري.موجود(السطر) -> {
        طابق *الإحداثي مع
        | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); }
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع.السطر != السطر_المطلوب || الموضع.العمود < 0) {
                اكتب_خطأ_داخلي(«null»);
                أرجع;
            };
            طابق عمود_يوتيف16_من_مقتطف(&السطر, الموضع.العمود مثل طبيعي) مع
            | اختياري.موجود(العمود) -> { اكتب_رقما_تشخيصيا(العمود + 1); }
            | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        };
    };
}

// An edit's range as an LSP Range (0-based lines, UTF-16 characters), or
// null when either end is unknown.
عرف اكتب_موضع_لسب_جيسون(الموضع: &موضع_نصي_يوتيف16): فراغ {
    اكتب_خطأ_داخلي("{\"line\":"); اكتب_رقما_تشخيصيا((*الموضع).السطر);
    اكتب_خطأ_داخلي(",\"character\":"); اكتب_رقما_تشخيصيا((*الموضع).العمود);
    اكتب_خطأ_داخلي(«}»);
}

عرف اكتب_مدى_يوتيف16_جيسون(التعديل: &تعديل_اقتراح_تشخيص): فراغ {
    طابق (*التعديل).البداية مع
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); }
    | اختياري.موجود(البداية) -> {
        طابق (*التعديل).النهاية مع
        | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); }
        | اختياري.موجود(النهاية) -> {
            اكتب_خطأ_داخلي("{\"start\":"); اكتب_موضع_لسب_جيسون(&البداية);
            اكتب_خطأ_داخلي(",\"end\":"); اكتب_موضع_لسب_جيسون(&النهاية);
            اكتب_خطأ_داخلي(«}»);
        };
    };
}

عرف اكتب_نطاق_جيسون(المصدر: &نطاق_مصدر_تشخيص): فراغ {
    دع الحالة: نطاق_مصدر_تشخيص = *المصدر;
    اكتب_خطأ_داخلي("{\"file\":");
    طابق الحالة.اسم_المصدر مع
    | اختياري.موجود(الاسم) -> { اكتب_نص_جيسون(&الاسم); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(",\"source_id\":"); اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.المصدر);
    اكتب_خطأ_داخلي(",\"start_byte\":"); اكتب_رقما_تشخيصيا(الحالة.النطاق.البداية.البايت);
    اكتب_خطأ_داخلي(",\"end_byte\":"); اكتب_رقما_تشخيصيا(الحالة.النطاق.النهاية.البايت);
    اكتب_خطأ_داخلي(",\"line\":");
    طابق الحالة.بداية_العرض مع
    | اختياري.موجود(البداية) -> { اكتب_سطر_مصدر(البداية.السطر); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(",\"column\":");
    طابق الحالة.بداية_العرض مع
    | اختياري.موجود(البداية) -> { اكتب_عمود_مصدر(البداية.العمود); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(",\"end_line\":");
    طابق الحالة.نهاية_العرض مع
    | اختياري.موجود(النهاية) -> { اكتب_سطر_مصدر(النهاية.السطر); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(",\"end_column\":");
    طابق الحالة.نهاية_العرض مع
    | اختياري.موجود(النهاية) -> { اكتب_عمود_مصدر(النهاية.العمود); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    // Additive (schema 3): the same columns counted in UTF-16 code units, as
    // LSP positions are. The end column is given when the span ends on the
    // shown line, else null.
    دع سطر_البداية: متغير ط32 = 0;
    طابق الحالة.بداية_العرض مع
    | اختياري.موجود(البداية) -> { سطر_البداية := البداية.السطر; }
    | اختياري.لا_شيء -> { };
    // Exact when the span was built from its source (both ends, on any
    // line); otherwise derived from the shown line.
    اكتب_خطأ_داخلي(",\"column_utf16\":");
    طابق الحالة.بداية_يوتيف16 مع
    | اختياري.موجود(الموضع) -> { اكتب_رقما_تشخيصيا(الموضع.العمود + 1); }
    | اختياري.لا_شيء -> { اكتب_عمود_يوتيف16_جيسون(&الحالة.المقتطف, &الحالة.بداية_العرض, سطر_البداية); };
    اكتب_خطأ_داخلي(",\"end_column_utf16\":");
    طابق الحالة.نهاية_يوتيف16 مع
    | اختياري.موجود(الموضع) -> { اكتب_رقما_تشخيصيا(الموضع.العمود + 1); }
    | اختياري.لا_شيء -> { اكتب_عمود_يوتيف16_جيسون(&الحالة.المقتطف, &الحالة.نهاية_العرض, سطر_البداية); };
    اكتب_خطأ_داخلي(",\"snippet\":");
    طابق الحالة.المقتطف مع
    | اختياري.موجود(المقتطف) -> { اكتب_نص_جيسون(&المقتطف); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    اكتب_خطأ_داخلي(«}»);
}

عام عرف اعرض_تشخيصا_جيسون(
    التشخيص: &تشخيص,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: تشخيص = *التشخيص;
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الحالة.المعرف);
    دع الشدة: نص;
    طابق التعريف.الشدة مع
    | شدة_تشخيص.خطأ -> { الشدة := «error»; }
    | شدة_تشخيص.تحذير -> { الشدة := «warning»; }
    | شدة_تشخيص.ملاحظة -> { الشدة := «note»; };
    دع الرسالة: نص = نص_رسالة_تشخيص(التشخيص, اللغة);

    // Schema 3: "language", typed string argument values, notes and help as
    // objects with their arguments (2 had no language and mixed value types).
    دع رمز_اللغة: نص = رمز_لغة_جيسون(اللغة);
    اكتب_خطأ_داخلي("{\"schema\":3,\"language\":"); اكتب_نص_جيسون(&رمز_اللغة);
    اكتب_خطأ_داخلي(",\"id\":"); اكتب_نص_جيسون(&التعريف.الكود);
    اكتب_خطأ_داخلي(",\"kind\":"); اكتب_نص_جيسون(&التعريف.النوع_الآلي);
    اكتب_خطأ_داخلي(",\"severity\":"); اكتب_نص_جيسون(&الشدة);
    دع الفئة: نص = فئة_تشخيص_آلية(التعريف.الفئة);
    اكتب_خطأ_داخلي(",\"category\":"); اكتب_نص_جيسون(&الفئة);
    اكتب_خطأ_داخلي(",\"message\":"); اكتب_نص_جيسون(&الرسالة);
    اكتب_خطأ_داخلي(",\"primary_span\":");
    طابق الحالة.المصدر_الرئيسي مع
    | اختياري.موجود(المصدر) -> { اكتب_نطاق_جيسون(&المصدر); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
    دع الدور_الرئيسي_الآلي: نص = دور_نطاق_آلي(الحالة.الدور_الرئيسي);
    اكتب_خطأ_داخلي(",\"primary_role\":"); اكتب_نص_جيسون(&الدور_الرئيسي_الآلي);
    اكتب_خطأ_داخلي(",\"primary_label\":");
    دع تسمية_الرئيسي_جيسون: اختياري نص = تسمية_دور_نطاق(
        اللغة, الحالة.الدور_الرئيسي
    );
    طابق تسمية_الرئيسي_جيسون مع
    | اختياري.موجود(النص) -> { اكتب_نص_جيسون(&النص); }
    | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };

    اكتب_خطأ_داخلي(",\"arguments\":"); اكتب_حجج_جيسون(اللغة, &الحالة.الحجج);

    اكتب_خطأ_داخلي(",\"related_spans\":[");
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول(الحالة.النطاقات_المرتبطة) مثل طبيعي)) {
        إذا (ر > 0) { اكتب_خطأ_داخلي(«,»); };
        دع الدور: نص = دور_نطاق_آلي(الحالة.النطاقات_المرتبطة[ر].الدور);
        دع تسمية_المرتبط_جيسون: اختياري نص = تسمية_دور_نطاق(
            اللغة, الحالة.النطاقات_المرتبطة[ر].الدور
        );
        اكتب_خطأ_داخلي("{\"role\":"); اكتب_نص_جيسون(&الدور);
        اكتب_خطأ_داخلي(",\"label\":");
        طابق تسمية_المرتبط_جيسون مع
        | اختياري.موجود(النص) -> { اكتب_نص_جيسون(&النص); }
        | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        اكتب_خطأ_داخلي(",\"span\":");
        اكتب_نطاق_جيسون(&الحالة.النطاقات_المرتبطة[ر].المصدر); اكتب_خطأ_داخلي(«}»);
        ر := ر + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"dependencies\":[");
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(الحالة.الاعتمادات) مثل طبيعي)) {
        إذا (ع > 0) { اكتب_خطأ_داخلي(«,»); };
        اكتب_نطاق_جيسون(&الحالة.الاعتمادات[ع]);
        ع := ع + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"notes\":[");
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الحالة.الملاحظات) مثل طبيعي)) {
        إذا (م > 0) { اكتب_خطأ_داخلي(«,»); };
        اكتب_تعليق_جيسون(اللغة, &الحالة.الملاحظات[م]);
        م := م + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    اكتب_خطأ_داخلي(",\"help\":[");
    دع هـ: متغير طبيعي = 0;
    طالما (هـ < (الطول(الحالة.المساعدة) مثل طبيعي)) {
        إذا (هـ > 0) { اكتب_خطأ_داخلي(«,»); };
        اكتب_تعليق_جيسون(اللغة, &الحالة.المساعدة[هـ]);
        هـ := هـ + 1;
    }
    اكتب_خطأ_داخلي(«]»);

    // Each fix and its edits come from the suggestion API (suggestions.sn),
    // which the LSP server reads directly. Additive in schema 3: "key" (the
    // stable machine kind, or null) and each edit's "range_utf16".
    اكتب_خطأ_داخلي(",\"fixes\":[");
    دع ص: متغير طبيعي = 0;
    طالما (ص < (الطول(الحالة.الإصلاحات) مثل طبيعي)) {
        إذا (ص > 0) { اكتب_خطأ_داخلي(«,»); };
        دع الاقتراح: اقتراح_تشخيص = اقتراح_من_إصلاح(&الحالة.الإصلاحات[ص], اللغة);
        اكتب_خطأ_داخلي("{\"span\":"); اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].المصدر);
        اكتب_خطأ_داخلي(",\"replacement\":"); اكتب_نص_جيسون(&الحالة.الإصلاحات[ص].الاستبدال);
        اكتب_خطأ_داخلي(",\"message\":"); اكتب_نص_جيسون(&الاقتراح.الرسالة);
        اكتب_خطأ_داخلي(",\"applicability\":"); اكتب_نص_جيسون(&الاقتراح.القابلية_الآلية);
        اكتب_خطأ_داخلي(",\"key\":");
        طابق الاقتراح.النوع_الآلي مع
        | اختياري.موجود(النوع) -> { اكتب_نص_جيسون(&النوع); }
        | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        اكتب_خطأ_داخلي(",\"edits\":[");
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الاقتراح.التعديلات) مثل طبيعي)) {
            إذا (ت > 0) { اكتب_خطأ_داخلي(«,»); };
            اكتب_خطأ_داخلي("{\"span\":");
            إذا (ت == 0) {
                اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].المصدر);
            } وإلا {
                اكتب_نطاق_جيسون(&الحالة.الإصلاحات[ص].التعديلات_الإضافية[ت - 1].المصدر);
            };
            اكتب_خطأ_داخلي(",\"replacement\":"); اكتب_نص_جيسون(&الاقتراح.التعديلات[ت].الاستبدال);
            اكتب_خطأ_داخلي(",\"range_utf16\":"); اكتب_مدى_يوتيف16_جيسون(&الاقتراح.التعديلات[ت]);
            اكتب_خطأ_داخلي(«}»);
            ت := ت + 1;
        }
        اكتب_خطأ_داخلي(«]}»);
        ص := ص + 1;
    }
    اكتب_خطأ_داخلي("],\"trace\":[");
    دع ث: متغير طبيعي = 0;
    طالما (ث < (الطول(الحالة.الأثر) مثل طبيعي)) {
        إذا (ث > 0) { اكتب_خطأ_داخلي(«,»); };
        دع مرجع_مدخل: &مدخل_أثر_تشخيص = &الحالة.الأثر[ث];
        دع مدخل: مدخل_أثر_تشخيص = *مرجع_مدخل;
        دع رسالة_الأثر: نص = نص_تعليق_تشخيص(اللغة, مدخل.المفتاح, &مدخل.الحجج);
        اكتب_خطأ_داخلي("{\"message\":"); اكتب_نص_جيسون(&رسالة_الأثر);
        اكتب_خطأ_داخلي(",\"span\":");
        طابق مدخل.المصدر مع
        | اختياري.موجود(المصدر) -> { اكتب_نطاق_جيسون(&المصدر); }
        | اختياري.لا_شيء -> { اكتب_خطأ_داخلي(«null»); };
        اكتب_خطأ_داخلي(",\"arguments\":"); اكتب_حجج_جيسون(اللغة, &مدخل.الحجج);
        اكتب_خطأ_داخلي(«}»);
        ث := ث + 1;
    }
    اكتب_خطأ_داخلي("],\"trace_count\":"); اكتب_رقما_تشخيصيا(الطول(الحالة.الأثر) مثل طبيعي);
    اكتب_خطأ_داخلي("}\n");
    اصرف_كتابة_التشخيص();
}

عام عرف اعرض_مجموعة_تشخيصات_جيسون(
    المجموعة: &مجموعة_تشخيصات,
    اللغة: لغة_تشخيص
): فراغ {
    دع الحالة: مجموعة_تشخيصات = *المجموعة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالة.التشخيصات) مثل طبيعي)) {
        اعرض_تشخيصا_جيسون(&الحالة.التشخيصات[ف], اللغة);
        ف := ف + 1;
    }
}
