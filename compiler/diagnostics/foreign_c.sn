استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.number;
استورد std.text.search;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.reason;
استورد std.encoding.utf8;

// C diagnostics reported by Jisr (compiler/jisr) while a C import is read.
// The module loader receives only the generated module text, so Jisr hands
// its errors here; the next diagnostic emitted into any collection
// (engine.sn) emits them first, at the C file's line and column, before the
// SultanC errors that follow from the failed import.

عام نوع تشخيص_سي_معلق = {
    الكود: نص,
    الملف: نص,
    // 1-based line and column; 0 when the diagnostic has no position.
    السطر: طبيعي,
    العمود: طبيعي,
    الإنجليزية: نص,
    العربية: نص,
    // The C source line, shown under the location.
    المقتطف: نص
};

دع تشخيصات_سي_معلقة: متغير متجه تشخيص_سي_معلق = [];
دع عدد_تشخيصات_سي_المصدرة: متغير طبيعي = 0;
دع عداد_مواضع_سي: متغير طبيعي = 0;
// Typed C diagnostics (أبلغ_تشخيص_سي_منظم), already diagnostic records.
دع تشخيصات_سي_منظمة_جاهزة: متغير متجه تشخيص = [];

// Source identity of C locations: no compiler source has it (SourceMap
// stops below it, ط32_متحقق in compiler/source/span.sn).
عرف مصدر_ملفات_سي(): ط32 { أرجع 0xFFFFFFFF; }

// A C file read twice in one compilation reports its diagnostics once.
دع مفاتيح_تشخيصات_سي: متغير متجه نص = [];

عام عرف أبلغ_تشخيص_سي(التشخيص: تشخيص_سي_معلق): فراغ {
    دع الأجزاء: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&التشخيص.الكود));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&التشخيص.الملف));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, طبيعي_إلى_نص(التشخيص.السطر));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, طبيعي_إلى_نص(التشخيص.العمود));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&التشخيص.الإنجليزية));
    دع المفتاح: نص = الأجزاء مثل نص;
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(مفاتيح_تشخيصات_سي) مثل طبيعي)) {
            إذا (نصان_متساويان(&مفاتيح_تشخيصات_سي[ف], &المفتاح)) { أرجع; };
            ف := ف + 1;
        }
        ألحق(مفاتيح_تشخيصات_سي, المفتاح);
        ألحق(تشخيصات_سي_معلقة, التشخيص);
    }
}

عام عرف توجد_تشخيصات_سي_معلقة(): منطقي {
    دع العدد: متغير طبيعي = 0;
    غير_آمن {
        العدد := (الطول(تشخيصات_سي_معلقة) مثل طبيعي) + (الطول(تشخيصات_سي_منظمة_جاهزة) مثل طبيعي);
    }
    أرجع العدد > 0;
}

// Whether C diagnostics were emitted already (a compile-time failure that
// repeats them is then derived from them).
عام عرف صدرت_تشخيصات_سي(): منطقي { أرجع عدد_تشخيصات_سي_المصدرة > 0; }

// The pending C diagnostics as diagnostic records; the queue is emptied.
عام عرف اسحب_تشخيصات_سي(): متجه تشخيص {
    دع الناتج: متغير متجه تشخيص = [];
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(تشخيصات_سي_معلقة) مثل طبيعي)) {
            ألحق(الناتج, تشخيص_من_سي(&تشخيصات_سي_معلقة[ف]));
            ف := ف + 1;
        }
        دع فارغ: متجه تشخيص_سي_معلق = [];
        تشخيصات_سي_معلقة := فارغ;
        ف := 0;
        طالما (ف < (الطول(تشخيصات_سي_منظمة_جاهزة) مثل طبيعي)) {
            ألحق(الناتج, انسخ_مملوكا_تشخيص(&تشخيصات_سي_منظمة_جاهزة[ف]));
            ف := ف + 1;
        }
        دع فارغ_منظم: متجه تشخيص = [];
        تشخيصات_سي_منظمة_جاهزة := فارغ_منظم;
    }
    عدد_تشخيصات_سي_المصدرة := عدد_تشخيصات_سي_المصدرة + (الطول(الناتج) مثل طبيعي);
    أرجع الناتج;
}

عرف تشخيص_من_سي(المعلق: &تشخيص_سي_معلق): تشخيص {
    // A code the registry does not know is a compiler fault, not a C
    // syntax error: it is reported as an internal failure of the Jisr phase,
    // with Jisr's text and the code kept as facts.
    دع المعرف: متغير معرف_تشخيص = معرف_تشخيص.فشل_مترجم_داخلي();
    دع كود_معروف: متغير منطقي = خطأ;
    طابق معرف_تشخيص_من_كود(&(*المعلق).الكود) مع
    | اختياري.موجود(القيمة) -> {
        إذا (هو_تشخيص_سي(القيمة)) { المعرف := القيمة; كود_معروف := صواب; };
    }
    | اختياري.لا_شيء -> { };
    دع المصدر: متغير اختياري نطاق_مصدر_تشخيص = اختياري.لا_شيء();
    إذا ((الطول((*المعلق).الملف) مثل طبيعي) > 0) {
        // A distinct byte per diagnostic, so the engine never merges two C
        // diagnostics of one code as repeats.
        عداد_مواضع_سي := عداد_مواضع_سي + 1;
        دع البايت: ط32 = ط32_متحقق(عداد_مواضع_سي);
        دع البداية: موضع = { المصدر: مصدر_ملفات_سي(), البايت: البايت };
        دع النهاية: موضع = { المصدر: مصدر_ملفات_سي(), البايت: البايت };
        دع المقتطف: متغير اختياري نص = اختياري.لا_شيء();
        إذا ((الطول((*المعلق).المقتطف) مثل طبيعي) > 0 && (*المعلق).السطر > 0) {
            المقتطف := اختياري.موجود(انسخ_نص(&(*المعلق).المقتطف));
        };
        دع النطاق_المصدري: متغير نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
            نطاق_بين(البداية, النهاية), اختياري.موجود(انسخ_نص(&(*المعلق).الملف)), المقتطف
        );
        إذا ((*المعلق).السطر > 0) {
            دع العمود: طبيعي = (*المعلق).العمود;
            دع الإحداثي: إحداثي_مصدر = {
                السطر: (*المعلق).السطر مثل ط32,
                العمود: (عمود_عرض_سي(العمود)) مثل ط32
            };
            النطاق_المصدري.بداية_العرض := اختياري.موجود(الإحداثي);
        };
        المصدر := اختياري.موجود(النطاق_المصدري);
    };
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, المصدر);
    إذا (!كود_معروف) {
        دع أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «jisr»);
        دع أضيف_الكود: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), انسخ_نص(&(*المعلق).الكود));
    };
    دع أضيف: منطقي = أضف_حجة_ثنائية_اللغة(
        &متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(),
        انسخ_نص(&(*المعلق).الإنجليزية), انسخ_نص(&(*المعلق).العربية)
    );
    أرجع التشخيص;
}

// A 1-based column as the 0-based display column.
عرف عمود_عرض_سي(العمود: طبيعي): طبيعي {
    إذا (العمود > 0) { أرجع العمود - 1; };
    أرجع 0;
}

// Whether التشخيص is a compile-time failure that only repeats C
// diagnostics already emitted (Jisr's generated module fails with them).
عام عرف فشل_وقت_ترجمة_مشتق_من_سي(التشخيص: &تشخيص): منطقي {
    إذا (!صدرت_تشخيصات_سي()) { أرجع خطأ; };
    إذا ((*التشخيص).المعرف != معرف_تشخيص.فشل_وقت_الترجمة_مطلوب()) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التشخيص).الحجج) مثل طبيعي)) {
        طابق (*التشخيص).الحجج[ف].القيمة مع
        | قيمة_حجة_تشخيص.نصية(النص) -> {
            إذا (يبدأ_بـ_كود_سي(&النص)) { أرجع صواب; };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف يبدأ_بـ_كود_سي(النص: &نص): منطقي {
    دع البادئة: نص = «SULTANC-C-»;
    أرجع يبدأ_بـ(النص, &البادئة);
}

// ---- Typed C diagnostics ----
// Jisr reports what it found: the typed identity (one of معرف_تشخيص.سي_*),
// one typed C reason (reason.sn, سبب_سي_*), the facts as typed arguments
// with the shared keys (الرمز: a C spelling, النوع: C type text,
// المتوقع/الموجود: expected and found token or count, القيمة: literal text,
// المسار: an include path), the C location and related locations. iSpeak
// owns every word. Severity comes from the registry.

// A C location. العمود is the 1-based BYTE column Jisr counts and الطول the
// source bytes the range covers on that line (0: a point); المقتطف is that
// source line. Display (character), UTF-8 and UTF-16 columns are all derived
// from the line here and in the outputs, so the line is the one truth.
عام نوع موقع_سي = {
    الملف: نص,
    السطر: طبيعي,
    العمود: طبيعي,
    الطول: طبيعي,
    المقتطف: نص
};

عام نوع موقع_سي_مرتبط = {
    الموقع: موقع_سي,
    الدور: دور_نطاق_تشخيص
};

عام نوع تشخيص_سي_منظم = {
    المعرف: معرف_تشخيص,
    السبب: سبب_تشخيص,
    الموقع: موقع_سي,
    الحجج: متجه حجة_تشخيص,
    // An earlier declaration (دور_نطاق_تشخيص.تصريح_سابق), a macro definition
    // (سياق_مرتبط).
    المرتبطة: متجه موقع_سي_مرتبط,
    // The `#include` sites that brought the file in, innermost first.
    سلسلة_التضمين: متجه موقع_سي
};

عام عرف موقع_سي_جديد(الملف: نص, السطر: طبيعي, العمود: طبيعي, الطول: طبيعي, المقتطف: نص): موقع_سي {
    دع الناتج: موقع_سي = {
        الملف: الملف, السطر: السطر, العمود: العمود, الطول: الطول, المقتطف: المقتطف
    };
    أرجع الناتج;
}

// A location with no file: an environment diagnostic (no C headers).
عام عرف موقع_سي_فارغ(): موقع_سي {
    أرجع موقع_سي_جديد(«», 0, 0, 0, «»);
}

عام عرف تشخيص_سي_منظم_جديد(
    المعرف: معرف_تشخيص,
    السبب: سبب_تشخيص,
    الموقع: موقع_سي
): تشخيص_سي_منظم {
    دع الحجج: متجه حجة_تشخيص = [];
    دع المرتبطة: متجه موقع_سي_مرتبط = [];
    دع السلسلة: متجه موقع_سي = [];
    دع الناتج: تشخيص_سي_منظم = {
        المعرف: المعرف, السبب: السبب, الموقع: الموقع, الحجج: الحجج,
        المرتبطة: المرتبطة, سلسلة_التضمين: السلسلة
    };
    أرجع الناتج;
}

عرف أضف_حجة_سي(التشخيص: &متغير تشخيص_سي_منظم, المفتاح: مفتاح_حجة_تشخيص, القيمة: قيمة_حجة_تشخيص): فراغ {
    دع الحجة: حجة_تشخيص = { المفتاح: المفتاح, القيمة: القيمة };
    ألحق((*التشخيص).الحجج, الحجة);
}

// The facts: one call each.
عام عرف أضف_رمز_سي(التشخيص: &متغير تشخيص_سي_منظم, الرمز: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.الرمز(), قيمة_حجة_تشخيص.نصية(الرمز));
}
عام عرف أضف_نوع_سي(التشخيص: &متغير تشخيص_سي_منظم, النوع: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.النوع(), قيمة_حجة_تشخيص.نصية(النوع));
}
عام عرف أضف_متوقع_سي(التشخيص: &متغير تشخيص_سي_منظم, المتوقع: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), قيمة_حجة_تشخيص.نصية(المتوقع));
}
عام عرف أضف_موجود_سي(التشخيص: &متغير تشخيص_سي_منظم, الموجود: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), قيمة_حجة_تشخيص.نصية(الموجود));
}
// Counts (call and macro arguments): the expected and the given number.
عام عرف أضف_عددين_سي(التشخيص: &متغير تشخيص_سي_منظم, المتوقع: طبيعي, الموجود: طبيعي): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.المتوقع(), قيمة_حجة_تشخيص.طبيعية(المتوقع));
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.الموجود(), قيمة_حجة_تشخيص.طبيعية(الموجود));
}
عام عرف أضف_قيمة_سي(التشخيص: &متغير تشخيص_سي_منظم, القيمة: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.القيمة(), قيمة_حجة_تشخيص.نصية(القيمة));
}
// A size or width in bytes or bits (long double size, bit-field width).
عام عرف أضف_طول_سي(التشخيص: &متغير تشخيص_سي_منظم, الطول: طبيعي): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.الطول(), قيمة_حجة_تشخيص.طبيعية(الطول));
}
عام عرف أضف_مسار_سي(التشخيص: &متغير تشخيص_سي_منظم, المسار: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.المسار(), قيمة_حجة_تشخيص.نصية(المسار));
}
عام عرف أضف_هدف_سي(التشخيص: &متغير تشخيص_سي_منظم, الهدف: نص): فراغ {
    أضف_حجة_سي(التشخيص, مفتاح_حجة_تشخيص.الهدف(), قيمة_حجة_تشخيص.نصية(الهدف));
}
عام عرف أضف_موقعا_مرتبطا_سي(التشخيص: &متغير تشخيص_سي_منظم, الموقع: موقع_سي, الدور: دور_نطاق_تشخيص): فراغ {
    دع المرتبط: موقع_سي_مرتبط = { الموقع: الموقع, الدور: الدور };
    ألحق((*التشخيص).المرتبطة, المرتبط);
}
عام عرف أضف_موقع_تضمين_سي(التشخيص: &متغير تشخيص_سي_منظم, الموقع: موقع_سي): فراغ {
    ألحق((*التشخيص).سلسلة_التضمين, الموقع);
}

// The 0-based character column of the 1-based byte column العمود on the
// line المقتطف (the bytes before it that start a character); without the
// line, the byte column itself.
عرف عمود_حرفي_سي(المقتطف: &نص, العمود: طبيعي): طبيعي {
    إذا (العمود == 0) { أرجع 0; };
    دع البايتات: طبيعي = العمود - 1;
    دع ن: طبيعي = الطول(*المقتطف) مثل طبيعي;
    إذا (ن == 0) { أرجع البايتات; };
    دع الأعمدة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البايتات) {
        إذا (ف >= ن || !بايت_استمرار_يوتيف8((*المقتطف)[ف])) { الأعمدة := الأعمدة + 1; };
        ف := ف + 1;
    }
    أرجع الأعمدة;
}

// The diagnostic span of a C location: a distinct byte of the C SourceID
// (0xFFFFFFFF) per span, so the engine never merges two C diagnostics as
// repeats, the file name, the line and the character columns.
عرف نطاق_تشخيص_من_موقع_سي(الموقع: &موقع_سي): اختياري نطاق_مصدر_تشخيص {
    إذا ((الطول((*الموقع).الملف) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع البايت: متغير ط32 = 0;
    غير_آمن {
        عداد_مواضع_سي := عداد_مواضع_سي + 1;
        البايت := ط32_متحقق(عداد_مواضع_سي);
    }
    دع البداية: موضع = { المصدر: مصدر_ملفات_سي(), البايت: البايت };
    دع النهاية: موضع = { المصدر: مصدر_ملفات_سي(), البايت: البايت };
    دع المقتطف: متغير اختياري نص = اختياري.لا_شيء();
    إذا ((الطول((*الموقع).المقتطف) مثل طبيعي) > 0 && (*الموقع).السطر > 0) {
        المقتطف := اختياري.موجود(انسخ_نص(&(*الموقع).المقتطف));
    };
    دع النطاق_المصدري: متغير نطاق_مصدر_تشخيص = نطاق_مصدر_تشخيص_بأصل(
        نطاق_بين(البداية, النهاية), اختياري.موجود(انسخ_نص(&(*الموقع).الملف)), المقتطف
    );
    إذا ((*الموقع).السطر > 0) {
        دع البداية_حرفيا: طبيعي = عمود_حرفي_سي(&(*الموقع).المقتطف, (*الموقع).العمود);
        دع الإحداثي: إحداثي_مصدر = {
            السطر: ط32_متحقق((*الموقع).السطر), العمود: ط32_متحقق(البداية_حرفيا)
        };
        النطاق_المصدري.بداية_العرض := اختياري.موجود(الإحداثي);
        إذا ((*الموقع).الطول > 0 && (*الموقع).العمود > 0) {
            دع النهاية_حرفيا: طبيعي = عمود_حرفي_سي(
                &(*الموقع).المقتطف, (*الموقع).العمود + (*الموقع).الطول
            );
            إذا (النهاية_حرفيا > البداية_حرفيا) {
                دع إحداثي_النهاية: إحداثي_مصدر = {
                    السطر: ط32_متحقق((*الموقع).السطر), العمود: ط32_متحقق(النهاية_حرفيا)
                };
                النطاق_المصدري.نهاية_العرض := اختياري.موجود(إحداثي_النهاية);
            };
        };
    };
    أرجع اختياري.موجود(النطاق_المصدري);
}

عرف مفتاح_تشخيص_سي_منظم(التشخيص: &تشخيص_سي_منظم): نص {
    دع الأجزاء: متغير متجه ط8 = [];
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص((*التشخيص).المعرف);
    ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&التعريف.الكود));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, مفتاح_آلي_لسبب_تشخيص((*التشخيص).السبب));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&(*التشخيص).الموقع.الملف));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, طبيعي_إلى_نص((*التشخيص).الموقع.السطر));
    ألحق(الأجزاء, 0);
    ألحق_بايتات_نص(&متغير الأجزاء, طبيعي_إلى_نص((*التشخيص).الموقع.العمود));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التشخيص).الحجج) مثل طبيعي)) {
        ألحق(الأجزاء, 0);
        طابق (*التشخيص).الحجج[ف].القيمة مع
        | قيمة_حجة_تشخيص.نصية(النص) -> { ألحق_بايتات_نص(&متغير الأجزاء, انسخ_نص(&النص)); }
        | قيمة_حجة_تشخيص.طبيعية(العدد) -> { ألحق_بايتات_نص(&متغير الأجزاء, طبيعي_إلى_نص(العدد)); }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الأجزاء مثل نص;
}

// The diagnostic record of a typed C diagnostic, under المعرف and السبب.
عرف سجل_من_تشخيص_سي_منظم(التشخيص: &تشخيص_سي_منظم, المعرف: معرف_تشخيص, السبب: سبب_تشخيص): تشخيص {
    دع السجل: متغير تشخيص = ابدأ_تشخيصا(المعرف, نطاق_تشخيص_من_موقع_سي(&(*التشخيص).الموقع));
    دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير السجل, السبب);
    دع ر: متغير طبيعي = 0;
    طالما (ر < (الطول((*التشخيص).المرتبطة) مثل طبيعي)) {
        طابق نطاق_تشخيص_من_موقع_سي(&(*التشخيص).المرتبطة[ر].الموقع) مع
        | اختياري.موجود(المصدر) -> {
            دع أضيف: منطقي = أضف_نطاقا_مرتبطا(&متغير السجل, المصدر, (*التشخيص).المرتبطة[ر].الدور);
        }
        | اختياري.لا_شيء -> { };
        ر := ر + 1;
    }
    دع س: متغير طبيعي = 0;
    طالما (س < (الطول((*التشخيص).سلسلة_التضمين) مثل طبيعي)) {
        طابق نطاق_تشخيص_من_موقع_سي(&(*التشخيص).سلسلة_التضمين[س]) مع
        | اختياري.موجود(المصدر) -> {
            دع أضيف: منطقي = أضف_نطاقا_مرتبطا(&متغير السجل, المصدر, دور_نطاق_تشخيص.مضمن_من());
        }
        | اختياري.لا_شيء -> { };
        س := س + 1;
    }
    أرجع السجل;
}

// Whether this report was made already (a C file read twice); records it.
عرف تشخيص_سي_منظم_مكرر(التشخيص: &تشخيص_سي_منظم): منطقي {
    دع المفتاح: نص = مفتاح_تشخيص_سي_منظم(التشخيص);
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(مفاتيح_تشخيصات_سي) مثل طبيعي)) {
            إذا (نصان_متساويان(&مفاتيح_تشخيصات_سي[ف], &المفتاح)) { أرجع صواب; };
            ف := ف + 1;
        }
        ألحق(مفاتيح_تشخيصات_سي, المفتاح);
    }
    أرجع خطأ;
}

// Hands a typed C diagnostic to the compiler's diagnostics. The same
// diagnostic of a C file read twice is reported once.
عام عرف أبلغ_تشخيص_سي_منظم(التشخيص: تشخيص_سي_منظم): فراغ {
    إذا (تشخيص_سي_منظم_مكرر(&التشخيص)) { أرجع; };
    دع السجل: متغير تشخيص = سجل_من_تشخيص_سي_منظم(&التشخيص, التشخيص.المعرف, التشخيص.السبب);
    دع ح: متغير طبيعي = 0;
    طالما (ح < (الطول(التشخيص.الحجج) مثل طبيعي)) {
        ألحق(السجل.الحجج, انسخ_مملوكا_حجة_تشخيص(&التشخيص.الحجج[ح]));
        ح := ح + 1;
    }
    غير_آمن { ألحق(تشخيصات_سي_منظمة_جاهزة, السجل); }
}

// A C error met in a header the import only reads (none of its declarations
// is written, so the import does not fail on it): reported as the warning
// SULTANC-C-READ-HEADER-UNTRANSLATED at the error's location, and the error
// itself (its C reason, its public code and its facts) as a note, so nothing
// is hidden; JSON carries the inner code and reason in the note's arguments.
// The identity decides the severity; no report overrides it.
عام عرف أبلغ_تشخيص_سي_منظم_في_ترويسة_مقروءة(الداخلي: تشخيص_سي_منظم): فراغ {
    إذا (تشخيص_سي_منظم_مكرر(&الداخلي)) { أرجع; };
    دع السجل: متغير تشخيص = سجل_من_تشخيص_سي_منظم(
        &الداخلي, معرف_تشخيص.سي_ترويسة_مقروءة_غير_مترجمة(),
        سبب_تشخيص.سبب_سي_ترويسة_مقروءة_غير_مترجمة()
    );
    دع الحجج: متغير متجه حجة_تشخيص = [];
    دع حجة_السبب: حجة_تشخيص = { المفتاح: مفتاح_حجة_تشخيص.السبب(), القيمة: قيمة_حجة_تشخيص.سبب(الداخلي.السبب) };
    ألحق(الحجج, حجة_السبب);
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الداخلي.المعرف);
    دع حجة_الكود: حجة_تشخيص = { المفتاح: مفتاح_حجة_تشخيص.السياق(), القيمة: قيمة_حجة_تشخيص.نصية(انسخ_نص(&التعريف.الكود)) };
    ألحق(الحجج, حجة_الكود);
    دع ح: متغير طبيعي = 0;
    طالما (ح < (الطول(الداخلي.الحجج) مثل طبيعي)) {
        ألحق(الحجج, انسخ_مملوكا_حجة_تشخيص(&الداخلي.الحجج[ح]));
        ح := ح + 1;
    }
    دع أضيفت: منطقي = أضف_ملاحظة(&متغير السجل, مفتاح_صياغة.ملاحظة_خطأ_سي_غير_مترجم(), الحجج);
    غير_آمن { ألحق(تشخيصات_سي_منظمة_جاهزة, السجل); }
}
