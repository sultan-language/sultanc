استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.relocation_model;

// Debug information is a view over canonical input sections. It never owns a
// second copy of DWARF bytes or producer-side relocation metadata.
عام عرف معرفات_أقسام_التصحيح_للربط(
    السياق: &سياق_ربط
): متجه معرف_قسم_ربط {
    دع المعرفات: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        طابق (*القسم).الصنف مع
        | صنف_قسم_ربط.تصحيح -> {
            ألحق(المعرفات, (*القسم).المعرف);
        }
        | _ -> { };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع المعرفات;
}

عام عرف معرفات_أقسام_تصحيح_مدخل_للربط(
    السياق: &سياق_ربط,
    المدخل: معرف_مدخل_ربط
): متجه معرف_قسم_ربط {
    دع المعرفات: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو (معرفا_مدخل_ربط_متساويان((*القسم).المدخل, المدخل)) {
            طابق (*القسم).الصنف مع
            | صنف_قسم_ربط.تصحيح -> {
                ألحق(المعرفات, (*القسم).المعرف);
            }
            | _ -> { };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع المعرفات;
}

عام عرف إزاحات_قسم_تصحيح_للربط(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): متجه حافة_إزاحة_ربط {
    دع الإزاحات: متغير متجه حافة_إزاحة_ربط = [];
    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الإزاحة: حافة_إزاحة_ربط = (*السياق).الإزاحات[فهرس_الإزاحة];
        لو (الإزاحة.القسم.القيمة == القسم.القيمة) {
            ألحق(الإزاحات, الإزاحة);
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }
    أرجع الإزاحات;
}
