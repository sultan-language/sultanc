استورد compiler.link.context;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.elf.encoding;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

عام نوع خطأ_كائن_مترابط_إلف =
    | هدف_غير_مدعوم
    | حقائق_قسم_غير_صالحة
    | مرجع_إزاحة_غير_صالح
;

عام نوع نتيجة_كائن_مترابط_إلف =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_كائن_مترابط_إلف
;

عرف ألحق_اسم_إلف_مترابط(
    الجدول: &متغير متجه ط8,
    الاسم: &متجه ط8
): طبيعي {
    دع الموضع: طبيعي = الطول(*الجدول) مثل طبيعي;
    ألحق_بايتات_إلف_ربط(الجدول, الاسم);
    ألحق(*الجدول, 0);
    أرجع الموضع;
}

عرف قيمة_ص32_إلف_مترابط(القيمة: عدد): اختياري طبيعي {
    إذا (القيمة < -2147483648 || القيمة > 2147483647) {
        أرجع اختياري.لا_شيء();
    };
    إذا (القيمة < 0) {
        أرجع اختياري.موجود((4294967296 + القيمة) مثل طبيعي);
    };
    أرجع اختياري.موجود(القيمة مثل طبيعي);
}

عرف قيمة_ص64_إلف_مترابط(القيمة: عدد): اختياري طبيعي {
    إذا (القيمة >= 0) { أرجع اختياري.موجود(القيمة مثل طبيعي); };
    دع المقدار: طبيعي = (-القيمة) مثل طبيعي;
    إذا (المقدار > 0x7FFFFFFFFFFFFFFF) { أرجع اختياري.لا_شيء(); };
    دع الأدنى_الخام: طبيعي = المقدار & 0xFFFFFFFF;
    دع الأعلى_الخام: طبيعي = المقدار / 4294967296;
    دع الأدنى_المعكوس: طبيعي = 0xFFFFFFFF - الأدنى_الخام;
    دع الأعلى_المعكوس: طبيعي = 0xFFFFFFFF - الأعلى_الخام;
    دع الأدنى: طبيعي = (الأدنى_المعكوس + 1) & 0xFFFFFFFF;
    دع حمل: متغير طبيعي = 0;
    إذا (الأدنى == 0) { حمل := 1; };
    دع الأعلى: طبيعي = (الأعلى_المعكوس + حمل) & 0xFFFFFFFF;
    أرجع اختياري.موجود(الأدنى + الأعلى * 4294967296);
}

عرف عدد_إزاحات_قسم_إلف_مترابط(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        إذا ((*السياق).الإزاحات[الفهرس].القسم.القيمة == القسم.القيمة) {
            العدد := العدد + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ألحق_رمز_إلف_مترابط(
    البايتات: &متغير متجه ط8,
    السياسة: &سياسة_هدف_إلف,
    موضع_الاسم: طبيعي,
    المعلومات: طبيعي,
    فهرس_القسم: طبيعي,
    القيمة: طبيعي,
    الحجم: طبيعي
): فراغ {
    دع الترتيب: ترتيب_بايت = ترتيب_بايت_من_سياسة_إلف(السياسة);
    طابق (*السياسة).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        ألحق_ط32_إلف_بترتيب(البايتات, موضع_الاسم, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, القيمة, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, الحجم, الترتيب);
        ألحق_بايت_إلف(البايتات, المعلومات);
        ألحق_بايت_إلف(البايتات, 0);
        ألحق_ط16_إلف_بترتيب(البايتات, فهرس_القسم, الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        ألحق_ط32_إلف_بترتيب(البايتات, موضع_الاسم, الترتيب);
        ألحق_بايت_إلف(البايتات, المعلومات);
        ألحق_بايت_إلف(البايتات, 0);
        ألحق_ط16_إلف_بترتيب(البايتات, فهرس_القسم, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, القيمة, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, الحجم, الترتيب);
    };
}

عرف ألحق_رأس_قسم_إلف_مترابط(
    البايتات: &متغير متجه ط8,
    السياسة: &سياسة_هدف_إلف,
    موضع_الاسم: طبيعي,
    النوع: طبيعي,
    الأعلام: طبيعي,
    موضع_الملف: طبيعي,
    الحجم: طبيعي,
    الرابط: طبيعي,
    المعلومات: طبيعي,
    المحاذاة: طبيعي,
    حجم_المدخل: طبيعي
): فراغ {
    دع الترتيب: ترتيب_بايت = ترتيب_بايت_من_سياسة_إلف(السياسة);
    ألحق_ط32_إلف_بترتيب(البايتات, موضع_الاسم, الترتيب);
    ألحق_ط32_إلف_بترتيب(البايتات, النوع, الترتيب);
    طابق (*السياسة).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        ألحق_ط32_إلف_بترتيب(البايتات, الأعلام, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, 0, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, موضع_الملف, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, الحجم, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, الرابط, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, المعلومات, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, المحاذاة, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, حجم_المدخل, الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        ألحق_ط64_إلف_بترتيب(البايتات, الأعلام, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, 0, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, موضع_الملف, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, الحجم, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, الرابط, الترتيب);
        ألحق_ط32_إلف_بترتيب(البايتات, المعلومات, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, المحاذاة, الترتيب);
        ألحق_ط64_إلف_بترتيب(البايتات, حجم_المدخل, الترتيب);
    };
}

عرف ألحق_إزاحة_ريلا_إلف_مترابطة(
    البايتات: &متغير متجه ط8,
    السياسة: &سياسة_هدف_إلف,
    الإزاحة: طبيعي,
    فهرس_الرمز: طبيعي,
    رمز_الصيغة: طبيعي,
    الإضافة: عدد
): منطقي {
    دع الترتيب: ترتيب_بايت = ترتيب_بايت_من_سياسة_إلف(السياسة);
    طابق (*السياسة).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        إذا (فهرس_الرمز > 0xFFFFFF || رمز_الصيغة > 0xFF) { أرجع خطأ; };
        دع قيمة_الإضافة: طبيعي;
        طابق قيمة_ص32_إلف_مترابط(الإضافة) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القيمة) -> { قيمة_الإضافة := القيمة; };
        ألحق_ط32_إلف_بترتيب(البايتات, الإزاحة, الترتيب);
        ألحق_ط32_إلف_بترتيب(
            البايتات,
            فهرس_الرمز * 256 + رمز_الصيغة,
            الترتيب
        );
        ألحق_ط32_إلف_بترتيب(البايتات, قيمة_الإضافة, الترتيب);
        أرجع صواب;
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        دع قيمة_الإضافة: طبيعي;
        طابق قيمة_ص64_إلف_مترابط(الإضافة) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القيمة) -> { قيمة_الإضافة := القيمة; };
        ألحق_ط64_إلف_بترتيب(البايتات, الإزاحة, الترتيب);
        ألحق_ط64_إلف_بترتيب(
            البايتات,
            فهرس_الرمز * 4294967296 + رمز_الصيغة,
            الترتيب
        );
        ألحق_ط64_إلف_بترتيب(البايتات, قيمة_الإضافة, الترتيب);
        أرجع صواب;
    };
}

عرف ألحق_رأس_إلف_مترابط(
    الصورة: &متغير متجه ط8,
    السياسة: &سياسة_هدف_إلف,
    هوية_النظام: طبيعي,
    عدد_الأقسام: طبيعي,
    فهرس_جدول_أسماء_الأقسام: طبيعي
): طبيعي {
    دع الترتيب: ترتيب_بايت = ترتيب_بايت_من_سياسة_إلف(السياسة);
    ألحق_بايت_إلف(الصورة, 0x7F);
    ألحق_بايت_إلف(الصورة, 0x45);
    ألحق_بايت_إلف(الصورة, 0x4C);
    ألحق_بايت_إلف(الصورة, 0x46);
    ألحق_بايت_إلف(الصورة, رقم_صنف_إلف((*السياسة).الصنف));
    ألحق_بايت_إلف(الصورة, رقم_ترتيب_إلف((*السياسة).الترتيب));
    ألحق_بايت_إلف(الصورة, 1);
    ألحق_بايت_إلف(الصورة, هوية_النظام);
    ألحق_أصفارا_إلف_ربط(الصورة, 8);
    ألحق_ط16_إلف_بترتيب(الصورة, 1, الترتيب);
    ألحق_ط16_إلف_بترتيب(الصورة, (*السياسة).الآلة, الترتيب);
    ألحق_ط32_إلف_بترتيب(الصورة, 1, الترتيب);
    طابق (*السياسة).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        ألحق_ط32_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط32_إلف_بترتيب(الصورة, 0, الترتيب);
        دع موضع_حقل_رؤوس_الأقسام: طبيعي = الطول(*الصورة) مثل طبيعي;
        ألحق_ط32_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط32_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 52, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 40, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, عدد_الأقسام, الترتيب);
        ألحق_ط16_إلف_بترتيب(
            الصورة,
            فهرس_جدول_أسماء_الأقسام,
            الترتيب
        );
        أرجع موضع_حقل_رؤوس_الأقسام;
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        ألحق_ط64_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط64_إلف_بترتيب(الصورة, 0, الترتيب);
        دع موضع_حقل_رؤوس_الأقسام: طبيعي = الطول(*الصورة) مثل طبيعي;
        ألحق_ط64_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط32_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 64, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 0, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, 64, الترتيب);
        ألحق_ط16_إلف_بترتيب(الصورة, عدد_الأقسام, الترتيب);
        ألحق_ط16_إلف_بترتيب(
            الصورة,
            فهرس_جدول_أسماء_الأقسام,
            الترتيب
        );
        أرجع موضع_حقل_رؤوس_الأقسام;
    };
}

عام عرف ابن_كائن_إلف_مترابط(
    السياق: &سياق_ربط
): نتيجة_كائن_مترابط_إلف {
    دع السياسة: سياسة_هدف_إلف;
    طابق سياسة_إلف_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_كائن_مترابط_إلف.خطأ(
            خطأ_كائن_مترابط_إلف.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { السياسة := القيمة; };
    دع الترتيب: ترتيب_بايت = ترتيب_بايت_من_سياسة_إلف(&السياسة);
    دع حجم_الرمز: طبيعي = حجم_رمز_إلف_مدخل(السياسة.الصنف);
    دع حجم_ريلا: طبيعي = حجم_ريلا_إلف_مدخل(السياسة.الصنف);
    دع حجم_رأس_القسم: طبيعي = حجم_رأس_قسم_إلف_مدخل(السياسة.الصنف);
    دع محاذاة_الكلمة: متغير طبيعي = 4;
    طابق السياسة.الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { محاذاة_الكلمة := 4; }
    | صنف_إلف_مدخل.أربعة_وستون -> { محاذاة_الكلمة := 8; };

    دع عدد_الأقسام: طبيعي = الطول((*السياق).الأقسام) مثل طبيعي;
    دع فهارس_الأقسام: متغير متجه طبيعي = [];
    دع مواضع_الأقسام: متغير متجه طبيعي = [];
    دع مواضع_أسماء_الأقسام: متغير متجه طبيعي = [];
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        ألحق(فهارس_الأقسام, فهرس_القسم + 1);
        ألحق(مواضع_الأقسام, 0);
        ألحق(مواضع_أسماء_الأقسام, 0);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع عدد_أقسام_الإزاحات: متغير طبيعي = 0;
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        إذا (عدد_إزاحات_قسم_إلف_مترابط(
            السياق,
            (*السياق).الأقسام[فهرس_القسم].المعرف
        ) > 0) {
            عدد_أقسام_الإزاحات := عدد_أقسام_الإزاحات + 1;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع فهرس_قسم_الرموز: طبيعي = 1 + عدد_الأقسام + عدد_أقسام_الإزاحات;
    دع فهرس_قسم_النصوص: طبيعي = فهرس_قسم_الرموز + 1;
    دع فهرس_قسم_أسماء_الأقسام: طبيعي = فهرس_قسم_النصوص + 1;
    دع العدد_الكلي_للأقسام: طبيعي = فهرس_قسم_أسماء_الأقسام + 1;
    إذا (العدد_الكلي_للأقسام > 0xFFFF) {
        أرجع نتيجة_كائن_مترابط_إلف.خطأ(
            خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
        );
    };

    دع جدول_أسماء_الأقسام: متغير متجه ط8 = [0];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        مواضع_أسماء_الأقسام[فهرس_القسم] := ألحق_اسم_إلف_مترابط(
            &متغير جدول_أسماء_الأقسام,
            &(*السياق).الأقسام[فهرس_القسم].الاسم.اسم_القسم
        );
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع مواضع_أسماء_الإزاحات: متغير متجه اختياري طبيعي = [];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        إذا (عدد_إزاحات_قسم_إلف_مترابط(
            السياق,
            (*السياق).الأقسام[فهرس_القسم].المعرف
        ) > 0) {
            دع اسم_الإزاحات: متغير متجه ط8 = بايتات_من_نص(«.rela»);
            ألحق_بايتات_إلف_ربط(
                &متغير اسم_الإزاحات,
                &(*السياق).الأقسام[فهرس_القسم].الاسم.اسم_القسم
            );
            ألحق(
                مواضع_أسماء_الإزاحات,
                اختياري.موجود(ألحق_اسم_إلف_مترابط(
                    &متغير جدول_أسماء_الأقسام,
                    &اسم_الإزاحات
                ))
            );
        } وإلا {
            ألحق(مواضع_أسماء_الإزاحات, اختياري.لا_شيء());
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع اسم_الرموز: متجه ط8 = بايتات_من_نص(«.symtab»);
    دع اسم_النصوص: متجه ط8 = بايتات_من_نص(«.strtab»);
    دع اسم_أسماء_الأقسام: متجه ط8 = بايتات_من_نص(«.shstrtab»);
    دع موضع_اسم_الرموز: طبيعي = ألحق_اسم_إلف_مترابط(
        &متغير جدول_أسماء_الأقسام,
        &اسم_الرموز
    );
    دع موضع_اسم_النصوص: طبيعي = ألحق_اسم_إلف_مترابط(
        &متغير جدول_أسماء_الأقسام,
        &اسم_النصوص
    );
    دع موضع_اسم_أسماء_الأقسام: طبيعي = ألحق_اسم_إلف_مترابط(
        &متغير جدول_أسماء_الأقسام,
        &اسم_أسماء_الأقسام
    );

    دع جدول_النصوص: متغير متجه ط8 = [0];
    دع فهارس_الرموز: متغير متجه طبيعي = [];
    دع مواضع_أسماء_الرموز: متغير متجه طبيعي = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        ألحق(فهارس_الرموز, 1 + عدد_الأقسام + فهرس_الرمز);
        ألحق(
            مواضع_أسماء_الرموز,
            ألحق_اسم_إلف_مترابط(
                &متغير جدول_النصوص,
                &(*السياق).الرموز.الرموز[فهرس_الرمز].الاسم
            )
        );
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    دع جدول_الرموز: متغير متجه ط8 = [];
    ألحق_أصفارا_إلف_ربط(&متغير جدول_الرموز, حجم_الرمز);
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        ألحق_رمز_إلف_مترابط(
            &متغير جدول_الرموز,
            &السياسة,
            0,
            3,
            فهارس_الأقسام[فهرس_القسم],
            0,
            0
        );
        فهرس_القسم := فهرس_القسم + 1;
    }
    فهرس_الرمز := 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        دع المعلومات: متغير طبيعي = 0x10;
        دع فهرس_قسم_الرمز: متغير طبيعي = 0;
        دع قيمة_الرمز: متغير طبيعي = 0;
        دع حجم_قيمة_الرمز: متغير طبيعي = 0;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.القوة مع
            | قوة_تعريف_رمز_ربط.قوي -> { المعلومات := 0x10; }
            | قوة_تعريف_رمز_ربط.ضعيف -> { المعلومات := 0x20; };
            حجم_قيمة_الرمز := التعريف.الحجم;
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.غير_محدد -> { }
            | موضع_تعريف_رمز_ربط.قسم(القسم, الإزاحة) -> {
                إذا ((القسم.القيمة مثل طبيعي) >= عدد_الأقسام) {
                    أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                        خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
                    );
                };
                فهرس_قسم_الرمز := فهارس_الأقسام[القسم.القيمة];
                قيمة_الرمز := الإزاحة;
            }
            | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                فهرس_قسم_الرمز := 0xFFF1;
                قيمة_الرمز := القيمة;
            };
        }
        | حالة_رمز_ربط.غير_معرف(_) -> {
            // An undefined weak reference stays STB_WEAK in a relocatable
            // output (link/context.sn مراجع_رمز_ربط), as in LLD -r.
            إذا (رمز_مرجعه_ضعيف_فقط_في_سياق_الربط(السياق, (*الرمز).المعرف)) {
                المعلومات := 0x20;
            };
        }
        | حالة_رمز_ربط.ديناميكي(_) -> { }
        | حالة_رمز_ربط.كسول(_, _) -> {
            إذا (رمز_مرجعه_ضعيف_فقط_في_سياق_الربط(السياق, (*الرمز).المعرف)) {
                المعلومات := 0x20;
            };
        };
        ألحق_رمز_إلف_مترابط(
            &متغير جدول_الرموز,
            &السياسة,
            مواضع_أسماء_الرموز[فهرس_الرمز],
            المعلومات,
            فهرس_قسم_الرمز,
            قيمة_الرمز,
            حجم_قيمة_الرمز
        );
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    دع بيانات_الإزاحات: متغير متجه متجه ط8 = [];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع البيانات: متغير متجه ط8 = [];
        دع فهرس_الإزاحة: متغير طبيعي = 0;
        طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
            دع الإزاحة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
            إذا (((*الإزاحة).القسم.القيمة مثل طبيعي) == فهرس_القسم) {
                دع فهرس_رمز_الإزاحة: طبيعي;
                طابق (*الإزاحة).المرجع مع
                | مرجع_إزاحة_ربط.قسم(معرف_القسم) -> {
                    إذا ((معرف_القسم.القيمة مثل طبيعي) >= عدد_الأقسام) {
                        أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                            خطأ_كائن_مترابط_إلف.مرجع_إزاحة_غير_صالح()
                        );
                    };
                    فهرس_رمز_الإزاحة := 1 + معرف_القسم.القيمة;
                }
                | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
                    إذا ((معرف_الرمز.القيمة مثل طبيعي)
                        >= (الطول(فهارس_الرموز) مثل طبيعي)) {
                        أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                            خطأ_كائن_مترابط_إلف.مرجع_إزاحة_غير_صالح()
                        );
                    };
                    فهرس_رمز_الإزاحة := فهارس_الرموز[معرف_الرمز.القيمة];
                };
                إذا (!ألحق_إزاحة_ريلا_إلف_مترابطة(
                    &متغير البيانات,
                    &السياسة,
                    (*الإزاحة).الإزاحة,
                    فهرس_رمز_الإزاحة,
                    (*الإزاحة).رمز_صيغة,
                    (*الإزاحة).إضافة
                )) {
                    أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                        خطأ_كائن_مترابط_إلف.مرجع_إزاحة_غير_صالح()
                    );
                };
            };
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        ألحق(بيانات_الإزاحات, البيانات);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع الصورة: متغير متجه ط8 = [];
    دع موضع_حقل_رؤوس_الأقسام: طبيعي = ألحق_رأس_إلف_مترابط(
        &متغير الصورة,
        &السياسة,
        رقم_هوية_نظام_إلف_للهدف(&(*السياق).الهدف),
        العدد_الكلي_للأقسام,
        فهرس_قسم_أسماء_الأقسام
    );

    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع النوع: طبيعي;
        طابق (*القسم).حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.إلف(نوع_القسم, _) -> { النوع := نوع_القسم; }
        | _ -> {
            أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
            );
        };
        دع المحاذاة: متغير طبيعي = (*القسم).المحاذاة;
        إذا (المحاذاة == 0) { المحاذاة := 1; };
        إذا (النوع != 8) {
            دع الموضع: طبيعي = حاذ_قيمة_إلف(
                الطول(الصورة) مثل طبيعي,
                المحاذاة
            );
            أكمل_إلف_إلى_موضع(&متغير الصورة, الموضع);
            مواضع_الأقسام[فهرس_القسم] := الموضع;
            طابق (*القسم).المحتوى مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المحتوى) -> {
                ألحق_بايتات_إلف_ربط(&متغير الصورة, &المحتوى);
            };
        } وإلا {
            مواضع_الأقسام[فهرس_القسم] := الطول(الصورة) مثل طبيعي;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع مواضع_أقسام_الإزاحات: متغير متجه اختياري طبيعي = [];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        إذا ((الطول(بيانات_الإزاحات[فهرس_القسم]) مثل طبيعي) > 0) {
            دع الموضع: طبيعي = حاذ_قيمة_إلف(
                الطول(الصورة) مثل طبيعي,
                محاذاة_الكلمة
            );
            أكمل_إلف_إلى_موضع(&متغير الصورة, الموضع);
            ألحق_بايتات_إلف_ربط(
                &متغير الصورة,
                &بيانات_الإزاحات[فهرس_القسم]
            );
            ألحق(مواضع_أقسام_الإزاحات, اختياري.موجود(الموضع));
        } وإلا {
            ألحق(مواضع_أقسام_الإزاحات, اختياري.لا_شيء());
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع موضع_جدول_الرموز: طبيعي = حاذ_قيمة_إلف(
        الطول(الصورة) مثل طبيعي,
        محاذاة_الكلمة
    );
    أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_جدول_الرموز);
    ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_الرموز);
    دع موضع_جدول_النصوص: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_النصوص);
    دع موضع_جدول_أسماء_الأقسام: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_أسماء_الأقسام);
    دع موضع_رؤوس_الأقسام: طبيعي = حاذ_قيمة_إلف(
        الطول(الصورة) مثل طبيعي,
        محاذاة_الكلمة
    );
    أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_رؤوس_الأقسام);
    ألحق_أصفارا_إلف_ربط(&متغير الصورة, حجم_رأس_القسم);

    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع النوع: طبيعي;
        دع الأعلام: طبيعي;
        طابق (*السياق).الأقسام[فهرس_القسم].حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.إلف(نوع_القسم, أعلام_القسم) -> {
            النوع := نوع_القسم;
            الأعلام := أعلام_القسم;
        }
        | _ -> {
            أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
            );
        };
        دع المحاذاة: متغير طبيعي =
            (*السياق).الأقسام[فهرس_القسم].المحاذاة;
        إذا (المحاذاة == 0) { المحاذاة := 1; };
        ألحق_رأس_قسم_إلف_مترابط(
            &متغير الصورة,
            &السياسة,
            مواضع_أسماء_الأقسام[فهرس_القسم],
            النوع,
            الأعلام,
            مواضع_الأقسام[فهرس_القسم],
            (*السياق).الأقسام[فهرس_القسم].الحجم,
            0,
            0,
            المحاذاة,
            0
        );
        فهرس_القسم := فهرس_القسم + 1;
    }

    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        طابق مواضع_أقسام_الإزاحات[فهرس_القسم] مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> {
            دع موضع_الاسم: طبيعي;
            طابق مواضع_أسماء_الإزاحات[فهرس_القسم] مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                    خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
                );
            }
            | اختياري.موجود(القيمة) -> { موضع_الاسم := القيمة; };
            ألحق_رأس_قسم_إلف_مترابط(
                &متغير الصورة,
                &السياسة,
                موضع_الاسم,
                4,
                0,
                الموضع,
                الطول(بيانات_الإزاحات[فهرس_القسم]) مثل طبيعي,
                فهرس_قسم_الرموز,
                فهارس_الأقسام[فهرس_القسم],
                محاذاة_الكلمة,
                حجم_ريلا
            );
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    ألحق_رأس_قسم_إلف_مترابط(
        &متغير الصورة,
        &السياسة,
        موضع_اسم_الرموز,
        2,
        0,
        موضع_جدول_الرموز,
        الطول(جدول_الرموز) مثل طبيعي,
        فهرس_قسم_النصوص,
        1 + عدد_الأقسام,
        محاذاة_الكلمة,
        حجم_الرمز
    );
    ألحق_رأس_قسم_إلف_مترابط(
        &متغير الصورة,
        &السياسة,
        موضع_اسم_النصوص,
        3,
        0,
        موضع_جدول_النصوص,
        الطول(جدول_النصوص) مثل طبيعي,
        0,
        0,
        1,
        0
    );
    ألحق_رأس_قسم_إلف_مترابط(
        &متغير الصورة,
        &السياسة,
        موضع_اسم_أسماء_الأقسام,
        3,
        0,
        موضع_جدول_أسماء_الأقسام,
        الطول(جدول_أسماء_الأقسام) مثل طبيعي,
        0,
        0,
        1,
        0
    );

    طابق السياسة.الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        إذا (!اكتب_ط32_إلف_بترتيب_في(
            &متغير الصورة,
            موضع_حقل_رؤوس_الأقسام,
            موضع_رؤوس_الأقسام,
            الترتيب
        )) {
            أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
            );
        };
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        إذا (!اكتب_ط64_إلف_بترتيب_في(
            &متغير الصورة,
            موضع_حقل_رؤوس_الأقسام,
            موضع_رؤوس_الأقسام,
            الترتيب
        )) {
            أرجع نتيجة_كائن_مترابط_إلف.خطأ(
                خطأ_كائن_مترابط_إلف.حقائق_قسم_غير_صالحة()
            );
        };
    };
    أرجع نتيجة_كائن_مترابط_إلف.نجح(الصورة);
}
