استورد compiler.backend.target.target_model;
استورد compiler.link.elf.encoding;

// Static relocations of the ELF executables SultanC lays out for i386,
// ARM (A32 and Thumb-2), s390x, SPARC V9, PowerPC 64 (ELFv2) and MIPS64
// (n64): the forms LLVM emits for SultanC's static code model, and the
// GOT-relative forms of position-independent C objects that a static image
// resolves through local GOT slots. The image writer (final_image.sn)
// computes the place P, the target S + A and the GOT slot and TOC/GOT base
// from the canonical layout; this module only encodes the field, in the
// image's byte order. A relocation type that is not listed here is
// reported as unsupported (link.elf.unsupported-relocation), never left
// unpatched, and a value outside its field is reported as out of range.

عام نوع نتيجة_رقعة_إلف =
    | تمت
    | غير_مدعومة
    | خارج_النطاق
;

عام نوع قيم_إزاحة_إلف = {
    // r_type (MIPS64: r_type | r_type2 << 8 | r_type3 << 16 | r_ssym << 24).
    النوع: طبيعي,
    // The file offset of the patched field in the image.
    الموضع: طبيعي,
    // P: the address of the patched field.
    عنوان_الرقعة: طبيعي,
    // S + A. On ARM, bit 0 of a Thumb function's S is set (T).
    الهدف: طبيعي,
    // A alone, for the GOT-slot forms G + A.
    الإضافة: عدد,
    // G: the address of the target's local GOT slot (0 when it has none).
    عنوان_الخانة: طبيعي,
    // The GOT base (i386 _GLOBAL_OFFSET_TABLE_) or the TOC base (PowerPC 64 .TOC.).
    أساس_الجدول: طبيعي,
    // PowerPC 64: the target's local entry offset (st_other), added to a
    // direct call, which keeps r2 (one TOC per image).
    الدخول_المحلي: طبيعي
};

// The width in bytes of the field a relocation patches, or none when the
// linker does not support the type for the architecture.
عام عرف عرض_رقعة_إلف_ثابتة(المعمارية: هوية_معمارية, النوع: طبيعي): اختياري طبيعي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        إذا (النوع == 0) { أرجع اختياري.موجود(0); };
        إذا (النوع == 1 || النوع == 2 || النوع == 3 || النوع == 4
            || النوع == 9 || النوع == 10 || النوع == 43) {
            أرجع اختياري.موجود(4);
        };
    }
    | هوية_معمارية.ذراع_سبعة -> {
        إذا (النوع == 0 || النوع == 40) { أرجع اختياري.موجود(0); };
        إذا (النوع == 102 || النوع == 103) { أرجع اختياري.موجود(2); };
        إذا (النوع == 1 || النوع == 2 || النوع == 3 || النوع == 10
            || (النوع >= 28 && النوع <= 30) || النوع == 38 || النوع == 42
            || (النوع >= 43 && النوع <= 51)) {
            أرجع اختياري.موجود(4);
        };
    }
    | هوية_معمارية.سيستم_زد -> {
        إذا (النوع == 0) { أرجع اختياري.موجود(0); };
        إذا (النوع == 1) { أرجع اختياري.موجود(1); };
        إذا (النوع == 3 || النوع == 16 || النوع == 17) { أرجع اختياري.موجود(2); };
        إذا (النوع == 4 || النوع == 5 || النوع == 19 || النوع == 20 || النوع == 26) {
            أرجع اختياري.موجود(4);
        };
        إذا (النوع == 22 || النوع == 23) { أرجع اختياري.موجود(8); };
    }
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        إذا (النوع == 0) { أرجع اختياري.موجود(0); };
        إذا (النوع == 3 || النوع == 6 || النوع == 7 || النوع == 8 || النوع == 9
            || النوع == 11 || النوع == 12 || النوع == 23 || (النوع >= 34 && النوع <= 36)
            || النوع == 41 || (النوع >= 50 && النوع <= 52)) {
            أرجع اختياري.موجود(4);
        };
        إذا (النوع == 32 || النوع == 46 || النوع == 54) { أرجع اختياري.موجود(8); };
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        إذا (النوع == 0) { أرجع اختياري.موجود(0); };
        إذا ((النوع >= 4 && النوع <= 6) || (النوع >= 47 && النوع <= 50)
            || النوع == 63 || النوع == 64 || (النوع >= 249 && النوع <= 252)) {
            أرجع اختياري.موجود(2);
        };
        إذا (النوع == 1 || النوع == 10 || النوع == 26) { أرجع اختياري.موجود(4); };
        إذا (النوع == 38 || النوع == 44 || النوع == 51) { أرجع اختياري.موجود(8); };
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        // Only single relocations: r_type2 = r_type3 = R_MIPS_NONE.
        إذا (النوع == 0 || النوع == 37) { أرجع اختياري.موجود(0); };
        إذا (النوع == 2 || النوع == 4 || النوع == 5 || النوع == 6
            || النوع == 28 || النوع == 29) {
            أرجع اختياري.موجود(4);
        };
        إذا (النوع == 18) { أرجع اختياري.موجود(8); };
    }
    | _ -> { };
    أرجع اختياري.لا_شيء();
}

// Whether the relocation reads the target's address from a GOT slot (the
// image then gives the symbol a local slot holding its address).
عام عرف إزاحة_إلف_ثابتة_بخانة_جوت(المعمارية: هوية_معمارية, النوع: طبيعي): منطقي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع النوع == 3 || النوع == 43; }
    | هوية_معمارية.سيستم_زد -> { أرجع النوع == 26; }
    | _ -> { أرجع خطأ; };
}

عرف بعد_ثابت_إلف(الهدف: طبيعي, المصدر: طبيعي): عدد {
    إذا (الهدف >= المصدر) {
        إذا (الهدف - المصدر > 0x3FFFFFFFFFFFFFFF) { أرجع 0x3FFFFFFFFFFFFFFF; };
        أرجع (الهدف - المصدر) مثل عدد;
    };
    إذا (المصدر - الهدف > 0x3FFFFFFFFFFFFFFF) { أرجع -0x3FFFFFFFFFFFFFFF; };
    أرجع -((المصدر - الهدف) مثل عدد);
}

عرف بتات_ثابتة_إلف(القيمة: عدد, المنخفض: طبيعي, العدد: طبيعي): طبيعي {
    دع القناع: طبيعي = (1 << العدد) - 1;
    دع مزاح: عدد = القيمة >> (المنخفض مثل عدد);
    أرجع (مزاح & (القناع مثل عدد)) مثل طبيعي;
}

عرف يتسع_ثابت_بإشارة_إلف(القيمة: عدد, البتات: طبيعي): منطقي {
    دع الحد: عدد = 1 << ((البتات - 1) مثل عدد);
    أرجع القيمة >= -الحد && القيمة < الحد;
}

// A 32-bit absolute field holds an unsigned 32-bit value or a sign-extended
// negative one.
عرف يتسع_مطلق32_إلف(القيمة: طبيعي): منطقي {
    أرجع القيمة <= 0xFFFFFFFF || القيمة >= 0xFFFFFFFF80000000;
}

عرف يتسع_مطلق16_إلف(القيمة: طبيعي): منطقي {
    أرجع القيمة <= 0xFFFF || القيمة >= 0xFFFFFFFFFFFF8000;
}

عرف موقع_ثابت_إلف(القيمة: طبيعي): عدد {
    إذا (القيمة <= 0x7FFFFFFFFFFFFFFF) { أرجع القيمة مثل عدد; };
    أرجع -(((0xFFFFFFFFFFFFFFFF - القيمة) + 1) مثل عدد);
}

عرف اقرأ_ط16_ثابت_إلف(الصورة: &متجه ط8, الموضع: طبيعي, الترتيب: ترتيب_بايت): طبيعي {
    دع الأول: طبيعي = (*الصورة)[الموضع] مثل طبيعي;
    دع الثاني: طبيعي = (*الصورة)[الموضع + 1] مثل طبيعي;
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { أرجع الأول | (الثاني << 8); }
    | ترتيب_بايت.كبير -> { أرجع (الأول << 8) | الثاني; };
}

عرف اكتب_ط16_ثابت_إلف(الصورة: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي, الترتيب: ترتيب_بايت): فراغ {
    دع المنخفض: ط8 = (القيمة & 0xFF) مثل ط8;
    دع العالي: ط8 = ((القيمة >> 8) & 0xFF) مثل ط8;
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        (*الصورة)[الموضع] := المنخفض;
        (*الصورة)[الموضع + 1] := العالي;
    }
    | ترتيب_بايت.كبير -> {
        (*الصورة)[الموضع] := العالي;
        (*الصورة)[الموضع + 1] := المنخفض;
    };
}

عرف اقرأ_ط32_ثابت_إلف(الصورة: &متجه ط8, الموضع: طبيعي, الترتيب: ترتيب_بايت): طبيعي {
    دع الأول: طبيعي = اقرأ_ط16_ثابت_إلف(الصورة, الموضع, الترتيب);
    دع الثاني: طبيعي = اقرأ_ط16_ثابت_إلف(الصورة, الموضع + 2, الترتيب);
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { أرجع الأول | (الثاني << 16); }
    | ترتيب_بايت.كبير -> { أرجع (الأول << 16) | الثاني; };
}

عرف اكتب_ط32_ثابت_إلف(الصورة: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي, الترتيب: ترتيب_بايت): فراغ {
    دع كتب: منطقي = اكتب_ط32_إلف_بترتيب_في(الصورة, الموضع, القيمة & 0xFFFFFFFF, الترتيب);
}

عرف اكتب_ط64_ثابت_إلف(الصورة: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي, الترتيب: ترتيب_بايت): فراغ {
    دع كتب: منطقي = اكتب_ط64_إلف_بترتيب_في(الصورة, الموضع, القيمة, الترتيب);
}

// A 32-bit field: a signed value that must fit.
عرف اكتب_موقع32_ثابت_إلف(
    الصورة: &متغير متجه ط8, الموضع: طبيعي, القيمة: عدد, الترتيب: ترتيب_بايت
): نتيجة_رقعة_إلف {
    إذا (!يتسع_ثابت_بإشارة_إلف(القيمة, 32)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
    اكتب_ط32_ثابت_إلف(الصورة, الموضع, بتات_ثابتة_إلف(القيمة, 0, 32), الترتيب);
    أرجع نتيجة_رقعة_إلف.تمت();
}

عرف اكتب_مطلق32_ثابت_إلف(
    الصورة: &متغير متجه ط8, الموضع: طبيعي, القيمة: طبيعي, الترتيب: ترتيب_بايت
): نتيجة_رقعة_إلف {
    إذا (!يتسع_مطلق32_إلف(القيمة)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
    اكتب_ط32_ثابت_إلف(الصورة, الموضع, القيمة, الترتيب);
    أرجع نتيجة_رقعة_إلف.تمت();
}

// Replaces the bits of القناع in the 32-bit word at الموضع.
عرف ادمج_ط32_ثابت_إلف(
    الصورة: &متغير متجه ط8, الموضع: طبيعي, القناع: طبيعي, القيمة: طبيعي, الترتيب: ترتيب_بايت
): نتيجة_رقعة_إلف {
    دع القديمة: طبيعي = اقرأ_ط32_ثابت_إلف(الصورة, الموضع, الترتيب);
    اكتب_ط32_ثابت_إلف(الصورة, الموضع, (القديمة & (0xFFFFFFFF ^ القناع)) | (القيمة & القناع), الترتيب);
    أرجع نتيجة_رقعة_إلف.تمت();
}

عرف ارقع_إزاحة_إي386(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الترتيب: ترتيب_بايت = ترتيب_بايت.صغير();
    إذا (النوع == 0) { أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 1) { أرجع اكتب_مطلق32_ثابت_إلف(الصورة, الموضع, (*الإزاحة).الهدف, الترتيب); };
    إذا (النوع == 2 || النوع == 4 || النوع == 10) {
        // R_386_PC32, R_386_PLT32 (no PLT in a static image), R_386_GOTPC
        // (its symbol is _GLOBAL_OFFSET_TABLE_).
        أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع,
            بعد_ثابت_إلف((*الإزاحة).الهدف, (*الإزاحة).عنوان_الرقعة), الترتيب);
    };
    إذا (النوع == 9) {
        // R_386_GOTOFF: S + A - GOT.
        أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع,
            بعد_ثابت_إلف((*الإزاحة).الهدف, (*الإزاحة).أساس_الجدول), الترتيب);
    };
    // R_386_GOT32, R_386_GOT32X: G + A - GOT.
    أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع,
        بعد_ثابت_إلف((*الإزاحة).عنوان_الخانة, (*الإزاحة).أساس_الجدول) + (*الإزاحة).الإضافة, الترتيب);
}

// imm16 of an A32 MOVW/MOVT (imm4:imm12).
عرف ارقع_حركة_ذراع(التعليمة: طبيعي, القيمة: طبيعي): طبيعي {
    أرجع (التعليمة & 0xFFF0F000) | (((القيمة >> 12) & 0xF) << 16) | (القيمة & 0xFFF);
}

// imm16 of a Thumb-2 MOVW/MOVT (imm4:i:imm3:imm8), halfwords hw1 | hw2 << 16.
عرف ارقع_حركة_إبهام(التعليمة: طبيعي, القيمة: طبيعي): طبيعي {
    دع الأول: طبيعي = ((التعليمة & 0xFFFF) & 0xFBF0) | ((القيمة >> 12) & 0xF) | (((القيمة >> 11) & 1) << 10);
    دع الثاني: طبيعي = (((التعليمة >> 16) & 0xFFFF) & 0x8F00) | (((القيمة >> 8) & 7) << 12) | (القيمة & 0xFF);
    أرجع الأول | (الثاني << 16);
}

// The 25-bit offset of a Thumb-2 BL/BLX/B.W (S:I1:I2:imm10:imm11:0); the
// fixed bits of hw2 above bit 11 come from الأساس (0xD000 BL, 0xC000 BLX,
// 0x9000 B.W).
عرف ارقع_فرع_إبهام(التعليمة: طبيعي, البعد: عدد, الأساس: طبيعي): طبيعي {
    دع الإشارة: طبيعي = بتات_ثابتة_إلف(البعد, 24, 1);
    دع أول_ي: طبيعي = بتات_ثابتة_إلف(البعد, 23, 1);
    دع ثاني_ي: طبيعي = بتات_ثابتة_إلف(البعد, 22, 1);
    دع ج1: طبيعي = 1 - (أول_ي ^ الإشارة);
    دع ج2: طبيعي = 1 - (ثاني_ي ^ الإشارة);
    دع الأول: طبيعي = ((التعليمة & 0xFFFF) & 0xF800) | (الإشارة << 10) | بتات_ثابتة_إلف(البعد, 12, 10);
    دع الثاني: طبيعي = الأساس | (ج1 << 13) | (ج2 << 11) | بتات_ثابتة_إلف(البعد, 1, 11);
    أرجع الأول | (الثاني << 16);
}

عرف ارقع_إزاحة_ذراع(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الترتيب: ترتيب_بايت = ترتيب_بايت.صغير();
    دع الهدف: طبيعي = (*الإزاحة).الهدف;
    دع الموضع_الافتراضي: طبيعي = (*الإزاحة).عنوان_الرقعة;
    دع البعد: عدد = بعد_ثابت_إلف(الهدف, الموضع_الافتراضي);
    دع إبهام: منطقي = (الهدف & 1) != 0;
    // R_ARM_NONE, R_ARM_V4BX: nothing to patch.
    إذا (النوع == 0 || النوع == 40) { أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_ARM_ABS32, R_ARM_TARGET1 (absolute in .init_array): (S + A) | T.
    إذا (النوع == 2 || النوع == 38) { أرجع اكتب_مطلق32_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); };
    // R_ARM_REL32: ((S + A) | T) - P.
    إذا (النوع == 3) { أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع, البعد, الترتيب); };
    // R_ARM_PREL31 (.ARM.exidx): 31 bits of ((S + A) | T) - P, bit 31 kept.
    إذا (النوع == 42) {
        إذا (!يتسع_ثابت_بإشارة_إلف(البعد, 31)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x7FFFFFFF, بتات_ثابتة_إلف(البعد, 0, 31), الترتيب);
    };
    دع التعليمة: طبيعي = اقرأ_ط32_ثابت_إلف(الصورة, الموضع, الترتيب);
    // R_ARM_PC24, R_ARM_CALL, R_ARM_JUMP24: imm24 of B/BL/BLX. A call
    // reaching Thumb code becomes BLX (H holds bit 1), one reaching A32 code
    // BL; a jump cannot change state without a veneer.
    إذا (النوع == 1 || النوع == 28 || النوع == 29) {
        دع المعدل: متغير طبيعي = التعليمة;
        إذا (إبهام) {
            إذا (النوع != 28) { أرجع نتيجة_رقعة_إلف.غير_مدعومة(); };
            المعدل := 0xFA000000 | (بتات_ثابتة_إلف(البعد, 1, 1) << 24);
        } وإلا {
            إذا ((البعد & 3) != 0) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
            إذا ((التعليمة & 0xFE000000) == 0xFA000000) {
                // BLX imm to A32 code: BL (always).
                المعدل := 0xEB000000;
            };
        };
        إذا (!يتسع_ثابت_بإشارة_إلف(البعد, 26)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط32_ثابت_إلف(الصورة, الموضع, (المعدل & 0xFF000000) | بتات_ثابتة_إلف(البعد, 2, 24), الترتيب);
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    // R_ARM_MOVW_ABS_NC, R_ARM_MOVT_ABS, R_ARM_MOVW_PREL_NC, R_ARM_MOVT_PREL.
    إذا (النوع == 43) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_ذراع(التعليمة, الهدف & 0xFFFF), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 44) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_ذراع(التعليمة, (الهدف >> 16) & 0xFFFF), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 45) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_ذراع(التعليمة, بتات_ثابتة_إلف(البعد, 0, 16)), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 46) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_ذراع(التعليمة, بتات_ثابتة_إلف(البعد, 16, 16)), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_ARM_THM_MOVW_ABS_NC, R_ARM_THM_MOVT_ABS, R_ARM_THM_MOVW_PREL_NC, R_ARM_THM_MOVT_PREL.
    إذا (النوع == 47) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_إبهام(التعليمة, الهدف & 0xFFFF), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 48) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_إبهام(التعليمة, (الهدف >> 16) & 0xFFFF), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 49) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_إبهام(التعليمة, بتات_ثابتة_إلف(البعد, 0, 16)), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 50) { اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_حركة_إبهام(التعليمة, بتات_ثابتة_إلف(البعد, 16, 16)), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_ARM_THM_CALL: BL to Thumb code, BLX to A32 code (the offset from
    // P aligned down to 4).
    إذا (النوع == 10) {
        إذا (إبهام) {
            دع بعد_الإبهام: عدد = البعد - 1;
            إذا (!يتسع_ثابت_بإشارة_إلف(بعد_الإبهام, 25)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
            اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_فرع_إبهام(التعليمة, بعد_الإبهام, 0xD000), الترتيب);
        } وإلا {
            دع بعد_الذراع: عدد = بعد_ثابت_إلف(الهدف, الموضع_الافتراضي & 0xFFFFFFFFFFFFFFFC);
            إذا ((بعد_الذراع & 3) != 0 || !يتسع_ثابت_بإشارة_إلف(بعد_الذراع, 25)) {
                أرجع نتيجة_رقعة_إلف.خارج_النطاق();
            };
            اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_فرع_إبهام(التعليمة, بعد_الذراع, 0xC000), الترتيب);
        };
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    // R_ARM_THM_JUMP24 (B.W) and R_ARM_THM_JUMP19 (B<c>.W): Thumb targets only.
    إذا (النوع == 30 || النوع == 51) {
        إذا (!إبهام) { أرجع نتيجة_رقعة_إلف.غير_مدعومة(); };
        دع بعد_الإبهام: عدد = البعد - 1;
        إذا (النوع == 30) {
            إذا (!يتسع_ثابت_بإشارة_إلف(بعد_الإبهام, 25)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
            اكتب_ط32_ثابت_إلف(الصورة, الموضع, ارقع_فرع_إبهام(التعليمة, بعد_الإبهام, 0x9000), الترتيب);
            أرجع نتيجة_رقعة_إلف.تمت();
        };
        // S:J2:J1:imm6:imm11:0, the condition in hw1 bits 9:6 kept.
        إذا (!يتسع_ثابت_بإشارة_إلف(بعد_الإبهام, 21)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        دع الأول: طبيعي = ((التعليمة & 0xFFFF) & 0xFBC0) | (بتات_ثابتة_إلف(بعد_الإبهام, 20, 1) << 10)
            | بتات_ثابتة_إلف(بعد_الإبهام, 12, 6);
        دع الثاني: طبيعي = (((التعليمة >> 16) & 0xFFFF) & 0xD000) | (بتات_ثابتة_إلف(بعد_الإبهام, 18, 1) << 13)
            | (بتات_ثابتة_إلف(بعد_الإبهام, 19, 1) << 11) | بتات_ثابتة_إلف(بعد_الإبهام, 1, 11);
        اكتب_ط32_ثابت_إلف(الصورة, الموضع, الأول | (الثاني << 16), الترتيب);
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    أرجع نتيجة_رقعة_إلف.غير_مدعومة();
}

// The 16-bit Thumb branches R_ARM_THM_JUMP11 (B) and R_ARM_THM_JUMP8 (B<c>).
عرف ارقع_فرع_إبهام_قصير(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف): نتيجة_رقعة_إلف {
    دع الترتيب: ترتيب_بايت = ترتيب_بايت.صغير();
    دع البعد: عدد = بعد_ثابت_إلف((*الإزاحة).الهدف, (*الإزاحة).عنوان_الرقعة) - 1;
    دع القديمة: طبيعي = اقرأ_ط16_ثابت_إلف(الصورة, (*الإزاحة).الموضع, الترتيب);
    إذا ((*الإزاحة).النوع == 102) {
        إذا (!يتسع_ثابت_بإشارة_إلف(البعد, 12)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط16_ثابت_إلف(الصورة, (*الإزاحة).الموضع, (القديمة & 0xF800) | بتات_ثابتة_إلف(البعد, 1, 11), الترتيب);
    } وإلا {
        إذا (!يتسع_ثابت_بإشارة_إلف(البعد, 9)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط16_ثابت_إلف(الصورة, (*الإزاحة).الموضع, (القديمة & 0xFF00) | بتات_ثابتة_إلف(البعد, 1, 8), الترتيب);
    };
    أرجع نتيجة_رقعة_إلف.تمت();
}

عرف ارقع_إزاحة_سيستم_زد(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الترتيب: ترتيب_بايت = ترتيب_بايت.كبير();
    دع الهدف: طبيعي = (*الإزاحة).الهدف;
    دع البعد: عدد = بعد_ثابت_إلف(الهدف, (*الإزاحة).عنوان_الرقعة);
    إذا (النوع == 0) { أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_390_8, R_390_16, R_390_32, R_390_64: S + A.
    إذا (النوع == 1) {
        إذا (الهدف > 0xFF) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        (*الصورة)[الموضع] := الهدف مثل ط8;
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    إذا (النوع == 3) {
        إذا (!يتسع_مطلق16_إلف(الهدف)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط16_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب);
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    إذا (النوع == 4) { أرجع اكتب_مطلق32_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); };
    إذا (النوع == 22) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_390_PC32, R_390_PC64: S + A - P.
    إذا (النوع == 5) { أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع, البعد, الترتيب); };
    إذا (النوع == 23) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, بتات_ثابتة_إلف(البعد, 0, 32) | (بتات_ثابتة_إلف(البعد, 32, 32) << 32), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // Halfword-scaled: R_390_PC16DBL, R_390_PLT16DBL, R_390_PC32DBL,
    // R_390_PLT32DBL ((S + A - P) >> 1) and R_390_GOTENT ((G + A - P) >> 1).
    دع المقياس: متغير عدد = البعد;
    إذا (النوع == 26) {
        المقياس := بعد_ثابت_إلف((*الإزاحة).عنوان_الخانة, (*الإزاحة).عنوان_الرقعة) + (*الإزاحة).الإضافة;
    };
    إذا ((المقياس & 1) != 0) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
    // `>>` of a signed value is a logical shift; the value is even.
    دع النصف: عدد = المقياس / 2;
    إذا (النوع == 16 || النوع == 17) {
        إذا (!يتسع_ثابت_بإشارة_إلف(النصف, 16)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط16_ثابت_إلف(الصورة, الموضع, بتات_ثابتة_إلف(النصف, 0, 16), الترتيب);
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع, النصف, الترتيب);
}

عرف ارقع_إزاحة_سبارك(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الترتيب: ترتيب_بايت = ترتيب_بايت.كبير();
    دع الهدف: طبيعي = (*الإزاحة).الهدف;
    دع القيمة: عدد = موقع_ثابت_إلف(الهدف);
    دع البعد: عدد = بعد_ثابت_إلف(الهدف, (*الإزاحة).عنوان_الرقعة);
    إذا (النوع == 0) { أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_SPARC_32, R_SPARC_UA32; R_SPARC_64, R_SPARC_UA64 (byte-wise, so
    // alignment does not matter); R_SPARC_DISP32, R_SPARC_DISP64.
    إذا (النوع == 3 || النوع == 23) { أرجع اكتب_مطلق32_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); };
    إذا (النوع == 32 || النوع == 54) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 6) { أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع, البعد, الترتيب); };
    إذا (النوع == 46) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, بتات_ثابتة_إلف(البعد, 0, 32) | (بتات_ثابتة_إلف(البعد, 32, 32) << 32), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // Word displacements: R_SPARC_WDISP30 (call), R_SPARC_WDISP22 (Bicc),
    // R_SPARC_WDISP19 (BPcc).
    إذا (النوع == 7 || النوع == 8 || النوع == 41) {
        إذا ((البعد & 3) != 0) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        دع البتات: متغير طبيعي = 30;
        إذا (النوع == 8) { البتات := 22; };
        إذا (النوع == 41) { البتات := 19; };
        إذا (!يتسع_ثابت_بإشارة_إلف(البعد, البتات + 2)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, (1 << البتات) - 1, بتات_ثابتة_إلف(البعد, 2, البتات), الترتيب);
    };
    // R_SPARC_13: simm13.
    إذا (النوع == 11) {
        إذا (!يتسع_ثابت_بإشارة_إلف(القيمة, 13)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x1FFF, بتات_ثابتة_إلف(القيمة, 0, 13), الترتيب);
    };
    // R_SPARC_HI22, R_SPARC_LO10 (32-bit absolute addresses).
    إذا (النوع == 9) {
        إذا (الهدف > 0xFFFFFFFF) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFF, (الهدف >> 10) & 0x3FFFFF, الترتيب);
    };
    إذا (النوع == 12) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FF, الهدف & 0x3FF, الترتيب); };
    // R_SPARC_HH22, R_SPARC_HM10, R_SPARC_LM22: the 64-bit absolute sequence.
    إذا (النوع == 34) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFF, (الهدف >> 42) & 0x3FFFFF, الترتيب); };
    إذا (النوع == 35) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FF, (الهدف >> 32) & 0x3FF, الترتيب); };
    إذا (النوع == 36) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFF, (الهدف >> 10) & 0x3FFFFF, الترتيب); };
    // R_SPARC_H44, R_SPARC_M44, R_SPARC_L44: the medium-low (44-bit) code model.
    إذا (الهدف >= 0x100000000000) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
    إذا (النوع == 50) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFF, (الهدف >> 22) & 0x3FFFFF, الترتيب); };
    إذا (النوع == 51) { أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FF, (الهدف >> 12) & 0x3FF, الترتيب); };
    أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x1FFF, الهدف & 0xFFF, الترتيب);
}

// @ha: the high half adjusted for the sign-extended low half.
عرف عال_معدل_باور(القيمة: عدد): طبيعي { أرجع بتات_ثابتة_إلف(القيمة + 0x8000, 16, 16); }

عرف ارقع_إزاحة_باور(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف, الترتيب: ترتيب_بايت): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الهدف: طبيعي = (*الإزاحة).الهدف;
    دع البعد: عدد = بعد_ثابت_إلف(الهدف, (*الإزاحة).عنوان_الرقعة);
    دع بعد_الجدول: عدد = بعد_ثابت_إلف(الهدف, (*الإزاحة).أساس_الجدول);
    دع القيمة: عدد = موقع_ثابت_إلف(الهدف);
    إذا (النوع == 0) { أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_PPC64_ADDR64, R_PPC64_REL64, R_PPC64_TOC (the TOC base), R_PPC64_ADDR32, R_PPC64_REL32.
    إذا (النوع == 38) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 44) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, بتات_ثابتة_إلف(البعد, 0, 32) | (بتات_ثابتة_إلف(البعد, 32, 32) << 32), الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 51) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, (*الإزاحة).أساس_الجدول, الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 1) { أرجع اكتب_مطلق32_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); };
    إذا (النوع == 26) { أرجع اكتب_موقع32_ثابت_إلف(الصورة, الموضع, البعد, الترتيب); };
    // R_PPC64_REL24: a direct call enters at the callee's local entry
    // point, past the r2 set-up of its global entry; the image has one TOC.
    // The `nop` after the call stays: r2 does not change.
    إذا (النوع == 10) {
        دع بعد_الدخول: عدد = البعد + ((*الإزاحة).الدخول_المحلي مثل عدد);
        إذا ((بعد_الدخول & 3) != 0 || !يتسع_ثابت_بإشارة_إلف(بعد_الدخول, 26)) {
            أرجع نتيجة_رقعة_إلف.خارج_النطاق();
        };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFFC, بتات_ثابتة_إلف(بعد_الدخول, 0, 26), الترتيب);
    };
    // Halfword fields: ADDR16_LO/HI/HA (S + A), TOC16/_LO/_HI/_HA/_DS/_LO_DS
    // (S + A - .TOC.), REL16/_LO/_HI/_HA (S + A - P).
    دع الأساس: متغير عدد = القيمة;
    إذا ((النوع >= 47 && النوع <= 50) || النوع == 63 || النوع == 64) { الأساس := بعد_الجدول; };
    إذا (النوع >= 249 && النوع <= 252) { الأساس := البعد; };
    دع الحقل: متغير طبيعي = 0;
    إذا (النوع == 47 || النوع == 249) {
        إذا (!يتسع_ثابت_بإشارة_إلف(الأساس, 16)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        الحقل := بتات_ثابتة_إلف(الأساس, 0, 16);
    } وإلا إذا (النوع == 4 || النوع == 48 || النوع == 250) {
        الحقل := بتات_ثابتة_إلف(الأساس, 0, 16);
    } وإلا إذا (النوع == 5 || النوع == 49 || النوع == 251) {
        الحقل := بتات_ثابتة_إلف(الأساس, 16, 16);
    } وإلا إذا (النوع == 6 || النوع == 50 || النوع == 252) {
        إذا (النوع != 6 && !يتسع_ثابت_بإشارة_إلف(الأساس + 0x8000, 32)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        الحقل := عال_معدل_باور(الأساس);
    } وإلا {
        // TOC16_DS, TOC16_LO_DS: a DS-form displacement; the two low bits
        // belong to the instruction.
        إذا ((الأساس & 3) != 0) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        إذا (النوع == 63 && !يتسع_ثابت_بإشارة_إلف(الأساس, 16)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        دع القديمة: طبيعي = اقرأ_ط16_ثابت_إلف(الصورة, الموضع, الترتيب);
        الحقل := (بتات_ثابتة_إلف(الأساس, 0, 16) & 0xFFFC) | (القديمة & 3);
    };
    اكتب_ط16_ثابت_إلف(الصورة, الموضع, الحقل, الترتيب);
    أرجع نتيجة_رقعة_إلف.تمت();
}

عرف ارقع_إزاحة_ميبس(الصورة: &متغير متجه ط8, الإزاحة: &قيم_إزاحة_إلف, الترتيب: ترتيب_بايت): نتيجة_رقعة_إلف {
    دع النوع: طبيعي = (*الإزاحة).النوع;
    دع الموضع: طبيعي = (*الإزاحة).الموضع;
    دع الهدف: طبيعي = (*الإزاحة).الهدف;
    دع القيمة: عدد = موقع_ثابت_إلف(الهدف);
    // R_MIPS_NONE, R_MIPS_JALR (a call hint).
    إذا (النوع == 0 || النوع == 37) { أرجع نتيجة_رقعة_إلف.تمت(); };
    إذا (النوع == 18) { اكتب_ط64_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب); أرجع نتيجة_رقعة_إلف.تمت(); };
    // R_MIPS_32: n64 sign-extends the word it loads.
    إذا (النوع == 2) {
        إذا (!يتسع_ثابت_بإشارة_إلف(القيمة, 32)) { أرجع نتيجة_رقعة_إلف.خارج_النطاق(); };
        اكتب_ط32_ثابت_إلف(الصورة, الموضع, الهدف, الترتيب);
        أرجع نتيجة_رقعة_إلف.تمت();
    };
    // R_MIPS_26: j/jal within the 256 MiB region of the delay slot.
    إذا (النوع == 4) {
        إذا ((الهدف & 3) != 0
            || ((الهدف ^ ((*الإزاحة).عنوان_الرقعة + 4)) & 0xFFFFFFFFF0000000) != 0) {
            أرجع نتيجة_رقعة_إلف.خارج_النطاق();
        };
        أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0x3FFFFFF, الهدف >> 2, الترتيب);
    };
    // R_MIPS_HI16, R_MIPS_LO16, R_MIPS_HIGHER, R_MIPS_HIGHEST: the 64-bit
    // absolute address sequence, each part adjusted for the sign-extended
    // parts below it.
    دع الحقل: متغير طبيعي = الهدف & 0xFFFF;
    إذا (النوع == 5) { الحقل := ((الهدف + 0x8000) >> 16) & 0xFFFF; };
    إذا (النوع == 29) { الحقل := ((الهدف + 0x80008000) >> 32) & 0xFFFF; };
    إذا (النوع == 28) { الحقل := ((الهدف + 0x800080008000) >> 48) & 0xFFFF; };
    أرجع ادمج_ط32_ثابت_إلف(الصورة, الموضع, 0xFFFF, الحقل, الترتيب);
}

// Patches one relocation. The caller has checked that عرض_رقعة_إلف_ثابتة
// bytes at الموضع lie inside the section and the image.
عام عرف ارقع_إزاحة_إلف_ثابتة(
    الصورة: &متغير متجه ط8,
    المعمارية: هوية_معمارية,
    الترتيب: ترتيب_بايت,
    الإزاحة: &قيم_إزاحة_إلف
): نتيجة_رقعة_إلف {
    طابق عرض_رقعة_إلف_ثابتة(المعمارية, (*الإزاحة).النوع) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_رقعة_إلف.غير_مدعومة(); }
    | اختياري.موجود(_) -> { };
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع ارقع_إزاحة_إي386(الصورة, الإزاحة); }
    | هوية_معمارية.ذراع_سبعة -> {
        إذا ((*الإزاحة).النوع == 102 || (*الإزاحة).النوع == 103) {
            أرجع ارقع_فرع_إبهام_قصير(الصورة, الإزاحة);
        };
        أرجع ارقع_إزاحة_ذراع(الصورة, الإزاحة);
    }
    | هوية_معمارية.سيستم_زد -> { أرجع ارقع_إزاحة_سيستم_زد(الصورة, الإزاحة); }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع ارقع_إزاحة_سبارك(الصورة, الإزاحة); }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع ارقع_إزاحة_باور(الصورة, الإزاحة, الترتيب); }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع ارقع_إزاحة_ميبس(الصورة, الإزاحة, الترتيب); }
    | _ -> { أرجع نتيجة_رقعة_إلف.غير_مدعومة(); };
}
