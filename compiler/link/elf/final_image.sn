استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.elf.encoding;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;
استورد compiler.link.elf.relocation_patch;
استورد compiler.link.elf.symbol_output;
استورد compiler.runtime.primitive_runtime_abi;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.dynamic_link_query_context;
استورد std.text.from_bytes;
استورد std.collections.map;

عام نوع خطأ_صورة_إلف_تنفيذية =
    | هدف_غير_مدعوم
    | تخطيط_غير_صالح
    | رمز_دخول_مفقود
    // The symbol the image could not bind, or an empty name when the failure
    // is not one symbol's (no dynamic-link configuration for the target).
    | رمز_خارجي_غير_محلول بنوع متجه ط8
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
    // A relocation type (r_type) the image writer does not encode for the
    // target (relocation_patch.sn).
    | نوع_إزاحة_غير_مدعوم بنوع طبيعي
    // A relocation whose value does not fit its field, or that needs what a
    // static image does not have (an A32/Thumb interworking veneer): r_type
    // and the symbol (empty for a section-relative reference).
    | إزاحة_رمز_خارج_النطاق بنوع (طبيعي, متجه ط8)
    // A linker-script image whose output overflows this MEMORY region.
    | منطقة_ذاكرة_فائضة بنوع متجه ط8
;

عام نوع نتيجة_صورة_إلف_تنفيذية =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_صورة_إلف_تنفيذية
;

نوع رمز_ديناميكي_إلف_ربط = {
    المعرف: معرف_رمز_ربط,
    الاسم: متجه ط8,
    إزاحة_الاسم: طبيعي,
    التعريف: اختياري تعريف_رمز_ربط
};

نوع اعتماد_ديناميكي_إلف_ربط = {
    الاسم: متجه ط8,
    إزاحة_الاسم: طبيعي
};



عرف انسخ_متجه_بايتات_إلف(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_إلف_ربط(&متغير الناتج, المصدر);
    أرجع الناتج;
}

عرف متجها_بايتات_إلف_متساويان(
    الأول: &متجه ط8,
    الثاني: &متجه ط8
): منطقي {
    إذا ((الطول(*الأول) مثل طبيعي) != (الطول(*الثاني) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*الأول) مثل طبيعي)) {
        إذا ((*الأول)[فهرس_البايت] != (*الثاني)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف أضف_اسم_إلى_جدول_إلف(
    الجدول: &متغير متجه ط8,
    الاسم: &متجه ط8
): طبيعي {
    دع الموضع: طبيعي = الطول(*الجدول) مثل طبيعي;
    ألحق_بايتات_إلف_ربط(الجدول, الاسم);
    ألحق(*الجدول, 0);
    أرجع الموضع;
}

عرف اجمع_إضافة_إلف(
    الأساس: طبيعي,
    الإضافة: عدد
): اختياري طبيعي {
    إذا (الإضافة >= 0) {
        دع المقدار: طبيعي = الإضافة مثل طبيعي;
        دع الناتج: طبيعي = الأساس + المقدار;
        إذا (الناتج < الأساس) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الناتج);
    };
    // Negating the most-negative signed addend is undefined/overflowing;
    // compute its unsigned magnitude without negating that value.
    دع المقدار: طبيعي = ((-(الإضافة + 1)) مثل طبيعي) + 1;
    إذا (المقدار > الأساس) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأساس - المقدار);
}

عرف قسم_إلف_محمل_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(_, الأعلام) -> {
        أرجع (الأعلام & 2) != 0;
    }
    | _ -> { أرجع خطأ; };
}

عرف قسم_إلف_قابل_للكتابة_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(_, الأعلام) -> {
        أرجع (الأعلام & 1) != 0;
    }
    | _ -> { أرجع خطأ; };
}

// An allocated SHT_NOTE section (the FreeBSD .note.tag ABI note).
عرف قسم_ملاحظة_إلف_محمل(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(النوع, الأعلام) -> { أرجع النوع == 7 && (الأعلام & 2) != 0; }
    | _ -> { أرجع خطأ; };
}

عرف قسم_إلف_صفري_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(النوع, _) -> { أرجع النوع == 8; }
    | _ -> { أرجع خطأ; };
}

عرف أضف_اعتماد_ديناميكي_إلف_إن_لم_يوجد(
    الاعتمادات: &متغير متجه اعتماد_ديناميكي_إلف_ربط,
    الاسم: &متجه ط8
): فراغ {
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل طبيعي)) {
        إذا (متجها_بايتات_إلف_متساويان(
            &(*الاعتمادات)[فهرس_الاعتماد].الاسم,
            الاسم
        )) {
            أرجع;
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع الاعتماد: اعتماد_ديناميكي_إلف_ربط = {
        الاسم: انسخ_متجه_بايتات_إلف(الاسم),
        إزاحة_الاسم: 0
    };
    ألحق(*الاعتمادات, الاعتماد);
}

عرف أضف_رمز_ديناميكي_إلف(
    الرموز: &متغير متجه رمز_ديناميكي_إلف_ربط,
    الرمز: &رمز_ربط,
    التعريف: اختياري تعريف_رمز_ربط
): فراغ {
    دع الديناميكي: رمز_ديناميكي_إلف_ربط = {
        المعرف: (*الرمز).المعرف,
        الاسم: انسخ_متجه_بايتات_إلف(&(*الرمز).الاسم),
        إزاحة_الاسم: 0,
        التعريف: التعريف
    };
    ألحق(*الرموز, الديناميكي);
}

عرف ابن_قائمة_رموز_ديناميكية_إلف(
    السياق: &سياق_ربط,
    يشمل_التعريفات: منطقي
): متجه رمز_ديناميكي_إلف_ربط {
    دع الرموز: متغير متجه رمز_ديناميكي_إلف_ربط = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    // Imports are kept first because PLT/GOT relocation indexes use the same
    // dynamic-symbol indexes. Shared-library exports follow them.
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> {
            أضف_رمز_ديناميكي_إلف(&متغير الرموز, الرمز, اختياري.لا_شيء());
        }
        | حالة_رمز_ربط.ديناميكي(_) -> {
            // Unreferenced shared-library exports are not imported.
            إذا ((*الرمز).مستخدم) {
                أضف_رمز_ديناميكي_إلف(&متغير الرموز, الرمز, اختياري.لا_شيء());
            };
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    إذا (يشمل_التعريفات) {
        فهرس_الرمز := 0;
        طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
            دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
            طابق (*الرمز).الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                أضف_رمز_ديناميكي_إلف(
                    &متغير الرموز,
                    الرمز,
                    اختياري.موجود(التعريف)
                );
            }
            | _ -> { };
            فهرس_الرمز := فهرس_الرمز + 1;
        }
    };
    أرجع الرموز;
}

عرف عدد_رموز_استيراد_ديناميكية_إلف(
    الرموز: &متجه رمز_ديناميكي_إلف_ربط
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
        طابق (*الرموز)[الفهرس].التعريف مع
        | اختياري.لا_شيء -> { العدد := العدد + 1; }
        | اختياري.موجود(_) -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

// The first symbol the image would import, named by the unresolved-symbol
// report when no dynamic library can supply imports; empty when none.
عرف اسم_أول_رمز_استيراد_ديناميكي_إلف(
    الرموز: &متجه رمز_ديناميكي_إلف_ربط
): متجه ط8 {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
        طابق (*الرموز)[الفهرس].التعريف مع
        | اختياري.لا_شيء -> {
            دع مرجع_الاسم: &متجه ط8 = &(*الرموز)[الفهرس].الاسم;
            دع الاسم: متجه ط8 = انسخ_بايتات(مرجع_الاسم);
            أرجع الاسم;
        }
        | اختياري.موجود(_) -> { };
        الفهرس := الفهرس + 1;
    }
    دع فارغ: متجه ط8 = [];
    أرجع فارغ;
}

عرف ابحث_ترتيب_رمز_ديناميكي_إلف(
    الرموز: &متجه رمز_ديناميكي_إلف_ربط,
    المعرف: معرف_رمز_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
        إذا ((*الرموز)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Imported absolute x86-64 addresses must be fixed by the ELF loader.
// Shared libraries use the canonical delegated linker; this count is for
// ET_EXEC only. Keep symbol identity in the existing link graph.
عرف إزاحة_بيانات_ديناميكية_مطلقة_إلف(
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط
): منطقي {
    إذا ((*الحافة).رمز_صيغة != 1) { أرجع خطأ; };
    طابق (*الحافة).المرجع مع
    | مرجع_إزاحة_ربط.قسم(_) -> { أرجع خطأ; }
    | مرجع_إزاحة_ربط.رمز(المعرف) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.غير_معرف(_) -> { أرجع صواب; }
            | حالة_رمز_ربط.ديناميكي(_) -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        };
    };
}

عرف عدد_إزاحات_بيانات_ديناميكية_إلف(السياق: &سياق_ربط): طبيعي {
    دع العدد: متغير طبيعي = 0;
    إذا ((*السياق).الهدف.المعمارية.الهوية
        != هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون()) {
        أرجع 0;
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القسم) -> {
            إذا (القسم.حي && قسم_إلف_محمل_تنفيذيا(&القسم)
                && إزاحة_بيانات_ديناميكية_مطلقة_إلف(السياق, الحافة)) {
                العدد := العدد + 1;
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

// A shared library linked as needed (named in AS_NEEDED(...) of a GNU input
// script; link/model.sn مدخل_ربط_حسب_الحاجة) is needed only when a regular
// object uses one of its exports, as GNU ld's --as-needed and LLD's
// SharedFile::isNeeded
// (set by a used Defined/Shared reference in a non-shared file) decide. Every
// other dependency stays needed. Previously every dependency became
// DT_NEEDED, so glibc's AS_NEEDED(ld-linux...) was always recorded.
عرف مدخل_اعتماد_إلف_حسب_الحاجة_مستخدم(
    السياق: &سياق_ربط,
    المدخل: معرف_مدخل_ربط
): منطقي {
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.ديناميكي(المصدر) -> {
            // A reference that never extracts (an STB_WEAK undefined
            // symbol; link/context.sn مراجع_رمز_ربط) does not make an
            // as-needed library needed, as in LLD.
            إذا ((*الرمز).مستخدم && معرفا_مدخل_ربط_متساويان(المصدر, المدخل)
                && !رمز_مرجعه_ضعيف_فقط_في_سياق_الربط(السياق, (*الرمز).المعرف)) {
                أرجع صواب;
            };
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع خطأ;
}

عرف اعتماد_إلف_مطلوب(
    السياق: &سياق_ربط,
    فهرس_الاعتماد: طبيعي
): منطقي {
    طابق (*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].المدخل مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(المدخل) -> {
        إذا (معرف_مدخل_ربط_حسب_الحاجة(&(*السياق).الخطة, المدخل)) {
            أرجع مدخل_اعتماد_إلف_حسب_الحاجة_مستخدم(السياق, المدخل);
        };
        أرجع صواب;
    };
}

عرف ابن_اعتمادات_إلف(
    السياق: &سياق_ربط
): متجه اعتماد_ديناميكي_إلف_ربط {
    دع الاعتمادات: متغير متجه اعتماد_ديناميكي_إلف_ربط = [];
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي)
    ) {
        إذا (اعتماد_إلف_مطلوب(السياق, فهرس_الاعتماد)) {
            أضف_اعتماد_ديناميكي_إلف_إن_لم_يوجد(
                &متغير الاعتمادات,
                &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].الاسم
            );
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع الاعتمادات;
}

عرف أضف_جزء_مسار_تشغيل_إلف(
    المسار: &متغير متجه ط8,
    الجزء: &متجه ط8
): فراغ {
    إذا ((الطول(*الجزء) مثل طبيعي) == 0) { أرجع; };
    إذا ((الطول(*المسار) مثل طبيعي) > 0) {
        ألحق(*المسار, 0x3A);
    };
    ألحق_بايتات_إلف_ربط(المسار, الجزء);
}

عرف ابن_مسار_تشغيل_إلف(السياق: &سياق_ربط): متجه ط8 {
    دع المسار: متغير متجه ط8 = [];
    دع فهرس_الصريح: متغير طبيعي = 0;
    طالما (
        فهرس_الصريح < (الطول((*السياق).الخطة.مسارات_التشغيل) مثل طبيعي)
    ) {
        أضف_جزء_مسار_تشغيل_إلف(
            &متغير المسار,
            &(*السياق).الخطة.مسارات_التشغيل[فهرس_الصريح]
        );
        فهرس_الصريح := فهرس_الصريح + 1;
    }
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي)
    ) {
        إذا (اعتماد_إلف_مطلوب(السياق, فهرس_الاعتماد)) {
            طابق (*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].دليل_البحث مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الدليل) -> {
                أضف_جزء_مسار_تشغيل_إلف(&متغير المسار, &الدليل);
            };
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع المسار;
}

نوع نتيجة_وضع_أقسام_إلف = {
    موضع_الملف: طبيعي,
    عنوان_الذاكرة: طبيعي
};

// SHT_INIT_ARRAY sections from separately linked objects retain their own
// identities, but the executable constructor range must respect ELF priority
// suffixes. Unsuffixed .init_array entries use the default (65535) priority.
عرف أولوية_قسم_منشئات_إلف(القسم: &قسم_ربط): طبيعي {
    دع مرجع_الاسم: &متجه ط8 = &(*القسم).الاسم.اسم_القسم;
    دع الاسم: متجه ط8 = *مرجع_الاسم;
    دع البادئة: متجه ط8 = بايتات_من_نص(«.init_array.»);
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    إذا ((الطول(الاسم) مثل طبيعي) <= طول_البادئة) { أرجع 65535; };
    دع فهرس: متغير طبيعي = 0;
    طالما (فهرس < طول_البادئة) {
        إذا (الاسم[فهرس] != البادئة[فهرس]) { أرجع 65535; };
        فهرس := فهرس + 1;
    }
    دع الأولوية: متغير طبيعي = 0;
    طالما (فهرس < (الطول(الاسم) مثل طبيعي)) {
        دع الرقم: ط8 = الاسم[فهرس];
        إذا (الرقم < 0x30 || الرقم > 0x39) { أرجع 65535; };
        دع الخانة: طبيعي = (الرقم - 0x30) مثل طبيعي;
        إذا (الأولوية > (65535 - الخانة) / 10) { أرجع 65535; };
        الأولوية := الأولوية * 10 + الخانة;
        فهرس := فهرس + 1;
    }
    أرجع الأولوية;
}

// Stable priority ordering: equal-priority constructors execute in the
// original input order. The input sections and relocation identities remain
// untouched; only their final placement in the constructor range changes.
عرف رتب_أقسام_منشئات_إلف(السياق: &سياق_ربط): متجه طبيعي {
    دع الترتيب: متغير متجه طبيعي = [];
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع منشئ: متغير منطقي = خطأ;
        طابق (*القسم).حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.إلف(النوع, _) -> { منشئ := النوع == 14; }
        | _ -> { };
        إذا (منشئ && (*القسم).حي) {
            دع الأولوية: طبيعي = أولوية_قسم_منشئات_إلف(القسم);
            دع التالية: متغير متجه طبيعي = [];
            دع أدرج: متغير منطقي = خطأ;
            دع فهرس_الترتيب: متغير طبيعي = 0;
            طالما (فهرس_الترتيب < (الطول(الترتيب) مثل طبيعي)) {
                دع فهرس_السابق: طبيعي = الترتيب[فهرس_الترتيب];
                دع القسم_السابق: &قسم_ربط = &(*السياق).الأقسام[فهرس_السابق];
                إذا (!أدرج && الأولوية < أولوية_قسم_منشئات_إلف(القسم_السابق)) {
                    ألحق(التالية, فهرس_القسم);
                    أدرج := صواب;
                };
                ألحق(التالية, فهرس_السابق);
                فهرس_الترتيب := فهرس_الترتيب + 1;
            }
            إذا (!أدرج) { ألحق(التالية, فهرس_القسم); };
            الترتيب := التالية;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع الترتيب;
}

عرف أضف_مواضع_أقسام_إلف_ملفوفة(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    قابلة_للكتابة: منطقي,
    صفرية: منطقي,
    موضع_الملف_الأولي: طبيعي,
    عنوان_الذاكرة_الأولي: طبيعي
): نتيجة_وضع_أقسام_إلف {
    دع موضع_الملف: متغير طبيعي = موضع_الملف_الأولي;
    دع عنوان_الذاكرة: متغير طبيعي = عنوان_الذاكرة_الأولي;
    دع انحياز_الجزء: طبيعي =
        عنوان_الذاكرة_الأولي - موضع_الملف_الأولي;
    // Keep one contiguous SHT_INIT_ARRAY range in priority order; all other
    // writable sections retain their original placement order.
    دع ترتيب_المنشئات: متغير متجه طبيعي = [];
    إذا (قابلة_للكتابة && !صفرية) {
        ترتيب_المنشئات := رتب_أقسام_منشئات_إلف(السياق);
    };
    دع مرور: متغير طبيعي = 0;
    طالما (مرور < 2) {
        دع عدد_المرور: متغير طبيعي = الطول((*السياق).الأقسام) مثل طبيعي;
        إذا (مرور == 0) { عدد_المرور := الطول(ترتيب_المنشئات) مثل طبيعي; };
        دع فهرس_القسم: متغير طبيعي = 0;
        طالما (فهرس_القسم < عدد_المرور) {
            دع فهرس_المصدر: متغير طبيعي = فهرس_القسم;
            إذا (مرور == 0) { فهرس_المصدر := ترتيب_المنشئات[فهرس_القسم]; };
            دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_المصدر];
            دع منشئ_محمل: متغير منطقي = خطأ;
            طابق (*القسم).حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.إلف(النوع, _) -> { منشئ_محمل := النوع == 14; }
            | _ -> { };
            دع منشئ_أولوية: منطقي = قابلة_للكتابة && !صفرية && منشئ_محمل;
            إذا (
                ((مرور == 0) == منشئ_أولوية)
                &&
                (*القسم).حي
                && قسم_إلف_محمل_تنفيذيا(القسم)
                && قسم_إلف_قابل_للكتابة_تنفيذيا(القسم) == قابلة_للكتابة
                && قسم_إلف_صفري_تنفيذيا(القسم) == صفرية
            ) {
                دع المحاذاة: متغير طبيعي = (*القسم).المحاذاة;
                إذا (المحاذاة == 0) { المحاذاة := 1; };
                إذا (صفرية) {
                    عنوان_الذاكرة := حاذ_قيمة_إلف(عنوان_الذاكرة, المحاذاة);
                } وإلا {
                    موضع_الملف := حاذ_قيمة_إلف(موضع_الملف, المحاذاة);
                    طالما (((موضع_الملف + انحياز_الجزء) % المحاذاة) != 0) {
                        موضع_الملف := موضع_الملف + 1;
                    }
                    عنوان_الذاكرة := موضع_الملف + انحياز_الجزء;
                };
                دع حجم_الملف: متغير طبيعي = (*القسم).الحجم;
                إذا (صفرية) { حجم_الملف := 0; };
                دع الموضع: موضع_قسم_خرج_ربط = {
                    القسم: (*القسم).المعرف,
                    إزاحة_الملف: موضع_الملف,
                    العنوان_الافتراضي: اختياري.موجود(عنوان_الذاكرة),
                    حجم_الملف: حجم_الملف,
                    حجم_الذاكرة: (*القسم).الحجم
                };
                أضف_موضع_قسم_خرج_ربط(التخطيط, الموضع);
                إذا (!صفرية) {
                    موضع_الملف := موضع_الملف + (*القسم).الحجم;
                };
                عنوان_الذاكرة := عنوان_الذاكرة + (*القسم).الحجم;
            };
            فهرس_القسم := فهرس_القسم + 1;
        }
        مرور := مرور + 1;
    }
    دع النتيجة: نتيجة_وضع_أقسام_إلف = {
        موضع_الملف: موضع_الملف,
        عنوان_الذاكرة: عنوان_الذاكرة
    };
    أرجع النتيجة;
}

عرف ضع_أقسام_إلف_غير_المحملة_تنفيذيا(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    البداية: طبيعي
): طبيعي {
    دع الموضع_الحالي: متغير طبيعي = البداية;
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        إذا ((*القسم).حي && !قسم_إلف_محمل_تنفيذيا(القسم)) {
            دع المحاذاة: متغير طبيعي = (*القسم).المحاذاة;
            إذا (المحاذاة == 0) { المحاذاة := 1; };
            الموضع_الحالي := حاذ_قيمة_إلف(الموضع_الحالي, المحاذاة);
            دع الموضع: موضع_قسم_خرج_ربط = {
                القسم: (*القسم).المعرف,
                إزاحة_الملف: الموضع_الحالي,
                العنوان_الافتراضي: اختياري.لا_شيء(),
                حجم_الملف: (*القسم).الحجم,
                حجم_الذاكرة: (*القسم).الحجم
            };
            أضف_موضع_قسم_خرج_ربط(التخطيط, الموضع);
            الموضع_الحالي := الموضع_الحالي + (*القسم).الحجم;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع الموضع_الحالي;
}

// The image's ELF class and byte order: ELFCLASS64 or ELFCLASS32 words,
// ELFDATA2LSB or ELFDATA2MSB fields.
نوع صيغة_صورة_إلف = {
    عرض_الكلمة: طبيعي,
    الترتيب: ترتيب_بايت
};

عرف صيغة_صورة_إلف_للهدف(الهدف: &واصف_هدف): صيغة_صورة_إلف {
    دع الصيغة: متغير صيغة_صورة_إلف = { عرض_الكلمة: 8, الترتيب: ترتيب_بايت.صغير() };
    طابق سياسة_إلف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(السياسة) -> {
        إذا (السياسة.الصنف == صنف_إلف_مدخل.اثنان_وثلاثون()) { الصيغة.عرض_الكلمة := 4; };
        الصيغة.الترتيب := ترتيب_بايت_من_سياسة_إلف(&السياسة);
    };
    أرجع الصيغة;
}

عرف ألحق_ط16_صورة_إلف(الناتج: &متغير متجه ط8, الصيغة: &صيغة_صورة_إلف, القيمة: طبيعي): فراغ {
    ألحق_ط16_إلف_بترتيب(الناتج, القيمة, (*الصيغة).الترتيب);
}

عرف ألحق_ط32_صورة_إلف(الناتج: &متغير متجه ط8, الصيغة: &صيغة_صورة_إلف, القيمة: طبيعي): فراغ {
    ألحق_ط32_إلف_بترتيب(الناتج, القيمة, (*الصيغة).الترتيب);
}

// An Elf32_Addr/Elf32_Off/Elf32_Word or Elf64_Addr/Elf64_Off/Elf64_Xword.
عرف ألحق_كلمة_صورة_إلف(الناتج: &متغير متجه ط8, الصيغة: &صيغة_صورة_إلف, القيمة: طبيعي): فراغ {
    إذا ((*الصيغة).عرض_الكلمة == 4) {
        ألحق_ط32_إلف_بترتيب(الناتج, القيمة, (*الصيغة).الترتيب);
    } وإلا {
        ألحق_ط64_إلف_بترتيب(الناتج, القيمة, (*الصيغة).الترتيب);
    };
}

عرف اكتب_كلمة_صورة_إلف_في(الناتج: &متغير متجه ط8, الصيغة: &صيغة_صورة_إلف, الموضع: طبيعي, القيمة: طبيعي): منطقي {
    إذا ((*الصيغة).عرض_الكلمة == 4) {
        إذا (القيمة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_ط32_إلف_بترتيب_في(الناتج, الموضع, القيمة, (*الصيغة).الترتيب);
    };
    أرجع اكتب_ط64_إلف_بترتيب_في(الناتج, الموضع, القيمة, (*الصيغة).الترتيب);
}

عرف اكتب_ط16_صورة_إلف_في(الناتج: &متغير متجه ط8, الصيغة: &صيغة_صورة_إلف, الموضع: طبيعي, القيمة: طبيعي): فراغ {
    دع المنخفض: ط8 = (القيمة & 0xFF) مثل ط8;
    دع العالي: ط8 = ((القيمة / 256) & 0xFF) مثل ط8;
    طابق (*الصيغة).الترتيب مع
    | ترتيب_بايت.صغير -> { (*الناتج)[الموضع] := المنخفض; (*الناتج)[الموضع + 1] := العالي; }
    | ترتيب_بايت.كبير -> { (*الناتج)[الموضع] := العالي; (*الناتج)[الموضع + 1] := المنخفض; };
}

// Elf64_Phdr puts p_flags after p_type; Elf32_Phdr puts it after p_memsz.
عرف ألحق_رأس_برنامج_إلف(
    الناتج: &متغير متجه ط8,
    الصيغة: &صيغة_صورة_إلف,
    النوع: طبيعي,
    الأعلام: طبيعي,
    موضع_الملف: طبيعي,
    العنوان: طبيعي,
    حجم_الملف: طبيعي,
    حجم_الذاكرة: طبيعي,
    المحاذاة: طبيعي
): فراغ {
    ألحق_ط32_صورة_إلف(الناتج, الصيغة, النوع);
    إذا ((*الصيغة).عرض_الكلمة == 8) { ألحق_ط32_صورة_إلف(الناتج, الصيغة, الأعلام); };
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, موضع_الملف);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, العنوان);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, العنوان);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, حجم_الملف);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, حجم_الذاكرة);
    إذا ((*الصيغة).عرض_الكلمة == 4) { ألحق_ط32_صورة_إلف(الناتج, الصيغة, الأعلام); };
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, المحاذاة);
}

عرف ألحق_رأس_قسم_إلف_كامل(
    الناتج: &متغير متجه ط8,
    الصيغة: &صيغة_صورة_إلف,
    موضع_الاسم: طبيعي,
    النوع: طبيعي,
    الأعلام: طبيعي,
    العنوان: طبيعي,
    موضع_الملف: طبيعي,
    الحجم: طبيعي,
    الرابط: طبيعي,
    المعلومات: طبيعي,
    المحاذاة: طبيعي,
    حجم_المدخل: طبيعي
): فراغ {
    ألحق_ط32_صورة_إلف(الناتج, الصيغة, موضع_الاسم);
    ألحق_ط32_صورة_إلف(الناتج, الصيغة, النوع);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, الأعلام);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, العنوان);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, موضع_الملف);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, الحجم);
    ألحق_ط32_صورة_إلف(الناتج, الصيغة, الرابط);
    ألحق_ط32_صورة_إلف(الناتج, الصيغة, المعلومات);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, المحاذاة);
    ألحق_كلمة_صورة_إلف(الناتج, الصيغة, حجم_المدخل);
}

عرف ألحق_رأس_قسم_إلف(
    الناتج: &متغير متجه ط8,
    الصيغة: &صيغة_صورة_إلف,
    موضع_الاسم: طبيعي,
    النوع: طبيعي,
    الأعلام: طبيعي,
    العنوان: طبيعي,
    موضع_الملف: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي
): فراغ {
    ألحق_رأس_قسم_إلف_كامل(
        الناتج,
        الصيغة,
        موضع_الاسم,
        النوع,
        الأعلام,
        العنوان,
        موضع_الملف,
        الحجم,
        0,
        0,
        المحاذاة,
        0
    );
}

عرف فهرس_قسم_إلف_مرئي(
    السياق: &سياق_ربط,
    المعرف: معرف_قسم_ربط
): اختياري طبيعي {
    دع الفهرس_المرئي: متغير طبيعي = 1;
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس_القسم].حي) {
            إذا ((*السياق).الأقسام[فهرس_القسم].المعرف.القيمة == المعرف.القيمة) {
                أرجع اختياري.موجود(الفهرس_المرئي);
            };
            الفهرس_المرئي := الفهرس_المرئي + 1;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ألحق_رمز_ديناميكي_إلف64(
    الناتج: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الرمز: &رمز_ديناميكي_إلف_ربط
): منطقي {
    دع المعلومات: متغير طبيعي = 0x10;
    دع فهرس_القسم: متغير طبيعي = 0;
    دع القيمة: متغير طبيعي = 0;
    دع الحجم: متغير طبيعي = 0;
    طابق (*الرمز).التعريف مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(التعريف) -> {
        إذا (!قوة_تعريف_رمز_ربط_قوية(التعريف.القوة)) {
            المعلومات := 0x20;
        };
        الحجم := التعريف.الحجم;
        طابق التعريف.الموضع مع
        | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
            طابق فهرس_قسم_إلف_مرئي(السياق, معرف_القسم) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الفهرس) -> { فهرس_القسم := الفهرس; };
            دع التخطيط: تخطيط_خرج_ربط;
            طابق (*السياق).التخطيط مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(خريطة) -> { التخطيط := خريطة; };
            طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(موضع_القسم) -> {
                طابق موضع_القسم.العنوان_الافتراضي مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(العنوان) -> { القيمة := العنوان + الإزاحة; };
            };
        }
        | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> {
            فهرس_القسم := 0xFFF1;
            القيمة := العنوان;
        }
        | موضع_تعريف_رمز_ربط.غير_محدد -> { أرجع خطأ; };
    };
    ألحق_ط32_إلف_ربط(الناتج, (*الرمز).إزاحة_الاسم);
    ألحق_بايت_إلف(الناتج, المعلومات);
    ألحق_بايت_إلف(الناتج, 0);
    ألحق_ط16_إلف_ربط(الناتج, فهرس_القسم);
    ألحق_ط64_إلف_ربط(الناتج, القيمة);
    ألحق_ط64_إلف_ربط(الناتج, الحجم);
    أرجع صواب;
}

عرف ألحق_مدخل_ديناميكي_إلف64(
    الناتج: &متغير متجه ط8,
    النوع: طبيعي,
    القيمة: طبيعي
): فراغ {
    ألحق_ط64_إلف_ربط(الناتج, النوع);
    ألحق_ط64_إلف_ربط(الناتج, القيمة);
}

عرف قيمة_قاعدة_مرجع_إلف(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط
): اختياري طبيعي {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(معرف_القسم) -> {
        دع الموضع: موضع_قسم_خرج_ربط;
        دع التخطيط: تخطيط_خرج_ربط;
        طابق (*السياق).التخطيط مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الموضع := القيمة; };
        طابق الموضع.العنوان_الافتراضي مع
        | اختياري.موجود(العنوان) -> { أرجع اختياري.موجود(العنوان); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(0); };
    }
    | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
        دع الرمز: رمز_ربط;
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, معرف_الرمز) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الرمز := القيمة; };
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                أرجع اختياري.موجود(القيمة);
            }
            | موضع_تعريف_رمز_ربط.غير_محدد -> {
                أرجع اختياري.لا_شيء();
            }
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
                دع التخطيط: تخطيط_خرج_ربط;
                طابق (*السياق).التخطيط مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
                طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(موضع_القسم) -> {
                    طابق موضع_القسم.العنوان_الافتراضي مع
                    | اختياري.موجود(العنوان) -> {
                        أرجع اختياري.موجود(العنوان + الإزاحة);
                    }
                    | اختياري.لا_شيء -> {
                        أرجع اختياري.موجود(الإزاحة);
                    };
                };
            };
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف عنوان_موضع_رقعة_إلف(
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط
): اختياري طبيعي {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        طابق الموضع.العنوان_الافتراضي مع
        | اختياري.موجود(العنوان) -> {
            أرجع اختياري.موجود(العنوان + (*الحافة).الإزاحة);
        }
        | اختياري.لا_شيء -> {
            أرجع اختياري.موجود((*الحافة).الإزاحة);
        };
    };
}

// The ALU forms "binop r/m, reg" (ADD 03, OR 0B, ADC 13, SBB 1B, AND 23,
// SUB 2B, XOR 33, CMP 3B) and TEST (85) whose GOTPCRELX load an executable
// link rewrites to an immediate, as GNU ld does.
عرف شفرة_حسابية_جوت_قابلة_للإرخاء_إلف(الشفرة: ط8): منطقي {
    أرجع الشفرة == 0x85 || (الشفرة | 0x38) == 0x3B;
}

// Local GOT slots (x86-64): the locally defined symbols that GOT-relative
// relocations (GOTPCREL, GOTPCRELX, REX_GOTPCRELX) name, in first-reference
// order. A reference the linker can relax (MOV to LEA, binop to an
// immediate) does not use its slot; any other instruction (an SSE load, a
// PUSH, an indirect CALL) reads the slot, which holds the symbol's address,
// as GNU ld and lld allocate .got entries. C objects compiled with -fPIC
// (static archives such as libsqlite3.a) use these forms.
عرف رموز_جوت_محلية_إلف(السياق: &سياق_ربط): متجه معرف_رمز_ربط {
    دع الناتج: متغير متجه معرف_رمز_ربط = [];
    دع المعمارية: هوية_معمارية = (*السياق).الهدف.المعمارية.الهوية;
    دع إكس64: منطقي = المعمارية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    إذا (!إكس64 && !صورة_إلف_ثابتة_منقولة(المعمارية)) {
        أرجع الناتج;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[ف];
        دع الصيغة: طبيعي = (*الحافة).رمز_صيغة مثل طبيعي;
        دع بخانة: متغير منطقي = الصيغة == 9 || الصيغة == 41 || الصيغة == 42;
        إذا (!إكس64) { بخانة := إزاحة_إلف_ثابتة_بخانة_جوت(المعمارية, الصيغة); };
        إذا (بخانة) {
            طابق (*الحافة).المرجع مع
            | مرجع_إزاحة_ربط.رمز(المعرف) -> {
                دع محلي: متغير منطقي = خطأ;
                طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
                | اختياري.موجود(الرمز) -> {
                    طابق الرمز.الحالة مع
                    | حالة_رمز_ربط.غير_معرف(_) -> { }
                    | حالة_رمز_ربط.ديناميكي(_) -> { }
                    | _ -> { محلي := صواب; };
                }
                | اختياري.لا_شيء -> { };
                إذا (محلي) {
                    دع موجود: متغير منطقي = خطأ;
                    دع ك: متغير طبيعي = 0;
                    طالما (ك < (الطول(الناتج) مثل طبيعي)) {
                        إذا (الناتج[ك].القيمة == المعرف.القيمة) { موجود := صواب; };
                        ك := ك + 1;
                    }
                    إذا (!موجود) { ألحق(الناتج, المعرف); };
                };
            }
            | _ -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The slot index of المرجع's symbol among رموز_جوت_محلية_إلف.
عرف فهرس_جوت_محلي_إلف(السياق: &سياق_ربط, المرجع: &مرجع_إزاحة_ربط): اختياري طبيعي {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.رمز(المعرف) -> {
        دع الرموز: متجه معرف_رمز_ربط = رموز_جوت_محلية_إلف(السياق);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الرموز) مثل طبيعي)) {
            إذا (الرموز[ف].القيمة == المعرف.القيمة) { أرجع اختياري.موجود(ف); };
            ف := ف + 1;
        }
        أرجع اختياري.لا_شيء();
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف اكتب_إزاحة_إلف_إكس64_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_إلف_ربط,
    عنوان_بلت: طبيعي,
    عنوان_جوت: طبيعي,
    عنوان_جوت_المحلي: طبيعي
): نتيجة_صورة_إلف_تنفيذية {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع موضع_القسم: موضع_قسم_خرج_ربط;
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };

    // Relocations must fit inside their own live input section, not merely
    // inside the eventual output image. Check subtraction before addition to
    // reject out-of-range records without unsigned-address wraparound.
    دع عرض_الرقعة: متغير طبيعي = 4;
    إذا ((*الحافة).رمز_صيغة == 1) { عرض_الرقعة := 8; };
    إذا ((*الحافة).الإزاحة > موضع_القسم.حجم_الملف
        || عرض_الرقعة > موضع_القسم.حجم_الملف - (*الحافة).الإزاحة
        || موضع_القسم.إزاحة_الملف > (الطول(*الصورة) مثل طبيعي)
        || عرض_الرقعة > (الطول(*الصورة) مثل طبيعي) - موضع_القسم.إزاحة_الملف
        || (*الحافة).الإزاحة > (الطول(*الصورة) مثل طبيعي)
            - موضع_القسم.إزاحة_الملف - عرض_الرقعة) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
        );
    };
    دع موضع_الكتابة: طبيعي =
        موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة;
    دع هدف_الرقعة: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع معرف_ديناميكي: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();
    طابق (*الحافة).المرجع مع
    | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, معرف_الرمز) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة.الحالة مع
            | حالة_رمز_ربط.غير_معرف(_) -> {
                معرف_ديناميكي := اختياري.موجود(معرف_الرمز);
            }
            | حالة_رمز_ربط.ديناميكي(_) -> {
                معرف_ديناميكي := اختياري.موجود(معرف_الرمز);
            }
            | _ -> {
                هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
                    السياق,
                    &(*الحافة).المرجع
                );
            };
        };
    }
    | مرجع_إزاحة_ربط.قسم(_) -> {
        هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
            السياق,
            &(*الحافة).المرجع
        );
    };

    // Loader-owned R_X86_64_64 records are placed in .rela.dyn below.
    // Never manufacture a link-time PLT address for imported data.
    إذا ((*الحافة).رمز_صيغة == 1
        && إزاحة_بيانات_ديناميكية_مطلقة_إلف(السياق, الحافة)) {
        // A section the loader does not map (debug information: LLVM
        // describes an external variable at its symbol's address) has no
        // run-time address to fill: the field is 0, as GNU ld and LLD leave
        // it.
        طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
        | اختياري.موجود(قسم_الحقل) -> {
            إذا (!قسم_إلف_محمل_تنفيذيا(&قسم_الحقل)) {
                دع ب: متغير طبيعي = 0;
                طالما (ب < 8) { (*الصورة)[موضع_الكتابة + ب] := 0; ب := ب + 1; }
                دع لا_رقعة_غير_محمل: متجه ط8 = [];
                أرجع نتيجة_صورة_إلف_تنفيذية.نجح(لا_رقعة_غير_محمل);
            };
        }
        | اختياري.لا_شيء -> { };
        طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختياري.موجود(القسم) -> {
            إذا (!قسم_إلف_قابل_للكتابة_تنفيذيا(&القسم)
                || !قسم_إلف_محمل_تنفيذيا(&القسم)) {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                );
            };
        };
        دع لا_رقعة: متجه ط8 = [];
        أرجع نتيجة_صورة_إلف_تنفيذية.نجح(لا_رقعة);
    };

    طابق معرف_ديناميكي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(معرف_الرمز) -> {
        دع ترتيب_الرمز: طبيعي;
        طابق ابحث_ترتيب_رمز_ديناميكي_إلف(
            الرموز_الديناميكية,
            معرف_الرمز
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                    اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
                )
            );
        }
        | اختياري.موجود(الترتيب) -> { ترتيب_الرمز := الترتيب; };
        // Imported R_X86_64_PC32 has no generic PLT/GOT guarantee: LEA
        // of an external data symbol needs a backend-emitted GOT reference.
        // Only R_X86_64_PLT32 is known to target a callable PLT entry.
        إذا ((*الحافة).رمز_صيغة == 2) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
            );
        };
        إذا ((*الحافة).رمز_صيغة == 4) {
            هدف_الرقعة := اختياري.موجود(
                عنوان_بلت + (ترتيب_الرمز + 1) * 16
            );
        } وإلا إذا (
            (*الحافة).رمز_صيغة == 9
                || (*الحافة).رمز_صيغة == 41
                || (*الحافة).رمز_صيغة == 42
        ) {
            هدف_الرقعة := اختياري.موجود(
                عنوان_جوت + (ترتيب_الرمز + 3) * 8
            );
        } وإلا {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
            );
        };
    };

    دع عنوان_الهدف: متغير طبيعي = 0;
    طابق هدف_الرقعة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
            )
        );
    }
    | اختياري.موجود(القيمة) -> { عنوان_الهدف := القيمة; };

    // Local GOTPCRELX/REX_GOTPCRELX MOV references require relaxation:
    // there is no GOT slot for a local symbol. Confirm the RIP-relative MOV
    // encoding and keep the rewritten opcode inside the input code section.
    // Unsupported indirect-call or non-MOV relaxations must not be patched as
    // though they were ordinary PC32 relocations.
    // Plain R_X86_64_GOTPCREL (9) gets the same treatment for a verified
    // `mov reg, foo@GOTPCREL(%rip)` only (binutils 2.25 converted exactly
    // this form): the GOT slot would hold foo's address, which `lea`
    // computes. Any other instruction is an error; patching it as PC32
    // would read foo's contents where the code expects its address.
    إذا ((*الحافة).رمز_صيغة == 9 || (*الحافة).رمز_صيغة == 41 || (*الحافة).رمز_صيغة == 42) {
        طابق معرف_ديناميكي مع
        | اختياري.لا_شيء -> {
            إذا ((*الحافة).الإزاحة < 2) {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                );
            };
            دع موضع_التعليمة: طبيعي = موضع_الكتابة - 2;
            دع نمط_المعامل: ط8 = (*الصورة)[موضع_الكتابة - 1];
            دع الشفرة: ط8 = (*الصورة)[موضع_التعليمة];
            إذا ((نمط_المعامل & 0xC7) != 0x05) {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                );
            };
            إذا ((*الحافة).رمز_صيغة == 42) {
                إذا ((*الحافة).الإزاحة < 3
                    || ((*الصورة)[موضع_الكتابة - 3] & 0xF8) != 0x48) {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
            };
            إذا (الشفرة == 0x8B) {
                (*الصورة)[موضع_التعليمة] := 0x8D;
            } وإلا إذا ((*الحافة).رمز_صيغة == 9) {
                // Not a MOV: the instruction reads the symbol's GOT slot.
                طابق فهرس_جوت_محلي_إلف(السياق, &(*الحافة).المرجع) مع
                | اختياري.موجود(الخانة) -> { عنوان_الهدف := عنوان_جوت_المحلي + الخانة * 8; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
            } وإلا إذا (شفرة_حسابية_جوت_قابلة_للإرخاء_إلف(الشفرة)
                && (*السياق).الخطة.الخرج == نوع_خرج_ربط.تنفيذي()) {
                // GNU ld (elf_x86_64_convert_load_reloc): in an executable,
                // "binop foo@GOTPCREL(%rip), %reg" becomes "binop $foo, %reg"
                // and "test %reg, foo@GOTPCREL(%rip)" becomes
                // "test $foo, %reg". The immediate takes the displacement's
                // place, the register moves from ModRM.reg to ModRM.rm and
                // REX.R to REX.B, and the value is the symbol's address with
                // no addend (the addend only adjusted the PC-relative form).
                // With REX.W the immediate is sign-extended to 64 bits.
                إذا ((*الحافة).رمز_صيغة == 42) {
                    إذا (عنوان_الهدف >= 0x80000000) {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    };
                } وإلا إذا (عنوان_الهدف > 0xFFFFFFFF) {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                دع السجل: ط8 = (نمط_المعامل & 0x38) >> 3;
                إذا (الشفرة == 0x85) {
                    (*الصورة)[موضع_التعليمة] := 0xF7;
                    (*الصورة)[موضع_الكتابة - 1] := 0xC0 | السجل;
                } وإلا {
                    (*الصورة)[موضع_التعليمة] := 0x81;
                    (*الصورة)[موضع_الكتابة - 1] :=
                        0xC0 | السجل | (الشفرة & 0x38);
                };
                إذا ((*الحافة).رمز_صيغة == 42) {
                    دع البادئة: ط8 = (*الصورة)[موضع_الكتابة - 3];
                    (*الصورة)[موضع_الكتابة - 3] :=
                        (البادئة & 0xFA) | ((البادئة & 0x04) >> 2);
                };
                إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, عنوان_الهدف)) {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                دع لا_بايتات: متجه ط8 = [];
                أرجع نتيجة_صورة_إلف_تنفيذية.نجح(لا_بايتات);
            } وإلا {
                // Not relaxable (an indirect CALL/JMP, a PUSH, an SSE load):
                // the instruction reads the symbol's GOT slot.
                طابق فهرس_جوت_محلي_إلف(السياق, &(*الحافة).المرجع) مع
                | اختياري.موجود(الخانة) -> { عنوان_الهدف := عنوان_جوت_المحلي + الخانة * 8; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
            };
        }
        | اختياري.موجود(_) -> { };
    };

    إذا ((*الحافة).رمز_صيغة == 1) {
        دع القيمة: طبيعي;
        طابق اجمع_إضافة_إلف(عنوان_الهدف, (*الحافة).إضافة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختياري.موجود(الناتج) -> { القيمة := الناتج; };
        إذا (!اكتب_ط64_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 2
            || (*الحافة).رمز_صيغة == 4
            || (*الحافة).رمز_صيغة == 9
            || (*الحافة).رمز_صيغة == 41
            || (*الحافة).رمز_صيغة == 42
    ) {
        دع عنوان_الرقعة: طبيعي;
        طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختياري.موجود(القيمة) -> { عنوان_الرقعة := القيمة; };
        دع القيمة: طبيعي;
        طابق فرق_نسبي_ص32_إلف(
            عنوان_الرقعة,
            عنوان_الهدف,
            (*الحافة).إضافة
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختياري.موجود(الناتج) -> { القيمة := الناتج; };
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 10 || (*الحافة).رمز_صيغة == 11
    ) {
        دع القيمة: طبيعي;
        دع نتيجة_القيمة: اختياري طبيعي;
        إذا ((*الحافة).رمز_صيغة == 11) {
            نتيجة_القيمة := قيمة_مطلقة_ص32_موقعة_إلف(
                عنوان_الهدف, (*الحافة).إضافة
            );
        } وإلا {
            نتيجة_القيمة := اجمع_إضافة_إلف(عنوان_الهدف, (*الحافة).إضافة);
        };
        طابق نتيجة_القيمة مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختياري.موجود(الناتج) -> { القيمة := الناتج; };
        إذا ((*الحافة).رمز_صيغة == 10 && القيمة > 0xFFFFFFFF) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
        );
    };

    دع بايتات_فارغة: متجه ط8 = [];
    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(بايتات_فارغة);
}


عرف آلة_إلف64_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(62);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(183); }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع اختياري.موجود(243); }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { أرجع اختياري.موجود(258); }
    | _ -> {
        // The static images' machines (EM_386, EM_ARM, EM_S390, EM_SPARCV9,
        // EM_PPC64, EM_MIPS) as the target policy records them.
        إذا (!صورة_إلف_ثابتة_منقولة((*الهدف).المعمارية.الهوية)) { أرجع اختياري.لا_شيء(); };
        طابق سياسة_إلف_للهدف(الهدف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(السياسة) -> { أرجع اختياري.موجود(السياسة.الآلة); };
    };
}

// e_flags of the image: the registered targets' ABI as their objects carry
// it (RISC-V: RVC and the double-float ABI; LoongArch: LP64D, object v1).
عرف أعلام_إلف_للهدف(الهدف: &واصف_هدف): طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع 0x5; }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { أرجع 0x43; }
    | _ -> { أرجع 0; };
}

عرف حجم_بلت_إلف_للهدف(
    الهدف: &واصف_هدف,
    عدد_الاستيرادات: طبيعي
): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود((عدد_الاستيرادات + 1) * 16);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(32 + عدد_الاستيرادات * 16);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عنوان_مدخل_بلت_إلف(
    الهدف: &واصف_هدف,
    عنوان_بلت: طبيعي,
    الترتيب: طبيعي
): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(عنوان_بلت + (الترتيب + 1) * 16);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(عنوان_بلت + 32 + الترتيب * 16);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نوع_قفزة_بلت_إلف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(7);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(1026); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف كود_فرق_صفحة_إلف_ذراع64(
    المصدر: طبيعي,
    الوجهة: طبيعي
): اختياري طبيعي {
    دع صفحة_المصدر: طبيعي = المصدر / 4096;
    دع صفحة_الوجهة: طبيعي = الوجهة / 4096;
    إذا (صفحة_الوجهة >= صفحة_المصدر) {
        دع الفرق: طبيعي = صفحة_الوجهة - صفحة_المصدر;
        إذا (الفرق > 0xFFFFF) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الفرق);
    };
    دع الفرق: طبيعي = صفحة_المصدر - صفحة_الوجهة;
    إذا (الفرق > 0x100000) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(0x200000 - الفرق);
}

عرف رقع_صفحة21_إلف_ذراع64(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع كود_الصفحة: طبيعي;
    طابق كود_فرق_صفحة_إلف_ذراع64(المصدر, الوجهة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { كود_الصفحة := القيمة; };
    دع الأصل: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع);
    // ADRP is the only instruction that has the page-relative immediate
    // encoding used by these relocations. Reject an invalid instruction
    // rather than corrupting unrelated instruction fields.
    إذا ((الأصل & 0x9F000000) != 0x90000000 || (المصدر % 4) != 0) {
        أرجع خطأ;
    };
    دع المنخفض: طبيعي = (كود_الصفحة & 3) << 29;
    دع العالي: طبيعي = ((كود_الصفحة >> 2) & 0x7FFFF) << 5;
    دع الجديد: طبيعي =
        (الأصل & 0x9F00001F) | المنخفض | العالي;
    أرجع اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد);
}

عرف رقع_منخفض12_إلف_ذراع64(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع الأصل: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع);
    دع منخفض: طبيعي = الوجهة % 4096;
    دع الفوري: متغير طبيعي = منخفض;
    إذا ((الأصل & 0x3B000000) == 0x39000000) {
        // Unsigned-immediate loads/stores scale the offset by access size.
        دع أس_المقياس: طبيعي = (الأصل >> 30) & 3;
        دع المقياس: طبيعي = 1 << أس_المقياس;
        إذا ((منخفض % المقياس) != 0) { أرجع خطأ; };
        الفوري := منخفض / المقياس;
    } وإلا إذا ((الأصل & 0x7F800000) == 0x11000000) {
        // ADD (immediate) must use an unshifted low-12-bit field.
        إذا ((الأصل & 0x00400000) != 0) { أرجع خطأ; };
    } وإلا {
        أرجع خطأ;
    };
    دع الجديد: طبيعي =
        (الأصل & 0xFFC003FF) | ((الفوري & 0xFFF) << 10);
    أرجع اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد);
}

عرف رقع_فرع26_إلف_ذراع64(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع الأصل: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع);
    إذا ((المصدر % 4) != 0) { أرجع خطأ; };
    دع الفوري: متغير طبيعي = 0;
    إذا (الوجهة >= المصدر) {
        دع الفرق: طبيعي = الوجهة - المصدر;
        إذا ((الفرق % 4) != 0 || (الفرق / 4) > 0x1FFFFFF) {
            أرجع خطأ;
        };
        الفوري := الفرق / 4;
    } وإلا {
        دع الفرق: طبيعي = المصدر - الوجهة;
        إذا ((الفرق % 4) != 0 || (الفرق / 4) > 0x2000000) {
            أرجع خطأ;
        };
        الفوري := (0x4000000 - (الفرق / 4)) & 0x3FFFFFF;
    };
    دع الجديد: طبيعي =
        (الأصل & 0xFC000000) | (الفوري & 0x03FFFFFF);
    أرجع اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد);
}

عرف ابن_بلت_إلف_ذراع64(
    عدد_الاستيرادات: طبيعي,
    عنوان_بلت: طبيعي,
    عنوان_جوت: طبيعي
): اختياري متجه ط8 {
    دع بلت: متغير متجه ط8 = [];
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xA9BF7BF0);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0x90000010);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xF9400211);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0x91000210);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xD61F0220);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xD503201F);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xD503201F);
    ألحق_ط32_إلف_ربط(&متغير بلت, 0xD503201F);
    إذا (!رقع_صفحة21_إلف_ذراع64(
        &متغير بلت,
        4,
        عنوان_بلت + 4,
        عنوان_جوت + 16
    )) { أرجع اختياري.لا_شيء(); };
    إذا (!رقع_منخفض12_إلف_ذراع64(&متغير بلت, 8, عنوان_جوت + 16)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (!رقع_منخفض12_إلف_ذراع64(&متغير بلت, 12, عنوان_جوت + 16)) {
        أرجع اختياري.لا_شيء();
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < عدد_الاستيرادات) {
        دع موضع_المدخل: طبيعي = الطول(بلت) مثل طبيعي;
        دع عنوان_المدخل: طبيعي = عنوان_بلت + موضع_المدخل;
        دع عنوان_مدخل_جوت: طبيعي = عنوان_جوت + (الفهرس + 3) * 8;
        ألحق_ط32_إلف_ربط(&متغير بلت, 0x90000010);
        ألحق_ط32_إلف_ربط(&متغير بلت, 0xF9400211);
        ألحق_ط32_إلف_ربط(&متغير بلت, 0x91000210);
        ألحق_ط32_إلف_ربط(&متغير بلت, 0xD61F0220);
        إذا (!رقع_صفحة21_إلف_ذراع64(
            &متغير بلت,
            موضع_المدخل,
            عنوان_المدخل,
            عنوان_مدخل_جوت
        )) { أرجع اختياري.لا_شيء(); };
        إذا (!رقع_منخفض12_إلف_ذراع64(
            &متغير بلت,
            موضع_المدخل + 4,
            عنوان_مدخل_جوت
        )) { أرجع اختياري.لا_شيء(); };
        إذا (!رقع_منخفض12_إلف_ذراع64(
            &متغير بلت,
            موضع_المدخل + 8,
            عنوان_مدخل_جوت
        )) { أرجع اختياري.لا_شيء(); };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.موجود(بلت);
}

عرف اكتب_إزاحة_إلف_ذراع64_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_إلف_ربط,
    عنوان_بلت: طبيعي,
    عنوان_جوت: طبيعي
): نتيجة_صورة_إلف_تنفيذية {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع موضع_القسم: موضع_قسم_خرج_ربط;
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };
    // Relocations must fit inside their own live input section, not merely
    // inside the eventual output image. Check subtraction before addition to
    // reject out-of-range records without unsigned-address wraparound.
    دع عرض_الرقعة: متغير طبيعي = 4;
    إذا ((*الحافة).رمز_صيغة == 257) { عرض_الرقعة := 8; };
    إذا ((*الحافة).الإزاحة > موضع_القسم.حجم_الملف
        || عرض_الرقعة > موضع_القسم.حجم_الملف - (*الحافة).الإزاحة
        || موضع_القسم.إزاحة_الملف > (الطول(*الصورة) مثل طبيعي)
        || عرض_الرقعة > (الطول(*الصورة) مثل طبيعي) - موضع_القسم.إزاحة_الملف
        || (*الحافة).الإزاحة > (الطول(*الصورة) مثل طبيعي)
            - موضع_القسم.إزاحة_الملف - عرض_الرقعة) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
        );
    };
    دع موضع_الكتابة: طبيعي =
        موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة;
    دع عنوان_الرقعة: طبيعي;
    طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { عنوان_الرقعة := القيمة; };
    دع هدف_الرقعة: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع معرف_ديناميكي: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();
    طابق (*الحافة).المرجع مع
    | مرجع_إزاحة_ربط.رمز(المعرف) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.غير_معرف(_) -> {
                معرف_ديناميكي := اختياري.موجود(المعرف);
            }
            | حالة_رمز_ربط.ديناميكي(_) -> {
                معرف_ديناميكي := اختياري.موجود(المعرف);
            }
            | _ -> {
                هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
                    السياق,
                    &(*الحافة).المرجع
                );
            };
        };
    }
    | مرجع_إزاحة_ربط.قسم(_) -> {
        هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
            السياق,
            &(*الحافة).المرجع
        );
    };
    دع هو_رمز_محلي_لجوت: متغير منطقي = صواب;
    طابق معرف_ديناميكي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(المعرف) -> {
        هو_رمز_محلي_لجوت := خطأ;
        دع الترتيب: طبيعي;
        طابق ابحث_ترتيب_رمز_ديناميكي_إلف(الرموز_الديناميكية, المعرف) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                    اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
                )
            );
        }
        | اختياري.موجود(القيمة) -> { الترتيب := القيمة; };
        إذا ((*الحافة).رمز_صيغة == 282 || (*الحافة).رمز_صيغة == 283) {
            طابق عنوان_مدخل_بلت_إلف(
                &(*السياق).الهدف,
                عنوان_بلت,
                الترتيب
            ) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(القيمة) -> { هدف_الرقعة := اختياري.موجود(القيمة); };
        } وإلا إذا (
            (*الحافة).رمز_صيغة == 311 || (*الحافة).رمز_صيغة == 312
        ) {
            هدف_الرقعة := اختياري.موجود(
                عنوان_جوت + (الترتيب + 3) * 8
            );
        };
    };
    دع عنوان_الهدف: طبيعي;
    طابق هدف_الرقعة مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
            )
        );
    }
    | اختياري.موجود(القيمة) -> { عنوان_الهدف := القيمة; };
    دع العنوان_المضاف: طبيعي;
    طابق اجمع_إضافة_إلف(عنوان_الهدف, (*الحافة).إضافة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
        );
    }
    | اختياري.موجود(القيمة) -> { العنوان_المضاف := القيمة; };
    // Check instruction relocations before touching the patched word.
    // ADRP, B/BL, ADD and scaled LD/ST have different immediate encodings.
    دع نوع_الإزاحة: طبيعي = (*الحافة).رمز_صيغة;
    إذا (نوع_الإزاحة == 275 || نوع_الإزاحة == 276 || نوع_الإزاحة == 311
        || نوع_الإزاحة == 277 || نوع_الإزاحة == 286 || نوع_الإزاحة == 312
        || نوع_الإزاحة == 282 || نوع_الإزاحة == 283
        || نوع_الإزاحة == 278 || نوع_الإزاحة == 284 || نوع_الإزاحة == 285
        || نوع_الإزاحة == 299) {
        إذا ((عنوان_الرقعة % 4) != 0) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        دع التعليمة: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, موضع_الكتابة);
        دع صالحة: متغير منطقي = صواب;
        إذا (نوع_الإزاحة == 275 || نوع_الإزاحة == 276 || نوع_الإزاحة == 311) {
            صالحة := (التعليمة & 0x9F000000) == 0x90000000;
        } وإلا إذا (نوع_الإزاحة == 277) {
            صالحة := (التعليمة & 0x7F800000) == 0x11000000
                && (التعليمة & 0x00400000) == 0;
        } وإلا إذا (نوع_الإزاحة == 286) {
            صالحة := (التعليمة & 0x3B000000) == 0x39000000
                && ((التعليمة >> 30) & 3) == 3;
        } وإلا إذا (نوع_الإزاحة == 278 || نوع_الإزاحة == 284 || نوع_الإزاحة == 285 || نوع_الإزاحة == 299) {
            // LDST8/16/32/128_ABS_LO12_NC: a load or store with an unsigned
            // 12-bit immediate (general or SIMD&FP register), as LLVM emits
            // at -O2 for byte, half, word and vector-constant accesses.
            صالحة := (التعليمة & 0x3B000000) == 0x39000000;
        } وإلا إذا (نوع_الإزاحة == 312) {
            صالحة := (التعليمة & 0xFFC00000) == 0xF9400000;
        } وإلا إذا (نوع_الإزاحة == 282) {
            صالحة := (التعليمة & 0xFC000000) == 0x14000000;
        } وإلا إذا (نوع_الإزاحة == 283) {
            صالحة := (التعليمة & 0xFC000000) == 0x94000000;
        };
        إذا (!صالحة) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
            );
        };
    };
    إذا ((*الحافة).رمز_صيغة == 257) {
        إذا (!اكتب_ط64_إلف_ربط_في(الصورة, موضع_الكتابة, العنوان_المضاف)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا ((*الحافة).رمز_صيغة == 261) {
        دع الفرق: طبيعي;
        طابق فرق_نسبي_ص32_إلف(
            عنوان_الرقعة,
            عنوان_الهدف,
            (*الحافة).إضافة
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختياري.موجود(القيمة) -> { الفرق := القيمة; };
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, الفرق)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 282 || (*الحافة).رمز_صيغة == 283
    ) {
        إذا (!رقع_فرع26_إلف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_الرقعة,
            العنوان_المضاف
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 275
            || (*الحافة).رمز_صيغة == 276
            || (*الحافة).رمز_صيغة == 311
    ) {
        إذا (!رقع_صفحة21_إلف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_الرقعة,
            العنوان_المضاف
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 312 && هو_رمز_محلي_لجوت
    ) {
        // A locally defined symbol has no GOT slot. ADRP already selects the
        // symbol's page (R_AARCH64_ADR_GOT_PAGE above), so relax
        // `ldr xT, [xN, #:got_lo12:sym]` into `add xT, xN, #:lo12:sym`, the
        // same relaxation the x86-64 path applies to GOTPCRELX MOV -> LEA.
        دع التعليمة: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, موضع_الكتابة);
        دع المسجلان: طبيعي = التعليمة & 0x3FF;
        دع المنخفض: طبيعي = العنوان_المضاف % 4096;
        دع الجمع: طبيعي = 0x91000000 | (المنخفض << 10) | المسجلان;
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, الجمع)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا ((*الحافة).رمز_صيغة == 278 || (*الحافة).رمز_صيغة == 284
        || (*الحافة).رمز_صيغة == 285 || (*الحافة).رمز_صيغة == 299) {
        // The access size comes from the relocation: 1, 2, 4 or 16 bytes.
        دع المقياس: متغير طبيعي = 1;
        إذا ((*الحافة).رمز_صيغة == 284) { المقياس := 2; };
        إذا ((*الحافة).رمز_صيغة == 285) { المقياس := 4; };
        إذا ((*الحافة).رمز_صيغة == 299) { المقياس := 16; };
        دع المنخفض: طبيعي = العنوان_المضاف % 4096;
        إذا ((المنخفض % المقياس) != 0) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        دع الأصل: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, موضع_الكتابة);
        دع الجديد: طبيعي = (الأصل & 0xFFC003FF) | (((المنخفض / المقياس) & 0xFFF) << 10);
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, الجديد)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا (
        (*الحافة).رمز_صيغة == 277
            || (*الحافة).رمز_صيغة == 286
            || (*الحافة).رمز_صيغة == 312
    ) {
        إذا (!رقع_منخفض12_إلف_ذراع64(
            الصورة,
            موضع_الكتابة,
            العنوان_المضاف
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا إذا ((*الحافة).رمز_صيغة == 258) {
        // R_AARCH64_ABS32 (DWARF section offsets/addresses): S + A must fit
        // in 32 bits, as for R_X86_64_32 above.
        إذا (العنوان_المضاف > 0xFFFFFFFF) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        إذا (!اكتب_ط32_إلف_ربط_في(الصورة, موضع_الكتابة, العنوان_المضاف)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
        );
    };
    دع فارغ: متجه ط8 = [];
    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ);
}

// The signed distance الهدف - المصدر between two image addresses,
// saturated so that a distance past 63 bits fails every range check.
عرف فرق_موقع_إلف(الهدف: طبيعي, المصدر: طبيعي): عدد {
    إذا (الهدف >= المصدر) {
        إذا (الهدف - المصدر > 0x3FFFFFFFFFFFFFFF) { أرجع 0x3FFFFFFFFFFFFFFF; };
        أرجع (الهدف - المصدر) مثل عدد;
    };
    إذا (المصدر - الهدف > 0x3FFFFFFFFFFFFFFF) { أرجع -0x3FFFFFFFFFFFFFFF; };
    أرجع -((المصدر - الهدف) مثل عدد);
}

// Bits [المنخفض, المنخفض + العدد) of a signed value, as an unsigned field.
عرف حقل_بتات_إلف(القيمة: عدد, المنخفض: طبيعي, العدد: طبيعي): طبيعي {
    دع القناع: طبيعي = (1 << العدد) - 1;
    دع مزاح: عدد = القيمة >> (المنخفض مثل عدد);
    أرجع (مزاح & (القناع مثل عدد)) مثل طبيعي;
}

// Whether a signed value fits in البتات bits.
عرف يتسع_بإشارة_إلف(القيمة: عدد, البتات: طبيعي): منطقي {
    دع الحد: عدد = 1 << ((البتات - 1) مثل عدد);
    أرجع القيمة >= -الحد && القيمة < الحد;
}

// S + A of a static relocation, or none when the symbol is not defined in
// the image (these targets have no PLT or dynamic symbols here).
عرف هدف_إزاحة_ثابتة_إلف(السياق: &سياق_ربط, الحافة: &حافة_إزاحة_ربط): اختياري طبيعي {
    طابق قيمة_قاعدة_مرجع_إلف(السياق, &(*الحافة).المرجع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأساس) -> { أرجع اجمع_إضافة_إلف(الأساس, (*الحافة).إضافة); };
}

// RISC-V PCREL_LO12: the relocation names the label of its AUIPC, whose
// PCREL_HI20 gives the PC-relative distance; the low part is that
// distance less the high part.
عرف بعد_عال_مقترن_رايسك_إلف(
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    عنوان_التسمية: طبيعي
): اختياري عدد {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع العالية: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[ف];
        إذا ((*العالية).رمز_صيغة == 23 && (*العالية).القسم.القيمة == (*الحافة).القسم.القيمة) {
            طابق عنوان_موضع_رقعة_إلف(السياق, العالية) مع
            | اختياري.موجود(موضعها) -> {
                إذا (موضعها == عنوان_التسمية) {
                    طابق هدف_إزاحة_ثابتة_إلف(السياق, العالية) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(الهدف) -> { أرجع اختياري.موجود(فرق_موقع_إلف(الهدف, موضعها)); };
                };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The 20-bit high part (rounded for the sign-extended low 12 bits) and the
// low 12 bits of a value split across lui/auipc and an I- or S-type
// immediate.
عرف عال20_إلف(القيمة: عدد): عدد { أرجع (القيمة + 0x800) >> 12; }
عرف منخفض12_إلف(القيمة: عدد): عدد { أرجع ((القيمة & 0xFFF) ^ 0x800) - 0x800; }

عرف رقع_نوع_يو_رايسك(التعليمة: طبيعي, القيمة: عدد): طبيعي {
    أرجع (التعليمة & 0xFFF) | (حقل_بتات_إلف(عال20_إلف(القيمة), 0, 20) << 12);
}
عرف رقع_نوع_آي_رايسك(التعليمة: طبيعي, المنخفض: عدد): طبيعي {
    أرجع (التعليمة & 0xFFFFF) | (حقل_بتات_إلف(المنخفض, 0, 12) << 20);
}
عرف رقع_نوع_إس_رايسك(التعليمة: طبيعي, المنخفض: عدد): طبيعي {
    أرجع (التعليمة & 0x1FFF07F) | (حقل_بتات_إلف(المنخفض, 5, 7) << 25) | (حقل_بتات_إلف(المنخفض, 0, 5) << 7);
}

// Static relocations of RISC-V (lp64d) and LoongArch (lp64d) executables:
// the absolute and PC-relative forms LLVM emits for SultanC's static code
// model. LoongArch GOT loads of symbols the image defines become address
// computations (ld.d -> addi.d), as lld relaxes them; no GOT is laid out.
// R_RISCV_RELAX and R_RISCV_ALIGN need no action when nothing is relaxed:
// the alignment padding is executable NOPs.
عرف اكتب_إزاحة_إلف_ثابتة_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط
): نتيجة_صورة_إلف_تنفيذية {
    دع فارغ: متجه ط8 = [];
    دع النوع: طبيعي = (*الحافة).رمز_صيغة;
    دع رايسك: منطقي = (*السياق).الهدف.المعمارية.الهوية == هوية_معمارية.رايسك_في_أربعة_وستون();
    إذا (النوع == 0) { أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ); };
    إذا (رايسك && (النوع == 51 || النوع == 43)) { أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ); };
    إذا (!رايسك && (النوع == 100 || النوع == 102)) { أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ); };
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع موضع_القسم: موضع_قسم_خرج_ربط;
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };
    // The patched field (8 bytes at most: a 64-bit word, or an AUIPC/JALR
    // or PCADDU18I/JIRL pair) must lie inside the section.
    دع عرض_الرقعة: متغير طبيعي = 4;
    إذا (النوع == 2 || (رايسك && (النوع == 18 || النوع == 19)) || (!رايسك && (النوع == 110 || النوع == 109))) {
        عرض_الرقعة := 8;
    };
    إذا (رايسك && (النوع == 44 || النوع == 45)) { عرض_الرقعة := 2; };
    إذا ((*الحافة).الإزاحة > موضع_القسم.حجم_الملف
        || عرض_الرقعة > موضع_القسم.حجم_الملف - (*الحافة).الإزاحة
        || موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة + عرض_الرقعة > (الطول(*الصورة) مثل طبيعي)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق());
    };
    دع الموضع: طبيعي = موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة;
    دع عنوان_الرقعة: طبيعي;
    طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { عنوان_الرقعة := القيمة; };
    دع الهدف_المضاف: طبيعي;
    طابق هدف_إزاحة_ثابتة_إلف(السياق, الحافة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
            اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)));
    }
    | اختياري.موجود(القيمة) -> { الهدف_المضاف := القيمة; };
    دع البعد: عدد = فرق_موقع_إلف(الهدف_المضاف, عنوان_الرقعة);
    دع التعليمة: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع);
    دع كتب: متغير منطقي = صواب;
    دع في_النطاق: متغير منطقي = صواب;
    دع مدعومة: متغير منطقي = صواب;

    // Shared data forms: 32 and 64 bits absolute, 32 bits PC-relative.
    إذا (النوع == 2) {
        كتب := اكتب_ط64_إلف_ربط_في(الصورة, الموضع, الهدف_المضاف);
    } وإلا إذا (النوع == 1) {
        في_النطاق := الهدف_المضاف <= 0xFFFFFFFF;
        إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الهدف_المضاف); };
    } وإلا إذا ((رايسك && النوع == 57) || (!رايسك && النوع == 99)) {
        في_النطاق := يتسع_بإشارة_إلف(البعد, 32);
        إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, حقل_بتات_إلف(البعد, 0, 32)); };
    } وإلا إذا (رايسك) {
        دع القيمة: عدد = فرق_موقع_إلف(الهدف_المضاف, 0);
        إذا (النوع == 18 || النوع == 19) {
            // AUIPC + JALR.
            في_النطاق := يتسع_بإشارة_إلف(البعد + 0x800, 32);
            دع التالية: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع + 4);
            إذا (في_النطاق) {
                كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_يو_رايسك(التعليمة, البعد))
                    && اكتب_ط32_إلف_ربط_في(الصورة, الموضع + 4, رقع_نوع_آي_رايسك(التالية, منخفض12_إلف(البعد)));
            };
        } وإلا إذا (النوع == 23) {
            في_النطاق := يتسع_بإشارة_إلف(البعد + 0x800, 32);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_يو_رايسك(التعليمة, البعد)); };
        } وإلا إذا (النوع == 24 || النوع == 25) {
            طابق بعد_عال_مقترن_رايسك_إلف(السياق, الحافة, الهدف_المضاف) مع
            | اختياري.لا_شيء -> { مدعومة := خطأ; }
            | اختياري.موجود(العالي) -> {
                إذا (النوع == 24) {
                    كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_آي_رايسك(التعليمة, منخفض12_إلف(العالي)));
                } وإلا {
                    كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_إس_رايسك(التعليمة, منخفض12_إلف(العالي)));
                };
            };
        } وإلا إذا (النوع == 26) {
            في_النطاق := يتسع_بإشارة_إلف(القيمة + 0x800, 32);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_يو_رايسك(التعليمة, القيمة)); };
        } وإلا إذا (النوع == 27) {
            كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_آي_رايسك(التعليمة, منخفض12_إلف(القيمة)));
        } وإلا إذا (النوع == 28) {
            كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, رقع_نوع_إس_رايسك(التعليمة, منخفض12_إلف(القيمة)));
        } وإلا إذا (النوع == 16) {
            // B-type: imm[12|10:5] in bits 31|30:25, imm[4:1|11] in 11:8|7.
            في_النطاق := يتسع_بإشارة_إلف(البعد, 13);
            دع الجديد: طبيعي = (التعليمة & 0x1FFF07F) | (حقل_بتات_إلف(البعد, 12, 1) << 31)
                | (حقل_بتات_إلف(البعد, 5, 6) << 25) | (حقل_بتات_إلف(البعد, 1, 4) << 8)
                | (حقل_بتات_إلف(البعد, 11, 1) << 7);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد); };
        } وإلا إذا (النوع == 17) {
            // J-type: imm[20|10:1|11|19:12] in bits 31|30:21|20|19:12.
            في_النطاق := يتسع_بإشارة_إلف(البعد, 21);
            دع الجديد: طبيعي = (التعليمة & 0xFFF) | (حقل_بتات_إلف(البعد, 20, 1) << 31)
                | (حقل_بتات_إلف(البعد, 1, 10) << 21) | (حقل_بتات_إلف(البعد, 11, 1) << 20)
                | (حقل_بتات_إلف(البعد, 12, 8) << 12);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد); };
        } وإلا إذا (النوع == 44 || النوع == 45) {
            // C.BEQZ/C.BNEZ (CB) and C.J/C.JAL (CJ) offsets.
            دع القديمة: طبيعي = ((*الصورة)[الموضع] مثل طبيعي) | (((*الصورة)[الموضع + 1] مثل طبيعي) << 8);
            دع الجديدة: متغير طبيعي = 0;
            إذا (النوع == 44) {
                في_النطاق := يتسع_بإشارة_إلف(البعد, 9);
                الجديدة := (القديمة & 0xE383) | (حقل_بتات_إلف(البعد, 8, 1) << 12)
                    | (حقل_بتات_إلف(البعد, 3, 2) << 10) | (حقل_بتات_إلف(البعد, 6, 2) << 5)
                    | (حقل_بتات_إلف(البعد, 1, 2) << 3) | (حقل_بتات_إلف(البعد, 5, 1) << 2);
            } وإلا {
                في_النطاق := يتسع_بإشارة_إلف(البعد, 12);
                الجديدة := (القديمة & 0xE003) | (حقل_بتات_إلف(البعد, 11, 1) << 12)
                    | (حقل_بتات_إلف(البعد, 4, 1) << 11) | (حقل_بتات_إلف(البعد, 8, 2) << 9)
                    | (حقل_بتات_إلف(البعد, 10, 1) << 8) | (حقل_بتات_إلف(البعد, 6, 1) << 7)
                    | (حقل_بتات_إلف(البعد, 7, 1) << 6) | (حقل_بتات_إلف(البعد, 1, 3) << 3)
                    | (حقل_بتات_إلف(البعد, 5, 1) << 2);
            };
            إذا (في_النطاق) {
                (*الصورة)[الموضع] := (الجديدة & 0xFF) مثل ط8;
                (*الصورة)[الموضع + 1] := ((الجديدة >> 8) & 0xFF) مثل ط8;
            };
        } وإلا {
            مدعومة := خطأ;
        };
    } وإلا {
        // LoongArch. The page delta adds a page when the low 12 bits, which
        // the paired addi.d/ld.d sign-extends, are negative.
        دع فرق_الصفحات: متغير عدد = فرق_موقع_إلف(الهدف_المضاف & 0xFFFFFFFFFFFFF000, عنوان_الرقعة & 0xFFFFFFFFFFFFF000);
        إذا ((الهدف_المضاف & 0x800) != 0) { فرق_الصفحات := فرق_الصفحات + 0x1000; };
        إذا (النوع == 71 || النوع == 75) {
            في_النطاق := يتسع_بإشارة_إلف(فرق_الصفحات, 32);
            دع الجديد: طبيعي = (التعليمة & 0xFE00001F) | (حقل_بتات_إلف(فرق_الصفحات, 12, 20) << 5);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد); };
        } وإلا إذا (النوع == 72 || النوع == 76) {
            دع المصدر: متغير طبيعي = التعليمة;
            إذا (النوع == 76) {
                // ld.d rd, rj, %got_pc_lo12(sym) -> addi.d rd, rj, %pc_lo12(sym).
                مدعومة := (التعليمة & 0xFFC00000) == 0x28C00000;
                المصدر := (التعليمة & 0x3FFFFF) | 0x02C00000;
            };
            دع الجديد: طبيعي = (المصدر & 0xFFC003FF) | ((الهدف_المضاف & 0xFFF) << 10);
            إذا (مدعومة) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد); };
        } وإلا إذا (النوع == 66) {
            // B26: offs[15:0] in bits 25:10, offs[25:16] in bits 9:0.
            في_النطاق := (البعد & 3) == 0 && يتسع_بإشارة_إلف(البعد, 28);
            دع الجديد: طبيعي = (التعليمة & 0xFC000000) | (حقل_بتات_إلف(البعد, 2, 16) << 10)
                | حقل_بتات_إلف(البعد, 18, 10);
            إذا (في_النطاق) { كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع, الجديد); };
        } وإلا إذا (النوع == 110) {
            // PCADDU18I + JIRL: the high part in si20 (bits 24:5), the rest,
            // in instructions, in offs16 (bits 25:10).
            في_النطاق := (البعد & 3) == 0 && يتسع_بإشارة_إلف(البعد + 0x20000, 38);
            دع العالي: عدد = (البعد + 0x20000) >> 18;
            دع المنخفض: عدد = ((البعد & 0x3FFFF) ^ 0x20000) - 0x20000;
            دع التالية: طبيعي = اقرأ_ط32_إلف_ربط(الصورة, الموضع + 4);
            إذا (في_النطاق) {
                كتب := اكتب_ط32_إلف_ربط_في(الصورة, الموضع,
                        (التعليمة & 0xFE00001F) | (حقل_بتات_إلف(العالي, 0, 20) << 5))
                    && اكتب_ط32_إلف_ربط_في(الصورة, الموضع + 4,
                        (التالية & 0xFC0003FF) | (حقل_بتات_إلف(المنخفض, 2, 16) << 10));
            };
        } وإلا إذا (النوع == 109) {
            كتب := اكتب_ط64_إلف_ربط_في(الصورة, الموضع, حقل_بتات_إلف(البعد, 0, 32)
                | (حقل_بتات_إلف(البعد, 32, 32) << 32));
        } وإلا {
            مدعومة := خطأ;
        };
    };
    إذا (!مدعومة) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة());
    };
    إذا (!في_النطاق || !كتب) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق());
    };
    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ);
}

// The architectures whose images are static only and whose relocations
// relocation_patch.sn encodes: ELF32 (i386, ARM), big-endian ELF64 (s390x,
// SPARC V9), PowerPC 64 ELFv2 and MIPS64 n64.
عرف صورة_إلف_ثابتة_منقولة(المعمارية: هوية_معمارية): منطقي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع صواب; }
    | هوية_معمارية.ذراع_سبعة -> { أرجع صواب; }
    | هوية_معمارية.سيستم_زد -> { أرجع صواب; }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// lld's max-page-size of the target (its kernels' largest page): 4 KiB for
// x86, AArch64 here, RISC-V, LoongArch and s390x, 64 KiB for ARM, PowerPC 64
// and MIPS, 1 MiB for SPARC V9 (8 KiB pages and larger).
عرف محاذاة_جزء_إلف_للهدف(الهدف: &واصف_هدف): طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_سبعة -> { أرجع 0x10000; }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع 0x10000; }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع 0x10000; }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع 0x100000; }
    | _ -> { أرجع 0x1000; };
}

// e_flags of the first ELF object input (MIPS: the ISA, ABI and PIC bits
// its objects carry, which lld merges).
عرف أعلام_أول_كائن_إلف(السياق: &سياق_ربط): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
        دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[ف];
        إذا ((*المدخل).الصنف == صنف_مدخل_ربط.كائن()) {
            طابق اقرأ_واصف_إلف_مدخل(&(*المدخل).البايتات) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الوصف) -> {
                دع الموضع: متغير طبيعي = 48;
                إذا (الوصف.الصنف == صنف_إلف_مدخل.اثنان_وثلاثون()) { الموضع := 36; };
                إذا (ضمن_حدود_إلف_مدخل(&(*المدخل).البايتات, الموضع, 4)) {
                    أرجع اقرأ_ط32_إلف_مدخل(&(*المدخل).البايتات, الموضع, الوصف.الترتيب);
                };
            };
        };
        ف := ف + 1;
    }
    أرجع 0;
}

// Whether the canonical triple names the hard-float procedure-call
// standard (an "eabihf" environment).
عرف ثلاثي_بفاصلة_عائمة_صلبة(الهدف: &واصف_هدف): منطقي {
    دع الثلاثي: &نص = &(*الهدف).الثلاثي_المقنن;
    دع الطول_الكلي: طبيعي = الطول(*الثلاثي) مثل طبيعي;
    أرجع الطول_الكلي >= 2
        && (*الثلاثي)[الطول_الكلي - 2] == (0x68 مثل ط8)
        && (*الثلاثي)[الطول_الكلي - 1] == (0x66 مثل ط8);
}

// e_flags as lld writes them: ARM EF_ARM_EABI_VER5 with the float ABI
// (EF_ARM_ABI_FLOAT_HARD or _SOFT), PowerPC 64 ELFv2 (2), MIPS the inputs'
// flags; the other targets in أعلام_إلف_للهدف.
عرف أعلام_إلف_للصورة(السياق: &سياق_ربط): طبيعي {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_سبعة -> {
        إذا (ثلاثي_بفاصلة_عائمة_صلبة(&(*السياق).الهدف)) { أرجع 0x05000400; };
        أرجع 0x05000200;
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع 2; }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع أعلام_أول_كائن_إلف(السياق); }
    | _ -> { أرجع أعلام_إلف_للهدف(&(*السياق).الهدف); };
}

// The linker-defined PowerPC 64 TOC base symbol.
عام عرف اسم_أساس_جدول_المحتوى_إلف(): متجه ط8 { أرجع بايتات_من_نص(«.TOC.»); }

عرف هاش_عدد_إزاحة_إلف(القيمة: &طبيعي): طبيعي { أرجع *القيمة; }
عرف عددان_إزاحة_إلف_متساويان(أ: &طبيعي, ب: &طبيعي): منطقي { أرجع *أ == *ب; }

// What every relocation of a static image shares: the byte order, the local
// GOT (slot index by symbol ID), the GOT and TOC bases, and PowerPC 64 local
// entry offsets by global entry address.
نوع حالة_إزاحات_منقولة_إلف = {
    الترتيب: ترتيب_بايت,
    خانات_الجوت: الخريطة<طبيعي, طبيعي>,
    عنوان_الجوت_المحلي: طبيعي,
    عرض_الكلمة: طبيعي,
    أساس_الجوت: طبيعي,
    أساس_الجدول_المحتوى: طبيعي,
    المداخل_المحلية: الخريطة<طبيعي, طبيعي>
};

عرف خطأ_نطاق_إزاحة_إلف(السياق: &سياق_ربط, الحافة: &حافة_إزاحة_ربط): نتيجة_صورة_إلف_تنفيذية {
    دع الاسم: متغير متجه ط8 = [];
    طابق (*الحافة).المرجع مع
    | مرجع_إزاحة_ربط.رمز(_) -> {
        الاسم := اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع);
    }
    | _ -> { };
    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.إزاحة_رمز_خارج_النطاق(
        (*الحافة).رمز_صيغة مثل طبيعي, الاسم));
}

// One relocation of a static i386, ARM, s390x, SPARC V9, PowerPC 64 or
// MIPS64 image: P, S + A and the GOT slot from the canonical layout, the
// field from relocation_patch.sn.
عرف اكتب_إزاحة_إلف_منقولة_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الحالة: &حالة_إزاحات_منقولة_إلف
): نتيجة_صورة_إلف_تنفيذية {
    دع فارغ: متجه ط8 = [];
    دع المعمارية: هوية_معمارية = (*السياق).الهدف.المعمارية.الهوية;
    دع النوع: طبيعي = (*الحافة).رمز_صيغة مثل طبيعي;
    دع عرض_الرقعة: طبيعي;
    طابق عرض_رقعة_إلف_ثابتة(المعمارية, النوع) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.نوع_إزاحة_غير_مدعوم(النوع));
    }
    | اختياري.موجود(القيمة) -> { عرض_الرقعة := القيمة; };
    // R_*_NONE, R_ARM_V4BX, R_MIPS_JALR: no field, and the symbol (ARM's
    // __aeabi_unwind_cpp_pr0 dependency) need not be defined.
    إذا (عرض_الرقعة == 0) { أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ); };
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع موضع_القسم: موضع_قسم_خرج_ربط;
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };
    إذا ((*الحافة).الإزاحة > موضع_القسم.حجم_الملف
        || عرض_الرقعة > موضع_القسم.حجم_الملف - (*الحافة).الإزاحة
        || موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة + عرض_الرقعة > (الطول(*الصورة) مثل طبيعي)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق());
    };
    دع عنوان_الرقعة: طبيعي;
    طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()); }
    | اختياري.موجود(القيمة) -> { عنوان_الرقعة := القيمة; };
    دع الهدف_المضاف: طبيعي;
    طابق هدف_إزاحة_ثابتة_إلف(السياق, الحافة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
            اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)));
    }
    | اختياري.موجود(القيمة) -> { الهدف_المضاف := القيمة; };
    دع عنوان_الخانة: متغير طبيعي = 0;
    إذا (إزاحة_إلف_ثابتة_بخانة_جوت(المعمارية, النوع)) {
        دع الخانة: متغير اختياري طبيعي = اختياري.لا_شيء();
        طابق (*الحافة).المرجع مع
        | مرجع_إزاحة_ربط.رمز(المعرف) -> {
            دع المفتاح: طبيعي = المعرف.القيمة مثل طبيعي;
            الخانة := ابحث_في_الخريطة(&(*الحالة).خانات_الجوت, &المفتاح);
        }
        | _ -> { };
        طابق الخانة مع
        | اختياري.لا_شيء -> { أرجع خطأ_نطاق_إزاحة_إلف(السياق, الحافة); }
        | اختياري.موجود(الفهرس) -> {
            عنوان_الخانة := (*الحالة).عنوان_الجوت_المحلي + الفهرس * (*الحالة).عرض_الكلمة;
        };
    };
    دع أساس_الجدول: متغير طبيعي = (*الحالة).أساس_الجوت;
    دع الدخول_المحلي: متغير طبيعي = 0;
    إذا (المعمارية == هوية_معمارية.باور_بي_سي_أربعة_وستون()) {
        أساس_الجدول := (*الحالة).أساس_الجدول_المحتوى;
        إذا (النوع == 10) {
            طابق ابحث_في_الخريطة(&(*الحالة).المداخل_المحلية, &الهدف_المضاف) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الفرق) -> { الدخول_المحلي := الفرق; };
        };
    };
    دع القيم: قيم_إزاحة_إلف = {
        النوع: النوع,
        الموضع: موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة,
        عنوان_الرقعة: عنوان_الرقعة,
        الهدف: الهدف_المضاف,
        الإضافة: (*الحافة).إضافة,
        عنوان_الخانة: عنوان_الخانة,
        أساس_الجدول: أساس_الجدول,
        الدخول_المحلي: الدخول_المحلي
    };
    طابق ارقع_إزاحة_إلف_ثابتة(الصورة, المعمارية, (*الحالة).الترتيب, &القيم) مع
    | نتيجة_رقعة_إلف.تمت -> { أرجع نتيجة_صورة_إلف_تنفيذية.نجح(فارغ); }
    | نتيجة_رقعة_إلف.غير_مدعومة -> { أرجع خطأ_نطاق_إزاحة_إلف(السياق, الحافة); }
    | نتيجة_رقعة_إلف.خارج_النطاق -> { أرجع خطأ_نطاق_إزاحة_إلف(السياق, الحافة); };
}

// One relocation of an image laid out by a linker script
// (elf/script_image.sn): a static image with no GOT, its sections placed in
// the context's layout.
عام عرف اكتب_إزاحة_إلف_ثابتة_في_صورة_مخططة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الترتيب: ترتيب_بايت
): نتيجة_صورة_إلف_تنفيذية {
    دع الحالة: حالة_إزاحات_منقولة_إلف = {
        الترتيب: الترتيب,
        خانات_الجوت: أنشئ_الخريطة(هاش_عدد_إزاحة_إلف, عددان_إزاحة_إلف_متساويان),
        عنوان_الجوت_المحلي: 0,
        عرض_الكلمة: 4,
        أساس_الجوت: 0,
        أساس_الجدول_المحتوى: 0,
        المداخل_المحلية: أنشئ_الخريطة(هاش_عدد_إزاحة_إلف, عددان_إزاحة_إلف_متساويان)
    };
    أرجع اكتب_إزاحة_إلف_منقولة_في_الصورة(الصورة, السياق, الحافة, &الحالة);
}

عرف اكتب_إزاحة_إلف_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_إلف_ربط,
    عنوان_بلت: طبيعي,
    عنوان_جوت: طبيعي,
    عنوان_جوت_المحلي: طبيعي
): نتيجة_صورة_إلف_تنفيذية {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اكتب_إزاحة_إلف_إكس64_في_الصورة(
            الصورة,
            السياق,
            الحافة,
            الرموز_الديناميكية,
            عنوان_بلت,
            عنوان_جوت,
            عنوان_جوت_المحلي
        );
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اكتب_إزاحة_إلف_ذراع64_في_الصورة(
            الصورة,
            السياق,
            الحافة,
            الرموز_الديناميكية,
            عنوان_بلت,
            عنوان_جوت
        );
    }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        أرجع اكتب_إزاحة_إلف_ثابتة_في_الصورة(الصورة, السياق, الحافة);
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        أرجع اكتب_إزاحة_إلف_ثابتة_في_الصورة(الصورة, السياق, الحافة);
    }
    | _ -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };
}

// Resolve the ELF constructor range from the same canonical section layout
// used for every other absolute and PC-relative relocation. The section
// writer already retained SHT_INIT_ARRAY as a reachability root.
عرف ثبت_حد_منشئات_إلف_المحلول(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه ط8,
    العنوان: طبيعي
): فراغ {
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                إذا (القيمة == 0) {
                    دع الجديد: تعريف_رمز_ربط = {
                        المدخل: التعريف.المدخل,
                        القوة: التعريف.القوة,
                        الموضع: موضع_تعريف_رمز_ربط.مطلق(العنوان),
                        الحجم: التعريف.الحجم
                    };
                    (*السياق).الرموز.الرموز[الرمز.المعرف.القيمة].الحالة :=
                        حالة_رمز_ربط.معرف(الجديد);
                };
            }
            | _ -> { };
        }
        | _ -> { };
    };
}

عرف ثبت_مجال_منشئات_إلف(
    السياق: &متغير سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    الأساس: طبيعي
): منطقي {
    دع البداية: متغير طبيعي = الأساس;
    دع النهاية: متغير طبيعي = الأساس;
    دع وجد: متغير منطقي = خطأ;
    دع عرض_الكلمة: طبيعي = صيغة_صورة_إلف_للهدف(&(*السياق).الهدف).عرض_الكلمة;
    // Check the same priority-ordered sequence that section placement emitted.
    // Checking original input order would incorrectly reject valid reordering.
    دع ترتيب_المنشئات: متجه طبيعي = رتب_أقسام_منشئات_إلف(السياق);
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول(ترتيب_المنشئات) مثل طبيعي)) {
        دع فهرس_المصدر: طبيعي = ترتيب_المنشئات[فهرس_القسم];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_المصدر];
        إذا ((*القسم).حي) {
            طابق (*القسم).حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.إلف(النوع, الأعلام) -> {
                إذا (النوع == 14) {
                    // Constructor entries are machine-word pointers in a loaded
                    // writable section; malformed input must not be invoked.
                    إذا ((الأعلام & 3) != 3
                        || (*القسم).المحاذاة < عرض_الكلمة
                        || ((*القسم).الحجم % عرض_الكلمة) != 0) {
                        أرجع خطأ;
                    };
                    طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, (*القسم).المعرف) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(الموضع) -> {
                        دع العنوان: طبيعي;
                        طابق الموضع.العنوان_الافتراضي مع
                        | اختياري.لا_شيء -> { أرجع خطأ; }
                        | اختياري.موجود(القيمة) -> { العنوان := القيمة; };
                        إذا (العنوان + (*القسم).الحجم < العنوان) {
                            أرجع خطأ;
                        };
                        إذا (!وجد) {
                            البداية := العنوان;
                            النهاية := العنوان;
                            وجد := صواب;
                        };
                        إذا (العنوان != النهاية) { أرجع خطأ; };
                        النهاية := العنوان + (*القسم).الحجم;
                    };
                };
            }
            | _ -> { };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع رمز_البداية: متجه ط8 = اسم_بداية_منشئات_إلف_أساسي();
    دع رمز_النهاية: متجه ط8 = اسم_نهاية_منشئات_إلف_أساسي();
    ثبت_حد_منشئات_إلف_المحلول(السياق, &رمز_البداية, البداية);
    ثبت_حد_منشئات_إلف_المحلول(السياق, &رمز_النهاية, النهاية);
    أرجع صواب;
}

// Executable sections borrow immutable bytes from the canonical input plan.
// Their only mutable representation is the final image, where relocations are
// applied. This avoids owning a second live-section payload alongside both
// the original ELF object and the executable image.
عام عرف اكتب_قسم_إلف_من_مدخله_في_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    القسم: &قسم_ربط,
    الموضع_النهائي: طبيعي
): منطقي {
    دع معرف_المدخل: طبيعي = (*القسم).المدخل.القيمة;
    إذا (معرف_المدخل >= (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع المصدر: &متجه ط8 = &(*السياق).الخطة.المدخلات[معرف_المدخل].البايتات;
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(المصدر) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الوصف := القيمة; };
    إذا ((*القسم).فهرس_قسم_الصيغة >= الوصف.عدد_الأقسام) {
        أرجع خطأ;
    };
    دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(
        &الوصف, (*القسم).فهرس_قسم_الصيغة
    );
    دع الموضع_الأصلي: طبيعي = حقل_موضع_قسم_إلف_مدخل(
        المصدر, &الوصف, الرأس
    );
    دع الحجم: طبيعي = حقل_حجم_قسم_إلف_مدخل(
        المصدر, &الوصف, الرأس
    );
    دع طول_الصورة: طبيعي = الطول(*الصورة) مثل طبيعي;
    إذا (الحجم != (*القسم).الحجم
        || !ضمن_حدود_إلف_مدخل(المصدر, الموضع_الأصلي, الحجم)
        || الموضع_النهائي > طول_الصورة
        || الحجم > طول_الصورة - الموضع_النهائي) {
        أرجع خطأ;
    };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < الحجم) {
        (*الصورة)[الموضع_النهائي + الفهرس] :=
            (*المصدر)[الموضع_الأصلي + الفهرس];
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

// The complete image builder is intentionally below the relocation machinery:
// layout is installed first, then every input relocation consumes that one
// canonical placement map.
عرف ابن_صورة_إلف_نظامية(
    السياق: &متغير سياق_ربط,
    الخرج: نوع_خرج_ربط
): نتيجة_صورة_إلف_تنفيذية {
    إذا ((*السياق).الهدف.صيغة_الكائن != صيغة_كائن_هدف.إلف()) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };
    دع ثابت_فقط: متغير منطقي = خطأ;
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { ثابت_فقط := صواب; }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { ثابت_فقط := صواب; }
    | _ -> {
        // ELF32 (i386, ARM) and big-endian (s390x, SPARC V9) images, and
        // PowerPC 64 and MIPS64: static images (relocation_patch.sn).
        إذا (!صورة_إلف_ثابتة_منقولة((*السياق).الهدف.المعمارية.الهوية)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
            );
        };
        ثابت_فقط := صواب;
    };
    دع صيغة_الصورة: صيغة_صورة_إلف = صيغة_صورة_إلف_للهدف(&(*السياق).الهدف);
    دع عرض_الكلمة: طبيعي = صيغة_الصورة.عرض_الكلمة;
    إذا (ثابت_فقط && الخرج != نوع_خرج_ربط.تنفيذي()) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };
    إذا (!منصة_إلف_نظامية_قابلة_للربط(
        (*السياق).الهدف.المنصة.المنصة
    )) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };
    دع مكتبة_مشتركة: متغير منطقي = خطأ;
    طابق الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { مكتبة_مشتركة := صواب; }
    | نوع_خرج_ربط.كائن_مترابط -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };

    دع الرموز_الديناميكية: متغير متجه رمز_ديناميكي_إلف_ربط =
        ابن_قائمة_رموز_ديناميكية_إلف(السياق, مكتبة_مشتركة);
    دع عدد_رموز_الاستيراد: طبيعي =
        عدد_رموز_استيراد_ديناميكية_إلف(&الرموز_الديناميكية);
    دع عدد_إزاحات_البيانات_الديناميكية: طبيعي =
        عدد_إزاحات_بيانات_ديناميكية_إلف(السياق);
    // Elf64_Rela.r_info reserves only 32 bits for the dynamic symbol index.
    // Also guard the SysV hash table's 32-bit chain count and section sizes.
    إذا ((الطول(الرموز_الديناميكية) مثل طبيعي) >= 0xFFFFFFFF
        || عدد_إزاحات_البيانات_الديناميكية > 0xFFFFFFFF) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    // A program with no dynamic-library inputs has no provider for remaining
    // undefined symbols. Do not emit an ELF image that merely fails at load.
    إذا (!مكتبة_مشتركة
        && عدد_رموز_الاستيراد > 0
        && (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي) == 0
    ) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                اسم_أول_رمز_استيراد_ديناميكي_إلف(&الرموز_الديناميكية)
            )
        );
    };
    دع ديناميكي: منطقي = مكتبة_مشتركة
        || (الطول(الرموز_الديناميكية) مثل طبيعي) > 0
        || (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي) > 0;
    دع إعداد_الربط: إعداد_ربط_ديناميكي_هدف;
    إذا (ديناميكي && ثابت_فقط) {
        // No PLT, GOT or dynamic section writer for these images: a link
        // that would need the dynamic loader is unsupported.
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };
    إذا (ديناميكي) {
        طابق إعداد_ربط_ديناميكي_للهدف(&(*السياق).الهدف) مع
        | اختياري.لا_شيء -> {
            دع لا_اسم: متجه ط8 = [];
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(لا_اسم)
            );
        }
        | اختياري.موجود(الإعداد) -> { إعداد_الربط := الإعداد; };
    } وإلا {
        دع مفسر_فارغ: متجه ط8 = [];
        دع إعداد_فارغ: إعداد_ربط_ديناميكي_هدف = {
            مفسر_إلف: مفسر_فارغ
        };
        إعداد_الربط := إعداد_فارغ;
    };

    دع الاعتمادات: متغير متجه اعتماد_ديناميكي_إلف_ربط = [];
    إذا (ديناميكي) {
        // DT_NEEDED entries come only from explicit link dependencies.
        الاعتمادات := ابن_اعتمادات_إلف(السياق);
    };
    دع مسار_التشغيل: متجه ط8 = ابن_مسار_تشغيل_إلف(السياق);
    دع جدول_النصوص_الديناميكي: متغير متجه ط8 = [0];
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل طبيعي)) {
        الاعتمادات[فهرس_الاعتماد].إزاحة_الاسم := أضف_اسم_إلى_جدول_إلف(
            &متغير جدول_النصوص_الديناميكي,
            &الاعتمادات[فهرس_الاعتماد].الاسم
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع إزاحة_مسار_التشغيل: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا ((الطول(مسار_التشغيل) مثل طبيعي) > 0) {
        إزاحة_مسار_التشغيل := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_النصوص_الديناميكي,
                &مسار_التشغيل
            )
        );
    };
    دع إزاحة_اسم_المخرج: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا (مكتبة_مشتركة) {
        طابق (*السياق).الخطة.اسم_المخرج_الديناميكي مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الاسم) -> {
            إزاحة_اسم_المخرج := اختياري.موجود(
                أضف_اسم_إلى_جدول_إلف(
                    &متغير جدول_النصوص_الديناميكي,
                    &الاسم
                )
            );
        };
    };
    دع فهرس_الديناميكي: متغير طبيعي = 0;
    طالما (
        فهرس_الديناميكي < (الطول(الرموز_الديناميكية) مثل طبيعي)
    ) {
        الرموز_الديناميكية[فهرس_الديناميكي].إزاحة_الاسم :=
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_النصوص_الديناميكي,
                &الرموز_الديناميكية[فهرس_الديناميكي].الاسم
            );
        فهرس_الديناميكي := فهرس_الديناميكي + 1;
    }

    دع أساس_التحميل: متغير طبيعي = 0x400000;
    إذا (مكتبة_مشتركة) { أساس_التحميل := 0; };
    دع حجم_الصفحة: طبيعي = 0x1000;
    // The largest page the target's kernels use (lld's max-page-size): a
    // segment's address and file offset agree modulo it.
    دع محاذاة_الجزء: طبيعي = محاذاة_جزء_إلف_للهدف(&(*السياق).الهدف);
    دع عدد_رؤوس_البرنامج: متغير طبيعي = 1;
    دع يوجد_قسم_كتابة: متغير منطقي = خطأ;
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا (
            (*السياق).الأقسام[فهرس_القسم].حي
            && قسم_إلف_محمل_تنفيذيا(&(*السياق).الأقسام[فهرس_القسم])
            && قسم_إلف_قابل_للكتابة_تنفيذيا(
                &(*السياق).الأقسام[فهرس_القسم]
            )
        ) {
            يوجد_قسم_كتابة := صواب;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    // The local GOT (رموز_جوت_محلية_إلف) lies in the writable segment.
    دع رموز_الجوت_المحلي: متجه معرف_رمز_ربط = رموز_جوت_محلية_إلف(السياق);
    إذا ((الطول(رموز_الجوت_المحلي) مثل طبيعي) > 0) { يوجد_قسم_كتابة := صواب; };
    إذا (ديناميكي) {
        يوجد_قسم_كتابة := صواب;
        إذا (مكتبة_مشتركة) {
            عدد_رؤوس_البرنامج := 3;
        } وإلا {
            عدد_رؤوس_البرنامج := 4;
        };
    } وإلا إذا (يوجد_قسم_كتابة) {
        عدد_رؤوس_البرنامج := 2;
    };
    // Allocated notes get a PT_NOTE header: FreeBSD reads the ABI note
    // (osrel) from it.
    دع يوجد_ملاحظة: متغير منطقي = خطأ;
    فهرس_القسم := 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس_القسم].حي
            && قسم_ملاحظة_إلف_محمل(&(*السياق).الأقسام[فهرس_القسم])) {
            يوجد_ملاحظة := صواب;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    إذا (يوجد_ملاحظة) { عدد_رؤوس_البرنامج := عدد_رؤوس_البرنامج + 1; };

    دع موضع_المفسر: طبيعي = 0x200;
    دع حجم_المفسر: متغير طبيعي = 0;
    إذا (ديناميكي && !مكتبة_مشتركة) {
        حجم_المفسر := الطول(إعداد_الربط.مفسر_إلف) مثل طبيعي;
    };
    دع التخطيط: متغير تخطيط_خرج_ربط = أنشئ_تخطيط_خرج_ربط();
    دع بداية_القراءة: طبيعي = حجم_الصفحة;
    دع نهاية_وضع_القراءة: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            خطأ,
            خطأ,
            بداية_القراءة,
            أساس_التحميل + بداية_القراءة
        );
    دع نهاية_قراءة_ملف: متغير طبيعي =
        نهاية_وضع_القراءة.موضع_الملف;
    دع نهاية_قراءة_ذاكرة: متغير طبيعي =
        نهاية_وضع_القراءة.عنوان_الذاكرة;

    دع عدد_الرموز_الديناميكية: طبيعي =
        الطول(الرموز_الديناميكية) مثل طبيعي;
    دع موضع_بلت: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_بلت: متغير طبيعي = نهاية_قراءة_ذاكرة;
    دع حجم_بلت: متغير طبيعي = 0;
    دع موضع_النصوص_الديناميكية: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_النصوص_الديناميكية: متغير طبيعي = نهاية_قراءة_ذاكرة;
    دع موضع_الرموز_الديناميكية: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_الرموز_الديناميكية: متغير طبيعي = نهاية_قراءة_ذاكرة;
    دع موضع_هاش: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_هاش: متغير طبيعي = نهاية_قراءة_ذاكرة;
    دع موضع_إزاحات_بلت: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_إزاحات_بلت: متغير طبيعي = نهاية_قراءة_ذاكرة;
    دع موضع_إزاحات_ديناميكية: متغير طبيعي = نهاية_قراءة_ملف;
    دع عنوان_إزاحات_ديناميكية: متغير طبيعي = نهاية_قراءة_ذاكرة;
    إذا (ديناميكي) {
        موضع_بلت := حاذ_قيمة_إلف(نهاية_قراءة_ملف, 16);
        عنوان_بلت := أساس_التحميل + موضع_بلت;
        طابق حجم_بلت_إلف_للهدف(
            &(*السياق).الهدف,
            عدد_رموز_الاستيراد
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
            );
        }
        | اختياري.موجود(القيمة) -> { حجم_بلت := القيمة; };
        موضع_النصوص_الديناميكية := حاذ_قيمة_إلف(
            موضع_بلت + حجم_بلت,
            8
        );
        عنوان_النصوص_الديناميكية :=
            أساس_التحميل + موضع_النصوص_الديناميكية;
        موضع_الرموز_الديناميكية := حاذ_قيمة_إلف(
            موضع_النصوص_الديناميكية
                + (الطول(جدول_النصوص_الديناميكي) مثل طبيعي),
            8
        );
        عنوان_الرموز_الديناميكية :=
            أساس_التحميل + موضع_الرموز_الديناميكية;
        موضع_هاش := حاذ_قيمة_إلف(
            موضع_الرموز_الديناميكية
                + (عدد_الرموز_الديناميكية + 1) * 24,
            8
        );
        عنوان_هاش := أساس_التحميل + موضع_هاش;
        دع حجم_هاش: طبيعي = (عدد_الرموز_الديناميكية + 4) * 4;
        موضع_إزاحات_بلت := حاذ_قيمة_إلف(موضع_هاش + حجم_هاش, 8);
        عنوان_إزاحات_بلت := أساس_التحميل + موضع_إزاحات_بلت;
        موضع_إزاحات_ديناميكية := موضع_إزاحات_بلت
            + عدد_رموز_الاستيراد * 24;
        عنوان_إزاحات_ديناميكية := أساس_التحميل + موضع_إزاحات_ديناميكية;
        نهاية_قراءة_ملف := موضع_إزاحات_ديناميكية
            + عدد_إزاحات_البيانات_الديناميكية * 24;
        نهاية_قراءة_ذاكرة := أساس_التحميل + نهاية_قراءة_ملف;
    };

    دع نهاية_وضع_القراءة_الصفرية: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            خطأ,
            صواب,
            نهاية_قراءة_ملف,
            نهاية_قراءة_ذاكرة
        );
    دع نهاية_قراءة_صفرية_ملف: طبيعي =
        نهاية_وضع_القراءة_الصفرية.موضع_الملف;
    دع نهاية_قراءة_صفرية_ذاكرة: طبيعي =
        نهاية_وضع_القراءة_الصفرية.عنوان_الذاكرة;
    دع بداية_جزء_الكتابة: طبيعي =
        حاذ_قيمة_إلف(نهاية_قراءة_صفرية_ملف, حجم_الصفحة);
    دع عنوان_جزء_الكتابة: متغير طبيعي =
        حاذ_قيمة_إلف(نهاية_قراءة_صفرية_ذاكرة, حجم_الصفحة);
    إذا (محاذاة_الجزء > حجم_الصفحة) {
        عنوان_جزء_الكتابة := حاذ_قيمة_إلف(نهاية_قراءة_صفرية_ذاكرة, محاذاة_الجزء)
            + (بداية_جزء_الكتابة % محاذاة_الجزء);
    };
    دع نهاية_وضع_الكتابة: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            صواب,
            خطأ,
            بداية_جزء_الكتابة,
            عنوان_جزء_الكتابة
        );
    دع نهاية_كتابة_ملف: متغير طبيعي =
        نهاية_وضع_الكتابة.موضع_الملف;
    دع نهاية_كتابة_ذاكرة: متغير طبيعي =
        نهاية_وضع_الكتابة.عنوان_الذاكرة;

    // The local GOT (رموز_جوت_محلية_إلف): one word per symbol, filled with
    // its address below; a fixed-address image needs no dynamic relocation.
    دع موضع_الجوت_المحلي: متغير طبيعي = نهاية_كتابة_ملف;
    دع عنوان_الجوت_المحلي: متغير طبيعي = نهاية_كتابة_ذاكرة;
    إذا ((الطول(رموز_الجوت_المحلي) مثل طبيعي) > 0) {
        موضع_الجوت_المحلي := حاذ_قيمة_إلف(نهاية_كتابة_ملف, عرض_الكلمة);
        عنوان_الجوت_المحلي := عنوان_جزء_الكتابة + (موضع_الجوت_المحلي - بداية_جزء_الكتابة);
        نهاية_كتابة_ملف := موضع_الجوت_المحلي + (الطول(رموز_الجوت_المحلي) مثل طبيعي) * عرض_الكلمة;
        نهاية_كتابة_ذاكرة := عنوان_الجوت_المحلي + (الطول(رموز_الجوت_المحلي) مثل طبيعي) * عرض_الكلمة;
    };

    دع موضع_جوت: متغير طبيعي = نهاية_كتابة_ملف;
    دع عنوان_جوت: متغير طبيعي = نهاية_كتابة_ذاكرة;
    دع حجم_جوت: متغير طبيعي = 0;
    دع موضع_الديناميكي: متغير طبيعي = نهاية_كتابة_ملف;
    دع عنوان_الديناميكي: متغير طبيعي = نهاية_كتابة_ذاكرة;
    دع حجم_الديناميكي: متغير طبيعي = 0;
    إذا (ديناميكي) {
        موضع_جوت := حاذ_قيمة_إلف(نهاية_كتابة_ملف, 8);
        عنوان_جوت := عنوان_جزء_الكتابة
            + (موضع_جوت - بداية_جزء_الكتابة);
        حجم_جوت := (عدد_رموز_الاستيراد + 3) * 8;
        موضع_الديناميكي := حاذ_قيمة_إلف(موضع_جوت + حجم_جوت, 8);
        عنوان_الديناميكي := عنوان_جزء_الكتابة
            + (موضع_الديناميكي - بداية_جزء_الكتابة);
        دع عدد_مداخل_ديناميكية: متغير طبيعي =
            (الطول(الاعتمادات) مثل طبيعي) + 13;
        إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
            // DT_RELA and DT_RELASZ; DT_RELAENT is already counted.
            عدد_مداخل_ديناميكية := عدد_مداخل_ديناميكية + 2;
        };
