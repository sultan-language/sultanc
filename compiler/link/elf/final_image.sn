    // Elf64_Ehdr: 64, 56 and 64.
    دع حجم_رأس_الملف: طبيعي = 40 + 3 * عرض_الكلمة;
    دع حجم_رأس_البرنامج: طبيعي = 8 + 6 * عرض_الكلمة;
    دع حجم_رأس_القسم: طبيعي = 16 + 6 * عرض_الكلمة;
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, نوع_ملف_إلف);
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, آلة_إلف);
    ألحق_ط32_صورة_إلف(&متغير الصورة, &صيغة_الصورة, 1);
    ألحق_كلمة_صورة_إلف(&متغير الصورة, &صيغة_الصورة, عنوان_الدخول);
    ألحق_كلمة_صورة_إلف(&متغير الصورة, &صيغة_الصورة, حجم_رأس_الملف);
    دع موضع_حقل_رؤوس_الأقسام: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_كلمة_صورة_إلف(&متغير الصورة, &صيغة_الصورة, 0);
    ألحق_ط32_صورة_إلف(&متغير الصورة, &صيغة_الصورة, أعلام_إلف_للصورة(السياق));
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, حجم_رأس_الملف);
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, حجم_رأس_البرنامج);
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, عدد_رؤوس_البرنامج);
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, حجم_رأس_القسم);
    دع موضع_حقل_عدد_الأقسام: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, 0);
    دع موضع_حقل_جدول_أسماء_الأقسام: طبيعي =
        الطول(الصورة) مثل طبيعي;
    ألحق_ط16_صورة_إلف(&متغير الصورة, &صيغة_الصورة, 0);

    ألحق_رأس_برنامج_إلف(
        &متغير الصورة, &صيغة_الصورة,
        1,
        5,
        0,
        أساس_التحميل,
        نهاية_قراءة_ملف,
        نهاية_قراءة_صفرية_ذاكرة - أساس_التحميل,
        محاذاة_الجزء
    );
    إذا (يوجد_قسم_كتابة) {
        ألحق_رأس_برنامج_إلف(
        &متغير الصورة, &صيغة_الصورة,
            1,
            6,
            بداية_جزء_الكتابة,
            عنوان_جزء_الكتابة,
            نهاية_كتابة_ملف - بداية_جزء_الكتابة,
            نهاية_كتابة_صفرية_ذاكرة - عنوان_جزء_الكتابة,
            محاذاة_الجزء
        );
    };
    إذا (ديناميكي) {
        إذا (!مكتبة_مشتركة) {
            ألحق_رأس_برنامج_إلف(
        &متغير الصورة, &صيغة_الصورة,
                3,
                4,
                موضع_المفسر,
                أساس_التحميل + موضع_المفسر,
                حجم_المفسر,
                حجم_المفسر,
                1
            );
        };
        ألحق_رأس_برنامج_إلف(
        &متغير الصورة, &صيغة_الصورة,
            2,
            6,
            موضع_الديناميكي,
            عنوان_الديناميكي,
            حجم_الديناميكي,
            حجم_الديناميكي,
            8
        );
    };
    إذا (يوجد_ملاحظة) {
        // One PT_NOTE over the allocated note sections, which the layout
        // keeps together.
        دع بداية_الملاحظات: متغير طبيعي = 0;
        دع عنوان_الملاحظات: متغير طبيعي = 0;
        دع نهاية_الملاحظات: متغير طبيعي = 0;
        دع وجدت: متغير منطقي = خطأ;
        دع فهرس_الملاحظة: متغير طبيعي = 0;
        طالما (فهرس_الملاحظة < (الطول((*السياق).الأقسام) مثل طبيعي)) {
            دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_الملاحظة];
            إذا ((*القسم).حي && قسم_ملاحظة_إلف_محمل(القسم)) {
                طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*القسم).المعرف) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الموضع) -> {
                    دع النهاية: طبيعي = الموضع.إزاحة_الملف + الموضع.حجم_الملف;
                    إذا (!وجدت || الموضع.إزاحة_الملف < بداية_الملاحظات) {
                        بداية_الملاحظات := الموضع.إزاحة_الملف;
                        طابق الموضع.العنوان_الافتراضي مع
                        | اختياري.موجود(ع) -> { عنوان_الملاحظات := ع; }
                        | اختياري.لا_شيء -> { };
                    };
                    إذا (!وجدت || النهاية > نهاية_الملاحظات) { نهاية_الملاحظات := النهاية; };
                    وجدت := صواب;
                };
            };
            فهرس_الملاحظة := فهرس_الملاحظة + 1;
        }
        ألحق_رأس_برنامج_إلف(
        &متغير الصورة, &صيغة_الصورة,
            4,
            4,
            بداية_الملاحظات,
            عنوان_الملاحظات,
            نهاية_الملاحظات - بداية_الملاحظات,
            نهاية_الملاحظات - بداية_الملاحظات,
            4
        );
    };
    إذا (ديناميكي && !مكتبة_مشتركة) {
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة,
            موضع_المفسر,
            &إعداد_الربط.مفسر_إلف
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    // The output layout already knows the end of all section payloads.
    // Extend the image once before placing sections and relocation data,
    // instead of repeatedly growing it for each independently live section.
    إذا (!أكمل_إلف_إلى_موضع(&متغير الصورة, نهاية_الأقسام_غير_المحملة)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };

    فهرس_القسم := 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        إذا ((*القسم).حي && !قسم_إلف_صفري_تنفيذيا(القسم)) {
            طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*القسم).المعرف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختياري.موجود(الموضع) -> {
                طابق (*القسم).المحتوى مع
                | اختياري.لا_شيء -> {
                    إذا (!اكتب_قسم_إلف_من_مدخله_في_الصورة(
                        &متغير الصورة, السياق, القسم, الموضع.إزاحة_الملف
                    )) {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                        );
                    };
                }
                | اختياري.موجود(المحتوى) -> {
                    إذا ((الطول(المحتوى) مثل طبيعي) != (*القسم).الحجم
                        || !اكتب_بايتات_إلف_ربط_في(
                            &متغير الصورة,
                            الموضع.إزاحة_الملف,
                            &المحتوى
                        )) {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                        );
                    };
                };
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    // The objects' symbols for the output's .symtab (symbol_output.sn),
    // before their bytes are released.
    احفظ_رموز_مدخلات_إلف(السياق);

    // Every live executable payload now resides in الصورة. Relocation
    // addends and symbol references were decoded during ingestion and use
    // the canonical edges/symbol table, not the original object file. Drop
    // only regular-object bytes here; shared-library inputs belong to the
    // separate dynamic-dependency ingestion path.
    دع فهرس_المدخل: متغير طبيعي = 0;
    طالما (فهرس_المدخل < (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
        إذا ((*السياق).الخطة.المدخلات[فهرس_المدخل].الصنف
            == صنف_مدخل_ربط.كائن()) {
            دع الفارغ: متجه ط8 = [];
            (*السياق).الخطة.المدخلات[فهرس_المدخل].البايتات := الفارغ;
        };
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع بلت: متغير متجه ط8 = [];
    دع رموز_ديناميكية_خام: متغير متجه ط8 = [];
    دع هاش: متغير متجه ط8 = [];
    دع إزاحات_بلت: متغير متجه ط8 = [];
    دع جوت: متغير متجه ط8 = [];
    دع جدول_ديناميكي: متغير متجه ط8 = [];
    إذا (ديناميكي) {
        طابق (*السياق).الهدف.المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
                    ألحق_بايت_إلف(&متغير بلت, 0xFF);
                    ألحق_بايت_إلف(&متغير بلت, 0x35);
                    دع فرق_دفع: طبيعي;
                    طابق فرق_نسبي_ص32_إلف(
                        عنوان_بلت + 6,
                        عنوان_جوت + 8,
                        0
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { فرق_دفع := القيمة; };
                    ألحق_ط32_إلف_ربط(&متغير بلت, فرق_دفع);
                    ألحق_بايت_إلف(&متغير بلت, 0xFF);
                    ألحق_بايت_إلف(&متغير بلت, 0x25);
                    دع فرق_قفز: طبيعي;
                    طابق فرق_نسبي_ص32_إلف(
                        عنوان_بلت + 12,
                        عنوان_جوت + 16,
                        0
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { فرق_قفز := القيمة; };
                    ألحق_ط32_إلف_ربط(&متغير بلت, فرق_قفز);
                    دع حشو_بلت: متجه ط8 = [0x0F,0x1F,0x40,0x00];
                    ألحق_بايتات_إلف_ربط(&متغير بلت, &حشو_بلت);

                    فهرس_الديناميكي := 0;
                    طالما (فهرس_الديناميكي < عدد_رموز_الاستيراد) {
                        دع عنوان_مدخل_بلت: طبيعي =
                            عنوان_بلت + (فهرس_الديناميكي + 1) * 16;
                        ألحق_بايت_إلف(&متغير بلت, 0xFF);
                        ألحق_بايت_إلف(&متغير بلت, 0x25);
                        دع عنوان_مدخل_جوت: طبيعي =
                            عنوان_جوت + (فهرس_الديناميكي + 3) * 8;
                        دع فرق_جوت: طبيعي;
                        طابق فرق_نسبي_ص32_إلف(
                            عنوان_مدخل_بلت + 6,
                            عنوان_مدخل_جوت,
                            0
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختياري.موجود(القيمة) -> { فرق_جوت := القيمة; };
                        ألحق_ط32_إلف_ربط(&متغير بلت, فرق_جوت);
                        ألحق_بايت_إلف(&متغير بلت, 0x68);
                        ألحق_ط32_إلف_ربط(&متغير بلت, فهرس_الديناميكي);
                        ألحق_بايت_إلف(&متغير بلت, 0xE9);
                        دع فرق_بلت_صفر: طبيعي;
                        طابق فرق_نسبي_ص32_إلف(
                            عنوان_مدخل_بلت + 16,
                            عنوان_بلت,
                            0
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختياري.موجود(القيمة) -> { فرق_بلت_صفر := القيمة; };
                        ألحق_ط32_إلف_ربط(&متغير بلت, فرق_بلت_صفر);
                        فهرس_الديناميكي := فهرس_الديناميكي + 1;
                    }

        }
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            طابق ابن_بلت_إلف_ذراع64(
                عدد_رموز_الاستيراد,
                عنوان_بلت,
                عنوان_جوت
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                );
            }
            | اختياري.موجود(القيمة) -> { بلت := القيمة; };
        }
        | _ -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
            );
        };

        ألحق_أصفارا_إلف_ربط(&متغير رموز_ديناميكية_خام, 24);
        فهرس_الديناميكي := 0;
        طالما (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
            إذا (!ألحق_رمز_ديناميكي_إلف64(
                &متغير رموز_ديناميكية_خام,
                السياق,
                &الرموز_الديناميكية[فهرس_الديناميكي]
            )) {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            };
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        ألحق_ط32_إلف_ربط(&متغير هاش, 1);
        ألحق_ط32_إلف_ربط(&متغير هاش, عدد_الرموز_الديناميكية + 1);
        ألحق_ط32_إلف_ربط(&متغير هاش, 1);
        ألحق_ط32_إلف_ربط(&متغير هاش, 0);
        فهرس_الديناميكي := 1;
        طالما (فهرس_الديناميكي <= عدد_الرموز_الديناميكية) {
            إذا (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
                ألحق_ط32_إلف_ربط(
                    &متغير هاش,
                    فهرس_الديناميكي + 1
                );
            } وإلا {
                ألحق_ط32_إلف_ربط(&متغير هاش, 0);
            };
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        فهرس_الديناميكي := 0;
        طالما (فهرس_الديناميكي < عدد_رموز_الاستيراد) {
            دع عنوان_مدخل_جوت: طبيعي =
                عنوان_جوت + (فهرس_الديناميكي + 3) * 8;
            دع نوع_قفزة_بلت: طبيعي;
            طابق نوع_قفزة_بلت_إلف(&(*السياق).الهدف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
                );
            }
            | اختياري.موجود(القيمة) -> { نوع_قفزة_بلت := القيمة; };
            دع معلومات_الإزاحة: طبيعي =
                (فهرس_الديناميكي + 1) * 4294967296 + نوع_قفزة_بلت;
            ألحق_ط64_إلف_ربط(&متغير إزاحات_بلت, عنوان_مدخل_جوت);
            ألحق_ط64_إلف_ربط(&متغير إزاحات_بلت, معلومات_الإزاحة);
            ألحق_ط64_إلف_ربط(&متغير إزاحات_بلت, 0);
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        ألحق_ط64_إلف_ربط(&متغير جوت, عنوان_الديناميكي);
        ألحق_ط64_إلف_ربط(&متغير جوت, 0);
        ألحق_ط64_إلف_ربط(&متغير جوت, 0);
        فهرس_الديناميكي := 0;
        طالما (فهرس_الديناميكي < عدد_رموز_الاستيراد) {
            دع قيمة_جوت_الأولية: طبيعي;
            طابق (*السياق).الهدف.المعمارية.الهوية مع
            | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
                قيمة_جوت_الأولية :=
                    عنوان_بلت + (فهرس_الديناميكي + 1) * 16 + 6;
            }
            | هوية_معمارية.ذراع_أربعة_وستون -> {
                قيمة_جوت_الأولية := عنوان_بلت;
            }
            | _ -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
                );
            };
            ألحق_ط64_إلف_ربط(&متغير جوت, قيمة_جوت_الأولية);
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        فهرس_الاعتماد := 0;
        طالما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل طبيعي)) {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي,
                1,
                الاعتمادات[فهرس_الاعتماد].إزاحة_الاسم
            );
            فهرس_الاعتماد := فهرس_الاعتماد + 1;
        }
        طابق إزاحة_اسم_المخرج مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الإزاحة) -> {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي,
                14,
                الإزاحة
            );
        };
        طابق إزاحة_مسار_التشغيل مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الإزاحة) -> {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي,
                29,
                الإزاحة
            );
        };
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            4,
            عنوان_هاش
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            5,
            عنوان_النصوص_الديناميكية
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            6,
            عنوان_الرموز_الديناميكية
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            10,
            الطول(جدول_النصوص_الديناميكي) مثل طبيعي
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 11, 24);
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 3, عنوان_جوت);
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            2,
            عدد_رموز_الاستيراد * 24
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 20, 7);
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            23,
            عنوان_إزاحات_بلت
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 9, 24);
        إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي, 7, عنوان_إزاحات_ديناميكية
            );
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي, 8, عدد_إزاحات_البيانات_الديناميكية * 24
            );
        };
        // DT_FLAGS DF_BIND_NOW and DT_FLAGS_1 DF_1_NOW: the loader binds
        // every import at load. An imported object (`extern let stderr`)
        // is read through its .got.plt slot, which lazy binding would leave
        // pointing at the PLT until the first call.
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 30, 8);
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 0x6ffffffb, 1);
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 0, 0);

        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة, موضع_بلت, &بلت
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة,
            موضع_النصوص_الديناميكية,
            &جدول_النصوص_الديناميكي
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة,
            موضع_الرموز_الديناميكية,
            &رموز_ديناميكية_خام
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة, موضع_هاش, &هاش
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة, موضع_إزاحات_بلت, &إزاحات_بلت
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة, موضع_جوت, &جوت
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        إذا (!اكتب_بايتات_إلف_ربط_في(
            &متغير الصورة, موضع_الديناميكي, &جدول_ديناميكي
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    إذا (!أكمل_إلف_إلى_موضع(&متغير الصورة, نهاية_الأقسام_غير_المحملة)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };

    دع جدول_أسماء_الأقسام: متغير متجه ط8 = [0];
    دع مواضع_أسماء_الأقسام: متغير متجه اختياري طبيعي = [];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس_القسم].حي) {
            ألحق(
                مواضع_أسماء_الأقسام,
                اختياري.موجود(
                    أضف_اسم_إلى_جدول_إلف(
                        &متغير جدول_أسماء_الأقسام,
                        &(*السياق).الأقسام[فهرس_القسم].الاسم.اسم_القسم
                    )
                )
            );
        } وإلا {
            ألحق(مواضع_أسماء_الأقسام, اختياري.لا_شيء());
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع موضع_اسم_بلت: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_النصوص_الديناميكية: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_الرموز_الديناميكية: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_هاش: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_إزاحات_بلت: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_إزاحات_ديناميكية: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_جوت: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع موضع_اسم_الديناميكي: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا (ديناميكي) {
        دع اسم_بلت: متجه ط8 = بايتات_من_نص(«.plt»);
        دع اسم_النصوص_الديناميكية: متجه ط8 = بايتات_من_نص(«.dynstr»);
        دع اسم_الرموز_الديناميكية: متجه ط8 = بايتات_من_نص(«.dynsym»);
        دع اسم_هاش: متجه ط8 = بايتات_من_نص(«.hash»);
        دع اسم_إزاحات_بلت: متجه ط8 = بايتات_من_نص(«.rela.plt»);
        إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
            دع اسم_إزاحات_ديناميكية: متجه ط8 = بايتات_من_نص(«.rela.dyn»);
            موضع_اسم_إزاحات_ديناميكية := اختياري.موجود(
                أضف_اسم_إلى_جدول_إلف(
                    &متغير جدول_أسماء_الأقسام, &اسم_إزاحات_ديناميكية
                )
            );
        };
        دع اسم_جوت: متجه ط8 = بايتات_من_نص(«.got.plt»);
        دع اسم_الديناميكي: متجه ط8 = بايتات_من_نص(«.dynamic»);
        موضع_اسم_بلت := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(&متغير جدول_أسماء_الأقسام, &اسم_بلت)
        );
        موضع_اسم_النصوص_الديناميكية := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_أسماء_الأقسام,
                &اسم_النصوص_الديناميكية
            )
        );
        موضع_اسم_الرموز_الديناميكية := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_أسماء_الأقسام,
                &اسم_الرموز_الديناميكية
            )
        );
        موضع_اسم_هاش := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(&متغير جدول_أسماء_الأقسام, &اسم_هاش)
        );
        موضع_اسم_إزاحات_بلت := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_أسماء_الأقسام,
                &اسم_إزاحات_بلت
            )
        );
        موضع_اسم_جوت := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(&متغير جدول_أسماء_الأقسام, &اسم_جوت)
        );
        موضع_اسم_الديناميكي := اختياري.موجود(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_أسماء_الأقسام,
                &اسم_الديناميكي
            )
        );
    };
    دع اسم_جدول_أسماء_الأقسام: متجه ط8 = بايتات_من_نص(«.shstrtab»);
    دع موضع_اسم_جدول_أسماء_الأقسام: طبيعي =
        أضف_اسم_إلى_جدول_إلف(
            &متغير جدول_أسماء_الأقسام,
            &اسم_جدول_أسماء_الأقسام
        );
    دع موضع_جدول_أسماء_الأقسام: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_أسماء_الأقسام);
    دع موضع_رؤوس_الأقسام: طبيعي = حاذ_قيمة_إلف(
        الطول(الصورة) مثل طبيعي,
        8
    );
    إذا (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_رؤوس_الأقسام)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_أصفارا_إلف_ربط(&متغير الصورة, حجم_رأس_القسم);
    دع عدد_الأقسام_المرئية: متغير طبيعي = 1;
    فهرس_القسم := 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس_القسم].حي) {
            دع موضع_الاسم: طبيعي;
            طابق مواضع_أسماء_الأقسام[فهرس_القسم] مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختياري.موجود(القيمة) -> { موضع_الاسم := القيمة; };
            دع موضع_القسم: موضع_قسم_خرج_ربط;
            طابق ابحث_موضع_قسم_خرج_ربط(
                &التخطيط,
                (*السياق).الأقسام[فهرس_القسم].المعرف
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };
            دع النوع: طبيعي;
            دع الأعلام: طبيعي;
            طابق (*السياق).الأقسام[فهرس_القسم].حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.إلف(نوع_القسم, أعلام_القسم) -> {
                النوع := نوع_القسم;
                الأعلام := أعلام_القسم;
            }
            | _ -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            };
            دع عنوان_القسم: متغير طبيعي = 0;
            طابق موضع_القسم.العنوان_الافتراضي مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(القيمة) -> { عنوان_القسم := القيمة; };
            دع المحاذاة: متغير طبيعي =
                (*السياق).الأقسام[فهرس_القسم].المحاذاة;
            إذا (المحاذاة == 0) { المحاذاة := 1; };
            ألحق_رأس_قسم_إلف(
        &متغير الصورة, &صيغة_الصورة,
                موضع_الاسم,
                النوع,
                الأعلام,
                عنوان_القسم,
                موضع_القسم.إزاحة_الملف,
                (*السياق).الأقسام[فهرس_القسم].الحجم,
                المحاذاة
            );
            عدد_الأقسام_المرئية := عدد_الأقسام_المرئية + 1;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    إذا (ديناميكي) {
        دع فهرس_بلت: طبيعي = عدد_الأقسام_المرئية;
        دع فهرس_النصوص_الديناميكية: طبيعي = فهرس_بلت + 1;
        دع فهرس_الرموز_الديناميكية: طبيعي = فهرس_بلت + 2;
        دع فهرس_هاش: طبيعي = فهرس_بلت + 3;
        دع فهرس_إزاحات_بلت: طبيعي = فهرس_بلت + 4;
        دع فهرس_إزاحات_ديناميكية: طبيعي = فهرس_بلت + 5;
        دع فرق_قسم_الإزاحات: متغير طبيعي = 0;
        إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
            فرق_قسم_الإزاحات := 1;
        };
        دع فهرس_جوت: طبيعي = فهرس_إزاحات_ديناميكية + فرق_قسم_الإزاحات;
        دع فهرس_الديناميكي: طبيعي = فهرس_جوت + 1;
        دع اسم_بلت: طبيعي;
        دع اسم_النصوص_الديناميكية: طبيعي;
        دع اسم_الرموز_الديناميكية: طبيعي;
        دع اسم_هاش: طبيعي;
        دع اسم_إزاحات_بلت: طبيعي;
        دع اسم_جوت: طبيعي;
        دع اسم_الديناميكي: طبيعي;
        طابق موضع_اسم_بلت مع
        | اختياري.موجود(القيمة) -> { اسم_بلت := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_النصوص_الديناميكية مع
        | اختياري.موجود(القيمة) -> { اسم_النصوص_الديناميكية := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_الرموز_الديناميكية مع
        | اختياري.موجود(القيمة) -> { اسم_الرموز_الديناميكية := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_هاش مع
        | اختياري.موجود(القيمة) -> { اسم_هاش := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_إزاحات_بلت مع
        | اختياري.موجود(القيمة) -> { اسم_إزاحات_بلت := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_جوت مع
        | اختياري.موجود(القيمة) -> { اسم_جوت := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };
        طابق موضع_اسم_الديناميكي مع
        | اختياري.موجود(القيمة) -> { اسم_الديناميكي := القيمة; }
        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        ); };

        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_بلت, 1, 6, عنوان_بلت,
            موضع_بلت, حجم_بلت, 0, 0, 16, 16
        );
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_النصوص_الديناميكية, 3, 2,
            عنوان_النصوص_الديناميكية, موضع_النصوص_الديناميكية,
            الطول(جدول_النصوص_الديناميكي) مثل طبيعي,
            0, 0, 1, 0
        );
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_الرموز_الديناميكية, 11, 2,
            عنوان_الرموز_الديناميكية, موضع_الرموز_الديناميكية,
            (عدد_الرموز_الديناميكية + 1) * 24,
            فهرس_النصوص_الديناميكية, 1, 8, 24
        );
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_هاش, 5, 2, عنوان_هاش, موضع_هاش,
            (عدد_الرموز_الديناميكية + 4) * 4,
            فهرس_الرموز_الديناميكية, 0, 4, 4
        );
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_إزاحات_بلت, 4, 2,
            عنوان_إزاحات_بلت, موضع_إزاحات_بلت,
            عدد_رموز_الاستيراد * 24,
            فهرس_الرموز_الديناميكية, فهرس_بلت, 8, 24
        );
        إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
            دع اسم_إزاحات_ديناميكية: طبيعي;
            طابق موضع_اسم_إزاحات_ديناميكية مع
            | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            ); }
            | اختياري.موجود(القيمة) -> { اسم_إزاحات_ديناميكية := القيمة; };
            ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_إزاحات_ديناميكية, 4, 2,
                عنوان_إزاحات_ديناميكية, موضع_إزاحات_ديناميكية,
                عدد_إزاحات_البيانات_الديناميكية * 24,
                فهرس_الرموز_الديناميكية, 0, 8, 24
            );
        };
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_جوت, 1, 3, عنوان_جوت,
            موضع_جوت, حجم_جوت, 0, 0, 8, 8
        );
        ألحق_رأس_قسم_إلف_كامل(
            &متغير الصورة, &صيغة_الصورة, اسم_الديناميكي, 6, 3,
            عنوان_الديناميكي, موضع_الديناميكي, حجم_الديناميكي,
            فهرس_النصوص_الديناميكية, 0, 8, 16
        );
        عدد_الأقسام_المرئية := فهرس_الديناميكي + 1;
    };
    دع فهرس_جدول_أسماء_الأقسام: طبيعي = عدد_الأقسام_المرئية;
    ألحق_رأس_قسم_إلف(
        &متغير الصورة, &صيغة_الصورة,
        موضع_اسم_جدول_أسماء_الأقسام,
        3,
        0,
        0,
        موضع_جدول_أسماء_الأقسام,
        الطول(جدول_أسماء_الأقسام) مثل طبيعي,
        1
    );
    عدد_الأقسام_المرئية := عدد_الأقسام_المرئية + 1;

    إذا (!اكتب_كلمة_صورة_إلف_في(
        &متغير الصورة,
        &صيغة_الصورة,
        موضع_حقل_رؤوس_الأقسام,
        موضع_رؤوس_الأقسام
    )) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (عدد_الأقسام_المرئية > 0xFFFF
        || فهرس_جدول_أسماء_الأقسام > 0xFFFF) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    // e_shnum / e_shstrndx are 16-bit fields.
    اكتب_ط16_صورة_إلف_في(&متغير الصورة, &صيغة_الصورة, موضع_حقل_عدد_الأقسام, عدد_الأقسام_المرئية);
    اكتب_ط16_صورة_إلف_في(&متغير الصورة, &صيغة_الصورة, موضع_حقل_جدول_أسماء_الأقسام, فهرس_جدول_أسماء_الأقسام);

    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
    دع خانة_جوت: متغير طبيعي = 0;
    طالما (خانة_جوت < (الطول(رموز_الجوت_المحلي) مثل طبيعي)) {
        دع المرجع_المحلي: مرجع_إزاحة_ربط = مرجع_إزاحة_ربط.رمز(رموز_الجوت_المحلي[خانة_جوت]);
        طابق قيمة_قاعدة_مرجع_إلف(السياق, &المرجع_المحلي) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح());
        }
        | اختياري.موجود(العنوان) -> {
            إذا (!اكتب_كلمة_صورة_إلف_في(&متغير الصورة, &صيغة_الصورة, موضع_الجوت_المحلي + خانة_جوت * عرض_الكلمة, العنوان)) {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح());
            };
        };
        خانة_جوت := خانة_جوت + 1;
    }
    // Static images (relocation_patch.sn): GOT slots by symbol and
    // PowerPC 64 local entries by global entry address.
    دع منقولة: منطقي = صورة_إلف_ثابتة_منقولة((*السياق).الهدف.المعمارية.الهوية);
    دع حالة_المنقولة: متغير حالة_إزاحات_منقولة_إلف = {
        الترتيب: صيغة_الصورة.الترتيب,
        خانات_الجوت: أنشئ_الخريطة(هاش_عدد_إزاحة_إلف, عددان_إزاحة_إلف_متساويان),
        عنوان_الجوت_المحلي: عنوان_الجوت_المحلي,
        عرض_الكلمة: عرض_الكلمة,
        أساس_الجوت: عنوان_جوت,
        أساس_الجدول_المحتوى: أساس_الجدول_المحتوى,
        المداخل_المحلية: أنشئ_الخريطة(هاش_عدد_إزاحة_إلف, عددان_إزاحة_إلف_متساويان)
    };
    إذا (منقولة) {
        دع فهرس_الخانة: متغير طبيعي = 0;
        طالما (فهرس_الخانة < (الطول(رموز_الجوت_المحلي) مثل طبيعي)) {
            دع مفتاح_الخانة: طبيعي = رموز_الجوت_المحلي[فهرس_الخانة].القيمة مثل طبيعي;
            دع أدرجت_الخانة: نتيجة اختياري طبيعي, خطأ_إدراج_الخريطة =
                أدرج_في_الخريطة(&متغير حالة_المنقولة.خانات_الجوت, مفتاح_الخانة, فهرس_الخانة);
            فهرس_الخانة := فهرس_الخانة + 1;
        }
        دع فهرس_الدخول: متغير طبيعي = 0;
        طالما (فهرس_الدخول < (الطول((*السياق).مداخل_محلية) مثل طبيعي)) {
            دع الدخول: &دخول_محلي_ربط = &(*السياق).مداخل_محلية[فهرس_الدخول];
            طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الدخول).القسم) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الموضع) -> {
                طابق الموضع.العنوان_الافتراضي مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(العنوان) -> {
                    دع أدرج_الدخول: نتيجة اختياري طبيعي, خطأ_إدراج_الخريطة = أدرج_في_الخريطة(
                        &متغير حالة_المنقولة.المداخل_المحلية, العنوان + (*الدخول).الإزاحة, (*الدخول).الفرق);
                };
            };
            فهرس_الدخول := فهرس_الدخول + 1;
        }
    };
    دع فهرس_الإزاحة: متغير طبيعي = 0;
    طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط =
            &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع القسم_المصدر: قسم_ربط;
        طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختياري.موجود(القسم) -> { القسم_المصدر := القسم; };
        إذا (القسم_المصدر.حي && منقولة) {
            طابق اكتب_إزاحة_إلف_منقولة_في_الصورة(&متغير الصورة, السياق, الحافة, &حالة_المنقولة) مع
            | نتيجة_صورة_إلف_تنفيذية.نجح(_) -> { }
            | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ);
            };
        } وإلا إذا (القسم_المصدر.حي) {
            طابق اكتب_إزاحة_إلف_في_الصورة(
                &متغير الصورة,
                السياق,
                الحافة,
                &الرموز_الديناميكية,
                عنوان_بلت,
                عنوان_جوت,
                عنوان_الجوت_المحلي
            ) مع
            | نتيجة_صورة_إلف_تنفيذية.نجح(_) -> { }
            | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ);
            };
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }

    إذا (عدد_إزاحات_البيانات_الديناميكية > 0) {
        دع سجلات_الإزاحة: متغير متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
            دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
            إذا (إزاحة_بيانات_ديناميكية_مطلقة_إلف(السياق, الحافة)) {
                دع القسم: قسم_ربط;
                طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
                | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                ); }
                | اختياري.موجود(القيمة) -> { القسم := القيمة; };
                إذا (القسم.حي && قسم_إلف_محمل_تنفيذيا(&القسم)) {
                    إذا (!قسم_إلف_قابل_للكتابة_تنفيذيا(&القسم)
                        || !قسم_إلف_محمل_تنفيذيا(&القسم)) {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
                        );
                    };
                    دع العنوان: طبيعي;
                    طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                    ); }
                    | اختياري.موجود(القيمة) -> { العنوان := القيمة; };
                    إذا ((*الحافة).الإزاحة > القسم.الحجم
                        || 8 > القسم.الحجم - (*الحافة).الإزاحة) {
                        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    };
                    دع ترتيب_الرمز: طبيعي;
                    طابق (*الحافة).المرجع مع
                    | مرجع_إزاحة_ربط.قسم(_) -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                    ); }
                    | مرجع_إزاحة_ربط.رمز(المعرف) -> {
                        طابق ابحث_ترتيب_رمز_ديناميكي_إلف(&الرموز_الديناميكية, المعرف) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                            خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(
                                اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
                            )
                        ); }
                        | اختياري.موجود(الترتيب) -> { ترتيب_الرمز := الترتيب; };
                    };
                    ألحق_ط64_إلف_ربط(&متغير سجلات_الإزاحة, العنوان);
                    ألحق_ط64_إلف_ربط(
                        &متغير سجلات_الإزاحة,
                        (ترتيب_الرمز + 1) * 4294967296 + 1
                    );
                    ألحق_ط64_إلف_ربط(
                        &متغير سجلات_الإزاحة, (*الحافة).إضافة مثل طبيعي
                    );
                };
            };
            الفهرس := الفهرس + 1;
        }
        إذا ((الطول(سجلات_الإزاحة) مثل طبيعي)
            != عدد_إزاحات_البيانات_الديناميكية * 24
            || !اكتب_بايتات_إلف_ربط_في(
                &متغير الصورة, موضع_إزاحات_ديناميكية, &سجلات_الإزاحة
            )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(الصورة);
}


عام عرف ابن_صورة_إلف_نظامية_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_إلف_تنفيذية {
    طابق ابن_صورة_إلف_نظامية(السياق, نوع_خرج_ربط.تنفيذي()) مع
    | نتيجة_صورة_إلف_تنفيذية.نجح(البايتات) -> {
        // The symbol table debuggers and unwinders read (symbol_output.sn).
        دع الصورة: متغير متجه ط8 = البايتات;
        أضف_جدول_رموز_إلف_إلى_الصورة(&متغير الصورة, السياق);
        أرجع نتيجة_صورة_إلف_تنفيذية.نجح(الصورة);
    }
    | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> { أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ); };
}

// The linker-defined symbol naming the GOT (GNU ld, lld).
عام عرف اسم_جدول_الإزاحات_العام_إلف(): متجه ط8 { أرجع بايتات_من_نص(«_GLOBAL_OFFSET_TABLE_»); }
