    // _GLOBAL_OFFSET_TABLE_ is the GOT's start (.got.plt), as GNU ld and lld
    // place it; without a GOT, the end of the writable data.
    دع جدول_الإزاحات_العام: متجه ط8 = اسم_جدول_الإزاحات_العام_إلف();
    ثبت_حد_منشئات_إلف_المحلول(السياق, &جدول_الإزاحات_العام, عنوان_جوت);
    // PowerPC 64: .TOC., the TOC pointer r2 holds, 0x8000 past the start of
    // the writable data (the TOC: .toc entries and the local GOT); TOC16
    // relocations reach 2 GiB either side of it.
    دع أساس_الجدول_المحتوى: طبيعي = عنوان_جزء_الكتابة + 0x8000;
    دع اسم_الجدول_المحتوى: متجه ط8 = اسم_أساس_جدول_المحتوى_إلف();
    ثبت_حد_منشئات_إلف_المحلول(السياق, &اسم_الجدول_المحتوى, أساس_الجدول_المحتوى);

    دع نهاية_وضع_الكتابة_الصفرية: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            صواب,
            صواب,
            نهاية_كتابة_ملف,
            نهاية_كتابة_ذاكرة
        );
    دع نهاية_كتابة_صفرية_ملف: طبيعي =
        نهاية_وضع_الكتابة_الصفرية.موضع_الملف;
    دع نهاية_كتابة_صفرية_ذاكرة: طبيعي =
        نهاية_وضع_الكتابة_الصفرية.عنوان_الذاكرة;
    دع بداية_غير_المحمل: طبيعي = حاذ_قيمة_إلف(
        نهاية_كتابة_صفرية_ملف,
        8
    );
    دع نهاية_الأقسام_غير_المحملة: طبيعي =
        ضع_أقسام_إلف_غير_المحملة_تنفيذيا(
            السياق,
            &متغير التخطيط,
            بداية_غير_المحمل
        );
    التخطيط.حجم_الملف := نهاية_الأقسام_غير_المحملة;
    إذا (!مكتبة_مشتركة
        && !ثبت_مجال_منشئات_إلف(السياق, &التخطيط, أساس_التحميل)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    دع عنوان_الدخول: متغير طبيعي = 0;
    إذا (!مكتبة_مشتركة) {
        دع اسم_الدخول: متجه ط8;
        طابق (*السياق).الخطة.رمز_الدخول مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
            );
        }
        | اختياري.موجود(الاسم) -> { اسم_الدخول := الاسم; };
        دع رمز_الدخول: رمز_ربط;
        طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
            );
        }
        | اختياري.موجود(الرمز) -> { رمز_الدخول := الرمز; };
        طابق رمز_الدخول.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
                دع موضع_القسم: موضع_قسم_خرج_ربط;
                طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
                    );
                }
                | اختياري.موجود(القيمة) -> { موضع_القسم := القيمة; };
                طابق موضع_القسم.العنوان_الافتراضي مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
                    );
                }
                | اختياري.موجود(العنوان) -> {
                    عنوان_الدخول := العنوان + الإزاحة;
                };
            }
            | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> {
