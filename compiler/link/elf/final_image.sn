استورد compiler.link.context;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.elf.encoding;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.dynamic_link_query_context;

عام نوع خطأ_صورة_إلف_تنفيذية =
    | هدف_غير_مدعوم
    | تخطيط_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_محلول
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
;

عام نوع نتيجة_صورة_إلف_تنفيذية =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_صورة_إلف_تنفيذية
;

نوع رمز_ديناميكي_إلف_ربط = {
    المعرف: معرف_رمز_ربط,
    الاسم: متجه غ8,
    إزاحة_الاسم: غير_موقع
};

نوع اعتماد_ديناميكي_إلف_ربط = {
    الاسم: متجه غ8,
    إزاحة_الاسم: غير_موقع
};



عرف انسخ_متجه_بايتات_إلف(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    ألحق_بايتات_إلف_ربط(&متغير الناتج, المصدر);
    أرجع الناتج;
}

عرف متجها_بايتات_إلف_متساويان(
    الأول: &متجه غ8,
    الثاني: &متجه غ8
): منطقي {
    لو ((الطول(*الأول) مثل غير_موقع) != (الطول(*الثاني) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الأول) مثل غير_موقع)) {
        لو ((*الأول)[فهرس_البايت] != (*الثاني)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف أضف_اسم_إلى_جدول_إلف(
    الجدول: &متغير متجه غ8,
    الاسم: &متجه غ8
): غير_موقع {
    دع الموضع: غير_موقع = الطول(*الجدول) مثل غير_موقع;
    ألحق_بايتات_إلف_ربط(الجدول, الاسم);
    ألحق(*الجدول, 0);
    أرجع الموضع;
}

عرف اجمع_إضافة_إلف(
    الأساس: غير_موقع,
    الإضافة: عدد
): اختيار غير_موقع {
    لو (الإضافة >= 0) {
        دع المقدار: غير_موقع = الإضافة مثل غير_موقع;
        دع الناتج: غير_موقع = الأساس + المقدار;
        لو (الناتج < الأساس) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الناتج);
    };
    دع المقدار: غير_موقع = (-الإضافة) مثل غير_موقع;
    لو (المقدار > الأساس) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الأساس - المقدار);
}

عرف قسم_إلف_محمل_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(_, الأعلام) -> {
        أرجع (الأعلام & 2) != 0;
    }
    | _ -> { أرجع خطأ; };
}

عرف قسم_إلف_قابل_للكتابة_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(_, الأعلام) -> {
        أرجع (الأعلام & 1) != 0;
    }
    | _ -> { أرجع خطأ; };
}

عرف قسم_إلف_صفري_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.إلف(النوع, _) -> { أرجع النوع == 8; }
    | _ -> { أرجع خطأ; };
}

عرف أضف_اعتماد_ديناميكي_إلف_إن_لم_يوجد(
    الاعتمادات: &متغير متجه اعتماد_ديناميكي_إلف_ربط,
    الاسم: &متجه غ8
): فراغ {
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل غير_موقع)) {
        لو (متجها_بايتات_إلف_متساويان(
            &(*الاعتمادات)[فهرس_الاعتماد].الاسم,
            الاسم
        )) {
            أرجع;
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع الاعتماد: اعتماد_ديناميكي_إلف_ربط = {
        الاسم: انسخ_متجه_بايتات_إلف(الاسم),
        إزاحة_الاسم: 0
    };
    ألحق(*الاعتمادات, الاعتماد);
}

عرف ابن_قائمة_رموز_ديناميكية_إلف(
    السياق: &سياق_ربط
): متجه رمز_ديناميكي_إلف_ربط {
    دع الرموز: متغير متجه رمز_ديناميكي_إلف_ربط = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        دع أضف_الرمز: متغير منطقي = خطأ;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { أضف_الرمز := صواب; }
        | حالة_رمز_ربط.ديناميكي(_) -> { أضف_الرمز := صواب; }
        | _ -> { };
        لو (أضف_الرمز) {
            دع الديناميكي: رمز_ديناميكي_إلف_ربط = {
                المعرف: (*الرمز).المعرف,
                الاسم: انسخ_متجه_بايتات_إلف(&(*الرمز).الاسم),
                إزاحة_الاسم: 0
            };
            ألحق(الرموز, الديناميكي);
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع الرموز;
}

عرف ابحث_ترتيب_رمز_ديناميكي_إلف(
    الرموز: &متجه رمز_ديناميكي_إلف_ربط,
    المعرف: معرف_رمز_ربط
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        لو ((*الرموز)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_اعتمادات_إلف(
    السياق: &سياق_ربط,
    إعداد_الربط: &إعداد_ربط_ديناميكي_هدف
): متجه اعتماد_ديناميكي_إلف_ربط {
    دع الاعتمادات: متغير متجه اعتماد_ديناميكي_إلف_ربط = [];
    أضف_اعتماد_ديناميكي_إلف_إن_لم_يوجد(
        &متغير الاعتمادات,
        &(*إعداد_الربط).مكتبة_نظام_افتراضية
    );
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        أضف_اعتماد_ديناميكي_إلف_إن_لم_يوجد(
            &متغير الاعتمادات,
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].الاسم
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع الاعتمادات;
}

عرف ابن_مسار_تشغيل_إلف(السياق: &سياق_ربط): متجه غ8 {
    دع المسار: متغير متجه غ8 = [];
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        طابق (*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].دليل_البحث مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الدليل) -> {
            لو ((الطول(المسار) مثل غير_موقع) > 0) {
                ألحق(المسار, 0x3A);
            };
            ألحق_بايتات_إلف_ربط(&متغير المسار, &الدليل);
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع المسار;
}

نوع نتيجة_وضع_أقسام_إلف = {
    موضع_الملف: غير_موقع,
    عنوان_الذاكرة: غير_موقع
};

عرف أضف_مواضع_أقسام_إلف_ملفوفة(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    قابلة_للكتابة: منطقي,
    صفرية: منطقي,
    موضع_الملف_الأولي: غير_موقع,
    عنوان_الذاكرة_الأولي: غير_موقع
): نتيجة_وضع_أقسام_إلف {
    دع موضع_الملف: متغير غير_موقع = موضع_الملف_الأولي;
    دع عنوان_الذاكرة: متغير غير_موقع = عنوان_الذاكرة_الأولي;
    دع انحياز_الجزء: غير_موقع =
        عنوان_الذاكرة_الأولي - موضع_الملف_الأولي;
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو (
            (*القسم).حي
            && قسم_إلف_محمل_تنفيذيا(القسم)
            && قسم_إلف_قابل_للكتابة_تنفيذيا(القسم) == قابلة_للكتابة
            && قسم_إلف_صفري_تنفيذيا(القسم) == صفرية
        ) {
            دع المحاذاة: متغير غير_موقع = (*القسم).المحاذاة;
            لو (المحاذاة == 0) { المحاذاة := 1; };
            لو (صفرية) {
                عنوان_الذاكرة := حاذ_قيمة_إلف(عنوان_الذاكرة, المحاذاة);
            } وإلا {
                موضع_الملف := حاذ_قيمة_إلف(موضع_الملف, المحاذاة);
                بينما (((موضع_الملف + انحياز_الجزء) % المحاذاة) != 0) {
                    موضع_الملف := موضع_الملف + 1;
                }
                عنوان_الذاكرة := موضع_الملف + انحياز_الجزء;
            };
            دع حجم_الملف: متغير غير_موقع = (*القسم).الحجم;
            لو (صفرية) { حجم_الملف := 0; };
            دع الموضع: موضع_قسم_خرج_ربط = {
                القسم: (*القسم).المعرف,
                إزاحة_الملف: موضع_الملف,
                العنوان_الافتراضي: اختيار.بعض(عنوان_الذاكرة),
                حجم_الملف: حجم_الملف,
                حجم_الذاكرة: (*القسم).الحجم
            };
            أضف_موضع_قسم_خرج_ربط(التخطيط, الموضع);
            لو (!صفرية) {
                موضع_الملف := موضع_الملف + (*القسم).الحجم;
            };
            عنوان_الذاكرة := عنوان_الذاكرة + (*القسم).الحجم;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع النتيجة: نتيجة_وضع_أقسام_إلف = {
        موضع_الملف: موضع_الملف,
        عنوان_الذاكرة: عنوان_الذاكرة
    };
    أرجع النتيجة;
}

عرف ضع_أقسام_إلف_غير_المحملة_تنفيذيا(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    البداية: غير_موقع
): غير_موقع {
    دع الموضع_الحالي: متغير غير_موقع = البداية;
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو ((*القسم).حي && !قسم_إلف_محمل_تنفيذيا(القسم)) {
            دع المحاذاة: متغير غير_موقع = (*القسم).المحاذاة;
            لو (المحاذاة == 0) { المحاذاة := 1; };
            الموضع_الحالي := حاذ_قيمة_إلف(الموضع_الحالي, المحاذاة);
            دع الموضع: موضع_قسم_خرج_ربط = {
                القسم: (*القسم).المعرف,
                إزاحة_الملف: الموضع_الحالي,
                العنوان_الافتراضي: اختيار.لا_شيء(),
                حجم_الملف: (*القسم).الحجم,
                حجم_الذاكرة: (*القسم).الحجم
            };
            أضف_موضع_قسم_خرج_ربط(التخطيط, الموضع);
            الموضع_الحالي := الموضع_الحالي + (*القسم).الحجم;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع الموضع_الحالي;
}

عرف ألحق_رأس_برنامج_إلف64(
    الناتج: &متغير متجه غ8,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    موضع_الملف: غير_موقع,
    العنوان: غير_موقع,
    حجم_الملف: غير_موقع,
    حجم_الذاكرة: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    ألحق_غ32_إلف_ربط(الناتج, النوع);
    ألحق_غ32_إلف_ربط(الناتج, الأعلام);
    ألحق_غ64_إلف_ربط(الناتج, موضع_الملف);
    ألحق_غ64_إلف_ربط(الناتج, العنوان);
    ألحق_غ64_إلف_ربط(الناتج, العنوان);
    ألحق_غ64_إلف_ربط(الناتج, حجم_الملف);
    ألحق_غ64_إلف_ربط(الناتج, حجم_الذاكرة);
    ألحق_غ64_إلف_ربط(الناتج, المحاذاة);
}

عرف ألحق_رأس_قسم_إلف64(
    الناتج: &متغير متجه غ8,
    موضع_الاسم: غير_موقع,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    العنوان: غير_موقع,
    موضع_الملف: غير_موقع,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع
): فراغ {
    ألحق_غ32_إلف_ربط(الناتج, موضع_الاسم);
    ألحق_غ32_إلف_ربط(الناتج, النوع);
    ألحق_غ64_إلف_ربط(الناتج, الأعلام);
    ألحق_غ64_إلف_ربط(الناتج, العنوان);
    ألحق_غ64_إلف_ربط(الناتج, موضع_الملف);
    ألحق_غ64_إلف_ربط(الناتج, الحجم);
    ألحق_غ32_إلف_ربط(الناتج, 0);
    ألحق_غ32_إلف_ربط(الناتج, 0);
    ألحق_غ64_إلف_ربط(الناتج, المحاذاة);
    ألحق_غ64_إلف_ربط(الناتج, 0);
}

عرف ألحق_رمز_ديناميكي_إلف64(
    الناتج: &متغير متجه غ8,
    موضع_الاسم: غير_موقع
): فراغ {
    ألحق_غ32_إلف_ربط(الناتج, موضع_الاسم);
    ألحق_بايت_إلف(الناتج, 0x10);
    ألحق_بايت_إلف(الناتج, 0);
    ألحق_غ16_إلف_ربط(الناتج, 0);
    ألحق_غ64_إلف_ربط(الناتج, 0);
    ألحق_غ64_إلف_ربط(الناتج, 0);
}

عرف ألحق_مدخل_ديناميكي_إلف64(
    الناتج: &متغير متجه غ8,
    النوع: غير_موقع,
    القيمة: غير_موقع
): فراغ {
    ألحق_غ64_إلف_ربط(الناتج, النوع);
    ألحق_غ64_إلف_ربط(الناتج, القيمة);
}

عرف قيمة_قاعدة_مرجع_إلف(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط
): اختيار غير_موقع {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(معرف_القسم) -> {
        دع الموضع: موضع_قسم_خرج_ربط;
        دع التخطيط: تخطيط_خرج_ربط;
        طابق (*السياق).التخطيط مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الموضع := القيمة; };
        طابق الموضع.العنوان_الافتراضي مع
        | اختيار.بعض(العنوان) -> { أرجع اختيار.بعض(العنوان); }
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(0); };
    }
    | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
        دع الرمز: رمز_ربط;
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, معرف_الرمز) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الرمز := القيمة; };
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                أرجع اختيار.بعض(القيمة);
            }
            | موضع_تعريف_رمز_ربط.غير_محدد -> {
                أرجع اختيار.لا_شيء();
            }
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
                دع التخطيط: تخطيط_خرج_ربط;
                طابق (*السياق).التخطيط مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };
                طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(موضع_القسم) -> {
                    طابق موضع_القسم.العنوان_الافتراضي مع
                    | اختيار.بعض(العنوان) -> {
                        أرجع اختيار.بعض(العنوان + الإزاحة);
                    }
                    | اختيار.لا_شيء -> {
                        أرجع اختيار.بعض(الإزاحة);
                    };
                };
            };
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف عنوان_موضع_رقعة_إلف(
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط
): اختيار غير_موقع {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        طابق الموضع.العنوان_الافتراضي مع
        | اختيار.بعض(العنوان) -> {
            أرجع اختيار.بعض(العنوان + (*الحافة).الإزاحة);
        }
        | اختيار.لا_شيء -> {
            أرجع اختيار.بعض((*الحافة).الإزاحة);
        };
    };
}

عرف اكتب_إزاحة_إلف_في_الصورة(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    الحافة: &حافة_إزاحة_ربط,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_إلف_ربط,
    عنوان_بلت: غير_موقع,
    عنوان_جوت: غير_موقع
): نتيجة_صورة_إلف_تنفيذية {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };
    دع موضع_القسم: موضع_قسم_خرج_ربط;
    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { موضع_القسم := القيمة; };

    دع موضع_الكتابة: غير_موقع =
        موضع_القسم.إزاحة_الملف + (*الحافة).الإزاحة;
    دع هدف_الرقعة: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع معرف_ديناميكي: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
    طابق (*الحافة).المرجع مع
    | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, معرف_الرمز) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(القيمة) -> {
            طابق القيمة.الحالة مع
            | حالة_رمز_ربط.غير_معرف(_) -> {
                معرف_ديناميكي := اختيار.بعض(معرف_الرمز);
            }
            | حالة_رمز_ربط.ديناميكي(_) -> {
                معرف_ديناميكي := اختيار.بعض(معرف_الرمز);
            }
            | _ -> {
                هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
                    السياق,
                    &(*الحافة).المرجع
                );
            };
        };
    }
    | مرجع_إزاحة_ربط.قسم(_) -> {
        هدف_الرقعة := قيمة_قاعدة_مرجع_إلف(
            السياق,
            &(*الحافة).المرجع
        );
    };

    طابق معرف_ديناميكي مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(معرف_الرمز) -> {
        دع ترتيب_الرمز: غير_موقع;
        طابق ابحث_ترتيب_رمز_ديناميكي_إلف(
            الرموز_الديناميكية,
            معرف_الرمز
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول()
            );
        }
        | اختيار.بعض(الترتيب) -> { ترتيب_الرمز := الترتيب; };
        لو ((*الحافة).رمز_صيغة == 2 || (*الحافة).رمز_صيغة == 4) {
            هدف_الرقعة := اختيار.بعض(
                عنوان_بلت + (ترتيب_الرمز + 1) * 16
            );
        } وإلا لو (
            (*الحافة).رمز_صيغة == 9
                || (*الحافة).رمز_صيغة == 41
                || (*الحافة).رمز_صيغة == 42
        ) {
            هدف_الرقعة := اختيار.بعض(
                عنوان_جوت + (ترتيب_الرمز + 3) * 8
            );
        } وإلا {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
            );
        };
    };

    دع عنوان_الهدف: غير_موقع;
    طابق هدف_الرقعة مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول()
        );
    }
    | اختيار.بعض(القيمة) -> { عنوان_الهدف := القيمة; };

    لو ((*الحافة).رمز_صيغة == 1) {
        دع القيمة: غير_موقع;
        طابق اجمع_إضافة_إلف(عنوان_الهدف, (*الحافة).إضافة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختيار.بعض(الناتج) -> { القيمة := الناتج; };
        لو (!اكتب_غ64_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا لو (
        (*الحافة).رمز_صيغة == 2
            || (*الحافة).رمز_صيغة == 4
            || (*الحافة).رمز_صيغة == 9
            || (*الحافة).رمز_صيغة == 41
            || (*الحافة).رمز_صيغة == 42
    ) {
        دع عنوان_الرقعة: غير_موقع;
        طابق عنوان_موضع_رقعة_إلف(السياق, الحافة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(القيمة) -> { عنوان_الرقعة := القيمة; };
        دع القيمة: غير_موقع;
        طابق فرق_نسبي_ص32_إلف(
            عنوان_الرقعة,
            عنوان_الهدف,
            (*الحافة).إضافة
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختيار.بعض(الناتج) -> { القيمة := الناتج; };
        لو (!اكتب_غ32_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا لو (
        (*الحافة).رمز_صيغة == 10 || (*الحافة).رمز_صيغة == 11
    ) {
        دع القيمة: غير_موقع;
        طابق اجمع_إضافة_إلف(عنوان_الهدف, (*الحافة).إضافة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختيار.بعض(الناتج) -> { القيمة := الناتج; };
        لو ((*الحافة).رمز_صيغة == 10 && القيمة > 0xFFFFFFFF) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        لو ((*الحافة).رمز_صيغة == 11 && القيمة > 0x7FFFFFFF) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
        لو (!اكتب_غ32_إلف_ربط_في(الصورة, موضع_الكتابة, القيمة)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        };
    } وإلا {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة()
        );
    };

    دع بايتات_فارغة: متجه غ8 = [];
    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(بايتات_فارغة);
}

// The complete image builder is intentionally below the relocation machinery:
// layout is installed first, then every input relocation consumes that one
// canonical placement map.
عام عرف ابن_صورة_إلف_لينكس_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_إلف_تنفيذية {
    طابق تركيب_الهدف_الأصلي(&(*السياق).الهدف) مع
    | هوية_تركيب_هدف_أصلي.إكس_ستة_وثمانون_أربعة_وستون_لينكس_إلف -> { }
    | _ -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم()
        );
    };

    دع الرموز_الديناميكية: متغير متجه رمز_ديناميكي_إلف_ربط =
        ابن_قائمة_رموز_ديناميكية_إلف(السياق);
    دع ديناميكي: منطقي =
        (الطول(الرموز_الديناميكية) مثل غير_موقع) > 0
        || (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع) > 0;
    دع إعداد_الربط: إعداد_ربط_ديناميكي_هدف;
    لو (ديناميكي) {
        طابق إعداد_ربط_ديناميكي_للهدف(&(*السياق).الهدف) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول()
            );
        }
        | اختيار.بعض(الإعداد) -> { إعداد_الربط := الإعداد; };
    } وإلا {
        دع مفسر_فارغ: متجه غ8 = [];
        دع مكتبة_فارغة: متجه غ8 = [];
        دع إعداد_فارغ: إعداد_ربط_ديناميكي_هدف = {
            مفسر_إلف: مفسر_فارغ,
            مكتبة_نظام_افتراضية: مكتبة_فارغة
        };
        إعداد_الربط := إعداد_فارغ;
    };

    دع الاعتمادات: متغير متجه اعتماد_ديناميكي_إلف_ربط = [];
    لو (ديناميكي) {
        الاعتمادات := ابن_اعتمادات_إلف(السياق, &إعداد_الربط);
    };
    دع مسار_التشغيل: متجه غ8 = ابن_مسار_تشغيل_إلف(السياق);
    دع جدول_النصوص_الديناميكي: متغير متجه غ8 = [0];
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل غير_موقع)) {
        الاعتمادات[فهرس_الاعتماد].إزاحة_الاسم := أضف_اسم_إلى_جدول_إلف(
            &متغير جدول_النصوص_الديناميكي,
            &الاعتمادات[فهرس_الاعتماد].الاسم
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع إزاحة_مسار_التشغيل: متغير اختيار غير_موقع = اختيار.لا_شيء();
    لو ((الطول(مسار_التشغيل) مثل غير_موقع) > 0) {
        إزاحة_مسار_التشغيل := اختيار.بعض(
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_النصوص_الديناميكي,
                &مسار_التشغيل
            )
        );
    };
    دع فهرس_الديناميكي: متغير غير_موقع = 0;
    بينما (
        فهرس_الديناميكي < (الطول(الرموز_الديناميكية) مثل غير_موقع)
    ) {
        الرموز_الديناميكية[فهرس_الديناميكي].إزاحة_الاسم :=
            أضف_اسم_إلى_جدول_إلف(
                &متغير جدول_النصوص_الديناميكي,
                &الرموز_الديناميكية[فهرس_الديناميكي].الاسم
            );
        فهرس_الديناميكي := فهرس_الديناميكي + 1;
    }

    دع أساس_التحميل: غير_موقع = 0x400000;
    دع حجم_الصفحة: غير_موقع = 0x1000;
    دع عدد_رؤوس_البرنامج: متغير غير_موقع = 1;
    دع يوجد_قسم_كتابة: متغير منطقي = خطأ;
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        لو (
            (*السياق).الأقسام[فهرس_القسم].حي
            && قسم_إلف_محمل_تنفيذيا(&(*السياق).الأقسام[فهرس_القسم])
            && قسم_إلف_قابل_للكتابة_تنفيذيا(
                &(*السياق).الأقسام[فهرس_القسم]
            )
        ) {
            يوجد_قسم_كتابة := صواب;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    لو (ديناميكي) {
        يوجد_قسم_كتابة := صواب;
        عدد_رؤوس_البرنامج := 4;
    } وإلا لو (يوجد_قسم_كتابة) {
        عدد_رؤوس_البرنامج := 2;
    };

    دع موضع_المفسر: غير_موقع = 0x200;
    دع حجم_المفسر: متغير غير_موقع = 0;
    لو (ديناميكي) {
        حجم_المفسر := الطول(إعداد_الربط.مفسر_إلف) مثل غير_موقع;
    };
    دع التخطيط: متغير تخطيط_خرج_ربط = أنشئ_تخطيط_خرج_ربط();
    دع بداية_القراءة: غير_موقع = حجم_الصفحة;
    دع نهاية_وضع_القراءة: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            خطأ,
            خطأ,
            بداية_القراءة,
            أساس_التحميل + بداية_القراءة
        );
    دع نهاية_قراءة_ملف: متغير غير_موقع =
        نهاية_وضع_القراءة.موضع_الملف;
    دع نهاية_قراءة_ذاكرة: متغير غير_موقع =
        نهاية_وضع_القراءة.عنوان_الذاكرة;

    دع عدد_الرموز_الديناميكية: غير_موقع =
        الطول(الرموز_الديناميكية) مثل غير_موقع;
    دع موضع_بلت: متغير غير_موقع = نهاية_قراءة_ملف;
    دع عنوان_بلت: متغير غير_موقع = نهاية_قراءة_ذاكرة;
    دع حجم_بلت: متغير غير_موقع = 0;
    دع موضع_النصوص_الديناميكية: متغير غير_موقع = نهاية_قراءة_ملف;
    دع عنوان_النصوص_الديناميكية: متغير غير_موقع = نهاية_قراءة_ذاكرة;
    دع موضع_الرموز_الديناميكية: متغير غير_موقع = نهاية_قراءة_ملف;
    دع عنوان_الرموز_الديناميكية: متغير غير_موقع = نهاية_قراءة_ذاكرة;
    دع موضع_هاش: متغير غير_موقع = نهاية_قراءة_ملف;
    دع عنوان_هاش: متغير غير_موقع = نهاية_قراءة_ذاكرة;
    دع موضع_إزاحات_بلت: متغير غير_موقع = نهاية_قراءة_ملف;
    دع عنوان_إزاحات_بلت: متغير غير_موقع = نهاية_قراءة_ذاكرة;
    لو (ديناميكي) {
        موضع_بلت := حاذ_قيمة_إلف(نهاية_قراءة_ملف, 16);
        عنوان_بلت := أساس_التحميل + موضع_بلت;
        حجم_بلت := (عدد_الرموز_الديناميكية + 1) * 16;
        موضع_النصوص_الديناميكية := حاذ_قيمة_إلف(
            موضع_بلت + حجم_بلت,
            8
        );
        عنوان_النصوص_الديناميكية :=
            أساس_التحميل + موضع_النصوص_الديناميكية;
        موضع_الرموز_الديناميكية := حاذ_قيمة_إلف(
            موضع_النصوص_الديناميكية
                + (الطول(جدول_النصوص_الديناميكي) مثل غير_موقع),
            8
        );
        عنوان_الرموز_الديناميكية :=
            أساس_التحميل + موضع_الرموز_الديناميكية;
        موضع_هاش := حاذ_قيمة_إلف(
            موضع_الرموز_الديناميكية
                + (عدد_الرموز_الديناميكية + 1) * 24,
            8
        );
        عنوان_هاش := أساس_التحميل + موضع_هاش;
        دع حجم_هاش: غير_موقع = (عدد_الرموز_الديناميكية + 4) * 4;
        موضع_إزاحات_بلت := حاذ_قيمة_إلف(موضع_هاش + حجم_هاش, 8);
        عنوان_إزاحات_بلت := أساس_التحميل + موضع_إزاحات_بلت;
        نهاية_قراءة_ملف := موضع_إزاحات_بلت
            + عدد_الرموز_الديناميكية * 24;
        نهاية_قراءة_ذاكرة := أساس_التحميل + نهاية_قراءة_ملف;
    };

    دع نهاية_وضع_القراءة_الصفرية: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            خطأ,
            صواب,
            نهاية_قراءة_ملف,
            نهاية_قراءة_ذاكرة
        );
    دع نهاية_قراءة_صفرية_ملف: غير_موقع =
        نهاية_وضع_القراءة_الصفرية.موضع_الملف;
    دع نهاية_قراءة_صفرية_ذاكرة: غير_موقع =
        نهاية_وضع_القراءة_الصفرية.عنوان_الذاكرة;
    دع بداية_جزء_الكتابة: غير_موقع =
        حاذ_قيمة_إلف(نهاية_قراءة_صفرية_ملف, حجم_الصفحة);
    دع عنوان_جزء_الكتابة: غير_موقع =
        حاذ_قيمة_إلف(نهاية_قراءة_صفرية_ذاكرة, حجم_الصفحة);
    دع نهاية_وضع_الكتابة: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            صواب,
            خطأ,
            بداية_جزء_الكتابة,
            عنوان_جزء_الكتابة
        );
    دع نهاية_كتابة_ملف: متغير غير_موقع =
        نهاية_وضع_الكتابة.موضع_الملف;
    دع نهاية_كتابة_ذاكرة: متغير غير_موقع =
        نهاية_وضع_الكتابة.عنوان_الذاكرة;

    دع موضع_جوت: متغير غير_موقع = نهاية_كتابة_ملف;
    دع عنوان_جوت: متغير غير_موقع = نهاية_كتابة_ذاكرة;
    دع حجم_جوت: متغير غير_موقع = 0;
    دع موضع_الديناميكي: متغير غير_موقع = نهاية_كتابة_ملف;
    دع عنوان_الديناميكي: متغير غير_موقع = نهاية_كتابة_ذاكرة;
    دع حجم_الديناميكي: متغير غير_موقع = 0;
    لو (ديناميكي) {
        موضع_جوت := حاذ_قيمة_إلف(نهاية_كتابة_ملف, 8);
        عنوان_جوت := عنوان_جزء_الكتابة
            + (موضع_جوت - بداية_جزء_الكتابة);
        حجم_جوت := (عدد_الرموز_الديناميكية + 3) * 8;
        موضع_الديناميكي := حاذ_قيمة_إلف(موضع_جوت + حجم_جوت, 8);
        عنوان_الديناميكي := عنوان_جزء_الكتابة
            + (موضع_الديناميكي - بداية_جزء_الكتابة);
        دع عدد_مداخل_ديناميكية: متغير غير_موقع =
            (الطول(الاعتمادات) مثل غير_موقع) + 11;
        لو ((الطول(مسار_التشغيل) مثل غير_موقع) > 0) {
            عدد_مداخل_ديناميكية := عدد_مداخل_ديناميكية + 1;
        };
        حجم_الديناميكي := عدد_مداخل_ديناميكية * 16;
        نهاية_كتابة_ملف := موضع_الديناميكي + حجم_الديناميكي;
        نهاية_كتابة_ذاكرة := عنوان_الديناميكي + حجم_الديناميكي;
    };

    دع نهاية_وضع_الكتابة_الصفرية: نتيجة_وضع_أقسام_إلف =
        أضف_مواضع_أقسام_إلف_ملفوفة(
            السياق,
            &متغير التخطيط,
            صواب,
            صواب,
            نهاية_كتابة_ملف,
            نهاية_كتابة_ذاكرة
        );
    دع نهاية_كتابة_صفرية_ملف: غير_موقع =
        نهاية_وضع_الكتابة_الصفرية.موضع_الملف;
    دع نهاية_كتابة_صفرية_ذاكرة: غير_موقع =
        نهاية_وضع_الكتابة_الصفرية.عنوان_الذاكرة;
    دع بداية_غير_المحمل: غير_موقع = حاذ_قيمة_إلف(
        نهاية_كتابة_صفرية_ملف,
        8
    );
    دع نهاية_الأقسام_غير_المحملة: غير_موقع =
        ضع_أقسام_إلف_غير_المحملة_تنفيذيا(
            السياق,
            &متغير التخطيط,
            بداية_غير_المحمل
        );
    التخطيط.حجم_الملف := نهاية_الأقسام_غير_المحملة;
    دع اسم_الدخول: متجه غ8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
        );
    }
    | اختيار.بعض(الاسم) -> { اسم_الدخول := الاسم; };
    دع رمز_الدخول: رمز_ربط;
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
        );
    }
    | اختيار.بعض(الرمز) -> { رمز_الدخول := الرمز; };
    دع عنوان_الدخول: غير_موقع;
    طابق رمز_الدخول.الحالة مع
    | حالة_رمز_ربط.معرف(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
            دع موضع_القسم: موضع_قسم_خرج_ربط;
            طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, معرف_القسم) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
                );
            }
            | اختيار.بعض(القيمة) -> { موضع_القسم := القيمة; };
            طابق موضع_القسم.العنوان_الافتراضي مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
                );
            }
            | اختيار.بعض(العنوان) -> { عنوان_الدخول := العنوان + الإزاحة; };
        }
        | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> {
            عنوان_الدخول := العنوان;
        }
        | موضع_تعريف_رمز_ربط.غير_محدد -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
            );
        };
    }
    | _ -> {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود()
        );
    };

    دع الصورة: متغير متجه غ8 = [];
    ألحق_بايت_إلف(&متغير الصورة, 0x7F);
    ألحق_بايت_إلف(&متغير الصورة, 0x45);
    ألحق_بايت_إلف(&متغير الصورة, 0x4C);
    ألحق_بايت_إلف(&متغير الصورة, 0x46);
    ألحق_بايت_إلف(&متغير الصورة, 2);
    ألحق_بايت_إلف(&متغير الصورة, 1);
    ألحق_بايت_إلف(&متغير الصورة, 1);
    ألحق_بايت_إلف(&متغير الصورة, 0);
    ألحق_أصفارا_إلف_ربط(&متغير الصورة, 8);
    ألحق_غ16_إلف_ربط(&متغير الصورة, 2);
    ألحق_غ16_إلف_ربط(&متغير الصورة, 62);
    ألحق_غ32_إلف_ربط(&متغير الصورة, 1);
    ألحق_غ64_إلف_ربط(&متغير الصورة, عنوان_الدخول);
    ألحق_غ64_إلف_ربط(&متغير الصورة, 64);
    دع موضع_حقل_رؤوس_الأقسام: غير_موقع = الطول(الصورة) مثل غير_موقع;
    ألحق_غ64_إلف_ربط(&متغير الصورة, 0);
    ألحق_غ32_إلف_ربط(&متغير الصورة, 0);
    ألحق_غ16_إلف_ربط(&متغير الصورة, 64);
    ألحق_غ16_إلف_ربط(&متغير الصورة, 56);
    ألحق_غ16_إلف_ربط(&متغير الصورة, عدد_رؤوس_البرنامج);
    ألحق_غ16_إلف_ربط(&متغير الصورة, 64);
    دع موضع_حقل_عدد_الأقسام: غير_موقع = الطول(الصورة) مثل غير_موقع;
    ألحق_غ16_إلف_ربط(&متغير الصورة, 0);
    دع موضع_حقل_جدول_أسماء_الأقسام: غير_موقع =
        الطول(الصورة) مثل غير_موقع;
    ألحق_غ16_إلف_ربط(&متغير الصورة, 0);

    ألحق_رأس_برنامج_إلف64(
        &متغير الصورة,
        1,
        5,
        0,
        أساس_التحميل,
        نهاية_قراءة_ملف,
        نهاية_قراءة_صفرية_ذاكرة - أساس_التحميل,
        حجم_الصفحة
    );
    لو (يوجد_قسم_كتابة) {
        ألحق_رأس_برنامج_إلف64(
            &متغير الصورة,
            1,
            6,
            بداية_جزء_الكتابة,
            عنوان_جزء_الكتابة,
            نهاية_كتابة_ملف - بداية_جزء_الكتابة,
            نهاية_كتابة_صفرية_ذاكرة - عنوان_جزء_الكتابة,
            حجم_الصفحة
        );
    };
    لو (ديناميكي) {
        ألحق_رأس_برنامج_إلف64(
            &متغير الصورة,
            3,
            4,
            موضع_المفسر,
            أساس_التحميل + موضع_المفسر,
            حجم_المفسر,
            حجم_المفسر,
            1
        );
        ألحق_رأس_برنامج_إلف64(
            &متغير الصورة,
            2,
            6,
            موضع_الديناميكي,
            عنوان_الديناميكي,
            حجم_الديناميكي,
            حجم_الديناميكي,
            8
        );
    };
    لو (ديناميكي) {
        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_المفسر)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &إعداد_الربط.مفسر_إلف);
    };

    فهرس_القسم := 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو ((*القسم).حي && !قسم_إلف_صفري_تنفيذيا(القسم)) {
            طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*القسم).المعرف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختيار.بعض(الموضع) -> {
                لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, الموضع.إزاحة_الملف)) {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                    );
                };
                طابق (*القسم).المحتوى مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                        خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                    );
                }
                | اختيار.بعض(المحتوى) -> {
                    ألحق_بايتات_إلف_ربط(&متغير الصورة, &المحتوى);
                };
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع بلت: متغير متجه غ8 = [];
    دع رموز_ديناميكية_خام: متغير متجه غ8 = [];
    دع هاش: متغير متجه غ8 = [];
    دع إزاحات_بلت: متغير متجه غ8 = [];
    دع جوت: متغير متجه غ8 = [];
    دع جدول_ديناميكي: متغير متجه غ8 = [];
    لو (ديناميكي) {
        ألحق_بايت_إلف(&متغير بلت, 0xFF);
        ألحق_بايت_إلف(&متغير بلت, 0x35);
        دع فرق_دفع: غير_موقع;
        طابق فرق_نسبي_ص32_إلف(
            عنوان_بلت + 6,
            عنوان_جوت + 8,
            0
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختيار.بعض(القيمة) -> { فرق_دفع := القيمة; };
        ألحق_غ32_إلف_ربط(&متغير بلت, فرق_دفع);
        ألحق_بايت_إلف(&متغير بلت, 0xFF);
        ألحق_بايت_إلف(&متغير بلت, 0x25);
        دع فرق_قفز: غير_موقع;
        طابق فرق_نسبي_ص32_إلف(
            عنوان_بلت + 12,
            عنوان_جوت + 16,
            0
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
            );
        }
        | اختيار.بعض(القيمة) -> { فرق_قفز := القيمة; };
        ألحق_غ32_إلف_ربط(&متغير بلت, فرق_قفز);
        دع حشو_بلت: متجه غ8 = [0x0F,0x1F,0x40,0x00];
        ألحق_بايتات_إلف_ربط(&متغير بلت, &حشو_بلت);

        فهرس_الديناميكي := 0;
        بينما (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
            دع عنوان_مدخل_بلت: غير_موقع =
                عنوان_بلت + (فهرس_الديناميكي + 1) * 16;
            ألحق_بايت_إلف(&متغير بلت, 0xFF);
            ألحق_بايت_إلف(&متغير بلت, 0x25);
            دع عنوان_مدخل_جوت: غير_موقع =
                عنوان_جوت + (فهرس_الديناميكي + 3) * 8;
            دع فرق_جوت: غير_موقع;
            طابق فرق_نسبي_ص32_إلف(
                عنوان_مدخل_بلت + 6,
                عنوان_مدخل_جوت,
                0
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                );
            }
            | اختيار.بعض(القيمة) -> { فرق_جوت := القيمة; };
            ألحق_غ32_إلف_ربط(&متغير بلت, فرق_جوت);
            ألحق_بايت_إلف(&متغير بلت, 0x68);
            ألحق_غ32_إلف_ربط(&متغير بلت, فهرس_الديناميكي);
            ألحق_بايت_إلف(&متغير بلت, 0xE9);
            دع فرق_بلت_صفر: غير_موقع;
            طابق فرق_نسبي_ص32_إلف(
                عنوان_مدخل_بلت + 16,
                عنوان_بلت,
                0
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق()
                );
            }
            | اختيار.بعض(القيمة) -> { فرق_بلت_صفر := القيمة; };
            ألحق_غ32_إلف_ربط(&متغير بلت, فرق_بلت_صفر);
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        ألحق_أصفارا_إلف_ربط(&متغير رموز_ديناميكية_خام, 24);
        فهرس_الديناميكي := 0;
        بينما (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
            ألحق_رمز_ديناميكي_إلف64(
                &متغير رموز_ديناميكية_خام,
                الرموز_الديناميكية[فهرس_الديناميكي].إزاحة_الاسم
            );
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        ألحق_غ32_إلف_ربط(&متغير هاش, 1);
        ألحق_غ32_إلف_ربط(&متغير هاش, عدد_الرموز_الديناميكية + 1);
        ألحق_غ32_إلف_ربط(&متغير هاش, 1);
        ألحق_غ32_إلف_ربط(&متغير هاش, 0);
        فهرس_الديناميكي := 1;
        بينما (فهرس_الديناميكي <= عدد_الرموز_الديناميكية) {
            لو (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
                ألحق_غ32_إلف_ربط(
                    &متغير هاش,
                    فهرس_الديناميكي + 1
                );
            } وإلا {
                ألحق_غ32_إلف_ربط(&متغير هاش, 0);
            };
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        فهرس_الديناميكي := 0;
        بينما (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
            دع عنوان_مدخل_جوت: غير_موقع =
                عنوان_جوت + (فهرس_الديناميكي + 3) * 8;
            دع معلومات_الإزاحة: غير_موقع =
                (فهرس_الديناميكي + 1) * 4294967296 + 7;
            ألحق_غ64_إلف_ربط(&متغير إزاحات_بلت, عنوان_مدخل_جوت);
            ألحق_غ64_إلف_ربط(&متغير إزاحات_بلت, معلومات_الإزاحة);
            ألحق_غ64_إلف_ربط(&متغير إزاحات_بلت, 0);
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        ألحق_غ64_إلف_ربط(&متغير جوت, عنوان_الديناميكي);
        ألحق_غ64_إلف_ربط(&متغير جوت, 0);
        ألحق_غ64_إلف_ربط(&متغير جوت, 0);
        فهرس_الديناميكي := 0;
        بينما (فهرس_الديناميكي < عدد_الرموز_الديناميكية) {
            دع عنوان_عودة_بلت: غير_موقع =
                عنوان_بلت + (فهرس_الديناميكي + 1) * 16 + 6;
            ألحق_غ64_إلف_ربط(&متغير جوت, عنوان_عودة_بلت);
            فهرس_الديناميكي := فهرس_الديناميكي + 1;
        }

        فهرس_الاعتماد := 0;
        بينما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل غير_موقع)) {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي,
                1,
                الاعتمادات[فهرس_الاعتماد].إزاحة_الاسم
            );
            فهرس_الاعتماد := فهرس_الاعتماد + 1;
        }
        طابق إزاحة_مسار_التشغيل مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الإزاحة) -> {
            ألحق_مدخل_ديناميكي_إلف64(
                &متغير جدول_ديناميكي,
                29,
                الإزاحة
            );
        };
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            4,
            عنوان_هاش
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            5,
            عنوان_النصوص_الديناميكية
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            6,
            عنوان_الرموز_الديناميكية
        );
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            10,
            الطول(جدول_النصوص_الديناميكي) مثل غير_موقع
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 11, 24);
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 3, عنوان_جوت);
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            2,
            عدد_الرموز_الديناميكية * 24
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 20, 7);
        ألحق_مدخل_ديناميكي_إلف64(
            &متغير جدول_ديناميكي,
            23,
            عنوان_إزاحات_بلت
        );
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 9, 24);
        ألحق_مدخل_ديناميكي_إلف64(&متغير جدول_ديناميكي, 0, 0);

        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_بلت)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &بلت);
        لو (!أكمل_إلف_إلى_موضع(
            &متغير الصورة,
            موضع_النصوص_الديناميكية
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(
            &متغير الصورة,
            &جدول_النصوص_الديناميكي
        );
        لو (!أكمل_إلف_إلى_موضع(
            &متغير الصورة,
            موضع_الرموز_الديناميكية
        )) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &رموز_ديناميكية_خام);
        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_هاش)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &هاش);
        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_إزاحات_بلت)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &إزاحات_بلت);
        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_جوت)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &جوت);
        لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_الديناميكي)) {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_ديناميكي);
    };

    لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, نهاية_الأقسام_غير_المحملة)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };

    دع جدول_أسماء_الأقسام: متغير متجه غ8 = [0];
    دع مواضع_أسماء_الأقسام: متغير متجه اختيار غير_موقع = [];
    فهرس_القسم := 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        لو ((*السياق).الأقسام[فهرس_القسم].حي) {
            ألحق(
                مواضع_أسماء_الأقسام,
                اختيار.بعض(
                    أضف_اسم_إلى_جدول_إلف(
                        &متغير جدول_أسماء_الأقسام,
                        &(*السياق).الأقسام[فهرس_القسم].الاسم.اسم_القسم
                    )
                )
            );
        } وإلا {
            ألحق(مواضع_أسماء_الأقسام, اختيار.لا_شيء());
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع اسم_جدول_أسماء_الأقسام: متجه غ8 = [
        0x2E,0x73,0x68,0x73,0x74,0x72,0x74,0x61,0x62
    ];
    دع موضع_اسم_جدول_أسماء_الأقسام: غير_موقع =
        أضف_اسم_إلى_جدول_إلف(
            &متغير جدول_أسماء_الأقسام,
            &اسم_جدول_أسماء_الأقسام
        );
    دع موضع_جدول_أسماء_الأقسام: غير_موقع = الطول(الصورة) مثل غير_موقع;
    ألحق_بايتات_إلف_ربط(&متغير الصورة, &جدول_أسماء_الأقسام);
    دع موضع_رؤوس_الأقسام: غير_موقع = حاذ_قيمة_إلف(
        الطول(الصورة) مثل غير_موقع,
        8
    );
    لو (!أكمل_إلف_إلى_موضع(&متغير الصورة, موضع_رؤوس_الأقسام)) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_أصفارا_إلف_ربط(&متغير الصورة, 64);
    دع عدد_الأقسام_المرئية: متغير غير_موقع = 1;
    فهرس_القسم := 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        لو ((*السياق).الأقسام[فهرس_القسم].حي) {
            دع موضع_الاسم: غير_موقع;
            طابق مواضع_أسماء_الأقسام[فهرس_القسم] مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختيار.بعض(القيمة) -> { موضع_الاسم := القيمة; };
            دع موضع_القسم: موضع_قسم_خرج_ربط;
            طابق ابحث_موضع_قسم_خرج_ربط(
                &التخطيط,
                (*السياق).الأقسام[فهرس_القسم].المعرف
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختيار.بعض(القيمة) -> { موضع_القسم := القيمة; };
            دع النوع: غير_موقع;
            دع الأعلام: غير_موقع;
            طابق (*السياق).الأقسام[فهرس_القسم].حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.إلف(نوع_القسم, أعلام_القسم) -> {
                النوع := نوع_القسم;
                الأعلام := أعلام_القسم;
            }
            | _ -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                    خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
                );
            };
            دع عنوان_القسم: متغير غير_موقع = 0;
            طابق موضع_القسم.العنوان_الافتراضي مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(القيمة) -> { عنوان_القسم := القيمة; };
            دع المحاذاة: متغير غير_موقع =
                (*السياق).الأقسام[فهرس_القسم].المحاذاة;
            لو (المحاذاة == 0) { المحاذاة := 1; };
            ألحق_رأس_قسم_إلف64(
                &متغير الصورة,
                موضع_الاسم,
                النوع,
                الأعلام,
                عنوان_القسم,
                موضع_القسم.إزاحة_الملف,
                (*السياق).الأقسام[فهرس_القسم].الحجم,
                المحاذاة
            );
            عدد_الأقسام_المرئية := عدد_الأقسام_المرئية + 1;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع فهرس_جدول_أسماء_الأقسام: غير_موقع = عدد_الأقسام_المرئية;
    ألحق_رأس_قسم_إلف64(
        &متغير الصورة,
        موضع_اسم_جدول_أسماء_الأقسام,
        3,
        0,
        0,
        موضع_جدول_أسماء_الأقسام,
        الطول(جدول_أسماء_الأقسام) مثل غير_موقع,
        1
    );
    عدد_الأقسام_المرئية := عدد_الأقسام_المرئية + 1;

    لو (!اكتب_غ64_إلف_ربط_في(
        &متغير الصورة,
        موضع_حقل_رؤوس_الأقسام,
        موضع_رؤوس_الأقسام
    )) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (عدد_الأقسام_المرئية > 0xFFFF
        || فهرس_جدول_أسماء_الأقسام > 0xFFFF) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    // e_shnum / e_shstrndx are 16-bit fields.
    دع موضع_عدد_الأقسام_الأعلى: غير_موقع =
        موضع_حقل_عدد_الأقسام + 1;
    دع موضع_جدول_الأسماء_الأعلى: غير_موقع =
        موضع_حقل_جدول_أسماء_الأقسام + 1;
    الصورة[موضع_حقل_عدد_الأقسام] :=
        (عدد_الأقسام_المرئية & 0xFF) مثل غ8;
    الصورة[موضع_عدد_الأقسام_الأعلى] :=
        ((عدد_الأقسام_المرئية / 256) & 0xFF) مثل غ8;
    الصورة[موضع_حقل_جدول_أسماء_الأقسام] :=
        (فهرس_جدول_أسماء_الأقسام & 0xFF) مثل غ8;
    الصورة[موضع_جدول_الأسماء_الأعلى] :=
        ((فهرس_جدول_أسماء_الأقسام / 256) & 0xFF) مثل غ8;

    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        طابق اكتب_إزاحة_إلف_في_الصورة(
            &متغير الصورة,
            السياق,
            &(*السياق).الإزاحات[فهرس_الإزاحة],
            &الرموز_الديناميكية,
            عنوان_بلت,
            عنوان_جوت
        ) مع
        | نتيجة_صورة_إلف_تنفيذية.نجح(_) -> { }
        | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ);
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }

    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(الصورة);
}
