            فهرس_النصوص_الديناميكية, 0, 8, 16
        );
        عدد_الأقسام_المرئية := فهرس_الديناميكي + 1;
    };
    دع فهرس_جدول_أسماء_الأقسام: غير_موقع = عدد_الأقسام_المرئية;
    ألحق_رأس_قسم_إلف64(
        &متغير الصورة,
        موضع_اسم_جدول_أسماء_الأقسام,
        3,
        0,
        0,
        موضع_جدول_أسماء_الأقسام,
        الطول(جدول_أسماء_الأقسام) مثل غير_موقع,
        1
    );
    عدد_الأقسام_المرئية := عدد_الأقسام_المرئية + 1;

    لو (!اكتب_غ64_إلف_ربط_في(
        &متغير الصورة,
        موضع_حقل_رؤوس_الأقسام,
        موضع_رؤوس_الأقسام
    )) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (عدد_الأقسام_المرئية > 0xFFFF
        || فهرس_جدول_أسماء_الأقسام > 0xFFFF) {
        أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
            خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
        );
    };
    // e_shnum / e_shstrndx are 16-bit fields.
    دع موضع_عدد_الأقسام_الأعلى: غير_موقع =
        موضع_حقل_عدد_الأقسام + 1;
    دع موضع_جدول_الأسماء_الأعلى: غير_موقع =
        موضع_حقل_جدول_أسماء_الأقسام + 1;
    الصورة[موضع_حقل_عدد_الأقسام] :=
        (عدد_الأقسام_المرئية & 0xFF) مثل غ8;
    الصورة[موضع_عدد_الأقسام_الأعلى] :=
        ((عدد_الأقسام_المرئية / 256) & 0xFF) مثل غ8;
    الصورة[موضع_حقل_جدول_أسماء_الأقسام] :=
        (فهرس_جدول_أسماء_الأقسام & 0xFF) مثل غ8;
    الصورة[موضع_جدول_الأسماء_الأعلى] :=
        ((فهرس_جدول_أسماء_الأقسام / 256) & 0xFF) مثل غ8;

    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط =
            &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع القسم_المصدر: قسم_ربط;
        طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(
                خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(القسم) -> { القسم_المصدر := القسم; };
        لو (القسم_المصدر.حي) {
            طابق اكتب_إزاحة_إلف_في_الصورة(
                &متغير الصورة,
                السياق,
                الحافة,
                &الرموز_الديناميكية,
                عنوان_بلت,
                عنوان_جوت
            ) مع
            | نتيجة_صورة_إلف_تنفيذية.نجح(_) -> { }
            | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
                أرجع نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ);
            };
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }

    أرجع نتيجة_صورة_إلف_تنفيذية.نجح(الصورة);
}


عام عرف ابن_صورة_إلف_نظامية_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_إلف_تنفيذية {
    أرجع ابن_صورة_إلف_نظامية(
        السياق,
        نوع_خرج_ربط.تنفيذي()
    );
}

عام عرف ابن_صورة_إلف_نظامية_مشتركة(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_إلف_تنفيذية {
    أرجع ابن_صورة_إلف_نظامية(
        السياق,
        نوع_خرج_ربط.مكتبة_مشتركة()
    );
}
