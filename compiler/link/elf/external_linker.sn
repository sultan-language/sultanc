استورد compiler.link.archive.ar_container;
استورد compiler.link.archive_model;
استورد compiler.link.context;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;
استورد compiler.link.model;
استورد compiler.link.symbol_model;
استورد compiler.backend.target.target_model;
استورد std.env.environment;
استورد std.fs.mutation;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.process.child;
استورد std.text.builder;
استورد std.text.from_bytes;
استورد std.text.number;

عام نوع خطأ_رابط_إلف_مفوض =
    | خطة_غير_مدعومة
    | بيانات_أداة_مفقودة
    | أرشيف_رفيع_بلا_مسار
    | مساحة_عمل_مؤقتة_فشلت بنوع عدد
    | كتابة_مدخل_مؤقت_فشلت بنوع عدد
    | تشغيل_الرابط_فشل بنوع عدد
    | قراءة_المخرج_فشلت بنوع عدد
    | مخرج_غير_صالح
;

عام نوع نتيجة_رابط_إلف_مفوض =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_رابط_إلف_مفوض
;

عرف ادمج_نصي_إلف_مفوض(الأول: &نص, الثاني: &نص): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    ألحق_نصا_بباني_النص(&متغير الباني, الأول);
    ألحق_نصا_بباني_النص(&متغير الباني, الثاني);
    أرجع نص_باني_النص(&الباني);
}

عرف انسخ_نص_رابط_إلف_مفوض(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف اسم_ملف_إلف_مؤقت(
    البادئة: &نص,
    الفهرس: غير_موقع,
    الامتداد: &نص
): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    ألحق_نصا_بباني_النص(&متغير الباني, البادئة);
    دع الرقم: نص = غير_موقع_إلى_نص(الفهرس);
    ألحق_نصا_بباني_النص(&متغير الباني, &الرقم);
    ألحق_نصا_بباني_النص(&متغير الباني, الامتداد);
    أرجع نص_باني_النص(&الباني);
}

عرف أنشئ_مساحة_عمل_إلف_مفوضة(): نتيجة نص, عدد {
    دع جذر_المؤقت: نص;
    طابق الدليل_المؤقت() مع
    | نتيجة.خطأ(الحالة) -> { أرجع نتيجة.خطأ(الحالة); }
    | نتيجة.نجح(المسار) -> { جذر_المؤقت := المسار; };

    دع المحاولة: متغير غير_موقع = 0;
    بينما (المحاولة < 128) {
        دع البادئة: نص = «sultanc-elf-link-»;
        دع الامتداد: نص = «»;
        دع الاسم: نص = اسم_ملف_إلف_مؤقت(
            &البادئة,
            المحاولة,
            &الامتداد
        );
        دع المسار: نص = صل_المسار(&جذر_المؤقت, &الاسم);
        طابق أنشئ_دليلا(&المسار) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المسار); }
        | نتيجة.خطأ(_) -> { };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(-1);
}

عرف نظف_مساحة_عمل_إلف_مفوضة(
    الدليل: &نص,
    الملفات: &متجه نص
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الملفات) مثل غير_موقع)) {
        دع مسار_الملف: &نص = &(*الملفات)[الفهرس];
        دع إزالة_الملف: نتيجة عدد, عدد = أزل_ملفا(مسار_الملف);
        الفهرس := الفهرس + 1;
    }
    دع إزالة_الدليل: نتيجة عدد, عدد = أزل_دليلا(الدليل);
}

عرف امتداد_مدخل_إلف_مفوض(المدخل: &مدخل_ربط): نص {
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.أرشيف -> { أرجع «.a»; }
    | صنف_مدخل_ربط.مكتبة_ديناميكية -> { أرجع «.so»; }
    | صنف_مدخل_ربط.كائن -> { أرجع «.o»; };
}

عرف جهز_مسار_مدخل_إلف_مفوض(
    المدخل: &مدخل_ربط,
    فهرس_المدخل: غير_موقع,
    مساحة_العمل: &نص,
    الملفات_المؤقتة: &متغير متجه نص
): نتيجة نص, خطأ_رابط_إلف_مفوض {
    طابق (*المدخل).المسار مع
    | اختيار.بعض(المسار) -> { أرجع نتيجة.نجح(المسار); }
    | اختيار.لا_شيء -> { };

    لو (
        (*المدخل).الصنف == صنف_مدخل_ربط.أرشيف()
            && تحقق_توقيع_حاوية_أرشيف_رفيع(&(*المدخل).البايتات)
    ) {
        أرجع نتيجة.خطأ(
            خطأ_رابط_إلف_مفوض.أرشيف_رفيع_بلا_مسار()
        );
    };

    دع البادئة: نص = «input-»;
    دع الامتداد: نص = امتداد_مدخل_إلف_مفوض(المدخل);
    دع الاسم: نص = اسم_ملف_إلف_مؤقت(
        &البادئة,
        فهرس_المدخل,
        &الامتداد
    );
    دع المسار: نص = صل_المسار(مساحة_العمل, &الاسم);
    طابق اكتب_البايتات(&المسار, &(*المدخل).البايتات) مع
    | نتيجة.خطأ(الحالة) -> {
        أرجع نتيجة.خطأ(
            خطأ_رابط_إلف_مفوض.كتابة_مدخل_مؤقت_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(_) -> { };
    دع مسار_التنظيف: نص = انسخ_نص_رابط_إلف_مفوض(&المسار);
    ألحق(*الملفات_المؤقتة, مسار_التنظيف);
    أرجع نتيجة.نجح(المسار);
}

عرف ألحق_اعتماد_ديناميكي_إلف_مفوض(
    الاعتماد: &اعتماد_مكتبة_ديناميكية_ربط,
    الوسائط: &متغير متجه نص
): فراغ {
    طابق (*الاعتماد).المدخل مع
    | اختيار.بعض(_) -> { أرجع; }
    | اختيار.لا_شيء -> { };

    طابق (*الاعتماد).دليل_البحث مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(بايتات_الدليل) -> {
        دع الدليل: نص = من_بايتات(&بايتات_الدليل);
        دع بادئة_البحث: نص = «-L»;
        دع وسيط_البحث: نص = ادمج_نصي_إلف_مفوض(
            &بادئة_البحث,
            &الدليل
        );
        ألحق(*الوسائط, وسيط_البحث);
    };

    دع الاسم: نص = من_بايتات(&(*الاعتماد).الاسم);
    دع بادئة_المكتبة: نص = «-l:»;
    دع وسيط_المكتبة: نص = ادمج_نصي_إلف_مفوض(
        &بادئة_المكتبة,
        &الاسم
    );
    ألحق(*الوسائط, وسيط_المكتبة);
}

عرف فيه_رمز_إلف_مفوض_غير_معرف(السياق: &سياق_ربط): منطقي {
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (
        فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)
    ) {
        طابق (*السياق).الرموز.الرموز[فهرس_الرمز].الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { أرجع صواب; }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع خطأ;
}

عرف يحتاج_تنفيذي_إلف_مفوض_ربطا_ديناميكيا(
    السياق: &سياق_ربط
): منطقي {
    لو ((*السياق).الخطة.الخرج != نوع_خرج_ربط.تنفيذي()) {
        أرجع خطأ;
    };
    لو (
        (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع) > 0
    ) {
        أرجع صواب;
    };
    أرجع فيه_رمز_إلف_مفوض_غير_معرف(السياق);
}

عرف نص_أداة_إلف_من_بايتات_منتهية_اختياريا(
    البايتات: &متجه غ8
): نص {
    دع النهاية: متغير غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (النهاية > 0) {
        دع موضع_آخر_بايت: غير_موقع = النهاية - 1;
        لو ((*البايتات)[موضع_آخر_بايت] == 0) {
            النهاية := موضع_آخر_بايت;
        };
    };
    دع النظيفة: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < النهاية) {
        ألحق(النظيفة, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع من_بايتات(&النظيفة);
}

عرف ألحق_بيانات_أداة_إلف_مفوضة(
    السياق: &سياق_ربط,
    الوسائط: &متغير متجه نص
): منطقي {
    دع يحتاج_ديناميكيا: منطقي =
        يحتاج_تنفيذي_إلف_مفوض_ربطا_ديناميكيا(السياق);
    طابق (*السياق).الخطة.بيانات_الأداة.إلف مع
    | اختيار.لا_شيء -> { أرجع !يحتاج_ديناميكيا; }
    | اختيار.بعض(البيانات) -> {
        دع فهرس_الدليل: متغير غير_موقع = 0;
        بينما (
            فهرس_الدليل
                < (الطول(البيانات.مسارات_بحث_المكتبات) مثل غير_موقع)
        ) {
            دع بادئة_البحث: نص = «-L»;
            دع الدليل: نص = من_بايتات(
                &البيانات.مسارات_بحث_المكتبات[فهرس_الدليل]
            );
            دع الوسيط: نص = ادمج_نصي_إلف_مفوض(
                &بادئة_البحث,
                &الدليل
            );
            ألحق(*الوسائط, الوسيط);
            فهرس_الدليل := فهرس_الدليل + 1;
        }

        لو (!يحتاج_ديناميكيا) { أرجع صواب; };
        طابق البيانات.المحمل_الديناميكي مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(بايتات_المحمل) -> {
            دع الخيار: نص = «--dynamic-linker»;
            دع المحمل: نص = نص_أداة_إلف_من_بايتات_منتهية_اختياريا(
                &بايتات_المحمل
            );
            ألحق(*الوسائط, الخيار);
            ألحق(*الوسائط, المحمل);
        };

        أرجع صواب;
    };
}

عرف ألحق_مكتبة_نظام_إلف_مفوضة_عند_الحاجة(
    السياق: &سياق_ربط,
    الوسائط: &متغير متجه نص
): منطقي {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.كائن_مترابط -> { أرجع صواب; }
    | نوع_خرج_ربط.وحدة_هدف -> { أرجع صواب; }
    | _ -> { };
    لو (!فيه_رمز_إلف_مفوض_غير_معرف(السياق)) { أرجع صواب; };
    طابق (*السياق).الخطة.بيانات_الأداة.إلف مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(البيانات) -> {
        طابق البيانات.مكتبة_النظام_الافتراضية مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(بايتات_المكتبة) -> {
            دع الاسم: نص = من_بايتات(&بايتات_المكتبة);
            دع البادئة: نص = «-l:»;
            دع الوسيط: نص = ادمج_نصي_إلف_مفوض(&البادئة, &الاسم);
            ألحق(*الوسائط, الوسيط);
            أرجع صواب;
        };
    };
}

عرف ألحق_سياسة_خطة_إلف_مفوضة(
    الخطة: &خطة_ربط,
    الوسائط: &متغير متجه نص
): فراغ {
    طابق (*الخطة).الخرج مع
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        دع خيار_مشترك: نص = «-shared»;
        ألحق(*الوسائط, خيار_مشترك);
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        دع خيار_مترابط: نص = «-r»;
        ألحق(*الوسائط, خيار_مترابط);
        أرجع;
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        دع خيار_مترابط: نص = «-r»;
        ألحق(*الوسائط, خيار_مترابط);
        أرجع;
    }
    | _ -> { };

    طابق (*الخطة).رمز_الدخول مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(بايتات_الدخول) -> {
        دع خيار_الدخول: نص = «-e»;
        دع رمز_الدخول: نص = من_بايتات(&بايتات_الدخول);
        ألحق(*الوسائط, خيار_الدخول);
        ألحق(*الوسائط, رمز_الدخول);
    };

    طابق (*الخطة).اسم_المخرج_الديناميكي مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(بايتات_الاسم) -> {
        دع خيار_الاسم: نص = «-soname»;
        دع الاسم: نص = من_بايتات(&بايتات_الاسم);
        ألحق(*الوسائط, خيار_الاسم);
        ألحق(*الوسائط, الاسم);
    };

    دع فهرس_المسار: متغير غير_موقع = 0;
    بينما (
        فهرس_المسار
            < (الطول((*الخطة).مسارات_التشغيل) مثل غير_موقع)
    ) {
        دع خيار_المسار: نص = «-rpath»;
        دع المسار: نص = من_بايتات(
            &(*الخطة).مسارات_التشغيل[فهرس_المسار]
        );
        ألحق(*الوسائط, خيار_المسار);
        ألحق(*الوسائط, المسار);
        فهرس_المسار := فهرس_المسار + 1;
    }
}

عرف مخرج_إلف_مفوض_صالح(
    البايتات: &متجه غ8,
    السياق: &سياق_ربط
): منطقي {
    دع الواصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الواصف := القيمة; };

    دع السياسة: سياسة_هدف_إلف;
    طابق سياسة_إلف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { السياسة := القيمة; };
    لو (الواصف.الآلة != السياسة.الآلة) { أرجع خطأ; };
    لو (الواصف.الصنف != السياسة.الصنف) { أرجع خطأ; };
    لو (الواصف.الترتيب != السياسة.الترتيب) { أرجع خطأ; };

    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        أرجع الواصف.نوع_الملف == 2 || الواصف.نوع_الملف == 3;
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        أرجع الواصف.نوع_الملف == 3;
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        أرجع الواصف.نوع_الملف == 1;
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع الواصف.نوع_الملف == 1;
    };
}

عام عرف اربط_إلف_بأداة_مفوضة(
    السياق: &سياق_ربط
): نتيجة_رابط_إلف_مفوض {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { }
    | نوع_خرج_ربط.كائن_مترابط -> { }
    | نوع_خرج_ربط.وحدة_هدف -> { };

    دع البرنامج: نص;
    طابق (*السياق).الخطة.بيانات_الأداة.إلف مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.بيانات_أداة_مفقودة()
        );
    }
    | اختيار.بعض(البيانات) -> { البرنامج := انسخ_نص_رابط_إلف_مفوض(&البيانات.برنامج_الرابط); };

    دع مساحة_العمل: نص;
    طابق أنشئ_مساحة_عمل_إلف_مفوضة() مع
    | نتيجة.خطأ(الحالة) -> {
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.مساحة_عمل_مؤقتة_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(المسار) -> { مساحة_العمل := المسار; };

    دع الملفات_المؤقتة: متغير متجه نص = [];
    دع الوسائط: متغير متجه نص = [];
    دع اسم_المخرج: نص = «output.elf»;
    دع مسار_المخرج: نص = صل_المسار(&مساحة_العمل, &اسم_المخرج);
    دع مسار_المخرج_للتنظيف: نص = انسخ_نص_رابط_إلف_مفوض(&مسار_المخرج);
    ألحق(الملفات_المؤقتة, مسار_المخرج_للتنظيف);

    ألحق_سياسة_خطة_إلف_مفوضة(
        &(*السياق).الخطة,
        &متغير الوسائط
    );
    لو (!ألحق_بيانات_أداة_إلف_مفوضة(السياق, &متغير الوسائط)) {
        نظف_مساحة_عمل_إلف_مفوضة(
            &مساحة_العمل,
            &الملفات_المؤقتة
        );
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.بيانات_أداة_مفقودة()
        );
    };

    دع فهرس_المدخل: متغير غير_موقع = 0;
    بينما (
        فهرس_المدخل
            < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)
    ) {
        دع المدخل: &مدخل_ربط =
            &(*السياق).الخطة.المدخلات[فهرس_المدخل];
        لو (!مدخل_ربط_مستخرج_من_أرشيف(
            &(*السياق).الأرشيفات,
            (*المدخل).المعرف
        )) {
            طابق جهز_مسار_مدخل_إلف_مفوض(
                المدخل,
                فهرس_المدخل,
                &مساحة_العمل,
                &متغير الملفات_المؤقتة
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                نظف_مساحة_عمل_إلف_مفوضة(
                    &مساحة_العمل,
                    &الملفات_المؤقتة
                );
                أرجع نتيجة_رابط_إلف_مفوض.خطأ(الخطأ);
            }
            | نتيجة.نجح(المسار) -> { ألحق(الوسائط, المسار); };
        };
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية)
                مثل غير_موقع)
    ) {
        ألحق_اعتماد_ديناميكي_إلف_مفوض(
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد],
            &متغير الوسائط
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }

    لو (!ألحق_مكتبة_نظام_إلف_مفوضة_عند_الحاجة(
        السياق,
        &متغير الوسائط
    )) {
        نظف_مساحة_عمل_إلف_مفوضة(
            &مساحة_العمل,
            &الملفات_المؤقتة
        );
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.بيانات_أداة_مفقودة()
        );
    };

    دع خيار_المخرج: نص = «-o»;
    ألحق(الوسائط, خيار_المخرج);
    دع مسار_المخرج_للأداة: نص = انسخ_نص_رابط_إلف_مفوض(&مسار_المخرج);
    ألحق(الوسائط, مسار_المخرج_للأداة);
    دع حالة_الأداة: حالة_إنهاء;
    طابق شغل_وانتظر(&البرنامج, &الوسائط) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_إلف_مفوضة(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.تشغيل_الرابط_فشل(الحالة)
        );
    }
    | نتيجة.نجح(الحالة) -> { حالة_الأداة := الحالة; };

    طابق حالة_الأداة مع
    | حالة_إنهاء.خرج(الحالة) -> {
        لو (الحالة != 0) {
            نظف_مساحة_عمل_إلف_مفوضة(
                &مساحة_العمل,
                &الملفات_المؤقتة
            );
            أرجع نتيجة_رابط_إلف_مفوض.خطأ(
                خطأ_رابط_إلف_مفوض.تشغيل_الرابط_فشل(الحالة)
            );
        };
    }
    | حالة_إنهاء.إشارة(الإشارة) -> {
        نظف_مساحة_عمل_إلف_مفوضة(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.تشغيل_الرابط_فشل(256 + الإشارة)
        );
    };

    دع الناتج: متجه غ8;
    طابق اقرأ_بايتات_ملف(&مسار_المخرج) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_إلف_مفوضة(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.قراءة_المخرج_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(البايتات) -> { الناتج := البايتات; };

    نظف_مساحة_عمل_إلف_مفوضة(&مساحة_العمل, &الملفات_المؤقتة);
    لو (!مخرج_إلف_مفوض_صالح(&الناتج, السياق)) {
        أرجع نتيجة_رابط_إلف_مفوض.خطأ(
            خطأ_رابط_إلف_مفوض.مخرج_غير_صالح()
        );
    };
    أرجع نتيجة_رابط_إلف_مفوض.نجح(الناتج);
}
