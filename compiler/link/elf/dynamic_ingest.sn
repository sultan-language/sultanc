استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.link.elf.reader;
استورد std.fs.path;

عام نوع خطأ_استيعاب_مكتبة_إلف =
    | مكتبة_غير_صالحة
    | حل_رمز_يتطلب_سياسة
;

عام نوع نتيجة_استيعاب_مكتبة_إلف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مكتبة_إلف
;

عرف بايتات_نص_اعتماد_إلف(النص: &نص): متجه ط8 {
    دع البايتات: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*النص) مثل طبيعي)) {
        ألحق(البايتات, (*النص)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع البايتات;
}

عرف اقرأ_قيمة_رمز_إلف_ديناميكي(
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل,
    الموضع: طبيعي,
    حقل_اثنان_وثلاثون: طبيعي,
    حقل_أربعة_وستون: طبيعي
): طبيعي {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_ط32_إلف_مدخل(
            البايتات,
            الموضع + حقل_اثنان_وثلاثون,
            (*الوصف).الترتيب
        );
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_ط64_إلف_مدخل(
            البايتات,
            الموضع + حقل_أربعة_وستون,
            (*الوصف).الترتيب
        );
    };
}

عرف اقرأ_اسم_اعتماد_إلف_من_المسار(
    المدخل: &مدخل_ربط
): متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
    | اختياري.موجود(المسار) -> {
        طابق اسم_الملف(&المسار) مع
        | اختياري.لا_شيء -> { أرجع بايتات_نص_اعتماد_إلف(&المسار); }
        | اختياري.موجود(الاسم) -> { أرجع بايتات_نص_اعتماد_إلف(&الاسم); };
    };
}

عرف اقرأ_دليل_اعتماد_إلف_من_المسار(
    المدخل: &مدخل_ربط
): اختياري متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار) -> {
        طابق أب_المسار(&المسار) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الدليل) -> {
            أرجع اختياري.موجود(بايتات_نص_اعتماد_إلف(&الدليل));
        };
    };
}

عرف اقرأ_اسم_سونام_إلف(
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل
): اختياري متجه ط8 {
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (*الوصف).عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(الوصف, فهرس_القسم);
        إذا (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, الرأس) == 6) {
            دع رابط_النصوص: طبيعي = حقل_رابط_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            إذا (رابط_النصوص >= (*الوصف).عدد_الأقسام) {
                أرجع اختياري.لا_شيء();
            };
            دع رأس_النصوص: طبيعي = موضع_رأس_قسم_إلف_مدخل(
                الوصف,
                رابط_النصوص
            );
            إذا (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, رأس_النصوص) != 3) {
                أرجع اختياري.لا_شيء();
            };
            دع موضع_النصوص: طبيعي = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع حجم_النصوص: طبيعي = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع موضع_الديناميكي: طبيعي = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_الديناميكي: طبيعي = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_المدخل: متغير طبيعي = 8;
            طابق (*الوصف).الصنف مع
            | صنف_إلف_مدخل.اثنان_وثلاثون -> { حجم_المدخل := 8; }
            | صنف_إلف_مدخل.أربعة_وستون -> { حجم_المدخل := 16; };
            إذا ((حجم_الديناميكي % حجم_المدخل) != 0
                || !ضمن_حدود_إلف_مدخل(
                    البايتات,
                    موضع_الديناميكي,
                    حجم_الديناميكي
                )
                || !ضمن_حدود_إلف_مدخل(
                    البايتات,
                    موضع_النصوص,
                    حجم_النصوص
                )) {
                أرجع اختياري.لا_شيء();
            };
            دع فهرس_المدخل: متغير طبيعي = 0;
            طالما (فهرس_المدخل < حجم_الديناميكي / حجم_المدخل) {
                دع الموضع: طبيعي = موضع_الديناميكي + فهرس_المدخل * حجم_المدخل;
                دع الوسم: طبيعي = اقرأ_قيمة_رمز_إلف_ديناميكي(
                    البايتات,
                    الوصف,
                    الموضع,
                    0,
                    0
                );
                دع القيمة: طبيعي = اقرأ_قيمة_رمز_إلف_ديناميكي(
                    البايتات,
                    الوصف,
                    الموضع,
                    4,
                    8
                );
                إذا (الوسم == 14 && القيمة < حجم_النصوص) {
                    أرجع اقرأ_اسم_صفري_إلف_مدخل(
                        البايتات,
                        موضع_النصوص + القيمة,
                        موضع_النصوص + حجم_النصوص
                    );
                };
                إذا (الوسم == 0) { أرجع اختياري.لا_شيء(); };
                فهرس_المدخل := فهرس_المدخل + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف سجل_رموز_مكتبة_إلف_الديناميكية(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل,
    المطلوب_فقط: منطقي
): نتيجة_استيعاب_مكتبة_إلف {
    دع حجم_الرمز: طبيعي = حجم_رمز_إلف_مدخل((*الوصف).الصنف);
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (*الوصف).عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(الوصف, فهرس_القسم);
        إذا (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, الرأس) == 11) {
            دع الرابط: طبيعي = حقل_رابط_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            إذا (الرابط >= (*الوصف).عدد_الأقسام) {
                أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                    خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                );
            };
            دع رأس_النصوص: طبيعي = موضع_رأس_قسم_إلف_مدخل(
                الوصف,
                الرابط
            );
            دع موضع_النصوص: طبيعي = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع حجم_النصوص: طبيعي = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع موضع_الرموز: طبيعي = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_الرموز: طبيعي = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            إذا ((حجم_الرموز % حجم_الرمز) != 0
                || !ضمن_حدود_إلف_مدخل(البايتات, موضع_الرموز, حجم_الرموز)
                || !ضمن_حدود_إلف_مدخل(البايتات, موضع_النصوص, حجم_النصوص)) {
                أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                    خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                );
            };
            دع فهرس_الرمز: متغير طبيعي = 0;
            طالما (فهرس_الرمز < حجم_الرموز / حجم_الرمز) {
                دع الموضع: طبيعي = موضع_الرموز + فهرس_الرمز * حجم_الرمز;
                دع إزاحة_الاسم: طبيعي = اقرأ_ط32_إلف_مدخل(
                    البايتات,
                    الموضع,
                    (*الوصف).الترتيب
                );
                دع المعلومات: طبيعي;
                دع الآخر: طبيعي;
                دع فهرس_تعريف_القسم: طبيعي;
                طابق (*الوصف).الصنف مع
                | صنف_إلف_مدخل.اثنان_وثلاثون -> {
                    دع موضع_المعلومات: طبيعي = الموضع + 12;
                    دع موضع_الآخر: طبيعي = الموضع + 13;
                    المعلومات := (*البايتات)[موضع_المعلومات] مثل طبيعي;
                    الآخر := (*البايتات)[موضع_الآخر] مثل طبيعي;
                    فهرس_تعريف_القسم := اقرأ_ط16_إلف_مدخل(
                        البايتات,
                        الموضع + 14,
                        (*الوصف).الترتيب
                    );
                }
                | صنف_إلف_مدخل.أربعة_وستون -> {
                    دع موضع_المعلومات: طبيعي = الموضع + 4;
                    دع موضع_الآخر: طبيعي = الموضع + 5;
                    المعلومات := (*البايتات)[موضع_المعلومات] مثل طبيعي;
                    الآخر := (*البايتات)[موضع_الآخر] مثل طبيعي;
                    فهرس_تعريف_القسم := اقرأ_ط16_إلف_مدخل(
                        البايتات,
                        الموضع + 6,
                        (*الوصف).الترتيب
                    );
                };
                دع الربط: طبيعي = المعلومات / 16;
                دع الظهور: طبيعي = الآخر & 3;
                إذا (فهرس_تعريف_القسم != 0
                    && إزاحة_الاسم != 0
                    && إزاحة_الاسم < حجم_النصوص
                    && (الربط == 1 || الربط == 2)
                    && الظهور != 1
                    && الظهور != 2) {
                    دع الاسم: متجه ط8;
                    طابق اقرأ_اسم_صفري_إلف_مدخل(
                        البايتات,
                        موضع_النصوص + إزاحة_الاسم,
                        موضع_النصوص + حجم_النصوص
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                        );
                    }
                    | اختياري.موجود(اسم_الرمز) -> { الاسم := اسم_الرمز; };
                    // Automatic host libLLVM is appended only after all
                    // regular objects and archives have been ingested. No
                    // further ordinary definitions can be introduced after
                    // this scan. Its unreferenced exports need no persistent
                    // symbol-table entries; explicit DSOs still register all
                    // exports with the original resolution policy.
                    دع يسجل: متغير منطقي = صواب;
                    إذا (المطلوب_فقط) {
                        يسجل := خطأ;
                        طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(الموجود) -> {
                            طابق الموجود.الحالة مع
                            | حالة_رمز_ربط.غير_معرف(_) -> { يسجل := صواب; }
                            | _ -> { };
                        };
                    };
                    إذا (يسجل) {
                        طابق سجل_رمز_مكتبة_ديناميكية_للربط(
                            &متغير (*السياق).الرموز,
                            &الاسم,
                            (*المدخل).المعرف
                        ) مع
                        | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
                            أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                                خطأ_استيعاب_مكتبة_إلف.حل_رمز_يتطلب_سياسة()
                            );
                        }
                        | _ -> { };
                    };
                };
                فهرس_الرمز := فهرس_الرمز + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع نتيجة_استيعاب_مكتبة_إلف.نجح();
}

عرف استوعب_مكتبة_إلف_في_سياق_الربط_بسياسة(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    المطلوب_فقط: منطقي
): نتيجة_استيعاب_مكتبة_إلف {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
        );
    }
    | اختياري.موجود(المقروء) -> { الوصف := المقروء; };
    إذا (الوصف.نوع_الملف != 3) {
        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
        );
    };

    دع اسم_الاعتماد: متجه ط8;
    طابق اقرأ_اسم_سونام_إلف(البايتات, &الوصف) مع
    | اختياري.موجود(سونام) -> { اسم_الاعتماد := سونام; }
    | اختياري.لا_شيء -> { اسم_الاعتماد := اقرأ_اسم_اعتماد_إلف_من_المسار(المدخل); };
    إذا ((الطول(اسم_الاعتماد) مثل طبيعي) > 0) {
        دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط;
        طابق اقرأ_دليل_اعتماد_إلف_من_المسار(المدخل) مع
        | اختياري.لا_شيء -> {
            الاعتماد := اعتماد_مكتبة_ديناميكية_باسم(اسم_الاعتماد);
        }
        | اختياري.موجود(الدليل) -> {
            الاعتماد := اعتماد_مكتبة_ديناميكية_بمسار(
                اسم_الاعتماد,
                الدليل
            );
        };
        اربط_اعتماد_ديناميكي_بمدخل(
            &متغير الاعتماد,
            (*المدخل).المعرف
        );
        أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
            &متغير (*السياق).الخطة,
            الاعتماد
        );
    };

    أرجع سجل_رموز_مكتبة_إلف_الديناميكية(
        السياق,
        المدخل,
        البايتات,
        &الوصف,
        المطلوب_فقط
    );
}

// The ordinary shared-library path retains all exports. Only the implicit
// host LLVM dependency uses the late, already-unresolved-symbol scan.
عام عرف استوعب_مكتبة_إلف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_إلف {
    أرجع استوعب_مكتبة_إلف_في_سياق_الربط_بسياسة(السياق, المدخل, خطأ);
}

عام عرف استوعب_مكتبة_إلف_في_سياق_الربط_للمطلوب(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_إلف {
    أرجع استوعب_مكتبة_إلف_في_سياق_الربط_بسياسة(السياق, المدخل, صواب);
}
