استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.elf.reader;
استورد std.fs.path;

عام نوع خطأ_استيعاب_مكتبة_إلف =
    | مكتبة_غير_صالحة
    | حل_رمز_يتطلب_سياسة
;

عام نوع نتيجة_استيعاب_مكتبة_إلف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مكتبة_إلف
;

عرف بايتات_نص_اعتماد_إلف(النص: &نص): متجه غ8 {
    دع البايتات: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*النص) مثل غير_موقع)) {
        ألحق(البايتات, (*النص)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع البايتات;
}

عرف اقرأ_قيمة_رمز_إلف_ديناميكي(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الموضع: غير_موقع,
    حقل_اثنان_وثلاثون: غير_موقع,
    حقل_أربعة_وستون: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(
            البايتات,
            الموضع + حقل_اثنان_وثلاثون,
            (*الوصف).الترتيب
        );
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(
            البايتات,
            الموضع + حقل_أربعة_وستون,
            (*الوصف).الترتيب
        );
    };
}

عرف اقرأ_اسم_اعتماد_إلف_من_المسار(
    المدخل: &مدخل_ربط
): متجه غ8 {
    طابق (*المدخل).المسار مع
    | اختيار.لا_شيء -> { دع فارغ: متجه غ8 = []; أرجع فارغ; }
    | اختيار.بعض(المسار) -> {
        طابق اسم_الملف(&المسار) مع
        | اختيار.لا_شيء -> { أرجع بايتات_نص_اعتماد_إلف(&المسار); }
        | اختيار.بعض(الاسم) -> { أرجع بايتات_نص_اعتماد_إلف(&الاسم); };
    };
}

عرف اقرأ_دليل_اعتماد_إلف_من_المسار(
    المدخل: &مدخل_ربط
): اختيار متجه غ8 {
    طابق (*المدخل).المسار مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المسار) -> {
        طابق أب_المسار(&المسار) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الدليل) -> {
            أرجع اختيار.بعض(بايتات_نص_اعتماد_إلف(&الدليل));
        };
    };
}

عرف اقرأ_اسم_سونام_إلف(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل
): اختيار متجه غ8 {
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (*الوصف).عدد_الأقسام) {
        دع الرأس: غير_موقع = موضع_رأس_قسم_إلف_مدخل(الوصف, فهرس_القسم);
        لو (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, الرأس) == 6) {
            دع رابط_النصوص: غير_موقع = حقل_رابط_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            لو (رابط_النصوص >= (*الوصف).عدد_الأقسام) {
                أرجع اختيار.لا_شيء();
            };
            دع رأس_النصوص: غير_موقع = موضع_رأس_قسم_إلف_مدخل(
                الوصف,
                رابط_النصوص
            );
            لو (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, رأس_النصوص) != 3) {
                أرجع اختيار.لا_شيء();
            };
            دع موضع_النصوص: غير_موقع = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع حجم_النصوص: غير_موقع = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع موضع_الديناميكي: غير_موقع = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_الديناميكي: غير_موقع = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_المدخل: متغير غير_موقع = 8;
            طابق (*الوصف).الصنف مع
            | صنف_إلف_مدخل.اثنان_وثلاثون -> { حجم_المدخل := 8; }
            | صنف_إلف_مدخل.أربعة_وستون -> { حجم_المدخل := 16; };
            لو ((حجم_الديناميكي % حجم_المدخل) != 0
                || !ضمن_حدود_إلف_مدخل(
                    البايتات,
                    موضع_الديناميكي,
                    حجم_الديناميكي
                )
                || !ضمن_حدود_إلف_مدخل(
                    البايتات,
                    موضع_النصوص,
                    حجم_النصوص
                )) {
                أرجع اختيار.لا_شيء();
            };
            دع فهرس_المدخل: متغير غير_موقع = 0;
            بينما (فهرس_المدخل < حجم_الديناميكي / حجم_المدخل) {
                دع الموضع: غير_موقع = موضع_الديناميكي + فهرس_المدخل * حجم_المدخل;
                دع الوسم: غير_موقع = اقرأ_قيمة_رمز_إلف_ديناميكي(
                    البايتات,
                    الوصف,
                    الموضع,
                    0,
                    0
                );
                دع القيمة: غير_موقع = اقرأ_قيمة_رمز_إلف_ديناميكي(
                    البايتات,
                    الوصف,
                    الموضع,
                    4,
                    8
                );
                لو (الوسم == 14 && القيمة < حجم_النصوص) {
                    أرجع اقرأ_اسم_صفري_إلف_مدخل(
                        البايتات,
                        موضع_النصوص + القيمة,
                        موضع_النصوص + حجم_النصوص
                    );
                };
                لو (الوسم == 0) { أرجع اختيار.لا_شيء(); };
                فهرس_المدخل := فهرس_المدخل + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف سجل_رموز_مكتبة_إلف_الديناميكية(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل
): نتيجة_استيعاب_مكتبة_إلف {
    دع حجم_الرمز: غير_موقع = حجم_رمز_إلف_مدخل((*الوصف).الصنف);
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (*الوصف).عدد_الأقسام) {
        دع الرأس: غير_موقع = موضع_رأس_قسم_إلف_مدخل(الوصف, فهرس_القسم);
        لو (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, الرأس) == 11) {
            دع الرابط: غير_موقع = حقل_رابط_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            لو (الرابط >= (*الوصف).عدد_الأقسام) {
                أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                    خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                );
            };
            دع رأس_النصوص: غير_موقع = موضع_رأس_قسم_إلف_مدخل(
                الوصف,
                الرابط
            );
            دع موضع_النصوص: غير_موقع = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع حجم_النصوص: غير_موقع = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                رأس_النصوص
            );
            دع موضع_الرموز: غير_موقع = حقل_موضع_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            دع حجم_الرموز: غير_موقع = حقل_حجم_قسم_إلف_مدخل(
                البايتات,
                الوصف,
                الرأس
            );
            لو ((حجم_الرموز % حجم_الرمز) != 0
                || !ضمن_حدود_إلف_مدخل(البايتات, موضع_الرموز, حجم_الرموز)
                || !ضمن_حدود_إلف_مدخل(البايتات, موضع_النصوص, حجم_النصوص)) {
                أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                    خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                );
            };
            دع فهرس_الرمز: متغير غير_موقع = 0;
            بينما (فهرس_الرمز < حجم_الرموز / حجم_الرمز) {
                دع الموضع: غير_موقع = موضع_الرموز + فهرس_الرمز * حجم_الرمز;
                دع إزاحة_الاسم: غير_موقع = اقرأ_غ32_إلف_مدخل(
                    البايتات,
                    الموضع,
                    (*الوصف).الترتيب
                );
                دع المعلومات: غير_موقع;
                دع الآخر: غير_موقع;
                دع فهرس_تعريف_القسم: غير_موقع;
                طابق (*الوصف).الصنف مع
                | صنف_إلف_مدخل.اثنان_وثلاثون -> {
                    دع موضع_المعلومات: غير_موقع = الموضع + 12;
                    دع موضع_الآخر: غير_موقع = الموضع + 13;
                    المعلومات := (*البايتات)[موضع_المعلومات] مثل غير_موقع;
                    الآخر := (*البايتات)[موضع_الآخر] مثل غير_موقع;
                    فهرس_تعريف_القسم := اقرأ_غ16_إلف_مدخل(
                        البايتات,
                        الموضع + 14,
                        (*الوصف).الترتيب
                    );
                }
                | صنف_إلف_مدخل.أربعة_وستون -> {
                    دع موضع_المعلومات: غير_موقع = الموضع + 4;
                    دع موضع_الآخر: غير_موقع = الموضع + 5;
                    المعلومات := (*البايتات)[موضع_المعلومات] مثل غير_موقع;
                    الآخر := (*البايتات)[موضع_الآخر] مثل غير_موقع;
                    فهرس_تعريف_القسم := اقرأ_غ16_إلف_مدخل(
                        البايتات,
                        الموضع + 6,
                        (*الوصف).الترتيب
                    );
                };
                دع الربط: غير_موقع = المعلومات / 16;
                دع الظهور: غير_موقع = الآخر & 3;
                لو (فهرس_تعريف_القسم != 0
                    && إزاحة_الاسم != 0
                    && إزاحة_الاسم < حجم_النصوص
                    && (الربط == 1 || الربط == 2)
                    && الظهور != 1
                    && الظهور != 2) {
                    دع الاسم: متجه غ8;
                    طابق اقرأ_اسم_صفري_إلف_مدخل(
                        البايتات,
                        موضع_النصوص + إزاحة_الاسم,
                        موضع_النصوص + حجم_النصوص
                    ) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
                        );
                    }
                    | اختيار.بعض(اسم_الرمز) -> { الاسم := اسم_الرمز; };
                    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
                        &متغير (*السياق).الرموز,
                        &الاسم,
                        (*المدخل).المعرف
                    ) مع
                    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
                        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
                            خطأ_استيعاب_مكتبة_إلف.حل_رمز_يتطلب_سياسة()
                        );
                    }
                    | _ -> { };
                };
                فهرس_الرمز := فهرس_الرمز + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع نتيجة_استيعاب_مكتبة_إلف.نجح();
}

عام عرف استوعب_مكتبة_إلف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_إلف {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
        );
    }
    | اختيار.بعض(المقروء) -> { الوصف := المقروء; };
    لو (الوصف.نوع_الملف != 3) {
        أرجع نتيجة_استيعاب_مكتبة_إلف.خطأ(
            خطأ_استيعاب_مكتبة_إلف.مكتبة_غير_صالحة()
        );
    };

    دع اسم_الاعتماد: متجه غ8;
    طابق اقرأ_اسم_سونام_إلف(البايتات, &الوصف) مع
    | اختيار.بعض(سونام) -> { اسم_الاعتماد := سونام; }
    | اختيار.لا_شيء -> { اسم_الاعتماد := اقرأ_اسم_اعتماد_إلف_من_المسار(المدخل); };
    لو ((الطول(اسم_الاعتماد) مثل غير_موقع) > 0) {
        دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط;
        طابق اقرأ_دليل_اعتماد_إلف_من_المسار(المدخل) مع
        | اختيار.لا_شيء -> {
            الاعتماد := اعتماد_مكتبة_ديناميكية_باسم(اسم_الاعتماد);
        }
        | اختيار.بعض(الدليل) -> {
            الاعتماد := اعتماد_مكتبة_ديناميكية_بمسار(
                اسم_الاعتماد,
                الدليل
            );
        };
        اربط_اعتماد_ديناميكي_بمدخل(
            &متغير الاعتماد,
            (*المدخل).المعرف
        );
        أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
            &متغير (*السياق).الخطة,
            الاعتماد
        );
    };

    أرجع سجل_رموز_مكتبة_إلف_الديناميكية(
        السياق,
        المدخل,
        البايتات,
        &الوصف
    );
}
