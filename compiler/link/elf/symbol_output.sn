استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.elf.reader;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;
استورد std.collections.map;
استورد std.hash.fnv;

// .symtab and .strtab of a linked ELF executable, as LLD writes them by
// default: the input objects' function, object and untyped symbols (local
// and global, Arm mapping symbols included; no section or file symbols)
// at their final addresses, with their sizes and binding, and st_shndx the
// output section that holds them. Debuggers and unwinders find functions
// by these symbols (lldb picks a frame's CFI by its symbol), profilers and
// objdump name code by them.
//   * A local symbol of a section the link kept is written once per input.
//   * A global is written once, for the definition the link chose (a
//     linker-script assignment's value, or the input that defines it).
//   * Symbols of sections the link discarded are left out.
// The image's loaded bytes do not change: the two sections, a copy of the
// section name table naming them and a new section header table are
// appended after everything else, and the ELF header points at them.

نوع رمز_خرج_إلف = {
    الاسم: متجه ط8,
    القيمة: طبيعي,
    الحجم: طبيعي,
    المعلومات: طبيعي,
    الآخر: طبيعي,
    القسم: طبيعي
};

نوع اختيار_عام_خرج = {
    مختار: منطقي,
    مطلق: اختياري طبيعي
};

نوع قسم_صورة_للرموز = {
    العنوان: طبيعي,
    الحجم: طبيعي,
    محمل: منطقي
};

عرف قيمة_أو_صفر_خرج(القيمة: اختياري طبيعي): طبيعي {
    طابق القيمة مع
    | اختياري.موجود(ق) -> { أرجع ق; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف هاش_مفتاح_قسم_خرج(المفتاح: &طبيعي): طبيعي { أرجع *المفتاح; }
عرف مفتاحان_متساويان_خرج(أ: &طبيعي, ب: &طبيعي): منطقي { أرجع *أ == *ب; }

عرف هاش_اسم_رمز_خرج(الاسم: &متجه ط8): طبيعي { أرجع هاش_فنڤ1أ_طبيعي_للبايتات(الاسم); }

عرف اسمان_متساويان_رمز_خرج(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اكتب_قيمة_رمز_خرج(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي,
    العرض: طبيعي,
    كبير: منطقي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع الإزاحة: طبيعي = (العرض - 1 - ف) * 8;
        إذا (كبير) {
            ألحق(*الناتج, ((القيمة >> الإزاحة) & 0xFF) مثل ط8);
        } وإلا {
            ألحق(*الناتج, ((القيمة >> (ف * 8)) & 0xFF) مثل ط8);
        };
        ف := ف + 1;
    }
}

عرف ضع_قيمة_رمز_خرج(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي,
    العرض: طبيعي,
    كبير: منطقي
): فراغ {
    دع البايتات: متغير متجه ط8 = [];
    اكتب_قيمة_رمز_خرج(&متغير البايتات, القيمة, العرض, كبير);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) { (*الصورة)[الموضع + ف] := البايتات[ف]; ف := ف + 1; }
}

// The output section holding an address (st_shndx), or SHN_ABS.
عرف قسم_عنوان_رمز_خرج(الأقسام: &متجه قسم_صورة_للرموز, العنوان: طبيعي): طبيعي {
    دع ف: متغير طبيعي = 1;
    دع عند_النهاية: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_صورة_للرموز = &(*الأقسام)[ف];
        إذا ((*القسم).محمل && العنوان >= (*القسم).العنوان) {
            إذا (العنوان < (*القسم).العنوان + (*القسم).الحجم) { أرجع ف; };
            إذا (العنوان == (*القسم).العنوان + (*القسم).الحجم && عند_النهاية == 0) { عند_النهاية := ف; };
        };
        ف := ف + 1;
    }
    إذا (عند_النهاية != 0) { أرجع عند_النهاية; };
    أرجع 0xFFF1;
}

// The final address of a symbol an input defines in its section فهرس_الصيغة,
// when the link kept that section.
عرف عنوان_رمز_مدخل_خرج(
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    أقسام_المدخلات: &الخريطة<طبيعي, طبيعي>,
    المدخل: طبيعي,
    فهرس_الصيغة: طبيعي,
    القيمة: طبيعي
): اختياري طبيعي {
    دع المفتاح: طبيعي = المدخل * 4294967296 + فهرس_الصيغة;
    طابق ابحث_في_الخريطة(أقسام_المدخلات, &المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الفهرس) -> {
        دع المعرف: معرف_قسم_ربط = (*السياق).الأقسام[الفهرس].المعرف;
        إذا (!(*السياق).الأقسام[المعرف.القيمة].حي) { أرجع اختياري.لا_شيء(); };
        طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموضع) -> {
            طابق الموضع.العنوان_الافتراضي مع
            | اختياري.موجود(العنوان) -> { أرجع اختياري.موجود(العنوان + القيمة); }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        };
    };
}

// Whether the link chose this input's definition of a global (or a script
// gave it an absolute value, returned as the second fact).
عرف تعريف_عام_مختار_خرج(
    السياق: &سياق_ربط,
    الاسم: &متجه ط8,
    المدخل: طبيعي
): اختيار_عام_خرج {
    دع لا_مطلق: اختياري طبيعي = اختياري.لا_شيء();
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختياري.لا_شيء -> { دع ن: اختيار_عام_خرج = { مختار: صواب, مطلق: لا_مطلق }; أرجع ن; }
    | اختياري.موجود(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                دع ن: اختيار_عام_خرج = { مختار: صواب, مطلق: اختياري.موجود(القيمة) };
                أرجع ن;
            }
            | _ -> {
                دع ن: اختيار_عام_خرج = { مختار: (التعريف.المدخل.القيمة مثل طبيعي) == المدخل, مطلق: لا_مطلق };
                أرجع ن;
            };
        }
        | _ -> { دع ن: اختيار_عام_خرج = { مختار: خطأ, مطلق: لا_مطلق }; أرجع ن; };
    };
}

// Appends .symtab and .strtab to a linked image; leaves it unchanged when
// it cannot read the image or an input.
عام عرف أضف_جدول_رموز_إلف_إلى_الصورة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط
): فراغ {
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_صورة_إلف_مدخل(الصورة) مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { الوصف := القيمة; };
    إذا (الوصف.عدد_الأقسام == 0 || الوصف.فهرس_جدول_أسماء_الأقسام == 0) { أرجع; };
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع عريض: منطقي = الوصف.الصنف == صنف_إلف_مدخل.أربعة_وستون();
    دع كبير: منطقي = الوصف.الترتيب == ترتيب_إلف_مدخل.كبير();
    دع الكلمة: متغير طبيعي = 4;
    إذا (عريض) { الكلمة := 8; };

    // The image's sections.
    دع أقسام_الصورة: متغير متجه قسم_صورة_للرموز = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الوصف.عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(&الوصف, ف);
        دع القسم: قسم_صورة_للرموز = {
            العنوان: قيمة_أو_صفر_خرج(اقرأ_قيمة_إلف_مدخل(الصورة, الرأس + 8 + الكلمة, الكلمة, الوصف.الترتيب)),
            الحجم: حقل_حجم_قسم_إلف_مدخل(الصورة, &الوصف, الرأس),
            محمل: (حقل_أعلام_قسم_إلف_مدخل(الصورة, &الوصف, الرأس) & 2) != 0
        };
        ألحق(أقسام_الصورة, القسم);
        ف := ف + 1;
    }

    // Context sections by (input, format index).
    دع عدد_المدخلات: طبيعي = الطول((*السياق).الخطة.المدخلات) مثل طبيعي;
    دع أقسام_المدخلات: متغير الخريطة<طبيعي, طبيعي> = أنشئ_الخريطة(هاش_مفتاح_قسم_خرج, مفتاحان_متساويان_خرج);
    ف := 0;
    طالما (ف < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[ف];
        دع المفتاح: طبيعي = ((*القسم).المدخل.القيمة مثل طبيعي) * 4294967296 + (*القسم).فهرس_قسم_الصيغة;
        أدرج_في_الخريطة(&متغير أقسام_المدخلات, المفتاح, ف);
        ف := ف + 1;
    }

    دع المحليات: متغير متجه رمز_خرج_إلف = [];
    دع العامة: متغير متجه رمز_خرج_إلف = [];
    دع المكتوبة: متغير الخريطة<متجه ط8, طبيعي> = أنشئ_الخريطة(هاش_اسم_رمز_خرج, اسمان_متساويان_رمز_خرج);
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*السياق).رموز_المدخلات) مثل طبيعي)) {
        أضف_رمز_محفوظ_خرج(السياق, &التخطيط, &(*السياق).رموز_المدخلات[م], &أقسام_المدخلات,
            &أقسام_الصورة, &متغير المحليات, &متغير العامة, &متغير المكتوبة);
        م := م + 1;
    }

    // .strtab, .symtab.
    دع جدول_الأسماء: متغير متجه ط8 = [0];
    دع الجدول: متغير متجه ط8 = [];
    دع حجم_المدخل: طبيعي = 16 + (الكلمة - 4) * 2;
    ف := 0;
    طالما (ف < حجم_المدخل) { ألحق(الجدول, 0); ف := ف + 1; }
    دع الكل: متغير متجه رمز_خرج_إلف = المحليات;
    دع أول_عام: طبيعي = (الطول(الكل) مثل طبيعي) + 1;
    ف := 0;
    طالما (ف < (الطول(العامة) مثل طبيعي)) {
        ألحق(الكل, انسخ_رمز_خرج(&العامة[ف]));
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(الكل) مثل طبيعي)) {
        دع الرمز: &رمز_خرج_إلف = &الكل[ف];
        دع الاسم: طبيعي = الطول(جدول_الأسماء) مثل طبيعي;
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول((*الرمز).الاسم) مثل طبيعي)) { ألحق(جدول_الأسماء, (*الرمز).الاسم[ي]); ي := ي + 1; }
        ألحق(جدول_الأسماء, 0);
        اكتب_قيمة_رمز_خرج(&متغير الجدول, الاسم, 4, كبير);
        إذا (عريض) {
            ألحق(الجدول, (*الرمز).المعلومات مثل ط8);
            ألحق(الجدول, (*الرمز).الآخر مثل ط8);
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).القسم, 2, كبير);
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).القيمة, 8, كبير);
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).الحجم, 8, كبير);
        } وإلا {
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).القيمة, 4, كبير);
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).الحجم, 4, كبير);
            ألحق(الجدول, (*الرمز).المعلومات مثل ط8);
            ألحق(الجدول, (*الرمز).الآخر مثل ط8);
            اكتب_قيمة_رمز_خرج(&متغير الجدول, (*الرمز).القسم, 2, كبير);
        };
        ف := ف + 1;
    }

    // The section name table, copied with the two new names.
    دع رأس_الأسماء: طبيعي = موضع_رأس_قسم_إلف_مدخل(&الوصف, الوصف.فهرس_جدول_أسماء_الأقسام);
    دع موضع_الأسماء_القديم: طبيعي = حقل_موضع_قسم_إلف_مدخل(الصورة, &الوصف, رأس_الأسماء);
    دع حجم_الأسماء_القديم: طبيعي = حقل_حجم_قسم_إلف_مدخل(الصورة, &الوصف, رأس_الأسماء);
    إذا (!ضمن_حدود_إلف_مدخل(الصورة, موضع_الأسماء_القديم, حجم_الأسماء_القديم)) { أرجع; };
    دع أسماء_الأقسام: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < حجم_الأسماء_القديم) { ألحق(أسماء_الأقسام, (*الصورة)[موضع_الأسماء_القديم + ف]); ف := ف + 1; }
    دع اسم_الرموز: طبيعي = الطول(أسماء_الأقسام) مثل طبيعي;
    دع نص_الرموز: متجه ط8 = بايتات_من_نص(«.symtab»);
    ف := 0;
    طالما (ف < (الطول(نص_الرموز) مثل طبيعي)) { ألحق(أسماء_الأقسام, نص_الرموز[ف]); ف := ف + 1; }
    ألحق(أسماء_الأقسام, 0);
    دع اسم_النصوص: طبيعي = الطول(أسماء_الأقسام) مثل طبيعي;
    دع نص_النصوص: متجه ط8 = بايتات_من_نص(«.strtab»);
    ف := 0;
    طالما (ف < (الطول(نص_النصوص) مثل طبيعي)) { ألحق(أسماء_الأقسام, نص_النصوص[ف]); ف := ف + 1; }
    ألحق(أسماء_الأقسام, 0);

    // Append: .symtab, .strtab, .shstrtab copy, section headers.
    طالما ((الطول(*الصورة) مثل طبيعي) % الكلمة != 0) { ألحق(*الصورة, 0); }
    دع موضع_الجدول: طبيعي = الطول(*الصورة) مثل طبيعي;
    ف := 0;
    طالما (ف < (الطول(الجدول) مثل طبيعي)) { ألحق(*الصورة, الجدول[ف]); ف := ف + 1; }
    دع موضع_النصوص: طبيعي = الطول(*الصورة) مثل طبيعي;
    ف := 0;
    طالما (ف < (الطول(جدول_الأسماء) مثل طبيعي)) { ألحق(*الصورة, جدول_الأسماء[ف]); ف := ف + 1; }
    دع موضع_الأسماء: طبيعي = الطول(*الصورة) مثل طبيعي;
    ف := 0;
    طالما (ف < (الطول(أسماء_الأقسام) مثل طبيعي)) { ألحق(*الصورة, أسماء_الأقسام[ف]); ف := ف + 1; }
    طالما ((الطول(*الصورة) مثل طبيعي) % الكلمة != 0) { ألحق(*الصورة, 0); }
    دع موضع_الرؤوس: طبيعي = الطول(*الصورة) مثل طبيعي;
    // The old headers, with the name table's moved.
    دع حجم_الرأس: طبيعي = الوصف.حجم_رأس_القسم;
    ف := 0;
    طالما (ف < الوصف.عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(&الوصف, ف);
        دع النسخة: متغير متجه ط8 = [];
        دع ي: متغير طبيعي = 0;
        طالما (ي < حجم_الرأس) { ألحق(النسخة, (*الصورة)[الرأس + ي]); ي := ي + 1; }
        ي := 0;
        طالما (ي < حجم_الرأس) { ألحق(*الصورة, النسخة[ي]); ي := ي + 1; }
        ف := ف + 1;
    }
    دع رأس_الأسماء_الجديد: طبيعي = موضع_الرؤوس + الوصف.فهرس_جدول_أسماء_الأقسام * حجم_الرأس;
    إذا (عريض) {
        ضع_قيمة_رمز_خرج(الصورة, رأس_الأسماء_الجديد + 24, موضع_الأسماء, 8, كبير);
        ضع_قيمة_رمز_خرج(الصورة, رأس_الأسماء_الجديد + 32, الطول(أسماء_الأقسام) مثل طبيعي, 8, كبير);
    } وإلا {
        ضع_قيمة_رمز_خرج(الصورة, رأس_الأسماء_الجديد + 16, موضع_الأسماء, 4, كبير);
        ضع_قيمة_رمز_خرج(الصورة, رأس_الأسماء_الجديد + 20, الطول(أسماء_الأقسام) مثل طبيعي, 4, كبير);
    };
    دع فهرس_النصوص: طبيعي = الوصف.عدد_الأقسام + 1;
    أضف_رأس_قسم_رموز_خرج(الصورة, عريض, كبير, اسم_الرموز, 2, موضع_الجدول, الطول(الجدول) مثل طبيعي,
        فهرس_النصوص, أول_عام, الكلمة, حجم_المدخل);
    أضف_رأس_قسم_رموز_خرج(الصورة, عريض, كبير, اسم_النصوص, 3, موضع_النصوص, الطول(جدول_الأسماء) مثل طبيعي,
        0, 0, 1, 0);
    // The ELF header: e_shoff, e_shnum.
    إذا (عريض) {
        ضع_قيمة_رمز_خرج(الصورة, 40, موضع_الرؤوس, 8, كبير);
        ضع_قيمة_رمز_خرج(الصورة, 60, الوصف.عدد_الأقسام + 2, 2, كبير);
    } وإلا {
        ضع_قيمة_رمز_خرج(الصورة, 32, موضع_الرؤوس, 4, كبير);
        ضع_قيمة_رمز_خرج(الصورة, 48, الوصف.عدد_الأقسام + 2, 2, كبير);
    };
}

عرف أضف_رأس_قسم_رموز_خرج(
    الصورة: &متغير متجه ط8, عريض: منطقي, كبير: منطقي,
    الاسم: طبيعي, النوع: طبيعي, الموضع: طبيعي, الحجم: طبيعي,
    الربط: طبيعي, المعلومات: طبيعي, المحاذاة: طبيعي, حجم_المدخل: طبيعي
): فراغ {
    دع الكلمة: متغير طبيعي = 4;
    إذا (عريض) { الكلمة := 8; };
    اكتب_قيمة_رمز_خرج(الصورة, الاسم, 4, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, النوع, 4, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, 0, الكلمة, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, 0, الكلمة, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, الموضع, الكلمة, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, الحجم, الكلمة, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, الربط, 4, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, المعلومات, 4, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, المحاذاة, الكلمة, كبير);
    اكتب_قيمة_رمز_خرج(الصورة, حجم_المدخل, الكلمة, كبير);
}

عرف انسخ_رمز_خرج(الرمز: &رمز_خرج_إلف): رمز_خرج_إلف {
    دع النسخة: رمز_خرج_إلف = {
        الاسم: انسخ_بايتات(&(*الرمز).الاسم),
        القيمة: (*الرمز).القيمة,
        الحجم: (*الرمز).الحجم,
        المعلومات: (*الرمز).المعلومات,
        الآخر: (*الرمز).الآخر,
        القسم: (*الرمز).القسم
    };
    أرجع النسخة;
}

// Keeps the input objects' function, object and untyped symbols in the
// context, before the image writer releases the objects' bytes.
عام عرف احفظ_رموز_مدخلات_إلف(السياق: &متغير سياق_ربط): فراغ {
    دع المحفوظة: متغير متجه رمز_مدخل_محفوظ_ربط = [];
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
        دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[م];
        دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
        إذا (!(*المدخل).سكربت_جنو && (الطول(*البايتات) مثل طبيعي) > 4 && (*البايتات)[0] == 0x7F
            && (*البايتات)[1] == 0x45 && (*البايتات)[2] == 0x4C && (*البايتات)[3] == 0x46) {
            طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الوصف) -> {
                إذا (الوصف.نوع_الملف == 1) { اقرأ_رموز_كائن_خرج(البايتات, &الوصف, م, &متغير المحفوظة); };
            };
        };
        م := م + 1;
    }
    (*السياق).رموز_المدخلات := المحفوظة;
}

عرف اقرأ_رموز_كائن_خرج(
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل,
    المدخل: طبيعي,
    المحفوظة: &متغير متجه رمز_مدخل_محفوظ_ربط
): فراغ {
    دع حجم_الرمز: طبيعي = حجم_رمز_إلف_مدخل((*الوصف).الصنف);
    دع ق: متغير طبيعي = 0;
    طالما (ق < (*الوصف).عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(الوصف, ق);
        إذا (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, الرأس) == 2) {
            دع الموضع: طبيعي = حقل_موضع_قسم_إلف_مدخل(البايتات, الوصف, الرأس);
            دع الحجم: طبيعي = حقل_حجم_قسم_إلف_مدخل(البايتات, الوصف, الرأس);
            دع رابط_النصوص: طبيعي = حقل_رابط_قسم_إلف_مدخل(البايتات, الوصف, الرأس);
            إذا (رابط_النصوص >= (*الوصف).عدد_الأقسام || !ضمن_حدود_إلف_مدخل(البايتات, الموضع, الحجم)) { أرجع; };
            دع رأس_النصوص: طبيعي = موضع_رأس_قسم_إلف_مدخل(الوصف, رابط_النصوص);
            دع موضع_النصوص: طبيعي = حقل_موضع_قسم_إلف_مدخل(البايتات, الوصف, رأس_النصوص);
            دع حجم_النصوص: طبيعي = حقل_حجم_قسم_إلف_مدخل(البايتات, الوصف, رأس_النصوص);
            دع ر: متغير طبيعي = 1;
            طالما ((ر + 1) * حجم_الرمز <= الحجم) {
                دع موضع_الرمز: طبيعي = الموضع + ر * حجم_الرمز;
                دع المعلومات: طبيعي = حقل_معلومات_رمز_إلف_مدخل(البايتات, الوصف, موضع_الرمز);
                دع فهرس_القسم: طبيعي = حقل_فهرس_قسم_رمز_إلف_مدخل(البايتات, الوصف, موضع_الرمز);
                دع إزاحة_الاسم: طبيعي = حقل_اسم_رمز_إلف_مدخل(البايتات, الوصف, موضع_الرمز);
                إذا ((المعلومات & 0xF) <= 2 && فهرس_القسم != 0 && فهرس_القسم != 0xFFF2 && إزاحة_الاسم != 0
                    && إزاحة_الاسم < حجم_النصوص) {
                    طابق اقرأ_اسم_صفري_إلف_مدخل(البايتات, موضع_النصوص + إزاحة_الاسم, موضع_النصوص + حجم_النصوص) مع
                    | اختياري.لا_شيء -> { }
                    | اختياري.موجود(الاسم) -> {
                        دع الرمز: رمز_مدخل_محفوظ_ربط = {
                            المدخل: المدخل,
                            فهرس_القسم: فهرس_القسم,
                            القيمة: حقل_قيمة_رمز_إلف_مدخل(البايتات, الوصف, موضع_الرمز),
                            الحجم: حقل_حجم_رمز_إلف_مدخل(البايتات, الوصف, موضع_الرمز),
                            المعلومات: المعلومات,
                            الآخر: بايت_رمز_إلف_آخر(البايتات, الوصف, موضع_الرمز),
                            الاسم: الاسم
                        };
                        ألحق(*المحفوظة, الرمز);
                    };
                };
                ر := ر + 1;
            }
        };
        ق := ق + 1;
    }
}

عرف أضف_رمز_محفوظ_خرج(
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    المحفوظ: &رمز_مدخل_محفوظ_ربط,
    أقسام_المدخلات: &الخريطة<طبيعي, طبيعي>,
    أقسام_الصورة: &متجه قسم_صورة_للرموز,
    المحليات: &متغير متجه رمز_خرج_إلف,
    العامة: &متغير متجه رمز_خرج_إلف,
    المكتوبة: &متغير الخريطة<متجه ط8, طبيعي>
): فراغ {
    دع فهرس_القسم: طبيعي = (*المحفوظ).فهرس_القسم;
    دع الارتباط: طبيعي = (*المحفوظ).المعلومات >> 4;
    دع العنوان: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا (فهرس_القسم == 0xFFF1) {
        العنوان := اختياري.موجود((*المحفوظ).القيمة);
    } وإلا {
        العنوان := عنوان_رمز_مدخل_خرج(السياق, التخطيط, أقسام_المدخلات, (*المحفوظ).المدخل, فهرس_القسم, (*المحفوظ).القيمة);
    };
    إذا (الارتباط != 0) {
        دع الاختيار: اختيار_عام_خرج = تعريف_عام_مختار_خرج(السياق, &(*المحفوظ).الاسم, (*المحفوظ).المدخل);
        طابق الاختيار.مطلق مع
        | اختياري.موجود(القيمة) -> { العنوان := اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> { };
        طابق ابحث_في_الخريطة(&(*المكتوبة), &(*المحفوظ).الاسم) مع
        | اختياري.موجود(_) -> { أرجع; }
        | اختياري.لا_شيء -> { };
        إذا (!الاختيار.مختار) { أرجع; };
    };
    طابق العنوان مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        دع القسم_الخارج: متغير طبيعي = 0xFFF1;
        إذا (فهرس_القسم != 0xFFF1) {
            دع العنوان_للقسم: متغير طبيعي = القيمة;
            إذا ((*السياق).الهدف.المعمارية.الهوية == هوية_معمارية.ذراع_سبعة()) {
                العنوان_للقسم := القيمة & 0xFFFFFFFFFFFFFFFE;
            };
            القسم_الخارج := قسم_عنوان_رمز_خرج(أقسام_الصورة, العنوان_للقسم);
        };
        دع الرمز: رمز_خرج_إلف = {
            الاسم: انسخ_بايتات(&(*المحفوظ).الاسم),
            القيمة: القيمة,
            الحجم: (*المحفوظ).الحجم,
            المعلومات: (*المحفوظ).المعلومات,
            الآخر: (*المحفوظ).الآخر,
            القسم: القسم_الخارج
        };
        إذا (الارتباط == 0) {
            ألحق(*المحليات, الرمز);
        } وإلا {
            أدرج_في_الخريطة(المكتوبة, انسخ_بايتات(&(*المحفوظ).الاسم), 1);
            ألحق(*العامة, الرمز);
        };
    };
}
