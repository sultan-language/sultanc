عام عرف اقرأ_اسم_صفري_إلف_مدخل(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري متجه ط8 {
    إذا (الموضع >= النهاية
        || النهاية > (الطول(*البايتات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = الموضع;
    طالما (الفهرس < النهاية) {
        إذا ((*البايتات)[الفهرس] == 0) { أرجع اختياري.موجود(الاسم); };
        ألحق(الاسم, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

