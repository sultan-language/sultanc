عام عرف حقل_رابط_قسم_إلف_مدخل(
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: طبيعي
): طبيعي {
    دع الإزاحة: متغير طبيعي = 24;
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { الإزاحة := 24; }
    | صنف_إلف_مدخل.أربعة_وستون -> { الإزاحة := 40; };
    أرجع اقرأ_ط32_إلف_مدخل(
        البايتات,
        الرأس + الإزاحة,
        (*الوصف).الترتيب
    );
}

