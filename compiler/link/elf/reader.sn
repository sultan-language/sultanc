عام عرف حقل_رابط_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    دع الإزاحة: متغير غير_موقع = 24;
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { الإزاحة := 24; }
    | صنف_إلف_مدخل.أربعة_وستون -> { الإزاحة := 40; };
    أرجع اقرأ_غ32_إلف_مدخل(
        البايتات,
        الرأس + الإزاحة,
        (*الوصف).الترتيب
    );
}

