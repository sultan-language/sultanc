// Shared ELF decoding facts. Object ingestion, shared-library ingestion and
// relocatable output all consume the same class/endian model.
عرف بايت_إلف_مدخل_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع صنف_إلف_مدخل =
    | اثنان_وثلاثون
    | أربعة_وستون
;

عام نوع ترتيب_إلف_مدخل =
    | صغير
    | كبير
;

عام نوع واصف_إلف_مدخل = {
    الصنف: صنف_إلف_مدخل,
    الترتيب: ترتيب_إلف_مدخل,
    نوع_الملف: غير_موقع,
    الآلة: غير_موقع,
    موضع_رؤوس_الأقسام: غير_موقع,
    حجم_رأس_القسم: غير_موقع,
    // Zero, with موضع_رؤوس_الأقسام zero, when the file has no section header
    // table (only a linked image may omit it; اقرأ_واصف_صورة_إلف_مدخل).
    عدد_الأقسام: غير_موقع,
    // SHN_UNDEF (0) when the file has no section name string table.
    فهرس_جدول_أسماء_الأقسام: غير_موقع,
    موضع_رؤوس_البرنامج: غير_موقع,
    عدد_رؤوس_البرنامج: غير_موقع
};

عام عرف ضمن_حدود_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_غ16_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع الأول: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع الثاني: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 1) مثل غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع الأول + الثاني * 256; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع الأول * 256 + الثاني; };
}

عام عرف اقرأ_غ32_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع ب0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 1) مثل غير_موقع;
    دع ب2: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 2) مثل غير_موقع;
    دع ب3: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 3) مثل غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> {
        أرجع ب0 + ب1 * 256 + ب2 * 65536 + ب3 * 16777216;
    }
    | ترتيب_إلف_مدخل.كبير -> {
        أرجع ب0 * 16777216 + ب1 * 65536 + ب2 * 256 + ب3;
    };
}

عام عرف اقرأ_غ64_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع الأول: غير_موقع = اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
    دع الثاني: غير_موقع = اقرأ_غ32_إلف_مدخل(
        البايتات,
        الموضع + 4,
        الترتيب
    );
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع الأول + الثاني * 4294967296; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع الأول * 4294967296 + الثاني; };
}

عام عرف اقرأ_قيمة_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): اختيار غير_موقع {
    لو (!ضمن_حدود_إلف_مدخل(البايتات, الموضع, العرض)) {
        أرجع اختيار.لا_شيء();
    };
    لو (العرض == 2) {
        أرجع اختيار.بعض(اقرأ_غ16_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    لو (العرض == 4) {
        أرجع اختيار.بعض(اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    لو (العرض == 8) {
        أرجع اختيار.بعض(اقرأ_غ64_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    أرجع اختيار.لا_شيء();
}

عام عرف اقرأ_ص32_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): عدد {
    دع الخام: غير_موقع = اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
    لو ((الخام & 0x80000000) == 0) { أرجع الخام مثل عدد; };
    دع المقدار: غير_موقع = (0xFFFFFFFF - الخام) + 1;
    أرجع -(المقدار مثل عدد);
}

عام عرف اقرأ_ص64_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): اختيار عدد {
    دع الأدنى: غير_موقع;
    دع الأعلى: غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> {
        الأدنى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
        الأعلى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع + 4, الترتيب);
    }
    | ترتيب_إلف_مدخل.كبير -> {
        الأعلى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
        الأدنى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع + 4, الترتيب);
    };
    لو ((الأعلى & 0x80000000) == 0) {
        دع القيمة: غير_موقع = الأدنى + الأعلى * 4294967296;
        لو (القيمة > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(القيمة مثل عدد);
    };
    دع معكوس_الأدنى: غير_موقع = 0xFFFFFFFF - الأدنى;
    دع معكوس_الأعلى: غير_موقع = 0xFFFFFFFF - الأعلى;
    دع المقدار: غير_موقع = معكوس_الأدنى + معكوس_الأعلى * 4294967296 + 1;
    لو (المقدار > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(-(المقدار مثل عدد));
}

عام عرف حجم_رأس_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 52; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 64; };
}

عام عرف حجم_رأس_قسم_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 40; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 64; };
}

عام عرف حجم_رمز_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 16; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 24; };
}

عام عرف حجم_ريلا_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 12; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 24; };
}

عام عرف حجم_ريل_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 8; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 16; };
}

// The ELF header (gABI "ELF Header", "Sections"; LLVM object::ELFFile):
//   * e_ident: magic, ELFCLASS32/64, ELFDATA2LSB/MSB, EV_CURRENT;
//   * the header itself within the file;
//   * a section header table is absent exactly when e_shoff is 0, and then
//     e_shnum and e_shstrndx must be 0 (SHN_UNDEF); a present table must have
//     e_shentsize equal to the class's Elf_Shdr size and lie in the file;
//   * extended numbering: e_shnum 0 with a present table takes the count from
//     section 0's sh_size, e_shstrndx SHN_XINDEX (0xFFFF) takes the index
//     from section 0's sh_link, and e_phnum PN_XNUM (0xFFFF) takes the count
//     from section 0's sh_info (each is malformed without a section table);
//   * a present program header table must have e_phentsize equal to the
//     class's Elf_Phdr size and lie in the file.
// يتطلب_الأقسام says whether the consumer reads section headers: object and
// shared-library ingestion and relocatable outputs do, and then a file
// without a section header table is rejected; post-link image validation
// does not. Previously every file without section headers was rejected,
// although the gABI makes the section header table optional for executable
// and shared object files (tools such as sstrip remove it), and an object
// using extended section numbering (65280 or more sections, e_shnum 0) was
// rejected as malformed.
عرف اقرأ_رأس_إلف_مدخل(
    البايتات: &متجه غ8,
    يتطلب_الأقسام: منطقي
): اختيار واصف_إلف_مدخل {
    لو (!ضمن_حدود_إلف_مدخل(البايتات, 0, 16)) {
        أرجع اختيار.لا_شيء();
    };
    لو ((*البايتات)[0] != 0x7F
        || (*البايتات)[1] != 0x45
        || (*البايتات)[2] != 0x4C
        || (*البايتات)[3] != 0x46
        || (*البايتات)[6] != 1) {
        أرجع اختيار.لا_شيء();
    };
    دع الصنف: صنف_إلف_مدخل;
    لو ((*البايتات)[4] == 1) {
        الصنف := صنف_إلف_مدخل.اثنان_وثلاثون();
    } وإلا لو ((*البايتات)[4] == 2) {
        الصنف := صنف_إلف_مدخل.أربعة_وستون();
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    دع الترتيب: ترتيب_إلف_مدخل;
    لو ((*البايتات)[5] == 1) {
        الترتيب := ترتيب_إلف_مدخل.صغير();
    } وإلا لو ((*البايتات)[5] == 2) {
        الترتيب := ترتيب_إلف_مدخل.كبير();
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    دع حجم_الرأس: غير_موقع = حجم_رأس_إلف_مدخل(الصنف);
    لو (!ضمن_حدود_إلف_مدخل(البايتات, 0, حجم_الرأس)) {
        أرجع اختيار.لا_شيء();
    };
    دع نوع_الملف: غير_موقع = اقرأ_غ16_إلف_مدخل(البايتات, 16, الترتيب);
    دع الآلة: غير_موقع = اقرأ_غ16_إلف_مدخل(البايتات, 18, الترتيب);
    دع موضع_رؤوس_البرنامج: غير_موقع;
    دع موضع_رؤوس_الأقسام: غير_موقع;
    دع حجم_رأس_البرنامج: غير_موقع;
    دع عدد_رؤوس_البرنامج_الخام: غير_موقع;
    دع حجم_رأس_القسم: غير_موقع;
    دع عدد_الأقسام_الخام: غير_موقع;
    دع فهرس_الأسماء_الخام: غير_موقع;
    دع حجم_رأس_برنامج_الصنف: غير_موقع;
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        موضع_رؤوس_البرنامج := اقرأ_غ32_إلف_مدخل(البايتات, 28, الترتيب);
        موضع_رؤوس_الأقسام := اقرأ_غ32_إلف_مدخل(البايتات, 32, الترتيب);
        حجم_رأس_البرنامج := اقرأ_غ16_إلف_مدخل(البايتات, 42, الترتيب);
        عدد_رؤوس_البرنامج_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 44, الترتيب);
        حجم_رأس_القسم := اقرأ_غ16_إلف_مدخل(البايتات, 46, الترتيب);
        عدد_الأقسام_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 48, الترتيب);
        فهرس_الأسماء_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 50, الترتيب);
        حجم_رأس_برنامج_الصنف := 32;
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        موضع_رؤوس_البرنامج := اقرأ_غ64_إلف_مدخل(البايتات, 32, الترتيب);
        موضع_رؤوس_الأقسام := اقرأ_غ64_إلف_مدخل(البايتات, 40, الترتيب);
        حجم_رأس_البرنامج := اقرأ_غ16_إلف_مدخل(البايتات, 54, الترتيب);
        عدد_رؤوس_البرنامج_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 56, الترتيب);
        حجم_رأس_القسم := اقرأ_غ16_إلف_مدخل(البايتات, 58, الترتيب);
        عدد_الأقسام_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 60, الترتيب);
        فهرس_الأسماء_الخام := اقرأ_غ16_إلف_مدخل(البايتات, 62, الترتيب);
        حجم_رأس_برنامج_الصنف := 56;
    };

    دع عدد_الأقسام: متغير غير_موقع = 0;
    دع فهرس_جدول_الأسماء: متغير غير_موقع = 0;
    دع عدد_رؤوس_البرنامج: متغير غير_موقع = عدد_رؤوس_البرنامج_الخام;
    لو (موضع_رؤوس_الأقسام == 0) {
        // No section header table: the count and the name table index must
        // say so too, and nothing can carry an extended value.
        لو (يتطلب_الأقسام
            || عدد_الأقسام_الخام != 0
            || فهرس_الأسماء_الخام != 0
            || عدد_رؤوس_البرنامج_الخام == 0xFFFF) {
            أرجع اختيار.لا_شيء();
        };
    } وإلا {
        لو (حجم_رأس_القسم != حجم_رأس_قسم_إلف_مدخل(الصنف)
            || !ضمن_حدود_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام, حجم_رأس_القسم)) {
            أرجع اختيار.لا_شيء();
        };
        // Section 0 (SHN_UNDEF) holds the extended values.
        دع حجم_الأول: غير_موقع;
        دع رابط_الأول: غير_موقع;
        دع معلومات_الأول: غير_موقع;
        طابق الصنف مع
        | صنف_إلف_مدخل.اثنان_وثلاثون -> {
            حجم_الأول := اقرأ_غ32_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 20, الترتيب);
            رابط_الأول := اقرأ_غ32_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 24, الترتيب);
            معلومات_الأول := اقرأ_غ32_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 28, الترتيب);
        }
        | صنف_إلف_مدخل.أربعة_وستون -> {
            حجم_الأول := اقرأ_غ64_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 32, الترتيب);
            رابط_الأول := اقرأ_غ32_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 40, الترتيب);
            معلومات_الأول := اقرأ_غ32_إلف_مدخل(البايتات, موضع_رؤوس_الأقسام + 44, الترتيب);
        };
        عدد_الأقسام := عدد_الأقسام_الخام;
        لو (عدد_الأقسام == 0) { عدد_الأقسام := حجم_الأول; };
        فهرس_جدول_الأسماء := فهرس_الأسماء_الخام;
        لو (فهرس_جدول_الأسماء == 0xFFFF) { فهرس_جدول_الأسماء := رابط_الأول; };
        لو (عدد_رؤوس_البرنامج == 0xFFFF) { عدد_رؤوس_البرنامج := معلومات_الأول; };
        // The count must fit the file without overflowing the product.
        لو (عدد_الأقسام == 0
            || عدد_الأقسام > (الطول(*البايتات) مثل غير_موقع) / حجم_رأس_القسم
            || !ضمن_حدود_إلف_مدخل(
                البايتات,
                موضع_رؤوس_الأقسام,
                عدد_الأقسام * حجم_رأس_القسم
            )
            || فهرس_جدول_الأسماء >= عدد_الأقسام) {
            أرجع اختيار.لا_شيء();
        };
    };
    لو (عدد_رؤوس_البرنامج > 0) {
        لو (حجم_رأس_البرنامج != حجم_رأس_برنامج_الصنف
            || عدد_رؤوس_البرنامج
                > (الطول(*البايتات) مثل غير_موقع) / حجم_رأس_البرنامج
            || !ضمن_حدود_إلف_مدخل(
                البايتات,
                موضع_رؤوس_البرنامج,
                عدد_رؤوس_البرنامج * حجم_رأس_البرنامج
            )) {
            أرجع اختيار.لا_شيء();
        };
    };
    دع الوصف: واصف_إلف_مدخل = {
        الصنف: الصنف,
        الترتيب: الترتيب,
        نوع_الملف: نوع_الملف,
        الآلة: الآلة,
        موضع_رؤوس_الأقسام: موضع_رؤوس_الأقسام,
        حجم_رأس_القسم: حجم_رأس_القسم,
        عدد_الأقسام: عدد_الأقسام,
        فهرس_جدول_أسماء_الأقسام: فهرس_جدول_الأسماء,
        موضع_رؤوس_البرنامج: موضع_رؤوس_البرنامج,
        عدد_رؤوس_البرنامج: عدد_رؤوس_البرنامج
    };
    أرجع اختيار.بعض(الوصف);
}

// For consumers that read section headers (object and shared-library
// ingestion, single relocatable modules): a section header table is
// required.
عام عرف اقرأ_واصف_إلف_مدخل(
    البايتات: &متجه غ8
): اختيار واصف_إلف_مدخل {
    أرجع اقرأ_رأس_إلف_مدخل(البايتات, صواب);
}

// For a linked image produced by a linker (post-link validation): an
// ET_EXEC or ET_DYN image needs program headers to be loadable and may omit
// its section header table; any other file type keeps the section header
// requirement, since a relocatable output is consumed through its sections.
عام عرف اقرأ_واصف_صورة_إلف_مدخل(
    البايتات: &متجه غ8
): اختيار واصف_إلف_مدخل {
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_رأس_إلف_مدخل(البايتات, خطأ) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الوصف := القيمة; };
    لو (الوصف.نوع_الملف == 2 || الوصف.نوع_الملف == 3) {
        لو (الوصف.عدد_رؤوس_البرنامج == 0) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الوصف);
    };
    لو (الوصف.عدد_الأقسام == 0) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الوصف);
}

عام عرف موضع_رأس_قسم_إلف_مدخل(
    الوصف: &واصف_إلف_مدخل,
    الفهرس: غير_موقع
): غير_موقع {
    أرجع (*الوصف).موضع_رؤوس_الأقسام
        + الفهرس * (*الوصف).حجم_رأس_القسم;
}

عام عرف حقل_نوع_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 4, (*الوصف).الترتيب);
}

عام عرف حقل_أعلام_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 8, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 8, (*الوصف).الترتيب);
    };
}

عام عرف حقل_موضع_قسم_إلف_مدخل(
