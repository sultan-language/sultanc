// Shared ELF decoding facts. Object ingestion, shared-library ingestion and
// relocatable output all consume the same class/endian model.
عرف بايت_إلف_مدخل_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع صنف_إلف_مدخل =
    | اثنان_وثلاثون
    | أربعة_وستون
;

عام نوع ترتيب_إلف_مدخل =
    | صغير
    | كبير
;

عام نوع واصف_إلف_مدخل = {
    الصنف: صنف_إلف_مدخل,
    الترتيب: ترتيب_إلف_مدخل,
    نوع_الملف: غير_موقع,
    الآلة: غير_موقع,
    موضع_رؤوس_الأقسام: غير_موقع,
    حجم_رأس_القسم: غير_موقع,
    عدد_الأقسام: غير_موقع,
    فهرس_جدول_أسماء_الأقسام: غير_موقع
};

عام عرف ضمن_حدود_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_غ16_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع الأول: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع الثاني: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 1) مثل غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع الأول + الثاني * 256; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع الأول * 256 + الثاني; };
}

عام عرف اقرأ_غ32_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع ب0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب1: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 1) مثل غير_موقع;
    دع ب2: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 2) مثل غير_موقع;
    دع ب3: غير_موقع = بايت_إلف_مدخل_عند(البايتات, الموضع + 3) مثل غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> {
        أرجع ب0 + ب1 * 256 + ب2 * 65536 + ب3 * 16777216;
    }
    | ترتيب_إلف_مدخل.كبير -> {
        أرجع ب0 * 16777216 + ب1 * 65536 + ب2 * 256 + ب3;
    };
}

عام عرف اقرأ_غ64_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): غير_موقع {
    دع الأول: غير_موقع = اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
    دع الثاني: غير_موقع = اقرأ_غ32_إلف_مدخل(
        البايتات,
        الموضع + 4,
        الترتيب
    );
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع الأول + الثاني * 4294967296; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع الأول * 4294967296 + الثاني; };
}

عام عرف اقرأ_قيمة_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): اختيار غير_موقع {
    لو (!ضمن_حدود_إلف_مدخل(البايتات, الموضع, العرض)) {
        أرجع اختيار.لا_شيء();
    };
    لو (العرض == 2) {
        أرجع اختيار.بعض(اقرأ_غ16_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    لو (العرض == 4) {
        أرجع اختيار.بعض(اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    لو (العرض == 8) {
        أرجع اختيار.بعض(اقرأ_غ64_إلف_مدخل(البايتات, الموضع, الترتيب));
    };
    أرجع اختيار.لا_شيء();
}

عام عرف اقرأ_ص32_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): عدد {
    دع الخام: غير_موقع = اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
    لو ((الخام & 0x80000000) == 0) { أرجع الخام مثل عدد; };
    دع المقدار: غير_موقع = (0xFFFFFFFF - الخام) + 1;
    أرجع -(المقدار مثل عدد);
}

عام عرف اقرأ_ص64_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_إلف_مدخل
): اختيار عدد {
    دع الأدنى: غير_موقع;
    دع الأعلى: غير_موقع;
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> {
        الأدنى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
        الأعلى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع + 4, الترتيب);
    }
    | ترتيب_إلف_مدخل.كبير -> {
        الأعلى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع, الترتيب);
        الأدنى := اقرأ_غ32_إلف_مدخل(البايتات, الموضع + 4, الترتيب);
    };
    لو ((الأعلى & 0x80000000) == 0) {
        دع القيمة: غير_موقع = الأدنى + الأعلى * 4294967296;
        لو (القيمة > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(القيمة مثل عدد);
    };
    دع معكوس_الأدنى: غير_موقع = 0xFFFFFFFF - الأدنى;
    دع معكوس_الأعلى: غير_موقع = 0xFFFFFFFF - الأعلى;
    دع المقدار: غير_موقع = معكوس_الأدنى + معكوس_الأعلى * 4294967296 + 1;
    لو (المقدار > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(-(المقدار مثل عدد));
}

عام عرف حجم_رأس_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 52; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 64; };
}

عام عرف حجم_رأس_قسم_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 40; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 64; };
}

عام عرف حجم_رمز_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 16; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 24; };
}

عام عرف حجم_ريلا_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 12; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 24; };
}

عام عرف حجم_ريل_إلف_مدخل(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 8; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 16; };
}

عام عرف اقرأ_واصف_إلف_مدخل(
    البايتات: &متجه غ8
): اختيار واصف_إلف_مدخل {
    لو (!ضمن_حدود_إلف_مدخل(البايتات, 0, 16)) {
        أرجع اختيار.لا_شيء();
    };
    لو ((*البايتات)[0] != 0x7F
        || (*البايتات)[1] != 0x45
        || (*البايتات)[2] != 0x4C
        || (*البايتات)[3] != 0x46
        || (*البايتات)[6] != 1) {
        أرجع اختيار.لا_شيء();
    };
    دع الصنف: صنف_إلف_مدخل;
    لو ((*البايتات)[4] == 1) {
        الصنف := صنف_إلف_مدخل.اثنان_وثلاثون();
    } وإلا لو ((*البايتات)[4] == 2) {
        الصنف := صنف_إلف_مدخل.أربعة_وستون();
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    دع الترتيب: ترتيب_إلف_مدخل;
    لو ((*البايتات)[5] == 1) {
        الترتيب := ترتيب_إلف_مدخل.صغير();
    } وإلا لو ((*البايتات)[5] == 2) {
        الترتيب := ترتيب_إلف_مدخل.كبير();
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    دع حجم_الرأس: غير_موقع = حجم_رأس_إلف_مدخل(الصنف);
    لو (!ضمن_حدود_إلف_مدخل(البايتات, 0, حجم_الرأس)) {
        أرجع اختيار.لا_شيء();
    };
    دع نوع_الملف: غير_موقع = اقرأ_غ16_إلف_مدخل(البايتات, 16, الترتيب);
    دع الآلة: غير_موقع = اقرأ_غ16_إلف_مدخل(البايتات, 18, الترتيب);
    دع موضع_رؤوس_الأقسام: غير_موقع;
    دع حجم_رأس_القسم: غير_موقع;
    دع عدد_الأقسام: غير_موقع;
    دع فهرس_جدول_الأسماء: غير_موقع;
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        موضع_رؤوس_الأقسام := اقرأ_غ32_إلف_مدخل(البايتات, 32, الترتيب);
        حجم_رأس_القسم := اقرأ_غ16_إلف_مدخل(البايتات, 46, الترتيب);
        عدد_الأقسام := اقرأ_غ16_إلف_مدخل(البايتات, 48, الترتيب);
        فهرس_جدول_الأسماء := اقرأ_غ16_إلف_مدخل(البايتات, 50, الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        موضع_رؤوس_الأقسام := اقرأ_غ64_إلف_مدخل(البايتات, 40, الترتيب);
        حجم_رأس_القسم := اقرأ_غ16_إلف_مدخل(البايتات, 58, الترتيب);
        عدد_الأقسام := اقرأ_غ16_إلف_مدخل(البايتات, 60, الترتيب);
        فهرس_جدول_الأسماء := اقرأ_غ16_إلف_مدخل(البايتات, 62, الترتيب);
    };
    لو (حجم_رأس_القسم != حجم_رأس_قسم_إلف_مدخل(الصنف)) {
        أرجع اختيار.لا_شيء();
    };
    لو (عدد_الأقسام == 0
        || !ضمن_حدود_إلف_مدخل(
            البايتات,
            موضع_رؤوس_الأقسام,
            عدد_الأقسام * حجم_رأس_القسم
        )) {
        أرجع اختيار.لا_شيء();
    };
    لو (فهرس_جدول_الأسماء >= عدد_الأقسام) {
        أرجع اختيار.لا_شيء();
    };
    دع الوصف: واصف_إلف_مدخل = {
        الصنف: الصنف,
        الترتيب: الترتيب,
        نوع_الملف: نوع_الملف,
        الآلة: الآلة,
        موضع_رؤوس_الأقسام: موضع_رؤوس_الأقسام,
        حجم_رأس_القسم: حجم_رأس_القسم,
        عدد_الأقسام: عدد_الأقسام,
        فهرس_جدول_أسماء_الأقسام: فهرس_جدول_الأسماء
    };
    أرجع اختيار.بعض(الوصف);
}

عام عرف موضع_رأس_قسم_إلف_مدخل(
    الوصف: &واصف_إلف_مدخل,
    الفهرس: غير_موقع
): غير_موقع {
    أرجع (*الوصف).موضع_رؤوس_الأقسام
        + الفهرس * (*الوصف).حجم_رأس_القسم;
}

عام عرف حقل_نوع_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 4, (*الوصف).الترتيب);
}

عام عرف حقل_أعلام_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 8, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 8, (*الوصف).الترتيب);
    };
}

عام عرف حقل_موضع_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 16, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 24, (*الوصف).الترتيب);
    };
}

عام عرف حقل_حجم_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 20, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 32, (*الوصف).الترتيب);
    };
}

عام عرف حقل_رابط_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    دع الإزاحة: متغير غير_موقع = 24;
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { الإزاحة := 24; }
    | صنف_إلف_مدخل.أربعة_وستون -> { الإزاحة := 40; };
    أرجع اقرأ_غ32_إلف_مدخل(
        البايتات,
        الرأس + الإزاحة,
        (*الوصف).الترتيب
    );
}

عام عرف حقل_معلومات_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    دع الإزاحة: متغير غير_موقع = 28;
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { الإزاحة := 28; }
    | صنف_إلف_مدخل.أربعة_وستون -> { الإزاحة := 44; };
    أرجع اقرأ_غ32_إلف_مدخل(
        البايتات,
        الرأس + الإزاحة,
        (*الوصف).الترتيب
    );
}

عام عرف حقل_محاذاة_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 32, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 48, (*الوصف).الترتيب);
    };
}

عام عرف حقل_حجم_مدخل_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس + 36, (*الوصف).الترتيب);
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع اقرأ_غ64_إلف_مدخل(البايتات, الرأس + 56, (*الوصف).الترتيب);
    };
}

عام عرف اقرأ_اسم_صفري_إلف_مدخل(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (الموضع >= النهاية
        || النهاية > (الطول(*البايتات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = الموضع;
    بينما (الفهرس < النهاية) {
        لو ((*البايتات)[الفهرس] == 0) { أرجع اختيار.بعض(الاسم); };
        ألحق(الاسم, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف حقل_اسم_قسم_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الرأس: غير_موقع
): غير_موقع {
    أرجع اقرأ_غ32_إلف_مدخل(البايتات, الرأس, (*الوصف).الترتيب);
}

عام عرف حقل_اسم_رمز_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الموضع: غير_موقع
): غير_موقع {
    أرجع اقرأ_غ32_إلف_مدخل(البايتات, الموضع, (*الوصف).الترتيب);
}

عام عرف حقل_معلومات_رمز_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الموضع: غير_موقع
): غير_موقع {
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        أرجع بايت_إلف_مدخل_عند(البايتات, الموضع + 12) مثل غير_موقع;
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        أرجع بايت_إلف_مدخل_عند(البايتات, الموضع + 4) مثل غير_موقع;
    };
}

عام عرف حقل_فهرس_قسم_رمز_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
    الموضع: غير_موقع
): غير_موقع {
    دع الإزاحة: متغير غير_موقع = 14;
    طابق (*الوصف).الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { الإزاحة := 14; }
    | صنف_إلف_مدخل.أربعة_وستون -> { الإزاحة := 6; };
    أرجع اقرأ_غ16_إلف_مدخل(
        البايتات,
        الموضع + الإزاحة,
        (*الوصف).الترتيب
    );
}

عام عرف حقل_قيمة_رمز_إلف_مدخل(
    البايتات: &متجه غ8,
    الوصف: &واصف_إلف_مدخل,
