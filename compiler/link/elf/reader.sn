عام نوع معلومات_إزاحة_إلف_مدخل = {
    فهرس_الرمز: غير_موقع,
    رمز_الصيغة: غير_موقع
};

// MIPS64 little-endian objects (EM_MIPS = 8, ELFCLASS64, ELFDATA2LSB) do not
// store r_info as one little-endian 64-bit word. The MIPS64 ELF ABI record is
// a 32-bit r_sym in file byte order followed by the bytes r_ssym, r_type3,
// r_type2, r_type. Read as a little-endian u64, r_sym lands in the low word and
// the type bytes in the high word, so the generic ELF64_R_SYM/ELF64_R_TYPE split
// swaps them. Normalize exactly as LLVM's Elf_Rel_Impl::getRInfo(isMips64EL)
// does: symbol = r_sym, type = r_type | r_type2 << 8 | r_type3 << 16 |
// r_ssym << 24. Big-endian MIPS64 already matches the generic split.
// Previously every MIPS64EL relocation decoded to an out-of-range symbol index
// and the object was rejected as invalid (link.elf.invalid-object).
عرف إزاحة_إلف_ميبس64_صغيرة(الوصف: &واصف_إلف_مدخل): منطقي {
    أرجع (*الوصف).الآلة == 8
        && (*الوصف).الصنف == صنف_إلف_مدخل.أربعة_وستون()
        && (*الوصف).الترتيب == ترتيب_إلف_مدخل.صغير();
}

عام عرف فك_معلومات_إزاحة_إلف_مدخل(
    المعلومات: غير_موقع,
    الوصف: &واصف_إلف_مدخل
): معلومات_إزاحة_إلف_مدخل {
    لو (إزاحة_إلف_ميبس64_صغيرة(الوصف)) {
        دع الكلمة_العليا: غير_موقع = المعلومات / 4294967296;
        دع الرمز_الخاص: غير_موقع = الكلمة_العليا % 256;
        دع النوع_الثالث: غير_موقع = (الكلمة_العليا / 256) % 256;
        دع النوع_الثاني: غير_موقع = (الكلمة_العليا / 65536) % 256;
        دع النوع_الأول: غير_موقع = الكلمة_العليا / 16777216;
        دع ناتج_ميبس: معلومات_إزاحة_إلف_مدخل = {
            فهرس_الرمز: المعلومات % 4294967296,
            رمز_الصيغة: النوع_الأول + النوع_الثاني * 256
                + النوع_الثالث * 65536 + الرمز_الخاص * 16777216
        };
        أرجع ناتج_ميبس;
    };
    دع الصنف: صنف_إلف_مدخل = (*الوصف).الصنف;
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
        دع الناتج: معلومات_إزاحة_إلف_مدخل = {
            فهرس_الرمز: المعلومات / 256,
            رمز_الصيغة: المعلومات % 256
        };
        أرجع الناتج;
    }
    | صنف_إلف_مدخل.أربعة_وستون -> {
        دع الناتج: معلومات_إزاحة_إلف_مدخل = {
            فهرس_الرمز: المعلومات / 4294967296,
            رمز_الصيغة: المعلومات % 4294967296
        };
        أرجع الناتج;
    };
}
