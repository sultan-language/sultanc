استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.elf.final_image;
استورد compiler.link.elf.relocatable;
استورد compiler.link.elf.external_linker;
استورد compiler.link.elf.toolchain;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;

عام نوع خطأ_مزود_ربط_إلف =
    | خطة_غير_مدعومة
    | كائن_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_معروف
    | بيانات_أداة_مفقودة
    | أرشيف_رفيع_بلا_مسار
    | مساحة_عمل_مؤقتة_فشلت بنوع عدد
    | كتابة_مدخل_مؤقت_فشلت بنوع عدد
    | تشغيل_الرابط_فشل بنوع عدد
    | قراءة_المخرج_فشلت بنوع عدد
;

عام نوع نتيجة_مزود_ربط_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_إلف
;

عرف حوّل_خطأ_صورة_إلف_تنفيذية(
    الخطأ: خطأ_صورة_إلف_تنفيذية
): نتيجة_مزود_ربط_إلف {
    طابق الخطأ مع
    | خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.رمز_دخول_مفقود()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
}

عرف حوّل_خطأ_رابط_إلف_مفوض(
    الخطأ: خطأ_رابط_إلف_مفوض
): نتيجة_مزود_ربط_إلف {
    طابق الخطأ مع
    | خطأ_رابط_إلف_مفوض.خطة_غير_مدعومة -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | خطأ_رابط_إلف_مفوض.بيانات_أداة_مفقودة -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.بيانات_أداة_مفقودة()
        );
    }
    | خطأ_رابط_إلف_مفوض.أرشيف_رفيع_بلا_مسار -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.أرشيف_رفيع_بلا_مسار()
        );
    }
    | خطأ_رابط_إلف_مفوض.مساحة_عمل_مؤقتة_فشلت(الحالة) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.مساحة_عمل_مؤقتة_فشلت(الحالة)
        );
    }
    | خطأ_رابط_إلف_مفوض.كتابة_مدخل_مؤقت_فشلت(الحالة) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كتابة_مدخل_مؤقت_فشلت(الحالة)
        );
    }
    | خطأ_رابط_إلف_مفوض.تشغيل_الرابط_فشل(الحالة) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.تشغيل_الرابط_فشل(الحالة)
        );
    }
    | خطأ_رابط_إلف_مفوض.قراءة_المخرج_فشلت(الحالة) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.قراءة_المخرج_فشلت(الحالة)
        );
    }
    | خطأ_رابط_إلف_مفوض.مخرج_غير_صالح -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
}

عرف اربط_إلف_تنفيذيا(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو (!يستخدم_رابط_إلف_الداخلي(&(*السياق).الهدف)) {
        طابق اربط_إلف_بأداة_مفوضة(السياق) مع
        | نتيجة_رابط_إلف_مفوض.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
        }
        | نتيجة_رابط_إلف_مفوض.خطأ(الخطأ) -> {
            أرجع حوّل_خطأ_رابط_إلف_مفوض(الخطأ);
        };
    };
    طابق ابن_صورة_إلف_نظامية_تنفيذية(السياق) مع
    | نتيجة_صورة_إلف_تنفيذية.نجح(البايتات) -> {
        أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
    }
    | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
        أرجع حوّل_خطأ_صورة_إلف_تنفيذية(الخطأ);
    };
}

عرف اربط_إلف_كائنا_مترابطا(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو (يدعم_دمج_كائنات_إلف_مفوضا(&(*السياق).الهدف)) {
        طابق اربط_إلف_بأداة_مفوضة(السياق) مع
        | نتيجة_رابط_إلف_مفوض.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
        }
        | نتيجة_رابط_إلف_مفوض.خطأ(الخطأ) -> {
            أرجع حوّل_خطأ_رابط_إلف_مفوض(الخطأ);
        };
    };
    لو (!يستخدم_رابط_إلف_الداخلي(&(*السياق).الهدف)) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };
    طابق ابن_كائن_إلف_مترابط(السياق) مع
    | نتيجة_كائن_مترابط_إلف.نجح(البايتات) -> {
        أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
    }
    | نتيجة_كائن_مترابط_إلف.خطأ(_) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
}

عرف انسخ_بايتات_وحدة_إلف(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف مرر_وحدة_إلف_مفردة(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو ((الطول((*السياق).الخطة.المدخلات) مثل غير_موقع) != 1) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };
    دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[0];
    لو ((*المدخل).الصنف != صنف_مدخل_ربط.كائن()) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };

    دع الواصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(&(*المدخل).البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { الواصف := القيمة; };
    دع السياسة: سياسة_هدف_إلف;
    طابق سياسة_إلف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | اختيار.بعض(القيمة) -> { السياسة := القيمة; };
    لو (الواصف.نوع_الملف != 1
        || الواصف.الآلة != السياسة.الآلة
        || الواصف.الصنف != السياسة.الصنف
        || الواصف.الترتيب != السياسة.الترتيب) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
    أرجع نتيجة_مزود_ربط_إلف.نجح(
        انسخ_بايتات_وحدة_إلف(&(*المدخل).البايتات)
    );
}

عرف اربط_إلف_وحدة_هدف(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو (يدعم_دمج_كائنات_إلف_مفوضا(&(*السياق).الهدف)) {
        طابق اربط_إلف_بأداة_مفوضة(السياق) مع
        | نتيجة_رابط_إلف_مفوض.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
        }
        | نتيجة_رابط_إلف_مفوض.خطأ(الخطأ) -> {
            أرجع حوّل_خطأ_رابط_إلف_مفوض(الخطأ);
        };
    };
    أرجع مرر_وحدة_إلف_مفردة(السياق);
}

// ELF consumes canonical linker state for every output kind. Producer identity
// is intentionally absent here; Target + output kind select the serializer.
عام عرف اربط_إلف(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_إلف {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { أرجع اربط_إلف_تنفيذيا(السياق); }
    | نوع_خرج_ربط.كائن_مترابط -> {
        أرجع اربط_إلف_كائنا_مترابطا(السياق);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        لو (!يستخدم_رابط_إلف_الداخلي(&(*السياق).الهدف)) {
            طابق اربط_إلف_بأداة_مفوضة(السياق) مع
            | نتيجة_رابط_إلف_مفوض.نجح(البايتات) -> {
                أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
            }
            | نتيجة_رابط_إلف_مفوض.خطأ(الخطأ) -> {
                أرجع حوّل_خطأ_رابط_إلف_مفوض(الخطأ);
            };
        };
        طابق ابن_صورة_إلف_نظامية_مشتركة(السياق) مع
        | نتيجة_صورة_إلف_تنفيذية.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
        }
        | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
            أرجع حوّل_خطأ_صورة_إلف_تنفيذية(الخطأ);
        };
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع اربط_إلف_وحدة_هدف(السياق);
    };
}
