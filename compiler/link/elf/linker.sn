استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.elf.final_image;
استورد compiler.link.elf.relocatable;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.runtime.primitive_runtime_abi;

عام نوع خطأ_مزود_ربط_إلف =
    | خطة_غير_مدعومة
    | كائن_غير_صالح
    | رمز_دخول_مفقود
    // The undefined symbol no input defines (empty when the failure is not
    // one symbol's; see final_image.sn).
    | رمز_خارجي_غير_معروف بنوع متجه غ8
;

عام نوع نتيجة_مزود_ربط_إلف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_إلف
;

عرف حوّل_خطأ_صورة_إلف_تنفيذية(
    الخطأ: خطأ_صورة_إلف_تنفيذية
): نتيجة_مزود_ربط_إلف {
    طابق الخطأ مع
    | خطأ_صورة_إلف_تنفيذية.هدف_غير_مدعوم -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.تخطيط_غير_صالح -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.رمز_دخول_مفقود -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.رمز_دخول_مفقود()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.رمز_خارجي_غير_محلول(الاسم) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف(الاسم)
        );
    }
    | خطأ_صورة_إلف_تنفيذية.إزاحة_غير_مدعومة -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | خطأ_صورة_إلف_تنفيذية.إزاحة_خارج_النطاق -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
}

// The emitted _start references these conventional ELF linker boundary
// symbols as ordinary PC-relative symbols. Define them in the canonical symbol
// table before image layout so they are not mistaken for dynamic imports.
عرف ثبت_حد_منشئات_إلف_للتخطيط(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه غ8
): فراغ {
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.غير_معرف(المدخل) -> {
            دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
                المدخل, قوة_تعريف_رمز_ربط.قوي(),
                موضع_تعريف_رمز_ربط.مطلق(0), 0
            );
            (*السياق).الرموز.الرموز[الرمز.المعرف.القيمة].الحالة :=
                حالة_رمز_ربط.معرف(التعريف);
        }
        | _ -> { };
    };
}

// Undefined symbols at the end of an internal executable link, as LLD
// decides them (Symbol::isUndefWeak, reportUndefinedSymbols):
//   * a symbol that only non-extracting references name (an STB_WEAK
//     undefined symbol; link/context.sn مراجع_رمز_ربط) and that nothing
//     defines, whether still undefined or lazy in an archive that was never
//     extracted, is an undefined weak symbol. This linker writes fixed-address
//     ET_EXEC images, where LLD does not make such a symbol preemptible: it
//     resolves to zero and is not imported;
//   * any other symbol still undefined has no definition in the inputs, and
//     every dynamic dependency of the image comes from an ingested shared
//     library input, so no library can supply it at load time: the link
//     fails. Previously such a symbol became a dynamic import whenever the
//     link had a shared library input, producing an image that fails to
//     load, and an undefined weak symbol failed a static link.
// Returns the name of the first undefined symbol that remains, in symbol
// order, for the unresolved-symbol diagnostic.
عرف حل_الرموز_غير_المعرفة_إلف_تنفيذيا(
    السياق: &متغير سياق_ربط
): اختيار متجه غ8 {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع المعرف: معرف_رمز_ربط = (*السياق).الرموز.الرموز[الفهرس].المعرف;
        دع مستخدم: منطقي = (*السياق).الرموز.الرموز[الفهرس].مستخدم;
        دع المصدر: متغير اختيار معرف_مدخل_ربط = اختيار.لا_شيء();
        دع غير_محلول: متغير منطقي = خطأ;
        طابق (*السياق).الرموز.الرموز[الفهرس].الحالة مع
        | حالة_رمز_ربط.غير_معرف(المدخل) -> {
            المصدر := اختيار.بعض(المدخل);
            غير_محلول := صواب;
        }
        | حالة_رمز_ربط.كسول(الأرشيف, _) -> {
            لو (مستخدم) { المصدر := اختيار.بعض(الأرشيف); };
        }
        | _ -> { };
        طابق المصدر مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المدخل) -> {
            لو (رمز_مرجعه_ضعيف_فقط_في_سياق_الربط(السياق, المعرف)) {
                دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
                    المدخل,
                    قوة_تعريف_رمز_ربط.ضعيف(),
                    موضع_تعريف_رمز_ربط.مطلق(0),
                    0
                );
                (*السياق).الرموز.الرموز[الفهرس].الحالة :=
                    حالة_رمز_ربط.معرف(التعريف);
            } وإلا لو (غير_محلول) {
                أرجع اختيار.بعض(اسم_رمز_في_سياق_الربط(السياق, المعرف));
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اربط_إلف_تنفيذيا(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_إلف {
    // SultanC links ELF executables itself or not at all; no external linker
    // and no C runtime startup object takes part.
    لو (!يستخدم_رابط_إلف_الداخلي(&(*السياق).الهدف)) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };
    // The internal executable linker owns the synthetic boundary definitions
    // the emitted process start uses.
    دع بداية_المنشئات: متجه غ8 = اسم_بداية_منشئات_إلف_أساسي();
    دع نهاية_المنشئات: متجه غ8 = اسم_نهاية_منشئات_إلف_أساسي();
    ثبت_حد_منشئات_إلف_للتخطيط(السياق, &بداية_المنشئات);
    ثبت_حد_منشئات_إلف_للتخطيط(السياق, &نهاية_المنشئات);
    طابق حل_الرموز_غير_المعرفة_إلف_تنفيذيا(السياق) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الاسم) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف(الاسم)
        );
    };
    طابق ابن_صورة_إلف_نظامية_تنفيذية(السياق) مع
    | نتيجة_صورة_إلف_تنفيذية.نجح(البايتات) -> {
        أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
    }
    | نتيجة_صورة_إلف_تنفيذية.خطأ(الخطأ) -> {
        أرجع حوّل_خطأ_صورة_إلف_تنفيذية(الخطأ);
    };
}

عرف اربط_إلف_كائنا_مترابطا(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو (!يستخدم_رابط_إلف_الداخلي(&(*السياق).الهدف)) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };
    طابق ابن_كائن_إلف_مترابط(السياق) مع
    | نتيجة_كائن_مترابط_إلف.نجح(البايتات) -> {
        أرجع نتيجة_مزود_ربط_إلف.نجح(البايتات);
    }
    | نتيجة_كائن_مترابط_إلف.خطأ(_) -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
}

عرف انسخ_بايتات_وحدة_إلف(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف مرر_وحدة_إلف_مفردة(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    لو ((الطول((*السياق).الخطة.المدخلات) مثل غير_موقع) != 1) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };
    دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[0];
    لو ((*المدخل).الصنف != صنف_مدخل_ربط.كائن()) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    };

    دع الواصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(&(*المدخل).البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { الواصف := القيمة; };
    دع السياسة: سياسة_هدف_إلف;
    طابق سياسة_إلف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | اختيار.بعض(القيمة) -> { السياسة := القيمة; };
    لو (الواصف.نوع_الملف != 1
        || الواصف.الآلة != السياسة.الآلة
        || الواصف.الصنف != السياسة.الصنف
        || الواصف.الترتيب != السياسة.الترتيب) {
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.كائن_غير_صالح()
        );
    };
    أرجع نتيجة_مزود_ربط_إلف.نجح(
        انسخ_بايتات_وحدة_إلف(&(*المدخل).البايتات)
    );
}

// A target module (BPF, AMDGPU, AVR, MSP430 and other non-system ELF
// targets) is the single object the backend produced, passed through after
// validation. Merging several such objects needs that target's relocation
// rules, which SultanC does not implement, so it is unsupported rather than
// handed to an external linker as before (ld.lld, avr-ld, msp430-ld).
عرف اربط_إلف_وحدة_هدف(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_إلف {
    أرجع مرر_وحدة_إلف_مفردة(السياق);
}

// ELF consumes canonical linker state for every output kind. Producer identity
// is intentionally absent here; Target + output kind select the serializer.
عام عرف اربط_إلف(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_إلف {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { أرجع اربط_إلف_تنفيذيا(السياق); }
    | نوع_خرج_ربط.كائن_مترابط -> {
        أرجع اربط_إلف_كائنا_مترابطا(السياق);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        // ET_DYN must preserve dynamic relocations, which the internal
        // final-image writer does not encode. A shared ELF library is
        // unsupported instead of being handed to ld.lld as before.
        أرجع نتيجة_مزود_ربط_إلف.خطأ(
            خطأ_مزود_ربط_إلف.خطة_غير_مدعومة()
        );
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع اربط_إلف_وحدة_هدف(السياق);
    };
}
