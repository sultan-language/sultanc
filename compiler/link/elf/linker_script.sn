استورد compiler.link.model;
استورد std.text.from_bytes;

// GNU linker scripts used as link inputs. A system's development `.so` is
// often a text script naming the real libraries, as glibc's libc.so:
//
//   OUTPUT_FORMAT(elf64-x86-64)
//   GROUP ( /lib/libc.so.6 /usr/lib/libc_nonshared.a
//           AS_NEEDED ( /lib/ld-linux-x86-64.so.2 ) )
//
// The GNU ld contract (ld manual "File Commands") and LLD's ScriptLexer and
// ScriptParser (readGroup, readInput, readAsNeeded, readSearchDir, addFile,
// unquote) define what such an input script does:
//   * GROUP(...) and INPUT(...) name files that are linked at the script's
//     place in the input order. GROUP additionally rescans its archives; the
//     canonical symbol table resolves every archive lazily in any order (as
//     LLD always does), so GROUP and INPUT link the same files. Files are
//     separated by blanks or commas.
//   * AS_NEEDED(...) names shared libraries that become DT_NEEDED only when a
//     regular object uses one of their symbols (--as-needed for those files);
//     a script read for an AS_NEEDED entry inherits it.
//   * -l<name> is searched as lib<name>.so then lib<name>.a, and -l:<file> as
//     <file>, in the script's SEARCH_DIR directories (مرشحو_مدخل_سكربت_جنو);
//     no host directory is implied, since a cross link has no host sysroot.
//   * A double-quoted token is one file or directory name with the quotes
//     removed (it may contain blanks, commas and parentheses) and is never a
//     command keyword.
//   * A file or directory written with a leading '=' is relative to the
//     sysroot; SultanC's link configuration has no sysroot, so the '=' is
//     dropped, as LLD resolves '=' against an empty --sysroot.
//   * OUTPUT_FORMAT and OUTPUT_ARCH are informational for an input script.
// A text that starts like a linker script (a command word followed by '(' or
// '{') but uses any other command (SECTIONS, MEMORY, PHDRS, ENTRY, ...) or is
// malformed is an unsupported script (نتيجة_تحليل_سكربت_جنو.غير_مدعوم, which
// names the command it stopped at): the Driver fails the link for it, naming
// the script file and that command, since SultanC's internal ELF linker has a
// fixed layout and no script language. Any other text is not a script and is
// left to object ingestion, which rejects it as an invalid object.
//
// The Driver keeps the script as a link input at its position and adds the
// files it resolved right after it, in order (each nested script followed by
// its own files), recording the provenance in the plan (link/model.sn
// أصل_مدخل_ربط): the script input is marked سكربت_جنو and each file names
// its script and whether it is linked as needed. Ingestion skips the script
// itself (its files carry the symbols), the delegated linker passes the
// resolved files with --as-needed around the as-needed ones, and the
// internal ELF image records an as-needed library as DT_NEEDED only when
// used (elf/final_image.sn اعتماد_إلف_مطلوب).
// Previously the script was flattened into its files, so AS_NEEDED libraries
// were always DT_NEEDED, a -l reference made the whole script invalid, and
// quoted names kept their quotes; a later revision re-parsed every script in
// each consumer and matched the following inputs' paths to recover what the
// plan now records.

عام نوع مدخل_سكربت_جنو = {
    // A path, or the library name after -l / -l: when مكتبة.
    الاسم: متجه غ8,
    مكتبة: منطقي,
    حسب_الحاجة: منطقي
};

عام نوع سكربت_إدخال_جنو = {
    المدخلات: متجه مدخل_سكربت_جنو,
    أدلة_البحث: متجه متجه غ8
};

عام نوع نتيجة_تحليل_سكربت_جنو =
    | ليس_سكربت
    | سكربت بنوع سكربت_إدخال_جنو
    // A script SultanC cannot apply: the command it could not apply, or none
    // when the script is malformed or has no input command.
    | غير_مدعوم بنوع اختيار متجه غ8
;

نوع رمز_سكربت_جنو = {
    النص: متجه غ8,
    مقتبس: منطقي
};

نوع رموز_سكربت_جنو = {
    الرموز: متجه رمز_سكربت_جنو,
    // False for an unterminated comment or quoted name.
    سليم: منطقي
};

عرف ألحق_رمز_سكربت_جنو(
    الرموز: &متغير متجه رمز_سكربت_جنو,
    النص: &متجه غ8,
    مقتبس: منطقي
): فراغ {
    دع الرمز: رمز_سكربت_جنو = { النص: *النص, مقتبس: مقتبس };
    ألحق(*الرموز, الرمز);
}

// Tokens as LLD's ScriptLexer splits an input script: blanks and commas
// separate words, ( ) { } ; are tokens of their own, /* */ is a comment and a
// double-quoted string is one token. None when the bytes are not text.
عرف فارغ_رمز(): متجه غ8 {
    دع الفارغ: متجه غ8 = [];
    أرجع الفارغ;
}

عرف رموز_سكربت_ربط_جنو(البايتات: &متجه غ8): اختيار رموز_سكربت_جنو {
    دع الرموز: متغير متجه رمز_سكربت_جنو = [];
    دع الحالي: متغير متجه غ8 = [];
    دع سليم: متغير منطقي = صواب;
    دع ف: متغير غير_موقع = 0;
    دع الطول_الكلي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    بينما (ف < الطول_الكلي && سليم) {
        دع البايت: غ8 = (*البايتات)[ف];
        لو (البايت < 0x09 || (البايت > 0x0D && البايت < 0x20) || البايت > 0x7E) {
            // Not a text script.
            أرجع اختيار.لا_شيء();
        };
        لو (البايت == 0x2F && ف + 1 < الطول_الكلي && (*البايتات)[ف + 1] == 0x2A) {
            لو ((الطول(الحالي) مثل غير_موقع) > 0) {
                ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, خطأ);
                الحالي := فارغ_رمز();
            };
            ف := ف + 2;
            دع انتهى: متغير منطقي = خطأ;
            بينما (ف < الطول_الكلي && !انتهى) {
                لو ((*البايتات)[ف] == 0x2A && ف + 1 < الطول_الكلي
                    && (*البايتات)[ف + 1] == 0x2F) {
                    انتهى := صواب;
                    ف := ف + 2;
                } وإلا {
                    ف := ف + 1;
                };
            }
            لو (!انتهى) { سليم := خطأ; };
        } وإلا لو (البايت == 0x22) {
            لو ((الطول(الحالي) مثل غير_موقع) > 0) {
                ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, خطأ);
                الحالي := فارغ_رمز();
            };
            ف := ف + 1;
            دع انتهى: متغير منطقي = خطأ;
            بينما (ف < الطول_الكلي && !انتهى) {
                دع داخلي: غ8 = (*البايتات)[ف];
                لو (داخلي == 0x22) {
                    انتهى := صواب;
                } وإلا لو (داخلي == 0x0A || داخلي < 0x09 || داخلي > 0x7E) {
                    // A quoted name ends on its own line and is text.
                    سليم := خطأ;
                    انتهى := صواب;
                } وإلا {
                    ألحق(الحالي, داخلي);
                };
                ف := ف + 1;
            }
            لو (!انتهى) { سليم := خطأ; };
            ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, صواب);
            الحالي := فارغ_رمز();
        } وإلا {
            دع فاصل: منطقي = البايت == 0x20 || البايت == 0x09 || البايت == 0x0A
                || البايت == 0x0B || البايت == 0x0C || البايت == 0x0D
                || البايت == 0x2C;
            دع منفرد: منطقي = البايت == 0x28 || البايت == 0x29
                || البايت == 0x7B || البايت == 0x7D || البايت == 0x3B;
            لو (فاصل || منفرد) {
                لو ((الطول(الحالي) مثل غير_موقع) > 0) {
                    ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, خطأ);
                    الحالي := فارغ_رمز();
                };
                لو (منفرد) {
                    ألحق(الحالي, البايت);
                    ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, خطأ);
                    الحالي := فارغ_رمز();
                };
            } وإلا {
                ألحق(الحالي, البايت);
            };
            ف := ف + 1;
        };
    }
    لو ((الطول(الحالي) مثل غير_موقع) > 0) {
        ألحق_رمز_سكربت_جنو(&متغير الرموز, &الحالي, خطأ);
        الحالي := فارغ_رمز();
    };
    دع الناتج: رموز_سكربت_جنو = { الرموز: الرموز, سليم: سليم };
    أرجع اختيار.بعض(الناتج);
}

عرف بايتات_تساوي_كلمة(القيمة: &متجه غ8, الكلمة: نص): منطقي {
    دع البايتات: متجه غ8 = بايتات_من_نص(الكلمة);
    لو ((الطول(*القيمة) مثل غير_موقع) != (الطول(البايتات) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
        لو ((*القيمة)[ف] != البايتات[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// An unquoted token spelling the keyword or punctuation الكلمة.
عرف رمز_سكربت_يساوي(الرمز: &رمز_سكربت_جنو, الكلمة: نص): منطقي {
    لو ((*الرمز).مقتبس) { أرجع خطأ; };
    أرجع بايتات_تساوي_كلمة(&(*الرمز).النص, الكلمة);
}

// An unquoted word that can name a command: a letter or '_' first, then
// letters, digits and '_'.
عرف كلمة_أمر_سكربت(الرمز: &رمز_سكربت_جنو): منطقي {
    لو ((*الرمز).مقتبس || (الطول((*الرمز).النص) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الرمز).النص) مثل غير_موقع)) {
        دع ب: غ8 = (*الرمز).النص[ف];
        دع حرف_لاتيني: منطقي = (ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A) || ب == 0x5F;
        دع رقم: منطقي = ب >= 0x30 && ب <= 0x39;
        لو (!حرف_لاتيني && !(رقم && ف > 0)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف بلا_بادئة_جذر_النظام(القيمة: &متجه غ8): متجه غ8 {
    دع البداية: متغير غير_موقع = 0;
    لو ((الطول(*القيمة) مثل غير_موقع) > 0 && (*القيمة)[0] == 0x3D) { البداية := 1; };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// One file token inside GROUP/INPUT/AS_NEEDED, unquoted as LLD's addFile
// receives it.
عرف مدخل_من_رمز_سكربت(
    الرمز: &رمز_سكربت_جنو,
    حسب_الحاجة: منطقي
): اختيار مدخل_سكربت_جنو {
    دع النص: &متجه غ8 = &(*الرمز).النص;
    دع مكتبة: متغير منطقي = خطأ;
    دع الاسم: متغير متجه غ8 = [];
    لو ((الطول(*النص) مثل غير_موقع) > 2 && (*النص)[0] == 0x2D && (*النص)[1] == 0x6C) {
        مكتبة := صواب;
        دع ف: متغير غير_موقع = 2;
        بينما (ف < (الطول(*النص) مثل غير_موقع)) {
            ألحق(الاسم, (*النص)[ف]);
            ف := ف + 1;
        }
    } وإلا {
        الاسم := بلا_بادئة_جذر_النظام(النص);
    };
    لو ((الطول(الاسم) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع المدخل: مدخل_سكربت_جنو = {
        الاسم: الاسم,
        مكتبة: مكتبة,
        حسب_الحاجة: حسب_الحاجة
    };
    أرجع اختيار.بعض(المدخل);
}

// The command an unsupported-script result names (the command word the
// parser was applying when it stopped).
عرف أمر_سكربت_جنو(الرمز: &رمز_سكربت_جنو): اختيار متجه غ8 {
    دع مرجع_النص: &متجه غ8 = &(*الرمز).النص;
    دع النص: متجه غ8 = *مرجع_النص;
    أرجع اختيار.بعض(النص);
}

// Classifies and parses a possible input script.
عام عرف حلل_نص_سكربت_جنو(البايتات: &متجه غ8): نتيجة_تحليل_سكربت_جنو {
    دع المقروء: رموز_سكربت_جنو;
    طابق رموز_سكربت_ربط_جنو(البايتات) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_تحليل_سكربت_جنو.ليس_سكربت(); }
    | اختيار.بعض(القيمة) -> { المقروء := القيمة; };
    دع الرموز: &متجه رمز_سكربت_جنو = &المقروء.الرموز;
    دع العدد: غير_موقع = الطول(*الرموز) مثل غير_موقع;
    // Only text that starts with a command is a linker script at all.
    لو (العدد < 2 || !كلمة_أمر_سكربت(&(*الرموز)[0])
        || !(رمز_سكربت_يساوي(&(*الرموز)[1], «(»)
            || رمز_سكربت_يساوي(&(*الرموز)[1], «{»))) {
        أرجع نتيجة_تحليل_سكربت_جنو.ليس_سكربت();
    };
    لو (!المقروء.سليم) { أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(اختيار.لا_شيء()); };
    دع المدخلات: متغير متجه مدخل_سكربت_جنو = [];
    دع الأدلة: متغير متجه متجه غ8 = [];
    دع فيه_أمر_إدخال: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الرمز: &رمز_سكربت_جنو = &(*الرموز)[ف];
        لو (رمز_سكربت_يساوي(الرمز, «GROUP») || رمز_سكربت_يساوي(الرمز, «INPUT»)) {
            فيه_أمر_إدخال := صواب;
            لو (ف + 1 >= العدد || !رمز_سكربت_يساوي(&(*الرموز)[ف + 1], «(»)) {
                أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
            };
            // AS_NEEDED applies to the files inside its own parentheses.
            دع العمق: متغير غير_موقع = 1;
            دع عمق_الحاجة: متغير غير_موقع = 0;
            دع ينتظر_قوس_الحاجة: متغير منطقي = خطأ;
            ف := ف + 2;
            بينما (ف < العدد && العمق > 0) {
                دع العنصر: &رمز_سكربت_جنو = &(*الرموز)[ف];
                لو (رمز_سكربت_يساوي(العنصر, «(»)) {
                    // Only AS_NEEDED opens a nested list.
                    لو (!ينتظر_قوس_الحاجة) {
                        أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                    };
                    العمق := العمق + 1;
                    عمق_الحاجة := العمق;
                    ينتظر_قوس_الحاجة := خطأ;
                } وإلا لو (رمز_سكربت_يساوي(العنصر, «)»)) {
                    لو (ينتظر_قوس_الحاجة) {
                        أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                    };
                    لو (العمق == عمق_الحاجة) { عمق_الحاجة := 0; };
                    العمق := العمق - 1;
                } وإلا لو (رمز_سكربت_يساوي(العنصر, «AS_NEEDED»)) {
                    لو (عمق_الحاجة != 0 || ينتظر_قوس_الحاجة) {
                        أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                    };
                    ينتظر_قوس_الحاجة := صواب;
                } وإلا لو (!(*العنصر).مقتبس
                    && (رمز_سكربت_يساوي(العنصر, «{»)
                        || رمز_سكربت_يساوي(العنصر, «}»)
                        || رمز_سكربت_يساوي(العنصر, «;»))) {
                    أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                } وإلا {
                    لو (ينتظر_قوس_الحاجة) {
                        أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                    };
                    طابق مدخل_من_رمز_سكربت(العنصر, عمق_الحاجة != 0) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                    }
                    | اختيار.بعض(المدخل) -> { ألحق(المدخلات, المدخل); };
                };
                ف := ف + 1;
            }
            لو (العمق != 0) { أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز)); };
        } وإلا لو (رمز_سكربت_يساوي(الرمز, «SEARCH_DIR»)) {
            لو (ف + 3 >= العدد || !رمز_سكربت_يساوي(&(*الرموز)[ف + 1], «(»)
                || !رمز_سكربت_يساوي(&(*الرموز)[ف + 3], «)»)) {
                أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
            };
            دع الدليل_الخام: &رمز_سكربت_جنو = &(*الرموز)[ف + 2];
            لو (!(*الدليل_الخام).مقتبس
                && (رمز_سكربت_يساوي(الدليل_الخام, «(»)
                    || رمز_سكربت_يساوي(الدليل_الخام, «{»)
                    || رمز_سكربت_يساوي(الدليل_الخام, «}»)
                    || رمز_سكربت_يساوي(الدليل_الخام, «;»))) {
                أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
            };
            دع الدليل: متجه غ8 = بلا_بادئة_جذر_النظام(&(*الدليل_الخام).النص);
            لو ((الطول(الدليل) مثل غير_موقع) == 0) {
                أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
            };
            ألحق(الأدلة, الدليل);
            ف := ف + 4;
        } وإلا لو (رمز_سكربت_يساوي(الرمز, «OUTPUT_FORMAT»)
            || رمز_سكربت_يساوي(الرمز, «OUTPUT_ARCH»)) {
            لو (ف + 1 >= العدد || !رمز_سكربت_يساوي(&(*الرموز)[ف + 1], «(»)) {
                أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
            };
            ف := ف + 2;
            بينما (ف < العدد && !رمز_سكربت_يساوي(&(*الرموز)[ف], «)»)) {
                لو (رمز_سكربت_يساوي(&(*الرموز)[ف], «(»)) {
                    أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
                };
                ف := ف + 1;
            }
            لو (ف >= العدد) { أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز)); };
            ف := ف + 1;
        } وإلا لو (رمز_سكربت_يساوي(الرمز, «;»)) {
            // LLD accepts stray ';' between input-script commands.
            ف := ف + 1;
        } وإلا {
            أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(أمر_سكربت_جنو(الرمز));
        };
    }
    لو (!فيه_أمر_إدخال) { أرجع نتيجة_تحليل_سكربت_جنو.غير_مدعوم(اختيار.لا_شيء()); };
    دع السكربت: سكربت_إدخال_جنو = {
        المدخلات: المدخلات,
        أدلة_البحث: الأدلة
    };
    أرجع نتيجة_تحليل_سكربت_جنو.سكربت(السكربت);
}

// The directory of a script file: what precedes its last '/', "/" for a file
// in the root directory, and empty for a bare file name.
عام عرف دليل_مسار_سكربت_جنو(المسار: &نص): متجه غ8 {
    دع بايتات_المسار: متجه غ8 = بايتات_من_نص(*المسار);
    دع الدليل: متغير متجه غ8 = [];
    دع النهاية: متغير غير_موقع = الطول(بايتات_المسار) مثل غير_موقع;
    بينما (النهاية > 0 && بايتات_المسار[النهاية - 1] != 0x2F) {
        النهاية := النهاية - 1;
    }
    لو (النهاية == 1) {
        ألحق(الدليل, 0x2F);
        أرجع الدليل;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف + 1 < النهاية) {
        ألحق(الدليل, بايتات_المسار[ف]);
        ف := ف + 1;
    }
    أرجع الدليل;
}

// File names a -l entry may name: lib<name>.so then lib<name>.a for
// -l<name> (GNU ld's dynamic-then-static search without -Bstatic), and the
// file itself for -l:<file>.
عرف أسماء_ملفات_مكتبة_سكربت_جنو(المدخل: &مدخل_سكربت_جنو): متجه متجه غ8 {
    دع الأسماء: متغير متجه متجه غ8 = [];
    لو ((الطول((*المدخل).الاسم) مثل غير_موقع) > 1 && (*المدخل).الاسم[0] == 0x3A) {
        دع الملف: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 1;
        بينما (ف < (الطول((*المدخل).الاسم) مثل غير_موقع)) {
            ألحق(الملف, (*المدخل).الاسم[ف]);
            ف := ف + 1;
        }
        ألحق(الأسماء, الملف);
        أرجع الأسماء;
    };
    دع الامتدادات: متجه نص = [«.so», «.a»];
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول(الامتدادات) مثل غير_موقع)) {
        دع الاسم: متغير متجه غ8 = بايتات_من_نص(«lib»);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*المدخل).الاسم) مثل غير_موقع)) {
            ألحق(الاسم, (*المدخل).الاسم[ف]);
            ف := ف + 1;
        }
        دع مرجع_الامتداد: &نص = &الامتدادات[ه];
        دع بايتات_الامتداد: متجه غ8 = بايتات_من_نص(*مرجع_الامتداد);
        ف := 0;
        بينما (ف < (الطول(بايتات_الامتداد) مثل غير_موقع)) {
            ألحق(الاسم, بايتات_الامتداد[ف]);
            ف := ف + 1;
        }
        ألحق(الأسماء, الاسم);
        ه := ه + 1;
    }
    أرجع الأسماء;
}

عرف ألحق_مرشحي_دليل_سكربت_جنو(
    المرشحون: &متغير متجه نص,
    الدليل: &متجه غ8,
    الأسماء: &متجه متجه غ8
): فراغ {
    دع ن: متغير غير_موقع = 0;
    بينما (ن < (الطول(*الأسماء) مثل غير_موقع)) {
        دع المسار: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(*الدليل) مثل غير_موقع)) {
            ألحق(المسار, (*الدليل)[ف]);
            ف := ف + 1;
        }
        لو ((الطول(المسار) مثل غير_موقع) > 0
            && المسار[(الطول(المسار) مثل غير_موقع) - 1] != 0x2F) {
            ألحق(المسار, 0x2F);
        };
        ف := 0;
        بينما (ف < (الطول((*الأسماء)[ن]) مثل غير_موقع)) {
            ألحق(المسار, (*الأسماء)[ن][ف]);
            ف := ف + 1;
        }
        ألحق(*المرشحون, من_بايتات(&المسار));
        ن := ن + 1;
    }
}

// Candidate paths for one script entry, in search order (LLD
// ScriptParser::addFile and addLibrary):
//   * an absolute file is its own path;
//   * a relative file is looked up in the script's directory, then as given
//     (relative to the working directory), then in the search directories;
//   * a -l entry is looked up in the search directories only.
// The search directories are the script's SEARCH_DIR directories. No host
// directory is implied: without them, a -l entry has no candidate and the
// caller reports it missing. (The plan carries no -L list; it previously
// existed only as data for the delegated ELF linker and was always empty.)
عام عرف مرشحو_مدخل_سكربت_جنو(
    السكربت: &سكربت_إدخال_جنو,
    المدخل: &مدخل_سكربت_جنو,
    دليل_السكربت: &متجه غ8
): متجه نص {
    دع المرشحون: متغير متجه نص = [];
    دع الأسماء: متغير متجه متجه غ8 = [];
    لو (!(*المدخل).مكتبة) {
        لو ((*المدخل).الاسم[0] == 0x2F) {
            ألحق(المرشحون, من_بايتات(&(*المدخل).الاسم));
            أرجع المرشحون;
        };
        دع مرجع_الاسم: &متجه غ8 = &(*المدخل).الاسم;
        ألحق(الأسماء, *مرجع_الاسم);
        لو ((الطول(*دليل_السكربت) مثل غير_موقع) > 0) {
            ألحق_مرشحي_دليل_سكربت_جنو(&متغير المرشحون, دليل_السكربت, &الأسماء);
        };
        ألحق(المرشحون, من_بايتات(&(*المدخل).الاسم));
    } وإلا {
        الأسماء := أسماء_ملفات_مكتبة_سكربت_جنو(المدخل);
    };
    دع د: متغير غير_موقع = 0;
    بينما (د < (الطول((*السكربت).أدلة_البحث) مثل غير_موقع)) {
        ألحق_مرشحي_دليل_سكربت_جنو(
            &متغير المرشحون,
            &(*السكربت).أدلة_البحث[د],
            &الأسماء
        );
        د := د + 1;
    }
    أرجع المرشحون;
}
