استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.reachability;
استورد compiler.link.elf.reader;
استورد compiler.backend.target.target_model;
استورد المكتبة.مجموعات.خريطة;
استورد المكتبة.نصوص.من_بايتات;

// Call-frame information of an ELF executable, as LLD's EhFrameSection
// lays it out (lld/ELF/SyntheticSections.cpp, MarkLive.cpp):
//   * the inputs' `.eh_frame` sections are not reachability roots, and an
//     FDE's reference to the code it describes does not keep that code: a
//     function the link collects takes its FDE with it. An FDE whose code
//     is in a discarded COMDAT member has no such reference (ingestion
//     drops it, object_ingest.sn) and goes too;
//   * the CIEs the kept FDEs name are kept; other CIEs go;
//   * what a kept record references besides its code (a CIE's personality
//     routine, an FDE's LSDA) is kept, and so is whatever that reaches;
//   * the kept records of every input form one `.eh_frame` section in input
//     order, each FDE's CIE pointer rewritten to the CIE's new place and each
//     relocation moved with its record; a zero terminator ends it.
// The image then indexes the kept FDEs in `.eh_frame_hdr` (the binary-search
// table of the LSB's eh_frame_hdr format) under PT_GNU_EH_FRAME
// (final_image.sn ابن_رأس_إطارات_إلف).

عام عرف اسم_قسم_إطارات_إلف(): متجه ط8 { أرجع بايتات_من_نص(«.eh_frame»); }

عرف بايتات_متساوية_إطارات(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Whether the input section is call-frame information (`.eh_frame`).
عام عرف قسم_إطارات_إلف(القسم: &قسم_ربط): منطقي {
    ليكن الاسم: متجه ط8 = اسم_قسم_إطارات_إلف();
    أرجع بايتات_متساوية_إطارات(&(*القسم).الاسم.اسم_القسم, &الاسم);
}

عرف هاش_عدد_إطارات(القيمة: &طبيعي): طبيعي { أرجع *القيمة; }
عرف عددان_إطارات_متساويان(أ: &طبيعي, ب: &طبيعي): منطقي { أرجع *أ == *ب; }

عرف اقرأ_ط32_إطارات(البايتات: &متجه ط8, الموضع: طبيعي, الترتيب: ترتيب_بايت): طبيعي {
    ليكن أ: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    ليكن ب: طبيعي = (*البايتات)[الموضع + 1] مثل طبيعي;
    ليكن ج: طبيعي = (*البايتات)[الموضع + 2] مثل طبيعي;
    ليكن د: طبيعي = (*البايتات)[الموضع + 3] مثل طبيعي;
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { أرجع أ | (ب << 8) | (ج << 16) | (د << 24); }
    | ترتيب_بايت.كبير -> { أرجع (أ << 24) | (ب << 16) | (ج << 8) | د; };
}

عرف ألحق_ط32_إطارات(الناتج: &متغير متجه ط8, القيمة: طبيعي, الترتيب: ترتيب_بايت): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ليكن المرتبة: متغير طبيعي = ف;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { }
        | ترتيب_بايت.كبير -> { المرتبة := 3 - ف; };
        ألحق(*الناتج, ((القيمة >> (المرتبة * 8)) & 0xFF) مثل ط8);
        ف := ف + 1;
    }
}

// The bytes of an input section, from its content or its input file.
عرف بايتات_قسم_إطارات(السياق: &سياق_ربط, القسم: &قسم_ربط): اختياري متجه ط8 {
    طابق (*القسم).المحتوى مع
    | اختياري.موجود(المحتوى) -> {
        ليكن النسخة: متغير متجه ط8 = [];
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المحتوى) مثل طبيعي)) { ألحق(النسخة, المحتوى[ك]); ك := ك + 1; }
        أرجع اختياري.موجود(النسخة);
    }
    | اختياري.لا_شيء -> { };
    ليكن معرف_المدخل: طبيعي = (*القسم).المدخل.القيمة مثل طبيعي;
    إذا (معرف_المدخل >= (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن البايتات: &متجه ط8 = &(*السياق).الخطة.المدخلات[معرف_المدخل].البايتات;
    ليكن الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الوصف := القيمة; };
    إذا ((*القسم).فهرس_قسم_الصيغة >= الوصف.عدد_الأقسام) { أرجع اختياري.لا_شيء(); };
    ليكن الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(&الوصف, (*القسم).فهرس_قسم_الصيغة);
    ليكن الموضع: طبيعي = حقل_موضع_قسم_إلف_مدخل(البايتات, &الوصف, الرأس);
    ليكن الحجم: طبيعي = حقل_حجم_قسم_إلف_مدخل(البايتات, &الوصف, الرأس);
    إذا (الحجم != (*القسم).الحجم || !ضمن_حدود_إلف_مدخل(البايتات, الموضع, الحجم)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الحجم) { ألحق(الناتج, (*البايتات)[الموضع + ف]); ف := ف + 1; }
    أرجع اختياري.موجود(الناتج);
}

// One CIE or FDE of an input `.eh_frame`: its place and size in the
// section, and, for an FDE, the place of its CIE.
نوع سجل_إطارات_إلف = {
    البداية: طبيعي,
    الحجم: طبيعي,
    سي_آي_إي: منطقي,
    بداية_سي_آي_إي: طبيعي,
    محتفظ: منطقي,
    الموضع_الجديد: طبيعي
};

نوع قسم_إطارات_مقروء = {
    الفهرس: طبيعي,
    البايتات: متجه ط8,
    السجلات: متجه سجل_إطارات_إلف,
    // The context relocation indices whose source is this section.
    الإزاحات: متجه طبيعي
};

// The records of an input `.eh_frame`, or none when it is malformed or uses
// the 64-bit DWARF length form.
عرف سجلات_إطارات_إلف(البايتات: &متجه ط8, الترتيب: ترتيب_بايت): اختياري متجه سجل_إطارات_إلف {
    ليكن الناتج: متغير متجه سجل_إطارات_إلف = [];
    ليكن الطول_الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع + 4 <= الطول_الكلي) {
        ليكن الطول: طبيعي = اقرأ_ط32_إطارات(البايتات, الموضع, الترتيب);
        // A zero length is the terminator: nothing after it is read.
        إذا (الطول == 0) { أرجع اختياري.موجود(الناتج); };
        إذا (الطول == 0xFFFFFFFF || الطول < 4 || الطول > الطول_الكلي - الموضع - 4) {
            أرجع اختياري.لا_شيء();
        };
        ليكن المعرف: طبيعي = اقرأ_ط32_إطارات(البايتات, الموضع + 4, الترتيب);
        ليكن سي_آي_إي: منطقي = المعرف == 0;
        ليكن بداية_سي_آي_إي: متغير طبيعي = 0;
        إذا (!سي_آي_إي) {
            إذا (المعرف > الموضع + 4) { أرجع اختياري.لا_شيء(); };
            بداية_سي_آي_إي := الموضع + 4 - المعرف;
        };
        ليكن السجل: سجل_إطارات_إلف = {
            البداية: الموضع, الحجم: الطول + 4, سي_آي_إي: سي_آي_إي,
            بداية_سي_آي_إي: بداية_سي_آي_إي, محتفظ: خطأ, الموضع_الجديد: 0
        };
        ألحق(الناتج, السجل);
        الموضع := الموضع + الطول + 4;
    }
    أرجع اختياري.موجود(الناتج);
}

// The record that holds الإزاحة (records are in section order).
عرف سجل_إطارات_للإزاحة(السجلات: &متجه سجل_إطارات_إلف, الإزاحة: طبيعي): اختياري طبيعي {
    ليكن الأدنى: متغير طبيعي = 0;
    ليكن الأعلى: متغير طبيعي = الطول(*السجلات) مثل طبيعي;
    طالما (الأدنى < الأعلى) {
        ليكن الوسط: طبيعي = (الأدنى + الأعلى) / 2;
        ليكن السجل: &سجل_إطارات_إلف = &(*السجلات)[الوسط];
        إذا (الإزاحة < (*السجل).البداية) {
            الأعلى := الوسط;
        } وإلا إذا (الإزاحة >= (*السجل).البداية + (*السجل).الحجم) {
            الأدنى := الوسط + 1;
        } وإلا {
            أرجع اختياري.موجود(الوسط);
        };
    }
    أرجع اختياري.لا_شيء();
}

// Whether a relocation's target is in the image: a live section, a symbol
// defined in one, or an absolute or dynamic symbol.
عرف هدف_إزاحة_إطارات_حي(السياق: &سياق_ربط, المرجع: &مرجع_إزاحة_ربط): منطقي {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(القسم) -> {
        أرجع (القسم.القيمة مثل طبيعي) < (الطول((*السياق).الأقسام) مثل طبيعي)
            && (*السياق).الأقسام[القسم.القيمة].حي;
    }
    | مرجع_إزاحة_ربط.رمز(الرمز) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, الرمز) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة.الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                طابق التعريف.الموضع مع
                | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                    أرجع (القسم.القيمة مثل طبيعي) < (الطول((*السياق).الأقسام) مثل طبيعي)
                        && (*السياق).الأقسام[القسم.القيمة].حي;
                }
                | _ -> { أرجع صواب; };
            }
            | _ -> { أرجع صواب; };
        };
    };
}

// The architectures whose `.eh_frame` relocations the image writer encodes
// (PC-relative 32-bit and absolute words). RISC-V and LoongArch describe
// their advance locations with linker-relaxation pairs (R_RISCV_SET6/SUB6,
// R_LARCH_ADD6/SUB6...) and MIPS64 uses R_MIPS_PC32, none of which the
// static writers implement: their images keep no `.eh_frame`, as before.
عرف إطارات_إلف_مدعومة(المعمارية: هوية_معمارية): منطقي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع صواب; }
    | هوية_معمارية.سيستم_زد -> { أرجع صواب; }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Prunes and merges the inputs' `.eh_frame` (see above). False when an input
// `.eh_frame` is malformed.
عام عرف احتفظ_بإطارات_إلف_الحية(السياق: &متغير سياق_ربط): منطقي {
    ليكن الترتيب: ترتيب_بايت = (*السياق).الهدف.نموذج_البيانات.ترتيب_البايت;
    ليكن مدعومة: منطقي = إطارات_إلف_مدعومة((*السياق).الهدف.المعمارية.الهوية);
    ليكن المقروءة: متغير متجه قسم_إطارات_مقروء = [];
    ليكن فهارس_الأقسام: متغير الخريطة<طبيعي, طبيعي> = أنشئ_الخريطة(هاش_عدد_إطارات, عددان_إطارات_متساويان);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا (قسم_إطارات_إلف(&(*السياق).الأقسام[ف])) {
            // Never a root: its records are kept by the code they describe.
            (*السياق).الأقسام[ف].حي := خطأ;
        };
        إذا (مدعومة && قسم_إطارات_إلف(&(*السياق).الأقسام[ف])) {
            طابق بايتات_قسم_إطارات(السياق, &(*السياق).الأقسام[ف]) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(البايتات) -> {
                طابق سجلات_إطارات_إلف(&البايتات, الترتيب) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(السجلات) -> {
                    ليكن الإزاحات: متجه طبيعي = [];
                    ليكن المقروء: قسم_إطارات_مقروء = {
                        الفهرس: ف, البايتات: البايتات, السجلات: السجلات, الإزاحات: الإزاحات
                    };
                    ليكن أدرج: نتيجة اختياري طبيعي, خطأ_إدراج_الخريطة = أدرج_في_الخريطة(
                        &متغير فهارس_الأقسام, ف, الطول(المقروءة) مثل طبيعي);
                    ألحق(المقروءة, المقروء);
                };
            };
        };
        ف := ف + 1;
    }
    إذا ((الطول(المقروءة) مثل طبيعي) == 0) { أرجع صواب; };
    ف := 0;
    طالما (ف < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        ليكن المصدر: طبيعي = (*السياق).الإزاحات[ف].القسم.القيمة مثل طبيعي;
        طابق ابحث_في_الخريطة(&فهارس_الأقسام, &المصدر) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> { ألحق(المقروءة[الموضع].الإزاحات, ف); };
        ف := ف + 1;
    }

    // Keep the FDEs of live code, their CIEs, and what they reference; what
    // that reaches may be code with FDEs of its own, so repeat until no new
    // section becomes live.
    ليكن تغير: متغير منطقي = صواب;
    طالما (تغير) {
        تغير := خطأ;
        ليكن الجذور_الجديدة: متغير متجه مرجع_إزاحة_ربط = [];
        ليكن ق: متغير طبيعي = 0;
        طالما (ق < (الطول(المقروءة) مثل طبيعي)) {
            ليكن س: متغير طبيعي = 0;
            طالما (س < (الطول(المقروءة[ق].السجلات) مثل طبيعي)) {
                المقروءة[ق].السجلات[س].محتفظ := خطأ;
                س := س + 1;
            }
            // An FDE stays when the relocation of its initial location (at
            // offset 8) reaches live code.
            ليكن ح: متغير طبيعي = 0;
            طالما (ح < (الطول(المقروءة[ق].الإزاحات) مثل طبيعي)) {
                ليكن الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[المقروءة[ق].الإزاحات[ح]];
                طابق سجل_إطارات_للإزاحة(&المقروءة[ق].السجلات, (*الحافة).الإزاحة) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(ر) -> {
                    ليكن السجل: سجل_إطارات_إلف = المقروءة[ق].السجلات[ر];
                    إذا (!السجل.سي_آي_إي && (*الحافة).الإزاحة == السجل.البداية + 8
                        && هدف_إزاحة_إطارات_حي(السياق, &(*الحافة).المرجع)) {
                        المقروءة[ق].السجلات[ر].محتفظ := صواب;
                    };
                };
                ح := ح + 1;
            }
            // The CIE of each kept FDE.
            س := 0;
            طالما (س < (الطول(المقروءة[ق].السجلات) مثل طبيعي)) {
                ليكن السجل: سجل_إطارات_إلف = المقروءة[ق].السجلات[س];
                إذا (السجل.محتفظ && !السجل.سي_آي_إي) {
                    طابق سجل_إطارات_للإزاحة(&المقروءة[ق].السجلات, السجل.بداية_سي_آي_إي) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(ر) -> {
                        إذا (!المقروءة[ق].السجلات[ر].سي_آي_إي
                            || المقروءة[ق].السجلات[ر].البداية != السجل.بداية_سي_آي_إي) {
                            أرجع خطأ;
                        };
                        المقروءة[ق].السجلات[ر].محتفظ := صواب;
                    };
                };
                س := س + 1;
            }
            // A kept record's other references (personality, LSDA) are kept.
            ح := 0;
            طالما (ح < (الطول(المقروءة[ق].الإزاحات) مثل طبيعي)) {
                ليكن الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[المقروءة[ق].الإزاحات[ح]];
                طابق سجل_إطارات_للإزاحة(&المقروءة[ق].السجلات, (*الحافة).الإزاحة) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(ر) -> {
                    ليكن السجل: سجل_إطارات_إلف = المقروءة[ق].السجلات[ر];
                    ليكن بداية_الشفرة: منطقي = !السجل.سي_آي_إي && (*الحافة).الإزاحة == السجل.البداية + 8;
                    إذا (السجل.محتفظ && !بداية_الشفرة
                        && !هدف_إزاحة_إطارات_حي(السياق, &(*الحافة).المرجع)) {
                        ألحق(الجذور_الجديدة, (*الحافة).المرجع);
                        تغير := صواب;
                    };
                };
                ح := ح + 1;
            }
            ق := ق + 1;
        }
        ليكن ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الجذور_الجديدة) مثل طبيعي)) {
            طابق الجذور_الجديدة[ج] مع
            | مرجع_إزاحة_ربط.قسم(القسم) -> { أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, القسم); }
            | مرجع_إزاحة_ربط.رمز(الرمز) -> { أضف_جذر_رمز_ربط(&متغير (*السياق).الوصول, الرمز); };
            ج := ج + 1;
        }
        إذا (تغير) { حل_وصول_سياق_الربط(السياق); };
    }

    // One section of the kept records, in input order.
    ليكن المدمج: متغير متجه ط8 = [];
    ليكن المحاذاة: متغير طبيعي = 4;
    ليكن الأساسي: متغير اختياري طبيعي = اختياري.لا_شيء();
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < (الطول(المقروءة) مثل طبيعي)) {
        ليكن فهرس_القسم: طبيعي = المقروءة[ق].الفهرس;
        إذا ((*السياق).الأقسام[فهرس_القسم].المحاذاة > المحاذاة) {
            المحاذاة := (*السياق).الأقسام[فهرس_القسم].المحاذاة;
        };
        ليكن س: متغير طبيعي = 0;
        طالما (س < (الطول(المقروءة[ق].السجلات) مثل طبيعي)) {
            إذا (المقروءة[ق].السجلات[س].محتفظ) {
                طابق الأساسي مع
                | اختياري.لا_شيء -> { الأساسي := اختياري.موجود(فهرس_القسم); }
                | اختياري.موجود(_) -> { };
                ليكن الجديد: طبيعي = الطول(المدمج) مثل طبيعي;
                المقروءة[ق].السجلات[س].الموضع_الجديد := الجديد;
                ليكن السجل: سجل_إطارات_إلف = المقروءة[ق].السجلات[س];
                ليكن ب: متغير طبيعي = 0;
                طالما (ب < السجل.الحجم) {
                    ألحق(المدمج, المقروءة[ق].البايتات[السجل.البداية + ب]);
                    ب := ب + 1;
                }
                إذا (!السجل.سي_آي_إي) {
                    // The CIE pointer: from this field back to the CIE.
                    طابق سجل_إطارات_للإزاحة(&المقروءة[ق].السجلات, السجل.بداية_سي_آي_إي) مع
                    | اختياري.لا_شيء -> { أرجع خطأ; }
                    | اختياري.موجود(ر) -> {
                        ليكن مكان_سي_آي_إي: طبيعي = المقروءة[ق].السجلات[ر].الموضع_الجديد;
                        ليكن المؤشر: متغير متجه ط8 = [];
                        ألحق_ط32_إطارات(&متغير المؤشر, الجديد + 4 - مكان_سي_آي_إي, الترتيب);
                        ليكن ك: متغير طبيعي = 0;
                        طالما (ك < 4) { المدمج[الجديد + 4 + ك] := المؤشر[ك]; ك := ك + 1; }
                    };
                };
            };
            س := س + 1;
        }
        ق := ق + 1;
    }

    // Relocations move with their records into the merged section; those of
    // dropped records go.
    ليكن الإزاحات_الجديدة: متغير متجه حافة_إزاحة_ربط = [];
    ف := 0;
    طالما (ف < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        ليكن الحافة: حافة_إزاحة_ربط = (*السياق).الإزاحات[ف];
        ليكن المصدر: طبيعي = الحافة.القسم.القيمة مثل طبيعي;
        طابق ابحث_في_الخريطة(&فهارس_الأقسام, &المصدر) مع
        | اختياري.لا_شيء -> { ألحق(الإزاحات_الجديدة, الحافة); }
        | اختياري.موجود(الموضع) -> {
            طابق سجل_إطارات_للإزاحة(&المقروءة[الموضع].السجلات, الحافة.الإزاحة) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ر) -> {
                ليكن السجل: سجل_إطارات_إلف = المقروءة[الموضع].السجلات[ر];
                طابق الأساسي مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الأساس) -> {
                    إذا (السجل.محتفظ) {
                        ليكن المنقولة: حافة_إزاحة_ربط = {
                            القسم: (*السياق).الأقسام[الأساس].المعرف,
                            الإزاحة: السجل.الموضع_الجديد + (الحافة.الإزاحة - السجل.البداية),
                            المرجع: الحافة.المرجع,
                            إضافة: الحافة.إضافة,
                            رمز_صيغة: الحافة.رمز_صيغة
                        };
                        ألحق(الإزاحات_الجديدة, المنقولة);
                    };
                };
            };
        };
        ف := ف + 1;
    }
    (*السياق).الإزاحات := الإزاحات_الجديدة;

    طابق الأساسي مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الأساس) -> {
        // The terminator (ld.bfd's crtend, __FRAME_END__): unwinders that
        // walk the section, not the header's table, stop there.
        ألحق_ط32_إطارات(&متغير المدمج, 0, الترتيب);
        (*السياق).الأقسام[الأساس].الحجم := الطول(المدمج) مثل طبيعي;
        (*السياق).الأقسام[الأساس].المحاذاة := المحاذاة;
        (*السياق).الأقسام[الأساس].المحتوى := اختياري.موجود(المدمج);
        (*السياق).الأقسام[الأساس].حي := صواب;
    };
    أرجع صواب;
}

// ---- .eh_frame_hdr ----

// أ + ب modulo 2^64 (a sign-extended pointer plus its place).
عرف اجمع_التفافا_إطارات(أ: طبيعي, ب: طبيعي): طبيعي {
    إذا (أ > 0xFFFFFFFFFFFFFFFF - ب) { أرجع ب - ((0xFFFFFFFFFFFFFFFF - أ) + 1); };
    أرجع أ + ب;
}

// The low 32 bits of أ - ب, the two's complement of a negative distance.
عام عرف فرق32_إطارات(أ: طبيعي, ب: طبيعي): طبيعي {
    أرجع ((أ & 0xFFFFFFFF) + 0x100000000 - (ب & 0xFFFFFFFF)) & 0xFFFFFFFF;
}

نوع مؤشر_مقروء_إطارات = {
    القيمة: طبيعي,
    الحجم: طبيعي
};

// One table entry: an FDE's initial location and its address.
نوع زوج_جدول_إطارات = {
    الموقع: طبيعي,
    العنوان: طبيعي
};

// A pointer of the DW_EH_PE encoding at الموضع of the image, whose address
// is العنوان: its value and its size, or none for an encoding the table does
// not read (indirect, data-, text- or function-relative, LEB128).
عرف اقرأ_مؤشر_مرمز_إطارات(
    الصورة: &متجه ط8, الموضع: طبيعي, العنوان: طبيعي, الترميز: طبيعي,
    عرض_الكلمة: طبيعي, الترتيب: ترتيب_بايت
): اختياري مؤشر_مقروء_إطارات {
    ليكن الصيغة: طبيعي = الترميز & 0x0F;
    ليكن التطبيق: طبيعي = الترميز & 0x70;
    إذا ((الترميز & 0x80) != 0 || (التطبيق != 0 && التطبيق != 0x10)) { أرجع اختياري.لا_شيء(); };
    ليكن الحجم: متغير طبيعي = 0;
    إذا (الصيغة == 0) { الحجم := عرض_الكلمة; };
    إذا (الصيغة == 2 || الصيغة == 0x0A) { الحجم := 2; };
    إذا (الصيغة == 3 || الصيغة == 0x0B) { الحجم := 4; };
    إذا (الصيغة == 4 || الصيغة == 0x0C) { الحجم := 8; };
    إذا (الحجم == 0 || الموضع + الحجم > (الطول(*الصورة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن القيمة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        ليكن البايت: طبيعي = (*الصورة)[الموضع + ف] مثل طبيعي;
        طابق الترتيب مع
        | ترتيب_بايت.صغير -> { القيمة := القيمة | (البايت << (8 * ف)); }
        | ترتيب_بايت.كبير -> { القيمة := (القيمة << 8) | البايت; };
        ف := ف + 1;
    }
    // Sign-extend the signed forms.
    إذا ((الصيغة & 0x08) != 0 && الحجم < 8) {
        ليكن البت: طبيعي = 1 << (الحجم * 8 - 1);
        إذا ((القيمة & البت) != 0) { القيمة := القيمة | (0xFFFFFFFFFFFFFFFF ^ ((البت << 1) - 1)); };
    };
    إذا (التطبيق == 0x10) { القيمة := اجمع_التفافا_إطارات(القيمة, العنوان); };
    ليكن المقروء: مؤشر_مقروء_إطارات = { القيمة: القيمة, الحجم: الحجم };
    أرجع اختياري.موجود(المقروء);
}

عرف اقرأ_يو_ليب_إطارات(البايتات: &متجه ط8, الموضع: &متغير طبيعي, النهاية: طبيعي): اختياري طبيعي {
    ليكن القيمة: متغير طبيعي = 0;
    ليكن الإزاحة: متغير طبيعي = 0;
    طالما (*الموضع < النهاية) {
        ليكن البايت: طبيعي = (*البايتات)[*الموضع] مثل طبيعي;
        *الموضع := *الموضع + 1;
        إذا (الإزاحة < 64) { القيمة := القيمة | ((البايت & 0x7F) << الإزاحة); };
        الإزاحة := الإزاحة + 7;
        إذا ((البايت & 0x80) == 0) { أرجع اختياري.موجود(القيمة); };
    }
    أرجع اختياري.لا_شيء();
}

// The FDE pointer encoding a CIE gives (its 'R' augmentation; absolute
// pointers without one), or none when the CIE cannot be read.
عرف ترميز_مؤشرات_سي_آي_إي(
    الصورة: &متجه ط8, البداية: طبيعي, الحجم: طبيعي, عرض_الكلمة: طبيعي, الترتيب: ترتيب_بايت
): اختياري طبيعي {
    ليكن النهاية: طبيعي = البداية + الحجم;
    ليكن الموضع: متغير طبيعي = البداية + 8;
    إذا (الموضع >= النهاية) { أرجع اختياري.لا_شيء(); };
    ليكن الإصدار: طبيعي = (*الصورة)[الموضع] مثل طبيعي;
    الموضع := الموضع + 1;
    ليكن بداية_الزيادة: طبيعي = الموضع;
    طالما (الموضع < النهاية && (*الصورة)[الموضع] != 0) { الموضع := الموضع + 1; }
    إذا (الموضع >= النهاية) { أرجع اختياري.لا_شيء(); };
    ليكن نهاية_الزيادة: طبيعي = الموضع;
    الموضع := الموضع + 1;
    إذا (نهاية_الزيادة == بداية_الزيادة) { أرجع اختياري.موجود(0); };
    إذا ((*الصورة)[بداية_الزيادة] != 0x7A) { أرجع اختياري.لا_شيء(); };
    // Code and data alignment factors, then the return address register.
    طابق اقرأ_يو_ليب_إطارات(الصورة, &متغير الموضع, النهاية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    طابق اقرأ_يو_ليب_إطارات(الصورة, &متغير الموضع, النهاية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    إذا (الإصدار == 1) {
        الموضع := الموضع + 1;
    } وإلا {
        طابق اقرأ_يو_ليب_إطارات(الصورة, &متغير الموضع, النهاية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(_) -> { };
    };
    طابق اقرأ_يو_ليب_إطارات(الصورة, &متغير الموضع, النهاية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(_) -> { };
    ليكن ح: متغير طبيعي = بداية_الزيادة + 1;
    طالما (ح < نهاية_الزيادة) {
        إذا (الموضع >= النهاية) { أرجع اختياري.لا_شيء(); };
        ليكن الحرف: ط8 = (*الصورة)[ح];
        إذا (الحرف == 0x52) {
            أرجع اختياري.موجود((*الصورة)[الموضع] مثل طبيعي);
        } وإلا إذا (الحرف == 0x4C) {
            الموضع := الموضع + 1;
        } وإلا إذا (الحرف == 0x50) {
            ليكن ترميز_الشخصية: طبيعي = (*الصورة)[الموضع] مثل طبيعي;
            الموضع := الموضع + 1;
            طابق اقرأ_مؤشر_مرمز_إطارات(الصورة, الموضع, 0, ترميز_الشخصية & 0x0F, عرض_الكلمة, الترتيب) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المقروء) -> { الموضع := الموضع + المقروء.الحجم; };
        } وإلا إذا (الحرف != 0x53 && الحرف != 0x42) {
            أرجع اختياري.لا_شيء();
        };
        ح := ح + 1;
    }
    أرجع اختياري.موجود(0);
}

// The number of FDEs in a merged `.eh_frame` (احتفظ_بإطارات_إلف_الحية).
عام عرف عدد_مداخل_إطارات_إلف(البايتات: &متجه ط8, الترتيب: ترتيب_بايت): طبيعي {
    طابق سجلات_إطارات_إلف(البايتات, الترتيب) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(السجلات) -> {
        ليكن العدد: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(السجلات) مثل طبيعي)) {
            إذا (!السجلات[ف].سي_آي_إي) { العدد := العدد + 1; };
            ف := ف + 1;
        }
        أرجع العدد;
    };
}

// Bottom-up merge sort of (initial location, FDE address) pairs by location.
عرف رتب_جدول_إطارات(الأزواج: &متغير متجه زوج_جدول_إطارات): فراغ {
    ليكن العدد: طبيعي = الطول(*الأزواج) مثل طبيعي;
    ليكن العرض: متغير طبيعي = 1;
    طالما (العرض < العدد) {
        ليكن الناتج: متغير متجه زوج_جدول_إطارات = [];
        ليكن البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            ليكن الوسط: متغير طبيعي = البداية + العرض;
            إذا (الوسط > العدد) { الوسط := العدد; };
            ليكن النهاية: متغير طبيعي = البداية + 2 * العرض;
            إذا (النهاية > العدد) { النهاية := العدد; };
            ليكن أ: متغير طبيعي = البداية;
            ليكن ب: متغير طبيعي = الوسط;
            طالما (أ < الوسط || ب < النهاية) {
                ليكن من_الأول: متغير منطقي = ب >= النهاية;
                إذا (أ < الوسط && ب < النهاية) {
                    من_الأول := (*الأزواج)[أ].الموقع <= (*الأزواج)[ب].الموقع;
                };
                إذا (من_الأول) { ألحق(الناتج, (*الأزواج)[أ]); أ := أ + 1; } وإلا { ألحق(الناتج, (*الأزواج)[ب]); ب := ب + 1; };
            }
            البداية := النهاية;
        }
        *الأزواج := الناتج;
        العرض := العرض * 2;
    }
}

// `.eh_frame_hdr` for the merged `.eh_frame` of the image at موضع_الإطارات
// (file offset) and عنوان_الإطارات, the header to lie at عنوان_الرأس:
// version 1, eh_frame_ptr pcrel|sdata4, fde_count udata4, and the table
// datarel|sdata4 sorted by initial location. Read after relocation, so the
// initial locations are final. None when an FDE's pointer encoding is one
// the table cannot hold.
عام عرف ابن_رأس_إطارات_إلف(
    الصورة: &متجه ط8,
    موضع_الإطارات: طبيعي,
    عنوان_الإطارات: طبيعي,
    حجم_الإطارات: طبيعي,
    عنوان_الرأس: طبيعي,
    عرض_الكلمة: طبيعي,
    الترتيب: ترتيب_بايت
): اختياري متجه ط8 {
    إذا (موضع_الإطارات + حجم_الإطارات > (الطول(*الصورة) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    ليكن الإطارات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < حجم_الإطارات) { ألحق(الإطارات, (*الصورة)[موضع_الإطارات + ف]); ف := ف + 1; }
    ليكن السجلات: متجه سجل_إطارات_إلف;
    طابق سجلات_إطارات_إلف(&الإطارات, الترتيب) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { السجلات := القيمة; };
    ليكن الأزواج: متغير متجه زوج_جدول_إطارات = [];
    ف := 0;
    طالما (ف < (الطول(السجلات) مثل طبيعي)) {
        ليكن السجل: سجل_إطارات_إلف = السجلات[ف];
        إذا (!السجل.سي_آي_إي) {
            ليكن الترميز: طبيعي;
            طابق سجل_إطارات_للإزاحة(&السجلات, السجل.بداية_سي_آي_إي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ر) -> {
                طابق ترميز_مؤشرات_سي_آي_إي(&الإطارات, السجلات[ر].البداية, السجلات[ر].الحجم, عرض_الكلمة, الترتيب) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(القيمة) -> { الترميز := القيمة; };
            };
            طابق اقرأ_مؤشر_مرمز_إطارات(&الإطارات, السجل.البداية + 8, عنوان_الإطارات + السجل.البداية + 8,
                الترميز, عرض_الكلمة, الترتيب) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المقروء) -> {
                ليكن الزوج: زوج_جدول_إطارات = { الموقع: المقروء.القيمة, العنوان: عنوان_الإطارات + السجل.البداية };
                ألحق(الأزواج, الزوج);
            };
        };
        ف := ف + 1;
    }
    رتب_جدول_إطارات(&متغير الأزواج);
    ليكن الرأس: متغير متجه ط8 = [1, 0x1B, 0x03, 0x3B];
    ألحق_ط32_إطارات(&متغير الرأس, فرق32_إطارات(عنوان_الإطارات, عنوان_الرأس + 4), الترتيب);
    ألحق_ط32_إطارات(&متغير الرأس, الطول(الأزواج) مثل طبيعي, الترتيب);
    ف := 0;
    طالما (ف < (الطول(الأزواج) مثل طبيعي)) {
        ألحق_ط32_إطارات(&متغير الرأس, فرق32_إطارات(الأزواج[ف].الموقع, عنوان_الرأس), الترتيب);
        ألحق_ط32_إطارات(&متغير الرأس, فرق32_إطارات(الأزواج[ف].العنوان, عنوان_الرأس), الترتيب);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الرأس);
}
