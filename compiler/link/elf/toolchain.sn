استورد compiler.backend.target.dynamic_link_query_context;
استورد compiler.backend.target.target_model;
استورد compiler.link.model;
استورد compiler.link.elf.target_policy;

عرف انسخ_بايتات_بيانات_أداة_إلف(المصدر: &متجه غ8): متجه غ8 {
    دع النسخة: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(النسخة, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع النسخة;
}

// Internal SultanC ELF finalization currently owns x86_64 and AArch64 system
// images. Other mature system ELF targets delegate their format-specific
// relocation/PLT/TLS work to an explicit linker recorded in LinkPlan.
عام عرف يستخدم_رابط_إلف_الداخلي(الهدف: &واصف_هدف): منطقي {
    لو (!منصة_إلف_نظامية_قابلة_للربط((*الهدف).المنصة.المنصة)) {
        أرجع خطأ;
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// These tools own full system-image semantics for targets where SultanC does
// not yet duplicate the mature target-specific relocation/PLT/TLS machinery.
عام عرف برنامج_رابط_إلف_مفوض_للهدف(
    الهدف: &واصف_هدف
): اختيار نص {
    لو (!منصة_إلف_نظامية_قابلة_للربط((*الهدف).المنصة.المنصة)) {
        أرجع اختيار.لا_شيء();
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.ذراع_سبعة -> { أرجع اختيار.بعض(«ld.lld»); }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.ميبس_أربعة_وستون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.سبارك_أربعة_وستون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.سيستم_زد -> { أرجع اختيار.بعض(«ld.lld»); }
    | هوية_معمارية.في_إي -> { أرجع اختيار.بعض(«nld»); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

// Relocatable/target-module linking must preserve the target's real REL/RELA
// and machine-specific relocation encoding. Delegate that work to mature tools
// instead of making the generic ELF serializer guess an ABI. BPF uses LLD's
// relocatable ELF linker; AVR and MSP430 use their GNU target linkers.
عام عرف برنامج_دمج_كائنات_إلف_مفوض_للهدف(
    الهدف: &واصف_هدف
): اختيار نص {
    طابق برنامج_رابط_إلف_مفوض_للهدف(الهدف) مع
    | اختيار.بعض(البرنامج) -> { أرجع اختيار.بعض(البرنامج); }
    | اختيار.لا_شيء -> { };

    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> {
        أرجع اختيار.بعض(«ld.lld»);
    }
    | هوية_معمارية.هيكساغون -> { أرجع اختيار.بعض(«ld.lld»); }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> {
        أرجع اختيار.بعض(«msp430-ld»);
    }
    | هوية_معمارية.إيه_في_آر -> { أرجع اختيار.بعض(«avr-ld»); }
    | هوية_معمارية.بي_بي_إف -> { أرجع اختيار.بعض(«ld.lld»); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف يدعم_دمج_كائنات_إلف_مفوضا(الهدف: &واصف_هدف): منطقي {
    طابق برنامج_دمج_كائنات_إلف_مفوض_للهدف(الهدف) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف يدعم_رابط_إلف_النظامي(الهدف: &واصف_هدف): منطقي {
    لو (يستخدم_رابط_إلف_الداخلي(الهدف)) { أرجع صواب; };
    طابق برنامج_رابط_إلف_مفوض_للهدف(الهدف) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف ثبت_أداة_إلف_الافتراضية(
    الخطة: &متغير خطة_ربط,
    الهدف: &واصف_هدف
): فراغ {
    دع البرنامج: نص;
    دع اختيار_البرنامج: اختيار نص;
    طابق (*الخطة).الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        اختيار_البرنامج := برنامج_رابط_إلف_مفوض_للهدف(الهدف);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        اختيار_البرنامج := برنامج_رابط_إلف_مفوض_للهدف(الهدف);
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        اختيار_البرنامج := برنامج_دمج_كائنات_إلف_مفوض_للهدف(الهدف);
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        اختيار_البرنامج := برنامج_دمج_كائنات_إلف_مفوض_للهدف(الهدف);
    };
    طابق اختيار_البرنامج مع
    | اختيار.لا_شيء -> { أرجع; }
    | اختيار.بعض(القيمة) -> { البرنامج := القيمة; };

    دع المحمل: متغير اختيار متجه غ8 = اختيار.لا_شيء();
    دع مكتبة_النظام: متغير اختيار متجه غ8 = اختيار.لا_شيء();
    طابق إعداد_ربط_ديناميكي_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الإعداد) -> {
        المحمل := اختيار.بعض(انسخ_بايتات_بيانات_أداة_إلف(&الإعداد.مفسر_إلف));
        مكتبة_النظام := اختيار.بعض(انسخ_بايتات_بيانات_أداة_إلف(&الإعداد.مكتبة_نظام_افتراضية));
    };

    // Mature linkers deliberately do not infer a cross-target sysroot from the
    // host. Search roots therefore remain explicit toolchain facts.
    دع مسارات_البحث: متجه متجه غ8 = [];
    ثبت_أداة_إلف_في_خطة_ربط(
        الخطة,
        البرنامج,
        المحمل,
        مكتبة_النظام,
        مسارات_البحث
    );
}
