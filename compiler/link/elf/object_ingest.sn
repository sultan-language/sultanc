استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.resolution;
استورد compiler.link.elf.names;

عام نوع خطأ_استيعاب_كائن_إلف =
    | كائن_غير_صالح
    | تعريف_رمز_مكرر
    | حل_رمز_يتطلب_سياسة
    | إزاحة_غير_صالحة
;

عام نوع نتيجة_استيعاب_كائن_إلف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_إلف
;

نوع حقيقة_قسم_إلف_مدخل = {
    معرف_الربط: اختيار معرف_قسم_ربط,
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    موضع_الملف: غير_موقع,
    الحجم: غير_موقع,
    المحاذاة: غير_موقع,
    الرابط: غير_موقع,
    المعلومات: غير_موقع,
    حجم_المدخل: غير_موقع
};

نوع حقيقة_رمز_إلف_مدخل = {
    معرف_الربط: اختيار معرف_رمز_ربط,
    فهرس_القسم: غير_موقع,
    القيمة: غير_موقع,
    الحجم: غير_موقع,
    محلي: منطقي
};

عرف ضمن_حدود_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع حجم_الكائن: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > حجم_الكائن) {
        أرجع خطأ;
    };
    أرجع الحجم <= (حجم_الكائن - الموضع);
}

عرف اقرأ_بايت_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غ8 {
    أرجع (*البايتات)[الموضع];
}

عرف اقرأ_غ16_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_الأدنى: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع) مثل غير_موقع;
    دع البايت_الأعلى: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع + 1) مثل غير_موقع;
    أرجع البايت_الأدنى + البايت_الأعلى * 256;
}

عرف اقرأ_غ32_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_صفر: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع) مثل غير_موقع;
    دع البايت_واحد: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع + 1) مثل غير_موقع;
    دع البايت_اثنان: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع + 2) مثل غير_موقع;
    دع البايت_ثلاثة: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, الموضع + 3) مثل غير_موقع;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عرف اقرأ_غ64_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الجزء_الأدنى: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, الموضع);
    دع الجزء_الأعلى: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, الموضع + 4);
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عرف اقرأ_ص64_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار عدد {
    دع الجزء_الأدنى: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, الموضع);
    دع الجزء_الأعلى: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, الموضع + 4);
    لو ((الجزء_الأعلى & 0x80000000) == 0) {
        دع القيمة: غير_موقع = الجزء_الأدنى + الجزء_الأعلى * 4294967296;
        لو (القيمة > 0x7FFFFFFFFFFFFFFF) {
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(القيمة مثل عدد);
    };

    دع معكوس_الأدنى: غير_موقع = 0xFFFFFFFF - الجزء_الأدنى;
    دع معكوس_الأعلى: غير_موقع = 0xFFFFFFFF - الجزء_الأعلى;
    دع مقدار_سالب: غير_موقع = معكوس_الأدنى + معكوس_الأعلى * 4294967296 + 1;
    لو (مقدار_سالب > 0x7FFFFFFFFFFFFFFF) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(-((مقدار_سالب) مثل عدد));
}

عرف اقرأ_اسم_صفري_من_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (الموضع >= النهاية || النهاية > (الطول(*البايتات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = الموضع;
    بينما (فهرس_البايت < النهاية) {
        لو (اقرأ_بايت_كائن_إلف(البايتات, فهرس_البايت) == 0) {
            أرجع اختيار.بعض(الاسم);
        };
        ألحق(الاسم, اقرأ_بايت_كائن_إلف(البايتات, فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_نطاق_كائن_إلف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): متجه غ8 {
    دع المحتوى: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < الحجم) {
        ألحق(المحتوى, اقرأ_بايت_كائن_إلف(البايتات, الموضع + فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع المحتوى;
}

عرف صنف_قسم_إلف_للربط(
    النوع: غير_موقع,
    الأعلام: غير_موقع,
    الاسم: &متجه غ8
): اختيار صنف_قسم_ربط {
    لو (النوع == 8) {
        أرجع اختيار.بعض(صنف_قسم_ربط.بيانات_صفرية());
    };
    لو (النوع != 1) {
        أرجع اختيار.لا_شيء();
    };
    لو ((الأعلام & 4) != 0) {
        أرجع اختيار.بعض(صنف_قسم_ربط.شفرة());
    };
    لو ((الأعلام & 1) != 0) {
        أرجع اختيار.بعض(صنف_قسم_ربط.بيانات_قابلة_للكتابة());
    };
    لو ((الأعلام & 2) != 0) {
        أرجع اختيار.بعض(صنف_قسم_ربط.بيانات_للقراءة());
    };
    لو (هل_اسم_قسم_تصحيح_إلف(الاسم)) {
        أرجع اختيار.بعض(صنف_قسم_ربط.تصحيح());
    };
    أرجع اختيار.بعض(صنف_قسم_ربط.بيانات_تعريفية());
}

عرف حول_نتيجة_تسجيل_رمز_إلف(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_إلف {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_إلف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.حل_رمز_يتطلب_سياسة()
        );
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.تعريف_رمز_مكرر()
            );
        }
        | خطأ_حل_رموز_ربط.سياسة_صيغة_مطلوبة -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عام عرف استوعب_كائن_إلف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_إلف {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!ضمن_حدود_كائن_إلف(البايتات, 0, 64)) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };
    لو (اقرأ_بايت_كائن_إلف(البايتات, 0) != 0x7F
        || اقرأ_بايت_كائن_إلف(البايتات, 1) != 0x45
        || اقرأ_بايت_كائن_إلف(البايتات, 2) != 0x4C
        || اقرأ_بايت_كائن_إلف(البايتات, 3) != 0x46
        || اقرأ_بايت_كائن_إلف(البايتات, 4) != 2
        || اقرأ_بايت_كائن_إلف(البايتات, 5) != 1
        || اقرأ_بايت_كائن_إلف(البايتات, 6) != 1) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };
    لو (اقرأ_غ16_كائن_إلف(البايتات, 16) != 1
        || اقرأ_غ32_كائن_إلف(البايتات, 20) != 1
        || اقرأ_غ16_كائن_إلف(البايتات, 52) != 64
        || اقرأ_غ16_كائن_إلف(البايتات, 58) != 64) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };

    دع موضع_رؤوس_الأقسام: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, 40);
    دع عدد_الأقسام: غير_موقع = اقرأ_غ16_كائن_إلف(البايتات, 60);
    لو (عدد_الأقسام == 0
        || !ضمن_حدود_كائن_إلف(
            البايتات,
            موضع_رؤوس_الأقسام,
            عدد_الأقسام * 64
        )) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };

    دع فهرس_جدول_أسماء_الأقسام: غير_موقع =
        اقرأ_غ16_كائن_إلف(البايتات, 62);
    لو (فهرس_جدول_أسماء_الأقسام >= عدد_الأقسام) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };
    دع موضع_رأس_جدول_أسماء_الأقسام: غير_موقع =
        موضع_رؤوس_الأقسام + فهرس_جدول_أسماء_الأقسام * 64;
    دع نوع_جدول_أسماء_الأقسام: غير_موقع =
        اقرأ_غ32_كائن_إلف(البايتات, موضع_رأس_جدول_أسماء_الأقسام + 4);
    دع موضع_جدول_أسماء_الأقسام: غير_موقع =
        اقرأ_غ64_كائن_إلف(البايتات, موضع_رأس_جدول_أسماء_الأقسام + 24);
    دع حجم_جدول_أسماء_الأقسام: غير_موقع =
        اقرأ_غ64_كائن_إلف(البايتات, موضع_رأس_جدول_أسماء_الأقسام + 32);
    لو (نوع_جدول_أسماء_الأقسام != 3
        || !ضمن_حدود_كائن_إلف(
            البايتات,
            موضع_جدول_أسماء_الأقسام,
            حجم_جدول_أسماء_الأقسام
        )) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_إلف_مدخل = [];
    دع فهرس_قسم_الرموز: متغير غير_موقع = عدد_الأقسام;
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع موضع_الرأس: غير_موقع = موضع_رؤوس_الأقسام + فهرس_القسم * 64;
        دع إزاحة_اسم_القسم: غير_موقع =
            اقرأ_غ32_كائن_إلف(البايتات, موضع_الرأس);
        لو (إزاحة_اسم_القسم >= حجم_جدول_أسماء_الأقسام
            && إزاحة_اسم_القسم != 0) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };
        دع اسم_القسم: متجه غ8;
        طابق اقرأ_اسم_صفري_من_كائن_إلف(
            البايتات,
            موضع_جدول_أسماء_الأقسام + إزاحة_اسم_القسم,
            موضع_جدول_أسماء_الأقسام + حجم_جدول_أسماء_الأقسام
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        }
        | اختيار.بعض(الاسم_المقروء) -> { اسم_القسم := الاسم_المقروء; };
        دع النوع: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, موضع_الرأس + 4);
        دع الأعلام: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرأس + 8);
        دع موضع_الملف: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرأس + 24);
        دع الحجم: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرأس + 32);
        دع الرابط: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, موضع_الرأس + 40);
        دع المعلومات: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, موضع_الرأس + 44);
        دع المحاذاة_الخام: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرأس + 48);
        دع حجم_المدخل: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرأس + 56);
        دع المحاذاة: متغير غير_موقع = المحاذاة_الخام;
        لو (المحاذاة == 0) {
            المحاذاة := 1;
        };

        لو (النوع != 8 && !ضمن_حدود_كائن_إلف(البايتات, موضع_الملف, الحجم)) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };

        دع معرف_قسم_الربط: متغير اختيار معرف_قسم_ربط = اختيار.لا_شيء();
        طابق صنف_قسم_إلف_للربط(النوع, الأعلام, &اسم_القسم) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الصنف) -> {
            دع المحتوى: متغير اختيار متجه غ8 = اختيار.لا_شيء();
            لو (النوع != 8) {
                المحتوى := اختيار.بعض(
                    انسخ_نطاق_كائن_إلف(البايتات, موضع_الملف, الحجم)
                );
            };
            دع هوية_اسم_القسم: هوية_اسم_قسم_ربط = {
                اسم_القسم: اسم_القسم,
                اسم_الحاوية: اختيار.لا_شيء()
            };
            معرف_قسم_الربط := اختيار.بعض(
                أضف_قسم_مدخل_إلى_سياق_الربط(
                    السياق,
                    (*المدخل).المعرف,
                    فهرس_القسم,
                    هوية_اسم_القسم,
                    حقائق_صيغة_قسم_ربط.إلف(النوع, الأعلام),
                    الصنف,
                    المحاذاة,
                    الحجم,
                    المحتوى
                )
            );
        };

        دع حقيقة_القسم: حقيقة_قسم_إلف_مدخل = {
            معرف_الربط: معرف_قسم_الربط,
            النوع: النوع,
            الأعلام: الأعلام,
            موضع_الملف: موضع_الملف,
            الحجم: الحجم,
            المحاذاة: المحاذاة,
            الرابط: الرابط,
            المعلومات: المعلومات,
            حجم_المدخل: حجم_المدخل
        };
        ألحق(حقائق_الأقسام, حقيقة_القسم);
        لو (النوع == 2) {
            لو (فهرس_قسم_الرموز != عدد_الأقسام) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            };
            فهرس_قسم_الرموز := فهرس_القسم;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    لو (فهرس_قسم_الرموز == عدد_الأقسام) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };

    دع قسم_الرموز: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_قسم_الرموز];
    لو (قسم_الرموز.حجم_المدخل != 24
        || (قسم_الرموز.الحجم % 24) != 0
        || قسم_الرموز.الرابط >= عدد_الأقسام) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };
    دع قسم_النصوص: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[قسم_الرموز.الرابط];
    لو (قسم_النصوص.النوع != 3) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(خطأ_استيعاب_كائن_إلف.كائن_غير_صالح());
    };

    دع عدد_الرموز: غير_موقع = قسم_الرموز.الحجم / 24;
    دع حقائق_الرموز: متغير متجه حقيقة_رمز_إلف_مدخل = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: غير_موقع = قسم_الرموز.موضع_الملف + فهرس_الرمز * 24;
        دع إزاحة_الاسم: غير_موقع = اقرأ_غ32_كائن_إلف(البايتات, موضع_الرمز);
        دع معلومات_الرمز: غير_موقع = اقرأ_بايت_كائن_إلف(البايتات, موضع_الرمز + 4) مثل غير_موقع;
        دع ربط_الرمز: غير_موقع = معلومات_الرمز / 16;
        دع فهرس_قسم_الرمز: غير_موقع = اقرأ_غ16_كائن_إلف(البايتات, موضع_الرمز + 6);
        دع قيمة_الرمز: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرمز + 8);
        دع حجم_الرمز: غير_موقع = اقرأ_غ64_كائن_إلف(البايتات, موضع_الرمز + 16);
        دع الرمز_محلي: منطقي = ربط_الرمز == 0;
        دع معرف_الربط: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();

        لو (!الرمز_محلي && إزاحة_الاسم != 0) {
            لو (إزاحة_الاسم >= قسم_النصوص.الحجم) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            };
            دع الاسم: متجه غ8;
            طابق اقرأ_اسم_صفري_من_كائن_إلف(
                البايتات,
                قسم_النصوص.موضع_الملف + إزاحة_الاسم,
                قسم_النصوص.موضع_الملف + قسم_النصوص.الحجم
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            }
            | اختيار.بعض(اسم_مقروء) -> { الاسم := اسم_مقروء; };

            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            لو (فهرس_قسم_الرمز == 0) {
                نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا لو (فهرس_قسم_الرمز == 0xFFF1) {
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو (ربط_الرمز == 2) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    موضع_تعريف_رمز_ربط.مطلق(قيمة_الرمز),
                    حجم_الرمز
                );
            } وإلا {
                لو (فهرس_قسم_الرمز >= عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                    );
                };
                دع قسم_الرمز: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_قسم_الرمز];
                دع معرف_قسم_الربط: معرف_قسم_ربط;
                طابق قسم_الرمز.معرف_الربط مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                    );
                }
                | اختيار.بعض(معرف_القسم) -> { معرف_قسم_الربط := معرف_القسم; };
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو (ربط_الرمز == 2) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    معرف_قسم_الربط,
                    قيمة_الرمز,
                    حجم_الرمز
                );
            };

            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | _ -> {
                أرجع حول_نتيجة_تسجيل_رمز_إلف(نتيجة_التسجيل);
            };
        };

        دع حقيقة_الرمز: حقيقة_رمز_إلف_مدخل = {
            معرف_الربط: معرف_الربط,
            فهرس_القسم: فهرس_قسم_الرمز,
            القيمة: قيمة_الرمز,
            الحجم: حجم_الرمز,
            محلي: الرمز_محلي
        };
        ألحق(حقائق_الرموز, حقيقة_الرمز);
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    فهرس_القسم := 1;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع قسم_الإزاحات: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_القسم];
        لو (قسم_الإزاحات.النوع == 4) {
            لو (قسم_الإزاحات.الرابط != فهرس_قسم_الرموز
                || قسم_الإزاحات.المعلومات >= عدد_الأقسام
                || قسم_الإزاحات.حجم_المدخل != 24
                || (قسم_الإزاحات.الحجم % 24) != 0) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                );
            };
            دع قسم_المصدر: حقيقة_قسم_إلف_مدخل =
                حقائق_الأقسام[قسم_الإزاحات.المعلومات];
            دع معرف_قسم_المصدر: متغير اختيار معرف_قسم_ربط =
                اختيار.لا_شيء();
            دع يوجد_قسم_مصدر: متغير منطقي = خطأ;
            طابق قسم_المصدر.معرف_الربط مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(المعرف) -> {
                معرف_قسم_المصدر := اختيار.بعض(المعرف);
                يوجد_قسم_مصدر := صواب;
            };

            دع عدد_الإزاحات: غير_موقع = قسم_الإزاحات.الحجم / 24;
            دع فهرس_الإزاحة: متغير غير_موقع = 0;
            بينما (
                فهرس_الإزاحة < عدد_الإزاحات
                    && يوجد_قسم_مصدر
            ) {
                دع معرف_المصدر: معرف_قسم_ربط;
                طابق معرف_قسم_المصدر مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                }
                | اختيار.بعض(المعرف) -> { معرف_المصدر := المعرف; };
                دع موضع_الإزاحة: غير_موقع =
                    قسم_الإزاحات.موضع_الملف + فهرس_الإزاحة * 24;
                دع إزاحة_داخل_القسم: غير_موقع =
                    اقرأ_غ64_كائن_إلف(البايتات, موضع_الإزاحة);
                دع معلومات_الإزاحة: غير_موقع =
                    اقرأ_غ64_كائن_إلف(البايتات, موضع_الإزاحة + 8);
                دع فهرس_رمز_الإزاحة: غير_موقع = معلومات_الإزاحة / 4294967296;
                دع رمز_صيغة_الإزاحة: غير_موقع = معلومات_الإزاحة % 4294967296;
                لو (فهرس_رمز_الإزاحة >= عدد_الرموز) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                };
                دع الإضافة: عدد;
                طابق اقرأ_ص64_كائن_إلف(البايتات, موضع_الإزاحة + 16) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                }
                | اختيار.بعض(القيمة) -> { الإضافة := القيمة; };

                دع حقيقة_الرمز: حقيقة_رمز_إلف_مدخل =
                    حقائق_الرموز[فهرس_رمز_الإزاحة];
                دع المرجع: مرجع_إزاحة_ربط;
                دع إضافة_المرجع: متغير عدد = الإضافة;
                طابق حقيقة_الرمز.معرف_الربط مع
                | اختيار.بعض(معرف_الرمز) -> {
                    المرجع := مرجع_إزاحة_ربط.رمز(معرف_الرمز);
                }
                | اختيار.لا_شيء -> {
                    لو (!حقيقة_الرمز.محلي
                        || حقيقة_الرمز.فهرس_القسم >= عدد_الأقسام) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    دع قسم_الهدف: حقيقة_قسم_إلف_مدخل =
                        حقائق_الأقسام[حقيقة_الرمز.فهرس_القسم];
                    طابق قسم_الهدف.معرف_الربط مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    }
                    | اختيار.بعض(معرف_القسم) -> {
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_القسم);
                    };
                    لو (حقيقة_الرمز.القيمة > 0x7FFFFFFFFFFFFFFF) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    إضافة_المرجع := إضافة_المرجع + (حقيقة_الرمز.القيمة مثل عدد);
                };

                دع الحافة: حافة_إزاحة_ربط = {
                    القسم: معرف_المصدر,
                    الإزاحة: إزاحة_داخل_القسم,
                    المرجع: المرجع,
                    إضافة: إضافة_المرجع,
                    رمز_صيغة: رمز_صيغة_الإزاحة
                };
                أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
                فهرس_الإزاحة := فهرس_الإزاحة + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    أرجع نتيجة_استيعاب_كائن_إلف.نجح();
}
