استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.reachability;
استورد compiler.link.resolution;
استورد compiler.link.elf.names;
استورد compiler.link.elf.reader;
استورد compiler.link.elf.target_policy;
استورد compiler.backend.target.target_model;

عام نوع خطأ_استيعاب_كائن_إلف =
    | كائن_غير_صالح
    | تعريف_رمز_مكرر
    | سعة_رموز_غير_قابلة_للتمثيل
    | حل_رمز_يتطلب_سياسة
    | إزاحة_غير_صالحة
;

عام نوع نتيجة_استيعاب_كائن_إلف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_إلف
;

// MOV (8B) and the ALU/TEST forms the executable link relaxes
// (final_image.sn, شفرة_حسابية_جوت_قابلة_للإرخاء_إلف).
عرف شفرة_جوت_بريكس_مقبولة_إلف_مدخل(الشفرة: ط8): منطقي {
    أرجع الشفرة == 0x8B || الشفرة == 0x85 || (الشفرة | 0x38) == 0x3B;
}

نوع حقيقة_قسم_إلف_مدخل = {
    معرف_الربط: اختياري معرف_قسم_ربط,
    النوع: طبيعي,
    الأعلام: طبيعي,
    موضع_الملف: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    الرابط: طبيعي,
    المعلومات: طبيعي,
    حجم_المدخل: طبيعي
};

نوع حقيقة_رمز_إلف_مدخل = {
    معرف_الربط: اختياري معرف_رمز_ربط,
    فهرس_القسم: طبيعي,
    القيمة: طبيعي,
    الحجم: طبيعي,
    محلي: منطقي
};

عرف واصف_إلف_يطابق_الهدف(
    الوصف: &واصف_إلف_مدخل,
    الهدف: &واصف_هدف
): منطقي {
    إذا ((*الوصف).نوع_الملف != 1) { أرجع خطأ; };
    دع السياسة: سياسة_هدف_إلف;
    طابق سياسة_إلف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { السياسة := القيمة; };
    أرجع (*الوصف).الآلة == السياسة.الآلة
        && (*الوصف).الصنف == السياسة.الصنف
        && (*الوصف).الترتيب == السياسة.الترتيب;
}

عرف انسخ_نطاق_إلف_مدخل(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): متجه ط8 {
    دع المحتوى: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < الحجم) {
        دع موضع_البايت: طبيعي = الموضع + الفهرس;
        ألحق(المحتوى, (*البايتات)[موضع_البايت]);
        الفهرس := الفهرس + 1;
    }
    أرجع المحتوى;
}

عرف صنف_قسم_إلف_للربط(
    النوع: طبيعي,
    الأعلام: طبيعي,
    الاسم: &متجه ط8
): اختياري صنف_قسم_ربط {
    إذا (النوع == 0
        || النوع == 2
        || النوع == 3
        || النوع == 4
        || النوع == 9
        || النوع == 11
        || النوع == 17
        || النوع == 18) {
        أرجع اختياري.لا_شيء();
    };
    إذا (النوع == 8) {
        أرجع اختياري.موجود(صنف_قسم_ربط.بيانات_صفرية());
    };
    إذا ((الأعلام & 4) != 0) {
        أرجع اختياري.موجود(صنف_قسم_ربط.شفرة());
    };
    إذا ((الأعلام & 1) != 0) {
        أرجع اختياري.موجود(صنف_قسم_ربط.بيانات_قابلة_للكتابة());
    };
    إذا ((الأعلام & 2) != 0) {
        أرجع اختياري.موجود(صنف_قسم_ربط.بيانات_للقراءة());
    };
    إذا (هل_اسم_قسم_تصحيح_إلف(الاسم)) {
        أرجع اختياري.موجود(صنف_قسم_ربط.تصحيح());
    };
    أرجع اختياري.موجود(صنف_قسم_ربط.بيانات_تعريفية());
}

// ELF section groups (SHT_GROUP = 17; gABI "Section Groups"). The group's
// content is a flags word followed by the member section indices. A group
// flagged GRP_COMDAT (1) is kept once per link: the first group to present
// its signature is kept, and every later group with that signature (in a
// later object or the same one) is discarded with its members, including
// the relocation sections listed in it. Member indices are validated before
// the signature is registered, so a malformed group cannot claim it.
// Identity is the signature alone, held in the canonical per-link registry
// (link/context.sn ثبت_مجموعة_كومدات_في_سياق_الربط), as LLD's
// ObjFile::initializeSections keys SymbolTable::comdatGroups. The signature
// is the name of the symbol at the group's sh_info in its sh_link symbol
// table; for a section symbol, which has no name, it is the name of that
// section, as binutils uses (otherwise every such group would share the
// empty signature). A group without GRP_COMDAT is always kept. Malformed
// group metadata (an unknown flag, a missing or wrong symbol table, an
// unreadable signature) makes the object invalid.
// Previously identity was approximated by "the signature symbol is already
// defined", which discarded a group whose signature named an unrelated
// earlier definition and kept repeated groups whose signature was not a
// global definition (and before that every repeated group was ingested,
// failing on duplicate strong definitions such as __x86.get_pc_thunk.bx).
نوع قرار_مجموعة_إلف = {
    مهملة: منطقي,
    الأعضاء: متجه طبيعي
};

// تالفة: malformed group metadata (the object is invalid); سعة: the COMDAT
// registry could not grow.
نوع نتيجة_مجموعة_إلف =
    | صالحة بنوع قرار_مجموعة_إلف
    | تالفة
    | سعة
;

عرف قرر_مجموعة_إلف(
    السياق: &متغير سياق_ربط,
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل,
    المدخل: معرف_مدخل_ربط,
    فهرس_المجموعة: طبيعي,
    موضع_المحتوى: طبيعي,
    حجم_المحتوى: طبيعي,
    فهرس_جدول_الرموز: طبيعي,
    فهرس_رمز_التوقيع: طبيعي,
    موضع_أسماء_الأقسام: طبيعي,
    حجم_أسماء_الأقسام: طبيعي
): نتيجة_مجموعة_إلف {
    إذا (حجم_المحتوى < 4
        || (حجم_المحتوى % 4) != 0
        || !ضمن_حدود_إلف_مدخل(البايتات, موضع_المحتوى, حجم_المحتوى)) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع الأعلام: طبيعي = اقرأ_ط32_إلف_مدخل(
        البايتات, موضع_المحتوى, (*الوصف).الترتيب
    );
    // GRP_COMDAT is the only flag defined outside the OS/processor masks
    // (GRP_MASKOS 0x0ff00000, GRP_MASKPROC 0xf0000000).
    إذا ((الأعلام & 0x000FFFFE) != 0) { أرجع نتيجة_مجموعة_إلف.تالفة(); };
    دع الأعضاء: متغير متجه طبيعي = [];
    دع الموضع: متغير طبيعي = 4;
    طالما (الموضع < حجم_المحتوى) {
        دع العضو: طبيعي = اقرأ_ط32_إلف_مدخل(
            البايتات, موضع_المحتوى + الموضع, (*الوصف).الترتيب
        );
        // gABI: a group's section header precedes its members, and every
        // member is a section of the object. Checked before the signature is
        // registered, so a malformed group leaves the registry untouched.
        إذا (العضو <= فهرس_المجموعة || العضو >= (*الوصف).عدد_الأقسام) {
            أرجع نتيجة_مجموعة_إلف.تالفة();
        };
        ألحق(الأعضاء, العضو);
        الموضع := الموضع + 4;
    }
    إذا ((الأعلام & 1) == 0) {
        دع محفوظة: قرار_مجموعة_إلف = { مهملة: خطأ, الأعضاء: الأعضاء };
        أرجع نتيجة_مجموعة_إلف.صالحة(محفوظة);
    };
    إذا (فهرس_جدول_الرموز >= (*الوصف).عدد_الأقسام) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع رأس_الرموز: طبيعي = موضع_رأس_قسم_إلف_مدخل(
        الوصف, فهرس_جدول_الرموز
    );
    إذا (حقل_نوع_قسم_إلف_مدخل(البايتات, الوصف, رأس_الرموز) != 2) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع موضع_الرموز: طبيعي = حقل_موضع_قسم_إلف_مدخل(
        البايتات, الوصف, رأس_الرموز
    );
    دع حجم_الرموز: طبيعي = حقل_حجم_قسم_إلف_مدخل(
        البايتات, الوصف, رأس_الرموز
    );
    دع حجم_الرمز: طبيعي = حجم_رمز_إلف_مدخل((*الوصف).الصنف);
    إذا (فهرس_رمز_التوقيع >= حجم_الرموز / حجم_الرمز) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع موضع_الرمز: طبيعي = موضع_الرموز + فهرس_رمز_التوقيع * حجم_الرمز;
    إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_الرمز, حجم_الرمز)) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع فهرس_النصوص: طبيعي = حقل_رابط_قسم_إلف_مدخل(
        البايتات, الوصف, رأس_الرموز
    );
    إذا (فهرس_النصوص >= (*الوصف).عدد_الأقسام) {
        أرجع نتيجة_مجموعة_إلف.تالفة();
    };
    دع رأس_النصوص: طبيعي = موضع_رأس_قسم_إلف_مدخل(الوصف, فهرس_النصوص);
    دع موضع_النصوص: طبيعي = حقل_موضع_قسم_إلف_مدخل(
        البايتات, الوصف, رأس_النصوص
    );
    دع حجم_النصوص: طبيعي = حقل_حجم_قسم_إلف_مدخل(
        البايتات, الوصف, رأس_النصوص
    );
    دع إزاحة_الاسم: طبيعي = حقل_اسم_رمز_إلف_مدخل(
        البايتات, الوصف, موضع_الرمز
    );
    دع التوقيع: متغير متجه ط8 = [];
    إذا (إزاحة_الاسم != 0) {
        إذا (إزاحة_الاسم >= حجم_النصوص) { أرجع نتيجة_مجموعة_إلف.تالفة(); };
        طابق اقرأ_اسم_صفري_إلف_مدخل(
            البايتات,
            موضع_النصوص + إزاحة_الاسم,
            موضع_النصوص + حجم_النصوص
        ) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_مجموعة_إلف.تالفة(); }
        | اختياري.موجود(الاسم) -> { التوقيع := الاسم; };
    };
    دع نوع_الرمز: طبيعي = حقل_معلومات_رمز_إلف_مدخل(
        البايتات, الوصف, موضع_الرمز
    ) & 15;
    إذا ((الطول(التوقيع) مثل طبيعي) == 0 && نوع_الرمز == 3) {
        دع قسم_الرمز: طبيعي = حقل_فهرس_قسم_رمز_إلف_مدخل(
            البايتات, الوصف, موضع_الرمز
        );
        إذا (قسم_الرمز == 0 || قسم_الرمز >= (*الوصف).عدد_الأقسام) {
            أرجع نتيجة_مجموعة_إلف.تالفة();
        };
        دع إزاحة_اسم_القسم: طبيعي = حقل_اسم_قسم_إلف_مدخل(
            البايتات, الوصف, موضع_رأس_قسم_إلف_مدخل(الوصف, قسم_الرمز)
        );
        إذا (إزاحة_اسم_القسم >= حجم_أسماء_الأقسام) { أرجع نتيجة_مجموعة_إلف.تالفة(); };
        طابق اقرأ_اسم_صفري_إلف_مدخل(
            البايتات,
            موضع_أسماء_الأقسام + إزاحة_اسم_القسم,
            موضع_أسماء_الأقسام + حجم_أسماء_الأقسام
        ) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_مجموعة_إلف.تالفة(); }
        | اختياري.موجود(الاسم) -> { التوقيع := الاسم; };
    };
    طابق ثبت_مجموعة_كومدات_في_سياق_الربط(السياق, &التوقيع, المدخل) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة_مجموعة_إلف.سعة(); }
    | نتيجة.نجح(محفوظة) -> {
        دع القرار: قرار_مجموعة_إلف = { مهملة: !محفوظة, الأعضاء: الأعضاء };
        أرجع نتيجة_مجموعة_إلف.صالحة(القرار);
    };
}

// SHN_COMMON (0xFFF2) symbols are tentative definitions: st_value is the
// required alignment and st_size the size. Each becomes a weak definition in
// its own zero-filled `.bss` section (format index فهرس_صيغة_رمز_مشترك_إلف), and
// resolution follows LLD (Symbol::resolve(const CommonSymbol &) and
// Symbol::compare, lld/ELF/Symbols.cpp):
//   * a strong regular definition always wins over a common symbol;
//   * a common symbol replaces a weak regular definition, a shared-library
//     definition and an undefined or lazy reference;
//   * of two common symbols the larger size wins, and the kept one takes the
//     larger of the two alignments;
//   * a later weak regular definition does not replace a common symbol (both
//     are weak, and the table keeps the existing weak definition), while a
//     later strong one does.
// Previously a common symbol made the object invalid; the first P01
// revision kept a weak regular definition over a common symbol and dropped
// the smaller common's alignment when a larger one replaced it.
// The format index of a common symbol's synthetic section: 2^32, which no
// real section index (at most 32 bits with extended numbering) can take.
// SHN_COMMON itself (0xFFF2) can be a real index in an object with extended
// section numbering, so it does not identify these sections.
عرف فهرس_صيغة_رمز_مشترك_إلف(): طبيعي {
    أرجع 0x100000000;
}

عرف قسم_رمز_مشترك_إلف(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): اختياري طبيعي {
    إذا ((القسم.القيمة مثل طبيعي) >= (الطول((*السياق).الأقسام) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    إذا ((*السياق).الأقسام[القسم.القيمة].المعرف.القيمة != القسم.القيمة
        || (*السياق).الأقسام[القسم.القيمة].فهرس_قسم_الصيغة
            != فهرس_صيغة_رمز_مشترك_إلف()) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*السياق).الأقسام[القسم.القيمة].الحجم);
}

عرف سجل_رمزا_مشتركا_إلف(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه ط8,
    المدخل: معرف_مدخل_ربط,
    المحاذاة: طبيعي,
    الحجم: طبيعي
): نتيجة_تسجيل_رمز_ربط {
    دع المحاذاة_الفعلية: متغير طبيعي = المحاذاة;
    إذا (المحاذاة_الفعلية == 0) { المحاذاة_الفعلية := 1; };
    دع معرف_موجود: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            دع قسم_مشترك_سابق: متغير اختياري معرف_قسم_ربط = اختياري.لا_شيء();
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                طابق قسم_رمز_مشترك_إلف(السياق, القسم) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(_) -> { قسم_مشترك_سابق := اختياري.موجود(القسم); };
            }
            | _ -> { };
            طابق قسم_مشترك_سابق مع
            | اختياري.لا_شيء -> {
                إذا (قوة_تعريف_رمز_ربط_قوية(التعريف.القوة)) {
                    أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف);
                };
                // A weak regular definition is replaced by the common.
                معرف_موجود := اختياري.موجود(الرمز.المعرف);
            }
            | اختياري.موجود(القسم_السابق) -> {
                دع الفهرس_السابق: طبيعي = القسم_السابق.القيمة;
                دع محاذاة_سابقة: طبيعي =
                    (*السياق).الأقسام[الفهرس_السابق].المحاذاة;
                إذا ((*السياق).الأقسام[الفهرس_السابق].الحجم >= الحجم) {
                    إذا (المحاذاة_الفعلية > محاذاة_سابقة) {
                        (*السياق).الأقسام[الفهرس_السابق].المحاذاة :=
                            المحاذاة_الفعلية;
                    };
                    أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف);
                };
                إذا (محاذاة_سابقة > المحاذاة_الفعلية) {
                    المحاذاة_الفعلية := محاذاة_سابقة;
                };
                معرف_موجود := اختياري.موجود(الرمز.المعرف);
            };
        }
        | _ -> { };
    };
    دع اسم_القسم: متجه ط8 = [0x2E, 0x62, 0x73, 0x73];
    دع هوية_القسم: هوية_اسم_قسم_ربط = {
        اسم_القسم: اسم_القسم,
        اسم_الحاوية: اختياري.لا_شيء()
    };
    دع القسم: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
        السياق,
        المدخل,
        فهرس_صيغة_رمز_مشترك_إلف(),
        هوية_القسم,
        حقائق_صيغة_قسم_ربط.إلف(8, 3),
        صنف_قسم_ربط.بيانات_صفرية(),
        المحاذاة_الفعلية,
        الحجم,
        اختياري.لا_شيء()
    );
    طابق معرف_موجود مع
    | اختياري.موجود(المعرف) -> {
        // The replaced definition's section stays without a symbol and is
        // dropped by reachability unless something else roots it.
        دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
            المدخل,
            قوة_تعريف_رمز_ربط.ضعيف(),
            موضع_تعريف_رمز_ربط.قسم(القسم, 0),
            الحجم
        );
        (*السياق).الرموز.الرموز[المعرف.القيمة].الحالة :=
            حالة_رمز_ربط.معرف(التعريف);
        (*السياق).الرموز.الرموز[المعرف.القيمة].مستخدم := صواب;
        أرجع نتيجة_تسجيل_رمز_ربط.نجح(المعرف);
    }
    | اختياري.لا_شيء -> { };
    أرجع سجل_تعريف_قسم_رمز_في_سياق_الربط(
        السياق,
        الاسم,
        المدخل,
        قوة_تعريف_رمز_ربط.ضعيف(),
        القسم,
        0,
        الحجم
    );
}

// A kept section may still reference a member of a discarded COMDAT group
// through a local (section) symbol. LLD accepts exactly these cases:
//   * a non-SHF_ALLOC section (DWARF .debug_*): the reference is dead and
//     resolves to a tombstone (InputSection::relocateNonAlloc). The edge is
//     dropped, so the field keeps the object's value: 0 in a RELA object,
//     ld.bfd's tombstone for every section but .debug_ranges/.debug_loc;
//   * `.eh_frame`: LLD's EhFrameSection drops the FDEs of discarded code.
//     SultanC's ELF image copies `.eh_frame` without FDE elimination and so
//     refuses the input rather than emitting an FDE for code that is not in
//     the image. (Previously a link delegated to ld.lld accepted it.)
// Any other allocated reference is LLD's "relocation refers to a discarded
// section" error. Previously every such reference failed ingestion, so a
// debug build linking the same inline function from two objects failed.
عرف إزاحة_إلى_قسم_كومدات_مهمل_مقبولة(
    السياق: &سياق_ربط,
    قسم_المصدر: &حقيقة_قسم_إلف_مدخل
): منطقي {
    إذا (((*قسم_المصدر).الأعلام & 2) == 0) { أرجع صواب; };
    أرجع خطأ;
}

عرف حول_نتيجة_تسجيل_رمز_إلف(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_إلف {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_إلف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.حل_رمز_يتطلب_سياسة()
        );
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.تعريف_رمز_مكرر()
            );
        }
        | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | خطأ_حل_رموز_ربط.سياسة_صيغة_مطلوبة -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عرف اقرأ_إضافة_ريل_إلف(
    السياق: &سياق_ربط,
    قسم_المصدر: &حقيقة_قسم_إلف_مدخل,
    إزاحة_داخل_القسم: طبيعي,
    رمز_الصيغة: طبيعي,
    البايتات: &متجه ط8,
    الوصف: &واصف_إلف_مدخل
): اختياري عدد {
    إذا (إزاحة_داخل_القسم >= (*قسم_المصدر).الحجم) {
        أرجع اختياري.لا_شيء();
    };
    دع موضع_القيمة: طبيعي =
        (*قسم_المصدر).موضع_الملف + إزاحة_داخل_القسم;
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> {
        إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_القيمة, 4)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(
            اقرأ_ص32_إلف_مدخل(البايتات, موضع_القيمة, (*الوصف).الترتيب)
        );
    }
    | هوية_معمارية.ذراع_سبعة -> {
        // R_ARM_NONE and R_ARM_V4BX patch nothing; R_ARM_THM_JUMP11 and
        // R_ARM_THM_JUMP8 patch one halfword: imm11 / imm8, in halfwords.
        إذا (رمز_الصيغة == 0 || رمز_الصيغة == 40) { أرجع اختياري.موجود(0); };
        إذا (رمز_الصيغة == 102 || رمز_الصيغة == 103) {
            إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_القيمة, 2)) {
                أرجع اختياري.لا_شيء();
            };
            دع النصف: طبيعي = اقرأ_ط16_إلف_مدخل(البايتات, موضع_القيمة, (*الوصف).الترتيب);
            دع بتات_الحقل: متغير طبيعي = 11;
            إذا (رمز_الصيغة == 103) { بتات_الحقل := 8; };
            دع الحقل: طبيعي = النصف & ((1 << بتات_الحقل) - 1);
            دع القصير: متغير عدد = (الحقل * 2) مثل عدد;
            إذا ((الحقل >> (بتات_الحقل - 1)) != 0) {
                القصير := القصير - ((1 << (بتات_الحقل + 1)) مثل عدد);
            };
            أرجع اختياري.موجود(القصير);
        };
        إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_القيمة, 4)) {
            أرجع اختياري.لا_شيء();
        };
        دع التعليمة: طبيعي = اقرأ_ط32_إلف_مدخل(
            البايتات,
            موضع_القيمة,
            (*الوصف).الترتيب
        );
        // MOVW/MOVT: imm16, sign-extended (A32 imm4:imm12; Thumb-2
        // imm4:i:imm3:imm8 across the halfwords hw1 | hw2 << 16).
        إذا ((رمز_الصيغة >= 43 && رمز_الصيغة <= 50)) {
            دع الأول: طبيعي = التعليمة & 0xFFFF;
            دع الثاني: طبيعي = التعليمة >> 16;
            دع الفوري: متغير طبيعي = ((التعليمة >> 4) & 0xF000) | (التعليمة & 0xFFF);
            إذا (رمز_الصيغة >= 47) {
                الفوري := ((الأول & 0xF) << 12) | (((الأول >> 10) & 1) << 11)
                    | (((الثاني >> 12) & 7) << 8) | (الثاني & 0xFF);
            };
            دع الموسع: متغير عدد = الفوري مثل عدد;
            إذا ((الفوري & 0x8000) != 0) { الموسع := الموسع - 0x10000; };
            أرجع اختياري.موجود(الموسع);
        };
        // Thumb-2 BL/BLX/B.W (S:I1:I2:imm10:imm11:0, I = !(J ^ S)) and
        // B<c>.W (S:J2:J1:imm6:imm11:0).
        إذا (رمز_الصيغة == 10 || رمز_الصيغة == 30 || رمز_الصيغة == 51) {
            دع الأول: طبيعي = التعليمة & 0xFFFF;
            دع الثاني: طبيعي = التعليمة >> 16;
            دع الإشارة: طبيعي = (الأول >> 10) & 1;
            دع ج1: طبيعي = (الثاني >> 13) & 1;
            دع ج2: طبيعي = (الثاني >> 11) & 1;
            دع الفرع: متغير طبيعي = 0;
            دع البتات: متغير طبيعي = 25;
            إذا (رمز_الصيغة == 51) {
                البتات := 21;
                الفرع := (الإشارة << 20) | (ج2 << 19) | (ج1 << 18)
                    | ((الأول & 0x3F) << 12) | ((الثاني & 0x7FF) << 1);
            } وإلا {
                دع أول_ي: طبيعي = 1 - (ج1 ^ الإشارة);
                دع ثاني_ي: طبيعي = 1 - (ج2 ^ الإشارة);
                الفرع := (الإشارة << 24) | (أول_ي << 23) | (ثاني_ي << 22)
                    | ((الأول & 0x3FF) << 12) | ((الثاني & 0x7FF) << 1);
            };
            دع الموسع: متغير عدد = الفرع مثل عدد;
            إذا (الإشارة != 0) { الموسع := الموسع - ((1 << البتات) مثل عدد); };
            أرجع اختياري.موجود(الموسع);
        };
        إذا (رمز_الصيغة == 1 || رمز_الصيغة == 28 || رمز_الصيغة == 29) {
            دع الخام: طبيعي = التعليمة & 0x00FFFFFF;
            دع المقدار: متغير عدد = (الخام * 4) مثل عدد;
            إذا ((الخام & 0x00800000) != 0) {
                المقدار := المقدار - 0x04000000;
            };
            أرجع اختياري.موجود(المقدار);
        };
        إذا (رمز_الصيغة == 42) {
            دع الخام: طبيعي = التعليمة & 0x7FFFFFFF;
            دع المقدار: متغير عدد = الخام مثل عدد;
            إذا ((الخام & 0x40000000) != 0) {
                المقدار := المقدار - 0x80000000;
            };
            أرجع اختياري.موجود(المقدار);
        };
        أرجع اختياري.موجود(
            اقرأ_ص32_إلف_مدخل(البايتات, موضع_القيمة, (*الوصف).الترتيب)
        );
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        دع العرض: متغير طبيعي = 4;
        إذا (رمز_الصيغة == 1) { العرض := 8; };
        إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_القيمة, العرض)) {
            أرجع اختياري.لا_شيء();
        };
        إذا (العرض == 8) {
            أرجع اقرأ_ص64_إلف_مدخل(
                البايتات, موضع_القيمة, (*الوصف).الترتيب
            );
        };
        // R_X86_64_32 is zero-extended. R_X86_64_32S and PC-relative
        // relocations use a signed implicit addend instead.
        إذا (رمز_الصيغة == 10) {
            أرجع اختياري.موجود(اقرأ_ط32_إلف_مدخل(
                البايتات, موضع_القيمة, (*الوصف).الترتيب
            ) مثل عدد);
        };
        أرجع اختياري.موجود(اقرأ_ص32_إلف_مدخل(
            البايتات, موضع_القيمة, (*الوصف).الترتيب
        ));
    }
    | _ -> {
        دع العرض: متغير طبيعي = 4;
        إذا ((*الوصف).الصنف == صنف_إلف_مدخل.أربعة_وستون()
            && رمز_الصيغة == 1) {
            العرض := 8;
        };
        إذا (!ضمن_حدود_إلف_مدخل(البايتات, موضع_القيمة, العرض)) {
            أرجع اختياري.لا_شيء();
        };
        إذا (العرض == 8) {
            أرجع اقرأ_ص64_إلف_مدخل(
                البايتات,
                موضع_القيمة,
                (*الوصف).الترتيب
            );
        };
        أرجع اختياري.موجود(
            اقرأ_ص32_إلف_مدخل(البايتات, موضع_القيمة, (*الوصف).الترتيب)
        );
    };
}

عام عرف استوعب_كائن_إلف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_إلف {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    دع الوصف: واصف_إلف_مدخل;
    طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    }
    | اختياري.موجود(المقروء) -> { الوصف := المقروء; };
    إذا (!واصف_إلف_يطابق_الهدف(&الوصف, &(*السياق).الهدف)) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };

    دع رأس_جدول_أسماء_الأقسام: طبيعي = موضع_رأس_قسم_إلف_مدخل(
        &الوصف,
        الوصف.فهرس_جدول_أسماء_الأقسام
    );
    إذا (حقل_نوع_قسم_إلف_مدخل(
        البايتات,
        &الوصف,
        رأس_جدول_أسماء_الأقسام
    ) != 3) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };
    دع موضع_جدول_أسماء_الأقسام: طبيعي = حقل_موضع_قسم_إلف_مدخل(
        البايتات,
        &الوصف,
        رأس_جدول_أسماء_الأقسام
    );
    دع حجم_جدول_أسماء_الأقسام: طبيعي = حقل_حجم_قسم_إلف_مدخل(
        البايتات,
        &الوصف,
        رأس_جدول_أسماء_الأقسام
    );
    إذا (!ضمن_حدود_إلف_مدخل(
        البايتات,
        موضع_جدول_أسماء_الأقسام,
        حجم_جدول_أسماء_الأقسام
    )) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_إلف_مدخل = [];
    دع فهرس_قسم_الرموز: متغير طبيعي = الوصف.عدد_الأقسام;
    // Members of a discarded COMDAT group (قرر_مجموعة_إلف).
    // A group header precedes its members in the section header table.
    دع أقسام_مهملة: متغير متجه منطقي = [];
    دع فهرس_التهيئة: متغير طبيعي = 0;
    طالما (فهرس_التهيئة < الوصف.عدد_الأقسام) {
        ألحق(أقسام_مهملة, خطأ);
        فهرس_التهيئة := فهرس_التهيئة + 1;
    }
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < الوصف.عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(&الوصف, فهرس_القسم);
        دع إزاحة_اسم_القسم: طبيعي = حقل_اسم_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        إذا (إزاحة_اسم_القسم >= حجم_جدول_أسماء_الأقسام
            && إزاحة_اسم_القسم != 0) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };
        دع اسم_القسم: متجه ط8;
        طابق اقرأ_اسم_صفري_إلف_مدخل(
            البايتات,
            موضع_جدول_أسماء_الأقسام + إزاحة_اسم_القسم,
            موضع_جدول_أسماء_الأقسام + حجم_جدول_أسماء_الأقسام
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        }
        | اختياري.موجود(الاسم) -> { اسم_القسم := الاسم; };

        دع النوع: طبيعي = حقل_نوع_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع الأعلام: طبيعي = حقل_أعلام_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع موضع_الملف: طبيعي = حقل_موضع_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع الحجم: طبيعي = حقل_حجم_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع الرابط: طبيعي = حقل_رابط_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع المعلومات: طبيعي = حقل_معلومات_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع المحاذاة_الخام: طبيعي = حقل_محاذاة_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع حجم_المدخل: طبيعي = حقل_حجم_مدخل_قسم_إلف_مدخل(
            البايتات,
            &الوصف,
            الرأس
        );
        دع المحاذاة: متغير طبيعي = المحاذاة_الخام;
        إذا (المحاذاة == 0) { المحاذاة := 1; };
        // sh_addralign is 0, 1 or a power of two (the gABI), and at most
        // 2^32 as LLD requires: any other value would make layout round to a
        // non-alignment or overflow the address arithmetic.
        إذا ((المحاذاة & (المحاذاة - 1)) != 0 || المحاذاة > 4294967296) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };
        إذا (النوع != 8 && !ضمن_حدود_إلف_مدخل(البايتات, موضع_الملف, الحجم)) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };

        إذا (النوع == 17 && !أقسام_مهملة[فهرس_القسم]) {
            طابق قرر_مجموعة_إلف(
                السياق, البايتات, &الوصف, (*المدخل).المعرف, فهرس_القسم,
                موضع_الملف, الحجم, الرابط, المعلومات,
                موضع_جدول_أسماء_الأقسام, حجم_جدول_أسماء_الأقسام
            ) مع
            | نتيجة_مجموعة_إلف.تالفة -> {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            }
            | نتيجة_مجموعة_إلف.سعة -> {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.سعة_رموز_غير_قابلة_للتمثيل()
                );
            }
            | نتيجة_مجموعة_إلف.صالحة(القرار) -> {
                إذا (القرار.مهملة) {
                    دع فهرس_العضو: متغير طبيعي = 0;
                    طالما (فهرس_العضو < (الطول(القرار.الأعضاء) مثل طبيعي)) {
                        أقسام_مهملة[القرار.الأعضاء[فهرس_العضو]] := صواب;
                        فهرس_العضو := فهرس_العضو + 1;
                    }
                };
            };
        };
        دع معرف_قسم_الربط: متغير اختياري معرف_قسم_ربط = اختياري.لا_شيء();
        دع صنف_الربط: متغير اختياري صنف_قسم_ربط = اختياري.لا_شيء();
        إذا (!أقسام_مهملة[فهرس_القسم]) {
            صنف_الربط := صنف_قسم_إلف_للربط(النوع, الأعلام, &اسم_القسم);
        };
        طابق صنف_الربط مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الصنف) -> {
            // Keep the validated file view (input id, section index and size)
            // in the canonical section; only reachable sections need bytes.
            دع المحتوى: اختياري متجه ط8 = اختياري.لا_شيء();
            دع هوية_اسم_القسم: هوية_اسم_قسم_ربط = {
                اسم_القسم: اسم_القسم,
                اسم_الحاوية: اختياري.لا_شيء()
            };
            معرف_قسم_الربط := اختياري.موجود(
                أضف_قسم_مدخل_إلى_سياق_الربط(
                    السياق,
                    (*المدخل).المعرف,
                    فهرس_القسم,
                    هوية_اسم_القسم,
                    حقائق_صيغة_قسم_ربط.إلف(النوع, الأعلام),
                    الصنف,
                    المحاذاة,
                    الحجم,
                    المحتوى
                )
            );
            // SHT_INIT_ARRAY is a loader-root, even if no ordinary code calls
            // the initializer directly. Keep its relocation target reachable.
            إذا (النوع == 14) {
                طابق معرف_قسم_الربط مع
                | اختياري.موجود(المعرف) -> {
                    أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, المعرف);
                }
                | اختياري.لا_شيء -> { };
            };
        };

        دع حقيقة_القسم: حقيقة_قسم_إلف_مدخل = {
            معرف_الربط: معرف_قسم_الربط,
            النوع: النوع,
            الأعلام: الأعلام,
            موضع_الملف: موضع_الملف,
            الحجم: الحجم,
            المحاذاة: المحاذاة,
            الرابط: الرابط,
            المعلومات: المعلومات,
            حجم_المدخل: حجم_المدخل
        };
        ألحق(حقائق_الأقسام, حقيقة_القسم);
        إذا (النوع == 2) {
            إذا (فهرس_قسم_الرموز != الوصف.عدد_الأقسام) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            };
            فهرس_قسم_الرموز := فهرس_القسم;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    إذا (فهرس_قسم_الرموز == الوصف.عدد_الأقسام) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };
    دع قسم_الرموز: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_قسم_الرموز];
    دع حجم_الرمز: طبيعي = حجم_رمز_إلف_مدخل(الوصف.الصنف);
    إذا (قسم_الرموز.حجم_المدخل != حجم_الرمز
        || (قسم_الرموز.الحجم % حجم_الرمز) != 0
        || قسم_الرموز.الرابط >= الوصف.عدد_الأقسام) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };
    دع قسم_النصوص: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[قسم_الرموز.الرابط];
    إذا (قسم_النصوص.النوع != 3) {
        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
            خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
        );
    };

    دع عدد_الرموز: طبيعي = قسم_الرموز.الحجم / حجم_الرمز;
    // Extended section indices (gABI SHT_SYMTAB_SHNDX = 18): with 65280 or
    // more sections a symbol's st_shndx is SHN_XINDEX (0xFFFF) and its real
    // section index is the 32-bit entry at the same position of the
    // SHT_SYMTAB_SHNDX section linked to the symbol table (LLVM
    // object::getExtendedSymbolTableIndex). Previously such a symbol was
    // rejected as naming a section beyond the table.
    دع موضع_الفهارس_الممتدة: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع فهرس_البحث_الممتد: متغير طبيعي = 1;
    طالما (فهرس_البحث_الممتد < الوصف.عدد_الأقسام) {
        دع قسم_ممتد: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_البحث_الممتد];
        إذا (قسم_ممتد.النوع == 18 && قسم_ممتد.الرابط == فهرس_قسم_الرموز) {
            إذا (قسم_ممتد.الحجم / 4 < عدد_الرموز
                || !ضمن_حدود_إلف_مدخل(البايتات, قسم_ممتد.موضع_الملف, قسم_ممتد.الحجم)) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            };
            موضع_الفهارس_الممتدة := اختياري.موجود(قسم_ممتد.موضع_الملف);
        };
        فهرس_البحث_الممتد := فهرس_البحث_الممتد + 1;
    }
    دع حقائق_الرموز: متغير متجه حقيقة_رمز_إلف_مدخل = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: طبيعي =
            قسم_الرموز.موضع_الملف + فهرس_الرمز * حجم_الرمز;
        دع إزاحة_الاسم: طبيعي = حقل_اسم_رمز_إلف_مدخل(
            البايتات,
            &الوصف,
            موضع_الرمز
        );
        دع معلومات_الرمز: طبيعي = حقل_معلومات_رمز_إلف_مدخل(
            البايتات,
            &الوصف,
            موضع_الرمز
        );
        دع ربط_الرمز: طبيعي = معلومات_الرمز / 16;
        دع فهرس_قسم_الرمز: متغير طبيعي = حقل_فهرس_قسم_رمز_إلف_مدخل(
            البايتات,
            &الوصف,
            موضع_الرمز
        );
        دع فهرس_ممتد: منطقي = فهرس_قسم_الرمز == 0xFFFF;
        // Other reserved indices (SHN_LORESERVE 0xFF00 and above) are only
        // SHN_ABS and SHN_COMMON here; they never name a section.
        إذا (!فهرس_ممتد && فهرس_قسم_الرمز >= 0xFF00
            && فهرس_قسم_الرمز != 0xFFF1 && فهرس_قسم_الرمز != 0xFFF2) {
            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
            );
        };
        إذا (فهرس_ممتد) {
            طابق موضع_الفهارس_الممتدة مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            }
            | اختياري.موجود(موضع_الجدول) -> {
                فهرس_قسم_الرمز := اقرأ_ط32_إلف_مدخل(
                    البايتات,
                    موضع_الجدول + فهرس_الرمز * 4,
                    الوصف.الترتيب
                );
                // An extended index names a real section, never a
                // reserved value such as SHN_ABS or SHN_COMMON.
                إذا (فهرس_قسم_الرمز == 0 || فهرس_قسم_الرمز >= الوصف.عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                    );
                };
            };
        };
        دع قيمة_الرمز: طبيعي = حقل_قيمة_رمز_إلف_مدخل(
            البايتات,
            &الوصف,
            موضع_الرمز
        );
        دع حجم_قيمة_الرمز: طبيعي = حقل_حجم_رمز_إلف_مدخل(
            البايتات,
            &الوصف,
            موضع_الرمز
        );
        دع الرمز_محلي: منطقي = ربط_الرمز == 0;
        دع معرف_الربط: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();

        إذا (!الرمز_محلي && إزاحة_الاسم != 0) {
            إذا (إزاحة_الاسم >= قسم_النصوص.الحجم) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            };
            دع الاسم: متجه ط8;
            طابق اقرأ_اسم_صفري_إلف_مدخل(
                البايتات,
                قسم_النصوص.موضع_الملف + إزاحة_الاسم,
                قسم_النصوص.موضع_الملف + قسم_النصوص.الحجم
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                );
            }
            | اختياري.موجود(الاسم_المقروء) -> { الاسم := الاسم_المقروء; };

            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            إذا (فهرس_قسم_الرمز == 0 && ربط_الرمز == 2) {
                // STB_WEAK undefined: never extracts an archive member and
                // is zero when nothing defines it (link/context.sn
                // مراجع_رمز_ربط), as in LLD.
                نتيجة_التسجيل := سجل_مرجعا_ضعيفا_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا إذا (فهرس_قسم_الرمز == 0) {
                نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا إذا (!فهرس_ممتد && فهرس_قسم_الرمز == 0xFFF2) {
                نتيجة_التسجيل := سجل_رمزا_مشتركا_إلف(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    قيمة_الرمز,
                    حجم_قيمة_الرمز
                );
            } وإلا إذا (فهرس_قسم_الرمز < الوصف.عدد_الأقسام
                && أقسام_مهملة[فهرس_قسم_الرمز]) {
                // Defined in a discarded COMDAT member: the kept group's
                // definition is the one the link uses.
                طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
                | اختياري.موجود(الموجود) -> {
                    نتيجة_التسجيل := نتيجة_تسجيل_رمز_ربط.نجح(الموجود.المعرف);
                }
                | اختياري.لا_شيء -> {
                    نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                        السياق,
                        &الاسم,
                        (*المدخل).المعرف
                    );
                };
            } وإلا إذا (!فهرس_ممتد && فهرس_قسم_الرمز == 0xFFF1) {
                دع القوة: متغير قوة_تعريف_رمز_ربط =
                    قوة_تعريف_رمز_ربط.قوي();
                إذا (ربط_الرمز == 2) { القوة := قوة_تعريف_رمز_ربط.ضعيف(); };
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    موضع_تعريف_رمز_ربط.مطلق(قيمة_الرمز),
                    حجم_قيمة_الرمز
                );
            } وإلا {
                إذا (فهرس_قسم_الرمز >= الوصف.عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                    );
                };
                دع قسم_الرمز: حقيقة_قسم_إلف_مدخل =
                    حقائق_الأقسام[فهرس_قسم_الرمز];
                دع معرف_قسم_الربط: معرف_قسم_ربط;
                طابق قسم_الرمز.معرف_الربط مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.كائن_غير_صالح()
                    );
                }
                | اختياري.موجود(المعرف) -> { معرف_قسم_الربط := المعرف; };
                دع القوة: متغير قوة_تعريف_رمز_ربط =
                    قوة_تعريف_رمز_ربط.قوي();
                إذا (ربط_الرمز == 2) { القوة := قوة_تعريف_رمز_ربط.ضعيف(); };
                نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    معرف_قسم_الربط,
                    قيمة_الرمز,
                    حجم_قيمة_الرمز
                );
            };
            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختياري.موجود(المعرف);
            }
            | _ -> { أرجع حول_نتيجة_تسجيل_رمز_إلف(نتيجة_التسجيل); };
        };

        // A reserved index (SHN_ABS, SHN_COMMON) is recorded as one past the
        // last section, so a relocation through such a local symbol cannot
        // be taken for a reference to a real section with the same number.
        دع فهرس_قسم_الحقيقة: متغير طبيعي = فهرس_قسم_الرمز;
        إذا (!فهرس_ممتد && فهرس_قسم_الرمز >= 0xFF00) {
            فهرس_قسم_الحقيقة := الوصف.عدد_الأقسام;
        };
        دع حقيقة_الرمز: حقيقة_رمز_إلف_مدخل = {
            معرف_الربط: معرف_الربط,
            فهرس_القسم: فهرس_قسم_الحقيقة,
            القيمة: قيمة_الرمز,
            الحجم: حجم_قيمة_الرمز,
            محلي: الرمز_محلي
        };
        ألحق(حقائق_الرموز, حقيقة_الرمز);
        // PowerPC 64 ELFv2 local entry (st_other bits 7:5, STO_PPC64_LOCAL):
        // 2..6 put it (1 << v) >> 2 instructions past the global entry.
        إذا (الوصف.الآلة == 21 && (معلومات_الرمز % 16) == 2
            && فهرس_قسم_الحقيقة < الوصف.عدد_الأقسام && فهرس_قسم_الحقيقة != 0) {
            دع الرتبة: طبيعي = (بايت_رمز_إلف_آخر(البايتات, &الوصف, موضع_الرمز) >> 5) & 7;
            إذا (الرتبة >= 2 && الرتبة <= 6) {
                طابق حقائق_الأقسام[فهرس_قسم_الحقيقة].معرف_الربط مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(معرف_قسم_الدخول) -> {
                    دع الدخول: دخول_محلي_ربط = {
                        القسم: معرف_قسم_الدخول,
                        الإزاحة: قيمة_الرمز,
                        الفرق: ((1 << الرتبة) >> 2) * 4
                    };
                    ألحق((*السياق).مداخل_محلية, الدخول);
                };
            };
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    فهرس_القسم := 1;
    طالما (فهرس_القسم < الوصف.عدد_الأقسام) {
        دع قسم_الإزاحات: حقيقة_قسم_إلف_مدخل = حقائق_الأقسام[فهرس_القسم];
        إذا (قسم_الإزاحات.النوع == 4 || قسم_الإزاحات.النوع == 9) {
            دع ريلا: منطقي = قسم_الإزاحات.النوع == 4;
            دع حجم_إدخال_الإزاحة: متغير طبيعي =
                حجم_ريل_إلف_مدخل(الوصف.الصنف);
            إذا (ريلا) {
                حجم_إدخال_الإزاحة := حجم_ريلا_إلف_مدخل(الوصف.الصنف);
            };
            إذا (قسم_الإزاحات.الرابط != فهرس_قسم_الرموز
                || قسم_الإزاحات.المعلومات >= الوصف.عدد_الأقسام
                || قسم_الإزاحات.حجم_المدخل != حجم_إدخال_الإزاحة
                || (قسم_الإزاحات.الحجم % حجم_إدخال_الإزاحة) != 0) {
                أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                    خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                );
            };
            دع قسم_المصدر: حقيقة_قسم_إلف_مدخل =
                حقائق_الأقسام[قسم_الإزاحات.المعلومات];
            دع معرف_قسم_المصدر: متغير اختياري معرف_قسم_ربط =
                اختياري.لا_شيء();
            دع يوجد_قسم_مصدر: متغير منطقي = خطأ;
            طابق قسم_المصدر.معرف_الربط مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المعرف) -> {
                معرف_قسم_المصدر := اختياري.موجود(المعرف);
                يوجد_قسم_مصدر := صواب;
            };

            دع عدد_الإزاحات: طبيعي =
                قسم_الإزاحات.الحجم / حجم_إدخال_الإزاحة;
            دع فهرس_الإزاحة: متغير طبيعي = 0;
            طالما (
                فهرس_الإزاحة < عدد_الإزاحات
                    && يوجد_قسم_مصدر
            ) {
                دع معرف_المصدر: معرف_قسم_ربط;
                طابق معرف_قسم_المصدر مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                }
                | اختياري.موجود(المعرف) -> { معرف_المصدر := المعرف; };
                دع موضع_الإزاحة: طبيعي = قسم_الإزاحات.موضع_الملف
                    + فهرس_الإزاحة * حجم_إدخال_الإزاحة;
                دع إزاحة_داخل_القسم: طبيعي;
                دع معلومات_الإزاحة: طبيعي;
                طابق الوصف.الصنف مع
                | صنف_إلف_مدخل.اثنان_وثلاثون -> {
                    إزاحة_داخل_القسم := اقرأ_ط32_إلف_مدخل(
                        البايتات,
                        موضع_الإزاحة,
                        الوصف.الترتيب
                    );
                    معلومات_الإزاحة := اقرأ_ط32_إلف_مدخل(
                        البايتات,
                        موضع_الإزاحة + 4,
                        الوصف.الترتيب
                    );
                }
                | صنف_إلف_مدخل.أربعة_وستون -> {
                    إزاحة_داخل_القسم := اقرأ_ط64_إلف_مدخل(
                        البايتات,
                        موضع_الإزاحة,
                        الوصف.الترتيب
                    );
                    معلومات_الإزاحة := اقرأ_ط64_إلف_مدخل(
                        البايتات,
                        موضع_الإزاحة + 8,
                        الوصف.الترتيب
                    );
                };
                دع معلومات: معلومات_إزاحة_إلف_مدخل =
                    فك_معلومات_إزاحة_إلف_مدخل(
                        معلومات_الإزاحة,
                        &الوصف
                    );
                إذا (معلومات.فهرس_الرمز >= عدد_الرموز) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                };
                // Reject out-of-section relocation fields before recording an
                // edge. External x86-64 ELF objects may use REL or RELA.
                دع عرض_الرقعة: متغير طبيعي = 0;
                إذا (الوصف.الآلة == 62) {
                    إذا (معلومات.رمز_الصيغة == 1) {
                        عرض_الرقعة := 8;
                    } وإلا إذا (معلومات.رمز_الصيغة == 2
                        || معلومات.رمز_الصيغة == 4
                        || معلومات.رمز_الصيغة == 9
                        || معلومات.رمز_الصيغة == 10
                        || معلومات.رمز_الصيغة == 11
                        || معلومات.رمز_الصيغة == 41
                        || معلومات.رمز_الصيغة == 42) {
                        عرض_الرقعة := 4;
                    };
                };
                إذا (إزاحة_داخل_القسم > قسم_المصدر.الحجم
                    || عرض_الرقعة > قسم_المصدر.الحجم - إزاحة_داخل_القسم) {
                    أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                        خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                    );
                };
                // R_X86_64_REX_GOTPCRELX denotes a relaxable 64-bit
                // RIP-relative MOV, or an ALU/TEST instruction reading the
                // GOT slot (the forms GNU ld relaxes to an immediate). Do not
                // mistake another instruction for a GOT reference.
                إذا (الوصف.الآلة == 62 && معلومات.رمز_الصيغة == 42) {
                    إذا (إزاحة_داخل_القسم < 3
                        || قسم_المصدر.موضع_الملف >
                            0xFFFFFFFFFFFFFFFF - إزاحة_داخل_القسم
                        || !ضمن_حدود_إلف_مدخل(
                            البايتات,
                            قسم_المصدر.موضع_الملف + إزاحة_داخل_القسم - 3,
                            7
                        )) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    دع موضع_الرقعة: طبيعي =
                        قسم_المصدر.موضع_الملف + إزاحة_داخل_القسم;
                    إذا (((*البايتات)[موضع_الرقعة - 3] & 0xF8) != 0x48
                        || !شفرة_جوت_بريكس_مقبولة_إلف_مدخل(
                            (*البايتات)[موضع_الرقعة - 2]
                        )
                        || ((*البايتات)[موضع_الرقعة - 1] & 0xC7) != 0x05) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                };
                دع الإضافة: عدد;
                إذا (ريلا) {
                    طابق الوصف.الصنف مع
                    | صنف_إلف_مدخل.اثنان_وثلاثون -> {
                        الإضافة := اقرأ_ص32_إلف_مدخل(
                            البايتات,
                            موضع_الإزاحة + 8,
                            الوصف.الترتيب
                        );
                    }
                    | صنف_إلف_مدخل.أربعة_وستون -> {
                        طابق اقرأ_ص64_إلف_مدخل(
                            البايتات,
                            موضع_الإزاحة + 16,
                            الوصف.الترتيب
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                                خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                            );
                        }
                        | اختياري.موجود(القيمة) -> { الإضافة := القيمة; };
                    };
                } وإلا {
                    طابق اقرأ_إضافة_ريل_إلف(
                        السياق,
                        &قسم_المصدر,
                        إزاحة_داخل_القسم,
                        معلومات.رمز_الصيغة,
                        البايتات,
                        &الوصف
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { الإضافة := القيمة; };
                };

                دع حقيقة_الرمز: حقيقة_رمز_إلف_مدخل =
                    حقائق_الرموز[معلومات.فهرس_الرمز];
                دع المرجع: مرجع_إزاحة_ربط;
                دع مرجع_مهمل: متغير منطقي = خطأ;
                دع إضافة_المرجع: متغير عدد = الإضافة;
                طابق حقيقة_الرمز.معرف_الربط مع
                | اختياري.موجود(معرف_الرمز) -> {
                    المرجع := مرجع_إزاحة_ربط.رمز(معرف_الرمز);
                }
                | اختياري.لا_شيء -> {
                    إذا (!حقيقة_الرمز.محلي
                        || حقيقة_الرمز.فهرس_القسم >= الوصف.عدد_الأقسام) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    دع قسم_الهدف: حقيقة_قسم_إلف_مدخل =
                        حقائق_الأقسام[حقيقة_الرمز.فهرس_القسم];
                    طابق قسم_الهدف.معرف_الربط مع
                    | اختياري.لا_شيء -> {
                        إذا (!أقسام_مهملة[حقيقة_الرمز.فهرس_القسم]
                            || !إزاحة_إلى_قسم_كومدات_مهمل_مقبولة(
                                السياق,
                                &قسم_المصدر
                            )) {
                            أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                                خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                            );
                        };
                        // A dead reference into a discarded group member.
                        مرجع_مهمل := صواب;
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_المصدر);
                    }
                    | اختياري.موجود(معرف_القسم) -> {
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_القسم);
                    };
                    إذا (حقيقة_الرمز.القيمة > 0x7FFFFFFFFFFFFFFF) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    // Local symbol offsets become relocation addends; do
                    // not allow the signed graph addend to wrap on input.
                    إذا (إضافة_المرجع > 0
                        && حقيقة_الرمز.القيمة >
                            0x7FFFFFFFFFFFFFFF - (إضافة_المرجع مثل طبيعي)) {
                        أرجع نتيجة_استيعاب_كائن_إلف.خطأ(
                            خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة()
                        );
                    };
                    إضافة_المرجع := إضافة_المرجع
                        + (حقيقة_الرمز.القيمة مثل عدد);
                };

                إذا (!مرجع_مهمل) {
                    دع الحافة: حافة_إزاحة_ربط = {
                        القسم: معرف_المصدر,
                        الإزاحة: إزاحة_داخل_القسم,
                        المرجع: المرجع,
                        إضافة: إضافة_المرجع,
                        رمز_صيغة: معلومات.رمز_الصيغة
                    };
                    أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
                };
                فهرس_الإزاحة := فهرس_الإزاحة + 1;
            }
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    أرجع نتيجة_استيعاب_كائن_إلف.نجح();
}

// The input byte vector remains owned by the link plan through final output.
// Section headers were validated by ingestion; re-read their bounds here,
// rather than retaining a second payload copy for every discarded section.
عام عرف جهز_حمولات_أقسام_إلف_الحية(
    السياق: &متغير سياق_ربط
): منطقي {
    دع فهرس: متغير طبيعي = 0;
    طالما (فهرس < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس].حي) {
            دع نوع_القسم: متغير طبيعي = 8;
            طابق (*السياق).الأقسام[فهرس].حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.إلف(النوع, _) -> { نوع_القسم := النوع; }
            | _ -> { };
            إذا (نوع_القسم != 8) {
                دع معرف_المدخل: طبيعي =
                    (*السياق).الأقسام[فهرس].المدخل.القيمة;
                إذا (معرف_المدخل >= (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
                    أرجع خطأ;
                };
                دع البايتات: &متجه ط8 =
                    &(*السياق).الخطة.المدخلات[معرف_المدخل].البايتات;
                دع الوصف: واصف_إلف_مدخل;
                طابق اقرأ_واصف_إلف_مدخل(البايتات) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { الوصف := القيمة; };
                دع فهرس_الصيغة: طبيعي =
                    (*السياق).الأقسام[فهرس].فهرس_قسم_الصيغة;
                إذا (فهرس_الصيغة >= الوصف.عدد_الأقسام) { أرجع خطأ; };
                دع الرأس: طبيعي = موضع_رأس_قسم_إلف_مدخل(
                    &الوصف, فهرس_الصيغة
                );
                دع الموضع: طبيعي = حقل_موضع_قسم_إلف_مدخل(
                    البايتات, &الوصف, الرأس
                );
                دع الحجم: طبيعي = حقل_حجم_قسم_إلف_مدخل(
                    البايتات, &الوصف, الرأس
                );
                إذا (الحجم != (*السياق).الأقسام[فهرس].الحجم
                    || !ضمن_حدود_إلف_مدخل(البايتات, الموضع, الحجم)) {
                    أرجع خطأ;
                };
                // Executable relocations patch the final image, not a section
                // buffer. Keep the validated input range borrowed until that
                // image is written; the relocatable writer still needs owned
                // section contents because it serializes them separately.
                إذا ((*السياق).الخطة.الخرج != نوع_خرج_ربط.تنفيذي()) {
                    دع المحتوى: متجه ط8 = انسخ_نطاق_إلف_مدخل(
                        البايتات, الموضع, الحجم
                    );
                    (*السياق).الأقسام[فهرس].المحتوى := اختياري.موجود(المحتوى);
                };
            };
        };
        فهرس := فهرس + 1;
    }
    أرجع صواب;
}
