استورد compiler.backend.target.target_model;

// ELF executable serialization helpers owned by the linker. Relocatable-object
// serialization remains under compiler/backend/object.

عام عرف حاذ_قيمة_إلف(
    القيمة: غير_موقع,
    المحاذاة: غير_موقع
): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عام عرف ألحق_بايت_إلف(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق(*البايتات, (القيمة & 0xFF) مثل غ8);
}

عام عرف ألحق_غ16_إلف_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق_بايت_إلف(البايتات, القيمة);
    ألحق_بايت_إلف(البايتات, القيمة / 256);
}

عام عرف ألحق_غ32_إلف_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < 4) {
        دع القاسم: غير_موقع = 1 << (فهرس_البايت * 8);
        ألحق_بايت_إلف(البايتات, القيمة / القاسم);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف ألحق_غ64_إلف_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    دع الجزء_الأدنى: غير_موقع = القيمة & 0xFFFFFFFF;
    دع الجزء_الأعلى: غير_موقع = القيمة / 4294967296;
    ألحق_غ32_إلف_ربط(البايتات, الجزء_الأدنى);
    ألحق_غ32_إلف_ربط(البايتات, الجزء_الأعلى);
}

عام عرف ألحق_أصفارا_إلف_ربط(
    البايتات: &متغير متجه غ8,
    العدد: غير_موقع
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        ألحق(*البايتات, 0);
        الفهرس := الفهرس + 1;
    }
}

عام عرف ألحق_بايتات_إلف_ربط(
    الناتج: &متغير متجه غ8,
    المصدر: &متجه غ8
): فراغ {
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(*الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف اكتب_بايتات_إلف_ربط_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: &متجه غ8
): منطقي {
    دع حجم_المصدر: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع النهاية: غير_موقع = الموضع + حجم_المصدر;
    لو (النهاية < الموضع) { أرجع خطأ; };
    دع الحجم_الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحجم_الحالي < النهاية) {
        ألحق_أصفارا_إلف_ربط(البايتات, النهاية - الحجم_الحالي);
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < حجم_المصدر) {
        دع موضع_الكتابة: غير_موقع = الموضع + فهرس_البايت;
        (*البايتات)[موضع_الكتابة] := (*المصدر)[فهرس_البايت];
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف أكمل_إلف_إلى_موضع(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع
): منطقي {
    دع الحجم_الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحجم_الحالي > الموضع) { أرجع خطأ; };
    ألحق_أصفارا_إلف_ربط(البايتات, الموضع - الحجم_الحالي);
    أرجع صواب;
}

عام عرف اقرأ_غ32_إلف_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)) { أرجع 0; };
    لو ((الطول(*البايتات) مثل غير_موقع) - الموضع < 4) { أرجع 0; };
    دع الموضع_1: غير_موقع = الموضع + 1;
    دع الموضع_2: غير_موقع = الموضع + 2;
    دع الموضع_3: غير_موقع = الموضع + 3;
    دع البايت_0: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع البايت_1: غير_موقع = (*البايتات)[الموضع_1] مثل غير_موقع;
    دع البايت_2: غير_موقع = (*البايتات)[الموضع_2] مثل غير_موقع;
    دع البايت_3: غير_موقع = (*البايتات)[الموضع_3] مثل غير_موقع;
    أرجع البايت_0
        | (البايت_1 << 8)
        | (البايت_2 << 16)
        | (البايت_3 << 24);
}

عام عرف اكتب_غ32_إلف_ربط_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    لو ((الطول(*البايتات) مثل غير_موقع) - الموضع < 4) { أرجع خطأ; };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < 4) {
        دع القاسم: غير_موقع = 1 << (فهرس_البايت * 8);
        دع موضع_البايت: غير_موقع = الموضع + فهرس_البايت;
        (*البايتات)[موضع_البايت] :=
            ((القيمة / القاسم) & 0xFF) مثل غ8;
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اكتب_غ64_إلف_ربط_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    لو ((الطول(*البايتات) مثل غير_موقع) - الموضع < 8) { أرجع خطأ; };
    لو (!اكتب_غ32_إلف_ربط_في(البايتات, الموضع, القيمة & 0xFFFFFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_غ32_إلف_ربط_في(
        البايتات,
        الموضع + 4,
        القيمة / 4294967296
    );
}

عام عرف فرق_نسبي_ص32_إلف(
    موضع_الرقعة: غير_موقع,
    الهدف: غير_موقع,
    الإضافة: عدد
): اختيار غير_موقع {
    دع الفرق_الأساسي: عدد;
    لو (الهدف >= موضع_الرقعة) {
        دع الفرق: غير_موقع = الهدف - موضع_الرقعة;
        لو (الفرق > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
        الفرق_الأساسي := الفرق مثل عدد;
    } وإلا {
        دع الفرق: غير_موقع = موضع_الرقعة - الهدف;
        لو (الفرق > 0x7FFFFFFFFFFFFFFF) { أرجع اختيار.لا_شيء(); };
        الفرق_الأساسي := -((الفرق) مثل عدد);
    };
    دع القيمة: عدد = الفرق_الأساسي + الإضافة;
    لو (القيمة < -2147483648 || القيمة > 2147483647) {
        أرجع اختيار.لا_شيء();
    };
    لو (القيمة < 0) {
        أرجع اختيار.بعض((4294967296 + القيمة) مثل غير_موقع);
    };
    أرجع اختيار.بعض(القيمة مثل غير_موقع);
}


عام عرف ألحق_غ16_إلف_بترتيب(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_غ16_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        ألحق_بايت_إلف(البايتات, القيمة / 256);
        ألحق_بايت_إلف(البايتات, القيمة);
    };
}

عام عرف ألحق_غ32_إلف_بترتيب(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_غ32_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        دع فهرس_البايت: متغير غير_موقع = 4;
        بينما (فهرس_البايت > 0) {
            فهرس_البايت := فهرس_البايت - 1;
            دع القاسم: غير_موقع = 1 << (فهرس_البايت * 8);
            ألحق_بايت_إلف(البايتات, القيمة / القاسم);
        }
    };
}

عام عرف ألحق_غ64_إلف_بترتيب(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_غ64_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        دع الجزء_الأعلى: غير_موقع = القيمة / 4294967296;
        دع الجزء_الأدنى: غير_موقع = القيمة & 0xFFFFFFFF;
        ألحق_غ32_إلف_بترتيب(البايتات, الجزء_الأعلى, الترتيب);
        ألحق_غ32_إلف_بترتيب(البايتات, الجزء_الأدنى, الترتيب);
    };
}

عام عرف اكتب_غ32_إلف_بترتيب_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع,
    الترتيب: ترتيب_بايت
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    لو ((الطول(*البايتات) مثل غير_موقع) - الموضع < 4) { أرجع خطأ; };
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        أرجع اكتب_غ32_إلف_ربط_في(البايتات, الموضع, القيمة);
    }
    | ترتيب_بايت.كبير -> {
        دع فهرس_البايت: متغير غير_موقع = 0;
        بينما (فهرس_البايت < 4) {
            دع مرتبة: غير_موقع = 3 - فهرس_البايت;
            دع القاسم: غير_موقع = 1 << (مرتبة * 8);
            دع موضع_البايت: غير_موقع = الموضع + فهرس_البايت;
            (*البايتات)[موضع_البايت] :=
                ((القيمة / القاسم) & 0xFF) مثل غ8;
            فهرس_البايت := فهرس_البايت + 1;
        }
        أرجع صواب;
    };
}

عام عرف اكتب_غ64_إلف_بترتيب_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع,
    الترتيب: ترتيب_بايت
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)) { أرجع خطأ; };
    لو ((الطول(*البايتات) مثل غير_موقع) - الموضع < 8) { أرجع خطأ; };
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        أرجع اكتب_غ64_إلف_ربط_في(البايتات, الموضع, القيمة);
    }
    | ترتيب_بايت.كبير -> {
        دع الجزء_الأعلى: غير_موقع = القيمة / 4294967296;
        دع الجزء_الأدنى: غير_موقع = القيمة & 0xFFFFFFFF;
        لو (!اكتب_غ32_إلف_بترتيب_في(
            البايتات,
            الموضع,
            الجزء_الأعلى,
            الترتيب
        )) { أرجع خطأ; };
        أرجع اكتب_غ32_إلف_بترتيب_في(
            البايتات,
            الموضع + 4,
            الجزء_الأدنى,
            الترتيب
        );
    };
}
