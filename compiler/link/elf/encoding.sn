استورد std.encoding.binary;
استورد compiler.backend.target.target_model;

// ELF executable serialization helpers owned by the linker. Relocatable-object
// serialization remains under compiler/backend/object.

عام عرف حاذ_قيمة_إلف(
    القيمة: طبيعي,
    المحاذاة: طبيعي
): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    إذا (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عام عرف ألحق_بايت_إلف(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    ألحق(*البايتات, (القيمة & 0xFF) مثل ط8);
}

عام عرف ألحق_ط16_إلف_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFF) مثل ط16);
}

عام عرف ألحق_ط32_إلف_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل ط32);
}

عام عرف ألحق_ط64_إلف_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط64_بالبايت_الأقل_أهمية_أولا(البايتات, القيمة مثل ط64);
}

عام عرف ألحق_أصفارا_إلف_ربط(
    البايتات: &متغير متجه ط8,
    العدد: طبيعي
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(*البايتات, 0);
        الفهرس := الفهرس + 1;
    }
}

عام عرف ألحق_بايتات_إلف_ربط(
    الناتج: &متغير متجه ط8,
    المصدر: &متجه ط8
): فراغ {
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف اكتب_بايتات_إلف_ربط_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: &متجه ط8
): منطقي {
    دع حجم_المصدر: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع النهاية: طبيعي = الموضع + حجم_المصدر;
    إذا (النهاية < الموضع) { أرجع خطأ; };
    دع الحجم_الحالي: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الحجم_الحالي < النهاية) {
        ألحق_أصفارا_إلف_ربط(البايتات, النهاية - الحجم_الحالي);
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < حجم_المصدر) {
        دع موضع_الكتابة: طبيعي = الموضع + فهرس_البايت;
        (*البايتات)[موضع_الكتابة] := (*المصدر)[فهرس_البايت];
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف أكمل_إلف_إلى_موضع(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي
): منطقي {
    دع الحجم_الحالي: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الحجم_الحالي > الموضع) { أرجع خطأ; };
    ألحق_أصفارا_إلف_ربط(البايتات, الموضع - الحجم_الحالي);
    أرجع صواب;
}

عام عرف اقرأ_ط32_إلف_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    إذا (الموضع > (الطول(*البايتات) مثل طبيعي)) { أرجع 0; };
    إذا ((الطول(*البايتات) مثل طبيعي) - الموضع < 4) { أرجع 0; };
    دع الموضع_1: طبيعي = الموضع + 1;
    دع الموضع_2: طبيعي = الموضع + 2;
    دع الموضع_3: طبيعي = الموضع + 3;
    دع البايت_0: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع البايت_1: طبيعي = (*البايتات)[الموضع_1] مثل طبيعي;
    دع البايت_2: طبيعي = (*البايتات)[الموضع_2] مثل طبيعي;
    دع البايت_3: طبيعي = (*البايتات)[الموضع_3] مثل طبيعي;
    أرجع البايت_0
        | (البايت_1 << 8)
        | (البايت_2 << 16)
        | (البايت_3 << 24);
}

عام عرف اكتب_ط32_إلف_ربط_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (الموضع > (الطول(*البايتات) مثل طبيعي)) { أرجع خطأ; };
    إذا ((الطول(*البايتات) مثل طبيعي) - الموضع < 4) { أرجع خطأ; };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < 4) {
        دع القاسم: طبيعي = 1 << (فهرس_البايت * 8);
        دع موضع_البايت: طبيعي = الموضع + فهرس_البايت;
        (*البايتات)[موضع_البايت] :=
            ((القيمة / القاسم) & 0xFF) مثل ط8;
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اكتب_ط64_إلف_ربط_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (الموضع > (الطول(*البايتات) مثل طبيعي)) { أرجع خطأ; };
    إذا ((الطول(*البايتات) مثل طبيعي) - الموضع < 8) { أرجع خطأ; };
    إذا (!اكتب_ط32_إلف_ربط_في(البايتات, الموضع, القيمة & 0xFFFFFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_ط32_إلف_ربط_في(
        البايتات,
        الموضع + 4,
        القيمة / 4294967296
    );
}

عام عرف فرق_نسبي_ص32_إلف(
    موضع_الرقعة: طبيعي,
    الهدف: طبيعي,
    الإضافة: عدد
): اختياري طبيعي {
    دع الفرق_الأساسي: عدد;
    إذا (الهدف >= موضع_الرقعة) {
        دع الفرق: طبيعي = الهدف - موضع_الرقعة;
        إذا (الفرق > 0x7FFFFFFFFFFFFFFF) { أرجع اختياري.لا_شيء(); };
        الفرق_الأساسي := الفرق مثل عدد;
    } وإلا {
        دع الفرق: طبيعي = موضع_الرقعة - الهدف;
        إذا (الفرق > 0x7FFFFFFFFFFFFFFF) { أرجع اختياري.لا_شيء(); };
        الفرق_الأساسي := -((الفرق) مثل عدد);
    };
    // A RELA addend may span the full signed machine word. Reject overflow
    // before forming the sum, even when the final relocation is only 32 bits.
    إذا (الإضافة > 0 && الفرق_الأساسي > 9223372036854775807 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الإضافة < 0 && الفرق_الأساسي < -9223372036854775807 - 1 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    دع القيمة: عدد = الفرق_الأساسي + الإضافة;
    إذا (القيمة < -2147483648 || القيمة > 2147483647) {
        أرجع اختياري.لا_شيء();
    };
    إذا (القيمة < 0) {
        أرجع اختياري.موجود((4294967296 + القيمة) مثل طبيعي);
    };
    أرجع اختياري.موجود(القيمة مثل طبيعي);
}


// R_X86_64_32S stores a signed 32-bit absolute address. Its addend can
// legitimately produce a negative value (including when the symbol is zero),
// so the unsigned absolute-address helper cannot be used for this relocation.
عام عرف قيمة_مطلقة_ص32_موقعة_إلف(
    العنوان: طبيعي,
    الإضافة: عدد
): اختياري طبيعي {
    دع الأساس: عدد;
    إذا (العنوان <= 9223372036854775807) {
        الأساس := العنوان مثل عدد;
    } وإلا {
        // Convert the full two's-complement address before adding the RELA
        // addend; even a larger negative base may yield a valid 32S result.
        دع المقدار: طبيعي = (0xFFFFFFFFFFFFFFFF - العنوان) + 1;
        إذا (المقدار == 0x8000000000000000) {
            الأساس := -9223372036854775807 - 1;
        } وإلا {
            الأساس := -(المقدار مثل عدد);
        };
    };
    إذا (الإضافة > 0 && الأساس > 9223372036854775807 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الإضافة < 0 && الأساس < -9223372036854775807 - 1 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: عدد = الأساس + الإضافة;
    إذا (الناتج < -2147483648 || الناتج > 2147483647) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الناتج < 0) {
        أرجع اختياري.موجود((4294967296 + الناتج) مثل طبيعي);
    };
    أرجع اختياري.موجود(الناتج مثل طبيعي);
}

عام عرف ألحق_ط16_إلف_بترتيب(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_ط16_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        اكتب_ط16_بالبايت_الأكثر_أهمية_أولا(البايتات, (القيمة & 0xFFFF) مثل ط16);
    };
}

عام عرف ألحق_ط32_إلف_بترتيب(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_ط32_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        اكتب_ط32_بالبايت_الأكثر_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل ط32);
    };
}

عام عرف ألحق_ط64_إلف_بترتيب(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي,
    الترتيب: ترتيب_بايت
): فراغ {
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> { ألحق_ط64_إلف_ربط(البايتات, القيمة); }
    | ترتيب_بايت.كبير -> {
        اكتب_ط64_بالبايت_الأكثر_أهمية_أولا(البايتات, القيمة مثل ط64);
    };
}

عام عرف اكتب_ط32_إلف_بترتيب_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي,
    الترتيب: ترتيب_بايت
): منطقي {
    إذا (الموضع > (الطول(*البايتات) مثل طبيعي)) { أرجع خطأ; };
    إذا ((الطول(*البايتات) مثل طبيعي) - الموضع < 4) { أرجع خطأ; };
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        أرجع اكتب_ط32_إلف_ربط_في(البايتات, الموضع, القيمة);
    }
    | ترتيب_بايت.كبير -> {
        دع فهرس_البايت: متغير طبيعي = 0;
        طالما (فهرس_البايت < 4) {
            دع مرتبة: طبيعي = 3 - فهرس_البايت;
            دع القاسم: طبيعي = 1 << (مرتبة * 8);
            دع موضع_البايت: طبيعي = الموضع + فهرس_البايت;
            (*البايتات)[موضع_البايت] :=
                ((القيمة / القاسم) & 0xFF) مثل ط8;
            فهرس_البايت := فهرس_البايت + 1;
        }
        أرجع صواب;
    };
}

عام عرف اكتب_ط64_إلف_بترتيب_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي,
    الترتيب: ترتيب_بايت
): منطقي {
    إذا (الموضع > (الطول(*البايتات) مثل طبيعي)) { أرجع خطأ; };
    إذا ((الطول(*البايتات) مثل طبيعي) - الموضع < 8) { أرجع خطأ; };
    طابق الترتيب مع
    | ترتيب_بايت.صغير -> {
        أرجع اكتب_ط64_إلف_ربط_في(البايتات, الموضع, القيمة);
    }
    | ترتيب_بايت.كبير -> {
        دع الجزء_الأعلى: طبيعي = القيمة / 4294967296;
        دع الجزء_الأدنى: طبيعي = القيمة & 0xFFFFFFFF;
        إذا (!اكتب_ط32_إلف_بترتيب_في(
            البايتات,
            الموضع,
            الجزء_الأعلى,
            الترتيب
        )) { أرجع خطأ; };
        أرجع اكتب_ط32_إلف_بترتيب_في(
            البايتات,
            الموضع + 4,
            الجزء_الأدنى,
            الترتيب
        );
    };
}
