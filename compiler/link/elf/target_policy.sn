استورد compiler.backend.target.target_model;
استورد compiler.link.elf.reader;

عام نوع سياسة_هدف_إلف = {
    الآلة: غير_موقع,
    الصنف: صنف_إلف_مدخل,
    الترتيب: ترتيب_إلف_مدخل
};

عرف آلة_إلف_لمعمارية(المعمارية: هوية_معمارية): اختيار غير_موقع {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع اختيار.بعض(62); }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع اختيار.بعض(3); }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختيار.بعض(183); }
    | هوية_معمارية.ذراع_سبعة -> { أرجع اختيار.بعض(40); }
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> { أرجع اختيار.بعض(243); }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع اختيار.بعض(243); }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> { أرجع اختيار.بعض(224); }
    | هوية_معمارية.إيه_في_آر -> { أرجع اختيار.بعض(83); }
    | هوية_معمارية.بي_بي_إف -> { أرجع اختيار.بعض(247); }
    | هوية_معمارية.هيكساغون -> { أرجع اختيار.بعض(164); }
    | هوية_معمارية.لاناي -> { أرجع اختيار.بعض(244); }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { أرجع اختيار.بعض(258); }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع اختيار.بعض(8); }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> { أرجع اختيار.بعض(105); }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع اختيار.بعض(21); }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع اختيار.بعض(43); }
    | هوية_معمارية.سيستم_زد -> { أرجع اختيار.بعض(22); }
    | هوية_معمارية.في_إي -> { أرجع اختيار.بعض(251); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف سياسة_إلف_للهدف(الهدف: &واصف_هدف): اختيار سياسة_هدف_إلف {
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.إلف()) {
        أرجع اختيار.لا_شيء();
    };
    دع الآلة: غير_موقع;
    طابق آلة_إلف_لمعمارية((*الهدف).المعمارية.الهوية) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    دع الصنف: صنف_إلف_مدخل;
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر > 32) {
        الصنف := صنف_إلف_مدخل.أربعة_وستون();
    } وإلا {
        الصنف := صنف_إلف_مدخل.اثنان_وثلاثون();
    };
    دع الترتيب: ترتيب_إلف_مدخل;
    طابق (*الهدف).نموذج_البيانات.ترتيب_البايت مع
    | ترتيب_بايت.صغير -> { الترتيب := ترتيب_إلف_مدخل.صغير(); }
    | ترتيب_بايت.كبير -> { الترتيب := ترتيب_إلف_مدخل.كبير(); };
    دع السياسة: سياسة_هدف_إلف = {
        الآلة: الآلة,
        الصنف: الصنف,
        الترتيب: الترتيب
    };
    أرجع اختيار.بعض(السياسة);
}

عام عرف ترتيب_بايت_من_سياسة_إلف(السياسة: &سياسة_هدف_إلف): ترتيب_بايت {
    طابق (*السياسة).الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع ترتيب_بايت.صغير(); }
    | ترتيب_إلف_مدخل.كبير -> { أرجع ترتيب_بايت.كبير(); };
}

عام عرف رقم_صنف_إلف(الصنف: صنف_إلف_مدخل): غير_موقع {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 1; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 2; };
}

عام عرف رقم_ترتيب_إلف(الترتيب: ترتيب_إلف_مدخل): غير_موقع {
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع 1; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع 2; };
}

عام عرف منصة_إلف_نظامية_قابلة_للربط(المنصة: هوية_منصة): منطقي {
    طابق المنصة مع
    | هوية_منصة.لينكس -> { أرجع صواب; }
    | هوية_منصة.أندرويد -> { أرجع صواب; }
    | هوية_منصة.فري_بي_إس_دي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف هدف_إلف_ليس_تنفيذيا_نظاميا(الهدف: &واصف_هدف): منطقي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.بي_بي_إف -> { أرجع صواب; }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> { أرجع صواب; }
    | هوية_معمارية.إيه_في_آر -> { أرجع صواب; }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> { أرجع صواب; }
    | _ -> {
        طابق (*الهدف).المنصة.المنصة مع
        | هوية_منصة.عتاد_مباشر -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// EI_OSABI belongs to the target platform, not to individual object writers.
// GNU/Linux and Android use ELFOSABI_NONE; FreeBSD uses ELFOSABI_FREEBSD.
عام عرف رقم_هوية_نظام_إلف_للهدف(الهدف: &واصف_هدف): غير_موقع {
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.فري_بي_إس_دي -> { أرجع 9; }
    | _ -> { أرجع 0; };
}
