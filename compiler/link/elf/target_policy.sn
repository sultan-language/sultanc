استورد compiler.backend.target.target_model;
استورد compiler.link.elf.reader;

عام نوع سياسة_هدف_إلف = {
    الآلة: طبيعي,
    الصنف: صنف_إلف_مدخل,
    الترتيب: ترتيب_إلف_مدخل
};

عرف آلة_إلف_لمعمارية(المعمارية: هوية_معمارية): اختياري طبيعي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع اختياري.موجود(62); }
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع اختياري.موجود(3); }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(183); }
    | هوية_معمارية.ذراع_سبعة -> { أرجع اختياري.موجود(40); }
    | هوية_معمارية.رايسك_في_اثنان_وثلاثون -> { أرجع اختياري.موجود(243); }
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع اختياري.موجود(243); }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> { أرجع اختياري.موجود(224); }
    | هوية_معمارية.إيه_في_آر -> { أرجع اختياري.موجود(83); }
    | هوية_معمارية.بي_بي_إف -> { أرجع اختياري.موجود(247); }
    | هوية_معمارية.هيكساغون -> { أرجع اختياري.موجود(164); }
    | هوية_معمارية.لاناي -> { أرجع اختياري.موجود(244); }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { أرجع اختياري.موجود(258); }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع اختياري.موجود(8); }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> { أرجع اختياري.موجود(105); }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع اختياري.موجود(21); }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع اختياري.موجود(43); }
    | هوية_معمارية.سيستم_زد -> { أرجع اختياري.موجود(22); }
    | هوية_معمارية.في_إي -> { أرجع اختياري.موجود(251); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف سياسة_إلف_للهدف(الهدف: &واصف_هدف): اختياري سياسة_هدف_إلف {
    إذا ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.إلف()) {
        أرجع اختياري.لا_شيء();
    };
    دع الآلة: طبيعي;
    طابق آلة_إلف_لمعمارية((*الهدف).المعمارية.الهوية) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الآلة := القيمة; };
    دع الصنف: صنف_إلف_مدخل;
    إذا ((*الهدف).نموذج_البيانات.عرض_المؤشر > 32) {
        الصنف := صنف_إلف_مدخل.أربعة_وستون();
    } وإلا {
        الصنف := صنف_إلف_مدخل.اثنان_وثلاثون();
    };
    دع الترتيب: ترتيب_إلف_مدخل;
    طابق (*الهدف).نموذج_البيانات.ترتيب_البايت مع
    | ترتيب_بايت.صغير -> { الترتيب := ترتيب_إلف_مدخل.صغير(); }
    | ترتيب_بايت.كبير -> { الترتيب := ترتيب_إلف_مدخل.كبير(); };
    دع السياسة: سياسة_هدف_إلف = {
        الآلة: الآلة,
        الصنف: الصنف,
        الترتيب: الترتيب
    };
    أرجع اختياري.موجود(السياسة);
}

عام عرف ترتيب_بايت_من_سياسة_إلف(السياسة: &سياسة_هدف_إلف): ترتيب_بايت {
    طابق (*السياسة).الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع ترتيب_بايت.صغير(); }
    | ترتيب_إلف_مدخل.كبير -> { أرجع ترتيب_بايت.كبير(); };
}

عام عرف رقم_صنف_إلف(الصنف: صنف_إلف_مدخل): طبيعي {
    طابق الصنف مع
    | صنف_إلف_مدخل.اثنان_وثلاثون -> { أرجع 1; }
    | صنف_إلف_مدخل.أربعة_وستون -> { أرجع 2; };
}

عام عرف رقم_ترتيب_إلف(الترتيب: ترتيب_إلف_مدخل): طبيعي {
    طابق الترتيب مع
    | ترتيب_إلف_مدخل.صغير -> { أرجع 1; }
    | ترتيب_إلف_مدخل.كبير -> { أرجع 2; };
}

// The ELF system images SultanC links itself: Linux, Android and FreeBSD
// x86_64, AArch64, RISC-V 64 and LoongArch 64 fixed-base ET_EXEC
// executables (final_image.sn; the
// FreeBSD image carries ELFOSABI_FREEBSD and a PT_NOTE over the ABI note)
// and relocatable objects
// (relocatable.sn). These images link no C runtime: the selected backend
// emits the process start (backend/provider/llvm/entry.sn, the native
// encoder) and std exits through raw kernel calls; the Driver's
// بدء_عملية_ذاتي_لربط follows this predicate. No external linker program
// is ever run: an ELF system target or output kind outside this predicate is
// reported as unsupported (link/provider.sn). Previously the other
// architectures, Android, FreeBSD and every ELF shared library were handed
// to ld.lld or nld with the platform C runtime startup objects and libc.
عام عرف يستخدم_رابط_إلف_الداخلي(الهدف: &واصف_هدف): منطقي {
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.لينكس -> { }
    | هوية_منصة.أندرويد -> { }
    | هوية_منصة.فري_بي_إس_دي -> { }
    | _ -> { أرجع خطأ; };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع صواب; }
    // Static images only: final_image.sn has no PLT for these two.
    | هوية_معمارية.رايسك_في_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.لونغ_آرتش_أربعة_وستون -> { أرجع صواب; }
    | _ -> { أرجع رابط_إلف_داخلي_مفعل_لمعمارية((*الهدف).المعمارية.الهوية); };
}

// The static ELF32 (i386, ARM), big-endian (s390x, SPARC V9), PowerPC 64
// and MIPS64 images the internal linker lays out (final_image.sn,
// relocation_patch.sn), once a target's executables, linked both ways, run
// as the ld.lld-linked ones do. The others are linked by ld.lld
// (يستخدم_رابط_إلف_خارجي).
عرف رابط_إلف_داخلي_مفعل_لمعمارية(المعمارية: هوية_معمارية): منطقي {
    طابق المعمارية مع
    | هوية_معمارية.إكس_ستة_وثمانون_اثنان_وثلاثون -> { أرجع صواب; }
    | هوية_معمارية.ذراع_سبعة -> { أرجع صواب; }
    | هوية_معمارية.سيستم_زد -> { أرجع صواب; }
    | هوية_معمارية.سبارك_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.باور_بي_سي_أربعة_وستون -> { أرجع صواب; }
    | هوية_معمارية.ميبس_أربعة_وستون -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Linux- and FreeBSD-kernel ELF executables SultanC's own ELF linker does
// not lay out (i686, ARMv7, PowerPC 64, s390x, MIPS64 and SPARC V9). The LLVM provider emits their
// `_start` and an external LLD links them (driver/external_linker.sn), the
// split rustc makes between code generation and system linking.
عام عرف يستخدم_رابط_إلف_خارجي(الهدف: &واصف_هدف): منطقي {
    إذا ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.إلف()) { أرجع خطأ; };
    إذا (يستخدم_رابط_إلف_الداخلي(الهدف)) { أرجع خطأ; };
    أرجع هدف_نواة_مباشر(الهدف);
}

عام عرف منصة_إلف_نظامية_قابلة_للربط(المنصة: هوية_منصة): منطقي {
    طابق المنصة مع
    | هوية_منصة.لينكس -> { أرجع صواب; }
    | هوية_منصة.أندرويد -> { أرجع صواب; }
    | هوية_منصة.فري_بي_إس_دي -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Bare-metal 32-bit Arm (the Cortex-M targets): executables laid out by the
// link's linker scripts (elf/script_image.sn).
عام عرف رابط_إلف_بسكربت_للهدف(الهدف: &واصف_هدف): منطقي {
    أرجع (*الهدف).المعمارية.الهوية == هوية_معمارية.ذراع_سبعة()
        && (*الهدف).المنصة.المنصة == هوية_منصة.عتاد_مباشر()
        && (*الهدف).صيغة_الكائن == صيغة_كائن_هدف.إلف();
}

عام عرف هدف_إلف_ليس_تنفيذيا_نظاميا(الهدف: &واصف_هدف): منطقي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.بي_بي_إف -> { أرجع صواب; }
    | هوية_معمارية.إيه_إم_دي_جي_بي_يو -> { أرجع صواب; }
    | هوية_معمارية.إيه_في_آر -> { أرجع صواب; }
    | هوية_معمارية.إم_إس_بي_أربعمئة_وثلاثون -> { أرجع صواب; }
    | _ -> {
        طابق (*الهدف).المنصة.المنصة مع
        | هوية_منصة.عتاد_مباشر -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// EI_OSABI belongs to the target platform, not to individual object writers.
// GNU/Linux and Android use ELFOSABI_NONE; FreeBSD uses ELFOSABI_FREEBSD.
عام عرف رقم_هوية_نظام_إلف_للهدف(الهدف: &واصف_هدف): طبيعي {
    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.فري_بي_إس_دي -> { أرجع 9; }
    | _ -> { أرجع 0; };
}
