// ELF ABI spellings are centralized here so normal linker logic never carries
// raw external byte names inline.
عام عرف اسم_رمز_دخول_إلف_الافتراضي(): متجه غ8 {
    دع الاسم: متجه غ8 = [
        0x5F,
        0x73,
        0x74,
        0x61,
        0x72,
        0x74
    ];
    أرجع الاسم;
}

عام عرف بادئة_قسم_تصحيح_إلف(): متجه غ8 {
    دع الاسم: متجه غ8 = [
        0x2E,
        0x64,
        0x65,
        0x62,
        0x75,
        0x67
    ];
    أرجع الاسم;
}

عام عرف بادئة_قسم_تصحيح_إلف_مضغوط(): متجه غ8 {
    دع الاسم: متجه غ8 = [
        0x2E,
        0x7A,
        0x64,
        0x65,
        0x62,
        0x75,
        0x67
    ];
    أرجع الاسم;
}

عرف يبدأ_اسم_قسم_إلف_بـ(
    الاسم: &متجه غ8,
    البادئة: &متجه غ8
): منطقي {
    لو (الطول(*الاسم) < الطول(*البادئة)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*البادئة) مثل غير_موقع)) {
        لو ((*الاسم)[فهرس_البايت] != (*البادئة)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف هل_اسم_قسم_تصحيح_إلف(الاسم: &متجه غ8): منطقي {
    دع البادئة: متجه غ8 = بادئة_قسم_تصحيح_إلف();
    لو (يبدأ_اسم_قسم_إلف_بـ(الاسم, &البادئة)) {
        أرجع صواب;
    };
    دع البادئة_المضغوطة: متجه غ8 = بادئة_قسم_تصحيح_إلف_مضغوط();
    أرجع يبدأ_اسم_قسم_إلف_بـ(الاسم, &البادئة_المضغوطة);
}
