استورد std.text.from_bytes;
// ELF ABI spellings are centralized here so normal linker logic never carries
// raw external byte names inline.
عام عرف اسم_رمز_دخول_إلف_الافتراضي(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«_start»);
    أرجع الاسم;
}

عام عرف بادئة_قسم_تصحيح_إلف(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«.debug»);
    أرجع الاسم;
}

عام عرف بادئة_قسم_تصحيح_إلف_مضغوط(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«.zdebug»);
    أرجع الاسم;
}

عرف يبدأ_اسم_قسم_إلف_بـ(
    الاسم: &متجه ط8,
    البادئة: &متجه ط8
): منطقي {
    إذا (الطول(*الاسم) < الطول(*البادئة)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*البادئة) مثل طبيعي)) {
        إذا ((*الاسم)[فهرس_البايت] != (*البادئة)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف هل_اسم_قسم_تصحيح_إلف(الاسم: &متجه ط8): منطقي {
    دع البادئة: متجه ط8 = بادئة_قسم_تصحيح_إلف();
    إذا (يبدأ_اسم_قسم_إلف_بـ(الاسم, &البادئة)) {
        أرجع صواب;
    };
    دع البادئة_المضغوطة: متجه ط8 = بادئة_قسم_تصحيح_إلف_مضغوط();
    أرجع يبدأ_اسم_قسم_إلف_بـ(الاسم, &البادئة_المضغوطة);
}
