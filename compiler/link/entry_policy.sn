استورد std.text.from_bytes;
استورد compiler.link.context;
استورد compiler.link.provider;
استورد compiler.link.reachability;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.link.elf.names;
استورد compiler.link.macho.names;
استورد compiler.link.coff.names;
استورد compiler.link.wasm.names;
استورد compiler.backend.target.target_model;

عام نوع نتيجة_تهيئة_دخول_ربط =
    | نجح
    | رمز_دخول_غير_موجود
    | مزود_غير_مدعوم
;


عرف اسم_رمز_دخول_افتراضي_للربط(
    السياق: &سياق_ربط
): اختياري متجه ط8 {
    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.إلف -> {
        أرجع اختياري.موجود(اسم_رمز_دخول_إلف_الافتراضي());
    }
    | هوية_مزود_ربط.ماتشو -> {
        أرجع اختياري.موجود(اسم_رمز_دخول_ماتشو_الافتراضي());
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع اختياري.موجود(اسم_رمز_بدء_عملية_كوف());
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        // WASI commands and browser modules alike: the language entry is
        // `_start` on every WebAssembly target.
        أرجع اختياري.موجود(اسم_رمز_دخول_ويب_أسمبلي());
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ثبت_اسم_رمز_دخول_خطة_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_تهيئة_دخول_ربط {
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختياري.موجود(_) -> { أرجع نتيجة_تهيئة_دخول_ربط.نجح(); }
    | اختياري.لا_شيء -> { };

    طابق اسم_رمز_دخول_افتراضي_للربط(السياق) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختياري.موجود(الاسم) -> {
        (*السياق).الخطة.رمز_الدخول := اختياري.موجود(الاسم);
        أرجع نتيجة_تهيئة_دخول_ربط.نجح();
    };
}

// The entry name this executable link uses: the plan's explicit entry, or the
// target default recorded into the plan here. None when the target has no
// default entry.
// The linker resolves this name as an undefined root before the entry check,
// so an archive member defining it is extracted (input_ingest.sn).
عام عرف اسم_رمز_دخول_خطة_الربط(
    السياق: &متغير سياق_ربط
): اختياري متجه ط8 {
    طابق ثبت_اسم_رمز_دخول_خطة_الربط(السياق) مع
    | نتيجة_تهيئة_دخول_ربط.نجح -> { }
    | _ -> { أرجع اختياري.لا_شيء(); };
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع النسخة: متجه ط8 = انسخ_بايتات(&الاسم);
        أرجع اختياري.موجود(النسخة);
    };
}

عام عرف أضف_جذر_دخول_خطة_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_تهيئة_دخول_ربط {
    طابق ثبت_اسم_رمز_دخول_خطة_الربط(السياق) مع
    | نتيجة_تهيئة_دخول_ربط.نجح -> { }
    | نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم -> {
        أرجع نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم();
    };

    // The WebAssembly linker resolves the entry itself over the objects'
    // symbol tables (wasm/linker.sn): the context keeps whole modules as
    // sections, so there is no section to root here.
    إذا (مزود_ربط_للهدف(&(*السياق).الهدف) == هوية_مزود_ربط.ويب_أسمبلي()) {
        أرجع نتيجة_تهيئة_دخول_ربط.نجح();
    };

    دع اسم_الدخول: متجه ط8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختياري.موجود(الاسم) -> { اسم_الدخول := الاسم; };

    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختياري.موجود(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            أضف_جذر_رمز_ربط(&متغير (*السياق).الوصول, الرمز.المعرف);
            أرجع نتيجة_تهيئة_دخول_ربط.نجح();
        }
        | _ -> {
            أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
        };
    };
}
