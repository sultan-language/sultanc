استورد compiler.link.context;
استورد compiler.link.provider;
استورد compiler.link.reachability;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.link.elf.names;
استورد compiler.link.macho.names;
استورد compiler.link.coff.names;
استورد compiler.link.wasm.names;
استورد compiler.backend.target.target_model;

عام نوع نتيجة_تهيئة_دخول_ربط =
    | نجح
    | رمز_دخول_غير_موجود
    | مزود_غير_مدعوم
;


عرف يوجد_رمز_ربط_معرف_بالاسم(
    السياق: &سياق_ربط,
    الاسم: &متجه غ8
): منطقي {
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

// PE console images enter through the CRT startup symbol, not through the
// language-level main function. Match lld-link/MSVC inference for the two
// console entry spellings supported by the current PE subsystem policy.
عرف اسم_رمز_دخول_كوف_الافتراضي(
    السياق: &سياق_ربط
): اختيار متجه غ8 {
    دع الرئيسي: متجه غ8 = اسم_رمز_رئيسي_كوف();
    لو (يوجد_رمز_ربط_معرف_بالاسم(السياق, &الرئيسي)) {
        دع البدء: متجه غ8 = اسم_رمز_بدء_رئيسي_كوف();
        أرجع اختيار.بعض(البدء);
    };

    دع الرئيسي_الواسع: متجه غ8 = اسم_رمز_رئيسي_واسع_كوف();
    لو (يوجد_رمز_ربط_معرف_بالاسم(السياق, &الرئيسي_الواسع)) {
        دع البدء: متجه غ8 = اسم_رمز_بدء_رئيسي_واسع_كوف();
        أرجع اختيار.بعض(البدء);
    };

    أرجع اختيار.لا_شيء();
}

عرف اسم_رمز_دخول_افتراضي_للربط(
    السياق: &سياق_ربط
): اختيار متجه غ8 {
    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.إلف -> {
        أرجع اختيار.بعض(اسم_رمز_دخول_إلف_الافتراضي());
    }
    | هوية_مزود_ربط.ماتشو -> {
        أرجع اختيار.بعض(اسم_رمز_دخول_ماتشو_الافتراضي());
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع اسم_رمز_دخول_كوف_الافتراضي(السياق);
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        لو ((*السياق).الهدف.المنصة.المنصة == هوية_منصة.واسي()) {
            أرجع اختيار.بعض(اسم_رمز_دخول_ويب_أسمبلي_واسي());
        };
        أرجع اختيار.لا_شيء();
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ثبت_اسم_رمز_دخول_خطة_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_تهيئة_دخول_ربط {
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختيار.بعض(_) -> { أرجع نتيجة_تهيئة_دخول_ربط.نجح(); }
    | اختيار.لا_شيء -> { };

    طابق اسم_رمز_دخول_افتراضي_للربط(السياق) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختيار.بعض(الاسم) -> {
        (*السياق).الخطة.رمز_الدخول := اختيار.بعض(الاسم);
        أرجع نتيجة_تهيئة_دخول_ربط.نجح();
    };
}

عام عرف أضف_جذر_دخول_خطة_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_تهيئة_دخول_ربط {
    طابق ثبت_اسم_رمز_دخول_خطة_الربط(السياق) مع
    | نتيجة_تهيئة_دخول_ربط.نجح -> { }
    | نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم -> {
        أرجع نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم();
    };

    // WebAssembly linking is delegated to wasm-ld. The canonical context keeps
    // whole Wasm modules rather than reconstructing the Wasm linking symbol
    // table, so entry-symbol resolution belongs to the delegated linker.
    لو (مزود_ربط_للهدف(&(*السياق).الهدف) == هوية_مزود_ربط.ويب_أسمبلي()) {
        أرجع نتيجة_تهيئة_دخول_ربط.نجح();
    };

    دع اسم_الدخول: متجه غ8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختيار.بعض(الاسم) -> { اسم_الدخول := الاسم; };

    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
    }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            أضف_جذر_رمز_ربط(&متغير (*السياق).الوصول, الرمز.المعرف);
            أرجع نتيجة_تهيئة_دخول_ربط.نجح();
        }
        | _ -> {
            أرجع نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود();
        };
    };
}
