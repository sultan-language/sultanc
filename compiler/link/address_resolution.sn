استورد compiler.link.context;
استورد compiler.link.section_model;
استورد compiler.link.layout_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;

عام نوع نتيجة_حل_عنوان_ربط =
    | نجح بنوع غير_موقع
    | رمز_ديناميكي بنوع معرف_رمز_ربط
    | غير_محلول
;

عام عرف حل_عنوان_قسم_ربط(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط,
    الإزاحة: غير_موقع
): نتيجة_حل_عنوان_ربط {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
    }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };

    طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, القسم) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
    }
    | اختيار.بعض(الموضع) -> {
        طابق الموضع.العنوان_الافتراضي مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
        }
        | اختيار.بعض(العنوان) -> {
            لو (الإزاحة > الموضع.حجم_الذاكرة) {
                أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
            };
            أرجع نتيجة_حل_عنوان_ربط.نجح(العنوان + الإزاحة);
        };
    };
}

عام عرف حل_عنوان_رمز_ربط(
    السياق: &سياق_ربط,
    المعرف: معرف_رمز_ربط
): نتيجة_حل_عنوان_ربط {
    دع الرمز: رمز_ربط;
    طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
    }
    | اختيار.بعض(القيمة) -> { الرمز := القيمة; };

    طابق الرمز.الحالة مع
    | حالة_رمز_ربط.غير_معرف(_) -> {
        أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
    }
    | حالة_رمز_ربط.كسول(_, _) -> {
        أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
    }
    | حالة_رمز_ربط.ديناميكي(_) -> {
        أرجع نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف);
    }
    | حالة_رمز_ربط.معرف(التعريف) -> {
        طابق التعريف.الموضع مع
        | موضع_تعريف_رمز_ربط.غير_محدد -> {
            أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
        }
        | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> {
            أرجع نتيجة_حل_عنوان_ربط.نجح(العنوان);
        }
        | موضع_تعريف_رمز_ربط.قسم(القسم, الإزاحة) -> {
            أرجع حل_عنوان_قسم_ربط(السياق, القسم, الإزاحة);
        };
    };
}

عام عرف حل_عنوان_مرجع_إزاحة_ربط(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط
): نتيجة_حل_عنوان_ربط {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(القسم) -> {
        أرجع حل_عنوان_قسم_ربط(السياق, القسم, 0);
    }
    | مرجع_إزاحة_ربط.رمز(الرمز) -> {
        أرجع حل_عنوان_رمز_ربط(السياق, الرمز);
    };
}
