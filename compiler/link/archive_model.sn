استورد std.text.from_bytes;
استورد compiler.link.model;
استورد std.collections.map;

// Archive parsing belongs to the selected object-format provider. The generic
// linker only owns member identity and the extraction state required by symbol
// resolution, so ELF/Mach-O/COFF archives share the same lazy-loading policy.
عام نوع معرف_عضو_أرشيف_ربط = {
    الأرشيف: معرف_مدخل_ربط,
    الموضع: طبيعي
};

عام عرف معرفا_عضو_أرشيف_ربط_متساويان(
    المعرف_الأول: معرف_عضو_أرشيف_ربط,
    المعرف_الثاني: معرف_عضو_أرشيف_ربط
): منطقي {
    أرجع معرفا_مدخل_ربط_متساويان(
        المعرف_الأول.الأرشيف,
        المعرف_الثاني.الأرشيف
    ) && المعرف_الأول.الموضع == المعرف_الثاني.الموضع;
}

عام نوع حالة_عضو_أرشيف_ربط =
    | كسول
    | مطلوب
    | مستخرج بنوع معرف_مدخل_ربط
;

عام نوع مصدر_عضو_أرشيف_ربط =
    | مضمّن بنوع (طبيعي, طبيعي)
    | ملف_خارجي بنوع نص
;

عام نوع عضو_أرشيف_ربط = {
    المعرف: معرف_عضو_أرشيف_ربط,
    المصدر: مصدر_عضو_أرشيف_ربط,
    الحالة: حالة_عضو_أرشيف_ربط
};

// الأعضاء holds every lazy member in registration order, which is the order
// requested members are extracted in (أول_عضو_أرشيف_ربط_مطلوب). الفهرس maps
// a member identity to its position in الأعضاء; it is an index over the same
// members, not a second registry, and is only written together with
// الأعضاء. Its key is the identity's two numbers [archive input, header
// offset] (مفتاح_فهرس_عضو_أرشيف_ربط): the map is generic over builtin key
// types only. Previously every lookup, extraction request and extraction mark
// scanned all registered members.
عام نوع سجل_أرشيف_ربط = {
    الأعضاء: متجه عضو_أرشيف_ربط,
    الفهرس: الخريطة<متجه طبيعي, طبيعي>
};

عرف مفتاح_فهرس_عضو_أرشيف_ربط(المعرف: معرف_عضو_أرشيف_ربط): متجه طبيعي {
    دع المفتاح: متجه طبيعي = [المعرف.الأرشيف.القيمة, المعرف.الموضع];
    أرجع المفتاح;
}

عرف هاش_مفتاح_عضو_أرشيف_ربط(المفتاح: &متجه طبيعي): طبيعي {
    لو ((الطول(*المفتاح) مثل طبيعي) != 2) { أرجع 0; };
    // Both parts are reduced below 2^32 first, so the arithmetic cannot
    // overflow the 64-bit uint whatever the archive id or member offset.
    دع الأرشيف: طبيعي = (*المفتاح)[0] % 4294967296;
    دع الموضع: طبيعي = (*المفتاح)[1] % 4294967296;
    أرجع الأرشيف * 65599 + الموضع;
}

عرف مفتاحا_عضو_أرشيف_ربط_متساويان(
    الأول: &متجه طبيعي,
    الثاني: &متجه طبيعي
): منطقي {
    لو ((الطول(*الأول) مثل طبيعي) != 2 || (الطول(*الثاني) مثل طبيعي) != 2) {
        أرجع خطأ;
    };
    أرجع (*الأول)[0] == (*الثاني)[0] && (*الأول)[1] == (*الثاني)[1];
}

// The position of a registered member in الأعضاء.
عرف موضع_عضو_أرشيف_ربط(
    السجل: &سجل_أرشيف_ربط,
    المعرف: معرف_عضو_أرشيف_ربط
): اختياري طبيعي {
    دع المفتاح: متجه طبيعي = مفتاح_فهرس_عضو_أرشيف_ربط(المعرف);
    طابق ابحث_في_الخريطة(&(*السجل).الفهرس, &المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        لو (الموضع >= (الطول((*السجل).الأعضاء) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(الموضع);
    };
}

عرف انسخ_نص_مصدر_عضو_أرشيف_ربط(القيمة: &نص): نص {
    دع النسخة: نص = انسخ_نص(القيمة);
    أرجع النسخة;
}

عرف انسخ_مصدر_عضو_أرشيف_ربط(
    المصدر: &مصدر_عضو_أرشيف_ربط
): مصدر_عضو_أرشيف_ربط {
    طابق *المصدر مع
    | مصدر_عضو_أرشيف_ربط.مضمّن(البداية, الحجم) -> {
        أرجع مصدر_عضو_أرشيف_ربط.مضمّن(البداية, الحجم);
    }
    | مصدر_عضو_أرشيف_ربط.ملف_خارجي(المسار) -> {
        دع نسخة_المسار: نص = انسخ_نص_مصدر_عضو_أرشيف_ربط(&المسار);
        أرجع مصدر_عضو_أرشيف_ربط.ملف_خارجي(نسخة_المسار);
    };
}

عرف انسخ_حالة_عضو_أرشيف_ربط(
    الحالة: &حالة_عضو_أرشيف_ربط
): حالة_عضو_أرشيف_ربط {
    طابق *الحالة مع
    | حالة_عضو_أرشيف_ربط.كسول -> {
        أرجع حالة_عضو_أرشيف_ربط.كسول();
    }
    | حالة_عضو_أرشيف_ربط.مطلوب -> {
        أرجع حالة_عضو_أرشيف_ربط.مطلوب();
    }
    | حالة_عضو_أرشيف_ربط.مستخرج(المعرف) -> {
        أرجع حالة_عضو_أرشيف_ربط.مستخرج(المعرف);
    };
}

عرف انسخ_عضو_أرشيف_ربط(العضو: &عضو_أرشيف_ربط): عضو_أرشيف_ربط {
    دع المصدر: مصدر_عضو_أرشيف_ربط =
        انسخ_مصدر_عضو_أرشيف_ربط(&(*العضو).المصدر);
    دع الحالة: حالة_عضو_أرشيف_ربط =
        انسخ_حالة_عضو_أرشيف_ربط(&(*العضو).الحالة);
    دع النسخة: عضو_أرشيف_ربط = {
        المعرف: (*العضو).المعرف,
        المصدر: المصدر,
        الحالة: الحالة
    };
    أرجع النسخة;
}

عام عرف أنشئ_سجل_أرشيف_ربط(): سجل_أرشيف_ربط {
    دع الأعضاء: متجه عضو_أرشيف_ربط = [];
    دع الفهرس: الخريطة<متجه طبيعي, طبيعي> = أنشئ_الخريطة(
        هاش_مفتاح_عضو_أرشيف_ربط,
        مفتاحا_عضو_أرشيف_ربط_متساويان
    );
    دع السجل: سجل_أرشيف_ربط = { الأعضاء: الأعضاء, الفهرس: الفهرس };
    أرجع السجل;
}

عام عرف ابحث_عضو_أرشيف_ربط(
    السجل: &سجل_أرشيف_ربط,
    المعرف: معرف_عضو_أرشيف_ربط
): اختياري عضو_أرشيف_ربط {
    طابق موضع_عضو_أرشيف_ربط(السجل, المعرف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        دع النسخة: عضو_أرشيف_ربط = انسخ_عضو_أرشيف_ربط(&(*السجل).الأعضاء[الموضع]);
        أرجع اختياري.موجود(النسخة);
    };
}

// The outcome of registering a lazy member. A member is registered only when
// both الأعضاء and its index entry hold it; when the index cannot grow the
// registry is left exactly as it was and the caller gets the capacity
// failure, so no lazy symbol can name a member the registry does not hold.
// Previously that failure still returned the member id, and the callers
// published a lazy symbol whose member could never be found or extracted.
عام نوع نتيجة_تسجيل_عضو_أرشيف_ربط =
    | مسجل بنوع معرف_عضو_أرشيف_ربط
    | سعة_غير_قابلة_للتمثيل
;

// Registers a lazy member, or returns the already registered one with the
// same identity (archive input, header offset), keeping its first source and
// registration order.
عام عرف سجل_عضو_أرشيف_ربط_كسولا_بمصدر(
    السجل: &متغير سجل_أرشيف_ربط,
    الأرشيف: معرف_مدخل_ربط,
    موضع_الرأس: طبيعي,
    المصدر: مصدر_عضو_أرشيف_ربط
): نتيجة_تسجيل_عضو_أرشيف_ربط {
    دع المعرف: معرف_عضو_أرشيف_ربط = {
        الأرشيف: الأرشيف,
        الموضع: موضع_الرأس
    };
    طابق موضع_عضو_أرشيف_ربط(السجل, المعرف) مع
    | اختياري.موجود(_) -> { أرجع نتيجة_تسجيل_عضو_أرشيف_ربط.مسجل(المعرف); }
    | اختياري.لا_شيء -> { };
    // The index entry is committed first; أدرج_في_الخريطة leaves the map
    // unchanged when it fails, and الأعضاء is appended only after it succeeds.
    دع الموضع: طبيعي = الطول((*السجل).الأعضاء) مثل طبيعي;
    طابق أدرج_في_الخريطة(
        &متغير (*السجل).الفهرس,
        مفتاح_فهرس_عضو_أرشيف_ربط(المعرف),
        الموضع
    ) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة_تسجيل_عضو_أرشيف_ربط.سعة_غير_قابلة_للتمثيل();
    }
    | نتيجة.نجح(_) -> { };
    دع العضو: عضو_أرشيف_ربط = {
        المعرف: المعرف,
        المصدر: المصدر,
        الحالة: حالة_عضو_أرشيف_ربط.كسول()
    };
    ألحق((*السجل).الأعضاء, العضو);
    أرجع نتيجة_تسجيل_عضو_أرشيف_ربط.مسجل(المعرف);
}

عام عرف سجل_عضو_أرشيف_ربط_كسولا(
    السجل: &متغير سجل_أرشيف_ربط,
    الأرشيف: معرف_مدخل_ربط,
    موضع_الرأس: طبيعي,
    موضع_المحتوى: طبيعي,
    الحجم: طبيعي
): نتيجة_تسجيل_عضو_أرشيف_ربط {
    أرجع سجل_عضو_أرشيف_ربط_كسولا_بمصدر(
        السجل,
        الأرشيف,
        موضع_الرأس,
        مصدر_عضو_أرشيف_ربط.مضمّن(موضع_المحتوى, الحجم)
    );
}

عام عرف سجل_عضو_أرشيف_ربط_كسولا_بملف(
    السجل: &متغير سجل_أرشيف_ربط,
    الأرشيف: معرف_مدخل_ربط,
    موضع_الرأس: طبيعي,
    المسار: نص
): نتيجة_تسجيل_عضو_أرشيف_ربط {
    أرجع سجل_عضو_أرشيف_ربط_كسولا_بمصدر(
        السجل,
        الأرشيف,
        موضع_الرأس,
        مصدر_عضو_أرشيف_ربط.ملف_خارجي(المسار)
    );
}

عام عرف اطلب_استخراج_عضو_أرشيف_ربط(
    السجل: &متغير سجل_أرشيف_ربط,
    المعرف: معرف_عضو_أرشيف_ربط
): منطقي {
    دع فهرس_العضو: طبيعي;
    طابق موضع_عضو_أرشيف_ربط(السجل, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الموضع) -> { فهرس_العضو := الموضع; };
    طابق (*السجل).الأعضاء[فهرس_العضو].الحالة مع
    | حالة_عضو_أرشيف_ربط.كسول -> {
        (*السجل).الأعضاء[فهرس_العضو].الحالة := حالة_عضو_أرشيف_ربط.مطلوب();
    }
    | حالة_عضو_أرشيف_ربط.مطلوب -> { }
    | حالة_عضو_أرشيف_ربط.مستخرج(_) -> { };
    أرجع صواب;
}

عام عرف علّم_عضو_أرشيف_ربط_مستخرجا(
    السجل: &متغير سجل_أرشيف_ربط,
    المعرف: معرف_عضو_أرشيف_ربط,
    المدخل_الجديد: معرف_مدخل_ربط
): منطقي {
    طابق موضع_عضو_أرشيف_ربط(السجل, المعرف) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الموضع) -> {
        (*السجل).الأعضاء[الموضع].الحالة :=
            حالة_عضو_أرشيف_ربط.مستخرج(المدخل_الجديد);
        أرجع صواب;
    };
}

عام عرف أول_عضو_أرشيف_ربط_مطلوب(
    السجل: &سجل_أرشيف_ربط
): اختياري عضو_أرشيف_ربط {
    دع فهرس_العضو: متغير طبيعي = 0;
    طالما (فهرس_العضو < (الطول((*السجل).الأعضاء) مثل طبيعي)) {
        دع العضو: &عضو_أرشيف_ربط = &(*السجل).الأعضاء[فهرس_العضو];
        طابق (*العضو).الحالة مع
        | حالة_عضو_أرشيف_ربط.مطلوب -> {
            دع النسخة: عضو_أرشيف_ربط = انسخ_عضو_أرشيف_ربط(العضو);
            أرجع اختياري.موجود(النسخة);
        }
        | _ -> { };
        فهرس_العضو := فهرس_العضو + 1;
    }
    أرجع اختياري.لا_شيء();
}

