استورد compiler.link.model;
استورد compiler.link.context;
استورد compiler.link.input_ingest;
استورد compiler.link.provider;
استورد compiler.link.elf.linker;
استورد compiler.link.macho.linker;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.link.dependency.llvm;
استورد compiler.link.entry_policy;

// Driver/backend boundaries provide only link inputs. Undefined symbols are
// discovered from object symbol tables; no semantic/backend symbol list is
// admitted into the linker.
عام نوع طلب_ربط_تنفيذي = {
    الخطة: خطة_ربط
};

عام عرف جهز_طلب_ربط_تنفيذي(
    البايتات: متجه غ8,
    الهدف: &واصف_هدف
): طلب_ربط_تنفيذي {
    دع واصف_الهدف: واصف_هدف = *الهدف;
    دع الخطة: متغير خطة_ربط = أنشئ_خطة_ربط(
        واصف_الهدف.المعرف,
        نوع_خرج_ربط.تنفيذي()
    );
    أضف_كائن_إلى_خطة_ربط(&متغير الخطة, البايتات);
    دع الطلب: طلب_ربط_تنفيذي = {
        الخطة: الخطة
    };
    أرجع الطلب;
}

عام نوع خطأ_ربط_تنفيذي =
    | هدف_غير_مسجل بنوع معرف_هدف
    | مزود_ربط_غير_متاح بنوع معرف_هدف
    | تنفيذ_هدف_غير_مدعوم بنوع معرف_هدف
    | خطة_غير_مدعومة
    | ماتشو_كائن_غير_صالح
    | ماتشو_رمز_دخول_مفقود
    | ماتشو_رمز_خارجي_غير_مدعوم
    | ماتشو_إزاحة_غير_مدعومة
    | ماتشو_إزاحة_خارج_النطاق
    | ماتشو_توقيع_فشل
    | إلف_كائن_غير_صالح
    | إلف_رمز_دخول_مفقود
    | إلف_رمز_خارجي_غير_معروف
;

عام نوع نتيجة_ربط_تنفيذي =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_ربط_تنفيذي
;


عام عرف اربط_تنفيذيا(
    الطلب: &متغير طلب_ربط_تنفيذي
): نتيجة_ربط_تنفيذي {
    دع طلب_الربط: طلب_ربط_تنفيذي = *الطلب;
    دع الخطة: خطة_ربط;
    طابق طلب_الربط مع
    | { الخطة: خطة_الربط } -> { الخطة := خطة_الربط; };

    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(الخطة.الهدف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_ربط_تنفيذي.خطأ(
            خطأ_ربط_تنفيذي.هدف_غير_مسجل(الخطة.الهدف)
        );
    }
    | نتيجة_حل_هدف.محلول(وصف) -> { الهدف := وصف; };

    طابق الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { }
    | _ -> {
        أرجع نتيجة_ربط_تنفيذي.خطأ(
            خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
        );
    };

    لو (!يدعم_مزود_الربط_تنفيذيا(&الهدف)) {
        أرجع نتيجة_ربط_تنفيذي.خطأ(
            خطأ_ربط_تنفيذي.تنفيذ_هدف_غير_مدعوم(الهدف.المعرف)
        );
    };

    // Build canonical link facts for every ordinary object before dependency
    // resolution. Active final-image providers consume the same canonical
    // multi-object linker context.
    دع السياق: متغير سياق_ربط = أنشئ_سياق_ربط(الخطة, الهدف);
    طابق استوعب_كائنات_خطة_الربط_في_السياق(&متغير السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(_) -> {
        طابق مزود_ربط_للهدف(&السياق.الهدف) مع
        | هوية_مزود_ربط.ماتشو -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.ماتشو_كائن_غير_صالح()
            );
        }
        | هوية_مزود_ربط.إلف -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.إلف_كائن_غير_صالح()
            );
        }
        | _ -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
            );
        };
    };

    أضف_اعتماد_إل_إل_في_إم_عند_الحاجة(
        &متغير السياق.الخطة,
        &السياق.الرموز,
        &السياق.الهدف
    );

    طابق أضف_جذر_دخول_خطة_الربط(&متغير السياق) مع
    | نتيجة_تهيئة_دخول_ربط.نجح -> { }
    | نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود -> {
        طابق مزود_ربط_للهدف(&السياق.الهدف) مع
        | هوية_مزود_ربط.ماتشو -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.ماتشو_رمز_دخول_مفقود()
            );
        }
        | هوية_مزود_ربط.إلف -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.إلف_رمز_دخول_مفقود()
            );
        }
        | _ -> {
            أرجع نتيجة_ربط_تنفيذي.خطأ(
                خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
            );
        };
    }
    | نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم -> {
        أرجع نتيجة_ربط_تنفيذي.خطأ(
            خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
        );
    };
    طبق_سياسة_وصول_سياق_الربط(&متغير السياق);


    // Native and LLVM objects converge here. Only Target/object format chooses
    // the provider; the producer is intentionally unknowable to the linker.
    طابق مزود_ربط_للهدف(&السياق.الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        طابق اربط_ماتشو_داروين_تنفيذيا(&متغير السياق) مع
        | نتيجة_مزود_ربط_ماتشو.نجح(البايتات) -> {
            أرجع نتيجة_ربط_تنفيذي.نجح(البايتات);
        }
        | نتيجة_مزود_ربط_ماتشو.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_مزود_ربط_ماتشو.كائن_غير_صالح -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_كائن_غير_صالح()
                );
            }
            | خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
                );
            }
            | خطأ_مزود_ربط_ماتشو.رمز_دخول_مفقود -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_رمز_دخول_مفقود()
                );
            }
            | خطأ_مزود_ربط_ماتشو.رمز_خارجي_غير_مدعوم -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_رمز_خارجي_غير_مدعوم()
                );
            }
            | خطأ_مزود_ربط_ماتشو.إزاحة_غير_مدعومة -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_إزاحة_غير_مدعومة()
                );
            }
            | خطأ_مزود_ربط_ماتشو.إزاحة_خارج_النطاق -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_إزاحة_خارج_النطاق()
                );
            }
            | خطأ_مزود_ربط_ماتشو.توقيع_فشل -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.ماتشو_توقيع_فشل()
                );
            };
        };
    }
    | هوية_مزود_ربط.إلف -> {
        طابق اربط_إلف_لينكس_تنفيذيا(&متغير السياق) مع
        | نتيجة_مزود_ربط_إلف.نجح(البايتات) -> {
            أرجع نتيجة_ربط_تنفيذي.نجح(البايتات);
        }
        | نتيجة_مزود_ربط_إلف.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_مزود_ربط_إلف.كائن_غير_صالح -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.إلف_كائن_غير_صالح()
                );
            }
            | خطأ_مزود_ربط_إلف.خطة_غير_مدعومة -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.خطة_غير_مدعومة()
                );
            }
            | خطأ_مزود_ربط_إلف.رمز_دخول_مفقود -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.إلف_رمز_دخول_مفقود()
                );
            }
            | خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف -> {
                أرجع نتيجة_ربط_تنفيذي.خطأ(
                    خطأ_ربط_تنفيذي.إلف_رمز_خارجي_غير_معروف()
                );
            };
        };
    }
    | _ -> {
        أرجع نتيجة_ربط_تنفيذي.خطأ(
            خطأ_ربط_تنفيذي.مزود_ربط_غير_متاح(السياق.الهدف.المعرف)
        );
    };
}
