عام نوع طلب_ربط = {
    الخطة: خطة_ربط
};

عام عرف جهز_طلب_ربط_بنوع(
    البايتات: متجه غ8,
    الهدف: &واصف_هدف,
    الخرج: نوع_خرج_ربط
): طلب_ربط {
    دع واصف_الهدف: واصف_هدف = *الهدف;
    دع الخطة: متغير خطة_ربط = أنشئ_خطة_ربط(
        واصف_الهدف.المعرف,
        الخرج
    );
    أضف_كائن_إلى_خطة_ربط(&متغير الخطة, البايتات);
    دع الطلب: طلب_ربط = { الخطة: الخطة };
    أرجع الطلب;
}

عام عرف جهز_طلب_ربط(
    البايتات: متجه غ8,
    الهدف: &واصف_هدف
): طلب_ربط {
    أرجع جهز_طلب_ربط_بنوع(
        البايتات,
        الهدف,
        نوع_خرج_ربط.تنفيذي()
    );
}

عام نوع خطأ_ربط =
    | هدف_غير_مسجل بنوع معرف_هدف
    | مزود_ربط_غير_متاح بنوع معرف_هدف
    | خرج_هدف_غير_مدعوم بنوع (معرف_هدف, نوع_خرج_ربط)
    | خطة_غير_مدعومة
    | بيانات_أداة_ربط_مفقودة
    | مدخل_ملف_غير_مقروء بنوع (نص, عدد)
    | ماتشو_كائن_غير_صالح
    | ماتشو_رمز_دخول_مفقود
    | ماتشو_رمز_خارجي_غير_مدعوم
    | ماتشو_إزاحة_غير_مدعومة
    | ماتشو_إزاحة_خارج_النطاق
    | ماتشو_توقيع_فشل
    | إلف_كائن_غير_صالح
    | إلف_رمز_دخول_مفقود
    | إلف_رمز_خارجي_غير_معروف
    | إلف_بيانات_أداة_مفقودة
    | إلف_أرشيف_رفيع_بلا_مسار
    | إلف_فشل_مساحة_عمل بنوع عدد
    | إلف_فشل_كتابة_مدخل بنوع عدد
    | إلف_فشل_تشغيل_الرابط بنوع عدد
    | إلف_فشل_قراءة_المخرج بنوع عدد
    | كوف_كائن_غير_صالح
    | كوف_رمز_دخول_مفقود
    | كوف_رمز_خارجي_غير_محلول
    | كوف_إزاحة_غير_مدعومة
    | كوف_إزاحة_خارج_النطاق
    | ويب_أسمبلي_وحدة_غير_صالحة
    | ويب_أسمبلي_رمز_دخول_مفقود
    | ويب_أسمبلي_بيانات_أداة_مفقودة
    | ويب_أسمبلي_أرشيف_رفيع_بلا_مسار
    | ويب_أسمبلي_فشل_مساحة_عمل بنوع عدد
    | ويب_أسمبلي_فشل_كتابة_مدخل بنوع عدد
    | ويب_أسمبلي_فشل_تشغيل_الرابط بنوع عدد
    | ويب_أسمبلي_فشل_قراءة_المخرج بنوع عدد
    | سبير_في_وحدة_غير_صالحة
    | سبير_في_بيانات_أداة_مفقودة
    | سبير_في_فشل_مساحة_عمل بنوع عدد
    | سبير_في_فشل_كتابة_مدخل بنوع عدد
    | سبير_في_فشل_تشغيل_الرابط بنوع عدد
    | سبير_في_فشل_قراءة_المخرج بنوع عدد
;

عام نوع نتيجة_ربط =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_ربط
;

عرف خطأ_استيعاب_للربط(السياق: &سياق_ربط): نتيجة_ربط {
    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.إلف -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة());
    }
    | هوية_مزود_ربط.سبير_في -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.سبير_في_وحدة_غير_صالحة());
    }
    | _ -> { أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة()); };
}

عرف جهز_وصول_خرج_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_ربط {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        طابق أضف_جذر_دخول_خطة_الربط(السياق) مع
        | نتيجة_تهيئة_دخول_ربط.نجح -> { }
        | نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود -> {
            طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
            | هوية_مزود_ربط.ماتشو -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.إلف -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.كوف -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.ويب_أسمبلي -> {
                أرجع نتيجة_ربط.خطأ(
                    خطأ_ربط.ويب_أسمبلي_رمز_دخول_مفقود()
                );
            }
            | _ -> { أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة()); };
        }
        | نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        };
        طبق_سياسة_وصول_سياق_الربط(السياق);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        أضف_جذور_تعريفات_مشتركة_للربط(
            &متغير (*السياق).الوصول,
            &(*السياق).الرموز
        );
        طبق_سياسة_وصول_سياق_الربط(السياق);
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        علّم_كل_أقسام_الربط_حية(&متغير (*السياق).الأقسام);
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        علّم_كل_أقسام_الربط_حية(&متغير (*السياق).الأقسام);
    };
    دع بايتات_فارغة: متجه غ8 = [];
    أرجع نتيجة_ربط.نجح(بايتات_فارغة);
}

عرف يحتاج_اعتمادات_ديناميكية_خارجية(
    الخرج: نوع_خرج_ربط
): منطقي {
    طابق الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { أرجع صواب; }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { أرجع صواب; }
    | نوع_خرج_ربط.كائن_مترابط -> { أرجع خطأ; }
    | نوع_خرج_ربط.وحدة_هدف -> { أرجع خطأ; };
}

عرف حوّل_نتيجة_مزود_ماتشو(
    النتيجة: نتيجة_مزود_ربط_ماتشو
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_ماتشو.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_ماتشو.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_ماتشو.كائن_غير_صالح -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_كائن_غير_صالح());
        }
        | خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_ماتشو.رمز_دخول_مفقود -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_دخول_مفقود());
        }
        | خطأ_مزود_ربط_ماتشو.رمز_خارجي_غير_مدعوم -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_خارجي_غير_مدعوم());
        }
        | خطأ_مزود_ربط_ماتشو.إزاحة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_إزاحة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_ماتشو.إزاحة_خارج_النطاق -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_إزاحة_خارج_النطاق());
        }
        | خطأ_مزود_ربط_ماتشو.توقيع_فشل -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_توقيع_فشل());
        };
    };
}

عرف حوّل_نتيجة_مزود_إلف(
    النتيجة: نتيجة_مزود_ربط_إلف
): نتيجة_ربط {
