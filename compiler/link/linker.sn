            );
        }
        | خطأ_مزود_ربط_سبير_في.تشغيل_الرابط_فشل(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(
                خطأ_ربط.سبير_في_فشل_تشغيل_الرابط(الحالة)
            );
        }
        | خطأ_مزود_ربط_سبير_في.قراءة_المخرج_فشلت(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(
                خطأ_ربط.سبير_في_فشل_قراءة_المخرج(الحالة)
            );
        };
    };
}

عام عرف اربط(
    الطلب: طلب_ربط
): نتيجة_ربط {
    دع الخطة: خطة_ربط = انسخ_خطة_ربط(&الطلب.الخطة);
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(الخطة.الهدف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.هدف_غير_مسجل(الخطة.الهدف));
    }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := الوصف; };

    لو (!يدعم_مزود_الربط(&الهدف, الخطة.الخرج)) {
        أرجع نتيجة_ربط.خطأ(
            خطأ_ربط.خرج_هدف_غير_مدعوم(الهدف.المعرف, الخطة.الخرج)
        );
    };

    دع السياق: متغير سياق_ربط = أنشئ_سياق_ربط(الخطة, الهدف);
    طابق استوعب_كائنات_خطة_الربط_في_السياق(&متغير السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(_) -> {
        أرجع خطأ_استيعاب_للربط(&السياق);
    };

    طابق أضف_كائن_تشغيل_الهدف_عند_الحاجة(&متغير السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(_) -> {
        أرجع خطأ_استيعاب_للربط(&السياق);
    };

    لو (يحتاج_اعتمادات_ديناميكية_خارجية(السياق.الخطة.الخرج)) {
        لو (!أضف_اعتماد_إل_إل_في_إم_عند_الحاجة(
            &متغير السياق.الخطة,
            &السياق.الرموز,
            &السياق.الهدف
        )) {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.بيانات_أداة_ربط_مفقودة());
        };
    };

    طابق جهز_وصول_خرج_الربط(&متغير السياق) مع
    | نتيجة_ربط.نجح(_) -> { }
    | نتيجة_ربط.خطأ(الخطأ) -> { أرجع نتيجة_ربط.خطأ(الخطأ); };

    طابق مزود_ربط_للهدف(&السياق.الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        أرجع حوّل_نتيجة_مزود_ماتشو(اربط_ماتشو(&متغير السياق));
    }
    | هوية_مزود_ربط.إلف -> {
        أرجع حوّل_نتيجة_مزود_إلف(اربط_إلف(&متغير السياق));
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع حوّل_نتيجة_مزود_كوف(اربط_كوف(&متغير السياق));
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        أرجع حوّل_نتيجة_مزود_ويب_أسمبلي(اربط_ويب_أسمبلي(&السياق));
    }
    | هوية_مزود_ربط.سبير_في -> {
        أرجع حوّل_نتيجة_مزود_سبير_في(اربط_سبير_في(&السياق));
    }
    | _ -> {
        أرجع نتيجة_ربط.خطأ(
            خطأ_ربط.مزود_ربط_غير_متاح(السياق.الهدف.المعرف)
        );
    };
}
