        }
        | خطأ_مزود_ربط_إلف.رمز_دخول_مفقود -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_دخول_مفقود());
        }
        | خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_خارجي_غير_معروف());
        }
        | خطأ_مزود_ربط_إلف.بيانات_أداة_مفقودة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_بيانات_أداة_مفقودة());
        }
        | خطأ_مزود_ربط_إلف.أرشيف_رفيع_بلا_مسار -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_أرشيف_رفيع_بلا_مسار());
        }
        | خطأ_مزود_ربط_إلف.مساحة_عمل_مؤقتة_فشلت(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_فشل_مساحة_عمل(الحالة));
        }
        | خطأ_مزود_ربط_إلف.كتابة_مدخل_مؤقت_فشلت(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_فشل_كتابة_مدخل(الحالة));
        }
        | خطأ_مزود_ربط_إلف.تشغيل_الرابط_فشل(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_فشل_تشغيل_الرابط(الحالة));
        }
        | خطأ_مزود_ربط_إلف.قراءة_المخرج_فشلت(الحالة) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_فشل_قراءة_المخرج(الحالة));
        };
    };
}

