عام نوع طلب_ربط = {
    الخطة: خطة_ربط
};

عام عرف جهز_طلب_ربط_بنوع(
    البايتات: متجه غ8,
    الهدف: &واصف_هدف,
    الخرج: نوع_خرج_ربط
): طلب_ربط {
    دع واصف_الهدف: واصف_هدف = *الهدف;
    دع الخطة: متغير خطة_ربط = أنشئ_خطة_ربط(
        واصف_الهدف.المعرف,
        الخرج
    );
    أضف_كائن_إلى_خطة_ربط(&متغير الخطة, البايتات);
    دع الطلب: طلب_ربط = { الخطة: الخطة };
    أرجع الطلب;
}

عام عرف جهز_طلب_ربط(
    البايتات: متجه غ8,
    الهدف: &واصف_هدف
): طلب_ربط {
    أرجع جهز_طلب_ربط_بنوع(
        البايتات,
        الهدف,
        نوع_خرج_ربط.تنفيذي()
    );
}

عام نوع خطأ_ربط =
    | هدف_غير_مسجل بنوع معرف_هدف
    | مزود_ربط_غير_متاح بنوع معرف_هدف
    | خرج_هدف_غير_مدعوم بنوع (معرف_هدف, نوع_خرج_ربط)
    | خطة_غير_مدعومة
    // A GNU linker script input SultanC cannot apply (elf/linker_script.sn):
    // its path, and the command it could not apply (none when the script is
    // malformed or has no input command).
    | سكربت_جنو_غير_مدعوم بنوع (نص, اختيار نص)
    | سعة_رموز_غير_قابلة_للتمثيل
    // The output calls the LLVM C API and no libLLVM for its target was
    // supplied (link/dependency/llvm.sn): target triple, first LLVM symbol.
    | مكتبة_إل_إل_في_إم_للهدف_مفقودة بنوع (نص, نص)
    // The supplied libLLVM does not define this LLVM C API symbol.
    | رمز_إل_إل_في_إم_غير_محلول بنوع (نص, نص)
    | مدخل_ملف_غير_مقروء بنوع (نص, عدد)
    | ماتشو_كائن_غير_صالح
    | ماتشو_رمز_دخول_مفقود
    | ماتشو_رمز_خارجي_غير_مدعوم
    | ماتشو_إزاحة_غير_مدعومة
    | ماتشو_إزاحة_خارج_النطاق
    | ماتشو_توقيع_فشل
    | إلف_كائن_غير_صالح
    | إلف_رمز_دخول_مفقود
    // The undefined symbol no input or library defines, when the failure is
    // one symbol's.
    | إلف_رمز_خارجي_غير_معروف بنوع اختيار نص
    | كوف_كائن_غير_صالح
    | كوف_رمز_دخول_مفقود
    // The symbol the image could not bind, when the failure is one symbol's.
    | كوف_رمز_خارجي_غير_محلول بنوع اختيار نص
    // A `.drectve` option that is not allowed there or is malformed
    // (coff/directives.sn): the object's path, the rejected token.
    | كوف_توجيه_غير_صالح بنوع (اختيار نص, نص)
    // /FAILIFMISMATCH conflict: the path of the object giving the second
    // value, the key, the earlier value, the conflicting value.
    | كوف_تعارض_تطابق بنوع (اختيار نص, نص, نص, نص)
    | كوف_إزاحة_غير_مدعومة
    | كوف_إزاحة_خارج_النطاق
    | ويب_أسمبلي_وحدة_غير_صالحة
    | ويب_أسمبلي_رمز_دخول_مفقود
    | سبير_في_وحدة_غير_صالحة
;

عام نوع نتيجة_ربط =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_ربط
;

عرف خطأ_استيعاب_للربط(السياق: &سياق_ربط): نتيجة_ربط {
    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.إلف -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_كائن_غير_صالح());
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة());
    }
    | هوية_مزود_ربط.سبير_في -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.سبير_في_وحدة_غير_صالحة());
    }
    | _ -> { أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة()); };
}

عرف جهز_وصول_خرج_الربط(
    السياق: &متغير سياق_ربط
): نتيجة_ربط {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        طابق أضف_جذر_دخول_خطة_الربط(السياق) مع
        | نتيجة_تهيئة_دخول_ربط.نجح -> { }
        | نتيجة_تهيئة_دخول_ربط.رمز_دخول_غير_موجود -> {
            طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
            | هوية_مزود_ربط.ماتشو -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.إلف -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.كوف -> {
                أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_رمز_دخول_مفقود());
            }
            | هوية_مزود_ربط.ويب_أسمبلي -> {
                أرجع نتيجة_ربط.خطأ(
                    خطأ_ربط.ويب_أسمبلي_رمز_دخول_مفقود()
                );
            }
            | _ -> { أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة()); };
        }
        | نتيجة_تهيئة_دخول_ربط.مزود_غير_مدعوم -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        };
        طبق_سياسة_وصول_سياق_الربط(السياق);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        أضف_جذور_تعريفات_مشتركة_للربط(
            &متغير (*السياق).الوصول,
            &(*السياق).الرموز
        );
        طبق_سياسة_وصول_سياق_الربط(السياق);
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        علّم_كل_أقسام_الربط_حية(&متغير (*السياق).الأقسام);
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        علّم_كل_أقسام_الربط_حية(&متغير (*السياق).الأقسام);
    };
    دع بايتات_فارغة: متجه غ8 = [];
    أرجع نتيجة_ربط.نجح(بايتات_فارغة);
}

عرف خطأ_استيعاب_مدخل_للربط(
    السياق: &سياق_ربط,
    الخطأ: خطأ_استيعاب_مدخل_ربط
): نتيجة_ربط {
    طابق الخطأ مع
    | خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.سعة_رموز_غير_قابلة_للتمثيل());
    }
    | _ -> { أرجع خطأ_استيعاب_للربط(السياق); };
}

// Completes the input set before resolution policy runs. An executable's
// entry is an undefined root first (LLD --entry semantics), so an entry
// defined only in an input archive is extracted. COFF inputs then apply their
// `.drectve` directives and weak aliases (coff/directives.sn): /INCLUDE and
// /EXPORT roots, alternate names and weak-external defaults, followed by the
// Windows system imports; default-library directives load nothing, since
// SultanC links no C runtime. A rejected directive or a
// /FAILIFMISMATCH conflict fails the link naming the object and the directive
// (previously both were reported only as an invalid COFF object).
عرف أكمل_مدخلات_سياق_الربط(
    السياق: &متغير سياق_ربط
): اختيار نتيجة_ربط {
    لو ((*السياق).الخطة.الخرج == نوع_خرج_ربط.تنفيذي()) {
        طابق اسم_رمز_دخول_خطة_الربط(السياق) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(اسم_الدخول) -> {
            طابق استخرج_عضو_أرشيف_لرمز_جذر_في_السياق(
                السياق, &اسم_الدخول
            ) مع
            | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
            | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                أرجع اختيار.بعض(خطأ_استيعاب_مدخل_للربط(السياق, الخطأ));
            };
        };
    };
    لو (مزود_ربط_للهدف(&(*السياق).الهدف) == هوية_مزود_ربط.كوف()) {
        طابق أكمل_مدخلات_كوف_في_السياق(السياق) مع
        | نتيجة_إكمال_مدخلات_كوف.نجح -> { }
        | نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ) -> {
            أرجع اختيار.بعض(خطأ_استيعاب_مدخل_للربط(السياق, الخطأ));
        }
        | نتيجة_إكمال_مدخلات_كوف.توجيه_غير_صالح(المدخل, الرمز) -> {
            أرجع اختيار.بعض(نتيجة_ربط.خطأ(خطأ_ربط.كوف_توجيه_غير_صالح(
                مسار_مدخل_في_سياق_الربط(السياق, المدخل),
                من_بايتات(&الرمز)
            )));
        }
        | نتيجة_إكمال_مدخلات_كوف.تعارض_تطابق(المدخل, المفتاح, الأولى, الثانية) -> {
            أرجع اختيار.بعض(نتيجة_ربط.خطأ(خطأ_ربط.كوف_تعارض_تطابق(
                مسار_مدخل_في_سياق_الربط(السياق, المدخل),
                من_بايتات(&المفتاح),
                من_بايتات(&الأولى),
                من_بايتات(&الثانية)
            )));
        };
    };
    أرجع اختيار.لا_شيء();
}

عرف ثلاثي_هدف_سياق_ربط(السياق: &سياق_ربط): نص {
    دع المرجع: &نص = &(*السياق).الهدف.الثلاثي_المقنن;
    أرجع *المرجع;
}

عرف يحتاج_اعتمادات_ديناميكية_خارجية(
    الخرج: نوع_خرج_ربط
): منطقي {
    طابق الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { أرجع صواب; }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { أرجع صواب; }
    | نوع_خرج_ربط.كائن_مترابط -> { أرجع خطأ; }
    | نوع_خرج_ربط.وحدة_هدف -> { أرجع خطأ; };
}

عرف حوّل_نتيجة_مزود_ماتشو(
    النتيجة: نتيجة_مزود_ربط_ماتشو
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_ماتشو.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_ماتشو.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_ماتشو.كائن_غير_صالح -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_كائن_غير_صالح());
        }
        | خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_ماتشو.رمز_دخول_مفقود -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_دخول_مفقود());
        }
        | خطأ_مزود_ربط_ماتشو.رمز_خارجي_غير_مدعوم -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_رمز_خارجي_غير_مدعوم());
        }
        | خطأ_مزود_ربط_ماتشو.إزاحة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_إزاحة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_ماتشو.إزاحة_خارج_النطاق -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_إزاحة_خارج_النطاق());
        }
        | خطأ_مزود_ربط_ماتشو.توقيع_فشل -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ماتشو_توقيع_فشل());
        };
    };
}

// A symbol name for an unresolved-symbol error; none when the provider could
// not attribute the failure to one symbol (an empty name).
عرف اسم_رمز_لخطأ_ربط(الاسم: &متجه غ8): اختيار نص {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(من_بايتات(الاسم));
}

عرف حوّل_نتيجة_مزود_إلف(
    النتيجة: نتيجة_مزود_ربط_إلف
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_إلف.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_إلف.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_إلف.كائن_غير_صالح -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_كائن_غير_صالح());
        }
        | خطأ_مزود_ربط_إلف.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_إلف.رمز_دخول_مفقود -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_دخول_مفقود());
        }
        | خطأ_مزود_ربط_إلف.رمز_خارجي_غير_معروف(الاسم) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.إلف_رمز_خارجي_غير_معروف(
                اسم_رمز_لخطأ_ربط(&الاسم)
            ));
        };
    };
}

عرف حوّل_نتيجة_مزود_كوف(
    النتيجة: نتيجة_مزود_ربط_كوف
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_كوف.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_كوف.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_كوف.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_كوف.كائن_غير_صالح -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_كائن_غير_صالح());
        }
        | خطأ_مزود_ربط_كوف.رمز_دخول_مفقود -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_رمز_دخول_مفقود());
        }
        | خطأ_مزود_ربط_كوف.رمز_خارجي_غير_محلول(الاسم) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_رمز_خارجي_غير_محلول(
                اسم_رمز_لخطأ_ربط(&الاسم)
            ));
        }
        | خطأ_مزود_ربط_كوف.إزاحة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_إزاحة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_كوف.إزاحة_خارج_النطاق -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.كوف_إزاحة_خارج_النطاق());
        };
    };
}

عرف حوّل_نتيجة_مزود_ويب_أسمبلي(
    النتيجة: نتيجة_مزود_ربط_ويب_أسمبلي
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_ويب_أسمبلي.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة());
        };
    };
}

عرف حوّل_نتيجة_مزود_سبير_في(
    النتيجة: نتيجة_مزود_ربط_سبير_في
): نتيجة_ربط {
    طابق النتيجة مع
    | نتيجة_مزود_ربط_سبير_في.نجح(البايتات) -> {
        أرجع نتيجة_ربط.نجح(البايتات);
    }
    | نتيجة_مزود_ربط_سبير_في.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.خطة_غير_مدعومة());
        }
        | خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.سبير_في_وحدة_غير_صالحة());
        };
    };
}

عام عرف اربط(
    الطلب: طلب_ربط
): نتيجة_ربط {
    دع الخطة: خطة_ربط = انسخ_خطة_ربط(&الطلب.الخطة);
    دع الهدف: واصف_هدف;
    طابق حل_بمعرف_هدف(الخطة.الهدف) مع
    | نتيجة_حل_هدف.غير_مسجل -> {
        أرجع نتيجة_ربط.خطأ(خطأ_ربط.هدف_غير_مسجل(الخطة.الهدف));
    }
    | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := الوصف; };

    لو (!يدعم_مزود_الربط(&الهدف, الخطة.الخرج)) {
        أرجع نتيجة_ربط.خطأ(
            خطأ_ربط.خرج_هدف_غير_مدعوم(الهدف.المعرف, الخطة.الخرج)
        );
    };

    دع السياق: متغير سياق_ربط = أنشئ_سياق_ربط(الخطة, الهدف);
    طابق استوعب_كائنات_خطة_الربط_في_السياق(&متغير السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.سعة_رموز_غير_قابلة_للتمثيل());
        }
        | _ -> { أرجع خطأ_استيعاب_للربط(&السياق); };
    };
    طابق أكمل_مدخلات_سياق_الربط(&متغير السياق) مع
    | اختيار.بعض(الخطأ) -> { أرجع الخطأ; }
    | اختيار.لا_شيء -> { };

    لو (يحتاج_اعتمادات_ديناميكية_خارجية(السياق.الخطة.الخرج)) {
        دع ثلاثي_الهدف: نص = ثلاثي_هدف_سياق_ربط(&السياق);
        طابق حل_اعتماد_إل_إل_في_إم_للربط(&متغير السياق) مع
        | نتيجة_اعتماد_إل_إل_في_إم_ربط.نجح -> { }
        | نتيجة_اعتماد_إل_إل_في_إم_ربط.مكتبة_الهدف_مفقودة(الرمز) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.مكتبة_إل_إل_في_إم_للهدف_مفقودة(
                ثلاثي_الهدف,
                من_بايتات(&الرمز)
            ));
        }
        | نتيجة_اعتماد_إل_إل_في_إم_ربط.رمز_غير_محلول(الرمز) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.رمز_إل_إل_في_إم_غير_محلول(
                ثلاثي_الهدف,
                من_بايتات(&الرمز)
            ));
        }
        | نتيجة_اعتماد_إل_إل_في_إم_ربط.مدخل_غير_مقروء(المسار, الحالة) -> {
            أرجع نتيجة_ربط.خطأ(خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, الحالة));
        }
        | نتيجة_اعتماد_إل_إل_في_إم_ربط.استيعاب_فشل(الخطأ) -> {
            // The same mapping as every other ingestion failure: capacity
            // stays the capacity error, anything else an invalid input.
            أرجع خطأ_استيعاب_مدخل_للربط(&السياق, الخطأ);
        };
    };

    طابق جهز_وصول_خرج_الربط(&متغير السياق) مع
    | نتيجة_ربط.نجح(_) -> { }
    | نتيجة_ربط.خطأ(الخطأ) -> { أرجع نتيجة_ربط.خطأ(الخطأ); };

    طابق مزود_ربط_للهدف(&السياق.الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        أرجع حوّل_نتيجة_مزود_ماتشو(اربط_ماتشو(&متغير السياق));
    }
    | هوية_مزود_ربط.إلف -> {
        أرجع حوّل_نتيجة_مزود_إلف(اربط_إلف(&متغير السياق));
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع حوّل_نتيجة_مزود_كوف(اربط_كوف(&متغير السياق));
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        أرجع حوّل_نتيجة_مزود_ويب_أسمبلي(اربط_ويب_أسمبلي(&السياق));
    }
    | هوية_مزود_ربط.سبير_في -> {
        أرجع حوّل_نتيجة_مزود_سبير_في(اربط_سبير_في(&السياق));
    }
    | _ -> {
        أرجع نتيجة_ربط.خطأ(
            خطأ_ربط.مزود_ربط_غير_متاح(السياق.الهدف.المعرف)
        );
    };
}
