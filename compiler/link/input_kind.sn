استورد compiler.link.archive.ar_container;

// Input classification is based on container bytes, not filename spelling.
// The selected format provider remains responsible for validating the full file.
عام نوع نوع_ملف_مدخل_ربط =
    | كائن
    | أرشيف
    | مكتبة_ديناميكية
    | غير_معروف
;

عرف ضمن_حدود_تصنيف_مدخل_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عرف اقرأ_غ16_صغير_تصنيف_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    أرجع ((*البايتات)[الموضع] مثل غير_موقع)
        + ((*البايتات)[الموضع_الثاني] مثل غير_موقع) * 256;
}

عرف اقرأ_غ16_كبير_تصنيف_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    أرجع ((*البايتات)[الموضع] مثل غير_موقع) * 256
        + ((*البايتات)[الموضع_الثاني] مثل غير_موقع);
}

عرف اقرأ_غ32_صغير_تصنيف_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    دع الموضع_الثالث: غير_موقع = الموضع + 2;
    دع الموضع_الرابع: غير_موقع = الموضع + 3;
    أرجع ((*البايتات)[الموضع] مثل غير_موقع)
        + ((*البايتات)[الموضع_الثاني] مثل غير_موقع) * 256
        + ((*البايتات)[الموضع_الثالث] مثل غير_موقع) * 65536
        + ((*البايتات)[الموضع_الرابع] مثل غير_موقع) * 16777216;
}

عرف نوع_إلف_مدخل_ربط(البايتات: &متجه غ8): نوع_ملف_مدخل_ربط {
    لو (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 18)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    لو ((*البايتات)[0] != 0x7F
        || (*البايتات)[1] != 0x45
        || (*البايتات)[2] != 0x4C
        || (*البايتات)[3] != 0x46) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع النوع: غير_موقع;
    لو ((*البايتات)[5] == 1) {
        النوع := اقرأ_غ16_صغير_تصنيف_ربط(البايتات, 16);
    } وإلا لو ((*البايتات)[5] == 2) {
        النوع := اقرأ_غ16_كبير_تصنيف_ربط(البايتات, 16);
    } وإلا {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    لو (النوع == 1) { أرجع نوع_ملف_مدخل_ربط.كائن(); };
    لو (النوع == 3) { أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية(); };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_ماتشو_مدخل_ربط(البايتات: &متجه غ8): نوع_ملف_مدخل_ربط {
    لو (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 16)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    // MH_MAGIC_64 in little-endian file order.
    لو ((*البايتات)[0] != 0xCF
        || (*البايتات)[1] != 0xFA
        || (*البايتات)[2] != 0xED
        || (*البايتات)[3] != 0xFE) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع النوع: غير_موقع = اقرأ_غ32_صغير_تصنيف_ربط(البايتات, 12);
    لو (النوع == 1) { أرجع نوع_ملف_مدخل_ربط.كائن(); };
    لو (النوع == 6) { أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية(); };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_كوف_مدخل_ربط(
    البايتات: &متجه غ8
): نوع_ملف_مدخل_ربط {
    لو (ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 0x40)
        && (*البايتات)[0] == 0x4D
        && (*البايتات)[1] == 0x5A) {
        دع موضع_بي_إي: غير_موقع = اقرأ_غ32_صغير_تصنيف_ربط(
            البايتات,
            0x3C
        );
        دع موضع_بي_إي_الثاني: غير_موقع = موضع_بي_إي + 1;
        دع موضع_بي_إي_الثالث: غير_موقع = موضع_بي_إي + 2;
        دع موضع_بي_إي_الرابع: غير_موقع = موضع_بي_إي + 3;
        لو (ضمن_حدود_تصنيف_مدخل_ربط(البايتات, موضع_بي_إي, 24)
            && (*البايتات)[موضع_بي_إي] == 0x50
            && (*البايتات)[موضع_بي_إي_الثاني] == 0x45
            && (*البايتات)[موضع_بي_إي_الثالث] == 0
            && (*البايتات)[موضع_بي_إي_الرابع] == 0) {
            دع الخصائص: غير_موقع = اقرأ_غ16_صغير_تصنيف_ربط(
                البايتات,
                موضع_بي_إي + 22
            );
            لو ((الخصائص & 0x2000) != 0) {
                أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية();
            };
        };
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    لو (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 20)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    // Microsoft short import objects begin with Sig1=0 and Sig2=0xFFFF.
    لو (اقرأ_غ16_صغير_تصنيف_ربط(البايتات, 0) == 0
        && اقرأ_غ16_صغير_تصنيف_ربط(البايتات, 2) == 0xFFFF) {
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    دع الآلة: غير_موقع = اقرأ_غ16_صغير_تصنيف_ربط(البايتات, 0);
    لو (الآلة != 0x8664 && الآلة != 0xAA64) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع عدد_الأقسام: غير_موقع = اقرأ_غ16_صغير_تصنيف_ربط(
        البايتات,
        2
    );
    دع حجم_الرأس_الاختياري: غير_موقع = اقرأ_غ16_صغير_تصنيف_ربط(
        البايتات,
        16
    );
    لو (عدد_الأقسام == 0 || حجم_الرأس_الاختياري != 0) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    أرجع نوع_ملف_مدخل_ربط.كائن();
}

عرف نوع_سبير_في_مدخل_ربط(
    البايتات: &متجه غ8
): نوع_ملف_مدخل_ربط {
    لو (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 20)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع ترتيب_صغير: منطقي = (*البايتات)[0] == 0x03
        && (*البايتات)[1] == 0x02
        && (*البايتات)[2] == 0x23
        && (*البايتات)[3] == 0x07;
    دع ترتيب_كبير: منطقي = (*البايتات)[0] == 0x07
        && (*البايتات)[1] == 0x23
        && (*البايتات)[2] == 0x02
        && (*البايتات)[3] == 0x03;
    لو (ترتيب_صغير || ترتيب_كبير) {
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_ويب_أسمبلي_مدخل_ربط(
    البايتات: &متجه غ8
): نوع_ملف_مدخل_ربط {
    لو (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 8)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    لو ((*البايتات)[0] == 0
        && (*البايتات)[1] == 0x61
        && (*البايتات)[2] == 0x73
        && (*البايتات)[3] == 0x6D
        && (*البايتات)[4] == 1
        && (*البايتات)[5] == 0
        && (*البايتات)[6] == 0
        && (*البايتات)[7] == 0) {
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عام عرف صنف_ملف_مدخل_ربط(
    البايتات: &متجه غ8
): نوع_ملف_مدخل_ربط {
    لو (تحقق_أي_توقيع_حاوية_أرشيف(البايتات)) {
        أرجع نوع_ملف_مدخل_ربط.أرشيف();
    };
    طابق نوع_إلف_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_ماتشو_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_كوف_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_ويب_أسمبلي_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_سبير_في_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}
