استورد std.archive.ar;
استورد compiler.link.macho.text_stub;

// Input classification is based on container bytes, not filename spelling.
// The selected format provider remains responsible for validating the full file.
عام نوع نوع_ملف_مدخل_ربط =
    | كائن
    | أرشيف
    | مكتبة_ديناميكية
    | غير_معروف
;

عرف ضمن_حدود_تصنيف_مدخل_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عرف اقرأ_ط16_صغير_تصنيف_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الموضع_الثاني: طبيعي = الموضع + 1;
    أرجع ((*البايتات)[الموضع] مثل طبيعي)
        + ((*البايتات)[الموضع_الثاني] مثل طبيعي) * 256;
}

عرف اقرأ_ط16_كبير_تصنيف_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الموضع_الثاني: طبيعي = الموضع + 1;
    أرجع ((*البايتات)[الموضع] مثل طبيعي) * 256
        + ((*البايتات)[الموضع_الثاني] مثل طبيعي);
}

عرف اقرأ_ط32_صغير_تصنيف_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الموضع_الثاني: طبيعي = الموضع + 1;
    دع الموضع_الثالث: طبيعي = الموضع + 2;
    دع الموضع_الرابع: طبيعي = الموضع + 3;
    أرجع ((*البايتات)[الموضع] مثل طبيعي)
        + ((*البايتات)[الموضع_الثاني] مثل طبيعي) * 256
        + ((*البايتات)[الموضع_الثالث] مثل طبيعي) * 65536
        + ((*البايتات)[الموضع_الرابع] مثل طبيعي) * 16777216;
}

عرف نوع_إلف_مدخل_ربط(البايتات: &متجه ط8): نوع_ملف_مدخل_ربط {
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 18)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    إذا ((*البايتات)[0] != 0x7F
        || (*البايتات)[1] != 0x45
        || (*البايتات)[2] != 0x4C
        || (*البايتات)[3] != 0x46) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع النوع: طبيعي;
    إذا ((*البايتات)[5] == 1) {
        النوع := اقرأ_ط16_صغير_تصنيف_ربط(البايتات, 16);
    } وإلا إذا ((*البايتات)[5] == 2) {
        النوع := اقرأ_ط16_كبير_تصنيف_ربط(البايتات, 16);
    } وإلا {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    إذا (النوع == 1) { أرجع نوع_ملف_مدخل_ربط.كائن(); };
    إذا (النوع == 3) { أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية(); };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_ماتشو_مدخل_ربط(البايتات: &متجه ط8): نوع_ملف_مدخل_ربط {
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 16)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    // MH_MAGIC_64 in little-endian file order.
    إذا ((*البايتات)[0] != 0xCF
        || (*البايتات)[1] != 0xFA
        || (*البايتات)[2] != 0xED
        || (*البايتات)[3] != 0xFE) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع النوع: طبيعي = اقرأ_ط32_صغير_تصنيف_ربط(البايتات, 12);
    إذا (النوع == 1) { أرجع نوع_ملف_مدخل_ربط.كائن(); };
    إذا (النوع == 6) { أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية(); };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_كوف_مدخل_ربط(
    البايتات: &متجه ط8
): نوع_ملف_مدخل_ربط {
    إذا (ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 0x40)
        && (*البايتات)[0] == 0x4D
        && (*البايتات)[1] == 0x5A) {
        دع موضع_بي_إي: طبيعي = اقرأ_ط32_صغير_تصنيف_ربط(
            البايتات,
            0x3C
        );
        دع موضع_بي_إي_الثاني: طبيعي = موضع_بي_إي + 1;
        دع موضع_بي_إي_الثالث: طبيعي = موضع_بي_إي + 2;
        دع موضع_بي_إي_الرابع: طبيعي = موضع_بي_إي + 3;
        إذا (ضمن_حدود_تصنيف_مدخل_ربط(البايتات, موضع_بي_إي, 24)
            && (*البايتات)[موضع_بي_إي] == 0x50
            && (*البايتات)[موضع_بي_إي_الثاني] == 0x45
            && (*البايتات)[موضع_بي_إي_الثالث] == 0
            && (*البايتات)[موضع_بي_إي_الرابع] == 0) {
            دع الخصائص: طبيعي = اقرأ_ط16_صغير_تصنيف_ربط(
                البايتات,
                موضع_بي_إي + 22
            );
            إذا ((الخصائص & 0x2000) != 0) {
                أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية();
            };
        };
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 20)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    // Microsoft short import objects begin with Sig1=0 and Sig2=0xFFFF.
    إذا (اقرأ_ط16_صغير_تصنيف_ربط(البايتات, 0) == 0
        && اقرأ_ط16_صغير_تصنيف_ربط(البايتات, 2) == 0xFFFF) {
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    دع الآلة: طبيعي = اقرأ_ط16_صغير_تصنيف_ربط(البايتات, 0);
    إذا (الآلة != 0x8664 && الآلة != 0xAA64) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع عدد_الأقسام: طبيعي = اقرأ_ط16_صغير_تصنيف_ربط(
        البايتات,
        2
    );
    دع حجم_الرأس_الاختياري: طبيعي = اقرأ_ط16_صغير_تصنيف_ربط(
        البايتات,
        16
    );
    إذا (عدد_الأقسام == 0 || حجم_الرأس_الاختياري != 0) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    أرجع نوع_ملف_مدخل_ربط.كائن();
}

عرف نوع_سبير_في_مدخل_ربط(
    البايتات: &متجه ط8
): نوع_ملف_مدخل_ربط {
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 20)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    دع ترتيب_صغير: منطقي = (*البايتات)[0] == 0x03
        && (*البايتات)[1] == 0x02
        && (*البايتات)[2] == 0x23
        && (*البايتات)[3] == 0x07;
    دع ترتيب_كبير: منطقي = (*البايتات)[0] == 0x07
        && (*البايتات)[1] == 0x23
        && (*البايتات)[2] == 0x02
        && (*البايتات)[3] == 0x03;
    إذا (ترتيب_صغير || ترتيب_كبير) {
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

عرف نوع_ويب_أسمبلي_مدخل_ربط(
    البايتات: &متجه ط8
): نوع_ملف_مدخل_ربط {
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 0, 8)) {
        أرجع نوع_ملف_مدخل_ربط.غير_معروف();
    };
    إذا ((*البايتات)[0] == 0
        && (*البايتات)[1] == 0x61
        && (*البايتات)[2] == 0x73
        && (*البايتات)[3] == 0x6D
        && (*البايتات)[4] == 1
        && (*البايتات)[5] == 0
        && (*البايتات)[6] == 0
        && (*البايتات)[7] == 0) {
        إذا (وحدة_ويب_أسمبلي_مشتركة_تصنيف_ربط(البايتات)) {
            أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية();
        };
        أرجع نوع_ملف_مدخل_ربط.كائن();
    };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}

// A WebAssembly shared module (tool conventions DynamicLinking.md) starts
// with the custom section `dylink.0`, which the convention requires to be
// the first section; any other module (relocatable object or final module)
// is an object input.
عرف وحدة_ويب_أسمبلي_مشتركة_تصنيف_ربط(البايتات: &متجه ط8): منطقي {
    إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, 8, 1)) { أرجع خطأ; };
    إذا ((*البايتات)[8] != 0) { أرجع خطأ; };
    // The section size, then the name length (both LEB128).
    دع الموضع: متغير طبيعي = 9;
    دع الجولة: متغير طبيعي = 0;
    دع طول_الاسم: متغير طبيعي = 0;
    طالما (الجولة < 2) {
        دع القيمة: متغير طبيعي = 0;
        دع الإزاحة: متغير طبيعي = 0;
        دع منتهية: متغير منطقي = خطأ;
        طالما (!منتهية) {
            إذا (!ضمن_حدود_تصنيف_مدخل_ربط(البايتات, الموضع, 1)) { أرجع خطأ; };
            إذا (الإزاحة > 28) { أرجع خطأ; };
            دع البايت: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
            القيمة := القيمة | ((البايت & 0x7F) << الإزاحة);
            الموضع := الموضع + 1;
            الإزاحة := الإزاحة + 7;
            إذا ((البايت & 0x80) == 0) { منتهية := صواب; };
        }
        طول_الاسم := القيمة;
        الجولة := الجولة + 1;
    }
    دع الاسم: متجه ط8 = [0x64, 0x79, 0x6C, 0x69, 0x6E, 0x6B, 0x2E, 0x30]; // "dylink.0"
    إذا (طول_الاسم != 8 || !ضمن_حدود_تصنيف_مدخل_ربط(البايتات, الموضع, 8)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        إذا ((*البايتات)[الموضع + ف] != الاسم[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف صنف_ملف_مدخل_ربط(
    البايتات: &متجه ط8
): نوع_ملف_مدخل_ربط {
    إذا (تحقق_أي_توقيع_حاوية_أرشيف(البايتات)) {
        أرجع نوع_ملف_مدخل_ربط.أرشيف();
    };
    طابق نوع_إلف_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_ماتشو_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_كوف_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_ويب_أسمبلي_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    طابق نوع_سبير_في_مدخل_ربط(البايتات) مع
    | نوع_ملف_مدخل_ربط.غير_معروف -> { }
    | النوع -> { أرجع النوع; };
    // A text-based dylib stub (.tbd) stands for a Mach-O dylib
    // (macho/text_stub.sn).
    إذا (مكتبة_نصية_تابي(البايتات)) { أرجع نوع_ملف_مدخل_ربط.مكتبة_ديناميكية(); };
    أرجع نوع_ملف_مدخل_ربط.غير_معروف();
}
