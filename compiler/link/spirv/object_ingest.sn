استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.spirv.reader;
استورد compiler.backend.target.target_model;
استورد std.text.from_bytes;

عام نوع خطأ_استيعاب_سبير_في =
    | وحدة_غير_صالحة
    | هدف_غير_مطابق
;

عام نوع نتيجة_استيعاب_سبير_في =
    | نجح
    | خطأ بنوع خطأ_استيعاب_سبير_في
;

عرف انسخ_بايتات_وحدة_سبير_في(المصدر: &متجه ط8): متجه ط8 {
    دع النسخة: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(النسخة, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع النسخة;
}

عرف اسم_قسم_سبير_في_القانوني(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«.spirv»);
    أرجع الاسم;
}

عام عرف استوعب_وحدة_سبير_في_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_سبير_في {
    إذا ((*السياق).الهدف.صيغة_الكائن != صيغة_كائن_هدف.سبير_في()) {
        أرجع نتيجة_استيعاب_سبير_في.خطأ(
            خطأ_استيعاب_سبير_في.هدف_غير_مطابق()
        );
    };
    طابق صف_وحدة_سبير_في(&(*المدخل).البايتات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_سبير_في.خطأ(
            خطأ_استيعاب_سبير_في.وحدة_غير_صالحة()
        );
    }
    | اختياري.موجود(_) -> { };
    دع الهوية: هوية_اسم_قسم_ربط = {
        اسم_القسم: اسم_قسم_سبير_في_القانوني(),
        اسم_الحاوية: اختياري.لا_شيء()
    };
    دع نسخة_المحتوى: متجه ط8 = انسخ_بايتات_وحدة_سبير_في(&(*المدخل).البايتات);
    دع المحتوى: اختياري متجه ط8 = اختياري.موجود(نسخة_المحتوى);
    دع المعرف: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
        السياق,
        (*المدخل).المعرف,
        0,
        الهوية,
        حقائق_صيغة_قسم_ربط.سبير_في(),
        صنف_قسم_ربط.خاص_بالصيغة(),
        4,
        الطول((*المدخل).البايتات) مثل طبيعي,
        المحتوى
    );
    أرجع نتيجة_استيعاب_سبير_في.نجح();
}
