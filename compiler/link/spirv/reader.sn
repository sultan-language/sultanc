عرف بايت_سبير_في_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع ترتيب_سبير_في =
    | صغير
    | كبير
;

عام نوع واصف_وحدة_سبير_في = {
    الترتيب: ترتيب_سبير_في,
    الإصدار: غير_موقع,
    المولد: غير_موقع,
    حد_المعرفات: غير_موقع,
    المخطط: غير_موقع
};

عرف ضمن_حدود_سبير_في(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_غ32_سبير_في(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الترتيب: ترتيب_سبير_في
): غير_موقع {
    طابق الترتيب مع
    | ترتيب_سبير_في.صغير -> {
        أرجع ((*البايتات)[الموضع] مثل غير_موقع)
            + (بايت_سبير_في_عند(البايتات, الموضع + 1) مثل غير_موقع) * 256
            + (بايت_سبير_في_عند(البايتات, الموضع + 2) مثل غير_موقع) * 65536
            + (بايت_سبير_في_عند(البايتات, الموضع + 3) مثل غير_موقع) * 16777216;
    }
    | ترتيب_سبير_في.كبير -> {
        أرجع ((*البايتات)[الموضع] مثل غير_موقع) * 16777216
            + (بايت_سبير_في_عند(البايتات, الموضع + 1) مثل غير_موقع) * 65536
            + (بايت_سبير_في_عند(البايتات, الموضع + 2) مثل غير_موقع) * 256
            + (بايت_سبير_في_عند(البايتات, الموضع + 3) مثل غير_موقع);
    };
}

عام عرف صف_وحدة_سبير_في(
    البايتات: &متجه غ8
): اختيار واصف_وحدة_سبير_في {
    لو (!ضمن_حدود_سبير_في(البايتات, 0, 20)) {
        أرجع اختيار.لا_شيء();
    };
    لو (((الطول(*البايتات) مثل غير_موقع) % 4) != 0) {
        أرجع اختيار.لا_شيء();
    };
    دع الترتيب: ترتيب_سبير_في;
    لو ((*البايتات)[0] == 0x03
        && (*البايتات)[1] == 0x02
        && (*البايتات)[2] == 0x23
        && (*البايتات)[3] == 0x07) {
        الترتيب := ترتيب_سبير_في.صغير();
    } وإلا لو ((*البايتات)[0] == 0x07
        && (*البايتات)[1] == 0x23
        && (*البايتات)[2] == 0x02
        && (*البايتات)[3] == 0x03) {
        الترتيب := ترتيب_سبير_في.كبير();
    } وإلا {
        أرجع اختيار.لا_شيء();
    };
    دع الوصف: واصف_وحدة_سبير_في = {
        الترتيب: الترتيب,
        الإصدار: اقرأ_غ32_سبير_في(البايتات, 4, الترتيب),
        المولد: اقرأ_غ32_سبير_في(البايتات, 8, الترتيب),
        حد_المعرفات: اقرأ_غ32_سبير_في(البايتات, 12, الترتيب),
        المخطط: اقرأ_غ32_سبير_في(البايتات, 16, الترتيب)
    };
    لو (الوصف.حد_المعرفات == 0 || الوصف.المخطط != 0) {
        أرجع اختيار.لا_شيء();
    };
    دع الموضع: متغير غير_موقع = 20;
    بينما (الموضع < (الطول(*البايتات) مثل غير_موقع)) {
        دع الرأس: غير_موقع = اقرأ_غ32_سبير_في(
            البايتات,
            الموضع,
            الترتيب
        );
        دع عدد_الكلمات: غير_موقع = الرأس / 65536;
        لو (عدد_الكلمات == 0
            || !ضمن_حدود_سبير_في(
                البايتات,
                الموضع,
                عدد_الكلمات * 4
            )) {
            أرجع اختيار.لا_شيء();
        };
        الموضع := الموضع + عدد_الكلمات * 4;
    }
    أرجع اختيار.بعض(الوصف);
}

// OpCapability Linkage marks a partially linkable SPIR-V module. A final
// target module must pass through spirv-link so imports are resolved and
// executable-link semantics can remove linkage exports.
عام عرف وحدة_سبير_في_تحتاج_ربطا(
    البايتات: &متجه غ8
): اختيار منطقي {
    دع الوصف: واصف_وحدة_سبير_في;
    طابق صف_وحدة_سبير_في(البايتات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الوصف := القيمة; };

    دع الموضع: متغير غير_موقع = 20;
    بينما (الموضع < (الطول(*البايتات) مثل غير_موقع)) {
        دع الرأس: غير_موقع = اقرأ_غ32_سبير_في(
            البايتات,
            الموضع,
            الوصف.الترتيب
        );
        دع عدد_الكلمات: غير_موقع = الرأس / 65536;
        دع التعليمة: غير_موقع = الرأس % 65536;
        لو (التعليمة == 17 && عدد_الكلمات >= 2) {
            دع القدرة: غير_موقع = اقرأ_غ32_سبير_في(
                البايتات,
                الموضع + 4,
                الوصف.الترتيب
            );
            لو (القدرة == 5) { أرجع اختيار.بعض(صواب); };
        };
        الموضع := الموضع + عدد_الكلمات * 4;
    }
    أرجع اختيار.بعض(خطأ);
}
