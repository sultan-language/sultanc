عرف بايت_سبير_في_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع ترتيب_سبير_في =
    | صغير
    | كبير
;

عام نوع واصف_وحدة_سبير_في = {
    الترتيب: ترتيب_سبير_في,
    الإصدار: طبيعي,
    المولد: طبيعي,
    حد_المعرفات: طبيعي,
    المخطط: طبيعي
};

عرف ضمن_حدود_سبير_في(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_ط32_سبير_في(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الترتيب: ترتيب_سبير_في
): طبيعي {
    طابق الترتيب مع
    | ترتيب_سبير_في.صغير -> {
        أرجع ((*البايتات)[الموضع] مثل طبيعي)
            + (بايت_سبير_في_عند(البايتات, الموضع + 1) مثل طبيعي) * 256
            + (بايت_سبير_في_عند(البايتات, الموضع + 2) مثل طبيعي) * 65536
            + (بايت_سبير_في_عند(البايتات, الموضع + 3) مثل طبيعي) * 16777216;
    }
    | ترتيب_سبير_في.كبير -> {
        أرجع ((*البايتات)[الموضع] مثل طبيعي) * 16777216
            + (بايت_سبير_في_عند(البايتات, الموضع + 1) مثل طبيعي) * 65536
            + (بايت_سبير_في_عند(البايتات, الموضع + 2) مثل طبيعي) * 256
            + (بايت_سبير_في_عند(البايتات, الموضع + 3) مثل طبيعي);
    };
}

عام عرف صف_وحدة_سبير_في(
    البايتات: &متجه ط8
): اختياري واصف_وحدة_سبير_في {
    إذا (!ضمن_حدود_سبير_في(البايتات, 0, 20)) {
        أرجع اختياري.لا_شيء();
    };
    إذا (((الطول(*البايتات) مثل طبيعي) % 4) != 0) {
        أرجع اختياري.لا_شيء();
    };
    دع الترتيب: ترتيب_سبير_في;
    إذا ((*البايتات)[0] == 0x03
        && (*البايتات)[1] == 0x02
        && (*البايتات)[2] == 0x23
        && (*البايتات)[3] == 0x07) {
        الترتيب := ترتيب_سبير_في.صغير();
    } وإلا إذا ((*البايتات)[0] == 0x07
        && (*البايتات)[1] == 0x23
        && (*البايتات)[2] == 0x02
        && (*البايتات)[3] == 0x03) {
        الترتيب := ترتيب_سبير_في.كبير();
    } وإلا {
        أرجع اختياري.لا_شيء();
    };
    دع الوصف: واصف_وحدة_سبير_في = {
        الترتيب: الترتيب,
        الإصدار: اقرأ_ط32_سبير_في(البايتات, 4, الترتيب),
        المولد: اقرأ_ط32_سبير_في(البايتات, 8, الترتيب),
        حد_المعرفات: اقرأ_ط32_سبير_في(البايتات, 12, الترتيب),
        المخطط: اقرأ_ط32_سبير_في(البايتات, 16, الترتيب)
    };
    إذا (الوصف.حد_المعرفات == 0 || الوصف.المخطط != 0) {
        أرجع اختياري.لا_شيء();
    };
    دع الموضع: متغير طبيعي = 20;
    طالما (الموضع < (الطول(*البايتات) مثل طبيعي)) {
        دع الرأس: طبيعي = اقرأ_ط32_سبير_في(
            البايتات,
            الموضع,
            الترتيب
        );
        دع عدد_الكلمات: طبيعي = الرأس / 65536;
        إذا (عدد_الكلمات == 0
            || !ضمن_حدود_سبير_في(
                البايتات,
                الموضع,
                عدد_الكلمات * 4
            )) {
            أرجع اختياري.لا_شيء();
        };
        الموضع := الموضع + عدد_الكلمات * 4;
    }
    أرجع اختياري.موجود(الوصف);
}

// OpCapability Linkage marks a partially linkable SPIR-V module. A final
// target module must pass through spirv-link so imports are resolved and
// executable-link semantics can remove linkage exports.
عام عرف وحدة_سبير_في_تحتاج_ربطا(
    البايتات: &متجه ط8
): اختياري منطقي {
    دع الوصف: واصف_وحدة_سبير_في;
    طابق صف_وحدة_سبير_في(البايتات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الوصف := القيمة; };

    دع الموضع: متغير طبيعي = 20;
    طالما (الموضع < (الطول(*البايتات) مثل طبيعي)) {
        دع الرأس: طبيعي = اقرأ_ط32_سبير_في(
            البايتات,
            الموضع,
            الوصف.الترتيب
        );
        دع عدد_الكلمات: طبيعي = الرأس / 65536;
        دع التعليمة: طبيعي = الرأس % 65536;
        إذا (التعليمة == 17 && عدد_الكلمات >= 2) {
            دع القدرة: طبيعي = اقرأ_ط32_سبير_في(
                البايتات,
                الموضع + 4,
                الوصف.الترتيب
            );
            إذا (القدرة == 5) { أرجع اختياري.موجود(صواب); };
        };
        الموضع := الموضع + عدد_الكلمات * 4;
    }
    أرجع اختياري.موجود(خطأ);
}
