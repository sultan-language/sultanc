استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.spirv.reader;

// SPIR-V link output. SultanC runs no external linker: a target module whose
// one input is a complete SPIR-V module (no Import linkage, see
// وحدة_سبير_في_تحتاج_ربطا) is passed through. Merging several modules or
// resolving imported functions needs an internal SPIR-V linker that SultanC
// does not have yet; such links are reported as unsupported instead of being
// handed to the Khronos spirv-link as before.
عام نوع خطأ_مزود_ربط_سبير_في =
    | خطة_غير_مدعومة
    | وحدة_غير_صالحة
;

عام نوع نتيجة_مزود_ربط_سبير_في =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_سبير_في
;

عرف انسخ_بايتات_ربط_سبير_في(القيمة: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*القيمة) مثل غير_موقع)) {
        ألحق(الناتج, (*القيمة)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عام عرف اربط_سبير_في(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_سبير_في {
    لو ((*السياق).الخطة.الخرج != نوع_خرج_ربط.وحدة_هدف()) {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة()
        );
    };
    لو ((الطول((*السياق).الخطة.المدخلات) مثل غير_موقع) != 1) {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة()
        );
    };
    دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[0];
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> { }
    | _ -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة()
        );
    };
    طابق وحدة_سبير_في_تحتاج_ربطا(&(*المدخل).البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة()
        );
    }
    | اختيار.بعض(تحتاج_ربطا) -> {
        لو (تحتاج_ربطا) {
            أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
                خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة()
            );
        };
    };
    أرجع نتيجة_مزود_ربط_سبير_في.نجح(
        انسخ_بايتات_ربط_سبير_في(&(*المدخل).البايتات)
    );
}
