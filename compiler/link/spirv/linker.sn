استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.spirv.reader;
استورد std.env.environment;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.fs.mutation;
استورد std.process.child;
استورد std.text.builder;
استورد std.text.number;

عام نوع خطأ_مزود_ربط_سبير_في =
    | خطة_غير_مدعومة
    | وحدة_غير_صالحة
    | بيانات_أداة_مفقودة
    | مساحة_عمل_مؤقتة_فشلت بنوع عدد
    | كتابة_مدخل_مؤقت_فشلت بنوع عدد
    | تشغيل_الرابط_فشل بنوع عدد
    | قراءة_المخرج_فشلت بنوع عدد
;

عام نوع نتيجة_مزود_ربط_سبير_في =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_سبير_في
;

عرف انسخ_نص_ربط_سبير_في(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف انسخ_بايتات_ربط_سبير_في(القيمة: &متجه غ8): متجه غ8 {
    دع النسخة: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*القيمة) مثل غير_موقع)) {
        ألحق(النسخة, (*القيمة)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع النسخة;
}

عرف اسم_ملف_سبير_في_مؤقت(
    البادئة: &نص,
    الفهرس: غير_موقع
): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    ألحق_نصا_بباني_النص(&متغير الباني, البادئة);
    دع الرقم: نص = غير_موقع_إلى_نص(الفهرس);
    ألحق_نصا_بباني_النص(&متغير الباني, &الرقم);
    دع الامتداد: نص = «.spv»;
    ألحق_نصا_بباني_النص(&متغير الباني, &الامتداد);
    أرجع نص_باني_النص(&الباني);
}

عرف أنشئ_مساحة_عمل_سبير_في(): نتيجة نص, عدد {
    دع جذر_المؤقت: نص;
    طابق الدليل_المؤقت() مع
    | نتيجة.خطأ(الحالة) -> { أرجع نتيجة.خطأ(الحالة); }
    | نتيجة.نجح(المسار) -> { جذر_المؤقت := المسار; };

    دع المحاولة: متغير غير_موقع = 0;
    بينما (المحاولة < 128) {
        دع بادئة_الدليل: نص = «sultanc-spirv-link-»;
        دع اسم_الدليل: نص = اسم_ملف_سبير_في_مؤقت(
            &بادئة_الدليل,
            المحاولة
        );
        دع المسار: نص = صل_المسار(&جذر_المؤقت, &اسم_الدليل);
        طابق أنشئ_دليلا(&المسار) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المسار); }
        | نتيجة.خطأ(_) -> { };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(-1);
}

عرف نظف_مساحة_عمل_سبير_في(
    الدليل: &نص,
    الملفات: &متجه نص
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الملفات) مثل غير_موقع)) {
        دع مسار_الملف: &نص = &(*الملفات)[الفهرس];
        دع إزالة_الملف: نتيجة عدد, عدد = أزل_ملفا(مسار_الملف);
        الفهرس := الفهرس + 1;
    }
    دع إزالة_الدليل: نتيجة عدد, عدد = أزل_دليلا(الدليل);
}

عرف تحقق_مدخلات_سبير_في(
    الخطة: &خطة_ربط
): منطقي {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*الخطة).المدخلات) مثل غير_موقع)) {
        دع المدخل: &مدخل_ربط = &(*الخطة).المدخلات[الفهرس];
        طابق (*المدخل).الصنف مع
        | صنف_مدخل_ربط.كائن -> { }
        | _ -> { أرجع خطأ; };
        طابق صف_وحدة_سبير_في(&(*المدخل).البايتات) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(_) -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع الفهرس > 0;
}

عرف ألحق_سياسة_خرج_سبير_في(
    الخطة: &خطة_ربط,
    الوسائط: &متغير متجه نص
): منطقي {
    طابق (*الخطة).الخرج مع
    | نوع_خرج_ربط.وحدة_هدف -> { أرجع صواب; }
    | نوع_خرج_ربط.كائن_مترابط -> {
        دع خيار_مكتبة: نص = «--create-library»;
        دع خيار_ربط_جزئي: نص = «--allow-partial-linkage»;
        ألحق(*الوسائط, خيار_مكتبة);
        ألحق(*الوسائط, خيار_ربط_جزئي);
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف شغل_رابط_سبير_في(
    السياق: &سياق_ربط,
    البرنامج: &نص
): نتيجة_مزود_ربط_سبير_في {
    دع مساحة_العمل: نص;
    طابق أنشئ_مساحة_عمل_سبير_في() مع
    | نتيجة.خطأ(الحالة) -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.مساحة_عمل_مؤقتة_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(المسار) -> { مساحة_العمل := المسار; };

    دع الملفات_المؤقتة: متغير متجه نص = [];
    دع الوسائط: متغير متجه نص = [];
    لو (!ألحق_سياسة_خرج_سبير_في(&(*السياق).الخطة, &متغير الوسائط)) {
        نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة()
        );
    };
    دع فهرس_المدخل: متغير غير_موقع = 0;
    بينما (
        فهرس_المدخل
            < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)
    ) {
        دع المدخل: &مدخل_ربط =
            &(*السياق).الخطة.المدخلات[فهرس_المدخل];
        دع بادئة_المدخل: نص = «input-»;
        دع اسم_الملف: نص = اسم_ملف_سبير_في_مؤقت(
            &بادئة_المدخل,
            فهرس_المدخل
        );
        دع المسار: نص = صل_المسار(&مساحة_العمل, &اسم_الملف);
        طابق اكتب_البايتات(&المسار, &(*المدخل).البايتات) مع
        | نتيجة.خطأ(الحالة) -> {
            نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
            أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
                خطأ_مزود_ربط_سبير_في.كتابة_مدخل_مؤقت_فشلت(الحالة)
            );
        }
        | نتيجة.نجح(_) -> { };
        دع مسار_التنظيف: نص = انسخ_نص_ربط_سبير_في(&المسار);
        ألحق(الملفات_المؤقتة, مسار_التنظيف);
        ألحق(الوسائط, المسار);
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع اسم_المخرج: نص = «output.spv»;
    دع مسار_المخرج: نص = صل_المسار(&مساحة_العمل, &اسم_المخرج);
    دع خيار_المخرج: نص = «-o»;
    ألحق(الوسائط, خيار_المخرج);
    دع مسار_المخرج_للأداة: نص = انسخ_نص_ربط_سبير_في(&مسار_المخرج);
    دع مسار_المخرج_للتنظيف: نص = انسخ_نص_ربط_سبير_في(&مسار_المخرج);
    ألحق(الوسائط, مسار_المخرج_للأداة);
    ألحق(الملفات_المؤقتة, مسار_المخرج_للتنظيف);

    دع حالة_الأداة: حالة_إنهاء;
    طابق شغل_وانتظر(البرنامج, &الوسائط) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.تشغيل_الرابط_فشل(الحالة)
        );
    }
    | نتيجة.نجح(الحالة) -> { حالة_الأداة := الحالة; };

    طابق حالة_الأداة مع
    | حالة_إنهاء.خرج(الحالة) -> {
        لو (الحالة != 0) {
            نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
            أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
                خطأ_مزود_ربط_سبير_في.تشغيل_الرابط_فشل(الحالة)
            );
        };
    }
    | حالة_إنهاء.إشارة(الإشارة) -> {
        نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.تشغيل_الرابط_فشل(256 + الإشارة)
        );
    };

    دع الناتج: متجه غ8;
    طابق اقرأ_بايتات_ملف(&مسار_المخرج) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.قراءة_المخرج_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(البايتات) -> { الناتج := البايتات; };
    نظف_مساحة_عمل_سبير_في(&مساحة_العمل, &الملفات_المؤقتة);

    طابق صف_وحدة_سبير_في(&الناتج) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة()
        );
    }
    | اختيار.بعض(_) -> { };
    أرجع نتيجة_مزود_ربط_سبير_في.نجح(الناتج);
}

عام عرف اربط_سبير_في(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_سبير_في {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.وحدة_هدف -> { }
    | نوع_خرج_ربط.كائن_مترابط -> { }
    | _ -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.خطة_غير_مدعومة()
        );
    };
    لو (!تحقق_مدخلات_سبير_في(&(*السياق).الخطة)) {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة()
        );
    };

    لو (
        (*السياق).الخطة.الخرج == نوع_خرج_ربط.وحدة_هدف()
            && (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع) == 1
    ) {
        دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[0];
        طابق وحدة_سبير_في_تحتاج_ربطا(&(*المدخل).البايتات) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
                خطأ_مزود_ربط_سبير_في.وحدة_غير_صالحة()
            );
        }
        | اختيار.بعض(تحتاج_ربطا) -> {
            لو (!تحتاج_ربطا) {
                أرجع نتيجة_مزود_ربط_سبير_في.نجح(
                    انسخ_بايتات_ربط_سبير_في(&(*المدخل).البايتات)
                );
            };
        };
    };

    دع البرنامج: نص;
    طابق (*السياق).الخطة.بيانات_الأداة.سبير_في مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_سبير_في.خطأ(
            خطأ_مزود_ربط_سبير_في.بيانات_أداة_مفقودة()
        );
    }
    | اختيار.بعض(البيانات) -> { البرنامج := انسخ_نص_ربط_سبير_في(&البيانات.برنامج_الرابط); };
    أرجع شغل_رابط_سبير_في(السياق, &البرنامج);
}
