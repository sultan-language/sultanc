استورد compiler.link.model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;

عام نوع خطأ_حل_رموز_ربط =
    | تعريفان_قويان بنوع (معرف_مدخل_ربط, معرف_مدخل_ربط)
    | سياسة_صيغة_مطلوبة
;

// Archive extraction is work produced by resolution, not an error. The format
// provider extracts that member, adds it as a normal object input, then resumes.
عام نوع نتيجة_تسجيل_رمز_ربط =
    | نجح بنوع معرف_رمز_ربط
    | استخرج_عضو_أرشيف بنوع (معرف_رمز_ربط, معرف_مدخل_ربط, غير_موقع)
    | خطأ بنوع خطأ_حل_رموز_ربط
;

عرف حول_قرار_إدراج_رمز_ربط(
    النتيجة: نتيجة_إدراج_رمز_ربط
): نتيجة_تسجيل_رمز_ربط {
    طابق النتيجة مع
    | نتيجة_إدراج_رمز_ربط.أضيف(المعرف) -> {
        أرجع نتيجة_تسجيل_رمز_ربط.نجح(المعرف);
    }
    | نتيجة_إدراج_رمز_ربط.حدث(المعرف, القرار) -> {
        طابق القرار مع
        | قرار_حل_رمز_ربط.تعريفان_قويان(المدخل_الموجود, المدخل_المرشح) -> {
            أرجع نتيجة_تسجيل_رمز_ربط.خطأ(
                خطأ_حل_رموز_ربط.تعريفان_قويان(
                    المدخل_الموجود,
                    المدخل_المرشح
                )
            );
        }
        | قرار_حل_رمز_ربط.استخرج_عضو_أرشيف(الأرشيف, العضو) -> {
            أرجع نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(
                المعرف, الأرشيف, العضو
            );
        }
        | قرار_حل_رمز_ربط.يحتاج_سياسة_متخصصة -> {
            أرجع نتيجة_تسجيل_رمز_ربط.خطأ(
                خطأ_حل_رموز_ربط.سياسة_صيغة_مطلوبة()
            );
        }
        | _ -> { أرجع نتيجة_تسجيل_رمز_ربط.نجح(المعرف); };
    };
}

عام عرف سجل_رمزا_غير_معرف_للربط(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه غ8,
    المدخل: معرف_مدخل_ربط
): نتيجة_تسجيل_رمز_ربط {
    دع الحالة: حالة_رمز_ربط = حالة_رمز_ربط.غير_معرف(المدخل);
    أرجع حول_قرار_إدراج_رمز_ربط(أدرج_مرشح_رمز_ربط(الجدول, الاسم, الحالة));
}

عام عرف سجل_تعريف_رمز_للربط_في_موضع(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه غ8,
    المدخل: معرف_مدخل_ربط,
    القوة: قوة_تعريف_رمز_ربط,
    الموضع: موضع_تعريف_رمز_ربط,
    الحجم: غير_موقع
): نتيجة_تسجيل_رمز_ربط {
    دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
        المدخل, القوة, الموضع, الحجم
    );
    دع الحالة: حالة_رمز_ربط = حالة_رمز_ربط.معرف(التعريف);
    أرجع حول_قرار_إدراج_رمز_ربط(أدرج_مرشح_رمز_ربط(الجدول, الاسم, الحالة));
}

عام عرف سجل_تعريف_رمز_للربط(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه غ8,
    المدخل: معرف_مدخل_ربط,
    القوة: قوة_تعريف_رمز_ربط
): نتيجة_تسجيل_رمز_ربط {
    أرجع سجل_تعريف_رمز_للربط_في_موضع(
        الجدول, الاسم, المدخل, القوة, موضع_تعريف_رمز_ربط.غير_محدد(), 0
    );
}

عام عرف سجل_عضو_أرشيف_كسولا_للربط(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه غ8,
    الأرشيف: معرف_مدخل_ربط,
    العضو: غير_موقع
): نتيجة_تسجيل_رمز_ربط {
    دع الحالة: حالة_رمز_ربط = حالة_رمز_ربط.كسول(الأرشيف, العضو);
    أرجع حول_قرار_إدراج_رمز_ربط(أدرج_مرشح_رمز_ربط(الجدول, الاسم, الحالة));
}

عام عرف سجل_رمز_مكتبة_ديناميكية_للربط(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه غ8,
    المكتبة: معرف_مدخل_ربط
): نتيجة_تسجيل_رمز_ربط {
    دع الحالة: حالة_رمز_ربط = حالة_رمز_ربط.ديناميكي(المكتبة);
    أرجع حول_قرار_إدراج_رمز_ربط(أدرج_مرشح_رمز_ربط(الجدول, الاسم, الحالة));
}
