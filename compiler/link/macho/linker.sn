استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.macho.final_image;
استورد compiler.link.macho.relocatable;

عام نوع خطأ_مزود_ربط_ماتشو =
    | خطة_غير_مدعومة
    | كائن_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_مدعوم
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
    | توقيع_فشل
;

عام نوع نتيجة_مزود_ربط_ماتشو =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_ماتشو
;

عرف حول_خطأ_صورة_ماتشو(
    الخطأ: خطأ_صورة_ماتشو_تنفيذية
): خطأ_مزود_ربط_ماتشو {
    طابق الخطأ مع
    | خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم -> {
        أرجع خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة();
    }
    | خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح -> {
        أرجع خطأ_مزود_ربط_ماتشو.كائن_غير_صالح();
    }
    | خطأ_صورة_ماتشو_تنفيذية.رمز_دخول_مفقود -> {
        أرجع خطأ_مزود_ربط_ماتشو.رمز_دخول_مفقود();
    }
    | خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول -> {
        أرجع خطأ_مزود_ربط_ماتشو.رمز_خارجي_غير_مدعوم();
    }
    | خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة -> {
        أرجع خطأ_مزود_ربط_ماتشو.إزاحة_غير_مدعومة();
    }
    | خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق -> {
        أرجع خطأ_مزود_ربط_ماتشو.إزاحة_خارج_النطاق();
    }
    | خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل -> {
        أرجع خطأ_مزود_ربط_ماتشو.توقيع_فشل();
    };
}

عرف حول_خطأ_كائن_ماتشو(
    الخطأ: خطأ_كائن_مترابط_ماتشو
): خطأ_مزود_ربط_ماتشو {
    طابق الخطأ مع
    | خطأ_كائن_مترابط_ماتشو.هدف_غير_مدعوم -> {
        أرجع خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة();
    }
    | خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة -> {
        أرجع خطأ_مزود_ربط_ماتشو.كائن_غير_صالح();
    }
    | خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح -> {
        أرجع خطأ_مزود_ربط_ماتشو.إزاحة_غير_مدعومة();
    };
}

عام عرف اربط_ماتشو(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_ماتشو {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        طابق ابن_صورة_ماتشو_داروين_تنفيذية(السياق) مع
        | نتيجة_صورة_ماتشو_تنفيذية.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.نجح(البايتات);
        }
        | نتيجة_صورة_ماتشو_تنفيذية.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.خطأ(حول_خطأ_صورة_ماتشو(الخطأ));
        };
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        طابق ابن_صورة_ماتشو_داروين_مشتركة(السياق) مع
        | نتيجة_صورة_ماتشو_تنفيذية.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.نجح(البايتات);
        }
        | نتيجة_صورة_ماتشو_تنفيذية.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.خطأ(حول_خطأ_صورة_ماتشو(الخطأ));
        };
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        طابق ابن_كائن_ماتشو_مترابط(السياق) مع
        | نتيجة_كائن_مترابط_ماتشو.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.نجح(البايتات);
        }
        | نتيجة_كائن_مترابط_ماتشو.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_ماتشو.خطأ(حول_خطأ_كائن_ماتشو(الخطأ));
        };
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع نتيجة_مزود_ربط_ماتشو.خطأ(
            خطأ_مزود_ربط_ماتشو.خطة_غير_مدعومة()
        );
    };
}
