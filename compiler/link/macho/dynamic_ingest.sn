استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد std.fs.path;
استورد compiler.backend.target.target_model;
استورد compiler.link.macho.text_stub;

عرف بايت_ديناميكي_ماتشو_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع خطأ_استيعاب_مكتبة_ماتشو =
    | مكتبة_غير_صالحة
    // A text-based stub (.tbd) that names no install name.
    | مكتبة_نصية_غير_صالحة
    | حل_رمز_يتطلب_سياسة
;

عام نوع نتيجة_استيعاب_مكتبة_ماتشو =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مكتبة_ماتشو
;

عرف ضمن_حدود_مكتبة_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عرف اقرأ_ط32_مكتبة_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    أرجع ((*البايتات)[الموضع] مثل طبيعي)
        + (بايت_ديناميكي_ماتشو_عند(البايتات, الموضع + 1) مثل طبيعي) * 256
        + (بايت_ديناميكي_ماتشو_عند(البايتات, الموضع + 2) مثل طبيعي) * 65536
        + (بايت_ديناميكي_ماتشو_عند(البايتات, الموضع + 3) مثل طبيعي) * 16777216;
}

عرف اقرأ_اسم_صفري_مكتبة_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري متجه ط8 {
    إذا (الموضع >= النهاية || النهاية > (الطول(*البايتات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = الموضع;
    طالما (الفهرس < النهاية) {
        إذا ((*البايتات)[الفهرس] == 0) { أرجع اختياري.موجود(الاسم); };
        ألحق(الاسم, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف بايتات_نص_اعتماد_ماتشو(النص: &نص): متجه ط8 {
    دع البايتات: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*النص) مثل طبيعي)) {
        ألحق(البايتات, (*النص)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع البايتات;
}

عرف اسم_اعتماد_ماتشو_الافتراضي(المدخل: &مدخل_ربط): متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
    | اختياري.موجود(المسار) -> {
        طابق اسم_الملف(&المسار) مع
        | اختياري.لا_شيء -> { أرجع بايتات_نص_اعتماد_ماتشو(&المسار); }
        | اختياري.موجود(الاسم) -> { أرجع بايتات_نص_اعتماد_ماتشو(&الاسم); };
    };
}

عرف دليل_اعتماد_ماتشو(المدخل: &مدخل_ربط): اختياري متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار) -> {
        طابق أب_المسار(&المسار) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الدليل) -> {
            أرجع اختياري.موجود(بايتات_نص_اعتماد_ماتشو(&الدليل));
        };
    };
}

// The architecture and platform as a text stub's targets spell them
// (`arm64-macos`).
عرف معمارية_مكتبة_نصية_ماتشو(السياق: &سياق_ربط): متجه ط8 {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { دع الاسم: نص = «x86_64»; أرجع بايتات_نص_اعتماد_ماتشو(&الاسم); }
    | _ -> { دع الاسم: نص = «arm64»; أرجع بايتات_نص_اعتماد_ماتشو(&الاسم); };
}

عرف منصة_مكتبة_نصية_ماتشو(السياق: &سياق_ربط): متجه ط8 {
    طابق (*السياق).الهدف.المنصة.المنصة مع
    | هوية_منصة.آي_أو_إس -> { دع الاسم: نص = «ios»; أرجع بايتات_نص_اعتماد_ماتشو(&الاسم); }
    | _ -> { دع الاسم: نص = «macos»; أرجع بايتات_نص_اعتماد_ماتشو(&الاسم); };
}

// A dylib known by its install name and the symbols it exports: the image
// loads it (LC_LOAD_DYLIB) and binds those symbols to it.
عرف سجل_مكتبة_ماتشو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الاسم: متجه ط8
): فراغ {
    إذا ((الطول(الاسم) مثل طبيعي) == 0) { أرجع; };
    دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط;
    طابق دليل_اعتماد_ماتشو(المدخل) مع
    | اختياري.لا_شيء -> { الاعتماد := اعتماد_مكتبة_ديناميكية_باسم(الاسم); }
    | اختياري.موجود(الدليل) -> {
        الاعتماد := اعتماد_مكتبة_ديناميكية_بمسار(الاسم, الدليل);
    };
    اربط_اعتماد_ديناميكي_بمدخل(
        &متغير الاعتماد,
        (*المدخل).المعرف
    );
    أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        الاعتماد
    );
}

// A text-based dylib stub (macho/text_stub.sn) stands for the dylib its
// install name names, as ld64 and lld read an SDK's libraries.
عرف استوعب_مكتبة_نصية_ماتشو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_ماتشو {
    دع المعمارية: متجه ط8 = معمارية_مكتبة_نصية_ماتشو(السياق);
    دع المنصة: متجه ط8 = منصة_مكتبة_نصية_ماتشو(السياق);
    طابق اقرأ_مكتبة_نصية_ماتشو(&(*المدخل).البايتات, &المعمارية, &المنصة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
            خطأ_استيعاب_مكتبة_ماتشو.مكتبة_نصية_غير_صالحة()
        );
    }
    | اختياري.موجود(المكتبة) -> {
        دع اسم_التثبيت: متغير متجه ط8 = [];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المكتبة.اسم_التثبيت) مثل طبيعي)) {
            ألحق(اسم_التثبيت, المكتبة.اسم_التثبيت[ك]);
            ك := ك + 1;
        }
        سجل_مكتبة_ماتشو_في_سياق_الربط(السياق, المدخل, اسم_التثبيت);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المكتبة.الرموز) مثل طبيعي)) {
            طابق سجل_رمز_مكتبة_ديناميكية_للربط(
                &متغير (*السياق).الرموز,
                &المكتبة.الرموز[ف],
                (*المدخل).المعرف
            ) مع
            | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
                أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
                    خطأ_استيعاب_مكتبة_ماتشو.حل_رمز_يتطلب_سياسة()
                );
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.نجح();
    };
}

عام عرف استوعب_مكتبة_ماتشو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_ماتشو {
    إذا (مكتبة_نصية_تابي(&(*المدخل).البايتات)) {
        أرجع استوعب_مكتبة_نصية_ماتشو_في_سياق_الربط(السياق, المدخل);
    };
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    إذا (!ضمن_حدود_مكتبة_ماتشو(البايتات, 0, 32)
        || اقرأ_ط32_مكتبة_ماتشو(البايتات, 0) != 0xFEEDFACF
        || اقرأ_ط32_مكتبة_ماتشو(البايتات, 12) != 6) {
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
            خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
        );
    };
    دع عدد_الأوامر: طبيعي = اقرأ_ط32_مكتبة_ماتشو(البايتات, 16);
    دع حجم_الأوامر: طبيعي = اقرأ_ط32_مكتبة_ماتشو(البايتات, 20);
    إذا (!ضمن_حدود_مكتبة_ماتشو(البايتات, 32, حجم_الأوامر)) {
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
            خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
        );
    };

    دع اسم_الاعتماد: متغير اختياري متجه ط8 = اختياري.لا_شيء();
    دع موضع_الرموز: متغير طبيعي = 0;
    دع عدد_الرموز: متغير طبيعي = 0;
    دع موضع_النصوص: متغير طبيعي = 0;
    دع حجم_النصوص: متغير طبيعي = 0;
    دع وجد_جدول_رموز: متغير منطقي = خطأ;
    دع موضع_الأمر: متغير طبيعي = 32;
    دع ترتيب_الأمر: متغير طبيعي = 0;
    طالما (ترتيب_الأمر < عدد_الأوامر) {
        إذا (!ضمن_حدود_مكتبة_ماتشو(البايتات, موضع_الأمر, 8)) {
            أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
                خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
            );
        };
        دع النوع: طبيعي = اقرأ_ط32_مكتبة_ماتشو(البايتات, موضع_الأمر);
        دع الحجم: طبيعي = اقرأ_ط32_مكتبة_ماتشو(
            البايتات,
            موضع_الأمر + 4
        );
        إذا (الحجم < 8 || !ضمن_حدود_مكتبة_ماتشو(البايتات, موضع_الأمر, الحجم)) {
            أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
                خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
            );
        };
        إذا (النوع == 0xD && الحجم >= 24) {
            دع إزاحة_الاسم: طبيعي = اقرأ_ط32_مكتبة_ماتشو(
                البايتات,
                موضع_الأمر + 8
            );
            إذا (إزاحة_الاسم < الحجم) {
                اسم_الاعتماد := اقرأ_اسم_صفري_مكتبة_ماتشو(
                    البايتات,
                    موضع_الأمر + إزاحة_الاسم,
                    موضع_الأمر + الحجم
                );
            };
        } وإلا إذا (النوع == 2 && الحجم >= 24) {
            موضع_الرموز := اقرأ_ط32_مكتبة_ماتشو(البايتات, موضع_الأمر + 8);
            عدد_الرموز := اقرأ_ط32_مكتبة_ماتشو(البايتات, موضع_الأمر + 12);
            موضع_النصوص := اقرأ_ط32_مكتبة_ماتشو(البايتات, موضع_الأمر + 16);
            حجم_النصوص := اقرأ_ط32_مكتبة_ماتشو(البايتات, موضع_الأمر + 20);
            وجد_جدول_رموز := صواب;
        };
        موضع_الأمر := موضع_الأمر + الحجم;
        ترتيب_الأمر := ترتيب_الأمر + 1;
    }

    دع الاسم: متجه ط8;
    طابق اسم_الاعتماد مع
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; }
    | اختياري.لا_شيء -> { الاسم := اسم_اعتماد_ماتشو_الافتراضي(المدخل); };
    سجل_مكتبة_ماتشو_في_سياق_الربط(السياق, المدخل, الاسم);

    إذا (!وجد_جدول_رموز) {
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.نجح();
    };
    إذا (!ضمن_حدود_مكتبة_ماتشو(
        البايتات,
        موضع_الرموز,
        عدد_الرموز * 16
    ) || !ضمن_حدود_مكتبة_ماتشو(
        البايتات,
        موضع_النصوص,
        حجم_النصوص
    )) {
        أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
            خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
        );
    };

    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: طبيعي = موضع_الرموز + فهرس_الرمز * 16;
        دع إزاحة_اسم_الرمز: طبيعي = اقرأ_ط32_مكتبة_ماتشو(
            البايتات,
            موضع_الرمز
        );
        دع النوع: طبيعي = بايت_ديناميكي_ماتشو_عند(البايتات, موضع_الرمز + 4) مثل طبيعي;
        دع رمز_عام_خارجي: منطقي = (النوع & 1) != 0;
        دع تثبيت: منطقي = (النوع & 0xE0) != 0;
        دع صنف_النوع: طبيعي = النوع & 0x0E;
        إذا (رمز_عام_خارجي
            && !تثبيت
            && صنف_النوع != 0
            && إزاحة_اسم_الرمز != 0
            && إزاحة_اسم_الرمز < حجم_النصوص) {
            دع اسم_الرمز: متجه ط8;
            طابق اقرأ_اسم_صفري_مكتبة_ماتشو(
                البايتات,
                موضع_النصوص + إزاحة_اسم_الرمز,
                موضع_النصوص + حجم_النصوص
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
                    خطأ_استيعاب_مكتبة_ماتشو.مكتبة_غير_صالحة()
                );
            }
            | اختياري.موجود(القيمة) -> { اسم_الرمز := القيمة; };
            طابق سجل_رمز_مكتبة_ديناميكية_للربط(
                &متغير (*السياق).الرموز,
                &اسم_الرمز,
                (*المدخل).المعرف
            ) مع
            | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
                أرجع نتيجة_استيعاب_مكتبة_ماتشو.خطأ(
                    خطأ_استيعاب_مكتبة_ماتشو.حل_رمز_يتطلب_سياسة()
                );
            }
            | _ -> { };
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع نتيجة_استيعاب_مكتبة_ماتشو.نجح();
}
