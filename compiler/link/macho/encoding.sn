استورد std.encoding.binary;
// Mach-O executable serialization helpers owned by the linker. Relocatable
// object serialization remains under compiler/backend/object.

عام عرف حاذ_قيمة_ماتشو(
    القيمة: غير_موقع,
    المحاذاة: غير_موقع
): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عام عرف ألحق_بايت_ماتشو(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق(*البايتات, (القيمة & 0xFF) مثل غ8);
}

عام عرف ألحق_غ16_ماتشو_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    اكتب_غ16_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFF) مثل غ16);
}

عام عرف ألحق_غ32_ماتشو_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    اكتب_غ32_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل غ32);
}

عام عرف ألحق_غ64_ماتشو_ربط(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    اكتب_غ64_بالبايت_الأقل_أهمية_أولا(البايتات, القيمة مثل غ64);
}

عام عرف ألحق_غ32_ماتشو_كبير(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    اكتب_غ32_بالبايت_الأكثر_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل غ32);
}

عام عرف ألحق_غ64_ماتشو_كبير(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    اكتب_غ64_بالبايت_الأكثر_أهمية_أولا(البايتات, القيمة مثل غ64);
}

عام عرف اقرأ_غ32_ماتشو_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع موضع_واحد: غير_موقع = الموضع + 1;
    دع موضع_اثنين: غير_موقع = الموضع + 2;
    دع موضع_ثلاثة: غير_موقع = الموضع + 3;
    دع البايت_صفر: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع البايت_واحد: غير_موقع = (*البايتات)[موضع_واحد] مثل غير_موقع;
    دع البايت_اثنان: غير_موقع = (*البايتات)[موضع_اثنين] مثل غير_موقع;
    دع البايت_ثلاثة: غير_موقع = (*البايتات)[موضع_ثلاثة] مثل غير_موقع;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عام عرف اقرأ_غ64_ماتشو_ربط(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الجزء_الأدنى: غير_موقع = اقرأ_غ32_ماتشو_ربط(
        البايتات,
        الموضع
    );
    دع الجزء_الأعلى: غير_موقع = اقرأ_غ32_ماتشو_ربط(
        البايتات,
        الموضع + 4
    );
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عام عرف اكتب_غ32_ماتشو_ربط_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    دع الحجم: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الحجم || الحجم - الموضع < 4) { أرجع خطأ; };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < 4) {
        دع القاسم: غير_موقع = 1 << (فهرس_البايت * 8);
        دع موضع_البايت: غير_موقع = الموضع + فهرس_البايت;
        (*البايتات)[موضع_البايت] :=
            ((القيمة / القاسم) & 0xFF) مثل غ8;
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اكتب_غ64_ماتشو_ربط_في(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    دع الحجم: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > الحجم || الحجم - الموضع < 8) { أرجع خطأ; };
    لو (!اكتب_غ32_ماتشو_ربط_في(
        البايتات,
        الموضع,
        القيمة & 0xFFFFFFFF
    )) {
        أرجع خطأ;
    };
    أرجع اكتب_غ32_ماتشو_ربط_في(
        البايتات,
        الموضع + 4,
        القيمة / 4294967296
    );
}

عام عرف ألحق_أصفارا_ماتشو(
    البايتات: &متغير متجه غ8,
    العدد: غير_موقع
): فراغ {
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < العدد) {
        ألحق(*البايتات, 0);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف ألحق_بايتات_ماتشو(
    الناتج: &متغير متجه غ8,
    المصدر: &متجه غ8
): فراغ {
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(*الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف أكمل_ماتشو_إلى_موضع(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع
): منطقي {
    دع الحجم_الحالي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الحجم_الحالي > الموضع) { أرجع خطأ; };
    ألحق_أصفارا_ماتشو(البايتات, الموضع - الحجم_الحالي);
    أرجع صواب;
}

عام عرف ألحق_اسم_ماتشو_ثابت(
    البايتات: &متغير متجه غ8,
    الاسم: &متجه غ8
): منطقي {
    لو ((الطول(*الاسم) مثل غير_موقع) > 16) { أرجع خطأ; };
    ألحق_بايتات_ماتشو(البايتات, الاسم);
    ألحق_أصفارا_ماتشو(
        البايتات,
        16 - (الطول(*الاسم) مثل غير_موقع)
    );
    أرجع صواب;
}

عام عرف ألحق_اسم_صفري_ماتشو(
    البايتات: &متغير متجه غ8,
    الاسم: &متجه غ8
): فراغ {
    ألحق_بايتات_ماتشو(البايتات, الاسم);
    ألحق(*البايتات, 0);
}

عام عرف حجم_أمر_مسار_ماتشو(
    الحجم_الثابت: غير_موقع,
    المسار: &متجه غ8
): غير_موقع {
    دع الحجم_الخام: غير_موقع =
        الحجم_الثابت + (الطول(*المسار) مثل غير_موقع) + 1;
    أرجع حاذ_قيمة_ماتشو(الحجم_الخام, 8);
}

عام عرف ألحق_يو_ليب_ماتشو(
    البايتات: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    دع الباقي: متغير غير_موقع = القيمة;
    بينما (صواب) {
        دع البايت_الحالي: متغير غير_موقع = الباقي & 0x7F;
        الباقي := الباقي >> 7;
        لو (الباقي != 0) {
            البايت_الحالي := البايت_الحالي | 0x80;
        };
        ألحق_بايت_ماتشو(البايتات, البايت_الحالي);
        لو (الباقي == 0) { أرجع; };
    }
}

عام عرف ألحق_سليب_ماتشو(
    البايتات: &متغير متجه غ8,
    القيمة: عدد
): فراغ {
    دع الباقي: متغير عدد = القيمة;
    بينما (صواب) {
        دع الجزء_الموقع: متغير عدد = الباقي % 128;
        لو (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: غير_موقع = الجزء_الموقع مثل غير_موقع;
        الباقي := (الباقي - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        دع انتهى_موجب: منطقي = الباقي == 0 && !بت_الإشارة;
        دع انتهى_سالب: منطقي = الباقي == -1 && بت_الإشارة;
        لو (انتهى_موجب || انتهى_سالب) {
            ألحق_بايت_ماتشو(البايتات, الجزء);
            أرجع;
        };
        ألحق_بايت_ماتشو(البايتات, الجزء | 0x80);
    }
}

عام عرف ألحق_أمر_مقطع_ماتشو(
    البايتات: &متغير متجه غ8,
    الاسم: &متجه غ8,
    العنوان: غير_موقع,
    حجم_الذاكرة: غير_موقع,
    إزاحة_الملف: غير_موقع,
    حجم_الملف: غير_موقع,
    الحماية_القصوى: غير_موقع,
    الحماية_الأولية: غير_موقع,
    عدد_الأقسام: غير_موقع
): منطقي {
    ألحق_غ32_ماتشو_ربط(البايتات, 0x19);
    ألحق_غ32_ماتشو_ربط(البايتات, 72 + عدد_الأقسام * 80);
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, الاسم)) { أرجع خطأ; };
    ألحق_غ64_ماتشو_ربط(البايتات, العنوان);
    ألحق_غ64_ماتشو_ربط(البايتات, حجم_الذاكرة);
    ألحق_غ64_ماتشو_ربط(البايتات, إزاحة_الملف);
    ألحق_غ64_ماتشو_ربط(البايتات, حجم_الملف);
    ألحق_غ32_ماتشو_ربط(البايتات, الحماية_القصوى);
    ألحق_غ32_ماتشو_ربط(البايتات, الحماية_الأولية);
    ألحق_غ32_ماتشو_ربط(البايتات, عدد_الأقسام);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    أرجع صواب;
}

عام عرف ألحق_أمر_قسم_ماتشو(
    البايتات: &متغير متجه غ8,
    اسم_القسم: &متجه غ8,
    اسم_المقطع: &متجه غ8,
    العنوان: غير_موقع,
    الحجم: غير_موقع,
    إزاحة_الملف: غير_موقع,
    أس_المحاذاة: غير_موقع,
    الأعلام: غير_موقع,
    المحجوز_الأول: غير_موقع,
    المحجوز_الثاني: غير_موقع
): منطقي {
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, اسم_القسم)) { أرجع خطأ; };
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, اسم_المقطع)) { أرجع خطأ; };
    ألحق_غ64_ماتشو_ربط(البايتات, العنوان);
    ألحق_غ64_ماتشو_ربط(البايتات, الحجم);
    ألحق_غ32_ماتشو_ربط(البايتات, إزاحة_الملف);
    ألحق_غ32_ماتشو_ربط(البايتات, أس_المحاذاة);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, الأعلام);
    ألحق_غ32_ماتشو_ربط(البايتات, المحجوز_الأول);
    ألحق_غ32_ماتشو_ربط(البايتات, المحجوز_الثاني);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    أرجع صواب;
}

عام عرف ألحق_أمر_مكتبة_ماتشو(
    البايتات: &متغير متجه غ8,
    المسار: &متجه غ8
): منطقي {
    دع البداية: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع حجم_الأمر: غير_موقع = حجم_أمر_مسار_ماتشو(24, المسار);
    ألحق_غ32_ماتشو_ربط(البايتات, 0xC);
    ألحق_غ32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_غ32_ماتشو_ربط(البايتات, 24);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_هوية_مكتبة_ماتشو(
    البايتات: &متغير متجه غ8,
    المسار: &متجه غ8
): منطقي {
    دع البداية: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع حجم_الأمر: غير_موقع = حجم_أمر_مسار_ماتشو(24, المسار);
    ألحق_غ32_ماتشو_ربط(البايتات, 0xD);
    ألحق_غ32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_غ32_ماتشو_ربط(البايتات, 24);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_غ32_ماتشو_ربط(البايتات, 0);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_مسار_تشغيل_ماتشو(
    البايتات: &متغير متجه غ8,
    المسار: &متجه غ8
): منطقي {
    دع البداية: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع حجم_الأمر: غير_موقع = حجم_أمر_مسار_ماتشو(12, المسار);
    ألحق_غ32_ماتشو_ربط(البايتات, 0x8000001C);
    ألحق_غ32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_غ32_ماتشو_ربط(البايتات, 12);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_محمل_ديناميكي_ماتشو(
    البايتات: &متغير متجه غ8,
    المسار: &متجه غ8
): منطقي {
    دع البداية: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع حجم_الأمر: غير_موقع = حجم_أمر_مسار_ماتشو(12, المسار);
    ألحق_غ32_ماتشو_ربط(البايتات, 0xE);
    ألحق_غ32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_غ32_ماتشو_ربط(البايتات, 12);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف فرق_نسبي_ص32_ماتشو(
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): اختيار غير_موقع {
    لو (الوجهة >= المصدر) {
        دع الفرق: غير_موقع = الوجهة - المصدر;
        لو (الفرق > 0x7FFFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الفرق);
    };
    دع الفرق: غير_موقع = المصدر - الوجهة;
    لو (الفرق > 0x80000000) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((4294967296 - الفرق) & 0xFFFFFFFF);
}

عام عرف رقع_فرع26_ماتشو(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): منطقي {
    دع الأصل: غير_موقع = اقرأ_غ32_ماتشو_ربط(البايتات, الموضع);
    دع قيمة_الإزاحة: متغير غير_موقع = 0;
    لو (الوجهة >= المصدر) {
        دع الفرق: غير_موقع = الوجهة - المصدر;
        لو ((الفرق % 4) != 0 || (الفرق / 4) > 0x1FFFFFF) {
            أرجع خطأ;
        };
        قيمة_الإزاحة := الفرق / 4;
    } وإلا {
        دع الفرق: غير_موقع = المصدر - الوجهة;
        لو ((الفرق % 4) != 0 || (الفرق / 4) > 0x2000000) {
            أرجع خطأ;
        };
        قيمة_الإزاحة := (0x4000000 - (الفرق / 4)) & 0x3FFFFFF;
    };
    دع الجديد: غير_موقع =
        (الأصل & 0xFC000000) | (قيمة_الإزاحة & 0x03FFFFFF);
    أرجع اكتب_غ32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}

عرف كود_فرق_صفحة_ماتشو(
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): اختيار غير_موقع {
    دع صفحة_المصدر: غير_موقع = المصدر / 4096;
    دع صفحة_الوجهة: غير_موقع = الوجهة / 4096;
    لو (صفحة_الوجهة >= صفحة_المصدر) {
        دع الفرق: غير_موقع = صفحة_الوجهة - صفحة_المصدر;
        لو (الفرق > 0xFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الفرق);
    };
    دع الفرق: غير_موقع = صفحة_المصدر - صفحة_الوجهة;
    لو (الفرق > 0x100000) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(0x200000 - الفرق);
}

عام عرف رقع_صفحة21_ماتشو(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): منطقي {
    دع كود_الصفحة: غير_موقع;
    طابق كود_فرق_صفحة_ماتشو(المصدر, الوجهة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { كود_الصفحة := القيمة; };
    دع الأصل: غير_موقع = اقرأ_غ32_ماتشو_ربط(البايتات, الموضع);
    لو ((الأصل & 0x9F000000) != 0x90000000) { أرجع خطأ; };
    دع الجزء_المنخفض: غير_موقع = (كود_الصفحة & 3) << 29;
    دع الجزء_العلوي: غير_موقع = ((كود_الصفحة >> 2) & 0x7FFFF) << 5;
    دع الجديد: غير_موقع =
        (الأصل & 0x9F00001F) | الجزء_المنخفض | الجزء_العلوي;
    أرجع اكتب_غ32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}

// A GOT-load of a symbol resolved inside the final image needs no GOT
// entry. The page relocation becomes a direct ADRP, and the LDR of the
// GOT slot relaxes to ADD Xd, Xn, #pageoff. Preserve Rt/Rn and use the
// existing PAGEOFF12 patcher for the unsigned byte offset.
عام عرف حوّل_تحميل_جوت_محلي_ماتشو(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل غير_موقع)
        || 4 > (الطول(*البايتات) مثل غير_موقع) - الموضع) {
        أرجع خطأ;
    };
    دع الأصل: غير_موقع = اقرأ_غ32_ماتشو_ربط(البايتات, الموضع);
    لو ((الأصل & 0xFFC00000) != 0xF9400000
        || (الأصل & 0x003FFC00) != 0) {
        أرجع خطأ;
    };
    دع سجلا_التعليمة: غير_موقع = الأصل & 0x3FF;
    أرجع اكتب_غ32_ماتشو_ربط_في(
        البايتات, الموضع, 0x91000000 | سجلا_التعليمة
    );
}

عام عرف رقع_صفحة12_ماتشو(
    البايتات: &متغير متجه غ8,
    الموضع: غير_موقع,
    الوجهة: غير_موقع
): منطقي {
    دع الأصل: غير_موقع = اقرأ_غ32_ماتشو_ربط(البايتات, الموضع);
    دع إزاحة_الصفحة: غير_موقع = الوجهة % 4096;
    دع قيمة_فورية: متغير غير_موقع = إزاحة_الصفحة;
    لو ((الأصل & 0x3B000000) == 0x39000000) {
        // ARM64 unsigned-immediate LD/ST scales by the access width.
        // SIMD Q transfers have size=0 but an effective 16-byte access.
        دع أس_المقياس: متغير غير_موقع = (الأصل >> 30) & 3;
        لو ((الأصل & 0x04000000) != 0
            && أس_المقياس == 0
            && ((الأصل >> 22) & 3) >= 2) {
            أس_المقياس := 4;
        };
        دع المقياس: غير_موقع = 1 << أس_المقياس;
        لو ((إزاحة_الصفحة % المقياس) != 0) { أرجع خطأ; };
        قيمة_فورية := إزاحة_الصفحة / المقياس;
    } وإلا {
        // ADD (immediate, unshifted) is the other PAGEOFF12 form.
        // Never write the 12-bit field of an unrelated instruction.
        لو ((الأصل & 0x7F800000) != 0x11000000
            || (الأصل & 0x00400000) != 0) { أرجع خطأ; };
    };
    دع الجديد: غير_موقع =
        (الأصل & 0xFFC003FF) | ((قيمة_فورية & 0xFFF) << 10);
    أرجع اكتب_غ32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}
