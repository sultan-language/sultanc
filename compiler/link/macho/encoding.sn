استورد std.encoding.binary;
// Mach-O executable serialization helpers owned by the linker. Relocatable
// object serialization remains under compiler/backend/object.

عام عرف حاذ_قيمة_ماتشو(
    القيمة: طبيعي,
    المحاذاة: طبيعي
): طبيعي {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عام عرف ألحق_بايت_ماتشو(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    ألحق(*البايتات, (القيمة & 0xFF) مثل ط8);
}

عام عرف ألحق_ط16_ماتشو_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFF) مثل ط16);
}

عام عرف ألحق_ط32_ماتشو_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل ط32);
}

عام عرف ألحق_ط64_ماتشو_ربط(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط64_بالبايت_الأقل_أهمية_أولا(البايتات, القيمة مثل ط64);
}

عام عرف ألحق_ط32_ماتشو_كبير(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط32_بالبايت_الأكثر_أهمية_أولا(البايتات, (القيمة & 0xFFFFFFFF) مثل ط32);
}

عام عرف ألحق_ط64_ماتشو_كبير(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط64_بالبايت_الأكثر_أهمية_أولا(البايتات, القيمة مثل ط64);
}

عام عرف اقرأ_ط32_ماتشو_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع موضع_واحد: طبيعي = الموضع + 1;
    دع موضع_اثنين: طبيعي = الموضع + 2;
    دع موضع_ثلاثة: طبيعي = الموضع + 3;
    دع البايت_صفر: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع البايت_واحد: طبيعي = (*البايتات)[موضع_واحد] مثل طبيعي;
    دع البايت_اثنان: طبيعي = (*البايتات)[موضع_اثنين] مثل طبيعي;
    دع البايت_ثلاثة: طبيعي = (*البايتات)[موضع_ثلاثة] مثل طبيعي;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عام عرف اقرأ_ط64_ماتشو_ربط(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الجزء_الأدنى: طبيعي = اقرأ_ط32_ماتشو_ربط(
        البايتات,
        الموضع
    );
    دع الجزء_الأعلى: طبيعي = اقرأ_ط32_ماتشو_ربط(
        البايتات,
        الموضع + 4
    );
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عام عرف اكتب_ط32_ماتشو_ربط_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    دع الحجم: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو (الموضع > الحجم || الحجم - الموضع < 4) { أرجع خطأ; };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < 4) {
        دع القاسم: طبيعي = 1 << (فهرس_البايت * 8);
        دع موضع_البايت: طبيعي = الموضع + فهرس_البايت;
        (*البايتات)[موضع_البايت] :=
            ((القيمة / القاسم) & 0xFF) مثل ط8;
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اكتب_ط64_ماتشو_ربط_في(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    دع الحجم: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو (الموضع > الحجم || الحجم - الموضع < 8) { أرجع خطأ; };
    لو (!اكتب_ط32_ماتشو_ربط_في(
        البايتات,
        الموضع,
        القيمة & 0xFFFFFFFF
    )) {
        أرجع خطأ;
    };
    أرجع اكتب_ط32_ماتشو_ربط_في(
        البايتات,
        الموضع + 4,
        القيمة / 4294967296
    );
}

عام عرف ألحق_أصفارا_ماتشو(
    البايتات: &متغير متجه ط8,
    العدد: طبيعي
): فراغ {
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < العدد) {
        ألحق(*البايتات, 0);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف ألحق_بايتات_ماتشو(
    الناتج: &متغير متجه ط8,
    المصدر: &متجه ط8
): فراغ {
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عام عرف أكمل_ماتشو_إلى_موضع(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي
): منطقي {
    دع الحجم_الحالي: طبيعي = الطول(*البايتات) مثل طبيعي;
    لو (الحجم_الحالي > الموضع) { أرجع خطأ; };
    ألحق_أصفارا_ماتشو(البايتات, الموضع - الحجم_الحالي);
    أرجع صواب;
}

عام عرف ألحق_اسم_ماتشو_ثابت(
    البايتات: &متغير متجه ط8,
    الاسم: &متجه ط8
): منطقي {
    لو ((الطول(*الاسم) مثل طبيعي) > 16) { أرجع خطأ; };
    ألحق_بايتات_ماتشو(البايتات, الاسم);
    ألحق_أصفارا_ماتشو(
        البايتات,
        16 - (الطول(*الاسم) مثل طبيعي)
    );
    أرجع صواب;
}

عام عرف ألحق_اسم_صفري_ماتشو(
    البايتات: &متغير متجه ط8,
    الاسم: &متجه ط8
): فراغ {
    ألحق_بايتات_ماتشو(البايتات, الاسم);
    ألحق(*البايتات, 0);
}

عام عرف حجم_أمر_مسار_ماتشو(
    الحجم_الثابت: طبيعي,
    المسار: &متجه ط8
): طبيعي {
    دع الحجم_الخام: طبيعي =
        الحجم_الثابت + (الطول(*المسار) مثل طبيعي) + 1;
    أرجع حاذ_قيمة_ماتشو(الحجم_الخام, 8);
}

عام عرف ألحق_يو_ليب_ماتشو(
    البايتات: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    طالما (صواب) {
        دع البايت_الحالي: متغير طبيعي = الباقي & 0x7F;
        الباقي := الباقي >> 7;
        لو (الباقي != 0) {
            البايت_الحالي := البايت_الحالي | 0x80;
        };
        ألحق_بايت_ماتشو(البايتات, البايت_الحالي);
        لو (الباقي == 0) { أرجع; };
    }
}

عام عرف ألحق_سليب_ماتشو(
    البايتات: &متغير متجه ط8,
    القيمة: عدد
): فراغ {
    دع الباقي: متغير عدد = القيمة;
    طالما (صواب) {
        دع الجزء_الموقع: متغير عدد = الباقي % 128;
        لو (الجزء_الموقع < 0) { الجزء_الموقع := الجزء_الموقع + 128; };
        دع الجزء: طبيعي = الجزء_الموقع مثل طبيعي;
        الباقي := (الباقي - الجزء_الموقع) / 128;
        دع بت_الإشارة: منطقي = الجزء >= 64;
        دع انتهى_موجب: منطقي = الباقي == 0 && !بت_الإشارة;
        دع انتهى_سالب: منطقي = الباقي == -1 && بت_الإشارة;
        لو (انتهى_موجب || انتهى_سالب) {
            ألحق_بايت_ماتشو(البايتات, الجزء);
            أرجع;
        };
        ألحق_بايت_ماتشو(البايتات, الجزء | 0x80);
    }
}

عام عرف ألحق_أمر_مقطع_ماتشو(
    البايتات: &متغير متجه ط8,
    الاسم: &متجه ط8,
    العنوان: طبيعي,
    حجم_الذاكرة: طبيعي,
    إزاحة_الملف: طبيعي,
    حجم_الملف: طبيعي,
    الحماية_القصوى: طبيعي,
    الحماية_الأولية: طبيعي,
    عدد_الأقسام: طبيعي
): منطقي {
    ألحق_ط32_ماتشو_ربط(البايتات, 0x19);
    ألحق_ط32_ماتشو_ربط(البايتات, 72 + عدد_الأقسام * 80);
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, الاسم)) { أرجع خطأ; };
    ألحق_ط64_ماتشو_ربط(البايتات, العنوان);
    ألحق_ط64_ماتشو_ربط(البايتات, حجم_الذاكرة);
    ألحق_ط64_ماتشو_ربط(البايتات, إزاحة_الملف);
    ألحق_ط64_ماتشو_ربط(البايتات, حجم_الملف);
    ألحق_ط32_ماتشو_ربط(البايتات, الحماية_القصوى);
    ألحق_ط32_ماتشو_ربط(البايتات, الحماية_الأولية);
    ألحق_ط32_ماتشو_ربط(البايتات, عدد_الأقسام);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    أرجع صواب;
}

عام عرف ألحق_أمر_قسم_ماتشو(
    البايتات: &متغير متجه ط8,
    اسم_القسم: &متجه ط8,
    اسم_المقطع: &متجه ط8,
    العنوان: طبيعي,
    الحجم: طبيعي,
    إزاحة_الملف: طبيعي,
    أس_المحاذاة: طبيعي,
    الأعلام: طبيعي,
    المحجوز_الأول: طبيعي,
    المحجوز_الثاني: طبيعي
): منطقي {
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, اسم_القسم)) { أرجع خطأ; };
    لو (!ألحق_اسم_ماتشو_ثابت(البايتات, اسم_المقطع)) { أرجع خطأ; };
    ألحق_ط64_ماتشو_ربط(البايتات, العنوان);
    ألحق_ط64_ماتشو_ربط(البايتات, الحجم);
    ألحق_ط32_ماتشو_ربط(البايتات, إزاحة_الملف);
    ألحق_ط32_ماتشو_ربط(البايتات, أس_المحاذاة);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, الأعلام);
    ألحق_ط32_ماتشو_ربط(البايتات, المحجوز_الأول);
    ألحق_ط32_ماتشو_ربط(البايتات, المحجوز_الثاني);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    أرجع صواب;
}

عام عرف ألحق_أمر_مكتبة_ماتشو(
    البايتات: &متغير متجه ط8,
    المسار: &متجه ط8
): منطقي {
    دع البداية: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع حجم_الأمر: طبيعي = حجم_أمر_مسار_ماتشو(24, المسار);
    ألحق_ط32_ماتشو_ربط(البايتات, 0xC);
    ألحق_ط32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_ط32_ماتشو_ربط(البايتات, 24);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_هوية_مكتبة_ماتشو(
    البايتات: &متغير متجه ط8,
    المسار: &متجه ط8
): منطقي {
    دع البداية: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع حجم_الأمر: طبيعي = حجم_أمر_مسار_ماتشو(24, المسار);
    ألحق_ط32_ماتشو_ربط(البايتات, 0xD);
    ألحق_ط32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_ط32_ماتشو_ربط(البايتات, 24);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_ط32_ماتشو_ربط(البايتات, 0);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_مسار_تشغيل_ماتشو(
    البايتات: &متغير متجه ط8,
    المسار: &متجه ط8
): منطقي {
    دع البداية: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع حجم_الأمر: طبيعي = حجم_أمر_مسار_ماتشو(12, المسار);
    ألحق_ط32_ماتشو_ربط(البايتات, 0x8000001C);
    ألحق_ط32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_ط32_ماتشو_ربط(البايتات, 12);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف ألحق_أمر_محمل_ديناميكي_ماتشو(
    البايتات: &متغير متجه ط8,
    المسار: &متجه ط8
): منطقي {
    دع البداية: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع حجم_الأمر: طبيعي = حجم_أمر_مسار_ماتشو(12, المسار);
    ألحق_ط32_ماتشو_ربط(البايتات, 0xE);
    ألحق_ط32_ماتشو_ربط(البايتات, حجم_الأمر);
    ألحق_ط32_ماتشو_ربط(البايتات, 12);
    ألحق_اسم_صفري_ماتشو(البايتات, المسار);
    أرجع أكمل_ماتشو_إلى_موضع(البايتات, البداية + حجم_الأمر);
}

عام عرف فرق_نسبي_ص32_ماتشو(
    المصدر: طبيعي,
    الوجهة: طبيعي
): اختياري طبيعي {
    لو (الوجهة >= المصدر) {
        دع الفرق: طبيعي = الوجهة - المصدر;
        لو (الفرق > 0x7FFFFFFF) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الفرق);
    };
    دع الفرق: طبيعي = المصدر - الوجهة;
    لو (الفرق > 0x80000000) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((4294967296 - الفرق) & 0xFFFFFFFF);
}

عام عرف رقع_فرع26_ماتشو(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع الأصل: طبيعي = اقرأ_ط32_ماتشو_ربط(البايتات, الموضع);
    دع قيمة_الإزاحة: متغير طبيعي = 0;
    لو (الوجهة >= المصدر) {
        دع الفرق: طبيعي = الوجهة - المصدر;
        لو ((الفرق % 4) != 0 || (الفرق / 4) > 0x1FFFFFF) {
            أرجع خطأ;
        };
        قيمة_الإزاحة := الفرق / 4;
    } وإلا {
        دع الفرق: طبيعي = المصدر - الوجهة;
        لو ((الفرق % 4) != 0 || (الفرق / 4) > 0x2000000) {
            أرجع خطأ;
        };
        قيمة_الإزاحة := (0x4000000 - (الفرق / 4)) & 0x3FFFFFF;
    };
    دع الجديد: طبيعي =
        (الأصل & 0xFC000000) | (قيمة_الإزاحة & 0x03FFFFFF);
    أرجع اكتب_ط32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}

عرف كود_فرق_صفحة_ماتشو(
    المصدر: طبيعي,
    الوجهة: طبيعي
): اختياري طبيعي {
    دع صفحة_المصدر: طبيعي = المصدر / 4096;
    دع صفحة_الوجهة: طبيعي = الوجهة / 4096;
    لو (صفحة_الوجهة >= صفحة_المصدر) {
        دع الفرق: طبيعي = صفحة_الوجهة - صفحة_المصدر;
        لو (الفرق > 0xFFFFF) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الفرق);
    };
    دع الفرق: طبيعي = صفحة_المصدر - صفحة_الوجهة;
    لو (الفرق > 0x100000) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(0x200000 - الفرق);
}

عام عرف رقع_صفحة21_ماتشو(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع كود_الصفحة: طبيعي;
    طابق كود_فرق_صفحة_ماتشو(المصدر, الوجهة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { كود_الصفحة := القيمة; };
    دع الأصل: طبيعي = اقرأ_ط32_ماتشو_ربط(البايتات, الموضع);
    لو ((الأصل & 0x9F000000) != 0x90000000) { أرجع خطأ; };
    دع الجزء_المنخفض: طبيعي = (كود_الصفحة & 3) << 29;
    دع الجزء_العلوي: طبيعي = ((كود_الصفحة >> 2) & 0x7FFFF) << 5;
    دع الجديد: طبيعي =
        (الأصل & 0x9F00001F) | الجزء_المنخفض | الجزء_العلوي;
    أرجع اكتب_ط32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}

// A GOT-load of a symbol resolved inside the final image needs no GOT
// entry. The page relocation becomes a direct ADRP, and the LDR of the
// GOT slot relaxes to ADD Xd, Xn, #pageoff. Preserve Rt/Rn and use the
// existing PAGEOFF12 patcher for the unsigned byte offset.
عام عرف حوّل_تحميل_جوت_محلي_ماتشو(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي
): منطقي {
    لو (الموضع > (الطول(*البايتات) مثل طبيعي)
        || 4 > (الطول(*البايتات) مثل طبيعي) - الموضع) {
        أرجع خطأ;
    };
    دع الأصل: طبيعي = اقرأ_ط32_ماتشو_ربط(البايتات, الموضع);
    لو ((الأصل & 0xFFC00000) != 0xF9400000
        || (الأصل & 0x003FFC00) != 0) {
        أرجع خطأ;
    };
    دع سجلا_التعليمة: طبيعي = الأصل & 0x3FF;
    أرجع اكتب_ط32_ماتشو_ربط_في(
        البايتات, الموضع, 0x91000000 | سجلا_التعليمة
    );
}

عام عرف رقع_صفحة12_ماتشو(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    الوجهة: طبيعي
): منطقي {
    دع الأصل: طبيعي = اقرأ_ط32_ماتشو_ربط(البايتات, الموضع);
    دع إزاحة_الصفحة: طبيعي = الوجهة % 4096;
    دع قيمة_فورية: متغير طبيعي = إزاحة_الصفحة;
    لو ((الأصل & 0x3B000000) == 0x39000000) {
        // ARM64 unsigned-immediate LD/ST scales by the access width.
        // SIMD Q transfers have size=0 but an effective 16-byte access.
        دع أس_المقياس: متغير طبيعي = (الأصل >> 30) & 3;
        لو ((الأصل & 0x04000000) != 0
            && أس_المقياس == 0
            && ((الأصل >> 22) & 3) >= 2) {
            أس_المقياس := 4;
        };
        دع المقياس: طبيعي = 1 << أس_المقياس;
        لو ((إزاحة_الصفحة % المقياس) != 0) { أرجع خطأ; };
        قيمة_فورية := إزاحة_الصفحة / المقياس;
    } وإلا {
        // ADD (immediate, unshifted) is the other PAGEOFF12 form.
        // Never write the 12-bit field of an unrelated instruction.
        لو ((الأصل & 0x7F800000) != 0x11000000
            || (الأصل & 0x00400000) != 0) { أرجع خطأ; };
    };
    دع الجديد: طبيعي =
        (الأصل & 0xFFC003FF) | ((قيمة_فورية & 0xFFF) << 10);
    أرجع اكتب_ط32_ماتشو_ربط_في(البايتات, الموضع, الجديد);
}
