عام عرف اسما_ماتشو_متساويان(
    الاسم_الأول: &متجه ط8,
    الاسم_الثاني: &متجه ط8
): منطقي {
    لو (الطول(*الاسم_الأول) != الطول(*الاسم_الثاني)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*الاسم_الأول) مثل طبيعي)) {
        لو (
            (*الاسم_الأول)[فهرس_البايت]
                != (*الاسم_الثاني)[فهرس_البايت]
        ) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}


// Convert a Mach-O external C ABI spelling back to its canonical linker name.
// Mach-O object symbols carry exactly one leading underscore for C ABI names.
عام عرف اسم_رمز_سي_ماتشو_الأساسي(الاسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع البداية: متغير طبيعي = 0;
    لو ((الطول(*الاسم) مثل طبيعي) > 0 && (*الاسم)[0] == 0x5F) {
        البداية := 1;
    };
    دع فهرس_البايت: متغير طبيعي = البداية;
    طالما (فهرس_البايت < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(الناتج, (*الاسم)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

