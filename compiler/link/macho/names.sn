استورد std.text.from_bytes;
// Mach-O ABI spellings are centralized here so normal linker logic never
// carries raw external byte names inline.
عام عرف اسم_رمز_دخول_ماتشو_الافتراضي(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«_main»);
    أرجع الاسم;
}

عام عرف اسم_حاوية_دوارف_ماتشو(): متجه ط8 {
    دع الاسم: متجه ط8 = بايتات_من_نص(«__DWARF»);
    أرجع الاسم;
}

