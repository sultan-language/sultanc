عام عرف اسما_ماتشو_متساويان(
    الاسم_الأول: &متجه غ8,
    الاسم_الثاني: &متجه غ8
): منطقي {
    لو (الطول(*الاسم_الأول) != الطول(*الاسم_الثاني)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الاسم_الأول) مثل غير_موقع)) {
        لو (
            (*الاسم_الأول)[فهرس_البايت]
                != (*الاسم_الثاني)[فهرس_البايت]
        ) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}


// Convert a Mach-O external C ABI spelling back to its canonical linker name.
// Mach-O object symbols carry exactly one leading underscore for C ABI names.
عام عرف اسم_رمز_سي_ماتشو_الأساسي(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع البداية: متغير غير_موقع = 0;
    لو ((الطول(*الاسم) مثل غير_موقع) > 0 && (*الاسم)[0] == 0x5F) {
        البداية := 1;
    };
    دع فهرس_البايت: متغير غير_موقع = البداية;
    بينما (فهرس_البايت < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

