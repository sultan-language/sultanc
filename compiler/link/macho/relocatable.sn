استورد std.text.from_bytes;
استورد compiler.link.context;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.macho.encoding;
استورد compiler.backend.target.target_model;

عام نوع خطأ_كائن_مترابط_ماتشو =
    | هدف_غير_مدعوم
    | حقائق_قسم_غير_صالحة
    | مرجع_إزاحة_غير_صالح
;

عام نوع نتيجة_كائن_مترابط_ماتشو =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_كائن_مترابط_ماتشو
;

عرف نوع_معالج_كائن_ماتشو(الهدف: &واصف_هدف): اختياري طبيعي {
    لو ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64
        || (*الهدف).نموذج_البيانات.ترتيب_البايت != ترتيب_بايت.صغير()) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(0x0100000C);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(0x01000007);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نوع_معالج_فرعي_كائن_ماتشو(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(0); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(3);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قسم_ماتشو_صفري_مترابط(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
        دع النوع: طبيعي = الأعلام & 0xFF;
        أرجع النوع == 1 || النوع == 0xC || النوع == 0x12;
    }
    | _ -> { أرجع خطأ; };
}

عرف أس_محاذاة_ماتشو_مترابط(المحاذاة: طبيعي): اختياري طبيعي {
    لو (المحاذاة == 0) { أرجع اختياري.موجود(0); };
    دع القيمة: متغير طبيعي = 1;
    دع الأس: متغير طبيعي = 0;
    طالما (القيمة < المحاذاة && الأس < 31) {
        القيمة := القيمة << 1;
        الأس := الأس + 1;
    }
    لو (القيمة != المحاذاة) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأس);
}

عرف ألحق_اسم_إلى_جدول_ماتشو_مترابط(
    الجدول: &متغير متجه ط8,
    الاسم: &متجه ط8
): طبيعي {
    دع الموضع: طبيعي = الطول(*الجدول) مثل طبيعي;
    ألحق_بايتات_ماتشو(الجدول, الاسم);
    ألحق(*الجدول, 0);
    أرجع الموضع;
}

عرف عدد_إزاحات_قسم_ماتشو_مترابط(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الفهرس: متغير طبيعي = 0;
    دع ذراع64: منطقي = (*السياق).الهدف.المعمارية.الهوية
        == هوية_معمارية.ذراع_أربعة_وستون();
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        لو ((*الحافة).القسم.القيمة == القسم.القيمة) {
            العدد := العدد + 1;
            لو (ذراع64 && (*الحافة).إضافة != 0) {
                دع نوع_الإزاحة: طبيعي = (*الحافة).رمز_صيغة / 16;
                لو (نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                    || نوع_الإزاحة == 4) {
                    العدد := العدد + 1;
                };
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ترميز_إضافة24_ماتشو(الإضافة: عدد): اختياري طبيعي {
    لو (الإضافة >= 0) {
        دع القيمة: طبيعي = الإضافة مثل طبيعي;
        لو (القيمة > 0x7FFFFF) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(القيمة);
    };
    // Avoid negating the minimum signed value before the range check.
    لو (الإضافة < -8388608) { أرجع اختياري.لا_شيء(); };
    دع المقدار: طبيعي = (-الإضافة) مثل طبيعي;
    أرجع اختياري.موجود(0x1000000 - المقدار);
}

عرف فهرس_قسم_ماتشو_مترابط(
    الأقسام: &متجه قسم_ربط,
    المعرف: معرف_قسم_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الأقسام) مثل طبيعي)) {
        لو ((*الأقسام)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس + 1);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف فهرس_رمز_ماتشو_مترابط(
    السياق: &سياق_ربط,
    المعرف: معرف_رمز_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        لو ((*السياق).الرموز.الرموز[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ألحق_إزاحات_قسم_ماتشو_مترابط(
    الناتج: &متغير متجه ط8,
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): منطقي {
    دع الفهرس: متغير طبيعي = 0;
    دع ذراع64: منطقي = (*السياق).الهدف.المعمارية.الهوية
        == هوية_معمارية.ذراع_أربعة_وستون();
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        لو ((*الحافة).القسم.القيمة == القسم.القيمة) {
            لو ((*الحافة).الإزاحة > 0x7FFFFFFF) { أرجع خطأ; };
            لو (ذراع64 && (*الحافة).إضافة != 0
                && (((*الحافة).رمز_صيغة / 16) == 2
                    || ((*الحافة).رمز_صيغة / 16) == 3
                    || ((*الحافة).رمز_صيغة / 16) == 4)) {
                دع ترميز_الإضافة: طبيعي;
                طابق ترميز_إضافة24_ماتشو((*الحافة).إضافة) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { ترميز_الإضافة := القيمة; };
                ألحق_ط32_ماتشو_ربط(الناتج, (*الحافة).الإزاحة);
                ألحق_ط32_ماتشو_ربط(
                    الناتج,
                    ترميز_الإضافة | ((0xA4 مثل طبيعي) * (16777216 مثل طبيعي))
                );
            };
            دع المرجع: طبيعي;
            دع البايت_العلوي: متغير طبيعي = (*الحافة).رمز_صيغة & 0xFF;
            طابق (*الحافة).المرجع مع
            | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
                طابق فهرس_رمز_ماتشو_مترابط(السياق, معرف_الرمز) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { المرجع := القيمة; };
                البايت_العلوي := البايت_العلوي | 0x08;
            }
            | مرجع_إزاحة_ربط.قسم(معرف_القسم) -> {
                طابق فهرس_قسم_ماتشو_مترابط(
                    &(*السياق).الأقسام,
                    معرف_القسم
                ) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { المرجع := القيمة; };
                البايت_العلوي := البايت_العلوي & 0xF7;
            };
            لو (المرجع > 0xFFFFFF) { أرجع خطأ; };
            لو (ذراع64
                && (((*الحافة).رمز_صيغة / 16) == 5
                    || ((*الحافة).رمز_صيغة / 16) == 6)) {
                طابق (*الحافة).المرجع مع
                | مرجع_إزاحة_ربط.رمز(_) -> { }
                | _ -> { أرجع خطأ; };
            };
            // Only instruction relocations take an ARM64_RELOC_ADDEND.
            // An UNSIGNED data relocation carries its addend in the field;
            // the section writer materializes any additional graph addend.
            لو (ذراع64 && (*الحافة).إضافة != 0
                && ((*الحافة).رمز_صيغة / 16) != 0
                && ((*الحافة).رمز_صيغة / 16) != 2
                && ((*الحافة).رمز_صيغة / 16) != 3
                && ((*الحافة).رمز_صيغة / 16) != 4) { أرجع خطأ; };
            ألحق_ط32_ماتشو_ربط(الناتج, (*الحافة).الإزاحة);
            ألحق_ط32_ماتشو_ربط(
                الناتج,
                المرجع | (البايت_العلوي * 16777216)
            );
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عام عرف ابن_كائن_ماتشو_مترابط(
    السياق: &سياق_ربط
): نتيجة_كائن_مترابط_ماتشو {
    دع نوع_المعالج: طبيعي;
    طابق نوع_معالج_كائن_ماتشو(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { نوع_المعالج := القيمة; };
    دع نوع_المعالج_الفرعي: طبيعي;
    طابق نوع_معالج_فرعي_كائن_ماتشو(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { نوع_المعالج_الفرعي := القيمة; };

    دع عدد_الأقسام: طبيعي = الطول((*السياق).الأقسام) مثل طبيعي;
    لو (عدد_الأقسام > 255) {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
        );
    };
    دع حجم_أمر_المقطع: طبيعي = 72 + عدد_الأقسام * 80;
    دع حجم_أوامر_التحميل: طبيعي = حجم_أمر_المقطع + 24;
    دع بداية_المحتوى: طبيعي = 32 + حجم_أوامر_التحميل;
    دع مواضع_المحتوى: متغير متجه طبيعي = [];
    دع عناوين_الأقسام: متغير متجه طبيعي = [];
    دع أسس_المحاذاة: متغير متجه طبيعي = [];
    دع مواضع_الإزاحات: متغير متجه طبيعي = [];
    دع أعداد_الإزاحات: متغير متجه طبيعي = [];
    دع موضع_المحتوى: متغير طبيعي = بداية_المحتوى;
    دع عنوان_القسم: متغير طبيعي = 0;
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع أس_المحاذاة: طبيعي;
        طابق أس_محاذاة_ماتشو_مترابط((*القسم).المحاذاة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
            );
        }
        | اختياري.موجود(القيمة) -> { أس_المحاذاة := القيمة; };
        دع المحاذاة: طبيعي = 1 << أس_المحاذاة;
        عنوان_القسم := حاذ_قيمة_ماتشو(عنوان_القسم, المحاذاة);
        ألحق(عناوين_الأقسام, عنوان_القسم);
        ألحق(أسس_المحاذاة, أس_المحاذاة);
        لو (قسم_ماتشو_صفري_مترابط(القسم)) {
            ألحق(مواضع_المحتوى, 0);
        } وإلا {
            موضع_المحتوى := حاذ_قيمة_ماتشو(موضع_المحتوى, المحاذاة);
            ألحق(مواضع_المحتوى, موضع_المحتوى);
            موضع_المحتوى := موضع_المحتوى + (*القسم).الحجم;
        };
        عنوان_القسم := عنوان_القسم + (*القسم).الحجم;
        دع عدد_الإزاحات: طبيعي = عدد_إزاحات_قسم_ماتشو_مترابط(
            السياق,
            (*القسم).المعرف
        );
        ألحق(أعداد_الإزاحات, عدد_الإزاحات);
        ألحق(مواضع_الإزاحات, 0);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع موضع_الإزاحات: متغير طبيعي = حاذ_قيمة_ماتشو(موضع_المحتوى, 4);
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        لو (أعداد_الإزاحات[فهرس_القسم] > 0) {
            مواضع_الإزاحات[فهرس_القسم] := موضع_الإزاحات;
            موضع_الإزاحات := موضع_الإزاحات
                + أعداد_الإزاحات[فهرس_القسم] * 8;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع موضع_الرموز: طبيعي = حاذ_قيمة_ماتشو(موضع_الإزاحات, 8);
    دع عدد_الرموز: طبيعي = الطول((*السياق).الرموز.الرموز) مثل طبيعي;
    دع موضع_النصوص: طبيعي = موضع_الرموز + عدد_الرموز * 16;
    دع جدول_النصوص: متغير متجه ط8 = [0];
    دع مواضع_أسماء_الرموز: متغير متجه طبيعي = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        ألحق(
            مواضع_أسماء_الرموز,
            ألحق_اسم_إلى_جدول_ماتشو_مترابط(
                &متغير جدول_النصوص,
                &(*السياق).الرموز.الرموز[فهرس_الرمز].الاسم
            )
        );
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    دع الصورة: متغير متجه ط8 = [];
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0xFEEDFACF);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, نوع_المعالج);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, نوع_المعالج_الفرعي);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 1);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 2);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, حجم_أوامر_التحميل);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);

    دع اسم_مقطع_فارغ: متجه ط8 = [];
    لو (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_فارغ,
        0,
        عنوان_القسم,
        بداية_المحتوى,
        موضع_المحتوى - بداية_المحتوى,
        7,
        7,
        عدد_الأقسام
    )) {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
        );
    };
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع اسم_المقطع: متجه ط8;
        طابق (*القسم).الاسم.اسم_الحاوية مع
        | اختياري.لا_شيء -> { اسم_المقطع := انسخ_بايتات(&اسم_مقطع_فارغ); }
        | اختياري.موجود(الاسم) -> { اسم_المقطع := انسخ_بايتات(&الاسم); };
        دع الأعلام: طبيعي;
        طابق (*القسم).حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.ماتشو(القيمة) -> { الأعلام := القيمة; }
        | _ -> {
            أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
            );
        };
        لو (!ألحق_اسم_ماتشو_ثابت(&متغير الصورة, &(*القسم).الاسم.اسم_القسم)
            || !ألحق_اسم_ماتشو_ثابت(&متغير الصورة, &اسم_المقطع)) {
            أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
            );
        };
        ألحق_ط64_ماتشو_ربط(&متغير الصورة, عناوين_الأقسام[فهرس_القسم]);
        ألحق_ط64_ماتشو_ربط(&متغير الصورة, (*القسم).الحجم);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, مواضع_المحتوى[فهرس_القسم]);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, أسس_المحاذاة[فهرس_القسم]);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, مواضع_الإزاحات[فهرس_القسم]);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, أعداد_الإزاحات[فهرس_القسم]);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, الأعلام);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
        فهرس_القسم := فهرس_القسم + 1;
    }

    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 2);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 24);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_الرموز);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, عدد_الرموز);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_النصوص);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, الطول(جدول_النصوص) مثل طبيعي);

    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو (!قسم_ماتشو_صفري_مترابط(القسم)) {
            لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, مواضع_المحتوى[فهرس_القسم])) {
                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                    خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
                );
            };
            طابق (*القسم).المحتوى مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                    خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
                );
            }
            | اختياري.موجود(المحتوى) -> {
                // Input instruction immediates have already been absorbed
                // into the canonical graph. Clear them for all three ARM64
                // instruction fixups before emitting an ADDEND pair.
                دع المحتوى_المرقع: متغير متجه ط8 = انسخ_بايتات(&المحتوى);
                لو ((*السياق).الهدف.المعمارية.الهوية
                    == هوية_معمارية.ذراع_أربعة_وستون()) {
                    دع فهرس_الحافة: متغير طبيعي = 0;
                    طالما (فهرس_الحافة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
                        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الحافة];
                        لو ((*الحافة).القسم.القيمة == (*القسم).المعرف.القيمة
                            && ((*الحافة).إضافة != 0)
                            && (((*الحافة).رمز_صيغة / 16) == 2
                                || ((*الحافة).رمز_صيغة / 16) == 3
                                || ((*الحافة).رمز_صيغة / 16) == 4)) {
                            دع الموضع: طبيعي = (*الحافة).الإزاحة;
                            لو (الموضع > (الطول(المحتوى_المرقع) مثل طبيعي)
                                || 4 > (الطول(المحتوى_المرقع) مثل طبيعي) - الموضع
                                || (الموضع % 4) != 0) {
                                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                    خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                );
                            };
                            دع التعليمة: طبيعي =
                                اقرأ_ط32_ماتشو_ربط(&المحتوى_المرقع, الموضع);
                            دع النوع: طبيعي = (*الحافة).رمز_صيغة / 16;
                            دع التعليمة_المنقحة: متغير طبيعي = التعليمة;
                            لو (النوع == 2) {
                                لو ((التعليمة & 0x7C000000) != 0x14000000) {
                                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                        خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                    );
                                };
                                التعليمة_المنقحة := التعليمة & 0xFC000000;
                            } وإلا لو (النوع == 3) {
                                لو ((التعليمة & 0x9F000000) != 0x90000000) {
                                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                        خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                    );
                                };
                                التعليمة_المنقحة := التعليمة & 0x9F00001F;
                            } وإلا {
                                دع تحميل_مباشر: منطقي =
                                    (التعليمة & 0x3B000000) == 0x39000000;
                                دع جمع_مباشر: منطقي =
                                    (التعليمة & 0x7F800000) == 0x11000000
                                    && (التعليمة & 0x00400000) == 0;
                                لو (!تحميل_مباشر && !جمع_مباشر) {
                                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                        خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                    );
                                };
                                التعليمة_المنقحة := التعليمة & 0xFFC003FF;
                            };
                            لو (!اكتب_ط32_ماتشو_ربط_في(
                                &متغير المحتوى_المرقع, الموضع, التعليمة_المنقحة
                            )) {
                                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                    خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                );
                            };
                        } وإلا لو ((*الحافة).القسم.القيمة
                                == (*القسم).المعرف.القيمة
                            && ((*الحافة).رمز_صيغة / 16) == 0
                            && (*الحافة).إضافة != 0) {
                            دع الموضع: طبيعي = (*الحافة).الإزاحة;
                            دع أس_العرض: طبيعي =
                                ((*الحافة).رمز_صيغة / 2) & 3;
                            دع العرض: طبيعي = 1 << أس_العرض;
                            لو (!(العرض == 4 || العرض == 8)
                                || الموضع > (الطول(المحتوى_المرقع) مثل طبيعي)
                                || العرض > (الطول(المحتوى_المرقع) مثل طبيعي) - الموضع) {
                                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                    خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                );
                            };
                            دع الأصل: طبيعي;
                            لو (العرض == 8) {
                                الأصل := اقرأ_ط64_ماتشو_ربط(&المحتوى_المرقع, الموضع);
                            } وإلا {
                                الأصل := اقرأ_ط32_ماتشو_ربط(&المحتوى_المرقع, الموضع);
                            };
                            دع القيمة: طبيعي;
                            لو ((*الحافة).إضافة >= 0) {
                                دع المقدار: طبيعي = (*الحافة).إضافة مثل طبيعي;
                                لو (المقدار > 0xFFFFFFFFFFFFFFFF - الأصل) {
                                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                        خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                    );
                                };
                                القيمة := الأصل + المقدار;
                            } وإلا {
                                دع المقدار: طبيعي =
                                    ((-((*الحافة).إضافة + 1)) مثل طبيعي) + 1;
                                لو (المقدار > الأصل) {
                                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                        خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                    );
                                };
                                القيمة := الأصل - المقدار;
                            };
                            دع كتب: منطقي;
                            لو (العرض == 8) {
                                كتب := اكتب_ط64_ماتشو_ربط_في(
                                    &متغير المحتوى_المرقع, الموضع, القيمة
                                );
                            } وإلا {
                                كتب := القيمة <= 0xFFFFFFFF
                                    && اكتب_ط32_ماتشو_ربط_في(
                                        &متغير المحتوى_المرقع, الموضع, القيمة
                                    );
                            };
                            لو (!كتب) {
                                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                                    خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                                );
                            };
                        };
                        فهرس_الحافة := فهرس_الحافة + 1;
                    }
                };
                ألحق_بايتات_ماتشو(&متغير الصورة, &المحتوى_المرقع);
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        لو (أعداد_الإزاحات[فهرس_القسم] > 0) {
            لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, مواضع_الإزاحات[فهرس_القسم])
                || !ألحق_إزاحات_قسم_ماتشو_مترابط(
                    &متغير الصورة,
                    السياق,
                    (*السياق).الأقسام[فهرس_القسم].المعرف
                )) {
                أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                    خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
                );
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_الرموز)) {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
        );
    };
    فهرس_الرمز := 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        دع النوع: متغير طبيعي = 1;
        دع فهرس_قسم_الرمز: متغير طبيعي = 0;
        دع الوصف: متغير طبيعي = 0;
        دع القيمة: متغير طبيعي = 0;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { }
        | حالة_رمز_ربط.ديناميكي(_) -> { }
        | حالة_رمز_ربط.معرف(التعريف) -> {
            لو (!قوة_تعريف_رمز_ربط_قوية(التعريف.القوة)) {
                الوصف := 0x80;
            };
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
                طابق فهرس_قسم_ماتشو_مترابط(
                    &(*السياق).الأقسام,
                    معرف_القسم
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                        خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
                    );
                }
                | اختياري.موجود(الفهرس) -> { فهرس_قسم_الرمز := الفهرس; };
                النوع := 0x0F;
                دع فهرس_عنوان_القسم: طبيعي = فهرس_قسم_الرمز - 1;
                القيمة := عناوين_الأقسام[فهرس_عنوان_القسم] + الإزاحة;
            }
            | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> {
                النوع := 0x03;
                القيمة := العنوان;
            }
            | موضع_تعريف_رمز_ربط.غير_محدد -> { };
        }
        | حالة_رمز_ربط.كسول(_, _) -> {
            أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
                خطأ_كائن_مترابط_ماتشو.مرجع_إزاحة_غير_صالح()
            );
        };
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, مواضع_أسماء_الرموز[فهرس_الرمز]);
        ألحق_بايت_ماتشو(&متغير الصورة, النوع);
        ألحق_بايت_ماتشو(&متغير الصورة, فهرس_قسم_الرمز);
        ألحق_ط16_ماتشو_ربط(&متغير الصورة, الوصف);
        ألحق_ط64_ماتشو_ربط(&متغير الصورة, القيمة);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_النصوص)) {
        أرجع نتيجة_كائن_مترابط_ماتشو.خطأ(
            خطأ_كائن_مترابط_ماتشو.حقائق_قسم_غير_صالحة()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_النصوص);
    أرجع نتيجة_كائن_مترابط_ماتشو.نجح(الصورة);
}
