        };
        فهرس_المسار := فهرس_المسار + 1;
    }

    إذا (!مكتبة_مشتركة) {
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x80000028);
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 24);
        ألحق_ط64_ماتشو_ربط(&متغير الصورة, إزاحة_الدخول);
