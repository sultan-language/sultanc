استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.address_resolution;
استورد compiler.link.macho.encoding;
استورد compiler.link.macho.code_signature;
استورد compiler.link.macho.names;
استورد compiler.link.dependency.llvm_names;
استورد compiler.backend.target.target_model;

عام نوع خطأ_صورة_ماتشو_تنفيذية =
    | هدف_غير_مدعوم
    | تخطيط_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_محلول
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
    | توقيع_فشل
;

عام نوع نتيجة_صورة_ماتشو_تنفيذية =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_صورة_ماتشو_تنفيذية
;

نوع رمز_ديناميكي_ماتشو_ربط = {
    المعرف: معرف_رمز_ربط,
    الاسم: متجه غ8,
    ترتيب_المكتبة: غير_موقع,
    إزاحة_الاسم: غير_موقع,
    التعريف: اختيار تعريف_رمز_ربط
};

نوع سجل_ربط_ديناميكي_ماتشو = {
    الرمز: معرف_رمز_ربط,
    ترتيب_المقطع: غير_موقع,
    الإزاحة_في_المقطع: غير_موقع,
    الإضافة: عدد
};

نوع حافة_عقدة_تصدير_ماتشو = {
    البايت: غ8,
    العقدة: غير_موقع
};

نوع عقدة_تصدير_ماتشو = {
    طرفية: منطقي,
    العنوان: غير_موقع,
    الحواف: متجه حافة_عقدة_تصدير_ماتشو
};

نوع مجموعة_أقسام_ماتشو_ربط = {
    الأقسام: متجه معرف_قسم_ربط,
    بداية_الملف: غير_موقع,
    نهاية_الملف: غير_موقع,
    بداية_الذاكرة: غير_موقع,
    نهاية_الذاكرة: غير_موقع
};

عرف انسخ_بايتات_ماتشو_ربط(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    ألحق_بايتات_ماتشو(&متغير الناتج, المصدر);
    أرجع الناتج;
}

عرف متجها_بايتات_ماتشو_ربط_متساويان(
    الأول: &متجه غ8,
    الثاني: &متجه غ8
): منطقي {
    لو ((الطول(*الأول) مثل غير_موقع) != (الطول(*الثاني) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الأول) مثل غير_موقع)) {
        لو ((*الأول)[فهرس_البايت] != (*الثاني)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف أس_محاذاة_ماتشو_من_قيمة(المحاذاة: غير_موقع): اختيار غير_موقع {
    لو (المحاذاة == 0) { أرجع اختيار.بعض(0); };
    دع القيمة: متغير غير_موقع = 1;
    دع الأس: متغير غير_موقع = 0;
    بينما (القيمة < المحاذاة && الأس < 31) {
        القيمة := القيمة * 2;
        الأس := الأس + 1;
    }
    لو (القيمة != المحاذاة) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الأس);
}

عرف قسم_ماتشو_صفري_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
        دع النوع: غير_موقع = الأعلام & 0xFF;
        أرجع النوع == 1 || النوع == 0xC || النوع == 0x12;
    }
    | _ -> { أرجع خطأ; };
}

عرف أعلام_قسم_ماتشو_تنفيذيا(القسم: &قسم_ربط): اختيار غير_موقع {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
        أرجع اختيار.بعض(الأعلام);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف قسم_ماتشو_في_مقطع_نص(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.شفرة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_للقراءة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_تعريفية -> { أرجع صواب; }
    | صنف_قسم_ربط.خاص_بالصيغة -> {
        طابق (*القسم).الاسم.اسم_الحاوية مع
        | اختيار.لا_شيء -> { أرجع صواب; }
        | اختيار.بعض(اسم_الحاوية) -> {
            دع اسم_النص: متجه غ8 = اسم_مقطع_نص_ماتشو();
            أرجع متجها_بايتات_ماتشو_ربط_متساويان(
                &اسم_الحاوية,
                &اسم_النص
            );
        };
    }
    | _ -> { أرجع خطأ; };
}

عرف قسم_ماتشو_في_مقطع_بيانات(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.بيانات_قابلة_للكتابة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_صفرية -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف قسم_ماتشو_في_مقطع_دوارف(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.تصحيح -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف اجمع_أقسام_ماتشو_الحية(
    السياق: &سياق_ربط,
    صنف_المجموعة: غير_موقع
): متجه معرف_قسم_ربط {
    دع الأقسام: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        لو ((*القسم).حي) {
            دع ينتمي: متغير منطقي = خطأ;
            لو (صنف_المجموعة == 0) {
                ينتمي := قسم_ماتشو_في_مقطع_نص(القسم);
            } وإلا لو (صنف_المجموعة == 1) {
                ينتمي := قسم_ماتشو_في_مقطع_بيانات(القسم);
            } وإلا {
                ينتمي := قسم_ماتشو_في_مقطع_دوارف(القسم);
            };
            لو (ينتمي) { ألحق(الأقسام, (*القسم).المعرف); };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع الأقسام;
}

عرف رشح_أقسام_بيانات_ماتشو(
    السياق: &سياق_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    نريد_أقساما_صفرية: منطقي
): متجه معرف_قسم_ربط {
    دع المرشحة: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_المعرف: متغير غير_موقع = 0;
    بينما (فهرس_المعرف < (الطول(*الأقسام) مثل غير_موقع)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        لو (قسم_ماتشو_صفري_تنفيذيا(القسم) == نريد_أقساما_صفرية) {
            ألحق(المرشحة, معرف_القسم);
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    أرجع المرشحة;
}

عرف ترتيب_اعتماد_إل_إل_في_إم_ماتشو(
    السياق: &سياق_ربط
): اختيار غير_موقع {
    دع اسم_اعتماد_إل_إل_في_إم: متغير متجه غ8 = [];
    دع وجد_الاعتماد: متغير منطقي = خطأ;
    دع فهرس_اعتماد_الخطة: متغير غير_موقع = 0;
    بينما (
        فهرس_اعتماد_الخطة
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع)
        && !وجد_الاعتماد
    ) {
        دع اعتماد_الخطة: &اعتماد_مكتبة_ديناميكية_ربط =
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_اعتماد_الخطة];
        طابق (*اعتماد_الخطة).الهوية مع
        | هوية_اعتماد_مكتبة_ديناميكية_ربط.إل_إل_في_إم -> {
            اسم_اعتماد_إل_إل_في_إم :=
                انسخ_بايتات_ماتشو_ربط(&(*اعتماد_الخطة).الاسم);
            وجد_الاعتماد := صواب;
        }
        | _ -> { };
        فهرس_اعتماد_الخطة := فهرس_اعتماد_الخطة + 1;
    }
    لو (!وجد_الاعتماد) {
        أرجع اختيار.لا_شيء();
    };

    دع الاعتمادات: متجه متجه غ8 = ابن_اعتمادات_ماتشو(السياق);
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل غير_موقع)) {
        لو (متجها_بايتات_ماتشو_ربط_متساويان(
            &الاعتمادات[فهرس_الاعتماد],
            &اسم_اعتماد_إل_إل_في_إم
        )) {
            أرجع اختيار.بعض(فهرس_الاعتماد + 1);
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ترتيب_مكتبة_رمز_ماتشو(
    السياق: &سياق_ربط,
    الرمز: &رمز_ربط
): غير_موقع {
    لو (اسم_رمز_إل_إل_في_إم_للربط(&(*الرمز).الاسم)) {
        طابق ترتيب_اعتماد_إل_إل_في_إم_ماتشو(السياق) مع
        | اختيار.بعض(الترتيب) -> { أرجع الترتيب; }
        | اختيار.لا_شيء -> { أرجع 1; };
    };
    أرجع 1;
}

عرف اجمع_رموز_ماتشو_الديناميكية(
    السياق: &سياق_ربط,
    يشمل_التعريفات: منطقي
): متجه رمز_ديناميكي_ماتشو_ربط {
    دع الرموز: متغير متجه رمز_ديناميكي_ماتشو_ربط = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        دع ديناميكي: متغير منطقي = خطأ;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { ديناميكي := صواب; }
        | حالة_رمز_ربط.ديناميكي(_) -> { ديناميكي := صواب; }
        | _ -> { };
        لو (ديناميكي) {
            دع المدخل: رمز_ديناميكي_ماتشو_ربط = {
                المعرف: (*الرمز).المعرف,
                الاسم: انسخ_بايتات_ماتشو_ربط(&(*الرمز).الاسم),
                ترتيب_المكتبة: ترتيب_مكتبة_رمز_ماتشو(السياق, الرمز),
                إزاحة_الاسم: 0,
                التعريف: اختيار.لا_شيء()
            };
            ألحق(الرموز, المدخل);
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    لو (يشمل_التعريفات) {
        فهرس_الرمز := 0;
        بينما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
            دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
            طابق (*الرمز).الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                دع المدخل: رمز_ديناميكي_ماتشو_ربط = {
                    المعرف: (*الرمز).المعرف,
                    الاسم: انسخ_بايتات_ماتشو_ربط(&(*الرمز).الاسم),
                    ترتيب_المكتبة: 0,
                    إزاحة_الاسم: 0,
                    التعريف: اختيار.بعض(التعريف)
                };
                ألحق(الرموز, المدخل);
            }
            | _ -> { };
            فهرس_الرمز := فهرس_الرمز + 1;
        }
    };
    أرجع الرموز;
}

عرف عدد_رموز_استيراد_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط
): غير_موقع {
    دع العدد: متغير غير_موقع = 0;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        طابق (*الرموز)[الفهرس].التعريف مع
        | اختيار.لا_شيء -> { العدد := العدد + 1; }
        | اختيار.بعض(_) -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ابحث_ترتيب_رمز_ديناميكي_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    المعرف: معرف_رمز_ربط
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        لو ((*الرموز)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_اعتماد_ماتشو_إن_لم_يوجد(
    الاعتمادات: &متغير متجه متجه غ8,
    الاسم: &متجه غ8
): فراغ {
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل غير_موقع)) {
        لو (متجها_بايتات_ماتشو_ربط_متساويان(
            &(*الاعتمادات)[فهرس_الاعتماد],
            الاسم
        )) {
            أرجع;
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    ألحق(*الاعتمادات, انسخ_بايتات_ماتشو_ربط(الاسم));
}

عرف ابن_اعتمادات_ماتشو(السياق: &سياق_ربط): متجه متجه غ8 {
    دع الاعتمادات: متغير متجه متجه غ8 = [];
    دع النظام: متجه غ8 = مسار_مكتبة_نظام_داروين_ماتشو();
    أضف_اعتماد_ماتشو_إن_لم_يوجد(&متغير الاعتمادات, &النظام);
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        دع الاسم: &متجه غ8 =
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].الاسم;
        أضف_اعتماد_ماتشو_إن_لم_يوجد(
            &متغير الاعتمادات,
            الاسم
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع الاعتمادات;
}

عرف أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
    المسارات: &متغير متجه متجه غ8,
    المسار: &متجه غ8
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المسارات) مثل غير_موقع)) {
        لو (متجها_بايتات_ماتشو_ربط_متساويان(
            &(*المسارات)[الفهرس],
            المسار
        )) {
            أرجع;
        };
        الفهرس := الفهرس + 1;
    }
    ألحق(*المسارات, انسخ_بايتات_ماتشو_ربط(المسار));
}

عرف ابن_مسارات_تشغيل_ماتشو(السياق: &سياق_ربط): متجه متجه غ8 {
    دع المسارات: متغير متجه متجه غ8 = [];
    دع فهرس_الصريح: متغير غير_موقع = 0;
    بينما (
        فهرس_الصريح < (الطول((*السياق).الخطة.مسارات_التشغيل) مثل غير_موقع)
    ) {
        أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
            &متغير المسارات,
            &(*السياق).الخطة.مسارات_التشغيل[فهرس_الصريح]
        );
        فهرس_الصريح := فهرس_الصريح + 1;
    }
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        طابق (*السياق).الخطة.المكتبات_الديناميكية[
            فهرس_الاعتماد
        ].دليل_البحث مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الدليل) -> {
            أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
                &متغير المسارات,
                &الدليل
            );
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع المسارات;
}

عرف ضع_مجموعة_أقسام_ماتشو(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    بداية_الملف: غير_موقع,
    بداية_الذاكرة: غير_موقع,
    صفري_فقط: منطقي
): مجموعة_أقسام_ماتشو_ربط {
    دع موضع_الملف: متغير غير_موقع = بداية_الملف;
    دع عنوان_الذاكرة: متغير غير_موقع = بداية_الذاكرة;
    دع فهرس_المعرف: متغير غير_موقع = 0;
    بينما (فهرس_المعرف < (الطول(*الأقسام) مثل غير_موقع)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        دع صفري: منطقي = قسم_ماتشو_صفري_تنفيذيا(القسم);
        لو (صفري == صفري_فقط) {
            دع المحاذاة: متغير غير_موقع = (*القسم).المحاذاة;
            لو (المحاذاة == 0) { المحاذاة := 1; };
            لو (!صفري) {
                موضع_الملف := حاذ_قيمة_ماتشو(موضع_الملف, المحاذاة);
                عنوان_الذاكرة := بداية_الذاكرة
                    + (موضع_الملف - بداية_الملف);
            } وإلا {
                عنوان_الذاكرة := حاذ_قيمة_ماتشو(
                    عنوان_الذاكرة,
                    المحاذاة
                );
            };
            دع حجم_ملف_القسم: متغير غير_موقع = (*القسم).الحجم;
            لو (صفري) { حجم_ملف_القسم := 0; };
            دع موضع: موضع_قسم_خرج_ربط = {
                القسم: معرف_القسم,
                إزاحة_الملف: موضع_الملف,
                العنوان_الافتراضي: اختيار.بعض(عنوان_الذاكرة),
                حجم_الملف: حجم_ملف_القسم,
                حجم_الذاكرة: (*القسم).الحجم
            };
            أضف_موضع_قسم_خرج_ربط(التخطيط, موضع);
            لو (!صفري) {
                موضع_الملف := موضع_الملف + (*القسم).الحجم;
                عنوان_الذاكرة := بداية_الذاكرة
                    + (موضع_الملف - بداية_الملف);
            } وإلا {
                عنوان_الذاكرة := عنوان_الذاكرة + (*القسم).الحجم;
            };
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    دع النتيجة: مجموعة_أقسام_ماتشو_ربط = {
        الأقسام: *الأقسام,
        بداية_الملف: بداية_الملف,
        نهاية_الملف: موضع_الملف,
        بداية_الذاكرة: بداية_الذاكرة,
        نهاية_الذاكرة: عنوان_الذاكرة
    };
    أرجع النتيجة;
}

عرف عنوان_مدخل_جوت_ماتشو(
    عنوان_جوت: غير_موقع,
    ترتيب_الرمز: غير_موقع
): غير_موقع {
    أرجع عنوان_جوت + ترتيب_الرمز * 8;
}

عرف حجم_ستب_ماتشو_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختيار.بعض(12); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(6);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف حجم_صفحة_ماتشو_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختيار.بعض(0x4000); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(0x1000);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نوع_معالج_ماتشو_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختيار.بعض(0x0100000C);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(0x01000007);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نوع_معالج_فرعي_ماتشو_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختيار.بعض(0); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(3);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف عنوان_ستب_ماتشو(
    عنوان_ستب: غير_موقع,
    ترتيب_الرمز: غير_موقع,
    حجم_الستب: غير_موقع
): غير_موقع {
    أرجع عنوان_ستب + ترتيب_الرمز * حجم_الستب;
}

عرف اجمع_إضافة_موقعة_ماتشو(
    الأساس: غير_موقع,
    الإضافة: عدد
): اختيار غير_موقع {
    لو (الإضافة >= 0) {
        دع المقدار: غير_موقع = الإضافة مثل غير_موقع;
        دع الناتج: غير_موقع = الأساس + المقدار;
        لو (الناتج < الأساس) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الناتج);
    };
    دع المقدار: غير_موقع = (-الإضافة) مثل غير_موقع;
    لو (المقدار > الأساس) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الأساس - المقدار);
}

عرف اقرأ_قيمة_ماتشو_بعرض(
    الصورة: &متجه غ8,
    الموضع: غير_موقع,
    العرض: غير_موقع
): اختيار غير_موقع {
    لو (العرض == 4) {
        لو (الموضع + 4 > (الطول(*الصورة) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(اقرأ_غ32_ماتشو_ربط(الصورة, الموضع));
    };
    لو (العرض == 8) {
        لو (الموضع + 8 > (الطول(*الصورة) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        أرجع اختيار.بعض(اقرأ_غ64_ماتشو_ربط(الصورة, الموضع));
    };
    أرجع اختيار.لا_شيء();
}

عرف اكتب_قيمة_ماتشو_بعرض(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    العرض: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (العرض == 4) {
        لو (القيمة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_ماتشو_ربط_في(الصورة, الموضع, القيمة);
    };
    لو (العرض == 8) {
        أرجع اكتب_غ64_ماتشو_ربط_في(الصورة, الموضع, القيمة);
    };
    أرجع خطأ;
}

عرف ابن_جدول_نصوص_ماتشو(
    الرموز: &متغير متجه رمز_ديناميكي_ماتشو_ربط
): متجه غ8 {
    دع الجدول: متغير متجه غ8 = [0];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول(*الرموز) مثل غير_موقع)) {
        (*الرموز)[فهرس_الرمز].إزاحة_الاسم := الطول(الجدول) مثل غير_موقع;
        ألحق_بايتات_ماتشو(
            &متغير الجدول,
            &(*الرموز)[فهرس_الرمز].الاسم
        );
        ألحق(الجدول, 0);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع الجدول;
}

عرف ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
    الأقسام: &متجه معرف_قسم_ربط,
    المعرف: معرف_قسم_ربط
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        لو ((*الأقسام)[الفهرس].القيمة == المعرف.القيمة) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ترتيب_قسم_ماتشو_في_الصورة(
    المعرف: معرف_قسم_ربط,
    أقسام_النص: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الملفوفة: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الصفرية: &متجه معرف_قسم_ربط,
    أقسام_دوارف: &متجه معرف_قسم_ربط,
    لديه_استيرادات: منطقي
): اختيار غير_موقع {
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(أقسام_النص, المعرف) مع
    | اختيار.بعض(الفهرس) -> { أرجع اختيار.بعض(الفهرس + 1); }
    | اختيار.لا_شيء -> { };
    دع الأساس_بعد_النص: متغير غير_موقع =
        الطول(*أقسام_النص) مثل غير_موقع;
    لو (لديه_استيرادات) {
        الأساس_بعد_النص := الأساس_بعد_النص + 1;
    };
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
        أقسام_البيانات_الملفوفة,
        المعرف
    ) مع
    | اختيار.بعض(الفهرس) -> {
        أرجع اختيار.بعض(الأساس_بعد_النص + الفهرس + 1);
    }
    | اختيار.لا_شيء -> { };
    دع الأساس_بعد_البيانات: متغير غير_موقع = الأساس_بعد_النص
        + (الطول(*أقسام_البيانات_الملفوفة) مثل غير_موقع);
    لو (لديه_استيرادات) {
        الأساس_بعد_البيانات := الأساس_بعد_البيانات + 1;
    };
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
        أقسام_البيانات_الصفرية,
        المعرف
    ) مع
    | اختيار.بعض(الفهرس) -> {
        أرجع اختيار.بعض(الأساس_بعد_البيانات + الفهرس + 1);
    }
    | اختيار.لا_شيء -> { };
    دع الأساس_بعد_الصفر: غير_موقع = الأساس_بعد_البيانات
        + (الطول(*أقسام_البيانات_الصفرية) مثل غير_موقع);
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(أقسام_دوارف, المعرف) مع
    | اختيار.بعض(الفهرس) -> {
        أرجع اختيار.بعض(الأساس_بعد_الصفر + الفهرس + 1);
    }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عرف ابن_جدول_رموز_ماتشو(
    السياق: &سياق_ربط,
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    أقسام_النص: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الملفوفة: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الصفرية: &متجه معرف_قسم_ربط,
    أقسام_دوارف: &متجه معرف_قسم_ربط,
    لديه_استيرادات: منطقي
): اختيار متجه غ8 {
    دع الجدول: متغير متجه غ8 = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[فهرس_الرمز];
        ألحق_غ32_ماتشو_ربط(&متغير الجدول, (*الرمز).إزاحة_الاسم);
        طابق (*الرمز).التعريف مع
        | اختيار.لا_شيء -> {
            ألحق_بايت_ماتشو(&متغير الجدول, 1);
            ألحق_بايت_ماتشو(&متغير الجدول, 0);
            ألحق_غ16_ماتشو_ربط(
                &متغير الجدول,
                ((*الرمز).ترتيب_المكتبة & 0xFF) << 8
            );
            ألحق_غ64_ماتشو_ربط(&متغير الجدول, 0);
        }
        | اختيار.بعض(التعريف) -> {
            دع نوع_الرمز: متغير غير_موقع = 3;
            دع ترتيب_القسم: متغير غير_موقع = 0;
            دع القيمة: متغير غير_موقع = 0;
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> { القيمة := العنوان; }
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, _) -> {
                نوع_الرمز := 0xF;
                طابق ترتيب_قسم_ماتشو_في_الصورة(
                    معرف_القسم,
                    أقسام_النص,
                    أقسام_البيانات_الملفوفة,
                    أقسام_البيانات_الصفرية,
                    أقسام_دوارف,
                    لديه_استيرادات
                ) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(الترتيب) -> { ترتيب_القسم := الترتيب; };
                طابق حل_عنوان_رمز_ربط(السياق, (*الرمز).المعرف) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> { القيمة := العنوان; }
                | _ -> { أرجع اختيار.لا_شيء(); };
            }
            | موضع_تعريف_رمز_ربط.غير_محدد -> {
                أرجع اختيار.لا_شيء();
            };
            دع الوصف: متغير غير_موقع = 0;
            طابق التعريف.القوة مع
            | قوة_تعريف_رمز_ربط.قوي -> { }
            | قوة_تعريف_رمز_ربط.ضعيف -> { الوصف := 0x80; };
            ألحق_بايت_ماتشو(&متغير الجدول, نوع_الرمز);
            ألحق_بايت_ماتشو(&متغير الجدول, ترتيب_القسم);
            ألحق_غ16_ماتشو_ربط(&متغير الجدول, الوصف);
            ألحق_غ64_ماتشو_ربط(&متغير الجدول, القيمة);
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختيار.بعض(الجدول);
}

عرف ابن_جدول_رموز_غير_مباشرة_ماتشو(
    عدد_الرموز: غير_موقع
): متجه غ8 {
    دع الجدول: متغير متجه غ8 = [];
    دع المرور: متغير غير_موقع = 0;
    بينما (المرور < 2) {
        دع فهرس_الرمز: متغير غير_موقع = 0;
        بينما (فهرس_الرمز < عدد_الرموز) {
            ألحق_غ32_ماتشو_ربط(&متغير الجدول, فهرس_الرمز);
            فهرس_الرمز := فهرس_الرمز + 1;
        }
        المرور := المرور + 1;
    }
    أرجع الجدول;
}

عرف حجم_يو_ليب_ماتشو(القيمة: غير_موقع): غير_موقع {
    دع الباقي: متغير غير_موقع = القيمة;
    دع الحجم: متغير غير_موقع = 1;
    بينما (الباقي >= 128) {
        الباقي := الباقي >> 7;
        الحجم := الحجم + 1;
    }
    أرجع الحجم;
}

عرف ابحث_حافة_تصدير_ماتشو(
    العقدة: &عقدة_تصدير_ماتشو,
    البايت: غ8
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*العقدة).الحواف) مثل غير_موقع)) {
        لو ((*العقدة).الحواف[الفهرس].البايت == البايت) {
            أرجع اختيار.بعض((*العقدة).الحواف[الفهرس].العقدة);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف أضف_رمز_إلى_شجرة_تصدير_ماتشو(
    العقد: &متغير متجه عقدة_تصدير_ماتشو,
    الاسم: &متجه غ8,
    العنوان: غير_موقع
): منطقي {
    دع ترتيب_العقدة: متغير غير_موقع = 0;
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الاسم) مثل غير_موقع)) {
        دع البايت: غ8 = (*الاسم)[فهرس_البايت];
        دع الترتيب_التالي: غير_موقع;
        طابق ابحث_حافة_تصدير_ماتشو(&(*العقد)[ترتيب_العقدة], البايت) مع
        | اختيار.بعض(القيمة) -> { الترتيب_التالي := القيمة; }
        | اختيار.لا_شيء -> {
            دع الحواف_الفارغة: متجه حافة_عقدة_تصدير_ماتشو = [];
            دع عقدة_جديدة: عقدة_تصدير_ماتشو = {
                طرفية: خطأ,
                العنوان: 0,
                الحواف: الحواف_الفارغة
            };
            الترتيب_التالي := الطول(*العقد) مثل غير_موقع;
            ألحق(*العقد, عقدة_جديدة);
            دع الحافة: حافة_عقدة_تصدير_ماتشو = {
                البايت: البايت,
                العقدة: الترتيب_التالي
            };
            ألحق((*العقد)[ترتيب_العقدة].الحواف, الحافة);
        };
        ترتيب_العقدة := الترتيب_التالي;
        فهرس_البايت := فهرس_البايت + 1;
    }
    (*العقد)[ترتيب_العقدة].طرفية := صواب;
    (*العقد)[ترتيب_العقدة].العنوان := العنوان;
    أرجع صواب;
}

عرف حجم_عقدة_تصدير_ماتشو(
    العقدة: &عقدة_تصدير_ماتشو,
    المواضع: &متجه غير_موقع
): اختيار غير_موقع {
    لو ((الطول((*العقدة).الحواف) مثل غير_موقع) > 255) {
        أرجع اختيار.لا_شيء();
    };
    دع حجم_الطرفية: متغير غير_موقع = 0;
    لو ((*العقدة).طرفية) {
        حجم_الطرفية := 1 + حجم_يو_ليب_ماتشو((*العقدة).العنوان);
    };
    دع الحجم: متغير غير_موقع = حجم_يو_ليب_ماتشو(حجم_الطرفية)
        + حجم_الطرفية + 1;
    دع فهرس_الحافة: متغير غير_موقع = 0;
    بينما (فهرس_الحافة < (الطول((*العقدة).الحواف) مثل غير_موقع)) {
        دع ترتيب_الطفل: غير_موقع = (*العقدة).الحواف[فهرس_الحافة].العقدة;
        لو (ترتيب_الطفل >= (الطول(*المواضع) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        الحجم := الحجم + 2 + حجم_يو_ليب_ماتشو((*المواضع)[ترتيب_الطفل]);
        فهرس_الحافة := فهرس_الحافة + 1;
    }
    أرجع اختيار.بعض(الحجم);
}

عرف ابن_مواضع_عقد_تصدير_ماتشو(
    العقد: &متجه عقدة_تصدير_ماتشو
): اختيار متجه غير_موقع {
    دع المواضع: متغير متجه غير_موقع = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*العقد) مثل غير_موقع)) {
        ألحق(المواضع, 0);
        الفهرس := الفهرس + 1;
    }
    دع المرور: متغير غير_موقع = 0;
    بينما (المرور < 16) {
        دع الموضع: متغير غير_موقع = 0;
        دع تغير: متغير منطقي = خطأ;
        الفهرس := 0;
        بينما (الفهرس < (الطول(*العقد) مثل غير_موقع)) {
            لو (المواضع[الفهرس] != الموضع) {
                المواضع[الفهرس] := الموضع;
                تغير := صواب;
            };
            دع الحجم: غير_موقع;
            طابق حجم_عقدة_تصدير_ماتشو(&(*العقد)[الفهرس], &المواضع) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { الحجم := القيمة; };
            الموضع := الموضع + الحجم;
            الفهرس := الفهرس + 1;
        }
        لو (!تغير) { أرجع اختيار.بعض(المواضع); };
        المرور := المرور + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابن_شجرة_تصدير_ماتشو(
    السياق: &سياق_ربط,
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار متجه غ8 {
    دع العقد: متغير متجه عقدة_تصدير_ماتشو = [];
    دع حواف_الجذر: متجه حافة_عقدة_تصدير_ماتشو = [];
    دع الجذر: عقدة_تصدير_ماتشو = {
        طرفية: خطأ,
        العنوان: 0,
        الحواف: حواف_الجذر
    };
    ألحق(العقد, الجذر);
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[فهرس_الرمز];
        طابق (*الرمز).التعريف مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(_) -> {
            دع العنوان: غير_موقع;
            طابق حل_عنوان_رمز_ربط(السياق, (*الرمز).المعرف) مع
            | نتيجة_حل_عنوان_ربط.نجح(القيمة) -> { العنوان := القيمة; }
            | _ -> { أرجع اختيار.لا_شيء(); };
            لو (العنوان < قاعدة_الصورة) { أرجع اختيار.لا_شيء(); };
            لو (!أضف_رمز_إلى_شجرة_تصدير_ماتشو(
                &متغير العقد,
                &(*الرمز).الاسم,
                العنوان - قاعدة_الصورة
            )) {
                أرجع اختيار.لا_شيء();
            };
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    لو ((الطول(العقد) مثل غير_موقع) == 1) {
        دع الشجرة_الفارغة: متجه غ8 = [];
        أرجع اختيار.بعض(الشجرة_الفارغة);
    };
    دع المواضع: متجه غير_موقع;
    طابق ابن_مواضع_عقد_تصدير_ماتشو(&العقد) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { المواضع := القيمة; };
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_العقدة: متغير غير_موقع = 0;
    بينما (فهرس_العقدة < (الطول(العقد) مثل غير_موقع)) {
        دع العقدة: &عقدة_تصدير_ماتشو = &العقد[فهرس_العقدة];
        دع حجم_الطرفية: متغير غير_موقع = 0;
        لو ((*العقدة).طرفية) {
            حجم_الطرفية := 1 + حجم_يو_ليب_ماتشو((*العقدة).العنوان);
        };
        ألحق_يو_ليب_ماتشو(&متغير الناتج, حجم_الطرفية);
        لو ((*العقدة).طرفية) {
            ألحق_يو_ليب_ماتشو(&متغير الناتج, 0);
            ألحق_يو_ليب_ماتشو(&متغير الناتج, (*العقدة).العنوان);
        };
        ألحق_بايت_ماتشو(
            &متغير الناتج,
            الطول((*العقدة).الحواف) مثل غير_موقع
        );
        دع فهرس_الحافة: متغير غير_موقع = 0;
        بينما (فهرس_الحافة < (الطول((*العقدة).الحواف) مثل غير_موقع)) {
            دع الحافة: &حافة_عقدة_تصدير_ماتشو =
                &(*العقدة).الحواف[فهرس_الحافة];
            ألحق_بايت_ماتشو(&متغير الناتج, (*الحافة).البايت);
            ألحق_بايت_ماتشو(&متغير الناتج, 0);
            دع فهرس_عقدة_الحافة: غير_موقع = (*الحافة).العقدة;
            ألحق_يو_ليب_ماتشو(
                &متغير الناتج,
                المواضع[فهرس_عقدة_الحافة]
            );
            فهرس_الحافة := فهرس_الحافة + 1;
        }
        فهرس_العقدة := فهرس_العقدة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف ألحق_ترتيب_مكتبة_ربط_ماتشو(
    الربط: &متغير متجه غ8,
    الترتيب: غير_موقع
): منطقي {
    لو (الترتيب == 0) { أرجع خطأ; };
    لو (الترتيب <= 15) {
        ألحق_بايت_ماتشو(الربط, 0x10 | الترتيب);
        أرجع صواب;
    };
    ألحق_بايت_ماتشو(الربط, 0x20);
    ألحق_يو_ليب_ماتشو(الربط, الترتيب);
    أرجع صواب;
}

عرف ابن_ربط_ديناميكي_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    السجلات: &متجه سجل_ربط_ديناميكي_ماتشو
): اختيار متجه غ8 {
    دع الربط: متغير متجه غ8 = [];
    دع فهرس_السجل: متغير غير_موقع = 0;
    بينما (فهرس_السجل < (الطول(*السجلات) مثل غير_موقع)) {
        دع السجل: &سجل_ربط_ديناميكي_ماتشو = &(*السجلات)[فهرس_السجل];
        دع ترتيب_الرمز: غير_موقع;
        طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
            الرموز,
            (*السجل).الرمز
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { ترتيب_الرمز := القيمة; };
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[ترتيب_الرمز];
        ألحق_بايت_ماتشو(&متغير الربط, 0x51);
        لو (!ألحق_ترتيب_مكتبة_ربط_ماتشو(
            &متغير الربط,
            (*الرمز).ترتيب_المكتبة
        )) {
            أرجع اختيار.لا_شيء();
        };
        ألحق_بايت_ماتشو(&متغير الربط, 0x40);
        ألحق_اسم_صفري_ماتشو(&متغير الربط, &(*الرمز).الاسم);
        لو ((*السجل).ترتيب_المقطع > 15) {
            أرجع اختيار.لا_شيء();
        };
        ألحق_بايت_ماتشو(
            &متغير الربط,
            0x70 | (*السجل).ترتيب_المقطع
        );
        ألحق_يو_ليب_ماتشو(
            &متغير الربط,
            (*السجل).الإزاحة_في_المقطع
        );
        لو ((*السجل).الإضافة != 0) {
            ألحق_بايت_ماتشو(&متغير الربط, 0x60);
            ألحق_سليب_ماتشو(&متغير الربط, (*السجل).الإضافة);
        };
        ألحق_بايت_ماتشو(&متغير الربط, 0x90);
        فهرس_السجل := فهرس_السجل + 1;
    }
    ألحق_بايت_ماتشو(&متغير الربط, 0);
    أرجع اختيار.بعض(الربط);
}

عرف ابن_ستبات_ماتشو_ذراع64(
    عدد_الرموز: غير_موقع,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): اختيار متجه غ8 {
    دع الستبات: متغير متجه غ8 = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_بداية_الستب: غير_موقع = الطول(الستبات) مثل غير_موقع;
        ألحق_غ32_ماتشو_ربط(&متغير الستبات, 0x90000010);
        ألحق_غ32_ماتشو_ربط(&متغير الستبات, 0xF9400210);
        ألحق_غ32_ماتشو_ربط(&متغير الستبات, 0xD61F0200);
        دع عنوان_الستب_الحالي: غير_موقع =
            عنوان_ستب_ماتشو(عنوان_الستب, فهرس_الرمز, 12);
        دع عنوان_جوت_الحالي: غير_موقع =
            عنوان_مدخل_جوت_ماتشو(عنوان_جوت, فهرس_الرمز);
        لو (!رقع_صفحة21_ماتشو(
            &متغير الستبات,
            موضع_بداية_الستب,
            عنوان_الستب_الحالي,
            عنوان_جوت_الحالي
        )) {
            أرجع اختيار.لا_شيء();
        };
        لو (!رقع_صفحة12_ماتشو(
            &متغير الستبات,
            موضع_بداية_الستب + 4,
            عنوان_جوت_الحالي
        )) {
            أرجع اختيار.لا_شيء();
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختيار.بعض(الستبات);
}

عرف ابن_ستبات_ماتشو_إكس64(
    عدد_الرموز: غير_موقع,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): اختيار متجه غ8 {
    دع الستبات: متغير متجه غ8 = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع عنوان_الستب_الحالي: غير_موقع =
            عنوان_ستب_ماتشو(عنوان_الستب, فهرس_الرمز, 6);
        دع عنوان_جوت_الحالي: غير_موقع =
            عنوان_مدخل_جوت_ماتشو(عنوان_جوت, فهرس_الرمز);
        دع الإزاحة: غير_موقع;
        طابق فرق_نسبي_ص32_ماتشو(
            عنوان_الستب_الحالي + 6,
            عنوان_جوت_الحالي
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
        ألحق(الستبات, 0xFF);
        ألحق(الستبات, 0x25);
        ألحق_غ32_ماتشو_ربط(&متغير الستبات, الإزاحة);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختيار.بعض(الستبات);
}

عرف ابن_ستبات_ماتشو(
    الهدف: &واصف_هدف,
    عدد_الرموز: غير_موقع,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): اختيار متجه غ8 {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع ابن_ستبات_ماتشو_ذراع64(
            عدد_الرموز,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع ابن_ستبات_ماتشو_إكس64(
            عدد_الرموز,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف أضف_سجلات_جوت_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    عدد_الرموز: غير_موقع,
    السجلات: &متغير متجه سجل_ربط_ديناميكي_ماتشو,
    ترتيب_مقطع_البيانات: غير_موقع,
    إزاحة_جوت_في_البيانات: غير_موقع
): فراغ {
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع السجل: سجل_ربط_ديناميكي_ماتشو = {
            الرمز: (*الرموز)[فهرس_الرمز].المعرف,
            ترتيب_المقطع: ترتيب_مقطع_البيانات,
            الإزاحة_في_المقطع: إزاحة_جوت_في_البيانات + فهرس_الرمز * 8,
            الإضافة: 0
        };
        ألحق(*السجلات, السجل);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
}

عرف أضف_موقعة_ماتشو(الأساس: عدد, الإضافة: عدد): اختيار عدد {
    لو (الإضافة > 0 && الأساس > 9223372036854775807 - الإضافة) {
        أرجع اختيار.لا_شيء();
    };
    لو (الإضافة < 0 && الأساس < -9223372036854775807 - 1 - الإضافة) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(الأساس + الإضافة);
}

عرف إضافة_مضمنة_ماتشو_من_قسم(
    القسم: &قسم_ربط,
    الإزاحة: غير_موقع,
    العرض: غير_موقع
): اختيار عدد {
    لو (العرض != 4 && العرض != 8) { أرجع اختيار.لا_شيء(); };
    طابق (*القسم).المحتوى مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(البايتات) -> {
        لو (الإزاحة + العرض > (الطول(البايتات) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        دع القيمة: متغير غير_موقع = 0;
        دع فهرس_البايت: متغير غير_موقع = 0;
        بينما (فهرس_البايت < العرض) {
            دع موضع_البايت: غير_موقع = الإزاحة + فهرس_البايت;
            القيمة := القيمة
                | ((البايتات[موضع_البايت] مثل غير_موقع)
                    << (فهرس_البايت * 8));
            فهرس_البايت := فهرس_البايت + 1;
        }
        لو (العرض == 4) {
            أرجع اختيار.بعض(ص32_من_غ32_ماتشو(القيمة));
        };
        دع الحد_الأعلى: غير_موقع = 9223372036854775807 مثل غير_موقع;
        لو (القيمة > الحد_الأعلى) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(القيمة مثل عدد);
    };
}

عرف أضف_سجلات_ربط_مباشرة_ماتشو(
    السياق: &سياق_ربط,
    السجلات: &متغير متجه سجل_ربط_ديناميكي_ماتشو,
    مكتبة_مشتركة: منطقي,
    قاعدة_الصورة: غير_موقع,
    بداية_مقطع_البيانات: غير_موقع
): منطقي {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };
    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع النوع: غير_موقع = (*الحافة).رمز_صيغة / 16;
        لو (النوع == 0) {
            طابق حل_عنوان_داخلي_ماتشو(
                السياق,
                &(*الحافة).المرجع,
                (*الحافة).إضافة
            ) مع
            | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                دع القسم: قسم_ربط;
                طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { القسم := القيمة; };
                دع الموضع: موضع_قسم_خرج_ربط;
                طابق ابحث_موضع_قسم_خرج_ربط(
                    &التخطيط,
                    (*الحافة).القسم
                ) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { الموضع := القيمة; };
                دع عنوان_الرقعة: غير_موقع;
                طابق الموضع.العنوان_الافتراضي مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> {
                    عنوان_الرقعة := القيمة + (*الحافة).الإزاحة;
                };
                دع ترتيب_المقطع: غير_موقع;
                دع قاعدة_المقطع: غير_موقع;
                لو (قسم_ماتشو_في_مقطع_نص(&القسم)) {
                    لو (مكتبة_مشتركة) { ترتيب_المقطع := 0; }
                    وإلا { ترتيب_المقطع := 1; };
                    قاعدة_المقطع := قاعدة_الصورة;
                } وإلا لو (قسم_ماتشو_في_مقطع_بيانات(&القسم)) {
                    لو (مكتبة_مشتركة) { ترتيب_المقطع := 1; }
                    وإلا { ترتيب_المقطع := 2; };
                    قاعدة_المقطع := قاعدة_الصورة + بداية_مقطع_البيانات;
                } وإلا {
                    أرجع خطأ;
                };
                لو (عنوان_الرقعة < قاعدة_المقطع) { أرجع خطأ; };
                دع رمز_الصيغة: غير_موقع = (*الحافة).رمز_صيغة;
                دع أس_العرض: غير_موقع = (رمز_الصيغة / 2) & 3;
                دع العرض: غير_موقع = 1 << أس_العرض;
                دع الإضافة_المضمنة: عدد;
                طابق إضافة_مضمنة_ماتشو_من_قسم(
                    &القسم,
                    (*الحافة).الإزاحة,
                    العرض
                ) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع الإضافة: عدد;
                طابق أضف_موقعة_ماتشو(
                    الإضافة_المضمنة,
                    (*الحافة).إضافة
                ) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { الإضافة := القيمة; };
                دع السجل: سجل_ربط_ديناميكي_ماتشو = {
                    الرمز: معرف_الرمز,
                    ترتيب_المقطع: ترتيب_المقطع,
                    الإزاحة_في_المقطع: عنوان_الرقعة - قاعدة_المقطع,
                    الإضافة: الإضافة
                };
                ألحق(*السجلات, السجل);
            }
            | _ -> { };
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }
    أرجع صواب;
}

نوع نتيجة_تطبيق_إزاحات_ماتشو =
    | نجح
    | خطأ بنوع خطأ_صورة_ماتشو_تنفيذية
;

عرف حل_عنوان_داخلي_ماتشو(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط,
    الإضافة: عدد
): نتيجة_حل_عنوان_ربط {
    طابق حل_عنوان_مرجع_إزاحة_ربط(السياق, المرجع) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
        طابق اجمع_إضافة_موقعة_ماتشو(العنوان, الإضافة) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_حل_عنوان_ربط.غير_محلول(); }
        | اختيار.بعض(القيمة) -> {
            أرجع نتيجة_حل_عنوان_ربط.نجح(القيمة);
        };
    }
    | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف) -> {
        أرجع نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف);
    }
    | نتيجة_حل_عنوان_ربط.غير_محلول -> {
        طابق *المرجع مع
        | مرجع_إزاحة_ربط.رمز(المعرف) -> {
            طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
            }
            | اختيار.بعض(الرمز) -> {
                طابق الرمز.الحالة مع
                | حالة_رمز_ربط.غير_معرف(_) -> {
                    أرجع نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف);
                }
                | _ -> {
                    أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
                };
            };
        }
        | _ -> { أرجع نتيجة_حل_عنوان_ربط.غير_محلول(); };
    };
}

عرف ص32_من_غ32_ماتشو(القيمة: غير_موقع): عدد {
    لو (القيمة <= 0x7FFFFFFF) { أرجع القيمة مثل عدد; };
    أرجع -((0x100000000 - القيمة) مثل عدد);
}

عرف رقع_نسبي_إكس64_ماتشو(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع,
    الإضافة: عدد,
    الزيادة: غير_موقع
): منطقي {
    دع الوجهة_المعدلة: غير_موقع;
    طابق اجمع_إضافة_موقعة_ماتشو(الوجهة, الإضافة + (الزيادة مثل عدد)) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الوجهة_المعدلة := القيمة; };
    دع الفرق: غير_موقع;
    طابق فرق_نسبي_ص32_ماتشو(المصدر, الوجهة_المعدلة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الفرق := القيمة; };
    أرجع اكتب_غ32_ماتشو_ربط_في(الصورة, الموضع, الفرق);
}

عرف طبق_إزاحات_ماتشو_ذراع64(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه غ8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): نتيجة_تطبيق_إزاحات_ماتشو {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };

    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
        | اختيار.لا_شيء -> {
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        | اختيار.بعض(الموضع) -> {
            لو ((*الحافة).الإزاحة >= الموضع.حجم_الذاكرة) {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                );
            };
            دع موضع_الرقعة: غير_موقع =
                الموضع.إزاحة_الملف + (*الحافة).الإزاحة;
            دع عنوان_مصدر_الرقعة: غير_موقع;
            طابق الموضع.العنوان_الافتراضي مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختيار.بعض(العنوان) -> {
                عنوان_مصدر_الرقعة := العنوان + (*الحافة).الإزاحة;
            };
            دع رمز_الصيغة: غير_موقع = (*الحافة).رمز_صيغة;
            دع أس_العرض: غير_موقع = (رمز_الصيغة / 2) & 3;
            دع العرض: غير_موقع = 1 << أس_العرض;
            دع نوع_الإزاحة: غير_موقع = رمز_الصيغة / 16;

            لو (نوع_الإزاحة == 1) {
                لو (فهرس_الإزاحة + 1
                    >= (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع فهرس_الحافة_الثانية: غير_موقع =
                    فهرس_الإزاحة + 1;
                دع الحافة_الثانية: &حافة_إزاحة_ربط =
                    &(*السياق).الإزاحات[فهرس_الحافة_الثانية];
                لو ((*الحافة_الثانية).القسم.القيمة
                        != (*الحافة).القسم.القيمة
                    || (*الحافة_الثانية).الإزاحة != (*الحافة).الإزاحة
                    || ((*الحافة_الثانية).رمز_صيغة / 16) != 0) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المطروح: غير_موقع;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المطروح := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المضاف: غير_موقع;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة_الثانية).المرجع,
                    (*الحافة_الثانية).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المضاف := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع الإضافة_المضمنة: غير_موقع;
                طابق اقرأ_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض
                ) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                }
                | اختيار.بعض(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع قناع_العرض: غير_موقع;
                لو (العرض == 4) {
                    قناع_العرض := 0xFFFFFFFF;
                } وإلا لو (العرض == 8) {
                    دع قناع_غ32: غير_موقع = 0xFFFFFFFF;
                    قناع_العرض := قناع_غ32
                        + قناع_غ32 * (قناع_غ32 + 1);
                } وإلا {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع الفرق: غير_موقع;
                لو (عنوان_المضاف >= عنوان_المطروح) {
                    الفرق := عنوان_المضاف - عنوان_المطروح;
                } وإلا {
                    دع المقدار: غير_موقع = عنوان_المطروح - عنوان_المضاف;
                    الفرق := (قناع_العرض - المقدار + 1) & قناع_العرض;
                };
                دع القيمة: غير_موقع =
                    (الفرق + الإضافة_المضمنة) & قناع_العرض;
                لو (!اكتب_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض,
                    القيمة
                )) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                فهرس_الإزاحة := فهرس_الإزاحة + 2;
            } وإلا {
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.غير_محلول -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                    );
                }
                | نتيجة_حل_عنوان_ربط.نجح(عنوان_الهدف) -> {
                    لو (نوع_الإزاحة == 0) {
                        دع الإضافة_المضمنة: غير_موقع;
                        طابق اقرأ_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض
                        ) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختيار.بعض(القيمة) -> {
                            الإضافة_المضمنة := القيمة;
                        };
                        لو (!اكتب_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض,
                            عنوان_الهدف + الإضافة_المضمنة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 2) {
                        لو (!رقع_فرع26_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 3) {
                        لو (!رقع_صفحة21_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 4) {
                        لو (!رقع_صفحة12_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                        );
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                }
                | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                    دع ترتيب_الرمز: غير_موقع;
                    طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
                        الرموز_الديناميكية,
                        معرف_الرمز
                    ) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                        );
                    }
                    | اختيار.بعض(القيمة) -> { ترتيب_الرمز := القيمة; };
                    دع عنوان_الوجهة: غير_موقع;
                    لو (نوع_الإزاحة == 0) {
                    } وإلا لو (نوع_الإزاحة == 2) {
                        عنوان_الوجهة := عنوان_ستب_ماتشو(
                            عنوان_الستب,
                            ترتيب_الرمز,
                            12
                        );
                        لو (!رقع_فرع26_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 5) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        لو (!رقع_صفحة21_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 6) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        لو (!رقع_صفحة12_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا لو (نوع_الإزاحة == 7) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        دع الفرق: غير_موقع;
                        طابق فرق_نسبي_ص32_ماتشو(
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        ) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختيار.بعض(القيمة) -> { الفرق := القيمة; };
                        لو (!اكتب_غ32_ماتشو_ربط_في(
                            الصورة,
                            موضع_الرقعة,
                            الفرق
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                        );
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                };
            };
        };
    }
    أرجع نتيجة_تطبيق_إزاحات_ماتشو.نجح();
}


عرف زيادة_إزاحة_إكس64_ماتشو(النوع: غير_موقع): اختيار غير_موقع {
    لو (النوع == 1 || النوع == 2) { أرجع اختيار.بعض(0); };
    لو (النوع == 6) { أرجع اختيار.بعض(1); };
    لو (النوع == 7) { أرجع اختيار.بعض(2); };
    لو (النوع == 8) { أرجع اختيار.بعض(4); };
    أرجع اختيار.لا_شيء();
}

عرف طبق_إزاحات_ماتشو_إكس64(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه غ8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): نتيجة_تطبيق_إزاحات_ماتشو {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { التخطيط := القيمة; };

    دع فهرس_الإزاحة: متغير غير_موقع = 0;
    بينما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع موضع_القسم: موضع_قسم_خرج_ربط;
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
        | اختيار.لا_شيء -> {
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        | اختيار.بعض(الموضع) -> {
            لو ((*الحافة).الإزاحة >= الموضع.حجم_الذاكرة) {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                );
            };
            دع موضع_الرقعة: غير_موقع =
                الموضع.إزاحة_الملف + (*الحافة).الإزاحة;
            دع عنوان_المصدر: غير_موقع;
            طابق الموضع.العنوان_الافتراضي مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختيار.بعض(العنوان) -> {
                عنوان_المصدر := العنوان + (*الحافة).الإزاحة;
            };
            دع رمز_الصيغة: غير_موقع = (*الحافة).رمز_صيغة;
            دع نوع_الإزاحة: غير_موقع = رمز_الصيغة / 16;
            دع أس_العرض: غير_موقع = (رمز_الصيغة / 2) & 3;
            دع العرض: غير_موقع = 1 << أس_العرض;

            لو (نوع_الإزاحة == 5) {
                لو (فهرس_الإزاحة + 1
                    >= (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع فهرس_الحافة_المضافة: غير_موقع = فهرس_الإزاحة + 1;
                دع الحافة_المضافة: &حافة_إزاحة_ربط =
                    &(*السياق).الإزاحات[فهرس_الحافة_المضافة];
                لو ((*الحافة_المضافة).القسم.القيمة
                        != (*الحافة).القسم.القيمة
                    || (*الحافة_المضافة).الإزاحة != (*الحافة).الإزاحة
                    || ((*الحافة_المضافة).رمز_صيغة / 16) != 0) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المطروح: غير_موقع;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المطروح := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المضاف: غير_موقع;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة_المضافة).المرجع,
                    (*الحافة_المضافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المضاف := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع الإضافة_المضمنة: غير_موقع;
                طابق اقرأ_قيمة_ماتشو_بعرض(الصورة, موضع_الرقعة, العرض) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                }
                | اختيار.بعض(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع القيمة: غير_موقع =
                    عنوان_المضاف - عنوان_المطروح + الإضافة_المضمنة;
                لو (!اكتب_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض,
                    القيمة
                )) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                فهرس_الإزاحة := فهرس_الإزاحة + 2;
            } وإلا {
                دع الإضافة_المضمنة: متغير غير_موقع = 0;
                لو (العرض == 4 || العرض == 8) {
                    طابق اقرأ_قيمة_ماتشو_بعرض(
                        الصورة,
                        موضع_الرقعة,
                        العرض
                    ) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    }
                    | اختيار.بعض(القيمة) -> { الإضافة_المضمنة := القيمة; };
                };
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.غير_محلول -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                    );
                }
                | نتيجة_حل_عنوان_ربط.نجح(عنوان_الهدف) -> {
                    لو (نوع_الإزاحة == 0) {
                        لو (!اكتب_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض,
                            عنوان_الهدف + الإضافة_المضمنة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        دع الزيادة: غير_موقع;
                        طابق زيادة_إزاحة_إكس64_ماتشو(نوع_الإزاحة) مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        }
                        | اختيار.بعض(القيمة) -> { الزيادة := القيمة; };
                        لو (العرض != 4) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        دع الإضافة: عدد = ص32_من_غ32_ماتشو(
                            الإضافة_المضمنة
                        );
                        لو (!رقع_نسبي_إكس64_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_المصدر,
                            عنوان_الهدف,
                            الإضافة,
                            الزيادة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                }
                | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                    دع ترتيب_الرمز: غير_موقع;
                    طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
                        الرموز_الديناميكية,
                        معرف_الرمز
                    ) مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                        );
                    }
                    | اختيار.بعض(القيمة) -> { ترتيب_الرمز := القيمة; };
                    لو (نوع_الإزاحة != 0) {
                        دع الوجهة: غير_موقع;
                        لو (نوع_الإزاحة == 2) {
                            الوجهة := عنوان_ستب_ماتشو(
                                عنوان_الستب,
                                ترتيب_الرمز,
                                6
                            );
                        } وإلا لو (
                            نوع_الإزاحة == 3 || نوع_الإزاحة == 4
                        ) {
                            الوجهة := عنوان_مدخل_جوت_ماتشو(
                                عنوان_جوت,
                                ترتيب_الرمز
                            );
                        } وإلا {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        لو (العرض != 4) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        دع الإضافة: عدد = ص32_من_غ32_ماتشو(
                            الإضافة_المضمنة
                        );
                        لو (!رقع_نسبي_إكس64_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_المصدر,
                            الوجهة,
                            الإضافة,
                            0
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                };
            };
        };
    }
    أرجع نتيجة_تطبيق_إزاحات_ماتشو.نجح();
}

عرف طبق_إزاحات_ماتشو(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه غ8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: غير_موقع,
    عنوان_جوت: غير_موقع
): نتيجة_تطبيق_إزاحات_ماتشو {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع طبق_إزاحات_ماتشو_ذراع64(
            السياق,
            الصورة,
            الرموز_الديناميكية,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع طبق_إزاحات_ماتشو_إكس64(
            السياق,
            الصورة,
            الرموز_الديناميكية,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | _ -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };
}


عرف ألحق_أوامر_أقسام_ماتشو_المدخلة(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    اسم_المقطع: &متجه غ8
): منطقي {
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول(*الأقسام) مثل غير_موقع)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_القسم];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        دع موضع_القسم: موضع_قسم_خرج_ربط;
        طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, معرف_القسم) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(الموضع) -> { موضع_القسم := الموضع; };
        دع عنوان_القسم: غير_موقع;
        طابق موضع_القسم.العنوان_الافتراضي مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(العنوان) -> { عنوان_القسم := العنوان; };
        دع أس_المحاذاة: غير_موقع;
        طابق أس_محاذاة_ماتشو_من_قيمة((*القسم).المحاذاة) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { أس_المحاذاة := القيمة; };
        دع الأعلام: غير_موقع;
        طابق أعلام_قسم_ماتشو_تنفيذيا(القسم) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { الأعلام := القيمة; };
        دع إزاحة_ملف_القسم: متغير غير_موقع = موضع_القسم.إزاحة_الملف;
        لو (قسم_ماتشو_صفري_تنفيذيا(القسم)) {
            إزاحة_ملف_القسم := 0;
        };
        لو (!ألحق_أمر_قسم_ماتشو(
            الصورة,
            &(*القسم).الاسم.اسم_القسم,
            اسم_المقطع,
            عنوان_القسم,
            (*القسم).الحجم,
            إزاحة_ملف_القسم,
            أس_المحاذاة,
            الأعلام,
            0,
            0
        )) {
            أرجع خطأ;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع صواب;
}

عرف انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط
): منطقي {
    دع فهرس_المعرف: متغير غير_موقع = 0;
    بينما (فهرس_المعرف < (الطول(*الأقسام) مثل غير_موقع)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        لو ((*القسم).حي && !قسم_ماتشو_صفري_تنفيذيا(القسم)) {
            دع موضع_القسم: موضع_قسم_خرج_ربط;
            طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, معرف_القسم) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(الموضع) -> { موضع_القسم := الموضع; };
            لو (!أكمل_ماتشو_إلى_موضع(
                الصورة,
                موضع_القسم.إزاحة_الملف
            )) {
                أرجع خطأ;
            };
            طابق (*القسم).المحتوى مع
            | اختيار.لا_شيء -> {
                لو ((*القسم).الحجم != 0) { أرجع خطأ; };
            }
            | اختيار.بعض(المحتوى) -> {
                لو ((الطول(المحتوى) مثل غير_موقع) != (*القسم).الحجم) {
                    أرجع خطأ;
                };
                ألحق_بايتات_ماتشو(الصورة, &المحتوى);
            };
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    أرجع صواب;
}

عرف حل_إزاحة_دخول_ماتشو(
    السياق: &سياق_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار غير_موقع {
    دع اسم_الدخول: متجه غ8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> { اسم_الدخول := الاسم; };
    دع الرمز: رمز_ربط;
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الرمز := القيمة; };
    طابق حل_عنوان_رمز_ربط(السياق, الرمز.المعرف) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
        لو (العنوان < قاعدة_الصورة) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(العنوان - قاعدة_الصورة);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف حجم_أوامر_تحميل_ماتشو_صورة(
    عدد_أقسام_النص: غير_موقع,
    عدد_أقسام_البيانات: غير_موقع,
    عدد_أقسام_دوارف: غير_موقع,
    لديه_استيرادات: منطقي,
    الاعتمادات: &متجه متجه غ8,
    مسارات_التشغيل: &متجه متجه غ8,
    مسار_المحمل: &متجه غ8,
    مكتبة_مشتركة: منطقي,
    اسم_المكتبة: &متجه غ8
): غير_موقع {
    دع الحجم: متغير غير_موقع = 0;
    لو (!مكتبة_مشتركة) { الحجم := الحجم + 72; };
    الحجم := الحجم + 72 + عدد_أقسام_النص * 80;
    الحجم := الحجم + 72 + عدد_أقسام_البيانات * 80;
    لو (عدد_أقسام_دوارف > 0) {
        الحجم := الحجم + 72 + عدد_أقسام_دوارف * 80;
    };
    الحجم := الحجم + 72;
    الحجم := الحجم + 48;
    الحجم := الحجم + 24;
    الحجم := الحجم + 80;
    لو (مكتبة_مشتركة) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(24, اسم_المكتبة);
    } وإلا {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(12, مسار_المحمل);
    };
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل غير_موقع)) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(
            24,
            &(*الاعتمادات)[فهرس_الاعتماد]
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع فهرس_المسار: متغير غير_موقع = 0;
    بينما (فهرس_المسار < (الطول(*مسارات_التشغيل) مثل غير_موقع)) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(
            12,
            &(*مسارات_التشغيل)[فهرس_المسار]
        );
        فهرس_المسار := فهرس_المسار + 1;
    }
    لو (!مكتبة_مشتركة) { الحجم := الحجم + 24; };
    // Every final Mach-O image carries one deterministic LC_UUID command.
    الحجم := الحجم + 24;
    الحجم := الحجم + 32;
    الحجم := الحجم + 16;
    لو (!لديه_استيرادات) {
        // The command set is intentionally stable without imports.
    };
    أرجع الحجم;
}

عرف عدد_أوامر_تحميل_ماتشو_صورة(
    عدد_أقسام_دوارف: غير_موقع,
    الاعتمادات: &متجه متجه غ8,
    مسارات_التشغيل: &متجه متجه غ8,
    مكتبة_مشتركة: منطقي
): غير_موقع {
    // The base command set includes LC_UUID for every final Mach-O image.
    دع العدد: متغير غير_موقع = 10;
    لو (!مكتبة_مشتركة) { العدد := العدد + 2; };
    لو (عدد_أقسام_دوارف > 0) { العدد := العدد + 1; };
    العدد := العدد + (الطول(*الاعتمادات) مثل غير_موقع);
    العدد := العدد + (الطول(*مسارات_التشغيل) مثل غير_موقع);
    أرجع العدد;
}

عرف ابن_صورة_ماتشو_داروين(
    السياق: &متغير سياق_ربط,
    مكتبة_مشتركة: منطقي
): نتيجة_صورة_ماتشو_تنفيذية {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };
    طابق (*السياق).الهدف.المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> { }
    | _ -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };

    دع اسم_المكتبة: متغير متجه غ8 = [];
    لو (مكتبة_مشتركة) {
        طابق (*السياق).الخطة.اسم_المخرج_الديناميكي مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(الاسم) -> { اسم_المكتبة := الاسم; };
    };

    دع أقسام_النص: متجه معرف_قسم_ربط = اجمع_أقسام_ماتشو_الحية(
        السياق,
        0
    );
    دع أقسام_البيانات: متجه معرف_قسم_ربط =
        اجمع_أقسام_ماتشو_الحية(السياق, 1);
    دع أقسام_البيانات_الملفوفة: متجه معرف_قسم_ربط =
        رشح_أقسام_بيانات_ماتشو(السياق, &أقسام_البيانات, خطأ);
    دع أقسام_البيانات_الصفرية: متجه معرف_قسم_ربط =
        رشح_أقسام_بيانات_ماتشو(السياق, &أقسام_البيانات, صواب);
    دع أقسام_دوارف: متجه معرف_قسم_ربط = اجمع_أقسام_ماتشو_الحية(
        السياق,
        2
    );
    دع الرموز_الديناميكية: متغير متجه رمز_ديناميكي_ماتشو_ربط =
        اجمع_رموز_ماتشو_الديناميكية(السياق, مكتبة_مشتركة);
    دع عدد_الرموز_الديناميكية: غير_موقع =
        الطول(الرموز_الديناميكية) مثل غير_موقع;
    دع عدد_رموز_الاستيراد: غير_موقع =
        عدد_رموز_استيراد_ماتشو(&الرموز_الديناميكية);
    دع لديه_رموز_ديناميكية: منطقي = عدد_رموز_الاستيراد > 0;
    دع الاعتمادات: متجه متجه غ8 = ابن_اعتمادات_ماتشو(السياق);
    دع مسارات_التشغيل: متجه متجه غ8 = ابن_مسارات_تشغيل_ماتشو(السياق);
    دع مسار_المحمل: متجه غ8 = مسار_محمل_داروين_ماتشو();

    دع عدد_أقسام_النص: متغير غير_موقع = الطول(أقسام_النص) مثل غير_موقع;
    دع عدد_أقسام_البيانات: متغير غير_موقع =
        الطول(أقسام_البيانات) مثل غير_موقع;
    لو (لديه_رموز_ديناميكية) {
        عدد_أقسام_النص := عدد_أقسام_النص + 1;
        عدد_أقسام_البيانات := عدد_أقسام_البيانات + 1;
    };
    دع عدد_أقسام_دوارف: غير_موقع = الطول(أقسام_دوارف) مثل غير_موقع;
    دع حجم_أوامر_التحميل: غير_موقع = حجم_أوامر_تحميل_ماتشو_صورة(
        عدد_أقسام_النص,
        عدد_أقسام_البيانات,
        عدد_أقسام_دوارف,
        لديه_رموز_ديناميكية,
        &الاعتمادات,
        &مسارات_التشغيل,
        &مسار_المحمل,
        مكتبة_مشتركة,
        &اسم_المكتبة
    );
    دع عدد_أوامر_التحميل: غير_موقع = عدد_أوامر_تحميل_ماتشو_صورة(
        عدد_أقسام_دوارف,
        &الاعتمادات,
        &مسارات_التشغيل,
        مكتبة_مشتركة
    );

    دع قاعدة_الصورة: متغير غير_موقع = 0x100000000;
    لو (مكتبة_مشتركة) { قاعدة_الصورة := 0; };
    دع حجم_صفحة_ماتشو: غير_موقع;
    طابق حجم_صفحة_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { حجم_صفحة_ماتشو := القيمة; };
    دع حجم_الستب_ماتشو: غير_موقع;
    طابق حجم_ستب_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { حجم_الستب_ماتشو := القيمة; };
    دع بداية_محتوى_النص: غير_موقع = حاذ_قيمة_ماتشو(
        32 + حجم_أوامر_التحميل,
        16
    );
    دع التخطيط: متغير تخطيط_خرج_ربط = أنشئ_تخطيط_خرج_ربط();
    دع مجموعة_النص: مجموعة_أقسام_ماتشو_ربط = ضع_مجموعة_أقسام_ماتشو(
        السياق,
        &متغير التخطيط,
        &أقسام_النص,
        بداية_محتوى_النص,
        قاعدة_الصورة + بداية_محتوى_النص,
        خطأ
    );
    دع بداية_الستبات: غير_موقع = حاذ_قيمة_ماتشو(
        مجموعة_النص.نهاية_الملف,
        4
    );
    دع حجم_الستبات: غير_موقع = عدد_رموز_الاستيراد * حجم_الستب_ماتشو;
    دع نهاية_بايتات_النص: غير_موقع = بداية_الستبات + حجم_الستبات;
    دع نهاية_مقطع_النص: غير_موقع = حاذ_قيمة_ماتشو(
        نهاية_بايتات_النص,
        حجم_صفحة_ماتشو
    );

    دع بداية_مقطع_البيانات: غير_موقع = نهاية_مقطع_النص;
    دع مجموعة_البيانات_الملفوفة: مجموعة_أقسام_ماتشو_ربط =
        ضع_مجموعة_أقسام_ماتشو(
            السياق,
            &متغير التخطيط,
            &أقسام_البيانات_الملفوفة,
            بداية_مقطع_البيانات,
            قاعدة_الصورة + بداية_مقطع_البيانات,
            خطأ
        );
    دع بداية_جوت: غير_موقع = حاذ_قيمة_ماتشو(
        مجموعة_البيانات_الملفوفة.نهاية_الملف,
        8
    );
    دع حجم_جوت: غير_موقع = عدد_رموز_الاستيراد * 8;
    دع نهاية_جوت: غير_موقع = بداية_جوت + حجم_جوت;
    دع مجموعة_البيانات_الصفرية: مجموعة_أقسام_ماتشو_ربط =
        ضع_مجموعة_أقسام_ماتشو(
            السياق,
            &متغير التخطيط,
            &أقسام_البيانات_الصفرية,
            نهاية_جوت,
            قاعدة_الصورة + نهاية_جوت,
            صواب
        );
    دع نهاية_ذاكرة_البيانات: غير_موقع =
        مجموعة_البيانات_الصفرية.نهاية_الذاكرة;
    دع نهاية_ملف_البيانات: غير_موقع = نهاية_جوت;

    دع بداية_ملف_دوارف: غير_موقع = حاذ_قيمة_ماتشو(
        نهاية_ملف_البيانات,
        حجم_صفحة_ماتشو
    );
    دع بداية_ذاكرة_دوارف: غير_موقع = حاذ_قيمة_ماتشو(
        نهاية_ذاكرة_البيانات,
        حجم_صفحة_ماتشو
    );
    دع مجموعة_دوارف: مجموعة_أقسام_ماتشو_ربط = ضع_مجموعة_أقسام_ماتشو(
        السياق,
        &متغير التخطيط,
        &أقسام_دوارف,
        بداية_ملف_دوارف,
        بداية_ذاكرة_دوارف,
        خطأ
    );
    دع نهاية_ملف_دوارف: غير_موقع = مجموعة_دوارف.نهاية_الملف;
    دع نهاية_ذاكرة_دوارف: غير_موقع = مجموعة_دوارف.نهاية_الذاكرة;
    دع بداية_ملف_لينك: غير_موقع = حاذ_قيمة_ماتشو(
        نهاية_ملف_دوارف,
        حجم_صفحة_ماتشو
    );
    دع بداية_ذاكرة_لينك: غير_موقع = حاذ_قيمة_ماتشو(
        نهاية_ذاكرة_دوارف,
        حجم_صفحة_ماتشو
    );

    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
    دع إزاحة_الدخول: متغير غير_موقع = 0;
    لو (!مكتبة_مشتركة) {
        طابق حل_إزاحة_دخول_ماتشو(السياق, قاعدة_الصورة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.رمز_دخول_مفقود()
            );
        }
        | اختيار.بعض(القيمة) -> { إزاحة_الدخول := القيمة; };
    };

    دع عنوان_الستبات: غير_موقع = قاعدة_الصورة + بداية_الستبات;
    دع عنوان_جوت: غير_موقع = قاعدة_الصورة + بداية_جوت;
    دع الستبات: متجه غ8;
    طابق ابن_ستبات_ماتشو(
        &(*السياق).الهدف,
        عدد_رموز_الاستيراد,
        عنوان_الستبات,
        عنوان_جوت
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
        );
    }
    | اختيار.بعض(القيمة) -> { الستبات := القيمة; };

    دع سجلات_الربط: متغير متجه سجل_ربط_ديناميكي_ماتشو = [];
    دع ترتيب_مقطع_البيانات: متغير غير_موقع = 2;
    لو (مكتبة_مشتركة) { ترتيب_مقطع_البيانات := 1; };
    أضف_سجلات_جوت_ماتشو(
        &الرموز_الديناميكية,
        عدد_رموز_الاستيراد,
        &متغير سجلات_الربط,
        ترتيب_مقطع_البيانات,
        بداية_جوت - بداية_مقطع_البيانات
    );
    لو (!أضف_سجلات_ربط_مباشرة_ماتشو(
        السياق,
        &متغير سجلات_الربط,
        مكتبة_مشتركة,
        قاعدة_الصورة,
        بداية_مقطع_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
        );
    };
    دع ربط_ديناميكي: متجه غ8;
    طابق ابن_ربط_ديناميكي_ماتشو(
        &الرموز_الديناميكية,
        &سجلات_الربط
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
        );
    }
    | اختيار.بعض(القيمة) -> { ربط_ديناميكي := القيمة; };
    دع شجرة_التصدير: متغير متجه غ8 = [];
    لو (مكتبة_مشتركة) {
        طابق ابن_شجرة_تصدير_ماتشو(
            السياق,
            &الرموز_الديناميكية,
            قاعدة_الصورة
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(القيمة) -> { شجرة_التصدير := القيمة; };
    };
    دع جدول_النصوص: متجه غ8 = ابن_جدول_نصوص_ماتشو(
        &متغير الرموز_الديناميكية
    );
    دع جدول_الرموز: متجه غ8;
    طابق ابن_جدول_رموز_ماتشو(
        السياق,
        &الرموز_الديناميكية,
        &أقسام_النص,
        &أقسام_البيانات_الملفوفة,
        &أقسام_البيانات_الصفرية,
        &أقسام_دوارف,
        لديه_رموز_ديناميكية
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { جدول_الرموز := القيمة; };
    دع جدول_غير_مباشر: متجه غ8 = ابن_جدول_رموز_غير_مباشرة_ماتشو(
        عدد_رموز_الاستيراد
    );

    دع موضع_الربط: غير_موقع = بداية_ملف_لينك;
    دع موضع_التصدير: غير_موقع =
        موضع_الربط + (الطول(ربط_ديناميكي) مثل غير_موقع);
    دع موضع_التصدير_في_الأمر: متغير غير_موقع = 0;
    لو ((الطول(شجرة_التصدير) مثل غير_موقع) > 0) {
        موضع_التصدير_في_الأمر := موضع_التصدير;
    };
    دع موضع_الرموز: غير_موقع = حاذ_قيمة_ماتشو(
        موضع_التصدير + (الطول(شجرة_التصدير) مثل غير_موقع),
        8
    );
    دع موضع_الرموز_غير_المباشرة: غير_موقع = حاذ_قيمة_ماتشو(
        موضع_الرموز + (الطول(جدول_الرموز) مثل غير_موقع),
        4
    );
    دع موضع_النصوص: غير_موقع = موضع_الرموز_غير_المباشرة
        + (الطول(جدول_غير_مباشر) مثل غير_موقع);
    دع موضع_التوقيع: غير_موقع = حاذ_قيمة_ماتشو(
        موضع_النصوص + (الطول(جدول_النصوص) مثل غير_موقع),
        16
    );

    دع الصورة: متغير متجه غ8 = [];
    دع أعلام_الرأس: متغير غير_موقع = 0x200004;
    لو (مكتبة_مشتركة) { أعلام_الرأس := 0x84; };
    لو (!لديه_رموز_ديناميكية) {
        أعلام_الرأس := أعلام_الرأس | 1;
    };
    دع نوع_المعالج: غير_موقع;
    طابق نوع_معالج_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { نوع_المعالج := القيمة; };
    دع نوع_المعالج_الفرعي: غير_موقع;
    طابق نوع_معالج_فرعي_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { نوع_المعالج_الفرعي := القيمة; };
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0xFEEDFACF);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, نوع_المعالج);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, نوع_المعالج_الفرعي);
    لو (مكتبة_مشتركة) {
        ألحق_غ32_ماتشو_ربط(&متغير الصورة, 6);
    } وإلا {
        ألحق_غ32_ماتشو_ربط(&متغير الصورة, 2);
    };
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, عدد_أوامر_التحميل);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, حجم_أوامر_التحميل);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, أعلام_الرأس);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);

    دع اسم_صفحة_صفر: متجه غ8 = اسم_مقطع_صفحة_صفر_ماتشو();
    دع اسم_مقطع_النص: متجه غ8 = اسم_مقطع_نص_ماتشو();
    دع اسم_مقطع_البيانات: متجه غ8 = اسم_مقطع_بيانات_ماتشو();
    دع اسم_مقطع_دوارف: متجه غ8 = اسم_حاوية_دوارف_ماتشو();
    دع اسم_مقطع_لينك: متجه غ8 = اسم_مقطع_لينك_ماتشو();
    لو (!مكتبة_مشتركة) {
            لو (!ألحق_أمر_مقطع_ماتشو(
                &متغير الصورة,
                &اسم_صفحة_صفر,
                0,
                قاعدة_الصورة,
                0,
                0,
                0,
                0,
                0
            )) {
                أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
            };
    };
    لو (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_النص,
        قاعدة_الصورة,
        نهاية_مقطع_النص,
        0,
        نهاية_مقطع_النص,
        5,
        5,
        عدد_أقسام_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_النص,
        &اسم_مقطع_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (لديه_رموز_ديناميكية) {
        دع اسم_الستبات: متجه غ8 = اسم_قسم_ستب_ماتشو();
        لو (!ألحق_أمر_قسم_ماتشو(
            &متغير الصورة,
            &اسم_الستبات,
            &اسم_مقطع_النص,
            عنوان_الستبات,
            حجم_الستبات,
            بداية_الستبات,
            2,
            0x80000408,
            0,
            حجم_الستب_ماتشو
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    دع حجم_ملف_مقطع_البيانات: غير_موقع =
        نهاية_ملف_البيانات - بداية_مقطع_البيانات;
    دع حجم_ذاكرة_مقطع_البيانات: غير_موقع =
        نهاية_ذاكرة_البيانات - (قاعدة_الصورة + بداية_مقطع_البيانات);
    لو (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_البيانات,
        قاعدة_الصورة + بداية_مقطع_البيانات,
        حجم_ذاكرة_مقطع_البيانات,
        بداية_مقطع_البيانات,
        حجم_ملف_مقطع_البيانات,
        3,
        3,
        عدد_أقسام_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_البيانات_الملفوفة,
        &اسم_مقطع_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (لديه_رموز_ديناميكية) {
        دع اسم_جوت: متجه غ8 = اسم_قسم_جوت_ماتشو();
        لو (!ألحق_أمر_قسم_ماتشو(
            &متغير الصورة,
            &اسم_جوت,
            &اسم_مقطع_البيانات,
            عنوان_جوت,
            حجم_جوت,
            بداية_جوت,
            3,
            6,
            عدد_رموز_الاستيراد,
            0
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };
    لو (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_البيانات_الصفرية,
        &اسم_مقطع_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    لو (عدد_أقسام_دوارف > 0) {
        لو (!ألحق_أمر_مقطع_ماتشو(
            &متغير الصورة,
            &اسم_مقطع_دوارف,
            بداية_ذاكرة_دوارف,
            نهاية_ذاكرة_دوارف - بداية_ذاكرة_دوارف,
            بداية_ملف_دوارف,
            نهاية_ملف_دوارف - بداية_ملف_دوارف,
            0,
            0,
            عدد_أقسام_دوارف
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        لو (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
            &متغير الصورة,
            السياق,
            &التخطيط,
            &أقسام_دوارف,
            &اسم_مقطع_دوارف
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    دع موضع_أمر_لينك: غير_موقع = الطول(الصورة) مثل غير_موقع;
    لو (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_لينك,
        بداية_ذاكرة_لينك,
        0,
        بداية_ملف_لينك,
        0,
        1,
        1,
        0
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x80000022);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 48);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, موضع_الربط);
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        الطول(ربط_ديناميكي) مثل غير_موقع
    );
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, موضع_التصدير_في_الأمر);
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        الطول(شجرة_التصدير) مثل غير_موقع
    );

    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 2);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 24);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, موضع_الرموز);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, عدد_الرموز_الديناميكية);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, موضع_النصوص);
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        الطول(جدول_النصوص) مثل غير_موقع
    );

    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0xB);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 80);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, عدد_رموز_الاستيراد);
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        عدد_الرموز_الديناميكية - عدد_رموز_الاستيراد
    );
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, عدد_رموز_الاستيراد);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        موضع_الرموز_غير_المباشرة
    );
    ألحق_غ32_ماتشو_ربط(
        &متغير الصورة,
        عدد_رموز_الاستيراد * 2
    );
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);

    لو (مكتبة_مشتركة) {
        لو (!ألحق_أمر_هوية_مكتبة_ماتشو(
            &متغير الصورة,
            &اسم_المكتبة
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    } وإلا {
        لو (!ألحق_أمر_محمل_ديناميكي_ماتشو(
            &متغير الصورة,
            &مسار_المحمل
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل غير_موقع)) {
        لو (!ألحق_أمر_مكتبة_ماتشو(
            &متغير الصورة,
            &الاعتمادات[فهرس_الاعتماد]
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع فهرس_المسار: متغير غير_موقع = 0;
    بينما (فهرس_المسار < (الطول(مسارات_التشغيل) مثل غير_موقع)) {
        لو (!ألحق_أمر_مسار_تشغيل_ماتشو(
            &متغير الصورة,
            &مسارات_التشغيل[فهرس_المسار]
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        فهرس_المسار := فهرس_المسار + 1;
    }

    لو (!مكتبة_مشتركة) {
        ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x80000028);
        ألحق_غ32_ماتشو_ربط(&متغير الصورة, 24);
        ألحق_غ64_ماتشو_ربط(&متغير الصورة, إزاحة_الدخول);
        ألحق_غ64_ماتشو_ربط(&متغير الصورة, 0);
    };

    // Reserve LC_UUID with a zero identifier first. The identifier is derived
    // from the completed pre-signature image later, matching mature linker
    // practice while keeping repeated self-host links deterministic.
    دع موضع_أمر_المعرف_الفريد: غير_موقع =
        الطول(الصورة) مثل غير_موقع;
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x1B);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 24);
    ألحق_أصفارا_ماتشو(&متغير الصورة, 16);

    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x32);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 32);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 1);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x000D0000);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 1);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 3);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);

    دع موضع_أمر_التوقيع: غير_موقع = الطول(الصورة) مثل غير_موقع;
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0x1D);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 16);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, موضع_التوقيع);
    ألحق_غ32_ماتشو_ربط(&متغير الصورة, 0);

    لو ((الطول(الصورة) مثل غير_موقع) != 32 + حجم_أوامر_التحميل) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_محتوى_النص)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (لديه_رموز_ديناميكية) {
        لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_الستبات)) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_ماتشو(&متغير الصورة, &الستبات);
    };
    لو (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_البيانات_الملفوفة
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (لديه_رموز_ديناميكية) {
        لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_جوت)) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_أصفارا_ماتشو(&متغير الصورة, حجم_جوت);
    };
    لو (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_دوارف
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_الربط)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &ربط_ديناميكي);
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_التصدير)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &شجرة_التصدير);
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_الرموز)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_الرموز);
    لو (!أكمل_ماتشو_إلى_موضع(
        &متغير الصورة,
        موضع_الرموز_غير_المباشرة
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_غير_مباشر);
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_النصوص)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_النصوص);
    لو (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_التوقيع)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    طابق طبق_إزاحات_ماتشو(
        السياق,
        &متغير الصورة,
        &الرموز_الديناميكية,
        عنوان_الستبات,
        عنوان_جوت
    ) مع
    | نتيجة_تطبيق_إزاحات_ماتشو.نجح -> { }
    | نتيجة_تطبيق_إزاحات_ماتشو.خطأ(الخطأ) -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(الخطأ);
    };

    دع توقيع_تمهيدي: متجه غ8;
    طابق ابن_توقيع_أدهوك_ماتشو(
        &الصورة,
        0,
        نهاية_مقطع_النص
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    }
    | اختيار.بعض(القيمة) -> { توقيع_تمهيدي := القيمة; };
    دع حجم_التوقيع: غير_موقع = الطول(توقيع_تمهيدي) مثل غير_موقع;
    لو (!اكتب_غ32_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_التوقيع + 12,
        حجم_التوقيع
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    };
    دع نهاية_ملف_لينك: غير_موقع = موضع_التوقيع + حجم_التوقيع;
    دع حجم_ملف_لينك: غير_موقع = نهاية_ملف_لينك - بداية_ملف_لينك;
    دع حجم_ذاكرة_لينك: غير_موقع = حاذ_قيمة_ماتشو(
        حجم_ملف_لينك,
        حجم_صفحة_ماتشو
    );
    لو (!اكتب_غ64_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_لينك + 32,
        حجم_ذاكرة_لينك
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    لو (!اكتب_غ64_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_لينك + 48,
        حجم_ملف_لينك
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    // Derive the Mach-O UUID from the final pre-signature bytes while the UUID
    // payload is still zero. The code signature must be generated afterwards
    // because it covers the header containing this identifier.
    دع هاش_المعرف_الفريد: متجه غ8;
    طابق هاش_شا256_ماتشو(
        &الصورة,
        0,
        الطول(الصورة) مثل غير_موقع
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { هاش_المعرف_الفريد := القيمة; };
    دع فهرس_المعرف_الفريد: متغير غير_موقع = 0;
    بينما (فهرس_المعرف_الفريد < 16) {
        دع بايت_المعرف: متغير غ8 =
            هاش_المعرف_الفريد[فهرس_المعرف_الفريد];
        لو (فهرس_المعرف_الفريد == 6) {
            دع قيمة_بايت_الإصدار: غير_موقع =
                (بايت_المعرف مثل غير_موقع) & 0x0F;
            بايت_المعرف := (قيمة_بايت_الإصدار | 0x40) مثل غ8;
        };
        لو (فهرس_المعرف_الفريد == 8) {
            دع قيمة_بايت_النسق: غير_موقع =
                (بايت_المعرف مثل غير_موقع) & 0x3F;
            بايت_المعرف := (قيمة_بايت_النسق | 0x80) مثل غ8;
        };
        دع موضع_بايت_المعرف: غير_موقع =
            موضع_أمر_المعرف_الفريد + 8 + فهرس_المعرف_الفريد;
        الصورة[موضع_بايت_المعرف] := بايت_المعرف;
        فهرس_المعرف_الفريد := فهرس_المعرف_الفريد + 1;
    }

    دع التوقيع: متجه غ8;
    طابق ابن_توقيع_أدهوك_ماتشو(
        &الصورة,
        0,
        نهاية_مقطع_النص
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    }
    | اختيار.بعض(القيمة) -> { التوقيع := القيمة; };
    لو ((الطول(التوقيع) مثل غير_موقع) != حجم_التوقيع) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &التوقيع);
    لو ((الطول(الصورة) مثل غير_موقع) != نهاية_ملف_لينك) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    أرجع نتيجة_صورة_ماتشو_تنفيذية.نجح(الصورة);
}


عام عرف ابن_صورة_ماتشو_داروين_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_ماتشو_تنفيذية {
    أرجع ابن_صورة_ماتشو_داروين(السياق, خطأ);
}

عام عرف ابن_صورة_ماتشو_داروين_مشتركة(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_ماتشو_تنفيذية {
    أرجع ابن_صورة_ماتشو_داروين(السياق, صواب);
}
