        // gives. macOS sizes the main stack at exec time (0 means the 8 MiB
        // default) and raising RLIMIT_STACK afterwards has no effect there,
        // unlike Linux, where the compiler raises its soft limit to 64 MiB at
        // startup (std.os.stack_limit). Deeply nested sources recurse through
        // every compiler phase. The reserve is address space only.
        ألحق_ط64_ماتشو_ربط(&متغير الصورة, 67108864);
    };

    // Reserve LC_UUID with a zero identifier first. The identifier is derived
    // from the completed pre-signature image later, matching mature linker
    // practice while keeping repeated self-host links deterministic.
    دع موضع_أمر_المعرف_الفريد: طبيعي =
