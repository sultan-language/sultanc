    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x80000022);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 48);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_إعادة_الأساس);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, حجم_إعادة_الأساس);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_الربط);
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        الطول(ربط_ديناميكي) مثل طبيعي
    );
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_التصدير_في_الأمر);
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        الطول(شجرة_التصدير) مثل طبيعي
    );

    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 2);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 24);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_الرموز);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, عدد_الرموز_الديناميكية);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_النصوص);
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        الطول(جدول_النصوص) مثل طبيعي
    );

    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0xB);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 80);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, عدد_رموز_الاستيراد);
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        عدد_الرموز_الديناميكية - عدد_رموز_الاستيراد
    );
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, عدد_رموز_الاستيراد);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        موضع_الرموز_غير_المباشرة
    );
    ألحق_ط32_ماتشو_ربط(
        &متغير الصورة,
        عدد_رموز_الاستيراد * 2
    );
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);

    إذا (مكتبة_مشتركة) {
        إذا (!ألحق_أمر_هوية_مكتبة_ماتشو(
            &متغير الصورة,
            &اسم_المكتبة
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    } وإلا {
        إذا (!ألحق_أمر_محمل_ديناميكي_ماتشو(
            &متغير الصورة,
            &مسار_المحمل
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل طبيعي)) {
        إذا (!ألحق_أمر_مكتبة_ماتشو(
            &متغير الصورة,
            &الاعتمادات[فهرس_الاعتماد]
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع فهرس_المسار: متغير طبيعي = 0;
    طالما (فهرس_المسار < (الطول(مسارات_التشغيل) مثل طبيعي)) {
        إذا (!ألحق_أمر_مسار_تشغيل_ماتشو(
