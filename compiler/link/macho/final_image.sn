    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x1B);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 24);
    ألحق_أصفارا_ماتشو(&متغير الصورة, 16);

    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x32);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 32);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 1);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x000D0000);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 1);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 3);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);

    دع موضع_أمر_التوقيع: طبيعي = الطول(الصورة) مثل طبيعي;
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0x1D);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 16);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, موضع_التوقيع);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);

    إذا ((الطول(الصورة) مثل طبيعي) != 32 + حجم_أوامر_التحميل) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_محتوى_النص)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
