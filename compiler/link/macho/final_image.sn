    إذا (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_النص,
        قاعدة_الصورة,
        نهاية_مقطع_النص,
        0,
        نهاية_مقطع_النص,
        5,
        5,
        عدد_أقسام_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_النص,
        &اسم_مقطع_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (لديه_رموز_ديناميكية) {
        دع اسم_الستبات: متجه ط8 = اسم_قسم_ستب_ماتشو();
        إذا (!ألحق_أمر_قسم_ماتشو(
            &متغير الصورة,
            &اسم_الستبات,
            &اسم_مقطع_النص,
            عنوان_الستبات,
            حجم_الستبات,
            بداية_الستبات,
            2,
            0x80000408,
            0,
            حجم_الستب_ماتشو
        )) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    دع حجم_ملف_مقطع_البيانات: طبيعي =
        نهاية_ملف_البيانات - بداية_مقطع_البيانات;
    دع حجم_ذاكرة_مقطع_البيانات: طبيعي =
        نهاية_ذاكرة_البيانات - (قاعدة_الصورة + بداية_مقطع_البيانات);
    إذا (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_البيانات,
        قاعدة_الصورة + بداية_مقطع_البيانات,
        حجم_ذاكرة_مقطع_البيانات,
        بداية_مقطع_البيانات,
        حجم_ملف_مقطع_البيانات,
        3,
        3,
        عدد_أقسام_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (!ألحق_أوامر_أقسام_ماتشو_المدخلة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_البيانات_الملفوفة,
        &اسم_مقطع_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (لديه_رموز_ديناميكية) {
