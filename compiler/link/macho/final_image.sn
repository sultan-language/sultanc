                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
    };

    دع موضع_أمر_لينك: طبيعي = الطول(الصورة) مثل طبيعي;
    إذا (!ألحق_أمر_مقطع_ماتشو(
        &متغير الصورة,
        &اسم_مقطع_لينك,
        بداية_ذاكرة_لينك,
        0,
        بداية_ملف_لينك,
        0,
        1,
        1,
