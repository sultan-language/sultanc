استورد std.text.from_bytes;
استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.address_resolution;
استورد compiler.link.macho.encoding;
استورد compiler.link.macho.code_signature;
استورد std.crypto.sha256;
استورد compiler.link.macho.names;
استورد compiler.backend.target.target_model;

عام نوع خطأ_صورة_ماتشو_تنفيذية =
    | هدف_غير_مدعوم
    | تخطيط_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_محلول
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
    | توقيع_فشل
;

عام نوع نتيجة_صورة_ماتشو_تنفيذية =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_صورة_ماتشو_تنفيذية
;

نوع رمز_ديناميكي_ماتشو_ربط = {
    المعرف: معرف_رمز_ربط,
    الاسم: متجه ط8,
    ترتيب_المكتبة: طبيعي,
    إزاحة_الاسم: طبيعي,
    التعريف: اختياري تعريف_رمز_ربط
};

نوع سجل_ربط_ديناميكي_ماتشو = {
    الرمز: معرف_رمز_ربط,
    ترتيب_المقطع: طبيعي,
    الإزاحة_في_المقطع: طبيعي,
    الإضافة: عدد
};

نوع حافة_عقدة_تصدير_ماتشو = {
    البايت: ط8,
    العقدة: طبيعي
};

نوع عقدة_تصدير_ماتشو = {
    طرفية: منطقي,
    العنوان: طبيعي,
    الحواف: متجه حافة_عقدة_تصدير_ماتشو
};

نوع مجموعة_أقسام_ماتشو_ربط = {
    الأقسام: متجه معرف_قسم_ربط,
    بداية_الملف: طبيعي,
    نهاية_الملف: طبيعي,
    بداية_الذاكرة: طبيعي,
    نهاية_الذاكرة: طبيعي
};

عرف انسخ_بايتات_ماتشو_ربط(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_ماتشو(&متغير الناتج, المصدر);
    أرجع الناتج;
}

عرف متجها_بايتات_ماتشو_ربط_متساويان(
    الأول: &متجه ط8,
    الثاني: &متجه ط8
): منطقي {
    إذا ((الطول(*الأول) مثل طبيعي) != (الطول(*الثاني) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*الأول) مثل طبيعي)) {
        إذا ((*الأول)[فهرس_البايت] != (*الثاني)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف أس_محاذاة_ماتشو_من_قيمة(المحاذاة: طبيعي): اختياري طبيعي {
    إذا (المحاذاة == 0) { أرجع اختياري.موجود(0); };
    دع القيمة: متغير طبيعي = 1;
    دع الأس: متغير طبيعي = 0;
    طالما (القيمة < المحاذاة && الأس < 31) {
        القيمة := القيمة * 2;
        الأس := الأس + 1;
    }
    إذا (القيمة != المحاذاة) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأس);
}

عرف قسم_ماتشو_صفري_تنفيذيا(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
        دع النوع: طبيعي = الأعلام & 0xFF;
        أرجع النوع == 1 || النوع == 0xC || النوع == 0x12;
    }
    | _ -> { أرجع خطأ; };
}

عرف أعلام_قسم_ماتشو_تنفيذيا(القسم: &قسم_ربط): اختياري طبيعي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
        أرجع اختياري.موجود(الأعلام);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قسم_ماتشو_في_مقطع_نص(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.شفرة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_للقراءة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_تعريفية -> { أرجع صواب; }
    | صنف_قسم_ربط.خاص_بالصيغة -> {
        طابق (*القسم).الاسم.اسم_الحاوية مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(اسم_الحاوية) -> {
            دع اسم_النص: متجه ط8 = اسم_مقطع_نص_ماتشو();
            أرجع متجها_بايتات_ماتشو_ربط_متساويان(
                &اسم_الحاوية,
                &اسم_النص
            );
        };
    }
    | _ -> { أرجع خطأ; };
}

عرف قسم_ماتشو_في_مقطع_بيانات(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.بيانات_قابلة_للكتابة -> { أرجع صواب; }
    | صنف_قسم_ربط.بيانات_صفرية -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف قسم_ماتشو_في_مقطع_دوارف(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).الصنف مع
    | صنف_قسم_ربط.تصحيح -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف اجمع_أقسام_ماتشو_الحية(
    السياق: &سياق_ربط,
    صنف_المجموعة: طبيعي
): متجه معرف_قسم_ربط {
    دع الأقسام: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        إذا ((*القسم).حي) {
            دع ينتمي: متغير منطقي = خطأ;
            إذا (صنف_المجموعة == 0) {
                ينتمي := قسم_ماتشو_في_مقطع_نص(القسم);
            } وإلا إذا (صنف_المجموعة == 1) {
                ينتمي := قسم_ماتشو_في_مقطع_بيانات(القسم);
            } وإلا {
                ينتمي := قسم_ماتشو_في_مقطع_دوارف(القسم);
            };
            إذا (ينتمي) { ألحق(الأقسام, (*القسم).المعرف); };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع الأقسام;
}

عرف رشح_أقسام_بيانات_ماتشو(
    السياق: &سياق_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    نريد_أقساما_صفرية: منطقي
): متجه معرف_قسم_ربط {
    دع المرشحة: متغير متجه معرف_قسم_ربط = [];
    دع فهرس_المعرف: متغير طبيعي = 0;
    طالما (فهرس_المعرف < (الطول(*الأقسام) مثل طبيعي)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        إذا (قسم_ماتشو_صفري_تنفيذيا(القسم) == نريد_أقساما_صفرية) {
            ألحق(المرشحة, معرف_القسم);
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    أرجع المرشحة;
}

// A dylib-defined symbol binds to the ordinal of the LC_LOAD_DYLIB written for
// the very input that defines it, as LLD's Mach-O writer binds a DylibSymbol to
// its DylibFile ordinal. An undefined import binds to the dylib its
// declaration names (`خارجي «/usr/lib/libSystem.B.dylib» عرف ...`, the
// install name, as Go's cgo_import_dynamic names it per symbol); without one
// it keeps ordinal 1, the system library that ابن_اعتمادات_ماتشو always
// writes first.
عرف ترتيب_مدخل_مكتبة_ماتشو(
    السياق: &سياق_ربط,
    المدخل: معرف_مدخل_ربط
): اختياري طبيعي {
    دع الاعتمادات: متجه متجه ط8 = ابن_اعتمادات_ماتشو(السياق);
    دع فهرس_اعتماد_الخطة: متغير طبيعي = 0;
    طالما (
        فهرس_اعتماد_الخطة
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي)
    ) {
        دع اعتماد_الخطة: &اعتماد_مكتبة_ديناميكية_ربط =
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_اعتماد_الخطة];
        طابق (*اعتماد_الخطة).المدخل مع
        | اختياري.موجود(مدخل_الاعتماد) -> {
            إذا (معرفا_مدخل_ربط_متساويان(مدخل_الاعتماد, المدخل)) {
                دع فهرس_الاعتماد: متغير طبيعي = 0;
                طالما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل طبيعي)) {
                    إذا (متجها_بايتات_ماتشو_ربط_متساويان(
                        &الاعتمادات[فهرس_الاعتماد],
                        &(*اعتماد_الخطة).الاسم
                    )) {
                        أرجع اختياري.موجود(فهرس_الاعتماد + 1);
                    };
                    فهرس_الاعتماد := فهرس_الاعتماد + 1;
                }
            };
        }
        | اختياري.لا_شيء -> { };
        فهرس_اعتماد_الخطة := فهرس_اعتماد_الخطة + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ترتيب_مكتبة_رمز_ماتشو(
    السياق: &سياق_ربط,
    الرمز: &رمز_ربط
): طبيعي {
    طابق (*الرمز).الحالة مع
    | حالة_رمز_ربط.ديناميكي(المدخل) -> {
        طابق ترتيب_مدخل_مكتبة_ماتشو(السياق, المدخل) مع
        | اختياري.موجود(الترتيب) -> { أرجع الترتيب; }
        | اختياري.لا_شيء -> { أرجع 1; };
    }
    | حالة_رمز_ربط.غير_معرف(_) -> {
        دع الاسم_الأساسي: متجه ط8 = اسم_رمز_سي_ماتشو_الأساسي(&(*الرمز).الاسم);
        طابق مكتبة_مصرحة_لرمز_في_خطة_ربط(&(*السياق).الخطة, &الاسم_الأساسي) مع
        | اختياري.لا_شيء -> { أرجع 1; }
        | اختياري.موجود(المكتبة) -> {
            دع الاعتمادات: متجه متجه ط8 = ابن_اعتمادات_ماتشو(السياق);
            دع فهرس_الاعتماد: متغير طبيعي = 0;
            طالما (فهرس_الاعتماد < (الطول(الاعتمادات) مثل طبيعي)) {
                إذا (متجها_بايتات_ماتشو_ربط_متساويان(&الاعتمادات[فهرس_الاعتماد], &المكتبة)) {
                    أرجع فهرس_الاعتماد + 1;
                };
                فهرس_الاعتماد := فهرس_الاعتماد + 1;
            }
            أرجع 1;
        };
    }
    | _ -> { أرجع 1; };
}

عرف اجمع_رموز_ماتشو_الديناميكية(
    السياق: &سياق_ربط,
    يشمل_التعريفات: منطقي
): متجه رمز_ديناميكي_ماتشو_ربط {
    دع الرموز: متغير متجه رمز_ديناميكي_ماتشو_ربط = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        دع ديناميكي: متغير منطقي = خطأ;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { ديناميكي := صواب; }
        | حالة_رمز_ربط.ديناميكي(_) -> {
            // Unreferenced dylib exports are not imported.
            ديناميكي := (*الرمز).مستخدم;
        }
        | _ -> { };
        إذا (ديناميكي) {
            دع المدخل: رمز_ديناميكي_ماتشو_ربط = {
                المعرف: (*الرمز).المعرف,
                الاسم: انسخ_بايتات_ماتشو_ربط(&(*الرمز).الاسم),
                ترتيب_المكتبة: ترتيب_مكتبة_رمز_ماتشو(السياق, الرمز),
                إزاحة_الاسم: 0,
                التعريف: اختياري.لا_شيء()
            };
            ألحق(الرموز, المدخل);
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    إذا (يشمل_التعريفات) {
        فهرس_الرمز := 0;
        طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
            دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
            طابق (*الرمز).الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                دع المدخل: رمز_ديناميكي_ماتشو_ربط = {
                    المعرف: (*الرمز).المعرف,
                    الاسم: انسخ_بايتات_ماتشو_ربط(&(*الرمز).الاسم),
                    ترتيب_المكتبة: 0,
                    إزاحة_الاسم: 0,
                    التعريف: اختياري.موجود(التعريف)
                };
                ألحق(الرموز, المدخل);
            }
            | _ -> { };
            فهرس_الرمز := فهرس_الرمز + 1;
        }
    };
    أرجع الرموز;
}

عرف عدد_رموز_استيراد_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
        طابق (*الرموز)[الفهرس].التعريف مع
        | اختياري.لا_شيء -> { العدد := العدد + 1; }
        | اختياري.موجود(_) -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ابحث_ترتيب_رمز_ديناميكي_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    المعرف: معرف_رمز_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الرموز) مثل طبيعي)) {
        إذا ((*الرموز)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_اعتماد_ماتشو_إن_لم_يوجد(
    الاعتمادات: &متغير متجه متجه ط8,
    الاسم: &متجه ط8
): فراغ {
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل طبيعي)) {
        إذا (متجها_بايتات_ماتشو_ربط_متساويان(
            &(*الاعتمادات)[فهرس_الاعتماد],
            الاسم
        )) {
            أرجع;
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    ألحق(*الاعتمادات, انسخ_بايتات_ماتشو_ربط(الاسم));
}

عرف ابن_اعتمادات_ماتشو(السياق: &سياق_ربط): متجه متجه ط8 {
    دع الاعتمادات: متغير متجه متجه ط8 = [];
    دع النظام: متجه ط8 = مسار_مكتبة_نظام_داروين_ماتشو();
    أضف_اعتماد_ماتشو_إن_لم_يوجد(&متغير الاعتمادات, &النظام);
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي)
    ) {
        دع الاسم: &متجه ط8 =
            &(*السياق).الخطة.المكتبات_الديناميكية[فهرس_الاعتماد].الاسم;
        أضف_اعتماد_ماتشو_إن_لم_يوجد(
            &متغير الاعتمادات,
            الاسم
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    // The dylib each imported symbol's declaration names, in symbol order: a
    // declared library none of whose functions is imported is not loaded
    // (ld64 -dead_strip_dylibs). std names only libSystem, written first above.
    إذا ((الطول((*السياق).الخطة.الاستيرادات_المصرحة) مثل طبيعي) == 0) {
        أرجع الاعتمادات;
    };
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> {
            دع الاسم_الأساسي: متجه ط8 = اسم_رمز_سي_ماتشو_الأساسي(&(*الرمز).الاسم);
            طابق مكتبة_مصرحة_لرمز_في_خطة_ربط(&(*السياق).الخطة, &الاسم_الأساسي) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المكتبة) -> {
                أضف_اعتماد_ماتشو_إن_لم_يوجد(&متغير الاعتمادات, &المكتبة);
            };
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع الاعتمادات;
}

عرف أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
    المسارات: &متغير متجه متجه ط8,
    المسار: &متجه ط8
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*المسارات) مثل طبيعي)) {
        إذا (متجها_بايتات_ماتشو_ربط_متساويان(
            &(*المسارات)[الفهرس],
            المسار
        )) {
            أرجع;
        };
        الفهرس := الفهرس + 1;
    }
    ألحق(*المسارات, انسخ_بايتات_ماتشو_ربط(المسار));
}

عرف ابن_مسارات_تشغيل_ماتشو(السياق: &سياق_ربط): متجه متجه ط8 {
    دع المسارات: متغير متجه متجه ط8 = [];
    دع فهرس_الصريح: متغير طبيعي = 0;
    طالما (
        فهرس_الصريح < (الطول((*السياق).الخطة.مسارات_التشغيل) مثل طبيعي)
    ) {
        أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
            &متغير المسارات,
            &(*السياق).الخطة.مسارات_التشغيل[فهرس_الصريح]
        );
        فهرس_الصريح := فهرس_الصريح + 1;
    }
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (
        فهرس_الاعتماد
            < (الطول((*السياق).الخطة.المكتبات_الديناميكية) مثل طبيعي)
    ) {
        طابق (*السياق).الخطة.المكتبات_الديناميكية[
            فهرس_الاعتماد
        ].دليل_البحث مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الدليل) -> {
            أضف_مسار_تشغيل_ماتشو_إن_لم_يوجد(
                &متغير المسارات,
                &الدليل
            );
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع المسارات;
}

عرف ضع_مجموعة_أقسام_ماتشو(
    السياق: &سياق_ربط,
    التخطيط: &متغير تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    بداية_الملف: طبيعي,
    بداية_الذاكرة: طبيعي,
    صفري_فقط: منطقي
): مجموعة_أقسام_ماتشو_ربط {
    دع موضع_الملف: متغير طبيعي = بداية_الملف;
    دع عنوان_الذاكرة: متغير طبيعي = بداية_الذاكرة;
    دع فهرس_المعرف: متغير طبيعي = 0;
    طالما (فهرس_المعرف < (الطول(*الأقسام) مثل طبيعي)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        دع صفري: منطقي = قسم_ماتشو_صفري_تنفيذيا(القسم);
        إذا (صفري == صفري_فقط) {
            دع المحاذاة: متغير طبيعي = (*القسم).المحاذاة;
            إذا (المحاذاة == 0) { المحاذاة := 1; };
            إذا (!صفري) {
                موضع_الملف := حاذ_قيمة_ماتشو(موضع_الملف, المحاذاة);
                عنوان_الذاكرة := بداية_الذاكرة
                    + (موضع_الملف - بداية_الملف);
            } وإلا {
                عنوان_الذاكرة := حاذ_قيمة_ماتشو(
                    عنوان_الذاكرة,
                    المحاذاة
                );
            };
            دع حجم_ملف_القسم: متغير طبيعي = (*القسم).الحجم;
            إذا (صفري) { حجم_ملف_القسم := 0; };
            دع موضع: موضع_قسم_خرج_ربط = {
                القسم: معرف_القسم,
                إزاحة_الملف: موضع_الملف,
                العنوان_الافتراضي: اختياري.موجود(عنوان_الذاكرة),
                حجم_الملف: حجم_ملف_القسم,
                حجم_الذاكرة: (*القسم).الحجم
            };
            أضف_موضع_قسم_خرج_ربط(التخطيط, موضع);
            إذا (!صفري) {
                موضع_الملف := موضع_الملف + (*القسم).الحجم;
                عنوان_الذاكرة := بداية_الذاكرة
                    + (موضع_الملف - بداية_الملف);
            } وإلا {
                عنوان_الذاكرة := عنوان_الذاكرة + (*القسم).الحجم;
            };
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    دع النتيجة: مجموعة_أقسام_ماتشو_ربط = {
        الأقسام: انسخ_مملوكا_متجه_معرف_قسم_ربط(الأقسام),
        بداية_الملف: بداية_الملف,
        نهاية_الملف: موضع_الملف,
        بداية_الذاكرة: بداية_الذاكرة,
        نهاية_الذاكرة: عنوان_الذاكرة
    };
    أرجع النتيجة;
}

عرف عنوان_مدخل_جوت_ماتشو(
    عنوان_جوت: طبيعي,
    ترتيب_الرمز: طبيعي
): طبيعي {
    أرجع عنوان_جوت + ترتيب_الرمز * 8;
}

عرف حجم_ستب_ماتشو_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(12); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(6);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حجم_صفحة_ماتشو_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(0x4000); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(0x1000);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نوع_معالج_ماتشو_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(0x0100000C);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(0x01000007);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نوع_معالج_فرعي_ماتشو_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع اختياري.موجود(0); }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(3);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف عنوان_ستب_ماتشو(
    عنوان_ستب: طبيعي,
    ترتيب_الرمز: طبيعي,
    حجم_الستب: طبيعي
): طبيعي {
    أرجع عنوان_ستب + ترتيب_الرمز * حجم_الستب;
}

عرف اجمع_إضافة_موقعة_ماتشو(
    الأساس: طبيعي,
    الإضافة: عدد
): اختياري طبيعي {
    إذا (الإضافة >= 0) {
        دع المقدار: طبيعي = الإضافة مثل طبيعي;
        دع الناتج: طبيعي = الأساس + المقدار;
        إذا (الناتج < الأساس) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الناتج);
    };
    // Preserve the full signed-addend range, including INT64_MIN.
    دع المقدار: طبيعي = ((-(الإضافة + 1)) مثل طبيعي) + 1;
    إذا (المقدار > الأساس) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الأساس - المقدار);
}

عرف اقرأ_قيمة_ماتشو_بعرض(
    الصورة: &متجه ط8,
    الموضع: طبيعي,
    العرض: طبيعي
): اختياري طبيعي {
    إذا (العرض == 4) {
        إذا (الموضع > (الطول(*الصورة) مثل طبيعي)
            || 4 > (الطول(*الصورة) مثل طبيعي) - الموضع) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(اقرأ_ط32_ماتشو_ربط(الصورة, الموضع));
    };
    إذا (العرض == 8) {
        إذا (الموضع > (الطول(*الصورة) مثل طبيعي)
            || 8 > (الطول(*الصورة) مثل طبيعي) - الموضع) {
            أرجع اختياري.لا_شيء();
        };
        أرجع اختياري.موجود(اقرأ_ط64_ماتشو_ربط(الصورة, الموضع));
    };
    أرجع اختياري.لا_شيء();
}

عرف اكتب_قيمة_ماتشو_بعرض(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    العرض: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (العرض == 4) {
        إذا (القيمة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_ط32_ماتشو_ربط_في(الصورة, الموضع, القيمة);
    };
    إذا (العرض == 8) {
        أرجع اكتب_ط64_ماتشو_ربط_في(الصورة, الموضع, القيمة);
    };
    أرجع خطأ;
}

عرف ابن_جدول_نصوص_ماتشو(
    الرموز: &متغير متجه رمز_ديناميكي_ماتشو_ربط
): متجه ط8 {
    دع الجدول: متغير متجه ط8 = [0];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول(*الرموز) مثل طبيعي)) {
        (*الرموز)[فهرس_الرمز].إزاحة_الاسم := الطول(الجدول) مثل طبيعي;
        ألحق_بايتات_ماتشو(
            &متغير الجدول,
            &(*الرموز)[فهرس_الرمز].الاسم
        );
        ألحق(الجدول, 0);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع الجدول;
}

عرف ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
    الأقسام: &متجه معرف_قسم_ربط,
    المعرف: معرف_قسم_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الأقسام) مثل طبيعي)) {
        إذا ((*الأقسام)[الفهرس].القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ترتيب_قسم_ماتشو_في_الصورة(
    المعرف: معرف_قسم_ربط,
    أقسام_النص: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الملفوفة: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الصفرية: &متجه معرف_قسم_ربط,
    أقسام_دوارف: &متجه معرف_قسم_ربط,
    لديه_استيرادات: منطقي
): اختياري طبيعي {
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(أقسام_النص, المعرف) مع
    | اختياري.موجود(الفهرس) -> { أرجع اختياري.موجود(الفهرس + 1); }
    | اختياري.لا_شيء -> { };
    دع الأساس_بعد_النص: متغير طبيعي =
        الطول(*أقسام_النص) مثل طبيعي;
    إذا (لديه_استيرادات) {
        الأساس_بعد_النص := الأساس_بعد_النص + 1;
    };
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
        أقسام_البيانات_الملفوفة,
        المعرف
    ) مع
    | اختياري.موجود(الفهرس) -> {
        أرجع اختياري.موجود(الأساس_بعد_النص + الفهرس + 1);
    }
    | اختياري.لا_شيء -> { };
    دع الأساس_بعد_البيانات: متغير طبيعي = الأساس_بعد_النص
        + (الطول(*أقسام_البيانات_الملفوفة) مثل طبيعي);
    إذا (لديه_استيرادات) {
        الأساس_بعد_البيانات := الأساس_بعد_البيانات + 1;
    };
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(
        أقسام_البيانات_الصفرية,
        المعرف
    ) مع
    | اختياري.موجود(الفهرس) -> {
        أرجع اختياري.موجود(الأساس_بعد_البيانات + الفهرس + 1);
    }
    | اختياري.لا_شيء -> { };
    دع الأساس_بعد_الصفر: طبيعي = الأساس_بعد_البيانات
        + (الطول(*أقسام_البيانات_الصفرية) مثل طبيعي);
    طابق ابحث_ترتيب_قسم_ماتشو_في_مجموعة(أقسام_دوارف, المعرف) مع
    | اختياري.موجود(الفهرس) -> {
        أرجع اختياري.موجود(الأساس_بعد_الصفر + الفهرس + 1);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف ابن_جدول_رموز_ماتشو(
    السياق: &سياق_ربط,
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    أقسام_النص: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الملفوفة: &متجه معرف_قسم_ربط,
    أقسام_البيانات_الصفرية: &متجه معرف_قسم_ربط,
    أقسام_دوارف: &متجه معرف_قسم_ربط,
    لديه_استيرادات: منطقي
): اختياري متجه ط8 {
    دع الجدول: متغير متجه ط8 = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول(*الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[فهرس_الرمز];
        ألحق_ط32_ماتشو_ربط(&متغير الجدول, (*الرمز).إزاحة_الاسم);
        طابق (*الرمز).التعريف مع
        | اختياري.لا_شيء -> {
            ألحق_بايت_ماتشو(&متغير الجدول, 1);
            ألحق_بايت_ماتشو(&متغير الجدول, 0);
            ألحق_ط16_ماتشو_ربط(
                &متغير الجدول,
                ((*الرمز).ترتيب_المكتبة & 0xFF) << 8
            );
            ألحق_ط64_ماتشو_ربط(&متغير الجدول, 0);
        }
        | اختياري.موجود(التعريف) -> {
            دع نوع_الرمز: متغير طبيعي = 3;
            دع ترتيب_القسم: متغير طبيعي = 0;
            دع القيمة: متغير طبيعي = 0;
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.مطلق(العنوان) -> { القيمة := العنوان; }
            | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, _) -> {
                نوع_الرمز := 0xF;
                طابق ترتيب_قسم_ماتشو_في_الصورة(
                    معرف_القسم,
                    أقسام_النص,
                    أقسام_البيانات_الملفوفة,
                    أقسام_البيانات_الصفرية,
                    أقسام_دوارف,
                    لديه_استيرادات
                ) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الترتيب) -> { ترتيب_القسم := الترتيب; };
                طابق حل_عنوان_رمز_ربط(السياق, (*الرمز).المعرف) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> { القيمة := العنوان; }
                | _ -> { أرجع اختياري.لا_شيء(); };
            }
            | موضع_تعريف_رمز_ربط.غير_محدد -> {
                أرجع اختياري.لا_شيء();
            };
            دع الوصف: متغير طبيعي = 0;
            طابق التعريف.القوة مع
            | قوة_تعريف_رمز_ربط.قوي -> { }
            | قوة_تعريف_رمز_ربط.ضعيف -> { الوصف := 0x80; };
            ألحق_بايت_ماتشو(&متغير الجدول, نوع_الرمز);
            ألحق_بايت_ماتشو(&متغير الجدول, ترتيب_القسم);
            ألحق_ط16_ماتشو_ربط(&متغير الجدول, الوصف);
            ألحق_ط64_ماتشو_ربط(&متغير الجدول, القيمة);
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختياري.موجود(الجدول);
}

عرف ابن_جدول_رموز_غير_مباشرة_ماتشو(
    عدد_الرموز: طبيعي
): متجه ط8 {
    دع الجدول: متغير متجه ط8 = [];
    دع المرور: متغير طبيعي = 0;
    طالما (المرور < 2) {
        دع فهرس_الرمز: متغير طبيعي = 0;
        طالما (فهرس_الرمز < عدد_الرموز) {
            ألحق_ط32_ماتشو_ربط(&متغير الجدول, فهرس_الرمز);
            فهرس_الرمز := فهرس_الرمز + 1;
        }
        المرور := المرور + 1;
    }
    أرجع الجدول;
}

عرف حجم_يو_ليب_ماتشو(القيمة: طبيعي): طبيعي {
    دع الباقي: متغير طبيعي = القيمة;
    دع الحجم: متغير طبيعي = 1;
    طالما (الباقي >= 128) {
        الباقي := الباقي >> 7;
        الحجم := الحجم + 1;
    }
    أرجع الحجم;
}

عرف ابحث_حافة_تصدير_ماتشو(
    العقدة: &عقدة_تصدير_ماتشو,
    البايت: ط8
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*العقدة).الحواف) مثل طبيعي)) {
        إذا ((*العقدة).الحواف[الفهرس].البايت == البايت) {
            أرجع اختياري.موجود((*العقدة).الحواف[الفهرس].العقدة);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف أضف_رمز_إلى_شجرة_تصدير_ماتشو(
    العقد: &متغير متجه عقدة_تصدير_ماتشو,
    الاسم: &متجه ط8,
    العنوان: طبيعي
): منطقي {
    دع ترتيب_العقدة: متغير طبيعي = 0;
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*الاسم) مثل طبيعي)) {
        دع البايت: ط8 = (*الاسم)[فهرس_البايت];
        دع الترتيب_التالي: طبيعي;
        طابق ابحث_حافة_تصدير_ماتشو(&(*العقد)[ترتيب_العقدة], البايت) مع
        | اختياري.موجود(القيمة) -> { الترتيب_التالي := القيمة; }
        | اختياري.لا_شيء -> {
            دع الحواف_الفارغة: متجه حافة_عقدة_تصدير_ماتشو = [];
            دع عقدة_جديدة: عقدة_تصدير_ماتشو = {
                طرفية: خطأ,
                العنوان: 0,
                الحواف: الحواف_الفارغة
            };
            الترتيب_التالي := الطول(*العقد) مثل طبيعي;
            ألحق(*العقد, عقدة_جديدة);
            دع الحافة: حافة_عقدة_تصدير_ماتشو = {
                البايت: البايت,
                العقدة: الترتيب_التالي
            };
            ألحق((*العقد)[ترتيب_العقدة].الحواف, الحافة);
        };
        ترتيب_العقدة := الترتيب_التالي;
        فهرس_البايت := فهرس_البايت + 1;
    }
    (*العقد)[ترتيب_العقدة].طرفية := صواب;
    (*العقد)[ترتيب_العقدة].العنوان := العنوان;
    أرجع صواب;
}

عرف حجم_عقدة_تصدير_ماتشو(
    العقدة: &عقدة_تصدير_ماتشو,
    المواضع: &متجه طبيعي
): اختياري طبيعي {
    إذا ((الطول((*العقدة).الحواف) مثل طبيعي) > 255) {
        أرجع اختياري.لا_شيء();
    };
    دع حجم_الطرفية: متغير طبيعي = 0;
    إذا ((*العقدة).طرفية) {
        حجم_الطرفية := 1 + حجم_يو_ليب_ماتشو((*العقدة).العنوان);
    };
    دع الحجم: متغير طبيعي = حجم_يو_ليب_ماتشو(حجم_الطرفية)
        + حجم_الطرفية + 1;
    دع فهرس_الحافة: متغير طبيعي = 0;
    طالما (فهرس_الحافة < (الطول((*العقدة).الحواف) مثل طبيعي)) {
        دع ترتيب_الطفل: طبيعي = (*العقدة).الحواف[فهرس_الحافة].العقدة;
        إذا (ترتيب_الطفل >= (الطول(*المواضع) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        الحجم := الحجم + 2 + حجم_يو_ليب_ماتشو((*المواضع)[ترتيب_الطفل]);
        فهرس_الحافة := فهرس_الحافة + 1;
    }
    أرجع اختياري.موجود(الحجم);
}

عرف ابن_مواضع_عقد_تصدير_ماتشو(
    العقد: &متجه عقدة_تصدير_ماتشو
): اختياري متجه طبيعي {
    دع المواضع: متغير متجه طبيعي = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*العقد) مثل طبيعي)) {
        ألحق(المواضع, 0);
        الفهرس := الفهرس + 1;
    }
    دع المرور: متغير طبيعي = 0;
    طالما (المرور < 16) {
        دع الموضع: متغير طبيعي = 0;
        دع تغير: متغير منطقي = خطأ;
        الفهرس := 0;
        طالما (الفهرس < (الطول(*العقد) مثل طبيعي)) {
            إذا (المواضع[الفهرس] != الموضع) {
                المواضع[الفهرس] := الموضع;
                تغير := صواب;
            };
            دع الحجم: طبيعي;
            طابق حجم_عقدة_تصدير_ماتشو(&(*العقد)[الفهرس], &المواضع) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الحجم := القيمة; };
            الموضع := الموضع + الحجم;
            الفهرس := الفهرس + 1;
        }
        إذا (!تغير) { أرجع اختياري.موجود(المواضع); };
        المرور := المرور + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابن_شجرة_تصدير_ماتشو(
    السياق: &سياق_ربط,
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    قاعدة_الصورة: طبيعي
): اختياري متجه ط8 {
    دع العقد: متغير متجه عقدة_تصدير_ماتشو = [];
    دع حواف_الجذر: متجه حافة_عقدة_تصدير_ماتشو = [];
    دع الجذر: عقدة_تصدير_ماتشو = {
        طرفية: خطأ,
        العنوان: 0,
        الحواف: حواف_الجذر
    };
    ألحق(العقد, الجذر);
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول(*الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[فهرس_الرمز];
        طابق (*الرمز).التعريف مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(_) -> {
            دع العنوان: طبيعي;
            طابق حل_عنوان_رمز_ربط(السياق, (*الرمز).المعرف) مع
            | نتيجة_حل_عنوان_ربط.نجح(القيمة) -> { العنوان := القيمة; }
            | _ -> { أرجع اختياري.لا_شيء(); };
            إذا (العنوان < قاعدة_الصورة) { أرجع اختياري.لا_شيء(); };
            إذا (!أضف_رمز_إلى_شجرة_تصدير_ماتشو(
                &متغير العقد,
                &(*الرمز).الاسم,
                العنوان - قاعدة_الصورة
            )) {
                أرجع اختياري.لا_شيء();
            };
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    إذا ((الطول(العقد) مثل طبيعي) == 1) {
        دع الشجرة_الفارغة: متجه ط8 = [];
        أرجع اختياري.موجود(الشجرة_الفارغة);
    };
    دع المواضع: متجه طبيعي;
    طابق ابن_مواضع_عقد_تصدير_ماتشو(&العقد) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المواضع := القيمة; };
    دع الناتج: متغير متجه ط8 = [];
    دع فهرس_العقدة: متغير طبيعي = 0;
    طالما (فهرس_العقدة < (الطول(العقد) مثل طبيعي)) {
        دع العقدة: &عقدة_تصدير_ماتشو = &العقد[فهرس_العقدة];
        دع حجم_الطرفية: متغير طبيعي = 0;
        إذا ((*العقدة).طرفية) {
            حجم_الطرفية := 1 + حجم_يو_ليب_ماتشو((*العقدة).العنوان);
        };
        ألحق_يو_ليب_ماتشو(&متغير الناتج, حجم_الطرفية);
        إذا ((*العقدة).طرفية) {
            ألحق_يو_ليب_ماتشو(&متغير الناتج, 0);
            ألحق_يو_ليب_ماتشو(&متغير الناتج, (*العقدة).العنوان);
        };
        ألحق_بايت_ماتشو(
            &متغير الناتج,
            الطول((*العقدة).الحواف) مثل طبيعي
        );
        دع فهرس_الحافة: متغير طبيعي = 0;
        طالما (فهرس_الحافة < (الطول((*العقدة).الحواف) مثل طبيعي)) {
            دع الحافة: &حافة_عقدة_تصدير_ماتشو =
                &(*العقدة).الحواف[فهرس_الحافة];
            ألحق_بايت_ماتشو(&متغير الناتج, (*الحافة).البايت);
            ألحق_بايت_ماتشو(&متغير الناتج, 0);
            دع فهرس_عقدة_الحافة: طبيعي = (*الحافة).العقدة;
            ألحق_يو_ليب_ماتشو(
                &متغير الناتج,
                المواضع[فهرس_عقدة_الحافة]
            );
            فهرس_الحافة := فهرس_الحافة + 1;
        }
        فهرس_العقدة := فهرس_العقدة + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عرف ألحق_ترتيب_مكتبة_ربط_ماتشو(
    الربط: &متغير متجه ط8,
    الترتيب: طبيعي
): منطقي {
    إذا (الترتيب == 0) { أرجع خطأ; };
    إذا (الترتيب <= 15) {
        ألحق_بايت_ماتشو(الربط, 0x10 | الترتيب);
        أرجع صواب;
    };
    ألحق_بايت_ماتشو(الربط, 0x20);
    ألحق_يو_ليب_ماتشو(الربط, الترتيب);
    أرجع صواب;
}

عرف ابن_ربط_ديناميكي_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    السجلات: &متجه سجل_ربط_ديناميكي_ماتشو
): اختياري متجه ط8 {
    دع الربط: متغير متجه ط8 = [];
    دع فهرس_السجل: متغير طبيعي = 0;
    طالما (فهرس_السجل < (الطول(*السجلات) مثل طبيعي)) {
        دع السجل: &سجل_ربط_ديناميكي_ماتشو = &(*السجلات)[فهرس_السجل];
        دع ترتيب_الرمز: طبيعي;
        طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
            الرموز,
            (*السجل).الرمز
        ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { ترتيب_الرمز := القيمة; };
        دع الرمز: &رمز_ديناميكي_ماتشو_ربط = &(*الرموز)[ترتيب_الرمز];
        ألحق_بايت_ماتشو(&متغير الربط, 0x51);
        إذا (!ألحق_ترتيب_مكتبة_ربط_ماتشو(
            &متغير الربط,
            (*الرمز).ترتيب_المكتبة
        )) {
            أرجع اختياري.لا_شيء();
        };
        ألحق_بايت_ماتشو(&متغير الربط, 0x40);
        ألحق_اسم_صفري_ماتشو(&متغير الربط, &(*الرمز).الاسم);
        إذا ((*السجل).ترتيب_المقطع > 15) {
            أرجع اختياري.لا_شيء();
        };
        ألحق_بايت_ماتشو(
            &متغير الربط,
            0x70 | (*السجل).ترتيب_المقطع
        );
        ألحق_يو_ليب_ماتشو(
            &متغير الربط,
            (*السجل).الإزاحة_في_المقطع
        );
        إذا ((*السجل).الإضافة != 0) {
            ألحق_بايت_ماتشو(&متغير الربط, 0x60);
            ألحق_سليب_ماتشو(&متغير الربط, (*السجل).الإضافة);
        };
        ألحق_بايت_ماتشو(&متغير الربط, 0x90);
        فهرس_السجل := فهرس_السجل + 1;
    }
    ألحق_بايت_ماتشو(&متغير الربط, 0);
    أرجع اختياري.موجود(الربط);
}

عرف ابن_ستبات_ماتشو_ذراع64(
    عدد_الرموز: طبيعي,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): اختياري متجه ط8 {
    دع الستبات: متغير متجه ط8 = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_بداية_الستب: طبيعي = الطول(الستبات) مثل طبيعي;
        ألحق_ط32_ماتشو_ربط(&متغير الستبات, 0x90000010);
        ألحق_ط32_ماتشو_ربط(&متغير الستبات, 0xF9400210);
        ألحق_ط32_ماتشو_ربط(&متغير الستبات, 0xD61F0200);
        دع عنوان_الستب_الحالي: طبيعي =
            عنوان_ستب_ماتشو(عنوان_الستب, فهرس_الرمز, 12);
        دع عنوان_جوت_الحالي: طبيعي =
            عنوان_مدخل_جوت_ماتشو(عنوان_جوت, فهرس_الرمز);
        إذا (!رقع_صفحة21_ماتشو(
            &متغير الستبات,
            موضع_بداية_الستب,
            عنوان_الستب_الحالي,
            عنوان_جوت_الحالي
        )) {
            أرجع اختياري.لا_شيء();
        };
        إذا (!رقع_صفحة12_ماتشو(
            &متغير الستبات,
            موضع_بداية_الستب + 4,
            عنوان_جوت_الحالي
        )) {
            أرجع اختياري.لا_شيء();
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختياري.موجود(الستبات);
}

عرف ابن_ستبات_ماتشو_إكس64(
    عدد_الرموز: طبيعي,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): اختياري متجه ط8 {
    دع الستبات: متغير متجه ط8 = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع عنوان_الستب_الحالي: طبيعي =
            عنوان_ستب_ماتشو(عنوان_الستب, فهرس_الرمز, 6);
        دع عنوان_جوت_الحالي: طبيعي =
            عنوان_مدخل_جوت_ماتشو(عنوان_جوت, فهرس_الرمز);
        دع الإزاحة: طبيعي;
        طابق فرق_نسبي_ص32_ماتشو(
            عنوان_الستب_الحالي + 6,
            عنوان_جوت_الحالي
        ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الإزاحة := القيمة; };
        ألحق(الستبات, 0xFF);
        ألحق(الستبات, 0x25);
        ألحق_ط32_ماتشو_ربط(&متغير الستبات, الإزاحة);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختياري.موجود(الستبات);
}

عرف ابن_ستبات_ماتشو(
    الهدف: &واصف_هدف,
    عدد_الرموز: طبيعي,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): اختياري متجه ط8 {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع ابن_ستبات_ماتشو_ذراع64(
            عدد_الرموز,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع ابن_ستبات_ماتشو_إكس64(
            عدد_الرموز,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف أضف_سجلات_جوت_ماتشو(
    الرموز: &متجه رمز_ديناميكي_ماتشو_ربط,
    عدد_الرموز: طبيعي,
    السجلات: &متغير متجه سجل_ربط_ديناميكي_ماتشو,
    ترتيب_مقطع_البيانات: طبيعي,
    إزاحة_جوت_في_البيانات: طبيعي
): فراغ {
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع السجل: سجل_ربط_ديناميكي_ماتشو = {
            الرمز: (*الرموز)[فهرس_الرمز].المعرف,
            ترتيب_المقطع: ترتيب_مقطع_البيانات,
            الإزاحة_في_المقطع: إزاحة_جوت_في_البيانات + فهرس_الرمز * 8,
            الإضافة: 0
        };
        ألحق(*السجلات, السجل);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
}

عرف أضف_موقعة_ماتشو(الأساس: عدد, الإضافة: عدد): اختياري عدد {
    إذا (الإضافة > 0 && الأساس > 9223372036854775807 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    إذا (الإضافة < 0 && الأساس < -9223372036854775807 - 1 - الإضافة) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(الأساس + الإضافة);
}

عرف إضافة_مضمنة_ماتشو_من_قسم(
    القسم: &قسم_ربط,
    الإزاحة: طبيعي,
    العرض: طبيعي
): اختياري عدد {
    إذا (العرض != 4 && العرض != 8) { أرجع اختياري.لا_شيء(); };
    طابق (*القسم).المحتوى مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(البايتات) -> {
        إذا (الإزاحة > (الطول(البايتات) مثل طبيعي)
            || العرض > (الطول(البايتات) مثل طبيعي) - الإزاحة) {
            أرجع اختياري.لا_شيء();
        };
        دع القيمة: متغير طبيعي = 0;
        دع فهرس_البايت: متغير طبيعي = 0;
        طالما (فهرس_البايت < العرض) {
            دع موضع_البايت: طبيعي = الإزاحة + فهرس_البايت;
            القيمة := القيمة
                | ((البايتات[موضع_البايت] مثل طبيعي)
                    << (فهرس_البايت * 8));
            فهرس_البايت := فهرس_البايت + 1;
        }
        إذا (العرض == 4) {
            أرجع اختياري.موجود(ص32_من_ط32_ماتشو(القيمة));
        };
        دع الحد_الأعلى: طبيعي = 9223372036854775807 مثل طبيعي;
        إذا (القيمة > الحد_الأعلى) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(القيمة مثل عدد);
    };
}

// SUBTRACTOR followed by UNSIGNED encodes one address difference, not an
// absolute pointer. The canonical relocation applier processes both edges;
// dyld binding and rebasing must not process the second edge in isolation.
// ARM64 uses SUBTRACTOR=1; x86_64 uses SUBTRACTOR=5.
عرف تابع_زوج_طرح_ماتشو(
    السياق: &سياق_ربط,
    الفهرس: طبيعي
): منطقي {
    إذا (الفهرس == 0) { أرجع خطأ; };
    دع الحالي: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
    إذا (((*الحالي).رمز_صيغة / 16) != 0) { أرجع خطأ; };
    دع السابق: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس - 1];
    إذا ((*السابق).القسم.القيمة != (*الحالي).القسم.القيمة
        || (*السابق).الإزاحة != (*الحالي).الإزاحة) {
        أرجع خطأ;
    };
    دع نوع_السابق: طبيعي = (*السابق).رمز_صيغة / 16;
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع نوع_السابق == 1; }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع نوع_السابق == 5; }
    | _ -> { أرجع خطأ; };
}

عرف أضف_سجلات_ربط_مباشرة_ماتشو(
    السياق: &سياق_ربط,
    السجلات: &متغير متجه سجل_ربط_ديناميكي_ماتشو,
    مكتبة_مشتركة: منطقي,
    قاعدة_الصورة: طبيعي,
    بداية_مقطع_البيانات: طبيعي
): منطقي {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع فهرس_الإزاحة: متغير طبيعي = 0;
    طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع النوع: طبيعي = (*الحافة).رمز_صيغة / 16;
        إذا (النوع == 0 && !تابع_زوج_طرح_ماتشو(السياق, فهرس_الإزاحة)) {
            طابق حل_عنوان_داخلي_ماتشو(
                السياق,
                &(*الحافة).المرجع,
                (*الحافة).إضافة
            ) مع
            | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                دع القسم: قسم_ربط;
                طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { القسم := القيمة; };
                دع الموضع: موضع_قسم_خرج_ربط;
                طابق ابحث_موضع_قسم_خرج_ربط(
                    &التخطيط,
                    (*الحافة).القسم
                ) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { الموضع := القيمة; };
                دع عنوان_الرقعة: طبيعي;
                طابق الموضع.العنوان_الافتراضي مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> {
                    إذا ((*الحافة).الإزاحة > 0xFFFFFFFFFFFFFFFF - القيمة) {
                        أرجع خطأ;
                    };
                    عنوان_الرقعة := القيمة + (*الحافة).الإزاحة;
                };
                دع ترتيب_المقطع: طبيعي;
                دع قاعدة_المقطع: طبيعي;
                // The current dyld binder emits BIND_TYPE_POINTER. An
                // import bind in __TEXT would require text fixups, which
                // this output model deliberately does not support.
                إذا (!قسم_ماتشو_في_مقطع_بيانات(&القسم)) {
                    أرجع خطأ;
                };
                إذا (مكتبة_مشتركة) { ترتيب_المقطع := 1; }
                وإلا { ترتيب_المقطع := 2; };
                قاعدة_المقطع := قاعدة_الصورة + بداية_مقطع_البيانات;
                إذا (عنوان_الرقعة < قاعدة_المقطع) { أرجع خطأ; };
                دع رمز_الصيغة: طبيعي = (*الحافة).رمز_صيغة;
                دع أس_العرض: طبيعي = (رمز_الصيغة / 2) & 3;
                دع العرض: طبيعي = 1 << أس_العرض;
                // Dyld's pointer bind is eight bytes and must never extend
                // beyond the original writable, file-backed section.
                إذا (العرض != 8
                    || (عنوان_الرقعة % 8) != 0
                    || ((*الحافة).الإزاحة % 8) != 0
                    || (*الحافة).الإزاحة > الموضع.حجم_الملف
                    || 8 > الموضع.حجم_الملف - (*الحافة).الإزاحة) {
                    أرجع خطأ;
                };
                دع الإضافة_المضمنة: عدد;
                طابق إضافة_مضمنة_ماتشو_من_قسم(
                    &القسم,
                    (*الحافة).الإزاحة,
                    العرض
                ) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع الإضافة: عدد;
                طابق أضف_موقعة_ماتشو(
                    الإضافة_المضمنة,
                    (*الحافة).إضافة
                ) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { الإضافة := القيمة; };
                دع السجل: سجل_ربط_ديناميكي_ماتشو = {
                    الرمز: معرف_الرمز,
                    ترتيب_المقطع: ترتيب_المقطع,
                    الإزاحة_في_المقطع: عنوان_الرقعة - قاعدة_المقطع,
                    الإضافة: الإضافة
                };
                ألحق(*السجلات, السجل);
            }
            | _ -> { };
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }
    أرجع صواب;
}

نوع نتيجة_تطبيق_إزاحات_ماتشو =
    | نجح
    | خطأ بنوع خطأ_صورة_ماتشو_تنفيذية
;

عرف حل_عنوان_داخلي_ماتشو(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط,
    الإضافة: عدد
): نتيجة_حل_عنوان_ربط {
    طابق حل_عنوان_مرجع_إزاحة_ربط(السياق, المرجع) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
        طابق اجمع_إضافة_موقعة_ماتشو(العنوان, الإضافة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_حل_عنوان_ربط.غير_محلول(); }
        | اختياري.موجود(القيمة) -> {
            أرجع نتيجة_حل_عنوان_ربط.نجح(القيمة);
        };
    }
    | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف) -> {
        أرجع نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف);
    }
    | نتيجة_حل_عنوان_ربط.غير_محلول -> {
        طابق *المرجع مع
        | مرجع_إزاحة_ربط.رمز(المعرف) -> {
            طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
            }
            | اختياري.موجود(الرمز) -> {
                طابق الرمز.الحالة مع
                | حالة_رمز_ربط.غير_معرف(_) -> {
                    أرجع نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف);
                }
                | _ -> {
                    أرجع نتيجة_حل_عنوان_ربط.غير_محلول();
                };
            };
        }
        | _ -> { أرجع نتيجة_حل_عنوان_ربط.غير_محلول(); };
    };
}

عرف ص32_من_ط32_ماتشو(القيمة: طبيعي): عدد {
    إذا (القيمة <= 0x7FFFFFFF) { أرجع القيمة مثل عدد; };
    أرجع -((0x100000000 - القيمة) مثل عدد);
}

عرف رقع_نسبي_إكس64_ماتشو(
    الصورة: &متغير متجه ط8,
    الموضع: طبيعي,
    المصدر: طبيعي,
    الوجهة: طبيعي,
    الإضافة: عدد,
    الزيادة: طبيعي
): منطقي {
    // Signed relocation addends must not wrap when the PC-relative bias
    // (used by x86-64 SIGNED_1/2/4 relocations) is applied.
    إذا (الزيادة > 9223372036854775807) { أرجع خطأ; };
    دع الإضافة_الكلية: عدد;
    طابق أضف_موقعة_ماتشو(الإضافة, الزيادة مثل عدد) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الإضافة_الكلية := القيمة; };
    دع الوجهة_المعدلة: طبيعي;
    طابق اجمع_إضافة_موقعة_ماتشو(الوجهة, الإضافة_الكلية) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الوجهة_المعدلة := القيمة; };
    // The PC of an x86-64 PC-relative field is the end of the instruction:
    // the field's address + 4 + the bytes after it (N of SIGNED_N), as ld64
    // and LLD's X86_64::relocateOne compute it. With the addend's own +N
    // that is S + A - (P + 4): a `call _f` (stored 0) reaches _f exactly.
    // Previously P itself was the PC, so every such field was 4 + N off.
    إذا (المصدر > 0xFFFFFFFFFFFFFFFF - 4 - الزيادة) { أرجع خطأ; };
    دع نهاية_التعليمة: طبيعي = المصدر + 4 + الزيادة;
    دع الفرق: طبيعي;
    طابق فرق_نسبي_ص32_ماتشو(نهاية_التعليمة, الوجهة_المعدلة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الفرق := القيمة; };
    أرجع اكتب_ط32_ماتشو_ربط_في(الصورة, الموضع, الفرق);
}

// A relocation must fit in its own file-backed input section, not just in
// the containing output image. This is also required for imported absolute
// pointers in constructor arrays from separately linked objects.
عرف رقعة_ماتشو_ضمن_قسم_ملف(
    الموضع: &موضع_قسم_خرج_ربط,
    الإزاحة: طبيعي,
    العرض: طبيعي,
    حجم_الصورة: طبيعي
): منطقي {
    إذا (العرض != 4 && العرض != 8) { أرجع خطأ; };
    إذا (الإزاحة > (*الموضع).حجم_الملف
        || العرض > (*الموضع).حجم_الملف - الإزاحة
        || (*الموضع).إزاحة_الملف > حجم_الصورة
        || العرض > حجم_الصورة - (*الموضع).إزاحة_الملف
        || الإزاحة > حجم_الصورة - (*الموضع).إزاحة_الملف - العرض) {
        أرجع خطأ;
    };
    أرجع صواب;
}

// Mach-O SUBTRACTOR / UNSIGNED pairs encode (add - subtract + field)
// modulo the relocation width. A negative difference is not an overflow.
عرف اطرح_عنوانين_ماتشو_بعرض(
    المضاف: طبيعي,
    المطروح: طبيعي,
    القيمة_المضمنة: طبيعي,
    العرض: طبيعي
): اختياري طبيعي {
    دع القناع: طبيعي;
    إذا (العرض == 4) {
        القناع := 0xFFFFFFFF;
    } وإلا إذا (العرض == 8) {
        دع قناع_ط32: طبيعي = 0xFFFFFFFF;
        القناع := قناع_ط32 + قناع_ط32 * (قناع_ط32 + 1);
    } وإلا {
        أرجع اختياري.لا_شيء();
    };
    دع الفرق: طبيعي;
    إذا (المضاف >= المطروح) {
        الفرق := (المضاف - المطروح) & القناع;
    } وإلا {
        دع المقدار: طبيعي = المطروح - المضاف;
        الفرق := (القناع - المقدار + 1) & القناع;
    };
    أرجع اختياري.موجود((الفرق + القيمة_المضمنة) & القناع);
}

عرف طبق_إزاحات_ماتشو_ذراع64(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه ط8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): نتيجة_تطبيق_إزاحات_ماتشو {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };

    دع فهرس_الإزاحة: متغير طبيعي = 0;
    طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
        | اختياري.لا_شيء -> {
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        | اختياري.موجود(الموضع) -> {
            دع رمز_الصيغة: طبيعي = (*الحافة).رمز_صيغة;
            دع أس_العرض: طبيعي = (رمز_الصيغة / 2) & 3;
            دع العرض: طبيعي = 1 << أس_العرض;
            دع نوع_الإزاحة: طبيعي = رمز_الصيغة / 16;
            إذا (!رقعة_ماتشو_ضمن_قسم_ملف(
                &الموضع, (*الحافة).الإزاحة, العرض,
                الطول(*الصورة) مثل طبيعي
            )) {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                );
            };
            دع موضع_الرقعة: طبيعي =
                الموضع.إزاحة_الملف + (*الحافة).الإزاحة;
            دع عنوان_مصدر_الرقعة: طبيعي;
            طابق الموضع.العنوان_الافتراضي مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختياري.موجود(العنوان) -> {
                إذا ((*الحافة).الإزاحة > 0xFFFFFFFFFFFFFFFF - العنوان) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                عنوان_مصدر_الرقعة := العنوان + (*الحافة).الإزاحة;
            };

            إذا (نوع_الإزاحة == 1) {
                إذا (فهرس_الإزاحة + 1
                    >= (الطول((*السياق).الإزاحات) مثل طبيعي)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع فهرس_الحافة_الثانية: طبيعي =
                    فهرس_الإزاحة + 1;
                دع الحافة_الثانية: &حافة_إزاحة_ربط =
                    &(*السياق).الإزاحات[فهرس_الحافة_الثانية];
                إذا ((*الحافة_الثانية).القسم.القيمة
                        != (*الحافة).القسم.القيمة
                    || (*الحافة_الثانية).الإزاحة != (*الحافة).الإزاحة
                    || ((*الحافة_الثانية).رمز_صيغة / 16) != 0
                    // Paired subtractor and unsigned entries must agree on
                    // their patch width and absolute-address encoding.
                    || (((*الحافة_الثانية).رمز_صيغة / 2) & 3) != أس_العرض
                    || (((*الحافة_الثانية).رمز_صيغة & 1) != 0)
                    || ((رمز_الصيغة & 1) != 0)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المطروح: طبيعي;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المطروح := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المضاف: طبيعي;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة_الثانية).المرجع,
                    (*الحافة_الثانية).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المضاف := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع الإضافة_المضمنة: طبيعي;
                طابق اقرأ_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                }
                | اختياري.موجود(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع القيمة: طبيعي;
                طابق اطرح_عنوانين_ماتشو_بعرض(
                    عنوان_المضاف, عنوان_المطروح, الإضافة_المضمنة, العرض
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                }
                | اختياري.موجود(الناتج) -> { القيمة := الناتج; };
                إذا (!اكتب_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض,
                    القيمة
                )) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                فهرس_الإزاحة := فهرس_الإزاحة + 2;
            } وإلا {
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.غير_محلول -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                    );
                }
                | نتيجة_حل_عنوان_ربط.نجح(عنوان_الهدف) -> {
                    إذا (نوع_الإزاحة == 0) {
                        دع الإضافة_المضمنة: طبيعي;
                        طابق اقرأ_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختياري.موجود(القيمة) -> {
                            الإضافة_المضمنة := القيمة;
                        };
                        // Do not wrap a pointer-valued absolute relocation.
                        إذا (الإضافة_المضمنة > 0xFFFFFFFFFFFFFFFF - عنوان_الهدف) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                        دع القيمة_المطلقة: طبيعي =
                            عنوان_الهدف + الإضافة_المضمنة;
                        إذا (العرض == 4 && القيمة_المطلقة > 0xFFFFFFFF) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                        إذا (!اكتب_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض,
                            القيمة_المطلقة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 2) {
                        إذا (!رقع_فرع26_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 3) {
                        إذا (!رقع_صفحة21_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 4) {
                        إذا (!رقع_صفحة12_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_الهدف
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 5) {
                        // GOT_LOAD_PAGE21 with a locally resolved symbol is
                        // relaxed to a direct PAGE21 targeting the symbol.
                        إذا ((*الحافة).إضافة != 0
                            || !رقع_صفحة21_ماتشو(
                                الصورة, موضع_الرقعة,
                                عنوان_مصدر_الرقعة, عنوان_الهدف
                            )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 6) {
                        // The matching LDR of a GOT entry becomes ADD when
                        // no imported GOT slot is needed in the final image.
                        إذا ((*الحافة).إضافة != 0
                            || !حوّل_تحميل_جوت_محلي_ماتشو(
                                الصورة, موضع_الرقعة
                            )
                            || !رقع_صفحة12_ماتشو(
                                الصورة, موضع_الرقعة, عنوان_الهدف
                            )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                        );
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                }
                | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                    دع ترتيب_الرمز: طبيعي;
                    طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
                        الرموز_الديناميكية,
                        معرف_الرمز
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { ترتيب_الرمز := القيمة; };
                    دع عنوان_الوجهة: طبيعي;
                    إذا (نوع_الإزاحة == 0) {
                    } وإلا إذا (نوع_الإزاحة == 2) {
                        عنوان_الوجهة := عنوان_ستب_ماتشو(
                            عنوان_الستب,
                            ترتيب_الرمز,
                            12
                        );
                        إذا (!رقع_فرع26_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 5) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        إذا (!رقع_صفحة21_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 6) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        إذا (!رقع_صفحة12_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_الوجهة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا إذا (نوع_الإزاحة == 7) {
                        عنوان_الوجهة := عنوان_مدخل_جوت_ماتشو(
                            عنوان_جوت,
                            ترتيب_الرمز
                        );
                        دع الفرق: طبيعي;
                        طابق فرق_نسبي_ص32_ماتشو(
                            عنوان_مصدر_الرقعة,
                            عنوان_الوجهة
                        ) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        }
                        | اختياري.موجود(القيمة) -> { الفرق := القيمة; };
                        إذا (!اكتب_ط32_ماتشو_ربط_في(
                            الصورة,
                            موضع_الرقعة,
                            الفرق
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                        );
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                };
            };
        };
    }
    أرجع نتيجة_تطبيق_إزاحات_ماتشو.نجح();
}


عرف زيادة_إزاحة_إكس64_ماتشو(النوع: طبيعي): اختياري طبيعي {
    إذا (النوع == 1 || النوع == 2) { أرجع اختياري.موجود(0); };
    إذا (النوع == 6) { أرجع اختياري.موجود(1); };
    إذا (النوع == 7) { أرجع اختياري.موجود(2); };
    إذا (النوع == 8) { أرجع اختياري.موجود(4); };
    أرجع اختياري.لا_شيء();
}

عرف طبق_إزاحات_ماتشو_إكس64(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه ط8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): نتيجة_تطبيق_إزاحات_ماتشو {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };

    دع فهرس_الإزاحة: متغير طبيعي = 0;
    طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع موضع_القسم: موضع_قسم_خرج_ربط;
        طابق ابحث_موضع_قسم_خرج_ربط(&التخطيط, (*الحافة).القسم) مع
        | اختياري.لا_شيء -> {
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        | اختياري.موجود(الموضع) -> {
            دع رمز_الصيغة: طبيعي = (*الحافة).رمز_صيغة;
            دع نوع_الإزاحة: طبيعي = رمز_الصيغة / 16;
            دع أس_العرض: طبيعي = (رمز_الصيغة / 2) & 3;
            دع العرض: طبيعي = 1 << أس_العرض;
            إذا (!رقعة_ماتشو_ضمن_قسم_ملف(
                &الموضع, (*الحافة).الإزاحة, العرض,
                الطول(*الصورة) مثل طبيعي
            )) {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                );
            };
            دع موضع_الرقعة: طبيعي =
                الموضع.إزاحة_الملف + (*الحافة).الإزاحة;
            دع عنوان_المصدر: طبيعي;
            طابق الموضع.العنوان_الافتراضي مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
            }
            | اختياري.موجود(العنوان) -> {
                إذا ((*الحافة).الإزاحة > 0xFFFFFFFFFFFFFFFF - العنوان) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                عنوان_المصدر := العنوان + (*الحافة).الإزاحة;
            };

            إذا (نوع_الإزاحة == 5) {
                إذا (فهرس_الإزاحة + 1
                    >= (الطول((*السياق).الإزاحات) مثل طبيعي)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع فهرس_الحافة_المضافة: طبيعي = فهرس_الإزاحة + 1;
                دع الحافة_المضافة: &حافة_إزاحة_ربط =
                    &(*السياق).الإزاحات[فهرس_الحافة_المضافة];
                إذا ((*الحافة_المضافة).القسم.القيمة
                        != (*الحافة).القسم.القيمة
                    || (*الحافة_المضافة).الإزاحة != (*الحافة).الإزاحة
                    || ((*الحافة_المضافة).رمز_صيغة / 16) != 0
                    // Paired subtractor and unsigned entries must agree on
                    // their patch width and absolute-address encoding.
                    || (((*الحافة_المضافة).رمز_صيغة / 2) & 3) != أس_العرض
                    || (((*الحافة_المضافة).رمز_صيغة & 1) != 0)
                    || ((رمز_الصيغة & 1) != 0)) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المطروح: طبيعي;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المطروح := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع عنوان_المضاف: طبيعي;
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة_المضافة).المرجع,
                    (*الحافة_المضافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
                    عنوان_المضاف := العنوان;
                }
                | _ -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                };
                دع الإضافة_المضمنة: طبيعي;
                طابق اقرأ_قيمة_ماتشو_بعرض(الصورة, موضع_الرقعة, العرض) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                }
                | اختياري.موجود(القيمة) -> { الإضافة_المضمنة := القيمة; };
                دع القيمة: طبيعي;
                طابق اطرح_عنوانين_ماتشو_بعرض(
                    عنوان_المضاف, عنوان_المطروح, الإضافة_المضمنة, العرض
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                    );
                }
                | اختياري.موجود(الناتج) -> { القيمة := الناتج; };
                إذا (!اكتب_قيمة_ماتشو_بعرض(
                    الصورة,
                    موضع_الرقعة,
                    العرض,
                    القيمة
                )) {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                    );
                };
                فهرس_الإزاحة := فهرس_الإزاحة + 2;
            } وإلا {
                دع الإضافة_المضمنة: متغير طبيعي = 0;
                إذا (العرض == 4 || العرض == 8) {
                    طابق اقرأ_قيمة_ماتشو_بعرض(
                        الصورة,
                        موضع_الرقعة,
                        العرض
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { الإضافة_المضمنة := القيمة; };
                };
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق,
                    &(*الحافة).المرجع,
                    (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.غير_محلول -> {
                    أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                        خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                    );
                }
                | نتيجة_حل_عنوان_ربط.نجح(عنوان_الهدف) -> {
                    إذا (نوع_الإزاحة == 0) {
                        // Do not wrap a pointer-valued absolute relocation.
                        إذا (الإضافة_المضمنة > 0xFFFFFFFFFFFFFFFF - عنوان_الهدف) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                        دع القيمة_المطلقة: طبيعي =
                            عنوان_الهدف + الإضافة_المضمنة;
                        إذا (العرض == 4 && القيمة_المطلقة > 0xFFFFFFFF) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                        إذا (!اكتب_قيمة_ماتشو_بعرض(
                            الصورة,
                            موضع_الرقعة,
                            العرض,
                            القيمة_المطلقة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    } وإلا {
                        دع الزيادة: طبيعي;
                        طابق زيادة_إزاحة_إكس64_ماتشو(نوع_الإزاحة) مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        }
                        | اختياري.موجود(القيمة) -> { الزيادة := القيمة; };
                        إذا (العرض != 4) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        دع الإضافة: عدد = ص32_من_ط32_ماتشو(
                            الإضافة_المضمنة
                        );
                        إذا (!رقع_نسبي_إكس64_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_المصدر,
                            عنوان_الهدف,
                            الإضافة,
                            الزيادة
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                }
                | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(معرف_الرمز) -> {
                    دع ترتيب_الرمز: طبيعي;
                    طابق ابحث_ترتيب_رمز_ديناميكي_ماتشو(
                        الرموز_الديناميكية,
                        معرف_الرمز
                    ) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
                        );
                    }
                    | اختياري.موجود(القيمة) -> { ترتيب_الرمز := القيمة; };
                    إذا (نوع_الإزاحة != 0) {
                        دع الوجهة: طبيعي;
                        إذا (نوع_الإزاحة == 2) {
                            الوجهة := عنوان_ستب_ماتشو(
                                عنوان_الستب,
                                ترتيب_الرمز,
                                6
                            );
                        } وإلا إذا (
                            نوع_الإزاحة == 3 || نوع_الإزاحة == 4
                        ) {
                            الوجهة := عنوان_مدخل_جوت_ماتشو(
                                عنوان_جوت,
                                ترتيب_الرمز
                            );
                        } وإلا {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        إذا (العرض != 4) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
                            );
                        };
                        دع الإضافة: عدد = ص32_من_ط32_ماتشو(
                            الإضافة_المضمنة
                        );
                        إذا (!رقع_نسبي_إكس64_ماتشو(
                            الصورة,
                            موضع_الرقعة,
                            عنوان_المصدر,
                            الوجهة,
                            الإضافة,
                            0
                        )) {
                            أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
                                خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
                            );
                        };
                    };
                    فهرس_الإزاحة := فهرس_الإزاحة + 1;
                };
            };
        };
    }
    أرجع نتيجة_تطبيق_إزاحات_ماتشو.نجح();
}

عرف طبق_إزاحات_ماتشو(
    السياق: &سياق_ربط,
    الصورة: &متغير متجه ط8,
    الرموز_الديناميكية: &متجه رمز_ديناميكي_ماتشو_ربط,
    عنوان_الستب: طبيعي,
    عنوان_جوت: طبيعي
): نتيجة_تطبيق_إزاحات_ماتشو {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع طبق_إزاحات_ماتشو_ذراع64(
            السياق,
            الصورة,
            الرموز_الديناميكية,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع طبق_إزاحات_ماتشو_إكس64(
            السياق,
            الصورة,
            الرموز_الديناميكية,
            عنوان_الستب,
            عنوان_جوت
        );
    }
    | _ -> {
        أرجع نتيجة_تطبيق_إزاحات_ماتشو.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };
}


عرف ألحق_أوامر_أقسام_ماتشو_المدخلة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط,
    اسم_المقطع: &متجه ط8
): منطقي {
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول(*الأقسام) مثل طبيعي)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_القسم];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        دع موضع_القسم: موضع_قسم_خرج_ربط;
        طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, معرف_القسم) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الموضع) -> { موضع_القسم := الموضع; };
        دع عنوان_القسم: طبيعي;
        طابق موضع_القسم.العنوان_الافتراضي مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(العنوان) -> { عنوان_القسم := العنوان; };
        دع أس_المحاذاة: طبيعي;
        طابق أس_محاذاة_ماتشو_من_قيمة((*القسم).المحاذاة) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القيمة) -> { أس_المحاذاة := القيمة; };
        دع الأعلام: طبيعي;
        طابق أعلام_قسم_ماتشو_تنفيذيا(القسم) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القيمة) -> { الأعلام := القيمة; };
        دع إزاحة_ملف_القسم: متغير طبيعي = موضع_القسم.إزاحة_الملف;
        إذا (قسم_ماتشو_صفري_تنفيذيا(القسم)) {
            إزاحة_ملف_القسم := 0;
        };
        إذا (!ألحق_أمر_قسم_ماتشو(
            الصورة,
            &(*القسم).الاسم.اسم_القسم,
            اسم_المقطع,
            عنوان_القسم,
            (*القسم).الحجم,
            إزاحة_ملف_القسم,
            أس_المحاذاة,
            الأعلام,
            0,
            0
        )) {
            أرجع خطأ;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع صواب;
}

عرف انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
    الصورة: &متغير متجه ط8,
    السياق: &سياق_ربط,
    التخطيط: &تخطيط_خرج_ربط,
    الأقسام: &متجه معرف_قسم_ربط
): منطقي {
    دع فهرس_المعرف: متغير طبيعي = 0;
    طالما (فهرس_المعرف < (الطول(*الأقسام) مثل طبيعي)) {
        دع معرف_القسم: معرف_قسم_ربط = (*الأقسام)[فهرس_المعرف];
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[معرف_القسم.القيمة];
        إذا ((*القسم).حي && !قسم_ماتشو_صفري_تنفيذيا(القسم)) {
            دع موضع_القسم: موضع_قسم_خرج_ربط;
            طابق ابحث_موضع_قسم_خرج_ربط(التخطيط, معرف_القسم) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الموضع) -> { موضع_القسم := الموضع; };
            إذا (!أكمل_ماتشو_إلى_موضع(
                الصورة,
                موضع_القسم.إزاحة_الملف
            )) {
                أرجع خطأ;
            };
            طابق (*القسم).المحتوى مع
            | اختياري.لا_شيء -> {
                إذا ((*القسم).الحجم != 0) { أرجع خطأ; };
            }
            | اختياري.موجود(المحتوى) -> {
                إذا ((الطول(المحتوى) مثل طبيعي) != (*القسم).الحجم) {
                    أرجع خطأ;
                };
                ألحق_بايتات_ماتشو(الصورة, &المحتوى);
            };
        };
        فهرس_المعرف := فهرس_المعرف + 1;
    }
    أرجع صواب;
}

عرف حل_إزاحة_دخول_ماتشو(
    السياق: &سياق_ربط,
    قاعدة_الصورة: طبيعي
): اختياري طبيعي {
    دع اسم_الدخول: متجه ط8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> { اسم_الدخول := الاسم; };
    دع الرمز: رمز_ربط;
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الرمز := القيمة; };
    طابق حل_عنوان_رمز_ربط(السياق, الرمز.المعرف) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
        إذا (العنوان < قاعدة_الصورة) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(العنوان - قاعدة_الصورة);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حجم_أوامر_تحميل_ماتشو_صورة(
    عدد_أقسام_النص: طبيعي,
    عدد_أقسام_البيانات: طبيعي,
    عدد_أقسام_دوارف: طبيعي,
    لديه_استيرادات: منطقي,
    الاعتمادات: &متجه متجه ط8,
    مسارات_التشغيل: &متجه متجه ط8,
    مسار_المحمل: &متجه ط8,
    مكتبة_مشتركة: منطقي,
    اسم_المكتبة: &متجه ط8
): طبيعي {
    دع الحجم: متغير طبيعي = 0;
    إذا (!مكتبة_مشتركة) { الحجم := الحجم + 72; };
    الحجم := الحجم + 72 + عدد_أقسام_النص * 80;
    الحجم := الحجم + 72 + عدد_أقسام_البيانات * 80;
    إذا (عدد_أقسام_دوارف > 0) {
        الحجم := الحجم + 72 + عدد_أقسام_دوارف * 80;
    };
    الحجم := الحجم + 72;
    الحجم := الحجم + 48;
    الحجم := الحجم + 24;
    الحجم := الحجم + 80;
    إذا (مكتبة_مشتركة) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(24, اسم_المكتبة);
    } وإلا {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(12, مسار_المحمل);
    };
    دع فهرس_الاعتماد: متغير طبيعي = 0;
    طالما (فهرس_الاعتماد < (الطول(*الاعتمادات) مثل طبيعي)) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(
            24,
            &(*الاعتمادات)[فهرس_الاعتماد]
        );
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    دع فهرس_المسار: متغير طبيعي = 0;
    طالما (فهرس_المسار < (الطول(*مسارات_التشغيل) مثل طبيعي)) {
        الحجم := الحجم + حجم_أمر_مسار_ماتشو(
            12,
            &(*مسارات_التشغيل)[فهرس_المسار]
        );
        فهرس_المسار := فهرس_المسار + 1;
    }
    إذا (!مكتبة_مشتركة) { الحجم := الحجم + 24; };
    // Every final Mach-O image carries one deterministic LC_UUID command.
    الحجم := الحجم + 24;
    الحجم := الحجم + 32;
    الحجم := الحجم + 16;
    إذا (!لديه_استيرادات) {
        // The command set is intentionally stable without imports.
    };
    أرجع الحجم;
}

عرف عدد_أوامر_تحميل_ماتشو_صورة(
    عدد_أقسام_دوارف: طبيعي,
    الاعتمادات: &متجه متجه ط8,
    مسارات_التشغيل: &متجه متجه ط8,
    مكتبة_مشتركة: منطقي
): طبيعي {
    // The base command set includes LC_UUID for every final Mach-O image.
    دع العدد: متغير طبيعي = 10;
    إذا (!مكتبة_مشتركة) { العدد := العدد + 2; };
    إذا (عدد_أقسام_دوارف > 0) { العدد := العدد + 1; };
    العدد := العدد + (الطول(*الاعتمادات) مثل طبيعي);
    العدد := العدد + (الطول(*مسارات_التشغيل) مثل طبيعي);
    أرجع العدد;
}

// Emit dyld rebase opcodes for ordinary internal absolute pointers. An
// image-local symbol's link-time address is not its final address under ASLR.
// The relocation applier writes the unslid pointer; dyld adds the load slide.
// Only pointer-sized absolute fields in __DATA can be rebound this way.
عرف ابن_إعادة_أساس_ماتشو(
    السياق: &سياق_ربط,
    مكتبة_مشتركة: منطقي,
    قاعدة_الصورة: طبيعي,
    بداية_مقطع_البيانات: طبيعي
): اختياري متجه ط8 {
    دع التخطيط: تخطيط_خرج_ربط;
    طابق (*السياق).التخطيط مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { التخطيط := القيمة; };
    دع الناتج: متغير متجه ط8 = [];
    دع أضيف_نوع: متغير منطقي = خطأ;
    دع ترتيب_المقطع: طبيعي;
    إذا (مكتبة_مشتركة) { ترتيب_المقطع := 1; }
    وإلا { ترتيب_المقطع := 2; };
    دع قاعدة_البيانات: طبيعي = قاعدة_الصورة + بداية_مقطع_البيانات;
    إذا (قاعدة_البيانات < قاعدة_الصورة) { أرجع اختياري.لا_شيء(); };
    دع فهرس_الإزاحة: متغير طبيعي = 0;
    طالما (فهرس_الإزاحة < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[فهرس_الإزاحة];
        دع نوع_الإزاحة: طبيعي = (*الحافة).رمز_صيغة / 16;
        دع أس_العرض: طبيعي = ((*الحافة).رمز_صيغة / 2) & 3;
        دع العرض: طبيعي = 1 << أس_العرض;
        // Discarded input sections have no output location and no fixups.
        // The canonical relocation applier skips these sections as well.
        طابق ابحث_موضع_قسم_خرج_ربط(
            &التخطيط, (*الحافة).القسم
        ) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> {
            إذا (نوع_الإزاحة == 0
                && !تابع_زوج_طرح_ماتشو(السياق, فهرس_الإزاحة)) {
                طابق حل_عنوان_داخلي_ماتشو(
                    السياق, &(*الحافة).المرجع, (*الحافة).إضافة
                ) مع
                | نتيجة_حل_عنوان_ربط.نجح(_) -> {
                    دع القسم: قسم_ربط;
                    طابق ابحث_قسم_ربط_بالمعرف(السياق, (*الحافة).القسم) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> { القسم := القيمة; };
                    // Debug sections are not loaded and never participate in
                    // dyld rebasing. Only mapped image sections are candidates.
                    إذا (!قسم_ماتشو_في_مقطع_دوارف(&القسم)) {
                        // Absolute references in __TEXT would require text fixups;
                        // this writer only supports writable segment rebasing.
                        إذا (!قسم_ماتشو_في_مقطع_بيانات(&القسم)
                            || العرض != 8 || ((*الحافة).الإزاحة % 8) != 0) {
                            أرجع اختياري.لا_شيء();
                        };
                        إذا ((*الحافة).الإزاحة > الموضع.حجم_الذاكرة
                            || 8 > الموضع.حجم_الذاكرة - (*الحافة).الإزاحة) {
                            أرجع اختياري.لا_شيء();
                        };
                        دع عنوان_الرقعة: طبيعي;
                        طابق الموضع.العنوان_الافتراضي مع
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                        | اختياري.موجود(العنوان) -> {
                            إذا ((*الحافة).الإزاحة > 0xFFFFFFFFFFFFFFFF - العنوان) {
                                أرجع اختياري.لا_شيء();
                            };
                            عنوان_الرقعة := العنوان + (*الحافة).الإزاحة;
                        };
                        إذا (عنوان_الرقعة < قاعدة_البيانات
                            || ترتيب_المقطع > 15) {
                            أرجع اختياري.لا_شيء();
                        };
                        إذا (!أضيف_نوع) {
                            // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER.
                            ألحق_بايت_ماتشو(&متغير الناتج, 0x11);
                            أضيف_نوع := صواب;
                        };
                        // Each address is absolute within the actual __DATA segment;
                        // emitting a fresh segment offset avoids order assumptions.
                        ألحق_بايت_ماتشو(&متغير الناتج, 0x20 | ترتيب_المقطع);
                        ألحق_يو_ليب_ماتشو(
                            &متغير الناتج, عنوان_الرقعة - قاعدة_البيانات
                        );
                        ألحق_بايت_ماتشو(&متغير الناتج, 0x51);
                    };
                }
                | _ -> { };
            };
        };
        فهرس_الإزاحة := فهرس_الإزاحة + 1;
    }
    إذا (أضيف_نوع) { ألحق_بايت_ماتشو(&متغير الناتج, 0); };
    أرجع اختياري.موجود(الناتج);
}

عرف ابن_صورة_ماتشو_داروين(
    السياق: &متغير سياق_ربط,
    مكتبة_مشتركة: منطقي
): نتيجة_صورة_ماتشو_تنفيذية {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> { }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
    | _ -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };
    طابق (*السياق).الهدف.المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> { }
    | _ -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    };

    دع اسم_المكتبة: متغير متجه ط8 = [];
    إذا (مكتبة_مشتركة) {
        طابق (*السياق).الخطة.اسم_المخرج_الديناميكي مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختياري.موجود(الاسم) -> { اسم_المكتبة := انسخ_بايتات(&الاسم); };
    };

    دع أقسام_النص: متجه معرف_قسم_ربط = اجمع_أقسام_ماتشو_الحية(
        السياق,
        0
    );
    دع أقسام_البيانات: متجه معرف_قسم_ربط =
        اجمع_أقسام_ماتشو_الحية(السياق, 1);
    دع أقسام_البيانات_الملفوفة: متجه معرف_قسم_ربط =
        رشح_أقسام_بيانات_ماتشو(السياق, &أقسام_البيانات, خطأ);
    دع أقسام_البيانات_الصفرية: متجه معرف_قسم_ربط =
        رشح_أقسام_بيانات_ماتشو(السياق, &أقسام_البيانات, صواب);
    دع أقسام_دوارف: متجه معرف_قسم_ربط = اجمع_أقسام_ماتشو_الحية(
        السياق,
        2
    );
    دع الرموز_الديناميكية: متغير متجه رمز_ديناميكي_ماتشو_ربط =
        اجمع_رموز_ماتشو_الديناميكية(السياق, مكتبة_مشتركة);
    دع عدد_الرموز_الديناميكية: طبيعي =
        الطول(الرموز_الديناميكية) مثل طبيعي;
    دع عدد_رموز_الاستيراد: طبيعي =
        عدد_رموز_استيراد_ماتشو(&الرموز_الديناميكية);
    دع لديه_رموز_ديناميكية: منطقي = عدد_رموز_الاستيراد > 0;
    دع الاعتمادات: متجه متجه ط8 = ابن_اعتمادات_ماتشو(السياق);
    دع مسارات_التشغيل: متجه متجه ط8 = ابن_مسارات_تشغيل_ماتشو(السياق);
    دع مسار_المحمل: متجه ط8 = مسار_محمل_داروين_ماتشو();

    دع عدد_أقسام_النص: متغير طبيعي = الطول(أقسام_النص) مثل طبيعي;
    دع عدد_أقسام_البيانات: متغير طبيعي =
        الطول(أقسام_البيانات) مثل طبيعي;
    إذا (لديه_رموز_ديناميكية) {
        عدد_أقسام_النص := عدد_أقسام_النص + 1;
        عدد_أقسام_البيانات := عدد_أقسام_البيانات + 1;
    };
    دع عدد_أقسام_دوارف: طبيعي = الطول(أقسام_دوارف) مثل طبيعي;
    دع حجم_أوامر_التحميل: طبيعي = حجم_أوامر_تحميل_ماتشو_صورة(
        عدد_أقسام_النص,
        عدد_أقسام_البيانات,
        عدد_أقسام_دوارف,
        لديه_رموز_ديناميكية,
        &الاعتمادات,
        &مسارات_التشغيل,
        &مسار_المحمل,
        مكتبة_مشتركة,
        &اسم_المكتبة
    );
    دع عدد_أوامر_التحميل: طبيعي = عدد_أوامر_تحميل_ماتشو_صورة(
        عدد_أقسام_دوارف,
        &الاعتمادات,
        &مسارات_التشغيل,
        مكتبة_مشتركة
    );

    دع قاعدة_الصورة: متغير طبيعي = 0x100000000;
    إذا (مكتبة_مشتركة) { قاعدة_الصورة := 0; };
    دع حجم_صفحة_ماتشو: طبيعي;
    طابق حجم_صفحة_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { حجم_صفحة_ماتشو := القيمة; };
    دع حجم_الستب_ماتشو: طبيعي;
    طابق حجم_ستب_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { حجم_الستب_ماتشو := القيمة; };
    دع بداية_محتوى_النص: طبيعي = حاذ_قيمة_ماتشو(
        32 + حجم_أوامر_التحميل,
        16
    );
    دع التخطيط: متغير تخطيط_خرج_ربط = أنشئ_تخطيط_خرج_ربط();
    دع مجموعة_النص: مجموعة_أقسام_ماتشو_ربط = ضع_مجموعة_أقسام_ماتشو(
        السياق,
        &متغير التخطيط,
        &أقسام_النص,
        بداية_محتوى_النص,
        قاعدة_الصورة + بداية_محتوى_النص,
        خطأ
    );
    دع بداية_الستبات: طبيعي = حاذ_قيمة_ماتشو(
        مجموعة_النص.نهاية_الملف,
        4
    );
    دع حجم_الستبات: طبيعي = عدد_رموز_الاستيراد * حجم_الستب_ماتشو;
    دع نهاية_بايتات_النص: طبيعي = بداية_الستبات + حجم_الستبات;
    دع نهاية_مقطع_النص: طبيعي = حاذ_قيمة_ماتشو(
        نهاية_بايتات_النص,
        حجم_صفحة_ماتشو
    );

    دع بداية_مقطع_البيانات: طبيعي = نهاية_مقطع_النص;
    دع مجموعة_البيانات_الملفوفة: مجموعة_أقسام_ماتشو_ربط =
        ضع_مجموعة_أقسام_ماتشو(
            السياق,
            &متغير التخطيط,
            &أقسام_البيانات_الملفوفة,
            بداية_مقطع_البيانات,
            قاعدة_الصورة + بداية_مقطع_البيانات,
            خطأ
        );
    دع بداية_جوت: طبيعي = حاذ_قيمة_ماتشو(
        مجموعة_البيانات_الملفوفة.نهاية_الملف,
        8
    );
    دع حجم_جوت: طبيعي = عدد_رموز_الاستيراد * 8;
    دع نهاية_جوت: طبيعي = بداية_جوت + حجم_جوت;
    دع مجموعة_البيانات_الصفرية: مجموعة_أقسام_ماتشو_ربط =
        ضع_مجموعة_أقسام_ماتشو(
            السياق,
            &متغير التخطيط,
            &أقسام_البيانات_الصفرية,
            نهاية_جوت,
            قاعدة_الصورة + نهاية_جوت,
            صواب
        );
    دع نهاية_ذاكرة_البيانات: طبيعي =
        مجموعة_البيانات_الصفرية.نهاية_الذاكرة;
    دع نهاية_ملف_البيانات: طبيعي = نهاية_جوت;

    دع بداية_ملف_دوارف: طبيعي = حاذ_قيمة_ماتشو(
        نهاية_ملف_البيانات,
        حجم_صفحة_ماتشو
    );
    دع بداية_ذاكرة_دوارف: طبيعي = حاذ_قيمة_ماتشو(
        نهاية_ذاكرة_البيانات,
        حجم_صفحة_ماتشو
    );
    دع مجموعة_دوارف: مجموعة_أقسام_ماتشو_ربط = ضع_مجموعة_أقسام_ماتشو(
        السياق,
        &متغير التخطيط,
        &أقسام_دوارف,
        بداية_ملف_دوارف,
        بداية_ذاكرة_دوارف,
        خطأ
    );
    دع نهاية_ملف_دوارف: طبيعي = مجموعة_دوارف.نهاية_الملف;
    دع نهاية_ذاكرة_دوارف: طبيعي = مجموعة_دوارف.نهاية_الذاكرة;
    دع بداية_ملف_لينك: طبيعي = حاذ_قيمة_ماتشو(
        نهاية_ملف_دوارف,
        حجم_صفحة_ماتشو
    );
    دع بداية_ذاكرة_لينك: طبيعي = حاذ_قيمة_ماتشو(
        نهاية_ذاكرة_دوارف,
        حجم_صفحة_ماتشو
    );

    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
    دع إزاحة_الدخول: متغير طبيعي = 0;
    إذا (!مكتبة_مشتركة) {
        طابق حل_إزاحة_دخول_ماتشو(السياق, قاعدة_الصورة) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.رمز_دخول_مفقود()
            );
        }
        | اختياري.موجود(القيمة) -> { إزاحة_الدخول := القيمة; };
    };

    دع عنوان_الستبات: طبيعي = قاعدة_الصورة + بداية_الستبات;
    دع عنوان_جوت: طبيعي = قاعدة_الصورة + بداية_جوت;
    دع الستبات: متجه ط8;
    طابق ابن_ستبات_ماتشو(
        &(*السياق).الهدف,
        عدد_رموز_الاستيراد,
        عنوان_الستبات,
        عنوان_جوت
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.إزاحة_خارج_النطاق()
        );
    }
    | اختياري.موجود(القيمة) -> { الستبات := القيمة; };

    دع سجلات_الربط: متغير متجه سجل_ربط_ديناميكي_ماتشو = [];
    دع ترتيب_مقطع_البيانات: متغير طبيعي = 2;
    إذا (مكتبة_مشتركة) { ترتيب_مقطع_البيانات := 1; };
    أضف_سجلات_جوت_ماتشو(
        &الرموز_الديناميكية,
        عدد_رموز_الاستيراد,
        &متغير سجلات_الربط,
        ترتيب_مقطع_البيانات,
        بداية_جوت - بداية_مقطع_البيانات
    );
    إذا (!أضف_سجلات_ربط_مباشرة_ماتشو(
        السياق,
        &متغير سجلات_الربط,
        مكتبة_مشتركة,
        قاعدة_الصورة,
        بداية_مقطع_البيانات
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
        );
    };
    دع ربط_ديناميكي: متجه ط8;
    طابق ابن_ربط_ديناميكي_ماتشو(
        &الرموز_الديناميكية,
        &سجلات_الربط
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.رمز_خارجي_غير_محلول()
        );
    }
    | اختياري.موجود(القيمة) -> { ربط_ديناميكي := القيمة; };
    دع شجرة_التصدير: متغير متجه ط8 = [];
    إذا (مكتبة_مشتركة) {
        طابق ابن_شجرة_تصدير_ماتشو(
            السياق,
            &الرموز_الديناميكية,
            قاعدة_الصورة
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        }
        | اختياري.موجود(القيمة) -> { شجرة_التصدير := القيمة; };
    };
    دع جدول_النصوص: متجه ط8 = ابن_جدول_نصوص_ماتشو(
        &متغير الرموز_الديناميكية
    );
    دع جدول_الرموز: متجه ط8;
    طابق ابن_جدول_رموز_ماتشو(
        السياق,
        &الرموز_الديناميكية,
        &أقسام_النص,
        &أقسام_البيانات_الملفوفة,
        &أقسام_البيانات_الصفرية,
        &أقسام_دوارف,
        لديه_رموز_ديناميكية
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { جدول_الرموز := القيمة; };
    دع جدول_غير_مباشر: متجه ط8 = ابن_جدول_رموز_غير_مباشرة_ماتشو(
        عدد_رموز_الاستيراد
    );

    دع إعادة_الأساس: متجه ط8;
    طابق ابن_إعادة_أساس_ماتشو(
        السياق, مكتبة_مشتركة, قاعدة_الصورة, بداية_مقطع_البيانات
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.إزاحة_غير_مدعومة()
        );
    }
    | اختياري.موجود(القيمة) -> { إعادة_الأساس := القيمة; };
    دع موضع_إعادة_الأساس: طبيعي = بداية_ملف_لينك;
    دع حجم_إعادة_الأساس: طبيعي = الطول(إعادة_الأساس) مثل طبيعي;
    // LC_DYLD_INFO_ONLY encodes both ranges with 32-bit file offsets.
    إذا (موضع_إعادة_الأساس > 0xFFFFFFFF
        || حجم_إعادة_الأساس > 0xFFFFFFFF - موضع_إعادة_الأساس) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    دع موضع_الربط: طبيعي =
        موضع_إعادة_الأساس + حجم_إعادة_الأساس;
    دع موضع_التصدير: طبيعي =
        موضع_الربط + (الطول(ربط_ديناميكي) مثل طبيعي);
    دع موضع_التصدير_في_الأمر: متغير طبيعي = 0;
    إذا ((الطول(شجرة_التصدير) مثل طبيعي) > 0) {
        موضع_التصدير_في_الأمر := موضع_التصدير;
    };
    دع موضع_الرموز: طبيعي = حاذ_قيمة_ماتشو(
        موضع_التصدير + (الطول(شجرة_التصدير) مثل طبيعي),
        8
    );
    دع موضع_الرموز_غير_المباشرة: طبيعي = حاذ_قيمة_ماتشو(
        موضع_الرموز + (الطول(جدول_الرموز) مثل طبيعي),
        4
    );
    دع موضع_النصوص: طبيعي = موضع_الرموز_غير_المباشرة
        + (الطول(جدول_غير_مباشر) مثل طبيعي);
    دع موضع_التوقيع: طبيعي = حاذ_قيمة_ماتشو(
        موضع_النصوص + (الطول(جدول_النصوص) مثل طبيعي),
        16
    );

    دع الصورة: متغير متجه ط8 = [];
    دع أعلام_الرأس: متغير طبيعي = 0x200004;
    إذا (مكتبة_مشتركة) { أعلام_الرأس := 0x84; };
    إذا (!لديه_رموز_ديناميكية) {
        أعلام_الرأس := أعلام_الرأس | 1;
    };
    دع نوع_المعالج: طبيعي;
    طابق نوع_معالج_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { نوع_المعالج := القيمة; };
    دع نوع_المعالج_الفرعي: طبيعي;
    طابق نوع_معالج_فرعي_ماتشو_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { نوع_المعالج_الفرعي := القيمة; };
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0xFEEDFACF);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, نوع_المعالج);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, نوع_المعالج_الفرعي);
    إذا (مكتبة_مشتركة) {
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 6);
    } وإلا {
        ألحق_ط32_ماتشو_ربط(&متغير الصورة, 2);
    };
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, عدد_أوامر_التحميل);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, حجم_أوامر_التحميل);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, أعلام_الرأس);
    ألحق_ط32_ماتشو_ربط(&متغير الصورة, 0);

    دع اسم_صفحة_صفر: متجه ط8 = اسم_مقطع_صفحة_صفر_ماتشو();
    دع اسم_مقطع_النص: متجه ط8 = اسم_مقطع_نص_ماتشو();
    دع اسم_مقطع_البيانات: متجه ط8 = اسم_مقطع_بيانات_ماتشو();
    دع اسم_مقطع_دوارف: متجه ط8 = اسم_حاوية_دوارف_ماتشو();
    دع اسم_مقطع_لينك: متجه ط8 = اسم_مقطع_لينك_ماتشو();
    إذا (!مكتبة_مشتركة) {
            إذا (!ألحق_أمر_مقطع_ماتشو(
                &متغير الصورة,
                &اسم_صفحة_صفر,
                0,
                قاعدة_الصورة,
                0,
                0,
                0,
                0,
                0
            )) {
                أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                    خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
                );
