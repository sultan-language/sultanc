        السياق,
        &التخطيط,
        &أقسام_النص
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (لديه_رموز_ديناميكية) {
        إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_الستبات)) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_بايتات_ماتشو(&متغير الصورة, &الستبات);
    };
    إذا (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_البيانات_الملفوفة
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (لديه_رموز_ديناميكية) {
        إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, بداية_جوت)) {
            أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
                خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
            );
        };
        ألحق_أصفارا_ماتشو(&متغير الصورة, حجم_جوت);
    };
    إذا (!انسخ_مجموعة_أقسام_ماتشو_الملفوفة(
        &متغير الصورة,
        السياق,
        &التخطيط,
        &أقسام_دوارف
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_إعادة_الأساس)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &إعادة_الأساس);
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_الربط)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &ربط_ديناميكي);
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_التصدير)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &شجرة_التصدير);
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_الرموز)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_الرموز);
    إذا (!أكمل_ماتشو_إلى_موضع(
        &متغير الصورة,
        موضع_الرموز_غير_المباشرة
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_غير_مباشر);
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_النصوص)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &جدول_النصوص);
    إذا (!أكمل_ماتشو_إلى_موضع(&متغير الصورة, موضع_التوقيع)) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    طابق طبق_إزاحات_ماتشو(
        السياق,
        &متغير الصورة,
        &الرموز_الديناميكية,
        عنوان_الستبات,
        عنوان_جوت
    ) مع
    | نتيجة_تطبيق_إزاحات_ماتشو.نجح -> { }
    | نتيجة_تطبيق_إزاحات_ماتشو.خطأ(الخطأ) -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(الخطأ);
    };

    دع توقيع_تمهيدي: متجه ط8;
    طابق ابن_توقيع_أدهوك_ماتشو(
        &الصورة,
        0,
        نهاية_مقطع_النص
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    }
    | اختياري.موجود(القيمة) -> { توقيع_تمهيدي := القيمة; };
    دع حجم_التوقيع: طبيعي = الطول(توقيع_تمهيدي) مثل طبيعي;
    إذا (!اكتب_ط32_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_التوقيع + 12,
        حجم_التوقيع
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    };
    دع نهاية_ملف_لينك: طبيعي = موضع_التوقيع + حجم_التوقيع;
    دع حجم_ملف_لينك: طبيعي = نهاية_ملف_لينك - بداية_ملف_لينك;
    دع حجم_ذاكرة_لينك: طبيعي = حاذ_قيمة_ماتشو(
        حجم_ملف_لينك,
        حجم_صفحة_ماتشو
    );
    إذا (!اكتب_ط64_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_لينك + 32,
        حجم_ذاكرة_لينك
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    إذا (!اكتب_ط64_ماتشو_ربط_في(
        &متغير الصورة,
        موضع_أمر_لينك + 48,
        حجم_ملف_لينك
    )) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };

    // Derive the Mach-O UUID from the final pre-signature bytes while the UUID
    // payload is still zero. The code signature must be generated afterwards
    // because it covers the header containing this identifier.
    دع هاش_المعرف_الفريد: متجه ط8;
    طابق شا256_لمدى(
        &الصورة,
        0,
        الطول(الصورة) مثل طبيعي
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { هاش_المعرف_الفريد := القيمة; };
    دع فهرس_المعرف_الفريد: متغير طبيعي = 0;
    طالما (فهرس_المعرف_الفريد < 16) {
        دع بايت_المعرف: متغير ط8 =
            هاش_المعرف_الفريد[فهرس_المعرف_الفريد];
        إذا (فهرس_المعرف_الفريد == 6) {
            دع قيمة_بايت_الإصدار: طبيعي =
                (بايت_المعرف مثل طبيعي) & 0x0F;
            بايت_المعرف := (قيمة_بايت_الإصدار | 0x40) مثل ط8;
        };
        إذا (فهرس_المعرف_الفريد == 8) {
            دع قيمة_بايت_النسق: طبيعي =
                (بايت_المعرف مثل طبيعي) & 0x3F;
            بايت_المعرف := (قيمة_بايت_النسق | 0x80) مثل ط8;
        };
        دع موضع_بايت_المعرف: طبيعي =
            موضع_أمر_المعرف_الفريد + 8 + فهرس_المعرف_الفريد;
        الصورة[موضع_بايت_المعرف] := بايت_المعرف;
        فهرس_المعرف_الفريد := فهرس_المعرف_الفريد + 1;
    }

    دع التوقيع: متجه ط8;
    طابق ابن_توقيع_أدهوك_ماتشو(
        &الصورة,
        0,
        نهاية_مقطع_النص
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    }
    | اختياري.موجود(القيمة) -> { التوقيع := القيمة; };
    إذا ((الطول(التوقيع) مثل طبيعي) != حجم_التوقيع) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.توقيع_فشل()
        );
    };
    ألحق_بايتات_ماتشو(&متغير الصورة, &التوقيع);
    إذا ((الطول(الصورة) مثل طبيعي) != نهاية_ملف_لينك) {
        أرجع نتيجة_صورة_ماتشو_تنفيذية.خطأ(
            خطأ_صورة_ماتشو_تنفيذية.تخطيط_غير_صالح()
        );
    };
    أرجع نتيجة_صورة_ماتشو_تنفيذية.نجح(الصورة);
}


عام عرف ابن_صورة_ماتشو_داروين_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_ماتشو_تنفيذية {
    أرجع ابن_صورة_ماتشو_داروين(السياق, خطأ);
}

عام عرف ابن_صورة_ماتشو_داروين_مشتركة(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_ماتشو_تنفيذية {
    أرجع ابن_صورة_ماتشو_داروين(السياق, صواب);
}
