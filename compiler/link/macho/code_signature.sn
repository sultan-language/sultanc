استورد compiler.link.macho.encoding;
استورد std.text.from_bytes;
استورد std.crypto.sha256;

// Modern Darwin kernels expect an executable CodeDirectory carrying exec-segment
// facts. This is an ad-hoc signature: one SHA-256 CodeDirectory in one SuperBlob.
عام عرف ابن_توقيع_أدهوك_ماتشو(
    الصورة: &متجه ط8,
    بداية_المقطع_التنفيذي: طبيعي,
    حجم_المقطع_التنفيذي: طبيعي
): اختياري متجه ط8 {
    دع حد_الكود: طبيعي = الطول(*الصورة) مثل طبيعي;
    إذا (حد_الكود > 0xFFFFFFFF) { أرجع اختياري.لا_شيء(); };
    دع حجم_صفحة_التوقيع: طبيعي = 4096;
    دع عدد_صفحات_الكود: طبيعي =
        (حد_الكود + حجم_صفحة_التوقيع - 1) / حجم_صفحة_التوقيع;
    دع المعرف: متجه ط8 = بايتات_منتهية_بصفر_من_نص(«sultanc»);
    دع موضع_المعرف: طبيعي = 88;
    دع موضع_الهاش: طبيعي =
        موضع_المعرف + (الطول(المعرف) مثل طبيعي);
    دع حجم_دليل_الكود: طبيعي =
        موضع_الهاش + عدد_صفحات_الكود * 32;
    دع الحجم_الكلي: طبيعي = 20 + حجم_دليل_الكود;
    إذا (الحجم_الكلي > 0xFFFFFFFF) { أرجع اختياري.لا_شيء(); };

    دع الناتج: متغير متجه ط8 = [];
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0xFADE0CC0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, الحجم_الكلي);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 20);

    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0xFADE0C02);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, حجم_دليل_الكود);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0x00020400);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0x00000002);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, موضع_الهاش);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, موضع_المعرف);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, عدد_صفحات_الكود);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, حد_الكود);
    ألحق_بايت_ماتشو(&متغير الناتج, 32);
    ألحق_بايت_ماتشو(&متغير الناتج, 2);
    ألحق_بايت_ماتشو(&متغير الناتج, 0);
    ألحق_بايت_ماتشو(&متغير الناتج, 12);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط64_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_ط64_ماتشو_كبير(
        &متغير الناتج,
        بداية_المقطع_التنفيذي
    );
    ألحق_ط64_ماتشو_كبير(
        &متغير الناتج,
        حجم_المقطع_التنفيذي
    );
    ألحق_ط64_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_بايتات_ماتشو(&متغير الناتج, &المعرف);

    دع فهرس_الصفحة: متغير طبيعي = 0;
    طالما (فهرس_الصفحة < عدد_صفحات_الكود) {
        دع بداية_الصفحة: طبيعي =
            فهرس_الصفحة * حجم_صفحة_التوقيع;
        دع الحجم_المتبقي: طبيعي = حد_الكود - بداية_الصفحة;
        دع حجم_الصفحة: متغير طبيعي = حجم_صفحة_التوقيع;
        إذا (الحجم_المتبقي < حجم_الصفحة) {
            حجم_الصفحة := الحجم_المتبقي;
        };
        طابق شا256_لمدى(
            الصورة,
            بداية_الصفحة,
            حجم_الصفحة
        ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(هاش_الصفحة) -> {
            ألحق_بايتات_ماتشو(&متغير الناتج, &هاش_الصفحة);
        };
        فهرس_الصفحة := فهرس_الصفحة + 1;
    }
    أرجع اختياري.موجود(الناتج);
}
