استورد compiler.link.macho.encoding;
استورد std.text.from_bytes;
استورد std.crypto.sha256;

// Modern Darwin kernels expect an executable CodeDirectory carrying exec-segment
// facts. This is an ad-hoc signature: one SHA-256 CodeDirectory in one SuperBlob.
عام عرف ابن_توقيع_أدهوك_ماتشو(
    الصورة: &متجه غ8,
    بداية_المقطع_التنفيذي: غير_موقع,
    حجم_المقطع_التنفيذي: غير_موقع
): اختيار متجه غ8 {
    دع حد_الكود: غير_موقع = الطول(*الصورة) مثل غير_موقع;
    لو (حد_الكود > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع حجم_صفحة_التوقيع: غير_موقع = 4096;
    دع عدد_صفحات_الكود: غير_موقع =
        (حد_الكود + حجم_صفحة_التوقيع - 1) / حجم_صفحة_التوقيع;
    دع المعرف: متجه غ8 = بايتات_منتهية_بصفر_من_نص(«sultanc»);
    دع موضع_المعرف: غير_موقع = 88;
    دع موضع_الهاش: غير_موقع =
        موضع_المعرف + (الطول(المعرف) مثل غير_موقع);
    دع حجم_دليل_الكود: غير_موقع =
        موضع_الهاش + عدد_صفحات_الكود * 32;
    دع الحجم_الكلي: غير_موقع = 20 + حجم_دليل_الكود;
    لو (الحجم_الكلي > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };

    دع الناتج: متغير متجه غ8 = [];
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0xFADE0CC0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, الحجم_الكلي);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 20);

    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0xFADE0C02);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, حجم_دليل_الكود);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0x00020400);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0x00000002);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, موضع_الهاش);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, موضع_المعرف);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, عدد_صفحات_الكود);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, حد_الكود);
    ألحق_بايت_ماتشو(&متغير الناتج, 32);
    ألحق_بايت_ماتشو(&متغير الناتج, 2);
    ألحق_بايت_ماتشو(&متغير الناتج, 0);
    ألحق_بايت_ماتشو(&متغير الناتج, 12);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ64_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ64_ماتشو_كبير(
        &متغير الناتج,
        بداية_المقطع_التنفيذي
    );
    ألحق_غ64_ماتشو_كبير(
        &متغير الناتج,
        حجم_المقطع_التنفيذي
    );
    ألحق_غ64_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_بايتات_ماتشو(&متغير الناتج, &المعرف);

    دع فهرس_الصفحة: متغير غير_موقع = 0;
    بينما (فهرس_الصفحة < عدد_صفحات_الكود) {
        دع بداية_الصفحة: غير_موقع =
            فهرس_الصفحة * حجم_صفحة_التوقيع;
        دع الحجم_المتبقي: غير_موقع = حد_الكود - بداية_الصفحة;
        دع حجم_الصفحة: متغير غير_موقع = حجم_صفحة_التوقيع;
        لو (الحجم_المتبقي < حجم_الصفحة) {
            حجم_الصفحة := الحجم_المتبقي;
        };
        طابق شا256_لمدى(
            الصورة,
            بداية_الصفحة,
            حجم_الصفحة
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(هاش_الصفحة) -> {
            ألحق_بايتات_ماتشو(&متغير الناتج, &هاش_الصفحة);
        };
        فهرس_الصفحة := فهرس_الصفحة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}
