استورد compiler.link.macho.encoding;

عرف دوران_يمين_غ32_توقيع_ماتشو(
    القيمة: غير_موقع,
    المقدار: غير_موقع
): غير_موقع {
    دع القيمة_المقيدة: غير_موقع = القيمة % 4294967296;
    دع المقدار_المقيد: غير_موقع = المقدار % 32;
    لو (المقدار_المقيد == 0) { أرجع القيمة_المقيدة; };
    دع الجزء_الأيمن: غير_موقع = القيمة_المقيدة >> المقدار_المقيد;
    دع مقدار_اليسار: غير_موقع = 32 - المقدار_المقيد;
    دع الجزء_الأيسر: غير_موقع =
        (القيمة_المقيدة << مقدار_اليسار) % 4294967296;
    أرجع (الجزء_الأيمن | الجزء_الأيسر) % 4294967296;
}

عرف جمع_غ32_توقيع_ماتشو(
    القيمة_الأولى: غير_موقع,
    القيمة_الثانية: غير_موقع
): غير_موقع {
    أرجع (القيمة_الأولى + القيمة_الثانية) % 4294967296;
}

عام عرف هاش_شا256_ماتشو(
    المصدر: &متجه غ8,
    البداية: غير_موقع,
    الحجم: غير_موقع
): اختيار متجه غ8 {
    دع حجم_المصدر: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو (البداية > حجم_المصدر || الحجم > حجم_المصدر - البداية) {
        أرجع اختيار.لا_شيء();
    };

    دع الرسالة: متغير متجه غ8 = [];
    دع فهرس_المصدر: متغير غير_موقع = 0;
    بينما (فهرس_المصدر < الحجم) {
        دع موضع_المصدر: غير_موقع = البداية + فهرس_المصدر;
        ألحق(الرسالة, (*المصدر)[موضع_المصدر]);
        فهرس_المصدر := فهرس_المصدر + 1;
    }
    ألحق(الرسالة, 0x80 مثل غ8);
    بينما (((الطول(الرسالة) مثل غير_موقع) % 64) != 56) {
        ألحق(الرسالة, 0 مثل غ8);
    }
    دع طول_البتات: غير_موقع = الحجم * 8;
    دع فهرس_طول_البتات: متغير غير_موقع = 0;
    بينما (فهرس_طول_البتات < 8) {
        دع إزاحة_البايت: غير_موقع = 7 - فهرس_طول_البتات;
        دع القاسم: متغير غير_موقع = 1;
        دع فهرس_القاسم: متغير غير_موقع = 0;
        بينما (فهرس_القاسم < إزاحة_البايت) {
            القاسم := القاسم * 256;
            فهرس_القاسم := فهرس_القاسم + 1;
        }
        ألحق(
            الرسالة,
            ((طول_البتات / القاسم) % 256) مثل غ8
        );
        فهرس_طول_البتات := فهرس_طول_البتات + 1;
    }

    دع الثوابت: متجه غير_موقع = [
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
        0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
        0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
        0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
        0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
        0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
        0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
        0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
        0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
    ];

    دع الحالة_صفر: متغير غير_موقع = 0x6A09E667;
    دع الحالة_واحد: متغير غير_موقع = 0xBB67AE85;
    دع الحالة_اثنان: متغير غير_موقع = 0x3C6EF372;
    دع الحالة_ثلاثة: متغير غير_موقع = 0xA54FF53A;
    دع الحالة_أربعة: متغير غير_موقع = 0x510E527F;
    دع الحالة_خمسة: متغير غير_موقع = 0x9B05688C;
    دع الحالة_ستة: متغير غير_موقع = 0x1F83D9AB;
    دع الحالة_سبعة: متغير غير_موقع = 0x5BE0CD19;

    دع موضع_الكتلة: متغير غير_موقع = 0;
    بينما (موضع_الكتلة < (الطول(الرسالة) مثل غير_موقع)) {
        دع الكلمات: متغير متجه غير_موقع = [];
        دع فهرس_الكلمة: متغير غير_موقع = 0;
        بينما (فهرس_الكلمة < 64) {
            ألحق(الكلمات, 0);
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }
        فهرس_الكلمة := 0;
        بينما (فهرس_الكلمة < 16) {
            دع موضع_الكلمة: غير_موقع = موضع_الكتلة + فهرس_الكلمة * 4;
            دع البايت_صفر: غير_موقع =
                الرسالة[موضع_الكلمة] مثل غير_موقع;
            دع موضع_البايت_واحد: غير_موقع = موضع_الكلمة + 1;
            دع موضع_البايت_اثنين: غير_موقع = موضع_الكلمة + 2;
            دع موضع_البايت_ثلاثة: غير_موقع = موضع_الكلمة + 3;
            دع البايت_واحد: غير_موقع =
                الرسالة[موضع_البايت_واحد] مثل غير_موقع;
            دع البايت_اثنان: غير_موقع =
                الرسالة[موضع_البايت_اثنين] مثل غير_موقع;
            دع البايت_ثلاثة: غير_موقع =
                الرسالة[موضع_البايت_ثلاثة] مثل غير_موقع;
            الكلمات[فهرس_الكلمة] :=
                البايت_صفر * 16777216
                + البايت_واحد * 65536
                + البايت_اثنان * 256
                + البايت_ثلاثة;
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }
        بينما (فهرس_الكلمة < 64) {
            دع فهرس_قبل_خمسة_عشر: غير_موقع = فهرس_الكلمة - 15;
            دع فهرس_قبل_اثنين: غير_موقع = فهرس_الكلمة - 2;
            دع كلمة_قبل_خمسة_عشر: غير_موقع = الكلمات[فهرس_قبل_خمسة_عشر];
            دع كلمة_قبل_اثنين: غير_موقع = الكلمات[فهرس_قبل_اثنين];
            دع سيغما_صفر: غير_موقع =
                دوران_يمين_غ32_توقيع_ماتشو(كلمة_قبل_خمسة_عشر, 7)
                ^ دوران_يمين_غ32_توقيع_ماتشو(كلمة_قبل_خمسة_عشر, 18)
                ^ (كلمة_قبل_خمسة_عشر >> 3);
            دع سيغما_واحد: غير_موقع =
                دوران_يمين_غ32_توقيع_ماتشو(كلمة_قبل_اثنين, 17)
                ^ دوران_يمين_غ32_توقيع_ماتشو(كلمة_قبل_اثنين, 19)
                ^ (كلمة_قبل_اثنين >> 10);
            دع فهرس_قبل_ستة_عشر: غير_موقع = فهرس_الكلمة - 16;
            دع مجموع_أول: غير_موقع = جمع_غ32_توقيع_ماتشو(
                الكلمات[فهرس_قبل_ستة_عشر],
                سيغما_صفر
            );
            دع فهرس_قبل_سبعة: غير_موقع = فهرس_الكلمة - 7;
            دع مجموع_ثان: غير_موقع = جمع_غ32_توقيع_ماتشو(
                مجموع_أول,
                الكلمات[فهرس_قبل_سبعة]
            );
            الكلمات[فهرس_الكلمة] := جمع_غ32_توقيع_ماتشو(
                مجموع_ثان,
                سيغما_واحد
            );
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }

        دع سجل_ألف: متغير غير_موقع = الحالة_صفر;
        دع سجل_باء: متغير غير_موقع = الحالة_واحد;
        دع سجل_جيم: متغير غير_موقع = الحالة_اثنان;
        دع سجل_دال: متغير غير_موقع = الحالة_ثلاثة;
        دع سجل_هاء: متغير غير_موقع = الحالة_أربعة;
        دع سجل_واو: متغير غير_موقع = الحالة_خمسة;
        دع سجل_زاي: متغير غير_موقع = الحالة_ستة;
        دع سجل_حاء: متغير غير_موقع = الحالة_سبعة;

        دع جولة: متغير غير_موقع = 0;
        بينما (جولة < 64) {
            دع سيغما_هاء: غير_موقع =
                دوران_يمين_غ32_توقيع_ماتشو(سجل_هاء, 6)
                ^ دوران_يمين_غ32_توقيع_ماتشو(سجل_هاء, 11)
                ^ دوران_يمين_غ32_توقيع_ماتشو(سجل_هاء, 25);
            دع الاختيار: غير_موقع =
                (سجل_هاء & سجل_واو)
                ^ ((سجل_هاء ^ 0xFFFFFFFF) & سجل_زاي);
            دع مؤقت_واحد: غير_موقع = جمع_غ32_توقيع_ماتشو(
                جمع_غ32_توقيع_ماتشو(
                    جمع_غ32_توقيع_ماتشو(
                        جمع_غ32_توقيع_ماتشو(سجل_حاء, سيغما_هاء),
                        الاختيار
                    ),
                    الثوابت[جولة]
                ),
                الكلمات[جولة]
            );
            دع سيغما_ألف: غير_موقع =
                دوران_يمين_غ32_توقيع_ماتشو(سجل_ألف, 2)
                ^ دوران_يمين_غ32_توقيع_ماتشو(سجل_ألف, 13)
                ^ دوران_يمين_غ32_توقيع_ماتشو(سجل_ألف, 22);
            دع الغالبية: غير_موقع =
                (سجل_ألف & سجل_باء)
                ^ (سجل_ألف & سجل_جيم)
                ^ (سجل_باء & سجل_جيم);
            دع مؤقت_اثنان: غير_موقع =
                جمع_غ32_توقيع_ماتشو(سيغما_ألف, الغالبية);

            سجل_حاء := سجل_زاي;
            سجل_زاي := سجل_واو;
            سجل_واو := سجل_هاء;
            سجل_هاء := جمع_غ32_توقيع_ماتشو(سجل_دال, مؤقت_واحد);
            سجل_دال := سجل_جيم;
            سجل_جيم := سجل_باء;
            سجل_باء := سجل_ألف;
            سجل_ألف := جمع_غ32_توقيع_ماتشو(مؤقت_واحد, مؤقت_اثنان);
            جولة := جولة + 1;
        }

        الحالة_صفر := جمع_غ32_توقيع_ماتشو(الحالة_صفر, سجل_ألف);
        الحالة_واحد := جمع_غ32_توقيع_ماتشو(الحالة_واحد, سجل_باء);
        الحالة_اثنان := جمع_غ32_توقيع_ماتشو(الحالة_اثنان, سجل_جيم);
        الحالة_ثلاثة := جمع_غ32_توقيع_ماتشو(الحالة_ثلاثة, سجل_دال);
        الحالة_أربعة := جمع_غ32_توقيع_ماتشو(الحالة_أربعة, سجل_هاء);
        الحالة_خمسة := جمع_غ32_توقيع_ماتشو(الحالة_خمسة, سجل_واو);
        الحالة_ستة := جمع_غ32_توقيع_ماتشو(الحالة_ستة, سجل_زاي);
        الحالة_سبعة := جمع_غ32_توقيع_ماتشو(الحالة_سبعة, سجل_حاء);
        موضع_الكتلة := موضع_الكتلة + 64;
    }

    دع الناتج: متغير متجه غ8 = [];
    دع الحالات: متجه غير_موقع = [
        الحالة_صفر,
        الحالة_واحد,
        الحالة_اثنان,
        الحالة_ثلاثة,
        الحالة_أربعة,
        الحالة_خمسة,
        الحالة_ستة,
        الحالة_سبعة
    ];
    دع فهرس_الحالة: متغير غير_موقع = 0;
    بينما (فهرس_الحالة < 8) {
        ألحق_غ32_ماتشو_كبير(
            &متغير الناتج,
            الحالات[فهرس_الحالة]
        );
        فهرس_الحالة := فهرس_الحالة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// Modern Darwin kernels expect an executable CodeDirectory carrying exec-segment
// facts. This is an ad-hoc signature: one SHA-256 CodeDirectory in one SuperBlob.
عام عرف ابن_توقيع_أدهوك_ماتشو(
    الصورة: &متجه غ8,
    بداية_المقطع_التنفيذي: غير_موقع,
    حجم_المقطع_التنفيذي: غير_موقع
): اختيار متجه غ8 {
    دع حد_الكود: غير_موقع = الطول(*الصورة) مثل غير_موقع;
    لو (حد_الكود > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };
    دع حجم_صفحة_التوقيع: غير_موقع = 4096;
    دع عدد_صفحات_الكود: غير_موقع =
        (حد_الكود + حجم_صفحة_التوقيع - 1) / حجم_صفحة_التوقيع;
    دع المعرف: متجه غ8 = [
        0x73, 0x75, 0x6C, 0x74, 0x61, 0x6E, 0x63, 0
    ];
    دع موضع_المعرف: غير_موقع = 88;
    دع موضع_الهاش: غير_موقع =
        موضع_المعرف + (الطول(المعرف) مثل غير_موقع);
    دع حجم_دليل_الكود: غير_موقع =
        موضع_الهاش + عدد_صفحات_الكود * 32;
    دع الحجم_الكلي: غير_موقع = 20 + حجم_دليل_الكود;
    لو (الحجم_الكلي > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };

    دع الناتج: متغير متجه غ8 = [];
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0xFADE0CC0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, الحجم_الكلي);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 20);

    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0xFADE0C02);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, حجم_دليل_الكود);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0x00020400);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0x00000002);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, موضع_الهاش);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, موضع_المعرف);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, عدد_صفحات_الكود);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, حد_الكود);
    ألحق_بايت_ماتشو(&متغير الناتج, 32);
    ألحق_بايت_ماتشو(&متغير الناتج, 2);
    ألحق_بايت_ماتشو(&متغير الناتج, 0);
    ألحق_بايت_ماتشو(&متغير الناتج, 12);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ32_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ64_ماتشو_كبير(&متغير الناتج, 0);
    ألحق_غ64_ماتشو_كبير(
        &متغير الناتج,
        بداية_المقطع_التنفيذي
    );
    ألحق_غ64_ماتشو_كبير(
        &متغير الناتج,
        حجم_المقطع_التنفيذي
    );
    ألحق_غ64_ماتشو_كبير(&متغير الناتج, 1);
    ألحق_بايتات_ماتشو(&متغير الناتج, &المعرف);

    دع فهرس_الصفحة: متغير غير_موقع = 0;
    بينما (فهرس_الصفحة < عدد_صفحات_الكود) {
        دع بداية_الصفحة: غير_موقع =
            فهرس_الصفحة * حجم_صفحة_التوقيع;
        دع الحجم_المتبقي: غير_موقع = حد_الكود - بداية_الصفحة;
        دع حجم_الصفحة: متغير غير_موقع = حجم_صفحة_التوقيع;
        لو (الحجم_المتبقي < حجم_الصفحة) {
            حجم_الصفحة := الحجم_المتبقي;
        };
        طابق هاش_شا256_ماتشو(
            الصورة,
            بداية_الصفحة,
            حجم_الصفحة
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(هاش_الصفحة) -> {
            ألحق_بايتات_ماتشو(&متغير الناتج, &هاش_الصفحة);
        };
        فهرس_الصفحة := فهرس_الصفحة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}
