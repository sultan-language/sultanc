// Text-based dylib stubs (TAPI `.tbd`, the libraries of an Apple SDK such
// as MacOSX.sdk/usr/lib/libSystem.tbd): YAML documents that stand for a
// dylib at link time, as ld64 and lld's Mach-O port read them
// (lld/MachO/InputFiles.cpp DylibFile from an InterfaceFile;
// llvm/TextAPI/TextStub.cpp). A link needs two facts from one: the install
// name the image's LC_LOAD_DYLIB records (the first document's
// `install-name`), and the symbols the dylib exports for the target
// architecture, which the image binds to that dylib.
//
// Read here, line by line, for format versions 1 to 4:
//   * documents start with `---` and end with `...`; every document's
//     exports count, since an SDK stub lists the libraries the first one
//     re-exports (libSystem's libsystem_c, ...) as further documents, and
//     dyld finds their symbols through the first one's install name;
//   * `exports:` and `reexports:` hold entries, each with `targets:`
//     (v4: `arm64-macos`) or `archs:` (v1-v3: `arm64`) and the lists
//     `symbols`, `weak-symbols`, `weak-def-symbols`, `thread-local-symbols`
//     and the Objective-C `objc-classes`, `objc-eh-types` and `objc-ivars`
//     (named _OBJC_CLASS_$_X and _OBJC_METACLASS_$_X, _OBJC_EHTYPE_$_X,
//     _OBJC_IVAR_$_X); a flow list `[ ... ]` may span lines;
//   * an entry applies when its targets name the target's architecture
//     and platform (v4), or its architecture (v1-v3).
// Other keys (versions, flags, allowable clients, undefineds, UUIDs) do not
// change what a static link binds.

استورد std.text.from_bytes;

عام نوع مكتبة_نصية_ماتشو = {
    اسم_التثبيت: متجه ط8,
    الرموز: متجه متجه ط8
};

عرف بايتات_تبدأ_بـ_تابي(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, البادئة: &متجه ط8): منطقي {
    دع الطول_المطلوب: طبيعي = الطول(*البادئة) مثل طبيعي;
    إذا (النهاية < البداية || النهاية - البداية < الطول_المطلوب) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا ((*البايتات)[البداية + ف] != (*البادئة)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف نسخة_بايتات_تابي(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(الناتج, (*البايتات)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف بايتان_متساويان_تابي(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف فاصل_تابي(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09 || البايت == 0x0D || البايت == 0x2C
        || البايت == 0x5B || البايت == 0x5D || البايت == 0x27 || البايت == 0x22;
}

// Whether the bytes are a TAPI text stub: `--- !tapi-tbd` (v2-v4) or a
// v1 document (`---` then `archs:` ... `install-name:`).
عام عرف مكتبة_نصية_تابي(البايتات: &متجه ط8): منطقي {
    دع الطول_الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع الوسم: متجه ط8 = بايتات_من_نص_تابي(«--- !tapi-tbd»);
    إذا (بايتات_تبدأ_بـ_تابي(البايتات, 0, الطول_الكلي, &الوسم)) { أرجع صواب; };
    دع البداية: متغير متجه ط8 = بايتات_من_نص_تابي(«---»);
    ألحق(البداية, 0x0A);
    إذا (!بايتات_تبدأ_بـ_تابي(البايتات, 0, الطول_الكلي, &البداية)) { أرجع خطأ; };
    دع المفتاح: متغير متجه ط8 = [0x0A];
    دع اسم_المفتاح: متجه ط8 = بايتات_من_نص_تابي(«install-name:»);
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(اسم_المفتاح) مثل طبيعي)) { ألحق(المفتاح, اسم_المفتاح[ك]); ك := ك + 1; }
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي && ف < 4096) {
        إذا (بايتات_تبدأ_بـ_تابي(البايتات, ف, الطول_الكلي, &المفتاح)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف بايتات_من_نص_تابي(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) { ألحق(الناتج, النص[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// Whether the key bytes spell النص.
عرف مفتاح_تابي_يساوي(المفتاح: &متجه ط8, النص: نص): منطقي {
    دع المتوقع: متجه ط8 = بايتات_من_نص_تابي(النص);
    أرجع بايتان_متساويان_تابي(المفتاح, &المتوقع);
}

// Kinds of symbol list: 0 none, 1 plain names, 2 Objective-C classes,
// 3 Objective-C exception types, 4 Objective-C instance variables.
عرف صنف_قائمة_رموز_تابي(المفتاح: &متجه ط8): طبيعي {
    إذا (مفتاح_تابي_يساوي(المفتاح, «symbols»)
        || مفتاح_تابي_يساوي(المفتاح, «weak-symbols»)
        || مفتاح_تابي_يساوي(المفتاح, «weak-def-symbols»)
        || مفتاح_تابي_يساوي(المفتاح, «thread-local-symbols»)) {
        أرجع 1;
    };
    إذا (مفتاح_تابي_يساوي(المفتاح, «objc-classes»)) { أرجع 2; };
    إذا (مفتاح_تابي_يساوي(المفتاح, «objc-eh-types»)) { أرجع 3; };
    إذا (مفتاح_تابي_يساوي(المفتاح, «objc-ivars»)) { أرجع 4; };
    أرجع 0;
}

عرف أضف_رمز_تابي(الرموز: &متغير متجه متجه ط8, الاسم: &متجه ط8, الصنف: طبيعي): فراغ {
    إذا ((الطول(*الاسم) مثل طبيعي) == 0) { أرجع; };
    إذا (الصنف == 1) { ألحق(*الرموز, نسخة_بايتات_تابي(الاسم, 0, الطول(*الاسم) مثل طبيعي)); أرجع; };
    // v1-v3 Objective-C names carry their leading underscore.
    دع بشرطة: منطقي = (*الاسم)[0] == 0x5F;
    دع البادئات: متغير متجه نص = [];
    إذا (الصنف == 2) { ألحق(البادئات, «_OBJC_CLASS_$»); ألحق(البادئات, «_OBJC_METACLASS_$»); };
    إذا (الصنف == 3) { ألحق(البادئات, «_OBJC_EHTYPE_$»); };
    إذا (الصنف == 4) { ألحق(البادئات, «_OBJC_IVAR_$»); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البادئات) مثل طبيعي)) {
        دع الكامل: متغير متجه ط8 = بايتات_من_نص_تابي(انسخ_نص(&البادئات[ف]));
        إذا (!بشرطة) { ألحق(الكامل, 0x5F); };
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(*الاسم) مثل طبيعي)) { ألحق(الكامل, (*الاسم)[ك]); ك := ك + 1; }
        ألحق(*الرموز, الكامل);
        ف := ف + 1;
    }
}

// The tokens of a flow list between البداية and النهاية; returns whether
// the list closed (`]`) on this line.
عرف اقرأ_عناصر_تابي(
    البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي,
    العناصر: &متغير متجه متجه ط8
): منطقي {
    دع ف: متغير طبيعي = البداية;
    دع أغلقت: متغير منطقي = خطأ;
    طالما (ف < النهاية && !أغلقت) {
        إذا ((*البايتات)[ف] == 0x5D) { أغلقت := صواب; } وإلا إذا (فاصل_تابي((*البايتات)[ف])) {
        } وإلا {
            دع البدء: طبيعي = ف;
            طالما (ف < النهاية && !فاصل_تابي((*البايتات)[ف])) { ف := ف + 1; }
            ألحق(*العناصر, نسخة_بايتات_تابي(البايتات, البدء, ف));
            ف := ف - 1;
        };
        ف := ف + 1;
    }
    أرجع أغلقت;
}

// Whether a `targets:` (v4: `<arch>-<platform>`, `arm64-macos`) or
// `archs:` (v1-v3: `<arch>`) list names the target.
عرف أهداف_تابي_تطابق(
    العناصر: &متجه متجه ط8,
    المعمارية: &متجه ط8,
    المنصة: &متجه ط8,
    بالمنصة: منطقي
): منطقي {
    دع المطلوب: متغير متجه ط8 = نسخة_بايتات_تابي(المعمارية, 0, الطول(*المعمارية) مثل طبيعي);
    إذا (بالمنصة) {
        ألحق(المطلوب, 0x2D);
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(*المنصة) مثل طبيعي)) { ألحق(المطلوب, (*المنصة)[ك]); ك := ك + 1; }
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        إذا (بايتان_متساويان_تابي(&(*العناصر)[ف], &المطلوب)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether the value between البداية and النهاية opens a flow list that
// continues on the next line (`[` without its `]`).
عرف قيمة_تفتح_قائمة_تابي(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): منطقي {
    دع فتحت: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا ((*البايتات)[ف] == 0x5B) { فتحت := صواب; };
        إذا ((*البايتات)[ف] == 0x5D) { فتحت := خطأ; };
        ف := ف + 1;
    }
    أرجع فتحت;
}

عرف أضف_عناصر_رموز_تابي(
    الرموز: &متغير متجه متجه ط8,
    العناصر: &متجه متجه ط8,
    الصنف: طبيعي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        أضف_رمز_تابي(الرموز, &(*العناصر)[ف], الصنف);
        ف := ف + 1;
    }
}

// The install name and the symbols the stub exports for the target, named
// by its architecture (`arm64`, `x86_64`) and platform (`macos`, `ios`), or
// none when no document names an install name.
عام عرف اقرأ_مكتبة_نصية_ماتشو(
    البايتات: &متجه ط8,
    المعمارية: &متجه ط8,
    المنصة: &متجه ط8
): اختياري مكتبة_نصية_ماتشو {
    دع الطول_الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع اسم_التثبيت: متغير اختياري متجه ط8 = اختياري.لا_شيء();
    دع الرموز: متغير متجه متجه ط8 = [];
    دع في_الصادرات: متغير منطقي = خطأ;
    دع الهدف_مطابق: متغير منطقي = خطأ;
    // The list continuing on the next lines: none, an entry's targets
    // (أهداف_مفتوحة) or one of its symbol lists (صنف_مفتوح, 0 for a list
    // of no interest, as `targets:` of a document).
    دع قائمة_مفتوحة: متغير منطقي = خطأ;
    دع أهداف_مفتوحة: متغير منطقي = خطأ;
    دع بالمنصة_مفتوحة: متغير منطقي = خطأ;
    دع صنف_مفتوح: متغير طبيعي = 0;
    دع الأهداف_المجمعة: متغير متجه متجه ط8 = [];
    دع فتحات: متجه ط8 = بايتات_من_نص_تابي(«---»);
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < الطول_الكلي) {
        دع النهاية: متغير طبيعي = البداية;
        طالما (النهاية < الطول_الكلي && (*البايتات)[النهاية] != 0x0A) { النهاية := النهاية + 1; }
        إذا (قائمة_مفتوحة) {
            دع العناصر: متغير متجه متجه ط8 = [];
            دع أغلقت: منطقي = اقرأ_عناصر_تابي(البايتات, البداية, النهاية, &متغير العناصر);
            إذا (أهداف_مفتوحة) {
                دع ف: متغير طبيعي = 0;
                طالما (ف < (الطول(العناصر) مثل طبيعي)) { ألحق(الأهداف_المجمعة, نسخة_بايتات_تابي(&العناصر[ف], 0, الطول(العناصر[ف]) مثل طبيعي)); ف := ف + 1; }
                إذا (أغلقت) {
                    الهدف_مطابق := أهداف_تابي_تطابق(&الأهداف_المجمعة, المعمارية, المنصة, بالمنصة_مفتوحة);
                };
            } وإلا إذا (صنف_مفتوح != 0 && الهدف_مطابق) {
                أضف_عناصر_رموز_تابي(&متغير الرموز, &العناصر, صنف_مفتوح);
            };
            إذا (أغلقت) { قائمة_مفتوحة := خطأ; أهداف_مفتوحة := خطأ; صنف_مفتوح := 0; };
        } وإلا إذا (بايتات_تبدأ_بـ_تابي(البايتات, البداية, النهاية, &فتحات)) {
            في_الصادرات := خطأ;
            الهدف_مطابق := خطأ;
        } وإلا {
            دع المسافة: متغير طبيعي = البداية;
            طالما (المسافة < النهاية && (*البايتات)[المسافة] == 0x20) { المسافة := المسافة + 1; }
            دع بداية_المفتاح: متغير طبيعي = المسافة;
            إذا (بداية_المفتاح + 1 < النهاية && (*البايتات)[بداية_المفتاح] == 0x2D
                && (*البايتات)[بداية_المفتاح + 1] == 0x20) {
                // A new entry of the list.
                الهدف_مطابق := خطأ;
                بداية_المفتاح := بداية_المفتاح + 2;
                طالما (بداية_المفتاح < النهاية && (*البايتات)[بداية_المفتاح] == 0x20) { بداية_المفتاح := بداية_المفتاح + 1; }
            };
            دع النقطتان: متغير طبيعي = بداية_المفتاح;
            طالما (النقطتان < النهاية && (*البايتات)[النقطتان] != 0x3A) { النقطتان := النقطتان + 1; }
            إذا (النقطتان < النهاية) {
                دع المفتاح: متجه ط8 = نسخة_بايتات_تابي(البايتات, بداية_المفتاح, النقطتان);
                دع العناصر: متغير متجه متجه ط8 = [];
                دع مغلقة_القيمة: منطقي = اقرأ_عناصر_تابي(البايتات, النقطتان + 1, النهاية, &متغير العناصر);
                قائمة_مفتوحة := قيمة_تفتح_قائمة_تابي(البايتات, النقطتان + 1, النهاية);
                أهداف_مفتوحة := خطأ;
                صنف_مفتوح := 0;
                إذا (المسافة == البداية) {
                    الهدف_مطابق := خطأ;
                    في_الصادرات := مفتاح_تابي_يساوي(&المفتاح, «exports»)
                        || مفتاح_تابي_يساوي(&المفتاح, «reexports»);
                    طابق اسم_التثبيت مع
                    | اختياري.موجود(_) -> { }
                    | اختياري.لا_شيء -> {
                        إذا (مفتاح_تابي_يساوي(&المفتاح, «install-name»)
                            && (الطول(العناصر) مثل طبيعي) > 0) {
                            اسم_التثبيت := اختياري.موجود(نسخة_بايتات_تابي(&العناصر[0], 0, الطول(العناصر[0]) مثل طبيعي));
                        };
                    };
                } وإلا إذا (في_الصادرات) {
                    دع مفتاح_المنصات: منطقي = مفتاح_تابي_يساوي(&المفتاح, «targets»);
                    إذا (مفتاح_المنصات
                        || مفتاح_تابي_يساوي(&المفتاح, «archs»)) {
                        إذا (قائمة_مفتوحة) {
                            أهداف_مفتوحة := صواب;
                            بالمنصة_مفتوحة := مفتاح_المنصات;
                            الأهداف_المجمعة := العناصر;
                        } وإلا {
                            الهدف_مطابق := أهداف_تابي_تطابق(&العناصر, المعمارية, المنصة, مفتاح_المنصات);
                        };
                    } وإلا {
                        دع الصنف: طبيعي = صنف_قائمة_رموز_تابي(&المفتاح);
                        إذا (الصنف != 0 && الهدف_مطابق) {
                            أضف_عناصر_رموز_تابي(&متغير الرموز, &العناصر, الصنف);
                        };
                        صنف_مفتوح := الصنف;
                    };
                };
            };
        };
        البداية := النهاية + 1;
    }
    طابق اسم_التثبيت مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع المكتبة: مكتبة_نصية_ماتشو = { اسم_التثبيت: الاسم, الرموز: الرموز };
        أرجع اختياري.موجود(المكتبة);
    };
}

// The install name of a text-based dylib stub (the first document's
// `install-name`, as `/usr/lib/libsqlite3.dylib`), whatever its targets, or
// none when the bytes are no stub or name none. The one .tbd reader: the
// driver resolves `-l X` to libX.tbd's dylib with it, and the Mach-O linker
// reads the same stub with اقرأ_مكتبة_نصية_ماتشو.
عام عرف اسم_تثبيت_مكتبة_نصية(البايتات: &متجه ط8): اختياري نص {
    إذا (!مكتبة_نصية_تابي(البايتات)) { أرجع اختياري.لا_شيء(); };
    دع بلا_هدف: متجه ط8 = [];
    طابق اقرأ_مكتبة_نصية_ماتشو(البايتات, &بلا_هدف, &بلا_هدف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المكتبة) -> { أرجع اختياري.موجود(من_بايتات(&المكتبة.اسم_التثبيت)); };
}
