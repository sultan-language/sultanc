استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.reachability;
استورد compiler.link.resolution;
استورد compiler.link.macho.names;
استورد compiler.backend.target.target_model;

عام نوع خطأ_استيعاب_كائن_ماتشو =
    | كائن_غير_صالح
    | تعريف_رمز_مكرر
    | سعة_رموز_غير_قابلة_للتمثيل
    | حل_رمز_يتطلب_سياسة
    | إزاحة_غير_صالحة
;

عام نوع نتيجة_استيعاب_كائن_ماتشو =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_ماتشو
;

نوع حقيقة_قسم_ماتشو_مدخل = {
    معرف_الربط: اختياري معرف_قسم_ربط,
    العنوان: طبيعي,
    الحجم: طبيعي,
    موضع_الملف: طبيعي,
    أس_المحاذاة: طبيعي,
    موضع_الإزاحات: طبيعي,
    عدد_الإزاحات: طبيعي,
    الأعلام: طبيعي
};

نوع حقيقة_رمز_ماتشو_مدخل = {
    معرف_الربط: اختياري معرف_رمز_ربط,
    فهرس_القسم: طبيعي,
    القيمة: طبيعي,
    محلي: منطقي
};

عرف ضمن_حدود_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع حجم_الكائن: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > حجم_الكائن) {
        أرجع خطأ;
    };
    أرجع الحجم <= (حجم_الكائن - الموضع);
}

عرف اقرأ_بايت_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): ط8 {
    أرجع (*البايتات)[الموضع];
}

عرف اقرأ_ط16_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع البايت_الأدنى: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع) مثل طبيعي;
    دع البايت_الأعلى: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 1) مثل طبيعي;
    أرجع البايت_الأدنى + البايت_الأعلى * 256;
}

عرف اقرأ_ط32_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع البايت_صفر: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع) مثل طبيعي;
    دع البايت_واحد: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 1) مثل طبيعي;
    دع البايت_اثنان: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 2) مثل طبيعي;
    دع البايت_ثلاثة: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 3) مثل طبيعي;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عرف اقرأ_ط64_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الجزء_الأدنى: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, الموضع);
    دع الجزء_الأعلى: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, الموضع + 4);
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عرف اقرأ_اسم_صفري_من_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري متجه ط8 {
    إذا (الموضع >= النهاية || النهاية > (الطول(*البايتات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = الموضع;
    طالما (فهرس_البايت < النهاية) {
        إذا (اقرأ_بايت_كائن_ماتشو(البايتات, فهرس_البايت) == 0) {
            أرجع اختياري.موجود(الاسم);
        };
        ألحق(الاسم, اقرأ_بايت_كائن_ماتشو(البايتات, فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف انسخ_نطاق_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): متجه ط8 {
    دع المحتوى: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < الحجم) {
        ألحق(المحتوى, اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع المحتوى;
}

عرف اقرأ_اسم_ثابت_من_كائن_ماتشو(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري متجه ط8 {
    إذا (!ضمن_حدود_كائن_ماتشو(البايتات, الموضع, 16)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < 16) {
        دع البايت: ط8 = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + فهرس_البايت);
        إذا (البايت == 0) {
            أرجع اختياري.موجود(الاسم);
        };
        ألحق(الاسم, البايت);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختياري.موجود(الاسم);
}

عرف صنف_قسم_ماتشو_للربط(
    اسم_القسم: &متجه ط8,
    اسم_الحاوية: &متجه ط8,
    أعلام_القسم: طبيعي
): صنف_قسم_ربط {
    دع نوع_القسم: طبيعي = أعلام_القسم & 0xFF;
    إذا (نوع_القسم == 1 || نوع_القسم == 0xC || نوع_القسم == 0x12) {
        أرجع صنف_قسم_ربط.بيانات_صفرية();
    };
    دع اسم_دوارف: متجه ط8 = اسم_حاوية_دوارف_ماتشو();
    إذا (اسما_ماتشو_متساويان(اسم_الحاوية, &اسم_دوارف)) {
        أرجع صنف_قسم_ربط.تصحيح();
    };
    دع اسم_النص: متجه ط8 = اسم_قسم_نص_ماتشو();
    إذا (اسما_ماتشو_متساويان(اسم_القسم, &اسم_النص)) {
        أرجع صنف_قسم_ربط.شفرة();
    };
    // Segment permissions own the distinction: __DATA,__const is writable
    // during dyld rebasing, unlike __TEXT,__const. A section name alone
    // cannot decide whether its absolute pointers require a rebase.
    دع اسم_مقطع_نص: متجه ط8 = اسم_مقطع_نص_ماتشو();
    إذا (اسما_ماتشو_متساويان(اسم_الحاوية, &اسم_مقطع_نص)) {
        أرجع صنف_قسم_ربط.بيانات_للقراءة();
    };
    أرجع صنف_قسم_ربط.بيانات_قابلة_للكتابة();
}

عرف حول_نتيجة_تسجيل_رمز_ماتشو(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_ماتشو {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.حل_رمز_يتطلب_سياسة()
        );
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.تعريف_رمز_مكرر()
            );
        }
        | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | خطأ_حل_رموز_ربط.سياسة_صيغة_مطلوبة -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عرف نوع_معالج_ماتشو_للهدف(السياق: &سياق_ربط): اختياري طبيعي {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(0x0100000C);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(0x01000007);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A common symbol (N_UNDF | N_EXT with n_value != 0: a C tentative
// definition such as `int x;` under -fcommon): n_value is its size and
// GET_COMM_ALIGN(n_desc) = (n_desc >> 8) & 0xF the log2 of its alignment
// (<mach-o/nlist.h>). As ld64 and LLD's MachO port: a real definition wins;
// among commons the largest size wins, with the larger alignment. Each
// common gets its own zero-fill __DATA,__common section (S_ZEROFILL, 0x1),
// whose ordinal 0 marks it as synthesized (object sections start at 1).
عرف حجم_مشترك_ماتشو_سابق(السياق: &سياق_ربط, القسم: معرف_قسم_ربط): اختياري طبيعي {
    إذا ((القسم.القيمة مثل طبيعي) >= (الطول((*السياق).الأقسام) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((*السياق).الأقسام[القسم.القيمة].المعرف.القيمة != القسم.القيمة
        || (*السياق).الأقسام[القسم.القيمة].فهرس_قسم_الصيغة != 0) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود((*السياق).الأقسام[القسم.القيمة].الحجم);
}

عرف سجل_رمزا_مشتركا_ماتشو(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه ط8,
    المدخل: معرف_مدخل_ربط,
    الحجم: طبيعي,
    أس_المحاذاة: طبيعي
): نتيجة_تسجيل_رمز_ربط {
    دع معرف_موجود: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            دع حجم_سابق: متغير اختياري طبيعي = اختياري.لا_شيء();
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> { حجم_سابق := حجم_مشترك_ماتشو_سابق(السياق, القسم); }
            | _ -> { };
            طابق حجم_سابق مع
            | اختياري.لا_شيء -> { أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف); }
            | اختياري.موجود(السابق) -> {
                إذا (السابق >= الحجم) { أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف); };
                معرف_موجود := اختياري.موجود(الرمز.المعرف);
            };
        }
        | _ -> { };
    };
    دع الأس: متغير طبيعي = أس_المحاذاة;
    إذا (الأس > 15) { الأس := 15; };
    دع المحاذاة: طبيعي = 1 << الأس;
    // "__common" in "__DATA".
    دع اسم_القسم: متجه ط8 = [0x5F, 0x5F, 0x63, 0x6F, 0x6D, 0x6D, 0x6F, 0x6E];
    دع اسم_الحاوية: متجه ط8 = [0x5F, 0x5F, 0x44, 0x41, 0x54, 0x41];
    دع هوية_القسم: هوية_اسم_قسم_ربط = {
        اسم_القسم: اسم_القسم,
        اسم_الحاوية: اختياري.موجود(اسم_الحاوية)
    };
    دع القسم: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
        السياق,
        المدخل,
        0,
        هوية_القسم,
        حقائق_صيغة_قسم_ربط.ماتشو(0x1),
        صنف_قسم_ربط.بيانات_صفرية(),
        المحاذاة,
        الحجم,
        اختياري.لا_شيء()
    );
    طابق معرف_موجود مع
    | اختياري.موجود(المعرف) -> {
        دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
            المدخل,
            قوة_تعريف_رمز_ربط.ضعيف(),
            موضع_تعريف_رمز_ربط.قسم(القسم, 0),
            الحجم
        );
        (*السياق).الرموز.الرموز[المعرف.القيمة].الحالة := حالة_رمز_ربط.معرف(التعريف);
        أرجع نتيجة_تسجيل_رمز_ربط.نجح(المعرف);
    }
    | اختياري.لا_شيء -> { };
    أرجع سجل_تعريف_قسم_رمز_في_سياق_الربط(
        السياق, الاسم, المدخل, قوة_تعريف_رمز_ربط.ضعيف(), القسم, 0, الحجم
    );
}

عام عرف استوعب_كائن_ماتشو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_ماتشو {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    إذا (!ضمن_حدود_كائن_ماتشو(البايتات, 0, 32)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };
    دع نوع_المعالج: طبيعي;
    طابق نوع_معالج_ماتشو_للهدف(السياق) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    }
    | اختياري.موجود(القيمة) -> { نوع_المعالج := القيمة; };
    إذا (اقرأ_ط32_كائن_ماتشو(البايتات, 0) != 0xFEEDFACF
        || اقرأ_ط32_كائن_ماتشو(البايتات, 4) != نوع_المعالج
        || اقرأ_ط32_كائن_ماتشو(البايتات, 12) != 1) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع عدد_الأوامر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, 16);
    دع حجم_الأوامر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, 20);
    إذا (!ضمن_حدود_كائن_ماتشو(البايتات, 32, حجم_الأوامر)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_ماتشو_مدخل = [];
    دع قسم_صفر: حقيقة_قسم_ماتشو_مدخل = {
        معرف_الربط: اختياري.لا_شيء(),
        العنوان: 0,
        الحجم: 0,
        موضع_الملف: 0,
        أس_المحاذاة: 0,
        موضع_الإزاحات: 0,
        عدد_الإزاحات: 0,
        الأعلام: 0
    };
    ألحق(حقائق_الأقسام, قسم_صفر);

    دع موضع_الرموز: متغير طبيعي = 0;
    دع عدد_الرموز: متغير طبيعي = 0;
    دع موضع_النصوص: متغير طبيعي = 0;
    دع حجم_النصوص: متغير طبيعي = 0;
    دع وجد_جدول_رموز: متغير منطقي = خطأ;
    دع ترتيب_القسم: متغير طبيعي = 0;
    دع موضع_الأمر: متغير طبيعي = 32;
    دع نهاية_الأوامر: طبيعي = 32 + حجم_الأوامر;
    دع فهرس_الأمر: متغير طبيعي = 0;

    طالما (فهرس_الأمر < عدد_الأوامر) {
        // Load commands must be wholly inside sizeofcmds, even if the file
        // has unrelated section contents following its load-command table.
        إذا (موضع_الأمر > نهاية_الأوامر
            || 8 > نهاية_الأوامر - موضع_الأمر
            || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الأمر, 8)) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };
        دع نوع_الأمر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر);
        دع حجم_الأمر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 4);
        إذا (حجم_الأمر < 8
            || حجم_الأمر > نهاية_الأوامر - موضع_الأمر
            || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الأمر, حجم_الأمر)) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };

        إذا (نوع_الأمر == 0x19) {
            إذا (حجم_الأمر < 72) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };
            دع عدد_أقسام_الأمر: طبيعي =
                اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 64);
            إذا (72 + عدد_أقسام_الأمر * 80 != حجم_الأمر) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };

            دع فهرس_قسم_الأمر: متغير طبيعي = 0;
            طالما (فهرس_قسم_الأمر < عدد_أقسام_الأمر) {
                دع موضع_رأس_القسم: طبيعي =
                    موضع_الأمر + 72 + فهرس_قسم_الأمر * 80;
                ترتيب_القسم := ترتيب_القسم + 1;
                دع اسم_القسم: متجه ط8;
                طابق اقرأ_اسم_ثابت_من_كائن_ماتشو(
                    البايتات,
                    موضع_رأس_القسم
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختياري.موجود(الاسم_المقروء) -> { اسم_القسم := الاسم_المقروء; };
                دع اسم_الحاوية: متجه ط8;
                طابق اقرأ_اسم_ثابت_من_كائن_ماتشو(
                    البايتات,
                    موضع_رأس_القسم + 16
                ) مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختياري.موجود(الاسم_المقروء) -> { اسم_الحاوية := الاسم_المقروء; };
                دع عنوان_القسم: طبيعي =
                    اقرأ_ط64_كائن_ماتشو(البايتات, موضع_رأس_القسم + 32);
                دع حجم_القسم: طبيعي =
                    اقرأ_ط64_كائن_ماتشو(البايتات, موضع_رأس_القسم + 40);
                دع موضع_ملف_القسم: طبيعي =
                    اقرأ_ط32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 48);
                دع أس_محاذاة_القسم: طبيعي =
                    اقرأ_ط32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 52);
                دع موضع_إزاحات_القسم: طبيعي =
                    اقرأ_ط32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 56);
                دع عدد_إزاحات_القسم: طبيعي =
                    اقرأ_ط32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 60);
                دع أعلام_القسم: طبيعي =
                    اقرأ_ط32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 64);
                دع نوع_القسم: طبيعي = أعلام_القسم & 0xFF;
                دع قسم_صفري: منطقي =
                    نوع_القسم == 1 || نوع_القسم == 0xC || نوع_القسم == 0x12;
                إذا (أس_محاذاة_القسم > 20
                    || (!قسم_صفري
                        && !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            موضع_ملف_القسم,
                            حجم_القسم
                        ))
                    || !ضمن_حدود_كائن_ماتشو(
                        البايتات,
                        موضع_إزاحات_القسم,
                        عدد_إزاحات_القسم * 8
                    )) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                };

                // The section's validated index and size refer to the
                // retained object bytes; copy only after reachability.
                دع المحتوى: اختياري متجه ط8 = اختياري.لا_شيء();
                دع الصنف: صنف_قسم_ربط = صنف_قسم_ماتشو_للربط(
                    &اسم_القسم,
                    &اسم_الحاوية,
                    أعلام_القسم
                );
                دع المحاذاة: طبيعي = 1 << أس_محاذاة_القسم;
                دع هوية_اسم_القسم: هوية_اسم_قسم_ربط = {
                    اسم_القسم: اسم_القسم,
                    اسم_الحاوية: اختياري.موجود(اسم_الحاوية)
                };
                دع معرف_الربط: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
                    السياق,
                    (*المدخل).المعرف,
                    ترتيب_القسم,
                    هوية_اسم_القسم,
                    حقائق_صيغة_قسم_ربط.ماتشو(أعلام_القسم),
                    الصنف,
                    المحاذاة,
                    حجم_القسم,
                    المحتوى
                );
                // S_MOD_INIT_FUNC_POINTERS (0x9) contains pointer-sized
                // entries. Do not let dyld execute partial or misaligned
                // entries from malformed objects.
                إذا ((أعلام_القسم & 0xFF) == 0x9) {
                    إذا ((حجم_القسم % 8) != 0 || أس_محاذاة_القسم < 3) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                        );
                    };
                    أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, معرف_الربط);
                };
                دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل = {
                    معرف_الربط: اختياري.موجود(معرف_الربط),
                    العنوان: عنوان_القسم,
                    الحجم: حجم_القسم,
                    موضع_الملف: موضع_ملف_القسم,
                    أس_المحاذاة: أس_محاذاة_القسم,
                    موضع_الإزاحات: موضع_إزاحات_القسم,
                    عدد_الإزاحات: عدد_إزاحات_القسم,
                    الأعلام: أعلام_القسم
                };
                ألحق(حقائق_الأقسام, حقيقة_القسم);
                فهرس_قسم_الأمر := فهرس_قسم_الأمر + 1;
            }
        } وإلا إذا (نوع_الأمر == 2) {
            إذا (حجم_الأمر != 24 || وجد_جدول_رموز) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };
            وجد_جدول_رموز := صواب;
            موضع_الرموز := اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 8);
            عدد_الرموز := اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 12);
            موضع_النصوص := اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 16);
            حجم_النصوص := اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الأمر + 20);
        };

        موضع_الأمر := موضع_الأمر + حجم_الأمر;
        فهرس_الأمر := فهرس_الأمر + 1;
    }

    إذا (موضع_الأمر != نهاية_الأوامر
        || !وجد_جدول_رموز
        || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الرموز, عدد_الرموز * 16)
        || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_النصوص, حجم_النصوص)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع حقائق_الرموز: متغير متجه حقيقة_رمز_ماتشو_مدخل = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: طبيعي = موضع_الرموز + فهرس_الرمز * 16;
        دع فهرس_الاسم: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الرمز);
        دع نوع_الرمز: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, موضع_الرمز + 4) مثل طبيعي;
        دع فئة_الرمز: طبيعي = نوع_الرمز & 0x0E;
        دع فهرس_قسم_الرمز: طبيعي = اقرأ_بايت_كائن_ماتشو(البايتات, موضع_الرمز + 5) مثل طبيعي;
        دع وصف_الرمز: طبيعي = اقرأ_ط16_كائن_ماتشو(البايتات, موضع_الرمز + 6);
        دع قيمة_الرمز: طبيعي = اقرأ_ط64_كائن_ماتشو(البايتات, موضع_الرمز + 8);
        دع الرمز_خارجي: منطقي = (نوع_الرمز & 1) != 0;
        دع الرمز_محلي: منطقي = !الرمز_خارجي;
        دع معرف_الربط: متغير اختياري معرف_رمز_ربط = اختياري.لا_شيء();

        إذا (فهرس_الاسم >= حجم_النصوص || فهرس_قسم_الرمز > ترتيب_القسم) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };

        إذا (الرمز_خارجي && فهرس_الاسم != 0) {
            دع الاسم: متجه ط8;
            طابق اقرأ_اسم_صفري_من_كائن_ماتشو(
                البايتات,
                موضع_النصوص + فهرس_الاسم,
                موضع_النصوص + حجم_النصوص
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            }
            | اختياري.موجود(اسم_مقروء) -> { الاسم := اسم_مقروء; };

            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            إذا (فئة_الرمز == 0 && فهرس_قسم_الرمز == 0 && قيمة_الرمز != 0) {
                نتيجة_التسجيل := سجل_رمزا_مشتركا_ماتشو(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    قيمة_الرمز,
                    (وصف_الرمز >> 8) & 0x0F
                );
            } وإلا إذا (فئة_الرمز == 0 && فهرس_قسم_الرمز == 0) {
                نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا إذا (فئة_الرمز == 2) {
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                إذا ((وصف_الرمز & 0x80) != 0) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    موضع_تعريف_رمز_ربط.مطلق(قيمة_الرمز),
                    0
                );
            } وإلا إذا (فئة_الرمز == 0x0E && فهرس_قسم_الرمز > 0) {
                دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل =
                    حقائق_الأقسام[فهرس_قسم_الرمز];
                دع معرف_القسم: معرف_قسم_ربط;
                طابق حقيقة_القسم.معرف_الربط مع
                | اختياري.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختياري.موجود(المعرف) -> { معرف_القسم := المعرف; };
                إذا (قيمة_الرمز < حقيقة_القسم.العنوان
                    || قيمة_الرمز - حقيقة_القسم.العنوان > حقيقة_القسم.الحجم) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                };
                دع إزاحة_الرمز: طبيعي = قيمة_الرمز - حقيقة_القسم.العنوان;
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                إذا ((وصف_الرمز & 0x80) != 0) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    معرف_القسم,
                    إزاحة_الرمز,
                    0
                );
            } وإلا {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };

            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختياري.موجود(المعرف);
            }
            | _ -> {
                أرجع حول_نتيجة_تسجيل_رمز_ماتشو(نتيجة_التسجيل);
            };
        };

        دع حقيقة_الرمز: حقيقة_رمز_ماتشو_مدخل = {
            معرف_الربط: معرف_الربط,
            فهرس_القسم: فهرس_قسم_الرمز,
            القيمة: قيمة_الرمز,
            محلي: الرمز_محلي
        };
        ألحق(حقائق_الرموز, حقيقة_الرمز);
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    دع فهرس_القسم: متغير طبيعي = 1;
    طالما (فهرس_القسم < (الطول(حقائق_الأقسام) مثل طبيعي)) {
        دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل = حقائق_الأقسام[فهرس_القسم];
        دع معرف_قسم_المصدر: معرف_قسم_ربط;
        طابق حقيقة_القسم.معرف_الربط مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
            );
        }
        | اختياري.موجود(المعرف) -> { معرف_قسم_المصدر := المعرف; };

        دع فهرس_الإزاحة: متغير طبيعي = 0;
        دع إضافة_معلقة: متغير عدد = 0;
        دع له_إضافة_معلقة: متغير منطقي = خطأ;
        دع موضع_الإضافة_المعلقة: متغير طبيعي = 0;
        طالما (فهرس_الإزاحة < حقيقة_القسم.عدد_الإزاحات) {
            دع موضع_الإزاحة: طبيعي =
                حقيقة_القسم.موضع_الإزاحات + فهرس_الإزاحة * 8;
            دع عنوان_الإزاحة: طبيعي =
                اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الإزاحة);
            دع معلومات_الإزاحة: طبيعي =
                اقرأ_ط32_كائن_ماتشو(البايتات, موضع_الإزاحة + 4);
            إذا ((عنوان_الإزاحة & 0x80000000) != 0) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                );
            };
            دع فهرس_المرجع: طبيعي = معلومات_الإزاحة & 0x00FFFFFF;
            دع مرجع_خارجي: منطقي = (معلومات_الإزاحة & 0x08000000) != 0;
            دع رمز_صيغة_الإزاحة: طبيعي = معلومات_الإزاحة / 16777216;
            دع نوع_الإزاحة: طبيعي = رمز_صيغة_الإزاحة / 16;
            دع أس_عرض_الإزاحة: طبيعي = (رمز_صيغة_الإزاحة / 2) & 3;
            دع عرض_الإزاحة: طبيعي = 1 << أس_عرض_الإزاحة;
            // ARM64 instruction relocations carry a fixed 32-bit field.
            // PAGE21/BRANCH26 are PC relative; PAGEOFF12 is not.  Reject
            // contradictory relocation headers before creating a link edge.
            إذا ((*السياق).الهدف.المعمارية.الهوية
                == هوية_معمارية.ذراع_أربعة_وستون()) {
                دع نسبي_للحاسوب: منطقي =
                    (معلومات_الإزاحة & 0x01000000) != 0;
                إذا ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 4 || نوع_الإزاحة == 5
                        || نوع_الإزاحة == 6 || نوع_الإزاحة == 10)
                        && (عنوان_الإزاحة % 4) != 0) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                إذا ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 5)
                        && (!نسبي_للحاسوب || عرض_الإزاحة != 4)
                    || (نوع_الإزاحة == 4 || نوع_الإزاحة == 6)
                        && (نسبي_للحاسوب || عرض_الإزاحة != 4)
                    || (نوع_الإزاحة == 5 || نوع_الإزاحة == 6)
                        && (!مرجع_خارجي || له_إضافة_معلقة)) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
            };
            إذا (عنوان_الإزاحة > حقيقة_القسم.الحجم
                || عرض_الإزاحة > حقيقة_القسم.الحجم - عنوان_الإزاحة) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                );
            };

            // ARM64_RELOC_ADDEND stores a signed 24-bit addend in r_symbolnum.
            // It modifies the following relocation and is not an independent edge.
            إذا (نوع_الإزاحة == 10
                && (*السياق).الهدف.المعمارية.الهوية
                    == هوية_معمارية.ذراع_أربعة_وستون()) {
                // An ADDEND must be immediately followed by the relocation
                // at the same address. Even a zero addend is not standalone.
                إذا (له_إضافة_معلقة
                    || مرجع_خارجي
                    || (معلومات_الإزاحة & 0x01000000) != 0
                    || أس_عرض_الإزاحة != 2) {
                    // ADDEND is a 32-bit non-PC-relative, non-external pair.
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                له_إضافة_معلقة := صواب;
                موضع_الإضافة_المعلقة := عنوان_الإزاحة;
                إذا ((فهرس_المرجع & 0x00800000) != 0) {
                    إضافة_معلقة := -(
                        (0x01000000 - فهرس_المرجع) مثل عدد
                    );
                } وإلا {
                    إضافة_معلقة := فهرس_المرجع مثل عدد;
                };
            } وإلا {
                // Paired ARM64 addends belong to a single instruction
                // relocation; never attach one to a pointer or a GOT edge.
                إذا (له_إضافة_معلقة
                    && (عنوان_الإزاحة != موضع_الإضافة_المعلقة
                        || !(نوع_الإزاحة == 2
                            || نوع_الإزاحة == 3 || نوع_الإزاحة == 4)
                        || عرض_الإزاحة != 4
                        || (*السياق).الهدف.المعمارية.الهوية
                            != هوية_معمارية.ذراع_أربعة_وستون())) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                // GOT_LOAD_PAGE21/12 refer to the GOT slot of an external
                // symbol, not the address of a local section. The operand
                // starts with zero immediate and never takes an ADDEND pair.
                إذا ((نوع_الإزاحة == 5 || نوع_الإزاحة == 6)
                    && (*السياق).الهدف.المعمارية.الهوية
                        == هوية_معمارية.ذراع_أربعة_وستون()) {
                    إذا (حقيقة_القسم.موضع_الملف
                        > 0xFFFFFFFFFFFFFFFF - عنوان_الإزاحة
                        || !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            حقيقة_القسم.موضع_الملف + عنوان_الإزاحة,
                            4
                        )) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع التعليمة: طبيعي = اقرأ_ط32_كائن_ماتشو(
                        البايتات,
                        حقيقة_القسم.موضع_الملف + عنوان_الإزاحة
                    );
                    إذا (نوع_الإزاحة == 5
                        && ((التعليمة & 0x9F000000) != 0x90000000
                            || (التعليمة & 0x60FFFFE0) != 0)
                        || نوع_الإزاحة == 6
                        && ((التعليمة & 0xFFC00000) != 0xF9400000
                            || (التعليمة & 0x003FFC00) != 0)) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                };
                دع المرجع: مرجع_إزاحة_ربط;
                دع إضافة_المرجع: متغير عدد = إضافة_معلقة;
                // Canonical graph addends include implicit instruction values
                // from unpaired relocations. A paired ADDEND requires a zero
                // instruction immediate so the linker never applies it twice.
                إذا ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 4)
                    && (*السياق).الهدف.المعمارية.الهوية
                        == هوية_معمارية.ذراع_أربعة_وستون()) {
                    إذا (حقيقة_القسم.موضع_الملف
                        > 0xFFFFFFFFFFFFFFFF - عنوان_الإزاحة
                        || !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            حقيقة_القسم.موضع_الملف + عنوان_الإزاحة,
                            4
                        )) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع التعليمة: طبيعي = اقرأ_ط32_كائن_ماتشو(
                        البايتات,
                        حقيقة_القسم.موضع_الملف + عنوان_الإزاحة
                    );
                    دع الإزاحة_المضمنة: متغير عدد = 0;
                    إذا (نوع_الإزاحة == 2) {
                        إذا ((التعليمة & 0x7C000000) != 0x14000000) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع الخام: طبيعي = التعليمة & 0x03FFFFFF;
                        الإزاحة_المضمنة := (الخام * 4) مثل عدد;
                        إذا ((الخام & 0x02000000) != 0) {
                            الإزاحة_المضمنة := الإزاحة_المضمنة - 268435456;
                        };
                    } وإلا إذا (نوع_الإزاحة == 3) {
                        إذا ((التعليمة & 0x9F000000) != 0x90000000) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع الخام: طبيعي = ((التعليمة >> 29) & 3)
                            | (((التعليمة >> 5) & 0x7FFFF) << 2);
                        الإزاحة_المضمنة := (الخام * 4096) مثل عدد;
                        إذا ((الخام & 0x100000) != 0) {
                            الإزاحة_المضمنة := الإزاحة_المضمنة - 8589934592;
                        };
                    } وإلا {
                        دع تحميل_مباشر: منطقي =
                            (التعليمة & 0x3B000000) == 0x39000000;
                        دع جمع_مباشر: منطقي =
                            (التعليمة & 0x7F800000) == 0x11000000
                            && (التعليمة & 0x00400000) == 0;
                        إذا (!تحميل_مباشر && !جمع_مباشر) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع مقياس_الوصول: متغير طبيعي = 0;
                        إذا (تحميل_مباشر) {
                            مقياس_الوصول := (التعليمة >> 30) & 3;
                            إذا ((التعليمة & 0x04000000) != 0
                                && مقياس_الوصول == 0
                                && ((التعليمة >> 22) & 3) >= 2) {
                                مقياس_الوصول := 4;
                            };
                        };
                        الإزاحة_المضمنة :=
                            (((التعليمة >> 10) & 0xFFF) << مقياس_الوصول) مثل عدد;
                    };
                    إذا (له_إضافة_معلقة && الإزاحة_المضمنة != 0) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    إضافة_المرجع := إضافة_المرجع + الإزاحة_المضمنة;
                };
                إذا (مرجع_خارجي) {
                    إذا (فهرس_المرجع >= عدد_الرموز) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع حقيقة_الرمز: حقيقة_رمز_ماتشو_مدخل =
                        حقائق_الرموز[فهرس_المرجع];
                    طابق حقيقة_الرمز.معرف_الربط مع
                    | اختياري.موجود(معرف_الرمز) -> {
                        المرجع := مرجع_إزاحة_ربط.رمز(معرف_الرمز);
                    }
                    | اختياري.لا_شيء -> {
                        // LLVM may encode a relocation as external even when
                        // its symbol-table target is local to this object. Such
                        // symbols must remain outside global name resolution;
                        // resolve them canonically as section + symbol offset.
                        إذا (!حقيقة_الرمز.محلي
                            || حقيقة_الرمز.فهرس_القسم == 0
                            || حقيقة_الرمز.فهرس_القسم
                                >= (الطول(حقائق_الأقسام) مثل طبيعي)) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع حقيقة_قسم_الهدف: حقيقة_قسم_ماتشو_مدخل =
                            حقائق_الأقسام[حقيقة_الرمز.فهرس_القسم];
                        دع معرف_قسم_الهدف: معرف_قسم_ربط;
                        طابق حقيقة_قسم_الهدف.معرف_الربط مع
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        }
                        | اختياري.موجود(المعرف) -> {
                            معرف_قسم_الهدف := المعرف;
                        };
                        إذا (حقيقة_الرمز.القيمة < حقيقة_قسم_الهدف.العنوان
                            || حقيقة_الرمز.القيمة - حقيقة_قسم_الهدف.العنوان
                                > حقيقة_قسم_الهدف.الحجم) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع إزاحة_الرمز_المحلي: طبيعي =
                            حقيقة_الرمز.القيمة - حقيقة_قسم_الهدف.العنوان;
                        إذا (إزاحة_الرمز_المحلي > 0x7FFFFFFFFFFFFFFF) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_قسم_الهدف);
                        // Resolve the local symbol as a section + signed
                        // offset without overflowing the relocation addend.
                        إذا (إضافة_المرجع > 0
                            && إزاحة_الرمز_المحلي >
                                (0x7FFFFFFFFFFFFFFF - (إضافة_المرجع مثل طبيعي))) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        إضافة_المرجع := إضافة_المرجع
                            + (إزاحة_الرمز_المحلي مثل عدد);
                    };
                } وإلا {
                    إذا (فهرس_المرجع == 0
                        || فهرس_المرجع
                            >= (الطول(حقائق_الأقسام) مثل طبيعي)) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    طابق حقائق_الأقسام[فهرس_المرجع].معرف_الربط مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    }
                    | اختياري.موجود(معرف_قسم_الهدف) -> {
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_قسم_الهدف);
                    };
                    // A non-extern (section) relocation's stored value is an
                    // address in this object's own layout. Rebase it onto the
                    // referent section, as LLD's parseRelocations does
                    // (referentOffset), so the link sees section + offset:
                    //   absolute: stored = target address, so the offset is
                    //     stored - section address;
                    //   x86-64 PC-relative: target = P + 4 + N + stored, so the
                    //     offset is P + 4 + N + stored - section address, where
                    //     N is the SIGNED_N bias that the apply step adds back.
                    // The stored value itself is still read when applying, so
                    // only the difference goes into the edge addend.
                    دع عنوان_قسم_الهدف: عدد = حقائق_الأقسام[فهرس_المرجع].العنوان مثل عدد;
                    دع نسبي_للحاسوب_هنا: منطقي = (معلومات_الإزاحة & 0x01000000) != 0;
                    إذا (نسبي_للحاسوب_هنا
                        && (*السياق).الهدف.المعمارية.الهوية
                            == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون()) {
                        دع الانحياز: متغير عدد = 0;
                        إذا (نوع_الإزاحة == 6) { الانحياز := 1; };
                        إذا (نوع_الإزاحة == 7) { الانحياز := 2; };
                        إذا (نوع_الإزاحة == 8) { الانحياز := 4; };
                        دع عنوان_الحقل: عدد = (حقيقة_القسم.العنوان + عنوان_الإزاحة) مثل عدد;
                        إضافة_المرجع := إضافة_المرجع + عنوان_الحقل + 4 + الانحياز - عنوان_قسم_الهدف;
                    } وإلا إذا (نوع_الإزاحة == 0 && !نسبي_للحاسوب_هنا) {
                        إضافة_المرجع := إضافة_المرجع - عنوان_قسم_الهدف;
                    };
                };

                دع الحافة: حافة_إزاحة_ربط = {
                    القسم: معرف_قسم_المصدر,
                    الإزاحة: عنوان_الإزاحة,
                    المرجع: المرجع,
                    إضافة: إضافة_المرجع,
                    رمز_صيغة: رمز_صيغة_الإزاحة
                };
                أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
                إضافة_معلقة := 0;
                له_إضافة_معلقة := خطأ;
            };
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        إذا (له_إضافة_معلقة) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
            );
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    أرجع نتيجة_استيعاب_كائن_ماتشو.نجح();
}

// Recover an ingested Mach-O section's validated source range from its
// load commands. This is a borrowed view into the plan's original object,
// not an alternate section registry or an owned copy of its payload.
عرف عرض_قسم_ماتشو_بالفهرس(
    البايتات: &متجه ط8,
    فهرس_القسم: طبيعي,
    الحجم_المتوقع: طبيعي
): اختياري طبيعي {
    إذا (!ضمن_حدود_كائن_ماتشو(البايتات, 0, 32) || فهرس_القسم == 0) {
        أرجع اختياري.لا_شيء();
    };
    دع عدد_الأوامر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, 16);
    دع حجم_الأوامر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, 20);
    إذا (!ضمن_حدود_كائن_ماتشو(البايتات, 32, حجم_الأوامر)) {
        أرجع اختياري.لا_شيء();
    };
    دع النهاية: طبيعي = 32 + حجم_الأوامر;
    دع الموضع: متغير طبيعي = 32;
    دع الأمر: متغير طبيعي = 0;
    دع أول_قسم: متغير طبيعي = 1;
    طالما (الأمر < عدد_الأوامر) {
        إذا (الموضع > النهاية || 8 > النهاية - الموضع) {
            أرجع اختياري.لا_شيء();
        };
        دع نوع_الأمر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, الموضع);
        دع حجم_الأمر: طبيعي = اقرأ_ط32_كائن_ماتشو(البايتات, الموضع + 4);
        إذا (حجم_الأمر < 8 || حجم_الأمر > النهاية - الموضع) {
            أرجع اختياري.لا_شيء();
        };
        إذا (نوع_الأمر == 0x19) {
            إذا (حجم_الأمر < 72) { أرجع اختياري.لا_شيء(); };
            دع عدد_الأقسام: طبيعي = اقرأ_ط32_كائن_ماتشو(
                البايتات, الموضع + 64
            );
            إذا (عدد_الأقسام > (حجم_الأمر - 72) / 80
                || 72 + عدد_الأقسام * 80 != حجم_الأمر) {
                أرجع اختياري.لا_شيء();
            };
            إذا (فهرس_القسم >= أول_قسم
                && فهرس_القسم - أول_قسم < عدد_الأقسام) {
                دع الرأس: طبيعي = الموضع + 72
                    + (فهرس_القسم - أول_قسم) * 80;
                دع الحجم: طبيعي = اقرأ_ط64_كائن_ماتشو(
                    البايتات, الرأس + 40
                );
                دع إزاحة_الملف: طبيعي = اقرأ_ط32_كائن_ماتشو(
                    البايتات, الرأس + 48
                );
                إذا (الحجم != الحجم_المتوقع
                    || !ضمن_حدود_كائن_ماتشو(البايتات, إزاحة_الملف, الحجم)) {
                    أرجع اختياري.لا_شيء();
                };
                أرجع اختياري.موجود(إزاحة_الملف);
            };
            أول_قسم := أول_قسم + عدد_الأقسام;
        };
        الموضع := الموضع + حجم_الأمر;
        الأمر := الأمر + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Reachability runs after every input and lazy archive member was parsed.
// Sections not selected for output never materialize an owned payload.
عام عرف جهز_حمولات_أقسام_ماتشو_الحية(
    السياق: &متغير سياق_ربط
): منطقي {
    دع فهرس: متغير طبيعي = 0;
    طالما (فهرس < (الطول((*السياق).الأقسام) مثل طبيعي)) {
        إذا ((*السياق).الأقسام[فهرس].حي) {
            دع نوع_القسم: متغير طبيعي = 1;
            طابق (*السياق).الأقسام[فهرس].حقائق_الصيغة مع
            | حقائق_صيغة_قسم_ربط.ماتشو(الأعلام) -> {
                نوع_القسم := الأعلام & 0xFF;
            }
            | _ -> { };
            إذا (نوع_القسم != 1 && نوع_القسم != 0xC && نوع_القسم != 0x12) {
                دع معرف_المدخل: طبيعي =
                    (*السياق).الأقسام[فهرس].المدخل.القيمة;
                إذا (معرف_المدخل >= (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
                    أرجع خطأ;
                };
                دع البايتات: &متجه ط8 =
                    &(*السياق).الخطة.المدخلات[معرف_المدخل].البايتات;
                دع الحجم: طبيعي = (*السياق).الأقسام[فهرس].الحجم;
                دع فهرس_الصيغة: طبيعي =
                    (*السياق).الأقسام[فهرس].فهرس_قسم_الصيغة;
                طابق عرض_قسم_ماتشو_بالفهرس(البايتات, فهرس_الصيغة, الحجم) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(الموضع) -> {
                    دع المحتوى: متجه ط8 = انسخ_نطاق_كائن_ماتشو(
                        البايتات, الموضع, الحجم
                    );
                    (*السياق).الأقسام[فهرس].المحتوى := اختياري.موجود(المحتوى);
                };
            };
        };
        فهرس := فهرس + 1;
    }
    أرجع صواب;
}
