استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.reachability;
استورد compiler.link.resolution;
استورد compiler.link.macho.names;
استورد compiler.backend.target.target_model;

عام نوع خطأ_استيعاب_كائن_ماتشو =
    | كائن_غير_صالح
    | تعريف_رمز_مكرر
    | سعة_رموز_غير_قابلة_للتمثيل
    | حل_رمز_يتطلب_سياسة
    | إزاحة_غير_صالحة
;

عام نوع نتيجة_استيعاب_كائن_ماتشو =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_ماتشو
;

نوع حقيقة_قسم_ماتشو_مدخل = {
    معرف_الربط: اختيار معرف_قسم_ربط,
    العنوان: غير_موقع,
    الحجم: غير_موقع,
    موضع_الملف: غير_موقع,
    أس_المحاذاة: غير_موقع,
    موضع_الإزاحات: غير_موقع,
    عدد_الإزاحات: غير_موقع,
    الأعلام: غير_موقع
};

نوع حقيقة_رمز_ماتشو_مدخل = {
    معرف_الربط: اختيار معرف_رمز_ربط,
    فهرس_القسم: غير_موقع,
    القيمة: غير_موقع,
    محلي: منطقي
};

عرف ضمن_حدود_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع حجم_الكائن: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > حجم_الكائن) {
        أرجع خطأ;
    };
    أرجع الحجم <= (حجم_الكائن - الموضع);
}

عرف اقرأ_بايت_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غ8 {
    أرجع (*البايتات)[الموضع];
}

عرف اقرأ_غ16_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_الأدنى: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع) مثل غير_موقع;
    دع البايت_الأعلى: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 1) مثل غير_موقع;
    أرجع البايت_الأدنى + البايت_الأعلى * 256;
}

عرف اقرأ_غ32_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_صفر: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع) مثل غير_موقع;
    دع البايت_واحد: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 1) مثل غير_موقع;
    دع البايت_اثنان: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 2) مثل غير_موقع;
    دع البايت_ثلاثة: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + 3) مثل غير_موقع;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عرف اقرأ_غ64_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الجزء_الأدنى: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, الموضع);
    دع الجزء_الأعلى: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, الموضع + 4);
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عرف اقرأ_اسم_صفري_من_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (الموضع >= النهاية || النهاية > (الطول(*البايتات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = الموضع;
    بينما (فهرس_البايت < النهاية) {
        لو (اقرأ_بايت_كائن_ماتشو(البايتات, فهرس_البايت) == 0) {
            أرجع اختيار.بعض(الاسم);
        };
        ألحق(الاسم, اقرأ_بايت_كائن_ماتشو(البايتات, فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_نطاق_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): متجه غ8 {
    دع المحتوى: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < الحجم) {
        ألحق(المحتوى, اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع المحتوى;
}

عرف اقرأ_اسم_ثابت_من_كائن_ماتشو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار متجه غ8 {
    لو (!ضمن_حدود_كائن_ماتشو(البايتات, الموضع, 16)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < 16) {
        دع البايت: غ8 = اقرأ_بايت_كائن_ماتشو(البايتات, الموضع + فهرس_البايت);
        لو (البايت == 0) {
            أرجع اختيار.بعض(الاسم);
        };
        ألحق(الاسم, البايت);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.بعض(الاسم);
}

عرف صنف_قسم_ماتشو_للربط(
    اسم_القسم: &متجه غ8,
    اسم_الحاوية: &متجه غ8,
    أعلام_القسم: غير_موقع
): صنف_قسم_ربط {
    دع نوع_القسم: غير_موقع = أعلام_القسم & 0xFF;
    لو (نوع_القسم == 1 || نوع_القسم == 0xC || نوع_القسم == 0x12) {
        أرجع صنف_قسم_ربط.بيانات_صفرية();
    };
    دع اسم_دوارف: متجه غ8 = اسم_حاوية_دوارف_ماتشو();
    لو (اسما_ماتشو_متساويان(اسم_الحاوية, &اسم_دوارف)) {
        أرجع صنف_قسم_ربط.تصحيح();
    };
    دع اسم_النص: متجه غ8 = اسم_قسم_نص_ماتشو();
    لو (اسما_ماتشو_متساويان(اسم_القسم, &اسم_النص)) {
        أرجع صنف_قسم_ربط.شفرة();
    };
    دع اسم_الثوابت: متجه غ8 = اسم_قسم_ثوابت_ماتشو();
    دع اسم_السلاسل: متجه غ8 = اسم_قسم_سلاسل_ماتشو();
    لو (اسما_ماتشو_متساويان(اسم_القسم, &اسم_الثوابت)
        || اسما_ماتشو_متساويان(اسم_القسم, &اسم_السلاسل)) {
        أرجع صنف_قسم_ربط.بيانات_للقراءة();
    };
    أرجع صنف_قسم_ربط.بيانات_قابلة_للكتابة();
}

عرف حول_نتيجة_تسجيل_رمز_ماتشو(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_ماتشو {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.حل_رمز_يتطلب_سياسة()
        );
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.تعريف_رمز_مكرر()
            );
        }
        | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | خطأ_حل_رموز_ربط.سياسة_صيغة_مطلوبة -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عرف نوع_معالج_ماتشو_للهدف(السياق: &سياق_ربط): اختيار غير_موقع {
    طابق (*السياق).الهدف.المعمارية.الهوية مع
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختيار.بعض(0x0100000C);
    }
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(0x01000007);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف استوعب_كائن_ماتشو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_ماتشو {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!ضمن_حدود_كائن_ماتشو(البايتات, 0, 32)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };
    دع نوع_المعالج: غير_موقع;
    طابق نوع_معالج_ماتشو_للهدف(السياق) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { نوع_المعالج := القيمة; };
    لو (اقرأ_غ32_كائن_ماتشو(البايتات, 0) != 0xFEEDFACF
        || اقرأ_غ32_كائن_ماتشو(البايتات, 4) != نوع_المعالج
        || اقرأ_غ32_كائن_ماتشو(البايتات, 12) != 1) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع عدد_الأوامر: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, 16);
    دع حجم_الأوامر: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, 20);
    لو (!ضمن_حدود_كائن_ماتشو(البايتات, 32, حجم_الأوامر)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_ماتشو_مدخل = [];
    دع قسم_صفر: حقيقة_قسم_ماتشو_مدخل = {
        معرف_الربط: اختيار.لا_شيء(),
        العنوان: 0,
        الحجم: 0,
        موضع_الملف: 0,
        أس_المحاذاة: 0,
        موضع_الإزاحات: 0,
        عدد_الإزاحات: 0,
        الأعلام: 0
    };
    ألحق(حقائق_الأقسام, قسم_صفر);

    دع موضع_الرموز: متغير غير_موقع = 0;
    دع عدد_الرموز: متغير غير_موقع = 0;
    دع موضع_النصوص: متغير غير_موقع = 0;
    دع حجم_النصوص: متغير غير_موقع = 0;
    دع وجد_جدول_رموز: متغير منطقي = خطأ;
    دع ترتيب_القسم: متغير غير_موقع = 0;
    دع موضع_الأمر: متغير غير_موقع = 32;
    دع نهاية_الأوامر: غير_موقع = 32 + حجم_الأوامر;
    دع فهرس_الأمر: متغير غير_موقع = 0;

    بينما (فهرس_الأمر < عدد_الأوامر) {
        // Load commands must be wholly inside sizeofcmds, even if the file
        // has unrelated section contents following its load-command table.
        لو (موضع_الأمر > نهاية_الأوامر
            || 8 > نهاية_الأوامر - موضع_الأمر
            || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الأمر, 8)) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };
        دع نوع_الأمر: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر);
        دع حجم_الأمر: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 4);
        لو (حجم_الأمر < 8
            || حجم_الأمر > نهاية_الأوامر - موضع_الأمر
            || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الأمر, حجم_الأمر)) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };

        لو (نوع_الأمر == 0x19) {
            لو (حجم_الأمر < 72) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };
            دع عدد_أقسام_الأمر: غير_موقع =
                اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 64);
            لو (72 + عدد_أقسام_الأمر * 80 != حجم_الأمر) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };

            دع فهرس_قسم_الأمر: متغير غير_موقع = 0;
            بينما (فهرس_قسم_الأمر < عدد_أقسام_الأمر) {
                دع موضع_رأس_القسم: غير_موقع =
                    موضع_الأمر + 72 + فهرس_قسم_الأمر * 80;
                ترتيب_القسم := ترتيب_القسم + 1;
                دع اسم_القسم: متجه غ8;
                طابق اقرأ_اسم_ثابت_من_كائن_ماتشو(
                    البايتات,
                    موضع_رأس_القسم
                ) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختيار.بعض(الاسم_المقروء) -> { اسم_القسم := الاسم_المقروء; };
                دع اسم_الحاوية: متجه غ8;
                طابق اقرأ_اسم_ثابت_من_كائن_ماتشو(
                    البايتات,
                    موضع_رأس_القسم + 16
                ) مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختيار.بعض(الاسم_المقروء) -> { اسم_الحاوية := الاسم_المقروء; };
                دع عنوان_القسم: غير_موقع =
                    اقرأ_غ64_كائن_ماتشو(البايتات, موضع_رأس_القسم + 32);
                دع حجم_القسم: غير_موقع =
                    اقرأ_غ64_كائن_ماتشو(البايتات, موضع_رأس_القسم + 40);
                دع موضع_ملف_القسم: غير_موقع =
                    اقرأ_غ32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 48);
                دع أس_محاذاة_القسم: غير_موقع =
                    اقرأ_غ32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 52);
                دع موضع_إزاحات_القسم: غير_موقع =
                    اقرأ_غ32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 56);
                دع عدد_إزاحات_القسم: غير_موقع =
                    اقرأ_غ32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 60);
                دع أعلام_القسم: غير_موقع =
                    اقرأ_غ32_كائن_ماتشو(البايتات, موضع_رأس_القسم + 64);
                دع نوع_القسم: غير_موقع = أعلام_القسم & 0xFF;
                دع قسم_صفري: منطقي =
                    نوع_القسم == 1 || نوع_القسم == 0xC || نوع_القسم == 0x12;
                لو (أس_محاذاة_القسم > 20
                    || (!قسم_صفري
                        && !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            موضع_ملف_القسم,
                            حجم_القسم
                        ))
                    || !ضمن_حدود_كائن_ماتشو(
                        البايتات,
                        موضع_إزاحات_القسم,
                        عدد_إزاحات_القسم * 8
                    )) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                };

                دع المحتوى: متغير اختيار متجه غ8 = اختيار.لا_شيء();
                لو (!قسم_صفري) {
                    المحتوى := اختيار.بعض(
                        انسخ_نطاق_كائن_ماتشو(
                            البايتات,
                            موضع_ملف_القسم,
                            حجم_القسم
                        )
                    );
                };
                دع الصنف: صنف_قسم_ربط = صنف_قسم_ماتشو_للربط(
                    &اسم_القسم,
                    &اسم_الحاوية,
                    أعلام_القسم
                );
                دع المحاذاة: غير_موقع = 1 << أس_محاذاة_القسم;
                دع هوية_اسم_القسم: هوية_اسم_قسم_ربط = {
                    اسم_القسم: اسم_القسم,
                    اسم_الحاوية: اختيار.بعض(اسم_الحاوية)
                };
                دع معرف_الربط: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
                    السياق,
                    (*المدخل).المعرف,
                    ترتيب_القسم,
                    هوية_اسم_القسم,
                    حقائق_صيغة_قسم_ربط.ماتشو(أعلام_القسم),
                    الصنف,
                    المحاذاة,
                    حجم_القسم,
                    المحتوى
                );
                // S_MOD_INIT_FUNC_POINTERS (0x9) contains pointer-sized
                // entries. Do not let dyld execute partial or misaligned
                // entries from malformed objects.
                لو ((أعلام_القسم & 0xFF) == 0x9) {
                    لو ((حجم_القسم % 8) != 0 || أس_محاذاة_القسم < 3) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                        );
                    };
                    أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, معرف_الربط);
                };
                دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل = {
                    معرف_الربط: اختيار.بعض(معرف_الربط),
                    العنوان: عنوان_القسم,
                    الحجم: حجم_القسم,
                    موضع_الملف: موضع_ملف_القسم,
                    أس_المحاذاة: أس_محاذاة_القسم,
                    موضع_الإزاحات: موضع_إزاحات_القسم,
                    عدد_الإزاحات: عدد_إزاحات_القسم,
                    الأعلام: أعلام_القسم
                };
                ألحق(حقائق_الأقسام, حقيقة_القسم);
                فهرس_قسم_الأمر := فهرس_قسم_الأمر + 1;
            }
        } وإلا لو (نوع_الأمر == 2) {
            لو (حجم_الأمر != 24 || وجد_جدول_رموز) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };
            وجد_جدول_رموز := صواب;
            موضع_الرموز := اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 8);
            عدد_الرموز := اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 12);
            موضع_النصوص := اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 16);
            حجم_النصوص := اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الأمر + 20);
        };

        موضع_الأمر := موضع_الأمر + حجم_الأمر;
        فهرس_الأمر := فهرس_الأمر + 1;
    }

    لو (موضع_الأمر != نهاية_الأوامر
        || !وجد_جدول_رموز
        || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_الرموز, عدد_الرموز * 16)
        || !ضمن_حدود_كائن_ماتشو(البايتات, موضع_النصوص, حجم_النصوص)) {
        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
            خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
        );
    };

    دع حقائق_الرموز: متغير متجه حقيقة_رمز_ماتشو_مدخل = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: غير_موقع = موضع_الرموز + فهرس_الرمز * 16;
        دع فهرس_الاسم: غير_موقع = اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الرمز);
        دع نوع_الرمز: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, موضع_الرمز + 4) مثل غير_موقع;
        دع فئة_الرمز: غير_موقع = نوع_الرمز & 0x0E;
        دع فهرس_قسم_الرمز: غير_موقع = اقرأ_بايت_كائن_ماتشو(البايتات, موضع_الرمز + 5) مثل غير_موقع;
        دع وصف_الرمز: غير_موقع = اقرأ_غ16_كائن_ماتشو(البايتات, موضع_الرمز + 6);
        دع قيمة_الرمز: غير_موقع = اقرأ_غ64_كائن_ماتشو(البايتات, موضع_الرمز + 8);
        دع الرمز_خارجي: منطقي = (نوع_الرمز & 1) != 0;
        دع الرمز_محلي: منطقي = !الرمز_خارجي;
        دع معرف_الربط: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();

        لو (فهرس_الاسم >= حجم_النصوص || فهرس_قسم_الرمز > ترتيب_القسم) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
            );
        };

        لو (الرمز_خارجي && فهرس_الاسم != 0) {
            دع الاسم: متجه غ8;
            طابق اقرأ_اسم_صفري_من_كائن_ماتشو(
                البايتات,
                موضع_النصوص + فهرس_الاسم,
                موضع_النصوص + حجم_النصوص
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            }
            | اختيار.بعض(اسم_مقروء) -> { الاسم := اسم_مقروء; };

            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            لو (فئة_الرمز == 0 && فهرس_قسم_الرمز == 0) {
                نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا لو (فئة_الرمز == 2) {
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو ((وصف_الرمز & 0x80) != 0) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    موضع_تعريف_رمز_ربط.مطلق(قيمة_الرمز),
                    0
                );
            } وإلا لو (فئة_الرمز == 0x0E && فهرس_قسم_الرمز > 0) {
                دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل =
                    حقائق_الأقسام[فهرس_قسم_الرمز];
                دع معرف_القسم: معرف_قسم_ربط;
                طابق حقيقة_القسم.معرف_الربط مع
                | اختيار.لا_شيء -> {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                }
                | اختيار.بعض(المعرف) -> { معرف_القسم := المعرف; };
                لو (قيمة_الرمز < حقيقة_القسم.العنوان
                    || قيمة_الرمز - حقيقة_القسم.العنوان > حقيقة_القسم.الحجم) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                    );
                };
                دع إزاحة_الرمز: غير_موقع = قيمة_الرمز - حقيقة_القسم.العنوان;
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو ((وصف_الرمز & 0x80) != 0) {
                    القوة := قوة_تعريف_رمز_ربط.ضعيف();
                };
                نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    معرف_القسم,
                    إزاحة_الرمز,
                    0
                );
            } وإلا {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح()
                );
            };

            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | _ -> {
                أرجع حول_نتيجة_تسجيل_رمز_ماتشو(نتيجة_التسجيل);
            };
        };

        دع حقيقة_الرمز: حقيقة_رمز_ماتشو_مدخل = {
            معرف_الربط: معرف_الربط,
            فهرس_القسم: فهرس_قسم_الرمز,
            القيمة: قيمة_الرمز,
            محلي: الرمز_محلي
        };
        ألحق(حقائق_الرموز, حقيقة_الرمز);
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    دع فهرس_القسم: متغير غير_موقع = 1;
    بينما (فهرس_القسم < (الطول(حقائق_الأقسام) مثل غير_موقع)) {
        دع حقيقة_القسم: حقيقة_قسم_ماتشو_مدخل = حقائق_الأقسام[فهرس_القسم];
        دع معرف_قسم_المصدر: معرف_قسم_ربط;
        طابق حقيقة_القسم.معرف_الربط مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
            );
        }
        | اختيار.بعض(المعرف) -> { معرف_قسم_المصدر := المعرف; };

        دع فهرس_الإزاحة: متغير غير_موقع = 0;
        دع إضافة_معلقة: متغير عدد = 0;
        دع له_إضافة_معلقة: متغير منطقي = خطأ;
        دع موضع_الإضافة_المعلقة: متغير غير_موقع = 0;
        بينما (فهرس_الإزاحة < حقيقة_القسم.عدد_الإزاحات) {
            دع موضع_الإزاحة: غير_موقع =
                حقيقة_القسم.موضع_الإزاحات + فهرس_الإزاحة * 8;
            دع عنوان_الإزاحة: غير_موقع =
                اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الإزاحة);
            دع معلومات_الإزاحة: غير_موقع =
                اقرأ_غ32_كائن_ماتشو(البايتات, موضع_الإزاحة + 4);
            لو ((عنوان_الإزاحة & 0x80000000) != 0) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                );
            };
            دع فهرس_المرجع: غير_موقع = معلومات_الإزاحة & 0x00FFFFFF;
            دع مرجع_خارجي: منطقي = (معلومات_الإزاحة & 0x08000000) != 0;
            دع رمز_صيغة_الإزاحة: غير_موقع = معلومات_الإزاحة / 16777216;
            دع نوع_الإزاحة: غير_موقع = رمز_صيغة_الإزاحة / 16;
            دع أس_عرض_الإزاحة: غير_موقع = (رمز_صيغة_الإزاحة / 2) & 3;
            دع عرض_الإزاحة: غير_موقع = 1 << أس_عرض_الإزاحة;
            // ARM64 instruction relocations carry a fixed 32-bit field.
            // PAGE21/BRANCH26 are PC relative; PAGEOFF12 is not.  Reject
            // contradictory relocation headers before creating a link edge.
            لو ((*السياق).الهدف.المعمارية.الهوية
                == هوية_معمارية.ذراع_أربعة_وستون()) {
                دع نسبي_للحاسوب: منطقي =
                    (معلومات_الإزاحة & 0x01000000) != 0;
                لو ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 4 || نوع_الإزاحة == 5
                        || نوع_الإزاحة == 6 || نوع_الإزاحة == 10)
                        && (عنوان_الإزاحة % 4) != 0) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                لو ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 5)
                        && (!نسبي_للحاسوب || عرض_الإزاحة != 4)
                    || (نوع_الإزاحة == 4 || نوع_الإزاحة == 6)
                        && (نسبي_للحاسوب || عرض_الإزاحة != 4)
                    || (نوع_الإزاحة == 5 || نوع_الإزاحة == 6)
                        && (!مرجع_خارجي || له_إضافة_معلقة)) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
            };
            لو (عنوان_الإزاحة > حقيقة_القسم.الحجم
                || عرض_الإزاحة > حقيقة_القسم.الحجم - عنوان_الإزاحة) {
                أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                    خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                );
            };

            // ARM64_RELOC_ADDEND stores a signed 24-bit addend in r_symbolnum.
            // It modifies the following relocation and is not an independent edge.
            لو (نوع_الإزاحة == 10
                && (*السياق).الهدف.المعمارية.الهوية
                    == هوية_معمارية.ذراع_أربعة_وستون()) {
                // An ADDEND must be immediately followed by the relocation
                // at the same address. Even a zero addend is not standalone.
                لو (له_إضافة_معلقة
                    || مرجع_خارجي
                    || (معلومات_الإزاحة & 0x01000000) != 0
                    || أس_عرض_الإزاحة != 2) {
                    // ADDEND is a 32-bit non-PC-relative, non-external pair.
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                له_إضافة_معلقة := صواب;
                موضع_الإضافة_المعلقة := عنوان_الإزاحة;
                لو ((فهرس_المرجع & 0x00800000) != 0) {
                    إضافة_معلقة := -(
                        (0x01000000 - فهرس_المرجع) مثل عدد
                    );
                } وإلا {
                    إضافة_معلقة := فهرس_المرجع مثل عدد;
                };
            } وإلا {
                // Paired ARM64 addends belong to a single instruction
                // relocation; never attach one to a pointer or a GOT edge.
                لو (له_إضافة_معلقة
                    && (عنوان_الإزاحة != موضع_الإضافة_المعلقة
                        || !(نوع_الإزاحة == 2
                            || نوع_الإزاحة == 3 || نوع_الإزاحة == 4)
                        || عرض_الإزاحة != 4
                        || (*السياق).الهدف.المعمارية.الهوية
                            != هوية_معمارية.ذراع_أربعة_وستون())) {
                    أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                        خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                    );
                };
                // GOT_LOAD_PAGE21/12 refer to the GOT slot of an external
                // symbol, not the address of a local section. The operand
                // starts with zero immediate and never takes an ADDEND pair.
                لو ((نوع_الإزاحة == 5 || نوع_الإزاحة == 6)
                    && (*السياق).الهدف.المعمارية.الهوية
                        == هوية_معمارية.ذراع_أربعة_وستون()) {
                    لو (حقيقة_القسم.موضع_الملف
                        > 0xFFFFFFFFFFFFFFFF - عنوان_الإزاحة
                        || !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            حقيقة_القسم.موضع_الملف + عنوان_الإزاحة,
                            4
                        )) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع التعليمة: غير_موقع = اقرأ_غ32_كائن_ماتشو(
                        البايتات,
                        حقيقة_القسم.موضع_الملف + عنوان_الإزاحة
                    );
                    لو (نوع_الإزاحة == 5
                        && ((التعليمة & 0x9F000000) != 0x90000000
                            || (التعليمة & 0x60FFFFE0) != 0)
                        || نوع_الإزاحة == 6
                        && ((التعليمة & 0xFFC00000) != 0xF9400000
                            || (التعليمة & 0x003FFC00) != 0)) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                };
                دع المرجع: مرجع_إزاحة_ربط;
                دع إضافة_المرجع: متغير عدد = إضافة_معلقة;
                // Canonical graph addends include implicit instruction values
                // from unpaired relocations. A paired ADDEND requires a zero
                // instruction immediate so the linker never applies it twice.
                لو ((نوع_الإزاحة == 2 || نوع_الإزاحة == 3
                        || نوع_الإزاحة == 4)
                    && (*السياق).الهدف.المعمارية.الهوية
                        == هوية_معمارية.ذراع_أربعة_وستون()) {
                    لو (حقيقة_القسم.موضع_الملف
                        > 0xFFFFFFFFFFFFFFFF - عنوان_الإزاحة
                        || !ضمن_حدود_كائن_ماتشو(
                            البايتات,
                            حقيقة_القسم.موضع_الملف + عنوان_الإزاحة,
                            4
                        )) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع التعليمة: غير_موقع = اقرأ_غ32_كائن_ماتشو(
                        البايتات,
                        حقيقة_القسم.موضع_الملف + عنوان_الإزاحة
                    );
                    دع الإزاحة_المضمنة: متغير عدد = 0;
                    لو (نوع_الإزاحة == 2) {
                        لو ((التعليمة & 0x7C000000) != 0x14000000) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع الخام: غير_موقع = التعليمة & 0x03FFFFFF;
                        الإزاحة_المضمنة := (الخام * 4) مثل عدد;
                        لو ((الخام & 0x02000000) != 0) {
                            الإزاحة_المضمنة := الإزاحة_المضمنة - 268435456;
                        };
                    } وإلا لو (نوع_الإزاحة == 3) {
                        لو ((التعليمة & 0x9F000000) != 0x90000000) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع الخام: غير_موقع = ((التعليمة >> 29) & 3)
                            | (((التعليمة >> 5) & 0x7FFFF) << 2);
                        الإزاحة_المضمنة := (الخام * 4096) مثل عدد;
                        لو ((الخام & 0x100000) != 0) {
                            الإزاحة_المضمنة := الإزاحة_المضمنة - 8589934592;
                        };
                    } وإلا {
                        دع تحميل_مباشر: منطقي =
                            (التعليمة & 0x3B000000) == 0x39000000;
                        دع جمع_مباشر: منطقي =
                            (التعليمة & 0x7F800000) == 0x11000000
                            && (التعليمة & 0x00400000) == 0;
                        لو (!تحميل_مباشر && !جمع_مباشر) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع مقياس_الوصول: متغير غير_موقع = 0;
                        لو (تحميل_مباشر) {
                            مقياس_الوصول := (التعليمة >> 30) & 3;
                            لو ((التعليمة & 0x04000000) != 0
                                && مقياس_الوصول == 0
                                && ((التعليمة >> 22) & 3) >= 2) {
                                مقياس_الوصول := 4;
                            };
                        };
                        الإزاحة_المضمنة :=
                            (((التعليمة >> 10) & 0xFFF) << مقياس_الوصول) مثل عدد;
                    };
                    لو (له_إضافة_معلقة && الإزاحة_المضمنة != 0) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    إضافة_المرجع := إضافة_المرجع + الإزاحة_المضمنة;
                };
                لو (مرجع_خارجي) {
                    لو (فهرس_المرجع >= عدد_الرموز) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    دع حقيقة_الرمز: حقيقة_رمز_ماتشو_مدخل =
                        حقائق_الرموز[فهرس_المرجع];
                    طابق حقيقة_الرمز.معرف_الربط مع
                    | اختيار.بعض(معرف_الرمز) -> {
                        المرجع := مرجع_إزاحة_ربط.رمز(معرف_الرمز);
                    }
                    | اختيار.لا_شيء -> {
                        // LLVM may encode a relocation as external even when
                        // its symbol-table target is local to this object. Such
                        // symbols must remain outside global name resolution;
                        // resolve them canonically as section + symbol offset.
                        لو (!حقيقة_الرمز.محلي
                            || حقيقة_الرمز.فهرس_القسم == 0
                            || حقيقة_الرمز.فهرس_القسم
                                >= (الطول(حقائق_الأقسام) مثل غير_موقع)) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع حقيقة_قسم_الهدف: حقيقة_قسم_ماتشو_مدخل =
                            حقائق_الأقسام[حقيقة_الرمز.فهرس_القسم];
                        دع معرف_قسم_الهدف: معرف_قسم_ربط;
                        طابق حقيقة_قسم_الهدف.معرف_الربط مع
                        | اختيار.لا_شيء -> {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        }
                        | اختيار.بعض(المعرف) -> {
                            معرف_قسم_الهدف := المعرف;
                        };
                        لو (حقيقة_الرمز.القيمة < حقيقة_قسم_الهدف.العنوان
                            || حقيقة_الرمز.القيمة - حقيقة_قسم_الهدف.العنوان
                                > حقيقة_قسم_الهدف.الحجم) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        دع إزاحة_الرمز_المحلي: غير_موقع =
                            حقيقة_الرمز.القيمة - حقيقة_قسم_الهدف.العنوان;
                        لو (إزاحة_الرمز_المحلي > 0x7FFFFFFFFFFFFFFF) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_قسم_الهدف);
                        // Resolve the local symbol as a section + signed
                        // offset without overflowing the relocation addend.
                        لو (إضافة_المرجع > 0
                            && إزاحة_الرمز_المحلي >
                                (0x7FFFFFFFFFFFFFFF - (إضافة_المرجع مثل غير_موقع))) {
                            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                            );
                        };
                        إضافة_المرجع := إضافة_المرجع
                            + (إزاحة_الرمز_المحلي مثل عدد);
                    };
                } وإلا {
                    لو (فهرس_المرجع == 0
                        || فهرس_المرجع
                            >= (الطول(حقائق_الأقسام) مثل غير_موقع)) {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    };
                    طابق حقائق_الأقسام[فهرس_المرجع].معرف_الربط مع
                    | اختيار.لا_شيء -> {
                        أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                            خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
                        );
                    }
                    | اختيار.بعض(معرف_قسم_الهدف) -> {
                        المرجع := مرجع_إزاحة_ربط.قسم(معرف_قسم_الهدف);
                    };
                };

                دع الحافة: حافة_إزاحة_ربط = {
                    القسم: معرف_قسم_المصدر,
                    الإزاحة: عنوان_الإزاحة,
                    المرجع: المرجع,
                    إضافة: إضافة_المرجع,
                    رمز_صيغة: رمز_صيغة_الإزاحة
                };
                أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
                إضافة_معلقة := 0;
                له_إضافة_معلقة := خطأ;
            };
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        لو (له_إضافة_معلقة) {
            أرجع نتيجة_استيعاب_كائن_ماتشو.خطأ(
                خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة()
            );
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    أرجع نتيجة_استيعاب_كائن_ماتشو.نجح();
}
