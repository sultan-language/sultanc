استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.symbol_table;

عام نوع جذر_وصول_ربط =
    | قسم بنوع معرف_قسم_ربط
    | رمز بنوع معرف_رمز_ربط
;

عام نوع حالة_وصول_ربط = {
    الجذور: متجه جذر_وصول_ربط
};

عام عرف أنشئ_حالة_وصول_ربط(): حالة_وصول_ربط {
    دع الجذور: متجه جذر_وصول_ربط = [];
    دع الحالة: حالة_وصول_ربط = { الجذور: الجذور };
    أرجع الحالة;
}

عام عرف أضف_جذر_قسم_ربط(
    الحالة: &متغير حالة_وصول_ربط,
    القسم: معرف_قسم_ربط
): فراغ {
    ألحق((*الحالة).الجذور, جذر_وصول_ربط.قسم(القسم));
}

عام عرف أضف_جذر_رمز_ربط(
    الحالة: &متغير حالة_وصول_ربط,
    الرمز: معرف_رمز_ربط
): فراغ {
    ألحق((*الحالة).الجذور, جذر_وصول_ربط.رمز(الرمز));
}

// Returns true only when the section changes from dead to live. This makes the
// reachability fixed point deterministic and independent of object producer.
عام عرف علّم_قسم_ربط_حيا(
    الأقسام: &متغير متجه قسم_ربط,
    القسم: معرف_قسم_ربط
): منطقي {
    لو (القسم.القيمة >= (الطول(*الأقسام) مثل غير_موقع)) {
        أرجع خطأ;
    };
    لو ((*الأقسام)[القسم.القيمة].المعرف.القيمة != القسم.القيمة) {
        أرجع خطأ;
    };
    لو ((*الأقسام)[القسم.القيمة].حي) {
        أرجع خطأ;
    };
    (*الأقسام)[القسم.القيمة].حي := صواب;
    أرجع صواب;
}

عرف علّم_رمز_ربط_حيا(
    الأقسام: &متغير متجه قسم_ربط,
    الرموز: &جدول_رموز_ربط,
    الرمز: معرف_رمز_ربط
): منطقي {
    طابق ابحث_رمز_ربط_بالمعرف(الرموز, الرمز) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الحقيقة) -> {
        طابق الحقيقة.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                أرجع علّم_قسم_ربط_حيا(الأقسام, القسم);
            }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    };
}

// Roots plus relocation edges define the generic liveness graph. Relocation
// opcode semantics stay format/architecture-specific; reachability needs only
// the already-resolved reference target.
عام عرف حل_وصول_أقسام_الربط(
    الحالة: &حالة_وصول_ربط,
    الأقسام: &متغير متجه قسم_ربط,
    الرموز: &جدول_رموز_ربط,
    الإزاحات: &متجه حافة_إزاحة_ربط
): فراغ {
    دع فهرس_الجذر: متغير غير_موقع = 0;
    بينما (فهرس_الجذر < (الطول((*الحالة).الجذور) مثل غير_موقع)) {
        طابق (*الحالة).الجذور[فهرس_الجذر] مع
        | جذر_وصول_ربط.قسم(القسم) -> {
            دع تغير_جذر_قسم: منطقي = علّم_قسم_ربط_حيا(الأقسام, القسم);
        }
        | جذر_وصول_ربط.رمز(الرمز) -> {
            دع تغير_جذر_رمز: منطقي = علّم_رمز_ربط_حيا(الأقسام, الرموز, الرمز);
        };
        فهرس_الجذر := فهرس_الجذر + 1;
    }

    دع تغير: متغير منطقي = صواب;
    بينما (تغير) {
        تغير := خطأ;
        دع فهرس_الحافة: متغير غير_موقع = 0;
        بينما (فهرس_الحافة < (الطول(*الإزاحات) مثل غير_موقع)) {
            دع الحافة: حافة_إزاحة_ربط = (*الإزاحات)[فهرس_الحافة];
            دع المصدر_حي: متغير منطقي = خطأ;
            لو (الحافة.القسم.القيمة < (الطول(*الأقسام) مثل غير_موقع)) {
                المصدر_حي := (*الأقسام)[الحافة.القسم.القيمة].حي;
            };
            لو (المصدر_حي) {
                دع تغير_الحافة: متغير منطقي = خطأ;
                طابق الحافة.المرجع مع
                | مرجع_إزاحة_ربط.قسم(القسم) -> {
                    تغير_الحافة := علّم_قسم_ربط_حيا(الأقسام, القسم);
                }
                | مرجع_إزاحة_ربط.رمز(الرمز) -> {
                    تغير_الحافة := علّم_رمز_ربط_حيا(الأقسام, الرموز, الرمز);
                };
                لو (تغير_الحافة) { تغير := صواب; };
            };
            فهرس_الحافة := فهرس_الحافة + 1;
        }
    }
}

عام عرف أضف_جذور_أقسام_التصحيح_للربط(
    الحالة: &متغير حالة_وصول_ربط,
    الأقسام: &متجه قسم_ربط
): فراغ {
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول(*الأقسام) مثل غير_موقع)) {
        طابق (*الأقسام)[فهرس_القسم].الصنف مع
        | صنف_قسم_ربط.تصحيح -> {
            أضف_جذر_قسم_ربط(
                الحالة,
                (*الأقسام)[فهرس_القسم].المعرف
            );
        }
        | _ -> { };
        فهرس_القسم := فهرس_القسم + 1;
    }
}

عام عرف علّم_كل_أقسام_الربط_حية(
    الأقسام: &متغير متجه قسم_ربط
): فراغ {
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول(*الأقسام) مثل غير_موقع)) {
        (*الأقسام)[فهرس_القسم].حي := صواب;
        فهرس_القسم := فهرس_القسم + 1;
    }
}

// A shared object must retain every externally visible definition because any
// one of them may be selected by a future dynamic consumer. Local symbols are
// intentionally absent from the canonical global symbol table.
عام عرف أضف_جذور_تعريفات_مشتركة_للربط(
    الحالة: &متغير حالة_وصول_ربط,
    الرموز: &جدول_رموز_ربط
): فراغ {
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*الرموز).الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*الرموز).الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.معرف(_) -> {
            أضف_جذر_رمز_ربط(الحالة, (*الرمز).المعرف);
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
}
