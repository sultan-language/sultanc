استورد compiler.link.section_model;

// Providers decide concrete layout; the generic linker stores one placement per
// canonical SectionID. File bytes and mapped memory size are distinct facts so
// zero-fill sections do not inflate the executable file.
عام نوع موضع_قسم_خرج_ربط = {
    القسم: معرف_قسم_ربط,
    إزاحة_الملف: غير_موقع,
    العنوان_الافتراضي: اختيار غير_موقع,
    حجم_الملف: غير_موقع,
    حجم_الذاكرة: غير_موقع
};

عام نوع تخطيط_خرج_ربط = {
    الأقسام: متجه اختيار موضع_قسم_خرج_ربط,
    حجم_الملف: غير_موقع
};

عام عرف أنشئ_تخطيط_خرج_ربط(): تخطيط_خرج_ربط {
    دع الأقسام: متجه اختيار موضع_قسم_خرج_ربط = [];
    دع التخطيط: تخطيط_خرج_ربط = {
        الأقسام: الأقسام,
        حجم_الملف: 0
    };
    أرجع التخطيط;
}

عام عرف أضف_موضع_قسم_خرج_ربط(
    التخطيط: &متغير تخطيط_خرج_ربط,
    الموضع: موضع_قسم_خرج_ربط
): فراغ {
    بينما (
        (الطول((*التخطيط).الأقسام) مثل غير_موقع)
            <= الموضع.القسم.القيمة
    ) {
        ألحق((*التخطيط).الأقسام, اختيار.لا_شيء());
    }
    (*التخطيط).الأقسام[الموضع.القسم.القيمة] := اختيار.بعض(الموضع);

    دع نهاية_بايتات_القسم: غير_موقع =
        الموضع.إزاحة_الملف + الموضع.حجم_الملف;
    لو (نهاية_بايتات_القسم > (*التخطيط).حجم_الملف) {
        (*التخطيط).حجم_الملف := نهاية_بايتات_القسم;
    };
}

عام عرف ابحث_موضع_قسم_خرج_ربط(
    التخطيط: &تخطيط_خرج_ربط,
    القسم: معرف_قسم_ربط
): اختيار موضع_قسم_خرج_ربط {
    لو (القسم.القيمة >= (الطول((*التخطيط).الأقسام) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع (*التخطيط).الأقسام[القسم.القيمة];
}
