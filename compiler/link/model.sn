        الخطة,
        صنف_مدخل_ربط.مكتبة_ديناميكية(),
        البايتات,
        المسار
    );
}

عام عرف أضف_مسار_تشغيل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    المسار: متجه غ8
): فراغ {
    ألحق((*الخطة).مسارات_التشغيل, المسار);
}

عام عرف ثبت_اسم_مخرج_ديناميكي_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الاسم: متجه غ8
): فراغ {
    (*الخطة).اسم_المخرج_الديناميكي := اختيار.بعض(الاسم);
}

عام عرف ثبت_إصدار_إل_إل_في_إم_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الإصدار_الكبير: غير_موقع
): فراغ {
    دع البيانات: بيانات_اعتماد_إل_إل_في_إم_أداة_ربط = {
        الإصدار_الكبير: الإصدار_الكبير,
        اسم_المكتبة: اختيار.لا_شيء(),
        دليل_البحث: اختيار.لا_شيء()
    };
    (*الخطة).بيانات_الأداة.إل_إل_في_إم := اختيار.بعض(البيانات);
}

عام عرف ثبت_اعتماد_إل_إل_في_إم_صريح_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الإصدار_الكبير: غير_موقع,
    الاسم: متجه غ8,
    دليل_البحث: اختيار متجه غ8
): فراغ {
    دع البيانات: بيانات_اعتماد_إل_إل_في_إم_أداة_ربط = {
        الإصدار_الكبير: الإصدار_الكبير,
        اسم_المكتبة: اختيار.بعض(الاسم),
        دليل_البحث: دليل_البحث
    };
    (*الخطة).بيانات_الأداة.إل_إل_في_إم := اختيار.بعض(البيانات);
}

عام عرف ثبت_أداة_إلف_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البرنامج: نص,
    المحمل_الديناميكي: اختيار متجه غ8,
    مكتبة_النظام_الافتراضية: اختيار متجه غ8,
    مسارات_بحث_المكتبات: متجه متجه غ8
): فراغ {
    دع البيانات: بيانات_أداة_ربط_إلف = {
        برنامج_الرابط: البرنامج,
        المحمل_الديناميكي: المحمل_الديناميكي,
        مكتبة_النظام_الافتراضية: مكتبة_النظام_الافتراضية,
        مسارات_بحث_المكتبات: مسارات_بحث_المكتبات
    };
    (*الخطة).بيانات_الأداة.إلف := اختيار.بعض(البيانات);
}

عام عرف ثبت_برنامج_رابط_إلف_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البرنامج: نص
): فراغ {
    دع المسارات: متجه متجه غ8 = [];
    ثبت_أداة_إلف_في_خطة_ربط(
        الخطة,
        البرنامج,
        اختيار.لا_شيء(),
        اختيار.لا_شيء(),
        المسارات
    );
}

عام عرف ثبت_برنامج_رابط_ويب_أسمبلي_في_خطة_ربط(
