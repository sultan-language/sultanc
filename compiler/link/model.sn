استورد compiler.backend.target.target_model;

// The linker plan is intentionally backend-neutral. Native and LLVM both end at
// relocatable inputs; only Target facts and object-format rules matter after that point.
عام نوع معرف_مدخل_ربط = {
    القيمة: غير_موقع
};

عام عرف معرف_مدخل_ربط_من(القيمة: غير_موقع): معرف_مدخل_ربط {
    دع المعرف: معرف_مدخل_ربط = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_مدخل_ربط_متساويان(
    المعرف_الأول: معرف_مدخل_ربط,
    المعرف_الثاني: معرف_مدخل_ربط
): منطقي {
    أرجع المعرف_الأول.القيمة == المعرف_الثاني.القيمة;
}

عام نوع صنف_مدخل_ربط =
    | كائن
    | أرشيف
    | مكتبة_ديناميكية
;

عام نوع مدخل_ربط = {
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8,
    المسار: اختيار نص
};

عام عرف أنشئ_مدخل_ربط_بأصل(
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8,
    المسار: اختيار نص
): مدخل_ربط {
    دع المدخل: مدخل_ربط = {
        المعرف: المعرف,
        الصنف: الصنف,
        البايتات: البايتات,
        المسار: المسار
    };
    أرجع المدخل;
}

عام عرف أنشئ_مدخل_ربط(
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8
): مدخل_ربط {
    أرجع أنشئ_مدخل_ربط_بأصل(
        المعرف,
        الصنف,
        البايتات,
        اختيار.لا_شيء()
    );
}

عام عرف أنشئ_مدخل_كائن_ربط(
    المعرف: معرف_مدخل_ربط,
    البايتات: متجه غ8
): مدخل_ربط {
    أرجع أنشئ_مدخل_ربط(المعرف, صنف_مدخل_ربط.كائن(), البايتات);
}

عام نوع هوية_اعتماد_مكتبة_ديناميكية_ربط =
    | عام
    | إل_إل_في_إم
;

عام نوع اعتماد_مكتبة_ديناميكية_ربط = {
    الاسم: متجه غ8,
    دليل_البحث: اختيار متجه غ8,
    المدخل: اختيار معرف_مدخل_ربط,
    الهوية: هوية_اعتماد_مكتبة_ديناميكية_ربط
};

عام عرف اعتماد_مكتبة_ديناميكية_باسم(
    الاسم: متجه غ8
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاعتماد: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: اختيار.لا_شيء(),
        المدخل: اختيار.لا_شيء(),
        الهوية: هوية_اعتماد_مكتبة_ديناميكية_ربط.عام()
    };
    أرجع الاعتماد;
}

عام عرف اعتماد_مكتبة_ديناميكية_بمسار(
    الاسم: متجه غ8,
    الدليل: متجه غ8
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاعتماد: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: اختيار.بعض(الدليل),
        المدخل: اختيار.لا_شيء(),
        الهوية: هوية_اعتماد_مكتبة_ديناميكية_ربط.عام()
    };
    أرجع الاعتماد;
}


عام عرف اعتماد_مكتبة_إل_إل_في_إم_باسم(
    الاسم: متجه غ8
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاعتماد: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: اختيار.لا_شيء(),
        المدخل: اختيار.لا_شيء(),
        الهوية: هوية_اعتماد_مكتبة_ديناميكية_ربط.إل_إل_في_إم()
    };
    أرجع الاعتماد;
}

عام عرف اربط_اعتماد_ديناميكي_بمدخل(
    الاعتماد: &متغير اعتماد_مكتبة_ديناميكية_ربط,
    المدخل: معرف_مدخل_ربط
): فراغ {
    (*الاعتماد).المدخل := اختيار.بعض(المدخل);
}

عام نوع بيانات_اعتماد_إل_إل_في_إم_أداة_ربط = {
    الإصدار_الكبير: غير_موقع,
    اسم_المكتبة: اختيار متجه غ8,
    دليل_البحث: اختيار متجه غ8
};

عام نوع بيانات_أداة_ربط_إلف = {
    برنامج_الرابط: نص,
    المحمل_الديناميكي: اختيار متجه غ8,
    مكتبة_النظام_الافتراضية: اختيار متجه غ8,
    مسارات_بحث_المكتبات: متجه متجه غ8
};

عام نوع بيانات_أداة_ربط_ويب_أسمبلي = {
    برنامج_الرابط: نص
};

عام نوع بيانات_أداة_ربط_سبير_في = {
    برنامج_الرابط: نص
};

عام نوع بيانات_أداة_ربط = {
    إل_إل_في_إم: اختيار بيانات_اعتماد_إل_إل_في_إم_أداة_ربط,
    إلف: اختيار بيانات_أداة_ربط_إلف,
    ويب_أسمبلي: اختيار بيانات_أداة_ربط_ويب_أسمبلي,
    سبير_في: اختيار بيانات_أداة_ربط_سبير_في
};

عام عرف بيانات_أداة_ربط_فارغة(): بيانات_أداة_ربط {
    دع البيانات: بيانات_أداة_ربط = {
        إل_إل_في_إم: اختيار.لا_شيء(),
        إلف: اختيار.لا_شيء(),
        ويب_أسمبلي: اختيار.لا_شيء(),
        سبير_في: اختيار.لا_شيء()
    };
    أرجع البيانات;
}

عام نوع نوع_خرج_ربط =
    | تنفيذي
    | مكتبة_مشتركة
    | كائن_مترابط
    | وحدة_هدف
;

عام نوع سياسة_تجريد_ربط =
    | احتفظ_بالكل
    | جرد_غير_المستخدم
;

// TargetID is the only target identity carried by the plan. Backend identity is
// deliberately absent: a linker must accept any conforming object producer.
عام نوع خطة_ربط = {
    الهدف: معرف_هدف,
    الخرج: نوع_خرج_ربط,
    المدخلات: متجه مدخل_ربط,
    المكتبات_الديناميكية: متجه اعتماد_مكتبة_ديناميكية_ربط,
    مسارات_التشغيل: متجه متجه غ8,
    اسم_المخرج_الديناميكي: اختيار متجه غ8,
    بيانات_الأداة: بيانات_أداة_ربط,
    رمز_الدخول: اختيار متجه غ8,
    سياسة_التجريد: سياسة_تجريد_ربط
};

عرف انسخ_بايتات_خطة_ربط(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف انسخ_نص_خطة_ربط(المصدر: &نص): نص {
    دع النسخة: نص = *المصدر;
    أرجع النسخة;
}

عرف انسخ_اختيار_بايتات_خطة_ربط(
    المصدر: &اختيار متجه غ8
): اختيار متجه غ8 {
    طابق *المصدر مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(انسخ_بايتات_خطة_ربط(&القيمة));
    };
}

عرف انسخ_اختيار_نص_خطة_ربط(المصدر: &اختيار نص): اختيار نص {
    طابق *المصدر مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> {
        أرجع اختيار.بعض(انسخ_نص_خطة_ربط(&القيمة));
    };
}

عرف انسخ_مدخل_خطة_ربط(المصدر: &مدخل_ربط): مدخل_ربط {
    دع البايتات: متجه غ8 = انسخ_بايتات_خطة_ربط(&(*المصدر).البايتات);
    دع المسار: اختيار نص = انسخ_اختيار_نص_خطة_ربط(&(*المصدر).المسار);
    أرجع أنشئ_مدخل_ربط_بأصل(
        (*المصدر).المعرف,
        (*المصدر).الصنف,
        البايتات,
        المسار
    );
}

عرف انسخ_اعتماد_خطة_ربط(
    المصدر: &اعتماد_مكتبة_ديناميكية_ربط
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاسم: متجه غ8 = انسخ_بايتات_خطة_ربط(&(*المصدر).الاسم);
    دع دليل_البحث: اختيار متجه غ8 =
        انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).دليل_البحث);
    دع النسخة: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: دليل_البحث,
        المدخل: (*المصدر).المدخل,
        الهوية: (*المصدر).الهوية
    };
    أرجع النسخة;
}

عرف انسخ_بيانات_إل_إل_في_إم_خطة_ربط(
    المصدر: &بيانات_اعتماد_إل_إل_في_إم_أداة_ربط
): بيانات_اعتماد_إل_إل_في_إم_أداة_ربط {
    دع النسخة: بيانات_اعتماد_إل_إل_في_إم_أداة_ربط = {
        الإصدار_الكبير: (*المصدر).الإصدار_الكبير,
        اسم_المكتبة: انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).اسم_المكتبة),
        دليل_البحث: انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).دليل_البحث)
    };
    أرجع النسخة;
}

عرف انسخ_بيانات_إلف_خطة_ربط(
    المصدر: &بيانات_أداة_ربط_إلف
): بيانات_أداة_ربط_إلف {
    دع مسارات_البحث: متغير متجه متجه غ8 = [];
    دع فهرس_المسار: متغير غير_موقع = 0;
    بينما (
        فهرس_المسار
            < (الطول((*المصدر).مسارات_بحث_المكتبات) مثل غير_موقع)
    ) {
        دع نسخة_المسار: متجه غ8 = انسخ_بايتات_خطة_ربط(
            &(*المصدر).مسارات_بحث_المكتبات[فهرس_المسار]
        );
        ألحق(مسارات_البحث, نسخة_المسار);
        فهرس_المسار := فهرس_المسار + 1;
    }
    دع النسخة: بيانات_أداة_ربط_إلف = {
        برنامج_الرابط: انسخ_نص_خطة_ربط(&(*المصدر).برنامج_الرابط),
        المحمل_الديناميكي: انسخ_اختيار_بايتات_خطة_ربط(
            &(*المصدر).المحمل_الديناميكي
        ),
        مكتبة_النظام_الافتراضية: انسخ_اختيار_بايتات_خطة_ربط(
            &(*المصدر).مكتبة_النظام_الافتراضية
        ),
        مسارات_بحث_المكتبات: مسارات_البحث
    };
    أرجع النسخة;
}

عرف انسخ_بيانات_أداة_خطة_ربط(
    المصدر: &بيانات_أداة_ربط
): بيانات_أداة_ربط {
    دع بيانات_إل_إل_في_إم: متغير اختيار بيانات_اعتماد_إل_إل_في_إم_أداة_ربط =
        اختيار.لا_شيء();
    طابق (*المصدر).إل_إل_في_إم مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        بيانات_إل_إل_في_إم := اختيار.بعض(
            انسخ_بيانات_إل_إل_في_إم_خطة_ربط(&القيمة)
        );
    };

    دع بيانات_إلف: متغير اختيار بيانات_أداة_ربط_إلف = اختيار.لا_شيء();
    طابق (*المصدر).إلف مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        بيانات_إلف := اختيار.بعض(انسخ_بيانات_إلف_خطة_ربط(&القيمة));
    };

    دع بيانات_ويب_أسمبلي: متغير اختيار بيانات_أداة_ربط_ويب_أسمبلي =
        اختيار.لا_شيء();
    طابق (*المصدر).ويب_أسمبلي مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        دع النسخة: بيانات_أداة_ربط_ويب_أسمبلي = {
            برنامج_الرابط: انسخ_نص_خطة_ربط(&القيمة.برنامج_الرابط)
        };
        بيانات_ويب_أسمبلي := اختيار.بعض(النسخة);
    };

    دع بيانات_سبير_في: متغير اختيار بيانات_أداة_ربط_سبير_في =
        اختيار.لا_شيء();
    طابق (*المصدر).سبير_في مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(القيمة) -> {
        دع النسخة: بيانات_أداة_ربط_سبير_في = {
            برنامج_الرابط: انسخ_نص_خطة_ربط(&القيمة.برنامج_الرابط)
        };
        بيانات_سبير_في := اختيار.بعض(النسخة);
    };

    دع النسخة: بيانات_أداة_ربط = {
        إل_إل_في_إم: بيانات_إل_إل_في_إم,
        إلف: بيانات_إلف,
        ويب_أسمبلي: بيانات_ويب_أسمبلي,
        سبير_في: بيانات_سبير_في
    };
    أرجع النسخة;
}

عام عرف انسخ_خطة_ربط(المصدر: &خطة_ربط): خطة_ربط {
    دع المدخلات: متغير متجه مدخل_ربط = [];
    دع فهرس_المدخل: متغير غير_موقع = 0;
    بينما (فهرس_المدخل < (الطول((*المصدر).المدخلات) مثل غير_موقع)) {
        ألحق(
            المدخلات,
            انسخ_مدخل_خطة_ربط(&(*المصدر).المدخلات[فهرس_المدخل])
        );
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع المكتبات: متغير متجه اعتماد_مكتبة_ديناميكية_ربط = [];
    دع فهرس_المكتبة: متغير غير_موقع = 0;
    بينما (
        فهرس_المكتبة
            < (الطول((*المصدر).المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        ألحق(
            المكتبات,
            انسخ_اعتماد_خطة_ربط(
                &(*المصدر).المكتبات_الديناميكية[فهرس_المكتبة]
            )
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }

    دع مسارات_التشغيل: متغير متجه متجه غ8 = [];
    دع فهرس_مسار_التشغيل: متغير غير_موقع = 0;
    بينما (
        فهرس_مسار_التشغيل
            < (الطول((*المصدر).مسارات_التشغيل) مثل غير_موقع)
    ) {
        ألحق(
            مسارات_التشغيل,
            انسخ_بايتات_خطة_ربط(
                &(*المصدر).مسارات_التشغيل[فهرس_مسار_التشغيل]
            )
        );
        فهرس_مسار_التشغيل := فهرس_مسار_التشغيل + 1;
    }

    دع النسخة: خطة_ربط = {
        الهدف: (*المصدر).الهدف,
        الخرج: (*المصدر).الخرج,
        المدخلات: المدخلات,
        المكتبات_الديناميكية: المكتبات,
        مسارات_التشغيل: مسارات_التشغيل,
        اسم_المخرج_الديناميكي: انسخ_اختيار_بايتات_خطة_ربط(
            &(*المصدر).اسم_المخرج_الديناميكي
        ),
        بيانات_الأداة: انسخ_بيانات_أداة_خطة_ربط(&(*المصدر).بيانات_الأداة),
        رمز_الدخول: انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).رمز_الدخول),
        سياسة_التجريد: (*المصدر).سياسة_التجريد
    };
    أرجع النسخة;
}

عام عرف أنشئ_خطة_ربط(
    الهدف: معرف_هدف,
    الخرج: نوع_خرج_ربط
): خطة_ربط {
    دع المدخلات: متجه مدخل_ربط = [];
    دع المكتبات: متجه اعتماد_مكتبة_ديناميكية_ربط = [];
    دع مسارات_التشغيل: متجه متجه غ8 = [];
    دع الخطة: خطة_ربط = {
        الهدف: الهدف,
        الخرج: الخرج,
        المدخلات: المدخلات,
        المكتبات_الديناميكية: المكتبات,
        مسارات_التشغيل: مسارات_التشغيل,
        اسم_المخرج_الديناميكي: اختيار.لا_شيء(),
        بيانات_الأداة: بيانات_أداة_ربط_فارغة(),
        رمز_الدخول: اختيار.لا_شيء(),
        سياسة_التجريد: سياسة_تجريد_ربط.جرد_غير_المستخدم()
    };
    أرجع الخطة;
}

عام عرف أضف_مدخل_بأصل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8,
    المسار: اختيار نص
): معرف_مدخل_ربط {
    دع المعرف: معرف_مدخل_ربط = معرف_مدخل_ربط_من(
        الطول((*الخطة).المدخلات) مثل غير_موقع
    );
    ألحق(
        (*الخطة).المدخلات,
        أنشئ_مدخل_ربط_بأصل(المعرف, الصنف, البايتات, المسار)
    );
    أرجع المعرف;
}

عام عرف أضف_مدخل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_بأصل_إلى_خطة_ربط(
        الخطة,
        الصنف,
        البايتات,
        اختيار.لا_شيء()
    );
}

عام عرف أضف_كائن_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه غ8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_إلى_خطة_ربط(الخطة, صنف_مدخل_ربط.كائن(), البايتات);
}

عام عرف أضف_أرشيف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه غ8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_إلى_خطة_ربط(
        الخطة,
        صنف_مدخل_ربط.أرشيف(),
        البايتات
    );
}

عام عرف أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الاعتماد: اعتماد_مكتبة_ديناميكية_ربط
): فراغ {
    ألحق((*الخطة).المكتبات_الديناميكية, الاعتماد);
}

عام عرف أنشئ_خطة_ربط_تنفيذي_بكائن(
    الهدف: معرف_هدف,
    بايتات_الكائن: متجه غ8
): خطة_ربط {
    دع الخطة: متغير خطة_ربط = أنشئ_خطة_ربط(الهدف, نوع_خرج_ربط.تنفيذي());
    دع المعرف: معرف_مدخل_ربط = أضف_كائن_إلى_خطة_ربط(&متغير الخطة, بايتات_الكائن);
    أرجع الخطة;
}

عام عرف أضف_مدخل_ملف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه غ8,
    المسار: نص
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_بأصل_إلى_خطة_ربط(
        الخطة,
        الصنف,
        البايتات,
        اختيار.بعض(المسار)
    );
}


عام عرف أضف_مكتبة_ديناميكية_ملف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه غ8,
