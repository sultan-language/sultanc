استورد std.text.from_bytes;
استورد compiler.backend.target.target_model;

// The linker plan is intentionally backend-neutral. Native and LLVM both end at
// relocatable inputs; only Target facts and object-format rules matter after that point.
عام نوع معرف_مدخل_ربط = {
    القيمة: طبيعي
};

عام عرف معرف_مدخل_ربط_من(القيمة: طبيعي): معرف_مدخل_ربط {
    دع المعرف: معرف_مدخل_ربط = { القيمة: القيمة };
    أرجع المعرف;
}

عام عرف معرفا_مدخل_ربط_متساويان(
    المعرف_الأول: معرف_مدخل_ربط,
    المعرف_الثاني: معرف_مدخل_ربط
): منطقي {
    أرجع المعرف_الأول.القيمة == المعرف_الثاني.القيمة;
}

عام نوع صنف_مدخل_ربط =
    | كائن
    | أرشيف
    | مكتبة_ديناميكية
;

// How an input entered the plan. Inputs keep the order in which they were
// added, which is the link order; provenance records why each one is there:
//   * مباشر: named by the link request or added by the linker itself (a
//     default library, the host libLLVM, an extracted archive member, whose
//     archive identity the archive registry owns);
//   * من_سكربت: named by the GNU input script with the first id (itself
//     possibly named by an outer script, so nesting is the chain of parents),
//     and linked as needed when the flag is set: named inside AS_NEEDED(...),
//     or named by a script that was itself read as needed, as LLD reads a
//     nested script while config->asNeeded is set.
// سكربت_جنو marks an input that is a GNU input script
// (link/elf/linker_script.sn): it contributes no sections or symbols of its
// own, the inputs it names follow it in the plan, and it is neither ingested
// nor passed to a delegated linker.
// Previously the plan held no provenance, and every consumer re-parsed the
// scripts and matched the following inputs' paths to recover it.
عام نوع أصل_مدخل_ربط =
    | مباشر
    | من_سكربت بنوع (معرف_مدخل_ربط, منطقي)
;

عام نوع مدخل_ربط = {
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: اختياري نص,
    الأصل: أصل_مدخل_ربط,
    سكربت_جنو: منطقي
};

عام عرف مدخل_ربط_سكربت_جنو(المدخل: &مدخل_ربط): منطقي {
    أرجع (*المدخل).سكربت_جنو;
}

// An input linked as needed: a shared library becomes a dependency only when
// a regular object uses one of its definitions.
عام عرف مدخل_ربط_حسب_الحاجة(المدخل: &مدخل_ربط): منطقي {
    طابق (*المدخل).الأصل مع
    | أصل_مدخل_ربط.من_سكربت(_, حسب_الحاجة) -> { أرجع حسب_الحاجة; }
    | _ -> { أرجع خطأ; };
}

// Whether the input with this id is linked as needed.
عام عرف معرف_مدخل_ربط_حسب_الحاجة(
    الخطة: &خطة_ربط,
    المعرف: معرف_مدخل_ربط
): منطقي {
    لو (المعرف.القيمة >= (الطول((*الخطة).المدخلات) مثل طبيعي)) {
        أرجع خطأ;
    };
    أرجع مدخل_ربط_حسب_الحاجة(&(*الخطة).المدخلات[المعرف.القيمة]);
}

عام عرف أنشئ_مدخل_ربط_بأصل(
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: اختياري نص
): مدخل_ربط {
    أرجع أنشئ_مدخل_ربط_بمصدر(
        المعرف,
        الصنف,
        البايتات,
        المسار,
        أصل_مدخل_ربط.مباشر(),
        خطأ
    );
}

عام عرف أنشئ_مدخل_ربط_بمصدر(
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: اختياري نص,
    الأصل: أصل_مدخل_ربط,
    سكربت_جنو: منطقي
): مدخل_ربط {
    دع المدخل: مدخل_ربط = {
        المعرف: المعرف,
        الصنف: الصنف,
        البايتات: البايتات,
        المسار: المسار,
        الأصل: الأصل,
        سكربت_جنو: سكربت_جنو
    };
    أرجع المدخل;
}

عام عرف أنشئ_مدخل_ربط(
    المعرف: معرف_مدخل_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8
): مدخل_ربط {
    أرجع أنشئ_مدخل_ربط_بأصل(
        المعرف,
        الصنف,
        البايتات,
        اختياري.لا_شيء()
    );
}

عام عرف أنشئ_مدخل_كائن_ربط(
    المعرف: معرف_مدخل_ربط,
    البايتات: متجه ط8
): مدخل_ربط {
    أرجع أنشئ_مدخل_ربط(المعرف, صنف_مدخل_ربط.كائن(), البايتات);
}

عام نوع اعتماد_مكتبة_ديناميكية_ربط = {
    الاسم: متجه ط8,
    دليل_البحث: اختياري متجه ط8,
    // The dynamic-library input that defines this dependency's symbols.
    المدخل: اختياري معرف_مدخل_ربط
};

عام عرف اعتماد_مكتبة_ديناميكية_باسم(
    الاسم: متجه ط8
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاعتماد: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: اختياري.لا_شيء(),
        المدخل: اختياري.لا_شيء()
    };
    أرجع الاعتماد;
}

عام عرف اعتماد_مكتبة_ديناميكية_بمسار(
    الاسم: متجه ط8,
    الدليل: متجه ط8
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاعتماد: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: اختياري.موجود(الدليل),
        المدخل: اختياري.لا_شيء()
    };
    أرجع الاعتماد;
}


عام عرف اربط_اعتماد_ديناميكي_بمدخل(
    الاعتماد: &متغير اعتماد_مكتبة_ديناميكية_ربط,
    المدخل: معرف_مدخل_ربط
): فراغ {
    (*الاعتماد).المدخل := اختياري.موجود(المدخل);
}

// The libLLVM the running compiler itself uses: a fact about the compiler's
// host, valid only for outputs whose target is that host
// (link/dependency/llvm.sn). المسار is the file the host loader mapped;
// هدف_المضيف is the registered host target of the compiler that found it.
عام نوع بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط = {
    المسار: نص,
    هدف_المضيف: معرف_هدف
};

// Facts about the compiler's environment that a link may use. SultanC runs
// no external linker program, so the plan records no linker tool; the only
// such fact is the host libLLVM (link/dependency/llvm.sn). Previously ELF,
// WebAssembly and SPIR-V plans also named ld.lld, wasm-ld or spirv-link and
// the ELF loader and library search paths handed to them.
عام نوع بيانات_أداة_ربط = {
    إل_إل_في_إم_المضيف: اختياري بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط
};

عام عرف بيانات_أداة_ربط_فارغة(): بيانات_أداة_ربط {
    دع البيانات: بيانات_أداة_ربط = {
        إل_إل_في_إم_المضيف: اختياري.لا_شيء()
    };
    أرجع البيانات;
}

عام نوع نوع_خرج_ربط =
    | تنفيذي
    | مكتبة_مشتركة
    | كائن_مترابط
    | وحدة_هدف
;

عام نوع سياسة_تجريد_ربط =
    | احتفظ_بالكل
    | جرد_غير_المستخدم
;

// A function the program declares as imported from a named platform library
// (`خارجي «kernel32.dll» عرف GetLastError(): ط32;`). الرمز is the canonical
// linker name (the MSIR external's name, without a format's C prefix), المكتبة
// the library as the target's loader names it: a PE DLL (`kernel32.dll`) or a
// Mach-O install name (`/usr/lib/libSystem.B.dylib`). The COFF and Mach-O
// linkers import a symbol no input defines from its declared library, as
// rustc's raw-dylib import libraries and Go's cgo_import_dynamic directives
// carry the library of each import to the linker; WebAssembly objects carry
// their import modules themselves. Previously the compiler held fixed
// per-target symbol tables (runtime_symbol_query_context.sn).
عام نوع استيراد_مكتبة_مصرح_ربط = {
    الرمز: متجه ط8,
    المكتبة: متجه ط8
};

// TargetID is the only target identity carried by the plan. Backend identity is
// deliberately absent: a linker must accept any conforming object producer.
عام نوع خطة_ربط = {
    الهدف: معرف_هدف,
    الخرج: نوع_خرج_ربط,
    المدخلات: متجه مدخل_ربط,
    المكتبات_الديناميكية: متجه اعتماد_مكتبة_ديناميكية_ربط,
    مسارات_التشغيل: متجه متجه ط8,
    اسم_المخرج_الديناميكي: اختياري متجه ط8,
    بيانات_الأداة: بيانات_أداة_ربط,
    رمز_الدخول: اختياري متجه ط8,
    سياسة_التجريد: سياسة_تجريد_ربط,
    الاستيرادات_المصرحة: متجه استيراد_مكتبة_مصرح_ربط
};

عرف انسخ_بايتات_خطة_ربط(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف انسخ_نص_خطة_ربط(المصدر: &نص): نص {
    دع النسخة: نص = انسخ_نص(المصدر);
    أرجع النسخة;
}

عرف انسخ_اختيار_بايتات_خطة_ربط(
    المصدر: &اختياري متجه ط8
): اختياري متجه ط8 {
    طابق *المصدر مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(انسخ_بايتات_خطة_ربط(&القيمة));
    };
}

عرف انسخ_اختيار_نص_خطة_ربط(المصدر: &اختياري نص): اختياري نص {
    طابق *المصدر مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        أرجع اختياري.موجود(انسخ_نص_خطة_ربط(&القيمة));
    };
}

عرف انسخ_مدخل_خطة_ربط(المصدر: &مدخل_ربط): مدخل_ربط {
    // The source request remains live for the entire link. Copy the whole
    // descriptor (not a partial owned field move): ELF/Mach-O/archive input
    // bytes stay immutable, so both plans safely refer to the same storage.
    // This removes the eager O(input bytes) clone from plan construction.
    دع النسخة: مدخل_ربط = انسخ_مملوكا_مدخل_ربط(المصدر);
    أرجع النسخة;
}

عرف انسخ_اعتماد_خطة_ربط(
    المصدر: &اعتماد_مكتبة_ديناميكية_ربط
): اعتماد_مكتبة_ديناميكية_ربط {
    دع الاسم: متجه ط8 = انسخ_بايتات_خطة_ربط(&(*المصدر).الاسم);
    دع دليل_البحث: اختياري متجه ط8 =
        انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).دليل_البحث);
    دع النسخة: اعتماد_مكتبة_ديناميكية_ربط = {
        الاسم: الاسم,
        دليل_البحث: دليل_البحث,
        المدخل: (*المصدر).المدخل
    };
    أرجع النسخة;
}

عرف انسخ_بيانات_إل_إل_في_إم_خطة_ربط(
    المصدر: &بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط
): بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط {
    دع النسخة: بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط = {
        المسار: انسخ_نص_خطة_ربط(&(*المصدر).المسار),
        هدف_المضيف: (*المصدر).هدف_المضيف
    };
    أرجع النسخة;
}

عرف انسخ_بيانات_أداة_خطة_ربط(
    المصدر: &بيانات_أداة_ربط
): بيانات_أداة_ربط {
    دع بيانات_إل_إل_في_إم: متغير اختياري بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط =
        اختياري.لا_شيء();
    طابق (*المصدر).إل_إل_في_إم_المضيف مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        بيانات_إل_إل_في_إم := اختياري.موجود(
            انسخ_بيانات_إل_إل_في_إم_خطة_ربط(&القيمة)
        );
    };

    دع النسخة: بيانات_أداة_ربط = {
        إل_إل_في_إم_المضيف: بيانات_إل_إل_في_إم
    };
    أرجع النسخة;
}

عام عرف انسخ_خطة_ربط(المصدر: &خطة_ربط): خطة_ربط {
    دع المدخلات: متغير متجه مدخل_ربط = [];
    دع فهرس_المدخل: متغير طبيعي = 0;
    طالما (فهرس_المدخل < (الطول((*المصدر).المدخلات) مثل طبيعي)) {
        ألحق(
            المدخلات,
            انسخ_مدخل_خطة_ربط(&(*المصدر).المدخلات[فهرس_المدخل])
        );
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع المكتبات: متغير متجه اعتماد_مكتبة_ديناميكية_ربط = [];
    دع فهرس_المكتبة: متغير طبيعي = 0;
    طالما (
        فهرس_المكتبة
            < (الطول((*المصدر).المكتبات_الديناميكية) مثل طبيعي)
    ) {
        ألحق(
            المكتبات,
            انسخ_اعتماد_خطة_ربط(
                &(*المصدر).المكتبات_الديناميكية[فهرس_المكتبة]
            )
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }

    دع مسارات_التشغيل: متغير متجه متجه ط8 = [];
    دع فهرس_مسار_التشغيل: متغير طبيعي = 0;
    طالما (
        فهرس_مسار_التشغيل
            < (الطول((*المصدر).مسارات_التشغيل) مثل طبيعي)
    ) {
        ألحق(
            مسارات_التشغيل,
            انسخ_بايتات_خطة_ربط(
                &(*المصدر).مسارات_التشغيل[فهرس_مسار_التشغيل]
            )
        );
        فهرس_مسار_التشغيل := فهرس_مسار_التشغيل + 1;
    }

    دع الاستيرادات: متغير متجه استيراد_مكتبة_مصرح_ربط = [];
    دع فهرس_الاستيراد: متغير طبيعي = 0;
    طالما (
        فهرس_الاستيراد
            < (الطول((*المصدر).الاستيرادات_المصرحة) مثل طبيعي)
    ) {
        دع مرجع_الاستيراد: &استيراد_مكتبة_مصرح_ربط =
            &(*المصدر).الاستيرادات_المصرحة[فهرس_الاستيراد];
        دع نسخة_الاستيراد: استيراد_مكتبة_مصرح_ربط = {
            الرمز: انسخ_بايتات_خطة_ربط(&(*مرجع_الاستيراد).الرمز),
            المكتبة: انسخ_بايتات_خطة_ربط(&(*مرجع_الاستيراد).المكتبة)
        };
        ألحق(الاستيرادات, نسخة_الاستيراد);
        فهرس_الاستيراد := فهرس_الاستيراد + 1;
    }

    دع النسخة: خطة_ربط = {
        الهدف: (*المصدر).الهدف,
        الخرج: (*المصدر).الخرج,
        المدخلات: المدخلات,
        المكتبات_الديناميكية: المكتبات,
        مسارات_التشغيل: مسارات_التشغيل,
        اسم_المخرج_الديناميكي: انسخ_اختيار_بايتات_خطة_ربط(
            &(*المصدر).اسم_المخرج_الديناميكي
        ),
        بيانات_الأداة: انسخ_بيانات_أداة_خطة_ربط(&(*المصدر).بيانات_الأداة),
        رمز_الدخول: انسخ_اختيار_بايتات_خطة_ربط(&(*المصدر).رمز_الدخول),
        سياسة_التجريد: (*المصدر).سياسة_التجريد,
        الاستيرادات_المصرحة: الاستيرادات
    };
    أرجع النسخة;
}

عام عرف أنشئ_خطة_ربط(
    الهدف: معرف_هدف,
    الخرج: نوع_خرج_ربط
): خطة_ربط {
    دع المدخلات: متجه مدخل_ربط = [];
    دع المكتبات: متجه اعتماد_مكتبة_ديناميكية_ربط = [];
    دع مسارات_التشغيل: متجه متجه ط8 = [];
    دع الاستيرادات: متجه استيراد_مكتبة_مصرح_ربط = [];
    دع الخطة: خطة_ربط = {
        الهدف: الهدف,
        الخرج: الخرج,
        المدخلات: المدخلات,
        المكتبات_الديناميكية: المكتبات,
        مسارات_التشغيل: مسارات_التشغيل,
        اسم_المخرج_الديناميكي: اختياري.لا_شيء(),
        بيانات_الأداة: بيانات_أداة_ربط_فارغة(),
        رمز_الدخول: اختياري.لا_شيء(),
        سياسة_التجريد: سياسة_تجريد_ربط.جرد_غير_المستخدم(),
        الاستيرادات_المصرحة: الاستيرادات
    };
    أرجع الخطة;
}

عام عرف أضف_مدخل_بأصل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: اختياري نص
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_بمصدر_إلى_خطة_ربط(
        الخطة,
        الصنف,
        البايتات,
        المسار,
        أصل_مدخل_ربط.مباشر(),
        خطأ
    );
}

// Input ids are the inputs' positions in the plan (معرف_مدخل_ربط_حسب_الحاجة
// relies on it).
عام عرف أضف_مدخل_بمصدر_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: اختياري نص,
    الأصل: أصل_مدخل_ربط,
    سكربت_جنو: منطقي
): معرف_مدخل_ربط {
    دع المعرف: معرف_مدخل_ربط = معرف_مدخل_ربط_من(
        الطول((*الخطة).المدخلات) مثل طبيعي
    );
    ألحق(
        (*الخطة).المدخلات,
        أنشئ_مدخل_ربط_بمصدر(المعرف, الصنف, البايتات, المسار, الأصل, سكربت_جنو)
    );
    أرجع المعرف;
}

عام عرف أضف_مدخل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_بأصل_إلى_خطة_ربط(
        الخطة,
        الصنف,
        البايتات,
        اختياري.لا_شيء()
    );
}

عام عرف أضف_كائن_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه ط8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_إلى_خطة_ربط(الخطة, صنف_مدخل_ربط.كائن(), البايتات);
}

عام عرف أضف_أرشيف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه ط8
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_إلى_خطة_ربط(
        الخطة,
        صنف_مدخل_ربط.أرشيف(),
        البايتات
    );
}

عام عرف أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الاعتماد: اعتماد_مكتبة_ديناميكية_ربط
): فراغ {
    ألحق((*الخطة).المكتبات_الديناميكية, الاعتماد);
}

// Records that الرمز is imported from المكتبة. A symbol declared twice keeps
// its first library; the declarations of one program agree, since a link name
// names one function.
عام عرف أضف_استيراد_مكتبة_مصرح_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الرمز: متجه ط8,
    المكتبة: متجه ط8
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*الخطة).الاستيرادات_المصرحة) مثل طبيعي)) {
        لو (بايتات_خطة_ربط_متساوية(&(*الخطة).الاستيرادات_المصرحة[الفهرس].الرمز, &الرمز)) {
            أرجع;
        };
        الفهرس := الفهرس + 1;
    }
    دع الاستيراد: استيراد_مكتبة_مصرح_ربط = { الرمز: الرمز, المكتبة: المكتبة };
    ألحق((*الخطة).الاستيرادات_المصرحة, الاستيراد);
}

// The library declared for a symbol (its canonical linker name), if any.
عام عرف مكتبة_مصرحة_لرمز_في_خطة_ربط(
    الخطة: &خطة_ربط,
    الرمز: &متجه ط8
): اختياري متجه ط8 {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*الخطة).الاستيرادات_المصرحة) مثل طبيعي)) {
        دع الاستيراد: &استيراد_مكتبة_مصرح_ربط = &(*الخطة).الاستيرادات_المصرحة[الفهرس];
        لو (بايتات_خطة_ربط_متساوية(&(*الاستيراد).الرمز, الرمز)) {
            أرجع اختياري.موجود(انسخ_بايتات_خطة_ربط(&(*الاستيراد).المكتبة));
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف بايتات_خطة_ربط_متساوية(الأول: &متجه ط8, الثاني: &متجه ط8): منطقي {
    لو ((الطول(*الأول) مثل طبيعي) != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الأول) مثل طبيعي)) {
        لو ((*الأول)[الفهرس] != (*الثاني)[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عام عرف أنشئ_خطة_ربط_تنفيذي_بكائن(
    الهدف: معرف_هدف,
    بايتات_الكائن: متجه ط8
): خطة_ربط {
    دع الخطة: متغير خطة_ربط = أنشئ_خطة_ربط(الهدف, نوع_خرج_ربط.تنفيذي());
    دع المعرف: معرف_مدخل_ربط = أضف_كائن_إلى_خطة_ربط(&متغير الخطة, بايتات_الكائن);
    أرجع الخطة;
}

عام عرف أضف_مدخل_ملف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الصنف: صنف_مدخل_ربط,
    البايتات: متجه ط8,
    المسار: نص
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_بأصل_إلى_خطة_ربط(
        الخطة,
        الصنف,
        البايتات,
        اختياري.موجود(المسار)
    );
}


عام عرف أضف_مكتبة_ديناميكية_ملف_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    البايتات: متجه ط8,
    المسار: نص
): معرف_مدخل_ربط {
    أرجع أضف_مدخل_ملف_إلى_خطة_ربط(
        الخطة,
        صنف_مدخل_ربط.مكتبة_ديناميكية(),
        البايتات,
        المسار
    );
}

عام عرف أضف_مسار_تشغيل_إلى_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    المسار: متجه ط8
): فراغ {
    ألحق((*الخطة).مسارات_التشغيل, المسار);
}

عام عرف ثبت_اسم_مخرج_ديناميكي_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    الاسم: متجه ط8
): فراغ {
    (*الخطة).اسم_المخرج_الديناميكي := اختياري.موجود(الاسم);
}

// Records the running compiler's own libLLVM for the LLVM dependency
// resolver; it is applied only when the output target is الهدف_المضيف.
عام عرف ثبت_مكتبة_إل_إل_في_إم_المضيف_في_خطة_ربط(
    الخطة: &متغير خطة_ربط,
    المسار: نص,
    هدف_المضيف: معرف_هدف
): فراغ {
    دع البيانات: بيانات_مكتبة_إل_إل_في_إم_المضيف_ربط = {
        المسار: المسار,
        هدف_المضيف: هدف_المضيف
    };
    (*الخطة).بيانات_الأداة.إل_إل_في_إم_المضيف := اختياري.موجود(البيانات);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_مدخل_ربط(القيمة: &مدخل_ربط): مدخل_ربط {
    دع الناتج: مدخل_ربط = {
        المعرف: (*القيمة).المعرف,
        الصنف: (*القيمة).الصنف,
        البايتات: انسخ_بايتات(&(*القيمة).البايتات),
        المسار: انسخ_اختيار_نص(&(*القيمة).المسار),
        الأصل: (*القيمة).الأصل,
        سكربت_جنو: (*القيمة).سكربت_جنو
    };
    أرجع الناتج;
}

