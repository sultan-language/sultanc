استورد compiler.link.context;
استورد compiler.link.debug_sections;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.link.section_model;
استورد compiler.link.relocation_model;
استورد compiler.backend.object.debug_payload;

عام نوع خطأ_حمولة_تصحيح_ربط =
    | قسم_غير_موجود
    | رمز_غير_محلول
    | محتوى_قسم_مفقود
;

عام نوع نتيجة_حمولة_تصحيح_ربط =
    | نجح بنوع حمولة_أقسام_تصحيح_تسلسل
    | خطأ بنوع خطأ_حمولة_تصحيح_ربط
;

نوع نتيجة_حل_هدف_إزاحة_تصحيح =
    | نجح بنوع هدف_إزاحة_تصحيح_تسلسل
    | خطأ بنوع خطأ_حمولة_تصحيح_ربط
;

عرف انسخ_بايتات_حمولة_تصحيح(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عرف هوية_تسلسل_من_قسم_ربط(
    القسم: &قسم_ربط
): هوية_قسم_تصحيح_تسلسل {
    دع اسم_القسم: متجه ط8 = انسخ_بايتات_حمولة_تصحيح(
        &(*القسم).الاسم.اسم_القسم
    );
    دع اسم_الحاوية: متغير اختياري متجه ط8 = اختياري.لا_شيء();
    طابق (*القسم).الاسم.اسم_الحاوية مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاسم) -> {
        اسم_الحاوية := اختياري.موجود(انسخ_بايتات_حمولة_تصحيح(&الاسم));
    };
    دع الهوية: هوية_قسم_تصحيح_تسلسل = {
        اسم_القسم: اسم_القسم,
        اسم_الحاوية: اسم_الحاوية
    };
    أرجع الهوية;
}

عرف حل_هدف_إزاحة_تصحيح_للربط(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط
): نتيجة_حل_هدف_إزاحة_تصحيح {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(معرف_القسم) -> {
        طابق ابحث_قسم_ربط_بالمعرف(السياق, معرف_القسم) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(
                خطأ_حمولة_تصحيح_ربط.قسم_غير_موجود()
            );
        }
        | اختياري.موجود(القسم) -> {
            دع الهوية: هوية_قسم_تصحيح_تسلسل =
                هوية_تسلسل_من_قسم_ربط(&القسم);
            أرجع نتيجة_حل_هدف_إزاحة_تصحيح.نجح(
                هدف_إزاحة_تصحيح_تسلسل.قسم(الهوية, 0)
            );
        };
    }
    | مرجع_إزاحة_ربط.رمز(معرف_الرمز) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, معرف_الرمز) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(
                خطأ_حمولة_تصحيح_ربط.رمز_غير_محلول()
            );
        }
        | اختياري.موجود(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                طابق التعريف.الموضع مع
                | موضع_تعريف_رمز_ربط.قسم(معرف_القسم, الإزاحة) -> {
                    طابق ابحث_قسم_ربط_بالمعرف(السياق, معرف_القسم) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(
                            خطأ_حمولة_تصحيح_ربط.قسم_غير_موجود()
                        );
                    }
                    | اختياري.موجود(القسم) -> {
                        دع الهوية: هوية_قسم_تصحيح_تسلسل =
                            هوية_تسلسل_من_قسم_ربط(&القسم);
                        أرجع نتيجة_حل_هدف_إزاحة_تصحيح.نجح(
                            هدف_إزاحة_تصحيح_تسلسل.قسم(الهوية, الإزاحة)
                        );
                    };
                }
                | موضع_تعريف_رمز_ربط.مطلق(القيمة) -> {
                    أرجع نتيجة_حل_هدف_إزاحة_تصحيح.نجح(
                        هدف_إزاحة_تصحيح_تسلسل.مطلق(القيمة)
                    );
                }
                | موضع_تعريف_رمز_ربط.غير_محدد -> {
                    أرجع نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(
                        خطأ_حمولة_تصحيح_ربط.رمز_غير_محلول()
                    );
                };
            }
            | _ -> {
                أرجع نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(
                    خطأ_حمولة_تصحيح_ربط.رمز_غير_محلول()
                );
            };
        };
    };
}

عام عرف ابن_حمولة_أقسام_التصحيح_من_سياق_الربط(
    السياق: &سياق_ربط
): نتيجة_حمولة_تصحيح_ربط {
    دع الحمولة: متغير حمولة_أقسام_تصحيح_تسلسل =
        أنشئ_حمولة_أقسام_تصحيح_فارغة();
    دع معرفات_الأقسام: متجه معرف_قسم_ربط =
        معرفات_أقسام_التصحيح_للربط(السياق);
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < (الطول(معرفات_الأقسام) مثل طبيعي)) {
        دع معرف_القسم: معرف_قسم_ربط = معرفات_الأقسام[فهرس_القسم];
        دع القسم: قسم_ربط;
        طابق ابحث_قسم_ربط_بالمعرف(السياق, معرف_القسم) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حمولة_تصحيح_ربط.خطأ(
                خطأ_حمولة_تصحيح_ربط.قسم_غير_موجود()
            );
        }
        | اختياري.موجود(الحقيقة) -> { القسم := الحقيقة; };

        دع المحتوى: متجه ط8;
        طابق القسم.المحتوى مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_حمولة_تصحيح_ربط.خطأ(
                خطأ_حمولة_تصحيح_ربط.محتوى_قسم_مفقود()
            );
        }
        | اختياري.موجود(البايتات) -> {
            المحتوى := انسخ_بايتات_حمولة_تصحيح(&البايتات);
        };

        دع الإزاحات: متغير متجه إزاحة_قسم_تصحيح_تسلسل = [];
        دع حواف_الإزاحة: متجه حافة_إزاحة_ربط =
            إزاحات_قسم_تصحيح_للربط(السياق, معرف_القسم);
        دع فهرس_الإزاحة: متغير طبيعي = 0;
        طالما (فهرس_الإزاحة < (الطول(حواف_الإزاحة) مثل طبيعي)) {
            دع الحافة: حافة_إزاحة_ربط = حواف_الإزاحة[فهرس_الإزاحة];
            دع الهدف: هدف_إزاحة_تصحيح_تسلسل;
            طابق حل_هدف_إزاحة_تصحيح_للربط(السياق, &الحافة.المرجع) مع
            | نتيجة_حل_هدف_إزاحة_تصحيح.خطأ(الخطأ) -> {
                أرجع نتيجة_حمولة_تصحيح_ربط.خطأ(الخطأ);
            }
            | نتيجة_حل_هدف_إزاحة_تصحيح.نجح(الهدف_المحلول) -> {
                الهدف := الهدف_المحلول;
            };
            دع الإزاحة: إزاحة_قسم_تصحيح_تسلسل = {
                الموضع: الحافة.الإزاحة,
                الإضافة: الحافة.إضافة,
                رمز_صيغة: الحافة.رمز_صيغة,
                الهدف: الهدف
            };
            ألحق(الإزاحات, الإزاحة);
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }

        دع قسم_التسلسل: قسم_تصحيح_تسلسل = {
            الهوية: هوية_تسلسل_من_قسم_ربط(&القسم),
            المحاذاة: القسم.المحاذاة,
            المحتوى: المحتوى,
            الإزاحات: الإزاحات
        };
        ألحق(الحمولة.الأقسام, قسم_التسلسل);
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع نتيجة_حمولة_تصحيح_ربط.نجح(الحمولة);
}
