استورد compiler.link.section_model;
استورد std.text.from_bytes;

// Syntax of COFF linker directives (the `.drectve` section, flagged
// IMAGE_SCN_LNK_INFO). MSVC and Clang record there the options an object
// needs instead of on the linker command line. This module only reads them;
// input completion (coff/directives.sn) applies the ones that decide which
// inputs and definitions an image contains, and the PE writer
// (coff/final_image.sn) applies the ones that shape the image. Both read the
// same parse, so a directive has one meaning wherever it is used.
//
// The accepted set is LLD's (LinkerDriver::parseDirectives; options are
// case-insensitive with a '/' or '-' prefix):
//   /DEFAULTLIB:<lib>, /NODEFAULTLIB[:<lib>]
//                                  accepted without effect: SultanC links
//                                  no C runtime and loads no library it was
//                                  not given (coff/directives.sn);
//   /ALTERNATENAME:<a>=<b>         <a>, still undefined at the end, is <b>;
//   /INCLUDE:<sym>                 <sym> is required and a liveness root;
//   /EXPORT:<name>[=<sym>|=<dll>.<sym>][,@<ordinal>[,NONAME]][,DATA]
//          [,PRIVATE][,CONSTANT]   an export (DATA, PRIVATE and CONSTANT only
//                                  shape an import library);
//   /EXCLUDE-SYMBOLS:<a>[,<b>...]  names kept out of automatic exporting;
//   /MERGE:<from>=<to>             output section <from> is laid out in <to>;
//   /SECTION:<name>,<DEKPRSW>      the output section's memory attributes;
//   /FAILIFMISMATCH:<key>=<value>  every object must agree on <key>;
//   /ENTRY:<sym>                   the image entry point;
//   /STACK:<reserve>[,<commit>]    the stack sizes of the image header;
//   /SUBSYSTEM:<name>[,<major>[.<minor>]]
//                                  the image subsystem and its version;
//   /ALIGNCOMM:<sym>,<power>       a common symbol's minimum alignment;
//   /RELEASE                       the image header carries its checksum.
// /EDITANDCONTINUE, /GUARDSYM, /THROWINGNEW, /INFERASANLIBS[:NO], /FASTFAIL,
// /DISALLOWLIB and /MANIFESTDEPENDENCY are accepted without effect on the
// image, as in LLD (the manifest dependency only reaches a manifest file,
// which SultanC does not write, and LLD does not embed one by default). Any
// other option, or a malformed value of an accepted one, is recorded as the
// section's غير_صالح token (the first one), and input completion fails the
// link naming that token and the object, as LLD reports an option that "is
// not allowed in .drectve". Previously /EXPORT forms with ordinals,
// NONAME or forwarders were rejected and every unknown directive was
// skipped silently.
// Single-valued options keep the last value. Previously /DEFAULTLIB and
// /NODEFAULTLIB were recorded in order for completion to load the named
// libraries.

عام نوع زوج_بديل_كوف = {
    الاسم: متجه غ8,
    البديل: متجه غ8
};

عام نوع تصدير_توجيه_كوف = {
    الاسم_الخارجي: متجه غ8,
    // The exported definition; empty for a forwarder.
    الاسم_الداخلي: متجه غ8,
    // "<dll>.<sym>" of a forwarder, empty otherwise.
    التحويل: متجه غ8,
    // An explicit ordinal, 0 when the PE writer assigns one.
    الترتيب: غير_موقع,
    بلا_اسم: منطقي
};

عام نوع زوج_دمج_كوف = {
    المصدر: متجه غ8,
    الوجهة: متجه غ8
};

عام نوع صلاحيات_قسم_كوف = {
    الاسم: متجه غ8,
    // IMAGE_SCN_MEM_* bits replacing the output section's own.
    الخصائص: غير_موقع
};

عام نوع زوج_تطابق_كوف = {
    المفتاح: متجه غ8,
    القيمة: متجه غ8
};

عام نوع محاذاة_مشترك_كوف = {
    الاسم: متجه غ8,
    القوة: غير_موقع
};

عام نوع توجيهات_قسم_كوف = {
    البدائل: متجه زوج_بديل_كوف,
    المضمنة: متجه متجه غ8,
    الصادرات: متجه تصدير_توجيه_كوف,
    المستثناة_من_التصدير: متجه متجه غ8,
    الدمج: متجه زوج_دمج_كوف,
    الأقسام: متجه صلاحيات_قسم_كوف,
    التطابقات: متجه زوج_تطابق_كوف,
    محاذاة_المشتركة: متجه محاذاة_مشترك_كوف,
    الدخول: اختيار متجه غ8,
    حجز_المكدس: اختيار غير_موقع,
    التزام_المكدس: اختيار غير_موقع,
    النظام_الفرعي: اختيار غير_موقع,
    إصدار_النظام_الرئيسي: اختيار غير_موقع,
    إصدار_النظام_الفرعي: اختيار غير_موقع,
    مجموع_التحقق: منطقي,
    // The first directive token not accepted, which the link reports.
    غير_صالح: اختيار متجه غ8
};

عام عرف حرف_صغير_كوف(البايت: غ8): غ8 {
    لو (البايت >= 0x41 && البايت <= 0x5A) { أرجع البايت + 0x20; };
    أرجع البايت;
}

عام عرف متجها_اسم_كوف_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    لو ((الطول(*أ) مثل غير_موقع) != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يساوي_كلمة_بلا_حالة(القيمة: &متجه غ8, الكلمة: نص): منطقي {
    دع البايتات: متجه غ8 = بايتات_من_نص(الكلمة);
    لو ((الطول(*القيمة) مثل غير_موقع) != (الطول(البايتات) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
        لو (حرف_صغير_كوف((*القيمة)[ف]) != حرف_صغير_كوف(البايتات[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The option name of a token ("/name" or "-name", up to an optional ':'),
// compared case-insensitively with الخيار; returns the value after ':' (empty
// without one) when it matches.
عرف قيمة_خيار_كوف(الرمز: &متجه غ8, الخيار: نص): اختيار متجه غ8 {
    دع البادئة: متجه غ8 = بايتات_من_نص(الخيار);
    دع طول_البادئة: غير_موقع = الطول(البادئة) مثل غير_موقع;
    دع طول_الرمز: غير_موقع = الطول(*الرمز) مثل غير_موقع;
    لو (طول_الرمز < طول_البادئة + 1) { أرجع اختيار.لا_شيء(); };
    لو ((*الرمز)[0] != 0x2F && (*الرمز)[0] != 0x2D) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_البادئة) {
        لو (حرف_صغير_كوف((*الرمز)[ف + 1]) != حرف_صغير_كوف(البادئة[ف])) {
            أرجع اختيار.لا_شيء();
        };
        ف := ف + 1;
    }
    دع القيمة: متغير متجه غ8 = [];
    لو (طول_الرمز == طول_البادئة + 1) { أرجع اختيار.بعض(القيمة); };
    لو ((*الرمز)[طول_البادئة + 1] != 0x3A) { أرجع اختيار.لا_شيء(); };
    ف := طول_البادئة + 2;
    بينما (ف < طول_الرمز) {
        ألحق(القيمة, (*الرمز)[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(القيمة);
}

// Windows command-line tokenization as LLD's ArgParser::tokenize: spaces,
// tabs and line breaks separate arguments outside double quotes, and the
// quotes themselves are removed. A UTF-8 byte-order mark is skipped.
عرف رموز_توجيهات_كوف(المحتوى: &متجه غ8): متجه متجه غ8 {
    دع الرموز: متغير متجه متجه غ8 = [];
    دع الحالي: متغير متجه غ8 = [];
    دع في_علامات: متغير منطقي = خطأ;
    دع له_رمز: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    لو ((الطول(*المحتوى) مثل غير_موقع) >= 3
        && (*المحتوى)[0] == 0xEF && (*المحتوى)[1] == 0xBB && (*المحتوى)[2] == 0xBF) {
        ف := 3;
    };
    بينما (ف < (الطول(*المحتوى) مثل غير_موقع)) {
        دع البايت: غ8 = (*المحتوى)[ف];
        دع فاصل: منطقي = البايت == 0x20 || البايت == 0x09 || البايت == 0x0A
            || البايت == 0x0D || البايت == 0;
        لو (البايت == 0x22) {
            في_علامات := !في_علامات;
            له_رمز := صواب;
        } وإلا لو (فاصل && !في_علامات) {
            لو (له_رمز) {
                ألحق(الرموز, انسخ_متجه_توجيه_كوف(&الحالي));
                دع الجديد: متجه غ8 = [];
                الحالي := الجديد;
                له_رمز := خطأ;
            };
        } وإلا {
            ألحق(الحالي, البايت);
            له_رمز := صواب;
        };
        ف := ف + 1;
    }
    لو (له_رمز) { ألحق(الرموز, الحالي); };
    أرجع الرموز;
}

// A copy of a token, so the token buffer can be reset after it is recorded.
عام عرف انسخ_متجه_توجيه_كوف(القيمة: &متجه غ8): متجه غ8 {
    دع النسخة: متجه غ8 = *القيمة;
    أرجع النسخة;
}

// Splits at every byte الفاصل.
عرف قسم_بفاصل_كوف(القيمة: &متجه غ8, الفاصل: غ8): متجه متجه غ8 {
    دع الحقول: متغير متجه متجه غ8 = [];
    دع الحالي: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        لو ((*القيمة)[ف] == الفاصل) {
            ألحق(الحقول, انسخ_متجه_توجيه_كوف(&الحالي));
            دع فارغ: متجه غ8 = [];
            الحالي := فارغ;
        } وإلا {
            ألحق(الحالي, (*القيمة)[ف]);
        };
        ف := ف + 1;
    }
    ألحق(الحقول, الحالي);
    أرجع الحقول;
}

// Splits "<a>=<b>" at the first '='; none without one or with an empty side.
عرف قسم_زوج_كوف(القيمة: &متجه غ8): اختيار زوج_بديل_كوف {
    دع الاسم: متغير متجه غ8 = [];
    دع البديل: متغير متجه غ8 = [];
    دع بعد_المساواة: متغير منطقي = خطأ;
    دع ب: متغير غير_موقع = 0;
    بينما (ب < (الطول(*القيمة) مثل غير_موقع)) {
        لو (!بعد_المساواة && (*القيمة)[ب] == 0x3D) {
            بعد_المساواة := صواب;
        } وإلا لو (بعد_المساواة) {
            ألحق(البديل, (*القيمة)[ب]);
        } وإلا {
            ألحق(الاسم, (*القيمة)[ب]);
        };
        ب := ب + 1;
    }
    لو (!بعد_المساواة || (الطول(الاسم) مثل غير_موقع) == 0
        || (الطول(البديل) مثل غير_موقع) == 0) {
        أرجع اختيار.لا_شيء();
    };
    دع الزوج: زوج_بديل_كوف = { الاسم: الاسم, البديل: البديل };
    أرجع اختيار.بعض(الزوج);
}

// A number as LLD's parseNumbers reads it (StringRef::getAsInteger with
// radix 0): "0x" hexadecimal, a leading "0" octal, otherwise decimal.
عرف عدد_توجيه_كوف(القيمة: &متجه غ8): اختيار غير_موقع {
    دع الطول_الكلي: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    لو (الطول_الكلي == 0) { أرجع اختيار.لا_شيء(); };
    دع الأساس: متغير غير_موقع = 10;
    دع ف: متغير غير_موقع = 0;
    لو (الطول_الكلي > 2 && (*القيمة)[0] == 0x30
        && ((*القيمة)[1] == 0x78 || (*القيمة)[1] == 0x58)) {
        الأساس := 16;
        ف := 2;
    } وإلا لو (الطول_الكلي > 1 && (*القيمة)[0] == 0x30) {
        الأساس := 8;
        ف := 1;
    };
    دع الناتج: متغير غير_موقع = 0;
    بينما (ف < الطول_الكلي) {
        دع ب: غ8 = حرف_صغير_كوف((*القيمة)[ف]);
        دع الرقم: متغير غير_موقع = 99;
        لو (ب >= 0x30 && ب <= 0x39) {
            الرقم := (ب - 0x30) مثل غير_موقع;
        } وإلا لو (ب >= 0x61 && ب <= 0x66) {
            الرقم := (ب - 0x61) مثل غير_موقع + 10;
        };
        لو (الرقم >= الأساس) { أرجع اختيار.لا_شيء(); };
        // Reject values that do not fit 32 bits; PE header fields that take
        // these numbers are at most 64-bit and no directive needs more.
        لو (الناتج > 0xFFFFFFFF) { أرجع اختيار.لا_شيء(); };
        الناتج := الناتج * الأساس + الرقم;
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// /EXPORT value, as LLD's parseExport: "<name>[=<internal>]" then
// comma-separated attributes. None for a malformed export (LLD's "invalid
// /export:").
عرف حلل_تصدير_كوف(القيمة: &متجه غ8): اختيار تصدير_توجيه_كوف {
    دع الحقول: متجه متجه غ8 = قسم_بفاصل_كوف(القيمة, 0x2C);
    لو ((الطول(الحقول[0]) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الخارجي: متغير متجه غ8 = [];
    دع الداخلي: متغير متجه غ8 = [];
    دع التحويل: متغير متجه غ8 = [];
    طابق قسم_زوج_كوف(&الحقول[0]) مع
    | اختيار.بعض(الزوج) -> {
        دع مرجع_الخارجي: &متجه غ8 = &الزوج.الاسم;
        دع مرجع_الداخلي: &متجه غ8 = &الزوج.البديل;
        الخارجي := *مرجع_الخارجي;
        // A '.' in the internal name makes it a forwarder "<dll>.<sym>".
        دع فيه_نقطة: متغير منطقي = خطأ;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(*مرجع_الداخلي) مثل غير_موقع)) {
            لو ((*مرجع_الداخلي)[ب] == 0x2E) { فيه_نقطة := صواب; };
            ب := ب + 1;
        }
        لو (فيه_نقطة) {
            التحويل := *مرجع_الداخلي;
        } وإلا {
            الداخلي := *مرجع_الداخلي;
        };
    }
    | اختيار.لا_شيء -> {
        دع مرجع_الأول: &متجه غ8 = &الحقول[0];
        // "<a>=" or "=<b>" is malformed.
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(*مرجع_الأول) مثل غير_موقع)) {
            لو ((*مرجع_الأول)[ب] == 0x3D) { أرجع اختيار.لا_شيء(); };
            ب := ب + 1;
        }
        الخارجي := *مرجع_الأول;
        الداخلي := *مرجع_الأول;
    };
    دع الترتيب: متغير غير_موقع = 0;
    دع بلا_اسم: متغير منطقي = خطأ;
    دع ح: متغير غير_موقع = 1;
    بينما (ح < (الطول(الحقول) مثل غير_موقع)) {
        دع الحقل: &متجه غ8 = &الحقول[ح];
        لو ((الطول(*الحقل) مثل غير_موقع) > 1 && (*الحقل)[0] == 0x40) {
            دع الرقم: متغير متجه غ8 = [];
            دع ب: متغير غير_موقع = 1;
            بينما (ب < (الطول(*الحقل) مثل غير_موقع)) {
                ألحق(الرقم, (*الحقل)[ب]);
                ب := ب + 1;
            }
            طابق عدد_توجيه_كوف(&الرقم) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة_العددية) -> {
                لو (القيمة_العددية == 0 || القيمة_العددية > 0xFFFF) {
                    أرجع اختيار.لا_شيء();
                };
                الترتيب := القيمة_العددية;
            };
        } وإلا لو (يساوي_كلمة_بلا_حالة(الحقل, «noname»)) {
            بلا_اسم := صواب;
        } وإلا لو (!يساوي_كلمة_بلا_حالة(الحقل, «data»)
            && !يساوي_كلمة_بلا_حالة(الحقل, «private»)
            && !يساوي_كلمة_بلا_حالة(الحقل, «constant»)) {
            أرجع اختيار.لا_شيء();
        };
        ح := ح + 1;
    }
    // NONAME exports only by ordinal, so it needs one (LLD: "/export:...
    // NONAME without an ordinal" is not accepted).
    لو (بلا_اسم && الترتيب == 0) { أرجع اختيار.لا_شيء(); };
    دع التصدير: تصدير_توجيه_كوف = {
        الاسم_الخارجي: الخارجي,
        الاسم_الداخلي: الداخلي,
        التحويل: التحويل,
        الترتيب: الترتيب,
        بلا_اسم: بلا_اسم
    };
    أرجع اختيار.بعض(التصدير);
}

// /SECTION attributes as LLD's parseSectionAttributes.
عرف صلاحيات_قسم_من_نص_كوف(القيمة: &متجه غ8): اختيار غير_موقع {
    لو ((الطول(*القيمة) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الخصائص: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        دع ب: غ8 = حرف_صغير_كوف((*القيمة)[ف]);
        لو (ب == 0x64) {
            الخصائص := الخصائص | 0x02000000;
        } وإلا لو (ب == 0x65) {
            الخصائص := الخصائص | 0x20000000;
        } وإلا لو (ب == 0x6B) {
            الخصائص := الخصائص | 0x04000000;
        } وإلا لو (ب == 0x70) {
            الخصائص := الخصائص | 0x08000000;
        } وإلا لو (ب == 0x72) {
            الخصائص := الخصائص | 0x40000000;
        } وإلا لو (ب == 0x73) {
            الخصائص := الخصائص | 0x10000000;
        } وإلا لو (ب == 0x77) {
            الخصائص := الخصائص | 0x80000000;
        } وإلا {
            أرجع اختيار.لا_شيء();
        };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الخصائص);
}

// IMAGE_SUBSYSTEM_* for a /SUBSYSTEM name (LLD getSubsystem).
عرف نظام_فرعي_من_نص_كوف(القيمة: &متجه غ8): اختيار غير_موقع {
    لو (يساوي_كلمة_بلا_حالة(القيمة, «native»)) { أرجع اختيار.بعض(1); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «windows»)) { أرجع اختيار.بعض(2); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «console»)) { أرجع اختيار.بعض(3); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «posix»)) { أرجع اختيار.بعض(7); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «windowsce»)) { أرجع اختيار.بعض(9); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «efi_application»)) { أرجع اختيار.بعض(10); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «efi_boot_service_driver»)) { أرجع اختيار.بعض(11); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «efi_runtime_driver»)) { أرجع اختيار.بعض(12); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «efi_rom»)) { أرجع اختيار.بعض(13); };
    لو (يساوي_كلمة_بلا_حالة(القيمة, «boot_application»)) { أرجع اختيار.بعض(16); };
    أرجع اختيار.لا_شيء();
}

عرف توجيهات_فارغة_كوف(): توجيهات_قسم_كوف {
    دع البدائل: متجه زوج_بديل_كوف = [];
    دع المضمنة: متجه متجه غ8 = [];
    دع الصادرات: متجه تصدير_توجيه_كوف = [];
    دع المستثناة: متجه متجه غ8 = [];
    دع الدمج: متجه زوج_دمج_كوف = [];
    دع الأقسام: متجه صلاحيات_قسم_كوف = [];
    دع التطابقات: متجه زوج_تطابق_كوف = [];
    دع المحاذاة: متجه محاذاة_مشترك_كوف = [];
    دع الناتج: توجيهات_قسم_كوف = {
        البدائل: البدائل,
        المضمنة: المضمنة,
        الصادرات: الصادرات,
        المستثناة_من_التصدير: المستثناة,
        الدمج: الدمج,
        الأقسام: الأقسام,
        التطابقات: التطابقات,
        محاذاة_المشتركة: المحاذاة,
        الدخول: اختيار.لا_شيء(),
        حجز_المكدس: اختيار.لا_شيء(),
        التزام_المكدس: اختيار.لا_شيء(),
        النظام_الفرعي: اختيار.لا_شيء(),
        إصدار_النظام_الرئيسي: اختيار.لا_شيء(),
        إصدار_النظام_الفرعي: اختيار.لا_شيء(),
        مجموع_التحقق: خطأ,
        غير_صالح: اختيار.لا_شيء()
    };
    أرجع الناتج;
}

// Applies one directive token to الناتج; false when the token is not an
// accepted directive or its value is malformed.
عرف طبق_رمز_توجيه_كوف(
    الناتج: &متغير توجيهات_قسم_كوف,
    الرمز: &متجه غ8
): منطقي {
    // Default-library directives name libraries (most often the C runtime)
    // that SultanC never loads; a /DEFAULTLIB still needs a name.
    طابق قيمة_خيار_كوف(الرمز, «defaultlib») مع
    | اختيار.بعض(القيمة) -> { أرجع (الطول(القيمة) مثل غير_موقع) > 0; }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «nodefaultlib») مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «alternatename») مع
    | اختيار.بعض(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختيار.بعض(الزوج) -> {
            ألحق((*الناتج).البدائل, الزوج);
            أرجع صواب;
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «include») مع
    | اختيار.بعض(القيمة) -> {
        لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
        ألحق((*الناتج).المضمنة, القيمة);
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «export») مع
    | اختيار.بعض(القيمة) -> {
        طابق حلل_تصدير_كوف(&القيمة) مع
        | اختيار.بعض(التصدير) -> {
            ألحق((*الناتج).الصادرات, التصدير);
            أرجع صواب;
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «exclude-symbols») مع
    | اختيار.بعض(القيمة) -> {
        دع الأسماء: متجه متجه غ8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الأسماء) مثل غير_موقع)) {
            لو ((الطول(الأسماء[ف]) مثل غير_موقع) > 0) {
                دع مرجع_الاسم: &متجه غ8 = &الأسماء[ف];
                ألحق((*الناتج).المستثناة_من_التصدير, *مرجع_الاسم);
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «merge») مع
    | اختيار.بعض(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختيار.بعض(الزوج) -> {
            دع مرجع_من: &متجه غ8 = &الزوج.الاسم;
            دع مرجع_إلى: &متجه غ8 = &الزوج.البديل;
            دع الدمج_الجديد: زوج_دمج_كوف = {
                المصدر: *مرجع_من,
                الوجهة: *مرجع_إلى
            };
            ألحق((*الناتج).الدمج, الدمج_الجديد);
            أرجع صواب;
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «section») مع
    | اختيار.بعض(القيمة) -> {
        دع الحقول: متجه متجه غ8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        لو ((الطول(الحقول) مثل غير_موقع) != 2
            || (الطول(الحقول[0]) مثل غير_موقع) == 0) {
            أرجع خطأ;
        };
        طابق صلاحيات_قسم_من_نص_كوف(&الحقول[1]) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(الخصائص) -> {
            دع مرجع_الاسم: &متجه غ8 = &الحقول[0];
            دع الصلاحيات: صلاحيات_قسم_كوف = {
                الاسم: *مرجع_الاسم,
                الخصائص: الخصائص
            };
            ألحق((*الناتج).الأقسام, الصلاحيات);
            أرجع صواب;
        };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «failifmismatch») مع
    | اختيار.بعض(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختيار.بعض(الزوج) -> {
            دع مرجع_المفتاح: &متجه غ8 = &الزوج.الاسم;
            دع مرجع_القيمة: &متجه غ8 = &الزوج.البديل;
            دع التطابق: زوج_تطابق_كوف = {
                المفتاح: *مرجع_المفتاح,
                القيمة: *مرجع_القيمة
            };
            ألحق((*الناتج).التطابقات, التطابق);
            أرجع صواب;
        }
        | اختيار.لا_شيء -> { أرجع خطأ; };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «entry») مع
    | اختيار.بعض(القيمة) -> {
        لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
        (*الناتج).الدخول := اختيار.بعض(القيمة);
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «stack») مع
    | اختيار.بعض(القيمة) -> {
        دع الحقول: متجه متجه غ8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        لو ((الطول(الحقول) مثل غير_موقع) > 2) { أرجع خطأ; };
        طابق عدد_توجيه_كوف(&الحقول[0]) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(الحجز) -> { (*الناتج).حجز_المكدس := اختيار.بعض(الحجز); };
        لو ((الطول(الحقول) مثل غير_موقع) == 2) {
            طابق عدد_توجيه_كوف(&الحقول[1]) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(الالتزام) -> {
                (*الناتج).التزام_المكدس := اختيار.بعض(الالتزام);
            };
        };
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «subsystem») مع
    | اختيار.بعض(القيمة) -> {
        دع الحقول: متجه متجه غ8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        لو ((الطول(الحقول) مثل غير_موقع) > 2) { أرجع خطأ; };
        طابق نظام_فرعي_من_نص_كوف(&الحقول[0]) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(النظام) -> { (*الناتج).النظام_الفرعي := اختيار.بعض(النظام); };
        لو ((الطول(الحقول) مثل غير_موقع) == 2) {
            دع الإصدار: متجه متجه غ8 = قسم_بفاصل_كوف(&الحقول[1], 0x2E);
            لو ((الطول(الإصدار) مثل غير_موقع) > 2) { أرجع خطأ; };
            طابق عدد_توجيه_كوف(&الإصدار[0]) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(الرئيسي) -> {
                لو (الرئيسي > 0xFFFF) { أرجع خطأ; };
                (*الناتج).إصدار_النظام_الرئيسي := اختيار.بعض(الرئيسي);
            };
            دع الفرعي: متغير غير_موقع = 0;
            لو ((الطول(الإصدار) مثل غير_موقع) == 2) {
                طابق عدد_توجيه_كوف(&الإصدار[1]) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة_الفرعية) -> { الفرعي := القيمة_الفرعية; };
            };
            لو (الفرعي > 0xFFFF) { أرجع خطأ; };
            (*الناتج).إصدار_النظام_الفرعي := اختيار.بعض(الفرعي);
        };
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «aligncomm») مع
    | اختيار.بعض(القيمة) -> {
        دع الحقول: متجه متجه غ8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        لو ((الطول(الحقول) مثل غير_موقع) != 2
            || (الطول(الحقول[0]) مثل غير_موقع) == 0) {
            أرجع خطأ;
        };
        طابق عدد_توجيه_كوف(&الحقول[1]) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القوة) -> {
            // The section alignment field holds at most 2^13.
            لو (القوة > 13) { أرجع خطأ; };
            دع مرجع_الاسم: &متجه غ8 = &الحقول[0];
            دع المحاذاة: محاذاة_مشترك_كوف = {
                الاسم: *مرجع_الاسم,
                القوة: القوة
            };
            ألحق((*الناتج).محاذاة_المشتركة, المحاذاة);
            أرجع صواب;
        };
    }
    | اختيار.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «release») مع
    | اختيار.بعض(القيمة) -> {
        لو ((الطول(القيمة) مثل غير_موقع) != 0) { أرجع خطأ; };
        (*الناتج).مجموع_التحقق := صواب;
        أرجع صواب;
    }
    | اختيار.لا_شيء -> { };
    // Accepted without effect on the image (see the module comment).
    دع بلا_أثر: متجه نص = [
        «editandcontinue», «guardsym», «throwingnew», «inferasanlibs»,
        «fastfail», «disallowlib», «manifestdependency»
    ];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(بلا_أثر) مثل غير_موقع)) {
        دع مرجع_الخيار: &نص = &بلا_أثر[ف];
        دع الخيار: نص = *مرجع_الخيار;
        طابق قيمة_خيار_كوف(الرمز, الخيار) مع
        | اختيار.بعض(_) -> { أرجع صواب; }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether a directive token was rejected.
عام عرف توجيهات_كوف_غير_صالحة(التوجيهات: &توجيهات_قسم_كوف): منطقي {
    طابق (*التوجيهات).غير_صالح مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { أرجع صواب; };
}

// A copy of the first rejected directive token, if any.
عام عرف رمز_توجيه_كوف_غير_الصالح(
    التوجيهات: &توجيهات_قسم_كوف
): اختيار متجه غ8 {
    طابق (*التوجيهات).غير_صالح مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        دع مرجع_الرمز: &متجه غ8 = &الرمز;
        دع النسخة: متجه غ8 = *مرجع_الرمز;
        أرجع اختيار.بعض(النسخة);
    };
}

عام عرف حلل_توجيهات_كوف(المحتوى: &متجه غ8): توجيهات_قسم_كوف {
    دع الناتج: متغير توجيهات_قسم_كوف = توجيهات_فارغة_كوف();
    دع الرموز: متجه متجه غ8 = رموز_توجيهات_كوف(المحتوى);
    دع وجد_غير_صالح: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرموز) مثل غير_موقع)) {
        // Every token is applied; only the first rejected one is kept.
        لو (!طبق_رمز_توجيه_كوف(&متغير الناتج, &الرموز[ف]) && !وجد_غير_صالح) {
            وجد_غير_صالح := صواب;
            دع مرجع_الرمز: &متجه غ8 = &الرموز[ف];
            دع الرمز: متجه غ8 = *مرجع_الرمز;
            الناتج.غير_صالح := اختيار.بعض(الرمز);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف قسم_توجيهات_كوف(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.كوف(الخصائص) -> {
        لو ((الخصائص & 0x00000200) == 0) { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    دع الاسم: متجه غ8 = بايتات_من_نص(«.drectve»);
    أرجع متجها_اسم_كوف_متساويان(&(*القسم).الاسم.اسم_القسم, &الاسم);
}

// The directives of one `.drectve` section (none for a section without
// content).
عام عرف توجيهات_قسم_ربط_كوف(القسم: &قسم_ربط): توجيهات_قسم_كوف {
    طابق (*القسم).المحتوى مع
    | اختيار.بعض(المحتوى) -> { أرجع حلل_توجيهات_كوف(&المحتوى); }
    | اختيار.لا_شيء -> { أرجع توجيهات_فارغة_كوف(); };
}

// The directives of every `.drectve` section among الأقسام, in section
// order: lists are concatenated and a single-valued option keeps its last
// value, as LLD applies directives object after object.
عام عرف اجمع_توجيهات_أقسام_كوف(الأقسام: &متجه قسم_ربط): توجيهات_قسم_كوف {
    دع الكل: متغير توجيهات_قسم_كوف = توجيهات_فارغة_كوف();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأقسام) مثل غير_موقع)) {
        لو (قسم_توجيهات_كوف(&(*الأقسام)[ف])) {
            دع التوجيهات: توجيهات_قسم_كوف = توجيهات_قسم_ربط_كوف(&(*الأقسام)[ف]);
            دع م: متغير غير_موقع = 0;
            بينما (م < (الطول(التوجيهات.الصادرات) مثل غير_موقع)) {
                دع مرجع: &تصدير_توجيه_كوف = &التوجيهات.الصادرات[م];
                ألحق(الكل.الصادرات, *مرجع);
                م := م + 1;
            }
            م := 0;
            بينما (م < (الطول(التوجيهات.المستثناة_من_التصدير) مثل غير_موقع)) {
                دع مرجع: &متجه غ8 = &التوجيهات.المستثناة_من_التصدير[م];
                ألحق(الكل.المستثناة_من_التصدير, *مرجع);
                م := م + 1;
            }
            م := 0;
            بينما (م < (الطول(التوجيهات.الدمج) مثل غير_موقع)) {
                دع مرجع: &زوج_دمج_كوف = &التوجيهات.الدمج[م];
                ألحق(الكل.الدمج, *مرجع);
                م := م + 1;
            }
            م := 0;
            بينما (م < (الطول(التوجيهات.الأقسام) مثل غير_موقع)) {
                دع مرجع: &صلاحيات_قسم_كوف = &التوجيهات.الأقسام[م];
                ألحق(الكل.الأقسام, *مرجع);
                م := م + 1;
            }
            طابق التوجيهات.حجز_المكدس مع
            | اختيار.بعض(القيمة) -> { الكل.حجز_المكدس := اختيار.بعض(القيمة); }
            | اختيار.لا_شيء -> { };
            طابق التوجيهات.التزام_المكدس مع
            | اختيار.بعض(القيمة) -> { الكل.التزام_المكدس := اختيار.بعض(القيمة); }
            | اختيار.لا_شيء -> { };
            طابق التوجيهات.النظام_الفرعي مع
            | اختيار.بعض(القيمة) -> { الكل.النظام_الفرعي := اختيار.بعض(القيمة); }
            | اختيار.لا_شيء -> { };
            طابق التوجيهات.إصدار_النظام_الرئيسي مع
            | اختيار.بعض(القيمة) -> { الكل.إصدار_النظام_الرئيسي := اختيار.بعض(القيمة); }
            | اختيار.لا_شيء -> { };
            طابق التوجيهات.إصدار_النظام_الفرعي مع
            | اختيار.بعض(القيمة) -> { الكل.إصدار_النظام_الفرعي := اختيار.بعض(القيمة); }
            | اختيار.لا_شيء -> { };
            لو (التوجيهات.مجموع_التحقق) { الكل.مجموع_التحقق := صواب; };
            لو (!توجيهات_كوف_غير_صالحة(&الكل)) {
                الكل.غير_صالح := رمز_توجيه_كوف_غير_الصالح(&التوجيهات);
            };
        };
        ف := ف + 1;
    }
    أرجع الكل;
}

// File name of a path (after the last '/' or '\'), lower-cased: Windows
// library names are case-insensitive and LLD remembers loaded libraries by
// that name (visitedLibs).
عام عرف اسم_ملف_صغير_كوف(المسار: &متجه غ8): متجه غ8 {
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المسار) مثل غير_موقع)) {
        لو ((*المسار)[ف] == 0x2F || (*المسار)[ف] == 0x5C) { البداية := ف + 1; };
        ف := ف + 1;
    }
    دع الناتج: متغير متجه غ8 = [];
    ف := البداية;
    بينما (ف < (الطول(*المسار) مثل غير_موقع)) {
        ألحق(الناتج, حرف_صغير_كوف((*المسار)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

