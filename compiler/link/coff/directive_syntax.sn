استورد compiler.link.section_model;
استورد std.text.from_bytes;
استورد std.chars.ascii;

// Syntax of COFF linker directives (the `.drectve` section, flagged
// IMAGE_SCN_LNK_INFO). MSVC and Clang record there the options an object
// needs instead of on the linker command line. This module only reads them;
// input completion (coff/directives.sn) applies the ones that decide which
// inputs and definitions an image contains, and the PE writer
// (coff/final_image.sn) applies the ones that shape the image. Both read the
// same parse, so a directive has one meaning wherever it is used.
//
// The accepted set is LLD's (LinkerDriver::parseDirectives; options are
// case-insensitive with a '/' or '-' prefix):
//   /DEFAULTLIB:<lib>, /NODEFAULTLIB[:<lib>]
//                                  accepted without effect: SultanC links
//                                  no C runtime and loads no library it was
//                                  not given (coff/directives.sn);
//   /ALTERNATENAME:<a>=<b>         <a>, still undefined at the end, is <b>;
//   /INCLUDE:<sym>                 <sym> is required and a liveness root;
//   /EXPORT:<name>[=<sym>|=<dll>.<sym>][,@<ordinal>[,NONAME]][,DATA]
//          [,PRIVATE][,CONSTANT]   an export (DATA, PRIVATE and CONSTANT only
//                                  shape an import library);
//   /EXCLUDE-SYMBOLS:<a>[,<b>...]  names kept out of automatic exporting;
//   /MERGE:<from>=<to>             output section <from> is laid out in <to>;
//   /SECTION:<name>,<DEKPRSW>      the output section's memory attributes;
//   /FAILIFMISMATCH:<key>=<value>  every object must agree on <key>;
//   /ENTRY:<sym>                   the image entry point;
//   /STACK:<reserve>[,<commit>]    the stack sizes of the image header;
//   /SUBSYSTEM:<name>[,<major>[.<minor>]]
//                                  the image subsystem and its version;
//   /ALIGNCOMM:<sym>,<power>       a common symbol's minimum alignment;
//   /RELEASE                       the image header carries its checksum.
// /EDITANDCONTINUE, /GUARDSYM, /THROWINGNEW, /INFERASANLIBS[:NO], /FASTFAIL,
// /DISALLOWLIB and /MANIFESTDEPENDENCY are accepted without effect on the
// image, as in LLD (the manifest dependency only reaches a manifest file,
// which SultanC does not write, and LLD does not embed one by default). Any
// other option, or a malformed value of an accepted one, is recorded as the
// section's غير_صالح token (the first one), and input completion fails the
// link naming that token and the object, as LLD reports an option that "is
// not allowed in .drectve". Previously /EXPORT forms with ordinals,
// NONAME or forwarders were rejected and every unknown directive was
// skipped silently.
// Single-valued options keep the last value. Previously /DEFAULTLIB and
// /NODEFAULTLIB were recorded in order for completion to load the named
// libraries.

عام نوع زوج_بديل_كوف = {
    الاسم: متجه ط8,
    البديل: متجه ط8
};

عام نوع تصدير_توجيه_كوف = {
    الاسم_الخارجي: متجه ط8,
    // The exported definition; empty for a forwarder.
    الاسم_الداخلي: متجه ط8,
    // "<dll>.<sym>" of a forwarder, empty otherwise.
    التحويل: متجه ط8,
    // An explicit ordinal, 0 when the PE writer assigns one.
    الترتيب: طبيعي,
    بلا_اسم: منطقي
};

عام نوع زوج_دمج_كوف = {
    المصدر: متجه ط8,
    الوجهة: متجه ط8
};

عام نوع صلاحيات_قسم_كوف = {
    الاسم: متجه ط8,
    // IMAGE_SCN_MEM_* bits replacing the output section's own.
    الخصائص: طبيعي
};

عام نوع زوج_تطابق_كوف = {
    المفتاح: متجه ط8,
    القيمة: متجه ط8
};

عام نوع محاذاة_مشترك_كوف = {
    الاسم: متجه ط8,
    القوة: طبيعي
};

عام نوع توجيهات_قسم_كوف = {
    البدائل: متجه زوج_بديل_كوف,
    المضمنة: متجه متجه ط8,
    الصادرات: متجه تصدير_توجيه_كوف,
    المستثناة_من_التصدير: متجه متجه ط8,
    الدمج: متجه زوج_دمج_كوف,
    الأقسام: متجه صلاحيات_قسم_كوف,
    التطابقات: متجه زوج_تطابق_كوف,
    محاذاة_المشتركة: متجه محاذاة_مشترك_كوف,
    الدخول: اختياري متجه ط8,
    حجز_المكدس: اختياري طبيعي,
    التزام_المكدس: اختياري طبيعي,
    النظام_الفرعي: اختياري طبيعي,
    إصدار_النظام_الرئيسي: اختياري طبيعي,
    إصدار_النظام_الفرعي: اختياري طبيعي,
    مجموع_التحقق: منطقي,
    // The first directive token not accepted, which the link reports.
    غير_صالح: اختياري متجه ط8
};

عام عرف حرف_صغير_كوف(البايت: ط8): ط8 {
    أرجع إلى_صغير_أسكي(البايت);
}

عام عرف متجها_اسم_كوف_متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف يساوي_كلمة_بلا_حالة(القيمة: &متجه ط8, الكلمة: نص): منطقي {
    دع البايتات: متجه ط8 = بايتات_من_نص(الكلمة);
    إذا ((الطول(*القيمة) مثل طبيعي) != (الطول(البايتات) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البايتات) مثل طبيعي)) {
        إذا (حرف_صغير_كوف((*القيمة)[ف]) != حرف_صغير_كوف(البايتات[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The option name of a token ("/name" or "-name", up to an optional ':'),
// compared case-insensitively with الخيار; returns the value after ':' (empty
// without one) when it matches.
عرف قيمة_خيار_كوف(الرمز: &متجه ط8, الخيار: نص): اختياري متجه ط8 {
    دع البادئة: متجه ط8 = بايتات_من_نص(الخيار);
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    دع طول_الرمز: طبيعي = الطول(*الرمز) مثل طبيعي;
    إذا (طول_الرمز < طول_البادئة + 1) { أرجع اختياري.لا_شيء(); };
    إذا ((*الرمز)[0] != 0x2F && (*الرمز)[0] != 0x2D) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_البادئة) {
        إذا (حرف_صغير_كوف((*الرمز)[ف + 1]) != حرف_صغير_كوف(البادئة[ف])) {
            أرجع اختياري.لا_شيء();
        };
        ف := ف + 1;
    }
    دع القيمة: متغير متجه ط8 = [];
    إذا (طول_الرمز == طول_البادئة + 1) { أرجع اختياري.موجود(القيمة); };
    إذا ((*الرمز)[طول_البادئة + 1] != 0x3A) { أرجع اختياري.لا_شيء(); };
    ف := طول_البادئة + 2;
    طالما (ف < طول_الرمز) {
        ألحق(القيمة, (*الرمز)[ف]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(القيمة);
}

// Windows command-line tokenization as LLD's ArgParser::tokenize: spaces,
// tabs and line breaks separate arguments outside double quotes, and the
// quotes themselves are removed. A UTF-8 byte-order mark is skipped.
عرف رموز_توجيهات_كوف(المحتوى: &متجه ط8): متجه متجه ط8 {
    دع الرموز: متغير متجه متجه ط8 = [];
    دع الحالي: متغير متجه ط8 = [];
    دع في_علامات: متغير منطقي = خطأ;
    دع له_رمز: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    إذا ((الطول(*المحتوى) مثل طبيعي) >= 3
        && (*المحتوى)[0] == 0xEF && (*المحتوى)[1] == 0xBB && (*المحتوى)[2] == 0xBF) {
        ف := 3;
    };
    طالما (ف < (الطول(*المحتوى) مثل طبيعي)) {
        دع البايت: ط8 = (*المحتوى)[ف];
        دع فاصل: منطقي = البايت == 0x20 || البايت == 0x09 || البايت == 0x0A
            || البايت == 0x0D || البايت == 0;
        إذا (البايت == 0x22) {
            في_علامات := !في_علامات;
            له_رمز := صواب;
        } وإلا إذا (فاصل && !في_علامات) {
            إذا (له_رمز) {
                ألحق(الرموز, انسخ_متجه_توجيه_كوف(&الحالي));
                دع الجديد: متجه ط8 = [];
                الحالي := الجديد;
                له_رمز := خطأ;
            };
        } وإلا {
            ألحق(الحالي, البايت);
            له_رمز := صواب;
        };
        ف := ف + 1;
    }
    إذا (له_رمز) { ألحق(الرموز, الحالي); };
    أرجع الرموز;
}

// A copy of a token, so the token buffer can be reset after it is recorded.
عام عرف انسخ_متجه_توجيه_كوف(القيمة: &متجه ط8): متجه ط8 {
    دع النسخة: متجه ط8 = انسخ_بايتات(القيمة);
    أرجع النسخة;
}

// Splits at every byte الفاصل.
عرف قسم_بفاصل_كوف(القيمة: &متجه ط8, الفاصل: ط8): متجه متجه ط8 {
    دع الحقول: متغير متجه متجه ط8 = [];
    دع الحالي: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        إذا ((*القيمة)[ف] == الفاصل) {
            ألحق(الحقول, انسخ_متجه_توجيه_كوف(&الحالي));
            دع فارغ: متجه ط8 = [];
            الحالي := فارغ;
        } وإلا {
            ألحق(الحالي, (*القيمة)[ف]);
        };
        ف := ف + 1;
    }
    ألحق(الحقول, الحالي);
    أرجع الحقول;
}

// Splits "<a>=<b>" at the first '='; none without one or with an empty side.
عرف قسم_زوج_كوف(القيمة: &متجه ط8): اختياري زوج_بديل_كوف {
    دع الاسم: متغير متجه ط8 = [];
    دع البديل: متغير متجه ط8 = [];
    دع بعد_المساواة: متغير منطقي = خطأ;
    دع ب: متغير طبيعي = 0;
    طالما (ب < (الطول(*القيمة) مثل طبيعي)) {
        إذا (!بعد_المساواة && (*القيمة)[ب] == 0x3D) {
            بعد_المساواة := صواب;
        } وإلا إذا (بعد_المساواة) {
            ألحق(البديل, (*القيمة)[ب]);
        } وإلا {
            ألحق(الاسم, (*القيمة)[ب]);
        };
        ب := ب + 1;
    }
    إذا (!بعد_المساواة || (الطول(الاسم) مثل طبيعي) == 0
        || (الطول(البديل) مثل طبيعي) == 0) {
        أرجع اختياري.لا_شيء();
    };
    دع الزوج: زوج_بديل_كوف = { الاسم: الاسم, البديل: البديل };
    أرجع اختياري.موجود(الزوج);
}

// A number as LLD's parseNumbers reads it (StringRef::getAsInteger with
// radix 0): "0x" hexadecimal, a leading "0" octal, otherwise decimal.
عرف عدد_توجيه_كوف(القيمة: &متجه ط8): اختياري طبيعي {
    دع الطول_الكلي: طبيعي = الطول(*القيمة) مثل طبيعي;
    إذا (الطول_الكلي == 0) { أرجع اختياري.لا_شيء(); };
    دع الأساس: متغير طبيعي = 10;
    دع ف: متغير طبيعي = 0;
    إذا (الطول_الكلي > 2 && (*القيمة)[0] == 0x30
        && ((*القيمة)[1] == 0x78 || (*القيمة)[1] == 0x58)) {
        الأساس := 16;
        ف := 2;
    } وإلا إذا (الطول_الكلي > 1 && (*القيمة)[0] == 0x30) {
        الأساس := 8;
        ف := 1;
    };
    دع الناتج: متغير طبيعي = 0;
    طالما (ف < الطول_الكلي) {
        دع ب: ط8 = حرف_صغير_كوف((*القيمة)[ف]);
        دع الرقم: متغير طبيعي = 99;
        إذا (ب >= 0x30 && ب <= 0x39) {
            الرقم := (ب - 0x30) مثل طبيعي;
        } وإلا إذا (ب >= 0x61 && ب <= 0x66) {
            الرقم := (ب - 0x61) مثل طبيعي + 10;
        };
        إذا (الرقم >= الأساس) { أرجع اختياري.لا_شيء(); };
        // Reject values that do not fit 32 bits; PE header fields that take
        // these numbers are at most 64-bit and no directive needs more.
        إذا (الناتج > 0xFFFFFFFF) { أرجع اختياري.لا_شيء(); };
        الناتج := الناتج * الأساس + الرقم;
        ف := ف + 1;
    }
    إذا (الناتج > 0xFFFFFFFF) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الناتج);
}

// /EXPORT value, as LLD's parseExport: "<name>[=<internal>]" then
// comma-separated attributes. None for a malformed export (LLD's "invalid
// /export:").
عرف حلل_تصدير_كوف(القيمة: &متجه ط8): اختياري تصدير_توجيه_كوف {
    دع الحقول: متجه متجه ط8 = قسم_بفاصل_كوف(القيمة, 0x2C);
    إذا ((الطول(الحقول[0]) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الخارجي: متغير متجه ط8 = [];
    دع الداخلي: متغير متجه ط8 = [];
    دع التحويل: متغير متجه ط8 = [];
    طابق قسم_زوج_كوف(&الحقول[0]) مع
    | اختياري.موجود(الزوج) -> {
        دع مرجع_الخارجي: &متجه ط8 = &الزوج.الاسم;
        دع مرجع_الداخلي: &متجه ط8 = &الزوج.البديل;
        الخارجي := انسخ_بايتات(مرجع_الخارجي);
        // A '.' in the internal name makes it a forwarder "<dll>.<sym>".
        دع فيه_نقطة: متغير منطقي = خطأ;
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(*مرجع_الداخلي) مثل طبيعي)) {
            إذا ((*مرجع_الداخلي)[ب] == 0x2E) { فيه_نقطة := صواب; };
            ب := ب + 1;
        }
        إذا (فيه_نقطة) {
            التحويل := انسخ_بايتات(مرجع_الداخلي);
        } وإلا {
            الداخلي := انسخ_بايتات(مرجع_الداخلي);
        };
    }
    | اختياري.لا_شيء -> {
        دع مرجع_الأول: &متجه ط8 = &الحقول[0];
        // "<a>=" or "=<b>" is malformed.
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(*مرجع_الأول) مثل طبيعي)) {
            إذا ((*مرجع_الأول)[ب] == 0x3D) { أرجع اختياري.لا_شيء(); };
            ب := ب + 1;
        }
        الخارجي := انسخ_بايتات(مرجع_الأول);
        الداخلي := انسخ_بايتات(مرجع_الأول);
    };
    دع الترتيب: متغير طبيعي = 0;
    دع بلا_اسم: متغير منطقي = خطأ;
    دع ح: متغير طبيعي = 1;
    طالما (ح < (الطول(الحقول) مثل طبيعي)) {
        دع الحقل: &متجه ط8 = &الحقول[ح];
        إذا ((الطول(*الحقل) مثل طبيعي) > 1 && (*الحقل)[0] == 0x40) {
            دع الرقم: متغير متجه ط8 = [];
            دع ب: متغير طبيعي = 1;
            طالما (ب < (الطول(*الحقل) مثل طبيعي)) {
                ألحق(الرقم, (*الحقل)[ب]);
                ب := ب + 1;
            }
            طابق عدد_توجيه_كوف(&الرقم) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة_العددية) -> {
                إذا (القيمة_العددية == 0 || القيمة_العددية > 0xFFFF) {
                    أرجع اختياري.لا_شيء();
                };
                الترتيب := القيمة_العددية;
            };
        } وإلا إذا (يساوي_كلمة_بلا_حالة(الحقل, «noname»)) {
            بلا_اسم := صواب;
        } وإلا إذا (!يساوي_كلمة_بلا_حالة(الحقل, «data»)
            && !يساوي_كلمة_بلا_حالة(الحقل, «private»)
            && !يساوي_كلمة_بلا_حالة(الحقل, «constant»)) {
            أرجع اختياري.لا_شيء();
        };
        ح := ح + 1;
    }
    // NONAME exports only by ordinal, so it needs one (LLD: "/export:...
    // NONAME without an ordinal" is not accepted).
    إذا (بلا_اسم && الترتيب == 0) { أرجع اختياري.لا_شيء(); };
    دع التصدير: تصدير_توجيه_كوف = {
        الاسم_الخارجي: الخارجي,
        الاسم_الداخلي: الداخلي,
        التحويل: التحويل,
        الترتيب: الترتيب,
        بلا_اسم: بلا_اسم
    };
    أرجع اختياري.موجود(التصدير);
}

// /SECTION attributes as LLD's parseSectionAttributes.
عرف صلاحيات_قسم_من_نص_كوف(القيمة: &متجه ط8): اختياري طبيعي {
    إذا ((الطول(*القيمة) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الخصائص: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        دع ب: ط8 = حرف_صغير_كوف((*القيمة)[ف]);
        إذا (ب == 0x64) {
            الخصائص := الخصائص | 0x02000000;
        } وإلا إذا (ب == 0x65) {
            الخصائص := الخصائص | 0x20000000;
        } وإلا إذا (ب == 0x6B) {
            الخصائص := الخصائص | 0x04000000;
        } وإلا إذا (ب == 0x70) {
            الخصائص := الخصائص | 0x08000000;
        } وإلا إذا (ب == 0x72) {
            الخصائص := الخصائص | 0x40000000;
        } وإلا إذا (ب == 0x73) {
            الخصائص := الخصائص | 0x10000000;
        } وإلا إذا (ب == 0x77) {
            الخصائص := الخصائص | 0x80000000;
        } وإلا {
            أرجع اختياري.لا_شيء();
        };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الخصائص);
}

// IMAGE_SUBSYSTEM_* for a /SUBSYSTEM name (LLD getSubsystem).
عرف نظام_فرعي_من_نص_كوف(القيمة: &متجه ط8): اختياري طبيعي {
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «native»)) { أرجع اختياري.موجود(1); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «windows»)) { أرجع اختياري.موجود(2); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «console»)) { أرجع اختياري.موجود(3); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «posix»)) { أرجع اختياري.موجود(7); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «windowsce»)) { أرجع اختياري.موجود(9); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «efi_application»)) { أرجع اختياري.موجود(10); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «efi_boot_service_driver»)) { أرجع اختياري.موجود(11); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «efi_runtime_driver»)) { أرجع اختياري.موجود(12); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «efi_rom»)) { أرجع اختياري.موجود(13); };
    إذا (يساوي_كلمة_بلا_حالة(القيمة, «boot_application»)) { أرجع اختياري.موجود(16); };
    أرجع اختياري.لا_شيء();
}

عرف توجيهات_فارغة_كوف(): توجيهات_قسم_كوف {
    دع البدائل: متجه زوج_بديل_كوف = [];
    دع المضمنة: متجه متجه ط8 = [];
    دع الصادرات: متجه تصدير_توجيه_كوف = [];
    دع المستثناة: متجه متجه ط8 = [];
    دع الدمج: متجه زوج_دمج_كوف = [];
    دع الأقسام: متجه صلاحيات_قسم_كوف = [];
    دع التطابقات: متجه زوج_تطابق_كوف = [];
    دع المحاذاة: متجه محاذاة_مشترك_كوف = [];
    دع الناتج: توجيهات_قسم_كوف = {
        البدائل: البدائل,
        المضمنة: المضمنة,
        الصادرات: الصادرات,
        المستثناة_من_التصدير: المستثناة,
        الدمج: الدمج,
        الأقسام: الأقسام,
        التطابقات: التطابقات,
        محاذاة_المشتركة: المحاذاة,
        الدخول: اختياري.لا_شيء(),
        حجز_المكدس: اختياري.لا_شيء(),
        التزام_المكدس: اختياري.لا_شيء(),
        النظام_الفرعي: اختياري.لا_شيء(),
        إصدار_النظام_الرئيسي: اختياري.لا_شيء(),
        إصدار_النظام_الفرعي: اختياري.لا_شيء(),
        مجموع_التحقق: خطأ,
        غير_صالح: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

// Applies one directive token to الناتج; false when the token is not an
// accepted directive or its value is malformed.
عرف طبق_رمز_توجيه_كوف(
    الناتج: &متغير توجيهات_قسم_كوف,
    الرمز: &متجه ط8
): منطقي {
    // Default-library directives name libraries (most often the C runtime)
    // that SultanC never loads; a /DEFAULTLIB still needs a name.
    طابق قيمة_خيار_كوف(الرمز, «defaultlib») مع
    | اختياري.موجود(القيمة) -> { أرجع (الطول(القيمة) مثل طبيعي) > 0; }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «nodefaultlib») مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «alternatename») مع
    | اختياري.موجود(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختياري.موجود(الزوج) -> {
            ألحق((*الناتج).البدائل, الزوج);
            أرجع صواب;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «include») مع
    | اختياري.موجود(القيمة) -> {
        إذا ((الطول(القيمة) مثل طبيعي) == 0) { أرجع خطأ; };
        ألحق((*الناتج).المضمنة, القيمة);
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «export») مع
    | اختياري.موجود(القيمة) -> {
        طابق حلل_تصدير_كوف(&القيمة) مع
        | اختياري.موجود(التصدير) -> {
            ألحق((*الناتج).الصادرات, التصدير);
            أرجع صواب;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «exclude-symbols») مع
    | اختياري.موجود(القيمة) -> {
        دع الأسماء: متجه متجه ط8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
            إذا ((الطول(الأسماء[ف]) مثل طبيعي) > 0) {
                دع مرجع_الاسم: &متجه ط8 = &الأسماء[ف];
                ألحق((*الناتج).المستثناة_من_التصدير, انسخ_بايتات(مرجع_الاسم));
            };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «merge») مع
    | اختياري.موجود(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختياري.موجود(الزوج) -> {
            دع مرجع_من: &متجه ط8 = &الزوج.الاسم;
            دع مرجع_إلى: &متجه ط8 = &الزوج.البديل;
            دع الدمج_الجديد: زوج_دمج_كوف = {
                المصدر: انسخ_بايتات(مرجع_من),
                الوجهة: انسخ_بايتات(مرجع_إلى)
            };
            ألحق((*الناتج).الدمج, الدمج_الجديد);
            أرجع صواب;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «section») مع
    | اختياري.موجود(القيمة) -> {
        دع الحقول: متجه متجه ط8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        إذا ((الطول(الحقول) مثل طبيعي) != 2
            || (الطول(الحقول[0]) مثل طبيعي) == 0) {
            أرجع خطأ;
        };
        طابق صلاحيات_قسم_من_نص_كوف(&الحقول[1]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الخصائص) -> {
            دع مرجع_الاسم: &متجه ط8 = &الحقول[0];
            دع الصلاحيات: صلاحيات_قسم_كوف = {
                الاسم: انسخ_بايتات(مرجع_الاسم),
                الخصائص: الخصائص
            };
            ألحق((*الناتج).الأقسام, الصلاحيات);
            أرجع صواب;
        };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «failifmismatch») مع
    | اختياري.موجود(القيمة) -> {
        طابق قسم_زوج_كوف(&القيمة) مع
        | اختياري.موجود(الزوج) -> {
            دع مرجع_المفتاح: &متجه ط8 = &الزوج.الاسم;
            دع مرجع_القيمة: &متجه ط8 = &الزوج.البديل;
            دع التطابق: زوج_تطابق_كوف = {
                المفتاح: انسخ_بايتات(مرجع_المفتاح),
                القيمة: انسخ_بايتات(مرجع_القيمة)
            };
            ألحق((*الناتج).التطابقات, التطابق);
            أرجع صواب;
        }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «entry») مع
    | اختياري.موجود(القيمة) -> {
        إذا ((الطول(القيمة) مثل طبيعي) == 0) { أرجع خطأ; };
        (*الناتج).الدخول := اختياري.موجود(القيمة);
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «stack») مع
    | اختياري.موجود(القيمة) -> {
        دع الحقول: متجه متجه ط8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        إذا ((الطول(الحقول) مثل طبيعي) > 2) { أرجع خطأ; };
        طابق عدد_توجيه_كوف(&الحقول[0]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الحجز) -> { (*الناتج).حجز_المكدس := اختياري.موجود(الحجز); };
        إذا ((الطول(الحقول) مثل طبيعي) == 2) {
            طابق عدد_توجيه_كوف(&الحقول[1]) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الالتزام) -> {
                (*الناتج).التزام_المكدس := اختياري.موجود(الالتزام);
            };
        };
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «subsystem») مع
    | اختياري.موجود(القيمة) -> {
        دع الحقول: متجه متجه ط8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        إذا ((الطول(الحقول) مثل طبيعي) > 2) { أرجع خطأ; };
        طابق نظام_فرعي_من_نص_كوف(&الحقول[0]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(النظام) -> { (*الناتج).النظام_الفرعي := اختياري.موجود(النظام); };
        إذا ((الطول(الحقول) مثل طبيعي) == 2) {
            دع الإصدار: متجه متجه ط8 = قسم_بفاصل_كوف(&الحقول[1], 0x2E);
            إذا ((الطول(الإصدار) مثل طبيعي) > 2) { أرجع خطأ; };
            طابق عدد_توجيه_كوف(&الإصدار[0]) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(الرئيسي) -> {
                إذا (الرئيسي > 0xFFFF) { أرجع خطأ; };
                (*الناتج).إصدار_النظام_الرئيسي := اختياري.موجود(الرئيسي);
            };
            دع الفرعي: متغير طبيعي = 0;
            إذا ((الطول(الإصدار) مثل طبيعي) == 2) {
                طابق عدد_توجيه_كوف(&الإصدار[1]) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة_الفرعية) -> { الفرعي := القيمة_الفرعية; };
            };
            إذا (الفرعي > 0xFFFF) { أرجع خطأ; };
            (*الناتج).إصدار_النظام_الفرعي := اختياري.موجود(الفرعي);
        };
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «aligncomm») مع
    | اختياري.موجود(القيمة) -> {
        دع الحقول: متجه متجه ط8 = قسم_بفاصل_كوف(&القيمة, 0x2C);
        إذا ((الطول(الحقول) مثل طبيعي) != 2
            || (الطول(الحقول[0]) مثل طبيعي) == 0) {
            أرجع خطأ;
        };
        طابق عدد_توجيه_كوف(&الحقول[1]) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(القوة) -> {
            // The section alignment field holds at most 2^13.
            إذا (القوة > 13) { أرجع خطأ; };
            دع مرجع_الاسم: &متجه ط8 = &الحقول[0];
            دع المحاذاة: محاذاة_مشترك_كوف = {
                الاسم: انسخ_بايتات(مرجع_الاسم),
                القوة: القوة
            };
            ألحق((*الناتج).محاذاة_المشتركة, المحاذاة);
            أرجع صواب;
        };
    }
    | اختياري.لا_شيء -> { };
    طابق قيمة_خيار_كوف(الرمز, «release») مع
    | اختياري.موجود(القيمة) -> {
        إذا ((الطول(القيمة) مثل طبيعي) != 0) { أرجع خطأ; };
        (*الناتج).مجموع_التحقق := صواب;
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { };
    // Accepted without effect on the image (see the module comment).
    دع بلا_أثر: متجه نص = [
        «editandcontinue», «guardsym», «throwingnew», «inferasanlibs»,
        «fastfail», «disallowlib», «manifestdependency»
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(بلا_أثر) مثل طبيعي)) {
        دع مرجع_الخيار: &نص = &بلا_أثر[ف];
        دع الخيار: نص = انسخ_نص(مرجع_الخيار);
        طابق قيمة_خيار_كوف(الرمز, الخيار) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether a directive token was rejected.
عام عرف توجيهات_كوف_غير_صالحة(التوجيهات: &توجيهات_قسم_كوف): منطقي {
    طابق (*التوجيهات).غير_صالح مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { أرجع صواب; };
}

// A copy of the first rejected directive token, if any.
عام عرف رمز_توجيه_كوف_غير_الصالح(
    التوجيهات: &توجيهات_قسم_كوف
): اختياري متجه ط8 {
    طابق (*التوجيهات).غير_صالح مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الرمز) -> {
        دع مرجع_الرمز: &متجه ط8 = &الرمز;
        دع النسخة: متجه ط8 = انسخ_بايتات(مرجع_الرمز);
        أرجع اختياري.موجود(النسخة);
    };
}

عام عرف حلل_توجيهات_كوف(المحتوى: &متجه ط8): توجيهات_قسم_كوف {
    دع الناتج: متغير توجيهات_قسم_كوف = توجيهات_فارغة_كوف();
    دع الرموز: متجه متجه ط8 = رموز_توجيهات_كوف(المحتوى);
    دع وجد_غير_صالح: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرموز) مثل طبيعي)) {
        // Every token is applied; only the first rejected one is kept.
        إذا (!طبق_رمز_توجيه_كوف(&متغير الناتج, &الرموز[ف]) && !وجد_غير_صالح) {
            وجد_غير_صالح := صواب;
            دع مرجع_الرمز: &متجه ط8 = &الرموز[ف];
            دع الرمز: متجه ط8 = انسخ_بايتات(مرجع_الرمز);
            الناتج.غير_صالح := اختياري.موجود(الرمز);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف قسم_توجيهات_كوف(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.كوف(الخصائص) -> {
        إذا ((الخصائص & 0x00000200) == 0) { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
    دع الاسم: متجه ط8 = بايتات_من_نص(«.drectve»);
    أرجع متجها_اسم_كوف_متساويان(&(*القسم).الاسم.اسم_القسم, &الاسم);
}

// The directives of one `.drectve` section (none for a section without
// content).
عام عرف توجيهات_قسم_ربط_كوف(القسم: &قسم_ربط): توجيهات_قسم_كوف {
    طابق (*القسم).المحتوى مع
    | اختياري.موجود(المحتوى) -> { أرجع حلل_توجيهات_كوف(&المحتوى); }
    | اختياري.لا_شيء -> { أرجع توجيهات_فارغة_كوف(); };
}

// The directives of every `.drectve` section among الأقسام, in section
// order: lists are concatenated and a single-valued option keeps its last
// value, as LLD applies directives object after object.
عام عرف اجمع_توجيهات_أقسام_كوف(الأقسام: &متجه قسم_ربط): توجيهات_قسم_كوف {
    دع الكل: متغير توجيهات_قسم_كوف = توجيهات_فارغة_كوف();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأقسام) مثل طبيعي)) {
        إذا (قسم_توجيهات_كوف(&(*الأقسام)[ف])) {
            دع التوجيهات: توجيهات_قسم_كوف = توجيهات_قسم_ربط_كوف(&(*الأقسام)[ف]);
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(التوجيهات.الصادرات) مثل طبيعي)) {
                دع مرجع: &تصدير_توجيه_كوف = &التوجيهات.الصادرات[م];
                ألحق(الكل.الصادرات, انسخ_مملوكا_تصدير_توجيه_كوف(مرجع));
                م := م + 1;
            }
            م := 0;
            طالما (م < (الطول(التوجيهات.المستثناة_من_التصدير) مثل طبيعي)) {
                دع مرجع: &متجه ط8 = &التوجيهات.المستثناة_من_التصدير[م];
                ألحق(الكل.المستثناة_من_التصدير, انسخ_بايتات(مرجع));
                م := م + 1;
            }
            م := 0;
            طالما (م < (الطول(التوجيهات.الدمج) مثل طبيعي)) {
                دع مرجع: &زوج_دمج_كوف = &التوجيهات.الدمج[م];
                ألحق(الكل.الدمج, انسخ_مملوكا_زوج_دمج_كوف(مرجع));
                م := م + 1;
            }
            م := 0;
            طالما (م < (الطول(التوجيهات.الأقسام) مثل طبيعي)) {
                دع مرجع: &صلاحيات_قسم_كوف = &التوجيهات.الأقسام[م];
                ألحق(الكل.الأقسام, انسخ_مملوكا_صلاحيات_قسم_كوف(مرجع));
                م := م + 1;
            }
            طابق التوجيهات.حجز_المكدس مع
            | اختياري.موجود(القيمة) -> { الكل.حجز_المكدس := اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            طابق التوجيهات.التزام_المكدس مع
            | اختياري.موجود(القيمة) -> { الكل.التزام_المكدس := اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            طابق التوجيهات.النظام_الفرعي مع
            | اختياري.موجود(القيمة) -> { الكل.النظام_الفرعي := اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            طابق التوجيهات.إصدار_النظام_الرئيسي مع
            | اختياري.موجود(القيمة) -> { الكل.إصدار_النظام_الرئيسي := اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            طابق التوجيهات.إصدار_النظام_الفرعي مع
            | اختياري.موجود(القيمة) -> { الكل.إصدار_النظام_الفرعي := اختياري.موجود(القيمة); }
            | اختياري.لا_شيء -> { };
            إذا (التوجيهات.مجموع_التحقق) { الكل.مجموع_التحقق := صواب; };
            إذا (!توجيهات_كوف_غير_صالحة(&الكل)) {
                الكل.غير_صالح := رمز_توجيه_كوف_غير_الصالح(&التوجيهات);
            };
        };
        ف := ف + 1;
    }
    أرجع الكل;
}

// File name of a path (after the last '/' or '\'), lower-cased: Windows
// library names are case-insensitive and LLD remembers loaded libraries by
// that name (visitedLibs).
عام عرف اسم_ملف_صغير_كوف(المسار: &متجه ط8): متجه ط8 {
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        إذا ((*المسار)[ف] == 0x2F || (*المسار)[ف] == 0x5C) { البداية := ف + 1; };
        ف := ف + 1;
    }
    دع الناتج: متغير متجه ط8 = [];
    ف := البداية;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        ألحق(الناتج, حرف_صغير_كوف((*المسار)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_زوج_دمج_كوف(القيمة: &زوج_دمج_كوف): زوج_دمج_كوف {
    دع الناتج: زوج_دمج_كوف = {
        المصدر: انسخ_بايتات(&(*القيمة).المصدر),
        الوجهة: انسخ_بايتات(&(*القيمة).الوجهة)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_تصدير_توجيه_كوف(القيمة: &تصدير_توجيه_كوف): تصدير_توجيه_كوف {
    دع الناتج: تصدير_توجيه_كوف = {
        الاسم_الخارجي: انسخ_بايتات(&(*القيمة).الاسم_الخارجي),
        الاسم_الداخلي: انسخ_بايتات(&(*القيمة).الاسم_الداخلي),
        التحويل: انسخ_بايتات(&(*القيمة).التحويل),
        الترتيب: (*القيمة).الترتيب,
        بلا_اسم: (*القيمة).بلا_اسم
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_صلاحيات_قسم_كوف(القيمة: &صلاحيات_قسم_كوف): صلاحيات_قسم_كوف {
    دع الناتج: صلاحيات_قسم_كوف = {
        الاسم: انسخ_بايتات(&(*القيمة).الاسم),
        الخصائص: (*القيمة).الخصائص
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_زوج_تطابق_كوف(القيمة: &زوج_تطابق_كوف): زوج_تطابق_كوف {
    دع الناتج: زوج_تطابق_كوف = {
        المفتاح: انسخ_بايتات(&(*القيمة).المفتاح),
        القيمة: انسخ_بايتات(&(*القيمة).القيمة)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_محاذاة_مشترك_كوف(القيمة: &محاذاة_مشترك_كوف): محاذاة_مشترك_كوف {
    دع الناتج: محاذاة_مشترك_كوف = {
        الاسم: انسخ_بايتات(&(*القيمة).الاسم),
        القوة: (*القيمة).القوة
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_زوج_بديل_كوف(القيمة: &زوج_بديل_كوف): زوج_بديل_كوف {
    دع الناتج: زوج_بديل_كوف = {
        الاسم: انسخ_بايتات(&(*القيمة).الاسم),
        البديل: انسخ_بايتات(&(*القيمة).البديل)
    };
    أرجع الناتج;
}
