استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.object_ingest;
استورد compiler.link.coff.target_policy;

عام نوع نتيجة_استيعاب_كائن_استيراد_كوف =
    | ليس_كائن_استيراد
    | نجح
    | غير_صالح
;

عرف اسم_مؤشر_استيراد_كوف(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [
        0x5F, 0x5F, 0x69, 0x6D, 0x70, 0x5F
    ];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف سجل_رمز_استيراد_كوف(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الاسم: &متجه غ8
): منطقي {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { أرجع خطأ; };
    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
        &متغير (*السياق).الرموز,
        الاسم,
        (*المدخل).المعرف
    ) مع
    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> { أرجع خطأ; }
    | _ -> { };
    دع اسم_المؤشر: متجه غ8 = اسم_مؤشر_استيراد_كوف(الاسم);
    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
        &متغير (*السياق).الرموز,
        &اسم_المؤشر,
        (*المدخل).المعرف
    ) مع
    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> { أرجع خطأ; }
    | _ -> { };
    أرجع صواب;
}

عام عرف استوعب_كائن_استيراد_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_استيراد_كوف {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!ضمن_حدود_كوف(البايتات, 0, 20)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    };
    دع التوقيع_الأول: غير_موقع;
    دع التوقيع_الثاني: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 0) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    }
    | اختيار.بعض(القيمة) -> { التوقيع_الأول := القيمة; };
    طابق اقرأ_غ16_كوف(البايتات, 2) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    }
    | اختيار.بعض(القيمة) -> { التوقيع_الثاني := القيمة; };
    لو (التوقيع_الأول != 0 || التوقيع_الثاني != 0xFFFF) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    };

    دع الآلة: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 6) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    دع الآلة_المطلوبة: غير_موقع;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختيار.بعض(القيمة) -> { الآلة_المطلوبة := القيمة; };
    لو (الآلة != الآلة_المطلوبة) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    دع حجم_البيانات: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, 12) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختيار.بعض(القيمة) -> { حجم_البيانات := القيمة; };
    لو (حجم_البيانات == 0
        || !ضمن_حدود_كوف(البايتات, 20, حجم_البيانات)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    دع نهاية_البيانات: غير_موقع = 20 + حجم_البيانات;
    دع الاسم: متجه غ8;
    طابق اقرأ_اسم_صفري_كوف(البايتات, 20, نهاية_البيانات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
    دع موضع_المكتبة: غير_موقع = 20 + (الطول(الاسم) مثل غير_موقع) + 1;
    دع اسم_المكتبة: متجه غ8;
    طابق اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_المكتبة,
        نهاية_البيانات
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختيار.بعض(القيمة) -> { اسم_المكتبة := القيمة; };
    لو ((الطول(اسم_المكتبة) مثل غير_موقع) == 0) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    لو (!سجل_رمز_استيراد_كوف(السياق, المدخل, &الاسم)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };
    دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط =
        اعتماد_مكتبة_ديناميكية_باسم(اسم_المكتبة);
    اربط_اعتماد_ديناميكي_بمدخل(
        &متغير الاعتماد,
        (*المدخل).المعرف
    );
    أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        الاعتماد
    );
    أرجع نتيجة_استيعاب_كائن_استيراد_كوف.نجح();
}
