استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.object_ingest;
استورد compiler.link.coff.target_policy;
استورد std.text.from_bytes;

عام نوع نتيجة_استيعاب_كائن_استيراد_كوف =
    | ليس_كائن_استيراد
    | نجح
    | غير_صالح
;

عرف اسم_مؤشر_استيراد_كوف(الاسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«__imp_»);
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(الناتج, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

// IMPORT_OBJECT_HEADER Type bits 0-1 (PE/COFF "Import Type"): only CODE (0)
// imports have a callable thunk symbol beside __imp_<name>; DATA (1) and
// CONST (2) imports define just the import address table slot, as in LLD
// (ImportFile::parse: "if (hdr->getType() == llvm::COFF::IMPORT_CODE)").
// Previously every import also defined <name>, so a reference to an imported
// data object bound to a call thunk.
عرف سجل_رمز_استيراد_كوف(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الاسم: &متجه ط8,
    استيراد_شفرة: منطقي
): منطقي {
    إذا ((الطول(*الاسم) مثل طبيعي) == 0) { أرجع خطأ; };
    إذا (استيراد_شفرة) {
        طابق سجل_رمز_مكتبة_ديناميكية_للربط(
            &متغير (*السياق).الرموز,
            الاسم,
            (*المدخل).المعرف
        ) مع
        | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> { أرجع خطأ; }
        | _ -> { };
    };
    دع اسم_المؤشر: متجه ط8 = اسم_مؤشر_استيراد_كوف(الاسم);
    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
        &متغير (*السياق).الرموز,
        &اسم_المؤشر,
        (*المدخل).المعرف
    ) مع
    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> { أرجع خطأ; }
    | _ -> { };
    أرجع صواب;
}

عام عرف استوعب_كائن_استيراد_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_استيراد_كوف {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    إذا (!ضمن_حدود_كوف(البايتات, 0, 20)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    };
    دع التوقيع_الأول: طبيعي;
    دع التوقيع_الثاني: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, 0) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    }
    | اختياري.موجود(القيمة) -> { التوقيع_الأول := القيمة; };
    طابق اقرأ_ط16_كوف(البايتات, 2) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    }
    | اختياري.موجود(القيمة) -> { التوقيع_الثاني := القيمة; };
    إذا (التوقيع_الأول != 0 || التوقيع_الثاني != 0xFFFF) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد();
    };

    دع الآلة: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, 6) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { الآلة := القيمة; };
    دع الآلة_المطلوبة: طبيعي;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { الآلة_المطلوبة := القيمة; };
    إذا (الآلة != الآلة_المطلوبة) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    دع حجم_البيانات: طبيعي;
    طابق اقرأ_ط32_كوف(البايتات, 12) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { حجم_البيانات := القيمة; };
    إذا (حجم_البيانات == 0
        || !ضمن_حدود_كوف(البايتات, 20, حجم_البيانات)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    دع نهاية_البيانات: طبيعي = 20 + حجم_البيانات;
    دع الاسم: متجه ط8;
    طابق اقرأ_اسم_صفري_كوف(البايتات, 20, نهاية_البيانات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
    دع موضع_المكتبة: طبيعي = 20 + (الطول(الاسم) مثل طبيعي) + 1;
    دع اسم_المكتبة: متجه ط8;
    طابق اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_المكتبة,
        نهاية_البيانات
    ) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { اسم_المكتبة := القيمة; };
    إذا ((الطول(اسم_المكتبة) مثل طبيعي) == 0) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };

    دع نوع_الاستيراد: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, 18) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    }
    | اختياري.موجود(القيمة) -> { نوع_الاستيراد := القيمة & 3; };
    إذا (!سجل_رمز_استيراد_كوف(السياق, المدخل, &الاسم, نوع_الاستيراد == 0)) {
        أرجع نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح();
    };
    دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط =
        اعتماد_مكتبة_ديناميكية_باسم(اسم_المكتبة);
    اربط_اعتماد_ديناميكي_بمدخل(
        &متغير الاعتماد,
        (*المدخل).المعرف
    );
    أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        الاعتماد
    );
    أرجع نتيجة_استيعاب_كائن_استيراد_كوف.نجح();
}
