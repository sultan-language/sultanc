استورد compiler.link.context;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.object_ingest;
استورد compiler.link.coff.target_policy;

عام نوع خطأ_كائن_مترابط_كوف =
    | هدف_غير_مدعوم
    | حقائق_قسم_غير_صالحة
    | مرجع_إزاحة_غير_صالح
;

عام نوع نتيجة_كائن_مترابط_كوف =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_كائن_مترابط_كوف
;

نوع موضع_قسم_كوف_مترابط = {
    موضع_المحتوى: طبيعي,
    موضع_الإزاحات: طبيعي,
    عدد_الإزاحات: طبيعي
};

عرف أكمل_كوف_إلى_محاذاة(
    الناتج: &متغير متجه ط8,
    المحاذاة: طبيعي
): فراغ {
    إذا (المحاذاة <= 1) { أرجع; };
    طالما (((الطول(*الناتج) مثل طبيعي) % المحاذاة) != 0) {
        ألحق(*الناتج, 0);
    }
}

عرف ألحق_بايتات_كوف(
    الناتج: &متغير متجه ط8,
    البايتات: &متجه ط8
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*البايتات) مثل طبيعي)) {
        ألحق(*الناتج, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
}

عرف ألحق_صفرا_كوف(
    الناتج: &متغير متجه ط8,
    العدد: طبيعي
): فراغ {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ألحق(*الناتج, 0);
        الفهرس := الفهرس + 1;
    }
}

عرف ألحق_عدد_عشري_كوف(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    إذا (القيمة >= 10) {
        ألحق_عدد_عشري_كوف(الناتج, القيمة / 10);
    };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

عرف أضف_اسم_جدول_نصوص_كوف(
    جدول_النصوص: &متغير متجه ط8,
    الاسم: &متجه ط8
): طبيعي {
    دع الإزاحة: طبيعي = (الطول(*جدول_النصوص) مثل طبيعي) + 4;
    ألحق_بايتات_كوف(جدول_النصوص, الاسم);
    ألحق(*جدول_النصوص, 0);
    أرجع الإزاحة;
}

عرف ألحق_اسم_قسم_كوف_مترابط(
    الناتج: &متغير متجه ط8,
    الاسم: &متجه ط8,
    جدول_النصوص: &متغير متجه ط8
): فراغ {
    إذا ((الطول(*الاسم) مثل طبيعي) <= 8) {
        ألحق_بايتات_كوف(الناتج, الاسم);
        ألحق_صفرا_كوف(الناتج, 8 - (الطول(*الاسم) مثل طبيعي));
        أرجع;
    };
    دع الإزاحة: طبيعي = أضف_اسم_جدول_نصوص_كوف(
        جدول_النصوص,
        الاسم
    );
    دع الاسم_المشفر: متغير متجه ط8 = [0x2F];
    ألحق_عدد_عشري_كوف(&متغير الاسم_المشفر, الإزاحة);
    ألحق_بايتات_كوف(الناتج, &الاسم_المشفر);
    ألحق_صفرا_كوف(
        الناتج,
        8 - (الطول(الاسم_المشفر) مثل طبيعي)
    );
}

عرف ألحق_اسم_رمز_كوف_مترابط(
    الناتج: &متغير متجه ط8,
    الاسم: &متجه ط8,
    جدول_النصوص: &متغير متجه ط8
): فراغ {
    إذا ((الطول(*الاسم) مثل طبيعي) <= 8) {
        ألحق_بايتات_كوف(الناتج, الاسم);
        ألحق_صفرا_كوف(الناتج, 8 - (الطول(*الاسم) مثل طبيعي));
        أرجع;
    };
    دع الإزاحة: طبيعي = أضف_اسم_جدول_نصوص_كوف(
        جدول_النصوص,
        الاسم
    );
    ألحق_ط32_كوف(الناتج, 0);
    ألحق_ط32_كوف(الناتج, الإزاحة);
}

عرف فهرس_قسم_كوف_مترابط(
    الأقسام: &متجه قسم_ربط,
    المعرف: معرف_قسم_ربط
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الأقسام) مثل طبيعي)) {
        إذا ((*الأقسام)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختياري.موجود(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف فهرس_رمز_كوف_مترابط(
    السياق: &سياق_ربط,
    المعرف: معرف_رمز_ربط,
    عدد_الأقسام: طبيعي
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        إذا ((*السياق).الرموز.الرموز[الفهرس].المعرف.القيمة
            == المعرف.القيمة) {
            أرجع اختياري.موجود(عدد_الأقسام + الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف عدد_إزاحات_قسم_كوف_مترابط(
    السياق: &سياق_ربط,
    المعرف: معرف_قسم_ربط
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        إذا ((*السياق).الإزاحات[الفهرس].القسم.القيمة == المعرف.القيمة) {
            العدد := العدد + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ألحق_إزاحات_قسم_كوف_مترابط(
    الناتج: &متغير متجه ط8,
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط,
    عدد_الأقسام: طبيعي
): منطقي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الإزاحات) مثل طبيعي)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        إذا ((*الحافة).القسم.القيمة == القسم.القيمة) {
            دع فهرس_الرمز: طبيعي;
            طابق (*الحافة).المرجع مع
            | مرجع_إزاحة_ربط.رمز(المعرف) -> {
                طابق فهرس_رمز_كوف_مترابط(
                    السياق,
                    المعرف,
                    عدد_الأقسام
                ) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { فهرس_الرمز := القيمة; };
            }
            | مرجع_إزاحة_ربط.قسم(المعرف) -> {
                طابق فهرس_قسم_كوف_مترابط(&(*السياق).الأقسام, المعرف) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(القيمة) -> { فهرس_الرمز := القيمة; };
            };
            ألحق_ط32_كوف(الناتج, (*الحافة).الإزاحة);
            ألحق_ط32_كوف(الناتج, فهرس_الرمز);
            ألحق_ط16_كوف(الناتج, (*الحافة).رمز_صيغة);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عرف رقم_قسم_رمز_كوف_مترابط(
    السياق: &سياق_ربط,
    الموضع: &موضع_تعريف_رمز_ربط
): اختياري طبيعي {
    طابق *الموضع مع
    | موضع_تعريف_رمز_ربط.قسم(المعرف, _) -> {
        طابق فهرس_قسم_كوف_مترابط(&(*السياق).الأقسام, المعرف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة + 1); };
    }
    | موضع_تعريف_رمز_ربط.مطلق(_) -> { أرجع اختياري.موجود(0xFFFF); }
    | موضع_تعريف_رمز_ربط.غير_محدد -> { أرجع اختياري.موجود(0); };
}

عام عرف ابن_كائن_كوف_مترابط(
    السياق: &سياق_ربط
): نتيجة_كائن_مترابط_كوف {
    دع الآلة: طبيعي;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_كائن_مترابط_كوف.خطأ(
            خطأ_كائن_مترابط_كوف.هدف_غير_مدعوم()
        );
    }
    | اختياري.موجود(القيمة) -> { الآلة := القيمة; };
    دع عدد_الأقسام: طبيعي = الطول((*السياق).الأقسام) مثل طبيعي;
    إذا (عدد_الأقسام > 0xFFFF) {
        أرجع نتيجة_كائن_مترابط_كوف.خطأ(
            خطأ_كائن_مترابط_كوف.حقائق_قسم_غير_صالحة()
        );
    };

    دع جدول_النصوص: متغير متجه ط8 = [];
    دع رؤوس_الأقسام: متغير متجه ط8 = [];
    دع مواضع_الأقسام: متغير متجه موضع_قسم_كوف_مترابط = [];
    دع الناتج: متغير متجه ط8 = [];
    ألحق_صفرا_كوف(
        &متغير الناتج,
        20 + عدد_الأقسام * 40
    );

    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع الخصائص: طبيعي;
        طابق (*القسم).حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.كوف(القيمة) -> { الخصائص := القيمة; }
        | _ -> {
            أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                خطأ_كائن_مترابط_كوف.حقائق_قسم_غير_صالحة()
            );
        };
        أكمل_كوف_إلى_محاذاة(&متغير الناتج, (*القسم).المحاذاة);
        دع موضع_المحتوى: طبيعي = الطول(الناتج) مثل طبيعي;
        طابق (*القسم).المحتوى مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المحتوى) -> {
            ألحق_بايتات_كوف(&متغير الناتج, &المحتوى);
        };
        دع عدد_الإزاحات: طبيعي = عدد_إزاحات_قسم_كوف_مترابط(
            السياق,
            (*القسم).المعرف
        );
        دع موضع_الإزاحات: طبيعي = الطول(الناتج) مثل طبيعي;
        إذا (!ألحق_إزاحات_قسم_كوف_مترابط(
            &متغير الناتج,
            السياق,
            (*القسم).المعرف,
            عدد_الأقسام
        )) {
            أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                خطأ_كائن_مترابط_كوف.مرجع_إزاحة_غير_صالح()
            );
        };
        دع الموضع: موضع_قسم_كوف_مترابط = {
            موضع_المحتوى: موضع_المحتوى,
            موضع_الإزاحات: موضع_الإزاحات,
            عدد_الإزاحات: عدد_الإزاحات
        };
        ألحق(مواضع_الأقسام, الموضع);

        ألحق_اسم_قسم_كوف_مترابط(
            &متغير رؤوس_الأقسام,
            &(*القسم).الاسم.اسم_القسم,
            &متغير جدول_النصوص
        );
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, 0);
        دع حجم_المحتوى: متغير طبيعي = 0;
        طابق (*القسم).المحتوى مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المحتوى) -> {
            حجم_المحتوى := الطول(المحتوى) مثل طبيعي;
        };
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, حجم_المحتوى);
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, موضع_المحتوى);
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, موضع_الإزاحات);
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_ط16_كوف(&متغير رؤوس_الأقسام, عدد_الإزاحات);
        ألحق_ط16_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_ط32_كوف(&متغير رؤوس_الأقسام, الخصائص);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع موضع_جدول_الرموز: طبيعي = الطول(الناتج) مثل طبيعي;
    دع الرموز: متغير متجه ط8 = [];
    فهرس_القسم := 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        ألحق_اسم_رمز_كوف_مترابط(
            &متغير الرموز,
            &(*القسم).الاسم.اسم_القسم,
            &متغير جدول_النصوص
        );
        ألحق_ط32_كوف(&متغير الرموز, 0);
        ألحق_ط16_كوف(&متغير الرموز, فهرس_القسم + 1);
        ألحق_ط16_كوف(&متغير الرموز, 0);
        ألحق(الرموز, 3);
        ألحق(الرموز, 0);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        ألحق_اسم_رمز_كوف_مترابط(
            &متغير الرموز,
            &(*الرمز).الاسم,
            &متغير جدول_النصوص
        );
        دع القيمة: متغير طبيعي = 0;
        دع رقم_القسم: متغير طبيعي = 0;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(_, الإزاحة) -> {
                القيمة := الإزاحة;
            }
            | موضع_تعريف_رمز_ربط.مطلق(المطلق) -> { القيمة := المطلق; }
            | موضع_تعريف_رمز_ربط.غير_محدد -> { };
            طابق رقم_قسم_رمز_كوف_مترابط(
                السياق,
                &التعريف.الموضع
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                    خطأ_كائن_مترابط_كوف.مرجع_إزاحة_غير_صالح()
                );
            }
            | اختياري.موجود(الرقم) -> { رقم_القسم := الرقم; };
        }
        | _ -> { };
        ألحق_ط32_كوف(&متغير الرموز, القيمة);
        ألحق_ط16_كوف(&متغير الرموز, رقم_القسم);
        ألحق_ط16_كوف(&متغير الرموز, 0);
        ألحق(الرموز, 2);
        ألحق(الرموز, 0);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    ألحق_بايتات_كوف(&متغير الناتج, &الرموز);
    دع عدد_الرموز: طبيعي = عدد_الأقسام
        + (الطول((*السياق).الرموز.الرموز) مثل طبيعي);
    دع حجم_جدول_النصوص: طبيعي =
        (الطول(جدول_النصوص) مثل طبيعي) + 4;
    ألحق_ط32_كوف(&متغير الناتج, حجم_جدول_النصوص);
    ألحق_بايتات_كوف(&متغير الناتج, &جدول_النصوص);

    دع الرأس: متغير متجه ط8 = [];
    ألحق_ط16_كوف(&متغير الرأس, الآلة);
    ألحق_ط16_كوف(&متغير الرأس, عدد_الأقسام);
    ألحق_ط32_كوف(&متغير الرأس, 0);
    ألحق_ط32_كوف(&متغير الرأس, موضع_جدول_الرموز);
    ألحق_ط32_كوف(&متغير الرأس, عدد_الرموز);
    ألحق_ط16_كوف(&متغير الرأس, 0);
    ألحق_ط16_كوف(&متغير الرأس, 0);
    دع فهرس_الرأس: متغير طبيعي = 0;
    طالما (فهرس_الرأس < 20) {
        الناتج[فهرس_الرأس] := الرأس[فهرس_الرأس];
        فهرس_الرأس := فهرس_الرأس + 1;
    }
    فهرس_الرأس := 0;
    طالما (فهرس_الرأس < (الطول(رؤوس_الأقسام) مثل طبيعي)) {
        دع موضع_الرأس: طبيعي = 20 + فهرس_الرأس;
        الناتج[موضع_الرأس] := رؤوس_الأقسام[فهرس_الرأس];
        فهرس_الرأس := فهرس_الرأس + 1;
    }
    أرجع نتيجة_كائن_مترابط_كوف.نجح(الناتج);
}
