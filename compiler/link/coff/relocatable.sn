استورد compiler.link.context;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.relocation_model;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.object_ingest;
استورد compiler.link.coff.target_policy;

عام نوع خطأ_كائن_مترابط_كوف =
    | هدف_غير_مدعوم
    | حقائق_قسم_غير_صالحة
    | مرجع_إزاحة_غير_صالح
;

عام نوع نتيجة_كائن_مترابط_كوف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_كائن_مترابط_كوف
;

نوع موضع_قسم_كوف_مترابط = {
    موضع_المحتوى: غير_موقع,
    موضع_الإزاحات: غير_موقع,
    عدد_الإزاحات: غير_موقع
};

عرف أكمل_كوف_إلى_محاذاة(
    الناتج: &متغير متجه غ8,
    المحاذاة: غير_موقع
): فراغ {
    لو (المحاذاة <= 1) { أرجع; };
    بينما (((الطول(*الناتج) مثل غير_موقع) % المحاذاة) != 0) {
        ألحق(*الناتج, 0);
    }
}

عرف ألحق_بايتات_كوف(
    الناتج: &متغير متجه غ8,
    البايتات: &متجه غ8
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*البايتات) مثل غير_موقع)) {
        ألحق(*الناتج, (*البايتات)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
}

عرف ألحق_صفرا_كوف(
    الناتج: &متغير متجه غ8,
    العدد: غير_موقع
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        ألحق(*الناتج, 0);
        الفهرس := الفهرس + 1;
    }
}

عرف ألحق_عدد_عشري_كوف(
    الناتج: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    لو (القيمة >= 10) {
        ألحق_عدد_عشري_كوف(الناتج, القيمة / 10);
    };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل غ8);
}

عرف أضف_اسم_جدول_نصوص_كوف(
    جدول_النصوص: &متغير متجه غ8,
    الاسم: &متجه غ8
): غير_موقع {
    دع الإزاحة: غير_موقع = (الطول(*جدول_النصوص) مثل غير_موقع) + 4;
    ألحق_بايتات_كوف(جدول_النصوص, الاسم);
    ألحق(*جدول_النصوص, 0);
    أرجع الإزاحة;
}

عرف ألحق_اسم_قسم_كوف_مترابط(
    الناتج: &متغير متجه غ8,
    الاسم: &متجه غ8,
    جدول_النصوص: &متغير متجه غ8
): فراغ {
    لو ((الطول(*الاسم) مثل غير_موقع) <= 8) {
        ألحق_بايتات_كوف(الناتج, الاسم);
        ألحق_صفرا_كوف(الناتج, 8 - (الطول(*الاسم) مثل غير_موقع));
        أرجع;
    };
    دع الإزاحة: غير_موقع = أضف_اسم_جدول_نصوص_كوف(
        جدول_النصوص,
        الاسم
    );
    دع الاسم_المشفر: متغير متجه غ8 = [0x2F];
    ألحق_عدد_عشري_كوف(&متغير الاسم_المشفر, الإزاحة);
    ألحق_بايتات_كوف(الناتج, &الاسم_المشفر);
    ألحق_صفرا_كوف(
        الناتج,
        8 - (الطول(الاسم_المشفر) مثل غير_موقع)
    );
}

عرف ألحق_اسم_رمز_كوف_مترابط(
    الناتج: &متغير متجه غ8,
    الاسم: &متجه غ8,
    جدول_النصوص: &متغير متجه غ8
): فراغ {
    لو ((الطول(*الاسم) مثل غير_موقع) <= 8) {
        ألحق_بايتات_كوف(الناتج, الاسم);
        ألحق_صفرا_كوف(الناتج, 8 - (الطول(*الاسم) مثل غير_موقع));
        أرجع;
    };
    دع الإزاحة: غير_موقع = أضف_اسم_جدول_نصوص_كوف(
        جدول_النصوص,
        الاسم
    );
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ32_كوف(الناتج, الإزاحة);
}

عرف فهرس_قسم_كوف_مترابط(
    الأقسام: &متجه قسم_ربط,
    المعرف: معرف_قسم_ربط
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        لو ((*الأقسام)[الفهرس].المعرف.القيمة == المعرف.القيمة) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف فهرس_رمز_كوف_مترابط(
    السياق: &سياق_ربط,
    المعرف: معرف_رمز_ربط,
    عدد_الأقسام: غير_موقع
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        لو ((*السياق).الرموز.الرموز[الفهرس].المعرف.القيمة
            == المعرف.القيمة) {
            أرجع اختيار.بعض(عدد_الأقسام + الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف عدد_إزاحات_قسم_كوف_مترابط(
    السياق: &سياق_ربط,
    المعرف: معرف_قسم_ربط
): غير_موقع {
    دع العدد: متغير غير_موقع = 0;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        لو ((*السياق).الإزاحات[الفهرس].القسم.القيمة == المعرف.القيمة) {
            العدد := العدد + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع العدد;
}

عرف ألحق_إزاحات_قسم_كوف_مترابط(
    الناتج: &متغير متجه غ8,
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط,
    عدد_الأقسام: غير_موقع
): منطقي {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        لو ((*الحافة).القسم.القيمة == القسم.القيمة) {
            دع فهرس_الرمز: غير_موقع;
            طابق (*الحافة).المرجع مع
            | مرجع_إزاحة_ربط.رمز(المعرف) -> {
                طابق فهرس_رمز_كوف_مترابط(
                    السياق,
                    المعرف,
                    عدد_الأقسام
                ) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { فهرس_الرمز := القيمة; };
            }
            | مرجع_إزاحة_ربط.قسم(المعرف) -> {
                طابق فهرس_قسم_كوف_مترابط(&(*السياق).الأقسام, المعرف) مع
                | اختيار.لا_شيء -> { أرجع خطأ; }
                | اختيار.بعض(القيمة) -> { فهرس_الرمز := القيمة; };
            };
            ألحق_غ32_كوف(الناتج, (*الحافة).الإزاحة);
            ألحق_غ32_كوف(الناتج, فهرس_الرمز);
            ألحق_غ16_كوف(الناتج, (*الحافة).رمز_صيغة);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عرف رقم_قسم_رمز_كوف_مترابط(
    السياق: &سياق_ربط,
    الموضع: &موضع_تعريف_رمز_ربط
): اختيار غير_موقع {
    طابق *الموضع مع
    | موضع_تعريف_رمز_ربط.قسم(المعرف, _) -> {
        طابق فهرس_قسم_كوف_مترابط(&(*السياق).الأقسام, المعرف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة + 1); };
    }
    | موضع_تعريف_رمز_ربط.مطلق(_) -> { أرجع اختيار.بعض(0xFFFF); }
    | موضع_تعريف_رمز_ربط.غير_محدد -> { أرجع اختيار.بعض(0); };
}

عام عرف ابن_كائن_كوف_مترابط(
    السياق: &سياق_ربط
): نتيجة_كائن_مترابط_كوف {
    دع الآلة: غير_موقع;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_كائن_مترابط_كوف.خطأ(
            خطأ_كائن_مترابط_كوف.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    دع عدد_الأقسام: غير_موقع = الطول((*السياق).الأقسام) مثل غير_موقع;
    لو (عدد_الأقسام > 0xFFFF) {
        أرجع نتيجة_كائن_مترابط_كوف.خطأ(
            خطأ_كائن_مترابط_كوف.حقائق_قسم_غير_صالحة()
        );
    };

    دع جدول_النصوص: متغير متجه غ8 = [];
    دع رؤوس_الأقسام: متغير متجه غ8 = [];
    دع مواضع_الأقسام: متغير متجه موضع_قسم_كوف_مترابط = [];
    دع الناتج: متغير متجه غ8 = [];
    ألحق_صفرا_كوف(
        &متغير الناتج,
        20 + عدد_الأقسام * 40
    );

    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        دع الخصائص: غير_موقع;
        طابق (*القسم).حقائق_الصيغة مع
        | حقائق_صيغة_قسم_ربط.كوف(القيمة) -> { الخصائص := القيمة; }
        | _ -> {
            أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                خطأ_كائن_مترابط_كوف.حقائق_قسم_غير_صالحة()
            );
        };
        أكمل_كوف_إلى_محاذاة(&متغير الناتج, (*القسم).المحاذاة);
        دع موضع_المحتوى: غير_موقع = الطول(الناتج) مثل غير_موقع;
        طابق (*القسم).المحتوى مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المحتوى) -> {
            ألحق_بايتات_كوف(&متغير الناتج, &المحتوى);
        };
        دع عدد_الإزاحات: غير_موقع = عدد_إزاحات_قسم_كوف_مترابط(
            السياق,
            (*القسم).المعرف
        );
        دع موضع_الإزاحات: غير_موقع = الطول(الناتج) مثل غير_موقع;
        لو (!ألحق_إزاحات_قسم_كوف_مترابط(
            &متغير الناتج,
            السياق,
            (*القسم).المعرف,
            عدد_الأقسام
        )) {
            أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                خطأ_كائن_مترابط_كوف.مرجع_إزاحة_غير_صالح()
            );
        };
        دع الموضع: موضع_قسم_كوف_مترابط = {
            موضع_المحتوى: موضع_المحتوى,
            موضع_الإزاحات: موضع_الإزاحات,
            عدد_الإزاحات: عدد_الإزاحات
        };
        ألحق(مواضع_الأقسام, الموضع);

        ألحق_اسم_قسم_كوف_مترابط(
            &متغير رؤوس_الأقسام,
            &(*القسم).الاسم.اسم_القسم,
            &متغير جدول_النصوص
        );
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, 0);
        دع حجم_المحتوى: متغير غير_موقع = 0;
        طابق (*القسم).المحتوى مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المحتوى) -> {
            حجم_المحتوى := الطول(المحتوى) مثل غير_موقع;
        };
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, حجم_المحتوى);
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, موضع_المحتوى);
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, موضع_الإزاحات);
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_غ16_كوف(&متغير رؤوس_الأقسام, عدد_الإزاحات);
        ألحق_غ16_كوف(&متغير رؤوس_الأقسام, 0);
        ألحق_غ32_كوف(&متغير رؤوس_الأقسام, الخصائص);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع موضع_جدول_الرموز: غير_موقع = الطول(الناتج) مثل غير_موقع;
    دع الرموز: متغير متجه غ8 = [];
    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[فهرس_القسم];
        ألحق_اسم_رمز_كوف_مترابط(
            &متغير الرموز,
            &(*القسم).الاسم.اسم_القسم,
            &متغير جدول_النصوص
        );
        ألحق_غ32_كوف(&متغير الرموز, 0);
        ألحق_غ16_كوف(&متغير الرموز, فهرس_القسم + 1);
        ألحق_غ16_كوف(&متغير الرموز, 0);
        ألحق(الرموز, 3);
        ألحق(الرموز, 0);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        ألحق_اسم_رمز_كوف_مترابط(
            &متغير الرموز,
            &(*الرمز).الاسم,
            &متغير جدول_النصوص
        );
        دع القيمة: متغير غير_موقع = 0;
        دع رقم_القسم: متغير غير_موقع = 0;
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(_, الإزاحة) -> {
                القيمة := الإزاحة;
            }
            | موضع_تعريف_رمز_ربط.مطلق(المطلق) -> { القيمة := المطلق; }
            | موضع_تعريف_رمز_ربط.غير_محدد -> { };
            طابق رقم_قسم_رمز_كوف_مترابط(
                السياق,
                &التعريف.الموضع
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_كائن_مترابط_كوف.خطأ(
                    خطأ_كائن_مترابط_كوف.مرجع_إزاحة_غير_صالح()
                );
            }
            | اختيار.بعض(الرقم) -> { رقم_القسم := الرقم; };
        }
        | _ -> { };
        ألحق_غ32_كوف(&متغير الرموز, القيمة);
        ألحق_غ16_كوف(&متغير الرموز, رقم_القسم);
        ألحق_غ16_كوف(&متغير الرموز, 0);
        ألحق(الرموز, 2);
        ألحق(الرموز, 0);
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    ألحق_بايتات_كوف(&متغير الناتج, &الرموز);
    دع عدد_الرموز: غير_موقع = عدد_الأقسام
        + (الطول((*السياق).الرموز.الرموز) مثل غير_موقع);
    دع حجم_جدول_النصوص: غير_موقع =
        (الطول(جدول_النصوص) مثل غير_موقع) + 4;
    ألحق_غ32_كوف(&متغير الناتج, حجم_جدول_النصوص);
    ألحق_بايتات_كوف(&متغير الناتج, &جدول_النصوص);

    دع الرأس: متغير متجه غ8 = [];
    ألحق_غ16_كوف(&متغير الرأس, الآلة);
    ألحق_غ16_كوف(&متغير الرأس, عدد_الأقسام);
    ألحق_غ32_كوف(&متغير الرأس, 0);
    ألحق_غ32_كوف(&متغير الرأس, موضع_جدول_الرموز);
    ألحق_غ32_كوف(&متغير الرأس, عدد_الرموز);
    ألحق_غ16_كوف(&متغير الرأس, 0);
    ألحق_غ16_كوف(&متغير الرأس, 0);
    دع فهرس_الرأس: متغير غير_موقع = 0;
    بينما (فهرس_الرأس < 20) {
        الناتج[فهرس_الرأس] := الرأس[فهرس_الرأس];
        فهرس_الرأس := فهرس_الرأس + 1;
    }
    فهرس_الرأس := 0;
    بينما (فهرس_الرأس < (الطول(رؤوس_الأقسام) مثل غير_موقع)) {
        دع موضع_الرأس: غير_موقع = 20 + فهرس_الرأس;
        الناتج[موضع_الرأس] := رؤوس_الأقسام[فهرس_الرأس];
        فهرس_الرأس := فهرس_الرأس + 1;
    }
    أرجع نتيجة_كائن_مترابط_كوف.نجح(الناتج);
}
