استورد compiler.backend.target.target_model;

عام نوع سياسة_هدف_كوف = {
    الآلة: غير_موقع,
    عرض_المؤشر: غير_موقع
};

عام عرف آلة_كوف_للهدف(الهدف: &واصف_هدف): اختيار غير_موقع {
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.كوف()) {
        أرجع اختيار.لا_شيء();
    };
    لو ((*الهدف).المنصة.المنصة != هوية_منصة.ويندوز()) {
        أرجع اختيار.لا_شيء();
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختيار.بعض(0x8664);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختيار.بعض(0xAA64);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف سياسة_كوف_للهدف(الهدف: &واصف_هدف): اختيار سياسة_هدف_كوف {
    دع الآلة: غير_موقع;
    طابق آلة_كوف_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    دع السياسة: سياسة_هدف_كوف = {
        الآلة: الآلة,
        عرض_المؤشر: (*الهدف).نموذج_البيانات.عرض_المؤشر
    };
    أرجع اختيار.بعض(السياسة);
}
