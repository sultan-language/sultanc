استورد compiler.backend.target.target_model;

عام نوع سياسة_هدف_كوف = {
    الآلة: طبيعي,
    عرض_المؤشر: طبيعي
};

عام عرف آلة_كوف_للهدف(الهدف: &واصف_هدف): اختياري طبيعي {
    لو ((*الهدف).صيغة_الكائن != صيغة_كائن_هدف.كوف()) {
        أرجع اختياري.لا_شيء();
    };
    لو ((*الهدف).المنصة.المنصة != هوية_منصة.ويندوز()) {
        أرجع اختياري.لا_شيء();
    };
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        أرجع اختياري.موجود(0x8664);
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        أرجع اختياري.موجود(0xAA64);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف سياسة_كوف_للهدف(الهدف: &واصف_هدف): اختياري سياسة_هدف_كوف {
    دع الآلة: طبيعي;
    طابق آلة_كوف_للهدف(الهدف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الآلة := القيمة; };
    دع السياسة: سياسة_هدف_كوف = {
        الآلة: الآلة,
        عرض_المؤشر: (*الهدف).نموذج_البيانات.عرض_المؤشر
    };
    أرجع اختياري.موجود(السياسة);
}
