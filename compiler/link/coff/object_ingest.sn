استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.resolution;
استورد compiler.link.reachability;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.target_policy;
استورد compiler.backend.target.target_model;

عام نوع خطأ_استيعاب_كائن_كوف =
    | كائن_غير_صالح
    | إزاحة_غير_صالحة
    | تعريف_رمز_مكرر
    | سعة_رموز_غير_قابلة_للتمثيل
    | حل_رمز_يتطلب_سياسة
;

عام نوع نتيجة_استيعاب_كائن_كوف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_كوف
;

نوع حقيقة_قسم_كوف_مدخل = {
    // None for a COMDAT section discarded in favour of an earlier copy.
    معرف_الربط: اختيار معرف_قسم_ربط,
    الاسم: متجه غ8,
    حجم_المحتوى: غير_موقع,
    موضع_المحتوى: غير_موقع,
    موضع_الإزاحات: غير_موقع,
    عدد_الإزاحات: غير_موقع,
    الخصائص: غير_موقع
};

نوع حقيقة_رمز_كوف_مدخل = {
    معرف_الربط: اختيار معرف_رمز_ربط,
    رقم_القسم: عدد,
    القيمة: غير_موقع,
    محلي: منطقي,
    صالح: منطقي
};

عرف انسخ_بايتات_اسم_كوف_للربط(المصدر: &متجه غ8): متجه غ8 {
    دع النسخة: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(النسخة, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع النسخة;
}

عرف صنف_قسم_كوف(الخصائص: غير_موقع): صنف_قسم_ربط {
    لو ((الخصائص & 0x00000020) != 0) {
        أرجع صنف_قسم_ربط.شفرة();
    };
    لو ((الخصائص & 0x00000080) != 0) {
        أرجع صنف_قسم_ربط.بيانات_صفرية();
    };
    لو ((الخصائص & 0x02000000) != 0
        || (الخصائص & 0x00000200) != 0) {
        أرجع صنف_قسم_ربط.تصحيح();
    };
    لو ((الخصائص & 0x80000000) != 0) {
        أرجع صنف_قسم_ربط.بيانات_قابلة_للكتابة();
    };
    أرجع صنف_قسم_ربط.بيانات_للقراءة();
}

عرف محاذاة_قسم_كوف(الخصائص: غير_موقع): غير_موقع {
    دع ترميز_المحاذاة: غير_موقع = (الخصائص >> 20) & 0xF;
    لو (ترميز_المحاذاة == 0) { أرجع 1; };
    لو (ترميز_المحاذاة > 14) { أرجع 1; };
    أرجع 1 << (ترميز_المحاذاة - 1);
}

عرف رقم_عشري_من_اسم_كوف(
    الاسم: &متجه غ8,
    البداية: غير_موقع
): اختيار غير_موقع {
    دع القيمة: متغير غير_موقع = 0;
    دع الفهرس: متغير غير_موقع = البداية;
    دع وجد: متغير منطقي = خطأ;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        دع البايت: غ8 = (*الاسم)[الفهرس];
        لو (البايت < 0x30 || البايت > 0x39) {
            أرجع اختيار.لا_شيء();
        };
        وجد := صواب;
        القيمة := القيمة * 10 + ((البايت - 0x30) مثل غير_موقع);
        الفهرس := الفهرس + 1;
    }
    لو (!وجد) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة);
}

عرف اسم_قسم_كوف(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع,
    موضع_جدول_النصوص: غير_موقع,
    حجم_جدول_النصوص: غير_موقع
): اختيار متجه غ8 {
    دع الاسم_المباشر: متجه غ8;
    طابق اقرأ_اسم_ثابت_كوف(البايتات, موضع_الرأس, 8) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الاسم_المباشر := القيمة; };
    لو ((الطول(الاسم_المباشر) مثل غير_موقع) == 0
        || الاسم_المباشر[0] != 0x2F) {
        أرجع اختيار.بعض(الاسم_المباشر);
    };
    دع الإزاحة: غير_موقع;
    طابق رقم_عشري_من_اسم_كوف(&الاسم_المباشر, 1) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
    لو (الإزاحة >= حجم_جدول_النصوص) { أرجع اختيار.لا_شيء(); };
    أرجع اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_جدول_النصوص + الإزاحة,
        موضع_جدول_النصوص + حجم_جدول_النصوص
    );
}

عرف اسم_رمز_كوف(
    البايتات: &متجه غ8,
    موضع_الرمز: غير_موقع,
    موضع_جدول_النصوص: غير_موقع,
    حجم_جدول_النصوص: غير_موقع
): اختيار متجه غ8 {
    دع صفر_الاسم: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { صفر_الاسم := القيمة; };
    لو (صفر_الاسم != 0) {
        أرجع اقرأ_اسم_ثابت_كوف(البايتات, موضع_الرمز, 8);
    };
    دع الإزاحة: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 4) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
    لو (الإزاحة < 4 || الإزاحة >= حجم_جدول_النصوص) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_جدول_النصوص + الإزاحة,
        موضع_جدول_النصوص + حجم_جدول_النصوص
    );
}

عرف حول_نتيجة_تسجيل_رمز_كوف(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_كوف {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_كوف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_كوف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.تعريف_رمز_مكرر()
            );
        }
        | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | _ -> {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عرف فك_عدد_موقع_كوف(
    الخام: غير_موقع,
    عدد_البتات: غير_موقع
): عدد {
    دع حد_الإشارة: غير_موقع = 1 << (عدد_البتات - 1);
    دع المدى: غير_موقع = 1 << عدد_البتات;
    لو (الخام < حد_الإشارة) { أرجع الخام مثل عدد; };
    أرجع -((المدى - الخام) مثل عدد);
}

عرف إضافة_تعليمة_كوف_ذراع64(
    التعليمة: غير_موقع,
    النوع: غير_موقع
): اختيار عدد {
    لو (النوع == 3) {
        دع الفوري: غير_موقع = التعليمة & 0x03FFFFFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 26) * 4);
    };
    لو (النوع == 4 || النوع == 5) {
        دع المنخفض: غير_موقع = (التعليمة >> 29) & 3;
        دع العالي: غير_موقع = (التعليمة >> 5) & 0x7FFFF;
        دع الفوري: عدد = فك_عدد_موقع_كوف(
            المنخفض | (العالي << 2),
            21
        );
        لو (النوع == 4) { أرجع اختيار.بعض(الفوري * 4096); };
        أرجع اختيار.بعض(الفوري);
    };
    // SECREL_LOW12A (9) and SECREL_HIGH12A (0xA) patch an ADD immediate like
    // PAGEOFFSET_12A; SECREL_LOW12L (0xB) a scaled load/store like
    // PAGEOFFSET_12L. The existing immediate is the addend (LLD applyArm64Imm).
    لو (النوع == 6 || النوع == 9 || النوع == 0xA) {
        دع الفوري: غير_موقع = (التعليمة >> 10) & 0xFFF;
        لو (((التعليمة >> 22) & 1) != 0) {
            أرجع اختيار.بعض((الفوري * 4096) مثل عدد);
        };
        أرجع اختيار.بعض(الفوري مثل عدد);
    };
    لو (النوع == 7 || النوع == 0xB) {
        دع الفوري: غير_موقع = (التعليمة >> 10) & 0xFFF;
        دع أس_المقياس: غير_موقع = (التعليمة >> 30) & 3;
        أرجع اختيار.بعض((الفوري * (1 << أس_المقياس)) مثل عدد);
    };
    لو (النوع == 0xF) {
        دع الفوري: غير_موقع = (التعليمة >> 5) & 0x7FFFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 19) * 4);
    };
    لو (النوع == 0x10) {
        دع الفوري: غير_موقع = (التعليمة >> 5) & 0x3FFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 14) * 4);
    };
    أرجع اختيار.لا_شيء();
}

عرف إضافة_إزاحة_كوف(
    القسم: &قسم_ربط,
    الموضع: غير_موقع,
    النوع: غير_موقع,
    المعمارية: هوية_معمارية
): اختيار عدد {
    طابق (*القسم).المحتوى مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(0); }
    | اختيار.بعض(المحتوى) -> {
        لو (الموضع >= (الطول(المحتوى) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        طابق المعمارية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            لو (النوع == 1) {
                طابق اقرأ_غ64_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة مثل عدد); };
            };
            // REL32 through REL32_5 (4..9) hold a signed displacement: LLVM
            // folds the bytes after the field into it (-1 for an 8-bit
            // immediate operand). ADDR32, ADDR32NB and SECREL (2, 3, 0xB)
            // hold an unsigned offset that the linker adds to (LLD add32).
            // Previously REL32 addends were read unsigned, so -1 became
            // 0xFFFFFFFF and the displacement was rejected as out of range,
            // and SECREL ignored its stored offset.
            لو (النوع >= 4 && النوع <= 9) {
                أرجع اقرأ_ص32_كوف(&المحتوى, الموضع);
            };
            لو (النوع == 2 || النوع == 3 || النوع == 0xB) {
                طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة مثل عدد); };
            };
        }
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            لو (النوع == 1 || النوع == 2 || النوع == 8) {
                طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> {
                    أرجع اختيار.بعض(القيمة مثل عدد);
                };
            };
            لو (النوع == 0x11) {
                أرجع اقرأ_ص32_كوف(&المحتوى, الموضع);
            };
            // ADDR64 (0xE) holds a 64-bit addend in place, as on x86-64.
            لو (النوع == 0xE) {
                طابق اقرأ_غ64_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة مثل عدد); };
            };
            دع التعليمة: غير_موقع;
            طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { التعليمة := القيمة; };
            طابق إضافة_تعليمة_كوف_ذراع64(التعليمة, النوع) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); };
        }
        | _ -> { };
        أرجع اختيار.بعض(0);
    };
}

// COMDAT facts of one input section (PE/COFF "COMDAT Sections (Object
// Only)"): a section flagged IMAGE_SCN_LNK_COMDAT (0x1000) is described by its
// section-definition symbol (storage class STATIC, value 0) whose auxiliary
// record carries the associated section Number (offset 12) and the Selection
// (offset 14); the next EXTERNAL symbol of that section is the COMDAT symbol.
نوع كومدات_قسم_كوف = {
    كومدات: منطقي,
    الاختيار: غير_موقع,
    المرتبط: غير_موقع,
    // The COMDAT symbol's name; empty until found.
    القائد: متجه غ8,
    مهمل: منطقي,
    يستبدل_الأكبر: منطقي
};

عرف خصائص_رأس_قسم_كوف(
    البايتات: &متجه غ8,
    فهرس_القسم: غير_موقع
): غير_موقع {
    طابق اقرأ_غ32_كوف(البايتات, 20 + فهرس_القسم * 40 + 36) مع
    | اختيار.لا_شيء -> { أرجع 0; }
    | اختيار.بعض(القيمة) -> { أرجع القيمة; };
}

عرف حجم_رأس_قسم_كوف(
    البايتات: &متجه غ8,
    فهرس_القسم: غير_موقع
): غير_موقع {
    طابق اقرأ_غ32_كوف(البايتات, 20 + فهرس_القسم * 40 + 16) مع
    | اختيار.لا_شيء -> { أرجع 0; }
    | اختيار.بعض(القيمة) -> { أرجع القيمة; };
}

// Byte equality of an earlier ingested section with this object's section
// (IMAGE_COMDAT_SELECT_EXACT_MATCH).
عرف محتوى_قسم_كوف_مطابق(
    القسم_السابق: &قسم_ربط,
    البايتات: &متجه غ8,
    فهرس_القسم: غير_موقع
): منطقي {
    دع الحجم: غير_موقع = حجم_رأس_قسم_كوف(البايتات, فهرس_القسم);
    لو ((*القسم_السابق).الحجم != الحجم) { أرجع خطأ; };
    دع الخصائص: غير_موقع = خصائص_رأس_قسم_كوف(البايتات, فهرس_القسم);
    دع الموضع: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, 20 + فهرس_القسم * 40 + 20) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الموضع := القيمة; };
    طابق (*القسم_السابق).المحتوى مع
    | اختيار.لا_شيء -> {
        أرجع (الخصائص & 0x00000080) != 0 || الحجم == 0;
    }
    | اختيار.بعض(المحتوى) -> {
        لو ((الخصائص & 0x00000080) != 0) { أرجع خطأ; };
        لو (!ضمن_حدود_كوف(البايتات, الموضع, الحجم)) { أرجع خطأ; };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الحجم) {
            لو (المحتوى[ف] != (*البايتات)[الموضع + ف]) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

// The COMDAT selection of an ingested section, read from its object's
// section-definition auxiliary record (the static symbol for the section with
// value 0). None when the section is not COMDAT or its object is not a plan
// input any more.
عرف اختيار_كومدات_قسم_ربط_كوف(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): اختيار غير_موقع {
    لو (القسم.القيمة >= (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع المدخل: معرف_مدخل_ربط = (*السياق).الأقسام[القسم.القيمة].المدخل;
    دع رقم_القسم: غير_موقع = (*السياق).الأقسام[القسم.القيمة].فهرس_قسم_الصيغة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)) {
        لو ((*السياق).الخطة.المدخلات[ف].المعرف.القيمة == المدخل.القيمة) {
            أرجع اختيار_كومدات_قسم_كائن_كوف(
                &(*السياق).الخطة.المدخلات[ف].البايتات,
                رقم_القسم
            );
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اختيار_كومدات_قسم_كائن_كوف(
    البايتات: &متجه غ8,
    رقم_القسم: غير_موقع
): اختيار غير_موقع {
    دع عدد_الأقسام: غير_موقع;
    دع موضع_الجدول: غير_موقع;
    دع عدد_الرموز: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 2) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { عدد_الأقسام := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 8) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { موضع_الجدول := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 12) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { عدد_الرموز := القيمة; };
    لو (رقم_القسم < 1 || رقم_القسم > عدد_الأقسام
        || !ضمن_حدود_كوف(البايتات, 20, عدد_الأقسام * 40)) {
        أرجع اختيار.لا_شيء();
    };
    لو ((خصائص_رأس_قسم_كوف(البايتات, رقم_القسم - 1) & 0x00001000) == 0) {
        أرجع اختيار.لا_شيء();
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الرموز) {
        دع الموضع: غير_موقع = موضع_الجدول + ف * 18;
        لو (!ضمن_حدود_كوف(البايتات, الموضع, 18)) { أرجع اختيار.لا_شيء(); };
        دع المساعدات: غير_موقع = (*البايتات)[الموضع + 17] مثل غير_موقع;
        دع الرقم: متغير عدد = 0;
        طابق اقرأ_ص16_كوف(البايتات, الموضع + 12) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الرقم := القيمة; };
        دع القيمة_الرمز: متغير غير_موقع = 1;
        طابق اقرأ_غ32_كوف(البايتات, الموضع + 8) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(القيمة) -> { القيمة_الرمز := القيمة; };
        لو ((*البايتات)[الموضع + 16] == 3 && المساعدات >= 1 && القيمة_الرمز == 0
            && الرقم >= 1 && (الرقم مثل غير_موقع) == رقم_القسم
            && ضمن_حدود_كوف(البايتات, الموضع + 18, 18)) {
            أرجع اختيار.بعض((*البايتات)[الموضع + 18 + 14] مثل غير_موقع);
        };
        ف := ف + المساعدات + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Reads every section's COMDAT facts and decides which copies this object
// keeps, as LLD does (SymbolTable::addComdat / handleComdatSelection):
// NODUPLICATES (1) keeps the copy, so a second definition is a duplicate
// symbol; ANY (2) keeps the first; SAME_SIZE (3) and EXACT_MATCH (4) keep the
// first when the size (and bytes) agree and otherwise report the duplicate;
// LARGEST (6) keeps the larger copy; ASSOCIATIVE (5) follows the section it is
// associated with. The canonical symbol table holds the earlier copy: the
// COMDAT symbol is already defined. NEWEST (7) has no specified meaning and is
// handled like ANY. The earlier copy's selection must agree, with LLD's two
// accepted mixes (ANY with LARGEST is LARGEST, as cl.exe emits vftables with
// either; ANY with EXACT_MATCH is ANY, as link.exe accepts); a disagreeing
// selection, or a leader defined outside any COMDAT section, keeps this copy
// so the duplicate definition is reported. Previously the leader's selection
// was not consulted and such copies were discarded silently.
عرف حقائق_كومدات_كائن_كوف(
    السياق: &سياق_ربط,
    البايتات: &متجه غ8,
    عدد_الأقسام: غير_موقع,
    موضع_جدول_الرموز: غير_موقع,
    عدد_الرموز: غير_موقع,
    موضع_جدول_النصوص: غير_موقع,
    حجم_جدول_النصوص: غير_موقع
): اختيار متجه كومدات_قسم_كوف {
    دع الحقائق: متغير متجه كومدات_قسم_كوف = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع قائد_فارغ: متجه غ8 = [];
        دع حقيقة_فارغة: كومدات_قسم_كوف = {
            كومدات: (خصائص_رأس_قسم_كوف(البايتات, فهرس_القسم) & 0x00001000) != 0,
            الاختيار: 0,
            المرتبط: 0,
            القائد: قائد_فارغ,
            مهمل: خطأ,
            يستبدل_الأكبر: خطأ
        };
        ألحق(الحقائق, حقيقة_فارغة);
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: غير_موقع = موضع_جدول_الرموز + فهرس_الرمز * 18;
        لو (!ضمن_حدود_كوف(البايتات, موضع_الرمز, 18)) { أرجع اختيار.لا_شيء(); };
        دع القيمة: غير_موقع;
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 8) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المقروء) -> { القيمة := المقروء; };
        دع رقم_القسم: عدد;
        طابق اقرأ_ص16_كوف(البايتات, موضع_الرمز + 12) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(المقروء) -> { رقم_القسم := المقروء; };
        دع فئة_التخزين: غير_موقع = (*البايتات)[موضع_الرمز + 16] مثل غير_موقع;
        دع عدد_المساعدات: غير_موقع = (*البايتات)[موضع_الرمز + 17] مثل غير_موقع;
        لو (رقم_القسم >= 1 && (رقم_القسم مثل غير_موقع) <= عدد_الأقسام) {
            دع الفهرس: غير_موقع = (رقم_القسم مثل غير_موقع) - 1;
            لو (الحقائق[الفهرس].كومدات) {
                لو (فئة_التخزين == 3 && القيمة == 0 && عدد_المساعدات >= 1
                    && الحقائق[الفهرس].الاختيار == 0) {
                    دع موضع_المساعد: غير_موقع = موضع_الرمز + 18;
                    لو (!ضمن_حدود_كوف(البايتات, موضع_المساعد, 18)) {
                        أرجع اختيار.لا_شيء();
                    };
                    طابق اقرأ_غ16_كوف(البايتات, موضع_المساعد + 12) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                    | اختيار.بعض(الرقم) -> { الحقائق[الفهرس].المرتبط := الرقم; };
                    الحقائق[الفهرس].الاختيار :=
                        (*البايتات)[موضع_المساعد + 14] مثل غير_موقع;
                } وإلا لو (فئة_التخزين == 2 && الحقائق[الفهرس].الاختيار != 0
                    && الحقائق[الفهرس].الاختيار != 5) {
                    لو ((الطول(الحقائق[الفهرس].القائد) مثل غير_موقع) == 0) {
                        طابق اسم_رمز_كوف(
                            البايتات, موضع_الرمز, موضع_جدول_النصوص, حجم_جدول_النصوص
                        ) مع
                        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                        | اختيار.بعض(الاسم) -> {
                            الحقائق[الفهرس].القائد := الاسم;
                        };
                    };
                };
            };
        };
        فهرس_الرمز := فهرس_الرمز + عدد_المساعدات + 1;
    }

    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع الاختيار: غير_موقع = الحقائق[فهرس_القسم].الاختيار;
        لو (الحقائق[فهرس_القسم].كومدات && الاختيار != 0 && الاختيار != 5
            && الاختيار != 1) {
            لو ((الطول(الحقائق[فهرس_القسم].القائد) مثل غير_موقع) > 0) {
                دع نتيجة_البحث: اختيار رمز_ربط = ابحث_رمز_ربط_بالاسم(
                    &(*السياق).الرموز, &الحقائق[فهرس_القسم].القائد
                );
                طابق نتيجة_البحث مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الرمز) -> {
                    طابق الرمز.الحالة مع
                    | حالة_رمز_ربط.معرف(التعريف) -> {
                        // The leader's own selection, from its object.
                        دع معرف_السابق: متغير اختيار معرف_قسم_ربط = اختيار.لا_شيء();
                        طابق التعريف.الموضع مع
                        | موضع_تعريف_رمز_ربط.قسم(المعرف, _) -> {
                            معرف_السابق := اختيار.بعض(المعرف);
                        }
                        | _ -> { };
                        دع اختيار_السابق: متغير اختيار غير_موقع = اختيار.لا_شيء();
                        طابق معرف_السابق مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(المعرف) -> {
                            اختيار_السابق := اختيار_كومدات_قسم_ربط_كوف(السياق, المعرف);
                        };
                        دع الفعلي: متغير غير_موقع = الاختيار;
                        لو (الفعلي == 7) { الفعلي := 2; };
                        دع متوافق: متغير منطقي = خطأ;
                        طابق اختيار_السابق مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(القيمة) -> {
                            دع السابق_الفعلي: متغير غير_موقع = القيمة;
                            لو (السابق_الفعلي == 7) { السابق_الفعلي := 2; };
                            لو (السابق_الفعلي == الفعلي) {
                                متوافق := صواب;
                            } وإلا لو ((السابق_الفعلي == 2 && الفعلي == 6)
                                || (السابق_الفعلي == 6 && الفعلي == 2)) {
                                الفعلي := 6;
                                متوافق := صواب;
                            } وإلا لو ((السابق_الفعلي == 2 && الفعلي == 4)
                                || (السابق_الفعلي == 4 && الفعلي == 2)) {
                                الفعلي := 2;
                                متوافق := صواب;
                            };
                        };
                        // An incompatible leader (another selection, or a
                        // definition outside any COMDAT section) keeps this
                        // copy, so the duplicate definition is reported.
                        لو (متوافق) {
                            لو (الفعلي == 2) {
                                الحقائق[فهرس_القسم].مهمل := صواب;
                            } وإلا {
                                دع القسم_السابق: متغير اختيار قسم_ربط = اختيار.لا_شيء();
                                طابق معرف_السابق مع
                                | اختيار.لا_شيء -> { }
                                | اختيار.بعض(المعرف) -> {
                                    القسم_السابق := ابحث_قسم_ربط_بالمعرف(السياق, المعرف);
                                };
                                طابق القسم_السابق مع
                                | اختيار.لا_شيء -> { }
                                | اختيار.بعض(السابق) -> {
                                    دع الحجم: غير_موقع = حجم_رأس_قسم_كوف(البايتات, فهرس_القسم);
                                    لو (الفعلي == 3) {
                                        لو (السابق.الحجم == الحجم) {
                                            الحقائق[فهرس_القسم].مهمل := صواب;
                                        };
                                    } وإلا لو (الفعلي == 4) {
                                        لو (محتوى_قسم_كوف_مطابق(&السابق, البايتات, فهرس_القسم)) {
                                            الحقائق[فهرس_القسم].مهمل := صواب;
                                        };
                                    } وإلا لو (الفعلي == 6) {
                                        لو (السابق.الحجم >= الحجم) {
                                            الحقائق[فهرس_القسم].مهمل := صواب;
                                        } وإلا {
                                            الحقائق[فهرس_القسم].يستبدل_الأكبر := صواب;
                                        };
                                    };
                                };
                            };
                        };
                    }
                    | _ -> { };
                };
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    // Associative sections follow the (transitively) associated section.
    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        لو (الحقائق[فهرس_القسم].كومدات && الحقائق[فهرس_القسم].الاختيار == 5) {
            دع الحالي: متغير غير_موقع = فهرس_القسم;
            دع الخطوات: متغير غير_موقع = 0;
            دع مستمر: متغير منطقي = صواب;
            بينما (مستمر) {
                دع الرقم: غير_موقع = الحقائق[الحالي].المرتبط;
                لو (الرقم < 1 || الرقم > عدد_الأقسام || الخطوات > عدد_الأقسام) {
                    أرجع اختيار.لا_شيء();
                };
                الحالي := الرقم - 1;
                الخطوات := الخطوات + 1;
                لو (!(الحقائق[الحالي].كومدات && الحقائق[الحالي].الاختيار == 5)) {
                    مستمر := خطأ;
                };
            }
            الحقائق[فهرس_القسم].مهمل := الحقائق[الحالي].مهمل;
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع اختيار.بعض(الحقائق);
}

// A COFF common symbol (section number 0, value = size, storage class
// EXTERNAL) becomes a weak definition in its own zero-filled `.bss` section,
// aligned to min(32, next power of two of the size) as LLD's CommonChunk; a
// regular definition replaces it and the larger of two commons wins. The
// section's format index is 0, which no real COFF section has.
عام عرف قسم_رمز_مشترك_كوف(
    السياق: &سياق_ربط,
    القسم: معرف_قسم_ربط
): اختيار غير_موقع {
    لو (القسم.القيمة >= (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    لو ((*السياق).الأقسام[القسم.القيمة].المعرف.القيمة != القسم.القيمة
        || (*السياق).الأقسام[القسم.القيمة].فهرس_قسم_الصيغة != 0) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*السياق).الأقسام[القسم.القيمة].الحجم);
}

عرف سجل_رمزا_مشتركا_كوف(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه غ8,
    المدخل: معرف_مدخل_ربط,
    الحجم: غير_موقع
): نتيجة_تسجيل_رمز_ربط {
    دع معرف_موجود: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            دع حجم_مشترك_سابق: متغير اختيار غير_موقع = اختيار.لا_شيء();
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                حجم_مشترك_سابق := قسم_رمز_مشترك_كوف(السياق, القسم);
            }
            | _ -> { };
            طابق حجم_مشترك_سابق مع
            | اختيار.لا_شيء -> { أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف); }
            | اختيار.بعض(الحجم_السابق) -> {
                لو (الحجم_السابق >= الحجم) {
                    أرجع نتيجة_تسجيل_رمز_ربط.نجح(الرمز.المعرف);
                };
                معرف_موجود := اختيار.بعض(الرمز.المعرف);
            };
        }
        | _ -> { };
    };
    دع المحاذاة: متغير غير_موقع = 1;
    بينما (المحاذاة < الحجم && المحاذاة < 32) {
        المحاذاة := المحاذاة * 2;
    }
    دع اسم_القسم: متجه غ8 = [0x2E, 0x62, 0x73, 0x73];
    دع هوية_القسم: هوية_اسم_قسم_ربط = {
        اسم_القسم: اسم_القسم,
        اسم_الحاوية: اختيار.لا_شيء()
    };
    دع القسم: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
        السياق,
        المدخل,
        0,
        هوية_القسم,
        حقائق_صيغة_قسم_ربط.كوف(0xC0000080),
        صنف_قسم_ربط.بيانات_صفرية(),
        المحاذاة,
        الحجم,
        اختيار.لا_شيء()
    );
    طابق معرف_موجود مع
    | اختيار.بعض(المعرف) -> {
        دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
            المدخل,
            قوة_تعريف_رمز_ربط.ضعيف(),
            موضع_تعريف_رمز_ربط.قسم(القسم, 0),
            الحجم
        );
        (*السياق).الرموز.الرموز[المعرف.القيمة].الحالة :=
            حالة_رمز_ربط.معرف(التعريف);
        أرجع نتيجة_تسجيل_رمز_ربط.نجح(المعرف);
    }
    | اختيار.لا_شيء -> { };
    أرجع سجل_تعريف_قسم_رمز_في_سياق_الربط(
        السياق,
        الاسم,
        المدخل,
        قوة_تعريف_رمز_ربط.ضعيف(),
        القسم,
        0,
        الحجم
    );
}

// Sections that never reach the image: LNK_REMOVE (0x800), LNK_INFO (0x200),
// MEM_DISCARDABLE (0x02000000, DWARF .debug_*) and CodeView `.debug$*`.
عرف قسم_كوف_مصدر_خارج_الصورة(الخصائص: غير_موقع, الاسم: &متجه غ8): منطقي {
    لو ((الخصائص & 0x00000800) != 0 || (الخصائص & 0x00000200) != 0
        || (الخصائص & 0x02000000) != 0) {
        أرجع صواب;
    };
    دع البادئة: متجه غ8 = [0x2E, 0x64, 0x65, 0x62, 0x75, 0x67, 0x24];
    لو ((الطول(*الاسم) مثل غير_موقع) < (الطول(البادئة) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(البادئة) مثل غير_موقع)) {
        لو ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// MSVC/LLD liveness: only COMDAT sections are subject to dead-stripping; every
// other section of a loaded object is kept (LLD markLive roots non-COMDAT
// chunks), so initializer tables such as .CRT$XCU/.CRT$XIC entries, .tls and
// .pdata survive although no code references them. Sections removed at link
// time (LNK_REMOVE 0x800, LNK_INFO 0x200 such as .drectve) and discardable
// debug sections are not roots.
عرف قسم_كوف_جذر_دائم(الخصائص: غير_موقع): منطقي {
    لو ((الخصائص & 0x00001000) != 0) { أرجع خطأ; };
    لو ((الخصائص & 0x00000800) != 0 || (الخصائص & 0x00000200) != 0) {
        أرجع خطأ;
    };
    لو ((الخصائص & 0x02000000) != 0) { أرجع خطأ; };
    أرجع صواب;
}

عرف اسما_كوف_متساويان(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    لو ((الطول(*أ) مثل غير_موقع) != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Weak externals (storage class WEAK_EXTERNAL 105, section 0, aux format 3)
// of one object: الاسم resolves to الافتراضي (the TagIndex symbol) when the
// link ends with الاسم still unresolved. The object's own ingestion registers
// الاسم as an ordinary undefined reference (SEARCH_LIBRARY) or as one that
// never extracts an archive member (NOLIBRARY, ALIAS; link/context.sn
// سجل_مرجعا_ضعيفا_في_سياق_الربط); applying the alias is the COFF input
// completion's job (coff/directives.sn), after every input and archive
// member is loaded, as LLD resolves weak aliases in
// SymbolTable::resolveRemainingUndefines. That is also where a default that
// is itself undefined is followed further (another weak external or an
// /ALTERNATENAME) or extracted from an archive. A default that is a local
// symbol of the object has no global name to follow and is not recorded, so
// its weak external stays unresolved and is reported. Previously the alias
// was applied at the end of the object's own ingestion and only when the
// default was already defined, so a default defined by a later object, an
// archive member or another weak external left the symbol unresolved.
عام نوع زوج_خارجي_ضعيف_كوف = {
    الاسم: متجه غ8,
    الافتراضي: متجه غ8
};

عام عرف أزواج_خارجية_ضعيفة_كوف(البايتات: &متجه غ8): متجه زوج_خارجي_ضعيف_كوف {
    دع الأزواج: متغير متجه زوج_خارجي_ضعيف_كوف = [];
    دع موضع_الجدول: غير_موقع;
    دع عدد_الرموز: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 2) مع
    | اختيار.لا_شيء -> { أرجع الأزواج; }
    | اختيار.بعض(القيمة) -> {
        // Short import objects start with Sig1 0 and Sig2 0xFFFF.
        لو (القيمة == 0xFFFF) { أرجع الأزواج; };
    };
    طابق اقرأ_غ32_كوف(البايتات, 8) مع
    | اختيار.لا_شيء -> { أرجع الأزواج; }
    | اختيار.بعض(القيمة) -> { موضع_الجدول := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 12) مع
    | اختيار.لا_شيء -> { أرجع الأزواج; }
    | اختيار.بعض(القيمة) -> { عدد_الرموز := القيمة; };
    دع موضع_النصوص: غير_موقع = موضع_الجدول + عدد_الرموز * 18;
    دع حجم_النصوص: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_النصوص) مع
    | اختيار.لا_شيء -> { أرجع الأزواج; }
    | اختيار.بعض(القيمة) -> { حجم_النصوص := القيمة; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الرموز) {
        دع الموضع: غير_موقع = موضع_الجدول + ف * 18;
        لو (!ضمن_حدود_كوف(البايتات, الموضع, 18)) { أرجع الأزواج; };
        دع الفئة: غير_موقع = (*البايتات)[الموضع + 16] مثل غير_موقع;
        دع المساعدات: غير_موقع = (*البايتات)[الموضع + 17] مثل غير_موقع;
        دع رقم_القسم: متغير عدد = 0;
        طابق اقرأ_ص16_كوف(البايتات, الموضع + 12) مع
        | اختيار.لا_شيء -> { أرجع الأزواج; }
        | اختيار.بعض(القيمة) -> { رقم_القسم := القيمة; };
        لو (الفئة == 105 && رقم_القسم == 0 && المساعدات >= 1) {
            دع الافتراضي_فهرس: متغير غير_موقع = 0xFFFFFFFF;
            طابق اقرأ_غ32_كوف(البايتات, الموضع + 18) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(القيمة) -> { الافتراضي_فهرس := القيمة; };
            لو (الافتراضي_فهرس < عدد_الرموز) {
                دع موضع_الافتراضي: غير_موقع = موضع_الجدول + الافتراضي_فهرس * 18;
                دع فئة_الافتراضي: متغير غير_موقع = 0;
                لو (ضمن_حدود_كوف(البايتات, موضع_الافتراضي, 18)) {
                    فئة_الافتراضي := (*البايتات)[موضع_الافتراضي + 16] مثل غير_موقع;
                };
                لو (فئة_الافتراضي == 2 || فئة_الافتراضي == 105) {
                    طابق اسم_رمز_كوف(البايتات, الموضع, موضع_النصوص, حجم_النصوص) مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(الاسم) -> {
                        طابق اسم_رمز_كوف(
                            البايتات,
                            موضع_الافتراضي,
                            موضع_النصوص,
                            حجم_النصوص
                        ) مع
                        | اختيار.لا_شيء -> { }
                        | اختيار.بعض(الافتراضي) -> {
                            لو ((الطول(الاسم) مثل غير_موقع) > 0
                                && (الطول(الافتراضي) مثل غير_موقع) > 0) {
                                دع الزوج: زوج_خارجي_ضعيف_كوف = {
                                    الاسم: الاسم,
                                    الافتراضي: الافتراضي
                                };
                                ألحق(الأزواج, الزوج);
                            };
                        };
                    };
                };
            };
        };
        ف := ف + المساعدات + 1;
    }
    أرجع الأزواج;
}

عام عرف استوعب_كائن_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_كوف {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!ضمن_حدود_كوف(البايتات, 0, 20)) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع الآلة_المطلوبة: غير_موقع;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { الآلة_المطلوبة := القيمة; };
    دع الآلة: غير_موقع;
    دع عدد_الأقسام: غير_موقع;
    دع موضع_جدول_الرموز: غير_موقع;
    دع عدد_الرموز: غير_موقع;
    دع حجم_الرأس_الاختياري: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    طابق اقرأ_غ16_كوف(البايتات, 2) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { عدد_الأقسام := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 8) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { موضع_جدول_الرموز := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 12) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { عدد_الرموز := القيمة; };
    طابق اقرأ_غ16_كوف(البايتات, 16) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { حجم_الرأس_الاختياري := القيمة; };
    لو (الآلة != الآلة_المطلوبة || حجم_الرأس_الاختياري != 0) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع موضع_الأقسام: غير_موقع = 20;
    لو (!ضمن_حدود_كوف(البايتات, موضع_الأقسام, عدد_الأقسام * 40)) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع موضع_جدول_النصوص: غير_موقع = موضع_جدول_الرموز + عدد_الرموز * 18;
    دع حجم_جدول_النصوص: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_جدول_النصوص) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { حجم_جدول_النصوص := القيمة; };
    لو (حجم_جدول_النصوص < 4
        || !ضمن_حدود_كوف(
            البايتات,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        )) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };

    دع حقائق_كومدات: متجه كومدات_قسم_كوف;
    طابق حقائق_كومدات_كائن_كوف(
        السياق,
        البايتات,
        عدد_الأقسام,
        موضع_جدول_الرموز,
        عدد_الرموز,
        موضع_جدول_النصوص,
        حجم_جدول_النصوص
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { حقائق_كومدات := القيمة; };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_كوف_مدخل = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع موضع_الرأس: غير_موقع = موضع_الأقسام + فهرس_القسم * 40;
        دع الاسم: متجه غ8;
        طابق اسم_قسم_كوف(
            البايتات,
            موضع_الرأس,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
        دع حجم_المحتوى: غير_موقع;
        دع موضع_المحتوى: غير_موقع;
        دع موضع_الإزاحات: غير_موقع;
        دع عدد_الإزاحات: غير_موقع;
        دع الخصائص: غير_موقع;
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 16) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { حجم_المحتوى := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 20) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { موضع_المحتوى := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 24) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { موضع_الإزاحات := القيمة; };
        طابق اقرأ_غ16_كوف(البايتات, موضع_الرأس + 32) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { عدد_الإزاحات := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 36) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الخصائص := القيمة; };
        دع المحتوى: اختيار متجه غ8;
        لو ((الخصائص & 0x00000080) != 0 || حجم_المحتوى == 0) {
            المحتوى := اختيار.لا_شيء();
        } وإلا {
            طابق انسخ_بايتات_كوف(البايتات, موضع_المحتوى, حجم_المحتوى) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
            | اختيار.بعض(القيمة) -> { المحتوى := اختيار.بعض(القيمة); };
        };
        لو (عدد_الإزاحات > 0
            && !ضمن_حدود_كوف(البايتات, موضع_الإزاحات, عدد_الإزاحات * 10)) {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
            );
        };
        دع اسم_الحقيقة: متجه غ8 = انسخ_بايتات_اسم_كوف_للربط(&الاسم);
        دع اسم_الحاوية: اختيار متجه غ8 = اختيار.لا_شيء();
        دع هوية_الاسم: هوية_اسم_قسم_ربط = {
            اسم_القسم: الاسم,
            اسم_الحاوية: اسم_الحاوية
        };
        دع معرف_الربط: متغير اختيار معرف_قسم_ربط = اختيار.لا_شيء();
        لو (!حقائق_كومدات[فهرس_القسم].مهمل) {
            دع المعرف_الجديد: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
                السياق,
                (*المدخل).المعرف,
                فهرس_القسم + 1,
                هوية_الاسم,
                حقائق_صيغة_قسم_ربط.كوف(الخصائص),
                صنف_قسم_كوف(الخصائص),
                محاذاة_قسم_كوف(الخصائص),
                حجم_المحتوى,
                المحتوى
            );
            معرف_الربط := اختيار.بعض(المعرف_الجديد);
            لو (قسم_كوف_جذر_دائم(الخصائص)) {
                أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, المعرف_الجديد);
            };
        };
        دع الحقيقة: حقيقة_قسم_كوف_مدخل = {
            معرف_الربط: معرف_الربط,
            الاسم: اسم_الحقيقة,
            حجم_المحتوى: حجم_المحتوى,
            موضع_المحتوى: موضع_المحتوى,
            موضع_الإزاحات: موضع_الإزاحات,
            عدد_الإزاحات: عدد_الإزاحات,
            الخصائص: الخصائص
        };
        ألحق(حقائق_الأقسام, الحقيقة);
        فهرس_القسم := فهرس_القسم + 1;
    }

    // A kept associative COMDAT section (for example the .pdata/.xdata of a
    // COMDAT function) lives exactly when its associated section does. The
    // dependency is recorded as an ABSOLUTE relocation (type 0, applied as no
    // change by both PE relocation writers) from that section to it.
    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        لو (حقائق_كومدات[فهرس_القسم].كومدات
            && حقائق_كومدات[فهرس_القسم].الاختيار == 5
            && !حقائق_كومدات[فهرس_القسم].مهمل) {
            دع الرقم: غير_موقع = حقائق_كومدات[فهرس_القسم].المرتبط;
            طابق حقائق_الأقسام[الرقم - 1].معرف_الربط مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(معرف_الأصل) -> {
                طابق حقائق_الأقسام[فهرس_القسم].معرف_الربط مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(معرف_التابع) -> {
                    لو (حقائق_الأقسام[الرقم - 1].حجم_المحتوى > 0) {
                        دع حافة_الارتباط: حافة_إزاحة_ربط = {
                            القسم: معرف_الأصل,
                            الإزاحة: 0,
                            المرجع: مرجع_إزاحة_ربط.قسم(معرف_التابع),
                            إضافة: 0,
                            رمز_صيغة: 0
                        };
                        أضف_إزاحة_ربط_إلى_السياق(السياق, حافة_الارتباط);
                    } وإلا {
                        أضف_جذر_قسم_ربط(&متغير (*السياق).الوصول, معرف_التابع);
                    };
                };
            };
        };
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع حقائق_الرموز: متغير متجه حقيقة_رمز_كوف_مدخل = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: غير_موقع = موضع_جدول_الرموز + فهرس_الرمز * 18;
        لو (!ضمن_حدود_كوف(البايتات, موضع_الرمز, 18)) {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
            );
        };
        دع الاسم: متجه غ8;
        طابق اسم_رمز_كوف(
            البايتات,
            موضع_الرمز,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
        دع القيمة: غير_موقع;
        دع رقم_القسم: عدد;
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 8) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(المقروء) -> { القيمة := المقروء; };
        طابق اقرأ_ص16_كوف(البايتات, موضع_الرمز + 12) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(المقروء) -> { رقم_القسم := المقروء; };
        دع موضع_فئة_التخزين: غير_موقع = موضع_الرمز + 16;
        دع موضع_عدد_المساعدات: غير_موقع = موضع_الرمز + 17;
        دع فئة_التخزين: غير_موقع = (*البايتات)[موضع_فئة_التخزين] مثل غير_موقع;
        دع عدد_المساعدات: غير_موقع = (*البايتات)[موضع_عدد_المساعدات] مثل غير_موقع;
        دع محلي: منطقي = فئة_التخزين != 2 && فئة_التخزين != 105;
        دع معرف_الربط: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
        لو (!محلي && (الطول(الاسم) مثل غير_موقع) > 0) {
            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            دع بديل_ضعيف: متغير اختيار غير_موقع = اختيار.لا_شيء();
            لو (رقم_القسم == 0 && فئة_التخزين == 105 && عدد_المساعدات >= 1) {
                // Weak external (aux format 3): TagIndex names the default
                // definition (applied by coff/directives.sn).
                طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 18) مع
                | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
                | اختيار.بعض(الفهرس) -> { بديل_ضعيف := اختيار.بعض(الفهرس); };
            };
            لو (رقم_القسم == 0 && القيمة > 0 && فئة_التخزين == 2) {
                نتيجة_التسجيل := سجل_رمزا_مشتركا_كوف(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القيمة
                );
            } وإلا لو (رقم_القسم == 0) {
                // A weak external searches libraries only with
                // Characteristics 2 (SEARCH_LIBRARY); 1 (NOLIBRARY) and 3
                // (ALIAS) are references that never extract an archive
                // member (link/context.sn مراجع_رمز_ربط), resolved by the
                // alias at the end of loading (coff/directives.sn).
                دع يبحث_في_المكتبات: متغير منطقي = صواب;
                طابق بديل_ضعيف مع
                | اختيار.بعض(_) -> {
                    دع الخصيصة: غير_موقع;
                    طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 22) مع
                    | اختيار.لا_شيء -> { الخصيصة := 2; }
                    | اختيار.بعض(القيمة_المقروءة) -> { الخصيصة := القيمة_المقروءة; };
                    يبحث_في_المكتبات := الخصيصة == 2;
                }
                | اختيار.لا_شيء -> { };
                لو (يبحث_في_المكتبات) {
                    نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                        السياق,
                        &الاسم,
                        (*المدخل).المعرف
                    );
                } وإلا {
                    نتيجة_التسجيل := سجل_مرجعا_ضعيفا_في_سياق_الربط(
                        السياق,
                        &الاسم,
                        (*المدخل).المعرف
                    );
                };
            } وإلا لو (رقم_القسم == -1) {
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    قوة_تعريف_رمز_ربط.قوي(),
                    موضع_تعريف_رمز_ربط.مطلق(القيمة),
                    0
                );
            } وإلا {
                لو (رقم_القسم < 1
                    || (رقم_القسم مثل غير_موقع) > عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                        خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
                    );
                };
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو (فئة_التخزين == 105) { القوة := قوة_تعريف_رمز_ربط.ضعيف(); };
                دع فهرس_القسم: غير_موقع =
                    (رقم_القسم مثل غير_موقع) - 1;
                طابق حقائق_الأقسام[فهرس_القسم].معرف_الربط مع
                | اختيار.لا_شيء -> {
                    // Defined in a discarded COMDAT copy: the kept copy's
                    // definition is the one every reference binds to.
                    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
                    | اختيار.بعض(الموجود) -> {
                        نتيجة_التسجيل := نتيجة_تسجيل_رمز_ربط.نجح(الموجود.المعرف);
                    }
                    | اختيار.لا_شيء -> {
                        نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                            السياق,
                            &الاسم,
                            (*المدخل).المعرف
                        );
                    };
                }
                | اختيار.بعض(معرف_قسم_الرمز) -> {
                    دع يستبدل: متغير منطقي = خطأ;
                    لو (حقائق_كومدات[فهرس_القسم].يستبدل_الأكبر) {
                        يستبدل := اسما_كوف_متساويان(
                            &حقائق_كومدات[فهرس_القسم].القائد, &الاسم
                        );
                    };
                    دع معرف_سابق: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
                    لو (يستبدل) {
                        طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
                        | اختيار.بعض(الموجود) -> { معرف_سابق := اختيار.بعض(الموجود.المعرف); }
                        | اختيار.لا_شيء -> { };
                    };
                    طابق معرف_سابق مع
                    | اختيار.بعض(المعرف_السابق) -> {
                        // IMAGE_COMDAT_SELECT_LARGEST: this larger copy
                        // replaces the earlier definition.
                        دع التعريف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
                            (*المدخل).المعرف,
                            القوة,
                            موضع_تعريف_رمز_ربط.قسم(معرف_قسم_الرمز, القيمة),
                            0
                        );
                        (*السياق).الرموز.الرموز[المعرف_السابق.القيمة].الحالة :=
                            حالة_رمز_ربط.معرف(التعريف);
                        نتيجة_التسجيل := نتيجة_تسجيل_رمز_ربط.نجح(المعرف_السابق);
                    }
                    | اختيار.لا_شيء -> {
                        نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                            السياق,
                            &الاسم,
                            (*المدخل).المعرف,
                            القوة,
                            معرف_قسم_الرمز,
                            القيمة,
                            0
                        );
                    };
                };
            };
            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(المعرف, _, _) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | _ -> { أرجع حول_نتيجة_تسجيل_رمز_كوف(نتيجة_التسجيل); };
        };
        دع الحقيقة: حقيقة_رمز_كوف_مدخل = {
            معرف_الربط: معرف_الربط,
            رقم_القسم: رقم_القسم,
            القيمة: القيمة,
            محلي: محلي,
            صالح: صواب
        };
        ألحق(حقائق_الرموز, الحقيقة);
        دع فهرس_المساعد: متغير غير_موقع = 0;
        بينما (فهرس_المساعد < عدد_المساعدات) {
            دع غير_صالح: حقيقة_رمز_كوف_مدخل = {
                معرف_الربط: اختيار.لا_شيء(),
                رقم_القسم: 0,
                القيمة: 0,
                محلي: صواب,
                صالح: خطأ
            };
            ألحق(حقائق_الرموز, غير_صالح);
            فهرس_المساعد := فهرس_المساعد + 1;
        }
        فهرس_الرمز := فهرس_الرمز + عدد_المساعدات + 1;
    }

    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع حقيقة_القسم: &حقيقة_قسم_كوف_مدخل = &حقائق_الأقسام[فهرس_القسم];
        دع فهرس_الإزاحة: متغير غير_موقع = 0;
        دع معرف_قسم_المصدر: معرف_قسم_ربط;
        طابق (*حقيقة_القسم).معرف_الربط مع
        | اختيار.لا_شيء -> {
            // Relocations of a discarded COMDAT copy are not ingested.
            فهرس_الإزاحة := (*حقيقة_القسم).عدد_الإزاحات;
            معرف_قسم_المصدر := معرف_قسم_ربط_من(0);
        }
        | اختيار.بعض(المعرف) -> { معرف_قسم_المصدر := المعرف; };
        بينما (فهرس_الإزاحة < (*حقيقة_القسم).عدد_الإزاحات) {
            دع موضع_الإزاحة: غير_موقع =
                (*حقيقة_القسم).موضع_الإزاحات + فهرس_الإزاحة * 10;
            دع الإزاحة: غير_موقع;
            دع فهرس_مرجع_الرمز: غير_موقع;
            دع نوع_الإزاحة: غير_موقع;
            طابق اقرأ_غ32_كوف(البايتات, موضع_الإزاحة) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
            طابق اقرأ_غ32_كوف(البايتات, موضع_الإزاحة + 4) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { فهرس_مرجع_الرمز := القيمة; };
            طابق اقرأ_غ16_كوف(البايتات, موضع_الإزاحة + 8) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { نوع_الإزاحة := القيمة; };
            لو (فهرس_مرجع_الرمز >= (الطول(حقائق_الرموز) مثل غير_موقع)
                || !حقائق_الرموز[فهرس_مرجع_الرمز].صالح) {
                أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                    خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                );
            };
            دع حقيقة_الرمز: حقيقة_رمز_كوف_مدخل =
                حقائق_الرموز[فهرس_مرجع_الرمز];
            دع المرجع: مرجع_إزاحة_ربط;
            دع الإضافة: متغير عدد;
            دع مرجع_مهمل: متغير منطقي = خطأ;
            دع فهرس_قسم_الربط: غير_موقع = معرف_قسم_المصدر.القيمة;
            طابق إضافة_إزاحة_كوف(
                &(*السياق).الأقسام[فهرس_قسم_الربط],
                الإزاحة,
                نوع_الإزاحة,
                (*السياق).الهدف.المعمارية.الهوية
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                    خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                );
            }
            | اختيار.بعض(القيمة) -> { الإضافة := القيمة; };
            طابق حقيقة_الرمز.معرف_الربط مع
            | اختيار.بعض(المعرف) -> {
                المرجع := مرجع_إزاحة_ربط.رمز(المعرف);
            }
            | اختيار.لا_شيء -> {
                لو (!حقيقة_الرمز.محلي
                    || حقيقة_الرمز.رقم_القسم < 1
                    || (حقيقة_الرمز.رقم_القسم مثل غير_موقع) > عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                        خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                    );
                };
                دع فهرس_قسم_الرمز_المحلي: غير_موقع =
                    (حقيقة_الرمز.رقم_القسم مثل غير_موقع) - 1;
                طابق حقائق_الأقسام[فهرس_قسم_الرمز_المحلي].معرف_الربط مع
                | اختيار.لا_شيء -> {
                    // A kept image section must not refer into a discarded
                    // copy (LLD's "relocation against symbol in discarded
                    // section"). Debug and link-time-only sections are not
                    // written to the image and LLD exempts them
                    // (maybeReportRelocationToDiscarded): such a dead
                    // reference is dropped.
                    لو (!قسم_كوف_مصدر_خارج_الصورة(
                        (*حقيقة_القسم).الخصائص,
                        &(*حقيقة_القسم).الاسم
                    )) {
                        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                            خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                        );
                    };
                    مرجع_مهمل := صواب;
                    المرجع := مرجع_إزاحة_ربط.قسم(معرف_قسم_المصدر);
                }
                | اختيار.بعض(معرف_القسم_المحلي) -> {
                    المرجع := مرجع_إزاحة_ربط.قسم(معرف_القسم_المحلي);
                };
                الإضافة := الإضافة + (حقيقة_الرمز.القيمة مثل عدد);
            };
            لو (!مرجع_مهمل) {
                دع الحافة: حافة_إزاحة_ربط = {
                    القسم: معرف_قسم_المصدر,
                    الإزاحة: الإزاحة,
                    المرجع: المرجع,
                    إضافة: الإضافة,
                    رمز_صيغة: نوع_الإزاحة
                };
                أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
            };
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع نتيجة_استيعاب_كائن_كوف.نجح();
}
