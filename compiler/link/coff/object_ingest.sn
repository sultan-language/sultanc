استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.resolution;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.target_policy;
استورد compiler.backend.target.target_model;

عام نوع خطأ_استيعاب_كائن_كوف =
    | كائن_غير_صالح
    | إزاحة_غير_صالحة
    | تعريف_رمز_مكرر
    | حل_رمز_يتطلب_سياسة
;

عام نوع نتيجة_استيعاب_كائن_كوف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_كائن_كوف
;

نوع حقيقة_قسم_كوف_مدخل = {
    معرف_الربط: معرف_قسم_ربط,
    الاسم: متجه غ8,
    حجم_المحتوى: غير_موقع,
    موضع_المحتوى: غير_موقع,
    موضع_الإزاحات: غير_موقع,
    عدد_الإزاحات: غير_موقع,
    الخصائص: غير_موقع
};

نوع حقيقة_رمز_كوف_مدخل = {
    معرف_الربط: اختيار معرف_رمز_ربط,
    رقم_القسم: عدد,
    القيمة: غير_موقع,
    محلي: منطقي,
    صالح: منطقي
};

عرف انسخ_بايتات_اسم_كوف_للربط(المصدر: &متجه غ8): متجه غ8 {
    دع النسخة: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(النسخة, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع النسخة;
}

عرف صنف_قسم_كوف(الخصائص: غير_موقع): صنف_قسم_ربط {
    لو ((الخصائص & 0x00000020) != 0) {
        أرجع صنف_قسم_ربط.شفرة();
    };
    لو ((الخصائص & 0x00000080) != 0) {
        أرجع صنف_قسم_ربط.بيانات_صفرية();
    };
    لو ((الخصائص & 0x02000000) != 0
        || (الخصائص & 0x00000200) != 0) {
        أرجع صنف_قسم_ربط.تصحيح();
    };
    لو ((الخصائص & 0x80000000) != 0) {
        أرجع صنف_قسم_ربط.بيانات_قابلة_للكتابة();
    };
    أرجع صنف_قسم_ربط.بيانات_للقراءة();
}

عرف محاذاة_قسم_كوف(الخصائص: غير_موقع): غير_موقع {
    دع ترميز_المحاذاة: غير_موقع = (الخصائص >> 20) & 0xF;
    لو (ترميز_المحاذاة == 0) { أرجع 1; };
    لو (ترميز_المحاذاة > 14) { أرجع 1; };
    أرجع 1 << (ترميز_المحاذاة - 1);
}

عرف رقم_عشري_من_اسم_كوف(
    الاسم: &متجه غ8,
    البداية: غير_موقع
): اختيار غير_موقع {
    دع القيمة: متغير غير_موقع = 0;
    دع الفهرس: متغير غير_موقع = البداية;
    دع وجد: متغير منطقي = خطأ;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        دع البايت: غ8 = (*الاسم)[الفهرس];
        لو (البايت < 0x30 || البايت > 0x39) {
            أرجع اختيار.لا_شيء();
        };
        وجد := صواب;
        القيمة := القيمة * 10 + ((البايت - 0x30) مثل غير_موقع);
        الفهرس := الفهرس + 1;
    }
    لو (!وجد) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة);
}

عرف اسم_قسم_كوف(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع,
    موضع_جدول_النصوص: غير_موقع,
    حجم_جدول_النصوص: غير_موقع
): اختيار متجه غ8 {
    دع الاسم_المباشر: متجه غ8;
    طابق اقرأ_اسم_ثابت_كوف(البايتات, موضع_الرأس, 8) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الاسم_المباشر := القيمة; };
    لو ((الطول(الاسم_المباشر) مثل غير_موقع) == 0
        || الاسم_المباشر[0] != 0x2F) {
        أرجع اختيار.بعض(الاسم_المباشر);
    };
    دع الإزاحة: غير_موقع;
    طابق رقم_عشري_من_اسم_كوف(&الاسم_المباشر, 1) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
    لو (الإزاحة >= حجم_جدول_النصوص) { أرجع اختيار.لا_شيء(); };
    أرجع اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_جدول_النصوص + الإزاحة,
        موضع_جدول_النصوص + حجم_جدول_النصوص
    );
}

عرف اسم_رمز_كوف(
    البايتات: &متجه غ8,
    موضع_الرمز: غير_موقع,
    موضع_جدول_النصوص: غير_موقع,
    حجم_جدول_النصوص: غير_موقع
): اختيار متجه غ8 {
    دع صفر_الاسم: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { صفر_الاسم := القيمة; };
    لو (صفر_الاسم != 0) {
        أرجع اقرأ_اسم_ثابت_كوف(البايتات, موضع_الرمز, 8);
    };
    دع الإزاحة: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 4) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
    لو (الإزاحة < 4 || الإزاحة >= حجم_جدول_النصوص) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اقرأ_اسم_صفري_كوف(
        البايتات,
        موضع_جدول_النصوص + الإزاحة,
        موضع_جدول_النصوص + حجم_جدول_النصوص
    );
}

عرف حول_نتيجة_تسجيل_رمز_كوف(
    النتيجة: نتيجة_تسجيل_رمز_ربط
): نتيجة_استيعاب_كائن_كوف {
    طابق النتيجة مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_استيعاب_كائن_كوف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(_, _, _) -> {
        أرجع نتيجة_استيعاب_كائن_كوف.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_حل_رموز_ربط.تعريفان_قويان(_, _) -> {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.تعريف_رمز_مكرر()
            );
        }
        | _ -> {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.حل_رمز_يتطلب_سياسة()
            );
        };
    };
}

عرف فك_عدد_موقع_كوف(
    الخام: غير_موقع,
    عدد_البتات: غير_موقع
): عدد {
    دع حد_الإشارة: غير_موقع = 1 << (عدد_البتات - 1);
    دع المدى: غير_موقع = 1 << عدد_البتات;
    لو (الخام < حد_الإشارة) { أرجع الخام مثل عدد; };
    أرجع -((المدى - الخام) مثل عدد);
}

عرف إضافة_تعليمة_كوف_ذراع64(
    التعليمة: غير_موقع,
    النوع: غير_موقع
): اختيار عدد {
    لو (النوع == 3) {
        دع الفوري: غير_موقع = التعليمة & 0x03FFFFFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 26) * 4);
    };
    لو (النوع == 4 || النوع == 5) {
        دع المنخفض: غير_موقع = (التعليمة >> 29) & 3;
        دع العالي: غير_موقع = (التعليمة >> 5) & 0x7FFFF;
        دع الفوري: عدد = فك_عدد_موقع_كوف(
            المنخفض | (العالي << 2),
            21
        );
        لو (النوع == 4) { أرجع اختيار.بعض(الفوري * 4096); };
        أرجع اختيار.بعض(الفوري);
    };
    لو (النوع == 6) {
        دع الفوري: غير_موقع = (التعليمة >> 10) & 0xFFF;
        لو (((التعليمة >> 22) & 1) != 0) {
            أرجع اختيار.بعض((الفوري * 4096) مثل عدد);
        };
        أرجع اختيار.بعض(الفوري مثل عدد);
    };
    لو (النوع == 7) {
        دع الفوري: غير_موقع = (التعليمة >> 10) & 0xFFF;
        دع أس_المقياس: غير_موقع = (التعليمة >> 30) & 3;
        أرجع اختيار.بعض((الفوري * (1 << أس_المقياس)) مثل عدد);
    };
    لو (النوع == 0xF) {
        دع الفوري: غير_موقع = (التعليمة >> 5) & 0x7FFFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 19) * 4);
    };
    لو (النوع == 0x10) {
        دع الفوري: غير_موقع = (التعليمة >> 5) & 0x3FFF;
        أرجع اختيار.بعض(فك_عدد_موقع_كوف(الفوري, 14) * 4);
    };
    أرجع اختيار.لا_شيء();
}

عرف إضافة_إزاحة_كوف(
    القسم: &قسم_ربط,
    الموضع: غير_موقع,
    النوع: غير_موقع,
    المعمارية: هوية_معمارية
): اختيار عدد {
    طابق (*القسم).المحتوى مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(0); }
    | اختيار.بعض(المحتوى) -> {
        لو (الموضع >= (الطول(المحتوى) مثل غير_موقع)) {
            أرجع اختيار.لا_شيء();
        };
        طابق المعمارية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            لو (النوع == 1) {
                طابق اقرأ_غ64_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة مثل عدد); };
            };
            لو (النوع >= 2 && النوع <= 9) {
                طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة مثل عدد); };
            };
        }
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            لو (النوع == 1 || النوع == 2 || النوع == 8) {
                طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> {
                    أرجع اختيار.بعض(القيمة مثل عدد);
                };
            };
            لو (النوع == 0x11) {
                أرجع اقرأ_ص32_كوف(&المحتوى, الموضع);
            };
            دع التعليمة: غير_موقع;
            طابق اقرأ_غ32_كوف(&المحتوى, الموضع) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { التعليمة := القيمة; };
            طابق إضافة_تعليمة_كوف_ذراع64(التعليمة, النوع) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); };
        }
        | _ -> { };
        أرجع اختيار.بعض(0);
    };
}

عام عرف استوعب_كائن_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_كائن_كوف {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!ضمن_حدود_كوف(البايتات, 0, 20)) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع الآلة_المطلوبة: غير_موقع;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { الآلة_المطلوبة := القيمة; };
    دع الآلة: غير_موقع;
    دع عدد_الأقسام: غير_موقع;
    دع موضع_جدول_الرموز: غير_موقع;
    دع عدد_الرموز: غير_موقع;
    دع حجم_الرأس_الاختياري: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    طابق اقرأ_غ16_كوف(البايتات, 2) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { عدد_الأقسام := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 8) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { موضع_جدول_الرموز := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, 12) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { عدد_الرموز := القيمة; };
    طابق اقرأ_غ16_كوف(البايتات, 16) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
    | اختيار.بعض(القيمة) -> { حجم_الرأس_الاختياري := القيمة; };
    لو (الآلة != الآلة_المطلوبة || حجم_الرأس_الاختياري != 0) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع موضع_الأقسام: غير_موقع = 20;
    لو (!ضمن_حدود_كوف(البايتات, موضع_الأقسام, عدد_الأقسام * 40)) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };
    دع موضع_جدول_النصوص: غير_موقع = موضع_جدول_الرموز + عدد_الرموز * 18;
    دع حجم_جدول_النصوص: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, موضع_جدول_النصوص) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    }
    | اختيار.بعض(القيمة) -> { حجم_جدول_النصوص := القيمة; };
    لو (حجم_جدول_النصوص < 4
        || !ضمن_حدود_كوف(
            البايتات,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        )) {
        أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
            خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
        );
    };

    دع حقائق_الأقسام: متغير متجه حقيقة_قسم_كوف_مدخل = [];
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع موضع_الرأس: غير_موقع = موضع_الأقسام + فهرس_القسم * 40;
        دع الاسم: متجه غ8;
        طابق اسم_قسم_كوف(
            البايتات,
            موضع_الرأس,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
        دع حجم_المحتوى: غير_موقع;
        دع موضع_المحتوى: غير_موقع;
        دع موضع_الإزاحات: غير_موقع;
        دع عدد_الإزاحات: غير_موقع;
        دع الخصائص: غير_موقع;
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 16) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { حجم_المحتوى := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 20) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { موضع_المحتوى := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 24) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { موضع_الإزاحات := القيمة; };
        طابق اقرأ_غ16_كوف(البايتات, موضع_الرأس + 32) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { عدد_الإزاحات := القيمة; };
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرأس + 36) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الخصائص := القيمة; };
        دع المحتوى: اختيار متجه غ8;
        لو ((الخصائص & 0x00000080) != 0 || حجم_المحتوى == 0) {
            المحتوى := اختيار.لا_شيء();
        } وإلا {
            طابق انسخ_بايتات_كوف(البايتات, موضع_المحتوى, حجم_المحتوى) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
            | اختيار.بعض(القيمة) -> { المحتوى := اختيار.بعض(القيمة); };
        };
        لو (عدد_الإزاحات > 0
            && !ضمن_حدود_كوف(البايتات, موضع_الإزاحات, عدد_الإزاحات * 10)) {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
            );
        };
        دع اسم_الحقيقة: متجه غ8 = انسخ_بايتات_اسم_كوف_للربط(&الاسم);
        دع اسم_الحاوية: اختيار متجه غ8 = اختيار.لا_شيء();
        دع هوية_الاسم: هوية_اسم_قسم_ربط = {
            اسم_القسم: الاسم,
            اسم_الحاوية: اسم_الحاوية
        };
        دع معرف_الربط: معرف_قسم_ربط = أضف_قسم_مدخل_إلى_سياق_الربط(
            السياق,
            (*المدخل).المعرف,
            فهرس_القسم + 1,
            هوية_الاسم,
            حقائق_صيغة_قسم_ربط.كوف(الخصائص),
            صنف_قسم_كوف(الخصائص),
            محاذاة_قسم_كوف(الخصائص),
            حجم_المحتوى,
            المحتوى
        );
        دع الحقيقة: حقيقة_قسم_كوف_مدخل = {
            معرف_الربط: معرف_الربط,
            الاسم: اسم_الحقيقة,
            حجم_المحتوى: حجم_المحتوى,
            موضع_المحتوى: موضع_المحتوى,
            موضع_الإزاحات: موضع_الإزاحات,
            عدد_الإزاحات: عدد_الإزاحات,
            الخصائص: الخصائص
        };
        ألحق(حقائق_الأقسام, الحقيقة);
        فهرس_القسم := فهرس_القسم + 1;
    }

    دع حقائق_الرموز: متغير متجه حقيقة_رمز_كوف_مدخل = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_الرمز: غير_موقع = موضع_جدول_الرموز + فهرس_الرمز * 18;
        لو (!ضمن_حدود_كوف(البايتات, موضع_الرمز, 18)) {
            أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
            );
        };
        دع الاسم: متجه غ8;
        طابق اسم_رمز_كوف(
            البايتات,
            موضع_الرمز,
            موضع_جدول_النصوص,
            حجم_جدول_النصوص
        ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
        دع القيمة: غير_موقع;
        دع رقم_القسم: عدد;
        طابق اقرأ_غ32_كوف(البايتات, موضع_الرمز + 8) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(المقروء) -> { القيمة := المقروء; };
        طابق اقرأ_ص16_كوف(البايتات, موضع_الرمز + 12) مع
        | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()); }
        | اختيار.بعض(المقروء) -> { رقم_القسم := المقروء; };
        دع موضع_فئة_التخزين: غير_موقع = موضع_الرمز + 16;
        دع موضع_عدد_المساعدات: غير_موقع = موضع_الرمز + 17;
        دع فئة_التخزين: غير_موقع = (*البايتات)[موضع_فئة_التخزين] مثل غير_موقع;
        دع عدد_المساعدات: غير_موقع = (*البايتات)[موضع_عدد_المساعدات] مثل غير_موقع;
        دع محلي: منطقي = فئة_التخزين != 2 && فئة_التخزين != 105;
        دع معرف_الربط: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
        لو (!محلي && (الطول(الاسم) مثل غير_موقع) > 0) {
            دع نتيجة_التسجيل: نتيجة_تسجيل_رمز_ربط;
            لو (رقم_القسم == 0) {
                نتيجة_التسجيل := سجل_رمزا_غير_معرف_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف
                );
            } وإلا لو (رقم_القسم == -1) {
                نتيجة_التسجيل := سجل_تعريف_رمز_للربط_في_موضع(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    (*المدخل).المعرف,
                    قوة_تعريف_رمز_ربط.قوي(),
                    موضع_تعريف_رمز_ربط.مطلق(القيمة),
                    0
                );
            } وإلا {
                لو (رقم_القسم < 1
                    || (رقم_القسم مثل غير_موقع) > عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                        خطأ_استيعاب_كائن_كوف.كائن_غير_صالح()
                    );
                };
                دع القوة: متغير قوة_تعريف_رمز_ربط = قوة_تعريف_رمز_ربط.قوي();
                لو (فئة_التخزين == 105) { القوة := قوة_تعريف_رمز_ربط.ضعيف(); };
                دع فهرس_القسم: غير_موقع =
                    (رقم_القسم مثل غير_موقع) - 1;
                نتيجة_التسجيل := سجل_تعريف_قسم_رمز_في_سياق_الربط(
                    السياق,
                    &الاسم,
                    (*المدخل).المعرف,
                    القوة,
                    حقائق_الأقسام[فهرس_القسم].معرف_الربط,
                    القيمة,
                    0
                );
            };
            طابق نتيجة_التسجيل مع
            | نتيجة_تسجيل_رمز_ربط.نجح(المعرف) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(المعرف, _, _) -> {
                معرف_الربط := اختيار.بعض(المعرف);
            }
            | _ -> { أرجع حول_نتيجة_تسجيل_رمز_كوف(نتيجة_التسجيل); };
        };
        دع الحقيقة: حقيقة_رمز_كوف_مدخل = {
            معرف_الربط: معرف_الربط,
            رقم_القسم: رقم_القسم,
            القيمة: القيمة,
            محلي: محلي,
            صالح: صواب
        };
        ألحق(حقائق_الرموز, الحقيقة);
        دع فهرس_المساعد: متغير غير_موقع = 0;
        بينما (فهرس_المساعد < عدد_المساعدات) {
            دع غير_صالح: حقيقة_رمز_كوف_مدخل = {
                معرف_الربط: اختيار.لا_شيء(),
                رقم_القسم: 0,
                القيمة: 0,
                محلي: صواب,
                صالح: خطأ
            };
            ألحق(حقائق_الرموز, غير_صالح);
            فهرس_المساعد := فهرس_المساعد + 1;
        }
        فهرس_الرمز := فهرس_الرمز + عدد_المساعدات + 1;
    }

    فهرس_القسم := 0;
    بينما (فهرس_القسم < عدد_الأقسام) {
        دع حقيقة_القسم: &حقيقة_قسم_كوف_مدخل = &حقائق_الأقسام[فهرس_القسم];
        دع فهرس_الإزاحة: متغير غير_موقع = 0;
        بينما (فهرس_الإزاحة < (*حقيقة_القسم).عدد_الإزاحات) {
            دع موضع_الإزاحة: غير_موقع =
                (*حقيقة_القسم).موضع_الإزاحات + فهرس_الإزاحة * 10;
            دع الإزاحة: غير_موقع;
            دع فهرس_مرجع_الرمز: غير_موقع;
            دع نوع_الإزاحة: غير_موقع;
            طابق اقرأ_غ32_كوف(البايتات, موضع_الإزاحة) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { الإزاحة := القيمة; };
            طابق اقرأ_غ32_كوف(البايتات, موضع_الإزاحة + 4) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { فهرس_مرجع_الرمز := القيمة; };
            طابق اقرأ_غ16_كوف(البايتات, موضع_الإزاحة + 8) مع
            | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_كائن_كوف.خطأ(خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()); }
            | اختيار.بعض(القيمة) -> { نوع_الإزاحة := القيمة; };
            لو (فهرس_مرجع_الرمز >= (الطول(حقائق_الرموز) مثل غير_موقع)
                || !حقائق_الرموز[فهرس_مرجع_الرمز].صالح) {
                أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                    خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                );
            };
            دع حقيقة_الرمز: حقيقة_رمز_كوف_مدخل =
                حقائق_الرموز[فهرس_مرجع_الرمز];
            دع المرجع: مرجع_إزاحة_ربط;
            دع الإضافة: متغير عدد;
            دع فهرس_قسم_الربط: غير_موقع =
                (*حقيقة_القسم).معرف_الربط.القيمة;
            طابق إضافة_إزاحة_كوف(
                &(*السياق).الأقسام[فهرس_قسم_الربط],
                الإزاحة,
                نوع_الإزاحة,
                (*السياق).الهدف.المعمارية.الهوية
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                    خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                );
            }
            | اختيار.بعض(القيمة) -> { الإضافة := القيمة; };
            طابق حقيقة_الرمز.معرف_الربط مع
            | اختيار.بعض(المعرف) -> {
                المرجع := مرجع_إزاحة_ربط.رمز(المعرف);
            }
            | اختيار.لا_شيء -> {
                لو (!حقيقة_الرمز.محلي
                    || حقيقة_الرمز.رقم_القسم < 1
                    || (حقيقة_الرمز.رقم_القسم مثل غير_موقع) > عدد_الأقسام) {
                    أرجع نتيجة_استيعاب_كائن_كوف.خطأ(
                        خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة()
                    );
                };
                دع فهرس_قسم_الرمز_المحلي: غير_موقع =
                    (حقيقة_الرمز.رقم_القسم مثل غير_موقع) - 1;
                المرجع := مرجع_إزاحة_ربط.قسم(
                    حقائق_الأقسام[فهرس_قسم_الرمز_المحلي].معرف_الربط
                );
                الإضافة := الإضافة + (حقيقة_الرمز.القيمة مثل عدد);
            };
            دع الحافة: حافة_إزاحة_ربط = {
                القسم: (*حقيقة_القسم).معرف_الربط,
                الإزاحة: الإزاحة,
                المرجع: المرجع,
                إضافة: الإضافة,
                رمز_صيغة: نوع_الإزاحة
            };
            أضف_إزاحة_ربط_إلى_السياق(السياق, الحافة);
            فهرس_الإزاحة := فهرس_الإزاحة + 1;
        }
        فهرس_القسم := فهرس_القسم + 1;
    }
    أرجع نتيجة_استيعاب_كائن_كوف.نجح();
}
