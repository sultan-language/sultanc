استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.layout_model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.relocation_model;
استورد compiler.link.address_resolution;
استورد compiler.link.coff.reader;
استورد compiler.link.coff.object_ingest;
استورد compiler.link.coff.names;
استورد compiler.link.coff.directive_syntax;
استورد compiler.backend.target.target_model;
استورد std.bytes.compare;
استورد compiler.link.coff.target_policy;
استورد std.text.from_bytes;

عام نوع خطأ_صورة_كوف_بي_إي =
    | هدف_غير_مدعوم
    | تخطيط_غير_صالح
    | رمز_دخول_مفقود
    // The symbol a relocation could not bind, or an empty name when the
    // failure is not one symbol's (export or import metadata).
    | رمز_خارجي_غير_محلول بنوع متجه غ8
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
;

عام نوع نتيجة_صورة_كوف_بي_إي =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_صورة_كوف_بي_إي
;

// One input section placed in an output section, at الإزاحة from its start.
نوع جزء_قسم_خرج_كوف = {
    القسم: معرف_قسم_ربط,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع
};

// Where an input section was placed: output section index and offset.
نوع موقع_جزء_خرج_كوف = {
    الفهرس: غير_موقع,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع
};

نوع قسم_خرج_كوف_بي_إي = {
    // Input sections merged into this output section; empty when synthetic.
    الأجزاء: متجه جزء_قسم_خرج_كوف,
    الاسم: متجه غ8,
    المحتوى: متجه غ8,
    الحجم_الافتراضي: غير_موقع,
    العنوان_النسبي: غير_موقع,
    موضع_الملف: غير_موقع,
    حجم_الملف: غير_موقع,
    الخصائص: غير_موقع
};

نوع رمز_استيراد_كوف_بي_إي = {
    المدخل: معرف_مدخل_ربط,
    اسم_التصدير: متجه غ8,
    // An import by ordinal (IMPORT_OBJECT_ORDINAL), 0 for an import by name.
    الترتيب: غير_موقع,
    // The hint written before the name of an import by name.
    التلميح: غير_موقع,
    الرمز_المباشر: اختيار معرف_رمز_ربط,
    رمز_المؤشر: اختيار معرف_رمز_ربط,
    موضع_اسم_الاستيراد: غير_موقع,
    عنوان_إيات: غير_موقع,
    عنوان_ستب: غير_موقع
};

نوع مكتبة_استيراد_كوف_بي_إي = {
    المدخل: معرف_مدخل_ربط,
    الاسم: متجه غ8,
    فهارس_الرموز: متجه غير_موقع,
    موضع_إيلت: غير_موقع,
    موضع_إيات: غير_موقع,
    موضع_الاسم: غير_موقع
};

نوع دليل_تصدير_كوف_بي_إي = {
    البايتات: متجه غ8,
    مواضع_العناوين: متجه غير_موقع,
    الرموز: متجه معرف_رمز_ربط
};

نوع دليل_بيانات_كوف_بي_إي = {
    العنوان: غير_موقع,
    الحجم: غير_موقع
};


عرف أنشئ_دليل_بيانات_كوف(
    العنوان: غير_موقع,
    الحجم: غير_موقع
): دليل_بيانات_كوف_بي_إي {
    دع الدليل: دليل_بيانات_كوف_بي_إي = {
        العنوان: العنوان,
        الحجم: الحجم
    };
    أرجع الدليل;
}

عرف حاذ_قيمة_كوف_بي_إي(
    القيمة: غير_موقع,
    المحاذاة: غير_موقع
): غير_موقع {
    لو (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: غير_موقع = القيمة % المحاذاة;
    لو (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف انسخ_متجه_بايتات_كوف_بي_إي(
    المصدر: &متجه غ8
): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف ألحق_صفرا_كوف_بي_إي(
    الناتج: &متغير متجه غ8,
    العدد: غير_موقع
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < العدد) {
        ألحق((*الناتج), 0);
        الفهرس := الفهرس + 1;
    }
}

عرف أكمل_كوف_بي_إي_إلى(
    الناتج: &متغير متجه غ8,
    الموضع: غير_موقع
): منطقي {
    دع الحالي: غير_موقع = الطول(*الناتج) مثل غير_موقع;
    لو (الحالي > الموضع) { أرجع خطأ; };
    ألحق_صفرا_كوف_بي_إي(الناتج, الموضع - الحالي);
    أرجع صواب;
}

عرف ألحق_اسم_صفري_كوف_بي_إي(
    الناتج: &متغير متجه غ8,
    الاسم: &متجه غ8
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق((*الناتج), (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق((*الناتج), 0);
}

عرف ألحق_اسم_قسم_صورة_كوف(
    الناتج: &متغير متجه غ8,
    الاسم: &متجه غ8
): فراغ {
    دع الحد: متغير غير_موقع = الطول(*الاسم) مثل غير_موقع;
    لو (الحد > 8) { الحد := 8; };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحد) {
        ألحق((*الناتج), (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق_صفرا_كوف_بي_إي(الناتج, 8 - الحد);
}

عرف يبدأ_رمز_كوف_باسم_مؤشر(
    الاسم: &متجه غ8
): منطقي {
    دع البادئة: متجه غ8 = بايتات_من_نص(«__imp_»);
    لو (الطول(*الاسم) < الطول(البادئة)) { أرجع خطأ; };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(البادئة) مثل غير_موقع)) {
        لو ((*الاسم)[الفهرس] != البادئة[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عرف اسم_تصدير_من_رمز_كوف(
    الاسم: &متجه غ8
): متجه غ8 {
    لو (!يبدأ_رمز_كوف_باسم_مؤشر(الاسم)) {
        أرجع انسخ_متجه_بايتات_كوف_بي_إي(الاسم);
    };
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 6;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف ابحث_اعتماد_ديناميكي_لمدخل_كوف(
    الخطة: &خطة_ربط,
    المدخل: معرف_مدخل_ربط
): اختيار متجه غ8 {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (
        الفهرس < (الطول((*الخطة).المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        دع الاعتماد: &اعتماد_مكتبة_ديناميكية_ربط =
            &(*الخطة).المكتبات_الديناميكية[الفهرس];
        طابق (*الاعتماد).المدخل مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(معرف_المدخل) -> {
            لو (معرفا_مدخل_ربط_متساويان(معرف_المدخل, المدخل)) {
                أرجع اختيار.بعض(
                    انسخ_متجه_بايتات_كوف_بي_إي(&(*الاعتماد).الاسم)
                );
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

// How a dynamic symbol is imported. For a short import object (PE/COFF
// "Import Library Format", LLD ImportFile::parse) the header decides:
// Type bits 2-4 are the name type: IMPORT_OBJECT_ORDINAL (0) imports by the
// ordinal in Ordinal/Hint; IMPORT_OBJECT_NAME (1) imports the symbol name;
// NAME_NOPREFIX (2) drops a leading '?', '@' or '_'; NAME_UNDECORATE (3) also
// stops at the first '@'; NAME_EXPORTAS (4) imports the name stored after
// the DLL name. Ordinal/Hint is the hint of an import by name. A symbol of a
// DLL input linked directly is imported by its own name with hint 0.
// Previously every import used the symbol name and hint 0, so ordinal
// imports and undecorated import names were wrong.
نوع معلومات_استيراد_كوف = {
    الاسم: متجه غ8,
    الترتيب: غير_موقع,
    التلميح: غير_موقع
};

عرف معلومات_استيراد_مدخل_كوف(
    السياق: &سياق_ربط,
    المدخل: معرف_مدخل_ربط,
    اسم_الرمز: &متجه غ8
): اختيار معلومات_استيراد_كوف {
    دع الافتراضي: معلومات_استيراد_كوف = {
        الاسم: اسم_تصدير_من_رمز_كوف(اسم_الرمز),
        الترتيب: 0,
        التلميح: 0
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)) {
        لو ((*السياق).الخطة.المدخلات[الفهرس].المعرف.القيمة == المدخل.القيمة) {
            دع البايتات: &متجه غ8 = &(*السياق).الخطة.المدخلات[الفهرس].البايتات;
            دع التوقيع_الأول: متغير غير_موقع = 1;
            دع التوقيع_الثاني: متغير غير_موقع = 0;
            طابق اقرأ_غ16_كوف(البايتات, 0) مع
            | اختيار.بعض(القيمة) -> { التوقيع_الأول := القيمة; }
            | اختيار.لا_شيء -> { };
            طابق اقرأ_غ16_كوف(البايتات, 2) مع
            | اختيار.بعض(القيمة) -> { التوقيع_الثاني := القيمة; }
            | اختيار.لا_شيء -> { };
            لو (التوقيع_الأول != 0 || التوقيع_الثاني != 0xFFFF) {
                أرجع اختيار.بعض(الافتراضي);
            };
            دع التلميح: غير_موقع;
            دع النوع: غير_موقع;
            دع حجم_البيانات: غير_موقع;
            طابق اقرأ_غ16_كوف(البايتات, 16) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { التلميح := القيمة; };
            طابق اقرأ_غ16_كوف(البايتات, 18) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { النوع := القيمة; };
            طابق اقرأ_غ32_كوف(البايتات, 12) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { حجم_البيانات := القيمة; };
            دع النهاية: غير_موقع = 20 + حجم_البيانات;
            دع اسم_الرأس: متجه غ8;
            طابق اقرأ_اسم_صفري_كوف(البايتات, 20, النهاية) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { اسم_الرأس := القيمة; };
            دع نوع_الاسم: غير_موقع = (النوع / 4) & 7;
            لو (نوع_الاسم == 0) {
                لو (التلميح == 0) { أرجع اختيار.لا_شيء(); };
                دع بلا_اسم: متجه غ8 = [];
                دع بالترتيب: معلومات_استيراد_كوف = {
                    الاسم: بلا_اسم,
                    الترتيب: التلميح,
                    التلميح: 0
                };
                أرجع اختيار.بعض(بالترتيب);
            };
            دع الاسم: متغير متجه غ8 = [];
            لو (نوع_الاسم == 1) {
                الاسم := اسم_الرأس;
            } وإلا لو (نوع_الاسم == 2 || نوع_الاسم == 3) {
                دع البداية: متغير غير_موقع = 0;
                لو ((الطول(اسم_الرأس) مثل غير_موقع) > 0
                    && (اسم_الرأس[0] == 0x3F || اسم_الرأس[0] == 0x40
                        || اسم_الرأس[0] == 0x5F)) {
                    البداية := 1;
                };
                دع ف: متغير غير_موقع = البداية;
                دع توقف: متغير منطقي = خطأ;
                بينما (ف < (الطول(اسم_الرأس) مثل غير_موقع) && !توقف) {
                    لو (نوع_الاسم == 3 && اسم_الرأس[ف] == 0x40) {
                        توقف := صواب;
                    } وإلا {
                        ألحق(الاسم, اسم_الرأس[ف]);
                    };
                    ف := ف + 1;
                }
            } وإلا لو (نوع_الاسم == 4) {
                // The DLL name, then the export name.
                دع موضع_المكتبة: غير_موقع = 20 + (الطول(اسم_الرأس) مثل غير_موقع) + 1;
                دع اسم_المكتبة: متجه غ8;
                طابق اقرأ_اسم_صفري_كوف(البايتات, موضع_المكتبة, النهاية) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { اسم_المكتبة := القيمة; };
                دع موضع_التصدير: غير_موقع =
                    موضع_المكتبة + (الطول(اسم_المكتبة) مثل غير_موقع) + 1;
                طابق اقرأ_اسم_صفري_كوف(البايتات, موضع_التصدير, النهاية) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
            } وإلا {
                أرجع اختيار.لا_شيء();
            };
            لو ((الطول(الاسم) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
            دع بالاسم: معلومات_استيراد_كوف = {
                الاسم: الاسم,
                الترتيب: 0,
                التلميح: التلميح
            };
            أرجع اختيار.بعض(بالاسم);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.بعض(الافتراضي);
}

عرف ابحث_رمز_استيراد_كوف(
    الرموز: &متجه رمز_استيراد_كوف_بي_إي,
    المدخل: معرف_مدخل_ربط,
    الاسم: &متجه غ8
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_استيراد_كوف_بي_إي = &(*الرموز)[الفهرس];
        لو (معرفا_مدخل_ربط_متساويان((*الرمز).المدخل, المدخل)
            && متجها_بايتات_متساويان(&(*الرمز).اسم_التصدير, الاسم)) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اجمع_رموز_استيراد_كوف(
    السياق: &سياق_ربط
): اختيار متجه رمز_استيراد_كوف_بي_إي {
    دع الناتج: متغير متجه رمز_استيراد_كوف_بي_إي = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[الفهرس];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.ديناميكي(المدخل) -> {
            // Unreferenced DLL exports are not imported.
            لو ((*الرمز).مستخدم) {
                دع المعلومات: معلومات_استيراد_كوف;
                طابق معلومات_استيراد_مدخل_كوف(السياق, المدخل, &(*الرمز).الاسم) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { المعلومات := القيمة; };
                دع مرجع_اسم_الاستيراد: &متجه غ8 = &المعلومات.الاسم;
                دع الاسم: متجه غ8 = *مرجع_اسم_الاستيراد;
                دع موضع: اختيار غير_موقع = ابحث_رمز_استيراد_كوف(
                    &الناتج,
                    المدخل,
                    &الاسم
                );
                دع فهرس_الاستيراد: غير_موقع;
                طابق موضع مع
                | اختيار.بعض(القيمة) -> { فهرس_الاستيراد := القيمة; }
                | اختيار.لا_شيء -> {
                    دع الجديد: رمز_استيراد_كوف_بي_إي = {
                        المدخل: المدخل,
                        اسم_التصدير: الاسم,
                        الترتيب: المعلومات.الترتيب,
                        التلميح: المعلومات.التلميح,
                        الرمز_المباشر: اختيار.لا_شيء(),
                        رمز_المؤشر: اختيار.لا_شيء(),
                        موضع_اسم_الاستيراد: 0,
                        عنوان_إيات: 0,
                        عنوان_ستب: 0
                    };
                    فهرس_الاستيراد := الطول(الناتج) مثل غير_موقع;
                    ألحق(الناتج, الجديد);
                };
                لو (يبدأ_رمز_كوف_باسم_مؤشر(&(*الرمز).الاسم)) {
                    الناتج[فهرس_الاستيراد].رمز_المؤشر :=
                        اختيار.بعض((*الرمز).المعرف);
                } وإلا {
                    الناتج[فهرس_الاستيراد].الرمز_المباشر :=
                        اختيار.بعض((*الرمز).المعرف);
                };
            };
        }
        | _ -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// Imports are grouped into one descriptor per DLL name, compared without
// case as Windows compares module names (LLD IdataContents groups by DLL).
// Previously every import member (one per imported function in an import
// library) got its own descriptor naming the same DLL.
عرف ابحث_مكتبة_استيراد_كوف(
    المكتبات: &متجه مكتبة_استيراد_كوف_بي_إي,
    الاسم: &متجه غ8
): اختيار غير_موقع {
    دع المطلوب: متجه غ8 = اسم_ملف_صغير_كوف(الاسم);
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المكتبات) مثل غير_موقع)) {
        دع الموجود: متجه غ8 = اسم_ملف_صغير_كوف(&(*المكتبات)[الفهرس].الاسم);
        لو (متجها_اسم_كوف_متساويان(&الموجود, &المطلوب)) {
            أرجع اختيار.بعض(الفهرس);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف اجمع_مكتبات_استيراد_كوف(
    السياق: &سياق_ربط,
    الرموز: &متجه رمز_استيراد_كوف_بي_إي
): اختيار متجه مكتبة_استيراد_كوف_بي_إي {
    دع المكتبات: متغير متجه مكتبة_استيراد_كوف_بي_إي = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول(*الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_استيراد_كوف_بي_إي = &(*الرموز)[فهرس_الرمز];
        دع فهرس_المكتبة: غير_موقع;
        دع الاسم: متجه غ8;
        طابق ابحث_اعتماد_ديناميكي_لمدخل_كوف(
            &(*السياق).الخطة,
            (*الرمز).المدخل
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
        طابق ابحث_مكتبة_استيراد_كوف(&المكتبات, &الاسم) مع
        | اختيار.بعض(القيمة) -> { فهرس_المكتبة := القيمة; }
        | اختيار.لا_شيء -> {
            دع الفهارس: متجه غير_موقع = [];
            دع المكتبة: مكتبة_استيراد_كوف_بي_إي = {
                المدخل: (*الرمز).المدخل,
                الاسم: الاسم,
                فهارس_الرموز: الفهارس,
                موضع_إيلت: 0,
                موضع_إيات: 0,
                موضع_الاسم: 0
            };
            فهرس_المكتبة := الطول(المكتبات) مثل غير_موقع;
            ألحق(المكتبات, المكتبة);
        };
        ألحق(
            المكتبات[فهرس_المكتبة].فهارس_الرموز,
            فهرس_الرمز
        );
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع اختيار.بعض(المكتبات);
}

عرف ابن_قسم_استيراد_كوف(
    عنوان_القسم: غير_موقع,
    الرموز: &متغير متجه رمز_استيراد_كوف_بي_إي,
    المكتبات: &متغير متجه مكتبة_استيراد_كوف_بي_إي
): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع عدد_المكتبات: غير_موقع = الطول(*المكتبات) مثل غير_موقع;
    ألحق_صفرا_كوف_بي_إي(&متغير الناتج, (عدد_المكتبات + 1) * 20);

    دع فهرس_المكتبة: متغير غير_موقع = 0;
    بينما (فهرس_المكتبة < عدد_المكتبات) {
        (*المكتبات)[فهرس_المكتبة].موضع_إيلت :=
            الطول(الناتج) مثل غير_موقع;
        دع عدد_الرموز: غير_موقع =
            الطول((*المكتبات)[فهرس_المكتبة].فهارس_الرموز)
                مثل غير_موقع;
        ألحق_صفرا_كوف_بي_إي(
            &متغير الناتج,
            (عدد_الرموز + 1) * 8
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }
    فهرس_المكتبة := 0;
    بينما (فهرس_المكتبة < عدد_المكتبات) {
        (*المكتبات)[فهرس_المكتبة].موضع_إيات :=
            الطول(الناتج) مثل غير_موقع;
        دع عدد_الرموز: غير_موقع =
            الطول((*المكتبات)[فهرس_المكتبة].فهارس_الرموز)
                مثل غير_موقع;
        ألحق_صفرا_كوف_بي_إي(
            &متغير الناتج,
            (عدد_الرموز + 1) * 8
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }

    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول(*الرموز) مثل غير_موقع)) {
        // An import by ordinal has no hint/name entry.
        لو ((*الرموز)[فهرس_الرمز].الترتيب == 0) {
            لو (((الطول(الناتج) مثل غير_موقع) % 2) != 0) {
                ألحق(الناتج, 0);
            };
            (*الرموز)[فهرس_الرمز].موضع_اسم_الاستيراد :=
                الطول(الناتج) مثل غير_موقع;
            ألحق_غ16_كوف(&متغير الناتج, (*الرموز)[فهرس_الرمز].التلميح);
            ألحق_اسم_صفري_كوف_بي_إي(
                &متغير الناتج,
                &(*الرموز)[فهرس_الرمز].اسم_التصدير
            );
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }

    فهرس_المكتبة := 0;
    بينما (فهرس_المكتبة < عدد_المكتبات) {
        (*المكتبات)[فهرس_المكتبة].موضع_الاسم :=
            الطول(الناتج) مثل غير_موقع;
        ألحق_اسم_صفري_كوف_بي_إي(
            &متغير الناتج,
            &(*المكتبات)[فهرس_المكتبة].الاسم
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }

    فهرس_المكتبة := 0;
    بينما (فهرس_المكتبة < عدد_المكتبات) {
        دع المكتبة: &مكتبة_استيراد_كوف_بي_إي =
            &(*المكتبات)[فهرس_المكتبة];
        دع عدد_الرموز: غير_موقع =
            الطول((*المكتبة).فهارس_الرموز) مثل غير_موقع;
        دع ترتيب_الرمز: متغير غير_موقع = 0;
        بينما (ترتيب_الرمز < عدد_الرموز) {
            دع فهرس_المدخل: غير_موقع =
                (*المكتبة).فهارس_الرموز[ترتيب_الرمز];
            // IMAGE_ORDINAL_FLAG64 marks an import by ordinal.
            دع عنوان_الاسم: متغير غير_موقع = عنوان_القسم
                + (*الرموز)[فهرس_المدخل].موضع_اسم_الاستيراد;
            لو ((*الرموز)[فهرس_المدخل].الترتيب != 0) {
                عنوان_الاسم := 0x8000000000000000
                    | (*الرموز)[فهرس_المدخل].الترتيب;
            };
            اكتب_غ64_كوف_في(
                &متغير الناتج,
                (*المكتبة).موضع_إيلت + ترتيب_الرمز * 8,
                عنوان_الاسم
            );
            اكتب_غ64_كوف_في(
                &متغير الناتج,
                (*المكتبة).موضع_إيات + ترتيب_الرمز * 8,
                عنوان_الاسم
            );
            (*الرموز)[فهرس_المدخل].عنوان_إيات := عنوان_القسم
                + (*المكتبة).موضع_إيات + ترتيب_الرمز * 8;
            ترتيب_الرمز := ترتيب_الرمز + 1;
        }
        دع موضع_الواصف: غير_موقع = فهرس_المكتبة * 20;
        اكتب_غ32_كوف_في(
            &متغير الناتج,
            موضع_الواصف,
            عنوان_القسم + (*المكتبة).موضع_إيلت
        );
        اكتب_غ32_كوف_في(
            &متغير الناتج,
            موضع_الواصف + 12,
            عنوان_القسم + (*المكتبة).موضع_الاسم
        );
        اكتب_غ32_كوف_في(
            &متغير الناتج,
            موضع_الواصف + 16,
            عنوان_القسم + (*المكتبة).موضع_إيات
        );
        فهرس_المكتبة := فهرس_المكتبة + 1;
    }
    أرجع الناتج;
}

عرف حجم_ستب_استيراد_كوف(الهدف: &واصف_هدف): غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { أرجع 6; }
    | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع 12; }
    | _ -> { أرجع 0; };
}

عرف فرق_نسبي_ص32_كوف(
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): اختيار غير_موقع {
    لو (الوجهة >= المصدر) {
        دع الفرق: غير_موقع = الوجهة - المصدر;
        لو (الفرق > 0x7FFFFFFF) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الفرق);
    };
    دع الفرق: غير_موقع = المصدر - الوجهة;
    لو (الفرق > 0x80000000) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((0x100000000 - الفرق) & 0xFFFFFFFF);
}

عرف رقع_صفحة21_كوف_ذراع64(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): منطقي {
    دع صفحة_المصدر: غير_موقع = المصدر / 4096;
    دع صفحة_الوجهة: غير_موقع = الوجهة / 4096;
    دع الفرق: عدد = (صفحة_الوجهة مثل عدد) - (صفحة_المصدر مثل عدد);
    لو (الفرق < -0x100000 || الفرق > 0xFFFFF) { أرجع خطأ; };
    دع الترميز: غير_موقع;
    لو (الفرق < 0) {
        الترميز := (0x200000 + الفرق) مثل غير_موقع;
    } وإلا {
        الترميز := الفرق مثل غير_موقع;
    };
    دع الأصل: غير_موقع;
    طابق اقرأ_غ32_كوف(الصورة, الموضع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الأصل := القيمة; };
    دع المنخفض: غير_موقع = (الترميز & 3) << 29;
    دع العالي: غير_موقع = ((الترميز >> 2) & 0x7FFFF) << 5;
    أرجع اكتب_غ32_كوف_في(
        الصورة,
        الموضع,
        (الأصل & 0x9F00001F) | المنخفض | العالي
    );
}

عرف رقع_إزاحة12_كوف_ذراع64(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    الوجهة: غير_موقع,
    حمل: منطقي
): منطقي {
    دع الأصل: غير_موقع;
    طابق اقرأ_غ32_كوف(الصورة, الموضع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الأصل := القيمة; };
    دع الإزاحة: غير_موقع = الوجهة % 4096;
    دع الفوري: متغير غير_موقع = الإزاحة;
    لو (حمل) {
        دع أس_المقياس: غير_موقع = (الأصل >> 30) & 3;
        دع المقياس: غير_موقع = 1 << أس_المقياس;
        لو ((الإزاحة % المقياس) != 0) { أرجع خطأ; };
        الفوري := الإزاحة / المقياس;
    };
    لو (الفوري > 0xFFF) { أرجع خطأ; };
    أرجع اكتب_غ32_كوف_في(
        الصورة,
        الموضع,
        (الأصل & 0xFFC003FF) | ((الفوري & 0xFFF) << 10)
    );
}

عرف رقع_فرع_كوف_ذراع64(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع,
    عدد_البتات: غير_موقع,
    إزاحة_البتات: غير_موقع
): منطقي {
    دع الفرق: عدد = (الوجهة مثل عدد) - (المصدر مثل عدد);
    لو ((الفرق % 4) != 0) { أرجع خطأ; };
    دع الفوري: عدد = الفرق / 4;
    دع المجال: غير_موقع = 1 << عدد_البتات;
    دع الحد: عدد = (المجال >> 1) مثل عدد;
    لو (الفوري < -الحد || الفوري >= الحد) { أرجع خطأ; };
    دع الترميز: غير_موقع;
    لو (الفوري < 0) {
        الترميز := المجال - ((0 - الفوري) مثل غير_موقع);
    } وإلا {
        الترميز := الفوري مثل غير_موقع;
    };
    دع الأصل: غير_موقع;
    طابق اقرأ_غ32_كوف(الصورة, الموضع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الأصل := القيمة; };
    دع القناع: غير_موقع = ((1 << عدد_البتات) - 1) << إزاحة_البتات;
    أرجع اكتب_غ32_كوف_في(
        الصورة,
        الموضع,
        (الأصل & (~القناع)) | ((الترميز << إزاحة_البتات) & القناع)
    );
}

عرف ابن_ستبات_استيراد_كوف(
    الهدف: &واصف_هدف,
    قاعدة_الصورة: غير_موقع,
    عنوان_القسم: غير_موقع,
    الرموز: &متغير متجه رمز_استيراد_كوف_بي_إي
): اختيار متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع حجم_الستب: غير_موقع = حجم_ستب_استيراد_كوف(الهدف);
    لو (حجم_الستب == 0) { أرجع اختيار.لا_شيء(); };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        طابق (*الرموز)[الفهرس].الرمز_المباشر مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(_) -> {
            دع موضع_الستب: غير_موقع = الطول(الناتج) مثل غير_موقع;
            (*الرموز)[الفهرس].عنوان_ستب := عنوان_القسم + موضع_الستب;
            طابق (*الهدف).المعمارية.الهوية مع
            | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
                ألحق(الناتج, 0xFF);
                ألحق(الناتج, 0x25);
                دع المصدر: غير_موقع = قاعدة_الصورة
                    + عنوان_القسم + موضع_الستب + 6;
                دع الوجهة: غير_موقع = قاعدة_الصورة
                    + (*الرموز)[الفهرس].عنوان_إيات;
                دع الفرق: غير_موقع;
                طابق فرق_نسبي_ص32_كوف(المصدر, الوجهة) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(القيمة) -> { الفرق := القيمة; };
                ألحق_غ32_كوف(&متغير الناتج, الفرق);
            }
            | هوية_معمارية.ذراع_أربعة_وستون -> {
                ألحق_غ32_كوف(&متغير الناتج, 0x90000010);
                ألحق_غ32_كوف(&متغير الناتج, 0xF9400210);
                ألحق_غ32_كوف(&متغير الناتج, 0xD61F0200);
                دع عنوان_المصدر: غير_موقع = قاعدة_الصورة
                    + عنوان_القسم + موضع_الستب;
                دع عنوان_الوجهة: غير_موقع = قاعدة_الصورة
                    + (*الرموز)[الفهرس].عنوان_إيات;
                لو (!رقع_صفحة21_كوف_ذراع64(
                    &متغير الناتج,
                    موضع_الستب,
                    عنوان_المصدر,
                    عنوان_الوجهة
                )) { أرجع اختيار.لا_شيء(); };
                لو (!رقع_إزاحة12_كوف_ذراع64(
                    &متغير الناتج,
                    موضع_الستب + 4,
                    عنوان_الوجهة,
                    صواب
                )) { أرجع اختيار.لا_شيء(); };
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف خصائص_قسم_صورة_كوف(
    القسم: &قسم_ربط
): اختيار غير_موقع {
    دع الخصائص: غير_موقع;
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.كوف(القيمة) -> { الخصائص := القيمة; }
    | _ -> { أرجع اختيار.لا_شيء(); };
    دع قناع_الخصائص: غير_موقع = (0x00000020 مثل غير_موقع)
        | (0x00000040 مثل غير_موقع) | (0x00000080 مثل غير_موقع)
        | (0x02000000 مثل غير_موقع) | (0x20000000 مثل غير_موقع)
        | (0x40000000 مثل غير_موقع) | (0x80000000 مثل غير_موقع);
    دع الناتج: غير_موقع = الخصائص & قناع_الخصائص;
    أرجع اختيار.بعض(الناتج);
}

// Output-section formation, as PE linkers do (PE/COFF "Grouped Sections
// (Object Only)"; LLD Writer::createSections): live input sections with the
// same name and image characteristics form one output section; a `$` in the
// name groups `<name>$<suffix>` into `<name>`, ordered by the full name (input
// order among equal names), so CRT tables such as .CRT$XCA ... .CRT$XCU ...
// .CRT$XCZ become contiguous and ordered. Sections removed at link time
// (IMAGE_SCN_LNK_REMOVE, IMAGE_SCN_LNK_INFO such as .drectve) and CodeView
// `.debug$` sections never enter the image. Previously every input section
// became its own page-aligned output section, so grouped CRT tables were
// neither contiguous nor ordered and a CRT link exceeded the 96-section image
// limit.
عرف اسم_أساس_قسم_كوف(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        لو ((*الاسم)[الفهرس] == 0x24 && الفهرس > 0) { أرجع الناتج; };
        ألحق(الناتج, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف اسم_كوف_أصغر(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*أ) مثل غير_موقع) && الفهرس < (الطول(*ب) مثل غير_موقع)) {
        لو ((*أ)[الفهرس] != (*ب)[الفهرس]) {
            أرجع (*أ)[الفهرس] < (*ب)[الفهرس];
        };
        الفهرس := الفهرس + 1;
    }
    أرجع (الطول(*أ) مثل غير_موقع) < (الطول(*ب) مثل غير_موقع);
}

عرف قسم_كوف_خارج_الصورة(القسم: &قسم_ربط): منطقي {
    طابق (*القسم).حقائق_الصيغة مع
    | حقائق_صيغة_قسم_ربط.كوف(الخصائص) -> {
        لو ((الخصائص & 0x00000800) != 0 || (الخصائص & 0x00000200) != 0) {
            أرجع صواب;
        };
    }
    | _ -> { };
    دع البادئة: متجه غ8 = بايتات_من_نص(«.debug$»);
    لو ((الطول((*القسم).الاسم.اسم_القسم) مثل غير_موقع) < (الطول(البادئة) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(البادئة) مثل غير_موقع)) {
        لو ((*القسم).الاسم.اسم_القسم[الفهرس] != البادئة[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

نوع مجموعة_قسم_خرج_كوف = {
    الاسم: متجه غ8,
    الخصائص: غير_موقع,
    الأعضاء: متجه غير_موقع
};

// /MERGE:<from>=<to> directives of every loaded object (coff/directive_syntax.sn)
// followed by LLD's default rules (.idata, .didat, .edata, .xdata and .00cfg
// into .rdata, .bss into .data; LinkerDriver::linkerMain adds them after the
// user's rules, which take precedence), applied as LLD's
// Writer::mergeSections: the first rule for a <from> wins (LLD keeps the
// first and warns on a conflicting one), rules are taken in <from>-name order
// (LLD's std::map), a <to> that is itself merged is followed to the end of
// its chain (a cycle fails the link), and the output section <from> is
// either renamed to <to> when there is no such output section, or appended
// after <to>'s own members. Merging a code section marks the target as code
// (LLD OutputSection::merge, link.exe compatibility). The MSVC CRT relies on
// this: its objects carry /merge:.CRT=.rdata, so the initializer tables are
// laid out inside .rdata. The default rules apply to sections from input
// objects; the import, export and relocation tables SultanC synthesizes keep
// their own output sections. Previously /MERGE was ignored and such tables
// stayed in their own output sections.
// Copies of elements reordered or merged in place; the copy is taken in a
// call, so no reference into the vector outlives it while the vector is
// written.
عرف انسخ_زوج_دمج_كوف(القيمة: &زوج_دمج_كوف): زوج_دمج_كوف {
    دع النسخة: زوج_دمج_كوف = *القيمة;
    أرجع النسخة;
}

عرف انسخ_أعضاء_مجموعة_كوف(القيمة: &متجه غير_موقع): متجه غير_موقع {
    دع النسخة: متجه غير_موقع = *القيمة;
    أرجع النسخة;
}

عرف انسخ_تصدير_صورة_كوف(القيمة: &تصدير_صورة_كوف): تصدير_صورة_كوف {
    دع النسخة: تصدير_صورة_كوف = *القيمة;
    أرجع النسخة;
}

عرف أضف_قاعدة_دمج_كوف(
    الدمج: &متغير متجه زوج_دمج_كوف,
    القاعدة: &زوج_دمج_كوف
): فراغ {
    دع ب: متغير غير_موقع = 0;
    بينما (ب < (الطول(*الدمج) مثل غير_موقع)) {
        لو (متجها_اسم_كوف_متساويان(&(*الدمج)[ب].المصدر, &(*القاعدة).المصدر)) { أرجع; };
        ب := ب + 1;
    }
    ألحق(*الدمج, *القاعدة);
    // Keep the rules ordered by <from>.
    دع الموضع: متغير غير_موقع = (الطول(*الدمج) مثل غير_موقع) - 1;
    دع مستمر: متغير منطقي = صواب;
    بينما (الموضع > 0 && مستمر) {
        لو (اسم_كوف_أصغر(&(*الدمج)[الموضع].المصدر, &(*الدمج)[الموضع - 1].المصدر)) {
            دع السابق: زوج_دمج_كوف = انسخ_زوج_دمج_كوف(&(*الدمج)[الموضع - 1]);
            دع الحالي: زوج_دمج_كوف = انسخ_زوج_دمج_كوف(&(*الدمج)[الموضع]);
            (*الدمج)[الموضع - 1] := الحالي;
            (*الدمج)[الموضع] := السابق;
            الموضع := الموضع - 1;
        } وإلا {
            مستمر := خطأ;
        };
    }
}

عرف دمج_توجيهات_صورة_كوف(التوجيهات: &توجيهات_قسم_كوف): متجه زوج_دمج_كوف {
    دع الدمج: متغير متجه زوج_دمج_كوف = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*التوجيهات).الدمج) مثل غير_موقع)) {
        أضف_قاعدة_دمج_كوف(&متغير الدمج, &(*التوجيهات).الدمج[ف]);
        ف := ف + 1;
    }
    دع الافتراضية: متجه نص = [
        «.idata», «.rdata», «.didat», «.rdata», «.edata», «.rdata»,
        «.xdata», «.rdata», «.00cfg», «.rdata», «.bss», «.data»
    ];
    ف := 0;
    بينما (ف + 1 < (الطول(الافتراضية) مثل غير_موقع)) {
        دع مرجع_من: &نص = &الافتراضية[ف];
        دع مرجع_إلى: &نص = &الافتراضية[ف + 1];
        دع القاعدة: زوج_دمج_كوف = {
            المصدر: بايتات_من_نص(*مرجع_من),
            الوجهة: بايتات_من_نص(*مرجع_إلى)
        };
        أضف_قاعدة_دمج_كوف(&متغير الدمج, &القاعدة);
        ف := ف + 2;
    }
    أرجع الدمج;
}

عرف أول_مجموعة_كوف_بالاسم(
    المجموعات: &متجه مجموعة_قسم_خرج_كوف,
    مدموجة: &متجه منطقي,
    الاسم: &متجه غ8,
    عدا: غير_موقع
): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المجموعات) مثل غير_موقع)) {
        لو (ف != عدا && !(*مدموجة)[ف]
            && متجها_اسم_كوف_متساويان(&(*المجموعات)[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف طبق_دمج_أقسام_كوف(
    التوجيهات: &توجيهات_قسم_كوف,
    المجموعات: &متغير متجه مجموعة_قسم_خرج_كوف,
    مدموجة: &متغير متجه منطقي
): منطقي {
    دع الدمج: متجه زوج_دمج_كوف = دمج_توجيهات_صورة_كوف(التوجيهات);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الدمج) مثل غير_موقع)) {
        لو (!متجها_اسم_كوف_متساويان(&الدمج[ف].المصدر, &الدمج[ف].الوجهة)) {
            دع مرجع_الهدف: &متجه غ8 = &الدمج[ف].الوجهة;
            دع الهدف: متغير متجه غ8 = *مرجع_الهدف;
            دع الخطوات: متغير غير_موقع = 0;
            دع مستمر: متغير منطقي = صواب;
            بينما (مستمر) {
                مستمر := خطأ;
                دع ب: متغير غير_موقع = 0;
                بينما (ب < (الطول(الدمج) مثل غير_موقع) && !مستمر) {
                    لو (متجها_اسم_كوف_متساويان(&الدمج[ب].المصدر, &الهدف)
                        && !متجها_اسم_كوف_متساويان(&الدمج[ب].المصدر, &الدمج[ب].الوجهة)) {
                        دع مرجع_التالي: &متجه غ8 = &الدمج[ب].الوجهة;
                        الهدف := *مرجع_التالي;
                        مستمر := صواب;
                    };
                    ب := ب + 1;
                }
                لو (مستمر) {
                    الخطوات := الخطوات + 1;
                    // /merge: cycle found for the section.
                    لو (الخطوات > (الطول(الدمج) مثل غير_موقع)) { أرجع خطأ; };
                };
            }
            دع لا_استثناء: غير_موقع = الطول(*المجموعات) مثل غير_موقع;
            طابق أول_مجموعة_كوف_بالاسم(المجموعات, مدموجة, &الدمج[ف].المصدر, لا_استثناء) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(المصدر) -> {
                طابق أول_مجموعة_كوف_بالاسم(المجموعات, مدموجة, &الهدف, المصدر) مع
                | اختيار.لا_شيء -> {
                    (*المجموعات)[المصدر].الاسم := الهدف;
                }
                | اختيار.بعض(الوجهة) -> {
                    دع أعضاء_المصدر: متجه غير_موقع =
                        انسخ_أعضاء_مجموعة_كوف(&(*المجموعات)[المصدر].الأعضاء);
                    دع ع: متغير غير_موقع = 0;
                    بينما (ع < (الطول(أعضاء_المصدر) مثل غير_موقع)) {
                        ألحق((*المجموعات)[الوجهة].الأعضاء, أعضاء_المصدر[ع]);
                        ع := ع + 1;
                    }
                    لو (((*المجموعات)[المصدر].الخصائص & 0x00000020) != 0) {
                        // Code is not initialized or uninitialized data.
                        دع بلا_بيانات: غير_موقع = 0xFFFFFF3F مثل غير_موقع;
                        دع شفرة: غير_موقع = 0x00000020 مثل غير_موقع;
                        دع الخصائص: غير_موقع =
                            ((*المجموعات)[الوجهة].الخصائص | شفرة) & بلا_بيانات;
                        (*المجموعات)[الوجهة].الخصائص := الخصائص;
                    };
                    (*مدموجة)[المصدر] := صواب;
                };
            };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف أضف_الأقسام_القانونية_إلى_صورة_كوف(
    السياق: &سياق_ربط,
    التوجيهات: &توجيهات_قسم_كوف,
    الأقسام: &متغير متجه قسم_خرج_كوف_بي_إي
): منطقي {
    دع المجموعات: متغير متجه مجموعة_قسم_خرج_كوف = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_ربط = &(*السياق).الأقسام[الفهرس];
        لو ((*القسم).حي && !قسم_كوف_خارج_الصورة(القسم)) {
            دع الخصائص: غير_موقع;
            طابق خصائص_قسم_صورة_كوف(القسم) مع
            | اختيار.لا_شيء -> { أرجع خطأ; }
            | اختيار.بعض(القيمة) -> { الخصائص := القيمة; };
            دع الأساس: متجه غ8 = اسم_أساس_قسم_كوف(&(*القسم).الاسم.اسم_القسم);
            دع موضع_المجموعة: متغير اختيار غير_موقع = اختيار.لا_شيء();
            دع ب: متغير غير_موقع = 0;
            بينما (ب < (الطول(المجموعات) مثل غير_موقع)) {
                لو (المجموعات[ب].الخصائص == الخصائص
                    && متجها_بايتات_متساويان(&المجموعات[ب].الاسم, &الأساس)) {
                    موضع_المجموعة := اختيار.بعض(ب);
                };
                ب := ب + 1;
            }
            طابق موضع_المجموعة مع
            | اختيار.بعض(الموضع) -> { ألحق(المجموعات[الموضع].الأعضاء, الفهرس); }
            | اختيار.لا_شيء -> {
                دع الأعضاء: متجه غير_موقع = [الفهرس];
                دع المجموعة: مجموعة_قسم_خرج_كوف = {
                    الاسم: الأساس,
                    الخصائص: الخصائص,
                    الأعضاء: الأعضاء
                };
                ألحق(المجموعات, المجموعة);
            };
        };
        الفهرس := الفهرس + 1;
    }

    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(المجموعات) مثل غير_موقع)) {
        // Stable insertion sort by full input section name.
        دع الأعضاء: متغير متجه غير_موقع = [];
        دع ع: متغير غير_موقع = 0;
        بينما (ع < (الطول(المجموعات[م].الأعضاء) مثل غير_موقع)) {
            دع الحالي: غير_موقع = المجموعات[م].الأعضاء[ع];
            ألحق(الأعضاء, الحالي);
            دع الموضع: متغير غير_موقع = (الطول(الأعضاء) مثل غير_موقع) - 1;
            دع مستمر: متغير منطقي = صواب;
            بينما (الموضع > 0 && مستمر) {
                دع السابق: غير_موقع = الأعضاء[الموضع - 1];
                لو (اسم_كوف_أصغر(
                    &(*السياق).الأقسام[الحالي].الاسم.اسم_القسم,
                    &(*السياق).الأقسام[السابق].الاسم.اسم_القسم
                )) {
                    الأعضاء[الموضع] := السابق;
                    الموضع := الموضع - 1;
                } وإلا {
                    مستمر := خطأ;
                };
            }
            الأعضاء[الموضع] := الحالي;
            ع := ع + 1;
        }
        المجموعات[م].الأعضاء := الأعضاء;
        م := م + 1;
    }

    دع مدموجة: متغير متجه منطقي = [];
    م := 0;
    بينما (م < (الطول(المجموعات) مثل غير_موقع)) {
        ألحق(مدموجة, خطأ);
        م := م + 1;
    }
    لو (!طبق_دمج_أقسام_كوف(التوجيهات, &متغير المجموعات, &متغير مدموجة)) {
        أرجع خطأ;
    };

    دع ملء_الشفرة: غ8 = 0;
    دع ملء_شفرة_إكس64: منطقي =
        (*السياق).الهدف.المعمارية.الهوية == هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون();
    م := 0;
    بينما (م < (الطول(المجموعات) مثل غير_موقع)) {
        لو (!مدموجة[م]) {
            دع مرجع_الأعضاء: &متجه غير_موقع = &المجموعات[م].الأعضاء;
            دع الأعضاء: متجه غير_موقع = *مرجع_الأعضاء;
            // Lay the members out in order, aligned, padding code with int3 on
            // x86-64 and zero elsewhere.
            دع له_محتوى: متغير منطقي = خطأ;
            دع ع: متغير غير_موقع = 0;
            بينما (ع < (الطول(الأعضاء) مثل غير_موقع)) {
                طابق (*السياق).الأقسام[الأعضاء[ع]].المحتوى مع
                | اختيار.بعض(_) -> { له_محتوى := صواب; }
                | اختيار.لا_شيء -> { };
                ع := ع + 1;
            }
            دع شفرة: منطقي = (المجموعات[م].الخصائص & 0x00000020) != 0;
            دع بايت_الملء: متغير غ8 = ملء_الشفرة;
            لو (شفرة && ملء_شفرة_إكس64) { بايت_الملء := 0xCC; };
            دع المحتوى: متغير متجه غ8 = [];
            دع الأجزاء: متغير متجه جزء_قسم_خرج_كوف = [];
            دع الحجم: متغير غير_موقع = 0;
            // Uninitialized members after the last initialized one (a merged
            // .bss after .data) occupy memory only, as in LLD's layout.
            دع نهاية_المهيأ: متغير غير_موقع = 0;
            ع := 0;
            بينما (ع < (الطول(الأعضاء) مثل غير_موقع)) {
                دع العضو: &قسم_ربط = &(*السياق).الأقسام[الأعضاء[ع]];
                دع المحاذى: غير_موقع = حاذ_قيمة_كوف_بي_إي(الحجم, (*العضو).المحاذاة);
                لو (له_محتوى) {
                    بينما ((الطول(المحتوى) مثل غير_موقع) < المحاذى) {
                        ألحق(المحتوى, بايت_الملء);
                    }
                    طابق (*العضو).المحتوى مع
                    | اختيار.بعض(البايتات) -> {
                        دع ف: متغير غير_موقع = 0;
                        بينما (ف < (الطول(البايتات) مثل غير_موقع)) {
                            ألحق(المحتوى, البايتات[ف]);
                            ف := ف + 1;
                        }
                        بينما ((الطول(المحتوى) مثل غير_موقع) < المحاذى + (*العضو).الحجم) {
                            ألحق(المحتوى, 0);
                        }
                        نهاية_المهيأ := المحاذى + (*العضو).الحجم;
                    }
                    | اختيار.لا_شيء -> {
                        ألحق_صفرا_كوف_بي_إي(&متغير المحتوى, (*العضو).الحجم);
                    };
                };
                دع الجزء: جزء_قسم_خرج_كوف = {
                    القسم: (*العضو).المعرف,
                    الإزاحة: المحاذى,
                    الحجم: (*العضو).الحجم
                };
                ألحق(الأجزاء, الجزء);
                الحجم := المحاذى + (*العضو).الحجم;
                ع := ع + 1;
            }
            لو (نهاية_المهيأ < (الطول(المحتوى) مثل غير_موقع)) {
                دع المهيأ: متغير متجه غ8 = [];
                دع ن: متغير غير_موقع = 0;
                بينما (ن < نهاية_المهيأ) {
                    ألحق(المهيأ, المحتوى[ن]);
                    ن := ن + 1;
                }
                المحتوى := المهيأ;
            };
            دع الخارج: قسم_خرج_كوف_بي_إي = {
                الأجزاء: الأجزاء,
                الاسم: انسخ_متجه_بايتات_كوف_بي_إي(&المجموعات[م].الاسم),
                المحتوى: المحتوى,
                الحجم_الافتراضي: الحجم,
                العنوان_النسبي: 0,
                موضع_الملف: 0,
                حجم_الملف: 0,
                الخصائص: المجموعات[م].الخصائص
            };
            ألحق((*الأقسام), الخارج);
        };
        م := م + 1;
    }
    أرجع صواب;
}

عرف اسم_قسم_ستبات_كوف(): متجه غ8 {
    دع الاسم: متجه غ8 = بايتات_من_نص(«.stubs»);
    أرجع الاسم;
}

عرف اسم_قسم_استيراد_كوف(): متجه غ8 {
    دع الاسم: متجه غ8 = بايتات_من_نص(«.idata»);
    أرجع الاسم;
}

عرف اسم_قسم_تصدير_كوف(): متجه غ8 {
    دع الاسم: متجه غ8 = بايتات_من_نص(«.edata»);
    أرجع الاسم;
}

عرف اسم_قسم_إعادة_تموضع_كوف(): متجه غ8 {
    دع الاسم: متجه غ8 = بايتات_من_نص(«.reloc»);
    أرجع الاسم;
}

عرف أضف_قسم_مصطنع_كوف(
    الأقسام: &متغير متجه قسم_خرج_كوف_بي_إي,
    الاسم: متجه غ8,
    الحجم: غير_موقع,
    الخصائص: غير_موقع
): غير_موقع {
    دع المحتوى: متجه غ8 = [];
    دع بلا_أجزاء: متجه جزء_قسم_خرج_كوف = [];
    دع القسم: قسم_خرج_كوف_بي_إي = {
        الأجزاء: بلا_أجزاء,
        الاسم: الاسم,
        المحتوى: المحتوى,
        الحجم_الافتراضي: الحجم,
        العنوان_النسبي: 0,
        موضع_الملف: 0,
        حجم_الملف: 0,
        الخصائص: الخصائص
    };
    دع الفهرس: غير_موقع = الطول(*الأقسام) مثل غير_موقع;
    ألحق((*الأقسام), القسم);
    أرجع الفهرس;
}

// One export of the image's export directory: الاسم is the exported name
// (also kept for a NONAME export, which writes no name), الرمز the defined
// symbol whose address it exports, or none for a forwarder, whose entry is
// the string التحويل ("<dll>.<sym>"). الترتيب is the export ordinal.
نوع تصدير_صورة_كوف = {
    الاسم: متجه غ8,
    الرمز: اختيار معرف_رمز_ربط,
    التحويل: متجه غ8,
    الترتيب: غير_موقع,
    بلا_اسم: منطقي
};

عرف اسم_في_قائمة_كوف(القائمة: &متجه متجه غ8, الاسم: &متجه غ8): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القائمة) مثل غير_موقع)) {
        لو (متجها_اسم_كوف_متساويان(&(*القائمة)[ف], الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The image's exports, as the PE export model has them (LLD
// LinkerDriver::fixupExports and assignExportOrdinals):
//   * the /EXPORT directives of the loaded objects, when there are any: each
//     exports its internal symbol, or forwards to "<dll>.<sym>", under its
//     external name; the first directive for an external name wins (LLD
//     deduplicates repeated directives from a shared header). These apply
//     to an executable as to a DLL, as in lld-link;
//   * otherwise, for a DLL, every defined symbol under its own name except
//     the /EXCLUDE-SYMBOLS names: the export-all rule this model already
//     used (as MinGW ld and lld-link's auto-export do only when nothing is
//     exported explicitly);
//   * otherwise none.
// The list is sorted by exported name, since the loader binary-searches the
// name pointer table. Explicit ordinals are kept and every other export
// takes the next ordinal after the largest explicit one, in name order. None
// when an exported symbol is not defined (lld-link reports it undefined),
// when two exports claim one ordinal, or when an ordinal exceeds 65535.
// Previously every defined symbol was exported from a DLL, and /EXPORT,
// ordinals, NONAME and forwarders were not applied.
عرف اجمع_صادرات_كوف(
    السياق: &سياق_ربط,
    التوجيهات: &توجيهات_قسم_كوف,
    مشترك: منطقي
): اختيار متجه تصدير_صورة_كوف {
    دع الصادرات: متغير متجه تصدير_صورة_كوف = [];
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول((*التوجيهات).الصادرات) مثل غير_موقع)) {
        دع التوجيه: &تصدير_توجيه_كوف = &(*التوجيهات).الصادرات[م];
        دع موجود: متغير منطقي = خطأ;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(الصادرات) مثل غير_موقع)) {
            لو (متجها_اسم_كوف_متساويان(&الصادرات[ب].الاسم, &(*التوجيه).الاسم_الخارجي)) {
                موجود := صواب;
            };
            ب := ب + 1;
        }
        لو (!موجود) {
            دع معرف_الرمز: متغير اختيار معرف_رمز_ربط = اختيار.لا_شيء();
            لو ((الطول((*التوجيه).التحويل) مثل غير_موقع) == 0) {
                طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &(*التوجيه).الاسم_الداخلي) مع
                | اختيار.لا_شيء -> { }
                | اختيار.بعض(الرمز) -> {
                    طابق الرمز.الحالة مع
                    | حالة_رمز_ربط.معرف(_) -> {
                        معرف_الرمز := اختيار.بعض(الرمز.المعرف);
                    }
                    | _ -> { };
                };
                طابق معرف_الرمز مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(_) -> { };
            };
            دع مرجع_الاسم: &متجه غ8 = &(*التوجيه).الاسم_الخارجي;
            دع مرجع_التحويل: &متجه غ8 = &(*التوجيه).التحويل;
            دع التصدير: تصدير_صورة_كوف = {
                الاسم: *مرجع_الاسم,
                الرمز: معرف_الرمز,
                التحويل: *مرجع_التحويل,
                الترتيب: (*التوجيه).الترتيب,
                بلا_اسم: (*التوجيه).بلا_اسم
            };
            ألحق(الصادرات, التصدير);
        };
        م := م + 1;
    }
    لو ((الطول(الصادرات) مثل غير_موقع) == 0 && مشترك) {
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
            دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[الفهرس];
            طابق (*الرمز).الحالة مع
            | حالة_رمز_ربط.معرف(_) -> {
                لو (!اسم_في_قائمة_كوف(
                    &(*التوجيهات).المستثناة_من_التصدير,
                    &(*الرمز).الاسم
                )) {
                    دع مرجع_الاسم: &متجه غ8 = &(*الرمز).الاسم;
                    دع بلا_تحويل: متجه غ8 = [];
                    دع التصدير: تصدير_صورة_كوف = {
                        الاسم: *مرجع_الاسم,
                        الرمز: اختيار.بعض((*الرمز).المعرف),
                        التحويل: بلا_تحويل,
                        الترتيب: 0,
                        بلا_اسم: خطأ
                    };
                    ألحق(الصادرات, التصدير);
                };
            }
            | _ -> { };
            الفهرس := الفهرس + 1;
        }
    };
    دع موضع: متغير غير_موقع = 1;
    بينما (موضع < (الطول(الصادرات) مثل غير_موقع)) {
        دع ع: متغير غير_موقع = موضع;
        دع مستمر: متغير منطقي = صواب;
        بينما (ع > 0 && مستمر) {
            لو (قارن_متجهي_بايتات_معجميا(
                &الصادرات[ع].الاسم,
                &الصادرات[ع - 1].الاسم
            ) < 0) {
                دع السابق: تصدير_صورة_كوف = انسخ_تصدير_صورة_كوف(&الصادرات[ع - 1]);
                دع الحالي: تصدير_صورة_كوف = انسخ_تصدير_صورة_كوف(&الصادرات[ع]);
                الصادرات[ع - 1] := الحالي;
                الصادرات[ع] := السابق;
                ع := ع - 1;
            } وإلا {
                مستمر := خطأ;
            };
        }
        موضع := موضع + 1;
    }
    // Ordinals: explicit ones must be unique; the rest follow the largest.
    دع الأكبر: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الصادرات) مثل غير_موقع)) {
        دع الترتيب: غير_موقع = الصادرات[ف].الترتيب;
        لو (الترتيب != 0) {
            دع ب: متغير غير_موقع = ف + 1;
            بينما (ب < (الطول(الصادرات) مثل غير_موقع)) {
                لو (الصادرات[ب].الترتيب == الترتيب) { أرجع اختيار.لا_شيء(); };
                ب := ب + 1;
            }
            لو (الترتيب > الأكبر) { الأكبر := الترتيب; };
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(الصادرات) مثل غير_موقع)) {
        لو (الصادرات[ف].الترتيب == 0) {
            الأكبر := الأكبر + 1;
            الصادرات[ف].الترتيب := الأكبر;
        };
        ف := ف + 1;
    }
    لو (الأكبر > 0xFFFF) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الصادرات);
}

// The export directory (PE/COFF ".edata Section"): the directory table, the
// export address table indexed by ordinal minus the ordinal base (unused
// ordinals stay zero), the name pointer and ordinal tables of the named
// exports in name order, the DLL name, the exported names and the forwarder
// strings. A forwarder's address entry is the RVA of its string, which lies
// inside the export directory, as the loader requires. Addresses of
// symbol-backed exports are written once the layout is final
// (ثبت_عناوين_تصدير_كوف).
عرف ابن_دليل_تصدير_كوف(
    السياق: &سياق_ربط,
    الصادرات: &متجه تصدير_صورة_كوف,
    عنوان_القسم: غير_موقع
): دليل_تصدير_كوف_بي_إي {
    دع الرموز: متغير متجه معرف_رمز_ربط = [];
    دع عدد_الصادرات: غير_موقع = الطول(*الصادرات) مثل غير_موقع;
    دع القاعدة: متغير غير_موقع = 1;
    دع الأكبر: متغير غير_موقع = 0;
    دع عدد_المسماة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الصادرات) {
        دع الترتيب: غير_موقع = (*الصادرات)[ف].الترتيب;
        لو (ف == 0 || الترتيب < القاعدة) { القاعدة := الترتيب; };
        لو (الترتيب > الأكبر) { الأكبر := الترتيب; };
        لو (!(*الصادرات)[ف].بلا_اسم) { عدد_المسماة := عدد_المسماة + 1; };
        ف := ف + 1;
    }
    دع عدد_العناوين: متغير غير_موقع = 0;
    لو (عدد_الصادرات > 0) { عدد_العناوين := الأكبر - القاعدة + 1; };
    دع الناتج: متغير متجه غ8 = [];
    ألحق_صفرا_كوف_بي_إي(&متغير الناتج, 40);
    دع موضع_جدول_العناوين: غير_موقع = الطول(الناتج) مثل غير_موقع;
    ألحق_صفرا_كوف_بي_إي(&متغير الناتج, عدد_العناوين * 4);
    دع موضع_جدول_الأسماء: غير_موقع = الطول(الناتج) مثل غير_موقع;
    ألحق_صفرا_كوف_بي_إي(&متغير الناتج, عدد_المسماة * 4);
    دع موضع_جدول_الرتب: غير_موقع = الطول(الناتج) مثل غير_موقع;
    ألحق_صفرا_كوف_بي_إي(&متغير الناتج, عدد_المسماة * 2);
    دع اسم_المكتبة: متجه غ8;
    طابق (*السياق).الخطة.اسم_المخرج_الديناميكي مع
    | اختيار.لا_شيء -> {
        اسم_المكتبة := اسم_مخرج_كوف_المشترك_الافتراضي();
    }
    | اختيار.بعض(القيمة) -> {
        اسم_المكتبة := انسخ_متجه_بايتات_كوف_بي_إي(&القيمة);
    };
    دع موضع_اسم_المكتبة: غير_موقع = الطول(الناتج) مثل غير_موقع;
    ألحق_اسم_صفري_كوف_بي_إي(&متغير الناتج, &اسم_المكتبة);
    دع مواضع_العناوين: متغير متجه غير_موقع = [];
    دع فهرس_الاسم: متغير غير_موقع = 0;
    ف := 0;
    بينما (ف < عدد_الصادرات) {
        دع موضع_العنوان: غير_موقع = موضع_جدول_العناوين
            + ((*الصادرات)[ف].الترتيب - القاعدة) * 4;
        لو (!(*الصادرات)[ف].بلا_اسم) {
            دع موضع_الاسم: غير_موقع = الطول(الناتج) مثل غير_موقع;
            ألحق_اسم_صفري_كوف_بي_إي(&متغير الناتج, &(*الصادرات)[ف].الاسم);
            اكتب_غ32_كوف_في(
                &متغير الناتج,
                موضع_جدول_الأسماء + فهرس_الاسم * 4,
                عنوان_القسم + موضع_الاسم
            );
            اكتب_غ16_كوف_في(
                &متغير الناتج,
                موضع_جدول_الرتب + فهرس_الاسم * 2,
                (*الصادرات)[ف].الترتيب - القاعدة
            );
            فهرس_الاسم := فهرس_الاسم + 1;
        };
        طابق (*الصادرات)[ف].الرمز مع
        | اختيار.بعض(المعرف) -> {
            ألحق(الرموز, المعرف);
            ألحق(مواضع_العناوين, موضع_العنوان);
        }
        | اختيار.لا_شيء -> {
            دع موضع_التحويل: غير_موقع = الطول(الناتج) مثل غير_موقع;
            ألحق_اسم_صفري_كوف_بي_إي(&متغير الناتج, &(*الصادرات)[ف].التحويل);
            اكتب_غ32_كوف_في(
                &متغير الناتج,
                موضع_العنوان,
                عنوان_القسم + موضع_التحويل
            );
        };
        ف := ف + 1;
    }
    اكتب_غ32_كوف_في(
        &متغير الناتج,
        12,
        عنوان_القسم + موضع_اسم_المكتبة
    );
    اكتب_غ32_كوف_في(&متغير الناتج, 16, القاعدة);
    اكتب_غ32_كوف_في(&متغير الناتج, 20, عدد_العناوين);
    اكتب_غ32_كوف_في(&متغير الناتج, 24, عدد_المسماة);
    اكتب_غ32_كوف_في(
        &متغير الناتج,
        28,
        عنوان_القسم + موضع_جدول_العناوين
    );
    اكتب_غ32_كوف_في(
        &متغير الناتج,
        32,
        عنوان_القسم + موضع_جدول_الأسماء
    );
    اكتب_غ32_كوف_في(
        &متغير الناتج,
        36,
        عنوان_القسم + موضع_جدول_الرتب
    );
    دع الدليل: دليل_تصدير_كوف_بي_إي = {
        البايتات: الناتج,
        مواضع_العناوين: مواضع_العناوين,
        الرموز: الرموز
    };
    أرجع الدليل;
}

عرف ثبت_عناوين_تصدير_كوف(
    السياق: &سياق_ربط,
    الدليل: &متغير دليل_تصدير_كوف_بي_إي,
    قاعدة_الصورة: غير_موقع
): منطقي {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*الدليل).الرموز) مثل غير_موقع)) {
        دع العنوان: غير_موقع;
        طابق حل_عنوان_رمز_ربط(
            السياق,
            (*الدليل).الرموز[الفهرس]
        ) مع
        | نتيجة_حل_عنوان_ربط.نجح(القيمة) -> { العنوان := القيمة; }
        | _ -> { أرجع خطأ; };
        لو (العنوان < قاعدة_الصورة) { أرجع خطأ; };
        لو (!اكتب_غ32_كوف_في(
            &متغير (*الدليل).البايتات,
            (*الدليل).مواضع_العناوين[الفهرس],
            العنوان - قاعدة_الصورة
        )) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عرف ضع_أقسام_صورة_كوف(
    الأقسام: &متغير متجه قسم_خرج_كوف_بي_إي,
    حجم_الرؤوس: غير_موقع
): غير_موقع {
    دع موضع_الملف: متغير غير_موقع = حجم_الرؤوس;
    دع العنوان: متغير غير_موقع = 0x1000;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        دع القسم: &متغير قسم_خرج_كوف_بي_إي = &متغير (*الأقسام)[الفهرس];
        (*القسم).العنوان_النسبي := حاذ_قيمة_كوف_بي_إي(العنوان, 0x1000);
        دع حجم_المحتوى: غير_موقع = الطول((*القسم).المحتوى) مثل غير_موقع;
        لو (حجم_المحتوى > 0) {
            (*القسم).موضع_الملف := حاذ_قيمة_كوف_بي_إي(موضع_الملف, 0x200);
            (*القسم).حجم_الملف := حاذ_قيمة_كوف_بي_إي(حجم_المحتوى, 0x200);
            موضع_الملف := (*القسم).موضع_الملف + (*القسم).حجم_الملف;
        };
        دع حجم_الذاكرة: متغير غير_موقع = (*القسم).الحجم_الافتراضي;
        لو (حجم_المحتوى > حجم_الذاكرة) { حجم_الذاكرة := حجم_المحتوى; };
        العنوان := (*القسم).العنوان_النسبي
            + حاذ_قيمة_كوف_بي_إي(حجم_الذاكرة, 0x1000);
        الفهرس := الفهرس + 1;
    }
    أرجع حاذ_قيمة_كوف_بي_إي(العنوان, 0x1000);
}

عرف ثبت_تخطيط_كوف_في_السياق(
    السياق: &متغير سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    قاعدة_الصورة: غير_موقع
): فراغ {
    دع التخطيط: متغير تخطيط_خرج_ربط = أنشئ_تخطيط_خرج_ربط();
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        دع القسم: &قسم_خرج_كوف_بي_إي = &(*الأقسام)[الفهرس];
        دع حجم_المحتوى: غير_موقع = الطول((*القسم).المحتوى) مثل غير_موقع;
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول((*القسم).الأجزاء) مثل غير_موقع)) {
            دع الجزء: جزء_قسم_خرج_كوف = (*القسم).الأجزاء[ج];
            دع حجم_ملف_الجزء: متغير غير_موقع = 0;
            لو (الجزء.الإزاحة + الجزء.الحجم <= حجم_المحتوى) {
                حجم_ملف_الجزء := الجزء.الحجم;
            };
            دع الموضع: موضع_قسم_خرج_ربط = {
                القسم: الجزء.القسم,
                إزاحة_الملف: (*القسم).موضع_الملف + الجزء.الإزاحة,
                العنوان_الافتراضي: اختيار.بعض(
                    قاعدة_الصورة + (*القسم).العنوان_النسبي + الجزء.الإزاحة
                ),
                حجم_الملف: حجم_ملف_الجزء,
                حجم_الذاكرة: الجزء.الحجم
            };
            أضف_موضع_قسم_خرج_ربط(&متغير التخطيط, الموضع);
            ج := ج + 1;
        }
        الفهرس := الفهرس + 1;
    }
    ثبت_تخطيط_خرج_الربط(السياق, &التخطيط);
}

عرف ابحث_استيراد_برمز_كوف(
    الرموز: &متجه رمز_استيراد_كوف_بي_إي,
    المعرف: معرف_رمز_ربط
): اختيار غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الرموز) مثل غير_موقع)) {
        طابق (*الرموز)[الفهرس].الرمز_المباشر مع
        | اختيار.بعض(القيمة) -> {
            لو (القيمة.القيمة == المعرف.القيمة) {
                أرجع اختيار.بعض((*الرموز)[الفهرس].عنوان_ستب);
            };
        }
        | اختيار.لا_شيء -> { };
        طابق (*الرموز)[الفهرس].رمز_المؤشر مع
        | اختيار.بعض(القيمة) -> {
            لو (القيمة.القيمة == المعرف.القيمة) {
                أرجع اختيار.بعض((*الرموز)[الفهرس].عنوان_إيات);
            };
        }
        | اختيار.لا_شيء -> { };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف عنوان_مرجع_إزاحة_كوف(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط,
    الرموز_الديناميكية: &متجه رمز_استيراد_كوف_بي_إي,
    قاعدة_الصورة: غير_موقع
): اختيار غير_موقع {
    طابق حل_عنوان_مرجع_إزاحة_ربط(السياق, المرجع) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> { أرجع اختيار.بعض(العنوان); }
    | نتيجة_حل_عنوان_ربط.رمز_ديناميكي(المعرف) -> {
        طابق ابحث_استيراد_برمز_كوف(الرموز_الديناميكية, المعرف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(العنوان) -> {
            أرجع اختيار.بعض(قاعدة_الصورة + العنوان);
        };
    }
    | نتيجة_حل_عنوان_ربط.غير_محلول -> { أرجع اختيار.لا_شيء(); };
}


عرف اجمع_إضافة_بعنوان_كوف(
    العنوان: غير_موقع,
    الإضافة: عدد
): اختيار غير_موقع {
    لو (الإضافة >= 0) {
        أرجع اختيار.بعض(العنوان + (الإضافة مثل غير_موقع));
    };
    دع المقدار: غير_موقع = (-الإضافة) مثل غير_موقع;
    لو (المقدار > العنوان) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(العنوان - المقدار);
}

عرف ابحث_قسم_خرج_كوف_بالمعرف(
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    المعرف: معرف_قسم_ربط
): اختيار موقع_جزء_خرج_كوف {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول((*الأقسام)[الفهرس].الأجزاء) مثل غير_موقع)) {
            دع الجزء: جزء_قسم_خرج_كوف = (*الأقسام)[الفهرس].الأجزاء[ج];
            لو (الجزء.القسم.القيمة == المعرف.القيمة) {
                دع الموقع: موقع_جزء_خرج_كوف = {
                    الفهرس: الفهرس,
                    الإزاحة: الجزء.الإزاحة,
                    الحجم: الجزء.الحجم
                };
                أرجع اختيار.بعض(الموقع);
            };
            ج := ج + 1;
        }
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف قسم_مرجع_إزاحة_كوف(
    السياق: &سياق_ربط,
    المرجع: &مرجع_إزاحة_ربط
): اختيار معرف_قسم_ربط {
    طابق *المرجع مع
    | مرجع_إزاحة_ربط.قسم(القسم) -> {
        أرجع اختيار.بعض(القسم);
    }
    | مرجع_إزاحة_ربط.رمز(المعرف) -> {
        طابق ابحث_رمز_ربط_بالمعرف(&(*السياق).الرموز, المعرف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                طابق التعريف.الموضع مع
                | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                    أرجع اختيار.بعض(القسم);
                }
                | _ -> { أرجع اختيار.لا_شيء(); };
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        };
    };
}

// SECREL values are offsets from the start of the output section holding
// the target (PE/COFF IMAGE_REL_*_SECREL), not from its input section.
عرف عنوان_قاعدة_قسم_مرجع_كوف(
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    المرجع: &مرجع_إزاحة_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار غير_موقع {
    دع القسم: معرف_قسم_ربط;
    طابق قسم_مرجع_إزاحة_كوف(السياق, المرجع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { القسم := القيمة; };
    طابق ابحث_قسم_خرج_كوف_بالمعرف(الأقسام, القسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموقع) -> {
        أرجع اختيار.بعض(
            قاعدة_الصورة + (*الأقسام)[الموقع.الفهرس].العنوان_النسبي
        );
    };
}

عرف فهرس_قسم_مرجع_كوف(
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    المرجع: &مرجع_إزاحة_ربط
): اختيار غير_موقع {
    دع القسم: معرف_قسم_ربط;
    طابق قسم_مرجع_إزاحة_كوف(السياق, المرجع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { القسم := القيمة; };
    طابق ابحث_قسم_خرج_كوف_بالمعرف(الأقسام, القسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموقع) -> { أرجع اختيار.بعض(الموقع.الفهرس + 1); };
}

عرف اكتب_ص32_نسبي_كوف(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    المصدر: غير_موقع,
    الوجهة: غير_موقع
): منطقي {
    دع الفرق: غير_موقع;
    طابق فرق_نسبي_ص32_كوف(المصدر, الوجهة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الفرق := القيمة; };
    أرجع اكتب_غ32_كوف_في(الصورة, الموضع, الفرق);
}

عرف طبق_إزاحة_كوف_إكس64(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    الحافة: &حافة_إزاحة_ربط,
    موضع_الكتابة: غير_موقع,
    عنوان_المصدر: غير_موقع,
    عنوان_الوجهة: غير_موقع,
    قاعدة_الصورة: غير_موقع
): منطقي {
    دع النوع: غير_موقع = (*الحافة).رمز_صيغة;
    دع الوجهة_مع_الإضافة: غير_موقع;
    طابق اجمع_إضافة_بعنوان_كوف(عنوان_الوجهة, (*الحافة).إضافة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الوجهة_مع_الإضافة := القيمة; };
    لو (النوع == 0) { أرجع صواب; };
    لو (النوع == 1) {
        أرجع اكتب_غ64_كوف_في(الصورة, موضع_الكتابة, الوجهة_مع_الإضافة);
    };
    لو (النوع == 2) {
        لو (الوجهة_مع_الإضافة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(الصورة, موضع_الكتابة, الوجهة_مع_الإضافة);
    };
    لو (النوع == 3) {
        لو (الوجهة_مع_الإضافة < قاعدة_الصورة) { أرجع خطأ; };
        دع العنوان_النسبي: غير_موقع = الوجهة_مع_الإضافة - قاعدة_الصورة;
        لو (العنوان_النسبي > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(الصورة, موضع_الكتابة, العنوان_النسبي);
    };
    لو (النوع >= 4 && النوع <= 9) {
        دع الزيادة: غير_موقع = 4 + (النوع - 4);
        أرجع اكتب_ص32_نسبي_كوف(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر + الزيادة,
            الوجهة_مع_الإضافة
        );
    };
    لو (النوع == 0xA) {
        دع الفهرس: غير_موقع;
        طابق فهرس_قسم_مرجع_كوف(السياق, الأقسام, &(*الحافة).المرجع) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { الفهرس := القيمة; };
        لو (الفهرس > 0xFFFF) { أرجع خطأ; };
        أرجع اكتب_غ16_كوف_في(الصورة, موضع_الكتابة, الفهرس);
    };
    لو (النوع == 0xB) {
        دع قاعدة_القسم: غير_موقع;
        طابق عنوان_قاعدة_قسم_مرجع_كوف(
            السياق, الأقسام, &(*الحافة).المرجع, قاعدة_الصورة
        ) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { قاعدة_القسم := القيمة; };
        لو (الوجهة_مع_الإضافة < قاعدة_القسم) { أرجع خطأ; };
        دع الإزاحة: غير_موقع = الوجهة_مع_الإضافة - قاعدة_القسم;
        لو (الإزاحة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(الصورة, موضع_الكتابة, الإزاحة);
    };
    أرجع خطأ;
}

عرف طبق_إزاحة_كوف_ذراع64(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    الحافة: &حافة_إزاحة_ربط,
    موضع_الكتابة: غير_موقع,
    عنوان_المصدر: غير_موقع,
    عنوان_الوجهة: غير_موقع,
    قاعدة_الصورة: غير_موقع
): منطقي {
    دع النوع: غير_موقع = (*الحافة).رمز_صيغة;
    دع الوجهة_مع_الإضافة: غير_موقع;
    طابق اجمع_إضافة_بعنوان_كوف(عنوان_الوجهة, (*الحافة).إضافة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(القيمة) -> { الوجهة_مع_الإضافة := القيمة; };
    لو (النوع == 0) { أرجع صواب; };
    لو (النوع == 1) {
        لو (الوجهة_مع_الإضافة > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(الصورة, موضع_الكتابة, الوجهة_مع_الإضافة);
    };
    لو (النوع == 2) {
        لو (الوجهة_مع_الإضافة < قاعدة_الصورة) { أرجع خطأ; };
        دع العنوان_النسبي: غير_موقع = الوجهة_مع_الإضافة - قاعدة_الصورة;
        لو (العنوان_النسبي > 0xFFFFFFFF) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(الصورة, موضع_الكتابة, العنوان_النسبي);
    };
    لو (النوع == 3) {
        أرجع رقع_فرع_كوف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر,
            الوجهة_مع_الإضافة,
            26,
            0
        );
    };
    لو (النوع == 4 || النوع == 5) {
        أرجع رقع_صفحة21_كوف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر,
            الوجهة_مع_الإضافة
        );
    };
    لو (النوع == 6 || النوع == 7) {
        أرجع رقع_إزاحة12_كوف_ذراع64(
            الصورة,
            موضع_الكتابة,
            الوجهة_مع_الإضافة,
            النوع == 7
        );
    };
    لو (النوع == 8) {
        دع قاعدة_القسم: غير_موقع;
        طابق عنوان_قاعدة_قسم_مرجع_كوف(
            السياق, الأقسام, &(*الحافة).المرجع, قاعدة_الصورة
        ) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { قاعدة_القسم := القيمة; };
        لو (الوجهة_مع_الإضافة < قاعدة_القسم) { أرجع خطأ; };
        أرجع اكتب_غ32_كوف_في(
            الصورة,
            موضع_الكتابة,
            الوجهة_مع_الإضافة - قاعدة_القسم
        );
    };
    // SECREL_LOW12A (9), SECREL_HIGH12A (0xA) and SECREL_LOW12L (0xB): the
    // low or high 12 bits of the target's offset in its output section, as
    // an ADD or scaled load/store immediate (LLD applySecRelLow12A,
    // applySecRelHigh12A, applySecRelLdr).
    لو (النوع == 9 || النوع == 0xA || النوع == 0xB) {
        دع قاعدة_القسم: غير_موقع;
        طابق عنوان_قاعدة_قسم_مرجع_كوف(
            السياق, الأقسام, &(*الحافة).المرجع, قاعدة_الصورة
        ) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { قاعدة_القسم := القيمة; };
        لو (الوجهة_مع_الإضافة < قاعدة_القسم) { أرجع خطأ; };
        دع الإزاحة_النسبية: غير_موقع = الوجهة_مع_الإضافة - قاعدة_القسم;
        لو (النوع == 0xA) {
            دع العليا: غير_موقع = الإزاحة_النسبية / 4096;
            لو (العليا > 0xFFF) { أرجع خطأ; };
            أرجع رقع_إزاحة12_كوف_ذراع64(الصورة, موضع_الكتابة, العليا, خطأ);
        };
        أرجع رقع_إزاحة12_كوف_ذراع64(
            الصورة, موضع_الكتابة, الإزاحة_النسبية, النوع == 0xB
        );
    };
    لو (النوع == 0xD) {
        دع الفهرس: غير_موقع;
        طابق فهرس_قسم_مرجع_كوف(السياق, الأقسام, &(*الحافة).المرجع) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { الفهرس := القيمة; };
        لو (الفهرس > 0xFFFF) { أرجع خطأ; };
        أرجع اكتب_غ16_كوف_في(الصورة, موضع_الكتابة, الفهرس);
    };
    لو (النوع == 0xE) {
        أرجع اكتب_غ64_كوف_في(الصورة, موضع_الكتابة, الوجهة_مع_الإضافة);
    };
    لو (النوع == 0xF) {
        أرجع رقع_فرع_كوف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر,
            الوجهة_مع_الإضافة,
            19,
            5
        );
    };
    لو (النوع == 0x10) {
        أرجع رقع_فرع_كوف_ذراع64(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر,
            الوجهة_مع_الإضافة,
            14,
            5
        );
    };
    لو (النوع == 0x11) {
        أرجع اكتب_ص32_نسبي_كوف(
            الصورة,
            موضع_الكتابة,
            عنوان_المصدر + 4,
            الوجهة_مع_الإضافة
        );
    };
    أرجع خطأ;
}

عرف طبق_إزاحات_صورة_كوف(
    الصورة: &متغير متجه غ8,
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    الرموز_الديناميكية: &متجه رمز_استيراد_كوف_بي_إي,
    قاعدة_الصورة: غير_موقع
): نتيجة_صورة_كوف_بي_إي {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        دع فهرس_القسم: متغير غير_موقع = الطول(*الأقسام) مثل غير_موقع;
        دع إزاحة_الجزء: متغير غير_موقع = 0;
        دع حجم_الجزء: متغير غير_موقع = 0;
        طابق ابحث_قسم_خرج_كوف_بالمعرف(الأقسام, (*الحافة).القسم) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الموقع) -> {
            فهرس_القسم := الموقع.الفهرس;
            إزاحة_الجزء := الموقع.الإزاحة;
            حجم_الجزء := الموقع.الحجم;
        };
        لو (فهرس_القسم < (الطول(*الأقسام) مثل غير_موقع)) {
            دع القسم: &قسم_خرج_كوف_بي_إي = &(*الأقسام)[فهرس_القسم];
            لو ((*الحافة).الإزاحة >= حجم_الجزء) {
                أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                    خطأ_صورة_كوف_بي_إي.إزاحة_خارج_النطاق()
                );
            };
            دع موضع_الكتابة: غير_موقع = (*القسم).موضع_الملف
                + إزاحة_الجزء + (*الحافة).الإزاحة;
            دع عنوان_المصدر: غير_موقع = قاعدة_الصورة
                + (*القسم).العنوان_النسبي + إزاحة_الجزء + (*الحافة).الإزاحة;
            دع عنوان_الوجهة: غير_موقع;
            طابق عنوان_مرجع_إزاحة_كوف(
                السياق,
                &(*الحافة).المرجع,
                الرموز_الديناميكية,
                قاعدة_الصورة
            ) مع
            | اختيار.لا_شيء -> {
                أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                    خطأ_صورة_كوف_بي_إي.رمز_خارجي_غير_محلول(
                        اسم_رمز_مرجع_إزاحة_في_سياق_الربط(السياق, &(*الحافة).المرجع)
                    )
                );
            }
            | اختيار.بعض(القيمة) -> { عنوان_الوجهة := القيمة; };
            دع نجح: منطقي;
            طابق (*السياق).الهدف.المعمارية.الهوية مع
            | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
                نجح := طبق_إزاحة_كوف_إكس64(
                    الصورة,
                    السياق,
                    الأقسام,
                    الحافة,
                    موضع_الكتابة,
                    عنوان_المصدر,
                    عنوان_الوجهة,
                    قاعدة_الصورة
                );
            }
            | هوية_معمارية.ذراع_أربعة_وستون -> {
                نجح := طبق_إزاحة_كوف_ذراع64(
                    الصورة,
                    السياق,
                    الأقسام,
                    الحافة,
                    موضع_الكتابة,
                    عنوان_المصدر,
                    عنوان_الوجهة,
                    قاعدة_الصورة
                );
            }
            | _ -> { نجح := خطأ; };
            لو (!نجح) {
                أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                    خطأ_صورة_كوف_بي_إي.إزاحة_غير_مدعومة()
                );
            };
        };
        الفهرس := الفهرس + 1;
    }
    دع فارغ: متجه غ8 = [];
    أرجع نتيجة_صورة_كوف_بي_إي.نجح(فارغ);
}

عرف نوع_إعادة_تموضع_قاعدة_كوف(
    الهدف: &واصف_هدف,
    الحافة: &حافة_إزاحة_ربط
): اختيار غير_موقع {
    طابق (*الهدف).المعمارية.الهوية مع
    | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
        لو ((*الحافة).رمز_صيغة == 1) { أرجع اختيار.بعض(10); };
        لو ((*الحافة).رمز_صيغة == 2) { أرجع اختيار.بعض(3); };
    }
    | هوية_معمارية.ذراع_أربعة_وستون -> {
        لو ((*الحافة).رمز_صيغة == 0xE) { أرجع اختيار.بعض(10); };
        لو ((*الحافة).رمز_صيغة == 1) { أرجع اختيار.بعض(3); };
    }
    | _ -> { };
    أرجع اختيار.لا_شيء();
}

نوع إدخال_إعادة_تموضع_كوف = {
    العنوان_النسبي: غير_موقع,
    النوع: غير_موقع
};

عرف اجمع_إعادات_تموضع_كوف(
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي
): متجه إدخال_إعادة_تموضع_كوف {
    دع الناتج: متغير متجه إدخال_إعادة_تموضع_كوف = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول((*السياق).الإزاحات) مثل غير_موقع)) {
        دع الحافة: &حافة_إزاحة_ربط = &(*السياق).الإزاحات[الفهرس];
        طابق نوع_إعادة_تموضع_قاعدة_كوف(&(*السياق).الهدف, الحافة) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(النوع) -> {
            طابق ابحث_قسم_خرج_كوف_بالمعرف(الأقسام, (*الحافة).القسم) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الموقع) -> {
                دع المدخل: إدخال_إعادة_تموضع_كوف = {
                    العنوان_النسبي: (*الأقسام)[الموقع.الفهرس].العنوان_النسبي
                        + الموقع.الإزاحة + (*الحافة).الإزاحة,
                    النوع: النوع
                };
                ألحق(الناتج, المدخل);
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف رتب_إعادات_تموضع_كوف(
    الإدخالات: &متغير متجه إدخال_إعادة_تموضع_كوف
): فراغ {
    دع الموضع: متغير غير_موقع = 1;
    بينما (الموضع < (الطول(*الإدخالات) مثل غير_موقع)) {
        دع الحالي: إدخال_إعادة_تموضع_كوف = (*الإدخالات)[الموضع];
        دع السابق: متغير غير_موقع = الموضع;
        دع استمر_في_الترتيب: متغير منطقي = صواب;
        بينما (السابق > 0 && استمر_في_الترتيب) {
            دع فهرس_السابق: غير_موقع = السابق - 1;
            لو ((*الإدخالات)[فهرس_السابق].العنوان_النسبي
                    > الحالي.العنوان_النسبي) {
                (*الإدخالات)[السابق] := (*الإدخالات)[فهرس_السابق];
                السابق := فهرس_السابق;
            } وإلا {
                استمر_في_الترتيب := خطأ;
            };
        }
        (*الإدخالات)[السابق] := الحالي;
        الموضع := الموضع + 1;
    }
}

عرف ابن_قسم_إعادة_تموضع_كوف(
    الإدخالات: &متجه إدخال_إعادة_تموضع_كوف
): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الإدخالات) مثل غير_موقع)) {
        دع الصفحة: غير_موقع = (*الإدخالات)[الفهرس].العنوان_النسبي
            & 0xFFFFF000;
        دع بداية_الكتلة: غير_موقع = الطول(الناتج) مثل غير_موقع;
        ألحق_غ32_كوف(&متغير الناتج, الصفحة);
        ألحق_غ32_كوف(&متغير الناتج, 0);
        بينما (
            الفهرس < (الطول(*الإدخالات) مثل غير_موقع)
                && ((*الإدخالات)[الفهرس].العنوان_النسبي & 0xFFFFF000)
                    == الصفحة
        ) {
            دع إزاحة_الصفحة: غير_موقع =
                (*الإدخالات)[الفهرس].العنوان_النسبي - الصفحة;
            ألحق_غ16_كوف(
                &متغير الناتج,
                ((*الإدخالات)[الفهرس].النوع << 12) | إزاحة_الصفحة
            );
            الفهرس := الفهرس + 1;
        }
        لو (((الطول(الناتج) مثل غير_موقع) % 4) != 0) {
            ألحق_غ16_كوف(&متغير الناتج, 0);
        };
        اكتب_غ32_كوف_في(
            &متغير الناتج,
            بداية_الكتلة + 4,
            (الطول(الناتج) مثل غير_موقع) - بداية_الكتلة
        );
    }
    أرجع الناتج;
}

عرف مجموع_أحجام_كوف_حسب_الخصائص(
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    القناع: غير_موقع
): غير_موقع {
    دع المجموع: متغير غير_موقع = 0;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        لو (((*الأقسام)[الفهرس].الخصائص & القناع) != 0) {
            المجموع := المجموع + (*الأقسام)[الفهرس].حجم_الملف;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع المجموع;
}

عرف أول_عنوان_شفرة_كوف(
    الأقسام: &متجه قسم_خرج_كوف_بي_إي
): غير_موقع {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        لو (((*الأقسام)[الفهرس].الخصائص & 0x20000000) != 0) {
            أرجع (*الأقسام)[الفهرس].العنوان_النسبي;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع 0;
}

عرف حل_عنوان_دخول_كوف(
    السياق: &سياق_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار غير_موقع {
    دع الاسم: متجه غ8;
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(0); }
    | اختيار.بعض(القيمة) -> { الاسم := القيمة; };
    دع الرمز: رمز_ربط;
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الرمز := القيمة; };
    طابق حل_عنوان_رمز_ربط(السياق, الرمز.المعرف) مع
    | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
        لو (العنوان < قاعدة_الصورة) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(العنوان - قاعدة_الصورة);
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ألحق_دليل_بيانات_كوف(
    الناتج: &متغير متجه غ8,
    العنوان: غير_موقع,
    الحجم: غير_موقع
): فراغ {
    ألحق_غ32_كوف(الناتج, العنوان);
    ألحق_غ32_كوف(الناتج, الحجم);
}

عرف اكتب_رأس_اختياري_بي_إي64(
    الناتج: &متغير متجه غ8,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    قاعدة_الصورة: غير_موقع,
    عنوان_الدخول: غير_موقع,
    حجم_الصورة: غير_موقع,
    حجم_الرؤوس: غير_موقع,
    مشترك: منطقي,
    دليل_التصدير: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_الاستيراد: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_إعادة_التموضع: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_إيات: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_الاستثناءات: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_الخيوط: اختيار دليل_بيانات_كوف_بي_إي,
    دليل_إعدادات_التحميل: اختيار دليل_بيانات_كوف_بي_إي,
    التوجيهات: &توجيهات_قسم_كوف
): فراغ {
    // /SUBSYSTEM and /STACK directives; otherwise a console image, subsystem
    // version 6.0 and a 1 MiB reserve / 4 KiB commit stack, as before.
    دع النظام_الفرعي: متغير غير_موقع = 3;
    طابق (*التوجيهات).النظام_الفرعي مع
    | اختيار.بعض(القيمة) -> { النظام_الفرعي := القيمة; }
    | اختيار.لا_شيء -> { };
    دع إصدار_رئيسي: متغير غير_موقع = 6;
    دع إصدار_فرعي: متغير غير_موقع = 0;
    طابق (*التوجيهات).إصدار_النظام_الرئيسي مع
    | اختيار.بعض(القيمة) -> {
        إصدار_رئيسي := القيمة;
        طابق (*التوجيهات).إصدار_النظام_الفرعي مع
        | اختيار.بعض(الفرعي) -> { إصدار_فرعي := الفرعي; }
        | اختيار.لا_شيء -> { };
    }
    | اختيار.لا_شيء -> { };
    دع حجز_المكدس: متغير غير_موقع = 0x100000;
    دع التزام_المكدس: متغير غير_موقع = 0x1000;
    طابق (*التوجيهات).حجز_المكدس مع
    | اختيار.بعض(القيمة) -> { حجز_المكدس := القيمة; }
    | اختيار.لا_شيء -> { };
    طابق (*التوجيهات).التزام_المكدس مع
    | اختيار.بعض(القيمة) -> { التزام_المكدس := القيمة; }
    | اختيار.لا_شيء -> { };
    ألحق_غ16_كوف(الناتج, 0x20B);
    ألحق(*الناتج, 0);
    ألحق(*الناتج, 0);
    ألحق_غ32_كوف(
        الناتج,
        مجموع_أحجام_كوف_حسب_الخصائص(الأقسام, 0x20000000)
    );
    ألحق_غ32_كوف(
        الناتج,
        مجموع_أحجام_كوف_حسب_الخصائص(الأقسام, 0x00000040)
    );
    ألحق_غ32_كوف(
        الناتج,
        مجموع_أحجام_كوف_حسب_الخصائص(الأقسام, 0x00000080)
    );
    ألحق_غ32_كوف(الناتج, عنوان_الدخول);
    ألحق_غ32_كوف(الناتج, أول_عنوان_شفرة_كوف(الأقسام));
    ألحق_غ64_كوف(الناتج, قاعدة_الصورة);
    ألحق_غ32_كوف(الناتج, 0x1000);
    ألحق_غ32_كوف(الناتج, 0x200);
    ألحق_غ16_كوف(الناتج, 6);
    ألحق_غ16_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, إصدار_رئيسي);
    ألحق_غ16_كوف(الناتج, إصدار_فرعي);
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ32_كوف(الناتج, حجم_الصورة);
    ألحق_غ32_كوف(الناتج, حجم_الرؤوس);
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, النظام_الفرعي);
    ألحق_غ16_كوف(الناتج, 0x8160);
    ألحق_غ64_كوف(الناتج, حجز_المكدس);
    ألحق_غ64_كوف(الناتج, التزام_المكدس);
    ألحق_غ64_كوف(الناتج, 0x100000);
    ألحق_غ64_كوف(الناتج, 0x1000);
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ32_كوف(الناتج, 16);
    دع فهرس_الدليل: متغير غير_موقع = 0;
    بينما (فهرس_الدليل < 16) {
        دع العنوان: متغير غير_موقع = 0;
        دع الحجم: متغير غير_موقع = 0;
        لو (فهرس_الدليل == 0) {
            طابق دليل_التصدير مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 1) {
            طابق دليل_الاستيراد مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 3) {
            طابق دليل_الاستثناءات مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 9) {
            طابق دليل_الخيوط مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 10) {
            طابق دليل_إعدادات_التحميل مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 5) {
            طابق دليل_إعادة_التموضع مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        } وإلا لو (فهرس_الدليل == 12) {
            طابق دليل_إيات مع
            | اختيار.بعض(القيمة) -> {
                العنوان := القيمة.العنوان;
                الحجم := القيمة.الحجم;
            }
            | اختيار.لا_شيء -> { };
        };
        ألحق_دليل_بيانات_كوف(الناتج, العنوان, الحجم);
        فهرس_الدليل := فهرس_الدليل + 1;
    }
}

عرف ألحق_رأس_قسم_صورة_كوف(
    الناتج: &متغير متجه غ8,
    القسم: &قسم_خرج_كوف_بي_إي
): فراغ {
    ألحق_اسم_قسم_صورة_كوف(الناتج, &(*القسم).الاسم);
    دع حجم_افتراضي: متغير غير_موقع = (*القسم).الحجم_الافتراضي;
    دع حجم_المحتوى: غير_موقع = الطول((*القسم).المحتوى) مثل غير_موقع;
    لو (حجم_المحتوى > حجم_افتراضي) { حجم_افتراضي := حجم_المحتوى; };
    ألحق_غ32_كوف(الناتج, حجم_افتراضي);
    ألحق_غ32_كوف(الناتج, (*القسم).العنوان_النسبي);
    ألحق_غ32_كوف(الناتج, (*القسم).حجم_الملف);
    ألحق_غ32_كوف(الناتج, (*القسم).موضع_الملف);
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ32_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, 0);
    ألحق_غ16_كوف(الناتج, 0);
    ألحق_غ32_كوف(الناتج, (*القسم).الخصائص);
}

عرف مؤشر_إيات_كوف(
    المكتبات: &متجه مكتبة_استيراد_كوف_بي_إي,
    عنوان_القسم: غير_موقع
): اختيار دليل_بيانات_كوف_بي_إي {
    لو ((الطول(*المكتبات) مثل غير_موقع) == 0) {
        أرجع اختيار.لا_شيء();
    };
    دع البداية: غير_موقع = عنوان_القسم + (*المكتبات)[0].موضع_إيات;
    دع النهاية: متغير غير_موقع = البداية;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*المكتبات) مثل غير_موقع)) {
        دع عدد_الرموز: غير_موقع =
            الطول((*المكتبات)[الفهرس].فهارس_الرموز) مثل غير_موقع;
        دع نهاية_المكتبة: غير_موقع = عنوان_القسم
            + (*المكتبات)[الفهرس].موضع_إيات
            + (عدد_الرموز + 1) * 8;
        لو (نهاية_المكتبة > النهاية) { النهاية := نهاية_المكتبة; };
        الفهرس := الفهرس + 1;
    }
    دع الدليل: دليل_بيانات_كوف_بي_إي = {
        العنوان: البداية,
        الحجم: النهاية - البداية
    };
    أرجع اختيار.بعض(الدليل);
}

// Data directories LLD's Writer::setDirectories derives from linked content:
// the exception table is the merged .pdata output section; the TLS directory
// is the CRT's _tls_used (IMAGE_TLS_DIRECTORY64, 40 bytes); the load
// configuration directory is _load_config_used with the size its first
// field records. Previously none was written, so an image linked with the
// MSVC CRT had no unwind table, no TLS initialization and no load
// configuration.
عرف عنوان_رمز_نسبي_كوف(
    السياق: &سياق_ربط,
    الاسم: نص,
    قاعدة_الصورة: غير_موقع
): اختيار غير_موقع {
    دع البايتات: متجه غ8 = بايتات_من_نص(الاسم);
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &البايتات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(_) -> { }
        | _ -> { أرجع اختيار.لا_شيء(); };
        طابق حل_عنوان_رمز_ربط(السياق, الرمز.المعرف) مع
        | نتيجة_حل_عنوان_ربط.نجح(العنوان) -> {
            لو (العنوان < قاعدة_الصورة) { أرجع اختيار.لا_شيء(); };
            أرجع اختيار.بعض(العنوان - قاعدة_الصورة);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عرف دليل_الخيوط_كوف(
    السياق: &سياق_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار دليل_بيانات_كوف_بي_إي {
    طابق عنوان_رمز_نسبي_كوف(السياق, «_tls_used», قاعدة_الصورة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(العنوان) -> {
        أرجع اختيار.بعض(أنشئ_دليل_بيانات_كوف(العنوان, 40));
    };
}

عرف دليل_إعدادات_التحميل_كوف(
    السياق: &سياق_ربط,
    قاعدة_الصورة: غير_موقع
): اختيار دليل_بيانات_كوف_بي_إي {
    دع الاسم: متجه غ8 = بايتات_من_نص(«_load_config_used»);
    دع العنوان: غير_موقع;
    طابق عنوان_رمز_نسبي_كوف(السياق, «_load_config_used», قاعدة_الصورة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { العنوان := القيمة; };
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.معرف(التعريف) -> {
            طابق التعريف.الموضع مع
            | موضع_تعريف_رمز_ربط.قسم(القسم, الإزاحة) -> {
                طابق ابحث_قسم_ربط_بالمعرف(السياق, القسم) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(الحقيقة) -> {
                    طابق الحقيقة.المحتوى مع
                    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                    | اختيار.بعض(المحتوى) -> {
                        طابق اقرأ_غ32_كوف(&المحتوى, الإزاحة) مع
                        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                        | اختيار.بعض(الحجم) -> {
                            لو (الإزاحة + الحجم > الحقيقة.الحجم) {
                                أرجع اختيار.لا_شيء();
                            };
                            أرجع اختيار.بعض(أنشئ_دليل_بيانات_كوف(العنوان, الحجم));
                        };
                    };
                };
            }
            | _ -> { أرجع اختيار.لا_شيء(); };
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

// Where the input sections named الاسم were laid out: one output section and
// the span from the first to the end of the last of them. With
// بالاسم_الكامل false the name is compared with each input section's base
// name (before '$'), so `.pdata$x` counts as `.pdata`. Sorting by full name
// keeps sections of one name adjacent inside their output section; parts in
// more than one output section, or interleaved with others, are متفرق.
نوع نطاق_أجزاء_كوف = {
    الفهرس: غير_موقع,
    الإزاحة: غير_موقع,
    الحجم: غير_موقع
};

نوع نتيجة_نطاق_أجزاء_كوف =
    | غائب
    | موجود بنوع نطاق_أجزاء_كوف
    | متفرق
;

عرف نطاق_أجزاء_كوف_بالاسم(
    السياق: &سياق_ربط,
    الأقسام: &متجه قسم_خرج_كوف_بي_إي,
    الاسم: نص,
    بالاسم_الكامل: منطقي
): نتيجة_نطاق_أجزاء_كوف {
    دع المطلوب: متجه غ8 = بايتات_من_نص(الاسم);
    دع النتيجة: متغير نتيجة_نطاق_أجزاء_كوف = نتيجة_نطاق_أجزاء_كوف.غائب();
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الأقسام) مثل غير_موقع)) {
        دع الأول: متغير اختيار غير_موقع = اختيار.لا_شيء();
        دع الأخير: متغير غير_موقع = 0;
        دع انقطع: متغير منطقي = خطأ;
        دع ج: متغير غير_موقع = 0;
        بينما (ج < (الطول((*الأقسام)[الفهرس].الأجزاء) مثل غير_موقع)) {
            دع معرف_القسم: غير_موقع = (*الأقسام)[الفهرس].الأجزاء[ج].القسم.القيمة;
            دع مطابق: متغير منطقي = خطأ;
            لو (بالاسم_الكامل) {
                مطابق := متجها_بايتات_متساويان(
                    &(*السياق).الأقسام[معرف_القسم].الاسم.اسم_القسم,
                    &المطلوب
                );
            } وإلا {
                دع الأساس: متجه غ8 = اسم_أساس_قسم_كوف(
                    &(*السياق).الأقسام[معرف_القسم].الاسم.اسم_القسم
                );
                مطابق := متجها_بايتات_متساويان(&الأساس, &المطلوب);
            };
            لو (مطابق) {
                طابق الأول مع
                | اختيار.لا_شيء -> { الأول := اختيار.بعض(ج); }
                | اختيار.بعض(_) -> {
                    لو (الأخير + 1 != ج) { انقطع := صواب; };
                };
                الأخير := ج;
            };
            ج := ج + 1;
        }
        طابق الأول مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(البداية) -> {
            لو (انقطع) { أرجع نتيجة_نطاق_أجزاء_كوف.متفرق(); };
            طابق النتيجة مع
            | نتيجة_نطاق_أجزاء_كوف.غائب -> { }
            | _ -> { أرجع نتيجة_نطاق_أجزاء_كوف.متفرق(); };
            دع الإزاحة: غير_موقع = (*الأقسام)[الفهرس].الأجزاء[البداية].الإزاحة;
            دع النهاية: غير_موقع = (*الأقسام)[الفهرس].الأجزاء[الأخير].الإزاحة
                + (*الأقسام)[الفهرس].الأجزاء[الأخير].الحجم;
            دع النطاق: نطاق_أجزاء_كوف = {
                الفهرس: الفهرس,
                الإزاحة: الإزاحة,
                الحجم: النهاية - الإزاحة
            };
            النتيجة := نتيجة_نطاق_أجزاء_كوف.موجود(النطاق);
        };
        الفهرس := الفهرس + 1;
    }
    أرجع النتيجة;
}

// The exception table must be sorted by function start RVA, as Windows
// looks entries up by binary search (LLD sortExceptionTable): x64
// RUNTIME_FUNCTION entries are 12 bytes, ARM64 entries 8 bytes, each starting
// with the function's begin RVA. Concatenating several objects' .pdata in
// input order does not keep that order once grouped .text sections are
// sorted, so the applied table is sorted in the image.
عرف رتب_جدول_الاستثناءات_كوف(
    الصورة: &متغير متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع,
    حجم_المدخل: غير_موقع
): منطقي {
    لو ((الحجم % حجم_المدخل) != 0) { أرجع خطأ; };
    لو (الموضع + الحجم > (الطول(*الصورة) مثل غير_موقع)) { أرجع خطأ; };
    دع العدد: غير_موقع = الحجم / حجم_المدخل;
    دع الترتيب: متغير متجه غير_موقع = [];
    دع المفاتيح: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع المفتاح: غير_موقع;
        طابق اقرأ_غ32_كوف(الصورة, الموضع + ف * حجم_المدخل) مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(القيمة) -> { المفتاح := القيمة; };
        ألحق(المفاتيح, المفتاح);
        ألحق(الترتيب, ف);
        دع ع: متغير غير_موقع = ف;
        دع مستمر: متغير منطقي = صواب;
        بينما (ع > 0 && مستمر) {
            دع السابق: غير_موقع = الترتيب[ع - 1];
            لو (المفاتيح[السابق] > المفتاح) {
                الترتيب[ع] := السابق;
                ع := ع - 1;
            } وإلا {
                مستمر := خطأ;
            };
        }
        الترتيب[ع] := ف;
        ف := ف + 1;
    }
    دع النسخة: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < الحجم) {
        ألحق(النسخة, (*الصورة)[الموضع + ف]);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < العدد) {
        دع المصدر: غير_موقع = الترتيب[ف] * حجم_المدخل;
        دع ب: متغير غير_موقع = 0;
        بينما (ب < حجم_المدخل) {
            (*الصورة)[الموضع + ف * حجم_المدخل + ب] := النسخة[المصدر + ب];
            ب := ب + 1;
        }
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابن_صورة_كوف_بي_إي(
    السياق: &متغير سياق_ربط,
    مشترك: منطقي
): نتيجة_صورة_كوف_بي_إي {
    لو ((*السياق).الهدف.المنصة.المنصة != هوية_منصة.ويندوز()) {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.هدف_غير_مدعوم()
        );
    };
    دع الآلة: غير_موقع;
    طابق آلة_كوف_للهدف(&(*السياق).الهدف) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.هدف_غير_مدعوم()
        );
    }
    | اختيار.بعض(القيمة) -> { الآلة := القيمة; };
    دع قاعدة_الصورة: غير_موقع = 0x140000000;
    // Every image-shaping directive of the loaded objects, read once.
    دع التوجيهات: توجيهات_قسم_كوف = اجمع_توجيهات_أقسام_كوف(&(*السياق).الأقسام);
    دع الصادرات: متجه تصدير_صورة_كوف;
    طابق اجمع_صادرات_كوف(السياق, &التوجيهات, مشترك) مع
    | اختيار.لا_شيء -> {
        دع لا_اسم: متجه غ8 = [];
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.رمز_خارجي_غير_محلول(لا_اسم)
        );
    }
    | اختيار.بعض(القيمة) -> { الصادرات := القيمة; };
    دع يصدر: منطقي = مشترك || (الطول(الصادرات) مثل غير_موقع) > 0;
    دع الأقسام: متغير متجه قسم_خرج_كوف_بي_إي = [];
    لو (!أضف_الأقسام_القانونية_إلى_صورة_كوف(السياق, &التوجيهات, &متغير الأقسام)) {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
        );
    };
    دع الرموز_الديناميكية: متغير متجه رمز_استيراد_كوف_بي_إي;
    طابق اجمع_رموز_استيراد_كوف(السياق) مع
    | اختيار.لا_شيء -> {
        دع لا_اسم: متجه غ8 = [];
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.رمز_خارجي_غير_محلول(لا_اسم)
        );
    }
    | اختيار.بعض(القيمة) -> { الرموز_الديناميكية := القيمة; };
    دع المكتبات: متغير متجه مكتبة_استيراد_كوف_بي_إي;
    طابق اجمع_مكتبات_استيراد_كوف(السياق, &الرموز_الديناميكية) مع
    | اختيار.لا_شيء -> {
        دع لا_اسم: متجه غ8 = [];
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.رمز_خارجي_غير_محلول(لا_اسم)
        );
    }
    | اختيار.بعض(القيمة) -> { المكتبات := القيمة; };
    دع فهرس_استيراد: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع فهرس_ستبات: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع فهرس_تصدير: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع فهرس_إعادة: متغير اختيار غير_موقع = اختيار.لا_شيء();
    لو ((الطول(الرموز_الديناميكية) مثل غير_موقع) > 0) {
        فهرس_ستبات := اختيار.بعض(أضف_قسم_مصطنع_كوف(
            &متغير الأقسام,
            اسم_قسم_ستبات_كوف(),
            (الطول(الرموز_الديناميكية) مثل غير_موقع)
                * حجم_ستب_استيراد_كوف(&(*السياق).الهدف),
            0x60000020
        ));
        فهرس_استيراد := اختيار.بعض(أضف_قسم_مصطنع_كوف(
            &متغير الأقسام,
            اسم_قسم_استيراد_كوف(),
            0,
            0xC0000040
        ));
    };
    لو (يصدر) {
        فهرس_تصدير := اختيار.بعض(أضف_قسم_مصطنع_كوف(
            &متغير الأقسام,
            اسم_قسم_تصدير_كوف(),
            0,
            0x40000040
        ));
    };
    دع يحتاج_إعادة: منطقي = (الطول((*السياق).الإزاحات) مثل غير_موقع) > 0;
    لو (يحتاج_إعادة) {
        فهرس_إعادة := اختيار.بعض(أضف_قسم_مصطنع_كوف(
            &متغير الأقسام,
            اسم_قسم_إعادة_تموضع_كوف(),
            (الطول((*السياق).الإزاحات) مثل غير_موقع) * 12 + 16,
            0x42000040
        ));
    };
    لو ((الطول(الأقسام) مثل غير_موقع) > 96) {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
        );
    };
    // /SECTION:<name>,<attributes> replaces the memory attributes of every
    // output section with that name (LLD Writer::setSectionPermissions,
    // OutputSection::setPermissions with the IMAGE_SCN_MEM_* mask 0xFE000000).
    دع فهرس_الصلاحية: متغير غير_موقع = 0;
    بينما (فهرس_الصلاحية < (الطول(التوجيهات.الأقسام) مثل غير_موقع)) {
        دع ق: متغير غير_موقع = 0;
        بينما (ق < (الطول(الأقسام) مثل غير_موقع)) {
            لو (متجها_اسم_كوف_متساويان(
                &الأقسام[ق].الاسم,
                &التوجيهات.الأقسام[فهرس_الصلاحية].الاسم
            )) {
                الأقسام[ق].الخصائص := (الأقسام[ق].الخصائص & 0x01FFFFFF)
                    | التوجيهات.الأقسام[فهرس_الصلاحية].الخصائص;
            };
            ق := ق + 1;
        }
        فهرس_الصلاحية := فهرس_الصلاحية + 1;
    }
    دع حجم_الرؤوس_الخام: غير_موقع = (0x80 مثل غير_موقع)
        + (4 مثل غير_موقع) + (20 مثل غير_موقع) + (240 مثل غير_موقع)
        + (الطول(الأقسام) مثل غير_موقع) * (40 مثل غير_موقع);
    دع حجم_الرؤوس: غير_موقع = حاذ_قيمة_كوف_بي_إي(
        حجم_الرؤوس_الخام,
        0x200 مثل غير_موقع
    );
    ضع_أقسام_صورة_كوف(&متغير الأقسام, حجم_الرؤوس);
    ثبت_تخطيط_كوف_في_السياق(السياق, &الأقسام, قاعدة_الصورة);

    طابق فهرس_استيراد مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        دع المحتوى: متجه غ8 = ابن_قسم_استيراد_كوف(
            الأقسام[الفهرس].العنوان_النسبي,
            &متغير الرموز_الديناميكية,
            &متغير المكتبات
        );
        دع حجم_المحتوى: غير_موقع = الطول(المحتوى) مثل غير_موقع;
        الأقسام[الفهرس].المحتوى := المحتوى;
        الأقسام[الفهرس].الحجم_الافتراضي := حجم_المحتوى;
    };
    طابق فهرس_ستبات مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        طابق ابن_ستبات_استيراد_كوف(
            &(*السياق).الهدف,
            قاعدة_الصورة,
            الأقسام[الفهرس].العنوان_النسبي,
            &متغير الرموز_الديناميكية
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(المحتوى) -> {
            دع حجم_المحتوى: غير_موقع = الطول(المحتوى) مثل غير_موقع;
            الأقسام[الفهرس].المحتوى := المحتوى;
            الأقسام[الفهرس].الحجم_الافتراضي := حجم_المحتوى;
        };
    };
    دع دليل_تصدير: متغير اختيار دليل_تصدير_كوف_بي_إي = اختيار.لا_شيء();
    لو (يصدر) {
        طابق فهرس_تصدير مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الفهرس) -> {
            دع الدليل: دليل_تصدير_كوف_بي_إي = ابن_دليل_تصدير_كوف(
                السياق,
                &الصادرات,
                الأقسام[الفهرس].العنوان_النسبي
            );
            دع بايتات_التصدير: متجه غ8 = انسخ_متجه_بايتات_كوف_بي_إي(
                &الدليل.البايتات
            );
            دع حجم_التصدير: غير_موقع = الطول(بايتات_التصدير) مثل غير_موقع;
            الأقسام[الفهرس].المحتوى := بايتات_التصدير;
            الأقسام[الفهرس].الحجم_الافتراضي := حجم_التصدير;
            دليل_تصدير := اختيار.بعض(الدليل);
        };
    };
    دع إعادات_التموضع: متغير متجه إدخال_إعادة_تموضع_كوف =
        اجمع_إعادات_تموضع_كوف(السياق, &الأقسام);
    رتب_إعادات_تموضع_كوف(&متغير إعادات_التموضع);
    طابق فهرس_إعادة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        دع المحتوى: متجه غ8 = ابن_قسم_إعادة_تموضع_كوف(
            &إعادات_التموضع
        );
        دع حجم_المحتوى: غير_موقع = الطول(المحتوى) مثل غير_موقع;
        الأقسام[الفهرس].المحتوى := المحتوى;
        الأقسام[الفهرس].الحجم_الافتراضي := حجم_المحتوى;
    };

    // Re-layout once synthetic contents have their exact sizes.
    دع حجم_الصورة: غير_موقع = ضع_أقسام_صورة_كوف(
        &متغير الأقسام,
        حجم_الرؤوس
    );
    ثبت_تخطيط_كوف_في_السياق(السياق, &الأقسام, قاعدة_الصورة);
    // Rebuild RVA-bearing synthetic content after the final placement.
    طابق فهرس_استيراد مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        الأقسام[الفهرس].المحتوى := ابن_قسم_استيراد_كوف(
            الأقسام[الفهرس].العنوان_النسبي,
            &متغير الرموز_الديناميكية,
            &متغير المكتبات
        );
    };
    طابق فهرس_ستبات مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        طابق ابن_ستبات_استيراد_كوف(
            &(*السياق).الهدف,
            قاعدة_الصورة,
            الأقسام[الفهرس].العنوان_النسبي,
            &متغير الرموز_الديناميكية
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        }
        | اختيار.بعض(المحتوى) -> { الأقسام[الفهرس].المحتوى := المحتوى; };
    };
    لو (يصدر) {
        طابق دليل_تصدير مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الدليل_القديم) -> {
            طابق فهرس_تصدير مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الفهرس) -> {
                دع الدليل: متغير دليل_تصدير_كوف_بي_إي =
                    ابن_دليل_تصدير_كوف(
                        السياق,
                        &الصادرات,
                        الأقسام[الفهرس].العنوان_النسبي
                    );
                لو (!ثبت_عناوين_تصدير_كوف(
                    السياق,
                    &متغير الدليل,
                    قاعدة_الصورة
                )) {
                    أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                        خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
                    );
                };
                دع بايتات_التصدير: متجه غ8 = انسخ_متجه_بايتات_كوف_بي_إي(
                    &الدليل.البايتات
                );
                الأقسام[الفهرس].المحتوى := بايتات_التصدير;
                دليل_تصدير := اختيار.بعض(الدليل);
            };
        };
    };
    إعادات_التموضع := اجمع_إعادات_تموضع_كوف(السياق, &الأقسام);
    رتب_إعادات_تموضع_كوف(&متغير إعادات_التموضع);
    طابق فهرس_إعادة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الفهرس) -> {
        الأقسام[الفهرس].المحتوى := ابن_قسم_إعادة_تموضع_كوف(
            &إعادات_التموضع
        );
    };

    دع عنوان_الدخول: متغير غير_موقع = 0;
    لو (!مشترك) {
        طابق حل_عنوان_دخول_كوف(السياق, قاعدة_الصورة) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.رمز_دخول_مفقود()
            );
        }
        | اختيار.بعض(القيمة) -> { عنوان_الدخول := القيمة; };
    };

    دع الصورة: متغير متجه غ8 = [];
    ألحق_صفرا_كوف_بي_إي(&متغير الصورة, 0x80);
    الصورة[0] := 0x4D;
    الصورة[1] := 0x5A;
    اكتب_غ32_كوف_في(&متغير الصورة, 0x3C, 0x80);
    ألحق_غ32_كوف(&متغير الصورة, 0x00004550);
    ألحق_غ16_كوف(&متغير الصورة, الآلة);
    ألحق_غ16_كوف(&متغير الصورة, الطول(الأقسام) مثل غير_موقع);
    ألحق_غ32_كوف(&متغير الصورة, 0);
    ألحق_غ32_كوف(&متغير الصورة, 0);
    ألحق_غ32_كوف(&متغير الصورة, 0);
    ألحق_غ16_كوف(&متغير الصورة, 240);
    دع خصائص_الملف: متغير غير_موقع = 0x0022;
    لو (مشترك) { خصائص_الملف := خصائص_الملف | 0x2000; };
    ألحق_غ16_كوف(&متغير الصورة, خصائص_الملف);

    دع دليل_التصدير_النهائي: اختيار دليل_بيانات_كوف_بي_إي;
    طابق فهرس_تصدير مع
    | اختيار.لا_شيء -> { دليل_التصدير_النهائي := اختيار.لا_شيء(); }
    | اختيار.بعض(الفهرس) -> {
        دليل_التصدير_النهائي := اختيار.بعض(
            أنشئ_دليل_بيانات_كوف(
                الأقسام[الفهرس].العنوان_النسبي,
                الطول(الأقسام[الفهرس].المحتوى) مثل غير_موقع
            )
        );
    };
    دع دليل_الاستيراد_النهائي: اختيار دليل_بيانات_كوف_بي_إي;
    دع دليل_إيات_النهائي: اختيار دليل_بيانات_كوف_بي_إي;
    طابق فهرس_استيراد مع
    | اختيار.لا_شيء -> {
        // Long-form import members (.idata$2 descriptors, .idata$4 lookup
        // tables, .idata$5 address tables, .idata$6 hint/names, .idata$7
        // DLL names) are ordinary sections grouped into .idata in suffix
        // order. As LLD's Writer::locateImportTables, the import directory
        // spans the .idata$2 descriptors (the terminating null descriptor is
        // the .idata$3 that follows them) and the IAT directory spans the
        // .idata$5 tables.
        طابق نطاق_أجزاء_كوف_بالاسم(السياق, &الأقسام, «.idata$2», صواب) مع
        | نتيجة_نطاق_أجزاء_كوف.غائب -> { دليل_الاستيراد_النهائي := اختيار.لا_شيء(); }
        | نتيجة_نطاق_أجزاء_كوف.متفرق -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        }
        | نتيجة_نطاق_أجزاء_كوف.موجود(النطاق) -> {
            دليل_الاستيراد_النهائي := اختيار.بعض(أنشئ_دليل_بيانات_كوف(
                الأقسام[النطاق.الفهرس].العنوان_النسبي + النطاق.الإزاحة,
                النطاق.الحجم
            ));
        };
        طابق نطاق_أجزاء_كوف_بالاسم(السياق, &الأقسام, «.idata$5», صواب) مع
        | نتيجة_نطاق_أجزاء_كوف.غائب -> { دليل_إيات_النهائي := اختيار.لا_شيء(); }
        | نتيجة_نطاق_أجزاء_كوف.متفرق -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        }
        | نتيجة_نطاق_أجزاء_كوف.موجود(النطاق) -> {
            دليل_إيات_النهائي := اختيار.بعض(أنشئ_دليل_بيانات_كوف(
                الأقسام[النطاق.الفهرس].العنوان_النسبي + النطاق.الإزاحة,
                النطاق.الحجم
            ));
        };
    }
    | اختيار.بعض(الفهرس) -> {
        // The synthetic import table of short import members is one
        // contiguous directory; long-form descriptors elsewhere in the image
        // cannot be described by the same import directory entry.
        طابق نطاق_أجزاء_كوف_بالاسم(السياق, &الأقسام, «.idata$2», صواب) مع
        | نتيجة_نطاق_أجزاء_كوف.غائب -> { }
        | _ -> {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        };
        دليل_الاستيراد_النهائي := اختيار.بعض(
            أنشئ_دليل_بيانات_كوف(
                الأقسام[الفهرس].العنوان_النسبي,
                (الطول(المكتبات) مثل غير_موقع + 1) * 20
            )
        );
        دليل_إيات_النهائي := مؤشر_إيات_كوف(
            &المكتبات,
            الأقسام[الفهرس].العنوان_النسبي
        );
    };
    دع دليل_إعادة_التموضع_النهائي: اختيار دليل_بيانات_كوف_بي_إي;
    طابق فهرس_إعادة مع
    | اختيار.لا_شيء -> {
        دليل_إعادة_التموضع_النهائي := اختيار.لا_شيء();
    }
    | اختيار.بعض(الفهرس) -> {
        لو ((الطول(الأقسام[الفهرس].المحتوى) مثل غير_موقع) == 0) {
            دليل_إعادة_التموضع_النهائي := اختيار.لا_شيء();
        } وإلا {
            دليل_إعادة_التموضع_النهائي := اختيار.بعض(
                أنشئ_دليل_بيانات_كوف(
                    الأقسام[الفهرس].العنوان_النسبي,
                    الطول(الأقسام[الفهرس].المحتوى) مثل غير_موقع
                )
            );
        };
    };
    // The exception directory spans the .pdata input sections wherever
    // they were laid out (also after a /MERGE).
    دع دليل_الاستثناءات_النهائي: متغير اختيار دليل_بيانات_كوف_بي_إي =
        اختيار.لا_شيء();
    دع نطاق_الاستثناءات: متغير اختيار نطاق_أجزاء_كوف = اختيار.لا_شيء();
    طابق نطاق_أجزاء_كوف_بالاسم(السياق, &الأقسام, «.pdata», خطأ) مع
    | نتيجة_نطاق_أجزاء_كوف.غائب -> { }
    | نتيجة_نطاق_أجزاء_كوف.متفرق -> {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
        );
    }
    | نتيجة_نطاق_أجزاء_كوف.موجود(النطاق) -> {
        لو (النطاق.الحجم > 0) {
            دليل_الاستثناءات_النهائي := اختيار.بعض(أنشئ_دليل_بيانات_كوف(
                الأقسام[النطاق.الفهرس].العنوان_النسبي + النطاق.الإزاحة,
                النطاق.الحجم
            ));
            نطاق_الاستثناءات := اختيار.بعض(النطاق);
        };
    };
    اكتب_رأس_اختياري_بي_إي64(
        &متغير الصورة,
        &الأقسام,
        قاعدة_الصورة,
        عنوان_الدخول,
        حجم_الصورة,
        حجم_الرؤوس,
        مشترك,
        دليل_التصدير_النهائي,
        دليل_الاستيراد_النهائي,
        دليل_إعادة_التموضع_النهائي,
        دليل_إيات_النهائي,
        دليل_الاستثناءات_النهائي,
        دليل_الخيوط_كوف(السياق, قاعدة_الصورة),
        دليل_إعدادات_التحميل_كوف(السياق, قاعدة_الصورة),
        &التوجيهات
    );
    دع فهرس_القسم: متغير غير_موقع = 0;
    بينما (فهرس_القسم < (الطول(الأقسام) مثل غير_موقع)) {
        ألحق_رأس_قسم_صورة_كوف(&متغير الصورة, &الأقسام[فهرس_القسم]);
        فهرس_القسم := فهرس_القسم + 1;
    }
    لو (!أكمل_كوف_بي_إي_إلى(&متغير الصورة, حجم_الرؤوس)) {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
            خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
        );
    };
    فهرس_القسم := 0;
    بينما (فهرس_القسم < (الطول(الأقسام) مثل غير_موقع)) {
        لو (الأقسام[فهرس_القسم].حجم_الملف > 0) {
            لو (!أكمل_كوف_بي_إي_إلى(
                &متغير الصورة,
                الأقسام[فهرس_القسم].موضع_الملف
            )) {
                أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                    خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
                );
            };
            دع موضع_بايت: متغير غير_موقع = 0;
            بينما (
                موضع_بايت
                    < (الطول(الأقسام[فهرس_القسم].المحتوى) مثل غير_موقع)
            ) {
                ألحق(
                    الصورة,
                    الأقسام[فهرس_القسم].المحتوى[موضع_بايت]
                );
                موضع_بايت := موضع_بايت + 1;
            }
            ألحق_صفرا_كوف_بي_إي(
                &متغير الصورة,
                الأقسام[فهرس_القسم].حجم_الملف
                    - (الطول(الأقسام[فهرس_القسم].المحتوى) مثل غير_موقع)
            );
        };
        فهرس_القسم := فهرس_القسم + 1;
    }
    طابق طبق_إزاحات_صورة_كوف(
        &متغير الصورة,
        السياق,
        &الأقسام,
        &الرموز_الديناميكية,
        قاعدة_الصورة
    ) مع
    | نتيجة_صورة_كوف_بي_إي.نجح(_) -> { }
    | نتيجة_صورة_كوف_بي_إي.خطأ(الخطأ) -> {
        أرجع نتيجة_صورة_كوف_بي_إي.خطأ(الخطأ);
    };
    طابق نطاق_الاستثناءات مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(النطاق) -> {
        دع حجم_المدخل: متغير غير_موقع = 12;
        لو ((*السياق).الهدف.المعمارية.الهوية == هوية_معمارية.ذراع_أربعة_وستون()) {
            حجم_المدخل := 8;
        };
        لو (!رتب_جدول_الاستثناءات_كوف(
            &متغير الصورة,
            الأقسام[النطاق.الفهرس].موضع_الملف + النطاق.الإزاحة,
            النطاق.الحجم,
            حجم_المدخل
        )) {
            أرجع نتيجة_صورة_كوف_بي_إي.خطأ(
                خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح()
            );
        };
    };
    // /RELEASE: the optional header's CheckSum (at 0x80 + 24 + 64) is the
    // image checksum, computed last over the finished image.
    لو (التوجيهات.مجموع_التحقق) {
        اكتب_مجموع_تحقق_صورة_كوف(&متغير الصورة, 0xD8 مثل غير_موقع);
    };
    أرجع نتيجة_صورة_كوف_بي_إي.نجح(الصورة);
}

// The PE image checksum (LLD Writer::writeCheckSum, the algorithm of
// imagehlp's CheckSumMappedFile): the 16-bit little-endian words of the file,
// excluding the CheckSum field itself, are summed with the carry folded back
// after every addition, a trailing odd byte is added as a word, and the file
// size is added to the folded 16-bit sum.
عرف اكتب_مجموع_تحقق_صورة_كوف(
    الصورة: &متغير متجه غ8,
    موضع_الحقل: غير_موقع
): فراغ {
    دع الحجم: غير_موقع = الطول(*الصورة) مثل غير_موقع;
    دع المجموع: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف + 1 < الحجم) {
        لو (ف != موضع_الحقل && ف != موضع_الحقل + 2) {
            المجموع := المجموع + ((*الصورة)[ف] مثل غير_موقع)
                + ((*الصورة)[ف + 1] مثل غير_موقع) * 256;
            المجموع := (المجموع & 0xFFFF) + (المجموع / 65536);
        };
        ف := ف + 2;
    }
    لو ((الحجم % 2) == 1) {
        المجموع := المجموع + ((*الصورة)[الحجم - 1] مثل غير_موقع);
        المجموع := (المجموع & 0xFFFF) + (المجموع / 65536);
    };
    المجموع := (المجموع & 0xFFFF) + (المجموع / 65536);
    اكتب_غ32_كوف_في(الصورة, موضع_الحقل, المجموع + الحجم);
}

عام عرف ابن_صورة_كوف_ويندوز_تنفيذية(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_كوف_بي_إي {
    أرجع ابن_صورة_كوف_بي_إي(السياق, خطأ);
}

عام عرف ابن_صورة_كوف_ويندوز_مشتركة(
    السياق: &متغير سياق_ربط
): نتيجة_صورة_كوف_بي_إي {
    أرجع ابن_صورة_كوف_بي_إي(السياق, صواب);
}
