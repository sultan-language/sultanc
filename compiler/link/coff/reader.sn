استورد std.encoding.binary;
// Microsoft COFF/PE byte reader. All fields used here are little-endian.

عرف بايت_كوف_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام عرف ضمن_حدود_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_ط16_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري طبيعي {
    إذا (!ضمن_حدود_كوف(البايتات, الموضع, 2)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(
        ((*البايتات)[الموضع] مثل طبيعي)
            + (بايت_كوف_عند(البايتات, الموضع + 1) مثل طبيعي) * 256
    );
}

عام عرف اقرأ_ط32_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري طبيعي {
    إذا (!ضمن_حدود_كوف(البايتات, الموضع, 4)) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(
        ((*البايتات)[الموضع] مثل طبيعي)
            + (بايت_كوف_عند(البايتات, الموضع + 1) مثل طبيعي) * 256
            + (بايت_كوف_عند(البايتات, الموضع + 2) مثل طبيعي) * 65536
            + (بايت_كوف_عند(البايتات, الموضع + 3) مثل طبيعي) * 16777216
    );
}

عام عرف اقرأ_ص32_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري عدد {
    دع القيمة: طبيعي;
    طابق اقرأ_ط32_كوف(البايتات, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقروء) -> { القيمة := المقروء; };
    إذا (القيمة <= 0x7FFFFFFF) {
        أرجع اختياري.موجود(القيمة مثل عدد);
    };
    أرجع اختياري.موجود(-((0x100000000 - القيمة) مثل عدد));
}

عام عرف اقرأ_ط64_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري طبيعي {
    دع المنخفض: طبيعي;
    دع العالي: طبيعي;
    طابق اقرأ_ط32_كوف(البايتات, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المنخفض := القيمة; };
    طابق اقرأ_ط32_كوف(البايتات, الموضع + 4) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { العالي := القيمة; };
    أرجع اختياري.موجود(المنخفض + العالي * 4294967296);
}

عام عرف اقرأ_ص16_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري عدد {
    دع القيمة: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقروء) -> { القيمة := المقروء; };
    إذا (القيمة < 0x8000) { أرجع اختياري.موجود(القيمة مثل عدد); };
    أرجع اختياري.موجود(-((0x10000 - القيمة) مثل عدد));
}

عام عرف انسخ_بايتات_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): اختياري متجه ط8 {
    إذا (!ضمن_حدود_كوف(البايتات, الموضع, الحجم)) {
        أرجع اختياري.لا_شيء();
    };
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < الحجم) {
        ألحق(الناتج, بايت_كوف_عند(البايتات, الموضع + الفهرس));
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عام عرف اقرأ_اسم_ثابت_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحد: طبيعي
): اختياري متجه ط8 {
    إذا (!ضمن_حدود_كوف(البايتات, الموضع, الحد)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (الفهرس < الحد && مستمر) {
        دع البايت: ط8 = بايت_كوف_عند(البايتات, الموضع + الفهرس);
        إذا (البايت == 0) {
            مستمر := خطأ;
        } وإلا {
            ألحق(الاسم, البايت);
            الفهرس := الفهرس + 1;
        };
    }
    أرجع اختياري.موجود(الاسم);
}

عام عرف اقرأ_اسم_صفري_كوف(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري متجه ط8 {
    إذا (الموضع >= النهاية
        || النهاية > (الطول(*البايتات) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = الموضع;
    طالما (الفهرس < النهاية) {
        دع البايت: ط8 = (*البايتات)[الفهرس];
        إذا (البايت == 0) { أرجع اختياري.موجود(الاسم); };
        ألحق(الاسم, البايت);
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ألحق_ط16_كوف(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط16_بالبايت_الأقل_أهمية_أولا(الناتج, (القيمة & 0xFFFF) مثل ط16);
}

عام عرف ألحق_ط32_كوف(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط32_بالبايت_الأقل_أهمية_أولا(الناتج, (القيمة & 0xFFFFFFFF) مثل ط32);
}

عام عرف ألحق_ط64_كوف(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    اكتب_ط64_بالبايت_الأقل_أهمية_أولا(الناتج, القيمة مثل ط64);
}

عام عرف اكتب_ط16_كوف_في(
    الناتج: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (الموضع + 2 > (الطول(*الناتج) مثل طبيعي)) { أرجع خطأ; };
    (*الناتج)[الموضع] := (القيمة & 0xFF) مثل ط8;
    دع الموضع_الثاني: طبيعي = الموضع + 1;
    (*الناتج)[الموضع_الثاني] := ((القيمة >> 8) & 0xFF) مثل ط8;
    أرجع صواب;
}

عام عرف اكتب_ط32_كوف_في(
    الناتج: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (!اكتب_ط16_كوف_في(الناتج, الموضع, القيمة & 0xFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_ط16_كوف_في(
        الناتج,
        الموضع + 2,
        (القيمة >> 16) & 0xFFFF
    );
}

عام عرف اكتب_ط64_كوف_في(
    الناتج: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): منطقي {
    إذا (!اكتب_ط32_كوف_في(الناتج, الموضع, القيمة & 0xFFFFFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_ط32_كوف_في(
        الناتج,
        الموضع + 4,
        (القيمة >> 32) & 0xFFFFFFFF
    );
}
