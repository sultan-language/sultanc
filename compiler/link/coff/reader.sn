// Microsoft COFF/PE byte reader. All fields used here are little-endian.

عرف بايت_كوف_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام عرف ضمن_حدود_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام عرف اقرأ_غ16_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار غير_موقع {
    لو (!ضمن_حدود_كوف(البايتات, الموضع, 2)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(
        ((*البايتات)[الموضع] مثل غير_موقع)
            + (بايت_كوف_عند(البايتات, الموضع + 1) مثل غير_موقع) * 256
    );
}

عام عرف اقرأ_غ32_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار غير_موقع {
    لو (!ضمن_حدود_كوف(البايتات, الموضع, 4)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(
        ((*البايتات)[الموضع] مثل غير_موقع)
            + (بايت_كوف_عند(البايتات, الموضع + 1) مثل غير_موقع) * 256
            + (بايت_كوف_عند(البايتات, الموضع + 2) مثل غير_موقع) * 65536
            + (بايت_كوف_عند(البايتات, الموضع + 3) مثل غير_موقع) * 16777216
    );
}

عام عرف اقرأ_ص32_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار عدد {
    دع القيمة: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المقروء) -> { القيمة := المقروء; };
    لو (القيمة <= 0x7FFFFFFF) {
        أرجع اختيار.بعض(القيمة مثل عدد);
    };
    أرجع اختيار.بعض(-((0x100000000 - القيمة) مثل عدد));
}

عام عرف اقرأ_غ64_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار غير_موقع {
    دع المنخفض: غير_موقع;
    دع العالي: غير_موقع;
    طابق اقرأ_غ32_كوف(البايتات, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { المنخفض := القيمة; };
    طابق اقرأ_غ32_كوف(البايتات, الموضع + 4) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { العالي := القيمة; };
    أرجع اختيار.بعض(المنخفض + العالي * 4294967296);
}

عام عرف اقرأ_ص16_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار عدد {
    دع القيمة: غير_موقع;
    طابق اقرأ_غ16_كوف(البايتات, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المقروء) -> { القيمة := المقروء; };
    لو (القيمة < 0x8000) { أرجع اختيار.بعض(القيمة مثل عدد); };
    أرجع اختيار.بعض(-((0x10000 - القيمة) مثل عدد));
}

عام عرف انسخ_بايتات_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): اختيار متجه غ8 {
    لو (!ضمن_حدود_كوف(البايتات, الموضع, الحجم)) {
        أرجع اختيار.لا_شيء();
    };
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحجم) {
        ألحق(الناتج, بايت_كوف_عند(البايتات, الموضع + الفهرس));
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام عرف اقرأ_اسم_ثابت_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحد: غير_موقع
): اختيار متجه غ8 {
    لو (!ضمن_حدود_كوف(البايتات, الموضع, الحد)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (الفهرس < الحد && مستمر) {
        دع البايت: غ8 = بايت_كوف_عند(البايتات, الموضع + الفهرس);
        لو (البايت == 0) {
            مستمر := خطأ;
        } وإلا {
            ألحق(الاسم, البايت);
            الفهرس := الفهرس + 1;
        };
    }
    أرجع اختيار.بعض(الاسم);
}

عام عرف اقرأ_اسم_صفري_كوف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (الموضع >= النهاية
        || النهاية > (الطول(*البايتات) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = الموضع;
    بينما (الفهرس < النهاية) {
        دع البايت: غ8 = (*البايتات)[الفهرس];
        لو (البايت == 0) { أرجع اختيار.بعض(الاسم); };
        ألحق(الاسم, البايت);
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ألحق_غ16_كوف(
    الناتج: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق(*الناتج, (القيمة & 0xFF) مثل غ8);
    ألحق(*الناتج, ((القيمة >> 8) & 0xFF) مثل غ8);
}

عام عرف ألحق_غ32_كوف(
    الناتج: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق_غ16_كوف(الناتج, القيمة & 0xFFFF);
    ألحق_غ16_كوف(الناتج, (القيمة >> 16) & 0xFFFF);
}

عام عرف ألحق_غ64_كوف(
    الناتج: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    ألحق_غ32_كوف(الناتج, القيمة & 0xFFFFFFFF);
    ألحق_غ32_كوف(الناتج, (القيمة >> 32) & 0xFFFFFFFF);
}

عام عرف اكتب_غ16_كوف_في(
    الناتج: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (الموضع + 2 > (الطول(*الناتج) مثل غير_موقع)) { أرجع خطأ; };
    (*الناتج)[الموضع] := (القيمة & 0xFF) مثل غ8;
    دع الموضع_الثاني: غير_موقع = الموضع + 1;
    (*الناتج)[الموضع_الثاني] := ((القيمة >> 8) & 0xFF) مثل غ8;
    أرجع صواب;
}

عام عرف اكتب_غ32_كوف_في(
    الناتج: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (!اكتب_غ16_كوف_في(الناتج, الموضع, القيمة & 0xFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_غ16_كوف_في(
        الناتج,
        الموضع + 2,
        (القيمة >> 16) & 0xFFFF
    );
}

عام عرف اكتب_غ64_كوف_في(
    الناتج: &متغير متجه غ8,
    الموضع: غير_موقع,
    القيمة: غير_موقع
): منطقي {
    لو (!اكتب_غ32_كوف_في(الناتج, الموضع, القيمة & 0xFFFFFFFF)) {
        أرجع خطأ;
    };
    أرجع اكتب_غ32_كوف_في(
        الناتج,
        الموضع + 4,
        (القيمة >> 32) & 0xFFFFFFFF
    );
}
