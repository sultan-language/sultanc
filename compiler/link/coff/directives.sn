استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.section_model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.link.reachability;
استورد compiler.link.resolution;
استورد compiler.link.input_ingest;
استورد compiler.link.coff.directive_syntax;
استورد compiler.link.coff.object_ingest;
استورد std.text.from_bytes;
استورد std.text.compare;

// COFF input completion: the `.drectve` directives (coff/directive_syntax.sn)
// and weak aliases that decide which inputs and definitions an image
// contains, applied as LLD's LinkerDriver::parseDirectives and
// SymbolTable::resolveRemainingUndefines do:
//
//   /DEFAULTLIB, /NODEFAULTLIB  accepted without effect. SultanC links no C
//                            runtime and loads no library it was not given:
//                            the libraries an object names (the MSVC C
//                            runtime's libcmt.lib, ucrt.lib, msvcrt.lib,
//                            oldnames.lib, the SDK's kernel32.lib) are never
//                            searched for. A function whose declaration
//                            names its DLL is imported without an import
//                            library (استورد_رموز_مصرحة_كوف_في_السياق below);
//   /INCLUDE:<sym>           <sym> is a required undefined symbol and a
//                            liveness root;
//   /EXPORT:<name>[=<sym>]   <sym> is required and a liveness root, like
//                            /INCLUDE (a forwarder "<dll>.<sym>" names no
//                            symbol of this image); the PE writer builds the
//                            export directory (coff/final_image.sn);
//   /ENTRY:<sym>             the plan's entry becomes <sym>, required and a
//                            liveness root (the last directive wins);
//   /FAILIFMISMATCH:<k>=<v>  objects that disagree on <k> fail the link
//                            (LLD checkFailIfMismatch, MSVC LNK2038);
//   /ALIGNCOMM:<sym>,<p>     raises a common symbol's alignment to 2^<p>;
//   any directive LLD does not allow in .drectve, or a malformed value,
//                            fails the link instead of being skipped;
//   /ALTERNATENAME:<a>=<b>   and the weak externals of every loaded object
//                            (object_ingest.sn أزواج_خارجية_ضعيفة_كوف): a
//                            symbol still unresolved once no more inputs are
//                            loaded resolves to its default. A default that is
//                            itself unresolved is followed through further
//                            weak externals and alternate names (a weak
//                            external's own default takes precedence over an
//                            /ALTERNATENAME for the same symbol, as in LLD), a
//                            default only an archive member defines is
//                            extracted, and a chain that ends undefined leaves
//                            the symbol unresolved, to be reported.
//
// Extracting an archive member can bring more `.drectve` sections and weak
// externals, so completion repeats until the inputs no longer change. Once
// they do, every symbol still undefined that names a Windows system
// function std uses is imported from its system DLL. /MERGE, /SECTION,
// /STACK, /SUBSYSTEM, /RELEASE and the export directory itself are image
// layout and belong to the PE writer. Previously /DEFAULTLIB loaded the named
// library from the current directory or the LIB environment variable, which
// is how the MSVC C runtime and the SDK import libraries entered a link;
// /EXPORT was ignored; and weak-external defaults were followed only within
// one object.

عام نوع نتيجة_إكمال_مدخلات_كوف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مدخل_ربط
    // A `.drectve` option LLD does not allow there, or a malformed value of
    // one it does: the object, the first rejected token.
    | توجيه_غير_صالح بنوع (معرف_مدخل_ربط, متجه ط8)
    // /FAILIFMISMATCH gave a key two values (LLD checkFailIfMismatch): the
    // object giving the second value, the key, the value an earlier object
    // gave, the conflicting value.
    | تعارض_تطابق بنوع (معرف_مدخل_ربط, متجه ط8, متجه ط8, متجه ط8)
;

عرف حالة_رمز_كوف_بالاسم(
    السياق: &سياق_ربط,
    الاسم: &متجه ط8
): اختياري رمز_ربط {
    أرجع ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم);
}

// /INCLUDE and /EXPORT: the symbol must be linked: an archive member defining
// it is extracted, and a name no input mentions becomes an undefined
// reference of the object that names it.
عرف طبق_تضمين_كوف(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه ط8,
    المدخل: معرف_مدخل_ربط
): نتيجة_استيعاب_مدخل_ربط {
    طابق حالة_رمز_كوف_بالاسم(السياق, الاسم) مع
    | اختياري.لا_شيء -> {
        طابق سجل_رمزا_غير_معرف_في_سياق_الربط(السياق, الاسم, المدخل) مع
        | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        }
        | _ -> { أرجع نتيجة_استيعاب_مدخل_ربط.نجح(); };
    }
    | اختياري.موجود(_) -> {
        أرجع استخرج_عضو_أرشيف_لرمز_جذر_في_السياق(السياق, الاسم);
    };
}

عرف أول_زوج_بديل_كوف(
    الأزواج: &متجه زوج_بديل_كوف,
    الاسم: &متجه ط8
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأزواج) مثل طبيعي)) {
        إذا (متجها_اسم_كوف_متساويان(&(*الأزواج)[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Weak aliases: الأزواج holds every weak external (in input order) followed
// by every /ALTERNATENAME, so the first pair for a name is the one that
// applies. A symbol still undefined, or lazy with only non-extracting
// references, follows its chain of defaults.
// Returns whether an archive member was extracted for a default, after which
// completion loads again and resolves the remaining aliases.
عرف حل_الأسماء_الضعيفة_كوف(
    السياق: &متغير سياق_ربط,
    الأزواج: &متجه زوج_بديل_كوف
): نتيجة منطقي, خطأ_استيعاب_مدخل_ربط {
    دع استخرج: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأزواج) مثل طبيعي)) {
        دع الأول: اختياري طبيعي = أول_زوج_بديل_كوف(الأزواج, &(*الأزواج)[ف].الاسم);
        دع يطبق: متغير منطقي = خطأ;
        دع معرف_الاسم: متغير معرف_رمز_ربط = { القيمة: 0 };
        طابق الأول مع
        | اختياري.موجود(الموضع) -> {
            إذا (الموضع == ف) {
                طابق حالة_رمز_كوف_بالاسم(السياق, &(*الأزواج)[ف].الاسم) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الرمز) -> {
                    طابق الرمز.الحالة مع
                    | حالة_رمز_ربط.غير_معرف(_) -> { يطبق := صواب; }
                    | حالة_رمز_ربط.كسول(_, _) -> {
                        // A lazy name that only non-extracting references
                        // name (link/context.sn مراجع_رمز_ربط) is an
                        // undefined weak symbol, which the alias resolves.
                        يطبق := رمز_مرجعه_ضعيف_فقط_في_سياق_الربط(
                            السياق,
                            الرمز.المعرف
                        );
                    }
                    | _ -> { };
                    معرف_الاسم := الرمز.المعرف;
                };
            };
        }
        | اختياري.لا_شيء -> { };
        إذا (يطبق) {
            دع مرجع_الافتراضي: &متجه ط8 = &(*الأزواج)[ف].البديل;
            دع الحالي: متغير متجه ط8 = انسخ_بايتات(مرجع_الافتراضي);
            دع الخطوات: متغير طبيعي = 0;
            دع مستمر: متغير منطقي = صواب;
            // A chain longer than the pair count repeats a name: a cycle.
            طالما (مستمر && الخطوات <= (الطول(*الأزواج) مثل طبيعي)) {
                مستمر := خطأ;
                طابق حالة_رمز_كوف_بالاسم(السياق, &الحالي) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الهدف) -> {
                    طابق الهدف.الحالة مع
                    | حالة_رمز_ربط.معرف(التعريف) -> {
                        دع الضعيف: تعريف_رمز_ربط = أنشئ_تعريف_رمز_ربط(
                            التعريف.المدخل,
                            قوة_تعريف_رمز_ربط.ضعيف(),
                            التعريف.الموضع,
                            التعريف.الحجم
                        );
                        (*السياق).الرموز.الرموز[معرف_الاسم.القيمة].الحالة :=
                            حالة_رمز_ربط.معرف(الضعيف);
                    }
                    | حالة_رمز_ربط.كسول(_, _) -> {
                        طابق استخرج_عضو_أرشيف_لرمز_جذر_في_السياق(
                            السياق,
                            &الحالي
                        ) مع
                        | نتيجة_استيعاب_مدخل_ربط.نجح -> { استخرج := صواب; }
                        | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                            أرجع نتيجة.خطأ(الخطأ);
                        };
                    }
                    | حالة_رمز_ربط.غير_معرف(_) -> {
                        طابق أول_زوج_بديل_كوف(الأزواج, &الحالي) مع
                        | اختياري.لا_شيء -> { }
                        | اختياري.موجود(التالي) -> {
                            دع مرجع_التالي: &متجه ط8 = &(*الأزواج)[التالي].البديل;
                            الحالي := انسخ_بايتات(مرجع_التالي);
                            الخطوات := الخطوات + 1;
                            مستمر := صواب;
                        };
                    }
                    | حالة_رمز_ربط.ديناميكي(_) -> {
                        // A shared-library import has no definition to alias
                        // by another name in this model; the symbol stays
                        // unresolved and is reported.
                    };
                };
            }
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(استخرج);
}

عرف دخول_توجيهات_كوف(التوجيهات: &توجيهات_قسم_كوف): اختياري متجه ط8 {
    طابق (*التوجيهات).الدخول مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        دع مرجع_الاسم: &متجه ط8 = &الاسم;
        دع النسخة: متجه ط8 = انسخ_بايتات(مرجع_الاسم);
        أرجع اختياري.موجود(النسخة);
    };
}

// The name a symbol imports: an `__imp_` pointer symbol imports the function
// it points to.
عرف اسم_مستورد_رمز_كوف(الاسم: &متجه ط8): متجه ط8 {
    دع البادئة: متجه ط8 = بايتات_من_نص(«__imp_»);
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    دع الطول_الكلي: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع له_بادئة: متغير منطقي = الطول_الكلي > طول_البادئة;
    دع ف: متغير طبيعي = 0;
    طالما (له_بادئة && ف < طول_البادئة) {
        إذا ((*الاسم)[ف] != البادئة[ف]) { له_بادئة := خطأ; };
        ف := ف + 1;
    }
    إذا (!له_بادئة) {
        دع النسخة: متجه ط8 = انسخ_بايتات(الاسم);
        أرجع النسخة;
    };
    دع الناتج: متغير متجه ط8 = [];
    ف := طول_البادئة;
    طالما (ف < الطول_الكلي) {
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The input that stands for one declared DLL in this link: created once, a
// dynamic-library input with no bytes and no path whose plan dependency
// carries the DLL name, so the PE writer builds its import descriptor as for
// a DLL given on the command line (imported by name with hint 0,
// final_image.sn معلومات_استيراد_مدخل_كوف). No DLL or import library file is
// read; rustc's raw-dylib likewise imports by (DLL, name) without the SDK's
// import libraries.
عرف مدخل_مكتبة_مصرحة_كوف(
    السياق: &متغير سياق_ربط,
    الأسماء: &متغير متجه متجه ط8,
    المدخلات: &متغير متجه معرف_مدخل_ربط,
    المكتبة: &متجه ط8
): معرف_مدخل_ربط {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسماء) مثل طبيعي)) {
        إذا (متجها_بايتات_كوف_متساويان(&(*الأسماء)[ف], المكتبة)) {
            أرجع (*المدخلات)[ف];
        };
        ف := ف + 1;
    }
    دع لا_بايتات: متجه ط8 = [];
    دع المعرف: معرف_مدخل_ربط = أضف_مدخل_بمصدر_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        صنف_مدخل_ربط.مكتبة_ديناميكية(),
        لا_بايتات,
        اختياري.لا_شيء(),
        أصل_مدخل_ربط.مباشر(),
        خطأ
    );
    دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط =
        اعتماد_مكتبة_ديناميكية_باسم(انسخ_بايتات(المكتبة));
    اربط_اعتماد_ديناميكي_بمدخل(&متغير الاعتماد, المعرف);
    أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        الاعتماد
    );
    ألحق(*الأسماء, انسخ_بايتات(المكتبة));
    ألحق(*المدخلات, المعرف);
    أرجع المعرف;
}

عرف متجها_بايتات_كوف_متساويان(الأول: &متجه ط8, الثاني: &متجه ط8): منطقي {
    إذا ((الطول(*الأول) مثل طبيعي) != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأول) مثل طبيعي)) {
        إذا ((*الأول)[ف] != (*الثاني)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Declared DLL imports, applied once completion loads no more inputs: every
// symbol still undefined whose function the program declares with a DLL
// (`خارجي «kernel32.dll» عرف ...`, link/model.sn استيراد_مكتبة_مصرح_ربط)
// becomes a dynamic symbol of that DLL's input. Any other undefined symbol is
// left for the PE writer to report as unresolved. Previously the DLL came
// from a fixed table of std's symbols in the compiler.
عرف استورد_رموز_مصرحة_كوف_في_السياق(
    السياق: &متغير سياق_ربط
): نتيجة_استيعاب_مدخل_ربط {
    إذا ((الطول((*السياق).الخطة.الاستيرادات_المصرحة) مثل طبيعي) == 0) {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    };
    دع الأسماء: متغير متجه متجه ط8 = [];
    دع المدخلات: متغير متجه معرف_مدخل_ربط = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*السياق).الرموز.الرموز) مثل طبيعي)) {
        دع بلا_تعريف: متغير منطقي = خطأ;
        طابق (*السياق).الرموز.الرموز[الفهرس].الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> { بلا_تعريف := صواب; }
        | _ -> { };
        إذا (بلا_تعريف) {
            دع معرف_الرمز: معرف_رمز_ربط = (*السياق).الرموز.الرموز[الفهرس].المعرف;
            دع الاسم: متجه ط8 = اسم_رمز_في_سياق_الربط(السياق, معرف_الرمز);
            دع المستورد: متجه ط8 = اسم_مستورد_رمز_كوف(&الاسم);
            دع مكتبة_الرمز: اختياري متجه ط8 = مكتبة_مصرحة_لرمز_في_خطة_ربط(
                &(*السياق).الخطة,
                &المستورد
            );
            طابق مكتبة_الرمز مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(المكتبة) -> {
                دع المدخل: معرف_مدخل_ربط = مدخل_مكتبة_مصرحة_كوف(
                    السياق,
                    &متغير الأسماء,
                    &متغير المدخلات,
                    &المكتبة
                );
                طابق سجل_رمز_مكتبة_ديناميكية_للربط(
                    &متغير (*السياق).الرموز,
                    &الاسم,
                    المدخل
                ) مع
                | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
                    طابق الخطأ مع
                    | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
                        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                            خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل()
                        );
                    }
                    | _ -> {
                        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                            خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
                        );
                    };
                }
                | _ -> { };
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
}

عام عرف أكمل_مدخلات_كوف_في_السياق(
    السياق: &متغير سياق_ربط
): نتيجة_إكمال_مدخلات_كوف {
    دع المعالجة: متغير متجه منطقي = [];
    دع المدخلات_المقروءة: متغير طبيعي = 0;
    دع الضعيفة: متغير متجه زوج_بديل_كوف = [];
    دع البدائل: متغير متجه زوج_بديل_كوف = [];
    دع الجذور: متغير متجه متجه ط8 = [];
    دع التطابقات: متغير متجه زوج_تطابق_كوف = [];
    دع محاذاة_المشتركة: متغير متجه محاذاة_مشترك_كوف = [];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        مستمر := خطأ;
        دع عدد_المدخلات: طبيعي = الطول((*السياق).الخطة.المدخلات) مثل طبيعي;
        طالما ((الطول(المعالجة) مثل طبيعي) < (الطول((*السياق).الأقسام) مثل طبيعي)) {
            ألحق(المعالجة, خطأ);
        }
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعالجة) مثل طبيعي)) {
            إذا (!المعالجة[ف] && قسم_توجيهات_كوف(&(*السياق).الأقسام[ف])) {
                المعالجة[ف] := صواب;
                دع المدخل: معرف_مدخل_ربط = (*السياق).الأقسام[ف].المدخل;
                دع التوجيهات: توجيهات_قسم_كوف =
                    توجيهات_قسم_ربط_كوف(&(*السياق).الأقسام[ف]);
                // An option LLD does not allow in .drectve, or a malformed
                // value of one it does.
                طابق رمز_توجيه_كوف_غير_الصالح(&التوجيهات) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(الرمز) -> {
                    أرجع نتيجة_إكمال_مدخلات_كوف.توجيه_غير_صالح(المدخل, الرمز);
                };
                // /FAILIFMISMATCH: every object must give a key the same
                // value (LLD checkFailIfMismatch; MSVC's LNK2038).
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(التوجيهات.التطابقات) مثل طبيعي)) {
                    دع ب: متغير طبيعي = 0;
                    دع موجود: متغير منطقي = خطأ;
                    طالما (ب < (الطول(التطابقات) مثل طبيعي)) {
                        إذا (متجها_اسم_كوف_متساويان(
                            &التطابقات[ب].المفتاح,
                            &التوجيهات.التطابقات[م].المفتاح
                        )) {
                            موجود := صواب;
                            إذا (!متجها_اسم_كوف_متساويان(
                                &التطابقات[ب].القيمة,
                                &التوجيهات.التطابقات[م].القيمة
                            )) {
                                دع مرجع_المفتاح: &متجه ط8 = &التطابقات[ب].المفتاح;
                                دع مرجع_الأولى: &متجه ط8 = &التطابقات[ب].القيمة;
                                دع مرجع_الثانية: &متجه ط8 =
                                    &التوجيهات.التطابقات[م].القيمة;
                                أرجع نتيجة_إكمال_مدخلات_كوف.تعارض_تطابق(
                                    المدخل,
                                    انسخ_بايتات(مرجع_المفتاح),
                                    انسخ_بايتات(مرجع_الأولى),
                                    انسخ_بايتات(مرجع_الثانية)
                                );
                            };
                        };
                        ب := ب + 1;
                    }
                    إذا (!موجود) {
                        دع مرجع_التطابق: &زوج_تطابق_كوف = &التوجيهات.التطابقات[م];
                        ألحق(التطابقات, انسخ_مملوكا_زوج_تطابق_كوف(مرجع_التطابق));
                    };
                    م := م + 1;
                }
                // /ENTRY: the directive names the entry point; a later one
                // replaces an earlier one, as LLD sets config->entry. It is
                // required and a liveness root like /INCLUDE.
                طابق دخول_توجيهات_كوف(&التوجيهات) مع
                | اختياري.لا_شيء -> { }
                | اختياري.موجود(اسم_الدخول) -> {
                    طابق طبق_تضمين_كوف(السياق, &اسم_الدخول, المدخل) مع
                    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
                    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                        أرجع نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ);
                    };
                    ألحق(الجذور, انسخ_متجه_توجيه_كوف(&اسم_الدخول));
                    (*السياق).الخطة.رمز_الدخول := اختياري.موجود(اسم_الدخول);
                };
                م := 0;
                طالما (م < (الطول(التوجيهات.محاذاة_المشتركة) مثل طبيعي)) {
                    دع مرجع_المحاذاة: &محاذاة_مشترك_كوف = &التوجيهات.محاذاة_المشتركة[م];
                    ألحق(محاذاة_المشتركة, انسخ_مملوكا_محاذاة_مشترك_كوف(مرجع_المحاذاة));
                    م := م + 1;
                }
                م := 0;
                طالما (م < (الطول(التوجيهات.المضمنة) مثل طبيعي)) {
                    طابق طبق_تضمين_كوف(السياق, &التوجيهات.المضمنة[م], المدخل) مع
                    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
                    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                        أرجع نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ);
                    };
                    دع مرجع_المضمن: &متجه ط8 = &التوجيهات.المضمنة[م];
                    ألحق(الجذور, انسخ_بايتات(مرجع_المضمن));
                    م := م + 1;
                }
                م := 0;
                طالما (م < (الطول(التوجيهات.الصادرات) مثل طبيعي)) {
                    // A forwarder names another DLL's export, not a symbol of
                    // this image.
                    إذا ((الطول(التوجيهات.الصادرات[م].التحويل) مثل طبيعي) == 0) {
                        طابق طبق_تضمين_كوف(
                            السياق,
                            &التوجيهات.الصادرات[م].الاسم_الداخلي,
                            المدخل
                        ) مع
                        | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
                        | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                            أرجع نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ);
                        };
                        دع مرجع_الداخلي: &متجه ط8 = &التوجيهات.الصادرات[م].الاسم_الداخلي;
                        ألحق(الجذور, انسخ_بايتات(مرجع_الداخلي));
                    };
                    م := م + 1;
                }
                م := 0;
                طالما (م < (الطول(التوجيهات.البدائل) مثل طبيعي)) {
                    دع مرجع_البديل: &زوج_بديل_كوف = &التوجيهات.البدائل[م];
                    ألحق(البدائل, انسخ_مملوكا_زوج_بديل_كوف(مرجع_البديل));
                    م := م + 1;
                }
            };
            ف := ف + 1;
        }
        // Weak externals of every object loaded so far, in input order.
        طالما (المدخلات_المقروءة < (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
            إذا ((*السياق).الخطة.المدخلات[المدخلات_المقروءة].الصنف
                == صنف_مدخل_ربط.كائن()) {
                دع الأزواج: متجه زوج_خارجي_ضعيف_كوف = أزواج_خارجية_ضعيفة_كوف(
                    &(*السياق).الخطة.المدخلات[المدخلات_المقروءة].البايتات
                );
                دع ز: متغير طبيعي = 0;
                طالما (ز < (الطول(الأزواج) مثل طبيعي)) {
                    دع مرجع_الاسم: &متجه ط8 = &الأزواج[ز].الاسم;
                    دع مرجع_الافتراضي: &متجه ط8 = &الأزواج[ز].الافتراضي;
                    دع الزوج: زوج_بديل_كوف = {
                        الاسم: انسخ_بايتات(مرجع_الاسم),
                        البديل: انسخ_بايتات(مرجع_الافتراضي)
                    };
                    ألحق(الضعيفة, الزوج);
                    ز := ز + 1;
                }
            };
            المدخلات_المقروءة := المدخلات_المقروءة + 1;
        }
        // Weak aliases apply only to symbols still unresolved once no more
        // inputs are loaded.
        إذا ((الطول((*السياق).الخطة.المدخلات) مثل طبيعي) == عدد_المدخلات) {
            دع الكل: متغير متجه زوج_بديل_كوف = [];
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(الضعيفة) مثل طبيعي)) {
                دع مرجع_الزوج: &زوج_بديل_كوف = &الضعيفة[ب];
                ألحق(الكل, انسخ_مملوكا_زوج_بديل_كوف(مرجع_الزوج));
                ب := ب + 1;
            }
            ب := 0;
            طالما (ب < (الطول(البدائل) مثل طبيعي)) {
                دع مرجع_الزوج: &زوج_بديل_كوف = &البدائل[ب];
                ألحق(الكل, انسخ_مملوكا_زوج_بديل_كوف(مرجع_الزوج));
                ب := ب + 1;
            }
            طابق حل_الأسماء_الضعيفة_كوف(السياق, &الكل) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ);
            };
        };
        إذا ((الطول((*السياق).الخطة.المدخلات) مثل طبيعي) != عدد_المدخلات) {
            مستمر := صواب;
        };
    }
    طابق استورد_رموز_مصرحة_كوف_في_السياق(السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
        أرجع نتيجة_إكمال_مدخلات_كوف.خطأ(الخطأ);
    };
    // /ALIGNCOMM raises a common symbol's alignment (LLD keeps the largest
    // requested and applies it to the CommonChunk); a symbol that is not a
    // common definition is not affected.
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(محاذاة_المشتركة) مثل طبيعي)) {
        طابق حالة_رمز_كوف_بالاسم(السياق, &محاذاة_المشتركة[ع].الاسم) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.معرف(التعريف) -> {
                طابق التعريف.الموضع مع
                | موضع_تعريف_رمز_ربط.قسم(القسم, _) -> {
                    دع مشترك: متغير منطقي = خطأ;
                    طابق قسم_رمز_مشترك_كوف(السياق, القسم) مع
                    | اختياري.موجود(_) -> { مشترك := صواب; }
                    | اختياري.لا_شيء -> { };
                    إذا (مشترك) {
                        دع المطلوبة: متغير طبيعي = 1;
                        دع خ: متغير طبيعي = 0;
                        طالما (خ < محاذاة_المشتركة[ع].القوة) {
                            المطلوبة := المطلوبة * 2;
                            خ := خ + 1;
                        }
                        إذا ((*السياق).الأقسام[القسم.القيمة].المحاذاة < المطلوبة) {
                            (*السياق).الأقسام[القسم.القيمة].المحاذاة := المطلوبة;
                        };
                    };
                }
                | _ -> { };
            }
            | _ -> { };
        };
        ع := ع + 1;
    }
    // /INCLUDE, /EXPORT and /ENTRY symbols are liveness roots.
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الجذور) مثل طبيعي)) {
        طابق حالة_رمز_كوف_بالاسم(السياق, &الجذور[ف]) مع
        | اختياري.موجود(الرمز) -> {
            أضف_جذر_رمز_ربط(&متغير (*السياق).الوصول, الرمز.المعرف);
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة_إكمال_مدخلات_كوف.نجح();
}
