استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.coff.final_image;
استورد compiler.link.coff.relocatable;

عام نوع خطأ_مزود_ربط_كوف =
    | خطة_غير_مدعومة
    | كائن_غير_صالح
    | رمز_دخول_مفقود
    | رمز_خارجي_غير_محلول
    | إزاحة_غير_مدعومة
    | إزاحة_خارج_النطاق
;

عام نوع نتيجة_مزود_ربط_كوف =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_كوف
;

عرف حول_خطأ_صورة_كوف(
    الخطأ: خطأ_صورة_كوف_بي_إي
): خطأ_مزود_ربط_كوف {
    طابق الخطأ مع
    | خطأ_صورة_كوف_بي_إي.هدف_غير_مدعوم -> {
        أرجع خطأ_مزود_ربط_كوف.خطة_غير_مدعومة();
    }
    | خطأ_صورة_كوف_بي_إي.تخطيط_غير_صالح -> {
        أرجع خطأ_مزود_ربط_كوف.كائن_غير_صالح();
    }
    | خطأ_صورة_كوف_بي_إي.رمز_دخول_مفقود -> {
        أرجع خطأ_مزود_ربط_كوف.رمز_دخول_مفقود();
    }
    | خطأ_صورة_كوف_بي_إي.رمز_خارجي_غير_محلول -> {
        أرجع خطأ_مزود_ربط_كوف.رمز_خارجي_غير_محلول();
    }
    | خطأ_صورة_كوف_بي_إي.إزاحة_غير_مدعومة -> {
        أرجع خطأ_مزود_ربط_كوف.إزاحة_غير_مدعومة();
    }
    | خطأ_صورة_كوف_بي_إي.إزاحة_خارج_النطاق -> {
        أرجع خطأ_مزود_ربط_كوف.إزاحة_خارج_النطاق();
    };
}

عرف حول_خطأ_كائن_كوف(
    الخطأ: خطأ_كائن_مترابط_كوف
): خطأ_مزود_ربط_كوف {
    طابق الخطأ مع
    | خطأ_كائن_مترابط_كوف.هدف_غير_مدعوم -> {
        أرجع خطأ_مزود_ربط_كوف.خطة_غير_مدعومة();
    }
    | خطأ_كائن_مترابط_كوف.حقائق_قسم_غير_صالحة -> {
        أرجع خطأ_مزود_ربط_كوف.كائن_غير_صالح();
    }
    | خطأ_كائن_مترابط_كوف.مرجع_إزاحة_غير_صالح -> {
        أرجع خطأ_مزود_ربط_كوف.إزاحة_غير_مدعومة();
    };
}

عام عرف اربط_كوف(
    السياق: &متغير سياق_ربط
): نتيجة_مزود_ربط_كوف {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        طابق ابن_صورة_كوف_ويندوز_تنفيذية(السياق) مع
        | نتيجة_صورة_كوف_بي_إي.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_كوف.نجح(البايتات);
        }
        | نتيجة_صورة_كوف_بي_إي.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_كوف.خطأ(حول_خطأ_صورة_كوف(الخطأ));
        };
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        طابق ابن_صورة_كوف_ويندوز_مشتركة(السياق) مع
        | نتيجة_صورة_كوف_بي_إي.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_كوف.نجح(البايتات);
        }
        | نتيجة_صورة_كوف_بي_إي.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_كوف.خطأ(حول_خطأ_صورة_كوف(الخطأ));
        };
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        طابق ابن_كائن_كوف_مترابط(السياق) مع
        | نتيجة_كائن_مترابط_كوف.نجح(البايتات) -> {
            أرجع نتيجة_مزود_ربط_كوف.نجح(البايتات);
        }
        | نتيجة_كائن_مترابط_كوف.خطأ(الخطأ) -> {
            أرجع نتيجة_مزود_ربط_كوف.خطأ(حول_خطأ_كائن_كوف(الخطأ));
        };
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        أرجع نتيجة_مزود_ربط_كوف.خطأ(
            خطأ_مزود_ربط_كوف.خطة_غير_مدعومة()
        );
    };
}
