استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.symbol_table;
استورد compiler.link.resolution;
استورد compiler.link.coff.reader;
استورد std.fs.path;
استورد std.text.from_bytes;

عرف بايت_ديناميكي_كوف_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع خطأ_استيعاب_مكتبة_كوف =
    | مكتبة_غير_صالحة
    | تعريف_رمز_مكرر
;

عام نوع نتيجة_استيعاب_مكتبة_كوف =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مكتبة_كوف
;

نوع قسم_صورة_بي_إي = {
    العنوان: طبيعي,
    الحجم_الافتراضي: طبيعي,
    موضع_الملف: طبيعي,
    حجم_الملف: طبيعي
};

عرف موضع_ملف_من_عنوان_بي_إي(
    الأقسام: &متجه قسم_صورة_بي_إي,
    العنوان: طبيعي
): اختياري طبيعي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الأقسام) مثل طبيعي)) {
        دع القسم: قسم_صورة_بي_إي = (*الأقسام)[الفهرس];
        دع الحجم: متغير طبيعي = القسم.الحجم_الافتراضي;
        إذا (القسم.حجم_الملف > الحجم) { الحجم := القسم.حجم_الملف; };
        إذا (العنوان >= القسم.العنوان
            && العنوان - القسم.العنوان < الحجم) {
            أرجع اختياري.موجود(
                القسم.موضع_الملف + (العنوان - القسم.العنوان)
            );
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اسم_اعتماد_بي_إي_من_المسار(
    المدخل: &مدخل_ربط
): متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
    | اختياري.موجود(المسار) -> {
        طابق اسم_الملف(&المسار) مع
        | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
        | اختياري.موجود(الاسم) -> {
            دع البايتات: متغير متجه ط8 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < (الطول(الاسم) مثل طبيعي)) {
                ألحق(البايتات, الاسم[الفهرس]);
                الفهرس := الفهرس + 1;
            }
            أرجع البايتات;
        };
    };
}

عرف اسم_استيراد_بي_إي(الاسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(«__imp_»);
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الاسم) مثل طبيعي)) {
        ألحق(الناتج, (*الاسم)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف سجل_تصدير_بي_إي_ديناميكيا(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الاسم: &متجه ط8
): نتيجة_استيعاب_مكتبة_كوف {
    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
        &متغير (*السياق).الرموز,
        الاسم,
        (*المدخل).المعرف
    ) مع
    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.تعريف_رمز_مكرر()
        );
    }
    | _ -> { };
    دع اسم_المؤشر: متجه ط8 = اسم_استيراد_بي_إي(الاسم);
    طابق سجل_رمز_مكتبة_ديناميكية_للربط(
        &متغير (*السياق).الرموز,
        &اسم_المؤشر,
        (*المدخل).المعرف
    ) مع
    | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.تعريف_رمز_مكرر()
        );
    }
    | _ -> { };
    أرجع نتيجة_استيعاب_مكتبة_كوف.نجح();
}

عام عرف استوعب_مكتبة_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_كوف {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    إذا (!ضمن_حدود_كوف(البايتات, 0, 0x40)
        || (*البايتات)[0] != 0x4D
        || (*البايتات)[1] != 0x5A) {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع موضع_بي_إي: طبيعي;
    طابق اقرأ_ط32_كوف(البايتات, 0x3C) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { موضع_بي_إي := القيمة; };
    إذا (!ضمن_حدود_كوف(البايتات, موضع_بي_إي, 24)
        || (*البايتات)[موضع_بي_إي] != 0x50
        || بايت_ديناميكي_كوف_عند(البايتات, موضع_بي_إي + 1) != 0x45
        || بايت_ديناميكي_كوف_عند(البايتات, موضع_بي_إي + 2) != 0
        || بايت_ديناميكي_كوف_عند(البايتات, موضع_بي_إي + 3) != 0) {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع عدد_الأقسام: طبيعي;
    دع حجم_الرأس_الاختياري: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, موضع_بي_إي + 6) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { عدد_الأقسام := القيمة; };
    طابق اقرأ_ط16_كوف(البايتات, موضع_بي_إي + 20) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { حجم_الرأس_الاختياري := القيمة; };
    دع موضع_الاختياري: طبيعي = موضع_بي_إي + 24;
    إذا (!ضمن_حدود_كوف(البايتات, موضع_الاختياري, حجم_الرأس_الاختياري)) {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع السحر: طبيعي;
    طابق اقرأ_ط16_كوف(البايتات, موضع_الاختياري) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { السحر := القيمة; };
    دع موضع_دليل_التصدير: طبيعي;
    إذا (السحر == 0x20B) {
        موضع_دليل_التصدير := موضع_الاختياري + 112;
    } وإلا إذا (السحر == 0x10B) {
        موضع_دليل_التصدير := موضع_الاختياري + 96;
    } وإلا {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع عنوان_التصدير: طبيعي;
    دع حجم_التصدير: طبيعي;
    طابق اقرأ_ط32_كوف(البايتات, موضع_دليل_التصدير) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { عنوان_التصدير := القيمة; };
    طابق اقرأ_ط32_كوف(البايتات, موضع_دليل_التصدير + 4) مع
    | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { حجم_التصدير := القيمة; };
    دع موضع_الأقسام: طبيعي = موضع_الاختياري + حجم_الرأس_الاختياري;
    إذا (!ضمن_حدود_كوف(البايتات, موضع_الأقسام, عدد_الأقسام * 40)) {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع الأقسام: متغير متجه قسم_صورة_بي_إي = [];
    دع فهرس_القسم: متغير طبيعي = 0;
    طالما (فهرس_القسم < عدد_الأقسام) {
        دع الموضع: طبيعي = موضع_الأقسام + فهرس_القسم * 40;
        دع العنوان: طبيعي;
        دع الحجم_الافتراضي: طبيعي;
        دع موضع_الملف: طبيعي;
        دع حجم_الملف: طبيعي;
        طابق اقرأ_ط32_كوف(البايتات, الموضع + 8) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { الحجم_الافتراضي := القيمة; };
        طابق اقرأ_ط32_كوف(البايتات, الموضع + 12) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { العنوان := القيمة; };
        طابق اقرأ_ط32_كوف(البايتات, الموضع + 16) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { حجم_الملف := القيمة; };
        طابق اقرأ_ط32_كوف(البايتات, الموضع + 20) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { موضع_الملف := القيمة; };
        دع القسم: قسم_صورة_بي_إي = {
            العنوان: العنوان,
            الحجم_الافتراضي: الحجم_الافتراضي,
            موضع_الملف: موضع_الملف,
            حجم_الملف: حجم_الملف
        };
        ألحق(الأقسام, القسم);
        فهرس_القسم := فهرس_القسم + 1;
    }
    دع اسم_الاعتماد: متغير متجه ط8 = اسم_اعتماد_بي_إي_من_المسار(المدخل);
    إذا (عنوان_التصدير != 0 && حجم_التصدير >= 40) {
        دع موضع_التصدير: طبيعي;
        طابق موضع_ملف_من_عنوان_بي_إي(&الأقسام, عنوان_التصدير) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { موضع_التصدير := القيمة; };
        دع عنوان_اسم_المكتبة: طبيعي;
        دع عدد_الأسماء: طبيعي;
        دع عنوان_الأسماء: طبيعي;
        طابق اقرأ_ط32_كوف(البايتات, موضع_التصدير + 12) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { عنوان_اسم_المكتبة := القيمة; };
        طابق اقرأ_ط32_كوف(البايتات, موضع_التصدير + 24) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { عدد_الأسماء := القيمة; };
        طابق اقرأ_ط32_كوف(البايتات, موضع_التصدير + 32) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { عنوان_الأسماء := القيمة; };
        طابق موضع_ملف_من_عنوان_بي_إي(&الأقسام, عنوان_اسم_المكتبة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الموضع) -> {
            طابق اقرأ_اسم_صفري_كوف(
                البايتات,
                الموضع,
                الطول(*البايتات) مثل طبيعي
            ) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الاسم) -> { اسم_الاعتماد := الاسم; };
        };
        دع موضع_الأسماء: طبيعي;
        طابق موضع_ملف_من_عنوان_بي_إي(&الأقسام, عنوان_الأسماء) مع
        | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
        | اختياري.موجود(القيمة) -> { موضع_الأسماء := القيمة; };
        دع فهرس_الاسم: متغير طبيعي = 0;
        طالما (فهرس_الاسم < عدد_الأسماء) {
            دع عنوان_الاسم: طبيعي;
            طابق اقرأ_ط32_كوف(البايتات, موضع_الأسماء + فهرس_الاسم * 4) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { عنوان_الاسم := القيمة; };
            دع موضع_الاسم: طبيعي;
            طابق موضع_ملف_من_عنوان_بي_إي(&الأقسام, عنوان_الاسم) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { موضع_الاسم := القيمة; };
            دع الاسم: متجه ط8;
            طابق اقرأ_اسم_صفري_كوف(
                البايتات,
                موضع_الاسم,
                الطول(*البايتات) مثل طبيعي
            ) مع
            | اختياري.لا_شيء -> { أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { الاسم := القيمة; };
            طابق سجل_تصدير_بي_إي_ديناميكيا(السياق, المدخل, &الاسم) مع
            | نتيجة_استيعاب_مكتبة_كوف.نجح -> { }
            | نتيجة_استيعاب_مكتبة_كوف.خطأ(الخطأ) -> {
                أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(الخطأ);
            };
            فهرس_الاسم := فهرس_الاسم + 1;
        }
    };
    إذا ((الطول(اسم_الاعتماد) مثل طبيعي) == 0) {
        أرجع نتيجة_استيعاب_مكتبة_كوف.خطأ(
            خطأ_استيعاب_مكتبة_كوف.مكتبة_غير_صالحة()
        );
    };
    دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط =
        اعتماد_مكتبة_ديناميكية_باسم(اسم_الاعتماد);
    اربط_اعتماد_ديناميكي_بمدخل(
        &متغير الاعتماد,
        (*المدخل).المعرف
    );
    أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
        &متغير (*السياق).الخطة,
        الاعتماد
    );
    أرجع نتيجة_استيعاب_مكتبة_كوف.نجح();
}
