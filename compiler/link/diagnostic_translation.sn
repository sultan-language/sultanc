استورد compiler.diagnostics.reason;
استورد std.text.from_bytes;
استورد compiler.link.linker;
استورد compiler.link.input_ingest;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_spelling;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.schema;

عرف ابدأ_تشخيص_ربط(السبب: سبب_تشخيص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_سياق_داخلي(),
        اختياري.لا_شيء()
    );
    دع أضيفت_مرحلة_الربط: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المرحلة(),
        «link»
    );
    دع أضيف_سبب_الربط: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب
    );
    أرجع التشخيص;
}


عرف أضف_معرف_هدف_إلى_تشخيص_ربط(
    التشخيص: &متغير تشخيص,
    الهدف: معرف_هدف
): فراغ {
    // The target is named by its spelling (x86_64-linux), never its index.
    طابق تهجئة_معرف_هدف(الهدف) مع
    | اختياري.موجود(التهجئة) -> {
        دع أضيفت_تهجئة_الهدف: منطقي = أضف_حجة_تشخيص(
            التشخيص, مفتاح_حجة_تشخيص.الهدف(), التهجئة
        );
    }
    | اختياري.لا_شيء -> {
        دع أضيف_معرف_الهدف: منطقي = أضف_حجة_طبيعية(
            التشخيص, مفتاح_حجة_تشخيص.الهدف(), الهدف.القيمة
        );
    };
}

// Adds an optional text argument; nothing when the error has no such fact.
عرف أضف_حجة_اختيارية_إلى_تشخيص_ربط(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: &اختياري نص
): فراغ {
    طابق *القيمة مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(النص) -> {
        دع مرجع_النص: &نص = &النص;
        دع أضيفت_الحجة: منطقي = أضف_حجة_تشخيص(
            التشخيص,
            المفتاح,
            انسخ_نص(مرجع_النص)
        );
    };
}

// Environment, not an internal failure: the libLLVM the output needs for its
// target (link/dependency/llvm.sn).
عرف تشخيص_إل_إل_في_إم_ربط(
    المعرف: معرف_تشخيص,
    الهدف: نص,
    الرمز: نص
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختياري.لا_شيء());
    دع أضيف_الهدف: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.الهدف(),
        الهدف
    );
    دع أضيف_الرمز: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.الرمز(),
        الرمز
    );
    أرجع التشخيص;
}

عرف تشخيص_من_خطأ_ربط(
    الخطأ: &خطأ_ربط
): تشخيص {
    طابق *الخطأ مع
    | خطأ_ربط.هدف_غير_مسجل(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_غير_مسجل_هدف()
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.مزود_ربط_غير_متاح(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_موفر_غير_متاح()
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.خرج_هدف_غير_مدعوم(الهدف, _) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_هدف_إخراج_غير_مدعوم()
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_رمز_خريطة_سعة_فيض());
    }
    | خطأ_ربط.خطة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_غير_مدعوم_خطة());
    }
    | خطأ_ربط.سكربت_جنو_غير_مدعوم(المسار, الأمر) -> {
        // The same reason as any plan SultanC cannot carry out; the script
        // file and the command it could not apply are its arguments.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_غير_مدعوم_خطة());
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            انسخ_نص(&المسار)
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            &الأمر
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.مكتبة_إل_إل_في_إم_للهدف_مفقودة(الهدف, الرمز) -> {
        أرجع تشخيص_إل_إل_في_إم_ربط(
            معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة(),
            انسخ_نص(&الهدف),
            انسخ_نص(&الرمز)
        );
    }
    | خطأ_ربط.رمز_إل_إل_في_إم_غير_محلول(الهدف, الرمز) -> {
        أرجع تشخيص_إل_إل_في_إم_ربط(
            معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول(),
            انسخ_نص(&الهدف),
            انسخ_نص(&الرمز)
        );
    }
    | خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, الحالة) -> {
        // A link input the user named that cannot be read is a missing input
        // file, not an internal failure. Previously SULTANC-ICE-CONTEXT.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.ملف_إدخال_مفقود(),
            اختياري.لا_شيء()
        );
        دع أضيفت_المرحلة: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص, مفتاح_حجة_تشخيص.المرحلة(), «link»
        );
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_ربط_مدخل_قراءة_فشل()
        );
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            انسخ_نص(&المسار)
        );
        دع أضيف_الحالة: منطقي = أضف_حجة_موقعة(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.القيمة(),
            الحالة
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.مدخل_غير_قابل_للربط(المسار, الصنف) -> {
        // A file the user gave the link (directly or through -l, as an SDK's
        // libc.tbd) that its linker does not read: the user's input, named,
        // not an internal failure. Previously SULTANC-ICE-CONTEXT
        // link.macho.invalid-object or link.elf.invalid-object.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.مدخل_ربط_غير_مدعوم(),
            اختياري.لا_شيء()
        );
        دع السبب: سبب_تشخيص;
        طابق الصنف مع
        | صنف_مدخل_غير_قابل_للربط.صيغة_غير_معروفة -> {
            السبب := سبب_تشخيص.سبب_ربط_مدخل_صيغة_غير_معروفة();
        }
        | صنف_مدخل_غير_قابل_للربط.مكتبة_نصية_خارج_ماتشو -> {
            السبب := سبب_تشخيص.سبب_ربط_مدخل_مكتبة_نصية_خارج_ماتشو();
        }
        | صنف_مدخل_غير_قابل_للربط.مكتبة_نصية_تالفة -> {
            السبب := سبب_تشخيص.سبب_ربط_مدخل_مكتبة_نصية_تالفة();
        };
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, السبب);
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            &المسار
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.رابط_خارجي_غير_موجود(الهدف) -> {
        // The environment lacks the linker the target's executables need:
        // not an internal failure. Previously reported as an unsupported
        // output.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.مخرج_ربط_غير_مدعوم(),
            اختياري.لا_شيء()
        );
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_ربط_رابط_خارجي_غير_موجود());
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.رابط_خارجي_فشل(الهدف, الرابط, الحالة) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
            معرف_تشخيص.مخرج_ربط_غير_مدعوم(),
            اختياري.لا_شيء()
        );
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_ربط_رابط_خارجي_فشل());
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            انسخ_نص(&الرابط)
        );
        دع أضيفت_الحالة: منطقي = أضف_حجة_موقعة(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.القيمة(),
            الحالة
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.إلف_منطقة_ذاكرة_فائضة(المنطقة) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.حد_صيغة_كائن_متجاوز(), اختياري.لا_شيء());
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_ربط_إلف_منطقة_ذاكرة_فائضة());
        دع أضيفت_المنطقة: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.القيمة(), انسخ_نص(&المنطقة));
        أرجع التشخيص;
    }
    | خطأ_ربط.إلف_سكربت_تخطيط_مفقود(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(معرف_تشخيص.مخرج_ربط_غير_مدعوم(), اختياري.لا_شيء());
        دع أضيف_السبب: منطقي = أضف_سبب_تشخيص(&متغير التشخيص, سبب_تشخيص.سبب_ربط_إلف_سكربت_تخطيط_مفقود());
        دع أضيف_الهدف: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), انسخ_نص(&الهدف));
        أرجع التشخيص;
    }
    | خطأ_ربط.ماتشو_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_ماك_أو_غير_صحيح_كائن());
    }
    | خطأ_ربط.ماتشو_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_ماك_أو_مفقود_دخول_رمز());
    }
    | خطأ_ربط.ماتشو_رمز_خارجي_غير_مدعوم -> {
        أرجع ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_ماك_أو_غير_مدعوم_خارجي_رمز()
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_ماك_أو_غير_مدعوم_إعادة_توطين()
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_ماك_أو_إعادة_توطين_خارج_من_نطاق()
        );
    }
    | خطأ_ربط.ماتشو_توقيع_فشل -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_ماك_أو_توقيع_إخفاق());
    }
    | خطأ_ربط.إلف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_إلف_غير_صحيح_كائن());
    }
    | خطأ_ربط.إلف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_إلف_مفقود_دخول_رمز());
    }
    | خطأ_ربط.إلف_رمز_خارجي_غير_معروف(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_إلف_مجهول_خارجي_رمز()
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.إلف_إزاحة_غير_مدعومة(الهدف, النوع) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_إلف_غير_مدعوم_إعادة_توطين());
        دع أضيف_الهدف: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), انسخ_نص(&الهدف));
        دع أضيف_النوع: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), انسخ_نص(&النوع));
        أرجع التشخيص;
    }
    | خطأ_ربط.إلف_إزاحة_خارج_النطاق(الهدف, النوع, الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_إلف_إعادة_توطين_خارج_من_نطاق());
        دع أضيف_الهدف: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.الهدف(), انسخ_نص(&الهدف));
        دع أضيف_النوع: منطقي = أضف_حجة_تشخيص(&متغير التشخيص, مفتاح_حجة_تشخيص.النوع(), انسخ_نص(&النوع));
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(&متغير التشخيص, مفتاح_حجة_تشخيص.الرمز(), &الرمز);
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_غير_صحيح_كائن());
    }
    | خطأ_ربط.كوف_تخطيط_صورة_غير_صالح(القسم) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_كوف_غير_صحيح_تخطيط_صورة()
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            &القسم
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_ستب_استيراد_غير_قابل_للترميز(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_كوف_غير_قابل_للترميز_ستب_استيراد()
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_مفقود_دخول_رمز());
    }
    | خطأ_ربط.كوف_رمز_خارجي_غير_محلول(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            سبب_تشخيص.سبب_ربط_كوف_غير_محلول_خارجي_رمز()
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_توجيه_غير_صالح(المسار, التوجيه) -> {
        // Reported as the invalid COFF object it was reported as before,
        // now naming the object and the rejected `.drectve` token.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_غير_صحيح_كائن());
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            &المسار
        );
        دع أضيف_التوجيه: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            انسخ_نص(&التوجيه)
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_تعارض_تطابق(المسار, المفتاح, الأولى, الثانية) -> {
        // /FAILIFMISMATCH: the key, the value an earlier object gave
        // (expected) and the value this object gives (found).
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_غير_صحيح_كائن());
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            &المسار
        );
        دع أضيف_المفتاح: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            انسخ_نص(&المفتاح)
        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المتوقع(),
            انسخ_نص(&الأولى)
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الموجود(),
            انسخ_نص(&الثانية)
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_غير_مدعوم_إعادة_توطين());
    }
    | خطأ_ربط.كوف_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_كوف_إعادة_توطين_خارج_من_نطاق());
    }
    | خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_غير_صحيح_وحدة());
    }
    | خطأ_ربط.ويب_أسمبلي_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_مفقود_دخول_رمز());
    }
    | خطأ_ربط.ويب_أسمبلي_رمز_غير_معرف(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_رمز_غير_معرف());
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.ويب_أسمبلي_نوع_رمز_غير_مطابق(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_نوع_رمز_غير_متطابق());
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.ويب_أسمبلي_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_إزاحة_غير_مدعومة());
    }
    | خطأ_ربط.ويب_أسمبلي_ميزة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_ميزة_غير_مدعومة());
    }
    | خطأ_ربط.ويب_أسمبلي_تجاوز_الذاكرة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_فيض_مساحة_العناوين());
    }
    | خطأ_ربط.ويب_أسمبلي_إزاحة_غير_موضعية(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_واسم_إزاحة_غير_مستقلة_عن_الموضع());
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.سبير_في_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(سبب_تشخيص.سبب_ربط_سبيرفي_غير_صحيح_وحدة());
    };
}

عام عرف حول_خطأ_ربط_إلى_تشخيصات(
    الخطأ: &خطأ_ربط
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = تشخيص_من_خطأ_ربط(الخطأ);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
