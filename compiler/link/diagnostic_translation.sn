استورد compiler.link.linker;
استورد compiler.backend.target.target_model;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.schema;

عرف ابدأ_تشخيص_ربط(السبب: نص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_سياق_داخلي(),
        اختيار.لا_شيء()
    );
    دع أضيفت_مرحلة_الربط: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المرحلة(),
        «link»
    );
    دع أضيف_سبب_الربط: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.السبب(),
        السبب
    );
    أرجع التشخيص;
}


عرف أضف_معرف_هدف_إلى_تشخيص_ربط(
    التشخيص: &متغير تشخيص,
    الهدف: معرف_هدف
): فراغ {
    دع أضيف_معرف_الهدف: منطقي = أضف_حجة_غير_موقعة(
        التشخيص,
        مفتاح_حجة_تشخيص.الهدف(),
        الهدف.القيمة
    );
}

// Adds an optional text argument; nothing when the error has no such fact.
عرف أضف_حجة_اختيارية_إلى_تشخيص_ربط(
    التشخيص: &متغير تشخيص,
    المفتاح: مفتاح_حجة_تشخيص,
    القيمة: &اختيار نص
): فراغ {
    طابق *القيمة مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(النص) -> {
        دع مرجع_النص: &نص = &النص;
        دع أضيفت_الحجة: منطقي = أضف_حجة_تشخيص(
            التشخيص,
            المفتاح,
            *مرجع_النص
        );
    };
}

// Environment, not an internal failure: the libLLVM the output needs for its
// target (link/dependency/llvm.sn).
عرف تشخيص_إل_إل_في_إم_ربط(
    المعرف: معرف_تشخيص,
    الهدف: نص,
    الرمز: نص
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(المعرف, اختيار.لا_شيء());
    دع أضيف_الهدف: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.الهدف(),
        الهدف
    );
    دع أضيف_الرمز: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.الرمز(),
        الرمز
    );
    أرجع التشخيص;
}

عرف تشخيص_من_خطأ_ربط(
    الخطأ: &خطأ_ربط
): تشخيص {
    طابق *الخطأ مع
    | خطأ_ربط.هدف_غير_مسجل(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.unregistered-target»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.مزود_ربط_غير_متاح(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.provider-unavailable»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.خرج_هدف_غير_مدعوم(الهدف, _) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.target-output-unsupported»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
        أرجع ابدأ_تشخيص_ربط(«link.symbol-map-capacity-overflow»);
    }
    | خطأ_ربط.خطة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(«link.unsupported-plan»);
    }
    | خطأ_ربط.سكربت_جنو_غير_مدعوم(المسار, الأمر) -> {
        // The same reason as any plan SultanC cannot carry out; the script
        // file and the command it could not apply are its arguments.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(«link.unsupported-plan»);
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            المسار
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            &الأمر
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.مكتبة_إل_إل_في_إم_للهدف_مفقودة(الهدف, الرمز) -> {
        أرجع تشخيص_إل_إل_في_إم_ربط(
            معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة(),
            الهدف,
            الرمز
        );
    }
    | خطأ_ربط.رمز_إل_إل_في_إم_غير_محلول(الهدف, الرمز) -> {
        أرجع تشخيص_إل_إل_في_إم_ربط(
            معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول(),
            الهدف,
            الرمز
        );
    }
    | خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, الحالة) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.input-read-failed»
        );
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            المسار
        );
        دع أضيف_الحالة: منطقي = أضف_حجة_موقعة(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.القيمة(),
            الحالة
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.ماتشو_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.invalid-object»);
    }
    | خطأ_ربط.ماتشو_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.missing-entry-symbol»);
    }
    | خطأ_ربط.ماتشو_رمز_خارجي_غير_مدعوم -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.unsupported-external-symbol»
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.unsupported-relocation»
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.relocation-out-of-range»
        );
    }
    | خطأ_ربط.ماتشو_توقيع_فشل -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.signing-failure»);
    }
    | خطأ_ربط.إلف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.invalid-object»);
    }
    | خطأ_ربط.إلف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.missing-entry-symbol»);
    }
    | خطأ_ربط.إلف_رمز_خارجي_غير_معروف(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.elf.unknown-external-symbol»
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.invalid-object»);
    }
    | خطأ_ربط.كوف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.missing-entry-symbol»);
    }
    | خطأ_ربط.كوف_رمز_خارجي_غير_محلول(الرمز) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.coff.unresolved-external-symbol»
        );
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الرمز(),
            &الرمز
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_توجيه_غير_صالح(المسار, التوجيه) -> {
        // Reported as the invalid COFF object it was reported as before,
        // now naming the object and the rejected `.drectve` token.
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(«link.coff.invalid-object»);
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            &المسار
        );
        دع أضيف_التوجيه: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            التوجيه
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_تعارض_تطابق(المسار, المفتاح, الأولى, الثانية) -> {
        // /FAILIFMISMATCH: the key, the value an earlier object gave
        // (expected) and the value this object gives (found).
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(«link.coff.invalid-object»);
        أضف_حجة_اختيارية_إلى_تشخيص_ربط(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            &المسار
        );
        دع أضيف_المفتاح: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.السياق(),
            المفتاح
        );
        دع أضيف_المتوقع: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المتوقع(),
            الأولى
        );
        دع أضيف_الموجود: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.الموجود(),
            الثانية
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.كوف_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.unsupported-relocation»);
    }
    | خطأ_ربط.كوف_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.relocation-out-of-range»);
    }
    | خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.invalid-module»);
    }
    | خطأ_ربط.ويب_أسمبلي_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.missing-entry-symbol»);
    }
    | خطأ_ربط.سبير_في_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(«link.spirv.invalid-module»);
    };
}

عام عرف حول_خطأ_ربط_إلى_تشخيصات(
    الخطأ: &خطأ_ربط
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = تشخيص_من_خطأ_ربط(الخطأ);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
