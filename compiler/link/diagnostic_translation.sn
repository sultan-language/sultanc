استورد compiler.link.linker;
استورد compiler.backend.target.target_model;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.builder;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.schema;

عرف ابدأ_تشخيص_ربط(السبب: نص): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيصا(
        معرف_تشخيص.خطأ_سياق_داخلي(),
        اختيار.لا_شيء()
    );
    دع أضيفت_مرحلة_الربط: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.المرحلة(),
        «link»
    );
    دع أضيف_سبب_الربط: منطقي = أضف_حجة_تشخيص(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.السبب(),
        السبب
    );
    أرجع التشخيص;
}


عرف ابدأ_تشخيص_ربط_بحالة(
    السبب: نص,
    الحالة: عدد
): تشخيص {
    دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(السبب);
    دع أضيف_الحالة: منطقي = أضف_حجة_موقعة(
        &متغير التشخيص,
        مفتاح_حجة_تشخيص.القيمة(),
        الحالة
    );
    أرجع التشخيص;
}

عرف أضف_معرف_هدف_إلى_تشخيص_ربط(
    التشخيص: &متغير تشخيص,
    الهدف: معرف_هدف
): فراغ {
    دع أضيف_معرف_الهدف: منطقي = أضف_حجة_غير_موقعة(
        التشخيص,
        مفتاح_حجة_تشخيص.الهدف(),
        الهدف.القيمة
    );
}

عرف تشخيص_من_خطأ_ربط(
    الخطأ: &خطأ_ربط
): تشخيص {
    طابق *الخطأ مع
    | خطأ_ربط.هدف_غير_مسجل(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.unregistered-target»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.مزود_ربط_غير_متاح(الهدف) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.provider-unavailable»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.خرج_هدف_غير_مدعوم(الهدف, _) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.target-output-unsupported»
        );
        أضف_معرف_هدف_إلى_تشخيص_ربط(&متغير التشخيص, الهدف);
        أرجع التشخيص;
    }
    | خطأ_ربط.خطة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(«link.unsupported-plan»);
    }
    | خطأ_ربط.بيانات_أداة_ربط_مفقودة -> {
        أرجع ابدأ_تشخيص_ربط(«link.missing-toolchain-metadata»);
    }
    | خطأ_ربط.مدخل_ملف_غير_مقروء(المسار, الحالة) -> {
        دع التشخيص: متغير تشخيص = ابدأ_تشخيص_ربط(
            «link.input-read-failed»
        );
        دع أضيف_المسار: منطقي = أضف_حجة_تشخيص(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.المسار(),
            المسار
        );
        دع أضيف_الحالة: منطقي = أضف_حجة_موقعة(
            &متغير التشخيص,
            مفتاح_حجة_تشخيص.القيمة(),
            الحالة
        );
        أرجع التشخيص;
    }
    | خطأ_ربط.ماتشو_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.invalid-object»);
    }
    | خطأ_ربط.ماتشو_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.missing-entry-symbol»);
    }
    | خطأ_ربط.ماتشو_رمز_خارجي_غير_مدعوم -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.unsupported-external-symbol»
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.unsupported-relocation»
        );
    }
    | خطأ_ربط.ماتشو_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.macho.relocation-out-of-range»
        );
    }
    | خطأ_ربط.ماتشو_توقيع_فشل -> {
        أرجع ابدأ_تشخيص_ربط(«link.macho.signing-failure»);
    }
    | خطأ_ربط.إلف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.invalid-object»);
    }
    | خطأ_ربط.إلف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.missing-entry-symbol»);
    }
    | خطأ_ربط.إلف_رمز_خارجي_غير_معروف -> {
        أرجع ابدأ_تشخيص_ربط(
            «link.elf.unknown-external-symbol»
        );
    }
    | خطأ_ربط.إلف_بيانات_أداة_مفقودة -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.missing-toolchain-metadata»);
    }
    | خطأ_ربط.إلف_أرشيف_رفيع_بلا_مسار -> {
        أرجع ابدأ_تشخيص_ربط(«link.elf.thin-archive-missing-path»);
    }
    | خطأ_ربط.إلف_فشل_مساحة_عمل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.elf.workspace-failed»,
            الحالة
        );
    }
    | خطأ_ربط.إلف_فشل_كتابة_مدخل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.elf.input-write-failed»,
            الحالة
        );
    }
    | خطأ_ربط.إلف_فشل_تشغيل_الرابط(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.elf.tool-failed»,
            الحالة
        );
    }
    | خطأ_ربط.إلف_فشل_قراءة_المخرج(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.elf.output-read-failed»,
            الحالة
        );
    }
    | خطأ_ربط.كوف_كائن_غير_صالح -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.invalid-object»);
    }
    | خطأ_ربط.كوف_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.missing-entry-symbol»);
    }
    | خطأ_ربط.كوف_رمز_خارجي_غير_محلول -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.unresolved-external-symbol»);
    }
    | خطأ_ربط.كوف_إزاحة_غير_مدعومة -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.unsupported-relocation»);
    }
    | خطأ_ربط.كوف_إزاحة_خارج_النطاق -> {
        أرجع ابدأ_تشخيص_ربط(«link.coff.relocation-out-of-range»);
    }
    | خطأ_ربط.ويب_أسمبلي_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.invalid-module»);
    }
    | خطأ_ربط.ويب_أسمبلي_رمز_دخول_مفقود -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.missing-entry-symbol»);
    }
    | خطأ_ربط.ويب_أسمبلي_بيانات_أداة_مفقودة -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.missing-toolchain-metadata»);
    }
    | خطأ_ربط.ويب_أسمبلي_أرشيف_رفيع_بلا_مسار -> {
        أرجع ابدأ_تشخيص_ربط(«link.wasm.thin-archive-missing-path»);
    }
    | خطأ_ربط.ويب_أسمبلي_فشل_مساحة_عمل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.wasm.workspace-failed»,
            الحالة
        );
    }
    | خطأ_ربط.ويب_أسمبلي_فشل_كتابة_مدخل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.wasm.input-write-failed»,
            الحالة
        );
    }
    | خطأ_ربط.ويب_أسمبلي_فشل_تشغيل_الرابط(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.wasm.tool-failed»,
            الحالة
        );
    }
    | خطأ_ربط.ويب_أسمبلي_فشل_قراءة_المخرج(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.wasm.output-read-failed»,
            الحالة
        );
    }
    | خطأ_ربط.سبير_في_وحدة_غير_صالحة -> {
        أرجع ابدأ_تشخيص_ربط(«link.spirv.invalid-module»);
    }
    | خطأ_ربط.سبير_في_بيانات_أداة_مفقودة -> {
        أرجع ابدأ_تشخيص_ربط(«link.spirv.missing-toolchain-metadata»);
    }
    | خطأ_ربط.سبير_في_فشل_مساحة_عمل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.spirv.workspace-failed»,
            الحالة
        );
    }
    | خطأ_ربط.سبير_في_فشل_كتابة_مدخل(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.spirv.input-write-failed»,
            الحالة
        );
    }
    | خطأ_ربط.سبير_في_فشل_تشغيل_الرابط(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.spirv.tool-failed»,
            الحالة
        );
    }
    | خطأ_ربط.سبير_في_فشل_قراءة_المخرج(الحالة) -> {
        أرجع ابدأ_تشخيص_ربط_بحالة(
            «link.spirv.output-read-failed»,
            الحالة
        );
    };
}

عام عرف حول_خطأ_ربط_إلى_تشخيصات(
    الخطأ: &خطأ_ربط
): مجموعة_تشخيصات {
    دع التشخيص: متغير تشخيص = تشخيص_من_خطأ_ربط(الخطأ);
    دع المجموعة: متغير مجموعة_تشخيصات = مجموعة_تشخيصات_جديدة();
    أصدر_تشخيصا(&متغير المجموعة, &التشخيص);
    أرجع المجموعة;
}
