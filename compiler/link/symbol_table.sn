استورد std.text.from_bytes;
استورد compiler.link.symbol_model;
استورد std.collections.map;
استورد std.bytes.compare;
استورد std.hash.fnv;

عام نوع جدول_رموز_ربط = {
    الفهرس: الخريطة<متجه ط8, طبيعي>,
    الرموز: متجه رمز_ربط
};

عرف هاش_اسم_رمز_ربط(الاسم: &متجه ط8): طبيعي {
    أرجع هاش_فنڤ1أ_طبيعي_للبايتات(الاسم);
}


عرف اسما_رمز_ربط_متساويان(
    الاسم_الأول: &متجه ط8,
    الاسم_الثاني: &متجه ط8
): منطقي {
    أرجع متجها_بايتات_متساويان(الاسم_الأول, الاسم_الثاني);
}

// Sharing an immutable vector descriptor never copies its backing bytes.
// Keep the borrow confined to this call before moving the other descriptor
// into the canonical map.
عرف شارك_واصف_اسم_رمز_ربط(الاسم: &متجه ط8): متجه ط8 {
    أرجع انسخ_بايتات(الاسم);
}

عرف انسخ_اسم_رمز_ربط(الاسم: &متجه ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *الاسم;
    دع الناتج: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(المصدر) مثل طبيعي)) {
        ألحق(الناتج, المصدر[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_جدول_رموز_ربط(): جدول_رموز_ربط {
    دع الفهرس: الخريطة<متجه ط8, طبيعي> = أنشئ_الخريطة(
        هاش_اسم_رمز_ربط,
        اسما_رمز_ربط_متساويان
    );
    دع الرموز: متجه رمز_ربط = [];
    دع الجدول: جدول_رموز_ربط = {
        الفهرس: الفهرس,
        الرموز: الرموز
    };
    أرجع الجدول;
}

عام نوع نتيجة_إدراج_رمز_ربط =
    | أضيف بنوع معرف_رمز_ربط
    | حدث بنوع (معرف_رمز_ربط, قرار_حل_رمز_ربط)
    | سعة_غير_قابلة_للتمثيل
;

عام عرف أدرج_مرشح_رمز_ربط(
    الجدول: &متغير جدول_رموز_ربط,
    الاسم: &متجه ط8,
    الحالة: حالة_رمز_ربط
): نتيجة_إدراج_رمز_ربط {
    دع من_كائن_عادي: منطقي = حالة_رمز_ربط_من_كائن_عادي(&الحالة);
    طابق ابحث_في_الخريطة(&(*الجدول).الفهرس, الاسم) مع
    | اختياري.لا_شيء -> {
        دع الموضع: طبيعي = الطول((*الجدول).الرموز) مثل طبيعي;
        دع المعرف: معرف_رمز_ربط = معرف_رمز_ربط_من(الموضع);
        // Own the spelling once. SultanC vector value assignments copy the
        // descriptor, not its byte allocation. The index and symbol record
        // share that immutable backing, which remains stable as either outer
        // vector grows. Neither consumer mutates or frees the name bytes.
        دع مفتاح_الفهرس: متجه ط8 = انسخ_اسم_رمز_ربط(الاسم);
        دع اسم_الرمز: متجه ط8 = شارك_واصف_اسم_رمز_ربط(&مفتاح_الفهرس);
        // Commit the index first: a failed reservation must not append an
        // unindexed symbol. A replacement is distinct from an insertion.
        طابق أدرج_في_الخريطة(&متغير (*الجدول).الفهرس, مفتاح_الفهرس, الموضع) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_إدراج_رمز_ربط.سعة_غير_قابلة_للتمثيل();
        }
        | نتيجة.نجح(السابق_المدرج) -> {
            طابق السابق_المدرج مع
            | اختياري.لا_شيء -> {
                دع الرمز: رمز_ربط = {
                    المعرف: المعرف,
                    الاسم: اسم_الرمز,
                    الحالة: الحالة,
                    مستخدم: من_كائن_عادي
                };
                ألحق((*الجدول).الرموز, الرمز);
                أرجع نتيجة_إدراج_رمز_ربط.أضيف(المعرف);
            }
            | اختياري.موجود(الموضع_السابق) -> {
                // Preserve the prior mapping even if a key was replaced.
                // Replacing an equal key retains the map's original key;
                // only its value must be restored, so no owned copy is needed.
                دع مفتاح_سابق: متجه ط8 = انسخ_بايتات(الاسم);
                طابق أدرج_في_الخريطة(&متغير (*الجدول).الفهرس, مفتاح_سابق, الموضع_السابق) مع
                | نتيجة.نجح(_) -> { }
                | نتيجة.خطأ(_) -> { أرجع نتيجة_إدراج_رمز_ربط.سعة_غير_قابلة_للتمثيل(); };
                // The prior key still owns its symbol; resolve it normally.
                دع القرار: قرار_حل_رمز_ربط = قرر_حل_رمز_ربط(
                    &(*الجدول).الرموز[الموضع_السابق].الحالة, &الحالة
                );
                إذا (من_كائن_عادي) {
                    (*الجدول).الرموز[الموضع_السابق].مستخدم := صواب;
                };
                طابق القرار مع
                | قرار_حل_رمز_ربط.استبدل_بالمرشح -> {
                    (*الجدول).الرموز[الموضع_السابق].الحالة := الحالة;
                }
                | _ -> { };
                دع المعرف_السابق: معرف_رمز_ربط = (*الجدول).الرموز[الموضع_السابق].المعرف;
                أرجع نتيجة_إدراج_رمز_ربط.حدث(المعرف_السابق, القرار);
            };
        };
    }
    | اختياري.موجود(الموضع) -> {
        دع القرار: قرار_حل_رمز_ربط = قرر_حل_رمز_ربط(
            &(*الجدول).الرموز[الموضع].الحالة,
            &الحالة
        );
        إذا (من_كائن_عادي) {
            (*الجدول).الرموز[الموضع].مستخدم := صواب;
        };
        طابق القرار مع
        | قرار_حل_رمز_ربط.استبدل_بالمرشح -> {
            (*الجدول).الرموز[الموضع].الحالة := الحالة;
        }
        | _ -> { };
        دع المعرف: معرف_رمز_ربط = (*الجدول).الرموز[الموضع].المعرف;
        أرجع نتيجة_إدراج_رمز_ربط.حدث(المعرف, القرار);
    };
}

عام عرف ابحث_رمز_ربط_بالمعرف(
    الجدول: &جدول_رموز_ربط,
    المعرف: معرف_رمز_ربط
): اختياري رمز_ربط {
    إذا ((المعرف.القيمة مثل طبيعي) >= (الطول((*الجدول).الرموز) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع مرجع_الرمز: &رمز_ربط = &(*الجدول).الرموز[المعرف.القيمة];
    دع الرمز: رمز_ربط = انسخ_مملوكا_رمز_ربط(مرجع_الرمز);
    أرجع اختياري.موجود(الرمز);
}

عام عرف ابحث_رمز_ربط_بالاسم(
    الجدول: &جدول_رموز_ربط,
    الاسم: &متجه ط8
): اختياري رمز_ربط {
    طابق ابحث_في_الخريطة(&(*الجدول).الفهرس, الاسم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        إذا (الموضع >= (الطول((*الجدول).الرموز) مثل طبيعي)) {
            أرجع اختياري.لا_شيء();
        };
        دع مرجع_الرمز: &رمز_ربط = &(*الجدول).الرموز[الموضع];
        دع الرمز: رمز_ربط = انسخ_مملوكا_رمز_ربط(مرجع_الرمز);
        أرجع اختياري.موجود(الرمز);
    };
}

عام عرف أسماء_الرموز_غير_المعرفة_للربط(
    الجدول: &جدول_رموز_ربط
): متجه متجه ط8 {
    دع الأسماء: متغير متجه متجه ط8 = [];
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < (الطول((*الجدول).الرموز) مثل طبيعي)) {
        دع الرمز: &رمز_ربط = &(*الجدول).الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> {
            ألحق(الأسماء, انسخ_اسم_رمز_ربط(&(*الرمز).الاسم));
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع الأسماء;
}
