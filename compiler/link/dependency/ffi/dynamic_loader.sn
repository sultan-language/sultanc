// حد ABI لمحمل المكتبات الديناميكية في النظام.
// الأسماء الإنجليزية هنا فقط لأنها أسماء رموز C خارجية فعلية.

عام نوع مقبض_محمل_ديناميكي = *غ8;
عام نوع مؤشر_محرف_محمل_ديناميكي = *غ8;

عام نوع معلومات_عنوان_محمل_ديناميكي = {
    اسم_الملف: *غ8,
    قاعدة: *غ8,
    اسم_الرمز: *غ8,
    عنوان_الرمز: *غ8
};

خارجي عرف dlopen(المسار: مؤشر_محرف_محمل_ديناميكي, النمط: ص32): مقبض_محمل_ديناميكي;
خارجي عرف dlsym(المقبض: مقبض_محمل_ديناميكي, الاسم: مؤشر_محرف_محمل_ديناميكي): *غ8;
خارجي عرف dladdr(العنوان: *متغير غ8, المعلومات: *متغير معلومات_عنوان_محمل_ديناميكي): ص32;
خارجي عرف dlclose(المقبض: مقبض_محمل_ديناميكي): ص32;

عام عرف افتح_مكتبة_ديناميكية(
    المسار: مؤشر_محرف_محمل_ديناميكي,
    النمط: ص32
): مقبض_محمل_ديناميكي {
    أرجع dlopen(المسار, النمط);
}

عام عرف ابحث_رمز_مكتبة_ديناميكية(
    المقبض: مقبض_محمل_ديناميكي,
    الاسم: مؤشر_محرف_محمل_ديناميكي
): *غ8 {
    أرجع dlsym(المقبض, الاسم);
}

عام عرف ابحث_معلومات_عنوان_ديناميكي(
    العنوان: *متغير غ8,
    المعلومات: *متغير معلومات_عنوان_محمل_ديناميكي
): ص32 {
    أرجع dladdr(العنوان, المعلومات);
}

عام عرف أغلق_مكتبة_ديناميكية(المقبض: مقبض_محمل_ديناميكي): ص32 {
    أرجع dlclose(المقبض);
}

عام عرف انسخ_بايتات_لمحمل_ديناميكي(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عام عرف اجعل_اسما_سي_لمحمل_ديناميكي(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = انسخ_بايتات_لمحمل_ديناميكي(المصدر);
    ألحق(الناتج, 0);
    أرجع الناتج;
}

عام عرف مؤشر_اسم_سي_لمحمل_ديناميكي(
    الاسم: &متغير متجه غ8
): مؤشر_محرف_محمل_ديناميكي {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { ألحق(*الاسم, 0); };
    أرجع &متغير (*الاسم)[0];
}

عام عرف انسخ_نص_سي_من_محمل_ديناميكي(المصدر: *غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    غير_آمن {
        بينما (المصدر[فهرس_البايت] != 0) {
            ألحق(الناتج, المصدر[فهرس_البايت]);
            فهرس_البايت := فهرس_البايت + 1;
        }
    }
    أرجع الناتج;
}
