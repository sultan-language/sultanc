// أسماء الربط الخارجية الخاصة بمكتبة LLVM.
// هذه الوحدة تملك التهجئات البايتية فقط؛ منطق الاكتشاف يبقى في dependency/llvm.sn.

عام عرف اسم_رمز_إصدار_إل_إل_في_إم(): متجه غ8 {
    دع الاسم: متجه غ8 = [0x4C,0x4C,0x56,0x4D,0x47,0x65,0x74,0x56,0x65,0x72,0x73,0x69,0x6F,0x6E];
    أرجع الاسم;
}

عام عرف بادئة_رپاث_إل_إل_في_إم_داروين(): متجه غ8 {
    دع البادئة: متجه غ8 = [0x40,0x72,0x70,0x61,0x74,0x68,0x2F];
    أرجع البادئة;
}

عام عرف بادئة_مكتبة_إل_إل_في_إم_داروين(): متجه غ8 {
    دع البادئة: متجه غ8 = [0x6C,0x69,0x62,0x4C,0x4C,0x56,0x4D,0x2D];
    أرجع البادئة;
}

عام عرف لاحقة_مكتبة_إل_إل_في_إم_داروين(): متجه غ8 {
    دع اللاحقة: متجه غ8 = [0x2E,0x64,0x79,0x6C,0x69,0x62];
    أرجع اللاحقة;
}

عام عرف بادئة_مكتبة_إل_إل_في_إم_لينكس(): متجه غ8 {
    دع البادئة: متجه غ8 = [0x6C,0x69,0x62,0x4C,0x4C,0x56,0x4D,0x2E,0x73,0x6F,0x2E];
    أرجع البادئة;
}

عام عرف بادئة_رمز_إل_إل_في_إم(): متجه غ8 {
    دع البادئة: متجه غ8 = [0x4C,0x4C,0x56,0x4D];
    أرجع البادئة;
}

عام عرف بادئة_رمز_إل_إل_في_إم_داروين(): متجه غ8 {
    دع البادئة: متجه غ8 = [0x5F,0x4C,0x4C,0x56,0x4D];
    أرجع البادئة;
}

عام عرف يبدأ_اسم_إل_إل_في_إم_ببادئة(
    الاسم: &متجه غ8,
    البادئة: &متجه غ8
): منطقي {
    دع طول_الاسم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    دع طول_البادئة: غير_موقع = الطول(*البادئة) مثل غير_موقع;
    لو (طول_الاسم < طول_البادئة) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < طول_البادئة) {
        لو ((*الاسم)[فهرس_البايت] != (*البادئة)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رمز_إل_إل_في_إم_للربط(الاسم: &متجه غ8): منطقي {
    دع البادئة: متجه غ8 = بادئة_رمز_إل_إل_في_إم();
    لو (يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &البادئة)) {
        أرجع صواب;
    };
    دع بادئة_داروين: متجه غ8 = بادئة_رمز_إل_إل_في_إم_داروين();
    أرجع يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &بادئة_داروين);
}
