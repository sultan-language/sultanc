استورد std.text.from_bytes;
// تهجئات رموز واجهة LLVM C في الكائنات المربوطة.
// لا تملك هذه الوحدة أي اسم لمكتبة LLVM: اسم الاعتماد يأتي من هوية المكتبة
// المستوعبة نفسها (dependency/llvm.sn).

عام عرف بادئة_رمز_إل_إل_في_إم(): متجه ط8 {
    دع البادئة: متجه ط8 = بايتات_من_نص(«LLVM»);
    أرجع البادئة;
}

عام عرف بادئة_رمز_إل_إل_في_إم_داروين(): متجه ط8 {
    دع البادئة: متجه ط8 = بايتات_من_نص(«_LLVM»);
    أرجع البادئة;
}

عام عرف يبدأ_اسم_إل_إل_في_إم_ببادئة(
    الاسم: &متجه ط8,
    البادئة: &متجه ط8
): منطقي {
    دع طول_الاسم: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع طول_البادئة: طبيعي = الطول(*البادئة) مثل طبيعي;
    لو (طول_الاسم < طول_البادئة) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < طول_البادئة) {
        لو ((*الاسم)[فهرس_البايت] != (*البادئة)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رمز_إل_إل_في_إم_للربط(الاسم: &متجه ط8): منطقي {
    دع البادئة: متجه ط8 = بادئة_رمز_إل_إل_في_إم();
    لو (يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &البادئة)) {
        أرجع صواب;
    };
    دع بادئة_داروين: متجه ط8 = بادئة_رمز_إل_إل_في_إم_داروين();
    أرجع يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &بادئة_داروين);
}
