استورد std.text.from_bytes;
// تهجئات رموز واجهة LLVM C في الكائنات المربوطة.
// لا تملك هذه الوحدة أي اسم لمكتبة LLVM: اسم الاعتماد يأتي من هوية المكتبة
// المستوعبة نفسها (dependency/llvm.sn).

عام عرف بادئة_رمز_إل_إل_في_إم(): متجه غ8 {
    دع البادئة: متجه غ8 = بايتات_من_نص(«LLVM»);
    أرجع البادئة;
}

عام عرف بادئة_رمز_إل_إل_في_إم_داروين(): متجه غ8 {
    دع البادئة: متجه غ8 = بايتات_من_نص(«_LLVM»);
    أرجع البادئة;
}

عام عرف يبدأ_اسم_إل_إل_في_إم_ببادئة(
    الاسم: &متجه غ8,
    البادئة: &متجه غ8
): منطقي {
    دع طول_الاسم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    دع طول_البادئة: غير_موقع = الطول(*البادئة) مثل غير_موقع;
    لو (طول_الاسم < طول_البادئة) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < طول_البادئة) {
        لو ((*الاسم)[فهرس_البايت] != (*البادئة)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رمز_إل_إل_في_إم_للربط(الاسم: &متجه غ8): منطقي {
    دع البادئة: متجه غ8 = بادئة_رمز_إل_إل_في_إم();
    لو (يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &البادئة)) {
        أرجع صواب;
    };
    دع بادئة_داروين: متجه غ8 = بادئة_رمز_إل_إل_في_إم_داروين();
    أرجع يبدأ_اسم_إل_إل_في_إم_ببادئة(الاسم, &بادئة_داروين);
}
