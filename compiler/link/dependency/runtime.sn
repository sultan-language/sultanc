استورد compiler.backend.object.runtime_object;
استورد compiler.link.context;
استورد compiler.link.input_ingest;
استورد compiler.link.macho.names;
استورد compiler.link.elf.names;
استورد compiler.link.symbol_table;
استورد compiler.link.model;
استورد compiler.link.symbol_model;
استورد compiler.runtime.primitive_runtime_abi;
استورد compiler.backend.target.target_model;

عرف انسخ_بايتات_كائن_تشغيل(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عرف يحتاج_خرج_الربط_إلى_تشغيل_الهدف(الخرج: نوع_خرج_ربط): منطقي {
    طابق الخرج مع
    | نوع_خرج_ربط.تنفيذي -> { أرجع صواب; }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { أرجع صواب; }
    | نوع_خرج_ربط.كائن_مترابط -> { أرجع خطأ; }
    | نوع_خرج_ربط.وحدة_هدف -> { أرجع خطأ; };
}

عرف انسخ_اسم_رمز_تشغيل_للربط(الاسم: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الاسم) مثل غير_موقع)) {
        ألحق(الناتج, (*الاسم)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عرف اسم_رمز_تشغيل_مقنن_للربط(
    السياق: &سياق_ربط,
    الاسم: &متجه غ8
): متجه غ8 {
    طابق (*السياق).الهدف.صيغة_الكائن مع
    | صيغة_كائن_هدف.ماتشو -> {
        أرجع اسم_رمز_سي_ماتشو_الأساسي(الاسم);
    }
    | _ -> { أرجع انسخ_اسم_رمز_تشغيل_للربط(الاسم); };
}

عرف اجمع_تصديرات_تشغيل_غير_معرفة(
    السياق: &سياق_ربط
): متجه هوية_تصدير_تشغيل {
    دع التصديرات: متغير متجه هوية_تصدير_تشغيل = [];
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*السياق).الرموز.الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*السياق).الرموز.الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> {
            دع الاسم_المقنن: متجه غ8 =
                اسم_رمز_تشغيل_مقنن_للربط(السياق, &(*الرمز).الاسم);
            طابق حل_تصدير_تشغيل_من_اسم_خارجي(&الاسم_المقنن) مع
            | اختيار.بعض(التصدير) -> { ألحق(التصديرات, التصدير); }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع التصديرات;
}

// Runtime injection is driven only by unresolved canonical symbols and Target.
// It never checks which codegen backend produced the original object.
عام عرف أضف_كائن_تشغيل_الهدف_عند_الحاجة(
    السياق: &متغير سياق_ربط
): نتيجة_استيعاب_مدخل_ربط {
    لو (!يحتاج_خرج_الربط_إلى_تشغيل_الهدف((*السياق).الخطة.الخرج)) {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    };

    دع التصديرات: متجه هوية_تصدير_تشغيل = اجمع_تصديرات_تشغيل_غير_معرفة(&(*السياق));
    // A native object may already own the target process entry. Generating a
    // second strong definition is invalid, even when runtime services remain
    // unresolved. Consult the canonical link symbol table before injecting one.
    دع أضف_دخول_عملية: متغير منطقي =
        (*السياق).الخطة.الخرج == نوع_خرج_ربط.تنفيذي();
    لو (أضف_دخول_عملية
        && (*السياق).الهدف.صيغة_الكائن == صيغة_كائن_هدف.إلف()) {
        دع اسم_الدخول: متجه غ8 = اسم_رمز_دخول_إلف_الافتراضي();
        طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &اسم_الدخول) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الرمز) -> {
            طابق الرمز.الحالة مع
            | حالة_رمز_ربط.معرف(_) -> { أضف_دخول_عملية := خطأ; }
            | _ -> { };
        };
    };
    لو ((الطول(التصديرات) مثل غير_موقع) == 0 && !أضف_دخول_عملية) {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    };

    طابق ابن_كائن_تشغيل_للهدف(
        &(*السياق).الهدف,
        &التصديرات,
        أضف_دخول_عملية
    ) مع
    | نتيجة_كائن_تشغيل_هدف.هدف_غير_مدعوم -> {
        // Other targets keep their existing provider/runtime policy.
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_كائن_تشغيل_هدف.إكمال_تشغيل_فشل(_) -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
        );
    }
    | نتيجة_كائن_تشغيل_هدف.تسلسل_كائن_فشل(_) -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
        );
    }
    | نتيجة_كائن_تشغيل_هدف.تسلسل_كائن_ماتشو_فشل(_) -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
        );
    }
    | نتيجة_كائن_تشغيل_هدف.نجح(البايتات) -> {
        دع بايتات_الخطة: متجه غ8 = انسخ_بايتات_كائن_تشغيل(&البايتات);
        دع معرف_المدخل: معرف_مدخل_ربط = أضف_كائن_إلى_خطة_ربط(
            &متغير (*السياق).الخطة,
            بايتات_الخطة
        );
        دع المدخل: مدخل_ربط = أنشئ_مدخل_كائن_ربط(معرف_المدخل, البايتات);
        أرجع استوعب_مدخل_كائن_في_سياق_الربط(السياق, &المدخل);
    };
}
