استورد compiler.link.model;
استورد compiler.link.symbol_table;
استورد compiler.link.symbol_model;
استورد compiler.backend.target.target_model;
استورد compiler.backend.provider.llvm.ffi.core;
استورد compiler.link.dependency.llvm_names;

// LLVM is a dependency of a linked program only when its object-level undefined
// symbols reference the LLVM C ABI. Code-generation backend identity is never
// consulted here. Dependency spelling is selected for the target platform and
// never discovered from host loader state.

عرف ألحق_عدد_عشري_إل_إل_في_إم(
    الناتج: &متغير متجه غ8,
    القيمة: غير_موقع
): فراغ {
    لو (القيمة >= 10) {
        ألحق_عدد_عشري_إل_إل_في_إم(الناتج, القيمة / 10);
    };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل غ8);
}

عرف ألحق_بايتات_اسم_إل_إل_في_إم(
    الناتج: &متغير متجه غ8,
    المصدر: &متجه غ8
): فراغ {
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(*الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
}

عرف اسم_مكتبة_إل_إل_في_إم_داروين(
    الإصدار_الكبير: غير_موقع
): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بادئة_مكتبة_إل_إل_في_إم_داروين();
    ألحق_عدد_عشري_إل_إل_في_إم(&متغير الاسم, الإصدار_الكبير);
    دع اللاحقة: متجه غ8 = لاحقة_مكتبة_إل_إل_في_إم_داروين();
    ألحق_بايتات_اسم_إل_إل_في_إم(&متغير الاسم, &اللاحقة);
    أرجع الاسم;
}

عرف اسم_مكتبة_إل_إل_في_إم_لينكس(
    الإصدار_الكبير: غير_موقع
): متجه غ8 {
    دع الاسم: متغير متجه غ8 = بادئة_مكتبة_إل_إل_في_إم_لينكس();
    ألحق_عدد_عشري_إل_إل_في_إم(&متغير الاسم, الإصدار_الكبير);
    أرجع الاسم;
}

عرف يحتاج_جدول_الرموز_إلى_إل_إل_في_إم(
    الجدول: &جدول_رموز_ربط
): منطقي {
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < (الطول((*الجدول).الرموز) مثل غير_موقع)) {
        دع الرمز: &رمز_ربط = &(*الجدول).الرموز[فهرس_الرمز];
        طابق (*الرمز).الحالة مع
        | حالة_رمز_ربط.غير_معرف(_) -> {
            لو (اسم_رمز_إل_إل_في_إم_للربط(&(*الرمز).الاسم)) {
                أرجع صواب;
            };
        }
        | _ -> { };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع خطأ;
}

عرف اعتماد_إل_إل_في_إم_للهدف(
    الهدف: &واصف_هدف
): اختيار اعتماد_مكتبة_ديناميكية_ربط {
    دع الإصدار_الكبير: متغير غ32 = 0;
    دع الإصدار_الصغير: متغير غ32 = 0;
    دع إصدار_الرقعة: متغير غ32 = 0;
    اقرأ_إصدار_إل_إل_في_إم(
        &متغير الإصدار_الكبير,
        &متغير الإصدار_الصغير,
        &متغير إصدار_الرقعة
    );

    طابق (*الهدف).المنصة.المنصة مع
    | هوية_منصة.ماك_أو_إس -> {
        دع الاسم: متجه غ8 = اسم_مكتبة_إل_إل_في_إم_داروين(
            الإصدار_الكبير مثل غير_موقع
        );
        أرجع اختيار.بعض(اعتماد_مكتبة_إل_إل_في_إم_باسم(الاسم));
    }
    | هوية_منصة.لينكس -> {
        دع الاسم: متجه غ8 = اسم_مكتبة_إل_إل_في_إم_لينكس(
            الإصدار_الكبير مثل غير_موقع
        );
        أرجع اختيار.بعض(اعتماد_مكتبة_إل_إل_في_إم_باسم(الاسم));
    }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف اسما_اعتماد_إل_إل_في_إم_متساويان(
    الاسم_الأول: &متجه غ8,
    الاسم_الثاني: &متجه غ8
): منطقي {
    لو ((الطول(*الاسم_الأول) مثل غير_موقع)
        != (الطول(*الاسم_الثاني) مثل غير_موقع)) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الاسم_الأول) مثل غير_موقع)) {
        لو ((*الاسم_الأول)[فهرس_البايت] != (*الاسم_الثاني)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف ثبت_اعتماد_إل_إل_في_إم_الموجود(
    الخطة: &متغير خطة_ربط,
    الاعتماد: &اعتماد_مكتبة_ديناميكية_ربط
): منطقي {
    دع فهرس_الاعتماد: متغير غير_موقع = 0;
    بينما (
        فهرس_الاعتماد
            < (الطول((*الخطة).المكتبات_الديناميكية) مثل غير_موقع)
    ) {
        دع الاسم_الحالي: &متجه غ8 =
            &(*الخطة).المكتبات_الديناميكية[فهرس_الاعتماد].الاسم;
        لو (اسما_اعتماد_إل_إل_في_إم_متساويان(
            الاسم_الحالي,
            &(*الاعتماد).الاسم
        )) {
            (*الخطة).المكتبات_الديناميكية[فهرس_الاعتماد].الهوية :=
                هوية_اعتماد_مكتبة_ديناميكية_ربط.إل_إل_في_إم();
            أرجع صواب;
        };
        فهرس_الاعتماد := فهرس_الاعتماد + 1;
    }
    أرجع خطأ;
}

عام عرف أضف_اعتماد_إل_إل_في_إم_عند_الحاجة(
    الخطة: &متغير خطة_ربط,
    الرموز: &جدول_رموز_ربط,
    الهدف: &واصف_هدف
): فراغ {
    لو (!يحتاج_جدول_الرموز_إلى_إل_إل_في_إم(الرموز)) {
        أرجع;
    };

    طابق اعتماد_إل_إل_في_إم_للهدف(الهدف) مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الاعتماد) -> {
        لو (!ثبت_اعتماد_إل_إل_في_إم_الموجود(الخطة, &الاعتماد)) {
            أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(
                الخطة,
                الاعتماد
            );
        };
    };
}
