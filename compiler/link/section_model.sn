استورد std.text.from_bytes;
استورد compiler.link.model;

عام نوع معرف_قسم_ربط = {
    القيمة: طبيعي
};

عام عرف معرف_قسم_ربط_من(القيمة: طبيعي): معرف_قسم_ربط {
    دع المعرف: معرف_قسم_ربط = { القيمة: القيمة };
    أرجع المعرف;
}

// Canonical linker sections keep graph identity plus the original format-section
// identity and bytes. Format providers still own native flags and serialization.
عام نوع صنف_قسم_ربط =
    | شفرة
    | بيانات_للقراءة
    | بيانات_قابلة_للكتابة
    | بيانات_صفرية
    | تصحيح
    | بيانات_تعريفية
    | خاص_بالصيغة
;

عام نوع هوية_اسم_قسم_ربط = {
    اسم_القسم: متجه ط8,
    اسم_الحاوية: اختياري متجه ط8
};

// Preserve exact producer-format section facts required by the selected linker
// provider. Generic link algorithms must not infer executable permissions,
// allocation, or zero-fill semantics from section names.
عام نوع حقائق_صيغة_قسم_ربط =
    | غير_محددة
    | إلف بنوع (طبيعي, طبيعي)
    | ماتشو بنوع طبيعي
    | كوف بنوع طبيعي
    | ويب_أسمبلي بنوع طبيعي
    | سبير_في
;

عام نوع قسم_ربط = {
    المعرف: معرف_قسم_ربط,
    المدخل: معرف_مدخل_ربط,
    فهرس_قسم_الصيغة: طبيعي,
    الاسم: هوية_اسم_قسم_ربط,
    حقائق_الصيغة: حقائق_صيغة_قسم_ربط,
    الصنف: صنف_قسم_ربط,
    المحاذاة: طبيعي,
    الحجم: طبيعي,
    المحتوى: اختياري متجه ط8,
    حي: منطقي
};

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_قسم_ربط(القيمة: &قسم_ربط): قسم_ربط {
    دع الناتج: قسم_ربط = {
        المعرف: (*القيمة).المعرف,
        المدخل: (*القيمة).المدخل,
        فهرس_قسم_الصيغة: (*القيمة).فهرس_قسم_الصيغة,
        الاسم: انسخ_مملوكا_هوية_اسم_قسم_ربط(&(*القيمة).الاسم),
        حقائق_الصيغة: (*القيمة).حقائق_الصيغة,
        الصنف: (*القيمة).الصنف,
        المحاذاة: (*القيمة).المحاذاة,
        الحجم: (*القيمة).الحجم,
        المحتوى: انسخ_اختيار_بايتات(&(*القيمة).المحتوى),
        حي: (*القيمة).حي
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_هوية_اسم_قسم_ربط(القيمة: &هوية_اسم_قسم_ربط): هوية_اسم_قسم_ربط {
    دع الناتج: هوية_اسم_قسم_ربط = {
        اسم_القسم: انسخ_بايتات(&(*القيمة).اسم_القسم),
        اسم_الحاوية: انسخ_اختيار_بايتات(&(*القيمة).اسم_الحاوية)
    };
    أرجع الناتج;
}

عام عرف انسخ_مملوكا_متجه_معرف_قسم_ربط(القيمة: &متجه معرف_قسم_ربط): متجه معرف_قسم_ربط {
    دع الناتج: متغير متجه معرف_قسم_ربط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
