عرف حول_نتيجة_استيعاب_كوف(
    النتيجة: نتيجة_استيعاب_كائن_كوف
): نتيجة_استيعاب_مدخل_ربط {
    طابق النتيجة مع
    | نتيجة_استيعاب_كائن_كوف.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_استيعاب_كائن_كوف.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_استيعاب_كائن_كوف.كائن_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_كوف.إزاحة_غير_صالحة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_كوف.تعريف_رمز_مكرر -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.تعريف_رمز_مكرر()
            );
        }
        | خطأ_استيعاب_كائن_كوف.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | خطأ_استيعاب_كائن_كوف.حل_رمز_يتطلب_سياسة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
