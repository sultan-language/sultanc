    }
    | نتيجة_استيعاب_كائن_ماتشو.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_استيعاب_كائن_ماتشو.كائن_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_ماتشو.إزاحة_غير_صالحة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_ماتشو.تعريف_رمز_مكرر -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.تعريف_رمز_مكرر()
            );
        }
        | خطأ_استيعاب_كائن_ماتشو.حل_رمز_يتطلب_سياسة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        };
    };
}

عام عرف استوعب_مدخل_كائن_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مدخل_ربط {
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> { }
    | _ -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
        );
    };

    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.إلف -> {
        أرجع حول_نتيجة_استيعاب_إلف(
            استوعب_كائن_إلف_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.ماتشو -> {
        أرجع حول_نتيجة_استيعاب_ماتشو(
            استوعب_كائن_ماتشو_في_سياق_الربط(السياق, المدخل)
        );
    }
    | _ -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
        );
    };
}


عرف حول_نتيجة_فهرسة_أرشيف_جنو(
    النتيجة: نتيجة_فهرسة_أرشيف_جنو
): نتيجة_استيعاب_مدخل_ربط {
    طابق النتيجة مع
    | نتيجة_فهرسة_أرشيف_جنو.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_فهرسة_أرشيف_جنو.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
            );
        }
        | خطأ_فهرسة_أرشيف_جنو.جدول_رموز_غير_مدعوم -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
            );
        }
        | خطأ_فهرسة_أرشيف_جنو.حل_رمز_غير_مكتمل -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        };
    };
}

