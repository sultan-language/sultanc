عرف استوعب_مدخل_كوف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مدخل_ربط {
    طابق استوعب_كائن_استيراد_كوف_في_سياق_الربط(السياق, المدخل) مع
    | نتيجة_استيعاب_كائن_استيراد_كوف.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_استيعاب_كائن_استيراد_كوف.غير_صالح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
        );
    }
    | نتيجة_استيعاب_كائن_استيراد_كوف.ليس_كائن_استيراد -> { };
    أرجع حول_نتيجة_استيعاب_كوف(
        استوعب_كائن_كوف_في_سياق_الربط(السياق, المدخل)
    );
}

عام عرف استوعب_مدخل_كائن_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مدخل_ربط {
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> { }
    | _ -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
        );
    };

    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.إلف -> {
        أرجع حول_نتيجة_استيعاب_إلف(
            استوعب_كائن_إلف_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.ماتشو -> {
        أرجع حول_نتيجة_استيعاب_ماتشو(
            استوعب_كائن_ماتشو_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع استوعب_مدخل_كوف_في_سياق_الربط(السياق, المدخل);
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        طابق استوعب_وحدة_ويب_أسمبلي_في_سياق_الربط(السياق, المدخل) مع
        | نتيجة_استيعاب_ويب_أسمبلي.نجح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
        }
        | نتيجة_استيعاب_ويب_أسمبلي.خطأ(_) -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        };
    }
    | هوية_مزود_ربط.سبير_في -> {
        طابق استوعب_وحدة_سبير_في_في_سياق_الربط(السياق, المدخل) مع
        | نتيجة_استيعاب_سبير_في.نجح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
        }
        | نتيجة_استيعاب_سبير_في.خطأ(_) -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        };
    }
    | _ -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
        );
    };
}


عرف حول_نتيجة_فهرسة_أرشيف_جنو(
    النتيجة: نتيجة_فهرسة_أرشيف_جنو
): نتيجة_استيعاب_مدخل_ربط {
    طابق النتيجة مع
    | نتيجة_فهرسة_أرشيف_جنو.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_فهرسة_أرشيف_جنو.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
            );
        }
        | خطأ_فهرسة_أرشيف_جنو.جدول_رموز_غير_مدعوم -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
            );
        }
        | خطأ_فهرسة_أرشيف_جنو.حل_رمز_غير_مكتمل -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        }
        | خطأ_فهرسة_أرشيف_جنو.سعة_رموز_غير_قابلة_للتمثيل -> {
            // A well-formed archive whose members or symbols could not be
            // registered: the link's capacity error, not an invalid archive.
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل()
            );
        };
    };
}

عرف حول_نتيجة_فهرسة_أرشيف_داروين(
    النتيجة: نتيجة_فهرسة_أرشيف_داروين
): نتيجة_استيعاب_مدخل_ربط {
    طابق النتيجة مع
    | نتيجة_فهرسة_أرشيف_داروين.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_فهرسة_أرشيف_داروين.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
            );
        }
        | خطأ_فهرسة_أرشيف_داروين.جدول_رموز_غير_مدعوم -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
            );
        }
        | خطأ_فهرسة_أرشيف_داروين.حل_رمز_غير_مكتمل -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        }
        | خطأ_فهرسة_أرشيف_داروين.سعة_رموز_غير_قابلة_للتمثيل -> {
            // As for GNU archives: the link's capacity error, not an
            // invalid archive.
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل()
            );
        };
    };
}

عرف ابحث_مدخل_ربط_بالمعرف(
    الخطة: &خطة_ربط,
    المعرف: معرف_مدخل_ربط
): اختيار مدخل_ربط {
    دع فهرس_المدخل: متغير غير_موقع = 0;
    بينما (فهرس_المدخل < (الطول((*الخطة).المدخلات) مثل غير_موقع)) {
        دع المدخل: &مدخل_ربط = &(*الخطة).المدخلات[فهرس_المدخل];
        لو (معرفا_مدخل_ربط_متساويان((*المدخل).المعرف, المعرف)) {
            أرجع اختيار.بعض(*المدخل);
        };
        فهرس_المدخل := فهرس_المدخل + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_محتوى_عضو_أرشيف_ربط(
    بايتات_الأرشيف: &متجه غ8,
    بداية_المحتوى: غير_موقع,
    حجم_المحتوى: غير_موقع
): اختيار متجه غ8 {
    دع حجم_الأرشيف: غير_موقع =
        الطول(*بايتات_الأرشيف) مثل غير_موقع;
    لو (بداية_المحتوى > حجم_الأرشيف) {
        أرجع اختيار.لا_شيء();
    };
    لو (حجم_المحتوى > حجم_الأرشيف - بداية_المحتوى) {
        أرجع اختيار.لا_شيء();
    };
    دع بايتات_العضو: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < حجم_المحتوى) {
        دع موضع_البايت: غير_موقع = بداية_المحتوى + فهرس_البايت;
        ألحق(
            بايتات_العضو,
            (*بايتات_الأرشيف)[موضع_البايت]
        );
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.بعض(بايتات_العضو);
}

عرف استخرج_أول_عضو_أرشيف_مطلوب(
    السياق: &متغير سياق_ربط
): نتيجة_استيعاب_مدخل_ربط {
    دع العضو: عضو_أرشيف_ربط;
    طابق أول_عضو_أرشيف_ربط_مطلوب(&(*السياق).الأرشيفات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | اختيار.بعض(العضو_المطلوب) -> { العضو := العضو_المطلوب; };

    دع مدخل_الأرشيف: مدخل_ربط;
    طابق ابحث_مدخل_ربط_بالمعرف(
        &(*السياق).الخطة,
        العضو.المعرف.الأرشيف
    ) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
        );
    }
    | اختيار.بعض(المدخل) -> { مدخل_الأرشيف := المدخل; };

    دع بايتات_العضو: متجه غ8;
    دع مسار_العضو: متغير اختيار نص = اختيار.لا_شيء();
    طابق العضو.المصدر مع
    | مصدر_عضو_أرشيف_ربط.مضمّن(موضع_المحتوى, حجم_المحتوى) -> {
        طابق انسخ_محتوى_عضو_أرشيف_ربط(
            &مدخل_الأرشيف.البايتات,
            موضع_المحتوى,
            حجم_المحتوى
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
            );
        }
        | اختيار.بعض(البايتات) -> { بايتات_العضو := البايتات; };
    }
    | مصدر_عضو_أرشيف_ربط.ملف_خارجي(المسار) -> {
        طابق اقرأ_بايتات_ملف(&المسار) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
            );
        }
        | نتيجة.نجح(البايتات) -> { بايتات_العضو := البايتات; };
        مسار_العضو := اختيار.بعض(المسار);
    };

    دع معرف_المدخل_الجديد: معرف_مدخل_ربط;
    طابق مسار_العضو مع
    | اختيار.لا_شيء -> {
        معرف_المدخل_الجديد := أضف_كائن_إلى_خطة_ربط(
            &متغير (*السياق).الخطة,
            بايتات_العضو
        );
    }
    | اختيار.بعض(المسار) -> {
        معرف_المدخل_الجديد := أضف_مدخل_ملف_إلى_خطة_ربط(
            &متغير (*السياق).الخطة,
            صنف_مدخل_ربط.كائن(),
            بايتات_العضو,
            المسار
        );
    };
    لو (!علّم_عضو_أرشيف_ربط_مستخرجا(
        &متغير (*السياق).الأرشيفات,
        العضو.المعرف,
        معرف_المدخل_الجديد
    )) {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
        );
    };
    أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
}

عرف فهرس_مدخل_أرشيف_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مدخل_ربط {
    لو (تحقق_توقيع_حاوية_أرشيف_رفيع(&(*المدخل).البايتات)) {
        أرجع حول_نتيجة_فهرسة_أرشيف_جنو(
            فهرس_أرشيف_جنو_في_سياق_الربط(السياق, المدخل)
        );
    };
    طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
    | هوية_مزود_ربط.إلف -> {
        أرجع حول_نتيجة_فهرسة_أرشيف_جنو(
            فهرس_أرشيف_جنو_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.ماتشو -> {
        أرجع حول_نتيجة_فهرسة_أرشيف_داروين(
            فهرس_أرشيف_داروين_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع حول_نتيجة_فهرسة_أرشيف_جنو(
            فهرس_أرشيف_جنو_في_سياق_الربط(السياق, المدخل)
        );
    }
    | هوية_مزود_ربط.ويب_أسمبلي -> {
        أرجع حول_نتيجة_فهرسة_أرشيف_جنو(
            فهرس_أرشيف_جنو_في_سياق_الربط(السياق, المدخل)
        );
    }
    | _ -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
        );
    };
}

// Ingests the plan input at فهرس_المدخل into the one symbol table, then
// appends to the plan every archive member that resolution now requests;
// the plan loop ingests those as ordinary object inputs.
عرف استوعب_مدخل_خطة_الربط_في_السياق(
    السياق: &متغير سياق_ربط,
    فهرس_المدخل: غير_موقع
): نتيجة_استيعاب_مدخل_ربط {
    دع المدخل: &مدخل_ربط =
        &(*السياق).الخطة.المدخلات[فهرس_المدخل];
    // A GNU input script contributes no sections or symbols itself; the
    // files it names follow it in the plan (link/model.sn أصل_مدخل_ربط) and
    // are ingested as ordinary inputs.
    دع سكربت_ممتد: منطقي = مدخل_ربط_سكربت_جنو(المدخل);
    دع نتيجة_المدخل: نتيجة_استيعاب_مدخل_ربط;
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> {
        لو (سكربت_ممتد) {
            نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.نجح();
        } وإلا {
            نتيجة_المدخل := استوعب_مدخل_كائن_في_سياق_الربط(
                السياق,
                المدخل
            );
        };
    }
    | صنف_مدخل_ربط.أرشيف -> {
        نتيجة_المدخل := فهرس_مدخل_أرشيف_في_سياق_الربط(
            السياق,
            المدخل
        );
    }
    | صنف_مدخل_ربط.مكتبة_ديناميكية -> {
        طابق مزود_ربط_للهدف(&(*السياق).الهدف) مع
        | هوية_مزود_ربط.إلف -> {
            طابق استوعب_مكتبة_إلف_في_سياق_الربط(السياق, المدخل) مع
            | نتيجة_استيعاب_مكتبة_إلف.نجح -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.نجح();
            }
            | نتيجة_استيعاب_مكتبة_إلف.خطأ(_) -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.خطأ(
                    خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
                );
            };
        }
        | هوية_مزود_ربط.ماتشو -> {
            طابق استوعب_مكتبة_ماتشو_في_سياق_الربط(السياق, المدخل) مع
            | نتيجة_استيعاب_مكتبة_ماتشو.نجح -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.نجح();
            }
            | نتيجة_استيعاب_مكتبة_ماتشو.خطأ(_) -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.خطأ(
                    خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
                );
            };
        }
        | هوية_مزود_ربط.كوف -> {
            طابق استوعب_مكتبة_كوف_في_سياق_الربط(السياق, المدخل) مع
            | نتيجة_استيعاب_مكتبة_كوف.نجح -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.نجح();
            }
            | نتيجة_استيعاب_مكتبة_كوف.خطأ(_) -> {
                نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.خطأ(
                    خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
                );
            };
        }
        | _ -> {
            نتيجة_المدخل := نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.صيغة_كائن_غير_مدعومة()
            );
        };
    };
    طابق نتيجة_المدخل مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ);
    };

    دع يستخرج_أعضاء_الأرشيف: متغير منطقي = صواب;
    بينما (يستخرج_أعضاء_الأرشيف) {
        طابق أول_عضو_أرشيف_ربط_مطلوب(&(*السياق).الأرشيفات) مع
        | اختيار.لا_شيء -> { يستخرج_أعضاء_الأرشيف := خطأ; }
        | اختيار.بعض(_) -> {
            طابق استخرج_أول_عضو_أرشيف_مطلوب(السياق) مع
            | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
            | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
                أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ);
            };
        };
    }
    أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
}

// Inputs are processed in plan order into one symbol table from البداية to
// the end of the plan, including archive members extracted on the way, which
// may transitively request more members. An input appended after the initial
// pass (the host libLLVM in link/dependency/llvm.sn) goes through this same
// path starting at its own index.
عام عرف استوعب_مدخلات_خطة_الربط_من(
    السياق: &متغير سياق_ربط,
    البداية: غير_موقع
): نتيجة_استيعاب_مدخل_ربط {
    دع فهرس_المدخل: متغير غير_موقع = البداية;
    بينما (
        فهرس_المدخل
            < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)
    ) {
        طابق استوعب_مدخل_خطة_الربط_في_السياق(السياق, فهرس_المدخل) مع
        | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
        | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ);
        };
        فهرس_المدخل := فهرس_المدخل + 1;
    }
    أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
}

// Archive members stay lazy until resolution requests them.
عام عرف استوعب_كائنات_خطة_الربط_في_السياق(
    السياق: &متغير سياق_ربط
): نتيجة_استيعاب_مدخل_ربط {
    أرجع استوعب_مدخلات_خطة_الربط_من(السياق, 0);
}

// An executable's entry is a link root even when no object references it, as
// in LLD (lld/ELF/Driver.cpp handleUndefined for --entry, lld/COFF/Driver.cpp
// addUndefined(config->entry)): when only an archive defines it (a SultanC
// program whose objects were packaged in an archive), that member is
// extracted and ingested like any requested
// member, transitively. A name no input defines, or one already resolved, is
// left unchanged and the entry policy decides. Previously a lazy entry stayed
// in its archive, so the link reported a missing entry symbol although the
// library defining it was an input.
عام عرف استخرج_عضو_أرشيف_لرمز_جذر_في_السياق(
    السياق: &متغير سياق_ربط,
    الاسم: &متجه غ8
): نتيجة_استيعاب_مدخل_ربط {
    دع معرف_العضو: معرف_عضو_أرشيف_ربط;
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, الاسم) مع
    | اختيار.لا_شيء -> { أرجع نتيجة_استيعاب_مدخل_ربط.نجح(); }
    | اختيار.بعض(الرمز) -> {
        طابق الرمز.الحالة مع
        | حالة_رمز_ربط.كسول(مدخل_الأرشيف, موضع_العضو) -> {
            دع المعرف: معرف_عضو_أرشيف_ربط = {
                الأرشيف: مدخل_الأرشيف,
                الموضع: موضع_العضو
            };
            معرف_العضو := المعرف;
        }
        | _ -> { أرجع نتيجة_استيعاب_مدخل_ربط.نجح(); };
    };
    لو (!اطلب_استخراج_عضو_أرشيف_ربط(
        &متغير (*السياق).الأرشيفات,
        معرف_العضو
    )) {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
            خطأ_استيعاب_مدخل_ربط.أرشيف_غير_صالح()
        );
    };
    دع البداية: غير_موقع = الطول((*السياق).الخطة.المدخلات) مثل غير_موقع;
    طابق استخرج_أول_عضو_أرشيف_مطلوب(السياق) مع
    | نتيجة_استيعاب_مدخل_ربط.نجح -> { }
    | نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ) -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(الخطأ);
    };
    أرجع استوعب_مدخلات_خطة_الربط_من(السياق, البداية);
}
