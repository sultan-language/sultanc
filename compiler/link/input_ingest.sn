عام نوع خطأ_استيعاب_مدخل_ربط =
    | كائن_غير_صالح
    | أرشيف_غير_صالح
    | تعريف_رمز_مكرر
    | سعة_رموز_غير_قابلة_للتمثيل
    | حل_رمز_غير_مكتمل
    | صيغة_كائن_غير_مدعومة
;

عام نوع نتيجة_استيعاب_مدخل_ربط =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مدخل_ربط
;

عرف حول_نتيجة_استيعاب_إلف(
    النتيجة: نتيجة_استيعاب_كائن_إلف
): نتيجة_استيعاب_مدخل_ربط {
    طابق النتيجة مع
    | نتيجة_استيعاب_كائن_إلف.نجح -> {
        أرجع نتيجة_استيعاب_مدخل_ربط.نجح();
    }
    | نتيجة_استيعاب_كائن_إلف.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_استيعاب_كائن_إلف.كائن_غير_صالح -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_إلف.إزاحة_غير_صالحة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.كائن_غير_صالح()
            );
        }
        | خطأ_استيعاب_كائن_إلف.تعريف_رمز_مكرر -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.تعريف_رمز_مكرر()
            );
        }
        | خطأ_استيعاب_كائن_إلف.سعة_رموز_غير_قابلة_للتمثيل -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | خطأ_استيعاب_كائن_إلف.حل_رمز_يتطلب_سياسة -> {
            أرجع نتيجة_استيعاب_مدخل_ربط.خطأ(
                خطأ_استيعاب_مدخل_ربط.حل_رمز_غير_مكتمل()
            );
        };
    };
}

عرف حول_نتيجة_استيعاب_ماتشو(
