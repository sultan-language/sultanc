                إذا (!غير_معرف_الرمز) {
                    كائن_التعريف := ك;
                    رمز_التعريف := ر;
                };
            } وإلا {
                طابق ابحث_في_الخريطة(&الفائزون, &الرمز.الاسم) مع
                | اختياري.موجود(موضع_الفائز) -> {
                    دع المالك: طبيعي = أصحاب_الفائزين[موضع_الفائز];
                    إذا (المالك != لا_فهرس_ويب_أسمبلي()) {
                        دع المفتاح: متجه ط8 = مفتاح_رمز_كائن_ويب_أسمبلي(&الرمز.الاسم, المالك);
                        طابق ابحث_في_الخريطة(&المعرفة, &المفتاح) مع
                        | اختياري.موجود(فهرس_الرمز) -> {
                            كائن_التعريف := المالك;
                            رمز_التعريف := فهرس_الرمز;
                        }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                    };
                }
                | اختياري.لا_شيء -> { };
            };
            دع الهدف: متغير هدف_رمز_ويب_أسمبلي = هدف_رمز_ويب_أسمبلي.بلا_هدف();
            إذا (كائن_التعريف != لا_فهرس_ويب_أسمبلي()) {
                دع مرجع_المعرف: &رمز_كائن_ويب_أسمبلي = &الكائنات[كائن_التعريف].الرموز[رمز_التعريف];
                دع المعرف: رمز_كائن_ويب_أسمبلي = *مرجع_المعرف;
                إذا (المعرف.الصنف != الرمز.الصنف) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                        خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                    );
                };
                دع مستوردة_التعريف: طبيعي = الطول(الكائنات[كائن_التعريف].استيرادات_الدوال) مثل طبيعي;
                دع عوام_مستوردة_التعريف: طبيعي = الطول(الكائنات[كائن_التعريف].استيرادات_العوام) مثل طبيعي;
                إذا (المعرف.الصنف == صنف_رمز_دالة_ويب_أسمبلي()) {
                    إذا (المعرف.الفهرس < مستوردة_التعريف
                        || المعرف.الفهرس - مستوردة_التعريف >= (الطول(فهارس_الدوال[كائن_التعريف]) مثل طبيعي)) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    };
                    الهدف := هدف_رمز_ويب_أسمبلي.دالة_ناتجة(
                        فهارس_الدوال[كائن_التعريف][المعرف.الفهرس - مستوردة_التعريف]
                    );
                } وإلا إذا (المعرف.الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
                    إذا ((المعرف.الأعلام & علم_رمز_مطلق_ويب_أسمبلي()) != 0) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(المعرف.الإزاحة);
                    } وإلا {
                        إذا (المعرف.الفهرس >= (الطول(الكائنات[كائن_التعريف].القطع) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        الهدف := هدف_رمز_ويب_أسمبلي.بيانات_كائن(
                            كائن_التعريف, المعرف.الفهرس, المعرف.الإزاحة
                        );
                    };
                } وإلا إذا (المعرف.الصنف == صنف_رمز_عام_ويب_أسمبلي()) {
                    إذا (المعرف.الفهرس < عوام_مستوردة_التعريف
                        || المعرف.الفهرس - عوام_مستوردة_التعريف >= (الطول(فهارس_العوام[كائن_التعريف]) مثل طبيعي)) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    };
                    الهدف := هدف_رمز_ويب_أسمبلي.عام_ناتج(
                        فهارس_العوام[كائن_التعريف][المعرف.الفهرس - عوام_مستوردة_التعريف]
                    );
                } وإلا إذا (المعرف.الصنف == صنف_رمز_قسم_ويب_أسمبلي()) {
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(الكائنات[كائن_التعريف].المخصصة) مثل طبيعي)) {
                        إذا (الكائنات[كائن_التعريف].المخصصة[م].الفهرس == المعرف.الفهرس) {
                            الهدف := هدف_رمز_ويب_أسمبلي.قسم_مخصص(كائن_التعريف, م);
                        };
                        م := م + 1;
                    }
                } وإلا {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
            } وإلا {
                // No definition: synthesized by the linker, imported, or
                // (weak data) the null address.
                إذا (الرمز.الصنف == صنف_رمز_دالة_ويب_أسمبلي()) {
                    إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_المنشئات)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.دالة_ناتجة(فهرس_المنشئات);
                    } وإلا {
                        إذا (الرمز.الفهرس >= عدد_دوال_مستوردة) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        دع مرجع_الاستيراد: &استيراد_كائن_ويب_أسمبلي =
                            &الكائنات[ك].الاستيرادات[الكائنات[ك].استيرادات_الدوال[الرمز.الفهرس]];
                        دع المفتاح: متجه ط8 = مفتاح_استيراد_ويب_أسمبلي(
                            &(*مرجع_الاستيراد).الوحدة, &(*مرجع_الاستيراد).الحقل
                        );
                        طابق ابحث_في_الخريطة(&مفاتيح_الاستيراد, &المفتاح) مع
                        | اختياري.موجود(الموضع) -> {
                            الهدف := هدف_رمز_ويب_أسمبلي.دالة_ناتجة(فهارس_الاستيراد_في_صنفها[الموضع]);
                        }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                                خطأ_مزود_ربط_ويب_أسمبلي.رمز_غير_معرف(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                            );
                        };
                    };
                } وإلا إذا (الرمز.الصنف == صنف_رمز_عام_ويب_أسمبلي()) {
                    إذا (!مشترك && مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_المكدس)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عام_ناتج(فهرس_المكدس);
                    } وإلا {
                        إذا (الرمز.الفهرس >= عدد_عوام_مستوردة) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        دع مرجع_الاستيراد: &استيراد_كائن_ويب_أسمبلي =
                            &الكائنات[ك].الاستيرادات[الكائنات[ك].استيرادات_العوام[الرمز.الفهرس]];
                        دع المفتاح: متجه ط8 = مفتاح_استيراد_ويب_أسمبلي(
                            &(*مرجع_الاستيراد).الوحدة, &(*مرجع_الاستيراد).الحقل
                        );
                        طابق ابحث_في_الخريطة(&مفاتيح_الاستيراد, &المفتاح) مع
                        | اختياري.موجود(الموضع) -> {
                            الهدف := هدف_رمز_ويب_أسمبلي.عام_ناتج(فهارس_الاستيراد_في_صنفها[الموضع]);
                        }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                                خطأ_مزود_ربط_ويب_أسمبلي.رمز_غير_معرف(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                            );
                        };
                    };
                } وإلا إذا (الرمز.الصنف == صنف_رمز_جدول_ويب_أسمبلي()) {
                    إذا (!مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_الجدول)) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    الهدف := هدف_رمز_ويب_أسمبلي.جدول_ناتج(0);
                } وإلا إذا (مشترك && الرمز.الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
                    // A shared module defines only __dso_handle (its data
                    // start); the heap, stack and data-end symbols belong to
                    // the program's main module and are reached through
                    // GOT entries, like every undefined data symbol.
                    إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_مقبض_الوحدة)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(0);
                    } وإلا {
                        الهدف := هدف_رمز_ويب_أسمبلي.بلا_هدف();
                    };
                } وإلا إذا (الرمز.الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
                    إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_قاعدة_الكومة)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(قاعدة_الكومة);
                    } وإلا إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_نهاية_البيانات)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(نهاية_البيانات);
                    } وإلا إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_القاعدة_العامة)
                        || مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_أعلى_المكدس)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(حجم_المكدس_ويب_أسمبلي());
                    } وإلا إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_مقبض_الوحدة)
                        || مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_أسفل_المكدس)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(0);
                    } وإلا إذا (مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_نهاية_الكومة)) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(الصفحات * صفحة_ويب_أسمبلي);
                    } وإلا إذا ((الرمز.الأعلام & علم_رمز_ضعيف_ويب_أسمبلي()) != 0) {
                        الهدف := هدف_رمز_ويب_أسمبلي.عنوان_ثابت(0);
                    } وإلا {
                        // Reported only if a relocation uses it.
                        الهدف := هدف_رمز_ويب_أسمبلي.بلا_هدف();
                    };
                } وإلا {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
            };
            ألحق(المحلية, الهدف);
            ر := ر + 1;
        }
        ألحق(الأهداف, المحلية);
        ك := ك + 1;
    }

    // ---- entry and init functions
    دع الدخول: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع اسم_الدخول: متغير متجه ط8 = اسم_رمز_دخول_ويب_أسمبلي();
    طابق (*السياق).الخطة.رمز_الدخول مع
    | اختياري.موجود(الاسم) -> {
        دع مرجع_الاسم: &متجه ط8 = &الاسم;
        اسم_الدخول := انسخ_بايتات(مرجع_الاسم);
    }
    | اختياري.لا_شيء -> { };
    إذا (تنفيذي) {
        طابق ابحث_في_الخريطة(&الفائزون, &اسم_الدخول) مع
        | اختياري.موجود(موضع_الفائز) -> {
            دع المالك: طبيعي = أصحاب_الفائزين[موضع_الفائز];
            إذا (المالك != لا_فهرس_ويب_أسمبلي()) {
                دع المفتاح: متجه ط8 = مفتاح_رمز_كائن_ويب_أسمبلي(&اسم_الدخول, المالك);
                طابق ابحث_في_الخريطة(&المعرفة, &المفتاح) مع
                | اختياري.موجود(فهرس_الرمز) -> {
                    طابق الأهداف[المالك][فهرس_الرمز] مع
                    | هدف_رمز_ويب_أسمبلي.دالة_ناتجة(الفهرس) -> { الدخول := اختياري.موجود(الفهرس); }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            };
        }
        | اختياري.لا_شيء -> { };
        طابق الدخول مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.رمز_دخول_مفقود());
        }
        | اختياري.موجود(_) -> { };
    };
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(الكائنات[ك].دوال_البدء) مثل طبيعي)) {
            دع الأولوية: طبيعي = الكائنات[ك].دوال_البدء[ب].الأولوية;
            دع الرمز: طبيعي = الكائنات[ك].دوال_البدء[ب].الرمز;
            إذا (الرمز >= (الطول(الأهداف[ك]) مثل طبيعي)) {
                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
            };
            طابق الأهداف[ك][الرمز] مع
            | هدف_رمز_ويب_أسمبلي.دالة_ناتجة(الفهرس) -> {
                إذا (الفهرس < عدد_الدوال_المستوردة_الناتجة
                    || الفهرس - عدد_الدوال_المستوردة_الناتجة >= (الطول(أنواع_الدوال_الناتجة) مثل طبيعي)
                    || أنواع_الدوال_الناتجة[الفهرس - عدد_الدوال_المستوردة_الناتجة] != فهرس_النوع_الفارغ) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
                // Stable insertion by priority.
                دع البدء: بدء_ناتج_ويب_أسمبلي = { الأولوية: الأولوية, الدالة: الفهرس };
                دع الموضع: متغير طبيعي = الطول(ناتج_البدء) مثل طبيعي;
                طالما (الموضع > 0 && ناتج_البدء[الموضع - 1].الأولوية > الأولوية) {
                    الموضع := الموضع - 1;
                }
                دع المرتبة: متغير متجه بدء_ناتج_ويب_أسمبلي = [];
                دع س: متغير طبيعي = 0;
                طالما (س < (الطول(ناتج_البدء) مثل طبيعي)) {
                    إذا (س == الموضع) { ألحق(المرتبة, البدء); };
                    دع مرجع_السابق: &بدء_ناتج_ويب_أسمبلي = &ناتج_البدء[س];
                    ألحق(المرتبة, *مرجع_السابق);
                    س := س + 1;
                }
                إذا (الموضع == (الطول(ناتج_البدء) مثل طبيعي)) { ألحق(المرتبة, البدء); };
                ناتج_البدء := المرتبة;
            }
            | _ -> {
                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
            };
            ب := ب + 1;
        }
        ك := ك + 1;
    }
    // The command export wrapper: when init functions exist and no input
    // calls __wasm_call_ctors itself, the exported entry calls it first.
    دع فهرس_الغلاف: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
    دع النوع_المغلف: متغير طبيعي = 0;
    طابق الدخول مع
    | اختياري.موجود(فهرس_الدخول) -> {
        إذا (له_منشئات && !يستدعى_المنشئات) {
            إذا (فهرس_الدخول < عدد_الدوال_المستوردة_الناتجة) {
                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.رمز_دخول_مفقود());
            };
            النوع_المغلف := أنواع_الدوال_الناتجة[فهرس_الدخول - عدد_الدوال_المستوردة_الناتجة];
            فهرس_الغلاف := التالي;
            ألحق(أنواع_الدوال_الناتجة, النوع_المغلف);
            ألحق(مصادر_الدوال, لا_فهرس_ويب_أسمبلي());
            ألحق(مواضع_الدوال_في_كائناتها, 0);
            التالي := التالي + 1;
        };
    }
    | اختياري.لا_شيء -> { };

    // ---- relocations
    دع إزاحات_التشغيل: متغير متجه إزاحة_تشغيل_ويب_أسمبلي = [];
    دع خانات_الجدول: متغير متجه طبيعي = [];
    دع خانة_الدالة: متغير متجه طبيعي = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < التالي) { ألحق(خانة_الدالة, 0); ع := ع + 1; }
    دع شفرات_الكائنات: متغير متجه متجه ط8 = [];
    دع بيانات_الكائنات: متغير متجه متجه ط8 = [];
    دع مخصصات_الكائنات: متغير متجه متجه متجه ط8 = [];
    ك := 0;
    طالما (ك < عدد_الكائنات) {
