استورد compiler.link.archive.ar_container;
استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.backend.target.target_model;
استورد compiler.link.wasm.reader;
استورد std.env.environment;
استورد std.fs.mutation;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_bytes;
استورد std.process.child;
استورد std.text.builder;
استورد std.text.number;
استورد std.text.from_bytes;

عام نوع خطأ_مزود_ربط_ويب_أسمبلي =
    | خطة_غير_مدعومة
    | وحدة_غير_صالحة
    | بيانات_أداة_مفقودة
    | أرشيف_رفيع_بلا_مسار
    | مساحة_عمل_مؤقتة_فشلت بنوع عدد
    | كتابة_مدخل_مؤقت_فشلت بنوع عدد
    | تشغيل_الرابط_فشل بنوع عدد
    | قراءة_المخرج_فشلت بنوع عدد
;

عام نوع نتيجة_مزود_ربط_ويب_أسمبلي =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_ويب_أسمبلي
;

عرف انسخ_نص_ربط_ويب_أسمبلي(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف انسخ_بايتات_ويب_أسمبلي(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عرف اسم_ملف_ويب_أسمبلي_مؤقت(
    البادئة: &نص,
    الفهرس: غير_موقع,
    الامتداد: &نص
): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    ألحق_نصا_بباني_النص(&متغير الباني, البادئة);
    دع الرقم: نص = غير_موقع_إلى_نص(الفهرس);
    ألحق_نصا_بباني_النص(&متغير الباني, &الرقم);
    ألحق_نصا_بباني_النص(&متغير الباني, الامتداد);
    أرجع نص_باني_النص(&الباني);
}

عرف أنشئ_مساحة_عمل_ويب_أسمبلي(): نتيجة نص, عدد {
    دع جذر_المؤقت: نص;
    طابق الدليل_المؤقت() مع
    | نتيجة.خطأ(الحالة) -> { أرجع نتيجة.خطأ(الحالة); }
    | نتيجة.نجح(المسار) -> { جذر_المؤقت := المسار; };

    دع المحاولة: متغير غير_موقع = 0;
    بينما (المحاولة < 128) {
        دع بادئة_الدليل: نص = «sultanc-wasm-link-»;
        دع امتداد_فارغ: نص = «»;
        دع اسم_الدليل: نص = اسم_ملف_ويب_أسمبلي_مؤقت(
            &بادئة_الدليل,
            المحاولة,
            &امتداد_فارغ
        );
        دع المسار: نص = صل_المسار(&جذر_المؤقت, &اسم_الدليل);
        طابق أنشئ_دليلا(&المسار) مع
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المسار); }
        | نتيجة.خطأ(_) -> { };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(-1);
}

عرف نظف_مساحة_عمل_ويب_أسمبلي(
    الدليل: &نص,
    الملفات: &متجه نص
): فراغ {
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الملفات) مثل غير_موقع)) {
        دع مسار_الملف: &نص = &(*الملفات)[الفهرس];
        دع إزالة_الملف: نتيجة عدد, عدد = أزل_ملفا(مسار_الملف);
        الفهرس := الفهرس + 1;
    }
    دع إزالة_الدليل: نتيجة عدد, عدد = أزل_دليلا(الدليل);
}

عرف مدخل_ويب_أسمبلي_صالح(المدخل: &مدخل_ربط): منطقي {
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> {
        أرجع وحدة_ويب_أسمبلي_صالحة(&(*المدخل).البايتات);
    }
    | صنف_مدخل_ربط.أرشيف -> {
        أرجع تحقق_توقيع_حاوية_أرشيف(&(*المدخل).البايتات)
            || تحقق_توقيع_حاوية_أرشيف_رفيع(&(*المدخل).البايتات);
    }
    | صنف_مدخل_ربط.مكتبة_ديناميكية -> { أرجع خطأ; };
}

عرف وحدة_ويب_أسمبلي_وحيدة_نهائية(
    الخطة: &خطة_ربط
): اختيار متجه غ8 {
    لو ((الطول((*الخطة).المدخلات) مثل غير_موقع) != 1) {
        أرجع اختيار.لا_شيء();
    };
    دع المدخل: &مدخل_ربط = &(*الخطة).المدخلات[0];
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> { }
    | _ -> { أرجع اختيار.لا_شيء(); };
    طابق وحدة_ويب_أسمبلي_قابلة_للربط(&(*المدخل).البايتات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(قابلة_للربط) -> {
        لو (قابلة_للربط) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(انسخ_بايتات_ويب_أسمبلي(&(*المدخل).البايتات));
    };
}

عرف امتداد_مدخل_ويب_أسمبلي(المدخل: &مدخل_ربط): نص {
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.أرشيف -> { أرجع «.a»; }
    | _ -> { أرجع «.o»; };
}

عرف جهز_مسار_مدخل_ويب_أسمبلي(
    المدخل: &مدخل_ربط,
    فهرس_المدخل: غير_موقع,
    مساحة_العمل: &نص,
    الملفات_المؤقتة: &متغير متجه نص
): نتيجة نص, خطأ_مزود_ربط_ويب_أسمبلي {
    طابق (*المدخل).المسار مع
    | اختيار.بعض(المسار) -> { أرجع نتيجة.نجح(المسار); }
    | اختيار.لا_شيء -> { };

    لو (
        تحقق_توقيع_حاوية_أرشيف_رفيع(&(*المدخل).البايتات)
    ) {
        أرجع نتيجة.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.أرشيف_رفيع_بلا_مسار()
        );
    };

    دع البادئة: نص = «input-»;
    دع الامتداد: نص = امتداد_مدخل_ويب_أسمبلي(المدخل);
    دع الاسم: نص = اسم_ملف_ويب_أسمبلي_مؤقت(
        &البادئة,
        فهرس_المدخل,
        &الامتداد
    );
    دع المسار: نص = صل_المسار(مساحة_العمل, &الاسم);
    طابق اكتب_البايتات(&المسار, &(*المدخل).البايتات) مع
    | نتيجة.خطأ(الحالة) -> {
        أرجع نتيجة.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.كتابة_مدخل_مؤقت_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(_) -> { };
    دع مسار_التنظيف: نص = انسخ_نص_ربط_ويب_أسمبلي(&المسار);
    ألحق(*الملفات_المؤقتة, مسار_التنظيف);
    أرجع نتيجة.نجح(المسار);
}

عرف ألحق_سياسة_خرج_ويب_أسمبلي(
    السياق: &سياق_ربط,
    الوسائط: &متغير متجه نص
): منطقي {
    دع خيار_المحاكاة: نص = «-m»;
    ألحق(*الوسائط, خيار_المحاكاة);
    لو ((*السياق).الهدف.نموذج_البيانات.عرض_المؤشر > 32) {
        دع محاكاة_ويب64: نص = «wasm64»;
        ألحق(*الوسائط, محاكاة_ويب64);
    } وإلا {
        دع محاكاة_ويب32: نص = «wasm32»;
        ألحق(*الوسائط, محاكاة_ويب32);
    };

    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.وحدة_هدف -> {
        دع خيار_بلا_دخول: نص = «--no-entry»;
        ألحق(*الوسائط, خيار_بلا_دخول);
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        دع خيار_مترابط: نص = «--relocatable»;
        ألحق(*الوسائط, خيار_مترابط);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        دع خيار_مشترك: نص = «--shared»;
        ألحق(*الوسائط, خيار_مشترك);
        طابق (*السياق).الخطة.اسم_المخرج_الديناميكي مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(بايتات_الاسم) -> {
            دع الاسم: نص = من_بايتات(&بايتات_الاسم);
            دع خيار_الاسم: نص = «--soname»;
            ألحق(*الوسائط, خيار_الاسم);
            ألحق(*الوسائط, الاسم);
        };
    }
    | نوع_خرج_ربط.تنفيذي -> {
        لو ((*السياق).الهدف.المنصة.المنصة != هوية_منصة.واسي()) {
            أرجع خطأ;
        };
        طابق (*السياق).الخطة.رمز_الدخول مع
        | اختيار.لا_شيء -> { أرجع خطأ; }
        | اختيار.بعض(بايتات_الدخول) -> {
            دع خيار_الدخول: نص = «--entry»;
            دع اسم_الدخول: نص = من_بايتات(&بايتات_الدخول);
            ألحق(*الوسائط, خيار_الدخول);
            ألحق(*الوسائط, اسم_الدخول);
        };
    };

    دع فهرس_المسار: متغير غير_موقع = 0;
    بينما (
        فهرس_المسار
            < (الطول((*السياق).الخطة.مسارات_التشغيل) مثل غير_موقع)
    ) {
        دع المسار: نص = من_بايتات(
            &(*السياق).الخطة.مسارات_التشغيل[فهرس_المسار]
        );
        دع خيار_المسار: نص = «--rpath»;
        ألحق(*الوسائط, خيار_المسار);
        ألحق(*الوسائط, المسار);
        فهرس_المسار := فهرس_المسار + 1;
    }
    أرجع صواب;
}

عرف شغل_رابط_ويب_أسمبلي(
    السياق: &سياق_ربط,
    البرنامج: &نص
): نتيجة_مزود_ربط_ويب_أسمبلي {
    دع مساحة_العمل: نص;
    طابق أنشئ_مساحة_عمل_ويب_أسمبلي() مع
    | نتيجة.خطأ(الحالة) -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.مساحة_عمل_مؤقتة_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(المسار) -> { مساحة_العمل := المسار; };

    دع الملفات_المؤقتة: متغير متجه نص = [];
    دع الوسائط: متغير متجه نص = [];
    لو (!ألحق_سياسة_خرج_ويب_أسمبلي(السياق, &متغير الوسائط)) {
        نظف_مساحة_عمل_ويب_أسمبلي(&مساحة_العمل, &الملفات_المؤقتة);
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
        );
    };
    دع فهرس_المدخل: متغير غير_موقع = 0;
    بينما (
        فهرس_المدخل
            < (الطول((*السياق).الخطة.المدخلات) مثل غير_موقع)
    ) {
        دع المدخل: &مدخل_ربط =
            &(*السياق).الخطة.المدخلات[فهرس_المدخل];
        لو (!مدخل_ويب_أسمبلي_صالح(المدخل)) {
            نظف_مساحة_عمل_ويب_أسمبلي(
                &مساحة_العمل,
                &الملفات_المؤقتة
            );
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()
            );
        };
        طابق جهز_مسار_مدخل_ويب_أسمبلي(
            المدخل,
            فهرس_المدخل,
            &مساحة_العمل,
            &متغير الملفات_المؤقتة
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            نظف_مساحة_عمل_ويب_أسمبلي(
                &مساحة_العمل,
                &الملفات_المؤقتة
            );
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(الخطأ);
        }
        | نتيجة.نجح(المسار) -> { ألحق(الوسائط, المسار); };
        فهرس_المدخل := فهرس_المدخل + 1;
    }

    دع اسم_المخرج: نص = «output.wasm»;
    دع مسار_المخرج: نص = صل_المسار(&مساحة_العمل, &اسم_المخرج);
    دع خيار_المخرج: نص = «-o»;
    ألحق(الوسائط, خيار_المخرج);
    دع مسار_المخرج_للأداة: نص = انسخ_نص_ربط_ويب_أسمبلي(&مسار_المخرج);
    دع مسار_المخرج_للتنظيف: نص = انسخ_نص_ربط_ويب_أسمبلي(&مسار_المخرج);
    ألحق(الوسائط, مسار_المخرج_للأداة);
    ألحق(الملفات_المؤقتة, مسار_المخرج_للتنظيف);

    دع حالة_الأداة: حالة_إنهاء;
    طابق شغل_وانتظر(البرنامج, &الوسائط) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_ويب_أسمبلي(
            &مساحة_العمل,
            &الملفات_المؤقتة
        );
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.تشغيل_الرابط_فشل(الحالة)
        );
    }
    | نتيجة.نجح(الحالة) -> { حالة_الأداة := الحالة; };

    طابق حالة_الأداة مع
    | حالة_إنهاء.خرج(الحالة) -> {
        لو (الحالة != 0) {
            نظف_مساحة_عمل_ويب_أسمبلي(
                &مساحة_العمل,
                &الملفات_المؤقتة
            );
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                خطأ_مزود_ربط_ويب_أسمبلي.تشغيل_الرابط_فشل(الحالة)
            );
        };
    }
    | حالة_إنهاء.إشارة(الإشارة) -> {
        نظف_مساحة_عمل_ويب_أسمبلي(
            &مساحة_العمل,
            &الملفات_المؤقتة
        );
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.تشغيل_الرابط_فشل(
                256 + الإشارة
            )
        );
    };

    دع الناتج: متجه غ8;
    طابق اقرأ_بايتات_ملف(&مسار_المخرج) مع
    | نتيجة.خطأ(الحالة) -> {
        نظف_مساحة_عمل_ويب_أسمبلي(
            &مساحة_العمل,
            &الملفات_المؤقتة
        );
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.قراءة_المخرج_فشلت(الحالة)
        );
    }
    | نتيجة.نجح(البايتات) -> { الناتج := البايتات; };
    نظف_مساحة_عمل_ويب_أسمبلي(
        &مساحة_العمل,
        &الملفات_المؤقتة
    );

    لو (!وحدة_ويب_أسمبلي_صالحة(&الناتج)) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()
        );
    };
    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(الناتج);
}

عام عرف اربط_ويب_أسمبلي(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_ويب_أسمبلي {
    طابق (*السياق).الخطة.الخرج مع
    | نوع_خرج_ربط.وحدة_هدف -> { }
    | نوع_خرج_ربط.كائن_مترابط -> { }
    | نوع_خرج_ربط.مكتبة_مشتركة -> { }
    | نوع_خرج_ربط.تنفيذي -> {
        لو ((*السياق).الهدف.المنصة.المنصة != هوية_منصة.واسي()) {
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
            );
        };
    }
    | _ -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
        );
    };

    لو ((*السياق).الخطة.الخرج == نوع_خرج_ربط.وحدة_هدف()) {
        طابق وحدة_ويب_أسمبلي_وحيدة_نهائية(&(*السياق).الخطة) مع
        | اختيار.بعض(البايتات) -> {
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(البايتات);
        }
        | اختيار.لا_شيء -> { };
    };

    دع البرنامج: نص;
    طابق (*السياق).الخطة.بيانات_الأداة.ويب_أسمبلي مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.بيانات_أداة_مفقودة()
        );
    }
    | اختيار.بعض(البيانات) -> { البرنامج := انسخ_نص_ربط_ويب_أسمبلي(&البيانات.برنامج_الرابط); };
    أرجع شغل_رابط_ويب_أسمبلي(السياق, &البرنامج);
}
