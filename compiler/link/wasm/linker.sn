    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 2);
    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, (العنوان + صفحة_ويب_أسمبلي - 1) / صفحة_ويب_أسمبلي);
    دع جولة_الاستيراد: متغير طبيعي = 0;
    طالما (جولة_الاستيراد < 2) {
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(الاستيرادات) مثل طبيعي)) {
            دع صنف_الجولة: متغير طبيعي = 0;
            إذا (جولة_الاستيراد == 1) { صنف_الجولة := 3; };
            إذا (الاستيرادات[ي].الصنف == صنف_الجولة) {
                ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الاستيرادات[ي].الوحدة);
                ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الاستيرادات[ي].الحقل);
                ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, صنف_الجولة);
                إذا (صنف_الجولة == 0) {
                    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, الاستيرادات[ي].الوصف);
                } وإلا {
                    ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, الاستيرادات[ي].الوصف);
                    إذا (الاستيرادات[ي].قابل_للتغيير) {
                        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 1);
                    } وإلا {
                        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
                    };
                };
            };
            ي := ي + 1;
        }
        جولة_الاستيراد := جولة_الاستيراد + 1;
    }
    إذا (يستورد_الجدول) {
        دع اسم_الجدول: متجه ط8 = بايتات_من_نص(«__indirect_function_table»);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &الوحدة_البيئية);
        ألحق_اسم_ويب_أسمبلي(&متغير قسم_الاستيراد, &اسم_الجدول);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 1);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0x70);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الاستيراد, 0);
    };
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 2, &قسم_الاستيراد);
    دع قسم_الدوال: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, عدد_الدوال_المعرفة);
    ع := 0;
    طالما (ع < عدد_الدوال_المعرفة) {
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_الدوال, أنواع_الدوال_الناتجة[ع]);
        ع := ع + 1;
    }
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 3, &قسم_الدوال);
    إذا (عدد_العوام_المعرفة > 0) {
        دع قسم_العوام: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_العوام, عدد_العوام_المعرفة);
        ك := 0;
        طالما (ك < عدد_الكائنات) {
            دع ج: متغير طبيعي = 0;
            طالما (ج < (الطول(الكائنات[ك].العوام) مثل طبيعي)) {
                إذا (!عوام_مهملة[ك][ج]) {
                    دع مرجع_العام: &عام_كائن_ويب_أسمبلي = &الكائنات[ك].العوام[ج];
                    دع أول_رمز: ط8 = (*مرجع_العام).التهيئة[0];
                    إذا (أول_رمز == (0x23 مثل ط8) || أول_رمز == (0xD2 مثل ط8)) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, (*مرجع_العام).نوع_القيمة);
                    إذا ((*مرجع_العام).قابل_للتغيير) {
                        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 1);
                    } وإلا {
                        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0);
                    };
                    ألحق_بايتات_ويب_أسمبلي(&متغير قسم_العوام, &(*مرجع_العام).التهيئة);
                };
                ج := ج + 1;
            }
            ك := ك + 1;
        }
        ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 6, &قسم_العوام);
    };
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 10, &قسم_الشفرة);
    إذا (عدد_القطع > 0) {
        ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 11, &قسم_البيانات);
    };
    خ := 0;
    طالما (خ < عدد_المخصصة) {
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &المخصصة_الناتجة[خ].الاسم, &محتويات_المخصصة[خ]);
        خ := خ + 1;
    }
    دع اسم_الربط: متجه ط8 = بايتات_من_نص(«linking»);
    ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &اسم_الربط, &قسم_الربط);
    إذا (عدد_إزاحات_الشفرة > 0) {
        دع المحتوى: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, فهرس_قسم_الشفرة);
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, عدد_إزاحات_الشفرة);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &إزاحات_الشفرة);
        دع الاسم: متجه ط8 = بايتات_من_نص(«reloc.CODE»);
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
    };
    إذا (عدد_إزاحات_البيانات > 0) {
        دع المحتوى: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, فهرس_قسم_البيانات);
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, عدد_إزاحات_البيانات);
        ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &إزاحات_البيانات);
        دع الاسم: متجه ط8 = بايتات_من_نص(«reloc.DATA»);
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
    };
    خ := 0;
    طالما (خ < عدد_المخصصة) {
        إذا (أعداد_إزاحات_المخصصة[خ] > 0) {
            دع المحتوى: متغير متجه ط8 = [];
            ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, أول_مخصص + خ);
            ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, أعداد_إزاحات_المخصصة[خ]);
            ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &إزاحات_المخصصة[خ]);
            دع الاسم: متغير متجه ط8 = بايتات_من_نص(«reloc.»);
            ألحق_بايتات_ويب_أسمبلي(&متغير الاسم, &المخصصة_الناتجة[خ].الاسم);
            ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
        };
        خ := خ + 1;
    }
    // target_features: every feature an input uses, once.
    دع الميزات: متغير متجه متجه ط8 = [];
    دع أسماء_الميزات: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الكائنات[ك].الميزات) مثل طبيعي)) {
            دع مرجع_الميزة: &متجه ط8 = &الكائنات[ك].الميزات[م];
            دع الميزة: متجه ط8 = انسخ_بايتات(مرجع_الميزة);
            طابق ابحث_في_الخريطة(&أسماء_الميزات, &الميزة) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> {
                دع نسخة: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الميزة);
                دع موضع_الميزة: طبيعي = الطول(الميزات) مثل طبيعي;
                طابق أدرج_في_الخريطة(&متغير أسماء_الميزات, نسخة, موضع_الميزة) مع
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | نتيجة.نجح(_) -> { };
                ألحق(الميزات, الميزة);
            };
            م := م + 1;
        }
        ك := ك + 1;
    }
    إذا ((الطول(الميزات) مثل طبيعي) > 0) {
        دع المحتوى: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير المحتوى, الطول(الميزات) مثل طبيعي);
        ع := 0;
        طالما (ع < (الطول(الميزات) مثل طبيعي)) {
            ألحق_بايت_ويب_أسمبلي(&متغير المحتوى, 0x2B);
            ألحق_اسم_ويب_أسمبلي(&متغير المحتوى, &الميزات[ع]);
            ع := ع + 1;
        }
        دع الاسم: متجه ط8 = بايتات_من_نص(«target_features»);
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &الاسم, &المحتوى);
    };
    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(الملف);
}
// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عرف انسخ_مملوكا__متجه_طبيعي(القيمة: &متجه طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}
