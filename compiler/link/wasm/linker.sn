استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.backend.target.target_model;
استورد compiler.link.wasm.reader;

// WebAssembly link output. SultanC runs no external linker: an output is
// produced only when it needs no linking, that is a target module whose one
// input is already a final module (no `linking` section). Merging relocatable
// WebAssembly objects (the native wasm32 writer's and LLVM's output), and
// therefore every WASI command, library and relocatable output, needs an
// internal WebAssembly linker that SultanC does not have yet; such links are
// reported as unsupported (link/provider.sn) instead of being handed to
// wasm-ld as before.
عام نوع خطأ_مزود_ربط_ويب_أسمبلي =
    | خطة_غير_مدعومة
    | وحدة_غير_صالحة
;

عام نوع نتيجة_مزود_ربط_ويب_أسمبلي =
    | نجح بنوع متجه غ8
    | خطأ بنوع خطأ_مزود_ربط_ويب_أسمبلي
;

عرف انسخ_بايتات_ويب_أسمبلي(المصدر: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*المصدر) مثل غير_موقع)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عام عرف اربط_ويب_أسمبلي(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_ويب_أسمبلي {
    لو ((*السياق).الخطة.الخرج != نوع_خرج_ربط.وحدة_هدف()) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
        );
    };
    لو ((الطول((*السياق).الخطة.المدخلات) مثل غير_موقع) != 1) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
        );
    };
    دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[0];
    طابق (*المدخل).الصنف مع
    | صنف_مدخل_ربط.كائن -> { }
    | _ -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
        );
    };
    طابق وحدة_ويب_أسمبلي_قابلة_للربط(&(*المدخل).البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
            خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()
        );
    }
    | اختيار.بعض(قابلة_للربط) -> {
        لو (قابلة_للربط) {
            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة()
            );
        };
    };
    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(
        انسخ_بايتات_ويب_أسمبلي(&(*المدخل).البايتات)
    );
}
