                    ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 1);
                } وإلا {
                    ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0);
                };
                ألحق_بايتات_ويب_أسمبلي(&متغير قسم_العوام, &(*مرجع_العام).التهيئة);
            };
            ج := ج + 1;
        }
        ك := ك + 1;
    }
    دع م_عام: متغير طبيعي = 0;
    طالما (م_عام < (الطول(المؤشرات) مثل طبيعي)) {
        إذا (المؤشرات[م_عام].داخلي) {
            // A mutable i32 set by __wasm_apply_data_relocs.
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x7F);
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 1);
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x41);
            ألحق_سليب_ويب_أسمبلي(&متغير قسم_العوام, 0);
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x0B);
        };
        م_عام := م_عام + 1;
    }
    م_عام := 0;
    طالما (م_عام < (الطول(قيم_عوام_التصدير) مثل طبيعي)) {
        // A data address export: immutable, relative to __memory_base.
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x7F);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0);
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x41);
        ألحق_سليب_ويب_أسمبلي(&متغير قسم_العوام, قيمة_موقعة_32_من_بتات(قيم_عوام_التصدير[م_عام]));
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العوام, 0x0B);
        م_عام := م_عام + 1;
    }
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 6, &قسم_العوام);
    // export
    دع قسم_التصدير: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_التصدير, عدد_التصديرات);
    ألحق_بايتات_ويب_أسمبلي(&متغير قسم_التصدير, &التصديرات);
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 7, &قسم_التصدير);
    // element: the table slots from index 1 (a shared module: from
    // __table_base)
    إذا ((الطول(خانات_الجدول) مثل طبيعي) > 0) {
        دع قسم_العناصر: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_العناصر, 1);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_العناصر, 0);
        إذا (مشترك) {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العناصر, 0x23);
            ألحق_ليب_ويب_أسمبلي(&متغير قسم_العناصر, عام_قاعدة_الجدول);
        } وإلا {
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_العناصر, 0x41);
            ألحق_سليب_ويب_أسمبلي(&متغير قسم_العناصر, 1);
        };
        ألحق_بايت_ويب_أسمبلي(&متغير قسم_العناصر, 0x0B);
        ألحق_ليب_ويب_أسمبلي(&متغير قسم_العناصر, الطول(خانات_الجدول) مثل طبيعي);
        ع := 0;
        طالما (ع < (الطول(خانات_الجدول) مثل طبيعي)) {
            ألحق_ليب_ويب_أسمبلي(&متغير قسم_العناصر, خانات_الجدول[ع]);
            ع := ع + 1;
        }
        ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 9, &قسم_العناصر);
    };
    // data count: the data segments, for validators of bulk-memory modules
    دع قسم_عدد_البيانات: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_عدد_البيانات, عدد_القطع_المكتوبة);
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 12, &قسم_عدد_البيانات);
    // code
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 10, &قسم_الشفرة);
    // data
    دع قسم_البيانات_الكامل: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات_الكامل, عدد_القطع_المكتوبة);
    ألحق_بايتات_ويب_أسمبلي(&متغير قسم_البيانات_الكامل, &قسم_البيانات);
    ألحق_قسم_ناتج_ويب_أسمبلي(&متغير الملف, 11, &قسم_البيانات_الكامل);
    // custom sections, in first-seen order
    دع خ: متغير طبيعي = 0;
    طالما (خ < (الطول(المخصصة_الناتجة) مثل طبيعي)) {
        دع المحتوى: متغير متجه ط8 = [];
        ك := 0;
        طالما (ك < عدد_الكائنات) {
            دع م: متغير طبيعي = 0;
            طالما (م < (الطول(مخصصة_الكائنات[ك]) مثل طبيعي)) {
                إذا (مخصصة_الكائنات[ك][م] == خ) {
                    ألحق_بايتات_ويب_أسمبلي(&متغير المحتوى, &مخصصات_الكائنات[ك][م]);
                };
                م := م + 1;
            }
            ك := ك + 1;
        }
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &المخصصة_الناتجة[خ].الاسم, &المحتوى);
        خ := خ + 1;
    }
    // name: function names subsection (1)
    دع أسماء: متغير متجه ط8 = [];
    دع عدد_الأسماء: متغير طبيعي = 0;
    دع قائمة_الأسماء: متغير متجه ط8 = [];
    ع := 0;
    طالما (ع < التالي) {
        إذا ((الطول(أسماء_الدوال[ع]) مثل طبيعي) > 0) {
            ألحق_ليب_ويب_أسمبلي(&متغير قائمة_الأسماء, ع);
            ألحق_اسم_ويب_أسمبلي(&متغير قائمة_الأسماء, &أسماء_الدوال[ع]);
            عدد_الأسماء := عدد_الأسماء + 1;
        };
        ع := ع + 1;
    }
    إذا (عدد_الأسماء > 0) {
        دع القسم_الفرعي: متغير متجه ط8 = [];
        ألحق_ليب_ويب_أسمبلي(&متغير القسم_الفرعي, عدد_الأسماء);
        ألحق_بايتات_ويب_أسمبلي(&متغير القسم_الفرعي, &قائمة_الأسماء);
        ألحق_بايت_ويب_أسمبلي(&متغير أسماء, 1);
        ألحق_ليب_ويب_أسمبلي(&متغير أسماء, الطول(القسم_الفرعي) مثل طبيعي);
        ألحق_بايتات_ويب_أسمبلي(&متغير أسماء, &القسم_الفرعي);
        دع اسم_القسم: متجه ط8 = بايتات_من_نص(«name»);
        ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(&متغير الملف, &اسم_القسم, &أسماء);
    };
    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(الملف);
}

// The name of an object's symbol for a diagnostic.
عرف اسم_رمز_إزاحة_ويب_أسمبلي(الكائن: &كائن_ويب_أسمبلي, الفهرس: طبيعي): متجه ط8 {
    إذا (الفهرس >= (الطول((*الكائن).الرموز) مثل طبيعي)) {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
    دع مرجع_الاسم: &متجه ط8 = &(*الكائن).الرموز[الفهرس].الاسم;
    دع الاسم: متجه ط8 = انسخ_بايتات(مرجع_الاسم);
    أرجع الاسم;
}

عرف بادئة_مجموعة_ويب_أسمبلي(الاسم: &متجه ط8, البادئة: نص): منطقي {
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    دع الطول_الكلي: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (الطول_الكلي < طول_البادئة) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_البادئة) {
        إذا ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    // `.rodata` or `.rodata.<suffix>`, never `.rodatax`.
    أرجع الطول_الكلي == طول_البادئة || (*الاسم)[طول_البادئة] == (0x2E مثل ط8);
}

// The key of a GOT entry: the name of a global symbol, or the name and
// object of a local one.
عرف مفتاح_مؤشر_ويب_أسمبلي(الرمز: &رمز_كائن_ويب_أسمبلي, الكائن: طبيعي): متجه ط8 {
    إذا (((*الرمز).الأعلام & علم_رمز_محلي_ويب_أسمبلي()) != 0) {
        أرجع مفتاح_رمز_كائن_ويب_أسمبلي(&(*الرمز).الاسم, الكائن);
    };
    أرجع انسخ_بايتات_ويب_أسمبلي(&(*الرمز).الاسم);
}

// Whether a shared module reaches this symbol through an imported GOT entry
// (wasm-ld requiresGOTAccess without -Bsymbolic): every undefined symbol,
// and every definition of default visibility, which another module may
// preempt. Local and hidden definitions (including the linker's own
// __dso_handle and __wasm_call_ctors) are addressed relative to the bases.
عرف رمز_يحتاج_مؤشرا_ويب_أسمبلي(
    الكائنات: &متجه كائن_ويب_أسمبلي,
    الكائن: طبيعي,
    الفهرس: طبيعي,
    الفائزون: &الخريطة<متجه ط8, طبيعي>,
    أصحاب_الفائزين: &متجه طبيعي,
    المعرفة: &الخريطة<متجه ط8, طبيعي>
): منطقي {
    دع الرمز: &رمز_كائن_ويب_أسمبلي = &(*الكائنات)[الكائن].الرموز[الفهرس];
    دع الأعلام: طبيعي = (*الرمز).الأعلام;
    دع الرمز_بلا_تعريف: منطقي = (الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0;
    إذا ((الأعلام & علم_رمز_محلي_ويب_أسمبلي()) != 0) { أرجع الرمز_بلا_تعريف; };
    إذا (!الرمز_بلا_تعريف && (الأعلام & علم_رمز_مخفي_ويب_أسمبلي()) != 0) { أرجع خطأ; };
    طابق ابحث_في_الخريطة(الفائزون, &(*الرمز).الاسم) مع
    | اختياري.موجود(موضع_الفائز) -> {
        دع المالك: طبيعي = (*أصحاب_الفائزين)[موضع_الفائز];
        إذا (المالك != لا_فهرس_ويب_أسمبلي()) {
            دع المفتاح: متجه ط8 = مفتاح_رمز_كائن_ويب_أسمبلي(&(*الرمز).الاسم, المالك);
            طابق ابحث_في_الخريطة(المعرفة, &المفتاح) مع
            | اختياري.موجود(فهرس_المعرف) -> {
                إذا (((*الكائنات)[المالك].الرموز[فهرس_المعرف].الأعلام & علم_رمز_مخفي_ويب_أسمبلي()) != 0) {
                    أرجع خطأ;
                };
            }
            | اختياري.لا_شيء -> { };
            أرجع صواب;
        };
    }
    | اختياري.لا_شيء -> { };
    إذا (اسم_ويب_أسمبلي_يطابق_نصا(&(*الرمز).الاسم, «__dso_handle»)
        || اسم_ويب_أسمبلي_يطابق_نصا(&(*الرمز).الاسم, «__wasm_call_ctors»)) {
        أرجع خطأ;
    };
    أرجع صواب;
}

// Whether any object references a name that resolved to this shared-module
// input (an as-needed dependency is recorded only then).
عرف مكتبة_ويب_أسمبلي_مستخدمة(
    الكائنات: &متجه كائن_ويب_أسمبلي,
    الرموز: &جدول_رموز_ربط,
    المكتبة: معرف_مدخل_ربط
): منطقي {
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(*الكائنات) مثل طبيعي)) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*الكائنات)[ك].الرموز) مثل طبيعي)) {
            دع الأعلام: طبيعي = (*الكائنات)[ك].الرموز[ر].الأعلام;
            إذا ((الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0
                && (الأعلام & علم_رمز_محلي_ويب_أسمبلي()) == 0) {
                طابق ابحث_رمز_ربط_بالاسم(الرموز, &(*الكائنات)[ك].الرموز[ر].الاسم) مع
                | اختياري.موجود(الرمز_العام) -> {
                    طابق الرمز_العام.الحالة مع
                    | حالة_رمز_ربط.ديناميكي(المدخل) -> {
                        إذا (المدخل.القيمة == المكتبة.القيمة) { أرجع صواب; };
                    }
                    | _ -> { };
                }
                | اختياري.لا_شيء -> { };
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }
    أرجع خطأ;
}

// The output address (relative to the data start) of a relocated field at
// a DATA-section offset of an object.
عرف عنوان_حقل_بيانات_ويب_أسمبلي(
    الكائن: &كائن_ويب_أسمبلي,
    العناوين: &متجه طبيعي,
    الموضع: طبيعي
): اختياري طبيعي {
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول((*الكائن).القطع) مثل طبيعي)) {
        إذا (الموضع >= (*الكائن).القطع[ق].بداية_البايتات
            && الموضع < (*الكائن).القطع[ق].بداية_البايتات + (*الكائن).القطع[ق].الحجم) {
            أرجع اختياري.موجود((*العناوين)[ق] + (الموضع - (*الكائن).القطع[ق].بداية_البايتات));
        };
        ق := ق + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Writes one relocated field: العرض 1 padded uleb (5 bytes), 2 padded sleb,
// 3 u32, 4 u64; 13 and 14 are function offsets, written after layout.
عرف اكتب_حقل_إزاحة_ويب_أسمبلي(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    العرض: طبيعي,
    القيمة: طبيعي,
    قيمة_موقعة: عدد,
    موقعة: منطقي
): اختياري خطأ_مزود_ربط_ويب_أسمبلي {
    إذا (العرض == 1) {
        إذا (القيمة > 4294967295) { أرجع اختياري.موجود(خطأ_مزود_ربط_ويب_أسمبلي.تجاوز_الذاكرة()); };
        اكتب_ليب_مبطن_ويب_أسمبلي_عند(البايتات, الموضع, القيمة);
    } وإلا إذا (العرض == 2) {
        إذا (قيمة_موقعة < -2147483648 || قيمة_موقعة > 2147483647) {
            أرجع اختياري.موجود(خطأ_مزود_ربط_ويب_أسمبلي.تجاوز_الذاكرة());
        };
        اكتب_سليب_مبطن_ويب_أسمبلي_عند(البايتات, الموضع, قيمة_موقعة);
    } وإلا إذا (العرض == 3) {
        إذا (القيمة > 4294967295) { أرجع اختياري.موجود(خطأ_مزود_ربط_ويب_أسمبلي.تجاوز_الذاكرة()); };
        اكتب_ط32_ويب_أسمبلي_عند(البايتات, الموضع, القيمة);
    } وإلا إذا (العرض == 4) {
        اكتب_ط64_ويب_أسمبلي_عند(البايتات, الموضع, القيمة);
    };
    أرجع اختياري.لا_شيء();
}

// ------------------------------------------------------ relocatable output --

// The relocatable link (`--emit=reloc`, wasm-ld -r): the objects merged into
// one relocatable object of the same format, which a later link consumes.
// Functions, globals and data segments keep their identity (segments are not
// merged and keep their names and alignment); every non-local name becomes
// one symbol (its winning definition, or one undefined symbol imported from
// the module and field its first reference names); local symbols stay one
// per input symbol; one section symbol names each output custom section.
// Relocations are rewritten to the output offsets, symbols and types, and
// every relocated field gets its provisional value in the output's index
// spaces, so the object is a valid module, as LLVM writes it. COMDAT groups
// that lost are dropped; the kept ones are recorded again.
عرف بحث_جسم_ويب_أسمبلي(الأجسام: &متجه جسم_كائن_ويب_أسمبلي, الموضع: طبيعي): اختياري طبيعي {
    دع الأدنى: متغير طبيعي = 0;
    دع الأعلى: متغير طبيعي = الطول(*الأجسام) مثل طبيعي;
    طالما (الأدنى < الأعلى) {
        دع الوسط: طبيعي = (الأدنى + الأعلى) / 2;
        إذا ((*الأجسام)[الوسط].النهاية <= الموضع) {
            الأدنى := الوسط + 1;
        } وإلا إذا ((*الأجسام)[الوسط].البداية > الموضع) {
            الأعلى := الوسط;
        } وإلا {
            أرجع اختياري.موجود(الوسط);
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف بحث_قطعة_ويب_أسمبلي(القطع: &متجه قطعة_كائن_ويب_أسمبلي, الموضع: طبيعي): اختياري طبيعي {
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(*القطع) مثل طبيعي)) {
        إذا (الموضع >= (*القطع)[ق].بداية_البايتات
            && الموضع < (*القطع)[ق].بداية_البايتات + (*القطع)[ق].الحجم) {
            أرجع اختياري.موجود(ق);
        };
        ق := ق + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ألحق_رمز_ويب_أسمبلي_مشفر(
    الجدول: &متغير متجه ط8,
    الرمز: &رمز_كائن_ويب_أسمبلي
): فراغ {
    ألحق_بايت_ويب_أسمبلي(الجدول, (*الرمز).الصنف);
    ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الأعلام);
    دع غير_معرف_الرمز: منطقي = ((*الرمز).الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0;
    إذا ((*الرمز).الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
        ألحق_اسم_ويب_أسمبلي(الجدول, &(*الرمز).الاسم);
        إذا (!غير_معرف_الرمز) {
            ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الفهرس);
            ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الإزاحة);
            ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الحجم);
        };
    } وإلا إذا ((*الرمز).الصنف == صنف_رمز_قسم_ويب_أسمبلي()) {
        ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الفهرس);
    } وإلا {
        ألحق_ليب_ويب_أسمبلي(الجدول, (*الرمز).الفهرس);
        إذا (!غير_معرف_الرمز || ((*الرمز).الأعلام & علم_رمز_اسم_صريح_ويب_أسمبلي()) != 0) {
            ألحق_اسم_ويب_أسمبلي(الجدول, &(*الرمز).الاسم);
        };
    };
}

عرف اربط_كائن_مترابط_ويب_أسمبلي(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_ويب_أسمبلي {
    دع الكائنات: متغير متجه كائن_ويب_أسمبلي = [];
    دع مداخل_الكائنات: متغير متجه طبيعي = [];
    دع دوال_مهملة: متغير متجه متجه منطقي = [];
    دع قطع_مهملة: متغير متجه متجه منطقي = [];
    دع عوام_مهملة: متغير متجه متجه منطقي = [];
    دع كومدات_مهملة: متغير متجه متجه منطقي = [];
    دع المعرفة: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع الأنواع: متغير متجه متجه ط8 = [];
    دع خرائط_الأنواع: متغير متجه متجه طبيعي = [];
    دع فهرس_النوع_الفارغ: متغير طبيعي = 0;
    دع الفائزون: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع أصحاب_الفائزين: متغير متجه طبيعي = [];
    طابق اجمع_مدخلات_ويب_أسمبلي(
        السياق, خطأ, خطأ,
        &متغير الكائنات, &متغير مداخل_الكائنات,
        &متغير دوال_مهملة, &متغير قطع_مهملة, &متغير عوام_مهملة, &متغير كومدات_مهملة,
        &متغير المعرفة, &متغير الأنواع, &متغير خرائط_الأنواع, &متغير فهرس_النوع_الفارغ,
        &متغير الفائزون, &متغير أصحاب_الفائزين
    ) مع
    | نتيجة_جمع_ويب_أسمبلي.خطأ(الخطأ) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(الخطأ); }
    | نتيجة_جمع_ويب_أسمبلي.تمرير(_) -> {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
    }
    | نتيجة_جمع_ويب_أسمبلي.جاهز -> { };
    دع عدد_الكائنات: طبيعي = الطول(الكائنات) مثل طبيعي;
    دع ك: متغير طبيعي = 0;

    // ---- imports of names no input defines, one per name
    دع الاستيرادات: متغير متجه استيراد_ناتج_ويب_أسمبلي = [];
    دع استيرادات_الأسماء: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع عدد_الدوال_المستوردة: متغير طبيعي = 0;
    دع عدد_العوام_المستوردة: متغير طبيعي = 0;
    دع فهارس_الاستيراد_في_صنفها: متغير متجه طبيعي = [];
    دع يستورد_الجدول: متغير منطقي = خطأ;
    دع الجولة: متغير طبيعي = 0;
    طالما (الجولة < 2) {
        ك := 0;
        طالما (ك < عدد_الكائنات) {
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
                دع مرجع_الرمز: &رمز_كائن_ويب_أسمبلي = &الكائنات[ك].الرموز[ر];
                دع الرمز: رمز_كائن_ويب_أسمبلي = *مرجع_الرمز;
                إذا (الرمز.الصنف == صنف_رمز_جدول_ويب_أسمبلي()) { يستورد_الجدول := صواب; };
                دع صنف_مطلوب: متغير طبيعي = صنف_رمز_دالة_ويب_أسمبلي();
                إذا (الجولة == 1) { صنف_مطلوب := صنف_رمز_عام_ويب_أسمبلي(); };
                إذا (الرمز.الصنف == صنف_مطلوب
                    && (الرمز.الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0) {
                    دع له_تعريف: متغير منطقي = خطأ;
                    طابق ابحث_في_الخريطة(&الفائزون, &الرمز.الاسم) مع
                    | اختياري.موجود(موضع_الفائز) -> {
                        له_تعريف := أصحاب_الفائزين[موضع_الفائز] != لا_فهرس_ويب_أسمبلي();
                    }
                    | اختياري.لا_شيء -> { };
                    طابق ابحث_في_الخريطة(&استيرادات_الأسماء, &الرمز.الاسم) مع
                    | اختياري.موجود(_) -> { له_تعريف := صواب; }
                    | اختياري.لا_شيء -> { };
                    إذا (!له_تعريف) {
                        دع فهارس_الصنف: متغير متجه طبيعي = [];
                        إذا (الجولة == 0) {
                            دع مرجع_الفهارس: &متجه طبيعي = &الكائنات[ك].استيرادات_الدوال;
                            فهارس_الصنف := انسخ_مملوكا__متجه_طبيعي(مرجع_الفهارس);
                        } وإلا {
                            دع مرجع_الفهارس: &متجه طبيعي = &الكائنات[ك].استيرادات_العوام;
                            فهارس_الصنف := انسخ_مملوكا__متجه_طبيعي(مرجع_الفهارس);
                        };
                        إذا (الرمز.الفهرس >= (الطول(فهارس_الصنف) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        دع مرجع_الاستيراد: &استيراد_كائن_ويب_أسمبلي =
                            &الكائنات[ك].الاستيرادات[فهارس_الصنف[الرمز.الفهرس]];
                        دع الاستيراد: استيراد_كائن_ويب_أسمبلي = *مرجع_الاستيراد;
                        دع الوصف: متغير طبيعي = الاستيراد.الوصف;
                        إذا (الجولة == 0) {
                            إذا (الوصف >= (الطول(خرائط_الأنواع[ك]) مثل طبيعي)) {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                            };
                            الوصف := خرائط_الأنواع[ك][الوصف];
                        };
                        دع الموضع: طبيعي = الطول(الاستيرادات) مثل طبيعي;
                        دع نسخة_الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم);
                        طابق أدرج_في_الخريطة(&متغير استيرادات_الأسماء, نسخة_الاسم, الموضع) مع
                        | نتيجة.خطأ(_) -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        }
                        | نتيجة.نجح(_) -> { };
                        دع الناتج: استيراد_ناتج_ويب_أسمبلي = {
                            الوحدة: انسخ_بايتات_ويب_أسمبلي(&الاستيراد.الوحدة),
                            الحقل: انسخ_بايتات_ويب_أسمبلي(&الاستيراد.الحقل),
                            الصنف: الاستيراد.الصنف,
                            الوصف: الوصف,
                            قابل_للتغيير: الاستيراد.قابل_للتغيير,
                            الاسم: انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم),
                            ضعيف: (الرمز.الأعلام & علم_رمز_ضعيف_ويب_أسمبلي()) != 0
                        };
                        ألحق(الاستيرادات, الناتج);
                        إذا (الجولة == 0) {
                            ألحق(فهارس_الاستيراد_في_صنفها, عدد_الدوال_المستوردة);
                            عدد_الدوال_المستوردة := عدد_الدوال_المستوردة + 1;
                        } وإلا {
                            ألحق(فهارس_الاستيراد_في_صنفها, عدد_العوام_المستوردة);
                            عدد_العوام_المستوردة := عدد_العوام_المستوردة + 1;
                        };
                    };
                };
                ر := ر + 1;
            }
            ك := ك + 1;
        }
        الجولة := الجولة + 1;
    }

    // ---- defined functions, globals and segments
    دع فهارس_الدوال: متغير متجه متجه طبيعي = [];
    دع أنواع_الدوال_الناتجة: متغير متجه طبيعي = [];
    دع التالي: متغير طبيعي = عدد_الدوال_المستوردة;
    دع فهارس_العوام: متغير متجه متجه طبيعي = [];
    دع التالي_العام: متغير طبيعي = عدد_العوام_المستوردة;
    دع فهارس_القطع: متغير متجه متجه طبيعي = [];
    دع عناوين_القطع: متغير متجه طبيعي = [];
    دع العنوان: متغير طبيعي = 0;
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع الدوال: متغير متجه طبيعي = [];
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الكائنات[ك].أنواع_الدوال) مثل طبيعي)) {
            إذا (دوال_مهملة[ك][ج]) {
                ألحق(الدوال, لا_فهرس_ويب_أسمبلي());
            } وإلا {
                دع النوع_المحلي: طبيعي = الكائنات[ك].أنواع_الدوال[ج];
                إذا (النوع_المحلي >= (الطول(خرائط_الأنواع[ك]) مثل طبيعي)) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                };
                ألحق(الدوال, التالي);
                ألحق(أنواع_الدوال_الناتجة, خرائط_الأنواع[ك][النوع_المحلي]);
                التالي := التالي + 1;
            };
            ج := ج + 1;
        }
        ألحق(فهارس_الدوال, الدوال);
        دع العوام: متغير متجه طبيعي = [];
        ج := 0;
        طالما (ج < (الطول(الكائنات[ك].العوام) مثل طبيعي)) {
            إذا (عوام_مهملة[ك][ج]) {
                ألحق(العوام, لا_فهرس_ويب_أسمبلي());
            } وإلا {
                ألحق(العوام, التالي_العام);
                التالي_العام := التالي_العام + 1;
            };
            ج := ج + 1;
        }
        ألحق(فهارس_العوام, العوام);
        دع القطع: متغير متجه طبيعي = [];
        ج := 0;
        طالما (ج < (الطول(الكائنات[ك].القطع) مثل طبيعي)) {
            إذا (قطع_مهملة[ك][ج]) {
                ألحق(القطع, لا_فهرس_ويب_أسمبلي());
            } وإلا {
                إذا (الكائنات[ك].القطع[ج].أعلام_الرأس != 0) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
                دع لوغ: طبيعي = الكائنات[ك].القطع[ج].محاذاة_لوغ;
                إذا (لوغ > 31) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                };
                العنوان := حاذ_عنوان_ويب_أسمبلي(العنوان, (1 مثل طبيعي) << لوغ);
                ألحق(القطع, الطول(عناوين_القطع) مثل طبيعي);
                ألحق(عناوين_القطع, العنوان);
                العنوان := العنوان + الكائنات[ك].القطع[ج].الحجم;
                إذا (العنوان > 4294967296) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.تجاوز_الذاكرة());
                };
            };
            ج := ج + 1;
        }
        ألحق(فهارس_القطع, القطع);
        ك := ك + 1;
    }
    دع عدد_الدوال_المعرفة: طبيعي = التالي - عدد_الدوال_المستوردة;
    دع عدد_العوام_المعرفة: طبيعي = التالي_العام - عدد_العوام_المستوردة;
    دع عدد_القطع: طبيعي = الطول(عناوين_القطع) مثل طبيعي;

    // ---- custom sections: output parts
    دع المخصصة_الناتجة: متغير متجه مخصص_ناتج_ويب_أسمبلي = [];
    دع أسماء_المخصصة: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع مواضع_المخصصة: متغير متجه متجه طبيعي = [];
    دع مخصصة_الكائنات: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع المواضع: متغير متجه طبيعي = [];
        دع الوجهات: متغير متجه طبيعي = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الكائنات[ك].المخصصة) مثل طبيعي)) {
            دع مرجع_المخصص: &قسم_مخصص_كائن_ويب_أسمبلي = &الكائنات[ك].المخصصة[م];
            دع الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&(*مرجع_المخصص).الاسم);
            دع الحجم: طبيعي = (*مرجع_المخصص).الحجم;
            طابق ابحث_في_الخريطة(&أسماء_المخصصة, &الاسم) مع
            | اختياري.موجود(الموجود) -> {
                ألحق(المواضع, المخصصة_الناتجة[الموجود].الحجم);
                ألحق(الوجهات, الموجود);
                المخصصة_الناتجة[الموجود].الحجم := المخصصة_الناتجة[الموجود].الحجم + الحجم;
            }
            | اختياري.لا_شيء -> {
                دع الجديد: طبيعي = الطول(المخصصة_الناتجة) مثل طبيعي;
                دع نسخة_الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الاسم);
                طابق أدرج_في_الخريطة(&متغير أسماء_المخصصة, نسخة_الاسم, الجديد) مع
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | نتيجة.نجح(_) -> { };
                دع الناتج: مخصص_ناتج_ويب_أسمبلي = { الاسم: الاسم, الحجم: الحجم };
                ألحق(المخصصة_الناتجة, الناتج);
                ألحق(المواضع, 0);
                ألحق(الوجهات, الجديد);
            };
            م := م + 1;
        }
        ألحق(مواضع_المخصصة, المواضع);
        ألحق(مخصصة_الكائنات, الوجهات);
        ك := ك + 1;
    }
    دع عدد_المخصصة: طبيعي = الطول(المخصصة_الناتجة) مثل طبيعي;
    // Output section indices: type, import, function, [global], code,
    // [data], custom sections, linking.
    دع فهرس_قسم_الشفرة: متغير طبيعي = 3;
    إذا (عدد_العوام_المعرفة > 0) { فهرس_قسم_الشفرة := 4; };
    دع فهرس_قسم_البيانات: طبيعي = فهرس_قسم_الشفرة + 1;
    دع أول_مخصص: متغير طبيعي = فهرس_قسم_الشفرة + 1;
    إذا (عدد_القطع > 0) { أول_مخصص := أول_مخصص + 1; };

    // ---- output symbols
    دع الرموز_الناتجة: متغير متجه رمز_كائن_ويب_أسمبلي = [];
    دع رموز_الكائنات: متغير متجه متجه طبيعي = [];
    دع رموز_الأسماء: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    // The section symbol of each output custom section, once.
    دع رموز_المخصصة: متغير متجه طبيعي = [];
    دع خ: متغير طبيعي = 0;
    طالما (خ < عدد_المخصصة) { ألحق(رموز_المخصصة, لا_فهرس_ويب_أسمبلي()); خ := خ + 1; }
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع المحلية: متغير متجه طبيعي = [];
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
            دع مرجع_الرمز: &رمز_كائن_ويب_أسمبلي = &الكائنات[ك].الرموز[ر];
            دع الرمز: رمز_كائن_ويب_أسمبلي = *مرجع_الرمز;
            دع محلي: منطقي = (الرمز.الأعلام & علم_رمز_محلي_ويب_أسمبلي()) != 0;
            دع غير_معرف_الرمز: منطقي = (الرمز.الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0;
            دع الناتج_المحلي: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
            // The definition this symbol takes: its own (local), or its
            // name's winner; none when no input defines the name.
            دع كائن_التعريف: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
            دع رمز_التعريف: متغير طبيعي = 0;
            إذا (الرمز.الصنف == صنف_رمز_قسم_ويب_أسمبلي()) {
                دع م: متغير طبيعي = 0;
                طالما (م < (الطول(الكائنات[ك].المخصصة) مثل طبيعي)) {
                    إذا (الكائنات[ك].المخصصة[م].الفهرس == الرمز.الفهرس) {
                        دع الوجهة: طبيعي = مخصصة_الكائنات[ك][م];
                        إذا (رموز_المخصصة[الوجهة] == لا_فهرس_ويب_أسمبلي()) {
                            رموز_المخصصة[الوجهة] := الطول(الرموز_الناتجة) مثل طبيعي;
                            دع الاسم_الفارغ: متجه ط8 = [];
                            دع رمز_القسم: رمز_كائن_ويب_أسمبلي = {
                                الصنف: صنف_رمز_قسم_ويب_أسمبلي(),
                                الأعلام: علم_رمز_محلي_ويب_أسمبلي(),
                                الاسم: الاسم_الفارغ,
                                الفهرس: أول_مخصص + الوجهة,
                                الإزاحة: 0,
                                الحجم: 0
                            };
                            ألحق(الرموز_الناتجة, رمز_القسم);
                        };
                        الناتج_المحلي := رموز_المخصصة[الوجهة];
                    };
                    م := م + 1;
                }
            } وإلا إذا (محلي) {
                إذا (!غير_معرف_الرمز) {
                    كائن_التعريف := ك;
                    رمز_التعريف := ر;
                };
            } وإلا {
                طابق ابحث_في_الخريطة(&رموز_الأسماء, &الرمز.الاسم) مع
                | اختياري.موجود(الموجود) -> { الناتج_المحلي := الموجود; }
                | اختياري.لا_شيء -> {
                    طابق ابحث_في_الخريطة(&الفائزون, &الرمز.الاسم) مع
                    | اختياري.موجود(موضع_الفائز) -> {
                        دع المالك: طبيعي = أصحاب_الفائزين[موضع_الفائز];
                        إذا (المالك != لا_فهرس_ويب_أسمبلي()) {
                            دع المفتاح: متجه ط8 = مفتاح_رمز_كائن_ويب_أسمبلي(&الرمز.الاسم, المالك);
                            طابق ابحث_في_الخريطة(&المعرفة, &المفتاح) مع
                            | اختياري.موجود(فهرس_الرمز) -> {
                                كائن_التعريف := المالك;
                                رمز_التعريف := فهرس_الرمز;
                            }
                            | اختياري.لا_شيء -> {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                };
            };
            إذا (الرمز.الصنف != صنف_رمز_قسم_ويب_أسمبلي() && الناتج_المحلي == لا_فهرس_ويب_أسمبلي()) {
                دع الجديد: متغير رمز_كائن_ويب_أسمبلي = {
                    الصنف: الرمز.الصنف,
                    الأعلام: الرمز.الأعلام,
                    الاسم: انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم),
                    الفهرس: 0,
                    الإزاحة: 0,
                    الحجم: 0
                };
                دع صالح: متغير منطقي = صواب;
                إذا (كائن_التعريف != لا_فهرس_ويب_أسمبلي()) {
                    دع مرجع_المعرف: &رمز_كائن_ويب_أسمبلي = &الكائنات[كائن_التعريف].الرموز[رمز_التعريف];
                    دع المعرف: رمز_كائن_ويب_أسمبلي = *مرجع_المعرف;
                    إذا (المعرف.الصنف != الرمز.الصنف) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                            خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                        );
                    };
                    الجديد.الأعلام := المعرف.الأعلام;
                    دع مستوردة: طبيعي = الطول(الكائنات[كائن_التعريف].استيرادات_الدوال) مثل طبيعي;
                    دع عوام_مستوردة: طبيعي = الطول(الكائنات[كائن_التعريف].استيرادات_العوام) مثل طبيعي;
                    إذا (المعرف.الصنف == صنف_رمز_دالة_ويب_أسمبلي()) {
                        إذا (المعرف.الفهرس < مستوردة
                            || المعرف.الفهرس - مستوردة >= (الطول(فهارس_الدوال[كائن_التعريف]) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        الجديد.الفهرس := فهارس_الدوال[كائن_التعريف][المعرف.الفهرس - مستوردة];
                        صالح := الجديد.الفهرس != لا_فهرس_ويب_أسمبلي();
                    } وإلا إذا (المعرف.الصنف == صنف_رمز_عام_ويب_أسمبلي()) {
                        إذا (المعرف.الفهرس < عوام_مستوردة
                            || المعرف.الفهرس - عوام_مستوردة >= (الطول(فهارس_العوام[كائن_التعريف]) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        الجديد.الفهرس := فهارس_العوام[كائن_التعريف][المعرف.الفهرس - عوام_مستوردة];
                        صالح := الجديد.الفهرس != لا_فهرس_ويب_أسمبلي();
                    } وإلا إذا (المعرف.الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
                        إذا ((المعرف.الأعلام & علم_رمز_مطلق_ويب_أسمبلي()) != 0) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                        };
                        إذا (المعرف.الفهرس >= (الطول(فهارس_القطع[كائن_التعريف]) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        الجديد.الفهرس := فهارس_القطع[كائن_التعريف][المعرف.الفهرس];
                        الجديد.الإزاحة := المعرف.الإزاحة;
                        الجديد.الحجم := المعرف.الحجم;
                        صالح := الجديد.الفهرس != لا_فهرس_ويب_أسمبلي();
                    } وإلا {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                } وإلا {
                    // Undefined in every input: imported (functions and
                    // globals, by name), the table import, or undefined data.
                    دع أعلام_غير_معرف: متغير طبيعي = علم_رمز_غير_معرف_ويب_أسمبلي()
                        | (الرمز.الأعلام & علم_رمز_ضعيف_ويب_أسمبلي())
                        | (الرمز.الأعلام & 0x80);
                    إذا (الرمز.الصنف == صنف_رمز_دالة_ويب_أسمبلي() || الرمز.الصنف == صنف_رمز_عام_ويب_أسمبلي()) {
                        أعلام_غير_معرف := أعلام_غير_معرف | علم_رمز_اسم_صريح_ويب_أسمبلي();
                        طابق ابحث_في_الخريطة(&استيرادات_الأسماء, &الرمز.الاسم) مع
                        | اختياري.موجود(الموضع) -> { الجديد.الفهرس := فهارس_الاستيراد_في_صنفها[الموضع]; }
                        | اختياري.لا_شيء -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                    } وإلا إذا (الرمز.الصنف == صنف_رمز_جدول_ويب_أسمبلي()) {
                        أعلام_غير_معرف := أعلام_غير_معرف | علم_رمز_اسم_صريح_ويب_أسمبلي();
                        الجديد.الفهرس := 0;
                    } وإلا إذا (الرمز.الصنف != صنف_رمز_بيانات_ويب_أسمبلي()) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    الجديد.الأعلام := أعلام_غير_معرف;
                };
                إذا (صالح) {
                    الناتج_المحلي := الطول(الرموز_الناتجة) مثل طبيعي;
                    إذا (!محلي) {
                        دع نسخة_الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم);
                        دع موضع_الرمز: طبيعي = الناتج_المحلي;
                        طابق أدرج_في_الخريطة(&متغير رموز_الأسماء, نسخة_الاسم, موضع_الرمز) مع
                        | نتيجة.خطأ(_) -> {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        }
                        | نتيجة.نجح(_) -> { };
                    };
                    ألحق(الرموز_الناتجة, الجديد);
                };
            };
            ألحق(المحلية, الناتج_المحلي);
            ر := ر + 1;
        }
        ألحق(رموز_الكائنات, المحلية);
        ك := ك + 1;
    }

    // ---- code, data and custom contents with relocations rewritten
    دع قسم_الشفرة: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, عدد_الدوال_المعرفة);
    دع قسم_البيانات: متغير متجه ط8 = [];
    ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, عدد_القطع);
    دع محتويات_المخصصة: متغير متجه متجه ط8 = [];
    خ := 0;
    طالما (خ < عدد_المخصصة) { دع فارغ: متجه ط8 = []; ألحق(محتويات_المخصصة, فارغ); خ := خ + 1; }
    دع إزاحات_الشفرة: متغير متجه ط8 = [];
    دع عدد_إزاحات_الشفرة: متغير طبيعي = 0;
    دع إزاحات_البيانات: متغير متجه ط8 = [];
    دع عدد_إزاحات_البيانات: متغير طبيعي = 0;
    دع إزاحات_المخصصة: متغير متجه متجه ط8 = [];
    دع أعداد_إزاحات_المخصصة: متغير متجه طبيعي = [];
    خ := 0;
    طالما (خ < عدد_المخصصة) {
        دع فارغ: متجه ط8 = [];
        ألحق(إزاحات_المخصصة, فارغ);
        ألحق(أعداد_إزاحات_المخصصة, 0);
        خ := خ + 1;
    }
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع مرجع_البايتات: &متجه ط8 = &(*السياق).الخطة.المدخلات[مداخل_الكائنات[ك]].البايتات;
        دع الشفرة: متغير متجه ط8 = انسخ_نطاق_ويب_أسمبلي(
            مرجع_البايتات, الكائنات[ك].بداية_الشفرة, الكائنات[ك].حجم_الشفرة
        );
        دع البيانات: متغير متجه ط8 = انسخ_نطاق_ويب_أسمبلي(
            مرجع_البايتات, الكائنات[ك].بداية_البيانات, الكائنات[ك].حجم_البيانات
        );
        // Output offsets of this object's kept function entries and segments.
        دع مواضع_الأجسام: متغير متجه طبيعي = [];
        دع موضع_الشفرة: متغير طبيعي = الطول(قسم_الشفرة) مثل طبيعي;
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الكائنات[ك].الأجسام) مثل طبيعي)) {
            ألحق(مواضع_الأجسام, موضع_الشفرة);
            إذا (!دوال_مهملة[ك][ج]) {
                موضع_الشفرة := موضع_الشفرة + (الكائنات[ك].الأجسام[ج].النهاية - الكائنات[ك].الأجسام[ج].البداية);
            };
            ج := ج + 1;
        }
        دع مواضع_القطع: متغير متجه طبيعي = [];
        دع موضع_البيانات: متغير طبيعي = الطول(قسم_البيانات) مثل طبيعي;
        ج := 0;
        طالما (ج < (الطول(الكائنات[ك].القطع) مثل طبيعي)) {
            دع فهرس_ناتج: طبيعي = فهارس_القطع[ك][ج];
            إذا (فهرس_ناتج == لا_فهرس_ويب_أسمبلي()) {
                ألحق(مواضع_القطع, 0);
            } وإلا {
                // flags (1) + i32.const + sleb + end + size leb, then bytes.
                دع الرأس: متغير متجه ط8 = [];
                ألحق_ليب_ويب_أسمبلي(&متغير الرأس, 0);
                ألحق_بايت_ويب_أسمبلي(&متغير الرأس, 0x41);
                ألحق_سليب_ويب_أسمبلي(&متغير الرأس, قيمة_موقعة_32_من_بتات(عناوين_القطع[فهرس_ناتج]));
                ألحق_بايت_ويب_أسمبلي(&متغير الرأس, 0x0B);
                ألحق_ليب_ويب_أسمبلي(&متغير الرأس, الكائنات[ك].القطع[ج].الحجم);
                موضع_البيانات := موضع_البيانات + (الطول(الرأس) مثل طبيعي);
                ألحق(مواضع_القطع, موضع_البيانات);
                موضع_البيانات := موضع_البيانات + الكائنات[ك].القطع[ج].الحجم;
            };
            ج := ج + 1;
        }
        دع المخصصة: متغير متجه متجه ط8 = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول(الكائنات[ك].المخصصة) مثل طبيعي)) {
            ألحق(المخصصة, انسخ_نطاق_ويب_أسمبلي(
                مرجع_البايتات, الكائنات[ك].المخصصة[م].البداية, الكائنات[ك].المخصصة[م].الحجم
            ));
            م := م + 1;
        }
        دع مج: متغير طبيعي = 0;
        طالما (مج < (الطول(الكائنات[ك].الإزاحات) مثل طبيعي)) {
            دع القسم: طبيعي = الكائنات[ك].الإزاحات[مج].القسم;
            دع الوجهة: متغير طبيعي = 3;
            دع موضع_مخصص: متغير طبيعي = 0;
            إذا ((الطول(الكائنات[ك].الأجسام) مثل طبيعي) > 0 && القسم == الكائنات[ك].فهرس_قسم_الشفرة) {
                الوجهة := 0;
            } وإلا إذا ((الطول(الكائنات[ك].القطع) مثل طبيعي) > 0 && القسم == الكائنات[ك].فهرس_قسم_البيانات) {
                الوجهة := 1;
            } وإلا {
                دع م2: متغير طبيعي = 0;
                طالما (م2 < (الطول(الكائنات[ك].المخصصة) مثل طبيعي)) {
                    إذا (الكائنات[ك].المخصصة[م2].الفهرس == القسم) {
                        الوجهة := 2;
                        موضع_مخصص := م2;
                    };
                    م2 := م2 + 1;
                }
            };
            إذا (الوجهة == 3) {
                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.إزاحة_غير_مدعومة());
            };
            دع ز: متغير طبيعي = 0;
            طالما (ز < (الطول(الكائنات[ك].الإزاحات[مج].الإزاحات) مثل طبيعي)) {
                دع مرجع_الإزاحة: &إزاحة_كائن_ويب_أسمبلي = &الكائنات[ك].الإزاحات[مج].الإزاحات[ز];
                دع الإزاحة: إزاحة_كائن_ويب_أسمبلي = *مرجع_الإزاحة;
                دع النوع: طبيعي = الإزاحة.النوع;
                // The output offset; a relocation inside a dropped function
                // or segment is dropped with it.
                دع الموضع_الناتج: متغير طبيعي = 0;
                دع محذوفة: متغير منطقي = خطأ;
                إذا (الوجهة == 0) {
                    طابق بحث_جسم_ويب_أسمبلي(&الكائنات[ك].الأجسام, الإزاحة.الموضع) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    }
                    | اختياري.موجود(ج2) -> {
                        محذوفة := دوال_مهملة[ك][ج2];
                        الموضع_الناتج := مواضع_الأجسام[ج2] + (الإزاحة.الموضع - الكائنات[ك].الأجسام[ج2].البداية);
                    };
                } وإلا إذا (الوجهة == 1) {
                    طابق بحث_قطعة_ويب_أسمبلي(&الكائنات[ك].القطع, الإزاحة.الموضع) مع
                    | اختياري.لا_شيء -> {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    }
                    | اختياري.موجود(ق2) -> {
                        محذوفة := قطع_مهملة[ك][ق2];
                        الموضع_الناتج := مواضع_القطع[ق2] + (الإزاحة.الموضع - الكائنات[ك].القطع[ق2].بداية_البايتات);
                    };
                } وإلا {
                    الموضع_الناتج := مواضع_المخصصة[ك][موضع_مخصص] + الإزاحة.الموضع;
                };
                إذا (!محذوفة) {
                    دع الفهرس_الناتج: متغير طبيعي = 0;
                    دع الإضافة: متغير عدد = الإزاحة.الإضافة;
                    // The provisional value written into the field.
                    دع المؤقت: متغير عدد = 0;
                    إذا (النوع == 6) {
                        إذا (الإزاحة.الفهرس >= (الطول(خرائط_الأنواع[ك]) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        الفهرس_الناتج := خرائط_الأنواع[ك][الإزاحة.الفهرس];
                        المؤقت := الفهرس_الناتج مثل عدد;
                    } وإلا {
