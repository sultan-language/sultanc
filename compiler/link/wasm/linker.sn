استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.symbol_model;
استورد compiler.link.symbol_table;
استورد compiler.backend.target.target_model;
استورد compiler.backend.architectures.wasm32.encoder;
استورد compiler.link.wasm.reader;
استورد compiler.link.wasm.object_reader;
استورد compiler.link.wasm.object_ingest;
استورد compiler.link.wasm.dynamic_ingest;
استورد compiler.link.wasm.names;
استورد std.collections.map;
استورد std.hash.fnv;
استورد std.bytes.compare;
استورد std.text.from_bytes;

// The SultanC WebAssembly linker (wasm32). It links the relocatable objects
// of the WebAssembly tool conventions (Linking.md), as written by the native
// wasm32 object writer and by LLVM, into one final module, following wasm-ld
// (lld/wasm) for every rule it implements. No external linker is run.
//
// Outputs:
//   * تنفيذي (WASI command or browser module): exports the entry (`_start`
//     unless the plan names another) and `memory`.
//   * وحدة_هدف: a final module without an entry. A single input that is
//     already a final module (no `linking` section) is passed through
//     unchanged; relocatable inputs are linked, and when they have init
//     functions the module exports `_initialize`, the WASI reactor
//     convention, which runs them.
//   * كائن_مترابط (relocatable, wasm-ld -r): one relocatable object
//     (اربط_كائن_مترابط_ويب_أسمبلي below).
//   * مكتبة_مشتركة (wasm-ld -shared): a shared module of the WebAssembly
//     dynamic-linking convention (DynamicLinking.md), described below.
//
// Shared modules. The objects must be position-independent code (both
// backends emit it for a shared output: LLVM's PIC relocation model, the
// native selector's موضع_مستقل mode). The module:
//   * starts with the custom section `dylink.0`: WASM_DYLINK_MEM_INFO (the
//     data size and alignment the loader reserves at __memory_base, the
//     table slots it reserves at __table_base), WASM_DYLINK_NEEDED (the file
//     names of the shared-module inputs the link resolved against),
//     WASM_DYLINK_EXPORT_INFO (weak definitions), WASM_DYLINK_IMPORT_INFO
//     (weak undefined imports), WASM_DYLINK_RUNTIME_PATH (the plan's runtime
//     paths) and WASM_DYLINK_TARGET_ARCH (`wasm32`);
//   * imports env.memory, env.__indirect_function_table (when it has table
//     slots or indirect calls), env.__stack_pointer, env.__memory_base and
//     env.__table_base, and defines neither memory nor table nor stack;
//   * places its data from address 0 relative to __memory_base in one active
//     segment initialized at `global.get __memory_base` (zero-filled data
//     follows it inside the reserved size and is not written), and its table
//     slots from 0 relative to __table_base in one element segment at
//     `global.get __table_base`;
//   * reaches a symbol another module may define (undefined, or defined
//     with default visibility, which another module may preempt, as wasm-ld
//     without -Bsymbolic) through a GOT entry: an imported mutable i32
//     global `GOT.mem.<name>` (data address) or `GOT.func.<name>` (table
//     index) the loader fills; a hidden or local symbol accessed through the
//     GOT gets an internal global instead;
//   * applies R_WASM_MEMORY_ADDR_REL_SLEB and R_WASM_TABLE_INDEX_REL_SLEB
//     relative to the bases, GLOBAL_INDEX relocations of data and function
//     symbols to their GOT entries, and rejects absolute code addresses and
//     table indices (R_WASM_MEMORY_ADDR_LEB/SLEB, R_WASM_TABLE_INDEX_SLEB)
//     as wasm-ld does ("recompile with -fPIC");
//   * turns every R_WASM_MEMORY_ADDR_I32 and R_WASM_TABLE_INDEX_I32 in data
//     into a runtime fixup in the generated `__wasm_apply_data_relocs`, which
//     the loader calls after instantiation and before any other function,
//     including `__wasm_call_ctors`; it also sets the internal GOT entries;
//   * exports every defined non-local symbol of default visibility (a data
//     symbol as an immutable i32 global holding its address relative to
//     __memory_base), the symbols flagged EXPORTED, `__wasm_call_ctors` and
//     `__wasm_apply_data_relocs`, and has no entry.
// Undefined functions and globals stay imports as for every output;
// shared-module inputs (wasm/dynamic_ingest.sn) only resolve names and
// become NEEDED entries. Shared modules are linked for wasm32 WASI
// (link/provider.sn); a shared-module input to any other output, TLS and
// shared (threaded) memory are rejected.
//
// Symbols: the objects' symbols are registered in the one link symbol table
// at ingestion (object_ingest.sn); this linker takes the winning definition
// of every global name from that table (strong over weak, first of equals),
// so archive extraction and duplicate detection are the canonical ones.
// COMDAT groups that lost in the context's COMDAT registry are dropped.
//
// Imports: a function or global that no input defines is imported from the
// module and field its object's import names (the module an external
// declaration names, as std's `خارجي «wasi_snapshot_preview1» عرف ...`;
// `env` by default), deduplicated by (module, field). This is wasm-ld's
// --import-undefined behaviour, which SultanC uses for every WebAssembly
// target. An
// undefined data symbol is an error unless weak (address 0) or synthesized.
//
// Layout (wasm-ld --stack-first): the shadow stack occupies the first
// حجم_المكدس_ويب_أسمبلي bytes and grows down from its top, which is the
// initial value of the defined global `__stack_pointer`; data segments follow,
// grouped by name prefix into `.rodata`, `.data` and `.bss` output segments
// (`.bss` is not written: memory starts zeroed); `__heap_base` is the first
// 16-byte-aligned address after the data, where the std allocator's heap
// starts. The module defines and exports one memory and defines (does not
// export) the indirect function table, whose slot 0 stays null; each function
// whose address a TABLE_INDEX relocation takes gets one slot from 1.
// Synthesized symbols: `__stack_pointer`, `__indirect_function_table`,
// `__heap_base`, `__data_end`, `__global_base`, `__dso_handle`,
// `__stack_low`, `__stack_high`, `__heap_end` and `__wasm_call_ctors`.
//
// Init functions (WASM_INIT_FUNCS) run in priority order from the
// synthesized `__wasm_call_ctors`. When no input calls it, the exported entry
// is a synthesized wrapper that calls it and then the entry, as wasm-ld wraps
// command exports.
//
// Custom sections other than `linking`, `reloc.*`, `target_features`,
// `producers` and `name` (DWARF `.debug_*` and any other) are concatenated
// by name with their relocations applied. A `name` section naming the
// functions is generated.
//
// Previously the only WebAssembly link output was a final module passed
// through unchanged, so no WASI command or browser module could be linked.

عام نوع خطأ_مزود_ربط_ويب_أسمبلي =
    | خطة_غير_مدعومة
    | وحدة_غير_صالحة
    | رمز_دخول_مفقود
    | رمز_غير_معرف بنوع متجه ط8
    | نوع_رمز_غير_مطابق بنوع متجه ط8
    | إزاحة_غير_مدعومة
    | ميزة_غير_مدعومة
    | تجاوز_الذاكرة
    // An absolute address or table index in the code of a shared module
    // (the object was not compiled as position-independent code).
    | إزاحة_غير_موضعية بنوع متجه ط8
;

عام نوع نتيجة_مزود_ربط_ويب_أسمبلي =
    | نجح بنوع متجه ط8
    | خطأ بنوع خطأ_مزود_ربط_ويب_أسمبلي
;

// The shadow-stack size: 8 MiB, the layout SultanC's WebAssembly executables
// had when wasm-ld linked them (`--stack-first -z stack-size=8388608`):
// wasm-ld's default 64 KiB stack is too small for the compiler's recursion
// depth, and a stack placed before the data traps on overflow instead of
// overwriting static data.
عام عرف حجم_المكدس_ويب_أسمبلي(): طبيعي { أرجع 8388608; }

عرف لا_فهرس_ويب_أسمبلي(): طبيعي { أرجع ~((0 مثل طبيعي)); }

دع صفحة_ويب_أسمبلي: طبيعي = 1 << 16;

// What a symbol of an object refers to once the link is resolved.
نوع هدف_رمز_ويب_أسمبلي =
    | دالة_ناتجة بنوع طبيعي
    | بيانات_كائن بنوع (طبيعي, طبيعي, طبيعي)
    | عنوان_ثابت بنوع طبيعي
    | عام_ناتج بنوع طبيعي
    | جدول_ناتج بنوع طبيعي
    | قسم_مخصص بنوع (طبيعي, طبيعي)
    | بلا_هدف
;

نوع استيراد_ناتج_ويب_أسمبلي = {
    الوحدة: متجه ط8,
    الحقل: متجه ط8,
    الصنف: طبيعي,
    الوصف: طبيعي,
    قابل_للتغيير: منطقي,
    // The symbol name, for the name section.
    الاسم: متجه ط8,
    // Every reference is weak (dylink.0 WASM_DYLINK_IMPORT_INFO).
    ضعيف: منطقي
};

// A GOT entry of a shared module: the symbol (by the object and symbol
// that first needed it), whether it is a function (GOT.func, a table index)
// or data (GOT.mem, an address), whether it is internal (a hidden or local
// definition: a defined global set by __wasm_apply_data_relocs) or imported,
// and its output global index.
نوع مدخل_مؤشر_ويب_أسمبلي = {
    الكائن: طبيعي,
    الرمز: طبيعي,
    هي_دالة: منطقي,
    داخلي: منطقي,
    العام: طبيعي
};

// A runtime data fixup of a shared module, applied by
// __wasm_apply_data_relocs: the i32 at __memory_base + العنوان becomes
// __memory_base + القيمة (الصنف 0), __table_base + القيمة (1), or the GOT
// global القيمة plus الإضافة (2).
نوع إزاحة_تشغيل_ويب_أسمبلي = {
    العنوان: طبيعي,
    الصنف: طبيعي,
    القيمة: طبيعي,
    الإضافة: عدد
};

نوع قطعة_ناتجة_ويب_أسمبلي = {
    الاسم: متجه ط8,
    العنوان: طبيعي,
    الحجم: طبيعي,
    المحاذاة: طبيعي,
    صفرية: منطقي
};

نوع مخصص_ناتج_ويب_أسمبلي = {
    الاسم: متجه ط8,
    الحجم: طبيعي
};

نوع بدء_ناتج_ويب_أسمبلي = {
    الأولوية: طبيعي,
    الدالة: طبيعي
};

// ------------------------------------------------------------ utilities --

عرف هاش_مفتاح_ويب_أسمبلي(المفتاح: &متجه ط8): طبيعي {
    أرجع هاش_فنڤ1أ_طبيعي_للبايتات(المفتاح);
}

عرف مفتاحا_ويب_أسمبلي_متساويان(الأول: &متجه ط8, الثاني: &متجه ط8): منطقي {
    أرجع متجها_بايتات_متساويان(الأول, الثاني);
}

عرف خريطة_ويب_أسمبلي(): الخريطة<متجه ط8, طبيعي> {
    دع الخريطة: الخريطة<متجه ط8, طبيعي> = أنشئ_الخريطة(
        هاش_مفتاح_ويب_أسمبلي,
        مفتاحا_ويب_أسمبلي_متساويان
    );
    أرجع الخريطة;
}

عرف انسخ_بايتات_ويب_أسمبلي(المصدر: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[فهرس_البايت]);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الناتج;
}

عرف ألحق_نطاق_ويب_أسمبلي(
    الناتج: &متغير متجه ط8,
    المصدر: &متجه ط8,
    البداية: طبيعي,
    الحجم: طبيعي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        ألحق(*الناتج, (*المصدر)[البداية + ف]);
        ف := ف + 1;
    }
}

// The key of one object's symbol name: the name, a 0 byte, the object index.
عرف مفتاح_رمز_كائن_ويب_أسمبلي(الاسم: &متجه ط8, الكائن: طبيعي): متجه ط8 {
    دع المفتاح: متغير متجه ط8 = انسخ_بايتات_ويب_أسمبلي(الاسم);
    ألحق(المفتاح, 0 مثل ط8);
    ألحق_قيمة_صغيرة_الطرف_ويب_أسمبلي(&متغير المفتاح, الكائن, 8);
    أرجع المفتاح;
}

// The key of one import: module, a 0 byte, field.
عرف مفتاح_استيراد_ويب_أسمبلي(الوحدة: &متجه ط8, الحقل: &متجه ط8): متجه ط8 {
    دع المفتاح: متغير متجه ط8 = انسخ_بايتات_ويب_أسمبلي(الوحدة);
    ألحق(المفتاح, 0 مثل ط8);
    ألحق_بايتات_ويب_أسمبلي(&متغير المفتاح, الحقل);
    أرجع المفتاح;
}

عرف حاذ_عنوان_ويب_أسمبلي(القيمة: طبيعي, المحاذاة: طبيعي): طبيعي {
    إذا (المحاذاة <= 1) { أرجع القيمة; };
    دع الباقي: طبيعي = القيمة % المحاذاة;
    إذا (الباقي == 0) { أرجع القيمة; };
    أرجع القيمة + (المحاذاة - الباقي);
}

عرف ألحق_قسم_ناتج_ويب_أسمبلي(
    الملف: &متغير متجه ط8,
    المعرف: طبيعي,
    المحتوى: &متجه ط8
): فراغ {
    ألحق_بايت_ويب_أسمبلي(الملف, المعرف);
    ألحق_ليب_ويب_أسمبلي(الملف, الطول(*المحتوى) مثل طبيعي);
    ألحق_بايتات_ويب_أسمبلي(الملف, المحتوى);
}

عرف ألحق_قسم_مخصص_ناتج_ويب_أسمبلي(
    الملف: &متغير متجه ط8,
    الاسم: &متجه ط8,
    المحتوى: &متجه ط8
): فراغ {
    دع الحمولة: متغير متجه ط8 = [];
    ألحق_اسم_ويب_أسمبلي(&متغير الحمولة, الاسم);
    ألحق_بايتات_ويب_أسمبلي(&متغير الحمولة, المحتوى);
    ألحق_قسم_ناتج_ويب_أسمبلي(الملف, 0, &الحمولة);
}

عرف اكتب_ط32_ويب_أسمبلي_عند(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        (*البايتات)[الموضع + ف] := (الباقي % 256) مثل ط8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

عرف اكتب_ط64_ويب_أسمبلي_عند(
    البايتات: &متغير متجه ط8,
    الموضع: طبيعي,
    القيمة: طبيعي
): فراغ {
    دع الباقي: متغير طبيعي = القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        (*البايتات)[الموضع + ف] := (الباقي % 256) مثل ط8;
        الباقي := الباقي / 256;
        ف := ف + 1;
    }
}

// Parameter count and whether the results are empty, from a function type
// encoding (0x60, params, results).
عرف عدد_معاملات_نوع_ويب_أسمبلي(النوع: &متجه ط8): طبيعي {
    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(النوع, 1) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(القراءة) -> { أرجع القراءة.القيمة; };
}

عرف نوع_ويب_أسمبلي_بلا_معاملات_ونواتج(النوع: &متجه ط8): منطقي {
    أرجع (الطول(*النوع) مثل طبيعي) == 3
        && (*النوع)[1] == (0 مثل ط8) && (*النوع)[2] == (0 مثل ط8);
}

// --------------------------------------------------------------- linking --

// What every WebAssembly link starts from: the plan's objects decoded (or the
// one final module to pass through), the COMDAT members that lost, each
// object's defined non-local symbols by (name, object), the deduplicated
// output types with each object's type mapping, and the defining object of
// every global name, taken from the one link symbol table.
نوع نتيجة_جمع_ويب_أسمبلي =
    | جاهز
    | تمرير بنوع متجه ط8
    | خطأ بنوع خطأ_مزود_ربط_ويب_أسمبلي
;

عرف اجمع_مدخلات_ويب_أسمبلي(
    السياق: &سياق_ربط,
    يقبل_التمرير: منطقي,
    // Shared-module inputs resolve names of a shared output only.
    يقبل_المكتبات: منطقي,
    ناتج_الكائنات: &متغير متجه كائن_ويب_أسمبلي,
    ناتج_المداخل: &متغير متجه طبيعي,
    ناتج_دوال_مهملة: &متغير متجه متجه منطقي,
    ناتج_قطع_مهملة: &متغير متجه متجه منطقي,
    ناتج_عوام_مهملة: &متغير متجه متجه منطقي,
    ناتج_كومدات_مهملة: &متغير متجه متجه منطقي,
    ناتج_المعرفة: &متغير الخريطة<متجه ط8, طبيعي>,
    ناتج_الأنواع: &متغير متجه متجه ط8,
    ناتج_خرائط_الأنواع: &متغير متجه متجه طبيعي,
    ناتج_النوع_الفارغ: &متغير طبيعي,
    ناتج_الفائزين: &متغير الخريطة<متجه ط8, طبيعي>,
    ناتج_أصحاب_الفائزين: &متغير متجه طبيعي
): نتيجة_جمع_ويب_أسمبلي {
    // ---- inputs
    دع عدد_المدخلات: طبيعي = الطول((*السياق).الخطة.المدخلات) مثل طبيعي;
    دع الكائنات: متغير متجه كائن_ويب_أسمبلي = [];
    دع مداخل_الكائنات: متغير متجه طبيعي = [];
    دع كائن_المدخل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_المدخلات) {
        ألحق(كائن_المدخل, لا_فهرس_ويب_أسمبلي());
        دع المدخل: &مدخل_ربط = &(*السياق).الخطة.المدخلات[ف];
        طابق (*المدخل).الصنف مع
        | صنف_مدخل_ربط.كائن -> {
            طابق اقرأ_كائن_ويب_أسمبلي(&(*المدخل).البايتات) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ مع
                | خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة -> {
                    أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                }
                | _ -> {
                    أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                };
            }
            | نتيجة.نجح(الكائن) -> {
                إذا (!الكائن.له_ربط) {
                    // A final module: passed through only as the one input
                    // of a target module.
                    إذا (!يقبل_التمرير || عدد_المدخلات != 1) {
                        أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
                    };
                    أرجع نتيجة_جمع_ويب_أسمبلي.تمرير(انسخ_بايتات_ويب_أسمبلي(&(*المدخل).البايتات));
                };
                كائن_المدخل[ف] := الطول(الكائنات) مثل طبيعي;
                ألحق(الكائنات, الكائن);
                ألحق(مداخل_الكائنات, ف);
            };
        }
        // Archive members the link requested were added to the plan as
        // objects (link/input_ingest.sn); the archive itself adds nothing.
        | صنف_مدخل_ربط.أرشيف -> { }
        // A shared module (wasm/dynamic_ingest.sn registered its exports as
        // shared definitions): a NEEDED dependency of a shared output, and
        // unusable by any other output (no main-module dynamic linking).
        | صنف_مدخل_ربط.مكتبة_ديناميكية -> {
            إذا (!يقبل_المكتبات) {
                أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
            };
        };
        ف := ف + 1;
    }
    دع عدد_الكائنات: طبيعي = الطول(الكائنات) مثل طبيعي;
    إذا (عدد_الكائنات == 0) {
        أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
    };

    // ---- discarded COMDAT members, per object
    دع دوال_مهملة: متغير متجه متجه منطقي = [];
    دع قطع_مهملة: متغير متجه متجه منطقي = [];
    دع عوام_مهملة: متغير متجه متجه منطقي = [];
    دع كومدات_مهملة: متغير متجه متجه منطقي = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < عدد_الكائنات) {
        دع الكائن: &كائن_ويب_أسمبلي = &الكائنات[ك];
        دع الدوال: متغير متجه منطقي = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول((*الكائن).أنواع_الدوال) مثل طبيعي)) { ألحق(الدوال, خطأ); م := م + 1; }
        دع القطع: متغير متجه منطقي = [];
        م := 0;
        طالما (م < (الطول((*الكائن).القطع) مثل طبيعي)) { ألحق(القطع, خطأ); م := م + 1; }
        دع العوام: متغير متجه منطقي = [];
        م := 0;
        طالما (م < (الطول((*الكائن).العوام) مثل طبيعي)) { ألحق(العوام, خطأ); م := م + 1; }
        دع المهملة: متغير متجه منطقي = [];
        دع عدد_الدوال_المستوردة: طبيعي = الطول((*الكائن).استيرادات_الدوال) مثل طبيعي;
        دع عدد_العوام_المستوردة: طبيعي = الطول((*الكائن).استيرادات_العوام) مثل طبيعي;
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول((*الكائن).الكومدات) مثل طبيعي)) {
            دع محفوظة: متغير منطقي = خطأ;
            طابق ابحث_في_الخريطة(&(*السياق).مجموعات_كومدات, &(*الكائن).الكومدات[ج].الاسم) مع
            | اختياري.موجود(المالك) -> { محفوظة := المالك == مداخل_الكائنات[ك]; }
            | اختياري.لا_شيء -> { };
            ألحق(المهملة, !محفوظة);
            إذا (!محفوظة) {
                دع ع: متغير طبيعي = 0;
                طالما (ع < (الطول((*الكائن).الكومدات[ج].العناصر) مثل طبيعي)) {
                    دع الصنف: طبيعي = (*الكائن).الكومدات[ج].العناصر[ع].الصنف;
                    دع الفهرس: طبيعي = (*الكائن).الكومدات[ج].العناصر[ع].الفهرس;
                    إذا (الصنف == 0 && الفهرس < (الطول(القطع) مثل طبيعي)) {
                        القطع[الفهرس] := صواب;
                    } وإلا إذا (الصنف == 1 && الفهرس >= عدد_الدوال_المستوردة
                        && الفهرس - عدد_الدوال_المستوردة < (الطول(الدوال) مثل طبيعي)) {
                        الدوال[الفهرس - عدد_الدوال_المستوردة] := صواب;
                    } وإلا إذا (الصنف == 2 && الفهرس >= عدد_العوام_المستوردة
                        && الفهرس - عدد_العوام_المستوردة < (الطول(العوام) مثل طبيعي)) {
                        العوام[الفهرس - عدد_العوام_المستوردة] := صواب;
                    } وإلا إذا (الصنف != 5) {
                        أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    ع := ع + 1;
                }
            };
            ج := ج + 1;
        }
        ألحق(دوال_مهملة, الدوال);
        ألحق(قطع_مهملة, القطع);
        ألحق(عوام_مهملة, العوام);
        ألحق(كومدات_مهملة, المهملة);
        ك := ك + 1;
    }

    // ---- defined non-local symbols by (name, object)
    دع المعرفة: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع الكائن: &كائن_ويب_أسمبلي = &الكائنات[ك];
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول((*الكائن).الرموز) مثل طبيعي)) {
            دع الرمز: &رمز_كائن_ويب_أسمبلي = &(*الكائن).الرموز[ر];
            دع الأعلام: طبيعي = (*الرمز).الأعلام;
            إذا ((الأعلام & علم_رمز_محلي_ويب_أسمبلي()) == 0
                && (الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) == 0
                && (*الرمز).الصنف != صنف_رمز_قسم_ويب_أسمبلي()
                && !رمز_ويب_أسمبلي_في_كومدات_مهمل(الكائن, &كومدات_مهملة[ك], الرمز)) {
                دع المفتاح: متجه ط8 = مفتاح_رمز_كائن_ويب_أسمبلي(&(*الرمز).الاسم, ك);
                طابق ابحث_في_الخريطة(&المعرفة, &المفتاح) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    دع فهرس_الرمز_المدرج: طبيعي = ر;
                    طابق أدرج_في_الخريطة(&متغير المعرفة, المفتاح, فهرس_الرمز_المدرج) مع
                    | نتيجة.خطأ(_) -> {
                        أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    }
                    | نتيجة.نجح(_) -> { };
                };
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }

    // ---- output types
    دع الأنواع: متغير متجه متجه ط8 = [];
    دع خريطة_الأنواع_الناتجة: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع خرائط_الأنواع: متغير متجه متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع الخريطة_المحلية: متغير متجه طبيعي = [];
        دع ن: متغير طبيعي = 0;
        طالما (ن < (الطول(الكائنات[ك].الأنواع) مثل طبيعي)) {
            دع مرجع_النوع: &متجه ط8 = &الكائنات[ك].الأنواع[ن];
            دع النوع: متجه ط8 = انسخ_بايتات(مرجع_النوع);
            طابق ابحث_في_الخريطة(&خريطة_الأنواع_الناتجة, &النوع) مع
            | اختياري.موجود(الموجود) -> { ألحق(الخريطة_المحلية, الموجود); }
            | اختياري.لا_شيء -> {
                دع الجديد: طبيعي = الطول(الأنواع) مثل طبيعي;
                دع نسخة: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&النوع);
                طابق أدرج_في_الخريطة(&متغير خريطة_الأنواع_الناتجة, نسخة, الجديد) مع
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | نتيجة.نجح(_) -> { };
                ألحق(الأنواع, النوع);
                ألحق(الخريطة_المحلية, الجديد);
            };
            ن := ن + 1;
        }
        ألحق(خرائط_الأنواع, الخريطة_المحلية);
        ك := ك + 1;
    }
    // () -> (), the type of init functions and of __wasm_call_ctors.
    دع نوع_فارغ: متجه ط8 = [0x60, 0x00, 0x00];
    دع فهرس_النوع_الفارغ: متغير طبيعي = 0;
    طابق ابحث_في_الخريطة(&خريطة_الأنواع_الناتجة, &نوع_فارغ) مع
    | اختياري.موجود(الموجود) -> { فهرس_النوع_الفارغ := الموجود; }
    | اختياري.لا_شيء -> {
        فهرس_النوع_الفارغ := الطول(الأنواع) مثل طبيعي;
        دع نسخة: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&نوع_فارغ);
        ألحق(الأنواع, نسخة);
    };

    // ---- winners: the defining object of a global name, from the one link
    // symbol table; none when no input defines it.
    دع الفائزون: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع أصحاب_الفائزين: متغير متجه طبيعي = [];
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
            دع مرجع_الرمز: &رمز_كائن_ويب_أسمبلي = &الكائنات[ك].الرموز[ر];
            إذا (((*مرجع_الرمز).الأعلام & علم_رمز_محلي_ويب_أسمبلي()) == 0
                && (*مرجع_الرمز).الصنف != صنف_رمز_قسم_ويب_أسمبلي()) {
                دع الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&(*مرجع_الرمز).الاسم);
                طابق ابحث_في_الخريطة(&الفائزون, &الاسم) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    دع المالك: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
                    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, &الاسم) مع
                    | اختياري.موجود(الرمز_العام) -> {
                        طابق الرمز_العام.الحالة مع
                        | حالة_رمز_ربط.معرف(التعريف) -> {
                            إذا ((التعريف.المدخل.القيمة مثل طبيعي) < عدد_المدخلات) {
                                المالك := كائن_المدخل[التعريف.المدخل.القيمة];
                            };
                        }
                        | _ -> { };
                    }
                    | اختياري.لا_شيء -> { };
                    دع موضع_المالك: طبيعي = الطول(أصحاب_الفائزين) مثل طبيعي;
                    طابق أدرج_في_الخريطة(&متغير الفائزون, الاسم, موضع_المالك) مع
                    | نتيجة.خطأ(_) -> {
                        أرجع نتيجة_جمع_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    }
                    | نتيجة.نجح(_) -> { };
                    ألحق(أصحاب_الفائزين, المالك);
                };
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }

    *ناتج_الكائنات := الكائنات;
    *ناتج_المداخل := مداخل_الكائنات;
    *ناتج_دوال_مهملة := دوال_مهملة;
    *ناتج_قطع_مهملة := قطع_مهملة;
    *ناتج_عوام_مهملة := عوام_مهملة;
    *ناتج_كومدات_مهملة := كومدات_مهملة;
    *ناتج_المعرفة := المعرفة;
    *ناتج_الأنواع := الأنواع;
    *ناتج_خرائط_الأنواع := خرائط_الأنواع;
    *ناتج_النوع_الفارغ := فهرس_النوع_الفارغ;
    *ناتج_الفائزين := الفائزون;
    *ناتج_أصحاب_الفائزين := أصحاب_الفائزين;
    أرجع نتيجة_جمع_ويب_أسمبلي.جاهز();
}

عام عرف اربط_ويب_أسمبلي(
    السياق: &سياق_ربط
): نتيجة_مزود_ربط_ويب_أسمبلي {
    دع الخرج: نوع_خرج_ربط = (*السياق).الخطة.الخرج;
    دع تنفيذي: منطقي = الخرج == نوع_خرج_ربط.تنفيذي();
    // A shared module (see the file comment): position-independent code,
    // imported memory, table, stack pointer and bases, `dylink.0`.
    دع مشترك: منطقي = الخرج == نوع_خرج_ربط.مكتبة_مشتركة();
    إذا ((*السياق).الهدف.نموذج_البيانات.عرض_المؤشر == 32
        && الخرج == نوع_خرج_ربط.كائن_مترابط()) {
        أرجع اربط_كائن_مترابط_ويب_أسمبلي(السياق);
    };
    إذا (!تنفيذي && !مشترك && الخرج != نوع_خرج_ربط.وحدة_هدف()) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
    };
    إذا ((*السياق).الهدف.نموذج_البيانات.عرض_المؤشر != 32) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
    };
    إذا (مشترك && (*السياق).الهدف.مزود_التشغيل != مزود_تشغيل_هدف.واسي()) {
        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.خطة_غير_مدعومة());
    };

    // ---- inputs, COMDAT, types and winners
    دع الكائنات: متغير متجه كائن_ويب_أسمبلي = [];
    دع مداخل_الكائنات: متغير متجه طبيعي = [];
    دع دوال_مهملة: متغير متجه متجه منطقي = [];
    دع قطع_مهملة: متغير متجه متجه منطقي = [];
    دع عوام_مهملة: متغير متجه متجه منطقي = [];
    دع كومدات_مهملة: متغير متجه متجه منطقي = [];
    دع المعرفة: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع الأنواع: متغير متجه متجه ط8 = [];
    دع خرائط_الأنواع: متغير متجه متجه طبيعي = [];
    دع فهرس_النوع_الفارغ: متغير طبيعي = 0;
    دع الفائزون: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع أصحاب_الفائزين: متغير متجه طبيعي = [];
    طابق اجمع_مدخلات_ويب_أسمبلي(
        السياق, !تنفيذي && !مشترك, مشترك,
        &متغير الكائنات, &متغير مداخل_الكائنات,
        &متغير دوال_مهملة, &متغير قطع_مهملة, &متغير عوام_مهملة, &متغير كومدات_مهملة,
        &متغير المعرفة, &متغير الأنواع, &متغير خرائط_الأنواع, &متغير فهرس_النوع_الفارغ,
        &متغير الفائزون, &متغير أصحاب_الفائزين
    ) مع
    | نتيجة_جمع_ويب_أسمبلي.خطأ(الخطأ) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(الخطأ); }
    | نتيجة_جمع_ويب_أسمبلي.تمرير(البايتات) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.نجح(البايتات); }
    | نتيجة_جمع_ويب_أسمبلي.جاهز -> { };
    دع عدد_الكائنات: طبيعي = الطول(الكائنات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;

    // ---- shared-module inputs: the kind of every name they export (the
    // first input to export a name wins), so a reference resolved against one
    // is checked (wasm/dynamic_ingest.sn).
    دع أصناف_المكتبات: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    إذا (مشترك) {
        ف := 0;
        طالما (ف < (الطول((*السياق).الخطة.المدخلات) مثل طبيعي)) {
            دع مدخل_المكتبة: &مدخل_ربط = &(*السياق).الخطة.المدخلات[ف];
            طابق (*مدخل_المكتبة).الصنف مع
            | صنف_مدخل_ربط.مكتبة_ديناميكية -> {
                طابق اقرأ_مكتبة_ويب_أسمبلي(&(*مدخل_المكتبة).البايتات) مع
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | نتيجة.نجح(المكتبة) -> {
                    دع م: متغير طبيعي = 0;
                    طالما (م < (الطول(المكتبة.التصديرات) مثل طبيعي)) {
                        دع اسم_التصدير: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&المكتبة.التصديرات[م].الاسم);
                        دع صنف_التصدير: طبيعي = المكتبة.التصديرات[م].الصنف;
                        طابق ابحث_في_الخريطة(&أصناف_المكتبات, &اسم_التصدير) مع
                        | اختياري.موجود(_) -> { }
                        | اختياري.لا_شيء -> {
                            طابق أدرج_في_الخريطة(&متغير أصناف_المكتبات, اسم_التصدير, صنف_التصدير) مع
                            | نتيجة.خطأ(_) -> {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                            }
                            | نتيجة.نجح(_) -> { };
                        };
                        م := م + 1;
                    }
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
    };

    // ---- imports: functions and globals no input defines
    دع الاستيرادات: متغير متجه استيراد_ناتج_ويب_أسمبلي = [];
    دع مفاتيح_الاستيراد: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع اسم_المكدس: متجه ط8 = بايتات_من_نص(«__stack_pointer»);
    دع اسم_المنشئات: متجه ط8 = بايتات_من_نص(«__wasm_call_ctors»);
    دع يستدعى_المنشئات: متغير منطقي = خطأ;
    دع يحتاج_الجدول: متغير منطقي = خطأ;
    دع الصنف_الحالي: متغير طبيعي = 0;
    // Functions first, then globals, so imported functions precede globals in
    // each index space's numbering (each space is numbered separately).
    دع عدد_الدوال_المستوردة_الناتجة: متغير طبيعي = 0;
    دع عدد_العوام_المستوردة_الناتجة: متغير طبيعي = 0;
    دع فهارس_الاستيراد_في_صنفها: متغير متجه طبيعي = [];
    طالما (الصنف_الحالي < 2) {
        ك := 0;
        طالما (ك < عدد_الكائنات) {
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
                دع مرجع_الرمز: &رمز_كائن_ويب_أسمبلي = &الكائنات[ك].الرموز[ر];
                دع الرمز: رمز_كائن_ويب_أسمبلي = *مرجع_الرمز;
                دع صنف_مطلوب: متغير طبيعي = صنف_رمز_دالة_ويب_أسمبلي();
                إذا (الصنف_الحالي == 1) { صنف_مطلوب := صنف_رمز_عام_ويب_أسمبلي(); };
                إذا (الرمز.الصنف == صنف_رمز_جدول_ويب_أسمبلي()) { يحتاج_الجدول := صواب; };
                إذا (الرمز.الصنف == صنف_مطلوب
                    && (الرمز.الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0) {
                    دع له_تعريف: متغير منطقي = خطأ;
                    طابق ابحث_في_الخريطة(&الفائزون, &الرمز.الاسم) مع
                    | اختياري.موجود(موضع_الفائز) -> {
                        له_تعريف := أصحاب_الفائزين[موضع_الفائز] != لا_فهرس_ويب_أسمبلي();
                    }
                    | اختياري.لا_شيء -> { };
                    إذا (الصنف_الحالي == 0 && مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_المنشئات)) {
                        يستدعى_المنشئات := صواب;
                        له_تعريف := صواب;
                    };
                    // A shared module imports the stack pointer like any
                    // other undefined global; everything else defines it.
                    إذا (!مشترك && الصنف_الحالي == 1 && مفتاحا_ويب_أسمبلي_متساويان(&الرمز.الاسم, &اسم_المكدس)) {
                        له_تعريف := صواب;
                    };
                    إذا (!له_تعريف) {
                        // A name a shared-module input exports must be of
                        // the same kind (function; data or global).
                        طابق ابحث_في_الخريطة(&أصناف_المكتبات, &الرمز.الاسم) مع
                        | اختياري.موجود(صنف_المكتبة) -> {
                            إذا ((الصنف_الحالي == 0 && صنف_المكتبة != صنف_تصدير_دالة_مكتبة_ويب_أسمبلي())
                                || (الصنف_الحالي == 1 && صنف_المكتبة == صنف_تصدير_دالة_مكتبة_ويب_أسمبلي())) {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                                    خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                                );
                            };
                        }
                        | اختياري.لا_شيء -> { };
                        // The import entry this undefined symbol names.
                        دع فهارس_الصنف: متغير متجه طبيعي = [];
                        إذا (الصنف_الحالي == 0) {
                            دع مرجع_الفهارس: &متجه طبيعي = &الكائنات[ك].استيرادات_الدوال;
                            فهارس_الصنف := انسخ_مملوكا__متجه_طبيعي(مرجع_الفهارس);
                        } وإلا {
                            دع مرجع_الفهارس: &متجه طبيعي = &الكائنات[ك].استيرادات_العوام;
                            فهارس_الصنف := انسخ_مملوكا__متجه_طبيعي(مرجع_الفهارس);
                        };
                        إذا (الرمز.الفهرس >= (الطول(فهارس_الصنف) مثل طبيعي)) {
                            أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                        };
                        دع مرجع_الاستيراد: &استيراد_كائن_ويب_أسمبلي =
                            &الكائنات[ك].الاستيرادات[فهارس_الصنف[الرمز.الفهرس]];
                        دع الاستيراد: استيراد_كائن_ويب_أسمبلي = *مرجع_الاستيراد;
                        دع الوصف: متغير طبيعي = الاستيراد.الوصف;
                        إذا (الصنف_الحالي == 0) {
                            إذا (الوصف >= (الطول(خرائط_الأنواع[ك]) مثل طبيعي)) {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                            };
                            الوصف := خرائط_الأنواع[ك][الوصف];
                        };
                        دع المفتاح: متجه ط8 = مفتاح_استيراد_ويب_أسمبلي(&الاستيراد.الوحدة, &الاستيراد.الحقل);
                        دع مرجع_ضعيف: منطقي = (الرمز.الأعلام & علم_رمز_ضعيف_ويب_أسمبلي()) != 0;
                        طابق ابحث_في_الخريطة(&مفاتيح_الاستيراد, &المفتاح) مع
                        | اختياري.موجود(الموجود) -> {
                            إذا (الاستيرادات[الموجود].الصنف != الاستيراد.الصنف
                                || الاستيرادات[الموجود].الوصف != الوصف) {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                                    خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم))
                                );
                            };
                            إذا (!مرجع_ضعيف) { الاستيرادات[الموجود].ضعيف := خطأ; };
                        }
                        | اختياري.لا_شيء -> {
                            دع الموضع: طبيعي = الطول(الاستيرادات) مثل طبيعي;
                            طابق أدرج_في_الخريطة(&متغير مفاتيح_الاستيراد, المفتاح, الموضع) مع
                            | نتيجة.خطأ(_) -> {
                                أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                            }
                            | نتيجة.نجح(_) -> { };
                            دع الناتج: استيراد_ناتج_ويب_أسمبلي = {
                                الوحدة: انسخ_بايتات_ويب_أسمبلي(&الاستيراد.الوحدة),
                                الحقل: انسخ_بايتات_ويب_أسمبلي(&الاستيراد.الحقل),
                                الصنف: الاستيراد.الصنف,
                                الوصف: الوصف,
                                قابل_للتغيير: الاستيراد.قابل_للتغيير,
                                الاسم: انسخ_بايتات_ويب_أسمبلي(&الرمز.الاسم),
                                ضعيف: مرجع_ضعيف
                            };
                            ألحق(الاستيرادات, الناتج);
                            إذا (الصنف_الحالي == 0) {
                                ألحق(فهارس_الاستيراد_في_صنفها, عدد_الدوال_المستوردة_الناتجة);
                                عدد_الدوال_المستوردة_الناتجة := عدد_الدوال_المستوردة_الناتجة + 1;
                            } وإلا {
                                ألحق(فهارس_الاستيراد_في_صنفها, عدد_العوام_المستوردة_الناتجة);
                                عدد_العوام_المستوردة_الناتجة := عدد_العوام_المستوردة_الناتجة + 1;
                            };
                        };
                    };
                };
                ر := ر + 1;
            }
            ك := ك + 1;
        }
        الصنف_الحالي := الصنف_الحالي + 1;
    }

    // ---- shared module: GOT entries (scanned before global indices are
    // assigned, since imported GOT entries are globals) and the bases.
    دع المؤشرات: متغير متجه مدخل_مؤشر_ويب_أسمبلي = [];
    دع مفاتيح_المؤشرات: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    دع عام_قاعدة_الذاكرة: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
    دع عام_قاعدة_الجدول: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
    إذا (مشترك) {
        ك := 0;
        طالما (ك < عدد_الكائنات) {
            دع مج: متغير طبيعي = 0;
            طالما (مج < (الطول(الكائنات[ك].الإزاحات) مثل طبيعي)) {
                دع في_البيانات: منطقي = (الطول(الكائنات[ك].القطع) مثل طبيعي) > 0
                    && الكائنات[ك].الإزاحات[مج].القسم == الكائنات[ك].فهرس_قسم_البيانات;
                دع ز: متغير طبيعي = 0;
                طالما (ز < (الطول(الكائنات[ك].الإزاحات[مج].الإزاحات) مثل طبيعي)) {
                    دع نوع_الإزاحة: طبيعي = الكائنات[ك].الإزاحات[مج].الإزاحات[ز].النوع;
                    دع رمز_الإزاحة: طبيعي = الكائنات[ك].الإزاحات[مج].الإزاحات[ز].الفهرس;
                    إذا (نوع_الإزاحة != 6 && رمز_الإزاحة < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
                        دع صنف_الرمز: طبيعي = الكائنات[ك].الرموز[رمز_الإزاحة].الصنف;
                        دع عنواني: منطقي = صنف_الرمز == صنف_رمز_بيانات_ويب_أسمبلي()
                            || صنف_الرمز == صنف_رمز_دالة_ويب_أسمبلي();
                        دع يحتاج: منطقي = رمز_يحتاج_مؤشرا_ويب_أسمبلي(
                            &الكائنات, ك, رمز_الإزاحة, &الفائزون, &أصحاب_الفائزين, &المعرفة
                        );
                        دع يطلب: متغير منطقي = خطأ;
                        // Code reaching the symbol through its GOT entry.
                        إذا ((نوع_الإزاحة == 7 || نوع_الإزاحة == 13) && عنواني) { يطلب := صواب; };
                        // An address in data the loader must supply.
                        إذا (في_البيانات && (نوع_الإزاحة == 2 || نوع_الإزاحة == 5) && عنواني && يحتاج) {
                            يطلب := صواب;
                        };
                        إذا (يطلب) {
                            دع المفتاح: متجه ط8 = مفتاح_مؤشر_ويب_أسمبلي(&الكائنات[ك].الرموز[رمز_الإزاحة], ك);
                            طابق ابحث_في_الخريطة(&مفاتيح_المؤشرات, &المفتاح) مع
                            | اختياري.موجود(_) -> { }
                            | اختياري.لا_شيء -> {
                                دع موضع_المؤشر: طبيعي = الطول(المؤشرات) مثل طبيعي;
                                طابق أدرج_في_الخريطة(&متغير مفاتيح_المؤشرات, المفتاح, موضع_المؤشر) مع
                                | نتيجة.خطأ(_) -> {
                                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                                }
                                | نتيجة.نجح(_) -> { };
                                دع المدخل_الجديد: مدخل_مؤشر_ويب_أسمبلي = {
                                    الكائن: ك,
                                    الرمز: رمز_الإزاحة,
                                    هي_دالة: صنف_الرمز == صنف_رمز_دالة_ويب_أسمبلي(),
                                    داخلي: !يحتاج,
                                    العام: لا_فهرس_ويب_أسمبلي()
                                };
                                ألحق(المؤشرات, المدخل_الجديد);
                            };
                        };
                    };
                    ز := ز + 1;
                }
                مج := مج + 1;
            }
            ك := ك + 1;
        }
        // Imported GOT entries: mutable i32 globals `GOT.mem.<name>` and
        // `GOT.func.<name>`, filled by the loader.
        دع م_مؤشر: متغير طبيعي = 0;
        طالما (م_مؤشر < (الطول(المؤشرات) مثل طبيعي)) {
            إذا (!المؤشرات[م_مؤشر].داخلي) {
                دع كائن_المؤشر: طبيعي = المؤشرات[م_مؤشر].الكائن;
                دع رمز_المؤشر: طبيعي = المؤشرات[م_مؤشر].الرمز;
                دع الحقل: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الكائنات[كائن_المؤشر].الرموز[رمز_المؤشر].الاسم);
                دع أعلام_المؤشر: طبيعي = الكائنات[كائن_المؤشر].الرموز[رمز_المؤشر].الأعلام;
                // A name no object defines that a shared-module input
                // exports must be of the same kind: a function for GOT.func,
                // a data address for GOT.mem.
                دع معرف_في_الكائنات: متغير منطقي = خطأ;
                طابق ابحث_في_الخريطة(&الفائزون, &الحقل) مع
                | اختياري.موجود(موضع_الفائز) -> {
                    معرف_في_الكائنات := أصحاب_الفائزين[موضع_الفائز] != لا_فهرس_ويب_أسمبلي();
                }
                | اختياري.لا_شيء -> { };
                دع صنف_مكتبة_المؤشر: متغير اختياري طبيعي = اختياري.لا_شيء();
                إذا (!معرف_في_الكائنات) {
                    طابق ابحث_في_الخريطة(&أصناف_المكتبات, &الحقل) مع
                    | اختياري.موجود(الصنف_الموجود) -> { صنف_مكتبة_المؤشر := اختياري.موجود(الصنف_الموجود); }
                    | اختياري.لا_شيء -> { };
                };
                طابق صنف_مكتبة_المؤشر مع
                | اختياري.موجود(صنف_المكتبة) -> {
                    دع المتوقع: متغير طبيعي = صنف_تصدير_بيانات_مكتبة_ويب_أسمبلي();
                    إذا (المؤشرات[م_مؤشر].هي_دالة) { المتوقع := صنف_تصدير_دالة_مكتبة_ويب_أسمبلي(); };
                    إذا (صنف_المكتبة != المتوقع) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                            خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الحقل))
                        );
                    };
                }
                | اختياري.لا_شيء -> { };
                دع الوحدة: متغير متجه ط8 = بايتات_من_نص(«GOT.mem»);
                إذا (المؤشرات[م_مؤشر].هي_دالة) { الوحدة := بايتات_من_نص(«GOT.func»); };
                دع المفتاح: متجه ط8 = مفتاح_استيراد_ويب_أسمبلي(&الوحدة, &الحقل);
                طابق ابحث_في_الخريطة(&مفاتيح_الاستيراد, &المفتاح) مع
                | اختياري.موجود(الموجود) -> {
                    المؤشرات[م_مؤشر].العام := فهارس_الاستيراد_في_صنفها[الموجود];
                }
                | اختياري.لا_شيء -> {
                    دع الموضع: طبيعي = الطول(الاستيرادات) مثل طبيعي;
                    طابق أدرج_في_الخريطة(&متغير مفاتيح_الاستيراد, المفتاح, الموضع) مع
                    | نتيجة.خطأ(_) -> {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                    }
                    | نتيجة.نجح(_) -> { };
                    دع الاسم_المؤشر: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&الحقل);
                    دع الناتج: استيراد_ناتج_ويب_أسمبلي = {
                        الوحدة: الوحدة,
                        الحقل: الحقل,
                        الصنف: 3,
                        الوصف: 0x7F,
                        قابل_للتغيير: صواب,
                        الاسم: الاسم_المؤشر,
                        ضعيف: (أعلام_المؤشر & علم_رمز_ضعيف_ويب_أسمبلي()) != 0
                            && (أعلام_المؤشر & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0
                    };
                    ألحق(الاستيرادات, الناتج);
                    ألحق(فهارس_الاستيراد_في_صنفها, عدد_العوام_المستوردة_الناتجة);
                    المؤشرات[م_مؤشر].العام := عدد_العوام_المستوردة_الناتجة;
                    عدد_العوام_المستوردة_الناتجة := عدد_العوام_المستوردة_الناتجة + 1;
                };
            };
            م_مؤشر := م_مؤشر + 1;
        }
        // env.__memory_base and env.__table_base: immutable i32 globals the
        // loader sets to the module's reserved memory and table regions.
        دع جولة_القاعدة: متغير طبيعي = 0;
        طالما (جولة_القاعدة < 2) {
            دع الوحدة: متجه ط8 = بايتات_من_نص(«env»);
            دع الحقل: متغير متجه ط8 = بايتات_من_نص(«__memory_base»);
            إذا (جولة_القاعدة == 1) { الحقل := بايتات_من_نص(«__table_base»); };
            دع المفتاح: متجه ط8 = مفتاح_استيراد_ويب_أسمبلي(&الوحدة, &الحقل);
            دع فهرس_القاعدة: متغير طبيعي = 0;
            طابق ابحث_في_الخريطة(&مفاتيح_الاستيراد, &المفتاح) مع
            | اختياري.موجود(الموجود) -> {
                إذا (الاستيرادات[الموجود].الصنف != 3 || الاستيرادات[الموجود].الوصف != 0x7F) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(
                        خطأ_مزود_ربط_ويب_أسمبلي.نوع_رمز_غير_مطابق(انسخ_بايتات_ويب_أسمبلي(&الحقل))
                    );
                };
                فهرس_القاعدة := فهارس_الاستيراد_في_صنفها[الموجود];
            }
            | اختياري.لا_شيء -> {
                دع الموضع: طبيعي = الطول(الاستيرادات) مثل طبيعي;
                طابق أدرج_في_الخريطة(&متغير مفاتيح_الاستيراد, المفتاح, الموضع) مع
                | نتيجة.خطأ(_) -> {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | نتيجة.نجح(_) -> { };
