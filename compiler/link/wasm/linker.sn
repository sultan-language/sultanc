                دع م: متغير طبيعي = 0;
                طالما (م < المعاملات) {
                    ألحق_بايت_ويب_أسمبلي(&متغير الجسم, 0x20);
                    ألحق_ليب_ويب_أسمبلي(&متغير الجسم, م);
                    م := م + 1;
                }
                ألحق_بايت_ويب_أسمبلي(&متغير الجسم, 0x10);
                طابق الدخول مع
                | اختياري.موجود(فهرس_الدخول) -> { ألحق_ليب_ويب_أسمبلي(&متغير الجسم, فهرس_الدخول); }
                | اختياري.لا_شيء -> { ألحق_ليب_ويب_أسمبلي(&متغير الجسم, 0); };
            };
            ألحق_بايت_ويب_أسمبلي(&متغير الجسم, 0x0B);
            ألحق_ليب_ويب_أسمبلي(&متغير قسم_الشفرة, الطول(الجسم) مثل طبيعي);
            ألحق(مواضع_الأجسام, الطول(قسم_الشفرة) مثل طبيعي);
            ألحق_بايتات_ويب_أسمبلي(&متغير قسم_الشفرة, &الجسم);
        };
        د := د + 1;
    }

    // Function-offset fields of custom sections recorded a function index
    // (see the relocation pass); they are rewritten now that bodies are
    // placed. The pass marked them with a pending-index entry list.
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع مج: متغير طبيعي = 0;
        طالما (مج < (الطول(الكائنات[ك].الإزاحات) مثل طبيعي)) {
            دع القسم: طبيعي = الكائنات[ك].الإزاحات[مج].القسم;
            دع موضع_مخصص: متغير طبيعي = لا_فهرس_ويب_أسمبلي();
            دع م2: متغير طبيعي = 0;
            طالما (م2 < (الطول(الكائنات[ك].المخصصة) مثل طبيعي)) {
                إذا (الكائنات[ك].المخصصة[م2].الفهرس == القسم) { موضع_مخصص := م2; };
                م2 := م2 + 1;
            }
            إذا (موضع_مخصص != لا_فهرس_ويب_أسمبلي()) {
                دع ز: متغير طبيعي = 0;
                طالما (ز < (الطول(الكائنات[ك].الإزاحات[مج].الإزاحات) مثل طبيعي)) {
                    دع مرجع_الإزاحة: &إزاحة_كائن_ويب_أسمبلي = &الكائنات[ك].الإزاحات[مج].الإزاحات[ز];
                    دع الإزاحة: إزاحة_كائن_ويب_أسمبلي = *مرجع_الإزاحة;
                    إذا (الإزاحة.النوع == 8 || الإزاحة.النوع == 22) {
                        دع القيمة: متغير طبيعي = 4294967295;
                        إذا (الإزاحة.النوع == 22) { القيمة := لا_فهرس_ويب_أسمبلي(); };
                        طابق الأهداف[ك][الإزاحة.الفهرس] مع
                        | هدف_رمز_ويب_أسمبلي.دالة_ناتجة(الفهرس) -> {
                            إذا (الفهرس != لا_فهرس_ويب_أسمبلي()
                                && الفهرس >= عدد_الدوال_المستوردة_الناتجة
                                && الفهرس - عدد_الدوال_المستوردة_الناتجة < (الطول(مواضع_الأجسام) مثل طبيعي)) {
                                دع المجموع: عدد = (مواضع_الأجسام[الفهرس - عدد_الدوال_المستوردة_الناتجة] مثل عدد)
                                    + الإزاحة.الإضافة;
                                إذا (المجموع >= 0) { القيمة := المجموع مثل طبيعي; };
                            };
                        }
                        | _ -> { };
                        إذا (الإزاحة.النوع == 8) {
                            اكتب_ط32_ويب_أسمبلي_عند(&متغير مخصصات_الكائنات[ك][موضع_مخصص], الإزاحة.الموضع, القيمة);
                        } وإلا {
                            اكتب_ط64_ويب_أسمبلي_عند(&متغير مخصصات_الكائنات[ك][موضع_مخصص], الإزاحة.الموضع, القيمة);
                        };
                    };
                    ز := ز + 1;
                }
            };
            مج := مج + 1;
        }
        ك := ك + 1;
    }

    // ---- data section
    دع قسم_البيانات: متغير متجه ط8 = [];
    دع عدد_القطع_المكتوبة: متغير طبيعي = 0;
    ت := 0;
    طالما (ت < (الطول(ترتيب_المجموعات) مثل طبيعي)) {
        دع ج: طبيعي = ترتيب_المجموعات[ت];
        إذا (!القطع_الناتجة[ج].صفرية && القطع_الناتجة[ج].الحجم > 0) {
            دع المحتوى: متغير متجه ط8 = [];
            دع ص: متغير طبيعي = 0;
            طالما (ص < القطع_الناتجة[ج].الحجم) { ألحق(المحتوى, 0 مثل ط8); ص := ص + 1; }
            ك := 0;
            طالما (ك < عدد_الكائنات) {
                دع ق: متغير طبيعي = 0;
                طالما (ق < (الطول(الكائنات[ك].القطع) مثل طبيعي)) {
                    إذا (مجموعة_القطع[ك][ق] == ج) {
                        دع الأساس: طبيعي = عناوين_القطع[ك][ق] - القطع_الناتجة[ج].العنوان;
                        دع البداية: طبيعي = الكائنات[ك].القطع[ق].بداية_البايتات;
                        دع ب: متغير طبيعي = 0;
                        طالما (ب < الكائنات[ك].القطع[ق].الحجم) {
                            المحتوى[الأساس + ب] := بيانات_الكائنات[ك][البداية + ب];
                            ب := ب + 1;
                        }
                    };
                    ق := ق + 1;
                }
                ك := ك + 1;
            }
            ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, 0);
            إذا (مشترك) {
                // The one initialized segment of a shared module, at the
                // start of its reserved region.
                إذا (القطع_الناتجة[ج].العنوان != 0) {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
                ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x23); // global.get __memory_base
                ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, عام_قاعدة_الذاكرة);
            } وإلا {
                ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x41);
                ألحق_سليب_ويب_أسمبلي(&متغير قسم_البيانات, قيمة_موقعة_32_من_بتات(القطع_الناتجة[ج].العنوان));
            };
            ألحق_بايت_ويب_أسمبلي(&متغير قسم_البيانات, 0x0B);
            ألحق_ليب_ويب_أسمبلي(&متغير قسم_البيانات, الطول(المحتوى) مثل طبيعي);
            ألحق_بايتات_ويب_أسمبلي(&متغير قسم_البيانات, &المحتوى);
            عدد_القطع_المكتوبة := عدد_القطع_المكتوبة + 1;
        };
        ت := ت + 1;
    }

    // ---- exports
    دع التصديرات: متغير متجه ط8 = [];
    دع عدد_التصديرات: متغير طبيعي = 0;
    دع أسماء_التصديرات: متغير الخريطة<متجه ط8, طبيعي> = خريطة_ويب_أسمبلي();
    // A shared module imports its memory instead.
    إذا (!مشترك) {
        دع اسم_الذاكرة: متجه ط8 = بايتات_من_نص(«memory»);
        ألحق_اسم_ويب_أسمبلي(&متغير التصديرات, &اسم_الذاكرة);
        ألحق_بايت_ويب_أسمبلي(&متغير التصديرات, 2);
        ألحق_ليب_ويب_أسمبلي(&متغير التصديرات, 0);
        عدد_التصديرات := عدد_التصديرات + 1;
        دع نسخة_اسم_الذاكرة: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&اسم_الذاكرة);
        طابق أدرج_في_الخريطة(&متغير أسماء_التصديرات, نسخة_اسم_الذاكرة, لا_فهرس_ويب_أسمبلي()) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()); }
        | نتيجة.نجح(_) -> { };
    };
    طابق الدخول مع
    | اختياري.موجود(فهرس_الدخول) -> {
        دع المصدر: متغير طبيعي = فهرس_الدخول;
        إذا (فهرس_الغلاف != لا_فهرس_ويب_أسمبلي()) { المصدر := فهرس_الغلاف; };
        ألحق_اسم_ويب_أسمبلي(&متغير التصديرات, &اسم_الدخول);
        ألحق_بايت_ويب_أسمبلي(&متغير التصديرات, 0);
        ألحق_ليب_ويب_أسمبلي(&متغير التصديرات, المصدر);
        عدد_التصديرات := عدد_التصديرات + 1;
        دع نسخة_اسم_الدخول: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&اسم_الدخول);
        طابق أدرج_في_الخريطة(&متغير أسماء_التصديرات, نسخة_اسم_الدخول, لا_فهرس_ويب_أسمبلي()) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()); }
        | نتيجة.نجح(_) -> { };
    }
    | اختياري.لا_شيء -> {
        // A module without an entry runs its init functions from the WASI
        // reactor export `_initialize`.
        إذا (!مشترك && فهرس_المنشئات != لا_فهرس_ويب_أسمبلي() && !يستدعى_المنشئات) {
            دع اسم_التهيئة: متجه ط8 = بايتات_من_نص(«_initialize»);
            ألحق_اسم_ويب_أسمبلي(&متغير التصديرات, &اسم_التهيئة);
            ألحق_بايت_ويب_أسمبلي(&متغير التصديرات, 0);
            ألحق_ليب_ويب_أسمبلي(&متغير التصديرات, فهرس_المنشئات);
            عدد_التصديرات := عدد_التصديرات + 1;
        };
    };
    // A shared module exports its initializers for the loader:
    // __wasm_apply_data_relocs (called first) and __wasm_call_ctors.
    دع قيم_عوام_التصدير: متغير متجه طبيعي = [];
    دع تصديرات_ضعيفة: متغير متجه متجه ط8 = [];
    إذا (مشترك) {
        دع جولة_المهيئات: متغير طبيعي = 0;
        طالما (جولة_المهيئات < 2) {
            دع فهرس_المهيئ: متغير طبيعي = فهرس_تطبيق_الإزاحات;
            دع اسم_المهيئ: متغير متجه ط8 = بايتات_من_نص(«__wasm_apply_data_relocs»);
            إذا (جولة_المهيئات == 1) {
                فهرس_المهيئ := فهرس_المنشئات;
                اسم_المهيئ := انسخ_بايتات_ويب_أسمبلي(&اسم_المنشئات);
            };
            إذا (فهرس_المهيئ != لا_فهرس_ويب_أسمبلي()) {
                ألحق_اسم_ويب_أسمبلي(&متغير التصديرات, &اسم_المهيئ);
                ألحق_بايت_ويب_أسمبلي(&متغير التصديرات, 0);
                ألحق_ليب_ويب_أسمبلي(&متغير التصديرات, فهرس_المهيئ);
                عدد_التصديرات := عدد_التصديرات + 1;
                دع نسخة_اسم_المهيئ: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&اسم_المهيئ);
                طابق أدرج_في_الخريطة(&متغير أسماء_التصديرات, نسخة_اسم_المهيئ, لا_فهرس_ويب_أسمبلي()) مع
                | نتيجة.خطأ(_) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()); }
                | نتيجة.نجح(_) -> { };
            };
            جولة_المهيئات := جولة_المهيئات + 1;
        }
    };
    // Symbols flagged EXPORTED (export_name) are exported under their name.
    // A shared module also exports each winning definition of default
    // visibility: functions and globals as themselves, data as an immutable
    // i32 global holding its address relative to __memory_base (the loader
    // adds the base).
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
            دع مرجع_الرمز: &رمز_كائن_ويب_أسمبلي = &الكائنات[ك].الرموز[ر];
            دع الأعلام: طبيعي = (*مرجع_الرمز).الأعلام;
            دع معرف_الرمز: منطقي = (الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) == 0;
            دع مصدر_صراحة: منطقي = (الأعلام & علم_رمز_مصدر_ويب_أسمبلي()) != 0 && معرف_الرمز;
            دع مصدر_مشترك: متغير منطقي = خطأ;
            إذا (مشترك && معرف_الرمز
                && (الأعلام & علم_رمز_محلي_ويب_أسمبلي()) == 0
                && (الأعلام & علم_رمز_مخفي_ويب_أسمبلي()) == 0
                && ((*مرجع_الرمز).الصنف == صنف_رمز_دالة_ويب_أسمبلي()
                    || (*مرجع_الرمز).الصنف == صنف_رمز_بيانات_ويب_أسمبلي()
                    || (*مرجع_الرمز).الصنف == صنف_رمز_عام_ويب_أسمبلي())) {
                طابق ابحث_في_الخريطة(&الفائزون, &(*مرجع_الرمز).الاسم) مع
                | اختياري.موجود(موضع_الفائز) -> { مصدر_مشترك := أصحاب_الفائزين[موضع_الفائز] == ك; }
                | اختياري.لا_شيء -> { };
            };
            إذا (مصدر_صراحة || مصدر_مشترك) {
                دع الاسم: متجه ط8 = انسخ_بايتات_ويب_أسمبلي(&(*مرجع_الرمز).الاسم);
                دع الصنف: متغير طبيعي = 99;
                دع الفهرس_المصدر: متغير طبيعي = 0;
                دع عنوان_بيانات: متغير اختياري طبيعي = اختياري.لا_شيء();
                طابق الأهداف[ك][ر] مع
                | هدف_رمز_ويب_أسمبلي.دالة_ناتجة(الفهرس) -> { الصنف := 0; الفهرس_المصدر := الفهرس; }
                | هدف_رمز_ويب_أسمبلي.عام_ناتج(الفهرس) -> { الصنف := 3; الفهرس_المصدر := الفهرس; }
                | هدف_رمز_ويب_أسمبلي.بيانات_كائن(الكائن, القطعة, الإزاحة_الداخلية) -> {
                    إذا (!مشترك) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    عنوان_بيانات := اختياري.موجود(عناوين_القطع[الكائن][القطعة] + الإزاحة_الداخلية);
                }
                | هدف_رمز_ويب_أسمبلي.عنوان_ثابت(القيمة_الثابتة) -> {
                    إذا (!مشترك) {
                        أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                    };
                    عنوان_بيانات := اختياري.موجود(القيمة_الثابتة);
                }
                | _ -> {
                    أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
                طابق ابحث_في_الخريطة(&أسماء_التصديرات, &الاسم) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> {
                    طابق عنوان_بيانات مع
                    | اختياري.موجود(العنوان) -> {
                        الصنف := 3;
                        الفهرس_المصدر := التالي_العام;
                        ألحق(قيم_عوام_التصدير, العنوان);
                        التالي_العام := التالي_العام + 1;
                    }
                    | اختياري.لا_شيء -> { };
                    إذا (مشترك && (الأعلام & علم_رمز_ضعيف_ويب_أسمبلي()) != 0) {
                        ألحق(تصديرات_ضعيفة, انسخ_بايتات_ويب_أسمبلي(&الاسم));
                    };
                    ألحق_اسم_ويب_أسمبلي(&متغير التصديرات, &الاسم);
                    ألحق_بايت_ويب_أسمبلي(&متغير التصديرات, الصنف);
                    ألحق_ليب_ويب_أسمبلي(&متغير التصديرات, الفهرس_المصدر);
                    عدد_التصديرات := عدد_التصديرات + 1;
                    طابق أدرج_في_الخريطة(&متغير أسماء_التصديرات, الاسم, لا_فهرس_ويب_أسمبلي()) مع
                    | نتيجة.خطأ(_) -> { أرجع نتيجة_مزود_ربط_ويب_أسمبلي.خطأ(خطأ_مزود_ربط_ويب_أسمبلي.وحدة_غير_صالحة()); }
                    | نتيجة.نجح(_) -> { };
                };
            };
            ر := ر + 1;
        }
        ك := ك + 1;
    }

    // ---- function names (the `name` section)
    دع أسماء_الدوال: متغير متجه متجه ط8 = [];
    ع := 0;
    طالما (ع < التالي) {
        دع فارغ: متجه ط8 = [];
        ألحق(أسماء_الدوال, فارغ);
        ع := ع + 1;
    }
    دع ي: متغير طبيعي = 0;
    طالما (ي < (الطول(الاستيرادات) مثل طبيعي)) {
        إذا (الاستيرادات[ي].الصنف == 0) {
            دع مرجع_الاسم: &متجه ط8 = &الاستيرادات[ي].الاسم;
            أسماء_الدوال[فهارس_الاستيراد_في_صنفها[ي]] := انسخ_بايتات(مرجع_الاسم);
        };
        ي := ي + 1;
    }
    ك := 0;
    طالما (ك < عدد_الكائنات) {
        دع ر: متغير طبيعي = 0;
        طالما (ر < (الطول(الكائنات[ك].الرموز) مثل طبيعي)) {
            إذا (الكائنات[ك].الرموز[ر].الصنف == صنف_رمز_دالة_ويب_أسمبلي()
                && (الكائنات[ك].الرموز[ر].الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) == 0) {
                طابق الأهداف[ك][ر] مع
                | هدف_رمز_ويب_أسمبلي.دالة_ناتجة(الفهرس) -> {
