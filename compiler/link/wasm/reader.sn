استورد std.text.from_bytes;
عرف بايت_ويب_أسمبلي_عند(البايتات: &متجه ط8, الموضع: طبيعي): ط8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع واصف_قسم_ويب_أسمبلي = {
    المعرف: طبيعي,
    موضع_المحتوى: طبيعي,
    حجم_المحتوى: طبيعي,
    الاسم_المخصص: اختياري متجه ط8
};

عرف ضمن_حدود_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام نوع قراءة_ليب_ويب_أسمبلي = {
    القيمة: طبيعي,
    الموضع_التالي: طبيعي
};

عام نوع قراءة_اسم_ويب_أسمبلي = {
    الاسم: متجه ط8,
    الموضع_التالي: طبيعي
};

عام عرف اقرأ_ليب_طبيعي_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري قراءة_ليب_ويب_أسمبلي {
    دع القيمة: متغير طبيعي = 0;
    دع الإزاحة: متغير طبيعي = 0;
    دع الحالي: متغير طبيعي = الموضع;
    طالما (الحالي < (الطول(*البايتات) مثل طبيعي) && الإزاحة < 64) {
        دع البايت: طبيعي = (*البايتات)[الحالي] مثل طبيعي;
        القيمة := القيمة | ((البايت & 0x7F) << الإزاحة);
        الحالي := الحالي + 1;
        إذا ((البايت & 0x80) == 0) {
            دع النتيجة: قراءة_ليب_ويب_أسمبلي = {
                القيمة: القيمة,
                الموضع_التالي: الحالي
            };
            أرجع اختياري.موجود(النتيجة);
        };
        الإزاحة := الإزاحة + 7;
    }
    أرجع اختياري.لا_شيء();
}

// Signed LEB128 (sleb): the value read in two's complement, sign-extended
// from its last group.
عام نوع قراءة_سليب_ويب_أسمبلي = {
    القيمة: عدد,
    الموضع_التالي: طبيعي
};

عام عرف اقرأ_ليب_موقع_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): اختياري قراءة_سليب_ويب_أسمبلي {
    دع القيمة: متغير طبيعي = 0;
    دع الإزاحة: متغير طبيعي = 0;
    دع الحالي: متغير طبيعي = الموضع;
    طالما (الحالي < (الطول(*البايتات) مثل طبيعي) && الإزاحة < 64) {
        دع البايت: طبيعي = (*البايتات)[الحالي] مثل طبيعي;
        القيمة := القيمة | ((البايت & 0x7F) << الإزاحة);
        الحالي := الحالي + 1;
        الإزاحة := الإزاحة + 7;
        إذا ((البايت & 0x80) == 0) {
            إذا (الإزاحة < 64 && (البايت & 0x40) != 0) {
                دع الكل: طبيعي = ~((0 مثل طبيعي));
                القيمة := القيمة | (الكل << الإزاحة);
            };
            دع النتيجة: قراءة_سليب_ويب_أسمبلي = {
                القيمة: القيمة مثل عدد,
                الموضع_التالي: الحالي
            };
            أرجع اختياري.موجود(النتيجة);
        };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف انسخ_نطاق_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < الحجم) {
        ألحق(الناتج, بايت_ويب_أسمبلي_عند(البايتات, الموضع + الفهرس));
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عام عرف اقرأ_اسم_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري قراءة_اسم_ويب_أسمبلي {
    دع الطول_المقروء: قراءة_ليب_ويب_أسمبلي;
    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الطول_المقروء := القيمة; };
    إذا (الطول_المقروء.الموضع_التالي > النهاية
        || الطول_المقروء.القيمة
            > النهاية - الطول_المقروء.الموضع_التالي) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متجه ط8 = انسخ_نطاق_ويب_أسمبلي(
        البايتات,
        الطول_المقروء.الموضع_التالي,
        الطول_المقروء.القيمة
    );
    دع النتيجة: قراءة_اسم_ويب_أسمبلي = {
        الاسم: الاسم,
        الموضع_التالي: الطول_المقروء.الموضع_التالي
            + الطول_المقروء.القيمة
    };
    أرجع اختياري.موجود(النتيجة);
}

عام عرف وحدة_ويب_أسمبلي_صالحة(البايتات: &متجه ط8): منطقي {
    إذا (!ضمن_حدود_ويب_أسمبلي(البايتات, 0, 8)) { أرجع خطأ; };
    أرجع (*البايتات)[0] == 0
        && (*البايتات)[1] == 0x61
        && (*البايتات)[2] == 0x73
        && (*البايتات)[3] == 0x6D
        && (*البايتات)[4] == 1
        && (*البايتات)[5] == 0
        && (*البايتات)[6] == 0
        && (*البايتات)[7] == 0;
}

// Standard section identifiers are not in their binary encoding order.
// Tags follow memories, and the data-count section precedes code and data.
عرف ترتيب_قسم_ويب_أسمبلي(المعرف: طبيعي): طبيعي {
    إذا (المعرف == 1) { أرجع 1; };
    إذا (المعرف == 2) { أرجع 2; };
    إذا (المعرف == 3) { أرجع 3; };
    إذا (المعرف == 4) { أرجع 4; };
    إذا (المعرف == 5) { أرجع 5; };
    إذا (المعرف == 13) { أرجع 6; };
    إذا (المعرف == 6) { أرجع 7; };
    إذا (المعرف == 7) { أرجع 8; };
    إذا (المعرف == 8) { أرجع 9; };
    إذا (المعرف == 9) { أرجع 10; };
    إذا (المعرف == 12) { أرجع 11; };
    إذا (المعرف == 10) { أرجع 12; };
    إذا (المعرف == 11) { أرجع 13; };
    أرجع 0;
}

عام عرف أقسام_ويب_أسمبلي(
    البايتات: &متجه ط8
): اختياري متجه واصف_قسم_ويب_أسمبلي {
    إذا (!وحدة_ويب_أسمبلي_صالحة(البايتات)) {
        أرجع اختياري.لا_شيء();
    };
    دع الأقسام: متغير متجه واصف_قسم_ويب_أسمبلي = [];
    دع الموضع: متغير طبيعي = 8;
    دع السابق_القياسي: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*البايتات) مثل طبيعي)) {
        دع المعرف: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
        دع قراءة_الحجم: قراءة_ليب_ويب_أسمبلي;
        طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع + 1) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { قراءة_الحجم := القيمة; };
        دع بداية: طبيعي = قراءة_الحجم.الموضع_التالي;
        إذا (!ضمن_حدود_ويب_أسمبلي(البايتات, بداية, قراءة_الحجم.القيمة)) {
            أرجع اختياري.لا_شيء();
        };
        إذا (المعرف != 0) {
            دع الترتيب: طبيعي = ترتيب_قسم_ويب_أسمبلي(المعرف);
            إذا (الترتيب == 0 || الترتيب <= السابق_القياسي) {
                أرجع اختياري.لا_شيء();
            };
            السابق_القياسي := الترتيب;
        };
        دع الاسم: متغير اختياري متجه ط8 = اختياري.لا_شيء();
        إذا (المعرف == 0) {
            طابق اقرأ_اسم_ويب_أسمبلي(
                البايتات,
                بداية,
                بداية + قراءة_الحجم.القيمة
            ) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> {
                دع نسخة_الاسم: متجه ط8 = انسخ_نطاق_ويب_أسمبلي(
                    &القيمة.الاسم,
                    0,
                    الطول(القيمة.الاسم) مثل طبيعي
                );
                الاسم := اختياري.موجود(نسخة_الاسم);
            };
        };
        دع القسم: واصف_قسم_ويب_أسمبلي = {
            المعرف: المعرف,
            موضع_المحتوى: بداية,
            حجم_المحتوى: قراءة_الحجم.القيمة,
            الاسم_المخصص: الاسم
        };
        ألحق(الأقسام, القسم);
        الموضع := بداية + قراءة_الحجم.القيمة;
    }
    أرجع اختياري.موجود(الأقسام);
}

عرف اسم_ويب_أسمبلي_يساوي(
    الاسم: &متجه ط8,
    المتوقع: &متجه ط8
): منطقي {
    إذا (الطول(*الاسم) != الطول(*المتوقع)) { أرجع خطأ; };
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*الاسم) مثل طبيعي)) {
        إذا ((*الاسم)[الفهرس] != (*المتوقع)[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عام عرف وحدة_ويب_أسمبلي_قابلة_للربط(
    البايتات: &متجه ط8
): اختياري منطقي {
    دع الأقسام: متجه واصف_قسم_ويب_أسمبلي;
    طابق أقسام_ويب_أسمبلي(البايتات) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الأقسام := القيمة; };
    دع اسم_الربط: متجه ط8 = بايتات_من_نص(«linking»);
    دع بادئة_الإزاحة: متجه ط8 = بايتات_من_نص(«reloc.»);
    دع قابل: متغير منطقي = خطأ;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(الأقسام) مثل طبيعي)) {
        طابق الأقسام[الفهرس].الاسم_المخصص مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الاسم) -> {
            إذا (اسم_ويب_أسمبلي_يساوي(&الاسم, &اسم_الربط)) {
                قابل := صواب;
            };
            إذا ((الطول(الاسم) مثل طبيعي)
                    >= (الطول(بادئة_الإزاحة) مثل طبيعي)) {
                دع يطابق: متغير منطقي = صواب;
                دع فهرس_البادئة: متغير طبيعي = 0;
                طالما (
                    فهرس_البادئة
                        < (الطول(بادئة_الإزاحة) مثل طبيعي)
                ) {
                    إذا (الاسم[فهرس_البادئة] != بادئة_الإزاحة[فهرس_البادئة]) {
                        يطابق := خطأ;
                    };
                    فهرس_البادئة := فهرس_البادئة + 1;
                }
                إذا (يطابق) { قابل := صواب; };
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.موجود(قابل);
}
