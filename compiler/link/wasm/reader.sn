عرف بايت_ويب_أسمبلي_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام نوع واصف_قسم_ويب_أسمبلي = {
    المعرف: غير_موقع,
    موضع_المحتوى: غير_موقع,
    حجم_المحتوى: غير_موقع,
    الاسم_المخصص: اختيار متجه غ8
};

عرف ضمن_حدود_ويب_أسمبلي(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > العدد) { أرجع خطأ; };
    أرجع الحجم <= العدد - الموضع;
}

عام نوع قراءة_ليب_ويب_أسمبلي = {
    القيمة: غير_موقع,
    الموضع_التالي: غير_موقع
};

عام نوع قراءة_اسم_ويب_أسمبلي = {
    الاسم: متجه غ8,
    الموضع_التالي: غير_موقع
};

عام عرف اقرأ_ليب_غير_موقع_ويب_أسمبلي(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): اختيار قراءة_ليب_ويب_أسمبلي {
    دع القيمة: متغير غير_موقع = 0;
    دع الإزاحة: متغير غير_موقع = 0;
    دع الحالي: متغير غير_موقع = الموضع;
    بينما (الحالي < (الطول(*البايتات) مثل غير_موقع) && الإزاحة < 64) {
        دع البايت: غير_موقع = (*البايتات)[الحالي] مثل غير_موقع;
        القيمة := القيمة | ((البايت & 0x7F) << الإزاحة);
        الحالي := الحالي + 1;
        لو ((البايت & 0x80) == 0) {
            دع النتيجة: قراءة_ليب_ويب_أسمبلي = {
                القيمة: القيمة,
                الموضع_التالي: الحالي
            };
            أرجع اختيار.بعض(النتيجة);
        };
        الإزاحة := الإزاحة + 7;
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_نطاق_ويب_أسمبلي(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحجم) {
        ألحق(الناتج, بايت_ويب_أسمبلي_عند(البايتات, الموضع + الفهرس));
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف اقرأ_اسم_ويب_أسمبلي(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار قراءة_اسم_ويب_أسمبلي {
    دع الطول_المقروء: قراءة_ليب_ويب_أسمبلي;
    طابق اقرأ_ليب_غير_موقع_ويب_أسمبلي(البايتات, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الطول_المقروء := القيمة; };
    لو (الطول_المقروء.الموضع_التالي > النهاية
        || الطول_المقروء.القيمة
            > النهاية - الطول_المقروء.الموضع_التالي) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متجه غ8 = انسخ_نطاق_ويب_أسمبلي(
        البايتات,
        الطول_المقروء.الموضع_التالي,
        الطول_المقروء.القيمة
    );
    دع النتيجة: قراءة_اسم_ويب_أسمبلي = {
        الاسم: الاسم,
        الموضع_التالي: الطول_المقروء.الموضع_التالي
            + الطول_المقروء.القيمة
    };
    أرجع اختيار.بعض(النتيجة);
}

عام عرف وحدة_ويب_أسمبلي_صالحة(البايتات: &متجه غ8): منطقي {
    لو (!ضمن_حدود_ويب_أسمبلي(البايتات, 0, 8)) { أرجع خطأ; };
    أرجع (*البايتات)[0] == 0
        && (*البايتات)[1] == 0x61
        && (*البايتات)[2] == 0x73
        && (*البايتات)[3] == 0x6D
        && (*البايتات)[4] == 1
        && (*البايتات)[5] == 0
        && (*البايتات)[6] == 0
        && (*البايتات)[7] == 0;
}

عام عرف أقسام_ويب_أسمبلي(
    البايتات: &متجه غ8
): اختيار متجه واصف_قسم_ويب_أسمبلي {
    لو (!وحدة_ويب_أسمبلي_صالحة(البايتات)) {
        أرجع اختيار.لا_شيء();
    };
    دع الأقسام: متغير متجه واصف_قسم_ويب_أسمبلي = [];
    دع الموضع: متغير غير_موقع = 8;
    دع السابق_القياسي: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(*البايتات) مثل غير_موقع)) {
        دع المعرف: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
        دع قراءة_الحجم: قراءة_ليب_ويب_أسمبلي;
        طابق اقرأ_ليب_غير_موقع_ويب_أسمبلي(البايتات, الموضع + 1) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { قراءة_الحجم := القيمة; };
        دع بداية: غير_موقع = قراءة_الحجم.الموضع_التالي;
        لو (!ضمن_حدود_ويب_أسمبلي(البايتات, بداية, قراءة_الحجم.القيمة)) {
            أرجع اختيار.لا_شيء();
        };
        لو (المعرف != 0) {
            لو (المعرف < السابق_القياسي) { أرجع اختيار.لا_شيء(); };
            السابق_القياسي := المعرف;
        };
        دع الاسم: متغير اختيار متجه غ8 = اختيار.لا_شيء();
        لو (المعرف == 0) {
            طابق اقرأ_اسم_ويب_أسمبلي(
                البايتات,
                بداية,
                بداية + قراءة_الحجم.القيمة
            ) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> {
                دع نسخة_الاسم: متجه غ8 = انسخ_نطاق_ويب_أسمبلي(
                    &القيمة.الاسم,
                    0,
                    الطول(القيمة.الاسم) مثل غير_موقع
                );
                الاسم := اختيار.بعض(نسخة_الاسم);
            };
        };
        دع القسم: واصف_قسم_ويب_أسمبلي = {
            المعرف: المعرف,
            موضع_المحتوى: بداية,
            حجم_المحتوى: قراءة_الحجم.القيمة,
            الاسم_المخصص: الاسم
        };
        ألحق(الأقسام, القسم);
        الموضع := بداية + قراءة_الحجم.القيمة;
    }
    أرجع اختيار.بعض(الأقسام);
}

عرف اسم_ويب_أسمبلي_يساوي(
    الاسم: &متجه غ8,
    المتوقع: &متجه غ8
): منطقي {
    لو (الطول(*الاسم) != الطول(*المتوقع)) { أرجع خطأ; };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الاسم) مثل غير_موقع)) {
        لو ((*الاسم)[الفهرس] != (*المتوقع)[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

عام عرف وحدة_ويب_أسمبلي_قابلة_للربط(
    البايتات: &متجه غ8
): اختيار منطقي {
    دع الأقسام: متجه واصف_قسم_ويب_أسمبلي;
    طابق أقسام_ويب_أسمبلي(البايتات) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الأقسام := القيمة; };
    دع اسم_الربط: متجه غ8 = [0x6C, 0x69, 0x6E, 0x6B, 0x69, 0x6E, 0x67];
    دع بادئة_الإزاحة: متجه غ8 = [0x72, 0x65, 0x6C, 0x6F, 0x63, 0x2E];
    دع قابل: متغير منطقي = خطأ;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(الأقسام) مثل غير_موقع)) {
        طابق الأقسام[الفهرس].الاسم_المخصص مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الاسم) -> {
            لو (اسم_ويب_أسمبلي_يساوي(&الاسم, &اسم_الربط)) {
                قابل := صواب;
            };
            لو ((الطول(الاسم) مثل غير_موقع)
                    >= (الطول(بادئة_الإزاحة) مثل غير_موقع)) {
                دع يطابق: متغير منطقي = صواب;
                دع فهرس_البادئة: متغير غير_موقع = 0;
                بينما (
                    فهرس_البادئة
                        < (الطول(بادئة_الإزاحة) مثل غير_موقع)
                ) {
                    لو (الاسم[فهرس_البادئة] != بادئة_الإزاحة[فهرس_البادئة]) {
                        يطابق := خطأ;
                    };
                    فهرس_البادئة := فهرس_البادئة + 1;
                }
                لو (يطابق) { قابل := صواب; };
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع اختيار.بعض(قابل);
}
