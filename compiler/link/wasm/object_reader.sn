استورد compiler.link.wasm.reader;
استورد std.text.from_bytes;
استورد std.bytes.compare;

// Reader of WebAssembly relocatable objects: the format of the WebAssembly
// tool conventions (Linking.md) that both SultanC backends write (the native
// wasm32 object writer, backend/object/wasm/wasm_object.sn, and LLVM). It
// decodes the parts the linker needs (link/wasm/linker.sn) and the symbol
// registration (link/wasm/object_ingest.sn) reads:
//
//   * the type, import, function, global, export, code and data sections;
//   * the custom `linking` section: symbol table, segment info, init
//     functions and COMDAT groups;
//   * every `reloc.*` section, with offsets relative to the target section's
//     contents (for a custom section: after its name), as wasm-ld reads them;
//   * the other custom sections (DWARF `.debug_*` and any other), which the
//     linker concatenates by name.
//
// Element and data-count sections of an object are provisional (LLVM writes
// them so the object is a valid module) and are not kept: the linker builds
// the function table from TABLE_INDEX relocations. `producers` and `name`
// describe the object only and are not kept either. `target_features` is
// kept as the list of used/required feature names (`الميزات`), which a
// relocatable link (`-r`) writes back as the output's own section.
// A malformed object, or one using a part of the format the linker does not
// implement (defined tables, memories or tags, a start function, multi-byte
// value types), is reported instead of being guessed.

// Import kinds, symbol kinds and symbol flags (Linking.md).
عام عرف صنف_استيراد_دالة_ويب_أسمبلي(): طبيعي { أرجع 0; }
عام عرف صنف_استيراد_جدول_ويب_أسمبلي(): طبيعي { أرجع 1; }
عام عرف صنف_استيراد_ذاكرة_ويب_أسمبلي(): طبيعي { أرجع 2; }
عام عرف صنف_استيراد_عام_ويب_أسمبلي(): طبيعي { أرجع 3; }
عام عرف صنف_استيراد_وسم_ويب_أسمبلي(): طبيعي { أرجع 4; }

عام عرف صنف_رمز_دالة_ويب_أسمبلي(): طبيعي { أرجع 0; }
عام عرف صنف_رمز_بيانات_ويب_أسمبلي(): طبيعي { أرجع 1; }
عام عرف صنف_رمز_عام_ويب_أسمبلي(): طبيعي { أرجع 2; }
عام عرف صنف_رمز_قسم_ويب_أسمبلي(): طبيعي { أرجع 3; }
عام عرف صنف_رمز_وسم_ويب_أسمبلي(): طبيعي { أرجع 4; }
عام عرف صنف_رمز_جدول_ويب_أسمبلي(): طبيعي { أرجع 5; }

عام عرف علم_رمز_ضعيف_ويب_أسمبلي(): طبيعي { أرجع 0x1; }
عام عرف علم_رمز_محلي_ويب_أسمبلي(): طبيعي { أرجع 0x2; }
عام عرف علم_رمز_مخفي_ويب_أسمبلي(): طبيعي { أرجع 0x4; }
عام عرف علم_رمز_غير_معرف_ويب_أسمبلي(): طبيعي { أرجع 0x10; }
عام عرف علم_رمز_مصدر_ويب_أسمبلي(): طبيعي { أرجع 0x20; }
عام عرف علم_رمز_اسم_صريح_ويب_أسمبلي(): طبيعي { أرجع 0x40; }
عام عرف علم_رمز_خيطي_ويب_أسمبلي(): طبيعي { أرجع 0x100; }
عام عرف علم_رمز_مطلق_ويب_أسمبلي(): طبيعي { أرجع 0x200; }

عام نوع استيراد_كائن_ويب_أسمبلي = {
    الوحدة: متجه ط8,
    الحقل: متجه ط8,
    الصنف: طبيعي,
    // Function: its type index. Global: its value type. Table: its
    // reference type. Memory and tag: 0.
    الوصف: طبيعي,
    قابل_للتغيير: منطقي
};

عام نوع عام_كائن_ويب_أسمبلي = {
    نوع_القيمة: طبيعي,
    قابل_للتغيير: منطقي,
    // The constant initializer expression, with its final `end`.
    التهيئة: متجه ط8
};

// One code-section entry; offsets are relative to the CODE section contents.
عام نوع جسم_كائن_ويب_أسمبلي = {
    البداية: طبيعي,
    بداية_الجسم: طبيعي,
    النهاية: طبيعي
};

// One data segment; بداية_البايتات is relative to the DATA section contents.
عام نوع قطعة_كائن_ويب_أسمبلي = {
    أعلام_الرأس: طبيعي,
    بداية_البايتات: طبيعي,
    الحجم: طبيعي,
    الاسم: متجه ط8,
    محاذاة_لوغ: طبيعي,
    أعلام_الربط: طبيعي
};

عام نوع رمز_كائن_ويب_أسمبلي = {
    الصنف: طبيعي,
    الأعلام: طبيعي,
    الاسم: متجه ط8,
    // Function, global, table or tag index; data segment; section index.
    الفهرس: طبيعي,
    الإزاحة: طبيعي,
    الحجم: طبيعي
};

عام نوع إزاحة_كائن_ويب_أسمبلي = {
    النوع: طبيعي,
    الموضع: طبيعي,
    الفهرس: طبيعي,
    الإضافة: عدد
};

عام نوع إزاحات_قسم_كائن_ويب_أسمبلي = {
    القسم: طبيعي,
    الإزاحات: متجه إزاحة_كائن_ويب_أسمبلي
};

// A custom section kept for the output; البداية is the file offset of its
// contents (after the name).
عام نوع قسم_مخصص_كائن_ويب_أسمبلي = {
    الفهرس: طبيعي,
    الاسم: متجه ط8,
    البداية: طبيعي,
    الحجم: طبيعي
};

عام نوع عنصر_كومدات_كائن_ويب_أسمبلي = {
    الصنف: طبيعي,
    الفهرس: طبيعي
};

عام نوع كومدات_كائن_ويب_أسمبلي = {
    الاسم: متجه ط8,
    العناصر: متجه عنصر_كومدات_كائن_ويب_أسمبلي
};

عام نوع دالة_بدء_كائن_ويب_أسمبلي = {
    الأولوية: طبيعي,
    الرمز: طبيعي
};

عام نوع تصدير_كائن_ويب_أسمبلي = {
    الاسم: متجه ط8,
    الصنف: طبيعي,
    الفهرس: طبيعي
};

عام نوع كائن_ويب_أسمبلي = {
    // Each function type entry's encoding (from its 0x60 form byte).
    الأنواع: متجه متجه ط8,
    الاستيرادات: متجه استيراد_كائن_ويب_أسمبلي,
    // Index of every imported function, global and table in its own space.
    استيرادات_الدوال: متجه طبيعي,
    استيرادات_العوام: متجه طبيعي,
    استيرادات_الجداول: متجه طبيعي,
    أنواع_الدوال: متجه طبيعي,
    العوام: متجه عام_كائن_ويب_أسمبلي,
    التصديرات: متجه تصدير_كائن_ويب_أسمبلي,
    فهرس_قسم_الشفرة: طبيعي,
    بداية_الشفرة: طبيعي,
    حجم_الشفرة: طبيعي,
    الأجسام: متجه جسم_كائن_ويب_أسمبلي,
    فهرس_قسم_البيانات: طبيعي,
    بداية_البيانات: طبيعي,
    حجم_البيانات: طبيعي,
    القطع: متجه قطعة_كائن_ويب_أسمبلي,
    الرموز: متجه رمز_كائن_ويب_أسمبلي,
    الإزاحات: متجه إزاحات_قسم_كائن_ويب_أسمبلي,
    المخصصة: متجه قسم_مخصص_كائن_ويب_أسمبلي,
    الكومدات: متجه كومدات_كائن_ويب_أسمبلي,
    دوال_البدء: متجه دالة_بدء_كائن_ويب_أسمبلي,
    // Features the object uses or requires (`target_features` entries with
    // the `+` or `=` prefix), for a relocatable output's own section.
    الميزات: متجه متجه ط8,
    له_ربط: منطقي
};

عام نوع خطأ_قراءة_كائن_ويب_أسمبلي =
    | وحدة_غير_صالحة
    // A valid module using a part of the format the linker does not link.
    | ميزة_غير_مدعومة
;

// --------------------------------------------------------------- cursor --

نوع مؤشر_قراءة_ويب_أسمبلي = {
    الموضع: طبيعي,
    النهاية: طبيعي,
    فشل: منطقي
};

عرف مؤشر_ويب_أسمبلي(البداية: طبيعي, النهاية: طبيعي): مؤشر_قراءة_ويب_أسمبلي {
    دع المؤشر: مؤشر_قراءة_ويب_أسمبلي = {
        الموضع: البداية,
        النهاية: النهاية,
        فشل: خطأ
    };
    أرجع المؤشر;
}

عرف بايت_بمؤشر_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): طبيعي {
    إذا ((*المؤشر).فشل || (*المؤشر).الموضع >= (*المؤشر).النهاية) {
        (*المؤشر).فشل := صواب;
        أرجع 0;
    };
    دع القيمة: طبيعي = (*البايتات)[(*المؤشر).الموضع] مثل طبيعي;
    (*المؤشر).الموضع := (*المؤشر).الموضع + 1;
    أرجع القيمة;
}

عرف ليب_بمؤشر_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): طبيعي {
    إذا ((*المؤشر).فشل) { أرجع 0; };
    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, (*المؤشر).الموضع) مع
    | اختياري.لا_شيء -> {
        (*المؤشر).فشل := صواب;
        أرجع 0;
    }
    | اختياري.موجود(القراءة) -> {
        إذا (القراءة.الموضع_التالي > (*المؤشر).النهاية) {
            (*المؤشر).فشل := صواب;
            أرجع 0;
        };
        (*المؤشر).الموضع := القراءة.الموضع_التالي;
        أرجع القراءة.القيمة;
    };
}

عرف سليب_بمؤشر_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): عدد {
    إذا ((*المؤشر).فشل) { أرجع 0; };
    طابق اقرأ_ليب_موقع_ويب_أسمبلي(البايتات, (*المؤشر).الموضع) مع
    | اختياري.لا_شيء -> {
        (*المؤشر).فشل := صواب;
        أرجع 0;
    }
    | اختياري.موجود(القراءة) -> {
        إذا (القراءة.الموضع_التالي > (*المؤشر).النهاية) {
            (*المؤشر).فشل := صواب;
            أرجع 0;
        };
        (*المؤشر).الموضع := القراءة.الموضع_التالي;
        أرجع القراءة.القيمة;
    };
}

عرف تخط_بمؤشر_ويب_أسمبلي(
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الحجم: طبيعي
): فراغ {
    إذا ((*المؤشر).فشل) { أرجع; };
    إذا ((*المؤشر).الموضع > (*المؤشر).النهاية
        || الحجم > (*المؤشر).النهاية - (*المؤشر).الموضع) {
        (*المؤشر).فشل := صواب;
        أرجع;
    };
    (*المؤشر).الموضع := (*المؤشر).الموضع + الحجم;
}

عرف اسم_بمؤشر_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): متجه ط8 {
    دع الطول_المقروء: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع البداية: طبيعي = (*المؤشر).الموضع;
    تخط_بمؤشر_ويب_أسمبلي(المؤشر, الطول_المقروء);
    إذا ((*المؤشر).فشل) {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
    أرجع انسخ_نطاق_ويب_أسمبلي(البايتات, البداية, الطول_المقروء);
}

// One-byte value types: i32, i64, f32, f64, v128, funcref, externref.
عرف نوع_قيمة_بسيط_ويب_أسمبلي(القيمة: طبيعي): منطقي {
    أرجع القيمة == 0x7F || القيمة == 0x7E || القيمة == 0x7D || القيمة == 0x7C
        || القيمة == 0x7B || القيمة == 0x70 || القيمة == 0x6F;
}

// Table or memory limits: flags, minimum, maximum when flags bit 0 is set.
عرف تخط_حدود_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): طبيعي {
    دع الأعلام: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع الأدنى: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    إذا ((الأعلام & 1) != 0) {
        دع الأقصى: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    };
    أرجع الأعلام;
}

// A constant expression up to and including its `end` (0x0B): the
// instructions a constant expression may hold in the MVP and with the
// reference-types and extended-const proposals.
عرف تعبير_ثابت_بمؤشر_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي
): متجه ط8 {
    دع البداية: طبيعي = (*المؤشر).الموضع;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر && !(*المؤشر).فشل) {
        دع الرمز: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        إذا (الرمز == 0x0B) {
            مستمر := خطأ;
        } وإلا إذا (الرمز == 0x41 || الرمز == 0x42) {
            دع القيمة: عدد = سليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الرمز == 0x43) {
            تخط_بمؤشر_ويب_أسمبلي(المؤشر, 4);
        } وإلا إذا (الرمز == 0x44) {
            تخط_بمؤشر_ويب_أسمبلي(المؤشر, 8);
        } وإلا إذا (الرمز == 0x23 || الرمز == 0xD2) {
            دع الفهرس: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الرمز == 0xD0) {
            دع النوع: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الرمز == 0x6A || الرمز == 0x6B || الرمز == 0x6C
            || الرمز == 0x7C || الرمز == 0x7D || الرمز == 0x7E) {
            // extended-const add, sub and mul
        } وإلا {
            (*المؤشر).فشل := صواب;
        };
    }
    إذا ((*المؤشر).فشل) {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
    أرجع انسخ_نطاق_ويب_أسمبلي(البايتات, البداية, (*المؤشر).الموضع - البداية);
}

// Relocation types whose entry carries an addend (Linking.md).
عام عرف إزاحة_ويب_أسمبلي_لها_إضافة(النوع: طبيعي): منطقي {
    أرجع النوع == 3 || النوع == 4 || النوع == 5 || النوع == 8 || النوع == 9
        || النوع == 11 || النوع == 14 || النوع == 15 || النوع == 16
        || النوع == 17 || النوع == 21 || النوع == 22 || النوع == 23
        || النوع == 25;
}

عرف بادئة_اسم_ويب_أسمبلي(الاسم: &متجه ط8, البادئة: نص): منطقي {
    دع طول_البادئة: طبيعي = الطول(البادئة) مثل طبيعي;
    إذا ((الطول(*الاسم) مثل طبيعي) < طول_البادئة) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < طول_البادئة) {
        إذا ((*الاسم)[ف] != البادئة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_ويب_أسمبلي_يطابق_نصا(الاسم: &متجه ط8, النص: نص): منطقي {
    دع البايتات: متجه ط8 = بايتات_من_نص(النص);
    أرجع متجها_بايتات_متساويان(الاسم, &البايتات);
}

// ------------------------------------------------------------- sections --

عرف اقرأ_الأنواع_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع البداية: طبيعي = (*المؤشر).الموضع;
        دع الشكل: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        إذا (الشكل != 0x60) {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
        };
        دع الجولة: متغير طبيعي = 0;
        طالما (الجولة < 2) {
            دع عدد_القيم: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            دع م: متغير طبيعي = 0;
            طالما (م < عدد_القيم && !(*المؤشر).فشل) {
                إذا (!نوع_قيمة_بسيط_ويب_أسمبلي(بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر))) {
                    أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
                };
                م := م + 1;
            }
            الجولة := الجولة + 1;
        }
        إذا (!(*المؤشر).فشل) {
            دع النوع: متجه ط8 = انسخ_نطاق_ويب_أسمبلي(
                البايتات, البداية, (*المؤشر).الموضع - البداية
            );
            ألحق((*الكائن).الأنواع, النوع);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_الاستيرادات_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع الوحدة: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الحقل: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الصنف: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الوصف: متغير طبيعي = 0;
        دع قابل: متغير منطقي = خطأ;
        دع موضع_الاستيراد: طبيعي = الطول((*الكائن).الاستيرادات) مثل طبيعي;
        إذا (الصنف == 0) {
            الوصف := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            ألحق((*الكائن).استيرادات_الدوال, موضع_الاستيراد);
        } وإلا إذا (الصنف == 1) {
            الوصف := بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            دع أعلام_الجدول: طبيعي = تخط_حدود_ويب_أسمبلي(البايتات, المؤشر);
            ألحق((*الكائن).استيرادات_الجداول, موضع_الاستيراد);
        } وإلا إذا (الصنف == 2) {
            دع أعلام_الذاكرة: طبيعي = تخط_حدود_ويب_أسمبلي(البايتات, المؤشر);
            // Shared or 64-bit memories are not linked.
            إذا ((أعلام_الذاكرة & 0x6) != 0) {
                أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
            };
        } وإلا إذا (الصنف == 3) {
            الوصف := بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            قابل := بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر) == 1;
            ألحق((*الكائن).استيرادات_العوام, موضع_الاستيراد);
        } وإلا {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
        };
        دع الاستيراد: استيراد_كائن_ويب_أسمبلي = {
            الوحدة: الوحدة,
            الحقل: الحقل,
            الصنف: الصنف,
            الوصف: الوصف,
            قابل_للتغيير: قابل
        };
        ألحق((*الكائن).الاستيرادات, الاستيراد);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_العوام_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع النوع: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        إذا (!نوع_قيمة_بسيط_ويب_أسمبلي(النوع)) {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
        };
        دع قابل: منطقي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر) == 1;
        دع التهيئة: متجه ط8 = تعبير_ثابت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع العام: عام_كائن_ويب_أسمبلي = {
            نوع_القيمة: النوع,
            قابل_للتغيير: قابل,
            التهيئة: التهيئة
        };
        ألحق((*الكائن).العوام, العام);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_التصديرات_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): فراغ {
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع الاسم: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الصنف: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الفهرس: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع التصدير: تصدير_كائن_ويب_أسمبلي = {
            الاسم: الاسم,
            الصنف: الصنف,
            الفهرس: الفهرس
        };
        ألحق((*الكائن).التصديرات, التصدير);
        ف := ف + 1;
    }
}

عرف اقرأ_الشفرة_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): فراغ {
    دع الأساس: طبيعي = (*المؤشر).الموضع;
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع البداية: طبيعي = (*المؤشر).الموضع - الأساس;
        دع الحجم: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع بداية_الجسم: طبيعي = (*المؤشر).الموضع - الأساس;
        تخط_بمؤشر_ويب_أسمبلي(المؤشر, الحجم);
        دع الجسم: جسم_كائن_ويب_أسمبلي = {
            البداية: البداية,
            بداية_الجسم: بداية_الجسم,
            النهاية: (*المؤشر).الموضع - الأساس
        };
        ألحق((*الكائن).الأجسام, الجسم);
        ف := ف + 1;
    }
}

عرف اقرأ_البيانات_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع الأساس: طبيعي = (*المؤشر).الموضع;
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع الأعلام: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        إذا (الأعلام == 0) {
            دع التعبير: متجه ط8 = تعبير_ثابت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الأعلام == 2) {
            دع الذاكرة: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            دع التعبير: متجه ط8 = تعبير_ثابت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الأعلام != 1) {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        دع الحجم: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع البداية: طبيعي = (*المؤشر).الموضع - الأساس;
        تخط_بمؤشر_ويب_أسمبلي(المؤشر, الحجم);
        دع بلا_اسم: متجه ط8 = [];
        دع القطعة: قطعة_كائن_ويب_أسمبلي = {
            أعلام_الرأس: الأعلام,
            بداية_البايتات: البداية,
            الحجم: الحجم,
            الاسم: بلا_اسم,
            محاذاة_لوغ: 0,
            أعلام_الربط: 0
        };
        ألحق((*الكائن).القطع, القطعة);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The name of the imported function, global or table at index الفهرس of its
// own index space: undefined symbols without an explicit name are named by
// their import field (Linking.md).
عرف موضع_استيراد_في_فهارس_ويب_أسمبلي(
    الفهارس: &متجه طبيعي,
    الفهرس: طبيعي
): اختياري طبيعي {
    إذا (الفهرس >= (الطول(*الفهارس) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود((*الفهارس)[الفهرس]);
}

عرف حقل_استيراد_للرمز_ويب_أسمبلي(
    الكائن: &متغير كائن_ويب_أسمبلي,
    الصنف: طبيعي,
    الفهرس: طبيعي
): اختياري متجه ط8 {
    دع الموضع: متغير اختياري طبيعي = اختياري.لا_شيء();
    إذا (الصنف == صنف_رمز_دالة_ويب_أسمبلي()) {
        الموضع := موضع_استيراد_في_فهارس_ويب_أسمبلي(&(*الكائن).استيرادات_الدوال, الفهرس);
    } وإلا إذا (الصنف == صنف_رمز_عام_ويب_أسمبلي()) {
        الموضع := موضع_استيراد_في_فهارس_ويب_أسمبلي(&(*الكائن).استيرادات_العوام, الفهرس);
    } وإلا إذا (الصنف == صنف_رمز_جدول_ويب_أسمبلي()) {
        الموضع := موضع_استيراد_في_فهارس_ويب_أسمبلي(&(*الكائن).استيرادات_الجداول, الفهرس);
    };
    طابق الموضع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(موضع_الاستيراد) -> {
        دع مرجع_الحقل: &متجه ط8 = &(*الكائن).الاستيرادات[موضع_الاستيراد].الحقل;
        دع الحقل: متجه ط8 = انسخ_بايتات(مرجع_الحقل);
        أرجع اختياري.موجود(الحقل);
    };
}

عرف اقرأ_جدول_الرموز_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع الصنف: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الأعلام: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع غير_معرف_الرمز: منطقي = (الأعلام & علم_رمز_غير_معرف_ويب_أسمبلي()) != 0;
        دع الاسم: متغير متجه ط8 = [];
        دع الفهرس: متغير طبيعي = 0;
        دع الإزاحة: متغير طبيعي = 0;
        دع الحجم: متغير طبيعي = 0;
        إذا (الصنف == صنف_رمز_بيانات_ويب_أسمبلي()) {
            الاسم := اسم_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            إذا (!غير_معرف_الرمز) {
                الفهرس := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
                الإزاحة := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
                الحجم := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            };
        } وإلا إذا (الصنف == صنف_رمز_قسم_ويب_أسمبلي()) {
            الفهرس := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        } وإلا إذا (الصنف == صنف_رمز_دالة_ويب_أسمبلي()
            || الصنف == صنف_رمز_عام_ويب_أسمبلي()
            || الصنف == صنف_رمز_جدول_ويب_أسمبلي()
            || الصنف == صنف_رمز_وسم_ويب_أسمبلي()) {
            الفهرس := ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            إذا (!غير_معرف_الرمز
                || (الأعلام & علم_رمز_اسم_صريح_ويب_أسمبلي()) != 0) {
                الاسم := اسم_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
            } وإلا {
                طابق حقل_استيراد_للرمز_ويب_أسمبلي(الكائن, الصنف, الفهرس) مع
                | اختياري.لا_شيء -> {
                    أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
                }
                | اختياري.موجود(الحقل) -> { الاسم := الحقل; };
            };
        } وإلا {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        دع الرمز: رمز_كائن_ويب_أسمبلي = {
            الصنف: الصنف,
            الأعلام: الأعلام,
            الاسم: الاسم,
            الفهرس: الفهرس,
            الإزاحة: الإزاحة,
            الحجم: الحجم
        };
        ألحق((*الكائن).الرموز, الرمز);
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_الربط_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): اختياري خطأ_قراءة_كائن_ويب_أسمبلي {
    دع الإصدار: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    إذا (الإصدار != 2) {
        أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
    };
    طالما ((*المؤشر).الموضع < (*المؤشر).النهاية && !(*المؤشر).فشل) {
        دع النوع: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الحجم: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        إذا ((*المؤشر).فشل
            || الحجم > (*المؤشر).النهاية - (*المؤشر).الموضع) {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        دع الفرعي: متغير مؤشر_قراءة_ويب_أسمبلي = مؤشر_ويب_أسمبلي(
            (*المؤشر).الموضع, (*المؤشر).الموضع + الحجم
        );
        إذا (النوع == 5) {
            دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
            إذا (العدد != (الطول((*الكائن).القطع) مثل طبيعي)) {
                أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
            };
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد && !الفرعي.فشل) {
                دع الاسم: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع المحاذاة: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع الأعلام: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                (*الكائن).القطع[ف].الاسم := الاسم;
                (*الكائن).القطع[ف].محاذاة_لوغ := المحاذاة;
                (*الكائن).القطع[ف].أعلام_الربط := الأعلام;
                ف := ف + 1;
            }
        } وإلا إذا (النوع == 6) {
            دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد && !الفرعي.فشل) {
                دع الأولوية: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع الرمز: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع البدء: دالة_بدء_كائن_ويب_أسمبلي = {
                    الأولوية: الأولوية,
                    الرمز: الرمز
                };
                ألحق((*الكائن).دوال_البدء, البدء);
                ف := ف + 1;
            }
        } وإلا إذا (النوع == 7) {
            دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
            دع ف: متغير طبيعي = 0;
            طالما (ف < العدد && !الفرعي.فشل) {
                دع الاسم: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع الأعلام: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع عدد_العناصر: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                دع العناصر: متغير متجه عنصر_كومدات_كائن_ويب_أسمبلي = [];
                دع م: متغير طبيعي = 0;
                طالما (م < عدد_العناصر && !الفرعي.فشل) {
                    دع صنف_العنصر: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                    دع فهرس_العنصر: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير الفرعي);
                    دع العنصر: عنصر_كومدات_كائن_ويب_أسمبلي = {
                        الصنف: صنف_العنصر,
                        الفهرس: فهرس_العنصر
                    };
                    ألحق(العناصر, العنصر);
                    م := م + 1;
                }
                دع الكومدات: كومدات_كائن_ويب_أسمبلي = {
                    الاسم: الاسم,
                    العناصر: العناصر
                };
                ألحق((*الكائن).الكومدات, الكومدات);
                ف := ف + 1;
            }
        } وإلا إذا (النوع == 8) {
            طابق اقرأ_جدول_الرموز_ويب_أسمبلي(البايتات, &متغير الفرعي, الكائن) مع
            | اختياري.موجود(الخطأ) -> { أرجع اختياري.موجود(الخطأ); }
            | اختياري.لا_شيء -> { };
        };
        إذا (الفرعي.فشل) {
            أرجع اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        تخط_بمؤشر_ويب_أسمبلي(المؤشر, الحجم);
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_إزاحات_ويب_أسمبلي(
    البايتات: &متجه ط8,
    المؤشر: &متغير مؤشر_قراءة_ويب_أسمبلي,
    الكائن: &متغير كائن_ويب_أسمبلي
): فراغ {
    دع القسم: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
    دع الإزاحات: متغير متجه إزاحة_كائن_ويب_أسمبلي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && !(*المؤشر).فشل) {
        دع النوع: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الموضع: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الفهرس: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        دع الإضافة: متغير عدد = 0;
        إذا (إزاحة_ويب_أسمبلي_لها_إضافة(النوع)) {
            الإضافة := سليب_بمؤشر_ويب_أسمبلي(البايتات, المؤشر);
        };
        دع الإزاحة: إزاحة_كائن_ويب_أسمبلي = {
            النوع: النوع,
            الموضع: الموضع,
            الفهرس: الفهرس,
            الإضافة: الإضافة
        };
        ألحق(الإزاحات, الإزاحة);
        ف := ف + 1;
    }
    دع المجموعة: إزاحات_قسم_كائن_ويب_أسمبلي = {
        القسم: القسم,
        الإزاحات: الإزاحات
    };
    ألحق((*الكائن).الإزاحات, المجموعة);
}

// Decodes one relocatable object. A module without a `linking` section is
// returned with له_ربط false: it is a final module, never merged.
عام عرف اقرأ_كائن_ويب_أسمبلي(
    البايتات: &متجه ط8
): نتيجة كائن_ويب_أسمبلي, خطأ_قراءة_كائن_ويب_أسمبلي {
    دع الأقسام: متجه واصف_قسم_ويب_أسمبلي;
    طابق أقسام_ويب_أسمبلي(البايتات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
    }
    | اختياري.موجود(القيمة) -> { الأقسام := القيمة; };
    دع الأنواع: متجه متجه ط8 = [];
    دع الاستيرادات: متجه استيراد_كائن_ويب_أسمبلي = [];
    دع فهارس_فارغة_1: متجه طبيعي = [];
    دع فهارس_فارغة_2: متجه طبيعي = [];
    دع فهارس_فارغة_3: متجه طبيعي = [];
    دع فهارس_فارغة_4: متجه طبيعي = [];
    دع العوام: متجه عام_كائن_ويب_أسمبلي = [];
    دع التصديرات: متجه تصدير_كائن_ويب_أسمبلي = [];
    دع الأجسام: متجه جسم_كائن_ويب_أسمبلي = [];
    دع القطع: متجه قطعة_كائن_ويب_أسمبلي = [];
    دع الرموز: متجه رمز_كائن_ويب_أسمبلي = [];
    دع الإزاحات: متجه إزاحات_قسم_كائن_ويب_أسمبلي = [];
    دع المخصصة: متجه قسم_مخصص_كائن_ويب_أسمبلي = [];
    دع الكومدات: متجه كومدات_كائن_ويب_أسمبلي = [];
    دع دوال_البدء: متجه دالة_بدء_كائن_ويب_أسمبلي = [];
    دع الميزات: متجه متجه ط8 = [];
    دع الكائن: متغير كائن_ويب_أسمبلي = {
        الأنواع: الأنواع,
        الاستيرادات: الاستيرادات,
        استيرادات_الدوال: فهارس_فارغة_1,
        استيرادات_العوام: فهارس_فارغة_2,
        استيرادات_الجداول: فهارس_فارغة_3,
        أنواع_الدوال: فهارس_فارغة_4,
        العوام: العوام,
        التصديرات: التصديرات,
        فهرس_قسم_الشفرة: 0,
        بداية_الشفرة: 0,
        حجم_الشفرة: 0,
        الأجسام: الأجسام,
        فهرس_قسم_البيانات: 0,
        بداية_البيانات: 0,
        حجم_البيانات: 0,
        القطع: القطع,
        الرموز: الرموز,
        الإزاحات: الإزاحات,
        المخصصة: المخصصة,
        الكومدات: الكومدات,
        دوال_البدء: دوال_البدء,
        الميزات: الميزات,
        له_ربط: خطأ
    };
    // The symbol table names undefined symbols by their imports, so the
    // `linking` section is read after the known sections; it follows them in
    // every object, as Linking.md requires.
    دع موضع_الربط: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأقسام) مثل طبيعي)) {
        دع مرجع_القسم: &واصف_قسم_ويب_أسمبلي = &الأقسام[ف];
        دع القسم: واصف_قسم_ويب_أسمبلي = *مرجع_القسم;
        دع المؤشر: متغير مؤشر_قراءة_ويب_أسمبلي = مؤشر_ويب_أسمبلي(
            القسم.موضع_المحتوى, القسم.موضع_المحتوى + القسم.حجم_المحتوى
        );
        دع الخطأ: متغير اختياري خطأ_قراءة_كائن_ويب_أسمبلي = اختياري.لا_شيء();
        إذا (القسم.المعرف == 1) {
            الخطأ := اقرأ_الأنواع_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 2) {
            الخطأ := اقرأ_الاستيرادات_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 3) {
            دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
            دع م: متغير طبيعي = 0;
            طالما (م < العدد && !المؤشر.فشل) {
                ألحق(الكائن.أنواع_الدوال, ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر));
                م := م + 1;
            }
        } وإلا إذا (القسم.المعرف == 4 || القسم.المعرف == 5 || القسم.المعرف == 13) {
            // Defined tables, memories and tags.
            دع العدد: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
            إذا (العدد != 0) {
                الخطأ := اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
            };
            المؤشر.الموضع := المؤشر.النهاية;
        } وإلا إذا (القسم.المعرف == 6) {
            الخطأ := اقرأ_العوام_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 7) {
            اقرأ_التصديرات_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 8) {
            الخطأ := اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.ميزة_غير_مدعومة());
        } وإلا إذا (القسم.المعرف == 9 || القسم.المعرف == 12) {
            المؤشر.الموضع := المؤشر.النهاية;
        } وإلا إذا (القسم.المعرف == 10) {
            الكائن.فهرس_قسم_الشفرة := ف;
            الكائن.بداية_الشفرة := القسم.موضع_المحتوى;
            الكائن.حجم_الشفرة := القسم.حجم_المحتوى;
            اقرأ_الشفرة_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 11) {
            الكائن.فهرس_قسم_البيانات := ف;
            الكائن.بداية_البيانات := القسم.موضع_المحتوى;
            الكائن.حجم_البيانات := القسم.حجم_المحتوى;
            الخطأ := اقرأ_البيانات_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
        } وإلا إذا (القسم.المعرف == 0) {
            دع الاسم: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
            إذا (اسم_ويب_أسمبلي_يطابق_نصا(&الاسم, «linking»)) {
                موضع_الربط := اختياري.موجود(ف);
                المؤشر.الموضع := المؤشر.النهاية;
            } وإلا إذا (بادئة_اسم_ويب_أسمبلي(&الاسم, «reloc.»)) {
                اقرأ_إزاحات_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن);
            } وإلا إذا (اسم_ويب_أسمبلي_يطابق_نصا(&الاسم, «target_features»)) {
                دع عدد_الميزات: طبيعي = ليب_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
                دع م: متغير طبيعي = 0;
                طالما (م < عدد_الميزات && !المؤشر.فشل) {
                    دع البادئة: طبيعي = بايت_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
                    دع الميزة: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
                    إذا (البادئة == 0x2B || البادئة == 0x3D) {
                        ألحق(الكائن.الميزات, الميزة);
                    };
                    م := م + 1;
                }
            } وإلا إذا (اسم_ويب_أسمبلي_يطابق_نصا(&الاسم, «producers»)
                || اسم_ويب_أسمبلي_يطابق_نصا(&الاسم, «name»)) {
                المؤشر.الموضع := المؤشر.النهاية;
            } وإلا إذا (!المؤشر.فشل) {
                دع المخصص: قسم_مخصص_كائن_ويب_أسمبلي = {
                    الفهرس: ف,
                    الاسم: الاسم,
                    البداية: المؤشر.الموضع,
                    الحجم: المؤشر.النهاية - المؤشر.الموضع
                };
                ألحق(الكائن.المخصصة, المخصص);
                المؤشر.الموضع := المؤشر.النهاية;
            };
        } وإلا {
            الخطأ := اختياري.موجود(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        طابق الخطأ مع
        | اختياري.موجود(الخطأ_الحاصل) -> { أرجع نتيجة.خطأ(الخطأ_الحاصل); }
        | اختياري.لا_شيء -> { };
        إذا (المؤشر.فشل || المؤشر.الموضع != المؤشر.النهاية) {
            أرجع نتيجة.خطأ(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        ف := ف + 1;
    }
    إذا ((الطول(الكائن.أنواع_الدوال) مثل طبيعي)
        != (الطول(الكائن.الأجسام) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
    };
    طابق موضع_الربط مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(فهرس_الربط) -> {
        دع مرجع_قسم_الربط: &واصف_قسم_ويب_أسمبلي = &الأقسام[فهرس_الربط];
        دع قسم_الربط: واصف_قسم_ويب_أسمبلي = *مرجع_قسم_الربط;
        دع المؤشر: متغير مؤشر_قراءة_ويب_أسمبلي = مؤشر_ويب_أسمبلي(
            قسم_الربط.موضع_المحتوى, قسم_الربط.موضع_المحتوى + قسم_الربط.حجم_المحتوى
        );
        دع اسم_الربط: متجه ط8 = اسم_بمؤشر_ويب_أسمبلي(البايتات, &متغير المؤشر);
        طابق اقرأ_الربط_ويب_أسمبلي(البايتات, &متغير المؤشر, &متغير الكائن) مع
        | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | اختياري.لا_شيء -> { };
        إذا (المؤشر.فشل) {
            أرجع نتيجة.خطأ(خطأ_قراءة_كائن_ويب_أسمبلي.وحدة_غير_صالحة());
        };
        الكائن.له_ربط := صواب;
    };
    أرجع نتيجة.نجح(الكائن);
}
