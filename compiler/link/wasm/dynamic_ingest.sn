استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.wasm.reader;
استورد std.fs.path;

// WebAssembly shared modules as link inputs (WebAssembly tool conventions,
// DynamicLinking.md). A shared module is a final module whose first section
// is the custom section `dylink.0`; its exports are the definitions it
// offers other modules: a function export is a function, an immutable i32
// global export is a data address (relative to the module's
// __memory_base), any other global export a global. Linking a shared module
// against it resolves undefined references to those names without copying
// anything: the reference stays an import (a function from `env`, data
// through GOT.mem, a function address through GOT.func) and the library's
// file name is recorded as a `dylink.0` NEEDED entry (link/wasm/linker.sn),
// as wasm-ld records a shared input's file name.
//
// Previously a WebAssembly shared module was classified as an ordinary
// object input and rejected.

عام عرف صنف_تصدير_دالة_مكتبة_ويب_أسمبلي(): طبيعي { أرجع 0; }
عام عرف صنف_تصدير_بيانات_مكتبة_ويب_أسمبلي(): طبيعي { أرجع 1; }
عام عرف صنف_تصدير_عام_مكتبة_ويب_أسمبلي(): طبيعي { أرجع 2; }

عام نوع تصدير_مكتبة_ويب_أسمبلي = {
    الاسم: متجه ط8,
    // صنف_تصدير_*_مكتبة_ويب_أسمبلي.
    الصنف: طبيعي
};

عام نوع مكتبة_ويب_أسمبلي = {
    التصديرات: متجه تصدير_مكتبة_ويب_أسمبلي,
    // The library's own WASM_DYLINK_NEEDED entries.
    المطلوبة: متجه متجه ط8
};

عام نوع خطأ_استيعاب_مكتبة_ويب_أسمبلي =
    | مكتبة_غير_صالحة
    | سعة_رموز_غير_قابلة_للتمثيل
;

عام نوع نتيجة_استيعاب_مكتبة_ويب_أسمبلي =
    | نجح
    | خطأ بنوع خطأ_استيعاب_مكتبة_ويب_أسمبلي
;

عرف اسم_يطابق_نص_مكتبة_ويب_أسمبلي(الاسم: &متجه ط8, النص: نص): منطقي {
    إذا ((الطول(*الاسم) مثل طبيعي) != (الطول(النص) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        إذا ((*الاسم)[ف] != النص[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Whether the bytes are a WebAssembly shared module: a valid module whose
// first section is the custom section `dylink.0` (the convention requires it
// to be first so a loader can recognize the module without scanning it).
عام عرف مكتبة_ويب_أسمبلي_مشتركة(البايتات: &متجه ط8): منطقي {
    طابق أقسام_ويب_أسمبلي(البايتات) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الأقسام) -> {
        إذا ((الطول(الأقسام) مثل طبيعي) == 0) { أرجع خطأ; };
        طابق الأقسام[0].الاسم_المخصص مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الاسم) -> { أرجع اسم_يطابق_نص_مكتبة_ويب_أسمبلي(&الاسم, «dylink.0»); };
    };
}

// Skips a limits field (table or memory type): flags, minimum, and the
// maximum (flag 1) and page size (flag 8) when present.
عرف تخط_حدود_مكتبة_ويب_أسمبلي(البايتات: &متجه ط8, الموضع: طبيعي): اختياري طبيعي {
    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأعلام) -> {
        دع التالي: متغير طبيعي = الأعلام.الموضع_التالي;
        طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, التالي) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الأدنى) -> { التالي := الأدنى.الموضع_التالي; };
        إذا ((الأعلام.القيمة & 1) != 0) {
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, التالي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الأعلى) -> { التالي := الأعلى.الموضع_التالي; };
        };
        إذا ((الأعلام.القيمة & 8) != 0) {
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, التالي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الصفحة) -> { التالي := الصفحة.الموضع_التالي; };
        };
        أرجع اختياري.موجود(التالي);
    };
}

// Skips a constant initializer expression up to and including its `end`.
عرف تخط_تعبير_ثابت_مكتبة_ويب_أسمبلي(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري طبيعي {
    دع الحالي: متغير طبيعي = الموضع;
    طالما (الحالي < النهاية) {
        دع الرمز: طبيعي = (*البايتات)[الحالي] مثل طبيعي;
        الحالي := الحالي + 1;
        إذا (الرمز == 0x0B) { أرجع اختياري.موجود(الحالي); };
        إذا (الرمز == 0x41 || الرمز == 0x42) {
            طابق اقرأ_ليب_موقع_ويب_أسمبلي(البايتات, الحالي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الحالي := القيمة.الموضع_التالي; };
        } وإلا إذا (الرمز == 0x43) {
            الحالي := الحالي + 4;
        } وإلا إذا (الرمز == 0x44) {
            الحالي := الحالي + 8;
        } وإلا إذا (الرمز == 0x23 || الرمز == 0xD2) {
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الحالي) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الحالي := القيمة.الموضع_التالي; };
        } وإلا إذا (الرمز == 0xD0) {
            الحالي := الحالي + 1;
        } وإلا إذا (الرمز != 0x6A && الرمز != 0x6B && الرمز != 0x6C
            && الرمز != 0x7C && الرمز != 0x7D && الرمز != 0x7E) {
            // Extended-constant arithmetic has no immediates; anything else
            // is not a constant expression.
            أرجع اختياري.لا_شيء();
        };
    }
    أرجع اختياري.لا_شيء();
}

// The exports and NEEDED entries of a shared module.
عام عرف اقرأ_مكتبة_ويب_أسمبلي(
    البايتات: &متجه ط8
): نتيجة مكتبة_ويب_أسمبلي, خطأ_استيعاب_مكتبة_ويب_أسمبلي {
    إذا (!مكتبة_ويب_أسمبلي_مشتركة(البايتات)) {
        أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة());
    };
    دع الأقسام: متجه واصف_قسم_ويب_أسمبلي;
    طابق أقسام_ويب_أسمبلي(البايتات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
    | اختياري.موجود(القيمة) -> { الأقسام := القيمة; };
    // Value type and mutability of every global, imported first.
    دع أنواع_العوام: متغير متجه طبيعي = [];
    دع تغير_العوام: متغير متجه منطقي = [];
    دع المطلوبة: متغير متجه متجه ط8 = [];
    دع التصديرات: متغير متجه تصدير_مكتبة_ويب_أسمبلي = [];
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(الأقسام) مثل طبيعي)) {
        دع البداية: طبيعي = الأقسام[ق].موضع_المحتوى;
        دع النهاية: طبيعي = البداية + الأقسام[ق].حجم_المحتوى;
        دع المعرف: طبيعي = الأقسام[ق].المعرف;
        إذا (ق == 0) {
            // dylink.0: subsections (type byte, size, payload) after the name.
            دع الحالي: متغير طبيعي = البداية;
            طابق اقرأ_اسم_ويب_أسمبلي(البايتات, الحالي, النهاية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
            | اختياري.موجود(الاسم) -> { الحالي := الاسم.الموضع_التالي; };
            طالما (الحالي < النهاية) {
                دع نوع_الفرعي: طبيعي = (*البايتات)[الحالي] مثل طبيعي;
                دع الحجم: قراءة_ليب_ويب_أسمبلي;
                طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الحالي + 1) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(القيمة) -> { الحجم := القيمة; };
                دع بداية_الفرعي: طبيعي = الحجم.الموضع_التالي;
                إذا (بداية_الفرعي > النهاية || الحجم.القيمة > النهاية - بداية_الفرعي) {
                    أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة());
                };
                دع نهاية_الفرعي: طبيعي = بداية_الفرعي + الحجم.القيمة;
                إذا (نوع_الفرعي == 2) {
                    // WASM_DYLINK_NEEDED
                    دع العدد: قراءة_ليب_ويب_أسمبلي;
                    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, بداية_الفرعي) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                    | اختياري.موجود(القيمة) -> { العدد := القيمة; };
                    دع الموضع: متغير طبيعي = العدد.الموضع_التالي;
                    دع م: متغير طبيعي = 0;
                    طالما (م < العدد.القيمة) {
                        طابق اقرأ_اسم_ويب_أسمبلي(البايتات, الموضع, نهاية_الفرعي) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                        | اختياري.موجود(الاسم) -> {
                            الموضع := الاسم.الموضع_التالي;
                            ألحق(المطلوبة, انسخ_نطاق_ويب_أسمبلي(
                                &الاسم.الاسم, 0, الطول(الاسم.الاسم) مثل طبيعي
                            ));
                        };
                        م := م + 1;
                    }
                };
                الحالي := نهاية_الفرعي;
            }
        } وإلا إذا (المعرف == 2) {
            // import: only the globals' types matter here.
            دع العدد: قراءة_ليب_ويب_أسمبلي;
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, البداية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { العدد := القيمة; };
            دع الموضع: متغير طبيعي = العدد.الموضع_التالي;
            دع م: متغير طبيعي = 0;
            طالما (م < العدد.القيمة) {
                طابق اقرأ_اسم_ويب_أسمبلي(البايتات, الموضع, النهاية) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(الوحدة) -> { الموضع := الوحدة.الموضع_التالي; };
                طابق اقرأ_اسم_ويب_أسمبلي(البايتات, الموضع, النهاية) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(الحقل) -> { الموضع := الحقل.الموضع_التالي; };
                إذا (الموضع >= النهاية) { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); };
                دع الصنف: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
                الموضع := الموضع + 1;
                إذا (الصنف == 0) {
                    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                    | اختياري.موجود(القيمة) -> { الموضع := القيمة.الموضع_التالي; };
                } وإلا إذا (الصنف == 1) {
                    طابق تخط_حدود_مكتبة_ويب_أسمبلي(البايتات, الموضع + 1) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                    | اختياري.موجود(التالي) -> { الموضع := التالي; };
                } وإلا إذا (الصنف == 2) {
                    طابق تخط_حدود_مكتبة_ويب_أسمبلي(البايتات, الموضع) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                    | اختياري.موجود(التالي) -> { الموضع := التالي; };
                } وإلا إذا (الصنف == 3) {
                    إذا (الموضع + 2 > النهاية) { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); };
                    ألحق(أنواع_العوام, (*البايتات)[الموضع] مثل طبيعي);
                    ألحق(تغير_العوام, (*البايتات)[الموضع + 1] != (0 مثل ط8));
                    الموضع := الموضع + 2;
                } وإلا إذا (الصنف == 4) {
                    طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع + 1) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                    | اختياري.موجود(القيمة) -> { الموضع := القيمة.الموضع_التالي; };
                } وإلا {
                    أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة());
                };
                م := م + 1;
            }
        } وإلا إذا (المعرف == 6) {
            // global: type, mutability, initializer.
            دع العدد: قراءة_ليب_ويب_أسمبلي;
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, البداية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { العدد := القيمة; };
            دع الموضع: متغير طبيعي = العدد.الموضع_التالي;
            دع م: متغير طبيعي = 0;
            طالما (م < العدد.القيمة) {
                إذا (الموضع + 2 > النهاية) { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); };
                ألحق(أنواع_العوام, (*البايتات)[الموضع] مثل طبيعي);
                ألحق(تغير_العوام, (*البايتات)[الموضع + 1] != (0 مثل ط8));
                طابق تخط_تعبير_ثابت_مكتبة_ويب_أسمبلي(البايتات, الموضع + 2, النهاية) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(التالي) -> { الموضع := التالي; };
                م := م + 1;
            }
        } وإلا إذا (المعرف == 7) {
            // export
            دع العدد: قراءة_ليب_ويب_أسمبلي;
            طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, البداية) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
            | اختياري.موجود(القيمة) -> { العدد := القيمة; };
            دع الموضع: متغير طبيعي = العدد.الموضع_التالي;
            دع م: متغير طبيعي = 0;
            طالما (م < العدد.القيمة) {
                دع الاسم: متغير متجه ط8 = [];
                طابق اقرأ_اسم_ويب_أسمبلي(البايتات, الموضع, النهاية) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(القراءة) -> {
                    الموضع := القراءة.الموضع_التالي;
                    الاسم := انسخ_نطاق_ويب_أسمبلي(
                        &القراءة.الاسم, 0, الطول(القراءة.الاسم) مثل طبيعي
                    );
                };
                إذا (الموضع >= النهاية) { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); };
                دع الصنف: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
                دع الفهرس: قراءة_ليب_ويب_أسمبلي;
                طابق اقرأ_ليب_طبيعي_ويب_أسمبلي(البايتات, الموضع + 1) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة()); }
                | اختياري.موجود(القيمة) -> { الفهرس := القيمة; };
                الموضع := الفهرس.الموضع_التالي;
                إذا (الصنف == 0) {
                    دع التصدير: تصدير_مكتبة_ويب_أسمبلي = {
                        الاسم: الاسم, الصنف: صنف_تصدير_دالة_مكتبة_ويب_أسمبلي()
                    };
                    ألحق(التصديرات, التصدير);
                } وإلا إذا (الصنف == 3) {
                    // The global section precedes the export section, so
                    // every global's type is known here.
                    إذا (الفهرس.القيمة >= (الطول(أنواع_العوام) مثل طبيعي)) {
                        أرجع نتيجة.خطأ(خطأ_استيعاب_مكتبة_ويب_أسمبلي.مكتبة_غير_صالحة());
                    };
                    دع صنف_التصدير: متغير طبيعي = صنف_تصدير_عام_مكتبة_ويب_أسمبلي();
                    إذا (أنواع_العوام[الفهرس.القيمة] == 0x7F && !تغير_العوام[الفهرس.القيمة]) {
                        صنف_التصدير := صنف_تصدير_بيانات_مكتبة_ويب_أسمبلي();
                    };
                    دع التصدير: تصدير_مكتبة_ويب_أسمبلي = { الاسم: الاسم, الصنف: صنف_التصدير };
                    ألحق(التصديرات, التصدير);
                };
                م := م + 1;
            }
        };
        ق := ق + 1;
    }
    دع المكتبة: مكتبة_ويب_أسمبلي = { التصديرات: التصديرات, المطلوبة: المطلوبة };
    أرجع نتيجة.نجح(المكتبة);
}

// The dependency name a shared module input is recorded under: its file
// name (wasm-ld's NEEDED entry); none for an input without a path.
عرف بايتات_نص_مكتبة_ويب_أسمبلي(النص: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق(الناتج, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اسم_اعتماد_مكتبة_ويب_أسمبلي(المدخل: &مدخل_ربط): متجه ط8 {
    طابق (*المدخل).المسار مع
    | اختياري.لا_شيء -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
    | اختياري.موجود(المسار) -> {
        طابق اسم_الملف(&المسار) مع
        | اختياري.لا_شيء -> { أرجع بايتات_نص_مكتبة_ويب_أسمبلي(&المسار); }
        | اختياري.موجود(الاسم) -> { أرجع بايتات_نص_مكتبة_ويب_أسمبلي(&الاسم); };
    };
}

// Registers a shared module input: one dependency of the plan, and every
// export as a shared definition in the one link symbol table (a regular
// definition always wins over it; link/symbol_model.sn).
عام عرف استوعب_مكتبة_ويب_أسمبلي_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_استيعاب_مكتبة_ويب_أسمبلي {
    دع المكتبة: مكتبة_ويب_أسمبلي;
    طابق اقرأ_مكتبة_ويب_أسمبلي(&(*المدخل).البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_استيعاب_مكتبة_ويب_أسمبلي.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { المكتبة := القيمة; };
    دع اسم_الاعتماد: متجه ط8 = اسم_اعتماد_مكتبة_ويب_أسمبلي(المدخل);
    إذا ((الطول(اسم_الاعتماد) مثل طبيعي) > 0) {
        دع الاعتماد: متغير اعتماد_مكتبة_ديناميكية_ربط = اعتماد_مكتبة_ديناميكية_باسم(اسم_الاعتماد);
        اربط_اعتماد_ديناميكي_بمدخل(&متغير الاعتماد, (*المدخل).المعرف);
        أضف_اعتماد_مكتبة_ديناميكية_إلى_خطة_ربط(&متغير (*السياق).الخطة, الاعتماد);
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكتبة.التصديرات) مثل طبيعي)) {
        طابق سجل_رمز_مكتبة_ديناميكية_للربط(
            &متغير (*السياق).الرموز,
            &المكتبة.التصديرات[ف].الاسم,
            (*المدخل).المعرف
        ) مع
        | نتيجة_تسجيل_رمز_ربط.خطأ(_) -> {
            أرجع نتيجة_استيعاب_مكتبة_ويب_أسمبلي.خطأ(
                خطأ_استيعاب_مكتبة_ويب_أسمبلي.سعة_رموز_غير_قابلة_للتمثيل()
            );
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع نتيجة_استيعاب_مكتبة_ويب_أسمبلي.نجح();
}
