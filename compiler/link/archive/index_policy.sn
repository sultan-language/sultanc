استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.symbol_model;
استورد compiler.link.archive_model;
استورد compiler.link.resolution;
استورد compiler.link.symbol_table;

// حل_رمز_غير_مكتمل: resolution could not complete for the offered symbol;
// سعة_رموز_غير_قابلة_للتمثيل: the archive member index or the symbol table
// could not grow (link/archive_model.sn نتيجة_تسجيل_عضو_أرشيف_ربط,
// link/resolution.sn خطأ_حل_رموز_ربط), which is not a malformed archive.
عام نوع خطأ_فهرسة_رمز_أرشيف_ربط =
    | حل_رمز_غير_مكتمل
    | سعة_رموز_غير_قابلة_للتمثيل
;

عام نوع نتيجة_فهرسة_رمز_أرشيف_ربط =
    | نجح
    | خطأ بنوع خطأ_فهرسة_رمز_أرشيف_ربط
;

عام عرف سجل_رمز_عضو_أرشيف_كسولا_بمصدر(
    السياق: &متغير سياق_ربط,
    معرف_الأرشيف: معرف_مدخل_ربط,
    موضع_رأس_العضو: غير_موقع,
    المصدر: مصدر_عضو_أرشيف_ربط,
    اسم_الرمز: &متجه غ8
): نتيجة_فهرسة_رمز_أرشيف_ربط {
    طابق ابحث_رمز_ربط_بالاسم(&(*السياق).الرموز, اسم_الرمز) مع
    | اختيار.بعض(الرمز_الموجود) -> {
        طابق الرمز_الموجود.الحالة مع
        | حالة_رمز_ربط.معرف(_) -> {
            أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.نجح();
        }
        | حالة_رمز_ربط.ديناميكي(_) -> {
            أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.نجح();
        }
        | حالة_رمز_ربط.كسول(_, _) -> {
            أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.نجح();
        }
        | حالة_رمز_ربط.غير_معرف(_) -> { };
    }
    | اختيار.لا_شيء -> { };

    // The member is registered before any symbol names it; when it cannot be
    // registered no lazy symbol is published and the capacity failure is
    // returned.
    دع معرف_العضو: معرف_عضو_أرشيف_ربط;
    طابق سجل_عضو_أرشيف_ربط_كسولا_بمصدر(
        &متغير (*السياق).الأرشيفات,
        معرف_الأرشيف,
        موضع_رأس_العضو,
        المصدر
    ) مع
    | نتيجة_تسجيل_عضو_أرشيف_ربط.مسجل(المعرف) -> { معرف_العضو := المعرف; }
    | نتيجة_تسجيل_عضو_أرشيف_ربط.سعة_غير_قابلة_للتمثيل -> {
        أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(
            خطأ_فهرسة_رمز_أرشيف_ربط.سعة_رموز_غير_قابلة_للتمثيل()
        );
    };
    طابق سجل_عضو_أرشيف_كسولا_للربط(
        &متغير (*السياق).الرموز,
        اسم_الرمز,
        معرف_الأرشيف,
        معرف_العضو.الموضع
    ) مع
    | نتيجة_تسجيل_رمز_ربط.نجح(_) -> {
        أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.استخرج_عضو_أرشيف(
        _,
        الأرشيف_المطلوب,
        العضو_المطلوب
    ) -> {
        دع معرف_العضو_المطلوب: معرف_عضو_أرشيف_ربط = {
            الأرشيف: الأرشيف_المطلوب,
            الموضع: العضو_المطلوب
        };
        لو (!اطلب_استخراج_عضو_أرشيف_ربط(
            &متغير (*السياق).الأرشيفات,
            معرف_العضو_المطلوب
        )) {
            أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(
                خطأ_فهرسة_رمز_أرشيف_ربط.حل_رمز_غير_مكتمل()
            );
        };
        أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.نجح();
    }
    | نتيجة_تسجيل_رمز_ربط.خطأ(الخطأ) -> {
        أرجع نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(
            خطأ_فهرسة_رمز_من_خطأ_حل_ربط(الخطأ)
        );
    };
}

// A resolution error while indexing an archive symbol. A symbol table that
// cannot grow stays a capacity failure; any other error leaves resolution
// incomplete.
عرف خطأ_فهرسة_رمز_من_خطأ_حل_ربط(
    الخطأ: خطأ_حل_رموز_ربط
): خطأ_فهرسة_رمز_أرشيف_ربط {
    طابق الخطأ مع
    | خطأ_حل_رموز_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
        أرجع خطأ_فهرسة_رمز_أرشيف_ربط.سعة_رموز_غير_قابلة_للتمثيل();
    }
    | _ -> { أرجع خطأ_فهرسة_رمز_أرشيف_ربط.حل_رمز_غير_مكتمل(); };
}

عام عرف سجل_رمز_عضو_أرشيف_كسولا(
    السياق: &متغير سياق_ربط,
    معرف_الأرشيف: معرف_مدخل_ربط,
    موضع_رأس_العضو: غير_موقع,
    موضع_محتوى_العضو: غير_موقع,
    حجم_محتوى_العضو: غير_موقع,
    اسم_الرمز: &متجه غ8
): نتيجة_فهرسة_رمز_أرشيف_ربط {
    أرجع سجل_رمز_عضو_أرشيف_كسولا_بمصدر(
        السياق,
        معرف_الأرشيف,
        موضع_رأس_العضو,
        مصدر_عضو_أرشيف_ربط.مضمّن(
            موضع_محتوى_العضو,
            حجم_محتوى_العضو
        ),
        اسم_الرمز
    );
}

عام عرف سجل_رمز_عضو_أرشيف_كسولا_بملف(
    السياق: &متغير سياق_ربط,
    معرف_الأرشيف: معرف_مدخل_ربط,
    موضع_رأس_العضو: غير_موقع,
    المسار: نص,
    اسم_الرمز: &متجه غ8
): نتيجة_فهرسة_رمز_أرشيف_ربط {
    أرجع سجل_رمز_عضو_أرشيف_كسولا_بمصدر(
        السياق,
        معرف_الأرشيف,
        موضع_رأس_العضو,
        مصدر_عضو_أرشيف_ربط.ملف_خارجي(المسار),
        اسم_الرمز
    );
}
