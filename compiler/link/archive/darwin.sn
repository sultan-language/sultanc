استورد compiler.link.context;
استورد compiler.link.model;
استورد std.archive.ar;
استورد compiler.link.archive.index_policy;
استورد std.text.from_bytes;

// سعة_رموز_غير_قابلة_للتمثيل: the archive member index or the symbol table
// could not grow while the archive was well formed (archive/index_policy.sn);
// previously it was reported as incomplete resolution.
عام نوع خطأ_فهرسة_أرشيف_داروين =
    | أرشيف_غير_صالح
    | جدول_رموز_غير_مدعوم
    | حل_رمز_غير_مكتمل
    | سعة_رموز_غير_قابلة_للتمثيل
;

عام نوع نتيجة_فهرسة_أرشيف_داروين =
    | نجح
    | خطأ بنوع خطأ_فهرسة_أرشيف_داروين
;

نوع عرض_جدول_رموز_داروين =
    | عرض32
    | عرض64
;

نوع حقيقة_عضو_أرشيف_داروين = {
    الحاوية: حقيقة_عضو_حاوية_أرشيف,
    الاسم: متجه ط8,
    موضع_المحتوى: طبيعي,
    الحجم: طبيعي
};

عرف اقرأ_ط32_صغير_أرشيف_داروين(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع البايت_صفر: طبيعي = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع) مثل طبيعي;
    دع البايت_واحد: طبيعي = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 1) مثل طبيعي;
    دع البايت_اثنان: طبيعي =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 2) مثل طبيعي;
    دع البايت_ثلاثة: طبيعي =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 3) مثل طبيعي;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عرف اقرأ_ط64_صغير_أرشيف_داروين(
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    دع الجزء_الأدنى: طبيعي =
        اقرأ_ط32_صغير_أرشيف_داروين(البايتات, الموضع);
    دع الجزء_الأعلى: طبيعي =
        اقرأ_ط32_صغير_أرشيف_داروين(البايتات, الموضع + 4);
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عرف انسخ_شريحة_اسم_أرشيف_داروين(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): متجه ط8 {
    دع الاسم: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < الحجم) {
        ألحق(الاسم, اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الاسم;
}

عرف انسخ_اسم_ممتد_أرشيف_داروين(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    الحجم: طبيعي
): متجه ط8 {
    دع الاسم: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = 0;
    دع يستمر_نسخ_الاسم: متغير منطقي = صواب;
    طالما ((فهرس_البايت < الحجم) && يستمر_نسخ_الاسم) {
        دع البايت: ط8 = اقرأ_بايت_حاوية_أرشيف(
            البايتات,
            الموضع + فهرس_البايت
        );
        لو (البايت == 0) {
            يستمر_نسخ_الاسم := خطأ;
        } وإلا {
            ألحق(الاسم, البايت);
            فهرس_البايت := فهرس_البايت + 1;
        };
    }
    أرجع الاسم;
}

عرف اقرأ_اسم_حقل_أرشيف_داروين(
    البايتات: &متجه ط8,
    موضع_الرأس: طبيعي
): متجه ط8 {
    دع طول_الاسم: متغير طبيعي = 0;
    دع يستمر_قراءة_الاسم: متغير منطقي = صواب;
    طالما ((طول_الاسم < 16) && يستمر_قراءة_الاسم) {
        لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + طول_الاسم) == 0x20) {
            يستمر_قراءة_الاسم := خطأ;
        };
        لو (يستمر_قراءة_الاسم) {
            طول_الاسم := طول_الاسم + 1;
        };
    }
    لو (طول_الاسم > 0
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + طول_الاسم - 1) == 0x2F) {
        طول_الاسم := طول_الاسم - 1;
    };
    أرجع انسخ_شريحة_اسم_أرشيف_داروين(
        البايتات,
        موضع_الرأس,
        طول_الاسم
    );
}

عرف يبدأ_اسم_عضو_داروين_باسم_ممتد(
    البايتات: &متجه ط8,
    موضع_الرأس: طبيعي
): منطقي {
    أرجع اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس) == 0x23
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 1) == 0x31
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 2) == 0x2F;
}

عرف اقرأ_حقيقة_عضو_أرشيف_داروين(
    البايتات: &متجه ط8,
    موضع_الرأس: طبيعي
): اختياري حقيقة_عضو_أرشيف_داروين {
    دع الحاوية: حقيقة_عضو_حاوية_أرشيف;
    طابق اقرأ_حقيقة_عضو_حاوية_أرشيف(البايتات, موضع_الرأس) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الحقيقة) -> { الحاوية := الحقيقة; };

    دع الاسم: متجه ط8;
    دع موضع_المحتوى: طبيعي;
    دع حجم_المحتوى: طبيعي;
    لو (يبدأ_اسم_عضو_داروين_باسم_ممتد(البايتات, موضع_الرأس)) {
        دع طول_الاسم: طبيعي;
        طابق اقرأ_عدد_عشري_من_حقل_أرشيف(
            البايتات,
            موضع_الرأس + 3,
            13
        ) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الطول_المقروء) -> { طول_الاسم := الطول_المقروء; };
        لو (طول_الاسم > الحاوية.الحجم) {
            أرجع اختياري.لا_شيء();
        };
        الاسم := انسخ_اسم_ممتد_أرشيف_داروين(
            البايتات,
            الحاوية.موضع_المحتوى,
            طول_الاسم
        );
        موضع_المحتوى := الحاوية.موضع_المحتوى + طول_الاسم;
        حجم_المحتوى := الحاوية.الحجم - طول_الاسم;
    } وإلا {
        الاسم := اقرأ_اسم_حقل_أرشيف_داروين(البايتات, موضع_الرأس);
        موضع_المحتوى := الحاوية.موضع_المحتوى;
        حجم_المحتوى := الحاوية.الحجم;
    };
    دع الحقيقة: حقيقة_عضو_أرشيف_داروين = {
        الحاوية: الحاوية,
        الاسم: الاسم,
        موضع_المحتوى: موضع_المحتوى,
        الحجم: حجم_المحتوى
    };
    أرجع اختياري.موجود(الحقيقة);
}

عرف اسما_أرشيف_داروين_متساويان(
    الاسم: &متجه ط8,
    المتوقع: &متجه ط8
): منطقي {
    لو (
        (الطول(*الاسم) مثل طبيعي)
            != (الطول(*المتوقع) مثل طبيعي)
    ) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير طبيعي = 0;
    طالما (فهرس_البايت < (الطول(*الاسم) مثل طبيعي)) {
        لو ((*الاسم)[فهرس_البايت] != (*المتوقع)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف صنف_جدول_رموز_عضو_داروين(
    الاسم: &متجه ط8
): اختياري عرض_جدول_رموز_داروين {
    دع اسم_عادي: متجه ط8 = بايتات_من_نص(«__.SYMDEF»);
    دع اسم_مرتب: متجه ط8 = بايتات_من_نص(«__.SYMDEF SORTED»);
    دع اسم_عريض: متجه ط8 = بايتات_من_نص(«__.SYMDEF_64»);
    دع اسم_عريض_مرتب: متجه ط8 = بايتات_من_نص(«__.SYMDEF_64 SORTED»);
    لو (اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عادي)
        || اسما_أرشيف_داروين_متساويان(الاسم, &اسم_مرتب)) {
        أرجع اختياري.موجود(عرض_جدول_رموز_داروين.عرض32());
    };
    لو (اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عريض)
        || اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عريض_مرتب)) {
        أرجع اختياري.موجود(عرض_جدول_رموز_داروين.عرض64());
    };
    أرجع اختياري.لا_شيء();
}

عرف ابحث_جدول_رموز_أرشيف_داروين(
    البايتات: &متجه ط8
): اختياري حقيقة_عضو_أرشيف_داروين {
    دع موضع_الرأس: متغير طبيعي = 8;
    طالما (موضع_الرأس < (الطول(*البايتات) مثل طبيعي)) {
        دع حقيقة_العضو: حقيقة_عضو_أرشيف_داروين;
        طابق اقرأ_حقيقة_عضو_أرشيف_داروين(البايتات, موضع_الرأس) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        طابق صنف_جدول_رموز_عضو_داروين(&حقيقة_العضو.الاسم) مع
        | اختياري.موجود(_) -> { أرجع اختياري.موجود(حقيقة_العضو); }
        | اختياري.لا_شيء -> { };
        موضع_الرأس := حقيقة_العضو.الحاوية.موضع_الرأس_التالي;
    }
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_اسم_رمز_أرشيف_داروين(
    البايتات: &متجه ط8,
    الموضع: طبيعي,
    النهاية: طبيعي
): اختياري متجه ط8 {
    لو (
        الموضع >= النهاية
            || النهاية > (الطول(*البايتات) مثل طبيعي)
    ) {
        أرجع اختياري.لا_شيء();
    };
    دع الاسم: متغير متجه ط8 = [];
    دع فهرس_البايت: متغير طبيعي = الموضع;
    طالما (فهرس_البايت < النهاية) {
        دع البايت: ط8 = اقرأ_بايت_حاوية_أرشيف(البايتات, فهرس_البايت);
        لو (البايت == 0) {
            أرجع اختياري.موجود(الاسم);
        };
        ألحق(الاسم, البايت);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف حجم_كلمة_جدول_رموز_داروين(
    العرض: عرض_جدول_رموز_داروين
): طبيعي {
    طابق العرض مع
    | عرض_جدول_رموز_داروين.عرض32 -> { أرجع 4; }
    | عرض_جدول_رموز_داروين.عرض64 -> { أرجع 8; };
}

عرف اقرأ_كلمة_جدول_رموز_داروين(
    العرض: عرض_جدول_رموز_داروين,
    البايتات: &متجه ط8,
    الموضع: طبيعي
): طبيعي {
    طابق العرض مع
    | عرض_جدول_رموز_داروين.عرض32 -> {
        أرجع اقرأ_ط32_صغير_أرشيف_داروين(البايتات, الموضع);
    }
    | عرض_جدول_رموز_داروين.عرض64 -> {
        أرجع اقرأ_ط64_صغير_أرشيف_داروين(البايتات, الموضع);
    };
}

عرف فهرس_جدول_رموز_داروين(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الجدول: &حقيقة_عضو_أرشيف_داروين,
    العرض: عرض_جدول_رموز_داروين
): نتيجة_فهرسة_أرشيف_داروين {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    دع حجم_الكلمة: طبيعي = حجم_كلمة_جدول_رموز_داروين(العرض);
    دع حجم_مدخل_رانليب: طبيعي = حجم_الكلمة * 2;
    لو ((*الجدول).الحجم < حجم_الكلمة * 2) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع حجم_مدخلات_رانليب: طبيعي = اقرأ_كلمة_جدول_رموز_داروين(
        العرض,
        البايتات,
        (*الجدول).موضع_المحتوى
    );
    لو ((حجم_مدخلات_رانليب % حجم_مدخل_رانليب) != 0
        || حجم_مدخلات_رانليب
            > (*الجدول).الحجم - حجم_الكلمة * 2) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع موضع_مدخلات_رانليب: طبيعي =
        (*الجدول).موضع_المحتوى + حجم_الكلمة;
    دع موضع_حجم_النصوص: طبيعي =
        موضع_مدخلات_رانليب + حجم_مدخلات_رانليب;
    دع حجم_النصوص: طبيعي = اقرأ_كلمة_جدول_رموز_داروين(
        العرض,
        البايتات,
        موضع_حجم_النصوص
    );
    دع موضع_النصوص: طبيعي = موضع_حجم_النصوص + حجم_الكلمة;
    لو (حجم_النصوص
        > (*الجدول).الحجم - حجم_الكلمة * 2 - حجم_مدخلات_رانليب) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع نهاية_النصوص: طبيعي = موضع_النصوص + حجم_النصوص;
    دع عدد_الرموز: طبيعي = حجم_مدخلات_رانليب / حجم_مدخل_رانليب;
    دع فهرس_الرمز: متغير طبيعي = 0;
    طالما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_مدخل_رانليب: طبيعي =
            موضع_مدخلات_رانليب + فهرس_الرمز * حجم_مدخل_رانليب;
        دع إزاحة_الاسم: طبيعي = اقرأ_كلمة_جدول_رموز_داروين(
            العرض,
            البايتات,
            موضع_مدخل_رانليب
        );
        دع موضع_رأس_العضو: طبيعي = اقرأ_كلمة_جدول_رموز_داروين(
            العرض,
            البايتات,
            موضع_مدخل_رانليب + حجم_الكلمة
        );
        لو (إزاحة_الاسم >= حجم_النصوص) {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        };
        دع حقيقة_العضو: حقيقة_عضو_أرشيف_داروين;
        طابق اقرأ_حقيقة_عضو_أرشيف_داروين(
            البايتات,
            موضع_رأس_العضو
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        }
        | اختياري.موجود(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        دع اسم_الرمز: متجه ط8;
        طابق اقرأ_اسم_رمز_أرشيف_داروين(
            البايتات,
            موضع_النصوص + إزاحة_الاسم,
            نهاية_النصوص
        ) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        }
        | اختياري.موجود(الاسم) -> { اسم_الرمز := الاسم; };
        طابق سجل_رمز_عضو_أرشيف_كسولا(
            السياق,
            (*المدخل).المعرف,
            موضع_رأس_العضو,
            حقيقة_العضو.موضع_المحتوى,
            حقيقة_العضو.الحجم,
            &اسم_الرمز
        ) مع
        | نتيجة_فهرسة_رمز_أرشيف_ربط.نجح -> { }
        | نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(الخطأ) -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين_من_رمز(الخطأ)
            );
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع نتيجة_فهرسة_أرشيف_داروين.نجح();
}

// An archive-symbol indexing error as a Darwin archive indexing error; a
// capacity failure is kept distinct from incomplete resolution.
عرف خطأ_فهرسة_أرشيف_داروين_من_رمز(
    الخطأ: خطأ_فهرسة_رمز_أرشيف_ربط
): خطأ_فهرسة_أرشيف_داروين {
    طابق الخطأ مع
    | خطأ_فهرسة_رمز_أرشيف_ربط.حل_رمز_غير_مكتمل -> {
        أرجع خطأ_فهرسة_أرشيف_داروين.حل_رمز_غير_مكتمل();
    }
    | خطأ_فهرسة_رمز_أرشيف_ربط.سعة_رموز_غير_قابلة_للتمثيل -> {
        أرجع خطأ_فهرسة_أرشيف_داروين.سعة_رموز_غير_قابلة_للتمثيل();
    };
}

عام عرف فهرس_أرشيف_داروين_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_فهرسة_أرشيف_داروين {
    دع البايتات: &متجه ط8 = &(*المدخل).البايتات;
    لو (!تحقق_توقيع_حاوية_أرشيف(البايتات)) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع جدول_الرموز: حقيقة_عضو_أرشيف_داروين;
    طابق ابحث_جدول_رموز_أرشيف_داروين(البايتات) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.جدول_رموز_غير_مدعوم()
        );
    }
    | اختياري.موجود(الحقيقة) -> { جدول_الرموز := الحقيقة; };
    طابق صنف_جدول_رموز_عضو_داروين(&جدول_الرموز.الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.جدول_رموز_غير_مدعوم()
        );
    }
    | اختياري.موجود(العرض) -> {
        أرجع فهرس_جدول_رموز_داروين(
            السياق,
            المدخل,
            &جدول_الرموز,
            العرض
        );
    };
}
