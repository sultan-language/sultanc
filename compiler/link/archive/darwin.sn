استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.archive.ar_container;
استورد compiler.link.archive.index_policy;

عام نوع خطأ_فهرسة_أرشيف_داروين =
    | أرشيف_غير_صالح
    | جدول_رموز_غير_مدعوم
    | حل_رمز_غير_مكتمل
;

عام نوع نتيجة_فهرسة_أرشيف_داروين =
    | نجح
    | خطأ بنوع خطأ_فهرسة_أرشيف_داروين
;

نوع عرض_جدول_رموز_داروين =
    | عرض32
    | عرض64
;

نوع حقيقة_عضو_أرشيف_داروين = {
    الحاوية: حقيقة_عضو_حاوية_أرشيف,
    الاسم: متجه غ8,
    موضع_المحتوى: غير_موقع,
    الحجم: غير_موقع
};

عرف اقرأ_غ32_صغير_أرشيف_داروين(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_صفر: غير_موقع = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع) مثل غير_موقع;
    دع البايت_واحد: غير_موقع = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 1) مثل غير_موقع;
    دع البايت_اثنان: غير_موقع =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 2) مثل غير_موقع;
    دع البايت_ثلاثة: غير_موقع =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 3) مثل غير_موقع;
    أرجع البايت_صفر
        + البايت_واحد * 256
        + البايت_اثنان * 65536
        + البايت_ثلاثة * 16777216;
}

عرف اقرأ_غ64_صغير_أرشيف_داروين(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الجزء_الأدنى: غير_موقع =
        اقرأ_غ32_صغير_أرشيف_داروين(البايتات, الموضع);
    دع الجزء_الأعلى: غير_موقع =
        اقرأ_غ32_صغير_أرشيف_داروين(البايتات, الموضع + 4);
    أرجع الجزء_الأدنى + الجزء_الأعلى * 4294967296;
}

عرف انسخ_شريحة_اسم_أرشيف_داروين(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < الحجم) {
        ألحق(الاسم, اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + فهرس_البايت));
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع الاسم;
}

عرف انسخ_اسم_ممتد_أرشيف_داروين(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): متجه غ8 {
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    دع يستمر_نسخ_الاسم: متغير منطقي = صواب;
    بينما ((فهرس_البايت < الحجم) && يستمر_نسخ_الاسم) {
        دع البايت: غ8 = اقرأ_بايت_حاوية_أرشيف(
            البايتات,
            الموضع + فهرس_البايت
        );
        لو (البايت == 0) {
            يستمر_نسخ_الاسم := خطأ;
        } وإلا {
            ألحق(الاسم, البايت);
            فهرس_البايت := فهرس_البايت + 1;
        };
    }
    أرجع الاسم;
}

عرف اقرأ_اسم_حقل_أرشيف_داروين(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): متجه غ8 {
    دع طول_الاسم: متغير غير_موقع = 0;
    دع يستمر_قراءة_الاسم: متغير منطقي = صواب;
    بينما ((طول_الاسم < 16) && يستمر_قراءة_الاسم) {
        لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + طول_الاسم) == 0x20) {
            يستمر_قراءة_الاسم := خطأ;
        };
        لو (يستمر_قراءة_الاسم) {
            طول_الاسم := طول_الاسم + 1;
        };
    }
    لو (طول_الاسم > 0
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + طول_الاسم - 1) == 0x2F) {
        طول_الاسم := طول_الاسم - 1;
    };
    أرجع انسخ_شريحة_اسم_أرشيف_داروين(
        البايتات,
        موضع_الرأس,
        طول_الاسم
    );
}

عرف يبدأ_اسم_عضو_داروين_باسم_ممتد(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): منطقي {
    أرجع اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس) == 0x23
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 1) == 0x31
        && اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 2) == 0x2F;
}

عرف اقرأ_حقيقة_عضو_أرشيف_داروين(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): اختيار حقيقة_عضو_أرشيف_داروين {
    دع الحاوية: حقيقة_عضو_حاوية_أرشيف;
    طابق اقرأ_حقيقة_عضو_حاوية_أرشيف(البايتات, موضع_الرأس) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الحقيقة) -> { الحاوية := الحقيقة; };

    دع الاسم: متجه غ8;
    دع موضع_المحتوى: غير_موقع;
    دع حجم_المحتوى: غير_موقع;
    لو (يبدأ_اسم_عضو_داروين_باسم_ممتد(البايتات, موضع_الرأس)) {
        دع طول_الاسم: غير_موقع;
        طابق اقرأ_عدد_عشري_من_حقل_أرشيف(
            البايتات,
            موضع_الرأس + 3,
            13
        ) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الطول_المقروء) -> { طول_الاسم := الطول_المقروء; };
        لو (طول_الاسم > الحاوية.الحجم) {
            أرجع اختيار.لا_شيء();
        };
        الاسم := انسخ_اسم_ممتد_أرشيف_داروين(
            البايتات,
            الحاوية.موضع_المحتوى,
            طول_الاسم
        );
        موضع_المحتوى := الحاوية.موضع_المحتوى + طول_الاسم;
        حجم_المحتوى := الحاوية.الحجم - طول_الاسم;
    } وإلا {
        الاسم := اقرأ_اسم_حقل_أرشيف_داروين(البايتات, موضع_الرأس);
        موضع_المحتوى := الحاوية.موضع_المحتوى;
        حجم_المحتوى := الحاوية.الحجم;
    };
    دع الحقيقة: حقيقة_عضو_أرشيف_داروين = {
        الحاوية: الحاوية,
        الاسم: الاسم,
        موضع_المحتوى: موضع_المحتوى,
        الحجم: حجم_المحتوى
    };
    أرجع اختيار.بعض(الحقيقة);
}

عرف اسما_أرشيف_داروين_متساويان(
    الاسم: &متجه غ8,
    المتوقع: &متجه غ8
): منطقي {
    لو (
        (الطول(*الاسم) مثل غير_موقع)
            != (الطول(*المتوقع) مثل غير_موقع)
    ) {
        أرجع خطأ;
    };
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < (الطول(*الاسم) مثل غير_موقع)) {
        لو ((*الاسم)[فهرس_البايت] != (*المتوقع)[فهرس_البايت]) {
            أرجع خطأ;
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع صواب;
}

عرف صنف_جدول_رموز_عضو_داروين(
    الاسم: &متجه غ8
): اختيار عرض_جدول_رموز_داروين {
    دع اسم_عادي: متجه غ8 = [
        0x5F, 0x5F, 0x2E, 0x53, 0x59, 0x4D, 0x44, 0x45, 0x46
    ];
    دع اسم_مرتب: متجه غ8 = [
        0x5F, 0x5F, 0x2E, 0x53, 0x59, 0x4D, 0x44, 0x45, 0x46,
        0x20, 0x53, 0x4F, 0x52, 0x54, 0x45, 0x44
    ];
    دع اسم_عريض: متجه غ8 = [
        0x5F, 0x5F, 0x2E, 0x53, 0x59, 0x4D, 0x44, 0x45, 0x46,
        0x5F, 0x36, 0x34
    ];
    دع اسم_عريض_مرتب: متجه غ8 = [
        0x5F, 0x5F, 0x2E, 0x53, 0x59, 0x4D, 0x44, 0x45, 0x46,
        0x5F, 0x36, 0x34, 0x20, 0x53, 0x4F, 0x52, 0x54, 0x45, 0x44
    ];
    لو (اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عادي)
        || اسما_أرشيف_داروين_متساويان(الاسم, &اسم_مرتب)) {
        أرجع اختيار.بعض(عرض_جدول_رموز_داروين.عرض32());
    };
    لو (اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عريض)
        || اسما_أرشيف_داروين_متساويان(الاسم, &اسم_عريض_مرتب)) {
        أرجع اختيار.بعض(عرض_جدول_رموز_داروين.عرض64());
    };
    أرجع اختيار.لا_شيء();
}

عرف ابحث_جدول_رموز_أرشيف_داروين(
    البايتات: &متجه غ8
): اختيار حقيقة_عضو_أرشيف_داروين {
    دع موضع_الرأس: متغير غير_موقع = 8;
    بينما (موضع_الرأس < (الطول(*البايتات) مثل غير_موقع)) {
        دع حقيقة_العضو: حقيقة_عضو_أرشيف_داروين;
        طابق اقرأ_حقيقة_عضو_أرشيف_داروين(البايتات, موضع_الرأس) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        طابق صنف_جدول_رموز_عضو_داروين(&حقيقة_العضو.الاسم) مع
        | اختيار.بعض(_) -> { أرجع اختيار.بعض(حقيقة_العضو); }
        | اختيار.لا_شيء -> { };
        موضع_الرأس := حقيقة_العضو.الحاوية.موضع_الرأس_التالي;
    }
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_اسم_رمز_أرشيف_داروين(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (
        الموضع >= النهاية
            || النهاية > (الطول(*البايتات) مثل غير_موقع)
    ) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = الموضع;
    بينما (فهرس_البايت < النهاية) {
        دع البايت: غ8 = اقرأ_بايت_حاوية_أرشيف(البايتات, فهرس_البايت);
        لو (البايت == 0) {
            أرجع اختيار.بعض(الاسم);
        };
        ألحق(الاسم, البايت);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف حجم_كلمة_جدول_رموز_داروين(
    العرض: عرض_جدول_رموز_داروين
): غير_موقع {
    طابق العرض مع
    | عرض_جدول_رموز_داروين.عرض32 -> { أرجع 4; }
    | عرض_جدول_رموز_داروين.عرض64 -> { أرجع 8; };
}

عرف اقرأ_كلمة_جدول_رموز_داروين(
    العرض: عرض_جدول_رموز_داروين,
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    طابق العرض مع
    | عرض_جدول_رموز_داروين.عرض32 -> {
        أرجع اقرأ_غ32_صغير_أرشيف_داروين(البايتات, الموضع);
    }
    | عرض_جدول_رموز_داروين.عرض64 -> {
        أرجع اقرأ_غ64_صغير_أرشيف_داروين(البايتات, الموضع);
    };
}

عرف فهرس_جدول_رموز_داروين(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط,
    الجدول: &حقيقة_عضو_أرشيف_داروين,
    العرض: عرض_جدول_رموز_داروين
): نتيجة_فهرسة_أرشيف_داروين {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    دع حجم_الكلمة: غير_موقع = حجم_كلمة_جدول_رموز_داروين(العرض);
    دع حجم_مدخل_رانليب: غير_موقع = حجم_الكلمة * 2;
    لو ((*الجدول).الحجم < حجم_الكلمة * 2) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع حجم_مدخلات_رانليب: غير_موقع = اقرأ_كلمة_جدول_رموز_داروين(
        العرض,
        البايتات,
        (*الجدول).موضع_المحتوى
    );
    لو ((حجم_مدخلات_رانليب % حجم_مدخل_رانليب) != 0
        || حجم_مدخلات_رانليب
            > (*الجدول).الحجم - حجم_الكلمة * 2) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع موضع_مدخلات_رانليب: غير_موقع =
        (*الجدول).موضع_المحتوى + حجم_الكلمة;
    دع موضع_حجم_النصوص: غير_موقع =
        موضع_مدخلات_رانليب + حجم_مدخلات_رانليب;
    دع حجم_النصوص: غير_موقع = اقرأ_كلمة_جدول_رموز_داروين(
        العرض,
        البايتات,
        موضع_حجم_النصوص
    );
    دع موضع_النصوص: غير_موقع = موضع_حجم_النصوص + حجم_الكلمة;
    لو (حجم_النصوص
        > (*الجدول).الحجم - حجم_الكلمة * 2 - حجم_مدخلات_رانليب) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع نهاية_النصوص: غير_موقع = موضع_النصوص + حجم_النصوص;
    دع عدد_الرموز: غير_موقع = حجم_مدخلات_رانليب / حجم_مدخل_رانليب;
    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_مدخل_رانليب: غير_موقع =
            موضع_مدخلات_رانليب + فهرس_الرمز * حجم_مدخل_رانليب;
        دع إزاحة_الاسم: غير_موقع = اقرأ_كلمة_جدول_رموز_داروين(
            العرض,
            البايتات,
            موضع_مدخل_رانليب
        );
        دع موضع_رأس_العضو: غير_موقع = اقرأ_كلمة_جدول_رموز_داروين(
            العرض,
            البايتات,
            موضع_مدخل_رانليب + حجم_الكلمة
        );
        لو (إزاحة_الاسم >= حجم_النصوص) {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        };
        دع حقيقة_العضو: حقيقة_عضو_أرشيف_داروين;
        طابق اقرأ_حقيقة_عضو_أرشيف_داروين(
            البايتات,
            موضع_رأس_العضو
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        }
        | اختيار.بعض(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        دع اسم_الرمز: متجه غ8;
        طابق اقرأ_اسم_رمز_أرشيف_داروين(
            البايتات,
            موضع_النصوص + إزاحة_الاسم,
            نهاية_النصوص
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
            );
        }
        | اختيار.بعض(الاسم) -> { اسم_الرمز := الاسم; };
        طابق سجل_رمز_عضو_أرشيف_كسولا(
            السياق,
            (*المدخل).المعرف,
            موضع_رأس_العضو,
            حقيقة_العضو.موضع_المحتوى,
            حقيقة_العضو.الحجم,
            &اسم_الرمز
        ) مع
        | نتيجة_فهرسة_رمز_أرشيف_ربط.نجح -> { }
        | نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(_) -> {
            أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
                خطأ_فهرسة_أرشيف_داروين.حل_رمز_غير_مكتمل()
            );
        };
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع نتيجة_فهرسة_أرشيف_داروين.نجح();
}

عام عرف فهرس_أرشيف_داروين_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_فهرسة_أرشيف_داروين {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!تحقق_توقيع_حاوية_أرشيف(البايتات)) {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.أرشيف_غير_صالح()
        );
    };
    دع جدول_الرموز: حقيقة_عضو_أرشيف_داروين;
    طابق ابحث_جدول_رموز_أرشيف_داروين(البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.جدول_رموز_غير_مدعوم()
        );
    }
    | اختيار.بعض(الحقيقة) -> { جدول_الرموز := الحقيقة; };
    طابق صنف_جدول_رموز_عضو_داروين(&جدول_الرموز.الاسم) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_فهرسة_أرشيف_داروين.خطأ(
            خطأ_فهرسة_أرشيف_داروين.جدول_رموز_غير_مدعوم()
        );
    }
    | اختيار.بعض(العرض) -> {
        أرجع فهرس_جدول_رموز_داروين(
            السياق,
            المدخل,
            &جدول_الرموز,
            العرض
        );
    };
}
