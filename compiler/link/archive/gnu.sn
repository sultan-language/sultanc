استورد compiler.link.context;
استورد compiler.link.model;
استورد compiler.link.resolution;
استورد compiler.link.archive.index_policy;
استورد compiler.link.archive.ar_container;

عام نوع خطأ_فهرسة_أرشيف_جنو =
    | أرشيف_غير_صالح
    | جدول_رموز_غير_مدعوم
    | حل_رمز_غير_مكتمل
;

عام نوع نتيجة_فهرسة_أرشيف_جنو =
    | نجح
    | خطأ بنوع خطأ_فهرسة_أرشيف_جنو
;

عرف اقرأ_غ32_كبير_أرشيف_جنو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع البايت_صفر: غير_موقع = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع) مثل غير_موقع;
    دع البايت_واحد: غير_موقع = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 1) مثل غير_موقع;
    دع البايت_اثنان: غير_موقع =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 2) مثل غير_موقع;
    دع البايت_ثلاثة: غير_موقع =
        اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + 3) مثل غير_موقع;
    أرجع البايت_صفر * 16777216
        + البايت_واحد * 65536
        + البايت_اثنان * 256
        + البايت_ثلاثة;
}

عرف اقرأ_غ64_كبير_أرشيف_جنو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غير_موقع {
    دع الجزء_العالي: غير_موقع = اقرأ_غ32_كبير_أرشيف_جنو(
        البايتات,
        الموضع
    );
    دع الجزء_المنخفض: غير_موقع = اقرأ_غ32_كبير_أرشيف_جنو(
        البايتات,
        الموضع + 4
    );
    أرجع الجزء_العالي * 4294967296 + الجزء_المنخفض;
}

عرف اسم_حقل_عضو_هو_جدول_رموز_جنو(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): منطقي {
    لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس) != 0x2F) {
        أرجع خطأ;
    };
    دع فهرس_الاسم: متغير غير_موقع = 1;
    بينما (فهرس_الاسم < 16) {
        لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + فهرس_الاسم) != 0x20) {
            أرجع خطأ;
        };
        فهرس_الاسم := فهرس_الاسم + 1;
    }
    أرجع صواب;
}

عرف اسم_حقل_عضو_هو_جدول_رموز_جنو_عريض(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): منطقي {
    دع الاسم: متجه غ8 = [0x2F, 0x53, 0x59, 0x4D, 0x36, 0x34, 0x2F];
    دع فهرس_الاسم: متغير غير_موقع = 0;
    بينما (فهرس_الاسم < (الطول(الاسم) مثل غير_موقع)) {
        لو (
            اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + فهرس_الاسم)
                != الاسم[فهرس_الاسم]
        ) {
            أرجع خطأ;
        };
        فهرس_الاسم := فهرس_الاسم + 1;
    }
    بينما (فهرس_الاسم < 16) {
        لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + فهرس_الاسم) != 0x20) {
            أرجع خطأ;
        };
        فهرس_الاسم := فهرس_الاسم + 1;
    }
    أرجع صواب;
}

عرف ابحث_جدول_رموز_أرشيف_جنو(
    البايتات: &متجه غ8
): اختيار حقيقة_عضو_حاوية_أرشيف {
    دع موضع_الرأس: متغير غير_موقع = 8;
    بينما (موضع_الرأس < (الطول(*البايتات) مثل غير_موقع)) {
        دع حقيقة_العضو: حقيقة_عضو_حاوية_أرشيف;
        طابق اقرأ_حقيقة_عضو_حاوية_أرشيف(البايتات, موضع_الرأس) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        لو (اسم_حقل_عضو_هو_جدول_رموز_جنو(البايتات, موضع_الرأس)) {
            أرجع اختيار.بعض(حقيقة_العضو);
        };
        لو (اسم_حقل_عضو_هو_جدول_رموز_جنو_عريض(
            البايتات,
            موضع_الرأس
        )) {
            أرجع اختيار.بعض(حقيقة_العضو);
        };
        موضع_الرأس := حقيقة_العضو.موضع_الرأس_التالي;
    }
    أرجع اختيار.لا_شيء();
}

عرف اقرأ_اسم_رمز_أرشيف_جنو(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
): اختيار متجه غ8 {
    لو (
        الموضع >= النهاية
            || النهاية > (الطول(*البايتات) مثل غير_موقع)
    ) {
        أرجع اختيار.لا_شيء();
    };
    دع الاسم: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = الموضع;
    بينما (فهرس_البايت < النهاية) {
        دع البايت: غ8 = اقرأ_بايت_حاوية_أرشيف(البايتات, فهرس_البايت);
        لو (البايت == 0) {
            أرجع اختيار.بعض(الاسم);
        };
        ألحق(الاسم, البايت);
        فهرس_البايت := فهرس_البايت + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف فهرس_أرشيف_جنو_في_سياق_الربط(
    السياق: &متغير سياق_ربط,
    المدخل: &مدخل_ربط
): نتيجة_فهرسة_أرشيف_جنو {
    دع البايتات: &متجه غ8 = &(*المدخل).البايتات;
    لو (!تحقق_توقيع_حاوية_أرشيف(البايتات)) {
        أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
            خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح()
        );
    };
    دع جدول_الرموز: حقيقة_عضو_حاوية_أرشيف;
    طابق ابحث_جدول_رموز_أرشيف_جنو(البايتات) مع
    | اختيار.لا_شيء -> {
        أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
            خطأ_فهرسة_أرشيف_جنو.جدول_رموز_غير_مدعوم()
        );
    }
    | اختيار.بعض(الحقيقة) -> { جدول_الرموز := الحقيقة; };

    دع جدول_عريض: منطقي = اسم_حقل_عضو_هو_جدول_رموز_جنو_عريض(
        البايتات,
        جدول_الرموز.موضع_الرأس
    );
    دع حجم_الكلمة: متغير غير_موقع = 4;
    لو (جدول_عريض) {
        حجم_الكلمة := 8;
    };
    لو (جدول_الرموز.الحجم < حجم_الكلمة) {
        أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
            خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح()
        );
    };

    دع عدد_الرموز: غير_موقع;
    لو (جدول_عريض) {
        عدد_الرموز := اقرأ_غ64_كبير_أرشيف_جنو(
            البايتات,
            جدول_الرموز.موضع_المحتوى
        );
    } وإلا {
        عدد_الرموز := اقرأ_غ32_كبير_أرشيف_جنو(
            البايتات,
            جدول_الرموز.موضع_المحتوى
        );
    };
    لو (
        عدد_الرموز
            > (جدول_الرموز.الحجم - حجم_الكلمة) / حجم_الكلمة
    ) {
        أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
            خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح()
        );
    };
    دع حجم_جدول_الإزاحات: غير_موقع = عدد_الرموز * حجم_الكلمة;
    دع موضع_الإزاحات: غير_موقع =
        جدول_الرموز.موضع_المحتوى + حجم_الكلمة;
    دع موضع_الأسماء: متغير غير_موقع =
        موضع_الإزاحات + حجم_جدول_الإزاحات;
    دع نهاية_جدول_الرموز: غير_موقع =
        جدول_الرموز.موضع_المحتوى + جدول_الرموز.الحجم;

    دع فهرس_الرمز: متغير غير_موقع = 0;
    بينما (فهرس_الرمز < عدد_الرموز) {
        دع موضع_إزاحة_العضو: غير_موقع =
            موضع_الإزاحات + فهرس_الرمز * حجم_الكلمة;
        دع موضع_رأس_العضو: غير_موقع;
        لو (جدول_عريض) {
            موضع_رأس_العضو := اقرأ_غ64_كبير_أرشيف_جنو(
                البايتات,
                موضع_إزاحة_العضو
            );
        } وإلا {
            موضع_رأس_العضو := اقرأ_غ32_كبير_أرشيف_جنو(
                البايتات,
                موضع_إزاحة_العضو
            );
        };
        دع حقيقة_العضو: حقيقة_عضو_حاوية_أرشيف;
        طابق اقرأ_حقيقة_عضو_حاوية_أرشيف(
            البايتات,
            موضع_رأس_العضو
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
                خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح()
            );
        }
        | اختيار.بعض(الحقيقة) -> { حقيقة_العضو := الحقيقة; };
        دع اسم_الرمز: متجه غ8;
        طابق اقرأ_اسم_رمز_أرشيف_جنو(
            البايتات,
            موضع_الأسماء,
            نهاية_جدول_الرموز
        ) مع
        | اختيار.لا_شيء -> {
            أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
                خطأ_فهرسة_أرشيف_جنو.أرشيف_غير_صالح()
            );
        }
        | اختيار.بعض(الاسم) -> { اسم_الرمز := الاسم; };
        طابق سجل_رمز_عضو_أرشيف_كسولا(
            السياق,
            (*المدخل).المعرف,
            موضع_رأس_العضو,
            حقيقة_العضو.موضع_المحتوى,
            حقيقة_العضو.الحجم,
            &اسم_الرمز
        ) مع
        | نتيجة_فهرسة_رمز_أرشيف_ربط.نجح -> { }
        | نتيجة_فهرسة_رمز_أرشيف_ربط.خطأ(_) -> {
            أرجع نتيجة_فهرسة_أرشيف_جنو.خطأ(
                خطأ_فهرسة_أرشيف_جنو.حل_رمز_غير_مكتمل()
            );
        };
        موضع_الأسماء :=
            موضع_الأسماء
                + (الطول(اسم_الرمز) مثل غير_موقع)
                + 1;
        فهرس_الرمز := فهرس_الرمز + 1;
    }
    أرجع نتيجة_فهرسة_أرشيف_جنو.نجح();
}
