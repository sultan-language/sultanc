عام نوع حقيقة_عضو_حاوية_أرشيف = {
    موضع_الرأس: غير_موقع,
    موضع_المحتوى: غير_موقع,
    الحجم: غير_موقع,
    موضع_الرأس_التالي: غير_موقع
};

عام عرف ضمن_حدود_حاوية_أرشيف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): منطقي {
    دع حجم_الأرشيف: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (الموضع > حجم_الأرشيف) {
        أرجع خطأ;
    };
    أرجع الحجم <= (حجم_الأرشيف - الموضع);
}

عام عرف اقرأ_بايت_حاوية_أرشيف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع
): غ8 {
    أرجع (*البايتات)[الموضع];
}

عام عرف تحقق_توقيع_حاوية_أرشيف(البايتات: &متجه غ8): منطقي {
    لو (!ضمن_حدود_حاوية_أرشيف(البايتات, 0, 8)) {
        أرجع خطأ;
    };
    أرجع اقرأ_بايت_حاوية_أرشيف(البايتات, 0) == 0x21
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 1) == 0x3C
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 2) == 0x61
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 3) == 0x72
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 4) == 0x63
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 5) == 0x68
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 6) == 0x3E
        && اقرأ_بايت_حاوية_أرشيف(البايتات, 7) == 0x0A;
}

عام عرف اقرأ_عدد_عشري_من_حقل_أرشيف(
    البايتات: &متجه غ8,
    الموضع: غير_موقع,
    الحجم: غير_موقع
): اختيار غير_موقع {
    لو (!ضمن_حدود_حاوية_أرشيف(البايتات, الموضع, الحجم)) {
        أرجع اختيار.لا_شيء();
    };
    دع القيمة: متغير غير_موقع = 0;
    دع وجد_رقما: متغير منطقي = خطأ;
    دع وصل_إلى_فراغ: متغير منطقي = خطأ;
    دع فهرس_البايت: متغير غير_موقع = 0;
    بينما (فهرس_البايت < الحجم) {
        دع البايت: غ8 = اقرأ_بايت_حاوية_أرشيف(البايتات, الموضع + فهرس_البايت);
        لو (البايت == 0x20) {
            وصل_إلى_فراغ := صواب;
        } وإلا {
            لو (وصل_إلى_فراغ || البايت < 0x30 || البايت > 0x39) {
                أرجع اختيار.لا_شيء();
            };
            وجد_رقما := صواب;
            القيمة := القيمة * 10 + ((البايت - 0x30) مثل غير_موقع);
        };
        فهرس_البايت := فهرس_البايت + 1;
    }
    لو (!وجد_رقما) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_حقيقة_عضو_حاوية_أرشيف(
    البايتات: &متجه غ8,
    موضع_الرأس: غير_موقع
): اختيار حقيقة_عضو_حاوية_أرشيف {
    لو (!ضمن_حدود_حاوية_أرشيف(البايتات, موضع_الرأس, 60)) {
        أرجع اختيار.لا_شيء();
    };
    لو (اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 58) != 0x60
        || اقرأ_بايت_حاوية_أرشيف(البايتات, موضع_الرأس + 59) != 0x0A) {
        أرجع اختيار.لا_شيء();
    };
    دع حجم_المحتوى: غير_موقع;
    طابق اقرأ_عدد_عشري_من_حقل_أرشيف(
        البايتات,
        موضع_الرأس + 48,
        10
    ) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الحجم) -> { حجم_المحتوى := الحجم; };
    دع موضع_المحتوى: غير_موقع = موضع_الرأس + 60;
    لو (!ضمن_حدود_حاوية_أرشيف(
        البايتات,
        موضع_المحتوى,
        حجم_المحتوى
    )) {
        أرجع اختيار.لا_شيء();
    };
    دع الموضع_بعد_المحتوى: غير_موقع = موضع_المحتوى + حجم_المحتوى;
    دع الحقيقة: حقيقة_عضو_حاوية_أرشيف = {
        موضع_الرأس: موضع_الرأس,
        موضع_المحتوى: موضع_المحتوى,
        الحجم: حجم_المحتوى,
        موضع_الرأس_التالي:
            الموضع_بعد_المحتوى + (الموضع_بعد_المحتوى % 2)
    };
    أرجع اختيار.بعض(الحقيقة);
}
