استورد compiler.backend.target.target_model;
استورد compiler.link.model;
استورد compiler.link.elf.target_policy;
استورد compiler.link.coff.target_policy;

// Linker families follow object formats, never code-generation providers.
// Every supported output is produced by SultanC's own linker for that format;
// no external linker program and no C runtime is part of any link. An output
// kind a format's linker does not produce is unsupported here, so the Driver
// reports it before code generation (link.target-output-unsupported).
// Previously ELF targets other than Linux x86_64/AArch64, ELF shared
// libraries and every WebAssembly and SPIR-V link that needed merging were
// reported as supported and handed to ld.lld, nld, avr-ld, msp430-ld,
// wasm-ld or spirv-link.
عام نوع هوية_مزود_ربط =
    | إلف
    | ماتشو
    | كوف
    | ويب_أسمبلي
    | سبير_في
    | غير_متاح
;

عام عرف مزود_ربط_للهدف(الهدف: &واصف_هدف): هوية_مزود_ربط {
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { أرجع هوية_مزود_ربط.إلف(); }
    | صيغة_كائن_هدف.ماتشو -> { أرجع هوية_مزود_ربط.ماتشو(); }
    | صيغة_كائن_هدف.كوف -> { أرجع هوية_مزود_ربط.كوف(); }
    | صيغة_كائن_هدف.ويب_أسمبلي -> { أرجع هوية_مزود_ربط.ويب_أسمبلي(); }
    | صيغة_كائن_هدف.سبير_في -> { أرجع هوية_مزود_ربط.سبير_في(); }
    | صيغة_كائن_هدف.بلا_كائن -> { أرجع هوية_مزود_ربط.غير_متاح(); };
}

عام عرف يدعم_مزود_الربط_تنفيذيا(الهدف: &واصف_هدف): منطقي {
    طابق مزود_ربط_للهدف(الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.ذراع_أربعة_وستون -> { }
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
        | _ -> { أرجع خطأ; };
        طابق (*الهدف).المنصة.المنصة مع
        | هوية_منصة.ماك_أو_إس -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | هوية_مزود_ربط.إلف -> {
        أرجع يستخدم_رابط_إلف_الداخلي(الهدف);
    }
    | هوية_مزود_ربط.كوف -> {
        أرجع يدعم_كوف_للهدف(الهدف);
    }
    | _ -> { أرجع خطأ; };
}

عرف يدعم_إلف_وحدة_هدف(الهدف: &واصف_هدف): منطقي {
    لو (!هدف_إلف_ليس_تنفيذيا_نظاميا(الهدف)) { أرجع خطأ; };
    طابق سياسة_إلف_للهدف(الهدف) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عرف يدعم_كوف_للهدف(الهدف: &واصف_هدف): منطقي {
    طابق سياسة_كوف_للهدف(الهدف) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

// Report only concrete serializers that exist in source. Adding a Target to
// the registry never advertises a linker output kind by itself.
عام عرف يدعم_مزود_الربط(
    الهدف: &واصف_هدف,
    الخرج: نوع_خرج_ربط
): منطقي {
    طابق الخرج مع
    | نوع_خرج_ربط.تنفيذي -> {
        أرجع يدعم_مزود_الربط_تنفيذيا(الهدف);
    }
    | نوع_خرج_ربط.مكتبة_مشتركة -> {
        طابق مزود_ربط_للهدف(الهدف) مع
        | هوية_مزود_ربط.ماتشو -> {
            طابق (*الهدف).المعمارية.الهوية مع
            | هوية_معمارية.ذراع_أربعة_وستون -> { }
            | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> { }
            | _ -> { أرجع خطأ; };
            طابق (*الهدف).المنصة.المنصة مع
            | هوية_منصة.ماك_أو_إس -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | هوية_مزود_ربط.كوف -> {
            أرجع يدعم_كوف_للهدف(الهدف);
        }
        | _ -> { أرجع خطأ; };
    }
    | نوع_خرج_ربط.كائن_مترابط -> {
        طابق مزود_ربط_للهدف(الهدف) مع
        | هوية_مزود_ربط.إلف -> {
            أرجع يستخدم_رابط_إلف_الداخلي(الهدف);
        }
        | هوية_مزود_ربط.ماتشو -> {
            لو ((*الهدف).نموذج_البيانات.عرض_المؤشر != 64) { أرجع خطأ; };
            لو ((*الهدف).نموذج_البيانات.ترتيب_البايت
                != ترتيب_بايت.صغير()) {
                أرجع خطأ;
            };
            طابق (*الهدف).المعمارية.الهوية مع
            | هوية_معمارية.ذراع_أربعة_وستون -> { أرجع صواب; }
            | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
                أرجع صواب;
            }
            | _ -> { أرجع خطأ; };
        }
        | هوية_مزود_ربط.كوف -> {
            أرجع يدعم_كوف_للهدف(الهدف);
        }
        | _ -> { أرجع خطأ; };
    }
    | نوع_خرج_ربط.وحدة_هدف -> {
        طابق مزود_ربط_للهدف(الهدف) مع
        | هوية_مزود_ربط.إلف -> {
            أرجع يدعم_إلف_وحدة_هدف(الهدف);
        }
        | هوية_مزود_ربط.ويب_أسمبلي -> { أرجع صواب; }
        | هوية_مزود_ربط.سبير_في -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}
