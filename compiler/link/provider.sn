استورد compiler.backend.target.target_model;

// Linker families follow object formats, never code-generation providers.
عام نوع هوية_مزود_ربط =
    | إلف
    | ماتشو
    | كوف
    | ويب_أسمبلي
    | سبير_في
    | غير_متاح
;

عام عرف مزود_ربط_للهدف(الهدف: &واصف_هدف): هوية_مزود_ربط {
    طابق (*الهدف).صيغة_الكائن مع
    | صيغة_كائن_هدف.إلف -> { أرجع هوية_مزود_ربط.إلف(); }
    | صيغة_كائن_هدف.ماتشو -> { أرجع هوية_مزود_ربط.ماتشو(); }
    | صيغة_كائن_هدف.كوف -> { أرجع هوية_مزود_ربط.كوف(); }
    | صيغة_كائن_هدف.ويب_أسمبلي -> { أرجع هوية_مزود_ربط.ويب_أسمبلي(); }
    | صيغة_كائن_هدف.سبير_في -> { أرجع هوية_مزود_ربط.سبير_في(); }
    | صيغة_كائن_هدف.بلا_كائن -> { أرجع هوية_مزود_ربط.غير_متاح(); };
}

// This reports implemented final-image support, not backend support. Native and
// LLVM therefore receive exactly the same answer for the same Target.
عام عرف يدعم_مزود_الربط_تنفيذيا(الهدف: &واصف_هدف): منطقي {
    طابق مزود_ربط_للهدف(الهدف) مع
    | هوية_مزود_ربط.ماتشو -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.ذراع_أربعة_وستون -> {
            طابق (*الهدف).المنصة.المنصة مع
            | هوية_منصة.ماك_أو_إس -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | هوية_مزود_ربط.إلف -> {
        طابق (*الهدف).المعمارية.الهوية مع
        | هوية_معمارية.إكس_ستة_وثمانون_أربعة_وستون -> {
            طابق (*الهدف).المنصة.المنصة مع
            | هوية_منصة.لينكس -> { أرجع صواب; }
            | _ -> { أرجع خطأ; };
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}
