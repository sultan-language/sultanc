استورد std.text.from_bytes;
استورد std.text.range;
استورد std.encoding.positions;
استورد std.encoding.utf8;

// Canonical source file owned by compiler/source.
// Byte offsets are the persistent identity; line/column views are derived from the line index.
عام نوع مصدر = {
    المعرف: طبيعي,
    الاسم: نص,
    المحتوى: نص,
    الطول: طبيعي
};

عام نوع إحداثي_مصدر = {
    السطر: ط32,
    العمود: ط32
};

عام عرف مصدر_جديد(
    المعرف: طبيعي,
    الاسم: نص,
    المحتوى: نص
): مصدر {
    دع العدد: طبيعي = الطول(المحتوى) مثل طبيعي;
    دع الناتج: مصدر = {
        المعرف: المعرف,
        الاسم: الاسم,
        المحتوى: المحتوى,
        الطول: العدد
    };
    أرجع الناتج;
}


عام عرف متاح_في_المصدر(
    المصدر: &مصدر,
    الموضع: طبيعي,
    العدد: طبيعي
): منطقي {
    لو (الموضع > (*المصدر).الطول) { أرجع خطأ; };
    أرجع العدد <= ((*المصدر).الطول - الموضع);
}

عام عرف بايت_المصدر(المصدر: &مصدر, الموضع: طبيعي): ط8 {
    أرجع (*المصدر).المحتوى[الموضع];
}

عام عرف إحداثي_مصدر_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): اختياري إحداثي_مصدر {
    لو (الإزاحة > (*المصدر).الطول || الإزاحة > (*الفهرس).طول_النص) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = الطول((*الفهرس).البدايات) مثل طبيعي;
    لو (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع البداية_بحث: متغير طبيعي = 0;
    دع النهاية_بحث: متغير طبيعي = العدد;
    طالما ((البداية_بحث + 1) < النهاية_بحث) {
        دع الوسط: طبيعي = البداية_بحث + ((النهاية_بحث - البداية_بحث) / 2);
        لو ((*الفهرس).البدايات[الوسط] <= الإزاحة) { البداية_بحث := الوسط; }
        وإلا { النهاية_بحث := الوسط; };
    }
    دع السطر0: طبيعي = البداية_بحث;
    دع بداية: طبيعي = (*الفهرس).البدايات[السطر0];
    دع ف: متغير طبيعي = بداية;
    دع العمود: متغير طبيعي = 0;
    طالما (ف < الإزاحة) {
        دع البايت: ط8 = (*المصدر).المحتوى[ف];
        لو (!بايت_استمرار_يوتيف8(البايت)) { العمود := العمود + 1; };
        ف := ف + 1;
    }
    دع السطر1: طبيعي = السطر0 + 1;
    دع رقم_السطر: ط32 = السطر1 مثل ط32;
    دع رقم_العمود: ط32 = العمود مثل ط32;
    دع الناتج: إحداثي_مصدر = {
        السطر: رقم_السطر,
        العمود: رقم_العمود
    };
    أرجع اختياري.موجود(الناتج);
}

// Non-cached fallback for callers that do not own a SourceMap. Normal compiler
// diagnostics/DWARF use the SourceMap-owned lazy line-index cache instead.
عام عرف إحداثي_مصدر_عند(
    المصدر: &مصدر,
    الإزاحة: طبيعي
): اختياري إحداثي_مصدر {
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}

عام عرف إحداثي_مصدر_يوتيف16_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): اختياري موضع_نصي_يوتيف16 {
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
        &(*المصدر).المحتوى, الفهرس, الإزاحة
    ) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { أرجع اختياري.موجود(الموضع); };
}

// LSP positions are UTF-16 code-unit based and remain a derived view of the same byte offset.
عام عرف إحداثي_مصدر_يوتيف16_عند(
    المصدر: &مصدر,
    الإزاحة: طبيعي
): اختياري موضع_نصي_يوتيف16 {
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_مصدر(القيمة: &مصدر): مصدر {
    دع الناتج: مصدر = {
        المعرف: (*القيمة).المعرف,
        الاسم: انسخ_نص(&(*القيمة).الاسم),
        المحتوى: انسخ_نص(&(*القيمة).المحتوى),
        الطول: (*القيمة).الطول
    };
    أرجع الناتج;
}
