استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.نطاق;
استورد المكتبة.ترميز.مواضع;
استورد المكتبة.ترميز.يوتيف8;
استورد compiler.source.span;

// Canonical source file owned by compiler/source.
// Byte offsets are the persistent identity; line/column views are derived from the line index.
عام نوع مصدر = {
    المعرف: طبيعي,
    الاسم: نص,
    المحتوى: نص,
    الطول: طبيعي
};

عام نوع إحداثي_مصدر = {
    السطر: ط32,
    العمود: ط32
};

عام عرف مصدر_جديد(
    المعرف: طبيعي,
    الاسم: نص,
    المحتوى: نص
): مصدر {
    // Every byte offset of a source is a 32-bit موضع.البايت (span.sn).
    ليكن العدد: طبيعي = ط32_متحقق(الطول(المحتوى) مثل طبيعي);
    ليكن الناتج: مصدر = {
        المعرف: المعرف,
        الاسم: الاسم,
        المحتوى: المحتوى,
        الطول: العدد
    };
    أرجع الناتج;
}

// A path with `/` between its parts on every host: a Windows host joins
// with `\`, and its file APIs take `/` as well, while no Windows file name
// holds a `\`. Source names (what diagnostics print) and Jisr's paths use
// this form, so they read and compare the same everywhere.
إذا (الهدف.المنصة == «windows») {
    عام عرف مسار_بشرطة_أمامية(المسار: &نص): نص {
        ليكن البايتات: متغير متجه ط8 = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المسار) مثل طبيعي)) {
            ليكن ب: ط8 = (*المسار)[ف];
            إذا (ب == 0x5C) { ألحق(البايتات, 0x2F); } وإلا { ألحق(البايتات, ب); };
            ف := ف + 1;
        }
        أرجع من_بايتات(&البايتات);
    }
}
إذا (الهدف.المنصة != «windows») {
    عام عرف مسار_بشرطة_أمامية(المسار: &نص): نص { أرجع انسخ_نص(المسار); }
}

عام عرف متاح_في_المصدر(
    المصدر: &مصدر,
    الموضع: طبيعي,
    العدد: طبيعي
): منطقي {
    إذا (الموضع > (*المصدر).الطول) { أرجع خطأ; };
    أرجع العدد <= ((*المصدر).الطول - الموضع);
}

عام عرف بايت_المصدر(المصدر: &مصدر, الموضع: طبيعي): ط8 {
    أرجع (*المصدر).المحتوى[الموضع];
}

عام عرف إحداثي_مصدر_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): اختياري إحداثي_مصدر {
    إذا (الإزاحة > (*المصدر).الطول || الإزاحة > (*الفهرس).طول_النص) { أرجع اختياري.لا_شيء(); };
    ليكن العدد: طبيعي = الطول((*الفهرس).البدايات) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    ليكن البداية_بحث: متغير طبيعي = 0;
    ليكن النهاية_بحث: متغير طبيعي = العدد;
    طالما ((البداية_بحث + 1) < النهاية_بحث) {
        ليكن الوسط: طبيعي = البداية_بحث + ((النهاية_بحث - البداية_بحث) / 2);
        إذا ((*الفهرس).البدايات[الوسط] <= الإزاحة) { البداية_بحث := الوسط; }
        وإلا { النهاية_بحث := الوسط; };
    }
    ليكن السطر0: طبيعي = البداية_بحث;
    ليكن بداية: طبيعي = (*الفهرس).البدايات[السطر0];
    ليكن ف: متغير طبيعي = بداية;
    ليكن العمود: متغير طبيعي = 0;
    طالما (ف < الإزاحة) {
        ليكن البايت: ط8 = (*المصدر).المحتوى[ف];
        إذا (!بايت_استمرار_يوتيف8(البايت)) { العمود := العمود + 1; };
        ف := ف + 1;
    }
    ليكن السطر1: طبيعي = السطر0 + 1;
    ليكن رقم_السطر: ط32 = السطر1 مثل ط32;
    ليكن رقم_العمود: ط32 = العمود مثل ط32;
    ليكن الناتج: إحداثي_مصدر = {
        السطر: رقم_السطر,
        العمود: رقم_العمود
    };
    أرجع اختياري.موجود(الناتج);
}

// Non-cached fallback for callers that do not own a SourceMap. Normal compiler
// diagnostics/DWARF use the SourceMap-owned lazy line-index cache instead.
عام عرف إحداثي_مصدر_عند(
    المصدر: &مصدر,
    الإزاحة: طبيعي
): اختياري إحداثي_مصدر {
    ليكن الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}

عام عرف إحداثي_مصدر_يوتيف16_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): اختياري موضع_نصي_يوتيف16 {
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
        &(*المصدر).المحتوى, الفهرس, الإزاحة
    ) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { أرجع اختياري.موجود(الموضع); };
}

// LSP positions are UTF-16 code-unit based and remain a derived view of the same byte offset.
عام عرف إحداثي_مصدر_يوتيف16_عند(
    المصدر: &مصدر,
    الإزاحة: طبيعي
): اختياري موضع_نصي_يوتيف16 {
    ليكن الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}

// Deep copies of owned values (one per Type; read the source through a
// reference and allocate independent storage).

عام عرف انسخ_مملوكا_مصدر(القيمة: &مصدر): مصدر {
    ليكن الناتج: مصدر = {
        المعرف: (*القيمة).المعرف,
        الاسم: انسخ_نص(&(*القيمة).الاسم),
        المحتوى: انسخ_نص(&(*القيمة).المحتوى),
        الطول: (*القيمة).الطول
    };
    أرجع الناتج;
}

// Whether a source's name ends with a path given with `/` (`core/process/panic.sn`),
// whichever separator the host joined it with: a Windows host names std's
// files `library\core\process/panic.sn`. The part before must end at a
// separator, so `xcore/process/panic.sn` is not `core/process/panic.sn`.
عام عرف اسم_مصدر_ينتهي_بمسار(الاسم: &نص, المسار: &نص): منطقي {
    ليكن عدد_المسار: طبيعي = الطول(*المسار) مثل طبيعي;
    ليكن عدد_الاسم: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (عدد_المسار == 0 || عدد_المسار > عدد_الاسم) { أرجع خطأ; };
    ليكن البداية: طبيعي = عدد_الاسم - عدد_المسار;
    إذا (البداية > 0) {
        ليكن قبل: ط8 = (*الاسم)[البداية - 1];
        إذا (قبل != 0x2F && قبل != 0x5C) { أرجع خطأ; };
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_المسار) {
        ليكن أ: ط8 = (*الاسم)[البداية + ف];
        ليكن ب: ط8 = (*المسار)[ف];
        ليكن متساويان: منطقي = أ == ب || (ب == 0x2F && أ == 0x5C);
        إذا (!متساويان) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}
