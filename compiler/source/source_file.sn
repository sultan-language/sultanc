استورد std.text.range;
استورد std.encoding.positions;
استورد std.encoding.utf8;

// Canonical source file owned by compiler/source.
// Byte offsets are the persistent identity; line/column views are derived from the line index.
عام نوع مصدر = {
    المعرف: غير_موقع,
    الاسم: نص,
    المحتوى: نص,
    الطول: غير_موقع
};

عام نوع إحداثي_مصدر = {
    السطر: غ32,
    العمود: غ32
};

عام عرف مصدر_جديد(
    المعرف: غير_موقع,
    الاسم: نص,
    المحتوى: نص
): مصدر {
    دع العدد: غير_موقع = الطول(المحتوى) مثل غير_موقع;
    دع الناتج: مصدر = {
        المعرف: المعرف,
        الاسم: الاسم,
        المحتوى: المحتوى,
        الطول: العدد
    };
    أرجع الناتج;
}


عام عرف متاح_في_المصدر(
    المصدر: &مصدر,
    الموضع: غير_موقع,
    العدد: غير_موقع
): منطقي {
    لو (الموضع > (*المصدر).الطول) { أرجع خطأ; };
    أرجع العدد <= ((*المصدر).الطول - الموضع);
}

عام عرف بايت_المصدر(المصدر: &مصدر, الموضع: غير_موقع): غ8 {
    أرجع (*المصدر).المحتوى[الموضع];
}

عام عرف إحداثي_مصدر_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: غير_موقع
): اختيار إحداثي_مصدر {
    لو (الإزاحة > (*المصدر).الطول || الإزاحة > (*الفهرس).طول_النص) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = الطول((*الفهرس).البدايات) مثل غير_موقع;
    لو (العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع البداية_بحث: متغير غير_موقع = 0;
    دع النهاية_بحث: متغير غير_موقع = العدد;
    بينما ((البداية_بحث + 1) < النهاية_بحث) {
        دع الوسط: غير_موقع = البداية_بحث + ((النهاية_بحث - البداية_بحث) / 2);
        لو ((*الفهرس).البدايات[الوسط] <= الإزاحة) { البداية_بحث := الوسط; }
        وإلا { النهاية_بحث := الوسط; };
    }
    دع السطر0: غير_موقع = البداية_بحث;
    دع بداية: غير_موقع = (*الفهرس).البدايات[السطر0];
    دع ف: متغير غير_موقع = بداية;
    دع العمود: متغير غير_موقع = 0;
    بينما (ف < الإزاحة) {
        دع البايت: غ8 = (*المصدر).المحتوى[ف];
        لو (!بايت_استمرار_يوتيف8(البايت)) { العمود := العمود + 1; };
        ف := ف + 1;
    }
    دع السطر1: غير_موقع = السطر0 + 1;
    دع رقم_السطر: غ32 = السطر1 مثل غ32;
    دع رقم_العمود: غ32 = العمود مثل غ32;
    دع الناتج: إحداثي_مصدر = {
        السطر: رقم_السطر,
        العمود: رقم_العمود
    };
    أرجع اختيار.بعض(الناتج);
}

// Non-cached fallback for callers that do not own a SourceMap. Normal compiler
// diagnostics/DWARF use the SourceMap-owned lazy line-index cache instead.
عام عرف إحداثي_مصدر_عند(
    المصدر: &مصدر,
    الإزاحة: غير_موقع
): اختيار إحداثي_مصدر {
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}

عام عرف إحداثي_مصدر_يوتيف16_عند_بفهرس(
    المصدر: &مصدر,
    الفهرس: &فهرس_سطور,
    الإزاحة: غير_موقع
): اختيار موضع_نصي_يوتيف16 {
    طابق إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
        &(*المصدر).المحتوى, الفهرس, الإزاحة
    ) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(الموضع) -> { أرجع اختيار.بعض(الموضع); };
}

// LSP positions are UTF-16 code-unit based and remain a derived view of the same byte offset.
عام عرف إحداثي_مصدر_يوتيف16_عند(
    المصدر: &مصدر,
    الإزاحة: غير_موقع
): اختيار موضع_نصي_يوتيف16 {
    دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*المصدر).المحتوى);
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(المصدر, &الفهرس, الإزاحة);
}
