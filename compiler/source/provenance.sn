استورد compiler.source.span;

// Compact target-neutral source provenance identity shared by MSIR, interpreter and backend.
عام نوع معرف_أصل_مصدر = {
    القيمة: غير_موقع
};

عام نوع أصل_مصدر = {
    المعرف: معرف_أصل_مصدر,
    النطاق: نطاق
};

عام نوع سجل_أصول_مصدر = {
    الأصول: متجه أصل_مصدر
};

عام عرف سجل_أصول_مصدر_جديد(): سجل_أصول_مصدر {
    دع الأصول: متجه أصل_مصدر = [];
    دع السجل: سجل_أصول_مصدر = { الأصول: الأصول };
    أرجع السجل;
}

عام عرف سجل_أصل_مصدر(
    السجل: &متغير سجل_أصول_مصدر,
    النطاق: نطاق
): معرف_أصل_مصدر {
    // Provenance IDs are append-only. Deduplicating by rescanning the growing
    // table turns source annotation into quadratic compiler work; DWARF does not
    // require identical spans to share an identity.
    دع العدد: غير_موقع = الطول((*السجل).الأصول) مثل غير_موقع;
    دع المعرف: معرف_أصل_مصدر = { القيمة: العدد };
    دع الأصل: أصل_مصدر = { المعرف: المعرف, النطاق: النطاق };
    ألحق((*السجل).الأصول, الأصل);
    أرجع المعرف;
}

عام عرف أصل_مصدر_بالمعرف(
    السجل: &سجل_أصول_مصدر,
    المعرف: معرف_أصل_مصدر
): اختيار أصل_مصدر {
    لو (المعرف.القيمة >= (الطول((*السجل).الأصول) مثل غير_موقع)) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض((*السجل).الأصول[المعرف.القيمة]);
}
