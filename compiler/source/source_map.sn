استورد compiler.source.source_file;
استورد compiler.source.span;
استورد std.text.from_bytes;
استورد std.encoding.positions;

// Compiler-wide source registry. It is the canonical owner of SourceID allocation
// and source lookup used by frontend, diagnostics, tooling and debug provenance.
عام نوع خريطة_مصادر = {
    المصادر: متجه مصدر,
    فهارس_السطور: متجه فهرس_سطور,
    فهارس_السطور_جاهزة: متجه منطقي,
    معرف_المصدر_التالي: غير_موقع
};

عام عرف خريطة_مصادر_جديدة(): خريطة_مصادر {
    دع المصادر: متجه مصدر = [];
    دع فهارس_السطور: متجه فهرس_سطور = [];
    دع الجاهزية: متجه منطقي = [];
    دع الخريطة: خريطة_مصادر = {
        المصادر: المصادر,
        فهارس_السطور: فهارس_السطور,
        فهارس_السطور_جاهزة: الجاهزية,
        معرف_المصدر_التالي: 0
    };
    أرجع الخريطة;
}

عام عرف أضف_مصدر_إلى_خريطة(
    الخريطة: &متغير خريطة_مصادر,
    الاسم: نص,
    المحتوى: نص
): غير_موقع {
    دع المعرف: غير_موقع = (*الخريطة).معرف_المصدر_التالي;
    (*الخريطة).معرف_المصدر_التالي := المعرف + 1;
    دع المصدر: مصدر = مصدر_جديد(المعرف, الاسم, المحتوى);
    ألحق((*الخريطة).المصادر, المصدر);
    دع بدايات_فارغة: متجه غير_موقع = [];
    دع فهرس_فارغ: فهرس_سطور = { البدايات: بدايات_فارغة, طول_النص: 0 };
    ألحق((*الخريطة).فهارس_السطور, فهرس_فارغ);
    ألحق((*الخريطة).فهارس_السطور_جاهزة, خطأ);
    أرجع المعرف;
}

عرف جهز_فهرس_سطور_مصدر(
    الخريطة: &متغير خريطة_مصادر,
    المعرف: غير_موقع
): منطقي {
    لو (المعرف >= (الطول((*الخريطة).المصادر) مثل غير_موقع)) { أرجع خطأ; };
    لو (المعرف >= (الطول((*الخريطة).فهارس_السطور) مثل غير_موقع)) { أرجع خطأ; };
    لو (المعرف >= (الطول((*الخريطة).فهارس_السطور_جاهزة) مثل غير_موقع)) { أرجع خطأ; };
    لو (!(*الخريطة).فهارس_السطور_جاهزة[المعرف]) {
        دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*الخريطة).المصادر[المعرف].المحتوى);
        (*الخريطة).فهارس_السطور[المعرف] := الفهرس;
        (*الخريطة).فهارس_السطور_جاهزة[المعرف] := صواب;
    };
    أرجع صواب;
}


عام عرف اسم_مصدر_من_الخريطة(
    الخريطة: &خريطة_مصادر,
    المعرف: غير_موقع
): اختيار نص {
    لو (المعرف >= (الطول((*الخريطة).المصادر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو ((*الخريطة).المصادر[المعرف].المعرف != المعرف) { أرجع اختيار.لا_شيء(); };
    دع مرجع_الاسم: &نص = &(*الخريطة).المصادر[المعرف].الاسم;
    دع الاسم: نص = *مرجع_الاسم;
    أرجع اختيار.بعض(الاسم);
}

عام عرف إحداثي_من_الخريطة(
    الخريطة: &متغير خريطة_مصادر,
    الموضع: موضع
): اختيار إحداثي_مصدر {
    لو (!جهز_فهرس_سطور_مصدر(الخريطة, الموضع.المصدر)) { أرجع اختيار.لا_شيء(); };
    لو ((*الخريطة).المصادر[الموضع.المصدر].المعرف != الموضع.المصدر) { أرجع اختيار.لا_شيء(); };
    أرجع إحداثي_مصدر_عند_بفهرس(
        &(*الخريطة).المصادر[الموضع.المصدر],
        &(*الخريطة).فهارس_السطور[الموضع.المصدر],
        الموضع.البايت
    );
}

عام عرف إحداثي_يوتيف16_من_الخريطة(
    الخريطة: &متغير خريطة_مصادر,
    الموضع: موضع
): اختيار موضع_نصي_يوتيف16 {
    لو (!جهز_فهرس_سطور_مصدر(الخريطة, الموضع.المصدر)) { أرجع اختيار.لا_شيء(); };
    لو ((*الخريطة).المصادر[الموضع.المصدر].المعرف != الموضع.المصدر) { أرجع اختيار.لا_شيء(); };
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(
        &(*الخريطة).المصادر[الموضع.المصدر],
        &(*الخريطة).فهارس_السطور[الموضع.المصدر],
        الموضع.البايت
    );
}

عام عرف مقتطف_من_الخريطة(
    الخريطة: &خريطة_مصادر,
    النطاق: &نطاق
): اختيار نص {
    لو ((*النطاق).البداية.المصدر >= (الطول((*الخريطة).المصادر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع معرف_المصدر: غير_موقع = (*النطاق).البداية.المصدر;
    لو ((*الخريطة).المصادر[معرف_المصدر].المعرف != معرف_المصدر) { أرجع اختيار.لا_شيء(); };
    لو ((*النطاق).النهاية.المصدر != (*الخريطة).المصادر[معرف_المصدر].المعرف || (*النطاق).البداية.البايت > (*الخريطة).المصادر[معرف_المصدر].الطول) {
        أرجع اختيار.لا_شيء();
    };
    دع البداية: متغير غير_موقع = (*النطاق).البداية.البايت;
    دع ابحث_للخلف: متغير منطقي = صواب;
    بينما (ابحث_للخلف && (البداية > 0)) {
        دع موضع_السابق: غير_موقع = البداية - 1;
        دع السابق: غ8 = (*الخريطة).المصادر[معرف_المصدر].المحتوى[موضع_السابق];
        لو ((السابق == 0x0A) || (السابق == 0x0D)) {
            ابحث_للخلف := خطأ;
        } وإلا {
            البداية := البداية - 1;
        };
    }
    دع النهاية: متغير غير_موقع = (*النطاق).البداية.البايت;
    دع ابحث_للأمام: متغير منطقي = صواب;
    بينما (ابحث_للأمام && (النهاية < (*الخريطة).المصادر[معرف_المصدر].الطول)) {
        دع الحالي: غ8 = (*الخريطة).المصادر[معرف_المصدر].المحتوى[النهاية];
        لو ((الحالي == 0x0A) || (الحالي == 0x0D)) {
            ابحث_للأمام := خطأ;
        } وإلا {
            النهاية := النهاية + 1;
        };
    }
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) { ألحق(البايتات, (*الخريطة).المصادر[معرف_المصدر].المحتوى[ف]); ف := ف + 1; }
    أرجع اختيار.بعض(من_بايتات(&البايتات));
}
