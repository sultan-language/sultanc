استورد compiler.source.source_file;
استورد compiler.source.span;
استورد std.text.from_bytes;
استورد std.encoding.positions;

// Compiler-wide source registry. It is the canonical owner of SourceID allocation
// and source lookup used by frontend, diagnostics, tooling and debug provenance.
// Generated text that stands for one construct the programmer wrote (the
// propagation expansion, frontend/desugar/propagation.sn): a diagnostic whose
// span lies inside المولد is reported at الأصل.
عام نوع إحالة_نص_مولد = {
    المولد: نطاق,
    الأصل: نطاق
};

عام نوع خريطة_مصادر = {
    المصادر: متجه مصدر,
    فهارس_السطور: متجه فهرس_سطور,
    فهارس_السطور_جاهزة: متجه منطقي,
    معرف_المصدر_التالي: طبيعي,
    الإحالات: متجه إحالة_نص_مولد
};

عام عرف خريطة_مصادر_جديدة(): خريطة_مصادر {
    دع المصادر: متجه مصدر = [];
    دع فهارس_السطور: متجه فهرس_سطور = [];
    دع الجاهزية: متجه منطقي = [];
    دع الإحالات: متجه إحالة_نص_مولد = [];
    دع الخريطة: خريطة_مصادر = {
        المصادر: المصادر,
        فهارس_السطور: فهارس_السطور,
        فهارس_السطور_جاهزة: الجاهزية,
        معرف_المصدر_التالي: 0,
        الإحالات: الإحالات
    };
    أرجع الخريطة;
}

عام عرف أضف_إحالة_نص_مولد(
    الخريطة: &متغير خريطة_مصادر,
    المولد: نطاق,
    الأصل: نطاق
): فراغ {
    دع الإحالة: إحالة_نص_مولد = { المولد: المولد, الأصل: الأصل };
    ألحق((*الخريطة).الإحالات, الإحالة);
}

// The span a diagnostic reports: a span inside generated text that stands
// for a written construct becomes that construct's span; any other span is
// returned unchanged.
عام عرف نطاق_الإبلاغ(الخريطة: &خريطة_مصادر, النطاق: نطاق): نطاق {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الخريطة).الإحالات) مثل طبيعي)) {
        دع المولد: نطاق = (*الخريطة).الإحالات[ف].المولد;
        لو (المولد.البداية.المصدر == النطاق.البداية.المصدر
            && المولد.البداية.البايت <= النطاق.البداية.البايت
            && النطاق.البداية.البايت < المولد.النهاية.البايت) {
            أرجع (*الخريطة).الإحالات[ف].الأصل;
        };
        ف := ف + 1;
    }
    أرجع النطاق;
}

عام عرف أضف_مصدر_إلى_خريطة(
    الخريطة: &متغير خريطة_مصادر,
    الاسم: نص,
    المحتوى: نص
): طبيعي {
    دع المعرف: طبيعي = (*الخريطة).معرف_المصدر_التالي;
    (*الخريطة).معرف_المصدر_التالي := المعرف + 1;
    دع المصدر: مصدر = مصدر_جديد(المعرف, الاسم, المحتوى);
    ألحق((*الخريطة).المصادر, المصدر);
    دع بدايات_فارغة: متجه طبيعي = [];
    دع فهرس_فارغ: فهرس_سطور = { البدايات: بدايات_فارغة, طول_النص: 0 };
    ألحق((*الخريطة).فهارس_السطور, فهرس_فارغ);
    ألحق((*الخريطة).فهارس_السطور_جاهزة, خطأ);
    أرجع المعرف;
}

// A compiler expansion (propagation, frontend/desugar/propagation.sn, and
// decorator expansion, frontend/annotations/decorators.sn) appends generated text after a source's own text: the new
// content starts with the old one, so every earlier byte position is
// unchanged and positions in the appended text map to lines after the
// original end. The line index is rebuilt on its next use.
عام عرف مدد_محتوى_مصدر_في_خريطة(
    الخريطة: &متغير خريطة_مصادر,
    المعرف: طبيعي,
    المحتوى_الممدد: نص
): منطقي {
    لو (المعرف >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع خطأ; };
    لو (المعرف >= (الطول((*الخريطة).فهارس_السطور_جاهزة) مثل طبيعي)) { أرجع خطأ; };
    لو ((الطول(المحتوى_الممدد) مثل طبيعي) < (*الخريطة).المصادر[المعرف].الطول) { أرجع خطأ; };
    (*الخريطة).المصادر[المعرف].الطول := الطول(المحتوى_الممدد) مثل طبيعي;
    (*الخريطة).المصادر[المعرف].المحتوى := المحتوى_الممدد;
    (*الخريطة).فهارس_السطور_جاهزة[المعرف] := خطأ;
    أرجع صواب;
}

عرف جهز_فهرس_سطور_مصدر(
    الخريطة: &متغير خريطة_مصادر,
    المعرف: طبيعي
): منطقي {
    لو (المعرف >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع خطأ; };
    لو (المعرف >= (الطول((*الخريطة).فهارس_السطور) مثل طبيعي)) { أرجع خطأ; };
    لو (المعرف >= (الطول((*الخريطة).فهارس_السطور_جاهزة) مثل طبيعي)) { أرجع خطأ; };
    لو (!(*الخريطة).فهارس_السطور_جاهزة[المعرف]) {
        دع الفهرس: فهرس_سطور = ابن_فهرس_السطور(&(*الخريطة).المصادر[المعرف].المحتوى);
        (*الخريطة).فهارس_السطور[المعرف] := الفهرس;
        (*الخريطة).فهارس_السطور_جاهزة[المعرف] := صواب;
    };
    أرجع صواب;
}


عام عرف اسم_مصدر_من_الخريطة(
    الخريطة: &خريطة_مصادر,
    المعرف: طبيعي
): اختياري نص {
    لو (المعرف >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    لو ((*الخريطة).المصادر[المعرف].المعرف != المعرف) { أرجع اختياري.لا_شيء(); };
    دع مرجع_الاسم: &نص = &(*الخريطة).المصادر[المعرف].الاسم;
    دع الاسم: نص = انسخ_نص(مرجع_الاسم);
    أرجع اختياري.موجود(الاسم);
}

عام عرف إحداثي_من_الخريطة(
    الخريطة: &متغير خريطة_مصادر,
    الموضع: موضع
): اختياري إحداثي_مصدر {
    لو (!جهز_فهرس_سطور_مصدر(الخريطة, الموضع.المصدر)) { أرجع اختياري.لا_شيء(); };
    لو ((*الخريطة).المصادر[الموضع.المصدر].المعرف != الموضع.المصدر) { أرجع اختياري.لا_شيء(); };
    أرجع إحداثي_مصدر_عند_بفهرس(
        &(*الخريطة).المصادر[الموضع.المصدر],
        &(*الخريطة).فهارس_السطور[الموضع.المصدر],
        الموضع.البايت
    );
}

عام عرف إحداثي_يوتيف16_من_الخريطة(
    الخريطة: &متغير خريطة_مصادر,
    الموضع: موضع
): اختياري موضع_نصي_يوتيف16 {
    لو (!جهز_فهرس_سطور_مصدر(الخريطة, الموضع.المصدر)) { أرجع اختياري.لا_شيء(); };
    لو ((*الخريطة).المصادر[الموضع.المصدر].المعرف != الموضع.المصدر) { أرجع اختياري.لا_شيء(); };
    أرجع إحداثي_مصدر_يوتيف16_عند_بفهرس(
        &(*الخريطة).المصادر[الموضع.المصدر],
        &(*الخريطة).فهارس_السطور[الموضع.المصدر],
        الموضع.البايت
    );
}

عام عرف مقتطف_من_الخريطة(
    الخريطة: &خريطة_مصادر,
    النطاق: &نطاق
): اختياري نص {
    لو ((*النطاق).البداية.المصدر >= (الطول((*الخريطة).المصادر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع معرف_المصدر: طبيعي = (*النطاق).البداية.المصدر;
    لو ((*الخريطة).المصادر[معرف_المصدر].المعرف != معرف_المصدر) { أرجع اختياري.لا_شيء(); };
    لو ((*النطاق).النهاية.المصدر != (*الخريطة).المصادر[معرف_المصدر].المعرف || (*النطاق).البداية.البايت > (*الخريطة).المصادر[معرف_المصدر].الطول) {
        أرجع اختياري.لا_شيء();
    };
    دع البداية: متغير طبيعي = (*النطاق).البداية.البايت;
    دع ابحث_للخلف: متغير منطقي = صواب;
    طالما (ابحث_للخلف && (البداية > 0)) {
        دع موضع_السابق: طبيعي = البداية - 1;
        دع السابق: ط8 = (*الخريطة).المصادر[معرف_المصدر].المحتوى[موضع_السابق];
        لو ((السابق == 0x0A) || (السابق == 0x0D)) {
            ابحث_للخلف := خطأ;
        } وإلا {
            البداية := البداية - 1;
        };
    }
    دع النهاية: متغير طبيعي = (*النطاق).البداية.البايت;
    دع ابحث_للأمام: متغير منطقي = صواب;
    طالما (ابحث_للأمام && (النهاية < (*الخريطة).المصادر[معرف_المصدر].الطول)) {
        دع الحالي: ط8 = (*الخريطة).المصادر[معرف_المصدر].المحتوى[النهاية];
        لو ((الحالي == 0x0A) || (الحالي == 0x0D)) {
            ابحث_للأمام := خطأ;
        } وإلا {
            النهاية := النهاية + 1;
        };
    }
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(البايتات, (*الخريطة).المصادر[معرف_المصدر].المحتوى[ف]); ف := ف + 1; }
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}
