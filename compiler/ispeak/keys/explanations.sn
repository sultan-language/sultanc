    | معرف_تشخيص.خطأ_نحوي -> { أرجع مفتاح_شرح.خطأ_نحوي(); }
    | معرف_تشخيص.تعبير_نحوي_غير_صالح -> { أرجع مفتاح_شرح.تعبير_نحوي_غير_صالح(); }
