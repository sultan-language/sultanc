    | بند_القيمة
    | بند_الاستبدال
    | بند_الفهرس
    | بند_الطول
    | بند_المجال
    | بند_النمط
    | بند_المسار
    | بند_الرمز
    | بند_النوع
    | بند_السياق
    | بند_المرحلة
    | بند_الهدف
    | بند_الدالة
    | بند_الكتلة
    | بند_التعليمة
    | بند_العملية
    | بند_البدائي
    | بند_المصدر
    | بند_الوجهة
    | بند_السبب
    | بند_متوقع_منفرد
    | بند_موجود_منفرد
    | بند_بداية_مقارنة
    | بند_وسط_مقارنة
;
