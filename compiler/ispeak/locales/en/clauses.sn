عام عرف مقدمة_بند_إنجليزية(البند: بند_سياق, المفتاح: اختياري مفتاح_رسالة_تشخيص): نص {
    طابق البند مع
    | بند_سياق.بند_القيمة -> { أرجع مقدمة_القيمة_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_الاستبدال -> { أرجع مقدمة_الاستبدال_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_الفهرس -> { أرجع مقدمة_الفهرس_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_الطول -> { أرجع «The length is »; }
    | بند_سياق.بند_المجال -> { أرجع «The relevant range is »; }
    | بند_سياق.بند_النمط -> { أرجع مقدمة_النمط_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_المسار -> { أرجع مقدمة_المسار_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_الرمز -> { أرجع مقدمة_الرمز_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_النوع -> { أرجع مقدمة_النوع_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_السياق -> { أرجع «This occurred in context »; }
    | بند_سياق.بند_المرحلة -> { أرجع «This occurred during phase »; }
    | بند_سياق.بند_الهدف -> { أرجع مقدمة_الهدف_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_الدالة -> { أرجع «The affected function is »; }
    | بند_سياق.بند_الكتلة -> { أرجع «The affected block is »; }
    | بند_سياق.بند_التعليمة -> { أرجع «The affected instruction is »; }
    | بند_سياق.بند_العملية -> { أرجع «The operation is »; }
    | بند_سياق.بند_البدائي -> { أرجع «The host primitive is »; }
    | بند_سياق.بند_المصدر -> { أرجع «The source value is »; }
    | بند_سياق.بند_الوجهة -> { أرجع «The destination value is »; }
    | بند_سياق.بند_السبب -> { أرجع مقدمة_السبب_المخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_متوقع_منفرد -> { أرجع مقدمة_المتوقع_المنفرد_إنجليزية(المفتاح); }
    | بند_سياق.بند_موجود_منفرد -> { أرجع مقدمة_الموجود_المنفرد_إنجليزية(المفتاح); }
    | بند_سياق.بند_بداية_مقارنة -> { أرجع بداية_مقارنة_مخصصة_إنجليزية(المفتاح); }
    | بند_سياق.بند_وسط_مقارنة -> { أرجع وسط_مقارنة_مخصصة_إنجليزية(المفتاح); };
}

// A boolean fact is the language's own literal, quoted as code: the Arabic
// literal for false is also the word for "error", so it is never bare prose.
عام عرف كلمة_منطقية_إنجليزية(الحالة: منطقي): نص {
    لو (الحالة) { أرجع «`true`»; };
    أرجع «`false`»;
}
