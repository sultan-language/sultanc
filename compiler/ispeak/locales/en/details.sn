استورد compiler.diagnostics.schema;

// English compiler-proven secondary wording; no catalog scan.

// Immutable language resources: longer prose is stored once, outside match arms.
عرف نص_تفصيل_مساعدة_أبلغ_عن_خلل_المترجم(): نص { أرجع «rerun with JSON diagnostics when reporting this compiler bug»; }
عرف نص_تفصيل_مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد(): نص { أرجع «add `()` before `;` to call it, or use `:= value` to assign to it»; }

عام عرف تفصيل_إنجليزي(المفتاح: مفتاح_صياغة): نص {
    طابق المفتاح مع
    | مفتاح_صياغة.تسمية_خطأ -> { أرجع «error»; }
    | مفتاح_صياغة.تسمية_تحذير -> { أرجع «warning»; }
    | مفتاح_صياغة.تسمية_ملاحظة -> { أرجع «note»; }
    | مفتاح_صياغة.تسمية_مساعدة -> { أرجع «help»; }
    | مفتاح_صياغة.تسمية_إصلاح -> { أرجع «fix»; }
    | مفتاح_صياغة.تسمية_أثر -> { أرجع «trace»; }
    | مفتاح_صياغة.تسمية_متعلق -> { أرجع «related»; }
    | مفتاح_صياغة.تسمية_متوقع -> { أرجع «expected»; }
    | مفتاح_صياغة.تسمية_موجود -> { أرجع «found»; }
    | مفتاح_صياغة.تسمية_قيمة -> { أرجع «value»; }
    | مفتاح_صياغة.تسمية_فهرس -> { أرجع «index»; }
    | مفتاح_صياغة.تسمية_طول -> { أرجع «length»; }
    | مفتاح_صياغة.تسمية_مجال -> { أرجع «range»; }
    | مفتاح_صياغة.تسمية_نمط -> { أرجع «pattern»; }
    | مفتاح_صياغة.تسمية_مسار -> { أرجع «path»; }
    | مفتاح_صياغة.تسمية_رمز -> { أرجع «symbol»; }
    | مفتاح_صياغة.تسمية_نوع -> { أرجع «type»; }
    | مفتاح_صياغة.تسمية_سياق -> { أرجع «context»; }
    | مفتاح_صياغة.تسمية_مرحلة -> { أرجع «phase»; }
    | مفتاح_صياغة.تسمية_هدف -> { أرجع «target»; }
    | مفتاح_صياغة.تسمية_دالة -> { أرجع «function»; }
    | مفتاح_صياغة.تسمية_كتلة -> { أرجع «block»; }
    | مفتاح_صياغة.تسمية_تعليمة -> { أرجع «instruction»; }
    | مفتاح_صياغة.تسمية_عملية -> { أرجع «operation»; }
    | مفتاح_صياغة.تسمية_بدائي -> { أرجع «primitive»; }
    | مفتاح_صياغة.تسمية_مصدر_قيمة -> { أرجع «source»; }
    | مفتاح_صياغة.تسمية_وجهة_قيمة -> { أرجع «destination»; }
    | مفتاح_صياغة.تسمية_سبب -> { أرجع «cause»; }
    | مفتاح_صياغة.تسمية_مصدر -> { أرجع «source»; }
    | مفتاح_صياغة.تسمية_استخدام_غير_صالح -> { أرجع «invalid use»; }
    | مفتاح_صياغة.تسمية_أصل_النقل -> { أرجع «value moved here»; }
    | مفتاح_صياغة.تسمية_أصل_التحرير -> { أرجع «resource released here»; }
    | مفتاح_صياغة.تسمية_المالك_الأصلي -> { أرجع «original owner»; }
    | مفتاح_صياغة.تسمية_استعارة_متعارضة -> { أرجع «conflicting borrow»; }
    | مفتاح_صياغة.تسمية_موضع_متوقع -> { أرجع «expected here»; }
    | مفتاح_صياغة.تسمية_اكتشاف_المحلل -> { أرجع «parser discovered the problem here»; }
    | مفتاح_صياغة.تسمية_هل_تقصد -> { أرجع «did you mean»; }
    | مفتاح_صياغة.تسمية_استبدال -> { أرجع «replacement»; }
    | مفتاح_صياغة.تسمية_فاصلة_منقوطة_في_غير_موضعها -> { أرجع «this `;` is misplaced»; }
    | مفتاح_صياغة.تسمية_وجهة_فاصلة_منقوطة -> { أرجع «move `;` here»; }
    | مفتاح_صياغة.تسمية_عبارة_بلا_عملية -> { أرجع «this expression is used by itself»; }
    | مفتاح_صياغة.تسمية_نمط_غير_قابل_للوصول -> { أرجع «unreachable pattern»; }
    | مفتاح_صياغة.تسمية_تغطية_نمط_سابقة -> { أرجع «covered by an earlier pattern»; }
    | مفتاح_صياغة.تسمية_سياق_مرتبط -> { أرجع «related context»; }
    | مفتاح_صياغة.تسمية_تصريح_غير_قابل_للتغيير -> { أرجع «declared here without `mutable`»; }
    | مفتاح_صياغة.تسمية_إصلاح_آلي -> { أرجع «machine-applicable»; }
    | مفتاح_صياغة.تسمية_إصلاح_بعناصر_نائبة -> { أرجع «has placeholders»; }
    | مفتاح_صياغة.تسمية_إصلاح_تقريبي -> { أرجع «may be incorrect»; }
    | مفتاح_صياغة.تسمية_إصلاح_غير_محدد -> { أرجع «unspecified»; }
    | مفتاح_صياغة.مساعدة_اعرض_خيارات_المترجم -> { أرجع «run `sultanc --help` for available options»; }
    | مفتاح_صياغة.مساعدة_اعرض_أهداف_المترجم -> { أرجع «run `sultanc targets` to list available targets»; }
    | مفتاح_صياغة.مساعدة_تحقق_من_قيمة_الخيار -> { أرجع «check the option value and try again»; }
    | مفتاح_صياغة.مساعدة_أبلغ_عن_خلل_المترجم -> { أرجع نص_تفصيل_مساعدة_أبلغ_عن_خلل_المترجم(); }
    | مفتاح_صياغة.مساعدة_أضف_فاصلة_منقوطة -> { أرجع «insert `;` after this construct»; }
    | مفتاح_صياغة.مساعدة_انقل_فاصلة_منقوطة -> { أرجع «move `;` before the closing `}`»; }
    | مفتاح_صياغة.مساعدة_استبدل_تهجئة_الكلمة_المشتبهة -> { أرجع «replace this spelling with the suggested keyword»; }
    | مفتاح_صياغة.مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد -> { أرجع نص_تفصيل_مساعدة_أكمل_العبارة_باستدعاء_أو_إسناد(); }
    | مفتاح_صياغة.مساعدة_أضف_نوع_ناتج_دالة -> { أرجع «add a return type after `:` (for example, `i32`)»; }
    | مفتاح_صياغة.مساعدة_اجعل_التصريح_عاما -> { أرجع «declare the name `public` in its module to use it from another module»; }
    | مفتاح_صياغة.ملاحظة_التصريح_السابق -> { أرجع «the previous declaration is shown as related source»; }
    | مفتاح_صياغة.قيمة_منطقية_صواب -> { أرجع «`true`»; }
    | مفتاح_صياغة.قيمة_منطقية_خطأ -> { أرجع «`false`»; };
}
