    | مفتاح_شرح.نوع_حجة_غير_مطابق -> { أرجع نص_شرح_نوع_حجة_غير_مطابق(); }
    | مفتاح_شرح.نوع_إرجاع_غير_مطابق -> { أرجع نص_شرح_نوع_إرجاع_غير_مطابق(); }
