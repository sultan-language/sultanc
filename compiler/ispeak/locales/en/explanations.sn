    | مفتاح_شرح.تعارض_مصدر_وحدة -> { أرجع نص_شرح_تعارض_مصدر_وحدة(); }
    | مفتاح_شرح.تصدير_انتقائي_غير_موجود -> { أرجع نص_شرح_تصدير_انتقائي_غير_موجود(); }
    | مفتاح_شرح.نقطة_دخول_مفقودة -> { أرجع نص_شرح_نقطة_دخول_مفقودة(); }
    | مفتاح_شرح.نقطة_دخول_بتوقيع_غير_صالح -> { أرجع نص_شرح_نقطة_دخول_بتوقيع_غير_صالح(); }
    | مفتاح_شرح.تصريح_خاص_غير_متاح -> { أرجع نص_شرح_تصريح_خاص_غير_متاح(); }
    | مفتاح_شرح.نوع_تكراري_لانهائي -> { أرجع نص_شرح_نوع_تكراري_لانهائي(); }
    | مفتاح_شرح.فك_مرجع_غير_مؤشر -> { أرجع نص_شرح_فك_مرجع_غير_مؤشر(); }
    | مفتاح_شرح.أخذ_عنوان_غير_قيمة_يسرى -> { أرجع نص_شرح_أخذ_عنوان_غير_قيمة_يسرى(); }
    | مفتاح_شرح.حقل_سجل_مفقود -> { أرجع نص_شرح_حقل_سجل_مفقود(); }
