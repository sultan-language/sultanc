    | مفتاح_شرح.صيغة_تشخيص_مترجم_غير_صالحة -> { أرجع نص_شرح_صيغة_تشخيص_مترجم_غير_صالحة(); }
    | مفتاح_شرح.لون_تشخيص_مترجم_غير_صالح -> { أرجع نص_شرح_لون_تشخيص_مترجم_غير_صالح(); }
    | مفتاح_شرح.مصدر_رئيسي_متعدد -> { أرجع نص_شرح_مصدر_رئيسي_متعدد(); }
