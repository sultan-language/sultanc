عام عرف رسالة_إنجليزية(المفتاح: مفتاح_رسالة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_رسالة_تشخيص.تشخيص(الخطأ) -> { أرجع رسالة_خطأ_إنجليزية(الخطأ); }
    | مفتاح_رسالة_تشخيص.سبب(السبب) -> { أرجع رسالة_سبب_إنجليزية(السبب); };
}
