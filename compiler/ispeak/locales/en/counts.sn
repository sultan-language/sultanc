استورد std.text.builder;
استورد std.text.number;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.format.quote;
استورد compiler.ispeak.grammar.plural;
استورد compiler.ispeak.grammar.counts;

// English count phrases: word forms and sentence order for counted facts.

// English count agreement: 0 -> "no <plural>" (style rule), CLDR one -> "1 <singular>",
// CLDR other -> "n <plural>".
عرف مفرد_معدود_إنجليزي(المعدود: معدود_رسالة): نص {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع «argument»; }
    | معدود_رسالة.حمولة -> { أرجع «payload»; };
}

عرف جمع_معدود_إنجليزي(المعدود: معدود_رسالة): نص {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع «arguments»; }
    | معدود_رسالة.حمولة -> { أرجع «payloads»; };
}

عام عرف ألحق_عددا_معدودا_إنجليزية(الباني: &متغير باني_نص, العدد: طبيعي, المعدود: معدود_رسالة): منطقي {
    إذا (العدد == 0) {
        دع النفي: نص = «no »;
        إذا (!ألحق_قطعة(الباني, &النفي)) { أرجع خطأ; };
        دع جمع_صفر: نص = جمع_معدود_إنجليزي(المعدود);
        أرجع ألحق_قطعة(الباني, &جمع_صفر);
    };
    دع الرقم: نص = طبيعي_إلى_نص(العدد);
    دع المسافة: نص = « »;
    إذا (!ألحق_قطعة(الباني, &الرقم)) { أرجع خطأ; };
    إذا (!ألحق_قطعة(الباني, &المسافة)) { أرجع خطأ; };
    طابق فئة_جمع_العدد(لغة_تشخيص.الإنجليزية(), العدد) مع
    | فئة_جمع.واحد -> {
        دع المفرد: نص = مفرد_معدود_إنجليزي(المعدود);
        أرجع ألحق_قطعة(الباني, &المفرد);
    }
    | _ -> {
        دع الجمع: نص = جمع_معدود_إنجليزي(المعدود);
        أرجع ألحق_قطعة(الباني, &الجمع);
    };
}

// "The function expects 2 arguments, but the call passes 3 arguments."
عرف أول_مقارنة_عدد_إنجليزية(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «The function expects »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «The primitive operation expects »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «The constructor has »; };
}

عرف ثاني_مقارنة_عدد_إنجليزية(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «, but the call passes »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «, but the call passes »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «, but the pattern binds »; };
}

عام عرف ألحق_جملة_مقارنة_عدد_إنجليزية(
    الباني: &متغير باني_نص,
    المتوقع: طبيعي,
    الموجود: طبيعي,
    الإطار: إطار_مقارنة_عدد
): منطقي {
    دع البداية: نص = أول_مقارنة_عدد_إنجليزية(الإطار);
    دع الوسط: نص = ثاني_مقارنة_عدد_إنجليزية(الإطار);
    دع المعدود: معدود_رسالة = معدود_إطار(الإطار);
    إذا (!ألحق_قطعة(الباني, &البداية)) { أرجع خطأ; };
    إذا (!ألحق_عددا_معدودا_إنجليزية(الباني, المتوقع, المعدود)) { أرجع خطأ; };
    إذا (!ألحق_قطعة(الباني, &الوسط)) { أرجع خطأ; };
    أرجع ألحق_عددا_معدودا_إنجليزية(الباني, الموجود, المعدود);
}
