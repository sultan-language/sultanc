    | مفتاح_نص_مترجم.اسم_وحدة_مكتبة_غير_صالح -> { أرجع «lib.path source filename is not a valid module identifier»; }
    | مفتاح_نص_مترجم.تعذر_فحص_هدف_مرادف_استيراد -> { أرجع «canonical imports-alias target could not be inspected»; }
    | مفتاح_نص_مترجم.هدف_مرادف_استيراد_مفقود -> { أرجع «canonical imports-alias target does not exist»; }
    | مفتاح_نص_مترجم.تعذر_فحص_تصادم_مرادف -> { أرجع «imports-alias spelling could not be inspected for collision»; }
    | مفتاح_نص_مترجم.مرادف_يتعارض_مع_مسار_أصلي -> { أرجع نص_واجهة_مرادف_يتعارض_مع_مسار_أصلي(); }
    | مفتاح_نص_مترجم.مرادف_يشير_إلى_مسارين -> { أرجع «one imports-alias spelling names two canonical paths»; }
