استورد compiler.ispeak.keys.surface;

// Source-backed user-facing wording; no numeric/string lookup or initialization.

// Immutable language resources: longer prose is stored once, outside match arms.
عرف نص_واجهة_التباس_جذر_الاعتمادية(): نص { أرجع «dependency root spelling is ambiguous in the importing package»; }
عرف نص_واجهة_تعارض_جذر_المكتبة_في_الاعتمادية(): نص { أرجع «standard-library root spelling conflicts in dependency scope»; }
عرف نص_واجهة_مدخلات_مصدر_من_بيانات_مختلفة(): نص { أرجع «explicit source inputs do not belong to one package manifest»; }
عام عرف نص_واجهة_مصدر_رئيسي_بلا_بيان_مع_مصدر_مقيد(): نص { أرجع «primary source is manifest-free but an additional input belongs to a package manifest»; }
عرف نص_واجهة_مدخلات_من_حزم_مختلفة(): نص { أرجع «explicit source inputs belong to different package manifests»; }
عرف نص_واجهة_إعداد_بيان_معروف_غير_مدعوم(): نص { أرجع «manifest setting is recognized but not supported by this compiler yet»; }
عرف نص_واجهة_مرادف_يتعارض_مع_مسار_أصلي(): نص { أرجع «imports-alias spelling conflicts with a canonical source path»; }
عرف نص_واجهة_بيان_حزمة_بالاسم_المطلوب_مفقود(): نص { أرجع «package manifest does not exist with the required exact filename»; }

عام عرف نص_واجهة_إنجليزي(المفتاح: مفتاح_نص_مترجم): نص {
    طابق المفتاح مع
    | مفتاح_نص_مترجم.عنوان_المساعدة -> { أرجع "SultanC compiler\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الاستخدام -> { أرجع "Usage:\n"; }
    | مفتاح_نص_مترجم.سطر_استخدام_المترجم -> { أرجع "    sultanc <source> [options]\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الأوامر -> { أرجع "Commands:\n"; }
    | مفتاح_نص_مترجم.أمر_التشغيل -> { أرجع "    run <source> [args...] Run using the SultanC interpreter\n"; }
    | مفتاح_نص_مترجم.توضيح_وسائط_التشغيل -> { أرجع "                           Arguments after <source> are passed unchanged\n"; }
    | مفتاح_نص_مترجم.أمر_التحقق -> { أرجع "    check <source>         Check without normal executable output\n                           With --target <target>, check for that target (default: the host)\n"; }
    | مفتاح_نص_مترجم.أمر_الأهداف -> { أرجع "    targets                List supported targets\n"; }
    | مفتاح_نص_مترجم.أمر_الشرح -> { أرجع "    explain <code>         Explain a SultanC diagnostic\n"; }
    | مفتاح_نص_مترجم.أمر_المساعدة -> { أرجع "    help                   Show help\n"; }
    | مفتاح_نص_مترجم.أمر_الإصدار -> { أرجع "    version                Show version\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الخيارات_الشائعة -> { أرجع "Common options:\n"; }
    | مفتاح_نص_مترجم.خيار_المخرج -> { أرجع "    -o <file>              Output path\n"; }
    | مفتاح_نص_مترجم.خيار_الهدف -> { أرجع "    -t, --target <target>  Target platform\n"; }
    | مفتاح_نص_مترجم.خيار_الكائن -> { أرجع "    -c                     Emit object file\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الخيارات_المتقدمة -> { أرجع "Advanced options:\n"; }
    | مفتاح_نص_مترجم.خيار_الخلفية -> { أرجع "    -b, --backend <name>   native | llvm\n"; }
    | مفتاح_نص_مترجم.خيار_نوع_الإخراج -> { أرجع "    --emit=<kind>          exe | obj | shared | reloc | module | asm | llvm-ir\n"; }
    | مفتاح_نص_مترجم.خيار_اللغة -> { أرجع "    --lang=<lang>          auto | ar | en\n"; }
    | مفتاح_نص_مترجم.خيار_التشخيص -> { أرجع "    --diagnostic-format=<format>  human | short | json\n"; }
    | مفتاح_نص_مترجم.خيار_الألوان -> { أرجع "    --color=<policy>       auto | always | never\n"; }
    | مفتاح_نص_مترجم.خيار_مصدر_الوحدة -> { أرجع "    --module-source=<module>=<file>\n"; }
    | مفتاح_نص_مترجم.توضيح_مصدر_الوحدة -> { أرجع "                           Compile <file> as the source of logical <module>\n"; }
    | مفتاح_نص_مترجم.خيار_مكتبة_الربط -> { أرجع "    -l <name>              Link the library lib<name> (for example -l c)\n"; }
    | مفتاح_نص_مترجم.خيار_دليل_المكتبات -> { أرجع "    -L <dir>               Search <dir> for -l libraries first\n"; }
    | مفتاح_نص_مترجم.تسمية_الخلفيات -> { أرجع «backends:»; }
    | مفتاح_نص_مترجم.اعتماد_مسار_بلا_هدف_مكتبة -> { أرجع «path dependency does not declare an importable [lib] target»; }
    | مفتاح_نص_مترجم.تعارض_جذر_مصدر_الحزمة -> { أرجع «package source root conflicts with an existing root»; }
    | مفتاح_نص_مترجم.تعارض_تهجئة_جذر_الحزمة -> { أرجع «package root spelling conflicts with another binding»; }
