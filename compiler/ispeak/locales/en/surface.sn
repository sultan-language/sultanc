    | مفتاح_نص_مترجم.قيم_أسماء_حزمة_غير_نصية -> { أرجع «package.names values must be strings»; }
    | مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة -> { أرجع «package root spelling is not a valid source identifier»; }
    | مفتاح_نص_مترجم.مفتاح_مرادف_استيراد_غير_صالح -> { أرجع «imports-alias key is not a valid dotted import path»; }
    | مفتاح_نص_مترجم.قيمة_مرادف_استيراد_ليست_خريطة -> { أرجع «imports-alias value must be an inline language map»; }
    | مفتاح_نص_مترجم.تسمية_لغة_مرادف_فارغة -> { أرجع «imports-alias language label cannot be empty»; }
    | مفتاح_نص_مترجم.قيم_لغة_مرادف_غير_نصية -> { أرجع «imports-alias language values must be strings»; }
    | مفتاح_نص_مترجم.تهجئة_مرادف_استيراد_غير_صالحة -> { أرجع «imports-alias spelling is not a valid dotted import path»; }
