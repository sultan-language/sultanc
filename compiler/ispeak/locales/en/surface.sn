    | مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_المشروع -> { أرجع «standard-library root spelling conflicts in project scope»; }
    | مفتاح_نص_مترجم.تعارض_جذر_الحزمة_مع_نفسه -> { أرجع «package root spelling conflicts in its own scope»; }
    | مفتاح_نص_مترجم.مدخلات_مصدر_من_بيانات_مختلفة -> { أرجع نص_واجهة_مدخلات_مصدر_من_بيانات_مختلفة(); }
    | مفتاح_نص_مترجم.مصدر_رئيسي_بلا_بيان_مع_مصدر_مقيد -> { أرجع نص_واجهة_مصدر_رئيسي_بلا_بيان_مع_مصدر_مقيد(); }
    | مفتاح_نص_مترجم.مدخلات_من_حزم_مختلفة -> { أرجع نص_واجهة_مدخلات_من_حزم_مختلفة(); }
    | مفتاح_نص_مترجم.حقل_بيان_مطلوب_مفقود -> { أرجع «required manifest field is missing»; }
    | مفتاح_نص_مترجم.حقل_بيان_ليس_نصا -> { أرجع «manifest field must be a string»; }
    | مفتاح_نص_مترجم.حقل_بيان_ليس_مصفوفة_نصوص -> { أرجع «manifest field must be an array of strings»; }
    | مفتاح_نص_مترجم.مصفوفة_بيان_بعنصر_غير_نصي -> { أرجع «manifest array contains a non-string value»; }
    | مفتاح_نص_مترجم.إعداد_بيان_معروف_غير_مدعوم -> { أرجع نص_واجهة_إعداد_بيان_معروف_غير_مدعوم(); }
    | مفتاح_نص_مترجم.حقل_بيان_غير_معروف -> { أرجع «unknown package manifest field»; }
