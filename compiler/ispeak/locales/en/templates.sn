        // "constructor `Color.Red` is called with `()`: `Color.Red()`", or
        // "constructor `Shape.Circle` takes 1 argument: `Shape.Circle(...)`".
        طابق الحقائق مع
        | حقائق_رسالة.منشئ_غير_مستدعى(القيم) -> {
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = «constructor `»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.المنشئ)) { أرجع اختياري.لا_شيء(); };
            إذا (القيم.الحمولات == 0) {
                ليكن الوسط: نص = «` is called with `()`: `»;
                إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &الوسط)) { أرجع اختياري.لا_شيء(); };
            } وإلا {
                ليكن يأخذ: نص = «` takes »;
                ليكن الوسط_بحجج: نص = «: `»;
                إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &يأخذ)) { أرجع اختياري.لا_شيء(); };
                إذا (!ألحق_عددا_معدودا_إنجليزية(&متغير الباني, القيم.الحمولات, معدود_رسالة.حجة())) { أرجع اختياري.لا_شيء(); };
                إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &الوسط_بحجج)) { أرجع اختياري.لا_شيء(); };
            };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.المنشئ)) { أرجع اختياري.لا_شيء(); };
            ليكن النهاية: متغير نص = «()`»;
            إذا (القيم.الحمولات > 0) { النهاية := «(...)`»; };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &النهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.منشئ_غير_مستدعى())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
