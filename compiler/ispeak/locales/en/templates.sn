// English templates for identities with typed payload facts. The locale owns
// word order and wording; quoting and counting come from the shared helpers.
// سياق_تشخيص facts never reach this table: ispeak.sn routes them to the composer.

عام عرف رسالة_إنجليزية_بحجج(المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة): اختياري نص {
    طابق المفتاح مع
    | مفتاح_رسالة_تشخيص.تشخيص(المعرف) -> { أرجع رسالة_إنجليزية_بقالب(المعرف, المفتاح, الحقائق); }
    // A reason has no template: only its fixed text, for a payload without facts.
    | مفتاح_رسالة_تشخيص.سبب(_) -> { أرجع رسالة_ثابتة_بلا_حجج(المفتاح, &الحقائق); };
}

// Every identity is listed, so a new one decides here whether it needs a template.
عرف رسالة_إنجليزية_بقالب(المعرف: معرف_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة): اختياري نص {
    طابق المعرف مع
    | معرف_تشخيص.اسم_غير_معروف -> {
        طابق الحقائق مع
        | حقائق_رسالة.اسم_غير_معروف(القيم) -> {
            ليكن الاسم: &نص = &القيم.الاسم;
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = «unknown name: `»;
            ليكن النهاية: نص = «`»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, الاسم)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &النهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.نوعان_غير_متوافقين -> {
        طابق الحقائق مع
        | حقائق_رسالة.عامل_غير_معرف(القيم) -> {
            ليكن العامل: &نص = &القيم.العامل;
            ليكن النوع: &نص = &القيم.النوع;
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = «`»;
            ليكن الوسط: نص = «` is not defined for `»;
            ليكن النهاية: نص = «`»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, العامل)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &الوسط)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, النوع)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &النهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | حقائق_رسالة.نوعان_غير_متوافقين(القيم) -> {
            ليكن المتوقع: &نص = &القيم.المتوقع;
            ليكن الموجود: &نص = &القيم.الموجود;
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = «expected `»;
            ليكن الوسط: نص = «`, found `»;
            ليكن النهاية: نص = «`»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, المتوقع)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &الوسط)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, الموجود)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &النهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.عدد_حجج_غير_مطابق -> {
        طابق الحقائق مع
        | حقائق_رسالة.عدد_حجج_غير_مطابق(القيم) -> {
            ليكن المتوقع: طبيعي = القيم.المتوقع;
            ليكن الموجود: طبيعي = القيم.الموجود;
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = «expected »;
            ليكن الوسط: نص = «, found »;
            ليكن نص_الموجود: نص = طبيعي_إلى_نص(الموجود);
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_عددا_معدودا_إنجليزية(&متغير الباني, المتوقع, معدود_رسالة.حجة())) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &الوسط)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &نص_الموجود)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.خيار_مترجم_غير_معروف -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.خيار_مترجم_غير_معروف());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.خيار_مترجم_غير_معروف())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.قيمة_خيار_مترجم_مفقودة -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.قيمة_خيار_مترجم_مفقودة());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.قيمة_خيار_مترجم_مفقودة())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.معامل_موضعي_غير_متوقع -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.معامل_موضعي_غير_متوقع());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.معامل_موضعي_غير_متوقع())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.مصدر_رئيسي_متعدد -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.مصدر_رئيسي_متعدد());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, «: `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.مصدر_رئيسي_متعدد())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.هدف_مترجم_غير_معروف -> {
        طابق الحقائق مع
        | حقائق_رسالة.نص_محدد(القيم) -> {
            ليكن أساس: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.هدف_مترجم_غير_معروف());
            أرجع نسق_نصا_محددا(&أساس, &القيم.القيمة, « `»);
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.هدف_مترجم_غير_معروف())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة -> {
        طابق الحقائق مع
        | حقائق_رسالة.ربط_إل_إل_في_إم(القيم) -> {
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن المقدمة: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة());
            ليكن فاصل: نص = «: `»;
            ليكن وسط: نص = «`, `»;
            ليكن نهاية: نص = «`»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &المقدمة)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &فاصل)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.الهدف)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &وسط)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.الرمز)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &نهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.مكتبة_إل_إل_في_إم_للهدف_مفقودة())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول -> {
        طابق الحقائق مع
        | حقائق_رسالة.ربط_إل_إل_في_إم(القيم) -> {
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن المقدمة: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول());
            ليكن فاصل: نص = «: `»;
            ليكن وسط: نص = «`, `»;
            ليكن نهاية: نص = «`»;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &المقدمة)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &فاصل)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.الرمز)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &وسط)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.الهدف)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &نهاية)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.رمز_إل_إل_في_إم_غير_محلول())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.فشل_وقت_الترجمة_مطلوب -> {
        طابق الحقائق مع
        | حقائق_رسالة.فشل_وقت_الترجمة(القيم) -> {
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن المقدمة: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.فشل_وقت_الترجمة_مطلوب());
            ليكن فاصل: نص = «: »;
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &المقدمة)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &فاصل)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &القيم.الرسالة)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        }
        | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_إنجليزية(معرف_تشخيص.فشل_وقت_الترجمة_مطلوب())); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    }
    | معرف_تشخيص.رسم_حزم_غير_صالح -> {
        طابق الحقائق مع
        | حقائق_رسالة.بيان_حزمة(القيم) -> {
            ليكن الباني: متغير باني_نص = أنشئ_باني_نص();
            ليكن البداية: نص = رسالة_خطأ_إنجليزية(معرف_تشخيص.رسم_حزم_غير_صالح());
            ليكن فاصل: نص = «: `»;
            ليكن نهاية: نص = «`»;
            إذا (!ألحق_قطعة(&متغير الباني, &البداية)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_قطعة(&متغير الباني, &فاصل)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_حقيقة_مقتبسة(&متغير الباني, &القيم.المسار)) { أرجع اختياري.لا_شيء(); };
            إذا (!ألحق_قطعة(&متغير الباني, &نهاية)) { أرجع اختياري.لا_شيء(); };
            طابق القيم.البايت مع
            | اختياري.موجود(الفهرس) -> {
                ليكن فاصل_البايت: نص = «, byte »;
                ليكن الرقم: نص = طبيعي_إلى_نص(الفهرس);
                إذا (!ألحق_قطعة(&متغير الباني, &فاصل_البايت)) { أرجع اختياري.لا_شيء(); };
                إذا (!ألحق_قطعة(&متغير الباني, &الرقم)) { أرجع اختياري.لا_شيء(); };
            }
            | _ -> { };
