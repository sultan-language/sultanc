استورد compiler.runtime.failure_identity;

// Arabic text printed by a compiled program when it fails at runtime.
عام عرف عنوان_فشل_تشغيل_عربي(): نص {
    أرجع «خطأ وقت التشغيل»;
}

عام عرف نص_فشل_تشغيل_عربي(المفتاح: هوية_فشل_تشغيل): نص {
    طابق المفتاح مع
    | هوية_فشل_تشغيل.تجاوز_حدود -> { أرجع «الفهرس خارج الحدود»; }
    | هوية_فشل_تشغيل.وسيط_خارج_المدى -> { أرجع «الوسيط خارج المدى المسموح»; }
    | هوية_فشل_تشغيل.عملية_غير_صالحة -> { أرجع «عملية غير صالحة»; }
    | هوية_فشل_تشغيل.إدخال_إخراج -> { أرجع «فشل في الإدخال أو الإخراج»; };
}
