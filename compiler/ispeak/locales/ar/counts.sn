استورد std.text.builder;
استورد std.text.number;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.format.quote;
استورد compiler.ispeak.grammar.plural;
استورد compiler.ispeak.grammar.counts;

// Arabic count phrases: word forms and sentence order for counted facts.

// Arabic count agreement (العدد والمعدود) with digits, keyed by the CLDR category.
// The count is the object of a verb, so the dual is accusative (حجتين):
// zero -> negated verb «لا تتوقع أي حجة»; one -> singular + «واحدة/واحدا»;
// two -> dual; few (3..10) -> digits + plural; many and other -> digits + singular.
عرف مفرد_معدود_عربي(المعدود: معدود_رسالة): نص {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع «حجة»; }
    | معدود_رسالة.حمولة -> { أرجع «حمولة»; };
}

عرف مثنى_منصوب_معدود_عربي(المعدود: معدود_رسالة): نص {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع «حجتين»; }
    | معدود_رسالة.حمولة -> { أرجع «حمولتين»; };
}

عرف جمع_معدود_عربي(المعدود: معدود_رسالة): نص {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع «حجج»; }
    | معدود_رسالة.حمولة -> { أرجع «حمولات»; };
}

عرف مؤنث_معدود_عربي(المعدود: معدود_رسالة): منطقي {
    طابق المعدود مع
    | معدود_رسالة.حجة -> { أرجع صواب; }
    | معدود_رسالة.حمولة -> { أرجع صواب; };
}

// Subject and verb of each side of the sentence; the verb agrees with its subject.
عرف فاعل_أول_عدد_عربي(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «الدالة »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «العملية البدائية »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «المنشئ »; };
}

عرف فعل_أول_عدد_عربي(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «تتوقع »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «تتوقع »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «يحمل »; };
}

عرف فاعل_ثان_عدد_عربي(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «النداء »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «النداء »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «النمط »; };
}

عرف فعل_ثان_عدد_عربي(الإطار: إطار_مقارنة_عدد): نص {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع «يمرر »; }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع «يمرر »; }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع «يربط »; };
}

// One side: «الدالة تتوقع حجتين» or «الدالة لا تتوقع أي حجة».
عرف ألحق_جانب_عدد_عربية(
    الباني: &متغير باني_نص,
    الفاعل: نص,
    الفعل: نص,
    العدد: طبيعي,
    المعدود: معدود_رسالة
): منطقي {
    لو (!ألحق_قطعة(الباني, &الفاعل)) { أرجع خطأ; };
    دع الفئة: فئة_جمع = فئة_جمع_العدد(لغة_تشخيص.العربية(), العدد);
    طابق الفئة مع
    | فئة_جمع.صفر -> {
        دع النفي: نص = «لا »;
        دع كلمة_أي: نص = «أي »;
        دع المفرد_المنفي: نص = مفرد_معدود_عربي(المعدود);
        لو (!ألحق_قطعة(الباني, &النفي)) { أرجع خطأ; };
        لو (!ألحق_قطعة(الباني, &الفعل)) { أرجع خطأ; };
        لو (!ألحق_قطعة(الباني, &كلمة_أي)) { أرجع خطأ; };
        أرجع ألحق_قطعة(الباني, &المفرد_المنفي);
    }
    | _ -> { };
    لو (!ألحق_قطعة(الباني, &الفعل)) { أرجع خطأ; };
    طابق الفئة مع
    | فئة_جمع.واحد -> {
        دع المفرد_واحد: نص = مفرد_معدود_عربي(المعدود);
        دع الواحد: متغير نص = « واحدا»;
        لو (مؤنث_معدود_عربي(المعدود)) { الواحد := « واحدة»; };
        لو (!ألحق_قطعة(الباني, &المفرد_واحد)) { أرجع خطأ; };
        أرجع ألحق_قطعة(الباني, &الواحد);
    }
    | فئة_جمع.اثنان -> {
        دع المثنى: نص = مثنى_منصوب_معدود_عربي(المعدود);
        أرجع ألحق_قطعة(الباني, &المثنى);
    }
    | _ -> { };
    دع الرقم: نص = طبيعي_إلى_نص(العدد);
    دع المسافة: نص = « »;
    لو (!ألحق_قطعة(الباني, &الرقم)) { أرجع خطأ; };
    لو (!ألحق_قطعة(الباني, &المسافة)) { أرجع خطأ; };
    طابق الفئة مع
    | فئة_جمع.قليل -> {
        دع الجمع: نص = جمع_معدود_عربي(المعدود);
        أرجع ألحق_قطعة(الباني, &الجمع);
    }
    | _ -> {
        دع المفرد: نص = مفرد_معدود_عربي(المعدود);
        أرجع ألحق_قطعة(الباني, &المفرد);
    };
}

// «الدالة تتوقع حجتين، لكن النداء يمرر 3 حجج.»
عام عرف ألحق_جملة_مقارنة_عدد_عربية(
    الباني: &متغير باني_نص,
    المتوقع: طبيعي,
    الموجود: طبيعي,
    الإطار: إطار_مقارنة_عدد
): منطقي {
    دع الوسط: نص = «، لكن »;
    دع المعدود: معدود_رسالة = معدود_إطار(الإطار);
    لو (!ألحق_جانب_عدد_عربية(الباني, فاعل_أول_عدد_عربي(الإطار), فعل_أول_عدد_عربي(الإطار), المتوقع, المعدود)) { أرجع خطأ; };
    لو (!ألحق_قطعة(الباني, &الوسط)) { أرجع خطأ; };
    أرجع ألحق_جانب_عدد_عربية(الباني, فاعل_ثان_عدد_عربي(الإطار), فعل_ثان_عدد_عربي(الإطار), الموجود, المعدود);
}
