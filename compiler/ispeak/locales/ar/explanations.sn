عام عرف نص_شرح_رمز_إل_إل_في_إم_غير_محلول(): نص { أرجع «مكتبة libLLVM المختارة لا توفر رمز واجهة LLVM C المطلوب.»; }
عام عرف نص_شرح_فشل_وقت_الترجمة_مطلوب(): نص { أرجع «رفضت شفرة وقت الترجمة مدخلاتها. صحح المشكلة الموصوفة في التشخيص.»; }
عام عرف نص_شرح_سمة_تصريح_غير_مدعومة(): نص { أرجع «معالج السمات الحالي لا يدعم سمة التصريح هذه.»; }
عام عرف نص_شرح_نقل_من_مرجع(): نص { أرجع «نُقلت قيمة مملوكة من خلف مرجع. استعرها بـ & أو انسخها صراحة بـ استنسخ(&القيمة).»; }
عام عرف نص_شرح_هدف_لا_يدعم_الميزة(): نص { أرجع «يفتقر الهدف المختار إلى ميزة يحتاجها البرنامج. اختر هدفا آخر أو تجنب هذه الميزة.»; }
عام عرف نص_شرح_بناء_غير_مدعوم_في_الخلفية(): نص { أرجع «لا تستطيع هذه الخلفية ترجمة هذا البناء بعد. جرّب الخلفية الأخرى أو أعد كتابة الشفرة.»; }
عام عرف نص_شرح_مدى_ترميز_متجاوز(): نص { أرجع «قفزة أو إزاحة أو ثابت أبعد أو أكبر مما تسمح به تعليمة الآلة. قسّم الدوال الكبيرة.»; }
عام عرف نص_شرح_رمز_ربط_غير_معرف(): نص { أرجع «رمز مستخدم غير معرّف في أي مدخل مربوط. اربط المكتبة التي تعرّفه.»; }
عام عرف نص_شرح_رمز_دخول_ربط_مفقود(): نص { أرجع «ينقص المخرج رمز البدء الذي يطلبه الهدف (مثل `_start`)، وعادة يغيب كائن بدء التشغيل أو مكتبة وقت التشغيل.»; }
عام عرف نص_شرح_رمز_ربط_مكرر(): نص { أرجع «يعرّف مدخلان الرمز نفسه. احذف أحد التعريفين أو اجعل أحدهما خاصا.»; }
عام عرف نص_شرح_موفر_وقت_تشغيل_مفقود(): نص { أرجع «يفتقر وقت تشغيل الهدف إلى خدمة يستخدمها البرنامج. اختر هدفا يوفرها.»; }
عام عرف نص_شرح_نفاد_ذاكرة_المترجم(): نص { أرجع «نفدت ذاكرة المترجم. وفّر ذاكرة أو ترجم برنامجا أصغر.»; }
عام عرف نص_شرح_رمز_ربط_بنوع_غير_متطابق(): نص { أرجع «عُرّف رمز بنوع مثل البيانات واستُخدم بنوع آخر مثل الدالة. اجعل التعريف والاستخدام متفقين.»; }
عام عرف نص_شرح_رمز_خارجي_بتوقيعين(): نص { أرجع «تصريحات رمز الربط الخارجي الواحد تلزمها أنواع معاملات وناتج واحدة. أبقِ تصريحا خارجيا واحدا وصِل إلى غيره بدوال عادية.»; }
عام عرف نص_شرح_رمز_خارجي_غير_مدعوم(): نص { أرجع «لا يستطيع الرابط ربط هذا الرمز الخارجي للهدف. وفّره من مكتبة مدعومة.»; }
عام عرف نص_شرح_إعادة_توطين_غير_مدعومة(): نص { أرجع «يحتاج المخرج إعادة توطين لا تعبر عنها صيغة الكائن. جرّب خلفية أو هدفا آخر.»; }
عام عرف نص_شرح_صيغة_كائن_غير_مدعومة_للهدف(): نص { أرجع «لا يمكن كتابة ملفات كائنية بهذه الصيغة لهذا الهدف. اختر هدفا أو خلفية مدعومة.»; }
عام عرف نص_شرح_مخرج_ربط_غير_مدعوم(): نص { أرجع «لا يستطيع الرابط إنتاج هذا المخرج للهدف. اختر نوع مخرج أو هدفا آخر.»; }
عام عرف نص_شرح_مكتبة_ربط_غير_موجودة(): نص { أرجع «لم يُعثر على مكتبة -l في أدلة -L ولا في أدلة مكتبات الهدف. أضف دليلها بالخيار -L أو مرر ملفها.»; }
عام عرف نص_شرح_مدخل_ربط_غير_مدعوم(): نص { أرجع «مدخل الربط ليس كائنا ولا أرشيفا ولا مكتبة يقرؤها رابط الهدف، ولا يُقرأ ملف .tbd إلا لـmacOS وiOS. أزله أو مرر مكتبة الهدف.»; }
عام عرف نص_شرح_مكتبة_تفسير_ساكنة_فقط(): نص { أرجع «لا يحمّل المفسر أرشيفا ساكنا في البرنامج وهو يعمل. ابنِ ملفا تنفيذيا يربط الأرشيف، أو وفّر المكتبة المشتركة.»; }
عام عرف نص_شرح_اعتمادية_جت_غير_محلولة(): نص { أرجع «لم يعد sultanc يصدره؛ يبلغ سوباكس عن أخطاء البيان والاعتماديات.»; }
عام عرف نص_شرح_خريطة_اعتماديات_غير_صالحة(): نص { أرجع «لم يعد sultanc يصدره؛ يبلغ سوباكس عن أخطاء البيان والاعتماديات.»; }
عام عرف نص_شرح_رسم_حزم_غير_صالح(): نص { أرجع «تعذر استعمال رسم الحزم المعطى بالخيار --package-graph. يكتبه سوباكس: شغّل `supax check` أو `supax build`.»; }
عام عرف نص_شرح_مكتبة_قياسية_غير_موجودة(): نص { أرجع «يبحث المترجم عن دليل مكتبة فيه std/ في $SULTANC_STD وفي ./library وبجواره، ولم يجده في أي منها.»; }
عام عرف نص_شرح_ملف_غير_منسق(): نص { أرجع «وجد `sultanc fmt --check` ملف مصدر يختلف ترتيبه عن الترتيب القانوني. شغّل `sultanc fmt` عليه؛ التنسيق لا يغير إلا المسافات.»; }
عام عرف نص_شرح_وحدة_معلنة_بلا_ابن(): نص { أرجع «يعطي تصريح `وحدة` تهجئات لابن في مجلده، باسمه على القرص: ملف NAME.sn أو مجلد NAME بجوار ملف الجذر. صحح الاسم أو احذف التصريح.»; }
عام عرف نص_شرح_تهجئة_وحدة_مشتركة(): نص { أرجع «يسمي الاستيراد ابن المجلد باسمه أو بإحدى تهجئاته، فالتهجئة تسمي ابنا واحدا ولا تكون اسم ابن آخر. أعط كل ابن تهجئاته.»; }
عام عرف نص_شرح_تهجئة_وحدة_محجوزة(): نص { أرجع «تُكتب تهجئة الوحدة في مسارات الاستيراد، ولا تقع فيها كلمة محجوزة في اللغة. اختر تهجئة ليست كلمة محجوزة.»; }
عام عرف نص_شرح_تصريح_وحدة_خارج_ملف_الجذر(): نص { أرجع «تُعلن تهجئات أبناء المجلد في ملف جذره FOLDER/FOLDER.sn، أو في ملف جذر الحزمة SOURCE_ROOT/PACKAGE.sn. انقل التصريح إليه.»; }
عام عرف نص_شرح_مكتبة_تفسير_بلا_اسم_تثبيت(): نص { أرجع «على macOS يذكر ملف `.tbd` اسم التثبيت الذي تُحمَّل منه المكتبة. وهذا الملف لا يذكره فلا شيء يُحمَّل. مرر ملف `.dylib` نفسه.»; }
عام عرف نص_شرح_مكتبة_تفسير_غير_محملة(): نص { أرجع «يحمّل `run` كل مكتبة -l بمحمّل النظام قبل بدء البرنامج، وتعذر تحميل هذه للسبب المذكور. تحقق أنها مكتبة مشتركة لهذه المنصة.»; }
عام عرف نص_شرح_مترجم_سي_لغير_المضيف(): نص { أرجع «مع SULTANC_C_COMPILER=cc يترجم مترجم C في النظام ملفات .c للمضيف فقط. ألغِ المتغير ليترجمها جسر لأي هدف.»; }
عام عرف نص_شرح_فشل_مترجم_سي(): نص { أرجع «مع SULTANC_C_COMPILER=cc فشل مترجم C في النظام في هذا الملف، ورسائله تسبق هذا. أصلحه أو ألغِ المتغير ليترجمه جسر.»; }
عام عرف نص_شرح_مكتبة_سي_غير_موجودة(): نص { أرجع «يربط استيراد C مكتبة C على Linux وFreeBSD وAndroid، ولا يحويها أي مجلد مكتبات، فيمضي الربط بدونها. أضف مجلدها بالخيار -L.»; }
عام عرف نص_شرح_قيمة_متغير_بيئة_غير_مقبولة(): نص { أرجع «يقرأ المترجم SULTANC_COMPTIME_BUDGET عددا عشريا موجبا، ويُسمح فيه بالفاصل `_`. أصلح المتغير أو ألغِه.»; }
عام عرف نص_شرح_نوع_معتم_بالقيمة(): نص { أرجع «النوع المعتم بلا حقول ولا حجم، فلا تُخزن له قيمة ولا تُمرر ولا تُرجع. وحده المؤشر الخام إليه يحمل قيمة.»; }
عام عرف نص_شرح_نوع_معتم_حجة_نوع(): نص { أرجع «يستعمل المثيل العام معامل نوعه بالقيمة (نسخ أو فك أو حجم أو محلي أو حاوية)، والنوع المعتم بلا قيمة ولا حجم.»; }
عام عرف نص_شرح_فك_مؤشر_معتم(): نص { أرجع «الذاكرة خلف مؤشر إلى نوع معتم بلا نوع يُقرأ أو يُكتب، حتى داخل غير_آمن.»; }
عام عرف نص_شرح_حقل_عبر_مؤشر_معتم(): نص { أرجع «النوع المعتم لا يعلن حقولا؛ لا يعرف محتواه إلا الشيفرة التي تعرّفه.»; }
عام عرف نص_شرح_حساب_مؤشر_معتم(): نص { أرجع «الفهرسة `p[i]` تخطو بالمؤشر بحجم العنصر، والنوع المعتم بلا حجم.»; }
عام عرف نص_شرح_واجهة_استدعاء_غير_متاحة_للهدف(): نص { أرجع «لا تتوفر في الهدف قواعد استدعاء لهذه الشفرة. اختر هدفا يعرّفها.»; }
عام عرف نص_شرح_حد_صيغة_كائن_متجاوز(): نص { أرجع «المخرج أكبر مما تسمح به صيغة ملفه. قلل حجم الشفرة أو البيانات أو قسّم البرنامج.»; }
عام عرف نص_شرح_حد_وقت_الترجمة_متجاوز(): نص { أرجع «طال تنفيذ شفرة وقت الترجمة أو تعمق تكرارها أو كثر تخصيصها. بسّطها.»; }
عام عرف نص_شرح_سلسلة_تنسيق_غير_صالحة(): نص { أرجع «تفحص سلسلة التنسيق الحرفية مقابل وسائطها وقت الترجمة كما يفعل format! في Rust. صحح الموضع أو الوسائط.»; }
عام عرف نص_شرح_أثر_ممنوع_وقت_الترجمة(): نص { أرجع «لا يجوز لشفرة وقت الترجمة تنفيذ إدخال وإخراج أو آثار خارجية. انقل هذا العمل إلى وقت التشغيل.»; }
عام عرف نص_شرح_فشل_تنفيذ_وقت_الترجمة(): نص { أرجع «فشلت شفرة وقت الترجمة أو توقفت بفخ أثناء تنفيذها. صحح العملية الفاشلة المبلغ عنها.»; }
عام عرف نص_شرح_عملية_غير_مدعومة_وقت_الترجمة(): نص { أرجع «يمكن تنفيذ دوال السلطان والعمليات المدعومة فقط وقت الترجمة. انقل هذا إلى وقت التشغيل.»; }
عام عرف نص_شرح_ناتج_وقت_الترجمة_غير_ثابت(): نص { أرجع «يجب أن تعيد شفرة وقت الترجمة ثابتا مستقلا من النوع المتوقع.»; }
عام عرف نص_شرح_تخطيط_غير_متاح_وقت_الترجمة(): نص { أرجع «استعلامات الحجم والمحاذاة تحتاج نوعا ثُبّت تخطيطه للهدف.»; }
عام عرف نص_شرح_عدد_حجج_وقت_الترجمة_غير_مطابق(): نص { أرجع «مرر قيمة واحدة لكل معامل من معاملات وقت الترجمة في الدالة.»; }
عام عرف نص_شرح_نداء_خارجي_تفسير_غير_مدعوم(): نص { أرجع «لا يستطيع المفسر استدعاء هذه الدالة الخارجية. ابنِ ملفا تنفيذيا أصليا لتشغيلها.»; }
عام عرف نص_شرح_بدائي_آلة_تفسير_غير_مدعوم(): نص { أرجع «لا يستطيع المفسر تنفيذ هذه العملية الخاصة بالآلة. ابنِ ملفا تنفيذيا أصليا لتشغيلها.»; }
عام عرف نص_شرح_خلل_ثابت_داخلي(): نص { أرجع «خلل داخلي في المترجم. هذا خطأ في المترجم؛ أبلغ عنه مع رمز التشخيص.»; }

