    | معرف_تشخيص.نفاد_ذاكرة_المترجم -> { أرجع «نفدت ذاكرة المترجم»; }
    | معرف_تشخيص.رمز_ربط_بنوع_غير_متطابق -> { أرجع «عُرّف رمز بنوع يخالف النوع الذي يتوقعه استخدامه»; }
    | معرف_تشخيص.رمز_خارجي_غير_مدعوم -> { أرجع «لا يستطيع الرابط استخدام هذا الرمز الخارجي للهدف»; }
    | معرف_تشخيص.إعادة_توطين_غير_مدعومة -> { أرجع «لا تستطيع صيغة الكائن التعبير عن إعادة توطين تحتاجها هذه الشفرة»; }
    | معرف_تشخيص.صيغة_كائن_غير_مدعومة_للهدف -> { أرجع «لا يستطيع المترجم كتابة ملفات كائنية بهذه الصيغة للهدف»; }
    | معرف_تشخيص.مخرج_ربط_غير_مدعوم -> { أرجع «لا يستطيع الرابط إنتاج هذا المخرج للهدف»; }
    | معرف_تشخيص.مكتبة_ربط_غير_موجودة -> { أرجع «المكتبة غير موجودة في أي دليل بحث عن المكتبات»; }
    | معرف_تشخيص.واجهة_استدعاء_غير_متاحة_للهدف -> { أرجع «لا تتوفر في الهدف قواعد استدعاء لهذه الشفرة»; }
    | معرف_تشخيص.حد_صيغة_كائن_متجاوز -> { أرجع «يتجاوز المخرج حدا للحجم في صيغة ملفه»; }
    | معرف_تشخيص.حد_وقت_الترجمة_متجاوز -> { أرجع «تجاوز التقييم وقت الترجمة أحد حدوده»; }
    | معرف_تشخيص.سلسلة_تنسيق_غير_صالحة -> { أرجع «سلسلة تنسيق غير صالحة»; }
    | معرف_تشخيص.أثر_ممنوع_وقت_الترجمة -> { أرجع «حاول التقييم وقت الترجمة تنفيذ أثر غير مسموح»; }
    | معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة -> { أرجع «فشلت شفرة وقت الترجمة أثناء تنفيذها»; }
    | معرف_تشخيص.عملية_غير_مدعومة_وقت_الترجمة -> { أرجع «لا يمكن تنفيذ هذه العملية وقت الترجمة»; }
    | معرف_تشخيص.ناتج_وقت_الترجمة_غير_ثابت -> { أرجع «لم ينتج التقييم وقت الترجمة ثابتا صالحا للاستخدام»; }
    | معرف_تشخيص.تخطيط_غير_متاح_وقت_الترجمة -> { أرجع «حجم النوع أو محاذاته غير متاح وقت الترجمة»; }
    | معرف_تشخيص.عدد_حجج_وقت_الترجمة_غير_مطابق -> { أرجع «يمرر نداء وقت الترجمة عددا غير صحيح من حجج وقت الترجمة»; }
    | معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم -> { أرجع «لا يستطيع المفسر استدعاء هذه الدالة الخارجية»; }
    | معرف_تشخيص.بدائي_آلة_تفسير_غير_مدعوم -> { أرجع «لا يدعم المفسر هذه العملية الخاصة بالآلة»; }
}

// Immutable language resources: longer prose is stored once, outside match arms.
عام عرف نص_خطأ_رسم_وحدات_مرفوض(): نص { أرجع «رفض المترجم رسم اعتماد الوحدات بسبب إخفاق فحص الاتساق الداخلي»; }

عرف نص_خطأ_نقل_من_مرجع(): نص { أرجع «لا يجوز نقل قيمة مملوكة من تخزين مستعار»; }

عام عرف رسالة_عربية(المفتاح: مفتاح_رسالة_تشخيص): نص {
    طابق المفتاح مع
    | مفتاح_رسالة_تشخيص.تشخيص(الخطأ) -> { أرجع رسالة_خطأ_عربية(الخطأ); }
    | مفتاح_رسالة_تشخيص.سبب(السبب) -> { أرجع رسالة_سبب_عربية(السبب); };
}
