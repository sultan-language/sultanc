// The fixed text of a key, for the empty payload only.
عرف رسالة_ثابتة_بلا_حجج(المفتاح: مفتاح_رسالة_تشخيص, الحقائق: &حقائق_رسالة): اختياري نص {
    طابق *الحقائق مع
    | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_عربية(المفتاح)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// A C diagnostic (Jisr): its title, then Jisr's own text of the problem.
عرف رسالة_سي_عربية(المعرف: معرف_تشخيص, الحقائق: &حقائق_رسالة): اختياري نص {
    طابق *الحقائق مع
    | حقائق_رسالة.فشل_وقت_الترجمة(القيم) -> {
        دع الباني: متغير باني_نص = أنشئ_باني_نص();
        دع المقدمة: نص = رسالة_خطأ_عربية(المعرف);
        دع فاصل: نص = «: »;
        إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &المقدمة)) { أرجع اختياري.لا_شيء(); };
        إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &فاصل)) { أرجع اختياري.لا_شيء(); };
        إذا (!ألحق_نصا_بباني_النص(&متغير الباني, &القيم.الرسالة)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(نص_باني_النص(&الباني));
    }
    | حقائق_رسالة.بلا_حجج -> { أرجع اختياري.موجود(رسالة_خطأ_عربية(المعرف)); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}
