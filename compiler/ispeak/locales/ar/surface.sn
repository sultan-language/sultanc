استورد compiler.ispeak.keys.surface;

// Source-backed user-facing wording; no numeric/string lookup or initialization.

// Immutable language resources: longer prose is stored once, outside match arms.

عام عرف نص_واجهة_عربي(المفتاح: مفتاح_نص_مترجم): نص {
    طابق المفتاح مع
    | مفتاح_نص_مترجم.عنوان_المساعدة -> { أرجع "مترجم السلطان\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الاستخدام -> { أرجع "الاستخدام:\n"; }
    | مفتاح_نص_مترجم.سطر_استخدام_المترجم -> { أرجع "    sultanc <المصدر> [الخيارات]\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الأوامر -> { أرجع "الأوامر:\n"; }
    | مفتاح_نص_مترجم.أمر_التشغيل -> { أرجع "    run <المصدر> [وسائط...] التشغيل عبر مفسر السلطان\n"; }
    | مفتاح_نص_مترجم.توضيح_وسائط_التشغيل -> { أرجع "                              الوسائط بعد <المصدر> تمر كما هي للبرنامج\n"; }
    | مفتاح_نص_مترجم.أمر_التحقق -> { أرجع "    check <المصدر>         التحقق دون إنشاء تنفيذي\n                           مع --target <هدف> يجري التحقق لذلك الهدف (الافتراضي هو المضيف)\n"; }
    | مفتاح_نص_مترجم.أمر_الأهداف -> { أرجع "    targets                عرض الأهداف المدعومة\n"; }
    | مفتاح_نص_مترجم.أمر_الشرح -> { أرجع "    explain <code>         شرح رمز تشخيص\n"; }
    | مفتاح_نص_مترجم.أمر_التنسيق -> { أرجع "    fmt [<مسار>...|-]      تنسيق مصادر السلطان في مكانها (المجلد: ملفات .sn فيه؛\n                           - أو بلا مسار: من الإدخال القياسي إلى الخرج القياسي)\n"; }
    | مفتاح_نص_مترجم.أمر_المساعدة -> { أرجع "    help                   عرض المساعدة\n"; }
    | مفتاح_نص_مترجم.أمر_الإصدار -> { أرجع "    version                عرض الإصدار\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الخيارات_الشائعة -> { أرجع "الخيارات الشائعة:\n"; }
    | مفتاح_نص_مترجم.خيار_المخرج -> { أرجع "    -o <مسار>              مسار المخرج\n"; }
    | مفتاح_نص_مترجم.خيار_الهدف -> { أرجع "    -t, --target <هدف>     منصة الهدف\n"; }
    | مفتاح_نص_مترجم.خيار_الكائن -> { أرجع "    -c                     إنشاء ملف كائني\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الخيارات_المتقدمة -> { أرجع "الخيارات المتقدمة:\n"; }
    | مفتاح_نص_مترجم.خيار_الخلفية -> { أرجع "    -b, --backend <اسم>    native | llvm\n"; }
    | مفتاح_نص_مترجم.خيار_نوع_الإخراج -> { أرجع "    --emit=<نوع>           exe | obj | shared | reloc | module | asm | llvm-ir\n    -O0 | -O1 | -O2 | -O3      مستوى تحسين LLVM (الافتراضي -O2)\n    --release              LLVM بمستوى -O3 إن تضمّنه المترجم\n    --comptime-budget=<n>  عدد تعليمات كل تقييم وقت الترجمة (الافتراضي 10000000؛ أو SULTANC_COMPTIME_BUDGET)\n"; }
    | مفتاح_نص_مترجم.خيار_اللغة -> { أرجع "    --lang=<لغة>           auto | ar | en\n"; }
    | مفتاح_نص_مترجم.خيار_التشخيص -> { أرجع "    --diagnostic-format=<صيغة>  human | short | json\n"; }
    | مفتاح_نص_مترجم.خيار_الألوان -> { أرجع "    --color=<سياسة>        auto | always | never\n"; }
    | مفتاح_نص_مترجم.خيار_فحص_التنسيق -> { أرجع "    --check                مع fmt: الإبلاغ عن الملفات غير المنسقة دون تغيير شيء\n"; }
    | مفتاح_نص_مترجم.خيار_مصدر_الوحدة -> { أرجع "    --module-source=<وحدة>=<ملف>\n"; }
    | مفتاح_نص_مترجم.توضيح_مصدر_الوحدة -> { أرجع "                           ترجمة <ملف> مصدرا للوحدة المنطقية <وحدة>\n"; }
    | مفتاح_نص_مترجم.خيار_مكتبة_الربط -> { أرجع "    -l <اسم>               ربط المكتبة lib<اسم> (مثلا -l c)\n"; }
    | مفتاح_نص_مترجم.خيار_دليل_المكتبات -> { أرجع "    -L <دليل>              البحث في <دليل> أولا عن مكتبات -l\n"; }
    | مفتاح_نص_مترجم.تسمية_الخلفيات -> { أرجع «الخلفيات:»; }
    | مفتاح_نص_مترجم.تعارض_جذر_مصدر_الحزمة -> { أرجع «جذر مصدر الحزمة يتعارض مع جذر مسجل»; }
    | مفتاح_نص_مترجم.تعارض_تهجئة_جذر_الحزمة -> { أرجع «تهجئة جذر الحزمة تتعارض مع ارتباط آخر»; }
    | مفتاح_نص_مترجم.التباس_جذر_الاعتمادية -> { أرجع «تهجئة جذر الاعتمادية ملتبسة داخل الحزمة المستوردة»; }
    | مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_الاعتمادية -> { أرجع «تهجئة جذر المكتبة القياسية تتعارض ضمن نطاق الاعتمادية»; }
    | مفتاح_نص_مترجم.تعارض_جذر_مكتبة_موثوق -> { أرجع «تعارض في جذر مكتبة قياسية موثوق»; }
    | مفتاح_نص_مترجم.تعارض_جذر_المكتبة_في_المشروع -> { أرجع «تهجئة جذر المكتبة القياسية تتعارض داخل نطاق المشروع»; }
    | مفتاح_نص_مترجم.تهجئة_جذر_حزمة_غير_صالحة -> { أرجع «تهجئة جذر الحزمة ليست معرف مصدر صالحا»; }
    | مفتاح_نص_مترجم.صياغة_تومل_غير_صالحة -> { أرجع «صياغة TOML غير صالحة»; }
    | مفتاح_نص_مترجم.تعذر_قراءة_رسم_حزم -> { أرجع «تعذرت قراءة رسم الحزم»; }
    | مفتاح_نص_مترجم.إصدار_رسم_حزم_غير_مدعوم -> { أرجع «لا يُدعم إلا الإصدار 1 من رسم الحزم»; }
    | مفتاح_نص_مترجم.حقل_رسم_حزم_غير_معروف -> { أرجع «حقل غير معروف في رسم الحزم»; }
    | مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود -> { أرجع «حقل مطلوب مفقود في رسم الحزم»; }
    | مفتاح_نص_مترجم.حقل_رسم_حزم_ليس_نصا -> { أرجع «يجب أن يكون حقل رسم الحزم نصا»; }
    | مفتاح_نص_مترجم.مدخلات_رسم_حزم_ليست_جداول -> { أرجع «يجب أن تكون package وedge مصفوفتي جداول ([[package]] و[[edge]])»; }
    | مفتاح_نص_مترجم.تهجئات_رسم_حزم_ليست_جدولا -> { أرجع «يجب أن تكون spellings جدولا من لغة = تهجئة»; }
    | مفتاح_نص_مترجم.جذر_مصدر_حزمة_رسم_مفقود -> { أرجع «source_root ليس دليلا موجودا»; }
    | مفتاح_نص_مترجم.جذر_مصدر_حزمة_رسم_مكرر -> { أرجع «حزمتان لهما source_root نفسه»; }
    | مفتاح_نص_مترجم.مدخل_حزمة_رسم_مفقود -> { أرجع «لا يسمي entry ملف وحدة تحت source_root»; }
    | مفتاح_نص_مترجم.حزمة_رسم_غير_معروفة -> { أرجع «لا حزمة في الرسم بهذا المعرف»; }
    | مفتاح_نص_مترجم.معرف_حزمة_رسم_مكرر -> { أرجع «حزمتان في الرسم بالمعرف نفسه»; }
    | مفتاح_نص_مترجم.معرف_حزمة_رسم_محجوز -> { أرجع «المعرف std للمكتبة القياسية، ولا يصف رسم الحزم المكتبة القياسية»; }
    | مفتاح_نص_مترجم.مصدر_خارج_حزمة_الجذر -> { أرجع «ملف المصدر ليس تحت source_root لحزمة الجذر»; }
    | مفتاح_نص_مترجم.كلمة_محجوزة_في_رسم_حزم -> { أرجع «لا تكون الكلمة المحجوزة اسم حزمة ولا كتابة لها ولا اسم حافة»; }
    | مفتاح_نص_مترجم.وصف_عنصر_نائب_مرقم -> { أرجع «عنصر نائب مرقم»; }
    | مفتاح_نص_مترجم.وصف_معرف -> { أرجع «معرف»; }
    | مفتاح_نص_مترجم.وصف_عدد_صحيح -> { أرجع «حرفي عدد صحيح»; }
    | مفتاح_نص_مترجم.وصف_عدد_عشري -> { أرجع «حرفي عدد عشري»; }
    | مفتاح_نص_مترجم.وصف_نص -> { أرجع «حرفي نص»; }
    | مفتاح_نص_مترجم.وصف_حرف -> { أرجع «حرفي حرف»; }
    | مفتاح_نص_مترجم.وصف_منطقي -> { أرجع «حرفي منطقي»; }
    | مفتاح_نص_مترجم.وصف_نهاية_الملف -> { أرجع «نهاية الملف»; }
    | مفتاح_نص_مترجم.غياب_موفر_لي_لي_في_واسي -> { أرجع «LLVM غير متاح داخل مترجم يعمل على مضيف WASI»; }
    | مفتاح_نص_مترجم.ترويسة_جدول_الأهداف -> { أرجع "الهدف           المعمارية       النظام   الكائن   الدعم\n"; }
    | مفتاح_نص_مترجم.بادئة_الإصدار -> { أرجع «السلطان »; }
    | مفتاح_نص_مترجم.حالة_إصدار_تطويري -> { أرجع «إصدار تطويري»; }
    | مفتاح_نص_مترجم.دعم_هدف_مضيف_ذاتي -> { أرجع «مضيف ذاتي»; }
    | مفتاح_نص_مترجم.دعم_هدف_مخرج_متحقق -> { أرجع «مخرج متحقق كليا»; }
    | مفتاح_نص_مترجم.دعم_هدف_ترجمة_متقاطعة -> { أرجع «ترجمة متقاطعة»; }
    | مفتاح_نص_مترجم.دعم_هدف_تجريبي -> { أرجع «تجريبي»; }
    | مفتاح_نص_مترجم.منصة_هدف_غير_محددة -> { أرجع «غير محددة»; }
    | مفتاح_نص_مترجم.منصة_هدف_داروين -> { أرجع «داروين»; }
    | مفتاح_نص_مترجم.منصة_هدف_آي_أو_إس -> { أرجع «آي أو إس»; }
    | مفتاح_نص_مترجم.منصة_هدف_لينكس -> { أرجع «لينكس»; }
    | مفتاح_نص_مترجم.منصة_هدف_ويندوز -> { أرجع «ويندوز»; }
    | مفتاح_نص_مترجم.منصة_هدف_أندرويد -> { أرجع «أندرويد»; }
    | مفتاح_نص_مترجم.منصة_هدف_فري_بي_إس_دي -> { أرجع «فري بي إس دي»; }
    | مفتاح_نص_مترجم.منصة_هدف_واسي -> { أرجع «واسي»; }
    | مفتاح_نص_مترجم.منصة_هدف_متصفح -> { أرجع «المتصفح»; }
    | مفتاح_نص_مترجم.منصة_هدف_عتاد_مباشر -> { أرجع «عتاد مباشر»; }
    | مفتاح_نص_مترجم.عملية_نداء_دالة_خارجية -> { أرجع «نداء دالة خارجية»; }
    | مفتاح_نص_مترجم.عملية_نداء_بدائي -> { أرجع «نداء بدائي من بدائيات المترجم»; }
    | مفتاح_نص_مترجم.عملية_نداء_قيمة_دالة -> { أرجع «نداء عبر قيمة دالة»; }
    | مفتاح_نص_مترجم.عملية_عنوان_عام -> { أرجع «عنوان متغير عام»; }
    | مفتاح_نص_مترجم.عملية_مؤشر_خام_من_مرجع -> { أرجع «مؤشر خام مصنوع من مرجع»; }
    | مفتاح_نص_مترجم.عملية_تخزين_عبر_مؤشر_خام -> { أرجع «تخزين عبر مؤشر خام»; }
    ;
}
