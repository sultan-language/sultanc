    | مفتاح_نص_مترجم.خيار_الكائن -> { أرجع "    -c                     إنشاء ملف كائني\n\n"; }
    | مفتاح_نص_مترجم.عنوان_الخيارات_المتقدمة -> { أرجع "الخيارات المتقدمة:\n"; }
    | مفتاح_نص_مترجم.خيار_الخلفية -> { أرجع "    -b, --backend <اسم>    native | llvm\n"; }
    | مفتاح_نص_مترجم.خيار_نوع_الإخراج -> { أرجع "    --emit=<نوع>           exe | obj | shared | reloc | module | asm | llvm-ir\n"; }
    | مفتاح_نص_مترجم.خيار_اللغة -> { أرجع "    --lang=<لغة>           auto | ar | en\n"; }
    | مفتاح_نص_مترجم.خيار_التشخيص -> { أرجع "    --diagnostic-format=<صيغة>  human | short | json\n"; }
    | مفتاح_نص_مترجم.خيار_الألوان -> { أرجع "    --color=<سياسة>        auto | always | never\n"; }
    | مفتاح_نص_مترجم.خيار_مصدر_الوحدة -> { أرجع "    --module-source=<وحدة>=<ملف>\n"; }
    | مفتاح_نص_مترجم.توضيح_مصدر_الوحدة -> { أرجع "                           ترجمة <ملف> مصدرا للوحدة المنطقية <وحدة>\n"; }
    | مفتاح_نص_مترجم.خيار_مكتبة_الربط -> { أرجع "    -l <اسم>               ربط المكتبة lib<اسم> (مثلا -l c)\n"; }
