    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_إرجاع_غير_مطابق)) -> { أرجع «نوع الإرجاع المتوقع هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوعان_غير_متوافقين)) -> { أرجع «النوع المتوقع هو »; }
