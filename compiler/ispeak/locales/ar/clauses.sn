استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.keys.clauses;

// Arabic context clauses. Each clause is the opening of one complete sentence;
// the shared composer appends the fact and the full stop.

// Source-backed primary facts use identity-specific wording. The fallback
// remains a complete localized sentence for auxiliary and new message keys.
عرف مقدمة_القيمة_المخصصة_عربية(المفتاح: اختياري مفتاح_رسالة_تشخيص): نص {
    طابق المفتاح مع
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.أوضاع_مترجم_متعارضة)) -> { أرجع «الخيار المتعارض هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم)) -> { أرجع «رسالة المحمّل هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.استدعاء_مترجم_غير_صالح)) -> { أرجع «معامل استدعاء المترجم غير الصحيح هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خيار_مترجم_غير_معروف)) -> { أرجع «خيار المترجم غير المعروف هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.رمز_تشخيص_مترجم_غير_معروف)) -> { أرجع «رمز التشخيص غير المعروف هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.صيغة_تشخيص_مترجم_غير_صالحة)) -> { أرجع «صيغة التشخيص غير المدعومة هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.قيمة_خيار_مترجم_مفقودة)) -> { أرجع «الخيار الذي تنقصه قيمة هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.لغة_تشخيص_مترجم_غير_صالحة)) -> { أرجع «لغة التشخيص غير المدعومة هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.لون_تشخيص_مترجم_غير_صالح)) -> { أرجع «سياسة الألوان غير الصحيحة هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مصدر_رئيسي_متعدد)) -> { أرجع «ورد مصدر رئيسي إضافي هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.معامل_موضعي_غير_متوقع)) -> { أرجع «المعامل الموضعي غير المتوقع هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_وقت_الترجمة_مطلوب)) -> { أرجع «نص الخطأ المطلوب وقت الترجمة هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_كتابة_مخرج_مترجم)) -> { أرجع «تفصيل فشل كتابة المخرج هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تحذير_عام)) -> { أرجع «تفصيل التحذير هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_مترجم_داخلي)) -> { أرجع «تفصيل خلل المترجم الداخلي هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_تفسير_وقت_تشغيل)) -> { أرجع «تفصيل فشل التنفيذ في المفسر هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فخ_تفسير)) -> { أرجع «تفصيل الفخ في المفسر هو »; }
    | _ -> { أرجع «القيمة المقدمة هي »; };
}

عرف مقدمة_المسار_المخصصة_عربية(المفتاح: اختياري مفتاح_رسالة_تشخيص): نص {
    طابق المفتاح مع
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.بيان_حزمة_غير_صالح)) -> { أرجع «يقع بيان الحزمة غير الصحيح في »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تعارض_مصدر_وحدة)) -> { أرجع «يقع مصدر الوحدة المتعارض في »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_كتابة_مخرج_مترجم)) -> { أرجع «تعذرت كتابة ملف المخرج في »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.ملف_إدخال_مفقود)) -> { أرجع «ملف الإدخال المفقود هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_ملف_إدخال_غير_معروف)) -> { أرجع «ملف الإدخال مجهول النوع هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.وحدة_مصدر_غير_موجودة)) -> { أرجع «وحدة المصدر المفقودة هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.وحدة_مصدر_غير_مقروءة)) -> { أرجع «وحدة المصدر التي تعذرت قراءتها هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مرجع_استيراد_غير_صالح)) -> { أرجع «مرجع الاستيراد غير الصالح هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.جذر_مكتبة_غير_مسجل)) -> { أرجع «جذر المكتبة غير المسجل هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.استيراد_يهرب_من_الجذر)) -> { أرجع «مسار الاستيراد الخارج عن جذر المكتبة هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسار_وحدة_منطقي_غير_صالح)) -> { أرجع «مسار الوحدة المنطقي غير الصالح هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تعارض_مسار_وحدة_عام)) -> { أرجع «مسار الوحدة العام المتعارض هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.دورة_استيراد)) -> { أرجع «تشمل دورة الاستيراد المسار »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم)) -> { أرجع «المكتبة هي »; }
    | _ -> { أرجع «المسار المتأثر هو »; };
}

