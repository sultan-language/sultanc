    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف)) -> { أرجع «الاسم غير المعروف هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_محلول)) -> { أرجع «الاسم الذي تعذر حله هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.ربط_اسم_خفض_مفقود)) -> { أرجع «ربط الاسم المقنن المفقود يتعلق بالاسم »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.حقل_سجل_مفقود)) -> { أرجع «حقل السجل المفقود هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.حقل_سجل_مكرر)) -> { أرجع «حقل السجل المكرر هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.حقل_سجل_غير_معروف)) -> { أرجع «حقل السجل غير المعروف هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تصريح_خاص_غير_متاح)) -> { أرجع «التصريح الخاص غير المتاح هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تصدير_انتقائي_غير_موجود)) -> { أرجع «التصدير الانتقائي المفقود هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.استخدام_بعد_النقل)) -> { أرجع «القيمة المستخدمة بعد نقل ملكيتها هي »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.كتابة_إلى_غير_متغير)) -> { أرجع «القيمة غير المتغيرة التي جرت محاولة الكتابة إليها هي »; }
