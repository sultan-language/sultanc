    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فك_مرجع_غير_مؤشر)) -> { أرجع «النوع غير المؤشري الذي جرت محاولة فك مرجعه هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_حجة_غير_مطابق)) -> { أرجع «نوع الحجة المقدمة هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_إرجاع_غير_مطابق)) -> { أرجع «نوع تعبير الإرجاع هو »; }
    | _ -> { أرجع «النوع هو »; };
}

