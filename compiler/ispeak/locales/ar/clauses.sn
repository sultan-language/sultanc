    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق)) -> { أرجع «عدد حمولات منشئ النمط المتوقع هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_بدائي_تفسير_غير_مطابق)) -> { أرجع «عدد حجج بدائي المفسر المتوقع هو »; }
