    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.لا_ناتج_تحليل)) -> { أرجع «ورد سبب عدم إنتاج المحلل نتيجة على النحو الآتي: »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_ناتج_دالة_مفقود)) -> { أرجع «ورد سبب غياب نوع إرجاع الدالة على النحو الآتي: »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.بيان_حزمة_غير_صالح)) -> { أرجع «ورد سبب رفض بيان الحزمة على النحو الآتي: »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_مترجم_داخلي)) -> { أرجع «ورد سبب فشل المترجم على النحو الآتي: »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_كتابة_مخرج_مترجم)) -> { أرجع «ورد سبب تعذر كتابة المخرج على النحو الآتي: »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.حالة_تفسير_غير_صالحة)) -> { أرجع «ورد سبب خلل حالة المفسر على النحو الآتي: »; }
    | _ -> { أرجع «»; };
}

