عام عرف مقدمة_بند_عربية(البند: بند_سياق, المفتاح: اختياري مفتاح_رسالة_تشخيص): نص {
    طابق البند مع
    | بند_سياق.بند_القيمة -> { أرجع مقدمة_القيمة_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_الاستبدال -> { أرجع مقدمة_الاستبدال_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_الفهرس -> { أرجع مقدمة_الفهرس_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_الطول -> { أرجع «الطول هو »; }
    | بند_سياق.بند_المجال -> { أرجع «المجال المعني هو »; }
    | بند_سياق.بند_النمط -> { أرجع مقدمة_النمط_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_المسار -> { أرجع مقدمة_المسار_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_الرمز -> { أرجع مقدمة_الرمز_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_النوع -> { أرجع مقدمة_النوع_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_السياق -> { أرجع «حدث ذلك في سياق »; }
    | بند_سياق.بند_المرحلة -> { أرجع «حدث ذلك خلال المرحلة »; }
    | بند_سياق.بند_الهدف -> { أرجع مقدمة_الهدف_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_الدالة -> { أرجع «الدالة المتأثرة هي »; }
    | بند_سياق.بند_الكتلة -> { أرجع «الكتلة المتأثرة هي »; }
    | بند_سياق.بند_التعليمة -> { أرجع «التعليمة المتأثرة هي »; }
    | بند_سياق.بند_العملية -> { أرجع «العملية هي »; }
    | بند_سياق.بند_البدائي -> { أرجع «العملية البدائية للمضيف هي »; }
    | بند_سياق.بند_المصدر -> { أرجع «قيمة المصدر هي »; }
    | بند_سياق.بند_الوجهة -> { أرجع «قيمة الوجهة هي »; }
    | بند_سياق.بند_السبب -> { أرجع مقدمة_السبب_المخصصة_عربية(المفتاح); }
    | بند_سياق.بند_متوقع_منفرد -> { أرجع مقدمة_المتوقع_المنفرد_عربية(المفتاح); }
    | بند_سياق.بند_موجود_منفرد -> { أرجع مقدمة_الموجود_المنفرد_عربية(المفتاح); }
    | بند_سياق.بند_بداية_مقارنة -> { أرجع بداية_مقارنة_مخصصة_عربية(المفتاح); }
    | بند_سياق.بند_وسط_مقارنة -> { أرجع وسط_مقارنة_مخصصة_عربية(المفتاح); };
}

// A boolean fact is the language's own literal, quoted as code: the Arabic
// literal for false is also the word for "error", so it is never bare prose.
عام عرف كلمة_منطقية_عربية(الحالة: منطقي): نص {
    لو (الحالة) { أرجع «`صواب`»; };
    أرجع «`خطأ`»;
}
