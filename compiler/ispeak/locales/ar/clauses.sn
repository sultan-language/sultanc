    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.رمز_دخول_ربط_مفقود)) -> { أرجع «رمز الدخول المفقود هو »; }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.رمز_ربط_مكرر)) -> { أرجع «الرمز المكرر هو »; }
