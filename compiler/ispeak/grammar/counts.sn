استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;

// Counted nouns used by count comparisons. Each locale owns the word forms and
// its own agreement rule; this file only names which thing is being counted.
عام نوع معدود_رسالة =
    | حجة
    | حمولة
;

// Which count sentence an identity uses: who expects how many of what, and who
// supplies them. لا_شيء keeps the generic "count is N" wording.
عام نوع إطار_مقارنة_عدد =
    | حجج_دالة
    | حجج_بدائي
    | حمولات_منشئ
;

عام عرف إطار_مقارنة_عدد_للمفتاح(المفتاح: اختياري مفتاح_رسالة_تشخيص): اختياري إطار_مقارنة_عدد {
    طابق المفتاح مع
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق)) -> { أرجع اختياري.موجود(إطار_مقارنة_عدد.حجج_دالة()); }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_بدائي_تفسير_غير_مطابق)) -> { أرجع اختياري.موجود(إطار_مقارنة_عدد.حجج_بدائي()); }
    | اختياري.موجود(مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق)) -> { أرجع اختياري.موجود(إطار_مقارنة_عدد.حمولات_منشئ()); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف معدود_إطار(الإطار: إطار_مقارنة_عدد): معدود_رسالة {
    طابق الإطار مع
    | إطار_مقارنة_عدد.حجج_دالة -> { أرجع معدود_رسالة.حجة(); }
    | إطار_مقارنة_عدد.حجج_بدائي -> { أرجع معدود_رسالة.حجة(); }
    | إطار_مقارنة_عدد.حمولات_منشئ -> { أرجع معدود_رسالة.حمولة(); };
}

// Reads an unsigned fact through a reference so the caller keeps its value.
عام عرف عدد_حقيقة_رسالة(القيمة: &قيمة_حجة_رسالة): اختياري طبيعي {
    طابق *القيمة مع
    | قيمة_حجة_رسالة.طبيعية(العدد) -> { أرجع اختياري.موجود(العدد); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}
