استورد compiler.diagnostics.schema;

// CLDR plural categories (Unicode CLDR plural rules, integer operands only).
// The category selects a word form; each locale maps categories to its forms.
عام نوع فئة_جمع =
    | صفر
    | واحد
    | اثنان
    | قليل
    | كثير
    | أخرى
;

// en: one -> i = 1; other -> everything else.
// ar: zero -> 0; one -> 1; two -> 2; few -> n % 100 = 3..10;
//     many -> n % 100 = 11..99; other -> everything else.
عام عرف فئة_جمع_العدد(اللغة: لغة_تشخيص, العدد: طبيعي): فئة_جمع {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> {
        لو (العدد == 1) { أرجع فئة_جمع.واحد(); };
        أرجع فئة_جمع.أخرى();
    }
    | لغة_تشخيص.العربية -> {
        لو (العدد == 0) { أرجع فئة_جمع.صفر(); };
        لو (العدد == 1) { أرجع فئة_جمع.واحد(); };
        لو (العدد == 2) { أرجع فئة_جمع.اثنان(); };
        دع الباقي: طبيعي = العدد % 100;
        لو (الباقي >= 3 && الباقي <= 10) { أرجع فئة_جمع.قليل(); };
        لو (الباقي >= 11 && الباقي <= 99) { أرجع فئة_جمع.كثير(); };
        أرجع فئة_جمع.أخرى();
    };
}
