استورد std.text.builder;
استورد std.bytes.builder;

// Inline quotation of message facts. Language-free; not terminal/JSON escaping.

// A backtick-quoted fact must not close its own delimiter or insert control
// bytes into a diagnostic sentence. Common identifiers are appended directly;
// unusual bytes are escaped without changing the stored diagnostic fact.
// This is *inline quotation*, not terminal/JSON transport escaping.
عام عرف ألحق_حقيقة_مقتبسة(الباني: &متغير باني_نص, القيمة: &نص): منطقي {
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    دع يحتاج_هروبا: متغير منطقي = خطأ;
    طالما (ف < العدد && !يحتاج_هروبا) {
        دع البايت: ط8 = (*القيمة)[ف];
        لو (البايت == 0x60 || البايت == 0x5C || البايت < 0x20 || البايت == 0x7F) {
            يحتاج_هروبا := صواب;
        };
        ف := ف + 1;
    }
    لو (!يحتاج_هروبا) { أرجع ألحق_نصا_بباني_النص(الباني, القيمة); };

    // The text builder already owns the canonical byte builder. Append
    // escaped bytes there directly; do not allocate and copy an intermediate
    // vector and text for each quoted fact.
    دع الأرقام: نص = «0123456789ABCDEF»;
    ف := 0;
    طالما (ف < العدد) {
        دع البايت: ط8 = (*القيمة)[ف];
        لو (البايت == 0x60) {
            دع الهروب: نص = «\`»;
            لو (!ألحق_نصا_بباني_النص(الباني, &الهروب)) { أرجع خطأ; };
        } وإلا لو (البايت == 0x5C) {
            دع الهروب: نص = «\\»;
            لو (!ألحق_نصا_بباني_النص(الباني, &الهروب)) { أرجع خطأ; };
        } وإلا لو (البايت == 0x0A) {
            دع الهروب: نص = «\n»;
            لو (!ألحق_نصا_بباني_النص(الباني, &الهروب)) { أرجع خطأ; };
        } وإلا لو (البايت == 0x0D) {
            دع الهروب: نص = «\r»;
            لو (!ألحق_نصا_بباني_النص(الباني, &الهروب)) { أرجع خطأ; };
        } وإلا لو (البايت == 0x09) {
            دع الهروب: نص = «\t»;
            لو (!ألحق_نصا_بباني_النص(الباني, &الهروب)) { أرجع خطأ; };
        } وإلا لو (البايت < 0x20 || البايت == 0x7F) {
            دع بادئة: نص = «\x»;
            لو (!ألحق_نصا_بباني_النص(الباني, &بادئة)) { أرجع خطأ; };
            دع الأعلى: طبيعي = ((البايت >> 4) & 0x0F) مثل طبيعي;
            دع الأدنى: طبيعي = (البايت & 0x0F) مثل طبيعي;
            لو (!ألحق_بايتا_بباني_البايتات(&متغير (*الباني).البايتات, الأرقام[الأعلى])) { أرجع خطأ; };
            لو (!ألحق_بايتا_بباني_البايتات(&متغير (*الباني).البايتات, الأرقام[الأدنى])) { أرجع خطأ; };
        } وإلا {
            لو (!ألحق_بايتا_بباني_البايتات(&متغير (*الباني).البايتات, البايت)) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// `<fact>` with its delimiters, always: the composer's form for text facts.
عام عرف ألحق_حقيقة_مقتبسة_بعلامتين(الباني: &متغير باني_نص, القيمة: &نص): منطقي {
    دع العلامة: نص = «`»;
    لو (!ألحق_نصا_بباني_النص(الباني, &العلامة)) { أرجع خطأ; };
    لو (!ألحق_حقيقة_مقتبسة(الباني, القيمة)) { أرجع خطأ; };
    أرجع ألحق_نصا_بباني_النص(الباني, &العلامة);
}

// Appends one fixed fragment; a false result means the builder failed.
عام عرف ألحق_قطعة(الباني: &متغير باني_نص, القطعة: &نص): منطقي {
    أرجع ألحق_نصا_بباني_النص(الباني, القطعة);
}

// `<prefix><quoted value><suffix>` as one owned text.
عام عرف نسق_نصا_مقتبسا(المقدمة: نص, القيمة: &نص, اللاحقة: نص): اختياري نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    لو (!ألحق_قطعة(&متغير الباني, &المقدمة)) { أرجع اختياري.لا_شيء(); };
    لو (!ألحق_حقيقة_مقتبسة(&متغير الباني, القيمة)) { أرجع اختياري.لا_شيء(); };
    لو (!ألحق_قطعة(&متغير الباني, &اللاحقة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(نص_باني_النص(&الباني));
}

// `<base><separator><quoted value>`` ` as one owned text.
عام عرف نسق_نصا_محددا(الأساس: &نص, القيمة: &نص, الفاصل: نص): اختياري نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    لو (!ألحق_قطعة(&متغير الباني, الأساس)) { أرجع اختياري.لا_شيء(); };
    لو (!ألحق_قطعة(&متغير الباني, &الفاصل)) { أرجع اختياري.لا_شيء(); };
    لو (!ألحق_حقيقة_مقتبسة(&متغير الباني, القيمة)) { أرجع اختياري.لا_شيء(); };
    دع النهاية: نص = «`»;
    لو (!ألحق_قطعة(&متغير الباني, &النهاية)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(نص_باني_النص(&الباني));
}
