استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.keys.surface;

// Typed diagnostic facts. Values are not identities and are never used for lookup.
// Each record names its facts so language-specific formatting can reorder them.
// No vectors, string-key parsing, runtime catalogs or linear argument scans.
عام نوع حقائق_اسم_غير_معروف = {
    الاسم: نص
};

عام نوع حقائق_نوعان_غير_متوافقين = {
    المتوقع: نص,
    الموجود: نص
};

عام نوع حقائق_عدد_حجج_غير_مطابق = {
    المتوقع: طبيعي,
    الموجود: طبيعي
};

// Source-independent facts corresponding to the compiler's currently emitted
// contextual arguments. The identity stays separate from the fact values.
عام نوع حقائق_نص_محدد = { القيمة: نص };

// LLVM linker diagnostics carry the target triple and unresolved C API symbol.
عام نوع حقائق_ربط_إل_إل_في_إم = {
    الهدف: نص,
    الرمز: نص
};

// Compile-time failures carry a user-provided reason, never part of the key.
عام نوع حقائق_فشل_وقت_الترجمة = { الرسالة: نص };

عام نوع حقائق_بيان_حزمة = {
    المسار: نص,
    البايت: اختياري طبيعي,
    السبب: اختياري مفتاح_نص_مترجم
};

عام نوع حقائق_اقتراح_كلمة = { الاستبدال: نص };

عام نوع حقائق_توقع_نحوي = {
    المتوقع: نص,
    الموجود: اختياري نص
};

عام نوع حقائق_بدائي_تفسير = {
    البدائي: نص,
    الفهرس: اختياري طبيعي,
    المتوقع: اختياري طبيعي,
    الموجود: اختياري طبيعي
};


// The diagnostic record's 22 established named argument keys. A context is
// a presentation payload, not a second diagnostic record or identity registry.
// Fields are directly addressed; formatting cost is bounded by this fixed shape.
عام نوع قيمة_حجة_رسالة =
    | نصية بنوع نص
    | طبيعية بنوع طبيعي
    | موقعة بنوع عدد
    | منطقية بنوع منطقي
    | سبب_محدد بنوع سبب_تشخيص
;

عام نوع حقائق_سياق_رسالة = {
    القيمة: اختياري قيمة_حجة_رسالة,
    المتوقع: اختياري قيمة_حجة_رسالة,
    الاستبدال: اختياري قيمة_حجة_رسالة,
    الموجود: اختياري قيمة_حجة_رسالة,
    الفهرس: اختياري قيمة_حجة_رسالة,
    الطول: اختياري قيمة_حجة_رسالة,
    المجال: اختياري قيمة_حجة_رسالة,
    النمط: اختياري قيمة_حجة_رسالة,
    المسار: اختياري قيمة_حجة_رسالة,
    الرمز: اختياري قيمة_حجة_رسالة,
    النوع: اختياري قيمة_حجة_رسالة,
    السياق: اختياري قيمة_حجة_رسالة,
    المرحلة: اختياري قيمة_حجة_رسالة,
    الهدف: اختياري قيمة_حجة_رسالة,
    الدالة: اختياري قيمة_حجة_رسالة,
    الكتلة: اختياري قيمة_حجة_رسالة,
    التعليمة: اختياري قيمة_حجة_رسالة,
    العملية: اختياري قيمة_حجة_رسالة,
    البدائي: اختياري قيمة_حجة_رسالة,
    المصدر: اختياري قيمة_حجة_رسالة,
    الوجهة: اختياري قيمة_حجة_رسالة,
    السبب: اختياري قيمة_حجة_رسالة
};

عام نوع حقائق_رسالة =
    | بلا_حجج
    | سياق_تشخيص بنوع حقائق_سياق_رسالة
    | نص_محدد بنوع حقائق_نص_محدد
    | ربط_إل_إل_في_إم بنوع حقائق_ربط_إل_إل_في_إم
    | فشل_وقت_الترجمة بنوع حقائق_فشل_وقت_الترجمة
    | بيان_حزمة بنوع حقائق_بيان_حزمة
    | اقتراح_كلمة بنوع حقائق_اقتراح_كلمة
    | توقع_نحوي بنوع حقائق_توقع_نحوي
    | بدائي_تفسير بنوع حقائق_بدائي_تفسير
    | اسم_غير_معروف بنوع حقائق_اسم_غير_معروف
    | نوعان_غير_متوافقين بنوع حقائق_نوعان_غير_متوافقين
    | عدد_حجج_غير_مطابق بنوع حقائق_عدد_حجج_غير_مطابق
;

// Empty optional facts carry no message text. Avoid allocating a text builder
// for fixed messages, including reasons and auxiliary localized wording.
عام عرف سياق_رسالة_فارغ(السياق: &حقائق_سياق_رسالة): منطقي {
    طابق (*السياق).القيمة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).المتوقع مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الاستبدال مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الموجود مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الفهرس مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الطول مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).المجال مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).النمط مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).المسار مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الرمز مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).النوع مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).السياق مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).المرحلة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الهدف مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الدالة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الكتلة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).التعليمة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).العملية مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).البدائي مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).المصدر مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).الوجهة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق (*السياق).السبب مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}
