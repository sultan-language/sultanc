استورد std.text.builder;
استورد std.text.number;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.format.facts;
استورد compiler.ispeak.format.quote;
استورد compiler.ispeak.grammar.counts;
استورد compiler.ispeak.keys.clauses;
استورد compiler.ispeak.locales.en.clauses;
استورد compiler.ispeak.locales.ar.clauses;
استورد compiler.ispeak.locales.en.counts;
استورد compiler.ispeak.locales.ar.counts;
استورد compiler.ispeak.locales.en.errors;
استورد compiler.ispeak.locales.ar.errors;
استورد compiler.ispeak.locales.en.reasons;
استورد compiler.ispeak.locales.ar.reasons;

// The one context composer for every language. Sentence order, separators and
// fact rendering live here once; each locale supplies only words (clauses,
// count phrases, boolean words, reason texts). One builder, no catalog scan,
// no runtime argument map, no text-to-ID conversion and no template parser.
// The compiler owns which facts are present; each optional fact adds one
// complete sentence after the main message.

عام عرف نص_رسالة_ثابت(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع رسالة_إنجليزية(المفتاح); }
    | لغة_تشخيص.العربية -> { أرجع رسالة_عربية(المفتاح); };
}

عرف نص_سبب_محدد(اللغة: لغة_تشخيص, السبب: سبب_تشخيص): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع رسالة_سبب_إنجليزية(السبب); }
    | لغة_تشخيص.العربية -> { أرجع رسالة_سبب_عربية(السبب); };
}

عرف مقدمة_بند(اللغة: لغة_تشخيص, البند: بند_سياق, المفتاح: اختياري مفتاح_رسالة_تشخيص): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع مقدمة_بند_إنجليزية(البند, المفتاح); }
    | لغة_تشخيص.العربية -> { أرجع مقدمة_بند_عربية(البند, المفتاح); };
}

عرف كلمة_منطقية(اللغة: لغة_تشخيص, الحالة: منطقي): نص {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع كلمة_منطقية_إنجليزية(الحالة); }
    | لغة_تشخيص.العربية -> { أرجع كلمة_منطقية_عربية(الحالة); };
}

عرف ألحق_جملة_مقارنة_عدد(
    الباني: &متغير باني_نص, اللغة: لغة_تشخيص,
    المتوقع: طبيعي, الموجود: طبيعي, الإطار: إطار_مقارنة_عدد
): منطقي {
    طابق اللغة مع
    | لغة_تشخيص.الإنجليزية -> { أرجع ألحق_جملة_مقارنة_عدد_إنجليزية(الباني, المتوقع, الموجود, الإطار); }
    | لغة_تشخيص.العربية -> { أرجع ألحق_جملة_مقارنة_عدد_عربية(الباني, المتوقع, الموجود, الإطار); };
}

عرف ألحق_قيمة_سياق(الباني: &متغير باني_نص, اللغة: لغة_تشخيص, القيمة: &قيمة_حجة_رسالة): منطقي {
    طابق *القيمة مع
    // Every text fact (a name, a type, a path, an option, a token) is quoted as
    // code in every language, so English and Arabic sentences mark facts alike.
    | قيمة_حجة_رسالة.نصية(النص) -> { أرجع ألحق_حقيقة_مقتبسة_بعلامتين(الباني, &النص); }
    | قيمة_حجة_رسالة.طبيعية(العدد) -> {
        دع النص: نص = طبيعي_إلى_نص(العدد);
        أرجع ألحق_قطعة(الباني, &النص);
    }
    | قيمة_حجة_رسالة.موقعة(العدد) -> {
        دع النص: نص = عدد_إلى_نص(العدد);
        أرجع ألحق_قطعة(الباني, &النص);
    }
    | قيمة_حجة_رسالة.منطقية(الحالة) -> {
        دع النص: نص = كلمة_منطقية(اللغة, الحالة);
        أرجع ألحق_قطعة(الباني, &النص);
    }
    | قيمة_حجة_رسالة.سبب_محدد(السبب) -> {
        دع النص: نص = نص_سبب_محدد(اللغة, السبب);
        أرجع ألحق_قطعة(الباني, &النص);
    };
}

// " — " before the first context sentence, " " between the others.
عرف ألحق_فاصل_جملة(الباني: &متغير باني_نص, الأول: &متغير منطقي): منطقي {
    دع الفاصل: متغير نص = « »;
    لو (*الأول) {
        الفاصل := « — »;
        *الأول := خطأ;
    };
    أرجع ألحق_قطعة(الباني, &الفاصل);
}

عرف ألحق_نهاية_جملة(الباني: &متغير باني_نص): منطقي {
    دع النهاية: نص = «.»;
    أرجع ألحق_قطعة(الباني, &النهاية);
}

// `<separator><clause opening><fact>.` when the fact is present.
عرف ألحق_جملة_بند(
    الباني: &متغير باني_نص, اللغة: لغة_تشخيص, الأول: &متغير منطقي,
    البند: بند_سياق, الحقل: &اختياري قيمة_حجة_رسالة, المفتاح: اختياري مفتاح_رسالة_تشخيص
): منطقي {
    طابق *الحقل مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(القيمة) -> {
        دع المقدمة: نص = مقدمة_بند(اللغة, البند, المفتاح);
        لو (!ألحق_فاصل_جملة(الباني, الأول)) { أرجع خطأ; };
        لو (!ألحق_قطعة(الباني, &المقدمة)) { أرجع خطأ; };
        لو (!ألحق_قيمة_سياق(الباني, اللغة, &القيمة)) { أرجع خطأ; };
        أرجع ألحق_نهاية_جملة(الباني);
    };
}

// When both sides of a comparison are known they form one sentence. Counted
// identities use the locale's count grammar; others use the comparison clauses.
عرف ألحق_مقارنة_سياق(
    الباني: &متغير باني_نص, اللغة: لغة_تشخيص, الأول: &متغير منطقي,
    المتوقع: &اختياري قيمة_حجة_رسالة, الموجود: &اختياري قيمة_حجة_رسالة,
    المفتاح: اختياري مفتاح_رسالة_تشخيص
): منطقي {
    طابق *المتوقع مع
    | اختياري.موجود(القيمة_المتوقعة) -> {
        طابق *الموجود مع
        | اختياري.موجود(القيمة_الموجودة) -> {
            طابق إطار_مقارنة_عدد_للمفتاح(المفتاح) مع
            | اختياري.موجود(الإطار) -> {
                طابق عدد_حقيقة_رسالة(&القيمة_المتوقعة) مع
                | اختياري.موجود(العدد_المتوقع) -> {
                    طابق عدد_حقيقة_رسالة(&القيمة_الموجودة) مع
                    | اختياري.موجود(العدد_الموجود) -> {
                        لو (!ألحق_فاصل_جملة(الباني, الأول)) { أرجع خطأ; };
                        لو (!ألحق_جملة_مقارنة_عدد(الباني, اللغة, العدد_المتوقع, العدد_الموجود, الإطار)) { أرجع خطأ; };
                        أرجع ألحق_نهاية_جملة(الباني);
                    }
                    | اختياري.لا_شيء -> { };
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
            دع المقدمة: نص = مقدمة_بند(اللغة, بند_سياق.بند_بداية_مقارنة(), المفتاح);
            دع الوسط: نص = مقدمة_بند(اللغة, بند_سياق.بند_وسط_مقارنة(), المفتاح);
            لو (!ألحق_فاصل_جملة(الباني, الأول)) { أرجع خطأ; };
            لو (!ألحق_قطعة(الباني, &المقدمة)) { أرجع خطأ; };
            لو (!ألحق_قيمة_سياق(الباني, اللغة, &القيمة_المتوقعة)) { أرجع خطأ; };
            لو (!ألحق_قطعة(الباني, &الوسط)) { أرجع خطأ; };
            لو (!ألحق_قيمة_سياق(الباني, اللغة, &القيمة_الموجودة)) { أرجع خطأ; };
            أرجع ألحق_نهاية_جملة(الباني);
        }
        | اختياري.لا_شيء -> {
            أرجع ألحق_جملة_بند(الباني, اللغة, الأول, بند_سياق.بند_متوقع_منفرد(), المتوقع, المفتاح);
        };
    }
    | اختياري.لا_شيء -> {
        أرجع ألحق_جملة_بند(الباني, اللغة, الأول, بند_سياق.بند_موجود_منفرد(), الموجود, المفتاح);
    };
}

// Appends `<base>` and one sentence per present fact. A false result may leave
// a partially appended message; clear the builder before reuse.
عام عرف ألحق_نص_بسياق_بمفتاح(
    الباني: &متغير باني_نص, اللغة: لغة_تشخيص, الأساس: نص,
    السياق: حقائق_سياق_رسالة, المفتاح: اختياري مفتاح_رسالة_تشخيص
): منطقي {
    لو (!ألحق_قطعة(الباني, &الأساس)) { أرجع خطأ; };
    دع الأول: متغير منطقي = صواب;
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_القيمة(), &السياق.القيمة, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_مقارنة_سياق(الباني, اللغة, &متغير الأول, &السياق.المتوقع, &السياق.الموجود, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الاستبدال(), &السياق.الاستبدال, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الفهرس(), &السياق.الفهرس, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الطول(), &السياق.الطول, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_المجال(), &السياق.المجال, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_النمط(), &السياق.النمط, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_المسار(), &السياق.المسار, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الرمز(), &السياق.الرمز, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_النوع(), &السياق.النوع, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_السياق(), &السياق.السياق, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_المرحلة(), &السياق.المرحلة, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الهدف(), &السياق.الهدف, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الدالة(), &السياق.الدالة, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الكتلة(), &السياق.الكتلة, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_التعليمة(), &السياق.التعليمة, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_العملية(), &السياق.العملية, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_البدائي(), &السياق.البدائي, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_المصدر(), &السياق.المصدر, المفتاح)) { أرجع خطأ; };
    لو (!ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_الوجهة(), &السياق.الوجهة, المفتاح)) { أرجع خطأ; };
    أرجع ألحق_جملة_بند(الباني, اللغة, &متغير الأول, بند_سياق.بند_السبب(), &السياق.السبب, المفتاح);
}

// Owned-text form of the same path; fixed text allocates no builder.
عام عرف نسق_نص_بسياق_بمفتاح(
    اللغة: لغة_تشخيص, الأساس: نص, السياق: حقائق_سياق_رسالة, المفتاح: اختياري مفتاح_رسالة_تشخيص
): اختياري نص {
    لو (سياق_رسالة_فارغ(&السياق)) { أرجع اختياري.موجود(الأساس); };
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة((الطول(الأساس) مثل طبيعي) + (96 مثل طبيعي));
    لو (!ألحق_نص_بسياق_بمفتاح(&متغير الباني, اللغة, الأساس, السياق, المفتاح)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(نص_باني_النص(&الباني));
}
