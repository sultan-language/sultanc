// A local loopback TCP connection probe executed inside an async task.
import std.io.println;
import std.text.number;
import std.async.runtime;
import std.async.net;
import std.net.socket_address;


def connect_probe(): int {
    let text: string = "127.0.0.1:1";
    match parse_socket_addr(&text) with
    | result.ok(address) -> {
        match tcp_connect_async(&address) with
        | result.ok(stream) -> { let close_result: result int, int = tcp_close_async(stream); return 1; }
        | result.err(_) -> { return 0; };
    }
    | result.err(_) -> { return 2; };
}

def main(): int {
    let job: mutable task<int> = spawn_task(fn(): int -> connect_probe());
    match await_task(&mutable job) with
    | option.some(n) -> { println(int_to_text(n)); }
    | option.none -> { return 1; };
    return 0;
}
