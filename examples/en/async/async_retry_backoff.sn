// Retrying with exponential backoff inside a task: an operation that fails twice is retried,
// and the wait doubles after each failure.
import std.io.println;
import std.text.number;
import std.async.runtime;

def sometimes_fails(attempt: int): result int, int {
    if (attempt < 3) { return result.err(attempt); };
    return result.ok(42);
}

def retry(): int {
    let count: mutable int = 0;
    let delay: mutable int = 1000000;
    while (count < 4) {
        count := count + 1;
        match sometimes_fails(count) with
        | result.ok(v) -> { return v; }
        | result.err(_) -> {
            sleep_task(delay);
            delay := delay * 2;
        };
    };
    return -1;
}

def main(): int {
    let worker: mutable task<int> = spawn_task(fn(): int -> retry());
    match await_task(&mutable worker) with
    | option.some(v) -> {
        if (v != 42) { return 1; };
        println(int_to_text(v));
    }
    | option.none -> { return 2; };
    return 0;
}
