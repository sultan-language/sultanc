// Cooperative task scheduler: async_timeouts.
import std.io.println;
import std.text.number;
import std.async.runtime;

def do_job(n: int): int { sleep_task(1000000); return n * 2; }

def main(): int {
    let job: mutable task<int> = spawn_task(fn(): int -> do_job(5));
    match await_task(&mutable job) with
    | option.some(n) -> { println(int_to_text(n)); }
    | option.none -> { return 1; };
    return 0;
}
