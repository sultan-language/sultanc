// A batch of asynchronous requests: start three tasks at once, then await each one and add
// up their results.
import std.io.println;
import std.text.number;
import std.async.runtime;

def request(id: int): int {
    sleep_task(5000000);
    return id * 10;
}

def main(): int {
    let a: mutable task<int> = spawn_task(fn(): int -> request(1));
    let b: mutable task<int> = spawn_task(fn(): int -> request(2));
    let c: mutable task<int> = spawn_task(fn(): int -> request(3));
    let sum: mutable int = 0;
    match await_task(&mutable a) with
    | option.some(v) -> { sum := sum + v; }
    | option.none -> { return 1; };
    match await_task(&mutable b) with
    | option.some(v) -> { sum := sum + v; }
    | option.none -> { return 2; };
    match await_task(&mutable c) with
    | option.some(v) -> { sum := sum + v; }
    | option.none -> { return 3; };
    if (sum != 60) { return 4; };
    println(int_to_text(sum));
    return 0;
}
