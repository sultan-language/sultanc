// Measuring how much a directory holds: create a directory with one 10-byte file and read
// the file's size.
import std.io.println;
import std.text.number;
import std.fs.write_file;
import std.fs.read_file;
import std.fs.mutation;
import std.fs.metadata;
import std.fs.walk;
import std.fs.path;
import std.text.transform;

def main(): int {
    let dir: string = "sultanc-dir-size";
    let file: string = "sultanc-dir-size/item.txt";
    let content: string = "1234567890";
    match create_dir_all(&dir) with
    | result.err(_) -> { return 1; }
    | _ -> { };
    match write_file(&file, &content) with
    | result.err(_) -> { return 2; }
    | _ -> { };
    let bytes: mutable int = 0;
    match path_size(&file) with
    | result.ok(size) -> { bytes := size; }
    | _ -> { };
    match remove_tree(&dir) with
    | result.err(_) -> { return 3; }
    | _ -> { };
    if (bytes != 10) { return 4; };
    println(int_to_text(bytes));
    return 0;
}
