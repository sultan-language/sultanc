// Counting files by extension: how many of the paths end in .sn.
import std.io.println;
import std.text.number;
import std.fs.write_file;
import std.fs.read_file;
import std.fs.mutation;
import std.fs.metadata;
import std.fs.walk;
import std.fs.path;
import std.text.transform;
import std.text.compare;

def main(): int {
    let paths: vector string = ["src/main.sn", "doc/readme.md", "src/lib.sn"];
    let count: mutable int = 0;
    let i: mutable int = 0;
    while (i < length(paths)) {
        match extension(&paths[i]) with
        | option.some(ext) -> {
            if (texts_equal(&ext, &"sn")) { count := count + 1; };
        }
        | _ -> { };
        i := i + 1;
    };
    if (count != 2) { return 1; };
    println(int_to_text(count));
    return 0;
}
