// Copying a file safely: copy it, then read the copy back and check it matches the original
// before cleaning up.
import std.io.println;
import std.text.number;
import std.fs.write_file;
import std.fs.read_file;
import std.fs.mutation;
import std.fs.metadata;
import std.fs.walk;
import std.fs.path;
import std.text.transform;
import std.text.compare;

def main(): int {
    let src: string = "sultanc-copy-source.tmp";
    let dest: string = "sultanc-copy-dest.tmp";
    let content: string = "verified copy";
    match write_file(&src, &content) with
    | result.err(_) -> { return 1; }
    | _ -> { };
    match copy_file(&src, &dest) with
    | result.err(_) -> { return 2; }
    | _ -> { };
    let valid: mutable bool = false;
    match read_file(&dest) with
    | result.ok(text) -> { valid := texts_equal(&text, &content); }
    | _ -> { };
    match remove_file(&src) with
    | result.err(_) -> { return 3; }
    | _ -> { };
    match remove_file(&dest) with
    | result.err(_) -> { return 4; }
    | _ -> { };
    if (!valid) { return 5; };
    println("copied");
    return 0;
}
