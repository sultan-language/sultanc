// Searching a directory recursively: walk the tree and find the file in a subdirectory.
import std.io.println;
import std.text.number;
import std.fs.write_file;
import std.fs.read_file;
import std.fs.mutation;
import std.fs.metadata;
import std.fs.walk;
import std.fs.path;
import std.text.transform;

def main(): int {
    let root: string = "sultanc-recursive-search";
    let inner: string = "sultanc-recursive-search/notes";
    let leaf: string = "sultanc-recursive-search/notes/todo.txt";
    let content: string = "found";
    match create_dir_all(&inner) with
    | result.err(_) -> { return 1; }
    | _ -> { };
    match write_file(&leaf, &content) with
    | result.err(_) -> { return 2; }
    | _ -> { };
    let count: mutable int = 0;
    match walk(&root) with
    | result.ok(entries) -> { count := length(entries); }
    | _ -> { };
    match remove_tree(&root) with
    | result.err(_) -> { return 3; }
    | _ -> { };
    if (count < 2) { return 4; };
    println(int_to_text(count));
    return 0;
}
