// Synchronization primitive: producer_consumer.
import std.io.println;
import std.text.number;
import std.sync.channel;


def main(): int {
    let ends: channel_ends<string> = channel<string>();
    match send(channel_ends_sender(&ends), "payload") with
    | result.err(_) -> { return 1; }
    | result.ok(_) -> { };
    match recv(channel_ends_receiver(&ends)) with
    | result.err(_) -> { return 2; }
    | result.ok(value) -> { println(value); };
    return 0;
}
