// The factorial of 12 (479001600), computed by multiplying in a loop.
import std.io.println;
import std.text.number;

def factorial(n: int): int {
    let out: mutable int = 1;
    let i: mutable int = 2;
    while (i <= n) {
        out := out * i;
        i := i + 1;
    };
    return out;
}

def main(): int {
    let answer: int = factorial(12);
    if (answer != 479001600) { return 1; };
    println(int_to_text(answer));
    return 0;
}
