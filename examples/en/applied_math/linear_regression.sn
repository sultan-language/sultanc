// The least-squares slope of a line through four points, from the sums of x, y, xy and x².
import std.io.println;
import std.text.number;

def main(): int {
    let xs: vector int = [1, 2, 3, 4];
    let ys: vector int = [3, 5, 7, 9];
    let n: int = length(xs);
    let sx: mutable int = 0;
    let sy: mutable int = 0;
    let sxy: mutable int = 0;
    let sx2: mutable int = 0;
    let i: mutable int = 0;
    while (i < n) {
        sx := sx + xs[i];
        sy := sy + ys[i];
        sxy := sxy + xs[i] * ys[i];
        sx2 := sx2 + xs[i] * xs[i];
        i := i + 1;
    };
    let slope: int = (n * sxy - sx * sy) / (n * sx2 - sx * sx);
    if (slope != 2) { return 1; };
    println(int_to_text(slope));
    return 0;
}
