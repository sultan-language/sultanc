// Fibonacci numbers by fast doubling: walk the bits of n from the top, using
// F(2k) = F(k) * (2F(k+1) - F(k)) and F(2k+1) = F(k)^2 + F(k+1)^2.
import std.io.println;
import std.text.number;

def fib(n: int): int {
    let a: mutable int = 0;
    let b: mutable int = 1;
    let bit: mutable int = 1;
    while (bit <= n) {
        bit := bit * 2;
    };
    bit := bit / 2;
    while (bit > 0) {
        let c: int = a * (2 * b - a);
        let d: int = a * a + b * b;
        if ((n & bit) == 0) {
            a := c;
            b := d;
        } else {
            a := d;
            b := c + d;
        };
        bit := bit / 2;
    };
    return a;
}

def main(): int {
    let answer: int = fib(20);
    if (answer != 6765) { return 1; };
    println(int_to_text(answer));
    return 0;
}
