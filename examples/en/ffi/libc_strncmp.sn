// Call the actual C library function strncmp; link with -l c.
import std.io.println;
import std.text.number;

extern def strncmp(first: *u8, second: *u8, size: uint): i32;
def main(): int {
    let first: mutable vector u8 = [65 as u8, 66 as u8, 67 as u8, 0 as u8];
    let second: mutable vector u8 = [65 as u8, 66 as u8, 68 as u8, 0 as u8];
    let compare: mutable i32 = 1 as i32;
    unsafe { compare := strncmp(&first[0], &second[0], 2 as uint); }
    if (compare == 0 as i32) { println("matching two-byte prefixes"); } else { return 1; };
    return 0;
}
