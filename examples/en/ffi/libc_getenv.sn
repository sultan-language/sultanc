// Call the actual C library function getenv; link with -l c.
import std.io.println;
import std.text.number;

extern def getenv(data: *u8): *u8;
def main(): int {
    let key: mutable vector u8 = [80 as u8, 65 as u8, 84 as u8, 72 as u8, 0 as u8];
    let output: mutable *u8 = &key[0];
    unsafe { output := getenv(&key[0]); }
    unsafe { if (*output != 0 as u8) { println("PATH is defined"); } else { return 1; }; };
    return 0;
}
