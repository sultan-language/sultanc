// A simple JSON patch: change a value in the source text, then parse the result and print
// it in canonical form.
import std.io.println;
import std.text.number;
import std.text.transform;
import std.json.parse;
import std.json.stringify;

def main(): int {
    let source: string = "{\"version\":1}";
    let before: string = "1";
    let after: string = "2";
    let patched: string = replace(&source, &before, &after);
    match parse_json(&patched) with
    | result.ok(doc) -> {
        match stringify_json(&doc) with
        | result.ok(text) -> { println(text); }
        | result.err(_) -> { return 2; };
    }
    | result.err(_) -> { return 1; };
    return 0;
}
