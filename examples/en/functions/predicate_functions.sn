// Pass a callback and compose two transformations (predicate_functions).
import std.io.println;
import std.text.number;

def double(x: int): int { return x * 2; }
def increment(x: int): int { return x + 1; }
def apply(f: fn(int): int, x: int): int { return f(x); }

def main(): int {
    let callback: fn(int): int = double;
    let first: int = apply(callback, 9);
    let second: int = apply(increment, first);
    println(int_to_text(second));
    return 0;
}
