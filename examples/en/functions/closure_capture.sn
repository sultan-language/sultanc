// A closure captures a value (closure_capture).
import std.io.println;
import std.text.number;

def add_offset(offset: int): fn(int): int { return fn(x: int): int -> x + offset; }

def main(): int {
    let addition: fn(int): int = add_offset(5);
    println(int_to_text(addition(10)));
    return 0;
}
