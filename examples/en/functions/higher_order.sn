// Functions passed as values: transform, filter and fold a vector.
import std.io.println;
import std.text.number;

def transform(values: &vector int, f: fn(int): int): vector int {
    let output: mutable vector int = [];
    let i: mutable uint = 0;
    while (i < (length(*values) as uint)) {
        append(output, f((*values)[i]));
        i := i + 1;
    }
    return output;
}

def keep(values: &vector int, test: fn(int): bool): vector int {
    let output: mutable vector int = [];
    let i: mutable uint = 0;
    while (i < (length(*values) as uint)) {
        if (test((*values)[i])) { append(output, (*values)[i]); };
        i := i + 1;
    }
    return output;
}

def fold(values: &vector int, start: int, combine: fn(int, int): int): int {
    let total: mutable int = start;
    let i: mutable uint = 0;
    while (i < (length(*values) as uint)) {
        total := combine(total, (*values)[i]);
        i := i + 1;
    }
    return total;
}

def square(value: int): int { return value * value; }
def is_even(value: int): bool { return value % 2 == 0; }
def add(left: int, right: int): int { return left + right; }

def main(): int {
    let numbers: vector int = [1, 2, 3, 4, 5, 6];
    let squares: vector int = transform(&numbers, square);
    let even_squares: vector int = keep(&squares, is_even);
    println(int_to_text(fold(&even_squares, 0, add)));
    println(uint_to_text(length(even_squares) as uint));
    return 0;
}
