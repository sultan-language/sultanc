// TLS client configuration, offline (cipher_selection); does not open a TLS socket.
import std.io.println;
import std.text.number;
import std.tls.config;


def main(): int {
    let domain: string = "example.test";
    let cfg: mutable tls_client_config = tls_client_config_default(&domain);
    let alpn: vector string = ["h2", "http/1.1"];
    tls_client_config_set_protocols(&mutable cfg, &alpn);
    if (tls_client_config_verifies_peer(&cfg)) { println("peer verification enabled"); } else { return 1; };
    return 0;
}
