// Checking a four-queens solution: no two queens share a row or a diagonal.
import std.io.println;
import std.text.number;

def safe(positions: &vector int, column: int, row: int): bool {
    let c: mutable int = 0;
    while (c < column) {
        let r: int = (*positions)[c];
        if (r == row || r - c == row - column || r + c == row + column) { return false; };
        c := c + 1;
    };
    return true;
}

def main(): int {
    let rows: vector int = [1, 3, 0, 2];
    let i: mutable int = 0;
    while (i < 4) {
        if (!safe(&rows, i, rows[i])) { return 1; };
        i := i + 1;
    };
    println("four queens solved");
    return 0;
}
