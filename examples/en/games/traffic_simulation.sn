// One step of a traffic simulation: each car moves one cell forward when the cell ahead is
// free, otherwise it stays.
import std.io.println;
import std.text.number;

def main(): int {
    let road: vector int = [1, 0, 0, 1, 0, 1, 0, 0];
    let after: mutable vector int = [0, 0, 0, 0, 0, 0, 0, 0];
    let i: mutable int = 0;
    while (i < length(road)) {
        if (road[i] == 1) {
            if (i + 1 < length(road) && road[i + 1] == 0) {
                after[i + 1] := 1;
            } else {
                after[i] := 1;
            };
        };
        i := i + 1;
    };
    if (after[1] != 1 || after[4] != 1 || after[6] != 1) { return 1; };
    println("traffic advanced");
    return 0;
}
