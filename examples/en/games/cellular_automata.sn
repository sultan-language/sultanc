// One step of a one-dimensional cellular automaton (rule 90): each new cell is the XOR of
// its two neighbors.
import std.io.println;
import std.text.number;

def main(): int {
    let cells: vector int = [0, 0, 1, 0, 0, 0, 0];
    let next: mutable vector int = [0, 0, 0, 0, 0, 0, 0];
    let i: mutable int = 1;
    while (i < 6) {
        next[i] := cells[i - 1] ^ cells[i + 1];
        i := i + 1;
    };
    if (next[1] != 1 || next[3] != 1) { return 1; };
    println(int_to_text(next[1] + next[3]));
    return 0;
}
