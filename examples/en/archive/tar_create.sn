// TAR archive example: tar_create (write, 2 file entries).
import std.io.println;
import std.text.number;
import std.archive.tar;


def main(): int {
    let entries: mutable vector tar_entry = [];
    append(entries, new_tar_file("tar_create_0.txt", [65 as u8, 10 as u8]));
    append(entries, new_tar_file("tar_create_1.txt", [66 as u8, 10 as u8]));
    match tar_encode(&entries) with
    | result.ok(data) -> { println(uint_to_text(length(data) as uint)); }
    | result.err(_) -> { return 1; };
    return 0;
}
