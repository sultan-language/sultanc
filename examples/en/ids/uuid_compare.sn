// Worked ids example: uuid_compare.
import std.io.println;
import std.text.number;
import std.uuid.uuid;


def main(): int {
    let first: uuid = nil_uuid();
    let second: uuid = max_uuid();
    if (!uuid_equal(&first,&second)) { println("different UUIDs"); } else { return 1; };
    return 0;
}
