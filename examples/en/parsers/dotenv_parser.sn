// Parsing a .env file: split it into lines, then split a line at "=" into a key and a value.
import std.io.println;
import std.text.number;
import std.text.transform;

def main(): int {
    let source: string = "LANG=ar\nMODE=dev\n";
    let lines: vector string = split(&source, &"\n");
    let assign: string = "=";
    let pairs: vector string = split(&lines[0], &assign);
    if (length(pairs) != 2) { return 1; };
    println(clone(&pairs[1]));
    return 0;
}
