// Parsing an HTTP header line: split it at ": " into a name and a value.
import std.io.println;
import std.text.number;
import std.text.transform;

def main(): int {
    let source: string = "Content-Type: application/json";
    let sep: string = ": ";
    let parts: vector string = split(&source, &sep);
    if (length(parts) != 2) { return 1; };
    println(clone(&parts[1]));
    return 0;
}
