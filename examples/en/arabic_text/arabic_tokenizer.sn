// Splitting an Arabic sentence into words at the spaces.
import std.io.println;
import std.text.number;
import std.text.transform;

def main(): int {
    let source: string = "برمجة عربية حديثة";
    let space: string = " ";
    let words: vector string = split(&source, &space);
    if (length(words) != 3) { return 1; };
    println(clone(&words[1]));
    return 0;
}
