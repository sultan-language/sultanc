// Recording metadata with a definition-time decorator: @@register("/metadata") stores a path
// next to the handler in a route table.
import std.io.println;
import std.text.number;

type Entry = { path: string, handler: fn(int): int };

let routes: mutable vector Entry = [];

def register(path: string, handler: fn(int): int): void {
    unsafe { append(routes, { path: path, handler: handler }); }
}

@@register("/metadata")
def handler(x: int): int {
    return x + 10;
}

def main(): int {
    let count: uint;
    let output: int;
    unsafe {
        count := length(routes) as uint;
        output := routes[0].handler(10);
    }
    if (count != 1 || output != 20) { return 1; };
    println(int_to_text(output));
    return 0;
}
