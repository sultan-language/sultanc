// A decorator on a recursive function: @nonnegative guards factorial, which calls itself.
import std.io.println;
import std.text.number;

def nonnegative(comptime f: fn(int): int, x: int): int {
    if (x < 0) { return 0; };
    return f(x);
}

@nonnegative
def factorial(x: int): int {
    if (x <= 1) { return 1; };
    return x * factorial(x - 1);
}

def main(): int {
    let answer: int = factorial(5);
    if (answer != 120) { return 1; };
    println(int_to_text(answer));
    return 0;
}
