// A decorator on a function that calls a generic function: @add_one wraps concrete, which
// uses identity<int>.
import std.io.println;
import std.text.number;

def identity<T>(x: T): T {
    return x;
}

def add_one(comptime f: fn(int): int, x: int): int {
    return f(x) + 1;
}

@add_one
def concrete(x: int): int {
    return identity<int>(x) * 2;
}

def main(): int {
    let answer: int = concrete(5);
    if (answer != 11) { return 1; };
    println(int_to_text(answer));
    return 0;
}
