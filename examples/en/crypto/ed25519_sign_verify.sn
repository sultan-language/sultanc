// Ed25519 signatures: derive a public key from a seed, sign a message and verify the
// signature.
import std.io.println;
import std.text.number;
import std.text.from_bytes;
import std.crypto.ed25519;

def main(): int {
    let seed: mutable vector u8 = [];
    let i: mutable int = 0;
    while (i < 32) {
        append(seed, (i + 1) as u8);
        i := i + 1;
    };
    let message: vector u8 = bytes_from_text("signed message");
    match ed25519_public_key(&seed) with
    | option.some(public_key) -> {
        match ed25519_sign(&seed, &message) with
        | option.some(signature) -> {
            if (!ed25519_verify(&public_key, &message, &signature)) { return 1; };
            println("signature verified");
        }
        | option.none -> { return 2; };
    }
    | option.none -> { return 3; };
    return 0;
}
