// Password hashing with PBKDF2-HMAC-SHA-256: derive a 32-byte key from a password and a salt
// and print it in hexadecimal.
import std.io.println;
import std.text.number;
import std.text.from_bytes;
import std.crypto.digest;
import std.encoding.hex;

def main(): int {
    let password: vector u8 = bytes_from_text("example password");
    let salt: vector u8 = bytes_from_text("unique salt");
    match pbkdf2_hmac_sha256(&password, &salt, 20, 32) with
    | option.some(key) -> {
        if (length(key) != 32) { return 1; };
        println(hex_encode(&key));
    }
    | option.none -> { return 2; };
    return 0;
}
