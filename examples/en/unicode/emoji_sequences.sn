// Unicode processing: emoji_sequences.
import std.io.println;
import std.text.number;
import std.unicode.grapheme;


def main(): int {
    let text: string = "👩‍💻";
    match حدود_عناقيد_بايتات_يونيكود(&text) with
    | result.ok(boundaries) -> { println(uint_to_text(length(boundaries) as uint)); }
    | result.err(_) -> { return 1; };
    return 0;
}
