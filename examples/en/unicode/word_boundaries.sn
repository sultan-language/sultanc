// Unicode processing: word_boundaries.
import std.io.println;
import std.text.number;
import std.unicode.word_boundary;


def main(): int {
    let text: string = "Hello world!";
    match حدود_كلمات_بايتات_يونيكود(&text) with
    | result.ok(boundaries) -> { println(uint_to_text(length(boundaries) as uint)); }
    | result.err(_) -> { return 1; };
    return 0;
}
