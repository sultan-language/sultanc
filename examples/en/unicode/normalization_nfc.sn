// Unicode processing: normalization_nfc.
import std.io.println;
import std.text.number;
import std.unicode.normalization;


def main(): int {
    let input: string = "Cafe\u0301";
    match unicode_normalize(&input, صورة_تطبيع_يونيكود.إن_إف_سي()) with
    | result.ok(out) -> { println(out); }
    | result.err(_) -> { return 1; };
    return 0;
}
