// An HTTP GET over loopback TCP, with client and server in one program: the server answers
// with a JSON body and the client reads the whole response back.
import std.io.println;
import std.text.number;
import std.net.socket_address;
import std.net.tcp;
import std.text.from_bytes;

def main(): int {
    let addr: socket_addr;
    match parse_socket_addr(&"127.0.0.1:40100") with
    | result.ok(a) -> { addr := a; }
    | result.err(_) -> { return 1; };
    let listener: tcp_listener;
    match tcp_bind(&addr, 8) with
    | result.ok(l) -> { listener := l; }
    | result.err(_) -> { return 2; };
    let client: tcp_stream;
    match tcp_connect(&addr) with
    | result.ok(s) -> { client := s; }
    | result.err(_) -> { return 3; };
    let server: tcp_stream;
    match tcp_accept(&listener) with
    | result.ok(s) -> { server := s; }
    | result.err(_) -> { return 4; };
    let req: vector u8 = bytes_from_text("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
    match tcp_write(&client, &req, 0, length(req)) with
    | result.ok(n) -> {
        if (n != length(req)) { return 5; };
    }
    | result.err(_) -> { return 6; };
    let inbound: mutable vector u8 = [];
    let i: mutable int = 0;
    while (i < length(req)) {
        append(inbound, 0);
        i := i + 1;
    };
    match tcp_read(&server, &mutable inbound, 0, length(req)) with
    | result.ok(n) -> {
        if (n != length(req)) { return 7; };
    }
    | result.err(_) -> { return 8; };
    let answer: vector u8 = bytes_from_text("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 4\r\n\r\ntrue");
    match tcp_write(&server, &answer, 0, length(answer)) with
    | result.ok(n) -> {
        if (n != length(answer)) { return 9; };
    }
    | result.err(_) -> { return 10; };
    let received: mutable vector u8 = [];
    i := 0;
    while (i < length(answer)) {
        append(received, 0);
        i := i + 1;
    };
    match tcp_read(&client, &mutable received, 0, length(answer)) with
    | result.ok(n) -> {
        if (n != length(answer)) { return 11; };
    }
    | result.err(_) -> { return 12; };
    if (length(received) != length(answer)) { return 13; };
    if (received[0] != answer[0]) { return 14; };
    let closed1: result int, int = tcp_stream_close(server);
    let closed2: result int, int = tcp_stream_close(client);
    let closed3: result int, int = tcp_listener_close(listener);
    println(int_to_text(length(received)));
    return 0;
}
