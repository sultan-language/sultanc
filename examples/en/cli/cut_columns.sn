// A small cut: split the first argument, or a default CSV line, at commas and print the
// second column.
import std.io.println;
import std.process.argument_count;
import std.process.argument;
import std.text.number;
import std.text.transform;

def read_input(default: string): string {
    if (argument_count() > 1) {
        match argument(1) with
        | option.some(text) -> {
            if (length(text) > 0) { return text; };
        }
        | option.none -> { };
    };
    return default;
}

def main(): int {
    let text: string = read_input("Ali,25,Canada");
    let cols: vector string = split(&text, &",");
    if (length(cols) < 2) { return 1; };
    println(clone(&cols[1]));
    return 0;
}
