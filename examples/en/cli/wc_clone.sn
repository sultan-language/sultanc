// A small wc: count the words of the input.
import std.io.println;
import std.process.argument_count;
import std.process.argument;
import std.text.number;
import std.text.transform;

def read_input(default: string): string {
    if (argument_count() > 1) {
        match argument(1) with
        | option.some(text) -> {
            if (length(text) > 0) { return text; };
        }
        | option.none -> { };
    };
    return default;
}

def main(): int {
    let text: string = read_input("hello from SultanC");
    let words: vector string = split(&text, &" ");
    let count: int = length(words);
    if (count < 1) { return 1; };
    println(int_to_text(count));
    return 0;
}
