// HTTP request-target query: cookies.
import std.io.println;
import std.text.number;
import std.http.query;


def main(): int {
    let target: string = "/items?page=6&sort=asc";
    println(http_target_path(&target));
    match http_target_query(&target) with
    | option.some(q) -> { println(q); }
    | option.none -> { println("no query"); };
    return 0;
}
