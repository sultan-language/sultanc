// Self-checking example: parameterized_cases.
import std.io.println;
import std.text.number;
import std.debug.assert;

def sum_to(n: int): int { let i: mutable int = 1; let sum: mutable int = 0; while (i <= n) { sum := sum + i; i := i + 1; }; return sum; }
def main(): int {
    let i: mutable int = 1;
    while (i <= 5) { assert(sum_to(i) == (i * (i + 1) / 2)); i := i + 1; };
    println("five parameterized checks passed");
    return 0;
}
