// Self-checking example: fixture_cleanup.
import std.io.println;
import std.text.number;
import std.debug.assert;


def main(): int {
    let mutable_list: mutable vector int = [5, 6, 7];
    assert(length(mutable_list) == 3);
    mutable_list := [];
    assert(length(mutable_list) == 0);
    println("fixture cleared");
    return 0;
}
