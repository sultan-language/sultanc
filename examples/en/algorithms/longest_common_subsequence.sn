// Longest common subsequence of two sequences, filled in a dynamic-programming table.
import std.io.println;
import std.text.number;

def main(): int {
    let a: vector int = [1, 2, 3, 4];
    let b: vector int = [2, 4, 3, 4];
    let width: int = length(b) + 1;
    let dp: mutable vector int = [];
    let i: mutable int = 0;
    while (i < (length(a) + 1) * width) {
        append(dp, 0);
        i := i + 1;
    };
    i := 1;
    while (i <= length(a)) {
        let j: mutable int = 1;
        while (j <= length(b)) {
            if (a[i - 1] == b[j - 1]) {
                dp[i * width + j] := dp[(i - 1) * width + j - 1] + 1;
            } else {
                let x: int = dp[(i - 1) * width + j];
                let y: int = dp[i * width + j - 1];
                if (x > y) { dp[i * width + j] := x; } else { dp[i * width + j] := y; };
            };
            j := j + 1;
        };
        i := i + 1;
    };
    let answer: int = dp[length(a) * width + length(b)];
    if (answer != 3) { return 1; };
    println(int_to_text(answer));
    return 0;
}
