// 0/1 knapsack with a one-dimensional table: the best total value of items that fit in
// a capacity of 5.
import std.io.println;
import std.text.number;

def main(): int {
    let weights: vector int = [2, 3, 4];
    let values: vector int = [4, 5, 6];
    let dp: mutable vector int = [0, 0, 0, 0, 0, 0];
    let i: mutable int = 0;
    while (i < 3) {
        let cap: mutable int = 5;
        while (cap >= weights[i]) {
            let candidate: int = dp[cap - weights[i]] + values[i];
            if (candidate > dp[cap]) { dp[cap] := candidate; };
            cap := cap - 1;
        };
        i := i + 1;
    };
    if (dp[5] != 9) { return 1; };
    println(int_to_text(dp[5]));
    return 0;
}
