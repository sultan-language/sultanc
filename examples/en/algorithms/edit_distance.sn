// Edit distance between two sequences with a dynamic-programming table: the fewest
// insertions, deletions and substitutions that turn one into the other.
import std.io.println;
import std.text.number;

def main(): int {
    let a: vector int = [1, 2, 3];
    let b: vector int = [1, 4, 3, 5];
    let width: int = length(b) + 1;
    let dp: mutable vector int = [];
    let i: mutable int = 0;
    while (i < (length(a) + 1) * width) {
        append(dp, 0);
        i := i + 1;
    };
    i := 0;
    while (i <= length(a)) {
        dp[i * width] := i;
        i := i + 1;
    };
    i := 0;
    while (i < width) {
        dp[i] := i;
        i := i + 1;
    };
    i := 1;
    while (i <= length(a)) {
        let j: mutable int = 1;
        while (j < width) {
            let cost: mutable int = 1;
            if (a[i - 1] == b[j - 1]) { cost := 0; };
            let del: int = dp[(i - 1) * width + j] + 1;
            let ins: int = dp[i * width + j - 1] + 1;
            let sub: int = dp[(i - 1) * width + j - 1] + cost;
            let best: mutable int = del;
            if (ins < best) { best := ins; };
            if (sub < best) { best := sub; };
            dp[i * width + j] := best;
            j := j + 1;
        };
        i := i + 1;
    };
    let answer: int = dp[length(a) * width + length(b)];
    if (answer != 2) { return 1; };
    println(int_to_text(answer));
    return 0;
}
