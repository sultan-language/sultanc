// Actual depth first search implementation over an in-memory graph/vector.
import std.io.println;
import std.text.number;

def walk(graph: &vector vector int, node: int, visited: &mutable vector bool, order: &mutable vector int): void {
    if ((*visited)[node]) { return; };
    (*visited)[node] := true;
    append(*order, node);
    let i: mutable int = 0;
    while (i < length((*graph)[node])) {
        walk(graph, (*graph)[node][i], visited, order);
        i := i + 1;
    }
}

def main(): int {
    let graph: vector vector int = [[1, 2], [3], [4], [], []];
    let seen: mutable vector bool = [false, false, false, false, false];
    let order: mutable vector int = [];
    walk(&graph, 0, &mutable seen, &mutable order);
    println(int_to_text(length(order)));
    return 0;
}
