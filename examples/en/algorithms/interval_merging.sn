// Merging overlapping intervals: walk the sorted intervals, join the ones that overlap
// and add up the length the merged intervals cover.
import std.io.println;
import std.text.number;

type Interval = { start: int, end: int };

def main(): int {
    let items: vector Interval = [
        { start: 1, end: 3 },
        { start: 2, end: 5 },
        { start: 7, end: 9 },
        { start: 8, end: 10 }
    ];
    let total: mutable int = 0;
    let start: mutable int = items[0].start;
    let finish: mutable int = items[0].end;
    let i: mutable int = 1;
    while (i < length(items)) {
        let x: Interval = items[i];
        if (x.start <= finish) {
            if (x.end > finish) { finish := x.end; };
        } else {
            total := total + (finish - start);
            start := x.start;
            finish := x.end;
        };
        i := i + 1;
    };
    total := total + (finish - start);
    if (total != 7) { return 1; };
    println(int_to_text(total));
    return 0;
}
