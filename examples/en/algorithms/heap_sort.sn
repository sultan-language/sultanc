// Actual heap sort implementation over an in-memory graph/vector.
import std.io.println;
import std.text.number;

def sift_down(values: &mutable vector int, start: int, end: int): void {
    let root: mutable int = start;
    while (root * 2 + 1 <= end) {
        let child: mutable int = root * 2 + 1;
        if (child + 1 <= end && (*values)[child] < (*values)[child + 1]) { child := child + 1; };
        if ((*values)[root] >= (*values)[child]) { return; };
        let temp: int = (*values)[root];
        (*values)[root] := (*values)[child];
        (*values)[child] := temp;
        root := child;
    }
}
def heap_sort(values: &mutable vector int): void {
    let size: int = length(*values);
    let i: mutable int = (size / 2) - 1;
    while (i >= 0) { sift_down(values, i, size - 1); i := i - 1; }
    let end: mutable int = size - 1;
    while (end > 0) {
        let temp: int = (*values)[end]; (*values)[end] := (*values)[0]; (*values)[0] := temp;
        end := end - 1;
        sift_down(values, 0, end);
    }
}

def main(): int {
    let numbers: mutable vector int = [9, 2, 7, 1, 5, 3];
    heap_sort(&mutable numbers);
    println(int_to_text(numbers[0] * 100 + numbers[5]));
    return 0;
}
