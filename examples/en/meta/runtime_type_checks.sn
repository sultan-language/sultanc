// Compile-time type introspection: runtime_type_checks.
import std.io.println;
import std.text.number;
import std.meta.reflect;


def main(): int {
    let a: u64 = 3 as u64;
    let b: u32 = 3 as u32;
    if (size_of(&a) > size_of(&b)) { println("u64 wider than u32"); } else { return 1; };
    return 0;
}
