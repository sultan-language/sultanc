// Compile-time type introspection: derive_metadata.
import std.io.println;
import std.text.number;
import std.meta.reflect;

type Position = { x: i32, y: i32 };
def main(): int {
    let point: Position = { x: 2 as i32, y: 4 as i32 };
    let count: u64 = field_count(&point);
    println(uint_to_text(count as uint));
    return 0;
}
