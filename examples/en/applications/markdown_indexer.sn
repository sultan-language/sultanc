// A Markdown indexer: split a document into lines and count the headings.
import std.io.println;
import std.text.number;
import std.text.transform;
import std.text.search;

def main(): int {
    let document: string = "# Introduction\nSome content\n## Implementation\ntext\n## Tests\n";
    let lines: vector string = split(&document, &"\n");
    let marker: string = "#";
    let headings: mutable int = 0;
    let i: mutable int = 0;
    while (i < length(lines)) {
        if (starts_with(&lines[i], &marker)) { headings := headings + 1; };
        i := i + 1;
    };
    if (headings != 3) { return 1; };
    println(int_to_text(headings));
    return 0;
}
