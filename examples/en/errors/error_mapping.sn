// Typed result and recoverable error: error_mapping.
import std.io.println;
import std.text.number;

def divide(a: int, b: int): result int, int { if (b == 0) { return result.err(1); }; return result.ok(a / b); }

def main(): int {
    match divide(24, 3) with
    | result.ok(n) -> { println(int_to_text(n)); }
    | result.err(_) -> { println("division error"); };
    return 0;
}
