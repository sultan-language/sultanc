// Results from nested calls: the outer function adds 10 to the inner function's error code
// before returning it.
import std.io.println;
import std.text.number;

def divide(a: int, b: int): result int, int {
    if (b == 0) { return result.err(2); };
    return result.ok(a / b);
}

def outer(a: int, b: int): result int, int {
    match divide(a, b) with
    | result.ok(v) -> { return result.ok(v + 1); }
    | result.err(e) -> { return result.err(e + 10); };
}

def main(): int {
    match outer(20, 0) with
    | result.err(e) -> {
        if (e != 12) { return 1; };
        println(int_to_text(e));
    }
    | _ -> { return 1; };
    return 0;
}
