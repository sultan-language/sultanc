// Recovering and continuing: skip the items that fail to parse and add up the rest.
import std.io.println;
import std.text.number;

def parse_small(value: int): result int, int {
    if (value < 0) { return result.err(1); };
    return result.ok(value);
}

def main(): int {
    let items: vector int = [2, -1, 3, -4, 5];
    let total: mutable int = 0;
    let i: mutable int = 0;
    while (i < length(items)) {
        match parse_small(items[i]) with
        | result.ok(n) -> { total := total + n; }
        | result.err(_) -> { };
        i := i + 1;
    };
    if (total != 10) { return 1; };
    println(int_to_text(total));
    return 0;
}
