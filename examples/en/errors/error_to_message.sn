// Turning an error code into a message the user can read.
import std.io.println;
import std.text.number;

def check(x: int): result int, int {
    if (x < 0) { return result.err(10); };
    return result.ok(x);
}

def message(code: int): string {
    if (code == 10) { return "negative input"; };
    return "unknown error";
}

def main(): int {
    match check(-5) with
    | result.err(code) -> { println(message(code)); }
    | _ -> { return 1; };
    return 0;
}
