// A hash table with open addressing: each key goes to key % 7 and, on a collision, to the
// next free slot.
import std.io.println;
import std.text.number;

def main(): int {
    let slots: mutable vector int = [-1, -1, -1, -1, -1, -1, -1];
    let keys: vector int = [12, 19, 26];
    let i: mutable int = 0;
    while (i < length(keys)) {
        let pos: mutable int = keys[i] % 7;
        while (slots[pos] != -1) {
            pos := (pos + 1) % 7;
        };
        slots[pos] := keys[i];
        i := i + 1;
    };
    let count: mutable int = 0;
    i := 0;
    while (i < length(slots)) {
        if (slots[i] != -1) { count := count + 1; };
        i := i + 1;
    };
    if (count != 3) { return 1; };
    println(int_to_text(count));
    return 0;
}
