// مثال على مجاميع التحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.مجاميع_تحقق.مجاميع_تحقق;


عرف الرئيسية(): عدد {
    دع البيانات: متجه ط8 = بايتات_من_نص("بيانات لمقارنة مجموع التحقق خمسة");
    اطبع_سطر(طبيعي_إلى_نص(احسب_سي_ار_سي32(&البيانات) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(احسب_أدلر32(&البيانات) مثل طبيعي));
    أرجع 0;
}
