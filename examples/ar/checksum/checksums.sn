// مجموعا التحقق CRC-32 وAdler-32 للبايتات نفسها.
استورد std.io.println;
استورد std.text.number;
استورد std.text.from_bytes;
استورد std.checksum.checksum;

عرف الرئيسية(): عدد {
    دع البيانات: متجه ط8 = بايتات_من_نص("hello world");
    اطبع_سطر(طبيعي_إلى_نص(احسب_سي_ار_سي32(&البيانات) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(احسب_أدلر32(&البيانات) مثل طبيعي));
    أرجع 0;
}
