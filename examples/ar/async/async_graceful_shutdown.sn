// إيقاف لطيف برمز إلغاء: تدور مهمة عاملة حتى تلغيها المهمة الرئيسية، ثم تعيد عدد الدورات
// التي نفذتها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;
استورد المكتبة.تزامن.إلغاء;

عرف العامل(الرمز_اللغوي: رمز_إلغاء): عدد {
    ليكن التكرارات: متغير عدد = 0;
    طالما (!هل_ألغي_الرمز(&الرمز_اللغوي) && التكرارات < 1000) {
        تنازل_مهمة();
        التكرارات := التكرارات + 1;
    };
    إذا (!هل_ألغي_الرمز(&الرمز_اللغوي)) { أرجع -1; };
    أرجع التكرارات;
}

عرف الرئيسية(): عدد {
    ليكن الرمز_اللغوي: رمز_إلغاء = أنشئ_رمز_إلغاء();
    ليكن عملية_ابن: رمز_إلغاء = استنسخ_رمز_إلغاء(&الرمز_اللغوي);
    ليكن العمل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> العامل(عملية_ابن));
    تنازل_مهمة();
    ألغ_الرمز(&الرمز_اللغوي);
    طابق انتظر_مهمة(&متغير العمل) مع
    | اختياري.موجود(ن) -> {
        إذا (ن < 0) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(ن));
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
