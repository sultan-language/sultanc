// مثال على المهام غير المتزامنة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف نفذ_المهمة(ن: عدد): عدد { تنازل_مهمة(); أرجع ن * 2; }

عرف الرئيسية(): عدد {
    دع المهمة: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نفذ_المهمة(4));
    طابق انتظر_مهمة(&متغير المهمة) مع
    | اختياري.موجود(ن) -> { اطبع_سطر(عدد_إلى_نص(ن)); }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
