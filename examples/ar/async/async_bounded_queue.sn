// طابور محدود داخل مهمة غير متزامنة: يتسع لعنصرين على الأكثر، ويُسحب منه عنصر كلما امتلأ،
// مع التخلي عن التنفيذ بين الخطوات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف استهلك_بحد(): عدد {
    ليكن الطابور: متغير متجه عدد = [];
    ليكن المنتج: متغير عدد = 1;
    ليكن المجموع: متغير عدد = 0;
    طالما (المنتج <= 5 || الطول(الطابور) > 0) {
        إذا (المنتج <= 5 && الطول(الطابور) < 2) {
            ألحق(الطابور, المنتج);
            المنتج := المنتج + 1;
        } وإلا {
            المجموع := المجموع + الطابور[0];
            ليكن ف: متغير عدد = 0;
            طالما (ف + 1 < الطول(الطابور)) {
                الطابور[ف] := الطابور[ف + 1];
                ف := ف + 1;
            };
            ليكن المقلص: متغير متجه عدد = [];
            ف := 0;
            طالما (ف < الطول(الطابور) - 1) {
                ألحق(المقلص, الطابور[ف]);
                ف := ف + 1;
            };
            الطابور := المقلص;
        };
        تنازل_مهمة();
    };
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن العامل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> استهلك_بحد());
    طابق انتظر_مهمة(&متغير العامل) مع
    | اختياري.موجود(القيمة) -> {
        إذا (القيمة != 15) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(القيمة));
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
