// مهلة بمهمة مراقبة: تنتهي مهمة المراقبة أولا والعمل البطيء ما زال جاريا، ثم يُنتظر العمل
// حتى لا يبقى شيء معلقا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف عمل_بطيء(): عدد {
    نم_مهمة(30000000);
    أرجع 9;
}

عرف المراقب(): عدد {
    نم_مهمة(5000000);
    أرجع 1;
}

عرف الرئيسية(): عدد {
    ليكن العمل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> عمل_بطيء());
    ليكن المؤقت: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> المراقب());
    طابق انتظر_مهمة(&متغير المؤقت) مع
    | اختياري.موجود(ق) -> {
        إذا (ق != 1) { أرجع 1; };
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    إذا (انتهت_المهمة(&العمل)) { أرجع 3; };
    طابق انتظر_مهمة(&متغير العمل) مع
    | اختياري.موجود(ق) -> {
        إذا (ق != 9) { أرجع 4; };
    }
    | اختياري.لا_شيء -> { أرجع 5; };
    اطبع_سطر("انقضت المهلة ونُظف العمل");
    أرجع 0;
}
