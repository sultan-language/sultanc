// شجرة مهام: تبدأ مهمة فرع مهمة ورقة، وتنتظرها، وتبني على نتيجتها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف ورقة(ن: عدد): عدد {
    تنازل_مهمة();
    أرجع ن * ن;
}

عرف فرع(ن: عدد): عدد {
    ليكن عملية_ابن: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> ورقة(ن));
    طابق انتظر_مهمة(&متغير عملية_ابن) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة + 1; }
    | اختياري.لا_شيء -> { أرجع -1; };
}

عرف الرئيسية(): عدد {
    ليكن الجذر: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> فرع(6));
    طابق انتظر_مهمة(&متغير الجذر) مع
    | اختياري.موجود(ق) -> {
        إذا (ق != 37) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(ق));
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
