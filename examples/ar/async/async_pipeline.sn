// مثال على المهام غير المتزامنة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف نفذ_المهمة(ن: عدد): عدد { تنازل_مهمة(); أرجع ن * 2; }

عرف الرئيسية(): عدد {
    دع الأول: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نفذ_المهمة(7));
    دع الثاني: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نفذ_المهمة(8));
    دع المجموع: متغير عدد = 0;
    طابق انتظر_مهمة(&متغير الأول) مع
    | اختياري.موجود(ن) -> { المجموع := المجموع + ن; }
    | اختياري.لا_شيء -> { أرجع 1; };
    طابق انتظر_مهمة(&متغير الثاني) مع
    | اختياري.موجود(ن) -> { المجموع := المجموع + ن; }
    | اختياري.لا_شيء -> { أرجع 2; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
