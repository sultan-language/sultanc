// تحويل تدفق من القيم في مهمة: تُضاعف كل قيمة، مع التخلي عن التنفيذ بعد كل واحدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف تحويل(القيم: متجه عدد): متجه عدد {
    ليكن المخرج: متغير متجه عدد = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(القيم)) {
        ألحق(المخرج, القيم[ف] * 2);
        تنازل_مهمة();
        ف := ف + 1;
    };
    أرجع المخرج;
}

عرف الرئيسية(): عدد {
    ليكن العمل: متغير مهمة<متجه عدد> = أطلق_مهمة(دالة(): متجه عدد -> تحويل([2, 4, 6, 8]));
    طابق انتظر_مهمة(&متغير العمل) مع
    | اختياري.موجود(المحول) -> {
        إذا (الطول(المحول) != 4 || المحول[0] != 4 || المحول[3] != 16) {
            أرجع 1;
        };
        اطبع_سطر(عدد_إلى_نص(المحول[3]));
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
