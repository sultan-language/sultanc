// مثال على المهام غير المتزامنة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;
استورد المكتبة.غير_متزامن.شبكة;
استورد المكتبة.شبكة.عنوان_مقبس;


عرف اختبر_الاتصال(): عدد {
    دع النص: نص = "127.0.0.1:1";
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.نجح(العنوان) -> {
        طابق اتصل_غير_متزامن(&العنوان) مع
        | نتيجة.نجح(الدفق) -> { دع نتيجة_الإغلاق: نتيجة عدد, عدد = أغلق_غير_متزامن(الدفق); أرجع 1; }
        | نتيجة.خطأ(_) -> { أرجع 0; };
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
}

عرف الرئيسية(): عدد {
    دع المهمة: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اختبر_الاتصال());
    طابق انتظر_مهمة(&متغير المهمة) مع
    | اختياري.موجود(ن) -> { اطبع_سطر(عدد_إلى_نص(ن)); }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
