// صدى TCP غير متزامن على 127.0.0.1: مهمة خادم ومهمة عميل في برنامج واحد تتبادلان ثلاثة
// بايتات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;
استورد المكتبة.غير_متزامن.شبكة;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.تي_سي_بي;

عرف عنوان_المقبس(): نتيجة عنوان_مقبس, خطأ_تحليل_عنوان_مقبس {
    دع النص: نص = "127.0.0.1:42321";
    أرجع حلل_عنوان_مقبس(&النص);
}

عرف اخدم_مرة_واحدة(): عدد {
    دع عنوان_الاتصال: عنوان_مقبس;
    طابق عنوان_المقبس() مع
    | نتيجة.نجح(أ) -> { عنوان_الاتصال := أ; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع مستمع_الاتصال: مستمع_تي_سي_بي;
    طابق اربط_مستمع_غير_متزامن(&عنوان_الاتصال, 8) مع
    | نتيجة.نجح(نص_صغير) -> { مستمع_الاتصال := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    دع مجرى: تدفق_تي_سي_بي;
    طابق اقبل_غير_متزامن(&مستمع_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { مجرى := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    دع المخزن: متغير متجه ط8 = [0 مثل ط8, 0 مثل ط8, 0 مثل ط8];
    دع المستلم: متغير عدد = 0;
    طالما (المستلم < 3) {
        طابق اقرأ_غير_متزامن(&مجرى, &متغير المخزن, المستلم, 3 - المستلم) مع
        | نتيجة.نجح(ن) -> {
            إذا (ن <= 0) { أرجع 4; };
            المستلم := المستلم + ن;
        }
        | نتيجة.خطأ(_) -> { أرجع 5; };
    };
    إذا (المخزن[0] != 65 مثل ط8 || المخزن[2] != 67 مثل ط8) { أرجع 6; };
    دع الرد: متجه ط8 = [66 مثل ط8, 67 مثل ط8, 68 مثل ط8];
    طابق اكتب_الكل_غير_متزامن(&مجرى, &الرد) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 7; };
    دع نتيجة_الإغلاق: نتيجة عدد, عدد = أغلق_غير_متزامن(مجرى);
    دع نتيجة_الإيقاف: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(مستمع_الاتصال);
    أرجع 0;
}

عرف شغل_العميل_مرة(): عدد {
    نم_مهمة(10000000);
    دع عنوان_الاتصال: عنوان_مقبس;
    طابق عنوان_المقبس() مع
    | نتيجة.نجح(أ) -> { عنوان_الاتصال := أ; }
    | نتيجة.خطأ(_) -> { أرجع 8; };
    دع مجرى: تدفق_تي_سي_بي;
    طابق اتصل_غير_متزامن(&عنوان_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { مجرى := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 9; };
    دع الرسالة: متجه ط8 = [65 مثل ط8, 66 مثل ط8, 67 مثل ط8];
    طابق اكتب_الكل_غير_متزامن(&مجرى, &الرسالة) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 10; };
    دع المخزن: متغير متجه ط8 = [0 مثل ط8, 0 مثل ط8, 0 مثل ط8];
    دع المستلم: متغير عدد = 0;
    طالما (المستلم < 3) {
        طابق اقرأ_غير_متزامن(&مجرى, &متغير المخزن, المستلم, 3 - المستلم) مع
        | نتيجة.نجح(ن) -> {
            إذا (ن <= 0) { أرجع 11; };
            المستلم := المستلم + ن;
        }
        | نتيجة.خطأ(_) -> { أرجع 12; };
    };
    إذا (المخزن[0] != 66 مثل ط8 || المخزن[2] != 68 مثل ط8) { أرجع 13; };
    دع نتيجة_الإغلاق: نتيجة عدد, عدد = أغلق_غير_متزامن(مجرى);
    أرجع 0;
}

عرف الرئيسية(): عدد {
    إذا (!المهام_مدعومة()) { أرجع 1; };
    دع خادم: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اخدم_مرة_واحدة());
    دع عميل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> شغل_العميل_مرة());
    طابق انتظر_مهمة(&متغير عميل) مع
    | اختياري.موجود(الرمز) -> {
        إذا (الرمز != 0) { أرجع الرمز; };
    }
    | اختياري.لا_شيء -> { أرجع 21; };
    طابق انتظر_مهمة(&متغير خادم) مع
    | اختياري.موجود(الرمز) -> {
        إذا (الرمز != 0) { أرجع الرمز; };
    }
    | اختياري.لا_شيء -> { أرجع 22; };
    اطبع_سطر("اكتمل تبادل TCP غير المتزامن");
    أرجع 0;
}
