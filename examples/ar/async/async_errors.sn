// مثال على المهام غير المتزامنة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;

عرف نفذ_المهمة(ن: عدد): عدد { تنازل_مهمة(); أرجع ن * 2; }
عرف المتحقق(ن: عدد): نتيجة عدد, عدد { إذا (ن < 0) { أرجع نتيجة.خطأ(1); }; أرجع نتيجة.نجح(ن); }

عرف الرئيسية(): عدد {
    ليكن المهمة: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نفذ_المهمة(5));
    طابق انتظر_مهمة(&متغير المهمة) مع
    | اختياري.موجود(ن) -> { طابق المتحقق(ن) مع
      | نتيجة.نجح(القيمة_الوسيطة) -> { اطبع_سطر(عدد_إلى_نص(القيمة_الوسيطة)); }
      | نتيجة.خطأ(_) -> { أرجع 2; }; }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
