// خط معالجة ملفات بالمهام: يُكتب ملف، ثم تعد مهمة غير متزامنة أسطره، ثم يُحذف الملف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.غير_متزامن.وقت_التشغيل;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.نصوص.تحويل;

عرف اقرأ_وعد(): عدد {
    تنازل_مهمة();
    ليكن المسار: نص = "pipeline-input.txt";
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        ليكن الأجزاء: متجه نص = قسم_النص(&النص, &"\n");
        أرجع الطول(الأجزاء) - 1;
    }
    | نتيجة.خطأ(_) -> { أرجع -1; };
}

عرف الرئيسية(): عدد {
    ليكن المسار: نص = "pipeline-input.txt";
    ليكن النص: نص = "alpha\nbeta\ngamma\n";
    طابق اكتب_الملف(&المسار, &النص) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    ليكن العمل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اقرأ_وعد());
    ليكن العدد: متغير عدد = -1;
    طابق انتظر_مهمة(&متغير العمل) مع
    | اختياري.موجود(ن) -> { العدد := ن; }
    | اختياري.لا_شيء -> { أرجع 2; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    إذا (العدد != 3) { أرجع 4; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
