// مثال على متغيرات البيئة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.بيئة.بيئة_العمل;


عرف الرئيسية(): عدد {
    ليكن المفتاح: نص = "PATH";
    طابق متغير_بيئة(&المفتاح) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> { اطبع_سطر("موجود"); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { اطبع_سطر("غير مضبوط"); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("غير متاح"); };
    أرجع 0;
}
