// قراءة متغيرات البيئة ودليل العمل.
استورد std.io.println;
استورد std.env.environment;

عرف الرئيسية(): عدد {
    دع اسم_المسار: نص = "PATH";
    طابق متغير_بيئة(&اسم_المسار) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> { اطبع_سطر("المتغير PATH معرف"); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { اطبع_سطر("المتغير PATH غير معرف"); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع الاسم_المفقود: نص = "SULTANC_EXAMPLE_UNSET_VARIABLE";
    طابق متغير_بيئة(&الاسم_المفقود) مع
    | نتيجة.نجح(اختياري.لا_شيء) -> { اطبع_سطر("المتغير غير المعرف أُبلغ عنه بلا قيمة"); }
    | _ -> { اطبع_سطر("غير متوقع"); };
    طابق دليل_العمل() مع
    | نتيجة.نجح(_) -> { اطبع_سطر("دليل العمل معروف"); }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    أرجع 0;
}
