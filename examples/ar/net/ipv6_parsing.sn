// مثال على الشبكات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.شبكة.آيبي;


عرف الرئيسية(): عدد {
    ليكن العنوان: نص = "127.0.0.2";
    طابق حلل_عنوان_آيبي4(&العنوان) مع
    | نتيجة.نجح(عنوان_الشبكة) -> { اطبع_سطر(نص_عنوان_آيبي4(&عنوان_الشبكة)); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("عنوان شبكة غير صالح"); };
    أرجع 0;
}
