// تحليل عناوين IPv4 وطباعتها؛ والعناوين المشوهة تُرفض.
استورد std.io.println;
استورد std.net.ip;

عرف الرئيسية(): عدد {
    دع المنزل: نص = "192.168.1.20";
    طابق حلل_عنوان_آيبي4(&المنزل) مع
    | نتيجة.نجح(العنوان) -> { اطبع_سطر(نص_عنوان_آيبي4(&العنوان)); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("غير صالح"); };
    دع الخطأ_المتعمد: نص = "300.1.2.3";
    طابق حلل_عنوان_آيبي4(&الخطأ_المتعمد) مع
    | نتيجة.نجح(_) -> { اطبع_سطر("غير متوقع"); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("رُفض 300.1.2.3"); };
    أرجع 0;
}
