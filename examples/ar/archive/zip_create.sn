// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.زيب;


عرف الرئيسية(): عدد {
    دع المدخلات: متغير متجه مدخل_زيب = [];
    ألحق(المدخلات, أنشئ_مدخل_ملف_زيب("zip_create_0.txt", [65 مثل ط8, 10 مثل ط8], خطأ));
    طابق سلسل_أرشيف_زيب(&المدخلات) مع
    | نتيجة.نجح(البيانات) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(البيانات) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
