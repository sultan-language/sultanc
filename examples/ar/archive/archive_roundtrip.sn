// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.تار;


عرف الرئيسية(): عدد {
    ليكن المدخلات: متغير متجه مدخل_تار = [];
    ألحق(المدخلات, أنشئ_مدخل_ملف_تار("archive_roundtrip_0.txt", [65 مثل ط8, 10 مثل ط8]));
    ألحق(المدخلات, أنشئ_مدخل_ملف_تار("archive_roundtrip_1.txt", [66 مثل ط8, 10 مثل ط8]));
    ألحق(المدخلات, أنشئ_مدخل_ملف_تار("archive_roundtrip_2.txt", [67 مثل ط8, 10 مثل ط8]));
    طابق سلسل_أرشيف_تار(&المدخلات) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(البيانات) -> {
        طابق حلل_أرشيف_تار(&البيانات) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المفكوك) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(المفكوك) مثل طبيعي)); };
    };
    أرجع 0;
}
