// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.تار;


عرف الرئيسية(): عدد {
    ليكن المدخلات: متغير متجه مدخل_تار = [];
    طابق سلسل_أرشيف_تار(&المدخلات) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(البيانات) -> {
        طابق حلل_أرشيف_تار(&البيانات) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المفكوك) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(المفكوك) مثل طبيعي)); };
    };
    أرجع 0;
}
