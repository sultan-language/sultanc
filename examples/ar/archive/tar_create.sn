// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.تار;


عرف الرئيسية(): عدد {
    دع المدخلات: متغير متجه مدخل_تار = [];
    ألحق(المدخلات, أنشئ_مدخل_ملف_تار("tar_create_0.txt", [65 مثل ط8, 10 مثل ط8]));
    ألحق(المدخلات, أنشئ_مدخل_ملف_تار("tar_create_1.txt", [66 مثل ط8, 10 مثل ط8]));
    طابق سلسل_أرشيف_تار(&المدخلات) مع
    | نتيجة.نجح(البيانات) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(البيانات) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
