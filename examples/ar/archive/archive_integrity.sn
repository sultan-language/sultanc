// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.زيب;


عرف الرئيسية(): عدد {
    ليكن المدخلات: متغير متجه مدخل_زيب = [];
    ألحق(المدخلات, أنشئ_مدخل_ملف_زيب("archive_integrity_0.txt", [65 مثل ط8, 10 مثل ط8], خطأ));
    طابق سلسل_أرشيف_زيب(&المدخلات) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(البيانات) -> {
        ليكن المعطوب: متغير متجه ط8 = البيانات;
        المعطوب[0] := 255 مثل ط8;
        طابق حلل_أرشيف_زيب(&المعطوب) مع
        | نتيجة.خطأ(_) -> { اطبع_سطر("رُفضت البيانات التالفة"); }
        | نتيجة.نجح(_) -> { أرجع 2; };
    };
    أرجع 0;
}
