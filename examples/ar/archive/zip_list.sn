// مثال على التعامل مع الأرشيفات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أرشيف.زيب;


عرف الرئيسية(): عدد {
    ليكن المدخلات: متغير متجه مدخل_زيب = [];
    ألحق(المدخلات, أنشئ_مدخل_ملف_زيب("zip_list_0.txt", [65 مثل ط8, 10 مثل ط8], خطأ));
    ألحق(المدخلات, أنشئ_مدخل_ملف_زيب("zip_list_1.txt", [66 مثل ط8, 10 مثل ط8], خطأ));
    طابق سلسل_أرشيف_زيب(&المدخلات) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(البيانات) -> {
        طابق حلل_أرشيف_زيب(&البيانات) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المفكوك) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(المفكوك) مثل طبيعي)); };
    };
    أرجع 0;
}
