// مثال على معالجة البايتات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.بايتات.مؤشر;


عرف الرئيسية(): عدد {
    ليكن البيانات: متجه ط8 = [46 مثل ط8, 12, 44, 7];
    ليكن المؤشر: متغير مؤشر_بايتات = أنشئ_مؤشر_بايتات(&البيانات);
    طابق اقرأ_ط16_صغير(&متغير المؤشر) مع
    | اختياري.موجود(ن) -> { اطبع_سطر(طبيعي_إلى_نص(ن مثل طبيعي)); }
    | اختياري.لا_شيء -> { اطبع_سطر("بايتات مفقودة"); };
    أرجع 0;
}
