// مثال على معالجة البايتات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.بايتات.باني;


عرف الرئيسية(): عدد {
    دع الباني: متغير باني_بايتات = أنشئ_باني_بايتات();
    دع المدرج: منطقي = ألحق_بايتا_بباني_البايتات(&متغير الباني, 25 مثل ط8);
    دع البيانات: متجه ط8 = بايتات_باني_البايتات(&الباني);
    اطبع_سطر(طبيعي_إلى_نص(الطول(البيانات) مثل طبيعي));
    أرجع 0;
}
