// من JSON إلى CSV: يُقرأ نص ورقم من كائن JSON، ويُكتبان صفا في CSV تحت سطر العناوين، ويُتحقق
// من أن CSV يُحلَّل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.جسون.تحليل;
استورد المكتبة.جسون.قيمة;
استورد المكتبة.سي_اس_في.سي_اس_في;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "{\"name\":\"Ali\",\"age\":31}";
    ليكن الاسم: متغير نص = "";
    ليكن العمر: متغير نص = "";
    طابق حلل_جسون(&المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الوثيقة) -> {
        طابق جذر_وثيقة_جسون(&الوثيقة) مع
        | قيمة_جسون.كائن(الفهرس) -> {
            ليكن مفتاح_الاسم: نص = "name";
            ليكن مفتاح_العمر: نص = "age";
            طابق قيمة_مفتاح_جسون(&الوثيقة, الفهرس, &مفتاح_الاسم) مع
            | اختياري.موجود(قيمة_جسون.سلسلة(ق)) -> { الاسم := ق; }
            | _ -> { أرجع 2; };
            طابق قيمة_مفتاح_جسون(&الوثيقة, الفهرس, &مفتاح_العمر) مع
            | اختياري.موجود(قيمة_جسون.رقم(ق)) -> { العمر := ق; }
            | _ -> { أرجع 3; };
        }
        | _ -> { أرجع 4; };
    };
    ليكن الأجزاء: متجه نص = ["name,age\n", الاسم, ",", العمر, "\n"];
    ليكن فارغ: نص = "";
    ليكن سي_اس_في: نص = صل_النصوص(&الأجزاء, &فارغ);
    طابق حلل_سي_اس_في(&سي_اس_في) مع
    | نتيجة.نجح(الوثيقة) -> {
        إذا (عدد_سجلات_سي_اس_في(&الوثيقة) != 2 مثل طبيعي) { أرجع 5; };
    }
    | نتيجة.خطأ(_) -> { أرجع 6; };
    اطبع_سطر(سي_اس_في);
    أرجع 0;
}
