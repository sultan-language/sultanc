// تتبع مسار داخل JSON: يؤخذ الكائن الجذر، ثم النص المخزن تحت المفتاح "name".
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.جسون.تحليل;
استورد المكتبة.جسون.قيمة;

عرف الرئيسية(): عدد {
    ليكن المدخل: نص = "{\"name\":\"SultanC\"}";
    طابق حلل_جسون(&المدخل) مع
    | نتيجة.نجح(الوثيقة) -> {
        طابق جذر_وثيقة_جسون(&الوثيقة) مع
        | قيمة_جسون.كائن(الفهرس) -> {
            ليكن المفتاح: نص = "name";
            طابق قيمة_مفتاح_جسون(&الوثيقة, الفهرس, &المفتاح) مع
            | اختياري.موجود(قيمة_جسون.سلسلة(الاسم)) -> { اطبع_سطر(الاسم); }
            | _ -> { أرجع 2; };
        }
        | _ -> { أرجع 3; };
    }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
