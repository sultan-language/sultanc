// من CSV إلى JSON: تُقرأ حقول صف CSV، ويُبنى منها كائن JSON، ويُتحقق من أنه يُحلَّل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.سي_اس_في.سي_اس_في;
استورد المكتبة.جسون.تحليل;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المدخل: نص = "name,value\nAli,3\n";
    ليكن الاسم: متغير نص = "";
    ليكن العدد: متغير نص = "";
    طابق حلل_سي_اس_في(&المدخل) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الوثيقة) -> {
        طابق سجل_سي_اس_في_عند(&الوثيقة, 1 مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع 2; }
        | اختياري.موجود(الصف) -> {
            طابق حقل_سي_اس_في_عند(&الصف, 0 مثل طبيعي) مع
            | اختياري.موجود(ق) -> { الاسم := ق; }
            | اختياري.لا_شيء -> { أرجع 3; };
            طابق حقل_سي_اس_في_عند(&الصف, 1 مثل طبيعي) مع
            | اختياري.موجود(ق) -> { العدد := ق; }
            | اختياري.لا_شيء -> { أرجع 4; };
        };
    };
    ليكن الأجزاء: متجه نص = ["{\"name\":\"", الاسم, "\",\"value\":", العدد, "}"];
    ليكن فارغ: نص = "";
    ليكن جسون: نص = صل_النصوص(&الأجزاء, &فارغ);
    طابق حلل_جسون(&جسون) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 5; };
    اطبع_سطر(جسون);
    أرجع 0;
}
