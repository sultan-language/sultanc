// قراءة JSON المفصول بالأسطر: يُقسم المدخل إلى أسطر، ويُحلَّل كل سطر مستندا JSON مستقلا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.جسون.تحليل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "{\"id\":1}\n{\"id\":2}\n";
    دع الأسطر: متجه نص = قسم_النص(&المصدر, &"\n");
    دع ف: متغير عدد = 0;
    طالما (ف < 2) {
        طابق حلل_جسون(&الأسطر[ف]) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    };
    اطبع_سطر(عدد_إلى_نص(ف));
    أرجع 0;
}
