// كتابة JSON المفصول بالأسطر: يوضع كل مستند JSON في سطر خاص به.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع الأول: نص = "{\"id\":1}";
    دع الثاني: نص = "{\"id\":2}";
    دع الأجزاء: متجه نص = [الأول, الثاني];
    دع سطر_جديد: نص = "\n";
    اطبع_سطر(صل_النصوص(&الأجزاء, &سطر_جديد));
    أرجع 0;
}
