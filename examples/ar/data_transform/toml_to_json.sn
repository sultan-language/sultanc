// من TOML إلى JSON: تُقرأ قيمة نصية من مستند TOML، وتُكتب كائن JSON.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تومل.محلل;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.جسون.تحليل;

عرف الرئيسية(): عدد {
    دع المدخل: نص = "title = \"SultanC\"\n";
    دع العنوان_النصي: متغير نص = "";
    طابق حلل_تومل(&المدخل) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الوثيقة) -> {
        دع المفتاح: نص = "title";
        طابق قيمة_مفتاح_تومل(&الوثيقة, الوثيقة.الجذر, &المفتاح) مع
        | اختياري.موجود(قيمة_تومل.سلسلة(القيمة)) -> { العنوان_النصي := القيمة; }
        | _ -> { أرجع 2; };
    };
    دع الأجزاء: متجه نص = ["{\"title\":\"", العنوان_النصي, "\"}"];
    دع فارغ: نص = "";
    دع جسون: نص = صل_النصوص(&الأجزاء, &فارغ);
    طابق حلل_جسون(&جسون) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    اطبع_سطر(جسون);
    أرجع 0;
}
