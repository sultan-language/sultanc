// التحقق من صحة JSON: المستند الذي يُحلَّل بنجاح يوصف بأنه صالح.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.جسون.تحليل;

عرف الرئيسية(): عدد {
    ليكن المدخل: نص = "{\"enabled\":true}";
    طابق حلل_جسون(&المدخل) مع
    | نتيجة.نجح(_) -> { اطبع_سطر("صالح"); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
