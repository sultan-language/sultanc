// مثال على معالجة الأخطاء.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اقسم(أ: عدد, ب: عدد): نتيجة عدد, عدد { إذا (ب == 0) { أرجع نتيجة.خطأ(1); }; أرجع نتيجة.نجح(أ / ب); }

عرف الرئيسية(): عدد {
    طابق اقسم(24, 2) مع
    | نتيجة.نجح(ن) -> { اطبع_سطر(عدد_إلى_نص(ن)); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("خطأ في القسمة"); };
    أرجع 0;
}
