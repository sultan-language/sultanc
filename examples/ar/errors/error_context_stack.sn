// إضافة سياق إلى الخطأ وهو يصعد: تحول الدالة المغلِّفة الخطأ 33 إلى 133، وتمرر قيم النجاح
// كما هي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فشل(الصنف_الفرعي: عدد): نتيجة عدد, عدد {
    إذا (الصنف_الفرعي == 3) { أرجع نتيجة.خطأ(33); };
    أرجع نتيجة.نجح(الصنف_الفرعي);
}

عرف مع_السياق(الصنف_الفرعي: عدد): نتيجة عدد, عدد {
    طابق فشل(الصنف_الفرعي) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز + 100); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

عرف الرئيسية(): عدد {
    طابق مع_السياق(3) مع
    | نتيجة.خطأ(الرمز) -> {
        إذا (الرمز != 133) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(الرمز));
    }
    | _ -> { أرجع 1; };
    أرجع 0;
}
