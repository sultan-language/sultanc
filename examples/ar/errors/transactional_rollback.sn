// كل شيء أو لا شيء: يفشل خصم أكبر من الرصيد، ويبقى الرصيد على حاله.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اخصم(الرصيد: عدد, المبلغ: عدد): نتيجة عدد, عدد {
    إذا (المبلغ > الرصيد) { أرجع نتيجة.خطأ(1); };
    أرجع نتيجة.نجح(الرصيد - المبلغ);
}

عرف الرئيسية(): عدد {
    ليكن الرصيد: متغير عدد = 50;
    طابق اخصم(الرصيد, 80) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(التالي) -> { الرصيد := التالي; };
    إذا (الرصيد != 50) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الرصيد));
    أرجع 0;
}
