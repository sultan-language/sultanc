// نتائج النداءات المتداخلة: تضيف الدالة الخارجية 10 إلى رمز خطأ الدالة الداخلية قبل أن
// تعيده.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اقسم(أ: عدد, ب: عدد): نتيجة عدد, عدد {
    إذا (ب == 0) { أرجع نتيجة.خطأ(2); };
    أرجع نتيجة.نجح(أ / ب);
}

عرف الخارجية(أ: عدد, ب: عدد): نتيجة عدد, عدد {
    طابق اقسم(أ, ب) مع
    | نتيجة.نجح(ق) -> { أرجع نتيجة.نجح(ق + 1); }
    | نتيجة.خطأ(الحافة_الحالية) -> { أرجع نتيجة.خطأ(الحافة_الحالية + 10); };
}

عرف الرئيسية(): عدد {
    طابق الخارجية(20, 0) مع
    | نتيجة.خطأ(الحافة_الحالية) -> {
        إذا (الحافة_الحالية != 12) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(الحافة_الحالية));
    }
    | _ -> { أرجع 1; };
    أرجع 0;
}
