// معالجة خطأ في نظام الملفات: قراءة ملف غير موجود تعطي نتيجة خطأ، فيعالجها البرنامج.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.تعديل;

عرف الرئيسية(): عدد {
    دع المسار: نص = "sultanc-this-file-does-not-exist-0123456789.tmp";
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.خطأ(_) -> { اطبع_سطر("عولج غياب الملف"); }
    | نتيجة.نجح(_) -> { أرجع 1; };
    أرجع 0;
}
