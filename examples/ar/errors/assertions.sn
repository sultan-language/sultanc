// `تأكد` يوقف البرنامج برمز خروج 1 إذا كان الشرط خاطئا.
استورد std.io.println;
استورد std.debug.assert;

عرف المضروب(العدد_المعطى: عدد): عدد {
    لو (العدد_المعطى <= 1) { أرجع 1; };
    أرجع العدد_المعطى * المضروب(العدد_المعطى - 1);
}

عرف الرئيسية(): عدد {
    تأكد(المضروب(5) == 120);
    دع الرسالة: نص = "يجب أن يكون مضروب 6 هو 720";
    تأكد_برسالة(المضروب(6) == 720, &الرسالة);
    اطبع_سطر("نجحت كل الفحوص");
    أرجع 0;
}
