// المرحلة الثالثة من نظام الأخطاء (docs/en/reference/errors.md)، وهي اختيارية: للمؤلف أن
// يضيف رسالة الخطأ بلغات أخرى. يختار البرنامج اللغة من قيمة لغة يمررها، لا من
// حالة عامة: هنا لغة بيئته (SULTANC_LANG وLC_ALL وLC_MESSAGES وLANG) ولغة
// ترويسة Accept-Language في HTTP، كما يفعل خادم لكل طلب. شغله مع
// SULTANC_LANG=en أو SULTANC_LANG=ar.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.نصوص.لغة;
استورد المكتبة.نصوص.لغة_النظام;
استورد المكتبة.دخ.اطبع_سطر;

عرف حمل_الإعدادات(): نتيجة عدد, فشل {
    دع فارغ: متغير فشل = فشل_بهوية(«الإعدادات», «فارغ», «ملف الإعدادات فارغ»);
    أضف_نسخة_لغة(&متغير فارغ, «ar-EG», «ملف الإعدادات بلا محتوى»);
    دع الفشل: متغير فشل = فشل_بسبب(«تعذر تحميل الإعدادات», فارغ);
    أضف_نسخة_لغة(&متغير الفشل, «ar-EG», «تعذر فتح ملف الإعدادات»);
    أرجع نتيجة.خطأ(الفشل);
}

عرف الرئيسية(): عدد {
    طابق حمل_الإعدادات() مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(الفشل) -> {
        // لغة البرنامج نفسه.
        دع اللغة: لغة = لغة_من_البيئة();
        اطبع_فشل_بلغة(&الفشل, &اللغة);

        // لغة طلب: العربية الإقليمية مفضلة، ويُختار النص العربي المناسب.
        دع الترويسة: نص = «ar-EG, ar;q=0.9, fr;q=0.8»;
        دع الطلب: لغة = لغة_من_قبول_اللغة(&الترويسة);
        دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(صف_فشل_بلغة(&الفشل, &الطلب));
        أرجع 1;
    };
}
