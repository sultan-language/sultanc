// التعافي والمتابعة: تُتخطى العناصر التي يفشل تحليلها، ويُجمع الباقي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف حلل_الصغير(القيمة: عدد): نتيجة عدد, عدد {
    إذا (القيمة < 0) { أرجع نتيجة.خطأ(1); };
    أرجع نتيجة.نجح(القيمة);
}

عرف الرئيسية(): عدد {
    دع العناصر: متجه عدد = [2, -1, 3, -4, 5];
    دع المجموع: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(العناصر)) {
        طابق حلل_الصغير(العناصر[ف]) مع
        | نتيجة.نجح(ن) -> { المجموع := المجموع + ن; }
        | نتيجة.خطأ(_) -> { };
        ف := ف + 1;
    };
    إذا (المجموع != 10) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
