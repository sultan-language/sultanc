// تنظيف المورد: الملف المؤقت الذي كُتب يُحذف بعد ذلك دائما.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.تعديل;

عرف الرئيسية(): عدد {
    دع المسار: نص = "sultanc-error-cleanup-example.tmp";
    دع النص: نص = "مؤقت";
    طابق اكتب_الملف(&المسار, &النص) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> { اطبع_سطر("اكتمل التنظيف"); };
    أرجع 0;
}
