// تحويل رمز الخطأ إلى رسالة يقرؤها المستخدم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف تحقق(س: عدد): نتيجة عدد, عدد {
    إذا (س < 0) { أرجع نتيجة.خطأ(10); };
    أرجع نتيجة.نجح(س);
}

عرف الرسالة(الرمز: عدد): نص {
    إذا (الرمز == 10) { أرجع "مدخل سالب"; };
    أرجع "خطأ غير معروف";
}

عرف الرئيسية(): عدد {
    طابق تحقق(-5) مع
    | نتيجة.خطأ(الرمز) -> { اطبع_سطر(الرسالة(الرمز)); }
    | _ -> { أرجع 1; };
    أرجع 0;
}
