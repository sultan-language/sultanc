// تحويل رموز الأخطاء الداخلية إلى رموز حالة HTTP بـ`طابق`، و0 لأي رمز غير مذكور.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف رمز_للخطأ(الرمز: عدد): عدد {
    طابق الرمز مع
    | 1 -> { أرجع 400; }
    | 2 -> { أرجع 404; }
    | 3 -> { أرجع 500; }
    | _ -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = رمز_للخطأ(2);
    إذا (الجواب != 404) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
