// تحقق يتوقف عند أول خطأ: تُفحص المدخلات بالترتيب ويُعاد أول خطأ يُعثر عليه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف تحقق_الصحة(أ: عدد, ب: عدد): نتيجة عدد, عدد {
    إذا (أ < 0) { أرجع نتيجة.خطأ(1); };
    إذا (ب < 0) { أرجع نتيجة.خطأ(2); };
    إذا (أ + ب > 100) { أرجع نتيجة.خطأ(3); };
    أرجع نتيجة.نجح(أ + ب);
}

عرف الرئيسية(): عدد {
    طابق تحقق_الصحة(12, -4) مع
    | نتيجة.خطأ(الرمز) -> {
        إذا (الرمز != 2) { أرجع 1; };
        اطبع_سطر(عدد_إلى_نص(الرمز));
    }
    | _ -> { أرجع 1; };
    أرجع 0;
}
