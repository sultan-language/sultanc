// مثال على الخيوط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.خيوط.خيط;

عرف العامل(): فراغ { اطبع_سطر("العامل قيد التشغيل"); }
عرف الرئيسية(): عدد {
    طابق أطلق(دالة(): فراغ -> العامل()) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المقبض) -> { دع مقبض_محلي: متغير مقبض_خيط = المقبض; انضم(&متغير مقبض_محلي); };
    اطبع_سطر("اكتمل انتظار جميع العمال");
    أرجع 0;
}
