// ذاكرة مؤقتة يحميها قفل قراءة وكتابة: تُقرأ القيمة، ثم تُحدَّث تحت قفل الكتابة، ثم تُقرأ ثانية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قفل_قراءة_كتابة;

عرف اقرأ(ق: &ص64): ص64 {
    أرجع *ق;
}

عرف أضف(ق: &متغير ص64): فراغ {
    *ق := *ق + 5;
}

عرف الرئيسية(): عدد {
    دع القفل: قفل_قراءة_كتابة<ص64> = أنشئ_قفل_قراءة_كتابة(10 مثل ص64);
    دع قبل: ص64 = نفذ_مع_قراءة(&القفل, دالة(ق: &ص64): ص64 -> اقرأ(ق));
    نفذ_مع_كتابة(&القفل, دالة(ق: &متغير ص64): فراغ -> أضف(ق));
    دع بعد: ص64 = نفذ_مع_قراءة(&القفل, دالة(ق: &ص64): ص64 -> اقرأ(ق));
    إذا (قبل != 10 مثل ص64 || بعد != 15 مثل ص64) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(بعد مثل عدد));
    أرجع 0;
}
