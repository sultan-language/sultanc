// حساب بصمة ملف في خيط آخر: يقرأ خيط عامل الملف ويحسب SHA-256 له، ويعيد البايت الأول من
// البصمة عند ضمه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.خيوط.خيط;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.نصوص.من_بايتات;

عرف احسب_البصمة(): عدد {
    دع المسار: نص = "parallel-hash-input.txt";
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        دع ملخص: متجه ط8 = شا256(&بايتات_من_نص(النص));
        إذا (الطول(ملخص) != 32) { أرجع -1; };
        أرجع ملخص[0] مثل عدد;
    }
    | نتيجة.خطأ(_) -> { أرجع -2; };
}

عرف الرئيسية(): عدد {
    دع المسار: نص = "parallel-hash-input.txt";
    دع المصدر: نص = "abc";
    طابق اكتب_الملف(&المسار, &المصدر) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع العامل: متغير مقبض_خيط_بقيمة<عدد>;
    طابق أطلق_بقيمة(دالة(): عدد -> احسب_البصمة()) مع
    | نتيجة.نجح(المقبض_المؤقت) -> { العامل := المقبض_المؤقت; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    دع القيمة: متغير عدد = -1;
    طابق انضم_بقيمة(&متغير العامل) مع
    | اختياري.موجود(ن) -> { القيمة := ن; }
    | اختياري.لا_شيء -> { أرجع 3; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 4; };
    إذا (القيمة != 186) { أرجع 5; };
    اطبع_سطر(عدد_إلى_نص(القيمة));
    أرجع 0;
}
