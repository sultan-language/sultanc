// مثال على الخيوط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.خيوط.خيط;

عرف عمل_الخيط(): فراغ { اطبع_سطر("العامل الأول"); }

عرف الرئيسية(): عدد {
    طابق أطلق(دالة(): فراغ -> عمل_الخيط()) مع
    | نتيجة.نجح(المقبض) -> { دع مقبض_محلي: متغير مقبض_خيط = المقبض; انضم(&متغير مقبض_محلي); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    اطبع_سطر("اكتمل الانتظار");
    أرجع 0;
}
