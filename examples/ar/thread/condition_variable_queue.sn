// الانتظار على متغير شرط: يعيّن خيط منتج قيمة مشتركة تحت قفل ثم ينبّه، بينما ينتظر الخيط
// الرئيسي حتى لا تبقى القيمة 0.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.مشترك;
استورد المكتبة.تزامن.قفل;
استورد المكتبة.تزامن.شرط_انتظار;
استورد المكتبة.خيوط.خيط;

نوع حالة_مشتركة = { الرسالة: قفل<ص64>, التغير: شرط_انتظار };

عرف فارغ(ق: &ص64): منطقي {
    أرجع *ق == 0 مثل ص64;
}

عرف انتظر_الرسالة(ت: &مشترك<حالة_مشتركة>, ق: &متغير ص64): ص64 {
    دع الحالة_المخزنة: &حالة_مشتركة = اقرأ_مشترك(ت);
    انتظر_طالما(&(*الحالة_المخزنة).التغير, &(*الحالة_المخزنة).الرسالة, دالة(بند: &ص64): منطقي -> فارغ(بند));
    أرجع *ق;
}

عرف عين_الرسالة(ق: &متغير ص64): فراغ {
    *ق := 99 مثل ص64;
}

عرف المنتج(ت: مشترك<حالة_مشتركة>): فراغ {
    دع الحالة_المخزنة: &حالة_مشتركة = اقرأ_مشترك(&ت);
    نفذ_مع_القفل(&(*الحالة_المخزنة).الرسالة, دالة(ق: &متغير ص64): فراغ -> عين_الرسالة(ق));
    نبه_واحدا(&(*الحالة_المخزنة).التغير);
}

عرف الرئيسية(): عدد {
    دع الحالة_المخزنة: حالة_مشتركة = { الرسالة: أنشئ_قفل(0 مثل ص64), التغير: أنشئ_شرط_انتظار() };
    دع الحالة_المشتركة: مشترك<حالة_مشتركة> = أنشئ_مشترك(الحالة_المخزنة);
    دع نسخة_الحالة: مشترك<حالة_مشتركة> = استنسخ_مشترك(&الحالة_المشتركة);
    دع العامل: متغير مقبض_خيط;
    طابق أطلق(دالة(): فراغ -> المنتج(نسخة_الحالة)) مع
    | نتيجة.نجح(المقبض_المؤقت) -> { العامل := المقبض_المؤقت; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع المقفلة: &حالة_مشتركة = اقرأ_مشترك(&الحالة_المشتركة);
    دع المستلمة: ص64 = نفذ_مع_القفل(&(*المقفلة).الرسالة, دالة(ق: &متغير ص64): ص64 -> انتظر_الرسالة(&الحالة_المشتركة, ق));
    انضم(&متغير العامل);
    إذا (المستلمة != 99 مثل ص64) { أرجع 2; };
    اطبع_سطر(عدد_إلى_نص(المستلمة مثل عدد));
    أرجع 0;
}
