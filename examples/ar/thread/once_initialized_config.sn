// تهيئة الإعدادات مرة واحدة: يشغّل قفل المرة الواحدة دالة التهيئة في النداء الأول وحده، وتنال
// النداءات اللاحقة القيمة نفسها، ويُرفض تعيينها مرة ثانية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.مرة;

عرف اضبط(): ص64 {
    أرجع 42 مثل ص64;
}

عرف الرئيسية(): عدد {
    دع الخلية: خلية_مرة<ص64> = أنشئ_خلية_مرة();
    دع الأول: &ص64 = اقرأ_أو_هيئ_خلية_مرة(&الخلية, دالة(): ص64 -> اضبط());
    إذا (*الأول != 42 مثل ص64) { أرجع 1; };
    دع مرة_أخرى: &ص64 = اقرأ_أو_هيئ_خلية_مرة(&الخلية, دالة(): ص64 -> اضبط());
    إذا (*مرة_أخرى != 42 مثل ص64) { أرجع 2; };
    إذا (اضبط_خلية_مرة(&الخلية, 99 مثل ص64)) { أرجع 3; };
    اطبع_سطر(عدد_إلى_نص((*مرة_أخرى) مثل عدد));
    أرجع 0;
}
