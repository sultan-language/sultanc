// مرحلة واحدة من خط معالجة بالقنوات: يُستقبل عدد من قناة ويُضاعف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قناة;

عرف الرئيسية(): عدد {
    ليكن طرفا_القناة: طرفا_قناة<عدد> = قناة<عدد>();
    طابق أرسل(&طرفا_القناة.المرسل, 7) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق استقبل(&طرفا_القناة.المستلم) مع
    | نتيجة.نجح(ن) -> {
        ليكن المضاعف: عدد = ن * 2;
        اطبع_سطر(عدد_إلى_نص(المضاعف));
    }
    | _ -> { أرجع 2; };
    أرجع 0;
}
