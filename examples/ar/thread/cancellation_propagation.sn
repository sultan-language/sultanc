// راية إلغاء في متغير ذري: يُخزن 1 بترتيب ذاكرة تسلسلي ثم يُقرأ.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.ذري;

عرف الرئيسية(): عدد {
    ليكن ملغى: ذرة_ط32 = أنشئ_ذرة_ط32(0 مثل ط32);
    اخزن_ط32(&ملغى, 1 مثل ط32, ترتيب_ذاكرة.تسلسلي());
    ليكن متحقق_منه: ط32 = احمل_ط32(&ملغى, ترتيب_ذاكرة.تسلسلي());
    إذا (متحقق_منه != 1 مثل ط32) { أرجع 1; };
    اطبع_سطر("استقبلت إشارة الإلغاء");
    أرجع 0;
}
