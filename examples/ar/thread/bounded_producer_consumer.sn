// منتج ومستهلك تربط بينهما قناة: تُرسل قيمة واحدة في القناة وتُستقبل من طرفها الآخر.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قناة;

عرف الرئيسية(): عدد {
    دع طرفا_القناة: طرفا_قناة<عدد> = قناة<عدد>();
    طابق أرسل(&طرفا_القناة.المرسل, 20) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق استقبل(&طرفا_القناة.المستلم) مع
    | نتيجة.نجح(القيمة) -> {
        إذا (القيمة != 20) { أرجع 2; };
        اطبع_سطر(عدد_إلى_نص(القيمة));
    }
    | _ -> { أرجع 3; };
    أرجع 0;
}
