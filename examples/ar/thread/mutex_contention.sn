// تحديث قيمة يحميها قفل: كل نداء لـ`نفذ_مع_القفل` يزيدها والقفل ممسوك.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قفل;

عرف زد_واحدا(ق: &متغير ص64): ص64 {
    *ق := *ق + 1;
    أرجع *ق;
}

عرف الرئيسية(): عدد {
    ليكن القفل: قفل<ص64> = أنشئ_قفل(10 مثل ص64);
    ليكن أ: ص64 = نفذ_مع_القفل(&القفل, دالة(ق: &متغير ص64): ص64 -> زد_واحدا(ق));
    ليكن ب: ص64 = نفذ_مع_القفل(&القفل, دالة(ق: &متغير ص64): ص64 -> زد_واحدا(ق));
    إذا (أ != 11 مثل ص64 || ب != 12 مثل ص64) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(ب مثل عدد));
    أرجع 0;
}
