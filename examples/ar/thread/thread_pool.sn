// تشغيل الأعمال على خيوط وجمع نتائجها: يُطلق حسابان ويُجمع ما يعيدانه عند ضمهما.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.خيوط.خيط;

عرف الرئيسية(): عدد {
    دع الأول: متغير مقبض_خيط_بقيمة<عدد>;
    دع الثاني: متغير مقبض_خيط_بقيمة<عدد>;
    طابق أطلق_بقيمة(دالة(): عدد -> 3 * 7) مع
    | نتيجة.نجح(المقبض_المؤقت) -> { الأول := المقبض_المؤقت; }
    | _ -> { أرجع 1; };
    طابق أطلق_بقيمة(دالة(): عدد -> 4 * 8) مع
    | نتيجة.نجح(المقبض_المؤقت) -> { الثاني := المقبض_المؤقت; }
    | _ -> { أرجع 2; };
    دع المجموع: متغير عدد = 0;
    طابق انضم_بقيمة(&متغير الأول) مع
    | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
    | _ -> { أرجع 3; };
    طابق انضم_بقيمة(&متغير الثاني) مع
    | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
    | _ -> { أرجع 4; };
    إذا (المجموع != 53) { أرجع 5; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
