// عرض ست عشري صغير: يطبع بايتات المدخل بالنظام الست عشري.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ترميز.سداسي;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    دع النص: نص = اقرأ_المدخل("abc");
    دع البايتات: متجه ط8 = بايتات_من_نص(النص);
    اطبع_سطر(رمز_سداسي(&البايتات));
    أرجع 0;
}
