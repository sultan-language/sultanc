// أداة cut صغيرة: تقسم الوسيط الأول، أو سطر CSV افتراضيا، عند الفواصل وتطبع العمود الثاني.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    دع النص: نص = اقرأ_المدخل("Ali,25,Canada");
    دع الأعمدة: متجه نص = قسم_النص(&النص, &",");
    إذا (الطول(الأعمدة) < 2) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأعمدة[1]));
    أرجع 0;
}
