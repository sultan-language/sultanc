// أداة uniq صغيرة: تحذف كل سطر يكرر السطر الذي قبله، وتعد الأسطر الباقية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.مقارنة;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    ليكن النص: نص = اقرأ_المدخل("واحد\nواحد\nاثنان\nاثنان\nثلاثة");
    ليكن الأسطر: متجه نص = قسم_النص(&النص, &"\n");
    ليكن الفريدة: متغير متجه نص = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(الأسطر)) {
        إذا (ف == 0 || !نصان_متساويان(&الأسطر[ف], &الأسطر[ف - 1])) {
            ألحق(الفريدة, استنسخ(&الأسطر[ف]));
        };
        ف := ف + 1;
    };
    اطبع_سطر(عدد_إلى_نص(الطول(الفريدة)));
    أرجع 0;
}
