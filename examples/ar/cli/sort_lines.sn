// أداة sort صغيرة: تقسم المدخل إلى أسطر وترتبها ثم تطبعها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.ترتيب;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    دع النص: نص = اقرأ_المدخل("كمثرى\nتفاح\nموز");
    دع الأسطر: متغير متجه نص = قسم_النص(&النص, &"\n");
    رتب_نصوص(&متغير الأسطر);
    دع الفاصل: نص = "\n";
    اطبع_سطر(صل_النصوص(&الأسطر, &الفاصل));
    أرجع 0;
}
