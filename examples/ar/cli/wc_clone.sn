// أداة wc صغيرة: تعد كلمات المدخل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    دع النص: نص = اقرأ_المدخل("أهلًا من SultanC");
    دع الكلمات: متجه نص = قسم_النص(&النص, &" ");
    دع العدد: عدد = الطول(الكلمات);
    إذا (العدد < 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
