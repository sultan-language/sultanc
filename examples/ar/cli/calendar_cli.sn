// عدد أيام الشهر من وحدة التقويم: فبراير 2028 سنة كبيسة، ففيه 29 يوما.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.دخ.اقرأ_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.وقت.تقويم;

عرف الرئيسية(): عدد {
    ليكن السنة: عدد = 2028;
    ليكن الشهر: طبيعي = 2;
    ليكن الأيام: طبيعي = أيام_في_الشهر(السنة, الشهر);
    إذا (الأيام != 29) { أرجع 1; };
    اطبع_سطر(طبيعي_إلى_نص(الأيام));
    أرجع 0;
}
