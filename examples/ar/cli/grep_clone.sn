// أداة grep صغيرة: تطبع المدخل إن احتوى كلمة معينة، وإلا تخبر بأنه لا شيء مطابق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.بحث;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    دع النص: نص = اقرأ_المدخل("نجح بناء المترجم");
    دع الإبرة: نص = "بُني";
    إذا (يحتوي_نصا(&النص, &الإبرة)) {
        اطبع_سطر(النص);
    } وإلا {
        اطبع_سطر("لا توجد أسطر مطابقة");
    };
    أرجع 0;
}
