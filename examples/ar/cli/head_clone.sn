// أداة head صغيرة: تطبع السطر الأول من المدخل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف اقرأ_المدخل(الافتراضي: نص): نص {
    إذا (عدد_الوسائط() > 1) {
        طابق وسيطة(1) مع
        | اختياري.موجود(النص) -> {
            إذا (الطول(النص) > 0) { أرجع النص; };
        }
        | اختياري.لا_شيء -> { };
    };
    أرجع الافتراضي;
}

عرف الرئيسية(): عدد {
    ليكن النص: نص = اقرأ_المدخل("الأول\nالثاني\nالثالث");
    ليكن الأسطر: متجه نص = قسم_النص(&النص, &"\n");
    إذا (الطول(الأسطر) == 0) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأسطر[0]));
    أرجع 0;
}
