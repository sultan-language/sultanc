// مثال على الدوال الرياضية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف احصر_عددا(س: عدد, الأدنى: عدد, الأعلى: عدد): عدد { إذا (س < الأدنى) { أرجع الأدنى; }; إذا (س > الأعلى) { أرجع الأعلى; }; أرجع س; }

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(احصر_عددا(35, 5, 30)));
    أرجع 0;
}
