// مثال على الدوال الرياضية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف القوة(الأساس: عدد, ن: عدد): عدد { دع المجموع: متغير عدد = 1; دع ف: متغير عدد = 0; طالما (ف < ن) { المجموع := المجموع * الأساس; ف := ف + 1; }; أرجع المجموع; }

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(القوة(2, 6)));
    أرجع 0;
}
