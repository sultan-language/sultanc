// مثال على الدوال الرياضية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.رياضيات.عشري;


عرف الرئيسية(): عدد {
    ليكن البيانات: متجه ع64 = [2.0, 4.0, 6.0, 9.0];
    طابق متوسط64(&البيانات) مع
    | اختياري.موجود(ن) -> { إذا (ن > 0.0) { اطبع_سطر("المتوسط موجب"); }; }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
