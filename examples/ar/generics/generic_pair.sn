// مثال على الأنواع والدوال العامة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع زوج<النوع_الأول, النوع_الثاني> = { الأول: النوع_الأول, الثاني: النوع_الثاني };
عرف أنشئ_زوجا<النوع_الأول, النوع_الثاني>(الأول: النوع_الأول, الثاني: النوع_الثاني): زوج<النوع_الأول, النوع_الثاني> { أرجع { الأول: الأول, الثاني: الثاني }; }

عرف الرئيسية(): عدد {
    ليكن الزوج: زوج<عدد, نص> = أنشئ_زوجا(4, "زوج");
    اطبع_سطر(عدد_إلى_نص(الزوج.الأول));
    أرجع 0;
}
