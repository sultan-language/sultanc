// سجل مكدس عام يعتمد على متجه.
استورد std.io.println;
استورد std.text.number;

نوع مكدس<ق> = { العناصر: متجه ق };

عرف أنشئ_مكدسا<ق>(): مكدس<ق> {
    دع الفارغ: متجه ق = [];
    دع المكدس: مكدس<ق> = { العناصر: الفارغ };
    أرجع المكدس;
}

عرف ادفع_إلى<ق>(المكدس: &متغير مكدس<ق>, العنصر: ق): فراغ {
    ألحق((*المكدس).العناصر, العنصر);
}

عرف الحجم<ق>(المكدس: &مكدس<ق>): طبيعي {
    أرجع الطول((*المكدس).العناصر) مثل طبيعي;
}

عرف القمة<ق>(المكدس: &مكدس<ق>): اختياري ق {
    دع العدد: طبيعي = الحجم(المكدس);
    لو (العدد == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(استنسخ(&(*المكدس).العناصر[العدد - 1]));
}

عرف الرئيسية(): عدد {
    دع الأعداد: متغير مكدس<عدد> = أنشئ_مكدسا();
    ادفع_إلى(&متغير الأعداد, 10);
    ادفع_إلى(&متغير الأعداد, 20);
    ادفع_إلى(&متغير الأعداد, 30);
    اطبع_سطر(طبيعي_إلى_نص(الحجم(&الأعداد)));
    طابق القمة(&الأعداد) مع
    | اختياري.موجود(القيمة) -> { اطبع_سطر(عدد_إلى_نص(القيمة)); }
    | اختياري.لا_شيء -> { اطبع_سطر("فارغ"); };
    أرجع 0;
}
