// نوع جبري عام ودوال عامة تُستخدم مع عدة أنواع.
استورد std.io.println;
استورد std.text.number;

نوع ربما<ق> = | لا_قيمة | قيمة بنوع ق;
نوع زوج<ن, م> = { الأول: ن, الثاني: م };

عرف القيمة_أو<ق>(القيمة: ربما<ق>, البديل: ق): ق {
    طابق القيمة مع
    | ربما.لا_قيمة -> { أرجع البديل; }
    | ربما.قيمة(العنصر) -> { أرجع العنصر; };
}

عرف اقلب<ن, م>(الزوج: &زوج<ن, م>): زوج<م, ن> {
    دع الزوج_الناتج: زوج<م, ن> = { الأول: استنسخ(&(*الزوج).الثاني), الثاني: استنسخ(&(*الزوج).الأول) };
    أرجع الزوج_الناتج;
}

عرف الرئيسية(): عدد {
    دع الموجود: ربما<عدد> = ربما.قيمة(42);
    دع المفقود: ربما<عدد> = ربما.لا_قيمة();
    دع الكلمة: ربما<نص> = ربما.قيمة("عام");
    اطبع_سطر(عدد_إلى_نص(القيمة_أو(الموجود, 0)));
    اطبع_سطر(عدد_إلى_نص(القيمة_أو(المفقود, -1)));
    اطبع_سطر(القيمة_أو(الكلمة, "لا شيء"));
    دع الزوج: زوج<عدد, منطقي> = { الأول: 7, الثاني: صواب };
    دع المقلوب: زوج<منطقي, عدد> = اقلب(&الزوج);
    لو (المقلوب.الأول) { اطبع_سطر(عدد_إلى_نص(المقلوب.الثاني)); };
    أرجع 0;
}
