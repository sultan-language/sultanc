// وسائط سطر الأوامر: الوسيطة 0 هي البرنامج نفسه.
استورد std.io.println;
استورد std.text.number;
استورد std.process.argument_count;
استورد std.process.argument;

عرف الرئيسية(): عدد {
    دع العدد: طبيعي = عدد_الوسائط();
    اطبع_سطر(طبيعي_إلى_نص(العدد));
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        طابق وسيطة(ف) مع
        | اختياري.موجود(النص) -> { اطبع_سطر(النص); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع 0;
}
