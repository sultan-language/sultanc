// وسائط سطر الأوامر: الوسيطة 0 هي البرنامج نفسه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عمليات.عدد_الوسائط;
استورد المكتبة.عمليات.وسيطة;

عرف الرئيسية(): عدد {
    ليكن العدد: طبيعي = عدد_الوسائط();
    اطبع_سطر(طبيعي_إلى_نص(العدد));
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        طابق وسيطة(ف) مع
        | اختياري.موجود(النص) -> { اطبع_سطر(النص); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع 0;
}
