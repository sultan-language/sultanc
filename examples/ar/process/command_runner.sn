// مثال على العمليات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عمليات.عملية_ابن;


عرف الرئيسية(): عدد {
    ليكن البرنامج: نص = "/bin/sh";
    ليكن الوسائط: متجه نص = ["-c", "exit 6"];
    طابق شغل_وانتظر(&البرنامج, &الوسائط) مع
    | نتيجة.نجح(حالة_إنهاء.خرج(رمز_الخروج)) -> { اطبع_سطر(عدد_إلى_نص(رمز_الخروج)); }
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    أرجع 0;
}
