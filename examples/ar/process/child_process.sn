// تشغيل برنامج آخر وانتظار حالة خروجه.
استورد std.io.println;
استورد std.text.number;
استورد std.process.child;

عرف الرئيسية(): عدد {
    دع البرنامج: نص = "/bin/sh";
    دع الوسائط: متجه نص = ["-c", "exit 7"];
    طابق شغل_وانتظر(&البرنامج, &الوسائط) مع
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> { اطبع_سطر(عدد_إلى_نص(الرمز)); }
    | نتيجة.نجح(_) -> { اطبع_سطر("أُوقف بإشارة"); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("تعذر التشغيل"); أرجع 1; };
    أرجع 0;
}
