// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.مسار;


عرف الرئيسية(): عدد {
    ليكن سيئ: نص = "invalid\u0000path";
    إذا (!مسار_نظام_بلا_صفر_مدمج(&سيئ)) { اطبع_سطر("رُفض البايت الصفري المضمّن"); } وإلا { أرجع 1; };
    أرجع 0;
}
