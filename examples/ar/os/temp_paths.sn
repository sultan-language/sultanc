// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.بيئة.بيئة_العمل;


عرف الرئيسية(): عدد {
    طابق الدليل_المؤقت() مع
    | نتيجة.نجح(المسار) -> { اطبع_سطر(المسار); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("مجلد الملفات المؤقتة غير متاح"); };
    أرجع 0;
}
