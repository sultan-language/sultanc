// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.عشوائية;


عرف الرئيسية(): عدد {
    ليكن البايتات: متغير متجه ط8 = [0 مثل ط8, 0 مثل ط8, 0 مثل ط8, 0 مثل ط8];
    طابق املأ_بايتات_عشوائية_النظام(&متغير البايتات) مع
    | نتيجة.نجح(العدد) -> { اطبع_سطر(طبيعي_إلى_نص(العدد)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
