// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.مسار;


عرف الرئيسية(): عدد {
    دع اسم_الملف: نص = "output.txt";
    إذا (مسار_نظام_بلا_صفر_مدمج(&اسم_الملف)) { اطبع_سطر("مسار مناسب لواجهة واصفات الملفات"); } وإلا { أرجع 1; };
    أرجع 0;
}
