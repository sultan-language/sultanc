// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.مسار;


عرف الرئيسية(): عدد {
    دع المسار: نص = "file.txt";
    دع بايتات_صفرية: متجه ط8 = [102 مثل ط8, 105 مثل ط8, 108 مثل ط8, 101 مثل ط8];
    طابق بايتات_مسار_يونكس_صفرية(&بايتات_صفرية) مع
    | نتيجة.نجح(البايتات) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(البايتات) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
