// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.بيئة.بيئة_العمل;


عرف الرئيسية(): عدد {
    ليكن مفقود: نص = "SULTANC_EXAMPLE_ENV_MISSING_394";
    طابق متغير_بيئة(&مفقود) مع
    | نتيجة.نجح(القيمة) -> { طابق القيمة مع | اختياري.موجود(_) -> { اطبع_سطر("معرّف"); } | اختياري.لا_شيء -> { اطبع_سطر("غير معرّف"); }; }
    | نتيجة.خطأ(رمز_الخروج) -> { اطبع_سطر(عدد_إلى_نص(رمز_الخروج)); };
    أرجع 0;
}
