// مثال على واجهات نظام التشغيل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.ساعة;


عرف الرئيسية(): عدد {
    ليكن السابق: لحظة_رتيبة_نظام = أنشئ_لحظة_رتيبة_نظام(125);
    ليكن اللاحق: لحظة_رتيبة_نظام = أنشئ_لحظة_رتيبة_نظام(300);
    طابق مدة_بين_لحظتين_رتيبتين(&السابق, &اللاحق) مع
    | اختياري.موجود(نانوثانية) -> { اطبع_سطر(عدد_إلى_نص(نانوثانية)); }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
