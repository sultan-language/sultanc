// استدعاء strtol من C عبر `خارجي` على مخزن ينتهي بالبايت الصفري: تُحلَّل "127" إلى 127، ويُمرر
// وسيط مؤشر النهاية مؤشرا إلى مؤشر.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف حول_سلسلة_إلى_عدد_سي(النص: *ط8, مؤشر_النهاية: **ط8, الأساس: ص32): ص64 = «strtol»;

عرف الرئيسية(): عدد {
    ليكن الأرقام_المفردة: متغير متجه ط8 = [49 مثل ط8, 50 مثل ط8, 55 مثل ط8, 0 مثل ط8];
    ليكن النهاية: *ط8 = 0 مثل *ط8;
    ليكن القيمة: متغير ص64 = 0 مثل ص64;
    غير_آمن { القيمة := حول_سلسلة_إلى_عدد_سي(&الأرقام_المفردة[0], &النهاية, 10 مثل ص32); };
    إذا (القيمة != 127 مثل ص64) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(القيمة مثل عدد));
    أرجع 0;
}
