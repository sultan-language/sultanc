// مؤشر فارغ من C: تعيد strchr مؤشرا فارغا إن لم يكن الحرف في النص، ويفحص البرنامج ذلك.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف جد_حرفا_سي(النص: *ط8, ج: ص32): *ط8 = «strchr»;

عرف الرئيسية(): عدد {
    دع المدخل: متغير متجه ط8 = [97 مثل ط8, 98 مثل ط8, 0 مثل ط8];
    دع الموضع: *ط8;
    غير_آمن { الموضع := جد_حرفا_سي(&المدخل[0], 122 مثل ص32); };
    إذا (الموضع != 0 مثل *ط8) { أرجع 1; };
    اطبع_سطر("لم يوجد");
    أرجع 0;
}
