// استدعاء دالة من مكتبة C وقت التشغيل: تعيد getpid معرف هذه العملية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف معرف_العملية_سي(): ص32 = «getpid»;

عرف الرئيسية(): عدد {
    ليكن معرف_العملية: متغير ص32 = 0 مثل ص32;
    غير_آمن { معرف_العملية := معرف_العملية_سي(); };
    إذا (معرف_العملية <= 0 مثل ص32) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(معرف_العملية مثل عدد));
    أرجع 0;
}
