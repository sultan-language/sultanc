// تمرير السجلات إلى C بالمؤشر: تأخذ nanosleep سجلين من النوع وقت_دقيق مرتبين مثل بنية C.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع وقت_دقيق = { الثواني: ص64, النانوثواني: ص64 };

خارجي عرف نم_بدقة_سي(الطلب_المرسل: *وقت_دقيق, المتبقي: *وقت_دقيق): ص32 = «nanosleep»;

عرف الرئيسية(): عدد {
    ليكن القيمة: متغير وقت_دقيق = { الثواني: 0 مثل ص64, النانوثواني: 0 مثل ص64 };
    ليكن الأيسر: متغير وقت_دقيق = { الثواني: 0 مثل ص64, النانوثواني: 0 مثل ص64 };
    ليكن الحالة: متغير ص32 = 0 مثل ص32;
    غير_آمن { الحالة := نم_بدقة_سي(&القيمة, &الأيسر); };
    إذا (الحالة != 0 مثل ص32) { أرجع 1; };
    اطبع_سطر("اكتمل السكون");
    أرجع 0;
}
