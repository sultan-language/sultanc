// نص UTF-8 في C: تعد strlen البايتات، فالحرفان العربيان "مر" يعطيان 4.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف طول_سلسلة_سي(النص: *ط8): طبيعي = «strlen»;

عرف الرئيسية(): عدد {
    ليكن المدخل: متغير متجه ط8 = [217 مثل ط8, 133 مثل ط8, 216 مثل ط8, 177 مثل ط8, 0 مثل ط8];
    ليكن العدد_المحتسب: متغير طبيعي = 0;
    غير_آمن { العدد_المحتسب := طول_سلسلة_سي(&المدخل[0]); };
    إذا (العدد_المحتسب != 4 مثل طبيعي) { أرجع 1; };
    اطبع_سطر(طبيعي_إلى_نص(العدد_المحتسب));
    أرجع 0;
}
