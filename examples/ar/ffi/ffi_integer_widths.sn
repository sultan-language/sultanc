// عرض الأعداد الصحيحة عبر حدود C: تأخذ abs عددا من 32 بتا وتعيده، وهنا مع -2147483647،
// أصغر قيمة ما زالت قيمتها المطلقة تتسع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف القيمة_المطلقة_سي(القيمة: ص32): ص32 = «abs»;

عرف الرئيسية(): عدد {
    دع ن: متغير ص32 = 0 مثل ص32;
    غير_آمن { ن := القيمة_المطلقة_سي(-2147483647 مثل ص32); };
    إذا (ن != 2147483647 مثل ص32) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(ن مثل عدد));
    أرجع 0;
}
