// معامل إخراج في C: تحلل strtol الرقمين "24" وتتوقف عند "x"، وتأخذ مؤشرا إلى مؤشر النهاية
// الذي يمكنها تعيينه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف حول_سلسلة_إلى_عدد_سي(النص: *ط8, مؤشر_النهاية: **ط8, الأساس: ص32): ص64 = «strtol»;

عرف الرئيسية(): عدد {
    ليكن الأرقام_المفردة: متغير متجه ط8 = [50 مثل ط8, 52 مثل ط8, 120 مثل ط8, 0 مثل ط8];
    ليكن النهاية: *ط8 = 0 مثل *ط8;
    ليكن القيمة: متغير ص64 = 0 مثل ص64;
    غير_آمن { القيمة := حول_سلسلة_إلى_عدد_سي(&الأرقام_المفردة[0], &النهاية, 10 مثل ص32); };
    إذا (القيمة != 24 مثل ص64) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(القيمة مثل عدد));
    أرجع 0;
}
