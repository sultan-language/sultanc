// دالة C تعيد بنية بالقيمة: تعطي div حاصل القسمة والباقي في سجل واحد.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع نتيجة_قسمة = { خارج_القسمة: ص32, الباقي: ص32 };

خارجي عرف اقسم_سي(البسط: ص32, المقام: ص32): نتيجة_قسمة = «div»;

عرف الرئيسية(): عدد {
    ليكن الناتج: متغير نتيجة_قسمة = { خارج_القسمة: 0 مثل ص32, الباقي: 0 مثل ص32 };
    غير_آمن { الناتج := اقسم_سي(17 مثل ص32, 5 مثل ص32); };
    إذا (الناتج.خارج_القسمة != 3 مثل ص32 || الناتج.الباقي != 2 مثل ص32) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الناتج.خارج_القسمة مثل عدد));
    أرجع 0;
}
