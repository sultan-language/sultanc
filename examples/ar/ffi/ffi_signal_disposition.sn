// تغيير طريقة التعامل مع إشارة عبر C: تُتجاهل SIGPIPE (13) بـ signal، ثم تُرفع دون أن تتوقف
// العملية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

خارجي عرف إشارة_سي(الإشارة: ص32, المعالج: *ط8): *ط8 = «signal»;
خارجي عرف أطلق_إشارة_سي(الإشارة: ص32): ص32 = «raise»;

عرف الرئيسية(): عدد {
    دع السابق: متغير *ط8 = 0 مثل *ط8;
    دع الحالة: متغير ص32 = 1 مثل ص32;
    غير_آمن {
        السابق := إشارة_سي(13 مثل ص32, 1 مثل *ط8);
        الحالة := أطلق_إشارة_سي(13 مثل ص32);
    };
    إذا (الحالة != 0 مثل ص32) { أرجع 1; };
    اطبع_سطر("تم تجاهل الإشارة");
    أرجع 0;
}
