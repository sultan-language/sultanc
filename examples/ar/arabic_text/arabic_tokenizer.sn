// تقسيم جملة عربية إلى كلمات عند المسافات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "برمجة عربية حديثة";
    دع المسافة: نص = " ";
    دع الكلمات: متجه نص = قسم_النص(&المصدر, &المسافة);
    إذا (الطول(الكلمات) != 3) { أرجع 1; };
    اطبع_سطر(استنسخ(&الكلمات[1]));
    أرجع 0;
}
