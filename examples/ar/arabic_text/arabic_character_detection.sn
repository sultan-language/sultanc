// اكتشاف الحروف العربية في نص UTF-8 من بايتاتها الأولى 0xD8 و 0xD9.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف يحوي_عربية(النص: &نص): منطقي {
    دع ف: متغير عدد = 0;
    طالما (ف + 1 < الطول(*النص)) {
        دع الأول: ط8 = (*النص)[ف];
        دع الثاني: ط8 = (*النص)[ف + 1];
        إذا ((الأول == 0xd8 مثل ط8 || الأول == 0xd9 مثل ط8) && (الثاني >= 0x80 مثل ط8) && (الثاني <= 0xbf مثل ط8)) {
            أرجع صواب;
        };
        ف := ف + 1;
    };
    أرجع خطأ;
}

عرف الرئيسية(): عدد {
    دع المختلط: نص = "Hello مرحبا";
    دع اللاتيني: نص = "Hello";
    إذا (!يحوي_عربية(&المختلط) || يحوي_عربية(&اللاتيني)) { أرجع 1; };
    اطبع_سطر("اكتشفت حروف عربية");
    أرجع 0;
}
