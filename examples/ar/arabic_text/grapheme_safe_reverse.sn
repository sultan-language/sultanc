// عكس نص عربي بعناقيد المحارف حتى يبقى كل حرف مع حركاته، باستعمال حدود العناقيد في يونيكود.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.عناقيد;
استورد المكتبة.نصوص.مقطع;
استورد المكتبة.نصوص.تحويل;

عرف اعكس_العناقيد(النص: &نص): اختياري نص {
    طابق حدود_عناقيد_بايتات_يونيكود(النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الحدود) -> {
        دع المخرج: متغير نص = "";
        دع ف: متغير عدد = الطول(الحدود) - 1;
        طالما (ف > 0) {
            دع البداية: طبيعي = الحدود[ف - 1];
            دع ن: طبيعي = الحدود[ف] - البداية;
            طابق مقطع_نص(النص, البداية, ن) مع
            | اختياري.موجود(الجزء) -> {
                دع الموصول: نص = صل_نصين(&المخرج, &الجزء);
                المخرج := الموصول;
            }
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
            ف := ف - 1;
        };
        أرجع اختياري.موجود(المخرج);
    };
}

عرف الرئيسية(): عدد {
    دع المدخل: نص = "سَلَام";
    طابق اعكس_العناقيد(&المدخل) مع
    | اختياري.موجود(المعكوس) -> {
        إذا (الطول(المعكوس) != الطول(المدخل)) { أرجع 1; };
        اطبع_سطر(المعكوس);
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
