// توحيد الهمزة على كرسيها: استبدال ؤ بـ و، و ئ بـ ي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "مسؤول بريئة";
    ليكن الأول: نص = "ؤ";
    ليكن بديل_الأول: نص = "و";
    ليكن الثاني: نص = "ئ";
    ليكن بديل_الثاني: نص = "ي";
    ليكن المرحلة: نص = استبدل_في_النص(&المصدر, &الأول, &بديل_الأول);
    اطبع_سطر(استبدل_في_النص(&المرحلة, &الثاني, &بديل_الثاني));
    أرجع 0;
}
