// توحيد الهمزة على كرسيها: استبدال ؤ بـ و، و ئ بـ ي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "مسؤول بريئة";
    دع الأول: نص = "ؤ";
    دع بديل_الأول: نص = "و";
    دع الثاني: نص = "ئ";
    دع بديل_الثاني: نص = "ي";
    دع المرحلة: نص = استبدل_في_النص(&المصدر, &الأول, &بديل_الأول);
    اطبع_سطر(استبدل_في_النص(&المرحلة, &الثاني, &بديل_الثاني));
    أرجع 0;
}
