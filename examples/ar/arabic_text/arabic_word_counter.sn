// عد كلمات جملة عربية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "لغة برمجة عربية قابلة للتعلم";
    دع الكلمات: متجه نص = قسم_النص(&المصدر, &" ");
    دع العدد: عدد = الطول(الكلمات);
    إذا (العدد != 5) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
