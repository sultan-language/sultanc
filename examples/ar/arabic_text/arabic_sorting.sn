// ترتيب أسماء عربية بـ`رتب_نصوص` ثم وصلها للطباعة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.ترتيب;

عرف الرئيسية(): عدد {
    دع القيم: متغير متجه نص = ["يوسف", "أحمد", "زيد"];
    رتب_نصوص(&متغير القيم);
    دع الفاصل: نص = " | ";
    اطبع_سطر(صل_النصوص(&القيم, &الفاصل));
    أرجع 0;
}
