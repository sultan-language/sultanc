// توحيد الألف: استبدال أ و إ و آ بألف مجردة ا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "أإآا";
    ليكن المجرد: نص = "ا";
    ليكن واحد: نص = "أ";
    ليكن اثنان: نص = "إ";
    ليكن ثلاثة: نص = "آ";
    ليكن أ: نص = استبدل_في_النص(&المصدر, &واحد, &المجرد);
    ليكن ب: نص = استبدل_في_النص(&أ, &اثنان, &المجرد);
    اطبع_سطر(استبدل_في_النص(&ب, &ثلاثة, &المجرد));
    أرجع 0;
}
