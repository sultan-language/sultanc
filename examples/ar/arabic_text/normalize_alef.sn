// توحيد الألف: استبدال أ و إ و آ بألف مجردة ا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "أإآا";
    دع المجرد: نص = "ا";
    دع واحد: نص = "أ";
    دع اثنان: نص = "إ";
    دع ثلاثة: نص = "آ";
    دع أ: نص = استبدل_في_النص(&المصدر, &واحد, &المجرد);
    دع ب: نص = استبدل_في_النص(&أ, &اثنان, &المجرد);
    اطبع_سطر(استبدل_في_النص(&ب, &ثلاثة, &المجرد));
    أرجع 0;
}
