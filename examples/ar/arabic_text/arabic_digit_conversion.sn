// تحويل الأرقام العربية المشرقية (١٢٣) إلى أرقام ASCII (123) باستبدال كل رقم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "١٢٣";
    ليكن أ: نص = "١";
    ليكن ب: نص = "٢";
    ليكن ج: نص = "٣";
    ليكن واحد: نص = "1";
    ليكن اثنان: نص = "2";
    ليكن ثلاثة: نص = "3";
    ليكن المرحلة_الأولى: نص = استبدل_في_النص(&المصدر, &أ, &واحد);
    ليكن المرحلة_الثانية: نص = استبدل_في_النص(&المرحلة_الأولى, &ب, &اثنان);
    اطبع_سطر(استبدل_في_النص(&المرحلة_الثانية, &ج, &ثلاثة));
    أرجع 0;
}
