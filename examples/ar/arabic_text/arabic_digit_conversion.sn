// تحويل الأرقام العربية المشرقية (١٢٣) إلى أرقام ASCII (123) باستبدال كل رقم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "١٢٣";
    دع أ: نص = "١";
    دع ب: نص = "٢";
    دع ج: نص = "٣";
    دع واحد: نص = "1";
    دع اثنان: نص = "2";
    دع ثلاثة: نص = "3";
    دع المرحلة_الأولى: نص = استبدل_في_النص(&المصدر, &أ, &واحد);
    دع المرحلة_الثانية: نص = استبدل_في_النص(&المرحلة_الأولى, &ب, &اثنان);
    اطبع_سطر(استبدل_في_النص(&المرحلة_الثانية, &ج, &ثلاثة));
    أرجع 0;
}
