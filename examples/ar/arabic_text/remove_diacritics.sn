// حذف التشكيل العربي: نزع الفتحة والسكون والتنوين من كلمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "مَرْحَبًا";
    دع الفتحة: نص = "َ";
    دع السكون: نص = "ْ";
    دع التنوين: نص = "ً";
    دع فارغ: نص = "";
    دع المرحلة: نص = استبدل_في_النص(&المصدر, &الفتحة, &فارغ);
    دع المرحلة_الثانية: نص = استبدل_في_النص(&المرحلة, &السكون, &فارغ);
    دع النص_الأصلي: نص = استبدل_في_النص(&المرحلة_الثانية, &التنوين, &فارغ);
    اطبع_سطر(النص_الأصلي);
    أرجع 0;
}
