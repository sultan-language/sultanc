// حذف التشكيل العربي: نزع الفتحة والسكون والتنوين من كلمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "مَرْحَبًا";
    ليكن الفتحة: نص = "َ";
    ليكن السكون: نص = "ْ";
    ليكن التنوين: نص = "ً";
    ليكن فارغ: نص = "";
    ليكن المرحلة: نص = استبدل_في_النص(&المصدر, &الفتحة, &فارغ);
    ليكن المرحلة_الثانية: نص = استبدل_في_النص(&المرحلة, &السكون, &فارغ);
    ليكن النص_الأصلي: نص = استبدل_في_النص(&المرحلة_الثانية, &التنوين, &فارغ);
    اطبع_سطر(النص_الأصلي);
    أرجع 0;
}
