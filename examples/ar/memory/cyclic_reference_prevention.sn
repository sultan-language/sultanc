// التوقف عند الدورة: تُتبع روابط التالي مع علامة زيارة لكل عقدة، فينتهي المشي عند رابط يعود
// إلى عقدة سبقت زيارتها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عقدة = { القيمة: عدد, التالي: عدد };

عرف الرئيسية(): عدد {
    ليكن العقد: متجه عقدة = [{ القيمة: 1, التالي: 1 }, { القيمة: 2, التالي: -1 }];
    ليكن المزارة: متغير متجه منطقي = [خطأ, خطأ];
    ليكن الموضع: متغير عدد = 0;
    ليكن العدد: متغير عدد = 0;
    طالما (الموضع >= 0 && !المزارة[الموضع]) {
        المزارة[الموضع] := صواب;
        العدد := العدد + 1;
        الموضع := العقد[الموضع].التالي;
    };
    إذا (العدد != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
