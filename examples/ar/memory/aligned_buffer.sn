// مخزن بايتات بحجم ثابت: تُملأ 16 بايتا في حلقة، ويُقرأ أحدها بالفهرس.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الكتلة: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < 16) {
        ألحق(الكتلة, (ف * 2) مثل ط8);
        ف := ف + 1;
    };
    إذا (الطول(الكتلة) != 16) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الكتلة[8] مثل عدد));
    أرجع 0;
}
