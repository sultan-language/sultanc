// قيم في الكومة بـ`صندوق`، ومؤشرات خام تحتاج كتلة `غير_آمن`.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن المعلب: صندوق عدد = صندوق 40;
    ليكن المجموع: عدد = *المعلب + 2;
    اطبع_سطر(عدد_إلى_نص(المجموع));

    ليكن العداد: متغير عدد = 10;
    ليكن المؤشر: *متغير عدد = &متغير العداد;
    غير_آمن {
        *المؤشر := *المؤشر * 3;
    }
    اطبع_سطر(عدد_إلى_نص(العداد));
    أرجع 0;
}
