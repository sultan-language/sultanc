// تحديث سجل في مكانه عبر مرجع قابل للتعديل: يغير الإيداع رصيد حساب المستدعي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع حساب = { الرصيد: عدد };

عرف أودع(أ: &متغير حساب, المقدار: عدد): فراغ {
    (*أ).الرصيد := (*أ).الرصيد + المقدار;
}

عرف الرئيسية(): عدد {
    ليكن أ: متغير حساب = { الرصيد: 10 };
    أودع(&متغير أ, 7);
    إذا (أ.الرصيد != 17) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(أ.الرصيد));
    أرجع 0;
}
