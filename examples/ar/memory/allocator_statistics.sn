// عد الحجوزات على الكومة يدويا: قيمتان في صندوقين، ومجموعهما يُقرأ من خلالهما.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الأول: صندوق عدد = صندوق 11;
    دع الثاني: صندوق عدد = صندوق 22;
    دع المخصص: عدد = 2;
    دع المجموع: عدد = *الأول + *الثاني;
    إذا (المخصص != 2 || المجموع != 33) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المخصص));
    أرجع 0;
}
