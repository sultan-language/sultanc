// مثال على الذاكرة والمؤشرات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع خلية = { العدد: عدد };
عرف اقرأ_الخلية(الخلية: &خلية): عدد { أرجع (*الخلية).العدد; }

عرف الرئيسية(): عدد {
    دع قيمة_الصندوق: صندوق خلية = صندوق { العدد: 7 };
    اطبع_سطر(عدد_إلى_نص(اقرأ_الخلية(&*قيمة_الصندوق)));
    أرجع 0;
}
