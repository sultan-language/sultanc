// معالجة طلب حجز مرفوض: الطلب الذي يتجاوز الحد يعيد رمز خطأ بدل المتجه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف احجز_إن_صغر(ن: عدد): نتيجة متجه عدد, عدد {
    إذا (ن > 100) { أرجع نتيجة.خطأ(1); };
    دع ق: متغير متجه عدد = [];
    دع ف: متغير عدد = 0;
    طالما (ف < ن) {
        ألحق(ق, ف);
        ف := ف + 1;
    };
    أرجع نتيجة.نجح(ق);
}

عرف الرئيسية(): عدد {
    طابق احجز_إن_صغر(1000) مع
    | نتيجة.خطأ(الرمز) -> { اطبع_سطر(عدد_إلى_نص(الرمز)); }
    | نتيجة.نجح(_) -> { أرجع 1; };
    أرجع 0;
}
