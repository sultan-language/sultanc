// مؤشر خام إلى عنصر في متجه: يُغيَّر العنصر عبر المؤشر داخل `غير_آمن`.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن الأرقام: متغير متجه عدد = [2, 4, 6];
    ليكن المؤشر: *متغير عدد = &متغير الأرقام[1];
    غير_آمن { *المؤشر := *المؤشر * 3; };
    إذا (الأرقام[1] != 12) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الأرقام[1]));
    أرجع 0;
}
