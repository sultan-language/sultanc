// حزم عدد من 32 بتا في بايتات بترتيب الأصغر أولا، بالإزاحة والأقنعة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الرقم: ط32 = 0x12345678 مثل ط32;
    دع البايتات: متجه ط8 = [
        (الرقم & 0xff) مثل ط8,
        ((الرقم >> 8) & 0xff) مثل ط8,
        ((الرقم >> 16) & 0xff) مثل ط8,
        ((الرقم >> 24) & 0xff) مثل ط8
    ];
    إذا (البايتات[0] != 0x78 مثل ط8 || البايتات[3] != 0x12 مثل ط8) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(البايتات[0] مثل عدد));
    أرجع 0;
}
