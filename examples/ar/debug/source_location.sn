// مثال على التشخيص والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.موقع;


عرف الرئيسية(): عدد {
    ليكن الملف: نص = "example.sn";
    ليكن الموضع: موقع_مصدر = { الملف: &الملف, السطر: 42 مثل طبيعي, العمود: 7 مثل طبيعي };
    اطبع_سطر(نص_موقع_مصدر(&الموضع));
    أرجع 0;
}
