// مثال على التشخيص والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف العملية_الحالية(القيمة_الوسيطة: عدد): عدد { أرجع القيمة_الوسيطة * 3; }
عرف الرئيسية(): عدد {
    اطبع_سطر("بدء المعالجة");
    دع النتيجة_القيمة: عدد = العملية_الحالية(12);
    اطبع_سطر(عدد_إلى_نص(النتيجة_القيمة));
    اطبع_سطر("انتهاء المعالجة");
    أرجع 0;
}
