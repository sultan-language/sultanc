// مثال على التشخيص والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;


عرف الرئيسية(): عدد {
    ليكن الرسالة: نص = "المتوقع ثلاثة عناصر بالضبط";
    ليكن العناصر: متجه عدد = [10, 20, 30];
    تأكد_برسالة(الطول(العناصر) == 3, &الرسالة);
    اطبع_سطر("تم التحقق من الحجم");
    أرجع 0;
}
