// مثال على التشخيص والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اقسم_بفحص(أ: عدد, ب: عدد): نتيجة عدد, عدد { إذا (ب == 0) { أرجع نتيجة.خطأ(1); }; أرجع نتيجة.نجح(أ / ب); }
عرف الرئيسية(): عدد {
    طابق اقسم_بفحص(15, 0) مع
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(رمز_الخروج) -> { اطبع_سطر(عدد_إلى_نص(رمز_الخروج)); };
    أرجع 0;
}
