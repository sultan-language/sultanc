// مثال على التشخيص والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;


عرف الرئيسية(): عدد {
    ليكن الأعداد: متجه عدد = [1, 3, 5, 7];
    ليكن الفهرس: متغير عدد = 0;
    طالما (الفهرس < الطول(الأعداد)) { تأكد(الأعداد[الفهرس] > 0); الفهرس := الفهرس + 1; };
    اطبع_سطر("كل القيم موجبة");
    أرجع 0;
}
