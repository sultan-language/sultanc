// مثال على التحكم في سير التنفيذ.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع إشارة = | أحمر | أصفر | أخضر;

عرف الرئيسية(): عدد {
    ليكن الحالي: إشارة = إشارة.أخضر();
    طابق الحالي مع
    | إشارة.أحمر -> { اطبع_سطر("توقف"); }
    | إشارة.أصفر -> { اطبع_سطر("انتظر"); }
    | إشارة.أخضر -> { اطبع_سطر("انطلق"); };
    أرجع 0;
}
