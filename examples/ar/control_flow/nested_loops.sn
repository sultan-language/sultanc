// مثال على التحكم في سير التنفيذ.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;


عرف الرئيسية(): عدد {
    دع العدد: متغير عدد = 0;
    لكل (دع ف: متغير عدد = 0; ف < 3; ف := ف + 1) {
        لكل (دع ي: متغير عدد = 0; ي < 4; ي := ي + 1) {
            إذا (ف == ي) { تابع_حلقة; };
            العدد := العدد + 1;
        }
    }
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
