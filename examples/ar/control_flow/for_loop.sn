// حلقة `لكل` بأسلوب لغة C مع `تابع_حلقة` و`اخرج_من_حلقة`.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن المجموع: متغير عدد = 0;
    لكل (ليكن ف: متغير عدد = 1; ف <= 100; ف := ف + 1) {
        إذا (ف % 3 == 0) { تابع_حلقة; };
        إذا (ف > 10) { اخرج_من_حلقة; };
        المجموع := المجموع + ف;
    }
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
