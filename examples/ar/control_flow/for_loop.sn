// حلقة `لكل` بأسلوب لغة C مع `تابع_حلقة` و`اخرج_من_حلقة`.
استورد std.io.println;
استورد std.text.number;

عرف الرئيسية(): عدد {
    دع المجموع: متغير عدد = 0;
    لكل (دع ف: متغير عدد = 1; ف <= 100; ف := ف + 1) {
        لو (ف % 3 == 0) { تابع_حلقة; };
        لو (ف > 10) { اخرج_من_حلقة; };
        المجموع := المجموع + ف;
    }
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
