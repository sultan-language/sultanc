// ترتيب بالإدراج في المكان نفسه عبر مرجع متغير.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف رتب_بالإدراج(القيم: &متغير متجه عدد): فراغ {
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        ليكن الحالي: عدد = (*القيم)[ف];
        ليكن ك: متغير طبيعي = ف;
        طالما (ك > 0 && (*القيم)[ك - 1] > الحالي) {
            (*القيم)[ك] := (*القيم)[ك - 1];
            ك := ك - 1;
        }
        (*القيم)[ك] := الحالي;
        ف := ف + 1;
    }
}

عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [31, 4, 15, 9, 26, 5, 3];
    رتب_بالإدراج(&متغير القيم);
    ليكن النصوص: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        ألحق(النصوص, عدد_إلى_نص(القيم[ف]));
        ف := ف + 1;
    }
    ليكن المسافة: نص = " ";
    اطبع_سطر(صل_النصوص(&النصوص, &المسافة));
    أرجع 0;
}
