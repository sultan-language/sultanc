// ترتيب بالإدراج في المكان نفسه عبر مرجع متغير.
استورد std.io.println;
استورد std.text.number;
استورد std.text.transform;

عرف رتب_بالإدراج(القيم: &متغير متجه عدد): فراغ {
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        دع الحالي: عدد = (*القيم)[ف];
        دع ك: متغير طبيعي = ف;
        طالما (ك > 0 && (*القيم)[ك - 1] > الحالي) {
            (*القيم)[ك] := (*القيم)[ك - 1];
            ك := ك - 1;
        }
        (*القيم)[ك] := الحالي;
        ف := ف + 1;
    }
}

عرف الرئيسية(): عدد {
    دع القيم: متغير متجه عدد = [31, 4, 15, 9, 26, 5, 3];
    رتب_بالإدراج(&متغير القيم);
    دع النصوص: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        ألحق(النصوص, عدد_إلى_نص(القيم[ف]));
        ف := ف + 1;
    }
    دع المسافة: نص = " ";
    اطبع_سطر(صل_النصوص(&النصوص, &المسافة));
    أرجع 0;
}
