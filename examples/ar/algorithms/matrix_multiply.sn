عرف القلعة(): عدد {
    دع أ: متجه عدد = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    دع ب: متجه عدد = [9, 8, 7, 6, 5, 4, 3, 2, 1];
    دع ج: متغير متجه عدد = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    دع الصف: متغير غير_موقع = 0;
    بينما (الصف < 3) {
        دع العمود: متغير غير_موقع = 0;
        بينما (العمود < 3) {
            دع ك: متغير غير_موقع = 0;
            دع المجموع: متغير عدد = 0;
            بينما (ك < 3) {
                دع قاعدة_يسار: غير_موقع = الصف * 3;
                دع قاعدة_يمين: غير_موقع = ك * 3;
                دع موضع_يسار: غير_موقع = قاعدة_يسار + ك;
                دع موضع_يمين: غير_موقع = قاعدة_يمين + العمود;
                المجموع := المجموع + (أ[موضع_يسار] * ب[موضع_يمين]);
                ك := ك + 1;
            }
            دع قاعدة_الناتج: غير_موقع = الصف * 3;
            دع موضع_الناتج: غير_موقع = قاعدة_الناتج + العمود;
            ج[موضع_الناتج] := المجموع;
            العمود := العمود + 1;
        }
        الصف := الصف + 1;
    }
    أرجع ج[4];
}
