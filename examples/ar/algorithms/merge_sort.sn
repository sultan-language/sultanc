// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فرز_بالدمج(القيم: متجه عدد): متجه عدد {
    إذا (الطول(القيم) <= 1) { أرجع القيم; };
    ليكن الوسط: عدد = الطول(القيم) / 2;
    ليكن الأيسر: متغير متجه عدد = [];
    ليكن الأيمن: متغير متجه عدد = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(القيم)) {
        إذا (ف < الوسط) { ألحق(الأيسر, القيم[ف]); }
        وإلا { ألحق(الأيمن, القيم[ف]); };
        ف := ف + 1;
    }
    ليكن أ: متجه عدد = فرز_بالدمج(الأيسر);
    ليكن ب: متجه عدد = فرز_بالدمج(الأيمن);
    ليكن النتيجة_القيمة: متغير متجه عدد = [];
    ليكن س: متغير عدد = 0;
    ليكن ص: متغير عدد = 0;
    طالما (س < الطول(أ) && ص < الطول(ب)) {
        إذا (أ[س] <= ب[ص]) { ألحق(النتيجة_القيمة, أ[س]); س := س + 1; }
        وإلا { ألحق(النتيجة_القيمة, ب[ص]); ص := ص + 1; };
    }
    طالما (س < الطول(أ)) { ألحق(النتيجة_القيمة, أ[س]); س := س + 1; }
    طالما (ص < الطول(ب)) { ألحق(النتيجة_القيمة, ب[ص]); ص := ص + 1; }
    أرجع النتيجة_القيمة;
}

عرف الرئيسية(): عدد {
    ليكن الأعداد: متجه عدد = [9, 2, 7, 1, 5, 3];
    ليكن المرتب: متجه عدد = فرز_بالدمج(الأعداد);
    اطبع_سطر(عدد_إلى_نص(المرتب[0] * 100 + المرتب[5]));
    أرجع 0;
}
