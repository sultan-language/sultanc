// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اجتز_الشجرة(الرسم_البياني: &متجه متجه عدد, العقدة: عدد, تمت_زيارته: &متغير متجه منطقي, الترتيب: &متغير متجه عدد): فراغ {
    إذا ((*تمت_زيارته)[العقدة]) { أرجع; };
    (*تمت_زيارته)[العقدة] := صواب;
    ألحق(*الترتيب, العقدة);
    دع ف: متغير عدد = 0;
    طالما (ف < الطول((*الرسم_البياني)[العقدة])) {
        اجتز_الشجرة(الرسم_البياني, (*الرسم_البياني)[العقدة][ف], تمت_زيارته, الترتيب);
        ف := ف + 1;
    }
}

عرف الرئيسية(): عدد {
    دع الرسم_البياني: متجه متجه عدد = [[1, 2], [3], [4], [], []];
    دع شوهد: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ];
    دع الترتيب: متغير متجه عدد = [];
    اجتز_الشجرة(&الرسم_البياني, 0, &متغير شوهد, &متغير الترتيب);
    اطبع_سطر(عدد_إلى_نص(الطول(الترتيب)));
    أرجع 0;
}
