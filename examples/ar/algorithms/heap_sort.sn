// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف أنزل_في_الكومة(القيم: &متغير متجه عدد, البداية: عدد, النهاية: عدد): فراغ {
    ليكن الجذر: متغير عدد = البداية;
    طالما (الجذر * 2 + 1 <= النهاية) {
        ليكن الفرع: متغير عدد = الجذر * 2 + 1;
        إذا (الفرع + 1 <= النهاية && (*القيم)[الفرع] < (*القيم)[الفرع + 1]) { الفرع := الفرع + 1; };
        إذا ((*القيم)[الجذر] >= (*القيم)[الفرع]) { أرجع; };
        ليكن المؤقت: عدد = (*القيم)[الجذر];
        (*القيم)[الجذر] := (*القيم)[الفرع];
        (*القيم)[الفرع] := المؤقت;
        الجذر := الفرع;
    }
}
عرف فرز_بالكومة(القيم: &متغير متجه عدد): فراغ {
    ليكن الحجم: عدد = الطول(*القيم);
    ليكن ف: متغير عدد = (الحجم / 2) - 1;
    طالما (ف >= 0) { أنزل_في_الكومة(القيم, ف, الحجم - 1); ف := ف - 1; }
    ليكن النهاية: متغير عدد = الحجم - 1;
    طالما (النهاية > 0) {
        ليكن المؤقت: عدد = (*القيم)[النهاية]; (*القيم)[النهاية] := (*القيم)[0]; (*القيم)[0] := المؤقت;
        النهاية := النهاية - 1;
        أنزل_في_الكومة(القيم, 0, النهاية);
    }
}

عرف الرئيسية(): عدد {
    ليكن الأعداد: متغير متجه عدد = [9, 2, 7, 1, 5, 3];
    فرز_بالكومة(&متغير الأعداد);
    اطبع_سطر(عدد_إلى_نص(الأعداد[0] * 100 + الأعداد[5]));
    أرجع 0;
}
