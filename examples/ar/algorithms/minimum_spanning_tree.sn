// الشجرة الممتدة الصغرى بخوارزمية بريم: تنمو الشجرة من العقدة 0 بأخذ أرخص حافة إلى عقدة
// خارجها في كل مرة، ثم تُجمع أوزان الحواف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع حافة = { أ: عدد, ب: عدد, الوزن_المؤقت: عدد };

عرف الرئيسية(): عدد {
    ليكن الحواف: متجه حافة = [{ أ: 0, ب: 1, الوزن_المؤقت: 1 }, { أ: 1, ب: 2, الوزن_المؤقت: 2 }, { أ: 0, ب: 2, الوزن_المؤقت: 5 }];
    ليكن مستخدم: متغير متجه منطقي = [صواب, خطأ, خطأ];
    ليكن المجموع: متغير عدد = 0;
    ليكن ل: متغير عدد = 0;
    طالما (ل < 2) {
        ليكن الأفضل: متغير عدد = 999;
        ليكن المختار: متغير عدد = -1;
        ليكن ف: متغير عدد = 0;
        طالما (ف < الطول(الحواف)) {
            ليكن الحافة_الحالية: حافة = الحواف[ف];
            إذا (مستخدم[الحافة_الحالية.أ] && !مستخدم[الحافة_الحالية.ب] && الحافة_الحالية.الوزن_المؤقت < الأفضل) {
                الأفضل := الحافة_الحالية.الوزن_المؤقت;
                المختار := الحافة_الحالية.ب;
            };
            ف := ف + 1;
        };
        إذا (المختار < 0) { أرجع 1; };
        مستخدم[المختار] := صواب;
        المجموع := المجموع + الأفضل;
        ل := ل + 1;
    };
    إذا (المجموع != 3) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
