// غربال إراتوستينس: كل الأعداد الأولية الأصغر من 50.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن الحد: طبيعي = 50;
    ليكن مركب: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < الحد) { ألحق(مركب, خطأ); ف := ف + 1; }
    ليكن الأوليات: متغير متجه نص = [];
    ليكن المرشح: متغير طبيعي = 2;
    طالما (المرشح < الحد) {
        إذا (!مركب[المرشح]) {
            ألحق(الأوليات, طبيعي_إلى_نص(المرشح));
            ليكن المضاعف: متغير طبيعي = المرشح * المرشح;
            طالما (المضاعف < الحد) {
                مركب[المضاعف] := صواب;
                المضاعف := المضاعف + المرشح;
            }
        };
        المرشح := المرشح + 1;
    }
    ليكن المسافة: نص = " ";
    اطبع_سطر(صل_النصوص(&الأوليات, &المسافة));
    أرجع 0;
}
