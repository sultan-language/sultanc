// أطول متتالية جزئية مشتركة بين متتاليتين، تُحسب بملء جدول برمجة ديناميكية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن أ: متجه عدد = [1, 2, 3, 4];
    ليكن ب: متجه عدد = [2, 4, 3, 4];
    ليكن العرض: عدد = الطول(ب) + 1;
    ليكن جدول_البرمجة_الديناميكية: متغير متجه عدد = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < (الطول(أ) + 1) * العرض) {
        ألحق(جدول_البرمجة_الديناميكية, 0);
        ف := ف + 1;
    };
    ف := 1;
    طالما (ف <= الطول(أ)) {
        ليكن ك: متغير عدد = 1;
        طالما (ك <= الطول(ب)) {
            إذا (أ[ف - 1] == ب[ك - 1]) {
                جدول_البرمجة_الديناميكية[ف * العرض + ك] := جدول_البرمجة_الديناميكية[(ف - 1) * العرض + ك - 1] + 1;
            } وإلا {
                ليكن س: عدد = جدول_البرمجة_الديناميكية[(ف - 1) * العرض + ك];
                ليكن ص: عدد = جدول_البرمجة_الديناميكية[ف * العرض + ك - 1];
                إذا (س > ص) { جدول_البرمجة_الديناميكية[ف * العرض + ك] := س; } وإلا { جدول_البرمجة_الديناميكية[ف * العرض + ك] := ص; };
            };
            ك := ك + 1;
        };
        ف := ف + 1;
    };
    ليكن الجواب: عدد = جدول_البرمجة_الديناميكية[الطول(أ) * العرض + الطول(ب)];
    إذا (الجواب != 3) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
