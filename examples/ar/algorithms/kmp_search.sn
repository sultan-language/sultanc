// البحث بخوارزمية كنوث-موريس-برات: إيجاد أول موضع لنمط في متتالية، مع الرجوع عند عدم
// التطابق بجدول البادئات بدل البدء من جديد.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الحزمة: متجه عدد = [1, 2, 1, 2, 1, 2, 3];
    دع الإبرة: متجه عدد = [1, 2, 3];
    دع جدول_البادئات: متجه عدد = [0, 0, 0];
    دع ك: متغير عدد = 0;
    دع موضع_المطابقة: متغير عدد = -1;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(الحزمة)) {
        طالما (ك > 0 && الحزمة[ف] != الإبرة[ك]) {
            ك := جدول_البادئات[ك - 1];
        };
        إذا (الحزمة[ف] == الإبرة[ك]) { ك := ك + 1; };
        إذا (ك == الطول(الإبرة)) {
            موضع_المطابقة := ف + 1 - ك;
            اخرج_من_حلقة;
        };
        ف := ف + 1;
    };
    إذا (موضع_المطابقة != 4) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(موضع_المطابقة));
    أرجع 0;
}
