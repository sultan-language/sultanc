// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف أقصر_مسار(الرسم_البياني: &متجه متجه عدد, الهدف: عدد): عدد {
    ليكن المسافة: متغير متجه عدد = [0, -1, -1, -1, -1];
    ليكن الطابور: متغير متجه عدد = [0];
    ليكن المقدمة: متغير عدد = 0;
    طالما (المقدمة < الطول(الطابور)) {
        ليكن العقدة: عدد = الطابور[المقدمة]; المقدمة := المقدمة + 1;
        ليكن ف: متغير عدد = 0;
        طالما (ف < الطول((*الرسم_البياني)[العقدة])) {
            ليكن الجار: عدد = (*الرسم_البياني)[العقدة][ف];
            إذا (المسافة[الجار] < 0) {
                المسافة[الجار] := المسافة[العقدة] + 1;
                ألحق(الطابور, الجار);
            };
            ف := ف + 1;
        }
    }
    أرجع المسافة[الهدف];
}

عرف الرئيسية(): عدد {
    ليكن الرسم_البياني: متجه متجه عدد = [[1, 2], [3], [3], [4], []];
    اطبع_سطر(عدد_إلى_نص(أقصر_مسار(&الرسم_البياني, 4)));
    أرجع 0;
}
