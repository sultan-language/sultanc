// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف أقصر_مسار(الرسم_البياني: &متجه متجه عدد, الهدف: عدد): عدد {
    دع المسافة: متغير متجه عدد = [0, -1, -1, -1, -1];
    دع الطابور: متغير متجه عدد = [0];
    دع المقدمة: متغير عدد = 0;
    طالما (المقدمة < الطول(الطابور)) {
        دع العقدة: عدد = الطابور[المقدمة]; المقدمة := المقدمة + 1;
        دع ف: متغير عدد = 0;
        طالما (ف < الطول((*الرسم_البياني)[العقدة])) {
            دع الجار: عدد = (*الرسم_البياني)[العقدة][ف];
            إذا (المسافة[الجار] < 0) {
                المسافة[الجار] := المسافة[العقدة] + 1;
                ألحق(الطابور, الجار);
            };
            ف := ف + 1;
        }
    }
    أرجع المسافة[الهدف];
}

عرف الرئيسية(): عدد {
    دع الرسم_البياني: متجه متجه عدد = [[1, 2], [3], [3], [4], []];
    اطبع_سطر(عدد_إلى_نص(أقصر_مسار(&الرسم_البياني, 4)));
    أرجع 0;
}
