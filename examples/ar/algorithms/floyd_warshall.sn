// أقصر المسارات بين كل زوجين من العقد بخوارزمية فلويد-وارشال، في رسم من 3 عقد مخزن
// مصفوفةً مسطحة 3×3.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن د: متغير متجه عدد = [0, 3, 100, 100, 0, 4, 2, 100, 0];
    ليكن ل: متغير عدد = 0;
    طالما (ل < 3) {
        ليكن ف: متغير عدد = 0;
        طالما (ف < 3) {
            ليكن ك: متغير عدد = 0;
            طالما (ك < 3) {
                ليكن عبر: عدد = د[ف * 3 + ل] + د[ل * 3 + ك];
                إذا (عبر < د[ف * 3 + ك]) { د[ف * 3 + ك] := عبر; };
                ك := ك + 1;
            };
            ف := ف + 1;
        };
        ل := ل + 1;
    };
    إذا (د[0 * 3 + 2] != 7) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(د[2]));
    أرجع 0;
}
