// أقصر المسافات من العقدة 0 بخوارزمية بلمان-فورد: تُرخى كل حافة في رسم من 3 عقد، إحداها
// سالبة الوزن، في مرورين.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع حافة = { المنشأ: عدد, الوجهة: عدد, الكلفة: عدد };

عرف الرئيسية(): عدد {
    دع الحواف: متجه حافة = [
        { المنشأ: 0, الوجهة: 1, الكلفة: 4 },
        { المنشأ: 0, الوجهة: 2, الكلفة: 5 },
        { المنشأ: 1, الوجهة: 2, الكلفة: -2 }
    ];
    دع المسافات: متغير متجه عدد = [0, 100, 100];
    دع الدورة: متغير عدد = 0;
    طالما (الدورة < 2) {
        دع ف: متغير عدد = 0;
        طالما (ف < الطول(الحواف)) {
            دع الحافة_الحالية: حافة = الحواف[ف];
            إذا (المسافات[الحافة_الحالية.المنشأ] + الحافة_الحالية.الكلفة < المسافات[الحافة_الحالية.الوجهة]) {
                المسافات[الحافة_الحالية.الوجهة] := المسافات[الحافة_الحالية.المنشأ] + الحافة_الحالية.الكلفة;
            };
            ف := ف + 1;
        };
        الدورة := الدورة + 1;
    };
    إذا (المسافات[2] != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المسافات[2]));
    أرجع 0;
}
