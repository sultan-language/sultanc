// مسألة حقيبة الظهر (0/1) بجدول أحادي البعد: أعلى قيمة إجمالية لأغراض تتسع لها سعة
// مقدارها 5.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الأوزان: متجه عدد = [2, 3, 4];
    دع القيم: متجه عدد = [4, 5, 6];
    دع جدول_البرمجة_الديناميكية: متغير متجه عدد = [0, 0, 0, 0, 0, 0];
    دع ف: متغير عدد = 0;
    طالما (ف < 3) {
        دع السعة: متغير عدد = 5;
        طالما (السعة >= الأوزان[ف]) {
            دع المرشح: عدد = جدول_البرمجة_الديناميكية[السعة - الأوزان[ف]] + القيم[ف];
            إذا (المرشح > جدول_البرمجة_الديناميكية[السعة]) { جدول_البرمجة_الديناميكية[السعة] := المرشح; };
            السعة := السعة - 1;
        };
        ف := ف + 1;
    };
    إذا (جدول_البرمجة_الديناميكية[5] != 9) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(جدول_البرمجة_الديناميكية[5]));
    أرجع 0;
}
