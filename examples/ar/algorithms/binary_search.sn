عرف بحث_ثنائي(القيم: متجه عدد, المطلوب: عدد): عدد {
    ليكن العدد: طبيعي = الطول(القيم) مثل طبيعي;
    ليكن الأدنى: متغير عدد = 0;
    ليكن الأعلى: متغير عدد = العدد مثل عدد;
    الأعلى := الأعلى - 1;
    طالما (الأدنى <= الأعلى) {
        ليكن المسافة: عدد = الأعلى - الأدنى;
        ليكن الوسط: عدد = الأدنى + (المسافة / 2);
        ليكن الموضع: طبيعي = الوسط مثل طبيعي;
        ليكن القيمة: عدد = القيم[الموضع];
        إذا (القيمة == المطلوب) { أرجع الوسط; };
        إذا (القيمة < المطلوب) {
            الأدنى := الوسط + 1;
        } وإلا {
            الأعلى := الوسط - 1;
        };
    }
    أرجع 0 - 1;
}

عرف حالة_بحث(المطلوب: عدد): عدد {
    ليكن القيم: متجه عدد = [2, 5, 8, 13, 21, 34, 55, 89, 144];
    أرجع بحث_ثنائي(القيم, المطلوب);
}

عرف الرئيسية(): عدد {
    أرجع حالة_بحث(55);
}
