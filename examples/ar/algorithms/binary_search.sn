عرف بحث_ثنائي(القيم: متجه عدد, المطلوب: عدد): عدد {
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع الأدنى: متغير عدد = 0;
    دع الأعلى: متغير عدد = العدد مثل عدد;
    الأعلى := الأعلى - 1;
    بينما (الأدنى <= الأعلى) {
        دع المسافة: عدد = الأعلى - الأدنى;
        دع الوسط: عدد = الأدنى + (المسافة / 2);
        دع الموضع: غير_موقع = الوسط مثل غير_موقع;
        دع القيمة: عدد = القيم[الموضع];
        لو (القيمة == المطلوب) { أرجع الوسط; };
        لو (القيمة < المطلوب) {
            الأدنى := الوسط + 1;
        } وإلا {
            الأعلى := الوسط - 1;
        };
    }
    أرجع 0 - 1;
}

عرف حالة_بحث(المطلوب: عدد): عدد {
    دع القيم: متجه عدد = [2, 5, 8, 13, 21, 34, 55, 89, 144];
    أرجع بحث_ثنائي(القيم, المطلوب);
}

عرف القلعة(): عدد {
    أرجع حالة_بحث(55);
}
