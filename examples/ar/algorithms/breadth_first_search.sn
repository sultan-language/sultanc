// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف بحث_عرضي(الرسم_البياني: &متجه متجه عدد, البداية: عدد): متجه عدد {
    ليكن تمت_زيارته: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ];
    ليكن الطابور: متغير متجه عدد = [البداية];
    ليكن الترتيب: متغير متجه عدد = [];
    تمت_زيارته[البداية] := صواب;
    ليكن المقدمة: متغير عدد = 0;
    طالما (المقدمة < الطول(الطابور)) {
        ليكن العقدة: عدد = الطابور[المقدمة]; المقدمة := المقدمة + 1;
        ألحق(الترتيب, العقدة);
        ليكن ف: متغير عدد = 0;
        طالما (ف < الطول((*الرسم_البياني)[العقدة])) {
            ليكن الجار: عدد = (*الرسم_البياني)[العقدة][ف];
            إذا (!تمت_زيارته[الجار]) { تمت_زيارته[الجار] := صواب; ألحق(الطابور, الجار); };
            ف := ف + 1;
        }
    }
    أرجع الترتيب;
}

عرف الرئيسية(): عدد {
    ليكن الرسم_البياني: متجه متجه عدد = [[1, 2], [3], [4], [], []];
    ليكن النتيجة_القيمة: متجه عدد = بحث_عرضي(&الرسم_البياني, 0);
    اطبع_سطر(عدد_إلى_نص(الطول(النتيجة_القيمة)));
    أرجع 0;
}
