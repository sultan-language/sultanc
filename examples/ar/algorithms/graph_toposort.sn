// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف ترتيب_طوبولوجي(): متجه عدد {
    دع الرسم_البياني: متجه متجه عدد = [[1, 2], [3], [3], [4], []];
    دع درجة_الدخول: متغير متجه عدد = [0, 1, 1, 2, 1];
    دع الطابور: متغير متجه عدد = [0];
    دع الترتيب: متغير متجه عدد = [];
    دع المقدمة: متغير عدد = 0;
    طالما (المقدمة < الطول(الطابور)) {
        دع العقدة: عدد = الطابور[المقدمة]; المقدمة := المقدمة + 1;
        ألحق(الترتيب, العقدة);
        دع ف: متغير عدد = 0;
        طالما (ف < الطول(الرسم_البياني[العقدة])) {
            دع الوجهة: عدد = الرسم_البياني[العقدة][ف];
            درجة_الدخول[الوجهة] := درجة_الدخول[الوجهة] - 1;
            إذا (درجة_الدخول[الوجهة] == 0) { ألحق(الطابور, الوجهة); };
            ف := ف + 1;
        }
    }
    أرجع الترتيب;
}

عرف الرئيسية(): عدد {
    دع الترتيب: متجه عدد = ترتيب_طوبولوجي();
    اطبع_سطر(عدد_إلى_نص(الطول(الترتيب)));
    أرجع 0;
}
