// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فرز_سريع(القيم: &متغير متجه عدد, الأدنى: عدد, الأعلى: عدد): فراغ {
    إذا (الأدنى >= الأعلى) { أرجع; };
    دع المحور: عدد = (*القيم)[الأعلى];
    دع ف: متغير عدد = الأدنى;
    دع ي: متغير عدد = الأدنى;
    طالما (ي < الأعلى) {
        إذا ((*القيم)[ي] <= المحور) {
            دع المؤقت: عدد = (*القيم)[ف];
            (*القيم)[ف] := (*القيم)[ي];
            (*القيم)[ي] := المؤقت;
            ف := ف + 1;
        };
        ي := ي + 1;
    }
    دع المؤقت: عدد = (*القيم)[ف];
    (*القيم)[ف] := (*القيم)[الأعلى];
    (*القيم)[الأعلى] := المؤقت;
    إذا (ف > الأدنى) { فرز_سريع(القيم, الأدنى, ف - 1); };
    فرز_سريع(القيم, ف + 1, الأعلى);
}

عرف الرئيسية(): عدد {
    دع الأعداد: متغير متجه عدد = [9, 2, 7, 1, 5, 3];
    فرز_سريع(&متغير الأعداد, 0, 5);
    اطبع_سطر(عدد_إلى_نص(الأعداد[0] * 100 + الأعداد[5]));
    أرجع 0;
}
