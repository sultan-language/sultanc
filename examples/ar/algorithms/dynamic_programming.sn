// مثال عملي على الخوارزميات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فيبوناتشي(ن: عدد): عدد {
    ليكن أ: متغير عدد = 0; ليكن ب: متغير عدد = 1;
    ليكن ف: متغير عدد = 0;
    طالما (ف < ن) { ليكن التالي: عدد = أ + ب; أ := ب; ب := التالي; ف := ف + 1; };
    أرجع أ;
}

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(فيبوناتشي(18)));
    أرجع 0;
}
