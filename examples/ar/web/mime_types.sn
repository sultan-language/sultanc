// اختيار نوع الوسائط من اسم الملف.
استورد std.io.println;
استورد std.mime.mime;

عرف الرئيسية(): عدد {
    دع الصفحة: نص = "index.html";
    دع الصورة: نص = "logo.png";
    دع المجهول: نص = "archive.unknownext";
    دع نوع_الصفحة: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&الصفحة);
    دع نوع_الصورة: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&الصورة);
    دع النوع_المجهول: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&المجهول);
    اطبع_سطر(نص_نوع_الوسائط(&نوع_الصفحة));
    اطبع_سطر(نص_نوع_الوسائط(&نوع_الصورة));
    اطبع_سطر(نص_نوع_الوسائط(&النوع_المجهول));
    أرجع 0;
}
