// اختيار نوع الوسائط من اسم الملف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.أنواع_وسائط.أنواع_وسائط;

عرف الرئيسية(): عدد {
    ليكن الصفحة: نص = "index.html";
    ليكن الصورة: نص = "logo.png";
    ليكن المجهول: نص = "archive.unknownext";
    ليكن نوع_الصفحة: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&الصفحة);
    ليكن نوع_الصورة: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&الصورة);
    ليكن النوع_المجهول: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&المجهول);
    اطبع_سطر(نص_نوع_الوسائط(&نوع_الصفحة));
    اطبع_سطر(نص_نوع_الوسائط(&نوع_الصورة));
    اطبع_سطر(نص_نوع_الوسائط(&النوع_المجهول));
    أرجع 0;
}
