// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.أنواع_وسائط.أنواع_وسائط;


عرف الرئيسية(): عدد {
    ليكن المسار: نص = "photo.png";
    ليكن الوسائط_المتعددة: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(&المسار);
    اطبع_سطر(نص_نوع_الوسائط(&الوسائط_المتعددة));
    أرجع 0;
}
