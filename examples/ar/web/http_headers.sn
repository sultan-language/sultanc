// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ويب.ترويسات;


عرف الرئيسية(): عدد {
    ليكن الاسم: نص = "Content-Type";
    ليكن القيمة: نص = "application/json";
    إذا (اسم_رأس_ويب_صالح(&الاسم) && قيمة_رأس_ويب_صالحة(&القيمة)) { اطبع_سطر("تم التحقق من الترويسة"); } وإلا { أرجع 1; };
    أرجع 0;
}
