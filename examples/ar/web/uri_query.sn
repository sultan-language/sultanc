// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عنوان_موحد.عنوان_موحد;


عرف الرئيسية(): عدد {
    ليكن الاستعلام: نص = "q=SultanC&mode=code";
    طابق حلل_استعلام_عنوان(&الاستعلام) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الأزواج) -> { اطبع_سطر(طبيعي_إلى_نص(عدد_أزواج_استعلام_عنوان(&الأزواج))); };
    أرجع 0;
}
