// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عنوان_موحد.عنوان_موحد;


عرف الرئيسية(): عدد {
    ليكن الدخل: نص = "https://example.test/users?q=sultan";
    طابق حلل_عنوانا_موحدا(&الدخل) مع
    | نتيجة.نجح(عنوان_موحد) -> { اطبع_سطر(سلسل_عنوانا_موحدا(&عنوان_موحد)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
