// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عنوان_موحد.عنوان_موحد;


عرف الرئيسية(): عدد {
    دع الدخل: نص = "مرحبا بالعالم!";
    دع المرمز: نص = رمز_نسبيا(&الدخل);
    اطبع_سطر(استنسخ(&المرمز));
    طابق فك_الترميز_النسبي(&المرمز) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المفكوك) -> { اطبع_سطر(المفكوك); };
    أرجع 0;
}
