// مثال على عناوين الويب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.عنوان_موحد.عنوان_موحد;


عرف الرئيسية(): عدد {
    دع العنوان: نص = "https://example.com/p5?q=sultan";
    طابق حلل_عنوانا_موحدا(&العنوان) مع
    | نتيجة.نجح(عنوان_موحد) -> { اطبع_سطر(سلسل_عنوانا_موحدا(&عنوان_موحد)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
