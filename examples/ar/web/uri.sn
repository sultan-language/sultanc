// تحليل عنوان موحد وقراءة استعلامه وترميز النص بالنسبة المئوية.
استورد std.io.println;
استورد std.uri.uri;

عرف الرئيسية(): عدد {
    دع العنوان: نص = "https://example.com/search?q=sultan&lang=ar";
    طابق حلل_عنوانا_موحدا(&العنوان) مع
    | نتيجة.نجح(المحلل) -> { اطبع_سطر(سلسل_عنوانا_موحدا(&المحلل)); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("عنوان غير صالح"); أرجع 1; };
    دع الاستعلام: نص = "q=sultan&lang=ar";
    طابق حلل_استعلام_عنوان(&الاستعلام) مع
    | نتيجة.نجح(الأزواج) -> {
        دع الاسم: نص = "lang";
        طابق أول_قيمة_استعلام_عنوان(&الأزواج, &الاسم) مع
        | اختياري.موجود(القيمة) -> { اطبع_سطر(القيمة); }
        | اختياري.لا_شيء -> { };
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    دع العبارة: نص = "a b&c";
    اطبع_سطر(رمز_نسبيا(&العبارة));
    أرجع 0;
}
