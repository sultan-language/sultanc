// الملكية: القيم تنتقل إلى الدوال، والمراجع تستعيرها،
// و`&متغير` يعير صلاحية الكتابة دون التخلي عن القيمة.
استورد std.io.println;
استورد std.text.number;

نوع حساب = { المالك: نص, الرصيد: عدد };

عرف افتح_حسابا(المالك: نص, أودع: عدد): حساب {
    دع الحساب: حساب = { المالك: المالك, الرصيد: أودع };
    أرجع الحساب;
}

عرف أودع(الحساب: &متغير حساب, المقدار: عدد): فراغ {
    (*الحساب).الرصيد := (*الحساب).الرصيد + المقدار;
}

عرف الرصيد(الحساب: &حساب): عدد {
    أرجع (*الحساب).الرصيد;
}

عرف أغلق(الحساب: حساب): نص {
    أرجع استنسخ(&الحساب.المالك);
}

عرف الرئيسية(): عدد {
    دع الحساب: متغير حساب = افتح_حسابا("ليلى", 100);
    أودع(&متغير الحساب, 50);
    اطبع_سطر(عدد_إلى_نص(الرصيد(&الحساب)));
    دع المالك: نص = أغلق(الحساب);
    اطبع_سطر(المالك);
    أرجع 0;
}
