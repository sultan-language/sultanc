// مثال على الملكية والاستعارة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع حساب = { الرصيد: عدد };
عرف اقرأ_الحساب(أ: &حساب): عدد { أرجع (*أ).الرصيد; }
عرف أودع(أ: &متغير حساب, الفرق: عدد): فراغ { (*أ).الرصيد := (*أ).الرصيد + الفرق; }

عرف الرئيسية(): عدد {
    دع الأصلي: متغير حساب = { الرصيد: 60 };
    أودع(&متغير الأصلي, 5);
    دع المستعار: &حساب = &الأصلي;
    اطبع_سطر(عدد_إلى_نص(اقرأ_الحساب(المستعار)));
    أرجع 0;
}
