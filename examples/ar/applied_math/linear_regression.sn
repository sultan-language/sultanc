// ميل خط المربعات الصغرى عبر أربع نقاط، من مجاميع x و y و xy و x².
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع مجاميع_س: متجه عدد = [1, 2, 3, 4];
    دع قيم_ص: متجه عدد = [3, 5, 7, 9];
    دع ن: عدد = الطول(مجاميع_س);
    دع مجموع_س: متغير عدد = 0;
    دع مجموع_ص: متغير عدد = 0;
    دع مجموع_حواصل_س_ص: متغير عدد = 0;
    دع مجموع_مربعات_س: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < ن) {
        مجموع_س := مجموع_س + مجاميع_س[ف];
        مجموع_ص := مجموع_ص + قيم_ص[ف];
        مجموع_حواصل_س_ص := مجموع_حواصل_س_ص + مجاميع_س[ف] * قيم_ص[ف];
        مجموع_مربعات_س := مجموع_مربعات_س + مجاميع_س[ف] * مجاميع_س[ف];
        ف := ف + 1;
    };
    دع الميل: عدد = (ن * مجموع_حواصل_س_ص - مجموع_س * مجموع_ص) / (ن * مجموع_مربعات_س - مجموع_س * مجموع_س);
    إذا (الميل != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الميل));
    أرجع 0;
}
