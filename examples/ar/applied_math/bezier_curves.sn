// منتصف منحنى بيزييه تربيعي: النقطة عند t = 1/2 هي (أ + 2 * نقطة_التحكم + ب) / 4، محسوبة
// بأعداد صحيحة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع نقطة = { س: عدد, ص: عدد };

عرف الرئيسية(): عدد {
    ليكن أ: نقطة = { س: 0, ص: 0 };
    ليكن التحكم: نقطة = { س: 4, ص: 8 };
    ليكن ب: نقطة = { س: 8, ص: 0 };
    ليكن نصف_س: عدد = (أ.س + 2 * التحكم.س + ب.س) / 4;
    ليكن نصف_ص: عدد = (أ.ص + 2 * التحكم.ص + ب.ص) / 4;
    إذا (نصف_س != 4 || نصف_ص != 4) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(نصف_ص));
    أرجع 0;
}
