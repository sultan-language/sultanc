// قاعدة شبه المنحرف للدالة x² على [0, 4] بخطوة واحدة، بأعداد صحيحة على صورة ضعف مجموع
// أشباه المنحرفات (44، فالمساحة التقريبية 22).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف مربع(س: عدد): عدد {
    أرجع س * س;
}

عرف الرئيسية(): عدد {
    ليكن ن: عدد = 4;
    ليكن المجموع: متغير عدد = مربع(0) + مربع(ن);
    ليكن ف: متغير عدد = 1;
    طالما (ف < ن) {
        المجموع := المجموع + 2 * مربع(ف);
        ف := ف + 1;
    };
    إذا (المجموع != 44) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
