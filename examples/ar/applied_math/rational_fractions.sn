// اختزال الكسر 6/8 إلى أبسط صورة بالقاسم المشترك الأكبر بخوارزمية إقليدس.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف قاسم_مشترك(أ: عدد, ب: عدد): عدد {
    ليكن س: متغير عدد = أ;
    ليكن ص: متغير عدد = ب;
    طالما (ص != 0) {
        ليكن ر: عدد = س % ص;
        س := ص;
        ص := ر;
    };
    أرجع س;
}

عرف الرئيسية(): عدد {
    ليكن ن: عدد = 6;
    ليكن د: عدد = 8;
    ليكن العامل_المشترك: عدد = قاسم_مشترك(ن, د);
    إذا (ن / العامل_المشترك != 3 || د / العامل_المشترك != 4) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(ن / العامل_المشترك));
    أرجع 0;
}
