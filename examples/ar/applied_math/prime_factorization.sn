// تحليل عدد إلى عوامله الأولية بالقسمة التجريبية: 84 = 2 * 2 * 3 * 7، فله أربعة عوامل أولية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن المتبقي: متغير عدد = 84;
    ليكن المعامل: متغير عدد = 2;
    ليكن العدد: متغير عدد = 0;
    طالما (المعامل * المعامل <= المتبقي) {
        طالما (المتبقي % المعامل == 0) {
            العدد := العدد + 1;
            المتبقي := المتبقي / المعامل;
        };
        المعامل := المعامل + 1;
    };
    إذا (المتبقي > 1) { العدد := العدد + 1; };
    إذا (العدد != 4) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
