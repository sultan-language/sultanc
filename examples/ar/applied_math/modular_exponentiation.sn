// الرفع إلى قوة بمعيار بالتربيع المتكرر: 5^13 mod 23 دون حساب 5^13 نفسه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف قوة_بالمعيار(الأساس: عدد, الأس: عدد, المعيار: عدد): عدد {
    ليكن الجواب: متغير عدد = 1;
    ليكن المعامل: متغير عدد = الأساس % المعيار;
    ليكن ن: متغير عدد = الأس;
    طالما (ن > 0) {
        إذا (ن % 2 == 1) { الجواب := (الجواب * المعامل) % المعيار; };
        المعامل := (المعامل * المعامل) % المعيار;
        ن := ن / 2;
    };
    أرجع الجواب;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = قوة_بالمعيار(5, 13, 23);
    إذا (الجواب != 21) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
