// الأعداد المركبة سجلا له جزء حقيقي وجزء تخيلي، وضرب عددين منها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عدد_مركب = { الحقيقي: عدد, التخيلي: عدد };

عرف اضرب(أ: عدد_مركب, ب: عدد_مركب): عدد_مركب {
    أرجع { الحقيقي: أ.الحقيقي * ب.الحقيقي - أ.التخيلي * ب.التخيلي, التخيلي: أ.الحقيقي * ب.التخيلي + أ.التخيلي * ب.الحقيقي };
}

عرف الرئيسية(): عدد {
    دع نتيجة: عدد_مركب = اضرب({ الحقيقي: 3, التخيلي: 2 }, { الحقيقي: 1, التخيلي: 4 });
    إذا (نتيجة.الحقيقي != -5 || نتيجة.التخيلي != 14) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(نتيجة.التخيلي));
    أرجع 0;
}
