// مضروب 12 (479001600)، محسوبا بالضرب في حلقة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف مضروب(ن: عدد): عدد {
    دع الناتج: متغير عدد = 1;
    دع ف: متغير عدد = 2;
    طالما (ف <= ن) {
        الناتج := الناتج * ف;
        ف := ف + 1;
    };
    أرجع الناتج;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = مضروب(12);
    إذا (الجواب != 479001600) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
