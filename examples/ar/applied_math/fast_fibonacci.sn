// أعداد فيبوناتشي بطريقة المضاعفة السريعة: نمر على بتات n من الأعلى مستعملين
// F(2k) = F(k) * (2F(k+1) - F(k)) و F(2k+1) = F(k)^2 + F(k+1)^2.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فيبوناتشي(ن: عدد): عدد {
    دع أ: متغير عدد = 0;
    دع ب: متغير عدد = 1;
    دع البت: متغير عدد = 1;
    طالما (البت <= ن) {
        البت := البت * 2;
    };
    البت := البت / 2;
    طالما (البت > 0) {
        دع ج: عدد = أ * (2 * ب - أ);
        دع د: عدد = أ * أ + ب * ب;
        إذا ((ن & البت) == 0) {
            أ := ج;
            ب := د;
        } وإلا {
            أ := د;
            ب := ج + د;
        };
        البت := البت / 2;
    };
    أرجع أ;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = فيبوناتشي(20);
    إذا (الجواب != 6765) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
