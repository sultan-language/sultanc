// اختيار مسار التنفيذ بمعامل `وقت_الترجمة`: النمط 1 يربّع القيمة، وأي نمط آخر يضيف إليها
// واحدا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اختر(وقت_الترجمة النمط: عدد, س: عدد): عدد {
    إذا (النمط == 1) { أرجع س * س; };
    أرجع س + 1;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = وقت_الترجمة اختر(1, 7);
    إذا (الجواب != 49) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
