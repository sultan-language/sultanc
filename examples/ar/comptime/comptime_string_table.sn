// الفهرسة في جدول ثابت وقت الترجمة: تقرأ `وقت_الترجمة` المدخل 3 من قائمة أعداد أولية، والجواب
// 7.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف رمز_عند(الفهرس: عدد): عدد {
    ليكن الرموز_المخزنة: متجه عدد = [2, 3, 5, 7, 11];
    أرجع الرموز_المخزنة[الفهرس];
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة رمز_عند(3);
    إذا (الجواب != 7) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
