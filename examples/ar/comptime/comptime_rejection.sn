// التحقق من قيمة وقت الترجمة: تعيد دالة المنفذ 0 لمنفذ خارج المدى 1..65535، وتعيد المنفذ
// نفسه فيما عداه، وهو هنا 8080.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف منفذ_صالح(المنفذ: عدد): عدد {
    إذا (المنفذ < 1 || المنفذ > 65535) { أرجع 0; };
    أرجع المنفذ;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = وقت_الترجمة منفذ_صالح(8080);
    إذا (الجواب != 8080) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
