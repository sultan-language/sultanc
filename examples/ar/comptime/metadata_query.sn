// مثال على الحساب وقت الترجمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع بكسل = { النتيجة_المؤقتة: ط8, الدالة_الثانية: ط8, ب: ط8 };

عرف الرئيسية(): عدد {
    ليكن العينة: بكسل = { النتيجة_المؤقتة: 1, الدالة_الثانية: 2, ب: 3 };
    اطبع_سطر(طبيعي_إلى_نص(عدد_حقول_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
