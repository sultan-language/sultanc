// حلقة تجري وقت الترجمة: تحسب `وقت_الترجمة` عدد فيبوناتشي الثاني عشر (144).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف فيبوناتشي(ن: عدد): عدد {
    دع أ: متغير عدد = 0;
    دع ب: متغير عدد = 1;
    دع ف: متغير عدد = 0;
    طالما (ف < ن) {
        دع التالي: عدد = أ + ب;
        أ := ب;
        ب := التالي;
        ف := ف + 1;
    };
    أرجع أ;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = وقت_الترجمة فيبوناتشي(12);
    إذا (الجواب != 144) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
