// جدول توجيه يُقيَّم وقت الترجمة: تنفذ `وقت_الترجمة` التطابق على الرمز وتُبقي القيمة المختارة
// وحدها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف وجه(الرمز: عدد): عدد {
    طابق الرمز مع
    | 0 -> { أرجع 11; }
    | 1 -> { أرجع 22; }
    | 2 -> { أرجع 33; }
    | _ -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة وجه(2);
    إذا (الجواب != 33) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
