// معامل `وقت_الترجمة`: تُخصص دالة التحجيم لمعامل معروف وقت الترجمة، ويُقيَّم النداء كله في
// أثناء الترجمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اضرب_بمعامل(وقت_الترجمة المعامل: عدد, س: عدد): عدد {
    أرجع س * المعامل;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة اضرب_بمعامل(9, 8);
    إذا (الجواب != 72) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
