// أثر مصفوفة 4×4 قطرها 1 و4 و9 و16، يُجمع وقت الترجمة (30).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف أثر_المصفوفة(ن: عدد): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < ن) {
        المجموع := المجموع + (ف + 1) * (ف + 1);
        ف := ف + 1;
    };
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة أثر_المصفوفة(4);
    إذا (الجواب != 30) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
