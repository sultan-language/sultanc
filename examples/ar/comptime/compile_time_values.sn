// `وقت_الترجمة` ينفذ الشيفرة أثناء الترجمة، والبرنامج يرى الناتج فقط.
استورد std.io.println;
استورد std.text.number;

عرف مجموع_المربعات(الحد: عدد): عدد {
    دع المجموع: متغير عدد = 0;
    دع ف: متغير عدد = 1;
    طالما (ف <= الحد) {
        المجموع := المجموع + ف * ف;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع حجم_الجدول: عدد = وقت_الترجمة مجموع_المربعات(10);
    دع فيبوناتشي_20: عدد = وقت_الترجمة {
        دع أ: متغير عدد = 0;
        دع ب: متغير عدد = 1;
        دع ف: متغير عدد = 0;
        طالما (ف < 20) {
            دع التالي: عدد = أ + ب;
            أ := ب;
            ب := التالي;
            ف := ف + 1;
        }
        أ
    };
    اطبع_سطر(عدد_إلى_نص(حجم_الجدول));
    اطبع_سطر(عدد_إلى_نص(فيبوناتشي_20));
    أرجع 0;
}
