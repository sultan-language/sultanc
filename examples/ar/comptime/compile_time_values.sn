// `وقت_الترجمة` ينفذ الشيفرة أثناء الترجمة، والبرنامج يرى الناتج فقط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف مجموع_المربعات(الحد: عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير عدد = 1;
    طالما (ف <= الحد) {
        المجموع := المجموع + ف * ف;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن حجم_الجدول: عدد = وقت_الترجمة مجموع_المربعات(10);
    ليكن فيبوناتشي_20: عدد = وقت_الترجمة {
        ليكن أ: متغير عدد = 0;
        ليكن ب: متغير عدد = 1;
        ليكن ف: متغير عدد = 0;
        طالما (ف < 20) {
            ليكن التالي: عدد = أ + ب;
            أ := ب;
            ب := التالي;
            ف := ف + 1;
        }
        أ
    };
    اطبع_سطر(عدد_إلى_نص(حجم_الجدول));
    اطبع_سطر(عدد_إلى_نص(فيبوناتشي_20));
    أرجع 0;
}
