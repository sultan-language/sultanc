// حجم تخطيط يُحسب وقت الترجمة: مجموع أحجام الحقول من 1 إلى 7، أي n(n + 1) / 2 (28).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف مجموع_الحقول(ن: عدد): عدد {
    أرجع ن * (ن + 1) / 2;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة مجموع_الحقول(7);
    إذا (الجواب != 28) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
