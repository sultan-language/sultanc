// فحص يجري وقت الترجمة: تستدعي `وقت_الترجمة` الدالة التي تفحص هل 64 قوة للعدد 2، فلا يحمل
// البرنامج إلا الجواب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف تحقق_قوة_اثنين(ن: عدد): عدد {
    إذا ((ن & (ن - 1)) != 0) { أرجع 0; };
    أرجع 1;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = وقت_الترجمة تحقق_قوة_اثنين(64);
    إذا (الجواب != 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
