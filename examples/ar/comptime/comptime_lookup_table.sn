// مُدخل جدول يُحسب وقت الترجمة: مجموع المربعات ‎0² + 1² + ... + 5²‎ (55).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف بحث(ن: عدد): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف <= ن) {
        المجموع := المجموع + ف * ف;
        ف := ف + 1;
    };
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = وقت_الترجمة بحث(5);
    إذا (الجواب != 55) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
