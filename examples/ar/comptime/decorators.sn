// المزخرفات تغلف دالة بدالة عادية أخرى.
استورد std.io.println;
استورد std.text.number;

عرف ضاعف(وقت_الترجمة د: دالة(عدد): عدد, القيمة: عدد): عدد {
    أرجع د(القيمة) * 2;
}

عرف زد_واحدا(وقت_الترجمة د: دالة(عدد): عدد, القيمة: عدد): عدد {
    أرجع د(القيمة) + 1;
}

@زد_واحدا
@ضاعف
عرف مربع_العدد(القيمة: عدد): عدد { أرجع القيمة * القيمة; }

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(مربع_العدد(5)));
    أرجع 0;
}
