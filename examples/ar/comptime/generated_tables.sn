// مثال على الحساب وقت الترجمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف المربعات(ن: عدد): عدد { دع ف: متغير عدد = 0; دع الناتج: متغير عدد = 0; طالما (ف < ن) { الناتج := الناتج + ف * ف; ف := ف + 1; }; أرجع الناتج; }

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(وقت_الترجمة المربعات(7)));
    أرجع 0;
}
