// كومة ثنائية مرتبة بدالة مقارنة: المهمة الأصغر أولا.
استورد std.io.println;
استورد std.text.number;
استورد std.collections.heap;

عرف حسب_الأولوية(اليسار: &عدد, اليمين: &عدد): عدد {
    أرجع *اليمين - *اليسار;
}

عرف الرئيسية(): عدد {
    دع المهام: متغير الكومة<عدد> = أنشئ_الكومة(حسب_الأولوية);
    أضف_إلى_الكومة(&متغير المهام, 5);
    أضف_إلى_الكومة(&متغير المهام, 1);
    أضف_إلى_الكومة(&متغير المهام, 9);
    أضف_إلى_الكومة(&متغير المهام, 3);
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق خذ_قمة_الكومة(&متغير المهام) مع
        | اختياري.موجود(المهمة) -> { اطبع_سطر(عدد_إلى_نص(المهمة)); }
        | اختياري.لا_شيء -> { مستمر := خطأ; };
    }
    أرجع 0;
}
