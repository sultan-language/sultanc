// مثال على المجموعات والحاويات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.مجموعات.كومة;

عرف حسب_الأولوية(الأيسر: &عدد, الأيمن: &عدد): عدد {
    أرجع *الأيمن - *الأيسر;
}

عرف الرئيسية(): عدد {
    ليكن المهام: متغير الكومة<عدد> = أنشئ_الكومة(حسب_الأولوية);
    أضف_إلى_الكومة(&متغير المهام, 5);
    أضف_إلى_الكومة(&متغير المهام, 1);
    أضف_إلى_الكومة(&متغير المهام, 9);
    أضف_إلى_الكومة(&متغير المهام, 3);
    ليكن قيد_التشغيل: متغير منطقي = صواب;
    طالما (قيد_التشغيل) {
        طابق خذ_قمة_الكومة(&متغير المهام) مع
        | اختياري.موجود(مهمة) -> { اطبع_سطر(عدد_إلى_نص(مهمة)); }
        | اختياري.لا_شيء -> { قيد_التشغيل := خطأ; };
    }
    أرجع 0;
}
