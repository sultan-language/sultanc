// الشريحة (`[] ق`) نافذة على تسلسل تأخذها الدوال وترجعها.
استورد std.io.println;
استورد std.text.number;

عرف المجموع_الكلي(القيم: [] عدد): عدد {
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        المجموع := المجموع + القيم[ف];
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع القيم: [] عدد = [10, 20, 12];
    اطبع_سطر(عدد_إلى_نص(المجموع_الكلي(القيم)));
    أرجع 0;
}
