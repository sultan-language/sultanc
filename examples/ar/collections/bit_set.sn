// مجموعة البتات تخزن رايات كثيرة بنعم أو لا في ذاكرة قليلة.
استورد std.io.println;
استورد std.text.number;
استورد std.collections.bitset;

عرف الرئيسية(): عدد {
    دع الرايات: متغير مجموعة_بتات = أنشئ_مجموعة_بتات(64);
    أضف_إلى_مجموعة_البتات(&متغير الرايات, 3);
    أضف_إلى_مجموعة_البتات(&متغير الرايات, 10);
    أضف_إلى_مجموعة_البتات(&متغير الرايات, 63);
    اطبع_سطر(طبيعي_إلى_نص(عدد_عناصر_مجموعة_البتات(&الرايات)));
    لو (تحتوي_مجموعة_البتات(&الرايات, 10)) { اطبع_سطر("البت 10 مضبوط"); };
    لو (!تحتوي_مجموعة_البتات(&الرايات, 11)) { اطبع_سطر("البت 11 غير مضبوط"); };
    أرجع 0;
}
