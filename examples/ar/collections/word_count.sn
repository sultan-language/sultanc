// عد الكلمات بخريطة تجزئة مفاتيحها نصوص.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.خريطة_نص_فهرس;

عرف الرئيسية(): عدد {
    ليكن الجملة: نص = "رأيت قطا ثم رأيت كلبا ثم رأيت عصفورا";
    ليكن الفاصل: نص = " ";
    ليكن الكلمات: متجه نص = قسم_النص(&الجملة, &الفاصل);
    ليكن التكرارات: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكلمات) مثل طبيعي)) {
        ليكن المرات: متغير طبيعي = 0;
        طابق ابحث_في_خريطة_نص_فهرس(&التكرارات, &الكلمات[ف]) مع
        | اختياري.موجود(حتى_الآن) -> { المرات := حتى_الآن; }
        | اختياري.لا_شيء -> { };
        طابق أدرج_في_خريطة_نص_فهرس(&متغير التكرارات, استنسخ(&الكلمات[ف]), المرات + 1) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    }
    ليكن الكلمة_المطلوبة: نص = "رأيت";
    طابق ابحث_في_خريطة_نص_فهرس(&التكرارات, &الكلمة_المطلوبة) مع
    | اختياري.موجود(حتى_الآن) -> { اطبع_سطر(طبيعي_إلى_نص(حتى_الآن)); }
    | اختياري.لا_شيء -> { اطبع_سطر("0"); };
    اطبع_سطر(طبيعي_إلى_نص(طول_خريطة_نص_فهرس(&التكرارات)));
    أرجع 0;
}
