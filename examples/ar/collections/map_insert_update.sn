// مثال على المجموعات والحاويات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.مجموعات.خريطة_نص_فهرس;

عرف الرئيسية(): عدد {
    ليكن الجملة: نص = "رأت القطة الكلب والطائر";
    ليكن الفاصل: نص = " ";
    ليكن الكلمات: متجه نص = قسم_النص(&الجملة, &الفاصل);
    ليكن الأعداد: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكلمات) مثل طبيعي)) {
        ليكن شوهد: متغير طبيعي = 0;
        طابق ابحث_في_خريطة_نص_فهرس(&الأعداد, &الكلمات[ف]) مع
        | اختياري.موجود(حتى_الآن) -> { شوهد := حتى_الآن; }
        | اختياري.لا_شيء -> { };
        طابق أدرج_في_خريطة_نص_فهرس(&متغير الأعداد, استنسخ(&الكلمات[ف]), شوهد + 1) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    }
    ليكن الكلمة: نص = "ال";
    طابق ابحث_في_خريطة_نص_فهرس(&الأعداد, &الكلمة) مع
    | اختياري.موجود(حتى_الآن) -> { اطبع_سطر(طبيعي_إلى_نص(حتى_الآن)); }
    | اختياري.لا_شيء -> { اطبع_سطر("0"); };
    اطبع_سطر(طبيعي_إلى_نص(طول_خريطة_نص_فهرس(&الأعداد)));
    أرجع 0;
}
