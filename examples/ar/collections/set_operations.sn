// مثال على المجموعات والحاويات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.مجموعات.مجموعة;

عرف جزئ_عدد(القيمة: &عدد): طبيعي { أرجع ((*القيمة) مثل طبيعي) * 2654435761; }
عرف عددان_متساويان(الأيسر: &عدد, الأيمن: &عدد): منطقي { أرجع *الأيسر == *الأيمن; }

عرف الرئيسية(): عدد {
    ليكن شوهد: متغير مجموعة<عدد> = أنشئ_مجموعة(جزئ_عدد, عددان_متساويان);
    ليكن القيم: متجه عدد = [4, 8, 4, 15, 8, 16, 4];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        طابق أضف_إلى_مجموعة(&متغير شوهد, القيم[ف]) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    }
    اطبع_سطر(طبيعي_إلى_نص(طول_مجموعة(&شوهد)));
    ليكن خمسة_عشر: عدد = 15;
    ليكن ثلاثة_وعشرون: عدد = 23;
    إذا (تحتوي_مجموعة(&شوهد, &خمسة_عشر)) { اطبع_سطر("يحتوي على ١٥"); };
    إذا (!تحتوي_مجموعة(&شوهد, &ثلاثة_وعشرون)) { اطبع_سطر("لا يحتوي على ٢٣"); };
    أرجع 0;
}
