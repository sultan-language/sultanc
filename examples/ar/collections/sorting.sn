// ترتيب الأعداد والنصوص ثم البحث الثنائي في المتجه المرتب.
استورد std.io.println;
استورد std.text.number;
استورد std.text.transform;
استورد std.collections.sort;

عرف الرئيسية(): عدد {
    دع الأعداد: متغير متجه عدد = [42, 7, 19, 3, 88, 1];
    رتب_عدد(&متغير الأعداد);
    دع الأسماء: متغير متجه نص = ["نور", "آدم", "زيد", "هدى"];
    رتب_نصوص(&متغير الأسماء);
    دع الفاصلة: نص = ", ";
    اطبع_سطر(صل_النصوص(&الأسماء, &الفاصلة));
    طابق بحث_ثنائي_عدد(&الأعداد, 19) مع
    | اختياري.موجود(الموضع) -> { اطبع_سطر(طبيعي_إلى_نص(الموضع)); }
    | اختياري.لا_شيء -> { اطبع_سطر("غير موجود"); };
    اطبع_سطر(عدد_إلى_نص(الأعداد[0]));
    أرجع 0;
}
