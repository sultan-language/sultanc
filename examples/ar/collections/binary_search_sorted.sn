// مثال على المجموعات والحاويات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اجمع_الزوجي(القيم: &متجه عدد): عدد { ليكن المجموع: متغير عدد = 0; ليكن ف: متغير عدد = 0; طالما (ف < الطول(*القيم)) { إذا ((*القيم)[ف] % 2 == 0) { المجموع := المجموع + (*القيم)[ف]; }; ف := ف + 1; }; أرجع المجموع; }

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(اجمع_الزوجي(&[10, 2, 4, 7, 10])));
    أرجع 0;
}
