// ترتيب المزخرفات: مع @زد_واحدا فوق @ضاعف_المحصلة يكون حساب 5 هو (5 + 2) * 2 + 1 = 15، لا
// (5 + 2 + 1) * 2.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف زد_واحدا(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) + 1;
}

عرف ضاعف_المحصلة(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) * 2;
}

@زد_واحدا
@ضاعف_المحصلة
عرف احسب(س: عدد): عدد {
    أرجع س + 2;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = احسب(5);
    إذا (الجواب != 15) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
