// مزخرف على دالة تستدعي دالة عامة: يلف @زد_واحدا دالة تستعمل هوية<عدد>.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف هوية<نوع_العنصر>(س: نوع_العنصر): نوع_العنصر {
    أرجع س;
}

عرف زد_واحدا(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) + 1;
}

@زد_واحدا
عرف ملموس(س: عدد): عدد {
    أرجع هوية<عدد>(س) * 2;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = ملموس(5);
    إذا (الجواب != 11) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
