// دالة مزخرفة تُستعمل رد نداء: يضاعف @مرتين نتيجة دالة النقاط، وتُمرر الدالة المزخرفة قيمةً
// إلى دالة التطبيق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف مرتين(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) * 2;
}

@مرتين
عرف النقاط(س: عدد): عدد {
    أرجع س + 3;
}

عرف طبق(تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س);
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = طبق(النقاط, 4);
    إذا (الجواب != 14) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
