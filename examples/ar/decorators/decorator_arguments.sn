// مزخرف وقت التعريف له وسيط: يضيف @@سجل("/argument") المعالج إلى جدول المسارات عند تعريفه،
// ثم تستدعيه الرئيسية عبر ذلك الجدول.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع مدخلة = { المسار: نص, المعالج: دالة(عدد): عدد };

ليكن المسارات: متغير متجه مدخلة = [];

عرف سجل(المسار: نص, المعالج: دالة(عدد): عدد): فراغ {
    غير_آمن { ألحق(المسارات, { المسار: المسار, المعالج: المعالج }); }
}

@@سجل("/argument")
عرف المعالج(س: عدد): عدد {
    أرجع س + 2;
}

عرف الرئيسية(): عدد {
    ليكن العدد: طبيعي;
    ليكن المخرج: عدد;
    غير_آمن {
        العدد := الطول(المسارات) مثل طبيعي;
        المخرج := المسارات[0].المعالج(10);
    }
    إذا (العدد != 1 || المخرج != 12) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المخرج));
    أرجع 0;
}
