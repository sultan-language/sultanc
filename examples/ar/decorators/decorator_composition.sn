// تكديس مزخرفين: يعطي @زد_واحدا @ضاعف_المحصلة على دالة الحساب (x + 4) * 2 + 1، فالمزخرف
// المكتوب أولا يُطبق آخرا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف زد_واحدا(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) + 1;
}

عرف ضاعف_المحصلة(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    أرجع تابع(س) * 2;
}

@زد_واحدا
@ضاعف_المحصلة
عرف احسب(س: عدد): عدد {
    أرجع س + 4;
}

عرف الرئيسية(): عدد {
    ليكن الجواب: عدد = احسب(5);
    إذا (الجواب != 19) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
