// مزخرف يحمي من المدخلات الخاطئة: يعيد @متحقق_منه 0 للوسيط السالب بدل أن يستدعي الدالة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف متحقق_منه(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    إذا (س < 0) { أرجع 0; };
    أرجع تابع(س);
}

@متحقق_منه
عرف مربع_موجب(س: عدد): عدد {
    أرجع س * س;
}

عرف الرئيسية(): عدد {
    ليكن أ: عدد = مربع_موجب(-5);
    ليكن ب: عدد = مربع_موجب(3);
    إذا (أ != 0 || ب != 9) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(ب));
    أرجع 0;
}
