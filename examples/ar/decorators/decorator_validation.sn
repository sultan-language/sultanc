// مزخرف للتحقق: يجعل @قيد_الموجب نتيجة المدخل السالب 0، فيكون مجموع الحساب للعددين -4
// و3 هو 9.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف قيد_الموجب(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    إذا (س < 0) { أرجع 0; };
    أرجع تابع(س);
}

@قيد_الموجب
عرف احسب(س: عدد): عدد {
    أرجع س * 3;
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = احسب(-4) + احسب(3);
    إذا (الجواب != 9) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
