// تسجيل بيانات وصفية بمزخرف وقت التعريف: يخزن @@سجل("/metadata") مسارا بجانب المعالج في
// جدول المسارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع مدخلة = { المسار: نص, المعالج: دالة(عدد): عدد };

دع المسارات: متغير متجه مدخلة = [];

عرف سجل(المسار: نص, المعالج: دالة(عدد): عدد): فراغ {
    غير_آمن { ألحق(المسارات, { المسار: المسار, المعالج: المعالج }); }
}

@@سجل("/metadata")
عرف المعالج(س: عدد): عدد {
    أرجع س + 10;
}

عرف الرئيسية(): عدد {
    دع العدد: طبيعي;
    دع المخرج: عدد;
    غير_آمن {
        العدد := الطول(المسارات) مثل طبيعي;
        المخرج := المسارات[0].المعالج(10);
    }
    إذا (العدد != 1 || المخرج != 20) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المخرج));
    أرجع 0;
}
