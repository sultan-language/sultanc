// مزخرف على دالة تستدعي نفسها: يحمي @غير_سالب دالة المضروب.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف غير_سالب(وقت_الترجمة تابع: دالة(عدد): عدد, س: عدد): عدد {
    إذا (س < 0) { أرجع 0; };
    أرجع تابع(س);
}

@غير_سالب
عرف مضروب(س: عدد): عدد {
    إذا (س <= 1) { أرجع 1; };
    أرجع س * مضروب(س - 1);
}

عرف الرئيسية(): عدد {
    دع الجواب: عدد = مضروب(5);
    إذا (الجواب != 120) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
