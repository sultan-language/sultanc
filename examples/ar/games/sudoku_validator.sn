// التحقق من صف سودوكو: يجب أن يظهر كل رقم من 1 إلى 9 مرة واحدة بالضبط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الصف: متجه عدد = [5, 3, 4, 6, 7, 8, 9, 1, 2];
    دع المشاهدة: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ];
    دع ف: متغير عدد = 0;
    طالما (ف < 9) {
        دع ق: عدد = الصف[ف];
        إذا (ق < 1 || ق > 9 || المشاهدة[ق]) { أرجع 1; };
        المشاهدة[ق] := صواب;
        ف := ف + 1;
    };
    اطبع_سطر("صف صالح");
    أرجع 0;
}
