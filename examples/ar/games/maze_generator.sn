// توليد إطار متاهة 5×5: جدران (1) على الحواف كلها، وخانات مفتوحة (0) في الداخل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن العرض: عدد = 5;
    ليكن الارتفاع: عدد = 5;
    ليكن المتاهة: متغير متجه عدد = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < العرض * الارتفاع) {
        إذا (ف % العرض == 0 || ف % العرض == العرض - 1 || ف < العرض || ف >= (الارتفاع - 1) * العرض) {
            ألحق(المتاهة, 1);
        } وإلا {
            ألحق(المتاهة, 0);
        };
        ف := ف + 1;
    };
    إذا (المتاهة[0] != 1 || المتاهة[12] != 0) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الطول(المتاهة)));
    أرجع 0;
}
