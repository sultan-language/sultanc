// خطوة واحدة من آلة خلوية أحادية البعد (القاعدة 90): كل خلية جديدة هي XOR لجارتيها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الخلايا: متجه عدد = [0, 0, 1, 0, 0, 0, 0];
    دع التالي: متغير متجه عدد = [0, 0, 0, 0, 0, 0, 0];
    دع ف: متغير عدد = 1;
    طالما (ف < 6) {
        التالي[ف] := الخلايا[ف - 1] ^ الخلايا[ف + 1];
        ف := ف + 1;
    };
    إذا (التالي[1] != 1 || التالي[3] != 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(التالي[1] + التالي[3]));
    أرجع 0;
}
