// التحقق من حل لمسألة الملكات الأربع: لا تشترك ملكتان في صف أو قطر.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف آمنة(مواضع: &متجه عدد, العمود: عدد, الصف: عدد): منطقي {
    دع ج: متغير عدد = 0;
    طالما (ج < العمود) {
        دع ر: عدد = (*مواضع)[ج];
        إذا (ر == الصف || ر - ج == الصف - العمود || ر + ج == الصف + العمود) { أرجع خطأ; };
        ج := ج + 1;
    };
    أرجع صواب;
}

عرف الرئيسية(): عدد {
    دع الصفوف: متجه عدد = [1, 3, 0, 2];
    دع ف: متغير عدد = 0;
    طالما (ف < 4) {
        إذا (!آمنة(&الصفوف, ف, الصفوف[ف])) { أرجع 1; };
        ف := ف + 1;
    };
    اطبع_سطر("تم حل مسألة الملكات الأربع");
    أرجع 0;
}
