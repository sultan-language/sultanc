// حل صف واحد من سودوكو: تُعلَّم الأرقام الموجودة، وتُملأ الخانة الفارغة بالرقم الناقص.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع الصف: متغير متجه عدد = [5, 3, 4, 6, 7, 8, 9, 0, 2];
    دع المشاهدة: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ];
    دع ف: متغير عدد = 0;
    طالما (ف < 9) {
        المشاهدة[الصف[ف]] := صواب;
        ف := ف + 1;
    };
    دع مفقود: متغير عدد = 0;
    ف := 1;
    طالما (ف <= 9) {
        إذا (!المشاهدة[ف]) { مفقود := ف; };
        ف := ف + 1;
    };
    الصف[7] := مفقود;
    إذا (مفقود != 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الصف[7]));
    أرجع 0;
}
