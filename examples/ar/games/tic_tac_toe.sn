// إيجاد الفائز في لعبة إكس-أو: تُفحص خطوط الفوز الثمانية على اللوحة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الفائز(اللوحة: متجه عدد): عدد {
    دع الانتصارات: متجه عدد = [0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 3, 6, 1, 4, 7, 2, 5, 8, 0, 4, 8, 2, 4, 6];
    دع ف: متغير عدد = 0;
    طالما (ف < 24) {
        دع أ: عدد = اللوحة[الانتصارات[ف]];
        إذا (أ != 0 && أ == اللوحة[الانتصارات[ف + 1]] && أ == اللوحة[الانتصارات[ف + 2]]) { أرجع أ; };
        ف := ف + 3;
    };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    دع اللوحة: متجه عدد = [1, 1, 1, 0, 2, 0, 2, 0, 0];
    دع الوزن_المؤقت: عدد = الفائز(اللوحة);
    إذا (الوزن_المؤقت != 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الوزن_المؤقت));
    أرجع 0;
}
