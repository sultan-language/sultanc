// حل متاهة 3×3 في مرور واحد: مع الحركة يمينا أو أسفل فقط، تأخذ كل خانة مفتوحة أقصر مسافة
// من جارتها اليسرى أو العليا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع المتاهة: متجه عدد = [0, 1, 0, 0, 0, 0, 1, 0, 0];
    دع المسافات: متغير متجه عدد = [0, 99, 99, 99, 99, 99, 99, 99, 99];
    دع ف: متغير عدد = 0;
    طالما (ف < 9) {
        إذا (المتاهة[ف] == 0 && ف > 0) {
            إذا (ف % 3 != 0 && المسافات[ف - 1] + 1 < المسافات[ف]) { المسافات[ف] := المسافات[ف - 1] + 1; };
            إذا (ف >= 3 && المسافات[ف - 3] + 1 < المسافات[ف]) { المسافات[ف] := المسافات[ف - 3] + 1; };
        };
        ف := ف + 1;
    };
    إذا (المسافات[8] != 4) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المسافات[8]));
    أرجع 0;
}
