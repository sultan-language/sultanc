// مثال على توليد الأعداد العشوائية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.عشوائي.مولد;


عرف الرئيسية(): عدد {
    ليكن المولد: متغير مولد_عشوائي = أنشئ_مولد_عشوائي(2028);
    طابق عشوائي_بين(&متغير المولد, 1, 7) مع
    | اختياري.موجود(ن) -> { اطبع_سطر(طبيعي_إلى_نص(ن)); }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
