// مولد شبه عشوائي ببذرة: البذرة نفسها تعطي التسلسل نفسه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.عشوائي.مولد;
استورد المكتبة.نصوص.مقارنة;

عرف ارم_النرد(البذرة: طبيعي, العدد: طبيعي): نص {
    ليكن المولد: متغير مولد_عشوائي = أنشئ_مولد_عشوائي(البذرة);
    ليكن الرميات: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق عشوائي_بين(&متغير المولد, 1, 7) مع
        | اختياري.موجود(الوجه) -> { ألحق(الرميات, طبيعي_إلى_نص(الوجه)); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    ليكن المسافة: نص = " ";
    أرجع صل_النصوص(&الرميات, &المسافة);
}

عرف الرئيسية(): عدد {
    ليكن الأول: نص = ارم_النرد(2026, 8);
    ليكن مرة_أخرى: نص = ارم_النرد(2026, 8);
    اطبع_سطر(استنسخ(&الأول));
    إذا (نصان_متساويان(&الأول, &مرة_أخرى)) { اطبع_سطر("البذرة نفسها تعطي الرميات نفسها"); };
    أرجع 0;
}
