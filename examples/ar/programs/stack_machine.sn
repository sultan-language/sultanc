// آلة مكدس صغيرة: البرنامج متجه من التعليمات (نوع جبري)،
// تُنفذ بـ`طابق` واحد في كل خطوة.
استورد std.io.println;
استورد std.text.number;

نوع تعليمة =
    | ادفع بنوع عدد
    | اجمع
    | اضرب
    | اطبع_القمة
;

عرف شغل(البرنامج: &متجه تعليمة): عدد {
    دع المكدس: متغير متجه عدد = [];
    دع عداد_التعليمات: متغير طبيعي = 0;
    طالما (عداد_التعليمات < (الطول(*البرنامج) مثل طبيعي)) {
        طابق (*البرنامج)[عداد_التعليمات] مع
        | تعليمة.ادفع(القيمة) -> { ألحق(المكدس, القيمة); }
        | تعليمة.اجمع -> {
            دع القمة: طبيعي = (الطول(المكدس) مثل طبيعي) - 1;
            المكدس[القمة - 1] := المكدس[القمة - 1] + المكدس[القمة];
            احذف_الأخير(&متغير المكدس);
        }
        | تعليمة.اضرب -> {
            دع القمة: طبيعي = (الطول(المكدس) مثل طبيعي) - 1;
            المكدس[القمة - 1] := المكدس[القمة - 1] * المكدس[القمة];
            احذف_الأخير(&متغير المكدس);
        }
        | تعليمة.اطبع_القمة -> {
            اطبع_سطر(عدد_إلى_نص(المكدس[(الطول(المكدس) مثل طبيعي) - 1]));
        };
        عداد_التعليمات := عداد_التعليمات + 1;
    }
    أرجع المكدس[0];
}

عرف احذف_الأخير(المكدس: &متغير متجه عدد): فراغ {
    دع المحفوظ: متغير متجه عدد = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < (الطول(*المكدس) مثل طبيعي)) {
        ألحق(المحفوظ, (*المكدس)[ف]);
        ف := ف + 1;
    }
    *المكدس := المحفوظ;
}

عرف الرئيسية(): عدد {
    // (2 + 3) * 7 + 7
    دع البرنامج: متجه تعليمة = [
        تعليمة.ادفع(2), تعليمة.ادفع(3), تعليمة.اجمع(), تعليمة.اطبع_القمة(),
        تعليمة.ادفع(7), تعليمة.اضرب(), تعليمة.اطبع_القمة(),
        تعليمة.ادفع(7), تعليمة.اجمع(), تعليمة.اطبع_القمة()
    ];
    دع القيمة_النهائية: عدد = شغل(&البرنامج);
    اطبع_سطر(عدد_إلى_نص(القيمة_النهائية));
    أرجع 0;
}
