// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;


عرف الرئيسية(): عدد {
    دع المطلوب: نص = "port=8080;enabled=true";
    دع البادئة: نص = "port=";
    دع مفعل: نص = "enabled=true";
    إذا (يبدأ_بـ(&المطلوب,&البادئة) && يحتوي_نصا(&المطلوب,&مفعل)) { اطبع_سطر("الإعدادات صالحة"); } وإلا { أرجع 1; };
    أرجع 0;
}
