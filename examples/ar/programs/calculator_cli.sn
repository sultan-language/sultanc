// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف احسب(أ: عدد, ب: عدد, العملية: عدد): عدد {
 إذا (العملية == 0) { أرجع أ + ب; };
 إذا (العملية == 1) { أرجع أ * ب; };
 إذا (العملية == 2) { أرجع أ - ب; };
 أرجع 0;
}
عرف الرئيسية(): عدد {
    ليكن الإجراء: عدد = 1;
    ليكن القيمة: عدد = احسب(12, 7, الإجراء);
    اطبع_سطر(عدد_إلى_نص(القيمة));
    أرجع 0;
}
