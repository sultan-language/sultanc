// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.بحث;


عرف الرئيسية(): عدد {
    دع النص: نص = "واحد اثنان ثلاثة. أربعة!";
    دع الكلمات: متجه نص = قسم_بالفراغات(&النص);
    اطبع_سطر(طبيعي_إلى_نص(الطول(الكلمات) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(عدد_محارف_النص(&النص)));
    أرجع 0;
}
