// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.نصوص.من_بايتات;


عرف الرئيسية(): عدد {
    دع الرسالة: متجه ط8 = بايتات_من_نص("محتوى لحساب البصمة");
    دع البصمة: متجه ط8 = شا256(&الرسالة);
    اطبع_سطر(رمز_سداسي(&البصمة));
    أرجع 0;
}
