// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;


عرف الرئيسية(): عدد {
    ليكن نص_القالب: نص = "مرحباً، {{الاسم}}!";
    ليكن العلامة: نص = "{{الاسم}}";
    ليكن البديل: نص = "SultanC";
    ليكن الناتج: نص = استبدل_في_النص(&نص_القالب, &العلامة, &البديل);
    اطبع_سطر(الناتج);
    أرجع 0;
}
