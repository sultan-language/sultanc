// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;


عرف الرئيسية(): عدد {
    دع نص_القالب: نص = "مرحباً، {{الاسم}}!";
    دع العلامة: نص = "{{الاسم}}";
    دع البديل: نص = "SultanC";
    دع الناتج: نص = استبدل_في_النص(&نص_القالب, &العلامة, &البديل);
    اطبع_سطر(الناتج);
    أرجع 0;
}
