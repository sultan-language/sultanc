// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;


عرف الرئيسية(): عدد {
    دع المهام: متغير متجه نص = [];
    ألحق(المهام, "اكتب أمثلة");
    ألحق(المهام, "ترجم اللغتين");
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المهام)) { اطبع_سطر(استنسخ(&المهام[ف])); ف := ف + 1; };
    اطبع_سطر(طبيعي_إلى_نص(الطول(المهام) مثل طبيعي));
    أرجع 0;
}
