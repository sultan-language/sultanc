// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.جسون.تحليل;
استورد المكتبة.جسون.إلى_نص;


عرف الرئيسية(): عدد {
    دع الدخل: نص = "{\"صالح\":true,\"العدد\":3}";
    طابق حلل_جسون(&الدخل) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المستند_المقروء) -> {
        طابق جسون_إلى_نص(&المستند_المقروء) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(النص) -> { اطبع_سطر(النص); };
    };
    أرجع 0;
}
