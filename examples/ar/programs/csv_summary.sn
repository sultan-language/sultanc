// مثال على بناء برنامج كامل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.سي_اس_في.سي_اس_في;


عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "name,score\nNoor,8\nAdam,10\n";
    طابق حلل_سي_اس_في(&المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المستند_المقروء) -> { اطبع_سطر(طبيعي_إلى_نص(عدد_سجلات_سي_اس_في(&المستند_المقروء))); };
    أرجع 0;
}
