// مثال على هياكل البيانات والأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع حدث = | فارغ | تعداد بنوع عدد;

عرف الرئيسية(): عدد {
    ليكن الحدث: حدث = حدث.تعداد(5);
    طابق الحدث مع
    | حدث.فارغ -> { اطبع_سطر("فارغ"); }
    | حدث.تعداد(ن) -> { اطبع_سطر(عدد_إلى_نص(ن)); };
    أرجع 0;
}
