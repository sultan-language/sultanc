// مثال على هياكل البيانات والأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع نقطة = { س: عدد, ص: عدد };
نوع صندوق_ثنائي = { البداية: نقطة, النهاية: نقطة };

عرف الرئيسية(): عدد {
    ليكن البداية: نقطة = { س: 4, ص: 2 };
    ليكن النهاية: نقطة = { س: 10, ص: 8 };
    ليكن المستطيل: صندوق_ثنائي = { البداية: البداية, النهاية: النهاية };
    اطبع_سطر(عدد_إلى_نص(المستطيل.النهاية.س - المستطيل.البداية.س));
    أرجع 0;
}
