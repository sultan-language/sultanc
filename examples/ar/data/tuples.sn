// الصفوف تجمع قيما دون تسمية سجل، و`طابق` يفككها.
استورد std.io.println;
استورد std.text.number;

عرف المساحة(الحجم: (عدد, عدد)): عدد {
    طابق الحجم مع
    | (العرض, الارتفاع) -> { أرجع العرض * الارتفاع; };
}

عرف الرئيسية(): عدد {
    دع النقطة: (عدد, عدد) = (3, 4);
    طابق النقطة مع
    | (س, ص) -> { اطبع_سطر(عدد_إلى_نص(س * س + ص * ص)); };
    دع الحجم: (عدد, عدد) = (6, 7);
    اطبع_سطر(عدد_إلى_نص(المساحة(الحجم)));
    دع الموسوم: (نص, منطقي) = ("جاهز", صواب);
    طابق الموسوم مع
    | (التسمية, العلم) -> { لو (العلم) { اطبع_سطر(التسمية); }; };
    أرجع 0;
}
