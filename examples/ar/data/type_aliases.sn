// `نوع` يعطي نوعا موجودا اسما جديدا، و`مرادف` يعطي دالة اسما جديدا.
استورد std.io.println;
استورد std.text.number;

نوع درجة_مئوية = عدد;
نوع شبكة = متجه متجه عدد;

عرف اجمع_عددين(اليسار: عدد, اليمين: عدد): عدد { أرجع اليسار + اليمين; }
مرادف زائد = اجمع_عددين;

عرف الرئيسية(): عدد {
    دع التجمد: درجة_مئوية = 0;
    دع الغليان: درجة_مئوية = 100;
    اطبع_سطر(عدد_إلى_نص(زائد(التجمد, الغليان)));
    دع الصف: متجه عدد = [1, 2, 3];
    دع الشبكة: شبكة = [الصف];
    اطبع_سطر(عدد_إلى_نص(الشبكة[0][2]));
    أرجع 0;
}
