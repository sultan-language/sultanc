نوع نقطة = { س: عدد, ص: عدد };
نوع مستطيل = { البداية: نقطة, النهاية: نقطة };

عرف القلعة(): عدد {
    دع البداية: نقطة = { س: 10, ص: 11 };
    دع النهاية: نقطة = { س: 12, ص: 9 };
    دع المستطيل: مستطيل = { البداية: البداية, النهاية: النهاية };
    أرجع المستطيل.البداية.س + المستطيل.البداية.ص + المستطيل.النهاية.س + المستطيل.النهاية.ص;
}
