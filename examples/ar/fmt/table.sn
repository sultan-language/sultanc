// جدول بأسماء عربية: تقيس المكتبة.تنسيق العرض بالمحارف كما يراها القارئ
// (عناقيد المحارف)، فالحرف مع حركاته يعد مرة واحدة وتصطف الأعمدة. ويعاد
// استعمال منسق واحد لكل الصفوف.
استورد المكتبة.تنسيق.تنسيق;
استورد المكتبة.دخ.اطبع;

عرف الرئيسية(): عدد {
    ليكن الأسماء: متجه نص = [«مُحَمَّد», «فَاطِمَة», «عَلِيّ», «سارة»];
    ليكن الدرجات: متجه ع64 = [91.5, 88.25, 79.0, 95.125];
    ليكن العنوان: نص = «الاسم»;
    ليكن الرأس_الثاني: نص = «الدرجة»;
    ليكن فارغ: نص = «»;
    ليكن السطر: متغير منسق = أنشئ_منسقا();
    ليكن ر: نتيجة طبيعي, خطأ_تنسيق = نسق_في(&متغير السطر, "{:<10}|{:>7}\n{2:-<10}+{2:->7}\n", [قيمة_تنسيق.نص(&العنوان), قيمة_تنسيق.نص(&الرأس_الثاني), قيمة_تنسيق.نص(&فارغ)]);
    ليكن المجموع: متغير ع64 = 0.0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسماء) مثل طبيعي)) {
        ليكن ك: نتيجة طبيعي, خطأ_تنسيق = نسق_في(&متغير السطر, "{:<10}|{:>7.2}\n", [قيمة_تنسيق.نص(&الأسماء[ف]), قيمة_تنسيق.ع64(الدرجات[ف])]);
        المجموع := المجموع + الدرجات[ف];
        ف := ف + 1;
    }
    ليكن التسمية: نص = «المتوسط»;
    ليكن ذ: نتيجة طبيعي, خطأ_تنسيق = نسق_في(&متغير السطر, "{:<10}|{:>7.3}\n", [قيمة_تنسيق.نص(&التسمية), قيمة_تنسيق.ع64(المجموع / 4.0)]);
    ليكن المطبوع: نتيجة عدد, عدد = اطبع(خذ_نص_المنسق(&متغير السطر));
    أرجع 0;
}
