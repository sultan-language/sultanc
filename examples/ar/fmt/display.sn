// العرض والتصحيح لأنواعك: قيمة_تنسيق مخصصة تحمل دالة مغلقة تكتب في المنسق
// (impl Display وimpl Debug في Rust). وتستطيع قراءة مواصفة الموضع، واحترام
// العرض بـ احش_نصا، وكتابة صيغة التصحيح المنسقة لـ {:#?}. والدوال المغلقة
// تلتقط القيم البسيطة (الأعداد والمنطقيات والتعدادات والسجلات منها).
استورد المكتبة.تنسيق.fmt;

نوع عملة = | ريال | دولار;
نوع مبلغ = { الهللات: عدد, العملة: عملة };

عرف اعرض_مبلغا(م: &مبلغ, ن: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    دع الرمز: متغير نص = «ر.س»;
    طابق (*م).العملة مع
    | عملة.دولار -> { الرمز := «دولار»; }
    | عملة.ريال -> { };
    لو (المنسق_للتصحيح(ن)) {
        لو (المنسق_بديل(ن)) {
            أرجع نسق_في(ن, "مبلغ {{\n    الهللات: {},\n    العملة: {},\n}}", [قيمة_تنسيق.عدد((*م).الهللات), قيمة_تنسيق.نص(&الرمز)]);
        };
        أرجع نسق_في(ن, «مبلغ {{ الهللات: {}, العملة: {} }}», [قيمة_تنسيق.عدد((*م).الهللات), قيمة_تنسيق.نص(&الرمز)]);
    };
    // العرض: ينسق المبلغ ثم يحشى إلى العرض المطلوب.
    طابق نسق(«{}.{:02} {}», [قيمة_تنسيق.عدد((*م).الهللات / 100), قيمة_تنسيق.عدد((*م).الهللات % 100), قيمة_تنسيق.نص(&الرمز)]) مع
    | نتيجة.نجح(النص) -> { أرجع احش_نصا(ن, &النص); }
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); };
}

عرف مبلغا(م: مبلغ): قيمة_تنسيق {
    أرجع قيمة_تنسيق.مخصص(دالة(ن: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_مبلغا(&م, ن));
}

عرف الرئيسية(): عدد {
    دع السعر: مبلغ = { الهللات: 1250, العملة: عملة.ريال() };
    دع الإكرامية: مبلغ = { الهللات: 305, العملة: عملة.دولار() };
    دع ر1: نتيجة طبيعي, خطأ_تنسيق = اطبع_سطرا_منسقا(«السعر: {}», [مبلغا(السعر)]);
    دع ر2: نتيجة طبيعي, خطأ_تنسيق = اطبع_سطرا_منسقا(«[{0:>12}] [{0:<12}]», [مبلغا(السعر)]);
    دع ر3: نتيجة طبيعي, خطأ_تنسيق = اطبع_سطرا_منسقا(«{:?}», [مبلغا(السعر)]);
    دع كلاهما: متجه قيمة_تنسيق = [مبلغا(السعر), مبلغا(الإكرامية)];
    دع ر4: نتيجة طبيعي, خطأ_تنسيق = اطبع_سطرا_منسقا(«{:#?}», [قيمة_تنسيق.قائمة(&كلاهما)]);
    أرجع 0;
}
