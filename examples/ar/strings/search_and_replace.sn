// البحث في النص وتقسيمه ووصله وقصه والاستبدال فيه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن الخام: نص = "   أحمر,أخضر,أزرق   ";
    ليكن النظيف: نص = قص_النص(&الخام);
    ليكن الفاصلة: نص = ",";
    ليكن الأجزاء: متجه نص = قسم_النص(&النظيف, &الفاصلة);
    اطبع_سطر(طبيعي_إلى_نص(الطول(الأجزاء) مثل طبيعي));
    ليكن الشرطة_المائلة: نص = " / ";
    اطبع_سطر(صل_النصوص(&الأجزاء, &الشرطة_المائلة));
    ليكن الأخضر: نص = "أخضر";
    إذا (يحتوي_نصا(&النظيف, &الأخضر)) { اطبع_سطر("وُجد الأخضر"); };
    طابق ابحث_نصا(&النظيف, &الأخضر) مع
    | اختياري.موجود(الموضع) -> { اطبع_سطر(طبيعي_إلى_نص(الموضع)); }
    | اختياري.لا_شيء -> { اطبع_سطر("غير موجود"); };
    ليكن الأزرق: نص = "أزرق";
    ليكن الكحلي: نص = "كحلي";
    اطبع_سطر(استبدل_في_النص(&النظيف, &الأزرق, &الكحلي));
    أرجع 0;
}
