// البحث في النص وتقسيمه ووصله وقصه والاستبدال فيه.
استورد std.io.println;
استورد std.text.number;
استورد std.text.search;
استورد std.text.transform;

عرف الرئيسية(): عدد {
    دع الخام: نص = "   أحمر,أخضر,أزرق   ";
    دع النظيف: نص = قص_النص(&الخام);
    دع الفاصلة: نص = ",";
    دع الأجزاء: متجه نص = قسم_النص(&النظيف, &الفاصلة);
    اطبع_سطر(طبيعي_إلى_نص(الطول(الأجزاء) مثل طبيعي));
    دع الشرطة_المائلة: نص = " / ";
    اطبع_سطر(صل_النصوص(&الأجزاء, &الشرطة_المائلة));
    دع الأخضر: نص = "أخضر";
    لو (يحتوي_نصا(&النظيف, &الأخضر)) { اطبع_سطر("وُجد الأخضر"); };
    طابق ابحث_نصا(&النظيف, &الأخضر) مع
    | اختياري.موجود(الموضع) -> { اطبع_سطر(طبيعي_إلى_نص(الموضع)); }
    | اختياري.لا_شيء -> { اطبع_سطر("غير موجود"); };
    دع الأزرق: نص = "أزرق";
    دع الكحلي: نص = "كحلي";
    اطبع_سطر(استبدل_في_النص(&النظيف, &الأزرق, &الكحلي));
    أرجع 0;
}
