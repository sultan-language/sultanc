// مثال على التعامل مع النصوص.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    دع النص_اللاتيني: نص = "salam";
    دع النص_العربي: نص = "سلام";
    اطبع_سطر(طبيعي_إلى_نص(الطول(النص_اللاتيني) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(الطول(النص_العربي) مثل طبيعي));
    اطبع_سطر(النص_العربي);
    دع الحرف: حرف = 'س';
    اطبع_سطر(طبيعي_إلى_نص(الحرف مثل طبيعي));
    أرجع 0;
}
