// مثال على التعامل مع النصوص.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.تحويل;


عرف الرئيسية(): عدد {
    دع النص: نص = "أحمر,أخضر,أزرق";
    دع الفاصل_القصير: نص = ",";
    دع القيم: متجه نص = قسم_النص(&النص, &الفاصل_القصير);
    دع الفاصل_الطويل: نص = " / ";
    اطبع_سطر(صل_النصوص(&القيم, &الفاصل_الطويل));
    أرجع 0;
}
