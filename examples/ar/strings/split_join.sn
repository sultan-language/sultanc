// مثال على التعامل مع النصوص.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.تحويل;


عرف الرئيسية(): عدد {
    ليكن النص: نص = "أحمر,أخضر,أزرق";
    ليكن الفاصل_القصير: نص = ",";
    ليكن القيم: متجه نص = قسم_النص(&النص, &الفاصل_القصير);
    ليكن الفاصل_الطويل: نص = " / ";
    اطبع_سطر(صل_النصوص(&القيم, &الفاصل_الطويل));
    أرجع 0;
}
