// بناء النص قطعة قطعة بباني النص.
استورد std.io.println;
استورد std.text.number;
استورد std.text.builder;
استورد std.text.transform;

عرف الرئيسية(): عدد {
    دع السطر: متغير باني_نص = أنشئ_باني_نص();
    دع ف: متغير عدد = 1;
    طالما (ف <= 5) {
        دع الرقم: نص = عدد_إلى_نص(ف * ف);
        ألحق_نصا_بباني_النص(&متغير السطر, &الرقم);
        لو (ف < 5) {
            دع الفاصلة: نص = ",";
            ألحق_نصا_بباني_النص(&متغير السطر, &الفاصلة);
        };
        ف := ف + 1;
    }
    اطبع_سطر(نص_باني_النص(&السطر));
    دع الشرطة: نص = "-";
    اطبع_سطر(كرر_النص(&الشرطة, 12));
    أرجع 0;
}
