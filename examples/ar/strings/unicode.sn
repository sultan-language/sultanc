// النص بترميز UTF-8: `الطول` يعد البايتات، والحروف يمكن أن تكون عربية.
استورد std.io.println;
استورد std.text.number;

عرف الرئيسية(): عدد {
    دع اللاتيني: نص = "salam";
    دع العربي: نص = "سلام";
    اطبع_سطر(طبيعي_إلى_نص(الطول(اللاتيني) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(الطول(العربي) مثل طبيعي));
    اطبع_سطر(العربي);
    دع الحرف: حرف = 'س';
    اطبع_سطر(طبيعي_إلى_نص(الحرف مثل طبيعي));
    أرجع 0;
}
