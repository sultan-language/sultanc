// تصنيف بايتات ASCII وتحويلها.
استورد std.io.println;
استورد std.text.number;
استورد std.text.from_bytes;
استورد std.chars.ascii;

عرف الرئيسية(): عدد {
    دع النص: متجه ط8 = بايتات_من_نص("SultanC 2026!");
    دع الأرقام: متغير طبيعي = 0;
    دع الحروف: متغير طبيعي = 0;
    دع الكبيرة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        لو (رقم_عشري(النص[ف])) { الأرقام := الأرقام + 1; };
        لو (حرف_لاتيني(النص[ف])) { الحروف := الحروف + 1; };
        ألحق(الكبيرة, إلى_كبير_أسكي(النص[ف]));
        ف := ف + 1;
    }
    اطبع_سطر(طبيعي_إلى_نص(الأرقام));
    اطبع_سطر(طبيعي_إلى_نص(الحروف));
    اطبع_سطر(من_بايتات(&الكبيرة));
    أرجع 0;
}
