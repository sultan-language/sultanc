// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قناة;


عرف الرئيسية(): عدد {
    دع الطرفان: طرفا_قناة<عدد> = قناة<عدد>();
    طابق أرسل(&الطرفان.المرسل, 17) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };
    طابق استقبل(&الطرفان.المستلم) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(القيمة) -> { اطبع_سطر(عدد_إلى_نص(القيمة)); };
    أرجع 0;
}
