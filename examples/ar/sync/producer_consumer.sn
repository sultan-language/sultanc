// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قناة;


عرف الرئيسية(): عدد {
    دع الطرفان: طرفا_قناة<نص> = قناة<نص>();
    طابق أرسل(&الطرفان.المرسل, "المحتوى") مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };
    طابق استقبل(&الطرفان.المستلم) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(القيمة) -> { اطبع_سطر(القيمة); };
    أرجع 0;
}
