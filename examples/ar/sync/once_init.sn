// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.مرة;

عرف أبلغ(): فراغ { اطبع_سطر("نفّذ التهيئة مرة واحدة"); }
عرف الرئيسية(): عدد {
    ليكن مؤشر_التهيئة: مرة = أنشئ_مرة();
    إذا (هل_اكتملت_المرة(&مؤشر_التهيئة)) { أرجع 1; };
    نفذ_مرة(&مؤشر_التهيئة, دالة(): فراغ -> أبلغ());
    نفذ_مرة(&مؤشر_التهيئة, دالة(): فراغ -> أبلغ());
    إذا (هل_اكتملت_المرة(&مؤشر_التهيئة)) { اطبع_سطر("اكتملت التهيئة"); } وإلا { أرجع 2; };
    أرجع 0;
}
