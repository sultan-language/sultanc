// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.ذري;


عرف الرئيسية(): عدد {
    ليكن ألغي: ذرة_ط32 = أنشئ_ذرة_ط32(0 مثل ط32);
    اخزن_ط32(&ألغي, 1 مثل ط32, ترتيب_ذاكرة.إطلاق());
    إذا (احمل_ط32(&ألغي, ترتيب_ذاكرة.اكتساب()) == (1 مثل ط32)) { اطبع_سطر("طُلب الإلغاء"); } وإلا { أرجع 1; };
    أرجع 0;
}
