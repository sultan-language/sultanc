// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قفل_قراءة_كتابة;

عرف اقرأ(القيمة_الوسيطة: &ص64): ص64 { أرجع *القيمة_الوسيطة; }
عرف ضاعف(القيمة_الوسيطة: &متغير ص64): فراغ { *القيمة_الوسيطة := *القيمة_الوسيطة * 2; }
عرف الرئيسية(): عدد {
    دع القفل: قفل_قراءة_كتابة<ص64> = أنشئ_قفل_قراءة_كتابة(21 مثل ص64);
    دع الأول: ص64 = نفذ_مع_قراءة(&القفل, دالة(القيمة_الوسيطة: &ص64): ص64 -> اقرأ(القيمة_الوسيطة));
    نفذ_مع_كتابة(&القفل, دالة(القيمة_الوسيطة: &متغير ص64): فراغ -> ضاعف(القيمة_الوسيطة));
    دع الثاني: ص64 = نفذ_مع_قراءة(&القفل, دالة(القيمة_الوسيطة: &ص64): ص64 -> اقرأ(القيمة_الوسيطة));
    اطبع_سطر(عدد_إلى_نص((الأول + الثاني) مثل عدد));
    أرجع 0;
}
