// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.ذري;


عرف الرئيسية(): عدد {
    ليكن العداد: ذرة_ط32 = أنشئ_ذرة_ط32(0 مثل ط32);
    اخزن_ط32(&العداد, 5 مثل ط32, ترتيب_ذاكرة.تسلسلي());
    ليكن السابق_الذري: ط32 = اجمع_واجلب_ط32(&العداد, 3 مثل ط32, ترتيب_ذاكرة.تسلسلي());
    اطبع_سطر(طبيعي_إلى_نص((السابق_الذري + احمل_ط32(&العداد, ترتيب_ذاكرة.تسلسلي())) مثل طبيعي));
    أرجع 0;
}
