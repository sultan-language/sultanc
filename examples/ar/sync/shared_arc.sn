// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.مشترك;


عرف الرئيسية(): عدد {
    ليكن الأصلي: مشترك<عدد> = أنشئ_مشترك(42);
    ليكن آخر: مشترك<عدد> = استنسخ_مشترك(&الأصلي);
    إذا (هل_المشترك_نفسه(&الأصلي, &آخر)) { اطبع_سطر(عدد_إلى_نص(*اقرأ_مشترك(&آخر))); } وإلا { أرجع 1; };
    أرجع 0;
}
