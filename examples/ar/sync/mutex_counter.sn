// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قفل;

عرف أضف_عشرة(القيمة_الوسيطة: &متغير ص64): ص64 { *القيمة_الوسيطة := *القيمة_الوسيطة + 10; أرجع *القيمة_الوسيطة; }
عرف الرئيسية(): عدد {
    ليكن القفل: قفل<ص64> = أنشئ_قفل(4 مثل ص64);
    ليكن التالي: ص64 = نفذ_مع_القفل(&القفل, دالة(القيمة_الوسيطة: &متغير ص64): ص64 -> أضف_عشرة(القيمة_الوسيطة));
    اطبع_سطر(عدد_إلى_نص(التالي مثل عدد));
    أرجع 0;
}
