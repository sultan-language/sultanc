// مثال على التزامن.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تزامن.قناة;


عرف الرئيسية(): عدد {
    دع الطرفان: طرفا_قناة<عدد> = قناة_متزامنة<عدد>(2 مثل طبيعي);
    طابق أرسل(&الطرفان.المرسل, 7) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع 1; };
    طابق أرسل(&الطرفان.المرسل, 9) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق استقبل(&الطرفان.المستلم) مع | نتيجة.نجح(القيمة) -> { اطبع_سطر(عدد_إلى_نص(القيمة)); } | نتيجة.خطأ(_) -> { أرجع 3; };
    أرجع 0;
}
