// مثال على بروتوكول نقل النص الفائق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ويب.استعلام;


عرف الرئيسية(): عدد {
    ليكن الهدف: نص = "/items?page=10&sort=asc";
    اطبع_سطر(مسار_هدف_ويب(&الهدف));
    طابق استعلام_هدف_ويب(&الهدف) مع
    | اختياري.موجود(الاستعلام) -> { اطبع_سطر(الاستعلام); }
    | اختياري.لا_شيء -> { اطبع_سطر("لا يوجد استعلام"); };
    أرجع 0;
}
