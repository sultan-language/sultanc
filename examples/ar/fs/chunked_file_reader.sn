// قراءة ملف على أجزاء: يؤخذ المحتوى ثلاثة بايتات في كل مرة، وتُعد الأجزاء.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.مقطع;

عرف الرئيسية(): عدد {
    ليكن المسار: نص = "sultanc-chunk-read.tmp";
    ليكن المحتوى: نص = "abcdefghijkl";
    طابق اكتب_الملف(&المسار, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    ليكن العدد: متغير عدد = 0;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        ليكن الإزاحة: متغير طبيعي = 0;
        طالما (الإزاحة < الطول(النص) مثل طبيعي) {
            طابق مقطع_نص(&النص, الإزاحة, 3) مع
            | اختياري.موجود(الجزء) -> { العدد := العدد + 1; }
            | _ -> { أرجع 2; };
            الإزاحة := الإزاحة + 3;
        };
    }
    | _ -> { أرجع 3; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | _ -> { };
    إذا (العدد != 4) { أرجع 5; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
