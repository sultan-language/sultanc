// مقارنة دليلين: يوضع الملف نفسه في كل منهما، ويُقارن حجما الملفين.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن الأيسر: نص = "sultanc-left-dir";
    ليكن الأيمن: نص = "sultanc-right-dir";
    ليكن المسار_أ: نص = "sultanc-left-dir/item.txt";
    ليكن المسار_ب: نص = "sultanc-right-dir/item.txt";
    ليكن المحتوى: نص = "متطابق";
    طابق أنشئ_مسار_الدليل(&الأيسر) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق أنشئ_مسار_الدليل(&الأيمن) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    طابق اكتب_الملف(&المسار_أ, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    طابق اكتب_الملف(&المسار_ب, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | _ -> { };
    ليكن متطابق: متغير منطقي = خطأ;
    طابق حجم_المسار(&المسار_أ) مع
    | نتيجة.نجح(أ) -> {
        طابق حجم_المسار(&المسار_ب) مع
        | نتيجة.نجح(ب) -> { متطابق := أ == ب; }
        | _ -> { };
    }
    | _ -> { };
    طابق احذف_الشجرة(&الأيسر) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | _ -> { };
    طابق احذف_الشجرة(&الأيمن) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | _ -> { };
    إذا (!متطابق) { أرجع 7; };
    اطبع_سطر("الحجمان متطابقان");
    أرجع 0;
}
