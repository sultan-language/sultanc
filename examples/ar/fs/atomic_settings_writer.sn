// حفظ الإعدادات دفعة واحدة: يُكتب ملف مؤقت ثم يُعاد تسميته إلى المسار النهائي، فلا يرى
// القارئ ملفا مكتوبا نصفه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.مقارنة;

عرف الرئيسية(): عدد {
    ليكن المؤقت: نص = "sultanc-settings.tmp";
    ليكن المسار_النهائي: نص = "sultanc-settings.toml";
    ليكن المحتوى: نص = "level = 3\n";
    طابق اكتب_الملف(&المؤقت, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق أعد_تسمية(&المؤقت, &المسار_النهائي) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    ليكن صالح: متغير منطقي = خطأ;
    طابق اقرأ_الملف(&المسار_النهائي) مع
    | نتيجة.نجح(النص) -> { صالح := نصان_متساويان(&المحتوى, &النص); }
    | _ -> { };
    طابق أزل_ملفا(&المسار_النهائي) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    إذا (!صالح) { أرجع 4; };
    اطبع_سطر("حفظت الإعدادات");
    أرجع 0;
}
