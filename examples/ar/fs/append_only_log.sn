// سجل لا يُكتب فيه إلا بالإلحاق: يُكتب سطر أول، ثم يُقرأ الملف ويُعاد كتابته وفي آخره سطر
// إضافي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المسار: نص = "sultanc-append-log.tmp";
    ليكن الأول: نص = "الأول\n";
    طابق اكتب_الملف(&المسار, &الأول) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    ليكن الأسطر: متغير عدد = 0;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(السابق) -> {
        ليكن التالي: نص = "الثاني\n";
        ليكن كلاهما: نص = صل_نصين(&السابق, &التالي);
        طابق اكتب_الملف(&المسار, &كلاهما) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | _ -> { };
    }
    | _ -> { أرجع 3; };
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        ليكن نتيجة: متجه نص = قسم_النص(&النص, &"\n");
        الأسطر := الطول(نتيجة) - 1;
    }
    | _ -> { أرجع 4; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | _ -> { };
    إذا (الأسطر != 2) { أرجع 6; };
    اطبع_سطر(عدد_إلى_نص(الأسطر));
    أرجع 0;
}
