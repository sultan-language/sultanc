// قياس ما يحويه دليل: يُنشأ دليل فيه ملف واحد من 10 بايتات، ويُقرأ حجم الملف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع الدليل: نص = "sultanc-dir-size";
    دع الملف: نص = "sultanc-dir-size/item.txt";
    دع المحتوى: نص = "1234567890";
    طابق أنشئ_مسار_الدليل(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق اكتب_الملف(&الملف, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    دع البايتات: متغير عدد = 0;
    طابق حجم_المسار(&الملف) مع
    | نتيجة.نجح(الحجم) -> { البايتات := الحجم; }
    | _ -> { };
    طابق احذف_الشجرة(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    إذا (البايتات != 10) { أرجع 4; };
    اطبع_سطر(عدد_إلى_نص(البايتات));
    أرجع 0;
}
