// كتابة ملف ثم قراءته ثم حذفه.
استورد std.io.println;
استورد std.fs.write_file;
استورد std.fs.read_file;
استورد std.fs.mutation;

عرف الرئيسية(): عدد {
    دع المسار: نص = "sultanc-example.tmp";
    دع المحتوى: نص = "حفظه سلطان سي";
    طابق اكتب_الملف(&المسار, &المحتوى) مع
    | نتيجة.خطأ(الرمز) -> { اطبع_سطر("فشلت الكتابة"); أرجع الرمز; }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> { اطبع_سطر(النص); }
    | نتيجة.خطأ(الرمز) -> { اطبع_سطر("فشلت القراءة"); أرجع الرمز; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { اطبع_سطر("حُذف"); }
    | نتيجة.خطأ(الرمز) -> { أرجع الرمز; };
    أرجع 0;
}
