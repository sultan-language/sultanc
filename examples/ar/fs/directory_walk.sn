// مثال على الملفات والمجلدات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;


عرف الرئيسية(): عدد {
    ليكن المسار: نص = "sultanc-new-directory_walk.tmp";
    ليكن النص: نص = "مخزن بواسطة السلطان";
    طابق اكتب_الملف(&المسار, &النص) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(القيمة) -> { اطبع_سطر(القيمة); }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    أرجع 0;
}
