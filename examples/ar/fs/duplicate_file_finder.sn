// اكتشاف الملفات المكررة: الملفان المتساويان في المحتوى يُعدان مكررين.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.مقارنة;

عرف الرئيسية(): عدد {
    دع واحد: نص = "sultanc-duplicate-a.tmp";
    دع اثنان: نص = "sultanc-duplicate-b.tmp";
    دع المحتوى: نص = "same payload";
    طابق اكتب_الملف(&واحد, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق اكتب_الملف(&اثنان, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    دع متطابق: متغير منطقي = خطأ;
    طابق اقرأ_الملف(&واحد) مع
    | نتيجة.نجح(أ) -> {
        طابق اقرأ_الملف(&اثنان) مع
        | نتيجة.نجح(ب) -> { متطابق := نصان_متساويان(&أ, &ب); }
        | _ -> { };
    }
    | _ -> { };
    طابق أزل_ملفا(&واحد) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    طابق أزل_ملفا(&اثنان) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | _ -> { };
    إذا (!متطابق) { أرجع 5; };
    اطبع_سطر("اكتشف تكرار");
    أرجع 0;
}
