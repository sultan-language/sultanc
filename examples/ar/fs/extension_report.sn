// عد الملفات حسب الامتداد: كم مسارا من المسارات ينتهي بـ .sn.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.مقارنة;

عرف الرئيسية(): عدد {
    دع المسارات_المخزنة: متجه نص = ["src/main.sn", "doc/readme.md", "src/lib.sn"];
    دع العدد: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المسارات_المخزنة)) {
        طابق امتداد_المسار(&المسارات_المخزنة[ف]) مع
        | اختياري.موجود(الامتداد) -> {
            إذا (نصان_متساويان(&الامتداد, &"sn")) { العدد := العدد + 1; };
        }
        | _ -> { };
        ف := ف + 1;
    };
    إذا (العدد != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
