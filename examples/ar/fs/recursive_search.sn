// البحث في دليل تكراريا: تُجتاز الشجرة فيوجد الملف داخل دليل فرعي.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.اجتياز;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع الجذر: نص = "sultanc-recursive-search";
    دع الداخلي: نص = "sultanc-recursive-search/notes";
    دع الورقة: نص = "sultanc-recursive-search/notes/todo.txt";
    دع المحتوى: نص = "تم العثور";
    طابق أنشئ_مسار_الدليل(&الداخلي) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    طابق اكتب_الملف(&الورقة, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    دع العدد: متغير عدد = 0;
    طابق اجتز_الشجرة(&الجذر) مع
    | نتيجة.نجح(المدخلات) -> { العدد := الطول(المدخلات); }
    | _ -> { };
    طابق احذف_الشجرة(&الجذر) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    إذا (العدد < 2) { أرجع 4; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
