// شجرة تعبير صغيرة نوعا جبريا: يحمل كل متغير عددا، وتجمعه دالة التقييم مع قيمة أساس عبر
// `طابق`.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع تعبير = | رقم بنوع عدد | جمع بنوع عدد | ضرب بنوع عدد;

عرف احسب_القيمة(التعبير: تعبير, الأساس: عدد): عدد {
    طابق التعبير مع
    | تعبير.رقم(س) -> { أرجع س; }
    | تعبير.جمع(أ) -> { أرجع الأساس + أ; }
    | تعبير.ضرب(أ) -> { أرجع الأساس * أ; };
}

عرف الرئيسية(): عدد {
    ليكن الشجرة: تعبير = تعبير.ضرب(7);
    ليكن الجواب: عدد = احسب_القيمة(الشجرة, 6);
    إذا (الجواب != 42) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجواب));
    أرجع 0;
}
