// تحليل ملف .env: يُقسم إلى أسطر، ثم يُقسم السطر عند "=" إلى مفتاح وقيمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "LANG=ar\nMODE=dev\n";
    دع الأسطر: متجه نص = قسم_النص(&المصدر, &"\n");
    دع علامة_الإسناد: نص = "=";
    دع الأزواج: متجه نص = قسم_النص(&الأسطر[0], &علامة_الإسناد);
    إذا (الطول(الأزواج) != 2) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأزواج[1]));
    أرجع 0;
}
