// استخراج النص من الترميز: يُقسم عند الوسم الفاتح ثم عند الوسم الغالق، فيبقى النص الذي بينهما.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "<title>Example</title>";
    دع الوسم_الفاتح: نص = "<title>";
    دع الوسم_الغالق: نص = "</title>";
    دع البداية: متجه نص = قسم_النص(&المصدر, &الوسم_الفاتح);
    إذا (الطول(البداية) != 2) { أرجع 1; };
    دع الأجزاء: متجه نص = قسم_النص(&البداية[1], &الوسم_الغالق);
    اطبع_سطر(استنسخ(&الأجزاء[0]));
    أرجع 0;
}
