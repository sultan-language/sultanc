// تحليل عملية جمع: تُقسم "12+30" عند علامة الجمع إلى معاملَيها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "12+30";
    ليكن علامة_الجمع: نص = "+";
    ليكن الأجزاء: متجه نص = قسم_النص(&المصدر, &علامة_الجمع);
    إذا (الطول(الأجزاء) != 2) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأجزاء[0]));
    أرجع 0;
}
