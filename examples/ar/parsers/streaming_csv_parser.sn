// قراءة CSV سطرا سطرا: يُتخطى سطر العناوين، ويُتحقق من أن في كل صف بيانات حقلين.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "name,score\nAli,8\nLina,9\n";
    دع الأسطر: متجه نص = قسم_النص(&المصدر, &"\n");
    دع ف: متغير عدد = 1;
    دع المجموع_العام: متغير عدد = 0;
    طالما (ف < 3) {
        دع الحقول: متجه نص = قسم_النص(&الأسطر[ف], &",");
        إذا (الطول(الحقول) != 2) { أرجع 1; };
        المجموع_العام := المجموع_العام + 1;
        ف := ف + 1;
    };
    إذا (المجموع_العام != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع_العام));
    أرجع 0;
}
