// تحليل سطر سجل: يُقسم عند "|" إلى مستوى وتاريخ ورسالة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "INFO|2026-11-16|ready";
    دع الأجزاء: متجه نص = قسم_النص(&المصدر, &"|");
    إذا (الطول(الأجزاء) != 3) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأجزاء[2]));
    أرجع 0;
}
