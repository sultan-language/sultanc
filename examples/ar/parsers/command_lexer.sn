// تقسيم سطر أوامر إلى وحدات عند المسافات: اسم الأمر ووسيطاه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "copy source.txt dest.txt";
    دع الأجزاء: متجه نص = قسم_النص(&المصدر, &" ");
    إذا (الطول(الأجزاء) != 3) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأجزاء[0]));
    أرجع 0;
}
