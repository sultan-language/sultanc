// تقسيم وسائط بأسلوب الصدفة عند المسافات: خيار له قيمة، وراية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "--name=سلمان --verbose";
    ليكن الكلمات: متجه نص = قسم_النص(&المصدر, &" ");
    إذا (الطول(الكلمات) != 2) { أرجع 1; };
    اطبع_سطر(استنسخ(&الكلمات[0]));
    أرجع 0;
}
