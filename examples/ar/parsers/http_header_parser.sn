// تحليل سطر ترويسة HTTP: يُقسم عند ": " إلى اسم وقيمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "Content-Type: application/json";
    ليكن الفاصل: نص = ": ";
    ليكن الأجزاء: متجه نص = قسم_النص(&المصدر, &الفاصل);
    إذا (الطول(الأجزاء) != 2) { أرجع 1; };
    اطبع_سطر(استنسخ(&الأجزاء[1]));
    أرجع 0;
}
