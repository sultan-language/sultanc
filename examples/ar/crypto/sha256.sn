// ملخص SHA-256 لمتجه بايتات مطبوعا بالنظام الست عشري.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.ترميز.سداسي;

عرف الرئيسية(): عدد {
    ليكن المدخل: متجه ط8 = [0x61, 0x62, 0x63];
    ليكن الملخص: متجه ط8 = شا256(&المدخل);
    اطبع_سطر(رمز_سداسي(&الملخص));
    أرجع 0;
}
