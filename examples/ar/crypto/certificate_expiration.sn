// تحليل شهادات X.509 قبل أي فحص لانتهاء الصلاحية: تُرفض الشهادة المشوهة عند التحليل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.تي_إل_إس.إكس509;

عرف الرئيسية(): عدد {
    ليكن مشوه: متجه ط8 = [48 مثل ط8, 1 مثل ط8, 2 مثل ط8];
    طابق حلل_شهادة_إكس509(&مشوه) مع
    | اختياري.لا_شيء -> { اطبع_سطر("رفضت الشهادة غير الصالحة"); }
    | اختياري.موجود(_) -> { أرجع 1; };
    أرجع 0;
}
