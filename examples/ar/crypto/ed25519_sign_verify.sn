// تواقيع Ed25519: يُشتق مفتاح عام من بذرة، ثم توقَّع رسالة ويُتحقق من التوقيع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.تشفير.إد25519;

عرف الرئيسية(): عدد {
    ليكن البذرة: متغير متجه ط8 = [];
    ليكن ف: متغير عدد = 0;
    طالما (ف < 32) {
        ألحق(البذرة, (ف + 1) مثل ط8);
        ف := ف + 1;
    };
    ليكن الرسالة: متجه ط8 = بايتات_من_نص("رسالة موقعة");
    طابق مفتاح_عام_إد25519(&البذرة) مع
    | اختياري.موجود(المفتاح_العام) -> {
        طابق وقع_إد25519(&البذرة, &الرسالة) مع
        | اختياري.موجود(توقيع) -> {
            إذا (!تحقق_إد25519(&المفتاح_العام, &الرسالة, &توقيع)) { أرجع 1; };
            اطبع_سطر("تحقق التوقيع");
        }
        | اختياري.لا_شيء -> { أرجع 2; };
    }
    | اختياري.لا_شيء -> { أرجع 3; };
    أرجع 0;
}
