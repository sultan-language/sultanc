// مقارنة الأسرار في زمن ثابت: تُجمع نتائج XOR لكل زوج من البايتات بعملية OR، فلا يتوقف الزمن
// على موضع أول اختلاف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;

عرف بايتات_متساوية(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    ليكن الفرق: متغير ط8 = 0 مثل ط8;
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(*أ)) {
        الفرق := الفرق | ((*أ)[ف] ^ (*ب)[ف]);
        ف := ف + 1;
    };
    أرجع الفرق == 0 مثل ط8;
}

عرف الرئيسية(): عدد {
    ليكن أ: متجه ط8 = بايتات_من_نص("سر");
    ليكن ب: متجه ط8 = بايتات_من_نص("سر");
    ليكن ج: متجه ط8 = بايتات_من_نص("سر_آخر");
    إذا (!بايتات_متساوية(&أ, &ب) || بايتات_متساوية(&أ, &ج)) { أرجع 1; };
    اطبع_سطر("تمت المقارنة");
    أرجع 0;
}
