// التحقق من ملف بـ SHA-256: تُحسب بصمة المحتوى قبل كتابته، ثم يُقرأ الملف وتُقارن البصمتان
// بايتا ببايت.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.تشفير.شا256;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;

عرف الرئيسية(): عدد {
    دع المسار: نص = "sultanc-file-hash-example.tmp";
    دع المحتوى: نص = "ملف موثوق";
    طابق اكتب_الملف(&المسار, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | _ -> { };
    دع المتوقع: متجه ط8 = شا256(&بايتات_من_نص(المحتوى));
    دع صالح: متغير منطقي = خطأ;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        دع الفعلي: متجه ط8 = شا256(&بايتات_من_نص(النص));
        دع ف: متغير عدد = 0;
        صالح := صواب;
        طالما (ف < 32) {
            إذا (المتوقع[ف] != الفعلي[ف]) { صالح := خطأ; };
            ف := ف + 1;
        };
    }
    | _ -> { };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | _ -> { };
    إذا (!صالح) { أرجع 3; };
    اطبع_سطر("تحققت البصمة");
    أرجع 0;
}
