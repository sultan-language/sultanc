// مثال على التشفير والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تشفير.إد25519;
استورد المكتبة.نصوص.من_بايتات;


عرف الرئيسية(): عدد {
    ليكن البذرة: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 32) { ألحق(البذرة, (ف * 7) مثل ط8); ف := ف + 1; };
    ليكن الأصلي: متجه ط8 = بايتات_من_نص("رسالة أصلية");
    ليكن المزور: متجه ط8 = بايتات_من_نص("رسالة مزورة");
    طابق مفتاح_عام_إد25519(&البذرة) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(المفتاح_العام) -> {
        طابق وقع_إد25519(&البذرة,&الأصلي) مع
        | اختياري.لا_شيء -> { أرجع 2; }
        | اختياري.موجود(التوقيع) -> {
            إذا (!تحقق_إد25519(&المفتاح_العام,&الأصلي,&التوقيع)) { أرجع 3; };
            إذا (تحقق_إد25519(&المفتاح_العام,&المزور,&التوقيع)) { أرجع 4; };
            اطبع_سطر("رُفض التزوير");
        };
    };
    أرجع 0;
}
