// مثال على التشفير والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.تشفير.ملخص;


عرف الرئيسية(): عدد {
    ليكن المفتاح: متجه ط8 = بايتات_من_نص("key");
    ليكن الرسالة: متجه ط8 = بايتات_من_نص("بيانات");
    ليكن البصمة: متجه ط8 = هماك_شا256(&المفتاح, &الرسالة);
    اطبع_سطر(رمز_سداسي(&البصمة));
    أرجع 0;
}
