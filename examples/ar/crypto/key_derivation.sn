// مثال على التشفير والتحقق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.تشفير.ملخص;


عرف الرئيسية(): عدد {
    دع المفتاح: متجه ط8 = بايتات_من_نص("key");
    دع الرسالة: متجه ط8 = بايتات_من_نص("بيانات");
    دع البصمة: متجه ط8 = هماك_شا256(&المفتاح, &الرسالة);
    اطبع_سطر(رمز_سداسي(&البصمة));
    أرجع 0;
}
