// تجزئة كلمات المرور بـ PBKDF2-HMAC-SHA-256: يُشتق مفتاح من 32 بايتا من كلمة مرور وملح،
// ويُطبع بالنظام الست عشري.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.تشفير.ملخص;
استورد المكتبة.ترميز.سداسي;

عرف الرئيسية(): عدد {
    ليكن كلمة_المرور: متجه ط8 = بايتات_من_نص("example password");
    ليكن الملح: متجه ط8 = بايتات_من_نص("unique salt");
    طابق ببدف2_هماك_شا256(&كلمة_المرور, &الملح, 20, 32) مع
    | اختياري.موجود(المفتاح) -> {
        إذا (الطول(المفتاح) != 32) { أرجع 1; };
        اطبع_سطر(رمز_سداسي(&المفتاح));
    }
    | اختياري.لا_شيء -> { أرجع 2; };
    أرجع 0;
}
