// تبادل المفاتيح بـ X25519: يدمج كل طرف مفتاحه الخاص بالمفتاح العام للطرف الآخر، فيصلان إلى
// السر المشترك نفسه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.تشفير.إكس25519;

عرف الرئيسية(): عدد {
    دع أ: متغير متجه ط8 = [];
    دع ب: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < 32) {
        ألحق(أ, (ف + 1) مثل ط8);
        ألحق(ب, (ف + 41) مثل ط8);
        ف := ف + 1;
    };
    دع العام_أ: متجه ط8 = مفتاح_عام_إكس25519(&أ);
    دع العام_ب: متجه ط8 = مفتاح_عام_إكس25519(&ب);
    دع السر_أ: متجه ط8 = إكس25519(&أ, &العام_ب);
    دع السر_ب: متجه ط8 = إكس25519(&ب, &العام_أ);
    إذا (الطول(السر_أ) != 32 || الطول(السر_ب) != 32) { أرجع 1; };
    ف := 0;
    طالما (ف < 32) {
        إذا (السر_أ[ف] != السر_ب[ف]) { أرجع 2; };
        ف := ف + 1;
    };
    اطبع_سطر("تطابق السر المشترك");
    أرجع 0;
}
