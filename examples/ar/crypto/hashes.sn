// SHA-512 وHMAC-SHA-256 مطبوعين بالنظام الست عشري.
استورد std.io.println;
استورد std.text.from_bytes;
استورد std.encoding.hex;
استورد std.crypto.sha512;
استورد std.crypto.digest;

عرف الرئيسية(): عدد {
    دع الرسالة: متجه ط8 = بايتات_من_نص("abc");
    دع الملخص: متجه ط8 = شا512(&الرسالة);
    اطبع_سطر(رمز_سداسي(&الملخص));
    دع المفتاح: متجه ط8 = بايتات_من_نص("key");
    دع النص: متجه ط8 = بايتات_من_نص("The quick brown fox jumps over the lazy dog");
    دع الوسم: متجه ط8 = هماك_شا256(&المفتاح, &النص);
    اطبع_سطر(رمز_سداسي(&الوسم));
    أرجع 0;
}
