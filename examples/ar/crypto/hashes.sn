// SHA-512 وHMAC-SHA-256 مطبوعين بالنظام الست عشري.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ترميز.سداسي;
استورد المكتبة.تشفير.شا512;
استورد المكتبة.تشفير.ملخص;

عرف الرئيسية(): عدد {
    ليكن الرسالة: متجه ط8 = بايتات_من_نص("abc");
    ليكن الملخص: متجه ط8 = شا512(&الرسالة);
    اطبع_سطر(رمز_سداسي(&الملخص));
    ليكن المفتاح: متجه ط8 = بايتات_من_نص("key");
    ليكن النص: متجه ط8 = بايتات_من_نص("The quick brown fox jumps over the lazy dog");
    ليكن الوسم: متجه ط8 = هماك_شا256(&المفتاح, &النص);
    اطبع_سطر(رمز_سداسي(&الوسم));
    أرجع 0;
}
