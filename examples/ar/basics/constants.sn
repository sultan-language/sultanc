// ثوابت مستوى الوحدة تُحسب قبل تشغيل الرئيسية.
استورد std.io.println;
استورد std.text.number;

دع العرض: عدد = 16;
دع الارتفاع: عدد = 9;
دع المساحة: عدد = العرض * الارتفاع;
دع الرايات: عدد = (1 << 3) | (1 << 1);
دع عريض: منطقي = العرض > الارتفاع;

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(المساحة));
    اطبع_سطر(عدد_إلى_نص(الرايات));
    لو (عريض) {
        اطبع_سطر("عريض");
    };
    أرجع 0;
}
