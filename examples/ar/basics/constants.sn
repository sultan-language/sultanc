// ثوابت مستوى الوحدة تُحسب قبل تشغيل الرئيسية.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

ليكن العرض: عدد = 16;
ليكن الارتفاع: عدد = 9;
ليكن المساحة: عدد = العرض * الارتفاع;
ليكن الرايات: عدد = (1 << 3) | (1 << 1);
ليكن عريض: منطقي = العرض > الارتفاع;

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(المساحة));
    اطبع_سطر(عدد_إلى_نص(الرايات));
    إذا (عريض) {
        اطبع_سطر("عريض");
    };
    أرجع 0;
}
