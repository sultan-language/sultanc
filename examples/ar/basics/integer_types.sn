// أعداد صحيحة بعرض ثابت وقيم ست عشرية وتحويل صريح بـ`مثل`، تطبع بالمكتبة.تنسيق
// عشرية وست عشرية وثنائية.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الصغير: ط8 = 0xFF;
    دع الموسع: ط32 = (الصغير مثل ط32) + 1;
    دع السالب: ص16 = -300;
    دع الكبير: ط64 = (الموسع مثل ط64) * 1000000;
    دع القناع: ط32 = 0x0F0F & 0x00FF;
    دع ر: نتيجة طبيعي, خطأ_تنسيق = اطبع_سطرا_منسقا("{0} = {0:#x}\n{1}\n{2} = {2:#x} بست عشرة بتا\n{3}\n{4} = {4:#06x} = {4:#b}", [قيمة_تنسيق.ط8(الصغير), قيمة_تنسيق.ط32(الموسع), قيمة_تنسيق.ص16(السالب), قيمة_تنسيق.ط64(الكبير), قيمة_تنسيق.ط32(القناع)]);
    أرجع 0;
}
