// تنسيق تواريخ ISO 8601 وتحليلها.
استورد std.io.println;
استورد std.text.number;
استورد std.time.calendar;
استورد std.time.date;

عرف الرئيسية(): عدد {
    طابق أنشئ_تاريخا_تقويميا(2026, 11, 4) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(التاريخ) -> {
        طابق نسق_تاريخ_آيزو(&التاريخ) مع
        | اختياري.موجود(النص) -> { اطبع_سطر(النص); }
        | اختياري.لا_شيء -> { };
    };
    أرجع 0;
}
