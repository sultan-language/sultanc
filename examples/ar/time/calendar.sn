// حساب التقويم: السنوات الكبيسة وأطوال الأشهر وعدد الأيام.
استورد std.io.println;
استورد std.text.number;
استورد std.time.calendar;

عرف الرئيسية(): عدد {
    لو (سنة_كبيسة(2024)) { اطبع_سطر("2024 سنة كبيسة"); };
    لو (!سنة_كبيسة(2100)) { اطبع_سطر("2100 ليست كبيسة"); };
    اطبع_سطر(طبيعي_إلى_نص(أيام_في_الشهر(2024, 2)));
    طابق أنشئ_تاريخا_تقويميا(2026, 11, 4) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(التاريخ) -> {
        طابق ترتيب_اليوم_في_السنة(&التاريخ) مع
        | اختياري.موجود(اليوم) -> { اطبع_سطر(طبيعي_إلى_نص(اليوم)); }
        | اختياري.لا_شيء -> { };
        طابق أيام_يونكس_من_التاريخ(&التاريخ) مع
        | اختياري.موجود(الأيام) -> { اطبع_سطر(عدد_إلى_نص(الأيام)); }
        | اختياري.لا_شيء -> { };
    };
    أرجع 0;
}
