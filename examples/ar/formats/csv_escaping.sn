// مثال على صيغ البيانات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.سي_اس_في.سي_اس_في;


عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "name,score\nAda,7\nNoor,20\n";
    طابق حلل_سي_اس_في(&المصدر) مع
    | نتيجة.نجح(المستند) -> { اطبع_سطر(طبيعي_إلى_نص(عدد_سجلات_سي_اس_في(&المستند))); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
