// مثال على صيغ البيانات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.جسون.تحليل;
استورد المكتبة.جسون.إلى_نص;


عرف الرئيسية(): عدد {
    ليكن المصدر: نص = "{\"الاسم\":\"SultanC\",\"المعرف\":3}";
    طابق حلل_جسون(&المصدر) مع
    | نتيجة.نجح(المستند) -> { طابق جسون_إلى_نص(&المستند) مع
      | نتيجة.نجح(المرمز) -> { اطبع_سطر(المرمز); }
      | نتيجة.خطأ(_) -> { أرجع 1; }; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
