// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع قياس = { المسافة: ص64, الوزن: ص64 };
عرف الرئيسية(): عدد {
    ليكن العينة: قياس = { المسافة: 2 مثل ص64, الوزن: 5 مثل ص64 };
    اطبع_سطر(طبيعي_إلى_نص(عدد_حقول_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
