// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع زوج<نوع_العنصر> = { الأول: نوع_العنصر, الثاني: نوع_العنصر };
عرف الرئيسية(): عدد {
    ليكن العينة: زوج<عدد> = { الأول: 1, الثاني: 2 };
    اطبع_سطر(طبيعي_إلى_نص(عدد_حقول_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
