// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع خيار_رسالة = | غائب | عثر_عليه بنوع عدد | فشل بنوع نص;
عرف الرئيسية(): عدد {
    ليكن العينة: خيار_رسالة = خيار_رسالة.غائب();
    اطبع_سطر(طبيعي_إلى_نص(عدد_منشئات_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
