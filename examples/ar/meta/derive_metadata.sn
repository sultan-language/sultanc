// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع موضع_مخصص = { س: ص32, ص: ص32 };
عرف الرئيسية(): عدد {
    دع النقطة: موضع_مخصص = { س: 2 مثل ص32, ص: 4 مثل ص32 };
    دع العدد: ط64 = عدد_حقول_النوع(&النقطة);
    اطبع_سطر(طبيعي_إلى_نص(العدد مثل طبيعي));
    أرجع 0;
}
