// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع داخلي = { أ: عدد, ب: عدد };
نوع متداخل = { الداخلي: داخلي, الوسم: نص };
عرف الرئيسية(): عدد {
    دع الداخلي: داخلي = { أ: 1, ب: 2 };
    دع العينة: متداخل = { الداخلي: الداخلي, الوسم: "nested" };
    اطبع_سطر(طبيعي_إلى_نص(عدد_حقول_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
