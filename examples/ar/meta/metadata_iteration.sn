// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع ثلاثية = { الأيسر: عدد, الأوسط: عدد, الأيمن: عدد };
عرف الرئيسية(): عدد {
    دع العينة: ثلاثية = { الأيسر: 1, الأوسط: 2, الأيمن: 3 };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_حقول_النوع(&العينة) مثل طبيعي) { اطبع_سطر(طبيعي_إلى_نص(ف)); ف := ف + 1; };
    أرجع 0;
}
