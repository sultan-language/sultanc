// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع حزمة = { رمز_الخروج: ط8, الحجم: ط64 };
عرف الرئيسية(): عدد {
    ليكن العينة: حزمة = { رمز_الخروج: 1 مثل ط8, الحجم: 6 مثل ط64 };
    اطبع_سطر(طبيعي_إلى_نص(حجم_النوع(&العينة) مثل طبيعي));
    اطبع_سطر(طبيعي_إلى_نص(محاذاة_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
