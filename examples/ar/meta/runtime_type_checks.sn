// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;


عرف الرئيسية(): عدد {
    ليكن أ: ط64 = 3 مثل ط64;
    ليكن ب: ط32 = 3 مثل ط32;
    إذا (حجم_النوع(&أ) > حجم_النوع(&ب)) { اطبع_سطر("عرض ٦٤ بت أكبر من ٣٢ بت"); } وإلا { أرجع 1; };
    أرجع 0;
}
