// مثال على معلومات الأنواع.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.انعكاس.انعكاس_الأنواع;

نوع سجل_مخصص = { المعرف: ط64, العنوان_الفرعي: نص, نشط: منطقي, الوسوم: متجه نص };
عرف الرئيسية(): عدد {
    ليكن العينة: سجل_مخصص = { المعرف: 7 مثل ط64, العنوان_الفرعي: "مرحبا", نشط: صواب, الوسوم: [] };
    اطبع_سطر(طبيعي_إلى_نص(عدد_حقول_النوع(&العينة) مثل طبيعي));
    أرجع 0;
}
