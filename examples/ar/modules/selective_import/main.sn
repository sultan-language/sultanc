// `من ... استورد` يجلب أسماء مختارة من دليل مكتبة.
من المكتبة.نصوص استورد عدد_إلى_نص, يحتوي_نصا;
من المكتبة.دخ استورد اطبع_سطر;

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(2026));
    دع الجملة: نص = "الاستيراد يمكن أن يكون انتقائيا";
    دع الكلمة: نص = "انتقائيا";
    إذا (يحتوي_نصا(&الجملة, &الكلمة)) { اطبع_سطر("موجود"); };
    أرجع 0;
}
