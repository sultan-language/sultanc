// `من ... استورد` يجلب أسماء مختارة من دليل مكتبة.
من std.text استورد عدد_إلى_نص, يحتوي_نصا;
من std.io استورد اطبع_سطر;

عرف الرئيسية(): عدد {
    اطبع_سطر(عدد_إلى_نص(2026));
    دع الجملة: نص = "الاستيراد يمكن أن يكون انتقائيا";
    دع الكلمة: نص = "انتقائيا";
    لو (يحتوي_نصا(&الجملة, &الكلمة)) { اطبع_سطر("موجود"); };
    أرجع 0;
}
