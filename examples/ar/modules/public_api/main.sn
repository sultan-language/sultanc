// يستخدم الجزء العام من geometry.sn؛ والدالة الخاصة `ضاعف_القيمة` تبقى مخفية.
استورد "geometry.sn";
استورد std.io.println;
استورد std.text.number;

عرف الرئيسية(): عدد {
    دع الغرفة: مستطيل = { العرض: 5, الارتفاع: 4 };
    اطبع_سطر(عدد_إلى_نص(المساحة(&الغرفة)));
    اطبع_سطر(عدد_إلى_نص(المحيط(&الغرفة)));
    أرجع 0;
}
