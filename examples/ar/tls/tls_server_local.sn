// مثال على أمان طبقة النقل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تي_إل_إس.إعداد;


عرف الرئيسية(): عدد {
    دع كلمة_المرور: نص = "not-a-real-key";
    دع الهوية: هوية_خادم_تي_إل_إس = أنشئ_هوية_خادم_تي_إل_إس([], &كلمة_المرور);
    دع التهيئة: متغير إعداد_خادم_تي_إل_إس = أنشئ_إعداد_خادم_تي_إل_إس(الهوية);
    اضبط_تحقق_عميل_تي_إل_إس(&متغير التهيئة, صواب);
    إذا (هل_تحقق_عميل_تي_إل_إس(&التهيئة)) { اطبع_سطر("ضُبطت مصادقة العميل"); } وإلا { أرجع 1; };
    أرجع 0;
}
