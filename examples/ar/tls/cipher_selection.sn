// مثال على أمان طبقة النقل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تي_إل_إس.إعداد;


عرف الرئيسية(): عدد {
    دع النطاق: نص = "example.test";
    دع الإعداد: متغير إعداد_عميل_تي_إل_إس = إعداد_عميل_تي_إل_إس_افتراضي(&النطاق);
    دع بروتوكولات_التفاوض: متجه نص = ["h2", "http/1.1"];
    اضبط_بروتوكولات_عميل_تي_إل_إس(&متغير الإعداد, &بروتوكولات_التفاوض);
    إذا (هل_تحقق_نظير_تي_إل_إس(&الإعداد)) { اطبع_سطر("التحقق من هوية الطرف الآخر مفعّل"); } وإلا { أرجع 1; };
    أرجع 0;
}
