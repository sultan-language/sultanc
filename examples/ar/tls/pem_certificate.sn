// مثال على أمان طبقة النقل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تي_إل_إس.إكس509;


عرف الرئيسية(): عدد {
    ليكن البايتات: متجه ط8 = [48 مثل ط8, 1 مثل ط8, 2 مثل ط8];
    طابق حلل_شهادة_إكس509(&البايتات) مع
    | اختياري.موجود(_) -> { أرجع 1; }
    | اختياري.لا_شيء -> { اطبع_سطر("رُفضت شهادة غير سليمة"); };
    أرجع 0;
}
