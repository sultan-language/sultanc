// مثال على أمان طبقة النقل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تي_إل_إس.إعداد;


عرف الرئيسية(): عدد {
    ليكن النطاق: نص = "example.test";
    ليكن الإعداد: إعداد_عميل_تي_إل_إس = إعداد_عميل_تي_إل_إس_افتراضي(&النطاق);
    إذا (!هل_تحقق_نظير_تي_إل_إس(&الإعداد)) { أرجع 1; };
    // خطر، ولخادم اختبار محلي لا يمكن التحقق من شهادته فقط: هذا الإعداد
    // يقبل أي خادم.
    ليكن غير_المتحقق: متغير إعداد_عميل_تي_إل_إس = إعداد_عميل_تي_إل_إس_افتراضي(&النطاق);
    عطل_تحقق_النظير_بلا_أمان_تي_إل_إس(&متغير غير_المتحقق);
    إذا (هل_تحقق_نظير_تي_إل_إس(&غير_المتحقق)) { أرجع 1; };
    اطبع_سطر("التحقق من هوية الطرف الآخر مفعّل");
    أرجع 0;
}
