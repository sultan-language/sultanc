// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف اجمع_حتى(ن: عدد): عدد { ليكن ف: متغير عدد = 1; ليكن المجموع: متغير عدد = 0; طالما (ف <= ن) { المجموع := المجموع + ف; ف := ف + 1; }; أرجع المجموع; }
عرف الرئيسية(): عدد {
    ليكن ف: متغير عدد = 1;
    طالما (ف <= 5) { تأكد(اجمع_حتى(ف) == (ف * (ف + 1) / 2)); ف := ف + 1; };
    اطبع_سطر("نجحت خمسة فحوص بمعاملات");
    أرجع 0;
}
