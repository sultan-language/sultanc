// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف خطوة_بالبذرة(ن: عدد): عدد { أرجع (ن * 1103515245 + 12345) & 65535; }
عرف الرئيسية(): عدد {
    دع الأول: عدد = خطوة_بالبذرة(17);
    دع الثاني: عدد = خطوة_بالبذرة(17);
    تأكد(الأول == الثاني);
    اطبع_سطر(عدد_إلى_نص(الأول));
    أرجع 0;
}
