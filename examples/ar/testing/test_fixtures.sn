// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف أنشئ_بيانات_الاختبار(): متجه عدد { أرجع [1, 2, 3, 4]; }
عرف الرئيسية(): عدد {
    دع العينة: متجه عدد = أنشئ_بيانات_الاختبار();
    تأكد(الطول(العينة) == 4);
    اطبع_سطر(عدد_إلى_نص(العينة[0]));
    أرجع 0;
}
