// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;


عرف الرئيسية(): عدد {
    دع المدخلات: متجه عدد = [1, 2, 3, 4];
    دع المتوقع: متجه عدد = [1, 4, 9, 16];
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المدخلات)) { تأكد(المدخلات[ف] * المدخلات[ف] == المتوقع[ف]); ف := ف + 1; };
    اطبع_سطر("نجحت أربع حالات");
    أرجع 0;
}
