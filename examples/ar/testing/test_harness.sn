// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف اختبر_الزوجي(ن: عدد): منطقي { أرجع ن % 2 == 0; }
عرف الرئيسية(): عدد {
    دع عدد_النجاح: متغير عدد = 0;
    إذا (اختبر_الزوجي(2)) { عدد_النجاح := عدد_النجاح + 1; };
    إذا (!اختبر_الزوجي(3)) { عدد_النجاح := عدد_النجاح + 1; };
    تأكد(عدد_النجاح == 2);
    اطبع_سطر(عدد_إلى_نص(عدد_النجاح));
    أرجع 0;
}
