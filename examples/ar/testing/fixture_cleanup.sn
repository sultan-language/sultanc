// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;


عرف الرئيسية(): عدد {
    دع القائمة_المتغيرة: متغير متجه عدد = [5, 6, 7];
    تأكد(الطول(القائمة_المتغيرة) == 3);
    القائمة_المتغيرة := [];
    تأكد(الطول(القائمة_المتغيرة) == 0);
    اطبع_سطر("نُظفت بيانات الاختبار");
    أرجع 0;
}
