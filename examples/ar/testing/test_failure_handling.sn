// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف حلل_موجبا(ن: عدد): نتيجة عدد, عدد { إذا (ن < 0) { أرجع نتيجة.خطأ(1); }; أرجع نتيجة.نجح(ن); }
عرف الرئيسية(): عدد {
    طابق حلل_موجبا(-1) مع
    | نتيجة.خطأ(رمز_الخروج) -> { تأكد(رمز_الخروج == 1); اطبع_سطر("تمت معالجة الخطأ"); }
    | نتيجة.نجح(_) -> { أرجع 1; };
    أرجع 0;
}
