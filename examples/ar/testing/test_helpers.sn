// مثال على الاختبارات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.تصحيح.تأكد;

عرف تحقق_من_الموجب(ن: عدد): فراغ { تأكد(ن > 0); }
عرف الرئيسية(): عدد {
    تحقق_من_الموجب(1);
    تحقق_من_الموجب(10);
    تحقق_من_الموجب(100);
    اطبع_سطر("نجحت الدوال المساعدة");
    أرجع 0;
}
