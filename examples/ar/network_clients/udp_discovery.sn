// رحلة UDP ذهابا وإيابا على الحلقة المحلية: يُربط مقبس ويوصل بعنوانه نفسه، ثم تُرسل ثلاثة
// بايتات وتُستقبل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.يو_دي_بي;

عرف الرئيسية(): عدد {
    ليكن عنوان_الاتصال: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&"127.0.0.1:40261") مع
    | نتيجة.نجح(أ) -> { عنوان_الاتصال := أ; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    ليكن المقبس: مقبس_يو_دي_بي;
    طابق اربط_يو_دي_بي(&عنوان_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { المقبس := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق وصل_يو_دي_بي(&المقبس, &عنوان_الاتصال) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    ليكن الحمولة: متجه ط8 = [65 مثل ط8, 66 مثل ط8, 67 مثل ط8];
    طابق أرسل_يو_دي_بي(&المقبس, &الحمولة, 0, 3) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != 3) { أرجع 4; };
    }
    | نتيجة.خطأ(_) -> { أرجع 5; };
    ليكن مخزن_بايتات: متغير متجه ط8 = [0 مثل ط8, 0 مثل ط8, 0 مثل ط8];
    طابق استقبل_يو_دي_بي(&المقبس, &متغير مخزن_بايتات, 0, 3) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != 3 || مخزن_بايتات[0] != 65 مثل ط8) { أرجع 6; };
    }
    | نتيجة.خطأ(_) -> { أرجع 7; };
    ليكن نتيجة_الإغلاق: نتيجة عدد, عدد = أغلق_يو_دي_بي(المقبس);
    اطبع_سطر("تراسل محلي عبر يو دي بي");
    أرجع 0;
}
