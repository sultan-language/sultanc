// تحويل اسم مضيف إلى عنوان مقبس IPv4: يُبحث عن localhost على المنفذ 8080.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.شبكة.أسماء_النطاقات;

عرف الرئيسية(): عدد {
    دع المضيف: نص = "localhost";
    طابق حل_اسم_مضيف4(&المضيف, 8080 مثل ط16) مع
    | نتيجة.نجح(_) -> {
        اطبع_سطر("تم حل اسم المضيف المحلي");
        أرجع 0;
    }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
