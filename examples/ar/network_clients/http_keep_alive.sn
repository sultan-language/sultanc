// طلب HTTP ورده عبر TCP على الحلقة المحلية، والعميل والخادم في برنامج واحد؛ يرسل الطرفان
// `Connection: close`، فلا يبقى الاتصال مفتوحا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.تي_سي_بي;
استورد المكتبة.نصوص.من_بايتات;

عرف الرئيسية(): عدد {
    دع عنوان_الاتصال: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&"127.0.0.1:40201") مع
    | نتيجة.نجح(أ) -> { عنوان_الاتصال := أ; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع مستمع_الاتصال: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي(&عنوان_الاتصال, 8) مع
    | نتيجة.نجح(المستمع_المؤقت) -> { مستمع_الاتصال := المستمع_المؤقت; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    دع عميل: تدفق_تي_سي_بي;
    طابق اتصل_تي_سي_بي(&عنوان_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { عميل := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    دع خادم: تدفق_تي_سي_بي;
    طابق اقبل_تي_سي_بي(&مستمع_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { خادم := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 4; };
    دع الطلب_المرسل: متجه ط8 = بايتات_من_نص("GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
    طابق اكتب_تي_سي_بي(&عميل, &الطلب_المرسل, 0, الطول(الطلب_المرسل)) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != الطول(الطلب_المرسل)) { أرجع 5; };
    }
    | نتيجة.خطأ(_) -> { أرجع 6; };
    دع البيانات_الواردة: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(الطلب_المرسل)) {
        ألحق(البيانات_الواردة, 0);
        ف := ف + 1;
    };
    طابق اقرأ_تي_سي_بي(&خادم, &متغير البيانات_الواردة, 0, الطول(الطلب_المرسل)) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != الطول(الطلب_المرسل)) { أرجع 7; };
    }
    | نتيجة.خطأ(_) -> { أرجع 8; };
    دع الجواب: متجه ط8 = بايتات_من_نص("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK");
    طابق اكتب_تي_سي_بي(&خادم, &الجواب, 0, الطول(الجواب)) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != الطول(الجواب)) { أرجع 9; };
    }
    | نتيجة.خطأ(_) -> { أرجع 10; };
    دع البيانات_المستلمة: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < الطول(الجواب)) {
        ألحق(البيانات_المستلمة, 0);
        ف := ف + 1;
    };
    طابق اقرأ_تي_سي_بي(&عميل, &متغير البيانات_المستلمة, 0, الطول(الجواب)) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != الطول(الجواب)) { أرجع 11; };
    }
    | نتيجة.خطأ(_) -> { أرجع 12; };
    إذا (الطول(البيانات_المستلمة) != الطول(الجواب)) { أرجع 13; };
    إذا (البيانات_المستلمة[0] != الجواب[0]) { أرجع 14; };
    دع إغلاق_الخادم: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(خادم);
    دع إغلاق_العميل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(عميل);
    دع إغلاق_المستمع: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(مستمع_الاتصال);
    اطبع_سطر(عدد_إلى_نص(الطول(البيانات_المستلمة)));
    أرجع 0;
}
