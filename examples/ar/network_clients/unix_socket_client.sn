// عميل مقبس نطاق يونكس: يتصل بمستمع في البرنامج نفسه، ويرسل "hello"، ويُفحص ما يقرؤه الخادم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.شبكة.يونكس;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.نصوص.من_بايتات;

عرف الرئيسية(): عدد {
    ليكن المسار: نص = "sultanc_unix_socket_client.sock";
    ليكن مستمع_الاتصال: مستمع_يونكس;
    طابق اربط_مستمع_يونكس(&المسار) مع
    | نتيجة.نجح(نص_صغير) -> { مستمع_الاتصال := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    ليكن عميل: تدفق_يونكس;
    طابق اتصل_يونكس(&المسار) مع
    | نتيجة.نجح(نص_صغير) -> { عميل := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    ليكن خادم: تدفق_يونكس;
    طابق اقبل_يونكس(&مستمع_الاتصال) مع
    | نتيجة.نجح(نص_صغير) -> { خادم := نص_صغير; }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    ليكن الرسالة: متجه ط8 = بايتات_من_نص("hello");
    طابق اكتب_يونكس(&عميل, &الرسالة, 0, 5) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != 5) { أرجع 4; };
    }
    | نتيجة.خطأ(_) -> { أرجع 5; };
    ليكن البيانات_المستلمة: متغير متجه ط8 = [0 مثل ط8, 0 مثل ط8, 0 مثل ط8, 0 مثل ط8, 0 مثل ط8];
    طابق اقرأ_يونكس(&خادم, &متغير البيانات_المستلمة, 0, 5) مع
    | نتيجة.نجح(ن) -> {
        إذا (ن != 5 || البيانات_المستلمة[0] != 104 مثل ط8) { أرجع 6; };
    }
    | نتيجة.خطأ(_) -> { أرجع 7; };
    ليكن أ: نتيجة عدد, عدد = أغلق_تدفق_يونكس(عميل);
    ليكن ب: نتيجة عدد, عدد = أغلق_تدفق_يونكس(خادم);
    ليكن ج: نتيجة عدد, عدد = أغلق_مستمع_يونكس(مستمع_الاتصال);
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 8; };
    اطبع_سطر("مقبس يونكس");
    أرجع 0;
}
