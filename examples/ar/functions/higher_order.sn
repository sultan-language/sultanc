// دوال تمرر كقيم: تحويل متجه وتصفيته وطيه.
استورد std.io.println;
استورد std.text.number;

عرف حول(القيم: &متجه عدد, د: دالة(عدد): عدد): متجه عدد {
    دع الناتج: متغير متجه عدد = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        ألحق(الناتج, د((*القيم)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف استبق(القيم: &متجه عدد, الاختبار: دالة(عدد): منطقي): متجه عدد {
    دع الناتج: متغير متجه عدد = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        لو (الاختبار((*القيم)[ف])) { ألحق(الناتج, (*القيم)[ف]); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اطو(القيم: &متجه عدد, البداية: عدد, ادمج: دالة(عدد, عدد): عدد): عدد {
    دع المجموع: متغير عدد = البداية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        المجموع := ادمج(المجموع, (*القيم)[ف]);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف مربع_العدد(القيمة: عدد): عدد { أرجع القيمة * القيمة; }
عرف زوجي(القيمة: عدد): منطقي { أرجع القيمة % 2 == 0; }
عرف اجمع_عددين(اليسار: عدد, اليمين: عدد): عدد { أرجع اليسار + اليمين; }

عرف الرئيسية(): عدد {
    دع الأعداد: متجه عدد = [1, 2, 3, 4, 5, 6];
    دع المربعات: متجه عدد = حول(&الأعداد, مربع_العدد);
    دع المربعات_الزوجية: متجه عدد = استبق(&المربعات, زوجي);
    اطبع_سطر(عدد_إلى_نص(اطو(&المربعات_الزوجية, 0, اجمع_عددين)));
    اطبع_سطر(طبيعي_إلى_نص(الطول(المربعات_الزوجية) مثل طبيعي));
    أرجع 0;
}
