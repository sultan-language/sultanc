// الدوال المجهولة تلتقط القيم المحيطة بها ويمكن إرجاعها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف أنشئ_جامعا(المقدار: عدد): دالة(عدد): عدد {
    أرجع دالة(القيمة: عدد): عدد -> القيمة + المقدار;
}

عرف الرئيسية(): عدد {
    ليكن أضف_عشرة: دالة(عدد): عدد = أنشئ_جامعا(10);
    ليكن أضف_اثنين: دالة(عدد): عدد = أنشئ_جامعا(2);
    ليكن المنحني: دالة(عدد): دالة(عدد): عدد = دالة(أ: عدد): دالة(عدد): عدد -> دالة(ب: عدد): عدد -> أ * ب;
    ليكن ثلاثة_أضعاف: دالة(عدد): عدد = المنحني(3);
    اطبع_سطر(عدد_إلى_نص(أضف_عشرة(5)));
    اطبع_سطر(عدد_إلى_نص(أضف_اثنين(أضف_عشرة(30))));
    اطبع_سطر(عدد_إلى_نص(ثلاثة_أضعاف(14)));
    أرجع 0;
}
