// مثال على الدوال.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف ضاعف(س: عدد): عدد { أرجع س * 2; }
عرف زد_واحدا(س: عدد): عدد { أرجع س + 1; }
عرف طبق(الدالة_الممررة: دالة(عدد): عدد, س: عدد): عدد { أرجع الدالة_الممررة(س); }

عرف الرئيسية(): عدد {
    دع دالة_الاستدعاء: دالة(عدد): عدد = ضاعف;
    دع الأول: عدد = طبق(دالة_الاستدعاء, 4);
    دع الثاني: عدد = طبق(زد_واحدا, الأول);
    اطبع_سطر(عدد_إلى_نص(الثاني));
    أرجع 0;
}
