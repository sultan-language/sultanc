// مثال على الدوال.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف زوجي(ن: عدد): منطقي { إذا (ن == 0) { أرجع صواب; }; أرجع فردي(ن - 1); }
عرف فردي(ن: عدد): منطقي { إذا (ن == 0) { أرجع خطأ; }; أرجع زوجي(ن - 1); }

عرف الرئيسية(): عدد {
    إذا (زوجي(7)) { اطبع_سطر("زوجي"); } وإلا { اطبع_سطر("فردي"); };
    أرجع 0;
}
