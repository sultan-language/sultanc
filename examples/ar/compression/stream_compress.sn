// مثال على الضغط وفك الضغط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ضغط.ديفليت;


عرف الرئيسية(): عدد {
    دع المصدر: متجه ط8 = بايتات_من_نص("aaaaaaaaaaaaaaa5");
    دع المضغوط: متجه ط8 = اضغط_ديفليت(&المصدر);
    طابق فك_ضغط_ديفليت(&المضغوط) مع
    | نتيجة.نجح(المستعاد) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(المستعاد) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
