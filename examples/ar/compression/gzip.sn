// ضغط بيانات متكررة بـgzip واستعادة الأصل.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.ضغط.جي_زيب;

عرف الرئيسية(): عدد {
    ليكن الوحدة: نص = "SultanC ";
    ليكن النص_الأصلي: نص = كرر_النص(&الوحدة, 50);
    ليكن الأصل_بايتات: متجه ط8 = بايتات_من_نص(استنسخ(&النص_الأصلي));
    ليكن المضغوط: متجه ط8 = اضغط_جي_زيب(&الأصل_بايتات);
    اطبع_سطر(طبيعي_إلى_نص(الطول(الأصل_بايتات) مثل طبيعي));
    إذا ((الطول(المضغوط) مثل طبيعي) < (الطول(الأصل_بايتات) مثل طبيعي)) { اطبع_سطر("المضغوط أصغر"); };
    طابق فك_ضغط_جي_زيب(&المضغوط) مع
    | نتيجة.نجح(المستعاد) -> {
        ليكن النص_المستعاد: نص = من_بايتات(&المستعاد);
        إذا (نصان_متساويان(&النص_المستعاد, &النص_الأصلي)) { اطبع_سطر("الاستعادة سليمة"); };
    }
    | نتيجة.خطأ(_) -> { اطبع_سطر("بيانات تالفة"); أرجع 1; };
    أرجع 0;
}
