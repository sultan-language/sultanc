// مثال على الضغط وفك الضغط.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ضغط.جي_زيب;


عرف الرئيسية(): عدد {
    دع المصدر: متجه ط8 = بايتات_من_نص("aaaaaaaaaaaaaaa0");
    دع المضغوط: متجه ط8 = اضغط_جي_زيب(&المصدر);
    طابق فك_ضغط_جي_زيب(&المضغوط) مع
    | نتيجة.نجح(المستعاد) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(المستعاد) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
