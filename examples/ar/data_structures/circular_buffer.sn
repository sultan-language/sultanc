// مخزن دائري من ثلاث خانات: تلتف الكتابات الخمس حوله، فلا تبقى إلا آخر ثلاث قيم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن الخلايا: متغير متجه عدد = [0, 0, 0];
    ليكن الكتابات: متجه عدد = [2, 4, 6, 8, 10];
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(الكتابات)) {
        الخلايا[ف % 3] := الكتابات[ف];
        ف := ف + 1;
    };
    ليكن المجموع_العام: عدد = الخلايا[0] + الخلايا[1] + الخلايا[2];
    إذا (المجموع_العام != 24) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع_العام));
    أرجع 0;
}
