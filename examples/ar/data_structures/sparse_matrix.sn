// مصفوفة متفرقة تُخزن فيها الخلايا غير الصفرية وحدها، مدخلات من (صف، عمود، قيمة).
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع مدخلة = { الصف: عدد, العمود: عدد, القيمة: عدد };

عرف الرئيسية(): عدد {
    ليكن المدخلات: متجه مدخلة = [{ الصف: 0, العمود: 1, القيمة: 7 }, { الصف: 3, العمود: 2, القيمة: 9 }];
    ليكن المجموع_العام: متغير عدد = 0;
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(المدخلات)) {
        المجموع_العام := المجموع_العام + المدخلات[ف].القيمة;
        ف := ف + 1;
    };
    إذا (المجموع_العام != 16) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع_العام));
    أرجع 0;
}
