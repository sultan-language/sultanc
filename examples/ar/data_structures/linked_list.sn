// قائمة مترابطة مفردة محفوظة في متجه: تُتبع روابط التالي من الرأس وتُجمع القيم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عقدة = { القيمة: عدد, التالي: عدد };

عرف الرئيسية(): عدد {
    ليكن العقد: متجه عقدة = [{ القيمة: 3, التالي: 1 }, { القيمة: 5, التالي: 2 }, { القيمة: 8, التالي: -1 }];
    ليكن الموضع: متغير عدد = 0;
    ليكن المجموع_العام: متغير عدد = 0;
    طالما (الموضع >= 0) {
        المجموع_العام := المجموع_العام + العقد[الموضع].القيمة;
        الموضع := العقد[الموضع].التالي;
    };
    إذا (المجموع_العام != 16) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع_العام));
    أرجع 0;
}
