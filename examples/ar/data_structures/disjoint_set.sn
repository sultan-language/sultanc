// مجموعات منفصلة (اتحاد وبحث) بروابط الآباء: يتصل عنصران متى اشتركا في الجذر نفسه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف اعثر_على_الجذر(الآباء: &متجه عدد, س: عدد): عدد {
    ليكن الموضع: متغير عدد = س;
    طالما ((*الآباء)[الموضع] != الموضع) {
        الموضع := (*الآباء)[الموضع];
    };
    أرجع الموضع;
}

عرف الرئيسية(): عدد {
    ليكن الآباء: متغير متجه عدد = [0, 1, 2, 3, 4];
    الآباء[1] := 0;
    الآباء[3] := 2;
    الآباء[4] := 3;
    إذا (اعثر_على_الجذر(&الآباء, 3) != اعثر_على_الجذر(&الآباء, 4)) { أرجع 1; };
    اطبع_سطر("متصل");
    أرجع 0;
}
