// قائمة مترابطة مزدوجة محفوظة في متجه: يُمشى فيها إلى الخلف من الذيل عبر روابط السابق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عقدة = { القيمة: عدد, السابق: عدد, التالي: عدد };

عرف الرئيسية(): عدد {
    ليكن العقد: متجه عقدة = [
        { القيمة: 2, السابق: -1, التالي: 1 },
        { القيمة: 4, السابق: 0, التالي: 2 },
        { القيمة: 6, السابق: 1, التالي: -1 }
    ];
    ليكن الموضع: متغير عدد = 2;
    ليكن المجموع_العام: متغير عدد = 0;
    طالما (الموضع >= 0) {
        المجموع_العام := المجموع_العام * 10 + العقد[الموضع].القيمة;
        الموضع := العقد[الموضع].السابق;
    };
    إذا (المجموع_العام != 642) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع_العام));
    أرجع 0;
}
