// شجرة AVL مخزنة في متجه من العقد: يُتحقق من توازن الجذر، أي ألا يزيد الفرق بين ارتفاعي
// شجرتيه الفرعيتين على واحد.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عقدة = { القيمة: عدد, الأيسر: عدد, الأيمن: عدد, الارتفاع: عدد };

عرف الرئيسية(): عدد {
    ليكن العقد: متجه عقدة = [
        { القيمة: 20, الأيسر: 1, الأيمن: 2, الارتفاع: 2 },
        { القيمة: 10, الأيسر: -1, الأيمن: -1, الارتفاع: 1 },
        { القيمة: 30, الأيسر: -1, الأيمن: -1, الارتفاع: 1 }
    ];
    ليكن الجذر: عقدة = العقد[0];
    ليكن الفرق_الحسابي: عدد = العقد[الجذر.الأيسر].الارتفاع - العقد[الجذر.الأيمن].الارتفاع;
    إذا (الفرق_الحسابي < -1 || الفرق_الحسابي > 1) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(الجذر.القيمة));
    أرجع 0;
}
