// رسم بياني بقوائم تجاور مضغوطة: مصفوفة واحدة للجيران وإزاحة لكل عقدة، فدرجة العقدة هي
// الفرق بين إزاحتين.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن الإزاحات: متجه عدد = [0, 2, 3, 5, 5];
    ليكن الجيران: متجه عدد = [1, 2, 2, 0, 3];
    ليكن العقدة: عدد = 2;
    ليكن درجة_العقدة: عدد = الإزاحات[العقدة + 1] - الإزاحات[العقدة];
    إذا (درجة_العقدة != 2) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(درجة_العقدة));
    أرجع 0;
}
