// شجرة بادئات محفوظة في متجه من العقد: تُتبع روابط الأبناء من الجذر، ويُتحقق من أن العقدة
// الأخيرة تنهي كلمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

نوع عقدة = { طرفية: منطقي, الأول: عدد, الثاني: عدد };

عرف الرئيسية(): عدد {
    دع العقد: متجه عقدة = [
        { طرفية: خطأ, الأول: 1, الثاني: 3 },
        { طرفية: خطأ, الأول: 2, الثاني: -1 },
        { طرفية: صواب, الأول: -1, الثاني: -1 },
        { طرفية: صواب, الأول: -1, الثاني: -1 }
    ];
    دع موجود_فعلا: منطقي = العقد[العقد[العقد[0].الأول].الأول].طرفية;
    إذا (!موجود_فعلا) { أرجع 1; };
    اطبع_سطر("تم العثور");
    أرجع 0;
}
