// قاعدة64 تحول البايتات إلى نص ثم تعيدها.
استورد std.io.println;
استورد std.text.from_bytes;
استورد std.encoding.base64;

عرف الرئيسية(): عدد {
    دع الرسالة: متجه ط8 = بايتات_من_نص("SultanC");
    دع المرمز: نص = رمز_قاعدة64(&الرسالة);
    اطبع_سطر(استنسخ(&المرمز));
    طابق فك_قاعدة64(&المرمز) مع
    | نتيجة.نجح(المفكوك) -> { اطبع_سطر(من_بايتات(&المفكوك)); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("قاعدة64 غير صالحة"); أرجع 1; };
    دع المعطوب: نص = "not*base64";
    طابق فك_قاعدة64(&المعطوب) مع
    | نتيجة.نجح(_) -> { اطبع_سطر("غير متوقع"); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("رُفض المدخل غير الصالح"); };
    أرجع 0;
}
