// مثال على ترميز البيانات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ترميز.دي_إي_آر;


عرف الرئيسية(): عدد {
    ليكن ترميز_دير: متجه ط8 = [48 مثل ط8, 3 مثل ط8, 2 مثل ط8, 1 مثل ط8, 5 مثل ط8];
    طابق اقرأ_جذر_دي_إي_آر(&ترميز_دير) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(العنصر) -> { اطبع_سطر("فُك ترميز العنصر الجذري"); };
    أرجع 0;
}
