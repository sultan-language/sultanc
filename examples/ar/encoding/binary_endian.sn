// مثال على ترميز البيانات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.بايتات.مؤشر;


عرف الرئيسية(): عدد {
    ليكن البايتات: متجه ط8 = [0x34, 0x12];
    ليكن المؤشر: متغير مؤشر_بايتات = أنشئ_مؤشر_بايتات(&البايتات);
    طابق اقرأ_ط16_صغير(&متغير المؤشر) مع
    | اختياري.موجود(ن) -> { اطبع_سطر(طبيعي_إلى_نص(ن مثل طبيعي)); }
    | اختياري.لا_شيء -> { أرجع 1; };
    أرجع 0;
}
