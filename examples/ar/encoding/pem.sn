// فك كتلة بي إي إم من بايتات يوتيف8.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.ترميز.بي_إي_إم;

عرف الرئيسية(): عدد {
    دع النص: نص = "-----BEGIN DATA-----\nYQ==\n-----END DATA-----\n";
    دع البيانات: متجه ط8 = بايتات_من_نص(النص);
    دع الكتل: متجه كتلة_بي_إي_إم = فك_بي_إي_إم(&البيانات);
    اطبع_سطر(طبيعي_إلى_نص(الطول(الكتل) مثل طبيعي));
    أرجع 0;
}
