// مثال على ترميز البيانات.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ترميز.يوتيف16;


عرف الرئيسية(): عدد {
    ليكن النص: نص = "SultanC";
    طابق نص_إلى_يوتيف16(&النص) مع
    | نتيجة.نجح(الوحدات) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(الوحدات) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
