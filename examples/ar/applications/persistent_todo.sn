// قائمة مهام محفوظة في ملف: تُكتب المهام ثم تُقرأ ويُعد عددها، ثم يُحذف الملف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    دع المسار: نص = "tasks.snc";
    دع المهام: نص = "[ ] نشر المترجم\n[x] كتابة الأمثلة\n";
    طابق اكتب_الملف(&المسار, &المهام) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع العدد: متغير عدد = 0;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        دع الأسطر: متجه نص = قسم_النص(&النص, &"\n");
        العدد := الطول(الأسطر) - 1;
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | _ -> { };
    إذا (العدد != 2) { أرجع 4; };
    اطبع_سطر(عدد_إلى_نص(العدد));
    أرجع 0;
}
