// مفهرس Markdown: يقسم مستندا إلى أسطر ويعد العناوين فيه.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.بحث;

عرف الرئيسية(): عدد {
    دع المستند: نص = "# المقدمة\nبعض المحتوى\n## التنفيذ\nالنص\n## الاختبارات\n";
    دع الأسطر: متجه نص = قسم_النص(&المستند, &"\n");
    دع العلامة: نص = "#";
    دع العناوين: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(الأسطر)) {
        إذا (يبدأ_بـ(&الأسطر[ف], &العلامة)) { العناوين := العناوين + 1; };
        ف := ف + 1;
    };
    إذا (العناوين != 3) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(العناوين));
    أرجع 0;
}
