// متتبع مصروفات: يجمع المصروفات كلها، ويجمع على حدة مصروفات تصنيف واحد.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;

نوع مصروف = { التصنيف: نص, السنتات: عدد };

عرف الرئيسية(): عدد {
    ليكن المصروفات: متجه مصروف = [
        { التصنيف: "طعام", السنتات: 1299 },
        { التصنيف: "سفر", السنتات: 450 },
        { التصنيف: "طعام", السنتات: 251 }
    ];
    ليكن المجموع: متغير عدد = 0;
    ليكن الطعام: متغير عدد = 0;
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(المصروفات)) {
        المجموع := المجموع + المصروفات[ف].السنتات;
        ليكن الصنف: نص = "طعام";
        إذا (نصان_متساويان(&المصروفات[ف].التصنيف, &الصنف)) {
            الطعام := الطعام + المصروفات[ف].السنتات;
        };
        ف := ف + 1;
    };
    إذا (المجموع != 2000 || الطعام != 1550) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المجموع));
    أرجع 0;
}
