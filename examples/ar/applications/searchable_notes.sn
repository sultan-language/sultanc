// ملاحظات قابلة للبحث: تُحفظ الملاحظات في ملف، ثم تُقرأ ويُبحث فيها عن كلمة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.قراءة_ملف;
استورد المكتبة.ملفات.تعديل;
استورد المكتبة.نصوص.بحث;

عرف الرئيسية(): عدد {
    دع المسار: نص = "notes.txt";
    دع النص: نص = "تستخدم سلطان سي نحوًا عربيًا\nيدعم المترجم البرامج الأصلية\n";
    طابق اكتب_الملف(&المسار, &النص) مع
    | نتيجة.نجح(_) -> { }
    | _ -> { أرجع 1; };
    دع موجود_فعلا: متغير منطقي = خطأ;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(الملاحظة) -> {
        دع الإبرة: نص = "المترجم";
        موجود_فعلا := يحتوي_نصا(&الملاحظة, &الإبرة);
    }
    | _ -> { أرجع 2; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.نجح(_) -> { }
    | _ -> { أرجع 3; };
    إذا (!موجود_فعلا) { أرجع 4; };
    اطبع_سطر("عُثر على ملاحظة مطابقة");
    أرجع 0;
}
