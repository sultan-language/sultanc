// مجدول مهام: يختار المهمة الأقرب موعدا.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;

نوع مهمة = { التسمية: نص, موعد_الاستحقاق: عدد };

عرف الرئيسية(): عدد {
    دع المهام: متجه مهمة = [
        { التسمية: "مراجعة", موعد_الاستحقاق: 19 },
        { التسمية: "بناء", موعد_الاستحقاق: 4 },
        { التسمية: "إصدار", موعد_الاستحقاق: 10 }
    ];
    دع الأقرب: متغير عدد = 999;
    دع المختار: متغير نص = "";
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المهام)) {
        إذا (المهام[ف].موعد_الاستحقاق < الأقرب) {
            الأقرب := المهام[ف].موعد_الاستحقاق;
            المختار := استنسخ(&المهام[ف].التسمية);
        };
        ف := ف + 1;
    };
    دع المتوقع: نص = "بناء";
    إذا (!نصان_متساويان(&المختار, &المتوقع)) { أرجع 1; };
    اطبع_سطر(المختار);
    أرجع 0;
}
