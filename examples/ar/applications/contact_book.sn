// دفتر جهات اتصال صغير: سجلات فيها اسم ورقم هاتف، ويُبحث فيها بالاسم.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;

نوع جهة_اتصال = { الاسم: نص, الهاتف: نص };

عرف الرئيسية(): عدد {
    دع جهات_الاتصال: متجه جهة_اتصال = [
        { الاسم: "سارة", الهاتف: "100" },
        { الاسم: "علي", الهاتف: "200" },
        { الاسم: "منى", الهاتف: "300" }
    ];
    دع المختار: متغير نص = "";
    دع الإبرة: نص = "علي";
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(جهات_الاتصال)) {
        إذا (نصان_متساويان(&جهات_الاتصال[ف].الاسم, &الإبرة)) {
            المختار := استنسخ(&جهات_الاتصال[ف].الهاتف);
        };
        ف := ف + 1;
    };
    إذا (الطول(المختار) != 3) { أرجع 1; };
    اطبع_سطر(المختار);
    أرجع 0;
}
