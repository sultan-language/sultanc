// مدير مخزون: يجد صنفا في المخزون باسمه ويزيد كميته.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;

نوع صنف = { الاسم: نص, الكمية: عدد };

عرف الرئيسية(): عدد {
    دع المخزون: متغير متجه صنف = [
        { الاسم: "ورق", الكمية: 10 },
        { الاسم: "أقلام", الكمية: 3 }
    ];
    دع الهدف: نص = "أقلام";
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المخزون)) {
        إذا (نصان_متساويان(&المخزون[ف].الاسم, &الهدف)) {
            المخزون[ف].الكمية := المخزون[ف].الكمية + 7;
        };
        ف := ف + 1;
    };
    إذا (المخزون[1].الكمية != 10) { أرجع 1; };
    اطبع_سطر(عدد_إلى_نص(المخزون[1].الكمية));
    أرجع 0;
}
