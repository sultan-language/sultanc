// مثال على المعرفات الفريدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.معرف_فريد.معرف_فريد;
استورد المكتبة.معرف_فريد.توليد;


عرف الرئيسية(): عدد {
    طابق معرف_فريد_عشوائي() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المعرف) -> { اطبع_سطر(نص_معرف_فريد(&المعرف)); };
    أرجع 0;
}
