// مثال على المعرفات الفريدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.معرف_فريد.معرف_فريد;

نوع حساب = { المعرف: معرّف_فريد, الاسم: نص };
عرف الرئيسية(): عدد {
    دع الحساب: حساب = { المعرف: معرف_فريد_صفري(), الاسم: "مثال" };
    اطبع_سطر(استنسخ(&الحساب.الاسم));
    اطبع_سطر(نص_معرف_فريد(&الحساب.المعرف));
    أرجع 0;
}
