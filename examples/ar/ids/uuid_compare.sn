// مثال على المعرفات الفريدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.معرف_فريد.معرف_فريد;


عرف الرئيسية(): عدد {
    دع الأول: معرّف_فريد = معرف_فريد_صفري();
    دع الثاني: معرّف_فريد = معرف_فريد_أقصى();
    إذا (!معرفان_فريدان_متساويان(&الأول,&الثاني)) { اطبع_سطر("معرّفات فريدة مختلفة"); } وإلا { أرجع 1; };
    أرجع 0;
}
