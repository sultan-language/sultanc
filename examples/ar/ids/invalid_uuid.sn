// مثال على المعرفات الفريدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.معرف_فريد.معرف_فريد;


عرف الرئيسية(): عدد {
    ليكن غير_صالح: نص = "invalid-uuid";
    طابق حلل_معرفا_فريدا(&غير_صالح) مع
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(_) -> { اطبع_سطر("رُفض معرّف فريد غير صالح"); };
    أرجع 0;
}
