// تحليل معرف فريد وقراءة إصداره وطباعة صيغته القياسية.
استورد std.io.println;
استورد std.text.number;
استورد std.uuid.uuid;

عرف الرئيسية(): عدد {
    دع النص: نص = "123E4567-E89B-12D3-A456-426614174000";
    طابق حلل_معرفا_فريدا(&النص) مع
    | نتيجة.نجح(المعرف) -> {
        اطبع_سطر(نص_معرف_فريد(&المعرف));
        اطبع_سطر(طبيعي_إلى_نص(إصدار_معرف_فريد(&المعرف)));
    }
    | نتيجة.خطأ(_) -> { اطبع_سطر("معرف فريد غير صالح"); أرجع 1; };
    دع الخاطئ: نص = "not-a-uuid";
    طابق حلل_معرفا_فريدا(&الخاطئ) مع
    | نتيجة.نجح(_) -> { اطبع_سطر("غير متوقع"); }
    | نتيجة.خطأ(_) -> { اطبع_سطر("رُفض المعرف غير الصالح"); };
    أرجع 0;
}
