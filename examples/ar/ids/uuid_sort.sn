// مثال على المعرفات الفريدة.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.معرف_فريد.معرف_فريد;


عرف الرئيسية(): عدد {
    ليكن الأول: معرّف_فريد = معرف_فريد_صفري();
    ليكن الأخير: معرّف_فريد = معرف_فريد_أقصى();
    اطبع_سطر(نص_معرف_فريد(&الأول));
    اطبع_سطر(نص_معرف_فريد(&الأخير));
    أرجع 0;
}
