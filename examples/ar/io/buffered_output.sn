// تخزين كتابات صغيرة كثيرة ثم إفراغها دفعة واحدة.
استورد المكتبة.دخ.كاتب_مؤقت;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.أعداد;

عرف الرئيسية(): عدد {
    ليكن كاتب: متغير كاتب_مخزن = أنشئ_كاتبا_مخزنا(256);
    ليكن ف: متغير عدد = 1;
    طالما (ف <= 3) {
        ليكن السطر: متجه ط8 = بايتات_من_نص(عدد_إلى_نص(ف));
        اكتب_مخزنا(&متغير كاتب, &السطر);
        ليكن سطر_جديد: متجه ط8 = [10];
        اكتب_مخزنا(&متغير كاتب, &سطر_جديد);
        ف := ف + 1;
    }
    طابق أفرغ_الكاتب_المخزن(&متغير كاتب) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(الرمز) -> { أرجع الرمز; };
    أرجع 0;
}
