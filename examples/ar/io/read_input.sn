// قراءة سطر من الإدخال القياسي. جرّب: echo نور | ./program
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.دخ.اقرأ_سطر;
استورد المكتبة.نصوص.تحويل;

عرف الرئيسية(): عدد {
    طابق اقرأ_السطر() مع
    | نتيجة.نجح(السطر) -> {
        ليكن الاسم: نص = قص_النص(&السطر);
        إذا (الطول(الاسم) == 0) {
            اطبع_سطر("لا يوجد مدخل");
        } وإلا {
            ليكن الأجزاء: متجه نص = ["أهلا يا ", الاسم];
            ليكن لا_شيء_نصي: نص = "";
            اطبع_سطر(صل_النصوص(&الأجزاء, &لا_شيء_نصي));
        };
    }
    | نتيجة.خطأ(_) -> { اطبع_سطر("لا يوجد مدخل"); };
    أرجع 0;
}
