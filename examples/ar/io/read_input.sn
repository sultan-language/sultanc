// قراءة سطر من الإدخال القياسي. جرّب: echo نور | ./program
استورد std.io.println;
استورد std.io.read_line;
استورد std.text.transform;

عرف الرئيسية(): عدد {
    طابق اقرأ_السطر() مع
    | نتيجة.نجح(السطر) -> {
        دع الاسم: نص = قص_النص(&السطر);
        لو (الطول(الاسم) == 0) {
            اطبع_سطر("لا يوجد مدخل");
        } وإلا {
            دع الأجزاء: متجه نص = ["أهلا يا ", الاسم];
            دع لا_شيء_نصي: نص = "";
            اطبع_سطر(صل_النصوص(&الأجزاء, &لا_شيء_نصي));
        };
    }
    | نتيجة.خطأ(_) -> { اطبع_سطر("لا يوجد مدخل"); };
    أرجع 0;
}
