// المسجل يكتب في الخطأ القياسي ويهمل الرسائل الأدنى من مستواه؛ وسجل_منسقا
// ينسق رسالته بالمكتبة.تنسيق.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.دخ.سجل;
استورد المكتبة.تنسيق.تنسيق;

عرف الرئيسية(): عدد {
    ليكن مسجل: مسجل = أنشئ_مسجلا(مستوى_سجل.معلومة());
    ليكن البدء: نص = "البدء";
    ليكن التفصيل: نص = "تفصيل مخفي";
    سجل(&مسجل, مستوى_سجل.معلومة(), &البدء);
    سجل(&مسجل, مستوى_سجل.تصحيح(), &التفصيل);
    ليكن الملف: نص = "data.csv";
    ليكن ك: نتيجة طبيعي, خطأ_تنسيق = سجل_منسقا(&مسجل, مستوى_سجل.تحذير(), «في {} {} صفا، {:.1}% منها فارغ», [قيمة_تنسيق.نص(&الملف), قيمة_تنسيق.عدد(1280), قيمة_تنسيق.ع64(43.75)]);
    اطبع_سطر("تم");
    أرجع 0;
}
