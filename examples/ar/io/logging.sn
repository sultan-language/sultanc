// المسجل يكتب في الخطأ القياسي ويهمل الرسائل الأدنى من مستواه؛ وسجل_منسقا
// ينسق رسالته بالمكتبة.تنسيق.
استورد std.io.println;
استورد std.io.log;
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع مسجل: مسجل = أنشئ_مسجلا(مستوى_سجل.معلومة());
    دع البدء: نص = "البدء";
    دع التفصيل: نص = "تفصيل مخفي";
    سجل(&مسجل, مستوى_سجل.معلومة(), &البدء);
    سجل(&مسجل, مستوى_سجل.تصحيح(), &التفصيل);
    دع الملف: نص = "data.csv";
    دع ك: نتيجة طبيعي, خطأ_تنسيق = سجل_منسقا(&مسجل, مستوى_سجل.تحذير(), «في {} {} صفا، {:.1}% منها فارغ», [قيمة_تنسيق.نص(&الملف), قيمة_تنسيق.عدد(1280), قيمة_تنسيق.ع64(43.75)]);
    اطبع_سطر("تم");
    أرجع 0;
}
