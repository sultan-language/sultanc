// مثال على ترميز يونيكود والمحارف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.تطبيع;


عرف الرئيسية(): عدد {
    دع النص: نص = "سَلام";
    طابق طبع_نص_يونيكود(&النص, صورة_تطبيع_يونيكود.إن_إف_سي()) مع
    | نتيجة.نجح(الناتج) -> { اطبع_سطر(الناتج); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
