// مثال على ترميز يونيكود والمحارف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.تطبيع;


عرف الرئيسية(): عدد {
    ليكن الدخل: نص = "é";
    طابق طبع_نص_يونيكود(&الدخل, صورة_تطبيع_يونيكود.إن_إف_دي()) مع
    | نتيجة.نجح(الناتج) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(الناتج) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
