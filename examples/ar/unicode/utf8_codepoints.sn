// مثال على ترميز يونيكود والمحارف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.طي_الحالة;


عرف الرئيسية(): عدد {
    دع الحرف: ط32 = 65 مثل ط32;
    دع المطوي: متجه ط32 = طي_حالة_الأحرف_يونيكود(الحرف);
    اطبع_سطر(طبيعي_إلى_نص(المطوي[0] مثل طبيعي));
    أرجع 0;
}
