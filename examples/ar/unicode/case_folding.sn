// مثال على ترميز يونيكود والمحارف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.طي_الحالة;


عرف الرئيسية(): عدد {
    ليكن النص: نص = "Straße";
    طابق طي_حالة_نص_يونيكود(&النص) مع
    | نتيجة.نجح(المطوي) -> { اطبع_سطر(المطوي); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
