// مثال على ترميز يونيكود والمحارف.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.يونيكود.عناقيد;


عرف الرئيسية(): عدد {
    ليكن النص: نص = "👩‍💻";
    طابق حدود_عناقيد_بايتات_يونيكود(&النص) مع
    | نتيجة.نجح(الحدود) -> { اطبع_سطر(طبيعي_إلى_نص(الطول(الحدود) مثل طبيعي)); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    أرجع 0;
}
