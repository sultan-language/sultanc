// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
عرف اجمع_قيمة(القيمة1: عدد, القيمة2: عدد): عدد {
    دع بايت_سداسي: غ8 = 0x2A;
    دع حقيقة: منطقي = صواب;
    لو (حقيقة && (بايت_سداسي == 42)) {
        أرجع القيمة1 + القيمة2;
    };
    أرجع 0;
}

عرف القلعة(): عدد {
    دع نص_يونيكود: نص = «SultanC»;
    لو (الطول(نص_يونيكود) == 0) { أرجع 1; };
    أرجع اجمع_قيمة(40, 2);
}
