// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: surface
// نظير: tests/en/torture/surface/control_adt_record.sn
نوع زوج_سطح = { يسار_سطح: عدد, يمين_سطح: عدد };
نوع اختيار_سطح = | فارغ_سطح | قيمة_زوج_سطح بنوع زوج_سطح;

عرف القلعة(): عدد {
    دع زوج: زوج_سطح = { يسار_سطح: 40, يمين_سطح: 2 };
    دع اختيار: اختيار_سطح = اختيار_سطح.قيمة_زوج_سطح(زوج);
    طابق اختيار مع
    | اختيار_سطح.فارغ_سطح -> { أرجع 1; }
    | اختيار_سطح.قيمة_زوج_سطح({ يسار_سطح: أ, يمين_سطح: ب }) -> {
        دع قيمة: متغير عدد = أ;
        بينما (قيمة < (أ + ب)) { قيمة := قيمة + 1; }
        أرجع قيمة;
    };
}
