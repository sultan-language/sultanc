// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: closures
عرف طبق(العملية: دالة(ص32): ص32, القيمة: ص32): ص32 {
    أرجع العملية(القيمة);
}

عرف القلعة(): ص32 {
    دع الأساس: ص32 = 40;
    دع أضف: دالة(ص32): ص32 = دالة(س: ص32): ص32 -> الأساس + س;
    أرجع طبق(أضف, 2);
}
