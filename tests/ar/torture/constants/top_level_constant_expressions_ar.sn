// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: constants
دع الأساس: عدد = 6 * 7;
دع المزاح: عدد = (5 << 3) | 2;
دع جاهز: منطقي = (الأساس == المزاح) && !خطأ;
دع المخزن: متغير عدد = الأساس + (10 % 8) - 2;

عرف القلعة(): عدد {
    لو (جاهز && المخزن == 42) {
        أرجع المخزن;
    };
    أرجع 0;
}
