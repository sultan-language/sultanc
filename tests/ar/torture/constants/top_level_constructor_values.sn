// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,riscv64-linux-gnu,i686-linux-gnu,wasm32-wasi
// خروج: 42
// تفاضلي: نعم
// فئة: constants
// نظير: tests/en/torture/constants/top_level_constructor_values.sn
// قيم على مستوى الوحدة تبنيها منشئات التعداد: بلا حمولة، وبحمولات ثابتة
// (أعداد ونص ومنشئ متداخل)، وقيم اختيارية، وقيمة تسمي أخرى. لا ثابت موسوم في
// MSIR، فكل قراءة تبني القيمة حيث تُقرأ، وترى كل خلفية والمفسر تعليمات نداء منشئ.
نوع لون = | أحمر | أخضر | أزرق;
نوع شكل = | دائرة بنوع ص32 | مربع بنوع (ص32, ص32) | ملون بنوع (لون, ص32) | فارغ;
نوع وسم = | مسمى بنوع نص | بلا_اسم;

ليكن المفضل: لون = لون.أخضر();
ليكن المماثل: لون = المفضل;
ليكن الدائرة: شكل = شكل.دائرة(20);
ليكن المربع: شكل = شكل.مربع(3, 2 * 2);
ليكن الملون: شكل = شكل.ملون(لون.أزرق(), 5);
ليكن الوسم: وسم = وسم.مسمى(«سلطان»);
ليكن الموجود: اختياري ص32 = اختياري.موجود(2);
ليكن الغائب: اختياري ص32 = اختياري.لا_شيء();

عرف نقاط_اللون(اللون: لون): ص32 {
    طابق اللون مع
    | لون.أخضر -> { أرجع 1; }
    | لون.أزرق -> { أرجع 0; }
    | لون.أحمر -> { أرجع 100; };
}

عرف الرئيسية(): ص32 {
    ليكن المجموع: متغير ص32 = نقاط_اللون(المفضل) + نقاط_اللون(المماثل);
    طابق الدائرة مع
    | شكل.دائرة(نصف_القطر) -> { المجموع := المجموع + نصف_القطر; }
    | _ -> { أرجع 1; };
    طابق المربع مع
    | شكل.مربع(العرض, الارتفاع) -> { المجموع := المجموع + العرض * الارتفاع; }
    | _ -> { أرجع 2; };
    طابق الملون مع
    | شكل.ملون(اللون, المقدار) -> {
        طابق اللون مع
        | لون.أزرق -> { المجموع := المجموع + المقدار; }
        | _ -> { أرجع 3; };
    }
    | _ -> { أرجع 4; };
    طابق الوسم مع
    | وسم.مسمى(النص) -> { المجموع := المجموع + (الطول(النص) مثل ص32) - 9; }
    | وسم.بلا_اسم -> { أرجع 5; };
    طابق الموجود مع
    | اختياري.موجود(القيمة) -> { المجموع := المجموع + القيمة; }
    | اختياري.لا_شيء -> { أرجع 6; };
    طابق الغائب مع
    | اختياري.موجود(_) -> { أرجع 7; }
    | اختياري.لا_شيء -> { };
    ليكن المحلي: لون = المفضل;
    إذا (نقاط_اللون(المحلي) != 1) { أرجع 8; };
    أرجع المجموع;
}
