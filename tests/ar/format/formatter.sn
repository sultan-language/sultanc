عرف ج(أ: عدد,
    ب: عدد): عدد { أرجع د(
        أ,
        ب); }
») != 0) { أرجع 11; };
    // التعليقات في كل موضع: رأس الملف، وعلى سطر وحده، ولاحقة (محاذاة)، وقبل
    // قوس إغلاق، وداخل قائمة معاملات، وبين أسطر إكمال، وفي أذرع مطابقة، وفي
    // سجل حرفي، وفي نهاية الملف.
    إذا (افحص_حالة(«// تعليق الرأس
استورد std.io.println;   // لاحق بعد الاستيراد


// قبل تصريح
عرف د(
    // داخل المعاملات
    س: عدد, // بعد معامل
    ص: عدد
): عدد {
        // أول الكتلة
    دع ع: عدد = س   // لاحق في إكمال
    // بين أسطر الإكمال
        + ص;
    طابق ع مع
    // قبل ذراع
    | 0 -> { أرجع 0; } // بعد ذراع
    | _ -> {
        أرجع ع;
        // قبل قوس إغلاق
    };
}
نوع نقطة = { أ: عدد, ب: عدد };
