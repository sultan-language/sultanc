// المنسق القانوني (compiler/format): الترتيب، والتعليقات في كل موضع، والنص
// العربي ومختلط الاتجاه، ولغتا الكلمات المحجوزة، وتساوي القوى، والتعديلات
// وتعديلات المدى، ورفض المصادر التي لا تُحلَّل معجميا أو نحويا. تُفحص كل حالة
// بثلاث طرق: ينسَّق المدخل إلى النص المتوقع، وينسَّق النص المتوقع إلى نفسه،
// وتعطي التعديلات المطبقة على المدخل النص المتوقع. والمنسق حتمي، وينسق النص
// المعطى له (مخزن محرر لم يُحفظ)، لا الملف الذي في مساره.

عرف المسار(): نص { أرجع «حالة.sn»; }

عرف نسق(النص: &نص): اختياري نص {
    دع الاسم: نص = المسار();
    طابق نسق_نص_مصدر(&الاسم, النص) مع
    | نتيجة_تنسيق.منسق(الناتج) -> { أرجع اختياري.موجود(الناتج); }
    | نتيجة_تنسيق.مرفوض(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف طبق_التعديلات(النص: &نص, التعديلات: &متجه تعديل_تنسيق): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعديلات) مثل طبيعي)) {
        دع التعديل: &تعديل_تنسيق = &(*التعديلات)[ف];
        ألحق_من(الناتج, النص, الموضع, (*التعديل).البداية - الموضع);
        ألحق_من(الناتج, &(*التعديل).النص, 0, الطول((*التعديل).النص) مثل طبيعي);
        الموضع := (*التعديل).النهاية;
        ف := ف + 1;
    }
    ألحق_من(الناتج, النص, الموضع, (الطول(*النص) مثل طبيعي) - الموضع);
    أرجع الناتج مثل نص;
}

عرف بالتعديلات(النص: &نص): اختياري نص {
    دع الاسم: نص = المسار();
    طابق تعديلات_تنسيق_نص(&الاسم, النص) مع
    | نتيجة_تعديلات_تنسيق.تعديلات(التعديلات) -> { أرجع اختياري.موجود(طبق_التعديلات(النص, &التعديلات)); }
    | نتيجة_تعديلات_تنسيق.مرفوضة(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف يساوي(أ: &اختياري نص, المتوقع: &نص): منطقي {
    طابق *أ مع
    | اختياري.موجود(ق) -> { أرجع نصان_متساويان(&ق, المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// 0 حين تصح الحالة، وإلا رقم الفحص الذي أخفق.
عرف افحص_حالة(المدخل: نص, المتوقع: نص): عدد {
    دع مرة: اختياري نص = نسق(&المدخل);
    إذا (!يساوي(&مرة, &المتوقع)) { أرجع 1; };
    دع مرتان: اختياري نص = نسق(&المتوقع);
    إذا (!يساوي(&مرتان, &المتوقع)) { أرجع 2; };
    دع بتعديلات: اختياري نص = بالتعديلات(&المدخل);
    إذا (!يساوي(&بتعديلات, &المتوقع)) { أرجع 3; };
    دع بلا_تعديلات: اختياري نص = بالتعديلات(&المتوقع);
    إذا (!يساوي(&بلا_تعديلات, &المتوقع)) { أرجع 4; };
    أرجع 0;
}

عرف مرفوض(المدخل: نص): منطقي {
    دع مرة: اختياري نص = نسق(&المدخل);
    طابق مرة مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    دع الاسم: نص = المسار();
    طابق تعديلات_تنسيق_نص(&الاسم, &المدخل) مع
    | نتيجة_تعديلات_تنسيق.تعديلات(_) -> { أرجع خطأ; }
    | نتيجة_تعديلات_تنسيق.مرفوضة(التشخيصات) -> { أرجع الطول(التشخيصات.التشخيصات) > 0; };
}

عرف الرئيسية(): عدد {
