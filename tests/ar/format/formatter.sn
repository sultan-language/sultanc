    دع مهرب: نص = "\u2067عزل\u2069";
    دع ‏علامة: عدد = قيمة;
    أرجع نص_مختلط;
}
») != 0) { أرجع 13; };
    // لغتا الكلمات المحجوزة في مصدر واحد، كل منهما كما كُتبت، وتهجئة مهجورة محفوظة.
    إذا (افحص_حالة(«def e(x: int): int {
    while (x>0) { return x; }
