    // حتمي: المدخل نفسه يعطي البايتات نفسها في كل تشغيل.
    دع العينة: نص = «عرف د(  س: عدد ):عدد{ // تعليق
أرجع س+1;
}»;
    دع الأول: نص;
    طابق نسق(&العينة) مع
    | اختياري.موجود(ق) -> { الأول := ق; }
    | اختياري.لا_شيء -> { أرجع 23; };
    دع التشغيل: متغير عدد = 0;
    طالما (التشغيل < 20) {
        دع مجددا: اختياري نص = نسق(&العينة);
        إذا (!يساوي(&مجددا, &الأول)) { أرجع 24; };
        التشغيل := التشغيل + 1;
    }
    // مخزن لم يُحفظ: يُنسَّق النص المعطى، لا الملف الذي على القرص في مساره، ويعمل
    // المسار غير الموجود بالطريقة نفسها.
    دع البادئة: نص = "fmt-buffer";
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 25; }
    | نتيجة.نجح(الدليل) -> {
        دع اسم_الملف: نص = "مخزن.sn";
        دع الملف: نص = صل_المسار(&الدليل, &اسم_الملف);
        دع على_القرص: نص = "عرف على_القرص(): عدد { أرجع 0; }\n";
        طابق اكتب_الملف(&الملف, &على_القرص) مع
        | نتيجة.خطأ(_) -> { أرجع 26; }
        | نتيجة.نجح(_) -> { };
        دع المخزن: نص = «عرف مخزن( ):عدد{
أرجع 1;
}»;
        دع المتوقع: نص = «عرف مخزن(): عدد {
    أرجع 1;
}
»;
        طابق نسق_نص_مصدر(&الملف, &المخزن) مع
        | نتيجة_تنسيق.منسق(الناتج) -> { إذا (!نصان_متساويان(&الناتج, &المتوقع)) { أرجع 27; }; }
        | نتيجة_تنسيق.مرفوض(_) -> { أرجع 28; };
        دع اسم_غائب: نص = "لم_يكتب.sn";
        دع الغائب: نص = صل_المسار(&الدليل, &اسم_غائب);
        طابق نسق_نص_مصدر(&الغائب, &المخزن) مع
        | نتيجة_تنسيق.منسق(الناتج) -> { إذا (!نصان_متساويان(&الناتج, &المتوقع)) { أرجع 29; }; }
        | نتيجة_تنسيق.مرفوض(_) -> { أرجع 30; };
        دع المحذوف: نتيجة عدد, عدد = احذف_الشجرة(&الدليل);
    };
    أرجع 0;
}
