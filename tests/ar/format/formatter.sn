}», «عرف ك(م: &خريطة<عدد, متجه *ط8>): عدد {
    إذا (أ<ب && ج > د && ز < 1) { أرجع 1; };
    أرجع -س * 2 + &ص;
}
») != 0) { أرجع 16; };
