    إذا (!مرفوض(«عرف د( { »)) { أرجع 20; };
    إذا (!مرفوض("عرف د(): نص { أرجع \"مفتوح; }")) { أرجع 21; };
    دع العزل: متغير متجه ط8 = بايتات_من_نص("// قبل ");
    ألحق(العزل, 0xE2 مثل ط8);
    ألحق(العزل, 0x81 مثل ط8);
    ألحق(العزل, 0xA7 مثل ط8);
    ألحق_بايتات_نص(&متغير العزل, " بعد\nعرف د(): عدد { أرجع 0; }\n");
