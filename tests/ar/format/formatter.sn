}
عرف د(س: عدد): عدد { بينما (س > 0) { أرجع e(س); } أرجع 0; }
») != 0) { أرجع 14; };
    // النص الحرفي متعدد الأسطر لا يُمس، داخله وبعد سطره الأول؛ وتصير نهايات
    // CRLF نهايات LF؛ وتزول المسافات اللاحقة.
    دع كرلف: متغير متجه ط8 = بايتات_من_نص("عرف ح(): نص {  \r\n");
    ألحق_بايتات_نص(&متغير كرلف, "أرجع «أ\r\n    ب  \r\n  ج»;\r\n}\r\n");
    دع كرلف_متوقع: متغير متجه ط8 = بايتات_من_نص("عرف ح(): نص {\n");
    ألحق_بايتات_نص(&متغير كرلف_متوقع, "    أرجع «أ\r\n    ب  \r\n  ج»;\n}\n");
    إذا (افحص_حالة(كرلف مثل نص, كرلف_متوقع مثل نص) != 0) { أرجع 15; };
    // المسافة التي اختارها المؤلف حيث لا تكفي الرموز: وسائط النوع، وبادئة بعد
    // اسم، والتعليقات اللاحقة المحاذاة.
    إذا (افحص_حالة(«عرف ك(م: &خريطة<عدد, متجه *ط8>): عدد {
    إذا (أ<ب && ج > د && ز<1) { أرجع 1; };
