// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,aarch64-windows-msvc,x86_64-android,aarch64-android,armv7-android,x86_64-freebsd,aarch64-freebsd,riscv64-freebsd,i686-linux-gnu,armv7-linux-gnueabihf,riscv64-linux-gnu,loongarch64-linux-gnu,mips64el-linux-gnuabi64,powerpc64le-linux-gnu,s390x-linux-gnu,sparcv9-linux-gnu,wasm32-wasi
// خروج: 42
// خرج-قياسي: b.txt,c.bin|llo|5|7
// تفاضلي: نعم
// نظير: tests/en/target/std_filesystem.sn
// std.fs on every target with a file system: directories, whole-file and
// handle I/O, seeking, metadata, renaming, listing and removal. The kernel
// records involved (stat, dirent, open flags, lseek) differ per OS and
// architecture.
استورد std.io.print;
استورد std.text.number;
استورد std.text.transform;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.fs.write_file;
استورد std.fs.write_bytes;
استورد std.fs.read_file;
استورد std.fs.mutation;
استورد std.fs.metadata;
استورد std.fs.directory;
استورد std.fs.handle;
استورد std.fs.path;
استورد std.collections.sort;

عرف أزل_بصمت(الدليل: &نص, الاسم: نص): فراغ {
    دع المسار: نص = صل_المسار(الدليل, &الاسم);
    طابق أزل_ملفا(&المسار) مع | _ -> { };
}

عرف الرئيسية(): عدد {
    دع الدليل: نص = "target-fs-test-ar.tmp";
    أزل_بصمت(&الدليل, "a.txt");
    أزل_بصمت(&الدليل, "b.txt");
    أزل_بصمت(&الدليل, "c.bin");
    طابق أزل_دليلا(&الدليل) مع | _ -> { };

    طابق أنشئ_دليلا(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };
    دع اسم_أ: نص = "a.txt";
    دع أ: نص = صل_المسار(&الدليل, &اسم_أ);
    دع اسم_ب: نص = "b.txt";
    دع ب: نص = صل_المسار(&الدليل, &اسم_ب);
    دع اسم_ج: نص = "c.bin";
    دع ج: نص = صل_المسار(&الدليل, &اسم_ج);
    دع المحتوى: نص = "hello";
    طابق اكتب_الملف(&أ, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> { };
    دع البايتات: متجه ط8 = [0, 1, 2, 255, 254, 253, 10];
    طابق اكتب_البايتات(&ج, &البايتات) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_الملف(&أ) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(النص) -> { إذا (!نصان_متساويان(&النص, &المحتوى)) { أرجع 5; }; };
    طابق اقرأ_بايتات_ملف(&ج) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(المقروء) -> {
        إذا (الطول(المقروء) != 7 || المقروء[3] != 255 || المقروء[6] != 10) { أرجع 7; };
    };
    طابق حاول_نوع_المسار(&الدليل) مع
    | نتيجة.نجح(نوع_مسار.دليل) -> { }
    | _ -> { أرجع 8; };

    طابق أعد_تسمية(&أ, &ب) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(_) -> { };
    طابق موجود(&أ) مع
    | نتيجة.نجح(خطأ) -> { }
    | _ -> { أرجع 10; };

    دع السطر: متغير متجه نص = [];
    طابق اقرأ_مدخلات_الدليل(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 11; }
    | نتيجة.نجح(المداخل) -> {
        دع الأسماء: متغير متجه نص = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            ألحق(الأسماء, استنسخ(&المداخل[ف].الاسم));
            ف := ف + 1;
        }
        رتب_نصوص(&متغير الأسماء);
        دع الفاصلة: نص = ",";
        ألحق(السطر, صل_النصوص(&الأسماء, &الفاصلة));
    };

    طابق افتح_مقبض_ملف_للقراءة(&ب) مع
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(المقبض) -> {
        طابق حرك_مقبض_ملف(&المقبض, 2, أصل_موضع_ملف.البداية()) مع
        | نتيجة.نجح(2) -> { }
        | _ -> { أرجع 13; };
        دع المخزن: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
        طابق اقرأ_من_مقبض_ملف(&المقبض, &متغير المخزن, 0, 8) مع
        | نتيجة.نجح(3) -> { }
        | _ -> { أرجع 14; };
        دع الثلاثة: متجه ط8 = [المخزن[0], المخزن[1], المخزن[2]];
        ألحق(السطر, من_بايتات(&الثلاثة));
        طابق أغلق_مقبض_ملف(المقبض) مع
        | نتيجة.خطأ(_) -> { أرجع 15; }
        | نتيجة.نجح(_) -> { };
    };
    طابق حجم_المسار(&ب) مع
    | نتيجة.نجح(الحجم) -> { ألحق(السطر, عدد_إلى_نص(الحجم)); }
    | نتيجة.خطأ(_) -> { أرجع 16; };
    طابق حجم_المسار(&ج) مع
    | نتيجة.نجح(الحجم) -> { ألحق(السطر, عدد_إلى_نص(الحجم)); }
    | نتيجة.خطأ(_) -> { أرجع 17; };

    طابق أزل_ملفا(&ب) مع
    | نتيجة.خطأ(_) -> { أرجع 18; }
    | نتيجة.نجح(_) -> { };
    طابق أزل_ملفا(&ج) مع
    | نتيجة.خطأ(_) -> { أرجع 19; }
    | نتيجة.نجح(_) -> { };
    طابق أزل_دليلا(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 20; }
    | نتيجة.نجح(_) -> { };
    طابق موجود(&الدليل) مع
    | نتيجة.نجح(خطأ) -> { }
    | _ -> { أرجع 21; };
    دع الخط: نص = "|";
    اطبع(صل_النصوص(&السطر, &الخط));
    أرجع 42;
}
