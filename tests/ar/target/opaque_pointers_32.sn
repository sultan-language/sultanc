// اختبار: تفاضلي
// أهداف: i686-linux-gnu,armv7-linux-gnueabihf,armv7-android
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/target/opaque_pointers_32.sn
// مؤشرات إلى نوع معتم على أهداف 32 بتا: المؤشر كلمة الهدف ذات 32 بتا، و`م مثل
// ط32` و`ك مثل *متغير T` كلمة العنوان في الاتجاهين، والتحويل بين المؤشرات
// الخام يحفظ العنوان.
استورد std.meta.reflect;

نوع قاعدة = معتم;
نوع حامل = { القاعدة: *قاعدة };

عرف افتح_عند(الكلمة: ط32): *قاعدة {
    غير_آمن { أرجع الكلمة مثل *قاعدة; };
}

عرف الرئيسية(): عدد {
    دع ق: *قاعدة = افتح_عند(4096);
    دع الحامل: حامل = { القاعدة: ق };
    دع المجموع: متغير عدد = 0;
    إذا (حجم_النوع(&الحامل) == 4 && محاذاة_النوع(&الحامل) == 4) { المجموع := المجموع + 10; };
    غير_آمن {
        دع الكلمة: ط32 = الحامل.القاعدة مثل ط32;
        دع للكتابة: *متغير قاعدة = الكلمة مثل *متغير قاعدة;
        دع بلا_نوع: *فراغ = للكتابة مثل *فراغ;
        دع العائد: *قاعدة = بلا_نوع مثل *قاعدة;
        إذا (الكلمة == 4096) { المجموع := المجموع + 10; };
        إذا (العائد == ق && (للكتابة مثل ط32) == الكلمة) { المجموع := المجموع + 22; };
    };
    أرجع المجموع;
}
