// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,aarch64-windows-msvc,x86_64-android,aarch64-android,armv7-android,x86_64-freebsd,aarch64-freebsd,riscv64-freebsd,i686-linux-gnu,armv7-linux-gnueabihf,riscv64-linux-gnu,loongarch64-linux-gnu,mips64el-linux-gnuabi64,powerpc64le-linux-gnu,s390x-linux-gnu,sparcv9-linux-gnu,wasm32-wasi
// خروج: 42
// خرج-قياسي: 10 20 30|second|a-b-c|7|-9223372036854775807|18446744073709551615
// تفاضلي: نعم
// نظير: tests/en/target/std_text_collections.sn
// std on every hosted target: standard output, text, numbers, vectors, a hash
// map and a B-tree map. The line printed is the same everywhere.
استورد std.io.print;
استورد std.text.number;
استورد std.text.transform;
استورد std.text.search;
استورد std.collections.map;
استورد std.collections.btree_map;
استورد std.collections.sort;

عرف قارن_أعدادا(اليسار: &عدد, اليمين: &عدد): عدد { أرجع *اليسار - *اليمين; }
عرف هاش_عدد(القيمة: &عدد): طبيعي { أرجع ((*القيمة) مثل طبيعي) * 2654435761; }
عرف عددان_متساويان(اليسار: &عدد, اليمين: &عدد): منطقي { أرجع *اليسار == *اليمين; }

عرف الرئيسية(): عدد {
    دع الدرجات: متغير خريطة_شجرة_بي<عدد, نص> = أنشئ_خريطة_شجرة_بي(قارن_أعدادا);
    أدرج_في_خريطة_شجرة_بي(&متغير الدرجات, 30, "third");
    أدرج_في_خريطة_شجرة_بي(&متغير الدرجات, 10, "first");
    أدرج_في_خريطة_شجرة_بي(&متغير الدرجات, 20, "second");
    دع المفاتيح: متجه عدد = مفاتيح_خريطة_شجرة_بي(&الدرجات);
    دع النصوص: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
        ألحق(النصوص, عدد_إلى_نص(المفاتيح[ف]));
        ف := ف + 1;
    }
    دع المسافة: نص = " ";
    دع السطر: متغير متجه نص = [];
    ألحق(السطر, صل_النصوص(&النصوص, &المسافة));
    دع المطلوب: عدد = 20;
    طابق ابحث_في_خريطة_شجرة_بي(&الدرجات, &المطلوب) مع
    | اختياري.موجود(الاسم) -> { ألحق(السطر, الاسم); }
    | اختياري.لا_شيء -> { أرجع 1; };

    دع القائمة: نص = "a,b,c";
    دع الفاصلة: نص = ",";
    دع الأجزاء: متجه نص = قسم_النص(&القائمة, &الفاصلة);
    دع الشرطة: نص = "-";
    ألحق(السطر, صل_النصوص(&الأجزاء, &الشرطة));

    // A hash map with enough keys to grow several times.
    دع العدادات: متغير الخريطة<عدد, عدد> = أنشئ_الخريطة(هاش_عدد, عددان_متساويان);
    دع ك: متغير عدد = 0;
    طالما (ك < 500) {
        أدرج_في_الخريطة(&متغير العدادات, ك % 7, ك);
        ك := ك + 1;
    }
    ألحق(السطر, عدد_إلى_نص(طول_الخريطة(&العدادات) مثل عدد));

    // 64-bit text conversion, both directions.
    دع الأدنى: نص = "-9223372036854775807";
    دع الأعلى: نص = "18446744073709551615";
    طابق حلل_عدد(&الأدنى) مع
    | نتيجة.نجح(ق) -> { ألحق(السطر, عدد_إلى_نص(ق)); }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق حلل_طبيعي(&الأعلى) مع
    | نتيجة.نجح(ق) -> { ألحق(السطر, طبيعي_إلى_نص(ق)); }
    | نتيجة.خطأ(_) -> { أرجع 3; };

    دع الأعداد: متغير متجه عدد = [5, -3, 9, 0, 2];
    رتب_عدد(&متغير الأعداد);
    إذا (الأعداد[0] != -3 || الأعداد[4] != 9) { أرجع 4; };
    دع العبارة: نص = "cross-compiled";
    دع الجزء: نص = "comp";
    إذا (!يحتوي_نصا(&العبارة, &الجزء)) { أرجع 5; };

    دع الخط: نص = "|";
    اطبع(صل_النصوص(&السطر, &الخط));
    أرجع 42;
}
