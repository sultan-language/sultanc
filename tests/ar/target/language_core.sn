// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,aarch64-windows-msvc,x86_64-android,aarch64-android,armv7-android,x86_64-freebsd,aarch64-freebsd,riscv64-freebsd,i686-linux-gnu,armv7-linux-gnueabihf,riscv64-linux-gnu,riscv32-unknown-elf,wasm32-wasi,wasm32-browser,wasm64-unknown-unknown,amdgcn-amd-amdhsa,avr-unknown-unknown,bpfel-unknown-none,hexagon-unknown-elf,lanai-unknown-unknown,loongarch64-linux-gnu,mips64el-linux-gnuabi64,msp430-unknown-elf,nvptx64-nvidia-cuda,powerpc64le-linux-gnu,sparcv9-linux-gnu,spirv64-unknown-unknown,s390x-linux-gnu,ve-linux-gnu,xcore-unknown-unknown,thumbv6m-none-eabi,thumbv7m-none-eabi,thumbv7em-none-eabi,thumbv7em-none-eabihf
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/target/language_core.sn
// The language core with no OS service, on all 38 targets: records, tagged
// unions, matches, generics, loops, narrowing casts and integer arithmetic of
// every width, including 64-bit division on 8-, 16- and 32-bit machines.
// Freestanding targets compile it to an object (assembly for nvptx64 and
// xcore); hosted targets run it.

نوع نقطة = { س: ص64, ص: ص64 };
نوع شكل =
    | دائرة بنوع ص64
    | مستطيل بنوع نقطة
    | فارغ
;

عرف المساحة(الشكل: شكل): ص64 {
    طابق الشكل مع
    | شكل.دائرة(نق) -> { أرجع 3 * نق * نق; }
    | شكل.مستطيل(ن) -> { أرجع ن.س * ن.ص; }
    | شكل.فارغ -> { أرجع 0; };
}

عرف الأكبر<ن>(أ: ن, ب: ن, أ_يفوز: منطقي): ن {
    إذا (أ_يفوز) { أرجع أ; };
    أرجع ب;
}

// Wide division and remainder by values the optimizer cannot fold.
عرف افحص_القسمة(المقسوم: ط64, المقسوم_عليه: ط64): منطقي {
    دع خ: ط64 = المقسوم / المقسوم_عليه;
    دع ب: ط64 = المقسوم % المقسوم_عليه;
    أرجع (خ * المقسوم_عليه) + ب == المقسوم && ب < المقسوم_عليه;
}

عرف افحص_القسمة_الموقعة(المقسوم: ص64, المقسوم_عليه: ص64): منطقي {
    دع خ: ص64 = المقسوم / المقسوم_عليه;
    دع ب: ص64 = المقسوم % المقسوم_عليه;
    أرجع (خ * المقسوم_عليه) + ب == المقسوم;
}

// Checked 64-bit products at the edge of the range; none overflows.
عرف افحص_الضرب(أ: ص64, ب: ط64): منطقي {
    دع أدنى_ناتج: ص64 = (أ * 2) * 2;
    دع أعلى_ناتج: ص64 = (أ + 1) * -4 * -1;
    دع ناتج_طبيعي: ط64 = (ب - 1) * (ب + 1);
    دع المربع: ط64 = (ب / 2) * (ب / 2);
    أرجع أدنى_ناتج == -9223372036854775807 - 1
        && أعلى_ناتج == -9223372036854775804
        && ناتج_طبيعي == 18446744073709551615
        && المربع == 4611686018427387904;
}

عرف المجموع_التحققي(الحد: ط32): ط32 {
    دع المجموع: متغير ط32 = 0;
    دع ف: متغير ط32 = 1;
    طالما (ف <= الحد) {
        المجموع := ((المجموع * 31) + (ف ^ 0x5a5a)) % 1000003;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع أ: ص64 = المساحة(شكل.دائرة(2));
    دع ن: نقطة = { س: 6, ص: 7 };
    دع ب: ص64 = المساحة(شكل.مستطيل(ن));
    إذا (أ != 12 || ب != 42) { أرجع 1; };
    إذا (المساحة(شكل.فارغ()) != 0) { أرجع 2; };
    إذا (الأكبر(5, 9, خطأ) != 9) { أرجع 3; };

    دع الكبير: ط64 = 18446744073709551557;
    دع ف: متغير ط64 = 1;
    طالما (ف < 1000000007) {
        إذا (!افحص_القسمة(الكبير, ف)) { أرجع 4; };
        إذا (!افحص_القسمة_الموقعة(-9223372036854775807, ف مثل ص64)) { أرجع 5; };
        ف := (ف * 7) + 3;
    }
    دع س: ص64 = -7;
    إذا (س / 2 != -3 || س % 2 != -1) { أرجع 6; };
    إذا ((الكبير >> 60) != 15 || (1 مثل ط64 << 63) != 9223372036854775808) { أرجع 7; };
    دع الصغير: ص8 = -128;
    دع الموسع: ص64 = الصغير مثل ص64;
    إذا (الموسع != -128) { أرجع 8; };
    دع الملتف: ط8 = (300 مثل ط16) مثل ط8;
    إذا (الملتف != 44) { أرجع 9; };
    إذا (المجموع_التحققي(1000) != المجموع_التحققي(1000)) { أرجع 10; };
    إذا (المجموع_التحققي(10) != 87209) { أرجع 11; };
    إذا (!افحص_الضرب(-2305843009213693952, 4294967296)) { أرجع 12; };
    أرجع 42;
}
