// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,i686-linux-gnu,riscv64-linux-gnu,wasm32-wasi
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/target/patterns_core.sn
// صيغ الأنماط على كل هدف مستضاف، الأصلي وLLVM، بثنائية 32 و64: بدائل تربط أسماء
// داخل حمولات داخل صفوف، وحراس على البدائل، و`مثل` حول البدائل، واختصار حقول السجل
// ببعض الحقول، وأنماط المتجهات مع الحراس وبقية مسماة.
نوع شكل = | دائرة بنوع ص64 | مربع بنوع ص64 | خط بنوع (ص64, ص64) | نقطة;
نوع مقاس = { العرض: ص64, الارتفاع: ص64, العمق: ص64 };

عرف متداخل(ز: (اختياري شكل, ص64)): ص64 {
    طابق ز مع
    | (اختياري.موجود(شكل.دائرة(ن) | شكل.خط(ن, _)), 1 | 2) -> { أرجع ن; }
    | (اختياري.موجود(شكل.مربع(ن)), ك) إذا ن > ك -> { أرجع ن - ك; }
    | (اختياري.موجود(_), _) -> { أرجع 100; }
    | (اختياري.لا_شيء, ك) -> { أرجع ك; };
}

عرف رمز_الشكل(ش: شكل): ص64 {
    طابق ش مع
    | شكل.دائرة(_) -> { أرجع 1; }
    | شكل.مربع(_) -> { أرجع 2; }
    | شكل.خط(_, _) -> { أرجع 3; }
    | شكل.نقطة -> { أرجع 4; };
}

عرف مسمى(ش: شكل): ص64 {
    طابق ش مع
    | شكل.دائرة(_) | شكل.مربع(_) مثل الدائري_أو_المربع -> { أرجع 10 * رمز_الشكل(الدائري_أو_المربع); }
    | (شكل.خط(أ, ب)) مثل الخط إذا أ == ب -> { أرجع رمز_الشكل(الخط); }
    | _ -> { أرجع 0; };
}

عرف المساحة(م: مقاس): ص64 {
    طابق م مع
    | { العرض, الارتفاع: 0 } -> { أرجع العرض; }
    | { العرض, الارتفاع } -> { أرجع العرض * الارتفاع; };
}

عرف مجموع(ش: [] ص64): ص64 {
    ليكن المجموع: متغير ص64 = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) { المجموع := المجموع + ش[ف]; ف := ف + 1; }
    أرجع المجموع;
}

عرف تسلسل(م: متجه ص64): ص64 {
    طابق م مع
    | [] -> { أرجع 0; }
    | [س, بقية الذيل] إذا س > 5 -> { أرجع س + مجموع(الذيل); }
    | [بقية _, الأخير] -> { أرجع الأخير; };
}

عرف الرئيسية(): ص64 {
    إذا (متداخل((اختياري.موجود(شكل.خط(7, 1)), 2)) != 7) { أرجع 1; };
    إذا (متداخل((اختياري.موجود(شكل.مربع(9)), 4)) != 5) { أرجع 2; };
    إذا (متداخل((اختياري.موجود(شكل.مربع(3)), 4)) != 100) { أرجع 3; };
    إذا (متداخل((اختياري.لا_شيء(), 6)) != 6) { أرجع 4; };
    إذا (مسمى(شكل.مربع(1)) != 20 || مسمى(شكل.خط(2, 2)) != 3 || مسمى(شكل.خط(1, 2)) != 0) { أرجع 5; };
    ليكن مسطح: مقاس = { العرض: 6, الارتفاع: 0, العمق: 1 };
    ليكن علبة: مقاس = { العرض: 2, الارتفاع: 3, العمق: 1 };
    إذا (المساحة(مسطح) != 6 || المساحة(علبة) != 6) { أرجع 6; };
    ليكن فارغ: متجه ص64 = [];
    ليكن كبير: متجه ص64 = [10, 1, 2];
    ليكن صغير: متجه ص64 = [1, 2, 3];
    إذا (تسلسل(فارغ) != 0 || تسلسل(كبير) != 13 || تسلسل(صغير) != 3) { أرجع 7; };
    أرجع 42;
}
