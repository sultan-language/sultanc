// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,aarch64-windows-msvc,x86_64-android,aarch64-android,armv7-android,x86_64-freebsd,aarch64-freebsd,riscv64-freebsd,i686-linux-gnu,armv7-linux-gnueabihf,riscv64-linux-gnu,loongarch64-linux-gnu,mips64el-linux-gnuabi64,powerpc64le-linux-gnu,s390x-linux-gnu,sparcv9-linux-gnu
// خروج: 42
// خرج-قياسي: 500500|5050|8
// Counterpart: tests/en/target/std_threads.sn
// (no pair directive: the interpreter runs one OS thread and stops at a spawn).
// std.thread and std.sync on every target with OS threads (not wasm32-wasi):
// threads that return values, a channel fed by several producers, and a
// mutex. Thread creation (clone and its per-architecture argument order,
// thr_new, the thread pointer), futex waits and atomics are per OS and
// architecture.
استورد std.io.print;
استورد std.text.number;
استورد std.text.transform;
استورد std.thread.thread;
استورد std.sync.channel;
استورد std.sync.mutex;
استورد std.sync.arc;

عرف اجمع_المدى(الأول: ط64, الأخير: ط64): ط64 {
    دع المجموع: متغير ط64 = 0;
    دع ف: متغير ط64 = الأول;
    طالما (ف <= الأخير) { المجموع := المجموع + ف; ف := ف + 1; }
    أرجع المجموع;
}

عرف أنتج(المرسل: &مرسل<ص64>, الأول: ص64): فراغ {
    دع ف: متغير ص64 = الأول;
    طالما (ف < الأول + 25) {
        طابق أرسل(المرسل, ف) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        ف := ف + 1;
    }
}

عرف أطلق_منتجا(المرسل: مرسل<ص64>, الأول: ص64): اختياري مقبض_خيط {
    طابق أطلق(دالة(): فراغ -> أنتج(&المرسل, الأول)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف زد_واحدا(القيمة: &متغير ط64): ط64 { *القيمة := *القيمة + 1; أرجع *القيمة; }

عرف ارفع(العداد: &مشترك<قفل<ط64>>): فراغ {
    دع ق: &قفل<ط64> = اقرأ_مشترك(العداد);
    دع متجاهل: ط64 = نفذ_مع_القفل(ق, زد_واحدا);
}

عرف أطلق_رافعا(العداد: &مشترك<قفل<ط64>>): اختياري مقبض_خيط {
    دع نسختي: مشترك<قفل<ط64>> = استنسخ_مشترك(العداد);
    طابق أطلق(دالة(): فراغ -> ارفع(&نسختي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    // Four threads each sum a quarter of 1..1000 and return it.
    دع المقابض: متغير متجه مقبض_خيط_بقيمة<ط64> = [];
    دع ر: متغير ط64 = 0;
    طالما (ر < 4) {
        دع الأول: ط64 = (ر * 250) + 1;
        طابق أطلق_بقيمة(دالة(): ط64 -> اجمع_المدى(الأول, الأول + 249)) مع
        | نتيجة.نجح(م) -> { ألحق(المقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ر := ر + 1;
    }
    دع المجموع: متغير ط64 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        طابق انضم_بقيمة(&متغير المقابض[ف]) مع
        | اختياري.موجود(الجزء) -> { المجموع := المجموع + الجزء; }
        | اختياري.لا_شيء -> { أرجع 2; };
        ف := ف + 1;
    }

    // Four producers send 1..100 over one channel.
    دع المستلم: مستلم<ص64> = مستلم_قناة();
    دع المنتجون: متغير متجه مقبض_خيط = [];
    دع ن: متغير ص64 = 0;
    طالما (ن < 4) {
        طابق أطلق_منتجا(مرسل_لمستلم(&المستلم), (ن * 25) + 1) مع
        | اختياري.موجود(م) -> { ألحق(المنتجون, م); }
        | اختياري.لا_شيء -> { أرجع 3; };
        ن := ن + 1;
    }
    دع المستلَم: متغير ص64 = 0;
    دع ع: متغير ص64 = 0;
    طالما (ع < 100) {
        طابق استقبل(&المستلم) مع
        | نتيجة.نجح(ق) -> { المستلَم := المستلَم + ق; }
        | نتيجة.خطأ(_) -> { أرجع 4; };
        ع := ع + 1;
    }
    ف := 0;
    طالما (ف < 4) { انضم(&متغير المنتجون[ف]); ف := ف + 1; }

    // Eight threads increment one mutex-protected counter.
    دع العداد: مشترك<قفل<ط64>> = أنشئ_مشترك(أنشئ_قفل(0 مثل ط64));
    دع الرافعون: متغير متجه مقبض_خيط = [];
    ف := 0;
    طالما (ف < 8) {
        طابق أطلق_رافعا(&العداد) مع
        | اختياري.موجود(م) -> { ألحق(الرافعون, م); }
        | اختياري.لا_شيء -> { أرجع 5; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < 8) { انضم(&متغير الرافعون[ف]); ف := ف + 1; }
    دع العدد_النهائي: ط64 = نفذ_مع_القفل(اقرأ_مشترك(&العداد), اقرأ_كما_هي);

    دع السطر: متجه نص = [طبيعي_إلى_نص(المجموع مثل طبيعي), عدد_إلى_نص(المستلَم مثل عدد),
        طبيعي_إلى_نص(العدد_النهائي مثل طبيعي)];
    دع الخط: نص = "|";
    اطبع(صل_النصوص(&السطر, &الخط));
    أرجع 42;
}

عرف اقرأ_كما_هي(القيمة: &متغير ط64): ط64 { أرجع *القيمة; }
