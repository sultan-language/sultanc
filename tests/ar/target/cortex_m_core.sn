// اختبار: تفاضلي
// أهداف: x86_64-linux,thumbv6m-none-eabi,thumbv7m-none-eabi,thumbv7em-none-eabi,thumbv7em-none-eabihf
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/target/cortex_m_core.sn
// What the Cortex-M targets do without a run-time library: 64-bit products
// and variable 64-bit shifts (ARMv6-M has neither a 32 x 32 -> 64 multiply
// nor 64-bit shifts, so the backend expands them instead of calling
// __aeabi_lmul, __aeabi_llsl and __aeabi_llsr), 8- and 16-bit arithmetic,
// and 32-bit atomic loads, stores and fences (LDR/STR with DMB; ARMv6-M has
// no read-modify-write atomics). tools/tests/cortex_m_tests.sh links and
// runs it under qemu-system-arm.
استورد std.sync.atomic;

عرف الناتج(أ: ط64, ب: ط64): ط64 { أرجع أ * ب; }
عرف الناتج_الموقع(أ: ص64, ب: ص64): ص64 { أرجع أ * ب; }
عرف يسارا(أ: ط64, ن: ط64): ط64 { أرجع أ << ن; }
عرف يمينا(أ: ط64, ن: ط64): ط64 { أرجع أ >> ن; }

// Products and shifts by values the optimizer cannot fold; none overflows.
عرف افحص_العريض(البذرة: ط64): منطقي {
    دع أ: ط64 = البذرة * 2654435761 + 12345;
    دع ب: ط64 = (البذرة << 7) + 977;
    دع ج: ط64 = الناتج(أ, ب);
    إذا (ج / ب != أ || ج % ب != 0 || ج != الناتج(ب, أ)) { أرجع خطأ; };
    دع ن: متغير ط64 = 0;
    طالما (ن < 21) {
        إذا (يمينا(يسارا(أ, ن), ن) != أ) { أرجع خطأ; };
        ن := ن + 1;
    }
    طالما (ن < 64) {
        إذا (يمينا(يسارا(1, ن), ن) != 1) { أرجع خطأ; };
        إذا (يسارا(1, ن) != الناتج(يسارا(1, ن / 2), يسارا(1, ن - (ن / 2)))) { أرجع خطأ; };
        ن := ن + 1;
    }
    أرجع صواب;
}

عرف افحص_الضيق(أ: ط8, ب: ط16): منطقي {
    دع ج: ط8 = أ + 55;
    دع د: ط16 = ب * 200;
    أرجع ج == 255 && د == 60000;
}

عرف الرئيسية(): عدد {
    إذا (الناتج(4294967295, 4294967297) != 18446744073709551615) { أرجع 1; };
    إذا (الناتج_الموقع(-3037000499, 3037000499) != -9223372030926249001) { أرجع 2; };
    إذا (يسارا(1, 40) != 1099511627776 || يمينا(1099511627776, 40) != 1) { أرجع 3; };
    إذا (يمينا(18446744073709551615, 63) != 1 || يسارا(3, 62) != 13835058055282163712) { أرجع 4; };
    دع البذرة: متغير ط64 = 1;
    طالما (البذرة < 2000) {
        إذا (!افحص_العريض(البذرة)) { أرجع 5; };
        البذرة := البذرة * 3 + 1;
    }
    إذا (!افحص_الضيق(200, 300)) { أرجع 6; };
    دع الخلية: ذرة_ط32 = أنشئ_ذرة_ط32(7);
    اخزن_ط32(&الخلية, 40, ترتيب_ذاكرة.تسلسلي());
    سياج_ذاكرة(ترتيب_ذاكرة.تسلسلي());
    دع ق: ط32 = احمل_ط32(&الخلية, ترتيب_ذاكرة.اكتساب());
    إذا (ق != 40) { أرجع 7; };
    أرجع (ق + 2) مثل عدد;
}
