// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,x86_64-darwin,x86_64-windows-msvc,aarch64-windows-msvc,x86_64-android,aarch64-android,armv7-android,x86_64-freebsd,aarch64-freebsd,riscv64-freebsd,i686-linux-gnu,armv7-linux-gnueabihf,riscv64-linux-gnu,loongarch64-linux-gnu,mips64el-linux-gnuabi64,powerpc64le-linux-gnu,s390x-linux-gnu,sparcv9-linux-gnu
// خروج: 42
// خرج-قياسي: tcp ping/pong|udp 6
// تفاضلي: نعم
// نظير: tests/en/target/std_sockets.sn
// Loopback TCP and UDP on every target with sockets (WASI has preopened
// sockets only). The socket type and option constants, the sockaddr_in
// layout and its byte order, and the system calls (socketcall is not used on
// i686) differ per OS and architecture: MIPS numbers SOCK_STREAM 2 and
// SOL_SOCKET 0xffff, s390x and SPARC are big-endian.
استورد std.net.socket_address;
استورد std.net.tcp;
استورد std.net.udp;
استورد std.net.options;
استورد std.io.print;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.text.transform;

عرف ذهاب_وإياب_تي_سي_بي(): اختياري نص {
    دع النص: نص = "127.0.0.1:38641";
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(العنوان) -> {
        دع الخيارات: متجه خيار_مقبس = [خيار_مقبس.إعادة_استخدام_العنوان(صواب)];
        طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 4, &الخيارات) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(المستمع) -> {
            دع السطر: متغير اختياري نص = اختياري.لا_شيء();
            طابق اتصل_تي_سي_بي(&العنوان) مع
            | نتيجة.خطأ(_) -> { }
            | نتيجة.نجح(العميل) -> {
                طابق اقبل_تي_سي_بي(&المستمع) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(الخادم) -> {
                    طابق اضبط_خيار_تدفق_تي_سي_بي(&الخادم, خيار_مقبس.مهلة_استقبال(5000)) مع
                    | _ -> { };
                    دع بينغ: متجه ط8 = [112, 105, 110, 103];
                    دع بونغ: متجه ط8 = [112, 111, 110, 103];
                    دع المستلم: متغير متجه ط8 = [0, 0, 0, 0];
                    دع الرد: متغير متجه ط8 = [0, 0, 0, 0];
                    طابق اكتب_تي_سي_بي(&العميل, &بينغ, 0, 4) مع | _ -> { };
                    طابق اقرأ_تي_سي_بي(&الخادم, &متغير المستلم, 0, 4) مع | _ -> { };
                    طابق اكتب_تي_سي_بي(&الخادم, &بونغ, 0, 4) مع | _ -> { };
                    طابق اقرأ_تي_سي_بي(&العميل, &متغير الرد, 0, 4) مع | _ -> { };
                    دع الأجزاء: متجه نص = ["tcp ", من_بايتات(&المستلم), "/", من_بايتات(&الرد)];
                    دع لا_شيء: نص = "";
                    السطر := اختياري.موجود(صل_النصوص(&الأجزاء, &لا_شيء));
                    دع أغلق_الخادم: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(الخادم);
                };
                دع أغلق_العميل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(العميل);
            };
            دع أغلق_المستمع: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
            أرجع السطر;
        };
    };
}

عرف ذهاب_وإياب_يو_دي_بي(): عدد {
    دع نص_أ: نص = "127.0.0.1:38643";
    دع نص_ب: نص = "127.0.0.1:38644";
    طابق حلل_عنوان_مقبس(&نص_أ) مع
    | نتيجة.خطأ(_) -> { أرجع -1; }
    | نتيجة.نجح(عنوان_أ) -> {
        طابق حلل_عنوان_مقبس(&نص_ب) مع
        | نتيجة.خطأ(_) -> { أرجع -2; }
        | نتيجة.نجح(عنوان_ب) -> {
            طابق اربط_يو_دي_بي(&عنوان_أ) مع
            | نتيجة.خطأ(_) -> { أرجع -3; }
            | نتيجة.نجح(أ) -> {
                دع العدد: متغير عدد = -4;
                طابق اربط_يو_دي_بي(&عنوان_ب) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(ب) -> {
                    طابق وصل_يو_دي_بي(&أ, &عنوان_ب) مع | _ -> { };
                    طابق اضبط_خيار_يو_دي_بي(&ب, خيار_مقبس.مهلة_استقبال(5000)) مع | _ -> { };
                    دع الرسالة: متجه ط8 = [83, 117, 108, 116, 97, 110];
                    طابق أرسل_يو_دي_بي(&أ, &الرسالة, 0, 6) مع | _ -> { };
                    دع المخزن: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
                    طابق استقبل_يو_دي_بي(&ب, &متغير المخزن, 0, 8) مع
                    | نتيجة.خطأ(_) -> { العدد := -5; }
                    | نتيجة.نجح(ن) -> {
                        العدد := ن;
                        إذا (المخزن[0] != 83 || المخزن[5] != 110) { العدد := -6; };
                    };
                    دع أغلق_ب: نتيجة عدد, عدد = أغلق_يو_دي_بي(ب);
                };
                دع أغلق_أ: نتيجة عدد, عدد = أغلق_يو_دي_بي(أ);
                أرجع العدد;
            };
        };
    };
}

عرف الرئيسية(): عدد {
    دع تي_سي_بي: نص;
    طابق ذهاب_وإياب_تي_سي_بي() مع
    | اختياري.موجود(السطر) -> { تي_سي_بي := السطر; }
    | اختياري.لا_شيء -> { أرجع 1; };
    دع يو_دي_بي: عدد = ذهاب_وإياب_يو_دي_بي();
    إذا (يو_دي_بي < 0) { أرجع 2; };
    دع السطر: متجه نص = [تي_سي_بي, "|udp ", عدد_إلى_نص(يو_دي_بي)];
    دع لا_شيء: نص = "";
    اطبع(صل_النصوص(&السطر, &لا_شيء));
    أرجع 42;
}
