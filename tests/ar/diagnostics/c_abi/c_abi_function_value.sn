// اختبار: رفض
// تشخيص: SULTANC-C-ABI-MISUSE
// نظير: tests/en/diagnostics/c_abi/c_abi_function_value.sn
// دالة @@اصطلاح_سي ليست قيمة دالة: نداء الإغلاق يمرر بيئة بالاصطلاح الداخلي
// للسلطان. وعنوانها بدائي_عنوان_دالة_سي(د).
@@اصطلاح_سي
عرف ضاعف(ن: ص64): ص64 { أرجع ن * 2; }

عرف الرئيسية(): عدد {
    ليكن د: دالة(ص64): ص64 = ضاعف;
    أرجع د(21) مثل عدد;
}
