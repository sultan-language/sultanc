// اختبار: رفض
// تشخيص: SULTANC-EXTERN-SYMBOL-CONFLICT
// نظير: tests/en/diagnostics/semantic/extern_symbol_conflict.sn
// تصريحان خارجيان يربطان رمز ربط واحدا بتوقيعين مختلفين يُرفضان عند
// التصريح الثاني، قبل أي خلفية (صرّحت مكتبة macOS القياسية مرة بـ `open`
// من C مرتين، ولم يظهر الخطأ إلا في مزود LLVM).
خارجي عرف close(الواصف: ص32): ص32;
خارجي عرف close_عريض(الواصف: ص64, الأعلام: ص32): ص32 = «close»;

عرف الرئيسية(): عدد {
    أرجع 0;
}
