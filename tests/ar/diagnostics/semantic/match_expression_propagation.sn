// اختبار: رفض
// تشخيص: SULTANC-PARSE-EXPRESSION
// نظير: tests/en/diagnostics/semantic/match_expression_propagation.sn
// خرج-تشخيص-عربي: match_expression_propagation.ar.stderr
// خرج-تشخيص-إنجليزي: match_expression_propagation.en.stderr
// `؟` غير متاح في أذرع تعبير المطابقة؛ و`؟` بعد الذراع الأخير يعم المطابقة كلها.
عرف نصف(ن: عدد): نتيجة عدد, نص {
    إذا (ن % 2 == 0) { أرجع نتيجة.نجح(ن / 2); };
    أرجع نتيجة.خطأ(«odd»);
}

عرف ربع(ن: عدد): نتيجة عدد, نص {
    ليكن ر: عدد = طابق ن مع
    | 0 -> 0
    | _ -> {
        ليكن ح: عدد = نصف(ن)؟;
        ح / 2
    };
    أرجع نتيجة.نجح(ر);
}

عرف الرئيسية(): عدد {
    طابق ربع(8) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
