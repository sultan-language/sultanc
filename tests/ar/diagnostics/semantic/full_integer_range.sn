// اختبار: قبول
// خطأ-قياسي: <فارغ>
// نظير: tests/en/diagnostics/semantic/full_integer_range.sn
// المديات التي تغطي معا كل قيم النوع العددي شاملة، ولا تُذكر أي ذراع.
عرف صنف_البايت(القيمة: ط8): ص32 {
    طابق القيمة مع
    | مدى 0 إلى 127 -> { أرجع 0; }
    | 128 -> { أرجع 1; }
    | مدى 129 إلى 255 -> { أرجع 2; }
}
عرف الإشارة(القيمة: ص8): ص32 {
    طابق القيمة مع
    | مدى -128 إلى -1 -> { أرجع 1; }
    | 0 -> { أرجع 0; }
    | مدى 1 إلى 127 -> { أرجع 2; }
}
عرف الرئيسية(): ص32 {
    أرجع صنف_البايت(7) + الإشارة(0);
}
