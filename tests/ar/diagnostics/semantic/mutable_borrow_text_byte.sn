// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE
// نظير: tests/en/diagnostics/semantic/mutable_borrow_text_byte.sn
// A byte of a text is borrowed shared only: `&mutable s[i]` is rejected,
// even in a mutable text.
عرف الرئيسية(): ص32 {
    دع الكلمة: متغير نص = «abc»;
    دع ب: &متغير ط8 = &متغير الكلمة[0];
    أرجع 0;
}
