// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// خروج: 2
// نظير: tests/en/diagnostics/semantic/unreachable_alternative.sn
// البديل الذي تغطيه الأذرع السابقة لا يطابق أبدا: تحذير عند البديل، ويُبنى
// البرنامج.
نوع يد = | حجر | ورق | مقص;
عرف الرئيسية(): عدد {
    ليكن ي: يد = يد.ورق();
    طابق ي مع
    | يد.حجر -> { أرجع 1; }
    | يد.ورق | يد.حجر -> { أرجع 2; }
    | يد.مقص -> { أرجع 3; };
}
