// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// خروج: 1
// نظير: tests/en/diagnostics/semantic/unreachable_vector_arm.sn
// `[_، بقية _]` يغطي كل متجه فيه عنصر أو أكثر: الذراع الذي بعده لا يُنفذ أبدا، تحذير،
// ويُبنى البرنامج.
عرف الرئيسية(): عدد {
    ليكن م: متجه عدد = [1];
    طابق م مع
    | [_، بقية _] -> { أرجع 1; }
    | [أ] -> { أرجع أ; }
    | [] -> { أرجع 0; };
}
