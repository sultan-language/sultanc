// اختبار: رفض
// تشخيص: SULTANC-PARSE-EXPRESSION
// نظير: tests/en/diagnostics/semantic/loop_control_in_closure.sn
// جسم الإغلاق تعبير: لا يصل تحكم الحلقة داخله إلى الحلقة المحيطة بالإغلاق.
عرف الرئيسية(): ص32 {
    دع العدد: متغير ص32 = 0;
    طالما (العدد < 3) {
        دع اخرج: دالة(): ص32 = دالة(): ص32 -> اخرج_من_حلقة;
        العدد := العدد + 1;
    }
    أرجع 0;
}
