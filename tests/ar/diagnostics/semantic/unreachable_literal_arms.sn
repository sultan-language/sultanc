// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// نظير: tests/en/diagnostics/semantic/unreachable_literal_arms.sn
// حرفي داخل مدى سابق، وحرفي نصي مكرر، وصف تغطيه الصفوف السابقة معا: لا تُنفذ أبدا.
نوع ضوء = | أحمر | أخضر;
عرف درجة(المستوى: ط8, الكلمة: نص, الزوج: (ضوء, منطقي)): ص32 {
    طابق المستوى مع
    | مدى 0 إلى 100 -> { أرجع 1; }
    | 50 -> { أرجع 2; }
    | _ -> { };
    طابق الكلمة مع
    | «أ» -> { أرجع 3; }
    | «أ» -> { أرجع 4; }
    | _ -> { };
    طابق الزوج مع
    | (ضوء.أحمر(), صواب) -> { أرجع 5; }
    | (_, خطأ) -> { أرجع 6; }
    | (ضوء.أخضر(), _) -> { أرجع 7; }
    | (ضوء.أحمر(), خطأ) -> { أرجع 8; }
}
عرف الرئيسية(): ص32 {
    دع الزوج: (ضوء, منطقي) = (ضوء.أخضر(), صواب);
    أرجع درجة(200, «ب», الزوج) - 7;
}
