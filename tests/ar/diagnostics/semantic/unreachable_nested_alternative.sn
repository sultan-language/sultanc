// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// نظير: tests/en/diagnostics/semantic/unreachable_nested_alternative.sn
// البديل المتداخل في نمط، الذي تغطيه بدائل النمط البديل السابقة، لا يطابق
// أبدا: تحذير عند البديل، ويُبنى البرنامج.
عرف الرئيسية(): عدد {
    ليكن ز: (عدد, عدد) = (1, 2);
    طابق ز مع
    | (1 | 2 | 1, ص) -> { أرجع ص; }
    | _ -> { أرجع 0; };
}
