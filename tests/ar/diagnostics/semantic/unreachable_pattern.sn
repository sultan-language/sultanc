// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// نظير: tests/en/diagnostics/semantic/unreachable_pattern.sn
// ذراع شاملة تغطي الذراع التي بعدها: تحذير، ويُبنى البرنامج.
عرف الرئيسية(): عدد {
    دع القيمة: نتيجة عدد, عدد = نتيجة.نجح(42);
    طابق القيمة مع
    | _ -> { أرجع 0; }
    | نتيجة.نجح(س) -> { أرجع س; }
}
