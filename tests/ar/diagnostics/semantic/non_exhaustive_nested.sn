// اختبار: رفض
// تشخيص: SULTANC-PATTERN-NON-EXHAUSTIVE
// نظير: tests/en/diagnostics/semantic/non_exhaustive_nested.sn
// القيمة اختيار.بعض(خطأ) لا تطابق أي ذراع.
عرف الرئيسية(): ص32 {
    دع القيمة: اختياري منطقي = اختياري.موجود(صواب);
    طابق القيمة مع
    | اختياري.موجود(صواب) -> { أرجع 1; }
    | اختياري.لا_شيء() -> { أرجع 0; }
}
