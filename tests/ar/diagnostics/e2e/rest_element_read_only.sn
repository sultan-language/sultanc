// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE
// نظير: tests/en/diagnostics/e2e/rest_element_read_only.sn
// خرج-تشخيص-عربي: rest_element_read_only.ar.stderr
// خرج-تشخيص-إنجليزي: rest_element_read_only.en.stderr
// تحت `طابق &متغير م` لا يُكتب إلا في البقية المسماة: العنصر المربوط من م قيمة للقراءة فقط.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    طابق &متغير القيم مع
    | [الأول، بقية الذيل] -> { الأول := 0; الذيل[0] := 0; }
    | [] -> { };
    أرجع القيم[0];
}
