// اختبار: رفض
// تشخيص: SULTANC-BORROW-REFERENCE-ESCAPE
// نظير: tests/en/diagnostics/e2e/borrow_outlives_plain_value_in_order.sn
// خرج-تشخيص-عربي: borrow_outlives_plain_value_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_outlives_plain_value_in_order.en.stderr
// لا تعيش الاستعارة بعد المحلي الذي تستعيره، ولو كان لا يملك تخزينًا
// (docs/ar/reference/ownership.md، "مناطق الاستعارة"): القيمة البسيطة لا تُتلف حيث
// ينتهي نطاقها، لكن المرجع إليها الذي يُقرأ بعد ذلك يهرب من نطاق صلاحيته كما يهرب
// المرجع إلى المالك. ويُعلَّم الخطأ حيث ينتهي نطاق المحلي (قوس الكتلة الختامي، أو
// `اخرج_من_حلقة` أو `تابع_حلقة` الذي يغادر جسم الحلقة، أو نهاية ذراع المطابقة)،
// ويكون المحلي والقراءة اللاحقة نطاقين مرتبطين: `عدد` وعضو سجل أعداد وعنصر صف
// تُعطى في فرع وتُقرأ بعده، ومرجع يُعطى في جسم حلقة ويُقرأ بعدها، ومرجع يُقرأ ثانية
// في الدورة التالية، ومرجع يُعطى قبل `اخرج_من_حلقة` وآخر قبل `تابع_حلقة`، ومرجع
// يُعطى في ذراع مطابقة، ومرجع يُخزن في عضو سجل وفي عنصر متجه ويُلحق بمتجه، كلها
// تعيش بعد المحلي. تذكر كل دالة خطأها الأول.
نوع زوج = { أ: عدد, ب: عدد };
نوع حامل = { العنصر: &عدد };
نوع خيار =
    | واحد بنوع عدد
    | آخر
;

عرف عدد_في_فرع(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    إذا (العلم) {
        ليكن الداخلي: عدد = 42;
        ر := &الداخلي;
    };
    أرجع *ر;
}

عرف عضو_في_فرع(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    إذا (العلم) {
        ليكن الزوج: زوج = { أ: 40, ب: 2 };
        ر := &الزوج.ب;
    };
    أرجع *ر;
}

عرف عنصر_في_فرع(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    إذا (العلم) {
        ليكن الاثنان: (عدد, عدد) = (40, 2);
        ر := &الاثنان[1];
    };
    أرجع *ر;
}

عرف يعطى_في_حلقة(): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن الداخلي: عدد = 5;
        ر := &الداخلي;
        ف := ف + 1;
    }
    أرجع *ر;
}

عرف يقرأ_في_الدورة_التالية(): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        المجموع := المجموع + *ر;
        ليكن الداخلي: عدد = 5;
        ر := &الداخلي;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف يعطى_قبل_الخروج(): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    طالما (صواب) {
        ليكن الداخلي: عدد = 7;
        ر := &الداخلي;
        اخرج_من_حلقة;
    }
    أرجع *ر;
}

عرف يعطى_قبل_المتابعة(): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ف := ف + 1;
        المجموع := المجموع + *ر;
        ليكن الداخلي: عدد = 3;
        ر := &الداخلي;
        تابع_حلقة;
    }
    أرجع المجموع;
}

عرف يعطى_في_ذراع(الاختيار: خيار): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    طابق الاختيار مع
    | خيار.واحد(ن) -> {
        ليكن الداخلي: عدد = ن;
        ر := &الداخلي;
    }
    | خيار.آخر -> { ر := &الخارجي; };
    أرجع *ر;
}

عرف يخزن_في_عضو(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن الحامل: متغير حامل = { العنصر: &الخارجي };
    إذا (العلم) {
        ليكن الداخلي: عدد = 42;
        الحامل.العنصر := &الداخلي;
    };
    أرجع *الحامل.العنصر;
}

عرف يخزن_في_عنصر(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن المراجع: متغير متجه &عدد = [&الخارجي];
    إذا (العلم) {
        ليكن الداخلي: عدد = 42;
        المراجع[0] := &الداخلي;
    };
    أرجع *المراجع[0];
}

عرف يلحق(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن المراجع: متغير متجه &عدد = [&الخارجي];
    إذا (العلم) {
        ليكن الداخلي: عدد = 42;
        ألحق(المراجع, &الداخلي);
    };
    أرجع *المراجع[الطول(المراجع) - 1];
}

عرف الرئيسية(): عدد { أرجع 0; }
