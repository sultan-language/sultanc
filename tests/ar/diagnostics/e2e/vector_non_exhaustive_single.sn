// اختبار: رفض
// تشخيص: SULTANC-PATTERN-NON-EXHAUSTIVE
// نظير: tests/en/diagnostics/e2e/vector_non_exhaustive_single.sn
// خرج-تشخيص-عربي: vector_non_exhaustive_single.ar.stderr
// خرج-تشخيص-إنجليزي: vector_non_exhaustive_single.en.stderr
// `[الأول، بقية _، الأخير]` يحتاج عنصرين: المتجه ذو العنصر الواحد لا يطابق أي ذراع.
عرف الطرفان(م: متجه عدد): عدد {
    طابق م مع
    | [] -> { أرجع 0; }
    | [الأول، بقية _، الأخير] -> { أرجع الأول + الأخير; };
}
عرف الرئيسية(): عدد {
    ليكن م: متجه عدد = [1];
    أرجع الطرفان(م);
}
