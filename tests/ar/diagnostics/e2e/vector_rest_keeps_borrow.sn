// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/vector_rest_keeps_borrow.sn
// خرج-تشخيص-عربي: vector_rest_keeps_borrow.ar.stderr
// خرج-تشخيص-إنجليزي: vector_rest_keeps_borrow.en.stderr
// البقية المسماة في `طابق م` عرض لعناصر م نفسها: فهي تستعير م ما دامت مستعملة.
// والإلحاق قد ينقل عناصر م، فيُرفض ما دامت البقية تُقرأ بعده. وكان مقبولا من قبل:
// فتقرأ البقية تخزين م المحرر.
عرف الرئيسية(): عدد {
    ليكن م: متغير متجه عدد = [1، 2، 3];
    طابق م مع
    | [_، بقية الذيل] -> {
        ألحق(م، 4);
        أرجع الذيل[0];
    }
    | [] -> { أرجع 0; };
}
