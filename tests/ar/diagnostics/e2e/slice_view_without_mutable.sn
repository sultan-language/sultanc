// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-VIEW-WITHOUT-MUTABLE
// نظير: tests/en/diagnostics/e2e/slice_view_without_mutable.sn
// خرج-تشخيص-عربي: slice_view_without_mutable.ar.stderr
// خرج-تشخيص-إنجليزي: slice_view_without_mutable.en.stderr
// المعامل `متغير [] T` يكتب في المتجه الذي يعرضه، فيطلبه النداء بـ`&متغير`:
// `املأ(&متغير القيم، 0)`. والإصلاح يكتبها.
عرف املأ(الجزء: متغير [] عدد، القيمة: عدد): فراغ {
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(الجزء)) { الجزء[ف] := القيمة; ف := ف + 1; }
}
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    املأ(القيم، 0);
    أرجع القيم[0];
}
