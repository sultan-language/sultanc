// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/borrow_regions_in_order.sn
// خرج-تشخيص-عربي: borrow_regions_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_regions_in_order.en.stderr
// تدوم الاستعارة حتى آخر استخدام لحاملها على أي مسار يليها
// (docs/ar/reference/ownership.md، "مناطق الاستعارة")، فيُرفض كل مما يأتي:
// مرجع يُقرأ ثانية في الدورة التالية من حلقة؛ ومرجع يُقرأ عبر مرجع آخر فيُبقي
// استعارة ذلك المرجع الحصرية؛ ومتجه مراجع يحمل استعاراته حتى يُتلف عند نهاية
// كتلته؛ ومرجع يُقرأ بعد التقاء فرع يكتب القيمة؛ ونسخة مرجع انتهت استعارته هو
// تبقى تسمي المحلي الذي تشير إليه حين تُرجع. تذكر كل دالة خطأها الأول.
عرف محمول_عبر_الحلقة(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن القارئ: &عدد = &القيمة;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        المجموع := المجموع + *القارئ;
        القيمة := القيمة + 1;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف إعادة_الاستعارة_تبقي_الأصل(): عدد {
    ليكن العناصر: متغير متجه عدد = [1, 2];
    ليكن الكاتب: &متغير متجه عدد = &متغير العناصر;
    ليكن الأول: &عدد = &(*الكاتب)[0];
    ألحق(العناصر, 3);
    أرجع *الأول;
}

عرف المالك_يحمل_حتى_إتلافه(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن المحمولة: متجه &عدد = [&القيمة];
    ليكن العدد_المحمول: عدد = الطول(المحمولة) مثل عدد;
    القيمة := 2;
    أرجع العدد_المحمول;
}

عرف حي_بعد_الالتقاء(العلم: منطقي): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن القارئ: &عدد = &القيمة;
    إذا (العلم) {
        القيمة := 2;
    };
    أرجع *القارئ;
}

عرف هروب_عبر_نسخة(): &عدد {
    ليكن القيمة: عدد = 1;
    ليكن القارئ: &عدد = &القيمة;
    ليكن النسخة: &عدد = القارئ;
    أرجع النسخة;
}

عرف الرئيسية(): عدد { أرجع 0; }
