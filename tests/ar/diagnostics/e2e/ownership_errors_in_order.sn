// اختبار: رفض
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/diagnostics/e2e/ownership_errors_in_order.sn
// خرج-تشخيص-عربي: ownership_errors_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: ownership_errors_in_order.en.stderr
// يُذكر أول خطأ ملكية في كل دالة، بترتيب الدوال، بعد خطأ النوع الذي وُجد أولًا:
// الاستخدام بعد النقل في القالب العام من تحليل تدفق المصدر، وتعارض الاستعارة
// والاستخدام بعد النقل والاستخدام قبل التهيئة من تحليل شرعية الملكية على MSIR
// (docs/ar/internals/ownership-analysis.md، «الشرعية»).
عرف استهلك(النص: نص): عدد { أرجع الطول(النص) مثل عدد; }

عرف مستعار_ثم_منقول(): عدد {
    ليكن القيم: متغير متجه عدد = [40, 2];
    ليكن الأول: &عدد = &القيم[0];
    طابق أزل_الأخير(القيم) مع
    | اختياري.موجود(ق) -> { أرجع *الأول + ق; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف منقول_مرتين(): عدد {
    ليكن النص: نص = «twice»;
    ليكن أ: عدد = استهلك(النص);
    أرجع أ + استهلك(النص);
}

عرف مرتين_عامة<ن>(القيمة: ن, المستقبل: دالة(ن): عدد): عدد {
    ليكن الأول: عدد = المستقبل(القيمة);
    أرجع الأول + المستقبل(القيمة);
}

عرف قراءة_غير_معطاة(العلم: منطقي): عدد {
    ليكن النص: نص;
    إذا (العلم) { النص := «set»; };
    أرجع استهلك(النص);
}

عرف خاطئ_النوع(): عدد {
    ليكن العدد: عدد = «text»;
    أرجع العدد;
}

عرف الرئيسية(): عدد {
    أرجع منقول_مرتين() + قراءة_غير_معطاة(صواب) + مرتين_عامة(«x», استهلك) + مستعار_ثم_منقول();
}
