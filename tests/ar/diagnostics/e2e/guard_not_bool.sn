// خرج-تشخيص-إنجليزي: guard_not_bool.en.stderr
// الحارس شرط: العدد ليس شرطا.
عرف د(القيمة: عدد): عدد {
    طابق القيمة مع
    | س إذا س -> { أرجع 1; }
    | _ -> { أرجع 0; };
}
عرف الرئيسية(): عدد { أرجع د(1); }
