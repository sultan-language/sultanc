// اختبار: رفض
// تشخيص: SULTANC-PATTERN-INVALID
// نظير: tests/en/diagnostics/e2e/record_pun_unknown_field.sn
// خرج-تشخيص-عربي: record_pun_unknown_field.ar.stderr
// خرج-تشخيص-إنجليزي: record_pun_unknown_field.en.stderr
// الحقل المختصر حقل من السجل: `العمق` ليس منها.
نوع مقاس = { العرض: عدد, الارتفاع: عدد };
عرف د(م: مقاس): عدد {
    طابق م مع
    | { العرض, العمق } -> { أرجع العرض; };
}
عرف الرئيسية(): عدد {
    ليكن م: مقاس = { العرض: 1, الارتفاع: 2 };
    أرجع د(م);
}
