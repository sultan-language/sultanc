// اختبار: رفض
// تشخيص: SULTANC-THREAD-CAPTURE-REFERENCE
// نظير: tests/en/diagnostics/e2e/slice_thread_capture.sn
// خرج-تشخيص-عربي: slice_thread_capture.ar.stderr
// خرج-تشخيص-إنجليزي: slice_thread_capture.en.stderr
// الشريحة عرض مستعار: لا يجوز لإغلاق يُسلَّم إلى خيط آخر أن يلتقطها، كما لا يلتقط
// مرجعا.
استورد المكتبة.خيوط.خيط;

عرف احتفظ(س: عدد): فراغ { }

عرف شغل(القيم: &متجه عدد): فراغ {
    ليكن الجزء: [] عدد = (*القيم)[1..];
    طابق أطلق(دالة(): فراغ -> احتفظ(الجزء[0])) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عرف الرئيسية(): ص32 {
    ليكن القيم: متجه عدد = [1، 2، 3];
    شغل(&القيم);
    أرجع 0;
}
