// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/slice_append_while_writable.sn
// خرج-تشخيص-عربي: slice_append_while_writable.ar.stderr
// خرج-تشخيص-إنجليزي: slice_append_while_writable.en.stderr
// العرض القابل للكتابة يستعير متجهه حصرا: لا ينمو المتجه ما دام العرض مستعملا.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    ليكن الجزء: متغير [] عدد = &متغير القيم[1..];
    ألحق(القيم، 4);
    الجزء[0] := 7;
    أرجع الطول(الجزء) مثل عدد;
}
