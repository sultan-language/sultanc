// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/borrow_conflicts_in_order.sn
// خرج-تشخيص-عربي: borrow_conflicts_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_conflicts_in_order.en.stderr
// لا تُقرأ قيمة مستعارة حصريًا؛ ولا تُسند قيمة مستعارة، ولا تُمرر بالقيمة، ولا
// تُغيَّر في مكانها، ولا يستعيرها نداء حصريًا، ولا يستعير نداء مكانًا واحدًا
// حصريًا ومشتركًا معًا. تذكر كل دالة خطأها الأول.
عرف أبق(القيمة: عدد): عدد { أرجع القيمة; }
عرف زد(الهدف: &متغير عدد): عدد { *الهدف := *الهدف + 1; أرجع *الهدف; }
عرف زوج(الأول: &متغير عدد, الثاني: &عدد): عدد { أرجع *الأول + *الثاني; }

عرف قراءة_مستعار_حصريا(): عدد {
    دع القيمة: متغير عدد = 1;
    دع الكاتب: &متغير عدد = &متغير القيمة;
    دع النسخة: عدد = القيمة;
    أرجع *الكاتب + النسخة;
}

عرف إسناد_مستعار(): عدد {
    دع القيمة: متغير عدد = 1;
    دع القارئ: &عدد = &القيمة;
    القيمة := 2;
    أرجع *القارئ;
}

عرف تمرير_مستعار(): عدد {
    دع القيمة: عدد = 1;
    دع القارئ: &عدد = &القيمة;
    دع النسخة: عدد = أبق(القيمة);
    أرجع *القارئ + النسخة;
}

عرف نداء_يستعير_مرتين(): عدد {
    دع القيمة: متغير عدد = 1;
    أرجع زوج(&متغير القيمة, &القيمة);
}

عرف نداء_يستعير_المحمول(): عدد {
    دع القيمة: متغير عدد = 1;
    دع القارئ: &عدد = &القيمة;
    دع المزاد: عدد = زد(&متغير القيمة);
    أرجع *القارئ + المزاد;
}

عرف إلحاق_بمعروض(): عدد {
    دع العناصر: متغير متجه عدد = [1];
    دع الأول: &عدد = &العناصر[0];
    ألحق(العناصر, 2);
    أرجع *الأول;
}

عرف الرئيسية(): عدد { أرجع 0; }
