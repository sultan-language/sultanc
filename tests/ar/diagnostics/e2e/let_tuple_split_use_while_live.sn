// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/let_tuple_split_use_while_live.sn
// خرج-تشخيص-عربي: let_tuple_split_use_while_live.ar.stderr
// خرج-تشخيص-إنجليزي: let_tuple_split_use_while_live.en.stderr
// يستعير النصفان اللذان تأخذهما `ليكن` المفككة من `اقسم_قابلا_للتعديل` المتجهَ حصرا:
// فلا يُقرأ ما دام أحد النصفين مستعملا.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    ليكن (اليسار، اليمين): (متغير [] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير القيم، 1);
    ليكن الأول: عدد = القيم[0];
    اليسار[0] := الأول;
    اليمين[0] := 0;
    أرجع القيم[0];
}
