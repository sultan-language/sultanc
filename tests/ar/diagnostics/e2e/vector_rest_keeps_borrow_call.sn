// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/vector_rest_keeps_borrow_call.sn
// خرج-تشخيص-عربي: vector_rest_keeps_borrow_call.ar.stderr
// خرج-تشخيص-إنجليزي: vector_rest_keeps_borrow_call.en.stderr
// تمرير م بـ`&متغير` والبقية المسماة في `طابق م` ما زالت مستعملة هو التعارض نفسه
// الذي يحدثه الإلحاق في الذراع: فالمستدعاة قد تغير م أو تنميها.
عرف نمِّ(م: &متغير متجه عدد): فراغ { ألحق(*م، 4); }
عرف الرئيسية(): عدد {
    ليكن م: متغير متجه عدد = [1، 2، 3];
    طابق م مع
    | [_، بقية الذيل] -> {
        نمِّ(&متغير م);
        أرجع الذيل[0];
    }
    | [] -> { أرجع 0; };
}
