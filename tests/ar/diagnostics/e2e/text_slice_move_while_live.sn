// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/text_slice_move_while_live.sn
// خرج-تشخيص-عربي: text_slice_move_while_live.ar.stderr
// خرج-تشخيص-إنجليزي: text_slice_move_while_live.en.stderr
// شريحة النص تستعير نصها: لا يُنقل النص والشريحة حية.
عرف استهلك(النص: نص): عدد {
    أرجع الطول(النص);
}

عرف الرئيسية(): عدد {
    ليكن التحية: نص = «hello»;
    ليكن الوسط: &نص = &التحية[1..3];
    ليكن المنقول: عدد = استهلك(التحية);
    أرجع المنقول + الطول(*الوسط);
}
