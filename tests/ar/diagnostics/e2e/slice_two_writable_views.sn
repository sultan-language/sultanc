// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/slice_two_writable_views.sn
// خرج-تشخيص-عربي: slice_two_writable_views.ar.stderr
// خرج-تشخيص-إنجليزي: slice_two_writable_views.en.stderr
// عرضان قابلان للكتابة من متجه واحد معا مرفوضان، ولو كانا لجزأين لا يتداخلان.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3، 4];
    ليكن اليسار: متغير [] عدد = &متغير القيم[..1];
    ليكن اليمين: متغير [] عدد = &متغير القيم[2..];
    اليسار[0] := 0;
    اليمين[0] := 0;
    أرجع 0;
}
