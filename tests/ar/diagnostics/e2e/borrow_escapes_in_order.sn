// اختبار: رفض
// تشخيص: SULTANC-BORROW-REFERENCE-ESCAPE
// نظير: tests/en/diagnostics/e2e/borrow_escapes_in_order.sn
// خرج-تشخيص-عربي: borrow_escapes_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_escapes_in_order.en.stderr
// لا يغادر مرجع الدالة وهو يستعير أحد محلياتها: مُرجعًا مباشرة، أو عبر محلي
// يحمله، أو مقروءًا عبر مرجع إلى محلي، أو ملتقطًا في إغلاق يغادرها. ولا يلتقط
// إغلاق مرجعًا حصريًا كذلك. تذكر كل دالة خطأها الأول.
عرف استعارة_محلي(): &عدد {
    ليكن القيمة: عدد = 1;
    أرجع &القيمة;
}

عرف حامل_محلي(): &عدد {
    ليكن القيمة: عدد = 2;
    ليكن المرجع: &عدد = &القيمة;
    أرجع المرجع;
}

عرف عبر_مرجع(العناصر: &متجه عدد): &عدد {
    ليكن المحلي: متجه عدد = [1, 2];
    ليكن العرض: &متجه عدد = &المحلي;
    أرجع &(*العرض)[0];
}

عرف مرجع_ملتقط(): دالة(عدد): عدد {
    ليكن القيمة: عدد = 3;
    ليكن المرجع: &عدد = &القيمة;
    ليكن أضف: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + *المرجع;
    أرجع أضف;
}

عرف التقاط_متغير(الهدف: &متغير عدد): دالة(عدد): عدد {
    ليكن أضف: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + *الهدف;
    أرجع أضف;
}

عرف الرئيسية(): عدد { أرجع 0; }
