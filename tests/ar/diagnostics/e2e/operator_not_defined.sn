// اختبار: رفض
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/diagnostics/e2e/operator_not_defined.sn
// خرج-تشخيص-عربي: operator_not_defined.ar.stderr
// خرج-تشخيص-إنجليزي: operator_not_defined.en.stderr
// العامل الذي لا يعرّفه السجل خطأ نوع عند العملية، يسمي العامل
// والنوع.
نوع نقطة = { الأول: عدد, الثاني: عدد };

عرف الرئيسية(): عدد {
    ليكن أ: نقطة = { الأول: 1, الثاني: 2 };
    ليكن ب: نقطة = { الأول: 3, الثاني: 4 };
    إذا (أ > ب) { أرجع 1; };
    أرجع 0;
}
