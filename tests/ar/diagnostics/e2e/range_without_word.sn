// اختبار: رفض
// تشخيص: SULTANC-PARSE-PATTERN
// نظير: tests/en/diagnostics/e2e/range_without_word.sn
// خرج-تشخيص-عربي: range_without_word.ar.stderr
// خرج-تشخيص-إنجليزي: range_without_word.en.stderr
// مجال القيم في النمط يبدأ بـ`مدى`: `1..9` وحده ليس نمطا، والمساعدة تعرض
// `مدى 1..9`.
عرف أرقام(ن: عدد): عدد {
    طابق ن مع
    | 1..9 -> { أرجع 1; }
    | _ -> { أرجع 0; };
}
عرف الرئيسية(): عدد {
    أرجع أرقام(5);
}
