// اختبار: رفض
// تشخيص: SULTANC-BORROW-REFERENCE-ESCAPE
// نظير: tests/en/diagnostics/e2e/vector_rest_escape.sn
// خرج-تشخيص-عربي: vector_rest_escape.ar.stderr
// خرج-تشخيص-إنجليزي: vector_rest_escape.en.stderr
// `بقية الذيل` تحت `طابق &متغير م` عرض قابل للكتابة لعناصر المتجه المطابَق نفسها:
// فهي تستعير المتجه. والعرض الذي يأخذ قيمة `الذيل` ويُقرأ بعد إتلاف المتجه يتجاوز نطاقه.
عرف طول_الذيل(الشرط: منطقي): عدد {
    ليكن المحفوظة: متغير [] عدد = [0];
    إذا (الشرط) {
        ليكن م: متغير متجه عدد = [1، 2، 3];
        طابق &متغير م مع
        | [_، بقية الذيل] -> { المحفوظة := الذيل; }
        | [] -> { };
    };
    أرجع الطول(المحفوظة) مثل عدد;
}
عرف الرئيسية(): عدد {
    أرجع طول_الذيل(صواب);
}
