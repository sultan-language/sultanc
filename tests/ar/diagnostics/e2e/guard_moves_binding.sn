// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE
// نظير: tests/en/diagnostics/e2e/guard_moves_binding.sn
// خرج-تشخيص-عربي: guard_moves_binding.ar.stderr
// خرج-تشخيص-إنجليزي: guard_moves_binding.en.stderr
// يستعير الحارس الروابط: لا يمكنه نقل الحمولة، فهي ما تزال للمميز إذا فشل
// الحارس.
نوع مسمى = | واحد بنوع نص | لا_أحد;
عرف خذ(ن: نص): عدد { أرجع الطول(ن) مثل عدد; }
عرف د(م: مسمى): عدد {
    طابق م مع
    | مسمى.واحد(ن) إذا خذ(ن) > 3 -> { أرجع 1; }
    | _ -> { أرجع 0; };
}
عرف الرئيسية(): عدد { أرجع د(مسمى.لا_أحد()); }
