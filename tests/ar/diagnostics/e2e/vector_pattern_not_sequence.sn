// خرج-تشخيص-إنجليزي: vector_pattern_not_sequence.en.stderr
// نمط المتجه يطابق متجها أو شريحة: العدد ليس أيا منهما.
عرف د(القيمة: عدد): عدد {
    طابق القيمة مع
    | [أ] -> { أرجع أ; }
    | _ -> { أرجع 0; };
}
عرف الرئيسية(): عدد { أرجع د(1); }
