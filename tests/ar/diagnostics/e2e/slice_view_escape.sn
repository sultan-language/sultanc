// اختبار: رفض
// تشخيص: SULTANC-BORROW-REFERENCE-ESCAPE
// نظير: tests/en/diagnostics/e2e/slice_view_escape.sn
// خرج-تشخيص-عربي: slice_view_escape.ar.stderr
// خرج-تشخيص-إنجليزي: slice_view_escape.en.stderr
// العرض يستعير متجهه: عرض يُحفظ في متغير محلي أطول عمرا ويُقرأ بعد إتلاف
// المتجه يفلت من نطاقه.
عرف طول_المحفوظ(علم: منطقي): عدد {
    ليكن المحفوظ: متغير [] عدد = [0];
    إذا (علم) {
        ليكن القيم: متغير متجه عدد = [1، 2، 3];
        المحفوظ := &متغير القيم[1..];
    };
    أرجع الطول(المحفوظ) مثل عدد;
}
عرف الرئيسية(): عدد {
    أرجع طول_المحفوظ(صواب);
}
