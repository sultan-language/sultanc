// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE
// نظير: tests/en/diagnostics/e2e/as_borrowed_move.sn
// خرج-تشخيص-عربي: as_borrowed_move.ar.stderr
// خرج-تشخيص-إنجليزي: as_borrowed_move.en.stderr
// `الكل` و`أ` سيملكان التخزين نفسه: الذراع يستعير مميزه، فيكون `الكل` عرضا
// لا ينتقل.
نوع مسمى = | واحد بنوع نص | اثنان بنوع (نص, نص);
عرف خذ(م: مسمى): عدد { أرجع 1; }
عرف د(م: مسمى): عدد {
    طابق م مع
    | مسمى.اثنان(أ, _) مثل الكل -> { أرجع خذ(الكل); }
    | مسمى.واحد(_) -> { أرجع 0; };
}
عرف الرئيسية(): عدد { أرجع د(مسمى.واحد("x")); }
