// اختبار: رفض
// تشخيص: SULTANC-BORROW-REFERENCE-ESCAPE
// نظير: tests/en/diagnostics/e2e/borrow_outlives_owner_in_order.sn
// خرج-تشخيص-عربي: borrow_outlives_owner_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_outlives_owner_in_order.en.stderr
// لا تعيش الاستعارة بعد المالك الذي تستعيره (docs/ar/reference/ownership.md،
// "مناطق الاستعارة"): يُتلف المالك حيث ينتهي نطاقه، والمرجع إليه الذي يُقرأ بعد
// ذلك يهرب من نطاق صلاحيته. ويُعلَّم الخطأ حيث ينتهي نطاق المالك، ويكون المالك
// والقراءة اللاحقة نطاقين مرتبطين: مرجع يُعطى في فرع ويُقرأ بعده، ومرجع يُعطى في
// جسم حلقة ويُقرأ بعدها، ومرجع يُقرأ ثانية في الدورة التالية قبل أن يُعطى، ونسخة
// تُصنع في كتلة داخلية وتُقرأ بعدها. تذكر كل دالة خطأها الأول.
عرف يعطى_في_فرع(العلم: منطقي): عدد {
    دع البديل: نص = «س»;
    دع القارئ: متغير &نص = &البديل;
    إذا (العلم) {
        دع النص: نص = «أبج»;
        القارئ := &النص;
    };
    أرجع الطول(*القارئ) مثل عدد;
}

عرف يعطى_في_حلقة(): عدد {
    دع البديل: نص = «س»;
    دع القارئ: متغير &نص = &البديل;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        دع النص: نص = «أبج»;
        القارئ := &النص;
        ف := ف + 1;
    }
    أرجع الطول(*القارئ) مثل عدد;
}

عرف يقرأ_في_الدورة_التالية(): عدد {
    دع البديل: نص = «س»;
    دع القارئ: متغير &نص = &البديل;
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        المجموع := المجموع + (الطول(*القارئ) مثل عدد);
        دع النص: نص = «أبج»;
        القارئ := &النص;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف نسخة_تعيش_بعده(العلم: منطقي): عدد {
    دع البديل: نص = «س»;
    دع المحفوظ: متغير &نص = &البديل;
    إذا (العلم) {
        دع النص: نص = «أبج»;
        دع الداخلي: &نص = &النص;
        المحفوظ := الداخلي;
    };
    أرجع الطول(*المحفوظ) مثل عدد;
}

عرف الرئيسية(): عدد { أرجع 0; }
