// نظير: tests/en/diagnostics/e2e/if_expression_branch_types.sn
// خرج-تشخيص-عربي: if_expression_branch_types.ar.stderr
// خرج-تشخيص-إنجليزي: if_expression_branch_types.en.stderr
// فرعا قيمة `إذا` يعطيان النوع نفسه.
عرف الرئيسية(): عدد {
    ليكن ن: عدد = 3;
    ليكن ق: عدد = إذا (ن > 0) 1 وإلا "واحد";
    أرجع ق;
}
