// اختبار: رفض
// تشخيص: SULTANC-PARSE-PATTERN
// نظير: tests/en/diagnostics/e2e/record_pattern_dots.sn
// خرج-تشخيص-عربي: record_pattern_dots.ar.stderr
// خرج-تشخيص-إنجليزي: record_pattern_dots.en.stderr
// نمط السجل يسمي الحقول التي يحتاجها وحدها: لا `..` لغيرها.
نوع مقاس = { العرض: عدد، الارتفاع: عدد };
عرف د(م: مقاس): عدد {
    طابق م مع
    | { العرض، .. } -> { أرجع العرض; };
}
عرف الرئيسية(): عدد {
    ليكن م: مقاس = { العرض: 1، الارتفاع: 2 };
    أرجع د(م);
}
