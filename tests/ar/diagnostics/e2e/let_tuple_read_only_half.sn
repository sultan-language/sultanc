// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE
// نظير: tests/en/diagnostics/e2e/let_tuple_read_only_half.sn
// خرج-تشخيص-عربي: let_tuple_read_only_half.ar.stderr
// خرج-تشخيص-إنجليزي: let_tuple_read_only_half.en.stderr
// لكل اسم في `ليكن` المفككة النوع المكتوب له: نصف `اقسم_قابلا_للتعديل` المربوط
// بالنوع `[] T` عرض للقراءة فقط.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    ليكن (اليسار، اليمين): ([] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير القيم، 1);
    اليمين[0] := 7;
    اليسار[0] := 9;
    أرجع 0;
}
