// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/e2e/borrow_endings_in_order.sn
// خرج-تشخيص-عربي: borrow_endings_in_order.ar.stderr
// خرج-تشخيص-إنجليزي: borrow_endings_in_order.en.stderr
// تنتهي الاستعارة حيث يُكتب التخزين الذي تقرؤه: ربط مطابقة يعرض عضوًا من
// محلي ينتهي عند إسناد إلى ذلك المحلي، ومرجع مقروء عبر مرجع ينتهي عند استعارة
// متغيرة عبر ذلك المرجع. والمرجع الحصري ينتقل حين يُمرر بالقيمة. واستخدام أي
// منهما بعد ذلك استخدام بعد النقل. تذكر كل دالة خطأها الأول.
نوع خانة = { القيمة: اختياري نص, العدد: عدد };
نوع جدول = { العناصر: متجه عدد };

عرف ربط_تنهيه_كتابة(): عدد {
    ليكن المدخل: متغير خانة = { القيمة: اختياري.موجود(«أ»), العدد: 1 };
    طابق المدخل.القيمة مع
    | اختياري.موجود(النص) -> {
        المدخل := { القيمة: اختياري.لا_شيء(), العدد: 2 };
        أرجع الطول(النص) مثل عدد;
    }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف استعارة_تنهي_الحامل(المصدر: &متغير جدول): عدد {
    ليكن الأول: &عدد = &(*المصدر).العناصر[0];
    ليكن العناصر: &متغير متجه عدد = &متغير (*المصدر).العناصر;
    ألحق(*العناصر, 4);
    أرجع *الأول;
}

عرف حصري_منقول(الهدف: &متغير عدد): عدد {
    ليكن الآخر: &متغير عدد = الهدف;
    *الآخر := 1;
    أرجع *الهدف;
}

عرف حصري_منقول_مرتين(الهدف: &متغير عدد): عدد {
    ليكن الآخر: &متغير عدد = الهدف;
    ليكن ثانية: &متغير عدد = الهدف;
    أرجع *الآخر + *ثانية;
}

عرف الرئيسية(): عدد { أرجع 0; }
