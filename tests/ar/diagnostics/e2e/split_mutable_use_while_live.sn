// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/split_mutable_use_while_live.sn
// خرج-تشخيص-عربي: split_mutable_use_while_live.ar.stderr
// خرج-تشخيص-إنجليزي: split_mutable_use_while_live.en.stderr
// نصفا `اقسم_قابلا_للتعديل` يستعيران المتجه حصرا: لا يُقرأ ما دام أحد النصفين مستعملا.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    طابق اقسم_قابلا_للتعديل(&متغير القيم، 1) مع
    | (اليسار، اليمين) -> {
        ليكن الأول: عدد = القيم[0];
        اليسار[0] := الأول;
        اليمين[0] := 0;
    };
    أرجع القيم[0];
}
