// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/text_slice_append_while_live.sn
// خرج-تشخيص-عربي: text_slice_append_while_live.ar.stderr
// خرج-تشخيص-إنجليزي: text_slice_append_while_live.en.stderr
// شريحة النص تستعير نصها: لا يُلحق بالنص شيء والشريحة حية
// (docs/ar/reference/ownership.md).
استورد المكتبة.نصوص.تحويل;

عرف ألحق_تعجبا(النص: &متغير نص): فراغ {
    ليكن الأطول: نص = صل_نصين(&*النص, &«!»);
    *النص := الأطول;
}

عرف الرئيسية(): عدد {
    ليكن التحية: متغير نص = «hello»;
    ليكن الرأس: &نص = &التحية[0..1];
    ألحق_تعجبا(&متغير التحية);
    أرجع الطول(*الرأس);
}
