// اختبار: رفض
// تشخيص: SULTANC-PARSE-PATTERN
// نظير: tests/en/diagnostics/e2e/as_missing_name.sn
// خرج-تشخيص-عربي: as_missing_name.ar.stderr
// خرج-تشخيص-إنجليزي: as_missing_name.en.stderr
// `مثل` تسمي القيمة المطابقة: يجب أن يتبعها اسم.
نوع شكل = | دائرة بنوع عدد | نقطة;
عرف د(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(نق) مثل -> { أرجع نق; }
    | شكل.نقطة -> { أرجع 0; };
}
عرف الرئيسية(): عدد { أرجع د(شكل.نقطة()); }
