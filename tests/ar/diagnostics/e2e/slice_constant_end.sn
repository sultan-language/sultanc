// اختبار: رفض
// تشخيص: SULTANC-SAFETY-INDEX-OUT-OF-BOUNDS
// نظير: tests/en/diagnostics/e2e/slice_constant_end.sn
// خرج-تشخيص-عربي: slice_constant_end.ar.stderr
// خرج-تشخيص-إنجليزي: slice_constant_end.en.stderr
// النهاية الثابتة بعد آخر عنصر في متجه معروف الطول تُبلَّغ عند الترجمة، كما يُبلَّغ
// الفهرس نفسه.
عرف الرئيسية(): عدد {
    ليكن القيم: متجه عدد = [1، 2، 3];
    ليكن الجزء: [] عدد = القيم[1..3];
    أرجع الطول(الجزء) مثل عدد;
}
