// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-MERGE-CONFLICT
// نظير: tests/en/diagnostics/e2e/ownership_merge_rejected.sn
// خرج-تشخيص-عربي: ownership_merge_rejected.ar.stderr
// خرج-تشخيص-إنجليزي: ownership_merge_rejected.en.stderr
// لا يدمج تدفق التحكم محليًا لا يحمل قيمة على مسار ونُقل منه على آخر، أو نُقل
// منه على مسار وحُرر على آخر، أو استعاره حاملان مستخدمان بعد الالتقاء حصريًا
// على مسار ومشتركًا على آخر: يرفض التحليل الدمج. تذكر كل دالة خطأها الأول.
عرف استهلك(النص: نص): عدد { أرجع الطول(النص) مثل عدد; }

عرف منقول_أو_غير_مهيأ(العلم: منطقي): عدد {
    دع النص: نص;
    إذا (العلم) {
        النص := «أ»;
        دع المستخدم: عدد = استهلك(النص);
    };
    أرجع 0;
}

عرف منقول_أو_محرر(العلم: منطقي): عدد {
    دع النص: نص = «ب»;
    إذا (العلم) {
        دع المستخدم: عدد = استهلك(النص);
    } وإلا {
        حرر(النص);
    };
    أرجع 0;
}

عرف مشترك_أو_حصري(العلم: منطقي): عدد {
    دع القيمة: متغير عدد = 1;
    دع الكاتب: &متغير عدد;
    دع القارئ: &عدد;
    إذا (العلم) {
        الكاتب := &متغير القيمة;
    } وإلا {
        القارئ := &القيمة;
    };
    أرجع *الكاتب + *القارئ;
}

عرف الرئيسية(): عدد { أرجع 0; }
