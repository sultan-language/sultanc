// خرج-تشخيص-إنجليزي: json_derive_field.en.stderr
// A `@@json` field type the derivation cannot encode is a compile-time error
// at the field, not a JSON null at run time.
@@جسون
نوع نقطة = {
    س: ص32,
    زوج: (ص32, ص32)
};
عرف الرئيسية(): ص32 {
    أرجع 0;
}
