// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/e2e/match_bindings_keep_borrow.sn
// خرج-تشخيص-عربي: match_bindings_keep_borrow.ar.stderr
// خرج-تشخيص-إنجليزي: match_bindings_keep_borrow.en.stderr
// يُبقي رابط المطابقة الاستعارة التي تحملها قيمته ما دام مستعملا، أيا كان المميَّز: صف
// محليات مرجعية، أو صف استعارات جديدة، أو زوج يعيده نداء، أو مُنشئ حول استعارة، أو زوج
// متداخل في صف، أو بقية قابلة للكتابة تحت `طابق &متغير م`. فلا تُقرأ القيمة المستعارة ولا
// يُسنَد إليها في أثناء ذلك. وتُبلغ كل دالة عن أول خطأ فيها.
عرف اصنع_زوجا(الهدف: &متغير عدد): (&متغير عدد، عدد) { أرجع (الهدف، 1); }

عرف صف_محليات_مرجعية(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن الأخرى: عدد = 2;
    ليكن مرجع_أ: &عدد = &القيمة;
    ليكن مرجع_ب: &عدد = &الأخرى;
    طابق (مرجع_أ، مرجع_ب) مع
    | (س، ص) -> {
        القيمة := 5;
        أرجع *س + *ص;
    };
}

عرف صف_استعارات(): عدد {
    ليكن الأول: متغير عدد = 1;
    ليكن الثاني: عدد = 2;
    طابق (&متغير الأول، &الثاني) مع
    | (الكاتب، القارئ) -> {
        ليكن النسخة: عدد = الأول;
        *الكاتب := *القارئ + النسخة;
    };
    أرجع الأول;
}

عرف زوج_من_نداء(): عدد {
    ليكن القيمة: متغير عدد = 1;
    طابق اصنع_زوجا(&متغير القيمة) مع
    | (الكاتب، الخطوة) -> {
        ليكن النسخة: عدد = القيمة;
        *الكاتب := النسخة + الخطوة;
    };
    أرجع القيمة;
}

عرف منشئ_حول_استعارة(): عدد {
    ليكن القيمة: متغير عدد = 1;
    طابق موجود(&متغير القيمة) مع
    | موجود(الكاتب) -> {
        ليكن النسخة: عدد = القيمة;
        *الكاتب := النسخة + 1;
    }
    | لا_شيء -> { };
    أرجع القيمة;
}

عرف زوج_متداخل(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    طابق (اقسم_قابلا_للتعديل(&متغير القيم، 1)، 10) مع
    | ((اليسار، اليمين)، ك) -> {
        ليكن الأول: عدد = القيم[0];
        أرجع اليسار[0] + اليمين[0] + الأول + ك;
    };
}

عرف بقية_قابلة_للكتابة(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    طابق &متغير القيم مع
    | [الأول، بقية الذيل] -> {
        ليكن النسخة: عدد = القيم[0];
        الذيل[0] := النسخة + الأول;
    }
    | [] -> { };
    أرجع القيم[1];
}

عرف الرئيسية(): عدد { أرجع 0; }
