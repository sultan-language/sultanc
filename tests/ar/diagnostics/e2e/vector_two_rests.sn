// اختبار: رفض
// تشخيص: SULTANC-PARSE-PATTERN
// نظير: tests/en/diagnostics/e2e/vector_two_rests.sn
// خرج-تشخيص-عربي: vector_two_rests.ar.stderr
// خرج-تشخيص-إنجليزي: vector_two_rests.en.stderr
// `بقية` واحدة لكل نمط متجه: مع اثنتين لا يُعرف ما تنوب عنه كل منهما.
عرف د(م: متجه عدد): عدد {
    طابق م مع
    | [أ، بقية _، ب، بقية _] -> { أرجع أ + ب; }
    | _ -> { أرجع 0; };
}
عرف الرئيسية(): عدد {
    ليكن م: متجه عدد = [1، 2];
    أرجع د(م);
}
