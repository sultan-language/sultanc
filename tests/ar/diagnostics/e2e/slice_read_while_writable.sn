// ما دام عرض قابل للكتابة من متجه مستعملا، لا يُقرأ المتجه بطريق آخر.
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    ليكن الجزء: متغير [] عدد = &متغير القيم[..];
    ليكن الأول: عدد = القيم[0];
    الجزء[0] := الأول;
    أرجع 0;
}
