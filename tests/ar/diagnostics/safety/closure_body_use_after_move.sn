// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/closure_body_use_after_move.sn
// يُفحص جسم الإغلاق كجسم الدالة: تمرير معامله المملوك `s` بالقيمة ينقله،
// فالاستخدام الثاني يقرأ قيمة منقولة.
عرف size(s: نص): عدد { أرجع الطول(s) مثل عدد; }

عرف الرئيسية(): عدد {
    دع twice: دالة(نص): عدد = دالة(s: نص): عدد -> size(s) + size(s);
    أرجع twice("ab");
}
