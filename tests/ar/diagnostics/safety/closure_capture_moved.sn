// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/closure_capture_moved.sn
// تلتقط الدالة المغلقة النص المملوك: فتملكه البيئة من البناء فصاعدًا، وقراءته
// بعد ذلك عبر المتغير المحلي استعمال بعد النقل.
عرف الرئيسية(): عدد {
    ليكن النص: نص = «ملتقط»;
    ليكن د: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + (الطول(النص) مثل عدد);
    أرجع د(1) + (الطول(النص) مثل عدد);
}
