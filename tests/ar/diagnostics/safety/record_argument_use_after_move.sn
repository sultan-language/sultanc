// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/record_argument_use_after_move.sn
// السجل المالك الممرر بالقيمة ينتقل إلى المستدعى، حتى حين تمرره الخلفيات
// مرجعًا خفيًا (عنوان تخزين المستدعي): قراءته بعد النداء تقرأ قيمة منقولة.
نوع مملوك = { الاسم: نص, الوسوم: متجه نص, العدد: عدد };

عرف استهلك(س: مملوك): عدد { أرجع س.العدد; }

عرف الرئيسية(): عدد {
    دع الوسوم: متجه نص = [];
    دع ر: مملوك = { الاسم: "سجل", الوسوم: الوسوم, العدد: 40 };
    دع الأول: عدد = استهلك(ر);
    أرجع الأول + ر.العدد;
}
