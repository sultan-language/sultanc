// اختبار: رفض
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/en/diagnostics/safety/c_address_call_outside_unsafe.sn
// شكل النداء عند عنوان (اسم الربط `*`) ينادي ما يحمله معامله الأول بتوقيع لا يتحقق منه شيء: يتطلب نطاقا غير آمن
// كبدائي_نداء_عنوان_سي.
خارجي عرف نادِ_عند(العنوان: ط64, القيمة: ص64): ص64 = «*»;

عرف الرئيسية(): عدد {
    دع الناتج: ص64 = نادِ_عند(0 مثل ط64, 1);
    أرجع 0;
}
