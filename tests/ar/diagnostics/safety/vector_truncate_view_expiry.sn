// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/vector_truncate_view_expiry.sn
// `ك` تعرض العنصر الأول عبر `الكلمات`؛ واقتطع يكتب المتجه عبر المرجع نفسه
// ويسقط ذلك العنصر، فينهي العرض.
عرف قصر(الكلمات: &متغير متجه نص): عدد {
    دع ك: نص = (*الكلمات)[0];
    اقتطع(*الكلمات, 0);
    أرجع الطول(ك);
}

عرف الرئيسية(): عدد {
    دع الكلمات: متغير متجه نص = [];
    ألحق(الكلمات, "أ");
    أرجع قصر(&متغير الكلمات);
}
