// اختبار: رفض
// تشخيص: SULTANC-THREAD-CAPTURE-REFERENCE
// نظير: tests/en/diagnostics/safety/thread_capture_reference.sn
// فحص التقاطات الإطلاق (docs/en/reference/type-system.md، «قواعد الالتقاط في الخيوط»): لا
// يجوز لإغلاق يُسلَّم إلى خيط آخر أن يلتقط مرجعا مستعارا، لأن الخيط قد يعيش أطول
// من التخزين المستعار (قيد 'static على spawn في Rust). انقل قيمة مملوكة إليه، أو
// شاركها عبر مشترك.
استورد std.thread.thread;

عرف الأول(م: &متجه ص64): ص64 { أرجع (*م)[0]; }
عرف احتفظ(س: ص64): فراغ { }

عرف شغل(القيم: &متجه ص64): فراغ {
    طابق أطلق(دالة(): فراغ -> احتفظ(الأول(القيم))) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عرف الرئيسية(): ص32 {
    دع القيم: متجه ص64 = [1 مثل ص64, 2 مثل ص64];
    شغل(&القيم);
    أرجع 0;
}
