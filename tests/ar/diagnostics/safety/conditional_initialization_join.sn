// اختبار: رفض
// تشخيص: SULTANC-FLOW-USE-BEFORE-INITIALIZATION
// نظير: tests/en/diagnostics/safety/conditional_initialization_join.sn
// يهيئ فرع واحد فقط النص؛ وبعد الالتقاء يكون مهيأ على بعض المسارات فقط،
// فقراءته استعمال قبل التهيئة.
عرف الرئيسية(): عدد {
    دع العلم: منطقي = صواب;
    دع النص: نص;
    إذا (العلم) {
        النص := «مضبوط»;
    };
    أرجع الطول(النص) مثل عدد;
}
