// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/reborrow_through_parameter.sn
// `الأول` reads through `المصدر`; the call may grow the vector it points into.
نوع جدول = {
    العناصر: متجه عدد
};

عرف كبر(الهدف: &متغير جدول): عدد {
    ألحق((*الهدف).العناصر, 9);
    أرجع 0;
}

عرف افحص(المصدر: &متغير جدول): عدد {
    دع الأول: &عدد = &(*المصدر).العناصر[0];
    دع المهمل: عدد = كبر(المصدر);
    أرجع *الأول;
}

عرف الرئيسية(): عدد {
    دع البداية: متجه عدد = [1, 2, 3];
    دع القيمة: متغير جدول = { العناصر: البداية };
    أرجع افحص(&متغير القيمة);
}
