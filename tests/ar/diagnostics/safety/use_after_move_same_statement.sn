// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/use_after_move_same_statement.sn
// خرج-تشخيص-عربي: use_after_move_same_statement.ar.stderr
// خرج-تشخيص-إنجليزي: use_after_move_same_statement.en.stderr
// تُقيَّم المعاملات من اليسار إلى اليمين: ينقل المعامل الأيسر النص إلى `استهلك`،
// فيقرأ المعامل الأيمن قيمة منقولة في العبارة نفسها.
عرف استهلك(النص: نص): عدد { أرجع الطول(النص) مثل عدد; }

عرف الرئيسية(): عدد {
    دع النص: نص = «أربعة»;
    أرجع استهلك(النص) + (الطول(النص) مثل عدد);
}
