// اختبار: رفض
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/diagnostics/safety/vector_pop_borrow_conflict.sn
// أزل_الأخير يكتب المتجه كما يكتبه ألحق: لا يعمل ما دام مرجع إلى المتجه حيا
// (العنصر الذي يشير إليه سينقل خارجه).
عرف الرئيسية(): عدد {
    دع القيم: متغير متجه عدد = [40, 2];
    دع الأول: &عدد = &القيم[0];
    طابق أزل_الأخير(القيم) مع
    | اختياري.موجود(ق) -> { أرجع *الأول + ق; }
    | اختياري.لا_شيء -> { أرجع 0; };
}
