// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/diagnostics/safety/loop_backedge_move.sn
// ينقل جسم الحلقة النص ولا يعطيه قيمة جديدة أبدًا: فتحمل حافة الرجوع حالة
// النقل إلى استعمال التكرار التالي. ويُرفض البرنامج قبل أن تشغله أي خلفية أو
// المفسر.
عرف استهلك(القيمة: نص): عدد {
    أرجع الطول(القيمة) مثل عدد;
}

عرف الرئيسية(): عدد {
    ليكن النص: نص = «بداية»;
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 3) {
        المجموع := المجموع + استهلك(النص);
        ف := ف + 1;
    }
    أرجع المجموع;
}
