// اختبار: رفض
// تشخيص: SULTANC-THREAD-CAPTURE-RAW-POINTER
// نظير: tests/en/diagnostics/safety/thread_capture_raw_pointer.sn
// فحص التقاطات الإطلاق (docs/TYPE_SYSTEM.md، «قواعد الالتقاط في الخيوط»): لا
// يجوز لإغلاق يُسلَّم إلى خيط آخر أن يلتقط مؤشرا خاما، فهو غير آمن للإرسال
// (‎*mut T في Rust ليس Send)، إلا إن كان الإطلاق داخل كتلة غير آمنة. شارك حالة
// الكومة عبر std.sync بدلا من ذلك.
استورد std.thread.thread;

نوع خانة = { القيمة: ط64 };

عرف اكتب_العلامة(م: *متغير خانة): فراغ { غير_آمن { (*م).القيمة := 7 مثل ط64; } }

عرف الرئيسية(): ص32 {
    دع خ: متغير خانة = { القيمة: 0 مثل ط64 };
    دع م: *متغير خانة = &متغير خ;
    طابق أطلق(دالة(): فراغ -> اكتب_العلامة(م)) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
    أرجع 0;
}
