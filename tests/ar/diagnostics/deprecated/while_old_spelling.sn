// اختبار: قبول
// تشخيص: SULTANC-SYNTAX-DEPRECATED-SPELLING
// خرج-تشخيص-عربي: while_old_spelling.ar.stderr
// خرج-تشخيص-إنجليزي: while_old_spelling.en.stderr
// مرحلة0: نعم
// rename_tokens: keep-deprecated wave 1
// التهجئة القديمة `بينما` تبقى مقبولة إصدارا واحدا: يُبنى البرنامج، وكل استخدام
// لها تحذير واحد (ثلاثة هنا، أحدها بتطويل)، والتهجئة الجديدة `طالما` بلا تحذير.
عرف الرئيسية(): عدد {
    دع س: متغير عدد = 0;
    بينما (س < 3) { س := س + 1; }
    بيـنما (س < 5) { س := س + 1; }
    طالما (س < 7) { س := س + 1; }
    دع ص: متغير عدد = 0;
    بينما (ص < س) { ص := ص + 1; }
    أرجع ص - 7;
}
