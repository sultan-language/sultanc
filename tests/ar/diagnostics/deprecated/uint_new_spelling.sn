// اختبار: قبول
// خطأ-قياسي: <فارغ>
// مرحلة0: نعم
// العدد الطبيعي `طبيعي` (يشمل الصفر) والأنواع `ط8` و`ط16` و`ط32` و`ط64`
// بالتهجئة الجديدة: لا تحذير.
عرف اجمع(أ: طبيعي, ب: طبيعي): طبيعي {
    أرجع أ + ب;
}

عرف الرئيسية(): عدد {
    دع ث: ط8 = 1;
    دع س: ط16 = 2;
    دع ع: ط32 = 3;
    دع ف: ط64 = 4;
    دع ق: ط64 = ف + (ث مثل ط64) + (س مثل ط64) + (ع مثل ط64);
    أرجع (اجمع(ق مثل طبيعي, 0) مثل عدد) - 10;
}
