// اختبار: قبول
// تشخيص: SULTANC-SYNTAX-DEPRECATED-SPELLING
// خرج-تشخيص-عربي: option_old_spelling.ar.stderr
// خرج-تشخيص-إنجليزي: option_old_spelling.en.stderr
// مرحلة0: نعم
// rename_tokens: keep-deprecated wave 2
// التهجئتان القديمتان `اختيار` (النوع) و`بعض` (المنشئ) تبقيان مقبولتين إصدارا
// واحدا: لكل استخدام تحذير واحد، في النوع وفي التعبير وفي النمط (سبعة هنا).
// متغير اسمه `اختيار` ليس النوع، فلا تحذير له.
عرف أول(س: عدد): اختيار عدد {
    إذا (س > 0) { أرجع اختيار.بعض(س); };
    أرجع اختيار.لا_شيء();
}

عرف الرئيسية(): عدد {
    دع اختيار: عدد = 3;
    طابق أول(اختيار) مع
    | اختيار.بعض(ن) -> { أرجع ن - 3; }
    | اختيار.لا_شيء -> { أرجع 1; };
}
