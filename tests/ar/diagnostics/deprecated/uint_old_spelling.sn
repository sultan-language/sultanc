// اختبار: قبول
// تشخيص: SULTANC-SYNTAX-DEPRECATED-SPELLING
// خرج-تشخيص-عربي: uint_old_spelling.ar.stderr
// خرج-تشخيص-إنجليزي: uint_old_spelling.en.stderr
// مرحلة0: نعم
// rename_tokens: keep-deprecated wave 3
// التهجئات القديمة `غير_موقع` و`غ8` و`غ16` و`غ32` و`غ64` تبقى مقبولة إصدارا
// واحدا: لكل استخدام تحذير واحد (ستة هنا)، والتهجئات الجديدة بلا تحذير.
عرف اجمع(أ: غير_موقع, ب: طبيعي): غير_موقع {
    أرجع أ + ب;
}

عرف الرئيسية(): عدد {
    دع ث: غ8 = 1;
    دع س: غ16 = 2;
    دع ع: غ32 = 3;
    دع ف: غ64 = 4;
    دع ق: ط64 = ف + (ث مثل ط64) + (س مثل ط64) + (ع مثل ط64);
    أرجع (اجمع(ق مثل طبيعي, 0) مثل عدد) - 10;
}
