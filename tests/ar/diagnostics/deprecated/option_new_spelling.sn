// اختبار: قبول
// خطأ-قياسي: <فارغ>
// مرحلة0: نعم
// النوع `اختياري` ومنشئه `موجود` بالتهجئة الجديدة: لا تحذير، ولا لمتغير اسمه `اختيار`.
عرف أول(س: عدد): اختياري عدد {
    لو (س > 0) { أرجع اختياري.موجود(س); };
    أرجع اختياري.لا_شيء();
}

عرف الرئيسية(): عدد {
    دع اختيار: عدد = 3;
    طابق أول(اختيار) مع
    | اختياري.موجود(ن) -> { أرجع ن - 3; }
    | اختياري.لا_شيء -> { أرجع 1; };
}
