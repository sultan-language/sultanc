عرف الرئيسية(): عدد {
    ليكن مسار: نص = "build/stage0-utf8.tmp";
    ليكن محتوى: نص = "ع";
    ليكن مكتوب: نتيجة عدد, عدد = اكتب_ملف(مسار, محتوى);
    طابق مكتوب مع
    | نتيجة.خطأ(رمز) -> { أرجع رمز; }
    | نتيجة.نجح(عدد_البايتات) -> {
        ليكن محمّل: نتيجة نص, عدد = اقرأ_ملف(مسار);
        طابق محمّل مع
        | نتيجة.خطأ(رمز) -> { أرجع رمز; }
        | نتيجة.نجح(نص_محمّل) -> {
            إذا (عدد_البايتات > 0) {
                إذا (نص_محمّل[0] > 0) {
                    أرجع 42;
                };
            };
            أرجع 0;
        }
    }
}
