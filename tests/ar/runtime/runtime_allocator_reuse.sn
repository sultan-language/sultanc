// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// المخصص: الكتل الكبيرة الحرة المتجاورة تُدمج وتُقسم، والكتلة عند القمة تخفضها،
// والكتلة تنمو داخل جارتها الحرة.
استورد std.os.allocation;

عرف الرئيسية(): عدد {
    // A and B (large) separated from the top by a small guard block.
    دع أ: ط64 = خصص_ذاكرة_التشغيل(65536);
    دع ب: ط64 = خصص_ذاكرة_التشغيل(65536);
    دع حارس: ط64 = خصص_ذاكرة_التشغيل(16);
    لو (أ == 0 || ب == 0 || حارس == 0) { أرجع 1; };
    حرر_ذاكرة_التشغيل(أ);
    حرر_ذاكرة_التشغيل(ب);
    // A and B merged: a request bigger than either fits at A.
    دع ج: ط64 = خصص_ذاكرة_التشغيل(120000);
    لو (ج != أ) { أرجع 2; };
    // The rest after C was split off: a 5000-byte request lands right after C.
    دع د: ط64 = خصص_ذاكرة_التشغيل(5000);
    لو (د <= ج || د >= حارس) { أرجع 3; };
    // Releasing the block at the top lowers the top: the next block reuses it.
    دع هـ: ط64 = خصص_ذاكرة_التشغيل(300000);
    حرر_ذاكرة_التشغيل(هـ);
    دع و: ط64 = خصص_ذاكرة_التشغيل(200000);
    لو (و != هـ) { أرجع 4; };
    // Growing into a free neighbour keeps the address.
    دع ز: ط64 = خصص_ذاكرة_التشغيل(10000);
    دع ح: ط64 = خصص_ذاكرة_التشغيل(10000);
    دع ط: ط64 = خصص_ذاكرة_التشغيل(16);
    حرر_ذاكرة_التشغيل(ح);
    لو (أعد_تخصيص_ذاكرة_التشغيل(ز, 19000) != ز) { أرجع 5; };
    // Null is ignored.
    حرر_ذاكرة_التشغيل(0);
    حرر_ذاكرة_التشغيل(ج);
    حرر_ذاكرة_التشغيل(د);
    حرر_ذاكرة_التشغيل(و);
    حرر_ذاكرة_التشغيل(ز);
    حرر_ذاكرة_التشغيل(ط);
    حرر_ذاكرة_التشغيل(حارس);
    أرجع 42;
}
