// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تكرار تخصيص وتحرير: متجهات بأحجام صغيرة وكبيرة تُبنى وتنمو وتُحرر بغير
// ترتيبها ثم تُبنى من جديد، فتُقسم الكتل الحرة وتُدمج وتعود إلى القمة.
// يُفحص كل عنصر.
عرف املأ(العدد: طبيعي, البذرة: طبيعي): متجه طبيعي {
    دع العناصر: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(العناصر, البذرة + ف);
        ف := ف + 1;
    }
    أرجع العناصر;
}

عرف سليم(العناصر: &متجه طبيعي, العدد: طبيعي, البذرة: طبيعي): منطقي {
    لو ((الطول(*العناصر) مثل طبيعي) != العدد) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو ((*العناصر)[ف] != البذرة + ف) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف حجم_الجولة(الجولة: طبيعي, الخانة: طبيعي): طبيعي {
    دع الاختيار: طبيعي = (الجولة * 7 + الخانة * 13) % 6;
    لو (الاختيار == 0) { أرجع 3; };
    لو (الاختيار == 1) { أرجع 40; };
    لو (الاختيار == 2) { أرجع 700; };
    لو (الاختيار == 3) { أرجع 9000; };
    لو (الاختيار == 4) { أرجع 30000; };
    أرجع 120;
}

عرف الرئيسية(): عدد {
    دع الجولة: متغير طبيعي = 0;
    دع المحفوظة: متغير متجه متجه طبيعي = [];
    طالما (الجولة < 40) {
        دع أ: متجه طبيعي = املأ(حجم_الجولة(الجولة, 1), الجولة);
        دع ب: متجه طبيعي = املأ(حجم_الجولة(الجولة, 2), الجولة + 1);
        دع ج: متجه طبيعي = املأ(حجم_الجولة(الجولة, 3), الجولة + 2);
        لو (!سليم(&أ, حجم_الجولة(الجولة, 1), الجولة)) { أرجع 1; };
        لو (!سليم(&ب, حجم_الجولة(الجولة, 2), الجولة + 1)) { أرجع 2; };
        لو (!سليم(&ج, حجم_الجولة(الجولة, 3), الجولة + 2)) { أرجع 3; };
        لو (الجولة % 5 == 0) { ألحق(المحفوظة, املأ(حجم_الجولة(الجولة, 4), الجولة * 3)); };
        الجولة := الجولة + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(المحفوظة) مثل طبيعي)) {
        لو (!سليم(&المحفوظة[ك], حجم_الجولة(ك * 5, 4), ك * 15)) { أرجع 4; };
        ك := ك + 1;
    }
    أرجع 42;
}
