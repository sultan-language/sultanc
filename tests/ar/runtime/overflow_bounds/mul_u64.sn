// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: mul_u64.stderr
// نظير: tests/en/runtime/overflow_bounds/mul_u64.sn
// A checked u64 multiply past its bound (2^32 times 2^32) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
عرف الرئيسية(): عدد {
    ليكن القيم: متجه ط64 = [4294967296, 4294967296];
    ليكن الناتج: ط64 = القيم[0] * القيم[1];
    إذا (الناتج == القيم[0]) { أرجع 3; };
    أرجع 0;
}
