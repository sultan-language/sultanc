// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: sub_u8.stderr
// نظير: tests/en/runtime/overflow_bounds/sub_u8.sn
// A checked u8 subtract past its bound (0 minus 1) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
عرف الرئيسية(): عدد {
    ليكن القيم: متجه ط8 = [0, 1];
    ليكن الناتج: ط8 = القيم[0] - القيم[1];
    إذا (الناتج == القيم[0]) { أرجع 3; };
    أرجع 0;
}
