// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: sub_i16.stderr
// نظير: tests/en/runtime/overflow_bounds/sub_i16.sn
// A checked i16 subtract past its bound (the least value minus 1) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
عرف الرئيسية(): عدد {
    ليكن القيم: متجه ص16 = [-32768, 1];
    ليكن الناتج: ص16 = القيم[0] - القيم[1];
    إذا (الناتج == القيم[0]) { أرجع 3; };
    أرجع 0;
}
