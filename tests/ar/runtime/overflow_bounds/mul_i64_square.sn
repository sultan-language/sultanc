// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: mul_i64_square.stderr
// نظير: tests/en/runtime/overflow_bounds/mul_i64_square.sn
// A checked i64 multiply past its bound (3037000500 squared) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
عرف الرئيسية(): عدد {
    ليكن القيم: متجه ص64 = [3037000500, 3037000500];
    ليكن الناتج: ص64 = القيم[0] * القيم[1];
    إذا (الناتج == القيم[0]) { أرجع 3; };
    أرجع 0;
}
