// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// المخصص: الكتل الصغيرة المحررة تنتظر في قائمة حجمها ولا تُدمج أبدا؛
// أعد_الذاكرة_الحرة_للنظام تدمج متتاليتها في كتلة كبيرة حرة واحدة تعود صفحاتها
// إلى النظام. لا تتغير البايتات الحية، والمساحة المدمجة تخدم طلبا كبيرا.
استورد std.os.allocation;

عرف الرئيسية(): عدد {
    // 4096 blocks of 512 bytes (2 MiB) carved one after another from the
    // top, and a guard block after them so the run does not end at the top.
    دع الأولى: ط64 = خصص_ذاكرة_التشغيل(500);
    إذا (الأولى == 0) { أرجع 1; };
    دع ف: متغير ط64 = 1;
    طالما (ف < 4096) {
        إذا (خصص_ذاكرة_التشغيل(500) != الأولى + ف * 512) { أرجع 2; };
        ف := ف + 1;
    }
    دع حارس: ط64 = خصص_ذاكرة_التشغيل(16);
    إذا (حارس != الأولى + 4096 * 512) { أرجع 3; };
    ف := 0;
    طالما (ف < 4096) {
        حرر_ذاكرة_التشغيل(الأولى + ف * 512);
        ف := ف + 1;
    }
    دع الحية: ط64 = بايتات_حية_مخصص_النظام();
    دع المستردة: ط64 = بايتات_مستردة_مخصص_النظام();
    أعد_الذاكرة_الحرة_للنظام();
    إذا (بايتات_حية_مخصص_النظام() != الحية) { أرجع 4; };
    إذا (بايتات_مستردة_مخصص_النظام() < المستردة + 1048576) { أرجع 5; };
    // The merged run holds a request of nearly its whole size.
    دع الكبيرة: ط64 = خصص_ذاكرة_التشغيل(2000000);
    إذا (الكبيرة != الأولى) { أرجع 6; };
    // A second pass finds nothing new to merge and changes nothing live.
    دع حية_الكبيرة: ط64 = بايتات_حية_مخصص_النظام();
    أعد_الذاكرة_الحرة_للنظام();
    إذا (بايتات_حية_مخصص_النظام() != حية_الكبيرة) { أرجع 7; };
    حرر_ذاكرة_التشغيل(الكبيرة);
    حرر_ذاكرة_التشغيل(حارس);
    أرجع 42;
}
