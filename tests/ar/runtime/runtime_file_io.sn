عرف القلعة(): عدد {
    دع مسار: نص = "stage0-runtime.tmp";
    دع محتوى: نص = "*";
    دع مكتوب: نتيجة عدد, عدد = اكتب_ملف(مسار, محتوى);
    طابق مكتوب مع
    | نتيجة.خطأ(رمز) -> { أرجع رمز; }
    | نتيجة.نجح(عدد_البايتات) -> {
        دع محمّل: نتيجة نص, عدد = اقرأ_ملف(مسار);
        طابق محمّل مع
        | نتيجة.خطأ(رمز) -> { أرجع رمز; }
        | نتيجة.نجح(نص_محمّل) -> {
            لو (عدد_البايتات > 0) {
                لو (نص_محمّل[0] > 0) {
                    أرجع 42;
                };
            };
            أرجع 0;
        }
    }
}
