// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=ar
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: slice_end_ar.stderr
// نظير: tests/en/runtime/failure/slice_end_ar.sn
// A slice whose end is at or past the length of the vector (end < length) (docs/en/reference/errors.md, "Runtime checks")
// stops the program through the panic path: the frame "the program stopped",
// then the end, and the place of the slice, exit status 1.
عرف الرئيسية(): عدد {
    ليكن القيم: متجه عدد = [10, 20, 30];
    ليكن الأخير: عدد = 3;
    ليكن الجزء: [] عدد = القيم[1..الأخير];
    أرجع الطول(الجزء) مثل عدد;
}
