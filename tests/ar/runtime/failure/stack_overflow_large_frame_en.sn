// اختبار: تشغيل
// أهداف: x86_64-linux,aarch64-linux-gnu
// خروج: 1
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: stack_overflow_large_frame_en.stderr
// نظير: tests/en/runtime/failure/stack_overflow_large_frame_en.sn
// A recursion with no end whose frame (a 128 KiB local) is larger than the
// 64 KiB guard of a thread's stack: the prologue probes the frame page by page
// (docs/en/reference/targets.md, "Stack probes"), so the overflow faults in the
// guard instead of stepping over it into another thread's memory, and the
// report writes the frame "the program stopped" and the words of a stack
// overflow, exit status 1. Not run by the interpreter.
استورد المكتبة.خيوط.خيط;

// 64 و512 و4096 و32768 و131072 بايتا.
نوع و = { أ: ط64, ب: ط64, ج: ط64, د: ط64, هـ: ط64, ز: ط64, ح: ط64, ط: ط64 };
نوع س = { أ: و, ب: و, ج: و, د: و, هـ: و, ز: و, ح: و, ط: و };
نوع ص = { أ: س, ب: س, ج: س, د: س, هـ: س, ز: س, ح: س, ط: س };
نوع ع = { أ: ص, ب: ص, ج: ص, د: ص, هـ: ص, ز: ص, ح: ص, ط: ص };
نوع ق = { أ: ع, ب: ع, ج: ع, د: ع };

عرف ابن_و(ن: ط64): و { أرجع { أ: ن, ب: ن, ج: ن, د: ن, هـ: ن, ز: ن, ح: ن, ط: ن }; }
عرف ابن_س(ن: ط64): س { ليكن ك: و = ابن_و(ن); أرجع { أ: ك, ب: ك, ج: ك, د: ك, هـ: ك, ز: ك, ح: ك, ط: ك }; }
عرف ابن_ص(ن: ط64): ص { ليكن ك: س = ابن_س(ن); أرجع { أ: ك, ب: ك, ج: ك, د: ك, هـ: ك, ز: ك, ح: ك, ط: ك }; }
عرف ابن_ع(ن: ط64): ع { ليكن ك: ص = ابن_ص(ن); أرجع { أ: ك, ب: ك, ج: ك, د: ك, هـ: ك, ز: ك, ح: ك, ط: ك }; }

عرف واسع(البذرة: ط64): ط64 {
    ليكن الإطار: متغير ق = { أ: ابن_ع(البذرة), ب: ابن_ع(البذرة), ج: ابن_ع(البذرة), د: ابن_ع(البذرة) };
    الإطار.د.ط.ط.ط.ط := البذرة;
    ليكن التحت: ط64 = واسع(البذرة + 1);
    أرجع (التحت % 1000003) + الإطار.أ.أ.أ.أ.أ + الإطار.د.ط.ط.ط.ط;
}

عرف الرئيسية(): عدد {
    طابق أطلق_بقيمة(دالة(): ط64 -> واسع(1)) مع
    | نتيجة.نجح(م) -> {
        ليكن المقبض: متغير مقبض_خيط_بقيمة<ط64> = م;
        طابق انضم_بقيمة(&متغير المقبض) مع
        | اختياري.موجود(القيمة) -> { أرجع (القيمة % 100) مثل عدد; }
        | اختياري.لا_شيء -> { أرجع 3; };
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
}
