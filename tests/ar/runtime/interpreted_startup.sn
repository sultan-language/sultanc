// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// بيئة: SULTANC_STARTUP_PROBE=present
// نظير: tests/en/runtime/interpreted_startup.sn
// بيانات الإقلاع التي يراها البرنامج المفسر هي بيانات التنفيذي: الوسائط
// فيها البرنامج نفسه فقط، والبيئة التي بدأ بها كاملة لا متغيرات اللغة
// وحدها (PATH ومتغير مضبوط لهذا التشغيل).
استورد std.process.argument_count;
استورد std.env.environment;

عرف الرئيسية(): عدد {
    لو (عدد_الوسائط() != 1) { أرجع 1; };
    دع المسبار: نص = «SULTANC_STARTUP_PROBE»;
    طابق متغير_بيئة(&المسبار) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        لو (الطول(القيمة) != 7) { أرجع 2; };
    }
    | _ -> { أرجع 3; };
    دع المسار: نص = «PATH»;
    طابق متغير_بيئة(&المسار) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> { }
    | _ -> { أرجع 4; };
    أرجع 42;
}
