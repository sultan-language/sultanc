خارجي عرف getdirentriesattr(
    واصف: ص32,
    صفات: *متغير غ8,
    مخزن: *متغير غ8,
    حجم: غير_موقع,
    عدد_مدخلات: *متغير غ32,
    أساس: *متغير غ32,
    حالة: *متغير غ32,
    خيارات: غ32
): ص32;

عرف القلعة(): ص32 {
    دع صفات: متغير غ8 = 0;
    دع مخزن: متغير غ8 = 0;
    دع عدد_مدخلات: متغير غ32 = 0;
    دع أساس: متغير غ32 = 0;
    دع حالة: متغير غ32 = 0;
    دع مؤشر_صفات: *متغير غ8 = & متغير صفات;
    دع مؤشر_مخزن: *متغير غ8 = & متغير مخزن;
    دع مؤشر_عدد: *متغير غ32 = & متغير عدد_مدخلات;
    دع مؤشر_أساس: *متغير غ32 = & متغير أساس;
    دع مؤشر_حالة: *متغير غ32 = & متغير حالة;
    غير_آمن {
        دع رمز: ص32 = getdirentriesattr(-1, مؤشر_صفات, مؤشر_مخزن, 0, مؤشر_عدد, مؤشر_أساس, مؤشر_حالة, 0);
        لو (رمز < 0) {
            أرجع 42;
        };
    }
    أرجع 0;
}
