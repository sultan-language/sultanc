خارجي عرف getdirentriesattr(
    واصف: ص32,
    صفات: *متغير ط8,
    مخزن: *متغير ط8,
    حجم: طبيعي,
    عدد_مدخلات: *متغير ط32,
    أساس: *متغير ط32,
    حالة: *متغير ط32,
    خيارات: ط32
): ص32;

عرف الرئيسية(): ص32 {
    ليكن صفات: متغير ط8 = 0;
    ليكن مخزن: متغير ط8 = 0;
    ليكن عدد_مدخلات: متغير ط32 = 0;
    ليكن أساس: متغير ط32 = 0;
    ليكن حالة: متغير ط32 = 0;
    ليكن مؤشر_صفات: *متغير ط8 = & متغير صفات;
    ليكن مؤشر_مخزن: *متغير ط8 = & متغير مخزن;
    ليكن مؤشر_عدد: *متغير ط32 = & متغير عدد_مدخلات;
    ليكن مؤشر_أساس: *متغير ط32 = & متغير أساس;
    ليكن مؤشر_حالة: *متغير ط32 = & متغير حالة;
    غير_آمن {
        ليكن رمز: ص32 = getdirentriesattr(-1, مؤشر_صفات, مؤشر_مخزن, 0, مؤشر_عدد, مؤشر_أساس, مؤشر_حالة, 0);
        إذا (رمز < 0) {
            أرجع 42;
        };
    }
    أرجع 0;
}
