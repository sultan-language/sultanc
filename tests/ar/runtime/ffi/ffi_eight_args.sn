خارجي عرف getdirentriesattr(
    واصف: ص32,
    صفات: *متغير ط8,
    مخزن: *متغير ط8,
    حجم: طبيعي,
    عدد_مدخلات: *متغير ط32,
    أساس: *متغير ط32,
    حالة: *متغير ط32,
    خيارات: ط32
): ص32;

عرف الرئيسية(): ص32 {
    دع صفات: متغير ط8 = 0;
    دع مخزن: متغير ط8 = 0;
    دع عدد_مدخلات: متغير ط32 = 0;
    دع أساس: متغير ط32 = 0;
    دع حالة: متغير ط32 = 0;
    دع مؤشر_صفات: *متغير ط8 = & متغير صفات;
    دع مؤشر_مخزن: *متغير ط8 = & متغير مخزن;
    دع مؤشر_عدد: *متغير ط32 = & متغير عدد_مدخلات;
    دع مؤشر_أساس: *متغير ط32 = & متغير أساس;
    دع مؤشر_حالة: *متغير ط32 = & متغير حالة;
    غير_آمن {
        دع رمز: ص32 = getdirentriesattr(-1, مؤشر_صفات, مؤشر_مخزن, 0, مؤشر_عدد, مؤشر_أساس, مؤشر_حالة, 0);
        إذا (رمز < 0) {
            أرجع 42;
        };
    }
    أرجع 0;
}
