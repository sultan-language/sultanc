خارجي عرف abs(قيمة: ص32): ص32;

عرف زد_واحد(قيمة: ص32): ص32 {
    أرجع قيمة + 1;
}

عرف الرئيسية(): ص32 {
    ليكن قبل: ص32 = زد_واحد(-43);
    ليكن محفوظ: ص32 = 40;
    غير_آمن {
        ليكن أول: ص32 = abs(قبل);
        ليكن ثان: ص32 = abs(-1);
        أرجع زد_واحد(أول - ثان) + محفوظ - 40;
    }
}
