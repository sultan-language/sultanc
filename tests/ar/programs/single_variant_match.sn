// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/single_variant_match.sn
// انحدار: مطابقة نوع ذي منشئ وحيد تربط الحمولة في الذراع، ويجب أن يهيمن
// الربط على مواضع استعماله في MSIR المتحقق.
نوع غلاف = | يحمل بنوع عدد;

عرف افتح(القيمة: غلاف): عدد {
    طابق القيمة مع
    | غلاف.يحمل(الداخل) -> { أرجع الداخل; };
}

عرف القلعة(): عدد {
    دع المجموع: متغير عدد = 0;
    دع العناصر: متجه غلاف = [غلاف.يحمل(40), غلاف.يحمل(2)];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(العناصر) مثل غير_موقع)) {
        دع العنصر: &غلاف = &العناصر[الفهرس];
        طابق *العنصر مع
        | غلاف.يحمل(الداخل) -> {
            لو (الداخل == 0) { أرجع 1; };
            المجموع := المجموع + افتح(غلاف.يحمل(الداخل));
        };
        الفهرس := الفهرس + 1;
    }
    أرجع المجموع;
}
