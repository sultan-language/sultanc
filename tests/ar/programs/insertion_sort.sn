// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/insertion_sort.sn
عرف القلعة(): عدد {
    دع القيم: متغير متجه عدد = [9, 4, 7, 1, 3, 8, 2, 6, 5];
    دع العدد: غير_موقع = الطول(القيم) مثل غير_موقع;
    دع دورة: متغير غير_موقع = 0;
    بينما (دورة < العدد) {
        دع ي: متغير غير_موقع = 1;
        دع الحد: غير_موقع = العدد - دورة;
        بينما (ي < الحد) {
            دع السابق: غير_موقع = ي - 1;
            لو (القيم[السابق] > القيم[ي]) {
                دع المؤقت: عدد = القيم[السابق];
                القيم[السابق] := القيم[ي];
                القيم[ي] := المؤقت;
            };
            ي := ي + 1;
        }
        دورة := دورة + 1;
    }
    دع ك: متغير غير_موقع = 0;
    بينما (ك < العدد) {
        لو (القيم[ك] != ((ك + 1) مثل عدد)) { أرجع 1; };
        ك := ك + 1;
    }
    أرجع 42;
}
