// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/insertion_sort.sn
عرف الرئيسية(): عدد {
    دع القيم: متغير متجه عدد = [9, 4, 7, 1, 3, 8, 2, 6, 5];
    دع العدد: طبيعي = الطول(القيم) مثل طبيعي;
    دع دورة: متغير طبيعي = 0;
    طالما (دورة < العدد) {
        دع ي: متغير طبيعي = 1;
        دع الحد: طبيعي = العدد - دورة;
        طالما (ي < الحد) {
            دع السابق: طبيعي = ي - 1;
            لو (القيم[السابق] > القيم[ي]) {
                دع المؤقت: عدد = القيم[السابق];
                القيم[السابق] := القيم[ي];
                القيم[ي] := المؤقت;
            };
            ي := ي + 1;
        }
        دورة := دورة + 1;
    }
    دع ك: متغير طبيعي = 0;
    طالما (ك < العدد) {
        لو (القيم[ك] != ((ك + 1) مثل عدد)) { أرجع 1; };
        ك := ك + 1;
    }
    أرجع 42;
}
