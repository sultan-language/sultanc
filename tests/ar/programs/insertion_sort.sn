// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/insertion_sort.sn
عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [9, 4, 7, 1, 3, 8, 2, 6, 5];
    ليكن العدد: طبيعي = الطول(القيم) مثل طبيعي;
    ليكن دورة: متغير طبيعي = 0;
    طالما (دورة < العدد) {
        ليكن ي: متغير طبيعي = 1;
        ليكن الحد: طبيعي = العدد - دورة;
        طالما (ي < الحد) {
            ليكن السابق: طبيعي = ي - 1;
            إذا (القيم[السابق] > القيم[ي]) {
                ليكن المؤقت: عدد = القيم[السابق];
                القيم[السابق] := القيم[ي];
                القيم[ي] := المؤقت;
            };
            ي := ي + 1;
        }
        دورة := دورة + 1;
    }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < العدد) {
        إذا (القيم[ك] != ((ك + 1) مثل عدد)) { أرجع 1; };
        ك := ك + 1;
    }
    أرجع 42;
}
