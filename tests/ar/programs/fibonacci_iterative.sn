// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/fibonacci_iterative.sn
عرف فيبوناتشي(ن: عدد): عدد {
    دع أ: متغير عدد = 0;
    دع ب: متغير عدد = 1;
    دع ف: متغير عدد = 0;
    بينما (ف < ن) {
        دع التالي: عدد = أ + ب;
        أ := ب;
        ب := التالي;
        ف := ف + 1;
    }
    أرجع أ;
}

عرف القلعة(): عدد {
    لو (فيبوناتشي(10) == 55) { أرجع 42; };
    أرجع 1;
}
