// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/sieve_eratosthenes.sn
عرف الرئيسية(): عدد {
    ليكن مركب: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ];
    ليكن ق: متغير طبيعي = 2;
    طالما ((ق * ق) < 32) {
        إذا (!مركب[ق]) {
            ليكن مضاعف: متغير طبيعي = ق * ق;
            طالما (مضاعف < 32) {
                مركب[مضاعف] := صواب;
                مضاعف := مضاعف + ق;
            }
        };
        ق := ق + 1;
    }
    ليكن العدد: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 2;
    طالما (ف < 32) {
        إذا (!مركب[ف]) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    إذا (العدد == 11) { أرجع 42; };
    أرجع 1;
}
