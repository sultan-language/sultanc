// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/sieve_eratosthenes.sn
عرف القلعة(): عدد {
    دع مركب: متغير متجه منطقي = [خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ, خطأ];
    دع ق: متغير غير_موقع = 2;
    بينما ((ق * ق) < 32) {
        لو (!مركب[ق]) {
            دع مضاعف: متغير غير_موقع = ق * ق;
            بينما (مضاعف < 32) {
                مركب[مضاعف] := صواب;
                مضاعف := مضاعف + ق;
            }
        };
        ق := ق + 1;
    }
    دع العدد: متغير عدد = 0;
    دع ف: متغير غير_موقع = 2;
    بينما (ف < 32) {
        لو (!مركب[ف]) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    لو (العدد == 11) { أرجع 42; };
    أرجع 1;
}
