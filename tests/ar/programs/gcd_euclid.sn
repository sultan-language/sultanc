// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/gcd_euclid.sn
عرف القاسم_المشترك(أ0: عدد, ب0: عدد): عدد {
    دع أ: متغير عدد = أ0;
    دع ب: متغير عدد = ب0;
    بينما (ب != 0) {
        دع الباقي: عدد = أ % ب;
        أ := ب;
        ب := الباقي;
    }
    أرجع أ;
}

عرف القلعة(): عدد {
    لو (القاسم_المشترك(1071, 462) == 21) { أرجع 42; };
    أرجع 1;
}
