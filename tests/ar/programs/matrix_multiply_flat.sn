// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/matrix_multiply_flat.sn
عرف الرئيسية(): عدد {
    ليكن أ: متجه عدد = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    ليكن ب: متجه عدد = [9, 8, 7, 6, 5, 4, 3, 2, 1];
    ليكن ج: متغير متجه عدد = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    ليكن الصف: متغير طبيعي = 0;
    طالما (الصف < 3) {
        ليكن العمود: متغير طبيعي = 0;
        طالما (العمود < 3) {
            ليكن ك: متغير طبيعي = 0;
            ليكن المجموع: متغير عدد = 0;
            طالما (ك < 3) {
                ليكن قاعدة_يسار: طبيعي = الصف * 3;
                ليكن قاعدة_يمين: طبيعي = ك * 3;
                ليكن موضع_يسار: طبيعي = قاعدة_يسار + ك;
                ليكن موضع_يمين: طبيعي = قاعدة_يمين + العمود;
                المجموع := المجموع + (أ[موضع_يسار] * ب[موضع_يمين]);
                ك := ك + 1;
            }
            ليكن قاعدة_الناتج: طبيعي = الصف * 3;
            ليكن موضع_الناتج: طبيعي = قاعدة_الناتج + العمود;
            ج[موضع_الناتج] := المجموع;
            العمود := العمود + 1;
        }
        الصف := الصف + 1;
    }
    إذا (ج[0] != 30) { أرجع 1; };
    إذا (ج[4] != 69) { أرجع 2; };
    إذا (ج[8] != 90) { أرجع 3; };
    أرجع 42;
}
