// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/prime_count.sn
عرف أولي(ن: عدد): منطقي {
    لو (ن < 2) { أرجع خطأ; };
    دع ق: متغير عدد = 2;
    بينما ((ق * ق) <= ن) {
        لو ((ن % ق) == 0) { أرجع خطأ; };
        ق := ق + 1;
    }
    أرجع صواب;
}

عرف القلعة(): عدد {
    دع العدد: متغير عدد = 0;
    دع ن: متغير عدد = 2;
    بينما (ن <= 100) {
        لو (أولي(ن)) { العدد := العدد + 1; };
        ن := ن + 1;
    }
    لو (العدد == 25) { أرجع 42; };
    أرجع 1;
}
