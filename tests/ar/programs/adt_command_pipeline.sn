// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/adt_command_pipeline.sn
نوع عملية = | جمع بنوع عدد | ضرب بنوع عدد;

عرف طبق(القيمة: عدد, العملية: عملية): عدد {
    طابق العملية مع
    | عملية.جمع(المقدار) -> { أرجع القيمة + المقدار; }
    | عملية.ضرب(المقدار) -> { أرجع القيمة * المقدار; };
}

عرف القلعة(): عدد {
    دع الأولى: عملية = عملية.جمع(2);
    دع الثانية: عملية = عملية.ضرب(3);
    دع الثالثة: عملية = عملية.جمع(6);
    دع قيمة1: عدد = طبق(10, الأولى);
    دع قيمة2: عدد = طبق(قيمة1, الثانية);
    دع قيمة3: عدد = طبق(قيمة2, الثالثة);
    لو (قيمة3 == 42) { أرجع 42; };
    أرجع 1;
}
