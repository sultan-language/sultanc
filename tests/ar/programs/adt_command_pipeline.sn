// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/programs/adt_command_pipeline.sn
نوع عملية = | جمع بنوع عدد | ضرب بنوع عدد;

عرف طبق(القيمة: عدد, العملية: عملية): عدد {
    طابق العملية مع
    | عملية.جمع(المقدار) -> { أرجع القيمة + المقدار; }
    | عملية.ضرب(المقدار) -> { أرجع القيمة * المقدار; };
}

عرف الرئيسية(): عدد {
    ليكن الأولى: عملية = عملية.جمع(2);
    ليكن الثانية: عملية = عملية.ضرب(3);
    ليكن الثالثة: عملية = عملية.جمع(6);
    ليكن قيمة1: عدد = طبق(10, الأولى);
    ليكن قيمة2: عدد = طبق(قيمة1, الثانية);
    ليكن قيمة3: عدد = طبق(قيمة2, الثالثة);
    إذا (قيمة3 == 42) { أرجع 42; };
    أرجع 1;
}
