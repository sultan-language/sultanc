استورد compiler.backend.architectures.arm64.systems.macos.abi_rules;
استورد compiler.backend.architectures.arm64.allocation_constraints;
استورد compiler.backend.target.target_registry;
استورد compiler.backend.layout.layout_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

عرف موقع_سجل_بفهرس(
    الموقع: &موقع_تمرير_واجهة,
    الفهرس: غير_موقع,
    الدور: دور_سجل_واجهة
): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الجزء) -> {
        طابق الجزء مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            أرجع المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح()
                && المرجع.الفهرس == الفهرس
                && المرجع.الدور == الدور;
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف موقع_مكدس(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الجزء) -> {
        طابق الجزء مع
        | موضع_جزء_واجهة.مكدس(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف القلعة(): عدد {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع المعاملات: متجه معرف_نوع = [ص64, ص64, ص64, ص64, ص64, ص64, ص64, ص64, ص64, ص64];
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع الهدف: واصف_هدف = الأهداف[0];
    دع التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();

    لو (محاذاة_إطار_ماك_ذراع_أربعة_وستون() != 16) { أرجع 1; };

    طابق صنف_واجهة_ماك_ذراع_أربعة_وستون_دالة(
        &الأنواع, &الهدف, &متغير التخطيط, &المعاملات, ص64
    ) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(الخطة) -> {
        لو ((الطول(الخطة.المعاملات) مثل غير_موقع) != 10) { أرجع 3; };
        لو (!موقع_سجل_بفهرس(&الخطة.المعاملات[0].الموقع, 0, دور_سجل_واجهة.معامل())) { أرجع 4; };
        لو (!موقع_سجل_بفهرس(&الخطة.المعاملات[7].الموقع, 7, دور_سجل_واجهة.معامل())) { أرجع 5; };
        لو (!موقع_مكدس(&الخطة.المعاملات[8].الموقع)) { أرجع 6; };
        لو (!موقع_مكدس(&الخطة.المعاملات[9].الموقع)) { أرجع 7; };
        لو (!موقع_سجل_بفهرس(&الخطة.الناتج.الموقع, 0, دور_سجل_واجهة.ناتج())) { أرجع 8; };
        لو (الخطة.محاذاة_مكدس_النداء != 16) { أرجع 9; };
    };

    دع المحفوظة: متجه معرف_سجل_فعلي = سجلات_ذراع_محفوظة_قابلة_للتخصيص(&الهدف);
    لو ((الطول(المحفوظة) مثل غير_موقع) != 7) { أرجع 10; };
    لو (المحفوظة[0].القيمة != 22 || المحفوظة[6].القيمة != 28) { أرجع 11; };

    دع الانسكاب: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_ذراع_للهدف(&الهدف);
    لو ((الطول(الانسكاب) مثل غير_موقع) != 3) { أرجع 12; };
    لو (الانسكاب[0].القيمة != 19 || الانسكاب[2].القيمة != 21) { أرجع 13; };

    أرجع 42;
}
