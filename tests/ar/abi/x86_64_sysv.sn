استورد compiler.backend.abi.abi_model;
استورد compiler.backend.codegen.allocation_contract;
استورد compiler.backend.target.target_model;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_identity;
استورد compiler.backend.architectures.x86_64.systems.linux.abi_rules;
استورد compiler.backend.architectures.x86_64.systems.linux.register_rules;
استورد compiler.backend.target.target_registry;
استورد compiler.backend.layout.layout_model;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

عرف موقع_سجل_بفهرس(
    الموقع: &موقع_تمرير_واجهة,
    الفهرس: غير_موقع,
    الدور: دور_سجل_واجهة
): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الجزء) -> {
        طابق الجزء مع
        | موضع_جزء_واجهة.سجل(المرجع) -> {
            أرجع المرجع.الفئة == فئة_سجل_واجهة.عدد_صحيح()
                && المرجع.الفهرس == الفهرس
                && المرجع.الدور == الدور;
        }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف موقع_مكدس(الموقع: &موقع_تمرير_واجهة): منطقي {
    طابق *الموقع مع
    | موقع_تمرير_واجهة.مباشر(الجزء) -> {
        طابق الجزء مع
        | موضع_جزء_واجهة.مكدس(_) -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | _ -> { أرجع خطأ; };
}

عرف سجل_فعلي_للمعامل(الفهرس: غير_موقع): غير_موقع {
    دع المرجع: مرجع_سجل_واجهة = {
        الفئة: فئة_سجل_واجهة.عدد_صحيح(),
        الفهرس: الفهرس,
        الدور: دور_سجل_واجهة.معامل(),
        الحفظ: حفظ_سجل_واجهة.متطاير_عبر_النداء()
    };
    طابق سجل_واجهة_سيستم_في_إلى_إكس(&المرجع) مع
    | اختيار.بعض(السجل) -> { أرجع السجل.القيمة; }
    | اختيار.لا_شيء -> { أرجع 9999; };
}

عرف القلعة(): عدد {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع نوع_ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع المعاملات: متجه معرف_نوع = [نوع_ص64, نوع_ص64, نوع_ص64, نوع_ص64, نوع_ص64, نوع_ص64, نوع_ص64, نوع_ص64];
    دع الأهداف: متجه واصف_هدف = الأهداف_المسجلة();
    دع التخطيط: متغير سجل_تخطيط = سجل_تخطيط_جديد();

    لو (محاذاة_إطار_سيستم_في_إكس() != 16) { أرجع 1; };
    لو (سجل_فعلي_للمعامل(0) != 7) { أرجع 2; };
    لو (سجل_فعلي_للمعامل(1) != 6) { أرجع 3; };
    لو (سجل_فعلي_للمعامل(2) != 2) { أرجع 4; };
    لو (سجل_فعلي_للمعامل(3) != 1) { أرجع 5; };
    لو (سجل_فعلي_للمعامل(4) != 8) { أرجع 6; };
    لو (سجل_فعلي_للمعامل(5) != 9) { أرجع 7; };

    طابق صنف_واجهة_سيستم_في_إيه_إيه_إم_دي_أربعة_وستون_دالة(
        &الأنواع, &الأهداف[1], &متغير التخطيط, &المعاملات, نوع_ص64
    ) مع
    | نتيجة.خطأ(_) -> { أرجع 8; }
    | نتيجة.نجح(الخطة) -> {
        لو ((الطول(الخطة.المعاملات) مثل غير_موقع) != 8) { أرجع 9; };
        لو (!موقع_سجل_بفهرس(&الخطة.المعاملات[0].الموقع, 0, دور_سجل_واجهة.معامل())) { أرجع 10; };
        لو (!موقع_سجل_بفهرس(&الخطة.المعاملات[5].الموقع, 5, دور_سجل_واجهة.معامل())) { أرجع 11; };
        لو (!موقع_مكدس(&الخطة.المعاملات[6].الموقع)) { أرجع 12; };
        لو (!موقع_مكدس(&الخطة.المعاملات[7].الموقع)) { أرجع 13; };
        لو (!موقع_سجل_بفهرس(&الخطة.الناتج.الموقع, 0, دور_سجل_واجهة.ناتج())) { أرجع 14; };
        لو (الخطة.محاذاة_مكدس_النداء != 16) { أرجع 15; };
    };

    دع العمل: متجه معرف_سجل_فعلي = سجلات_عمل_إكس_قابلة_للتخصيص();
    لو ((الطول(العمل) مثل غير_موقع) != 4) { أرجع 16; };
    لو (العمل[0].القيمة != 7 || العمل[3].القيمة != 9) { أرجع 17; };

    دع الانسكاب: متجه معرف_سجل_فعلي = سجلات_عمل_انسكاب_إكس();
    لو ((الطول(الانسكاب) مثل غير_موقع) != 4) { أرجع 18; };
    لو (الانسكاب[0].القيمة != 10 || الانسكاب[1].القيمة != 0) { أرجع 19; };

    أرجع 42;
}
