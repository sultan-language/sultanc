// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/numeric/narrow_signed_registers.sn
// الأعداد الموقعة الضيقة في مفسر الآلة على مضيفات AArch64. تبقي شفرة AArch64 العدد ص8/ص16/ص32
// موسعًا بإشارته في سجله ذي 64 بتا وتقارن السجلات كاملة؛ وكانت ترجمة المفسر لـ AArch64 تترك
// الحساب الضيق والقسمة على ثابت وتحويلات الأعداد والعشري إلى عدد موسعة بالأصفار، فكان ص32 محلي
// يساوي -2147483647 - 1 يقارن غير مساو لثابت وحدة بالقيمة نفسها (يحمل موسعًا بإشارته)، ولم تكن
// قنن(255) أدناه -1.
عام دع السالب: ص32 = -2147483647 - 1;

عرف اطرح32(أ: ص32, ب: ص32): ص32 { أرجع أ - ب; }
عرف اسلب8(أ: ص8): ص8 { أرجع 0 - أ; }
عرف قنن(القيمة: ص64): ص32 {
    دع الضيق: ص8 = القيمة مثل ص8;
    دع الموسع: ص64 = الضيق;
    أرجع الموسع مثل ص32;
}
عرف ثلث(أ: ص32): ص32 { أرجع أ / 3; }
عرف نحو_الصفر(س: ع64): ص32 { أرجع س مثل ص32; }
عرف إلى_ط32(ق: ص64): ط32 { أرجع ق مثل ط32; }

عرف الرئيسية(): عدد {
    دع أ: ص32 = -2147483647 - 1;
    دع م: ص32 = السالب;
    إذا (أ != م) { أرجع 1; };
    إذا (م + 1 != -2147483647) { أرجع 2; };
    دع ج: ص32 = -2147483647;
    إذا (ج - 1 != أ) { أرجع 3; };
    إذا (اطرح32(0, 1) != -1) { أرجع 4; };
    إذا (!(اطرح32(0, 5) < 3)) { أرجع 5; };
    دع الواسع: ص64 = اطرح32(0, 1);
    إذا (الواسع != -1) { أرجع 6; };
    إذا (اسلب8(5) != -5) { أرجع 7; };
    إذا (قنن(255) != -1) { أرجع 8; };
    إذا (قنن(127) != 127) { أرجع 9; };
    إذا (ثلث(-9) != -3) { أرجع 10; };
    إذا (نحو_الصفر(-7.5) != -7) { أرجع 11; };
    إذا (إلى_ط32(-1) != 4294967295) { أرجع 12; };
    أرجع 42;
}
