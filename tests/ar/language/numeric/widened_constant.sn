// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/numeric/widened_constant.sn
// ثابت وحدة من نوع صحيح أضيق يوسع إلى النوع المصرح به بقيمته نفسها، كما في
// الدالة؛ و`-0` حرفي يناسب الأنواع الطبيعية.
دع ك1: عدد = (250 مثل ط8) + 3;
دع ك2: ط8 = -0;
دع ك3: ط64 = (7 مثل ط16) * 6;

عرف الرئيسية(): عدد {
    دع س: ط8 = 250;
    دع ص: عدد = س + 3;
    لو (ك1 != 253 || ص != ك1) { أرجع 1; };
    لو (ك2 != 0) { أرجع 2; };
    أرجع ك3 مثل عدد;
}
