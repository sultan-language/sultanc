// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/numeric/packed_stack_arguments.sn
// أعداد ضيقة تمرر على المكدس بعد سجلات الأعداد الثمانية. تحزمها واجهة Apple لـ AArch64 بحسب
// حجمها (ص8 عند الإزاحة 0، وص16 عند 2، وص32 عند 4، وص8 التالي عند 8)؛ وكان مفسر الآلة يعطي
// كل معامل على المكدس الكلمة عند الإزاحة / 8، فكانت الثلاثة الأولى على مضيف Apple Silicon
// تتشارك كلمة واحدة وتضيع قيمها.
عرف الذيل(
    أ0: ص64, أ1: ص64, أ2: ص64, أ3: ص64, أ4: ص64, أ5: ص64, أ6: ص64, أ7: ص64,
    س0: ص8, س1: ص16, س2: ص32, س3: ص8, س4: ط8, س5: ط16, س6: ص64
): ص64 {
    إذا (س0 != -3) { أرجع 1; };
    إذا (س1 != -700) { أرجع 2; };
    إذا (س2 != -40000) { أرجع 3; };
    إذا (س3 != 5) { أرجع 4; };
    إذا (س4 != 250) { أرجع 5; };
    إذا (س5 != 65000) { أرجع 6; };
    إذا (س6 != -9) { أرجع 7; };
    أرجع أ0 + أ7 + (س0 مثل ص64) + (س1 مثل ص64) + (س2 مثل ص64) + (س3 مثل ص64) + (س4 مثل ص64) + (س5 مثل ص64) + س6;
}

عرف الرئيسية(): عدد {
    دع ن: ص64 = الذيل(1, 2, 3, 4, 5, 6, 7, 8, -3 مثل ص8, -700 مثل ص16, -40000, 5 مثل ص8, 250 مثل ط8, 65000 مثل ط16, -9);
    إذا (ن < 10) { أرجع ن مثل عدد; };
    إذا (ن != 1 + 8 - 3 - 700 - 40000 + 5 + 250 + 65000 - 9) { أرجع 10; };
    أرجع 42;
}
