// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/numeric/float_cast_constants.sn
// تحويلات العائم في ثوابت الوحدة تقيم وقت الترجمة بالنتائج نفسها التي تعطيها
// وقت التشغيل: اقتطاع وإشباع، وتقريب إلى الأقرب، ولانهاية وأعداد دون طبيعية في ع32.
استورد std.math.float;

دع ك1: عدد = 2.5 مثل عدد;
دع ك2: ط8 = (-3.5) مثل ط8;
دع ك3: ع64 = 9007199254740993 مثل ع64;
دع ك4: ع32 = 0.1 مثل ع32;
دع ك5: ع32 = 1.0e300 مثل ع32;
دع ك6: ع32 = 1.0e-40 مثل ع32;
دع ك7: ص16 = 1.0e10 مثل ص16;

عرف الرئيسية(): عدد {
    لو (ك1 != 2 || ك2 != 0 || ك7 != 32767) { أرجع 1; };
    لو (بتات_ع64(ك3) != 4845873199050653696) { أرجع 2; };
    لو (بتات_ع32(ك4) != 1036831949 || بتات_ع32(ك5) != 2139095040) { أرجع 3; };
    لو (بتات_ع32(ك6) != 71362 || بتات_ع64(ك6 مثل ع64) != 4008604028031205376) { أرجع 4; };
    أرجع 42;
}
