// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/numeric/signed_narrow_division.sn
// القسمة والباقي على الأعداد الموقعة الضيقة (ص8، ص16، ص32): كانت الخلفية الأصلية
// لـ x86_64 تفخ أثناء الترجمة وهي تبني أدنى قيمة النوع الموسعة إلى 64 بتا.
عرف ق8(أ: ص8, ب: ص8): ص8 { أرجع أ / ب; }
عرف ب16(أ: ص16, ب: ص16): ص16 { أرجع أ % ب; }
عرف ق32(أ: ص32, ب: ص32): ص32 { أرجع أ / ب; }
عرف الرئيسية(): عدد {
    لو (ق8(-100, 3) != -33 || ق8(-128, 2) != -64 || ق8(127, -1) != -127) { أرجع 1; };
    لو (ب16(-32768, 7) != -1 || ب16(1000, -7) != 6) { أرجع 2; };
    لو (ق32(-2147483647 - 1, 4) != -536870912 || ق32(7, -2) != -3) { أرجع 3; };
    أرجع 42;
}
