// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/numeric/division_by_constant_16bit.sn
// القسمة والباقي على ثوابت ط16 وص16 لكل مقسوم، مقابل القسمة على قيمة وقت التشغيل.
استورد std.process.argument_count;

عرف اختبر_ط16_1(واحد: ط16): منطقي {
    دع ق: ط16 = 1 * واحد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 65536) {
        دع س: ط16 = ف مثل ط16;
        إذا (س / 1 != س / ق || س % 1 != س % ق) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}
