// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/numeric/division_by_constant_8bit.sn
// القسمة والباقي على كل ثابت ط8 وص8 (يبقى الصفر و-1 على تعليمة القسمة ذات الفخ)
// لكل مقسوم، مقابل القسمة نفسها على قيمة لا تعرف إلا وقت التشغيل.
استورد std.process.argument_count;

عرف اختبر_ط8_1(واحد: ط8): منطقي {
    دع ق: ط8 = 1 * واحد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 256) {
        دع س: ط8 = ف مثل ط8;
        إذا (س / 1 != س / ق || س % 1 != س % ق) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}
