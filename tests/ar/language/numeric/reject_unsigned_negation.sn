// اختبار: رفض
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/language/numeric/reject_unsigned_negation.sn
// لا سالب لقيمة من نوع عدد طبيعي (خطأ Rust ‏E0600)، في دالة كما في ثابت
// الوحدة؛ العدد الحرفي يبقى فحص قيمته (`-0` يناسب كل نوع صحيح).
دع ك: ط8 = -(3 مثل ط8);

عرف الرئيسية(): عدد {
    دع س: ط8 = 3;
    دع ص: ط8 = -س;
    أرجع (ص + ك) مثل عدد;
}
