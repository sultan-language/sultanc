// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/closures/static_environment_no_allocation.sn
// قيمة الدالة التي لا تلتقط شيئًا (دالة مسماة مستعملة قيمةً، أو دالة مغلقة بلا
// التقاطات) هي البيئة الساكنة الوحيدة لدالتها
// (compiler/msir/static_environments.sn): بناؤها ونسخها وتمريرها وإرجاعها
// واستدعاؤها لا يخصص شيئًا. 10^5 جولة تترك عدد تخصيصات هذا الخيط كما كان.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نظام_التشغيل.مخبأ_التخصيص;

عرف مربع(س: عدد): عدد { أرجع س * س; }

عرف طبق_دالة(د: دالة(عدد): عدد, ق: عدد): عدد { أرجع د(ق); }

عرف اختر(ف: عدد): دالة(عدد): عدد {
    إذا (ف % 2 == 0) { أرجع مربع; };
    أرجع دالة(س: عدد): عدد -> س + 1;
}

عرف جولة(ف: عدد): عدد {
    دع أ: دالة(عدد): عدد = مربع;
    دع ب: دالة(عدد): عدد = دالة(س: عدد): عدد -> س * 2;
    دع ج: دالة(عدد): عدد = اختر(ف);
    دع نسخة: دالة(عدد): عدد = ب;
    أرجع طبق_دالة(أ, 3) + ب(4) + ج(5) + نسخة(1) + طبق_دالة(دالة(س: عدد): عدد -> س - 1, 2);
}

عرف الرئيسية(): عدد {
    دع الإحماء: عدد = جولة(0);
    إذا (الإحماء != 9 + 8 + 25 + 2 + 1) { أرجع 1; };
    دع قبل: ط64 = عدد_تخصيصات_الخيط();
    دع ف: متغير عدد = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ف < 100000) {
        المجموع := المجموع + جولة(ف % 7);
        ف := ف + 1;
    }
    دع بعد: ط64 = عدد_تخصيصات_الخيط();
    إذا (بعد != قبل) { أرجع 2; };
    إذا (المجموع <= 0) { أرجع 3; };
    أرجع 42;
}
