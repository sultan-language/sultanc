// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/closures/static_environment_threads.sn
// البيئات الساكنة للدوال المغلقة مشتركة بين الخيوط
// (compiler/msir/static_environments.sn): أربعة خيوط، تبدأ من قيمة الدالة
// نفسها التي لا تلتقط شيئًا، تنسخ قيم الدوال نفسها التي لا تلتقط شيئًا
// وتمررها وتستدعيها وتسقطها معًا، فتتسابق زيادات مراجعها وإنقاصاتها على عدد
// واحد. ويبقى العدد ذريًا ولا يبلغ الصفر أبدًا، فتظل القيم تستدعي دوالها بعد
// انتهاء الخيوط.
استورد المكتبة.خيوط.خيط;

عرف ثلاثة_أمثال(س: عدد): عدد { أرجع س * 3; }

عرف طبق_دالة(د: دالة(عدد): عدد, ق: عدد): عدد { أرجع د(ق); }

عرف جولات(ن: عدد): عدد {
    دع ف: متغير عدد = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ف < ن) {
        دع أ: دالة(عدد): عدد = ثلاثة_أمثال;
        دع ب: دالة(عدد): عدد = أ;
        دع ج: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + 1;
        دع د: دالة(عدد): عدد = ج;
        المجموع := المجموع + طبق_دالة(ب, 1) + طبق_دالة(د, 1) + أ(0);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف اعمل(): فراغ {
    دع المجموع: عدد = جولات(100000);
    // 3 + 2 + 0 لكل جولة؛ والإجابة الخاطئة توقف البرنامج.
    إذا (المجموع != 500000) { دع ص: عدد = 1 / (المجموع - المجموع); };
}

عرف الرئيسية(): عدد {
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع ك: متغير عدد = 0;
    طالما (ك < 4) {
        طابق أطلق(اعمل) مع
        | نتيجة.خطأ(_) -> { أرجع 1; }
        | نتيجة.نجح(م) -> { ألحق(المقابض, م); };
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < 4) {
        انضم(&متغير المقابض[ك مثل طبيعي]);
        ك := ك + 1;
    }
    إذا (جولات(1000) != 5000) { أرجع 2; };
    دع أ: دالة(عدد): عدد = ثلاثة_أمثال;
    إذا (أ(14) != 42) { أرجع 3; };
    أرجع 42;
}
