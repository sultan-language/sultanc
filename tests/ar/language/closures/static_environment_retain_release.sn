// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/closures/static_environment_retain_release.sn
// زيادة المراجع وإنقاصها على البيئات الساكنة للدوال المغلقة
// (compiler/msir/static_environments.sn) في حلقة: قيم دوال لا تلتقط شيئًا
// تُنسخ وتُرجع وتُحفظ في سجلات ومتجهات وقيم اختيارية ويُعاد إسنادها وتُسقط،
// 10^5 مرة. كل نسخة تزيد العدد المشترك الواحد وكل إسقاط ينقصه، ولا يبلغ الصفر
// أبدًا، فلا تُتلف البيئة وتظل كل قيمة تستدعي دالتها.
نوع حامل = { د: دالة(عدد): عدد, إزاحة: عدد };

عرف اسلب(س: عدد): عدد { أرجع 0 - س; }

عرف أبق(د: دالة(عدد): عدد): دالة(عدد): عدد { أرجع د; }

عرف جولة(ف: عدد): عدد {
    ليكن أ: دالة(عدد): عدد = اسلب;
    ليكن ب: دالة(عدد): عدد = أ;
    ليكن ج: دالة(عدد): عدد = أبق(ب);
    ليكن ح: حامل = { د: ج, إزاحة: ف };
    ليكن ح2: حامل = ح;
    ليكن الدوال: متغير متجه دالة(عدد): عدد = [];
    ألحق(الدوال, أ);
    ألحق(الدوال, دالة(س: عدد): عدد -> س + 2);
    ليكن خ: اختياري دالة(عدد): عدد = اختياري.موجود(أبق(أ));
    ليكن ر: متغير دالة(عدد): عدد = أ;
    ر := دالة(س: عدد): عدد -> س * 2;
    ر := ج;
    // -1 - 2 + 0 - 3
    ليكن المجموع: متغير عدد = ح.د(1) + ح2.د(2) + (ح2.إزاحة - ف) + ر(3);
    ليكن ي: متغير طبيعي = 0;
    // -1 + 3
    طالما (ي < (الطول(الدوال) مثل طبيعي)) {
        ليكن دي: دالة(عدد): عدد = الدوال[ي];
        المجموع := المجموع + دي(1);
        ي := ي + 1;
    }
    // -5
    طابق خ مع
    | اختياري.موجود(ز) -> { المجموع := المجموع + ز(5); }
    | اختياري.لا_شيء -> { };
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن الكل: متغير عدد = 0;
    طالما (ف < 100000) {
        الكل := الكل + جولة(ف);
        ف := ف + 1;
    }
    إذا (الكل != -900000) { أرجع 1; };
    ليكن ن: دالة(عدد): عدد = اسلب;
    إذا (ن(-42) != 42) { أرجع 2; };
    أرجع 42;
}
