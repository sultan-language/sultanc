// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 42
// داخل نطاق غير آمن يقبل النداء الخام: getpid (39 على x86_64) يعيد معرفا موجبا.
عرف الرئيسية(): عدد {
    دع الناتج: ط64;
    غير_آمن { الناتج := بدائي_نداء_نواة_خام(39 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64); }
    لو (الناتج == 0 || الناتج > 4194304) { أرجع 1; };
    أرجع 42;
}
