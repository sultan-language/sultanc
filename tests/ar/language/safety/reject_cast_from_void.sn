// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/en/language/safety/reject_cast_from_void.sn
// تحويل *فراغ إلى مؤشر خام ذي نوع يحتاج غير_آمن.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع ف: *فراغ = 0 مثل *فراغ;
    دع م: *أول = ف مثل *أول;
    أرجع 0;
}
