// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 4
// نظير: tests/en/language/safety/reborrow_read_before_write.sn
// A reference read through a parameter is used up before the parameter's
// storage is written; a shared-reference call does not end it.
نوع جدول = {
    العناصر: متجه عدد,
    العدد: عدد
};

عرف الحجم(الهدف: &جدول): عدد {
    أرجع الطول((*الهدف).العناصر);
}

عرف افحص(المصدر: &متغير جدول): عدد {
    دع الأول: &عدد = &(*المصدر).العناصر[0];
    دع ن: عدد = الحجم(المصدر);
    دع القيمة: عدد = *الأول;
    ألحق((*المصدر).العناصر, 9);
    (*المصدر).العدد := القيمة + ن;
    أرجع (*المصدر).العدد;
}

عرف الرئيسية(): عدد {
    دع البداية: متجه عدد = [1, 2, 3];
    دع القيمة: متغير جدول = { العناصر: البداية, العدد: 0 };
    أرجع افحص(&متغير القيمة);
}
