// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 5
// نظير: tests/en/language/safety/while_continue_reassigned.sn
// Every path back to the condition gives the moved text a new value.
عرف استمر(القيمة: نص, العداد: عدد): منطقي {
    أرجع الطول(القيمة) > 0 && العداد < 5;
}

عرف جديد(): نص {
    أرجع «مجددا»;
}

عرف الرئيسية(): عدد {
    دع النص: متغير نص = «بداية»;
    دع العداد: متغير عدد = 0;
    طالما (استمر(النص, العداد)) {
        العداد := العداد + 1;
        لو (العداد > 3) {
            النص := جديد();
            تابع_حلقة;
        };
        النص := جديد();
    }
    أرجع العداد;
}
