// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/safety/text_byte_borrow.sn
// `&s[i]` borrows byte i of a text: a shared `&u8` of an immutable byte in
// the text's buffer (writes and mutable borrows are rejected). Of a local, a
// parameter, a borrowed text returned from a function, a global, an element
// of a vector of text; every byte of a text through borrows, and the UTF-8
// bytes of Arabic text.
دع التحية: نص = «hello»;

عرف البايت_عند(النص: &نص, ف: عدد): &ط8 {
    أرجع &(*النص)[ف];
}

عرف مجموع_البايتات(النص: &نص): عدد {
    دع المجموع: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < (الطول(*النص) مثل عدد)) {
        دع ب: &ط8 = &(*النص)[ف];
        المجموع := المجموع + ((*ب) مثل عدد);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    // A local.
    دع الكلمة: نص = «Sultan»;
    دع الأول: &ط8 = &الكلمة[0];
    دع الأخير: &ط8 = &الكلمة[5];
    إذا (*الأول != 83 || *الأخير != 110) { أرجع 1; };

    // A parameter, and a borrow returned from a function.
    إذا (*البايت_عند(&الكلمة, 1) != 117) { أرجع 2; };
    دع العرض: &نص = &الكلمة;
    دع الثالث: &ط8 = &(*العرض)[2];
    إذا (*الثالث != 108) { أرجع 3; };

    // A global.
    دع ح: &ط8 = &التحية[0];
    إذا (*ح != 104 || مجموع_البايتات(&التحية) != 532) { أرجع 4; };

    // Every byte through borrows.
    إذا (مجموع_البايتات(&الكلمة) != 631) { أرجع 5; };

    // An element of a vector of text.
    دع الكلمات: متجه نص = [«ab», «cd»];
    دع د: &ط8 = &الكلمات[1][1];
    إذا (*د != 100) { أرجع 6; };

    // Arabic text: alif is 0xD8 0xA7, ba is 0xD8 0xA8.
    دع العربي: نص = «اب»;
    إذا (الطول(العربي) != 4) { أرجع 7; };
    دع البادئ: &ط8 = &العربي[0];
    دع التابع: &ط8 = &العربي[3];
    إذا (*البادئ != 216 || *التابع != 168 || *البايت_عند(&العربي, 1) != 167) { أرجع 8; };
    إذا (مجموع_البايتات(&العربي) != 216 + 167 + 216 + 168) { أرجع 9; };

    // A borrow agrees with the byte read by value.
    إذا (*الأول != الكلمة[0] || *التابع != العربي[3]) { أرجع 10; };

    أرجع 42;
}
