// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 18
// نظير: tests/en/language/safety/byte_to_char.sn
// `u8 as char` at run time, in a comptime call and in a module constant.
دع الثالث: حرف = (67 مثل ط8) مثل حرف;

عرف حرف_ب(): حرف {
    دع البايت: ط8 = 66;
    أرجع البايت مثل حرف;
}

عرف الرئيسية(): عدد {
    دع البايت: ط8 = 65;
    دع الأول: حرف = البايت مثل حرف;
    دع الثاني: حرف = وقت_الترجمة { حرف_ب() };
    دع المجموع: ط32 = (الأول مثل ط32) + (الثاني مثل ط32) + (الثالث مثل ط32);
    أرجع (المجموع مثل عدد) - 180;
}
