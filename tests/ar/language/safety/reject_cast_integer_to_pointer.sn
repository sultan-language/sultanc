// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/en/language/safety/reject_cast_integer_to_pointer.sn
// كلمة عنوان تؤخذ مؤشرا خاما تحتاج غير_آمن.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع الكلمة: ط64 = 4096;
    دع م: *أول = الكلمة مثل *أول;
    أرجع 0;
}
