// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/safety/pointer_mutable_coercion.sn
// يُقبل `*متغير T` حيث يُتوقع `*T` للنوع T نفسه: حجةً، وفي `دع` ذي نوع، وفي
// الإرجاع، وفي حقل سجل. العنوان نفسه؛ وإنما تسقط إباحة الكتابة عبره.
نوع مقبض = معتم;
نوع سجل_ما = { القيمة: عدد };
نوع عرض = { السجل: *سجل_ما };

عرف اقرأ(العرض: *سجل_ما): عدد {
    غير_آمن { أرجع (*العرض).القيمة; };
}
عرف مقبضان_متساويان(أ: *مقبض, ب: *مقبض): منطقي { أرجع أ == ب; }
عرف كعرض(السجل: *متغير سجل_ما): *سجل_ما { أرجع السجل; }

عرف الرئيسية(): عدد {
    دع السجل: متغير سجل_ما = { القيمة: 20 };
    دع للكتابة: *متغير سجل_ما = (&متغير السجل) مثل *متغير سجل_ما;
    دع للقراءة: *سجل_ما = للكتابة;
    دع العرض: عرض = { السجل: للكتابة };
    دع المقبض: *متغير مقبض = 0 مثل *متغير مقبض;
    دع المجموع: متغير عدد = اقرأ(للكتابة) + اقرأ(كعرض(للكتابة));
    إذا (للقراءة == العرض.السجل && مقبضان_متساويان(المقبض, المقبض)) { المجموع := المجموع + 2; };
    أرجع المجموع;
}
