// الصفر المسمى ليس الحرفي الفارغ: يحتاج غير_آمن.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع الصفر: ط64 = 0;
    دع م: *أول = الصفر مثل *أول;
    أرجع 0;
}
