// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-CALL-ARGUMENT-TYPE-MISMATCH
// نظير: tests/en/language/safety/reject_pointer_adds_mutable_implicitly.sn
// التحويل الضمني يسقط `متغير` فقط: لا يُقبل `*T` حيث يُتوقع `*متغير T`.
نوع مقبض = معتم;
عرف أغلق(المقبض: *متغير مقبض): عدد { أرجع 0; }
عرف الرئيسية(): عدد {
    دع المقبض: *مقبض = 0 مثل *مقبض;
    أرجع أغلق(المقبض);
}
