// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// بيئة: SULTANC_INTERPRETER=checked
// نظير: tests/en/language/safety/raw_pointer_addresses.sn
// مؤشر خام يُقرأ عنوانًا (`م مثل ط64`) وعنوان يُؤخذ مؤشرًا من جديد (`ع مثل *ن`) في المفسر
// المتحقق (SULTANC_INTERPRETER=checked)، الذي لا عناوين لتخزينه: يأخذ كل محلي عنوانًا ثابتًا
// متميزًا غير صفري يسميه من جديد. وكان المفسر يتوقف بخطأ داخلي
// (SULTANC-ICE-INTERPRETER-UNEXPECTED-VALUE-KIND) عند أول استعمال لهذا العنوان، كمقارنة مخصص
// المكتبة القياسية عنوانَ محلي بنطاق مكادس الخيوط (library/std/os/allocation.sn).
عرف الرئيسية(): عدد {
    دع الأول: متغير ط64 = 7;
    دع الثاني: متغير ط64 = 9;
    دع أ: ط64;
    دع ب: ط64;
    دع ثانية: ط64;
    غير_آمن {
        أ := ((&متغير الأول) مثل *متغير ط64) مثل ط64;
        ب := ((&متغير الثاني) مثل *متغير ط64) مثل ط64;
        ثانية := ((&متغير الأول) مثل *متغير ط64) مثل ط64;
    }
    إذا (أ == 0 || ب == 0) { أرجع 1; };
    إذا (أ == ب) { أرجع 2; };
    إذا (أ != ثانية) { أرجع 3; };
    إذا (أ % 8 != 0) { أرجع 4; };
    دع م: *متغير ط64;
    دع ق: ط64;
    غير_آمن {
        م := أ مثل *متغير ط64;
        ق := *م;
    }
    إذا (ق != 7) { أرجع 5; };
    إذا (أ < 4096) { أرجع 6; };
    أرجع 42;
}
