// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/safety/char_comparison.sn
// Characters compare by their Unicode scalar values with ==, !=, <, <=, >
// and >=: literals, locals, elements of a vector, bytes of text viewed as
// characters, Arabic letters and a character beyond the Basic Multilingual
// Plane (ordered as unsigned values); in a module constant and at compile
// time too; character patterns, ranges included, agree.

عرف حرف_عربي(ح: حرف): منطقي {
    أرجع ح >= 'ء' && ح <= 'ي';
}

// Folded by constant evaluation.
دع ترتيب_ثابت: منطقي = 'a' < 'ب' && 'ب' != 'ا' && '😀' >= 'ي';

عرف عد_الأصغر(الحروف: &متجه حرف, الحد: حرف): عدد {
    دع العدد: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < (الطول(*الحروف) مثل عدد)) {
        إذا ((*الحروف)[ف] < الحد) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف الرئيسية(): عدد {
    دع ن: حرف = 'n';
    دع م: حرف = 'm';
    دع ن_ثانية: حرف = (110 مثل ط8) مثل حرف;

    // Equality.
    إذا (!(ن == 'n') || ن != ن_ثانية || ن == م || !(ن != م)) { أرجع 1; };

    // Ordering.
    إذا (!(م < ن) || ن < م || ن < ن_ثانية) { أرجع 2; };
    إذا (!(م <= ن) || !(ن <= ن_ثانية) || ن <= م) { أرجع 3; };
    إذا (!(ن > م) || م > ن || ن > ن_ثانية) { أرجع 4; };
    إذا (!(ن >= م) || !(ن >= ن_ثانية) || م >= ن) { أرجع 5; };

    // Elements of a vector.
    دع الحروف: متجه حرف = ['s', 'u', 'l', 't', 'a', 'n'];
    إذا (الحروف[0] != 's' || الحروف[5] != 'n' || !(الحروف[1] > الحروف[0])) { أرجع 6; };
    إذا (عد_الأصغر(&الحروف, 'm') != 2) { أرجع 7; };

    // Bytes of text, viewed as characters.
    دع الكلمة: نص = «Sultan»;
    دع الأول: حرف = الكلمة[0] مثل حرف;
    إذا (الأول != 'S' || !(الأول < 's') || (الكلمة[5] مثل حرف) != الحروف[5]) { أرجع 8; };

    // Arabic letters and a character outside the BMP: unsigned order.
    دع الألف: حرف = 'ا';
    دع الباء: حرف = 'ب';
    دع الياء: حرف = 'ي';
    إذا (!(الألف < الباء) || !(الباء < الياء) || الألف == الباء || الياء <= الباء) { أرجع 9; };
    إذا (!('z' < الألف) || !حرف_عربي(الباء) || حرف_عربي('z')) { أرجع 10; };
    دع الوجه: حرف = '😀';
    إذا (!(الوجه > الياء) || الوجه <= 'z' || الوجه == الألف) { أرجع 11; };
    دع العربية: متجه حرف = ['س', 'ل', 'ط', 'ا', 'ن'];
    إذا (العربية[3] != الألف || عد_الأصغر(&العربية, 'ل') != 3) { أرجع 12; };

    // Compile time.
    دع عربي_وقت_الترجمة: منطقي = وقت_الترجمة { حرف_عربي('ب') };
    دع لاتيني_وقت_الترجمة: منطقي = وقت_الترجمة { حرف_عربي('z') };
    إذا (!ترتيب_ثابت || !عربي_وقت_الترجمة || لاتيني_وقت_الترجمة) { أرجع 14; };

    // Character patterns read the same scalar value.
    طابق الباء مع
    | 'ب' -> { }
    | _ -> { أرجع 13; };
    طابق الياء مع
    | مدى 'ء' إلى 'ي' -> { }
    | _ -> { أرجع 15; };
    طابق الوجه مع
    | مدى 'a' إلى 'ي' -> { أرجع 16; }
    | _ -> { };

    أرجع 42;
}
