// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/en/language/safety/reject_cast_other_pointee.sn
// تحويل مؤشر خام إلى مؤشر لنوع مشار آخر يحتاج غير_آمن.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع م: *أول = 0 مثل *أول;
    دع ن: *ثان = م مثل *ثان;
    أرجع 0;
}
