// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/en/language/safety/reject_cast_adds_mutable.sn
// إضافة `متغير` إلى مؤشر خام (من *T إلى *متغير T) تحتاج غير_آمن.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع م: *أول = 0 مثل *أول;
    دع ك: *متغير أول = م مثل *متغير أول;
    أرجع 0;
}
