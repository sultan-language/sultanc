// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-CALL-ARGUMENT-TYPE-MISMATCH
// نظير: tests/en/language/safety/reject_pointer_mutable_other_pointee.sn
// إسقاط `متغير` لا يغير النوع المشار إليه أبدا: `*متغير A` ليس `*B`.
نوع أول = معتم;
نوع ثان = معتم;
عرف خذ(الثاني: *ثان): عدد { أرجع 0; }
عرف الرئيسية(): عدد {
    دع الأول: *متغير أول = 0 مثل *متغير أول;
    أرجع خذ(الأول);
}
