// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/safety/pointer_cast_rules.sn
// تحويلات المؤشرات: الآمن منها وما يحتاج غير_آمن. الآمن: النوع نفسه، والمرجع إلى
// مؤشر خام، وإسقاط `متغير`، والمؤشر الخام إلى كلمة عنوانه، والحرفي المجرد
// `0 مثل *T` (الفارغ). وداخل غير_آمن: كلمة عنوان إلى مؤشر، ونوع مشار آخر، وإلى
// *فراغ ومنه، وإضافة `متغير`.
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع السجل: متغير أول = { القيمة: 30 };
    دع لا_شيء_منه: *أول = 0 مثل *أول;
    دع للقراءة: *أول = (&السجل) مثل *أول;
    دع للكتابة: *متغير أول = (&متغير السجل) مثل *متغير أول;
    دع المسقط: *أول = للكتابة مثل *أول;
    دع نفسه: *أول = للقراءة مثل *أول;
    دع الكلمة: ط64 = للقراءة مثل ط64;
    دع المجموع: متغير عدد = 0;
    إذا (لا_شيء_منه == 0 مثل *أول && المسقط == نفسه && الكلمة != 0) { المجموع := المجموع + 2; };
    غير_آمن {
        دع من_الكلمة: *أول = الكلمة مثل *أول;
        دع بلا_نوع: *فراغ = من_الكلمة مثل *فراغ;
        دع العائد: *أول = بلا_نوع مثل *أول;
        دع آخر: *ثان = العائد مثل *ثان;
        دع ثانية: *أول = آخر مثل *أول;
        دع المكتسب: *متغير أول = ثانية مثل *متغير أول;
        المجموع := المجموع + (*المكتسب).القيمة + 10;
    };
    أرجع المجموع;
}
