// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 9
// نظير: tests/en/language/safety/global_match_view.sn
// A match on an immutable global binds a view: the global keeps its payload.
دع الأعداد: متجه عدد = [1, 2, 3];

عرف الرئيسية(): عدد {
    دع المجموع: متغير عدد = 0;
    دع الجولة: متغير عدد = 0;
    طالما (الجولة < 3) {
        طابق الأعداد مع
        | العرض -> { المجموع := المجموع + الطول(العرض); };
        الجولة := الجولة + 1;
    }
    أرجع المجموع;
}
