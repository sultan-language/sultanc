// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/reference_field_access.sn
// `ر.ح` عبر مرجع تعني `(*ر).ح`: الحقل البسيط يُنسخ، والحقل
// يُستعار عبر المرجع (ويجوز إرجاع الاستعارة لأنها تستعير ما يشير إليه
// المرجع)، و`&متغير` يكتب عبره، والمرجع إلى مرجع يُفك مرتين.
نوع نقطة = { س: عدد, ع: عدد };
نوع شخص = { الاسم: نص, العمر: عدد, البيت: نقطة };

عرف مجموع(ن: &نقطة): عدد { أرجع ن.س + ن.ع; }
عرف اسم_من(ش: &شخص): &نص { أرجع &ش.الاسم; }
عرف حرك_يمينا(ن: &متغير نقطة, بمقدار: عدد): فراغ { ن.س := ن.س + بمقدار; }
عرف عيد_ميلاد(ش: &متغير شخص): فراغ { ش.العمر := ش.العمر + 1; ش.البيت.ع := 0; }
عرف ضعف(نن: & &نقطة): عدد { أرجع نن.س * 2; }

عرف الرئيسية(): عدد {
    دع النقطة: متغير نقطة = { س: 3, ع: 4 };
    حرك_يمينا(&متغير النقطة, 2);
    دع ر: &نقطة = &النقطة;
    دع رر: & &نقطة = &ر;
    دع الشخص: متغير شخص = { الاسم: «Sultan», العمر: 9, البيت: { س: 1, ع: 5 } };
    عيد_ميلاد(&متغير الشخص);
    دع مشترك: &شخص = &الشخص;
    دع ن: &نص = اسم_من(مشترك);
    أرجع مجموع(ر) + ضعف(رر) + مشترك.العمر + مشترك.البيت.س + مشترك.البيت.ع + (الطول(*ن) مثل عدد) + 6;
}
