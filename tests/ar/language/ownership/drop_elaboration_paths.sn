// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// يتلف تفصيل الإسقاط (docs/ar/internals/ownership-analysis.md) كل قيمة مملوكة
// مرة واحدة بالضبط على كل مسار. تصنع كل دالة أدناه مالكًا تختلف حاله عند
// التزام الإتلاف باختلاف المسار: منقول على بعض المسارات فقط (فيحصل المالك على
// علم)، ومدموج عند حافة رجوع حلقة، وخارج عبر أرجع واخرج_من_حلقة وتابع_حلقة من
// نطاقات متداخلة، ومستهلك جزئيًا في ذراع مطابقة، ومنقول إلى بيئة دالة مغلقة،
// ومحمول في تخصيص عام يعيد كل واحد من معامليه على مسار، ومبدل بمالك آخر. والإتلاف الفائت يزيد
// البايتات الحية للمخصص، والإتلاف الثاني يوقف البرنامج في المخصص، والقيمة
// المتلفة إذا قرئت ثانية أعطت طولًا خاطئًا.
// النظير: tests/en/language/ownership/drop_elaboration_paths.sn؛ بلا توجيه زوج:
// المفسر لا يستعمل مخصص المكتبة القياسية الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.نظام_التشغيل.تخصيص;

نوع اثنان = | كلاهما بنوع (نص, نص) | لا_شيء_منهما;

عرف اصنع(ن: طبيعي): نص {
    إذا ((ن % 2) == 0) { أرجع «زوجي»; };
    أرجع «قيمة فردية»;
}

عرف استهلك(ق: نص): عدد { أرجع الطول(ق) مثل عدد; }

عرف نقل_مشروط(ن: طبيعي): عدد {
    دع النص: نص = اصنع(ن);
    دع المجموع: متغير عدد = 0;
    إذا ((ن % 3) == 0) {
        المجموع := استهلك(النص);
    };
    أرجع المجموع + 1;
}

عرف إعادة_تهيئة_في_حلقة(ن: طبيعي): عدد {
    دع النص: متغير نص = اصنع(ن);
    دع ف: متغير طبيعي = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ف < 4) {
        إذا ((ف % 2) == 0) {
            المجموع := المجموع + استهلك(النص);
            النص := اصنع(ف);
        };
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف مخارج_مبكرة(ن: طبيعي): عدد {
    دع الخارجي: نص = اصنع(ن);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) {
        دع الداخلي: نص = اصنع(ف);
        ف := ف + 1;
        إذا (ف == 2) { تابع_حلقة; };
        إذا (ف == 4) { اخرج_من_حلقة; };
        إذا (ن == 7) {
            دع الأخير: نص = اصنع(ف);
            أرجع استهلك(الأخير);
        };
    }
    أرجع الطول(الخارجي) مثل عدد;
}

عرف جزئي(ن: طبيعي): عدد {
    دع الزوج: اثنان = اثنان.كلاهما(اصنع(ن), اصنع(ن + 1));
    طابق الزوج مع
    | اثنان.كلاهما(الأول, _) -> { أرجع استهلك(الأول); }
    | اثنان.لا_شيء_منهما -> { أرجع 0; };
}

عرف ملتقط(ن: طبيعي): عدد {
    دع النص: نص = اصنع(ن);
    دع د: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + (الطول(النص) مثل عدد);
    أرجع د(1);
}

عرف أبق_أو<ن>(الشرط: منطقي, القيمة: ن, البديل: ن): ن {
    إذا (الشرط) { أرجع القيمة; };
    أرجع البديل;
}

عرف مثيل_عام(ن: طبيعي): عدد {
    دع المختار: نص = أبق_أو((ن % 2) == 0, اصنع(ن), اصنع(ن + 1));
    أرجع استهلك(المختار) + أبق_أو(صواب, 1, 2);
}

// التبديل لا ينقل شيئًا: يحمل كلا المالكين قيمة بعده، ويُتلف كل منهما مرة في النهاية.
عرف مبدل(ن: طبيعي): عدد {
    دع الأول: متغير نص = اصنع(ن);
    دع الثاني: متغير نص = اصنع(ن + 1);
    بدّل(الأول, الثاني);
    أرجع استهلك(الأول) + (الطول(الثاني) مثل عدد);
}

عرف جولة(ن: طبيعي): عدد {
    أرجع نقل_مشروط(ن) + إعادة_تهيئة_في_حلقة(ن) + مخارج_مبكرة(ن) + جزئي(ن) + ملتقط(ن) + مثيل_عام(ن)
        + مبدل(ن);
}

// ما تعيده الجولة إذا أتلف كل مالك مرة واحدة في موضعه.
عرف المتوقع(ن: طبيعي): عدد {
    دع المحمول: متغير عدد = الطول(اصنع(1)) مثل عدد;
    إذا ((ن % 2) == 0) { المحمول := الطول(اصنع(0)) مثل عدد; };
    دع زوجي: عدد = الطول(اصنع(0)) مثل عدد;
    دع فردي: عدد = الطول(اصنع(1)) مثل عدد;
    دع الآخر: متغير عدد = زوجي;
    إذا ((ن % 2) == 0) { الآخر := فردي; };
    دع المجموع: متغير عدد = 1 + المحمول + زوجي + المحمول + المحمول + 1 + المحمول + زوجي + 1 + الآخر + المحمول;
    إذا ((ن % 3) == 0) { المجموع := المجموع + المحمول; };
    إذا (ن == 7) { المجموع := المجموع - المحمول + فردي; };
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع تمهيد: عدد = جولة(0) + جولة(7);
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع الخاطئة: متغير طبيعي = 0;
    دع ن: متغير طبيعي = 0;
    طالما (ن < 20000) {
        إذا (جولة(ن) != المتوقع(ن)) { الخاطئة := الخاطئة + 1; };
        ن := ن + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (تمهيد != (المتوقع(0) + المتوقع(7))) { أرجع 1; };
    إذا (الخاطئة != 0) { أرجع 2; };
    إذا (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
