// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/ownership/clone_plain_records.sn
// clone of a vector whose elements own no storage: records and tuples of
// numbers (any size and alignment), nested records, enums whose payloads are
// numbers, floats, booleans and characters copy element by element; integer
// vectors (an alias of an integer included) copy with one extend. Each copy
// is independent of its source, and records that own text still copy deeply.
استورد المكتبة.نصوص.compare;

نوع خلية = { أ: طبيعي };
نوع مختلط = { س: ص32, ص: ع64, ع: ط8 };
نوع نقطة = { س: ص64, ص: ص64 };
نوع موضوع = { الموضع: نقطة, الوزن: ط16, الوسم: ط8 };
نوع صنف =
    | صغير
    | كبير بنوع ص64
    | زوج بنوع (ص32, ص32)
;
نوع مسمى = { الاسم: نص, الرقم: عدد };
نوع عداد = ط16;

عرف انسخ_الخلايا(القيمة: &متجه خلية): متجه خلية {
    دع النسخة: متجه خلية = استنسخ(القيمة);
    أرجع النسخة;
}

عرف قيمة_الصنف(ك: &صنف): عدد {
    طابق *ك مع
    | صنف.صغير -> { أرجع 1; }
    | صنف.كبير(ن) -> { أرجع ن; }
    | صنف.زوج(ي, ش) -> { أرجع (ي مثل عدد) * 10 + (ش مثل عدد); };
}

عرف الرئيسية(): عدد {
    // The reported case: a record of one number.
    دع الخلايا: متجه خلية = [{ أ: 40 }, { أ: 2 }];
    دع نسخة_الخلايا: متجه خلية = انسخ_الخلايا(&الخلايا);
    إذا ((الطول(نسخة_الخلايا) مثل عدد) != 2 || نسخة_الخلايا[0].أ + نسخة_الخلايا[1].أ != 42) { أرجع 1; };

    // Records of mixed widths (16 bytes, padded) and independence.
    دع المختلطة: متجه مختلط = [{ س: 7, ص: 1.5, ع: 200 }, { س: -3, ص: 0.25, ع: 9 }];
    دع نسخة_المختلطة: متغير متجه مختلط = استنسخ(&المختلطة);
    نسخة_المختلطة[0] := { س: 100, ص: 9.0, ع: 1 };
    إذا (المختلطة[0].س != 7 || المختلطة[0].ص != 1.5 || المختلطة[0].ع != 200) { أرجع 2; };
    إذا (نسخة_المختلطة[1].س != -3 || نسخة_المختلطة[1].ص != 0.25 || نسخة_المختلطة[1].ع != 9) { أرجع 3; };
    إذا (نسخة_المختلطة[0].س != 100) { أرجع 4; };

    // Nested records (24 bytes).
    دع المواضيع: متجه موضوع = [
        { الموضع: { س: 1, ص: 2 }, الوزن: 300, الوسم: 4 },
        { الموضع: { س: -5, ص: 6 }, الوزن: 7, الوسم: 8 },
        { الموضع: { س: 9, ص: -10 }, الوزن: 11, الوسم: 12 }
    ];
    دع نسخة_المواضيع: متجه موضوع = استنسخ(&المواضيع);
    إذا ((الطول(نسخة_المواضيع) مثل عدد) != 3) { أرجع 5; };
    إذا (نسخة_المواضيع[0].الموضع.ص != 2 || نسخة_المواضيع[0].الوزن != 300 || نسخة_المواضيع[1].الموضع.س != -5
        || نسخة_المواضيع[2].الموضع.ص != -10 || نسخة_المواضيع[2].الوسم != 12) { أرجع 6; };

    // Enums whose payloads own nothing.
    دع الأصناف: متجه صنف = [صنف.صغير(), صنف.كبير(1000), صنف.زوج(3, 4)];
    دع نسخة_الأصناف: متجه صنف = استنسخ(&الأصناف);
    إذا (قيمة_الصنف(&نسخة_الأصناف[0]) != 1 || قيمة_الصنف(&نسخة_الأصناف[1]) != 1000
        || قيمة_الصنف(&نسخة_الأصناف[2]) != 34) { أرجع 7; };

    // Floats, booleans, characters and tuples of numbers.
    دع العشرية: متجه ع64 = [0.5, -2.25, 1000000.125];
    دع نسخة_العشرية: متجه ع64 = استنسخ(&العشرية);
    إذا (نسخة_العشرية[0] != 0.5 || نسخة_العشرية[1] != -2.25 || نسخة_العشرية[2] != 1000000.125) { أرجع 8; };
    دع الرايات: متجه منطقي = [صواب, خطأ, صواب];
    دع نسخة_الرايات: متجه منطقي = استنسخ(&الرايات);
    إذا (!نسخة_الرايات[0] || نسخة_الرايات[1] || !نسخة_الرايات[2]) { أرجع 9; };
    دع الحروف: متجه حرف = [(115 مثل ط8) مثل حرف, (110 مثل ط8) مثل حرف];
    دع نسخة_الحروف: متجه حرف = استنسخ(&الحروف);
    إذا ((نسخة_الحروف[0] مثل ط32) != 115 || (نسخة_الحروف[1] مثل ط32) != 110) { أرجع 10; };
    دع الزوج_الأول: (ص64, ط8) = (1, 2);
    دع الزوج_الثاني: (ص64, ط8) = (30, 40);
    دع الأزواج: متجه (ص64, ط8) = [الزوج_الأول, الزوج_الثاني];
    دع نسخة_الأزواج: متجه (ص64, ط8) = استنسخ(&الأزواج);
    طابق نسخة_الأزواج[1] مع
    | (ل, م) -> { إذا (ل != 30 || م != 40) { أرجع 11; }; };

    // Integers, and an alias of an integer, keep the single-extend copy.
    دع الأعداد: متجه ص32 = [5, 6, 7];
    دع نسخة_الأعداد: متغير متجه ص32 = استنسخ(&الأعداد);
    نسخة_الأعداد[0] := 50;
    إذا (الأعداد[0] != 5 || نسخة_الأعداد[0] != 50 || نسخة_الأعداد[2] != 7) { أرجع 12; };
    دع العدادات: متجه عداد = [65535, 1];
    دع نسخة_العدادات: متجه عداد = استنسخ(&العدادات);
    إذا (نسخة_العدادات[0] != 65535 || نسخة_العدادات[1] != 1) { أرجع 13; };

    // An empty vector.
    دع الفارغ: متجه موضوع = [];
    دع نسخة_الفارغ: متجه موضوع = استنسخ(&الفارغ);
    إذا ((الطول(نسخة_الفارغ) مثل عدد) != 0) { أرجع 14; };

    // A large vector.
    دع الكثير: متغير متجه مختلط = [];
    دع ف: متغير عدد = 0;
    طالما (ف < 5000) {
        ألحق(الكثير, { س: ف مثل ص32, ص: (ف مثل ع64) * 0.5, ع: (ف % 256) مثل ط8 });
        ف := ف + 1;
    }
    دع نسخة_الكثير: متجه مختلط = استنسخ(&الكثير);
    إذا ((الطول(نسخة_الكثير) مثل عدد) != 5000) { أرجع 15; };
    دع المجموع: متغير عدد = 0;
    دع ي: متغير عدد = 0;
    طالما (ي < 5000) {
        المجموع := المجموع + (نسخة_الكثير[ي].س مثل عدد) + (نسخة_الكثير[ي].ع مثل عدد);
        إذا (نسخة_الكثير[ي].ص != (ي مثل ع64) * 0.5) { أرجع 16; };
        ي := ي + 1;
    }
    إذا (المجموع != 12497500 + 629340) { أرجع 17; };

    // Negative control: records that own text still copy deeply.
    دع المسماة: متجه مسمى = [{ الاسم: «الأول», الرقم: 1 }, { الاسم: «الثاني», الرقم: 2 }];
    دع نسخة_المسماة: متغير متجه مسمى = استنسخ(&المسماة);
    نسخة_المسماة[0] := { الاسم: «معدل», الرقم: 10 };
    إذا (!نصان_متساويان(&المسماة[0].الاسم, &«الأول») || المسماة[0].الرقم != 1) { أرجع 18; };
    إذا (!نصان_متساويان(&نسخة_المسماة[1].الاسم, &«الثاني») || نسخة_المسماة[1].الرقم != 2) { أرجع 19; };
    إذا (!نصان_متساويان(&نسخة_المسماة[0].الاسم, &«معدل»)) { أرجع 20; };

    أرجع 42;
}
