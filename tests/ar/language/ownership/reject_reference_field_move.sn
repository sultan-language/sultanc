// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE
// نظير: tests/en/language/ownership/reject_reference_field_move.sn
// `ش.الاسم` عبر مرجع مشترك هي `(*ش).الاسم`: نقل الحقل المالك من المرجع
// خطأ.
نوع شخص = { الاسم: نص, العمر: عدد };

عرف خذ(ش: &شخص): نص {
    ليكن الاسم: نص = ش.الاسم;
    أرجع الاسم;
}

عرف الرئيسية(): عدد {
    ليكن الشخص: شخص = { الاسم: «Sultan», العمر: 9 };
    أرجع الطول(خذ(&الشخص)) مثل عدد;
}
