// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/text_argument_borrow.sn
// الوسيط من نوع `نص` لمعامل من نوع `&نص` يُستعار طوال الاستدعاء كأنه كُتب
// `&ن`: تأخذ اطبع_سطر واطبع `&نص`، فلا
// يُنقل النص المطبوع مرتين. ويصح `&ن` والحرفي ونتيجة الاستدعاء أيضا. ولا
// يُستعار ضمنيا إلا النص.
استورد المكتبة.دخ.اطبع;
استورد المكتبة.دخ.اطبع_سطر;

عرف عد(ن: &نص): عدد { أرجع الطول(*ن) مثل عدد; }
عرف كلمة(): نص { أرجع «word»; }

عرف الرئيسية(): عدد {
    ليكن ن: نص = «x»;
    ليكن أ: نتيجة عدد, عدد = اطبع_سطر(ن);
    ليكن ب: نتيجة عدد, عدد = اطبع_سطر(ن);
    ليكن ج: نتيجة عدد, عدد = اطبع_سطر(&ن);
    ليكن د: نتيجة عدد, عدد = اطبع_سطر(«literal»);
    ليكن ز: نتيجة عدد, عدد = اطبع(ن);
    ليكن ح: نتيجة عدد, عدد = اطبع("\n");
    أرجع عد(ن) + عد(«abcd») + عد(&ن) + عد(كلمة()) + (الطول(ن) مثل عدد) + 31;
}
