// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/borrow_within_owner_scope.sn
// استعارة المالك صالحة ما دام آخر استخدام لها قبل أن ينتهي نطاق المالك
// (docs/ar/reference/ownership.md، "مناطق الاستعارة"): مرجع يُقرأ داخل الفرع الذي
// يملك النص، وقيمة بسيطة تُنسخ عبر مرجع قبل أن يُتلف النص، ومرجع يُعطى قيمة جديدة
// في كل دورة قبل أن يُقرأ ثم قيمة خارجية من جديد قبل أن يُقرأ بعد الحلقة، ومتجه
// مراجع مصرح به قبل النص الذي يحمله، يُتلف بعده ويُقرأ قبله.
عرف يقرأ_في_الفرع(العلم: منطقي): عدد {
    ليكن البديل: نص = «س»;
    ليكن القارئ: متغير &نص = &البديل;
    ليكن المرئي: متغير عدد = 0;
    إذا (العلم) {
        ليكن النص: نص = "abcd";
        القارئ := &النص;
        المرئي := الطول(*القارئ) مثل عدد;
    };
    أرجع المرئي;
}

عرف ينسخ_إلى_الخارج(): عدد {
    ليكن العدد_الكلي: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن النص: نص = "abc";
        ليكن الداخلي: &نص = &النص;
        العدد_الكلي := العدد_الكلي + (الطول(*الداخلي) مثل عدد);
        ف := ف + 1;
    }
    أرجع العدد_الكلي;
}

عرف يعطى_قبل_القراءة(): عدد {
    ليكن البديل: نص = "xy";
    ليكن القارئ: متغير &نص = &البديل;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن النص: نص = "abcde";
        القارئ := &النص;
        المجموع := المجموع + (الطول(*القارئ) مثل عدد);
        ف := ف + 1;
    }
    القارئ := &البديل;
    أرجع المجموع + (الطول(*القارئ) مثل عدد);
}

عرف محمول_قبل_المالك(العلم: منطقي): عدد {
    ليكن العدد_الكلي: متغير عدد = 0;
    إذا (العلم) {
        ليكن المحمولة: متغير متجه &نص = [];
        ليكن النص: نص = "abcdefg";
        المحمولة := [&النص];
        العدد_الكلي := الطول(*المحمولة[0]) مثل عدد;
    };
    أرجع العدد_الكلي;
}

عرف الرئيسية(): عدد {
    // 4 + 6 + 17 + 7 = 34؛ و0 حين لا يؤخذ الفرع
    أرجع يقرأ_في_الفرع(صواب) + يقرأ_في_الفرع(خطأ) + ينسخ_إلى_الخارج() + يعطى_قبل_القراءة()
        + محمول_قبل_المالك(صواب) + 8;
}
