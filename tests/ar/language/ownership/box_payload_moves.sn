// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نقل الحمولة إلى خارج الصندوق يحرر خلية الصندوق نفسها مرة واحدة بالضبط ويترك
// الحمولة لمالكها الجديد (تفصيل الإسقاط، docs/ar/internals/ownership-analysis.md،
// "النقل إلى خارج الصندوق"). تعمل كل حالة مرات كثيرة على حمولات في الكومة، ويجب
// أن تعود البايتات الحية للمخصص بعدها إلى قيمتها الأولى: فالخلية أو الحمولة التي
// لا تُحرر تزيدها، والتي تُحرر مرتين توقف البرنامج في المخصص، والحمولة المتلفة
// قبل أوانها تعطي طولًا خاطئًا. تنتقل الحمولة إلى متجه وإلى نداء، وعلى بعض المسارات
// فقط، وفي حلقة، وقبل إرجاع مبكر، ومن صندوق محمول في صندوق. والصندوق الذي تُقرأ
// حمولته ولا تُنقل، والعرض المستعار المهيأ من الحمولة، يتركان الصندوق لمالكه
// الذي يحرره مع حمولته.
// النظير: tests/en/language/ownership/box_payload_moves.sn؛ بلا توجيه زوج:
// المفسر لا يستعمل مخصص المكتبة القياسية الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

// سبعة أرقام في الكومة.
عرف حمولة(ن: طبيعي): نص { أرجع عدد_إلى_نص((ن + 1000000) مثل عدد); }

عرف خذ(ق: نص): عدد { أرجع الطول(ق) مثل عدد; }

عرف خذ_صندوقا(ص: صندوق نص): عدد { أرجع الطول(*ص) مثل عدد; }

عرف إلى_متجه(ن: طبيعي): عدد {
    ليكن العناصر: متغير متجه نص = [];
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    ألحق(العناصر, *العلبة);
    ليكن الأخرى: صندوق نص = صندوق حمولة(ن + 1);
    ألحق(العناصر, *الأخرى);
    أرجع (الطول(العناصر[0]) + الطول(العناصر[1])) مثل عدد;
}

عرف إلى_نداء(ن: طبيعي): عدد {
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    أرجع خذ(*العلبة);
}

عرف بعض_المسارات(ن: طبيعي): عدد {
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    ليكن المجموع: متغير عدد = 1;
    إذا ((ن % 3) == 0) {
        المجموع := خذ(*العلبة);
    };
    أرجع المجموع;
}

عرف في_حلقة(ن: طبيعي): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ليكن العلبة: صندوق نص = صندوق حمولة(ن + ف);
        إذا ((ف % 2) == 0) {
            المجموع := المجموع + خذ(*العلبة);
        } وإلا {
            المجموع := المجموع + (الطول(*العلبة) مثل عدد);
        };
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف إرجاع_مبكر(ن: طبيعي): عدد {
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    إذا ((ن % 4) == 1) {
        أرجع خذ(*العلبة);
    };
    أرجع 100;
}

عرف متداخل(ن: طبيعي): عدد {
    ليكن الأول: صندوق نص = صندوق حمولة(ن);
    ليكن الخارجي: صندوق (صندوق نص) = صندوق الأول;
    ليكن الثاني: صندوق نص = صندوق حمولة(ن + 1);
    ليكن الخارجي_الآخر: صندوق (صندوق نص) = صندوق الثاني;
    أرجع خذ_صندوقا(*الخارجي) + خذ(**الخارجي_الآخر);
}

عرف عرض(ن: طبيعي): عدد {
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    ليكن المرئي: نص = *العلبة;
    أرجع (الطول(المرئي) + الطول(*العلبة)) مثل عدد;
}

عرف مبقى(ن: طبيعي): عدد {
    ليكن العلبة: صندوق نص = صندوق حمولة(ن);
    أرجع الطول(*العلبة) مثل عدد;
}

عرف افحص(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) { أرجع إلى_متجه(ن); };
    إذا (الحالة == 1) { أرجع إلى_نداء(ن); };
    إذا (الحالة == 2) { أرجع بعض_المسارات(ن); };
    إذا (الحالة == 3) { أرجع في_حلقة(ن); };
    إذا (الحالة == 4) { أرجع إرجاع_مبكر(ن); };
    إذا (الحالة == 5) { أرجع متداخل(ن); };
    إذا (الحالة == 6) { أرجع عرض(ن); };
    أرجع مبقى(ن);
}

عرف المتوقع(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) { أرجع 14; };
    إذا (الحالة == 2) {
        إذا ((ن % 3) == 0) { أرجع 7; };
        أرجع 1;
    };
    إذا (الحالة == 3) { أرجع 28; };
    إذا (الحالة == 4) {
        إذا ((ن % 4) == 1) { أرجع 7; };
        أرجع 100;
    };
    إذا (الحالة == 5) { أرجع 14; };
    إذا (الحالة == 6) { أرجع 14; };
    أرجع 7;
}

عرف الرئيسية(): عدد {
    ليكن تمهيد: عدد = افحص(7, 0) + افحص(0, 0);
    ليكن الحالة: متغير طبيعي = 0;
    طالما (الحالة < 8) {
        ليكن قبل: ط64 = بايتات_حية_مخصص_النظام();
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < 2000) {
            إذا (افحص(الحالة, ن) != المتوقع(الحالة, ن)) { أرجع 10 + (الحالة مثل عدد); };
            ن := ن + 1;
        }
        ليكن بعد: ط64 = بايتات_حية_مخصص_النظام();
        إذا (بعد != قبل) { أرجع 20 + (الحالة مثل عدد); };
        الحالة := الحالة + 1;
    }
    إذا (تمهيد != 21) { أرجع 1; };
    أرجع 42;
}
