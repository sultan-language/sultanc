// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/borrow_within_plain_scope.sn
// استعارة القيمة البسيطة صالحة ما دام آخر استخدام لها قبل أن ينتهي نطاق القيمة
// (docs/ar/reference/ownership.md، "مناطق الاستعارة"): مرجع يُقرأ داخل الفرع الذي
// يصرح بالقيمة، وقيمة تُنسخ عبر مرجع في كل دورة، ومرجع يُعطى قيمة جديدة في كل دورة
// قبل أن يُقرأ ثم قيمة خارجية من جديد قبل أن يُقرأ بعد الحلقة، ومرجع آخر قراءة له قبل
// `اخرج_من_حلقة`، وعضو سجل أعداد يُقرأ في كتلته، ومرجع إلى معامل وآخر إلى محلي الكتلة
// المحيطة يُقرآن بعد كتلة داخلية، ومراجع إلى محليات خارجية تُخزن في عضو سجل وتُلحق
// بمتجه في كتلة داخلية، ودالة مغلقة تنسخ قيمة كتلة.
نوع زوج = { أ: عدد, ب: عدد };
نوع حامل = { العنصر: &عدد };

عرف يقرأ_في_الفرع(العلم: منطقي): عدد {
    ليكن الخارجي: عدد = 0;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن المرئي: متغير عدد = 0;
    إذا (العلم) {
        ليكن الداخلي: عدد = 4;
        ر := &الداخلي;
        المرئي := *ر;
    };
    أرجع المرئي;
}

عرف ينسخ_للخارج(): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن القيمة: عدد = ف مثل عدد;
        ليكن م: &عدد = &القيمة;
        المجموع := المجموع + *م;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف يعطى_قبل_القراءة(): عدد {
    ليكن الخارجي: عدد = 2;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن الداخلي: عدد = 5;
        ر := &الداخلي;
        المجموع := المجموع + *ر;
        ف := ف + 1;
    }
    ر := &الخارجي;
    أرجع المجموع + *ر;
}

عرف يقرأ_قبل_الخروج(): عدد {
    ليكن الخارجي: عدد = 1;
    ليكن ر: متغير &عدد = &الخارجي;
    ليكن المرئي: متغير عدد = 0;
    طالما (صواب) {
        ليكن الداخلي: عدد = 6;
        ر := &الداخلي;
        المرئي := *ر;
        اخرج_من_حلقة;
    }
    ر := &الخارجي;
    أرجع المرئي + *ر;
}

عرف عضو_في_كتلة(): عدد {
    ليكن المرئي: متغير عدد = 0;
    إذا (صواب) {
        ليكن الزوج: زوج = { أ: 1, ب: 2 };
        ليكن ر: &عدد = &الزوج.ب;
        المرئي := *ر;
    };
    أرجع المرئي;
}

عرف مرجع_معامل(م: عدد, العلم: منطقي): عدد {
    ليكن ر: &عدد = &م;
    ليكن المرئي: متغير عدد = 0;
    إذا (العلم) {
        ليكن الداخلي: عدد = 1;
        المرئي := *ر + الداخلي;
    };
    أرجع المرئي + *ر;
}

عرف مرجع_محيط(العلم: منطقي): عدد {
    ليكن الأول: عدد = 7;
    ليكن الثاني: عدد = 3;
    ليكن ر: متغير &عدد = &الأول;
    ليكن المرئي: متغير عدد = 0;
    إذا (العلم) {
        ليكن الداخلي: عدد = 1;
        ر := &الثاني;
        المرئي := الداخلي;
    };
    أرجع *ر + المرئي;
}

عرف يخزن_الخارجي(العلم: منطقي): عدد {
    ليكن الأول: عدد = 1;
    ليكن الثاني: عدد = 2;
    ليكن الحامل: متغير حامل = { العنصر: &الأول };
    ليكن المراجع: متغير متجه &عدد = [];
    إذا (العلم) {
        ليكن العدد: عدد = 2;
        الحامل.العنصر := &الثاني;
        ألحق(المراجع, &الأول);
        ألحق(المراجع, &الثاني);
        المراجع[0] := &الثاني;
        إذا (العدد != 2) { أرجع 0; };
    };
    أرجع *الحامل.العنصر + *المراجع[0] + *المراجع[1] + (الطول(المراجع) مثل عدد);
}

عرف نسخة_مغلقة(العلم: منطقي): عدد {
    ليكن المرئي: متغير عدد = 0;
    إذا (العلم) {
        ليكن الداخلي: عدد = 3;
        ليكن أضف: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + الداخلي;
        المرئي := أضف(1);
    };
    أرجع المرئي;
}

عرف الرئيسية(): عدد {
    // 4 + 0 + 3 + 17 + 7 + 2 + 11 + 4 + 8 + 4 = 60
    أرجع يقرأ_في_الفرع(صواب) + يقرأ_في_الفرع(خطأ) + ينسخ_للخارج() + يعطى_قبل_القراءة()
        + يقرأ_قبل_الخروج() + عضو_في_كتلة() + مرجع_معامل(5, صواب) + مرجع_محيط(صواب)
        + يخزن_الخارجي(صواب) + نسخة_مغلقة(صواب) - 18;
}
