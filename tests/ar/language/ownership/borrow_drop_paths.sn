// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// القيم التي تنتهي استعاراتها قبل أن تُنقل تُتلف مع ذلك مرة واحدة بالضبط
// (docs/ar/internals/ownership-analysis.md، "مناطق الاستعارة" و"تفصيل الإسقاط").
// فالنص المقروء عبر مرجع يُنقل على بعض المسارات فقط ويُتلف على غيرها؛ والمحلي
// المعطى قيمة على بعض المسارات يُعطى قيمة جديدة، ولا تُتلف إلا القيمة القديمة
// الموجودة؛ والحلقة تقرأ عبر مرجع ثم تنقل النص وتعطيه قيمة جديدة في كل دورة؛
// والسجل المقروء عبر مرجع يُنقل كله مع العضو الذي يرجعه ويُتلف عضوه الآخر؛
// والإرجاع المبكر من حلقة ينقل النص الذي قرأه مرجع آخر مرة. تعمل كل حالة مرات
// كثيرة على نصوص في الكومة، ويجب أن تعود البايتات الحية للمخصص بعدها إلى قيمتها
// الأولى: فالقيمة التي لا تُتلف تزيدها، والتي تُتلف مرتين توقف البرنامج في
// المخصص، والمتلفة قبل أوانها تعطي طولًا خاطئًا.
// النظير: tests/en/language/ownership/borrow_drop_paths.sn؛ بلا توجيه زوج:
// المفسر لا يستعمل مخصص المكتبة القياسية الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع زوج = { اليسار: نص, اليمين: نص };

// سبعة أرقام في الكومة.
عرف حمولة(ن: طبيعي): نص { أرجع عدد_إلى_نص((ن + 1000000) مثل عدد); }

عرف خذ(النص: نص): عدد { أرجع الطول(النص) مثل عدد; }

عرف نقل_بعد_استعارة(ن: طبيعي): عدد {
    دع النص: نص = حمولة(ن);
    دع المرئي: &نص = &النص;
    دع الأول: عدد = الطول(*المرئي) مثل عدد;
    إذا ((ن % 2) == 0) {
        أرجع الأول + خذ(النص);
    };
    أرجع الأول;
}

عرف مشروط_ثم_معاد(ن: طبيعي): عدد {
    دع النص: متغير نص;
    إذا ((ن % 3) == 0) { النص := حمولة(ن); };
    النص := حمولة(ن + 1);
    أرجع خذ(النص);
}

عرف نقول_حلقة(ن: طبيعي): عدد {
    دع النص: متغير نص = حمولة(ن);
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        دع العرض: &نص = &النص;
        المجموع := المجموع + (الطول(*العرض) مثل عدد);
        المجموع := المجموع + خذ(النص);
        النص := حمولة(ن + ف);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف يمين(ن: طبيعي): نص {
    دع الاثنان: زوج = { اليسار: حمولة(ن), اليمين: حمولة(ن + 1) };
    دع النظرة: &زوج = &الاثنان;
    إذا (الطول((*النظرة).اليسار) == 0) { أرجع حمولة(0); };
    أرجع الاثنان.اليمين;
}

عرف خروج_مبكر(ن: طبيعي): عدد {
    دع المحفوظ: نص = حمولة(ن);
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) {
        دع الداخلي: نص = حمولة(ن + ف);
        دع المرئي: &نص = &الداخلي;
        إذا (ف == 2) { أرجع المجموع + خذ(الداخلي) + (الطول(المحفوظ) مثل عدد); };
        المجموع := المجموع + (الطول(*المرئي) مثل عدد);
        ف := ف + 1;
    }
    أرجع 0;
}

عرف افحص(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) { أرجع نقل_بعد_استعارة(ن); };
    إذا (الحالة == 1) { أرجع مشروط_ثم_معاد(ن); };
    إذا (الحالة == 2) { أرجع نقول_حلقة(ن); };
    إذا (الحالة == 3) { أرجع خذ(يمين(ن)); };
    أرجع خروج_مبكر(ن);
}

عرف المتوقع(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) {
        إذا ((ن % 2) == 0) { أرجع 14; };
        أرجع 7;
    };
    إذا (الحالة == 1) { أرجع 7; };
    إذا (الحالة == 2) { أرجع 42; };
    إذا (الحالة == 3) { أرجع 7; };
    أرجع 28;
}

عرف الرئيسية(): عدد {
    دع تمهيد: عدد = افحص(0, 0) + افحص(4, 0);
    دع الحالة: متغير طبيعي = 0;
    طالما (الحالة < 5) {
        دع قبل: ط64 = بايتات_حية_مخصص_النظام();
        دع ن: متغير طبيعي = 0;
        طالما (ن < 2000) {
            إذا (افحص(الحالة, ن) != المتوقع(الحالة, ن)) { أرجع 10 + (الحالة مثل عدد); };
            ن := ن + 1;
        }
        دع بعد: ط64 = بايتات_حية_مخصص_النظام();
        إذا (بعد != قبل) { أرجع 20 + (الحالة مثل عدد); };
        الحالة := الحالة + 1;
    }
    إذا (تمهيد != 42) { أرجع 1; };
    أرجع 42;
}
