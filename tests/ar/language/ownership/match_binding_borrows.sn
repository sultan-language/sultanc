// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/match_binding_borrows.sn
// تحمل روابط المطابقة استعارات مميَّزها: فصف الاستعارات الجديدة، والزوج الذي يعيده نداء،
// والمُنشئ حول استعارة، والبقية القابلة للكتابة تحت `طابق &متغير م` يُكتب عبرها في الذراع، ثم
// تُستعمل القيم المستعارة من جديد متى لم تعد الروابط مستعملة
// (docs/ar/internals/ownership-analysis.md، «روابط المطابقة»)، ولو داخل الذراع.
عرف اصنع_زوجا(الهدف: &متغير عدد): (&متغير عدد، عدد) { أرجع (الهدف، 1); }

عرف الرئيسية(): عدد {
    ليكن أ: متغير عدد = 1;
    ليكن ب: عدد = 2;
    طابق (&متغير أ، &ب) مع
    | (الكاتب، القارئ) -> { *الكاتب := *القارئ + 10; };
    ليكن ج: متغير عدد = 0;
    طابق اصنع_زوجا(&متغير ج) مع
    | (الكاتب، الخطوة) -> { *الكاتب := 20 + الخطوة; };
    ليكن د: متغير عدد = 0;
    طابق موجود(&متغير د) مع
    | موجود(الكاتب) -> { *الكاتب := 9; }
    | لا_شيء -> { };
    ليكن القيم: متغير متجه عدد = [1، 2، 3];
    طابق &متغير القيم مع
    | [الأول، بقية الذيل] -> { الذيل[0] := الأول; الذيل[1] := الأول + 4; }
    | [] -> { };
    إذا (أ != 12 || ج != 21 || د != 9) { أرجع 1; };
    إذا (القيم[0] != 1 || القيم[1] != 1 || القيم[2] != 5) { أرجع 2; };
    طابق اقسم_قابلا_للتعديل(&متغير القيم، 1) مع
    | (اليسار، اليمين) -> {
        اليمين[1] := اليسار[0];
        القيم[0] := 30;
    };
    إذا (القيم[0] != 30 || القيم[2] != 1) { أرجع 3; };
    طابق (&متغير أ، 0) مع
    | (الكاتب، _) -> {
        *الكاتب := 0;
        أ := أ + 42;
    };
    أرجع أ;
}
