// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/borrow_early_end.sn
// تنتهي الاستعارة عند آخر استخدام لحاملها، لا عند نهاية كتلته
// (docs/ar/reference/ownership.md، "مناطق الاستعارة"). فبعد آخر استخدام لمرجع
// أو مرجع متغير أو عرض شريحة يجوز في الكتلة نفسها أن تُسند القيمة المستعارة أو
// تُقرأ أو يستعيرها نداء حصريًا أو يُلحق بها أو يُزال آخرها. والمرجع المستخدم
// على فرع واحد يترك القيمة حرة على الفرع الآخر، والمرجع المعاد إسناده في حلقة
// يترك حرة القيمة التي استعارها قبل ذلك.
عرف زد(الهدف: &متغير عدد): عدد {
    *الهدف := *الهدف + 1;
    أرجع *الهدف;
}

عرف إسناد_بعد_آخر_قراءة(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن القارئ: &عدد = &القيمة;
    ليكن المرئي: عدد = *القارئ;
    القيمة := 2;
    أرجع المرئي + القيمة;
}

عرف قراءة_بعد_آخر_كتابة(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن الكاتب: &متغير عدد = &متغير القيمة;
    *الكاتب := 5;
    ليكن النسخة: عدد = القيمة;
    أرجع النسخة;
}

عرف حصرية_بعد_مشتركة(): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن القارئ: &عدد = &القيمة;
    ليكن المرئي: عدد = *القارئ;
    ليكن المزاد: عدد = زد(&متغير القيمة);
    أرجع المرئي + المزاد;
}

عرف إلحاق_بعد_عنصر(): عدد {
    ليكن العناصر: متغير متجه عدد = [4];
    ليكن الأول: &عدد = &العناصر[0];
    ليكن المرئي: عدد = *الأول;
    ألحق(العناصر, 2);
    أرجع المرئي + (الطول(العناصر) مثل عدد);
}

عرف إزالة_بعد_عرض(): عدد {
    ليكن القيم: متغير متجه عدد = [7, 3];
    ليكن العرض: [] عدد = القيم;
    ليكن العدد_المرئي: عدد = الطول(العرض) مثل عدد;
    طابق أزل_الأخير(القيم) مع
    | اختياري.موجود(الأخير) -> { أرجع العدد_المرئي + الأخير; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف فرع_واحد(العلم: منطقي): عدد {
    ليكن القيمة: متغير عدد = 1;
    ليكن الكاتب: &متغير عدد = &متغير القيمة;
    إذا (العلم) {
        *الكاتب := 10;
    } وإلا {
        القيمة := 20;
    };
    أرجع القيمة;
}

عرف مرجع_منقول(): عدد {
    ليكن أ: متغير عدد = 1;
    ليكن ب: عدد = 2;
    ليكن ر: متغير &عدد = &أ;
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        المجموع := المجموع + *ر;
        ر := &ب;
        أ := أ + 10;
        ف := ف + 1;
    }
    أرجع المجموع + أ;
}

عرف الرئيسية(): عدد {
    ليكن المبكرة: عدد = إسناد_بعد_آخر_قراءة() + قراءة_بعد_آخر_كتابة() + حصرية_بعد_مشتركة();
    ليكن الحاويات: عدد = إلحاق_بعد_عنصر() + إزالة_بعد_عرض();
    ليكن الفروع: عدد = فرع_واحد(صواب) + فرع_واحد(خطأ);
    // 11 + 11 + 30 + 36 = 88
    أرجع المبكرة + الحاويات + الفروع + مرجع_منقول() - 46;
}
