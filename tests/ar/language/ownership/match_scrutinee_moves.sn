// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// ذراع المطابقة التي تربط المميز المملوك كله تنقله على مسار تلك الذراع وحده
// (تفصيل الإسقاط، docs/ar/internals/ownership-analysis.md، "النقل إلى خارج
// المالكين"): فعلى كل ذراع أخرى يبقى المميز مع مالكه الذي يتلفه. تعمل كل حالة
// مرات كثيرة على حمولات في الكومة، ويجب أن تعود البايتات الحية للمخصص بعدها إلى
// قيمتها الأولى: فالمميز الذي لا يُتلف يزيدها، والذي يُتلف مرتين يوقف البرنامج في
// المخصص، والحمولة المتلفة قبل أوانها تعطي طولًا خاطئًا. والأذرع التي لا تربط
// المميز تطابق حمولة بحرف بدل، أو تربط جزءًا منها، أو تسقط إلى ما بعد المطابقة؛
// والذراع الرابطة تنقله في بعض مرات التنفيذ فقط، وفي حلقة، ومن معامل ومن ربط
// مطابقة.
// النظير: tests/en/language/ownership/match_scrutinee_moves.sn؛ بلا توجيه زوج:
// المفسر لا يستعمل مخصص المكتبة القياسية الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع صنف = | صغير بنوع عدد | مسمى بنوع نص | زوج بنوع (نص, نص);
نوع غلاف = | بعض بنوع صنف | فارغ;

// سبعة أرقام في الكومة.
عرف حمولة(ن: طبيعي): نص { أرجع عدد_إلى_نص((ن + 1000000) مثل عدد); }

عرف أبق(الصنف: صنف): عدد {
    طابق الصنف مع
    | صنف.صغير(ك) -> { أرجع ك; }
    | صنف.مسمى(ق) -> { أرجع الطول(ق) مثل عدد; }
    | صنف.زوج(أ, ب) -> { أرجع (الطول(أ) + الطول(ب)) مثل عدد; };
}

عرف اصنع(ن: طبيعي): صنف {
    إذا ((ن % 3) == 0) { أرجع صنف.صغير(ن مثل عدد); };
    إذا ((ن % 3) == 1) { أرجع صنف.مسمى(حمولة(ن)); };
    أرجع صنف.زوج(حمولة(ن), حمولة(ن + 1));
}

عرف حرف_بدل(ن: طبيعي): عدد {
    ليكن الصنف: صنف = اصنع(ن);
    طابق الصنف مع
    | صنف.مسمى(_) -> { أرجع 8; }
    | صنف.زوج(أ, _) -> { أرجع الطول(أ) مثل عدد; }
    | الباقي -> { أرجع أبق(الباقي); };
}

عرف يسقط_بعدها(ن: طبيعي): عدد {
    ليكن الصنف: صنف = اصنع(ن);
    ليكن المجموع: متغير عدد = 6;
    طابق الصنف مع
    | صنف.مسمى(_) -> { المجموع := 9; }
    | الباقي -> { المجموع := أبق(الباقي); };
    أرجع المجموع;
}

عرف بعض_المرات(ن: طبيعي): عدد {
    ليكن الصنف: صنف = اصنع(ن);
    طابق الصنف مع
    | صنف.صغير(_) -> { أرجع 4; }
    | الباقي -> {
        إذا ((ن % 2) == 0) { أرجع أبق(الباقي); };
    };
    أرجع 5;
}

عرف في_حلقة(ن: طبيعي): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن الصنف: صنف = اصنع(ن + ف);
        طابق الصنف مع
        | صنف.زوج(_, ب) -> { المجموع := المجموع + (الطول(ب) مثل عدد); }
        | الباقي -> {
            إذا ((ف % 2) == 0) { المجموع := المجموع + أبق(الباقي); };
        };
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف من_معامل(الصنف: صنف): عدد {
    طابق الصنف مع
    | صنف.مسمى(_) -> { أرجع 8; }
    | الباقي -> { أرجع أبق(الباقي); };
}

عرف من_ربط(ن: طبيعي): عدد {
    ليكن الغلاف: غلاف = غلاف.بعض(اصنع(ن));
    طابق الغلاف مع
    | غلاف.بعض(الداخل) -> {
        طابق الداخل مع
        | صنف.زوج(_, _) -> { أرجع 3; }
        | الآخر -> { أرجع أبق(الآخر); };
    }
    | غلاف.فارغ -> { أرجع 0; };
}

عرف افحص(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) { أرجع حرف_بدل(ن); };
    إذا (الحالة == 1) { أرجع يسقط_بعدها(ن); };
    إذا (الحالة == 2) { أرجع بعض_المرات(ن); };
    إذا (الحالة == 3) { أرجع في_حلقة(ن); };
    إذا (الحالة == 4) { أرجع من_معامل(اصنع(ن)); };
    أرجع من_ربط(ن);
}

// ما تعطيه أبق لـ اصنع(ن).
عرف المبقى(ن: طبيعي): عدد {
    إذا ((ن % 3) == 0) { أرجع ن مثل عدد; };
    إذا ((ن % 3) == 1) { أرجع 7; };
    أرجع 14;
}

عرف المتوقع(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) {
        إذا ((ن % 3) == 1) { أرجع 8; };
        إذا ((ن % 3) == 2) { أرجع 7; };
        أرجع ن مثل عدد;
    };
    إذا (الحالة == 1) {
        إذا ((ن % 3) == 1) { أرجع 9; };
        أرجع المبقى(ن);
    };
    إذا (الحالة == 2) {
        إذا ((ن % 3) == 0) { أرجع 4; };
        إذا ((ن % 2) == 0) { أرجع المبقى(ن); };
        أرجع 5;
    };
    إذا (الحالة == 3) {
        ليكن المجموع: متغير عدد = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < 3) {
            إذا (((ن + ف) % 3) == 2) {
                المجموع := المجموع + 7;
            } وإلا {
                إذا ((ف % 2) == 0) { المجموع := المجموع + المبقى(ن + ف); };
            };
            ف := ف + 1;
        }
        أرجع المجموع;
    };
    إذا (الحالة == 4) {
        إذا ((ن % 3) == 1) { أرجع 8; };
        أرجع المبقى(ن);
    };
    إذا ((ن % 3) == 2) { أرجع 3; };
    أرجع المبقى(ن);
}

عرف الرئيسية(): عدد {
    ليكن تمهيد: عدد = افحص(0, 1) + افحص(1, 2);
    ليكن الحالة: متغير طبيعي = 0;
    طالما (الحالة < 6) {
        ليكن قبل: ط64 = بايتات_حية_مخصص_النظام();
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < 2000) {
            إذا (افحص(الحالة, ن) != المتوقع(الحالة, ن)) { أرجع 10 + (الحالة مثل عدد); };
            ن := ن + 1;
        }
        ليكن بعد: ط64 = بايتات_حية_مخصص_النظام();
        إذا (بعد != قبل) { أرجع 20 + (الحالة مثل عدد); };
        الحالة := الحالة + 1;
    }
    إذا (تمهيد != 22) { أرجع 1; };
    أرجع 42;
}
