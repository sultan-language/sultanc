// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/language/ownership/legality_paths.sn
// يقبل تحليل شرعية الملكية (docs/ar/internals/ownership-analysis.md، «الشرعية»)
// كل استعمال أدناه: كل محلي يحمل قيمته حيثما يُقرأ. ذراع المطابقة التي تربط
// المميز كله تنقله على مسارها وحده، فتبقى الذراع التي تسقط إلى ما بعد المطابقة
// حاملة له؛ والمطابقة على ربط مملوك تنقل ذلك الربط وحده؛ والحقل المعاد ينقل
// سجله كله؛ والمحلي المصرح به بلا قيمة يُعطى قيمة على كل مسار قبل قراءته، ومن
// جديد في كل دورة من الحلقة؛ وجسم الحلقة ينقل مالكًا ويعطيه قيمة جديدة قبل
// الدورة التالية؛ والدالة المغلقة تملك النص الذي تلتقطه، ولا يُقرأ بعدها إلا
// عبرها.
نوع صنف = | صغير بنوع عدد | مسمى بنوع نص;
نوع غلاف = | بعض بنوع صنف | فارغ;
نوع شخص = { الاسم: نص, العمر: عدد };

عرف استهلك(النص: نص): عدد { أرجع الطول(النص) مثل عدد; }
عرف أبق(الصنف: صنف): عدد {
    طابق الصنف مع
    | صنف.صغير(ن) -> { أرجع ن; }
    | صنف.مسمى(النص) -> { أرجع استهلك(النص); };
}

عرف ربط_كامل(ن: عدد): عدد {
    دع الصنف: صنف = صنف.صغير(ن);
    طابق الصنف مع
    | صنف.مسمى(النص) -> { أرجع استهلك(النص); }
    | الباقي -> {
        إذا (ن > 100) { أرجع أبق(الباقي); };
    };
    أرجع 1;
}

عرف متداخل(ن: عدد): عدد {
    دع الغلاف: غلاف = غلاف.بعض(صنف.مسمى(«abc»));
    طابق الغلاف مع
    | غلاف.بعض(الداخل) -> {
        طابق الداخل مع
        | صنف.صغير(ك) -> { أرجع ك + ن; }
        | الآخر -> { أرجع أبق(الآخر); };
    }
    | غلاف.فارغ -> { أرجع 0; };
}

عرف إعادة_حقل(ن: عدد): نص {
    دع الشخص: شخص = { الاسم: «ab», العمر: ن };
    أرجع الشخص.الاسم;
}

عرف مؤجل(العلم: منطقي): عدد {
    دع النص: نص;
    إذا (العلم) { النص := «four»; } وإلا { النص := «x»; };
    أرجع استهلك(النص);
}

عرف كل_دورة(): عدد {
    دع ف: متغير عدد = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ف < 3) {
        دع الخطوة: عدد;
        إذا (ف == 1) { الخطوة := 2; } وإلا { الخطوة := 1; };
        المجموع := المجموع + الخطوة;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف منقول_ومعاد(): عدد {
    دع النص: متغير نص = «a»;
    دع ف: متغير عدد = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ف < 3) {
        المجموع := المجموع + استهلك(النص);
        النص := «bb»;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف ملتقط(): عدد {
    دع النص: نص = «seven..»;
    دع د: دالة(عدد): عدد = دالة(س: عدد): عدد -> س + (الطول(النص) مثل عدد);
    أرجع د(0);
}

عرف الرئيسية(): عدد {
    // 1 + 3 + 2 + 4 + 4 + 5 + 7 + 16
    أرجع ربط_كامل(5) + متداخل(0) + (الطول(إعادة_حقل(1)) مثل عدد) + مؤجل(صواب)
        + كل_دورة() + منقول_ومعاد() + ملتقط() + 16;
}
