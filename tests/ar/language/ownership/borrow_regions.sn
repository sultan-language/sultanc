// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/ownership/borrow_regions.sn
// تدوم الاستعارة ما دام حاملها مستخدمًا: فالاستعارة المشتركة الممررة إلى نداء
// تنتهي عند رجوعه، فتصح بعدها استعارة حصرية؛ والمتغير المحلي المرجعي يحمل
// استعارته حتى آخر استخدام له (هنا نهاية كتلته)، ويُعاد استعارته لكل نداء،
// ويعطي المرجع المعاد أصله؛ وبعد ذلك الاستخدام يجوز أن يُستعار المتجه حصريًا من جديد.
عرف زد(العناصر: &متغير متجه عدد): عدد {
    ألحق(*العناصر, 1);
    أرجع الطول(*العناصر) مثل عدد;
}

عرف المجموع(العناصر: &متجه عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        المجموع := المجموع + (*العناصر)[ف];
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الأول(العناصر: &متجه عدد): &عدد {
    أرجع &(*العناصر)[0];
}

عرف الرئيسية(): عدد {
    ليكن العناصر: متغير متجه عدد = [10, 20];
    ليكن أ: عدد = المجموع(&العناصر);
    ليكن ب: عدد = زد(&متغير العناصر);
    ليكن ج: متغير عدد = 0;
    ليكن د: متغير عدد = 0;
    إذا (ب > 0) {
        ليكن العرض: &متجه عدد = &العناصر;
        ج := المجموع(العرض);
        د := *الأول(العرض);
    };
    ليكن هـ: عدد = زد(&متغير العناصر);
    أرجع أ + ب + ج + د + هـ - 36;
}
