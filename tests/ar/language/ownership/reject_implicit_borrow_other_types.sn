// اختبار: رفض
// تشخيص: SULTANC-CALL-ARGUMENT-TYPE-MISMATCH
// نظير: tests/en/language/ownership/reject_implicit_borrow_other_types.sn
// لا يُستعار ضمنيا إلا وسيط النص: المتجه لمعامل من نوع `&متجه عدد` يحتاج `&`.
عرف مجموع(م: &متجه عدد): عدد { أرجع الطول(*م) مثل عدد; }

عرف الرئيسية(): عدد {
    دع م: متجه عدد = [1, 2];
    أرجع مجموع(م);
}
