// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// قيمة تعبير المطابقة هي القيمة المملوكة للذراع الذي يطابق
// (docs/ar/book/ch06-02-match.md): فالربط ينتقل من المميز إلى الناتج، وحقل
// الربط يأخذ الربط كله، والمحلي ينتقل إليه على بعض المسارات فقط، والأذرع التي
// لا تربط شيئا تترك المميز لمالكه الذي يتلفه. تعمل كل حالة مرات كثيرة على
// حمولات في الكومة، ويجب أن تعود البايتات الحية للمخصص بعدها إلى قيمتها الأولى:
// فالقيمة التي لا تُتلف تزيدها، والتي تُتلف مرتين توقف البرنامج في المخصص،
// والتي تُتلف قبل أوانها تعطي طولا خاطئا.
// النظير: tests/en/language/ownership/match_expression_moves.sn؛ بلا توجيه زوج:
// المفسر لا يستعمل مخصص المكتبة القياسية الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع مسمى = { الاسم: نص, الرقم: عدد };
نوع صنف = | صغير بنوع عدد | مسمى_نصا بنوع نص | مدون بنوع مسمى;

// سبعة أرقام في الكومة.
عرف حمولة(ن: طبيعي): نص { أرجع عدد_إلى_نص((ن + 1000000) مثل عدد); }

عرف اصنع(ن: طبيعي): صنف {
    إذا ((ن % 3) == 0) { أرجع صنف.صغير(ن مثل عدد); };
    إذا ((ن % 3) == 1) { أرجع صنف.مسمى_نصا(حمولة(ن)); };
    ليكن العنصر: مسمى = { الاسم: حمولة(ن), الرقم: ن مثل عدد };
    أرجع صنف.مدون(العنصر);
}

عرف نص_من(ن: طبيعي): نص {
    ليكن الصنف: صنف = اصنع(ن);
    ليكن النص: نص = طابق الصنف مع
    | صنف.مسمى_نصا(ت) -> ت
    | صنف.مدون(ر) -> ر.الاسم
    | صنف.صغير(_) -> «small»;
    أرجع النص;
}

عرف منقول_أحيانا(ن: طبيعي): عدد {
    ليكن الخاص: نص = حمولة(ن);
    ليكن المأخوذ: نص = طابق ن % 2 مع
    | 0 -> الخاص
    | _ -> «odd»;
    أرجع الطول(المأخوذ) مثل عدد;
}

عرف في_حلقة(ن: طبيعي): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        ليكن القطعة: نص = طابق اصنع(ن + ف) مع
        | صنف.مسمى_نصا(ت) -> ت
        | صنف.مدون(ر) -> ر.الاسم
        | صنف.صغير(_) -> «s»;
        المجموع := المجموع + (الطول(القطعة) مثل عدد);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف من_معامل(الصنف: صنف): نص {
    أرجع طابق الصنف مع
    | صنف.مسمى_نصا(ت) -> ت
    | صنف.مدون(ر) -> ر.الاسم
    | صنف.صغير(_) -> «small»;
}

عرف عبر_إغلاق(ن: طبيعي): عدد {
    ليكن القياس: دالة(صنف): عدد = دالة(الصنف: صنف): عدد -> طابق الصنف مع
        | صنف.مسمى_نصا(ت) -> الطول(ت) مثل عدد
        | صنف.مدون(ر) -> الطول(ر.الاسم) مثل عدد
        | صنف.صغير(ك) -> ك;
    أرجع القياس(اصنع(ن));
}

عرف افحص(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0) { أرجع الطول(نص_من(ن)) مثل عدد; };
    إذا (الحالة == 1) { أرجع منقول_أحيانا(ن); };
    إذا (الحالة == 2) { أرجع في_حلقة(ن); };
    إذا (الحالة == 3) { أرجع الطول(من_معامل(اصنع(ن))) مثل عدد; };
    أرجع عبر_إغلاق(ن);
}

// طول النص الذي يعطيه ذراع لـ اصنع(ن).
عرف طول_القطعة(ن: طبيعي, الصغير: عدد): عدد {
    إذا ((ن % 3) == 0) { أرجع الصغير; };
    أرجع 7;
}

عرف المتوقع(الحالة: طبيعي, ن: طبيعي): عدد {
    إذا (الحالة == 0 || الحالة == 3) { أرجع طول_القطعة(ن, 5); };
    إذا (الحالة == 1) {
        إذا ((ن % 2) == 0) { أرجع 7; };
        أرجع 3;
    };
    إذا (الحالة == 2) {
        أرجع طول_القطعة(ن, 1) + طول_القطعة(ن + 1, 1) + طول_القطعة(ن + 2, 1);
    };
    أرجع طول_القطعة(ن, ن مثل عدد);
}

عرف الرئيسية(): عدد {
    ليكن التحمية: عدد = افحص(0, 1) + افحص(1, 2);
    ليكن الحالة: متغير طبيعي = 0;
    طالما (الحالة < 5) {
        ليكن قبل: ط64 = بايتات_حية_مخصص_النظام();
        ليكن ن: متغير طبيعي = 0;
        طالما (ن < 2000) {
            إذا (افحص(الحالة, ن) != المتوقع(الحالة, ن)) { أرجع 10 + (الحالة مثل عدد); };
            ن := ن + 1;
        }
        ليكن بعد: ط64 = بايتات_حية_مخصص_النظام();
        إذا (بعد != قبل) { أرجع 20 + (الحالة مثل عدد); };
        الحالة := الحالة + 1;
    }
    إذا (التحمية != 14) { أرجع 1; };
    أرجع 42;
}
