// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE
// نظير: tests/en/language/ownership/reject_reference_field_write.sn
// الكتابة إلى `ن.س` عبر مرجع مشترك كتابة إلى موضع غير قابل للتغيير: لا يكتب
// عبر المرجع إلا `&متغير`.
نوع نقطة = { س: عدد, ع: عدد };

عرف صفر_السين(ن: &نقطة): فراغ { ن.س := 0; }

عرف الرئيسية(): عدد {
    دع النقطة: نقطة = { س: 1, ع: 2 };
    صفر_السين(&النقطة);
    أرجع النقطة.س;
}
