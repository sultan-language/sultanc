// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/decorator.sn
عرف add_one(وقت_الترجمة f: دالة(عدد): عدد, x: عدد): عدد {
    أرجع f(x) + 1;
}

عرف twice(وقت_الترجمة f: دالة(عدد): عدد, x: عدد): عدد {
    أرجع f(f(x));
}

@add_one
@twice
عرف triple(x: عدد): عدد { أرجع x * 3; }

عرف الرئيسية(): عدد {
    دع n: متغير عدد = 1;
    n := n + 1;
    أرجع triple(n) + 23;
}
