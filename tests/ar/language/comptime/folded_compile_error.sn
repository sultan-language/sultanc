// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/folded_compile_error.sn
// في النسخة المخصصة يُطوى `إذا` وقت التشغيل الذي تحسم شرطه حجج وقت الترجمة، إذ
// لا يحلَّل إلا الفرع المأخوذ من شرط معروف وقت الترجمة: فشل_وقت_الترجمة في
// فرع غير مأخوذ لا يقع أبدا، ولا يقيَّم عمل وقت الترجمة فيه.
استورد المكتبة.انعكاس.reflect;

عرف مفحوص(وقت_الترجمة ع: عدد, س: عدد): عدد {
    إذا (ع > 10) {
        فشل_وقت_الترجمة(«يجب ألا يتجاوز ع 10»);
    };
    إذا (ع < 0 || ع == 99) {
        فشل_وقت_الترجمة(«يجب ألا يكون ع سالبا»);
    } وإلا {
        إذا (ع + 1 > 100) { فشل_وقت_الترجمة(«لا يبلغ»); };
    };
    أرجع ع + س;
}

عرف اقسم(وقت_الترجمة القاسم: عدد, س: عدد): عدد {
    إذا (القاسم == 0) {
        أرجع 0;
    };
    // يقيَّم في النسخ ذات القاسم غير الصفري وحدها.
    دع ق: عدد = وقت_الترجمة (100 / القاسم);
    أرجع ق + س;
}

عرف الرئيسية(): عدد {
    دع س: متغير عدد = 1;
    س := س + 1;
    دع أ: عدد = مفحوص(4, س);
    دع ب: عدد = اقسم(0, س);
    دع ج: عدد = اقسم(10, س);
    إذا (أ != 6 || ب != 0 || ج != 12) { أرجع 1; };
    أرجع أ + ب + ج + 24;
}
