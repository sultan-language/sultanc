// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/comptime/budget_override.sn
// ميزانية_وقت_الترجمة ترفع ميزانية تعليمات التقييم الذي تعمل فيه: تحتاج هذه
// الحلقة أكثر من عشرة ملايين تعليمة.
من std.meta استورد ميزانية_وقت_الترجمة;
عرف مجموع_طويل(): عدد {
    ميزانية_وقت_الترجمة(60000000);
    دع المجموع: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < 2500000) { المجموع := المجموع + 1; ف := ف + 1; }
    أرجع المجموع;
}
عرف الرئيسية(): عدد {
    دع المجموع: عدد = وقت_الترجمة { مجموع_طويل() };
    إذا (المجموع != 2500000) { أرجع 1; };
    أرجع 42;
}
