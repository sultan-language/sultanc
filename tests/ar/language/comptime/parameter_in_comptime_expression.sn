// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/parameter_in_comptime_expression.sn
// معامل وقت الترجمة ثابت داخل النسخة المخصصة، فتستعمله تعابير `وقت_الترجمة`:
// وحده، وفي الحساب، وحجة لنداء، وفي كتلة تلي تدفق تحكم وقت التشغيل.
عرف ضاعف(ق: عدد): عدد { أرجع ق * 2; }

عرف حجم(وقت_الترجمة المعامل: عدد, س: عدد): عدد {
    دع ك: عدد = وقت_الترجمة المعامل;
    دع زائد: عدد = وقت_الترجمة (المعامل + 1);
    دع مضاعف: عدد = وقت_الترجمة ضاعف(المعامل);
    دع الكلي: متغير عدد = س;
    لو (س > 100) { الكلي := 0; };
    // كتلة لاحقة: تعريف المعامل في كتلة الدخول.
    دع لاحق: عدد = وقت_الترجمة (المعامل * المعامل);
    أرجع الكلي + ك + زائد + مضاعف + لاحق;
}

عرف عد_البايتات(ن: نص): عدد { أرجع الطول(ن) مثل عدد; }

عرف وسم(وقت_الترجمة النص: نص, س: عدد): عدد {
    دع ع: عدد = وقت_الترجمة عد_البايتات(النص);
    أرجع س + ع;
}

عرف الرئيسية(): عدد {
    دع ع: متغير عدد = 1;
    ع := ع + 1;
    دع أ: عدد = حجم(3, ع);
    دع ب: عدد = وسم(«abcd», ع);
    لو (أ != 24 || ب != 6) { أرجع 1; };
    // نسخة ثانية لثابت آخر؛ والأولى مشتركة.
    لو (حجم(1, ع) != 2 + 1 + 2 + 2 + 1) { أرجع 2; };
    لو (حجم(3, ع) != 24) { أرجع 3; };
    أرجع أ + ب + 12;
}
