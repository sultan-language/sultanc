// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-COMPTIME-FAILED
// نظير: tests/en/language/comptime/reject_folded_compile_error.sn
// خرج-تشخيص-عربي: reject_folded_compile_error.ar.txt
// النسخة المخصصة للعدد 42 تأخذ الفرع الذي فيه فشل_وقت_الترجمة: تفشل الترجمة
// برسالته، ولا يصير فخا وقت التشغيل.
استورد المكتبة.انعكاس.reflect;

عرف مفحوص(وقت_الترجمة ع: عدد, س: عدد): عدد {
    لو (ع > 10) {
        فشل_وقت_الترجمة(«يجب ألا يتجاوز ع 10»);
    };
    أرجع ع + س;
}

عرف الرئيسية(): عدد {
    دع س: متغير عدد = 1;
    س := س + 1;
    أرجع مفحوص(42, س);
}
