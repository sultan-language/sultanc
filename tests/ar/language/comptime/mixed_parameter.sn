// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/mixed_parameter.sn
عرف scale(وقت_الترجمة factor: عدد, x: عدد): عدد {
    أرجع x * factor;
}

عرف apply(وقت_الترجمة f: دالة(عدد): عدد, x: عدد): عدد {
    أرجع f(x) + 1;
}

عرف double(x: عدد): عدد { أرجع x * 2; }

عرف الرئيسية(): عدد {
    دع n: متغير عدد = 4;
    n := n + 1;
    أرجع scale(6, n) + apply(double, n) + 1;
}
