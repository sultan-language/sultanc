// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/definition_decorators.sn
// مزخرفات وقت التعريف: `@@سجل(«/a») عرف أ` يترك أ كما كُتبت وتستدعي نقطة
// الدخول سجل(«/a», أ) مرة قبل جسمها، بترتيب التصريحات، كما يسجل موجه مساراته.
نوع مسار = { الطريق: نص, المعالج: دالة(عدد): عدد };
دع المسارات: متغير متجه مسار = [];

عرف سجل(الطريق: نص, المعالج: دالة(عدد): عدد): فراغ {
    دع م: مسار = { الطريق: الطريق, المعالج: المعالج };
    غير_آمن { ألحق(المسارات, م); }
}

@@سجل(«/a»)
عرف أ(س: عدد): عدد { أرجع س + 1; }

@@سجل(«/b»)
عرف ب(س: عدد): عدد { أرجع س * 2; }

عرف الرئيسية(): عدد {
    دع العدد: طبيعي;
    غير_آمن { العدد := الطول(المسارات) مثل طبيعي; }
    إذا (العدد != 2) { أرجع 1; };
    إذا (أ(1) != 2) { أرجع 2; };
    دع الناتج: عدد;
    غير_آمن { الناتج := المسارات[1].المعالج(20) + 2; }
    أرجع الناتج;
}
