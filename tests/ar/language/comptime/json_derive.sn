// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/comptime/json_derive.sn
// JSON المشتق (`@@json`): يولد المترجم من تصريح النوع مرمزا ومفككا ومخططا.
// يجري الترميز والمخطط وقت الترجمة فيفشل الترجمة أي خطأ فيهما (سجل متداخل،
// ومتجهات، واختياري غائب يصير null، وتعداد بحمولات وبلا حمولات، وهروب
// النصوص)، ويجري التفكيك وقت التشغيل: رحلة ذهاب وإياب تعطي النص نفسه، وحقل
// مفقود يسمي مساره في الخطأ.
استورد std.meta.reflect;
استورد std.text.compare;
استورد std.text.from_bytes;

@@json
نوع شكل = | دائرة بنوع عدد | مربع | مستطيل بنوع (عدد, عدد);

@@json
نوع عنوان = { المدينة: نص, الرمز: ط32 };

@@json
نوع مستخدم = {
    الاسم: نص,
    العمر: عدد,
    مفعل: منطقي,
    العنوان: عنوان,
    الوسوم: متجه نص,
    الهاتف: اختياري نص,
    الأشكال: متجه شكل
};

@@json
نوع قياس = { القيمة: ع64 };

عرف نموذج(): نص {
    دع الوسوم: متغير متجه نص = [];
    ألحق(الوسوم, «أ»);
    دع الأشكال: متغير متجه شكل = [];
    ألحق(الأشكال, شكل.دائرة(3));
    ألحق(الأشكال, شكل.مربع());
    ألحق(الأشكال, شكل.مستطيل(2, 5));
    دع م: مستخدم = {
        الاسم: «سارة», العمر: 31, مفعل: صواب,
        العنوان: { المدينة: «الرياض», الرمز: 12345 },
        الوسوم: الوسوم, الهاتف: اختياري.لا_شيء(), الأشكال: الأشكال
    };
    أرجع جسون__مستخدم(&م);
}

عرف تحقق(): عدد {
    دع الوسوم: متغير متجه نص = [];
    ألحق(الوسوم, «أ»);
    ألحق(الوسوم, "b\"q");
    دع الأشكال: متغير متجه شكل = [];
    ألحق(الأشكال, شكل.دائرة(3));
    ألحق(الأشكال, شكل.مربع());
    ألحق(الأشكال, شكل.مستطيل(2, 5));
    دع م: مستخدم = {
        الاسم: «سارة», العمر: 31, مفعل: صواب,
        العنوان: { المدينة: «الرياض», الرمز: 12345 },
        الوسوم: الوسوم, الهاتف: اختياري.لا_شيء(), الأشكال: الأشكال
    };
    دع ج: نص = جسون__مستخدم(&م);
    دع المتوقع: نص = "{\"الاسم\":\"سارة\",\"العمر\":31,\"مفعل\":true,\"العنوان\":{\"المدينة\":\"الرياض\",\"الرمز\":12345},\"الوسوم\":[\"أ\",\"b\\\"q\"],\"الهاتف\":null,\"الأشكال\":[{\"tag\":\"دائرة\",\"values\":[3]},\"مربع\",{\"tag\":\"مستطيل\",\"values\":[2,5]}]}";
    إذا (!نصان_متساويان(&ج, &المتوقع)) { فشل_وقت_الترجمة(انسخ_نص(&ج)); };
    دع المخطط: متجه حقل_مخطط_جسون = مخطط_جسون__مستخدم();
    إذا ((الطول(المخطط) مثل عدد) != 7 || المخطط[5].مطلوب || !نصان_متساويان(&المخطط[3].النوع, &«object»)) { فشل_وقت_الترجمة(«schema»); };
    أرجع 42;
}

عرف فك(ج: &نص): عدد {
    طابق من_جسون__مستخدم(ج) مع
    | نتيجة.نجح(ع) -> {
        إذا (ع.العمر != 31 || !نصان_متساويان(&ع.العنوان.المدينة, &«الرياض») || (الطول(ع.الأشكال) مثل عدد) != 3) { أوقف(«roundtrip»); };
        دع ج2: نص = جسون__مستخدم(&ع);
        إذا (!نصان_متساويان(ج, &ج2)) { أوقف(انسخ_نص(&ج2)); };
    }
    | نتيجة.خطأ(خ) -> { أوقف(خ); };
    طابق من_جسون__مستخدم(&"{\"الاسم\":\"x\"}") مع
    | نتيجة.نجح(_) -> { أوقف(«missing accepted»); }
    | نتيجة.خطأ(خ) -> { إذا (!نصان_متساويان(&خ, &«العمر: missing»)) { أوقف(خ); }; };
    أرجع 0;
}

عرف أوقف(الرسالة: نص): فراغ { دع ص: عدد = 0; دع ق: عدد = 1 / ص; }

عرف الرئيسية(): عدد {
    دع ن: عدد = comptime { تحقق() };
    دع ج: نص = comptime { نموذج() };
    دع ق: قياس = { القيمة: 1.5 };
    إذا (!نصان_متساويان(&جسون__قياس(&ق), &"{\"القيمة\":1.5}")) { أرجع 1; };
    أرجع ن + فك(&ج);
}
