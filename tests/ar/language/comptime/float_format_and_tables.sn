// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/comptime/float_format_and_tables.sn
// تقرأ شفرة وقت الترجمة ثوابت الوحدات غير القابلة للتغيير (تنسيق العائم في
// std.text يستعمل جداول قوى العشرة)، وتنسخ متجه قيم بسيطة بخطوة واحدة.
من std.text استورد ع64_إلى_نص;
عرف منسق(): نص { أرجع ع64_إلى_نص(3.25); }
عرف نسخ(): عدد {
    دع م: متغير متجه عدد = [7];
    طالما (الطول(م) < 200000) {
        دع ن: متجه عدد = استنسخ(&م);
        ألحق_من(م, &ن, 0 مثل طبيعي, الطول(ن) مثل طبيعي);
    }
    دع و: متجه عدد = استنسخ(&م);
    أرجع الطول(و) مثل عدد;
}
عرف الرئيسية(): عدد {
    دع النص: نص = وقت_الترجمة { منسق() };
    دع العدد: عدد = وقت_الترجمة { نسخ() };
    إذا (الطول(النص) != 4 || النص[1] != 46) { أرجع 1; };
    إذا (العدد < 200000) { أرجع 2; };
    أرجع 42;
}
