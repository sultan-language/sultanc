// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/comptime/function_values.sn
// قيم الدوال وقت الترجمة: جدول مسارات من دوال معالجة يبنى ويوزع داخل كتلة
// وقت الترجمة، واسم دالة يمرر حجة لنداء وقت الترجمة هو تلك الدالة.
نوع مسار = { الطريق: نص, المعالج: دالة(عدد): عدد };
عرف ضاعف(س: عدد): عدد { أرجع س * 2; }
عرف عشرة_أضعاف(س: عدد): عدد { أرجع س * 10; }
عرف طبق(د: دالة(عدد): عدد, س: عدد): عدد { أرجع د(س); }
عرف وزع(الطريق: نص, س: عدد): عدد {
    دع المسارات: متغير متجه مسار = [];
    دع الأول: مسار = { الطريق: «/double», المعالج: ضاعف };
    دع الثاني: مسار = { الطريق: «/ten», المعالج: عشرة_أضعاف };
    ألحق(المسارات, الأول);
    ألحق(المسارات, الثاني);
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(المسارات) مثل عدد) {
        إذا (الطول(المسارات[ف مثل طبيعي].الطريق) == الطول(الطريق)) {
            دع د: دالة(عدد): عدد = المسارات[ف مثل طبيعي].المعالج;
            أرجع د(س);
        };
        ف := ف + 1;
    }
    أرجع -1;
}
عرف الرئيسية(): عدد {
    دع الموزع: عدد = وقت_الترجمة { وزع(«/ten», 4) };
    دع المطبق: عدد = وقت_الترجمة { طبق(ضاعف, 1) };
    أرجع الموزع + المطبق;
}
