// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-COMPTIME-FAILED
// نظير: tests/en/language/comptime/reject_runtime_branch_compile_error.sn
// فشل_وقت_الترجمة على مسار تحسمه بيانات وقت التشغيل يحلَّل في النسخة المخصصة
// ويفشل الترجمة: لا يصير فخا وقت التشغيل في الشفرة المخصصة.
استورد المكتبة.انعكاس.reflect;

عرف محروس(وقت_الترجمة ع: عدد, س: عدد): عدد {
    لو (س > ع) {
        فشل_وقت_الترجمة(«س معروف وقت التشغيل وحده»);
    };
    أرجع س;
}

عرف الرئيسية(): عدد {
    دع س: متغير عدد = 1;
    س := س + 1;
    أرجع محروس(5, س);
}
