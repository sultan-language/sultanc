// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-BY-VALUE
// نظير: tests/en/language/opaque/reject_reference.sn
// مرجع إلى نوع معتم: لا يشير إليه إلا مؤشر خام.
نوع قاعدة = معتم;
عرف الرئيسية(): عدد {
    دع م: *قاعدة = 0 مثل *قاعدة;
    غير_آمن { دع ر: &قاعدة = م مثل &قاعدة; };
    أرجع 0;
}
