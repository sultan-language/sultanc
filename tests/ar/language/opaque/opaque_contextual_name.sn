// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/opaque_contextual_name.sn
// `معتم` سياقية: لا تعلن نوعا معتما إلا إذا كانت الطرف الأيمن كله من تصريح
// نوع. وفي غير ذلك هي اسم عادي: محلي ومعامل ودالة.
نوع مقبض = معتم;

عرف قيمة_معتمة(معتم: عدد): عدد { أرجع معتم + 1; }

عرف الرئيسية(): عدد {
    دع معتم: عدد = 20;
    دع م: *مقبض = 0 مثل *مقبض;
    إذا (م == 0 مثل *مقبض) { أرجع قيمة_معتمة(معتم) + 21; };
    أرجع 1;
}
