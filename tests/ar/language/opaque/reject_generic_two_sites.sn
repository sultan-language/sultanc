// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// خرج-تشخيص-إنجليزي: reject_generic_two_sites.en.txt
// خرج-تشخيص-عربي: reject_generic_two_sites.ar.txt
// نظير: tests/en/language/opaque/reject_generic_two_sites.sn
// دالة عامة واحدة تُنادى من موضعين: بحجة سجل تصح، وبحجة معتمة لا يصح
// استعمالها بالقيمة. الخطأ عند النداء الثاني، والاستعمال داخل الدالة سياق
// مرتبط.
نوع قاعدة = معتم;
نوع سجل_ما = { س: عدد };
عرف اقرأ<أ>(م: *أ): عدد {
    غير_آمن { دع النسخة: أ = *م; };
    أرجع 0;
}
عرف الرئيسية(): عدد {
    دع ر: سجل_ما = { س: 1 };
    دع جيد: عدد = اقرأ((&ر) مثل *سجل_ما);
    أرجع جيد + اقرأ(0 مثل *قاعدة);
}
