// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_nested.sn
// الاستعمال بالقيمة على عمق مثيلين؛ يشير الخطأ إلى نداء المستخدم وإلى
// الاستعمال.
نوع قاعدة = معتم;
عرف الداخلية<أ>(م: *أ): عدد {
    غير_آمن { دع النسخة: أ = *م; };
    أرجع 0;
}
عرف الخارجية<أ>(م: *أ): عدد { أرجع الداخلية(م); }
عرف الرئيسية(): عدد { أرجع الخارجية(0 مثل *قاعدة); }
