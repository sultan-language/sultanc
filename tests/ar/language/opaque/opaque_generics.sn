// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/opaque_generics.sn
// شيفرة عامة لا تستعمل حجة النوع المعتمة إلا عبر المؤشرات: فحص الفارغ،
// والمقارنة، ومتجه مؤشرات، وسجل عام حقوله مؤشرات. يُفحص كل مثيل على جسمه.
نوع قاعدة = معتم;
نوع عقدة<أ> = { العنصر: *أ, التالي: *عقدة<أ> };

عرف افتح_عند(الكلمة: ط64): *قاعدة {
    غير_آمن { أرجع الكلمة مثل *قاعدة; };
}
عرف فارغ<أ>(م: *أ): منطقي { أرجع م == 0 مثل *أ; }
عرف نفسه<أ>(أ1: *أ, ب1: *أ): منطقي { أرجع أ1 == ب1; }
عرف عدد_الأحياء<أ>(الكل: &متجه *أ): عدد {
    دع ن: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكل) مثل طبيعي)) {
        إذا (!فارغ((*الكل)[ف])) { ن := ن + 1; };
        ف := ف + 1;
    }
    أرجع ن;
}
عرف الأول<أ>(الكل: &متجه *أ): *أ { أرجع (*الكل)[0]; }

عرف الرئيسية(): عدد {
    دع لا_شيء_منها: *قاعدة = 0 مثل *قاعدة;
    دع ق: *قاعدة = افتح_عند(4096);
    دع الكل: متغير متجه *قاعدة = [];
    ألحق(الكل, ق);
    ألحق(الكل, لا_شيء_منها);
    ألحق(الكل, ق);
    دع العقدة: عقدة<قاعدة> = { العنصر: ق, التالي: 0 مثل *عقدة<قاعدة> };
    دع المجموع: متغير عدد = 0;
    إذا (فارغ(لا_شيء_منها) && !فارغ<قاعدة>(الأول(&الكل))) { المجموع := المجموع + 10; };
    إذا (نفسه(الأول(&الكل), ق) && نفسه(العقدة.العنصر, ق)) { المجموع := المجموع + 10; };
    المجموع := المجموع + عدد_الأحياء(&الكل) * 11;
    أرجع المجموع;
}
