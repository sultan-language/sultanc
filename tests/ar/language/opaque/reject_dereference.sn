// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-DEREFERENCE
// نظير: tests/en/language/opaque/reject_dereference.sn
// فك مؤشر إلى نوع معتم، حتى داخل غير_آمن.
نوع قاعدة = معتم;
عرف الرئيسية(): عدد {
    دع م: *قاعدة = 0 مثل *قاعدة;
    غير_آمن { دع س: عدد = *م; };
    أرجع 0;
}
