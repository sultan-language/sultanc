// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_record_by_value.sn
// مثيل سجل عام يحمل حقله حجة النوع المعتمة بالقيمة (حقل المؤشر جائز).
نوع قاعدة = معتم;
نوع صندوق_قيمة<أ> = { القيمة: أ };
عرف الرئيسية(): عدد {
    دع م: *صندوق_قيمة<قاعدة> = 0 مثل *صندوق_قيمة<قاعدة>;
    أرجع 0;
}
