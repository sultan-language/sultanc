// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_result.sn
// مثيل يرجع توقيعه حجة نوعه المعتمة بالقيمة: فيسلم النداء قيمة منها.
نوع قاعدة = معتم;
عرف اقرأ<أ>(م: *أ): أ {
    غير_آمن { أرجع *م; };
}
عرف الرئيسية(): عدد {
    دع م: *قاعدة = 0 مثل *قاعدة;
    اقرأ(م);
    أرجع 0;
}
