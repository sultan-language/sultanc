// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/modules/main.sn
// أنواع معتمة عامة تُستعمل من وحدة أخرى: تُمرر مؤشراتها وتُرجع وتُخزن
// وتُقارن، والمرادف العام هو النوع نفسه.
استورد "store.sn";

نوع جلسة = { الاتصال: *مقبض, العبارات: متجه *عبارة_معدة };

عرف الرئيسية(): عدد {
    دع الاتصال: *اتصال = اتصل(4096);
    دع العبارة: *عبارة_معدة = أعد(الاتصال);
    دع الجلسة: جلسة = { الاتصال: الاتصال, العبارات: [العبارة] };
    دع المجموع: متغير عدد = 0;
    إذا (الجلسة.الاتصال == الاتصال) { المجموع := المجموع + 10; };
    إذا (الجلسة.العبارات[0] != 0 مثل *عبارة_معدة) { المجموع := المجموع + 16; };
    المجموع := المجموع + إزاحة_العبارة(الجلسة.الاتصال, الجلسة.العبارات[0]) مثل عدد;
    أرجع المجموع;
}
