// الوحدة المالكة لأنواع المقابض المعتمة، كما تفعل ربطة سي.
عام نوع اتصال = معتم;
عام نوع عبارة_معدة = معتم;
عام نوع مقبض = اتصال;

عام عرف اتصل(العنوان: ط64): *اتصال {
    غير_آمن { أرجع العنوان مثل *اتصال; };
}

عام عرف أعد(الاتصال: *اتصال): *عبارة_معدة {
    غير_آمن { أرجع ((الاتصال مثل ط64) + 16) مثل *عبارة_معدة; };
}

عام عرف إزاحة_العبارة(الاتصال: *مقبض, العبارة: *عبارة_معدة): ط64 {
    غير_آمن { أرجع (العبارة مثل ط64) - (الاتصال مثل ط64); };
}
