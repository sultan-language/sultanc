// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/opaque_pointers.sn
// مؤشرات إلى أنواع معتمة: الفارغ و== و!=، والمعاملات والنواتج، والمحليات،
// وحقول السجلات، والمتجهات، ومرادف النوع المعتم (النوع نفسه)، وكلمات
// العناوين في الاتجاهين.
نوع قاعدة = معتم;
نوع جملة = معتم;
نوع مرادف_القاعدة = قاعدة;
نوع حامل = { القاعدة: *قاعدة, الجمل: متجه *جملة, العدد: عدد };

عرف افتح_عند(العنوان: ط64): *قاعدة {
    غير_آمن { أرجع العنوان مثل *قاعدة; };
}

عرف متساويتان(أ: *قاعدة, ب: *مرادف_القاعدة): منطقي { أرجع أ == ب; }

عرف أول_قاعدة(الحامل: &حامل): *قاعدة { أرجع (*الحامل).القاعدة; }

عرف الرئيسية(): عدد {
    دع لا_شيء_منها: *قاعدة = 0 مثل *قاعدة;
    دع ق: *قاعدة = افتح_عند(4096);
    دع قابلة_للكتابة: متغير *متغير قاعدة = 0 مثل *متغير قاعدة;
    غير_آمن { قابلة_للكتابة := 8192 مثل *متغير قاعدة; };
    دع الحامل: حامل = { القاعدة: ق, الجمل: [0 مثل *جملة], العدد: 1 };
    دع الكل: متغير متجه *قاعدة = [];
    ألحق(الكل, ق);
    ألحق(الكل, لا_شيء_منها);
    دع العنوان: ط64 = أول_قاعدة(&الحامل) مثل ط64;
    دع عنوان_الكتابة: ط64 = قابلة_للكتابة مثل ط64;
    دع المجموع: متغير عدد = 0;
    إذا (متساويتان(الحامل.القاعدة, الكل[0])) { المجموع := المجموع + 10; };
    إذا (الكل[1] == لا_شيء_منها && لا_شيء_منها != ق) { المجموع := المجموع + 10; };
    إذا (الحامل.الجمل[0] == 0 مثل *جملة) { المجموع := المجموع + 10; };
    إذا (العنوان == 4096 && عنوان_الكتابة == 8192) { المجموع := المجموع + 12; };
    أرجع المجموع;
}
