// تشخيص: SULTANC-TYPE-OPAQUE-FIELD-ACCESS
// نظير: tests/en/language/opaque/reject_field_access.sn
// قراءة حقل عبر مؤشر إلى نوع معتم: لا يعلن حقولا.
نوع قاعدة = معتم;
عرف الرئيسية(): عدد {
    دع م: *قاعدة = 0 مثل *قاعدة;
    غير_آمن { أرجع م.المقبض; };
}
