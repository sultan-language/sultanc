// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/opaque_pointer_casts.sn
// تحويلات مؤشر خام إلى مؤشر خام داخل غير_آمن: من *T إلى *متغير T وعودة،
// ومن *T إلى *فراغ وعودة، ومن *متغير T عبر *متغير فراغ، ومن *A إلى *B بين
// سجلين.
نوع قاعدة = معتم;
نوع أول = { القيمة: عدد };
نوع ثان = { أخرى: عدد };

عرف الرئيسية(): عدد {
    دع السجل: أول = { القيمة: 22 };
    دع المؤشر_الأول: *أول = (&السجل) مثل *أول;
    دع المجموع: متغير عدد = 0;
    غير_آمن {
        دع ق: *قاعدة = 4096 مثل *قاعدة;
        دع للكتابة: *متغير قاعدة = ق مثل *متغير قاعدة;
        دع للقراءة: *قاعدة = للكتابة مثل *قاعدة;
        دع بلا_نوع: *فراغ = للقراءة مثل *فراغ;
        دع ثانية: *قاعدة = بلا_نوع مثل *قاعدة;
        دع بلا_نوع_للكتابة: *متغير فراغ = للكتابة مثل *متغير فراغ;
        دع ثانية_للكتابة: *متغير قاعدة = بلا_نوع_للكتابة مثل *متغير قاعدة;
        إذا (ثانية == ق && ثانية_للكتابة == للكتابة && (ثانية مثل ط64) == 4096) {
            المجموع := المجموع + 20;
        };
        دع المؤشر_الثاني: *ثان = المؤشر_الأول مثل *ثان;
        دع العائد: *أول = المؤشر_الثاني مثل *أول;
        المجموع := المجموع + (*العائد).القيمة;
    };
    أرجع المجموع;
}
