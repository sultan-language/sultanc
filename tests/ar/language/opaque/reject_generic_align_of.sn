// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_align_of.sn
// محاذاة_النوع لحجة نوع معتمة داخل دالة عامة: لا محاذاة لها.
استورد std.meta.reflect;
نوع قاعدة = معتم;
عرف قس<أ>(م: *أ): ط64 {
    غير_آمن { أرجع محاذاة_النوع(م مثل &أ); };
}
عرف الرئيسية(): عدد { أرجع قس(0 مثل *قاعدة) مثل عدد; }
