// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_dereference.sn
// مثيل يفك حجة نوعه المعتمة (ينسخها).
نوع قاعدة = معتم;
عرف اقرأ<أ>(م: *أ): عدد {
    غير_آمن { دع النسخة: أ = *م; };
    أرجع 0;
}
عرف الرئيسية(): عدد { أرجع اقرأ(0 مثل *قاعدة); }
