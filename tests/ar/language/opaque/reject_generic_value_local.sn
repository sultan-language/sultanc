// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_value_local.sn
// مثيل ينشئ (يعلن) محليا من حجة نوعه المعتمة.
نوع قاعدة = معتم;
عرف احتفظ<أ>(م: *أ): عدد {
    دع القيمة: أ;
    أرجع 0;
}
عرف الرئيسية(): عدد { أرجع احتفظ(0 مثل *قاعدة); }
