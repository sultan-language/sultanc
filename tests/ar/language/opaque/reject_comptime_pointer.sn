// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-COMPTIME-PROHIBITED-EFFECT
// نظير: tests/en/language/opaque/reject_comptime_pointer.sn
// لا ينشئ التقييم وقت الترجمة مؤشرات خاما، معتمة أو غيرها: تشخيص نظيف كما
// لأي مؤشر آخر.
نوع قاعدة = معتم;
عرف لا_قاعدة(): *قاعدة { أرجع 0 مثل *قاعدة; }
عرف الرئيسية(): عدد {
    دع ن: عدد = وقت_الترجمة {
        دع م: *قاعدة = لا_قاعدة();
        1
    };
    أرجع ن;
}
