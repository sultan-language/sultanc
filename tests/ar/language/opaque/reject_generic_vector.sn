// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-OPAQUE-TYPE-ARGUMENT
// نظير: tests/en/language/opaque/reject_generic_vector.sn
// مثيل يحمل متجها من حجة نوعه المعتمة (فيتلفه).
نوع قاعدة = معتم;
عرف اجمع<أ>(م: *أ): عدد {
    دع القيم: متجه أ = [];
    أرجع الطول(القيم);
}
عرف الرئيسية(): عدد { أرجع اجمع(0 مثل *قاعدة); }
