// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/opaque/type_named_opaque.sn
// يجوز أن يسمى نوع معتم. ويُستعمل ويُشار إليه كأي نوع، ويبقى المرادف الاسمي
// (`مرادف`) اسما له؛ أما `نوع X = معتم;` فلا (انظر
// reject_opaque_hides_visible_type.sn).
نوع معتم = { س: عدد };
نوع مؤشر_معتم = *معتم;
مرادف آخر = معتم;

عرف الرئيسية(): عدد {
    دع السجل: معتم = { س: 21 };
    دع النسخة: آخر = { س: 21 };
    دع المؤشر: مؤشر_معتم = (&السجل) مثل مؤشر_معتم;
    غير_آمن { أرجع (*المؤشر).س + النسخة.س; };
}
