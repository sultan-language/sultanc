// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/language/opaque/reject_mixed_comparison.sn
// == بين مؤشرين إلى نوعين معتمين مختلفين.
نوع قاعدة = معتم;
نوع جملة = معتم;
عرف الرئيسية(): عدد {
    دع ق: *قاعدة = 0 مثل *قاعدة;
    دع ج: *جملة = 0 مثل *جملة;
    إذا (ق == ج) { أرجع 1; };
    أرجع 0;
}
