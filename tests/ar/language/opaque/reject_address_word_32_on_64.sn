// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/language/opaque/reject_address_word_32_on_64.sn
// كلمة العنوان ذات 32 بتا لا تُقبل إلا على أهداف مؤشراتها 32 بتا؛ وعلى هدف
// 64 بتا يكون `م مثل ط32` تحويلا غير صالح.
نوع قاعدة = معتم;
عرف الرئيسية(): عدد {
    دع م: *قاعدة = 0 مثل *قاعدة;
    غير_آمن { دع الكلمة: ط32 = م مثل ط32; };
    أرجع 0;
}
