// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-CALL-ARGUMENT-TYPE-MISMATCH
// نظير: tests/en/language/opaque/reject_mixed_argument.sn
// نوعان معتمان نوعان مختلفان: *جملة ليس *قاعدة.
نوع قاعدة = معتم;
نوع جملة = معتم;
عرف أغلق(ق: *قاعدة): عدد { أرجع 0; }
عرف الرئيسية(): عدد {
    دع ج: *جملة = 0 مثل *جملة;
    أرجع أغلق(ج);
}
