// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// أزل_الأخير واقتطع يحرران ما يزيلانه: 10^5 جولة تملأ متجهات من نص ومتجهات
// متداخلة وإغلاقات، ثم تزيل منها وتقتطعها وتفرغها، تترك البايتات الحية في
// المخصص كما كانت، فتبقى الذاكرة ثابتة.
// النظير: tests/en/language/surface/vector_pop_rss_flat.sn. لا توجيه نظير له:
// المفسر لا يستعمل مخصص std الذي تقرأ هذه الشفرة عداداته.
استورد std.os.allocation;
استورد std.text.number;

عرف جامع(ك: عدد): دالة(عدد): عدد { أرجع دالة(س: عدد): عدد -> س + ك; }

عرف جولة(ف: طبيعي): عدد {
    دع الكلمات: متغير متجه نص = [];
    دع الشبكة: متغير متجه متجه عدد = [];
    دع الدوال: متغير متجه دالة(عدد): عدد = [];
    دع ي: متغير طبيعي = 0;
    طالما (ي < 6) {
        ألحق(الكلمات, طبيعي_إلى_نص(ف + ي));
        دع الصف: متغير متجه عدد = [];
        ألحق(الصف, ي مثل عدد);
        ألحق(الصف, ف مثل عدد);
        ألحق(الشبكة, الصف);
        ألحق(الدوال, جامع(ي مثل عدد));
        ي := ي + 1;
    }
    دع المجموع: متغير عدد = 0;
    طابق أزل_الأخير(الكلمات) مع
    | اختياري.موجود(ك) -> { المجموع := المجموع + (الطول(ك) مثل عدد); }
    | اختياري.لا_شيء -> { أرجع -1; };
    طابق أزل_الأخير(الشبكة) مع
    | اختياري.موجود(ص) -> { المجموع := المجموع + ص[0]; }
    | اختياري.لا_شيء -> { أرجع -1; };
    طابق أزل_الأخير(الدوال) مع
    | اختياري.موجود(د) -> { المجموع := المجموع + د(1); }
    | اختياري.لا_شيء -> { أرجع -1; };
    أزل_الأخير(الكلمات);
    اقتطع(الكلمات, 2);
    اقتطع(الشبكة, 1);
    اقتطع(الدوال, 3);
    // تفرغ بأزل_الأخير ثم باقتطع، ثم يعاد استعمالها.
    أزل_الأخير(الشبكة);
    اقتطع(الدوال, 0);
    ألحق(الدوال, جامع(2));
    اقتطع(الكلمات, 0);
    ألحق(الكلمات, طبيعي_إلى_نص(ف));
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع التحمية: عدد = جولة(0);
    إذا (التحمية < 0) { أرجع 1; };
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع ف: متغير طبيعي = 0;
    طالما (ف < 100000) {
        إذا (جولة(ف) < 0) { أرجع 2; };
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
