// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/explicit_type_arguments.sn
// `د<ن>(..)`: حجج نوع صريحة تُربط بمعاملات نوع الدالة بترتيبها قبل
// الاستنتاج، ومنها معامل يظهر في الناتج وحده. `أ < ب` يبقى مقارنة.
عرف فارغ<ق>(): متجه ق { دع م: متجه ق = []; أرجع م; }
عرف هو<ق>(س: ق): ق { أرجع س; }
عرف زوج<أ, ب>(س: أ, ص: ب): عدد { أرجع (س مثل عدد) + (ص مثل عدد); }

عرف الرئيسية(): عدد {
    دع م: متغير متجه ط8 = فارغ<ط8>();
    ألحق(م, هو<ط8>(30));
    دع ك: عدد = زوج<ط8, ط16>(4, 5);
    دع أ: عدد = 1;
    دع ب: عدد = 2;
    إذا (أ < ب) { أرجع (م[0] مثل عدد) + ك + 3; };
    أرجع 0;
}
