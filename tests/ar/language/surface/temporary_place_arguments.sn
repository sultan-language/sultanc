// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/temporary_place_arguments.sn
// `&` عنصر أو حقل قيمة مؤقتة حجةً لنداء (`&د()[ف]`، `&د().أ`): تُخزن القيمة
// المؤقتة في خانة تملكها الكتلة، ويستعير النداء عنصرها أو حقلها
// (compiler/msir/lowering/expressions.sn، خفض_مكان_إلى_مسير).
نوع زوج = { أ: عدد, ب: عدد };

عرف أسماء(): متجه نص { أرجع [«صفر», «واحد», «three»]; }
عرف اصنع(): زوج { أرجع { أ: 30, ب: 4 }; }
عرف طول_نص(ن: &نص): عدد { أرجع الطول(*ن) مثل عدد; }
عرف اجمع(س: &عدد, ص: &عدد): عدد { أرجع *س + *ص; }

عرف الرئيسية(): عدد {
    دع ك: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < 2) {
        ك := ك + طول_نص(&أسماء()[2]);
        ف := ف + 1;
    }
    أرجع ك + اجمع(&اصنع().أ, &اصنع().ب) - 2;
}
