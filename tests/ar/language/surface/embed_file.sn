// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/embed_file.sn
// `ضمن_ملف(«مسار»)` بايتات الملف حرفيَّ نص يُقرأ وقت الترجمة، والمسار النسبي
// من مجلد الملف المصدر. embed_file_data.txt هو «embedded!» وسطر جديد.
عرف الرئيسية(): عدد {
    دع المحتوى: نص = ضمن_ملف(«embed_file_data.txt»);
    إذا (الطول(المحتوى) != 10) { أرجع 1; };
    إذا (المحتوى[0] != (0x65 مثل ط8)) { أرجع 2; };
    أرجع 42;
}
