// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/prelude_shadowing.sn
// التصريح باسم منشئ من التمهيد يحجبه في التعابير: يُستعمل المتغير المحلي `لا_شيء` والدالة
// `موجود` كما كُتبا. وفي النمط تبقى الصيغ المجردة هي المنشئات.
عرف موجود(ن: عدد): عدد { أرجع ن + 1; }

عرف العدد(خ: اختياري عدد): عدد {
    طابق خ مع
    | موجود(ن) -> { أرجع ن; }
    | لا_شيء -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن لا_شيء: عدد = 40;
    إذا (موجود(1) != 2) { أرجع 1; };
    ليكن حاضر: اختياري عدد = اختياري.موجود(2);
    إذا (العدد(حاضر) != 2 || العدد(اختياري.لا_شيء()) != 0) { أرجع 2; };
    أرجع لا_شيء + العدد(حاضر);
}
