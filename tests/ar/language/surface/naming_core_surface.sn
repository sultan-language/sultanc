عرف ضاعف(قيمة: ص32): ص32 {
    أرجع قيمة + قيمة;
}

عرف الرئيسية(): ص32 {
    دع دالة_القيمة: دالة(ص32): ص32 = ضاعف;
    دع قيمة: متغير ص32 = 21;
    دع حالة: منطقي = صواب;
    دع طبيعية: طبيعي = 21;

    إذا (حالة) {
        قيمة := دالة_القيمة(طبيعية مثل ص32);
    } وإلا {
        قيمة := 0;
    }

    أرجع قيمة;
}
