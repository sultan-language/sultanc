عرف ضاعف(قيمة: ص32): ص32 {
    أرجع قيمة + قيمة;
}

عرف القلعة(): ص32 {
    دع دالة_القيمة: دالة(ص32): ص32 = ضاعف;
    دع قيمة: متغير ص32 = 21;
    دع حالة: منطقي = صواب;
    دع غير_موقعة: غير_موقع = 21;

    لو (حالة) {
        قيمة := دالة_القيمة(غير_موقعة مثل ص32);
    } وإلا {
        قيمة := 0;
    }

    أرجع قيمة;
}
