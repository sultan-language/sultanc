عرف ضاعف(قيمة: ص32): ص32 {
    أرجع قيمة + قيمة;
}

عرف الرئيسية(): ص32 {
    ليكن دالة_القيمة: دالة(ص32): ص32 = ضاعف;
    ليكن قيمة: متغير ص32 = 21;
    ليكن حالة: منطقي = صواب;
    ليكن طبيعية: طبيعي = 21;

    إذا (حالة) {
        قيمة := دالة_القيمة(طبيعية مثل ص32);
    } وإلا {
        قيمة := 0;
    }

    أرجع قيمة;
}
