// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/surface/hidden_reference_drops.sn
// السجل المالك الأكبر من 16 بايتًا الممرر مرجعًا خفيًا
// (compiler/msir/msir_copies.sn) يُتلف مع ذلك مرة واحدة بالضبط، حيث كان يُتلف
// من قبل: الحجة المنقولة يتلفها مالكها الجديد، المستدعى (على كل مسار إرجاع،
// وفي ذراع المطابقة على المعامل)؛ ونسخة الحجة المستنسخة يتلفها المستدعى
// والأصل يتلفه المستدعي؛ والمعامل الذي ينقله المستدعى إلى متغير يغيره يتلفه
// ذلك المتغير؛ والسجل المنقول نزولًا في تعاود وصعودًا منه، والسجل المستبدل في
// كل دورة، تتلفهما القيمة التي تملكهما أخيرًا. عدادات المخصص (std.os.allocation)
// تبين أن كل جولة تحرر ما تخصصه: لا يفوت إتلاف، والإتلاف المزدوج يحرر مخزنًا
// مرتين. المفسر المتحقق لا يستعمل مخصص std (تبقى عداداته ثابتة)؛ هناك تجري
// الجولات أيضًا ويوقف التحرير المزدوج التنفيذ.
استورد std.os.allocation;
استورد std.text.number;

نوع مملوك = { الاسم: نص, الوسوم: متجه نص, العدد: عدد };
نوع زوج_مملوك = { الأيسر: مملوك, الأيمن: مملوك };

// سبعة محارف، نص مملوك (في الكومة).
عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }
عرف حجم(ن: نص): عدد { أرجع الطول(ن) مثل عدد; }

عرف اصنع(ف: عدد): مملوك {
    دع الوسوم: متغير متجه نص = [];
    ألحق(الوسوم, نص_من(ف + 1));
    ألحق(الوسوم, نص_من(ف + 2));
    أرجع { الاسم: نص_من(ف), الوسوم: الوسوم, العدد: ف };
}

// يأخذ الملكية ويتلف المعامل عند إرجاعه.
عرف استهلك(س: مملوك): عدد { أرجع (الطول(س.الاسم) مثل عدد) + (الطول(س.الوسوم) مثل عدد); }

// إرجاع مبكر: يُتلف المعامل على المسارين.
عرف مبكر(س: مملوك, قف: منطقي): عدد {
    إذا (قف) { أرجع 1; };
    أرجع استهلك(س);
}

// ينتقل المعامل إلى متغير يغيره المستدعى.
عرف متغير_الملكية(س: مملوك): عدد {
    دع الخاص: متغير مملوك = س;
    الخاص.الاسم := نص_من(الخاص.العدد + 7);
    ألحق(الخاص.الوسوم, نص_من(الخاص.العدد + 8));
    أرجع (الطول(الخاص.الاسم) مثل عدد) + (الطول(الخاص.الوسوم) مثل عدد);
}

// المطابقة على المعامل تنقل جزءًا منه؛ وتُتلف الأجزاء الأخرى.
عرف مطابق(س: مملوك): عدد {
    طابق س مع
    | { الاسم: ن, الوسوم: _, العدد: _ } -> { أرجع حجم(ن); };
}

// منقول نزولًا في تعاود وصعودًا منه.
عرف انزل(س: مملوك, العمق: عدد): مملوك {
    إذا (العمق == 0) { أرجع س; };
    أرجع انزل(س, العمق - 1);
}

// يستبدل معامله: يُتلف القديم هنا.
عرف أعد_التسمية(س: مملوك): مملوك {
    أرجع { الاسم: نص_من(س.العدد + 1), الوسوم: استنسخ(&س.الوسوم), العدد: س.العدد + 1 };
}

عرف النصفان(ز: زوج_مملوك): عدد {
    طابق ز مع
    | { الأيسر: ي, الأيمن: ر } -> { أرجع استهلك(ي) + (الطول(ر.الاسم) مثل عدد); };
}

عرف شغل(ك: عدد, ف: عدد): عدد {
    إذا (ك == 1) { أرجع استهلك(اصنع(ف)); };
    إذا (ك == 2) {
        دع ر: مملوك = اصنع(ف);
        أرجع استهلك(ر);
    };
    إذا (ك == 3) {
        دع ر: مملوك = اصنع(ف);
        دع المنسوخ: عدد = استهلك(استنسخ(&ر));
        أرجع المنسوخ + (الطول(ر.الاسم) مثل عدد);
    };
    إذا (ك == 4) { أرجع متغير_الملكية(اصنع(ف)); };
    إذا (ك == 5) { أرجع مبكر(اصنع(ف), صواب) + مبكر(اصنع(ف), خطأ); };
    إذا (ك == 6) { أرجع مطابق(اصنع(ف)); };
    إذا (ك == 7) {
        دع العائد: مملوك = انزل(اصنع(ف), 6);
        أرجع استهلك(العائد);
    };
    إذا (ك == 8) {
        دع ر: متغير مملوك = اصنع(ف);
        دع ي: متغير عدد = 0;
        طالما (ي < 4) { ر := أعد_التسمية(ر); ي := ي + 1; }
        أرجع ر.العدد - ف + استهلك(ر);
    };
    دع ز: زوج_مملوك = { الأيسر: اصنع(ف), الأيمن: اصنع(ف + 3) };
    أرجع النصفان(ز);
}

عرف المتوقع(ك: عدد): عدد {
    إذا (ك == 3) { أرجع 16; };
    إذا (ك == 4) { أرجع 10; };
    إذا (ك == 5) { أرجع 10; };
    إذا (ك == 6) { أرجع 7; };
    إذا (ك == 8) { أرجع 13; };
    إذا (ك == 9) { أرجع 16; };
    أرجع 9;
}

عرف الرئيسية(): عدد {
    دع ك: متغير عدد = 1;
    طالما (ك <= 9) {
        إذا (شغل(ك, 0) != المتوقع(ك)) { أرجع ك; };
        دع التخصيصات: ط64 = عدد_تخصيصات_النظام();
        دع التحريرات: ط64 = عدد_تحريرات_النظام();
        دع ف: متغير عدد = 0;
        طالما (ف < 200) {
            إذا (شغل(ك, ف) != المتوقع(ك)) { أرجع 20 + ك; };
            ف := ف + 1;
        }
        دع المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
        دع المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
        // مع مخصص std تخصص كل جولة وتحرر بالقدر نفسه.
        إذا (المخصص != 0) {
            إذا (المخصص < 200) { أرجع 40 + ك; };
            إذا (المحرر + 8 < المخصص || المحرر > المخصص + 8) { أرجع 60 + ك; };
        };
        ك := ك + 1;
    }
    أرجع 42;
}
