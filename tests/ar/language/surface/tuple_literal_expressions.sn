// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/tuple_literal_expressions.sn
// حرفي الصف تعبير: قيمة مُعادة يحدد نوعَها الناتجُ المصرح به
// (`أرجع (أ / ب, أ % ب);`)، ووسيط استدعاء يحدد نوعَه معامله، وقيمة مؤقتة
// مملوكة تُنقل عناصرها إلى داخلها.
عرف قسمة_وباق(أ: عدد, ب: عدد): (عدد, عدد) {
    أرجع (أ / ب, أ % ب);
}
عرف ضيق(): (ص8, ط16) { أرجع (3, 4,); }
عرف وسم(ن: عدد): (نص, عدد) { أرجع («abc», ن); }
عرف مجموع(ز: (عدد, عدد)): عدد { أرجع ز[0] + ز[1]; }

عرف الرئيسية(): عدد {
    ليكن ق: (عدد, عدد) = قسمة_وباق(47, 5);
    ليكن ن: (ص8, ط16) = ضيق();
    ليكن و: (نص, عدد) = وسم(10);
    أرجع ق[0] + ق[1] + (ن[0] مثل عدد) + (ن[1] مثل عدد) + (الطول(و[0]) مثل عدد) + و[1] + مجموع((5, 6));
}
