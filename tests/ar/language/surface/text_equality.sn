// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/text_equality.sn
// `==` و`!=` على النصوص يقارنان المحتوى بايتا بايتا كما تفعل
// نصان_متساويان في المكتبة القياسية: مواضع وحرفيات ونواتج نداءات، في شرط
// وقيمةً، وداخل دالة عامة مثيلها نص. لا يُنقل أي طرف، فيبقى النص صالحا
// بعد مقارنته مرتين.
عرف كلمة(): نص { أرجع «Sultan»; }
عرف متماثلان<ن>(أ: ن, ب: ن): منطقي { أرجع أ == ب; }

عرف الرئيسية(): عدد {
    ليكن الاسم: نص = «Sultan»;
    ليكن آخر: نص = «Sultana»;
    ليكن فارغ: نص = «»;
    ليكن النتيجة: متغير عدد = 0;
    إذا (الاسم == «Sultan») { النتيجة := النتيجة + 10; };
    إذا (الاسم != آخر) { النتيجة := النتيجة + 10; };
    إذا (كلمة() == الاسم) { النتيجة := النتيجة + 10; };
    إذا (فارغ == «») { النتيجة := النتيجة + 5; };
    إذا (الاسم == «sultan») { النتيجة := النتيجة + 100; };
    ليكن مختلفان: منطقي = «abc» != «abd»;
    إذا (مختلفان) { النتيجة := النتيجة + 3; };
    إذا (متماثلان(«ab», «ab») && !متماثلان(«ab», «ba») && متماثلان(7, 7)) { النتيجة := النتيجة + 4; };
    أرجع النتيجة + (الطول(الاسم) مثل عدد) - 6;
}
