// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/mutable_float_globals.sn
// العام القابل للتغيير من نوع عائم يحفظ بتات IEEE-754 لقيمته الأولى بايتاتٍ
// أولى ساكنة، كما يفعل العام الصحيح
// (compiler/msir/semantic_lowering.sn، هل_ثابت_تهيئة_عام_مدعوم_للخفض)؛ وبهذا
// يكتب جسر `static double` في ملف سي.
ليكن النسبة: متغير ع64 = 1.5;
ليكن الصغير: متغير ع32 = 0.25;
ليكن الصفر: متغير ع64 = (0.0 مثل ع64);

عرف كبر(بمقدار: ع64): فراغ { النسبة := النسبة * بمقدار; }

عرف الرئيسية(): عدد {
    إذا (الصفر != 0.0) { أرجع 1; };
    كبر(4.0);
    الصغير := الصغير * 8.0;
    إذا (الصغير != 2.0) { أرجع 2; };
    الصفر := النسبة;
    أرجع (الصفر مثل عدد) * 7;
}
