// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/surface/destructuring_drops.sn
// ذراع مطابقة ينقل جزءًا من مميز مملوك يستهلكه، ويُتلف كل جزء لا يأخذه ربط
// مالك: البدل، وحقل السجل الذي يحذفه النمط، والنمط الفرعي الحرفي، والجزء
// المربوط بربط عادي أو معدود فقط، على أي عمق من أنماط السجلات والصفوف
// والاختياري والنتيجة وحمولات التعداد، مع مميز محلي أو مؤقت، وفي مثيل عام،
// وعند الإرجاع المبكر والخروج من الحلقة. الذراع الذي لا ينقل شيئًا والمطابقة
// عبر مرجع يتركان القيمة لمالكها. عدادات المخصص (std.os.allocation) تبين أن
// كل جولة لا تترك تخصيصًا خلفها. المفسر المتحقق لا يستعمل مخصص std (تبقى
// عداداته ثابتة)؛ هناك تجري الجولات أيضًا ويوقف التحرير المزدوج التنفيذ.
استورد std.os.allocation;
استورد std.text.number;

نوع داخلي = { الوسم: نص, العناصر: متجه نص };
نوع سجل_اختبار = {
    الاسم: نص, الرقم: عدد, الوسوم: متجه نص, الداخلي: داخلي, الرد: دالة(عدد): عدد
};
نوع شكل =
    | مسمى بنوع سجل_اختبار
    | زوج بنوع (نص, نص)
    | فارغ
;
نوع حاوية<T> = { العنصر: T, الإضافي: نص };

// سبعة محارف، نص مملوك (في الكومة).
عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }
عرف حجم(ن: نص): عدد { أرجع الطول(ن) مثل عدد; }
عرف جامع(ك: عدد): دالة(عدد): عدد { أرجع دالة(س: عدد): عدد -> س + ك; }

عرف اصنع(ف: عدد): سجل_اختبار {
    دع الوسوم: متغير متجه نص = [];
    ألحق(الوسوم, نص_من(ف + 2));
    ألحق(الوسوم, نص_من(ف + 3));
    دع العناصر: متغير متجه نص = [];
    ألحق(العناصر, نص_من(ف + 4));
    دع الداخلي: داخلي = { الوسم: نص_من(ف + 1), العناصر: العناصر };
    أرجع { الاسم: نص_من(ف), الرقم: ف, الوسوم: الوسوم, الداخلي: الداخلي, الرد: جامع(3) };
}

عرف اصنع_اختياريا(ف: عدد): اختياري سجل_اختبار { أرجع اختياري.موجود(اصنع(ف)); }

عرف بدائل_سجل(ف: عدد): عدد {
    دع س: سجل_اختبار = اصنع(ف);
    طابق س مع
    | { الاسم: ن, الرقم: _, الوسوم: _, الداخلي: _, الرد: _ } -> { أرجع حجم(ن); };
}

عرف حقول_محذوفة(ف: عدد): عدد {
    دع س: سجل_اختبار = اصنع(ف);
    طابق س مع
    | { الوسوم: و } -> { أرجع الطول(و) مثل عدد; };
}

عرف حمولة_متداخلة(ف: عدد): عدد {
    دع ش: شكل = شكل.مسمى(اصنع(ف));
    طابق ش مع
    | شكل.مسمى({ الاسم: ن, الداخلي: { الوسم: _, العناصر: ع } }) -> {
        أرجع حجم(ن) + (الطول(ع) مثل عدد);
    }
    | شكل.زوج(أ, _) -> { أرجع حجم(أ); }
    | شكل.فارغ -> { أرجع 0; };
}

عرف حمولة_زوج(ف: عدد): عدد {
    دع ش: شكل = شكل.زوج(نص_من(ف), نص_من(ف + 1));
    طابق ش مع
    | شكل.مسمى(_) -> { أرجع 0; }
    | شكل.زوج(أ, _) -> { أرجع حجم(أ); }
    | شكل.فارغ -> { أرجع 0; };
}

عرف مميز_مؤقت(ف: عدد): عدد {
    طابق اصنع(ف) مع
    | { الاسم: ن, الوسوم: _ } -> { أرجع حجم(ن); };
}

عرف بلا_روابط(ف: عدد): عدد {
    دع ش: شكل = شكل.مسمى(اصنع(ف));
    طابق ش مع
    | شكل.مسمى(_) -> { }
    | _ -> { };
    طابق اصنع(ف) مع
    | { الرقم: _ } -> { };
    أرجع 1;
}

عرف إرجاع_مبكر(ف: عدد): عدد {
    دع ش: شكل = شكل.مسمى(اصنع(ف));
    طابق ش مع
    | شكل.مسمى({ الاسم: ن, الوسوم: _ }) -> {
        إذا (حجم(ن) == 7) { أرجع 7; };
        أرجع 0;
    }
    | _ -> { أرجع 0; };
}

عرف نتيجة_متداخلة(ف: عدد): عدد {
    دع ق: نتيجة اختياري سجل_اختبار, نص = نتيجة.نجح(اصنع_اختياريا(ف));
    طابق ق مع
    | نتيجة.نجح(اختياري.موجود({ الاسم: ن })) -> { أرجع حجم(ن); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف جذر_صف(ف: عدد): عدد {
    دع ص: (نص, نص, عدد) = (نص_من(ف), نص_من(ف + 1), ف);
    طابق ص مع
    | (أ, _, _) -> { أرجع حجم(أ); };
}

عرف ربط_معدود(ف: عدد): عدد {
    دع س: سجل_اختبار = اصنع(ف);
    طابق س مع
    | { الرد: د, الاسم: ن } -> { أرجع د(1) + حجم(ن) - 7; };
}

عرف إضافي_الحاوية<T>(ح: حاوية<T>): عدد {
    طابق ح مع
    | { العنصر: _, الإضافي: ه } -> { أرجع حجم(ه); };
}

عرف مثيل_عام(ف: عدد): عدد {
    دع ح: حاوية<سجل_اختبار> = { العنصر: اصنع(ف), الإضافي: نص_من(ف) };
    دع ج: حاوية<عدد> = { العنصر: ف, الإضافي: نص_من(ف) };
    أرجع إضافي_الحاوية(ح) + إضافي_الحاوية(ج);
}

عرف خروج_من_ذراع(ف: عدد): عدد {
    دع ك: متغير عدد = 0;
    دع المجموع: متغير عدد = 0;
    طالما (ك < 3) {
        دع س: سجل_اختبار = اصنع(ف + ك);
        طابق س مع
        | { الاسم: ن, الوسوم: _ } -> {
            المجموع := المجموع + حجم(ن);
            إذا (ك == 1) { اخرج_من_حلقة; };
        };
        ك := ك + 1;
    }
    أرجع المجموع;
}

عرف جزء_حرفي(ف: عدد): عدد {
    دع ص: (نص, نص) = (نص_من(ف), نص_من(5));
    طابق ص مع
    | (أ, "1000005") -> { أرجع حجم(أ); }
    | (أ, _) -> { أرجع 0; };
}

عرف عبر_مرجع(ف: عدد): عدد {
    دع س: سجل_اختبار = اصنع(ف);
    دع م: &سجل_اختبار = &س;
    دع المرئي: متغير عدد = 0;
    طابق *م مع
    | { الاسم: ن, الوسوم: _ } -> { المرئي := الطول(ن) مثل عدد; };
    أرجع المرئي + (الطول(س.الاسم) مثل عدد);
}

عرف ذراع_ناقل_غير_مأخوذ(ف: عدد): عدد {
    دع خ: اختياري سجل_اختبار = اصنع_اختياريا(ف + 1);
    طابق خ مع
    | اختياري.موجود({ الرقم: 0, الاسم: ن }) -> { أرجع حجم(ن); }
    | _ -> { أرجع 2; };
}

عرف اختياري_مؤقت(ف: عدد): عدد {
    طابق اصنع_اختياريا(ف) مع
    | اختياري.موجود({ الاسم: ن, الداخلي: _ }) -> { أرجع حجم(ن); }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف شغل(ك: عدد, ف: عدد): عدد {
    إذا (ك == 1) { أرجع بدائل_سجل(ف); };
    إذا (ك == 2) { أرجع حقول_محذوفة(ف); };
    إذا (ك == 3) { أرجع حمولة_متداخلة(ف); };
    إذا (ك == 4) { أرجع حمولة_زوج(ف); };
    إذا (ك == 5) { أرجع مميز_مؤقت(ف); };
    إذا (ك == 6) { أرجع بلا_روابط(ف); };
    إذا (ك == 7) { أرجع إرجاع_مبكر(ف); };
    إذا (ك == 8) { أرجع نتيجة_متداخلة(ف); };
    إذا (ك == 9) { أرجع جذر_صف(ف); };
    إذا (ك == 10) { أرجع ربط_معدود(ف); };
    إذا (ك == 11) { أرجع مثيل_عام(ف); };
    إذا (ك == 12) { أرجع خروج_من_ذراع(ف); };
    إذا (ك == 13) { أرجع جزء_حرفي(ف); };
    إذا (ك == 14) { أرجع عبر_مرجع(ف); };
    إذا (ك == 15) { أرجع ذراع_ناقل_غير_مأخوذ(ف); };
    أرجع اختياري_مؤقت(ف);
}

عرف المتوقع(ك: عدد): عدد {
    إذا (ك == 2) { أرجع 2; };
    إذا (ك == 3) { أرجع 8; };
    إذا (ك == 6) { أرجع 1; };
    إذا (ك == 10) { أرجع 4; };
    إذا (ك == 11 || ك == 12 || ك == 14) { أرجع 14; };
    إذا (ك == 15) { أرجع 2; };
    أرجع 7;
}

عرف الرئيسية(): عدد {
    دع ك: متغير عدد = 1;
    طالما (ك <= 16) {
        إذا (شغل(ك, 0) != المتوقع(ك)) { أرجع ك; };
        دع التخصيصات: ط64 = عدد_تخصيصات_النظام();
        دع التحريرات: ط64 = عدد_تحريرات_النظام();
        دع ف: متغير عدد = 0;
        طالما (ف < 200) {
            إذا (شغل(ك, ف) != المتوقع(ك)) { أرجع 20 + ك; };
            ف := ف + 1;
        }
        دع المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
        دع المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
        // مع مخصص std تخصص كل جولة وتحرر بالقدر نفسه.
        إذا (المخصص != 0) {
            إذا (المخصص < 200) { أرجع 40 + ك; };
            إذا (المحرر + 8 < المخصص) { أرجع 60 + ك; };
        };
        ك := ك + 1;
    }
    أرجع 42;
}
