نوع حمولة = | فارغ | قيمة بنوع عدد;

عرف main(): عدد {
    ليكن نتيجة: عدد = 20;
    ليكن اختيار: عدد = 10;
    ليكن متجه: عدد = 12;
    ليكن محتمل: اختياري عدد = اختياري.موجود(42);
    ليكن ناتج: نتيجة عدد, عدد = نتيجة.نجح(42);
    ليكن قيم: متجه عدد = [40, 2];
    ليكن محول: ص32 = 42 مثل ص32;
    طابق محتمل مع
    | اختياري.موجود(قيمة) -> {
        إذا ((قيمة == 42) && (قيم[0] + قيم[1] == 42)) {
            أرجع نتيجة + اختيار + متجه;
        } وإلا {
            أرجع 1;
        };
    }
    | اختياري.لا_شيء() -> { أرجع 2; };
}
