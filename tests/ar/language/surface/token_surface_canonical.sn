نوع حمولة = | فارغ | قيمة بنوع عدد;

عرف main(): عدد {
    دع نتيجة: عدد = 20;
    دع اختيار: عدد = 10;
    دع متجه: عدد = 12;
    دع محتمل: اختيار عدد = اختيار.بعض(42);
    دع ناتج: نتيجة عدد, عدد = نتيجة.نجح(42);
    دع قيم: متجه عدد = [40, 2];
    دع محول: ص32 = 42 مثل ص32;
    طابق محتمل مع
    | اختيار.بعض(قيمة) -> {
        لو ((قيمة == 42) && (قيم[0] + قيم[1] == 42)) {
            أرجع نتيجة + اختيار + متجه;
        } وإلا {
            أرجع 1;
        };
    }
    | اختيار.لا_شيء() -> { أرجع 2; };
}
