// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/literal_patterns.sn
عرف طابق_عددا(value: عدد): عدد {
    طابق value مع
    | -7 | 42 -> { أرجع 1; }
    | مدى 10 إلى 20 -> { أرجع 3; }
    | _ -> { أرجع 0; };
}

عرف طابق_حرفا(value: حرف): عدد {
    طابق value مع
    | 'A' | 'س' -> { أرجع 3; }
    | مدى '0' إلى '9' -> { أرجع 4; }
    | _ -> { أرجع 0; };
}

عرف طابق_نصا(value: نص): عدد {
    طابق value مع
    | "sultan" | «compiler» -> { أرجع 5; }
    | _ -> { أرجع 0; };
}

عرف طابق_منطقيا(value: منطقي): عدد {
    طابق value مع
    | صواب -> { أرجع 8; }
    | خطأ -> { أرجع 9; }
    | _ -> { أرجع 0; };
}

عرف القلعة(): عدد {
    أرجع طابق_عددا(-7)
        + طابق_عددا(42)
        + طابق_عددا(15)
        + طابق_حرفا('A')
        + طابق_حرفا('س')
        + طابق_حرفا('5')
        + طابق_نصا("sultan")
        + طابق_نصا(«compiler»)
        + طابق_نصا("other")
        + طابق_منطقيا(صواب)
        + طابق_منطقيا(خطأ);
}
