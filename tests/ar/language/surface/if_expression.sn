// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/if_expression.sn
// `إذا … وإلا` قيمةً: بعد `ليكن` و`:=` و`أرجع`، ووسيطا ومعاملا، ومتداخلة، وبسلاسل `وإلا إذا`،
// وبفروع بين معقوفين آخر تعبير فيها هو القيمة، وبفروع ترجع أو تخرج من حلقة بدلا من إعطاء قيمة،
// وبقيم مملوكة تنتقل إلى الناتج، وبجانب تعبير مطابقة، وفي إغلاق. والفرع المجرد بعد `وإلا` يمتد ما أمكن.
عرف الإشارة(ن: عدد): عدد {
    أرجع إذا (ن > 0) 1 وإلا إذا (ن < 0) -1 وإلا 0;
}

عرف الحجم(ن: عدد): نص {
    أرجع إذا (ن == 0) "none" وإلا إذا (ن < 10) "small" وإلا "big";
}

عرف الأول_أو(م: متجه عدد، البديل: عدد): عدد {
    ليكن القيمة: عدد = إذا (الطول(م) > 0) م[0] وإلا { أرجع البديل; };
    أرجع القيمة * 2;
}

عرف أول_زوجي(م: متجه عدد): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن الموجود: متغير عدد = -1;
    طالما (ف < الطول(م)) {
        ليكن س: عدد = م[ف];
        الموجود := إذا (س % 2 == 0) س وإلا { ف := ف + 1; تابع_حلقة; };
        اخرج_من_حلقة;
    }
    أرجع الموجود;
}

عرف مملوك(العلم: منطقي): نص {
    ليكن أ: نص = "left";
    ليكن ب: نص = "right";
    ليكن المختار: نص = إذا (العلم) أ وإلا ب;
    أرجع المختار;
}

عرف الرئيسية(): عدد {
    إذا (الإشارة(5) != 1 || الإشارة(-3) != -1 || الإشارة(0) != 0) { أرجع 1; };
    إذا (الطول(الحجم(0)) != 4 || الطول(الحجم(3)) != 5 || الطول(الحجم(30)) != 3) { أرجع 2; };
    ليكن ن: عدد = 7;
    ليكن الضعف: عدد = إذا (ن > 5) { ليكن ت: عدد = ن * 2; ت + 1 } وإلا { 0 };
    إذا (الضعف != 15) { أرجع 3; };
    // فرع وإلا هو `2 + 10`.
    ليكن الواسع: عدد = إذا (ن > 100) 1 وإلا 2 + 10;
    إذا (الواسع != 12) { أرجع 4; };
    ليكن المجموع: عدد = 3 + (إذا (ن > 0) 4 وإلا 5);
    إذا (المجموع != 7) { أرجع 5; };
    إذا (الأول_أو([]، 9) != 9 || الأول_أو([4]، 9) != 8) { أرجع 6; };
    إذا (أول_زوجي([1، 3، 6، 7]) != 6) { أرجع 7; };
    إذا (الطول(مملوك(صواب)) != 4 || الطول(مملوك(خطأ)) != 5) { أرجع 8; };
    ليكن الصنف: عدد = إذا (ن > 0) (طابق ن % 3 مع | 0 -> 30 | ب -> ب) وإلا 0;
    إذا (الصنف != 1) { أرجع 9; };
    ليكن اختر: دالة(عدد): عدد = دالة(س: عدد): عدد -> إذا (س > 0) س وإلا -س;
    إذا (اختر(-4) != 4 || الإشارة(اختر(-2)) != 1) { أرجع 10; };
    ليكن المتغير: متغير عدد = 0;
    المتغير := إذا (ن == 7) 2 وإلا 3;
    أرجع 40 + المتغير;
}
