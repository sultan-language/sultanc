// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/vector_pop_truncate.sn
// أزل_الأخير / اقتطع (‏Vec::pop و‏Vec::truncate في Rust): أزل_الأخير ينقل العنصر
// الأخير خارج المتجه في اختياري (لا_شيء إن كان فارغا)، واقتطع يسقط العناصر
// بعد الطول المعطى ولا يفعل شيئا إن بلغ الطول أو تجاوزه. العناصر المملوكة
// (نص، متجهات متداخلة، إغلاقات، سجلات) تنقل أو تسقط مرة واحدة؛ والمتجه الذي
// يفرغ يعاد استعماله؛ ويعمل عبر مرجع، وفي حقل سجل، وداخل دالة عامة، ووقت الترجمة.
نوع عنصر = { الاسم: نص, الأجزاء: متجه عدد };

عرف جامع(ك: عدد): دالة(عدد): عدد { أرجع دالة(س: عدد): عدد -> س + ك; }

عرف الأخير_أو<ق>(القيم: &متغير متجه ق, البديل: ق): ق {
    طابق أزل_الأخير(*القيم) مع
    | اختياري.موجود(ق1) -> { أرجع ق1; }
    | اختياري.لا_شيء -> { أرجع البديل; };
}

عرف أبق_الأوائل<ق>(القيم: &متغير متجه ق, العدد: طبيعي): طبيعي {
    اقتطع(*القيم, العدد);
    أرجع الطول(*القيم) مثل طبيعي;
}

عرف نصان_متساويان(أ: &نص, ب: &نص): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف مجموع_المكدس(ن: عدد): عدد {
    دع المكدس: متغير متجه عدد = [];
    دع ف: متغير عدد = 1;
    طالما (ف <= ن) { ألحق(المكدس, ف); ف := ف + 1; }
    دع المجموع: متغير عدد = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق أزل_الأخير(المكدس) مع
        | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
        | اختياري.لا_شيء -> { مستمر := خطأ; };
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    // أعداد.
    دع الأعداد: متغير متجه عدد = [1, 2, 3, 4, 5];
    طابق أزل_الأخير(الأعداد) مع
    | اختياري.موجود(ق) -> { لو (ق != 5) { أرجع 1; }; }
    | اختياري.لا_شيء -> { أرجع 2; };
    اقتطع(الأعداد, 2);
    لو (الطول(الأعداد) != 2 || الأعداد[1] != 2) { أرجع 3; };
    اقتطع(الأعداد, 10);
    لو (الطول(الأعداد) != 2) { أرجع 4; };
    اقتطع(الأعداد, 0);
    لو (الطول(الأعداد) != 0) { أرجع 5; };
    طابق أزل_الأخير(الأعداد) مع
    | اختياري.موجود(_) -> { أرجع 6; }
    | اختياري.لا_شيء -> { };
    ألحق(الأعداد, 7);
    لو (الطول(الأعداد) != 1 || الأعداد[0] != 7) { أرجع 7; };

    // نص: النص المزال يملكه المستدعي.
    دع الكلمات: متغير متجه نص = [];
    ألحق(الكلمات, "ألف");
    ألحق(الكلمات, "باء");
    ألحق(الكلمات, "جيم");
    دع باء: نص = "باء";
    دع المزال: نص = الأخير_أو(&متغير الكلمات, "لا");
    دع جيم: نص = "جيم";
    لو (!نصان_متساويان(&المزال, &جيم)) { أرجع 8; };
    دع الثاني: نص = الأخير_أو(&متغير الكلمات, "لا");
    لو (!نصان_متساويان(&الثاني, &باء)) { أرجع 9; };
    دع الأول: نص = الأخير_أو(&متغير الكلمات, "لا");
    دع البديل: نص = الأخير_أو(&متغير الكلمات, "لا");
    دع لا_نص: نص = "لا";
    لو (الطول(الأول) != 6 || !نصان_متساويان(&البديل, &لا_نص)) { أرجع 10; };

    // متجهات متداخلة وسجلات.
    دع الشبكة: متغير متجه متجه عدد = [];
    دع ص: متغير عدد = 0;
    طالما (ص < 4) {
        دع الصف: متغير متجه عدد = [];
        ألحق(الصف, ص); ألحق(الصف, ص * 10);
        ألحق(الشبكة, الصف);
        ص := ص + 1;
    }
    طابق أزل_الأخير(الشبكة) مع
    | اختياري.موجود(الصف) -> { لو (الطول(الصف) != 2 || الصف[1] != 30) { أرجع 11; }; }
    | اختياري.لا_شيء -> { أرجع 12; };
    لو (أبق_الأوائل(&متغير الشبكة, 1) != 1 || الشبكة[0][0] != 0) { أرجع 13; };
    دع العناصر: متغير متجه عنصر = [];
    دع ك: متغير عدد = 0;
    طالما (ك < 3) {
        دع الأجزاء: متجه عدد = [ك, ك + 1];
        دع العنصر: عنصر = { الاسم: "عنصر", الأجزاء: الأجزاء };
        ألحق(العناصر, العنصر);
        ك := ك + 1;
    }
    طابق أزل_الأخير(العناصر) مع
    | اختياري.موجود(ع) -> { لو (ع.الأجزاء[1] != 3) { أرجع 14; }; }
    | اختياري.لا_شيء -> { أرجع 15; };
    اقتطع(العناصر, 1);
    لو (الطول(العناصر) != 1 || العناصر[0].الأجزاء[0] != 0) { أرجع 16; };

    // إغلاقات: الإغلاق المزال يحتفظ ببيئته؛ والمقتطعة تسقط.
    دع الدوال: متغير متجه دالة(عدد): عدد = [];
    ألحق(الدوال, جامع(1));
    ألحق(الدوال, جامع(10));
    ألحق(الدوال, جامع(100));
    طابق أزل_الأخير(الدوال) مع
    | اختياري.موجود(د) -> { لو (د(1) != 101) { أرجع 17; }; }
    | اختياري.لا_شيء -> { أرجع 18; };
    اقتطع(الدوال, 1);
    دع ج: دالة(عدد): عدد = الدوال[0];
    لو (ج(1) != 2) { أرجع 19; };

    // عبر حقل سجل، ومكدس يفرغه أزل_الأخير.
    دع المحتجز: متجه عدد = [9, 8, 7];
    دع الحامل: متغير عنصر = { الاسم: "ح", الأجزاء: المحتجز };
    اقتطع(الحامل.الأجزاء, 1);
    لو (الطول(الحامل.الأجزاء) != 1 || الحامل.الأجزاء[0] != 9) { أرجع 20; };
    لو (مجموع_المكدس(100) != 5050) { أرجع 21; };

    // وقت الترجمة.
    دع المطوي: عدد = وقت_الترجمة مجموع_المكدس(10);
    لو (المطوي != 55) { أرجع 22; };
    أرجع 42;
}
