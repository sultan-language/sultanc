// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/slicing.sn
// الشرائح `م[أ..ب]`، والطرفان داخلان، عروض بلا نسخ: جزء أوسط، والمتجه كله
// (`م[0..الطول(م) - 1]` و`م[..]`)، والطرفان المفتوحان (`م[2..]`، `م[..1]`)، والشريحة
// الفارغة (`م[أ..أ - 1]`)، وشريحة من شريحة، وعروض للقراءة متجاورة، وشريحة تُمرَّر إلى
// معامل `[] T`، وعودية على الشرائح، وعروض قابلة للكتابة تصنعها `&متغير` فتكتب في
// المتجه: `&متغير ع[1..3]` و`&متغير ع[2..]` و`&متغير ع` لمعامل `متغير [] عدد`. والمتغير
// المسمى `مدى` يبقى اسما.
عرف مجموع(ش: [] عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) { المجموع := المجموع + ش[ف]; ف := ف + 1; }
    أرجع المجموع;
}

// العودية على الشرائح: العنصر الأول ومجموع ما بعده.
عرف مجموع_عودي(ش: [] عدد): عدد {
    إذا (الطول(ش) == 0) { أرجع 0; };
    أرجع ش[0] + مجموع_عودي(ش[1..]);
}

عرف املأ(ش: متغير [] عدد، القيمة: عدد): عدد {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) { ش[ف] := القيمة; ف := ف + 1; }
    أرجع الطول(ش) مثل عدد;
}

عرف أرقام(ن: عدد): عدد {
    ليكن مدى: عدد = 7;
    طابق ن مع
    | مدى 0..9 -> { أرجع 1; }
    | مدى 10..99 -> { أرجع 2; }
    | مدى 100.. -> { أرجع 3; }
    | مدى ..-1 -> { أرجع مدى; };
}

عرف الرئيسية(): عدد {
    ليكن م: متجه عدد = [10، 20، 30، 40، 50];
    ليكن الأوسط: [] عدد = م[1..3];
    إذا (الطول(الأوسط) != 3 || الأوسط[0] != 20 || مجموع(الأوسط) != 90) { أرجع 1; };
    ليكن الكل: [] عدد = م[0..الطول(م) - 1];
    ليكن الكل_أيضا: [] عدد = م[..];
    إذا (مجموع(الكل) != 150 || مجموع(الكل_أيضا) != 150) { أرجع 2; };
    ليكن الذيل: [] عدد = م[2..];
    ليكن الرأس: [] عدد = م[..1];
    إذا (مجموع(الذيل) != 120 || مجموع(الرأس) != 30) { أرجع 3; };
    ليكن فارغة: [] عدد = م[2..1];
    ليكن لا_شيء_يمينا: [] عدد = م[5..];
    ليكن لا_شيء_يسارا: [] عدد = م[..-1];
    إذا (الطول(فارغة) != 0 || الطول(لا_شيء_يمينا) != 0 || الطول(لا_شيء_يسارا) != 0) { أرجع 4; };
    ليكن الداخل: [] عدد = الأوسط[1..2];
    إذا (مجموع(الداخل) != 70 || الداخل[0] != 30) { أرجع 5; };
    // عروض للقراءة متجاورة.
    ليكن اليسار: [] عدد = م[0..1];
    ليكن اليمين: [] عدد = م[1..2];
    إذا (اليسار[1] != اليمين[0]) { أرجع 6; };
    إذا (مجموع(م[3..4]) != 90 || مجموع_عودي(م[..]) != 150) { أرجع 7; };
    // عروض قابلة للكتابة: كل منها يكتب في ع.
    ليكن ع: متغير متجه عدد = [1، 2، 3، 4، 5];
    ليكن الجزء: متغير [] عدد = &متغير ع[1..3];
    الجزء[0] := 9;
    إذا (ع[1] != 9) { أرجع 8; };
    إذا (املأ(&متغير ع[3..]، 0) != 2 || ع[3] != 0 || ع[4] != 0 || ع[2] != 3) { أرجع 9; };
    إذا (املأ(&متغير ع، 7) != 5 || مجموع(ع[..]) != 35) { أرجع 10; };
    إذا (أرقام(5) != 1 || أرقام(42) != 2 || أرقام(500) != 3 || أرقام(-3) != 7) { أرجع 11; };
    أرجع 42;
}
