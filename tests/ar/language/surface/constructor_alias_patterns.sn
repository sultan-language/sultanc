// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/surface/constructor_alias_patterns.sn
// المنشئ الذي يُبلغ عبر مرادف يطابق في النمط كما يبني في التعبير، ولو داخل منشئ آخر.
استورد std.process.child;
استورد std.json.value;

نوع إشارة_صوت = | هادئ | عال بنوع عدد;
مرادف إشارة_صوت.ساكن = إشارة_صوت.هادئ;
مرادف إشارة_صوت.صاخب = إشارة_صوت.عال;

عرف درجة_الحالة(الناتج: نتيجة exit_status, عدد): عدد {
    طابق الناتج مع
    | نتيجة.نجح(exit_status.exited(3)) -> { أرجع 10; }
    | نتيجة.نجح(exit_status.exited(الرمز)) -> { أرجع الرمز; }
    | نتيجة.نجح(exit_status.signaled(الرقم)) -> { أرجع 100 + الرقم; }
    | نتيجة.خطأ(الرمز) -> { أرجع الرمز; }
}

عرف درجة_الصنف(الصنف: json_error_kind): عدد {
    طابق الصنف مع
    | json_error_kind.unexpected_eof -> { أرجع 20; }
    | json_error_kind.trailing_text() -> { أرجع 1; }
    | _ -> { أرجع 2; }
}

عرف درجة_الإشارة(القيمة: إشارة_صوت): عدد {
    طابق القيمة مع
    | إشارة_صوت.ساكن -> { أرجع 1; }
    | إشارة_صوت.صاخب(المستوى) -> { أرجع المستوى; }
}

عرف الرئيسية(): عدد {
    دع الناتج: نتيجة exit_status, عدد = نتيجة.نجح(exit_status.exited(3));
    دع الصنف: json_error_kind = json_error_kind.unexpected_eof();
    دع القيمة: إشارة_صوت = إشارة_صوت.صاخب(12);
    أرجع درجة_الحالة(الناتج) + درجة_الصنف(الصنف) + درجة_الإشارة(القيمة);
}
