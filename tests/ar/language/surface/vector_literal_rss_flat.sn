// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تعابير حرفي المتجه تملك تخزينها مرة واحدة: 10^5 جولة من حرفيات تمرر بالقيمة
// وتُرجع وتتداخل وتُفهرس ويُقاس طولها تترك البايتات الحية في المخصص كما كانت.
// النظير: tests/en/language/surface/vector_literal_rss_flat.sn. لا توجيه نظير
// له: المفسر لا يستعمل مخصص std الذي تقرأ هذه الشفرة عداداته.
استورد std.os.allocation;
استورد std.text.number;

عرف العدد(م: متجه نص): عدد { أرجع الطول(م) مثل عدد; }
عرف اصنع(ف: عدد): متجه نص { أرجع [عدد_إلى_نص(ف), عدد_إلى_نص(ف + 1)]; }

عرف جولة(ف: عدد): عدد {
    دع الكلي: متغير عدد = العدد([عدد_إلى_نص(ف), «x»]) + العدد(اصنع(ف));
    دع الشبكة: متجه متجه نص = [[عدد_إلى_نص(ف)], اصنع(ف), []];
    الكلي := الكلي + (الطول(الشبكة) مثل عدد) + (الطول([عدد_إلى_نص(ف), عدد_إلى_نص(2)][0]) مثل عدد);
    الكلي := الكلي + (الطول([اصنع(ف), اصنع(ف + 1)]) مثل عدد);
    أرجع الكلي;
}

عرف الرئيسية(): عدد {
    دع التمهيد: عدد = جولة(0);
    إذا (التمهيد < 0) { أرجع 1; };
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع ف: متغير عدد = 0;
    طالما (ف < 100000) {
        إذا (جولة(ف) < 0) { أرجع 2; };
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
