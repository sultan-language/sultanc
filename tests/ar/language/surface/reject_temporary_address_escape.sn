// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-TYPE-ADDRESS-OF-NON-LVALUE
// نظير: tests/en/language/surface/reject_temporary_address_escape.sn
// ناتج النداء مرجع قد يحمل استعارة الخانة المؤقتة خارج الكتلة: يُرفض `&«..»`.
عرف هو(ن: &نص): &نص { أرجع ن; }

عرف الرئيسية(): عدد {
    دع ر: &نص = هو(&«x»);
    أرجع 0;
}
