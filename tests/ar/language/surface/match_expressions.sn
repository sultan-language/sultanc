// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/match_expressions.sn
// `طابق` تعبيرا (docs/ar/book/ch06-02-match.md): قيمته قيمة الذراع الذي يطابق،
// في `ليكن` وإسناد وحجة وقيمة مرجعة وطرف عامل وشرط وجسم إغلاق؛ متداخلا؛ بقيم
// من كل صنف يعطيها سياقها نوعها؛ وأذرع بين معقوفين فيها عبارات ثم قيمة؛ وأذرع
// ترجع أو تخرج من حلقة أو تتابعها؛ وترتيب التقييم كما في المصدر حولها.
نوع شكل = | دائرة بنوع عدد | مربع بنوع عدد | نقطة;
نوع موضع = { س: عدد, ص: عدد };

عرف مساحة(الشكل: شكل): عدد {
    أرجع طابق الشكل مع
    | شكل.دائرة(ن) -> 3 * ن * ن
    | شكل.مربع(ض) -> ض * ض
    | شكل.نقطة -> 0;
}

عرف ضعف(س: عدد): عدد { أرجع س * 2; }

عرف اسم_العدد(ع: عدد): نص {
    ليكن النص: نص = طابق ع مع
    | 1 -> «واحد»
    | 2 -> «اثنان»
    | _ -> «كثير»;
    أرجع النص;
}

عرف شبكة(أ: عدد, ب: عدد): عدد {
    أرجع طابق أ مع
    | 0 -> (طابق ب مع | 0 -> 1 | _ -> 2)
    | _ -> طابق ب مع
        | 0 -> 3
        | _ -> 4;
}

عرف الأول_أو(القيمة: اختياري عدد): عدد {
    ليكن الموجود: عدد = طابق القيمة مع
    | اختياري.موجود(ع) -> ع
    | اختياري.لا_شيء -> { أرجع -1; };
    أرجع الموجود * 2;
}

عرف سجل_رقما(المجمع: &متغير عدد, ك: عدد): عدد {
    *المجمع := *المجمع * 10 + ك;
    أرجع ك;
}

عرف اجمع_ثلاثة(أ: عدد, ب: عدد, ج: عدد): عدد { أرجع أ + ب + ج; }

عرف زد_واحدا(العدد: &متغير عدد): عدد {
    *العدد := *العدد + 1;
    أرجع 1;
}

عرف الرئيسية(): عدد {
    // قيمة في `ليكن`، وقيمة مرجعة، وحجة.
    إذا (مساحة(شكل.دائرة(2)) + مساحة(شكل.مربع(3)) + مساحة(شكل.نقطة()) != 21) { أرجع 1; };
    ليكن ن: عدد = 2;
    إذا (ضعف(طابق ن مع | 1 -> 10 | _ -> 20) != 40) { أرجع 2; };
    // أطراف عوامل.
    ليكن المجموع_الأول: عدد = 1 + طابق ن مع | 2 -> 10 | _ -> 20;
    إذا (المجموع_الأول != 11) { أرجع 3; };
    ليكن الجداء: عدد = (طابق ن مع | 2 -> 5 | _ -> 6) * 3;
    إذا (الجداء != 15) { أرجع 4; };
    // إسناد.
    ليكن المتغير: متغير عدد = 0;
    المتغير := طابق ن مع | 0 -> 7 | ك -> ك * 100;
    إذا (المتغير != 200) { أرجع 5; };
    // نص.
    إذا (اسم_العدد(1) != «واحد» || اسم_العدد(2) != «اثنان» || اسم_العدد(9) != «كثير») { أرجع 6; };
    // مطابقات متداخلة.
    إذا (شبكة(0, 0) + شبكة(0, 1) + شبكة(1, 0) + شبكة(1, 1) != 10) { أرجع 7; };
    // تعداد واختياري وصف وسجل ومتجه، يعطي كلا منها سياقه نوعه.
    ليكن الشكل: شكل = طابق ن مع | 0 -> شكل.نقطة() | _ -> شكل.مربع(ن);
    إذا (مساحة(الشكل) != 4) { أرجع 8; };
    ليكن الربما: اختياري عدد = طابق ن مع | 0 -> اختياري.لا_شيء() | ك -> اختياري.موجود(ك * 3);
    ليكن المأخوذ: عدد = طابق الربما مع | اختياري.موجود(ق) -> ق | اختياري.لا_شيء -> 0;
    إذا (المأخوذ != 6) { أرجع 9; };
    ليكن الزوج: (عدد, نص) = طابق ن مع | 0 -> (0, «صفر») | _ -> (ن, «آخر»);
    ليكن الأول: عدد = طابق الزوج مع | (أ, _) -> أ;
    إذا (الأول != 2) { أرجع 10; };
    ليكن الموضع: موضع = طابق ن مع | 0 -> { س: 1, ص: 1 } | _ -> { س: ن, ص: ن + 1 };
    إذا (الموضع.س + الموضع.ص != 5) { أرجع 11; };
    ليكن العناصر: متجه عدد = طابق ن مع | 0 -> [] | _ -> [ن, ن, ن];
    إذا (الطول(العناصر) != 3) { أرجع 12; };
    // ذراع بين معقوفين: عبارات ثم القيمة.
    ليكن المعقوف: عدد = طابق ن مع
    | 2 -> {
        ليكن ت: عدد = 20;
        ليكن التالي: عدد = ت + 1;
        التالي * 2
    }
    | _ -> 0;
    إذا (المعقوف != 42) { أرجع 13; };
    // ذراع ترجع.
    إذا (الأول_أو(اختياري.موجود(4)) != 8 || الأول_أو(اختياري.لا_شيء()) != -1) { أرجع 14; };
    // أذرع تخرج من حلقة وتتابعها.
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 10) {
        ف := ف + 1;
        ليكن الخطوة: عدد = طابق ف % 3 مع
        | 0 -> { تابع_حلقة; }
        | 1 -> ف
        | _ -> {
            إذا (ف > 7) { اخرج_من_حلقة; };
            ف * 10
        };
        المجموع := المجموع + الخطوة;
    }
    إذا (المجموع != 82) { أرجع 15; };
    // شرط، وشرط حلقة يقيم في كل دورة.
    إذا (طابق ن مع | 2 -> خطأ | _ -> صواب) { أرجع 16; };
    ليكن المحاولات: متغير عدد = 0;
    طالما (طابق المحاولات مع | 5 -> خطأ | _ -> صواب) { المحاولات := المحاولات + 1; }
    إذا (المحاولات != 5) { أرجع 17; };
    // مطابقة داخل مميز عبارة مطابقة.
    طابق (طابق ن مع | 2 -> 1 | _ -> 0) مع
    | 1 -> { }
    | _ -> { أرجع 18; };
    // في جسم إغلاق؛ و`أرجع` في ذراع يخرج من الإغلاق.
    ليكن المصنف: دالة(عدد): عدد = دالة(س: عدد): عدد -> طابق س مع | 0 -> 1 | _ -> س * 2;
    إذا (المصنف(0) + المصنف(5) != 11) { أرجع 19; };
    ليكن مبكر: دالة(عدد): عدد = دالة(س: عدد): عدد -> طابق س مع | 0 -> { أرجع 7; } | _ -> س + 1;
    إذا (مبكر(0) + مبكر(4) != 12) { أرجع 20; };
    // من اليسار إلى اليمين: ما قبل المطابقة يعمل أولا، وما بعدها بعدها.
    ليكن الترتيب: متغير عدد = 0;
    ليكن الناتج: عدد = اجمع_ثلاثة(
        سجل_رقما(&متغير الترتيب, 1),
        طابق سجل_رقما(&متغير الترتيب, 2) مع | 2 -> سجل_رقما(&متغير الترتيب, 3) | _ -> 0,
        سجل_رقما(&متغير الترتيب, 4)
    );
    إذا (الترتيب != 1234 || الناتج != 8) { أرجع 21; };
    // الطرف المختصر لا يقيم.
    ليكن النداءات: متغير عدد = 0;
    إذا (خطأ && (طابق زد_واحدا(&متغير النداءات) مع | _ -> صواب)) { أرجع 22; };
    إذا (النداءات != 0) { أرجع 23; };
    أرجع 42;
}
