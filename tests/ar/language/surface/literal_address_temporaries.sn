// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/literal_address_temporaries.sn
// `&` على حرفي (عدد صحيح أو قيمة منطقية أو حرف أو نص) قيمة مؤقتة تدوم حتى
// نهاية العبارة المحيطة، في كل موضع تعبير: وسيط استدعاء أيا كان ما يعيده
// الاستدعاء، ووسيط منشئ داخل حرفي متجه، وحقل سجل. وتُستعمل القيمة الحاملة
// للاستعارة داخل العبارة.
نوع وسيط = | كتابة بنوع &نص | رقم بنوع &ص32 | علم بنوع &منطقي;
نوع زوج = { اليسار: &عدد, اليمين: &عدد };

عرف وزن(الوسائط: متجه وسيط): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الوسائط) مثل طبيعي)) {
        طابق الوسائط[ف] مع
        | وسيط.كتابة(ن) -> { المجموع := المجموع + (الطول(*ن) مثل عدد); }
        | وسيط.رقم(ر) -> { المجموع := المجموع + ((*ر) مثل عدد); }
        | وسيط.علم(ع) -> { إذا (*ع) { المجموع := المجموع + 1; }; };
        ف := ف + 1;
    }
    أرجع المجموع;
}
عرف الأكبر(أ: &عدد, ب: &عدد): &عدد { إذا (*أ > *ب) { أرجع أ; }; أرجع ب; }
عرف مجموع(ز: زوج): عدد { أرجع *(ز.اليسار) + *(ز.اليمين); }
عرف رمز(ح: &حرف): عدد { أرجع ((*ح) مثل ط32) مثل عدد; }

عرف الرئيسية(): عدد {
    ليكن الوزن: عدد = وزن([وسيط.كتابة(&«total»), وسيط.رقم(&20), وسيط.علم(&صواب)]);
    ليكن م: عدد = *الأكبر(&15, &20);
    أرجع الوزن + م + مجموع({ اليسار: &-3, اليمين: &2 }) - رمز(&'A') + 62;
}
