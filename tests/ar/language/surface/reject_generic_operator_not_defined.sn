// اختبار: رفض
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/en/language/surface/reject_generic_operator_not_defined.sn
// يجوز لجسم الدالة العامة أن يطبق `>` على معامل نوعها؛ فإذا كان مثيلها
// سجلا لا ترتيب له كان المثيل خطأ نوع عند العملية (`>` غير معرف للنوع
// `نقطة`)، لا خطأ داخليا.
نوع نقطة = { الأول: عدد, الثاني: عدد };

عرف أكبر<ن>(أ: ن, ب: ن): منطقي { أرجع أ > ب; }

عرف الرئيسية(): عدد {
    ليكن أ: نقطة = { الأول: 1, الثاني: 2 };
    ليكن ب: نقطة = { الأول: 3, الثاني: 4 };
    إذا (أكبر(3, 2) && أكبر(أ, ب)) { أرجع 1; };
    أرجع 0;
}
