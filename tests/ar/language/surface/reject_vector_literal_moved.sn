// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-OWNERSHIP-USE-AFTER-MOVE
// نظير: tests/en/language/surface/reject_vector_literal_moved.sn
// ينقل حرفي المتجه عناصره المملوكة إليه كما يفعل `دع م: ن = [..];`: يذهب
// النص بعد النداء.
عرف العدد(م: متجه نص): عدد { أرجع الطول(م) مثل عدد; }
عرف الرئيسية(): عدد {
    دع ن: نص = «a»;
    دع ع: عدد = العدد([ن]);
    أرجع ع + (الطول(ن) مثل عدد);
}
