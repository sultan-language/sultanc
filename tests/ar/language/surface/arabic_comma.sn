// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/arabic_comma.sn
// الفاصلة العربية `،` هي الفاصلة نفسها في كل قائمة: المعاملات والوسائط، والمتجهات،
// والصفوف، والسجلات، والأنواع العامة، وحمولات المنشئات، والأنماط، والاستيراد.
// وتجتمع الفاصلتان في قائمة واحدة.
استورد المكتبة.نصوص.أعداد;

نوع نقطة = { س: عدد، ص: عدد };
نوع شكل = | دائرة بنوع عدد | خط بنوع (عدد، عدد) | لا_شيء_هنا;

عرف اجمع(أ: عدد، ب: عدد، ج: عدد): عدد { أرجع أ + ب + ج; }

عرف الأول<ن>(أ: ن، ب: ن): ن { أرجع أ; }

عرف قس(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(ن) -> { أرجع ن; }
    | شكل.خط(أ، ب) -> { أرجع أ + ب; }
    | شكل.لا_شيء_هنا -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن المتجه: متجه عدد = [1، 2، 3, 4];
    ليكن الزوج: (عدد، عدد) = (5، 6);
    ليكن ن: نقطة = { س: 7، ص: 8 };
    إذا (اجمع(1، 2، 3) != 6) { أرجع 1; };
    إذا (الطول(المتجه) != 4 || المتجه[3] != 4) { أرجع 2; };
    طابق الزوج مع
    | (أ، ب) -> { إذا (أ + ب != 11) { أرجع 3; }; };
    طابق ن مع
    | { س، ص: 8 } -> { إذا (س != 7) { أرجع 4; }; }
    | _ -> { أرجع 5; };
    إذا (الأول<عدد>(9، 10) != 9) { أرجع 6; };
    إذا (قس(شكل.خط(20، 22)) != 42) { أرجع 7; };
    إذا (الطول(عدد_إلى_نص(42)) != 2) { أرجع 8; };
    أرجع اجمع(40، 1، 1);
}
