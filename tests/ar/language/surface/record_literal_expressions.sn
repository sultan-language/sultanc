// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/record_literal_expressions.sn
// حرفي السجل تعبير: حجة، وقيمة مُرجعة، وقيمة مسندة بـ `:=`. يأخذ نوعه من
// سياقه، وتُنقل قيم حقوله إليه كما في `دع س: ن = {..};`.
نوع نقطة = { س: عدد, ص: عدد, الاسم: نص };

عرف مجموع(ن: نقطة): عدد { أرجع ن.س + ن.ص + (الطول(ن.الاسم) مثل عدد); }

عرف أنشئ(أ: عدد): نقطة { أرجع { س: أ, ص: أ * 2, الاسم: «ab» }; }

عرف الرئيسية(): عدد {
    دع أ: عدد = مجموع({ س: 3, ص: 4, الاسم: «xyz» });
    دع ب: متغير نقطة = أنشئ(5);
    ب := { الاسم: «» , س: ب.س + 1, ص: ب.ص };
    أرجع أ + ب.س + ب.ص + 16;
}
