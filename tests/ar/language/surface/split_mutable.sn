// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/split_mutable.sn
// `اقسم_قابلا_للتعديل(&متغير م، ف)` تعطي عرضين قابلين للكتابة من م: العناصر قبل ف، وما من
// ف فصاعدا؛ وتسميهما `ليكن` المفككة، والكتابة عبر أي نصف تغير م، ثم يُستعمل م من جديد متى
// لم يعد النصفان مستعملين. والقسمة عند 0 أو عند الطول تترك نصفا فارغا؛ والمتجه الذي يُبلغ
// عبر `&متغير` يُقسم كذلك، وتفكك المطابقة الزوج أيضا.
عرف املأ(الجزء: متغير [] عدد، القيمة: عدد): عدد {
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(الجزء)) { الجزء[ف] := القيمة; ف := ف + 1; }
    أرجع الطول(الجزء);
}

عرف مجموع(ش: [] عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(ش)) { المجموع := المجموع + ش[ف]; ف := ف + 1; }
    أرجع المجموع;
}

عرف بادل_أولي_النصفين(م: &متغير متجه عدد، عند: عدد): عدد {
    طابق اقسم_قابلا_للتعديل(&متغير *م، عند) مع
    | (اليسار، اليمين) -> {
        ليكن الأول: عدد = اليسار[0];
        اليسار[0] := اليمين[0];
        اليمين[0] := الأول;
        أرجع الطول(اليسار) * 10 + الطول(اليمين);
    };
}

عرف الرئيسية(): عدد {
    ليكن م: متغير متجه عدد = [1، 2، 3، 4، 5];
    ليكن (اليسار، اليمين): (متغير [] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير م، 2);
    اليسار[0] := 10;
    اليمين[2] := 50;
    إذا (الطول(اليسار) != 2 || الطول(اليمين) != 3) { أرجع 1; };
    إذا (املأ(اليسار، 7) != 2) { أرجع 2; };
    إذا (م[0] != 7 || م[1] != 7 || م[2] != 3 || م[4] != 50) { أرجع 3; };
    ليكن (لا_شيء_قبل، الكل): (متغير [] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير م، 0);
    إذا (الطول(لا_شيء_قبل) != 0 || الطول(الكل) != 5) { أرجع 4; };
    ليكن ن: عدد = الطول(م);
    ليكن (الجميع، لا_شيء_بعد): ([] عدد، [] عدد) = اقسم_قابلا_للتعديل(&متغير م، ن);
    إذا (الطول(الجميع) != 5 || الطول(لا_شيء_بعد) != 0) { أرجع 5; };
    إذا (بادل_أولي_النصفين(&متغير م، 3) != 32 || م[0] != 4 || م[3] != 7) { أرجع 6; };
    إذا (مجموع(م[..]) != 4 + 7 + 3 + 7 + 50) { أرجع 7; };
    أرجع 42;
}
