// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/prelude_some_inferred.sn
// `موجود(س)` المجردة حيث لا يُنتظر نوع، كمميَّز المطابقة، اختياريُّ نوع وسيطها: فـ`موجود(30)`
// من النوع `اختياري عدد`، و`موجود(الكلمة)` من النوع `اختياري نص` وتأخذ النص، و`موجود(&متغير ن)`
// اختياري لاستعارة تكتب في `ن`.
عرف الرئيسية(): عدد {
    ليكن المجموع: متغير عدد = 0;
    طابق موجود(30) مع
    | موجود(ن) -> { المجموع := المجموع + ن; }
    | لا_شيء -> { أرجع 1; };
    ليكن الكلمة: نص = "ab";
    طابق موجود(الكلمة) مع
    | موجود(ك) -> { المجموع := المجموع + (الطول(ك) مثل عدد); }
    | لا_شيء -> { أرجع 2; };
    ليكن العداد: متغير عدد = 0;
    طابق موجود(&متغير العداد) مع
    | موجود(الكاتب) -> { *الكاتب := 8; }
    | لا_شيء -> { أرجع 3; };
    ليكن الضعف: عدد = طابق موجود(1) مع | موجود(ع) -> ع * 2 | لا_شيء -> 0;
    أرجع المجموع + العداد + الضعف;
}
