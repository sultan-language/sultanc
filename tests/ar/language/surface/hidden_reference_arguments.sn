// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/surface/hidden_reference_arguments.sn
// السجل الأكبر من عتبة المرجع الخفي (8 بايتات على x86-64، و16 على AArch64)
// يمر بين دوال السلطان مرجعًا خفيًا (عنوان تخزين
// يبقيه المستدعي ثابتًا طوال النداء؛ compiler/msir/msir_copies.sn،
// مخازن_ثابتة_للنداء_مسير)، ومع ذلك تبقى للحجة دلالة القيمة: المستدعى الذي
// يغير معامله يغير نسخته هو؛ والسجل الممرر مرتين قيمتان متساويتان؛ والسجل
// الذي يتغير أثناء النداء عبر مرجع أو متجه عام أو صندوق هو القيمة التي كانها
// عند النداء؛ ومعامل الكتلة (قيمة من دورة سابقة) الممرر إلى النداء الذي
// يستبدله، و`س := د(س)` والناتج يُبنى أثناء قراءة الحجة، يقرآن الحجة قبل أن
// يكتب الناتج فوقها؛ والتعاود والإغلاقات (سجل ملتقط، ومعامل سجل لقيمة دالة)
// والقيم الموسومة ذات الحمولات الكبيرة تحفظ قيمها. والسجل ذو 16 بايتًا (ثنائي)
// مرجع خفي على x86-64 وسجلان على AArch64.
نوع ثنائي = { ع: عدد, ق: عدد };
نوع كبير = { أ: عدد, ب: عدد, ج: عدد, د: عدد, هـ: عدد };
نوع عريض = { الأيسر: كبير, الأيمن: كبير, الوسم: عدد };
نوع شكل =
    | علبة بنوع كبير
    | زوج بنوع (كبير, كبير)
    | نقطة
;

دع المجمع: متغير متجه كبير = [];

عرف كبير_من(ن: عدد): كبير { أرجع { أ: ن, ب: ن + 1, ج: ن + 2, د: ن + 3, هـ: ن + 4 }; }
عرف المجموع(س: كبير): عدد { أرجع س.أ + س.ب + س.ج + س.د + س.هـ; }

عرف ثنائي_متغير(ث: ثنائي, ر: &متغير ثنائي): عدد {
    (*ر).ع := 9;
    دع الخاص: متغير ثنائي = ث;
    الخاص.ق := 5;
    أرجع ث.ع + ث.ق + الخاص.ق;
}

عرف مقلوب(ث: ثنائي): ثنائي { أرجع { ع: ث.ق, ق: ث.ع }; }

// يغير المستدعى نسخته هو من المعامل.
عرف نسخة_متغيرة(س: كبير): عدد {
    دع الخاصة: متغير كبير = س;
    الخاصة.أ := 100;
    الخاصة.هـ := 200;
    أرجع الخاصة.أ + الخاصة.هـ + س.أ;
}

// معاملان مربوطان بالسجل نفسه.
عرف مرتين(س: كبير, ص: كبير): عدد {
    دع الخاصة: متغير كبير = س;
    الخاصة.ب := 50;
    أرجع الخاصة.ب + ص.ب + س.ب;
}

// يتغير السجل عبر مرجع أثناء عمل المستدعى.
عرف عبر_مرجع(س: كبير, ر: &متغير كبير): عدد {
    (*ر).أ := 77;
    (*ر).د := 88;
    أرجع س.أ + س.د;
}

// السجل عنصر في متجه عام يغيره المستدعى ويكبّره.
عرف عبر_عام(س: كبير): عدد {
    غير_آمن {
        المجمع[0].أ := 1000;
        المجمع[0] := كبير_من(500);
        دع ك: متغير عدد = 0;
        طالما (ك < 64) { ألحق(المجمع, كبير_من(ك)); ك := ك + 1; }
    }
    أرجع س.أ + س.هـ;
}

// السجل في صندوق يستبدله المستدعى (فيحرره).
عرف عبر_صندوق(س: كبير, ص: &متغير صندوق كبير): عدد {
    دع الجديد: صندوق كبير = صندوق كبير_من(900);
    *ص := الجديد;
    أرجع س.ج;
}

// يبدل النصفين وهو يقرؤهما: يُبنى الناتج في تخزين المستدعي أثناء قراءة الحجة.
عرف مبدل(ع: عريض): عريض {
    أرجع { الأيسر: ع.الأيمن, الأيمن: ع.الأيسر, الوسم: ع.الوسم + 1 };
}

عرف مزاح(س: كبير): كبير {
    أرجع { أ: س.هـ, ب: س.أ, ج: س.ب, د: س.ج, هـ: س.د };
}

عرف العمق(س: كبير, ن: عدد): عدد {
    إذا (ن == 0) { أرجع المجموع(س); };
    دع التالي: كبير = { أ: س.أ + 1, ب: س.ب, ج: س.ج, د: س.د, هـ: س.هـ };
    دع الأدنى: عدد = العمق(التالي, ن - 1);
    // لا تغير النداءات الأعمق س.
    أرجع الأدنى + س.أ;
}

عرف المساحة(ش: شكل): عدد {
    طابق ش مع
    | شكل.علبة(ك) -> { أرجع المجموع(ك); }
    | شكل.زوج(ي, ر) -> { أرجع المجموع(ي) - المجموع(ر); }
    | شكل.نقطة -> { أرجع 0; };
}

عرف طبق(د: دالة(كبير): عدد, س: كبير): عدد { أرجع د(س); }

عرف الرئيسية(): عدد {
    دع س: كبير = كبير_من(1);
    إذا (نسخة_متغيرة(س) != 301 || س.أ != 1 || س.هـ != 5) { أرجع 1; };
    إذا (مرتين(س, س) != 54 || س.ب != 2) { أرجع 2; };

    دع المحلي: متغير كبير = كبير_من(10);
    إذا (عبر_مرجع(المحلي, &متغير المحلي) != 23 || المحلي.أ != 77 || المحلي.د != 88) { أرجع 3; };

    دع من_العام: متغير عدد = 0;
    دع بعده: متغير عدد = 0;
    غير_آمن {
        ألحق(المجمع, كبير_من(1));
        من_العام := عبر_عام(المجمع[0]);
        بعده := المجمع[0].أ;
    }
    إذا (من_العام != 6 || بعده != 500) { أرجع 4; };

    دع المصندوق: متغير صندوق كبير = صندوق كبير_من(20);
    إذا (عبر_صندوق(*المصندوق, &متغير المصندوق) != 22 || (*المصندوق).ج != 902) { أرجع 5; };

    // س := د(س) على متغير محلي وعلى حقل سجل.
    دع ع: متغير عريض = { الأيسر: كبير_من(1), الأيمن: كبير_من(10), الوسم: 0 };
    ع := مبدل(ع);
    إذا (ع.الأيسر.أ != 10 || ع.الأيمن.أ != 1 || ع.الوسم != 1) { أرجع 6; };
    ع := مبدل(ع);
    إذا (ع.الأيسر.أ != 1 || ع.الأيمن.أ != 10 || ع.الوسم != 2) { أرجع 7; };
    ع.الأيسر := مزاح(ع.الأيسر);
    إذا (ع.الأيسر.أ != 5 || ع.الأيسر.ب != 1 || ع.الأيسر.هـ != 4) { أرجع 8; };

    // سجل تحمله الحلقة: كل دورة تمرر ناتج السابقة.
    دع ق: متغير كبير = كبير_من(1);
    دع ف: متغير عدد = 0;
    طالما (ف < 5) {
        ق := مزاح(ق);
        ف := ف + 1;
    }
    إذا (ق.أ != 1 || ق.ب != 2 || ق.هـ != 5) { أرجع 9; };

    إذا (العمق(كبير_من(1), 4) != 29) { أرجع 10; };

    // الإغلاقات: سجل ملتقط، ومعامل سجل لقيمة دالة.
    دع الملتقط: كبير = كبير_من(3);
    دع القارئ: دالة(عدد): عدد = دالة(ك: عدد): عدد -> المجموع(الملتقط) + ك;
    إذا (القارئ(1) != 26) { أرجع 11; };
    دع الجامع: دالة(كبير): عدد = دالة(ص: كبير): عدد -> نسخة_متغيرة(ص) + ص.أ;
    إذا (طبق(الجامع, س) != 302 || س.أ != 1) { أرجع 12; };
    إذا (طبق(المجموع, كبير_من(2)) != 20) { أرجع 13; };

    // قيم موسومة ذات حمولات كبيرة.
    إذا (المساحة(شكل.علبة(كبير_من(1))) != 15) { أرجع 14; };
    إذا (المساحة(شكل.زوج(كبير_من(5), كبير_من(1))) != 20) { أرجع 15; };
    إذا (المساحة(شكل.نقطة()) != 0) { أرجع 16; };

    // سجل من قيم بسيطة يُنسخ: يبقى الأصل صالحًا للاستعمال.
    دع ي: كبير = كبير_من(7);
    دع الأول: عدد = المجموع(ي);
    إذا (الأول != المجموع(ي) || ي.أ != 7) { أرجع 17; };

    // سجل ذو 16 بايتًا يتغير عبر مرجع أثناء النداء، ثم يُستبدل بناتج مبني منه.
    دع الثنائي: متغير ثنائي = { ع: 1, ق: 2 };
    إذا (ثنائي_متغير(الثنائي, &متغير الثنائي) != 8 || الثنائي.ع != 9 || الثنائي.ق != 2) { أرجع 18; };
    الثنائي := مقلوب(الثنائي);
    إذا (الثنائي.ع != 2 || الثنائي.ق != 9) { أرجع 19; };
    أرجع 42;
}
