// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/vector_literal_expressions.sn
// حرفي المتجه تعبير: حجة، وقيمة مُرجعة، وحقل سجل، وعنصر في حرفي آخر، وقيمة
// مؤقتة تُفهرس، ومعامل لعملية بدائية قارئة. يأخذ نوع عناصره من سياقه (`[]` في
// موضع `متجه عدد`) أو، بلا سياق، من عنصره الأول. تُقيّم العناصر من اليسار إلى
// اليمين وتُنقل إليه كما في `دع م: ن = [..];`.
استورد std.text.number;

نوع كيس = { العناصر: متجه عدد, الوسم: نص };

عرف المجموع(م: &متجه عدد): عدد {
    دع س: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(*م)) { س := س + (*م)[ف]; ف := ف + 1; }
    أرجع س;
}

عرف مجموع_مملوك(م: متجه عدد): عدد { أرجع المجموع(&م); }

عرف الأطوال(م: متجه نص): عدد {
    دع س: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < الطول(م)) { س := س + (الطول(م[ف]) مثل عدد); ف := ف + 1; }
    أرجع س;
}

عرف عدد_العناصر<ن>(م: متجه ن): عدد { أرجع الطول(م) مثل عدد; }

عرف الأول(م: متجه عدد, البديل: عدد): عدد {
    إذا (الطول(م) == 0) { أرجع البديل; };
    أرجع م[0];
}

عرف اصنع(ع: عدد): متجه عدد { أرجع [ع, ع + 1, ع + 2]; }

عرف فارغ(): متجه عدد { أرجع []; }

عرف تتبع(السجل: &متغير متجه عدد, س: عدد): عدد {
    ألحق(*السجل, س);
    أرجع س;
}

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    دع أ: عدد = 4;
    إذا (مجموع_مملوك([أ, 5, 6]) != 15) { الإخفاقات := الإخفاقات + 1; };
    إذا (مجموع_مملوك(اصنع(10)) != 33) { الإخفاقات := الإخفاقات + 1; };
    إذا (مجموع_مملوك(فارغ()) != 0) { الإخفاقات := الإخفاقات + 1; };

    // تُنقل العناصر المملوكة إلى الحرفي.
    دع ن: نص = عدد_إلى_نص(1234);
    إذا (الأطوال([ن, «ab», عدد_إلى_نص(7)]) != 7) { الإخفاقات := الإخفاقات + 1; };

    دع ك: كيس = { العناصر: [1, 2, 3], الوسم: «ك» };
    إذا (المجموع(&ك.العناصر) != 6) { الإخفاقات := الإخفاقات + 1; };

    دع الشبكة: متجه متجه عدد = [[1], [2, 3], []];
    إذا (الطول(الشبكة) != 3 || الطول(الشبكة[1]) != 2 || الطول(الشبكة[2]) != 0) { الإخفاقات := الإخفاقات + 1; };

    إذا ([10, 20, 30][1] != 20) { الإخفاقات := الإخفاقات + 1; };
    إذا (الطول([1, 2, 3, 4]) != 4) { الإخفاقات := الإخفاقات + 1; };
    إذا (الأول([7, 8], 0) != 7) { الإخفاقات := الإخفاقات + 1; };
    إذا (عدد_العناصر([«x», «y», «z»]) != 3 || عدد_العناصر([[1], [2]]) != 2) { الإخفاقات := الإخفاقات + 1; };
    دع لا_شيء_فيه: متجه عدد = [];
    إذا (الأول(لا_شيء_فيه, 9) != 9) { الإخفاقات := الإخفاقات + 1; };

    // التقييم من اليسار إلى اليمين، قبل النداء.
    دع السجل: متغير متجه عدد = [];
    دع ر: عدد = مجموع_مملوك([تتبع(&متغير السجل, 1), تتبع(&متغير السجل, 2)]) + تتبع(&متغير السجل, 3);
    إذا (ر != 6 || الطول(السجل) != 3 || السجل[0] != 1 || السجل[1] != 2 || السجل[2] != 3) { الإخفاقات := الإخفاقات + 1; };

    إذا (الإخفاقات != 0) { أرجع الإخفاقات; };
    أرجع 42;
}
