// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/temporary_address_arguments.sn
// `&قيمة_مؤقتة` حجةً لنداء: حرفي نص أو متجه أو سجل أو ناتج نداء يُخزن في
// خانة تملكها الكتلة، ويستعير النداء الخانة. يُقبل حين لا يستطيع ناتج النداء
// حمل مرجع، فلا تخرج الاستعارة من الكتلة.
نوع زوج = { أ: عدد, ب: عدد };

عرف طول_نص(ن: &نص): عدد { أرجع الطول(*ن) مثل عدد; }
عرف مجموع(م: &متجه عدد): عدد {
    دع الناتج: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*م) مثل طبيعي)) { الناتج := الناتج + (*م)[ف]; ف := ف + 1; }
    أرجع الناتج;
}
عرف فرق(ز: &زوج): عدد { أرجع (*ز).أ - (*ز).ب; }
عرف كلمة(): نص { أرجع «abcd»; }

عرف الرئيسية(): عدد {
    دع ك: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < 3) {
        ك := ك + طول_نص(&«xy») + مجموع(&[1, 2, 3]);
        ف := ف + 1;
    }
    أرجع ك + فرق(&{ أ: 10, ب: 4 }) + طول_نص(&كلمة()) + 8;
}
