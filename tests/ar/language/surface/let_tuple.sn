// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/let_tuple.sn
// `ليكن (أ، ب): (ن1، ن2) = ق;` تفكك صفا: يأخذ كل اسم عنصره، بالنوع المكتوب له، لبقية
// الكتلة. يُفكك صف يعيده نداء، وصف محلي، وحرفي صف (تأخذ حرفياته نوعها من النوع المكتوب)؛
// و`_` تتخطى عنصرا، والصفوف المتداخلة تفكك صفوفا متداخلة؛ وتنتقل النصوص المملوكة من الصف.
// ونصفا `اقسم_قابلا_للتعديل` عرضان قابلان للكتابة حين يقول النوع `متغير [] T`: الكتابة عبرهما
// تغير المتجه، ثم يُستعمل المتجه من جديد متى لم يعودا مستعملين.
عرف اقسم(أ: عدد، ب: عدد): (عدد، عدد) { أرجع (أ / ب، أ % ب); }

عرف فواكه(): (نص، نص، عدد) { أرجع ("تمر"، "تين"، 3); }

عرف املأ(الجزء: متغير [] عدد، القيمة: عدد): عدد {
    ليكن ف: متغير عدد = 0;
    طالما (ف < الطول(الجزء)) { الجزء[ف] := القيمة; ف := ف + 1; }
    أرجع الطول(الجزء);
}

عرف الأول_والبقية(م: &متغير متجه عدد): عدد {
    ليكن (الرأس، الذيل): (متغير [] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير *م، 1);
    الرأس[0] := 100;
    أرجع املأ(الذيل، 7);
}

عرف الرئيسية(): عدد {
    ليكن (ح، ب): (عدد، عدد) = اقسم(17، 5);
    إذا (ح != 3 || ب != 2) { أرجع 1; };
    ليكن الزوج: (نص، عدد) = ("زيتون"، 5);
    ليكن (الاسم، _): (نص، عدد) = الزوج;
    إذا ((الطول(الاسم) مثل عدد) != 10) { أرجع 2; };
    ليكن ((أ، ج)، د): ((عدد، عدد)، عدد) = ((1، 2)، 3);
    إذا (أ + ج + د != 6) { أرجع 3; };
    ليكن (الأولى، الثانية، العدد): (نص، نص، عدد) = فواكه();
    إذا ((الطول(الأولى) مثل عدد) + (الطول(الثانية) مثل عدد) != 12 || العدد != 3) { أرجع 4; };
    ليكن (الصغير، الواسع): (ط8، ص64) = (7، 8);
    إذا ((الصغير مثل عدد) + (الواسع مثل عدد) != 15) { أرجع 5; };
    ليكن م: متغير متجه عدد = [1، 2، 3، 4، 5];
    ليكن (اليسار، اليمين): (متغير [] عدد، متغير [] عدد) = اقسم_قابلا_للتعديل(&متغير م، 2);
    اليسار[0] := 10;
    اليمين[2] := 50;
    إذا (الطول(اليسار) != 2 || الطول(اليمين) != 3) { أرجع 6; };
    إذا (املأ(اليسار، 9) != 2) { أرجع 7; };
    إذا (م[0] != 9 || م[1] != 9 || م[2] != 3 || م[4] != 50) { أرجع 8; };
    م[2] := 30;
    إذا (الأول_والبقية(&متغير م) != 4 || م[0] != 100 || م[4] != 7) { أرجع 9; };
    أرجع 42;
}
