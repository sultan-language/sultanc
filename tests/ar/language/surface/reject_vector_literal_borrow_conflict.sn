// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-BORROW-CONFLICT
// نظير: tests/en/language/surface/reject_vector_literal_borrow_conflict.sn
// تدوم استعارات عناصر حرفي متجه ممرر حجة طوال النداء: فتتعارض مع استعارة
// متغيرة للقيمة نفسها في حجة أخرى.
عرف د(أ: &متغير عدد, ب: متجه &عدد): عدد { *أ := 2; أرجع الطول(ب) مثل عدد; }
عرف الرئيسية(): عدد {
    دع س: متغير عدد = 1;
    أرجع د(&متغير س, [&س]);
}
