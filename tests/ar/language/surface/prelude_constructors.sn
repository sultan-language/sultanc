// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/surface/prelude_constructors.sn
// منشئات التمهيد مكتوبة مجردة: `موجود(س)` و`لا_شيء` (و`لا_شيء()` أيضا) و`نجح(س)`
// و`خطأ(خ)`، في التعابير (الوسائط والإرجاع والمتغيرات المحلية وحقول السجلات وعناصر
// المتجهات) وفي الأنماط، حيث هي منشئات لا أسماء. والصيغ المؤهلة تعمل بجانبها. و`خطأ`
// وحدها تبقى القيمة المنطقية.
نوع قراءة = { القيمة: اختياري عدد، العدد: عدد };

عرف النصف(ن: عدد): اختياري عدد {
    إذا (ن % 2 != 0) { أرجع لا_شيء; };
    أرجع موجود(ن / 2);
}

عرف حلل_رقما(ح: حرف): نتيجة عدد، نص {
    طابق ح مع
    | مدى '0'..'9' -> { أرجع نجح(((ح مثل ط32) - ('0' مثل ط32)) مثل عدد); }
    | _ -> { أرجع خطأ("ليس رقما"); };
}

عرف أو_صفر(خ: اختياري عدد): عدد {
    طابق خ مع
    | موجود(ن) -> { أرجع ن; }
    | لا_شيء -> { أرجع 0; };
}

عرف الرمز(ن: نتيجة عدد، نص): عدد {
    طابق ن مع
    | نجح(ق) -> { أرجع ق; }
    | خطأ(الرسالة) -> { أرجع -(الطول(الرسالة) مثل عدد); };
}

عرف متداخل(م: متجه اختياري عدد): عدد {
    طابق م مع
    | [موجود(أ)، لا_شيء، بقية _] -> { أرجع أ; }
    | [لا_شيء، بقية _] -> { أرجع 1; }
    | _ -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    إذا (أو_صفر(النصف(8)) != 4 || أو_صفر(النصف(7)) != 0) { أرجع 1; };
    إذا (الرمز(حلل_رقما('7')) != 7 || الرمز(حلل_رقما('x')) != -15) { أرجع 2; };
    ليكن لا_قيمة: اختياري عدد = لا_شيء;
    ليكن لا_قيمة_أيضا: اختياري عدد = لا_شيء();
    ليكن مؤهل: اختياري عدد = اختياري.موجود(3);
    إذا (أو_صفر(لا_قيمة) != 0 || أو_صفر(لا_قيمة_أيضا) != 0 || أو_صفر(مؤهل) != 3) { أرجع 3; };
    ليكن ق: قراءة = { القيمة: موجود(5)، العدد: 6 };
    إذا (أو_صفر(ق.القيمة) + ق.العدد != 11) { أرجع 4; };
    ليكن العناصر: متجه اختياري عدد = [موجود(9)، لا_شيء، موجود(2)];
    إذا (متداخل(العناصر) != 9) { أرجع 5; };
    ليكن فاشل: نتيجة عدد، نص = خطأ("سيئ");
    إذا (الرمز(فاشل) != -6 || خطأ) { أرجع 6; };
    أرجع 42;
}
