// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// خرج-قياسي: hello world مرحبا 😀
// نظير: tests/en/language/surface/text_slices.sn
// شرائح النص: `&ن[أ..ب]` قيمة من النوع `&نص` تعرض البايتات من أ إلى ب من ن،
// والطرفان داخلان، بلا نسخ (docs/ar/reference/type-system.md، «شرائح النص»).
// نصوص لاتينية وعربية (بايتان للحرف) ورموز تعبيرية (أربعة بايتات) تُقطع عند
// حدود الحروف؛ شرائح كاملة ومفتوحة الطرف وفارغة؛ و`&ن` و`&ن[..]` سواء؛
// والمقارنة بالحرفيات والنصوص والشرائح الأخرى؛ والمطابقة على شريحة؛ وشرائح
// تُمرَّر إلى دوال تأخذ `&نص` وتُرجَع منها؛ وشريحة من شريحة؛ ودوال النص
// القارئة في المكتبة القياسية؛ والنسخ المملوكة؛ والطباعة.
استورد المكتبة.دخ.اطبع;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.من_بايتات;

عرف عد_البايتات(النص: &نص): عدد {
    أرجع الطول(*النص);
}

// الكلمة الأولى من نص: شريحة من النص المعطى.
عرف الكلمة_الأولى(النص: &نص): &نص {
    ليكن النهاية: متغير عدد = 0;
    طالما (النهاية < الطول(*النص) && (*النص)[النهاية] != 32) { النهاية := النهاية + 1; }
    أرجع &النص[0..النهاية - 1];
}

عرف الرئيسية(): عدد {
    ليكن ن: نص = «hello world»;
    ليكن الشريحة: &نص = &ن[6..10];
    إذا (*الشريحة != «world») { أرجع 1; };
    إذا (الشريحة != «world») { أرجع 2; };
    إذا (الطول(*الشريحة) != 5) { أرجع 3; };
    // استعارة النص كله وشريحة النص كله قيمة واحدة.
    ليكن الكل: &نص = &ن;
    ليكن الكامل: &نص = &ن[..];
    إذا (*الكل != *الكامل || الطول(*الكامل) != 11 || الكل != الكامل) { أرجع 4; };
    ليكن الرأس: &نص = &ن[..4];
    ليكن الذيل: &نص = &ن[6..];
    إذا (*الرأس != «hello» || *الذيل != «world») { أرجع 5; };
    // شرائح فارغة: `&ن[أ..أ - 1]`، وبداية عند الطول، ونهاية -1.
    ليكن الفارغة: &نص = &ن[3..2];
    ليكن لا_يسار: &نص = &ن[11..];
    ليكن لا_يمين: &نص = &ن[..-1];
    إذا (الطول(*الفارغة) != 0 || الطول(*لا_يسار) != 0 || الطول(*لا_يمين) != 0 || *الفارغة != «») { أرجع 6; };
    // المقارنة بنص وبشرائح أخرى، بايتا ببايت.
    ليكن العالم: نص = «world»;
    إذا (*الشريحة != العالم || الشريحة != الذيل || العالم != *الذيل) { أرجع 7; };
    إذا (الشريحة == الرأس) { أرجع 8; };
    // شريحة من شريحة، عبر المرجع أو مكتوبة صراحة.
    ليكن الوسط: &نص = &الشريحة[1..3];
    ليكن الوسط_ثانية: &نص = &(*الشريحة)[1..3];
    إذا (*الوسط != «orl» || الوسط != الوسط_ثانية) { أرجع 9; };
    // شرائح تُمرَّر إلى الدوال وتُرجَع منها.
    إذا (عد_البايتات(الشريحة) != 5 || عد_البايتات(&ن[0..0]) != 1) { أرجع 10; };
    ليكن الكلمة: &نص = الكلمة_الأولى(&ن);
    إذا (الكلمة != «hello») { أرجع 11; };
    // العربية: بايتان للحرف.
    ليكن العربي: نص = «مرحبا بالعالم»;
    ليكن التحية: &نص = &العربي[0..9];
    إذا (التحية != «مرحبا» || الطول(*التحية) != 10) { أرجع 12; };
    ليكن الراء: &نص = &العربي[2..3];
    إذا (الراء != «ر») { أرجع 13; };
    ليكن الباقي: &نص = &العربي[11..];
    إذا (الباقي != «بالعالم» || الكلمة_الأولى(&العربي) != التحية) { أرجع 14; };
    // الرموز التعبيرية: أربعة بايتات.
    ليكن الوجوه: نص = «😀😃x»;
    ليكن الثاني: &نص = &الوجوه[4..7];
    إذا (الثاني != «😃» || الطول(*الثاني) != 4) { أرجع 15; };
    ليكن الأخير: &نص = &الوجوه[8..];
    إذا (الأخير != «x») { أرجع 16; };
    ليكن الوجه_الأول: &نص = &الوجوه[..3];
    إذا (الوجه_الأول != «😀») { أرجع 17; };
    // مطابقة على شريحة.
    ليكن الصنف: عدد = طابق *الشريحة مع | «hello» -> 1 | «world» -> 2 | _ -> 3;
    إذا (الصنف != 2) { أرجع 18; };
    // دوال النص القارئة في المكتبة القياسية تأخذ أي `&نص`.
    إذا (!يبدأ_بـ(الشريحة, &«wor») || !ينتهي_بـ(&ن[0..4], &«llo») || !يحتوي_نصا(&العربي[11..], &«عالم»)) { أرجع 19; };
    // نسخ مملوكة.
    ليكن المنسوخ: نص = انسخ_نص(الشريحة);
    ليكن المستنسخ: نص = استنسخ(&العربي[0..9]);
    إذا (المنسوخ != «world» || المستنسخ != «مرحبا») { أرجع 20; };
    // يُقرأ النص والشرائح حية: لم يُنسخ شيء.
    إذا (ن != «hello world») { أرجع 21; };
    اطبع(&ن[0..4]);
    اطبع(« »);
    اطبع(الشريحة);
    اطبع(« »);
    اطبع(التحية);
    اطبع(« »);
    اطبع(&الوجوه[0..3]);
    أرجع 42;
}
