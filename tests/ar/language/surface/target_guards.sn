// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/surface/target_guards.sn
// حراس الهدف بأسماء `الهدف` وحقوله العربية.
إذا (الهدف.عائلة_المنصة == «unix» && الهدف.عرض_المؤشر == «64») {
    عرف درجة_العائلة(): ص32 { أرجع 40; }
} وإلا {
    عرف درجة_العائلة(): ص32 { أرجع 1; }
}
إذا (الهدف.المنصة == «plan9» || الهدف.المعمارية == «avr») {
    عرف درجة_أخرى(): ص32 { أرجع 100; }
} وإلا {
    عرف درجة_أخرى(): ص32 { أرجع 2; }
}
إذا (!(الهدف.ترتيب_البايت == «big») && الهدف.صيغة_الكائن != «none» && الهدف.الثلاثي != «») {
    عرف درجة_الترتيب(): ص32 { أرجع 0; }
} وإلا {
    عرف درجة_الترتيب(): ص32 { أرجع 50; }
}
إذا (الهدف.البيئة == «unknown-environment» || الهدف.الواجهة_الثنائية == «unknown-abi»
    || الهدف.الدعم == «unknown-support» || الهدف.مزود_التشغيل == «unknown-runtime») {
    عرف درجة_مجهولة(): ص32 { أرجع 7; }
} وإلا {
    عرف درجة_مجهولة(): ص32 { أرجع 0; }
}
عرف الرئيسية(): ص32 {
    أرجع درجة_العائلة() + درجة_أخرى() + درجة_الترتيب() + درجة_مجهولة();
}
