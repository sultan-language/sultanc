// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// مرحلة0: نعم
// نظير: tests/en/language/stage0/features.sn
// The language the C Stage0 compiles since it learned the self-hosted
// frontend's later features (docs/OWNERSHIP_AND_DESTRUCTION.md, "Bootstrap
// constraints"): module constants and variables, break/continue/for, calls in
// vector literals, literal/range/alternative patterns (also nested), floats
// and float casts, wrapping arithmetic, pop/truncate/capacity/reserve,
// members of call results, `؟`, and إنهيار ending its path. Native, the
// interpreter and Stage0 agree.
استورد std.math.wrapping;
استورد std.process.panic;

دع الحد: عدد = 6 * 7;
دع الأرقام: متجه ط32 = [3, 1, 4];
دع التحية: نص = «hello»;
دع العداد: متغير عدد = 0;

نوع زوج = { الاسم: نص, القيمة: عدد, الخطوة: دالة(عدد): عدد };

عرف زد(س: عدد): عدد { أرجع س + 1; }
عرف زوجا(ق: عدد): زوج { دع ز: زوج = { الاسم: «pair», القيمة: ق, الخطوة: زد }; أرجع ز; }
عرف مربع(س: عدد): عدد { أرجع س * س; }

عرف صنف(الرمز: اختياري عدد): عدد {
    طابق الرمز مع
    | اختياري.موجود(0) -> { أرجع 1; }
    | اختياري.موجود(مدى 1 إلى 9) -> { أرجع 2; }
    | اختياري.موجود(-1 | 100) -> { أرجع 3; }
    | اختياري.موجود(_) -> { أرجع 4; }
    | اختياري.لا_شيء -> { أرجع 5; };
}

عرف موجب(س: عدد): نتيجة عدد, نص {
    لو (س > 0) { أرجع نتيجة.نجح(س); };
    أرجع نتيجة.خطأ(«not positive»);
}

عرف ضعف_موجب(س: عدد): نتيجة عدد, نص {
    دع ق: عدد = موجب(س)؟;
    أرجع نتيجة.نجح(ق * 2);
}

عرف متحقق(س: عدد): عدد {
    لو (س >= 0) { أرجع س; };
    إنهيار(«negative»);
}

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    // Module constants and variables.
    لو (الحد != 42 || الطول(الأرقام) != 3 || الأرقام[2] != 4 || الطول(التحية) != 5) { الإخفاقات := الإخفاقات + 1; };
    العداد := العداد + 5;
    لو (العداد != 5) { الإخفاقات := الإخفاقات + 1; };
    // break, continue and for.
    دع المجموع: متغير عدد = 0;
    لكل (دع ف: متغير عدد = 0; ف < 10; ف := ف + 1) {
        لو (ف == 3) { تابع_حلقة; };
        لو (ف == 8) { اخرج_من_حلقة; };
        المجموع := المجموع + ف;
    }
    لو (المجموع != 25) { الإخفاقات := الإخفاقات + 1; };
    // Calls inside a vector literal.
    دع المربعات: متجه عدد = [مربع(2), مربع(3), الحد - 40];
    لو (المربعات[0] + المربعات[1] + المربعات[2] != 15) { الإخفاقات := الإخفاقات + 1; };
    // Literal patterns, nested, ranges and alternatives.
    لو (صنف(اختياري.موجود(0)) + صنف(اختياري.موجود(7)) + صنف(اختياري.موجود(100))
        + صنف(اختياري.موجود(55)) + صنف(اختياري.لا_شيء()) != 15) { الإخفاقات := الإخفاقات + 1; };
    // Floats and float casts (saturating, NaN gives 0).
    دع النصف: ع64 = 2.5 * 3.0;
    لو ((النصف مثل عدد) != 7 || ((1.0e30) مثل ص32) != 2147483647 || ((0.0 / 0.0) مثل عدد) != 0) {
        الإخفاقات := الإخفاقات + 1;
    };
    لو (((300 مثل ع32) مثل ط8) != 255 || (((7 مثل ع64) مثل ع32) مثل ص64) != 7) { الإخفاقات := الإخفاقات + 1; };
    // Wrapping arithmetic.
    لو (جمع_ص8_ملتف(127, 1) != -128 || ضرب_ط8_ملتف(16, 16) != 0) { الإخفاقات := الإخفاقات + 1; };
    // pop, truncate, capacity, reserve_exact.
    دع العناصر: متغير متجه نص = [];
    احجز_سعة(العناصر, 4);
    لو (سعة(العناصر) < 4) { الإخفاقات := الإخفاقات + 1; };
    ألحق(العناصر, «a»);
    ألحق(العناصر, «b»);
    ألحق(العناصر, «c»);
    طابق أزل_الأخير(العناصر) مع
    | اختياري.موجود(الأخير) -> { لو (الطول(الأخير) != 1) { الإخفاقات := الإخفاقات + 1; }; }
    | اختياري.لا_شيء -> { الإخفاقات := الإخفاقات + 1; };
    اقتطع(العناصر, 1);
    لو (الطول(العناصر) != 1) { الإخفاقات := الإخفاقات + 1; };
    // Members, elements and calls of call results.
    لو (زوجا(9).القيمة + زوجا(1).الخطوة(2) + (الطول(زوجا(3).الاسم) مثل عدد) != 16) { الإخفاقات := الإخفاقات + 1; };
    // Propagation and إنهيار.
    طابق ضعف_موجب(4) مع
    | نتيجة.نجح(8) -> { }
    | _ -> { الإخفاقات := الإخفاقات + 1; };
    طابق ضعف_موجب(-4) مع
    | نتيجة.خطأ(_) -> { }
    | _ -> { الإخفاقات := الإخفاقات + 1; };
    لو (متحقق(2) != 2) { الإخفاقات := الإخفاقات + 1; };
    لو (الإخفاقات != 0) { أرجع الإخفاقات; };
    أرجع 42;
}
