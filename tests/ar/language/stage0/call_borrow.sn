// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// مرحلة0: نعم
// نظير: tests/en/language/stage0/call_borrow.sn
// A shared borrow of a call result, `&f(x)`, as a call argument: the result
// is a temporary made before the call and dropped after it, in the C Stage0
// as in the self-hosted compiler, so no named local is needed to pass a call
// result to a `&نص` or `&متجه` parameter. Nested borrows work, and a borrow
// in a loop releases each result: the allocator's live bytes are the same
// after a thousand of them. Native, the interpreter and Stage0 agree.
استورد std.os.allocation;
استورد std.text.number;

عرف الحجم(النص: &نص): عدد { أرجع الطول(*النص) مثل عدد; }

عرف العدد(القيم: &متجه عدد): عدد { أرجع الطول(*القيم) مثل عدد; }

عرف موصول(الأول: &نص, الثاني: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأول) مثل طبيعي)) { ألحق(البايتات, (*الأول)[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(*الثاني) مثل طبيعي)) { ألحق(البايتات, (*الثاني)[ف]); ف := ف + 1; }
    أرجع البايتات مثل نص;
}

عرف أعداد(ن: عدد): متجه عدد {
    دع القيم: متغير متجه عدد = [];
    دع ف: متغير عدد = 0;
    طالما (ف < ن) { ألحق(القيم, ف); ف := ف + 1; }
    أرجع القيم;
}

عرف الرئيسية(): عدد {
    دع أ: نص = "ab";
    دع ب: نص = "cd";
    // "abcde": تُسقط النتيجة الداخلية بعد النداء الداخلي، والخارجية بعد الحجم.
    دع المتداخل: عدد = الحجم(&موصول(&موصول(&أ, &ب), &"e"));
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع الأرقام: متغير عدد = 0;
    دع ف: متغير عدد = 0;
    طالما (ف < 1000) {
        الأرقام := الأرقام + الحجم(&عدد_إلى_نص(ف));
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (بعد != قبل) { أرجع 1; };
    // 10 أعداد بخانة واحدة و90 بخانتين و900 بثلاث خانات.
    إذا (الأرقام != 2890) { أرجع 2; };
    أرجع المتداخل + العدد(&أعداد(3)) + 34;
}
