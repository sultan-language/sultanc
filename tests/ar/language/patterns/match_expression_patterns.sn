// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/match_expression_patterns.sn
// أذرع تعبير المطابقة هي أذرع جملة المطابقة: الحراس (`| ن إذا ش -> ق`، والروابط
// مستعارة أثناء الحارس، وحمولة مملوكة ينقلها ذراع لاحق بعد فشل حارس عليها)،
// والأنماط البديلة، وأسماء `مثل`، وأنماط السجلات ببعض الحقول وبالحقول المختصرة،
// وأنماط المتجهات (العناصر المالكة عروض للمتجه، و`بقية الذيل` شريحة منه)، مع
// أذرع بين معقوفين، وتعبير مطابقة في حارس، وفي جسم إغلاق.
نوع شكل = | دائرة بنوع عدد | مربع بنوع عدد | مستطيل بنوع (عدد, عدد) | نقطة;
نوع مقاس = { العرض: عدد, الارتفاع: عدد, العمق: عدد };
نوع مسمى = | واحد بنوع نص | اثنان بنوع (نص, نص) | لا_أحد;

عرف صنف_الشكل(ش: شكل): عدد {
    أرجع طابق ش مع
    | شكل.دائرة(ن) إذا ن > 10 -> 3
    | شكل.دائرة(_) | شكل.نقطة -> 1
    | شكل.مستطيل(ع, ط) إذا ع == ط -> 2
    | شكل.مستطيل(_, _) -> 0
    | شكل.مربع(ض) -> ض;
}

عرف عرض_من(م: مقاس): عدد {
    أرجع طابق م مع
    | { العرض: ع } إذا ع > 10 -> ع
    | { العرض, الارتفاع: ر, العمق } -> العرض + ر + العمق;
}

عرف مساحة(م: مقاس): عدد {
    ليكن أ: عدد = طابق م مع | { العرض, الارتفاع } -> العرض * الارتفاع;
    أرجع أ;
}

عرف جانب(ش: شكل): عدد {
    أرجع طابق ش مع
    | شكل.دائرة(ن) مثل د -> ن + صنف_الشكل(د)
    | شكل.مربع(ض) مثل م -> ض + صنف_الشكل(م)
    | آخر -> صنف_الشكل(آخر);
}

عرف عد_المسمى(ن: مسمى): عدد {
    أرجع طابق ن مع
    | مسمى.واحد(ق) -> الطول(ق) مثل عدد
    | مسمى.اثنان(أ, ب) -> (الطول(أ) مثل عدد) + (الطول(ب) مثل عدد)
    | مسمى.لا_أحد -> 0;
}

عرف عد_العرض(ن: &مسمى): عدد {
    أرجع طابق *ن مع
    | مسمى.واحد(_) -> 1
    | مسمى.اثنان(_, _) -> 2
    | مسمى.لا_أحد -> 0;
}

عرف الكل(ن: مسمى): عدد {
    أرجع طابق ن مع
    | مسمى.واحد(_) مثل الجميع -> عد_المسمى(الجميع)
    | مسمى.اثنان(أ, _) مثل الجميع -> (الطول(أ) مثل عدد) + عد_العرض(&الجميع)
    | مسمى.لا_أحد -> 0;
}

عرف مجموع(ش: [] عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) {
        المجموع := المجموع + ش[ف];
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف صف_المتجه(م: متجه عدد): عدد {
    أرجع طابق م مع
    | [] -> 0
    | [أ] -> أ
    | [أ, ب] -> أ + ب
    | [الأول, بقية _, الأخير] -> الأول * 100 + الأخير;
}

عرف الرأس_والبقية(م: متجه عدد): عدد {
    أرجع طابق م مع
    | [الأول, بقية الذيل] -> الأول + 10 * مجموع(الذيل)
    | [] -> 0;
}

عرف محروس(م: متجه عدد): عدد {
    أرجع طابق م مع
    | [س, بقية _] إذا س > 5 -> 1
    | [_, بقية _] -> 2
    | [] -> 3;
}

عرف عناصر_مملوكة(م: متجه نص): عدد {
    أرجع طابق م مع
    | [أ, ب, بقية _] -> (الطول(أ) مثل عدد) + (الطول(ب) مثل عدد)
    | [أ] -> الطول(أ) مثل عدد
    | [] -> 0;
}

عرف أول_موجود(م: متجه اختياري عدد): عدد {
    أرجع طابق م مع
    | [اختياري.موجود(ق), بقية _] | [_, اختياري.موجود(ق), بقية _] -> ق
    | _ -> 0;
}

عرف خذ(ق: نص): عدد { أرجع الطول(ق) مثل عدد; }

// حارس الذراع الأول يقرأ الحمولة ويفشل؛ والذراع الثاني ينقلها.
عرف منقول_بعد_حارس_فاشل(ن: مسمى): عدد {
    أرجع طابق ن مع
    | مسمى.واحد(ق) إذا الطول(ق) > 100 -> 0
    | مسمى.واحد(ق) | مسمى.اثنان(ق, _) -> خذ(ق)
    | مسمى.لا_أحد -> 1;
}

عرف حارس_متداخل(س: عدد): عدد {
    أرجع طابق س مع
    | ق إذا (طابق ق % 2 مع | 0 -> صواب | _ -> خطأ) -> {
        ليكن النصف: عدد = ق / 2;
        النصف
    }
    | ق -> ق;
}

عرف الرئيسية(): عدد {
    إذا (صنف_الشكل(شكل.دائرة(20)) != 3 || صنف_الشكل(شكل.دائرة(2)) != 1 || صنف_الشكل(شكل.نقطة()) != 1) { أرجع 1; };
    إذا (صنف_الشكل(شكل.مستطيل(2, 2)) != 2 || صنف_الشكل(شكل.مستطيل(2, 3)) != 0 || صنف_الشكل(شكل.مربع(4)) != 4) { أرجع 2; };
    ليكن الكبير: مقاس = { العرض: 20, الارتفاع: 1, العمق: 1 };
    ليكن الصغير: مقاس = { العرض: 1, الارتفاع: 2, العمق: 3 };
    ليكن المكعب: مقاس = { العرض: 2, الارتفاع: 3, العمق: 4 };
    إذا (عرض_من(الكبير) != 20 || عرض_من(الصغير) != 6 || مساحة(المكعب) != 6) { أرجع 3; };
    إذا (جانب(شكل.دائرة(2)) != 3 || جانب(شكل.مربع(3)) != 6 || جانب(شكل.نقطة()) != 1) { أرجع 4; };
    إذا (الكل(مسمى.واحد(«abc»)) != 3 || الكل(مسمى.اثنان(«ab», «cde»)) != 4 || الكل(مسمى.لا_أحد()) != 0) { أرجع 5; };
    إذا (صف_المتجه([]) != 0 || صف_المتجه([7]) != 7 || صف_المتجه([3, 4]) != 7 || صف_المتجه([1, 2, 3, 9]) != 109) { أرجع 6; };
    إذا (الرأس_والبقية([1, 2, 3, 9]) != 141 || الرأس_والبقية([]) != 0) { أرجع 7; };
    إذا (محروس([7]) != 1 || محروس([3, 4]) != 2 || محروس([]) != 3) { أرجع 8; };
    إذا (عناصر_مملوكة([«ab», «cde», «f»]) != 5 || عناصر_مملوكة([«xyz»]) != 3 || عناصر_مملوكة([]) != 0) { أرجع 9; };
    إذا (أول_موجود([اختياري.موجود(5), اختياري.لا_شيء()]) != 5 || أول_موجود([اختياري.لا_شيء(), اختياري.موجود(6)]) != 6) { أرجع 10; };
    إذا (أول_موجود([اختياري.لا_شيء()]) != 0) { أرجع 11; };
    إذا (منقول_بعد_حارس_فاشل(مسمى.واحد(«abcd»)) != 4 || منقول_بعد_حارس_فاشل(مسمى.اثنان(«ab», «x»)) != 2) { أرجع 12; };
    إذا (منقول_بعد_حارس_فاشل(مسمى.لا_أحد()) != 1) { أرجع 13; };
    إذا (حارس_متداخل(10) != 5 || حارس_متداخل(7) != 7) { أرجع 14; };
    ليكن اختر: دالة(شكل): عدد = دالة(ش: شكل): عدد -> طابق ش مع | شكل.دائرة(ن) إذا ن > 1 -> ن | _ -> 0;
    إذا (اختر(شكل.دائرة(5)) != 5 || اختر(شكل.دائرة(1)) != 0 || اختر(شكل.نقطة()) != 0) { أرجع 15; };
    أرجع 42;
}
