// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/rest_patterns.sn
// `بقية` في أنماط المتجهات والشرائح: العنصر الأخير، والأول، والطرفان، ومجموع عودي
// بالرأس والذيل، والتناظر عبر `بقية الوسط`، ووسائط على طريقة سطر الأوامر، وبقية داخل
// صف وداخل حمولة تعداد، و`بقية` اسما عاديا، وتحت `طابق &متغير م` بقية قابلة للكتابة تكتب
// في م وتبقى روابط العناصر قيما للقراءة فقط.
نوع أمر = | شغّل بنوع متجه نص | مساعدة;

عرف الأخير(م: متجه عدد): عدد {
    طابق م مع
    | [بقية _، س] -> { أرجع س; }
    | [] -> { أرجع -1; };
}

عرف الأول(م: متجه عدد): عدد {
    طابق م مع
    | [س، بقية _] -> { أرجع س; }
    | [] -> { أرجع -1; };
}

عرف الطرفان(م: متجه عدد): عدد {
    طابق م مع
    | [أ، بقية _، ب] -> { أرجع أ * 10 + ب; }
    | [أ] -> { أرجع أ; }
    | [] -> { أرجع 0; };
}

عرف مجموع(ش: [] عدد): عدد {
    طابق ش مع
    | [] -> { أرجع 0; }
    | [الرأس، بقية الذيل] -> { أرجع الرأس + مجموع(الذيل); };
}

عرف متناظر(ش: [] عدد): منطقي {
    طابق ش مع
    | [أ، بقية الوسط، ب] -> { أرجع أ == ب && متناظر(الوسط); }
    | _ -> { أرجع صواب; };
}

// `["تشغيل"، الملف، بقية الإضافية]`: أمر، وملفه، وسائر الوسائط.
عرف وسائط_التشغيل(الوسائط: متجه نص): عدد {
    طابق الوسائط مع
    | ["تشغيل"، الملف، بقية الإضافية] -> { أرجع (الطول(الملف) مثل عدد) * 10 + (الطول(الإضافية) مثل عدد); }
    | ["مساعدة"] -> { أرجع 1; }
    | _ -> { أرجع 0; };
}

عرف بقية_صف(ز: (متجه عدد، عدد)): عدد {
    طابق ز مع
    | ([أ، بقية الذيل]، ك) -> { أرجع أ + ك + مجموع(الذيل); }
    | ([]، ك) -> { أرجع ك; };
}

عرف بقية_حمولة(أ: أمر): عدد {
    طابق أ مع
    | أمر.شغّل([_، بقية غيرها]) -> { أرجع الطول(غيرها) مثل عدد; }
    | أمر.شغّل([]) -> { أرجع 0; }
    | أمر.مساعدة -> { أرجع -1; };
}

// `بقية` وحدها، أو قبل `،`، اسم عادي.
عرف أسماء_عادية(م: متجه عدد): عدد {
    ليكن بقية: عدد = 5;
    طابق م مع
    | [بقية] -> { أرجع بقية; }
    | [بقية، س] -> { أرجع بقية + س; }
    | _ -> { أرجع بقية; };
}

// تحت `طابق &متغير م` تكون البقية المسماة `متغير [] عدد`.
عرف املأ_الذيل(م: &متغير متجه عدد): عدد {
    طابق &متغير *م مع
    | [الأول، بقية الذيل] -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الذيل) مثل طبيعي)) {
            الذيل[ف] := الأول;
            ف := ف + 1;
        }
        أرجع الطول(الذيل) مثل عدد;
    }
    | [] -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن م: متجه عدد = [1، 2، 3، 4];
    إذا (الأخير(استنسخ(&م)) != 4 || الأول(استنسخ(&م)) != 1 || الطرفان(استنسخ(&م)) != 14) { أرجع 1; };
    ليكن واحد: متجه عدد = [7];
    ليكن فارغ: متجه عدد = [];
    إذا (الأخير(استنسخ(&واحد)) != 7 || الطرفان(استنسخ(&واحد)) != 7 || الطرفان(استنسخ(&فارغ)) != 0) { أرجع 2; };
    إذا (مجموع(م) != 10 || مجموع(فارغ) != 0) { أرجع 3; };
    ليكن ت: متجه عدد = [1، 2، 3، 2، 1];
    إذا (!متناظر(ت) || متناظر(م)) { أرجع 4; };
    ليكن الوسائط: متجه نص = ["تشغيل"، "main.sn"، "-O2"، "--fast"];
    إذا (وسائط_التشغيل(الوسائط) != 72) { أرجع 5; };
    ليكن الزوج: (متجه عدد، عدد) = ([1، 2، 3]، 10);
    إذا (بقية_صف(الزوج) != 16) { أرجع 6; };
    ليكن الأسماء: متجه نص = ["أ"، "ب"، "ج"];
    إذا (بقية_حمولة(أمر.شغّل(الأسماء)) != 2 || بقية_حمولة(أمر.مساعدة()) != -1) { أرجع 7; };
    ليكن مفرد: متجه عدد = [3];
    ليكن مزدوج: متجه عدد = [3، 4];
    إذا (أسماء_عادية(مفرد) != 3 || أسماء_عادية(مزدوج) != 7 || أسماء_عادية(استنسخ(&م)) != 5) { أرجع 8; };
    ليكن ع: متغير متجه عدد = [9، 8، 7، 6];
    إذا (املأ_الذيل(&متغير ع) != 3) { أرجع 9; };
    إذا (ع[0] != 9 || ع[1] != 9 || ع[3] != 9) { أرجع 10; };
    طابق &متغير ع مع
    | [_، بقية الذيل] -> { الذيل[0] := 1; }
    | [] -> { };
    إذا (ع[1] != 1 || ع[2] != 9) { أرجع 11; };
    أرجع 42;
}
