// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/guards.sn
// الحراس: `| نمط إذا شرط ->`. يرى الشرط روابط النمط؛ وإذا كان خطأ تابعت
// المطابقة بالذراع التالي. ينطبق الحارس على النمط ذي البدائل كله. الروابط
// مستعارة ما دام الحارس يجري: الحمولة المملوكة التي قرأها الحارس تنتقل بعد
// ذلك إلى الذراع المختار، حتى بعد أن فشل حارس ذراع سابق عليها. ولا يُحتسب
// الذراع المحروس في الشمول، فتبقى الأذرع التي بعده مغطية لقيمه.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع شكل = | دائرة بنوع عدد | مربع بنوع عدد | نقطة;
نوع مسمى = | واحد بنوع نص | اثنان بنوع (نص, نص) | لا_أحد;

عرف صنف(القيمة: عدد): عدد {
    طابق القيمة مع
    | س إذا س > 100 -> { أرجع 3; }
    | س إذا س > 5 -> { أرجع 2; }
    | 0 -> { أرجع 0; }
    | _ -> { أرجع 1; };
}

عرف كبير(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(ن) | شكل.مربع(ن) إذا ن > 3 -> { أرجع ن; }
    | شكل.دائرة(_) | شكل.مربع(_) -> { أرجع 1; }
    | شكل.نقطة -> { أرجع 0; };
}

عرف خذ(ن: نص): عدد { أرجع الطول(ن) مثل عدد; }

عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }

// يقرأ حارس الذراع الأول الحمولة ويفشل؛ وينقلها الذراع الثاني.
عرف منقول_بعد_حارس_فاشل(م: مسمى): عدد {
    طابق م مع
    | مسمى.واحد(ن) إذا الطول(ن) > 100 -> { أرجع 0; }
    | مسمى.واحد(ن) | مسمى.اثنان(ن, _) -> { أرجع خذ(ن); }
    | مسمى.لا_أحد -> { أرجع 1; };
}

// حارس يملك قيمة مؤقتة (النص الذي يقارنه).
عرف نص_محروس(القيمة: عدد): عدد {
    طابق القيمة مع
    | ق إذا عدد_إلى_نص(ق) == "7" -> { أرجع 7; }
    | _ -> { أرجع 2; };
}

// حارس على مميز مستعار.
عرف عبر_مرجع(م: &مسمى): عدد {
    طابق *م مع
    | مسمى.اثنان(أ, ب) إذا الطول(أ) == الطول(ب) -> { أرجع 5; }
    | _ -> { أرجع 6; };
}

عرف جولات(): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 100) {
        المجموع := المجموع + منقول_بعد_حارس_فاشل(مسمى.واحد(نص_من(ف)));
        المجموع := المجموع + منقول_بعد_حارس_فاشل(مسمى.اثنان(نص_من(ف), نص_من(ف)));
        المجموع := المجموع + نص_محروس(ف % 9);
        ليكن اثنان: مسمى = مسمى.اثنان(نص_من(ف), نص_من(ف + 1));
        المجموع := المجموع + عبر_مرجع(&اثنان);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    إذا (صنف(500) != 3 || صنف(50) != 2 || صنف(0) != 0 || صنف(3) != 1) { أرجع 1; };
    إذا (كبير(شكل.دائرة(9)) != 9 || كبير(شكل.مربع(8)) != 8) { أرجع 2; };
    إذا (كبير(شكل.دائرة(2)) != 1 || كبير(شكل.مربع(1)) != 1 || كبير(شكل.نقطة()) != 0) { أرجع 3; };
    إذا (منقول_بعد_حارس_فاشل(مسمى.لا_أحد()) != 1) { أرجع 4; };
    ليكن ر: عدد = جولات();
    ليكن التخصيصات: ط64 = عدد_تخصيصات_النظام();
    ليكن التحريرات: ط64 = عدد_تحريرات_النظام();
    إذا (جولات() != ر) { أرجع 5; };
    ليكن المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
    ليكن المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
    إذا (المخصص != 0 && المحرر + 8 < المخصص) { أرجع 6; };
    أرجع 42;
}
