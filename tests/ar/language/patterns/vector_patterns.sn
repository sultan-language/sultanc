// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/vector_patterns.sn
// أنماط المتجهات والشرائح: `[]` و`[أ]` و`[أ، ب]` و`[الأول، بقية _]` و`[الأول، بقية الذيل]`
// و`[بقية _، الأخير]` و`[الأول، بقية _، الأخير]`؛ شاملة بالطول (`[]` و`[_، بقية _]` تغطيان كل
// متجه)، مع الحراس وداخل البدائل. العناصر التي تملك تخزينا عروض مستعارة من
// المتجه، على متجه مملوك أو مستعار أو مؤقت. و`بقية الذيل` شريحة من عناصر التسلسل
// المطابَق نفسها، لأي نوع عناصر، في الآخر أو الأول أو الوسط، وداخل حلقة وبديل
// وعودية على شريحة؛ ولا تنسخ شيئا. وتبين عدادات المخصص أن شيئا لا يبقى خلفها وأن
// البقية لا تخصص شيئا.
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

عرف صف_المتجه(م: متجه عدد): عدد {
    طابق م مع
    | [] -> { أرجع 0; }
    | [أ] -> { أرجع أ; }
    | [أ, ب] -> { أرجع أ + ب; }
    | [الأول, بقية _, الأخير] -> { أرجع الأول * 100 + الأخير; };
}

عرف مجموع(ش: [] عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) {
        المجموع := المجموع + ش[ف];
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرأس_والبقية(م: متجه عدد): عدد {
    طابق م مع
    | [الأول, بقية الذيل] -> { أرجع الأول + 10 * مجموع(الذيل); }
    | [] -> { أرجع 0; };
}

// `بقية الذيل` داخل حلقة: كل دورة تعرض المتجه من جديد.
عرف البقية_في_حلقة(م: متجه عدد): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير عدد = 0;
    طالما (ف < 3) {
        طابق م مع
        | [_, بقية الذيل] -> { المجموع := المجموع + مجموع(الذيل); }
        | [] -> { };
        ف := ف + 1;
    }
    أرجع المجموع;
}

// بقية الشريحة شريحة أضيق من الذاكرة نفسها.
عرف مجموع_الشريحة(ش: [] عدد): عدد {
    طابق ش مع
    | [] -> { أرجع 0; }
    | [س, بقية الذيل] -> { أرجع س + مجموع_الشريحة(الذيل); };
}

عرف طول_الوسط(م: متجه عدد): عدد {
    طابق م مع
    | [_, بقية الوسط, _] -> { أرجع الطول(الوسط) مثل عدد; }
    | _ -> { أرجع 0; };
}

عرف بقية_البدائل(م: متجه عدد): عدد {
    طابق م مع
    | [0, بقية ب] | [1, بقية ب] -> { أرجع مجموع(ب); }
    | _ -> { أرجع 0; };
}

عرف المقدمة_والأخير(م: متجه عدد): عدد {
    طابق م مع
    | [بقية المقدمة, الأخير] -> { أرجع الأخير + 10 * (الطول(المقدمة) مثل عدد); }
    | [] -> { أرجع 0; };
}

عرف محروس(م: متجه عدد): عدد {
    طابق م مع
    | [س, بقية _] إذا س > 5 -> { أرجع 1; }
    | [_, بقية _] -> { أرجع 2; }
    | [] -> { أرجع 3; };
}

عرف أول_موجود(م: متجه اختياري عدد): عدد {
    طابق م مع
    | [اختياري.موجود(ن), بقية _] | [_, اختياري.موجود(ن), بقية _] -> { أرجع ن; }
    | _ -> { أرجع 0; };
}

عرف زوج_الشريحة(ش: [] عدد): عدد {
    طابق ش مع
    | [أ, ب, بقية _] -> { أرجع أ * ب; }
    | _ -> { أرجع 0; };
}

عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }

عرف أسماء(ف: عدد): متجه نص {
    ليكن م: متغير متجه نص = [];
    ألحق(م, نص_من(ف));
    ألحق(م, نص_من(ف + 1));
    ألحق(م, نص_من(ف + 2));
    أرجع م;
}

عرف عناصر_مملوكة(م: متجه نص): عدد {
    طابق م مع
    | [أ, ب, بقية _] -> { أرجع (الطول(أ) مثل عدد) + (الطول(ب) مثل عدد); }
    | [أ] -> { أرجع الطول(أ) مثل عدد; }
    | [] -> { أرجع 0; };
}

// بقية عناصر تملك تخزينا: عروض لنصوص المتجه.
عرف الطول_الكلي(ش: [] نص): عدد {
    ليكن المجموع: متغير عدد = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ش) مثل طبيعي)) {
        المجموع := المجموع + (الطول(ش[ف]) مثل عدد);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف بقية_الأسماء(م: متجه نص): عدد {
    طابق م مع
    | [_, بقية الذيل] -> { أرجع الطول_الكلي(الذيل); }
    | [] -> { أرجع 0; };
}

عرف بقية_مستعارة(م: &متجه نص): عدد {
    طابق *م مع
    | [الأول, بقية الذيل] -> { أرجع (الطول(الأول) مثل عدد) + الطول_الكلي(الذيل); }
    | [] -> { أرجع 0; };
}

عرف بقية_مؤقتة(ف: عدد): عدد {
    طابق أسماء(ف) مع
    | [_, بقية الذيل] -> { أرجع الطول_الكلي(الذيل); }
    | [] -> { أرجع 0; };
}

عرف عناصر_مستعارة(م: &متجه نص): عدد {
    طابق *م مع
    | [بقية _, الأخير] -> { أرجع الطول(الأخير) مثل عدد; }
    | [] -> { أرجع 0; };
}

عرف عناصر_مؤقتة(ف: عدد): عدد {
    طابق أسماء(ف) مع
    | [الأول, بقية _] -> { أرجع الطول(الأول) مثل عدد; }
    | [] -> { أرجع 0; };
}

عرف جولات(): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 100) {
        المجموع := المجموع + عناصر_مملوكة(أسماء(ف));
        ليكن المحفوظة: متجه نص = أسماء(ف);
        المجموع := المجموع + عناصر_مستعارة(&المحفوظة);
        المجموع := المجموع + عناصر_مؤقتة(ف);
        المجموع := المجموع + بقية_الأسماء(أسماء(ف)) - 14;
        المجموع := المجموع + بقية_مستعارة(&المحفوظة) - 21;
        المجموع := المجموع + بقية_مؤقتة(ف) - 14;
        ليكن الأعداد: متجه عدد = [ف, 1, 2, 3];
        المجموع := المجموع + الرأس_والبقية(استنسخ(&الأعداد)) - ف;
        المجموع := المجموع + البقية_في_حلقة(استنسخ(&الأعداد)) - 18;
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    ليكن فارغ: متجه عدد = [];
    ليكن واحد: متجه عدد = [7];
    ليكن اثنان: متجه عدد = [3, 4];
    ليكن كثير: متجه عدد = [1, 2, 3, 9];
    إذا (صف_المتجه(استنسخ(&فارغ)) != 0 || صف_المتجه(استنسخ(&واحد)) != 7 || صف_المتجه(استنسخ(&اثنان)) != 7 || صف_المتجه(استنسخ(&كثير)) != 109) { أرجع 1; };
    إذا (الرأس_والبقية(استنسخ(&كثير)) != 141 || الرأس_والبقية(استنسخ(&فارغ)) != 0) { أرجع 2; };
    إذا (المقدمة_والأخير(استنسخ(&كثير)) != 39 || المقدمة_والأخير(استنسخ(&واحد)) != 7) { أرجع 3; };
    إذا (محروس(استنسخ(&واحد)) != 1 || محروس(استنسخ(&اثنان)) != 2 || محروس(استنسخ(&فارغ)) != 3) { أرجع 4; };
    ليكن موجود_أولا: متجه اختياري عدد = [اختياري.موجود(5), اختياري.لا_شيء()];
    ليكن موجود_ثانيا: متجه اختياري عدد = [اختياري.لا_شيء(), اختياري.موجود(6)];
    ليكن لا_موجود: متجه اختياري عدد = [اختياري.لا_شيء()];
    إذا (أول_موجود(استنسخ(&موجود_أولا)) != 5 || أول_موجود(استنسخ(&موجود_ثانيا)) != 6 || أول_موجود(استنسخ(&لا_موجود)) != 0) {
        أرجع 5;
    };
    إذا (زوج_الشريحة(استنسخ(&كثير)) != 2 || زوج_الشريحة(استنسخ(&واحد)) != 0) { أرجع 6; };
    إذا (البقية_في_حلقة(استنسخ(&كثير)) != 42 || البقية_في_حلقة(استنسخ(&فارغ)) != 0) { أرجع 10; };
    ليكن صفر_أولا: متجه عدد = [0, 5, 6];
    ليكن واحد_أولا: متجه عدد = [1, 7];
    إذا (طول_الوسط(استنسخ(&كثير)) != 2 || طول_الوسط(استنسخ(&واحد)) != 0) { أرجع 11; };
    إذا (بقية_البدائل(استنسخ(&صفر_أولا)) != 11 || بقية_البدائل(استنسخ(&واحد_أولا)) != 7 || بقية_البدائل(استنسخ(&اثنان)) != 0) {
        أرجع 12;
    };
    // عروض ذاكرة المتجه لا تخصص شيئا.
    ليكن قبل: ط64 = عدد_تخصيصات_النظام();
    إذا (مجموع_الشريحة(كثير) != 15 || مجموع_الشريحة(فارغ) != 0) { أرجع 13; };
    إذا (عدد_تخصيصات_النظام() != قبل) { أرجع 14; };
    ليكن ر: عدد = جولات();
    إذا (ر != 100 * (14 + 7 + 7 + 60)) { أرجع 7; };
    ليكن التخصيصات: ط64 = عدد_تخصيصات_النظام();
    ليكن التحريرات: ط64 = عدد_تحريرات_النظام();
    إذا (جولات() != ر) { أرجع 8; };
    ليكن المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
    ليكن المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
    إذا (المخصص != 0 && المحرر + 8 < المخصص) { أرجع 9; };
    أرجع 42;
}
