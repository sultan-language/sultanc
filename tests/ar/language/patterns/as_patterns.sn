// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/as_patterns.sn
// `نمط مثل اسم` يسمي القيمة كلها التي يطابقها النمط: حول حالة ذات حمولة، وحول
// نمط ذي بدائل (`مثل` أضعف ارتباطا، والأقواس تجمع)، وداخل صف، وعلى قيم
// مملوكة. الاسم المالك حول نمط لا يربط جزءا مالكا يأخذ القيمة كلها؛ والذراع
// الذي سيحمل تخزينا مملوكا واحدا مرتين (اسم مالك حول جزء مالك) يستعير مميزه
// بدلا من ذلك، فيكون الاسمان عرضين ويحتفظ المميز بقيمته (وتبين عدادات المخصص
// أن شيئا لا يبقى خلفها).
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع يد = | حجر | ورق | مقص;
نوع شكل = | دائرة بنوع عدد | مربع بنوع عدد;
نوع مسمى = | واحد بنوع نص | اثنان بنوع (نص, نص);
نوع عنصر = { الاسم: نص, الرقم: عدد };

عرف رمز_اليد(ي: يد): عدد {
    طابق ي مع
    | يد.حجر -> { أرجع 1; }
    | يد.ورق -> { أرجع 2; }
    | يد.مقص -> { أرجع 3; };
}

عرف ضلع(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(نق) مثل د -> { أرجع نق + مساحة(د); }
    | شكل.مربع(ن) مثل م -> { أرجع ن + مساحة(م); };
}

عرف مساحة(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(نق) -> { أرجع 3 * نق * نق; }
    | شكل.مربع(ن) -> { أرجع ن * ن; };
}

عرف لين(ي: يد): عدد {
    طابق ي مع
    | يد.حجر | يد.ورق مثل س -> { أرجع 10 + رمز_اليد(س); }
    | (يد.مقص) مثل ص -> { أرجع 20 + رمز_اليد(ص); };
}

عرف الأول(ز: (شكل, عدد)): عدد {
    طابق ز مع
    | (شكل.دائرة(_) مثل د, ن) -> { أرجع مساحة(د) + ن; }
    | (ق, _) -> { أرجع مساحة(ق); };
}

عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }
عرف خذ_المسمى(م: مسمى): عدد {
    طابق م مع
    | مسمى.واحد(ن) -> { أرجع الطول(ن) مثل عدد; }
    | مسمى.اثنان(أ, ب) -> { أرجع (الطول(أ) مثل عدد) + (الطول(ب) مثل عدد); };
}

// الاسم يملك القيمة كلها: ينقلها.
عرف كلها(م: مسمى): عدد {
    طابق م مع
    | مسمى.واحد(_) مثل الكل -> { أرجع خذ_المسمى(الكل); }
    | مسمى.اثنان(_, _) مثل الكل -> { أرجع خذ_المسمى(الكل); };
}

// الاسم والجزء سيملكان تخزينا واحدا: الذراع يستعير.
عرف كلاهما(م: مسمى): عدد {
    طابق م مع
    | مسمى.اثنان(أ, _) مثل الكل -> { أرجع (الطول(أ) مثل عدد) + خذ_عرضا(&الكل); }
    | مسمى.واحد(ن مثل ت) -> { أرجع (الطول(ن) مثل عدد) + (الطول(ت) مثل عدد); };
}

عرف خذ_عرضا(م: &مسمى): عدد {
    طابق *م مع
    | مسمى.واحد(_) -> { أرجع 1; }
    | مسمى.اثنان(_, _) -> { أرجع 2; };
}

عرف سجل(ف: عدد): عدد {
    ليكن ع: عنصر = { الاسم: نص_من(ف), الرقم: 3 };
    طابق ع مع
    | { الاسم: ن, الرقم: 3 } مثل ر -> { أرجع (الطول(ن) مثل عدد) + ر.الرقم; }
    | _ -> { أرجع 0; };
}

عرف جولات(): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 100) {
        المجموع := المجموع + كلها(مسمى.اثنان(نص_من(ف), نص_من(ف)));
        المجموع := المجموع + كلاهما(مسمى.اثنان(نص_من(ف), نص_من(ف)));
        المجموع := المجموع + كلاهما(مسمى.واحد(نص_من(ف)));
        المجموع := المجموع + سجل(ف);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    إذا (ضلع(شكل.دائرة(2)) != 14 || ضلع(شكل.مربع(3)) != 12) { أرجع 1; };
    إذا (لين(يد.حجر()) != 11 || لين(يد.ورق()) != 12 || لين(يد.مقص()) != 23) { أرجع 2; };
    إذا (الأول((شكل.دائرة(1), 4)) != 7 || الأول((شكل.مربع(2), 4)) != 4) { أرجع 3; };
    إذا (كلها(مسمى.واحد(نص_من(1))) != 7) { أرجع 4; };
    إذا (جولات() != 4700) { أرجع 5; };
    ليكن التخصيصات: ط64 = عدد_تخصيصات_النظام();
    ليكن التحريرات: ط64 = عدد_تحريرات_النظام();
    إذا (جولات() != 4700) { أرجع 6; };
    ليكن المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
    ليكن المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
    إذا (المخصص != 0 && المحرر + 8 < المخصص) { أرجع 7; };
    أرجع 42;
}
