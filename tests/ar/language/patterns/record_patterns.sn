// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/record_patterns.sn
// أنماط السجلات: تُطابق الحقول المكتوبة وحدها، واختصار الحقل (`{ العرض }` يربط
// الحقل باسم يُكتب مثله)، وكلاهما معا، داخل الحمولات والبدائل والأذرع
// المحروسة.
نوع مقاس = { العرض: عدد, الارتفاع: عدد, العمق: عدد };
نوع علبة = | مسطحة بنوع مقاس | فارغة;

عرف المساحة(م: مقاس): عدد {
    طابق م مع
    | { العرض, الارتفاع } -> { أرجع العرض * الارتفاع; };
}

عرف عريض(م: مقاس): عدد {
    طابق م مع
    | { العرض: ع } إذا ع > 10 -> { أرجع ع; }
    | { العرض, الارتفاع: ر, العمق } -> { أرجع العرض + ر + العمق; };
}

عرف مسطح(ع: علبة): عدد {
    طابق ع مع
    | علبة.مسطحة({ العمق: 0, العرض }) | علبة.مسطحة({ العرض, العمق: 1 }) -> { أرجع العرض; }
    | علبة.مسطحة({ العمق }) -> { أرجع العمق; }
    | علبة.فارغة -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن أ: مقاس = { العرض: 3, الارتفاع: 4, العمق: 5 };
    ليكن ب: مقاس = { العرض: 20, الارتفاع: 1, العمق: 1 };
    ليكن ج: مقاس = { العرض: 7, الارتفاع: 0, العمق: 0 };
    ليكن د: مقاس = { العرض: 8, الارتفاع: 0, العمق: 1 };
    ليكن هـ: مقاس = { العرض: 9, الارتفاع: 0, العمق: 6 };
    إذا (المساحة(أ) != 12) { أرجع 1; };
    إذا (عريض(ب) != 20 || عريض(أ) != 12) { أرجع 2; };
    إذا (مسطح(علبة.مسطحة(ج)) != 7 || مسطح(علبة.مسطحة(د)) != 8 || مسطح(علبة.مسطحة(هـ)) != 6) { أرجع 3; };
    إذا (مسطح(علبة.فارغة()) != 0) { أرجع 4; };
    أرجع 42;
}
