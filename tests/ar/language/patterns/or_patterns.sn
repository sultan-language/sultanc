// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/or_patterns.sn
// بدائل الأنماط من أي صنف، في رأس الذراع ومتداخلة: حالات التعداد،
// والحالات ذات الحمولات، والصفوف والسجلات التي تربط بدائلها الأسماء نفسها،
// وبدائل داخل حمولة داخل صف، وحمولات مملوكة تربطها البدائل (تُتلف أجزاء
// البديل المطابق غير المربوطة؛ وتبين عدادات المخصص أن شيئا لا يبقى خلفها).
استورد المكتبة.نظام_التشغيل.تخصيص;
استورد المكتبة.نصوص.أعداد;

نوع يد = | حجر | ورق | مقص;
نوع شكل = | دائرة بنوع عدد | مربع بنوع عدد | نقطة | خط بنوع (عدد, عدد);
نوع موضع = { س: عدد, ص: عدد };
نوع مسمى = | واحد بنوع نص | اثنان بنوع (نص, نص) | لا_أحد;

عرف لين(ي: يد): عدد {
    طابق ي مع
    | يد.حجر | يد.ورق -> { أرجع 1; }
    | يد.مقص -> { أرجع 2; };
}

عرف قس(ش: شكل): عدد {
    طابق ش مع
    | شكل.دائرة(0) | شكل.نقطة -> { أرجع 1; }
    | شكل.دائرة(نق) | شكل.مربع(نق) | شكل.خط(نق, _) -> { أرجع نق; };
}

عرف محور(ز: (عدد, عدد)): عدد {
    طابق ز مع
    | (0, ق) | (ق, 0) -> { أرجع ق; }
    | _ -> { أرجع 0; };
}

عرف متداخل(ق: (اختياري شكل, عدد)): عدد {
    طابق ق مع
    | (اختياري.موجود(شكل.دائرة(ن) | شكل.مربع(ن)), 1 | 2) -> { أرجع ن; }
    | (اختياري.موجود(شكل.نقطة | شكل.خط(_, _)), _) -> { أرجع 3; }
    | (اختياري.موجود(_), _) -> { أرجع 4; }
    | (اختياري.لا_شيء, ك) -> { أرجع ك; };
}

عرف على_محور(م: موضع): عدد {
    طابق م مع
    | { س: 0, ص: ق } | { س: ق, ص: 0 } -> { أرجع ق; }
    | _ -> { أرجع 100; };
}

عرف نص_من(ف: عدد): نص { أرجع عدد_إلى_نص(1000000 + ف); }

عرف حجم_الاسم(م: مسمى): عدد {
    طابق م مع
    | مسمى.واحد(ن) | مسمى.اثنان(ن, _) -> { أرجع الطول(ن) مثل عدد; }
    | مسمى.لا_أحد -> { أرجع 0; };
}

عرف حجم_الثاني(م: مسمى): عدد {
    طابق م مع
    | مسمى.اثنان(_, ن) | مسمى.واحد(ن) -> { أرجع الطول(ن) مثل عدد; }
    | مسمى.لا_أحد -> { أرجع 0; };
}

عرف جولات_مملوكة(): عدد {
    ليكن ف: متغير عدد = 0;
    ليكن المجموع: متغير عدد = 0;
    طالما (ف < 100) {
        المجموع := المجموع + حجم_الاسم(مسمى.اثنان(نص_من(ف), نص_من(ف + 1)));
        المجموع := المجموع + حجم_الاسم(مسمى.واحد(نص_من(ف)));
        المجموع := المجموع + حجم_الثاني(مسمى.اثنان(نص_من(ف), نص_من(ف + 1)));
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    إذا (لين(يد.حجر()) + لين(يد.ورق()) + لين(يد.مقص()) != 4) { أرجع 1; };
    إذا (قس(شكل.دائرة(0)) != 1 || قس(شكل.نقطة()) != 1) { أرجع 2; };
    إذا (قس(شكل.دائرة(5)) != 5 || قس(شكل.مربع(6)) != 6 || قس(شكل.خط(7, 9)) != 7) {
        أرجع 3;
    };
    إذا (محور((0, 8)) != 8 || محور((9, 0)) != 9 || محور((1, 1)) != 0) { أرجع 4; };
    إذا (متداخل((اختياري.موجود(شكل.دائرة(11)), 2)) != 11) { أرجع 5; };
    إذا (متداخل((اختياري.موجود(شكل.مربع(12)), 3)) != 4) { أرجع 6; };
    إذا (متداخل((اختياري.موجود(شكل.نقطة()), 1)) != 3) { أرجع 7; };
    إذا (متداخل((اختياري.لا_شيء(), 13)) != 13) { أرجع 8; };
    ليكن م1: موضع = { س: 0, ص: 14 };
    ليكن م2: موضع = { س: 15, ص: 0 };
    ليكن م3: موضع = { س: 1, ص: 1 };
    إذا (على_محور(م1) != 14 || على_محور(م2) != 15 || على_محور(م3) != 100) { أرجع 9; };
    إذا (حجم_الاسم(مسمى.لا_أحد()) != 0) { أرجع 10; };
    إذا (جولات_مملوكة() != 2100) { أرجع 11; };
    ليكن التخصيصات: ط64 = عدد_تخصيصات_النظام();
    ليكن التحريرات: ط64 = عدد_تحريرات_النظام();
    إذا (جولات_مملوكة() != 2100) { أرجع 12; };
    ليكن المخصص: ط64 = عدد_تخصيصات_النظام() - التخصيصات;
    ليكن المحرر: ط64 = عدد_تحريرات_النظام() - التحريرات;
    // مع مخصص std تخصص كل جولة وتحرر بالقدر نفسه.
    إذا (المخصص != 0 && المحرر + 8 < المخصص) { أرجع 13; };
    أرجع 42;
}
