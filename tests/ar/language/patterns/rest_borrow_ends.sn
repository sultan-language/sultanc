// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/patterns/rest_borrow_ends.sn
// البقية المسماة في `طابق م` تستعير م ما دامت مستعملة فقط: يجوز أن تُقرأ م بجانبها،
// وأن تُغيَّر بعد آخر استعمال للبقية، في الذراع أو بعد المطابقة.
عرف الرئيسية(): عدد {
    ليكن م: متغير متجه عدد = [1، 2، 3];
    ليكن الناتج: متغير عدد = 0;
    طابق م مع
    | [_، بقية الذيل] -> {
        ليكن الأول: عدد = م[0];
        الناتج := الذيل[0] + الأول;
        ألحق(م، 4);
    }
    | [] -> { };
    م[0] := 30;
    إذا (الطول(م) != 4 || م[3] != 4) { أرجع 1; };
    أرجع الناتج + 39;
}
