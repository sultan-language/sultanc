// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/optimization/strength_reduction.sn
// تخفيف العمليات الصحيحة وإزالة الفحوص بالمدى (docs/ar/internals/msir-and-codegen.md)
// تحفظ كل ناتج: باقي القسمة على قوة لاثنين مقارنًا بالصفر بالإشارتين، والباقي بلا إشارة
// قناعًا، والباقي بعد ناتج القسمة على ثابت، وحلقات وتفرعات تثبت مقارنةٌ مهيمنة جمعها
// وطرحها، حتى حدود النوع.
عرف زوجي(س: ص64): منطقي { أرجع س % 2 == 0; }
عرف ليس_مضاعف_ثمانية(س: ص32): منطقي { أرجع س % 8 != 0; }
عرف البتات_الدنيا(س: ط64): ط64 { أرجع س % 16; }
عرف قسّم(س: ص64, د: [] ص64): ص64 {
    ليكن ق: ص64 = س / 3;
    ليكن ب: ص64 = س % 3;
    ليكن ق2: ص64 = س / -7;
    ليكن ب2: ص64 = س % -7;
    إذا (ق * 3 + ب != س || ق2 * -7 + ب2 != س) { أرجع 1; };
    أرجع ق + ب + ق2 + ب2 + د[0];
}
عرف قسّم_طبيعيا(س: ط64): ط64 {
    ليكن ق: ط64 = س / 10;
    ليكن ب: ط64 = س % 10;
    أرجع ق * 10 + ب;
}
عرف عد_إلى(ن: ص64): ص64 {
    ليكن ع: متغير ص64 = 0;
    ليكن الخطوات: متغير ص64 = 0;
    طالما (ع < ن) {
        ع := ع + 1;
        الخطوات := الخطوات + 1;
        إذا (الخطوات > 3) { ع := ن; };
    }
    أرجع ع;
}
عرف تنازل_من(ن: ص64): ص64 {
    إذا (ن < 2) { أرجع ن; };
    أرجع ن - 1;
}
عرف الرئيسية(): عدد {
    ليكن القيم: متجه ص64 = [-9, -8, 7, 0, 9223372036854775807, -9223372036854775807 - 1, 1];
    ليكن الضيقة: متجه ص32 = [-16, -15, 2147483647, -2147483647 - 1];
    ليكن الواسعة: متجه ط64 = [18446744073709551615, 17, 0];
    إذا (زوجي(القيم[0]) || !زوجي(القيم[1]) || زوجي(القيم[2]) || !زوجي(القيم[3])) { أرجع 1; };
    إذا (زوجي(القيم[4]) || !زوجي(القيم[5])) { أرجع 2; };
    إذا (ليس_مضاعف_ثمانية(الضيقة[0]) || !ليس_مضاعف_ثمانية(الضيقة[1]) || !ليس_مضاعف_ثمانية(الضيقة[2]) || ليس_مضاعف_ثمانية(الضيقة[3])) { أرجع 3; };
    إذا (البتات_الدنيا(الواسعة[0]) != 15 || البتات_الدنيا(الواسعة[1]) != 1 || البتات_الدنيا(الواسعة[2]) != 0) { أرجع 4; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 7) {
        إذا (قسّم(القيم[ف], القيم) == 1 && القيم[ف] != 1) { أرجع 5; };
        ف := ف + 1;
    }
    إذا (قسّم_طبيعيا(الواسعة[0]) != الواسعة[0] || قسّم_طبيعيا(الواسعة[1]) != 17) { أرجع 6; };
    إذا (عد_إلى(القيم[4]) != القيم[4] || عد_إلى(القيم[2]) != 7 || عد_إلى(القيم[5]) != 0) { أرجع 7; };
    إذا (تنازل_من(القيم[5]) != القيم[5] || تنازل_من(القيم[4]) != 9223372036854775806 || تنازل_من(القيم[6]) != 1) { أرجع 8; };
    أرجع 42;
}
