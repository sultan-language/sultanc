// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/optimization/msir_pipeline.sn
// ما يعيد خط تحسين MSIR (compiler/msir/msir_optimization_pipeline.sn) كتابته
// يحتفظ بمعناه تحت `run` وفي الملفات التنفيذية سواء: دالة صغيرة تُضمَّن مع
// ثابت للمعامل الذي تختبره، ومتغير محلي مملوك يُنقل على بعض المسارات فقط
// (علم إسقاطه معامل كتلة تمرر له المسارات الأخرى كلها خطأ)، وحساب بتي غير
// مستخدم، وحلقة معاملاتها نسخ لقيمة واحدة.

عرف اختر(ك: عدد, أ: عدد, ب: عدد): عدد {
    إذا (ك == 0) { أرجع أ; };
    إذا (ك == 1) { أرجع ب; };
    أرجع أ + ب;
}

عرف استهلك(م: متجه عدد): عدد { أرجع الطول(م) مثل عدد; }

عرف مملوء(ن: عدد): متجه عدد {
    دع م: متغير متجه عدد = [];
    دع ف: متغير عدد = 0;
    طالما (ف < ن) { ألحق(م, ف); ف := ف + 1; }
    أرجع م;
}

// ينقل المتجه حين يكون خذ صوابًا فقط؛ وإلا أُسقط في النهاية.
عرف خذ_ربما(خذ: منطقي, ن: عدد): عدد {
    دع م: متجه عدد = مملوء(ن);
    دع غير_مستخدم: عدد = (ن & 255) | 3;
    إذا (خذ) { أرجع استهلك(م); };
    أرجع 1;
}

عرف الرئيسية(): عدد {
    دع المجموع: متغير عدد = 0;
    دع الثابت: عدد = 5;
    دع ف: متغير عدد = 0;
    طالما (ف < 4) {
        // الثابت والثابت 0 يعبران الحلقة دون تغيير.
        المجموع := المجموع + اختر(0, الثابت, 100) - الثابت;
        المجموع := المجموع + اختر(1, 0, 2);
        ف := ف + 1;
    }
    المجموع := المجموع + اختر(2, 3, 4);
    المجموع := المجموع + خذ_ربما(صواب, 10) + خذ_ربما(خطأ, 10);
    المجموع := المجموع + خذ_ربما(صواب, 16);
    أرجع المجموع;
}
