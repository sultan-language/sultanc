// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/language/optimization/machine_jump_through_folded_branch.sn
// محسن مفسر الآلة (compiler/interpreter/machine/machine_optimizer.sn) يبقي قفزة
// تبلغها شفرة أخرى عبر تفرع على ثابت حذفه. حين تُضمَّن أبق_أو_خذ مع صواب ثابت يصير
// علم إسقاط المتجه خطأ ثابتًا: الكتلة التي تحرر مخزن المتجه تقفز إلى اختبار ذلك العلم،
// وهو لا يقفز أبدًا فيُحذف، فالقفزة بعده هي طريق تلك الكتلة إلى الإرجاع. قلب التفرع
// الذي قبل القفزة (`تفرع س; اقفز ص; س:` إلى `تفرع-بالنفي ص; س:`) كان يحذف تلك القفزة،
// فتقفز الكتلة إلى نفسها وتحرر المخزن بلا نهاية.

عرف استهلك(م: متجه عدد): عدد { أرجع الطول(م) مثل عدد; }

عرف مملوء(ن: عدد): متجه عدد {
    دع م: متغير متجه عدد = [];
    دع ف: متغير عدد = 0;
    طالما (ف < ن) { ألحق(م, ف); ف := ف + 1; }
    أرجع م;
}

عرف أبق_أو_خذ(خذ: منطقي, ن: عدد): عدد {
    دع م: متجه عدد = مملوء(ن);
    إذا (خذ) { أرجع استهلك(م); };
    أرجع 1;
}

عرف الرئيسية(): عدد {
    دع المجموع: متغير عدد = أبق_أو_خذ(صواب, 10);
    المجموع := المجموع + أبق_أو_خذ(صواب, 0);
    دع ف: متغير عدد = 0;
    طالما (ف < 3) { المجموع := المجموع + أبق_أو_خذ(صواب, ف + 4); ف := ف + 1; }
    أرجع المجموع + أبق_أو_خذ(خطأ, 5) + 16;
}
