// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/language/optimization/unoptimized_reference_locals.sn
// Scalar locals that are not promotable, read after they are reassigned:
// a reference to another local bound once, reassigned in a branch, in a match
// arm and in a loop, a `&mutable` reference written through after it is
// reassigned, a reference given a global's address and then a local's, a
// slice view reassigned, and a character given a constant and then another
// local's value. The runner also builds this program with the LLVM backend at
// -O0 (tests/runner/suites/cli.sn,
// اختبر_مراجع_محلية_بإل_إل_في_إم_دون_تحسين), where every local stays in its
// frame slot.

نوع خيار = | الأول | الثاني;

ليكن الأوليات: متجه عدد = [2, 3, 5, 7];

عرف مرة(): عدد {
    ليكن أ: عدد = 3;
    ليكن ب: عدد = 8;
    ليكن ر: &عدد = &أ;
    أرجع *ر + ب;
}

عرف اختر(ش: منطقي): عدد {
    ليكن أ: عدد = 40;
    ليكن ب: عدد = 42;
    ليكن ر: متغير &عدد = &أ;
    إذا (ش) {
        ر := &ب;
    };
    أرجع *ر;
}

عرف بالاختيار(ك: خيار): عدد {
    ليكن أ: عدد = 1;
    ليكن ب: عدد = 6;
    ليكن ر: متغير &عدد = &أ;
    طابق ك مع
    | خيار.الأول -> { }
    | خيار.الثاني -> { ر := &ب; };
    أرجع *ر;
}

عرف في_حلقة(ن: عدد): عدد {
    ليكن أ: عدد = 2;
    ليكن ب: عدد = 3;
    ليكن ر: متغير &عدد = &أ;
    ليكن المجموع: متغير عدد = 0;
    ليكن م: متغير عدد = 0;
    طالما (م < ن) {
        المجموع := المجموع + *ر;
        ر := &ب;
        م := م + 1;
    }
    أرجع المجموع;
}

عرف اكتب_عبره(ش: منطقي): عدد {
    ليكن أ: متغير عدد = 1;
    ليكن ب: متغير عدد = 2;
    ليكن ر: متغير &متغير عدد = &متغير أ;
    إذا (ش) {
        ر := &متغير ب;
    };
    *ر := *ر + 4;
    أرجع أ * 10 + ب;
}

عرف من_عام(ش: منطقي): عدد {
    ليكن قيمي: متجه عدد = [9, 1];
    ليكن ر: متغير &متجه عدد = &الأوليات;
    ر := &قيمي;
    إذا (ش) {
        ر := &الأوليات;
    };
    أرجع (*ر)[0];
}

عرف عرض_شريحة(ش: منطقي): عدد {
    ليكن الأول: متغير متجه عدد = [1, 2];
    ليكن الثاني: متغير متجه عدد = [7, 8];
    ليكن ع: متغير [] عدد = &متغير الأول;
    إذا (ش) {
        ع := &متغير الثاني;
    };
    أرجع ع[0];
}

عرف حرف_بعد_إسناد(ش: منطقي): عدد {
    ليكن ن: حرف = 'n';
    ليكن ح: متغير حرف = 'a';
    ح := ن;
    إذا (ش) {
        ح := 'z';
    };
    أرجع (ح مثل ط32) مثل عدد;
}

عرف الرئيسية(): عدد {
    ليكن الأخطاء: متغير عدد = 0;
    إذا (مرة() != 11) { الأخطاء := الأخطاء + 1; };
    إذا (اختر(صواب) != 42 || اختر(خطأ) != 40) { الأخطاء := الأخطاء + 1; };
    إذا (بالاختيار(خيار.الأول()) != 1 || بالاختيار(خيار.الثاني()) != 6) { الأخطاء := الأخطاء + 1; };
    إذا (في_حلقة(3) != 8) { الأخطاء := الأخطاء + 1; };
    إذا (اكتب_عبره(صواب) != 16 || اكتب_عبره(خطأ) != 52) { الأخطاء := الأخطاء + 1; };
    إذا (من_عام(خطأ) != 9 || من_عام(صواب) != 2) { الأخطاء := الأخطاء + 1; };
    إذا (عرض_شريحة(خطأ) != 1 || عرض_شريحة(صواب) != 7) { الأخطاء := الأخطاء + 1; };
    إذا (حرف_بعد_إسناد(خطأ) != 110 || حرف_بعد_إسناد(صواب) != 122) { الأخطاء := الأخطاء + 1; };
    أرجع 42 - الأخطاء;
}
