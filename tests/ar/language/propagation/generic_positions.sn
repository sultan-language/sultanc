// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// مرحلة0: نعم
// نظير: tests/en/language/propagation/generic_positions.sn
// `؟` داخل الدوال العامة في كل مواضعه: تهيئة `دع`، والإسناد، والإرجاع، وعبارة
// التعبير، وكل منها داخل أجسام لو وطالما وطابق، على نتيجة وعلى اختياري. كل
// مثيل لدالة عامة يخفض التوسيع بأنواعه.
عرف افحص<ن>(س: &ن, سليم: منطقي, ع: عدد): نتيجة عدد, عدد {
    لو (سليم) { أرجع نتيجة.نجح(ع); };
    أرجع نتيجة.خطأ(7);
}

عرف غلف<ن>(س: &ن, سليم: منطقي): نتيجة نتيجة عدد, عدد, عدد {
    أرجع نتيجة.نجح(افحص(س, سليم, 5));
}

عرف اختر<ن>(س: &ن, سليم: منطقي): اختياري عدد {
    لو (سليم) { أرجع اختياري.موجود(4); };
    أرجع اختياري.لا_شيء();
}

عرف موضع_التهيئة<ن>(س: &ن, سليم: منطقي): نتيجة عدد, عدد {
    دع ق: عدد = افحص(س, سليم, 5)؟;
    أرجع نتيجة.نجح(ق);
}

عرف موضع_الإسناد<ن>(س: &ن, سليم: منطقي): نتيجة عدد, عدد {
    دع ق: متغير عدد = 0;
    ق := افحص(س, سليم, 5)؟;
    أرجع نتيجة.نجح(ق);
}

عرف موضع_الإرجاع<ن>(س: &ن, سليم: منطقي): نتيجة عدد, عدد {
    أرجع غلف(س, سليم)؟;
}

عرف موضع_العبارة<ن>(س: &ن, سليم: منطقي): نتيجة عدد, عدد {
    افحص(س, سليم, 0)؟;
    أرجع نتيجة.نجح(1);
}

عرف متداخل<ن>(س: &ن, سليم: منطقي, ع: عدد): نتيجة عدد, عدد {
    دع العدد: متغير عدد = 0;
    لو (ع > 0) {
        افحص(س, سليم, 0)؟;
        العدد := العدد + 1;
    } وإلا {
        دع و: عدد = افحص(س, سليم, 0)؟;
        العدد := العدد + و;
    };
    دع ف: متغير عدد = 0;
    طالما (ف < ع) {
        موضع_العبارة(س, سليم)؟;
        العدد := العدد + 1;
        ف := ف + 1;
    }
    طابق ع مع
    | 3 -> {
        دع الزائد: عدد = موضع_العبارة(س, سليم)؟;
        العدد := العدد + الزائد;
    }
    | _ -> { };
    أرجع نتيجة.نجح(العدد);
}

عرف مواضع_الاختياري<ن>(س: &ن, سليم: منطقي): اختياري عدد {
    دع أ: عدد = اختر(س, سليم)؟;
    اختر(س, صواب)؟;
    دع ب: متغير عدد = 0;
    ب := اختر(س, صواب)؟;
    أرجع اختياري.موجود(أ + ب);
}

عرف رمز(ر: نتيجة عدد, عدد): عدد {
    طابق ر مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(خ) -> { أرجع 0 - خ; };
}

عرف الرئيسية(): عدد {
    دع ع: عدد = 1;
    دع كلمة: نص = «ك»;
    لو (رمز(موضع_التهيئة(&ع, صواب)) != 5) { أرجع 1; };
    لو (رمز(موضع_التهيئة(&كلمة, خطأ)) != 0 - 7) { أرجع 2; };
    لو (رمز(موضع_الإسناد(&ع, صواب)) != 5) { أرجع 3; };
    لو (رمز(موضع_الإسناد(&كلمة, خطأ)) != 0 - 7) { أرجع 4; };
    لو (رمز(موضع_الإرجاع(&ع, صواب)) != 5) { أرجع 5; };
    لو (رمز(موضع_الإرجاع(&كلمة, خطأ)) != 0 - 7) { أرجع 6; };
    لو (رمز(موضع_العبارة(&كلمة, صواب)) != 1) { أرجع 7; };
    لو (رمز(متداخل(&ع, صواب, 3)) != 5) { أرجع 8; };
    لو (رمز(متداخل(&كلمة, خطأ, 0)) != 0 - 7) { أرجع 9; };
    لو (رمز(متداخل(&كلمة, صواب, 2)) != 3) { أرجع 10; };
    طابق مواضع_الاختياري(&ع, صواب) مع
    | اختياري.موجود(ق) -> { لو (ق != 8) { أرجع 11; }; }
    | اختياري.لا_شيء -> { أرجع 12; };
    طابق مواضع_الاختياري(&كلمة, خطأ) مع
    | اختياري.موجود(_) -> { أرجع 13; }
    | اختياري.لا_شيء -> { };
    أرجع 42;
}
