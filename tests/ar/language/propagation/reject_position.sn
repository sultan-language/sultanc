// اختبار: رفض
// تشخيص: SULTANC-PARSE-SYNTAX
// نظير: tests/en/language/propagation/reject_position.sn
// `؟` is accepted only as the last postfix of a statement's whole right-hand
// side (docs/ERRORS.md); inside a call argument it is an unexpected token.
عرف حلل(س: عدد): نتيجة عدد, نص {
    أرجع نتيجة.نجح(س);
}

عرف مرتين(س: عدد): نتيجة عدد, نص {
    دع ق: عدد = حلل(حلل(س)؟)؟;
    أرجع نتيجة.نجح(ق);
}

عرف الرئيسية(): عدد { أرجع 0; }
