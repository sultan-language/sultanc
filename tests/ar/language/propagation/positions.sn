// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// مرحلة0: نعم
// نظير: tests/en/language/propagation/positions.sn
// The propagation operator `؟` (docs/ERRORS.md) in its four positions: a let
// initializer, an assignment, a return and an expression statement, on a
// result and on an option. The English counterpart spells it `?`.
استورد std.io.println;

عرف حلل(س: عدد): نتيجة عدد, نص {
    لو (س > 0) { أرجع نتيجة.نجح(س); };
    أرجع نتيجة.خطأ(«سالب»);
}

عرف ضاعف(س: عدد): نتيجة عدد, نص {
    دع ق: عدد = حلل(س)؟;
    أرجع نتيجة.نجح(ق * 2);
}

عرف أسند(س: عدد): نتيجة عدد, نص {
    دع ق: متغير عدد = 0;
    ق := حلل(س)؟;
    حلل(س - 3)؟;
    دع محفوظ: نتيجة عدد, نص = حلل(ق - 4);
    محفوظ؟;
    أرجع نتيجة.نجح(ق + 1);
}

عرف غلف(س: عدد): نتيجة نتيجة عدد, نص, نص {
    لو (س > 100) { أرجع نتيجة.خطأ(«كبير»); };
    أرجع نتيجة.نجح(حلل(س));
}

عرف أرجع_الداخل(س: عدد): نتيجة عدد, نص {
    أرجع غلف(س)؟;
}

عرف اختر(س: عدد): اختياري عدد {
    لو (س > 0) { أرجع اختياري.موجود(س); };
    أرجع اختياري.لا_شيء();
}

عرف زد_اختيارا(س: عدد): اختياري عدد {
    دع ق: عدد = اختر(س)؟;
    أرجع اختياري.موجود(ق + 1);
}

عرف رمز_نتيجة(ن: نتيجة عدد, نص): عدد {
    طابق ن مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(خ) -> {
        دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(خ);
        أرجع 0 - 1;
    };
}

عرف رمز_اختيار(ن: اختياري عدد): عدد {
    طابق ن مع
    | اختياري.موجود(ق) -> { أرجع ق; }
    | اختياري.لا_شيء -> { أرجع 0 - 1; };
}

عرف الرئيسية(): عدد {
    لو (رمز_نتيجة(ضاعف(4)) != 8) { أرجع 1; };
    لو (رمز_نتيجة(ضاعف(0)) != 0 - 1) { أرجع 2; };
    لو (رمز_نتيجة(أسند(9)) != 10) { أرجع 3; };
    لو (رمز_نتيجة(أسند(0)) != 0 - 1) { أرجع 4; };
    لو (رمز_نتيجة(أسند(2)) != 0 - 1) { أرجع 5; };
    لو (رمز_نتيجة(أسند(4)) != 0 - 1) { أرجع 6; };
    لو (رمز_نتيجة(أسند(5)) != 6) { أرجع 12; };
    لو (رمز_نتيجة(أرجع_الداخل(7)) != 7) { أرجع 7; };
    لو (رمز_نتيجة(أرجع_الداخل(0)) != 0 - 1) { أرجع 8; };
    لو (رمز_نتيجة(أرجع_الداخل(200)) != 0 - 1) { أرجع 9; };
    لو (رمز_اختيار(زد_اختيارا(6)) != 7) { أرجع 10; };
    لو (رمز_اختيار(زد_اختيارا(0)) != 0 - 1) { أرجع 11; };
    أرجع 42;
}
