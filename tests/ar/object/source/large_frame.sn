// دالة يمتد إطارها على عدة صفحات: تسبر مقدمتها المكدس صفحة صفحة على كل هدف
// له صفحات حراسة (tests/runner/suites/objects.sn، تحقق_مسابر_المكدس).
// التوأم: tests/en/object/source/large_frame.sn.

// 64 و512 و4096 و16384 بايتا.
نوع ثمان_كلمات = { ك1: ط64, ك2: ط64, ك3: ط64, ك4: ط64, ك5: ط64, ك6: ط64, ك7: ط64, ك8: ط64 };
نوع كتلة_صغيرة = { ك1: ثمان_كلمات, ك2: ثمان_كلمات, ك3: ثمان_كلمات, ك4: ثمان_كلمات, ك5: ثمان_كلمات, ك6: ثمان_كلمات, ك7: ثمان_كلمات, ك8: ثمان_كلمات };
نوع صفحة_كاملة = { ك1: كتلة_صغيرة, ك2: كتلة_صغيرة, ك3: كتلة_صغيرة, ك4: كتلة_صغيرة, ك5: كتلة_صغيرة, ك6: كتلة_صغيرة, ك7: كتلة_صغيرة, ك8: كتلة_صغيرة };
نوع أربع_صفحات = { ك1: صفحة_كاملة, ك2: صفحة_كاملة, ك3: صفحة_كاملة, ك4: صفحة_كاملة };

عرف ابن_كلمات(ق: ط64): ثمان_كلمات { أرجع { ك1: ق, ك2: ق, ك3: ق, ك4: ق, ك5: ق, ك6: ق, ك7: ق, ك8: ق }; }
عرف ابن_كتلة(ق: ط64): كتلة_صغيرة {
    ليكن ف: ثمان_كلمات = ابن_كلمات(ق);
    أرجع { ك1: ف, ك2: ف, ك3: ف, ك4: ف, ك5: ف, ك6: ف, ك7: ف, ك8: ف };
}
عرف ابن_صفحة(ق: ط64): صفحة_كاملة {
    ليكن ف: كتلة_صغيرة = ابن_كتلة(ق);
    أرجع { ك1: ف, ك2: ف, ك3: ف, ك4: ف, ك5: ف, ك6: ف, ك7: ف, ك8: ف };
}

عرف واسع(البذرة: ط64): ط64 {
    ليكن الإطار: متغير أربع_صفحات = {
        ك1: ابن_صفحة(البذرة), ك2: ابن_صفحة(البذرة + 1), ك3: ابن_صفحة(البذرة + 2), ك4: ابن_صفحة(البذرة + 3)
    };
    الإطار.ك4.ك8.ك8.ك8 := البذرة * 2;
    أرجع الإطار.ك1.ك1.ك1.ك1 + الإطار.ك4.ك8.ك8.ك8;
}

عرف الرئيسية(): عدد {
    أرجع (واسع(14) % 256) مثل عدد;
}
