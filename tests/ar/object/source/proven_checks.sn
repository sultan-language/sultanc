// حساب مفحوص تثبت مقارنةٌ مهيمنة أنه لا يتجاوز: تقرأ مجموعة الكائنات
// (tests/runner/suites/objects.sn، تحقق_الفحوص_المثبتة) شيفرة MSIR للدالة
// عد_إلى (ع + 1 تحت ع < ن، والعمق - 1 تحت العمق > 0) وللدالة قبل_الاثنين
// (ن - 1 تحت ن >= 2) بحثًا عن كتلة بلاغ (docs/ar/internals/msir-and-codegen.md).
// التوأم: tests/en/object/source/proven_checks.sn.
عرف عد_إلى(ن: ص64, العمق: ص64): ص64 {
    إذا (العمق > 0) { أرجع عد_إلى(ن, العمق - 1); };
    ليكن ع: متغير ص64 = 0;
    طالما (ع < ن) {
        ع := ع + 1;
    }
    أرجع ع;
}

عرف قبل_الاثنين(ن: ص64, العمق: ص64): ص64 {
    إذا (العمق > 0) { أرجع قبل_الاثنين(ن, العمق - 1); };
    إذا (ن < 2) { أرجع ن; };
    أرجع ن - 1;
}

عرف الرئيسية(): عدد {
    ليكن القيم: متجه ص64 = [5, 1];
    أرجع (عد_إلى(القيم[0], القيم[1]) + قبل_الاثنين(القيم[0], القيم[1])) مثل عدد;
}
