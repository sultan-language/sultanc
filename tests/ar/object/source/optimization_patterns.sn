// دوال تنظر فحوص الكائنات في tests/runner/suites/objects.sn
// (تحقق_أنماط_التحسين) في شيفرتها الآلية، لكل منها نمط
// (docs/ar/internals/msir-and-codegen.md). التوأم:
// tests/en/object/source/optimization_patterns.sn.
استورد المكتبة.رياضيات.التفاف;

// جمع وطرح وضرب مفحوصة: عملية واحدة وتفرع على تجاوزها إلى كتلة البلاغ.
عرف اجمع_مفحوصا(أ: ص64, ب: ص64): ص64 { أرجع أ + ب; }
عرف اطرح_واحدا(أ: ص64): ص64 { أرجع أ - 1; }
عرف اضرب_مفحوصا(أ: ص64, ب: ص64): ص64 { أرجع أ * ب; }
عرف اجمع_طبيعيا(أ: ط64, ب: ط64): ط64 { أرجع أ + ب; }

// الثوابت: تعليمة واحدة لكل منها على AArch64 (MOVZ أو MOVN أو ORR لقناع بتات)
// ولا MOVK لنصف كلمة صفري أبدًا.
عرف ثابت_صغير(): ص64 { أرجع 5; }
عرف ثابت_سالب(): ص64 { أرجع -2; }
عرف ثابت_قناع(): ط64 { أرجع 6148914691236517205; }

// التفرعات: تضبط المقارنة الأعلام لتفرعها (CMP #0 ثم B.cond)، واختبار الصفر
// CBZ/CBNZ، واختبار بت واحد TBZ/TBNZ أو TST #1.
عرف عد_تنازليا(ن: ص64): ص64 {
    ليكن ع: متغير ص64 = ن;
    ليكن المجموع: متغير ص64 = 0;
    طالما (ع > 0) {
        المجموع := المجموع + ع;
        ع := ع - 1;
    }
    أرجع المجموع;
}
عرف تفرع_الصفر(س: ص64): ص64 { إذا (س == 0) { أرجع 7; }; أرجع 9; }
عرف البت_الأدنى(س: ط64): ط64 { إذا ((س & 1) == 0) { أرجع 1; }; أرجع 2; }

// تخفيف العمليات: الضرب الملتف في 3 تعليمة LEA على x86-64، و`س % 2 == 0` اختبار
// للبت 0 (AND ثم JE على x86-64، وTBZ أو TST على AArch64).
عرف ثلاثة_أضعاف_ملتفة(س: ص64): ص64 { أرجع ضرب_ص64_ملتف(س, 3); }
عرف زوجي(س: ص64): ص64 { إذا (س % 2 == 0) { أرجع 1; }; أرجع 0; }

عرف الرئيسية(): عدد {
    ليكن القيم: متجه ص64 = [5, 7];
    ليكن الطبيعية: متجه ط64 = [5, 7];
    ليكن المجموع: ص64 = اجمع_مفحوصا(القيم[0], القيم[1]) + اطرح_واحدا(القيم[1]) + اضرب_مفحوصا(القيم[0], القيم[1]);
    ليكن مجموع_طبيعي: ط64 = اجمع_طبيعيا(الطبيعية[0], الطبيعية[1]);
    إذا (مجموع_طبيعي != 12) { أرجع 1; };
    إذا (ثابت_صغير() + ثابت_سالب() != 3) { أرجع 2; };
    إذا (ثابت_قناع() != 6148914691236517205) { أرجع 3; };
    إذا (ثلاثة_أضعاف_ملتفة(القيم[0]) != 15 || زوجي(القيم[1]) != 0) { أرجع 5; };
    إذا (عد_تنازليا(القيم[0]) != 15 || تفرع_الصفر(القيم[0]) != 9 || البت_الأدنى(الطبيعية[0]) != 2) { أرجع 4; };
    أرجع (المجموع % 100) مثل عدد;
}
