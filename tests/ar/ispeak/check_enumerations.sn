// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_enumerations.sn
استورد std.fs.read_file;
استورد std.text.builder;
استورد std.text.from_bytes;
استورد std.text.search;
استورد std.io.print;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.keys.surface;

// The enumerations كل_أسباب_التشخيص, كل_معرفات_التشخيص, كل_مفاتيح_النص_المترجم
// and كل_مفاتيح_الصياغة are written by hand. This test reads each type's
// declaration from the compiler source and requires every variant to be listed
// exactly once, so a missing entry fails here instead of silently shrinking
// every table check that iterates the list. Run from the repository root.

// Variant names of `عام نوع <name> =` up to the closing `;`.
عرف متغيرات_نوع(المصدر: &نص, الترويسة: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طابق ابحث_نصا(المصدر, الترويسة) مع
    | اختياري.لا_شيء -> { أرجع الناتج; }
    | اختياري.موجود(الموضع) -> { ف := الموضع; };
    // Skip the header line itself.
    طالما (ف < العدد && (*المصدر)[ف] != 0x0A) { ف := ف + 1; }
    دع انتهى: متغير منطقي = خطأ;
    طالما (ف < العدد && !انتهى) {
        ف := ف + 1;
        طالما (ف < العدد && (*المصدر)[ف] == 0x20) { ف := ف + 1; }
        إذا (ف < العدد && (*المصدر)[ف] == 0x3B) {
            انتهى := صواب;
        } وإلا إذا ((ف + 1) < العدد && (*المصدر)[ف] == 0x7C && (*المصدر)[ف + 1] == 0x20) {
            ف := ف + 2;
            دع الاسم: متغير متجه ط8 = [];
            طالما (ف < العدد && (*المصدر)[ف] != 0x20 && (*المصدر)[ف] != 0x0A && (*المصدر)[ف] != 0x0D) {
                ألحق(الاسم, (*المصدر)[ف]);
                ف := ف + 1;
            }
            ألحق(الناتج, من_بايتات(&الاسم));
        };
        طالما (ف < العدد && (*المصدر)[ف] != 0x0A) { ف := ف + 1; }
    }
    أرجع الناتج;
}

عرف علامة_إلحاق(النوع: &نص, الاسم: &نص): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    دع البداية: نص = «ألحق(الناتج, »;
    دع النقطة: نص = «.»;
    دع النهاية: نص = «());»;
    دع أ: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, &البداية);
    دع ب: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, النوع);
    دع ج: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, &النقطة);
    دع د: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, الاسم);
    دع هـ: منطقي = ألحق_نصا_بباني_النص(&متغير الباني, &النهاية);
    أرجع نص_باني_النص(&الباني);
}

عرف اقرأ_أو_فارغ(المسار: نص): نص {
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> { أرجع النص; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

// 0 when every variant of the type is listed in the enumeration file and the
// list has exactly as many entries; otherwise how many are missing (at least 1).
عرف تحقق_تعداد(
    ملف_النوع: نص, الترويسة: نص, ملف_القائمة: نص, النوع: نص, طول_القائمة: طبيعي
): طبيعي {
    دع المصدر: نص = اقرأ_أو_فارغ(ملف_النوع);
    دع القائمة: نص = اقرأ_أو_فارغ(ملف_القائمة);
    دع المتغيرات: متجه نص = متغيرات_نوع(&المصدر, &الترويسة);
    إذا ((الطول(المتغيرات) مثل طبيعي) == 0) {
        دع ت: نتيجة عدد, عدد = اطبع_خطأ(«تعذر قراءة تصريح النوع »);
        دع ث: نتيجة عدد, عدد = اطبع_خطأ(النوع);
        أرجع 1;
    };
    دع المفقود: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
        دع العلامة: نص = علامة_إلحاق(&النوع, &المتغيرات[ف]);
        إذا (!يحتوي_نصا(&القائمة, &العلامة)) {
            دع ت: نتيجة عدد, عدد = اطبع_خطأ(«غير مدرج في التعداد: »);
            دع ث: نتيجة عدد, عدد = اطبع_خطأ(انسخ_نص(&العلامة));
            دع ج: نتيجة عدد, عدد = اطبع_خطأ("\n");
            المفقود := المفقود + 1;
        };
        ف := ف + 1;
    }
    إذا (المفقود == 0 && طول_القائمة != (الطول(المتغيرات) مثل طبيعي)) { أرجع 1; };
    أرجع المفقود;
}

عرف الرئيسية(): عدد {
    إذا (تحقق_تعداد(«compiler/diagnostics/reason.sn», «عام نوع سبب_تشخيص =», «compiler/diagnostics/reason.sn», «سبب_تشخيص», الطول(كل_أسباب_التشخيص()) مثل طبيعي) != 0) { أرجع 1; };
    إذا (تحقق_تعداد(«compiler/diagnostics/identity.sn», «عام نوع معرف_تشخيص =», «compiler/diagnostics/registry.sn», «معرف_تشخيص», الطول(كل_معرفات_التشخيص()) مثل طبيعي) != 0) { أرجع 2; };
    إذا (تحقق_تعداد(«compiler/ispeak/keys/surface.sn», «عام نوع مفتاح_نص_مترجم =», «compiler/ispeak/keys/surface.sn», «مفتاح_نص_مترجم», الطول(كل_مفاتيح_النص_المترجم()) مثل طبيعي) != 0) { أرجع 3; };
    إذا (تحقق_تعداد(«compiler/diagnostics/schema.sn», «عام نوع مفتاح_صياغة =», «compiler/diagnostics/schema.sn», «مفتاح_صياغة», الطول(كل_مفاتيح_الصياغة()) مثل طبيعي) != 0) { أرجع 4; };
    أرجع 0;
}
