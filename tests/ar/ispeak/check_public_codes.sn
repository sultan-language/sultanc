عرف الرئيسية(): عدد {
    دع المعرفات: متجه معرف_تشخيص = كل_معرفات_التشخيص();
    دع الأكواد: متجه نص = الأكواد_المثبتة();
    دع الأنواع: متجه نص = الأنواع_المثبتة();
    إذا (الطول(المعرفات) != الطول(الأكواد)) { أرجع 1; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
        دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرفات[ف]);
        دع الكود: نص = انسخ_نص(&التعريف.الكود);
        دع النوع: نص = انسخ_نص(&التعريف.النوع_الآلي);
        إذا (!نصان_متساويان(&الكود, &الأكواد[ف])) { أرجع 2; };
        إذا (!نصان_متساويان(&النوع, &الأنواع[ف])) { أرجع 3; };
        ف := ف + 1;
    }
    أرجع 0;
}
