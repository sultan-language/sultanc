// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_arabic_tables.sn
استورد std.io.print;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.keys.surface;

// Every Arabic table string is Arabic: a string with an ASCII letter and no
// non-ASCII byte is English left in the `ar` locale. Codes, triples and
// product names inside an Arabic sentence are fine; only a wholly ASCII
// string fails. The allowlist names the strings that are machine text in
// every language. Non-empty is checked too (a missing translation).

عرف إنجليزي_خالص(النص: &نص): منطقي {
    دع فيه_حرف: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        دع البايت: ط8 = (*النص)[ف];
        إذا (البايت >= 0x80) { أرجع خطأ; };
        إذا ((البايت >= 0x41 && البايت <= 0x5A) || (البايت >= 0x61 && البايت <= 0x7A)) { فيه_حرف := صواب; };
        ف := ف + 1;
    }
    أرجع فيه_حرف;
}

عرف نص_عربي_سليم(النص: نص): منطقي {
    إذا ((الطول(النص) مثل طبيعي) == 0) { أرجع خطأ; };
    إذا (إنجليزي_خالص(&النص)) {
        دع ت: نتيجة عدد, عدد = اطبع_خطأ(«نص إنجليزي في جدول العربية: »);
        دع ث: نتيجة عدد, عدد = اطبع_خطأ(النص);
        دع ج: نتيجة عدد, عدد = اطبع_خطأ("\n");
        أرجع خطأ;
    };
    أرجع صواب;
}

// The product name stays SultanC in every language.
عرف مسموح_نص_مترجم(المفتاح: مفتاح_نص_مترجم): منطقي {
    طابق المفتاح مع
    | مفتاح_نص_مترجم.بادئة_الإصدار -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع الفشل: متغير عدد = 0;
    دع المفاتيح: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
        إذا (!نص_عربي_سليم(رسالة_تشخيص(لغة_تشخيص.العربية(), المفاتيح[ف]))) { الفشل := الفشل + 1; };
        ف := ف + 1;
    }
    دع المعرفات: متجه معرف_تشخيص = كل_معرفات_التشخيص();
    ف := 0;
    طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
        إذا (!نص_عربي_سليم(شرح_تشخيص(لغة_تشخيص.العربية(), المعرفات[ف]))) { الفشل := الفشل + 1; };
        ف := ف + 1;
    }
    دع النصوص: متجه مفتاح_نص_مترجم = كل_مفاتيح_النص_المترجم();
    ف := 0;
    طالما (ف < (الطول(النصوص) مثل طبيعي)) {
        إذا (!مسموح_نص_مترجم(النصوص[ف])) {
            إذا (!نص_عربي_سليم(نص_المترجم(لغة_تشخيص.العربية(), النصوص[ف]))) { الفشل := الفشل + 1; };
        };
        ف := ف + 1;
    }
    دع الصياغات: متجه مفتاح_صياغة = كل_مفاتيح_الصياغة();
    ف := 0;
    طالما (ف < (الطول(الصياغات) مثل طبيعي)) {
        إذا (!نص_عربي_سليم(نص_تفصيل_ثابت(لغة_تشخيص.العربية(), الصياغات[ف]))) { الفشل := الفشل + 1; };
        ف := ف + 1;
    }
    إذا (الفشل > 0) { أرجع 1; };
    أرجع 0;
}
