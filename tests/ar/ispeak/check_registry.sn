// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_registry.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Registry contract: every public identity has a code, the code finds the same
// identity again (so codes are unique), and proposed codes/classes are frozen.
عرف كود_مطابق(المعرف: معرف_تشخيص, المتوقع: نص): منطقي {
    دع تعريف_الكود: تعريف_تشخيص = تعريف_التشخيص(المعرف);
    دع الفعلي: نص = انسخ_نص(&تعريف_الكود.الكود);
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف فئة_مطابقة(المعرف: معرف_تشخيص, المتوقعة: فئة_تشخيص): منطقي {
    دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرف);
    أرجع التعريف.الفئة == المتوقعة;
}

عرف الرئيسية(): عدد {
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع الرقم: متغير طبيعي = 0;
    دع العدد: متغير طبيعي = 0;
    طالما (الرقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        طابق المفاتيح_كلها[الرقم] مع
        | مفتاح_رسالة_تشخيص.تشخيص(المعرف) -> {
            دع تعريف_الكود: تعريف_تشخيص = تعريف_التشخيص(المعرف);
            دع الكود: نص = انسخ_نص(&تعريف_الكود.الكود);
            دع الفارغ: نص = «»;
            إذا (نصان_متساويان(&الكود, &الفارغ)) { أرجع 1; };
            طابق معرف_تشخيص_من_كود(&الكود) مع
            | اختياري.موجود(المستعاد) -> {
                إذا (المستعاد != المعرف) { أرجع 2; };
            }
            | اختياري.لا_شيء -> { أرجع 2; };
            طابق شرح_كود_عام(لغة_تشخيص.العربية(), &الكود) مع
            | اختياري.موجود(_) -> { }
            | اختياري.لا_شيء -> { أرجع 7; };
            العدد := العدد + 1;
        }
        | _ -> { };
        الرقم := الرقم + 1;
    }
    إذا (العدد != (221 مثل طبيعي)) { أرجع 3; };
    دع مجهول: نص = «SULTANC-E0001»;
    طابق معرف_تشخيص_من_كود(&مجهول) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 8; };
    دع التحذير: تعريف_تشخيص = تعريف_التشخيص(معرف_تشخيص.نمط_غير_قابل_للوصول());
    إذا (التحذير.الشدة != شدة_تشخيص.تحذير()) { أرجع 9; };
    إذا (!كود_مطابق(معرف_تشخيص.هدف_لا_يدعم_الميزة(), «SULTANC-TARGET-FEATURE-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.هدف_لا_يدعم_الميزة(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.بناء_غير_مدعوم_في_الخلفية(), «SULTANC-BACKEND-UNSUPPORTED-CONSTRUCT»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.بناء_غير_مدعوم_في_الخلفية(), فئة_تشخيص.غير_منفذ())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.مدى_ترميز_متجاوز(), «SULTANC-BACKEND-RANGE-EXCEEDED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.مدى_ترميز_متجاوز(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.رمز_ربط_غير_معرف(), «SULTANC-LINK-UNDEFINED-SYMBOL»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.رمز_ربط_غير_معرف(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.رمز_ربط_مكرر(), «SULTANC-LINK-DUPLICATE-SYMBOL»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.رمز_ربط_مكرر(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.موفر_وقت_تشغيل_مفقود(), «SULTANC-TARGET-RUNTIME-PROVIDER-MISSING»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.موفر_وقت_تشغيل_مفقود(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.نفاد_ذاكرة_المترجم(), «SULTANC-HOST-OUT-OF-MEMORY»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.نفاد_ذاكرة_المترجم(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.رمز_ربط_بنوع_غير_متطابق(), «SULTANC-LINK-SYMBOL-TYPE-MISMATCH»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.رمز_ربط_بنوع_غير_متطابق(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.رمز_خارجي_غير_مدعوم(), «SULTANC-LINK-EXTERNAL-SYMBOL-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.رمز_خارجي_غير_مدعوم(), فئة_تشخيص.غير_منفذ())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.إعادة_توطين_غير_مدعومة(), «SULTANC-OBJECT-RELOCATION-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.إعادة_توطين_غير_مدعومة(), فئة_تشخيص.غير_منفذ())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.صيغة_كائن_غير_مدعومة_للهدف(), «SULTANC-OBJECT-FORMAT-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.صيغة_كائن_غير_مدعومة_للهدف(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.مخرج_ربط_غير_مدعوم(), «SULTANC-LINK-OUTPUT-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.مخرج_ربط_غير_مدعوم(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.مدخل_ربط_غير_مدعوم(), «SULTANC-LINK-INPUT-UNSUPPORTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.مدخل_ربط_غير_مدعوم(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.واجهة_استدعاء_غير_متاحة_للهدف(), «SULTANC-TARGET-ABI-UNAVAILABLE»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.واجهة_استدعاء_غير_متاحة_للهدف(), فئة_تشخيص.بيئة())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.حد_صيغة_كائن_متجاوز(), «SULTANC-OBJECT-FORMAT-LIMIT-EXCEEDED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.حد_صيغة_كائن_متجاوز(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.حد_وقت_الترجمة_متجاوز(), «SULTANC-COMPTIME-LIMIT-EXCEEDED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.حد_وقت_الترجمة_متجاوز(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.أثر_ممنوع_وقت_الترجمة(), «SULTANC-COMPTIME-PROHIBITED-EFFECT»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.أثر_ممنوع_وقت_الترجمة(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة(), «SULTANC-COMPTIME-EVALUATION-FAILED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.فشل_تنفيذ_وقت_الترجمة(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.عملية_غير_مدعومة_وقت_الترجمة(), «SULTANC-COMPTIME-UNSUPPORTED-OPERATION»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.عملية_غير_مدعومة_وقت_الترجمة(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.ناتج_وقت_الترجمة_غير_ثابت(), «SULTANC-COMPTIME-RESULT-NOT-CONSTANT»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.ناتج_وقت_الترجمة_غير_ثابت(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.تخطيط_غير_متاح_وقت_الترجمة(), «SULTANC-COMPTIME-LAYOUT-UNAVAILABLE»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.تخطيط_غير_متاح_وقت_الترجمة(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.عدد_حجج_وقت_الترجمة_غير_مطابق(), «SULTANC-COMPTIME-ARGUMENT-COUNT-MISMATCH»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.عدد_حجج_وقت_الترجمة_غير_مطابق(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم(), «SULTANC-INTERPRETER-UNSUPPORTED-EXTERNAL-CALL»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.بدائي_آلة_تفسير_غير_مدعوم(), «SULTANC-INTERPRETER-UNSUPPORTED-MACHINE-PRIMITIVE»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.بدائي_آلة_تفسير_غير_مدعوم(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    إذا (!كود_مطابق(معرف_تشخيص.خطأ_نحوي(), «SULTANC-PARSE-SYNTAX»)) { أرجع 6; };
    إذا (!كود_مطابق(معرف_تشخيص.نقل_من_مرجع(), «SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE»)) { أرجع 6; };
    إذا (!كود_مطابق(معرف_تشخيص.مسير_غير_صالح(), «SULTANC-ICE-MSIR-INVALID»)) { أرجع 6; };
    إذا (!كود_مطابق(معرف_تشخيص.نمط_غير_قابل_للوصول(), «SULTANC-PATTERN-UNREACHABLE»)) { أرجع 6; };
    إذا (!كود_مطابق(معرف_تشخيص.ملف_غير_منسق(), «SULTANC-FMT-UNFORMATTED»)) { أرجع 4; };
    إذا (!فئة_مطابقة(معرف_تشخيص.ملف_غير_منسق(), فئة_تشخيص.مستخدم())) { أرجع 5; };
    أرجع 0;
}
