// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_reuse_context.sn
استورد compiler.diagnostics.identity;
استورد std.text.from_bytes;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد std.text.builder;
استورد std.text.compare;

// Every active identity with all 22 fields must yield byte-identical output
// through the allocation-sensitive sink and the owned-text API, EN and AR.
// Both inputs are built from the same facts: a context for the sink and the
// same context wrapped as a payload for the owned-text API.
عرف تحقق(الباني: &متغير باني_نص, اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: حقائق_سياق_رسالة, الحمولة: حقائق_رسالة): منطقي {
    امسح_باني_النص(الباني);
    إذا (!ألحق_تشخيص_بسياق(الباني, اللغة, المفتاح, السياق)) { أرجع خطأ; };
    دع المضاف: نص = نص_باني_النص(الباني);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحمولة) مع
    | اختياري.موجود(المملوك) -> { أرجع نصان_متساويان(&المضاف, &المملوك); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف السياق_الكامل(): حقائق_سياق_رسالة {
    دع حقيقة_0: نص = «FACT_00_UNIQUE_MARKER»;
    دع حقيقة_1: نص = «FACT_01_UNIQUE_MARKER»;
    دع حقيقة_2: نص = «FACT_02_UNIQUE_MARKER»;
