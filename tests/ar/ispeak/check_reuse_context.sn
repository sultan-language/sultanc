        السبب: اختياري.لا_شيء()
    };
    أرجع السياق_فارغ;
}

عرف الرئيسية(): عدد {
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(1024 مثل طبيعي);
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع رقم: متغير طبيعي = 0;
    دع العدد: متغير طبيعي = 0;
    طالما (رقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[رقم];
        إذا (!تحقق(&متغير الباني, لغة_تشخيص.الإنجليزية(), المفتاح, السياق_الكامل(), حقائق_رسالة.سياق_تشخيص(السياق_الكامل()))) { أرجع 1; };
        إذا (!تحقق(&متغير الباني, لغة_تشخيص.العربية(), المفتاح, السياق_الكامل(), حقائق_رسالة.سياق_تشخيص(السياق_الكامل()))) { أرجع 2; };
        العدد := العدد + 1;
        رقم := رقم + 1;
    }
    إذا (العدد != (900 مثل طبيعي)) { أرجع 3; };
    دع مفتاح_فارغ: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    إذا (!تحقق(&متغير الباني, لغة_تشخيص.الإنجليزية(), مفتاح_فارغ, سياق_فارغ_كامل(), حقائق_رسالة.سياق_تشخيص(سياق_فارغ_كامل()))) { أرجع 4; };
    إذا (!تحقق(&متغير الباني, لغة_تشخيص.العربية(), مفتاح_فارغ, سياق_فارغ_كامل(), حقائق_رسالة.سياق_تشخيص(سياق_فارغ_كامل()))) { أرجع 5; };
    أرجع 0;
}
