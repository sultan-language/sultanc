    دع حقيقة_12: نص = «FACT_12_UNIQUE_MARKER»;
    دع حقيقة_13: نص = «FACT_13_UNIQUE_MARKER»;
    دع حقيقة_14: نص = «FACT_14_UNIQUE_MARKER»;
    دع حقيقة_15: نص = «FACT_15_UNIQUE_MARKER»;
    دع حقيقة_16: نص = «FACT_16_UNIQUE_MARKER»;
    دع حقيقة_17: نص = «FACT_17_UNIQUE_MARKER»;
    دع حقيقة_18: نص = «FACT_18_UNIQUE_MARKER»;
    دع حقيقة_19: نص = «FACT_19_UNIQUE_MARKER»;
    دع حقيقة_20: نص = «FACT_20_UNIQUE_MARKER»;
    دع حقيقة_21: نص = «FACT_21_UNIQUE_MARKER»;
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_0))),
        المتوقع: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_1))),
        الاستبدال: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_2))),
        الموجود: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_3))),
        الفهرس: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_4))),
        الطول: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_5))),
        المجال: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_6))),
        النمط: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_7))),
        المسار: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_8))),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_9))),
        النوع: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_10))),
        السياق: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_11))),
        المرحلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_12))),
        الهدف: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_13))),
        الدالة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_14))),
        الكتلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_15))),
        التعليمة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_16))),
        العملية: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_17))),
        البدائي: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_18))),
        المصدر: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_19))),
        الوجهة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_20))),
        السبب: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_21)))
    };
    أرجع السياق;
}

عرف سياق_فارغ_كامل(): حقائق_سياق_رسالة {
    دع السياق_فارغ: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
