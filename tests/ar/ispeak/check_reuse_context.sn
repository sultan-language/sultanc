    دع حقيقة_6: نص = «FACT_06_UNIQUE_MARKER»;
    دع حقيقة_7: نص = «FACT_07_UNIQUE_MARKER»;
    دع حقيقة_8: نص = «FACT_08_UNIQUE_MARKER»;
    دع حقيقة_9: نص = «FACT_09_UNIQUE_MARKER»;
