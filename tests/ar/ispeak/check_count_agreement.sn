// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_count_agreement.sn
استورد std.text.compare;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Exact count agreement in both languages for counts that select every rule:
// 0, 1, 2, 3-10, 11-99, hundreds, and last-two-digit cases 102/103/110/111.
عرف تحقق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, السياق: حقائق_سياق_رسالة, المتوقع: نص): منطقي {
    دع البيانات: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(السياق);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, البيانات) مع
    | اختياري.موجود(الفعلي) -> { أرجع نصان_متساويان(&الفعلي, &المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// Same shape as the other tests' context builders: values arrive as parameters,
// so the returned record holds no reference to this function's locals.
عرف سياق_عددين(المتوقع: اختياري قيمة_حجة_رسالة, الموجود: اختياري قيمة_حجة_رسالة): حقائق_سياق_رسالة {
    دع البيانات: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: المتوقع,
        الاستبدال: اختياري.لا_شيء(),
        الموجود: الموجود,
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.لا_شيء(),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.لا_شيء()
    };
    أرجع البيانات;
}

عرف الرئيسية(): عدد {
    دع مفتاح_حجج: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق());
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(0 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي))), «call argument count does not match — The function expects no arguments, but the call passes 1 argument.»)) { أرجع 1; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(0 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة لا تتوقع أي حجة، لكن النداء يمرر حجة واحدة.»)) { أرجع 2; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي))), «call argument count does not match — The function expects 1 argument, but the call passes 2 arguments.»)) { أرجع 3; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع حجة واحدة، لكن النداء يمرر حجتين.»)) { أرجع 4; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي))), «call argument count does not match — The function expects 2 arguments, but the call passes 3 arguments.»)) { أرجع 5; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع حجتين، لكن النداء يمرر 3 حجج.»)) { أرجع 6; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(10 مثل طبيعي))), «call argument count does not match — The function expects 3 arguments, but the call passes 10 arguments.»)) { أرجع 7; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(10 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 3 حجج، لكن النداء يمرر 10 حجج.»)) { أرجع 8; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(10 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي))), «call argument count does not match — The function expects 10 arguments, but the call passes 11 arguments.»)) { أرجع 9; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(10 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 10 حجج، لكن النداء يمرر 11 حجة.»)) { أرجع 10; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(99 مثل طبيعي))), «call argument count does not match — The function expects 11 arguments, but the call passes 99 arguments.»)) { أرجع 11; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(99 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 11 حجة، لكن النداء يمرر 99 حجة.»)) { أرجع 12; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(99 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(100 مثل طبيعي))), «call argument count does not match — The function expects 99 arguments, but the call passes 100 arguments.»)) { أرجع 13; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(99 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(100 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 99 حجة، لكن النداء يمرر 100 حجة.»)) { أرجع 14; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(100 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي))), «call argument count does not match — The function expects 100 arguments, but the call passes 102 arguments.»)) { أرجع 15; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(100 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 100 حجة، لكن النداء يمرر 102 حجة.»)) { أرجع 16; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(103 مثل طبيعي))), «call argument count does not match — The function expects 102 arguments, but the call passes 103 arguments.»)) { أرجع 17; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(103 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 102 حجة، لكن النداء يمرر 103 حجج.»)) { أرجع 18; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(103 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(110 مثل طبيعي))), «call argument count does not match — The function expects 103 arguments, but the call passes 110 arguments.»)) { أرجع 19; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(103 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(110 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 103 حجج، لكن النداء يمرر 110 حجج.»)) { أرجع 20; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(110 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(111 مثل طبيعي))), «call argument count does not match — The function expects 110 arguments, but the call passes 111 arguments.»)) { أرجع 21; };
    إذا (!تحقق(لغة_تشخيص.العربية(), مفتاح_حجج, سياق_عددين(اختياري.موجود(قيمة_حجة_رسالة.طبيعية(110 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(111 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 110 حجج، لكن النداء يمرر 111 حجة.»)) { أرجع 22; };
