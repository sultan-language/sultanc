    لو (!ذو_حجج(لغة_تشخيص.العربية(), المفتاح_21, العربية_21)) { أرجع 42; };
    // Every fixed diagnostic rejects unrelated dynamic arguments.
    دع المفتاح_ثابت: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.إرجاع_مفقود());
    دع حقائق_خاطئة: حقائق_رسالة = حقائق_رسالة.نص_محدد(قيم_نص());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), المفتاح_ثابت, حقائق_خاطئة) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 43; };
    أرجع 0;
}
