// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_dynamic_families.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.ispeak.keys.surface;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Every source-backed specialized formatter must accept its typed facts in
// both languages. The input identity never depends on the rendered message.
عرف ذو_حجج(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة): منطقي {
    دع الأصل: نص = رسالة_تشخيص(اللغة, المفتاح);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحقائق) مع
    | اختياري.موجود(النص) -> {
        لو ((الطول(النص) مثل طبيعي) == 0) { أرجع خطأ; };
        أرجع !نصان_متساويان(&النص, &الأصل);
    }
    | _ -> { أرجع خطأ; };
}

عرف قيم_اسم(): حقائق_اسم_غير_معروف {
    دع القيم: حقائق_اسم_غير_معروف = { الاسم: «demo» };
    أرجع القيم;
}

عرف قيم_نوع(): حقائق_نوعان_غير_متوافقين {
    دع القيم: حقائق_نوعان_غير_متوافقين = { المتوقع: «i32», الموجود: «f32» };
    أرجع القيم;
}

عرف قيم_عدد(): حقائق_عدد_حجج_غير_مطابق {
    دع القيم: حقائق_عدد_حجج_غير_مطابق = { المتوقع: 2 مثل طبيعي, الموجود: 3 مثل طبيعي };
    أرجع القيم;
}

عرف قيم_نص(): حقائق_نص_محدد {
    دع القيم: حقائق_نص_محدد = { القيمة: «demo» };
    أرجع القيم;
}

عرف قيم_ربط(): حقائق_ربط_إل_إل_في_إم {
    دع القيم: حقائق_ربط_إل_إل_في_إم = { الهدف: «arm64-darwin», الرمز: «LLVMGetVersion» };
    أرجع القيم;
}

عرف قيم_فشل(): حقائق_فشل_وقت_الترجمة {
    دع القيم: حقائق_فشل_وقت_الترجمة = { الرسالة: «compiler_error() called» };
    أرجع القيم;
}

عرف قيم_بيان(): حقائق_بيان_حزمة {
    دع القيم: حقائق_بيان_حزمة = { المسار: «./project.toml», البايت: اختياري.موجود(8 مثل طبيعي), السبب: اختياري.موجود(مفتاح_نص_مترجم.حقل_بيان_مطلوب_مفقود()) };
    أرجع القيم;
}

عرف قيم_اقتراح(): حقائق_اقتراح_كلمة {
    دع القيم: حقائق_اقتراح_كلمة = { الاستبدال: «return» };
    أرجع القيم;
}

عرف قيم_نحو(): حقائق_توقع_نحوي {
    دع القيم: حقائق_توقع_نحوي = { المتوقع: «i32», الموجود: اختياري.موجود(«f32») };
    أرجع القيم;
}

عرف قيم_بدائي(): حقائق_بدائي_تفسير {
    دع القيم: حقائق_بدائي_تفسير = { البدائي: «host.read», الفهرس: اختياري.موجود(1 مثل طبيعي), المتوقع: اختياري.موجود(2 مثل طبيعي), الموجود: اختياري.موجود(3 مثل طبيعي) };
    أرجع القيم;
}

