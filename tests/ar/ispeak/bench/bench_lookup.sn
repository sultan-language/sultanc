// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/bench/bench_lookup.sn
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// A mixed-ID benchmark: direct typed message lookup in both locales.
// Deliberately does not decode numeric IDs or render JSON; the checksum
// keeps every result observable to the compiled program.
عرف الرئيسية(): عدد {
    دع المفاتيح: متجه مفتاح_رسالة_تشخيص = [
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_صحيح_نوع_معرف()),
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_مسير_غير_صحيح_موسوم_نوع()),
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_نوع_غير_مدعوم_تعبير_نوع())
    ];
    دع مجموع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 240000) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح[ف % 3];
        دع انجليزي: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
        دع عربي: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), المفتاح);
        مجموع := مجموع + (الطول(انجليزي) مثل طبيعي) + (الطول(عربي) مثل طبيعي);
        ف := ف + 1;
    }
    لو (مجموع != 35360000) { أرجع 1; };
    أرجع 0;
}
