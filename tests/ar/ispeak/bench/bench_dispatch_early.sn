// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/bench/bench_dispatch_early.sn
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Dynamic typed identities: compare this executable with the matching
// early/late fixture under the same backend and optimization configuration.
// The vector index is dynamic so the timed loop exercises typed dispatch.
عرف الرئيسية(): عدد {
    دع المفاتيح: متجه مفتاح_رسالة_تشخيص = [
        مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خطأ_نحوي()),
        مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تعبير_نحوي_غير_صالح()),
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_صحيح_نوع_معرف())
    ];
    دع المتوقع_للدورة: متغير طبيعي = 0;
    دع ع: متغير طبيعي = 0;
    طالما (ع < 3) {
        دع الرسالة: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفاتيح[ع]);
        المتوقع_للدورة := المتوقع_للدورة + (الطول(الرسالة) مثل طبيعي);
        ع := ع + 1;
    }
    دع المجموع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6000000) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح[ف % 3];
        دع الرسالة: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
        المجموع := المجموع + (الطول(الرسالة) مثل طبيعي);
        ف := ف + 1;
    }
    إذا (المجموع != (المتوقع_للدورة * 2000000)) { أرجع 1; };
    أرجع 0;
}
