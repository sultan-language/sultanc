// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/bench/bench_dispatch_reason_early.sn
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Isolate reason early typed lookups; compare equal-workload fixtures.
// Dynamic vector indexing prevents a single constant identity lookup.
عرف الرئيسية(): عدد {
    ليكن المفاتيح: متجه مفتاح_رسالة_تشخيص = [
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_واجهة_الاستدعاء_غير_صحيح_نوع_معرف()),
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_واجهة_الاستدعاء_مفقود_مسير_معامل()),
        مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_واجهة_الاستدعاء_مفقود_مسير_قيمة_نوع())
    ];
    ليكن المتوقع_للدورة: متغير طبيعي = 0;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < 3) {
        ليكن الرسالة: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفاتيح[ع]);
        المتوقع_للدورة := المتوقع_للدورة + (الطول(الرسالة) مثل طبيعي);
        ع := ع + 1;
    }
    ليكن المجموع: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 6000000) {
        ليكن المفتاح: مفتاح_رسالة_تشخيص = المفاتيح[ف % 3];
        ليكن الرسالة: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
        المجموع := المجموع + (الطول(الرسالة) مثل طبيعي);
        ف := ف + 1;
    }
    إذا (المجموع != (المتوقع_للدورة * 2000000)) { أرجع 1; };
    أرجع 0;
}
