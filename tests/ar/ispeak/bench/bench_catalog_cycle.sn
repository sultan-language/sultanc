// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/bench/bench_catalog_cycle.sn
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Stress every message key (all public diagnostics, then all reasons) from the
// typed enumeration repeatedly. Both locales are dispatched every cycle; the
// expected checksum uses a separate single scan.
عرف مجموع_دورة(المفاتيح: &متجه مفتاح_رسالة_تشخيص): طبيعي {
    دع المجموع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفاتيح) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = (*المفاتيح)[ف];
        دع الإنجليزي: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
        دع العربي: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), المفتاح);
        المجموع := المجموع + (الطول(الإنجليزي) مثل طبيعي) + (الطول(العربي) مثل طبيعي);
        ف := ف + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع المفاتيح: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع المتوقع: طبيعي = مجموع_دورة(&المفاتيح);
    إذا (المتوقع == 0) { أرجع 1; };
    دع الجولة: متغير طبيعي = 0;
    دع المجموع: متغير طبيعي = 0;
    طالما (الجولة < 10000) {
        المجموع := المجموع + مجموع_دورة(&المفاتيح);
        الجولة := الجولة + 1;
    }
    إذا (المجموع != (المتوقع * 10000)) { أرجع 2; };
    أرجع 0;
}
