// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/bench/bench_dynamic_context.sn
استورد compiler.diagnostics.identity;
استورد std.text.from_bytes;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد std.text.compare;

// Same source, target, locale and 200,000 operations for each backend.
// Check every returned length; do not benchmark a result discarded by the caller.
عرف سياق_الاسم(): حقائق_سياق_رسالة {
    دع الاسم: نص = «identifier_name_0123456789_abcdefghijklmnopqrstuvwxyz»;
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الاسم))),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.لا_شيء()
    };
    أرجع السياق;
}

عرف الرئيسية(): عدد {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    دع المتوقع: نص = «invalid MSIR — The symbol is `identifier_name_0123456789_abcdefghijklmnopqrstuvwxyz`.»;
    دع طول_الرسالة: طبيعي = الطول(المتوقع) مثل طبيعي;
    دع المجموع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 200000) {
        طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), المفتاح, حقائق_رسالة.سياق_تشخيص(سياق_الاسم())) مع
        | اختياري.موجود(الناتج) -> {
            المجموع := المجموع + (الطول(الناتج) مثل طبيعي);
            إذا (ف == 0 && !نصان_متساويان(&الناتج, &المتوقع)) { أرجع 1; };
        }
        | اختياري.لا_شيء -> { أرجع 2; };
        ف := ف + 1;
    }
    إذا (المجموع != طول_الرسالة * 200000) { أرجع 3; };
    أرجع 0;
}
