// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_context_opaque_values.sn
استورد std.text.compare;
استورد std.text.builder;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Dynamic inputs must remain opaque when inserted into localized sentences.
// A fact must not break out of the fact boundary or change the surrounding
// agreement, punctuation, or quotation structure.
// An empty description stands for "no reason fact".
عرف سبب_من_وصف(الوصف: &نص): اختياري قيمة_حجة_رسالة {
    إذا ((الطول(*الوصف) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(الوصف)));
}

عرف حقائق_رمز(الرمز: &نص, الوصف: &نص): حقائق_سياق_رسالة {
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(الرمز))),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: سبب_من_وصف(الوصف)
    };
    أرجع السياق;
}

عرف تحقق(اللغة: لغة_تشخيص, الرمز: &نص, الوصف: &نص, المتوقع: نص): منطقي {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف());
    دع الحمولة: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(حقائق_رمز(الرمز, الوصف));
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحمولة) مع
    | اختياري.موجود(النص) -> {
        إذا (!نصان_متساويان(&النص, &المتوقع)) { أرجع خطأ; };
        دع الباني: متغير باني_نص = أنشئ_باني_نص();
        إذا (!ألحق_تشخيص_بسياق(&متغير الباني, اللغة, المفتاح, حقائق_رمز(الرمز, الوصف))) { أرجع خطأ; };
        دع من_الباني: نص = نص_باني_النص(&الباني);
        أرجع نصان_متساويان(&من_الباني, &المتوقع);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع لا_سبب: نص = «»;
    دع ملف: نص = «lib/source.sn»;
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), &ملف, &لا_سبب, «unknown name — The unknown name is `lib/source.sn`.»)) { أرجع 1; };
    إذا (!تحقق(لغة_تشخيص.العربية(), &ملف, &لا_سبب, «اسم غير معروف — الاسم غير المعروف هو `lib/source.sn`.»)) { أرجع 2; };

    دع فارغ: نص = «»;
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), &فارغ, &لا_سبب, «unknown name — The unknown name is ``.»)) { أرجع 3; };
    إذا (!تحقق(لغة_تشخيص.العربية(), &فارغ, &لا_سبب, «اسم غير معروف — الاسم غير المعروف هو ``.»)) { أرجع 4; };

    دع اسم_عربي: نص = «متغيّر، جديد»;
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), &اسم_عربي, &لا_سبب, «unknown name — The unknown name is `متغيّر، جديد`.»)) { أرجع 5; };
    إذا (!تحقق(لغة_تشخيص.العربية(), &اسم_عربي, &لا_سبب, «اسم غير معروف — الاسم غير المعروف هو `متغيّر، جديد`.»)) { أرجع 6; };

    دع خام: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير خام, «a`b»);
    ألحق(خام, 0x0A);
    ألحق(خام, 0x09);
    ألحق(خام, 0x00);
    دع خطير: نص = من_بايتات(&خام);
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), &خطير, &لا_سبب, «unknown name — The unknown name is `a\`b\n\t\x00`.»)) { أرجع 7; };
    إذا (!تحقق(لغة_تشخيص.العربية(), &خطير, &لا_سبب, «اسم غير معروف — الاسم غير المعروف هو `a\`b\n\t\x00`.»)) { أرجع 8; };

    دع وصف: نص = «side effects?»;
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), &فارغ, &وصف, «unknown name — The unknown name is ``. `side effects?`.»)) { أرجع 9; };
    إذا (!تحقق(لغة_تشخيص.العربية(), &فارغ, &وصف, «اسم غير معروف — الاسم غير المعروف هو ``. `side effects?`.»)) { أرجع 10; };

    أرجع 0;
}
