// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_runtime_failures.sn
استورد std.text.compare;
استورد compiler.runtime.failure_identity;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

عرف نفس_النص(الفعلي: نص, المتوقع: نص): منطقي {
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

// Exact runtime-failure wording in both languages.
عرف الرئيسية(): عدد {
    إذا (!نفس_النص(عنوان_فشل_تشغيل(لغة_تشخيص.الإنجليزية()), «runtime error»)) { أرجع 1; };
    إذا (!نفس_النص(عنوان_فشل_تشغيل(لغة_تشخيص.العربية()), «خطأ وقت التشغيل»)) { أرجع 2; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.تجاوز_حدود()), «index out of bounds»)) { أرجع 3; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.تجاوز_حدود()), «الفهرس خارج الحدود»)) { أرجع 4; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), «argument out of range»)) { أرجع 5; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), «الوسيط خارج المدى المسموح»)) { أرجع 6; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), «invalid operation»)) { أرجع 7; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), «عملية غير صالحة»)) { أرجع 8; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إدخال_إخراج()), «input/output failure»)) { أرجع 9; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إدخال_إخراج()), «فشل في الإدخال أو الإخراج»)) { أرجع 10; };
    أرجع 0;
}
