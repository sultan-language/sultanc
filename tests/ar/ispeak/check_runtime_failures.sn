// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_runtime_failures.sn
استورد المكتبة.نصوص.مقارنة;
استورد compiler.runtime.failure_identity;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

عرف نفس_النص(الفعلي: نص, المتوقع: نص): منطقي {
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

// Exact runtime-failure wording in both languages.
عرف الرئيسية(): عدد {
    إذا (!نفس_النص(عنوان_فشل_تشغيل(لغة_تشخيص.الإنجليزية()), «runtime error»)) { أرجع 1; };
    إذا (!نفس_النص(عنوان_فشل_تشغيل(لغة_تشخيص.العربية()), «خطأ وقت التشغيل»)) { أرجع 2; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.تجاوز_حدود()), «index out of bounds»)) { أرجع 3; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.تجاوز_حدود()), «الفهرس خارج الحدود»)) { أرجع 4; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), «argument out of range»)) { أرجع 5; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), «الوسيط خارج المدى المسموح»)) { أرجع 6; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), «invalid operation»)) { أرجع 7; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), «عملية غير صالحة»)) { أرجع 8; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إدخال_إخراج()), «input/output failure»)) { أرجع 9; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إدخال_إخراج()), «فشل في الإدخال أو الإخراج»)) { أرجع 10; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.تجاوز_عدد_صحيح()), «integer overflow at {2}»)) { أرجع 11; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.تجاوز_عدد_صحيح()), «تجاوز العدد الصحيح حدود نوعه عند {2}»)) { أرجع 12; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.فهرس_خارج_المدى()), «index {0} out of range for length {1} at {2}»)) { أرجع 13; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.فهرس_خارج_المدى()), «الفهرس {0} خارج المدى للطول {1} عند {2}»)) { أرجع 14; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.قسمة_على_صفر()), «division by zero at {2}»)) { أرجع 15; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.قسمة_على_صفر()), «قسمة على صفر عند {2}»)) { أرجع 16; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إزاحة_خارج_المدى()), «shift by {0} out of range for a {1}-bit integer at {2}»)) { أرجع 17; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إزاحة_خارج_المدى()), «إزاحة بمقدار {0} خارج المدى لعدد صحيح من {1} بت عند {2}»)) { أرجع 18; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.فيض_المكدس()), «stack overflow: the call stack ran out of space»)) { أرجع 19; };
    إذا (!نفس_النص(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.فيض_المكدس()), «فيض المكدس: نفدت مساحة مكدس الاستدعاءات»)) { أرجع 20; };
    أرجع 0;
}
