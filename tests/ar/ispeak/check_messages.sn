// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_messages.sn
استورد المكتبة.نصوص.مقارنة;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.keys.surface;

عرف غير_فارغ(النص: &نص): منطقي {
    ليكن الفارغ: نص = «»;
    أرجع !نصان_متساويان(النص, &الفارغ);
}

عرف الرئيسية(): عدد {
    ليكن جميع_المفاتيح: متجه مفتاح_نص_مترجم = كل_مفاتيح_النص_المترجم();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(جميع_المفاتيح) مثل طبيعي)) {
        ليكن انجليزي: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), جميع_المفاتيح[ف]);
        ليكن عربي: نص = نص_المترجم(لغة_تشخيص.العربية(), جميع_المفاتيح[ف]);
        إذا (!غير_فارغ(&انجليزي) || !غير_فارغ(&عربي)) { أرجع 1; };
        ف := ف + 1;
    }
    // Exercise all declared secondary wording keys in both locales.
    ليكن جميع_التفاصيل: متجه مفتاح_صياغة = كل_مفاتيح_الصياغة();
    ليكن تف: متغير طبيعي = 0;
    طالما (تف < (الطول(جميع_التفاصيل) مثل طبيعي)) {
        ليكن الإنجليزية: نص = نص_تفصيل_ثابت(لغة_تشخيص.الإنجليزية(), جميع_التفاصيل[تف]);
        ليكن العربية: نص = نص_تفصيل_ثابت(لغة_تشخيص.العربية(), جميع_التفاصيل[تف]);
        إذا (!غير_فارغ(&الإنجليزية) || !غير_فارغ(&العربية)) { أرجع 7; };
        تف := تف + 1;
    }
    ليكن عنوان: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), مفتاح_نص_مترجم.عنوان_المساعدة());
    ليكن المتوقع: نص = "SultanC compiler\n\n";
    إذا (!نصان_متساويان(&عنوان, &المتوقع)) { أرجع 2; };
    ليكن سبب: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود());
    ليكن المتوقع_السبب: نص = «required package graph field is missing»;
    إذا (!نصان_متساويان(&سبب, &المتوقع_السبب)) { أرجع 3; };
    ليكن تسمية: نص = نص_المترجم(لغة_تشخيص.العربية(), مفتاح_نص_مترجم.وصف_نهاية_الملف());
    ليكن المتوقع_تسمية: نص = «نهاية الملف»;
    إذا (!نصان_متساويان(&تسمية, &المتوقع_تسمية)) { أرجع 4; };
    ليكن المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    ليكن رقم: متغير طبيعي = 0;
    ليكن عدد_الشروح: متغير عدد = 0;
    طالما (رقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        ليكن المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[رقم];
        طابق المفتاح مع
        | مفتاح_رسالة_تشخيص.تشخيص(المعرف) -> {
            ليكن انجليزي: نص = شرح_تشخيص(لغة_تشخيص.الإنجليزية(), المعرف);
            ليكن عربي: نص = شرح_تشخيص(لغة_تشخيص.العربية(), المعرف);
            إذا (!غير_فارغ(&انجليزي) || !غير_فارغ(&عربي)) { أرجع 5; };
            // Keep explanations compact in either locale (UTF-8 byte bound).
            إذا ((الطول(انجليزي) مثل طبيعي) > 220 || (الطول(عربي) مثل طبيعي) > 220) { أرجع 8; };
            عدد_الشروح := عدد_الشروح + 1;
        }
        | _ -> { };
        رقم := رقم + 1;
    }
    إذا (عدد_الشروح != 237) { أرجع 6; };
    أرجع 0;
}
