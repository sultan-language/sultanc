// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_messages.sn
استورد std.text.compare;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.keys.surface;

عرف غير_فارغ(النص: &نص): منطقي {
    دع الفارغ: نص = «»;
    أرجع !نصان_متساويان(النص, &الفارغ);
}

عرف الرئيسية(): عدد {
    دع جميع_المفاتيح: متجه مفتاح_نص_مترجم = كل_مفاتيح_النص_المترجم();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(جميع_المفاتيح) مثل طبيعي)) {
        دع انجليزي: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), جميع_المفاتيح[ف]);
        دع عربي: نص = نص_المترجم(لغة_تشخيص.العربية(), جميع_المفاتيح[ف]);
        لو (!غير_فارغ(&انجليزي) || !غير_فارغ(&عربي)) { أرجع 1; };
        ف := ف + 1;
    }
    // Exercise all declared secondary wording keys in both locales.
    دع جميع_التفاصيل: متجه مفتاح_صياغة = كل_مفاتيح_الصياغة();
    دع تف: متغير طبيعي = 0;
    طالما (تف < (الطول(جميع_التفاصيل) مثل طبيعي)) {
        دع الإنجليزية: نص = نص_تفصيل_ثابت(لغة_تشخيص.الإنجليزية(), جميع_التفاصيل[تف]);
        دع العربية: نص = نص_تفصيل_ثابت(لغة_تشخيص.العربية(), جميع_التفاصيل[تف]);
        لو (!غير_فارغ(&الإنجليزية) || !غير_فارغ(&العربية)) { أرجع 7; };
        تف := تف + 1;
    }
    دع عنوان: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), مفتاح_نص_مترجم.عنوان_المساعدة());
    دع المتوقع: نص = "SultanC compiler\n\n";
    لو (!نصان_متساويان(&عنوان, &المتوقع)) { أرجع 2; };
    دع سبب: نص = نص_المترجم(لغة_تشخيص.الإنجليزية(), مفتاح_نص_مترجم.حقل_بيان_مطلوب_مفقود());
    دع المتوقع_السبب: نص = «required manifest field is missing»;
    لو (!نصان_متساويان(&سبب, &المتوقع_السبب)) { أرجع 3; };
    دع تسمية: نص = نص_المترجم(لغة_تشخيص.العربية(), مفتاح_نص_مترجم.وصف_نهاية_الملف());
    دع المتوقع_تسمية: نص = «نهاية الملف»;
    لو (!نصان_متساويان(&تسمية, &المتوقع_تسمية)) { أرجع 4; };
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع رقم: متغير طبيعي = 0;
    دع عدد_الشروح: متغير عدد = 0;
    طالما (رقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[رقم];
        طابق المفتاح مع
        | مفتاح_رسالة_تشخيص.تشخيص(المعرف) -> {
            دع انجليزي: نص = شرح_تشخيص(لغة_تشخيص.الإنجليزية(), المعرف);
            دع عربي: نص = شرح_تشخيص(لغة_تشخيص.العربية(), المعرف);
            لو (!غير_فارغ(&انجليزي) || !غير_فارغ(&عربي)) { أرجع 5; };
            // Keep explanations compact in either locale (UTF-8 byte bound).
            لو ((الطول(انجليزي) مثل طبيعي) > 220 || (الطول(عربي) مثل طبيعي) > 220) { أرجع 8; };
            عدد_الشروح := عدد_الشروح + 1;
        }
        | _ -> { };
        رقم := رقم + 1;
    }
    لو (عدد_الشروح != 142) { أرجع 6; };
    أرجع 0;
}
