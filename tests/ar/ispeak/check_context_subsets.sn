// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_context_subsets.sn
استورد compiler.diagnostics.schema;
استورد std.text.from_bytes;
استورد compiler.ispeak.ispeak;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد std.text.builder;

// Sweep 262,144 distinct mixed subsets of the 22 canonical fields across
// both locales using one reused builder. Full 2^22 exhaustive coverage
// is substantially slower; exact wording is asserted in the other fixtures.
عرف حقل_من_قناع(القناع: ط32, البت: ط32, النص: &نص): اختياري قيمة_حجة_رسالة {
    لو ((القناع & البت) != (0 مثل ط32)) {
        أرجع اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(النص)));
    };
    أرجع اختياري.لا_شيء();
}

عرف سياق_من_قناع(المؤشر: ط32, القيمة: &نص): حقائق_سياق_رسالة {
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: حقل_من_قناع(المؤشر, (1 مثل ط32), القيمة),
        المتوقع: حقل_من_قناع(المؤشر, (2 مثل ط32), القيمة),
        الاستبدال: حقل_من_قناع(المؤشر, (4 مثل ط32), القيمة),
        الموجود: حقل_من_قناع(المؤشر, (8 مثل ط32), القيمة),
        الفهرس: حقل_من_قناع(المؤشر, (16 مثل ط32), القيمة),
        الطول: حقل_من_قناع(المؤشر, (32 مثل ط32), القيمة),
        المجال: حقل_من_قناع(المؤشر, (64 مثل ط32), القيمة),
        النمط: حقل_من_قناع(المؤشر, (128 مثل ط32), القيمة),
        المسار: حقل_من_قناع(المؤشر, (256 مثل ط32), القيمة),
        الرمز: حقل_من_قناع(المؤشر, (512 مثل ط32), القيمة),
        النوع: حقل_من_قناع(المؤشر, (1024 مثل ط32), القيمة),
        السياق: حقل_من_قناع(المؤشر, (2048 مثل ط32), القيمة),
        المرحلة: حقل_من_قناع(المؤشر, (4096 مثل ط32), القيمة),
        الهدف: حقل_من_قناع(المؤشر, (8192 مثل ط32), القيمة),
        الدالة: حقل_من_قناع(المؤشر, (16384 مثل ط32), القيمة),
        الكتلة: حقل_من_قناع(المؤشر, (32768 مثل ط32), القيمة),
        التعليمة: حقل_من_قناع(المؤشر, (65536 مثل ط32), القيمة),
        العملية: حقل_من_قناع(المؤشر, (131072 مثل ط32), القيمة),
        البدائي: حقل_من_قناع(المؤشر, (262144 مثل ط32), القيمة),
        المصدر: حقل_من_قناع(المؤشر, (524288 مثل ط32), القيمة),
        الوجهة: حقل_من_قناع(المؤشر, (1048576 مثل ط32), القيمة),
        السبب: حقل_من_قناع(المؤشر, (2097152 مثل ط32), القيمة)
    };
    أرجع السياق;
}

عرف الرئيسية(): عدد {
    دع القيمة: نص = «FACT»;
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(1024 مثل طبيعي);
    دع القناع: متغير ط32 = 0 مثل ط32;
    طالما (القناع < (262144 مثل ط32)) {
        // Permute the 18-bit counter into a 22-bit context mask so every
        // field, including the highest four, participates in this sweep.
        دع المؤشر: ط32 = ((القناع << 4) | (القناع >> 14)) & (4194303 مثل ط32);
        امسح_باني_النص(&متغير الباني);
        لو (!ألحق_تشخيص_بسياق(&متغير الباني, لغة_تشخيص.الإنجليزية(), المفتاح, سياق_من_قناع(المؤشر, &القيمة))) { أرجع 1; };
        دع طول_إنجليزي: طبيعي = طول_باني_النص(&الباني);
        لو (طول_إنجليزي < 12 || طول_إنجليزي > 1500) { أرجع 2; };
        امسح_باني_النص(&متغير الباني);
        لو (!ألحق_تشخيص_بسياق(&متغير الباني, لغة_تشخيص.العربية(), المفتاح, سياق_من_قناع(المؤشر, &القيمة))) { أرجع 3; };
        دع طول_عربي: طبيعي = طول_باني_النص(&الباني);
        لو (طول_عربي < 12 || طول_عربي > 1500) { أرجع 4; };
        القناع := القناع + (1 مثل ط32);
    }
    أرجع 0;
}
