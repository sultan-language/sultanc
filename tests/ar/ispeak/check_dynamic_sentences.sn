// A small source-backed semantic sample: test full sentences, not merely
// longer strings or reversible numeric IDs.
عرف سياق_محدد(
    القيمة: اختياري قيمة_حجة_رسالة,
    المسار: اختياري قيمة_حجة_رسالة,
    الرمز: اختياري قيمة_حجة_رسالة,
    السبب: اختياري قيمة_حجة_رسالة,
    الهدف: اختياري قيمة_حجة_رسالة,
    المتوقع: اختياري قيمة_حجة_رسالة,
    الموجود: اختياري قيمة_حجة_رسالة
): حقائق_سياق_رسالة {
    دع البيانات: حقائق_سياق_رسالة = {
        القيمة: القيمة,
        المتوقع: المتوقع,
        الاستبدال: اختياري.لا_شيء(),
        الموجود: الموجود,
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: المسار,
        الرمز: الرمز,
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: الهدف,
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: السبب
    };
    أرجع البيانات;
}

