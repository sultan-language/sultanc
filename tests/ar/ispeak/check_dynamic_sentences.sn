    دع البيانات: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(الحقائق);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, البيانات) مع
    | اختياري.موجود(الفعلي) -> { أرجع نصان_متساويان(&الفعلي, &المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

