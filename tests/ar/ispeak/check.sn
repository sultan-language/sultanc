// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check.sn
استورد std.text.compare;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;

عرف الرئيسية(): عدد {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خطأ_نحوي());

    دع الرسالة_الإنجليزية: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
    دع المتوقع_بالإنجليزية: نص = «Syntax error in source code»;
    إذا (!نصان_متساويان(&الرسالة_الإنجليزية, &المتوقع_بالإنجليزية)) {
        أرجع 2;
    };

    دع الرسالة_العربية: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), المفتاح);
    دع المتوقع_بالعربية: نص = «خطأ في بناء الجملة المصدرية»;
    إذا (!نصان_متساويان(&الرسالة_العربية, &المتوقع_بالعربية)) {
        أرجع 3;
    };

    أرجع 0;
}
