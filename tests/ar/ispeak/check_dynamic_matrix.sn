// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_dynamic_matrix.sn
استورد std.text.search;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Every one of the 645 active identities must preserve each of the 22
// named context facts in both languages, without falling back to fixed text.
عرف تحقق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحمولة: حقائق_رسالة): منطقي {
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحمولة) مع
    | اختياري.موجود(الناتج) -> {
        دع الثابت: نص = رسالة_تشخيص(اللغة, المفتاح);
        لو ((الطول(الناتج) مثل طبيعي) <= (الطول(الثابت) مثل طبيعي)) { أرجع خطأ; };
        دع علامة_0: نص = «FACT_00_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_0)) { أرجع خطأ; };
        دع علامة_1: نص = «FACT_01_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_1)) { أرجع خطأ; };
        دع علامة_2: نص = «FACT_02_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_2)) { أرجع خطأ; };
        دع علامة_3: نص = «FACT_03_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_3)) { أرجع خطأ; };
        دع علامة_4: نص = «FACT_04_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_4)) { أرجع خطأ; };
        دع علامة_5: نص = «FACT_05_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_5)) { أرجع خطأ; };
        دع علامة_6: نص = «FACT_06_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_6)) { أرجع خطأ; };
        دع علامة_7: نص = «FACT_07_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_7)) { أرجع خطأ; };
        دع علامة_8: نص = «FACT_08_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_8)) { أرجع خطأ; };
        دع علامة_9: نص = «FACT_09_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_9)) { أرجع خطأ; };
        دع علامة_10: نص = «FACT_10_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_10)) { أرجع خطأ; };
        دع علامة_11: نص = «FACT_11_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_11)) { أرجع خطأ; };
        دع علامة_12: نص = «FACT_12_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_12)) { أرجع خطأ; };
        دع علامة_13: نص = «FACT_13_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_13)) { أرجع خطأ; };
        دع علامة_14: نص = «FACT_14_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_14)) { أرجع خطأ; };
        دع علامة_15: نص = «FACT_15_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_15)) { أرجع خطأ; };
        دع علامة_16: نص = «FACT_16_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_16)) { أرجع خطأ; };
        دع علامة_17: نص = «FACT_17_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_17)) { أرجع خطأ; };
        دع علامة_18: نص = «FACT_18_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_18)) { أرجع خطأ; };
        دع علامة_19: نص = «FACT_19_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_19)) { أرجع خطأ; };
        دع علامة_20: نص = «FACT_20_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_20)) { أرجع خطأ; };
        دع علامة_21: نص = «FACT_21_UNIQUE_MARKER»;
        لو (!يحتوي_نصا(&الناتج, &علامة_21)) { أرجع خطأ; };
        أرجع صواب;
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف الحمولة_الكاملة(): حقائق_رسالة {
    دع حقيقة_0: نص = «FACT_00_UNIQUE_MARKER»;
    دع حقيقة_1: نص = «FACT_01_UNIQUE_MARKER»;
    دع حقيقة_2: نص = «FACT_02_UNIQUE_MARKER»;
    دع حقيقة_3: نص = «FACT_03_UNIQUE_MARKER»;
    دع حقيقة_4: نص = «FACT_04_UNIQUE_MARKER»;
    دع حقيقة_5: نص = «FACT_05_UNIQUE_MARKER»;
    دع حقيقة_6: نص = «FACT_06_UNIQUE_MARKER»;
    دع حقيقة_7: نص = «FACT_07_UNIQUE_MARKER»;
    دع حقيقة_8: نص = «FACT_08_UNIQUE_MARKER»;
    دع حقيقة_9: نص = «FACT_09_UNIQUE_MARKER»;
    دع حقيقة_10: نص = «FACT_10_UNIQUE_MARKER»;
    دع حقيقة_11: نص = «FACT_11_UNIQUE_MARKER»;
    دع حقيقة_12: نص = «FACT_12_UNIQUE_MARKER»;
    دع حقيقة_13: نص = «FACT_13_UNIQUE_MARKER»;
    دع حقيقة_14: نص = «FACT_14_UNIQUE_MARKER»;
    دع حقيقة_15: نص = «FACT_15_UNIQUE_MARKER»;
    دع حقيقة_16: نص = «FACT_16_UNIQUE_MARKER»;
    دع حقيقة_17: نص = «FACT_17_UNIQUE_MARKER»;
    دع حقيقة_18: نص = «FACT_18_UNIQUE_MARKER»;
    دع حقيقة_19: نص = «FACT_19_UNIQUE_MARKER»;
    دع حقيقة_20: نص = «FACT_20_UNIQUE_MARKER»;
    دع حقيقة_21: نص = «FACT_21_UNIQUE_MARKER»;
    دع السياق: حقائق_سياق_رسالة = {
        القيمة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_0))),
        المتوقع: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_1))),
        الاستبدال: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_2))),
        الموجود: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_3))),
        الفهرس: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_4))),
        الطول: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_5))),
        المجال: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_6))),
        النمط: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_7))),
        المسار: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_8))),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_9))),
        النوع: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_10))),
        السياق: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_11))),
        المرحلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_12))),
        الهدف: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_13))),
        الدالة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_14))),
        الكتلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_15))),
        التعليمة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_16))),
        العملية: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_17))),
        البدائي: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_18))),
        المصدر: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_19))),
        الوجهة: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_20))),
        السبب: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&حقيقة_21)))
    };
    أرجع حقائق_رسالة.سياق_تشخيص(السياق);
}

عرف الرئيسية(): عدد {
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع رقم: متغير طبيعي = 0;
    دع العدد: متغير طبيعي = 0;
    طالما (رقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[رقم];
        لو (!تحقق(لغة_تشخيص.الإنجليزية(), المفتاح, الحمولة_الكاملة())) { أرجع 1; };
        لو (!تحقق(لغة_تشخيص.العربية(), المفتاح, الحمولة_الكاملة())) { أرجع 2; };
        العدد := العدد + 1;
        رقم := رقم + 1;
    }
    لو (العدد != (645 مثل طبيعي)) { أرجع 3; };
    أرجع 0;
}
