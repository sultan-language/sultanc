// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_dynamic_coverage.sn
استورد compiler.diagnostics.identity;
استورد std.text.from_bytes;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Every active public diagnostic and contextual reason accepts source-backed
// typed context, while its language-specific fixed message remains the basis.
عرف تحقق_صياغة_سياق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص): منطقي {
    دع الرمز: نص = «demo_symbol»;
    دع الحقائق: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الرمز))),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.لا_شيء()
    };
    دع الثابت: نص = رسالة_تشخيص(اللغة, المفتاح);
    دع الحمولة: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(الحقائق);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحمولة) مع
    | اختياري.موجود(النص) -> {
        أرجع (الطول(النص) مثل طبيعي) > (الطول(الثابت) مثل طبيعي);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع الرقم: متغير طبيعي = 0;
    دع العدد: متغير عدد = 0;
    طالما (الرقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[الرقم];
        لو (!تحقق_صياغة_سياق(لغة_تشخيص.الإنجليزية(), المفتاح)) { أرجع 1; };
        لو (!تحقق_صياغة_سياق(لغة_تشخيص.العربية(), المفتاح)) { أرجع 2; };
        العدد := العدد + 1;
        الرقم := الرقم + 1;
    }
    لو (العدد != 645) { أرجع 3; };
    أرجع 0;
}
