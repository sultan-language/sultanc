استورد compiler.diagnostics.suggestions;

// The structured suggestions an editor reads (diagnostics/suggestions.sn),
// in Arabic sources: the edits are written with the Arabic keywords
// (`متغير`, `استورد`, `مثل`) and the positions count Arabic letters and a
// character outside the BMP as an LSP client does. A machine-applicable
// suggestion is applied and the file then compiles.

عرف افشل(الرمز: عدد, النص: نص): عدد {
    ليكن أ: نتيجة عدد, عدد = اطبع_خطأ(النص);
    ليكن ب: نتيجة عدد, عدد = اطبع_خطأ("\n");
    أرجع الرمز;
}

عرف أخطاء(المسار: &نص): اختياري مجموعة_تشخيصات {
    ليكن الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.موجود(مجموعة_تشخيصات_جديدة()); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        طابق الإعداد مع
        | { البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ } -> {
            ليكن الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: خطأ };
            // لهدف المضيف كما يحلل خادم LSP: std.io مشروطة بالهدف.
            ليكن الهدف: متغير اختياري واصف_هدف = اختياري.لا_شيء();
            طابق حل_هدف_المضيف_المسجل() مع
            | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := اختياري.موجود(الوصف); }
            | نتيجة_حل_هدف.غير_مسجل -> { };
            ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
            ليكن الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
            طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, الهدف, &المزيد, &متغير الإلغاء) مع
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { أرجع اختياري.موجود(مجموعة_تشخيصات_جديدة()); }
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(الموجودة) -> { أرجع اختياري.موجود(الموجودة); }
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
                // تذكر الترجمة أخطاء الملكية على MSIR (تحليل شرعية الملكية)،
                // بعد ما جمعته الواجهة.
                ليكن المكتملة: متغير نتيجة_واجهة_وحدة = الواجهة;
                ليكن الموجودة: مجموعة_تشخيصات = تشخيصات_ملكية_واجهة_مكتملة(&متغير المكتملة);
                إذا (الموجودة.عدد_الأخطاء > 0) { أرجع اختياري.موجود(الموجودة); };
                إذا (المكتملة.تشخيصات_الأدوات.عدد_الأخطاء > 0) { أرجع اختياري.موجود(انسخ_مملوكا_مجموعة_تشخيصات(&المكتملة.تشخيصات_الأدوات)); };
                أرجع اختياري.لا_شيء();
            };
        };
    };
}

عرف افحص_حالة(الدليل: &نص, الاسم: نص, المصدر: نص, الكود: نص, النوع: نص,
               القابلية: نص, السطر: عدد, المحرف: عدد): عدد {
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(الدليل));
    ألحق(البايتات, 0x2F);
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&الاسم));
    ألحق(البايتات, 0x2E);
    ألحق(البايتات, 0x73);
    ألحق(البايتات, 0x6E);
    ليكن المسار: نص = البايتات مثل نص;
    طابق اكتب_الملف(&المسار, &المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع افشل(10, المسار); }
    | نتيجة.نجح(_) -> { };
    طابق أخطاء(&المسار) مع
    | اختياري.لا_شيء -> { أرجع افشل(11, الاسم); }
    | اختياري.موجود(الموجودة) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الموجودة.التشخيصات) مثل طبيعي)) {
            ليكن التعريف: تعريف_تشخيص = تعريف_التشخيص(الموجودة.التشخيصات[ف].المعرف);
            إذا (نصان_متساويان(&التعريف.الكود, &الكود)) {
                ليكن العربية: متجه اقتراح_تشخيص = اقتراحات_تشخيص(&الموجودة.التشخيصات[ف], لغة_تشخيص.العربية());
                ليكن الإنجليزية: متجه اقتراح_تشخيص = اقتراحات_تشخيص(&الموجودة.التشخيصات[ف], لغة_تشخيص.الإنجليزية());
                ليكن ي: متغير طبيعي = 0;
                طالما (ي < (الطول(العربية) مثل طبيعي)) {
                    طابق العربية[ي].النوع_الآلي مع
                    | اختياري.موجود(الآلي) -> {
                        إذا (نصان_متساويان(&الآلي, &النوع)) {
                            إذا (!نصان_متساويان(&العربية[ي].القابلية_الآلية, &القابلية)) { أرجع افشل(13, الاسم); };
                            إذا ((الطول(العربية[ي].الرسالة) مثل طبيعي) == 0 || (الطول(الإنجليزية[ي].الرسالة) مثل طبيعي) == 0) { أرجع افشل(14, الاسم); };
                            إذا (نصان_متساويان(&العربية[ي].الرسالة, &الإنجليزية[ي].الرسالة)) { أرجع افشل(15, الاسم); };
                            إذا (السطر >= 0) {
                                طابق العربية[ي].التعديلات[0].البداية مع
                                | اختياري.موجود(البداية) -> {
                                    إذا ((البداية.السطر مثل عدد) != السطر || (البداية.العمود مثل عدد) != المحرف) { أرجع افشل(16, الاسم); };
                                }
                                | اختياري.لا_شيء -> { أرجع افشل(16, الاسم); };
                            };
                            ليكن آلي: نص = "machine-applicable";
                            إذا (!نصان_متساويان(&القابلية, &آلي)) { أرجع 0; };
                            طابق طبق_اقتراحا_على_نص(&المصدر, &العربية[ي]) مع
                            | اختياري.لا_شيء -> { أرجع افشل(17, الاسم); }
                            | اختياري.موجود(المصلح) -> {
                                طابق اكتب_الملف(&المسار, &المصلح) مع
                                | نتيجة.خطأ(_) -> { أرجع افشل(18, المسار); }
                                | نتيجة.نجح(_) -> { };
                                طابق أخطاء(&المسار) مع
                                | اختياري.لا_شيء -> { أرجع 0; }
                                | اختياري.موجود(بعده) -> {
                                    ليكن ك: متغير طبيعي = 0;
                                    طالما (ك < (الطول(بعده.التشخيصات) مثل طبيعي)) {
                                        ليكن ت: تعريف_تشخيص = تعريف_التشخيص(بعده.التشخيصات[ك].المعرف);
                                        ليكن م: نتيجة عدد, عدد = اطبع_خطأ(انسخ_نص(&ت.الكود));
                                        ك := ك + 1;
                                    }
                                    أرجع افشل(19, المصلح);
                                };
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ي := ي + 1;
                }
                أرجع افشل(12, الاسم);
            };
            ف := ف + 1;
        }
        ليكن ز: متغير طبيعي = 0;
        طالما (ز < (الطول(الموجودة.التشخيصات) مثل طبيعي)) {
            ليكن آخر: تعريف_تشخيص = تعريف_التشخيص(الموجودة.التشخيصات[ز].المعرف);
            ليكن معروض: نتيجة عدد, عدد = اطبع_خطأ(انسخ_نص(&آخر.الكود));
            ز := ز + 1;
        }
        أرجع افشل(20, الاسم);
    };
}

عرف الرئيسية(): عدد {
    ليكن البادئة: نص = "sultanc-suggest-ar-";
    ليكن الدليل: متغير نص = "";
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المصنوع) -> { الدليل := المصنوع; };
    ليكن ر: متغير عدد = 0;
    ر := افحص_حالة(&الدليل, "mutable", "عرف الرئيسية(): ص32 {\n    ليكن العدد: ص32 = 3;\n    العدد := 4;\n    أرجع العدد;\n}\n",
        "SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE", "declare-mutable", "machine-applicable", 1, 16);
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "import", "استورد std.text.format;\nعرف الرئيسية(): ص32 {\n    ليكن النص_الناتج: نص = طبيعي_إلى_نص(3);\n    أرجع 0;\n}\n",
        "SULTANC-NAME-UNKNOWN", "import-module", "machine-applicable", 1, 0); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "deref", "عرف الرئيسية(): ص32 {\n    ليكن العدد: ص32 = 3;\n    ليكن المرجع: &ص32 = &العدد;\n    ليكن القيمة: ص32 = المرجع;\n    أرجع القيمة;\n}\n",
        "SULTANC-TYPE-MISMATCH", "dereference", "machine-applicable", 3, 23); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "borrow", "عرف خذ(القيمة: &ص32): ص32 {\n    أرجع *القيمة;\n}\nعرف الرئيسية(): ص32 {\n    ليكن العدد: ص32 = 3;\n    أرجع خذ(العدد);\n}\n",
        "SULTANC-CALL-ARGUMENT-TYPE-MISMATCH", "borrow", "maybe-incorrect", 5, 12); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "cast", "عرف الرئيسية(): ص32 {\n    ليكن العدد: ص32 = 3;\n    ليكن ن: نص = \"😀\"; ليكن الصغير: ط8 = العدد;\n    أرجع 0;\n}\n",
        "SULTANC-TYPE-MISMATCH", "explicit-cast", "maybe-incorrect", 2, 41); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "semicolon", "عرف الرئيسية(): ص32 {\n    ليكن الأول: ص32 = 3\n    أرجع الأول;\n}\n",
        "SULTANC-PARSE-SYNTAX", "insert-semicolon", "machine-applicable", 1, 23); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "keyword", "عرف الرئيسية(): ص32 {\n    ليكن أ: ص32 = 3;\n    أرجغ أ;\n}\n",
        "SULTANC-PARSE-KEYWORD-TYPO", "replace-keyword-spelling", "machine-applicable", 2, 4); };
    // `()` بعد منشئ بلا حمولة مستعمل قيمةً؛ وبعد التطبيق يُستدعى المنشئ.
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "constructor", "نوع لون = | أحمر | أخضر;\nعرف الرئيسية(): ص32 {\n    ليكن ل: لون = لون.أحمر;\n    أرجع 0;\n}\n",
        "SULTANC-NAME-CONSTRUCTOR-NOT-CALLED", "call-constructor", "machine-applicable", 2, 26); };
    ليكن المحذوف: نتيجة عدد, عدد = احذف_الشجرة(&الدليل);
    إذا (ر != 0) { أرجع ر; };
    // لكل مفتاح مساعدة نوع آلي مختلف.
    ليكن المفاتيح: متجه مفتاح_صياغة = كل_مفاتيح_الصياغة();
    ليكن الأنواع: متغير متجه نص = [];
    ليكن ن: متغير طبيعي = 0;
    طالما (ن < (الطول(المفاتيح) مثل طبيعي)) {
        طابق نوع_اقتراح_آلي(المفاتيح[ن]) مع
        | اختياري.موجود(الآلي) -> {
            ليكن ق: متغير طبيعي = 0;
            طالما (ق < (الطول(الأنواع) مثل طبيعي)) {
                إذا (نصان_متساويان(&الأنواع[ق], &الآلي)) { أرجع افشل(30, الآلي); };
                ق := ق + 1;
            }
            ألحق(الأنواع, الآلي);
        }
        | اختياري.لا_شيء -> { };
        ن := ن + 1;
    }
    إذا ((الطول(الأنواع) مثل طبيعي) != 25) { أرجع 31; };
    أرجع 0;
}
