// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_suggestion_roundtrip.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.io.print;
استورد std.fs.temporary;
استورد std.fs.write_file;
استورد std.fs.walk;
استورد std.encoding.positions;
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.registry;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.engine;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.suggestions;

// The structured suggestions an editor reads (diagnostics/suggestions.sn),
// in Arabic sources: the edits are written with the Arabic keywords
// (`متغير`, `استورد`, `مثل`) and the positions count Arabic letters and a
// character outside the BMP as an LSP client does. A machine-applicable
// suggestion is applied and the file then compiles.

عرف افشل(الرمز: عدد, النص: نص): عدد {
    دع أ: نتيجة عدد, عدد = اطبع_خطأ(النص);
    دع ب: نتيجة عدد, عدد = اطبع_خطأ("\n");
    أرجع الرمز;
}

عرف أخطاء(المسار: &نص): اختياري مجموعة_تشخيصات {
    دع الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.موجود(مجموعة_تشخيصات_جديدة()); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز(الإعداد) -> {
        طابق الإعداد مع
        | { البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ } -> {
            دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: خطأ };
            // لهدف المضيف كما يحلل خادم LSP: std.io مشروطة بالهدف.
            دع الهدف: متغير اختياري واصف_هدف = اختياري.لا_شيء();
            طابق حل_هدف_المضيف_المسجل() مع
            | نتيجة_حل_هدف.محلول(الوصف) -> { الهدف := اختياري.موجود(الوصف); }
            | نتيجة_حل_هدف.غير_مسجل -> { };
            دع المزيد: متجه مفتاح_وحدة_مقنن = [];
            دع الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
            طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, الهدف, &المزيد, &متغير الإلغاء) مع
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { أرجع اختياري.موجود(مجموعة_تشخيصات_جديدة()); }
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(الموجودة) -> { أرجع اختياري.موجود(الموجودة); }
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
                إذا (الواجهة.تشخيصات_الأدوات.عدد_الأخطاء > 0) { أرجع اختياري.موجود(انسخ_مملوكا_مجموعة_تشخيصات(&الواجهة.تشخيصات_الأدوات)); };
                أرجع اختياري.لا_شيء();
            };
        };
    };
}

عرف افحص_حالة(الدليل: &نص, الاسم: نص, المصدر: نص, الكود: نص, النوع: نص,
               القابلية: نص, السطر: عدد, المحرف: عدد): عدد {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(الدليل));
    ألحق(البايتات, 0x2F);
    ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&الاسم));
    ألحق(البايتات, 0x2E);
    ألحق(البايتات, 0x73);
    ألحق(البايتات, 0x6E);
    دع المسار: نص = البايتات مثل نص;
    طابق اكتب_الملف(&المسار, &المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع افشل(10, المسار); }
    | نتيجة.نجح(_) -> { };
    طابق أخطاء(&المسار) مع
    | اختياري.لا_شيء -> { أرجع افشل(11, الاسم); }
    | اختياري.موجود(الموجودة) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الموجودة.التشخيصات) مثل طبيعي)) {
            دع التعريف: تعريف_تشخيص = تعريف_التشخيص(الموجودة.التشخيصات[ف].المعرف);
            إذا (نصان_متساويان(&التعريف.الكود, &الكود)) {
                دع العربية: متجه اقتراح_تشخيص = اقتراحات_تشخيص(&الموجودة.التشخيصات[ف], لغة_تشخيص.العربية());
                دع الإنجليزية: متجه اقتراح_تشخيص = اقتراحات_تشخيص(&الموجودة.التشخيصات[ف], لغة_تشخيص.الإنجليزية());
                دع ي: متغير طبيعي = 0;
                طالما (ي < (الطول(العربية) مثل طبيعي)) {
                    طابق العربية[ي].النوع_الآلي مع
                    | اختياري.موجود(الآلي) -> {
                        إذا (نصان_متساويان(&الآلي, &النوع)) {
                            إذا (!نصان_متساويان(&العربية[ي].القابلية_الآلية, &القابلية)) { أرجع افشل(13, الاسم); };
                            إذا ((الطول(العربية[ي].الرسالة) مثل طبيعي) == 0 || (الطول(الإنجليزية[ي].الرسالة) مثل طبيعي) == 0) { أرجع افشل(14, الاسم); };
                            إذا (نصان_متساويان(&العربية[ي].الرسالة, &الإنجليزية[ي].الرسالة)) { أرجع افشل(15, الاسم); };
                            إذا (السطر >= 0) {
                                طابق العربية[ي].التعديلات[0].البداية مع
                                | اختياري.موجود(البداية) -> {
                                    إذا ((البداية.السطر مثل عدد) != السطر || (البداية.العمود مثل عدد) != المحرف) { أرجع افشل(16, الاسم); };
                                }
                                | اختياري.لا_شيء -> { أرجع افشل(16, الاسم); };
                            };
                            دع آلي: نص = "machine-applicable";
                            إذا (!نصان_متساويان(&القابلية, &آلي)) { أرجع 0; };
                            طابق طبق_اقتراحا_على_نص(&المصدر, &العربية[ي]) مع
                            | اختياري.لا_شيء -> { أرجع افشل(17, الاسم); }
                            | اختياري.موجود(المصلح) -> {
                                طابق اكتب_الملف(&المسار, &المصلح) مع
                                | نتيجة.خطأ(_) -> { أرجع افشل(18, المسار); }
                                | نتيجة.نجح(_) -> { };
                                طابق أخطاء(&المسار) مع
                                | اختياري.لا_شيء -> { أرجع 0; }
                                | اختياري.موجود(بعده) -> {
                                    دع ك: متغير طبيعي = 0;
                                    طالما (ك < (الطول(بعده.التشخيصات) مثل طبيعي)) {
                                        دع ت: تعريف_تشخيص = تعريف_التشخيص(بعده.التشخيصات[ك].المعرف);
                                        دع م: نتيجة عدد, عدد = اطبع_خطأ(انسخ_نص(&ت.الكود));
                                        ك := ك + 1;
                                    }
                                    أرجع افشل(19, المصلح);
                                };
                            };
                        };
                    }
                    | اختياري.لا_شيء -> { };
                    ي := ي + 1;
                }
                أرجع افشل(12, الاسم);
            };
            ف := ف + 1;
        }
        دع ز: متغير طبيعي = 0;
        طالما (ز < (الطول(الموجودة.التشخيصات) مثل طبيعي)) {
            دع آخر: تعريف_تشخيص = تعريف_التشخيص(الموجودة.التشخيصات[ز].المعرف);
            دع معروض: نتيجة عدد, عدد = اطبع_خطأ(انسخ_نص(&آخر.الكود));
            ز := ز + 1;
        }
        أرجع افشل(20, الاسم);
    };
}

عرف الرئيسية(): عدد {
    دع البادئة: نص = "sultanc-suggest-ar-";
    دع الدليل: متغير نص = "";
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المصنوع) -> { الدليل := المصنوع; };
    دع ر: متغير عدد = 0;
    ر := افحص_حالة(&الدليل, "mutable", "عرف الرئيسية(): ص32 {\n    دع العدد: ص32 = 3;\n    العدد := 4;\n    أرجع العدد;\n}\n",
        "SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE", "declare-mutable", "machine-applicable", 1, 14);
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "import", "استورد std.text.format;\nعرف الرئيسية(): ص32 {\n    دع النص_الناتج: نص = طبيعي_إلى_نص(3);\n    أرجع 0;\n}\n",
        "SULTANC-NAME-UNKNOWN", "import-module", "machine-applicable", 1, 0); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "deref", "عرف الرئيسية(): ص32 {\n    دع العدد: ص32 = 3;\n    دع المرجع: &ص32 = &العدد;\n    دع القيمة: ص32 = المرجع;\n    أرجع القيمة;\n}\n",
        "SULTANC-TYPE-MISMATCH", "dereference", "machine-applicable", 3, 21); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "borrow", "عرف خذ(القيمة: &ص32): ص32 {\n    أرجع *القيمة;\n}\nعرف الرئيسية(): ص32 {\n    دع العدد: ص32 = 3;\n    أرجع خذ(العدد);\n}\n",
        "SULTANC-CALL-ARGUMENT-TYPE-MISMATCH", "borrow", "maybe-incorrect", 5, 12); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "cast", "عرف الرئيسية(): ص32 {\n    دع العدد: ص32 = 3;\n    دع ن: نص = \"😀\"; دع الصغير: ط8 = العدد;\n    أرجع 0;\n}\n",
        "SULTANC-TYPE-MISMATCH", "explicit-cast", "maybe-incorrect", 2, 37); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "semicolon", "عرف الرئيسية(): ص32 {\n    دع الأول: ص32 = 3\n    أرجع الأول;\n}\n",
        "SULTANC-PARSE-SYNTAX", "insert-semicolon", "machine-applicable", 1, 21); };
    إذا (ر == 0) { ر := افحص_حالة(&الدليل, "keyword", "عرف الرئيسية(): ص32 {\n    دع أ: ص32 = 3;\n    أرجغ أ;\n}\n",
        "SULTANC-PARSE-KEYWORD-TYPO", "replace-keyword-spelling", "machine-applicable", 2, 4); };
    دع المحذوف: نتيجة عدد, عدد = احذف_الشجرة(&الدليل);
    إذا (ر != 0) { أرجع ر; };
    // لكل مفتاح مساعدة نوع آلي مختلف.
    دع المفاتيح: متجه مفتاح_صياغة = كل_مفاتيح_الصياغة();
    دع الأنواع: متغير متجه نص = [];
    دع ن: متغير طبيعي = 0;
    طالما (ن < (الطول(المفاتيح) مثل طبيعي)) {
        طابق نوع_اقتراح_آلي(المفاتيح[ن]) مع
        | اختياري.موجود(الآلي) -> {
            دع ق: متغير طبيعي = 0;
            طالما (ق < (الطول(الأنواع) مثل طبيعي)) {
                إذا (نصان_متساويان(&الأنواع[ق], &الآلي)) { أرجع افشل(30, الآلي); };
                ق := ق + 1;
            }
            ألحق(الأنواع, الآلي);
        }
        | اختياري.لا_شيء -> { };
        ن := ن + 1;
    }
    إذا ((الطول(الأنواع) مثل طبيعي) != 22) { أرجع 31; };
    أرجع 0;
}
