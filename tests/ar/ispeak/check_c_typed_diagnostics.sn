// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_c_typed_diagnostics.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.io.print;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.message;
استورد compiler.diagnostics.foreign_c;
استورد compiler.source.source_file;

// Typed C diagnostics (diagnostics/foreign_c.sn): Jisr hands over an
// identity, a C reason, typed facts and BYTE columns with the source line;
// iSpeak words them in both languages, and the character columns are derived
// from the line (a two-byte letter before the column counts once).
عرف متطابق(الفعلي: نص, المتوقع: نص): منطقي {
    إذا (نصان_متساويان(&الفعلي, &المتوقع)) { أرجع صواب; };
    دع مهمل: نتيجة عدد, عدد = اطبع_خطأ(الفعلي);
    دع سطر: نتيجة عدد, عدد = اطبع_خطأ("\n");
    أرجع خطأ;
}

عرف الرئيسية(): عدد {
    // `é` is two bytes: the byte column 6 of `  é foo_t x;` is character column 5 (0-based 4).
    دع الموقع: موقع_سي = موقع_سي_جديد("lib.h", 3, 6, 5, "  é foo_t x;");
    دع التشخيص: متغير تشخيص_سي_منظم = تشخيص_سي_منظم_جديد(
        معرف_تشخيص.سي_اسم_نوع_مجهول(), سبب_تشخيص.سبب_سي_اسم_نوع_مجهول(), الموقع
    );
    أضف_رمز_سي(&متغير التشخيص, "foo_t");
    أضف_موقع_تضمين_سي(&متغير التشخيص, موقع_سي_جديد("main.h", 1, 1, 0, "#include \"lib.h\""));
    أبلغ_تشخيص_سي_منظم(التشخيص);
    // The same report again (a C file read twice) is reported once.
    دع المكرر: متغير تشخيص_سي_منظم = تشخيص_سي_منظم_جديد(
        معرف_تشخيص.سي_اسم_نوع_مجهول(), سبب_تشخيص.سبب_سي_اسم_نوع_مجهول(),
        موقع_سي_جديد("lib.h", 3, 6, 5, "  é foo_t x;")
    );
    أضف_رمز_سي(&متغير المكرر, "foo_t");
    أبلغ_تشخيص_سي_منظم(المكرر);
    دع التحذير: متغير تشخيص_سي_منظم = تشخيص_سي_منظم_جديد(
        معرف_تشخيص.سي_ماكرو_غير_ثابت(), سبب_تشخيص.سبب_سي_مخطى_ماكرو_دالي(),
        موقع_سي_جديد("lib.h", 7, 9, 3, "#define MAX(a, b) a")
    );
    أضف_رمز_سي(&متغير التحذير, "MAX");
    أبلغ_تشخيص_سي_منظم(التحذير);

    دع المعلقة: متجه تشخيص = اسحب_تشخيصات_سي();
    إذا (الطول(المعلقة) != 2) { أرجع 1; };
    إذا (المعلقة[0].المعرف != معرف_تشخيص.سي_اسم_نوع_مجهول()) { أرجع 2; };
    طابق المعلقة[0].المصدر_الرئيسي مع
    | اختياري.موجود(النطاق) -> {
        طابق النطاق.بداية_العرض مع
        | اختياري.موجود(البداية) -> {
            إذا (البداية.السطر != 3 || البداية.العمود != 4) { أرجع 3; };
        }
        | اختياري.لا_شيء -> { أرجع 3; };
        طابق النطاق.نهاية_العرض مع
        | اختياري.موجود(النهاية) -> { إذا (النهاية.العمود != 9) { أرجع 4; }; }
        | اختياري.لا_شيء -> { أرجع 4; };
    }
    | اختياري.لا_شيء -> { أرجع 3; };
    إذا (length(المعلقة[0].النطاقات_المرتبطة) != 1) { أرجع 5; };
    إذا (المعلقة[0].النطاقات_المرتبطة[0].الدور != دور_نطاق_تشخيص.مضمن_من()) { أرجع 5; };
    إذا (!متطابق(نص_رسالة_تشخيص(&المعلقة[0], لغة_تشخيص.الإنجليزية()), "unknown C type name — The C name is `foo_t`. No type of this name is declared.")) { أرجع 6; };
    إذا (!متطابق(نص_رسالة_تشخيص(&المعلقة[0], لغة_تشخيص.العربية()), "اسم نوع سي مجهول — اسم سي هو `foo_t`. لا نوع مصرحا بهذا الاسم.")) { أرجع 7; };
    إذا (!متطابق(نص_رسالة_تشخيص(&المعلقة[1], لغة_تشخيص.الإنجليزية()), "C macro is not a constant — The C name is `MAX`. A function-like macro is not a constant, so it is not imported.")) { أرجع 8; };
    إذا (!متطابق(نص_رسالة_تشخيص(&المعلقة[1], لغة_تشخيص.العربية()), "ماكرو سي ليس ثابتا — اسم سي هو `MAX`. الماكرو الدالي ليس ثابتا فلا يستورد.")) { أرجع 9; };
    أرجع 0;
}
