// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_interpreter_external_call.sn
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.دخ.اطبع;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.diagnostics.schema;
استورد compiler.diagnostics.message;
استورد compiler.interpreter.runtime_failures;
استورد compiler.interpreter.diagnostic_translation;
استورد compiler.msir.identifiers;
استورد compiler.msir.debug_contract;
استورد compiler.source.source_map;
استورد compiler.source.provenance;

// An external function the interpreter cannot call is reported under
// SULTANC-INTERPRETER-UNSUPPORTED-EXTERNAL-CALL and named by its symbol in
// the external-function sentence: never as a compilation target, and never
// by its MSIR number as the affected function.
عرف يحوي(النص: نص, الجزء: نص): منطقي {
    إذا (يحتوي_نصا(&النص, &الجزء)) { أرجع صواب; };
    دع مهمل: نتيجة عدد, عدد = اطبع_خطأ(النص);
    دع سطر: نتيجة عدد, عدد = اطبع_خطأ("\n");
    أرجع خطأ;
}

عرف يخلو_من(النص: نص, الجزء: نص): منطقي {
    إذا (!يحتوي_نصا(&النص, &الجزء)) { أرجع صواب; };
    دع مهمل: نتيجة عدد, عدد = اطبع_خطأ(النص);
    دع سطر: نتيجة عدد, عدد = اطبع_خطأ("\n");
    أرجع خطأ;
}

عرف الرئيسية(): عدد {
    دع النداءات: متجه موقع_فشل_تفسير_مسير = [];
    دع الفشل: فشل_تفسير_موضعي = {
        الفشل: فشل_تفسير_مسير.وقت_تشغيل(
            خطأ_وقت_تشغيل_مفسر.نداء_خارجي_غير_مدعوم(
                معرف_دالة_خارجية_مسير_من(1), بايتات_من_نص(«fd_write»)
            )
        ),
        الموقع: اختياري.لا_شيء(),
        النداءات: النداءات,
        المنفذ: 0
    };
    دع المصادر: خريطة_مصادر = خريطة_مصادر_جديدة();
    دع الأصول: سجل_أصول_مصدر = سجل_أصول_مصدر_جديد();
    دع التصحيح: بيانات_تصحيح_مسير = بيانات_تصحيح_مسير_جديدة();
    دع المجموعة: مجموعة_تشخيصات = حول_فشل_تفسير_مسير_إلى_تشخيصات(&الفشل, &المصادر, &الأصول, &التصحيح);
    إذا (الطول(المجموعة.التشخيصات) != 1) { أرجع 1; };
    إذا (المجموعة.التشخيصات[0].المعرف != معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم()) { أرجع 2; };

    دع الإنجليزي: نص = نص_رسالة_تشخيص(&المجموعة.التشخيصات[0], لغة_تشخيص.الإنجليزية());
    إذا (!يحوي(الإنجليزي, «The external function is »)) { أرجع 3; };
    إذا (!يحوي(الإنجليزي, «fd_write»)) { أرجع 4; };
    إذا (!يخلو_من(الإنجليزي, «compilation target»)) { أرجع 5; };
    إذا (!يخلو_من(الإنجليزي, «affected function»)) { أرجع 6; };

    دع العربي: نص = نص_رسالة_تشخيص(&المجموعة.التشخيصات[0], لغة_تشخيص.العربية());
    إذا (!يحوي(العربي, «الدالة الخارجية هي »)) { أرجع 7; };
    إذا (!يحوي(العربي, «fd_write»)) { أرجع 8; };
    إذا (!يخلو_من(العربي, «هدف التجميع»)) { أرجع 9; };
    إذا (!يخلو_من(العربي, «الدالة المتأثرة»)) { أرجع 10; };
    أرجع 0;
}
