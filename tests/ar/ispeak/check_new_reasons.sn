// Current contextual-reason mappings must match their machine reason semantics.
عرف تحقق_سبب(السبب: سبب_تشخيص, الإنجليزي: نص, العربي: نص): منطقي {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(السبب);
    دع الفعلي_الإنجليزي: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
    دع الفعلي_العربي: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), المفتاح);
    أرجع نصان_متساويان(&الفعلي_الإنجليزي, &الإنجليزي) && نصان_متساويان(&الفعلي_العربي, &العربي);
}

