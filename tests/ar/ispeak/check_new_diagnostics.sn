    إذا (!نفس_الرسالة(لغة_تشخيص.العربية(), مفتاح_609, «يمرر نداء وقت الترجمة عددا غير صحيح من حجج وقت الترجمة»)) { أرجع 88; };
    دع مفتاح_610: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نداء_خارجي_تفسير_غير_مدعوم());
