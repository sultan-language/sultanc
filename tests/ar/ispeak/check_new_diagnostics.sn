// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_new_diagnostics.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

عرف نفس_الرسالة(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, المتوقع: نص): منطقي {
    دع الفعلي: نص = رسالة_تشخيص(اللغة, المفتاح);
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف نفس_الرسالة_بحجج(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة, المتوقع: نص): منطقي {
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحقائق) مع
    | اختياري.موجود(الفعلي) -> { أرجع نصان_متساويان(&الفعلي, &المتوقع); }
    | _ -> { أرجع خطأ; };
}

عرف قيم_ربط(): حقائق_ربط_إل_إل_في_إم {
    دع القيم: حقائق_ربط_إل_إل_في_إم = { الهدف: «x86_64-linux», الرمز: «LLVMGetVersion» };
    أرجع القيم;
}

عرف قيم_فشل(): حقائق_فشل_وقت_الترجمة {
    دع القيم: حقائق_فشل_وقت_الترجمة = { الرسالة: «compile_error was called» };
    أرجع القيم;
}

