// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_dynamic_quoting.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Quoted facts must not introduce a delimiter, line break or terminal control.
// UTF-8 text outside ASCII controls remains byte-for-byte unchanged.
عرف تحقق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة, المتوقع: نص): منطقي {
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحقائق) مع
    | اختياري.موجود(الناتج) -> { أرجع نصان_متساويان(&الناتج, &المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف حقائق_اسم(الاسم: &نص): حقائق_اسم_غير_معروف {
    دع القيم: حقائق_اسم_غير_معروف = { الاسم: انسخ_نص(الاسم) };
    أرجع القيم;
}

عرف النوع(الاسم: &نص): حقائق_نوعان_غير_متوافقين {
    دع القيم: حقائق_نوعان_غير_متوافقين = { المتوقع: انسخ_نص(الاسم), الموجود: «f`32» };
    أرجع القيم;
}

عرف نص_الخيار(الاسم: &نص): حقائق_نص_محدد {
    دع القيم: حقائق_نص_محدد = { القيمة: انسخ_نص(الاسم) };
    أرجع القيم;
}

عرف حقيقة_تحكم(نص_تحكم: &نص): حقائق_اسم_غير_معروف {
    دع القيم: حقائق_اسم_غير_معروف = { الاسم: انسخ_نص(نص_تحكم) };
    أرجع القيم;
}

عرف الرئيسية(): عدد {
    دع بايتات: متغير متجه ط8 = [];
    ألحق_بايتات_نص(&متغير بايتات, «a`b\\»);
    ألحق(بايتات, 0x0A);
    ألحق(بايتات, 0x0D);
    ألحق(بايتات, 0x09);
    ألحق(بايتات, 0x1B);
    ألحق(بايتات, 0x7F);
    ألحق_بايتات_نص(&متغير بايتات, «ع»);
    دع الاسم: نص = من_بايتات(&بايتات);
    دع مفتاح_اسم: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف());
    لو (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_اسم, حقائق_رسالة.اسم_غير_معروف(حقائق_اسم(&الاسم)), «unknown name: `a\`b\\\\\n\r\t\x1B\x7Fع`»)) { أرجع 1; };
    لو (!تحقق(لغة_تشخيص.العربية(), مفتاح_اسم, حقائق_رسالة.اسم_غير_معروف(حقائق_اسم(&الاسم)), «الاسم `a\`b\\\\\n\r\t\x1B\x7Fع` غير معروف»)) { أرجع 2; };

    دع مفتاح_نوع: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوعان_غير_متوافقين());
    لو (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_نوع, حقائق_رسالة.نوعان_غير_متوافقين(النوع(&الاسم)), «expected `a\`b\\\\\n\r\t\x1B\x7Fع`, found `f\`32`»)) { أرجع 3; };
    لو (!تحقق(لغة_تشخيص.العربية(), مفتاح_نوع, حقائق_رسالة.نوعان_غير_متوافقين(النوع(&الاسم)), «النوع الموجود `f\`32` لا يطابق النوع المتوقع `a\`b\\\\\n\r\t\x1B\x7Fع`»)) { أرجع 4; };

    دع مفتاح_خيار: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خيار_مترجم_غير_معروف());
    لو (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_خيار, حقائق_رسالة.نص_محدد(نص_الخيار(&الاسم)), «unknown option `a\`b\\\\\n\r\t\x1B\x7Fع`»)) { أرجع 5; };
    لو (!تحقق(لغة_تشخيص.العربية(), مفتاح_خيار, حقائق_رسالة.نص_محدد(نص_الخيار(&الاسم)), «خيار غير معروف `a\`b\\\\\n\r\t\x1B\x7Fع`»)) { أرجع 6; };

    // Exhaustive ASCII C0 and DEL bytes, including embedded NUL.
    دع رموز_تحكم: متغير متجه ط8 = [];
    دع ب: متغير ط8 = 0;
    طالما (ب < (32 مثل ط8)) {
        ألحق(رموز_تحكم, ب);
        ب := ب + (1 مثل ط8);
    }
    ألحق(رموز_تحكم, 0x7F);
    دع نص_تحكم: نص = من_بايتات(&رموز_تحكم);
    لو (!تحقق(لغة_تشخيص.الإنجليزية(), مفتاح_اسم, حقائق_رسالة.اسم_غير_معروف(حقيقة_تحكم(&نص_تحكم)), «unknown name: `\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0B\x0C\r\x0E\x0F\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1A\x1B\x1C\x1D\x1E\x1F\x7F`»)) { أرجع 7; };
    لو (!تحقق(لغة_تشخيص.العربية(), مفتاح_اسم, حقائق_رسالة.اسم_غير_معروف(حقيقة_تحكم(&نص_تحكم)), «الاسم `\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0B\x0C\r\x0E\x0F\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1A\x1B\x1C\x1D\x1E\x1F\x7F` غير معروف»)) { أرجع 8; };
    أرجع 0;
}
