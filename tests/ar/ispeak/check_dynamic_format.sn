// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_dynamic_format.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;
استورد compiler.ispeak.keys.surface;

عرف يطابق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_رسالة, المتوقع: نص): منطقي {
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, الحقائق) مع
    | اختياري.موجود(الناتج) -> { أرجع نصان_متساويان(&الناتج, &المتوقع); }
    | _ -> { أرجع خطأ; };
}

عرف السياق(): حقائق_سياق_رسالة {
    دع القيم: حقائق_سياق_رسالة = {
        القيمة: اختياري.موجود(قيمة_حجة_رسالة.موقعة(-2)),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.موجود(قيمة_حجة_رسالة.منطقية(خطأ)),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.موجود(قيمة_حجة_رسالة.نصية(«/tmp/example.sn»)),
        الرمز: اختياري.لا_شيء(),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(«msir-verifier»)),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(7 مثل طبيعي)),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.موجود(قيمة_حجة_رسالة.نصية(«add»)),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.موجود(قيمة_حجة_رسالة.سبب_محدد(سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح()))
    };
    أرجع القيم;
}

عرف السياق_الفارغ(): حقائق_سياق_رسالة {
    دع القيم: حقائق_سياق_رسالة = {
        القيمة: اختياري.لا_شيء(),
        المتوقع: اختياري.لا_شيء(),
        الاستبدال: اختياري.لا_شيء(),
        الموجود: اختياري.لا_شيء(),
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: اختياري.لا_شيء(),
        الرمز: اختياري.لا_شيء(),
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: اختياري.لا_شيء(),
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: اختياري.لا_شيء()
    };
    أرجع القيم;
}

عرف كل_الحقائق(): حقائق_سياق_رسالة {
    دع القيم: حقائق_سياق_رسالة = {
        القيمة: اختياري.موجود(قيمة_حجة_رسالة.موقعة(-4)),
        المتوقع: اختياري.موجود(قيمة_حجة_رسالة.نصية(«i32»)),
        الاستبدال: اختياري.موجود(قيمة_حجة_رسالة.نصية(«return»)),
        الموجود: اختياري.موجود(قيمة_حجة_رسالة.نصية(«f64»)),
        الفهرس: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(9 مثل طبيعي)),
        الطول: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي)),
        المجال: اختياري.موجود(قيمة_حجة_رسالة.نصية(«0..11»)),
        النمط: اختياري.موجود(قيمة_حجة_رسالة.نصية(«_»)),
        المسار: اختياري.موجود(قيمة_حجة_رسالة.نصية(«module.sn»)),
        الرمز: اختياري.موجود(قيمة_حجة_رسالة.نصية(«foo»)),
        النوع: اختياري.موجود(قيمة_حجة_رسالة.نصية(«i32»)),
        السياق: اختياري.موجود(قيمة_حجة_رسالة.نصية(«initialization»)),
        المرحلة: اختياري.موجود(قيمة_حجة_رسالة.نصية(«lowering»)),
        الهدف: اختياري.موجود(قيمة_حجة_رسالة.نصية(«arm64-darwin»)),
        الدالة: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(20 مثل طبيعي)),
        الكتلة: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي)),
        التعليمة: اختياري.موجود(قيمة_حجة_رسالة.طبيعية(10 مثل طبيعي)),
        العملية: اختياري.موجود(قيمة_حجة_رسالة.نصية(«copy»)),
        البدائي: اختياري.موجود(قيمة_حجة_رسالة.نصية(«read»)),
        المصدر: اختياري.موجود(قيمة_حجة_رسالة.نصية(«src»)),
        الوجهة: اختياري.موجود(قيمة_حجة_رسالة.نصية(«dst»)),
        السبب: اختياري.موجود(قيمة_حجة_رسالة.سبب_محدد(سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح()))
    };
    أرجع القيم;
}

عرف الرئيسية(): عدد {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    دع الرسالة_الإنجليزية: نص = «invalid MSIR — The supplied value is -2. The actual result is `false`. The affected path is `/tmp/example.sn`. This occurred during phase `msir-verifier`. The affected function is 7. The operation is `add`. MSIR switch selector is not an integer.»;
    دع الرسالة_العربية: نص = «مسير غير صالح — القيمة المقدمة هي -2. النتيجة الفعلية هي `خطأ`. المسار المتأثر هو `/tmp/example.sn`. حدث ذلك خلال المرحلة `msir-verifier`. الدالة المتأثرة هي 7. العملية هي `add`. مميز الفرع المتعدد في MSIR ليس عددا صحيحا.»;
    دع حقائق_إنجليزية: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(السياق());
    لو (!يطابق(لغة_تشخيص.الإنجليزية(), المفتاح, حقائق_إنجليزية, الرسالة_الإنجليزية)) { أرجع 1; };
    دع حقائق_عربية: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(السياق());
    لو (!يطابق(لغة_تشخيص.العربية(), المفتاح, حقائق_عربية, الرسالة_العربية)) { أرجع 2; };
    دع بلا_قيم: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(السياق_الفارغ());
    دع المتوقع: نص = «invalid MSIR»;
    لو (!يطابق(لغة_تشخيص.الإنجليزية(), المفتاح, بلا_قيم, المتوقع)) { أرجع 3; };
    دع بلا_قيم_عربية: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(السياق_الفارغ());
    دع المتوقع_عربي: نص = «مسير غير صالح»;
    لو (!يطابق(لغة_تشخيص.العربية(), المفتاح, بلا_قيم_عربية, المتوقع_عربي)) { أرجع 4; };
    دع كل_الإنجليزية: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(كل_الحقائق());
    دع النص_الكامل_الإنجليزية: نص = «invalid MSIR — The supplied value is -4. The expected result is `i32`, but the actual result is `f64`. The suggested replacement is `return`. The index is 9. The length is 11. The relevant range is `0..11`. The pattern is `_`. The affected path is `module.sn`. The symbol is `foo`. The type is `i32`. This occurred in context `initialization`. This occurred during phase `lowering`. The compilation target is `arm64-darwin`. The affected function is 20. The affected block is 3. The affected instruction is 10. The operation is `copy`. The host primitive is `read`. The source value is `src`. The destination value is `dst`. MSIR switch selector is not an integer.»;
    لو (!يطابق(لغة_تشخيص.الإنجليزية(), المفتاح, كل_الإنجليزية, النص_الكامل_الإنجليزية)) { أرجع 5; };
    دع كل_العربية: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(كل_الحقائق());
    دع النص_الكامل_العربية: نص = «مسير غير صالح — القيمة المقدمة هي -4. النتيجة المتوقعة هي `i32`، لكن النتيجة الفعلية هي `f64`. البديل المقترح هو `return`. الفهرس هو 9. الطول هو 11. المجال المعني هو `0..11`. النمط هو `_`. المسار المتأثر هو `module.sn`. الرمز هو `foo`. النوع هو `i32`. حدث ذلك في سياق `initialization`. حدث ذلك خلال المرحلة `lowering`. هدف التجميع هو `arm64-darwin`. الدالة المتأثرة هي 20. الكتلة المتأثرة هي 3. التعليمة المتأثرة هي 10. العملية هي `copy`. العملية البدائية للمضيف هي `read`. قيمة المصدر هي `src`. قيمة الوجهة هي `dst`. مميز الفرع المتعدد في MSIR ليس عددا صحيحا.»;
    لو (!يطابق(لغة_تشخيص.العربية(), المفتاح, كل_العربية, النص_الكامل_العربية)) { أرجع 6; };
    طابق نص_تفصيل_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_صياغة.تسمية_متوقع(), كل_الحقائق()) مع
    | اختياري.موجود(النص) -> {
        دع البداية: نص = «expected — The supplied value is  -4.. The expected result is  i32.»;
        // Verify initial fields; the formatter must not ignore structured facts.
        لو ((الطول(النص) مثل طبيعي) <= (الطول(البداية) مثل طبيعي)) { أرجع 7; };
    }
    | _ -> { أرجع 8; };
    طابق نص_المترجم_بحجج(لغة_تشخيص.العربية(), مفتاح_نص_مترجم.وصف_نهاية_الملف(), السياق_الفارغ()) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع_الوصف: نص = «نهاية الملف»;
        لو (!نصان_متساويان(&النص, &المتوقع_الوصف)) { أرجع 9; };
    }
    | _ -> { أرجع 10; };
    طابق شرح_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), معرف_تشخيص.خطأ_نحوي(), السياق_الفارغ()) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع_الشرح: نص = شرح_تشخيص(لغة_تشخيص.الإنجليزية(), معرف_تشخيص.خطأ_نحوي());
        لو (!نصان_متساويان(&النص, &المتوقع_الشرح)) { أرجع 11; };
    }
    | _ -> { أرجع 12; };
    أرجع 0;
}
