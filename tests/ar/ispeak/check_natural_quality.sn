// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_natural_quality.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// A small source-backed semantic sample: test full sentences, not merely
// longer strings or reversible numeric IDs.
عرف سياق_محدد(
    القيمة: اختياري قيمة_حجة_رسالة,
    المسار: اختياري قيمة_حجة_رسالة,
    الرمز: اختياري قيمة_حجة_رسالة,
    السبب: اختياري قيمة_حجة_رسالة,
    الهدف: اختياري قيمة_حجة_رسالة,
    المتوقع: اختياري قيمة_حجة_رسالة,
    الموجود: اختياري قيمة_حجة_رسالة
): حقائق_سياق_رسالة {
    دع البيانات: حقائق_سياق_رسالة = {
        القيمة: القيمة,
        المتوقع: المتوقع,
        الاستبدال: اختياري.لا_شيء(),
        الموجود: الموجود,
        الفهرس: اختياري.لا_شيء(),
        الطول: اختياري.لا_شيء(),
        المجال: اختياري.لا_شيء(),
        النمط: اختياري.لا_شيء(),
        المسار: المسار,
        الرمز: الرمز,
        النوع: اختياري.لا_شيء(),
        السياق: اختياري.لا_شيء(),
        المرحلة: اختياري.لا_شيء(),
        الهدف: الهدف,
        الدالة: اختياري.لا_شيء(),
        الكتلة: اختياري.لا_شيء(),
        التعليمة: اختياري.لا_شيء(),
        العملية: اختياري.لا_شيء(),
        البدائي: اختياري.لا_شيء(),
        المصدر: اختياري.لا_شيء(),
        الوجهة: اختياري.لا_شيء(),
        السبب: السبب
    };
    أرجع البيانات;
}

عرف تحقق(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص, الحقائق: حقائق_سياق_رسالة, المتوقع: نص): منطقي {
    دع البيانات: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(الحقائق);
    طابق رسالة_تشخيص_بحجج(اللغة, المفتاح, البيانات) مع
    | اختياري.موجود(الفعلي) -> { أرجع نصان_متساويان(&الفعلي, &المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع حجج: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق());
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(0 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي))), «call argument count does not match — The function expects no arguments, but the call passes 1 argument.»)) { أرجع 1; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(0 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة لا تتوقع أي حجة، لكن النداء يمرر حجة واحدة.»)) { أرجع 2; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي))), «call argument count does not match — The function expects 1 argument, but the call passes 2 arguments.»)) { أرجع 3; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(1 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع حجة واحدة، لكن النداء يمرر حجتين.»)) { أرجع 4; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي))), «call argument count does not match — The function expects 2 arguments, but the call passes 3 arguments.»)) { أرجع 5; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(2 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع حجتين، لكن النداء يمرر 3 حجج.»)) { أرجع 6; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي))), «call argument count does not match — The function expects 3 arguments, but the call passes 11 arguments.»)) { أرجع 7; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(3 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 3 حجج، لكن النداء يمرر 11 حجة.»)) { أرجع 8; };
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي))), «call argument count does not match — The function expects 11 arguments, but the call passes 102 arguments.»)) { أرجع 9; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجج, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(11 مثل طبيعي)), اختياري.موجود(قيمة_حجة_رسالة.طبيعية(102 مثل طبيعي))), «عدد حجج النداء غير مطابق — الدالة تتوقع 11 حجة، لكن النداء يمرر 102 حجة.»)) { أرجع 10; };
    دع الأول: نص = «i32»;
    دع الثاني: نص = «f64»;
    دع حجة: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_حجة_غير_مطابق());
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), حجة, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الأول))), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الثاني)))), «call argument type does not match — The argument was expected to have type `i32` but has type `f64`.»)) { أرجع 11; };
    إذا (!تحقق(لغة_تشخيص.العربية(), حجة, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الأول))), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الثاني)))), «نوع حجة النداء غير مطابق — نوع الحجة المتوقع هو `i32`، لكن نوع الحجة الفعلي هو `f64`.»)) { أرجع 12; };
    دع إرجاع: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_إرجاع_غير_مطابق());
    إذا (!تحقق(لغة_تشخيص.الإنجليزية(), إرجاع, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الأول))), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الثاني)))), «return type does not match — The return type was expected to be `i32` but is `f64`.»)) { أرجع 13; };
    إذا (!تحقق(لغة_تشخيص.العربية(), إرجاع, سياق_محدد(اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.لا_شيء(), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الأول))), اختياري.موجود(قيمة_حجة_رسالة.نصية(انسخ_نص(&الثاني)))), «نوع الإرجاع غير مطابق — نوع الإرجاع المتوقع هو `i32`، لكن نوع الإرجاع الفعلي هو `f64`.»)) { أرجع 14; };
    دع مقارنة_مختلة: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_انتقاء_مقارنة_ليس_منه_شرط());
    دع عبارة_عربية: نص = «يُستخدم ناتج مقارنة بطريقة لا تدعمها الخلفية الأصلية إلا كشرط تفرع»;
    دع رسالة_عربية: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), مقارنة_مختلة);
    إذا (!نصان_متساويان(&عبارة_عربية, &رسالة_عربية)) { أرجع 15; };
    دع مقارنة_غير_مدعومة: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_انتقاء_غير_مدعوم_مقارنة());
    دع عبارة_مقارنة: نص = «لا تدعم الخلفية الأصلية هذه المقارنة بعد»;
    دع رسالة_مقارنة: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), مقارنة_غير_مدعومة);
    إذا (!نصان_متساويان(&عبارة_مقارنة, &رسالة_مقارنة)) { أرجع 16; };
    أرجع 0;
}
