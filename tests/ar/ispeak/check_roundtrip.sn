// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/ispeak/check_roundtrip.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.reason;
استورد compiler.diagnostics.registry;
استورد compiler.ispeak.format.facts;
استورد compiler.diagnostics.schema;
استورد compiler.ispeak.ispeak;

// Localization is a direct typed lookup: it must yield nonempty messages.
عرف رسالة_موجودة(اللغة: لغة_تشخيص, المفتاح: مفتاح_رسالة_تشخيص): منطقي {
    دع الرسالة: نص = رسالة_تشخيص(اللغة, المفتاح);
    دع الفارغ: نص = «»;
    أرجع !نصان_متساويان(&الرسالة, &الفارغ);
}

// Exact semantic assertions: a round trip alone cannot detect permuted messages.
عرف تحقق_رسالة_محددة(المعرف: معرف_تشخيص, المتوقع_الإنجليزي: نص, المتوقع_العربي: نص): منطقي {
    دع المفتاح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(المعرف);
    دع الفعلي_الإنجليزي: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), المفتاح);
    دع الفعلي_العربي: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), المفتاح);
    لو (!نصان_متساويان(&الفعلي_الإنجليزي, &المتوقع_الإنجليزي)) { أرجع خطأ; };
    لو (!نصان_متساويان(&الفعلي_العربي, &المتوقع_العربي)) { أرجع خطأ; };
    أرجع صواب;
}

عرف قيم_الاسم(): حقائق_اسم_غير_معروف {
    دع القيم: حقائق_اسم_غير_معروف = { الاسم: «المثال» };
    أرجع القيم;
}

عرف قيم_النوع(): حقائق_نوعان_غير_متوافقين {
    دع القيم: حقائق_نوعان_غير_متوافقين = { المتوقع: «غ8», الموجود: «نص» };
    أرجع القيم;
}

عرف قيم_العدد(): حقائق_عدد_حجج_غير_مطابق {
    دع القيم: حقائق_عدد_حجج_غير_مطابق = { المتوقع: 2, الموجود: 3 };
    أرجع القيم;
}

عرف قيم_اقتراح(): حقائق_اقتراح_كلمة {
    دع القيم: حقائق_اقتراح_كلمة = { الاستبدال: «if» };
    أرجع القيم;
}

عرف الرئيسية(): عدد {
    // Every key in the typed enumeration (all public diagnostics, then all
    // reasons) yields a nonempty message in both locales, and every public
    // code round-trips to the same identity through the registry.
    دع المفاتيح_كلها: متجه مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    دع الرقم: متغير طبيعي = 0;
    دع عدد_العامة: متغير طبيعي = 0;
    طالما (الرقم < (الطول(المفاتيح_كلها) مثل طبيعي)) {
        دع المفتاح: مفتاح_رسالة_تشخيص = المفاتيح_كلها[الرقم];
        لو (!رسالة_موجودة(لغة_تشخيص.الإنجليزية(), المفتاح)) { أرجع 4; };
        لو (!رسالة_موجودة(لغة_تشخيص.العربية(), المفتاح)) { أرجع 5; };
        طابق المفتاح مع
        | مفتاح_رسالة_تشخيص.تشخيص(المعرف) -> {
            دع التعريف: تعريف_تشخيص = تعريف_التشخيص(المعرف);
            طابق معرف_تشخيص_من_كود(&التعريف.الكود) مع
            | اختياري.موجود(المستعاد) -> {
                لو (المستعاد != المعرف) { أرجع 2; };
            }
            | _ -> { أرجع 3; };
            عدد_العامة := عدد_العامة + 1;
        }
        | _ -> { };
        الرقم := الرقم + 1;
    }
    لو (عدد_العامة != 142 || (الطول(المفاتيح_كلها) مثل طبيعي) != 645) { أرجع 6; };
    دع كود_مجهول: نص = «SULTANC-E0001»;
    طابق معرف_تشخيص_من_كود(&كود_مجهول) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 7; };
    // Fixed messages are never reverse-parsed to discover identity.
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.مورد_محرر(), «resource was already released», «المورد محرر مسبقا»)) { أرجع 11; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.تعارض_استعارة(), «borrow conflict», «تعارض استعارة»)) { أرجع 12; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.هروب_مرجع(), «reference escapes its valid scope», «المرجع يهرب من نطاق صلاحيته»)) { أرجع 13; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.عملية_غير_آمنة(), «operation requires an explicit unsafe scope», «العملية تتطلب نطاق غير آمن صريحا»)) { أرجع 14; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.فهرس_خارج_الحدود(), «index is outside the valid bounds», «الفهرس خارج الحدود الصالحة»)) { أرجع 15; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.نمط_غير_شامل(), «non-exhaustive pattern», «نمط غير شامل»)) { أرجع 16; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.نمط_غير_قابل_للوصول(), «unreachable pattern», «نمط غير قابل للوصول»)) { أرجع 17; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.إرجاع_مفقود(), «not all execution paths return a value», «ليست كل مسارات التنفيذ ترجع قيمة»)) { أرجع 18; };
    // Typed, named facts avoid all catalog and argument-vector scans.
    دع حقائق_الاسم: حقائق_رسالة = حقائق_رسالة.اسم_غير_معروف(قيم_الاسم());
    دع مفتاح_الاسم: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_الاسم, حقائق_الاسم) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «unknown name: `المثال`»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 19; };
    }
    | _ -> { أرجع 19; };
    دع حقائق_الاسم_عربي: حقائق_رسالة = حقائق_رسالة.اسم_غير_معروف(قيم_الاسم());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), مفتاح_الاسم, حقائق_الاسم_عربي) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «الاسم `المثال` غير معروف»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 20; };
    }
    | _ -> { أرجع 20; };
    دع مفتاح_النوع: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوعان_غير_متوافقين());
    دع حقائق_النوع: حقائق_رسالة = حقائق_رسالة.نوعان_غير_متوافقين(قيم_النوع());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_النوع, حقائق_النوع) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «expected `غ8`, found `نص`»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 21; };
    }
    | _ -> { أرجع 21; };
    دع حقائق_النوع_عربي: حقائق_رسالة = حقائق_رسالة.نوعان_غير_متوافقين(قيم_النوع());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), مفتاح_النوع, حقائق_النوع_عربي) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «النوع الموجود `نص` لا يطابق النوع المتوقع `غ8`»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 22; };
    }
    | _ -> { أرجع 22; };
    دع مفتاح_العدد: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق());
    دع حقائق_العدد: حقائق_رسالة = حقائق_رسالة.عدد_حجج_غير_مطابق(قيم_العدد());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_العدد, حقائق_العدد) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «expected 2 arguments, found 3»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 23; };
    }
    | _ -> { أرجع 23; };
    دع حقائق_العدد_عربي: حقائق_رسالة = حقائق_رسالة.عدد_حجج_غير_مطابق(قيم_العدد());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), مفتاح_العدد, حقائق_العدد_عربي) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «عدد الحجج المقدمة 3 لا يطابق العدد المتوقع 2»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 24; };
    }
    | _ -> { أرجع 24; };
    دع حقائق_بلا_حجج: حقائق_رسالة = حقائق_رسالة.بلا_حجج();
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_الاسم, حقائق_بلا_حجج) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 25; };
    دع حقائق_خطأ_نوع: حقائق_رسالة = حقائق_رسالة.عدد_حجج_غير_مطابق(قيم_العدد());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), مفتاح_الاسم, حقائق_خطأ_نوع) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 26; };
    دع حقائق_خطأ_هوية: حقائق_رسالة = حقائق_رسالة.نوعان_غير_متوافقين(قيم_النوع());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_الاسم, حقائق_خطأ_هوية) مع
    | اختياري.لا_شيء -> { }
    | _ -> { أرجع 27; };
    دع مفتاح_نحوي: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خطأ_نحوي());
    دع بلا_حجج_للنحو: حقائق_رسالة = حقائق_رسالة.بلا_حجج();
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_نحوي, بلا_حجج_للنحو) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «Syntax error in source code»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 28; };
    }
    | _ -> { أرجع 28; };
    // Parser contextual reasons verified against frontend/semantic_pipeline.sn
    // branches for فئة_خطأ_نحوي (statement and target conditions).
    دع مفتاح_سبب_0: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_محلل_نحوي_عبارة_بلا_عملية());
    دع رسالة_سبب_إنجليزية_0: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), مفتاح_سبب_0);
    دع رسالة_سبب_عربية_0: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), مفتاح_سبب_0);
    دع المتوقع_إنجليزي_0: نص = «Expected a function call or assignment in this statement»;
    دع المتوقع_عربي_0: نص = «تتطلب هذه العبارة استدعاء دالة أو عملية إسناد»;
    لو (!نصان_متساويان(&رسالة_سبب_إنجليزية_0, &المتوقع_إنجليزي_0)) { أرجع 29; };
    لو (!نصان_متساويان(&رسالة_سبب_عربية_0, &المتوقع_عربي_0)) { أرجع 30; };
    دع مفتاح_سبب_1: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_غير_صحيح());
    دع رسالة_سبب_إنجليزية_1: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), مفتاح_سبب_1);
    دع رسالة_سبب_عربية_1: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), مفتاح_سبب_1);
    دع المتوقع_إنجليزي_1: نص = «Invalid target condition in a conditional declaration»;
    دع المتوقع_عربي_1: نص = «شرط الهدف في التصريح الشرطي غير صحيح»;
    لو (!نصان_متساويان(&رسالة_سبب_إنجليزية_1, &المتوقع_إنجليزي_1)) { أرجع 31; };
    لو (!نصان_متساويان(&رسالة_سبب_عربية_1, &المتوقع_عربي_1)) { أرجع 32; };
    دع مفتاح_سبب_2: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_محلل_نحوي_هدف_شرط_بلا_هدف());
    دع رسالة_سبب_إنجليزية_2: نص = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), مفتاح_سبب_2);
    دع رسالة_سبب_عربية_2: نص = رسالة_تشخيص(لغة_تشخيص.العربية(), مفتاح_سبب_2);
    دع المتوقع_إنجليزي_2: نص = «Target condition is missing its target»;
    دع المتوقع_عربي_2: نص = «شرط الهدف لا يحدد هدفا»;
    لو (!نصان_متساويان(&رسالة_سبب_إنجليزية_2, &المتوقع_إنجليزي_2)) { أرجع 33; };
    لو (!نصان_متساويان(&رسالة_سبب_عربية_2, &المتوقع_عربي_2)) { أرجع 34; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.خلفية_مترجم_غير_متاحة(), «the selected code-generation backend is not available in this compiler», «خلفية توليد الشفرة المختارة غير متاحة في هذا المترجم»)) { أرجع 35; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت(), «comptime expression must be a pure compile-time constant», «تعبير وقت_الترجمة يجب أن يكون ثابتا نقيا وقت الترجمة»)) { أرجع 36; };
    دع شرح_وقت_ترجمة: نص = شرح_تشخيص(لغة_تشخيص.الإنجليزية(), معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت());
    دع شرح_وقت_ترجمة_متوقع: نص = «This expression requires runtime evaluation, not compile-time computation.»;
    لو (!نصان_متساويان(&شرح_وقت_ترجمة, &شرح_وقت_ترجمة_متوقع)) { أرجع 38; };
    دع شرح_خلفية: نص = شرح_تشخيص(لغة_تشخيص.العربية(), معرف_تشخيص.خلفية_مترجم_غير_متاحة());
    دع شرح_خلفية_متوقع: نص = «الخلفية المختارة لا تدعم إخراج هذا الهدف. تحقق من دعم LLVM أو اختر خلفية مدعومة.»;
    لو (!نصان_متساويان(&شرح_خلفية, &شرح_خلفية_متوقع)) { أرجع 39; };
    // The English locale must never inherit Arabic question punctuation.
    // This validates the complete localized text, not only its typed ID.
    دع مفتاح_اقتراح: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تهجئة_كلمة_محجوزة_غير_معروفة());
    دع حقائق_اقتراح: حقائق_رسالة = حقائق_رسالة.اقتراح_كلمة(قيم_اقتراح());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), مفتاح_اقتراح, حقائق_اقتراح) مع
    | اختياري.موجود(الرسالة) -> {
        دع المتوقع: نص = «unknown keyword: did you mean `if`?»;
        لو (!نصان_متساويان(&الرسالة, &المتوقع)) { أرجع 40; };
    }
    | _ -> { أرجع 40; };
    دع حقائق_اقتراح_عربية: حقائق_رسالة = حقائق_رسالة.اقتراح_كلمة(قيم_اقتراح());
    طابق رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), مفتاح_اقتراح, حقائق_اقتراح_عربية) مع
    | اختياري.موجود(الرسالة) -> {
        دع المتوقع: نص = «كلمة محجوزة غير معروفة: هل تقصد `if`؟»;
        لو (!نصان_متساويان(&الرسالة, &المتوقع)) { أرجع 41; };
    }
    | _ -> { أرجع 41; };
    لو (!تحقق_رسالة_محددة(معرف_تشخيص.نقل_من_مرجع(), «cannot move an owned value out of borrowed storage», «لا يجوز نقل قيمة مملوكة من تخزين مستعار»)) { أرجع 42; };
    أرجع 0;
}
