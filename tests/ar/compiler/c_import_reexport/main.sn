// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_reexport/main.sn
// التصريحات المولدة المتطابقة لعدة استيرادات سي تصريح واحد: تضمن first.h
// وsecond.h كلتاهما item.h، وتستورد only_first.sn الترويسة first.h،
// وonly_second.sn الترويسة second.h، وboth.sn الاثنتين. تصرح بالبنية item
// وitem_t وITEM_LIMIT مرة واحدة أول استيرادات سي كتابة؛ ويستورد الآخر وحدته
// (compiler/jisr/shared.sn)، وتعد الواجهة الأمامية الأسماء التي تستوردها
// وحدة سي من وحدة سي أخرى من أسمائها (compiler/frontend/names/modules.sn).
// فترى only_second.sn النوع item_t مع أنها لا تستورد first.h، وitem_t في
// both.sn اسم واحد لا اسمان غامضان، والعنصر الذي تصنعه only_first.sn هو
// السجل الذي تأخذه only_second.sn. ويعرف items.c الدوال التي تصرح بها
// الترويستان: تستدعي دوالهما الخارجية دواله المترجمة.
استورد "only_first.sn";
استورد "only_second.sn";
استورد "both.sn";
استورد "items.c";

عرف الرئيسية(): عدد {
    دع العنصر: item = اصنع(5);
    دع م: ص32 = المجموع(&العنصر);
    إذا (م != 10) { أرجع 1; };
    دع ب: ص32 = مجموع_الاثنين(6);
    إذا (ب != 12) { أرجع 2; };
    // 10 + 12 + 40 - 20 = 42
    أرجع (م + ب + ITEM_LIMIT - 20) مثل عدد;
}
