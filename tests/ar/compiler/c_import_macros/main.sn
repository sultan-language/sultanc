// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_macros/main.sn
// المعالج المسبق لجسر (compiler/jisr/preprocessor.sn): يصير
// الماكرو الشبيه بالكائن ثابتا حين يكون توسيعه الكامل تعبيرا ثابتا صحيحا
// (بنوعه في سي) أو عددا عشريا أو نصا حرفيا. تتوسع فيه الماكروهات الدالية
// مع # و## و__VA_ARGS__ و__VA_OPT__ و`, ## __VA_ARGS__`؛ وتستعمل الشروط
// defined و__has_include والتقييم المختصر؛ ويمنع حارس التضمين و#pragma once
// قراءة الترويسة مرتين.
استورد "macros.h";

عرف الرئيسية(): عدد {
    إذا (AREA != 49 || SUM3 != 15) { أرجع 1; };
    إذا (الطول(VERSION_TEXT) != 4 || VERSION_TEXT[0] != 51 || VERSION_TEXT[1] != 46 || VERSION_TEXT[3] != 52) { أرجع 2; };
    إذا (CAT_VALUE != 31 || BITS_7 != 128 || BIT7 != 128) { أرجع 2; };
    إذا (ARGS_THREE != 3 || FIRST_OF != 41 || PICKED != 9 || OPT_SOME != 6 || OPT_NONE != 5) { أرجع 3; };
    إذا (LATER != 101 || CHOSEN != 1 || HAS_INCLUDE_WORKS != 1 || SHORT_CIRCUIT != 1) { أرجع 4; };
    إذا (C_VERSION != 201710 || CHANGING != 2) { أرجع 5; };
    // نوع كل قيمة في سي يحدد نوعها في سلطان.
    دع الكبير: ط32 = BIG_UNSIGNED;
    دع العريض: ص64 = BIG_LONG_LONG;
    دع الأدنى: ص32 = NEGATIVE_LIMIT;
    دع المزاح: ط32 = SHIFTED;
    إذا (الكبير != 4294967295 || العريض != 4294967296 || الأدنى != -2147483647 - 1 || المزاح != 2147483648) { أرجع 6; };
    إذا (CHAR_VALUE != 65 || ESCAPED_CHAR != 10 || SIZE_OF_INT != 4) { أرجع 7; };
    إذا (HALF != 0.5 || TINY > 0.0011 || TINY < 0.0009) { أرجع 8; };
    إذا (الطول(GREETING) != 12) { أرجع 9; };
    // عناصر تعداد من الماكروهات ومن بعضها، والترويسات المحروسة مرة واحدة.
    إذا (RED != 5 || GREEN != 10 || BLUE != 17 || GUARD_VALUE != 5 || ONCE_VALUE != 7) { أرجع 10; };
    أرجع 42;
}
