// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_tls_threads/main.sn (بلا توجيه زوج:
// يشغل المفسر خيط نظام واحدا ويتوقف عند الإطلاق).
// الكائن الخاص بالخيط في شفرة سي مترجمة واحد لكل خيط: الخيط الذي يطلقه هذا
// البرنامج يزيد عدادا خاصا به يبدأ من القيمة الأولى 3 مهما فعل الخيط
// الرئيسي، ولا يتغير به عداد الخيط الرئيسي (compiler/jisr/lower.sn: لكل
// خيط نسخته من القيم الأولى للكائنات الخاصة بالخيط).
استورد "tls.c";
استورد std.thread.thread;

عرف الرئيسية(): عدد {
    دع أ: ص32 = bump();
    دع ب: ص32 = bump();
    طابق أطلق(دالة(): فراغ -> record()) مع
    | نتيجة.نجح(م) -> {
        دع المقبض: متغير مقبض_خيط = م;
        انضم(&متغير المقبض);
    }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع ج: ص32 = bump();
    // عداد الخيط الآخر 3 -> 4 -> 5؛ وعداد هذا 3 -> 4 -> 5 -> 6.
    إذا (get_seen() != 5 || ج != 6) { أرجع 2; };
    // 4 + 5 + 6 + 5 + 22 = 42
    أرجع (أ + ب + ج + get_seen() + 22) مثل عدد;
}
