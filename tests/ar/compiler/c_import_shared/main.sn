// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_shared/main.sn (بلا ترويسة `نظير`: خطوة
// الزوج تفسر التوأمين، ومفسر المترجم الساكن لا يستدعي دوال مكتبة سي التي
// يستعملها scale.c).
// تصرح عدة استيرادات سي في برنامج واحد بالأشياء نفسها: يضمن geometry.c
// وscale.c كلاهما common.h (البنية point والنوع point_t والثابت SHARED_LIMIT
// والنماذج) و<stdint.h>، ويصرح stdio.h وstdlib.h كلاهما بـ size_t وNULL.
// يكتب كل تصريح مشترك مرة واحدة (compiler/jisr/shared.sn)، فلا غموض في أي
// استعمال أدناه، والنقطة التي تعيدها scale_point هي السجل الذي تأخذه
// point_sum.
استورد "geometry.c";
استورد "scale.c";
استورد "stdio.h";
استورد "stdlib.h";
استورد "stdint.h";

عرف الرئيسية(): عدد {
    دع النقطة: point_t = scale_point({ x: 1, y: 2 }, 3);
    دع المجموع: int32_t = point_sum(&النقطة);
    إذا (المجموع != 9) { أرجع 1; };
    دع البايتات: size_t = point_bytes();
    إذا (البايتات != 8) { أرجع 2; };
    دع الحد: ص32 = SHARED_LIMIT;
    // 40 - 9 + 8 + 3 = 42
    أرجع (الحد - المجموع + (البايتات مثل ص32) + 3) مثل عدد;
}
