// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_c23/main.sn
// سي 23 عبر جسر: ثوابت constexpr (على مستوى الملف والكتلة، في أطوال
// المصفوفات ووسوم case)، و#embed مع limit وprefix وsuffix وif_empty
// و__has_embed، وtypeof وtypeof_unqual، وحساب _BitInt(N) الملتف ضمن N بتا
// بلا ترقية إلى int، وحساب __int128 وunsigned __int128 وإزاحاتهما وقسمتهما
// ومقارناتهما وتحويلاتهما في الشفرة المترجمة. وconstexpr على مستوى الملف
// ثابت في الوحدة؛ ويترك نوع المتجه (vector_size) بتعليق تخط.
استورد "c23.c";

عرف الرئيسية(): عدد {
    دع الفشل: ص32 = run_c23();
    إذا (الفشل != 0) { أرجع 1; };
    إذا (WORD_LIMIT != 4 || BIG_MASK != 280375465082880) { أرجع 2; };
    أرجع 42;
}
