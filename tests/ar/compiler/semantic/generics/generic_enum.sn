// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
نوع حامل<T> = | لاشيء | قيمة بنوع T;

عرف القلعة(): عدد {
    دع فارغ: حامل<عدد> = حامل.لاشيء();
    دع موجود: حامل<عدد> = حامل.قيمة(42);
    طابق موجود مع
    | حامل.لاشيء -> { أرجع 0; }
    | حامل.قيمة(القيمة) -> { أرجع القيمة; }
}
