// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
نوع قائمة<T> = متجه T;

عرف هوية<T>(القيمة: T): T {
    أرجع القيمة;
}

عرف الرئيسية(): عدد {
    دع قيمة: عدد = هوية(42);
    دع علم: منطقي = هوية(صواب);
    دع عناصر: قائمة<عدد> = [];
    إذا (علم && الطول(عناصر) == 0) { أرجع قيمة; };
    أرجع 0;
}
