نوع Node = { a: عدد, b: عدد, c: عدد, d: عدد, e: عدد, f: عدد };
نوع Holder = { items: متجه عدد };

عرف node(value: عدد): Node {
    دع n: Node = { a: value, b: 1, c: 2, d: 3, e: 4, f: 5 };
    أرجع n;
}

عرف make(value: عدد): اختياري Node {
    دع n: Node = node(value);
    أرجع اختياري.موجود(n);
}

عرف forward(value: عدد): اختياري Node {
    أرجع make(value);
}

عرف choose(flag: منطقي, value: عدد): اختياري Node {
    إذا (flag) { أرجع make(value); } وإلا { أرجع اختياري.لا_شيء(); };
}

عرف consume(value: اختياري Node): عدد {
    طابق value مع
    | اختياري.موجود(n) -> { أرجع n.a + n.b + n.c + n.d + n.e + n.f; }
    | اختياري.لا_شيء() -> { أرجع 0; }
}

عرف make_result(value: عدد): نتيجة Node, عدد {
    دع n: Node = node(value);
    أرجع نتيجة.نجح(n);
}

عرف consume_result(value: نتيجة Node, عدد): عدد {
    طابق value مع
    | نتيجة.نجح(n) -> { أرجع n.a + n.f; }
    | نتيجة.خطأ(code) -> { أرجع code; }
}

عرف make_owned(): اختياري Holder {
    دع items: متجه عدد = [40, 2];
    دع holder: Holder = { items: items };
    أرجع اختياري.موجود(holder);
}

عرف الرئيسية(): عدد {
    دع direct: اختياري Node = اختياري.موجود(node(10));
    إذا (consume(direct) != 25) { أرجع 1; };

    دع one: اختياري Node = make(11);
    إذا (consume(one) != 26) { أرجع 2; };

    دع two: اختياري Node = forward(12);
    إذا (consume(two) != 27) { أرجع 3; };

    طابق make(13) مع
    | اختياري.موجود(n) -> { إذا (n.a + n.f != 18) { أرجع 4; }; }
    | اختياري.لا_شيء() -> { أرجع 5; };

    إذا (consume(make(14)) != 29) { أرجع 6; };

    دع first: اختياري Node = make(15);
    دع second: اختياري Node = make(25);
    إذا (consume(first) != 30) { أرجع 7; };
    إذا (consume(second) != 40) { أرجع 8; };

    إذا (consume(choose(صواب, 16)) != 31) { أرجع 9; };
    إذا (consume(choose(خطأ, 16)) != 0) { أرجع 10; };

    إذا (consume_result(make_result(37)) != 42) { أرجع 11; };

    دع owned: اختياري Holder = make_owned();
    طابق owned مع
    | اختياري.موجود(h) -> { أرجع h.items[0] + h.items[1]; }
    | اختياري.لا_شيء() -> { أرجع 12; };
}
