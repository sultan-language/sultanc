// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/compiler/semantic/regression/drop_deep_box_chain.sn
// هدم سلسلة طويلة من صناديق النوع نفسه يدور في شيفرة الهدم بدل أن يستدعي نفسه لكل حلقة، فلا يفيض المكدس.
نوع قائمة =
    | فارغة
    | عقدة بنوع (عدد, نص, صندوق قائمة);

عرف ابن(العدد: عدد): قائمة {
    ليكن ق: متغير قائمة = قائمة.فارغة();
    ليكن ف: متغير عدد = 0;
    طالما (ف < العدد) {
        ليكن الذيل: صندوق قائمة = صندوق ق;
        ق := قائمة.عقدة(ف, «ع», الذيل);
        ف := ف + 1;
    }
    أرجع ق;
}

عرف الرئيسية(): عدد {
    ليكن ق: قائمة = ابن(200000);
    طابق ق مع
    | قائمة.عقدة(القيمة, _, _) -> { إذا (القيمة != 199999) { أرجع 1; }; }
    | قائمة.فارغة -> { أرجع 2; };
    أرجع 42;
}
