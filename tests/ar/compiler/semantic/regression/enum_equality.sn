نوع علامة = | ألف | باء | جيم;

عرف الرئيسية(): ص32 {
    دع x: علامة = علامة.باء();
    دع same: منطقي = علامة.ألف() == علامة.ألف();
    دع different: منطقي = علامة.ألف() != علامة.باء();
    إذا (!same) { أرجع 1; };
    إذا (!different) { أرجع 2; };
    إذا (x == علامة.ألف()) { أرجع 3; };
    إذا (x != علامة.باء()) { أرجع 4; };
    أرجع 42;
}
