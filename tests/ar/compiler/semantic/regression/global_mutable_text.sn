// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/compiler/semantic/regression/global_mutable_text.sn
// النص المتغير على مستوى الوحدة يبدأ بحرفيه ويمكن استبداله (وُجد بالتشويش: كان عطلا داخليا في الخفض).
ليكن الاسم: متغير نص = «abc»;
ليكن الفارغ: متغير نص = «»;

عرف طول_النص(ن: &نص): عدد { أرجع الطول(*ن) مثل عدد; }

عرف الرئيسية(): عدد {
    ليكن الناتج: متغير عدد = 42;
    غير_آمن {
        إذا (طول_النص(&الاسم) != 3 || الاسم[0] != 97 || الاسم[2] != 99) { الناتج := 1; };
        إذا (طول_النص(&الفارغ) != 0) { الناتج := 2; };
        الاسم := «hello, world»;
        الفارغ := «xy»;
        إذا (طول_النص(&الاسم) != 12 || الاسم[11] != 100) { الناتج := 3; };
        إذا (طول_النص(&الفارغ) != 2) { الناتج := 4; };
        الاسم := «»;
        إذا (طول_النص(&الاسم) != 0) { الناتج := 5; };
    };
    أرجع الناتج;
}
