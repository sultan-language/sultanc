نوع حامل = { عناصر: متجه عدد };
عرف اصنع(): حامل {
    دع عناصر: متجه عدد = [40, 2];
    دع قيمة_الحامل: حامل = { عناصر: عناصر };
    أرجع قيمة_الحامل;
}
عرف اجمع(قيمة_الحامل: حامل): عدد {
    أرجع قيمة_الحامل.عناصر[0] + قيمة_الحامل.عناصر[1];
}
عرف القلعة(): عدد {
    دع قيمة_الحامل: حامل = اصنع();
    أرجع اجمع(قيمة_الحامل);
}
