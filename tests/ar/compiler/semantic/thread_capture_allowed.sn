// اختبار: قبول
// النظير: tests/en/compiler/semantic/thread_capture_allowed.sn (بلا توجيه نظير:
// تفسيره يطلق خيطا، والمفسر يرفض ذلك).
// يقبل فحص التقاطات الإطلاق ما يجوز أن يعبر بين الخيوط: مشتركا (عداده ذري)،
// وقيمة مملوكة منقولة إلى الإغلاق، وأعدادا عادية، ومؤشرا خاما حين يكون الإطلاق
// داخل كتلة غير آمنة، حيث يضمن المبرمج ما يشير إليه (docs/TYPE_SYSTEM.md).
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;

نوع خانة = { القيمة: ط64 };

عرف زد(ع: &مشترك<ذرة_ط64>, بمقدار: ط64): فراغ {
    دع قديم: ط64 = اجمع_واجلب_ط64(اقرأ_مشترك(ع), بمقدار, ترتيب_ذاكرة.تسلسلي());
}
عرف المجموع(ق: &متجه ص64): ص64 { أرجع (*ق)[0] + (*ق)[1]; }
عرف احتفظ(س: ص64): فراغ { }
عرف اكتب_العلامة(م: *متغير خانة): فراغ { غير_آمن { (*م).القيمة := 7 مثل ط64; } }

عرف الرئيسية(): ص32 {
    دع العداد: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));
    دع بمقدار: ط64 = 3 مثل ط64;
    دع مملوك: متجه ص64 = [1 مثل ص64, 2 مثل ص64];
    دع خ: متغير خانة = { القيمة: 0 مثل ط64 };
    دع م: *متغير خانة = &متغير خ;
    طابق أطلق(دالة(): فراغ -> زد(&العداد, بمقدار)) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    طابق أطلق(دالة(): فراغ -> احتفظ(المجموع(&مملوك))) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    غير_آمن {
        طابق أطلق(دالة(): فراغ -> اكتب_العلامة(م)) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
    }
    أرجع 0;
}
