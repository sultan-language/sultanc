// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_bodies/main.sn
// يحلل جسر أجسام الدوال (compiler/jisr/parser.sn، C17 6.8): for
// وwhile وdo وswitch مع مجالات case في GNU، والوسوم، وgoto المحسوب، وتعابير
// العبارات، وعبارات asm، والإسناد في الشروط، والتصريحات داخل الكتل التي تحجب
// أسماء نطاق الملف حتى تنتهي الكتلة. لا تكتب الدوال static inline (لا رمز لها)؛
// وما يليها يرى نطاق الملف: count_t هو int وstruct node هي بنية الملف لا الكتلة.
استورد "bodies.h";
استورد المكتبة.انعكاس.reflect;

// يفحص نوع struct node في نطاق الملف (حقل مؤشر وحقل int).
عرف اصنع_عقدة(التالي: *متغير node): node { أرجع { next: التالي, value: 5 }; }

عرف الرئيسية(): عدد {
    دع ع: count_t = 2147483647;
    إذا (حجم_النوع(&ع) != 4) { أرجع 1; };
    إذا (NODE_SIZE != 16) { أرجع 2; };
    إذا (AFTER_BODIES != 20) { أرجع 3; };
    أرجع 42;
}
