// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_pointer_calls/main.sn (بلا ترويسة `نظير`:
// المفسر لا يستدعي دوال ملف .c مستورد).
// نداء سي عبر مؤشر دالة هو عنوان في الآلة (مؤشر من dlsym، أو عنوان دالة من
// مكتبة سي) نداء غير مباشر باصطلاح نداء سي للهدف (compiler/jisr/lower.sn،
// نادِ_عنوانا_جسر، عبر شكل نداء عند عنوان): القيم الصحيحة والمؤشرات وdouble
// وfloat والسجلات بالقيمة كما يمررها نداء سي مباشر، والناتج مضيق إلى نوعه في سي.
استورد «pointers.c»;

عرف الرئيسية(): عدد {
    إذا (through_dlsym() != 5) { أرجع 1; };
    دع العائم: ص32 = through_dlsym_floating();
    إذا (العائم != 0) { أرجع 10 + (العائم مثل عدد); };
    دع السجلات: ص32 = through_dlsym_records();
    إذا (السجلات != 0) { أرجع 20 + (السجلات مثل عدد); };
    إذا (through_library_address() != 7) { أرجع 3; };
    إذا (through_marker() != 42) { أرجع 4; };
    أرجع 42;
}
