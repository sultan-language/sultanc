// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_abi_callbacks/main.sn (بلا ترويسة `نظير`:
// البرنامج الذي فيه دوال @@اصطلاح_سي يعمل تنفيذيا لا مفسرا).
// الدالة المعرفة `@@اصطلاح_سي` (اصطلاح نداء سي) تترجم باصطلاح نداء سي،
// فتناديها شيفرة سي عند عنوانها في الآلة، بدائي_عنوان_دالة_سي(د)، دون منصة
// وسيطة (docs/ar/internals/jisr.md، "النداءات الراجعة")؛ ويناديها السلطان
// مباشرة أيضا. والدالة الراجعة تنادي إغلاقا، فتستعمل سجل بيئة الإغلاق: ويعيده
// إطارها للمنادي في سي.
استورد «callbacks.c»;

عرف زد_واحدا(ن: ص64): ص64 { أرجع ن + 1; }

@@اصطلاح_سي
عرف موزون(أ: ص64, ب: ص64): ص64 {
    ليكن د: دالة(ص64): ص64 = زد_واحدا;
    أرجع (د(أ) - 1) * 10 + ب;
}

@@اصطلاح_سي
عرف امزج(س: ع64, ن: ص32, ص: ع64): ع64 { أرجع س * (ن مثل ع64) + ص; }

عرف الرئيسية(): عدد {
    إذا (apply(بدائي_عنوان_دالة_سي(موزون), 4, 2) != 42) { أرجع 1; };
    إذا (apply_mixed(بدائي_عنوان_دالة_سي(امزج)) != 3.25) { أرجع 2; };
    إذا (موزون(3, 7) != 37) { أرجع 3; };
    أرجع 42;
}
