// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_opaque/main.sn (بلا ترويسة `نظير`: خطوة
// الزوج تفسر التوأمين، والمفسر لا يستدعي دوال ملف .c مستورد).
// مقابض سي أنواع معتمة (compiler/jisr/emit.sn): يصرح handles.h بـ
// `typedef struct db db;` و`typedef struct stmt stmt;` و`struct cursor;` ولا
// يعرّفها إلا handles.c، فكل منها `public type NAME = opaque;` ومؤشراته
// `*متغير NAME` (و`*NAME` لـ`const NAME *` ويمرر إليه `*متغير NAME` كما في سي)، نوع واحد لكل بنية عبر التصريح المسبق وtypedef والتعريف. وNULL هو
// `0 مثل *T`: يُرجع ويُمرر ويُقارن؛ و`db **` معامل إخراج؛ وتستدعي شفرة سي شفرة
// سي عبر مؤشر دالة يتلقى المقبض.
استورد "handles.c";

عرف الرئيسية(): عدد {
    دع ق: *متغير db = db_open(7);
    إذا (ق == 0 مثل *متغير db) { أرجع 1; };
    إذا (db_id(ق) != 7 || db_is_null(ق) != 0) { أرجع 2; };
    دع لا_شيء_ق: *متغير db = db_null();
    إذا (لا_شيء_ق != 0 مثل *متغير db || db_is_null(لا_شيء_ق) != 1 || db_is_null(0 مثل *متغير db) != 1 || db_id(لا_شيء_ق) != -1) { أرجع 3; };
    دع أخرى: متغير *متغير db = 0 مثل *متغير db;
    إذا (db_open_into(9, &متغير أخرى) != 0 || db_id(أخرى) != 9) { أرجع 4; };
    دع ع: *متغير stmt = db_prepare(ق, 3);
    دع الصفوف: متغير عدد = 0;
    طالما (stmt_step(ع) != 0) { الصفوف := الصفوف + 1; }
    إذا (الصفوف != 3) { أرجع 5; };
    stmt_finalize(ع);
    دع م: *متغير cursor = db_cursor(أخرى);
    إذا (cursor_close(م) != 9) { أرجع 6; };
    // 7 × (1 + 2 + 3) عبر نداء راجع في سي يتلقى المقبض.
    إذا (db_sum(ق) != 42) { أرجع 7; };
    db_close(أخرى);
    db_close(ق);
    أرجع 42;
}
