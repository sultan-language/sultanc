// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/compiler/link/layout_script.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.link.elf.layout_script;
استورد compiler.link.elf.script_image;

// قارئ سكربتات الربط لصور العتاد المباشر (compiler/link/elf/
// layout_script.sn): الجزء الذي تستعمله سكربتات Cortex-M، محللا إلى مناطق
// الذاكرة والدخول وأوامر SECTIONS بترتيبها.

عرف بايتات_من(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(النص) مثل طبيعي)) {
        ألحق(الناتج, النص[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف الاسم_هو(الاسم: &متجه ط8, المتوقع: نص): منطقي {
    دع النص: نص = من_بايتات(الاسم);
    أرجع نصان_متساويان(&النص, &المتوقع);
}

عرف الرئيسية(): عدد {
    دع اللوحة: متجه ط8 = بايتات_من("/* board */\nMEMORY\n{\n  FLASH (rx)  : ORIGIN = 0x00000000, LENGTH = 256K\n  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 64K\n}\nENTRY(Reset_Handler)\nSECTIONS\n{\n  .vector_table ORIGIN(FLASH) :\n  {\n    KEEP(*(.vector_table))\n  } > FLASH\n  .text : { *(.text .text.*) } > FLASH\n  .init_array :\n  {\n    __init_array_start = .;\n    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*)))\n    __init_array_end = .;\n  } > FLASH\n  .data : ALIGN(4)\n  {\n    __data_start = .;\n    *(.data .data.*)\n    . = ALIGN(4);\n  } > RAM AT > FLASH\n  __data_load = LOADADDR(.data);\n  .bss (NOLOAD) : ALIGN(4) { *(.bss .bss.* COMMON) } > RAM\n  __stack_top = (ORIGIN(RAM) + LENGTH(RAM)) & ~7;\n}\n");
    دع الاستضافة: متجه ط8 = بايتات_من("/* semihosting */\n__sultanc_exit = __sultanc_semihosting_exit;\nHardFault_Handler = __sultanc_semihosting_fault;\n");
    دع سكربت_إدخال: متجه ط8 = بايتات_من("GROUP ( /lib/libc.so.6 )\n");
    إذا (!سكربت_تخطيط_جنو(&اللوحة)) { أرجع 1; };
    إذا (!سكربت_تخطيط_جنو(&الاستضافة)) { أرجع 2; };
    إذا (سكربت_تخطيط_جنو(&سكربت_إدخال)) { أرجع 3; };

    دع السكربت: متغير سكربت_تخطيط = سكربت_تخطيط_فارغ();
    دع المسار: متجه ط8 = بايتات_من("board.ld");
    دع الأدلة: متجه نص = [];
    طابق اقرأ_سكربت_تخطيط(&اللوحة, &المسار, &الأدلة, &متغير السكربت, 0) مع
    | نتيجة_سكربت_تخطيط.خطأ(_, _) -> { أرجع 4; }
    | نتيجة_سكربت_تخطيط.تم -> { };
    دع الثاني: متجه ط8 = بايتات_من("semihosting.ld");
    طابق اقرأ_سكربت_تخطيط(&الاستضافة, &الثاني, &الأدلة, &متغير السكربت, 0) مع
    | نتيجة_سكربت_تخطيط.خطأ(_, _) -> { أرجع 5; }
    | نتيجة_سكربت_تخطيط.تم -> { };

    إذا ((الطول(السكربت.المناطق) مثل طبيعي) != 2) { أرجع 6; };
    إذا (!الاسم_هو(&السكربت.المناطق[1].الاسم, "RAM")) { أرجع 7; };
    إذا (السكربت.المناطق[1].الأصل != 0x20000000 || السكربت.المناطق[1].الطول != 65536) { أرجع 8; };
    إذا (السكربت.المناطق[0].الطول != 262144) { أرجع 9; };
    طابق السكربت.الدخول مع
    | اختياري.لا_شيء -> { أرجع 10; }
    | اختياري.موجود(الدخول) -> { إذا (!الاسم_هو(&الدخول, "Reset_Handler")) { أرجع 10; }; };
    // .vector_table و.text و.init_array و.data و__data_load و.bss و__stack_top،
    // ثم تعيينا السكربت الثاني.
    إذا ((الطول(السكربت.الأوامر) مثل طبيعي) != 9) { أرجع 11; };
    طابق السكربت.الأوامر[3] مع
    | أمر_أقسام_تخطيط.قسم(البيانات) -> {
        إذا (!الاسم_هو(&البيانات.الاسم, ".data")) { أرجع 12; };
        طابق البيانات.منطقة_التحميل مع
        | اختياري.موجود(المنطقة) -> { إذا (!الاسم_هو(&المنطقة, "FLASH")) { أرجع 13; }; }
        | اختياري.لا_شيء -> { أرجع 13; };
    }
    | _ -> { أرجع 12; };
    طابق السكربت.الأوامر[5] مع
    | أمر_أقسام_تخطيط.قسم(الأصفار) -> { إذا (!الأصفار.بلا_تحميل) { أرجع 14; }; }
    | _ -> { أرجع 14; };
    طابق السكربت.الأوامر[8] مع
    | أمر_أقسام_تخطيط.تعيين(التعيين) -> { إذا (!الاسم_هو(&التعيين.الاسم, "HardFault_Handler")) { أرجع 15; }; }
    | _ -> { أرجع 15; };

    // الأعداد وحساب العناوين ذات 32 بت وأنماط الأقسام.
    دع ك: متجه ط8 = بايتات_من("4M");
    طابق عدد_تخطيط(&ك) مع
    | اختياري.موجود(القيمة) -> { إذا (القيمة != 4194304) { أرجع 16; }; }
    | اختياري.لا_شيء -> { أرجع 16; };
    إذا (طبق_ثنائي_تخطيط(14, 0x20010000 + 65536, 0xFFFFFFF8) != 0x20020000) { أرجع 17; };
    إذا (طبق_ثنائي_تخطيط(5, 4, 8) != 0xFFFFFFFC) { أرجع 18; };
    دع اسم_النص: متجه ط8 = بايتات_من(".text.unlikely.");
    دع النمط: متجه ط8 = بايتات_من(".text.*");
    دع الفهرسة: متجه ط8 = بايتات_من(".ARM.exidx");
    إذا (!يطابق_نمط_تخطيط(&اسم_النص, &النمط)) { أرجع 19; };
    إذا (يطابق_نمط_تخطيط(&الفهرسة, &النمط)) { أرجع 20; };

    // يُبلَّغ عن الأمر غير المدعوم باسمه.
    دع سيئ: متجه ط8 = بايتات_من("SECTIONS { /DISCARD/ : { *(.comment) } }");
    دع آخر: متغير سكربت_تخطيط = سكربت_تخطيط_فارغ();
    طابق اقرأ_سكربت_تخطيط(&سيئ, &المسار, &الأدلة, &متغير آخر, 0) مع
    | نتيجة_سكربت_تخطيط.تم -> { أرجع 21; }
    | نتيجة_سكربت_تخطيط.خطأ(الأمر, _) -> { إذا (!الاسم_هو(&الأمر, "/DISCARD/")) { أرجع 22; }; };
    أرجع 0;
}
