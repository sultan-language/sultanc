// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/compiler/link/text_stub.sn
استورد std.text.compare;
استورد std.text.from_bytes;
استورد compiler.link.macho.text_stub;

// قارئ المكتبات النصية البديلة (.tbd) الوحيد (compiler/link/macho/
// text_stub.sn): اسم التثبيت الذي يحل إليه المشغل `-l X`، والرموز التي
// يربطها ربط Mach-O بتلك المكتبة لمعمارية واحدة.

عرف بايتات_من(النص: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(النص) مثل طبيعي)) {
        ألحق(الناتج, النص[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع الناتج;
}

عرف اسم_تثبيت_البايتات_هو(بايتات_المكتبة: &متجه ط8, المتوقع: نص): منطقي {
    طابق اسم_تثبيت_مكتبة_نصية(بايتات_المكتبة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الاسم) -> { أرجع نصان_متساويان(&الاسم, &المتوقع); };
}

عرف اسم_التثبيت_هو(المكتبة_النصية: نص, المتوقع: نص): منطقي {
    دع بايتات_المكتبة: متجه ط8 = بايتات_من(المكتبة_النصية);
    أرجع اسم_تثبيت_البايتات_هو(&بايتات_المكتبة, المتوقع);
}

عرف فيها_رمز(المكتبة: &مكتبة_نصية_ماتشو, الاسم: نص): منطقي {
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول((*المكتبة).الرموز) مثل طبيعي)) {
        دع الرمز: نص = من_بايتات(&(*المكتبة).الرموز[الفهرس]);
        إذا (نصان_متساويان(&الرمز, &الاسم)) { أرجع صواب; };
        الفهرس := الفهرس + 1;
    }
    أرجع خطأ;
}

عرف الرئيسية(): عدد {
    // مكتبة بالإصدار 4 كما تأتي في حزمة تطوير Apple: اسم تثبيت المكتبة
    // الجامعة، والمكتبة المعاد تصديرها وثيقة ثانية، وقوائم تمتد على أسطر.
    دع مكتبة_الحزمة: نص = "--- !tapi-tbd\ntbd-version:     4\ntargets:         [ x86_64-macos, arm64-macos,\n                   arm64e-macos ]\ninstall-name:    '/usr/lib/libSystem.B.dylib'\nexports:\n  - targets:         [ x86_64-macos, arm64e-macos,\n                       arm64-macos ]\n    symbols:         [ _malloc,\n                       _printf ]\n    objc-classes:    [ Widget ]\n  - targets:         [ x86_64-macos ]\n    symbols:         [ _x86_only ]\nundefineds:\n  - targets:         [ arm64-macos ]\n    symbols:         [ _not_exported ]\n--- !tapi-tbd\ntbd-version:     4\ntargets:         [ arm64-macos ]\ninstall-name:    '/usr/lib/system/libsystem_c.dylib'\nexports:\n  - targets:         [ arm64-macos ]\n    symbols:         [ _abs ]\n...\n";
    دع بايتات_المكتبة: متجه ط8 = بايتات_من(مكتبة_الحزمة);
    إذا (!اسم_تثبيت_البايتات_هو(&بايتات_المكتبة, «/usr/lib/libSystem.B.dylib»)) { أرجع 1; };
    // اسم تثبيت بلا علامات اقتباس (tests/runner/fixtures/darwin_libc/libc.tbd).
    إذا (!اسم_التثبيت_هو("--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos ]\ninstall-name: /usr/lib/libsqlite3.dylib\n...\n", «/usr/lib/libsqlite3.dylib»)) { أرجع 2; };
    // مكتبة بالإصدار 1 بلا وسم.
    إذا (!اسم_التثبيت_هو("---\narchs: [ x86_64 ]\nplatform: macosx\ninstall-name: /usr/lib/libold.dylib\nexports:\n  - archs: [ x86_64 ]\n    symbols: [ _old ]\n...\n", «/usr/lib/libold.dylib»)) { أرجع 3; };

    // ليست مكتبة نصية: ترويسة ELF وسكربت ربط جنو، ومكتبة بلا اسم تثبيت.
    دع إلف: متجه ط8 = [0x7F, 0x45, 0x4C, 0x46, 2, 1, 1, 0];
    طابق اسم_تثبيت_مكتبة_نصية(&إلف) مع
    | اختياري.موجود(_) -> { أرجع 4; }
    | اختياري.لا_شيء -> { };
    دع السكربت: متجه ط8 = بايتات_من("GROUP ( /lib/libc.so.6 )\n");
    إذا (مكتبة_نصية_تابي(&السكربت)) { أرجع 5; };
    دع بلا_اسم: متجه ط8 = بايتات_من("--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos ]\n...\n");
    إذا (!مكتبة_نصية_تابي(&بلا_اسم)) { أرجع 6; };
    طابق اسم_تثبيت_مكتبة_نصية(&بلا_اسم) مع
    | اختياري.موجود(_) -> { أرجع 7; }
    | اختياري.لا_شيء -> { };

    // ما يربطه arm64 لنظام macOS: صادرات كل وثيقة لـ arm64-macos، وأصناف
    // Objective-C بأسماء رموزها، ولا شيء مما لـ x86_64 وحده ولا من غير المعرفات.
    دع المعمارية: متجه ط8 = بايتات_من(«arm64»);
    دع المنصة: متجه ط8 = بايتات_من(«macos»);
    طابق اقرأ_مكتبة_نصية_ماتشو(&بايتات_المكتبة, &المعمارية, &المنصة) مع
    | اختياري.لا_شيء -> { أرجع 8; }
    | اختياري.موجود(المكتبة) -> {
        إذا (!فيها_رمز(&المكتبة, «_malloc»)) { أرجع 9; };
        إذا (!فيها_رمز(&المكتبة, «_printf»)) { أرجع 10; };
        إذا (!فيها_رمز(&المكتبة, «_abs»)) { أرجع 11; };
        إذا (!فيها_رمز(&المكتبة, «_OBJC_CLASS_$_Widget»)) { أرجع 12; };
        إذا (!فيها_رمز(&المكتبة, «_OBJC_METACLASS_$_Widget»)) { أرجع 13; };
        إذا (فيها_رمز(&المكتبة, «_x86_only»)) { أرجع 14; };
        إذا (فيها_رمز(&المكتبة, «_not_exported»)) { أرجع 15; };
        إذا ((الطول(المكتبة.الرموز) مثل طبيعي) != 5) { أرجع 16; };
    };
    أرجع 0;
}
