// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_extensions/main.sn
// شفرة سي مترجمة خارج النواة: المصفوفات متغيرة الطول (يصنع تخزين كل منها
// حيث يصرح بها، وsizeof وقت التشغيل)، والقفز المحسوب (`&&label` هي كتلة
// اللافتة في موزع الدالة، و`goto *p` يتابع منها)، و_BitInt(N) حين
// 64 < N <= 128 (بمساعدات 128 بتا، ملتفا ضمن N بتا)، والكائنات الخاصة
// بالخيط (لكل خيط نسخته من قيمها الأولى، compiler/jisr/lower.sn)، وlong
// double بصيغة f64 حيث يكون long double في الهدف هو double (كائن
// arm64-darwin؛ أما على x86-64 لينكس فهو 80 بتا وقيمته
// SULTANC-C-UNSUPPORTED).
استورد "ext.c";

عرف الرئيسية(): عدد {
    إذا (vla_test(3) != 69) { أرجع 1; };
    إذا (goto_test() != 32) { أرجع 2; };
    إذا (bitint_test() != 42) { أرجع 3; };
    إذا (tls_test() != 42) { أرجع 4; };
    إذا (long_double_test() != 42) { أرجع 5; };
    أرجع 42;
}
