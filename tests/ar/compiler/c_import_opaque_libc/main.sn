// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_opaque_libc/main.sn
// مقبض مكتبة سي عبر ترويسة نظام: يصرح dirent.h في glibc بـ
// `typedef struct __dirstream DIR;` ولا يعرّف البنية أبدا، فـDIR نوع معتم
// وopendir وreaddir وclosedir تأخذ `*متغير DIR` وتُرجعه (أصليا، وعبر LLVM، وفي
// المفسر الذي يمرره مؤشرا). والمقبض الفارغ يساوي `0 مثل *متغير DIR`.
استورد "dirent.h";

عرف الرئيسية(): عدد {
    دع هنا: متجه ط8 = [46, 0];
    دع الدليل: *متغير DIR = opendir(&هنا[0]);
    إذا (الدليل == 0 مثل *متغير DIR) { أرجع 1; };
    دع المدخل: *متغير dirent = readdir(الدليل);
    إذا (المدخل == 0 مثل *متغير dirent) { أرجع 2; };
    إذا (closedir(الدليل) != 0) { أرجع 3; };
    دع المفقود: متجه ط8 = [47, 110, 111, 45, 115, 117, 99, 104, 45, 100, 105, 114, 0];
    إذا (opendir(&المفقود[0]) != 0 مثل *متغير DIR) { أرجع 4; };
    أرجع 42;
}
