// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_unicode/main.sn (بلا ترويسة `نظير`: خطوة
// الزوج تفسر التوأمين، والمفسر لا يستدعي دوال ملف .c مستورد).
// يقرأ جسر مصدر سي بصيغة UTF-8 متحقق منها ويطبق قواعد معرفات C23
// (XID_Start/XID_Continue، compiler/jisr/lexer.sn): `café` و`café` اسم
// سي واحد، واسم معامل عربي معرف سي، ومجموعة `#if 0` المتخطاة والتعليق قد
// يحويان بايتات ليست UTF-8. `u"..."` بصيغة UTF-16 (‏U+1F600 زوج بدائل)
// و`u8"..."` بصيغة UTF-8. لا تهجئة سلطانية لـ`café`، فيترك تصريحه العام
// (SULTANC-C-NAME-CONFLICT-SKIPPED)، وتستعمله الشفرة المترجمة مع ذلك.
استورد "unicode.c";

عرف الرئيسية(): عدد {
    إذا (get() != 42) { أرجع 1; };
    إذا (twice(21) != 42) { أرجع 2; };
    إذا (wide_length() != 3) { أرجع 3; };
    إذا (utf8_length() != 2) { أرجع 4; };
    أرجع 42;
}
