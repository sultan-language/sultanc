// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_system/main.sn
// ترويسات نظام حقيقية عبر جسر (compiler/c_import/jisr): كل استيراد يعالج
// ترويسة مكتبة سي مسبقا مع تضميناتها المتداخلة (bits/ وsys/ وasm/ و<stddef.h>
// و<stdint.h> المدمجتين) للهدف ويكتب تصريحاتها: ثوابت من #define والتعدادات،
// وtypedef مرادفات (widths.sn)، وسجلات مثل سجل FILE، ودوال خارجية بأنواعها.
// القيم المفحوصة واحدة في لينكس وماك.
استورد "stdio.h";
استورد "signal.h";
استورد "errno.h";
استورد "sys/socket.h";
استورد "limits.h";
استورد "widths.sn";

// FILE نوع سجل؛ وناتج fopen مؤشر إليه بنوعه.
عرف نوع_التدفق(التدفق: *متغير FILE): *متغير FILE { أرجع التدفق; }

عرف الرئيسية(): عدد {
    إذا (EOF != -1 || SEEK_SET != 0 || SEEK_END != 2) { أرجع 1; };
    دع العروض: عدد = فحوص_stdint();
    إذا (العروض != 0) { أرجع العروض; };
    إذا (SIGINT != 2 || SIGTERM != 15 || SIGKILL != 9) { أرجع 4; };
    إذا (EINVAL != 22 || ENOENT != 2 || EAGAIN <= 0) { أرجع 5; };
    إذا (AF_INET != 2 || SOCK_STREAM != 1 || SOCK_DGRAM != 2) { أرجع 6; };
    إذا (CHAR_BIT != 8 || INT_MAX != 2147483647 || INT_MIN != -2147483647 - 1) { أرجع 7; };
    إذا (LONG_MAX != 9223372036854775807 || UCHAR_MAX != 255) { أرجع 8; };
    أرجع 42;
}
