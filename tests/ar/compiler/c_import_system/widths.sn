// typedef وحدود <stdint.h> في وحدة خاصة بها. تصرح ترويسات النظام في
// main.sn بـ int32_t أيضا (عبر bits/stdint-intn.h في glibc)، وتكتب أولا:
// فتترك وحدة stdint.h مثل هذا التصريح لوحدتها وتستوردها
// (compiler/jisr/shared.sn). وهذه الوحدة لا تستورد إلا stdint.h وترى
// int32_t مع ذلك: أسماء وحدة سي تشمل ما تأخذه من وحدة سي أخرى.
استورد "stdint.h";

عام عرف فحوص_stdint(): عدد {
    إذا (INT32_MAX != 2147483647 || UINT16_MAX != 65535 || INT8_MIN != -128) { أرجع 2; };
    إذا (INT64_MAX != 9223372036854775807 || UINT32_MAX != 4294967295) { أرجع 3; };
    دع العرض: int32_t = -5;
    دع العدد: uint64_t = 7;
    دع الصغير: uint8_t = 255;
    إذا ((العرض مثل ص32) + (العدد مثل ص32) != 2 || (الصغير مثل ص32) != UINT8_MAX) { أرجع 9; };
    أرجع 0;
}
