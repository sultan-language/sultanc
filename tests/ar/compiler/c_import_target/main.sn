// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_target/main.sn
// منظور جسر إلى سي يتبع الهدف المترجَم له (يبني المشغّل هذا الاختبار تنفيذيا
// لـx86_64-linux وكائنا لـarm64-darwin): فرع الماكروهات المعرفة مسبقا في
// target.h وتأكيداته الساكنة (الأحجام وlong double وإشارة char) هي للهدف،
// وثوابته وأحجام بناه للهدف. وعلى مضيف بلا ترويسات سي للهدف تحل ترويسات المضيف
// محل ترويسات النظام وحدها؛ ويبقى target.h يرى ماكروهات الهدف. وينجح أيضا
// `check --target T` لـx86_64-darwin وaarch64-linux-gnu وx86_64-windows-msvc
// وaarch64-windows-msvc وi686-linux-gnu.
استورد "target.h";

إذا (الهدف.الثلاثي == "aarch64-apple-darwin") {
    عرف المنصة_المتوقعة(): ص32 { أرجع 1; }
    عرف المسبار_المتوقع(): ص32 { أرجع 24; }
}
إذا (الهدف.الثلاثي == "x86_64-unknown-linux-gnu") {
    عرف المنصة_المتوقعة(): ص32 { أرجع 3; }
    عرف المسبار_المتوقع(): ص32 { أرجع 24; }
}
إذا (الهدف.الثلاثي != "aarch64-apple-darwin" && الهدف.الثلاثي != "x86_64-unknown-linux-gnu") {
    عرف المنصة_المتوقعة(): ص32 { أرجع PLATFORM; }
    عرف المسبار_المتوقع(): ص32 { أرجع PROBE_BYTES; }
}

عرف الرئيسية(): عدد {
    إذا (PLATFORM != المنصة_المتوقعة() || PLATFORM == 0) { أرجع 1; };
    إذا (PROBE_BYTES != المسبار_المتوقع()) { أرجع 2; };
    إذا (LONG_BYTES != 8 || POINTER_BYTES != 8 || SIZE_BYTES != 8 || INT64_IS_LONG != 1) { أرجع 3; };
    أرجع 42;
}
