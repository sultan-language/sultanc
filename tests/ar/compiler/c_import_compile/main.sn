// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_compile/main.sn (بلا ترويسة `نظير`: خطوة
// الزوج تفسر التوأمين، ومفسر المترجم الساكن لا يستدعي دوال مكتبة سي التي
// يستعملها هذا الملف).
// يترجم جسر (compiler/jisr/lower.sn) شفرة سي في compile.c داخل هذا البرنامج،
// عبر خط الترجمة المعتاد (بلا مترجم سي): الحساب الصحيح والعشري، والمؤشرات
// والمصفوفات، والبنى والاتحادات والحقول البتية بالقيمة وفي الذاكرة،
// والحلقات، وسقوط switch ومدى الحالات، وgoto، وجهاز داف، والمتغيرات المحلية
// الساكنة، والكائنات العامة المهيأة، ومؤشرات الدوال، والدوال متغيرة
// المعاملات (va_list تمرر إلى vsnprintf) ونداؤها (snprintf). تعيد run_all
// صفرا حين يسلك كل جزء كما تعرفه سي، وإلا الجزء والسطر الذي فشل.
استورد "compile.c";

عرف الرئيسية(): عدد {
    دع الفشل: ص32 = run_all();
    إذا (الفشل != 0) { أرجع 1; };
    // كائن سي كتبته شفرة سي، يقرأ هنا.
    إذا (counter_value != 101) { أرجع 2; };
    إذا (add_points({ x: 1, y: 2 }, { x: 3, y: 4 }).y != 6) { أرجع 3; };
    أرجع 42;
}
