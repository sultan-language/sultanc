// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_units_variadic/main.sn
// نداءات متغيرة المعاملات بين وحدات الترجمة في استيراد واحد: يستدعي calls.c
// الدوال vsum وvmix وvlen التي يعرفها sum.c. يصير كل شكل نداء دالة سلطان
// تخزن المعاملات المتغيرة (بعد ترقيتها: unsigned char إلى int، وdouble،
// ومؤشر) في خانات من 8 بايتات وتستدعي مدخل الخانات لتلك الدالة في sum.c
// (compiler/jisr/units.sn)، الذي تقرؤه va_arg؛ بلا مترجم سي ولا نداء سي
// متغير.
استورد "calls.c+sum.c";

عرف الرئيسية(): عدد {
    دع الفشل: ص32 = run_calls();
    إذا (الفشل != 0) { أرجع الفشل مثل عدد; };
    // يستدعي السلطان دالة سي متغيرة بمعاملاتها الثابتة وحدها.
    إذا (vsum(0) != 0) { أرجع 10; };
    أرجع 42;
}
