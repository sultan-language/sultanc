// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/isolation.sn
// الإخفاقات تبقى مع مصادرها. في مساحة العمل هذه (root.sn الجذر، وselective.sn
// وunknown.sn ينضمان إليه):
//   failed.sn       يصرح بدالة مرتين (لا تُجمع تصريحاته)؛
//   dependent.sn    يستورد failed.sn: دالة تستعمل الوحدة الفاشلة وأخرى لا تستعملها؛
//   independent.sn  لا يعتمد على شيء فاشل؛
//   selective.sn    يختار اسما لا يصدّره std.io؛
//   unknown.sn      يستعمل اسما مجهولا في إحدى دالتيه.
// طلب الأدوات يضع جانبا التصريحات التي تستعمل المفقود وحدها: تبقى أنواع الدوال
// الأخرى في dependent.sn وunknown.sn، والوحدة المستقلة والجذر كاملان، ولا يرتد
// الناتج إلى حقائق الأسماء وحدها. أما الترجمة فما زالت تُرفض.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.tooling_facts;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.reference_queries;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.engine;
استورد compiler.source.span;
استورد std.text.search;
استورد std.text.transform;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف مسار(الاسم: نص): نص {
    دع الأجزاء: متجه نص = [«tests/ar/compiler/tooling/isolation/», الاسم];
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف حلل(للأدوات: منطقي): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    دع الجذر: نص = مسار(«root.sn»);
    دع الإضافية: متجه نص = [مسار(«selective.sn»), مسار(«unknown.sn»)];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: المفاتيح }) -> {
        دع المزيد: متغير متجه مفتاح_وحدة_مقنن = [];
        دع ف: متغير طبيعي = 1;
        طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
            ألحق(المزيد, انسخ_مفتاح_وحدة_مقنن(&المفاتيح[ف]));
            ف := ف + 1;
        }
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: للأدوات };
        دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &الإلغاء);
    };
}

عرف مصدر_باسم(الواجهة: &نتيجة_واجهة_وحدة, الاسم: نص): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        دع المعرف: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
        | اختياري.موجود(المكتوب) -> { إذا (ينتهي_بـ(&المكتوب, &الاسم)) { أرجع المعرف; } }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع 1000000;
}

عرف رمز_في(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, المطلوب: نص): اختياري معرف_رمز {
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموجود) -> {
        دع النص: نص = استنسخ(&الموجود.المحتوى);
        طابق ابحث_نصا(&النص, &المطلوب) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموضع) -> { أرجع رمز_واجهة_عند_بايت(الواجهة, المصدر, الموضع); };
    };
}

عرف له_نوع(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, المطلوب: نص): منطقي {
    طابق رمز_في(الواجهة, المصدر, المطلوب) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الرمز) -> {
        طابق نوع_رمز_واجهة(الواجهة, الرمز) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
    };
}

عرف كامل(الحالة: &اكتمال_مصدر_أدوات): منطقي {
    أرجع (*الحالة).التحميل && (*الحالة).الأسماء && (*الحالة).الأنواع;
}

عرف الرئيسية(): عدد {
    طابق حلل(صواب) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
        دع الجذر: طبيعي = مصدر_باسم(&الواجهة, «isolation/root.sn»);
        دع الفاشل: طبيعي = مصدر_باسم(&الواجهة, «isolation/failed.sn»);
        دع المعتمد: طبيعي = مصدر_باسم(&الواجهة, «isolation/dependent.sn»);
        دع المستقل: طبيعي = مصدر_باسم(&الواجهة, «isolation/independent.sn»);
        دع الانتقائي: طبيعي = مصدر_باسم(&الواجهة, «isolation/selective.sn»);
        دع المجهول: طبيعي = مصدر_باسم(&الواجهة, «isolation/unknown.sn»);
        إذا (الجذر == 1000000 || الفاشل == 1000000 || المعتمد == 1000000) { أرجع 1; }
        إذا (المستقل == 1000000 || الانتقائي == 1000000 || المجهول == 1000000) { أرجع 2; }
        دع حالة_الفاشل: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, الفاشل);
        دع حالة_المعتمد: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, المعتمد);
        دع حالة_المستقل: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, المستقل);
        دع حالة_الجذر: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, الجذر);
        دع حالة_الانتقائي: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, الانتقائي);
        دع حالة_المجهول: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, المجهول);
        إذا (حالة_الفاشل.الأسماء || حالة_الفاشل.الأنواع) { أرجع 5; }
        إذا (حالة_الانتقائي.الأسماء || حالة_الانتقائي.الأنواع) { أرجع 6; }
        إذا (!حالة_المعتمد.الأسماء || حالة_المعتمد.الأنواع) { أرجع 7; }
        إذا (حالة_المجهول.الأسماء || حالة_المجهول.الأنواع) { أرجع 8; }
        إذا (!كامل(&حالة_المستقل) || !كامل(&حالة_الجذر)) { أرجع 9; }
        إذا (!له_نوع(&الواجهة, المعتمد, «القيمة_الباقية»)) { أرجع 10; }
        إذا (!له_نوع(&الواجهة, المعتمد, «تستعمل_المكسورة»)) { أرجع 11; }
        إذا (!له_نوع(&الواجهة, المجهول, «الباقية_هنا»)) { أرجع 12; }
        إذا (!له_نوع(&الواجهة, المستقل, «القيمة_المستقلة»)) { أرجع 13; }
        طابق رمز_في(&الواجهة, المعتمد, «القيمة_المكسورة») مع
        | اختياري.لا_شيء -> { أرجع 14; }
        | اختياري.موجود(الرمز) -> {
            دع المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(&الواجهة, الرمز);
            دع في_المعتمد: متغير منطقي = خطأ;
            دع ر: متغير طبيعي = 0;
            طالما (ر < (الطول(المراجع) مثل طبيعي)) {
                إذا ((المراجع[ر].النطاق.البداية.المصدر مثل طبيعي) == المعتمد) { في_المعتمد := صواب; }
                ر := ر + 1;
            }
            إذا (!في_المعتمد) { أرجع 15; }
        };
        إذا (الواجهة.حقائق_الأدوات.الأنواع_متوقفة) { أرجع 16; }
        إذا (الواجهة.كاملة_دلاليا) { أرجع 17; }
    }
    | _ -> { أرجع 18; };
    طابق حلل(خطأ) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(_) -> { }
    | _ -> { أرجع 19; };
    أرجع 42;
}
