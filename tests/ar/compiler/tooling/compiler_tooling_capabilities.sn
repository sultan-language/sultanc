// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/compiler_tooling_capabilities.sn
// مداخل الواجهة الأمامية للأدوات: هرم مرادفات الأنواع، والاسترداد من خطأ نحوي
// (تبقى التصريحات الأخرى قابلة للاستعلام)، وإلغاء يُطلب قبل بدء التحليل.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.types.semantic_pipeline;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;

عرف طلب_لمسار(المسار: نص): اختياري طلب_واجهة_وحدة {
    دع الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: صواب };
        أرجع اختياري.موجود(الطلب);
    };
}

عرف افحص_الهرم(المسار: نص): عدد {
    طابق طلب_لمسار(المسار) مع
    | اختياري.لا_شيء -> { أرجع 10; }
    | اختياري.موجود(الطلب) -> {
        طابق ابن_واجهة_وحدة(الطلب) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(_) -> { أرجع 20; }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            إذا ((الطول(الواجهة.سياقات_الأنواع.علاقات_هرم_الأنواع) مثل طبيعي) < 2) { أرجع 21; }
            دع الأولى: علاقة_هرم_نوع = الواجهة.سياقات_الأنواع.علاقات_هرم_الأنواع[0];
            دع العليا: متجه معرف_رمز = أنواع_عليا_لرمز_واجهة(&الواجهة, الأولى.النوع_الفرعي);
            دع الفرعية: متجه معرف_رمز = أنواع_فرعية_لرمز_واجهة(&الواجهة, الأولى.النوع_العلوي);
            إذا ((الطول(العليا) مثل طبيعي) == 0) { أرجع 22; }
            إذا ((الطول(الفرعية) مثل طبيعي) == 0) { أرجع 23; }
            أرجع 42;
        };
    };
}

عرف افحص_الاسترداد(المسار: نص): عدد {
    طابق طلب_لمسار(المسار) مع
    | اختياري.لا_شيء -> { أرجع 30; }
    | اختياري.موجود(الطلب) -> {
        طابق ابن_واجهة_وحدة(الطلب) مع
        | نتيجة_بناء_واجهة_وحدة.مرفوضة(_) -> { أرجع 31; }
        | نتيجة_بناء_واجهة_وحدة.مكتملة(الواجهة) -> {
            إذا (الواجهة.كاملة_دلاليا) { أرجع 32; }
            إذا (الواجهة.تشخيصات_الأدوات.عدد_الأخطاء == 0) { أرجع 33; }
            إذا ((الطول(الواجهة.الوحدات) مثل طبيعي) == 0) { أرجع 34; }
            دع المصدر: طبيعي = الواجهة.الوحدات[0].معرف_المصدر;
            دع الرموز: متجه رمز_دلالي = رموز_واجهة_لمصدر(&الواجهة, المصدر);
            إذا ((الطول(الرموز) مثل طبيعي) < 2) { أرجع 35; }
            أرجع 42;
        };
    };
}

عرف افحص_الإلغاء(المسار: نص): عدد {
    طابق طلب_لمسار(المسار) مع
    | اختياري.لا_شيء -> { أرجع 40; }
    | اختياري.موجود(الطلب) -> {
        دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        اطلب_إلغاء_واجهة(&الإلغاء);
        طابق ابن_واجهة_وحدة_قابلة_للإلغاء(الطلب, &الإلغاء) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { أرجع 42; }
        | _ -> { أرجع 41; };
    };
}

عرف الرئيسية(): عدد {
    دع الهرم: عدد = افحص_الهرم(«tests/ar/compiler/tooling/hierarchy/source.sn»);
    إذا (الهرم != 42) { أرجع الهرم; }
    دع الاسترداد: عدد = افحص_الاسترداد(«tests/ar/compiler/tooling/recovery/source.sn»);
    إذا (الاسترداد != 42) { أرجع الاسترداد; }
    أرجع افحص_الإلغاء(«tests/ar/compiler/tooling/hierarchy/source.sn»);
}
