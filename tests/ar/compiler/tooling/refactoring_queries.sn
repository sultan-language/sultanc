// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/refactoring_queries.sn
// استعلامات إعادة الهيكلة للقراءة فقط (compiler/frontend/tooling_queries.sn) على
// ناتج الواجهة الأمامية المقنن: أدوار المراجع (مع نقول SSF)، والرمز نفسه بتهجئة
// عربية وأخرى إنجليزية، ومديات البايت وUTF-16 الدقيقة، وتعارضات إعادة التسمية،
// والرموز العليا، وتصريحات الأهداف الأخرى، وحقائق تضمين المتغير، ونوع التعبير
// بمدى دقيق، واستخراج الدالة، وعلاقات الاستيراد والاستيرادات غير المستخدمة.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.tooling_queries;
استورد compiler.frontend.names.reference_queries;
استورد compiler.frontend.names.extract_queries;
استورد compiler.frontend.names.import_queries;
استورد compiler.frontend.types.tooling_queries;
استورد compiler.frontend.types.type_identity;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.schema;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.compare;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف ابن(المسار: نص): اختياري نتيجة_واجهة_وحدة {
    دع الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: صواب };
        دع المزيد: متجه مفتاح_وحدة_مقنن = [];
        دع الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &متغير الإلغاء) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع اختياري.موجود(الواجهة); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف محتوى(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الموجود) -> { أرجع استنسخ(&الموجود.المحتوى); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف موضع_من_بعد(النص: &نص, المطلوب: نص, الأصل: طبيعي): طبيعي {
    طابق ابحث_نصا_من(النص, &المطلوب, الأصل) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع; }
    | اختياري.لا_شيء -> { أرجع 1000000; };
}

عرف موضع_أول(النص: &نص, المطلوب: نص): طبيعي {
    أرجع موضع_من_بعد(النص, المطلوب, 0);
}

عرف نص_المدى(النص: &نص, المدى: نطاق): نص {
    دع البداية: طبيعي = المدى.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = المدى.النهاية.البايت مثل طبيعي;
    إذا (النهاية < البداية) { أرجع «»; }
    طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
    | اختياري.موجود(الجزء) -> { أرجع الجزء; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف رمز_عند(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, الموضع: طبيعي): طبيعي {
    طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, الموضع) مع
    | اختياري.موجود(الرمز) -> { أرجع الرمز.القيمة مثل طبيعي; }
    | اختياري.لا_شيء -> { أرجع 4000000000; };
}

عرف عدد_الدور(المراجع: &متجه مرجع_رمز_دلالي, الدور: دور_مرجع): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المراجع) مثل طبيعي)) {
        إذا ((*المراجع)[ف].الدور == الدور) { العدد := العدد + 1; }
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف عدد_البديلة(المراجع: &متجه مرجع_رمز_دلالي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المراجع) مثل طبيعي)) {
        إذا ((*المراجع)[ف].تهجئة_بديلة) { العدد := العدد + 1; }
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف المديات_تهجي(النص: &نص, المراجع: &متجه مرجع_رمز_دلالي, الأول: نص, الثاني: نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المراجع) مثل طبيعي)) {
        دع المكتوب: نص = نص_المدى(النص, (*المراجع)[ف].النطاق);
        إذا (!نصان_متساويان(&المكتوب, &الأول) && !نصان_متساويان(&المكتوب, &الثاني)) { أرجع خطأ; }
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف فيها_تعارض(التعارضات: &متجه تعارض_إعادة_تسمية_دلالي, النوع: نوع_تعارض_إعادة_تسمية): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التعارضات) مثل طبيعي)) {
        إذا ((*التعارضات)[ف].النوع == النوع) { أرجع صواب; }
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف تعارضات(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, الموضع: طبيعي, الاسم: نص): متجه تعارض_إعادة_تسمية_دلالي {
    أرجع تعارضات_إعادة_تسمية_واجهة(الواجهة, المصدر, الموضع, &الاسم);
}

عرف خطة_مرفوضة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, الموضع: طبيعي, الاسم: نص): منطقي {
    طابق خطط_إعادة_تسمية_واجهة(الواجهة, المصدر, الموضع, &الاسم) مع
    | نتيجة_خطة_إعادة_تسمية_دلالية.مرفوضة(رفض_إعادة_تسمية_دلالي.تعارض_اسم) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف حجم_الخطة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, الموضع: طبيعي, الاسم: نص): طبيعي {
    طابق خطط_إعادة_تسمية_واجهة(الواجهة, المصدر, الموضع, &الاسم) مع
    | نتيجة_خطة_إعادة_تسمية_دلالية.جاهزة(الخطة) -> { أرجع الطول(الخطة.النطاقات) مثل طبيعي; }
    | _ -> { أرجع 0; };
}

عرف ابحث_متغيرا(المتغيرات: &متجه متغير_استخراج_واجهة, الرمز: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المتغيرات) مثل طبيعي)) {
        إذا (((*المتغيرات)[ف].الرمز.القيمة مثل طبيعي) == الرمز) { أرجع اختياري.موجود(ف); }
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// السطر من الصفر، والعمود بالبايت، والعمود بوحدات UTF-16 (كل محارف المُثبّت في
// المستوى الأساسي، فوحدة UTF-16 لكل محرف)، تُعد مباشرة.
عرف سطر_الموضع(النص: &نص, الموضع: طبيعي): طبيعي {
    دع السطر: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الموضع) {
        إذا ((*النص)[ف] == (0x0A مثل ط8)) { السطر := السطر + 1; }
        ف := ف + 1;
    }
    أرجع السطر;
}

عرف بداية_سطر(النص: &نص, الموضع: طبيعي): طبيعي {
    دع ف: متغير طبيعي = الموضع;
    طالما (ف > 0 && (*النص)[ف - 1] != (0x0A مثل ط8)) { ف := ف - 1; }
    أرجع ف;
}

عرف وحدات_يوتيف16(النص: &نص, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا (((*النص)[ف] & (0xC0 مثل ط8)) != (0x80 مثل ط8)) { العدد := العدد + 1; }
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف افحص_المراجع(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    // الرمز نفسه بالتهجئتين.
    دع اضرب: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «اضرب(2»));
    دع المرادف: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «scale(المجموع»));
    دع المصرح: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «اضرب(القيمة»));
    إذا (اضرب == 4000000000 || اضرب != المرادف || اضرب != المصرح) { أرجع 1; }
    دع المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, معرف_رمز_من(اضرب));
    إذا (!المديات_تهجي(النص, &المراجع, «اضرب», «scale»)) { أرجع 2; }
    إذا (عدد_الدور(&المراجع, دور_مرجع.تصريح()) != 2) { أرجع 3; }
    إذا (عدد_الدور(&المراجع, دور_مرجع.استدعاء()) != 3) { أرجع 4; }
    إذا (عدد_البديلة(&المراجع) != 2) { أرجع 5; }

    دع المجموع: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «المجموع: متغير»));
    دع مراجع_المجموع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, معرف_رمز_من(المجموع));
    إذا (!المديات_تهجي(النص, &مراجع_المجموع, «المجموع», «المجموع»)) { أرجع 6; }
    إذا (عدد_الدور(&مراجع_المجموع, دور_مرجع.تصريح()) != 1) { أرجع 7; }
    إذا (عدد_الدور(&مراجع_المجموع, دور_مرجع.كتابة()) != 3) { أرجع 8; }
    إذا (عدد_الدور(&مراجع_المجموع, دور_مرجع.استعارة_متغيرة()) != 1) { أرجع 9; }
    إذا (عدد_الدور(&مراجع_المجموع, دور_مرجع.استعارة()) != 1) { أرجع 10; }
    إذا (عدد_الدور(&مراجع_المجموع, دور_مرجع.قراءة()) != 5) { أرجع 11; }

    دع العناصر: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «العناصر: متجه عدد = »));
    دع مراجع_العناصر: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, معرف_رمز_من(العناصر));
    إذا (عدد_الدور(&مراجع_العناصر, دور_مرجع.نقل()) != 1) { أرجع 12; }
    أرجع 0;
}

عرف افحص_المديات(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    // `المجموع` بعد نص عربي: 14 بايتا و7 وحدات UTF-16.
    دع الموضع: طبيعي = موضع_أول(النص, «المجموع, 2»);
    دع المدى: نطاق = نطاق_بين(موضع_من(المصدر, الموضع), موضع_من(المصدر, الموضع + 14));
    طابق مدى_أداة_واجهة(الواجهة, المدى) مع
    | اختياري.لا_شيء -> { أرجع 20; }
    | اختياري.موجود(الناتج) -> {
        دع البداية: طبيعي = بداية_سطر(النص, الموضع);
        دع وحدات: طبيعي = وحدات_يوتيف16(النص, البداية, الموضع);
        إذا (الناتج.البداية.السطر != سطر_الموضع(النص, الموضع)) { أرجع 21; }
        إذا (الناتج.البداية.العمود_بايت != الموضع - البداية || الناتج.البداية.العمود_يوتيف16 != وحدات) { أرجع 22; }
        إذا (وحدات == الموضع - البداية) { أرجع 23; }
        إذا (الناتج.النهاية.العمود_بايت != الموضع - البداية + 14 || الناتج.النهاية.العمود_يوتيف16 != وحدات + 7) { أرجع 24; }
    };
    // `اضرب` بعد `مرادف scale = `: العمود 19 بايتا و14 وحدة.
    دع موضع_اضرب: طبيعي = موضع_أول(النص, «اضرب;»);
    دع مدى_اضرب: نطاق = نطاق_بين(موضع_من(المصدر, موضع_اضرب), موضع_من(المصدر, موضع_اضرب + 8));
    طابق مدى_أداة_واجهة(الواجهة, مدى_اضرب) مع
    | اختياري.لا_شيء -> { أرجع 25; }
    | اختياري.موجود(الناتج) -> {
        إذا (الناتج.البداية.العمود_بايت != 19 || الناتج.البداية.العمود_يوتيف16 != 14) { أرجع 26; }
        إذا (الناتج.النهاية.العمود_بايت != 27 || الناتج.النهاية.العمود_يوتيف16 != 18) { أرجع 27; }
    };
    أرجع 0;
}

عرف افحص_إعادة_التسمية(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    دع موضع_العامل: طبيعي = موضع_أول(النص, «العامل: عدد = 3»);
    دع التعارض_الداخلي: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, موضع_العامل, «الخطوة»);
    إذا (!فيها_تعارض(&التعارض_الداخلي, نوع_تعارض_إعادة_تسمية.التقاط_داخلي())) { أرجع 30; }
    إذا (!خطة_مرفوضة(الواجهة, المصدر, موضع_العامل, «الخطوة»)) { أرجع 31; }
    دع موضع_المؤقت: طبيعي = موضع_أول(النص, «المؤقت: عدد»);
    دع التعارض_الخارجي: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, موضع_المؤقت, «اضرب»);
    إذا (!فيها_تعارض(&التعارض_الخارجي, نوع_تعارض_إعادة_تسمية.التقاط_خارجي())) { أرجع 32; }
    إذا (!خطة_مرفوضة(الواجهة, المصدر, موضع_المؤقت, «اضرب»)) { أرجع 33; }
    دع نفسه: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, موضع_العامل, «المجموع»);
    إذا (!فيها_تعارض(&نفسه, نوع_تعارض_إعادة_تسمية.نفس_النطاق())) { أرجع 34; }
    دع موضع_الخطوة: طبيعي = موضع_أول(النص, «الخطوة: عدد»);
    دع التعارض_الآمن: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, موضع_الخطوة, «المضاعف»);
    إذا ((الطول(التعارض_الآمن) مثل طبيعي) != 0) { أرجع 35; }
    إذا (حجم_الخطة(الواجهة, المصدر, موضع_الخطوة, «المضاعف») != 3) { أرجع 36; }
    // إعادة التسمية تعدّل التهجئة المختارة وحدها: `اضرب` أربع مرات، ومرادفها
    // الإنجليزي `scale` مرتين (تصريحه واستدعاؤه).
    إذا (حجم_الخطة(الواجهة, المصدر, موضع_أول(النص, «اضرب(2»), «اضرب_الجديد») != 4) { أرجع 37; }
    إذا (حجم_الخطة(الواجهة, المصدر, موضع_أول(النص, «scale(المجموع»), «multiply») != 2) { أرجع 38; }
    أرجع 0;
}

عرف افحص_الرموز(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    دع العليا: متجه رمز_أعلى_دلالي = رموز_عليا_واجهة(الواجهة);
    دع اضرب: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «اضرب(2»));
    دع المجموع: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «المجموع: متغير»));
    دع وجد: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العليا) مثل طبيعي)) {
        دع المعرف: طبيعي = العليا[ف].الرمز.المعرف.القيمة مثل طبيعي;
        إذا (المعرف == المجموع) { أرجع 40; }
        إذا (المعرف == اضرب) { وجد := صواب; }
        ف := ف + 1;
    }
    إذا (!وجد) { أرجع 41; }
    دع الدرجة: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «درجة_المنصة();»));
    دع الأخرى: متجه نطاق = تصريحات_لأهداف_أخرى_واجهة(الواجهة, معرف_رمز_من(الدرجة));
    إذا ((الطول(الأخرى) مثل طبيعي) != 1) { أرجع 42; }
    دع المكتوب: نص = نص_المدى(النص, الأخرى[0]);
    دع المتوقع: نص = «درجة_المنصة»;
    إذا (!نصان_متساويان(&المكتوب, &المتوقع)) { أرجع 43; }
    إذا ((الأخرى[0].البداية.البايت مثل طبيعي) != موضع_أول(النص, «درجة_المنصة(): عدد { أرجع 1»)) { أرجع 44; }
    أرجع 0;
}

عرف افحص_التضمين_والأنواع(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    دع العامل: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «العامل: عدد = 3»));
    طابق معلومات_تضمين_محلي_واجهة(الواجهة, معرف_رمز_من(العامل)) مع
    | اختياري.لا_شيء -> { أرجع 50; }
    | اختياري.موجود(الحقائق) -> {
        إذا (الحقائق.قابل_للتغيير || الحقائق.عدد_الكتابات != 0) { أرجع 51; }
        طابق الحقائق.نطاق_التهيئة مع
        | اختياري.لا_شيء -> { أرجع 52; }
        | اختياري.موجود(المدى) -> {
            دع المكتوب: نص = نص_المدى(النص, المدى);
            دع المتوقع: نص = «3»;
            إذا (!نصان_متساويان(&المكتوب, &المتوقع)) { أرجع 53; }
        };
    };
    دع المجموع: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «المجموع: متغير»));
    طابق معلومات_تضمين_محلي_واجهة(الواجهة, معرف_رمز_من(المجموع)) مع
    | اختياري.لا_شيء -> { أرجع 54; }
    | اختياري.موجود(الحقائق) -> { إذا (!الحقائق.قابل_للتغيير || الحقائق.عدد_الكتابات != 4) { أرجع 55; } };
    // «العامل * الخطوة»: 27 بايتا.
    دع الموضع: طبيعي = موضع_أول(النص, «العامل * الخطوة»);
    طابق نوع_تعبير_بمدى_واجهة(الواجهة, المصدر, الموضع, الموضع + 27) مع
    | اختياري.لا_شيء -> { أرجع 56; }
    | اختياري.موجود(النوع) -> {
        طابق تهجئة_نوع_واجهة(الواجهة, النوع) مع
        | اختياري.لا_شيء -> { أرجع 57; }
        | اختياري.موجود(_) -> { };
    };
    طابق نوع_تعبير_بمدى_واجهة(الواجهة, المصدر, الموضع, الموضع + 14) مع
    | اختياري.موجود(_) -> { أرجع 58; }
    | اختياري.لا_شيء -> { };
    أرجع 0;
}

عرف افحص_الاستخراج(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    دع المجموع: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «المجموع: متغير»));
    دع العامل: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «العامل: عدد = 3»));
    دع الأخيرة: نص = «المجموع := المجموع + الإضافة;»;
    دع البداية: طبيعي = موضع_أول(النص, «دع الخطوة»);
    دع النهاية: طبيعي = موضع_أول(النص, «المجموع := المجموع + الإضافة;») + (الطول(الأخيرة) مثل طبيعي);
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, البداية, النهاية) مع
    | نتيجة_استخراج_دالة_واجهة.مرفوض(_) -> { أرجع 60; }
    | نتيجة_استخراج_دالة_واجهة.جاهز(الموجود) -> {
        إذا ((الطول(الموجود.المدخلات) مثل طبيعي) != 2 || (الطول(الموجود.المخرجات) مثل طبيعي) != 0) { أرجع 61; }
        إذا (الموجود.يحوي_إرجاع || الموجود.يحوي_قفزا_خارجيا) { أرجع 62; }
        طابق ابحث_متغيرا(&الموجود.المدخلات, المجموع) مع
        | اختياري.لا_شيء -> { أرجع 63; }
        | اختياري.موجود(ف) -> {
            إذا (!الموجود.المدخلات[ف].مكتوب || !الموجود.المدخلات[ف].مقروء || !الموجود.المدخلات[ف].مستخدم_بعد) { أرجع 64; }
            إذا (!الموجود.المدخلات[ف].قابل_للتغيير) { أرجع 65; }
            طابق الموجود.المدخلات[ف].النوع مع
            | اختياري.لا_شيء -> { أرجع 66; }
            | اختياري.موجود(_) -> { };
        };
        طابق ابحث_متغيرا(&الموجود.المدخلات, العامل) مع
        | اختياري.لا_شيء -> { أرجع 67; }
        | اختياري.موجود(ف) -> {
            إذا (الموجود.المدخلات[ف].مكتوب || الموجود.المدخلات[ف].مستخدم_بعد || الموجود.المدخلات[ف].قابل_للتغيير) { أرجع 68; }
        };
        طابق الموجود.الدالة مع
        | اختياري.لا_شيء -> { أرجع 69; }
        | اختياري.موجود(_) -> { };
    };
    دع الحاصل: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, «الحاصل: عدد»));
    دع الاستدعاء: نص = «اضرب(المؤقت, 1);»;
    دع بداية_ثانية: طبيعي = موضع_أول(النص, «دع المؤقت»);
    دع نهاية_ثانية: طبيعي = موضع_أول(النص, «اضرب(المؤقت, 1);») + (الطول(الاستدعاء) مثل طبيعي);
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, بداية_ثانية, نهاية_ثانية) مع
    | نتيجة_استخراج_دالة_واجهة.مرفوض(_) -> { أرجع 70; }
    | نتيجة_استخراج_دالة_واجهة.جاهز(الموجود) -> {
        إذا ((الطول(الموجود.المدخلات) مثل طبيعي) != 0 || (الطول(الموجود.المخرجات) مثل طبيعي) != 1) { أرجع 71; }
        إذا ((الموجود.المخرجات[0].الرمز.القيمة مثل طبيعي) != الحاصل) { أرجع 72; }
    };
    دع الجزء: طبيعي = موضع_أول(النص, «اضرب(2, العامل)»);
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, الجزء, الجزء + 10) مع
    | نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.غير_محاذ_للعبارات) -> { }
    | _ -> { أرجع 73; };
    دع الإرجاع: نص = «درجة_المنصة();»;
    دع بداية_الإرجاع: طبيعي = موضع_أول(النص, «أرجع المضاعف»);
    دع نهاية_الإرجاع: طبيعي = موضع_أول(النص, «درجة_المنصة();») + (الطول(الإرجاع) مثل طبيعي);
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, بداية_الإرجاع, نهاية_الإرجاع) مع
    | نتيجة_استخراج_دالة_واجهة.جاهز(الموجود) -> { إذا (!الموجود.يحوي_إرجاع) { أرجع 74; } }
    | _ -> { أرجع 75; };
    // شكل الخطة: `المجموع` يُكتب داخل المدى ويُستعمل بعده (&متغير)، و`العامل` يُقرأ فقط.
    طابق حلل_استخراج_دالة(الواجهة, المصدر, البداية, النهاية) مع
    | نتيجة_حلل_استخراج.غير_صالح(_) -> { أرجع 77; }
    | نتيجة_حلل_استخراج.صالح(الخطة) -> {
        إذا ((الطول(الخطة.المدخلات) مثل طبيعي) != 1 || (الخطة.المدخلات[0].الرمز.القيمة مثل طبيعي) != العامل) { أرجع 78; }
        إذا ((الطول(الخطة.المستعارة_متغيرة) مثل طبيعي) != 1 || (الخطة.المستعارة_متغيرة[0].الرمز.القيمة مثل طبيعي) != المجموع) { أرجع 79; }
        طابق الخطة.نوع_القيمة مع
        | اختياري.موجود(_) -> { أرجع 92; }
        | اختياري.لا_شيء -> { };
    };
    // تعبير كامل واحد له نوع قيمة ويقرأ متغيرين محليين.
    دع التعبير: طبيعي = موضع_أول(النص, «العامل * الخطوة»);
    طابق حلل_استخراج_دالة(الواجهة, المصدر, التعبير, التعبير + 27) مع
    | نتيجة_حلل_استخراج.غير_صالح(_) -> { أرجع 93; }
    | نتيجة_حلل_استخراج.صالح(الخطة) -> {
        إذا ((الطول(الخطة.المدخلات) مثل طبيعي) != 2) { أرجع 94; }
        طابق الخطة.نوع_القيمة مع
        | اختياري.لا_شيء -> { أرجع 95; }
        | اختياري.موجود(_) -> { };
    };
    طابق حلل_استخراج_دالة(الواجهة, المصدر, بداية_الإرجاع, نهاية_الإرجاع) مع
    | نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.قفز_خارج_المدى) -> { }
    | _ -> { أرجع 96; };
    طابق حلل_استخراج_دالة(الواجهة, المصدر, الجزء, الجزء + 10) مع
    | نتيجة_حلل_استخراج.غير_صالح(سبب_رفض_استخراج.ليس_عبارات_أو_تعبيرا) -> { }
    | _ -> { أرجع 97; };
    طابق حلل_استخراج_دالة_واجهة(الواجهة, المصدر, 0, 5) مع
    | نتيجة_استخراج_دالة_واجهة.مرفوض(رفض_استخراج_دالة.خارج_دالة) -> { }
    | _ -> { أرجع 76; };
    أرجع 0;
}

عرف افحص_الاستيرادات(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص): عدد {
    دع العلاقات: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(الواجهة, المصدر, صواب);
    إذا ((الطول(العلاقات) مثل طبيعي) != 4) { أرجع 83; }
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العلاقات) مثل طبيعي)) {
        طابق العلاقات[ف].نطاق_العبارة مع
        | اختياري.لا_شيء -> { أرجع 84; }
        | اختياري.موجود(العبارة) -> {
            دع المكتوب: نص = نص_المدى(النص, العبارة);
            دع البادئة: نص = «استورد »;
            إذا (!يبدأ_بـ(&المكتوب, &البادئة)) { أرجع 85; }
        };
        ف := ف + 1;
    }
    دع المساعد: طبيعي = العلاقات[0].مصدر_المستورد_منه;
    دع المستوردون: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(الواجهة, المساعد, خطأ);
    إذا ((الطول(المستوردون) مثل طبيعي) != 1 || المستوردون[0].مصدر_المستورد != المصدر) { أرجع 86; }
    دع غير_المستخدمة: متجه استيراد_غير_مستخدم = استيرادات_غير_مستخدمة_واجهة(الواجهة, المصدر);
    إذا ((الطول(غير_المستخدمة) مثل طبيعي) != 2) { أرجع 87; }
    دع البحث_غير_مستخدم: متغير منطقي = خطأ;
    دع المقارنة_مكررة: متغير منطقي = خطأ;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(غير_المستخدمة) مثل طبيعي)) {
        طابق غير_المستخدمة[ك].نطاق_العبارة مع
        | اختياري.لا_شيء -> { أرجع 88; }
        | اختياري.موجود(العبارة) -> {
            دع المكتوب: نص = نص_المدى(النص, العبارة);
            دع البحث: نص = «استورد std.text.search;»;
            دع المقارنة: نص = «استورد std.text.compare;»;
            إذا (نصان_متساويان(&المكتوب, &البحث) && غير_المستخدمة[ك].غير_مستخدم && !غير_المستخدمة[ك].مكرر) { البحث_غير_مستخدم := صواب; }
            إذا (نصان_متساويان(&المكتوب, &المقارنة) && غير_المستخدمة[ك].مكرر
                && (العبارة.البداية.البايت مثل طبيعي) > موضع_أول(النص, «استورد std.text.search»)) {
                المقارنة_مكررة := صواب;
            }
        };
        ك := ك + 1;
    }
    إذا (!البحث_غير_مستخدم || !المقارنة_مكررة) { أرجع 89; }
    أرجع 0;
}

عرف افحص_التصادم(الواجهة: &نتيجة_واجهة_وحدة): عدد {
    دع المصدر: طبيعي = (*الواجهة).الوحدات[0].معرف_المصدر;
    دع النص: نص = محتوى(الواجهة, المصدر);
    // `ضاعف` علني في helper.sn، وهذه الوحدة تبلغ `نصان_متساويان` من std.
    دع الموضع: طبيعي = موضع_أول(&النص, «ضاعف(21)»);
    دع التعارضات: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, الموضع, «نصان_متساويان»);
    إذا (!فيها_تعارض(&التعارضات, نوع_تعارض_إعادة_تسمية.تعارض_وحدة())) { أرجع 80; }
    إذا (!خطة_مرفوضة(الواجهة, المصدر, الموضع, «نصان_متساويان»)) { أرجع 81; }
    دع حر: متجه تعارض_إعادة_تسمية_دلالي = تعارضات(الواجهة, المصدر, الموضع, «ثلّث»);
    إذا ((الطول(حر) مثل طبيعي) != 0) { أرجع 82; }
    أرجع افحص_الاستيرادات(الواجهة, المصدر, &النص);
}

عرف الرئيسية(): عدد {
    طابق ابن(«tests/ar/compiler/tooling/refactoring/source.sn») مع
    | اختياري.لا_شيء -> { أرجع 90; }
    | اختياري.موجود(الواجهة) -> {
        دع المصدر: طبيعي = الواجهة.الوحدات[0].معرف_المصدر;
        دع النص: نص = محتوى(&الواجهة, المصدر);
        دع الناتج: متغير عدد = افحص_المراجع(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
        الناتج := افحص_المديات(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
        الناتج := افحص_إعادة_التسمية(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
        الناتج := افحص_الرموز(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
        الناتج := افحص_التضمين_والأنواع(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
        الناتج := افحص_الاستخراج(&الواجهة, المصدر, &النص);
        إذا (الناتج != 0) { أرجع الناتج; }
    };
    طابق ابن(«tests/ar/compiler/tooling/refactoring/collide.sn») مع
    | اختياري.لا_شيء -> { أرجع 91; }
    | اختياري.موجود(الواجهة) -> {
        دع الناتج: عدد = افحص_التصادم(&الواجهة);
        إذا (الناتج != 0) { أرجع الناتج; }
    };
    أرجع 42;
}
