// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/let_tuple_queries.sn
// استعلامات المحرر في compiler/frontend/tooling_queries.sn على أسماء `ليكن` المفككة: كل اسم
// رمز واحد مراجعه تصريحه في النمط واستعمالاته بعده، ولكل منها النوع المكتوب له، فـ`اليسار`،
// وهو `متغير [] عدد`، قابل للكتابة، و`اليمين`، وهو `[] عدد`، و`الناتج`، وهو `عدد`، ليسا كذلك.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.tooling_queries;
استورد compiler.frontend.names.reference_queries;
استورد compiler.frontend.types.tooling_queries;
استورد compiler.frontend.types.type_identity;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.schema;
استورد compiler.source.span;
استورد compiler.source.source_file;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.مقطع;
استورد المكتبة.نصوص.مقارنة;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف ابن(المسار: نص): اختياري نتيجة_واجهة_وحدة {
    ليكن الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        ليكن الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: صواب };
        ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
        ليكن الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &متغير الإلغاء) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع اختياري.موجود(الواجهة); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف محتوى(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الموجود) -> { أرجع استنسخ(&الموجود.المحتوى); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف موضع_أول(النص: &نص, المطلوب: نص): طبيعي {
    طابق ابحث_نصا_من(النص, &المطلوب, 0) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع; }
    | اختياري.لا_شيء -> { أرجع 1000000; };
}

عرف نص_المدى(النص: &نص, المدى: نطاق): نص {
    ليكن البداية: طبيعي = المدى.البداية.البايت مثل طبيعي;
    ليكن النهاية: طبيعي = المدى.النهاية.البايت مثل طبيعي;
    إذا (النهاية < البداية) { أرجع «»; }
    طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
    | اختياري.موجود(الجزء) -> { أرجع الجزء; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف رمز_عند(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, الموضع: طبيعي): طبيعي {
    طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, الموضع) مع
    | اختياري.موجود(الرمز) -> { أرجع الرمز.القيمة مثل طبيعي; }
    | اختياري.لا_شيء -> { أرجع 4000000000; };
}

عرف التصريحات(المراجع: &متجه مرجع_رمز_دلالي): طبيعي {
    ليكن العدد: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المراجع) مثل طبيعي)) {
        إذا ((*المراجع)[ف].الدور == دور_مرجع.تصريح()) { العدد := العدد + 1; }
        ف := ف + 1;
    }
    أرجع العدد;
}

// الاسم المصرح به عند `المصرح` والمستعمل عند `المستعمل`: رمز واحد يُكتب `الاسم` في كل
// مرجع من مراجعه وعددها `العدد`، أحدها تصريحه.
عرف افحص_الاسم(
    الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص,
    المصرح: نص, المستعمل: نص, الاسم: نص, العدد: طبيعي
): منطقي {
    ليكن الرمز: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, المصرح));
    إذا (الرمز == 4000000000 || الرمز != رمز_عند(الواجهة, المصدر, موضع_أول(النص, المستعمل))) { أرجع خطأ; }
    ليكن المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(الواجهة, معرف_رمز_من(الرمز));
    إذا ((الطول(المراجع) مثل طبيعي) != العدد || التصريحات(&المراجع) != 1) { أرجع خطأ; }
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن المكتوب: نص = نص_المدى(النص, المراجع[ف].النطاق);
        إذا (!نصان_متساويان(&المكتوب, &الاسم)) { أرجع خطأ; }
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قابل_للكتابة(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي, النص: &نص, المصرح: نص): منطقي {
    ليكن الرمز: طبيعي = رمز_عند(الواجهة, المصدر, موضع_أول(النص, المصرح));
    أرجع رمز_قابل_للتغيير_واجهة(الواجهة, معرف_رمز_من(الرمز));
}

عرف الرئيسية(): عدد {
    طابق ابن(«tests/ar/compiler/tooling/let_tuple/source.sn») مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(الواجهة) -> {
        ليكن المصدر: طبيعي = الواجهة.الوحدات[0].معرف_المصدر;
        ليكن النص: نص = محتوى(&الواجهة, المصدر);
        إذا (!افحص_الاسم(&الواجهة, المصدر, &النص, «الناتج، الباقي», «الناتج;», «الناتج», 2)) { أرجع 2; }
        إذا (!افحص_الاسم(&الواجهة, المصدر, &النص, «الباقي)», «الباقي;», «الباقي», 2)) { أرجع 3; }
        إذا (!افحص_الاسم(&الواجهة, المصدر, &النص, «اليسار، اليمين», «اليسار[1]», «اليسار», 3)) { أرجع 4; }
        إذا (!افحص_الاسم(&الواجهة, المصدر, &النص, «اليمين): (متغير», «اليمين[1]», «اليمين», 2)) { أرجع 5; }
        إذا (!قابل_للكتابة(&الواجهة, المصدر, &النص, «اليسار، اليمين»)) { أرجع 6; }
        إذا (قابل_للكتابة(&الواجهة, المصدر, &النص, «اليمين): (متغير»)) { أرجع 7; }
        إذا (قابل_للكتابة(&الواجهة, المصدر, &النص, «الناتج، الباقي»)) { أرجع 8; }
    };
    أرجع 42;
}
