// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/tooling/completion.sn
// الإكمال عند المؤشر (compiler/frontend/tooling_completion.sn) في أسطر لم
// تكتمل بعد: حقول قيمة سجل (في مصدر إنجليزي وآخر عربي)، ومسار استيراد عبر
// تهجئات المكتبة العربية، والأسماء المرئية مع بعدها، ومنشئات تعداد، ولا شيء
// داخل نص؛ ثم (C1 إلى C9) حقول ناتج استدعاء وحقول ما يشير إليه مرجع
// وحقول عنصر متجه، ومنشئات الاختياري المدمجة، والأنواع في موضع نوع، والحقول
// التي لم تُكتب بعد في حرفي سجل، والحالات التي لم تغطها مطابقة، ومعاملات
// الاستدعاء التي يلائم نوعها المعامل؛ ثم (C10 وC11) ما يُدرجه المنشئ: نداء في
// موضع قيمة (`Red()` و`Circle(`) واسمه وحده في موضع نمط، مع عدد حمولاته. يُرقَّع كل مصدر (رقع_مصدر_للإكمال)،
// ويُحلَّل النص المرقَّع على أنه الملف، وتُقرأ المرشحات من التحليل أو من
// البيئة.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_completion;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.ملفات.مؤقت;
استورد المكتبة.ملفات.كتابة_ملف;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.نصوص.من_بايتات;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف ابن(المسار: نص): اختياري نتيجة_واجهة_وحدة {
    ليكن الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        ليكن الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: صواب };
        ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
        ليكن الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &متغير الإلغاء) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع اختياري.موجود(الواجهة); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

// البايت الذي يلي أول ظهور لـ المطلوب.
عرف المؤشر_بعد(النص: &نص, المطلوب: نص): طبيعي {
    طابق ابحث_نصا_من(النص, &المطلوب, 0) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع + (الطول(المطلوب) مثل طبيعي); }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// مصدر التحليل الذي ينتهي اسمه بـ الاسم.
عرف المصدر_المسمى(الواجهة: &نتيجة_واجهة_وحدة, الاسم: &نص): اختياري طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 100000) {
        طابق اسم_مصدر_واجهة_بمعرف(الواجهة, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الموجود) -> {
            إذا (ينتهي_بـ(&الموجود, الاسم)) { أرجع اختياري.موجود(ف); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// يكتب النص المرقَّع ملفا باسم الاسم ويُكمل في تحليله.
عرف أكمل(الدليل: &نص, الاسم: نص, الرقعة: &رقعة_إكمال): اختياري نتيجة_إكمال_أدوات {
    ليكن الملف: نص = صل_المسار(الدليل, &الاسم);
    طابق اكتب_الملف(&الملف, &(*الرقعة).النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(_) -> { };
    طابق ابن(الملف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الواجهة) -> {
        طابق المصدر_المسمى(&الواجهة, &الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المصدر) -> {
            أرجع اختياري.موجود(إكمال_عند_رقعة_واجهة(&الواجهة, المصدر, الرقعة));
        };
    };
}

عرف موضع_الاسم(الناتج: &نتيجة_إكمال_أدوات, الاسم: نص): طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الناتج).المرشحات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الناتج).المرشحات[ف].الاسم, &الاسم)) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع 1000000;
}

عرف بعد_الاسم(الناتج: &نتيجة_إكمال_أدوات, الاسم: نص): طبيعي {
    ليكن الموضع: طبيعي = موضع_الاسم(الناتج, الاسم);
    إذا (الموضع >= (الطول((*الناتج).المرشحات) مثل طبيعي)) { أرجع 1000000; };
    أرجع (*الناتج).المرشحات[الموضع].البعد;
}

عرف ألحق_نصا(البايتات: &متغير متجه ط8, النص: &نص): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*البايتات, (*النص)[ف]); ف := ف + 1; }
}

// برنامج الحالات C1 إلى C9، والسطر آخر عبارة لم تكتمل في main.
عرف البرنامج(السطر: نص): نص {
    ليكن المقدمة: نص = «type Inner = { depth: int, label: string };
type Outer = { inner: Inner, count: int };
type Color = | Red | Green;
def make(): Outer {
    let i: Inner = { depth: 1, label: "a" };
    return { inner: i, count: 2 };
}
def area(width: int, height: int): int { return width * height; }
def main(): int {
    let outer_value: Outer = make();
    let r: &Outer = &outer_value;
    let arr: vector Outer = [make()];
    let c: Color = Color.Red();
    let top: int = 2;
    »;
    ليكن الخاتمة: نص = «
}
»;
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_نصا(&متغير البايتات, &المقدمة);
    ألحق_نصا(&متغير البايتات, &السطر);
    ألحق_نصا(&متغير البايتات, &الخاتمة);
    أرجع من_بايتات(&البايتات);
}

// المرشح الاسم منشئ له عدد الحمولات هذا ويُدرج النص هذا، في موضع نمط أو لا.
عرف يدرج(الناتج: &نتيجة_إكمال_أدوات, الاسم: نص, الحمولات: طبيعي, النص: نص, في_نمط: منطقي): منطقي {
    ليكن الموضع: طبيعي = موضع_الاسم(الناتج, الاسم);
    إذا (الموضع >= (الطول((*الناتج).المرشحات) مثل طبيعي)) { أرجع خطأ; };
    طابق (*الناتج).المرشحات[الموضع].عدد_الحمولات مع
    | اختياري.موجود(العدد) -> { إذا (العدد != الحمولات) { أرجع خطأ; }; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    إذا (!نصان_متساويان(&(*الناتج).المرشحات[الموضع].نص_الإدراج, &النص)) { أرجع خطأ; };
    إذا (في_نمط) { أرجع (*الناتج).المرشحات[الموضع].في_نمط; };
    أرجع !(*الناتج).المرشحات[الموضع].في_نمط;
}

// مرشحان بالضبط: الأول ثم الثاني.
عرف اثنان(الناتج: &نتيجة_إكمال_أدوات, الأول: نص, الثاني: نص): منطقي {
    أرجع (الطول((*الناتج).المرشحات) مثل طبيعي) == 2
        && موضع_الاسم(الناتج, الأول) == 0 && موضع_الاسم(الناتج, الثاني) == 1;
}

عرف الرئيسية(): عدد {
    ليكن البادئة: نص = «completion»;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الدليل) -> {
        // ح1: قيمة سجل، والسطر لم يكتمل.
        ليكن ح1: نص = «type Point = { x: int, y: int };
def main(): int {
    let p: Point = { x: 1, y: 2 };
    return p.
}
»;
        ليكن ر1: رقعة_إكمال = رقع_مصدر_للإكمال(&ح1, المؤشر_بعد(&ح1, «return p.»));
        إذا (ر1.السياق != سياق_إكمال.عضو_قيمة()) { أرجع 2; };
        طابق أكمل(&الدليل, «t1.sn», &ر1) مع
        | اختياري.لا_شيء -> { أرجع 3; }
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.السياق != سياق_إكمال.عضو_قيمة()) { أرجع 4; };
            إذا ((الطول(الناتج.المرشحات) مثل طبيعي) != 2) { أرجع 5; };
            إذا (موضع_الاسم(&الناتج, «x») != 0 || موضع_الاسم(&الناتج, «y») != 1) { أرجع 6; };
        };
        // ح2: الحالة نفسها في مصدر عربي.
        ليكن ح2: نص = «نوع نقطة = { س: عدد, ص: عدد };
عرف الرئيسية(): عدد {
    ليكن ن: نقطة = { س: 1, ص: 2 };
    أرجع ن.
}
»;
        ليكن ر2: رقعة_إكمال = رقع_مصدر_للإكمال(&ح2, المؤشر_بعد(&ح2, «أرجع ن.»));
        طابق أكمل(&الدليل, «t2.sn», &ر2) مع
        | اختياري.لا_شيء -> { أرجع 7; }
        | اختياري.موجود(الناتج) -> {
            إذا ((الطول(الناتج.المرشحات) مثل طبيعي) != 2) { أرجع 8; };
            إذا (موضع_الاسم(&الناتج, «س») != 0 || موضع_الاسم(&الناتج, «ص») != 1) { أرجع 9; };
        };
        // ح3: مسار استيراد عبر تهجئات المكتبة العربية.
        ليكن ح3: نص = «استورد المكتبة.دخ.
»;
        ليكن ر3: رقعة_إكمال = رقع_مصدر_للإكمال(&ح3, المؤشر_بعد(&ح3, «دخ.»));
        إذا (ر3.السياق != سياق_إكمال.مسار_استيراد()) { أرجع 10; };
        ليكن اسم_ح3: نص = «t3.sn»;
        ليكن ملف_ح3: نص = صل_المسار(&الدليل, &اسم_ح3);
        طابق اكتب_الملف(&ملف_ح3, &ر3.النص) مع
        | نتيجة.خطأ(_) -> { أرجع 11; }
        | نتيجة.نجح(_) -> { };
        ليكن الإضافية: متجه نص = [];
        طابق ابن_إعداد_تجميع_مباشر(&ملف_ح3, &الإضافية) مع
        | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع 12; }
        | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: _, المفاتيح_المباشرة: _ }) -> {
            ليكن الناتج: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&البيئة, &ر3);
            إذا (موضع_الاسم(&الناتج, «println») >= 1000000) { أرجع 13; };
            إذا (موضع_الاسم(&الناتج, «print») >= 1000000) { أرجع 14; };
            إذا (موضع_الاسم(&الناتج, «read_line») >= 1000000) { أرجع 15; };
            إذا (موضع_الاسم(&الناتج, «buffered_writer») >= 1000000) { أرجع 16; };
            إذا (بعد_الاسم(&الناتج, «println») != 4) { أرجع 17; };
            // `import std.`: لكل تهجئة لغتها ووحدتها.
            ليكن ح3ب: نص = «import std.
»;
            ليكن ر3ب: رقعة_إكمال = رقع_مصدر_للإكمال(&ح3ب, المؤشر_بعد(&ح3ب, «std.»));
            ليكن الجذور: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&البيئة, &ر3ب);
            ليكن الموضع: طبيعي = موضع_الاسم(&الجذور, «دخ»);
            إذا (الموضع >= 1000000 || موضع_الاسم(&الجذور, «io») >= 1000000) { أرجع 28; };
            طابق الجذور.المرشحات[الموضع].الأصلي مع
            | اختياري.موجود(الأصلي) -> { إذا (!نصان_متساويان(&الأصلي, &«io»)) { أرجع 29; }; }
            | اختياري.لا_شيء -> { أرجع 29; };
            طابق الجذور.المرشحات[الموضع].اللغة مع
            | اختياري.موجود(اللغة) -> { إذا (!نصان_متساويان(&اللغة, &«ar»)) { أرجع 30; }; }
            | اختياري.لا_شيء -> { أرجع 30; };
            // `import std.text.`: وحدة يعيد النص تصديرها من الأساس
            // (`module compare = core.text.compare { ar: مقارنة };`).
            ليكن ح3ج: نص = «import std.text.
»;
            ليكن ر3ج: رقعة_إكمال = رقع_مصدر_للإكمال(&ح3ج, المؤشر_بعد(&ح3ج, «text.»));
            ليكن أبناء_النص: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&البيئة, &ر3ج);
            إذا (موضع_الاسم(&أبناء_النص, «compare») >= 1000000) { أرجع 31; };
            إذا (موضع_الاسم(&أبناء_النص, «مقارنة») >= 1000000) { أرجع 32; };
            // `import std.json.`: أبناء مجلد يعيد std تصديره من alloc
            // (`module json = alloc.json`).
            ليكن ح3د: نص = «import std.json.
»;
            ليكن ر3د: رقعة_إكمال = رقع_مصدر_للإكمال(&ح3د, المؤشر_بعد(&ح3د, «json.»));
            ليكن أبناء_جسون: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&البيئة, &ر3د);
            إذا (موضع_الاسم(&أبناء_جسون, «parse») >= 1000000) { أرجع 33; };
        };
        // ح4: الأسماء المرئية، والسطر لم يكتمل.
        ليكن ح4: نص = «def helper(a: int): int { return a; }
def main(): int {
    let total: int = 1;
    return he
}
»;
        ليكن ر4: رقعة_إكمال = رقع_مصدر_للإكمال(&ح4, المؤشر_بعد(&ح4, «return he»));
        إذا (ر4.السياق != سياق_إكمال.اسم()) { أرجع 18; };
        طابق أكمل(&الدليل, «t4.sn», &ر4) مع
        | اختياري.لا_شيء -> { أرجع 19; }
        | اختياري.موجود(الناتج) -> {
            إذا (بعد_الاسم(&الناتج, «total») != 0) { أرجع 20; };
            إذا (بعد_الاسم(&الناتج, «helper») != 2) { أرجع 21; };
            إذا (بعد_الاسم(&الناتج, «main») != 2) { أرجع 22; };
            // معامل helper غير مرئي في main.
            إذا (موضع_الاسم(&الناتج, «a») < 1000000) { أرجع 23; };
        };
        // ح5: منشئات تعداد.
        ليكن ح5: نص = «type Color = | Red | Green;
def main(): int { let c: Color = Color.»;
        ليكن ر5: رقعة_إكمال = رقع_مصدر_للإكمال(&ح5, الطول(ح5) مثل طبيعي);
        طابق أكمل(&الدليل, «t5.sn», &ر5) مع
        | اختياري.لا_شيء -> { أرجع 24; }
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.السياق != سياق_إكمال.عضو_نوع()) { أرجع 25; };
            إذا (موضع_الاسم(&الناتج, «Red») != 0 || موضع_الاسم(&الناتج, «Green») != 1) { أرجع 26; };
        };
        // ح6: لا إكمال داخل نص.
        ليكن ح6: نص = «def main(): int { let s: string = "p.»;
        ليكن ر6: رقعة_إكمال = رقع_مصدر_للإكمال(&ح6, الطول(ح6) مثل طبيعي);
        إذا (ر6.السياق != سياق_إكمال.لا_شيء()) { أرجع 27; };
        // C1: حقول ناتج استدعاء، مع أنواعها.
        ليكن ج1: نص = البرنامج(«return make().»);
        ليكن ق1: رقعة_إكمال = رقع_مصدر_للإكمال(&ج1, المؤشر_بعد(&ج1, «return make().»));
        إذا (ق1.السياق != سياق_إكمال.عضو_قيمة() || !نصان_متساويان(&ق1.التعبير, &«make()»)) { أرجع 50; };
        طابق أكمل(&الدليل, «c1.sn», &ق1) مع
        | اختياري.لا_شيء -> { أرجع 51; }
        | اختياري.موجود(الناتج) -> {
            إذا (الناتج.السياق != سياق_إكمال.عضو_قيمة()) { أرجع 52; };
            إذا (!اثنان(&الناتج, «inner», «count»)) { أرجع 53; };
            طابق الناتج.المرشحات[0].النوع مع
            | اختياري.لا_شيء -> { أرجع 54; }
            | اختياري.موجود(_) -> { };
        };
        // C2: حقل من ناتج استدعاء.
        ليكن ج2: نص = البرنامج(«return make().inner.»);
