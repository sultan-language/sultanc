// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/tooling/cancel_from_thread.sn
// (بلا تشغيل في المفسر: المفسر يشغل خيط نظام واحدا ويتوقف عند الإطلاق).
// خيط ثان يلغي تحليل الواجهة الأمامية الجاري للمترجم كله عبر رمز مشترك: يتوقف
// التحليل عند نقطة الفحص التالية ويبلغ ملغاة، لا تشخيصا.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد std.thread.thread;
استورد std.sync.arc;

عرف ألغ_لاحقا(الرمز: &مشترك<حالة_إلغاء_واجهة>): فراغ {
    نم(0, 200000000);
    اطلب_إلغاء_واجهة(اقرأ_مشترك(الرمز));
}

عرف الرئيسية(): عدد {
    دع المسار: نص = «compiler/main.sn»;
    دع الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&المسار, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع 1; }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: صواب };
        دع الرمز: مشترك<حالة_إلغاء_واجهة> = أنشئ_مشترك(حالة_إلغاء_واجهة_جديدة());
        دع القارئ: مشترك<حالة_إلغاء_واجهة> = استنسخ_مشترك(&الرمز);
        طابق أطلق(دالة(): فراغ -> ألغ_لاحقا(&القارئ)) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المقبض) -> {
            دع المنضم: متغير مقبض_خيط = المقبض;
            طابق ابن_واجهة_وحدة_قابلة_للإلغاء(الطلب, اقرأ_مشترك(&الرمز)) مع
            | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> {
                انضم(&متغير المنضم);
                إذا (!هل_واجهة_ملغاة(اقرأ_مشترك(&الرمز))) { أرجع 4; }
                أرجع 42;
            }
            | _ -> { انضم(&متغير المنضم); أرجع 3; };
        };
    };
}
