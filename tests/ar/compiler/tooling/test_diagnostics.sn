// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/test_diagnostics.sn
// يبلّغ طلب الأدوات (احتفظ_بحقائق_الأدوات) عن الاختبارات التي يرفضها
// `sultanc test` بالقواعد نفسها (compiler/test_mode/validation.sn)، في
// تشخيصات_الأدوات عند اسم كل اختبار: المعاملات (السطر 4)، وناتج ليس لا شيء ولا
// `نتيجة عدد, فشل` (السطر 7)، ونوع موسوم بـ`@@اختبار` (السطر 10). ولا شيء
// للاختبارين الصالحين (السطران 13 و16). وترجمة الملف نفسه لا تبلّغ شيئا: يزيل
// البناء العادي الوسم.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.diagnostics.identity;
استورد compiler.diagnostics.record;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

نوع مبلغ = { المعرف: معرف_تشخيص, السطر: عدد };

// هوية كل تشخيص والسطر الذي يبدأ عنده نطاقه (0 بلا نطاق).
عرف المبلغات(التشخيصات: &متجه تشخيص): متجه مبلغ {
    دع الكل: متغير متجه مبلغ = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التشخيصات) مثل طبيعي)) {
        دع السطر: متغير عدد = 0;
        طابق (*التشخيصات)[ف].المصدر_الرئيسي مع
        | اختياري.موجود(الموضع) -> {
            طابق الموضع.بداية_العرض مع
            | اختياري.موجود(البداية) -> { السطر := البداية.السطر مثل عدد; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        دع الواحد: مبلغ = { المعرف: (*التشخيصات)[ف].المعرف, السطر: السطر };
        ألحق(الكل, الواحد);
        ف := ف + 1;
    }
    أرجع الكل;
}

// عدد التشخيصات بهذه الهوية التي يبدأ نطاقها عند السطر.
عرف عدد_عند(التشخيصات: &متجه مبلغ, الهوية: معرف_تشخيص, السطر: عدد): عدد {
    دع الموجود: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التشخيصات) مثل طبيعي)) {
        إذا ((*التشخيصات)[ف].المعرف == الهوية && (*التشخيصات)[ف].السطر == السطر) { الموجود := الموجود + 1; }
        ف := ف + 1;
    }
    أرجع الموجود;
}

عرف عدد_الاختبارات(التشخيصات: &متجه مبلغ): عدد {
    دع الموجود: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*التشخيصات) مثل طبيعي)) {
        دع الهوية: معرف_تشخيص = (*التشخيصات)[ف].المعرف;
        إذا (الهوية == معرف_تشخيص.اختبار_بمعاملات() || الهوية == معرف_تشخيص.ناتج_اختبار_غير_صالح()
            || الهوية == معرف_تشخيص.اختبار_ليس_دالة_عادية()) {
            الموجود := الموجود + 1;
        }
        ف := ف + 1;
    }
    أرجع الموجود;
}

عرف حلل(للأدوات: منطقي): اختياري متجه مبلغ {
    دع الجذر: نص = «tests/ar/compiler/tooling/test_diagnostics/root.sn»;
    دع الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: للأدوات };
        دع المزيد: متجه مفتاح_وحدة_مقنن = [];
        دع الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        طابق ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &متغير الإلغاء) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
            أرجع اختياري.موجود(المبلغات(&الواجهة.تشخيصات_الأدوات.التشخيصات));
        }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف الرئيسية(): عدد {
    طابق حلل(صواب) مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(التشخيصات) -> {
        إذا (عدد_عند(&التشخيصات, معرف_تشخيص.اختبار_بمعاملات(), 4) != 1) { أرجع 2; }
        إذا (عدد_عند(&التشخيصات, معرف_تشخيص.ناتج_اختبار_غير_صالح(), 7) != 1) { أرجع 3; }
        إذا (عدد_عند(&التشخيصات, معرف_تشخيص.اختبار_ليس_دالة_عادية(), 10) != 1) { أرجع 4; }
        إذا (عدد_الاختبارات(&التشخيصات) != 3) { أرجع 5; }
    };
    طابق حلل(خطأ) مع
    | اختياري.لا_شيء -> { أرجع 6; }
    | اختياري.موجود(التشخيصات) -> {
        إذا (عدد_الاختبارات(&التشخيصات) != 0) { أرجع 7; }
    };
    أرجع 42;
}
