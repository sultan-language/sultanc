// مُثبّت tests/ar/compiler/tooling/refactoring_queries.sn (ليس اختبارا).
عرف اضرب(القيمة: عدد, المعامل: عدد): عدد {
    أرجع القيمة * المعامل;
}
مرادف scale = اضرب;

عرف زد(الخانة: &متغير عدد): عدد {
    *الخانة := *الخانة + 1;
    أرجع *الخانة;
}

عرف اقرأ(الخانة: &عدد): عدد {
    أرجع *الخانة;
}

عرف استهلك(العناصر: متجه عدد): عدد {
    أرجع الطول(العناصر) مثل عدد;
}

إذا (الهدف.المنصة == «plan9») {
    عرف درجة_المنصة(): عدد { أرجع 1; }
} وإلا {
    عرف درجة_المنصة(): عدد { أرجع 2; }
}

عرف الرئيسية(): عدد {
    دع المجموع: متغير عدد = 0;
    دع العامل: عدد = 3;
    المجموع := اضرب(2, العامل);
    دع المضاعف: عدد = scale(المجموع, 2);
    دع المزاد: عدد = زد(&متغير المجموع);
    دع العناصر: متجه عدد = [1, 2, 3];
    دع الكمية: عدد = استهلك(العناصر);
    دع اللقطة: عدد = اقرأ(&المجموع);
    إذا (المجموع > 0) {
        دع الخطوة: عدد = 1;
        المجموع := المجموع + العامل * الخطوة;
        دع الإضافة: عدد = الخطوة + 1;
        المجموع := المجموع + الإضافة;
    }
    دع المؤقت: عدد = 1;
    دع الحاصل: عدد = اضرب(المؤقت, 1);
    أرجع المضاعف + المزاد + الكمية + اللقطة + الحاصل + المجموع + درجة_المنصة();
}
