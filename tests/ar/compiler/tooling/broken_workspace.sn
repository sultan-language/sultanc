// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/broken_workspace.sn
// مساحة عمل فيها مصدران مكسوران، تُحلل كما تحللها خدمة اللغة (a.sn الجذر والمصادر
// الأخرى تنضم إليه): broken_import.sn يسمي وحدة غير موجودة، وbroken_tokens.sn لا يُقرأ
// رموزا. طلب الأدوات يسجل كل إخفاق تشخيصات لمصدره ويحلل الباقي: توجد استعمالات
// `القيمة_المشتركة` في b.sn وفي broken_import.sn، ويبين كل مصدر مدى اكتماله،
// وتُبلغ عبارة الاستيراد الفاشلة. أما الترجمة فما زالت تُرفض.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.tooling_facts;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.frontend.names.reference_queries;
استورد compiler.frontend.names.import_queries;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.engine;
استورد compiler.source.span;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.compare;
استورد std.text.transform;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف مسار(الاسم: نص): نص {
    دع الأجزاء: متجه نص = [«tests/ar/compiler/tooling/broken_workspace/», الاسم];
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف حلل(للأدوات: منطقي): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    دع الجذر: نص = مسار(«a.sn»);
    دع الإضافية: متجه نص = [مسار(«b.sn»), مسار(«broken_import.sn»), مسار(«broken_tokens.sn»)];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: المفاتيح }) -> {
        دع المزيد: متغير متجه مفتاح_وحدة_مقنن = [];
        دع ف: متغير طبيعي = 1;
        طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
            ألحق(المزيد, انسخ_مفتاح_وحدة_مقنن(&المفاتيح[ف]));
            ف := ف + 1;
        }
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: للأدوات };
        دع الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &الإلغاء);
    };
}

عرف مصدر_باسم(الواجهة: &نتيجة_واجهة_وحدة, الاسم: نص): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        دع المعرف: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
        | اختياري.موجود(المكتوب) -> { إذا (ينتهي_بـ(&المكتوب, &الاسم)) { أرجع المعرف; } }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع 1000000;
}

عرف محتوى(الواجهة: &نتيجة_واجهة_وحدة, المصدر: طبيعي): نص {
    طابق مصدر_واجهة_بمعرف(الواجهة, المصدر) مع
    | اختياري.موجود(الموجود) -> { أرجع استنسخ(&الموجود.المحتوى); }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف نص_المدى(النص: &نص, المدى: نطاق): نص {
    دع البداية: طبيعي = المدى.البداية.البايت مثل طبيعي;
    دع النهاية: طبيعي = المدى.النهاية.البايت مثل طبيعي;
    إذا (النهاية < البداية) { أرجع «»; }
    طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
    | اختياري.موجود(الجزء) -> { أرجع الجزء; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف استعمالات_في(المراجع: &متجه مرجع_رمز_دلالي, المصدر: طبيعي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المراجع) مثل طبيعي)) {
        إذا (((*المراجع)[ف].النطاق.البداية.المصدر مثل طبيعي) == المصدر && (*المراجع)[ف].الدور != دور_مرجع.تصريح()) {
            العدد := العدد + 1;
        }
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف الرئيسية(): عدد {
    طابق حلل(صواب) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
        دع أ: طبيعي = مصدر_باسم(&الواجهة, «broken_workspace/a.sn»);
        دع ب: طبيعي = مصدر_باسم(&الواجهة, «broken_workspace/b.sn»);
        دع الاستيراد: طبيعي = مصدر_باسم(&الواجهة, «broken_workspace/broken_import.sn»);
        دع الرموز: طبيعي = مصدر_باسم(&الواجهة, «broken_workspace/broken_tokens.sn»);
        إذا (أ == 1000000 || ب == 1000000 || الاستيراد == 1000000 || الرموز == 1000000) { أرجع 1; }
        دع نص_أ: نص = محتوى(&الواجهة, أ);
        دع المطلوب: نص = «القيمة_المشتركة»;
        دع الموضع: متغير طبيعي = 0;
        طابق ابحث_نصا(&نص_أ, &المطلوب) مع
        | اختياري.موجود(القيمة) -> { الموضع := القيمة; }
        | اختياري.لا_شيء -> { أرجع 2; };
        طابق رمز_واجهة_عند_بايت(&الواجهة, أ, الموضع) مع
        | اختياري.لا_شيء -> { أرجع 3; }
        | اختياري.موجود(الرمز) -> {
            دع المراجع: متجه مرجع_رمز_دلالي = مراجع_رمز_واجهة(&الواجهة, الرمز);
            إذا (استعمالات_في(&المراجع, ب) != 1) { أرجع 4; }
            إذا (استعمالات_في(&المراجع, الاستيراد) != 1) { أرجع 5; }
            إذا (استعمالات_في(&المراجع, الرموز) != 0) { أرجع 6; }
            // المصادر السليمة ما زالت تُكتب أنواعها.
            طابق نوع_رمز_واجهة(&الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع 18; }
            | اختياري.موجود(_) -> { };
        };
        دع اكتمال_أ: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, أ);
        دع اكتمال_ب: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, ب);
        دع اكتمال_الاستيراد: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, الاستيراد);
        دع اكتمال_الرموز: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, الرموز);
        إذا (!اكتمال_أ.التحميل || !اكتمال_أ.الأسماء || !اكتمال_أ.الأنواع) { أرجع 7; }
        إذا (!اكتمال_ب.التحميل || !اكتمال_ب.الأسماء || !اكتمال_ب.الأنواع) { أرجع 8; }
        إذا (اكتمال_الاستيراد.التحميل || !اكتمال_الاستيراد.الأسماء || !اكتمال_الاستيراد.الأنواع) { أرجع 9; }
        إذا (اكتمال_الرموز.التحميل || اكتمال_الرموز.الأسماء) { أرجع 10; }
        دع الفاشلة: &متجه نطاق = &الواجهة.حقائق_الأدوات.الاستيرادات_الفاشلة;
        إذا ((الطول(*الفاشلة) مثل طبيعي) != 1) { أرجع 11; }
        دع نص_الاستيراد: نص = محتوى(&الواجهة, الاستيراد);
        دع المكتوب: نص = نص_المدى(&نص_الاستيراد, (*الفاشلة)[0]);
        دع المتوقع: نص = «استورد لا_مكان.وحدة_مفقودة;»;
        إذا (!نصان_متساويان(&المكتوب, &المتوقع)) { أرجع 12; }
        دع العلاقات: متجه علاقة_استيراد_وحدة = علاقات_استيراد_واجهة(&الواجهة, الاستيراد, صواب);
        إذا ((الطول(العلاقات) مثل طبيعي) != 1 || العلاقات[0].مصدر_المستورد_منه != أ) { أرجع 13; }
        إذا (الواجهة.تشخيصات_الأدوات.عدد_الأخطاء < 2) { أرجع 14; }
        إذا (الواجهة.كاملة_دلاليا) { أرجع 15; }
    }
    | _ -> { أرجع 16; };
    // الترجمة ما زالت تتوقف عند أول خطأ.
    طابق حلل(خطأ) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(_) -> { }
    | _ -> { أرجع 17; };
    أرجع 42;
}
