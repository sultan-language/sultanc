// مُثبّت tests/ar/compiler/tooling/let_tuple_queries.sn (ليس اختبارا).
عرف اقسم(أ: عدد، ب: عدد): (عدد، عدد) {
    أرجع (أ / ب، أ % ب);
}

عرف الرئيسية(): عدد {
    ليكن القيم: متغير متجه عدد = [1، 2، 3، 4];
    ليكن (الناتج، الباقي): (عدد، عدد) = اقسم(17، 5);
    ليكن (اليسار، اليمين): (متغير [] عدد، [] عدد) = اقسم_قابلا_للتعديل(&متغير القيم، 2);
    اليسار[0] := اليمين[1] + الناتج;
    أرجع اليسار[1] + الباقي;
}
