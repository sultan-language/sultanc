// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/incremental_session.sn
// جلسة التحليل التزايدي تعطي ناتج التحليل الكامل. تُعدَّل مساحة العمل (root.sn
// يستورد lib.sn وuser.sn وother.sn وwidth.sn والمكتبة القياسية) بنصوص محرر
// غير محفوظة، وبعد كل تعديل يُقارن ناتج الجلسة بتحليل كامل للنصوص نفسها: كل
// ظهور محلول (تصريحه ونوعه)، وكل تشخيص، واكتمال كل مصدر (صف_واجهة_للمقارنة).
// الطلبات: طلب بلا تعديل (الحالة النهائية التي حفظها التحليل الكامل كما هي)،
// وتعديل جسم (مرتين: كل منهما لا يفحص إلا أجسام lib.sn من جديد، في تلك الحالة
// النهائية: قطع مبكر)، وتعديل توقيع يكسر المستدعين (وتُبنى الحالات المحفوظة)،
// وإصلاحه، واستيراد قياسي جديد، وخطأ جديد، وإصلاحه، وتعديلات تصريحات مستند
// مفتوح (تعيد استعمال حالة المساحة المحفوظة)، وتعديل جسم فيه يبدأ من الحالة
// النهائية المنسوخة مسبقا، وطلب ملغى، وتبديل الهدف (width.sn يصرح بحسب الهدف).
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.incremental_analysis;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.مقطع;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.من_بايتات;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

// هدف مسجل عرض مؤشراته غير عرض مؤشرات المضيف.
عرف هدف_آخر(): اختياري واصف_هدف {
    ليكن العرض: متغير طبيعي = 64;
    طابق المضيف() مع
    | اختياري.موجود(الهدف) -> { العرض := الهدف.نموذج_البيانات.عرض_المؤشر; }
    | اختياري.لا_شيء -> { };
    ليكن الكل: متجه واصف_هدف = الأهداف_المسجلة();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكل) مثل طبيعي)) {
        إذا (الكل[ف].نموذج_البيانات.عرض_المؤشر != العرض) { أرجع اختياري.موجود(استنسخ(&الكل[ف])); }
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مسار(الاسم: نص): نص {
    ليكن الأجزاء: متجه نص = [«tests/ar/compiler/tooling/incremental_session/», الاسم];
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف طلب(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): طلب_واجهة_وحدة {
    ليكن الناتج: طلب_واجهة_وحدة = { البيئة: استنسخ(البيئة), المفتاح_الجذري: استنسخ(المفتاح), احتفظ_بحقائق_الأدوات: صواب };
    أرجع الناتج;
}

عرف صف(الناتج: &نتيجة_بناء_واجهة_قابلة_للإلغاء): متجه نص {
    طابق *الناتج مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع صف_واجهة_للمقارنة(&الواجهة); }
    | _ -> { ليكن لا_شيء_منها: متجه نص = []; أرجع لا_شيء_منها; };
}

عرف متماثلان(أ: &متجه نص, ب: &متجه نص): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) == 0 || (الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; }
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا (!نصان_متساويان(&(*أ)[ف], &(*ب)[ف])) { أرجع خطأ; }
        ف := ف + 1;
    }
    أرجع صواب;
}

// هل في سطر من الأسطر النص المعطى.
عرف يذكر(الأسطر: &متجه نص, النص: نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        طابق ابحث_نصا(&(*الأسطر)[ف], &النص) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// المسار الذي حُمل منه مصدر، كما يسميه سطر اكتماله («C <المسار> load=...»):
// نص المحرر يحل محل الملف في ذلك المسار.
عرف المسار_المحمل(الأسطر: &متجه نص, الاسم: نص): نص {
    ليكن الذيل: نص = صل_النصوص(&[«/», انسخ_نص(&الاسم), « load=»], &«»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        ليكن السطر: &نص = &(*الأسطر)[ف];
        ليكن الرأس: نص = «C »;
        إذا (يبدأ_بـ(السطر, &الرأس)) {
            طابق ابحث_نصا(السطر, &الذيل) مع
            | اختياري.موجود(الموضع) -> {
                طابق مقطع_نص(السطر, 2, الموضع + 1 + (الطول(الاسم) مثل طبيعي) - 2) مع
                | اختياري.موجود(المسار) -> { أرجع المسار; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        ف := ف + 1;
    }
    أرجع «»;
}

// ناتج الجلسة للنصوص الحالية، مقارنا بتحليل كامل.
عرف خطوة(
    الجلسة: &متغير جلسة_تحليل_تزايدي, البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن,
    الهدف: اختياري واصف_هدف
): متجه نص {
    ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
    ليكن الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    ليكن التزايدي: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_في_جلسة(الجلسة, طلب(البيئة, المفتاح), استنسخ(&الهدف), &المزيد, &الإلغاء);
    ليكن الكامل: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(طلب(البيئة, المفتاح), الهدف, &المزيد, &الإلغاء);
    ليكن أ: متجه نص = صف(&التزايدي);
    ليكن ب: متجه نص = صف(&الكامل);
    إذا (!متماثلان(&أ, &ب)) { ليكن لا_شيء_منها: متجه نص = []; أرجع لا_شيء_منها; }
    أرجع أ;
}

عرف الرئيسية(): عدد {
    ليكن الجذر: نص = مسار(«root.sn»);
    // مفتاح other.sn، للمستندات المفتوحة في المحرر.
    ليكن الإضافية: متجه نص = [مسار(«other.sn»)];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع 1; }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة_الأولى, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: المفاتيح }) -> {
        ليكن مفتاح_الأخرى: مفتاح_وحدة_مقنن = استنسخ(&المفاتيح[(الطول(المفاتيح) مثل طبيعي) - 1]);
        ليكن البيئة: متغير بيئة_وحدات_منطقية = البيئة_الأولى;
        ليكن الجلسة: متغير جلسة_تحليل_تزايدي = جلسة_تحليل_تزايدي_جديدة();
        // تحليل كامل أول مرة، ثم تُبنى الحالات المحفوظة.
        ليكن الأولى: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف());
        إذا ((الطول(الأولى) مثل طبيعي) == 0) { أرجع 2; }
        ليكن المكتبة: نص = المسار_المحمل(&الأولى, «lib.sn»);
        ليكن المستعمل: نص = المسار_المحمل(&الأولى, «user.sn»);
        ليكن الأخرى: نص = المسار_المحمل(&الأولى, «other.sn»);
        إذا ((الطول(المكتبة) مثل طبيعي) == 0 || (الطول(المستعمل) مثل طبيعي) == 0 || (الطول(الأخرى) مثل طبيعي) == 0) { أرجع 22; }
        إذا (!إحصاء_جلسة_تحليل(&الجلسة).كاملة) { أرجع 3; }
        // بلا تعديل: الحالة النهائية المحفوظة كما هي.
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 4; }
        إذا (!إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر || إحصاء_جلسة_تحليل(&الجلسة).المحللة != 0) { أرجع 5; }
        // تعديل جسم، مرتين.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة),
            "عام عرف ضاعف(س: عدد): عدد { أرجع س * 3; }\nعام عرف لم_تمس(): عدد { أرجع 1; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 6; }
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة),
            "عام عرف ضاعف(س: عدد): عدد { أرجع س * 4; }\nعام عرف لم_تمس(): عدد { أرجع 1; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 7; }
        // لا يتغير تصريح: lib.sn وحده، في الحالة النهائية المحفوظة.
        إذا (إحصاء_جلسة_تحليل(&الجلسة).اللقطة != 3 || إحصاء_جلسة_تحليل(&الجلسة).المحللة != 1
            || !إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر) { أرجع 8; }
        // تعديل توقيع: لم تعد أنواع المستدعين تُكتب.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة),
            "عام عرف ضاعف(س: عدد, ص: عدد): عدد { أرجع س * ص; }\nعام عرف لم_تمس(): عدد { أرجع 1; }\n");
        ليكن المكسور: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف());
        إذا ((الطول(المكسور) مثل طبيعي) == 0) { أرجع 9; }
        إذا (!يذكر(&المكسور, «user.sn»)) { أرجع 10; }
        إذا (!إحصاء_جلسة_تحليل(&الجلسة).بنيت_لقطة_الأساس || إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر) { أرجع 29; }
        // الإصلاح.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة),
            "عام عرف ضاعف(س: عدد): عدد { أرجع س * 2; }\nعام عرف لم_تمس(): عدد { أرجع 1; }\n");
        ليكن المصلح: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف());
        إذا ((الطول(المصلح) مثل طبيعي) == 0) { أرجع 11; }
        إذا (يذكر(&المصلح, «D »)) { أرجع 12; }
        // تغيير استيراد: وحدة قياسية لا تحويها الحالات المحفوظة.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل),
            "استورد \"lib.sn\";\nاستورد std.text.search;\nعام عرف استعمل_المضاعفة(): عدد { أرجع ضاعف(3) + لم_تمس(); }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 13; }
        إذا (إحصاء_جلسة_تحليل(&الجلسة).المتغيرة != 1) { أرجع 23; }
        // خطأ جديد، ثم إصلاحه.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&الأخرى),
            "عام عرف القيمة_الأخرى(): عدد { أرجع غير_مصرح_به_قطعا; }\n");
        ليكن المجهول: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف());
        إذا ((الطول(المجهول) مثل طبيعي) == 0) { أرجع 14; }
        إذا (!يذكر(&المجهول, «other.sn»)) { أرجع 15; }
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&الأخرى),
            "عام عرف القيمة_الأخرى(): عدد { أرجع 4; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 16; }
        // يُفتح other.sn في المحرر: تتركه حالة المساحة المحفوظة، فلا تحلل
        // تعديلات تصريحاته إلا هو وroot.sn.
        ليكن المفتوحة: متجه مفتاح_وحدة_مقنن = [مفتاح_الأخرى];
        عيّن_مستندات_مفتوحة_جلسة(&متغير الجلسة, المفتوحة);
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&الأخرى),
            "عام عرف القيمة_الأخرى(): عدد { أرجع 5; }\nعام عرف احتياط_أول(): عدد { أرجع 1; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 24; }
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&الأخرى),
            "عام عرف القيمة_الأخرى(): عدد { أرجع 6; }\nعام عرف احتياط_ثان(): عدد { أرجع 1; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 25; }
        إذا (إحصاء_جلسة_تحليل(&الجلسة).اللقطة != 2 || إحصاء_جلسة_تحليل(&الجلسة).المحللة != 2) { أرجع 26; }
        // تُنسخ الحالة النهائية المحفوظة مسبقا (وقت انتظار المحرر)؛ ويبدأ
        // التعديل التالي، لأجسام other.sn، من تلك النسخة.
        جهز_جلسة_تحليل(&متغير الجلسة);
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&الأخرى),
            "عام عرف القيمة_الأخرى(): عدد { أرجع 7; }\nعام عرف احتياط_ثان(): عدد { أرجع 1; }\n");
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 27; }
        إذا (!إحصاء_جلسة_تحليل(&الجلسة).جاهزة || إحصاء_جلسة_تحليل(&الجلسة).المحللة != 1
            || !إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر) { أرجع 28; }
        // الطلب الملغى يترك الحالات المحفوظة؛ ويعيد الطلب التالي استعمالها.
        ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
        ليكن الملغى: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        اطلب_إلغاء_واجهة(&الملغى);
        طابق ابن_واجهة_في_جلسة(&متغير الجلسة, طلب(&البيئة, &المفتاح), المضيف(), &المزيد, &الملغى) مع
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { }
        | _ -> { أرجع 17; };
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, المضيف())) مثل طبيعي) == 0) { أرجع 18; }
        إذا (إحصاء_جلسة_تحليل(&الجلسة).اللقطة == 0) { أرجع 19; }
        // تبديل الهدف: يُحلل كل شيء من جديد لذلك الهدف.
        طابق هدف_آخر() مع
        | اختياري.موجود(الهدف) -> {
            إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, اختياري.موجود(الهدف))) مثل طبيعي) == 0) { أرجع 20; }
            إذا (!إحصاء_جلسة_تحليل(&الجلسة).كاملة) { أرجع 21; }
        }
        | اختياري.لا_شيء -> { };
        أرجع 42;
    };
}
