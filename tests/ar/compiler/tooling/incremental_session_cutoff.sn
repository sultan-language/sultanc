// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/incremental_session_cutoff.sn
// القطع المبكر في جلسة تحليل تزايدي. تُعدَّل مساحة العمل (root.sn يستورد
// lib.sn وuser.sn، وuser.sn يستورد lib.sn) بنصوص محرر غير محفوظة، وبعد كل
// تعديل يُقارن ناتج الجلسة بتحليل كامل للنصوص نفسها: كل ظهور محلول (موضع
// تصريحه ونوعه)، وكل تشخيص (في موضعه)، واكتمال كل مصدر (صف_واجهة_للمقارنة).
// حين تختلف النصوص عن الحالة النهائية التي حفظتها الجلسة في وحدة واحدة، ولا
// يختلف فيها رمز خارج أجسام دوالها، لا تُحلل إلا تلك الوحدة (تُحلل 1، قطع مبكر؛
// ولا شيء بلا تعديل): تعليقات تتحرك بعدها كل التصريحات
// اللاحقة؛ ومحلي جديد وإشارات جديدة ومحذوفة إلى دالة مستوردة؛ وخطأ نوع في
// جسم (يبقى المستورد مكتوب الأنواع) وإصلاحه. أما تغيير توقيع، وتصريح عام
// جديد، وجسم دالة عامة النوع فتُحلل كما كانت، مع المستوردين. وتبقى تعديلات
// الأجسام الكثيرة مساوية للتحليل الكامل ولا يكبر بها التحليل (لا تتغير
// الحالة المحفوظة). وتغيير وحدتين معا لا يحفظ حالة نهائية؛ فالنسخة المجهزة
// مسبقا حينئذ هي نسخة حالة المساحة.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.incremental_analysis;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.symbols;
استورد compiler.frontend.names.name_context;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد المكتبة.نصوص.بحث;
استورد المكتبة.نصوص.مقطع;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.تحويل;
استورد المكتبة.نصوص.من_بايتات;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف مسار(الاسم: نص): نص {
    ليكن الأجزاء: متجه نص = [«tests/ar/compiler/tooling/incremental_session_cutoff/», الاسم];
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف صل(أ: نص, ب: نص): نص {
    ليكن الأجزاء: متجه نص = [أ, ب];
    ليكن الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

عرف طلب(البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن): طلب_واجهة_وحدة {
    ليكن الناتج: طلب_واجهة_وحدة = { البيئة: استنسخ(البيئة), المفتاح_الجذري: استنسخ(المفتاح), احتفظ_بحقائق_الأدوات: صواب };
    أرجع الناتج;
}

عرف صف(الناتج: &نتيجة_بناء_واجهة_قابلة_للإلغاء): متجه نص {
    طابق *الناتج مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { أرجع صف_واجهة_للمقارنة(&الواجهة); }
    | _ -> { ليكن لا_شيء_منها: متجه نص = []; أرجع لا_شيء_منها; };
}

عرف متماثلان(أ: &متجه نص, ب: &متجه نص): منطقي {
    إذا ((الطول(*أ) مثل طبيعي) == 0 || (الطول(*أ) مثل طبيعي) != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; }
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا (!نصان_متساويان(&(*أ)[ف], &(*ب)[ف])) { أرجع خطأ; }
        ف := ف + 1;
    }
    أرجع صواب;
}

// هل في سطر من الأسطر النص المعطى.
عرف يذكر(الأسطر: &متجه نص, النص: نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        طابق ابحث_نصا(&(*الأسطر)[ف], &النص) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// هل في سطر تشخيص اسم المصدر المعطى.
عرف تشخيص_في(الأسطر: &متجه نص, الاسم: نص): منطقي {
    ليكن ف: متغير طبيعي = 0;
    ليكن الرأس: نص = «D »;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        إذا (يبدأ_بـ(&(*الأسطر)[ف], &الرأس)) {
            طابق ابحث_نصا(&(*الأسطر)[ف], &الاسم) مع
            | اختياري.موجود(_) -> { أرجع صواب; }
            | اختياري.لا_شيء -> { };
        }
        ف := ف + 1;
    }
    أرجع خطأ;
}

// المسار الذي حُمل منه مصدر، كما يسميه سطر اكتماله.
عرف المسار_المحمل(الأسطر: &متجه نص, الاسم: نص): نص {
    ليكن الذيل: نص = صل_النصوص(&[«/», انسخ_نص(&الاسم), « load=»], &«»);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأسطر) مثل طبيعي)) {
        ليكن السطر: &نص = &(*الأسطر)[ف];
        ليكن الرأس: نص = «C »;
        إذا (يبدأ_بـ(السطر, &الرأس)) {
            طابق ابحث_نصا(السطر, &الذيل) مع
            | اختياري.موجود(الموضع) -> {
                طابق مقطع_نص(السطر, 2, الموضع + 1 + (الطول(الاسم) مثل طبيعي) - 2) مع
                | اختياري.موجود(المسار) -> { أرجع المسار; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        ف := ف + 1;
    }
    أرجع «»;
}

// ناتج الجلسة للنصوص الحالية، مقارنا بتحليل كامل؛ ويُحفظ ناتج الجلسة في النواتج.
عرف خطوة(
    الجلسة: &متغير جلسة_تحليل_تزايدي, البيئة: &بيئة_وحدات_منطقية, المفتاح: &مفتاح_وحدة_مقنن,
    النواتج: &متغير متجه نتيجة_واجهة_وحدة
): متجه نص {
    ليكن المزيد: متجه مفتاح_وحدة_مقنن = [];
    ليكن الإلغاء: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    ليكن التزايدي: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_في_جلسة(الجلسة, طلب(البيئة, المفتاح), المضيف(), &المزيد, &الإلغاء);
    ليكن الكامل: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(طلب(البيئة, المفتاح), المضيف(), &المزيد, &الإلغاء);
    ليكن أ: متجه نص = صف(&التزايدي);
    ليكن ب: متجه نص = صف(&الكامل);
    إذا (!متماثلان(&أ, &ب)) { ليكن لا_شيء_منها: متجه نص = []; أرجع لا_شيء_منها; }
    طابق التزايدي مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> { ألحق(*النواتج, الواجهة); }
    | _ -> { };
    أرجع أ;
}

// قطع مبكر: وحدة واحدة تُحلل، وتُعاد البقية.
عرف قطع(الجلسة: &جلسة_تحليل_تزايدي): منطقي {
    ليكن الإحصاء: إحصاء_طلب_جلسة = إحصاء_جلسة_تحليل(الجلسة);
    أرجع الإحصاء.قطع_مبكر && الإحصاء.اللقطة == 3 && الإحصاء.المحللة == 1 && الإحصاء.المعاد_استعمالها > 0;
}

// تحليل كما كان: لا قطع، الوحدة ومستوردوها.
عرف مرحلي(الجلسة: &جلسة_تحليل_تزايدي): منطقي {
    ليكن الإحصاء: إحصاء_طلب_جلسة = إحصاء_جلسة_تحليل(الجلسة);
    أرجع !الإحصاء.قطع_مبكر && الإحصاء.المحللة >= 2;
}

// بايت أول موضع للمطلوب في النص، بعد تخطي بايتات منه.
عرف بايت(النص: &نص, المطلوب: نص, التخطي: طبيعي): طبيعي {
    طابق ابحث_نصا(النص, &المطلوب) مع
    | اختياري.موجود(الموضع) -> { أرجع الموضع + التخطي; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

// التصريح الذي يُحل إليه الاسم عند بايت من مصدر: هل اسمه عند ذلك البايت، وكم
// ظهورا يُحل إليه.
عرف مصرح_عند(الواجهة: &نتيجة_واجهة_وحدة, المسار: &نص, البايت: طبيعي): منطقي {
    طابق معرف_مصدر_واجهة_باسم(الواجهة, المسار) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المصدر) -> {
        طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الرمز) -> {
            طابق تصريح_رمز_واجهة(الواجهة, الرمز) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(التصريح) -> {
                أرجع (التصريح.نطاق_الاسم.البداية.البايت مثل طبيعي) == البايت
                    && (التصريح.نطاق_الاسم.البداية.المصدر مثل طبيعي) == المصدر;
            };
        };
    };
}

عرف الإشارات_عند(الواجهة: &نتيجة_واجهة_وحدة, المسار: &نص, البايت: طبيعي): طبيعي {
    طابق معرف_مصدر_واجهة_باسم(الواجهة, المسار) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(المصدر) -> {
        طابق رمز_واجهة_عند_بايت(الواجهة, المصدر, البايت) مع
        | اختياري.لا_شيء -> { أرجع 0; }
        | اختياري.موجود(الرمز) -> { أرجع الطول(ظهورات_رمز_واجهة(الواجهة, الرمز)) مثل طبيعي; };
    };
}

// كم رمزا في حقائق أسماء الناتج.
عرف عدد_الرموز(الواجهة: &نتيجة_واجهة_وحدة): طبيعي {
    طابق (*الواجهة).استعلامات_الأسماء مع
    | اختياري.موجود(الأسماء) -> { أرجع الطول(الأسماء.الرموز) مثل طبيعي; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    ليكن الجذر: نص = مسار(«root.sn»);
    ليكن الإضافية: متجه نص = [];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع 1; }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة_الأولى, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: _ }) -> {
        ليكن البيئة: متغير بيئة_وحدات_منطقية = البيئة_الأولى;
        ليكن الجلسة: متغير جلسة_تحليل_تزايدي = جلسة_تحليل_تزايدي_جديدة();
        ليكن النواتج: متغير متجه نتيجة_واجهة_وحدة = [];
        // تحليل كامل، ثم الحالات المحفوظة.
        ليكن الأولى: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج);
        إذا ((الطول(الأولى) مثل طبيعي) == 0) { أرجع 2; }
        ليكن المكتبة: نص = المسار_المحمل(&الأولى, «lib.sn»);
        ليكن المستعمل: نص = المسار_المحمل(&الأولى, «user.sn»);
        إذا ((الطول(المكتبة) مثل طبيعي) == 0 || (الطول(المستعمل) مثل طبيعي) == 0) { أرجع 3; }
        // بلا تعديل: الحالة النهائية التي حفظها التحليل الكامل، كما هي.
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 4; }
        إذا (!إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر || إحصاء_جلسة_تحليل(&الجلسة).المحللة != 0) { أرجع 50; }

        // تعديل جسم في lib.sn: lib.sn وحده، في تلك الحالة النهائية.
        ليكن مكتبة_أ: نص = "عام عرف ضاعف(س: عدد): عدد { أرجع س * 5; }\nعام عرف مساعد(): عدد { أرجع 3; }\nعام عرف اختر<ن>(أ: ن, ب: ن): ن { أرجع أ; }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_أ));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 5; }
        إذا (!قطع(&الجلسة)) { أرجع 6; }

        // 1. تعليق يُلحق بـlib.sn، وله مستوردون: lib.sn وحده.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), صل(انسخ_نص(&مكتبة_أ), "// ملاحظة في الآخر\n"));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 7; }
        إذا (!قطع(&الجلسة) || إحصاء_جلسة_تحليل(&الجلسة).المتغيرة != 1) { أرجع 8; }
        // تعليقات قبل التصريحات: يتحرك كل ما بعدها.
        ليكن مكتبة_ب: نص = صل("// ملاحظة\n// وأخرى أطول منها\n", انسخ_نص(&مكتبة_أ));
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_ب));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 9; }
        إذا (!قطع(&الجلسة)) { أرجع 10; }
        ليكن عند_المساعد: طبيعي = بايت(&مكتبة_ب, «مساعد», 0);
        إذا (!مصرح_عند(&النواتج[(الطول(النواتج) مثل طبيعي) - 1], &المكتبة, عند_المساعد)) { أرجع 11; }
        // مصرح به مرة، ومستعمل مرة في user.sn.
        إذا (الإشارات_عند(&النواتج[(الطول(النواتج) مثل طبيعي) - 1], &المكتبة, عند_المساعد) != 2) { أرجع 12; }

        // 2. user.sn: تعديل جسم (ويختلف lib.sn أيضا عن الحالة النهائية المحفوظة:
        // يُحلل كما كان، وتُحفظ حالته النهائية)، ثم محلي جديد وإشارة جديدة إلى
        // دالة مستوردة، ثم حذف تلك الإشارة.
        ليكن مستعمل_أ: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { أرجع ضاعف(4) + مساعد() + اختر(1, 2); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_أ));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 13; }
        إذا (!مرحلي(&الجلسة)) { أرجع 14; }
        ليكن مستعمل_ب: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { ليكن ضعفان: عدد = مساعد(); أرجع ضاعف(4) + مساعد() + ضعفان + اختر(1, 2); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ب));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 15; }
        إذا (!قطع(&الجلسة)) { أرجع 16; }
        إذا (الإشارات_عند(&النواتج[(الطول(النواتج) مثل طبيعي) - 1], &المكتبة, عند_المساعد) != 3) { أرجع 17; }
        ليكن عند_الضعفين: طبيعي = بايت(&مستعمل_ب, «ضعفان», 0);
        إذا (!مصرح_عند(&النواتج[(الطول(النواتج) مثل طبيعي) - 1], &المستعمل, عند_الضعفين)) { أرجع 18; }
        ليكن مستعمل_ج: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { ليكن ضعفان: عدد = 2; أرجع ضاعف(4) + ضعفان + اختر(1, 2); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ج));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 19; }
        إذا (!قطع(&الجلسة)) { أرجع 20; }
        إذا (الإشارات_عند(&النواتج[(الطول(النواتج) مثل طبيعي) - 1], &المكتبة, عند_المساعد) != 1) { أرجع 21; }

        // 3. خطأ نوع في جسم: تشخيصه، في موضعه (مقارنا بتشخيص التحليل الكامل)؛
        // ويبقى root.sn مكتوب الأنواع. ثم الإصلاح.
        ليكن مستعمل_د: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { ليكن ضعفان: عدد = «اثنان»; أرجع ضاعف(4) + ضعفان + اختر(1, 2); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_د));
        ليكن المكسور: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج);
        إذا ((الطول(المكسور) مثل طبيعي) == 0) { أرجع 22; }
        إذا (!قطع(&الجلسة)) { أرجع 23; }
        إذا (!تشخيص_في(&المكسور, «user.sn»)) { أرجع 24; }
        إذا (!يذكر(&المكسور, «root.sn load=1 names=1 types=1»)) { أرجع 25; }
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ج));
        ليكن المصلح: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج);
        إذا ((الطول(المصلح) مثل طبيعي) == 0) { أرجع 26; }
        إذا (!قطع(&الجلسة) || يذكر(&المصلح, «D »)) { أرجع 27; }

        // 4. تغيير توقيع: يُحلل المستوردون من جديد؛ ثم العودة.
        ليكن مستعمل_ه: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(الأساس: عدد): عدد { أرجع ضاعف(الأساس); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ه));
        ليكن المغير: متجه نص = خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج);
        إذا ((الطول(المغير) مثل طبيعي) == 0) { أرجع 28; }
        إذا (!مرحلي(&الجلسة) || !تشخيص_في(&المغير, «root.sn»)) { أرجع 29; }
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ج));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 30; }
        إذا (!مرحلي(&الجلسة)) { أرجع 31; }

        // 5. تصريح عام جديد: يُحلل كما كان.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), صل(انسخ_نص(&مستعمل_ج), "عام عرف إضافي(): عدد { أرجع 9; }\n"));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 32; }
        إذا (!مرحلي(&الجلسة)) { أرجع 33; }

        // 6. تعديل جسم في lib.sn: قطع. وجسم دالة عامة النوع: قد تقرؤه حقائق
        // مستدعيها، فيُحلل المستوردون من جديد. وتعليق داخله لا يغير رمزا: قطع.
        ليكن مكتبة_ج: نص = صل("// ملاحظة\n// وأخرى أطول منها\n", "عام عرف ضاعف(س: عدد): عدد { أرجع س * 6; }\nعام عرف مساعد(): عدد { أرجع 3; }\nعام عرف اختر<ن>(أ: ن, ب: ن): ن { أرجع أ; }\n");
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_ج));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 34; }
        إذا (!قطع(&الجلسة)) { أرجع 35; }
        ليكن مكتبة_د: نص = صل("// ملاحظة\n// وأخرى أطول منها\n", "عام عرف ضاعف(س: عدد): عدد { أرجع س * 6; }\nعام عرف مساعد(): عدد { أرجع 3; }\nعام عرف اختر<ن>(أ: ن, ب: ن): ن { أرجع ب; }\n");
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_د));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 36; }
        إذا (!مرحلي(&الجلسة)) { أرجع 37; }
        ليكن مكتبة_ه: نص = صل("// ملاحظة\n// وأخرى أطول منها\n", "عام عرف ضاعف(س: عدد): عدد { أرجع س * 6; }\nعام عرف مساعد(): عدد { أرجع 3; }\nعام عرف اختر<ن>(أ: ن, ب: ن): ن {\n    // الثانية\n    أرجع ب;\n}\n");
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_ه));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 38; }
        إذا (!قطع(&الجلسة)) { أرجع 39; }

        // 7. تعديلات أجسام كثيرة في user.sn: كل منها مساو للتحليل الكامل، وكل
        // منها قطع، ولا يكبر التحليل (لا تتغير الحالة المحفوظة: يبدأ منها كل
        // تعديل).
        ليكن مستعمل_و: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { ليكن ضعفان: عدد = 2; أرجع ضاعف(5) + ضعفان + اختر(1, 2); }\n";
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_و));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 40; }
        إذا (!مرحلي(&الجلسة)) { أرجع 41; }
        ليكن س: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد { ليكن ضعفان: عدد = 2; ليكن أكثر: عدد = ضعفان + 1; أرجع ضاعف(أكثر) + اختر(1, 2); }\n";
        ليكن ص: نص = "استورد «lib.sn»;\nعام عرف استعمل_المضاعفة(): عدد {\n    // مفصلة\n    ليكن ضعفان: عدد = 3;\n    أرجع ضاعف(ضعفان) + مساعد();\n}\n";
        ليكن العدد_الأول: متغير طبيعي = 0;
        ليكن الجولة: متغير طبيعي = 0;
        طالما (الجولة < 12) {
            إذا ((الجولة % 2) == 0) {
                ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&س));
            } وإلا {
                ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&ص));
            }
            إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 43; }
            إذا (!قطع(&الجلسة)) { أرجع 44; }
            إذا (الجولة == 0) { العدد_الأول := عدد_الرموز(&النواتج[(الطول(النواتج) مثل طبيعي) - 1]); }
            إذا ((الجولة % 2) == 0 && عدد_الرموز(&النواتج[(الطول(النواتج) مثل طبيعي) - 1]) != العدد_الأول) { أرجع 45; }
            الجولة := الجولة + 1;
        }

        // وحدتان تتغيران معا: لا تُحفظ حالة نهائية، والنسخة المجهزة مسبقا هي
        // نسخة حالة المساحة.
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المكتبة), انسخ_نص(&مكتبة_أ));
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_أ));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 46; }
        إذا (!مرحلي(&الجلسة)) { أرجع 47; }
        جهز_جلسة_تحليل(&متغير الجلسة);
        ضع_تراكب_مصدر_في_البيئة(&متغير البيئة, انسخ_نص(&المستعمل), انسخ_نص(&مستعمل_ب));
        إذا ((الطول(خطوة(&متغير الجلسة, &البيئة, &المفتاح, &متغير النواتج)) مثل طبيعي) == 0) { أرجع 48; }
        إذا (إحصاء_جلسة_تحليل(&الجلسة).قطع_مبكر || !إحصاء_جلسة_تحليل(&الجلسة).جاهزة) { أرجع 49; }
        أرجع 42;
    };
}
