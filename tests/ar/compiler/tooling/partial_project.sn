// اختبار: تشغيل
// خروج: 42
// نظير: tests/en/compiler/tooling/partial_project.sn
// مشروع لا يمكن ربط أسماء c.sn منه (اسم مجهول): طلب الأدوات يربط a.sn وb.sn مع
// ذلك فتوجد استعمالات `ف` في b.sn، ويبلغ أي المصادر ناقص. وترجمة المشروع نفسه
// تُرفض بعدد الأخطاء نفسه كما كانت.
استورد compiler.driver.source_inputs;
استورد compiler.frontend.semantic_pipeline;
استورد compiler.frontend.tooling_queries;
استورد compiler.frontend.tooling_facts;
استورد compiler.frontend.cancellation;
استورد compiler.frontend.module_loading.logical_environment;
استورد compiler.frontend.names.identifiers;
استورد compiler.frontend.names.resolved_bindings;
استورد compiler.backend.target.target_model;
استورد compiler.backend.target.target_registry;
استورد compiler.diagnostics.engine;
استورد compiler.source.span;
استورد std.text.search;
استورد std.text.transform;

عرف المضيف(): اختياري واصف_هدف {
    طابق حل_هدف_المضيف_المسجل() مع
    | نتيجة_حل_هدف.غير_مسجل -> { أرجع اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(الهدف) -> { أرجع اختياري.موجود(الهدف); };
}

عرف مسار(الاسم: نص): نص {
    دع الأجزاء: متجه نص = [«tests/ar/compiler/tooling/partial/», الاسم];
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

// المشروع كما تبنيه خدمة اللغة: a.sn الجذر، وb.sn وc.sn ينضمان إليه.
عرف حلل(للأدوات: منطقي): نتيجة_بناء_واجهة_قابلة_للإلغاء {
    دع الجذر: نص = مسار(«a.sn»);
    دع الإضافية: متجه نص = [مسار(«b.sn»), مسار(«c.sn»)];
    طابق ابن_إعداد_تجميع_مباشر(&الجذر, &الإضافية) مع
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { أرجع نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: البيئة, المفتاح_الجذري: المفتاح, المفاتيح_المباشرة: المفاتيح }) -> {
        دع المزيد: متغير متجه مفتاح_وحدة_مقنن = [];
        دع ف: متغير طبيعي = 1;
        طالما (ف < (الطول(المفاتيح) مثل طبيعي)) {
            ألحق(المزيد, انسخ_مفتاح_وحدة_مقنن(&المفاتيح[ف]));
            ف := ف + 1;
        }
        دع الطلب: طلب_واجهة_وحدة = { البيئة: البيئة, المفتاح_الجذري: المفتاح, احتفظ_بحقائق_الأدوات: للأدوات };
        دع الإلغاء: متغير حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        أرجع ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(الطلب, المضيف(), &المزيد, &متغير الإلغاء);
    };
}

عرف مصدر_باسم(الواجهة: &نتيجة_واجهة_وحدة, الاسم: نص): طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الواجهة).الوحدات) مثل طبيعي)) {
        دع المعرف: طبيعي = (*الواجهة).الوحدات[ف].معرف_المصدر;
        طابق اسم_مصدر_واجهة_بمعرف(الواجهة, المعرف) مع
        | اختياري.موجود(المكتوب) -> { إذا (ينتهي_بـ(&المكتوب, &الاسم)) { أرجع المعرف; } }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع 1000000;
}

عرف الرئيسية(): عدد {
    دع أخطاء_الأدوات: متغير طبيعي = 0;
    طابق حلل(صواب) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(الواجهة) -> {
        دع أ: طبيعي = مصدر_باسم(&الواجهة, «partial/a.sn»);
        دع ب: طبيعي = مصدر_باسم(&الواجهة, «partial/b.sn»);
        دع ج: طبيعي = مصدر_باسم(&الواجهة, «partial/c.sn»);
        إذا (أ == 1000000 || ب == 1000000 || ج == 1000000) { أرجع 1; }
        دع نص_أ: متغير نص = «»;
        طابق مصدر_واجهة_بمعرف(&الواجهة, أ) مع
        | اختياري.موجود(الموجود) -> { نص_أ := استنسخ(&الموجود.المحتوى); }
        | اختياري.لا_شيء -> { أرجع 12; };
        دع المطلوب: نص = «ف()»;
        دع الموضع: متغير طبيعي = 0;
        طابق ابحث_نصا(&نص_أ, &المطلوب) مع
        | اختياري.موجود(القيمة) -> { الموضع := القيمة; }
        | اختياري.لا_شيء -> { أرجع 13; };
        طابق ظهور_اسم_واجهة_عند_بايت(&الواجهة, أ, الموضع) مع
        | اختياري.لا_شيء -> { أرجع 2; }
        | اختياري.موجود(الظهور) -> {
            طابق الظهور.الرمز مع
            | اختياري.لا_شيء -> { أرجع 3; }
            | اختياري.موجود(الرمز) -> {
                دع الاستعمالات: متجه ظهور_اسم_محلول = ظهورات_رمز_واجهة(&الواجهة, الرمز);
                دع في_ب: متغير طبيعي = 0;
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول(الاستعمالات) مثل طبيعي)) {
                    إذا ((الاستعمالات[ك].النطاق.البداية.المصدر مثل طبيعي) == ب) { في_ب := في_ب + 1; }
                    ك := ك + 1;
                }
                إذا (في_ب != 1) { أرجع 4; }
            };
        };
        دع اكتمال_أ: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, أ);
        دع اكتمال_ب: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, ب);
        دع اكتمال_ج: اكتمال_مصدر_أدوات = اكتمال_مصدر_واجهة(&الواجهة, ج);
        إذا (!اكتمال_أ.الأسماء || !اكتمال_ب.الأسماء || اكتمال_ج.الأسماء) { أرجع 5; }
        إذا (!اكتمال_أ.الأنواع || !اكتمال_ب.الأنواع || اكتمال_ج.الأنواع) { أرجع 6; }
        إذا (الواجهة.كاملة_دلاليا) { أرجع 7; }
        أخطاء_الأدوات := الواجهة.تشخيصات_الأدوات.عدد_الأخطاء مثل طبيعي;
        إذا (أخطاء_الأدوات == 0) { أرجع 8; }
    }
    | _ -> { أرجع 9; };
    // الترجمة ما زالت تُرفض، بالأخطاء نفسها.
    طابق حلل(خطأ) مع
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مرفوضة(التشخيصات) -> {
        إذا ((التشخيصات.عدد_الأخطاء مثل طبيعي) != أخطاء_الأدوات) { أرجع 10; }
    }
    | _ -> { أرجع 11; };
    أرجع 42;
}
