// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_records/main.sn (بلا ترويسة `نظير`: خطوة
// الزوج تفسر التوأمين، والمفسر لا يستدعي دوال ملف .c مستورد).
// سجلات أكبر من 16 بايتًا تمر بالقيمة إلى دوال ملف .c مستورد (يترجمه جسر)
// وبينها. تحفظ تلك الدوال عرف السجلات المسجل للهدف، موضع سجلات سي
// (برنامج_مسير.دوال_اتفاقية_المنصة)، بينما تمرر دوال السلطان هذه السجلات
// مراجع خفية؛ ودالة سي التي يأخذ السلطان قيمتها تُستدعى عبر قيمة الدالة
// بالعرف الداخلي، فتأخذ ذلك العرف لنداءاتها المباشرة أيضًا. المستدعى في سي
// الذي يغير معامله يغير نسخته هو، ورد النداء في سي يستلم سجله بالقيمة.
استورد "records.c";

عرف مجموع_السلطان(س: big): ص64 { أرجع س.a + س.b + س.c + س.d + س.e; }

عرف الرئيسية(): عدد {
    دع س: big = { a: 1, b: 2, c: 3, d: 4, e: 5 };
    إذا (total(س) != 15) { أرجع 1; };
    إذا (bump(س) != 101 || س.a != 1 || س.e != 5) { أرجع 2; };
    دع ر: big = shifted(س);
    إذا (ر.a != 5 || ر.b != 1 || ر.e != 4) { أرجع 3; };
    // bump 101 + first 1 + last 5 + total 15.
    إذا (callbacks(س) != 122) { أرجع 4; };
    إذا (rotate(س, 5) != 1 || rotate(س, 2) != 4) { أرجع 5; };
    // قيمة دالة سي، تُستدعى عبر قيمة دالة.
    دع د: دالة(big): ص64 = total;
    إذا (د(س) != 15 || د(ر) != مجموع_السلطان(ر)) { أرجع 6; };
    دع ج: دالة(big): ص64 = مجموع_السلطان;
    إذا (ج(shifted(ر)) != 15) { أرجع 7; };
    أرجع 42;
}
