// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// التوأم: tests/en/compiler/c_import_layout/main.sn (بلا ترويسة زوج السطح:
// خطوة الزوج تفسر التوأمين، والمفسر لا يستدعي دوال ملف .c مستورد).
// تخطيط البنى عبر جسر (compiler/c_import/jisr): بنى shapes.h سجلات سلطان
// حجمها وإزاحات حقولها هي ما يحسبه مترجم سي (يسأل عنها shapes.c وقت
// التشغيل) وما يحسبه جسر (ثوابت sizeof وoffsetof)؛ والاتحاد وبنية حقول
// البتات والبنية المضغوطة تخزين معتم بالحجم الصحيح؛ وتمر السجلات بالقيمة
// وبالمؤشر.
استورد "shapes.c";
استورد المكتبة.انعكاس.reflect;

عرف الرئيسية(): عدد {
    دع الزوايا: (ص16, ص16, ص16) = (0, 0, 0);
    دع الأصل: point = { x: 0, y: 0 };
    دع ش: متغير shape = { tag: 0, scale: 2.0, origin: الأصل, corners: الزوايا, name: 0 مثل *ط8, next: 0 مثل *متغير shape };
    // تخطيط سلطان للسجل ومترجم سي وجسر متفقة.
    إذا ((حجم_النوع(&ش) مثل ط64) != shape_size() || FACT_SHAPE != 48 || SHAPE_SIZE != 48) { أرجع 1; };
    إذا (shape_offset(2) != (SHAPE_ORIGIN_OFFSET مثل ط64) || shape_offset(3) != (FACT_CORNERS مثل ط64)) { أرجع 2; };
    إذا (shape_offset(4) != (SHAPE_NAME_OFFSET مثل ط64) || shape_offset(5) != (FACT_NEXT مثل ط64)) { أرجع 3; };
    إذا ((حجم_النوع(&الأصل) مثل ص32) != FACT_POINT) { أرجع 4; };
    // يكتب سي السجل عبر مؤشر ويقرأ سلطان حقوله.
    shape_fill(&متغير ش, 3, 4);
    إذا (ش.tag != 83 || ش.origin.x != 3 || ش.origin.y != 4 || ش.corners[0] != 1 || ش.corners[2] != 3) { أرجع 5; };
    إذا (shape_area(&ش) != 27.0) { أرجع 6; };
    // السجلات بالقيمة في الاتجاهين.
    دع أ: point = { x: 1, y: 2 };
    دع ب: point = { x: 10, y: 20 };
    دع المجموع: point = point_add(أ, ب);
    إذا (المجموع.x != 11 || المجموع.y != 22) { أرجع 7; };
    // التخزين المعتم يحفظ الحجم والمحاذاة، واتحاد فيه صحيح يمر بالقيمة.
    دع ع: number = number_of(-7);
    إذا ((حجم_النوع(&ع) مثل ط64) != number_size() || (محاذاة_النوع(&ع) مثل ص32) != FACT_NUMBER_ALIGN) { أرجع 8; };
    إذا (number_bits(ع) != -7) { أرجع 9; };
    دع الأعلام: flags = { opaque: 0 };
    إذا ((حجم_النوع(&الأعلام) مثل ط64) != flags_size()) { أرجع 10; };
    دع البايتات: (ط8, ط8, ط8, ط8, ط8) = (0, 0, 0, 0, 0);
    دع الزوج: packed_pair = { opaque: البايتات };
    إذا (حجم_النوع(&الزوج) != 5) { أرجع 11; };
    دع رأس: buffer = { length_: 0 };
    إذا (حجم_النوع(&رأس) != 4) { أرجع 12; };
    // سجلات من الأعداد العشرية بالقيمة (صنف SSE في System V وHFA في AAPCS64)
    // وسجل من 24 بايتا يمر في الذاكرة.
    دع م2: vec2 = { x: 1.5, y: -2.0 };
    دع المضروب: vec2 = vec2_scale(م2, 2.0);
    إذا (المضروب.x != 3.0 || المضروب.y != -4.0 || vec2_dot32(م2, المضروب) != 12.5) { أرجع 13; };
    دع الكبير: big = { a: 1, b: 2, c: 3 };
    دع المدار: big = big_rotate(الكبير);
    إذا (المدار.a != 2 || المدار.b != 3 || المدار.c != 1) { أرجع 14; };
    أرجع 42;
}
