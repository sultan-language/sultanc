// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_units/main.sn
// ثلاث وحدات ترجمة سي في استيراد واحد (compiler/jisr/units.sn): تعالج كل
// منها مسبقا وتحلل وتترجم وحدها، فالمتغير الساكن `calls` والدالة الساكنة
// `step` في even.c وodd.c منفصلان؛ وتكتب البنية pair ونماذج units.h مرة
// واحدة؛ والنداءات بين الوحدات (تستدعي is_even وis_odd كل منهما الأخرى،
// وتستدعيهما pair_sum) تذهب إلى دالة الوحدة الأخرى المترجمة، بلا مترجم سي
// ولا رمز ربط.
استورد "even.c+odd.c+pairs.c";

عرف الرئيسية(): عدد {
    إذا (is_even(4) != 1 || is_odd(4) != 0) { أرجع 1; };
    دع الزوج: pair = make_pair(17, 23);
    // 23 + 17 + is_even(10) + is_odd(7) = 40 + 1 + 1
    دع المجموع: ص32 = pair_sum(الزوج);
    إذا (المجموع != 42) { أرجع 2; };
    // تعد even.c نداءاتها وحدها.
    إذا (count_calls() <= 0) { أرجع 3; };
    أرجع المجموع مثل عدد;
}
