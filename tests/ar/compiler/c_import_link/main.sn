// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import_link/main.sn
// ملفا سي تستوردهما وحدتان مختلفتان من السلطان يستدعي كل منهما الآخر، كما
// تفعل ملفات سي مترجمة منفصلة ومربوطة في برنامج واحد: يستدعي left.c (الذي
// تستورده left.sn) الدوال twice وsum_pt وmake_pt من right.c (الذي تستورده
// right.sn)، ويستدعي right.c الدالة left_base من left.c. كل نداء منها نداء
// مباشر لدالة الملف الآخر المترجمة (يربط MSIR الدالة الخارجية لاستيراد سي
// بالتعريف المترجم لرمزها)، لا رمز ربط. والبنية pt من link.h سجل واحد في
// البرنامج: تأخذها وحدة right.c من وحدة left.c (compiler/jisr/shared.sn)،
// وتجعلها الواجهة الأمامية مرئية لكل من يستورد أيا منهما. وتستورد هذه
// الوحدة الترويسة أيضا: نماذجها تستدعي الدوال المترجمة نفسها، والاسم الذي
// تصرح به الترويسة ويعرفه ملف .c دالة واحدة.
استورد "left.sn";
استورد "right.sn";
استورد "link.h";

عرف الرئيسية(): عدد {
    // use_left(10) = twice(10) + sum_pt({10, 1}) = 20 + 11 = 31
    إذا (من_اليسار(10) != 31) { أرجع 1; };
    // right_total() + sum_pt({2, 3}) = (5 + 2) + 5 = 12
    إذا (من_اليمين() != 12) { أرجع 2; };
    // عبر نماذج الترويسة.
    دع النقطة: pt = make_pt(1, 2);
    إذا (sum_pt(النقطة) != 3 || twice(4) != 8 || use_left(0) != 1) { أرجع 3; };
    // 31 + 12 - 1 = 42
    أرجع (من_اليسار(10) + من_اليمين() - left_base() + 4) مثل عدد;
}
