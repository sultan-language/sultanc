// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/compiler/c_import/main.sn
// التشغيل البيني مع سي (جسر، compiler/jisr): يترجم `استورد "vec.c"` الملف
// vec.c داخل البرنامج (بلا مترجم سي)، ويقرأ تصريحاته وتصريحات vec.h كسلطان:
// الدوال بتواقيعها في سي (يصرح vec.h بـ`vec *` ولا يكمل struct vec إلا vec.c:
// نوع معتم ومؤشراته مكتوبة الأنواع)، والتعدادات والماكروهات العددية والنصية ثوابت.
// و`استورد "errno.h"` يقرأ ترويسة نظام.
استورد "vec.c";
استورد "errno.h";

عرف الرئيسية(): عدد {
    إذا (VEC_VERSION != 66051 || VEC_LIMIT != 258 || VEC_NEG != -5 || VEC_MASK != 2147483648) { أرجع 1; };
    إذا (VEC_EMPTY != 0 || VEC_SMALL != 4 || VEC_LARGE != 5) { أرجع 2; };
    إذا (الطول(VEC_NAME) != 3) { أرجع 3; };
    إذا (EINVAL <= 0) { أرجع 4; };
    دع ش: *متغير vec = vec_new(2);
    إذا (ش == 0 مثل *متغير vec) { أرجع 5; };
    دع ف: متغير ص64 = 1;
    طالما (ف <= 6) {
        إذا (vec_push(ش, ف) != 1) { أرجع 6; };
        ف := ف + 1;
    }
    إذا (vec_length(ش) != 6 || vec_sum(ش) != 21 || vec_mean(ش) != 3.5) { أرجع 7; };
    دع الاسم: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    إذا (vec_name_copy(&متغير الاسم[0], 8) != 3 || الاسم[0] != 118 || الاسم[3] != 0) { أرجع 8; };
    vec_free(ش);
    أرجع 42;
}
