// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/process_id_terminal.sn
// std.process.id وstd.os.terminal: معرف العملية ليس 0 ولا يتغير بين
// النداءين، وفحوص الطرفية تجيب دون فشل.
استورد المكتبة.عمليات.معرف_العملية;
استورد المكتبة.نظام_التشغيل.طرفية;

عرف الرئيسية(): عدد {
    ليكن الأول: ط64 = معرف_العملية();
    إذا (الأول == 0) { أرجع 1; };
    إذا (معرف_العملية() != الأول) { أرجع 2; };
    ليكن أ: منطقي = هل_الدخل_طرفية();
    ليكن ب: منطقي = هل_الخرج_طرفية();
    ليكن ج: منطقي = هل_الخطأ_طرفية();
    أرجع 0;
}
