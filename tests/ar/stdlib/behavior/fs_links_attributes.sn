// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/fs_links_attributes.sn
// الوصلات والأذونات والأحجام والأوقات والمسارات القانونية والملفات المؤقتة
// في std.fs داخل دليل مؤقت جديد يحذف في النهاية.
استورد std.fs.links;
استورد std.fs.permissions;
استورد std.fs.attributes;
استورد std.fs.canonical;
استورد std.fs.temporary;
استورد std.fs.write_file;
استورد std.fs.read_file;
استورد std.fs.metadata;
استورد std.fs.mutation;
استورد std.fs.handle;
استورد std.fs.path;
استورد std.fs.error;
استورد std.text.compare;

عرف الرئيسية(): عدد {
    دع البادئة: نص = «sultanc-fs-»;
    دع الدليل: متغير نص = «»;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المنشأ) -> { الدليل := المنشأ; };
    دع الاسم: نص = «a.txt»;
    دع الملف: نص = صل_المسار(&الدليل, &الاسم);
    دع المحتوى: نص = «hello world»;
    طابق اكتب_الملف(&الملف, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> {};
    طابق اقتطع_الملف(&الملف, 5) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> {};
    طابق حجم_المسار(&الملف) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(الحجم) -> { لو (الحجم != 5) { أرجع 5; }; };
    دع اسم_الوصلة: نص = «وصلة»;
    دع وصلة: نص = صل_المسار(&الدليل, &اسم_الوصلة);
    طابق أنشئ_وصلة_رمزية(&الاسم, &وصلة) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(_) -> {};
    طابق اقرأ_وصلة_رمزية(&وصلة) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الهدف_المقروء) -> { لو (!نصان_متساويان(&الهدف_المقروء, &الاسم)) { أرجع 8; }; };
    طابق مسار_قانوني(&وصلة) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(عبر_الوصلة) -> {
        طابق مسار_قانوني(&الملف) مع
        | نتيجة.خطأ(_) -> { أرجع 10; }
        | نتيجة.نجح(مباشر) -> { لو (!نصان_متساويان(&عبر_الوصلة, &مباشر)) { أرجع 11; }; };
    };
    دع اسم_مفقود: نص = «مفقود»;
    دع مفقود: نص = صل_المسار(&الدليل, &اسم_مفقود);
    طابق مسار_قانوني(&مفقود) مع
    | نتيجة.خطأ(فئة_خطأ_نظام.غير_موجود) -> {}
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(_) -> { أرجع 13; };
    طابق حول_إلى_مسار_مطلق(&الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(الكامل) -> { لو (!مسار_مطلق(&الكامل)) { أرجع 15; }; };
    دع اسم_صلب: نص = «صلب»;
    دع صلب: نص = صل_المسار(&الدليل, &اسم_صلب);
    طابق أنشئ_وصلة_صلبة(&الملف, &صلب) مع
    | نتيجة.خطأ(_) -> { أرجع 16; }
    | نتيجة.نجح(_) -> {};
    طابق اقرأ_الملف(&صلب) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(النص) -> { دع المتوقع: نص = «hello»; لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 18; }; };
    طابق اضبط_أذونات(&الملف, 292) مع
    | نتيجة.خطأ(_) -> { أرجع 19; }
    | نتيجة.نجح(_) -> {};
    طابق اقرأ_أذونات(&الملف) مع
    | نتيجة.خطأ(_) -> { أرجع 20; }
    | نتيجة.نجح(الوضع) -> { لو (الوضع != 292 || !هل_للقراءة_فقط(الوضع)) { أرجع 21; }; };
    طابق اضبط_أذونات(&الملف, 416) مع
    | نتيجة.خطأ(_) -> { أرجع 22; }
    | نتيجة.نجح(_) -> {};
    طابق اقرأ_أذونات(&الملف) مع
    | نتيجة.خطأ(_) -> { أرجع 23; }
    | نتيجة.نجح(الوضع) -> { لو (الوضع != 416 || هل_للقراءة_فقط(الوضع)) { أرجع 24; }; };
    طابق اضبط_أذونات(&الملف, 8192) مع
    | نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح) -> {}
    | نتيجة.خطأ(_) -> { أرجع 25; }
    | نتيجة.نجح(_) -> { أرجع 26; };
    طابق اضبط_أوقات_الملف(&الملف, 1000000000123456789, 1600000000987654321) مع
    | نتيجة.خطأ(_) -> { أرجع 27; }
    | نتيجة.نجح(_) -> {};
    طابق وقت_تعديل_المسار_نانو(&الملف) مع
    | نتيجة.خطأ(_) -> { أرجع 28; }
    | نتيجة.نجح(الوقت) -> { لو (الوقت / 1000000000 != 1600000000) { أرجع 29; }; };
    دع مسار_مؤقت: متغير نص = «»;
    طابق أنشئ_ملفا_مؤقتا_في(&الدليل, &البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 30; }
    | نتيجة.نجح({ المسار: مسار, المقبض: مقبض }) -> {
        مسار_مؤقت := مسار;
        دع البيانات: متجه ط8 = [1, 2, 3, 4];
        طابق اكتب_إلى_مقبض_ملف(&مقبض, &البيانات, 0, 4) مع
        | نتيجة.خطأ(_) -> { أرجع 31; }
        | نتيجة.نجح(_) -> {};
        طابق اقتطع_مقبض_ملف(&مقبض, 2) مع
        | نتيجة.خطأ(_) -> { أرجع 32; }
        | نتيجة.نجح(_) -> {};
        طابق أغلق_مقبض_ملف(مقبض) مع
        | نتيجة.خطأ(_) -> { أرجع 33; }
        | نتيجة.نجح(_) -> {};
    };
    طابق حجم_المسار(&مسار_مؤقت) مع
    | نتيجة.خطأ(_) -> { أرجع 34; }
    | نتيجة.نجح(الحجم) -> { لو (الحجم != 2) { أرجع 35; }; };
    دع بادئة_خاطئة: نص = «a/b»;
    طابق أنشئ_ملفا_مؤقتا_في(&الدليل, &بادئة_خاطئة) مع
    | نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح) -> {}
    | نتيجة.خطأ(_) -> { أرجع 36; }
    | نتيجة.نجح(_) -> { أرجع 37; };

    طابق أزل_ملفا(&مسار_مؤقت) مع
    | نتيجة.خطأ(_) -> { أرجع 38; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&صلب) مع
    | نتيجة.خطأ(_) -> { أرجع 39; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&وصلة) مع
    | نتيجة.خطأ(_) -> { أرجع 40; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&الملف) مع
    | نتيجة.خطأ(_) -> { أرجع 41; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_دليلا(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 43; }
    | نتيجة.نجح(_) -> {};
    أرجع 42;
}
