عرف متوقع_ص8(القيمة: اختياري ص8, المتوقع: ص8, موجود: منطقي): منطقي {
    طابق القيمة مع
    | اختياري.موجود(س) -> { أرجع موجود && س == المتوقع; }
    | اختياري.لا_شيء -> { أرجع !موجود; };
}
