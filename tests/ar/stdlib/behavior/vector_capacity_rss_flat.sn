// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// المتجه الذي يحتفظ بمخزنه يحرره حين يُسقط: 10^5 جولة من متجه_بسعة
// واحجز_في_المتجه واحجز_سعة واقتطع(م, 0) وإعادة الاستعمال وأزل_الأخير حتى
// الفراغ وقلص_المتجه، على أعداد ونصوص مملوكة، تترك البايتات الحية في المخصص
// كما كانت.
// النظير: tests/en/stdlib/behavior/vector_capacity_rss_flat.sn. لا توجيه
// نظير له: المفسر لا يستعمل مخصص std الذي تقرأ هذه الشفرة عداداته.
استورد std.os.allocation;
استورد std.collections.vector;
استورد std.text.number;

عرف round(i: عدد): عدد {
    دع v: متغير متجه عدد = متجه_بسعة(8);
    ألحق(v, i);
    ألحق(v, i + 1);
    اقتطع(v, 0);
    ألحق(v, i + 2);
    احجز_في_المتجه(&متغير v, 30);
    دع words: متغير متجه نص = [];
    احجز_سعة(words, 4);
    ألحق(words, عدد_إلى_نص(i));
    ألحق(words, عدد_إلى_نص(i + 5));
    أزل_الأخير(words);
    أزل_الأخير(words);
    ألحق(words, عدد_إلى_نص(i + 9));
    قلص_المتجه(&متغير words);
    دع emptied: متغير متجه نص = [];
    ألحق(emptied, عدد_إلى_نص(i));
    اقتطع(emptied, 0);
    أرجع v[0] + (الطول(words[0]) مثل عدد) + سعة(emptied);
}

عرف الرئيسية(): عدد {
    دع warm_up: عدد = round(0);
    إذا (warm_up < 0) { أرجع 1; };
    دع before: ط64 = بايتات_حية_مخصص_النظام();
    دع i: متغير عدد = 0;
    طالما (i < 100000) {
        إذا (round(i) < 0) { أرجع 2; };
        i := i + 1;
    }
    دع after: ط64 = بايتات_حية_مخصص_النظام();
    إذا (after != before) { أرجع 3; };
    أرجع 42;
}
