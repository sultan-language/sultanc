// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/udp_datagrams.sn
// مقبسا UDP على الحلقة المحلية متصلان ببعضهما يتبادلان رسالة في كل اتجاه.
استورد std.net.socket_address;
استورد std.net.udp;
استورد std.net.options;

عرف الرئيسية(): عدد {
    دع نص_أ: نص = «127.0.0.1:38613»;
    دع نص_ب: نص = «127.0.0.1:38614»;
    طابق حلل_عنوان_مقبس(&نص_أ) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(عنوان_أ) -> {
        طابق حلل_عنوان_مقبس(&نص_ب) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(عنوان_ب) -> {
            طابق اربط_يو_دي_بي(&عنوان_أ) مع
            | نتيجة.خطأ(_) -> { أرجع 3; }
            | نتيجة.نجح(أ) -> {
                طابق اربط_يو_دي_بي(&عنوان_ب) مع
                | نتيجة.خطأ(_) -> { أرجع 4; }
                | نتيجة.نجح(ب) -> {
                    طابق وصل_يو_دي_بي(&أ, &عنوان_ب) مع
                    | نتيجة.خطأ(_) -> { أرجع 5; }
                    | نتيجة.نجح(_) -> { };
                    طابق وصل_يو_دي_بي(&ب, &عنوان_أ) مع
                    | نتيجة.خطأ(_) -> { أرجع 6; }
                    | نتيجة.نجح(_) -> { };
                    طابق اضبط_خيار_يو_دي_بي(&ب, خيار_مقبس.مهلة_استقبال(2000)) مع
                    | نتيجة.خطأ(_) -> { أرجع 7; }
                    | نتيجة.نجح(_) -> { };
                    دع الرسالة: متجه ط8 = [83, 117, 108, 116, 97, 110];
                    طابق أرسل_يو_دي_بي(&أ, &الرسالة, 0, 6) مع
                    | نتيجة.خطأ(_) -> { أرجع 8; }
                    | نتيجة.نجح(المرسل) -> { لو (المرسل != 6) { أرجع 9; }; };
                    دع المخزن: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
                    طابق استقبل_يو_دي_بي(&ب, &متغير المخزن, 0, 8) مع
                    | نتيجة.خطأ(_) -> { أرجع 10; }
                    | نتيجة.نجح(العدد) -> {
                        لو (العدد != 6) { أرجع 11; };
                        لو (المخزن[0] != 83 || المخزن[5] != 110) { أرجع 12; };
                    };
                    دع الرد: متجه ط8 = [33];
                    طابق أرسل_يو_دي_بي(&ب, &الرد, 0, 1) مع
                    | نتيجة.خطأ(_) -> { أرجع 13; }
                    | نتيجة.نجح(_) -> { };
                    دع الصغير: متغير متجه ط8 = [0];
                    طابق استقبل_يو_دي_بي(&أ, &متغير الصغير, 0, 1) مع
                    | نتيجة.خطأ(_) -> { أرجع 14; }
                    | نتيجة.نجح(العدد) -> { لو (العدد != 1 || الصغير[0] != 33) { أرجع 15; }; };
                    دع إغلاق_ب: نتيجة عدد, عدد = أغلق_يو_دي_بي(ب);
                };
                دع إغلاق_أ: نتيجة عدد, عدد = أغلق_يو_دي_بي(أ);
            };
        };
    };
    أرجع 42;
}
