// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/math_trigonometry.sn
// std.math.trigonometry مقارنة بقيم libm: الجيب وجيب التمام ضمن 4e-16
// (نسبيا) أو 1e-15 (مطلقا قرب الصفر)، والظل ضمن 1e-14، من الزوايا الصغيرة
// حتى 1.8e308 (اختزال باين-هانك)؛ وع32 ضمن 1e-6.
استورد std.math.trigonometry;
استورد std.math.float;

عرف قريب_اختبار(أ: ع64, ب: ع64, النسبي: ع64): منطقي {
    دع الفرق: ع64 = مطلق64(أ - ب);
    لو (الفرق <= النسبي * مطلق64(ب) || الفرق <= 1.0e-15) { أرجع صواب; };
    أرجع خطأ;
}

عرف افحص(س: ع64, ج: ع64, جت: ع64, ظ: ع64): عدد {
    دع الإخفاقات: متغير عدد = 0;
    لو (!قريب_اختبار(جيب64(س), ج, 4.0e-16)) { الإخفاقات := الإخفاقات + 1; };
    لو (!قريب_اختبار(جيب_تمام64(س), جت, 4.0e-16)) { الإخفاقات := الإخفاقات + 1; };
    لو (!قريب_اختبار(ظل64(س), ظ, 1.0e-14)) { الإخفاقات := الإخفاقات + 1; };
    أرجع الإخفاقات;
}

عرف قريب32_اختبار(أ: ع32, ب: ع32): منطقي {
    دع الفرق: ع32 = مطلق32(أ - ب);
    لو (الفرق <= 1.0e-6 * مطلق32(ب) || الفرق <= 1.0e-7) { أرجع صواب; };
    أرجع خطأ;
}

عرف افحص32(س: ع32, ج: ع32, جت: ع32, ظ: ع32): عدد {
    دع الإخفاقات: متغير عدد = 0;
    لو (!قريب32_اختبار(جيب32(س), ج)) { الإخفاقات := الإخفاقات + 1; };
    لو (!قريب32_اختبار(جيب_تمام32(س), جت)) { الإخفاقات := الإخفاقات + 1; };
    لو (!قريب32_اختبار(ظل32(س), ظ)) { الإخفاقات := الإخفاقات + 1; };
    أرجع الإخفاقات;
}

