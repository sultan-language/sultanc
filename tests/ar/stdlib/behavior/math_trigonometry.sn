    الإخفاقات := الإخفاقات + افحص32(-1.0, -0.8414709568023682, 0.5403022766113281, -1.5574077367782593);
    الإخفاقات := الإخفاقات + افحص32(2.0, 0.9092974066734314, -0.416146844625473, -2.185039758682251);
    الإخفاقات := الإخفاقات + افحص32(3.0, 0.14112000167369843, -0.9899924993515015, -0.14254654943943024);
    الإخفاقات := الإخفاقات + افحص32(10.0, -0.5440211296081543, -0.83907151222229, 0.6483608484268188);
