// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.arc: كل جولة تشارك مشتركا جديدا (سجلا مملوكا فيه نص) مع خيط مُطلَق
// يقرؤه عبر نسخته ويضيف إلى مجموع ذري مشترك عبر مشترك ثان. يُسقط الخيط إغلاقه،
// ومعه نسخته، حين ينتهي؛ وضمه يحرر بقيته. بعد 10^4 جولات تبقى البايتات الحية
// في المخصص كما كانت: حُررت كل قيمة مرة واحدة بالضبط. النظير:
// tests/en/stdlib/behavior/sync_arc_threads_rss_flat.sn. لا توجيه نظير: المفسر
// يشغل خيطا واحدا ولا يستعمل مخصص std.
استورد std.os.allocation;
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.thread.thread;

نوع مسمى = { الاسم: نص, المعرف: ط64 };

عرف أضف_الاسم(المشترك: &مشترك<مسمى>, المجموع: &مشترك<ذرة_ط64>): فراغ {
    دع س: &مسمى = اقرأ_مشترك(المشترك);
    دع الحجم: ط64 = (الطول((*س).الاسم) مثل ط64) + (*س).المعرف;
    دع قديم: ط64 = اجمع_واجلب_ط64(اقرأ_مشترك(المجموع), الحجم, ترتيب_ذاكرة.تسلسلي());
}

// النسخ التي يلتقطها الإغلاق تعيش في هذا الإطار حتى يعود.
عرف ابدأ_قارئا(المشترك: &مشترك<مسمى>, المجموع: &مشترك<ذرة_ط64>): اختياري مقبض_خيط {
    دع نسختي: مشترك<مسمى> = استنسخ_مشترك(المشترك);
    دع المجموع_لي: مشترك<ذرة_ط64> = استنسخ_مشترك(المجموع);
    طابق أطلق(دالة(): فراغ -> أضف_الاسم(&نسختي, &المجموع_لي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف جولة(ف: ط64, المجموع: &مشترك<ذرة_ط64>): منطقي {
    دع القيمة: مسمى = { الاسم: «مشترك بين الخيوط», المعرف: ف };
    دع المشترك: مشترك<مسمى> = أنشئ_مشترك(القيمة);
    طابق ابدأ_قارئا(&المشترك, المجموع) مع
    | اختياري.موجود(م) -> {
        دع المقبض: متغير مقبض_خيط = م;
        انضم(&متغير المقبض);
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    // ذهبت نسخة الخيط: هذا المقبض هو الأخير.
    أرجع عدد_مراجع_مشترك(&المشترك) == 1;
}

عرف الرئيسية(): ص32 {
    دع المجموع: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));
    لو (!جولة(0 مثل ط64, &المجموع)) { أرجع 1; };
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع ف: متغير ط64 = 1;
    طالما (ف <= (10000 مثل ط64)) {
        لو (!جولة(ف, &المجموع)) { أرجع 2; };
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    لو (بعد != قبل) { أرجع 3; };
    // طول النص 30 بايتا في كل جولة، والمعرفات 0..10^4.
    دع المتوقع: ط64 = (30 مثل ط64) * (10001 مثل ط64) + (50005000 مثل ط64);
    لو (احمل_ط64(اقرأ_مشترك(&المجموع), ترتيب_ذاكرة.تسلسلي()) != المتوقع) { أرجع 4; };
    أرجع 0;
}
