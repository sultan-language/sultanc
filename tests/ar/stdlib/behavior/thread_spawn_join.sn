// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.thread: إطلاق عدة خيوط وضمها. يخزن كل منها العلامة نفسها في خلية ذرية
// واحدة مشتركة عبر مشترك (std.sync)، فلا تسابق؛ بعد الضم تكون الكتابة مرئية
// (CLONE_VM)، وقد أسقط كل خيط نسخته من المشترك. يتحقق هذا من استنساخ الخيط
// وتشغيل الإغلاق والضم بالمستقبل (docs/en/reference/concurrency.md) وتحرير إغلاق الخيط
// المنتهي. النظير: tests/en/stdlib/behavior/thread_spawn_join.sn. لا توجيه
// نظير: المفسر يشغل خيطا واحدا.
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;

عرف اكتب_العلامة(الخلية: &مشترك<ذرة_ط64>): فراغ {
    اخزن_ط64(اقرأ_مشترك(الخلية), 777 مثل ط64, ترتيب_ذاكرة.تسلسلي());
}

عرف ابدأ(الخلية: &مشترك<ذرة_ط64>): اختياري مقبض_خيط {
    دع نسختي: مشترك<ذرة_ط64> = استنسخ_مشترك(الخلية);
    طابق أطلق(دالة(): فراغ -> اكتب_العلامة(&نسختي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع الخلية: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));
    دع مقابض: متغير متجه مقبض_خيط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        طابق ابدأ(&الخلية) مع
        | اختياري.موجود(م) -> { ألحق(مقابض, م); }
        | اختياري.لا_شيء -> { أرجع 1; };
        ف := ف + 1;
    }
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(مقابض) مثل طبيعي)) { انضم(&متغير مقابض[ق]); ق := ق + 1; }
    إذا (احمل_ط64(اقرأ_مشترك(&الخلية), ترتيب_ذاكرة.تسلسلي()) != (777 مثل ط64)) { أرجع 2; };
    إذا (عدد_مراجع_مشترك(&الخلية) != 1) { أرجع 3; };
    أرجع 0;
}
