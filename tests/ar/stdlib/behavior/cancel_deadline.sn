// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/cancel_deadline.sn
// رموز الإلغاء (std.sync.cancel) ومهل الطلبات (std.http.deadline): الإلغاء
// الصريح يصل إلى النسخ، والمهلة تنقضي بعد زمنها، والخدمة التي تتجاوز مهلتها
// تُجاب بـ 503 مع «connection: close»، والتي تنتهي قبلها تُجاب بردها.
استورد std.sync.cancel;
استورد std.time.time;
استورد std.http.model;
استورد std.http.headers;
استورد std.http.deadline;
استورد std.text.from_bytes;

نوع حالة = { التأخير: عدد };

عرف خدمة(الحالة: &حالة, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    إذا ((*الحالة).التأخير > 0) { دع ن: نتيجة عدد, عدد = نم_نانو((*الحالة).التأخير); };
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الاستجابة: استجابة_ويب_مخزنة = {
        الإصدار: إصدار_ويب.واحد_واحد(), الحالة: 200, الرؤوس: الرؤوس, الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم
    };
    أرجع الاستجابة;
}

عرف طلب_فارغ(): طلب_ويب_مخزن {
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الطلب: طلب_ويب_مخزن = {
        الطريقة: «GET», الهدف: «/», الإصدار: إصدار_ويب.واحد_واحد(), الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم, العنوان_البعيد: «», السياق: سياق_طلب_ويب_فارغ()
    };
    أرجع الطلب;
}

عرف الرئيسية(): عدد {
    دع أ: رمز_إلغاء = أنشئ_رمز_إلغاء();
    دع ب: رمز_إلغاء = استنسخ_رمز_إلغاء(&أ);
    إذا (هل_ألغي_الرمز(&ب)) { أرجع 1; };
    ألغ_الرمز(&أ);
    إذا (!هل_ألغي_الرمز(&ب)) { أرجع 2; };

    دع م: رمز_إلغاء = رمز_إلغاء_بمهلة(20);
    إذا (هل_ألغي_الرمز(&م)) { أرجع 3; };
    دع ن: نتيجة عدد, عدد = نم_نانو(40000000);
    إذا (!هل_ألغي_الرمز(&م)) { أرجع 4; };

    دع بطيئة: حالة = { التأخير: 40000000 };
    دع ط1: متغير طلب_ويب_مخزن = طلب_فارغ();
    دع ر1: استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(&بطيئة, خدمة, &متغير ط1, 10);
    إذا (ر1.الحالة != 503) { أرجع 5; };
    إذا (!هل_ألغي_الطلب_ويب(&ط1)) { أرجع 6; };

    دع سريعة: حالة = { التأخير: 0 };
    دع ط2: متغير طلب_ويب_مخزن = طلب_فارغ();
    دع ر2: استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(&سريعة, خدمة, &متغير ط2, 5000);
    إذا (ر2.الحالة != 200) { أرجع 7; };
    طابق المتبقي_لمهلة_الطلب_بالمللي(&ط2) مع
    | اختياري.لا_شيء -> { أرجع 8; }
    | اختياري.موجود(الباقي) -> { إذا (الباقي <= 0) { أرجع 9; }; };
    أرجع 0;
}
