// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/json_escape.sn
// يكتب std.json.escape شرطة مائلة واحدة لكل هروب JSON، ويكتب نمط التشخيص
// U+FFFD مكان كل بايت ليس UTF-8 صالحا، فالناتج JSON صالح في النمطين.
// الناتج المتوقع مكتوب بايتات حتى لا تدخل فيه قاعدة هروب الحرفيات.
استورد std.json.escape;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف بايتات_متطابقة(الفعلي: &متجه ط8, المتوقع: &متجه ط8): منطقي {
    دع أ: نص = من_بايتات(الفعلي);
    دع م: نص = من_بايتات(المتوقع);
    أرجع نصان_متساويان(&أ, &م);
}

عرف الرئيسية(): عدد {
    // a " \ LF BS 0x01 س z
    دع بايتات_سليمة: متجه ط8 = [0x61, 0x22, 0x5C, 0x0A, 0x08, 0x01, 0xD8, 0xB3, 0x7A];
    دع سليم: نص = من_بايتات(&بايتات_سليمة);

    // "a\"\\\n\b\u0001سz"
    دع متوقع_المستند: متجه ط8 = [
        0x22, 0x61, 0x5C, 0x22, 0x5C, 0x5C, 0x5C, 0x6E, 0x5C, 0x62,
        0x5C, 0x75, 0x30, 0x30, 0x30, 0x31, 0xD8, 0xB3, 0x7A, 0x22
    ];
    دع ناتج_المستند: متغير متجه ط8 = [];
    إذا (!ألحق_سلسلة_جسون(&متغير ناتج_المستند, &سليم)) { أرجع 1; };
    إذا (!بايتات_متطابقة(&ناتج_المستند, &متوقع_المستند)) { أرجع 2; };

    // "a\"\\\n\u0008\u0001سz": لا \b قصيرة في نمط التشخيص.
    دع متوقع_التشخيص: متجه ط8 = [
        0x22, 0x61, 0x5C, 0x22, 0x5C, 0x5C, 0x5C, 0x6E, 0x5C, 0x75,
        0x30, 0x30, 0x30, 0x38, 0x5C, 0x75, 0x30, 0x30, 0x30, 0x31,
        0xD8, 0xB3, 0x7A, 0x22
    ];
    دع ناتج_التشخيص: متغير متجه ط8 = [];
    إذا (!ألحق_سلسلة_جسون_بنمط(&متغير ناتج_التشخيص, &سليم, نمط_هروب_سلسلة_جسون.تشخيص())) { أرجع 3; };
    إذا (!بايتات_متطابقة(&ناتج_التشخيص, &متوقع_التشخيص)) { أرجع 4; };

    // x 0xFF y 0xE2 0x82: بايت شارد وتسلسل ثلاثي مبتور.
    دع بايتات_معطوبة: متجه ط8 = [0x78, 0xFF, 0x79, 0xE2, 0x82];
    دع معطوب: نص = من_بايتات(&بايتات_معطوبة);

    دع مرفوض: متغير متجه ط8 = [];
    إذا (ألحق_سلسلة_جسون(&متغير مرفوض, &معطوب)) { أرجع 5; };

    // "x<FFFD>y<FFFD><FFFD>": بديل واحد لكل بايت معطوب.
    دع متوقع_البديل: متجه ط8 = [
        0x22, 0x78, 0xEF, 0xBF, 0xBD, 0x79,
        0xEF, 0xBF, 0xBD, 0xEF, 0xBF, 0xBD, 0x22
    ];
    دع البديل: متغير متجه ط8 = [];
    إذا (!ألحق_سلسلة_جسون_بنمط(&متغير البديل, &معطوب, نمط_هروب_سلسلة_جسون.تشخيص())) { أرجع 6; };
    إذا (!بايتات_متطابقة(&البديل, &متوقع_البديل)) { أرجع 7; };
    أرجع 42;
}
