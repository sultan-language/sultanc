// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/path_relative.sn
// مسار_نسبي_من في std.fs.path: المسار اللفظي من دليل إلى هدف (os.path.relpath
// في Python وpathdiff::diff_paths في Rust). لا ناتج عند اختلاف الجذر أو
// القرص، ولا عند بقاء ".." من الأصل بعد الجزء المشترك.
استورد std.fs.path;
استورد std.text.compare;

عرف النسبي_هو(الأصل: نص, الهدف: نص, الصيغة: صيغة_مسار, المتوقع: نص): منطقي {
    طابق مسار_نسبي_من_بصيغة(&الأصل, &الهدف, الصيغة) مع
    | اختياري.موجود(المسار) -> { أرجع نصان_متساويان(&المسار, &المتوقع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف لا_نسبي(الأصل: نص, الهدف: نص, الصيغة: صيغة_مسار): منطقي {
    طابق مسار_نسبي_من_بصيغة(&الأصل, &الهدف, الصيغة) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

عرف الرئيسية(): عدد {
    دع يونكس: صيغة_مسار = صيغة_مسار.يونكس();
    دع ويندوز: صيغة_مسار = صيغة_مسار.ويندوز();
    إذا (!النسبي_هو(«/src/app», «/src/include/x.h», يونكس, «../include/x.h»)) { أرجع 1; };
    إذا (!النسبي_هو(«/src/app», «/src/app», يونكس, «.»)) { أرجع 2; };
    إذا (!النسبي_هو(«/src/app», «/src/app/lib/y.h», يونكس, «lib/y.h»)) { أرجع 3; };
    // يطبع الطرفان أولا: تزول "." والفواصل المكررة.
    إذا (!النسبي_هو(«src/./app//», «src/x.h», يونكس, «../x.h»)) { أرجع 4; };
    إذا (!النسبي_هو(«/a/b/c», «/d», يونكس, «../../../d»)) { أرجع 5; };
    // ".." المشتركة مقبولة، أما الباقية في الأصل فلا.
    إذا (!النسبي_هو(«../up», «../other/z», يونكس, «../other/z»)) { أرجع 6; };
    إذا (!لا_نسبي(«src/../app», «src/x», يونكس)) { أرجع 7; };
    // جذران مختلفان.
    إذا (!لا_نسبي(«/src», «src», يونكس)) { أرجع 8; };
    إذا (!لا_نسبي(«src», «/src», يونكس)) { أرجع 9; };
    // ويندوز: الفاصلان كلاهما، ويجب أن تتطابق بادئتا القرص (النص بين «» حرفي).
    إذا (!النسبي_هو(«C:\work\app», «C:/work/lib/m.h», ويندوز, «..\lib\m.h»)) { أرجع 10; };
    إذا (!لا_نسبي(«C:\work», «D:\work», ويندوز)) { أرجع 11; };
    إذا (!لا_نسبي(«C:work», «C:\work», ويندوز)) { أرجع 12; };
    // صيغة المضيف.
    دع هنا: نص = «a/b»;
    طابق مسار_نسبي_من(&هنا, &هنا) مع
    | اختياري.موجود(المسار) -> { دع نقطة: نص = «.»; إذا (!نصان_متساويان(&المسار, &نقطة)) { أرجع 13; }; }
    | اختياري.لا_شيء -> { أرجع 14; };
    أرجع 42;
}
