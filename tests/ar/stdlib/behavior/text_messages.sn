// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/text_messages.sn
// فهارس الرسائل (std.text.messages): رسالة بلغة القارئ مع الرجوع من ar-SA إلى
// ar ثم إلى اللغة الافتراضية، ووسائط مسماة، وصيغ الجمع العربية الست والإنجليزية
// الاثنتان، وعزل اتجاه الوسيطة اللاتينية داخل جملة عربية.
استورد std.text.messages;
استورد std.text.language;
استورد std.text.compare;
استورد std.text.bidi;
استورد std.text.from_bytes;

عرف ثلاثة(أ: نص, ب: نص, ج: نص): نص {
    دع الناتج: متغير متجه ط8 = بايتات_من_نص(أ);
    ألحق_بايتات_نص(&متغير الناتج, ب);
    ألحق_بايتات_نص(&متغير الناتج, ج);
    أرجع الناتج مثل نص;
}

عرف الرئيسية(): عدد {
    دع الفهرس: متغير فهرس_رسائل = أنشئ_فهرس_رسائل(&«en»);
    أضف_رسالة(&متغير الفهرس, &«required», &«en», &«The field {field} is required»);
    أضف_رسالة(&متغير الفهرس, &«required», &«ar», &«الحقل {field} مطلوب»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.صفر(), &«لا عناصر»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.واحد(), &«عنصر واحد»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.اثنان(), &«عنصران»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.قليل(), &«{count} عناصر»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.كثير(), &«{count} عنصرًا»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«ar», صنف_جمع.آخر(), &«{count} عنصر»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«en», صنف_جمع.واحد(), &«{count} item»);
    أضف_صيغة_رسالة(&متغير الفهرس, &«items», &«en», صنف_جمع.آخر(), &«{count} items»);

    دع عربية: لغة = لغة_من_قبول_اللغة(&«ar-SA, en;q=0.5»);
    دع فرنسية: لغة = لغة_من_وسم(&«fr»);
    دع الوسائط: متغير متجه وسيطة_رسالة = [];
    ألحق(الوسائط, وسيطة(«field», «الاسم»));
    طابق رسالة_بلغة(&الفهرس, &عربية, &«required», &الوسائط) مع
    | اختياري.موجود(ن) -> { إذا (!نصان_متساويان(&ن, &«الحقل الاسم مطلوب»)) { أرجع 1; }; }
    | اختياري.لا_شيء -> { أرجع 2; };
    دع لاتينية: متغير متجه وسيطة_رسالة = [];
    ألحق(لاتينية, وسيطة(«field», «email»));
    طابق رسالة_بلغة(&الفهرس, &عربية, &«required», &لاتينية) مع
    | اختياري.موجود(ن) -> {
        دع المتوقع: نص = ثلاثة(«الحقل », اعزل_اتجاه(&«email»), « مطلوب»);
        إذا (!نصان_متساويان(&ن, &المتوقع)) { أرجع 3; };
    }
    | اختياري.لا_شيء -> { أرجع 4; };
    طابق رسالة_بلغة(&الفهرس, &فرنسية, &«required», &لاتينية) مع
    | اختياري.موجود(ن) -> { إذا (!نصان_متساويان(&ن, &«The field email is required»)) { أرجع 5; }; }
    | اختياري.لا_شيء -> { أرجع 6; };

    دع بلا: متجه وسيطة_رسالة = [];
    دع المتوقعة: متجه نص = [«لا عناصر», «عنصر واحد», «عنصران», «5 عناصر», «11 عنصرًا», «100 عنصر»];
    دع الأعداد: متجه عدد = [0, 1, 2, 5, 11, 100];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 6) {
        طابق رسالة_بعدد(&الفهرس, &عربية, &«items», الأعداد[ف], &بلا) مع
        | اختياري.موجود(ن) -> { إذا (!نصان_متساويان(&ن, &المتوقعة[ف])) { أرجع 10 + (ف مثل عدد); }; }
        | اختياري.لا_شيء -> { أرجع 20; };
        ف := ف + 1;
    }
    طابق رسالة_بعدد(&الفهرس, &فرنسية, &«items», 1, &بلا) مع
    | اختياري.موجود(ن) -> { إذا (!نصان_متساويان(&ن, &«1 item»)) { أرجع 21; }; }
    | اختياري.لا_شيء -> { أرجع 22; };
    طابق رسالة_بلغة(&الفهرس, &عربية, &«missing», &بلا) مع
    | اختياري.موجود(_) -> { أرجع 23; }
    | اختياري.لا_شيء -> { };
    أرجع 0;
}
