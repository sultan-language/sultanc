// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// توليد المعرفات الفريدة: الإصداران 4 و7 يحملان رقم الإصدار وبديل RFC،
// ومعرفان عشوائيان مختلفان، والزمني لا يرجع إلى الوراء.
استورد std.uuid.uuid;
استورد std.uuid.generate;

عرف الرئيسية(): عدد {
    طابق معرف_فريد_عشوائي() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الأول) -> {
        إذا (إصدار_معرف_فريد(&الأول) != 4) { أرجع 2; };
        طابق بديل_معرف_فريد(&الأول) مع
        | بديل_معرّف_فريد.آي_إي_تي_إف -> { }
        | _ -> { أرجع 3; };
        طابق معرف_فريد_عشوائي() مع
        | نتيجة.خطأ(_) -> { أرجع 4; }
        | نتيجة.نجح(الثاني) -> { إذا (معرفان_فريدان_متساويان(&الأول, &الثاني)) { أرجع 5; }; };
    };
    طابق معرف_فريد_زمني() مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(المبكر) -> {
        إذا (إصدار_معرف_فريد(&المبكر) != 7) { أرجع 7; };
        طابق معرف_فريد_زمني() مع
        | نتيجة.خطأ(_) -> { أرجع 8; }
        | نتيجة.نجح(المتأخر) -> {
            دع أ: متجه ط8 = بايتات_معرف_فريد(&المبكر);
            دع ب: متجه ط8 = بايتات_معرف_فريد(&المتأخر);
            دع ف: متغير طبيعي = 0;
            دع حسم: متغير منطقي = خطأ;
            طالما (ف < 6 && !حسم) {
                إذا (أ[ف] < ب[ف]) { حسم := صواب; }
                وإلا إذا (أ[ف] > ب[ف]) { أرجع 9; };
                ف := ف + 1;
            }
        };
    };
    أرجع 42;
}
