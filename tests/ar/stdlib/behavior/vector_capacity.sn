// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/vector_capacity.sn
// سعة المتجه كما يحفظها Vec في Rust: سعة واحجز_سعة ومتجه_بسعة واحجز_في_المتجه
// وقلص_المتجه؛ واقتطع(م, 0) وأزل_الأخير حتى الفراغ وامسح_المتجه تحتفظ بالمخزن
// الذي تعيد الإلحاقات التالية استعماله؛ على أعداد وعلى نصوص مملوكة. تُبلغ
// الشفرة الأصلية والمفسر عن السعات نفسها.
استورد std.collections.vector;
استورد std.text.number;

عرف الرئيسية(): عدد {
    دع empty: متجه عدد = [];
    لو (سعة(empty) != 0) { أرجع 1; };
    دع v: متغير متجه عدد = متجه_بسعة(10);
    لو (سعة(v) != 10 || الطول(v) != 0) { أرجع 2; };
    دع i: متغير عدد = 0;
    طالما (i < 10) { ألحق(v, i); i := i + 1; }
    لو (سعة(v) != 10) { أرجع 3; };
    ألحق(v, 10);
    لو (سعة(v) < 11) { أرجع 4; };
    اقتطع(v, 0);
    لو (الطول(v) != 0 || سعة(v) < 11) { أرجع 5; };
    ألحق(v, 7);
    لو (v[0] != 7 || سعة(v) < 11) { أرجع 6; };
    قلص_المتجه(&متغير v);
    لو (سعة(v) != 1 || v[0] != 7) { أرجع 7; };
    احجز_سعة(v, 4);
    لو (سعة(v) != 5) { أرجع 8; };
    احجز_في_المتجه(&متغير v, 20);
    لو (سعة(v) < 21) { أرجع 9; };
    دع before: عدد = سعة(v);
    احجز_في_المتجه(&متغير v, 2);
    لو (سعة(v) != before) { أرجع 10; };
    أزل_الأخير(v);
    لو (الطول(v) != 0 || سعة(v) != before) { أرجع 11; };
    قلص_المتجه(&متغير v);
    لو (سعة(v) != 0) { أرجع 12; };

    دع words: متغير متجه نص = [];
    احجز_سعة(words, 3);
    ألحق(words, عدد_إلى_نص(123));
    ألحق(words, عدد_إلى_نص(45));
    ألحق(words, عدد_إلى_نص(6));
    لو (سعة(words) != 3) { أرجع 13; };
    امسح_المتجه(&متغير words);
    لو (الطول(words) != 0 || سعة(words) != 3) { أرجع 14; };
    ألحق(words, عدد_إلى_نص(78));
    ألحق(words, عدد_إلى_نص(9));
    قلص_المتجه(&متغير words);
    لو (سعة(words) != 2 || الطول(words[0]) != 2 || الطول(words[1]) != 1) { أرجع 15; };
    دع literal: متغير متجه عدد = [1, 2, 3];
    لو (سعة(literal) < 3) { أرجع 16; };
    أرجع 42;
}
