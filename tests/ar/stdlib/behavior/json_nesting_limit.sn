// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/json_nesting_limit.sn
// محللا JSON وTOML تعاوديان: التعشيش بعد الحد خطأ وليس فيض مكدس.
استورد std.json.parse;
استورد std.json.value;
استورد std.toml.parser;
استورد std.text.from_bytes;

عرف متداخل(الفتح: ط8, الإغلاق: ط8, العمق: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العمق) { ألحق(البايتات, الفتح); ف := ف + 1; }
    ف := 0;
    طالما (ف < العمق) { ألحق(البايتات, الإغلاق); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عرف الرئيسية(): عدد {
    دع العميق: نص = متداخل(0x5B, 0x5D, 600);
    طابق حلل_جسون(&العميق) مع
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ.الصنف مع
        | صنف_خطأ_جسون.تعشيش_عميق_جدا -> { }
        | _ -> { أرجع 2; };
    };
    دع عند_الحد: نص = متداخل(0x5B, 0x5D, حد_تعشيش_جسون());
    طابق حلل_جسون(&عند_الحد) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> { };
    دع بعد_الحد: نص = متداخل(0x5B, 0x5D, حد_تعشيش_جسون() + 1);
    طابق حلل_جسون(&بعد_الحد) مع
    | نتيجة.نجح(_) -> { أرجع 4; }
    | نتيجة.خطأ(_) -> { };
    دع بايتات_تومل: متغير متجه ط8 = [];
    دع البادئة: نص = «a = »;
    ألحق_بايتات_نص(&متغير بايتات_تومل, البادئة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 600) { ألحق(بايتات_تومل, 0x5B); ف := ف + 1; }
    دع تومل_عميق: نص = من_بايتات(&بايتات_تومل);
    طابق حلل_تومل(&تومل_عميق) مع
    | نتيجة.نجح(_) -> { أرجع 5; }
    | نتيجة.خطأ(_) -> { };
    أرجع 42;
}
