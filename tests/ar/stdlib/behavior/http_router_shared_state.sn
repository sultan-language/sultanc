// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http_router_shared_state.sn
// الموجه يوجه عبر مرجعه (بند نهر 1): عداد ذري في حالة الموجه يعد كل طلب
// لأن الحالة لا تنسخ لكل طلب. ويضاف رأس Date للخادم (البند 18) مرة واحدة
// بصيغة IMF-fixdate (29 بايتًا)، ويبقى Date الذي وضعته الخدمة.
استورد std.http.model;
استورد std.http.headers;
استورد std.http.body;
استورد std.http.router;
استورد std.http.http1.request_parser;
استورد std.http.http1.connection;
استورد std.http.limits;
استورد std.sync.atomic;

عام نوع حالة_التطبيق = { الزيارات: ذرة_ط64 };

عرف زر(الحالة: &حالة_التطبيق, الطلب: &طلب_ويب_مخزن, المعاملات: &معاملات_مسار_ويب): استجابة_ويب_مخزنة {
    دع قبل: ط64 = اجمع_واجلب_ط64(&(*الحالة).الزيارات, 1, ترتيب_ذاكرة.تسلسلي());
    دع الجسم: نص = «ok»;
    أرجع استجابة_نص_ويب(200, &الجسم);
}

عرف الرئيسية(): عدد {
    دع الحالة: حالة_التطبيق = { الزيارات: أنشئ_ذرة_ط64(0) };
    دع الموجه: متغير موجه_ويب<حالة_التطبيق> = موجه_ويب_جديد(الحالة);
    دع النمط: نص = «/hit»;
    طابق أضف_مسار_get_ويب(&متغير الموجه, &النمط, زر) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> {};
    دع الخام: متجه ط8 = [71, 69, 84, 32, 47, 104, 105, 116, 32, 72, 84, 84, 80, 47, 49, 46, 49, 13, 10, 104, 111, 115, 116, 58, 32, 97, 13, 10, 13, 10];
    دع الحدود: حدود_ويب = حدود_ويب_افتراضية();
    طابق حلل_طلب_ويب1(&الخام, &الحدود) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(المحلل) -> {
        دع ر1: متغير استجابة_ويب_مخزنة = وجه_طلب_ويب(&الموجه, &المحلل.الطلب);
        دع ر2: استجابة_ويب_مخزنة = وجه_طلب_ويب(&الموجه, &المحلل.الطلب);
        إذا (ر1.الحالة != 200 || ر2.الحالة != 200) { أرجع 3; };
        إذا (احمل_ط64(&الموجه.الحالة.الزيارات, ترتيب_ذاكرة.تسلسلي()) != 2) { أرجع 4; };
        أضف_تاريخ_استجابة_خادم_ويب(&متغير ر1);
        أضف_تاريخ_استجابة_خادم_ويب(&متغير ر1);
        دع اسم_التاريخ: نص = «date»;
        دع التواريخ: متجه نص = قيم_رأس_ويب(&ر1.الرؤوس, &اسم_التاريخ);
        إذا ((الطول(التواريخ) مثل طبيعي) != 1) { أرجع 5; };
        إذا ((الطول(التواريخ[0]) مثل طبيعي) != 29) { أرجع 6; };
    };
    أرجع 0;
}
