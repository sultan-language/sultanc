// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// النظير: tests/en/stdlib/behavior/thread_slots.sn
// بلا توجيه زوج: المفسر يشغل خيط نظام واحدا ويتوقف عند الإطلاق.
// std.thread: يطلق البرنامج ثمانية خيوط، يكتب كل منها في خانته من متجه مشترك
// (مشترك Arc من ذرات، std.sync) قيمة تخصه، ثم يضمها جميعا ويتحقق من كل
// خانة. لكل خانة كاتب واحد، والكتابة ذرية. يكتب كل خيط أيضا معرفه
// (معرف_الخيط_الحالي) في خانة ثانية، فيتحقق البرنامج من أنه معرف المقبض
// نفسه وأنه يختلف عن معرف الخيط الرئيسي، ومن أن كل خيط أفلت نسخته من
// المشترك حين انتهى.
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;

نوع خانات = { القيم: متجه ذرة_ط64, المعرفات: متجه ذرة_ط64 };

عرف اكتب_خانة(الخانات: &مشترك<خانات>, الموضع: طبيعي): فراغ {
    دع القيمة: ط64 = ((الموضع * الموضع) + 1) مثل ط64;
    دع م: &خانات = اقرأ_مشترك(الخانات);
    اخزن_ط64(&(*م).القيم[الموضع], القيمة, ترتيب_ذاكرة.تسلسلي());
    اخزن_ط64(&(*م).المعرفات[الموضع], معرف_الخيط_الحالي(), ترتيب_ذاكرة.تسلسلي());
}

عرف ابدأ(الخانات: &مشترك<خانات>, الموضع: طبيعي): اختياري مقبض_خيط {
    دع نسختي: مشترك<خانات> = استنسخ_مشترك(الخانات);
    طابق أطلق(دالة(): فراغ -> اكتب_خانة(&نسختي, الموضع)) مع
    | نتيجة.نجح(المقبض) -> { أرجع اختياري.موجود(المقبض); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع العدد: طبيعي = 8;
    دع القيم: متغير متجه ذرة_ط64 = [];
    دع المعرفات: متغير متجه ذرة_ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(القيم, أنشئ_ذرة_ط64(0));
        ألحق(المعرفات, أنشئ_ذرة_ط64(0));
        ف := ف + 1;
    }
    دع الابتدائية: خانات = { القيم: القيم, المعرفات: المعرفات };
    دع الخانات: مشترك<خانات> = أنشئ_مشترك(الابتدائية);

    دع مقابض: متغير متجه مقبض_خيط = [];
    ف := 0;
    طالما (ف < العدد) {
        طابق ابدأ(&الخانات, ف) مع
        | اختياري.موجود(المقبض) -> { ألحق(مقابض, المقبض); }
        | اختياري.لا_شيء -> { أرجع 1; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < العدد) { انضم(&متغير مقابض[ف]); ف := ف + 1; }

    دع الرئيسي: ط64 = معرف_الخيط_الحالي();
    دع م: &خانات = اقرأ_مشترك(&الخانات);
    ف := 0;
    طالما (ف < العدد) {
        دع القيمة: ط64 = احمل_ط64(&(*م).القيم[ف], ترتيب_ذاكرة.تسلسلي());
        دع المعرف: ط64 = احمل_ط64(&(*م).المعرفات[ف], ترتيب_ذاكرة.تسلسلي());
        إذا (القيمة != (((ف * ف) + 1) مثل ط64)) { أرجع 2; };
        إذا (المعرف != معرف_المقبض(&مقابض[ف])) { أرجع 3; };
        إذا (المعرف == الرئيسي) { أرجع 4; };
        ف := ف + 1;
    }
    إذا (عدد_مراجع_مشترك(&الخانات) != 1) { أرجع 5; };
    أرجع 42;
}
