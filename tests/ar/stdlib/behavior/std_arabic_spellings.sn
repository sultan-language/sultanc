// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// الكتابات العربية لحزم المكتبة القياسية process وenv وcrypto وtoml
// وcollections وversion (تصريحات `وحدة` في library/std/std.sn):
// تُستورد كل حزمة بكتابتها العربية، ويُستعمل منها شيء واحد.
استورد المكتبة.عمليات.id;
استورد المكتبة.بيئة.variables;
استورد المكتبة.بيئة.environment;
استورد المكتبة.تشفير.sha256;
استورد المكتبة.تومل.parser;
استورد المكتبة.مجموعات.vector;
استورد المكتبة.إصدار.semver;
استورد المكتبة.نصوص.compare;

عرف الرئيسية(): عدد {
    // المكتبة.عمليات (std.process)
    إذا (معرف_العملية() == 0) { أرجع 1; };

    // المكتبة.بيئة (std.env)
    دع الاسم: نص = «SULTANC_ARABIC_SPELLING_TEST»;
    دع القيمة: نص = «نعم»;
    طابق اضبط_متغير_بيئة(&الاسم, &القيمة) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> { };
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(المقروء)) -> {
        إذا (!نصان_متساويان(&المقروء, &القيمة)) { أرجع 3; };
    }
    | _ -> { أرجع 4; };

    // المكتبة.تشفير (std.crypto): SHA-256("abc") يبدأ بـ ba 78 16 bf.
    دع الرسالة: متجه ط8 = [97, 98, 99];
    دع البصمة: متجه ط8 = شا256(&الرسالة);
    إذا ((الطول(البصمة) مثل طبيعي) != 32) { أرجع 5; };
    إذا (البصمة[0] != 0xBA || البصمة[1] != 0x78 || البصمة[2] != 0x16 || البصمة[3] != 0xBF) { أرجع 6; };

    // المكتبة.تومل (std.toml)
    دع المصدر: نص = "name = \"سلطان\"\n";
    دع المفتاح: نص = «name»;
    دع المتوقع: نص = «سلطان»;
    طابق حلل_تومل(&المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الوثيقة) -> {
        طابق قيمة_مفتاح_تومل(&الوثيقة, 0, &المفتاح) مع
        | اختياري.موجود(قيمة_تومل.سلسلة(س)) -> {
            إذا (!نصان_متساويان(&س, &المتوقع)) { أرجع 8; };
        }
        | _ -> { أرجع 9; };
    };

    // المكتبة.مجموعات (std.collections)
    دع القيم: متغير متجه عدد = [1, 2, 3];
    اعكس_المتجه(&متغير القيم);
    إذا (القيم[0] != 3 || القيم[2] != 1) { أرجع 10; };

    // المكتبة.إصدار (std.version)
    دع نص_الإصدار: نص = «1.4.2-beta»;
    طابق حلل_إصدارا_دلاليا(&نص_الإصدار) مع
    | نتيجة.خطأ(_) -> { أرجع 11; }
    | نتيجة.نجح(الإصدار) -> {
        إذا (الإصدار.الرئيسي != 1 || الإصدار.الثانوي != 4 || الإصدار.التصحيح != 2) { أرجع 12; };
    };

    أرجع 42;
}
