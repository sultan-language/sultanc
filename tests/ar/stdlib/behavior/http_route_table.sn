// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/http_route_table.sn
// جداول المسارات المبنية وقت الترجمة (std.http.route_table): بناء الجدول
// ومطابقته يجريان داخل comptime، فأي خطأ يفشل الترجمة: مقطع ثابت، ومعامل
// والتقاطه، وتفضيل الثابت على المعامل، والتراجع إلى المعامل، والتقاط الباقي،
// ومسار لا يطابق، وطول استجابة ثابتة مسلسلة.
استورد std.http.route_table;
استورد std.meta.reflect;

عرف تحقق(): عدد {
    دع الجدول: متجه عدد = ابن_جدول_مسارات([«/», «/users/{id}», «/users/me», «/users/{id}/posts», «/files/{*path}»]);
    دع ل: متغير متجه عدد = [];
    طابق طابق_جدول_مسارات(&الجدول, &«/», &متغير ل) مع | اختياري.موجود(0) -> { } | _ -> { فشل_وقت_الترجمة(«root»); };
    طابق طابق_جدول_مسارات(&الجدول, &«/users/42», &متغير ل) مع | اختياري.موجود(1) -> { } | _ -> { فشل_وقت_الترجمة(«param»); };
    إذا (ل[0] != 7 || ل[1] != 2) { فشل_وقت_الترجمة(«capture»); };
    طابق طابق_جدول_مسارات(&الجدول, &«/users/me», &متغير ل) مع | اختياري.موجود(2) -> { } | _ -> { فشل_وقت_الترجمة(«static»); };
    طابق طابق_جدول_مسارات(&الجدول, &«/users/me/posts», &متغير ل) مع | اختياري.موجود(3) -> { } | _ -> { فشل_وقت_الترجمة(«backtrack»); };
    طابق طابق_جدول_مسارات(&الجدول, &«/files/a/b.txt», &متغير ل) مع | اختياري.موجود(4) -> { } | _ -> { فشل_وقت_الترجمة(«rest»); };
    إذا (ل[0] != 7 || ل[1] != 7) { فشل_وقت_الترجمة(«rest capture»); };
    طابق طابق_جدول_مسارات(&الجدول, &«/nope», &متغير ل) مع | اختياري.لا_شيء -> { } | _ -> { فشل_وقت_الترجمة(«miss»); };
    دع ر: متجه ط8 = بايتات_استجابة_ثابتة_ويب1(200, «OK», «text/plain», «hi»);
    إذا ((الطول(ر) مثل عدد) != 66) { فشل_وقت_الترجمة(«fixed»); };
    أرجع 42;
}

عرف الرئيسية(): عدد {
    دع ن: عدد = comptime { تحقق() };
    // The same checks at run time.
    أرجع تحقق() + ن - 42;
}
