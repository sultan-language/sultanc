// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// الخطوات نفسها على مستطلع io_uring (أنشئ_مستطلع_حلقي؛ epoll إن رفضت النواة io_uring).
// std.os.poll عبر TCP المحلي في خيط واحد: عميل يتصل فيصير المستمع غير الحاصر
// قابلا للقراءة (الرمز 0)؛ يُسلَّح التدفق المقبول لمرة واحدة بالرمز 7 فيصير
// قابلا للقراءة حين يكتب العميل؛ بعد الحدث يبقى منزوع السلاح (ينتهي الانتظار
// بلا حدث) حتى يعاد تسليحه للكتابة، وهي متاحة فورا لمقبس خامل؛ والقراءة بلا
// بيانات تجيب «سيحظر». النظير: tests/en/stdlib/behavior/os_poll_ring_tcp.sn. لا
// توجيه نظير: كان التشغيلان الأصلي والمفسَّر سيربطان منفذ الحلقة الثابت نفسه
// واحدا بعد الآخر (يستطلع المفسر بـepoll).
استورد std.os.poll;
استورد std.net.socket_address;
استورد std.net.tcp;

عرف أصفار(ع: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ع) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

عرف الرئيسية(): عدد {
    إذا (!هل_المستطلع_مدعوم()) { أرجع 1; };
    دع النص: نص = «127.0.0.1:38494»;
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(ع) -> { العنوان := ع; };
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي(&العنوان, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(م) -> { المستمع := م; };
    طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(_) -> { };
    دع المستطلع: مستطلع;
    طابق أنشئ_مستطلع_حلقي() مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(ق) -> { المستطلع := ق; };
    دع الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(8);

    // لا شيء جاهز بعد: انتظار قصير ينتهي بلا حدث.
    طابق سجل_في_مستطلع(&المستطلع, واصف_مستمع_تي_سي_بي(&المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(_) -> { };
    طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 10) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(ع) -> { إذا (ع != 0) { أرجع 8; }; };

    دع العميل: تدفق_تي_سي_بي;
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(ت) -> { العميل := ت; };
    طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 1000) مع
    | نتيجة.خطأ(_) -> { أرجع 10; }
    | نتيجة.نجح(ع) -> { إذا (ع != 1) { أرجع 11; }; };
    دع الأول: حدث_مستطلع = حدث_مستطلع_عند(&الأحداث, 0);
    إذا (الأول.الرمز != (0 مثل ط64) || !الأول.قابل_للقراءة) { أرجع 12; };

    دع الخادم: تدفق_تي_سي_بي;
    طابق اقبل_تي_سي_بي(&المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 13; }
    | نتيجة.نجح(ت) -> { الخادم := ت; };
    طابق اضبط_تدفق_تي_سي_بي_غير_حاصر(&الخادم, صواب) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(_) -> { };

    // لا شيء للقراءة بعد: «سيحظر» لا انتظار.
    دع المخزن: متغير متجه ط8 = أصفار(16);
    طابق اقرأ_تي_سي_بي(&الخادم, &متغير المخزن, 0, 16) مع
    | نتيجة.نجح(_) -> { أرجع 15; }
    | نتيجة.خطأ(الرمز) -> { إذا (!هل_خطأ_سيحظر(الرمز)) { أرجع 16; }; };

    دع الواصف: عدد = واصف_تدفق_تي_سي_بي(&الخادم);
    طابق سجل_في_مستطلع(&المستطلع, الواصف, 7 مثل ط64, اهتمام_مستطلع.قراءة()) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(_) -> { };
    دع مرحبا: متجه ط8 = [0x68, 0x69];
    طابق اكتب_تي_سي_بي(&العميل, &مرحبا, 0, 2) مع
    | نتيجة.خطأ(_) -> { أرجع 18; }
    | نتيجة.نجح(ع) -> { إذا (ع != 2) { أرجع 19; }; };
    طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 1000) مع
    | نتيجة.خطأ(_) -> { أرجع 20; }
    | نتيجة.نجح(ع) -> { إذا (ع != 1) { أرجع 21; }; };
    دع الجاهز: حدث_مستطلع = حدث_مستطلع_عند(&الأحداث, 0);
    إذا (الجاهز.الرمز != (7 مثل ط64) || !الجاهز.قابل_للقراءة) { أرجع 22; };

    // مرة واحدة: البايتات غير المقروءة لا تُبلَّغ ثانية حتى إعادة التسليح.
    طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 10) مع
    | نتيجة.خطأ(_) -> { أرجع 23; }
    | نتيجة.نجح(ع) -> { إذا (ع != 0) { أرجع 24; }; };
    طابق اقرأ_تي_سي_بي(&الخادم, &متغير المخزن, 0, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 25; }
    | نتيجة.نجح(ع) -> { إذا (ع != 2 || المخزن[0] != 0x68 || المخزن[1] != 0x69) { أرجع 26; }; };

    طابق أعد_تسليح_في_مستطلع(&المستطلع, الواصف, 7 مثل ط64, اهتمام_مستطلع.كتابة()) مع
    | نتيجة.خطأ(_) -> { أرجع 27; }
    | نتيجة.نجح(_) -> { };
    طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 1000) مع
    | نتيجة.خطأ(_) -> { أرجع 28; }
    | نتيجة.نجح(ع) -> { إذا (ع != 1) { أرجع 29; }; };
    دع القابل: حدث_مستطلع = حدث_مستطلع_عند(&الأحداث, 0);
    إذا (القابل.الرمز != (7 مثل ط64) || !القابل.قابل_للكتابة) { أرجع 30; };

    طابق ألغ_من_مستطلع(&المستطلع, الواصف) مع
    | نتيجة.خطأ(_) -> { أرجع 31; }
    | نتيجة.نجح(_) -> { };
    // يغلق العميل أولا: فتبقى حالة TIME_WAIT على منفذه المؤقت،
    // لا على منفذ الاستماع الثابت الذي يربطه التشغيل التالي.
    دع غ2: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(العميل);
    دع غ1: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(الخادم);
    دع غ3: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
    طابق أغلق_مستطلع(المستطلع) مع
    | نتيجة.خطأ(_) -> { أرجع 32; }
    | نتيجة.نجح(_) -> { };
    أرجع 0;
}
