// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/socket_timeout.sn
// مهلة الاستقبال: قراءة مقبس متصل بلا بيانات تفشل بعد المهلة تقريبا بدل الحجب.
استورد std.net.socket_address;
استورد std.net.tcp;
استورد std.net.options;
استورد std.time.time;

عرف الرئيسية(): عدد {
    دع النص: نص = «127.0.0.1:38543»;
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(العنوان) -> {
        دع الخيارات: متجه خيار_مقبس = [خيار_مقبس.إعادة_استخدام_العنوان(صواب)];
        طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 4, &الخيارات) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المستمع) -> {
            طابق اتصل_تي_سي_بي(&العنوان) مع
            | نتيجة.خطأ(_) -> { أرجع 3; }
            | نتيجة.نجح(العميل) -> {
                طابق اضبط_خيار_تدفق_تي_سي_بي(&العميل, خيار_مقبس.مهلة_استقبال(200)) مع
                | نتيجة.خطأ(_) -> { أرجع 4; }
                | نتيجة.نجح(_) -> { };
                دع البداية: متغير عدد = 0;
                طابق وقت_رتيب_نانو() مع
                | نتيجة.خطأ(_) -> { أرجع 5; }
                | نتيجة.نجح(الآن) -> { البداية := الآن; };
                دع المخزن: متغير متجه ط8 = [0, 0, 0, 0];
                طابق اقرأ_تي_سي_بي(&العميل, &متغير المخزن, 0, 4) مع
                | نتيجة.نجح(_) -> { أرجع 6; }
                | نتيجة.خطأ(_) -> { };
                دع المنقضي: متغير عدد = 0;
                طابق وقت_رتيب_نانو() مع
                | نتيجة.خطأ(_) -> { أرجع 7; }
                | نتيجة.نجح(الآن) -> { المنقضي := الآن - البداية; };
                إذا (المنقضي < 150000000 || المنقضي > 5000000000) { أرجع 8; };
                دع إغلاق_العميل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(العميل);
            };
            دع الإغلاق: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        };
    };
    أرجع 42;
}
