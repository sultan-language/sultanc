// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/zstd_codec.sn
// std.compression.zstd (RFC 8878): إطارات كتبتها أداة zstd 1.5 بالمستويات 1 و3 و19
// مع مجموع التحقق XXH64 وبدونه، وقاموس محتوى خام، وإطارات متتالية وقابلة للتخطي؛
// وإطارات الضاغط نفسه تعود كما كانت؛ والإطارات التالفة (المبتورة، والرقم السحري
// الخاطئ، ومجموع التحقق الخاطئ، والنافذة فوق الحد، وحد الإخراج، وقلب البتات)
// تنتهي بأخطاء.
استورد std.encoding.hex;
استورد std.text.from_bytes;
استورد std.text.number;
استورد std.fuzz.core;
استورد std.hash.xxh64;
استورد std.compression.zstd;

عرف من_سداسي(النص: نص): متجه ط8 {
    طابق فك_سداسي(&النص) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { دع فارغ: متجه ط8 = []; أرجع فارغ; };
}

عرف متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف يفك_إلى(الإطار: &متجه ط8, المتوقع: &متجه ط8): منطقي {
    طابق فك_ضغط_زد_ستد(الإطار) مع
    | نتيجة.نجح(ق) -> { أرجع متساويان(&ق, المتوقع); }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف ألحق_نصا(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عرف العينة_أ(): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الوحدة: نص = «SultanC zstd test: the quick brown fox jumps over the lazy dog. »;
    دع ك: متغير طبيعي = 0;
    طالما (ك < 3) { ألحق_نصا(&متغير الناتج, &الوحدة); ك := ك + 1; }
    دع الأرقام: نص = «0123456789»;
    ألحق_نصا(&متغير الناتج, &الأرقام);
    أرجع الناتج;
}

عرف العينة_ب(): متجه ط8 {
    دع الكلمات: متجه نص = [«alpha», «beta», «gamma», «delta», «epsilon», «zeta», «eta», «theta», «iota», «kappa», «lambda», «mu»];
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما ((الطول(الناتج) مثل طبيعي) < 1200) {
        ألحق_نصا(&متغير الناتج, &الكلمات[(ف * 7) % 12]);
        ألحق(الناتج, 32);
        دع العدد: نص = طبيعي_إلى_نص((ف * 13) % 97);
        ألحق_نصا(&متغير الناتج, &العدد);
        ألحق(الناتج, 44);
        ألحق(الناتج, 32);
        ف := ف + 1;
    }
    طالما ((الطول(الناتج) مثل طبيعي) > 1200) { دع المحذوف: اختياري ط8 = أزل_الأخير(الناتج); }
    أرجع الناتج;
}

عرف خاطئ(الإطار: &متجه ط8, الحد: طبيعي): منطقي {
    طابق فك_ضغط_زد_ستد_بحد(الإطار, الحد) مع
    | نتيجة.نجح(_) -> { أرجع خطأ; }
    | نتيجة.خطأ(_) -> { أرجع صواب; };
}

عرف الرئيسية(): عدد {
    دع أ: متجه ط8 = العينة_أ();
    دع ب: متجه ط8 = العينة_ب();
    دع أ1: متجه ط8 = من_سداسي(«28b52ffd04489d0200a40453756c74616e43207a73746420746573743a2074686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f672e20303132333435363738390100401fd210054c9e71a8»);
    دع أ19: متجه ط8 = من_سداسي(«28b52ffd0068850200540453756c74616e43207a73746420746573743a2074686520717569636b2062726f776e20666f78206a756d7073206f7665726c617a7920646f672e203031323334353637383902007d080985101414»);
    دع ب19: متجه ط8 = من_سداسي(«»);
    دع ب3: متجه ط8 = من_سداسي(«»);
    لو (!يفك_إلى(&أ1, &أ)) { أرجع 1; };
    لو (!يفك_إلى(&أ19, &أ)) { أرجع 2; };
    لو (!يفك_إلى(&ب19, &ب)) { أرجع 3; };
    لو (!يفك_إلى(&ب3, &ب)) { أرجع 4; };

    // قاموس محتوى خام.
    دع القاموس: متجه ط8 = بايتات_من_نص(«dictionary content: the quick brown fox jumps over the lazy dog dictionary content: the quick brown fox jumps over the lazy dog »);
    دع ج: متجه ط8 = بايتات_من_نص(«the quick brown fox jumps over the lazy dog, says the dictionary»);
    دع ج_قاموس: متجه ط8 = من_سداسي(«28b52ffd0458950000302c20736179730300395b2084b678a60202cdf2c14a»);
    طابق فك_ضغط_زد_ستد_بقاموس(&ج_قاموس, &القاموس) مع
    | نتيجة.نجح(ق) -> { لو (!متساويان(&ق, &ج)) { أرجع 5; }; }
    | نتيجة.خطأ(_) -> { أرجع 6; };
    لو (يفك_إلى(&ج_قاموس, &ج)) { أرجع 7; };

    // إطار قابل للتخطي ثم إطاران.
    دع المجموع: متغير متجه ط8 = من_سداسي(«502a4d1803000000616263»);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أ1) مثل طبيعي)) { ألحق(المجموع, أ1[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(أ19) مثل طبيعي)) { ألحق(المجموع, أ19[ف]); ف := ف + 1; }
    دع كلاهما: متغير متجه ط8 = العينة_أ();
    ف := 0;
    طالما (ف < (الطول(أ) مثل طبيعي)) { ألحق(كلاهما, أ[ف]); ف := ف + 1; }
    لو (!يفك_إلى(&المجموع, &كلاهما)) { أرجع 8; };

    // الضاغط: ضغط حقيقي، بمجموع تحقق أو دونه، وعودة كاملة.
    دع المضغوط: متجه ط8 = اضغط_زد_ستد(&ب);
    لو ((الطول(المضغوط) مثل طبيعي) * 2 > (الطول(ب) مثل طبيعي)) { أرجع 9; };
    لو (!يفك_إلى(&المضغوط, &ب)) { أرجع 10; };
    دع بلا_تحقق: متجه ط8 = اضغط_زد_ستد_بخيارات(&أ, خطأ);
    لو (!يفك_إلى(&بلا_تحقق, &أ)) { أرجع 11; };
    دع لا_شيء_فيه: متجه ط8 = [];
    دع مضغوط_فارغ: متجه ط8 = اضغط_زد_ستد(&لا_شيء_فيه);
    لو (!يفك_إلى(&مضغوط_فارغ, &لا_شيء_فيه)) { أرجع 12; };
    دع المتكرر: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 3000) { ألحق(المتكرر, 7); ف := ف + 1; }
    دع مضغوط_متكرر: متجه ط8 = اضغط_زد_ستد(&المتكرر);
    لو ((الطول(مضغوط_متكرر) مثل طبيعي) > 32 || !يفك_إلى(&مضغوط_متكرر, &المتكرر)) { أرجع 13; };

    // مدخلات تالفة.
    دع مبتور: متجه ط8 = فز_احذف_مدى(&ب19, 100, 207);
    لو (!خاطئ(&مبتور, 0)) { أرجع 14; };
    دع رقم_خاطئ: متجه ط8 = فز_استبدل_بايتا(&أ1, 0, 0x29);
    لو (!خاطئ(&رقم_خاطئ, 0)) { أرجع 15; };
    دع تحقق_خاطئ: متجه ط8 = فز_استبدل_بايتا(&أ1, 92, 0x00);
    طابق فك_ضغط_زد_ستد(&تحقق_خاطئ) مع
    | نتيجة.نجح(_) -> { أرجع 16; }
    | نتيجة.خطأ(خطأ_زد_ستد.مجموع_تحقق_غير_مطابق) -> { }
    | نتيجة.خطأ(_) -> { أرجع 17; };
    دع نافذة_ضخمة: متجه ط8 = من_سداسي(«28b52ffd00f8010000»);
    طابق فك_ضغط_زد_ستد(&نافذة_ضخمة) مع
    | نتيجة.نجح(_) -> { أرجع 18; }
    | نتيجة.خطأ(خطأ_زد_ستد.نافذة_أكبر_من_الحد) -> { }
    | نتيجة.خطأ(_) -> { أرجع 19; };
    طابق فك_ضغط_زد_ستد_بحد(&ب19, 1000) مع
    | نتيجة.نجح(_) -> { أرجع 20; }
    | نتيجة.خطأ(خطأ_زد_ستد.تجاوز_حد_الإخراج) -> { }
    | نتيجة.خطأ(_) -> { أرجع 21; };
    دع مدخل_فارغ: متجه ط8 = [];
    لو (!خاطئ(&مدخل_فارغ, 0)) { أرجع 22; };
    دع القلبات: متغير طبيعي = 0;
    دع البت: متغير طبيعي = 5;
    طالما (القلبات < 8) {
        دع المقلوب: متجه ط8 = فز_اقلب_بتا(&أ1, البت % ((الطول(أ1) مثل طبيعي) * 8));
        دع متجاهل: منطقي = خاطئ(&المقلوب, 100000);
        البت := البت + 977;
        القلبات := القلبات + 1;
    }

    // قيم XXH64 المرجعية (متجهات اختبار xxHash).
    لو (هاش_إكس_إكس_إتش64(&لا_شيء_فيه) != 0xEF46DB3751D8E999) { أرجع 23; };
    دع ابت: متجه ط8 = بايتات_من_نص(«abc»);
    لو (هاش_إكس_إكس_إتش64(&ابت) != 0x44BC2CF5AD770999) { أرجع 24; };
    أرجع 42;
}
