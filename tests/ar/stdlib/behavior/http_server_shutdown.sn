// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http_server_shutdown.sn
// الإيقاف المنظم (std.http.shutdown): خيط يطلب الإيقاف بعد 300 مللي ثانية،
// فيتوقف الخادم المتتابع ثم الخادم الحدثي عن القبول ويرجعان بنجاح. بلا
// توجيه زوج: المفسر يشغل خيطًا واحدًا.
استورد std.http.server;
استورد std.http.shutdown;
استورد std.http.model;
استورد std.http.body;
استورد std.sync.arc;
استورد std.thread.thread;
استورد std.time.time;

عرف خدمة(الحالة: &عدد, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    دع ن: نص = «ok»;
    أرجع استجابة_نص_ويب(200, &ن);
}

عرف أوقف_بعد_قليل(): فراغ {
    دع تجاهل: نتيجة عدد, عدد = نم_نانو(300000000);
    اطلب_إيقاف_خوادم_الويب();
}

عرف الرئيسية(): عدد {
    إذا (هل_طلب_إيقاف_الويب()) { أرجع 1; };
    طابق أطلق(دالة(): فراغ -> أوقف_بعد_قليل()) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> { };
    دع العنوان: نص = «127.0.0.1:0»;
    دع الإعداد: إعداد_خادم_ويب = إعداد_خادم_ويب_افتراضي(&العنوان);
    دع الحالة: عدد = 0;
    طابق شغل_خادم_ويب(&الإعداد, &الحالة, خدمة) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> { };
    دع المشتركة: مشترك<عدد> = أنشئ_مشترك(0);
    طابق شغل_خادم_ويب_بأحداث(&الإعداد, المشتركة, خدمة, 2) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(_) -> { };
    إذا (!هل_طلب_إيقاف_الويب()) { أرجع 5; };
    أرجع 0;
}
