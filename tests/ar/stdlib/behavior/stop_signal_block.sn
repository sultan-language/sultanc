// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/stop_signal_block.sn
// std.os.signal: يمكن حجب SIGINT وSIGTERM، ودون إرسال أي منهما يجيب فحص
// الإشارة المعلقة بلا شيء دون انتظار؛ ثم يمكن رفع حجبهما.
استورد std.os.signal;

عرف الرئيسية(): عدد {
    طابق احجب_إشارات_الإيقاف() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> {};
    طابق إشارة_إيقاف_معلقة() مع
    | اختياري.موجود(_) -> { أرجع 2; }
    | اختياري.لا_شيء -> {};
    طابق ارفع_حجب_إشارات_الإيقاف() مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> {};
    أرجع 0;
}
