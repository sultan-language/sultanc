// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/sync_single_thread.sn
// std.sync في خيط واحد، حيث تتفق الشفرة الأصلية والمفسر: نفذ_مع_القفل
// وحاول_القفل في القفل (لا شيء ما دام مأخوذا)، والقراء والكاتب في قفل القراءة
// والكتابة، ونفذ_مرة مرة واحدة، وخلية مرة تُضبط مرة واحدة، وتنبيه بلا منتظر،
// ومشترك يُقرأ عبر مقبضين.
استورد std.sync.arc;
استورد std.sync.mutex;
استورد std.sync.rwlock;
استورد std.sync.condvar;
استورد std.sync.once;

عرف أضف_عشرة(ق: &متغير ص64): ص64 { *ق := *ق + 10; أرجع *ق; }
عرف اقرأ(ق: &متغير ص64): ص64 { أرجع *ق; }
عرف اقرأ_مشتركا(ق: &ص64): ص64 { أرجع *ق; }
عرف ضاعف(ق: &متغير ص64): فراغ { *ق := *ق * 2; }

عرف محاولة_متداخلة(م: &مشترك<قفل<ص64>>, ق: &متغير ص64): منطقي {
    // القفل مأخوذ هنا: تبلّغ محاولة القفل عن لا شيء.
    طابق حاول_القفل(اقرأ_مشترك(م), دالة(ع: &متغير ص64): ص64 -> اقرأ(ع)) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { أرجع صواب; };
}

عرف عد_تنفيذا(ع: &مشترك<قفل<ص64>>): فراغ { دع ن: ص64 = نفذ_مع_القفل(اقرأ_مشترك(ع), دالة(ق: &متغير ص64): ص64 -> أضف_عشرة(ق)); }
عرف سبعة(): ص64 { أرجع 7; }

نوع زوج = { اليسار: ص64, اليمين: نص };

عرف الرئيسية(): ص32 {
    // الإغلاق ينقل ما يلتقطه من قيم مملوكة، فالشفرة التي تحتاج القفل داخل
    // إغلاقها تشاركه عبر مشترك، كما في Rust.
    دع م: مشترك<قفل<ص64>> = أنشئ_مشترك(أنشئ_قفل(5 مثل ص64));
    لو (نفذ_مع_القفل(اقرأ_مشترك(&م), دالة(ق: &متغير ص64): ص64 -> أضف_عشرة(ق)) != (15 مثل ص64)) { أرجع 1; };
    لو (!نفذ_مع_القفل(اقرأ_مشترك(&م), دالة(ق: &متغير ص64): منطقي -> محاولة_متداخلة(&م, ق))) { أرجع 2; };
    طابق حاول_القفل(اقرأ_مشترك(&م), دالة(ق: &متغير ص64): ص64 -> اقرأ(ق)) مع
    | اختياري.موجود(ن) -> { لو (ن != (15 مثل ص64)) { أرجع 3; }; }
    | اختياري.لا_شيء -> { أرجع 4; };
    لو (هل_القفل_مأخوذ(اقرأ_مشترك(&م))) { أرجع 5; };

    دع ق_ك: قفل_قراءة_كتابة<ص64> = أنشئ_قفل_قراءة_كتابة(21 مثل ص64);
    لو (نفذ_مع_قراءة(&ق_ك, دالة(ق: &ص64): ص64 -> اقرأ_مشتركا(ق)) != (21 مثل ص64)) { أرجع 6; };
    نفذ_مع_كتابة(&ق_ك, دالة(ق: &متغير ص64): فراغ -> ضاعف(ق));
    لو (نفذ_مع_قراءة(&ق_ك, دالة(ق: &ص64): ص64 -> اقرأ_مشتركا(ق)) != (42 مثل ص64)) { أرجع 7; };

    دع العداد: مشترك<قفل<ص64>> = أنشئ_مشترك(أنشئ_قفل(0 مثل ص64));
    دع المرة: مرة = أنشئ_مرة();
    لو (هل_اكتملت_المرة(&المرة)) { أرجع 8; };
    نفذ_مرة(&المرة, دالة(): فراغ -> عد_تنفيذا(&العداد));
    نفذ_مرة(&المرة, دالة(): فراغ -> عد_تنفيذا(&العداد));
    لو (!هل_اكتملت_المرة(&المرة)) { أرجع 9; };
    لو (نفذ_مع_القفل(اقرأ_مشترك(&العداد), دالة(ق: &متغير ص64): ص64 -> اقرأ(ق)) != (10 مثل ص64)) { أرجع 10; };

    دع الخلية: خلية_مرة<ص64> = أنشئ_خلية_مرة();
    طابق اقرأ_خلية_مرة(&الخلية) مع | اختياري.موجود(_) -> { أرجع 11; } | اختياري.لا_شيء -> { };
    لو (*اقرأ_أو_هيئ_خلية_مرة(&الخلية, دالة(): ص64 -> سبعة()) != (7 مثل ص64)) { أرجع 12; };
    لو (اضبط_خلية_مرة(&الخلية, 9 مثل ص64)) { أرجع 13; };
    طابق اقرأ_خلية_مرة(&الخلية) مع | اختياري.موجود(ق) -> { لو (*ق != (7 مثل ص64)) { أرجع 14; }; } | اختياري.لا_شيء -> { أرجع 15; };

    دع ش: شرط_انتظار = أنشئ_شرط_انتظار();
    نبه_واحدا(&ش);
    نبه_الكل(&ش);

    دع القيمة: زوج = { اليسار: 3, اليمين: «four» };
    دع أ: مشترك<زوج> = أنشئ_مشترك(القيمة);
    دع ب: مشترك<زوج> = استنسخ_مشترك(&أ);
    دع ز: &زوج = اقرأ_مشترك(&ب);
    لو ((*ز).اليسار + (الطول((*ز).اليمين) مثل ص64) != (7 مثل ص64)) { أرجع 16; };
    أرجع 0;
}
