// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 42
// نظير: tests/en/stdlib/behavior/sync_channel_ends_by_name.sn
// The ends of a channel by name (docs/en/reference/concurrency.md, "Channels"):
// مرسل_الطرفين and مستلم_الطرفين borrow the two fields, as `&الطرفان.المرسل`
// does.
استورد المكتبة.تزامن.قناة;

عرف الرئيسية(): عدد {
    ليكن الطرفان: طرفا_قناة<عدد> = قناة<عدد>();
    طابق أرسل(مرسل_الطرفين(&الطرفان), 42) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };
    ليكن المستلَم: متغير عدد = 0;
    طابق استقبل(مستلم_الطرفين(&الطرفان)) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(القيمة) -> { المستلَم := القيمة; };
    أرجع المستلَم;
}
