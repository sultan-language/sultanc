// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/env_executable.sn
// std.env.executable (env::current_exe في Rust): مسار التنفيذي الجاري مطلق
// ويسمي ملفا موجودا، وطلبه مرتين يعطي المسار نفسه. وفي التفسير يكون التنفيذي
// الجاري هو المفسر.
استورد std.env.executable;
استورد std.fs.metadata;
استورد std.fs.path;
استورد std.fs.canonical;
استورد std.text.compare;

عرف الرئيسية(): عدد {
    دع الأول: متغير نص = «»;
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المسار) -> { الأول := المسار; };
    لو (الطول(الأول) == 0) { أرجع 2; };
    لو (!مسار_مطلق_بصيغة(&الأول, صيغة_مسار_المضيف())) { أرجع 3; };
    طابق موجود(&الأول) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(خطأ) -> { أرجع 5; }
    | نتيجة.نجح(صواب) -> {};
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(الثاني) -> { لو (!نصان_متساويان(&الأول, &الثاني)) { أرجع 7; }; };
    أرجع 42;
}
