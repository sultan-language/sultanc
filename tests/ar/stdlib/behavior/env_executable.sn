// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/env_executable.sn
// std.env.executable: مسار التنفيذي الجاري مطلق
// ويسمي ملفا موجودا، وطلبه مرتين يعطي المسار نفسه. وفي التفسير يكون التنفيذي
// الجاري هو المفسر.
استورد المكتبة.بيئة.البرنامج_الحالي;
استورد المكتبة.ملفات.بيانات_وصفية;
استورد المكتبة.ملفات.مسار;
استورد المكتبة.ملفات.مسار_قانوني;
استورد المكتبة.نصوص.مقارنة;

عرف الرئيسية(): عدد {
    دع الأول: متغير نص = «»;
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المسار) -> { الأول := المسار; };
    إذا (الطول(الأول) == 0) { أرجع 2; };
    إذا (!مسار_مطلق_بصيغة(&الأول, صيغة_مسار_المضيف())) { أرجع 3; };
    طابق موجود(&الأول) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(خطأ) -> { أرجع 5; }
    | نتيجة.نجح(صواب) -> {};
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(الثاني) -> { إذا (!نصان_متساويان(&الأول, &الثاني)) { أرجع 7; }; };
    أرجع 42;
}
