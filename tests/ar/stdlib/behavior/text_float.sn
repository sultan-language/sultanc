// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/text_float.sn
// std.text.float: أقصر نص عشري يعاد تحليله إلى العائم نفسه (مقارنا بـ Number::toString
// في ECMAScript)، والتحليل الدقيق إلى أقرب ع64 (اللانهاية وNaN والصفر السالب والأخطاء).
استورد std.text.float;
استورد std.math.float;
استورد std.text.compare;

عرف افحص(البتات: ط64, النص: نص): منطقي {
    دع الناتج: نص = ع64_إلى_نص(ع64_من_بتات(البتات));
    لو (!نصان_متساويان(&الناتج, &النص)) { أرجع خطأ; };
    طابق حلل_ع64(&النص) مع
    | نتيجة.نجح(القيمة) -> { أرجع بتات_ع64(القيمة) == البتات; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}
عرف بتات_التحليل(النص: نص): ط64 {
    طابق حلل_ع64(&النص) مع
    | نتيجة.نجح(القيمة) -> { أرجع بتات_ع64(القيمة); }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
عرف مرفوض(النص: نص): منطقي {
    طابق حلل_ع64(&النص) مع
    | نتيجة.نجح(_) -> { أرجع خطأ; }
    | نتيجة.خطأ(_) -> { أرجع صواب; };
}
عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    لو (!افحص(4591870180066957722, "0.1")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4596373779694328218, "0.2")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4599075939470750516, "0.30000000000000004")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4607182418800017408, "1")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(13830554455654793216, "-1")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4609434218613702656, "1.5")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4636737291354636288, "100")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4921056587992461136, "1e+21")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4906019910204099648, "100000000000000000000")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4907451598986591450, "123456789012345680000")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4502148214488346440, "1e-7")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4517329193108106637, "0.000001")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4518434226865098134, "0.000001234")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(1, "5e-324")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4503599627370496, "2.2250738585072014e-308")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(9218868437227405311, "1.7976931348623157e+308")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(13686771371230025365, "-2.5e-10")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4614256656552045848, "3.141592653589793")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4604180019048437077, "0.6666666666666666")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4845873199050653696, "9007199254740992")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4616583683022153318, "4.35")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4653144502051863213, "1234.5678")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(9094988921128908188, "1e+300")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4602678819172646912, "0.5")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(9214364837600034816, "8.98846567431158e+307")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4950912855330343670, "1e+23")) { الإخفاقات := الإخفاقات + 1; };
    لو (!افحص(4512825593480736141, "5e-7")) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل(".5") != 4602678819172646912) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("5.") != 4617315517961601024) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("+2") != 4611686018427387904) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("1e400") != 9218868437227405312) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("-1E400") != 18442240474082181120) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("-0") != 9223372036854775808) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("1e-400") != 0) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("INF") != 9218868437227405312) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("-infinity") != 18442240474082181120) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("2.2250738585072011e-308") != 4503599627370495) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_التحليل("0.1000000000000000055511151231257827021181583404541015625") != 4591870180066957722) { الإخفاقات := الإخفاقات + 1; };
    لو (بتات_ع64(ع64_من_بتات(بتات_التحليل("nan"))) != 9221120237041090560) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("abc")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("1e")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("--1")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("0x10")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("1.2.3")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض(" 1")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض("e5")) { الإخفاقات := الإخفاقات + 1; };
    لو (!مرفوض(".")) { الإخفاقات := الإخفاقات + 1; };
    لو (الإخفاقات != 0) { أرجع 1; };
    أرجع 42;
}
