// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http_router_tree.sn
// تحافظ شجرة أجزاء الموجّه على قواعد التوجيه: الجزء الثابت يسبق المعامل،
// والمعامل يسبق البقية، والبقية تأخذ باقي المسار (ولو كان فارغا، مع الشرطات
// الداخلية)، والشرطة الأخيرة جزء أخير فارغ، وسلسلة الاستعلام ليست من المسار،
// والهدف بالصيغة المطلقة يُوجَّه بمساره، والمسار الذي لا يطابق إلا طرقا أخرى
// يعطي 405 وفي «allow» كل تلك الطرق (بترتيب التسجيل)، والمسار المجهول 404.
// والمسار المسجل مرتين يُرفض.
استورد std.http.model;
استورد std.http.headers;
استورد std.http.body;
استورد std.http.router;
استورد std.text.transform;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف رد(الوسم: نص, المعاملات: &معاملات_مسار_ويب): استجابة_ويب_مخزنة {
    دع الأجزاء: متغير متجه نص = [الوسم];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المعاملات).القيم) مثل طبيعي)) {
        ألحق(الأجزاء, انسخ_نص(&(*المعاملات).القيم[ف].القيمة));
        ف := ف + 1;
    }
    دع الفاصل: نص = «|»;
    دع الجسم: نص = صل_النصوص(&الأجزاء, &الفاصل);
    أرجع استجابة_نص_ويب(200, &الجسم);
}

عرف قائمة(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«list», م); }
عرف أنا(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«me», م); }
عرف واحد(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«one», م); }
عرف إرسال(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«post», م); }
عرف كتاب(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«book», م); }
عرف ملفات(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«files», م); }
عرف جذر(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«root», م); }
عرف عميق(ح: &عدد, ط: &طلب_ويب_مخزن, م: &معاملات_مسار_ويب): استجابة_ويب_مخزنة { أرجع رد(«deep», م); }

عرف طلب(الطريقة: نص, الهدف: نص): طلب_ويب_مخزن {
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع ط: طلب_ويب_مخزن = {
        الطريقة: الطريقة, الهدف: الهدف, الإصدار: إصدار_ويب.واحد_واحد(), الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم, العنوان_البعيد: "", السياق: سياق_طلب_ويب_فارغ()
    };
    أرجع ط;
}

عرف توقع(الموجه: &موجه_ويب<عدد>, الطريقة: نص, الهدف: نص, المتوقع: نص): منطقي {
    دع ط: طلب_ويب_مخزن = طلب(الطريقة, الهدف);
    دع الاستجابة: استجابة_ويب_مخزنة = وجه_طلب_ويب(الموجه, &ط);
    إذا (الاستجابة.الحالة != 200) { أرجع خطأ; };
    دع النص: نص = من_بايتات(&الاستجابة.الجسم);
    أرجع نصان_متساويان(&النص, &المتوقع);
}

عرف حالة(الموجه: &موجه_ويب<عدد>, الطريقة: نص, الهدف: نص): عدد {
    دع ط: طلب_ويب_مخزن = طلب(الطريقة, الهدف);
    دع الاستجابة: استجابة_ويب_مخزنة = وجه_طلب_ويب(الموجه, &ط);
    أرجع الاستجابة.الحالة مثل عدد;
}

عرف شغل(): عدد {
    دع الموجه: متغير موجه_ويب<عدد> = موجه_ويب_جديد(0);
    دع ن1: نص = «/users»;
    دع ن2: نص = «/users/me»;
    دع ن3: نص = «/users/{id}»;
    دع ن4: نص = «/users/{id}/books/{book}»;
    دع ن5: نص = «/files/{*path}»;
    دع ن6: نص = «/»;
    دع ن7: نص = «/a/{x}/{*rest}»;
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن1, قائمة) مع | نتيجة.خطأ(_) -> { أرجع 1; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن3, واحد) مع | نتيجة.خطأ(_) -> { أرجع 2; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن2, أنا) مع | نتيجة.خطأ(_) -> { أرجع 3; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_post_ويب(&متغير الموجه, &ن3, إرسال) مع | نتيجة.خطأ(_) -> { أرجع 4; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن4, كتاب) مع | نتيجة.خطأ(_) -> { أرجع 5; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن5, ملفات) مع | نتيجة.خطأ(_) -> { أرجع 6; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن6, جذر) مع | نتيجة.خطأ(_) -> { أرجع 7; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن7, عميق) مع | نتيجة.خطأ(_) -> { أرجع 8; } | نتيجة.نجح(_) -> {};
    طابق أضف_مسار_get_ويب(&متغير الموجه, &ن3, واحد) مع | نتيجة.خطأ(_) -> {} | نتيجة.نجح(_) -> { أرجع 9; };

    إذا (!توقع(&الموجه, «GET», «/users», «list»)) { أرجع 10; };
    إذا (!توقع(&الموجه, «GET», «/users/me», «me»)) { أرجع 11; };
    إذا (!توقع(&الموجه, «GET», «/users/42», «one|42»)) { أرجع 12; };
    إذا (!توقع(&الموجه, «GET», «/users/42?x=1&y=2», «one|42»)) { أرجع 13; };
    إذا (!توقع(&الموجه, «POST», «/users/7», «post|7»)) { أرجع 14; };
    إذا (!توقع(&الموجه, «GET», «/users/7/books/b9», «book|7|b9»)) { أرجع 15; };
    إذا (!توقع(&الموجه, «GET», «/files/a/b/c.txt», «files|a/b/c.txt»)) { أرجع 16; };
    إذا (!توقع(&الموجه, «GET», «/files», «files|»)) { أرجع 17; };
    إذا (!توقع(&الموجه, «GET», «/files/», «files|»)) { أرجع 18; };
    إذا (!توقع(&الموجه, «GET», «/», «root»)) { أرجع 19; };
    إذا (!توقع(&الموجه, «GET», «http://example.com/users/5?q», «one|5»)) { أرجع 20; };
    إذا (!توقع(&الموجه, «GET», «/a/1/x/y», «deep|1|x/y»)) { أرجع 21; };
    إذا (!توقع(&الموجه, «GET», «/a/1», «deep|1|»)) { أرجع 22; };
    // الشرطة الأخيرة جزء أخير فارغ: /users/ هو /users/{id} بقيمة "".
    إذا (!توقع(&الموجه, «GET», «/users/», «one|»)) { أرجع 23; };
    إذا (حالة(&الموجه, «GET», «/nothing») != 404) { أرجع 24; };
    إذا (حالة(&الموجه, «GET», «/users/1/books») != 404) { أرجع 25; };
    إذا (حالة(&الموجه, «DELETE», «/users/3») != 405) { أرجع 26; };
    دع ط: طلب_ويب_مخزن = طلب(«DELETE», «/users/3»);
    دع الاستجابة: استجابة_ويب_مخزنة = وجه_طلب_ويب(&الموجه, &ط);
    دع اسم_السماح: نص = «allow»;
    دع السماح: متجه نص = قيم_رأس_ويب(&الاستجابة.الرؤوس, &اسم_السماح);
    إذا ((الطول(السماح) مثل طبيعي) != 1) { أرجع 27; };
    دع المتوقع: نص = «GET, POST»;
    إذا (!نصان_متساويان(&السماح[0], &المتوقع)) { أرجع 28; };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    أرجع شغل();
}
