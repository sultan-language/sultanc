// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/unix_sockets.sn
// std.net.unix (std::os::unix::net في Rust) بمقبسين في عملية واحدة: مستمع،
// وتدفق متصل وآخر مقبول يتبادلان البايتات، وعناوينهما، والإيقاف؛ ورسائل
// بين مقبسين مربوطين، ومقبس رسائل متصل ومرسل غير مربوط؛ واسم مجرد على
// لينكس؛ ومسار أطول من sun_path. يكتمل الاتصال حالما تضعه النواة في
// الطابور، فيتبعه القبول في الخيط نفسه.
استورد std.net.unix;
استورد std.net.tcp;
استورد std.fs.temporary;
استورد std.fs.mutation;
استورد std.fs.path;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف هل_مسار(العنوان: &عنوان_يونكس, المطلوب: &نص): منطقي {
    طابق *العنوان مع
    | عنوان_يونكس.مسار(النص) -> { أرجع نصان_متساويان(&النص, المطلوب); }
    | _ -> { أرجع خطأ; };
}

عرف هل_بلا_اسم(العنوان: &عنوان_يونكس): منطقي {
    طابق *العنوان مع
    | عنوان_يونكس.بلا_اسم -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف بايتات_متساوية(الأول: &متجه ط8, الثاني: &متجه ط8): منطقي {
    لو (الطول(*الأول) != الطول(*الثاني)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأول) مثل طبيعي)) {
        لو ((*الأول)[ف] != (*الثاني)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// يكتب الرسالة على تدفق ويقرؤها كاملة من الآخر.
عرف تبادل(المرسل: &تدفق_يونكس, المستقبل: &تدفق_يونكس, الرسالة: &نص): منطقي {
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الرسالة));
    دع العدد: عدد = الطول(البايتات) مثل عدد;
    طابق اكتب_يونكس(المرسل, &البايتات, 0, العدد) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المكتوب) -> { لو (المكتوب != العدد) { أرجع خطأ; }; };
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < العدد) { ألحق(المخزن, 0); ف := ف + 1; }
    دع المقروء_كله: متغير عدد = 0;
    طالما (المقروء_كله < العدد) {
        طابق اقرأ_يونكس(المستقبل, &متغير المخزن, المقروء_كله, العدد - المقروء_كله) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(0) -> { أرجع خطأ; }
        | نتيجة.نجح(المقروء) -> { المقروء_كله := المقروء_كله + المقروء; };
    }
    أرجع بايتات_متساوية(&المخزن, &البايتات);
}

عرف الرئيسية(): عدد {
    دع البادئة: نص = «sultanc-unix-»;
    دع الدليل: نص;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المصنوع) -> { الدليل := المصنوع; };
    دع اسم_المقبس: نص = «stream.sock»;
    دع المسار: نص = صل_المسار(&الدليل, &اسم_المقبس);

    // 1. مستمع وعميل والتدفق المقبول.
    دع المستمع: مستمع_يونكس;
    طابق اربط_مستمع_يونكس(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(المربوط) -> { المستمع := المربوط; };
    طابق العنوان_المحلي_لمستمع_يونكس(&المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(العنوان) -> { لو (!هل_مسار(&العنوان, &المسار)) { أرجع 4; }; };
    // ربط المسار نفسه مرة أخرى: ملف المقبس موجود.
    طابق اربط_مستمع_يونكس(&المسار) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 5; };
    دع العميل: تدفق_يونكس;
    طابق اتصل_يونكس(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(المتصل) -> { العميل := المتصل; };
    دع الخادم: تدفق_يونكس;
    طابق اقبل_يونكس(&المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(المقبول) -> { الخادم := المقبول; };
    دع بينغ: نص = «ping»;
    دع بونغ: نص = «pong, and a longer reply»;
    لو (!تبادل(&العميل, &الخادم, &بينغ)) { أرجع 8; };
    لو (!تبادل(&الخادم, &العميل, &بونغ)) { أرجع 9; };
    طابق عنوان_نظير_يونكس(&العميل) مع
    | نتيجة.خطأ(_) -> { أرجع 10; }
    | نتيجة.نجح(العنوان) -> { لو (!هل_مسار(&العنوان, &المسار)) { أرجع 11; }; };
    طابق عنوان_نظير_يونكس(&الخادم) مع
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(العنوان) -> { لو (!هل_بلا_اسم(&العنوان)) { أرجع 13; }; };
    // إيقاف كتابة العميل نهاية تدفق الخادم.
    طابق أوقف_يونكس(&العميل, اتجاه_إيقاف_تي_سي_بي.كتابة()) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(_) -> {};
    دع واحد: متغير متجه ط8 = [0];
    طابق اقرأ_يونكس(&الخادم, &متغير واحد, 0, 1) مع
    | نتيجة.خطأ(_) -> { أرجع 15; }
    | نتيجة.نجح(ع) -> { لو (ع != 0) { أرجع 16; }; };
    طابق أغلق_تدفق_يونكس(العميل) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(_) -> {};
    طابق أغلق_تدفق_يونكس(الخادم) مع
    | نتيجة.خطأ(_) -> { أرجع 18; }
    | نتيجة.نجح(_) -> {};
    طابق أغلق_مستمع_يونكس(المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 19; }
    | نتيجة.نجح(_) -> {};
    // لا مستمع وراء الملف بعد الآن: الاتصال مرفوض.
    طابق اتصل_يونكس(&المسار) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 20; };
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 21; }
    | نتيجة.نجح(_) -> {};

    // 2. رسائل بين مقبسين مربوطين.
    دع اسم_أ: نص = «a.sock»;
    دع اسم_ب: نص = «b.sock»;
    دع مسار_أ: نص = صل_المسار(&الدليل, &اسم_أ);
    دع مسار_ب: نص = صل_المسار(&الدليل, &اسم_ب);
    دع أ: مقبس_رسائل_يونكس;
    طابق اربط_رسائل_يونكس(&مسار_أ) مع
    | نتيجة.خطأ(_) -> { أرجع 22; }
    | نتيجة.نجح(المربوط) -> { أ := المربوط; };
    دع ب: مقبس_رسائل_يونكس;
    طابق اربط_رسائل_يونكس(&مسار_ب) مع
    | نتيجة.خطأ(_) -> { أرجع 23; }
    | نتيجة.نجح(المربوط) -> { ب := المربوط; };
    دع مرحبا: متجه ط8 = [104, 101, 108, 108, 111];
    طابق أرسل_إلى_يونكس(&أ, &مرحبا, 0, 5, &مسار_ب) مع
    | نتيجة.خطأ(_) -> { أرجع 24; }
    | نتيجة.نجح(ع) -> { لو (ع != 5) { أرجع 25; }; };
    دع المخزن: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    طابق استقبل_من_يونكس(&ب, &متغير المخزن, 0, 8) مع
    | نتيجة.خطأ(_) -> { أرجع 26; }
    | نتيجة.نجح(الحزمة) -> {
        لو (الحزمة.المقروء != 5 || المخزن[0] != 104 || المخزن[4] != 111) { أرجع 27; };
        لو (!هل_مسار(&الحزمة.المرسل, &مسار_أ)) { أرجع 28; };
    };
    // ب متصل بـ أ: إرسال واستقبال بلا عناوين.
    طابق اتصل_رسائل_يونكس(&ب, &مسار_أ) مع
    | نتيجة.خطأ(_) -> { أرجع 29; }
    | نتيجة.نجح(_) -> {};
    دع عودة: متجه ط8 = [98, 97, 99, 107];
    طابق أرسل_رسائل_يونكس(&ب, &عودة, 0, 4) مع
    | نتيجة.خطأ(_) -> { أرجع 30; }
    | نتيجة.نجح(_) -> {};
    طابق استقبل_من_يونكس(&أ, &متغير المخزن, 0, 8) مع
    | نتيجة.خطأ(_) -> { أرجع 31; }
    | نتيجة.نجح(الحزمة) -> {
        لو (الحزمة.المقروء != 4 || المخزن[0] != 98) { أرجع 32; };
        لو (!هل_مسار(&الحزمة.المرسل, &مسار_ب)) { أرجع 33; };
    };
    طابق عنوان_نظير_رسائل_يونكس(&ب) مع
    | نتيجة.خطأ(_) -> { أرجع 34; }
    | نتيجة.نجح(العنوان) -> { لو (!هل_مسار(&العنوان, &مسار_أ)) { أرجع 35; }; };
    // مرسل غير مربوط يصل بلا اسم.
    دع ج: مقبس_رسائل_يونكس;
    طابق رسائل_يونكس_بلا_ربط() مع
    | نتيجة.خطأ(_) -> { أرجع 36; }
    | نتيجة.نجح(المصنوع) -> { ج := المصنوع; };
    طابق أرسل_إلى_يونكس(&ج, &مرحبا, 0, 5, &مسار_أ) مع
    | نتيجة.خطأ(_) -> { أرجع 37; }
    | نتيجة.نجح(_) -> {};
    طابق استقبل_من_يونكس(&أ, &متغير المخزن, 0, 8) مع
    | نتيجة.خطأ(_) -> { أرجع 38; }
    | نتيجة.نجح(الحزمة) -> {
        لو (الحزمة.المقروء != 5) { أرجع 39; };
        لو (!هل_بلا_اسم(&الحزمة.المرسل)) { أرجع 40; };
    };
    طابق أغلق_رسائل_يونكس(أ) مع | نتيجة.خطأ(_) -> { أرجع 41; } | نتيجة.نجح(_) -> {};
    طابق أغلق_رسائل_يونكس(ب) مع | نتيجة.خطأ(_) -> { أرجع 42; } | نتيجة.نجح(_) -> {};
    طابق أغلق_رسائل_يونكس(ج) مع | نتيجة.خطأ(_) -> { أرجع 43; } | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&مسار_أ) مع | نتيجة.خطأ(_) -> { أرجع 44; } | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&مسار_ب) مع | نتيجة.خطأ(_) -> { أرجع 45; } | نتيجة.نجح(_) -> {};

    // 3. اسم مجرد (لينكس، أندرويد): بلا ملف، والعنوان نفسه يعود.
    لو (هل_العنوان_المجرد_مدعوم()) {
        دع الاسم: متجه ط8 = بايتات_من_نص(انسخ_نص(&الدليل));
        دع العنوان_المجرد: عنوان_يونكس = عنوان_يونكس.مجرد(انسخ_بايتات(&الاسم));
        دع م_م: مستمع_يونكس;
        طابق اربط_مستمع_يونكس_بعنوان(&العنوان_المجرد) مع
        | نتيجة.خطأ(_) -> { أرجع 46; }
        | نتيجة.نجح(المربوط) -> { م_م := المربوط; };
        طابق العنوان_المحلي_لمستمع_يونكس(&م_م) مع
        | نتيجة.خطأ(_) -> { أرجع 47; }
        | نتيجة.نجح(عنوان_يونكس.مجرد(المقروء)) -> { لو (!بايتات_متساوية(&المقروء, &الاسم)) { أرجع 48; }; }
        | نتيجة.نجح(_) -> { أرجع 49; };
        دع م_ع: تدفق_يونكس;
        طابق اتصل_يونكس_بعنوان(&العنوان_المجرد) مع
        | نتيجة.خطأ(_) -> { أرجع 50; }
        | نتيجة.نجح(المتصل) -> { م_ع := المتصل; };
        دع م_خ: تدفق_يونكس;
        طابق اقبل_يونكس(&م_م) مع
        | نتيجة.خطأ(_) -> { أرجع 51; }
        | نتيجة.نجح(المقبول) -> { م_خ := المقبول; };
        لو (!تبادل(&م_ع, &م_خ, &بينغ)) { أرجع 52; };
        طابق أغلق_تدفق_يونكس(م_ع) مع | نتيجة.خطأ(_) -> { أرجع 53; } | نتيجة.نجح(_) -> {};
        طابق أغلق_تدفق_يونكس(م_خ) مع | نتيجة.خطأ(_) -> { أرجع 54; } | نتيجة.نجح(_) -> {};
        طابق أغلق_مستمع_يونكس(م_م) مع | نتيجة.خطأ(_) -> { أرجع 55; } | نتيجة.نجح(_) -> {};
    } وإلا {
        دع الاسم: متجه ط8 = [120];
        دع العنوان_المجرد: عنوان_يونكس = عنوان_يونكس.مجرد(الاسم);
        طابق اربط_مستمع_يونكس_بعنوان(&العنوان_المجرد) مع
        | نتيجة.خطأ(_) -> {}
        | نتيجة.نجح(_) -> { أرجع 56; };
    };

    // 4. مسار أطول من sun_path يرفض قبل أي نداء نظام.
    دع بايتات_طويلة: متغير متجه ط8 = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < 300) { ألحق(بايتات_طويلة, 97); ك := ك + 1; }
    دع الاسم_الطويل: نص = من_بايتات(&بايتات_طويلة);
    طابق اتصل_يونكس(&الاسم_الطويل) مع
    | نتيجة.خطأ(الرمز) -> { لو (الرمز != -22) { أرجع 57; }; }
    | نتيجة.نجح(_) -> { أرجع 58; };

    طابق أزل_دليلا(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 59; }
    | نتيجة.نجح(_) -> {};
    أرجع 42;
}
