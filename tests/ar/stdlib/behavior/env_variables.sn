// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/env_variables.sn
// std.env.variables: لكل متغير مدرج اسم، والدليل الرئيسي غائب أو غير فارغ،
// ودليل العمل يغير ثم يستعاد.
استورد std.env.variables;
استورد std.env.environment;
استورد std.text.compare;

عرف الرئيسية(): عدد {
    طابق متغيرات_البيئة() مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المتغيرات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المتغيرات) مثل طبيعي)) {
            إذا (الطول(المتغيرات[ف].الاسم) == 0) { أرجع 2; };
            ف := ف + 1;
        }
    };
    طابق الدليل_الرئيسي() مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(اختياري.موجود(الرئيسي)) -> { إذا (الطول(الرئيسي) == 0) { أرجع 4; }; }
    | نتيجة.نجح(اختياري.لا_شيء) -> {};
    دع الأصلي: متغير نص = «»;
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(الدليل) -> { الأصلي := الدليل; };
    دع الجذر: نص = «/»;
    طابق غير_دليل_العمل(&الجذر) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(_) -> {};
    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الدليل) -> { إذا (!نصان_متساويان(&الدليل, &الجذر)) { أرجع 8; }; };
    طابق غير_دليل_العمل(&الأصلي) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(_) -> {};
    دع الفارغ: نص = «»;
    طابق غير_دليل_العمل(&الفارغ) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 10; };
    أرجع 42;
}
