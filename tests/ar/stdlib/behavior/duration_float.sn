// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/duration_float.sn
// std.time.duration_float: المدة بالثواني العائمة (Rust as_secs_f64 وtry_from_secs_f64،
// وGo Duration.Seconds)، بالتقريب إلى أقرب نانوثانية ورفض NaN واللانهاية والقيم خارج المدى.
استورد std.time.duration;
استورد std.time.duration_float;

عرف الرئيسية(): عدد {
    طابق مدة_من_مليثواني(1500) مع
    | اختياري.موجود(م) -> { لو (ثواني_المدة_ع64(&م) != 1.5) { أرجع 1; }; }
    | اختياري.لا_شيء -> { أرجع 2; };
    دع الصغيرة: مدة = مدة_من_نانوثواني(-1);
    لو (ثواني_المدة_ع64(&الصغيرة) != -0.000000001) { أرجع 3; };
    طابق مدة_من_ثواني_ع64(2.75) مع
    | اختياري.موجود(م) -> { لو (نانوثواني_المدة(&م) != 2750000000) { أرجع 4; }; }
    | اختياري.لا_شيء -> { أرجع 5; };
    طابق مدة_من_ثواني_ع64(-0.0000000016) مع
    | اختياري.موجود(م) -> { لو (نانوثواني_المدة(&م) != -2) { أرجع 6; }; }
    | اختياري.لا_شيء -> { أرجع 7; };
    طابق مدة_من_ثواني_ع64(0.0 / 0.0) مع
    | اختياري.موجود(_) -> { أرجع 8; }
    | اختياري.لا_شيء -> {};
    طابق مدة_من_ثواني_ع64(1.0e10) مع
    | اختياري.موجود(_) -> { أرجع 9; }
    | اختياري.لا_شيء -> {};
    طابق مدة_من_ثواني_ع32(0.25) مع
    | اختياري.موجود(م) -> { لو (نانوثواني_المدة(&م) != 250000000) { أرجع 10; }; }
    | اختياري.لا_شيء -> { أرجع 11; };
    دع اليوم: مدة = مدة_من_نانوثواني(86400000000000);
    لو (ثواني_المدة_ع32(&اليوم) != 86400.0) { أرجع 12; };
    أرجع 42;
}
