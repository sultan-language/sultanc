// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/allocation_counters.sn
// عدادات المخصص (std.os.allocation): بناء نص مملوك وإسقاطه يخصص ويحرر
// ويطلب بايتات، وقراءة العدادات لا تخصص شيئًا. بلا توجيه زوج: المفسر لا
// يستعمل مخصص std الذي يقرأ هذا عداداته.
استورد std.os.allocation;
استورد std.text.number;

عرف اعمل(ف: عدد): طبيعي {
    دع ن: نص = عدد_إلى_نص(ف * 1000003);
    أرجع الطول(ن) مثل طبيعي;
}

عرف الرئيسية(): عدد {
    دع أ0: ط64 = عدد_تخصيصات_النظام();
    دع أ1: ط64 = عدد_تخصيصات_النظام();
    إذا (أ1 != أ0) { أرجع 1; };
    دع ح0: ط64 = عدد_تحريرات_النظام();
    دع ب0: ط64 = بايتات_مطلوبة_النظام();
    دع ف: متغير عدد = 0;
    دع المجموع: متغير طبيعي = 0;
    طالما (ف < 100) { المجموع := المجموع + اعمل(ف); ف := ف + 1; }
    إذا (عدد_تخصيصات_النظام() < أ0 + 100) { أرجع 2; };
    إذا (عدد_تحريرات_النظام() < ح0 + 100) { أرجع 3; };
    إذا (بايتات_مطلوبة_النظام() <= ب0) { أرجع 4; };
    إذا (المجموع == 0) { أرجع 5; };
    أرجع 0;
}
