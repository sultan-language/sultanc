// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http1_request_views.sn
// عروض طلبات HTTP/1 بلا نسخ (std.http.http1.views): الطريقة والهدف والرؤوس
// والجسم مدايات في مخزن المفكك تُقارن في مكانها (أسماء الرؤوس بلا حالة)، وطلبان
// متتاليان في مخزن واحد يُستهلكان بالترتيب، والتحويل إلى طلب مخزن يطابق المحلل
// المخزن، والطريقة وأسماء الرؤوس الشائعة نصوص ثابتة.
استورد std.http.model;
استورد std.http.limits;
استورد std.http.http1.common;
استورد std.http.http1.views;
استورد std.http.http1.request_parser;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف الرئيسية(): عدد {
    دع المفكك: متغير مفكك_ويب1 = مفكك_ويب1_جديد(حدود_ويب_افتراضية());
    دع النص: نص = "GET /a?x=1 HTTP/1.1\r\nHost: example.com\r\nX-Token: abc \r\n\r\nPOST /b HTTP/1.1\r\nhost: h\r\nContent-Length: 3\r\n\r\nxyz";
    دع البايتات: متجه ط8 = بايتات_من_نص(النص);
    غذ_مفكك_ويب1(&متغير المفكك, &البايتات);

    دع الأول: طلب_ويب1_معروض;
    طابق التالي_معروضا_من_مفكك_ويب1(&المفكك) مع
    | نتيجة.نجح(اختياري.موجود(ط)) -> { الأول := ط; }
    | _ -> { أرجع 1; };
    إذا (!عرض_يساوي_ويب(&المفكك.المخزن, الأول.الطريقة, &«GET»)) { أرجع 2; };
    إذا (!عرض_يساوي_ويب(&المفكك.المخزن, الأول.الهدف, &«/a?x=1»)) { أرجع 3; };
    طابق قيمة_رأس_معروض_ويب(&المفكك.المخزن, &الأول, &«x-token») مع
    | اختياري.موجود(ق) -> { إذا (!عرض_يساوي_ويب(&المفكك.المخزن, ق, &«abc»)) { أرجع 4; }; }
    | اختياري.لا_شيء -> { أرجع 5; };
    دع المخزن_كطلب: طلب_ويب_مخزن = طلب_من_معروض_ويب(&المفكك.المخزن, &الأول);
    إذا (!نصان_متساويان(&المخزن_كطلب.الرؤوس[0].الاسم, &«host»)) { أرجع 6; };
    أنه_طلب_معروض_من_مفكك_ويب1(&متغير المفكك, &الأول);

    دع الثاني: طلب_ويب1_معروض;
    طابق التالي_معروضا_من_مفكك_ويب1(&المفكك) مع
    | نتيجة.نجح(اختياري.موجود(ط)) -> { الثاني := ط; }
    | _ -> { أرجع 7; };
    إذا (!عرض_يساوي_ويب(&المفكك.المخزن, الثاني.الطريقة, &«POST»)) { أرجع 8; };
    إذا (!عرض_يساوي_ويب(&المفكك.المخزن, الثاني.الجسم, &«xyz»)) { أرجع 9; };
    أنه_طلب_معروض_من_مفكك_ويب1(&متغير المفكك, &الثاني);
    إذا (بايتات_معلقة_في_مفكك_ويب1(&المفكك) != 0) { أرجع 10; };

    // The buffered parser agrees.
    غذ_مفكك_ويب1(&متغير المفكك, &البايتات);
    طابق التالي_من_مفكك_ويب1(&متغير المفكك) مع
    | نتيجة.نجح(اختياري.موجود(المحلل)) -> {
        دع الطلب: طلب_ويب_مخزن = خذ_طلب_محلل_ويب(المحلل);
        إذا (!نصان_متساويان(&الطلب.الطريقة, &«GET») || !نصان_متساويان(&الطلب.الهدف, &«/a?x=1»)) { أرجع 11; };
        إذا (!نصان_متساويان(&الطلب.الرؤوس[1].الاسم, &«x-token») || !نصان_متساويان(&الطلب.الرؤوس[1].القيمة, &«abc»)) { أرجع 12; };
    }
    | _ -> { أرجع 13; };
    أرجع 0;
}
