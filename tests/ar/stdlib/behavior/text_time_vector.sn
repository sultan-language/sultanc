// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/text_time_vector.sn
// إضافات std.text وstd.time.duration_text (صيغة مدد Go في الاتجاهين)
// وstd.collections.vector.
استورد std.text.transform;
استورد std.text.search;
استورد std.text.compare;
استورد std.time.duration;
استورد std.time.duration_text;
استورد std.collections.vector;
استورد std.error.failure;
استورد std.error.from_duration;

عرف قارن_عددين(أ: &عدد, ب: &عدد): عدد {
    إذا (*أ < *ب) { أرجع -1; };
    إذا (*أ > *ب) { أرجع 1; };
    أرجع 0;
}
عرف عددان_متساويان(أ: &عدد, ب: &عدد): منطقي { أرجع *أ == *ب; }

عرف التنسيق_هو(النانو: عدد, المتوقع: نص): منطقي {
    دع القيمة: مدة = مدة_من_نانوثواني(النانو);
    دع النص: نص = نسق_المدة(&القيمة);
    أرجع نصان_متساويان(&النص, &المتوقع);
}

عرف التحليل_هو(النص: نص, النانو: عدد): منطقي {
    طابق حلل_المدة(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(القيمة) -> { أرجع نانوثواني_المدة(&القيمة) == النانو; };
}

عرف الرئيسية(): عدد {
    دع المتباعد: نص = "  alpha\tbeta \n غاما  ";
    دع الكلمات: متجه نص = قسم_بالفراغات(&المتباعد);
    دع غاما: نص = "غاما";
    إذا (الطول(الكلمات) != 3 || !نصان_متساويان(&الكلمات[2], &غاما)) { أرجع 1; };
    دع المفصول: نص = "a,b,c,d";
    دع الفاصلة: نص = ",";
    دع اثنان: متجه نص = قسم_النص_بحد(&المفصول, &الفاصلة, 2);
    دع الباقي: نص = "b,c,d";
    إذا (الطول(اثنان) != 2 || !نصان_متساويان(&اثنان[1], &الباقي)) { أرجع 2; };
    دع صفر: متجه نص = قسم_النص_بحد(&المفصول, &الفاصلة, 0);
    إذا (الطول(صفر) != 0) { أرجع 3; };
    دع الشرطة: نص = "-";
    دع المستبدل: نص = استبدل_في_النص_بحد(&المفصول, &الفاصلة, &الشرطة, 2);
    دع المستبدل_المتوقع: نص = "a-b-c,d";
    إذا (!نصان_متساويان(&المستبدل, &المستبدل_المتوقع)) { أرجع 4; };
    دع الملف: نص = "التقرير.tar.اللاحقة_المضغوطة";
    دع التقرير: نص = "التقرير.";
    دع اللاحقة_المضغوطة: نص = ".اللاحقة_المضغوطة";
    طابق أزل_البادئة(&الملف, &التقرير) مع
    | اختياري.موجود(الذيل) -> { دع الذيل_المتوقع: نص = "tar.اللاحقة_المضغوطة"; إذا (!نصان_متساويان(&الذيل, &الذيل_المتوقع)) { أرجع 5; }; }
    | اختياري.لا_شيء -> { أرجع 6; };
    طابق أزل_اللاحقة(&الملف, &اللاحقة_المضغوطة) مع
    | اختياري.موجود(الرأس) -> { دع الرأس_المتوقع: نص = "التقرير.tar"; إذا (!نصان_متساويان(&الرأس, &الرأس_المتوقع)) { أرجع 7; }; }
    | اختياري.لا_شيء -> { أرجع 8; };
    طابق أزل_البادئة(&الملف, &اللاحقة_المضغوطة) مع
    | اختياري.موجود(_) -> { أرجع 9; }
    | اختياري.لا_شيء -> {};
    دع المختلط: نص = "SultanC 2026 سلطان";
    دع الصغير: نص = حول_النص_إلى_صغير_أسكي(&المختلط);
    دع الكبير: نص = حول_النص_إلى_كبير_أسكي(&المختلط);
    دع الصغير_المتوقع: نص = "sultanc 2026 سلطان";
    دع الكبير_المتوقع: نص = "SULTANC 2026 سلطان";
    إذا (!نصان_متساويان(&الصغير, &الصغير_المتوقع) || !نصان_متساويان(&الكبير, &الكبير_المتوقع)) { أرجع 10; };
    إذا (!نصان_متساويان_بلا_حالة_أسكي(&الصغير, &الكبير)) { أرجع 11; };
    دع موز: نص = "banana";
    دع مقطع: نص = "ana";
    دع فارغ: نص = "";
    إذا (عد_تكرارات_النص(&موز, &مقطع) != 1) { أرجع 12; };
    إذا (عد_تكرارات_النص(&المختلط, &فارغ) != عدد_محارف_النص(&المختلط) + 1) { أرجع 13; };
    إذا (عدد_محارف_النص(&المختلط) != 18) { أرجع 14; };

    إذا (!التنسيق_هو(0, "0s") || !التنسيق_هو(1, "1ns") || !التنسيق_هو(1500, "1.5µs")) { أرجع 15; };
    إذا (!التنسيق_هو(2500000, "2.5ms") || !التنسيق_هو(1000000000, "1s") || !التنسيق_هو(-2000000000, "-2s")) { أرجع 16; };
    إذا (!التنسيق_هو(3723500000000, "1h2m3.5s") || !التنسيق_هو(60000000000, "1m0s")) { أرجع 17; };
    إذا (!التنسيق_هو(-9223372036854775807 - 1, "-2562047h47m16.854775808s")) { أرجع 18; };
    إذا (!التحليل_هو("1h2m3.5s", 3723500000000) || !التحليل_هو("-1.5h", -5400000000000)) { أرجع 19; };
    إذا (!التحليل_هو("300ms", 300000000) || !التحليل_هو("1.5µs", 1500) || !التحليل_هو("2us", 2000) || !التحليل_هو("0", 0)) { أرجع 20; };
    إذا (!التحليل_هو("+.5s", 500000000) || !التحليل_هو("1.000000001s", 1000000001)) { أرجع 21; };
    دع سيئ: نص = "1d";
    طابق حلل_المدة(&سيئ) مع
    | نتيجة.خطأ(الإخفاق) -> {
        دع المحول: فشل = فشل_من_خطأ_مدة(&الإخفاق);
        دع النطاق: نص = "std.time";
        دع النوع: نص = "وحدة_مجهولة";
        إذا (!هل_من_نوع(&المحول, &النطاق, &النوع)) { أرجع 22; };
    }
    | نتيجة.نجح(_) -> { أرجع 23; };
    دع ضخم: نص = "3000000h";
    طابق حلل_المدة(&ضخم) مع
    | نتيجة.خطأ(خطأ_مدة.تجاوز) -> {}
    | _ -> { أرجع 24; };
    دع مشوه: نص = "1.s.";
    طابق حلل_المدة(&مشوه) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 25; };
    دع سالب: مدة = مدة_من_نانوثواني(-5);
    طابق مطلق_المدة(&سالب) مع
    | اختياري.موجود(القيمة) -> { إذا (نانوثواني_المدة(&القيمة) != 5) { أرجع 26; }; }
    | اختياري.لا_شيء -> { أرجع 27; };
    طابق اقسم_المدة(&سالب, 0) مع
    | اختياري.موجود(_) -> { أرجع 28; }
    | اختياري.لا_شيء -> {};

    دع الأعداد: متغير متجه عدد = [5, 3, 9, 1, 7];
    اعكس_المتجه(&متغير الأعداد);
    إذا (الأعداد[0] != 7 || الأعداد[4] != 5) { أرجع 29; };
    طابق موضع_الأكبر_في_المتجه(&الأعداد, قارن_عددين) مع
    | اختياري.موجود(الموضع) -> { إذا (الموضع != 2) { أرجع 30; }; }
    | اختياري.لا_شيء -> { أرجع 31; };
    طابق موضع_الأصغر_في_المتجه(&الأعداد, قارن_عددين) مع
    | اختياري.موجود(الموضع) -> { إذا (الموضع != 1) { أرجع 32; }; }
    | اختياري.لا_شيء -> { أرجع 33; };
    دع تسعة: عدد = 9;
    طابق ابحث_في_المتجه(&الأعداد, &تسعة, عددان_متساويان) مع
    | اختياري.موجود(الموضع) -> { إذا (الموضع != 2) { أرجع 34; }; }
    | اختياري.لا_شيء -> { أرجع 35; };
    دع أربعة: عدد = 4;
    إذا (هل_يحتوي_المتجه(&الأعداد, &أربعة, عددان_متساويان)) { أرجع 36; };
    دور_المتجه_يسارا(&متغير الأعداد, 2);
    إذا (الأعداد[0] != 9 || الأعداد[4] != 1) { أرجع 37; };
    أرجع 42;
}
