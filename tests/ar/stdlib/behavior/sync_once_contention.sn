// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.once: ثمانية خيوط تتسابق إلى التهيئة. ينفذ نفذ_مرة إغلاقه مرة واحدة
// بالضبط (ذرة تعد مرات التنفيذ)، ولا يعود أي مستدع إلا بعد تنفيذه (يرى كل منهم
// العلم الذي ضبطه). وخلية المرة تُضبط مرة واحدة بأول اقرأ_أو_هيئ؛ وكل خيط يقرأ
// تلك القيمة. النظير: tests/en/stdlib/behavior/sync_once_contention.sn. لا
// توجيه نظير: المفسر يشغل خيطا واحدا.
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.sync.once;
استورد std.thread.thread;

نوع حالة = { المرة: مرة, التنفيذات: ذرة_ط64, جاهز: ذرة_ط64, رأوا: ذرة_ط64, الخلية: خلية_مرة<ص64> };

عرف هيئ(ح: &مشترك<حالة>): فراغ {
    دع المشتركة: &حالة = اقرأ_مشترك(ح);
    دع قديم: ط64 = اجمع_واجلب_ط64(&(*المشتركة).التنفيذات, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    // أبطئ الفائز حتى ينتظر الآخرون فعلا.
    دع ف: متغير ص64 = 0;
    طالما (ف < 100000) { ف := ف + 1; }
    اخزن_ط64(&(*المشتركة).جاهز, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
}

عرف اثنان_وأربعون(): ص64 { أرجع 42; }

عرف تنافس(ح: مشترك<حالة>): فراغ {
    دع المشتركة: &حالة = اقرأ_مشترك(&ح);
    نفذ_مرة(&(*المشتركة).المرة, دالة(): فراغ -> هيئ(&ح));
    إذا (احمل_ط64(&(*المشتركة).جاهز, ترتيب_ذاكرة.تسلسلي()) == (1 مثل ط64)) {
        دع رأى: ط64 = اجمع_واجلب_ط64(&(*المشتركة).رأوا, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    };
    دع ق: &ص64 = اقرأ_أو_هيئ_خلية_مرة(&(*المشتركة).الخلية, دالة(): ص64 -> اثنان_وأربعون());
    إذا (*ق != (42 مثل ص64)) {
        دع خاطئ: ط64 = اجمع_واجلب_ط64(&(*المشتركة).رأوا, 1000 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    };
}

عرف الرئيسية(): ص32 {
    دع القيمة: حالة = {
        المرة: أنشئ_مرة(), التنفيذات: أنشئ_ذرة_ط64(0 مثل ط64), جاهز: أنشئ_ذرة_ط64(0 مثل ط64),
        رأوا: أنشئ_ذرة_ط64(0 مثل ط64), الخلية: أنشئ_خلية_مرة()
    };
    دع ح: مشترك<حالة> = أنشئ_مشترك(القيمة);
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع خ: متغير ص32 = 0;
    طالما (خ < 8) {
        دع نسختي: مشترك<حالة> = استنسخ_مشترك(&ح);
        طابق أطلق(دالة(): فراغ -> تنافس(نسختي)) مع
        | نتيجة.نجح(م) -> { ألحق(المقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        خ := خ + 1;
    }
    دع ض: متغير طبيعي = 0;
    طالما (ض < (الطول(المقابض) مثل طبيعي)) { انضم(&متغير المقابض[ض]); ض := ض + 1; }
    دع المشتركة: &حالة = اقرأ_مشترك(&ح);
    إذا (احمل_ط64(&(*المشتركة).التنفيذات, ترتيب_ذاكرة.تسلسلي()) != (1 مثل ط64)) { أرجع 2; };
    إذا (احمل_ط64(&(*المشتركة).رأوا, ترتيب_ذاكرة.تسلسلي()) != (8 مثل ط64)) { أرجع 3; };
    إذا (!هل_اكتملت_المرة(&(*المشتركة).المرة)) { أرجع 4; };
    طابق اقرأ_خلية_مرة(&(*المشتركة).الخلية) مع
    | اختياري.موجود(ق) -> { إذا (*ق != (42 مثل ص64)) { أرجع 5; }; }
    | اختياري.لا_شيء -> { أرجع 6; };
    // يُرفض الضبط الثاني: تحتفظ الخلية بقيمتها الأولى.
    إذا (اضبط_خلية_مرة(&(*المشتركة).الخلية, 7 مثل ص64)) { أرجع 7; };
    أرجع 0;
}
