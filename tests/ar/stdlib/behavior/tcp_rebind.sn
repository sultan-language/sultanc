// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/tcp_rebind.sn
// خادم أعيد تشغيله على منفذه يربطه من جديد فورا (يضبط std.net.tcp خيار
// SO_REUSEADDR لمقابس الاستماع على أنظمة يونكس، كما تفعل مكتبة Rust القياسية):
// يغلق جانب الخادم اتصالا مقبولا أولا فيبقى في TIME_WAIT، ثم يُربط العنوان
// نفسه مرة أخرى دون أي خيار.
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.تي_سي_بي;

عرف الرئيسية(): عدد {
    دع العنوان: socket_addr;
    طابق parse_socket_addr(&«127.0.0.1:38922») مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(ع) -> { العنوان := ع; };
    دع المستمع: tcp_listener;
    طابق tcp_bind(&العنوان, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(م) -> { المستمع := م; };
    دع العميل: tcp_stream;
    طابق tcp_connect(&العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(ت) -> { العميل := ت; };
    دع المقبول: tcp_stream;
    طابق tcp_accept(&المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(ت) -> { المقبول := ت; };
    // يغلق الخادم أولا: يدخل جانبه من الاتصال في TIME_WAIT.
    دع أ: نتيجة عدد, عدد = tcp_stream_close(المقبول);
    دع ب: نتيجة عدد, عدد = tcp_stream_close(العميل);
    دع ج: نتيجة عدد, عدد = tcp_listener_close(المستمع);
    طابق tcp_bind(&العنوان, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(مجددا) -> { دع د: نتيجة عدد, عدد = tcp_listener_close(مجددا); };
    أرجع 0;
}
