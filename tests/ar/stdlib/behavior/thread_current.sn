// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/thread_current.sn
// std.thread بلا إطلاق: النوم (thread::sleep في Rust) والتنازل (yield_now)
// ومعرف الخيط الحالي وعدد المعالجات المتاحة (available_parallelism). ينام
// البرنامج مللي ثانية ويتحقق بالساعة الرتيبة من أن المدة مضت، ويتحقق من أن
// المعرف ثابت وغير صفري، ومن أن عدد المعالجات واحد على الأقل.
استورد std.thread.thread;
استورد std.time.time;

عرف الرئيسية(): ص32 {
    دع المعرف: ط64 = معرف_الخيط_الحالي();
    لو (المعرف == 0) { أرجع 1; };
    لو (معرف_الخيط_الحالي() != المعرف) { أرجع 2; };
    طابق عدد_المعالجات_المتاحة() مع
    | نتيجة.نجح(العدد) -> { لو (العدد < 1) { أرجع 3; }; }
    | نتيجة.خطأ(_) -> { أرجع 4; };
    تنازل();
    دع البداية: عدد;
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { البداية := ن; }
    | نتيجة.خطأ(_) -> { أرجع 5; };
    نم(0, 1000000);
    دع النهاية: عدد;
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { النهاية := ن; }
    | نتيجة.خطأ(_) -> { أرجع 6; };
    لو (النهاية - البداية < 1000000) { أرجع 7; };
    أرجع 42;
}
