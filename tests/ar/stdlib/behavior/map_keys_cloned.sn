// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/map_keys_cloned.sn
// Key listings for keys that own memory (docs/en/reference/ownership.md, "Generic
// templates"): مفاتيح_خريطة_شجرة_بي_منسوخة gives a copy of each key in order,
// and مفاتيح_الخريطة_بناسخ copies each key with the function it is given; the
// maps keep their own keys.
استورد المكتبة.مجموعات.خريطة_شجرية;
استورد المكتبة.مجموعات.خريطة;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.نصوص.من_بايتات;

عرف هاش_الطول(القيمة: &نص): طبيعي { أرجع الطول(*القيمة) مثل طبيعي; }
عرف نص_مساو(الأول: &نص, الثاني: &نص): منطقي { أرجع نصان_متساويان(الأول, الثاني); }

عرف الرئيسية(): عدد {
    دع العدد: متغير خريطة_شجرة_بي<نص, عدد> = أنشئ_خريطة_شجرة_بي(قارن_نصين_معجميا);
    أدرج_في_خريطة_شجرة_بي(&متغير العدد, «باء», 2);
    أدرج_في_خريطة_شجرة_بي(&متغير العدد, «ألف», 1);
    دع المفاتيح: متجه نص = مفاتيح_خريطة_شجرة_بي_منسوخة(&العدد);
    إذا ((الطول(المفاتيح) مثل طبيعي) != 2) { أرجع 1; };
    دع الأول: نص = «ألف»;
    إذا (!نصان_متساويان(&المفاتيح[0], &الأول)) { أرجع 2; };
    دع الكلمات: متغير الخريطة<نص, عدد> = أنشئ_الخريطة(هاش_الطول, نص_مساو);
    طابق أدرج_في_الخريطة(&متغير الكلمات, «جيم», 3) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { أرجع 3; };
    دع مفاتيح_الكلمات: متجه نص = مفاتيح_الخريطة_بناسخ(&الكلمات, انسخ_نص);
    إذا ((الطول(مفاتيح_الكلمات) مثل طبيعي) != 1) { أرجع 4; };
    دع جيم: نص = «جيم»;
    إذا (!نصان_متساويان(&مفاتيح_الكلمات[0], &جيم)) { أرجع 5; };
    إذا ((طول_خريطة_شجرة_بي(&العدد) مثل طبيعي) != 2) { أرجع 6; };
    أرجع 42;
}
