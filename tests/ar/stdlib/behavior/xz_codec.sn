// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/xz_codec.sn
// std.compression.xz وstd.compression.lzma: تيارات ‎.xz كتبتها xz 5.4 بالتحقق CRC64
// وCRC32 وSHA-256 ودون تحقق، وبمرشحي x86 BCJ وDelta، وتياران متتاليان بينهما حشو،
// وملف ‎.lzma؛ ومخرجات المرمزات نفسها (‎.xz و‎.lzma وLZMA2 الخام) تعود كما كانت؛
// والتيارات التالفة (الرقم السحري، وCRC الترويسة، وتحقق البيانات، والبتر، وحد
// الإخراج، وقلب البتات) تنتهي بأخطاء.
استورد std.encoding.hex;
استورد std.fuzz.core;
استورد std.checksum.checksum;
استورد std.compression.xz;
استورد std.compression.lzma;

عرف من_سداسي(النص: نص): متجه ط8 {
    طابق فك_سداسي(&النص) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { دع فارغ: متجه ط8 = []; أرجع فارغ; };
}

عرف متساويان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف يفك_إلى(التيار: &متجه ط8, المتوقع: &متجه ط8): منطقي {
    طابق فك_ضغط_إكس_زد(التيار) مع
    | نتيجة.نجح(ق) -> { أرجع متساويان(&ق, المتوقع); }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف مكرر(الوحدة: &متجه ط8, المرات: طبيعي, الذيل: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ك: متغير طبيعي = 0;
    طالما (ك < المرات) {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الوحدة) مثل طبيعي)) { ألحق(الناتج, (*الوحدة)[ف]); ف := ف + 1; }
        ك := ك + 1;
    }
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الذيل) مثل طبيعي)) { ألحق(الناتج, (*الذيل)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف خاطئ(التيار: &متجه ط8, الحد: طبيعي): منطقي {
    طابق فك_ضغط_إكس_زد_بحد(التيار, الحد) مع
    | نتيجة.نجح(_) -> { أرجع خطأ; }
    | نتيجة.خطأ(_) -> { أرجع صواب; };
}

عرف الرئيسية(): عدد {
    دع الجملة: متجه ط8 = من_سداسي(«53756c74616e4320787a20746573743a2074686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f672e20»);
    دع الأرقام: متجه ط8 = من_سداسي(«30313233343536373839»);
    دع النص: متجه ط8 = مكرر(&الجملة, 4, &الأرقام);
    دع الوحدة: متجه ط8 = من_سداسي(«554889e5e81000000090e820010000c3»);
    دع لا_شيء_فيه: متجه ط8 = [];
    دع الشفرة: متجه ط8 = مكرر(&الوحدة, 8, &لا_شيء_فيه);
    دع ت6: متجه ط8 = من_سداسي(«fd377a585a000004e6d6b4460200210116000000742fe5a3e00101004a5d00299d49877763edbf826504dda7d9392ece028fce2bd2247da8ca314babf96a66b75606b13512aa5497b89e2d8dfed6fbcb5890dbef607c80d6d9a77c8ddfa2fb2236181c2ec80c87c4d200000033424e314be9d46d0001668202000000e313d77cb1c467fb020000000004595a»);
    دع ت32: متجه ط8 = من_سداسي(«fd377a585a0000016922de360200210116000000742fe5a3e00101004a5d00299d49877763edbf826504dda7d9392ece028fce2bd2247da8ca314babf96a66b75606b13512aa5497b89e2d8dfed6fbcb5890dbef607c80d6d9a77c8ddfa2fb2236181c2ec80c87c4d200000058b59d430001628202000000f55146e73e300d8b020000000001595a»);
    دع ت_شا: متجه ط8 = من_سداسي(«»);
    دع ت_بلا: متجه ط8 = من_سداسي(«fd377a585a000000ff12d941020021010c0000008f98419ce00101004b5d00299d49877763edbf826504dda7d9392ece028fce2bd2247da8ca312b5b80fab068d30b7aad27f5379ef168d9f16afdacd2632f1652d286c88511c80a9202052cc823cb1c56185fdb61a81e000000015f82020000008645a25fa8000afc020000000000595a»);
    دع ب_إكس86: متجه ط8 = من_سداسي(«fd377a585a000004e6d6b44602010400210116000d86351fe0007f00315d002a920da4e4be93cfaf55ee34d6f9c3a799ecd1882b2fa81d82168081927ad6bdbd13babc96b8536ebf9b50726be66aa00000000000a8997338894fd15b00014d8001000000981ac979b1c467fb020000000004595a»);
    دع ب_فرق: متجه ط8 = من_سداسي(«fd377a585a000004e6d6b446020103010f2101162f30a7b6e0007f00165d002a920da4e4be6fe1af55ee30bf6fc3a72c3a025f0000000000a8997338894fd15b00013280010000008ca5bd83b1c467fb020000000004595a»);
    دع ت_لزما: متجه ط8 = من_سداسي(«5d00008000ffffffffffffffff00299d49877763edbf826504dda7d9392ece028fce2bd2247da8ca314babf96a66b75606b13512aa5497b89e2d8dfed6fbcb5890dbef607c80d6d9a77c8ddfa2fb2236181c2ec80d9af89dffffa0ff8000»);
    إذا (!يفك_إلى(&ت6, &النص)) { أرجع 1; };
    إذا (!يفك_إلى(&ت32, &النص)) { أرجع 2; };
    إذا (!يفك_إلى(&ت_شا, &النص)) { أرجع 3; };
    إذا (!يفك_إلى(&ت_بلا, &النص)) { أرجع 4; };
    إذا (!يفك_إلى(&ب_إكس86, &الشفرة)) { أرجع 5; };
    إذا (!يفك_إلى(&ب_فرق, &الشفرة)) { أرجع 6; };
    طابق فك_ضغط_إل_زد_إم_إيه(&ت_لزما) مع
    | نتيجة.نجح(ق) -> { إذا (!متساويان(&ق, &النص)) { أرجع 7; }; }
    | نتيجة.خطأ(_) -> { أرجع 8; };

    // تياران بينهما أربعة بايتات من حشو التيار.
    دع الحشو: متجه ط8 = [0, 0, 0, 0];
    دع المجموع: متغير متجه ط8 = مكرر(&ت6, 1, &الحشو);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ت32) مثل طبيعي)) { ألحق(المجموع, ت32[ف]); ف := ف + 1; }
    دع مرتين: متجه ط8 = مكرر(&النص, 2, &لا_شيء_فيه);
    إذا (!يفك_إلى(&المجموع, &مرتين)) { أرجع 9; };

    // المرمزات.
    دع المضغوط: متجه ط8 = اضغط_إكس_زد(&النص);
    إذا ((الطول(المضغوط) مثل طبيعي) >= (الطول(النص) مثل طبيعي) || !يفك_إلى(&المضغوط, &النص)) { أرجع 10; };
    دع مضغوط_الشفرة: متجه ط8 = اضغط_إكس_زد(&الشفرة);
    إذا (!يفك_إلى(&مضغوط_الشفرة, &الشفرة)) { أرجع 11; };
    دع مضغوط_فارغ: متجه ط8 = اضغط_إكس_زد(&لا_شيء_فيه);
    إذا (!يفك_إلى(&مضغوط_فارغ, &لا_شيء_فيه)) { أرجع 12; };
    دع منفرد: متجه ط8 = اضغط_إل_زد_إم_إيه(&النص);
    طابق فك_ضغط_إل_زد_إم_إيه(&منفرد) مع
    | نتيجة.نجح(ق) -> { إذا (!متساويان(&ق, &النص)) { أرجع 13; }; }
    | نتيجة.خطأ(_) -> { أرجع 14; };
    دع الخام: متجه ط8 = اضغط_إل_زد_إم_إيه2(&النص);
    طابق فك_ضغط_إل_زد_إم_إيه2(&الخام, حجم_قاموس_ضغط_إل_زد_إم_إيه2(الطول(النص) مثل طبيعي), 0) مع
    | نتيجة.نجح(ق) -> { إذا (!متساويان(&ق, &النص)) { أرجع 15; }; }
    | نتيجة.خطأ(_) -> { أرجع 16; };

    // تيارات تالفة.
    دع رقم_خاطئ: متجه ط8 = فز_استبدل_بايتا(&ت6, 1, 0x38);
    طابق فك_ضغط_إكس_زد(&رقم_خاطئ) مع
    | نتيجة.نجح(_) -> { أرجع 17; }
    | نتيجة.خطأ(خطأ_إكس_زد.ترويسة_غير_صالحة) -> { }
    | نتيجة.خطأ(_) -> { أرجع 18; };
    دع ترويسة_خاطئة: متجه ط8 = فز_استبدل_بايتا(&ت6, 8, 0);
    طابق فك_ضغط_إكس_زد(&ترويسة_خاطئة) مع
    | نتيجة.نجح(_) -> { أرجع 19; }
    | نتيجة.خطأ(خطأ_إكس_زد.سي_ار_سي_غير_صالح) -> { }
    | نتيجة.خطأ(_) -> { أرجع 20; };
    دع تحقق_خاطئ: متجه ط8 = فز_استبدل_بايتا(&ت6, 108, 0x34);
    طابق فك_ضغط_إكس_زد(&تحقق_خاطئ) مع
    | نتيجة.نجح(_) -> { أرجع 21; }
    | نتيجة.خطأ(خطأ_إكس_زد.تحقق_غير_مطابق) -> { }
    | نتيجة.خطأ(_) -> { أرجع 22; };
    دع مبتور: متجه ط8 = فز_احذف_مدى(&ت6, 70, 70);
    إذا (!خاطئ(&مبتور, 0)) { أرجع 23; };
    طابق فك_ضغط_إكس_زد_بحد(&ت6, 100) مع
    | نتيجة.نجح(_) -> { أرجع 24; }
    | نتيجة.خطأ(خطأ_إكس_زد.تجاوز_حد_الإخراج) -> { }
    | نتيجة.خطأ(_) -> { أرجع 25; };
    دع القلبات: متغير طبيعي = 0;
    دع البت: متغير طبيعي = 3;
    طالما (القلبات < 5) {
        دع المقلوب: متجه ط8 = فز_اقلب_بتا(&ت6, البت % ((الطول(ت6) مثل طبيعي) * 8));
        إذا (!خاطئ(&المقلوب, 100000)) { أرجع 26; };
        البت := البت + 131;
        القلبات := القلبات + 1;
    }

    // قيمة التحقق لـ CRC-64/XZ.
    دع العينة: متجه ط8 = من_سداسي(«313233343536373839»);
    إذا (احسب_سي_ار_سي64(&العينة) != 0x995DC9BBDF1939FA) { أرجع 27; };
    أرجع 42;
}
