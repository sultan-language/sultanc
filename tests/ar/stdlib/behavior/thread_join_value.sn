// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// النظير: tests/en/stdlib/behavior/thread_join_value.sn
// بلا توجيه زوج: المفسر يشغل خيط نظام واحدا ويتوقف عند الإطلاق.
// std.thread: خيط يعيد قيمة عبر الضم (JoinHandle<T>::join في Rust). يطلق
// البرنامج خيطين بأطلق_بقيمة: الأول يجمع الأعداد من 1 إلى 1000 ويعيد ط64،
// والثاني يبني نصا (7 × 1001) ويعيده. يعيد الضم الأول القيمة، والضم الثاني لا_شيء.
استورد std.thread.thread;
استورد std.text.compare;
استورد std.text.number;

عرف اجمع_حتى(الحد: ط64): ط64 {
    دع المجموع: متغير ط64 = 0;
    دع ف: متغير ط64 = 1;
    طالما (ف <= الحد) { المجموع := المجموع + ف; ف := ف + 1; }
    أرجع المجموع;
}

عرف ابن_نص(العدد: طبيعي): نص { أرجع طبيعي_إلى_نص(العدد * 1001); }

عرف الرئيسية(): ص32 {
    دع الحد: ط64 = 1000;
    دع الجمع: متغير مقبض_خيط_بقيمة<ط64>;
    طابق أطلق_بقيمة(دالة(): ط64 -> اجمع_حتى(الحد)) مع
    | نتيجة.نجح(م) -> { الجمع := م; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
    دع البناء: متغير مقبض_خيط_بقيمة<نص>;
    طابق أطلق_بقيمة(دالة(): نص -> ابن_نص(7)) مع
    | نتيجة.نجح(م) -> { البناء := م; }
    | نتيجة.خطأ(_) -> { أرجع 2; };

    طابق انضم_بقيمة(&متغير الجمع) مع
    | اختياري.موجود(المجموع) -> { لو (المجموع != 500500) { أرجع 3; }; }
    | اختياري.لا_شيء -> { أرجع 4; };
    طابق انضم_بقيمة(&متغير البناء) مع
    | اختياري.موجود(النص) -> {
        دع المتوقع: نص = «7007»;
        لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 5; };
    }
    | اختياري.لا_شيء -> { أرجع 6; };
    طابق انضم_بقيمة(&متغير الجمع) مع
    | اختياري.موجود(_) -> { أرجع 7; }
    | اختياري.لا_شيء -> { };
    أرجع 42;
}
