// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// النظير: tests/en/stdlib/behavior/thread_nested.sn
// بلا توجيه زوج: المفسر يشغل خيط نظام واحدا ويتوقف عند الإطلاق.
// std.thread: خيوط متداخلة. يطلق الخيط الرئيسي أربعة خيوط، ويطلق كل منها
// خيطين داخليين يضمهما ويجمع قيمتيهما، ثم يعيد المجموع عبر الضم. الخيط
// الداخلي يعيد مربع رقمه. يتحقق البرنامج من مجموع كل خيط خارجي.
استورد std.thread.thread;

عرف مربع(ن: ط64): ط64 { أرجع ن * ن; }

عرف شغل_الداخليين(الأساس: ط64): ط64 {
    دع المجموع: متغير ط64 = 0;
    دع مقابض: متغير متجه مقبض_خيط_بقيمة<ط64> = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < 2) {
        دع الرقم: ط64 = (الأساس * 2) + ف;
        طابق أطلق_بقيمة(دالة(): ط64 -> مربع(الرقم)) مع
        | نتيجة.نجح(م) -> { ألحق(مقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 0; };
        ف := ف + 1;
    }
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(مقابض) مثل طبيعي)) {
        طابق انضم_بقيمة(&متغير مقابض[ق]) مع
        | اختياري.موجود(القيمة) -> { المجموع := المجموع + القيمة; }
        | اختياري.لا_شيء -> { أرجع 0; };
        ق := ق + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): ص32 {
    دع مقابض: متغير متجه مقبض_خيط_بقيمة<ط64> = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < 4) {
        دع الأساس: ط64 = ف;
        طابق أطلق_بقيمة(دالة(): ط64 -> شغل_الداخليين(الأساس)) مع
        | نتيجة.نجح(م) -> { ألحق(مقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    }
    دع ق: متغير طبيعي = 0;
    طالما (ق < 4) {
        دع الأول: ط64 = (ق مثل ط64) * 2;
        دع المتوقع: ط64 = (الأول * الأول) + ((الأول + 1) * (الأول + 1));
        طابق انضم_بقيمة(&متغير مقابض[ق]) مع
        | اختياري.موجود(القيمة) -> { لو (القيمة != المتوقع) { أرجع 2; }; }
        | اختياري.لا_شيء -> { أرجع 3; };
        ق := ق + 1;
    }
    أرجع 42;
}
