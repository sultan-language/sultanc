// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/allocation_counters_run.sn
// عدادات التخصيص في المكتبة القياسية، للعملية كلها ولكل خيط، تعطي الأجوبة
// نفسها في الملف التنفيذي وتحت `run`، حيث يخدم المفسر الآلي الذاكرة بنفسه
// ويجيب عن النداء إلى العداد من عداداته. ويجري خط تحسين MSIR للاثنين، فعليه
// أن يبقي تلك النداءات: العداد المضمَّن يقرأ عدادات المكتبة القياسية التي لا
// تحدّثها ذاكرة المفسر، فكانت كل العدادات تقرأ 0 تحت `run`.
استورد std.os.allocation;
استورد std.os.allocation_cache;
استورد std.text.number;
استورد std.io.print;
استورد std.io.println;

عرف اعمل(ف: عدد): طبيعي {
    دع ن: نص = عدد_إلى_نص(ف * 1000003);
    أرجع الطول(ن) مثل طبيعي;
}

عرف افحص(الوصف: نص, صحيح: منطقي): عدد {
    اطبع(الوصف);
    إذا (صحيح) { اطبع_سطر(": yes"); أرجع 0; };
    اطبع_سطر(": no");
    أرجع 1;
}

عرف الرئيسية(): عدد {
    دع أ0: ط64 = عدد_تخصيصات_النظام();
    دع خح0: ط64 = عدد_تحريرات_الخيط();
    دع خب0: ط64 = بايتات_مطلوبة_الخيط();
    دع القراءة: منطقي = عدد_تخصيصات_النظام() == أ0 && عدد_تحريرات_الخيط() == خح0;
    دع ح0: ط64 = عدد_تحريرات_النظام();
    دع ب0: ط64 = بايتات_مطلوبة_النظام();
    دع ف: متغير عدد = 0;
    دع المجموع: متغير طبيعي = 0;
    طالما (ف < 100) { المجموع := المجموع + اعمل(ف); ف := ف + 1; }
    دع الفاشلة: متغير عدد = 0;
    الفاشلة := الفاشلة + افحص(«reading the counters allocates nothing», القراءة);
    الفاشلة := الفاشلة + افحص(«allocations counted», عدد_تخصيصات_النظام() >= أ0 + 100);
    الفاشلة := الفاشلة + افحص(«frees counted», عدد_تحريرات_النظام() >= ح0 + 100);
    الفاشلة := الفاشلة + افحص(«requested bytes counted», بايتات_مطلوبة_النظام() > ب0);
    الفاشلة := الفاشلة + افحص(«this thread's frees counted», عدد_تحريرات_الخيط() >= خح0 + 100);
    الفاشلة := الفاشلة + افحص(«this thread's requested bytes counted», بايتات_مطلوبة_الخيط() > خب0);
    إذا (المجموع == 0) { أرجع 100; };
    أرجع الفاشلة;
}
