// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/async_tasks.sn
// std.async في خيط واحد: ثلاث مهام تنام كل منها 40 ملي ثانية تنتهي معا
// (أقل بكثير من 120 ملي ثانية لو تتابعت) ويعيد الانتظار ناتج كل منها مرة
// واحدة؛ ومهمة تنتظر مهمة أخرى تعلق نفسها فقط؛ والتنازل يشغل المهمة
// الجاهزة أولا؛ ومهمتان تتحادثان عبر TCP المحلي بقبول وقراءة وكتابة غير
// متزامنة، ومهمة الخادم تنتظر في المستطلع حتى تتصل مهمة العميل التي تبدأ لاحقا.
استورد std.async.runtime;
استورد std.async.net;
استورد std.net.socket_address;
استورد std.net.tcp;
استورد std.time.time;

عرف الآن(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ت) -> { أرجع ت; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف نائم(النانو: عدد, القيمة: عدد): عدد {
    نم_مهمة(النانو);
    أرجع القيمة;
}

عرف ضعف_النائم(): عدد {
    دع الداخلية: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(10000000, 21));
    طابق انتظر_مهمة(&متغير الداخلية) مع
    | اختياري.موجود(ق) -> { أرجع ق * 2; }
    | اختياري.لا_شيء -> { أرجع -1; };
}

عرف أصفار(ع: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ع) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

عرف العنوان(): نتيجة عنوان_مقبس, خطأ_تحليل_عنوان_مقبس {
    دع النص: نص = «127.0.0.1:38519»;
    أرجع حلل_عنوان_مقبس(&النص);
}

// يقبل اتصالا واحدا ويجيب كل بايت مضافا إليه واحد.
عرف اخدم_مرة(): عدد {
    دع العنوان_المحلل: متغير عنوان_مقبس;
    طابق العنوان() مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(ع) -> { العنوان_المحلل := ع; };
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_غير_متزامن(&العنوان_المحلل, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(م) -> { المستمع := م; };
    دع التدفق: تدفق_تي_سي_بي;
    طابق اقبل_غير_متزامن(&المستمع) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(ت) -> { التدفق := ت; };
    دع المخزن: متغير متجه ط8 = أصفار(16);
    دع العدد: متغير عدد = 0;
    طابق اقرأ_غير_متزامن(&التدفق, &متغير المخزن, 0, 16) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(ك) -> { العدد := ك; };
    دع الرد: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < العدد) { ألحق(الرد, المخزن[ف مثل طبيعي] + 1); ف := ف + 1; }
    طابق اكتب_الكل_غير_متزامن(&التدفق, &الرد) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(_) -> { };
    // ينتظر إغلاق العميل أولا، فتكون حالة TIME_WAIT على منفذ العميل لا على
    // منفذ الاستماع (يربطه التشغيل التالي من جديد).
    دع الباقي: متغير عدد = 1;
    طالما (الباقي > 0) {
        طابق اقرأ_غير_متزامن(&التدفق, &متغير المخزن, 0, 16) مع
        | نتيجة.خطأ(_) -> { الباقي := 0; }
        | نتيجة.نجح(ك) -> { الباقي := ك; };
    }
    دع غ1: نتيجة عدد, عدد = أغلق_غير_متزامن(التدفق);
    دع غ2: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(المستمع);
    أرجع 0;
}

عرف اتصل_مرة(): عدد {
    نم_مهمة(20000000);
    دع العنوان_المحلل: متغير عنوان_مقبس;
    طابق العنوان() مع
    | نتيجة.خطأ(_) -> { أرجع 16; }
    | نتيجة.نجح(ع) -> { العنوان_المحلل := ع; };
    دع التدفق: تدفق_تي_سي_بي;
    طابق اتصل_غير_متزامن(&العنوان_المحلل) مع
    | نتيجة.خطأ(_) -> { أرجع 11; }
    | نتيجة.نجح(ت) -> { التدفق := ت; };
    دع الرسالة: متجه ط8 = [1, 2, 3];
    طابق اكتب_الكل_غير_متزامن(&التدفق, &الرسالة) مع
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(_) -> { };
    دع المخزن: متغير متجه ط8 = أصفار(16);
    دع المستلم: متغير طبيعي = 0;
    طالما (المستلم < 3) {
        طابق اقرأ_غير_متزامن(&التدفق, &متغير المخزن, المستلم مثل عدد, 16 - (المستلم مثل عدد)) مع
        | نتيجة.خطأ(_) -> { أرجع 13; }
        | نتيجة.نجح(ك) -> {
            إذا (ك <= 0) { أرجع 14; };
            المستلم := المستلم + (ك مثل طبيعي);
        };
    }
    إذا (المخزن[0] != 2 || المخزن[1] != 3 || المخزن[2] != 4) { أرجع 15; };
    دع غ: نتيجة عدد, عدد = أغلق_غير_متزامن(التدفق);
    أرجع 0;
}

عرف الرئيسية(): عدد {
    إذا (!المهام_مدعومة()) { أرجع 1; };

    دع البداية: عدد = الآن();
    دع أ: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(40000000, 1));
    دع ب: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(40000000, 2));
    دع ج: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(40000000, 3));
    دع المجموع: متغير عدد = 0;
    طابق انتظر_مهمة(&متغير أ) مع
    | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
    | اختياري.لا_شيء -> { أرجع 2; };
    طابق انتظر_مهمة(&متغير ب) مع
    | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
    | اختياري.لا_شيء -> { أرجع 3; };
    طابق انتظر_مهمة(&متغير ج) مع
    | اختياري.موجود(ق) -> { المجموع := المجموع + ق; }
    | اختياري.لا_شيء -> { أرجع 4; };
    إذا (المجموع != 6) { أرجع 5; };
    إذا (الآن() - البداية >= 100000000) { أرجع 6; };
    // الانتظار الثاني لا يجد شيئا.
    طابق انتظر_مهمة(&متغير أ) مع
    | اختياري.موجود(_) -> { أرجع 7; }
    | اختياري.لا_شيء -> { };
    إذا (!انتهت_المهمة(&أ)) { أرجع 8; };

    // مهمة تنتظر مهمة.
    طابق شغل_غير_متزامن(دالة(): عدد -> ضعف_النائم()) مع
    | اختياري.موجود(ق) -> { إذا (ق != 42) { أرجع 9; }; }
    | اختياري.لا_شيء -> { أرجع 10; };

    // التنازل: المهمة المطلقة تعمل قبل أن يكمل المستدعي.
    دع د: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> 5);
    إذا (انتهت_المهمة(&د)) { أرجع 20; };
    تنازل_مهمة();
    إذا (!انتهت_المهمة(&د)) { أرجع 21; };
    طابق انتظر_مهمة(&متغير د) مع
    | اختياري.موجود(ق) -> { إذا (ق != 5) { أرجع 22; }; }
    | اختياري.لا_شيء -> { أرجع 23; };

    // TCP غير متزامن بين مهمتين.
    دع الخادم: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اخدم_مرة());
    دع العميل: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اتصل_مرة());
    طابق انتظر_مهمة(&متغير العميل) مع
    | اختياري.موجود(ق) -> { إذا (ق != 0) { أرجع 30 + ق; }; }
    | اختياري.لا_شيء -> { أرجع 30; };
    طابق انتظر_مهمة(&متغير الخادم) مع
    | اختياري.موجود(ق) -> { إذا (ق != 0) { أرجع 50 + ق; }; }
    | اختياري.لا_شيء -> { أرجع 50; };
    أرجع 0;
}
