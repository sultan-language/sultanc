// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/thread_allocation_cache.sn
// مخابئ التخصيص لكل خيط (std.os.allocation_cache): خيط std يعدّ تخصيصاته
// وتحريراته في مخبئه، فلا تتغير عدادات الخيط الرئيسي أثناء عمله، وتنضم
// عداداته إلى مجموع العملية بعد الانضمام. أربعة خيوط تبني وتسقط نصوصًا صغيرة
// معًا بلا قفل في المسار السريع، ثم يُعاد بناء الكومة بعدها دون تلف.
استورد std.os.allocation;
استورد std.os.allocation_cache;
استورد std.thread.thread;
استورد std.text.number;

عرف اعمل(): فراغ {
    دع ف: متغير عدد = 0;
    طالما (ف < 20000) {
        دع ن: نص = عدد_إلى_نص(ف * 7919);
        دع م: متغير متجه عدد = [];
        ألحق(م, ف);
        ف := ف + 1;
    }
    إذا (عدد_تخصيصات_الخيط() < 20000) { دع ص: عدد = 1 / (ف - ف); };
}

عرف الرئيسية(): عدد {
    دع قبل_الرئيسي: ط64 = عدد_تخصيصات_الخيط();
    دع قبل_الكل: ط64 = عدد_تخصيصات_النظام();
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع ك: متغير عدد = 0;
    طالما (ك < 4) {
        طابق أطلق(اعمل) مع
        | نتيجة.خطأ(_) -> { أرجع 1; }
        | نتيجة.نجح(م) -> { ألحق(المقابض, م); };
        ك := ك + 1;
    }
    ك := 0;
    طالما (ك < 4) {
        انضم(&متغير المقابض[ك مثل طبيعي]);
        ك := ك + 1;
    }
    // لا يخصص الخيط الرئيسي إلا ما يخصه: متجه المقابض، وبضع كتل لكل إطلاق
    // لدالة مدخل الخيط (وفي macOS خلايا pthread_attr_t وpthread_t ومعرف
    // الخيط التي يخصصها threads.sn لداروين في المكتبة القياسية في الأسطر 50
    // و66 و88). العدد المقيس للإطلاق مع الإلحاق، والانضمام صفر: لينكس 4، 3،
    // 3، 3 = 13؛ وmacOS 7، 6، 6، 6 = 25 (Apple M3). الحد 36 = 4 * 8 + 4: ثمانية
    // لكل إطلاق وأربعة للمتجه. لا يزيل الحد الكتل الثلاث الزائدة في macOS، بل
    // يكف عن افتراض عدد لينكس. وإن حُسبت تخصيصات خيط عامل (20000 فأكثر) على
    // الخيط الرئيسي فشل الاختبار.
    إذا (عدد_تخصيصات_الخيط() - قبل_الرئيسي > 36) { أرجع 2; };
    إذا (عدد_تخصيصات_النظام() - قبل_الكل < 80000) { أرجع 3; };
    دع ن: نص = عدد_إلى_نص(123456789);
    إذا (الطول(ن) != 9) { أرجع 4; };
    أرجع 0;
}
