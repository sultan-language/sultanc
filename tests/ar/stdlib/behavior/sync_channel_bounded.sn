// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.channel: قناة متزامنة بحد 2 تحمل رسالتين على الأكثر. محاولة الإرسال
// إلى قناة ممتلئة تعيد القيمة (ممتلئة)؛ ثم يرسل خيط منتج 200 عدد بالإرسال
// المنتظِر، الذي ينتظر طالما القناة ممتلئة، فلا يسبق المستلم بأكثر من رسالتين
// (ذرتان تعدان ما أُرسل وما استُقبل). النظير:
// tests/en/stdlib/behavior/sync_channel_bounded.sn. لا توجيه نظير: المفسر يشغل
// خيطا واحدا.
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.sync.channel;
استورد std.thread.thread;

عرف أنتج(م: &مرسل<ص64>, العدادات: &مشترك<متجه ذرة_ط64>): فراغ {
    دع ف: متغير ص64 = 0;
    طالما (ف < 200) {
        دع القيمة: ص64 = ف;
        طابق أرسل(م, القيمة) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع; };
        دع ع: &متجه ذرة_ط64 = اقرأ_مشترك(العدادات);
        دع المرسلة: ط64 = اجمع_واجلب_ط64(&(*ع)[0], 1 مثل ط64, ترتيب_ذاكرة.تسلسلي()) + (1 مثل ط64);
        دع المستقبلة: ط64 = احمل_ط64(&(*ع)[1], ترتيب_ذاكرة.تسلسلي());
        إذا (المرسلة > المستقبلة) {
            دع السبق: ط64 = المرسلة - المستقبلة;
            إذا (السبق > احمل_ط64(&(*ع)[2], ترتيب_ذاكرة.تسلسلي())) {
                اخزن_ط64(&(*ع)[2], السبق, ترتيب_ذاكرة.تسلسلي());
            };
        };
        ف := ف + 1;
    }
}

عرف ابدأ(م: مرسل<ص64>, العدادات: &مشترك<متجه ذرة_ط64>): اختياري مقبض_خيط {
    دع نسختي: مشترك<متجه ذرة_ط64> = استنسخ_مشترك(العدادات);
    طابق أطلق(دالة(): فراغ -> أنتج(&م, &نسختي)) مع
    | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ق); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع الطرفان: طرفا_قناة<ص64> = قناة_متزامنة(2);
    دع م: مرسل<ص64>;
    دع س: مستلم<ص64>;
    طابق الطرفان مع
    | { المرسل: أ, المستلم: ب } -> { م := أ; س := ب; };

    // تتسع القناة لرسالتين؛ وتعاد الثالثة.
    طابق حاول_الإرسال(&م, 1 مثل ص64) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع 1; };
    طابق حاول_الإرسال(&م, 2 مثل ص64) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق حاول_الإرسال(&م, 3 مثل ص64) مع
    | نتيجة.نجح(_) -> { أرجع 3; }
    | نتيجة.خطأ(خطأ_محاولة_إرسال.ممتلئة(ق)) -> { إذا (ق != (3 مثل ص64)) { أرجع 4; }; }
    | نتيجة.خطأ(_) -> { أرجع 5; };
    طابق استقبل(&س) مع | نتيجة.نجح(ق) -> { إذا (ق != (1 مثل ص64)) { أرجع 6; }; } | نتيجة.خطأ(_) -> { أرجع 7; };
    طابق استقبل(&س) مع | نتيجة.نجح(ق) -> { إذا (ق != (2 مثل ص64)) { أرجع 8; }; } | نتيجة.خطأ(_) -> { أرجع 9; };

    // المرسلة، والمستقبلة، وأقصى ما سبق به المرسل.
    دع الخلايا: متغير متجه ذرة_ط64 = [];
    ألحق(الخلايا, أنشئ_ذرة_ط64(0 مثل ط64));
    ألحق(الخلايا, أنشئ_ذرة_ط64(0 مثل ط64));
    ألحق(الخلايا, أنشئ_ذرة_ط64(0 مثل ط64));
    دع العدادات: مشترك<متجه ذرة_ط64> = أنشئ_مشترك(الخلايا);
    دع المقبض: متغير مقبض_خيط;
    طابق ابدأ(م, &العدادات) مع
    | اختياري.موجود(ق) -> { المقبض := ق; }
    | اختياري.لا_شيء -> { أرجع 10; };
    دع المتوقع: متغير ص64 = 0;
    طالما (المتوقع < 200) {
        // دع المنتج يملأ القناة قبل كل استقبال.
        دع دوران: متغير ص64 = 0;
        طالما (دوران < 2000) { دوران := دوران + 1; }
        طابق استقبل(&س) مع
        | نتيجة.نجح(ق) -> { إذا (ق != المتوقع) { أرجع 11; }; }
        | نتيجة.خطأ(_) -> { أرجع 12; };
        دع ع: &متجه ذرة_ط64 = اقرأ_مشترك(&العدادات);
        دع وصل: ط64 = اجمع_واجلب_ط64(&(*ع)[1], 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
        المتوقع := المتوقع + 1;
    }
    انضم(&متغير المقبض);
    // لم يسبق المرسل بأكثر من رسالتين، زائد واحدة قد يكون عدّها بعد أن حرر
    // استقبالٌ مكانا.
    دع النهائية: &متجه ذرة_ط64 = اقرأ_مشترك(&العدادات);
    إذا (احمل_ط64(&(*النهائية)[2], ترتيب_ذاكرة.تسلسلي()) > (3 مثل ط64)) { أرجع 13; };
    // ذهب كل المرسلين الآن: يبلّغ استقبل عن الانقطاع.
    طابق استقبل(&س) مع | نتيجة.نجح(_) -> { أرجع 14; } | نتيجة.خطأ(_) -> { };
    أرجع 0;
}
