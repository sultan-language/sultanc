// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفقد العملية وقتلها وانتظارها بمهلة على طفل حقيقي.
// تفاضلي: المفسر يشغل الطفل كما يشغله التنفيذي (clone يتفرع في عملية المفسر).
// نظير: tests/en/stdlib/behavior/process_kill.sn
استورد std.process.child;
استورد std.time.duration;

عرف الرئيسية(): عدد {
    دع البرنامج: نص = «/bin/sleep»;
    دع الوسائط: متجه نص = [«5»];
    دع الطفل: متغير عملية_طفلة = { المعرف: 0 };
    طابق شغل_عملية(&البرنامج, &الوسائط) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المشغلة) -> { الطفل := المشغلة; };
    طابق تفقد_عملية(&متغير الطفل) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(اختياري.موجود(_)) -> { أرجع 3; }
    | نتيجة.نجح(اختياري.لا_شيء) -> { };
    طابق اقتل_عملية(&متغير الطفل) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(اختياري.موجود(_)) -> { أرجع 5; }
    | نتيجة.نجح(اختياري.لا_شيء) -> { };
    طابق انتظر_عملية_مملوكة(&متغير الطفل) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(حالة_إنهاء.إشارة(9)) -> { }
    | نتيجة.نجح(_) -> { أرجع 7; };
    دع السريع: نص = «/bin/sh»;
    دع وسائط_السريع: متجه نص = [«-c», «exit 3»];
    دع الآخر: متغير عملية_طفلة = { المعرف: 0 };
    طابق شغل_عملية(&السريع, &وسائط_السريع) مع
    | نتيجة.خطأ(_) -> { أرجع 8; }
    | نتيجة.نجح(المشغلة) -> { الآخر := المشغلة; };
    دع الحد: مدة = مدة_من_نانوثواني(5000000000);
    طابق انتظر_عملية_بمهلة(&متغير الآخر, &الحد) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(اختياري.موجود(حالة_إنهاء.خرج(3))) -> { }
    | نتيجة.نجح(_) -> { أرجع 10; };
    أرجع 42;
}
