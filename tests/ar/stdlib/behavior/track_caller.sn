// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=ar
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: track_caller.stderr
// @@يتتبع_المستدعي (docs/ar/reference/testing.md): يمرر النداء موضعه، وتمرر
// الدالة المساعدة الموسومة الموضع الذي نوديت منه، وتمرر قيمة الدالة موضع
// تعريفها. والتأكيد الفاشل يُظهر موضعه تحت الإطار. والحالة 2 أو 3 أو 4 موضع
// خاطئ.
استورد المكتبة.تصحيح.تأكد;
استورد المكتبة.تصحيح.موقع;
استورد المكتبة.عمليات.اخرج;

@@يتتبع_المستدعي
عرف سطر_هنا(الموقع: موقع_مصدر): طبيعي { أرجع سطر_موقع_مصدر(&الموقع); }
@@يتتبع_المستدعي
عرف سطر_المستدعي(الموقع: موقع_مصدر): طبيعي { أرجع سطر_هنا(); }
عرف افحص(الشرط: منطقي, الحالة: عدد): فراغ { إذا (!الشرط) { اخرج(الحالة); }; }

عرف الرئيسية(): عدد {
    افحص(سطر_هنا() == 23, 2);
    افحص(سطر_المستدعي() == 24, 3);
    ليكن د: دالة(): طبيعي = سطر_هنا;
    افحص(د() == 17, 4);
    تأكد(1 + 1 == 2);
    تأكد(1 + 1 == 3);
    أرجع 0;
}
