// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/stdlib/behavior/text_slice_tokenizer.sn
// محلل رموز صغير يمر على سطر من نص مصدري ويسمي كل رمز بشريحة من النص
// (`&المصدر[البداية..النهاية]`، من النوع `&نص`) بلا نسخ: لا يتحرك عداد
// التخصيص في المكتبة القياسية أثناء عمله (docs/ar/reference/type-system.md،
// «شرائح النص»). الكلمة سلسلة من حروف أسكي اللاتينية وأرقامها أو من بايتات
// حروف غير أسكي، فكل شريحة تبدأ وتنتهي عند حد حرف؛ وأي بايت آخر غير المسافة
// رمز وحده.
استورد المكتبة.نظام_التشغيل.تخصيص;

عرف مسافة(ب: ط8): منطقي {
    أرجع ب == 32 || ب == 9 || ب == 10;
}

عرف من_كلمة(ب: ط8): منطقي {
    أرجع (ب >= 97 && ب <= 122) || (ب >= 65 && ب <= 90) || (ب >= 48 && ب <= 57) || ب >= 128;
}

// الرمز الذي يبدأ عند البايت `البداية` من النص: آخر بايت فيه.
عرف نهاية_الرمز(النص: &نص, البداية: عدد): عدد {
    ليكن النهاية: متغير عدد = البداية;
    إذا (من_كلمة((*النص)[البداية])) {
        طالما (النهاية + 1 < الطول(*النص) && من_كلمة((*النص)[النهاية + 1])) { النهاية := النهاية + 1; }
    };
    أرجع النهاية;
}

عرف الرئيسية(): عدد {
    ليكن المصدر: نص = «let total = سعر * 12 + tax;»;
    ليكن قبل: ط64 = عدد_تخصيصات_النظام();
    ليكن الموضع: متغير عدد = 0;
    ليكن الرموز: متغير عدد = 0;
    ليكن الكلمات_المحجوزة: متغير عدد = 0;
    ليكن الأعداد: متغير عدد = 0;
    ليكن العربية: متغير عدد = 0;
    ليكن بايتات_الأخير: متغير عدد = 0;
    طالما (الموضع < الطول(المصدر)) {
        إذا (مسافة(المصدر[الموضع])) {
            الموضع := الموضع + 1;
        } وإلا {
            ليكن النهاية: عدد = نهاية_الرمز(&المصدر, الموضع);
            ليكن الرمز: &نص = &المصدر[الموضع..النهاية];
            الرموز := الرموز + 1;
            إذا (الرمز == «let») { الكلمات_المحجوزة := الكلمات_المحجوزة + 1; };
            إذا (الرمز == «12») { الأعداد := الأعداد + 1; };
            إذا (*الرمز == «سعر») { العربية := العربية + 1; };
            بايتات_الأخير := الطول(*الرمز);
            الموضع := النهاية + 1;
        };
    }
    ليكن التخصيصات: ط64 = عدد_تخصيصات_النظام() - قبل;
    إذا (الرموز != 9) { أرجع 1; };
    إذا (الكلمات_المحجوزة != 1 || الأعداد != 1 || العربية != 1) { أرجع 2; };
    إذا (بايتات_الأخير != 1) { أرجع 3; };
    إذا (التخصيصات != 0) { أرجع 4; };
    أرجع 42;
}
