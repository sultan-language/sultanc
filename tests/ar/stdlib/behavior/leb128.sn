// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/leb128.sn
// أدوات LEB128 في std.encoding.varint (صيغ DWARF وWebAssembly وMach-O)
// والكتابة عند إزاحة في std.encoding.binary.
استورد std.encoding.varint;
استورد std.encoding.binary;

عرف بايتات_متطابقة(الفعلي: &متجه ط8, المتوقع: &متجه ط8): منطقي {
    إذا (الطول(*الفعلي) != الطول(*المتوقع)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الفعلي) مثل طبيعي)) {
        إذا ((*الفعلي)[ف] != (*المتوقع)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ليب_هو(القيمة: طبيعي, المتوقع: متجه ط8): منطقي {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_ليب128(&متغير الناتج, القيمة);
    إذا (حجم_ليب128(القيمة) != (الطول(المتوقع) مثل طبيعي)) { أرجع خطأ; };
    أرجع بايتات_متطابقة(&الناتج, &المتوقع);
}

عرف سليب_ذهابا_وإيابا(القيمة: عدد, المتوقع: متجه ط8): منطقي {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_ليب128_موقعا(&متغير الناتج, القيمة);
    إذا (!بايتات_متطابقة(&الناتج, &المتوقع)) { أرجع خطأ; };
    دع المستهلك: متغير طبيعي = 0;
    طابق فك_ليب128_موقع_من(&الناتج, 0, &متغير المستهلك) مع
    | نتيجة.نجح(العائد) -> { أرجع العائد == القيمة && المستهلك == (الطول(الناتج) مثل طبيعي); }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    // أمثلة DWARF 5 في 7.6.
    إذا (!ليب_هو(2, [2])) { أرجع 1; };
    إذا (!ليب_هو(128, [0x80, 1])) { أرجع 2; };
    إذا (!ليب_هو(12857, [0xB9, 0x64])) { أرجع 3; };
    إذا (!سليب_ذهابا_وإيابا(-2, [0x7E])) { أرجع 4; };
    إذا (!سليب_ذهابا_وإيابا(127, [0xFF, 0])) { أرجع 5; };
    إذا (!سليب_ذهابا_وإيابا(-128, [0x80, 0x7F])) { أرجع 6; };
    إذا (!سليب_ذهابا_وإيابا((0 - 9223372036854775807) - 1, [0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x7F])) { أرجع 7; };
    // مدخل مبتور.
    دع مبتور: متجه ط8 = [0x80];
    دع المستهلك: متغير طبيعي = 0;
    طابق فك_ليب128_موقع_من(&مبتور, 0, &متغير المستهلك) مع
    | نتيجة.نجح(_) -> { أرجع 8; }
    | نتيجة.خطأ(_) -> { };

    // حقول بعرض ثابت (إزاحات WebAssembly: خمسة بايتات).
    دع المبطن: متغير متجه ط8 = [];
    إذا (!ألحق_ليب128_مبطنا(&متغير المبطن, 3, 5)) { أرجع 9; };
    إذا (!اكتب_ليب128_مبطنا_عند(&متغير المبطن, 0, 624485, 5)) { أرجع 10; };
    دع المرقع: متجه ط8 = [0xE5, 0x8E, 0xA6, 0x80, 0];
    إذا (!بايتات_متطابقة(&المبطن, &المرقع)) { أرجع 11; };
    إذا (ألحق_ليب128_مبطنا(&متغير المبطن, 34359738368, 5)) { أرجع 12; };
    دع الموقع: متغير متجه ط8 = [];
    إذا (!ألحق_ليب128_موقعا_مبطنا(&متغير الموقع, -2147483648, 5)) { أرجع 13; };
    دع أصغر_ص32: متجه ط8 = [0x80, 0x80, 0x80, 0x80, 0x78];
    إذا (!بايتات_متطابقة(&الموقع, &أصغر_ص32)) { أرجع 14; };
    إذا (!اكتب_ليب128_موقعا_مبطنا_عند(&متغير الموقع, 0, -1, 5)) { أرجع 15; };

    // الكتابة عند إزاحة تستبدل البايتات ولا تكبّر المخزن.
    دع الصورة: متغير متجه ط8 = [0, 0, 0, 0, 0, 0];
    إذا (!اكتب_ط32_بالبايت_الأقل_أهمية_أولا_عند(&متغير الصورة, 2, 0x11223344)) { أرجع 16; };
    إذا (!اكتب_ط16_بالبايت_الأكثر_أهمية_أولا_عند(&متغير الصورة, 0, 0xABCD)) { أرجع 17; };
    دع المتوقعة: متجه ط8 = [0xAB, 0xCD, 0x44, 0x33, 0x22, 0x11];
    إذا (!بايتات_متطابقة(&الصورة, &المتوقعة)) { أرجع 18; };
    إذا (اكتب_ط64_بالبايت_الأقل_أهمية_أولا_عند(&متغير الصورة, 0, 7)) { أرجع 19; };
    أرجع 42;
}
