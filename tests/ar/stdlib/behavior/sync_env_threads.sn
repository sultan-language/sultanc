// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.env.table تحت الخيوط: أربعة خيوط يضبط كل منها متغيره ويقرؤه ويزيله 200
// مرة بينما يفعل الآخرون المثل؛ قفل الجدول العام للعملية يحفظ كل تحديث كاملا،
// فيقرأ كل خيط بالضبط ما كتبه، ولا يبقى في النهاية أي من المتغيرات. النظير:
// tests/en/stdlib/behavior/sync_env_threads.sn. لا توجيه نظير: المفسر يشغل
// خيطا واحدا.
استورد std.env.variables;
استورد std.env.environment;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;

عرف أخفق(الإخفاقات: &مشترك<ذرة_ط64>): فراغ {
    دع ق: ط64 = اجمع_واجلب_ط64(اقرأ_مشترك(الإخفاقات), 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
}

// «SULTANC_SYNC_» يليه رقم الخيط.
عرف اسم_متغير_الخيط(اللاحقة: &نص): نص {
    دع البادئة: نص = «SULTANC_SYNC_»;
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(البادئة);
    دع الذيل: متجه ط8 = بايتات_من_نص(انسخ_نص(اللاحقة));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الذيل) مثل طبيعي)) { ألحق(البايتات, الذيل[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عرف اخلط(المعرف: طبيعي, الإخفاقات: &مشترك<ذرة_ط64>): فراغ {
    // لكل خيط اسم واحد؛ والقيمة تقول أي جولة كتبته.
    دع الرقم: نص = طبيعي_إلى_نص(المعرف);
    دع الاسم: نص = اسم_متغير_الخيط(&الرقم);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 200) {
        دع القيمة: نص = طبيعي_إلى_نص(المعرف * 1000 + ف);
        طابق اضبط_متغير_بيئة(&الاسم, &القيمة) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أخفق(الإخفاقات); };
        طابق متغير_بيئة(&الاسم) مع
        | نتيجة.نجح(اختياري.موجود(المقروءة)) -> { لو (!نصان_متساويان(&المقروءة, &القيمة)) { أخفق(الإخفاقات); }; }
        | نتيجة.نجح(اختياري.لا_شيء) -> { أخفق(الإخفاقات); }
        | نتيجة.خطأ(_) -> { أخفق(الإخفاقات); };
        لو (ف % 3 == 0) {
            طابق أزل_متغير_بيئة(&الاسم) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أخفق(الإخفاقات); };
            طابق متغير_بيئة(&الاسم) مع
            | نتيجة.نجح(اختياري.لا_شيء) -> { }
            | _ -> { أخفق(الإخفاقات); };
        };
        ف := ف + 1;
    }
    طابق أزل_متغير_بيئة(&الاسم) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أخفق(الإخفاقات); };
}

عرف ابدأ(المعرف: طبيعي, الإخفاقات: &مشترك<ذرة_ط64>): اختياري مقبض_خيط {
    دع نسختي: مشترك<ذرة_ط64> = استنسخ_مشترك(الإخفاقات);
    طابق أطلق(دالة(): فراغ -> اخلط(المعرف, &نسختي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع الإخفاقات: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع خ: متغير طبيعي = 0;
    طالما (خ < 4) {
        طابق ابدأ(خ, &الإخفاقات) مع
        | اختياري.موجود(م) -> { ألحق(المقابض, م); }
        | اختياري.لا_شيء -> { أرجع 1; };
        خ := خ + 1;
    }
    دع ض: متغير طبيعي = 0;
    طالما (ض < (الطول(المقابض) مثل طبيعي)) { انضم(&متغير المقابض[ض]); ض := ض + 1; }
    لو (احمل_ط64(اقرأ_مشترك(&الإخفاقات), ترتيب_ذاكرة.تسلسلي()) != (0 مثل ط64)) { أرجع 2; };
    دع الباقي: نص = «SULTANC_SYNC_2»;
    طابق متغير_بيئة(&الباقي) مع | نتيجة.نجح(اختياري.لا_شيء) -> { } | _ -> { أرجع 3; };
    أرجع 0;
}
