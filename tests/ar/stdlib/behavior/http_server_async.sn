// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http_server_async.sn
// خادم HTTP غير المتزامن (std.http.server شغل_خادم_ويب_غير_متزامن) يعمل
// مهمةً؛ يتصل عميلان معا عبر الحلقة المحلية فيخدم كل اتصال مهمة خاصة به،
// ويتلقى كلاهما 200 بجسم المعالج، وطلب الإيقاف ينهي الخادم خلال انتظار
// القبول ذي الـ250 ملي ثانية.
استورد std.http.server;
استورد std.http.shutdown;
استورد std.http.model;
استورد std.http.body;
استورد std.async.runtime;
استورد std.async.net;
استورد std.net.socket_address;
استورد std.net.tcp;
استورد std.text.from_bytes;

عرف الخدمة(الحالة: &عدد, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    دع الجسم: نص = «async ok»;
    أرجع استجابة_نص_ويب(200, &الجسم);
}

عرف اخدم(): عدد {
    دع العنوان: نص = «127.0.0.1:38525»;
    دع الإعداد: إعداد_خادم_ويب = إعداد_خادم_ويب_افتراضي(&العنوان);
    دع الحالة: عدد = 0;
    طابق شغل_خادم_ويب_غير_متزامن(&الإعداد, &الحالة, الخدمة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { أرجع 0; };
}

عرف أصفار(ع: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ع) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

عرف يحتوي(الكومة: &متجه ط8, الحجم: طبيعي, الإبرة: &متجه ط8): منطقي {
    دع ن: طبيعي = الطول(*الإبرة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف + ن <= الحجم) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < ن && (*الكومة)[ف + ك] == (*الإبرة)[ك]) { ك := ك + 1; }
        إذا (ك == ن) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف اجلب(): عدد {
    نم_مهمة(30000000);
    دع النص: نص = «127.0.0.1:38525»;
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(ع) -> { العنوان := ع; };
    دع التدفق: تدفق_تي_سي_بي;
    طابق اتصل_غير_متزامن(&العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(ت) -> { التدفق := ت; };
    دع الطلب: متجه ط8 = بايتات_من_نص("GET / HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n");
    طابق اكتب_الكل_غير_متزامن(&التدفق, &الطلب) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(_) -> { };
    دع المخزن: متغير متجه ط8 = أصفار(4096);
    دع المستلم: متغير طبيعي = 0;
    دع مفتوح: متغير منطقي = صواب;
    طالما (مفتوح && المستلم < 4096) {
        طابق اقرأ_غير_متزامن(&التدفق, &متغير المخزن, المستلم مثل عدد, 4096 - (المستلم مثل عدد)) مع
        | نتيجة.خطأ(_) -> { أرجع 4; }
        | نتيجة.نجح(ك) -> {
            إذا (ك <= 0) { مفتوح := خطأ; } وإلا { المستلم := المستلم + (ك مثل طبيعي); };
        };
    }
    دع غ: نتيجة عدد, عدد = أغلق_غير_متزامن(التدفق);
    دع الحالة: متجه ط8 = بايتات_من_نص("HTTP/1.1 200");
    دع الجسم: متجه ط8 = بايتات_من_نص("async ok");
    إذا (!يحتوي(&المخزن, المستلم, &الحالة)) { أرجع 5; };
    إذا (!يحتوي(&المخزن, المستلم, &الجسم)) { أرجع 6; };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    إذا (!المهام_مدعومة()) { أرجع 1; };
    دع الخادم: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اخدم());
    دع الأول: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اجلب());
    دع الثاني: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> اجلب());
    طابق انتظر_مهمة(&متغير الأول) مع
    | اختياري.موجود(ق) -> { إذا (ق != 0) { أرجع 10 + ق; }; }
    | اختياري.لا_شيء -> { أرجع 10; };
    طابق انتظر_مهمة(&متغير الثاني) مع
    | اختياري.موجود(ق) -> { إذا (ق != 0) { أرجع 20 + ق; }; }
    | اختياري.لا_شيء -> { أرجع 20; };
    اطلب_إيقاف_خوادم_الويب();
    طابق انتظر_مهمة(&متغير الخادم) مع
    | اختياري.موجود(ق) -> { إذا (ق != 0) { أرجع 30 + ق; }; }
    | اختياري.لا_شيء -> { أرجع 30; };
    أرجع 0;
}
