// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/host_bridge.sn
// مسارات std التي تلامس ذاكرة المضيف، تعمل في التنفيذي والمفسر سواء: فتح
// فاشل يبلغ بعدم الوجود (errno ورمز آخر خطأ)، ودليل العمل، وقائمة البيئة (كتلة
// بيئة ويندوز)، وسرد دليل (dirent من readdir في داروين)، وحل localhost (قائمة
// getaddrinfo وGetAddrInfoW)، وجذور الثقة في النظام (قائمة CERT_CONTEXT في
// ويندوز) مع طباعة النتيجة.
استورد std.fs.handle;
استورد std.fs.error;
استورد std.fs.temporary;
استورد std.fs.directory;
استورد std.fs.write_file;
استورد std.fs.mutation;
استورد std.fs.path;
استورد std.fs.canonical;
استورد std.env.environment;
استورد std.env.variables;
استورد std.net.dns;
استورد std.net.socket_address;
استورد std.tls.trust;
استورد std.text.compare;
استورد std.io.println;

عرف الرئيسية(): عدد {
    دع المفقود: نص = «sultanc-host-bridge-missing-file.txt»;
    طابق افتح_مقبض_ملف_للقراءة(&المفقود) مع
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(الرمز) -> { لو (!هل_خطأ_غير_موجود(الرمز)) { أرجع 2; }; };

    طابق دليل_العمل() مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(الدليل_الحالي) -> { لو (الطول(الدليل_الحالي) == 0) { أرجع 4; }; };

    طابق متغيرات_البيئة() مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(المتغيرات) -> { لو (الطول(المتغيرات) == 0) { أرجع 6; }; };

    دع البادئة: نص = «sultanc-bridge-»;
    دع الدليل: متغير نص = «»;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(المنشأ) -> { الدليل := المنشأ; };
    دع اسم_الأول: نص = «alpha.txt»;
    دع اسم_الثاني: نص = «beta.txt»;
    دع الأول: نص = صل_المسار_بصيغة(&الدليل, &اسم_الأول, صيغة_مسار_المضيف());
    دع الثاني: نص = صل_المسار_بصيغة(&الدليل, &اسم_الثاني, صيغة_مسار_المضيف());
    دع المحتوى: نص = «x»;
    طابق اكتب_الملف(&الأول, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 8; }
    | نتيجة.نجح(_) -> {};
    طابق اكتب_الملف(&الثاني, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(_) -> {};
    طابق اقرأ_مدخلات_الدليل(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 10; }
    | نتيجة.نجح(المدخلات) -> {
        لو (الطول(المدخلات) != 2) { أرجع 11; };
        دع رأى_الأول: متغير منطقي = خطأ;
        دع رأى_الثاني: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
            لو (نصان_متساويان(&المدخلات[ف].الاسم, &اسم_الأول)) { رأى_الأول := صواب; };
            لو (نصان_متساويان(&المدخلات[ف].الاسم, &اسم_الثاني)) { رأى_الثاني := صواب; };
            ف := ف + 1;
        }
        لو (!رأى_الأول || !رأى_الثاني) { أرجع 12; };
    };
    طابق أزل_ملفا(&الأول) مع
    | نتيجة.خطأ(_) -> { أرجع 13; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&الثاني) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_دليلا(&الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع 15; }
    | نتيجة.نجح(_) -> {};

    دع المضيف_المحلي: نص = «localhost»;
    طابق حل_اسم_مضيف4(&المضيف_المحلي, 80) مع
    | نتيجة.خطأ(_) -> { أرجع 16; }
    | نتيجة.نجح(العنوان) -> {
        دع النص: نص = نص_آيبي_عنوان_مقبس(&العنوان);
        دع الحلقة: نص = «127.0.0.1»;
        لو (!نصان_متساويان(&النص, &الحلقة)) { أرجع 17; };
    };

    طابق جذور_النظام_تي_إل_إس() مع
    | نتيجة.خطأ(_) -> { اطبع_سطر(«roots: unavailable»); }
    | نتيجة.نجح(الجذور) -> {
        لو (الطول(الجذور) > 0) { اطبع_سطر(«roots: some»); } وإلا { اطبع_سطر(«roots: none»); };
    };
    أرجع 42;
}
