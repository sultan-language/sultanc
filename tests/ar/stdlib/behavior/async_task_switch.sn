// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/async_task_switch.sn
// تتبدل مهام std.async أصليا وتحت `sultanc run` (يبدل المفسر مكادس الأطر):
// المهمة المتنازلة تدع غيرها يعمل قبل أن تنتهي، والمهمة المنتظرة لأخرى تعلق
// نفسها فقط، وثلاث مهام نائمة تنتظر في المستطلع معا.
استورد std.async.runtime;
استورد std.sync.arc;
استورد std.sync.atomic;

نوع ترتيب = { التالي: ذرة_ط64, المنتهية: متجه ذرة_ط64 };

عرف علّم(المشترك: &مشترك<ترتيب>, الخانة: طبيعي): فراغ {
    دع ت: &ترتيب = اقرأ_مشترك(المشترك);
    دع الموضع: ط64 = اجمع_واجلب_ط64(&(*ت).التالي, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    اخزن_ط64(&(*ت).المنتهية[الخانة], الموضع, ترتيب_ذاكرة.تسلسلي());
}

عرف متنازل(المشترك: مشترك<ترتيب>): عدد {
    تنازل_مهمة();
    تنازل_مهمة();
    علّم(&المشترك, 0);
    أرجع 10;
}

عرف سريع(المشترك: مشترك<ترتيب>): عدد {
    علّم(&المشترك, 1);
    أرجع 20;
}

عرف نائم(المدة: عدد, القيمة: عدد): عدد { نم_مهمة(المدة); أرجع القيمة; }

عرف منتظر(): عدد {
    دع الداخلية: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(2000000, 6));
    طابق انتظر_مهمة(&متغير الداخلية) مع
    | اختياري.موجود(ق) -> { أرجع ق * 2; }
    | اختياري.لا_شيء -> { أرجع -1; };
}

عرف الرئيسية(): عدد {
    إذا (!المهام_مدعومة()) { أرجع 1; };
    دع الخانات: متغير متجه ذرة_ط64 = [];
    ألحق(الخانات, أنشئ_ذرة_ط64(0 مثل ط64));
    ألحق(الخانات, أنشئ_ذرة_ط64(0 مثل ط64));
    دع المشترك: مشترك<ترتيب> = أنشئ_مشترك({ التالي: أنشئ_ذرة_ط64(1 مثل ط64), المنتهية: الخانات });
    دع لأ: مشترك<ترتيب> = استنسخ_مشترك(&المشترك);
    دع لب: مشترك<ترتيب> = استنسخ_مشترك(&المشترك);
    دع أ: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> متنازل(لأ));
    دع ب: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> سريع(لب));
    دع ج: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> منتظر());
    دع ن1: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(3000000, 1));
    دع ن2: متغير مهمة<عدد> = أطلق_مهمة(دالة(): عدد -> نائم(3000000, 2));
    دع المجموع: متغير عدد = 0;
    طابق انتظر_مهمة(&متغير أ) مع | اختياري.موجود(ق) -> { المجموع := المجموع + ق; } | اختياري.لا_شيء -> { أرجع 2; };
    طابق انتظر_مهمة(&متغير ب) مع | اختياري.موجود(ق) -> { المجموع := المجموع + ق; } | اختياري.لا_شيء -> { أرجع 3; };
    طابق انتظر_مهمة(&متغير ج) مع | اختياري.موجود(ق) -> { المجموع := المجموع + ق; } | اختياري.لا_شيء -> { أرجع 4; };
    طابق انتظر_مهمة(&متغير ن1) مع | اختياري.موجود(ق) -> { المجموع := المجموع + ق; } | اختياري.لا_شيء -> { أرجع 5; };
    طابق انتظر_مهمة(&متغير ن2) مع | اختياري.موجود(ق) -> { المجموع := المجموع + ق; } | اختياري.لا_شيء -> { أرجع 6; };
    إذا (المجموع != 45) { أرجع 7; };
    دع ت: &ترتيب = اقرأ_مشترك(&المشترك);
    دع المتنازلة: ط64 = احمل_ط64(&(*ت).المنتهية[0], ترتيب_ذاكرة.تسلسلي());
    دع السريعة: ط64 = احمل_ط64(&(*ت).المنتهية[1], ترتيب_ذاكرة.تسلسلي());
    إذا (السريعة != (1 مثل ط64) || المتنازلة != (2 مثل ط64)) { أرجع 8; };
    أرجع 42;
}
