// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/text_concat.sn
// صل_نصين وصل_ثلاثة_نصوص في std.text.transform: نصان أو ثلاثة موصولة بالترتيب،
// مع أجزاء فارغة وأجزاء UTF-8 متعددة البايتات؛ وطول الناتج مجموع أطوال
// الأجزاء بالبايتات.
استورد المكتبة.نصوص.transform;
استورد المكتبة.نصوص.compare;

عرف الرئيسية(): عدد {
    دع الفارغ: نص = «»;
    دع أ: نص = «ab»;
    دع العربي: نص = «سلطان»;
    دع الوجه: نص = «😀»;

    دع أ_والعربي: نص = صل_نصين(&أ, &العربي);
    دع المتوقع_أ_والعربي: نص = «abسلطان»;
    إذا (!نصان_متساويان(&أ_والعربي, &المتوقع_أ_والعربي)) { أرجع 1; };
    إذا (الطول(أ_والعربي) != 12) { أرجع 2; };

    دع فارغ_يسارا: نص = صل_نصين(&الفارغ, &العربي);
    إذا (!نصان_متساويان(&فارغ_يسارا, &العربي) || الطول(فارغ_يسارا) != 10) { أرجع 3; };
    دع فارغ_يمينا: نص = صل_نصين(&أ, &الفارغ);
    إذا (!نصان_متساويان(&فارغ_يمينا, &أ) || الطول(فارغ_يمينا) != 2) { أرجع 4; };
    دع فارغان: نص = صل_نصين(&الفارغ, &الفارغ);
    إذا (الطول(فارغان) != 0) { أرجع 5; };

    دع الثلاثة: نص = صل_ثلاثة_نصوص(&العربي, &الوجه, &أ);
    دع المتوقع_الثلاثة: نص = «سلطان😀ab»;
    إذا (!نصان_متساويان(&الثلاثة, &المتوقع_الثلاثة)) { أرجع 6; };
    إذا (الطول(الثلاثة) != 16) { أرجع 7; };

    دع الأوسط_فارغ: نص = صل_ثلاثة_نصوص(&أ, &الفارغ, &الوجه);
    دع المتوقع_الأوسط: نص = «ab😀»;
    إذا (!نصان_متساويان(&الأوسط_فارغ, &المتوقع_الأوسط) || الطول(الأوسط_فارغ) != 6) { أرجع 8; };
    دع كلها_فارغة: نص = صل_ثلاثة_نصوص(&الفارغ, &الفارغ, &الفارغ);
    إذا (الطول(كلها_فارغة) != 0) { أرجع 9; };

    // الأجزاء مستعارة لا مستهلكة.
    إذا (الطول(أ) != 2 || الطول(العربي) != 10 || الطول(الوجه) != 4) { أرجع 10; };
    أرجع 42;
}
