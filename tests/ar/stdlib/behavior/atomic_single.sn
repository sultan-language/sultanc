// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/atomic_single.sn
// std.sync.atomic: التحميل والتخزين والتبديل والمقارنة-والتبديل والجمع-والجلب
// والعمليات البتية الذرية على ذرة_ط64، تنفذ بتعليمات ذرية أصلية (docs/en/reference/concurrency.md).
استورد std.sync.atomic;

عرف الرئيسية(): ص32 {
    دع ذ: متغير ذرة_ط64 = أنشئ_ذرة_ط64(0 مثل ط64);
    دع ج: متغير ص64 = 0;
    طالما (ج < 1000) {
        دع قديم: ط64 = اجمع_واجلب_ط64(&ذ, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
        ج := ج + 1;
    }
    إذا (احمل_ط64(&ذ, ترتيب_ذاكرة.تسلسلي()) != (1000 مثل ط64)) { أرجع 1; };

    دع م: متغير ذرة_ط64 = أنشئ_ذرة_ط64(5 مثل ط64);
    اخزن_ط64(&م, 10 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (احمل_ط64(&م, ترتيب_ذاكرة.تسلسلي()) != (10 مثل ط64)) { أرجع 2; };
    دع سابق: ط64 = بدّل_ط64(&م, 20 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (سابق != (10 مثل ط64)) { أرجع 3; };
    دع عند_النجاح: ط64 = قارن_وبدّل_ط64(&م, 20 مثل ط64, 30 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (عند_النجاح != (20 مثل ط64)) { أرجع 4; };
    إذا (احمل_ط64(&م, ترتيب_ذاكرة.تسلسلي()) != (30 مثل ط64)) { أرجع 5; };
    دع عند_الفشل: ط64 = قارن_وبدّل_ط64(&م, 99 مثل ط64, 40 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (عند_الفشل != (30 مثل ط64)) { أرجع 6; };
    إذا (احمل_ط64(&م, ترتيب_ذاكرة.تسلسلي()) != (30 مثل ط64)) { أرجع 7; };

    دع ب: متغير ذرة_ط64 = أنشئ_ذرة_ط64(12 مثل ط64);
    دع و: ط64 = و_واجلب_ط64(&ب, 10 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (احمل_ط64(&ب, ترتيب_ذاكرة.تسلسلي()) != (8 مثل ط64)) { أرجع 8; };
    دع أو: ط64 = أو_واجلب_ط64(&ب, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    إذا (احمل_ط64(&ب, ترتيب_ذاكرة.تسلسلي()) != (9 مثل ط64)) { أرجع 9; };
    سياج_ذاكرة(ترتيب_ذاكرة.تسلسلي());
    أرجع 0;
}
