// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// الانقطاع في std.sync.channel كما تبلغه mpsc في Rust: محاولة الاستقبال من
// قناة فارغة تعطي «فارغة» ما دام مرسل حيا و«منقطعة» حين لا يبقى أحد (بعد
// تفريغ الرسائل المنتظرة)؛ والاستقبال بمهلة تنتهي مهلته؛ والإرسال يعيد القيمة
// حين يذهب المستلم؛ والمستلم المنتظر في استقبل يستيقظ حين يسقط آخر مرسل، الذي
// التقطه خيط، بانتهاء ذلك الخيط. النظير:
// tests/en/stdlib/behavior/sync_channel_disconnect.sn. لا توجيه نظير: المفسر
// يشغل خيطا واحدا.
استورد std.sync.channel;
استورد std.thread.thread;
استورد std.time.duration;

عرف أرسل_واحدة_وانته(م: &مرسل<ص64>): فراغ {
    طابق أرسل(م, 99 مثل ص64) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
}

عرف ابدأ(م: مرسل<ص64>): اختياري مقبض_خيط {
    طابق أطلق(دالة(): فراغ -> أرسل_واحدة_وانته(&م)) مع
    | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ق); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع س: مستلم<ص64> = مستلم_قناة();
    دع م: مرسل<ص64> = مرسل_لمستلم(&س);
    طابق حاول_الاستقبال(&س) مع
    | نتيجة.خطأ(خطأ_محاولة_استقبال.فارغة) -> { }
    | _ -> { أرجع 1; };
    طابق مدة_من_مليثواني(10) مع
    | اختياري.موجود(د) -> {
        طابق استقبل_بمهلة(&س, د) مع
        | نتيجة.خطأ(خطأ_استقبال_بمهلة.انتهت_المهلة) -> { }
        | _ -> { أرجع 2; };
    }
    | اختياري.لا_شيء -> { أرجع 3; };
    طابق أرسل(&م, 5 مثل ص64) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { أرجع 4; };
    أسقط_مرسل(م);
    // تُسلَّم الرسالة المنتظرة أولا، ثم الانقطاع.
    طابق حاول_الاستقبال(&س) مع
    | نتيجة.نجح(ق) -> { إذا (ق != (5 مثل ص64)) { أرجع 5; }; }
    | نتيجة.خطأ(_) -> { أرجع 6; };
    طابق حاول_الاستقبال(&س) مع
    | نتيجة.خطأ(خطأ_محاولة_استقبال.منقطعة) -> { }
    | _ -> { أرجع 7; };
    طابق استقبل(&س) مع
    | نتيجة.خطأ(خطأ_استقبال.منقطعة) -> { }
    | _ -> { أرجع 8; };

    // ذهب المستلم: يعيد الإرسال القيمة.
    دع س2: مستلم<ص64> = مستلم_قناة();
    دع م2: مرسل<ص64> = مرسل_لمستلم(&س2);
    أسقط_مستلم(س2);
    طابق أرسل(&م2, 7 مثل ص64) مع
    | نتيجة.نجح(_) -> { أرجع 9; }
    | نتيجة.خطأ(ق) -> { إذا (ق != (7 مثل ص64)) { أرجع 10; }; };

    // المرسل الذي التقطه خيط يسقط حين ينتهي الخيط، فينتهي استقبل المنتظر.
    دع س3: مستلم<ص64> = مستلم_قناة();
    دع المقبض: متغير مقبض_خيط;
    طابق ابدأ(مرسل_لمستلم(&س3)) مع
    | اختياري.موجود(ق) -> { المقبض := ق; }
    | اختياري.لا_شيء -> { أرجع 11; };
    طابق استقبل(&س3) مع
    | نتيجة.نجح(ق) -> { إذا (ق != (99 مثل ص64)) { أرجع 12; }; }
    | نتيجة.خطأ(_) -> { أرجع 13; };
    طابق استقبل(&س3) مع
    | نتيجة.خطأ(خطأ_استقبال.منقطعة) -> { }
    | _ -> { أرجع 14; };
    انضم(&متغير المقبض);
    أرجع 0;
}
