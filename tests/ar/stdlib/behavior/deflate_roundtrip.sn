// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/deflate_roundtrip.sn
// std.compression: يعود ناتج المرمّز بهوفمان الثابت سليما عبر فك الضغط لنص
// متكرر، وتتابعات طويلة، وبايتات شبه عشوائية، ومدخل فارغ؛ ويعطي ضاغط واحد
// معاد استخدامه (ديفليت وgzip) البايتات نفسها التي يعطيها ضاغط جديد لكل مدخل
// (تبقى في جداوله مداخل من مدخلات سابقة يجب ألا تُستخدم أبدا)؛ وينكمش النص
// إلى أقل من ربعه؛ وترجع البايتات العشوائية إلى كتل مخزنة (تزيد 5 بايتات لكل
// 64 KiB على الأكثر).
استورد std.compression.deflate;
استورد std.compression.gzip;

عرف عينة(النوع: عدد, الحجم: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع النص: متجه ط8 = [72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10, 99, 111, 110, 116, 101, 110, 116, 45, 116, 121, 112, 101, 58, 32];
    دع البذرة: متغير ط64 = 12345;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        إذا (النوع == 0) { ألحق(الناتج, النص[ف % (الطول(النص) مثل طبيعي)]); }
        وإلا إذا (النوع == 1) { ألحق(الناتج, ((ف / 300) % 4) مثل ط8); }
        وإلا {
            البذرة := (البذرة * 1103515245 + 12345) & 0x7FFFFFFF;
            ألحق(الناتج, ((البذرة >> 16) & 0xFF) مثل ط8);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف متطابقان(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف افحص_الكل(الحجم: طبيعي): عدد {
    دع المعاد: متغير ضاغط_ديفليت = أنشئ_ضاغط_ديفليت();
    دع جز: متغير ضاغط_جي_زيب = أنشئ_ضاغط_جي_زيب();
    دع النوع: متغير عدد = 0;
    طالما (النوع < 4) {
        دع المدخل: متغير متجه ط8 = [];
        إذا (النوع < 3) { المدخل := عينة(النوع, الحجم); };
        دع الجديد: متجه ط8 = اضغط_ديفليت(&المدخل);
        دع ثانية: متغير متجه ط8 = [];
        ألحق_ضغط_ديفليت(&متغير المعاد, &المدخل, &متغير ثانية);
        إذا (!متطابقان(&الجديد, &ثانية)) { أرجع 10 + النوع; };
        طابق فك_ضغط_ديفليت(&الجديد) مع
        | نتيجة.خطأ(_) -> { أرجع 20 + النوع; }
        | نتيجة.نجح(المفكوك) -> { إذا (!متطابقان(&المفكوك, &المدخل)) { أرجع 30 + النوع; }; };
        دع المضغوط: متغير متجه ط8 = [];
        ألحق_ضغط_جي_زيب(&متغير جز, &المدخل, &متغير المضغوط, 0 مثل ط32);
        دع دفعة_واحدة: متجه ط8 = اضغط_جي_زيب(&المدخل);
        إذا (!متطابقان(&المضغوط, &دفعة_واحدة)) { أرجع 40 + النوع; };
        طابق فك_ضغط_جي_زيب(&المضغوط) مع
        | نتيجة.خطأ(_) -> { أرجع 50 + النوع; }
        | نتيجة.نجح(المفكوك) -> { إذا (!متطابقان(&المفكوك, &المدخل)) { أرجع 60 + النوع; }; };
        إذا (النوع == 0 && (الطول(الجديد) مثل طبيعي) * 4 > الحجم) { أرجع 70; };
        إذا (النوع == 2 && (الطول(الجديد) مثل طبيعي) > الحجم + 10) { أرجع 71; };
        النوع := النوع + 1;
    }
    أرجع 0;
}

عرف الرئيسية(): عدد {
    أرجع افحص_الكل(70000);
}
