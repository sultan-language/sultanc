// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.channel: أربعة خيوط منتجة يرسل كل منها 2 500 عدد عبر نسخته من مرسل
// واحد؛ ويجمعها المستلم حتى يبلّغ استقبل أن كل المرسلين ذهبوا. تسقط مرسلات
// المنتجين حين تنتهي خيوطهم، ويسقط الخيط الرئيسي مرسله بـ أسقط_مرسل؛ لا تضيع
// رسالة ولا تتكرر، وتصل رسائل كل منتج بترتيبه. النظير:
// tests/en/stdlib/behavior/sync_channel_producers.sn. لا توجيه نظير: المفسر
// يشغل خيطا واحدا.
استورد std.sync.channel;
استورد std.thread.thread;

عرف أنتج(م: &مرسل<ص64>, المنتج: ص64): فراغ {
    دع ف: متغير ص64 = 0;
    طالما (ف < 2500) {
        طابق أرسل(م, المنتج * 10000 + ف) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { أرجع; };
        ف := ف + 1;
    }
}

عرف ابدأ(م: &مرسل<ص64>, المنتج: ص64): اختياري مقبض_خيط {
    دع نسختي: مرسل<ص64> = استنسخ_مرسل(م);
    طابق أطلق(دالة(): فراغ -> أنتج(&نسختي, المنتج)) مع
    | نتيجة.نجح(ق) -> { أرجع اختياري.موجود(ق); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع م: مرسل<ص64>;
    دع س: مستلم<ص64>;
    دع الطرفان: طرفا_قناة<ص64> = قناة();
    طابق الطرفان مع
    | { المرسل: أ, المستلم: ب } -> { م := أ; س := ب; };
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع ن: متغير ص64 = 0;
    طالما (ن < 4) {
        طابق ابدأ(&م, ن) مع
        | اختياري.موجود(ق) -> { ألحق(المقابض, ق); }
        | اختياري.لا_شيء -> { أرجع 1; };
        ن := ن + 1;
    }
    أسقط_مرسل(م);
    دع الأخير: متغير متجه ص64 = [-1 مثل ص64, -1 مثل ص64, -1 مثل ص64, -1 مثل ص64];
    دع المجموع: متغير ص64 = 0;
    دع العدد: متغير ص64 = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق استقبل(&س) مع
        | نتيجة.نجح(ق) -> {
            دع المنتج: ص64 = ق / 10000;
            دع الرقم: ص64 = ق % 10000;
            إذا (الرقم <= الأخير[المنتج مثل طبيعي]) { أرجع 2; };
            الأخير[المنتج مثل طبيعي] := الرقم;
            المجموع := المجموع + الرقم;
            العدد := العدد + 1;
        }
        | نتيجة.خطأ(_) -> { مستمر := خطأ; };
    }
    دع ض: متغير طبيعي = 0;
    طالما (ض < (الطول(المقابض) مثل طبيعي)) { انضم(&متغير المقابض[ض]); ض := ض + 1; }
    إذا (العدد != (10000 مثل ص64)) { أرجع 3; };
    // أربعة أضعاف 0 + 1 + ... + 2499.
    إذا (المجموع != (12495000 مثل ص64)) { أرجع 4; };
    أرجع 0;
}
