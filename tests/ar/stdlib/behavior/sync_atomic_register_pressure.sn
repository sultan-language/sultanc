// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// ذرات يُبلغ إليها عبر إغلاقات وسلاسل نداء بينما قيم كثيرة حية: يشغل كل خيط
// إغلاقا ينادي ثلاث دوال متداخلة، تحتفظ كل منها بعدة محليات عبر عمليات القراءة-
// التعديل-الكتابة الذرية، فيضطر مخصص السجلات إلى التسريب حولها (النمط الذي
// ذكرته docs/en/reference/concurrency.md يوما على أنه يُترجم خطأ). أربعة خيوط × 5 000 جولة من
// الجمع-والجلب والمقارنة-والتبديل والتبديل تترك مجاميع دقيقة. النظير:
// tests/en/stdlib/behavior/sync_atomic_register_pressure.sn. لا توجيه نظير:
// المفسر يشغل خيطا واحدا.
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.thread.thread;

نوع خلايا = { المجموع: ذرة_ط64, المقارنة: ذرة_ط64, التبديلات: ذرة_ط64, مختلطة: ذرة_ط32 };

عرف الأعمق(خ: &خلايا, أ: ط64, ب: ط64, د: ط64, هـ: ط64, و: ط64): ط64 {
    دع ز: ط64 = أ + ب;
    دع ح: ط64 = د + هـ;
    دع ك: ط64 = و + ز;
    دع قديم: ط64 = اجمع_واجلب_ط64(&(*خ).المجموع, 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
    // حلقة مقارنة-وتبديل: زد بواحد بالمقارنة والتبديل.
    دع تم: متغير منطقي = خطأ;
    طالما (!تم) {
        دع رأى: ط64 = احمل_ط64(&(*خ).المقارنة, ترتيب_ذاكرة.اكتساب());
        إذا (قارن_وبدّل_ط64(&(*خ).المقارنة, رأى, رأى + (1 مثل ط64), ترتيب_ذاكرة.اكتساب_وإطلاق()) == رأى) {
            تم := صواب;
        };
    }
    دع سابق: ط64 = بدّل_ط64(&(*خ).التبديلات, أ, ترتيب_ذاكرة.تسلسلي());
    دع صغير: ط32 = اجمع_واجلب_ط32(&(*خ).مختلطة, 2 مثل ط32, ترتيب_ذاكرة.مسترخ());
    أرجع ز + ح + ك + قديم * (0 مثل ط64) + سابق * (0 مثل ط64) + ((صغير مثل ط64) * (0 مثل ط64));
}

عرف الأوسط(خ: &خلايا, س: ط64, ص: ط64): ط64 {
    دع ب1: ط64 = س * (3 مثل ط64);
    دع ب2: ط64 = ص + (7 مثل ط64);
    دع ب3: ط64 = ب1 + ب2;
    دع ب4: ط64 = الأعمق(خ, س, ص, ب1, ب2, ب3);
    أرجع ب4 + ب1 + ب2 + ب3;
}

عرف الأعلى(المشترك: &مشترك<خلايا>, الجولة: ط64): ط64 {
    دع خ: &خلايا = اقرأ_مشترك(المشترك);
    دع أ: ط64 = الأوسط(خ, الجولة, الجولة + (1 مثل ط64));
    دع ب: ط64 = الأوسط(خ, الجولة + (2 مثل ط64), الجولة);
    أرجع أ + ب;
}

عرف اعمل(المشترك: مشترك<خلايا>): فراغ {
    دع ف: متغير ط64 = 0;
    دع المجموع_التحققي: متغير ط64 = 0;
    طالما (ف < (5000 مثل ط64)) {
        دع خطوة: دالة(ط64): ط64 = دالة(ن: ط64): ط64 -> الأعلى(&المشترك, ن);
        المجموع_التحققي := المجموع_التحققي + خطوة(ف);
        ف := ف + 1;
    }
}

عرف ابدأ(المشترك: &مشترك<خلايا>): اختياري مقبض_خيط {
    دع نسختي: مشترك<خلايا> = استنسخ_مشترك(المشترك);
    طابق أطلق(دالة(): فراغ -> اعمل(نسختي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع القيمة: خلايا = {
        المجموع: أنشئ_ذرة_ط64(0 مثل ط64), المقارنة: أنشئ_ذرة_ط64(0 مثل ط64),
        التبديلات: أنشئ_ذرة_ط64(0 مثل ط64), مختلطة: أنشئ_ذرة_ط32(0 مثل ط32)
    };
    دع المشترك: مشترك<خلايا> = أنشئ_مشترك(القيمة);
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع خ: متغير ص32 = 0;
    طالما (خ < 4) {
        طابق ابدأ(&المشترك) مع
        | اختياري.موجود(م) -> { ألحق(المقابض, م); }
        | اختياري.لا_شيء -> { أرجع 1; };
        خ := خ + 1;
    }
    دع ض: متغير طبيعي = 0;
    طالما (ض < (الطول(المقابض) مثل طبيعي)) { انضم(&متغير المقابض[ض]); ض := ض + 1; }
    دع ج: &خلايا = اقرأ_مشترك(&المشترك);
    // أربعة خيوط × 5 000 جولة × ندائين للأعمق.
    إذا (احمل_ط64(&(*ج).المجموع, ترتيب_ذاكرة.تسلسلي()) != (40000 مثل ط64)) { أرجع 2; };
    إذا (احمل_ط64(&(*ج).المقارنة, ترتيب_ذاكرة.تسلسلي()) != (40000 مثل ط64)) { أرجع 3; };
    إذا (احمل_ط32(&(*ج).مختلطة, ترتيب_ذاكرة.تسلسلي()) != (80000 مثل ط32)) { أرجع 4; };
    إذا (احمل_ط64(&(*ج).التبديلات, ترتيب_ذاكرة.تسلسلي()) > (5001 مثل ط64)) { أرجع 5; };
    أرجع 0;
}
