// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/env_set_remove.sn
// ضبط متغيرات البيئة وإزالتها في std.env (Rust env::set_var/remove_var، وGo
// os.Setenv/Unsetenv): يقرأ المتغير المضبوط ويستبدل ويعد مرة واحدة ويزال، ويرفض الاسم
// والقيمة غير الصالحين، ويرث الطفل المشغل بلا بيئة صريحة التغيير، وTMPDIR الذي يضبطه
// البرنامج هو الدليل المؤقت.
استورد std.env.environment;
استورد std.env.variables;
استورد std.process.command;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف عد_المسمى(الاسم: &نص): عدد {
    طابق متغيرات_البيئة() مع
    | نتيجة.خطأ(_) -> { أرجع -1; }
    | نتيجة.نجح(الكل) -> {
        دع العدد: متغير عدد = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الكل) مثل طبيعي)) {
            لو (نصان_متساويان(&الكل[ف].الاسم, الاسم)) { العدد := العدد + 1; };
            ف := ف + 1;
        }
        أرجع العدد;
    };
}

عرف الرئيسية(): عدد {
    دع الاسم: نص = "SULTANC_SET_TEST";
    دع الأول: نص = "one";
    دع الثاني: نص = "two words";
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.لا_شيء) -> {}
    | _ -> { أرجع 1; };
    طابق اضبط_متغير_بيئة(&الاسم, &الأول) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> {};
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { لو (!نصان_متساويان(&القيمة, &الأول)) { أرجع 3; }; }
    | _ -> { أرجع 4; };
    طابق اضبط_متغير_بيئة(&الاسم, &الثاني) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(_) -> {};
    لو (عد_المسمى(&الاسم) != 1) { أرجع 6; };
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { لو (!نصان_متساويان(&القيمة, &الثاني)) { أرجع 7; }; }
    | _ -> { أرجع 8; };

    // The startup environment is still there.
    دع المسار: نص = "PATH";
    طابق متغير_بيئة(&المسار) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> {}
    | _ -> { أرجع 9; };

    // Invalid الاسمs and القيمةs change nothing.
    دع اسم_سيئ: نص = "A=B";
    طابق اضبط_متغير_بيئة(&اسم_سيئ, &الأول) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 10; };
    دع الفارغ: نص = "";
    طابق اضبط_متغير_بيئة(&الفارغ, &الأول) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 11; };

    // A child inherits the change.
    دع الصدفة: نص = "sh";
    دع الأمر: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع النص_البرمجي: متجه نص = ["-c", "echo \"$SULTANC_SET_TEST\""];
    أضف_وسائط_للأمر(&متغير الأمر, &النص_البرمجي);
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(الناتج) -> {
        دع الخرج_نصا: نص = من_بايتات(&الناتج.الخرج);
        دع المتوقع: نص = "two words\n";
        لو (!نصان_متساويان(&الخرج_نصا, &المتوقع)) { أرجع 13; };
    };

    // TMPDIR set by the program is the temporary الدليلectory.
    دع اسم_المؤقت: نص = "TMPDIR";
    دع قيمة_المؤقت: نص = "/sultanc-tmp-test";
    طابق اضبط_متغير_بيئة(&اسم_المؤقت, &قيمة_المؤقت) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(_) -> {};
    طابق الدليل_المؤقت() مع
    | نتيجة.نجح(الدليل) -> { لو (!نصان_متساويان(&الدليل, &قيمة_المؤقت)) { أرجع 15; }; }
    | نتيجة.خطأ(_) -> { أرجع 16; };

    // Removal: gone for the program and for a child.
    طابق أزل_متغير_بيئة(&الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(_) -> {};
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.لا_شيء) -> {}
    | _ -> { أرجع 18; };
    لو (عد_المسمى(&الاسم) != 0) { أرجع 19; };
    دع الفحص: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع الفحص_النص_البرمجي: متجه نص = ["-c", "test -z \"${SULTANC_SET_TEST+set}\" && echo unset"];
    أضف_وسائط_للأمر(&متغير الفحص, &الفحص_النص_البرمجي);
    طابق اجمع_خرج_الأمر(&الفحص) مع
    | نتيجة.خطأ(_) -> { أرجع 20; }
    | نتيجة.نجح(الناتج) -> {
        دع الخرج_نصا: نص = من_بايتات(&الناتج.الخرج);
        دع المتوقع: نص = "unset\n";
        لو (!نصان_متساويان(&الخرج_نصا, &المتوقع)) { أرجع 21; };
    };
    // Removing a variable that is not set is not an error.
    طابق أزل_متغير_بيئة(&الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع 22; }
    | نتيجة.نجح(_) -> {};
    أرجع 42;
}
