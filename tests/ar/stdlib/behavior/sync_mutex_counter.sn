// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.mutex: ثمانية خيوط يأخذ كل منها القفل 10 000 مرة ويزيد عدادا واحدا
// خلفه (مشترك<قفل<ص64>>)؛ المجموع دقيق، ويعود المشترك إلى مقبض واحد بعد ضم
// الخيوط (أسقطت نسخها). النظير: tests/en/stdlib/behavior/sync_mutex_counter.sn.
// لا توجيه نظير: المفسر يشغل خيطا واحدا.
استورد std.sync.arc;
استورد std.sync.mutex;
استورد std.thread.thread;

عرف زد(ق: &متغير ص64): فراغ { *ق := *ق + 1; }
عرف اقرأ(ق: &متغير ص64): ص64 { أرجع *ق; }

عرف اعمل(ق: &مشترك<قفل<ص64>>): فراغ {
    دع ف: متغير ص64 = 0;
    طالما (ف < 10000) {
        نفذ_مع_القفل(اقرأ_مشترك(ق), دالة(س: &متغير ص64): فراغ -> زد(س));
        ف := ف + 1;
    }
}

عرف الرئيسية(): ص32 {
    دع العداد: مشترك<قفل<ص64>> = أنشئ_مشترك(أنشئ_قفل(0 مثل ص64));
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع خ: متغير ص32 = 0;
    طالما (خ < 8) {
        دع نسختي: مشترك<قفل<ص64>> = استنسخ_مشترك(&العداد);
        طابق أطلق(دالة(): فراغ -> اعمل(&نسختي)) مع
        | نتيجة.نجح(م) -> { ألحق(المقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        خ := خ + 1;
    }
    دع ض: متغير طبيعي = 0;
    طالما (ض < (الطول(المقابض) مثل طبيعي)) { انضم(&متغير المقابض[ض]); ض := ض + 1; }
    دع المجموع: ص64 = نفذ_مع_القفل(اقرأ_مشترك(&العداد), دالة(س: &متغير ص64): ص64 -> اقرأ(س));
    لو (المجموع != (80000 مثل ص64)) { أرجع 2; };
    لو (عدد_مراجع_مشترك(&العداد) != 1) { أرجع 3; };
    // تنجح محاولة القفل على قفل حر.
    طابق حاول_القفل(اقرأ_مشترك(&العداد), دالة(س: &متغير ص64): ص64 -> اقرأ(س)) مع
    | اختياري.موجود(ع) -> { لو (ع != (80000 مثل ص64)) { أرجع 4; }; }
    | اختياري.لا_شيء -> { أرجع 5; };
    أرجع 0;
}
