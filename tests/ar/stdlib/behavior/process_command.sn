// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/process_command.sn
// std.process.command: وسائط ومتغير بيئة مضاف ودليل عمل وبيانات دخل وخرج
// وخطأ ملتقطان وحالة الخروج وتيار فارغ وتشغيل فاشل.
استورد std.process.command;
استورد std.process.child;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.error.failure;
استورد std.error.from_command;

عرف الرئيسية(): عدد {
    دع الصدفة: نص = «sh»;
    دع الأمر: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع النص_البرمجي: متجه نص = [«-c», «echo out; echo err >&2; cat; pwd; echo $SULTANC_TEST_VAR; exit 3»];
    أضف_وسائط_للأمر(&متغير الأمر, &النص_البرمجي);
    دع الدخل: متجه ط8 = [104, 105, 10];
    اضبط_بيانات_دخل_الأمر(&متغير الأمر, &الدخل);
    دع الدليل: نص = «/»;
    اضبط_دليل_الأمر(&متغير الأمر, &الدليل);
    دع الاسم: نص = «SULTANC_TEST_VAR»;
    دع القيمة: نص = «value»;
    طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم, &القيمة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> {};
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(الناتج) -> {
        دع الخرج: نص = من_بايتات(&الناتج.الخرج);
        دع الخطأ_المقروء: نص = من_بايتات(&الناتج.الخطأ);
        دع الخرج_المتوقع: نص = "out\nhi\n/\nvalue\n";
        دع الخطأ_المتوقع: نص = "err\n";
        لو (!نصان_متساويان(&الخرج, &الخرج_المتوقع)) { أرجع 3; };
        لو (!نصان_متساويان(&الخطأ_المقروء, &الخطأ_المتوقع)) { أرجع 4; };
        طابق الناتج.الحالة مع
        | حالة_إنهاء.خرج(3) -> {}
        | _ -> { أرجع 5; };
        لو (هل_نجح_الأمر(&الناتج.الحالة)) { أرجع 6; };
    };

    دع الهادئ: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع نص_الهادئ: متجه نص = [«-c», "test -z \"$SULTANC_TEST_VAR\" && echo dropped"];
    أضف_وسائط_للأمر(&متغير الهادئ, &نص_الهادئ);
    امسح_بيئة_الأمر(&متغير الهادئ);
    اضبط_خرج_الأمر(&متغير الهادئ, مصدر_تيار.فارغ());
    طابق شغل_الأمر(&الهادئ) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الحالة) -> { لو (!هل_نجح_الأمر(&الحالة)) { أرجع 8; }; };

    دع المفقود: نص = «/nonexistent/sultanc-program»;
    دع الفاشل: أمر = أنشئ_أمرا(&المفقود);
    طابق شغل_الأمر(&الفاشل) مع
    | نتيجة.خطأ(الإخفاق) -> {
        دع المحول: فشل = فشل_من_خطأ_أمر(&الإخفاق);
        دع النطاق: نص = «std.process»;
        دع النوع: نص = «تشغيل»;
        لو (!هل_من_نوع(&المحول, &النطاق, &النوع)) { أرجع 9; };
    }
    | نتيجة.نجح(_) -> { أرجع 10; };
    أرجع 42;
}
