// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/process_command.sn
// std.process.command: وسائط ومتغير بيئة مضاف ودليل عمل وبيانات دخل وخرج
// وخطأ ملتقطان وحالة الخروج وتيار فارغ وتشغيل فاشل.
استورد المكتبة.عمليات.أمر;
استورد المكتبة.عمليات.عملية_ابن;
استورد المكتبة.نصوص.من_بايتات;
استورد المكتبة.نصوص.مقارنة;
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.أخطاء.من_أمر;

عرف الرئيسية(): عدد {
    ليكن الصدفة: نص = «sh»;
    ليكن الأمر: متغير أمر = أنشئ_أمرا(&الصدفة);
    ليكن النص_البرمجي: متجه نص = [«-c», «echo out; echo err >&2; cat; pwd; echo $SULTANC_TEST_VAR; exit 3»];
    أضف_وسائط_للأمر(&متغير الأمر, &النص_البرمجي);
    ليكن الدخل: متجه ط8 = [104, 105, 10];
    اضبط_بيانات_دخل_الأمر(&متغير الأمر, &الدخل);
    ليكن الدليل: نص = «/»;
    اضبط_دليل_الأمر(&متغير الأمر, &الدليل);
    ليكن الاسم: نص = «SULTANC_TEST_VAR»;
    ليكن القيمة: نص = «value»;
    طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم, &القيمة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> {};
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(الناتج) -> {
        ليكن الخرج: نص = من_بايتات(&الناتج.الخرج);
        ليكن الخطأ_المقروء: نص = من_بايتات(&الناتج.الخطأ);
        ليكن الخرج_المتوقع: نص = "out\nhi\n/\nvalue\n";
        ليكن الخطأ_المتوقع: نص = "err\n";
        إذا (!نصان_متساويان(&الخرج, &الخرج_المتوقع)) { أرجع 3; };
        إذا (!نصان_متساويان(&الخطأ_المقروء, &الخطأ_المتوقع)) { أرجع 4; };
        طابق الناتج.الحالة مع
        | حالة_إنهاء.خرج(3) -> {}
        | _ -> { أرجع 5; };
        إذا (هل_نجح_الأمر(&الناتج.الحالة)) { أرجع 6; };
    };

    ليكن الهادئ: متغير أمر = أنشئ_أمرا(&الصدفة);
    ليكن نص_الهادئ: متجه نص = [«-c», "test -z \"$SULTANC_TEST_VAR\" && echo dropped"];
    أضف_وسائط_للأمر(&متغير الهادئ, &نص_الهادئ);
    امسح_بيئة_الأمر(&متغير الهادئ);
    اضبط_خرج_الأمر(&متغير الهادئ, مصدر_تيار.فارغ());
    طابق شغل_الأمر(&الهادئ) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الحالة) -> { إذا (!هل_نجح_الأمر(&الحالة)) { أرجع 8; }; };

    ليكن المفقود: نص = «/nonexistent/sultanc-program»;
    ليكن الفاشل: أمر = أنشئ_أمرا(&المفقود);
    طابق شغل_الأمر(&الفاشل) مع
    | نتيجة.خطأ(الإخفاق) -> {
        ليكن المحول: فشل = فشل_من_خطأ_أمر(&الإخفاق);
        ليكن النطاق: نص = «std.process»;
        ليكن النوع: نص = «تشغيل»;
        إذا (!هل_من_نوع(&المحول, &النطاق, &النوع)) { أرجع 9; };
    }
    | نتيجة.نجح(_) -> { أرجع 10; };
    أرجع 42;
}
