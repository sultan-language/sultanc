// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/http2_hpack.sn
// std.http.http2.hpack (RFC 7541) على أمثلة الملحق C من المعيار: طلبات دون ترميز
// هوفمان وبه (C.3، C.4)، واستجابات بجدول 256 بايتا مع الإخلاء (C.5، C.6)؛ والمرمز
// يعيد C.4 بايتا ببايت؛ والكتل التالفة (فهرس 0 أو خارج الجدول، وتحديث حجم متأخر أو
// كبير، وحشو هوفمان خاطئ، وعدد كبير، وبتر) وقائمة رؤوس فوق الحد مرفوضة. ومعها
// تخطيط ترويسة الإطار.
استورد std.encoding.hex;
استورد std.text.from_bytes;
استورد std.http.model;
استورد std.http.http2.hpack;
استورد std.http.http2.frame;

عرف من_سداسي(النص: نص): متجه ط8 {
    طابق فك_سداسي(&النص) مع
    | نتيجة.نجح(ق) -> { أرجع ق; }
    | نتيجة.خطأ(_) -> { دع فارغ: متجه ط8 = []; أرجع فارغ; };
}

عرف نصان_متطابقان(أ: &نص, ب: نص): منطقي {
    لو (الطول(*أ) != الطول(ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) { لو ((*أ)[ف] != ب[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

// تفك كتلة وتفحص عدد حقولها وآخر حقل فيها.
عرف افحص_كتلة(المفكك: &متغير مفكك_إتش_باك, الكتلة: نص, العدد: طبيعي, الاسم: نص, القيمة: نص): منطقي {
    دع البايتات: متجه ط8 = من_سداسي(الكتلة);
    طابق فك_كتلة_إتش_باك(المفكك, &البايتات, 0) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(الحقول) -> {
        لو ((الطول(الحقول) مثل طبيعي) != العدد) { أرجع خطأ; };
        دع الأخير: طبيعي = العدد - 1;
        أرجع نصان_متطابقان(&الحقول[الأخير].الاسم, الاسم) && نصان_متطابقان(&الحقول[الأخير].القيمة, القيمة);
    };
}

عرف خطأ_الفك(الكتلة: نص, الجدول: طبيعي, الحد: طبيعي): اختياري خطأ_إتش_باك {
    دع المفكك: متغير مفكك_إتش_باك = أنشئ_مفكك_إتش_باك(الجدول);
    دع البايتات: متجه ط8 = من_سداسي(الكتلة);
    طابق فك_كتلة_إتش_باك(&متغير المفكك, &البايتات, الحد) مع
    | نتيجة.خطأ(خ) -> { أرجع اختياري.موجود(خ); }
    | نتيجة.نجح(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف سداسي_يساوي(البايتات: &متجه ط8, المتوقع: نص): منطقي {
    دع النص: نص = رمز_سداسي(البايتات);
    أرجع نصان_متطابقان(&النص, المتوقع);
}

عرف حقل(الاسم: نص, القيمة: نص): رأس_ويب {
    دع ر: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
    أرجع ر;
}

عرف الرئيسية(): عدد {
    دع الطلبات: متغير مفكك_إتش_باك = أنشئ_مفكك_إتش_باك(4096);
    لو (!افحص_كتلة(&متغير الطلبات, «828684410f7777772e6578616d706c652e636f6d», 4, «:authority», «www.example.com»)) { أرجع 1; };
    لو (!افحص_كتلة(&متغير الطلبات, «828684be58086e6f2d6361636865», 5, «cache-control», «no-cache»)) { أرجع 2; };
    لو (!افحص_كتلة(&متغير الطلبات, «828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565», 5, «custom-key», «custom-value»)) { أرجع 3; };
    دع هوفمان: متغير مفكك_إتش_باك = أنشئ_مفكك_إتش_باك(4096);
    لو (!افحص_كتلة(&متغير هوفمان, «828684418cf1e3c2e5f23a6ba0ab90f4ff», 4, «:authority», «www.example.com»)) { أرجع 4; };
    لو (!افحص_كتلة(&متغير هوفمان, «828684be5886a8eb10649cbf», 5, «cache-control», «no-cache»)) { أرجع 5; };
    لو (!افحص_كتلة(&متغير هوفمان, «828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf», 5, «custom-key», «custom-value»)) { أرجع 6; };
    دع الاستجابات: متغير مفكك_إتش_باك = أنشئ_مفكك_إتش_باك(256);
    لو (!افحص_كتلة(&متغير الاستجابات, «4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d», 4, «location», «https://www.example.com»)) { أرجع 7; };
    لو (!افحص_كتلة(&متغير الاستجابات, «4803333037c1c0bf», 4, «location», «https://www.example.com»)) { أرجع 8; };
    لو (!افحص_كتلة(&متغير الاستجابات, «88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31», 6, «set-cookie», «foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1»)) { أرجع 9; };
    دع المرمزة: متغير مفكك_إتش_باك = أنشئ_مفكك_إتش_باك(256);
    لو (!افحص_كتلة(&متغير المرمزة, «488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3», 4, «location», «https://www.example.com»)) { أرجع 10; };
    لو (!افحص_كتلة(&متغير المرمزة, «4883640effc1c0bf», 4, «location», «https://www.example.com»)) { أرجع 11; };

    // يكتب المرمز C.4 كما هو.
    دع المرمز: متغير مرمز_إتش_باك = أنشئ_مرمز_إتش_باك();
    دع الأول: متغير متجه رأس_ويب = [];
    ألحق(الأول, حقل(«:method», «GET»));
    ألحق(الأول, حقل(«:scheme», «http»));
    ألحق(الأول, حقل(«:path», «/»));
    ألحق(الأول, حقل(«:authority», «www.example.com»));
    دع الكتلة1: متجه ط8 = رمز_رؤوس_إتش_باك(&متغير المرمز, &الأول);
    لو (!سداسي_يساوي(&الكتلة1, «828684418cf1e3c2e5f23a6ba0ab90f4ff»)) { أرجع 12; };
    ألحق(الأول, حقل(«cache-control», «no-cache»));
    دع الكتلة2: متجه ط8 = رمز_رؤوس_إتش_باك(&متغير المرمز, &الأول);
    لو (!سداسي_يساوي(&الكتلة2, «828684be5886a8eb10649cbf»)) { أرجع 13; };
    دع الثالث: متغير متجه رأس_ويب = [];
    ألحق(الثالث, حقل(«:method», «GET»));
    ألحق(الثالث, حقل(«:scheme», «https»));
    ألحق(الثالث, حقل(«:path», «/index.html»));
    ألحق(الثالث, حقل(«:authority», «www.example.com»));
    ألحق(الثالث, حقل(«custom-key», «custom-value»));
    دع الكتلة3: متجه ط8 = رمز_رؤوس_إتش_باك(&متغير المرمز, &الثالث);
    لو (!سداسي_يساوي(&الكتلة3, «828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf»)) { أرجع 14; };
    // الحقول الحساسة لا تُفهرس أبدا (6.2.3).
    دع السري: متغير متجه رأس_ويب = [];
    ألحق(السري, حقل(«authorization», «Basic c2VjcmV0»));
    دع الكتلة4: متجه ط8 = رمز_رؤوس_إتش_باك(&متغير المرمز, &السري);
    لو (الكتلة4[0] != 0x1F) { أرجع 15; };

    // كتل تالفة.
    طابق خطأ_الفك(«80», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.فهرس_غير_صالح) -> { } | _ -> { أرجع 16; };
    طابق خطأ_الفك(«be», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.فهرس_غير_صالح) -> { } | _ -> { أرجع 17; };
    طابق خطأ_الفك(«8220», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.تحديث_حجم_غير_صالح) -> { } | _ -> { أرجع 18; };
    طابق خطأ_الفك(«3fe11f», 256, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.تحديث_حجم_غير_صالح) -> { } | _ -> { أرجع 19; };
    طابق خطأ_الفك(«048100», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.هوفمان_غير_صالح) -> { } | _ -> { أرجع 20; };
    طابق خطأ_الفك(«ffffffffff7f», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.عدد_كبير) -> { } | _ -> { أرجع 21; };
    طابق خطأ_الفك(«410f77», 4096, 0) مع
    | اختياري.موجود(خطأ_إتش_باك.نهاية_غير_متوقعة) -> { } | _ -> { أرجع 22; };
    طابق خطأ_الفك(«828684410f7777772e6578616d706c652e636f6d», 4096, 40) مع
    | اختياري.موجود(خطأ_إتش_باك.قائمة_رؤوس_كبيرة) -> { } | _ -> { أرجع 23; };

    // ترويسة إطار (RFC 9113 4.1): الطول والنوع والأعلام والتيار.
    دع الإطار: متغير متجه ط8 = [];
    دع الحمولة: متجه ط8 = [1, 2, 3];
    ألحق_إطار_ويب2(&متغير الإطار, 1, 5, 3, &الحمولة, 0, 3);
    لو (!سداسي_يساوي(&الإطار, «000003010500000003010203»)) { أرجع 24; };
    أرجع 42;
}
