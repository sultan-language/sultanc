// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// قفل المخصص تحت التنافس (std/os/allocation.sn): خيوط أكثر من الأنوية تخصص
// متجهات وتنميها وتتحقق منها وتحررها معا، فيُمسك القفل وغيرها ينتظر ويجري
// مسار النوم والإيقاظ. يحفظ كل متجه ما كتبه خيطه بالضبط، وينتهي كل خيط.
// النظير: tests/en/stdlib/behavior/thread_alloc_contention.sn. لا توجيه
// نظير: المفسر يشغل خيطا واحدا.
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;

عرف اخلط(البذرة: ط64, المنتهي: &مشترك<ذرة_ط64>): فراغ {
    دع الجولة: متغير طبيعي = 0;
    طالما (الجولة < 2000) {
        دع العناصر: متغير متجه ط64 = [];
        دع ع: طبيعي = 1 + ((الجولة * 7) % 300);
        دع ف: متغير طبيعي = 0;
        طالما (ف < ع) { ألحق(العناصر, البذرة + (ف مثل ط64)); ف := ف + 1; }
        ف := 0;
        طالما (ف < ع) {
            إذا (العناصر[ف] != البذرة + (ف مثل ط64)) { أرجع; };
            ف := ف + 1;
        }
        الجولة := الجولة + 1;
    }
    دع تجاهل: ط64 = اجمع_واجلب_ط64(اقرأ_مشترك(المنتهي), 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
}

عرف ابدأ(البذرة: ط64, المنتهي: &مشترك<ذرة_ط64>): اختياري مقبض_خيط {
    دع نسختي: مشترك<ذرة_ط64> = استنسخ_مشترك(المنتهي);
    طابق أطلق(دالة(): فراغ -> اخلط(البذرة, &نسختي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف الرئيسية(): ص32 {
    دع المنتهي: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));
    دع مقابض: متغير متجه مقبض_خيط = [];
    دع خ: متغير طبيعي = 0;
    طالما (خ < 8) {
        طابق ابدأ((خ مثل ط64) * 1000000, &المنتهي) مع
        | اختياري.موجود(م) -> { ألحق(مقابض, م); }
        | اختياري.لا_شيء -> { أرجع 1; };
        خ := خ + 1;
    }
    دع ق: متغير طبيعي = 0;
    طالما (ق < (الطول(مقابض) مثل طبيعي)) { انضم(&متغير مقابض[ق]); ق := ق + 1; }
    إذا (احمل_ط64(اقرأ_مشترك(&المنتهي), ترتيب_ذاكرة.تسلسلي()) != (8 مثل ط64)) { أرجع 2; };
    أرجع 0;
}
