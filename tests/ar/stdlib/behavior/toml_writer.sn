// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/toml_writer.sn
// ذهاب وإياب: كتابة وثيقة محللة ثم تحليل الناتج يعطي القيم نفسها، وكتابتها مجددا تعطي النص نفسه.
استورد std.toml.parser;
استورد std.toml.writer;
استورد std.text.compare;

عرف الرئيسية(): عدد {
    دع المصدر: نص = "title = \"Sultan \\\"C\\\"\"\nversion = 3\nflags = [true, false]\n\"odd key\" = 1.5\n[owner]\nname = \"أحمد\"\nborn = 1979-05-27T07:32:00Z\n[owner.address]\ncity = \"Riyadh\"\n[[targets]]\nname = \"x86_64\"\n[[targets]]\nname = \"arm64\"\ninline = { a = 1, b = [2, 3] }\n";
    طابق حلل_تومل(&المصدر) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(الوثيقة) -> {
        دع الأول: نص = تومل_إلى_نص(&الوثيقة);
        طابق حلل_تومل(&الأول) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المعادة) -> {
            دع الثاني: نص = تومل_إلى_نص(&المعادة);
            لو (!نصان_متساويان(&الأول, &الثاني)) { أرجع 3; };
            دع مفتاح_العنوان: نص = «title»;
            طابق قيمة_مفتاح_تومل(&المعادة, المعادة.الجذر, &مفتاح_العنوان) مع
            | اختياري.موجود(قيمة_تومل.سلسلة(النص)) -> {
                دع المتوقع: نص = "Sultan \"C\"";
                لو (!نصان_متساويان(&النص, &المتوقع)) { أرجع 4; };
            }
            | _ -> { أرجع 5; };
            دع مفتاح_المالك: نص = «owner»;
            طابق جدول_مفتاح_تومل(&المعادة, المعادة.الجذر, &مفتاح_المالك) مع
            | اختياري.لا_شيء -> { أرجع 6; }
            | اختياري.موجود(المالك) -> {
                دع مفتاح_الاسم: نص = «name»;
                طابق قيمة_مفتاح_تومل(&المعادة, المالك, &مفتاح_الاسم) مع
                | اختياري.موجود(قيمة_تومل.سلسلة(الاسم)) -> {
                    دع الاسم_المتوقع: نص = «أحمد»;
                    لو (!نصان_متساويان(&الاسم, &الاسم_المتوقع)) { أرجع 7; };
                }
                | _ -> { أرجع 8; };
                دع مفتاح_العنوان_البريدي: نص = «address»;
                طابق جدول_مفتاح_تومل(&المعادة, المالك, &مفتاح_العنوان_البريدي) مع
                | اختياري.لا_شيء -> { أرجع 9; }
                | اختياري.موجود(_) -> { };
            };
            دع مفتاح_الأهداف: نص = «targets»;
            طابق قيمة_مفتاح_تومل(&المعادة, المعادة.الجذر, &مفتاح_الأهداف) مع
            | اختياري.موجود(قيمة_تومل.مصفوفة(الفهرس)) -> {
                لو (الطول(قيم_مصفوفة_تومل(&المعادة, الفهرس)) != 2) { أرجع 10; };
            }
            | _ -> { أرجع 11; };
        };
    };
    أرجع 42;
}
