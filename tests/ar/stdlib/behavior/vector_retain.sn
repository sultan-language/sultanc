// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/vector_retain.sn
// دوال الإزالة في std.collections.vector فوق أزل_الأخير واقتطع:
// احتفظ_في_المتجه (‏Vec::retain في Rust)، أزل_المتكرر_المتتالي (‏Vec::dedup_by)،
// أزل_عند / أزل_بالتبديل / أدرج_عند (‏Vec::remove/swap_remove/insert)
// وامسح_المتجه، على أعداد وعلى نص مملوك.
استورد std.collections.vector;
استورد std.text.compare;

عرف زوجي(ق: &عدد): منطقي { أرجع *ق % 2 == 0; }
عرف متساويان(أ: &عدد, ب: &عدد): منطقي { أرجع *أ == *ب; }
عرف كلمة_طويلة(ك: &نص): منطقي { أرجع الطول(*ك) > 6; }
عرف نصان_متطابقان(أ: &نص, ب: &نص): منطقي { أرجع نصان_متساويان(أ, ب); }

عرف أرقام(القيم: &متجه عدد): عدد {
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) { المجموع := المجموع * 10 + (*القيم)[ف]; ف := ف + 1; }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع القيم: متغير متجه عدد = [1, 2, 3, 4, 5, 6];
    احتفظ_في_المتجه(&متغير القيم, زوجي);
    إذا (الطول(القيم) != 3 || أرقام(&القيم) != 246) { أرجع 1; };
    دع المتتاليات: متغير متجه عدد = [1, 1, 2, 2, 2, 3, 1, 1];
    أزل_المتكرر_المتتالي(&متغير المتتاليات, متساويان);
    إذا (الطول(المتتاليات) != 4 || أرقام(&المتتاليات) != 1231) { أرجع 2; };
    دع الخانات: متغير متجه عدد = [1, 2, 3, 4];
    طابق أزل_عند(&متغير الخانات, 1) مع
    | اختياري.موجود(ق) -> { إذا (ق != 2) { أرجع 3; }; }
    | اختياري.لا_شيء -> { أرجع 4; };
    إذا (أرقام(&الخانات) != 134) { أرجع 5; };
    طابق أزل_عند(&متغير الخانات, 9) مع
    | اختياري.موجود(_) -> { أرجع 6; }
    | اختياري.لا_شيء -> { };
    أدرج_عند(&متغير الخانات, 0, 9);
    أدرج_عند(&متغير الخانات, 2, 7);
    أدرج_عند(&متغير الخانات, 99, 8);
    إذا (أرقام(&الخانات) != 917348) { أرجع 7; };
    طابق أزل_بالتبديل(&متغير الخانات, 0) مع
    | اختياري.موجود(ق) -> { إذا (ق != 9) { أرجع 8; }; }
    | اختياري.لا_شيء -> { أرجع 9; };
    إذا (أرقام(&الخانات) != 81734) { أرجع 10; };
    امسح_المتجه(&متغير الخانات);
    إذا (الطول(الخانات) != 0) { أرجع 11; };

    دع الكلمات: متغير متجه نص = [];
    ألحق(الكلمات, "شمس");
    ألحق(الكلمات, "قمر");
    ألحق(الكلمات, "قمر");
    ألحق(الكلمات, "نجمة");
    ألحق(الكلمات, "سماء");
    ألحق(الكلمات, "مذنب");
    أزل_المتكرر_المتتالي(&متغير الكلمات, نصان_متطابقان);
    إذا (الطول(الكلمات) != 5) { أرجع 12; };
    احتفظ_في_المتجه(&متغير الكلمات, كلمة_طويلة);
    دع مذنب: نص = "مذنب";
    دع نجمة: نص = "نجمة";
    إذا (الطول(الكلمات) != 3 || !نصان_متساويان(&الكلمات[2], &مذنب) || !نصان_متساويان(&الكلمات[0], &نجمة)) { أرجع 13; };
    طابق أزل_عند(&متغير الكلمات, 0) مع
    | اختياري.موجود(ك) -> { إذا (!نصان_متساويان(&ك, &نجمة)) { أرجع 14; }; }
    | اختياري.لا_شيء -> { أرجع 15; };
    أدرج_عند(&متغير الكلمات, 1, "كوكب");
    دع كوكب: نص = "كوكب";
    إذا (الطول(الكلمات) != 3 || !نصان_متساويان(&الكلمات[1], &كوكب)) { أرجع 16; };
    امسح_المتجه(&متغير الكلمات);
    ألحق(الكلمات, "مجددا");
    إذا (الطول(الكلمات) != 1) { أرجع 17; };
    أرجع 42;
}
