// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/http2_connection.sn
// std.http.http2.connection فوق زوج TCP محلي في عملية واحدة، يُقاد كل طرف خطوة
// خطوة: تبادل المقدمة وSETTINGS، وتياران متزامنان (GET وPOST بجسم)، وكتل الرؤوس عبر
// HPACK، واستجابة من 20 000 بايت عبر نافذة تيار 8 كيلوبايت لا تكبر إلا بـ
// WINDOW_UPDATE، وPING وتأكيده، وRST_STREAM، ثم GOAWAY.
استورد std.net.socket_address;
استورد std.net.tcp;
استورد std.net.options;
استورد std.io.writer;
استورد std.text.from_bytes;
استورد std.http.model;
استورد std.http.transport;
استورد std.http.http2.frame;
استورد std.http.http2.connection;

عرف حقل(الاسم: نص, القيمة: نص): رأس_ويب {
    دع ر: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
    أرجع ر;
}

عرف نصان_متطابقان(أ: &نص, ب: نص): منطقي {
    إذا (الطول(*أ) != الطول(ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) { إذا ((*أ)[ف] != ب[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف خطوة(الاتصال: &متغير اتصال_ويب2): منطقي {
    طابق اقرأ_وعالج_إطار_ويب2(الاتصال) مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف موضع_في(الاتصال: &اتصال_ويب2, المعرف: طبيعي): طبيعي {
    طابق موقع_تيار_ويب2(الاتصال, المعرف) مع
    | اختياري.موجود(ف) -> { أرجع ف; }
    | اختياري.لا_شيء -> { أرجع 9999; };
}

عرف شغل(الخادم: &متغير اتصال_ويب2, العميل: &متغير اتصال_ويب2): عدد {
    // المقدمة وSETTINGS (RFC 9113 3.4).
    دع المقدمة: متجه ط8 = مقدمة_ويب2();
    طابق اكتب_الكل(&(*العميل).الناقل, اكتب_ناقل_ويب, &المقدمة) مع
    | نتيجة.خطأ(_) -> { أرجع 10; } | نتيجة.نجح(_) -> { };
    طابق أرسل_إعدادات_ويب2(العميل) مع | نتيجة.خطأ(_) -> { أرجع 11; } | نتيجة.نجح(_) -> { };
    طابق أرسل_إعدادات_ويب2(الخادم) مع | نتيجة.خطأ(_) -> { أرجع 12; } | نتيجة.نجح(_) -> { };
    طابق اقرأ_مقدمة_ويب2(الخادم) مع | نتيجة.خطأ(_) -> { أرجع 13; } | نتيجة.نجح(_) -> { };
    // تصل SETTINGS العميل إلى الخادم (نافذة 8 كيلوبايت لا تحتاج WINDOW_UPDATE للاتصال).
    إذا (!خطوة(الخادم)) { أرجع 14; };
    إذا (!(*الخادم).إعدادات_مستلمة) { أرجع 15; };
    // تصل SETTINGS الخادم وWINDOW_UPDATE وتأكيد SETTINGS إلى العميل.
    إذا (!خطوة(العميل) || !خطوة(العميل) || !خطوة(العميل)) { أرجع 16; };
    إذا (!خطوة(الخادم)) { أرجع 17; };

    // تياران متزامنان.
    دع الجلب: طبيعي = افتح_تيار_ويب2(العميل);
    دع رؤوس_الجلب: متغير متجه رأس_ويب = [];
    ألحق(رؤوس_الجلب, حقل(«:method», «GET»));
    ألحق(رؤوس_الجلب, حقل(«:scheme», «http»));
    ألحق(رؤوس_الجلب, حقل(«:authority», «127.0.0.1»));
    ألحق(رؤوس_الجلب, حقل(«:path», «/one»));
    طابق أرسل_رؤوس_ويب2(العميل, الجلب, &رؤوس_الجلب, صواب) مع | نتيجة.خطأ(_) -> { أرجع 20; } | نتيجة.نجح(_) -> { };
    دع الإرسال: طبيعي = افتح_تيار_ويب2(العميل);
    دع رؤوس_الإرسال: متغير متجه رأس_ويب = [];
    ألحق(رؤوس_الإرسال, حقل(«:method», «POST»));
    ألحق(رؤوس_الإرسال, حقل(«:scheme», «http»));
    ألحق(رؤوس_الإرسال, حقل(«:authority», «127.0.0.1»));
    ألحق(رؤوس_الإرسال, حقل(«:path», «/two»));
    طابق أرسل_رؤوس_ويب2(العميل, الإرسال, &رؤوس_الإرسال, خطأ) مع | نتيجة.خطأ(_) -> { أرجع 21; } | نتيجة.نجح(_) -> { };
    دع الجسم: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2000) { ألحق(الجسم, (ف % 256) مثل ط8); ف := ف + 1; }
    ضع_جسم_ويب2(العميل, الإرسال, الجسم);
    طابق ادفع_بيانات_ويب2(العميل) مع | نتيجة.خطأ(_) -> { أرجع 22; } | نتيجة.نجح(_) -> { };
    إذا (الجلب != 1 || الإرسال != 3) { أرجع 23; };

    // يرى الخادم الطلبين مكتملين.
    دع الإطارات: متغير طبيعي = 0;
    طالما (الإطارات < 3) { إذا (!خطوة(الخادم)) { أرجع 24; }; الإطارات := الإطارات + 1; }
    دع ج: طبيعي = موضع_في(الخادم, 1);
    دع م: طبيعي = موضع_في(الخادم, 3);
    إذا (ج == 9999 || م == 9999) { أرجع 25; };
    إذا (!(*الخادم).التيارات[ج].مغلق_بعيدا || !(*الخادم).التيارات[م].مغلق_بعيدا) { أرجع 26; };
    إذا (!نصان_متطابقان(&(*الخادم).التيارات[ج].الرؤوس[3].القيمة, «/one»)) { أرجع 27; };
    إذا (الطول((*الخادم).التيارات[م].الجسم) != 2000 || (*الخادم).التيارات[م].الجسم[1999] != 207) { أرجع 28; };

    // الاستجابات: واحدة قصيرة، و20 000 بايت عبر نافذة 8 كيلوبايت.
    دع رؤوس_النجاح: متغير متجه رأس_ويب = [];
    ألحق(رؤوس_النجاح, حقل(«:status», «200»));
    ألحق(رؤوس_النجاح, حقل(«content-type», «text/plain»));
    طابق أرسل_رؤوس_ويب2(الخادم, 3, &رؤوس_النجاح, خطأ) مع | نتيجة.خطأ(_) -> { أرجع 30; } | نتيجة.نجح(_) -> { };
    دع الكبير: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 20000) { ألحق(الكبير, (65 + (ف % 26)) مثل ط8); ف := ف + 1; }
    ضع_جسم_ويب2(الخادم, 3, الكبير);
    دع الرد: متجه ط8 = بايتات_من_نص(«one»);
    طابق أرسل_رؤوس_ويب2(الخادم, 1, &رؤوس_النجاح, خطأ) مع | نتيجة.خطأ(_) -> { أرجع 31; } | نتيجة.نجح(_) -> { };
    ضع_جسم_ويب2(الخادم, 1, الرد);
    دع الجولات: متغير طبيعي = 0;
    دع معلق: متغير منطقي = صواب;
    طالما (معلق) {
        طابق ادفع_بيانات_ويب2(الخادم) مع
        | نتيجة.خطأ(_) -> { أرجع 32; }
        | نتيجة.نجح(المزيد) -> { معلق := المزيد; };
        // يقرأ العميل ما أُرسل، فيعيد رصيد النافذة.
        دع مع3: طبيعي = موضع_في(العميل, 3);
        دع المرسل: طبيعي = (*الخادم).التيارات[موضع_في(الخادم, 3)].موضع_الإرسال;
        طالما (الطول((*العميل).التيارات[مع3].الجسم) مثل طبيعي < المرسل || !(*العميل).التيارات[موضع_في(العميل, 1)].مغلق_بعيدا) {
            إذا (!خطوة(العميل)) { أرجع 33; };
        }
        إذا (معلق) {
            // تصل تحديثات نافذة الاتصال والتيار إلى الخادم.
            دع قبل: عدد = (*الخادم).التيارات[موضع_في(الخادم, 3)].نافذة_الإرسال;
            طالما ((*الخادم).التيارات[موضع_في(الخادم, 3)].نافذة_الإرسال == قبل) {
                إذا (!خطوة(الخادم)) { أرجع 34; };
            }
        };
        الجولات := الجولات + 1;
        إذا (الجولات > 20) { أرجع 35; };
    }
    إذا (الجولات < 3) { أرجع 36; };
    دع ع3: طبيعي = موضع_في(العميل, 3);
    إذا (الطول((*العميل).التيارات[ع3].الجسم) != 20000 || !(*العميل).التيارات[ع3].مغلق_بعيدا) { أرجع 37; };
    إذا (!نصان_متطابقان(&(*العميل).التيارات[ع3].الرؤوس[0].القيمة, «200»)) { أرجع 38; };
    دع ع1: طبيعي = موضع_في(العميل, 1);
    إذا (الطول((*العميل).التيارات[ع1].الجسم) != 3) { أرجع 39; };

    // PING وتأكيده (6.7).
    دع المعتم: متجه ط8 = [1, 2, 3, 4, 5, 6, 7, 8];
    طابق اكتب_إطار_ويب2(العميل, 6, 0, 0, &المعتم) مع | نتيجة.خطأ(_) -> { أرجع 40; } | نتيجة.نجح(_) -> { };
    إذا (!خطوة(الخادم) || !خطوة(العميل)) { أرجع 41; };

    // تيار ملغى (6.4).
    دع الثالث: طبيعي = افتح_تيار_ويب2(العميل);
    طابق أرسل_رؤوس_ويب2(العميل, الثالث, &رؤوس_الجلب, خطأ) مع | نتيجة.خطأ(_) -> { أرجع 42; } | نتيجة.نجح(_) -> { };
    طابق ألغ_تيار_ويب2(العميل, الثالث, 8) مع | نتيجة.خطأ(_) -> { أرجع 43; } | نتيجة.نجح(_) -> { };
    إذا (!خطوة(الخادم) || !خطوة(الخادم)) { أرجع 44; };
    دع خ5: طبيعي = موضع_في(الخادم, 5);
    إذا (خ5 == 9999 || !(*الخادم).التيارات[خ5].ملغى || (*الخادم).التيارات[خ5].رمز_الإلغاء != 8) { أرجع 45; };

    // GOAWAY (6.8).
    ودع_اتصال_ويب2(الخادم);
    إذا (!خطوة(العميل)) { أرجع 46; };
    إذا (!(*العميل).وداع_مستلم || (*العميل).آخر_معرف_وداع != 5) { أرجع 47; };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    دع النص: نص = «127.0.0.1:38632»;
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(العنوان) -> {
        دع الخيارات: متجه خيار_مقبس = [خيار_مقبس.إعادة_استخدام_العنوان(صواب)];
        طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 4, &الخيارات) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(المستمع) -> {
            طابق اتصل_تي_سي_بي(&العنوان) مع
            | نتيجة.خطأ(_) -> { أرجع 3; }
            | نتيجة.نجح(تدفق_العميل) -> {
                طابق اقبل_تي_سي_بي(&المستمع) مع
                | نتيجة.خطأ(_) -> { أرجع 4; }
                | نتيجة.نجح(تدفق_الخادم) -> {
                    دع حدود_الخادم: حدود_ويب2 = حدود_ويب2_افتراضية();
                    دع حدود_العميل: متغير حدود_ويب2 = حدود_ويب2_افتراضية();
                    حدود_العميل.النافذة_الأولية := 8192;
                    دع لا_شيء1: متجه ط8 = [];
                    دع لا_شيء2: متجه ط8 = [];
                    دع الخادم: متغير اتصال_ويب2 = أنشئ_اتصال_ويب2(ناقل_ويب.تي_سي_بي(تدفق_الخادم), صواب, &حدود_الخادم, لا_شيء1);
                    دع العميل: متغير اتصال_ويب2 = أنشئ_اتصال_ويب2(ناقل_ويب.تي_سي_بي(تدفق_العميل), خطأ, &حدود_العميل, لا_شيء2);
                    دع الحالة: عدد = شغل(&متغير الخادم, &متغير العميل);
                    دع إغلاق_العميل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(العميل);
                    دع إغلاق_الخادم: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الخادم);
                    إذا (الحالة != 0) { أرجع الحالة; };
                };
            };
            دع الإغلاق: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        };
    };
    أرجع 42;
}
