// نظير: tests/en/stdlib/behavior/float_primitives.sn
// العمليات العائمة البدائية خلف std.math بقيم IEEE دقيقة كأنماط بتات، والجذر
// مقابل تكرار نيوتن القديم في الحالات الحدية. مولد.
استورد std.math.float;

// الجذر البرمجي الذي استعمله std.math قبل البدائيات (تكرار نيوتن).
عرف جذر_نيوتن64(القيمة: ع64): ع64 {
    إذا (ليس_رقما64(القيمة)) { أرجع القيمة; };
    إذا (القيمة < 0.0) { دع الصفر: ع64 = 0.0; أرجع الصفر / الصفر; };
    إذا ((القيمة == 0.0) || هل_لانهاية64(القيمة)) { أرجع القيمة; };
    دع المطبع: متغير ع64 = القيمة;
    دع المقياس: متغير ع64 = 1.0;
    طالما (المطبع >= 4.0) { المطبع := المطبع / 4.0; المقياس := المقياس * 2.0; }
    طالما (المطبع < 1.0) { المطبع := المطبع * 4.0; المقياس := المقياس / 2.0; }
    دع البداية: ع64 = المطبع + 1.0;
    دع التخمين: متغير ع64 = البداية / 2.0;
    دع الخطوة: متغير طبيعي = 0;
    طالما (الخطوة < 10) {
        دع النسبة: ع64 = المطبع / التخمين;
        دع المجموع: ع64 = التخمين + النسبة;
        التخمين := المجموع / 2.0;
        الخطوة := الخطوة + 1;
    }
    أرجع التخمين * المقياس;
}

