// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// النظير: tests/en/stdlib/behavior/thread_many_short.sn
// بلا توجيه زوج: المفسر يشغل خيط نظام واحدا ويتوقف عند الإطلاق.
// std.thread: ألف خيط قصير العمر، في 125 دفعة من ثمانية خيوط. يضيف كل خيط
// رقمه إلى خانته (جمع ذري في مشترك Arc)، ثم يضم البرنامج الدفعة كلها قبل
// التالية. يتحقق البرنامج من المجموع، ومن أن بايتات المخصص الحية بعد الألف
// هي نفسها قبلها: الخيط يفلت إغلاقه ونسخته من المشترك حين ينتهي، والضم يحرر
// مدخله ويلغي ربط مكدسه حيث يربطه std (لو بقيت مكادس الألف، وهي 2 ميبيبايت
// لكل منها، لنفد فضاء عناوين الأهداف ذات 32 بتا).
استورد std.thread.thread;
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.os.allocation;

نوع خانات = { القيم: متجه ذرة_ط64 };

عرف أضف_إلى_خانة(الخانات: &مشترك<خانات>, الموضع: طبيعي, الرقم: ط64): فراغ {
    دع م: &خانات = اقرأ_مشترك(الخانات);
    دع تجاهل: ط64 = اجمع_واجلب_ط64(&(*م).القيم[الموضع], الرقم, ترتيب_ذاكرة.تسلسلي());
}

عرف ابدأ(الخانات: &مشترك<خانات>, الموضع: طبيعي, الرقم: ط64): اختياري مقبض_خيط {
    دع نسختي: مشترك<خانات> = استنسخ_مشترك(الخانات);
    طابق أطلق(دالة(): فراغ -> أضف_إلى_خانة(&نسختي, الموضع, الرقم)) مع
    | نتيجة.نجح(المقبض) -> { أرجع اختياري.موجود(المقبض); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// دفعة واحدة: ثمانية خيوط، يضيف كل منها رقمه إلى خانته، ثم الضم.
عرف شغل_دفعة(الخانات: &مشترك<خانات>, الدفعة: ط64, مقابض: &متغير متجه مقبض_خيط): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        طابق ابدأ(الخانات, ف, (الدفعة * 8) + (ف مثل ط64)) مع
        | اختياري.موجود(المقبض) -> { (*مقابض)[ف] := المقبض; }
        | اختياري.لا_شيء -> { أرجع خطأ; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < 8) { انضم(&متغير (*مقابض)[ف]); ف := ف + 1; }
    أرجع صواب;
}

عرف الرئيسية(): ص32 {
    دع القيم: متغير متجه ذرة_ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) { ألحق(القيم, أنشئ_ذرة_ط64(0)); ف := ف + 1; }
    دع الابتدائية: خانات = { القيم: القيم };
    دع الخانات: مشترك<خانات> = أنشئ_مشترك(الابتدائية);

    // المقابض في متجه بسعة ثابتة، تملؤه كل دفعة من جديد.
    دع مقابض: متغير متجه مقبض_خيط = [];
    ف := 0;
    طالما (ف < 8) {
        طابق ابدأ(&الخانات, 0, 0) مع
        | اختياري.موجود(المقبض) -> { ألحق(مقابض, المقبض); }
        | اختياري.لا_شيء -> { أرجع 1; };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < 8) { انضم(&متغير مقابض[ف]); ف := ف + 1; }

    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع الدفعة: متغير ط64 = 0;
    طالما (الدفعة < 125) {
        لو (!شغل_دفعة(&الخانات, الدفعة, &متغير مقابض)) { أرجع 2; };
        الدفعة := الدفعة + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    لو (بعد != قبل) { أرجع 3; };

    // مجموع الأرقام من 0 إلى 999.
    دع م: &خانات = اقرأ_مشترك(&الخانات);
    دع المجموع: متغير ط64 = 0;
    ف := 0;
    طالما (ف < 8) { المجموع := المجموع + احمل_ط64(&(*م).القيم[ف], ترتيب_ذاكرة.تسلسلي()); ف := ف + 1; }
    لو (المجموع != 499500) { أرجع 4; };
    لو (عدد_مراجع_مشترك(&الخانات) != 1) { أرجع 5; };
    أرجع 42;
}
