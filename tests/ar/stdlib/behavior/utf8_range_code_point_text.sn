// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/utf8_range_code_point_text.sn
// مدى_يوتيف8_صالح في std.encoding.utf8 (مدى بايتات من نص هو UTF-8 سليم)،
// ونص_نقطة_يونيكود في std.unicode.code_point_text (الصيغة «U+XXXX»)، ورقم_ثماني
// في std.chars.ascii.
استورد std.encoding.utf8;
استورد std.unicode.code_point_text;
استورد std.chars.ascii;
استورد std.text.compare;
استورد std.text.from_bytes;

عرف كتابتها(القيمة: ط32, المتوقع: نص): منطقي {
    دع الفعلي: نص = نص_نقطة_يونيكود(القيمة);
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف الرئيسية(): عدد {
    // «a» (بايت واحد)، وU+00E9 (اثنان)، وU+20AC (ثلاثة)، وU+1F600 (أربعة): عشرة بايتات.
    دع المختلط: نص = من_بايتات(&[0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80]);
    إذا (!مدى_يوتيف8_صالح(&المختلط, 0, 10)) { أرجع 1; };
    إذا (!مدى_يوتيف8_صالح(&المختلط, 0, 0)) { أرجع 2; };
    إذا (!مدى_يوتيف8_صالح(&المختلط, 1, 3)) { أرجع 3; };
    إذا (مدى_يوتيف8_صالح(&المختلط, 1, 2)) { أرجع 4; };
    إذا (مدى_يوتيف8_صالح(&المختلط, 2, 3)) { أرجع 5; };
    إذا (!مدى_يوتيف8_صالح(&المختلط, 3, 6)) { أرجع 6; };
    إذا (مدى_يوتيف8_صالح(&المختلط, 6, 9)) { أرجع 7; };
    إذا (!مدى_يوتيف8_صالح(&المختلط, 6, 10)) { أرجع 8; };
    إذا (مدى_يوتيف8_صالح(&المختلط, 0, 11)) { أرجع 9; };
    إذا (مدى_يوتيف8_صالح(&المختلط, 5, 3)) { أرجع 10; };
    // «/» مطوّلة (C0 AF) وبديل مرمّز (ED A0 80).
    دع المكسور: نص = من_بايتات(&[0x61, 0xC0, 0xAF, 0x62, 0xED, 0xA0, 0x80]);
    إذا (!مدى_يوتيف8_صالح(&المكسور, 0, 1)) { أرجع 11; };
    إذا (مدى_يوتيف8_صالح(&المكسور, 0, 4)) { أرجع 12; };
    إذا (!مدى_يوتيف8_صالح(&المكسور, 3, 4)) { أرجع 13; };
    إذا (مدى_يوتيف8_صالح(&المكسور, 4, 7)) { أرجع 14; };

    إذا (!كتابتها(0x41, «U+0041»)) { أرجع 20; };
    إذا (!كتابتها(0, «U+0000»)) { أرجع 21; };
    إذا (!كتابتها(0xABC, «U+0ABC»)) { أرجع 22; };
    إذا (!كتابتها(0xFFFF, «U+FFFF»)) { أرجع 23; };
    إذا (!كتابتها(0x1F600, «U+1F600»)) { أرجع 24; };
    إذا (!كتابتها(0x10FFFF, «U+10FFFF»)) { أرجع 25; };
    إذا (!كتابتها(0x110000, «U+110000»)) { أرجع 26; };

    إذا (!رقم_ثماني(48) || !رقم_ثماني(55)) { أرجع 30; };
    إذا (رقم_ثماني(56) || رقم_ثماني(47)) { أرجع 31; };
    أرجع 42;
}
