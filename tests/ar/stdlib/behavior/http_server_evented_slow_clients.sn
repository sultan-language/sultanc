// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/http_server_evented_slow_clients.sn
// العملاء البطيئون والخادم الحدثي (std.http.server شغل_خادم_ويب_بأحداث، بعامل
// واحد) بمهل قصيرة: عميل يرسل نصف رأس طلب لا يؤخر طلبا عاديا، ويجيبه كنس
// العامل بـ408 ويغلقه بعد مهلة الرأس؛ والاتصال المستبقى الخامل يُغلق بصمت
// بعد مهلة الخمول؛ ومع أقصى_الاتصالات مفتوحة يُجاب اتصال إضافي بـ503 فورا،
// وبعد انقضاء مهل المفتوحة (وتحرير واصفاتها) يُجاب طلب من جديد. خيط عميل
// يفحص ذلك كله ثم يطلب الإيقاف. بلا توجيه زوج: المفسر يشغل خيطا واحدا.
استورد المكتبة.ويب.خادم;
استورد المكتبة.ويب.إيقاف;
استورد المكتبة.ويب.نموذج;
استورد المكتبة.ويب.جسم;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.خيارات;
استورد المكتبة.شبكة.تي_سي_بي;
استورد المكتبة.تزامن.مشترك;
استورد المكتبة.تزامن.ذري;
استورد المكتبة.خيوط.خيط;
استورد المكتبة.وقت.الوقت;
استورد المكتبة.نصوص.من_بايتات;

عرف عنوان_الخادم(): نص { أرجع «127.0.0.1:38577»; }

عرف الخدمة(الحالة: &عدد, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    ليكن الجسم: نص = «ok»;
    أرجع استجابة_نص_ويب(200, &الجسم);
}

// مهل قصيرة كي ينتهي الاختبار في ثوان قليلة.
عرف إعداد_الاختبار(): إعداد_خادم_ويب {
    ليكن العنوان: نص = عنوان_الخادم();
    ليكن الإعداد: متغير إعداد_خادم_ويب = إعداد_خادم_ويب_افتراضي(&العنوان);
    اضبط_مهلة_رأس_خادم_ويب(&متغير الإعداد, 1000);
    اضبط_مهلة_جسم_خادم_ويب(&متغير الإعداد, 1000);
    اضبط_مهلة_خمول_خادم_ويب(&متغير الإعداد, 300);
    اضبط_أقصى_اتصالات_خادم_ويب(&متغير الإعداد, 4);
    أرجع الإعداد;
}

عرف الآن_بالمللي(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ز) -> { أرجع ز / 1000000; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف انتظر_مللي(المللي: عدد): فراغ {
    ليكن تجاهل: نتيجة عدد, عدد = نم_نانو(المللي * 1000000);
}

عرف اتصل_محليا(): اختياري تدفق_تي_سي_بي {
    ليكن النص: نص = عنوان_الخادم();
    طابق حلل_عنوان_مقبس(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(العنوان) -> {
        طابق اتصل_تي_سي_بي(&العنوان) مع
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(التدفق) -> {
            ليكن تجاهل: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_استقبال(3000));
            أرجع اختياري.موجود(التدفق);
        };
    };
}

عرف أرسل_نصا(التدفق: &تدفق_تي_سي_بي, النص: نص): منطقي {
    ليكن البايتات: متجه ط8 = بايتات_من_نص(النص);
    ليكن الكل: عدد = الطول(البايتات) مثل عدد;
    ليكن المرسل: متغير عدد = 0;
    طالما (المرسل < الكل) {
        طابق اكتب_تي_سي_بي(التدفق, &البايتات, المرسل, الكل - المرسل) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(ن) -> {
            إذا (ن <= 0) { أرجع خطأ; };
            المرسل := المرسل + ن;
        };
    }
    أرجع صواب;
}

عرف يحتوي(الكومة: &متجه ط8, الإبرة: &متجه ط8): منطقي {
    ليكن الحجم: طبيعي = الطول(*الكومة) مثل طبيعي;
    ليكن ن: طبيعي = الطول(*الإبرة) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + ن <= الحجم) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < ن && (*الكومة)[ف + ك] == (*الإبرة)[ك]) { ك := ك + 1; }
        إذا (ك == ن) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// قراءة واحدة تُلحق بـ الوجهة: عدد البايتات، و0 حين أغلق النظير، و-1 عند
// خطأ أو انقضاء مهلة الاستقبال.
عرف اقرأ_بعضا(التدفق: &تدفق_تي_سي_بي, الوجهة: &متغير متجه ط8): عدد {
    ليكن المخزن: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4096) { ألحق(المخزن, 0); ف := ف + 1; }
    طابق اقرأ_تي_سي_بي(التدفق, &متغير المخزن, 0, 4096) مع
    | نتيجة.خطأ(_) -> { أرجع -1; }
    | نتيجة.نجح(ك) -> {
        ليكن م: متغير طبيعي = 0;
        طالما (م < (ك مثل طبيعي)) { ألحق(*الوجهة, المخزن[م]); م := م + 1; }
        أرجع ك;
    };
}

// يقرأ حتى يغلق النظير: صواب حين أغلق.
عرف اقرأ_حتى_الإغلاق(التدفق: &تدفق_تي_سي_بي, الوجهة: &متغير متجه ط8): منطقي {
    طالما (صواب) {
        ليكن المقروء: عدد = اقرأ_بعضا(التدفق, الوجهة);
        إذا (المقروء == 0) { أرجع صواب; };
        إذا (المقروء < 0) { أرجع خطأ; };
    }
    أرجع خطأ;
}

// يقرأ حتى تحوي البايتات الإبرة.
عرف اقرأ_حتى(التدفق: &تدفق_تي_سي_بي, الوجهة: &متغير متجه ط8, الإبرة: &متجه ط8): منطقي {
    طالما (!يحتوي(&(*الوجهة), الإبرة)) {
        إذا (اقرأ_بعضا(التدفق, الوجهة) <= 0) { أرجع يحتوي(&(*الوجهة), الإبرة); };
    }
    أرجع صواب;
}

عرف أغلق_التدفق(التدفق: تدفق_تي_سي_بي): فراغ {
    ليكن تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
}

// طلب مع "connection: close": صواب حين يُجاب بـ200.
عرف أجيب(): منطقي {
    طابق اتصل_محليا() مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(التدفق) -> {
        إذا (!أرسل_نصا(&التدفق, "GET / HTTP/1.1\r\nHost: local\r\nConnection: close\r\n\r\n")) {
            أغلق_التدفق(التدفق);
            أرجع خطأ;
        };
        ليكن الجواب: متغير متجه ط8 = [];
        ليكن مغلق: منطقي = اقرأ_حتى_الإغلاق(&التدفق, &متغير الجواب);
        أغلق_التدفق(التدفق);
        ليكن نجاح: متجه ط8 = بايتات_من_نص("HTTP/1.1 200");
        أرجع مغلق && يحتوي(&الجواب, &نجاح);
    };
}

عرف افحص(): عدد {
    انتظر_مللي(200);
    // عميل يرسل نصف رأس طلب ثم يسكت.
    ليكن المتعطل: تدفق_تي_سي_بي;
    طابق اتصل_محليا() مع
    | اختياري.لا_شيء -> { أرجع 1; }
    | اختياري.موجود(ت) -> { المتعطل := ت; };
    إذا (!أرسل_نصا(&المتعطل, "GET / HTTP/1.1\r\nHost: local\r\n")) { أرجع 2; };
    ليكن تعطل_عند: عدد = الآن_بالمللي();
    انتظر_مللي(50);
    // وفي الأثناء يُجاب طلب عادي فورا.
    ليكن البدء: عدد = الآن_بالمللي();
    إذا (!أجيب()) { أرجع 3; };
    إذا (الآن_بالمللي() - البدء > 500) { أرجع 4; };
    // يُجاب العميل المتعطل بـ408 ويُغلق بعد مهلة الرأس.
    ليكن المتأخر: متغير متجه ط8 = [];
    إذا (!اقرأ_حتى_الإغلاق(&المتعطل, &متغير المتأخر)) { أرجع 5; };
    ليكن الانتظار: عدد = الآن_بالمللي() - تعطل_عند;
    ليكن حالة_المهلة: متجه ط8 = بايتات_من_نص("HTTP/1.1 408");
    إذا (!يحتوي(&المتأخر, &حالة_المهلة)) { أرجع 6; };
    إذا (الانتظار < 700 || الانتظار > 2900) { أرجع 7; };
    أغلق_التدفق(المتعطل);
    // اتصال مستبقى خامل بعد استجابته يُغلق بصمت بعد مهلة الخمول.
    ليكن المستبقى: تدفق_تي_سي_بي;
    طابق اتصل_محليا() مع
    | اختياري.لا_شيء -> { أرجع 8; }
    | اختياري.موجود(ت) -> { المستبقى := ت; };
    إذا (!أرسل_نصا(&المستبقى, "GET / HTTP/1.1\r\nHost: local\r\n\r\n")) { أرجع 9; };
    ليكن الأول: متغير متجه ط8 = [];
    ليكن نهاية_الجسم: متجه ط8 = بايتات_من_نص("\r\n\r\nok");
    إذا (!اقرأ_حتى(&المستبقى, &متغير الأول, &نهاية_الجسم)) { أرجع 10; };
    ليكن خامل_من: عدد = الآن_بالمللي();
    ليكن الباقي: متغير متجه ط8 = [];
    إذا (!اقرأ_حتى_الإغلاق(&المستبقى, &متغير الباقي)) { أرجع 11; };
    ليكن الخمول: عدد = الآن_بالمللي() - خامل_من;
    إذا ((الطول(الباقي) مثل طبيعي) != 0) { أرجع 12; };
    إذا (الخمول < 150 || الخمول > 2500) { أرجع 13; };
    أغلق_التدفق(المستبقى);
    انتظر_مللي(100);
    // أربعة اتصالات صامتة تملأ الحد؛ والخامس يُجاب بـ503 فورا.
    ليكن المحتجزة: متغير متجه تدفق_تي_سي_بي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        طابق اتصل_محليا() مع
        | اختياري.لا_شيء -> { أرجع 14; }
        | اختياري.موجود(ت) -> { ألحق(المحتجزة, ت); };
        ف := ف + 1;
    }
    انتظر_مللي(100);
    ليكن رفض_عند: عدد = الآن_بالمللي();
    طابق اتصل_محليا() مع
    | اختياري.لا_شيء -> { أرجع 15; }
    | اختياري.موجود(المرفوض) -> {
        ليكن الرفض: متغير متجه ط8 = [];
        ليكن مغلق: منطقي = اقرأ_حتى_الإغلاق(&المرفوض, &متغير الرفض);
        أغلق_التدفق(المرفوض);
        ليكن حالة_الانشغال: متجه ط8 = بايتات_من_نص("HTTP/1.1 503");
        إذا (!يحتوي(&الرفض, &حالة_الانشغال)) { أرجع 16; };
        إذا (الآن_بالمللي() - رفض_عند > 800) { أرجع 17; };
    };
    // لم ترسل المحتجزة شيئا: يُغلق كل منها بصمت عند مهلة رأسه، ثم يُجاب
    // طلب من جديد.
    طالما ((الطول(المحتجزة) مثل طبيعي) > 0) {
        طابق أزل_الأخير(المحتجزة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(ت) -> {
            ليكن لا_شيء_وصل: متغير متجه ط8 = [];
            ليكن مغلق: منطقي = اقرأ_حتى_الإغلاق(&ت, &متغير لا_شيء_وصل);
            أغلق_التدفق(ت);
            إذا (!مغلق || (الطول(لا_شيء_وصل) مثل طبيعي) != 0) { أرجع 18; };
        };
    }
    انتظر_مللي(100);
    إذا (!أجيب()) { أرجع 19; };
    أرجع 0;
}

عرف افحص_ثم_أوقف(النتيجة: مشترك<ذرة_ط32>): فراغ {
    ليكن الرمز: عدد = افحص();
    اخزن_ط32(اقرأ_مشترك(&النتيجة), الرمز مثل ط32, ترتيب_ذاكرة.تسلسلي());
    اطلب_إيقاف_خوادم_الويب();
}

عرف الرئيسية(): عدد {
    ليكن النتيجة: مشترك<ذرة_ط32> = أنشئ_مشترك(أنشئ_ذرة_ط32(100 مثل ط32));
    ليكن للعميل: مشترك<ذرة_ط32> = استنسخ_مشترك(&النتيجة);
    طابق أطلق(دالة(): فراغ -> افحص_ثم_أوقف(للعميل)) مع
    | نتيجة.خطأ(_) -> { أرجع 90; }
    | نتيجة.نجح(_) -> { };
    ليكن الإعداد: إعداد_خادم_ويب = إعداد_الاختبار();
    ليكن المشتركة: مشترك<عدد> = أنشئ_مشترك(0);
    طابق شغل_خادم_ويب_بأحداث(&الإعداد, المشتركة, الخدمة, 1) مع
    | نتيجة.خطأ(_) -> { أرجع 91; }
    | نتيجة.نجح(_) -> { };
    أرجع احمل_ط32(اقرأ_مشترك(&النتيجة), ترتيب_ذاكرة.تسلسلي()) مثل عدد;
}
