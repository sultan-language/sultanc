// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.os.wait_address في خيط واحد: الانتظار على خلية لا تحمل القيمة المتوقعة
// يعود فورا؛ والانتظار بمهلة على خلية لم تتغير يبلّغ عن انتهاء المهلة بعد المهلة
// على الأقل؛ والإيقاظ بلا منتظر لا يضر؛ وصيغ الخلية المجردة تتصرف بالمثل. حين
// يُبنى لويندوز يعمل تحت Wine (WaitOnAddress). النظير:
// tests/en/stdlib/behavior/wait_address_single.sn. لا توجيه نظير: المفسر يرفض
// الانتظار على نسخه من الخلية.
استورد std.os.wait_address;
استورد std.os.clock;
استورد std.sync.atomic;

عرف الآن(): ص64 {
    طابق اقرأ_وقت_رتيب_النظام() مع
    | نتيجة.نجح(و) -> { أرجع و.النانوثواني; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف الرئيسية(): ص32 {
    دع الخلية: ذرة_ط32 = أنشئ_ذرة_ط32(5 مثل ط32);
    إذا (!هل_الانتظار_عند_العنوان_مدعوم()) { أرجع 0; };
    إذا (!انتظر_عند_العنوان(&الخلية, 4 مثل ط32, اختياري.لا_شيء())) { أرجع 1; };
    دع البداية: ص64 = الآن();
    إذا (انتظر_عند_العنوان(&الخلية, 5 مثل ط32, اختياري.موجود(30000000))) { أرجع 2; };
    إذا (الآن() - البداية < 25000000) { أرجع 3; };
    أيقظ_واحدا_عند_العنوان(&الخلية);
    أيقظ_الكل_عند_العنوان(&الخلية);
    دع الكلمة: ط32 = 9 مثل ط32;
    إذا (!انتظر_عند_الخلية(&الكلمة, 8 مثل ط32, اختياري.لا_شيء())) { أرجع 4; };
    إذا (انتظر_عند_الخلية(&الكلمة, 9 مثل ط32, اختياري.موجود(1000000))) { أرجع 5; };
    أيقظ_واحدا_عند_الخلية(&الكلمة);
    أرجع 0;
}
