// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/tcp_reuse_port.sn
// خيار SO_REUSEPORT (std.net.options): مستمعان يربطان العنوان نفسه حين يطلبانه
// كلاهما، كما يفعل كل عامل في الخادم الحدثي المجزأ (std.http.server)، ويُرفض
// الربط الثاني بدونه.
استورد std.net.options;
استورد std.net.socket_address;
استورد std.net.tcp;

عرف الرئيسية(): عدد {
    دع العنوان: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&«127.0.0.1:38917») مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(ع) -> { العنوان := ع; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_المنفذ(صواب));
    دع الأول: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &الخيارات) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(م) -> { الأول := م; };
    دع الثاني: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &الخيارات) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(م) -> { الثاني := م; };
    دع بلا: متجه خيار_مقبس = [];
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &بلا) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(م) -> { دع ت: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(م); أرجع 4; };
    دع أ: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(الأول);
    دع ب: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(الثاني);
    أرجع 0;
}
