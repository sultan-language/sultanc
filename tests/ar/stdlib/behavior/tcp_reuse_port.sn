// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/tcp_reuse_port.sn
// خيار SO_REUSEPORT (std.net.options): مستمعان يربطان العنوان نفسه حين يطلبانه
// كلاهما، كما يفعل كل عامل في الخادم الحدثي المجزأ (std.http.server)، ويُرفض
// الربط الثاني بدونه.
استورد المكتبة.شبكة.خيارات;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.شبكة.تي_سي_بي;

عرف الرئيسية(): عدد {
    ليكن العنوان: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&«127.0.0.1:38917») مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(ع) -> { العنوان := ع; };
    ليكن الخيارات: متغير متجه خيار_مقبس = [];
    ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_المنفذ(صواب));
    ليكن الأول: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &الخيارات) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(م) -> { الأول := م; };
    ليكن الثاني: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &الخيارات) مع
    | نتيجة.خطأ(_) -> { أرجع 3; }
    | نتيجة.نجح(م) -> { الثاني := م; };
    ليكن بلا: متجه خيار_مقبس = [];
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, 16, &بلا) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(م) -> { ليكن ت: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(م); أرجع 4; };
    ليكن أ: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(الأول);
    ليكن ب: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(الثاني);
    أرجع 0;
}
