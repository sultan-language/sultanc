// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/socket_names.sn
// std.net.socket_names: مقبس UDP غير متصل يرسل إلى عنوان ويستقبل منه،
// والعناوين المحلية والنظيرة لمقابس UDP وTCP مربوطة بالمنفذ 0.
استورد std.net.socket_address;
استورد std.net.socket_names;
استورد std.net.udp;
استورد std.net.tcp;
استورد std.net.options;
استورد std.text.compare;

عرف تبادل(أ: &مقبس_يو_دي_بي, ب: &مقبس_يو_دي_بي): عدد {
    طابق العنوان_المحلي_يو_دي_بي(أ) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(عنوان_أ) -> {
        لو (منفذ_عنوان_مقبس(&عنوان_أ) == 0) { أرجع 6; };
        طابق العنوان_المحلي_يو_دي_بي(ب) مع
        | نتيجة.خطأ(_) -> { أرجع 7; }
        | نتيجة.نجح(عنوان_ب) -> {
            دع الرسالة: متجه ط8 = [83, 117, 108];
            طابق أرسل_إلى_يو_دي_بي(أ, &الرسالة, 0, 3, &عنوان_ب) مع
            | نتيجة.خطأ(_) -> { أرجع 8; }
            | نتيجة.نجح(المرسل) -> { لو (المرسل != 3) { أرجع 9; }; };
            دع المخزن: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
            طابق استقبل_من_يو_دي_بي(ب, &متغير المخزن, 0, 8) مع
            | نتيجة.خطأ(_) -> { أرجع 10; }
            | نتيجة.نجح(الحزمة) -> {
                لو (الحزمة.العدد != 3 || المخزن[0] != 83 || المخزن[2] != 108) { أرجع 11; };
                دع المرسل_نصا: نص = نص_عنوان_مقبس(&الحزمة.المرسل);
                دع المتوقع: نص = نص_عنوان_مقبس(&عنوان_أ);
                لو (!نصان_متساويان(&المرسل_نصا, &المتوقع)) { أرجع 12; };
            };
        };
    };
    طابق عنوان_نظير_يو_دي_بي(ب) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(_) -> { أرجع 13; };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    دع الحلقة: نص = «127.0.0.1:0»;
    طابق حلل_عنوان_مقبس(&الحلقة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(العنوان) -> {
        طابق اربط_يو_دي_بي(&العنوان) مع
        | نتيجة.خطأ(_) -> { أرجع 2; }
        | نتيجة.نجح(أ) -> {
            طابق اربط_يو_دي_بي(&العنوان) مع
            | نتيجة.خطأ(_) -> { أرجع 3; }
            | نتيجة.نجح(ب) -> {
                طابق اضبط_خيار_يو_دي_بي(&ب, خيار_مقبس.مهلة_استقبال(2000)) مع
                | نتيجة.خطأ(_) -> { أرجع 4; }
                | نتيجة.نجح(_) -> {};
                دع الحالة: عدد = تبادل(&أ, &ب);
                لو (الحالة != 0) { أرجع الحالة; };
                دع إغلاق_ب: نتيجة عدد, عدد = أغلق_يو_دي_بي(ب);
            };
            دع إغلاق_أ: نتيجة عدد, عدد = أغلق_يو_دي_بي(أ);
        };
        طابق اربط_مستمع_تي_سي_بي(&العنوان, 16) مع
        | نتيجة.خطأ(_) -> { أرجع 14; }
        | نتيجة.نجح(المستمع) -> {
            طابق العنوان_المحلي_لمستمع_تي_سي_بي(&المستمع) مع
            | نتيجة.خطأ(_) -> { أرجع 15; }
            | نتيجة.نجح(المستمع_عليه) -> {
                طابق اتصل_تي_سي_بي(&المستمع_عليه) مع
                | نتيجة.خطأ(_) -> { أرجع 16; }
                | نتيجة.نجح(التدفق) -> {
                    طابق عنوان_نظير_تي_سي_بي(&التدفق) مع
                    | نتيجة.خطأ(_) -> { أرجع 17; }
                    | نتيجة.نجح(النظير) -> { لو (منفذ_عنوان_مقبس(&النظير) != منفذ_عنوان_مقبس(&المستمع_عليه)) { أرجع 18; }; };
                    طابق العنوان_المحلي_تي_سي_بي(&التدفق) مع
                    | نتيجة.خطأ(_) -> { أرجع 19; }
                    | نتيجة.نجح(المحلي) -> { لو (منفذ_عنوان_مقبس(&المحلي) == 0) { أرجع 20; }; };
                    دع إغلاق_التدفق: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
                };
            };
            دع إغلاق_المستمع: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        };
    };
    أرجع 42;
}
