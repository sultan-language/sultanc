// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/process_spawn.sn
// تيارات std.process.command (Command::spawn مع Stdio::piped في Rust):
// صدى تفاعلي سطرا بسطر عبر cat، و2 ميغابايت من الخرج تقرأ بينما يكتبها
// الطفل، و256 كيلوبايت من الدخل، وخرج وخطأ منفصلان مع انتظار الخرج،
// ورموز الخروج، والتفقد والقتل، وكتابة إلى طفل أغلق دخله تفشل بـ EPIPE
// بدل أن تنهي هذه العملية بـ SIGPIPE. المفسر يشغل الطفل كما يشغله
// الملف التنفيذي (clone ينسخ المفسر، والطفل ينفذ execve).
استورد std.process.command;
استورد std.process.child;
استورد std.text.from_bytes;
استورد std.text.compare;

// يقرأ من خرج الطفل حتى يصل سطر جديد.
عرف اقرأ_سطرا_من(الطفل: &متغير طفل_أمر): نتيجة نص, عدد {
    دع السطر: متغير متجه ط8 = [];
    دع المخزن: متغير متجه ط8 = [0];
    طالما (صواب) {
        طابق اقرأ_خرج_الطفل(الطفل, &متغير المخزن, 0, 1) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(1); }
        | نتيجة.نجح(0) -> { أرجع نتيجة.خطأ(2); }
        | نتيجة.نجح(_) -> {
            ألحق(السطر, المخزن[0]);
            لو (المخزن[0] == 10) { أرجع نتيجة.نجح(من_بايتات(&السطر)); };
        };
    }
    أرجع نتيجة.خطأ(3);
}

عرف الرئيسية(): عدد {
    // 1. صدى تفاعلي: اكتب سطرا واقرأه عائدا، ثلاث مرات.
    دع اسم_القط: نص = «cat»;
    دع الصدى: متغير أمر = أنشئ_أمرا(&اسم_القط);
    اضبط_دخل_الأمر(&متغير الصدى, مصدر_تيار.التقاط());
    اضبط_خرج_الأمر(&متغير الصدى, مصدر_تيار.التقاط());
    دع ط: متغير طفل_أمر;
    طابق ابدأ_الأمر(&الصدى) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(المبدوء) -> { ط := المبدوء; };
    لو (معرف_عملية_الطفل(&ط) <= 0) { أرجع 2; };
    دع الأسطر: متجه نص = ["first\n", "second line\n", "third\n"];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 3) {
        دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(&الأسطر[ف]));
        طابق اكتب_إلى_الطفل(&متغير ط, &البايتات) مع
        | نتيجة.خطأ(_) -> { أرجع 3; }
        | نتيجة.نجح(_) -> {};
        طابق اقرأ_سطرا_من(&متغير ط) مع
        | نتيجة.خطأ(_) -> { أرجع 4; }
        | نتيجة.نجح(المقروء) -> { لو (!نصان_متساويان(&المقروء, &الأسطر[ف])) { أرجع 5; }; };
        ف := ف + 1;
    }
    // إغلاق الدخل نهاية ملف cat: يخرج بصفر وينتهي خرجه.
    أغلق_دخل_الطفل(&متغير ط);
    دع الباقي: متغير متجه ط8 = [0, 0, 0, 0];
    طابق اقرأ_خرج_الطفل(&متغير ط, &متغير الباقي, 0, 4) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(ع) -> { لو (ع != 0) { أرجع 7; }; };
    طابق انتظر_الطفل(&متغير ط) مع
    | نتيجة.خطأ(_) -> { أرجع 8; }
    | نتيجة.نجح(الحالة) -> { لو (!هل_نجح_الأمر(&الحالة)) { أرجع 9; }; };
    أغلق_تيارات_الطفل(&متغير ط);

    // 2. مليونا بايت من الخرج تقرأ بينما يكتبها الطفل.
    دع الصدفة: نص = «sh»;
    دع الكبير: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع نص_الكبير: متجه نص = [«-c», «dd if=/dev/zero bs=1000 count=2000 2>/dev/null»];
    أضف_وسائط_للأمر(&متغير الكبير, &نص_الكبير);
    اضبط_خرج_الأمر(&متغير الكبير, مصدر_تيار.التقاط());
    دع ك: متغير طفل_أمر;
    طابق ابدأ_الأمر(&الكبير) مع
    | نتيجة.خطأ(_) -> { أرجع 10; }
    | نتيجة.نجح(المبدوء) -> { ك := المبدوء; };
    دع القطعة: متغير متجه ط8 = [];
    دع ح: متغير طبيعي = 0;
    طالما (ح < 65536) { ألحق(القطعة, 0); ح := ح + 1; }
    دع المجموع: متغير عدد = 0;
    دع يقرأ: متغير منطقي = صواب;
    طالما (يقرأ) {
        طابق اقرأ_خرج_الطفل(&متغير ك, &متغير القطعة, 0, 65536) مع
        | نتيجة.خطأ(_) -> { أرجع 11; }
        | نتيجة.نجح(0) -> { يقرأ := خطأ; }
        | نتيجة.نجح(ع) -> { المجموع := المجموع + ع; };
    }
    لو (المجموع != 2000000) { أرجع 12; };
    طابق انتظر_الطفل(&متغير ك) مع
    | نتيجة.خطأ(_) -> { أرجع 13; }
    | نتيجة.نجح(الحالة) -> { لو (!هل_نجح_الأمر(&الحالة)) { أرجع 14; }; };
    أغلق_تيارات_الطفل(&متغير ك);

    // 3. 256 كيلوبايت من الدخل (أربعة أضعاف مخزن القناة) إلى wc -c.
    دع العاد: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع نص_العاد: متجه نص = [«-c», «wc -c | tr -d ' '»];
    أضف_وسائط_للأمر(&متغير العاد, &نص_العاد);
    اضبط_دخل_الأمر(&متغير العاد, مصدر_تيار.التقاط());
    اضبط_خرج_الأمر(&متغير العاد, مصدر_تيار.التقاط());
    دع ع_ط: متغير طفل_أمر;
    طابق ابدأ_الأمر(&العاد) مع
    | نتيجة.خطأ(_) -> { أرجع 15; }
    | نتيجة.نجح(المبدوء) -> { ع_ط := المبدوء; };
    دع الكتلة: متغير متجه ط8 = [];
    ح := 0;
    طالما (ح < 4096) { ألحق(الكتلة, 120); ح := ح + 1; }
    ح := 0;
    طالما (ح < 64) {
        طابق اكتب_إلى_الطفل(&متغير ع_ط, &الكتلة) مع
        | نتيجة.خطأ(_) -> { أرجع 16; }
        | نتيجة.نجح(_) -> {};
        ح := ح + 1;
    }
    طابق انتظر_خرج_الطفل(ع_ط) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(الناتج) -> {
        دع المعدود: نص = من_بايتات(&الناتج.الخرج);
        دع المتوقع: نص = "262144\n";
        لو (!نصان_متساويان(&المعدود, &المتوقع)) { أرجع 18; };
    };

    // 4. الخرج والخطأ منفصلان، ورمز الخروج.
    دع كلاهما: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع نص_كليهما: متجه نص = [«-c», «echo out; echo err >&2; echo more; exit 7»];
    أضف_وسائط_للأمر(&متغير كلاهما, &نص_كليهما);
    اضبط_خرج_الأمر(&متغير كلاهما, مصدر_تيار.التقاط());
    اضبط_خطأ_الأمر(&متغير كلاهما, مصدر_تيار.التقاط());
    طابق ابدأ_الأمر(&كلاهما) مع
    | نتيجة.خطأ(_) -> { أرجع 19; }
    | نتيجة.نجح(المبدوء) -> {
        طابق انتظر_خرج_الطفل(المبدوء) مع
        | نتيجة.خطأ(_) -> { أرجع 20; }
        | نتيجة.نجح(الناتج) -> {
            دع الخرج: نص = من_بايتات(&الناتج.الخرج);
            دع الخطأ_المقروء: نص = من_بايتات(&الناتج.الخطأ);
            دع الخرج_المتوقع: نص = "out\nmore\n";
            دع الخطأ_المتوقع: نص = "err\n";
            لو (!نصان_متساويان(&الخرج, &الخرج_المتوقع)) { أرجع 21; };
            لو (!نصان_متساويان(&الخطأ_المقروء, &الخطأ_المتوقع)) { أرجع 22; };
            طابق الناتج.الحالة مع
            | حالة_إنهاء.خرج(7) -> {}
            | _ -> { أرجع 23; };
        };
    };

    // 5. التفقد أثناء التشغيل، ثم القتل، ثم الانتظار يبلغ عن SIGKILL.
    دع اسم_النائم: نص = «sleep»;
    دع النائم: متغير أمر = أنشئ_أمرا(&اسم_النائم);
    دع خمس: نص = «5»;
    أضف_وسيطة_للأمر(&متغير النائم, &خمس);
    دع ن: متغير طفل_أمر;
    طابق ابدأ_الأمر(&النائم) مع
    | نتيجة.خطأ(_) -> { أرجع 24; }
    | نتيجة.نجح(المبدوء) -> { ن := المبدوء; };
    طابق تفقد_الطفل(&متغير ن) مع
    | نتيجة.خطأ(_) -> { أرجع 25; }
    | نتيجة.نجح(اختياري.موجود(_)) -> { أرجع 26; }
    | نتيجة.نجح(اختياري.لا_شيء) -> {};
    طابق اقتل_الطفل(&متغير ن) مع
    | نتيجة.خطأ(_) -> { أرجع 27; }
    | نتيجة.نجح(_) -> {};
    طابق انتظر_الطفل(&متغير ن) مع
    | نتيجة.خطأ(_) -> { أرجع 28; }
    | نتيجة.نجح(حالة_إنهاء.إشارة(9)) -> {}
    | نتيجة.نجح(_) -> { أرجع 29; };
    // انتظار ثان يبلغ عن الحالة نفسها.
    طابق انتظر_الطفل(&متغير ن) مع
    | نتيجة.نجح(حالة_إنهاء.إشارة(9)) -> {}
    | _ -> { أرجع 30; };

    // 6. الكتابة إلى طفل أغلق دخله EPIPE، لا SIGPIPE.
    دع المغادر: متغير أمر = أنشئ_أمرا(&الصدفة);
    دع نص_المغادر: متجه نص = [«-c», «exec 0<&-; exit 0»];
    أضف_وسائط_للأمر(&متغير المغادر, &نص_المغادر);
    اضبط_دخل_الأمر(&متغير المغادر, مصدر_تيار.التقاط());
    دع م: متغير طفل_أمر;
    طابق ابدأ_الأمر(&المغادر) مع
    | نتيجة.خطأ(_) -> { أرجع 31; }
    | نتيجة.نجح(المبدوء) -> { م := المبدوء; };
    طابق خذ_دخل_الطفل(&متغير م) مع
    | اختياري.لا_شيء -> { أرجع 32; }
    | اختياري.موجود(الدخل) -> {
        // ليخرج أولا: عندها لا يبقى قارئ على القناة.
        طابق انتظر_الطفل(&متغير م) مع
        | نتيجة.خطأ(_) -> { أرجع 33; }
        | نتيجة.نجح(_) -> {};
        دع البيانات: متجه ط8 = [1, 2, 3];
        طابق اكتب_دخل_طفل(&الدخل, &البيانات, 0, 3) مع
        | نتيجة.خطأ(الرمز) -> { لو (الرمز != -32) { أرجع 34; }; }
        | نتيجة.نجح(_) -> { أرجع 35; };
        طابق أغلق_دخل_طفل(الدخل) مع
        | نتيجة.خطأ(_) -> { أرجع 36; }
        | نتيجة.نجح(_) -> {};
    };
    أرجع 42;
}
