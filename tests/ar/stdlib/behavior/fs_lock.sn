// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/fs_lock.sn
// std.fs.lock بين عمليتين (File::lock وlock_shared وtry_lock وtry_lock_shared
// وunlock في Rust؛ flock على يونكس). يشغل البرنامج نسخة ثانية من نفسه عبر
// std.process.command وstd.env.executable (env::current_exe في Rust):
// التنفيذي يشغل نفسه؛ وفي المفسر argv[0] هو هذا المصدر والتنفيذي الحالي هو
// المفسر، فالنسخة هي المفسر يشغله مرة أخرى (`interpret <المصدر> -- ...`) على
// كل مضيف. تفتح النسخة الملف نفسه وتبلغ بحالة خروجها (10: ستحظر، 11: قفلت)
// أو بخرجها للقفل المنتظر.
استورد std.fs.lock;
استورد std.fs.handle;
استورد std.fs.temporary;
استورد std.fs.mutation;
استورد std.env.executable;
استورد std.process.command;
استورد std.process.child;
استورد std.process.arguments;
استورد std.text.search;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.io.print;
استورد std.time.time;

// العملية الثانية: الوسائط [النفس، «child»، النمط، المسار].
عرف شغل_النسخة(النمط: &نص, المسار: &نص): عدد {
    دع المقبض: مقبض_ملف;
    طابق افتح_مقبض_ملف_للقراءة(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 20; }
    | نتيجة.نجح(المفتوح) -> { المقبض := المفتوح; };
    دع حصري: نص = «try-exclusive»;
    دع مشترك: نص = «try-shared»;
    لو (نصان_متساويان(النمط, &حصري) || نصان_متساويان(النمط, &مشترك)) {
        دع المحاولة: متغير نتيجة عدد, خطأ_محاولة_قفل = نتيجة.نجح(0);
        لو (نصان_متساويان(النمط, &حصري)) { المحاولة := حاول_قفل_الملف(&المقبض); }
        وإلا { المحاولة := حاول_قفل_الملف_مشتركا(&المقبض); };
        طابق المحاولة مع
        | نتيجة.خطأ(خطأ_محاولة_قفل.ستحظر) -> { أرجع 10; }
        | نتيجة.خطأ(_) -> { أرجع 21; }
        | نتيجة.نجح(_) -> { أرجع 11; };
    };
    // «wait-exclusive»: يعلن ذلك، وينتظر حتى يفك الأب القفل، ثم يعلن.
    دع البدء: نص = "waiting\n";
    اطبع(البدء);
    طابق اقفل_الملف(&المقبض) مع
    | نتيجة.خطأ(_) -> { أرجع 22; }
    | نتيجة.نجح(_) -> {};
    دع المقفل: نص = "locked\n";
    اطبع(المقفل);
    طابق افتح_قفل_الملف(&المقبض) مع
    | نتيجة.خطأ(_) -> { أرجع 23; }
    | نتيجة.نجح(_) -> {};
    أرجع 0;
}

// أمر يشغل هذا البرنامج مرة أخرى بالوسائط المعطاة.
عرف أمر_النسخة(النمط: &نص, المسار: &نص): أمر {
    دع الوسائط_كلها: متجه نص = الوسائط();
    دع النفس: نص = انسخ_نص(&الوسائط_كلها[0]);
    دع اللاحقة: نص = «.sn»;
    دع البرنامج: متغير نص = انسخ_نص(&النفس);
    طابق مسار_البرنامج_الحالي() مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(المسار_الحالي) -> { البرنامج := المسار_الحالي; };
    دع الأمر: متغير أمر = أنشئ_أمرا(&البرنامج);
    لو (ينتهي_بـ(&النفس, &اللاحقة)) {
        دع فسر: نص = «interpret»;
        دع الفاصل: نص = «--»;
        أضف_وسيطة_للأمر(&متغير الأمر, &فسر);
        أضف_وسيطة_للأمر(&متغير الأمر, &النفس);
        أضف_وسيطة_للأمر(&متغير الأمر, &الفاصل);
    };
    دع كلمة_النسخة: نص = «child»;
    أضف_وسيطة_للأمر(&متغير الأمر, &كلمة_النسخة);
    أضف_وسيطة_للأمر(&متغير الأمر, النمط);
    أضف_وسيطة_للأمر(&متغير الأمر, المسار);
    أرجع الأمر;
}

عرف حالة_النسخة(النمط: &نص, المسار: &نص): عدد {
    دع الأمر: أمر = أمر_النسخة(النمط, المسار);
    طابق شغل_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع -1; }
    | نتيجة.نجح(حالة_إنهاء.خرج(الرمز)) -> { أرجع الرمز; }
    | نتيجة.نجح(_) -> { أرجع -2; };
}

// يقرأ خرج النسخة حتى سطر جديد.
عرف اقرأ_سطرا_من(الطفل: &متغير طفل_أمر): نص {
    دع السطر: متغير متجه ط8 = [];
    دع المخزن: متغير متجه ط8 = [0];
    طالما (صواب) {
        طابق اقرأ_خرج_الطفل(الطفل, &متغير المخزن, 0, 1) مع
        | نتيجة.خطأ(_) -> { أرجع من_بايتات(&السطر); }
        | نتيجة.نجح(0) -> { أرجع من_بايتات(&السطر); }
        | نتيجة.نجح(_) -> {
            ألحق(السطر, المخزن[0]);
            لو (المخزن[0] == 10) { أرجع من_بايتات(&السطر); };
        };
    }
    أرجع من_بايتات(&السطر);
}

عرف الرئيسية(): عدد {
    دع الوسائط_كلها: متجه نص = الوسائط();
    دع كلمة_النسخة: نص = «child»;
    لو ((الطول(الوسائط_كلها) مثل طبيعي) == 4 && نصان_متساويان(&الوسائط_كلها[1], &كلمة_النسخة)) {
        أرجع شغل_النسخة(&الوسائط_كلها[2], &الوسائط_كلها[3]);
    };
    دع البادئة: نص = «sultanc-lock-»;
    دع المسار: نص;
    دع مقبضي: مقبض_ملف;
    طابق أنشئ_ملفا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح({ المسار: مسار_مصنوع, المقبض: مقبض_مصنوع }) -> { المسار := مسار_مصنوع; مقبضي := مقبض_مصنوع; };
    دع محاولة_حصري: نص = «try-exclusive»;
    دع محاولة_مشترك: نص = «try-shared»;
    دع انتظار_حصري: نص = «wait-exclusive»;

    // قفل حصري هنا: لا تأخذ النسخة أيا من النوعين.
    طابق اقفل_الملف(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> {};
    لو (حالة_النسخة(&محاولة_حصري, &المسار) != 10) { أرجع 3; };
    لو (حالة_النسخة(&محاولة_مشترك, &المسار) != 10) { أرجع 4; };

    // قفل مشترك هنا: تشاركه النسخة ولا تنفرد به.
    طابق افتح_قفل_الملف(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(_) -> {};
    طابق اقفل_الملف_مشتركا(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(_) -> {};
    لو (حالة_النسخة(&محاولة_مشترك, &المسار) != 11) { أرجع 7; };
    لو (حالة_النسخة(&محاولة_حصري, &المسار) != 10) { أرجع 8; };

    // بلا قفل: تأخذ النسخة القفل الحصري.
    طابق افتح_قفل_الملف(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(_) -> {};
    لو (حالة_النسخة(&محاولة_حصري, &المسار) != 11) { أرجع 10; };

    // القفل المنتظر ينتظر حتى تفلته هذه العملية.
    طابق حاول_قفل_الملف(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 11; }
    | نتيجة.نجح(_) -> {};
    دع أمر_المنتظر: متغير أمر = أمر_النسخة(&انتظار_حصري, &المسار);
    اضبط_خرج_الأمر(&متغير أمر_المنتظر, مصدر_تيار.التقاط());
    دع المنتظر: متغير طفل_أمر;
    طابق ابدأ_الأمر(&أمر_المنتظر) مع
    | نتيجة.خطأ(_) -> { أرجع 12; }
    | نتيجة.نجح(المبدوء) -> { المنتظر := المبدوء; };
    دع الأول: نص = اقرأ_سطرا_من(&متغير المنتظر);
    دع الأول_المتوقع: نص = "waiting\n";
    لو (!نصان_متساويان(&الأول, &الأول_المتوقع)) { أرجع 13; };
    طابق نم_نانو(300000000) مع
    | نتيجة.خطأ(_) -> { أرجع 14; }
    | نتيجة.نجح(_) -> {};
    طابق تفقد_الطفل(&متغير المنتظر) مع
    | نتيجة.خطأ(_) -> { أرجع 15; }
    | نتيجة.نجح(اختياري.موجود(_)) -> { أرجع 16; }
    | نتيجة.نجح(اختياري.لا_شيء) -> {};
    طابق افتح_قفل_الملف(&مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 17; }
    | نتيجة.نجح(_) -> {};
    دع الثاني: نص = اقرأ_سطرا_من(&متغير المنتظر);
    دع الثاني_المتوقع: نص = "locked\n";
    لو (!نصان_متساويان(&الثاني, &الثاني_المتوقع)) { أرجع 18; };
    طابق انتظر_الطفل(&متغير المنتظر) مع
    | نتيجة.خطأ(_) -> { أرجع 19; }
    | نتيجة.نجح(الحالة) -> { لو (!هل_نجح_الأمر(&الحالة)) { أرجع 20; }; };

    طابق أغلق_مقبض_ملف(مقبضي) مع
    | نتيجة.خطأ(_) -> { أرجع 21; }
    | نتيجة.نجح(_) -> {};
    طابق أزل_ملفا(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 22; }
    | نتيجة.نجح(_) -> {};
    أرجع 42;
}
