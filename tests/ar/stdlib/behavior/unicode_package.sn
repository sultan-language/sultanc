// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/behavior/unicode_package.sn
// الحزمة std.unicode مستوردة كاملة (استيراد انتقائي من المجلد) ووحدتها
// std.unicode.unicode: اسم واحد من كل وحدة: scalar وgeneral_category
// وproperties وcase_mapping وcase_folding وnormalization وgrapheme
// وword_boundary وsentence_boundary وversion وcode_point_text.
من المكتبة.unicode استورد
    قيمة_يونيكود_قياسية_صالحة, فئة_محرف_يونيكود, فئة_يونيكود, محرف_أبجدي_يونيكود,
    إلى_حروف_كبيرة_يونيكود, طي_حالة_الأحرف_يونيكود, طبع_نص_يونيكود, صورة_تطبيع_يونيكود,
    حدود_عناقيد_يونيكود, حدود_كلمات_يونيكود, حدود_جمل_يونيكود,
    إصدار_بيانات_يونيكود, نص_نقطة_يونيكود;
استورد المكتبة.unicode.unicode;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;

عرف طبيعيات_متساوية(الفعلي: &متجه طبيعي, المتوقع: &متجه طبيعي): منطقي {
    إذا (الطول(*الفعلي) != الطول(*المتوقع)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الفعلي) مثل طبيعي)) {
        إذا ((*الفعلي)[ف] != (*المتوقع)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف الرئيسية(): عدد {
    // scalar
    إذا (قيمة_يونيكود_قياسية_صالحة(0xD800) || !قيمة_يونيكود_قياسية_صالحة(0x41)) { أرجع 1; };
    // general_category
    طابق فئة_محرف_يونيكود(0x41) مع
    | فئة_يونيكود.حرف_كبير -> { }
    | _ -> { أرجع 2; };
    // properties: الحرف العربي باء
    إذا (!محرف_أبجدي_يونيكود(0x0628)) { أرجع 3; };
    // case_mapping وcase_folding
    دع الكبير: متجه ط32 = إلى_حروف_كبيرة_يونيكود(0x61);
    إذا (الطول(الكبير) != 1 || الكبير[0] != 0x41) { أرجع 4; };
    دع المطوي: متجه ط32 = طي_حالة_الأحرف_يونيكود(0x41);
    إذا (الطول(المطوي) != 1 || المطوي[0] != 0x61) { أرجع 5; };
    // normalization: «e» وU+0301 يتركبان إلى U+00E9 في NFC.
    دع المفكك: نص = من_بايتات(&[0x65, 0xCC, 0x81]);
    دع المركب: نص = من_بايتات(&[0xC3, 0xA9]);
    طابق طبع_نص_يونيكود(&المفكك, صورة_تطبيع_يونيكود.إن_إف_سي()) مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(ن) -> { إذا (!نصان_متساويان(&ن, &المركب)) { أرجع 7; }; };
    // grapheme: «a» وU+0301 عنقود واحد، ثم «b».
    دع العلامات: متجه ط32 = [0x61, 0x301, 0x62];
    دع العناقيد: متجه طبيعي = حدود_عناقيد_يونيكود(&العلامات);
    دع حدود_العناقيد: متجه طبيعي = [0, 2, 3];
    إذا (!طبيعيات_متساوية(&العناقيد, &حدود_العناقيد)) { أرجع 8; };
    // word_boundary: «ab cd»
    دع الكلمات_المدخلة: متجه ط32 = [0x61, 0x62, 0x20, 0x63, 0x64];
    دع الكلمات: متجه طبيعي = حدود_كلمات_يونيكود(&الكلمات_المدخلة);
    دع حدود_الكلمات: متجه طبيعي = [0, 2, 3, 5];
    إذا (!طبيعيات_متساوية(&الكلمات, &حدود_الكلمات)) { أرجع 9; };
    // sentence_boundary: «ab» جملة واحدة.
    دع الجملة_المدخلة: متجه ط32 = [0x61, 0x62];
    دع الجمل: متجه طبيعي = حدود_جمل_يونيكود(&الجملة_المدخلة);
    دع حدود_الجمل: متجه طبيعي = [0, 2];
    إذا (!طبيعيات_متساوية(&الجمل, &حدود_الجمل)) { أرجع 10; };
    // version
    دع الإصدار: نص = إصدار_بيانات_يونيكود();
    إذا (الطول(الإصدار) == 0) { أرجع 11; };
    // code_point_text
    دع المكتوب: نص = نص_نقطة_يونيكود(0x0628);
    دع المتوقع: نص = «U+0628»;
    إذا (!نصان_متساويان(&المكتوب, &المتوقع)) { أرجع 12; };
    أرجع 42;
}
