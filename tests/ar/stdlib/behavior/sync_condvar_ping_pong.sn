// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// std.sync.condvar: خيطان يتناوبان 1 000 مرة. عداد مشترك خلف قفل يقول من صاحب
// الدور (الزوجي: الأول، الفردي: الثاني)؛ ينتظر كل طرف على شرط الانتظار طالما
// ليس دوره (انتظر_طالما)، ثم يزيد العداد وينبه الآخر. ويبلّغ الانتظار بمهلة
// عن انتهاء المهلة حين لا ينبهه أحد. النظير:
// tests/en/stdlib/behavior/sync_condvar_ping_pong.sn. لا توجيه نظير: المفسر
// يشغل خيطا واحدا.
استورد std.sync.arc;
استورد std.sync.mutex;
استورد std.sync.condvar;
استورد std.thread.thread;
استورد std.time.duration;

نوع طاولة = { الدور: قفل<ص64>, تغير: شرط_انتظار };

عرف ليس_دوري(الزوجية: ص64, ق: &ص64): منطقي { أرجع (*ق % 2) != الزوجية; }

عرف خذ_الدور(ط: &مشترك<طاولة>, الزوجية: ص64, ق: &متغير ص64): فراغ {
    دع المشتركة: &طاولة = اقرأ_مشترك(ط);
    انتظر_طالما(&(*المشتركة).تغير, &(*المشتركة).الدور, دالة(ع: &ص64): منطقي -> ليس_دوري(الزوجية, ع));
    *ق := *ق + 1;
    نبه_الكل(&(*المشتركة).تغير);
}

عرف لاعب(ط: مشترك<طاولة>, الزوجية: ص64): فراغ {
    دع ف: متغير ص64 = 0;
    طالما (ف < 1000) {
        دع المشتركة: &طاولة = اقرأ_مشترك(&ط);
        نفذ_مع_القفل(&(*المشتركة).الدور, دالة(ق: &متغير ص64): فراغ -> خذ_الدور(&ط, الزوجية, ق));
        ف := ف + 1;
    }
}

عرف ابدأ(ط: &مشترك<طاولة>, الزوجية: ص64): اختياري مقبض_خيط {
    دع نسختي: مشترك<طاولة> = استنسخ_مشترك(ط);
    طابق أطلق(دالة(): فراغ -> لاعب(نسختي, الزوجية)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف اقرأ(ق: &متغير ص64): ص64 { أرجع *ق; }

عرف انتهت_المهلة(ط: &مشترك<طاولة>, ق: &متغير ص64): منطقي {
    دع المشتركة: &طاولة = اقرأ_مشترك(ط);
    طابق مدة_من_مليثواني(20) مع
    | اختياري.موجود(م) -> { أرجع انتظر_الشرط_بمهلة(&(*المشتركة).تغير, &(*المشتركة).الدور, م); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف الرئيسية(): ص32 {
    دع القيمة: طاولة = { الدور: أنشئ_قفل(0 مثل ص64), تغير: أنشئ_شرط_انتظار() };
    دع ط: مشترك<طاولة> = أنشئ_مشترك(القيمة);
    دع الأول: متغير مقبض_خيط;
    دع الثاني: متغير مقبض_خيط;
    طابق ابدأ(&ط, 0 مثل ص64) مع | اختياري.موجود(م) -> { الأول := م; } | اختياري.لا_شيء -> { أرجع 1; };
    طابق ابدأ(&ط, 1 مثل ص64) مع | اختياري.موجود(م) -> { الثاني := م; } | اختياري.لا_شيء -> { أرجع 2; };
    انضم(&متغير الأول);
    انضم(&متغير الثاني);
    دع المشتركة: &طاولة = اقرأ_مشترك(&ط);
    إذا (نفذ_مع_القفل(&(*المشتركة).الدور, دالة(ق: &متغير ص64): ص64 -> اقرأ(ق)) != (2000 مثل ص64)) { أرجع 3; };
    // لا أحد ينبه الآن: يعود الانتظار بمهلة بعد مهلته.
    إذا (!نفذ_مع_القفل(&(*المشتركة).الدور, دالة(ق: &متغير ص64): منطقي -> انتهت_المهلة(&ط, ق))) { أرجع 4; };
    أرجع 0;
}
