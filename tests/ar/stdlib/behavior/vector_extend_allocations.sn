// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/stdlib/behavior/vector_extend_allocations.sn
// #40، و`GET /large` في Nahr: تبني كرر_النص جسمًا من 64 KiB بإلحاق وحدة من
// 16 بايتًا 4096 مرة بـ ألحق_من. وتتحقق عدادات التخصيص في المكتبة القياسية
// (للعملية كلها؛ ويجيب عنها المفسر الآلي تحت `run`) من أن المخزن ينمو بالقاعدة
// المُطفأة (سعة_نمو_المتجه في compiler/runtime/vector_memory_policy.sn)، لا إلى
// الطول + العدد بالضبط.
//
// المتوقع لكل جسم:
//   - المد الأول في مخزن البايتات الفارغ: max(16, 2 × 0, 8) = 16 بايتًا، تخصيص
//     واحد؛
//   - ثم تتضاعف السعة: 32 و64 و… و65536 بايتًا، 12 إعادة تخصيص تطلب 131040
//     بايتًا؛
//   - ثم تنسخ من_بايتات البايتات الـ 65536 إلى النص: تخصيص واحد.
//   فذلك تخصيصان و12 إعادة تخصيص و196592 بايتًا مطلوبًا (المقيس: 12 إعادة تخصيص
//   و196600 بايت لكل جسم، في الملف التنفيذي وتحت `run`). وتترك الحدود أدناه
//   متسعًا لتخصيصات صغيرة قليلة.
// وحين كان ألحق_من ينمو إلى الطول + العدد بالضبط، كلّف الجسم نفسه 4095 إعادة
// تخصيص و134316040 بايتًا مطلوبًا.
استورد std.os.allocation;
استورد std.text.transform;
استورد std.io.print;
استورد std.io.println;

عرف افحص(الوصف: نص, صحيح: منطقي): عدد {
    اطبع(الوصف);
    إذا (صحيح) { اطبع_سطر(": yes"); أرجع 0; };
    اطبع_سطر(": no");
    أرجع 1;
}

عرف الرئيسية(): عدد {
    دع الوحدة: نص = «0123456789abcdef»;
    دع ت0: ط64 = عدد_تخصيصات_النظام();
    دع ر0: ط64 = عدد_إعادات_تخصيص_النظام();
    دع ب0: ط64 = بايتات_مطلوبة_النظام();
    دع الجسم: نص = كرر_النص(&الوحدة, 4096);
    دع التخصيصات: ط64 = عدد_تخصيصات_النظام() - ت0;
    دع الإعادات: ط64 = عدد_إعادات_تخصيص_النظام() - ر0;
    دع البايتات: ط64 = بايتات_مطلوبة_النظام() - ب0;
    دع الفاشلة: متغير عدد = 0;
    الفاشلة := الفاشلة + افحص(«the body is 64 KiB», الطول(الجسم) == 65536);
    الفاشلة := الفاشلة + افحص(«at most 4 allocations», التخصيصات <= 4);
    الفاشلة := الفاشلة + افحص(«at most 12 reallocations», الإعادات <= 12);
    الفاشلة := الفاشلة + افحص(«at most 200000 requested bytes», البايتات <= 200000);
    أرجع الفاشلة;
}
