// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_language.sn
// std.error converters (docs/ERRORS.md): every variant of every pilot enum
// gives an Arabic message with an English language version; an Arabic
// locale, or one without a version, gets the Arabic message.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_os;
استورد المكتبة.أخطاء.from_number;
استورد المكتبة.أخطاء.from_json;
استورد المكتبة.أخطاء.from_net;
استورد المكتبة.ملفات.error;
استورد المكتبة.نصوص.number;
استورد المكتبة.json.value;
استورد المكتبة.شبكة.ip;
استورد المكتبة.شبكة.socket_address;
استورد المكتبة.نصوص.language;
استورد المكتبة.نصوص.compare;

// An English version that differs from the Arabic message, which Arabic and
// French locales still get.
عرف بنسختين(الفشل: &فشل): منطقي {
    دع العربية: نص = رسالة_فشل(الفشل);
    دع وسم_إنجليزي: نص = «en-US»;
    دع الإنجليزية: لغة = لغة_من_وسم(&وسم_إنجليزي);
    دع بالإنجليزية: نص = نص_فشل_بلغة(الفشل, &الإنجليزية);
    لو ((الطول(بالإنجليزية) مثل طبيعي) == 0 || نصان_متساويان(&بالإنجليزية, &العربية)) { أرجع خطأ; };
    دع وسم_عربي: نص = «ar»;
    دع عربية: لغة = لغة_من_وسم(&وسم_عربي);
    دع بالعربية: نص = نص_فشل_بلغة(الفشل, &عربية);
    دع وسم_فرنسي: نص = «fr»;
    دع فرنسية: لغة = لغة_من_وسم(&وسم_فرنسي);
    دع بالفرنسية: نص = نص_فشل_بلغة(الفشل, &فرنسية);
    أرجع نصان_متساويان(&بالعربية, &العربية) && نصان_متساويان(&بالفرنسية, &العربية);
}

عرف نصه_بالإنجليزية(الفشل: &فشل, المتوقع: نص): منطقي {
    دع الوسم: نص = «en»;
    دع اللغة: لغة = لغة_من_وسم(&الوسم);
    دع الفعلي: نص = نص_فشل_بلغة(الفشل, &اللغة);
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف الرئيسية(): عدد {
    // std.fs, std.io, std.process: the 11 classes, and numeric statuses.
    دع الفئات: متغير متجه فئة_خطأ_نظام = [];
    ألحق(الفئات, فئة_خطأ_نظام.لا_خطأ());
    ألحق(الفئات, فئة_خطأ_نظام.غير_موجود());
    ألحق(الفئات, فئة_خطأ_نظام.مرفوض_الإذن());
    ألحق(الفئات, فئة_خطأ_نظام.موجود_مسبقا());
    ألحق(الفئات, فئة_خطأ_نظام.إدخال_غير_صالح());
    ألحق(الفئات, فئة_خطأ_نظام.غير_مدعوم());
    ألحق(الفئات, فئة_خطأ_نظام.هو_دليل());
    ألحق(الفئات, فئة_خطأ_نظام.ليس_دليلا());
    ألحق(الفئات, فئة_خطأ_نظام.مورد_منهك());
    ألحق(الفئات, فئة_خطأ_نظام.مقاطعة());
    ألحق(الفئات, فئة_خطأ_نظام.آخر());
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الفئات) مثل طبيعي)) {
        دع الفشل: فشل = فشل_من_فئة_خطأ_نظام(&الفئات[ف]);
        لو (!بنسختين(&الفشل)) { أرجع 1; };
        ف := ف + 1;
    }
    دع غير_موجود: فشل = فشل_من_فئة_خطأ_نظام(&الفئات[1]);
    لو (!نصه_بالإنجليزية(&غير_موجود, «the file or path does not exist»)) { أرجع 2; };
    دع الرمز: عدد = -2;
    دع فشل_ملف: فشل = فشل_من_خطأ_ملف(&الرمز);
    دع فشل_دخل: فشل = فشل_من_خطأ_دخل_خرج(&الرمز);
    دع فشل_عملية: فشل = فشل_من_خطأ_عملية(&الرمز);
    لو (!بنسختين(&فشل_ملف) || !بنسختين(&فشل_دخل) || !بنسختين(&فشل_عملية)) { أرجع 3; };

    // std.text.number: the 5 variants.
    دع أخطاء_العدد: متغير متجه خطأ_تحليل_عدد = [];
    ألحق(أخطاء_العدد, خطأ_تحليل_عدد.نص_فارغ());
    ألحق(أخطاء_العدد, خطأ_تحليل_عدد.إشارة_بلا_أرقام());
    ألحق(أخطاء_العدد, خطأ_تحليل_عدد.رقم_غير_صالح(3));
    ألحق(أخطاء_العدد, خطأ_تحليل_عدد.تجاوز());
    ألحق(أخطاء_العدد, خطأ_تحليل_عدد.سالب_لطبيعي());
    ف := 0;
    طالما (ف < (الطول(أخطاء_العدد) مثل طبيعي)) {
        دع الفشل: فشل = فشل_من_خطأ_تحليل_عدد(&أخطاء_العدد[ف]);
        لو (!بنسختين(&الفشل)) { أرجع 4; };
        ف := ف + 1;
    }
    دع تجاوز: فشل = فشل_من_خطأ_تحليل_عدد(&أخطاء_العدد[3]);
    لو (!نصه_بالإنجليزية(&تجاوز, «the number is out of the type's range»)) { أرجع 5; };

    // std.json: the 9 classes.
    دع الأصناف: متغير متجه صنف_خطأ_جسون = [];
    ألحق(الأصناف, صنف_خطأ_جسون.نهاية_غير_متوقعة());
    ألحق(الأصناف, صنف_خطأ_جسون.رمز_غير_متوقع());
    ألحق(الأصناف, صنف_خطأ_جسون.محرف_هروب_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.هروب_يونيكود_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.يوتيف8_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.رقم_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.نص_لاحق());
    ألحق(الأصناف, صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل());
    ألحق(الأصناف, صنف_خطأ_جسون.تعشيش_عميق_جدا());
    ف := 0;
    طالما (ف < (الطول(الأصناف) مثل طبيعي)) {
        دع الخطأ: خطأ_جسون = { الصنف: الأصناف[ف], الإزاحة: ف };
        دع الفشل: فشل = فشل_من_خطأ_جسون(&الخطأ);
        لو (!بنسختين(&الفشل)) { أرجع 6; };
        ف := ف + 1;
    }
    دع خطأ_لاحق: خطأ_جسون = { الصنف: الأصناف[6], الإزاحة: 3 };
    دع لاحق: فشل = فشل_من_خطأ_جسون(&خطأ_لاحق);
    لو (!نصه_بالإنجليزية(&لاحق, «extra text after the JSON value»)) { أرجع 7; };

    // std.net: the 2 + 3 variants.
    دع صيغة_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.صيغة_غير_صالحة();
    دع ف1: فشل = فشل_من_خطأ_تحليل_آيبي(&صيغة_آيبي);
    دع مدى_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.جزء_خارج_المدى();
    دع ف2: فشل = فشل_من_خطأ_تحليل_آيبي(&مدى_آيبي);
    دع صيغة_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة();
    دع ف3: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&صيغة_مقبس);
    دع عنوان_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.عنوان_غير_صالح();
    دع ف4: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&عنوان_مقبس);
    دع منفذ_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.منفذ_غير_صالح();
    دع ف5: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&منفذ_مقبس);
    لو (!بنسختين(&ف1) || !بنسختين(&ف2) || !بنسختين(&ف3) || !بنسختين(&ف4) || !بنسختين(&ف5)) { أرجع 8; };
    لو (!نصه_بالإنجليزية(&ف5, «invalid socket address port»)) { أرجع 9; };
    أرجع 42;
}
