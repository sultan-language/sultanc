// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/language_chain.sn
// std.error (docs/en/reference/errors.md): صف_فشل_بلغة resolves every error of a cause
// chain with the same locale, writes the connector words in the locale's
// language (fixed std text) and isolates a message or note whose direction
// differs from the connectors'. For Arabic, or a locale without a tag, it is
// صف_فشل when no version applies.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.language;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;
استورد المكتبة.دخ.println;

// U+2068, the text, U+2069, written out byte by byte.
عرف معزول(النص: نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق(البايتات, 0xE2 مثل ط8);
    ألحق(البايتات, 0x81 مثل ط8);
    ألحق(البايتات, 0xA8 مثل ط8);
    ألحق_بايتات_نص(&متغير البايتات, النص);
    ألحق(البايتات, 0xE2 مثل ط8);
    ألحق(البايتات, 0x81 مثل ط8);
    ألحق(البايتات, 0xA9 مثل ط8);
    أرجع البايتات مثل نص;
}

عرف صل(الأجزاء: &متجه نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

عرف وصف_بوسم(الفشل: &فشل, الوسم: نص): نص {
    دع اللغة: لغة = لغة_من_وسم(&الوسم);
    أرجع صف_فشل_بلغة(الفشل, &اللغة);
}

عرف الرئيسية(): عدد {
    دع الجذر: متغير فشل = فشل_بهوية(«config», «فارغ», «ملف الإعدادات فارغ»);
    أضف_نسخة_لغة(&متغير الجذر, «en», «the configuration file is empty»);
    أضف_نسخة_لغة(&متغير الجذر, «fr», «le fichier de configuration est vide»);
    أضف_ملاحظة(&متغير الجذر, «الحجم 0 بايت»);
    دع الوسط: متغير فشل = فشل_بسبب(«تعذر قراءة الإعدادات», الجذر);
    أضف_نسخة_لغة(&متغير الوسط, «en», «could not read the configuration»);
    دع الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_نسخة_لغة(&متغير الأعلى, «en», «while starting the server»);
    أضف_نسخة_لغة(&متغير الأعلى, «fr», «au démarrage du serveur»);
    أضف_ملاحظة(&متغير الأعلى, «المنفذ 8080»);

    // English: every message resolved in English, English connectors, the
    // Arabic notes isolated.
    دع الإنجليزية: متغير متجه نص = [];
    ألحق(الإنجليزية, "while starting the server\nnote: ");
    ألحق(الإنجليزية, معزول(«المنفذ 8080»));
    ألحق(الإنجليزية, "\ncaused by: could not read the configuration\ncaused by: the configuration file is empty\nnote: ");
    ألحق(الإنجليزية, معزول(«الحجم 0 بايت»));
    دع متوقع_الإنجليزية: نص = صل(&الإنجليزية);
    دع بالإنجليزية: نص = وصف_بوسم(&الأعلى, «en-US»);
    إذا (!نصان_متساويان(&بالإنجليزية, &متوقع_الإنجليزية)) { أرجع 1; };

    // The same through an Accept-Language priority list whose first match is
    // English.
    دع الترويسة: نص = «de, en;q=0.9, fr;q=0.8»;
    دع من_ترويسة: لغة = لغة_من_قبول_اللغة(&الترويسة);
    دع بالترويسة: نص = صف_فشل_بلغة(&الأعلى, &من_ترويسة);
    إذا (!نصان_متساويان(&بالترويسة, &متوقع_الإنجليزية)) { أرجع 2; };

    // French: the middle error has no French version, so its author's
    // Arabic message is used, isolated after the English connector.
    دع الفرنسية: متغير متجه نص = [];
    ألحق(الفرنسية, "au démarrage du serveur\nnote: ");
    ألحق(الفرنسية, معزول(«المنفذ 8080»));
    ألحق(الفرنسية, "\ncaused by: ");
    ألحق(الفرنسية, معزول(«تعذر قراءة الإعدادات»));
    ألحق(الفرنسية, "\ncaused by: le fichier de configuration est vide\nnote: ");
    ألحق(الفرنسية, معزول(«الحجم 0 بايت»));
    دع متوقع_الفرنسية: نص = صل(&الفرنسية);
    دع بالفرنسية: نص = وصف_بوسم(&الأعلى, «fr-CH»);
    إذا (!نصان_متساويان(&بالفرنسية, &متوقع_الفرنسية)) { أرجع 3; };

    // Arabic: no Arabic version, so the authors' messages; the same text as
    // صف_فشل. A locale without a tag gives it too.
    دع متوقع_العربية: نص = "أثناء بدء الخادم\nملاحظة: المنفذ 8080\nبسبب: تعذر قراءة الإعدادات\nبسبب: ملف الإعدادات فارغ\nملاحظة: الحجم 0 بايت";
    دع بالعربية: نص = وصف_بوسم(&الأعلى, «ar-SA»);
    إذا (!نصان_متساويان(&بالعربية, &متوقع_العربية)) { أرجع 4; };
    دع الوصف: نص = صف_فشل(&الأعلى);
    إذا (!نصان_متساويان(&الوصف, &متوقع_العربية)) { أرجع 5; };
    دع بلا_وسم: نص = وصف_بوسم(&الأعلى, «»);
    إذا (!نصان_متساويان(&بلا_وسم, &متوقع_العربية)) { أرجع 6; };

    // The same texts on standard output; native and interpreter must agree.
    دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(وصف_بوسم(&الأعلى, «en»));
    دع تجاهل_ثان: نتيجة عدد, عدد = اطبع_سطر(وصف_بوسم(&الأعلى, «ar»));
    أرجع 42;
}
