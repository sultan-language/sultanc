// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_os.sn
// std.error.from_os: every variant of فئة_خطأ_نظام, and the numeric status
// converters of std.fs, std.io and std.process.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_os;
استورد المكتبة.ملفات.error;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.نصوص.compare;

عرف هويته(الفشل: &فشل, النطاق: نص, النوع: نص): منطقي {
    دع نطاقه: نص = نطاق_فشل(الفشل);
    دع نوعه: نص = نوع_فشل(الفشل);
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, &النوع);
}

عرف ملاحظته_الوحيدة(الفشل: &فشل, المتوقع: نص): منطقي {
    دع الملاحظات: متجه نص = ملاحظات_فشل(الفشل);
    لو ((الطول(الملاحظات) مثل طبيعي) != 1) { أرجع خطأ; };
    أرجع نصان_متساويان(&الملاحظات[0], &المتوقع);
}

عرف الرئيسية(): عدد {
    دع الفئات: متغير متجه فئة_خطأ_نظام = [];
    ألحق(الفئات, فئة_خطأ_نظام.لا_خطأ());
    ألحق(الفئات, فئة_خطأ_نظام.غير_موجود());
    ألحق(الفئات, فئة_خطأ_نظام.مرفوض_الإذن());
    ألحق(الفئات, فئة_خطأ_نظام.موجود_مسبقا());
    ألحق(الفئات, فئة_خطأ_نظام.إدخال_غير_صالح());
    ألحق(الفئات, فئة_خطأ_نظام.غير_مدعوم());
    ألحق(الفئات, فئة_خطأ_نظام.هو_دليل());
    ألحق(الفئات, فئة_خطأ_نظام.ليس_دليلا());
    ألحق(الفئات, فئة_خطأ_نظام.مورد_منهك());
    ألحق(الفئات, فئة_خطأ_نظام.مقاطعة());
    ألحق(الفئات, فئة_خطأ_نظام.آخر());
    دع الأسماء: متجه نص = [
        «لا_خطأ», «غير_موجود», «مرفوض_الإذن», «موجود_مسبقا», «إدخال_غير_صالح»,
        «غير_مدعوم», «هو_دليل», «ليس_دليلا», «مورد_منهك», «مقاطعة», «آخر»
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الفئات) مثل طبيعي)) {
        دع الفشل: فشل = فشل_من_فئة_خطأ_نظام(&الفئات[ف]);
        لو (!هويته(&الفشل, «std.fs», استنسخ(&الأسماء[ف]))) { أرجع 1; };
        دع الرسالة: نص = رسالة_فشل(&الفشل);
        لو ((الطول(الرسالة) مثل طبيعي) == 0) { أرجع 2; };
        لو (له_سبب(&الفشل)) { أرجع 3; };
        ف := ف + 1;
    }
    دع غير_موجود: فشل = فشل_من_فئة_خطأ_نظام(&الفئات[1]);
    دع رسالة_غير_موجود: نص = رسالة_فشل(&غير_موجود);
    دع متوقع_غير_موجود: نص = «الملف أو المسار غير موجود»;
    لو (!نصان_متساويان(&رسالة_غير_موجود, &متوقع_غير_موجود)) { أرجع 4; };

    // Numeric statuses: the kind is the std.fs.error classification, the
    // domain is the reporting module, the status is kept as a note.
    دع ملف: عدد = -2;
    دع فشل_ملف: فشل = فشل_من_خطأ_ملف(&ملف);
    لو (!هويته(&فشل_ملف, «std.fs», «غير_موجود»)) { أرجع 5; };
    لو (!ملاحظته_الوحيدة(&فشل_ملف, «رمز الحالة: -2»)) { أرجع 6; };
    دع دخل_خرج: عدد = -13;
    دع فشل_دخل_خرج: فشل = فشل_من_خطأ_دخل_خرج(&دخل_خرج);
    لو (!هويته(&فشل_دخل_خرج, «std.io», «مرفوض_الإذن»)) { أرجع 7; };
    لو (!ملاحظته_الوحيدة(&فشل_دخل_خرج, «رمز الحالة: -13»)) { أرجع 8; };
    دع عملية: عدد = -22;
    دع فشل_عملية: فشل = فشل_من_خطأ_عملية(&عملية);
    لو (!هويته(&فشل_عملية, «std.process», «إدخال_غير_صالح»)) { أرجع 9; };
    دع موجود: عدد = -17;
    دع فشل_موجود: فشل = فشل_من_خطأ_ملف(&موجود);
    لو (!هويته(&فشل_موجود, «std.fs», «موجود_مسبقا»)) { أرجع 10; };
    دع صفر: عدد = 0;
    دع فشل_صفر: فشل = فشل_من_خطأ_دخل_خرج(&صفر);
    لو (!هويته(&فشل_صفر, «std.io», «لا_خطأ»)) { أرجع 11; };
    دع موجب: عدد = 5;
    دع فشل_موجب: فشل = فشل_من_خطأ_عملية(&موجب);
    لو (!هويته(&فشل_موجب, «std.process», «آخر»)) { أرجع 12; };

    // A real failure from std.fs.
    دع المسار: نص = «std-error-file-that-does-not-exist.tmp»;
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(_) -> { أرجع 13; }
    | نتيجة.خطأ(الرمز) -> {
        دع الفشل: فشل = فشل_من_خطأ_ملف(&الرمز);
        دع نطاق_متوقع: نص = «std.fs»;
        دع نوع_متوقع: نص = «غير_موجود»;
        لو (!هل_من_نوع(&الفشل, &نطاق_متوقع, &نوع_متوقع)) { أرجع 14; };
    };
    أرجع 42;
}
