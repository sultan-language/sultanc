// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_net.sn
// std.error.from_net: every variant of خطأ_تحليل_آيبي and خطأ_تحليل_عنوان_مقبس.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_net;
استورد المكتبة.شبكة.ip;
استورد المكتبة.شبكة.socket_address;
استورد المكتبة.نصوص.compare;

عرف هويته(الفشل: &فشل, النوع: نص): منطقي {
    دع نطاقه: نص = نطاق_فشل(الفشل);
    دع نوعه: نص = نوع_فشل(الفشل);
    دع النطاق: نص = «std.net»;
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, &النوع);
}

عرف الرئيسية(): عدد {
    دع صيغة_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.صيغة_غير_صالحة();
    دع ف1: فشل = فشل_من_خطأ_تحليل_آيبي(&صيغة_آيبي);
    إذا (!هويته(&ف1, «صيغة_غير_صالحة»)) { أرجع 1; };
    دع مدى_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.جزء_خارج_المدى();
    دع ف2: فشل = فشل_من_خطأ_تحليل_آيبي(&مدى_آيبي);
    إذا (!هويته(&ف2, «جزء_خارج_المدى»)) { أرجع 2; };

    دع صيغة_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة();
    دع ف3: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&صيغة_مقبس);
    إذا (!هويته(&ف3, «صيغة_غير_صالحة»)) { أرجع 3; };
    دع عنوان_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.عنوان_غير_صالح();
    دع ف4: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&عنوان_مقبس);
    إذا (!هويته(&ف4, «عنوان_غير_صالح»)) { أرجع 4; };
    دع منفذ_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.منفذ_غير_صالح();
    دع ف5: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&منفذ_مقبس);
    إذا (!هويته(&ف5, «منفذ_غير_صالح»)) { أرجع 5; };
    دع رسالة5: نص = رسالة_فشل(&ف5);
    دع متوقع5: نص = «منفذ عنوان المقبس غير صالح»;
    إذا (!نصان_متساويان(&رسالة5, &متوقع5)) { أرجع 6; };

    // A real parse failure.
    دع النص: نص = «1.2.3»;
    طابق حلل_عنوان_آيبي(&النص) مع
    | نتيجة.نجح(_) -> { أرجع 7; }
    | نتيجة.خطأ(الخطأ) -> {
        دع الفشل: فشل = فشل_من_خطأ_تحليل_آيبي(&الخطأ);
        إذا (!هويته(&الفشل, «صيغة_غير_صالحة»)) { أرجع 8; };
    };
    أرجع 42;
}
