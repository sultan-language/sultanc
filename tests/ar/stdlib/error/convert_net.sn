// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_net.sn
// std.error.from_net: every variant of خطأ_تحليل_آيبي and خطأ_تحليل_عنوان_مقبس.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.أخطاء.من_شبكة;
استورد المكتبة.شبكة.آيبي;
استورد المكتبة.شبكة.عنوان_مقبس;
استورد المكتبة.نصوص.مقارنة;

عرف هويته(الفشل: &فشل, النوع: نص): منطقي {
    ليكن نطاقه: نص = نطاق_فشل(الفشل);
    ليكن نوعه: نص = نوع_فشل(الفشل);
    ليكن النطاق: نص = «std.net»;
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, &النوع);
}

عرف الرئيسية(): عدد {
    ليكن صيغة_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.صيغة_غير_صالحة();
    ليكن ف1: فشل = فشل_من_خطأ_تحليل_آيبي(&صيغة_آيبي);
    إذا (!هويته(&ف1, «صيغة_غير_صالحة»)) { أرجع 1; };
    ليكن مدى_آيبي: خطأ_تحليل_آيبي = خطأ_تحليل_آيبي.جزء_خارج_المدى();
    ليكن ف2: فشل = فشل_من_خطأ_تحليل_آيبي(&مدى_آيبي);
    إذا (!هويته(&ف2, «جزء_خارج_المدى»)) { أرجع 2; };

    ليكن صيغة_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة();
    ليكن ف3: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&صيغة_مقبس);
    إذا (!هويته(&ف3, «صيغة_غير_صالحة»)) { أرجع 3; };
    ليكن عنوان_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.عنوان_غير_صالح();
    ليكن ف4: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&عنوان_مقبس);
    إذا (!هويته(&ف4, «عنوان_غير_صالح»)) { أرجع 4; };
    ليكن منفذ_مقبس: خطأ_تحليل_عنوان_مقبس = خطأ_تحليل_عنوان_مقبس.منفذ_غير_صالح();
    ليكن ف5: فشل = فشل_من_خطأ_تحليل_عنوان_مقبس(&منفذ_مقبس);
    إذا (!هويته(&ف5, «منفذ_غير_صالح»)) { أرجع 5; };
    ليكن رسالة5: نص = رسالة_فشل(&ف5);
    ليكن متوقع5: نص = «منفذ عنوان المقبس غير صالح»;
    إذا (!نصان_متساويان(&رسالة5, &متوقع5)) { أرجع 6; };

    // A real parse failure.
    ليكن النص: نص = «1.2.3»;
    طابق حلل_عنوان_آيبي(&النص) مع
    | نتيجة.نجح(_) -> { أرجع 7; }
    | نتيجة.خطأ(الخطأ) -> {
        ليكن الفشل: فشل = فشل_من_خطأ_تحليل_آيبي(&الخطأ);
        إذا (!هويته(&الفشل, «صيغة_غير_صالحة»)) { أرجع 8; };
    };
    أرجع 42;
}
