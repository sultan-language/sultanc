// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/accept_language.sn
// std.text.language (docs/ERRORS.md): BCP 47 tags (well-formedness,
// canonical case, primary language, RFC 4647 truncation), locales built from
// a tag, and HTTP Accept-Language with q-values: ranges ordered by weight,
// equal weights in the order written; weight 0, «*», ill-formed ranges and
// malformed weights left out.
استورد المكتبة.نصوص.language;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.transform;

عرف صالح(الوسم: نص): منطقي {
    أرجع وسم_لغة_صالح(&الوسم);
}

عرف يساوي(الفعلي: نص, المتوقع: نص): منطقي {
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف مطبوع(الوسم: نص): نص {
    أرجع طبع_وسم_لغة(&الوسم);
}

// The tags of the locale of a header, joined by «|».
عرف وسوم_ترويسة(الترويسة: نص): نص {
    دع اللغة: لغة = لغة_من_قبول_اللغة(&الترويسة);
    دع الوسوم: متجه نص = وسوم_لغة(&اللغة);
    دع الفاصل: نص = «|»;
    أرجع صل_النصوص(&الوسوم, &الفاصل);
}

عرف الرئيسية(): عدد {
    // Well-formed tags.
    لو (!صالح(«ar») || !صالح(«ar-SA») || !صالح(«zh-Hant-TW») || !صالح(«sr-Latn-RS»)) { أرجع 1; };
    لو (!صالح(«de-CH-1901») || !صالح(«es-419») || !صالح(«zh-yue-HK») || !صالح(«ar_SA»)) { أرجع 2; };
    لو (!صالح(«en-US-x-twain») || !صالح(«x-private») || !صالح(«en-a-bbb-x-a-ccc»)) { أرجع 3; };
    // Ill-formed tags.
    لو (صالح(«») || صالح(«a») || صالح(«ar-») || صالح(«-ar») || صالح(«123»)) { أرجع 4; };
    لو (صالح(«toolongtag») || صالح(«x») || صالح(«en-a») || صالح(«*») || صالح(«ar SA»)) { أرجع 5; };
    لو (صالح(«en-US-Latn») || صالح(«en-x»)) { أرجع 6; };

    // Canonical case and separators.
    لو (!يساوي(مطبوع(«EN-us»), «en-US»)) { أرجع 7; };
    لو (!يساوي(مطبوع(«sr_latn_rs»), «sr-Latn-RS»)) { أرجع 8; };
    لو (!يساوي(مطبوع(«ZH-HANT»), «zh-Hant»)) { أرجع 9; };
    لو (!يساوي(مطبوع(«de-ch-1901»), «de-CH-1901»)) { أرجع 10; };
    لو (!يساوي(مطبوع(«en-a-BB-x-AB»), «en-a-bb-x-ab»)) { أرجع 11; };

    // Primary language and one RFC 4647 truncation step.
    دع الوسم: نص = «AR-SA»;
    لو (!يساوي(اللغة_الأساسية_لوسم(&الوسم), «ar»)) { أرجع 12; };
    دع طويل: نص = «zh-Hant-CN-x-private1»;
    دع أقصر: نص = اختصر_وسم_لغة(&طويل);
    دع متوقع_أقصر: نص = «zh-Hant-CN»;
    لو (!نصان_متساويان(&أقصر, &متوقع_أقصر)) { أرجع 13; };
    لو (!يساوي(اختصر_وسم_لغة(&أقصر), «zh-Hant»)) { أرجع 14; };
    دع قاعدي: نص = «ar»;
    لو (!يساوي(اختصر_وسم_لغة(&قاعدي), «»)) { أرجع 15; };

    // A locale from a tag: spaces dropped, canonical case; none when
    // ill-formed.
    دع مكتوب: نص = «  ar_sa  »;
    دع من_وسم: لغة = لغة_من_وسم(&مكتوب);
    لو (!يساوي(وسم_لغة(&من_وسم), «ar-SA»)) { أرجع 16; };
    لو (!يساوي(اللغة_الأساسية(&من_وسم), «ar»)) { أرجع 17; };
    دع رديء: نص = «ar-»;
    دع بلا_وسم: لغة = لغة_من_وسم(&رديء);
    دع وسوم_بلا_وسم: متجه نص = وسوم_لغة(&بلا_وسم);
    لو ((الطول(وسوم_بلا_وسم) مثل طبيعي) != 0) { أرجع 18; };
    لو (!يساوي(وسم_لغة(&بلا_وسم), «») || !يساوي(اللغة_الأساسية(&بلا_وسم), «»)) { أرجع 19; };

    // Accept-Language: by weight, highest first.
    لو (!يساوي(وسوم_ترويسة(«fr-CH, fr;q=0.9, en;q=0.8, de;q=0.7, *;q=0.5»), «fr-CH|fr|en|de»)) { أرجع 20; };
    لو (!يساوي(وسوم_ترويسة(«en;q=0.5, ar, fr;q=0.8»), «ar|fr|en»)) { أرجع 21; };
    // Equal weights keep the order written.
    لو (!يساوي(وسوم_ترويسة(«de;q=0.8, ar;q=0.8, en»), «en|de|ar»)) { أرجع 22; };
    // Weight 0 is «not acceptable»; «Q» and spaces; canonical case.
    لو (!يساوي(وسوم_ترويسة(«ar ; Q=0 , en-us;q=1.000,fr;q=0.001»), «en-US|fr»)) { أرجع 23; };
    // Malformed weights and ranges are left out.
    لو (!يساوي(وسوم_ترويسة(«en;q=1.5, de;q=abc, fr;q=0.5555, ar;q=0.25, es;q=.5, it;q=1., ja»), «it|ja|ar»)) { أرجع 24; };
    لو (!يساوي(وسوم_ترويسة(«en-US-, ar»), «ar»)) { أرجع 25; };
    // No range at all.
    لو (!يساوي(وسوم_ترويسة(«»), «»)) { أرجع 26; };
    لو (!يساوي(وسوم_ترويسة(«*»), «»)) { أرجع 27; };
    لو (!يساوي(وسوم_ترويسة(« , ,»), «»)) { أرجع 28; };

    // The most preferred tag, and a copy.
    دع الترويسة: نص = «en-GB;q=0.9, ar-EG»;
    دع من_ترويسة: لغة = لغة_من_قبول_اللغة(&الترويسة);
    لو (!يساوي(وسم_لغة(&من_ترويسة), «ar-EG») || !يساوي(اللغة_الأساسية(&من_ترويسة), «ar»)) { أرجع 29; };
    دع نسخة: لغة = انسخ_لغة(&من_ترويسة);
    دع وسوم_النسخة: متجه نص = وسوم_لغة(&نسخة);
    دع الفاصل: نص = «|»;
    لو (!يساوي(صل_النصوص(&وسوم_النسخة, &الفاصل), «ar-EG|en-GB»)) { أرجع 30; };
    أرجع 42;
}
