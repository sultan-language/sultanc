// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/chain_identity.sn
// std.error: هل_من_نوع searches the value and its whole cause chain,
// checked at each level of a three-level chain.
استورد المكتبة.أخطاء.failure;

عرف الرئيسية(): عدد {
    دع نطاق_ملفات: نص = «std.fs»;
    دع غير_موجود: نص = «غير_موجود»;
    دع نطاق_إعدادات: نص = «config»;
    دع غير_محمل: نص = «غير_محمل»;
    دع نطاق_خادم: نص = «server»;
    دع بدء_فاشل: نص = «بدء_فاشل»;
    دع مرفوض: نص = «مرفوض_الإذن»;
    دع فارغ: نص = «»;

    دع الثالث: فشل = فشل_بهوية(«std.fs», «غير_موجود», «ملف الإعدادات غير موجود»);
    دع الثاني: فشل = فشل_بهوية_وسبب(«config», «غير_محمل», «تعذر تحميل الإعدادات», الثالث);
    دع الأول: فشل = فشل_بهوية_وسبب(«server», «بدء_فاشل», «أثناء بدء الخادم», الثاني);

    // Level 1 sees all three identities.
    إذا (!هل_من_نوع(&الأول, &نطاق_خادم, &بدء_فاشل)) { أرجع 1; };
    إذا (!هل_من_نوع(&الأول, &نطاق_إعدادات, &غير_محمل)) { أرجع 2; };
    إذا (!هل_من_نوع(&الأول, &نطاق_ملفات, &غير_موجود)) { أرجع 3; };

    طابق سبب_فشل(&الأول) مع
    | اختياري.لا_شيء -> { أرجع 4; }
    | اختياري.موجود(المستوى2) -> {
        // Level 2 sees itself and its cause, not the error that wraps it.
        إذا (هل_من_نوع(&المستوى2, &نطاق_خادم, &بدء_فاشل)) { أرجع 5; };
        إذا (!هل_من_نوع(&المستوى2, &نطاق_إعدادات, &غير_محمل)) { أرجع 6; };
        إذا (!هل_من_نوع(&المستوى2, &نطاق_ملفات, &غير_موجود)) { أرجع 7; };
        طابق سبب_فشل(&المستوى2) مع
        | اختياري.لا_شيء -> { أرجع 8; }
        | اختياري.موجود(المستوى3) -> {
            // Level 3 sees only itself.
            إذا (هل_من_نوع(&المستوى3, &نطاق_خادم, &بدء_فاشل)) { أرجع 9; };
            إذا (هل_من_نوع(&المستوى3, &نطاق_إعدادات, &غير_محمل)) { أرجع 10; };
            إذا (!هل_من_نوع(&المستوى3, &نطاق_ملفات, &غير_موجود)) { أرجع 11; };
            إذا (له_سبب(&المستوى3)) { أرجع 12; };
        };
    };

    // The same kind in another domain is another identity.
    إذا (هل_من_نوع(&الأول, &نطاق_خادم, &غير_موجود)) { أرجع 13; };
    // An identity absent from the chain.
    إذا (هل_من_نوع(&الأول, &نطاق_ملفات, &مرفوض)) { أرجع 14; };

    // Ad-hoc wrappers keep the chain searchable; an empty kind never matches.
    دع عرضي: فشل = فشل_بسبب(«تعذر تشغيل البرنامج», الأول);
    إذا (!هل_من_نوع(&عرضي, &نطاق_ملفات, &غير_موجود)) { أرجع 15; };
    إذا (هل_من_نوع(&عرضي, &فارغ, &فارغ)) { أرجع 16; };
    أرجع 42;
}
