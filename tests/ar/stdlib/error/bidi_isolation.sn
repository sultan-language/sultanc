// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/bidi_isolation.sn
// std.text.bidi (docs/en/reference/errors.md): the direction of a text's first strong
// character, isolates U+2068 … U+2069, isolation only where the directions
// differ; and صف_فشل_بلغة isolating a Latin message inside Arabic text.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.language;
استورد المكتبة.نصوص.bidi;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;

// U+2068, the text, U+2069, written out byte by byte.
عرف معزول(النص: نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق(البايتات, 0xE2 مثل ط8);
    ألحق(البايتات, 0x81 مثل ط8);
    ألحق(البايتات, 0xA8 مثل ط8);
    ألحق_بايتات_نص(&متغير البايتات, النص);
    ألحق(البايتات, 0xE2 مثل ط8);
    ألحق(البايتات, 0x81 مثل ط8);
    ألحق(البايتات, 0xA9 مثل ط8);
    أرجع البايتات مثل نص;
}

عرف صل(الأجزاء: &متجه نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*الأجزاء) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

// 0 neutral, 1 left-to-right, 2 right-to-left.
عرف اتجاه(النص: نص): عدد {
    طابق اتجاه_النص(&النص) مع
    | اتجاه_نص.محايد -> { أرجع 0; }
    | اتجاه_نص.من_اليسار_إلى_اليمين -> { أرجع 1; }
    | اتجاه_نص.من_اليمين_إلى_اليسار -> { أرجع 2; };
}

عرف يساوي(الفعلي: نص, المتوقع: نص): منطقي {
    أرجع نصان_متساويان(&الفعلي, &المتوقع);
}

عرف في_سياق_عربي(النص: نص): نص {
    أرجع اعزل_اتجاه_في(&النص, اتجاه_نص.من_اليمين_إلى_اليسار());
}

عرف في_سياق_إنجليزي(النص: نص): نص {
    أرجع اعزل_اتجاه_في(&النص, اتجاه_نص.من_اليسار_إلى_اليمين());
}

عرف الرئيسية(): عدد {
    // The first strong character decides.
    إذا (اتجاه(«config.toml») != 1 || اتجاه(«مرحبا») != 2 || اتجاه(«123 !») != 0) { أرجع 1; };
    إذا (اتجاه(«  ملف config») != 2 || اتجاه(«config ملف») != 1 || اتجاه(«») != 0) { أرجع 2; };
    إذا (اتجاه(«Привет») != 1 || اتجاه(«שלום») != 2 || اتجاه(«٣٤٥ ۶») != 0) { أرجع 3; };
    // What lies inside an isolate does not count.
    إذا (اتجاه(معزول(«config»)) != 0) { أرجع 4; };
    دع داخل_عزل: متغير متجه نص = [];
    ألحق(داخل_عزل, معزول(«config»));
    ألحق(داخل_عزل, « ملف»);
    إذا (اتجاه(صل(&داخل_عزل)) != 2) { أرجع 5; };

    // Isolation: always, or only where the directions differ.
    دع اسم_الملف: نص = «config.toml»;
    دع معزول_دائما: نص = اعزل_اتجاه(&اسم_الملف);
    إذا ((الطول(معزول_دائما) مثل طبيعي) != 17) { أرجع 6; };
    إذا (!يساوي(معزول_دائما, معزول(«config.toml»))) { أرجع 7; };
    إذا (!يساوي(في_سياق_عربي(«config.toml»), معزول(«config.toml»))) { أرجع 8; };
    إذا (!يساوي(في_سياق_إنجليزي(«config.toml»), «config.toml»)) { أرجع 9; };
    إذا (!يساوي(في_سياق_عربي(«ملف الإعدادات»), «ملف الإعدادات»)) { أرجع 10; };
    إذا (!يساوي(في_سياق_إنجليزي(«ملف الإعدادات»), معزول(«ملف الإعدادات»))) { أرجع 11; };
    إذا (!يساوي(في_سياق_عربي(«8080»), «8080»)) { أرجع 12; };
    إذا (!يساوي(في_سياق_عربي(«المسار /etc/app»), «المسار /etc/app»)) { أرجع 13; };
    دع محايد_السياق: نص = اعزل_اتجاه_في(&اسم_الملف, اتجاه_نص.محايد());
    إذا (!يساوي(محايد_السياق, «config.toml»)) { أرجع 14; };

    // A Latin message inside Arabic text: an English author's error with an
    // Arabic version on the outer error only, rendered for Arabic.
    دع الجذر: فشل = فشل_من(«file not found: settings.toml»);
    دع الأعلى: متغير فشل = فشل_بسبب(«while reading the settings», الجذر);
    أضف_نسخة_لغة(&متغير الأعلى, «ar», «أثناء قراءة الإعدادات»);
    أضف_ملاحظة(&متغير الأعلى, «path: /etc/app/settings.toml»);
    أضف_ملاحظة(&متغير الأعلى, «المسار من APP_SETTINGS»);
    دع الأجزاء: متغير متجه نص = [];
    ألحق(الأجزاء, "أثناء قراءة الإعدادات\nملاحظة: ");
    ألحق(الأجزاء, معزول(«path: /etc/app/settings.toml»));
    ألحق(الأجزاء, "\nملاحظة: المسار من APP_SETTINGS\nبسبب: ");
    ألحق(الأجزاء, معزول(«file not found: settings.toml»));
    دع المتوقع: نص = صل(&الأجزاء);
    دع العربية: نص = «ar-EG»;
    دع اللغة: لغة = لغة_من_وسم(&العربية);
    دع الفعلي: نص = صف_فشل_بلغة(&الأعلى, &اللغة);
    إذا (!نصان_متساويان(&الفعلي, &المتوقع)) { أرجع 15; };
    // صف_فشل never isolates.
    دع بلا_عزل: نص = "while reading the settings\nملاحظة: path: /etc/app/settings.toml\nملاحظة: المسار من APP_SETTINGS\nبسبب: file not found: settings.toml";
    دع الوصف: نص = صف_فشل(&الأعلى);
    إذا (!نصان_متساويان(&الوصف, &بلا_عزل)) { أرجع 16; };
    أرجع 42;
}
