// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_json.sn
// std.error.from_json: every variant of صنف_خطأ_جسون; the byte offset is a note.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_json;
استورد المكتبة.json.value;
استورد المكتبة.json.parse;
استورد المكتبة.نصوص.compare;

عرف هويته(الفشل: &فشل, النوع: &نص): منطقي {
    دع نطاقه: نص = نطاق_فشل(الفشل);
    دع نوعه: نص = نوع_فشل(الفشل);
    دع النطاق: نص = «std.json»;
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, النوع);
}

عرف الرئيسية(): عدد {
    دع الأصناف: متغير متجه صنف_خطأ_جسون = [];
    ألحق(الأصناف, صنف_خطأ_جسون.نهاية_غير_متوقعة());
    ألحق(الأصناف, صنف_خطأ_جسون.رمز_غير_متوقع());
    ألحق(الأصناف, صنف_خطأ_جسون.محرف_هروب_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.هروب_يونيكود_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.يوتيف8_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.رقم_غير_صالح());
    ألحق(الأصناف, صنف_خطأ_جسون.نص_لاحق());
    ألحق(الأصناف, صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل());
    ألحق(الأصناف, صنف_خطأ_جسون.تعشيش_عميق_جدا());
    دع الأسماء: متجه نص = [
        «نهاية_غير_متوقعة», «رمز_غير_متوقع», «محرف_هروب_غير_صالح»,
        «هروب_يونيكود_غير_صالح», «يوتيف8_غير_صالح», «رقم_غير_صالح»,
        «نص_لاحق», «سعة_كائن_غير_قابلة_للتمثيل», «تعشيش_عميق_جدا»
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأصناف) مثل طبيعي)) {
        دع الخطأ: خطأ_جسون = { الصنف: الأصناف[ف], الإزاحة: ف };
        دع الفشل: فشل = فشل_من_خطأ_جسون(&الخطأ);
        إذا (!هويته(&الفشل, &الأسماء[ف])) { أرجع 1; };
        دع الرسالة: نص = رسالة_فشل(&الفشل);
        إذا ((الطول(الرسالة) مثل طبيعي) == 0) { أرجع 2; };
        دع الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
        إذا ((الطول(الملاحظات) مثل طبيعي) != 1) { أرجع 3; };
        ف := ف + 1;
    }

    // A real parse failure: trailing text at byte 3.
    دع النص: نص = «[1]x»;
    طابق حلل_جسون(&النص) مع
    | نتيجة.نجح(_) -> { أرجع 4; }
    | نتيجة.خطأ(الخطأ) -> {
        دع الفشل: فشل = فشل_من_خطأ_جسون(&الخطأ);
        دع نص_لاحق: نص = «نص_لاحق»;
        إذا (!هويته(&الفشل, &نص_لاحق)) { أرجع 5; };
        دع الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
        دع متوقع: نص = «إزاحة البايت: 3»;
        إذا (!نصان_متساويان(&الملاحظات[0], &متوقع)) { أرجع 6; };
        دع الرسالة: نص = رسالة_فشل(&الفشل);
        دع متوقع_الرسالة: نص = «نص زائد بعد قيمة JSON»;
        إذا (!نصان_متساويان(&الرسالة, &متوقع_الرسالة)) { أرجع 7; };
    };
    أرجع 42;
}
