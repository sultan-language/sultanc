// اختبار: قبول
// خروج: 0
// مرحلة0: نعم
// نظير: tests/en/stdlib/error/stage0_contract.sn
// std.error stays within the C Stage0's language (docs/en/reference/errors.md): every
// public function of std.error.failure, std.error.from_os,
// std.error.from_number and std.error.context, and of the Phase 3 helpers
// std.text.language, std.text.bidi and std.text.system_language, accepted by
// Stage0 too. from_json and from_net are left out: std.json and
// std.net.socket_address themselves are beyond Stage0.
// Imports use std paths: Stage0 does not resolve Arabic package aliases.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.دخ.اطبع_فشل;
استورد المكتبة.أخطاء.من_نظام;
استورد المكتبة.أخطاء.من_عدد;
استورد المكتبة.أخطاء.سياق;
استورد المكتبة.ملفات.أخطاء;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.لغة;
استورد المكتبة.نصوص.اتجاه;
استورد المكتبة.نصوص.لغة_النظام;

عرف الرئيسية(): عدد {
    ليكن الجذر: فشل = فشل_بهوية(«std.fs», «غير_موجود», «الملف غير موجود»);
    ليكن الوسط: فشل = فشل_بهوية_وسبب(«config», «غير_محمل», «تعذر تحميل الإعدادات», الجذر);
    ليكن الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_ملاحظة(&متغير الأعلى, «ملاحظة»);
    ليكن عرضي: فشل = فشل_من(«عرضي»);
    ليكن نسخة: فشل = انسخ_فشل(&الأعلى);
    ليكن الرسالة: نص = رسالة_فشل(&نسخة);
    ليكن النطاق: نص = نطاق_فشل(&عرضي);
    ليكن النوع: نص = نوع_فشل(&نسخة);
    ليكن الملاحظات: متجه نص = ملاحظات_فشل(&الأعلى);
    ليكن السبب: اختياري فشل = سبب_فشل(&الأعلى);
    ليكن الوصف: نص = صف_فشل(&الأعلى);
    ليكن نطاق_بحث: نص = «std.fs»;
    ليكن نوع_بحث: نص = «غير_موجود»;
    إذا (!هل_من_نوع(&الأعلى, &نطاق_بحث, &نوع_بحث) || !له_سبب(&الأعلى)) { اطبع_فشل(&الأعلى); };

    ليكن الفئة: فئة_خطأ_نظام = فئة_خطأ_نظام.غير_موجود();
    ليكن ف1: فشل = فشل_من_فئة_خطأ_نظام(&الفئة);
    ليكن الرمز: عدد = -2;
    ليكن ف2: فشل = فشل_من_خطأ_ملف(&الرمز);
    ليكن ف3: فشل = فشل_من_خطأ_دخل_خرج(&الرمز);
    ليكن ف4: فشل = فشل_من_خطأ_عملية(&الرمز);
    ليكن خطأ_عدد: خطأ_تحليل_عدد = خطأ_تحليل_عدد.تجاوز();
    ليكن ف5: فشل = فشل_من_خطأ_تحليل_عدد(&خطأ_عدد);
    ليكن النص: نص = «12»;
    ليكن محول: نتيجة عدد, فشل = إلى_فشل(حلل_عدد(&النص), فشل_من_خطأ_تحليل_عدد);
    ليكن بسياق: نتيجة عدد, فشل = مع_سياق(محول, «سياق»);
    ليكن بملاحظة: نتيجة عدد, فشل = مع_ملاحظة(بسياق, «ملاحظة»);

    // Phase 3: language versions, locales, direction isolation.
    أضف_نسخة_لغة(&متغير الأعلى, «en», «while starting the server»);
    ليكن الوسم: نص = «ar-SA»;
    ليكن من_وسم: لغة = لغة_من_وسم(&الوسم);
    ليكن الترويسة: نص = «en;q=0.8, ar»;
    ليكن من_ترويسة: لغة = لغة_من_قبول_اللغة(&الترويسة);
    ليكن من_البيئة: لغة = لغة_من_البيئة();
    ليكن نسخة_اللغة: لغة = انسخ_لغة(&من_ترويسة);
    ليكن الوسوم: متجه نص = وسوم_لغة(&نسخة_اللغة);
    ليكن الأول: نص = وسم_لغة(&من_وسم);
    ليكن الأساسية: نص = اللغة_الأساسية(&من_البيئة);
    ليكن صالح: منطقي = وسم_لغة_صالح(&الوسم);
    ليكن مطبوع: نص = طبع_وسم_لغة(&الوسم);
    ليكن أساسية_الوسم: نص = اللغة_الأساسية_لوسم(&الوسم);
    ليكن مختصر: نص = اختصر_وسم_لغة(&الوسم);
    ليكن بلغة: نص = نص_فشل_بلغة(&الأعلى, &من_وسم);
    ليكن وصف_بلغة: نص = صف_فشل_بلغة(&الأعلى, &من_ترويسة);
    إذا (!صالح) { اطبع_فشل_بلغة(&الأعلى, &من_وسم); };
    ليكن الاتجاه: اتجاه_نص = اتجاه_النص(&بلغة);
    ليكن معزول: نص = اعزل_اتجاه(&وصف_بلغة);
    ليكن في_سياق: نص = اعزل_اتجاه_في(&مطبوع, الاتجاه);
    أرجع 0;
}
