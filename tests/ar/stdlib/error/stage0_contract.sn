// اختبار: قبول
// خروج: 0
// مرحلة0: نعم
// نظير: tests/en/stdlib/error/stage0_contract.sn
// std.error stays within the C Stage0's language (docs/en/reference/errors.md): every
// public function of std.error.failure, std.error.from_os,
// std.error.from_number and std.error.context, and of the Phase 3 helpers
// std.text.language, std.text.bidi and std.text.system_language, accepted by
// Stage0 too. from_json and from_net are left out: std.json and
// std.net.socket_address themselves are beyond Stage0.
// Imports use std paths: Stage0 does not resolve Arabic package aliases.
استورد std.error.failure;
استورد std.error.from_os;
استورد std.error.from_number;
استورد std.error.context;
استورد std.fs.error;
استورد std.text.number;
استورد std.text.language;
استورد std.text.bidi;
استورد std.text.system_language;

عرف الرئيسية(): عدد {
    دع الجذر: فشل = فشل_بهوية(«std.fs», «غير_موجود», «الملف غير موجود»);
    دع الوسط: فشل = فشل_بهوية_وسبب(«config», «غير_محمل», «تعذر تحميل الإعدادات», الجذر);
    دع الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_ملاحظة(&متغير الأعلى, «ملاحظة»);
    دع عرضي: فشل = فشل_من(«عرضي»);
    دع نسخة: فشل = انسخ_فشل(&الأعلى);
    دع الرسالة: نص = رسالة_فشل(&نسخة);
    دع النطاق: نص = نطاق_فشل(&عرضي);
    دع النوع: نص = نوع_فشل(&نسخة);
    دع الملاحظات: متجه نص = ملاحظات_فشل(&الأعلى);
    دع السبب: اختياري فشل = سبب_فشل(&الأعلى);
    دع الوصف: نص = صف_فشل(&الأعلى);
    دع نطاق_بحث: نص = «std.fs»;
    دع نوع_بحث: نص = «غير_موجود»;
    إذا (!هل_من_نوع(&الأعلى, &نطاق_بحث, &نوع_بحث) || !له_سبب(&الأعلى)) { اطبع_فشل(&الأعلى); };

    دع الفئة: فئة_خطأ_نظام = فئة_خطأ_نظام.غير_موجود();
    دع ف1: فشل = فشل_من_فئة_خطأ_نظام(&الفئة);
    دع الرمز: عدد = -2;
    دع ف2: فشل = فشل_من_خطأ_ملف(&الرمز);
    دع ف3: فشل = فشل_من_خطأ_دخل_خرج(&الرمز);
    دع ف4: فشل = فشل_من_خطأ_عملية(&الرمز);
    دع خطأ_عدد: خطأ_تحليل_عدد = خطأ_تحليل_عدد.تجاوز();
    دع ف5: فشل = فشل_من_خطأ_تحليل_عدد(&خطأ_عدد);
    دع النص: نص = «12»;
    دع محول: نتيجة عدد, فشل = إلى_فشل(حلل_عدد(&النص), فشل_من_خطأ_تحليل_عدد);
    دع بسياق: نتيجة عدد, فشل = مع_سياق(محول, «سياق»);
    دع بملاحظة: نتيجة عدد, فشل = مع_ملاحظة(بسياق, «ملاحظة»);

    // Phase 3: language versions, locales, direction isolation.
    أضف_نسخة_لغة(&متغير الأعلى, «en», «while starting the server»);
    دع الوسم: نص = «ar-SA»;
    دع من_وسم: لغة = لغة_من_وسم(&الوسم);
    دع الترويسة: نص = «en;q=0.8, ar»;
    دع من_ترويسة: لغة = لغة_من_قبول_اللغة(&الترويسة);
    دع من_البيئة: لغة = لغة_من_البيئة();
    دع نسخة_اللغة: لغة = انسخ_لغة(&من_ترويسة);
    دع الوسوم: متجه نص = وسوم_لغة(&نسخة_اللغة);
    دع الأول: نص = وسم_لغة(&من_وسم);
    دع الأساسية: نص = اللغة_الأساسية(&من_البيئة);
    دع صالح: منطقي = وسم_لغة_صالح(&الوسم);
    دع مطبوع: نص = طبع_وسم_لغة(&الوسم);
    دع أساسية_الوسم: نص = اللغة_الأساسية_لوسم(&الوسم);
    دع مختصر: نص = اختصر_وسم_لغة(&الوسم);
    دع بلغة: نص = نص_فشل_بلغة(&الأعلى, &من_وسم);
    دع وصف_بلغة: نص = صف_فشل_بلغة(&الأعلى, &من_ترويسة);
    إذا (!صالح) { اطبع_فشل_بلغة(&الأعلى, &من_وسم); };
    دع الاتجاه: اتجاه_نص = اتجاه_النص(&بلغة);
    دع معزول: نص = اعزل_اتجاه(&وصف_بلغة);
    دع في_سياق: نص = اعزل_اتجاه_في(&مطبوع, الاتجاه);
    أرجع 0;
}
