// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_number.sn
// std.error.from_number: every variant of خطأ_تحليل_عدد.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_number;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.compare;

عرف هويته(الفشل: &فشل, النوع: نص): منطقي {
    دع نطاقه: نص = نطاق_فشل(الفشل);
    دع نوعه: نص = نوع_فشل(الفشل);
    دع النطاق: نص = «std.text.number»;
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, &النوع);
}

عرف الرئيسية(): عدد {
    دع فارغ: خطأ_تحليل_عدد = خطأ_تحليل_عدد.نص_فارغ();
    دع ف1: فشل = فشل_من_خطأ_تحليل_عدد(&فارغ);
    لو (!هويته(&ف1, «نص_فارغ»)) { أرجع 1; };
    دع إشارة: خطأ_تحليل_عدد = خطأ_تحليل_عدد.إشارة_بلا_أرقام();
    دع ف2: فشل = فشل_من_خطأ_تحليل_عدد(&إشارة);
    لو (!هويته(&ف2, «إشارة_بلا_أرقام»)) { أرجع 2; };
    دع رقم: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(3);
    دع ف3: فشل = فشل_من_خطأ_تحليل_عدد(&رقم);
    لو (!هويته(&ف3, «رقم_غير_صالح»)) { أرجع 3; };
    دع ملاحظات3: متجه نص = ملاحظات_فشل(&ف3);
    دع متوقع3: نص = «موضع البايت: 3»;
    لو ((الطول(ملاحظات3) مثل طبيعي) != 1) { أرجع 4; };
    لو (!نصان_متساويان(&ملاحظات3[0], &متوقع3)) { أرجع 5; };
    دع تجاوز: خطأ_تحليل_عدد = خطأ_تحليل_عدد.تجاوز();
    دع ف4: فشل = فشل_من_خطأ_تحليل_عدد(&تجاوز);
    لو (!هويته(&ف4, «تجاوز»)) { أرجع 6; };
    دع سالب: خطأ_تحليل_عدد = خطأ_تحليل_عدد.سالب_لطبيعي();
    دع ف5: فشل = فشل_من_خطأ_تحليل_عدد(&سالب);
    لو (!هويته(&ف5, «سالب_لطبيعي»)) { أرجع 7; };
    دع رسالة4: نص = رسالة_فشل(&ف4);
    دع متوقع4: نص = «العدد خارج مدى النوع»;
    لو (!نصان_متساويان(&رسالة4, &متوقع4)) { أرجع 8; };

    // A real parse failure.
    دع النص: نص = «12x4»;
    طابق حلل_عدد(&النص) مع
    | نتيجة.نجح(_) -> { أرجع 9; }
    | نتيجة.خطأ(الخطأ) -> {
        دع الفشل: فشل = فشل_من_خطأ_تحليل_عدد(&الخطأ);
        لو (!هويته(&الفشل, «رقم_غير_صالح»)) { أرجع 10; };
        دع الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
        دع متوقع: نص = «موضع البايت: 2»;
        لو (!نصان_متساويان(&الملاحظات[0], &متوقع)) { أرجع 11; };
    };
    أرجع 42;
}
