// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/convert_number.sn
// std.error.from_number: every variant of خطأ_تحليل_عدد.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.أخطاء.من_عدد;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نصوص.مقارنة;

عرف هويته(الفشل: &فشل, النوع: نص): منطقي {
    ليكن نطاقه: نص = نطاق_فشل(الفشل);
    ليكن نوعه: نص = نوع_فشل(الفشل);
    ليكن النطاق: نص = «std.text.number»;
    أرجع نصان_متساويان(&نطاقه, &النطاق) && نصان_متساويان(&نوعه, &النوع);
}

عرف الرئيسية(): عدد {
    ليكن فارغ: خطأ_تحليل_عدد = خطأ_تحليل_عدد.نص_فارغ();
    ليكن ف1: فشل = فشل_من_خطأ_تحليل_عدد(&فارغ);
    إذا (!هويته(&ف1, «نص_فارغ»)) { أرجع 1; };
    ليكن إشارة: خطأ_تحليل_عدد = خطأ_تحليل_عدد.إشارة_بلا_أرقام();
    ليكن ف2: فشل = فشل_من_خطأ_تحليل_عدد(&إشارة);
    إذا (!هويته(&ف2, «إشارة_بلا_أرقام»)) { أرجع 2; };
    ليكن رقم: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(3);
    ليكن ف3: فشل = فشل_من_خطأ_تحليل_عدد(&رقم);
    إذا (!هويته(&ف3, «رقم_غير_صالح»)) { أرجع 3; };
    ليكن ملاحظات3: متجه نص = ملاحظات_فشل(&ف3);
    ليكن متوقع3: نص = «موضع البايت: 3»;
    إذا ((الطول(ملاحظات3) مثل طبيعي) != 1) { أرجع 4; };
    إذا (!نصان_متساويان(&ملاحظات3[0], &متوقع3)) { أرجع 5; };
    ليكن تجاوز: خطأ_تحليل_عدد = خطأ_تحليل_عدد.تجاوز();
    ليكن ف4: فشل = فشل_من_خطأ_تحليل_عدد(&تجاوز);
    إذا (!هويته(&ف4, «تجاوز»)) { أرجع 6; };
    ليكن سالب: خطأ_تحليل_عدد = خطأ_تحليل_عدد.سالب_لطبيعي();
    ليكن ف5: فشل = فشل_من_خطأ_تحليل_عدد(&سالب);
    إذا (!هويته(&ف5, «سالب_لطبيعي»)) { أرجع 7; };
    ليكن رسالة4: نص = رسالة_فشل(&ف4);
    ليكن متوقع4: نص = «العدد خارج مدى النوع»;
    إذا (!نصان_متساويان(&رسالة4, &متوقع4)) { أرجع 8; };

    // A real parse failure.
    ليكن النص: نص = «12x4»;
    طابق حلل_عدد(&النص) مع
    | نتيجة.نجح(_) -> { أرجع 9; }
    | نتيجة.خطأ(الخطأ) -> {
        ليكن الفشل: فشل = فشل_من_خطأ_تحليل_عدد(&الخطأ);
        إذا (!هويته(&الفشل, «رقم_غير_صالح»)) { أرجع 10; };
        ليكن الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
        ليكن متوقع: نص = «موضع البايت: 2»;
        إذا (!نصان_متساويان(&الملاحظات[0], &متوقع)) { أرجع 11; };
    };
    أرجع 42;
}
