// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// std.error ownership: 10^5 errors with causes and notes, built, read
// through every accessor, copied, rendered and dropped. The allocator's live
// bytes after the loop equal those before it, so memory stays flat.
// Counterpart: tests/en/stdlib/error/rss_flat.sn. It has no pair directive:
// the pair check interprets both files, the interpreter takes minutes for
// this loop, and it does not use the std allocator whose counters this reads.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.أخطاء.من_عدد;
استورد المكتبة.نصوص.أعداد;
استورد المكتبة.نظام_التشغيل.تخصيص;

عرف اصنع_سلسلة(ف: طبيعي): فشل {
    ليكن الجذر: فشل = فشل_بهوية(«std.fs», «غير_موجود», «الملف غير موجود»);
    ليكن الوسط: متغير فشل = فشل_بهوية_وسبب(«config», «غير_محمل», «تعذر تحميل الإعدادات», الجذر);
    أضف_ملاحظة(&متغير الوسط, طبيعي_إلى_نص(ف));
    ليكن الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_ملاحظة(&متغير الأعلى, «ملاحظة ثابتة»);
    أرجع الأعلى;
}

عرف استعمل_سلسلة(الفشل: &فشل): منطقي {
    ليكن النطاق: نص = «std.fs»;
    ليكن النوع: نص = «غير_موجود»;
    ليكن موجود: منطقي = هل_من_نوع(الفشل, &النطاق, &النوع);
    ليكن الرسالة: نص = رسالة_فشل(الفشل);
    ليكن نطاقه: نص = نطاق_فشل(الفشل);
    ليكن نوعه: نص = نوع_فشل(الفشل);
    ليكن الملاحظات: متجه نص = ملاحظات_فشل(الفشل);
    ليكن السبب: اختياري فشل = سبب_فشل(الفشل);
    ليكن الوصف: نص = صف_فشل(الفشل);
    ليكن نسخة: فشل = انسخ_فشل(الفشل);
    ليكن نسخة_مولدة: فشل = استنسخ(الفشل);
    أرجع موجود && له_سبب(&نسخة) && له_سبب(&نسخة_مولدة);
}

عرف الرئيسية(): عدد {
    // Warm up once so lazily created allocator state is not counted.
    ليكن تمهيد: فشل = اصنع_سلسلة(0);
    إذا (!استعمل_سلسلة(&تمهيد)) { أرجع 1; };
    ليكن خطأ_تمهيد: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(0);
    ليكن فشل_تمهيد: فشل = فشل_من_خطأ_تحليل_عدد(&خطأ_تمهيد);

    ليكن قبل: ط64 = بايتات_حية_مخصص_النظام();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 100000) {
        ليكن السلسلة: فشل = اصنع_سلسلة(ف);
        إذا (!استعمل_سلسلة(&السلسلة)) { أرجع 2; };
        ليكن الخطأ: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(ف);
        ليكن المحول: فشل = فشل_من_خطأ_تحليل_عدد(&الخطأ);
        ليكن المغلف: فشل = فشل_بسبب(«تعذر قراءة المنفذ», المحول);
        ف := ف + 1;
    }
    ليكن بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
