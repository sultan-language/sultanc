// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// std.error ownership: 10^5 errors with causes and notes, built, read
// through every accessor, copied, rendered and dropped. The allocator's live
// bytes after the loop equal those before it, so memory stays flat.
// Counterpart: tests/en/stdlib/error/rss_flat.sn. It has no pair directive:
// the pair check interprets both files, the interpreter takes minutes for
// this loop, and it does not use the std allocator whose counters this reads.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_number;
استورد المكتبة.نصوص.number;
استورد std.os.allocation;

عرف اصنع_سلسلة(ف: طبيعي): فشل {
    دع الجذر: فشل = فشل_بهوية(«std.fs», «غير_موجود», «الملف غير موجود»);
    دع الوسط: متغير فشل = فشل_بهوية_وسبب(«config», «غير_محمل», «تعذر تحميل الإعدادات», الجذر);
    أضف_ملاحظة(&متغير الوسط, طبيعي_إلى_نص(ف));
    دع الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_ملاحظة(&متغير الأعلى, «ملاحظة ثابتة»);
    أرجع الأعلى;
}

عرف استعمل_سلسلة(الفشل: &فشل): منطقي {
    دع النطاق: نص = «std.fs»;
    دع النوع: نص = «غير_موجود»;
    دع موجود: منطقي = هل_من_نوع(الفشل, &النطاق, &النوع);
    دع الرسالة: نص = رسالة_فشل(الفشل);
    دع نطاقه: نص = نطاق_فشل(الفشل);
    دع نوعه: نص = نوع_فشل(الفشل);
    دع الملاحظات: متجه نص = ملاحظات_فشل(الفشل);
    دع السبب: اختياري فشل = سبب_فشل(الفشل);
    دع الوصف: نص = صف_فشل(الفشل);
    دع نسخة: فشل = انسخ_فشل(الفشل);
    دع نسخة_مولدة: فشل = استنسخ(الفشل);
    أرجع موجود && له_سبب(&نسخة) && له_سبب(&نسخة_مولدة);
}

عرف الرئيسية(): عدد {
    // Warm up once so lazily created allocator state is not counted.
    دع تمهيد: فشل = اصنع_سلسلة(0);
    إذا (!استعمل_سلسلة(&تمهيد)) { أرجع 1; };
    دع خطأ_تمهيد: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(0);
    دع فشل_تمهيد: فشل = فشل_من_خطأ_تحليل_عدد(&خطأ_تمهيد);

    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع ف: متغير طبيعي = 0;
    طالما (ف < 100000) {
        دع السلسلة: فشل = اصنع_سلسلة(ف);
        إذا (!استعمل_سلسلة(&السلسلة)) { أرجع 2; };
        دع الخطأ: خطأ_تحليل_عدد = خطأ_تحليل_عدد.رقم_غير_صالح(ف);
        دع المحول: فشل = فشل_من_خطأ_تحليل_عدد(&الخطأ);
        دع المغلف: فشل = فشل_بسبب(«تعذر قراءة المنفذ», المحول);
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    إذا (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
