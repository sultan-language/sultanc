// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/describe.sn
// std.error: the exact text of صف_فشل: the message, its notes, then one
// «بسبب: » line per cause followed by that cause's notes.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.compare;
استورد المكتبة.دخ.println;

عرف الرئيسية(): عدد {
    دع وحيد: فشل = فشل_من(«رسالة وحيدة»);
    دع نص_وحيد: نص = صف_فشل(&وحيد);
    دع متوقع_وحيد: نص = «رسالة وحيدة»;
    إذا (!نصان_متساويان(&نص_وحيد, &متوقع_وحيد)) { أرجع 1; };

    دع الجذر: متغير فشل = فشل_بهوية(«config», «فارغ», «ملف الإعدادات فارغ»);
    أضف_ملاحظة(&متغير الجذر, «الحجم 0 بايت»);
    دع الوسط: فشل = فشل_بسبب(«تعذر قراءة الإعدادات», الجذر);
    دع الأعلى: متغير فشل = فشل_بسبب(«أثناء بدء الخادم», الوسط);
    أضف_ملاحظة(&متغير الأعلى, «مسار الإعدادات من SULTANC_CONFIG»);
    أضف_ملاحظة(&متغير الأعلى, «المنفذ 8080»);

    دع الوصف: نص = صف_فشل(&الأعلى);
    دع المتوقع: نص = "أثناء بدء الخادم\nملاحظة: مسار الإعدادات من SULTANC_CONFIG\nملاحظة: المنفذ 8080\nبسبب: تعذر قراءة الإعدادات\nبسبب: ملف الإعدادات فارغ\nملاحظة: الحجم 0 بايت";
    إذا (!نصان_متساويان(&الوصف, &المتوقع)) { أرجع 2; };

    // The same text on standard output; native and interpreter must agree.
    دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(صف_فشل(&الأعلى));
    أرجع 42;
}
