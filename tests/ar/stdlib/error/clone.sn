// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/clone.sn
// std.error: استنسخ and انسخ_فشل give independent deep copies, causes and
// notes included.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.compare;

عرف الرئيسية(): عدد {
    دع الجذر: فشل = فشل_بهوية(«std.fs», «غير_موجود», «الملف غير موجود»);
    دع الأصل: متغير فشل = فشل_بسبب(«تعذر القراءة», الجذر);
    أضف_ملاحظة(&متغير الأصل, «ملاحظة»);
    دع وصف_الأصل: نص = صف_فشل(&الأصل);
    دع النطاق: نص = «std.fs»;
    دع النوع: نص = «غير_موجود»;

    دع نسخة: متغير فشل = استنسخ(&الأصل);
    دع وصف_النسخة: نص = صف_فشل(&نسخة);
    إذا (!نصان_متساويان(&وصف_الأصل, &وصف_النسخة)) { أرجع 1; };
    إذا (!هل_من_نوع(&نسخة, &النطاق, &النوع)) { أرجع 2; };

    دع نسخة_يدوية: متغير فشل = انسخ_فشل(&الأصل);
    دع وصف_اليدوية: نص = صف_فشل(&نسخة_يدوية);
    إذا (!نصان_متساويان(&وصف_الأصل, &وصف_اليدوية)) { أرجع 3; };
    إذا (!هل_من_نوع(&نسخة_يدوية, &النطاق, &النوع)) { أرجع 4; };

    // Changing a copy leaves the original unchanged.
    أضف_ملاحظة(&متغير نسخة, «في النسخة فقط»);
    أضف_ملاحظة(&متغير نسخة_يدوية, «في اليدوية فقط»);
    دع وصف_بعد: نص = صف_فشل(&الأصل);
    إذا (!نصان_متساويان(&وصف_الأصل, &وصف_بعد)) { أرجع 5; };
    دع ملاحظات_الأصل: متجه نص = ملاحظات_فشل(&الأصل);
    إذا ((الطول(ملاحظات_الأصل) مثل طبيعي) != 1) { أرجع 6; };
    دع ملاحظات_النسخة: متجه نص = ملاحظات_فشل(&نسخة);
    إذا ((الطول(ملاحظات_النسخة) مثل طبيعي) != 2) { أرجع 7; };

    // A copy outlives its original.
    دع باقية: فشل = انسخ_فشل(&نسخة);
    دع منقول: فشل = نسخة;
    دع وصف_الباقية: نص = صف_فشل(&باقية);
    دع وصف_المنقول: نص = صف_فشل(&منقول);
    إذا (!نصان_متساويان(&وصف_الباقية, &وصف_المنقول)) { أرجع 8; };
    أرجع 42;
}
