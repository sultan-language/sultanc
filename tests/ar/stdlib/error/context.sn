// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/context.sn
// std.error.context (docs/en/reference/errors.md): مع_سياق wraps an error as the cause of
// a new one, إلى_فشل converts a typed error with a converter function value,
// مع_ملاحظة adds a note; on success each moves an owning value (text, a
// vector) through unchanged. The exact صف_فشل text of the chain is checked.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.context;
استورد المكتبة.أخطاء.from_number;
استورد المكتبة.نصوص.number;
استورد المكتبة.نصوص.compare;
استورد المكتبة.دخ.println;

عرف اسم_أو_خطأ(صالح: منطقي): نتيجة نص, فشل {
    إذا (صالح) { أرجع نتيجة.نجح(«خادم»); };
    أرجع نتيجة.خطأ(فشل_بهوية(«config», «فارغ», «ملف الإعدادات فارغ»));
}

عرف قائمة_أو_خطأ(صالح: منطقي): نتيجة متجه نص, فشل {
    دع القائمة: متغير متجه نص = [];
    ألحق(القائمة, «أ»);
    ألحق(القائمة, «ب»);
    إذا (صالح) { أرجع نتيجة.نجح(القائمة); };
    أرجع نتيجة.خطأ(فشل_من(«لا قائمة»));
}

عرف المنفذ(النص: نص): نتيجة عدد, فشل {
    دع القيمة: عدد = إلى_فشل(حلل_عدد(&النص), فشل_من_خطأ_تحليل_عدد)؟;
    أرجع نتيجة.نجح(القيمة);
}

عرف الإعداد(صالح: منطقي): نتيجة نص, فشل {
    دع الاسم: نص = مع_ملاحظة(مع_سياق(اسم_أو_خطأ(صالح), «تعذر قراءة الإعدادات»), «المسار من SULTANC_CONFIG»)؟;
    أرجع نتيجة.نجح(الاسم);
}

عرف الرئيسية(): عدد {
    طابق الإعداد(صواب) مع
    | نتيجة.نجح(الاسم) -> {
        دع المتوقع: نص = «خادم»;
        إذا (!نصان_متساويان(&الاسم, &المتوقع)) { أرجع 1; };
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    طابق مع_سياق(قائمة_أو_خطأ(صواب), «سياق لا يستعمل») مع
    | نتيجة.نجح(القائمة) -> { إذا ((الطول(القائمة) مثل طبيعي) != 2) { أرجع 3; }; }
    | نتيجة.خطأ(_) -> { أرجع 4; };
    طابق مع_ملاحظة(قائمة_أو_خطأ(خطأ), «ملاحظة») مع
    | نتيجة.نجح(_) -> { أرجع 5; }
    | نتيجة.خطأ(الفشل) -> {
        دع الوصف: نص = صف_فشل(&الفشل);
        دع المتوقع: نص = "لا قائمة\nملاحظة: ملاحظة";
        إذا (!نصان_متساويان(&الوصف, &المتوقع)) { أرجع 6; };
    };
    طابق الإعداد(خطأ) مع
    | نتيجة.نجح(_) -> { أرجع 7; }
    | نتيجة.خطأ(الفشل) -> {
        دع الوصف: نص = صف_فشل(&الفشل);
        دع المتوقع: نص = "تعذر قراءة الإعدادات\nملاحظة: المسار من SULTANC_CONFIG\nبسبب: ملف الإعدادات فارغ";
        إذا (!نصان_متساويان(&الوصف, &المتوقع)) { أرجع 8; };
        دع النطاق: نص = «config»;
        دع النوع: نص = «فارغ»;
        إذا (!هل_من_نوع(&الفشل, &النطاق, &النوع)) { أرجع 9; };
        دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(الوصف);
    };
    طابق المنفذ(«8x») مع
    | نتيجة.نجح(_) -> { أرجع 10; }
    | نتيجة.خطأ(الفشل) -> {
        دع النطاق: نص = «std.text.number»;
        دع النوع: نص = «رقم_غير_صالح»;
        إذا (!هل_من_نوع(&الفشل, &النطاق, &النوع)) { أرجع 11; };
    };
    طابق المنفذ(«8080») مع
    | نتيجة.نجح(القيمة) -> { إذا (القيمة != 8080) { أرجع 12; }; }
    | نتيجة.خطأ(_) -> { أرجع 13; };
    أرجع 42;
}
