// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/notes_order.sn
// std.error: notes keep the order they were added in, and adding a note
// changes neither the identity nor the message.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.compare;

عرف الرئيسية(): عدد {
    دع الفشل: متغير فشل = فشل_بهوية(«config», «فارغ», «ملف الإعدادات فارغ»);
    أضف_ملاحظة(&متغير الفشل, «الأولى»);
    أضف_ملاحظة(&متغير الفشل, «الثانية»);
    أضف_ملاحظة(&متغير الفشل, «الثالثة»);

    دع الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
    إذا ((الطول(الملاحظات) مثل طبيعي) != 3) { أرجع 1; };
    دع أولى: نص = «الأولى»;
    دع ثانية: نص = «الثانية»;
    دع ثالثة: نص = «الثالثة»;
    إذا (!نصان_متساويان(&الملاحظات[0], &أولى)) { أرجع 2; };
    إذا (!نصان_متساويان(&الملاحظات[1], &ثانية)) { أرجع 3; };
    إذا (!نصان_متساويان(&الملاحظات[2], &ثالثة)) { أرجع 4; };

    دع الرسالة: نص = رسالة_فشل(&الفشل);
    دع متوقع_الرسالة: نص = «ملف الإعدادات فارغ»;
    إذا (!نصان_متساويان(&الرسالة, &متوقع_الرسالة)) { أرجع 5; };
    دع النطاق: نص = «config»;
    دع النوع: نص = «فارغ»;
    إذا (!هل_من_نوع(&الفشل, &النطاق, &النوع)) { أرجع 6; };

    // The notes accessor returns a copy: changing the error later does not
    // change a copy taken before.
    أضف_ملاحظة(&متغير الفشل, «الرابعة»);
    إذا ((الطول(الملاحظات) مثل طبيعي) != 3) { أرجع 7; };
    دع بعد_الإضافة: متجه نص = ملاحظات_فشل(&الفشل);
    إذا ((الطول(بعد_الإضافة) مثل طبيعي) != 4) { أرجع 8; };

    // A wrapped error keeps its own notes.
    دع المغلف: متغير فشل = فشل_بسبب(«تعذر البدء», الفشل);
    أضف_ملاحظة(&متغير المغلف, «ملاحظة الغلاف»);
    دع ملاحظات_المغلف: متجه نص = ملاحظات_فشل(&المغلف);
    إذا ((الطول(ملاحظات_المغلف) مثل طبيعي) != 1) { أرجع 9; };
    طابق سبب_فشل(&المغلف) مع
    | اختياري.لا_شيء -> { أرجع 10; }
    | اختياري.موجود(السبب) -> {
        دع ملاحظات_السبب: متجه نص = ملاحظات_فشل(&السبب);
        إذا ((الطول(ملاحظات_السبب) مثل طبيعي) != 4) { أرجع 11; };
    };
    أرجع 42;
}
