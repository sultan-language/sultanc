// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/constructors_accessors.sn
// std.error: every constructor and accessor.
استورد المكتبة.أخطاء.فشل;
استورد المكتبة.نصوص.مقارنة;

عرف الرئيسية(): عدد {
    ليكن فارغ: نص = «»;

    ليكن عرضي: فشل = فشل_من(«تعذر الاتصال»);
    ليكن رسالة_عرضي: نص = رسالة_فشل(&عرضي);
    ليكن متوقع_عرضي: نص = «تعذر الاتصال»;
    إذا (!نصان_متساويان(&رسالة_عرضي, &متوقع_عرضي)) { أرجع 1; };
    ليكن نطاق_عرضي: نص = نطاق_فشل(&عرضي);
    إذا (!نصان_متساويان(&نطاق_عرضي, &فارغ)) { أرجع 2; };
    ليكن نوع_عرضي: نص = نوع_فشل(&عرضي);
    إذا (!نصان_متساويان(&نوع_عرضي, &فارغ)) { أرجع 3; };
    إذا (له_سبب(&عرضي)) { أرجع 4; };
    ليكن ملاحظات_عرضي: متجه نص = ملاحظات_فشل(&عرضي);
    إذا ((الطول(ملاحظات_عرضي) مثل طبيعي) != 0) { أرجع 5; };

    ليكن مهوي: فشل = فشل_بهوية(«payments», «رصيد_غير_كاف», «الرصيد غير كاف»);
    ليكن نطاق_مهوي: نص = نطاق_فشل(&مهوي);
    ليكن متوقع_النطاق: نص = «payments»;
    إذا (!نصان_متساويان(&نطاق_مهوي, &متوقع_النطاق)) { أرجع 6; };
    ليكن نوع_مهوي: نص = نوع_فشل(&مهوي);
    ليكن متوقع_النوع: نص = «رصيد_غير_كاف»;
    إذا (!نصان_متساويان(&نوع_مهوي, &متوقع_النوع)) { أرجع 7; };
    ليكن رسالة_مهوي: نص = رسالة_فشل(&مهوي);
    ليكن متوقع_رسالة_مهوي: نص = «الرصيد غير كاف»;
    إذا (!نصان_متساويان(&رسالة_مهوي, &متوقع_رسالة_مهوي)) { أرجع 8; };
    إذا (له_سبب(&مهوي)) { أرجع 9; };

    ليكن مغلف: فشل = فشل_بسبب(«تعذر إتمام الدفع», مهوي);
    إذا (!له_سبب(&مغلف)) { أرجع 10; };
    ليكن نطاق_مغلف: نص = نطاق_فشل(&مغلف);
    إذا (!نصان_متساويان(&نطاق_مغلف, &فارغ)) { أرجع 11; };
    ليكن رسالة_مغلف: نص = رسالة_فشل(&مغلف);
    ليكن متوقع_رسالة_مغلف: نص = «تعذر إتمام الدفع»;
    إذا (!نصان_متساويان(&رسالة_مغلف, &متوقع_رسالة_مغلف)) { أرجع 12; };
    طابق سبب_فشل(&مغلف) مع
    | اختياري.لا_شيء -> { أرجع 13; }
    | اختياري.موجود(السبب) -> {
        ليكن نوع_السبب: نص = نوع_فشل(&السبب);
        إذا (!نصان_متساويان(&نوع_السبب, &متوقع_النوع)) { أرجع 14; };
        ليكن رسالة_السبب: نص = رسالة_فشل(&السبب);
        إذا (!نصان_متساويان(&رسالة_السبب, &متوقع_رسالة_مهوي)) { أرجع 15; };
        إذا (له_سبب(&السبب)) { أرجع 16; };
    };
    طابق سبب_فشل(&عرضي) مع
    | اختياري.موجود(_) -> { أرجع 17; }
    | اختياري.لا_شيء -> { };

    ليكن أصل: فشل = فشل_من(«انقطع الاتصال»);
    ليكن مهوي_مغلف: فشل = فشل_بهوية_وسبب(«payments», «بوابة_معطلة», «بوابة الدفع لا تستجيب», أصل);
    ليكن نوع_مهوي_مغلف: نص = نوع_فشل(&مهوي_مغلف);
    ليكن متوقع_بوابة: نص = «بوابة_معطلة»;
    إذا (!نصان_متساويان(&نوع_مهوي_مغلف, &متوقع_بوابة)) { أرجع 18; };
    ليكن نطاق_مهوي_مغلف: نص = نطاق_فشل(&مهوي_مغلف);
    إذا (!نصان_متساويان(&نطاق_مهوي_مغلف, &متوقع_النطاق)) { أرجع 19; };
    طابق سبب_فشل(&مهوي_مغلف) مع
    | اختياري.لا_شيء -> { أرجع 20; }
    | اختياري.موجود(السبب) -> {
        ليكن رسالة_الأصل: نص = رسالة_فشل(&السبب);
        ليكن متوقع_الأصل: نص = «انقطع الاتصال»;
        إذا (!نصان_متساويان(&رسالة_الأصل, &متوقع_الأصل)) { أرجع 21; };
    };
    أرجع 42;
}
