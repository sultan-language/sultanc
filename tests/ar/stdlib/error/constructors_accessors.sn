// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/error/constructors_accessors.sn
// std.error: every constructor and accessor.
استورد المكتبة.أخطاء.failure;
استورد المكتبة.نصوص.compare;

عرف الرئيسية(): عدد {
    دع فارغ: نص = «»;

    دع عرضي: فشل = فشل_من(«تعذر الاتصال»);
    دع رسالة_عرضي: نص = رسالة_فشل(&عرضي);
    دع متوقع_عرضي: نص = «تعذر الاتصال»;
    إذا (!نصان_متساويان(&رسالة_عرضي, &متوقع_عرضي)) { أرجع 1; };
    دع نطاق_عرضي: نص = نطاق_فشل(&عرضي);
    إذا (!نصان_متساويان(&نطاق_عرضي, &فارغ)) { أرجع 2; };
    دع نوع_عرضي: نص = نوع_فشل(&عرضي);
    إذا (!نصان_متساويان(&نوع_عرضي, &فارغ)) { أرجع 3; };
    إذا (له_سبب(&عرضي)) { أرجع 4; };
    دع ملاحظات_عرضي: متجه نص = ملاحظات_فشل(&عرضي);
    إذا ((الطول(ملاحظات_عرضي) مثل طبيعي) != 0) { أرجع 5; };

    دع مهوي: فشل = فشل_بهوية(«payments», «رصيد_غير_كاف», «الرصيد غير كاف»);
    دع نطاق_مهوي: نص = نطاق_فشل(&مهوي);
    دع متوقع_النطاق: نص = «payments»;
    إذا (!نصان_متساويان(&نطاق_مهوي, &متوقع_النطاق)) { أرجع 6; };
    دع نوع_مهوي: نص = نوع_فشل(&مهوي);
    دع متوقع_النوع: نص = «رصيد_غير_كاف»;
    إذا (!نصان_متساويان(&نوع_مهوي, &متوقع_النوع)) { أرجع 7; };
    دع رسالة_مهوي: نص = رسالة_فشل(&مهوي);
    دع متوقع_رسالة_مهوي: نص = «الرصيد غير كاف»;
    إذا (!نصان_متساويان(&رسالة_مهوي, &متوقع_رسالة_مهوي)) { أرجع 8; };
    إذا (له_سبب(&مهوي)) { أرجع 9; };

    دع مغلف: فشل = فشل_بسبب(«تعذر إتمام الدفع», مهوي);
    إذا (!له_سبب(&مغلف)) { أرجع 10; };
    دع نطاق_مغلف: نص = نطاق_فشل(&مغلف);
    إذا (!نصان_متساويان(&نطاق_مغلف, &فارغ)) { أرجع 11; };
    دع رسالة_مغلف: نص = رسالة_فشل(&مغلف);
    دع متوقع_رسالة_مغلف: نص = «تعذر إتمام الدفع»;
    إذا (!نصان_متساويان(&رسالة_مغلف, &متوقع_رسالة_مغلف)) { أرجع 12; };
    طابق سبب_فشل(&مغلف) مع
    | اختياري.لا_شيء -> { أرجع 13; }
    | اختياري.موجود(السبب) -> {
        دع نوع_السبب: نص = نوع_فشل(&السبب);
        إذا (!نصان_متساويان(&نوع_السبب, &متوقع_النوع)) { أرجع 14; };
        دع رسالة_السبب: نص = رسالة_فشل(&السبب);
        إذا (!نصان_متساويان(&رسالة_السبب, &متوقع_رسالة_مهوي)) { أرجع 15; };
        إذا (له_سبب(&السبب)) { أرجع 16; };
    };
    طابق سبب_فشل(&عرضي) مع
    | اختياري.موجود(_) -> { أرجع 17; }
    | اختياري.لا_شيء -> { };

    دع أصل: فشل = فشل_من(«انقطع الاتصال»);
    دع مهوي_مغلف: فشل = فشل_بهوية_وسبب(«payments», «بوابة_معطلة», «بوابة الدفع لا تستجيب», أصل);
    دع نوع_مهوي_مغلف: نص = نوع_فشل(&مهوي_مغلف);
    دع متوقع_بوابة: نص = «بوابة_معطلة»;
    إذا (!نصان_متساويان(&نوع_مهوي_مغلف, &متوقع_بوابة)) { أرجع 18; };
    دع نطاق_مهوي_مغلف: نص = نطاق_فشل(&مهوي_مغلف);
    إذا (!نصان_متساويان(&نطاق_مهوي_مغلف, &متوقع_النطاق)) { أرجع 19; };
    طابق سبب_فشل(&مهوي_مغلف) مع
    | اختياري.لا_شيء -> { أرجع 20; }
    | اختياري.موجود(السبب) -> {
        دع رسالة_الأصل: نص = رسالة_فشل(&السبب);
        دع متوقع_الأصل: نص = «انقطع الاتصال»;
        إذا (!نصان_متساويان(&رسالة_الأصل, &متوقع_الأصل)) { أرجع 21; };
    };
    أرجع 42;
}
