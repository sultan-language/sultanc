// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_missing_argument.sn
// خرج-تشخيص-عربي: reject_format_missing_argument.ar.txt
// يشير القالب إلى وسيط ثان لا يمرره النداء.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الاسم: نص = «سلطان»;
    طابق نسق(«{} {}», [قيمة_تنسيق.نص(&الاسم)]) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
