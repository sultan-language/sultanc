// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_named_argument.sn
// وسيط مسمى؛ يشير المكتبة.تنسيق إلى الوسائط بمواضعها.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الاسم: نص = «سلطان»;
    طابق نسق(«{الاسم}», [قيمة_تنسيق.نص(&الاسم)]) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
