// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_let_bound_syntax.sn
// مع وسائط مربوطة بـ`دع` يرفض فحص وقت الترجمة قالبا صياغته خاطئة: قوس `}` منفرد.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع واحد: متجه قيمة_تنسيق = [قيمة_تنسيق.عدد(1)];
    طابق نسق(«a } {}», واحد) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
