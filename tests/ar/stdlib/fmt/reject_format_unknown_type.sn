// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_unknown_type.sn
// يذكر الموضع نوع تنسيق غير معروف.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الاسم: نص = «سلطان»;
    طابق نسق(«{:q}», [قيمة_تنسيق.نص(&الاسم)]) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
