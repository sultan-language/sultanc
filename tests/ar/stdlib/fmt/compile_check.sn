// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/fmt/compile_check.sn
// يفحص قالب التنسيق الحرفي مقابل وسائطه وقت الترجمة كما يفعل format! في Rust
// (docs/en/reference/formatting.md)؛ وتمرر الوسائط في نداء واحد حرفيَّ متجه. الوسائط التي ليست
// نداءات منشئ تعد ولا يفحص نوعها، ومتجه الوسائط المربوط بـ`دع` يترك لفحص وقت
// الترجمة صياغة القالب وحدها، والقالب المبني وقت التشغيل يبقى له فحص التشغيل.
استورد المكتبة.تنسيق.fmt;
استورد std.text.compare;

عرف يطابق(ر: نتيجة نص, خطأ_تنسيق, المطلوب: نص): عدد {
    طابق ر مع
    | نتيجة.نجح(الناتج) -> { إذا (نصان_متساويان(&الناتج, &المطلوب)) { أرجع 0; }; أرجع 1; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}

عرف خاطئ(ر: نتيجة نص, خطأ_تنسيق): عدد {
    طابق ر مع
    | نتيجة.نجح(_) -> { أرجع 1; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    دع الاسم: نص = «Sultan»;
    دع الأعداد: متجه عدد = [1, 2];
    الإخفاقات := الإخفاقات + يطابق(نسق(«{} {:>4}|{:x}», [قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.عدد(42), قيمة_تنسيق.ط8(255)]), «Sultan   42|ff»);
    الإخفاقات := الإخفاقات + يطابق(نسق(«{1} {0} {{}}», [قيمة_تنسيق.عدد(1), قيمة_تنسيق.منطقي(صواب)]), «true 1 {}»);
    الإخفاقات := الإخفاقات + يطابق(نسق(«[{0:>1$}] {3:.2$}», [قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.طبيعي(8), قيمة_تنسيق.طبيعي(2), قيمة_تنسيق.ع64(3.14159)]), «[  Sultan] 3.14»);
    الإخفاقات := الإخفاقات + يطابق(نسق(«{:?}», [قيمة_تنسيق.أعداد(&الأعداد)]), «[1, 2]»);
    الإخفاقات := الإخفاقات + يطابق(نسق(«بلا وسائط», []), «بلا وسائط»);

    // عنصر ليس نداء منشئ: يعد ولا يفحص نوعه.
    دع أ: قيمة_تنسيق = قيمة_تنسيق.عدد(7);
    الإخفاقات := الإخفاقات + يطابق(نسق(«{:#x}», [أ]), «0x7»);

    // وسائط مربوطة بـ`دع`: تفحص صياغة القالب وقت الترجمة، والوسائط وقت التشغيل.
    دع اثنان: متجه قيمة_تنسيق = [قيمة_تنسيق.عدد(1), قيمة_تنسيق.عدد(2)];
    الإخفاقات := الإخفاقات + خاطئ(نسق(«{}», اثنان));

    // القالب المبني وقت التشغيل يفحص عند استعماله.
    دع القالب: نص = «{:x}»;
    الإخفاقات := الإخفاقات + خاطئ(نسق(القالب, [قيمة_تنسيق.نص(&الاسم)]));

    إذا (الإخفاقات != 0) { أرجع الإخفاقات; };
    أرجع 42;
}
