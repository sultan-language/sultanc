// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/fmt/errors.sn
// أخطاء المكتبة.تنسيق: قوالب تنسيق مشوهة (يرفض Rust كلا منها وقت الترجمة؛
// وتبلغ عنها المكتبة وقت التشغيل مع موضع البايت)، ووسائط مفقودة أو غير
// مستخدمة أو من نوع غير مناسب، ووسائط عرض ودقة غير صالحة، ومنسق مخصص يفشل،
// وبقاء المنسق كما كان بعد الخطأ. وتحول المكتبة.أخطاء الخطأ إلى فشل بهويته
// ونسخته الإنجليزية وملاحظته.
استورد المكتبة.تنسيق.fmt;
استورد المكتبة.أخطاء.failure;
استورد المكتبة.أخطاء.from_fmt;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.language;
استورد std.math.float;

// الخطأ بصيغة «<الصنف> <الحمولة>»، أو «سليم».
عرف صف(القالب: نص, الوسائط: متجه قيمة_تنسيق): نص {
    طابق نسق(القالب, الوسائط) مع
    | نتيجة.نجح(_) -> { أرجع «سليم»; }
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_تنسيق.قوس_غير_مغلق(م) -> { أرجع زوج(«غير_مغلق», م); }
        | خطأ_تنسيق.قوس_إغلاق_منفرد(م) -> { أرجع زوج(«منفرد», م); }
        | خطأ_تنسيق.مواصفة_غير_صالحة(م) -> { أرجع زوج(«مواصفة», م); }
        | خطأ_تنسيق.نوع_غير_معروف(م) -> { أرجع زوج(«نوع», م); }
        | خطأ_تنسيق.وسيط_مسمى(م) -> { أرجع زوج(«مسمى», م); }
        | خطأ_تنسيق.وسيط_مفقود(ف) -> { أرجع زوج(«مفقود», ف); }
        | خطأ_تنسيق.وسيط_غير_مستخدم(ف) -> { أرجع زوج(«غير_مستخدم», ف); }
        | خطأ_تنسيق.نوع_غير_مناسب(ف) -> { أرجع زوج(«غير_مناسب», ف); }
        | خطأ_تنسيق.عدد_غير_صالح(ف) -> { أرجع زوج(«عدد», ف); }
        | خطأ_تنسيق.فشل_الكتابة(_) -> { أرجع «كتابة»; }
        | خطأ_تنسيق.فشل_مخصص -> { أرجع «مخصص»; };
    };
}

عرف زوج(الاسم: نص, العدد: طبيعي): نص {
    طابق نسق(«{} {}», [قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.طبيعي(العدد)]) مع
    | نتيجة.نجح(ن) -> { أرجع ن; }
    | نتيجة.خطأ(_) -> { أرجع «؟»; };
}

عرف توقع(القالب: نص, الوسائط: متجه قيمة_تنسيق, المطلوب: نص): عدد {
    دع الناتج: نص = صف(القالب, الوسائط);
    لو (نصان_متساويان(&الناتج, &المطلوب)) { أرجع 0; };
    أرجع 1;
}

عرف منسق_فاشل(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    دع ن: نص = «جزئي»;
    دع ر: نتيجة طبيعي, خطأ_تنسيق = اكتب_نصا_في_المنسق(م, &ن);
    أرجع نتيجة.خطأ(خطأ_تنسيق.فشل_مخصص());
}

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    دع كلمة: نص = «ك»;
    دع أعداد: متجه عدد = [1, 2];

    الإخفاقات := الإخفاقات + توقع("{", [], «غير_مغلق 0»);
    الإخفاقات := الإخفاقات + توقع("abc{", [], «غير_مغلق 3»);
    الإخفاقات := الإخفاقات + توقع("{:>8", [قيمة_تنسيق.عدد(1)], «غير_مغلق 0»);
    الإخفاقات := الإخفاقات + توقع("x{0", [قيمة_تنسيق.عدد(1)], «غير_مغلق 1»);
    الإخفاقات := الإخفاقات + توقع("}", [], «منفرد 0»);
    الإخفاقات := الإخفاقات + توقع("a}b", [], «منفرد 1»);
    الإخفاقات := الإخفاقات + توقع("{}}", [قيمة_تنسيق.عدد(1)], «منفرد 2»);
    الإخفاقات := الإخفاقات + توقع("{0x}", [قيمة_تنسيق.عدد(1)], «مواصفة 2»);
    الإخفاقات := الإخفاقات + توقع("{:q}", [قيمة_تنسيق.عدد(1)], «نوع 2»);
    الإخفاقات := الإخفاقات + توقع("{:xx}", [قيمة_تنسيق.عدد(1)], «نوع 3»);
    الإخفاقات := الإخفاقات + توقع("{:p}", [قيمة_تنسيق.عدد(1)], «نوع 2»);
    الإخفاقات := الإخفاقات + توقع("{name}", [], «مسمى 1»);
    الإخفاقات := الإخفاقات + توقع("{:width$}", [قيمة_تنسيق.عدد(1)], «مسمى 2»);
    الإخفاقات := الإخفاقات + توقع("{:.p$}", [قيمة_تنسيق.عدد(1)], «مسمى 3»);
    الإخفاقات := الإخفاقات + توقع("{:.}", [قيمة_تنسيق.عدد(1)], «مواصفة 3»);
    الإخفاقات := الإخفاقات + توقع("{:.x}", [قيمة_تنسيق.عدد(1)], «مواصفة 3»);
    الإخفاقات := الإخفاقات + توقع("{:70000}", [قيمة_تنسيق.عدد(1)], «مواصفة 6»);
    الإخفاقات := الإخفاقات + توقع("{:<<<}", [قيمة_تنسيق.عدد(1)], «مواصفة 4»);
    الإخفاقات := الإخفاقات + توقع("{} {}", [قيمة_تنسيق.عدد(1)], «مفقود 1»);
    الإخفاقات := الإخفاقات + توقع("{2}", [قيمة_تنسيق.عدد(1)], «مفقود 2»);
    الإخفاقات := الإخفاقات + توقع("{}", [قيمة_تنسيق.عدد(1), قيمة_تنسيق.عدد(2)], «غير_مستخدم 1»);
    الإخفاقات := الإخفاقات + توقع("{1}", [قيمة_تنسيق.عدد(1), قيمة_تنسيق.عدد(2)], «غير_مستخدم 0»);
    الإخفاقات := الإخفاقات + توقع("{:x}", [قيمة_تنسيق.نص(&كلمة)], «غير_مناسب 0»);
    الإخفاقات := الإخفاقات + توقع("{:e}", [قيمة_تنسيق.منطقي(صواب)], «غير_مناسب 0»);
    الإخفاقات := الإخفاقات + توقع("{}", [قيمة_تنسيق.أعداد(&أعداد)], «غير_مناسب 0»);
    الإخفاقات := الإخفاقات + توقع("{:b}", [قيمة_تنسيق.ع64(ع64_من_بتات(4607182418800017408))], «غير_مناسب 0»);
    الإخفاقات := الإخفاقات + توقع("{:1$}", [قيمة_تنسيق.نص(&كلمة), قيمة_تنسيق.نص(&كلمة)], «عدد 1»);
    الإخفاقات := الإخفاقات + توقع("{:.*}", [قيمة_تنسيق.عدد(-1), قيمة_تنسيق.ع64(ع64_من_بتات(4607182418800017408))], «عدد 0»);
    الإخفاقات := الإخفاقات + توقع("{:1$}", [قيمة_تنسيق.عدد(1), قيمة_تنسيق.طبيعي(70000)], «عدد 1»);
    الإخفاقات := الإخفاقات + توقع("{:1$}", [قيمة_تنسيق.نص(&كلمة)], «مفقود 1»);
    الإخفاقات := الإخفاقات + توقع("{:.*}", [], «مفقود 0»);
    الإخفاقات := الإخفاقات + توقع("{{}}", [], «سليم»);

    // ينتشر خطأ المنسق المخصص، ويسقط ما كتبه.
    دع مخصص: قيمة_تنسيق = قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> منسق_فاشل(م));
    الإخفاقات := الإخفاقات + توقع("[{}]", [مخصص], «مخصص»);
    دع الناتج: متغير منسق = أنشئ_منسقا();
    دع البداية: نص = «abc»;
    دع ك: نتيجة طبيعي, خطأ_تنسيق = اكتب_نصا_في_المنسق(&متغير الناتج, &البداية);
    طابق نسق_في(&متغير الناتج, «x{}y», [مخصص]) مع
    | نتيجة.نجح(_) -> { الإخفاقات := الإخفاقات + 1; }
    | نتيجة.خطأ(_) -> { };
    // قالب التنسيق غير الحرفي يفحص وقت التشغيل.
    دع المكسور: نص = "x{}y{";
    طابق نسق_في(&متغير الناتج, المكسور, [قيمة_تنسيق.عدد(1)]) مع
    | نتيجة.نجح(_) -> { الإخفاقات := الإخفاقات + 1; }
    | نتيجة.خطأ(_) -> { };
    دع الباقي: نص = نص_المنسق(&الناتج);
    لو (!نصان_متساويان(&الباقي, &البداية)) { الإخفاقات := الإخفاقات + 1; };

    // التحويل إلى فشل.
    دع خ: خطأ_تنسيق = خطأ_تنسيق.قوس_غير_مغلق(3);
    دع الفشل: فشل = فشل_من_خطأ_تنسيق(&خ);
    دع النطاق: نص = نطاق_فشل(&الفشل);
    دع النوع: نص = نوع_فشل(&الفشل);
    دع النطاق_المطلوب: نص = «std.fmt»;
    دع النوع_المطلوب: نص = «قوس_غير_مغلق»;
    لو (!نصان_متساويان(&النطاق, &النطاق_المطلوب)) { الإخفاقات := الإخفاقات + 1; };
    لو (!نصان_متساويان(&النوع, &النوع_المطلوب)) { الإخفاقات := الإخفاقات + 1; };
    دع الملاحظات: متجه نص = ملاحظات_فشل(&الفشل);
    دع الملاحظة_المطلوبة: نص = «موضع البايت: 3»;
    لو (الطول(الملاحظات) != 1) { الإخفاقات := الإخفاقات + 1; }
    وإلا لو (!نصان_متساويان(&الملاحظات[0], &الملاحظة_المطلوبة)) { الإخفاقات := الإخفاقات + 1; };
    دع الوسم: نص = «en»;
    دع الإنجليزية: لغة = لغة_من_وسم(&الوسم);
    دع بالإنجليزية: نص = نص_فشل_بلغة(&الفشل, &الإنجليزية);
    دع الإنجليزية_المطلوبة: نص = «the format string has a { that is not closed»;
    لو (!نصان_متساويان(&بالإنجليزية, &الإنجليزية_المطلوبة)) { الإخفاقات := الإخفاقات + 1; };

    لو (الإخفاقات != 0) { أرجع 1; };
    أرجع 42;
}
