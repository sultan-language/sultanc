// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_invalid_count.sn
// العرض المأخوذ من وسيط يتطلب وسيطا صحيحا.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الاسم: نص = «سلطان»;
    طابق نسق(«{:1$}», [قيمة_تنسيق.عدد(1), قيمة_تنسيق.نص(&الاسم)]) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
