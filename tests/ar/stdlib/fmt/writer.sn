// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/fmt/writer.sn
// المكتبة.تنسيق إلى كاتب من المكتبة.دخ (write! على io::Write في Rust،
// وfmt.Fprintf في Go): أسطر تكتب إلى مقبض ملف عبر اكتب_منسقا، وبمنسق واحد
// يعاد استعماله عبر اكتب_منسقا_بمنسق، ثم تقرأ؛ وفشل الكاتب هو فشل_الكتابة
// برمز حالته، وخطأ التنسيق لا يكتب شيئا.
استورد المكتبة.تنسيق.fmt;
استورد المكتبة.ملفات.temporary;
استورد المكتبة.ملفات.handle;
استورد المكتبة.ملفات.read_file;
استورد المكتبة.ملفات.mutation;
استورد المكتبة.نصوص.compare;
استورد المكتبة.نصوص.from_bytes;

عرف ارفض(الوجهة: &عدد, البايتات: &متجه ط8, الإزاحة: عدد, العدد: عدد): نتيجة عدد, عدد {
    أرجع نتيجة.خطأ(-5);
}

عرف الرئيسية(): عدد {
    دع البادئة: نص = «sultanc-fmt-»;
    طابق أنشئ_ملفا_مؤقتا(&البادئة) مع
    | نتيجة.نجح(الملف) -> { أرجع شغل(الملف); }
    | نتيجة.خطأ(_) -> { أرجع 2; };
}

عرف شغل(الملف: ملف_مؤقت): عدد {
    دع الإخفاقات: متغير عدد = 0;
    دع الاسم: نص = «سلمى»;
    طابق اكتب_منسقا(&الملف.المقبض, اكتب_إلى_مقبض_ملف, "{:<6}|{:>3}\n", [قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.عدد(3)]) مع
    | نتيجة.نجح(ن) -> { إذا (ن != 15) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع المنسق_المعاد: متغير منسق = أنشئ_منسقا();
    دع ف: متغير عدد = 1;
    طالما (ف <= 3) {
        طابق اكتب_منسقا_بمنسق(&متغير المنسق_المعاد, &الملف.المقبض, اكتب_إلى_مقبض_ملف, "{}:{:03}:{:.2}\n", [قيمة_تنسيق.عدد(ف), قيمة_تنسيق.عدد(ف * ف), قيمة_تنسيق.ع64((ف مثل ع64) / 4.0)]) مع
        | نتيجة.نجح(ن) -> { إذا (ن != 11) { الإخفاقات := الإخفاقات + 1; }; }
        | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
        ف := ف + 1;
    }
    // خطأ التنسيق لا يكتب شيئا. وقالب التنسيق غير الحرفي يفحص وقت التشغيل.
    دع الناقص: نص = "{}\n";
    طابق اكتب_منسقا_بمنسق(&متغير المنسق_المعاد, &الملف.المقبض, اكتب_إلى_مقبض_ملف, الناقص, []) مع
    | نتيجة.نجح(_) -> { الإخفاقات := الإخفاقات + 1; }
    | نتيجة.خطأ(_) -> { };
    دع المسار: نص = انسخ_نص(&الملف.المسار);
    دع المغلق: نتيجة نص, عدد = أغلق_ملفا_مؤقتا(الملف);
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.نجح(النص) -> {
        دع المطلوب: نص = "سلمى  |  3\n1:001:0.25\n2:004:0.50\n3:009:0.75\n";
        إذا (!نصان_متساويان(&النص, &المطلوب)) { الإخفاقات := الإخفاقات + 1; };
    }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع المزال: نتيجة عدد, عدد = أزل_ملفا(&المسار);

    // كاتب يفشل.
    دع الوجهة: عدد = 0;
    طابق اكتب_منسقا(&الوجهة, ارفض, «{}», [قيمة_تنسيق.عدد(1)]) مع
    | نتيجة.نجح(_) -> { الإخفاقات := الإخفاقات + 1; }
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_تنسيق.فشل_الكتابة(الرمز) -> { إذا (الرمز != -5) { الإخفاقات := الإخفاقات + 1; }; }
        | _ -> { الإخفاقات := الإخفاقات + 1; };
    };

    إذا (الإخفاقات != 0) { أرجع 1; };
    أرجع 42;
}
