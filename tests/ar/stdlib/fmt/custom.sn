// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/en/stdlib/fmt/custom.sn
// المنسقات المخصصة في المكتبة.تنسيق، أي عرض أنواع المستخدم وتصحيحها: دالة
// مغلقة تكتب في المنسق بـ نسق_في واكتب_نصا_في_المنسق واكتب_حرفا_في_المنسق
// واحش_نصا، وتقرأ مواصفة الموضع (العرض والدقة والحشو والمحاذاة والبديل
// والإشارة والأصفار)، وتنسق التصحيح والتصحيح المنسق ({:#?} داخل قائمة)،
// وتترك مواصفة القائمة للعنصر التالي. لا تلتقط الدوال المغلقة إلا القيم
// البسيطة (الأعداد والمنطقيات والسجلات منها)، فالنوع الذي يملك نصا تكتبه
// دالته في منسق ويمرر نصا ينقل بلا نسخ. ويعاد استعمال المنسق لعدة كتابات.
استورد المكتبة.تنسيق.fmt;
استورد المكتبة.نصوص.compare;
استورد المكتبة.دخ.print;

نوع نقطة = { س: عدد, ص: عدد };
نوع مسمى = { الاسم: نص, الرقم: عدد };

// العرض «(س, ص)»؛ والتصحيح «نقطة { س: 1, ص: 2 }»؛ والتصحيح المنسق على أسطر.
عرف اعرض_نقطة(ن: &نقطة, م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    لو (المنسق_للتصحيح(م)) {
        لو (المنسق_بديل(م)) { أرجع نسق_في(م, "نقطة {{\n    س: {},\n    ص: {},\n}}", [قيمة_تنسيق.عدد((*ن).س), قيمة_تنسيق.عدد((*ن).ص)]); };
        أرجع نسق_في(م, «نقطة {{ س: {}, ص: {} }}», [قيمة_تنسيق.عدد((*ن).س), قيمة_تنسيق.عدد((*ن).ص)]);
    };
    أرجع نسق_في(م, «({}, {})», [قيمة_تنسيق.عدد((*ن).س), قيمة_تنسيق.عدد((*ن).ص)]);
}

// العرض عبر احش_نصا: يطبق العرض والمحاذاة والدقة على النجوم.
عرف اعرض_نجوما(العدد: عدد, م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    دع النجوم: متغير منسق = أنشئ_منسقا();
    دع ف: متغير عدد = 0;
    طالما (ف < العدد) { دع ك: نتيجة طبيعي, خطأ_تنسيق = اكتب_حرفا_في_المنسق(&متغير النجوم, '★'); ف := ف + 1; }
    دع النص: نص = خذ_نص_المنسق(&متغير النجوم);
    أرجع احش_نصا(م, &النص);
}

// نوع يملك نصا: تكتبه دالته في منسق.
عرف اكتب_مسمى(ن: &مسمى, م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع نسق_في(م, «{}#{}», [قيمة_تنسيق.نص(&(*ن).الاسم), قيمة_تنسيق.عدد((*ن).الرقم)]);
}

// يكتب ما طلبه الموضع.
عرف اعرض_المواصفة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    دع العرض: متغير عدد = -1;
    طابق عرض_المنسق(م) مع
    | اختياري.موجود(ع) -> { العرض := ع مثل عدد; }
    | اختياري.لا_شيء -> { };
    دع الدقة: متغير عدد = -1;
    طابق دقة_المنسق(م) مع
    | اختياري.موجود(د) -> { الدقة := د مثل عدد; }
    | اختياري.لا_شيء -> { };
    دع المحاذاة: متغير نص = «none»;
    طابق محاذاة_المنسق(م) مع
    | محاذاة_تنسيق.يسار -> { المحاذاة := «left»; }
    | محاذاة_تنسيق.وسط -> { المحاذاة := «center»; }
    | محاذاة_تنسيق.يمين -> { المحاذاة := «right»; }
    | محاذاة_تنسيق.بلا -> { };
    دع الصيغة: متغير نص = «display»;
    طابق صيغة_المنسق(م) مع
    | صيغة_تنسيق.تصحيح -> { الصيغة := «debug»; }
    | صيغة_تنسيق.ست_عشري -> { الصيغة := «lower_hex»; }
    | _ -> { };
    دع الوسائط: متجه قيمة_تنسيق = [
        قيمة_تنسيق.عدد(العرض), قيمة_تنسيق.عدد(الدقة), قيمة_تنسيق.ط32(حشو_المنسق(م)), قيمة_تنسيق.نص(&المحاذاة),
        قيمة_تنسيق.منطقي(المنسق_بديل(م)), قيمة_تنسيق.منطقي(المنسق_بإشارة(م)),
        قيمة_تنسيق.منطقي(المنسق_بأصفار(م)), قيمة_تنسيق.نص(&الصيغة)
    ];
    أرجع نسق_في(م, «w={} p={} fill={} align={} alt={} plus={} zero={} kind={}», الوسائط);
}

// يكتب حرفا ونصا مباشرة.
عرف اعرض_خاما(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    دع أ: نتيجة طبيعي, خطأ_تنسيق = اكتب_حرفا_في_المنسق(م, 'ب');
    دع ن: نص = «-x»;
    أرجع اكتب_نصا_في_المنسق(م, &ن);
}

عرف افحص(القالب: نص, الوسائط: متجه قيمة_تنسيق, المتوقع: نص): عدد {
    طابق نسق(القالب, الوسائط) مع
    | نتيجة.نجح(الناتج) -> {
        لو (نصان_متساويان(&الناتج, &المتوقع)) { أرجع 0; };
        دع ر: نتيجة عدد, عدد = اطبع_خطأ(الناتج);
        دع ر2: نتيجة عدد, عدد = اطبع_خطأ("\n");
        أرجع 1;
    }
    | نتيجة.خطأ(_) -> { دع ر: نتيجة عدد, عدد = اطبع_خطأ(«خطأ»); أرجع 1; };
}

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    دع ن: نقطة = { س: 1, ص: -2 };
    دع ق: نقطة = { س: 30, ص: 4 };
    دع نو: قيمة_تنسيق = قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نقطة(&ن, م));
    دع قو: قيمة_تنسيق = قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نقطة(&ق, م));
    الإخفاقات := الإخفاقات + افحص(«ن = {}», [نو], «ن = (1, -2)»);
    الإخفاقات := الإخفاقات + افحص(«{:?}», [نو], «نقطة { س: 1, ص: -2 }»);
    الإخفاقات := الإخفاقات + افحص(«{:#?}», [نو], "نقطة {\n    س: 1,\n    ص: -2,\n}");
    // بلا احش_نصا يقرر المنسق المخصص أمر العرض، كما في Rust.
    الإخفاقات := الإخفاقات + افحص(«[{:>12}]», [نو], «[(1, -2)]»);

    دع النقاط: متجه قيمة_تنسيق = [نو, قو];
    الإخفاقات := الإخفاقات + افحص(«{:?}», [قيمة_تنسيق.قائمة(&النقاط)], «[نقطة { س: 1, ص: -2 }, نقطة { س: 30, ص: 4 }]»);
    الإخفاقات := الإخفاقات + افحص(«{:#?}», [قيمة_تنسيق.قائمة(&النقاط)], "[\n    نقطة {\n        س: 1,\n        ص: -2,\n    },\n    نقطة {\n        س: 30,\n        ص: 4,\n    },\n]");

    // تصل مواصفة القائمة إلى العنصر الذي يلي العنصر المخصص.
    دع عناصر_مختلطة: متجه قيمة_تنسيق = [قيمة_تنسيق.عدد(1), نو, قيمة_تنسيق.عدد(2)];
    الإخفاقات := الإخفاقات + افحص(«{:4?}», [قيمة_تنسيق.قائمة(&عناصر_مختلطة)], «[   1, نقطة { س: 1, ص: -2 },    2]»);

    // يطبق احش_نصا العرض والحشو والمحاذاة والدقة.
    دع ثلاث: عدد = 3;
    الإخفاقات := الإخفاقات + افحص(«[{}]», [قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نجوما(ثلاث, م))], «[★★★]»);
    الإخفاقات := الإخفاقات + افحص(«[{:>6}]», [قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نجوما(ثلاث, م))], «[   ★★★]»);
    الإخفاقات := الإخفاقات + افحص(«[{:-^7}]», [قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نجوما(ثلاث, م))], «[--★★★--]»);
    الإخفاقات := الإخفاقات + افحص(«[{:.2}]», [قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نجوما(ثلاث, م))], «[★★]»);

    // نوع يملك نصا، يكتب أولا ثم يمرر نصا.
    دع مس: مسمى = { الاسم: «علي», الرقم: 7 };
    دع المكتوب: متغير منسق = أنشئ_منسقا();
    طابق اكتب_مسمى(&مس, &متغير المكتوب) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع نص_المسمى: نص = خذ_نص_المنسق(&متغير المكتوب);
    الإخفاقات := الإخفاقات + افحص(«[{:>7}]», [قيمة_تنسيق.نص(&نص_المسمى)], «[  علي#7]»);

    // المواصفة التي يراها المنسق المخصص.
    دع مواصفة: قيمة_تنسيق = قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_المواصفة(م));
    الإخفاقات := الإخفاقات + افحص(«{}», [مواصفة], «w=-1 p=-1 fill=32 align=none alt=false plus=false zero=false kind=display»);
    الإخفاقات := الإخفاقات + افحص(«{:*>+#09.3?}», [مواصفة], «w=9 p=3 fill=42 align=right alt=true plus=true zero=true kind=debug»);
    الإخفاقات := الإخفاقات + افحص(«{:<5x}», [مواصفة], «w=5 p=-1 fill=32 align=left alt=false plus=false zero=false kind=lower_hex»);
    الإخفاقات := الإخفاقات + افحص(«{0:^1$.2$}», [مواصفة, قيمة_تنسيق.طبيعي(4), قيمة_تنسيق.طبيعي(2)], «w=4 p=2 fill=32 align=center alt=false plus=false zero=false kind=display»);

    الإخفاقات := الإخفاقات + افحص(«<{}>», [قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_خاما(م))], «<ب-x>»);

    // منسق واحد يعاد استعماله لعدة كتابات.
    دع الناتج: متغير منسق = أنشئ_منسقا_بسعة(64);
    دع ف: متغير عدد = 0;
    طالما (ف < 3) {
        طابق نسق_في(&متغير الناتج, «{}:{};», [قيمة_تنسيق.عدد(ف), نو]) مع
        | نتيجة.نجح(المكتوب_الآن) -> { لو (المكتوب_الآن != 10) { الإخفاقات := الإخفاقات + 1; }; }
        | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
        ف := ف + 1;
    }
    دع الكل: نص = نص_المنسق(&الناتج);
    دع المطلوب: نص = «0:(1, -2);1:(1, -2);2:(1, -2);»;
    لو (!نصان_متساويان(&الكل, &المطلوب)) { الإخفاقات := الإخفاقات + 1; };
    لو (طول_المنسق(&الناتج) != 30) { الإخفاقات := الإخفاقات + 1; };
    امسح_المنسق(&متغير الناتج);
    لو (طول_المنسق(&الناتج) != 0) { الإخفاقات := الإخفاقات + 1; };
    طابق نسق_في(&متغير الناتج, «{:.4}», [قيمة_تنسيق.نص(&المطلوب)]) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع المأخوذ: نص = خذ_نص_المنسق(&متغير الناتج);
    دع المأخوذ_المطلوب: نص = «0:(1»;
    لو (!نصان_متساويان(&المأخوذ, &المأخوذ_المطلوب)) { الإخفاقات := الإخفاقات + 1; };
    لو (طول_المنسق(&الناتج) != 0) { الإخفاقات := الإخفاقات + 1; };

    لو (الإخفاقات != 0) { أرجع 1; };
    أرجع 42;
}
