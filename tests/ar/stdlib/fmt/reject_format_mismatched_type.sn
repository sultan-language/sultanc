// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/en/stdlib/fmt/reject_format_mismatched_type.sn
// خرج-تشخيص-عربي: reject_format_mismatched_type.ar.txt
// النوع X لا يناسب نصا.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الاسم: نص = «سلطان»;
    طابق نسق(«{} {:X}», [قيمة_تنسيق.عدد(1), قيمة_تنسيق.نص(&الاسم)]) مع
    | نتيجة.نجح(_) -> { أرجع 0; }
    | نتيجة.خطأ(_) -> { أرجع 1; };
}
