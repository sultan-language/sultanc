// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// ملكية المكتبة.تنسيق: 10^5 جولة من نسق، ونسق_في على منسق يعاد استعماله،
// والأعداد العائمة (أقصر الأرقام والأرقام الدقيقة)، ونص عربي يقاس بعناقيد
// المحارف، والقوائم، ومنسق مخصص، وخطأ تنسيق. تبقى البايتات الحية للمخصص بعد
// الحلقة كما كانت قبلها.
// النظير: tests/en/stdlib/fmt/rss_flat.sn. ليس له توجيه زوج: لا يستعمل المفسر
// مخصص المكتبة الذي يقرأ هذا الاختبار عداداته.
استورد المكتبة.تنسيق.fmt;
استورد std.os.allocation;

نوع نقطة = { س: عدد, ص: عدد };

عرف اعرض_نقطة(ن: &نقطة, م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع نسق_في(م, «({}, {})», [قيمة_تنسيق.عدد((*ن).س), قيمة_تنسيق.عدد((*ن).ص)]);
}

عرف جولة(ف: عدد, الناتج: &متغير منسق): عدد {
    دع الكلي: متغير عدد = 0;
    دع الاسم: نص = «مُحَمَّد»;
    دع الأعداد: متجه عدد = [ف, -ف, 7];
    دع ن: نقطة = { س: ف, ص: 2 };
    دع الوسائط: متجه قيمة_تنسيق = [
        قيمة_تنسيق.عدد(ف), قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.ع64((ف مثل ع64) / 3.0), قيمة_تنسيق.أعداد(&الأعداد),
        قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نقطة(&ن, م)), قيمة_تنسيق.ط8(255)
    ];
    طابق نسق(«{:>8}|{:^10}|{:.3}|{2:e}|{:?}|{}|{:#x}», الوسائط) مع
    | نتيجة.نجح(ن_) -> { الكلي := الكلي + (الطول(ن_) مثل عدد); }
    | نتيجة.خطأ(_) -> { أرجع -1; };
    امسح_المنسق(الناتج);
    طابق نسق_في(الناتج, «{0:08} {1:.2} {2} {3:#?} {4:?} {5}», [
        قيمة_تنسيق.عدد(ف), قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.ع64((ف مثل ع64) / 3.0), قيمة_تنسيق.أعداد(&الأعداد),
        قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> اعرض_نقطة(&ن, م)), قيمة_تنسيق.ط8(255)
    ]) مع
    | نتيجة.نجح(ع) -> { الكلي := الكلي + (ع مثل عدد); }
    | نتيجة.خطأ(_) -> { أرجع -1; };
    // قالب التنسيق غير الحرفي يفحص وقت التشغيل.
    دع اثنان: نص = «{} {}»;
    طابق نسق(اثنان, [قيمة_تنسيق.عدد(ف), قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.أعداد(&الأعداد)]) مع
    | نتيجة.نجح(_) -> { أرجع -1; }
    | نتيجة.خطأ(_) -> { الكلي := الكلي + 1; };
    أرجع الكلي;
}

عرف الرئيسية(): عدد {
    دع الناتج: متغير منسق = أنشئ_منسقا();
    // تمهيد بأطول ناتج، لتبلغ سعة مخزن المنسق المعاد قيمتها الأخيرة قبل العد.
    لو (جولة(-99999, &متغير الناتج) < 0) { أرجع 1; };
    دع قبل: ط64 = بايتات_حية_مخصص_النظام();
    دع ف: متغير عدد = 0;
    طالما (ف < 100000) {
        لو (جولة(ف, &متغير الناتج) < 0) { أرجع 2; };
        ف := ف + 1;
    }
    دع بعد: ط64 = بايتات_حية_مخصص_النظام();
    لو (بعد != قبل) { أرجع 3; };
    أرجع 42;
}
