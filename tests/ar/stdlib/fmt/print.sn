// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// خرج-قياسي: 1 + 2 = 3 |  سلام
// خطأ-قياسي-ملف: print.stderr
// نظير: tests/en/stdlib/fmt/print.sn
// اطبع_منسقا واطبع_خطأ_منسقا واطبع_سطر_خطأ_منسقا (print! وeprint! وeprintln!
// في Rust): كل نداء ينسق في مخزن واحد ويكتبه مرة واحدة؛ والناتج عدد البايتات
// المكتوبة، وتضيف صيغ السطر "\n". وخطأ التنسيق لا يطبع شيئا.
استورد المكتبة.تنسيق.fmt;

عرف الرئيسية(): عدد {
    دع الإخفاقات: متغير عدد = 0;
    طابق اطبع_منسقا(«{} + {} = {}», [قيمة_تنسيق.عدد(1), قيمة_تنسيق.عدد(2), قيمة_تنسيق.عدد(3)]) مع
    | نتيجة.نجح(ن) -> { لو (ن != 9) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع الكلمة: نص = «سلام»;
    طابق اطبع_منسقا(« | {:>5}», [قيمة_تنسيق.نص(&الكلمة)]) مع
    | نتيجة.نجح(ن) -> { لو (ن != 12) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    دع القرص: نص = «القرص»;
    طابق اطبع_سطر_خطأ_منسقا(«تحذير: {} ({:.1}%)», [قيمة_تنسيق.نص(&القرص), قيمة_تنسيق.ع64(93.25)]) مع
    | نتيجة.نجح(ن) -> { لو (ن != 31) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    طابق اطبع_خطأ_منسقا(«done={}», [قيمة_تنسيق.منطقي(صواب)]) مع
    | نتيجة.نجح(ن) -> { لو (ن != 9) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    طابق اطبع_سطر_خطأ_منسقا(«», []) مع
    | نتيجة.نجح(ن) -> { لو (ن != 1) { الإخفاقات := الإخفاقات + 1; }; }
    | نتيجة.خطأ(_) -> { الإخفاقات := الإخفاقات + 1; };
    // قالب التنسيق غير الحرفي يفحص وقت التشغيل.
    دع الناقص: نص = «{}»;
    طابق اطبع_منسقا(الناقص, []) مع
    | نتيجة.نجح(_) -> { الإخفاقات := الإخفاقات + 1; }
    | نتيجة.خطأ(_) -> { };
    لو (الإخفاقات != 0) { أرجع 1; };
    أرجع 42;
}
