// وحدة مساعدة لـ`قيم.sn`: دالة في وحدة أخرى، لنقاط التوقف بالاسم ولتتبع
// المكدس عبر الوحدات (tools/tests/debugger_tests.sh).
عام عرف المجموع_المضاعف(الأول: عدد, الثاني: عدد, المعامل: عدد): عدد {
    دع المجموع: عدد = الأول + الثاني;
    دع المضاعف: عدد = المجموع * المعامل;
    أرجع المضاعف;                                          // BP:scaled_sum
}
