// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/debugger/values.sn
// برنامج تشغله اختبارات المنقح تحت gdb وlldb (قيم.dbg،
// tools/tests/debugger_tests.sh). الأسطر الموسومة `// BP:الاسم` أهداف نقاط
// التوقف؛ نظيره الإنجليزي tests/en/debugger/values.sn.
استورد std.io.println;
استورد std.text.number;
استورد "أدوات/حساب.sn";

نوع نقطة = { س: عدد, ص: عدد };
نوع كبير = { أ: عدد, ب: عدد, ج: عدد, الوسم: نص };
نوع شكل = | مربع بنوع عدد | مستطيل بنوع نقطة | فارغ;

دع العداد_العام: عدد = 7;

عرف مجموع_الكبير(القيمة: كبير): عدد {
    دع الجزئي: عدد = القيمة.أ + القيمة.ب;
    اطبع_سطر(عدد_إلى_نص(الجزئي));                          // BP:sum_big
    أرجع الجزئي + القيمة.ج;
}

عرف المساحة(الشكل: شكل): عدد {
    طابق الشكل مع
    | شكل.مربع(الضلع) -> { أرجع الضلع * الضلع; }
    | شكل.مستطيل({ س: العرض, ص: الارتفاع }) -> { أرجع العرض * الارتفاع; }
    | شكل.فارغ -> { أرجع 0; };
}

عرف زد(الهدف: &متغير عدد): فراغ {
    *الهدف := *الهدف + 1;                                   // BP:bump
}

عرف عد_تصاعديا(الحد: عدد): عدد {
    دع المجموع: متغير عدد = 0;
    دع الفهرس: متغير عدد = 0;
    طالما (الفهرس < الحد) {
        المجموع := المجموع + الفهرس;                        // BP:loop
        الفهرس := الفهرس + 1;
    }
    أرجع المجموع;
}

عرف الرئيسية(): عدد {
    دع ن: نقطة = { س: 3, ص: 4 };
    دع الكبير: كبير = { أ: 1, ب: 2, ج: 3, الوسم: «مرحبا» };
    دع ش: شكل = شكل.مستطيل(ن);
    دع القيم: متجه عدد = [10, 20, 30];
    دع الاسم: نص = «عالم»;
    دع الإجمالي: متغير عدد = مجموع_الكبير(الكبير);
    زد(&متغير الإجمالي);                                   // BP:main_bump
    الإجمالي := الإجمالي + المساحة(ش);
    الإجمالي := الإجمالي + عد_تصاعديا(4);
    الإجمالي := الإجمالي + المجموع_المضاعف(الإجمالي, العداد_العام, 2);
    اطبع_سطر(عدد_إلى_نص(الإجمالي));                        // BP:main_print
    اطبع_سطر(الاسم);
    أرجع 0;
}
