// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/en/debugger/return_line.sn
// برنامج جلسة سطر_الإرجاع.dbg (tools/tests/debugger_tests.sh): لعبارة الإرجاع
// التي حُسبت قيمتها سطر خاص بها في جدول الأسطر (يحمله منهي الكتلة)، فيقف
// المنقّح عندها.
استورد المكتبة.دخ.اطبع_سطر;
استورد المكتبة.نصوص.أعداد;

// كبيرة بما يكفي ليبقيها المحسِّن دالة في كل مستوى.
عرف ضاعف(القيمة: عدد): عدد {
    ليكن المضاعف: عدد = القيمة * 2;
    اطبع_سطر(عدد_إلى_نص(القيمة));
    اطبع_سطر(عدد_إلى_نص(المضاعف));
    اطبع_سطر(عدد_إلى_نص(المضاعف + القيمة));
    اطبع_سطر(عدد_إلى_نص(المضاعف * القيمة));
    اطبع_سطر(عدد_إلى_نص(المضاعف - القيمة));
    اطبع_سطر(عدد_إلى_نص(المضاعف / 2));
    اطبع_سطر(عدد_إلى_نص(المضاعف % 5));
    أرجع المضاعف;                                           // BP:إرجاع_ضاعف
}

عرف الرئيسية(): عدد {
    ليكن الناتج: عدد = ضاعف(21);                              // BP:نداء_ضاعف
    اطبع_سطر(عدد_إلى_نص(الناتج));
    أرجع الناتج - 42;
}
