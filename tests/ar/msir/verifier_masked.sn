// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/msir/verifier_masked.sn
// التحقق المقنَّع (msir_verifier.sn، تحقق_دوال_برنامج_مسير): يفحص حقائق
// البرنامج مرة والدوال التي يعلّمها القناع فقط، فيكشف الدالة المفسدة داخل
// القناع ويعطي ما يعطيه التحقق الكامل حين يعلّم القناع كل الدوال.
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

// عدد الأخطاء (0 للبرنامج المقبول).
عرف عدد_الأخطاء(النتيجة: نتيجة_تحقق_مسير): طبيعي {
    طابق النتيجة مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع 0; }
    | نتيجة_تحقق_مسير.مرفوض(الأخطاء) -> { أرجع الطول(الأخطاء) مثل طبيعي; };
}

// ثلاث دوال تعيد كل منها ثابتًا، والأولى بدء البرنامج.
عرف برنامج_ثلاث_دوال(الأنواع: &متغير سجل_أنواع): برنامج_مسير {
    دع نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع ف: متغير عدد = 0;
    طالما (ف < 3) {
        دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
        دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
        دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
            أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(40 + ف), نوع_العدد)
        );
        اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختياري.موجود(القيمة));
        إذا (ف == 0) { عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة); };
        ف := ف + 1;
    }
    أرجع البرنامج;
}

// تفسد الدالة ذات الموضع المعطى: إرجاع قيمة غير معرّفة.
عرف أفسد_دالة(البرنامج: &متغير برنامج_مسير, الموضع: طبيعي): فراغ {
    دع الدالة: معرف_دالة_مسير = (*البرنامج).الدوال[الموضع].المعرف;
    (*البرنامج).الدوال[الموضع].الكتل[0].المنهي := اختياري.موجود(
        منهي_مسير.إرجاع(اختياري.موجود(معرف_قيمة_مسير_من(الدالة, 99)))
    );
}

// دالة البدء تستدعي الثانية وتعيد ناتجها، والثانية تعيد 42.
عرف برنامج_بنداء(الأنواع: &متغير سجل_أنواع): برنامج_مسير {
    دع نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع المستدعية: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    دع المستدعاة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    دع كتلة_المستدعية: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المستدعية));
    دع كتلة_المستدعاة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المستدعاة));
    دع الثابت: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, المستدعاة, كتلة_المستدعاة, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, المستدعاة, كتلة_المستدعاة, اختياري.موجود(الثابت));
    دع لا_حجج: متجه معرف_قيمة_مسير = [];
    دع الناتج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_نداء_مسير(&متغير البرنامج, &البناء, المستدعية, كتلة_المستدعية, المستدعاة, &لا_حجج)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, المستدعية, كتلة_المستدعية, اختياري.موجود(الناتج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, المستدعية);
    أرجع البرنامج;
}

// دالة متغيرة تكسر ما لا يراه إلا فحص دالة لم تتغير: تصير المستدعاة بلا ناتج
// (وهي صحيحة وحدها)، فلا يطابق نداء المستدعية تصريحها.
عرف اختبار_تصريح_متغير(): عدد {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_بنداء(&متغير الأنواع);
    دع الثانية: متجه منطقي = [خطأ, صواب];
    دع الأولى: متجه منطقي = [صواب, خطأ];
    إذا (عدد_الأخطاء(تحقق_برنامج_مسير(&البرنامج, &الأنواع)) != 0) { أرجع 21; };
    البرنامج.الدوال[1].الناتج := اختياري.لا_شيء();
    البرنامج.الدوال[1].الكتل[0].المنهي := اختياري.موجود(منهي_مسير.إرجاع(اختياري.لا_شيء()));
    دع الكامل: طبيعي = عدد_الأخطاء(تحقق_برنامج_مسير(&البرنامج, &الأنواع));
    إذا (الكامل == 0) { أرجع 22; };
    // المستدعاة وحدها صحيحة؛ الخطأ في نداء المستدعية.
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الأولى)) != الكامل) { أرجع 23; };
    // والتحقق الذي لا يعلّم إلا المستدعاة المتغيرة يكشفه كما يكشفه التحقق الكامل.
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثانية)) != الكامل) { أرجع 24; };
    أرجع 0;
}

عرف الرئيسية(): عدد {
    دع التصريح: عدد = اختبار_تصريح_متغير();
    إذا (التصريح != 0) { أرجع التصريح; };
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_ثلاث_دوال(&متغير الأنواع);
    دع الكل: متجه منطقي = [صواب, صواب, صواب];
    دع الثانية: متجه منطقي = [خطأ, صواب, خطأ];
    دع الثالثة: متجه منطقي = [خطأ, خطأ, صواب];
    دع لا_شيء: متجه منطقي = [];
    // البرنامج السليم مقبول بكل قناع.
    إذا (عدد_الأخطاء(تحقق_برنامج_مسير(&البرنامج, &الأنواع)) != 0) { أرجع 1; };
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الكل)) != 0) { أرجع 2; };
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &لا_شيء)) != 0) { أرجع 3; };
    // الدالة المفسدة داخل القناع تُكشف.
    أفسد_دالة(&متغير البرنامج, 1);
    دع الكامل: طبيعي = عدد_الأخطاء(تحقق_برنامج_مسير(&البرنامج, &الأنواع));
    إذا (الكامل == 0) { أرجع 4; };
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثانية)) != الكامل) { أرجع 5; };
    // والقناع الذي يعلّم كل الدوال يعطي ما يعطيه التحقق الكامل.
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الكل)) != الكامل) { أرجع 6; };
    // والدوال خارج القناع لا تُفحص.
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثالثة)) != 0) { أرجع 7; };
    // دالتان مفسدتان: الكامل والقناع الكامل متفقان، وكل قناع جزئي يرى دالته.
    أفسد_دالة(&متغير البرنامج, 2);
    دع الكامل_الثاني: طبيعي = عدد_الأخطاء(تحقق_برنامج_مسير(&البرنامج, &الأنواع));
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الكل)) != الكامل_الثاني) { أرجع 8; };
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثالثة)) == 0) { أرجع 9; };
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثانية))
        + عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &الثالثة)) != الكامل_الثاني) { أرجع 10; };
    // وحقائق البرنامج تُفحص مع أي قناع: بدء برنامج غير موجود.
    البرنامج.دالة_بدء_البرنامج := اختياري.موجود(معرف_دالة_مسير_من(7));
    إذا (عدد_الأخطاء(تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &لا_شيء)) == 0) { أرجع 11; };
    أرجع 0;
}
