استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(_) -> {
        أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999);
    };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف هل_برنامج_مسير_صالح(البرنامج: &برنامج_مسير, الأنواع: &سجل_أنواع): منطقي {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع صواب; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع خطأ; };
}

عرف اختبار_كتلة_أساسية(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(القيمة));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_معاملات_كتلة_وفرع(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الدمج: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, المدخل, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    دع معامل_الدمج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الدمج, ص64)
    );
    دع الحجج: متجه معرف_قيمة_مسير = [القيمة];
    اختم_بفرع_مسير(&متغير البرنامج, الدالة, المدخل, الدمج, &الحجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الدمج, اختيار.بعض(معامل_الدمج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_فرع_شرطي_وحلقة(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الحلقة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الخروج: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    دع قيمة_الخروج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, المدخل, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    دع حافة_الحلقة: حافة_مسير = { الهدف: الحلقة, الحجج: بلا_حجج };
    دع حافة_الخروج: حافة_مسير = { الهدف: الخروج, الحجج: بلا_حجج };
    اختم_بفرع_شرطي_مسير(&متغير البرنامج, الدالة, المدخل, الشرط, حافة_الحلقة, حافة_الخروج);
    اختم_بفرع_مسير(&متغير البرنامج, الدالة, الحلقة, الحلقة, &بلا_حجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الخروج, اختيار.بعض(قيمة_الخروج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_ذاكرة(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع المكان: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_مكان_محلي_مسير(&متغير البرنامج, الدالة, الكتلة, ص64, صواب)
    );
    دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, الدالة, الكتلة, المكان, القيمة);
    دع المحمل: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تحميل_مسير(&متغير البرنامج, الدالة, الكتلة, المكان, ص64)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(المحمل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_تجميع_ونداء(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع عناصر_الصف: متجه معرف_نوع = [ص64, ص64];
    دع نوع_الصف: معرف_نوع = قنن_نوعا(&متغير الأنواع, نوع_مقنن.صف(عناصر_الصف));
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();

    دع معاملات_المساعد: متجه معرف_نوع = [ص64];
    دع المساعد: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &معاملات_المساعد, اختيار.بعض(ص64));
    دع كتلة_المساعد: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المساعد));
    دع معامل_المساعد: معرف_قيمة_مسير = معرف_قيمة_مسير_من(المساعد, 0);
    اختم_بإرجاع_مسير(&متغير البرنامج, المساعد, كتلة_المساعد, اختيار.بعض(معامل_المساعد));

    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع أ: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(20), ص64)
    );
    دع ب: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(22), ص64)
    );
    دع الأعضاء: متجه معرف_قيمة_مسير = [أ, ب];
    دع التجميع: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تجميع_مسير(&متغير البرنامج, الدالة, الكتلة, &الأعضاء, نوع_الصف)
    );
    دع الحقل: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_استخراج_حقل_مسير(&متغير البرنامج, الدالة, الكتلة, التجميع, 1, ص64)
    );
    دع الحجج: متجه معرف_قيمة_مسير = [الحقل];
    دع نتيجة_النداء: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_نداء_مسير(&متغير البرنامج, الدالة, الكتلة, المساعد, &الحجج)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(نتيجة_النداء));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف القلعة(): عدد {
    لو (!اختبار_كتلة_أساسية()) { أرجع 1; };
    لو (!اختبار_معاملات_كتلة_وفرع()) { أرجع 2; };
    لو (!اختبار_فرع_شرطي_وحلقة()) { أرجع 3; };
    لو (!اختبار_ذاكرة()) { أرجع 4; };
    لو (!اختبار_تجميع_ونداء()) { أرجع 5; };
    أرجع 42;
}
