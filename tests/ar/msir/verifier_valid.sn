// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/msir/verifier_valid.sn
// يقبل المتحقق القانوني (msir_verifier.sn، تحقق_برنامج_مسير) برامج MSIR صحيحة يبنيها الباني:
// كتلة واحدة، ومعاملات كتل وفرع، وفرع شرطي وحلقة، وذاكرة، وتجميع ونداء.
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(_) -> {
        أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999);
    };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف هل_برنامج_مسير_صالح(البرنامج: &برنامج_مسير, الأنواع: &سجل_أنواع): منطقي {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع صواب; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع خطأ; };
}

عرف اختبار_كتلة_أساسية(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(القيمة));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_معاملات_كتلة_وفرع(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الدمج: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    ليكن معامل_الدمج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الدمج, نوع_العدد)
    );
    ليكن الحجج: متجه معرف_قيمة_مسير = [القيمة];
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, الدمج, الحجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الدمج, اختياري.موجود(معامل_الدمج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_فرع_شرطي_وحلقة(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الحلقة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الخروج: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    ليكن قيمة_الخروج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    ليكن حجج_الحلقة: متجه معرف_قيمة_مسير = [];
    ليكن حجج_الخروج: متجه معرف_قيمة_مسير = [];
    ليكن حافة_الحلقة: حافة_مسير = { الهدف: الحلقة, الحجج: حجج_الحلقة };
    ليكن حافة_الخروج: حافة_مسير = { الهدف: الخروج, الحجج: حجج_الخروج };
    اختم_بفرع_شرطي_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, الشرط, حافة_الحلقة, حافة_الخروج);
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, الحلقة, الحلقة, []);
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الخروج, اختياري.موجود(قيمة_الخروج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_ذاكرة(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن المكان: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_مكان_محلي_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, نوع_العدد, صواب)
    );
    ليكن القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, المكان, القيمة);
    ليكن المحمل: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تحميل_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, المكان, نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(المحمل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف اختبار_تجميع_ونداء(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن عناصر_الصف: متجه معرف_نوع = [نوع_العدد, نوع_العدد];
    ليكن نوع_الصف: معرف_نوع = قنن_نوعا(&متغير الأنواع, نوع_مقنن.صف(عناصر_الصف));
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();

    ليكن معاملات_المساعد: متجه معرف_نوع = [نوع_العدد];
    ليكن المساعد: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &معاملات_المساعد, اختياري.موجود(نوع_العدد));
    ليكن كتلة_المساعد: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المساعد));
    ليكن معامل_المساعد: معرف_قيمة_مسير = معرف_قيمة_مسير_من(المساعد, 0);
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, المساعد, كتلة_المساعد, اختياري.موجود(معامل_المساعد));

    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن أ: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(20), نوع_العدد)
    );
    ليكن ب: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(22), نوع_العدد)
    );
    ليكن الأعضاء: متجه معرف_قيمة_مسير = [أ, ب];
    ليكن التجميع: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تجميع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, الأعضاء, نوع_الصف)
    );
    ليكن الحقل: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_استخراج_حقل_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, التجميع, 1, نوع_العدد)
    );
    ليكن الحجج: متجه معرف_قيمة_مسير = [الحقل];
    ليكن نتيجة_النداء: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_نداء_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, المساعد, الحجج)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(نتيجة_النداء));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_برنامج_مسير_صالح(&البرنامج, &الأنواع);
}

عرف الرئيسية(): عدد {
    إذا (!اختبار_كتلة_أساسية()) { أرجع 1; };
    إذا (!اختبار_معاملات_كتلة_وفرع()) { أرجع 2; };
    إذا (!اختبار_فرع_شرطي_وحلقة()) { أرجع 3; };
    إذا (!اختبار_ذاكرة()) { أرجع 4; };
    إذا (!اختبار_تجميع_ونداء()) { أرجع 5; };
    أرجع 42;
}
