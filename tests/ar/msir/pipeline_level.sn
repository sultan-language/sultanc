// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/en/msir/pipeline_level.sn
// مستوى خط التحسين (msir_optimization_pipeline.sn، مستوى_تحسين_مسير): في
// بلا (‎-O0) لا يجري أي تمرير ويبقى النداء إلى الدالة الصغيرة؛ وفي افتراضي
// تُضمَّن المستدعاة وتُعدّ المستدعية متغيرة ويجتاز الناتج التحقق.
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.msir_optimization_pipeline;
استورد compiler.msir.debug_contract;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

// دالة البدء تعيد ناتج نداء دالة تعيد 42.
عرف برنامج_بنداء(الأنواع: &متغير سجل_أنواع): برنامج_مسير {
    دع نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع المستدعية: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    دع المستدعاة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    دع كتلة_المستدعية: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المستدعية));
    دع كتلة_المستدعاة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, المستدعاة));
    دع الثابت: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, المستدعاة, كتلة_المستدعاة, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, المستدعاة, كتلة_المستدعاة, اختياري.موجود(الثابت));
    دع لا_حجج: متجه معرف_قيمة_مسير = [];
    دع الناتج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_نداء_مسير(&متغير البرنامج, &البناء, المستدعية, كتلة_المستدعية, المستدعاة, &لا_حجج)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, المستدعية, كتلة_المستدعية, اختياري.موجود(الناتج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, المستدعية);
    أرجع البرنامج;
}

// نداءات دوال السلطان في الدالة ذات الموضع المعطى.
عرف نداءات_في(البرنامج: &برنامج_مسير, الموضع: طبيعي): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[الموضع].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[الموضع].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[الموضع].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.دالة_سلطان(_) -> { العدد := العدد + 1; }
                | _ -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدد;
}

عرف مقبول(البرنامج: &برنامج_مسير, الأنواع: &سجل_أنواع): منطقي {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع صواب; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_بنداء(&متغير الأنواع);
    دع التصحيح: متغير بيانات_تصحيح_مسير = بيانات_تصحيح_مسير_جديدة();
    إذا (نداءات_في(&البرنامج, 0) != 1) { أرجع 1; };
    // بلا: لا يجري شيء ولا يتغير شيء ويبقى النداء.
    دع لا_متغيرة: متجه منطقي = حسن_برنامج_مسير(
        &متغير البرنامج, &الأنواع, &متغير التصحيح, نطاق_تحسين_مسير.كل_الدوال(), مستوى_تحسين_مسير.بلا()
    );
    إذا (الطول(لا_متغيرة) != 2 || لا_متغيرة[0] || لا_متغيرة[1]) { أرجع 2; };
    إذا (نداءات_في(&البرنامج, 0) != 1) { أرجع 3; };
    إذا (!مقبول(&البرنامج, &الأنواع)) { أرجع 4; };
    // افتراضي: تُضمَّن المستدعاة وتُعدّ المستدعية متغيرة.
    دع المتغيرة: متجه منطقي = حسن_برنامج_مسير(
        &متغير البرنامج, &الأنواع, &متغير التصحيح, نطاق_تحسين_مسير.كل_الدوال(), مستوى_تحسين_مسير.افتراضي()
    );
    إذا (الطول(المتغيرة) != 2 || !المتغيرة[0]) { أرجع 5; };
    إذا (نداءات_في(&البرنامج, 0) != 0) { أرجع 6; };
    إذا (!مقبول(&البرنامج, &الأنواع)) { أرجع 7; };
    // ويتفق التحقق المقنَّع بالمجموعة المتغيرة مع التحقق الكامل.
    طابق تحقق_دوال_برنامج_مسير(&البرنامج, &الأنواع, &المتغيرة) مع
    | نتيجة_تحقق_مسير.صالح -> { }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع 8; };
    أرجع 0;
}
