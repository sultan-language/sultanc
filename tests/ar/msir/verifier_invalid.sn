// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/msir/verifier_invalid.sn
// يرفض المتحقق القانوني (msir_verifier.sn، تحقق_برنامج_مسير) برامج MSIR مفسدة: قيمة أو كتلة غير
// موجودة، وقيمة مكررة، وأنواع غير مطابقة، وحجج فرع خاطئة، ومنهٍ مفقود، وتجميع مشوه، واستخدام قبل
// التعريف، وهيمنة غير صالحة.
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف هل_مرفوض(البرنامج: &برنامج_مسير, الأنواع: &سجل_أنواع): منطقي {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع خطأ; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع صواب; };
}

عرف برنامج_أساسي(الأنواع: &متغير سجل_أنواع): برنامج_مسير {
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(القيمة));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع البرنامج;
}

عرف اختبار_معرف_قيمة_غير_موجود(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    ليكن الدالة: معرف_دالة_مسير = البرنامج.الدوال[0].المعرف;
    البرنامج.الدوال[0].الكتل[0].المنهي := اختياري.موجود(
        منهي_مسير.إرجاع(اختياري.موجود(معرف_قيمة_مسير_من(الدالة, 99)))
    );
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_معرف_كتلة_غير_موجود(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    ليكن الدالة: معرف_دالة_مسير = البرنامج.الدوال[0].المعرف;
    ليكن الحافة: حافة_مسير = { الهدف: معرف_كتلة_مسير_من(الدالة, 77), الحجج: [] };
    البرنامج.الدوال[0].الكتل[0].المنهي := اختياري.موجود(منهي_مسير.فرع(الحافة));
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_معرف_قيمة_مكرر(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    ألحق(البرنامج.الدوال[0].القيم, البرنامج.الدوال[0].القيم[0]);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_نوع_نتيجة_غير_مطابق(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    // The result's Type lives in the function's value table (C1).
    البرنامج.الدوال[0].القيم[0].النوع := منطقي_نوع;
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_عدد_حجج_فرع_غير_مطابق(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الهدف: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن معامل: معرف_قيمة_مسير = خذ_قيمة_اختبار(أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الهدف, نوع_العدد));
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, الهدف, []);
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الهدف, اختياري.موجود(معامل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_نوع_حجة_فرع_غير_مطابق(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الهدف: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن معامل: معرف_قيمة_مسير = خذ_قيمة_اختبار(أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الهدف, نوع_العدد));
    ليكن الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    ليكن الحجج: متجه معرف_قيمة_مسير = [الشرط];
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, الهدف, الحجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الهدف, اختياري.موجود(معامل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_منهي_مفقود(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    البرنامج.الدوال[0].الكتل[0].المنهي := اختياري.لا_شيء();
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_ذاكرة_بنوع_غير_مطابق(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن المكان: معرف_قيمة_مسير = خذ_قيمة_اختبار(أصدر_مكان_محلي_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, نوع_العدد, صواب));
    ليكن القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, المكان, القيمة);
    ليكن صفر: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(0), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(صفر));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_تجميع_مشوه(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن عناصر_الصف: متجه معرف_نوع = [نوع_العدد, نوع_العدد];
    ليكن نوع_الصف: معرف_نوع = قنن_نوعا(&متغير الأنواع, نوع_مقنن.صف(عناصر_الصف));
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_الصف));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن عضو: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(1), نوع_العدد)
    );
    ليكن أعضاء: متجه معرف_قيمة_مسير = [عضو];
    ليكن التجميع: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تجميع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, أعضاء, نوع_الصف)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(التجميع));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_استخدام_قبل_التعريف(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن اليسار: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(20), نوع_العدد)
    );
    ليكن اليمين: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(22), نوع_العدد)
    );
    ليكن الناتج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_حسابا_صحيحا_مسير(
            &متغير البرنامج, &البناء, الدالة, الكتلة, عملية_حساب_صحيح.جمع(), اليسار, اليمين, نوع_العدد
        )
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الكتلة, اختياري.موجود(الناتج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);

    ليكن تعليمة_ثابت_يمين: تعليمة_مسير = انسخ_مملوكا_تعليمة_مسير(&البرنامج.الدوال[0].الكتل[0].التعليمات[1]);
    ليكن تعليمة_الحساب: تعليمة_مسير = انسخ_مملوكا_تعليمة_مسير(&البرنامج.الدوال[0].الكتل[0].التعليمات[2]);
    البرنامج.الدوال[0].الكتل[0].التعليمات[1] := تعليمة_الحساب;
    البرنامج.الدوال[0].الكتل[0].التعليمات[2] := تعليمة_ثابت_يمين;

    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_هيمنة_غير_صالحة(): منطقي {
    ليكن الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    ليكن نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    ليكن منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    ليكن البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    ليكن البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    ليكن لا_معاملات: متجه معرف_نوع = [];
    ليكن الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختياري.موجود(نوع_العدد));
    ليكن المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن يسار: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن يمين: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    ليكن الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    ليكن حافة_يسار: حافة_مسير = { الهدف: يسار, الحجج: [] };
    ليكن حافة_يمين: حافة_مسير = { الهدف: يمين, الحجج: [] };
    اختم_بفرع_شرطي_مسير(&متغير البرنامج, &البناء, الدالة, المدخل, الشرط, حافة_يسار, حافة_يمين);
    ليكن قيمة_يسار: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, يسار, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, يسار, اختياري.موجود(قيمة_يسار));
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, يمين, اختياري.موجود(قيمة_يسار));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف الرئيسية(): عدد {
    إذا (!اختبار_معرف_قيمة_غير_موجود()) { أرجع 1; };
    إذا (!اختبار_معرف_كتلة_غير_موجود()) { أرجع 2; };
    إذا (!اختبار_معرف_قيمة_مكرر()) { أرجع 3; };
    إذا (!اختبار_نوع_نتيجة_غير_مطابق()) { أرجع 4; };
    إذا (!اختبار_عدد_حجج_فرع_غير_مطابق()) { أرجع 5; };
    إذا (!اختبار_نوع_حجة_فرع_غير_مطابق()) { أرجع 6; };
    إذا (!اختبار_منهي_مفقود()) { أرجع 7; };
    إذا (!اختبار_ذاكرة_بنوع_غير_مطابق()) { أرجع 8; };
    إذا (!اختبار_تجميع_مشوه()) { أرجع 9; };
    إذا (!اختبار_استخدام_قبل_التعريف()) { أرجع 10; };
    إذا (!اختبار_هيمنة_غير_صالحة()) { أرجع 11; };
    أرجع 42;
}
