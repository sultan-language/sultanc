استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.builtins_generated;

عرف خذ_كتلة_اختبار(النتيجة: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف خذ_قيمة_اختبار(النتيجة: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق النتيجة مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف هل_مرفوض(البرنامج: &برنامج_مسير, الأنواع: &سجل_أنواع): منطقي {
    طابق تحقق_برنامج_مسير(البرنامج, الأنواع) مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع خطأ; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع صواب; };
}

عرف برنامج_أساسي(الأنواع: &متغير سجل_أنواع): برنامج_مسير {
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(القيمة));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع البرنامج;
}

عرف اختبار_معرف_قيمة_غير_موجود(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    دع الدالة: معرف_دالة_مسير = البرنامج.الدوال[0].المعرف;
    البرنامج.الدوال[0].الكتل[0].المنهي := اختيار.بعض(
        منهي_مسير.إرجاع(اختيار.بعض(معرف_قيمة_مسير_من(الدالة, 99)))
    );
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_معرف_كتلة_غير_موجود(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    دع الدالة: معرف_دالة_مسير = البرنامج.الدوال[0].المعرف;
    دع الحافة: حافة_مسير = { الهدف: معرف_كتلة_مسير_من(الدالة, 77), الحجج: [] };
    البرنامج.الدوال[0].الكتل[0].المنهي := اختيار.بعض(منهي_مسير.فرع(الحافة));
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_معرف_قيمة_مكرر(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    ألحق(البرنامج.الدوال[0].القيم, البرنامج.الدوال[0].القيم[0]);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_نوع_نتيجة_غير_مطابق(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    دع الناتج_المعدل: قيمة_مسير = {
        المعرف: البرنامج.الدوال[0].القيم[0].المعرف,
        النوع: منطقي_نوع
    };
    البرنامج.الدوال[0].الكتل[0].التعليمات[0].الناتج := اختيار.بعض(الناتج_المعدل);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_عدد_حجج_فرع_غير_مطابق(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الهدف: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع معامل: معرف_قيمة_مسير = خذ_قيمة_اختبار(أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الهدف, ص64));
    دع لا_حجج: متجه معرف_قيمة_مسير = [];
    اختم_بفرع_مسير(&متغير البرنامج, الدالة, المدخل, الهدف, &لا_حجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الهدف, اختيار.بعض(معامل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_نوع_حجة_فرع_غير_مطابق(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الهدف: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع معامل: معرف_قيمة_مسير = خذ_قيمة_اختبار(أضف_معامل_كتلة_مسير(&متغير البرنامج, الدالة, الهدف, ص64));
    دع الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    دع الحجج: متجه معرف_قيمة_مسير = [الشرط];
    اختم_بفرع_مسير(&متغير البرنامج, الدالة, المدخل, الهدف, &الحجج);
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الهدف, اختيار.بعض(معامل));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_منهي_مفقود(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع البرنامج: متغير برنامج_مسير = برنامج_أساسي(&متغير الأنواع);
    البرنامج.الدوال[0].الكتل[0].المنهي := اختيار.لا_شيء();
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_ذاكرة_بنوع_غير_مطابق(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع المكان: معرف_قيمة_مسير = خذ_قيمة_اختبار(أصدر_مكان_محلي_مسير(&متغير البرنامج, الدالة, الكتلة, ص64, صواب));
    دع القيمة: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, الدالة, الكتلة, المكان, القيمة);
    دع صفر: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(0), ص64)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(صفر));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_تجميع_مشوه(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع عناصر_الصف: متجه معرف_نوع = [ص64, ص64];
    دع نوع_الصف: معرف_نوع = قنن_نوعا(&متغير الأنواع, نوع_مقنن.صف(عناصر_الصف));
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(نوع_الصف));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع عضو: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(1), ص64)
    );
    دع أعضاء: متجه معرف_قيمة_مسير = [عضو];
    دع التجميع: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_تجميع_مسير(&متغير البرنامج, الدالة, الكتلة, &أعضاء, نوع_الصف)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(التجميع));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_استخدام_قبل_التعريف(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع الكتلة: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع اليسار: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(20), ص64)
    );
    دع اليمين: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, الكتلة, ثابت_مسير.صحيح_موقع(22), ص64)
    );
    دع الناتج: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_حسابا_صحيحا_مسير(
            &متغير البرنامج, الدالة, الكتلة, عملية_حساب_صحيح.جمع, اليسار, اليمين, ص64
        )
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, الكتلة, اختيار.بعض(الناتج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);

    دع تعليمة_ثابت_يمين: تعليمة_مسير = البرنامج.الدوال[0].الكتل[0].التعليمات[1];
    دع تعليمة_الحساب: تعليمة_مسير = البرنامج.الدوال[0].الكتل[0].التعليمات[2];
    البرنامج.الدوال[0].الكتل[0].التعليمات[1] := تعليمة_الحساب;
    البرنامج.الدوال[0].الكتل[0].التعليمات[2] := تعليمة_ثابت_يمين;

    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف اختبار_هيمنة_غير_صالحة(): منطقي {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع ص64: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع منطقي_نوع: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع لا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &لا_معاملات, اختيار.بعض(ص64));
    دع المدخل: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع يسار: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع يمين: معرف_كتلة_مسير = خذ_كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الشرط: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, المدخل, ثابت_مسير.منطق(صواب), منطقي_نوع)
    );
    دع حافة_يسار: حافة_مسير = { الهدف: يسار, الحجج: [] };
    دع حافة_يمين: حافة_مسير = { الهدف: يمين, الحجج: [] };
    اختم_بفرع_شرطي_مسير(&متغير البرنامج, الدالة, المدخل, الشرط, حافة_يسار, حافة_يمين);
    دع قيمة_يسار: معرف_قيمة_مسير = خذ_قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, الدالة, يسار, ثابت_مسير.صحيح_موقع(42), ص64)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, يسار, اختيار.بعض(قيمة_يسار));
    اختم_بإرجاع_مسير(&متغير البرنامج, الدالة, يمين, اختيار.بعض(قيمة_يسار));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);
    أرجع هل_مرفوض(&البرنامج, &الأنواع);
}

عرف القلعة(): عدد {
    لو (!اختبار_معرف_قيمة_غير_موجود()) { أرجع 1; };
    لو (!اختبار_معرف_كتلة_غير_موجود()) { أرجع 2; };
    لو (!اختبار_معرف_قيمة_مكرر()) { أرجع 3; };
    لو (!اختبار_نوع_نتيجة_غير_مطابق()) { أرجع 4; };
    لو (!اختبار_عدد_حجج_فرع_غير_مطابق()) { أرجع 5; };
    لو (!اختبار_نوع_حجة_فرع_غير_مطابق()) { أرجع 6; };
    لو (!اختبار_منهي_مفقود()) { أرجع 7; };
    لو (!اختبار_ذاكرة_بنوع_غير_مطابق()) { أرجع 8; };
    لو (!اختبار_تجميع_مشوه()) { أرجع 9; };
    لو (!اختبار_استخدام_قبل_التعريف()) { أرجع 10; };
    لو (!اختبار_هيمنة_غير_صالحة()) { أرجع 11; };
    أرجع 42;
}
