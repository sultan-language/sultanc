// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/en/msir/drop_elaboration.sn
// تفصيل الإسقاط (compiler/msir/drop_elaboration.sn) على MSIR أولي يبنيه الباني:
// مالكان نصيان، يُسلَّم أحدهما على فرع واحد فقط. يقبل متحقق MSIR الأولي عمليات
// الملكية ويرفضها المتحقق المعتمد؛ وبعد التفصيل لا يبقى منها شيء، ويقبل المتحقق
// المعتمد البرنامج، وللمالك المحمول على بعض المسارات فقط العلم الوحيد، ويُحرر
// المالك المحمول على كل المسارات دون شرط، والتزامه الثاني الذي يلي الأول ميت ويُزال.
استورد compiler.msir.msir_model;
استورد compiler.msir.identifiers;
استورد compiler.msir.msir_builder;
استورد compiler.msir.msir_verifier;
استورد compiler.msir.drop_elaboration;
استورد compiler.runtime.primitive_identity;
استورد compiler.frontend.types.type_identity;
استورد compiler.frontend.types.type_context;
استورد compiler.frontend.types.type_registry;
استورد compiler.frontend.types.type_model;
استورد compiler.frontend.types.builtins_generated;

عرف كتلة_اختبار(الناتج: نتيجة_بناء_كتلة_مسير): معرف_كتلة_مسير {
    طابق الناتج مع
    | نتيجة_بناء_كتلة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | نتيجة_بناء_كتلة_مسير.مرفوضة(_) -> {
        أرجع معرف_كتلة_مسير_من(معرف_دالة_مسير_من(9999), 9999);
    };
}

عرف قيمة_اختبار(الناتج: نتيجة_بناء_قيمة_مسير): معرف_قيمة_مسير {
    طابق الناتج مع
    | نتيجة_بناء_قيمة_مسير.مبنية(المعرف) -> { أرجع المعرف; }
    | _ -> { أرجع معرف_قيمة_مسير_من(معرف_دالة_مسير_من(9999), 9999); };
}

عرف مقبول(الناتج: نتيجة_تحقق_مسير): منطقي {
    طابق الناتج مع
    | نتيجة_تحقق_مسير.صالح -> { أرجع صواب; }
    | نتيجة_تحقق_مسير.مرفوض(_) -> { أرجع خطأ; };
}

عرف بايتات_النص(): متجه ط8 {
    دع البايتات: متجه ط8 = [97, 98, 99];
    أرجع البايتات;
}

عرف عمليات_الملكية(البرنامج: &برنامج_مسير): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[0].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[0].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[0].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.ملكية_مكان(_) -> { العدد := العدد + 1; }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدد;
}

عرف التحريرات(البرنامج: &برنامج_مسير): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول((*البرنامج).الدوال[0].الكتل) مثل طبيعي)) {
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*البرنامج).الدوال[0].الكتل[ك].التعليمات) مثل طبيعي)) {
            طابق (*البرنامج).الدوال[0].الكتل[ك].التعليمات[ت].العملية مع
            | عملية_مسير.نداء(النداء) -> {
                طابق النداء.الهدف مع
                | هدف_نداء_مسير.بدائي_مترجم(هوية_بدائي_مترجم.تحرير) -> { العدد := العدد + 1; }
                | _ -> { };
            }
            | _ -> { };
            ت := ت + 1;
        }
        ك := ك + 1;
    }
    أرجع العدد;
}

عرف مواضع_الدخول(البرنامج: &برنامج_مسير): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ت: متغير طبيعي = 0;
    طالما (ت < (الطول((*البرنامج).الدوال[0].الكتل[0].التعليمات) مثل طبيعي)) {
        طابق (*البرنامج).الدوال[0].الكتل[0].التعليمات[ت].العملية مع
        | عملية_مسير.مكان_محلي(_) -> { العدد := العدد + 1; }
        | _ -> { };
        ت := ت + 1;
    }
    أرجع العدد;
}

عرف الرئيسية(): عدد {
    دع الأنواع: متغير سجل_أنواع = سجل_أنواع_جديد();
    دع نوع_المنطق: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.منطقي());
    دع نوع_العدد: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.ص64());
    دع نوع_النص: معرف_نوع = قنن_نوعا_بدائيا(&متغير الأنواع, نوع_بدائي_مقنن.نص());
    دع البرنامج: متغير برنامج_مسير = برنامج_مسير_جديد();
    دع البناء: حالة_بناء_مسير = حالة_بناء_مسير_جديدة();
    دع بلا_معاملات: متجه معرف_نوع = [];
    دع الدالة: معرف_دالة_مسير = أضف_دالة_مسير(&متغير البرنامج, &بلا_معاملات, اختياري.موجود(نوع_العدد));
    دع الدخول: معرف_كتلة_مسير = كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع المنقول: معرف_كتلة_مسير = كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع المحفوظ: معرف_كتلة_مسير = كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع الالتقاء: معرف_كتلة_مسير = كتلة_اختبار(أضف_كتلة_مسير(&متغير البرنامج, الدالة));
    دع أحيانا: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_مكان_محلي_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, نوع_النص, صواب)
    );
    دع دائما: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_مكان_محلي_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, نوع_النص, صواب)
    );
    دع الأول: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_ثابت_نص_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, بايتات_النص(), نوع_النص)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, أحيانا, الأول);
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, حدث_ملكية_مسير.تهيئة(), أحيانا);
    دع الثاني: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_ثابت_نص_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, بايتات_النص(), نوع_النص)
    );
    أصدر_تخزين_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, دائما, الثاني);
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, حدث_ملكية_مسير.تهيئة(), دائما);
    دع الشرط: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, ثابت_مسير.منطق(صواب), نوع_المنطق)
    );
    دع حجج_المنقول: متجه معرف_قيمة_مسير = [];
    دع حجج_المحفوظ: متجه معرف_قيمة_مسير = [];
    دع إلى_المنقول: حافة_مسير = { الهدف: المنقول, الحجج: حجج_المنقول };
    دع إلى_المحفوظ: حافة_مسير = { الهدف: المحفوظ, الحجج: حجج_المحفوظ };
    اختم_بفرع_شرطي_مسير(&متغير البرنامج, &البناء, الدالة, الدخول, الشرط, إلى_المنقول, إلى_المحفوظ);
    دع بلا_حجج: متجه معرف_قيمة_مسير = [];
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, المنقول, حدث_ملكية_مسير.تسليم(), أحيانا);
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, المنقول, الالتقاء, &بلا_حجج);
    اختم_بفرع_مسير(&متغير البرنامج, &البناء, الدالة, المحفوظ, الالتقاء, &بلا_حجج);
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, الالتقاء, حدث_ملكية_مسير.إسقاط(), أحيانا);
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, الالتقاء, حدث_ملكية_مسير.إسقاط(), دائما);
    أصدر_ملكية_مكان_مسير(&متغير البرنامج, &البناء, الدالة, الالتقاء, حدث_ملكية_مسير.إسقاط(), دائما);
    دع الناتج: معرف_قيمة_مسير = قيمة_اختبار(
        أصدر_ثابتا_مسير(&متغير البرنامج, &البناء, الدالة, الالتقاء, ثابت_مسير.صحيح_موقع(42), نوع_العدد)
    );
    اختم_بإرجاع_مسير(&متغير البرنامج, &البناء, الدالة, الالتقاء, اختياري.موجود(الناتج));
    عين_دالة_بدء_برنامج_مسير(&متغير البرنامج, الدالة);

    إذا (!مقبول(تحقق_برنامج_مسير_أولي(&البرنامج, &الأنواع))) { أرجع 1; };
    إذا (مقبول(تحقق_برنامج_مسير(&البرنامج, &الأنواع))) { أرجع 2; };
    إذا (عمليات_الملكية(&البرنامج) != 6) { أرجع 3; };
    طابق فصل_إسقاط_برنامج_مسير(&متغير البرنامج, &متغير الأنواع) مع
    | اختياري.موجود(_) -> { أرجع 4; }
    | اختياري.لا_شيء -> { };
    إذا (عمليات_الملكية(&البرنامج) != 0) { أرجع 5; };
    إذا (!مقبول(تحقق_برنامج_مسير(&البرنامج, &الأنواع))) { أرجع 6; };
    إذا (مواضع_الدخول(&البرنامج) != 3) { أرجع 7; };
    إذا (التحريرات(&البرنامج) != 2) { أرجع 8; };
    إذا (الطول(البرنامج.الدوال[0].الكتل) != 6) { أرجع 9; };
    أرجع 42;
}
