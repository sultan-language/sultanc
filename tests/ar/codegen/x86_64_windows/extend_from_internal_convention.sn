// اختبار: تشغيل
// أهداف: x86_64-linux,x86_64-windows-msvc
// خروج: 42
// نظير: tests/en/codegen/x86_64_windows/extend_from_internal_convention.sn
// ألحق_من على x86-64 Windows في الشفرة الأصلية: يُرمَّز الإلحاق بالجملة باصطلاح
// السجلات الداخلي للسلطان، وهو اصطلاح System V على كل هدف x86-64 أصلي (المعامل
// الأول في RDI لا في RCX الخاص بـ Microsoft)، ويُكبَّر المخزن عبر خدمة إعادة
// التخصيص، وهي دالة من دوال السلطان. عناصر بحجم 1 و2 و4 و8 بايت، ونطاقات داخل
// المصدر، وتكبير متكرر.
عرف الرئيسية(): عدد {
    دع البايتات: متغير متجه ط8 = [1, 2];
    دع المزيد: متجه ط8 = [3, 4, 5, 6, 7];
    ألحق_من(البايتات, &المزيد, 1 مثل طبيعي, 3 مثل طبيعي);
    إذا (الطول(البايتات) != 5 || البايتات[2] != 4 || البايتات[4] != 6) { أرجع 1; };
    دع الأنصاف: متغير متجه ط16 = [];
    دع العريض: متجه ط16 = [500, 600, 700];
    ألحق_من(الأنصاف, &العريض, 1 مثل طبيعي, 2 مثل طبيعي);
    إذا (الطول(الأنصاف) != 2 || الأنصاف[0] != 600 || الأنصاف[1] != 700) { أرجع 2; };
    دع الكلمات: متغير متجه ص32 = [];
    دع المصدر: متجه ص32 = [10, 20, 30, 40];
    دع ك: متغير عدد = 0;
    طالما (ك < 50) { ألحق_من(الكلمات, &المصدر, 0 مثل طبيعي, 4 مثل طبيعي); ك := ك + 1; }
    إذا (الطول(الكلمات) != 200 || الكلمات[199] != 40 || الكلمات[101] != 20) { أرجع 3; };
    دع الطوال: متغير متجه ص64 = [7];
    دع الكبير: متجه ص64 = [1, 2, 3];
    ألحق_من(الطوال, &الكبير, 2 مثل طبيعي, 1 مثل طبيعي);
    ألحق_من(الطوال, &الكبير, 0 مثل طبيعي, 0 مثل طبيعي);
    إذا (الطول(الطوال) != 2 || الطوال[1] != 3) { أرجع 4; };
    أرجع 42;
}
