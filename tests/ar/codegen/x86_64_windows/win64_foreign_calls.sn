// اختبار: تشغيل
// أهداف: x86_64-linux,x86_64-windows-msvc
// خروج: 42
// نظير: tests/en/codegen/x86_64_windows/win64_foreign_calls.sn
// الشفرة الأصلية على x86-64 Windows تنادي الدوال الخارجية المصرح بها بعرف
// Microsoft x64: المعاملات حسب موضعها في RCX/RDX/R8/R9 أو XMM0-XMM3 (عدد
// ldexp العشري والصحيح في XMM0 وRDX)، والخامس والسادس في خانات المكدس فوق
// منطقة الحفظ ذات 32 بايت (MultiByteToWideChar)، والناتج في RAX أو XMM0.
// على غيره يتحقق البرنامج من القيم نفسها دون النداءات.
إذا (الهدف.المنصة == «windows») {
    خارجي «msvcrt.dll» عرف ldexp(القيمة: ع64, الأس: ص32): ع64;
    خارجي «kernel32.dll» عرف MultiByteToWideChar(
        صفحة_الترميز: ط32, الأعلام: ط32, النص: *ط8, الطول: ص32, العريض: *متغير ط16, طول_العريض: ص32
    ): ص32;

    عرف المضاعف(): ع64 {
        دع الناتج: متغير ع64 = 0.0;
        غير_آمن { الناتج := ldexp(0.75, 4); }
        أرجع الناتج;
    }

    عرف العريض(): عدد {
        دع النص: متغير متجه ط8 = [72, 105, 33];
        دع العريض_نص: متغير متجه ط16 = [0, 0, 0, 0, 0, 0, 0, 0];
        دع العدد: متغير ص32 = 0;
        غير_آمن { العدد := MultiByteToWideChar(65001, 0, &متغير النص[0], 3, &متغير العريض_نص[0], 8); }
        إذا (العريض_نص[0] != 72 || العريض_نص[2] != 33) { أرجع 0; };
        أرجع العدد مثل عدد;
    }
}
إذا (الهدف.المنصة != «windows») {
    عرف المضاعف(): ع64 { أرجع 12.0; }
    عرف العريض(): عدد { أرجع 3; }
}

عرف الرئيسية(): عدد {
    إذا (المضاعف() != 12.0) { أرجع 1; };
    إذا (العريض() != 3) { أرجع 2; };
    أرجع 42;
}
