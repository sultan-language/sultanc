// اختبار: تشغيل
// أهداف: x86_64-linux,x86_64-windows-msvc,x86_64-darwin,aarch64-linux-gnu,aarch64-android,x86_64-android,x86_64-freebsd,aarch64-freebsd
// خروج: 42
// نظير: tests/en/codegen/x86_64_windows/stack_probe_threads.sn
// إطار من عدة صفحات في الخيط الرئيسي وفي خيوط. Windows يلتزم المكدس صفحة
// حارسة بعد أخرى، فتلمس مقدمة الدالة الأصلية كل صفحة من إطار كبير بالترتيب
// قبل تحريك مؤشر المكدس؛ والخيوط تبدأ عبر CreateThread بمدخل C للإغلاق
// الذي يحفظ السجلات التي يحفظها Windows.
استورد std.thread.thread;

// 64 و512 و4096 و8192 بايت.
نوع و = { أ: ط64, ب: ط64, ج: ط64, د: ط64, هـ: ط64, ز: ط64, ح: ط64, ط: ط64 };
نوع س = { أ: و, ب: و, ج: و, د: و, هـ: و, ز: و, ح: و, ط: و };
نوع ص = { أ: س, ب: س, ج: س, د: س, هـ: س, ز: س, ح: س, ط: س };
نوع ع = { الأول: ص, الثاني: ص };

عرف ابن_و(ق: ط64): و { أرجع { أ: ق, ب: ق, ج: ق, د: ق, هـ: ق, ز: ق, ح: ق, ط: ق }; }
عرف ابن_س(ق: ط64): س { دع ك: و = ابن_و(ق); أرجع { أ: ك, ب: ك, ج: ك, د: ك, هـ: ك, ز: ك, ح: ك, ط: ك }; }
عرف ابن_ص(ق: ط64): ص { دع ك: س = ابن_س(ق); أرجع { أ: ك, ب: ك, ج: ك, د: ك, هـ: ك, ز: ك, ح: ك, ط: ك }; }

عرف عميق(البذرة: ط64): ط64 {
    دع ق: متغير ع = { الأول: ابن_ص(البذرة), الثاني: ابن_ص(البذرة + 1) };
    ق.الثاني.ط.ط.ط := البذرة * 2;
    أرجع ق.الأول.أ.أ.أ + ق.الثاني.أ.ب.ج + ق.الأول.ط.ط.ح + ق.الثاني.ط.ط.ط;
}

عرف الرئيسية(): عدد {
    إذا (عميق(1) != 1 + 2 + 1 + 2) { أرجع 1; };
    دع مقابض: متغير متجه مقبض_خيط_بقيمة<ط64> = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < 3) {
        دع ن: ط64 = ف;
        طابق أطلق_بقيمة(دالة(): ط64 -> عميق(ن)) مع
        | نتيجة.نجح(م) -> { ألحق(مقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 2; };
        ف := ف + 1;
    }
    دع المجموع: متغير ط64 = 0;
    دع ق: متغير طبيعي = 0;
    طالما (ق < 3) {
        طابق انضم_بقيمة(&متغير مقابض[ق]) مع
        | اختياري.موجود(القيمة) -> { المجموع := المجموع + القيمة; }
        | اختياري.لا_شيء -> { أرجع 3; };
        ق := ق + 1;
    }
    // عميق(ن) = ن + (ن + 1) + ن + 2ن عند ن = 0 و1 و2.
    إذا (المجموع != 1 + 6 + 11) { أرجع 4; };
    أرجع 42;
}
