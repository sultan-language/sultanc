// اختبار: تشغيل
// أهداف: x86_64-linux,x86_64-windows-msvc
// خروج: 42
// نظير: tests/en/codegen/x86_64_windows/win64_variadic_floats.sn
// نداء سي متغير المعاملات على Windows (شكل النداء المصرح `sprintf...2`):
// يمرر Microsoft x64 المعامل المتغير العشري في سجل XMM لخانته وفي سجل
// الخانة الصحيح أيضًا (يقرأ va_arg في المستدعى منطقة حفظ السجلات الصحيحة)،
// والمعامل اللاحق في خانة مكدسه؛ ويمرر Windows على Arm كل معامل متغير، والعشري
// منه، في سجلات x التالية. "%g/%d/%g|%d %g" مع 2.5 و7 و0.25 و9 و1.5 ينسق
// "2.5/7/0.25|9 1.5". على غيره يتحقق البرنامج من البايتات نفسها دون النداء.
إذا (الهدف.المنصة == «windows») {
    خارجي «msvcrt.dll» عرف نسق_خمسة(
        المخرج: *متغير ط8, الصيغة: *ط8, أ: ع64, ب: ص64, ج: ع64, د: ص64, هـ: ع64
    ): ص32 = «sprintf...2»;

    عرف المنسق(المخزن: &متغير متجه ط8): عدد {
        دع الصيغة: متجه ط8 = [37, 103, 47, 37, 100, 47, 37, 103, 124, 37, 100, 32, 37, 103, 0];
        دع ن: متغير ص32 = 0;
        غير_آمن { ن := نسق_خمسة(&متغير (*المخزن)[0], &الصيغة[0], 2.5, 7, 0.25, 9, 1.5); }
        أرجع ن مثل عدد;
    }
}
إذا (الهدف.المنصة != «windows») {
    عرف المنسق(المخزن: &متغير متجه ط8): عدد {
        دع النص: متجه ط8 = [50, 46, 53, 47, 55, 47, 48, 46, 50, 53, 124, 57, 32, 49, 46, 53];
        دع ف: متغير عدد = 0;
        طالما (ف < 16) { (*المخزن)[ف] := النص[ف]; ف := ف + 1; }
        أرجع 16;
    }
}

عرف الرئيسية(): عدد {
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير عدد = 0;
    طالما (ف < 64) { ألحق(المخزن, 0); ف := ف + 1; }
    إذا (المنسق(&متغير المخزن) != 16) { أرجع 1; };
    دع المتوقع: متجه ط8 = [50, 46, 53, 47, 55, 47, 48, 46, 50, 53, 124, 57, 32, 49, 46, 53];
    دع ك: متغير عدد = 0;
    طالما (ك < 16) {
        إذا (المخزن[ك] != المتوقع[ك]) { أرجع 10 + ك; };
        ك := ك + 1;
    }
    أرجع 42;
}
