عرف تحقق_معاملات_ضيقة_مكدسية(
    أ: ص8,
    ب: ص8,
    ج: ص8,
    د: ص8,
    هـ: ص8,
    و: ص8,
    موقع_مكدسي: ص8,
    غير_موقع_مكدسي: غ8
): ص32 {
    لو (موقع_مكدسي != -2) { أرجع 1; };
    لو (غير_موقع_مكدسي != 254) { أرجع 2; };
    أرجع 42;
}

عرف القلعة(): ص32 {
    أرجع تحقق_معاملات_ضيقة_مكدسية(1, 2, 3, 4, 5, 6, -2, 254);
}
