// اختبار: تشغيل
// أهداف: x86_64-linux,x86_64-darwin,aarch64-linux-gnu,aarch64-android,x86_64-android,x86_64-freebsd,aarch64-freebsd
// خروج: 42
// نظير: tests/en/codegen/x86_64_darwin/process_entry_startup.sn
// مدخل العملية الأصلي يسجل argc وargv وenvp قبل مدخل اللغة: _start على
// Linux يقرؤها من مكدس النواة الأولي، وعلى x86-64 macOS يأخذها من نداء dyld
// لـ `_main` (في RDI وRSI وRDX) ويشغل dyld مهيئ الوحدة من __mod_init_func.
// يقرؤها البرنامج عبر std ويتحقق من عام يضبطه مهيئ الوحدة.
استورد std.process.argument_count;
استورد std.process.argument;
استورد std.env.environment;

دع الأساس: متجه ط64 = [40, 2];

عرف الرئيسية(): عدد {
    إذا (عدد_الوسائط() < 1) { أرجع 1; };
    طابق وسيطة(0) مع
    | اختياري.موجود(النص) -> { إذا (الطول(النص) == 0) { أرجع 2; }; }
    | اختياري.لا_شيء -> { أرجع 3; };
    دع الاسم: نص = «PATH»;
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> { }
    | _ -> { أرجع 4; };
    أرجع (الأساس[0] + الأساس[1]) مثل عدد;
}
