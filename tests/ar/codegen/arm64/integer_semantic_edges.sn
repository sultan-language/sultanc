عرف الرئيسية(): ص32 {
    دع خلية_ص8: متغير ص8 = -2;
    دع خلية_ص16: متغير ص16 = -300;
    دع خلية_ص32: متغير ص32 = -70000;
    دع خلية_ط8: متغير ط8 = 128;
    دع خلية_ط16: متغير ط16 = 32768;
    دع خلية_ط32: متغير ط32 = 2147483648;

    دع مرجع_ص8: & متغير ص8 = & متغير خلية_ص8;
    دع مرجع_ص16: & متغير ص16 = & متغير خلية_ص16;
    دع مرجع_ص32: & متغير ص32 = & متغير خلية_ص32;
    دع مرجع_ط8: & متغير ط8 = & متغير خلية_ط8;
    دع مرجع_ط16: & متغير ط16 = & متغير خلية_ط16;
    دع مرجع_ط32: & متغير ط32 = & متغير خلية_ط32;

    دع ص8_محمل: ص8 = *مرجع_ص8;
    دع ص16_محمل: ص16 = *مرجع_ص16;
    دع ص32_محمل: ص32 = *مرجع_ص32;
    دع ط8_محمل: ط8 = *مرجع_ط8;
    دع ط16_محمل: ط16 = *مرجع_ط16;
    دع ط32_محمل: ط32 = *مرجع_ط32;

    إذا (ص8_محمل != -2) { أرجع 1; };
    إذا (ص16_محمل != -300) { أرجع 2; };
    إذا (ص32_محمل != -70000) { أرجع 3; };
    إذا (ط8_محمل != 128) { أرجع 4; };
    إذا (ط16_محمل != 32768) { أرجع 5; };
    إذا (ط32_محمل != 2147483648) { أرجع 6; };

    دع إزاحة_منطقية_موقعة: ص8 = ص8_محمل >> 1;
    إذا (إزاحة_منطقية_موقعة != 127) { أرجع 7; };

    دع إزاحة_حسابية_طبيعية: ط8 = ط8_محمل >>> 1;
    إذا (إزاحة_حسابية_طبيعية != 192) { أرجع 8; };

    دع سالب_واحد: ص8 = ص8_محمل + 1;
    دع موسع_طبيعي: ط16 = سالب_واحد مثل ط16;
    إذا (موسع_طبيعي != 65535) { أرجع 9; };

    دع موسع_موقع: ص16 = ط8_محمل مثل ص16;
    إذا (موسع_موقع != 128) { أرجع 10; };

    دع واسع: ص64 = (ط32_محمل مثل ص64) + 255;
    دع مضيق: ص8 = واسع مثل ص8;
    *مرجع_ص8 := مضيق;
    إذا (*مرجع_ص8 != -1) { أرجع 11; };

    دع مقسوم_عليه: ص16 = 7;
    دع خارج: ص16 = ص16_محمل / مقسوم_عليه;
    دع باقي: ص16 = ص16_محمل % مقسوم_عليه;
    إذا (خارج != -42) { أرجع 12; };
    إذا (باقي != -6) { أرجع 13; };

    دع مقسوم_عليه_طبيعي: ط32 = 3;
    دع خارج_طبيعي: ط32 = ط32_محمل / مقسوم_عليه_طبيعي;
    دع باقي_طبيعي: ط32 = ط32_محمل % مقسوم_عليه_طبيعي;
    إذا (خارج_طبيعي != 715827882) { أرجع 14; };
    إذا (باقي_طبيعي != 2) { أرجع 15; };

    دع واحد: ط8 = ط8_محمل >> 7;
    دع يسار: ط8 = واحد << 5;
    إذا (يسار != 32) { أرجع 16; };

    دع مجموع: ص16 = خارج + 2;
    دع مطروح: ص16 = مجموع - 1;
    دع مضروب: ص16 = مطروح * -1;
    إذا (مضروب != 41) { أرجع 17; };

    إذا (!(ص32_محمل < -1)) { أرجع 18; };
    إذا (!(ط32_محمل > 2147483647)) { أرجع 19; };

    أرجع 42;
}
