عرف القلعة(): ص32 {
    دع خلية_ص8: متغير ص8 = -2;
    دع خلية_ص16: متغير ص16 = -300;
    دع خلية_ص32: متغير ص32 = -70000;
    دع خلية_غ8: متغير غ8 = 128;
    دع خلية_غ16: متغير غ16 = 32768;
    دع خلية_غ32: متغير غ32 = 2147483648;

    دع مرجع_ص8: & متغير ص8 = & متغير خلية_ص8;
    دع مرجع_ص16: & متغير ص16 = & متغير خلية_ص16;
    دع مرجع_ص32: & متغير ص32 = & متغير خلية_ص32;
    دع مرجع_غ8: & متغير غ8 = & متغير خلية_غ8;
    دع مرجع_غ16: & متغير غ16 = & متغير خلية_غ16;
    دع مرجع_غ32: & متغير غ32 = & متغير خلية_غ32;

    دع ص8_محمل: ص8 = *مرجع_ص8;
    دع ص16_محمل: ص16 = *مرجع_ص16;
    دع ص32_محمل: ص32 = *مرجع_ص32;
    دع غ8_محمل: غ8 = *مرجع_غ8;
    دع غ16_محمل: غ16 = *مرجع_غ16;
    دع غ32_محمل: غ32 = *مرجع_غ32;

    لو (ص8_محمل != -2) { أرجع 1; };
    لو (ص16_محمل != -300) { أرجع 2; };
    لو (ص32_محمل != -70000) { أرجع 3; };
    لو (غ8_محمل != 128) { أرجع 4; };
    لو (غ16_محمل != 32768) { أرجع 5; };
    لو (غ32_محمل != 2147483648) { أرجع 6; };

    دع إزاحة_منطقية_موقعة: ص8 = ص8_محمل >> 1;
    لو (إزاحة_منطقية_موقعة != 127) { أرجع 7; };

    دع إزاحة_حسابية_غير_موقعة: غ8 = غ8_محمل >>> 1;
    لو (إزاحة_حسابية_غير_موقعة != 192) { أرجع 8; };

    دع سالب_واحد: ص8 = ص8_محمل + 1;
    دع موسع_غير_موقع: غ16 = سالب_واحد مثل غ16;
    لو (موسع_غير_موقع != 65535) { أرجع 9; };

    دع موسع_موقع: ص16 = غ8_محمل مثل ص16;
    لو (موسع_موقع != 128) { أرجع 10; };

    دع واسع: ص64 = (غ32_محمل مثل ص64) + 255;
    دع مضيق: ص8 = واسع مثل ص8;
    *مرجع_ص8 := مضيق;
    لو (*مرجع_ص8 != -1) { أرجع 11; };

    دع مقسوم_عليه: ص16 = 7;
    دع خارج: ص16 = ص16_محمل / مقسوم_عليه;
    دع باقي: ص16 = ص16_محمل % مقسوم_عليه;
    لو (خارج != -42) { أرجع 12; };
    لو (باقي != -6) { أرجع 13; };

    دع مقسوم_عليه_غير_موقع: غ32 = 3;
    دع خارج_غير_موقع: غ32 = غ32_محمل / مقسوم_عليه_غير_موقع;
    دع باقي_غير_موقع: غ32 = غ32_محمل % مقسوم_عليه_غير_موقع;
    لو (خارج_غير_موقع != 715827882) { أرجع 14; };
    لو (باقي_غير_موقع != 2) { أرجع 15; };

    دع واحد: غ8 = غ8_محمل >> 7;
    دع يسار: غ8 = واحد << 5;
    لو (يسار != 32) { أرجع 16; };

    دع مجموع: ص16 = خارج + 2;
    دع مطروح: ص16 = مجموع - 1;
    دع مضروب: ص16 = مطروح * -1;
    لو (مضروب != 41) { أرجع 17; };

    لو (!(ص32_محمل < -1)) { أرجع 18; };
    لو (!(غ32_محمل > 2147483647)) { أرجع 19; };

    أرجع 42;
}
