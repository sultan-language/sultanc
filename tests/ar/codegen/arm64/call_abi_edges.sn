نوع قيمة_صغيرة = { الأول: ص64, الثاني: ص64 };
نوع قيمة_كبيرة = { الأول: ص64, الثاني: ص64, الثالث: ص64 };

عرف غير_الصغيرة(القيمة: متغير قيمة_صغيرة): ص64 {
    القيمة.الأول := 99;
    أرجع القيمة.الأول;
}

عرف غير_النسخة(القيمة: متغير قيمة_كبيرة): ص64 {
    القيمة.الأول := 99;
    أرجع القيمة.الأول;
}

عرف اصنع_صغيرة(البذرة: ص64): قيمة_صغيرة {
    دع القيمة: قيمة_صغيرة = { الأول: البذرة, الثاني: 2 };
    أرجع القيمة;
}

عرف اصنع_كبيرة(البذرة: ص64): قيمة_كبيرة {
    دع القيمة: قيمة_كبيرة = { الأول: البذرة, الثاني: 1, الثالث: 2 };
    أرجع القيمة;
}

عرف هوية_ضيقة(القيمة: ص8): ص8 {
    أرجع القيمة;
}

عرف مكدس_مضغوط(
    الأول: ص64,
    الثاني: ص64,
    الثالث: ص64,
    الرابع: ص64,
    الخامس: ص64,
    السادس: ص64,
    السابع: ص64,
    الثامن: ص64,
    التاسع: غ8,
    العاشر: غ8,
    الحادي_عشر: ص16
): ص64 {
    أرجع (التاسع مثل ص64) + (العاشر مثل ص64) + (الحادي_عشر مثل ص64);
}

عرف زد(المرجع: & متغير ص64): ص64 {
    *المرجع := *المرجع + 2;
    أرجع *المرجع;
}

عرف القلعة(): ص32 {
    دع الأصل_الصغير: متغير قيمة_صغيرة = { الأول: 40, الثاني: 2 };
    دع الصغيرة_المغيرة: ص64 = غير_الصغيرة(الأصل_الصغير);
    لو (الصغيرة_المغيرة != 99) { أرجع 1; };
    لو (الأصل_الصغير.الأول != 40) { أرجع 2; };

    دع الأصل: متغير قيمة_كبيرة = { الأول: 40, الثاني: 1, الثالث: 1 };
    دع النسخة_المغيرة: ص64 = غير_النسخة(الأصل);
    لو (النسخة_المغيرة != 99) { أرجع 3; };
    لو (الأصل.الأول != 40) { أرجع 4; };

    دع المعاد_المباشر: قيمة_صغيرة = اصنع_صغيرة(40);
    دع المعاد: قيمة_كبيرة = اصنع_كبيرة(39);
    دع الضيق: ص8 = هوية_ضيقة(-2);
    لو ((الضيق مثل ص64) != -2) { أرجع 5; };
    لو ((المعاد_المباشر.الأول + المعاد_المباشر.الثاني) != 42) { أرجع 6; };
    لو ((المعاد.الأول + المعاد.الثاني + المعاد.الثالث) != 42) { أرجع 7; };

    دع المكدس: ص64 = مكدس_مضغوط(10, 11, 12, 13, 14, 15, 16, 17, 40, 1, 1);
    لو (المكدس != 42) { أرجع 8; };

    دع الخلية: متغير ص64 = 40;
    دع الاسم_المستعار: ص64 = زد(& متغير الخلية);
    لو (الاسم_المستعار != 42) { أرجع 9; };
    لو (الخلية != 42) { أرجع 10; };

    أرجع 42;
}
