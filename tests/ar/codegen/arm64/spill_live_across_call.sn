    ليكن v31: متغير عدد = 31;
    ليكن قيمة_النداء: عدد = احتفظ(احتفظ(v31));
    إذا (v30 != 30) {
        أرجع 0;
    };
    ليكن المجموع: متغير عدد = قيمة_النداء;
    المجموع := المجموع + v0;
    المجموع := المجموع + v1;
    المجموع := المجموع + v2;
    المجموع := المجموع + v3;
    المجموع := المجموع + v4;
