عرف احتفظ(القيمة: عدد): عدد {
    أرجع القيمة;
}

عرف الرئيسية(): عدد {
    ليكن v0: متغير عدد = 0;
    ليكن v1: متغير عدد = 1;
    ليكن v2: متغير عدد = 2;
    ليكن v3: متغير عدد = 3;
