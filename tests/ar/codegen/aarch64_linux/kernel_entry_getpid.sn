// اختبار: تشغيل
// أهداف: x86_64-linux,aarch64-linux-gnu
// خروج: 42
// نظير: tests/en/codegen/aarch64_linux/kernel_entry_getpid.sn
// الدخول المباشر إلى النواة: getpid (رقمه 39 على x86-64 و172 في جدول
// asm-generic لـ AArch64) يعيد معرف العملية الموجب نفسه الذي تعيده std.
// الخلفية الأصلية لـ AArch64 Linux تخفض النداء إلى svc #0 والرقم في x8
// والمعاملات في x0..x5.
استورد std.process.id;

// وفي غيره (يجمع المشغل كل اختبار لـ arm64-darwin أيضا) لا تُدخل النواة
// مباشرة ويقوم مقامها معرف std.
إذا (الهدف.المنصة == «linux» && الهدف.المعمارية == «aarch64») {
    عرف معرف_النواة(): ط64 { أرجع نداء_معرف_العملية(172); }
}
إذا (الهدف.المنصة == «linux» && الهدف.المعمارية == «x86_64») {
    عرف معرف_النواة(): ط64 { أرجع نداء_معرف_العملية(39); }
}
إذا (الهدف.المنصة != «linux») {
    عرف معرف_النواة(): ط64 { أرجع معرف_العملية(); }
}

إذا (الهدف.المنصة == «linux») {
    عرف نداء_معرف_العملية(الرقم: ط64): ط64 {
        دع الناتج: ط64;
        غير_آمن {
            الناتج := بدائي_نداء_نواة_خام(الرقم, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64);
        }
        أرجع الناتج;
    }
}

عرف الرئيسية(): عدد {
    دع الناتج: ط64 = معرف_النواة();
    إذا (الناتج == 0 || الناتج > 4194304) { أرجع 1; };
    إذا (الناتج != معرف_العملية()) { أرجع 2; };
    أرجع 42;
}
