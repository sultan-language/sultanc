// اختبار: تشغيل
// أهداف: x86_64-linux,aarch64-linux-gnu,aarch64-android,x86_64-android,x86_64-freebsd,aarch64-freebsd
// خروج: 42
// نظير: tests/en/codegen/aarch64_linux/std_threads_files_time.sn
// std على هدف Linux أصلي من طرف إلى طرف: أربعة خيوط يبدؤها استنساخ النواة
// تعيد مربعاتها عبر الضم، ويكتب ملف ثم يقرأ، والنوم يقدم الساعة الرتيبة،
// وساعة الجدار بعد 2020. على AArch64 كل ذلك نداءات نواة مباشرة.
استورد std.thread.thread;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.time.time;
استورد std.text.compare;

عرف مربع(ن: ط64): ط64 { أرجع ن * ن; }

عرف الرئيسية(): عدد {
    دع مقابض: متغير متجه مقبض_خيط_بقيمة<ط64> = [];
    دع ف: متغير ط64 = 0;
    طالما (ف < 4) {
        دع ن: ط64 = ف + 3;
        طابق أطلق_بقيمة(دالة(): ط64 -> مربع(ن)) مع
        | نتيجة.نجح(م) -> { ألحق(مقابض, م); }
        | نتيجة.خطأ(_) -> { أرجع 1; };
        ف := ف + 1;
    }
    دع المجموع: متغير ط64 = 0;
    دع ق: متغير طبيعي = 0;
    طالما (ق < 4) {
        طابق انضم_بقيمة(&متغير مقابض[ق]) مع
        | اختياري.موجود(القيمة) -> { المجموع := المجموع + القيمة; }
        | اختياري.لا_شيء -> { أرجع 2; };
        ق := ق + 1;
    }
    إذا (المجموع != 9 + 16 + 25 + 36) { أرجع 3; };

    دع المسار: نص = «build/native-systems-std.tmp»;
    دع المحتوى: نص = «native»;
    طابق اكتب_الملف(&المسار, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_الملف(&المسار) مع
    | نتيجة.خطأ(_) -> { أرجع 5; }
    | نتيجة.نجح(النص) -> { إذا (!نصان_متساويان(&النص, &المحتوى)) { أرجع 6; }; };

    دع قبل: متغير عدد = 0;
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(و) -> { قبل := و; }
    | نتيجة.خطأ(_) -> { أرجع 7; };
    نم_نانو(2000000);
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(و) -> { إذا (و - قبل < 2000000) { أرجع 8; }; }
    | نتيجة.خطأ(_) -> { أرجع 9; };
    طابق وقت_نظام_نانو() مع
    | نتيجة.نجح(و) -> { إذا (و < 1577836800000000000) { أرجع 10; }; }
    | نتيجة.خطأ(_) -> { أرجع 11; };
    أرجع 42;
}
