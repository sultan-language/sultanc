استورد std.process.child;
استورد std.env.environment;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.fs.metadata;
استورد std.fs.mutation;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.io.println;
استورد std.time.duration;

// هذا الملف هو الأساس المشترك لمشغل اختبارات SultanC.
// لا يملك أي قائمة حالات؛ الحالات تكتشف من ملفات .sn نفسها.

عام نوع نتيجة_أمر = {
    الحالة: عدد,
    الإشارة: عدد,
    الخرج: نص,
    الخطأ: نص
};

// A command's end: its status, the signal that ended it, and whether it ran
// past its time limit and was killed.
عام نوع نهاية_أمر_بمهلة = {
    الحالة: عدد,
    الإشارة: عدد,
    انتهت_المهلة: منطقي
};

عرف نهاية_من_حالة_إنهاء(النهاية: &حالة_إنهاء): نهاية_أمر_بمهلة {
    طابق *النهاية مع
    | حالة_إنهاء.خرج(الرمز) -> {
        دع ن: نهاية_أمر_بمهلة = { الحالة: الرمز, الإشارة: 0, انتهت_المهلة: خطأ };
        أرجع ن;
    }
    | حالة_إنهاء.إشارة(الرمز) -> {
        دع ن: نهاية_أمر_بمهلة = { الحالة: 128 + الرمز, الإشارة: الرمز, انتهت_المهلة: خطأ };
        أرجع ن;
    };
}

عرف نهاية_بلا_مهلة(البرنامج: &نص, الوسائط: &متجه نص): نهاية_أمر_بمهلة {
    طابق شغل_وانتظر(البرنامج, الوسائط) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
        أرجع ن;
    }
    | نتيجة.نجح(النهاية) -> { أرجع نهاية_من_حالة_إنهاء(&النهاية); };
}

// The time limit of each command, in seconds: SULTANC_TEST_TIMEOUT, 300 by
// default; 0 waits without a limit. One hung program (a server test waiting
// on a port, an interpreter loop) then costs this long, not the whole run.
عام عرف مهلة_الأوامر(): عدد {
    دع اسم: نص = «SULTANC_TEST_TIMEOUT»;
    دع افتراضي: نص = «300»;
    دع النص: نص = قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
    طابق حلل_عدد(&النص) مع
    | نتيجة.نجح(القيمة) -> { إذا (القيمة >= 0) { أرجع القيمة; }; }
    | نتيجة.خطأ(_) -> { };
    أرجع 300;
}

// Runs البرنامج and waits at most المهلة seconds (0: no limit); a command
// still running then is killed and reaped, with status 124 (as coreutils'
// timeout). std waits with a deadline on Linux, FreeBSD and macOS; Windows
// waits without one.
إذا (الهدف.المنصة == «windows») {
    عام عرف شغل_وانتظر_بمهلة(البرنامج: &نص, الوسائط: &متجه نص, المهلة: عدد): نهاية_أمر_بمهلة {
        أرجع نهاية_بلا_مهلة(البرنامج, الوسائط);
    }
} وإلا {
    عام عرف شغل_وانتظر_بمهلة(البرنامج: &نص, الوسائط: &متجه نص, المهلة: عدد): نهاية_أمر_بمهلة {
        إذا (المهلة <= 0) { أرجع نهاية_بلا_مهلة(البرنامج, الوسائط); };
        دع المدة: مدة;
        طابق مدة_من_ثواني(المهلة) مع
        | اختياري.لا_شيء -> { أرجع نهاية_بلا_مهلة(البرنامج, الوسائط); }
        | اختياري.موجود(م) -> { المدة := م; };
        دع الطفل: متغير عملية_طفلة;
        طابق شغل_عملية(البرنامج, الوسائط) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
            أرجع ن;
        }
        | نتيجة.نجح(ط) -> { الطفل := ط; };
        طابق انتظر_عملية_بمهلة(&متغير الطفل, &المدة) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
            أرجع ن;
        }
        | نتيجة.نجح(اختياري.موجود(النهاية)) -> { أرجع نهاية_من_حالة_إنهاء(&النهاية); }
        | نتيجة.نجح(اختياري.لا_شيء) -> {
            دع تجاهل: نتيجة اختياري حالة_إنهاء, عدد = اقتل_عملية(&متغير الطفل);
            دع ن: نهاية_أمر_بمهلة = { الحالة: 124, الإشارة: 0, انتهت_المهلة: صواب };
            أرجع ن;
        };
    }
}

// The result of a command, its time limit noted in the error output and on
// the runner's log when it was killed.
عرف نتيجة_من_نهاية(
    النهاية: &نهاية_أمر_بمهلة,
    الاسم: &نص,
    المهلة: عدد,
    مسار_الخرج: &نص,
    مسار_الخطأ: &نص
): نتيجة_أمر {
    دع الخطأ: متغير نص = اقرأ_إن_وجد(مسار_الخطأ);
    إذا ((*النهاية).انتهت_المهلة) {
        دع أجزاء: متجه نص = [استنسخ(&الخطأ), "\nsultanc test runner: killed after ", عدد_إلى_نص(المهلة), " s (SULTANC_TEST_TIMEOUT)\n"];
        الخطأ := اجمع_نصوص(&أجزاء);
        دع سطر: متجه نص = ["TIMEOUT\t", استنسخ(الاسم), "\t", عدد_إلى_نص(المهلة), « s»];
        اطبع_سطر_خطأ(اجمع_نصوص(&سطر));
    };
    دع النتيجة: نتيجة_أمر = {
        الحالة: (*النهاية).الحالة,
        الإشارة: (*النهاية).الإشارة,
        الخرج: اقرأ_إن_وجد(مسار_الخرج),
        الخطأ: الخطأ
    };
    أرجع النتيجة;
}

عام نوع ملخص_اختبارات = {
    الكلي: طبيعي,
    الناجح: طبيعي,
    الفاشل: طبيعي,
    المتجاوز: طبيعي,
    تجميع_فقط: طبيعي
};

عام عرف ملخص_جديد(): ملخص_اختبارات {
    دع الملخص: ملخص_اختبارات = {
        الكلي: 0,
        الناجح: 0,
        الفاشل: 0,
        المتجاوز: 0,
        تجميع_فقط: 0
    };
    أرجع الملخص;
}

عام عرف ألحق_نصا_إلى_بايتات(
    الناتج: &متغير متجه ط8,
    النص: &نص
): فراغ {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        ألحق(*الناتج, القيمة[ف]);
        ف := ف + 1;
    }
}

// Construct independent text for a container without moving an indexed element.
عام عرف انسخ_نص_اختبار(المصدر: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_نصا_إلى_بايتات(&متغير البايتات, المصدر);
    أرجع من_بايتات(&البايتات);
}

عام عرف اجمع_نصوص(الأجزاء: &متجه نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_نصا_إلى_بايتات(&متغير الناتج, &(*الأجزاء)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف نصان_متساويان_اختبار(أ: &نص, ب: &نص): منطقي {
    أرجع نصان_متساويان(أ, ب);
}

عام عرف اقتبس_لشل(القيمة: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, 0x27 مثل ط8);
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        إذا (النص[ف] == (0x27 مثل ط8)) {
            // التسلسل الآمن داخل اقتباس sh أحادي: '"'"'
            ألحق(الناتج, 0x27 مثل ط8);
            ألحق(الناتج, 0x22 مثل ط8);
            ألحق(الناتج, 0x27 مثل ط8);
            ألحق(الناتج, 0x22 مثل ط8);
            ألحق(الناتج, 0x27 مثل ط8);
        } وإلا {
            ألحق(الناتج, النص[ف]);
        };
        ف := ف + 1;
    }
    ألحق(الناتج, 0x27 مثل ط8);
    أرجع من_بايتات(&الناتج);
}

عام عرف تأكد_من_دليل(المسار: &نص): منطقي {
    طابق موجود(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | نتيجة.نجح(خطأ) -> {
        طابق أنشئ_دليلا(المسار) مع
        | نتيجة.نجح(_) -> { أرجع صواب; }
        | نتيجة.خطأ(_) -> { أرجع خطأ; };
    };
}

عام عرف جهز_دليل_العمل(): منطقي {
    دع بناء: نص = «build»;
    دع اختبارات: نص = «build/tests-sultanc»;
    إذا (!تأكد_من_دليل(&بناء)) { أرجع خطأ; };
    أرجع تأكد_من_دليل(&اختبارات);
}

عام عرف اقرأ_إن_وجد(المسار: &نص): نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع النص; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

عام عرف اكتب_فارغا(المسار: &نص): فراغ {
    دع فارغ: نص = «»;
    طابق اكتب_الملف(المسار, &فارغ) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عام عرف ابن_أمر_شل(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الخرج: &نص,
    الخطأ: &نص
): نص {
    دع الأجزاء: متغير متجه نص = [];
    دع تنفيذ: نص = «exec »;
    دع مسافة: نص = « »;
    دع تحويل_خرج: نص = « > »;
    دع تحويل_خطأ: نص = « 2> »;

    ألحق(الأجزاء, تنفيذ);
    ألحق(الأجزاء, اقتبس_لشل(البرنامج));

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق(الأجزاء, استنسخ(&مسافة));
        ألحق(الأجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }

    ألحق(الأجزاء, تحويل_خرج);
    ألحق(الأجزاء, اقتبس_لشل(الخرج));
    ألحق(الأجزاء, تحويل_خطأ);
    ألحق(الأجزاء, اقتبس_لشل(الخطأ));
    أرجع اجمع_نصوص(&الأجزاء);
}

// A command with its own time limit in seconds (0: none).
عام عرف نفذ_أمرا_بمهلة(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الاسم: &نص,
    المهلة: عدد
): نتيجة_أمر {
    دع بادئة: متجه نص = [«build/tests-sultanc/», اسم_ملف_أمر(الاسم)];
    دع أساس: نص = اجمع_نصوص(&بادئة);
    دع أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    دع أجزاء_خطأ: متجه نص = [أساس, «.err»];
    دع مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    دع مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);

    دع الأمر: نص = ابن_أمر_شل(البرنامج, الوسائط, &مسار_الخرج, &مسار_الخطأ);
    دع وسائط_شل: متجه نص = [«-c», الأمر];
    دع شل: نص = «/bin/sh»;
    // `exec`: the shell becomes the program, so a kill at the time limit
    // reaches the program itself.
    دع النهاية: نهاية_أمر_بمهلة = شغل_وانتظر_بمهلة(&شل, &وسائط_شل, المهلة);
    أرجع نتيجة_من_نهاية(&النهاية, الاسم, المهلة, &مسار_الخرج, &مسار_الخطأ);
}

عام عرف نفذ_أمرا(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الاسم: &نص
): نتيجة_أمر {
    أرجع نفذ_أمرا_بمهلة(البرنامج, الوسائط, الاسم, مهلة_الأوامر());
}

عام عرف قيمة_متغير_بيئة_أو(
    الاسم: &نص,
    الافتراضي: &نص
): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع استنسخ(الافتراضي); }
    | نتيجة.نجح(القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(النص) -> { أرجع النص; }
        | اختياري.لا_شيء -> { أرجع استنسخ(الافتراضي); };
    };
}

عام عرف مسار_المترجم(): نص {
    دع اسم: نص = «SULTANC_BIN»;
    دع افتراضي: نص = «./build/sultanc»;
    أرجع قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
}

عام عرف مسار_مترجم_المرحلة0(): اختياري نص {
    دع اسم: نص = «SULTANC_STAGE0_BIN»;
    طابق متغير_بيئة(&اسم) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}

عام عرف الهدف_المضيف(): اختياري نص {
    دع لا_وسائط: متجه نص = [];
    دع وسائط_النظام: متجه نص = [«-s»];
    دع وسائط_المعمارية: متجه نص = [«-m»];
    دع برنامج: نص = «uname»;
    دع اسم_النظام: نص = «host-system»;
    دع النظام: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_النظام, &اسم_النظام);
    دع اسم_المعمارية: نص = «host-machine»;
    دع المعمارية: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_المعمارية, &اسم_المعمارية);
    إذا ((النظام.الحالة != 0) || (المعمارية.الحالة != 0)) {
        أرجع اختياري.لا_شيء();
    };
    دع داروين: نص = «Darwin»;
    دع لينكس: نص = «Linux»;
    دع ارم: نص = «arm64»;
    دع ارم_بديل: نص = «aarch64»;
    دع اكس: نص = «x86_64»;
    دع اكس_بديل: نص = «amd64»;
    إذا (يحتوي_نصا(&النظام.الخرج, &داروين)
        && (يحتوي_نصا(&المعمارية.الخرج, &ارم) || يحتوي_نصا(&المعمارية.الخرج, &ارم_بديل))) {
        أرجع اختياري.موجود(«arm64-darwin»);
    };
    إذا (يحتوي_نصا(&النظام.الخرج, &لينكس)
        && (يحتوي_نصا(&المعمارية.الخرج, &اكس) || يحتوي_نصا(&المعمارية.الخرج, &اكس_بديل))) {
        أرجع اختياري.موجود(«x86_64-linux»);
    };
    أرجع اختياري.لا_شيء();
}

// تمييز فشل المترجم عن فشل تأكيد صادر عمداً من البرنامج المختبَر.
عرف نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة: &نتيجة_أمر, فحص_تأكيدات_المترجم: منطقي): منطقي {
    إذا ((*النتيجة).الإشارة != 0) { أرجع صواب; };
    دع علامات: متغير متجه نص = [
        «internal compiler error»,
        «SULTANC-ICE-PARSER-NO-RESULT»,
        «parser-no-result»,
        «segmentation fault»,
        «bus error»,
        «خطأ داخلي»
    ];
    إذا (فحص_تأكيدات_المترجم) {
        ألحق(علامات, «assertion failed»);
        ألحق(علامات, «assertion failure»);
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(علامات) مثل طبيعي)) {
        إذا (يحتوي_نصا(&(*النتيجة).الخرج, &علامات[ف]) || يحتوي_نصا(&(*النتيجة).الخطأ, &علامات[ف])) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف نتيجة_تحوي_فشلا_داخليا(النتيجة: &نتيجة_أمر): منطقي {
    أرجع نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة, صواب);
}

عام عرف نتيجة_تشغيل_تحوي_فشلا_داخليا(النتيجة: &نتيجة_أمر): منطقي {
    أرجع نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة, خطأ);
}

عام عرف بايتات_متساوية(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ملفات_متساوية(أ: &نص, ب: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(أ) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(بايتات_أ) -> {
        طابق اقرأ_بايتات_ملف(ب) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(بايتات_ب) -> { أرجع بايتات_متساوية(&بايتات_أ, &بايتات_ب); };
    };
}

عام عرف سجل_نجاح(الملخص: &متغير ملخص_اختبارات, الاسم: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الناجح := (*الملخص).الناجح + 1;
    دع أجزاء: متجه نص = ["PASS\t", استنسخ(الاسم)];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_فشل(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الفاشل := (*الملخص).الفاشل + 1;
    دع أجزاء: متجه نص = ["FAIL\t", استنسخ(الاسم), "\t", استنسخ(السبب)];
    اطبع_سطر_خطأ(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجاوز(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).المتجاوز := (*الملخص).المتجاوز + 1;
    دع أجزاء: متجه نص = ["SKIP\t", استنسخ(الاسم), "\t", استنسخ(السبب)];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجميع_فقط(الملخص: &متغير ملخص_اختبارات): فراغ {
    (*الملخص).تجميع_فقط := (*الملخص).تجميع_فقط + 1;
}

// A check's name as the file name of its output: a name that holds a test's
// path (`… (tests/en/x/main.sn)`) would otherwise name directories that do
// not exist, and the redirect would fail before the command ran.
عرف اسم_ملف_أمر(الاسم: &نص): نص {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(استنسخ(الاسم));
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البايتات) مثل طبيعي)) {
        إذا (البايتات[ف] == 0x2F || البايتات[ف] == 0x5C) { البايتات[ف] := 0x5F; };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف نفذ_نص_شل(الأمر: &نص, الاسم: &نص): نتيجة_أمر {
    دع بادئة: متجه نص = [«build/tests-sultanc/», اسم_ملف_أمر(الاسم)];
    دع أساس: نص = اجمع_نصوص(&بادئة);
    دع أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    دع أجزاء_خطأ: متجه نص = [أساس, «.err»];
    دع مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    دع مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);
    دع أجزاء_الأمر: متجه نص = [«( », استنسخ(الأمر), « ) > », اقتبس_لشل(&مسار_الخرج), « 2> », اقتبس_لشل(&مسار_الخطأ)];
    دع الكامل: نص = اجمع_نصوص(&أجزاء_الأمر);
    دع وسائط: متجه نص = [«-c», الكامل];
    دع شل: نص = «/bin/sh»;
    دع المهلة: عدد = مهلة_الأوامر();
    دع النهاية: نهاية_أمر_بمهلة = شغل_وانتظر_بمهلة(&شل, &وسائط, المهلة);
    أرجع نتيجة_من_نهاية(&النهاية, الاسم, المهلة, &مسار_الخرج, &مسار_الخطأ);
}

عام عرف نفذ_أمرا_في(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الدليل: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع أجزاء: متغير متجه نص = [«cd », اقتبس_لشل(الدليل), « && exec », « », اقتبس_لشل(البرنامج)];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق(أجزاء, « »);
        ألحق(أجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }
    دع الأمر: نص = اجمع_نصوص(&أجزاء);
    أرجع نفذ_نص_شل(&الأمر, الاسم);
}
