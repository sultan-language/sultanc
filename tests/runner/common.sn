استورد std.process.child;
استورد std.env.environment;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.fs.metadata;
استورد std.fs.mutation;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.io.println;

// هذا الملف هو الأساس المشترك لمشغل اختبارات SultanC.
// لا يملك أي قائمة حالات؛ الحالات تكتشف من ملفات .sn نفسها.

عام نوع نتيجة_أمر = {
    الحالة: عدد,
    الإشارة: عدد,
    الخرج: نص,
    الخطأ: نص
};

عام نوع ملخص_اختبارات = {
    الكلي: غير_موقع,
    الناجح: غير_موقع,
    الفاشل: غير_موقع,
    المتجاوز: غير_موقع,
    تجميع_فقط: غير_موقع
};

عام عرف ملخص_جديد(): ملخص_اختبارات {
    دع الملخص: ملخص_اختبارات = {
        الكلي: 0,
        الناجح: 0,
        الفاشل: 0,
        المتجاوز: 0,
        تجميع_فقط: 0
    };
    أرجع الملخص;
}

عام عرف ألحق_نصا_إلى_بايتات(
    الناتج: &متغير متجه غ8,
    النص: &نص
): فراغ {
    دع القيمة: نص = *النص;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        ألحق(*الناتج, القيمة[ف]);
        ف := ف + 1;
    }
}

// Construct independent text for a container without moving an indexed element.
عام عرف انسخ_نص_اختبار(المصدر: &نص): نص {
    دع البايتات: متغير متجه غ8 = [];
    ألحق_نصا_إلى_بايتات(&متغير البايتات, المصدر);
    أرجع من_بايتات(&البايتات);
}

عام عرف اجمع_نصوص(الأجزاء: &متجه نص): نص {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأجزاء) مثل غير_موقع)) {
        ألحق_نصا_إلى_بايتات(&متغير الناتج, &(*الأجزاء)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف نصان_متساويان_اختبار(أ: &نص, ب: &نص): منطقي {
    أرجع نصان_متساويان(أ, ب);
}

عام عرف اقتبس_لشل(القيمة: &نص): نص {
    دع الناتج: متغير متجه غ8 = [];
    ألحق(الناتج, 0x27 مثل غ8);
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        لو (النص[ف] == (0x27 مثل غ8)) {
            // التسلسل الآمن داخل اقتباس sh أحادي: '"'"'
            ألحق(الناتج, 0x27 مثل غ8);
            ألحق(الناتج, 0x22 مثل غ8);
            ألحق(الناتج, 0x27 مثل غ8);
            ألحق(الناتج, 0x22 مثل غ8);
            ألحق(الناتج, 0x27 مثل غ8);
        } وإلا {
            ألحق(الناتج, النص[ف]);
        };
        ف := ف + 1;
    }
    ألحق(الناتج, 0x27 مثل غ8);
    أرجع من_بايتات(&الناتج);
}

عام عرف تأكد_من_دليل(المسار: &نص): منطقي {
    طابق موجود(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | نتيجة.نجح(خطأ) -> {
        طابق أنشئ_دليلا(المسار) مع
        | نتيجة.نجح(_) -> { أرجع صواب; }
        | نتيجة.خطأ(_) -> { أرجع خطأ; };
    };
}

عام عرف جهز_دليل_العمل(): منطقي {
    دع بناء: نص = «build»;
    دع اختبارات: نص = «build/tests-sultanc»;
    لو (!تأكد_من_دليل(&بناء)) { أرجع خطأ; };
    أرجع تأكد_من_دليل(&اختبارات);
}

عام عرف اقرأ_إن_وجد(المسار: &نص): نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع النص; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

عام عرف اكتب_فارغا(المسار: &نص): فراغ {
    دع فارغ: نص = «»;
    طابق اكتب_الملف(المسار, &فارغ) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عام عرف ابن_أمر_شل(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الخرج: &نص,
    الخطأ: &نص
): نص {
    دع الأجزاء: متغير متجه نص = [];
    دع تنفيذ: نص = «exec »;
    دع مسافة: نص = « »;
    دع تحويل_خرج: نص = « > »;
    دع تحويل_خطأ: نص = « 2> »;

    ألحق(الأجزاء, تنفيذ);
    ألحق(الأجزاء, اقتبس_لشل(البرنامج));

    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الوسائط) مثل غير_موقع)) {
        ألحق(الأجزاء, مسافة);
        ألحق(الأجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }

    ألحق(الأجزاء, تحويل_خرج);
    ألحق(الأجزاء, اقتبس_لشل(الخرج));
    ألحق(الأجزاء, تحويل_خطأ);
    ألحق(الأجزاء, اقتبس_لشل(الخطأ));
    أرجع اجمع_نصوص(&الأجزاء);
}

عام عرف نفذ_أمرا(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الاسم: &نص
): نتيجة_أمر {
    دع بادئة: متجه نص = [«build/tests-sultanc/», *الاسم];
    دع أساس: نص = اجمع_نصوص(&بادئة);
    دع أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    دع أجزاء_خطأ: متجه نص = [أساس, «.err»];
    دع مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    دع مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);

    دع الأمر: نص = ابن_أمر_شل(البرنامج, الوسائط, &مسار_الخرج, &مسار_الخطأ);
    دع وسائط_شل: متجه نص = [«-c», الأمر];
    دع شل: نص = «/bin/sh»;
    دع الحالة: متغير عدد = -1000;
    دع الإشارة: متغير عدد = 0;

    طابق شغل_وانتظر(&شل, &وسائط_شل) مع
    | نتيجة.خطأ(الخطأ) -> { الحالة := الخطأ; }
    | نتيجة.نجح(النهاية) -> {
        طابق النهاية مع
        | حالة_إنهاء.خرج(الرمز) -> { الحالة := الرمز; }
        | حالة_إنهاء.إشارة(الرمز) -> {
            الحالة := 128 + الرمز;
            الإشارة := الرمز;
        };
    };

    دع النتيجة: نتيجة_أمر = {
        الحالة: الحالة,
        الإشارة: الإشارة,
        الخرج: اقرأ_إن_وجد(&مسار_الخرج),
        الخطأ: اقرأ_إن_وجد(&مسار_الخطأ)
    };
    أرجع النتيجة;
}

عام عرف قيمة_متغير_بيئة_أو(
    الاسم: &نص,
    الافتراضي: &نص
): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع *الافتراضي; }
    | نتيجة.نجح(القيمة) -> {
        طابق القيمة مع
        | اختيار.بعض(النص) -> { أرجع النص; }
        | اختيار.لا_شيء -> { أرجع *الافتراضي; };
    };
}

عام عرف مسار_المترجم(): نص {
    دع اسم: نص = «SULTANC_BIN»;
    دع افتراضي: نص = «./build/sultanc»;
    أرجع قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
}

عام عرف مسار_مترجم_المرحلة0(): اختيار نص {
    دع اسم: نص = «SULTANC_STAGE0_BIN»;
    طابق متغير_بيئة(&اسم) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}

عام عرف الهدف_المضيف(): اختيار نص {
    دع لا_وسائط: متجه نص = [];
    دع وسائط_النظام: متجه نص = [«-s»];
    دع وسائط_المعمارية: متجه نص = [«-m»];
    دع برنامج: نص = «uname»;
    دع اسم_النظام: نص = «host-system»;
    دع النظام: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_النظام, &اسم_النظام);
    دع اسم_المعمارية: نص = «host-machine»;
    دع المعمارية: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_المعمارية, &اسم_المعمارية);
    لو ((النظام.الحالة != 0) || (المعمارية.الحالة != 0)) {
        أرجع اختيار.لا_شيء();
    };
    دع داروين: نص = «Darwin»;
    دع لينكس: نص = «Linux»;
    دع ارم: نص = «arm64»;
    دع ارم_بديل: نص = «aarch64»;
    دع اكس: نص = «x86_64»;
    دع اكس_بديل: نص = «amd64»;
    لو (يحتوي_نصا(&النظام.الخرج, &داروين)
        && (يحتوي_نصا(&المعمارية.الخرج, &ارم) || يحتوي_نصا(&المعمارية.الخرج, &ارم_بديل))) {
        أرجع اختيار.بعض(«arm64-darwin»);
    };
    لو (يحتوي_نصا(&النظام.الخرج, &لينكس)
        && (يحتوي_نصا(&المعمارية.الخرج, &اكس) || يحتوي_نصا(&المعمارية.الخرج, &اكس_بديل))) {
        أرجع اختيار.بعض(«x86_64-linux»);
    };
    أرجع اختيار.لا_شيء();
}

عام عرف نتيجة_تحوي_فشلا_داخليا(النتيجة: &نتيجة_أمر): منطقي {
    دع علامات: متجه نص = [
        «internal compiler error»,
        «SULTANC-ICE-PARSER-NO-RESULT»,
        «parser-no-result»,
        «assertion failed»,
        «assertion failure»,
        «segmentation fault»,
        «bus error»,
        «خطأ داخلي»
    ];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(علامات) مثل غير_موقع)) {
        لو (يحتوي_نصا(&(*النتيجة).الخرج, &علامات[ف]) || يحتوي_نصا(&(*النتيجة).الخطأ, &علامات[ف])) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف بايتات_متساوية(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*أ) مثل غير_موقع)) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ملفات_متساوية(أ: &نص, ب: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(أ) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(بايتات_أ) -> {
        طابق اقرأ_بايتات_ملف(ب) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(بايتات_ب) -> { أرجع بايتات_متساوية(&بايتات_أ, &بايتات_ب); };
    };
}

عام عرف سجل_نجاح(الملخص: &متغير ملخص_اختبارات, الاسم: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الناجح := (*الملخص).الناجح + 1;
    دع أجزاء: متجه نص = ["PASS\t", *الاسم];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_فشل(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الفاشل := (*الملخص).الفاشل + 1;
    دع أجزاء: متجه نص = ["FAIL\t", *الاسم, "\t", *السبب];
    اطبع_سطر_خطأ(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجاوز(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).المتجاوز := (*الملخص).المتجاوز + 1;
    دع أجزاء: متجه نص = ["SKIP\t", *الاسم, "\t", *السبب];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجميع_فقط(الملخص: &متغير ملخص_اختبارات): فراغ {
    (*الملخص).تجميع_فقط := (*الملخص).تجميع_فقط + 1;
}

عام عرف نفذ_نص_شل(الأمر: &نص, الاسم: &نص): نتيجة_أمر {
    دع بادئة: متجه نص = [«build/tests-sultanc/», *الاسم];
    دع أساس: نص = اجمع_نصوص(&بادئة);
    دع أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    دع أجزاء_خطأ: متجه نص = [أساس, «.err»];
    دع مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    دع مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);
    دع أجزاء_الأمر: متجه نص = [«( », *الأمر, « ) > », اقتبس_لشل(&مسار_الخرج), « 2> », اقتبس_لشل(&مسار_الخطأ)];
    دع الكامل: نص = اجمع_نصوص(&أجزاء_الأمر);
    دع وسائط: متجه نص = [«-c», الكامل];
    دع شل: نص = «/bin/sh»;
    دع الحالة: متغير عدد = -1000;
    دع الإشارة: متغير عدد = 0;
    طابق شغل_وانتظر(&شل, &وسائط) مع
    | نتيجة.خطأ(الخطأ) -> { الحالة := الخطأ; }
    | نتيجة.نجح(النهاية) -> {
        طابق النهاية مع
        | حالة_إنهاء.خرج(الرمز) -> { الحالة := الرمز; }
        | حالة_إنهاء.إشارة(الرمز) -> { الحالة := 128 + الرمز; الإشارة := الرمز; };
    };
    دع النتيجة: نتيجة_أمر = {
        الحالة: الحالة,
        الإشارة: الإشارة,
        الخرج: اقرأ_إن_وجد(&مسار_الخرج),
        الخطأ: اقرأ_إن_وجد(&مسار_الخطأ)
    };
    أرجع النتيجة;
}

عام عرف نفذ_أمرا_في(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الدليل: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع أجزاء: متغير متجه نص = [«cd », اقتبس_لشل(الدليل), « && exec », « », اقتبس_لشل(البرنامج)];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الوسائط) مثل غير_موقع)) {
        ألحق(أجزاء, « »);
        ألحق(أجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }
    دع الأمر: نص = اجمع_نصوص(&أجزاء);
    أرجع نفذ_نص_شل(&الأمر, الاسم);
}
