استورد std.process.child;
استورد std.env.environment;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.read_file;
استورد std.fs.write_file;
استورد std.fs.metadata;
استورد std.fs.mutation;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.compare;
استورد std.text.from_bytes;
استورد std.io.println;
استورد std.time.duration;
استورد std.process.command;

// هذا الملف هو الأساس المشترك لمشغل اختبارات SultanC.
// لا يملك أي قائمة حالات؛ الحالات تكتشف من ملفات .sn نفسها.

عام نوع نتيجة_أمر = {
    الحالة: عدد,
    الإشارة: عدد,
    الخرج: نص,
    الخطأ: نص
};

// A command's end: its status, the signal that ended it, and whether it ran
// past its time limit and was killed.
عام نوع نهاية_أمر_بمهلة = {
    الحالة: عدد,
    الإشارة: عدد,
    انتهت_المهلة: منطقي
};

عرف نهاية_من_حالة_إنهاء(النهاية: &حالة_إنهاء): نهاية_أمر_بمهلة {
    طابق *النهاية مع
    | حالة_إنهاء.خرج(الرمز) -> {
        // Windows has no signals: a process ended by an exception (a trap is
        // 0xC000001D, an access violation 0xC0000005) exits with its NTSTATUS,
        // whose error severity is 0xC0000000 and up. Count it as a signal.
        ليكن إشارة: متغير عدد = 0;
        إذا (الرمز >= 3221225472) { إشارة := الرمز; };
        ليكن ن: نهاية_أمر_بمهلة = { الحالة: الرمز, الإشارة: إشارة, انتهت_المهلة: خطأ };
        أرجع ن;
    }
    | حالة_إنهاء.إشارة(الرمز) -> {
        ليكن ن: نهاية_أمر_بمهلة = { الحالة: 128 + الرمز, الإشارة: الرمز, انتهت_المهلة: خطأ };
        أرجع ن;
    };
}

عرف نهاية_بلا_مهلة(البرنامج: &نص, الوسائط: &متجه نص): نهاية_أمر_بمهلة {
    طابق شغل_وانتظر(البرنامج, الوسائط) مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
        أرجع ن;
    }
    | نتيجة.نجح(النهاية) -> { أرجع نهاية_من_حالة_إنهاء(&النهاية); };
}

// The time limit of each command, in seconds: SULTANC_TEST_TIMEOUT, 300 by
// default; 0 waits without a limit. One hung program (a server test waiting
// on a port, an interpreter loop) then costs this long, not the whole run.
عام عرف مهلة_الأوامر(): عدد {
    ليكن اسم: نص = «SULTANC_TEST_TIMEOUT»;
    ليكن افتراضي: نص = «300»;
    ليكن النص: نص = قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
    طابق حلل_عدد(&النص) مع
    | نتيجة.نجح(القيمة) -> { إذا (القيمة >= 0) { أرجع القيمة; }; }
    | نتيجة.خطأ(_) -> { };
    أرجع 300;
}

// Runs البرنامج and waits at most المهلة seconds (0: no limit); a command
// still running then is killed and reaped, with status 124 (as coreutils'
// timeout). std waits with a deadline on Linux, FreeBSD and macOS; Windows
// waits without one.
إذا (الهدف.المنصة == «windows») {
    عام عرف شغل_وانتظر_بمهلة(البرنامج: &نص, الوسائط: &متجه نص, المهلة: عدد): نهاية_أمر_بمهلة {
        أرجع نهاية_بلا_مهلة(البرنامج, الوسائط);
    }
} وإلا {
    عام عرف شغل_وانتظر_بمهلة(البرنامج: &نص, الوسائط: &متجه نص, المهلة: عدد): نهاية_أمر_بمهلة {
        إذا (المهلة <= 0) { أرجع نهاية_بلا_مهلة(البرنامج, الوسائط); };
        ليكن المدة: مدة;
        طابق مدة_من_ثواني(المهلة) مع
        | اختياري.لا_شيء -> { أرجع نهاية_بلا_مهلة(البرنامج, الوسائط); }
        | اختياري.موجود(م) -> { المدة := م; };
        ليكن الطفل: متغير عملية_طفلة;
        طابق شغل_عملية(البرنامج, الوسائط) مع
        | نتيجة.خطأ(الخطأ) -> {
            ليكن ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
            أرجع ن;
        }
        | نتيجة.نجح(ط) -> { الطفل := ط; };
        طابق انتظر_عملية_بمهلة(&متغير الطفل, &المدة) مع
        | نتيجة.خطأ(الخطأ) -> {
            ليكن ن: نهاية_أمر_بمهلة = { الحالة: الخطأ, الإشارة: 0, انتهت_المهلة: خطأ };
            أرجع ن;
        }
        | نتيجة.نجح(اختياري.موجود(النهاية)) -> { أرجع نهاية_من_حالة_إنهاء(&النهاية); }
        | نتيجة.نجح(اختياري.لا_شيء) -> {
            ليكن تجاهل: نتيجة اختياري حالة_إنهاء, عدد = اقتل_عملية(&متغير الطفل);
            ليكن ن: نهاية_أمر_بمهلة = { الحالة: 124, الإشارة: 0, انتهت_المهلة: صواب };
            أرجع ن;
        };
    }
}

// The result of a command, its time limit noted in the error output and on
// the runner's log when it was killed.
عرف نتيجة_من_نهاية(
    النهاية: &نهاية_أمر_بمهلة,
    الاسم: &نص,
    المهلة: عدد,
    مسار_الخرج: &نص,
    مسار_الخطأ: &نص
): نتيجة_أمر {
    ليكن الخطأ: متغير نص = اقرأ_إن_وجد(مسار_الخطأ);
    إذا ((*النهاية).انتهت_المهلة) {
        ليكن أجزاء: متجه نص = [استنسخ(&الخطأ), "\nsultanc test runner: killed after ", عدد_إلى_نص(المهلة), " s (SULTANC_TEST_TIMEOUT)\n"];
        الخطأ := اجمع_نصوص(&أجزاء);
        ليكن سطر: متجه نص = ["TIMEOUT\t", استنسخ(الاسم), "\t", عدد_إلى_نص(المهلة), « s»];
        اطبع_سطر_خطأ(اجمع_نصوص(&سطر));
    };
    ليكن النتيجة: نتيجة_أمر = {
        الحالة: (*النهاية).الحالة,
        الإشارة: (*النهاية).الإشارة,
        الخرج: اقرأ_إن_وجد(مسار_الخرج),
        الخطأ: الخطأ
    };
    أرجع النتيجة;
}

عام نوع ملخص_اختبارات = {
    الكلي: طبيعي,
    الناجح: طبيعي,
    الفاشل: طبيعي,
    المتجاوز: طبيعي,
    تجميع_فقط: طبيعي
};

عام عرف ملخص_جديد(): ملخص_اختبارات {
    ليكن الملخص: ملخص_اختبارات = {
        الكلي: 0,
        الناجح: 0,
        الفاشل: 0,
        المتجاوز: 0,
        تجميع_فقط: 0
    };
    أرجع الملخص;
}

عام عرف ألحق_نصا_إلى_بايتات(
    الناتج: &متغير متجه ط8,
    النص: &نص
): فراغ {
    ليكن القيمة: نص = *النص;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        ألحق(*الناتج, القيمة[ف]);
        ف := ف + 1;
    }
}

// Construct independent text for a container without moving an indexed element.
عام عرف انسخ_نص_اختبار(المصدر: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ألحق_نصا_إلى_بايتات(&متغير البايتات, المصدر);
    أرجع من_بايتات(&البايتات);
}

عام عرف اجمع_نصوص(الأجزاء: &متجه نص): نص {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_نصا_إلى_بايتات(&متغير الناتج, &(*الأجزاء)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف نصان_متساويان_اختبار(أ: &نص, ب: &نص): منطقي {
    أرجع نصان_متساويان(أ, ب);
}

عام عرف اقتبس_لشل(القيمة: &نص): نص {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, 0x27 مثل ط8);
    ليكن النص: نص = *القيمة;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        إذا (النص[ف] == (0x27 مثل ط8)) {
            // التسلسل الآمن داخل اقتباس sh أحادي: '"'"'
            ألحق(الناتج, 0x27 مثل ط8);
            ألحق(الناتج, 0x22 مثل ط8);
            ألحق(الناتج, 0x27 مثل ط8);
            ألحق(الناتج, 0x22 مثل ط8);
            ألحق(الناتج, 0x27 مثل ط8);
        } وإلا {
            ألحق(الناتج, النص[ف]);
        };
        ف := ف + 1;
    }
    ألحق(الناتج, 0x27 مثل ط8);
    أرجع من_بايتات(&الناتج);
}

عام عرف تأكد_من_دليل(المسار: &نص): منطقي {
    طابق موجود(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(صواب) -> { أرجع صواب; }
    | نتيجة.نجح(خطأ) -> {
        طابق أنشئ_دليلا(المسار) مع
        | نتيجة.نجح(_) -> { أرجع صواب; }
        | نتيجة.خطأ(_) -> { أرجع خطأ; };
    };
}

عام عرف جهز_دليل_العمل(): منطقي {
    ليكن بناء: نص = «build»;
    ليكن اختبارات: نص = «build/tests-sultanc»;
    إذا (!تأكد_من_دليل(&بناء)) { أرجع خطأ; };
    أرجع تأكد_من_دليل(&اختبارات);
}

عام عرف اقرأ_إن_وجد(المسار: &نص): نص {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.نجح(النص) -> { أرجع النص; }
    | نتيجة.خطأ(_) -> { أرجع «»; };
}

عام عرف اكتب_فارغا(المسار: &نص): فراغ {
    ليكن فارغ: نص = «»;
    طابق اكتب_الملف(المسار, &فارغ) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عام عرف ابن_أمر_شل(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الخرج: &نص,
    الخطأ: &نص
): نص {
    ليكن الأجزاء: متغير متجه نص = [];
    ليكن تنفيذ: نص = «exec »;
    ليكن مسافة: نص = « »;
    ليكن تحويل_خرج: نص = « > »;
    ليكن تحويل_خطأ: نص = « 2> »;

    ألحق(الأجزاء, تنفيذ);
    ألحق(الأجزاء, اقتبس_لشل(البرنامج));

    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق(الأجزاء, استنسخ(&مسافة));
        ألحق(الأجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }

    ألحق(الأجزاء, تحويل_خرج);
    ألحق(الأجزاء, اقتبس_لشل(الخرج));
    ألحق(الأجزاء, تحويل_خطأ);
    ألحق(الأجزاء, اقتبس_لشل(الخطأ));
    أرجع اجمع_نصوص(&الأجزاء);
}

// Windows runs each command itself, without a shell: std's Command captures
// both outputs (command_output_of, reading the two pipes as they fill) and
// they go to the same files a shell's redirections would fill. Windows waits
// without a time limit either way (شغل_وانتظر_بمهلة), and no POSIX shell
// is needed for a plain command (one runs under Wine too).
إذا (الهدف.المنصة == «windows») {
    عام عرف أوامر_بلا_شل(): منطقي { أرجع صواب; }
} وإلا {
    عام عرف أوامر_بلا_شل(): منطقي { أرجع خطأ; }
}

// A command run without a shell: البيئة its NAME=VALUE entries, الدليل
// its working directory ("" for this one), الدخل a file whose bytes are its
// standard input ("" for none); both outputs go to the two files.
عام عرف شغل_مباشرة_إلى_ملفين(
    البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, الدليل: &نص, الدخل: &نص,
    مسار_الخرج: &نص, مسار_الخطأ: &نص
): نهاية_أمر_بمهلة {
    ليكن لا_بدء: نهاية_أمر_بمهلة = { الحالة: 127, الإشارة: 0, انتهت_المهلة: خطأ };
    ليكن الأمر: متغير أمر = أنشئ_أمرا(البرنامج);
    أضف_وسائط_للأمر(&متغير الأمر, الوسائط);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البيئة) مثل طبيعي)) {
        ليكن المساواة: نص = «=»;
        طابق ابحث_نصا(&(*البيئة)[ف], &المساواة) مع
        | اختياري.موجود(الموضع) -> {
            ليكن الاسم: نص = جزء_نص_اختبار(&(*البيئة)[ف], 0, الموضع);
            ليكن القيمة: نص = جزء_نص_اختبار(&(*البيئة)[ف], الموضع + 1, الطول((*البيئة)[ف]) مثل طبيعي);
            طابق اضبط_بيئة_للأمر(&متغير الأمر, &الاسم, &القيمة) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> { أرجع لا_بدء; };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا ((الطول(*الدليل) مثل طبيعي) > 0) { اضبط_دليل_الأمر(&متغير الأمر, الدليل); };
    إذا ((الطول(*الدخل) مثل طبيعي) > 0) {
        ليكن مسار_الدخل: متغير نص = استنسخ(الدخل);
        إذا ((الطول(*الدليل) مثل طبيعي) > 0) { مسار_الدخل := اجمع_نصوص(&[استنسخ(الدليل), «/», استنسخ(الدخل)]); };
        طابق اقرأ_بايتات_ملف(&مسار_الدخل) مع
        | نتيجة.نجح(البايتات) -> { اضبط_بيانات_دخل_الأمر(&متغير الأمر, &البايتات); }
        | نتيجة.خطأ(_) -> { أرجع لا_بدء; };
    };
    طابق اجمع_خرج_الأمر(&الأمر) مع
    | نتيجة.خطأ(_) -> { أرجع لا_بدء; }
    | نتيجة.نجح(الناتج) -> {
        ليكن الخرج: نص = من_بايتات(&الناتج.الخرج);
        ليكن الخطأ: نص = من_بايتات(&الناتج.الخطأ);
        طابق اكتب_الملف(مسار_الخرج, &الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        طابق اكتب_الملف(مسار_الخطأ, &الخطأ) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { };
        أرجع نهاية_من_حالة_إنهاء(&الناتج.الحالة);
    };
}

// The bytes of النص from البداية up to النهاية (exclusive).
عام عرف جزء_نص_اختبار(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(البايتات, (*النص)[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

// One line of النص from البداية (up to its \n, at most 300 bytes) as a CI
// log can show it: \r, \t and other control bytes become escapes.
عرف سطر_مرئي(النص: &نص, البداية: طبيعي): نص {
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (البداية >= الطول_الكلي) { أرجع «<end of output>»; };
    ليكن الأرقام: نص = «0123456789abcdef»;
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < الطول_الكلي && (*النص)[ف] != 0x0A && ف < البداية + 300) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب == 0x0D) {
            ألحق(الناتج, 0x5C مثل ط8); ألحق(الناتج, 0x72 مثل ط8);
        } وإلا إذا (ب == 0x09) {
            ألحق(الناتج, 0x5C مثل ط8); ألحق(الناتج, 0x74 مثل ط8);
        } وإلا إذا (ب < 0x20) {
            ألحق(الناتج, 0x5C مثل ط8); ألحق(الناتج, 0x78 مثل ط8);
            ألحق(الناتج, الأرقام[(ب مثل طبيعي) / 16]); ألحق(الناتج, الأرقام[(ب مثل طبيعي) % 16]);
        } وإلا {
            ألحق(الناتج, ب);
        };
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

// The first العدد lines of النص, each as سطر_مرئي shows it, indented.
عام عرف أسطر_أولى_مرئية(النص: &نص, العدد: طبيعي): نص {
    ليكن الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن الأجزاء: متغير متجه نص = [];
    ليكن البداية: متغير طبيعي = 0;
    ليكن ع: متغير طبيعي = 0;
    طالما (ع < العدد && البداية < الطول_الكلي) {
        ألحق(الأجزاء, "\n    | ");
        ألحق(الأجزاء, سطر_مرئي(النص, البداية));
        طالما (البداية < الطول_الكلي && (*النص)[البداية] != 0x0A) { البداية := البداية + 1; }
        البداية := البداية + 1;
        ع := ع + 1;
    }
    إذا (البداية < الطول_الكلي) { ألحق(الأجزاء, "\n    | ..."); };
    أرجع اجمع_نصوص(&الأجزاء);
}

// Where two outputs first differ: the line, both versions of it, the byte
// counts, and the start of the actual output.
عام عرف وصف_أول_اختلاف(المتوقع: &نص, الفعلي: &نص): نص {
    ليكن طول_م: طبيعي = الطول(*المتوقع) مثل طبيعي;
    ليكن طول_ف: طبيعي = الطول(*الفعلي) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    ليكن السطر: متغير طبيعي = 1;
    ليكن بداية_السطر: متغير طبيعي = 0;
    طالما (ف < طول_م && ف < طول_ف && (*المتوقع)[ف] == (*الفعلي)[ف]) {
        إذا ((*المتوقع)[ف] == 0x0A) { السطر := السطر + 1; بداية_السطر := ف + 1; };
        ف := ف + 1;
    }
    ليكن الأجزاء: متجه نص = [
        "\n  first difference at line ", عدد_إلى_نص(السطر مثل عدد),
        « (expected », عدد_إلى_نص(طول_م مثل عدد), « bytes, got », عدد_إلى_نص(طول_ف مثل عدد), « bytes)»,
        "\n  expected: ", سطر_مرئي(المتوقع, بداية_السطر),
        "\n  actual:   ", سطر_مرئي(الفعلي, بداية_السطر),
        "\n  actual output:", أسطر_أولى_مرئية(الفعلي, 8)
    ];
    أرجع اجمع_نصوص(&الأجزاء);
}

// A failure reason followed by the command's status and the start of its
// standard error (then its output, when the error is empty).
عام عرف سبب_مع_خرج(السبب: &نص, النتيجة: &نتيجة_أمر): نص {
    ليكن مصدر: متغير نص = استنسخ(&(*النتيجة).الخطأ);
    إذا ((الطول(مصدر) مثل طبيعي) == 0) { مصدر := استنسخ(&(*النتيجة).الخرج); };
    ليكن الأجزاء: متجه نص = [
        انسخ_نص_اختبار(السبب), "\n  exit status ", عدد_إلى_نص((*النتيجة).الحالة),
        « signal », عدد_إلى_نص((*النتيجة).الإشارة), أسطر_أولى_مرئية(&مصدر, 15)
    ];
    أرجع اجمع_نصوص(&الأجزاء);
}

// The same, named and with its two output files under build/tests-sultanc,
// as نفذ_أمرا gives them.
عام عرف نفذ_مباشرة(
    البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, الدليل: &نص, الدخل: &نص, الاسم: &نص
): نتيجة_أمر {
    ليكن بادئة: متجه نص = [«build/tests-sultanc/», اسم_ملف_أمر(الاسم)];
    ليكن مسار_الخرج: نص = اجمع_نصوص(&[اجمع_نصوص(&بادئة), «.out»]);
    ليكن مسار_الخطأ: نص = اجمع_نصوص(&[اجمع_نصوص(&بادئة), «.err»]);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);
    ليكن النهاية: نهاية_أمر_بمهلة = شغل_مباشرة_إلى_ملفين(
        البرنامج, الوسائط, البيئة, الدليل, الدخل, &مسار_الخرج, &مسار_الخطأ
    );
    أرجع نتيجة_من_نهاية(&النهاية, الاسم, 0, &مسار_الخرج, &مسار_الخطأ);
}

// On Windows `env NAME=VALUE... PROGRAM ARGS...` (مسار_env_الاختبار) is
// done here: its entries set on the command, PROGRAM run directly.
عرف شغل_إلى_ملفين(البرنامج: &نص, الوسائط: &متجه نص, مسار_الخرج: &نص, مسار_الخطأ: &نص): نهاية_أمر_بمهلة {
    ليكن البيئة: متغير متجه نص = [];
    ليكن فارغ: نص = «»;
    ليكن env: نص = مسار_env_الاختبار();
    إذا (نصان_متساويان(البرنامج, &env)) {
        ليكن المساواة: نص = «=»;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*الوسائط) مثل طبيعي) && يحتوي_نصا(&(*الوسائط)[ف], &المساواة)) {
            ألحق(البيئة, استنسخ(&(*الوسائط)[ف]));
            ف := ف + 1;
        }
        إذا (ف < (الطول(*الوسائط) مثل طبيعي)) {
            ليكن البقية: متغير متجه نص = [];
            ليكن ي: متغير طبيعي = ف + 1;
            طالما (ي < (الطول(*الوسائط) مثل طبيعي)) { ألحق(البقية, استنسخ(&(*الوسائط)[ي])); ي := ي + 1; }
            أرجع شغل_مباشرة_إلى_ملفين(&(*الوسائط)[ف], &البقية, &البيئة, &فارغ, &فارغ, مسار_الخرج, مسار_الخطأ);
        };
    };
    أرجع شغل_مباشرة_إلى_ملفين(البرنامج, الوسائط, &البيئة, &فارغ, &فارغ, مسار_الخرج, مسار_الخطأ);
}

// A command with its own time limit in seconds (0: none).
عام عرف نفذ_أمرا_بمهلة(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الاسم: &نص,
    المهلة: عدد
): نتيجة_أمر {
    ليكن بادئة: متجه نص = [«build/tests-sultanc/», اسم_ملف_أمر(الاسم)];
    ليكن أساس: نص = اجمع_نصوص(&بادئة);
    ليكن أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    ليكن أجزاء_خطأ: متجه نص = [أساس, «.err»];
    ليكن مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    ليكن مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);

    إذا (أوامر_بلا_شل()) {
        ليكن المباشرة: نهاية_أمر_بمهلة = شغل_إلى_ملفين(البرنامج, الوسائط, &مسار_الخرج, &مسار_الخطأ);
        أرجع نتيجة_من_نهاية(&المباشرة, الاسم, المهلة, &مسار_الخرج, &مسار_الخطأ);
    };
    ليكن الأمر: نص = ابن_أمر_شل(البرنامج, الوسائط, &مسار_الخرج, &مسار_الخطأ);
    ليكن وسائط_شل: متجه نص = [«-c», الأمر];
    ليكن شل: نص = مسار_شل_الاختبار();
    // `exec`: the shell becomes the program, so a kill at the time limit
    // reaches the program itself.
    ليكن النهاية: نهاية_أمر_بمهلة = شغل_وانتظر_بمهلة(&شل, &وسائط_شل, المهلة);
    أرجع نتيجة_من_نهاية(&النهاية, الاسم, المهلة, &مسار_الخرج, &مسار_الخطأ);
}

عام عرف نفذ_أمرا(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الاسم: &نص
): نتيجة_أمر {
    أرجع نفذ_أمرا_بمهلة(البرنامج, الوسائط, الاسم, مهلة_الأوامر());
}

عام عرف قيمة_متغير_بيئة_أو(
    الاسم: &نص,
    الافتراضي: &نص
): نص {
    طابق متغير_بيئة(الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع استنسخ(الافتراضي); }
    | نتيجة.نجح(القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(النص) -> { أرجع النص; }
        | اختياري.لا_شيء -> { أرجع استنسخ(الافتراضي); };
    };
}

// The POSIX tools the suites start: a shell for command lines and env for
// test environments. On Windows the runner is a native program with no /bin;
// tools/tests/ci_run.sh passes Git for Windows' sh and env (Windows paths) in
// SULTANC_TEST_SH and SULTANC_TEST_ENV.
عام عرف مسار_شل_الاختبار(): نص {
    ليكن اسم: نص = «SULTANC_TEST_SH»;
    ليكن افتراضي: نص = «/bin/sh»;
    أرجع قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
}

عام عرف مسار_env_الاختبار(): نص {
    ليكن اسم: نص = «SULTANC_TEST_ENV»;
    ليكن افتراضي: نص = «/usr/bin/env»;
    أرجع قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
}

// Is the target a Windows one?
// A target this host neither runs nor is: Windows elsewhere, Linux on Windows.
عام عرف هدف_غير_المضيف(): نص {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        إذا (هدف_ويندوز(&المضيف)) { أرجع «x86_64-linux»; };
    }
    | اختياري.لا_شيء -> { };
    أرجع «x86_64-windows-msvc»;
}

عام عرف هدف_ويندوز(الهدف: &نص): منطقي {
    ليكن ويندوز: نص = «-windows-»;
    أرجع يحتوي_نصا(الهدف, &ويندوز);
}

عام عرف مسار_المترجم(): نص {
    ليكن اسم: نص = «SULTANC_BIN»;
    ليكن افتراضي: نص = «./build/sultanc»;
    أرجع قيمة_متغير_بيئة_أو(&اسم, &افتراضي);
}

عام عرف مسار_مترجم_المرحلة0(): اختياري نص {
    ليكن اسم: نص = «SULTANC_STAGE0_BIN»;
    طابق متغير_بيئة(&اسم) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}

// The host's target: TARGET when tools/tests/ci_run.sh set it to a host target
// the runner knows (Windows included), else from uname (Linux and macOS,
// x86_64 and arm64).
عام عرف الهدف_المضيف(): اختياري نص {
    ليكن المعروفة: متجه نص = [
        «x86_64-linux», «aarch64-linux-gnu», «arm64-darwin», «x86_64-darwin», «x86_64-windows-msvc»,
        «aarch64-windows-msvc»
    ];
    ليكن اسم_الهدف: نص = «TARGET»;
    ليكن فارغ: نص = «»;
    ليكن من_البيئة: نص = قيمة_متغير_بيئة_أو(&اسم_الهدف, &فارغ);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المعروفة) مثل طبيعي)) {
        إذا (نصان_متساويان(&من_البيئة, &المعروفة[ف])) { أرجع اختياري.موجود(انسخ_نص_اختبار(&المعروفة[ف])); };
        ف := ف + 1;
    }
    ليكن وسائط_النظام: متجه نص = [«-s»];
    ليكن وسائط_المعمارية: متجه نص = [«-m»];
    ليكن برنامج: نص = «uname»;
    ليكن اسم_النظام: نص = «host-system»;
    ليكن النظام: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_النظام, &اسم_النظام);
    ليكن اسم_المعمارية: نص = «host-machine»;
    ليكن المعمارية: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط_المعمارية, &اسم_المعمارية);
    إذا ((النظام.الحالة != 0) || (المعمارية.الحالة != 0)) {
        أرجع اختياري.لا_شيء();
    };
    ليكن داروين: نص = «Darwin»;
    ليكن لينكس: نص = «Linux»;
    ليكن ارم: نص = «arm64»;
    ليكن ارم_بديل: نص = «aarch64»;
    ليكن اكس: نص = «x86_64»;
    ليكن اكس_بديل: نص = «amd64»;
    ليكن مضيف_ذراع: منطقي = يحتوي_نصا(&المعمارية.الخرج, &ارم) || يحتوي_نصا(&المعمارية.الخرج, &ارم_بديل);
    ليكن مضيف_إكس: منطقي = يحتوي_نصا(&المعمارية.الخرج, &اكس) || يحتوي_نصا(&المعمارية.الخرج, &اكس_بديل);
    إذا (يحتوي_نصا(&النظام.الخرج, &داروين)) {
        إذا (مضيف_ذراع) { أرجع اختياري.موجود(«arm64-darwin»); };
        إذا (مضيف_إكس) { أرجع اختياري.موجود(«x86_64-darwin»); };
    };
    إذا (يحتوي_نصا(&النظام.الخرج, &لينكس)) {
        إذا (مضيف_إكس) { أرجع اختياري.موجود(«x86_64-linux»); };
        إذا (مضيف_ذراع) { أرجع اختياري.موجود(«aarch64-linux-gnu»); };
    };
    أرجع اختياري.لا_شيء();
}

// The module sources a build of compiler/main.sn needs to match the compiler
// under test (cmake/CMakeLists.txt, SULTANC_COMPILER_CAPABILITY_ARGS): a
// compiler without the LLVM backend is built with LLVM's stub provider.
// The arguments the compiler under test was built with, so that a compiler
// the tests build is the same program: the backend that generated Stage2
// (SULTANC_TEST_STAGE2_BACKEND, set by the CI scripts; native and llvm give
// different bytes) and, without LLVM, the stub for its provider.
عام عرف وسائط_بناء_المترجم(): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن اسم_الخلفية: نص = «SULTANC_TEST_STAGE2_BACKEND»;
    ليكن فارغ: نص = «»;
    ليكن الخلفية: نص = قيمة_متغير_بيئة_أو(&اسم_الخلفية, &فارغ);
    إذا (!نصان_متساويان(&الخلفية, &فارغ)) {
        ليكن أجزاء: متجه نص = [«--backend=», انسخ_نص_اختبار(&الخلفية)];
        ألحق(الناتج, اجمع_نصوص(&أجزاء));
    };
    إذا (!المترجم_بإل_إل_في_إم()) {
        ألحق(الناتج, «--module-source=compiler.backend.provider.llvm.llvm_codegen=compiler/backend/provider/llvm/unavailable.sn»);
    };
    أرجع الناتج;
}

// تمييز فشل المترجم عن فشل تأكيد صادر عمداً من البرنامج المختبَر.
عرف نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة: &نتيجة_أمر, فحص_تأكيدات_المترجم: منطقي): منطقي {
    إذا ((*النتيجة).الإشارة != 0) { أرجع صواب; };
    ليكن علامات: متغير متجه نص = [
        «internal compiler error»,
        «SULTANC-ICE-PARSER-NO-RESULT»,
        «parser-no-result»,
        «segmentation fault»,
        «bus error»,
        «خطأ داخلي»
    ];
    إذا (فحص_تأكيدات_المترجم) {
        ألحق(علامات, «assertion failed»);
        ألحق(علامات, «assertion failure»);
    };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(علامات) مثل طبيعي)) {
        إذا (يحتوي_نصا(&(*النتيجة).الخرج, &علامات[ف]) || يحتوي_نصا(&(*النتيجة).الخطأ, &علامات[ف])) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف نتيجة_تحوي_فشلا_داخليا(النتيجة: &نتيجة_أمر): منطقي {
    أرجع نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة, صواب);
}

عام عرف نتيجة_تشغيل_تحوي_فشلا_داخليا(النتيجة: &نتيجة_أمر): منطقي {
    أرجع نتيجة_تحوي_فشلا_داخليا_بسياق(النتيجة, خطأ);
}

عام عرف بايتات_متساوية(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) {
        إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ملفات_متساوية(أ: &نص, ب: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(أ) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(بايتات_أ) -> {
        طابق اقرأ_بايتات_ملف(ب) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(بايتات_ب) -> { أرجع بايتات_متساوية(&بايتات_أ, &بايتات_ب); };
    };
}

عام عرف سجل_نجاح(الملخص: &متغير ملخص_اختبارات, الاسم: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الناجح := (*الملخص).الناجح + 1;
    ليكن أجزاء: متجه نص = ["PASS\t", استنسخ(الاسم)];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_فشل(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).الفاشل := (*الملخص).الفاشل + 1;
    ليكن أجزاء: متجه نص = ["FAIL\t", استنسخ(الاسم), "\t", استنسخ(السبب)];
    اطبع_سطر_خطأ(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجاوز(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السبب: &نص): فراغ {
    (*الملخص).الكلي := (*الملخص).الكلي + 1;
    (*الملخص).المتجاوز := (*الملخص).المتجاوز + 1;
    ليكن أجزاء: متجه نص = ["SKIP\t", استنسخ(الاسم), "\t", استنسخ(السبب)];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عام عرف سجل_تجميع_فقط(الملخص: &متغير ملخص_اختبارات): فراغ {
    (*الملخص).تجميع_فقط := (*الملخص).تجميع_فقط + 1;
}

// A check's name as the file name of its output: a name that holds a test's
// path (`… (tests/en/x/main.sn)`) would otherwise name directories that do
// not exist, and the redirect would fail before the command ran.
// A test's name as a file name in build/tests-sultanc: every byte no file
// name may hold on some host becomes "_": path separators, control bytes,
// and the characters Windows (NTFS) and CI artifacts refuse: " : < > | * ?
عرف اسم_ملف_أمر(الاسم: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = بايتات_من_نص(استنسخ(الاسم));
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(البايتات) مثل طبيعي)) {
        ليكن ب: ط8 = البايتات[ف];
        إذا (ب < 0x20 || ب == 0x2F || ب == 0x5C || ب == 0x22 || ب == 0x3A || ب == 0x3C || ب == 0x3E
            || ب == 0x7C || ب == 0x2A || ب == 0x3F) {
            البايتات[ف] := 0x5F;
        };
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف نفذ_نص_شل(الأمر: &نص, الاسم: &نص): نتيجة_أمر {
    ليكن بادئة: متجه نص = [«build/tests-sultanc/», اسم_ملف_أمر(الاسم)];
    ليكن أساس: نص = اجمع_نصوص(&بادئة);
    ليكن أجزاء_خرج: متجه نص = [اجمع_نصوص(&بادئة), «.out»];
    ليكن أجزاء_خطأ: متجه نص = [أساس, «.err»];
    ليكن مسار_الخرج: نص = اجمع_نصوص(&أجزاء_خرج);
    ليكن مسار_الخطأ: نص = اجمع_نصوص(&أجزاء_خطأ);
    اكتب_فارغا(&مسار_الخرج);
    اكتب_فارغا(&مسار_الخطأ);
    ليكن أجزاء_الأمر: متجه نص = [«( », استنسخ(الأمر), « ) > », اقتبس_لشل(&مسار_الخرج), « 2> », اقتبس_لشل(&مسار_الخطأ)];
    ليكن الكامل: نص = اجمع_نصوص(&أجزاء_الأمر);
    ليكن وسائط: متجه نص = [«-c», الكامل];
    ليكن شل: نص = مسار_شل_الاختبار();
    ليكن المهلة: عدد = مهلة_الأوامر();
    ليكن النهاية: نهاية_أمر_بمهلة = شغل_وانتظر_بمهلة(&شل, &وسائط, المهلة);
    أرجع نتيجة_من_نهاية(&النهاية, الاسم, المهلة, &مسار_الخرج, &مسار_الخطأ);
}

عام عرف نفذ_أمرا_في(
    البرنامج: &نص,
    الوسائط: &متجه نص,
    الدليل: &نص,
    الاسم: &نص
): نتيجة_أمر {
    إذا (أوامر_بلا_شل()) {
        ليكن لا_بيئة: متجه نص = [];
        ليكن لا_دخل: نص = «»;
        أرجع نفذ_مباشرة(البرنامج, الوسائط, &لا_بيئة, الدليل, &لا_دخل, الاسم);
    };
    ليكن أجزاء: متغير متجه نص = [«cd », اقتبس_لشل(الدليل), « && exec », « », اقتبس_لشل(البرنامج)];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        ألحق(أجزاء, « »);
        ألحق(أجزاء, اقتبس_لشل(&(*الوسائط)[ف]));
        ف := ف + 1;
    }
    ليكن الأمر: نص = اجمع_نصوص(&أجزاء);
    أرجع نفذ_نص_شل(&الأمر, الاسم);
}

// Whether the compiler under test includes the LLVM backend.
عام عرف المترجم_بإل_إل_في_إم(): منطقي {
    ليكن المترجم: نص = مسار_المترجم();
    ليكن الوسائط: متجه نص = [«--lang», «en», «--version»];
    ليكن الاسم: نص = «وضع الاختبار إصدار المترجم»;
    ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, &الوسائط, &الاسم);
    ليكن العلامة: نص = « llvm»;
    أرجع يحتوي_نصا(&النتيجة.الخرج, &العلامة);
}
