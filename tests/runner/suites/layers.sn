استورد "../common.sn";
استورد "../discovery.sn";
استورد std.text.search;
استورد std.text.compare;
استورد std.text.from_bytes;

// The standard library is three libraries (docs/en/reference/std-layers.md),
// after Rust's core, alloc and std: library/core (الأساس) needs neither the
// heap nor the OS, library/alloc (التخصيص) needs the heap only, library/std
// (المكتبة) is the rest and re-exports both. The compiler enforces the
// layering (each library sees only itself and the libraries beneath it);
// this suite checks it again from the sources, and checks what the compiler
// does not:
//
// - Platform code (Rust's tidy check src/tools/tidy/src/pal.rs): externs,
//   raw kernel calls, kernel threads and wasm memory growth appear only
//   under library/std/os, and only library/std/os imports std.os.platform.
//   A target guard outside std/os is allowed only in the std files listed
//   below (like tidy's EXCEPTION_PATHS, the list may only shrink); core and
//   alloc may choose code by architecture, and by the bare-metal
//   (freestanding) capability, never by operating system.
// - core imports only core, alloc only alloc and core.
// - No module path is in two libraries (only folder root files repeat, and a
//   split module whose alloc half imports its core half).
// - The canonical allocator interface (library/core/memory/allocator.sn)
//   names the entry points the compiler's table names, and std defines each
//   in one file.
//
// - Every re-export (`module NAME = LIBRARY.a.b;` in a root file) names a
//   library the declaring one sees and a module or folder that is there.
//
// Imports are resolved the way the compiler resolves them
// (compiler/frontend/module_loading/module_spellings.sn): each component
// through its folder's spellings in one library's root files (FOLDER/
// FOLDER.sn, LIBRARY.sn at the top), a re-exported child continuing in the
// re-exported library, then the longest prefix that names a module file of
// the library the walk ended in. Nothing reaches another library unless a
// root file re-exports it.

// ---- Text helpers ------------------------------------------------------------

عرف قطعة_طبقات(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(البايتات, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف مسافة_طبقات(البايت: ط8): منطقي {
    أرجع البايت == 0x20 || البايت == 0x09 || البايت == 0x0D;
}

// The lines of a text, without their line breaks.
عرف أسطر_طبقات(النص: &نص): متجه نص {
    دع الأسطر: متغير متجه نص = [];
    دع الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        إذا (ف == الطول_الكلي || (*النص)[ف] == 0x0A) {
            ألحق(الأسطر, قطعة_طبقات(النص, البداية, ف));
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الأسطر;
}

عرف شذب_طبقات(النص: &نص): نص {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*النص) مثل طبيعي;
    طالما (البداية < النهاية && مسافة_طبقات((*النص)[البداية])) { البداية := البداية + 1; }
    طالما (النهاية > البداية && مسافة_طبقات((*النص)[النهاية - 1])) { النهاية := النهاية - 1; }
    أرجع قطعة_طبقات(النص, البداية, النهاية);
}

// The parts of a text between the separator byte.
عرف قسم_طبقات(النص: &نص, الفاصل: ط8): متجه نص {
    دع الأجزاء: متغير متجه نص = [];
    دع الطول_الكلي: طبيعي = الطول(*النص) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= الطول_الكلي) {
        إذا (ف == الطول_الكلي || (*النص)[ف] == الفاصل) {
            ألحق(الأجزاء, قطعة_طبقات(النص, البداية, ف));
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الأجزاء;
}

عرف صل_طبقات(الأجزاء: &متجه نص, العدد: طبيعي, الفاصل: نص): نص {
    دع القطع: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (ف > 0) { ألحق(القطع, انسخ_نص_اختبار(&الفاصل)); };
        ألحق(القطع, انسخ_نص_اختبار(&(*الأجزاء)[ف]));
        ف := ف + 1;
    }
    أرجع اجمع_نصوص(&القطع);
}

عرف في_القائمة_طبقات(القائمة: &متجه نص, القيمة: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القائمة)[ف], القيمة)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// ---- Libraries, modules and spellings ------------------------------------------

// الهدف: a re-export's LIBRARY.a.b, "" for the folder's own child.
نوع تهجئة_طبقات = { المجلد: نص, التهجئة: نص, الاسم: نص, الهدف: نص };

نوع مكتبة_طبقات = {
    // One entry per source file: its library (std, alloc, core), its module
    // path (a.b) and its file.
    المكتبات: متجه نص,
    المسارات: متجه نص,
    الملفات: متجه نص,
    التهجئات: متجه تهجئة_طبقات,
    المجلدات_المحملة: متجه نص
};

// A library and the libraries beneath it, nearest first.
عرف سلسلة_مكتبة_طبقات(المكتبة: &نص): متجه نص {
    دع المكتبة_القياسية: نص = «std»;
    دع التخصيص: نص = «alloc»;
    إذا (نصان_متساويان(المكتبة, &المكتبة_القياسية)) {
        دع السلسلة: متجه نص = [«std», «alloc», «core»];
        أرجع السلسلة;
    };
    إذا (نصان_متساويان(المكتبة, &التخصيص)) {
        دع السلسلة: متجه نص = [«alloc», «core»];
        أرجع السلسلة;
    };
    دع السلسلة: متجه نص = [«core»];
    أرجع السلسلة;
}

// library/LIB/a/b.sn: LIB and a.b.
عرف مكتبة_ومسار_ملف_طبقات(الملف: &نص): متجه نص {
    دع البادئة: نص = «library/»;
    دع البداية: طبيعي = الطول(البادئة) مثل طبيعي;
    دع النهاية: طبيعي = (الطول(*الملف) مثل طبيعي) - 3;
    دع الشرطة: متغير طبيعي = البداية;
    طالما (الشرطة < النهاية && (*الملف)[الشرطة] != 0x2F) { الشرطة := الشرطة + 1; }
    دع المكتبة: نص = قطعة_طبقات(الملف, البداية, الشرطة);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = الشرطة + 1;
    طالما (ف < النهاية) {
        إذا ((*الملف)[ف] == 0x2F) { ألحق(البايتات, 0x2E مثل ط8); } وإلا { ألحق(البايتات, (*الملف)[ف]); };
        ف := ف + 1;
    }
    دع الناتج: متجه نص = [المكتبة, من_بايتات(&البايتات)];
    أرجع الناتج;
}

// Whether a.b is a folder's root file (FOLDER/FOLDER.sn) or the library's.
عرف ملف_جذر_طبقات_للمسار(المكتبة: &نص, المسار: &نص): منطقي {
    دع المكونات: متجه نص = قسم_طبقات(المسار, 0x2E);
    دع العدد: طبيعي = الطول(المكونات) مثل طبيعي;
    إذا (العدد == 1) { أرجع نصان_متساويان(&المكونات[0], المكتبة); };
    أرجع نصان_متساويان(&المكونات[العدد - 1], &المكونات[العدد - 2]);
}

// The root file of a library's folder (dotted, "" for the library itself).
عرف ملف_جذر_طبقات(المكتبة: &نص, المجلد: &نص): نص {
    إذا ((الطول(*المجلد) مثل طبيعي) == 0) {
        دع أجزاء: متجه نص = [«library/», انسخ_نص_اختبار(المكتبة), «/», انسخ_نص_اختبار(المكتبة), «.sn»];
        أرجع اجمع_نصوص(&أجزاء);
    };
    دع المكونات: متجه نص = قسم_طبقات(المجلد, 0x2E);
    دع المسار: نص = صل_طبقات(&المكونات, الطول(المكونات) مثل طبيعي, «/»);
    دع الأجزاء: متجه نص = [«library/», انسخ_نص_اختبار(المكتبة), «/», المسار, «/», انسخ_نص_اختبار(&المكونات[(الطول(المكونات) مثل طبيعي) - 1]), «.sn»];
    أرجع اجمع_نصوص(&الأجزاء);
}

// Reads the `module NAME { ar: SPELLING, fr: ... };` and `module NAME =
// LIBRARY.a.b { ... };` lines of a library folder's root file: the name
// itself and each spelling map to NAME, with the re-export's target.
عرف حمل_تهجئات_طبقات(المكتبة_المحملة: &متغير مكتبة_طبقات, المكتبة: &نص, المجلد: &نص): فراغ {
    دع المفتاح_أجزاء: متجه نص = [انسخ_نص_اختبار(المكتبة), «|», انسخ_نص_اختبار(المجلد)];
    دع المفتاح: نص = اجمع_نصوص(&المفتاح_أجزاء);
    إذا (في_القائمة_طبقات(&(*المكتبة_المحملة).المجلدات_المحملة, &المفتاح)) { أرجع; };
    ألحق((*المكتبة_المحملة).المجلدات_المحملة, انسخ_نص_اختبار(&المفتاح));
    دع الملف: نص = ملف_جذر_طبقات(المكتبة, المجلد);
    دع المحتوى: نص = اقرأ_إن_وجد(&الملف);
    دع الأسطر: متجه نص = أسطر_طبقات(&المحتوى);
    دع بادئة_الوحدة: نص = «module »;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        دع السطر: نص = شذب_طبقات(&الأسطر[ف]);
        إذا (يبدأ_بـ(&السطر, &بادئة_الوحدة)) {
            دع الطول_الكلي: طبيعي = الطول(السطر) مثل طبيعي;
            دع بداية_الاسم: طبيعي = الطول(بادئة_الوحدة) مثل طبيعي;
            دع نهاية_الاسم: متغير طبيعي = بداية_الاسم;
            طالما (نهاية_الاسم < الطول_الكلي && !مسافة_طبقات(السطر[نهاية_الاسم]) && السطر[نهاية_الاسم] != 0x7B
                && السطر[نهاية_الاسم] != 0x3D && السطر[نهاية_الاسم] != 0x3B) {
                نهاية_الاسم := نهاية_الاسم + 1;
            }
            دع الاسم: نص = قطعة_طبقات(&السطر, بداية_الاسم, نهاية_الاسم);
            دع الهدف: متغير نص = «»;
            دع بعد: متغير طبيعي = نهاية_الاسم;
            طالما (بعد < الطول_الكلي && مسافة_طبقات(السطر[بعد])) { بعد := بعد + 1; }
            إذا (بعد < الطول_الكلي && السطر[بعد] == 0x3D) {
                بعد := بعد + 1;
                طالما (بعد < الطول_الكلي && مسافة_طبقات(السطر[بعد])) { بعد := بعد + 1; }
                دع نهاية_الهدف: متغير طبيعي = بعد;
                طالما (نهاية_الهدف < الطول_الكلي && !مسافة_طبقات(السطر[نهاية_الهدف])
                    && السطر[نهاية_الهدف] != 0x7B && السطر[نهاية_الهدف] != 0x3B) {
                    نهاية_الهدف := نهاية_الهدف + 1;
                }
                الهدف := قطعة_طبقات(&السطر, بعد, نهاية_الهدف);
            };
            دع لنفسه: تهجئة_طبقات = {
                المجلد: انسخ_نص_اختبار(&المفتاح), التهجئة: انسخ_نص_اختبار(&الاسم),
                الاسم: انسخ_نص_اختبار(&الاسم), الهدف: انسخ_نص_اختبار(&الهدف)
            };
            ألحق((*المكتبة_المحملة).التهجئات, لنفسه);
            دع القوس: متغير طبيعي = نهاية_الاسم;
            طالما (القوس < الطول_الكلي && السطر[القوس] != 0x7B) { القوس := القوس + 1; }
            دع الإغلاق: متغير طبيعي = القوس;
            طالما (الإغلاق < الطول_الكلي && السطر[الإغلاق] != 0x7D) { الإغلاق := الإغلاق + 1; }
            إذا (الإغلاق < الطول_الكلي) {
                دع الداخل: نص = قطعة_طبقات(&السطر, القوس + 1, الإغلاق);
                دع الأزواج: متجه نص = قسم_طبقات(&الداخل, 0x2C);
                دع ز: متغير طبيعي = 0;
                طالما (ز < (الطول(الأزواج) مثل طبيعي)) {
                    دع الزوج: متجه نص = قسم_طبقات(&الأزواج[ز], 0x3A);
                    إذا ((الطول(الزوج) مثل طبيعي) == 2) {
                        دع المدخل: تهجئة_طبقات = {
                            المجلد: انسخ_نص_اختبار(&المفتاح),
                            التهجئة: شذب_طبقات(&الزوج[1]),
                            الاسم: انسخ_نص_اختبار(&الاسم),
                            الهدف: انسخ_نص_اختبار(&الهدف)
                        };
                        ألحق((*المكتبة_المحملة).التهجئات, المدخل);
                    };
                    ز := ز + 1;
                }
            };
        };
        ف := ف + 1;
    }
}

// An import path's components walked from the library المكتبة_الأولى: each
// mapped through its folder's spellings in the library being walked, a
// re-exported child continuing in the re-exported library at the
// re-exported path. The result is the library the walk ended in, then the
// canonical components.
عرف قنن_طبقات(المكتبة_المحملة: &متغير مكتبة_طبقات, المكتبة_الأولى: &نص, المكونات_الأولى: &متجه نص): متجه نص {
    دع المكتبة: متغير نص = انسخ_نص_اختبار(المكتبة_الأولى);
    دع المكونات: متغير متجه نص = [];
    دع ب: متغير طبيعي = 0;
    طالما (ب < (الطول(*المكونات_الأولى) مثل طبيعي)) { ألحق(المكونات, انسخ_نص_اختبار(&(*المكونات_الأولى)[ب])); ب := ب + 1; }
    دع الناتج: متغير متجه نص = [];
    دع القفزات: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكونات) مثل طبيعي)) {
        دع المجلد: نص = صل_طبقات(&الناتج, ف, «.»);
        حمل_تهجئات_طبقات(المكتبة_المحملة, &المكتبة, &المجلد);
        دع المفتاح_أجزاء: متجه نص = [انسخ_نص_اختبار(&المكتبة), «|», انسخ_نص_اختبار(&المجلد)];
        دع المفتاح: نص = اجمع_نصوص(&المفتاح_أجزاء);
        دع الاسم: متغير نص = انسخ_نص_اختبار(&المكونات[ف]);
        دع الهدف: متغير نص = «»;
        دع وجد: متغير منطقي = خطأ;
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول((*المكتبة_المحملة).التهجئات) مثل طبيعي)) {
            إذا (!وجد && نصان_متساويان(&(*المكتبة_المحملة).التهجئات[ت].المجلد, &المفتاح)
                && نصان_متساويان(&(*المكتبة_المحملة).التهجئات[ت].التهجئة, &المكونات[ف])) {
                الاسم := انسخ_نص_اختبار(&(*المكتبة_المحملة).التهجئات[ت].الاسم);
                الهدف := انسخ_نص_اختبار(&(*المكتبة_المحملة).التهجئات[ت].الهدف);
                وجد := صواب;
            };
            ت := ت + 1;
        }
        إذا ((الطول(الهدف) مثل طبيعي) > 0 && القفزات < 32) {
            القفزات := القفزات + 1;
            دع أجزاء_الهدف: متجه نص = قسم_طبقات(&الهدف, 0x2E);
            دع التالية: متغير متجه نص = [];
            دع ج: متغير طبيعي = 1;
            طالما (ج < (الطول(أجزاء_الهدف) مثل طبيعي)) { ألحق(التالية, انسخ_نص_اختبار(&أجزاء_الهدف[ج])); ج := ج + 1; }
            ج := ف + 1;
            طالما (ج < (الطول(المكونات) مثل طبيعي)) { ألحق(التالية, انسخ_نص_اختبار(&المكونات[ج])); ج := ج + 1; }
            المكتبة := انسخ_نص_اختبار(&أجزاء_الهدف[0]);
            المكونات := التالية;
            دع فارغ: متجه نص = [];
            الناتج := فارغ;
            ف := 0;
        } وإلا {
            ألحق(الناتج, الاسم);
            ف := ف + 1;
        };
    }
    دع الكل: متغير متجه نص = [المكتبة];
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الناتج) مثل طبيعي)) { ألحق(الكل, انسخ_نص_اختبار(&الناتج[ك])); ك := ك + 1; }
    أرجع الكل;
}

// The position of a library's module a.b, if any.
عرف موضع_وحدة_طبقات(المكتبة_المحملة: &مكتبة_طبقات, المكتبة: &نص, المسار: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المكتبة_المحملة).المسارات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المكتبة_المحملة).المسارات[ف], المسار)
            && نصان_متساويان(&(*المكتبة_المحملة).المكتبات[ف], المكتبة)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The module an import of a file in المكتبة names: its position. A first
// component that names a library (المكتبة/std, التخصيص/alloc, الأساس/core)
// selects that library; otherwise the path is the importer's library's.
عرف حل_استيراد_طبقات(المكتبة_المحملة: &متغير مكتبة_طبقات, المكتبة: &نص, المسار: &نص): اختياري طبيعي {
    دع المكونات: متغير متجه نص = قسم_طبقات(المسار, 0x2E);
    إذا ((الطول(المكونات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الجذور: متجه نص = [«المكتبة», «std», «التخصيص», «alloc», «الأساس», «core»];
    دع مكتبات_الجذور: متجه نص = [«std», «std», «alloc», «alloc», «core», «core»];
    دع مكتبة_البحث: متغير نص = انسخ_نص_اختبار(المكتبة);
    دع ج: متغير طبيعي = 0;
    طالما (ج < 6) {
        إذا (نصان_متساويان(&المكونات[0], &الجذور[ج])) {
            مكتبة_البحث := انسخ_نص_اختبار(&مكتبات_الجذور[ج]);
            دع البقية: متغير متجه نص = [];
            دع ف: متغير طبيعي = 1;
            طالما (ف < (الطول(المكونات) مثل طبيعي)) { ألحق(البقية, انسخ_نص_اختبار(&المكونات[ف])); ف := ف + 1; }
            المكونات := البقية;
            ج := 6;
        };
        ج := ج + 1;
    }
    دع المسير: متجه نص = قنن_طبقات(المكتبة_المحملة, &مكتبة_البحث, &المكونات);
    دع المكتبة_الأخيرة: نص = انسخ_نص_اختبار(&المسير[0]);
    دع المقننة: متغير متجه نص = [];
    دع ب: متغير طبيعي = 1;
    طالما (ب < (الطول(المسير) مثل طبيعي)) { ألحق(المقننة, انسخ_نص_اختبار(&المسير[ب])); ب := ب + 1; }
    دع ك: متغير طبيعي = الطول(المقننة) مثل طبيعي;
    طالما (ك > 0) {
        دع المرشح: نص = صل_طبقات(&المقننة, ك, «.»);
        طابق موضع_وحدة_طبقات(المكتبة_المحملة, &المكتبة_الأخيرة, &المرشح) مع
        | اختياري.موجود(الموضع) -> { أرجع اختياري.موجود(الموضع); }
        | اختياري.لا_شيء -> { };
        ك := ك - 1;
    }
    أرجع اختياري.لا_شيء();
}

// Whether a file of المكتبة, whose content is المحتوى, imports the module at
// الموضع.
عرف يستورد_موضعا_طبقات(المكتبة_المحملة: &متغير مكتبة_طبقات, المكتبة: &نص, المحتوى: &نص, الموضع: طبيعي): منطقي {
    دع الاستيرادات: متجه نص = استيرادات_طبقات(المحتوى);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الاستيرادات) مثل طبيعي)) {
        طابق حل_استيراد_طبقات(المكتبة_المحملة, المكتبة, &الاستيرادات[ف]) مع
        | اختياري.موجود(المستورد) -> { إذا (المستورد == الموضع) { أرجع صواب; }; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The module paths a file imports (quoted file imports are skipped: the
// standard library imports its modules by name).
عرف استيرادات_طبقات(المحتوى: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الأسطر: متجه نص = أسطر_طبقات(المحتوى);
    دع عربي: نص = «استورد »;
    دع انجليزي: نص = «import »;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        دع السطر: نص = شذب_طبقات(&الأسطر[ف]);
        دع البداية: متغير طبيعي = 0;
        إذا (يبدأ_بـ(&السطر, &عربي)) { البداية := الطول(عربي) مثل طبيعي; };
        إذا (يبدأ_بـ(&السطر, &انجليزي)) { البداية := الطول(انجليزي) مثل طبيعي; };
        إذا (البداية > 0 && البداية < (الطول(السطر) مثل طبيعي)
            && السطر[البداية] != 0x22 && السطر[البداية] != 0xC2) {
            دع النهاية: متغير طبيعي = البداية;
            طالما (النهاية < (الطول(السطر) مثل طبيعي) && السطر[النهاية] != 0x3B && !مسافة_طبقات(السطر[النهاية])) {
                النهاية := النهاية + 1;
            }
            ألحق(الناتج, قطعة_طبقات(&السطر, البداية, النهاية));
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف حمل_مكتبة_طبقات(): اختياري مكتبة_طبقات {
    دع المكتبات: متغير متجه نص = [];
    دع المسارات: متغير متجه نص = [];
    دع الملفات: متغير متجه نص = [];
    دع الأسماء: متجه نص = [«std», «alloc», «core»];
    دع م: متغير طبيعي = 0;
    طالما (م < 3) {
        دع الجذر_أجزاء: متجه نص = [«library/», انسخ_نص_اختبار(&الأسماء[م])];
        دع الجذر: نص = اجمع_نصوص(&الجذر_أجزاء);
        دع ملفات_المكتبة: متغير متجه نص = [];
        إذا (!اجمع_ملفات_سن(&الجذر, &متغير ملفات_المكتبة)) { أرجع اختياري.لا_شيء(); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(ملفات_المكتبة) مثل طبيعي)) {
            دع المكتبة_والمسار: متجه نص = مكتبة_ومسار_ملف_طبقات(&ملفات_المكتبة[ف]);
            ألحق(المكتبات, انسخ_نص_اختبار(&المكتبة_والمسار[0]));
            ألحق(المسارات, انسخ_نص_اختبار(&المكتبة_والمسار[1]));
            ألحق(الملفات, انسخ_نص_اختبار(&ملفات_المكتبة[ف]));
            ف := ف + 1;
        }
        م := م + 1;
    }
    دع المكتبة: مكتبة_طبقات = { المكتبات: المكتبات, المسارات: المسارات, الملفات: الملفات, التهجئات: [], المجلدات_المحملة: [] };
    أرجع اختياري.موجود(المكتبة);
}

// std files outside std/os that still choose code by target (Rust's tidy
// "Temporary std exceptions"); the list may only shrink.
عرف حراس_أهداف_مسموحة_طبقات(): متجه نص {
    دع القائمة: متجه نص = [
        «library/std/async/runtime.sn», «library/std/env/environment.sn», «library/std/env/executable.sn»,
        «library/std/env/variables.sn», «library/std/fs/canonical.sn», «library/std/fs/path.sn»,
        «library/std/fs/temporary.sn», «library/std/http/server.sn», «library/std/memory/system.sn»,
        «library/std/net/tcp.sn», «library/std/process/child.sn»
    ];
    أرجع القائمة;
}

// ---- The checks ------------------------------------------------------------------

عرف أبلغ_طبقات(الملخص: &متغير ملخص_اختبارات, الاسم: نص, المخالفات: &متجه نص): فراغ {
    إذا ((الطول(*المخالفات) مثل طبيعي) == 0) {
        سجل_نجاح(الملخص, &الاسم);
        أرجع;
    };
    دع الأجزاء: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المخالفات) مثل طبيعي) && ف < 8) {
        إذا (ف > 0) { ألحق(الأجزاء, «؛ »); };
        ألحق(الأجزاء, انسخ_نص_اختبار(&(*المخالفات)[ف]));
        ف := ف + 1;
    }
    دع السبب: نص = اجمع_نصوص(&الأجزاء);
    سجل_فشل(الملخص, &الاسم, &السبب);
}

// The canonical allocator interface (library/core/memory/allocator.sn): the
// compiler's decorators (compiler/frontend/annotations/
// definition_decorators.sn) and the interface name the same three
// annotations in both languages, std marks each of them in exactly one file,
// std.os.allocation_cache (once per target guard there), and no other
// library file marks any.
عرف اختبر_واجهة_المخصص_طبقات(الملخص: &متغير ملخص_اختبارات, المكتبة: &مكتبة_طبقات): فراغ {
    دع العربية: متجه نص = [«تخصيص_عام», «إعادة_تخصيص_عام», «تحرير_عام»];
    دع الإنجليزية: متجه نص = [«global_alloc», «global_realloc», «global_dealloc»];
    دع المزخرفات: نص = «compiler/frontend/annotations/definition_decorators.sn»;
    دع الواجهة: نص = «library/core/memory/allocator.sn»;
    دع موضع_التعريف: نص = «library/std/os/allocation_cache.sn»;
    دع نص_المزخرفات: نص = اقرأ_إن_وجد(&المزخرفات);
    دع نص_الواجهة: نص = اقرأ_إن_وجد(&الواجهة);
    دع نص_التعريف: نص = اقرأ_إن_وجد(&موضع_التعريف);
    دع المخالفات: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العربية) مثل طبيعي)) {
        دع اسمان: متجه نص = [انسخ_نص_اختبار(&العربية[ف]), انسخ_نص_اختبار(&الإنجليزية[ف])];
        دع ل: متغير طبيعي = 0;
        طالما (ل < 2) {
            دع المقتبس_أجزاء: متجه نص = ["«", انسخ_نص_اختبار(&اسمان[ل]), "»"];
            دع المقتبس: نص = اجمع_نصوص(&المقتبس_أجزاء);
            إذا (!يحتوي_نصا(&نص_المزخرفات, &المقتبس)) {
                دع أجزاء: متجه نص = [انسخ_نص_اختبار(&المزخرفات), « لا يعرف », انسخ_نص_اختبار(&اسمان[ل])];
                ألحق(المخالفات, اجمع_نصوص(&أجزاء));
            };
            دع العلامة_أجزاء: متجه نص = [«@@», انسخ_نص_اختبار(&اسمان[ل])];
            دع العلامة: نص = اجمع_نصوص(&العلامة_أجزاء);
            إذا (!يحتوي_نصا(&نص_الواجهة, &العلامة)) {
                دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الواجهة), « لا تسمي », انسخ_نص_اختبار(&العلامة)];
                ألحق(المخالفات, اجمع_نصوص(&أجزاء));
            };
            ل := ل + 1;
        }
        // std's mark, indented in a target guard (a comment quotes it in backticks).
        دع السطر_أجزاء: متجه نص = [«    @@», انسخ_نص_اختبار(&العربية[ف])];
        دع العلامة_في_سطر: نص = اجمع_نصوص(&السطر_أجزاء);
        إذا (!يحتوي_نصا(&نص_التعريف, &العلامة_في_سطر)) {
            دع أجزاء: متجه نص = [انسخ_نص_اختبار(&موضع_التعريف), « لا يعلّم @@», انسخ_نص_اختبار(&العربية[ف])];
            ألحق(المخالفات, اجمع_نصوص(&أجزاء));
        };
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول((*المكتبة).الملفات) مثل طبيعي)) {
            إذا (!نصان_متساويان(&(*المكتبة).الملفات[ي], &موضع_التعريف)
                && !نصان_متساويان(&(*المكتبة).الملفات[ي], &الواجهة)) {
                دع المحتوى: نص = اقرأ_إن_وجد(&(*المكتبة).الملفات[ي]);
                دع ل2: متغير طبيعي = 0;
                طالما (ل2 < 2) {
                    دع العلامة_أجزاء: متجه نص = [«@@», انسخ_نص_اختبار(&اسمان[ل2])];
                    دع العلامة: نص = اجمع_نصوص(&العلامة_أجزاء);
                    إذا (يحتوي_نصا(&المحتوى, &العلامة)) {
                        دع أجزاء: متجه نص = [انسخ_نص_اختبار(&(*المكتبة).الملفات[ي]), « يعلّم », العلامة];
                        ألحق(المخالفات, اجمع_نصوص(&أجزاء));
                    };
                    ل2 := ل2 + 1;
                }
            };
            ي := ي + 1;
        }
        ف := ف + 1;
    }
    أبلغ_طبقات(الملخص, «طبقات std: واجهة المخصص واحدة في المترجم والمكتبة», &المخالفات);
}

عام عرف اختبر_طبقات_المكتبة(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع المكتبة: متغير مكتبة_طبقات;
    طابق حمل_مكتبة_طبقات() مع
    | اختياري.لا_شيء -> {
        دع الاسم: نص = «طبقات المكتبة القياسية»;
        دع السبب: نص = «تعذر اجتياز library/std أو library/alloc أو library/core»;
        سجل_فشل(الملخص, &الاسم, &السبب);
        أرجع;
    }
    | اختياري.موجود(المحملة) -> { المكتبة := المحملة; };

    دع الحراس: متجه نص = حراس_أهداف_مسموحة_طبقات();
    دع بادئة_النظام: نص = «library/std/os/»;
    دع بادئة_المنصات: نص = «os.platform.»;
    دع تعليق: نص = «//»;
    دع خارجي_: نص = «خارجي »;
    دع علامات_المنصة: متجه نص = [«بدائي_نداء_نواة_خام», «بدائي_استنسخ_خيط_نواة», «بدائي_نمو_الذاكرة_الخطية»];
    دع حارس_منصة: نص = «الهدف.المنصة»;
    دع حارس_معمارية: نص = «الهدف.المعمارية»;
    دع معدن_عار: نص = «freestanding»;
    دع المكتبة_القياسية: نص = «std»;
    دع الأساس: نص = «core»;
    دع التخصيص: نص = «alloc»;

    دع غير_محلولة: متغير متجه نص = [];
    دع مخالفات_المنصة: متغير متجه نص = [];
    دع مخالفات_المنصات: متغير متجه نص = [];
    دع مخالفات_الحراس: متغير متجه نص = [];
    دع مخالفات_الطبقات: متغير متجه نص = [];
    دع مسارات_مكررة: متغير متجه نص = [];

    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكتبة.الملفات) مثل طبيعي)) {
        دع الملف: نص = انسخ_نص_اختبار(&المكتبة.الملفات[ف]);
        دع مكتبة_الملف: نص = انسخ_نص_اختبار(&المكتبة.المكتبات[ف]);
        دع الوحدة: نص = انسخ_نص_اختبار(&المكتبة.المسارات[ف]);
        دع المحتوى: نص = اقرأ_إن_وجد(&الملف);
        دع في_النظام: منطقي = يبدأ_بـ(&الملف, &بادئة_النظام);
        دع في_القياسية: منطقي = نصان_متساويان(&مكتبة_الملف, &المكتبة_القياسية);

        // A module path in two libraries (folder root files may repeat).
        إذا (!ملف_جذر_طبقات_للمسار(&مكتبة_الملف, &الوحدة)) {
            دع ي: متغير طبيعي = ف + 1;
            طالما (ي < (الطول(المكتبة.الملفات) مثل طبيعي)) {
                إذا (نصان_متساويان(&المكتبة.المسارات[ي], &الوحدة)
                    && !نصان_متساويان(&المكتبة.المكتبات[ي], &مكتبة_الملف)) {
                    // A split module (docs/en/reference/std-layers.md, "Split
                    // modules"): the higher library's half imports the lower
                    // one's at the same path and re-exports it. The higher
                    // library's files come first (حمل_مكتبة_طبقات).
                    إذا (!يستورد_موضعا_طبقات(&متغير المكتبة, &مكتبة_الملف, &المحتوى, ي)) {
                        دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الوحدة), « في », انسخ_نص_اختبار(&مكتبة_الملف), « و», انسخ_نص_اختبار(&المكتبة.المكتبات[ي])];
                        ألحق(مسارات_مكررة, اجمع_نصوص(&أجزاء));
                    };
                };
                ي := ي + 1;
            }
        };

        // Platform code outside std/os.
        إذا (!في_النظام) {
            دع الأسطر: متجه نص = أسطر_طبقات(&المحتوى);
            دع حارس_وجد: متغير منطقي = خطأ;
            دع س: متغير طبيعي = 0;
            طالما (س < (الطول(الأسطر) مثل طبيعي)) {
                دع السطر: نص = شذب_طبقات(&الأسطر[س]);
                إذا (!يبدأ_بـ(&السطر, &تعليق)) {
                    إذا (يبدأ_بـ(&السطر, &خارجي_)) {
                        دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الملف), « يعرف دالة خارجية»];
                        ألحق(مخالفات_المنصة, اجمع_نصوص(&أجزاء));
                    };
                    دع ع: متغير طبيعي = 0;
                    طالما (ع < (الطول(علامات_المنصة) مثل طبيعي)) {
                        إذا (يحتوي_نصا(&السطر, &علامات_المنصة[ع])) {
                            دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الملف), « يستعمل », انسخ_نص_اختبار(&علامات_المنصة[ع])];
                            ألحق(مخالفات_المنصة, اجمع_نصوص(&أجزاء));
                        };
                        ع := ع + 1;
                    }
                    إذا (في_القياسية) {
                        إذا (يحتوي_نصا(&السطر, &حارس_منصة) || يحتوي_نصا(&السطر, &حارس_معمارية)) { حارس_وجد := صواب; };
                    } وإلا {
                        // core and alloc: architecture, and the bare-metal
                        // capability, but no operating system.
                        إذا (يحتوي_نصا(&السطر, &حارس_منصة) && !يحتوي_نصا(&السطر, &معدن_عار)) {
                            دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الملف), « يختار الشيفرة بنظام التشغيل»];
                            ألحق(مخالفات_الحراس, اجمع_نصوص(&أجزاء));
                        };
                    };
                };
                س := س + 1;
            }
            إذا (حارس_وجد && !في_القائمة_طبقات(&الحراس, &الملف)) {
                دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الملف), « يختار الشيفرة بالهدف خارج std/os»];
                ألحق(مخالفات_الحراس, اجمع_نصوص(&أجزاء));
            };
        };

        // Imports: every one resolves; std.os.platform only from std/os; core
        // imports only core, alloc only alloc and core.
        دع الاستيرادات: متجه نص = استيرادات_طبقات(&المحتوى);
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(الاستيرادات) مثل طبيعي)) {
            طابق حل_استيراد_طبقات(&متغير المكتبة, &مكتبة_الملف, &الاستيرادات[ي]) مع
            | اختياري.لا_شيء -> {
                دع compiler_: نص = «compiler.»;
                إذا (!يبدأ_بـ(&الاستيرادات[ي], &compiler_)) {
                    دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الملف), «: », انسخ_نص_اختبار(&الاستيرادات[ي])];
                    ألحق(غير_محلولة, اجمع_نصوص(&أجزاء));
                };
            }
            | اختياري.موجود(الموضع) -> {
                دع الهدف: نص = انسخ_نص_اختبار(&المكتبة.المسارات[الموضع]);
                دع مكتبة_الهدف: نص = انسخ_نص_اختبار(&المكتبة.المكتبات[الموضع]);
                إذا (!في_النظام && يبدأ_بـ(&الهدف, &بادئة_المنصات)) {
                    دع أجزاء: متجه نص = [انسخ_نص_اختبار(&الوحدة), « -> », الهدف];
                    ألحق(مخالفات_المنصات, اجمع_نصوص(&أجزاء));
                } وإلا {
                    دع من_الأساس: منطقي = نصان_متساويان(&مكتبة_الملف, &الأساس);
                    دع من_التخصيص: منطقي = نصان_متساويان(&مكتبة_الملف, &التخصيص);
                    دع إلى_الأساس: منطقي = نصان_متساويان(&مكتبة_الهدف, &الأساس);
                    دع إلى_القياسية: منطقي = نصان_متساويان(&مكتبة_الهدف, &المكتبة_القياسية);
                    إذا ((من_الأساس && !إلى_الأساس) || (من_التخصيص && إلى_القياسية)) {
                        دع أجزاء: متجه نص = [انسخ_نص_اختبار(&مكتبة_الملف), «:», انسخ_نص_اختبار(&الوحدة), « -> », مكتبة_الهدف, «:», الهدف];
                        ألحق(مخالفات_الطبقات, اجمع_نصوص(&أجزاء));
                    };
                };
            };
            ي := ي + 1;
        }
        ف := ف + 1;
    }

    // Every re-export names a library the declaring one sees and a module or
    // folder that is there.
    دع إعادات_معطوبة: متغير متجه نص = [];
    ف := 0;
    طالما (ف < (الطول(المكتبة.الملفات) مثل طبيعي)) {
        دع مكتبة_الملف: نص = انسخ_نص_اختبار(&المكتبة.المكتبات[ف]);
        دع الوحدة: نص = انسخ_نص_اختبار(&المكتبة.المسارات[ف]);
        إذا (ملف_جذر_طبقات_للمسار(&مكتبة_الملف, &الوحدة)) {
            دع المكونات: متجه نص = قسم_طبقات(&الوحدة, 0x2E);
            دع المجلد: متغير نص = «»;
            إذا ((الطول(المكونات) مثل طبيعي) > 1 || !نصان_متساويان(&المكونات[0], &مكتبة_الملف)) {
                المجلد := صل_طبقات(&المكونات, (الطول(المكونات) مثل طبيعي) - 1, «.»);
            };
            حمل_تهجئات_طبقات(&متغير المكتبة, &مكتبة_الملف, &المجلد);
            دع المفتاح_أجزاء: متجه نص = [انسخ_نص_اختبار(&مكتبة_الملف), «|», انسخ_نص_اختبار(&المجلد)];
            دع المفتاح: نص = اجمع_نصوص(&المفتاح_أجزاء);
            دع المرئية: متجه نص = سلسلة_مكتبة_طبقات(&مكتبة_الملف);
            دع ت: متغير طبيعي = 0;
            طالما (ت < (الطول(المكتبة.التهجئات) مثل طبيعي)) {
                دع الهدف: نص = انسخ_نص_اختبار(&المكتبة.التهجئات[ت].الهدف);
                إذا ((الطول(الهدف) مثل طبيعي) > 0
                    && نصان_متساويان(&المكتبة.التهجئات[ت].المجلد, &المفتاح)
                    && نصان_متساويان(&المكتبة.التهجئات[ت].التهجئة, &المكتبة.التهجئات[ت].الاسم)) {
                    دع أجزاء_الهدف: متجه نص = قسم_طبقات(&الهدف, 0x2E);
                    دع سليمة: متغير منطقي = في_القائمة_طبقات(&المرئية, &أجزاء_الهدف[0]);
                    إذا (سليمة) {
                        دع البقية: متغير متجه نص = [];
                        دع ج: متغير طبيعي = 1;
                        طالما (ج < (الطول(أجزاء_الهدف) مثل طبيعي)) { ألحق(البقية, انسخ_نص_اختبار(&أجزاء_الهدف[ج])); ج := ج + 1; }
                        دع المسير: متجه نص = قنن_طبقات(&متغير المكتبة, &أجزاء_الهدف[0], &البقية);
                        دع المقننة: متغير متجه نص = [];
                        ج := 1;
                        طالما (ج < (الطول(المسير) مثل طبيعي)) { ألحق(المقننة, انسخ_نص_اختبار(&المسير[ج])); ج := ج + 1; }
                        دع المسار: نص = صل_طبقات(&المقننة, الطول(المقننة) مثل طبيعي, «.»);
                        دع بادئة_المجلد_أجزاء: متجه نص = [انسخ_نص_اختبار(&المسار), «.»];
                        دع بادئة_المجلد: نص = اجمع_نصوص(&بادئة_المجلد_أجزاء);
                        سليمة := خطأ;
                        دع م: متغير طبيعي = 0;
                        طالما (م < (الطول(المكتبة.المسارات) مثل طبيعي) && !سليمة) {
                            إذا (نصان_متساويان(&المكتبة.المكتبات[م], &المسير[0])
                                && (نصان_متساويان(&المكتبة.المسارات[م], &المسار)
                                    || يبدأ_بـ(&المكتبة.المسارات[م], &بادئة_المجلد))) {
                                سليمة := صواب;
                            };
                            م := م + 1;
                        }
                    };
                    إذا (!سليمة) {
                        دع أجزاء: متجه نص = [انسخ_نص_اختبار(&مكتبة_الملف), «:», انسخ_نص_اختبار(&الوحدة), « -> », الهدف];
                        ألحق(إعادات_معطوبة, اجمع_نصوص(&أجزاء));
                    };
                };
                ت := ت + 1;
            }
        };
        ف := ف + 1;
    }

    أبلغ_طبقات(الملخص, «طبقات std: كل استيراد يحل إلى وحدة», &غير_محلولة);
    أبلغ_طبقات(الملخص, «طبقات std: كل إعادة تصدير تسمي وحدة أو مجلدا موجودا في مكتبة مرئية», &إعادات_معطوبة);
    أبلغ_طبقات(الملخص, «طبقات std: شيفرة المنصة في std/os فقط», &مخالفات_المنصة);
    أبلغ_طبقات(الملخص, «طبقات std: std.os.platform لا يستورده إلا std/os», &مخالفات_المنصات);
    أبلغ_طبقات(الملخص, «طبقات std: لا حارس هدف جديد خارج std/os، ولا حارس نظام تشغيل في الأساس والتخصيص», &مخالفات_الحراس);
    أبلغ_طبقات(الملخص, «طبقات std: الأساس لا يستورد إلا الأساس، والتخصيص لا يستورد المكتبة», &مخالفات_الطبقات);
    أبلغ_طبقات(الملخص, «طبقات std: لا مسار وحدة في مكتبتين», &مسارات_مكررة);
    اختبر_واجهة_المخصص_طبقات(الملخص, &المكتبة);
}
