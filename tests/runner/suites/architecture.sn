استورد "../common.sn";
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.metadata;
استورد std.text.search;
استورد std.text.compare;
استورد "../discovery.sn";

// اختبارات ملكية البنية الثابتة التي كانت موزعة على مشغلات خارجية.

عرف اطلب_ملفا(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    الاسم: &نص
): فراغ {
    طابق موجود(المسار) مع
    | نتيجة.نجح(صواب) -> { سجل_نجاح(الملخص, الاسم); }
    | _ -> {
        دع سبب: نص = «الملف المملوك غير موجود»;
        سجل_فشل(الملخص, الاسم, &سبب);
    };
}

عرف اطلب_علامة(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    العلامة: نص,
    الاسم: &نص
): فراغ {
    دع النص: نص = اقرأ_إن_وجد(المسار);
    لو (يحتوي_نصا(&النص, &العلامة)) {
        سجل_نجاح(الملخص, الاسم);
    } وإلا {
        دع سبب: نص = «العلامة المطلوبة غير موجودة في المالك»;
        سجل_فشل(الملخص, الاسم, &سبب);
    };
}

عرف امنع_علامة(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    العلامة: نص,
    الاسم: &نص
): فراغ {
    دع النص: نص = اقرأ_إن_وجد(المسار);
    لو (يحتوي_نصا(&النص, &العلامة)) {
        دع سبب: نص = «وجدت علامة محظورة في المالك»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, الاسم);
    };
}

عرف امنع_استيراد_من_شجرة(
    الملخص: &متغير ملخص_اختبارات,
    الجذر: &نص,
    العلامة: &نص,
    الاسم: &نص
): فراغ {
    دع الملفات: متغير متجه نص = [];
    لو (!اجمع_ملفات_سن(الجذر, &متغير الملفات)) {
        دع سبب: نص = «تعذر اجتياز الشجرة»;
        سجل_فشل(الملخص, الاسم, &سبب);
        أرجع;
    };

    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الملفات) مثل غير_موقع)) {
        دع النص: نص = اقرأ_إن_وجد(&الملفات[ف]);
        لو (يحتوي_نصا(&النص, العلامة)) {
            دع أجزاء: متجه نص = [«وجدت الملكية المتقاعدة في », انسخ_نص_اختبار(&الملفات[ف])];
            دع سبب: نص = اجمع_نصوص(&أجزاء);
            سجل_فشل(الملخص, الاسم, &سبب);
            أرجع;
        };
        ف := ف + 1;
    }
    سجل_نجاح(الملخص, الاسم);
}


عرف لا_توجد_ملفات_مشغل_قديم(الدليل: &نص): منطقي {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع المسار: نص = صل_المسار(الدليل, &المداخل[ف].الاسم);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                لو (!لا_توجد_ملفات_مشغل_قديم(&المسار)) { أرجع خطأ; };
            }
            | نوع_مدخل_دليل.ملف -> {
                دع بايثون: نص = «.py»;
                دع جدول: نص = «.tsv»;
                دع شل: نص = «.sh»;
                لو (ينتهي_بـ(&المسار, &بايثون) || ينتهي_بـ(&المسار, &جدول) || ينتهي_بـ(&المسار, &شل)) {
                    أرجع خطأ;
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

عام عرف اختبر_البنية(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع ملفات_المصدر: متجه نص = [
        «compiler/source/span.sn»,
        «compiler/source/source_file.sn»,
        «compiler/source/source_map.sn»,
        «compiler/source/provenance.sn»
    ];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(ملفات_المصدر) مثل غير_موقع)) {
        دع أجزاء: متجه نص = [«ملكية المصدر: », انسخ_نص_اختبار(&ملفات_المصدر[ف])];
        دع اسم: نص = اجمع_نصوص(&أجزاء);
        اطلب_ملفا(الملخص, &ملفات_المصدر[ف], &اسم);
        ف := ف + 1;
    }

    دع جذر_مترجم: نص = «compiler»;
    دع ملكية_قديمة: نص = «compiler.frontend.source.»;
    دع اسم_ملكية: نص = «لا استيراد لمالك المصدر المتقاعد»;
    امنع_استيراد_من_شجرة(الملخص, &جذر_مترجم, &ملكية_قديمة, &اسم_ملكية);

    دع سجل: نص = «compiler/diagnostics/registry.sn»;
    دع هوية: نص = «compiler/diagnostics/identity.sn»;
    دع مخطط: نص = «compiler/diagnostics/schema.sn»;
    دع سجل_تشخيص: نص = «compiler/diagnostics/record.sn»;
    دع بناء: نص = «compiler/diagnostics/builder.sn»;
    دع محرك: نص = «compiler/diagnostics/engine.sn»;
    دع توطين: نص = «compiler/diagnostics/localization.sn»;
    دع رسالة: نص = «compiler/diagnostics/message.sn»;
    دع شرح: نص = «compiler/diagnostics/explain.sn»;
    دع طرفية: نص = «compiler/diagnostics/output/terminal.sn»;
    دع جيسون: نص = «compiler/diagnostics/output/json.sn»;

    دع أ: نص = «هوية التشخيص»;
    دع ب: نص = «مخطط التشخيص»;
    دع ج: نص = «سجل التشخيص»;
    دع د: نص = «باني التشخيص»;
    دع هـ: نص = «محرك التشخيص»;
    دع و: نص = «توطين التشخيص»;
    دع ز: نص = «رسالة التشخيص»;
    دع ح: نص = «شرح التشخيص»;
    اطلب_علامة(الملخص, &هوية, «عام نوع معرف_تشخيص», &أ);
    اطلب_علامة(الملخص, &مخطط, «مفتاح_صياغة», &ب);
    اطلب_علامة(الملخص, &سجل_تشخيص, «المصدر_الرئيسي», &ج);
    اطلب_علامة(الملخص, &بناء, «ابدأ_تشخيصا», &د);
    اطلب_علامة(الملخص, &محرك, «أصدر_تشخيصا», &هـ);
    اطلب_علامة(الملخص, &توطين, «صياغة_عربية», &و);
    اطلب_علامة(الملخص, &رسالة, «نص_رسالة_تشخيص», &ز);
    اطلب_علامة(الملخص, &شرح, «شرح_معرف_تشخيص», &ح);

    دع ط: نص = «JSON يحمل حدود البايت»;
    اطلب_علامة(الملخص, &جيسون, «start_byte», &ط);
    دع ي: نص = «النقل الطرفي يستهلك الرسالة المعيارية»;
    اطلب_علامة(الملخص, &طرفية, «نص_رسالة_تشخيص», &ي);
    دع ك: نص = «JSON لا يبدل على الهوية»;
    امنع_علامة(الملخص, &جيسون, «معرف_تشخيص.», &ك);
    دع ل: نص = «لا معرفات تشخيص رقمية قديمة»;
    امنع_علامة(الملخص, &سجل, «SULTANC-E0», &ل);

    دع قراءة: نص = «library/std/fs/read_file.sn»;
    دع كتابة: نص = «library/std/fs/write_file.sn»;
    دع كتابة_بايتات: نص = «library/std/fs/write_bytes.sn»;
    دع قراءة_سطر: نص = «library/std/io/read_line.sn»;
    دع م: نص = «std يملك تركيب قراءة الملف»;
    اطلب_علامة(الملخص, &قراءة, «اقرأ_ملف_نظام(», &م);
    دع ن: نص = «std يملك تركيب كتابة الملف»;
    اطلب_علامة(الملخص, &كتابة, «اكتب_البايتات», &ن);
    دع س: نص = «std يملك تركيب كتابة البايتات»;
    اطلب_علامة(الملخص, &كتابة_بايتات, «اكتب_ملف_نظام(», &س);
    دع ع: نص = «std يملك تركيب قراءة السطر»;
    اطلب_علامة(الملخص, &قراءة_سطر, «اقرأ_دخلا_قياسيا_للنظام(», &ع);

    دع تعريف_الوحدات: نص = «compiler/frontend/module_loading/module_metadata.sn»;
    دع ف1: نص = «Module يسجل تهجئات الحزم المعلنة»;
    اطلب_علامة(الملخص, &تعريف_الوحدات, «سجل_تهجئة_حزمة_معلنة», &ف1);
    دع سجل_البدائيات: نص = «compiler/frontend/names/primitive_registry.sn»;
    دع ص: نص = «Frontend Names يحدد إتاحة البدائي المباشر»;
    اطلب_علامة(الملخص, &سجل_البدائيات, «بدائي_مباشر_مصدريا», &ص);
    دع ق: نص = «لا امتياز std حسب بادئة مسار»;
    امنع_علامة(الملخص, &تعريف_الوحدات, «library/std/internal/», &ق);

    دع الرموز: نص = «tools/generate/registry/token_registry.def»;
    دع ر: نص = «FROM فعال»;
    دع علامة_من: نص = «SULTANC__TOKEN__(FROM, "من_مصدر", Keyword, Active»;
    اطلب_علامة(الملخص, &الرموز, علامة_من, &ر);
    دع ش: نص = «USE محفوظ للمستقبل»;
    دع علامة_استخدام: نص = «SULTANC__TOKEN__(USE, "استخدام", Keyword, Future_Reserved»;
    اطلب_علامة(الملخص, &الرموز, علامة_استخدام, &ش);

    دع اسم_لغات_المشغل: نص = «لا Python ولا TSV ولا shell داخل tests»;
    دع جذر_فحص: نص = «tests»;
    لو (لا_توجد_ملفات_مشغل_قديم(&جذر_فحص)) {
        سجل_نجاح(الملخص, &اسم_لغات_المشغل);
    } وإلا {
        دع سبب_لغات: نص = «وجد ملف مشغل قديم داخل tests»;
        سجل_فشل(الملخص, &اسم_لغات_المشغل, &سبب_لغات);
    };

    دع اسم_تخطيط: نص = «tests يملك ar و en و runner فقط في الجذر»;
    دع جذر_الاختبارات: نص = «tests»;
    طابق اقرأ_مدخلات_الدليل(&جذر_الاختبارات) مع
    | نتيجة.خطأ(_) -> {
        دع سبب: نص = «تعذر قراءة tests»;
        سجل_فشل(الملخص, &اسم_تخطيط, &سبب);
    }
    | نتيجة.نجح(المداخل) -> {
        دع صالح: متغير منطقي = صواب;
        دع ف2: متغير غير_موقع = 0;
        بينما (ف2 < (الطول(المداخل) مثل غير_موقع)) {
            دع عربي: نص = «ar»;
            دع إنجليزي: نص = «en»;
            دع المشغل: نص = «runner»;
            لو ((!نصان_متساويان(&المداخل[ف2].الاسم, &عربي)) && (!نصان_متساويان(&المداخل[ف2].الاسم, &إنجليزي)) && (!نصان_متساويان(&المداخل[ف2].الاسم, &المشغل))) { صالح := خطأ; };
            ف2 := ف2 + 1;
        }
        لو (صالح) { سجل_نجاح(الملخص, &اسم_تخطيط); }
        وإلا { دع سبب: نص = «يوجد عنصر خارج tests/ar أو tests/en أو tests/runner»; سجل_فشل(الملخص, &اسم_تخطيط, &سبب); };
    };
}
