استورد "../common.sn";
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.metadata;
استورد std.text.search;
استورد std.text.compare;
استورد "../discovery.sn";

// اختبارات ملكية البنية الثابتة التي كانت موزعة على مشغلات خارجية.

عرف اطلب_ملفا(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    الاسم: &نص
): فراغ {
    طابق موجود(المسار) مع
    | نتيجة.نجح(صواب) -> { سجل_نجاح(الملخص, الاسم); }
    | _ -> {
        ليكن سبب: نص = «الملف المملوك غير موجود»;
        سجل_فشل(الملخص, الاسم, &سبب);
    };
}

عرف اطلب_علامة(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    العلامة: نص,
    الاسم: &نص
): فراغ {
    ليكن النص: نص = اقرأ_إن_وجد(المسار);
    إذا (يحتوي_نصا(&النص, &العلامة)) {
        سجل_نجاح(الملخص, الاسم);
    } وإلا {
        ليكن سبب: نص = «العلامة المطلوبة غير موجودة في المالك»;
        سجل_فشل(الملخص, الاسم, &سبب);
    };
}

عرف امنع_علامة(
    الملخص: &متغير ملخص_اختبارات,
    المسار: &نص,
    العلامة: نص,
    الاسم: &نص
): فراغ {
    ليكن النص: نص = اقرأ_إن_وجد(المسار);
    إذا (يحتوي_نصا(&النص, &العلامة)) {
        ليكن سبب: نص = «وجدت علامة محظورة في المالك»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, الاسم);
    };
}

عرف امنع_استيراد_من_شجرة(
    الملخص: &متغير ملخص_اختبارات,
    الجذر: &نص,
    العلامة: &نص,
    الاسم: &نص
): فراغ {
    ليكن الملفات: متغير متجه نص = [];
    إذا (!اجمع_ملفات_سن(الجذر, &متغير الملفات)) {
        ليكن سبب: نص = «تعذر اجتياز الشجرة»;
        سجل_فشل(الملخص, الاسم, &سبب);
        أرجع;
    };

    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        ليكن النص: نص = اقرأ_إن_وجد(&الملفات[ف]);
        إذا (يحتوي_نصا(&النص, العلامة)) {
            ليكن أجزاء: متجه نص = [«وجدت الملكية المتقاعدة في », انسخ_نص_اختبار(&الملفات[ف])];
            ليكن سبب: نص = اجمع_نصوص(&أجزاء);
            سجل_فشل(الملخص, الاسم, &سبب);
            أرجع;
        };
        ف := ف + 1;
    }
    سجل_نجاح(الملخص, الاسم);
}


عرف لا_توجد_ملفات_مشغل_قديم(الدليل: &نص): منطقي {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المداخل) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            ليكن المسار: نص = صل_المسار(الدليل, &المداخل[ف].الاسم);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                إذا (!لا_توجد_ملفات_مشغل_قديم(&المسار)) { أرجع خطأ; };
            }
            | نوع_مدخل_دليل.ملف -> {
                ليكن بايثون: نص = «.py»;
                ليكن جدول: نص = «.tsv»;
                ليكن شل: نص = «.sh»;
                إذا (ينتهي_بـ(&المسار, &بايثون) || ينتهي_بـ(&المسار, &جدول) || ينتهي_بـ(&المسار, &شل)) {
                    أرجع خطأ;
                };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

عام عرف اختبر_البنية(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن ملفات_المصدر: متجه نص = [
        «compiler/source/span.sn»,
        «compiler/source/source_file.sn»,
        «compiler/source/source_map.sn»,
        «compiler/source/provenance.sn»
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ملفات_المصدر) مثل طبيعي)) {
        ليكن أجزاء: متجه نص = [«ملكية المصدر: », انسخ_نص_اختبار(&ملفات_المصدر[ف])];
        ليكن اسم: نص = اجمع_نصوص(&أجزاء);
        اطلب_ملفا(الملخص, &ملفات_المصدر[ف], &اسم);
        ف := ف + 1;
    }

    ليكن جذر_مترجم: نص = «compiler»;
    ليكن ملكية_قديمة: نص = «compiler.frontend.source.»;
    ليكن اسم_ملكية: نص = «لا استيراد لمالك المصدر المتقاعد»;
    امنع_استيراد_من_شجرة(الملخص, &جذر_مترجم, &ملكية_قديمة, &اسم_ملكية);

    // std.error is the program error contract, not a second diagnostic
    // system: no compiler module (iSpeak, diagnostics) and no SULTANC- codes.
    ليكن جذر_أخطاء_المكتبة: نص = «library/std/error»;
    ليكن وحدة_مترجم: نص = «compiler.»;
    ليكن مسار_مترجم: نص = «compiler/»;
    ليكن رمز_تشخيص: نص = «SULTANC-»;
    ليكن اسم_أخطاء1: نص = «std.error لا يستورد وحدات المترجم»;
    ليكن اسم_أخطاء2: نص = «std.error لا يستورد ملفات المترجم»;
    ليكن اسم_أخطاء3: نص = «std.error لا يعرف رموز تشخيص»;
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_المكتبة, &وحدة_مترجم, &اسم_أخطاء1);
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_المكتبة, &مسار_مترجم, &اسم_أخطاء2);
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_المكتبة, &رمز_تشخيص, &اسم_أخطاء3);
    // Most of std.error is alloc's (library/alloc/error, docs/en/reference/std-layers.md).
    ليكن جذر_أخطاء_التخصيص: نص = «library/alloc/error»;
    ليكن اسم_أخطاء4: نص = «alloc.error لا يستورد وحدات المترجم»;
    ليكن اسم_أخطاء5: نص = «alloc.error لا يستورد ملفات المترجم»;
    ليكن اسم_أخطاء6: نص = «alloc.error لا يعرف رموز تشخيص»;
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_التخصيص, &وحدة_مترجم, &اسم_أخطاء4);
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_التخصيص, &مسار_مترجم, &اسم_أخطاء5);
    امنع_استيراد_من_شجرة(الملخص, &جذر_أخطاء_التخصيص, &رمز_تشخيص, &اسم_أخطاء6);

    ليكن سجل: نص = «compiler/diagnostics/registry.sn»;
    ليكن هوية: نص = «compiler/diagnostics/identity.sn»;
    ليكن مخطط: نص = «compiler/diagnostics/schema.sn»;
    ليكن سجل_تشخيص: نص = «compiler/diagnostics/record.sn»;
    ليكن بناء: نص = «compiler/diagnostics/builder.sn»;
    ليكن محرك: نص = «compiler/diagnostics/engine.sn»;
    // Wording is owned by iSpeak: Arabic words in its locale, explanations in its API.
    ليكن توطين: نص = «compiler/ispeak/locales/ar/errors.sn»;
    ليكن رسالة: نص = «compiler/diagnostics/message.sn»;
    ليكن شرح: نص = «compiler/ispeak/ispeak.sn»;
    ليكن طرفية: نص = «compiler/diagnostics/output/terminal.sn»;
    ليكن جيسون: نص = «compiler/diagnostics/output/json.sn»;

    ليكن أ: نص = «هوية التشخيص»;
    ليكن ب: نص = «مخطط التشخيص»;
    ليكن ج: نص = «سجل التشخيص»;
    ليكن د: نص = «باني التشخيص»;
    ليكن هـ: نص = «محرك التشخيص»;
    ليكن و: نص = «توطين التشخيص»;
    ليكن ز: نص = «رسالة التشخيص»;
    ليكن ح: نص = «شرح التشخيص»;
    اطلب_علامة(الملخص, &هوية, «عام نوع معرف_تشخيص», &أ);
    اطلب_علامة(الملخص, &مخطط, «مفتاح_صياغة», &ب);
    اطلب_علامة(الملخص, &سجل_تشخيص, «المصدر_الرئيسي», &ج);
    اطلب_علامة(الملخص, &بناء, «ابدأ_تشخيصا», &د);
    اطلب_علامة(الملخص, &محرك, «أصدر_تشخيصا», &هـ);
    اطلب_علامة(الملخص, &توطين, «رسالة_خطأ_عربية», &و);
    اطلب_علامة(الملخص, &رسالة, «نص_رسالة_تشخيص», &ز);
    اطلب_علامة(الملخص, &شرح, «شرح_كود_عام», &ح);

    ليكن ط: نص = «JSON يحمل حدود البايت»;
    اطلب_علامة(الملخص, &جيسون, «start_byte», &ط);
    ليكن ي: نص = «النقل الطرفي يستهلك الرسالة المعيارية»;
    اطلب_علامة(الملخص, &طرفية, «نص_رسالة_تشخيص», &ي);
    ليكن ك: نص = «JSON لا يبدل على الهوية»;
    امنع_علامة(الملخص, &جيسون, «معرف_تشخيص.», &ك);
    ليكن ل: نص = «لا معرفات تشخيص رقمية قديمة»;
    امنع_علامة(الملخص, &سجل, «SULTANC-E0», &ل);

    ليكن قراءة: نص = «library/std/fs/read_file.sn»;
    ليكن كتابة: نص = «library/std/fs/write_file.sn»;
    ليكن كتابة_بايتات: نص = «library/std/fs/write_bytes.sn»;
    ليكن قراءة_سطر: نص = «library/std/io/read_line.sn»;
    ليكن م: نص = «std يملك تركيب قراءة الملف»;
    اطلب_علامة(الملخص, &قراءة, «اقرأ_ملف_نظام(», &م);
    ليكن ن: نص = «std يملك تركيب كتابة الملف»;
    اطلب_علامة(الملخص, &كتابة, «اكتب_البايتات», &ن);
    ليكن س: نص = «std يملك تركيب كتابة البايتات»;
    اطلب_علامة(الملخص, &كتابة_بايتات, «اكتب_ملف_نظام(», &س);
    ليكن ع: نص = «std يملك تركيب قراءة السطر»;
    اطلب_علامة(الملخص, &قراءة_سطر, «اقرأ_دخلا_قياسيا_للنظام(», &ع);

    ليكن تعريف_الوحدات: نص = «compiler/frontend/module_loading/module_metadata.sn»;
    ليكن ف1: نص = «Module يسجل أسماء الحزم المعلنة»;
    اطلب_علامة(الملخص, &تعريف_الوحدات, «سجل_اسم_حزمة_معلن», &ف1);
    ليكن سجل_البدائيات: نص = «compiler/frontend/names/primitive_registry.sn»;
    ليكن ص: نص = «Frontend Names يحدد إتاحة البدائي المباشر»;
    اطلب_علامة(الملخص, &سجل_البدائيات, «بدائي_مباشر_مصدريا», &ص);
    ليكن ق: نص = «لا امتياز std حسب بادئة مسار»;
    امنع_علامة(الملخص, &تعريف_الوحدات, «library/std/internal/», &ق);

    ليكن الرموز: نص = «tools/generate/registry/token_registry.def»;
    ليكن ر: نص = «FROM فعال»;
    ليكن علامة_من: نص = «SULTANC__TOKEN__(FROM, "من_مصدر", Keyword, Active»;
    اطلب_علامة(الملخص, &الرموز, علامة_من, &ر);
    ليكن ش: نص = «USE محفوظ للمستقبل»;
    ليكن علامة_استخدام: نص = «SULTANC__TOKEN__(USE, "استخدام", Keyword, Future_Reserved»;
    اطلب_علامة(الملخص, &الرموز, علامة_استخدام, &ش);

    ليكن اسم_لغات_المشغل: نص = «لا ملفات .py ولا TSV ولا shell داخل tests»;
    ليكن جذر_فحص: نص = «tests»;
    إذا (لا_توجد_ملفات_مشغل_قديم(&جذر_فحص)) {
        سجل_نجاح(الملخص, &اسم_لغات_المشغل);
    } وإلا {
        ليكن سبب_لغات: نص = «وجد ملف مشغل قديم داخل tests»;
        سجل_فشل(الملخص, &اسم_لغات_المشغل, &سبب_لغات);
    };

    ليكن اسم_تخطيط: نص = «tests يملك ar و en و runner فقط في الجذر»;
    ليكن جذر_الاختبارات: نص = «tests»;
    طابق اقرأ_مدخلات_الدليل(&جذر_الاختبارات) مع
    | نتيجة.خطأ(_) -> {
        ليكن سبب: نص = «تعذر قراءة tests»;
        سجل_فشل(الملخص, &اسم_تخطيط, &سبب);
    }
    | نتيجة.نجح(المداخل) -> {
        ليكن صالح: متغير منطقي = صواب;
        ليكن ف2: متغير طبيعي = 0;
        طالما (ف2 < (الطول(المداخل) مثل طبيعي)) {
            ليكن عربي: نص = «ar»;
            ليكن إنجليزي: نص = «en»;
            ليكن المشغل: نص = «runner»;
            إذا ((!نصان_متساويان(&المداخل[ف2].الاسم, &عربي)) && (!نصان_متساويان(&المداخل[ف2].الاسم, &إنجليزي)) && (!نصان_متساويان(&المداخل[ف2].الاسم, &المشغل))) { صالح := خطأ; };
            ف2 := ف2 + 1;
        }
        إذا (صالح) { سجل_نجاح(الملخص, &اسم_تخطيط); }
        وإلا { ليكن سبب: نص = «يوجد عنصر خارج tests/ar أو tests/en أو tests/runner»; سجل_فشل(الملخص, &اسم_تخطيط, &سبب); };
    };
}
