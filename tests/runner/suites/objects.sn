استورد "../common.sn";
استورد std.fs.read_file;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.search;

عرف اقرأ16(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع ((*ب)[م] مثل طبيعي)
        | (((*ب)[م + 1] مثل طبيعي) << 8);
}

عرف اقرأ32(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع اقرأ16(ب, م) | (اقرأ16(ب, م + 2) << 16);
}

عرف اقرأ64(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع اقرأ32(ب, م) | (اقرأ32(ب, م + 4) << 32);
}

عرف ضمن(ب: &متجه ط8, م: طبيعي, ن: طبيعي): منطقي {
    دع ك: طبيعي = الطول(*ب) مثل طبيعي;
    أرجع (م <= ك) && (ن <= (ك - م));
}

عرف نص_صفري(ب: &متجه ط8, م: طبيعي): اختياري نص {
    دع ك: طبيعي = الطول(*ب) مثل طبيعي;
    إذا (م >= ك) { أرجع اختياري.لا_شيء(); };
    دع ن: متغير طبيعي = م;
    طالما ((ن < ك) && ((*ب)[ن] != 0)) { ن := ن + 1; };
    إذا (ن >= ك) { أرجع اختياري.لا_شيء(); };
    دع جزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = م;
    طالما (ف < ن) { ألحق(جزء, (*ب)[ف]); ف := ف + 1; };
    أرجع اختياري.موجود(من_بايتات(&جزء));
}

عرف تحقق_إلف(المسار: &نص, يلزم_ترحيل: منطقي): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة ELF»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 64)) { أرجع اختياري.موجود(«ELF مبتور»); };
        إذا ((ب[0] != 0x7f) || (ب[1] != 0x45) || (ب[2] != 0x4c) || (ب[3] != 0x46)) {
            أرجع اختياري.موجود(«توقيع ELF غير صحيح»);
        };
        إذا ((ب[4] != 2) || (ب[5] != 1)) { أرجع اختياري.موجود(«ELF ليس 64-bit little-endian»); };
        إذا (اقرأ16(&ب, 16) != 1) { أرجع اختياري.موجود(«ELF ليس ET_REL»); };
        إذا (اقرأ16(&ب, 18) != 62) { أرجع اختياري.موجود(«ELF ليس x86_64»); };

        دع موضع_رؤوس: طبيعي = اقرأ64(&ب, 40);
        دع حجم_رأس: طبيعي = اقرأ16(&ب, 58);
        دع عدد_رؤوس: طبيعي = اقرأ16(&ب, 60);
        دع فهرس_أسماء: طبيعي = اقرأ16(&ب, 62);
        إذا ((حجم_رأس != 64) || (عدد_رؤوس == 0) || (فهرس_أسماء >= عدد_رؤوس)) {
            أرجع اختياري.موجود(«جدول أقسام ELF غير صالح»);
        };
        إذا (!ضمن(&ب, موضع_رؤوس, حجم_رأس * عدد_رؤوس)) {
            أرجع اختياري.موجود(«جدول أقسام ELF خارج الملف»);
        };

        دع رأس_أسماء: طبيعي = موضع_رؤوس + (فهرس_أسماء * حجم_رأس);
        دع موضع_أسماء: طبيعي = اقرأ64(&ب, رأس_أسماء + 24);
        دع حجم_أسماء: طبيعي = اقرأ64(&ب, رأس_أسماء + 32);
        إذا (!ضمن(&ب, موضع_أسماء, حجم_أسماء)) { أرجع اختياري.موجود(«shstrtab خارج الملف»); };

        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_رموز: متغير منطقي = خطأ;
        دع وجد_سلاسل: متغير منطقي = خطأ;
        دع وجد_ترحيل: متغير منطقي = خطأ;
        دع عدد_ترحيل: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_رؤوس) {
            دع رأس: طبيعي = موضع_رؤوس + (ف * حجم_رأس);
            دع إزاحة_اسم: طبيعي = اقرأ32(&ب, رأس);
            دع موضع_قسم: طبيعي = اقرأ64(&ب, رأس + 24);
            دع حجم_قسم: طبيعي = اقرأ64(&ب, رأس + 32);
            إذا ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) {
                أرجع اختياري.موجود(«قسم ELF خارج الملف»);
            };
            طابق نص_صفري(&ب, موضع_أسماء + إزاحة_اسم) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(«اسم قسم ELF غير منته»); }
            | اختياري.موجود(الاسم) -> {
                دع قسم_النص: نص = «.text»;
                دع رموز: نص = «.symtab»;
                دع سلاسل: نص = «.strtab»;
                دع ترحيل: نص = «.rela.text»;
                إذا (نصان_متساويان(&الاسم, &قسم_النص)) { وجد_نص := صواب; };
                إذا (نصان_متساويان(&الاسم, &رموز)) { وجد_رموز := صواب; };
                إذا (نصان_متساويان(&الاسم, &سلاسل)) { وجد_سلاسل := صواب; };
                إذا (نصان_متساويان(&الاسم, &ترحيل)) {
                    وجد_ترحيل := صواب;
                    دع حجم_مدخل: طبيعي = اقرأ64(&ب, رأس + 56);
                    إذا ((حجم_مدخل != 24) || ((حجم_قسم % 24) != 0)) {
                        أرجع اختياري.موجود(«جدول ترحيل ELF مشوه»);
                    };
                    عدد_ترحيل := حجم_قسم / 24;
                };
            };
            ف := ف + 1;
        }
        إذا ((!وجد_نص) || (!وجد_رموز) || (!وجد_سلاسل) || (!وجد_ترحيل)) {
            أرجع اختياري.موجود(«ELF يفتقد قسما معياريا»);
        };
        إذا (يلزم_ترحيل && (عدد_ترحيل == 0)) { أرجع اختياري.موجود(«ELF الخارجي بلا ترحيل»); };
        أرجع اختياري.لا_شيء();
    };
}

عرف اسم16(ب: &متجه ط8, م: طبيعي): نص {
    دع ن: متغير طبيعي = 0;
    طالما ((ن < 16) && ((*ب)[م + ن] != 0)) { ن := ن + 1; };
    دع جزء: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) { ألحق(جزء, (*ب)[م + ف]); ف := ف + 1; };
    أرجع من_بايتات(&جزء);
}

عرف تحقق_ماتشو_كائن(المسار: &نص, يلزم_ترحيل: منطقي): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة Mach-O»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 32)) { أرجع اختياري.موجود(«Mach-O مبتور»); };
        إذا (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختياري.موجود(«توقيع Mach-O غير صحيح»); };
        إذا (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختياري.موجود(«Mach-O ليس ARM64»); };
        إذا (اقرأ32(&ب, 12) != 1) { أرجع اختياري.موجود(«Mach-O ليس MH_OBJECT»); };
        دع عدد_أوامر: طبيعي = اقرأ32(&ب, 16);
        دع حجم_أوامر: طبيعي = اقرأ32(&ب, 20);
        إذا (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختياري.موجود(«أوامر Mach-O خارج الملف»); };
        دع موضع: متغير طبيعي = 32;
        دع ف: متغير طبيعي = 0;
        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_رموز: متغير منطقي = خطأ;
        دع ترحيلات: متغير طبيعي = 0;
        طالما (ف < عدد_أوامر) {
            إذا (!ضمن(&ب, موضع, 8)) { أرجع اختياري.موجود(«أمر Mach-O مبتور»); };
            دع الأمر: طبيعي = اقرأ32(&ب, موضع);
            دع الحجم: طبيعي = اقرأ32(&ب, موضع + 4);
            إذا ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) { أرجع اختياري.موجود(«حجم أمر Mach-O غير صالح»); };
            إذا (الأمر == 0x19) {
                دع عدد_أقسام: طبيعي = اقرأ32(&ب, موضع + 64);
                دع قسم: متغير طبيعي = موضع + 72;
                دع ق: متغير طبيعي = 0;
                طالما (ق < عدد_أقسام) {
                    إذا ((قسم + 80) > (موضع + الحجم)) { أرجع اختياري.موجود(«جدول أقسام Mach-O مشوه»); };
                    دع اسم: نص = اسم16(&ب, قسم);
                    دع اسم_نص: نص = «__text»;
                    إذا (نصان_متساويان(&اسم, &اسم_نص)) { وجد_نص := صواب; };
                    دع حجم_قسم: طبيعي = اقرأ64(&ب, قسم + 40);
                    دع موضع_قسم: طبيعي = اقرأ32(&ب, قسم + 48);
                    دع موضع_ترحيل: طبيعي = اقرأ32(&ب, قسم + 56);
                    دع عدد_ترحيل: طبيعي = اقرأ32(&ب, قسم + 60);
                    إذا ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) { أرجع اختياري.موجود(«قسم Mach-O خارج الملف»); };
                    إذا ((عدد_ترحيل > 0) && (!ضمن(&ب, موضع_ترحيل, عدد_ترحيل * 8))) { أرجع اختياري.موجود(«ترحيلات Mach-O خارج الملف»); };
                    ترحيلات := ترحيلات + عدد_ترحيل;
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا إذا (الأمر == 2) {
                وجد_رموز := صواب;
                دع موضع_رموز: طبيعي = اقرأ32(&ب, موضع + 8);
                دع عدد_رموز: طبيعي = اقرأ32(&ب, موضع + 12);
                دع موضع_سلاسل: طبيعي = اقرأ32(&ب, موضع + 16);
                دع حجم_سلاسل: طبيعي = اقرأ32(&ب, موضع + 20);
                إذا ((!ضمن(&ب, موضع_رموز, عدد_رموز * 16)) || (!ضمن(&ب, موضع_سلاسل, حجم_سلاسل))) {
                    أرجع اختياري.موجود(«جدول رموز Mach-O خارج الملف»);
                };
            };
            موضع := موضع + الحجم;
            ف := ف + 1;
        }
        إذا (موضع != (32 + حجم_أوامر)) { أرجع اختياري.موجود(«امتداد أوامر Mach-O غير مطابق»); };
        إذا ((!وجد_نص) || (!وجد_رموز)) { أرجع اختياري.موجود(«Mach-O يفتقد النص أو الرموز»); };
        إذا (يلزم_ترحيل && (ترحيلات == 0)) { أرجع اختياري.موجود(«Mach-O الخارجي بلا ترحيل»); };
        أرجع اختياري.لا_شيء();
    };
}

عرف جمع_كائن_اختبار(المصدر: &نص, الهدف: &نص, الناتج: &نص, الاسم: &نص): نتيجة_أمر {
    دع و: متجه نص = [«-c», «--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    دع المترجم: نص = مسار_المترجم();
    أرجع نفذ_أمرا(&المترجم, &و, الاسم);
}

عرف تحقق_كائن(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص,
    يلزم_ترحيل_خارجي: منطقي
): فراغ {
    دع جمع: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, الناتج, الاسم);
    إذا ((جمع.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&جمع)) {
        دع سبب: نص = «فشل توليد الكائن»;
        سجل_فشل(الملخص, الاسم, &سبب);
        أرجع;
    };
    دع اكس: نص = «x86_64-linux»;
    دع مشكلة: متغير اختياري نص = اختياري.لا_شيء();
    إذا (نصان_متساويان(الهدف, &اكس)) { مشكلة := تحقق_إلف(الناتج, يلزم_ترحيل_خارجي); } وإلا { مشكلة := تحقق_ماتشو_كائن(الناتج, يلزم_ترحيل_خارجي); };
    طابق مشكلة مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, الاسم, &السبب); }
    | اختياري.لا_شيء -> { سجل_نجاح(الملخص, الاسم); };
}

عرف تحقق_حتمية(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    البادئة: &نص
): فراغ {
    دع أجزاء1: متجه نص = [«build/tests-sultanc/», استنسخ(البادئة), «-1.o»];
    دع أجزاء2: متجه نص = [«build/tests-sultanc/», استنسخ(البادئة), «-2.o»];
    دع أ: نص = اجمع_نصوص(&أجزاء1);
    دع ب: نص = اجمع_نصوص(&أجزاء2);
    دع اسم1_أجزاء: متجه نص = [استنسخ(البادئة), «-first»];
    دع اسم2_أجزاء: متجه نص = [استنسخ(البادئة), «-second»];
    دع اسم1: نص = اجمع_نصوص(&اسم1_أجزاء);
    دع اسم2: نص = اجمع_نصوص(&اسم2_أجزاء);
    دع ج1: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &أ, &اسم1);
    دع ج2: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &ب, &اسم2);
    دع اسم_اختبار_أجزاء: متجه نص = [«حتمية الكائن », استنسخ(الهدف)];
    دع اسم_اختبار: نص = اجمع_نصوص(&اسم_اختبار_أجزاء);
    إذا ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (!ملفات_متساوية(&أ, &ب))) {
        دع سبب: نص = «إعادة الإصدار لم تنتج بايتات متطابقة»;
        سجل_فشل(الملخص, &اسم_اختبار, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, &اسم_اختبار);
    };
}

عرف تحقق_ماتشو_تنفيذي(المسار: &نص): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة Mach-O التنفيذي»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 32)) { أرجع اختياري.موجود(«Mach-O التنفيذي مبتور»); };
        إذا (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختياري.موجود(«توقيع Mach-O التنفيذي غير صحيح»); };
        إذا (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختياري.موجود(«Mach-O التنفيذي ليس ARM64»); };

        دع عدد_أوامر: طبيعي = اقرأ32(&ب, 16);
        دع حجم_أوامر: طبيعي = اقرأ32(&ب, 20);
        إذا (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختياري.موجود(«أوامر Mach-O التنفيذية خارج الملف»); };

        دع نهاية_أوامر: طبيعي = 32 + حجم_أوامر;
        دع موضع: متغير طبيعي = 32;
        دع ف: متغير طبيعي = 0;
        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_دخول: متغير منطقي = خطأ;
        دع وجد_توقيع: متغير منطقي = خطأ;
        دع موضع_نص: متغير طبيعي = 0;
        دع حجم_نص: متغير طبيعي = 0;
        دع موضع_دخول: متغير طبيعي = 0;

        طالما (ف < عدد_أوامر) {
            إذا (!ضمن(&ب, موضع, 8)) { أرجع اختياري.موجود(«أمر Mach-O تنفيذي مبتور»); };
            دع الأمر: طبيعي = اقرأ32(&ب, موضع);
            دع الحجم: طبيعي = اقرأ32(&ب, موضع + 4);
            إذا ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) {
                أرجع اختياري.موجود(«حجم أمر Mach-O تنفيذي غير صالح»);
            };

            إذا (الأمر == 0x19) {
                إذا (الحجم < 72) { أرجع اختياري.موجود(«LC_SEGMENT_64 مبتور»); };
                دع عدد_أقسام: طبيعي = اقرأ32(&ب, موضع + 64);
                دع قسم: متغير طبيعي = موضع + 72;
                دع ق: متغير طبيعي = 0;
                طالما (ق < عدد_أقسام) {
                    إذا ((قسم + 80) > (موضع + الحجم)) {
                        أرجع اختياري.موجود(«أقسام Mach-O التنفيذية مشوهة»);
                    };
                    دع اسم_قسم: نص = اسم16(&ب, قسم);
                    دع اسم_قطاع: نص = اسم16(&ب, قسم + 16);
                    دع نص_اسم: نص = «__text»;
                    دع قطاع_نص: نص = «__TEXT»;
                    إذا (نصان_متساويان(&اسم_قسم, &نص_اسم) && نصان_متساويان(&اسم_قطاع, &قطاع_نص)) {
                        وجد_نص := صواب;
                        حجم_نص := اقرأ64(&ب, قسم + 40);
                        موضع_نص := اقرأ32(&ب, قسم + 48);
                        إذا (!ضمن(&ب, موضع_نص, حجم_نص)) {
                            أرجع اختياري.موجود(«قسم __text خارج الملف»);
                        };
                    };
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا إذا (الأمر == 0x80000028) {
                إذا (الحجم < 24) { أرجع اختياري.موجود(«LC_MAIN مبتور»); };
                وجد_دخول := صواب;
                موضع_دخول := اقرأ64(&ب, موضع + 8);
            } وإلا إذا (الأمر == 0x1d) {
                إذا (الحجم != 16) { أرجع اختياري.موجود(«حجم LC_CODE_SIGNATURE غير صحيح»); };
                دع موضع_توقيع: طبيعي = اقرأ32(&ب, موضع + 8);
                دع حجم_توقيع: طبيعي = اقرأ32(&ب, موضع + 12);
                إذا ((حجم_توقيع == 0) || (!ضمن(&ب, موضع_توقيع, حجم_توقيع))) {
                    أرجع اختياري.موجود(«بيانات توقيع Mach-O خارج الملف»);
                };
                وجد_توقيع := صواب;
            };

            موضع := موضع + الحجم;
            ف := ف + 1;
        }

        إذا (موضع != نهاية_أوامر) { أرجع اختياري.موجود(«امتداد أوامر Mach-O التنفيذي غير مطابق»); };
        إذا ((!وجد_نص) || (!وجد_دخول) || (!وجد_توقيع)) {
            أرجع اختياري.موجود(«Mach-O التنفيذي يفتقد __text أو LC_MAIN أو LC_CODE_SIGNATURE»);
        };
        إذا (نهاية_أوامر > موضع_نص) { أرجع اختياري.موجود(«أوامر Mach-O تتداخل مع __text»); };
        إذا ((موضع_دخول < موضع_نص) || (موضع_دخول >= (موضع_نص + حجم_نص))) {
            أرجع اختياري.موجود(«LC_MAIN خارج __text»);
        };
        إذا ((!ضمن(&ب, موضع_دخول, 4)) || (اقرأ32(&ب, موضع_دخول) == 0x1d)) {
            أرجع اختياري.موجود(«نقطة الدخول غير صالحة»);
        };

        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_تنفيذ_42(المسار: &نص, الاسم: &نص): منطقي {
    دع وسائط: متجه نص = [];
    دع نتيجة: نتيجة_أمر = نفذ_أمرا(المسار, &وسائط, الاسم);
    أرجع نتيجة.الحالة == 42;
}

عرف تحقق_توقيع_ماتشو(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع مصدر: نص = «tests/en/compiler/semantic/return_precedence.sn»;
    دع مصدر_واجهة_أجنبية: نص = «tests/en/runtime/ffi/ffi_abs.sn»;
    دع هدف: نص = «arm64-darwin»;
    دع أ: نص = «build/tests-sultanc/macho-signed-a»;
    دع ب: نص = «build/tests-sultanc/macho-signed-b»;
    دع تنفيذي_واجهة_أجنبية: نص = «build/tests-sultanc/macho-signed-ffi»;
    دع مترجم: نص = مسار_المترجم();
    دع و1: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&أ)];
    دع و2: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&ب)];
    دع و3: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر_واجهة_أجنبية), «-o», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
    دع ن1: نص = «macho-executable-a»;
    دع ن2: نص = «macho-executable-b»;
    دع ن3: نص = «macho-executable-ffi»;
    دع ج1: نتيجة_أمر = نفذ_أمرا(&مترجم, &و1, &ن1);
    دع ج2: نتيجة_أمر = نفذ_أمرا(&مترجم, &و2, &ن2);
    دع ج3: نتيجة_أمر = نفذ_أمرا(&مترجم, &و3, &ن3);
    دع الاسم: نص = «حتمية وتوقيع Mach-O التنفيذي»;

    إذا ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (ج3.الحالة != 0)
        || نتيجة_تحوي_فشلا_داخليا(&ج1) || نتيجة_تحوي_فشلا_داخليا(&ج2) || نتيجة_تحوي_فشلا_داخليا(&ج3)) {
        دع سبب: نص = «فشل بناء Mach-O التنفيذي العادي أو FFI»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    إذا (!ملفات_متساوية(&أ, &ب)) {
        دع سبب: نص = «مدخل Mach-O المتطابق لم ينتج بايتات متطابقة»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق تحقق_ماتشو_تنفيذي(&أ) مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختياري.لا_شيء -> { };

    طابق تحقق_ماتشو_تنفيذي(&تنفيذي_واجهة_أجنبية) مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختياري.لا_شيء -> { };

    دع مضيف_ذراع: متغير منطقي = خطأ;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        إذا (نصان_متساويان(&المضيف, &هدف)) { مضيف_ذراع := صواب; };
    }
    | _ -> { };

    إذا (مضيف_ذراع) {
        دع برنامج_توقيع: نص = «/usr/bin/codesign»;
        دع تحقق: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&أ)];
        دع تحقق_واجهة_أجنبية: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
        دع اسم_تحقق: نص = «codesign-normal»;
        دع اسم_تحقق_واجهة_أجنبية: نص = «codesign-ffi»;
        دع ت1: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق, &اسم_تحقق);
        دع ت2: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق_واجهة_أجنبية, &اسم_تحقق_واجهة_أجنبية);
        دع اسم_تشغيل: نص = «macho-run-normal»;
        دع اسم_تشغيل_واجهة_أجنبية: نص = «macho-run-ffi»;
        إذا ((ت1.الحالة != 0) || (ت2.الحالة != 0)
            || (!تحقق_تنفيذ_42(&أ, &اسم_تشغيل))
            || (!تحقق_تنفيذ_42(&تنفيذي_واجهة_أجنبية, &اسم_تشغيل_واجهة_أجنبية))) {
            دع سبب: نص = «فشل تحقق codesign أو التنفيذ الأصلي على Darwin ARM64»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
    };

    سجل_نجاح(الملخص, &الاسم);
}

// Link inputs (compiler/link/input_ingest.sn): an SDK's text-based dylib
// stub (.tbd) is a dylib to a Mach-O link, its install name loaded and its
// exports bound to it; on another target, or when the file is no object,
// archive or library at all, the link names the file in a user diagnostic,
// never an internal error (previously SULTANC-ICE-CONTEXT
// link.macho.invalid-object for `-l c` with an SDK's libc.tbd).
عرف بايتات_تحتوي(البايتات: &متجه ط8, النص: &نص): منطقي {
    دع الطول_المطلوب: طبيعي = الطول(*النص) مثل طبيعي;
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الطول_المطلوب > العدد) { أرجع خطأ; };
    دع م: متغير طبيعي = 0;
    طالما (م + الطول_المطلوب <= العدد) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < الطول_المطلوب && (*البايتات)[م + ك] == (*النص)[ك]) { ك := ك + 1; }
        إذا (ك == الطول_المطلوب) { أرجع صواب; };
        م := م + 1;
    }
    أرجع خطأ;
}

عرف تحقق_مدخل_ربط_مرفوض(
    الملخص: &متغير ملخص_اختبارات,
    الاسم: نص,
    الوسائط: متجه نص,
    المسار: نص
): فراغ {
    دع مترجم: نص = مسار_المترجم();
    دع النتيجة: نتيجة_أمر = نفذ_أمرا(&مترجم, &الوسائط, &الاسم);
    دع الكود: نص = «SULTANC-LINK-INPUT-UNSUPPORTED»;
    إذا (النتيجة.الحالة != 3
        || !يحتوي_نصا(&النتيجة.الخطأ, &الكود)
        || !يحتوي_نصا(&النتيجة.الخطأ, &المسار)
        || نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
        دع سبب: نص = «مدخل ربط غير قابل للربط لم يبلغ بتشخيص للمستخدم يسمي الملف»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, &الاسم);
    };
}

عرف تحقق_مدخلات_الربط(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع مترجم: نص = مسار_المترجم();
    // -l c with an SDK's libc.tbd on the -L path: libSystem, already linked.
    دع اسم_سي: نص = «-l c مع libc.tbd لـ arm64-darwin»;
    دع و_سي: متجه نص = [
        «tests/en/compiler/c_import_units/main.sn», «--target», «arm64-darwin»,
        «-o», «build/tests-sultanc/tbd-libc-darwin», «-L», «tests/runner/fixtures/darwin_libc», «-l», «c»
    ];
    دع نتيجة_سي: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_سي, &اسم_سي);
    إذا (نتيجة_سي.الحالة == 0) {
        سجل_نجاح(الملخص, &اسم_سي);
    } وإلا {
        دع سبب: نص = «ربط arm64-darwin مع -l c وlibc.tbd فشل»;
        سجل_فشل(الملخص, &اسم_سي, &سبب);
    };
    // abs from a stub's re-exported document binds to the stub's dylib.
    دع اسم_مكتبة: نص = «ربط رمز من مكتبة .tbd لـ arm64-darwin»;
    دع ناتج_مكتبة: نص = «build/tests-sultanc/tbd-fake-darwin»;
    دع و_مكتبة: متجه نص = [
        «tests/en/runtime/ffi/ffi_abs.sn», «--target», «arm64-darwin», «-o», انسخ_نص_اختبار(&ناتج_مكتبة),
        «-L», «tests/runner/fixtures/link_inputs», «-l», «fake»
    ];
    دع نتيجة_مكتبة: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_مكتبة, &اسم_مكتبة);
    دع اسم_التثبيت: نص = «/usr/lib/libfake.dylib»;
    دع الصورة: متغير متجه ط8 = [];
    إذا (نتيجة_مكتبة.الحالة == 0) {
        طابق اقرأ_بايتات_ملف(&ناتج_مكتبة) مع
        | نتيجة.نجح(البايتات) -> { الصورة := البايتات; }
        | نتيجة.خطأ(_) -> { };
    };
    إذا (بايتات_تحتوي(&الصورة, &اسم_التثبيت)) {
        سجل_نجاح(الملخص, &اسم_مكتبة);
    } وإلا {
        دع سبب: نص = «الصورة لا تحمل LC_LOAD_DYLIB لاسم تثبيت المكتبة النصية»;
        سجل_فشل(الملخص, &اسم_مكتبة, &سبب);
    };
    // Archives with nothing to link (only `!<arch>\n`; members that are not
    // objects, no symbol index), named with -l: they contribute nothing, as
    // with GNU ld, never an internal error. In both languages.
    دع مصادر_الأرشيف: متجه نص = [«tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»];
    دع مكتبات_الأرشيف: متجه نص = [«empty», «noobjects»];
    دع لغات_الأرشيف: متجه نص = [«en», «ar»];
    دع م_أ: متغير طبيعي = 0;
    طالما (م_أ < 2) {
        دع ك_أ: متغير طبيعي = 0;
        طالما (ك_أ < 2) {
            دع أجزاء_الاسم: متجه نص = [«أرشيف بلا كائنات -l », انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ]), « (», انسخ_نص_اختبار(&مصادر_الأرشيف[م_أ]), «)»];
            دع اسم_الأرشيف: نص = اجمع_نصوص(&أجزاء_الاسم);
            دع أجزاء_الناتج: متجه نص = [«build/tests-sultanc/archive-», انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ]), «-», انسخ_نص_اختبار(&لغات_الأرشيف[م_أ])];
            دع ناتج_الأرشيف: نص = اجمع_نصوص(&أجزاء_الناتج);
            دع و_أرشيف: متجه نص = [
                انسخ_نص_اختبار(&مصادر_الأرشيف[م_أ]), «--target», «x86_64-linux», «-o», انسخ_نص_اختبار(&ناتج_الأرشيف),
                «-L», «tests/runner/fixtures/link_inputs», «-l», انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ])
            ];
            دع نتيجة_الأرشيف: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_أرشيف, &اسم_الأرشيف);
            إذا (نتيجة_الأرشيف.الحالة != 0 || نتيجة_تحوي_فشلا_داخليا(&نتيجة_الأرشيف)) {
                دع سبب: نص = «ربط برنامج مع أرشيف لا كائنات فيه فشل»;
                سجل_فشل(الملخص, &اسم_الأرشيف, &سبب);
            } وإلا إذا (!تحقق_تنفيذ_42(&ناتج_الأرشيف, &اسم_الأرشيف)) {
                دع سبب: نص = «البرنامج المربوط مع أرشيف لا كائنات فيه لم يخرج بالحالة 42»;
                سجل_فشل(الملخص, &اسم_الأرشيف, &سبب);
            } وإلا {
                سجل_نجاح(الملخص, &اسم_الأرشيف);
            };
            ك_أ := ك_أ + 1;
        }
        م_أ := م_أ + 1;
    }
    // Linked ELF executables carry .symtab and .strtab with the objects'
    // function symbols (elf/symbol_output.sn), for both backends and in
    // both languages: debuggers and unwinders find a frame's function by
    // them.
    دع مصادر_الرموز: متجه نص = [«tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»];
    دع خلفيات_الرموز: متجه نص = [«--backend=native», «--backend=llvm»];
    دع م_ر: متغير طبيعي = 0;
    طالما (م_ر < 2) {
        دع ك_ر: متغير طبيعي = 0;
        طالما (ك_ر < 2) {
            دع أجزاء_الاسم: متجه نص = [«جدول رموز ELF التنفيذي », انسخ_نص_اختبار(&خلفيات_الرموز[ك_ر]), « (», انسخ_نص_اختبار(&مصادر_الرموز[م_ر]), «)»];
            دع اسم_الرموز: نص = اجمع_نصوص(&أجزاء_الاسم);
            دع أجزاء_الناتج: متجه نص = [«build/tests-sultanc/symtab-», انسخ_نص_اختبار(&لغات_الأرشيف[م_ر]), «-», انسخ_نص_اختبار(&لغات_الأرشيف[ك_ر])];
            دع ناتج_الرموز: نص = اجمع_نصوص(&أجزاء_الناتج);
            دع و_رموز: متجه نص = [
                انسخ_نص_اختبار(&مصادر_الرموز[م_ر]), انسخ_نص_اختبار(&خلفيات_الرموز[ك_ر]), «--target», «x86_64-linux»,
                «-o», انسخ_نص_اختبار(&ناتج_الرموز)
            ];
            دع نتيجة_الرموز: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_رموز, &اسم_الرموز);
            دع صورة_الرموز: متغير متجه ط8 = [];
            إذا (نتيجة_الرموز.الحالة == 0) {
                طابق اقرأ_بايتات_ملف(&ناتج_الرموز) مع
                | نتيجة.نجح(البايتات) -> { صورة_الرموز := البايتات; }
                | نتيجة.خطأ(_) -> { };
            };
            دع اسم_الجدول: نص = «.symtab»;
            دع اسم_الدالة: نص = «is_even»;
            إذا (بايتات_تحتوي(&صورة_الرموز, &اسم_الجدول) && بايتات_تحتوي(&صورة_الرموز, &اسم_الدالة)
                && تحقق_تنفيذ_42(&ناتج_الرموز, &اسم_الرموز)) {
                سجل_نجاح(الملخص, &اسم_الرموز);
            } وإلا {
                دع سبب: نص = «الملف التنفيذي بلا .symtab تسمي دوال الكائنات، أو لم يخرج بالحالة 42»;
                سجل_فشل(الملخص, &اسم_الرموز, &سبب);
            };
            ك_ر := ك_ر + 1;
        }
        م_ر := م_ر + 1;
    }
    // A .tbd outside a Mach-O link, and a file in no linkable format.
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «مكتبة .tbd في ربط x86_64-linux»,
        [«examples/en/basics/arithmetic.sn», «--target», «x86_64-linux», «-o», «build/tests-sultanc/tbd-linux»,
         «tests/runner/fixtures/darwin_libc/libc.tbd»],
        «tests/runner/fixtures/darwin_libc/libc.tbd»
    );
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «ملف مجهول الصيغة في ربط x86_64-linux»,
        [«examples/en/basics/arithmetic.sn», «--target», «x86_64-linux», «-o», «build/tests-sultanc/garbage-linux»,
         «tests/runner/fixtures/link_inputs/garbage.bin»],
        «tests/runner/fixtures/link_inputs/garbage.bin»
    );
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «ملف مجهول الصيغة في ربط arm64-darwin»,
        [«examples/en/basics/arithmetic.sn», «--target», «arm64-darwin», «-o», «build/tests-sultanc/garbage-darwin»,
         «tests/runner/fixtures/link_inputs/garbage.bin»],
        «tests/runner/fixtures/link_inputs/garbage.bin»
    );
}

عام عرف اختبر_الكائنات(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع مصدر_خارجي: نص = «tests/en/object/source/external_call.sn»;
    دع بسيط: نص = «tests/en/object/source/simple.sn»;
    دع اكس: نص = «x86_64-linux»;
    دع ذراع: نص = «arm64-darwin»;
    دع ملف_إلف: نص = «build/tests-sultanc/external-x86_64.o»;
    دع ملف_ماتشو: نص = «build/tests-sultanc/external-arm64.o»;
    دع اسم_إلف: نص = «بنية ELF وترحيلاته»;
    دع اسم_ماتشو: نص = «بنية Mach-O وترحيلاته»;
    تحقق_كائن(الملخص, &مصدر_خارجي, &اكس, &ملف_إلف, &اسم_إلف, صواب);
    تحقق_كائن(الملخص, &مصدر_خارجي, &ذراع, &ملف_ماتشو, &اسم_ماتشو, صواب);
    دع ب1: نص = «deterministic-elf»;
    دع ب2: نص = «deterministic-macho»;
    تحقق_حتمية(الملخص, &بسيط, &اكس, &ب1);
    تحقق_حتمية(الملخص, &بسيط, &ذراع, &ب2);
    تحقق_توقيع_ماتشو(الملخص);
    تحقق_مدخلات_الربط(الملخص);
}
