استورد "../common.sn";
استورد std.fs.read_file;
استورد std.text.from_bytes;
استورد std.text.compare;

عرف اقرأ16(ب: &متجه غ8, م: غير_موقع): غير_موقع {
    أرجع ((*ب)[م] مثل غير_موقع)
        | (((*ب)[م + 1] مثل غير_موقع) << 8);
}

عرف اقرأ32(ب: &متجه غ8, م: غير_موقع): غير_موقع {
    أرجع اقرأ16(ب, م) | (اقرأ16(ب, م + 2) << 16);
}

عرف اقرأ64(ب: &متجه غ8, م: غير_موقع): غير_موقع {
    أرجع اقرأ32(ب, م) | (اقرأ32(ب, م + 4) << 32);
}

عرف ضمن(ب: &متجه غ8, م: غير_موقع, ن: غير_موقع): منطقي {
    دع ك: غير_موقع = الطول(*ب) مثل غير_موقع;
    أرجع (م <= ك) && (ن <= (ك - م));
}

عرف نص_صفري(ب: &متجه غ8, م: غير_موقع): اختيار نص {
    دع ك: غير_موقع = الطول(*ب) مثل غير_موقع;
    لو (م >= ك) { أرجع اختيار.لا_شيء(); };
    دع ن: متغير غير_موقع = م;
    بينما ((ن < ك) && ((*ب)[ن] != 0)) { ن := ن + 1; };
    لو (ن >= ك) { أرجع اختيار.لا_شيء(); };
    دع جزء: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = م;
    بينما (ف < ن) { ألحق(جزء, (*ب)[ف]); ف := ف + 1; };
    أرجع اختيار.بعض(من_بايتات(&جزء));
}

عرف تحقق_إلف(المسار: &نص, يلزم_ترحيل: منطقي): اختيار نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(«تعذر قراءة ELF»); }
    | نتيجة.نجح(ب) -> {
        لو (!ضمن(&ب, 0, 64)) { أرجع اختيار.بعض(«ELF مبتور»); };
        لو ((ب[0] != 0x7f) || (ب[1] != 0x45) || (ب[2] != 0x4c) || (ب[3] != 0x46)) {
            أرجع اختيار.بعض(«توقيع ELF غير صحيح»);
        };
        لو ((ب[4] != 2) || (ب[5] != 1)) { أرجع اختيار.بعض(«ELF ليس 64-bit little-endian»); };
        لو (اقرأ16(&ب, 16) != 1) { أرجع اختيار.بعض(«ELF ليس ET_REL»); };
        لو (اقرأ16(&ب, 18) != 62) { أرجع اختيار.بعض(«ELF ليس x86_64»); };

        دع موضع_رؤوس: غير_موقع = اقرأ64(&ب, 40);
        دع حجم_رأس: غير_موقع = اقرأ16(&ب, 58);
        دع عدد_رؤوس: غير_موقع = اقرأ16(&ب, 60);
        دع فهرس_أسماء: غير_موقع = اقرأ16(&ب, 62);
        لو ((حجم_رأس != 64) || (عدد_رؤوس == 0) || (فهرس_أسماء >= عدد_رؤوس)) {
            أرجع اختيار.بعض(«جدول أقسام ELF غير صالح»);
        };
        لو (!ضمن(&ب, موضع_رؤوس, حجم_رأس * عدد_رؤوس)) {
            أرجع اختيار.بعض(«جدول أقسام ELF خارج الملف»);
        };

        دع رأس_أسماء: غير_موقع = موضع_رؤوس + (فهرس_أسماء * حجم_رأس);
        دع موضع_أسماء: غير_موقع = اقرأ64(&ب, رأس_أسماء + 24);
        دع حجم_أسماء: غير_موقع = اقرأ64(&ب, رأس_أسماء + 32);
        لو (!ضمن(&ب, موضع_أسماء, حجم_أسماء)) { أرجع اختيار.بعض(«shstrtab خارج الملف»); };

        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_رموز: متغير منطقي = خطأ;
        دع وجد_سلاسل: متغير منطقي = خطأ;
        دع وجد_ترحيل: متغير منطقي = خطأ;
        دع عدد_ترحيل: متغير غير_موقع = 0;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < عدد_رؤوس) {
            دع رأس: غير_موقع = موضع_رؤوس + (ف * حجم_رأس);
            دع إزاحة_اسم: غير_موقع = اقرأ32(&ب, رأس);
            دع موضع_قسم: غير_موقع = اقرأ64(&ب, رأس + 24);
            دع حجم_قسم: غير_موقع = اقرأ64(&ب, رأس + 32);
            لو ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) {
                أرجع اختيار.بعض(«قسم ELF خارج الملف»);
            };
            طابق نص_صفري(&ب, موضع_أسماء + إزاحة_اسم) مع
            | اختيار.لا_شيء -> { أرجع اختيار.بعض(«اسم قسم ELF غير منته»); }
            | اختيار.بعض(الاسم) -> {
                دع قسم_النص: نص = «.text»;
                دع رموز: نص = «.symtab»;
                دع سلاسل: نص = «.strtab»;
                دع ترحيل: نص = «.rela.text»;
                لو (نصان_متساويان(&الاسم, &قسم_النص)) { وجد_نص := صواب; };
                لو (نصان_متساويان(&الاسم, &رموز)) { وجد_رموز := صواب; };
                لو (نصان_متساويان(&الاسم, &سلاسل)) { وجد_سلاسل := صواب; };
                لو (نصان_متساويان(&الاسم, &ترحيل)) {
                    وجد_ترحيل := صواب;
                    دع حجم_مدخل: غير_موقع = اقرأ64(&ب, رأس + 56);
                    لو ((حجم_مدخل != 24) || ((حجم_قسم % 24) != 0)) {
                        أرجع اختيار.بعض(«جدول ترحيل ELF مشوه»);
                    };
                    عدد_ترحيل := حجم_قسم / 24;
                };
            };
            ف := ف + 1;
        }
        لو ((!وجد_نص) || (!وجد_رموز) || (!وجد_سلاسل) || (!وجد_ترحيل)) {
            أرجع اختيار.بعض(«ELF يفتقد قسما معياريا»);
        };
        لو (يلزم_ترحيل && (عدد_ترحيل == 0)) { أرجع اختيار.بعض(«ELF الخارجي بلا ترحيل»); };
        أرجع اختيار.لا_شيء();
    };
}

عرف اسم16(ب: &متجه غ8, م: غير_موقع): نص {
    دع ن: متغير غير_موقع = 0;
    بينما ((ن < 16) && ((*ب)[م + ن] != 0)) { ن := ن + 1; };
    دع جزء: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < ن) { ألحق(جزء, (*ب)[م + ف]); ف := ف + 1; };
    أرجع من_بايتات(&جزء);
}

عرف تحقق_ماتشو_كائن(المسار: &نص, يلزم_ترحيل: منطقي): اختيار نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(«تعذر قراءة Mach-O»); }
    | نتيجة.نجح(ب) -> {
        لو (!ضمن(&ب, 0, 32)) { أرجع اختيار.بعض(«Mach-O مبتور»); };
        لو (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختيار.بعض(«توقيع Mach-O غير صحيح»); };
        لو (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختيار.بعض(«Mach-O ليس ARM64»); };
        لو (اقرأ32(&ب, 12) != 1) { أرجع اختيار.بعض(«Mach-O ليس MH_OBJECT»); };
        دع عدد_أوامر: غير_موقع = اقرأ32(&ب, 16);
        دع حجم_أوامر: غير_موقع = اقرأ32(&ب, 20);
        لو (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختيار.بعض(«أوامر Mach-O خارج الملف»); };
        دع موضع: متغير غير_موقع = 32;
        دع ف: متغير غير_موقع = 0;
        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_رموز: متغير منطقي = خطأ;
        دع ترحيلات: متغير غير_موقع = 0;
        بينما (ف < عدد_أوامر) {
            لو (!ضمن(&ب, موضع, 8)) { أرجع اختيار.بعض(«أمر Mach-O مبتور»); };
            دع الأمر: غير_موقع = اقرأ32(&ب, موضع);
            دع الحجم: غير_موقع = اقرأ32(&ب, موضع + 4);
            لو ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) { أرجع اختيار.بعض(«حجم أمر Mach-O غير صالح»); };
            لو (الأمر == 0x19) {
                دع عدد_أقسام: غير_موقع = اقرأ32(&ب, موضع + 64);
                دع قسم: متغير غير_موقع = موضع + 72;
                دع ق: متغير غير_موقع = 0;
                بينما (ق < عدد_أقسام) {
                    لو ((قسم + 80) > (موضع + الحجم)) { أرجع اختيار.بعض(«جدول أقسام Mach-O مشوه»); };
                    دع اسم: نص = اسم16(&ب, قسم);
                    دع اسم_نص: نص = «__text»;
                    لو (نصان_متساويان(&اسم, &اسم_نص)) { وجد_نص := صواب; };
                    دع حجم_قسم: غير_موقع = اقرأ64(&ب, قسم + 40);
                    دع موضع_قسم: غير_موقع = اقرأ32(&ب, قسم + 48);
                    دع موضع_ترحيل: غير_موقع = اقرأ32(&ب, قسم + 56);
                    دع عدد_ترحيل: غير_موقع = اقرأ32(&ب, قسم + 60);
                    لو ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) { أرجع اختيار.بعض(«قسم Mach-O خارج الملف»); };
                    لو ((عدد_ترحيل > 0) && (!ضمن(&ب, موضع_ترحيل, عدد_ترحيل * 8))) { أرجع اختيار.بعض(«ترحيلات Mach-O خارج الملف»); };
                    ترحيلات := ترحيلات + عدد_ترحيل;
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا لو (الأمر == 2) {
                وجد_رموز := صواب;
                دع موضع_رموز: غير_موقع = اقرأ32(&ب, موضع + 8);
                دع عدد_رموز: غير_موقع = اقرأ32(&ب, موضع + 12);
                دع موضع_سلاسل: غير_موقع = اقرأ32(&ب, موضع + 16);
                دع حجم_سلاسل: غير_موقع = اقرأ32(&ب, موضع + 20);
                لو ((!ضمن(&ب, موضع_رموز, عدد_رموز * 16)) || (!ضمن(&ب, موضع_سلاسل, حجم_سلاسل))) {
                    أرجع اختيار.بعض(«جدول رموز Mach-O خارج الملف»);
                };
            };
            موضع := موضع + الحجم;
            ف := ف + 1;
        }
        لو (موضع != (32 + حجم_أوامر)) { أرجع اختيار.بعض(«امتداد أوامر Mach-O غير مطابق»); };
        لو ((!وجد_نص) || (!وجد_رموز)) { أرجع اختيار.بعض(«Mach-O يفتقد النص أو الرموز»); };
        لو (يلزم_ترحيل && (ترحيلات == 0)) { أرجع اختيار.بعض(«Mach-O الخارجي بلا ترحيل»); };
        أرجع اختيار.لا_شيء();
    };
}

عرف جمع_كائن_اختبار(المصدر: &نص, الهدف: &نص, الناتج: &نص, الاسم: &نص): نتيجة_أمر {
    دع و: متجه نص = [«-c», «--target», *الهدف, *المصدر, «-o», *الناتج];
    دع المترجم: نص = مسار_المترجم();
    أرجع نفذ_أمرا(&المترجم, &و, الاسم);
}

عرف تحقق_كائن(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص,
    يلزم_ترحيل_خارجي: منطقي
): فراغ {
    دع جمع: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, الناتج, الاسم);
    لو ((جمع.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&جمع)) {
        دع سبب: نص = «فشل توليد الكائن»;
        سجل_فشل(الملخص, الاسم, &سبب);
        أرجع;
    };
    دع اكس: نص = «x86_64-linux»;
    دع مشكلة: متغير اختيار نص = اختيار.لا_شيء();
    لو (نصان_متساويان(الهدف, &اكس)) { مشكلة := تحقق_إلف(الناتج, يلزم_ترحيل_خارجي); } وإلا { مشكلة := تحقق_ماتشو_كائن(الناتج, يلزم_ترحيل_خارجي); };
    طابق مشكلة مع
    | اختيار.بعض(السبب) -> { سجل_فشل(الملخص, الاسم, &السبب); }
    | اختيار.لا_شيء -> { سجل_نجاح(الملخص, الاسم); };
}

عرف تحقق_حتمية(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    البادئة: &نص
): فراغ {
    دع أجزاء1: متجه نص = [«build/tests-sultanc/», *البادئة, «-1.o»];
    دع أجزاء2: متجه نص = [«build/tests-sultanc/», *البادئة, «-2.o»];
    دع أ: نص = اجمع_نصوص(&أجزاء1);
    دع ب: نص = اجمع_نصوص(&أجزاء2);
    دع اسم1_أجزاء: متجه نص = [*البادئة, «-first»];
    دع اسم2_أجزاء: متجه نص = [*البادئة, «-second»];
    دع اسم1: نص = اجمع_نصوص(&اسم1_أجزاء);
    دع اسم2: نص = اجمع_نصوص(&اسم2_أجزاء);
    دع ج1: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &أ, &اسم1);
    دع ج2: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &ب, &اسم2);
    دع اسم_اختبار_أجزاء: متجه نص = [«حتمية الكائن », *الهدف];
    دع اسم_اختبار: نص = اجمع_نصوص(&اسم_اختبار_أجزاء);
    لو ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (!ملفات_متساوية(&أ, &ب))) {
        دع سبب: نص = «إعادة الإصدار لم تنتج بايتات متطابقة»;
        سجل_فشل(الملخص, &اسم_اختبار, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, &اسم_اختبار);
    };
}

عرف تحقق_ماتشو_تنفيذي(المسار: &نص): اختيار نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(«تعذر قراءة Mach-O التنفيذي»); }
    | نتيجة.نجح(ب) -> {
        لو (!ضمن(&ب, 0, 32)) { أرجع اختيار.بعض(«Mach-O التنفيذي مبتور»); };
        لو (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختيار.بعض(«توقيع Mach-O التنفيذي غير صحيح»); };
        لو (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختيار.بعض(«Mach-O التنفيذي ليس ARM64»); };

        دع عدد_أوامر: غير_موقع = اقرأ32(&ب, 16);
        دع حجم_أوامر: غير_موقع = اقرأ32(&ب, 20);
        لو (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختيار.بعض(«أوامر Mach-O التنفيذية خارج الملف»); };

        دع نهاية_أوامر: غير_موقع = 32 + حجم_أوامر;
        دع موضع: متغير غير_موقع = 32;
        دع ف: متغير غير_موقع = 0;
        دع وجد_نص: متغير منطقي = خطأ;
        دع وجد_دخول: متغير منطقي = خطأ;
        دع وجد_توقيع: متغير منطقي = خطأ;
        دع موضع_نص: متغير غير_موقع = 0;
        دع حجم_نص: متغير غير_موقع = 0;
        دع موضع_دخول: متغير غير_موقع = 0;

        بينما (ف < عدد_أوامر) {
            لو (!ضمن(&ب, موضع, 8)) { أرجع اختيار.بعض(«أمر Mach-O تنفيذي مبتور»); };
            دع الأمر: غير_موقع = اقرأ32(&ب, موضع);
            دع الحجم: غير_موقع = اقرأ32(&ب, موضع + 4);
            لو ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) {
                أرجع اختيار.بعض(«حجم أمر Mach-O تنفيذي غير صالح»);
            };

            لو (الأمر == 0x19) {
                لو (الحجم < 72) { أرجع اختيار.بعض(«LC_SEGMENT_64 مبتور»); };
                دع عدد_أقسام: غير_موقع = اقرأ32(&ب, موضع + 64);
                دع قسم: متغير غير_موقع = موضع + 72;
                دع ق: متغير غير_موقع = 0;
                بينما (ق < عدد_أقسام) {
                    لو ((قسم + 80) > (موضع + الحجم)) {
                        أرجع اختيار.بعض(«أقسام Mach-O التنفيذية مشوهة»);
                    };
                    دع اسم_قسم: نص = اسم16(&ب, قسم);
                    دع اسم_قطاع: نص = اسم16(&ب, قسم + 16);
                    دع نص_اسم: نص = «__text»;
                    دع قطاع_نص: نص = «__TEXT»;
                    لو (نصان_متساويان(&اسم_قسم, &نص_اسم) && نصان_متساويان(&اسم_قطاع, &قطاع_نص)) {
                        وجد_نص := صواب;
                        حجم_نص := اقرأ64(&ب, قسم + 40);
                        موضع_نص := اقرأ32(&ب, قسم + 48);
                        لو (!ضمن(&ب, موضع_نص, حجم_نص)) {
                            أرجع اختيار.بعض(«قسم __text خارج الملف»);
                        };
                    };
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا لو (الأمر == 0x80000028) {
                لو (الحجم < 24) { أرجع اختيار.بعض(«LC_MAIN مبتور»); };
                وجد_دخول := صواب;
                موضع_دخول := اقرأ64(&ب, موضع + 8);
            } وإلا لو (الأمر == 0x1d) {
                لو (الحجم != 16) { أرجع اختيار.بعض(«حجم LC_CODE_SIGNATURE غير صحيح»); };
                دع موضع_توقيع: غير_موقع = اقرأ32(&ب, موضع + 8);
                دع حجم_توقيع: غير_موقع = اقرأ32(&ب, موضع + 12);
                لو ((حجم_توقيع == 0) || (!ضمن(&ب, موضع_توقيع, حجم_توقيع))) {
                    أرجع اختيار.بعض(«بيانات توقيع Mach-O خارج الملف»);
                };
                وجد_توقيع := صواب;
            };

            موضع := موضع + الحجم;
            ف := ف + 1;
        }

        لو (موضع != نهاية_أوامر) { أرجع اختيار.بعض(«امتداد أوامر Mach-O التنفيذي غير مطابق»); };
        لو ((!وجد_نص) || (!وجد_دخول) || (!وجد_توقيع)) {
            أرجع اختيار.بعض(«Mach-O التنفيذي يفتقد __text أو LC_MAIN أو LC_CODE_SIGNATURE»);
        };
        لو (نهاية_أوامر > موضع_نص) { أرجع اختيار.بعض(«أوامر Mach-O تتداخل مع __text»); };
        لو ((موضع_دخول < موضع_نص) || (موضع_دخول >= (موضع_نص + حجم_نص))) {
            أرجع اختيار.بعض(«LC_MAIN خارج __text»);
        };
        لو ((!ضمن(&ب, موضع_دخول, 4)) || (اقرأ32(&ب, موضع_دخول) == 0x1d)) {
            أرجع اختيار.بعض(«نقطة الدخول غير صالحة»);
        };

        أرجع اختيار.لا_شيء();
    };
}

عرف تحقق_تنفيذ_42(المسار: &نص, الاسم: &نص): منطقي {
    دع وسائط: متجه نص = [];
    دع نتيجة: نتيجة_أمر = نفذ_أمرا(المسار, &وسائط, الاسم);
    أرجع نتيجة.الحالة == 42;
}

عرف تحقق_توقيع_ماتشو(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع مصدر: نص = «tests/en/compiler/semantic/return_precedence.sn»;
    دع مصدر_واجهة_أجنبية: نص = «tests/en/runtime/ffi/ffi_abs.sn»;
    دع هدف: نص = «arm64-darwin»;
    دع أ: نص = «build/tests-sultanc/macho-signed-a»;
    دع ب: نص = «build/tests-sultanc/macho-signed-b»;
    دع تنفيذي_واجهة_أجنبية: نص = «build/tests-sultanc/macho-signed-ffi»;
    دع مترجم: نص = مسار_المترجم();
    دع و1: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&أ)];
    دع و2: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&ب)];
    دع و3: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر_واجهة_أجنبية), «-o», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
    دع ن1: نص = «macho-executable-a»;
    دع ن2: نص = «macho-executable-b»;
    دع ن3: نص = «macho-executable-ffi»;
    دع ج1: نتيجة_أمر = نفذ_أمرا(&مترجم, &و1, &ن1);
    دع ج2: نتيجة_أمر = نفذ_أمرا(&مترجم, &و2, &ن2);
    دع ج3: نتيجة_أمر = نفذ_أمرا(&مترجم, &و3, &ن3);
    دع الاسم: نص = «حتمية وتوقيع Mach-O التنفيذي»;

    لو ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (ج3.الحالة != 0)
        || نتيجة_تحوي_فشلا_داخليا(&ج1) || نتيجة_تحوي_فشلا_داخليا(&ج2) || نتيجة_تحوي_فشلا_داخليا(&ج3)) {
        دع سبب: نص = «فشل بناء Mach-O التنفيذي العادي أو FFI»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    لو (!ملفات_متساوية(&أ, &ب)) {
        دع سبب: نص = «مدخل Mach-O المتطابق لم ينتج بايتات متطابقة»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق تحقق_ماتشو_تنفيذي(&أ) مع
    | اختيار.بعض(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختيار.لا_شيء -> { };

    طابق تحقق_ماتشو_تنفيذي(&تنفيذي_واجهة_أجنبية) مع
    | اختيار.بعض(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختيار.لا_شيء -> { };

    دع مضيف_ذراع: متغير منطقي = خطأ;
    طابق الهدف_المضيف() مع
    | اختيار.بعض(المضيف) -> {
        لو (نصان_متساويان(&المضيف, &هدف)) { مضيف_ذراع := صواب; };
    }
    | _ -> { };

    لو (مضيف_ذراع) {
        دع برنامج_توقيع: نص = «/usr/bin/codesign»;
        دع تحقق: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&أ)];
        دع تحقق_واجهة_أجنبية: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
        دع اسم_تحقق: نص = «codesign-normal»;
        دع اسم_تحقق_واجهة_أجنبية: نص = «codesign-ffi»;
        دع ت1: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق, &اسم_تحقق);
        دع ت2: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق_واجهة_أجنبية, &اسم_تحقق_واجهة_أجنبية);
        دع اسم_تشغيل: نص = «macho-run-normal»;
        دع اسم_تشغيل_واجهة_أجنبية: نص = «macho-run-ffi»;
        لو ((ت1.الحالة != 0) || (ت2.الحالة != 0)
            || (!تحقق_تنفيذ_42(&أ, &اسم_تشغيل))
            || (!تحقق_تنفيذ_42(&تنفيذي_واجهة_أجنبية, &اسم_تشغيل_واجهة_أجنبية))) {
            دع سبب: نص = «فشل تحقق codesign أو التنفيذ الأصلي على Darwin ARM64»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
    };

    سجل_نجاح(الملخص, &الاسم);
}

عام عرف اختبر_الكائنات(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع مصدر_خارجي: نص = «tests/en/object/source/external_call.sn»;
    دع بسيط: نص = «tests/en/object/source/simple.sn»;
    دع اكس: نص = «x86_64-linux»;
    دع ذراع: نص = «arm64-darwin»;
    دع ملف_إلف: نص = «build/tests-sultanc/external-x86_64.o»;
    دع ملف_ماتشو: نص = «build/tests-sultanc/external-arm64.o»;
    دع اسم_إلف: نص = «بنية ELF وترحيلاته»;
    دع اسم_ماتشو: نص = «بنية Mach-O وترحيلاته»;
    تحقق_كائن(الملخص, &مصدر_خارجي, &اكس, &ملف_إلف, &اسم_إلف, صواب);
    تحقق_كائن(الملخص, &مصدر_خارجي, &ذراع, &ملف_ماتشو, &اسم_ماتشو, صواب);
    دع ب1: نص = «deterministic-elf»;
    دع ب2: نص = «deterministic-macho»;
    تحقق_حتمية(الملخص, &بسيط, &اكس, &ب1);
    تحقق_حتمية(الملخص, &بسيط, &ذراع, &ب2);
    تحقق_توقيع_ماتشو(الملخص);
}
