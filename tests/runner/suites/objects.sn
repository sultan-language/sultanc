استورد "../common.sn";
استورد std.fs.read_file;
استورد std.text.from_bytes;
استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد std.text.substring;

عرف اقرأ16(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع ((*ب)[م] مثل طبيعي)
        | (((*ب)[م + 1] مثل طبيعي) << 8);
}

عرف اقرأ32(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع اقرأ16(ب, م) | (اقرأ16(ب, م + 2) << 16);
}

عرف اقرأ64(ب: &متجه ط8, م: طبيعي): طبيعي {
    أرجع اقرأ32(ب, م) | (اقرأ32(ب, م + 4) << 32);
}

عرف ضمن(ب: &متجه ط8, م: طبيعي, ن: طبيعي): منطقي {
    ليكن ك: طبيعي = الطول(*ب) مثل طبيعي;
    أرجع (م <= ك) && (ن <= (ك - م));
}

عرف نص_صفري(ب: &متجه ط8, م: طبيعي): اختياري نص {
    ليكن ك: طبيعي = الطول(*ب) مثل طبيعي;
    إذا (م >= ك) { أرجع اختياري.لا_شيء(); };
    ليكن ن: متغير طبيعي = م;
    طالما ((ن < ك) && ((*ب)[ن] != 0)) { ن := ن + 1; };
    إذا (ن >= ك) { أرجع اختياري.لا_شيء(); };
    ليكن جزء: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = م;
    طالما (ف < ن) { ألحق(جزء, (*ب)[ف]); ف := ف + 1; };
    أرجع اختياري.موجود(من_بايتات(&جزء));
}

عرف تحقق_إلف(المسار: &نص, يلزم_ترحيل: منطقي): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة ELF»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 64)) { أرجع اختياري.موجود(«ELF مبتور»); };
        إذا ((ب[0] != 0x7f) || (ب[1] != 0x45) || (ب[2] != 0x4c) || (ب[3] != 0x46)) {
            أرجع اختياري.موجود(«توقيع ELF غير صحيح»);
        };
        إذا ((ب[4] != 2) || (ب[5] != 1)) { أرجع اختياري.موجود(«ELF ليس 64-bit little-endian»); };
        إذا (اقرأ16(&ب, 16) != 1) { أرجع اختياري.موجود(«ELF ليس ET_REL»); };
        إذا (اقرأ16(&ب, 18) != 62) { أرجع اختياري.موجود(«ELF ليس x86_64»); };

        ليكن موضع_رؤوس: طبيعي = اقرأ64(&ب, 40);
        ليكن حجم_رأس: طبيعي = اقرأ16(&ب, 58);
        ليكن عدد_رؤوس: طبيعي = اقرأ16(&ب, 60);
        ليكن فهرس_أسماء: طبيعي = اقرأ16(&ب, 62);
        إذا ((حجم_رأس != 64) || (عدد_رؤوس == 0) || (فهرس_أسماء >= عدد_رؤوس)) {
            أرجع اختياري.موجود(«جدول أقسام ELF غير صالح»);
        };
        إذا (!ضمن(&ب, موضع_رؤوس, حجم_رأس * عدد_رؤوس)) {
            أرجع اختياري.موجود(«جدول أقسام ELF خارج الملف»);
        };

        ليكن رأس_أسماء: طبيعي = موضع_رؤوس + (فهرس_أسماء * حجم_رأس);
        ليكن موضع_أسماء: طبيعي = اقرأ64(&ب, رأس_أسماء + 24);
        ليكن حجم_أسماء: طبيعي = اقرأ64(&ب, رأس_أسماء + 32);
        إذا (!ضمن(&ب, موضع_أسماء, حجم_أسماء)) { أرجع اختياري.موجود(«shstrtab خارج الملف»); };

        ليكن وجد_نص: متغير منطقي = خطأ;
        ليكن وجد_رموز: متغير منطقي = خطأ;
        ليكن وجد_سلاسل: متغير منطقي = خطأ;
        ليكن وجد_ترحيل: متغير منطقي = خطأ;
        ليكن عدد_ترحيل: متغير طبيعي = 0;
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < عدد_رؤوس) {
            ليكن رأس: طبيعي = موضع_رؤوس + (ف * حجم_رأس);
            ليكن إزاحة_اسم: طبيعي = اقرأ32(&ب, رأس);
            ليكن موضع_قسم: طبيعي = اقرأ64(&ب, رأس + 24);
            ليكن حجم_قسم: طبيعي = اقرأ64(&ب, رأس + 32);
            إذا ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) {
                أرجع اختياري.موجود(«قسم ELF خارج الملف»);
            };
            طابق نص_صفري(&ب, موضع_أسماء + إزاحة_اسم) مع
            | اختياري.لا_شيء -> { أرجع اختياري.موجود(«اسم قسم ELF غير منته»); }
            | اختياري.موجود(الاسم) -> {
                ليكن قسم_النص: نص = «.text»;
                ليكن رموز: نص = «.symtab»;
                ليكن سلاسل: نص = «.strtab»;
                ليكن ترحيل: نص = «.rela.text»;
                إذا (نصان_متساويان(&الاسم, &قسم_النص)) { وجد_نص := صواب; };
                إذا (نصان_متساويان(&الاسم, &رموز)) { وجد_رموز := صواب; };
                إذا (نصان_متساويان(&الاسم, &سلاسل)) { وجد_سلاسل := صواب; };
                إذا (نصان_متساويان(&الاسم, &ترحيل)) {
                    وجد_ترحيل := صواب;
                    ليكن حجم_مدخل: طبيعي = اقرأ64(&ب, رأس + 56);
                    إذا ((حجم_مدخل != 24) || ((حجم_قسم % 24) != 0)) {
                        أرجع اختياري.موجود(«جدول ترحيل ELF مشوه»);
                    };
                    عدد_ترحيل := حجم_قسم / 24;
                };
            };
            ف := ف + 1;
        }
        إذا ((!وجد_نص) || (!وجد_رموز) || (!وجد_سلاسل) || (!وجد_ترحيل)) {
            أرجع اختياري.موجود(«ELF يفتقد قسما معياريا»);
        };
        إذا (يلزم_ترحيل && (عدد_ترحيل == 0)) { أرجع اختياري.موجود(«ELF الخارجي بلا ترحيل»); };
        أرجع اختياري.لا_شيء();
    };
}

عرف اسم16(ب: &متجه ط8, م: طبيعي): نص {
    ليكن ن: متغير طبيعي = 0;
    طالما ((ن < 16) && ((*ب)[م + ن] != 0)) { ن := ن + 1; };
    ليكن جزء: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < ن) { ألحق(جزء, (*ب)[م + ف]); ف := ف + 1; };
    أرجع من_بايتات(&جزء);
}

عرف تحقق_ماتشو_كائن(المسار: &نص, يلزم_ترحيل: منطقي): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة Mach-O»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 32)) { أرجع اختياري.موجود(«Mach-O مبتور»); };
        إذا (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختياري.موجود(«توقيع Mach-O غير صحيح»); };
        إذا (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختياري.موجود(«Mach-O ليس ARM64»); };
        إذا (اقرأ32(&ب, 12) != 1) { أرجع اختياري.موجود(«Mach-O ليس MH_OBJECT»); };
        ليكن عدد_أوامر: طبيعي = اقرأ32(&ب, 16);
        ليكن حجم_أوامر: طبيعي = اقرأ32(&ب, 20);
        إذا (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختياري.موجود(«أوامر Mach-O خارج الملف»); };
        ليكن موضع: متغير طبيعي = 32;
        ليكن ف: متغير طبيعي = 0;
        ليكن وجد_نص: متغير منطقي = خطأ;
        ليكن وجد_رموز: متغير منطقي = خطأ;
        ليكن ترحيلات: متغير طبيعي = 0;
        طالما (ف < عدد_أوامر) {
            إذا (!ضمن(&ب, موضع, 8)) { أرجع اختياري.موجود(«أمر Mach-O مبتور»); };
            ليكن الأمر: طبيعي = اقرأ32(&ب, موضع);
            ليكن الحجم: طبيعي = اقرأ32(&ب, موضع + 4);
            إذا ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) { أرجع اختياري.موجود(«حجم أمر Mach-O غير صالح»); };
            إذا (الأمر == 0x19) {
                ليكن عدد_أقسام: طبيعي = اقرأ32(&ب, موضع + 64);
                ليكن قسم: متغير طبيعي = موضع + 72;
                ليكن ق: متغير طبيعي = 0;
                طالما (ق < عدد_أقسام) {
                    إذا ((قسم + 80) > (موضع + الحجم)) { أرجع اختياري.موجود(«جدول أقسام Mach-O مشوه»); };
                    ليكن اسم: نص = اسم16(&ب, قسم);
                    ليكن اسم_نص: نص = «__text»;
                    إذا (نصان_متساويان(&اسم, &اسم_نص)) { وجد_نص := صواب; };
                    ليكن حجم_قسم: طبيعي = اقرأ64(&ب, قسم + 40);
                    ليكن موضع_قسم: طبيعي = اقرأ32(&ب, قسم + 48);
                    ليكن موضع_ترحيل: طبيعي = اقرأ32(&ب, قسم + 56);
                    ليكن عدد_ترحيل: طبيعي = اقرأ32(&ب, قسم + 60);
                    إذا ((حجم_قسم > 0) && (!ضمن(&ب, موضع_قسم, حجم_قسم))) { أرجع اختياري.موجود(«قسم Mach-O خارج الملف»); };
                    إذا ((عدد_ترحيل > 0) && (!ضمن(&ب, موضع_ترحيل, عدد_ترحيل * 8))) { أرجع اختياري.موجود(«ترحيلات Mach-O خارج الملف»); };
                    ترحيلات := ترحيلات + عدد_ترحيل;
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا إذا (الأمر == 2) {
                وجد_رموز := صواب;
                ليكن موضع_رموز: طبيعي = اقرأ32(&ب, موضع + 8);
                ليكن عدد_رموز: طبيعي = اقرأ32(&ب, موضع + 12);
                ليكن موضع_سلاسل: طبيعي = اقرأ32(&ب, موضع + 16);
                ليكن حجم_سلاسل: طبيعي = اقرأ32(&ب, موضع + 20);
                إذا ((!ضمن(&ب, موضع_رموز, عدد_رموز * 16)) || (!ضمن(&ب, موضع_سلاسل, حجم_سلاسل))) {
                    أرجع اختياري.موجود(«جدول رموز Mach-O خارج الملف»);
                };
            };
            موضع := موضع + الحجم;
            ف := ف + 1;
        }
        إذا (موضع != (32 + حجم_أوامر)) { أرجع اختياري.موجود(«امتداد أوامر Mach-O غير مطابق»); };
        إذا ((!وجد_نص) || (!وجد_رموز)) { أرجع اختياري.موجود(«Mach-O يفتقد النص أو الرموز»); };
        إذا (يلزم_ترحيل && (ترحيلات == 0)) { أرجع اختياري.موجود(«Mach-O الخارجي بلا ترحيل»); };
        أرجع اختياري.لا_شيء();
    };
}

// Built without the compilation cache: these checks are about what the
// compiler writes, and the determinism check needs two real compilations.
عرف جمع_كائن_اختبار(المصدر: &نص, الهدف: &نص, الناتج: &نص, الاسم: &نص): نتيجة_أمر {
    ليكن و: متجه نص = [«--no-cache», «-c», «--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    ليكن المترجم: نص = مسار_المترجم();
    أرجع نفذ_أمرا(&المترجم, &و, الاسم);
}

عرف تحقق_كائن(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص,
    يلزم_ترحيل_خارجي: منطقي
): فراغ {
    ليكن جمع: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, الناتج, الاسم);
    إذا ((جمع.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&جمع)) {
        ليكن سبب: نص = «فشل توليد الكائن»;
        سجل_فشل(الملخص, الاسم, &سبب);
        أرجع;
    };
    ليكن اكس: نص = «x86_64-linux»;
    ليكن مشكلة: متغير اختياري نص = اختياري.لا_شيء();
    إذا (نصان_متساويان(الهدف, &اكس)) { مشكلة := تحقق_إلف(الناتج, يلزم_ترحيل_خارجي); } وإلا { مشكلة := تحقق_ماتشو_كائن(الناتج, يلزم_ترحيل_خارجي); };
    طابق مشكلة مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, الاسم, &السبب); }
    | اختياري.لا_شيء -> { سجل_نجاح(الملخص, الاسم); };
}

عرف تحقق_حتمية(
    الملخص: &متغير ملخص_اختبارات,
    المصدر: &نص,
    الهدف: &نص,
    البادئة: &نص
): فراغ {
    ليكن أجزاء1: متجه نص = [«build/tests-sultanc/», استنسخ(البادئة), «-1.o»];
    ليكن أجزاء2: متجه نص = [«build/tests-sultanc/», استنسخ(البادئة), «-2.o»];
    ليكن أ: نص = اجمع_نصوص(&أجزاء1);
    ليكن ب: نص = اجمع_نصوص(&أجزاء2);
    ليكن اسم1_أجزاء: متجه نص = [استنسخ(البادئة), «-first»];
    ليكن اسم2_أجزاء: متجه نص = [استنسخ(البادئة), «-second»];
    ليكن اسم1: نص = اجمع_نصوص(&اسم1_أجزاء);
    ليكن اسم2: نص = اجمع_نصوص(&اسم2_أجزاء);
    ليكن ج1: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &أ, &اسم1);
    ليكن ج2: نتيجة_أمر = جمع_كائن_اختبار(المصدر, الهدف, &ب, &اسم2);
    ليكن اسم_اختبار_أجزاء: متجه نص = [«حتمية الكائن », استنسخ(الهدف)];
    ليكن اسم_اختبار: نص = اجمع_نصوص(&اسم_اختبار_أجزاء);
    إذا ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (!ملفات_متساوية(&أ, &ب))) {
        ليكن سبب: نص = «إعادة الإصدار لم تنتج بايتات متطابقة»;
        سجل_فشل(الملخص, &اسم_اختبار, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, &اسم_اختبار);
    };
}

عرف تحقق_ماتشو_تنفيذي(المسار: &نص): اختياري نص {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.موجود(«تعذر قراءة Mach-O التنفيذي»); }
    | نتيجة.نجح(ب) -> {
        إذا (!ضمن(&ب, 0, 32)) { أرجع اختياري.موجود(«Mach-O التنفيذي مبتور»); };
        إذا (اقرأ32(&ب, 0) != 0xfeedfacf) { أرجع اختياري.موجود(«توقيع Mach-O التنفيذي غير صحيح»); };
        إذا (اقرأ32(&ب, 4) != 0x0100000c) { أرجع اختياري.موجود(«Mach-O التنفيذي ليس ARM64»); };

        ليكن عدد_أوامر: طبيعي = اقرأ32(&ب, 16);
        ليكن حجم_أوامر: طبيعي = اقرأ32(&ب, 20);
        إذا (!ضمن(&ب, 32, حجم_أوامر)) { أرجع اختياري.موجود(«أوامر Mach-O التنفيذية خارج الملف»); };

        ليكن نهاية_أوامر: طبيعي = 32 + حجم_أوامر;
        ليكن موضع: متغير طبيعي = 32;
        ليكن ف: متغير طبيعي = 0;
        ليكن وجد_نص: متغير منطقي = خطأ;
        ليكن وجد_دخول: متغير منطقي = خطأ;
        ليكن وجد_توقيع: متغير منطقي = خطأ;
        ليكن موضع_نص: متغير طبيعي = 0;
        ليكن حجم_نص: متغير طبيعي = 0;
        ليكن موضع_دخول: متغير طبيعي = 0;

        طالما (ف < عدد_أوامر) {
            إذا (!ضمن(&ب, موضع, 8)) { أرجع اختياري.موجود(«أمر Mach-O تنفيذي مبتور»); };
            ليكن الأمر: طبيعي = اقرأ32(&ب, موضع);
            ليكن الحجم: طبيعي = اقرأ32(&ب, موضع + 4);
            إذا ((الحجم < 8) || (!ضمن(&ب, موضع, الحجم))) {
                أرجع اختياري.موجود(«حجم أمر Mach-O تنفيذي غير صالح»);
            };

            إذا (الأمر == 0x19) {
                إذا (الحجم < 72) { أرجع اختياري.موجود(«LC_SEGMENT_64 مبتور»); };
                ليكن عدد_أقسام: طبيعي = اقرأ32(&ب, موضع + 64);
                ليكن قسم: متغير طبيعي = موضع + 72;
                ليكن ق: متغير طبيعي = 0;
                طالما (ق < عدد_أقسام) {
                    إذا ((قسم + 80) > (موضع + الحجم)) {
                        أرجع اختياري.موجود(«أقسام Mach-O التنفيذية مشوهة»);
                    };
                    ليكن اسم_قسم: نص = اسم16(&ب, قسم);
                    ليكن اسم_قطاع: نص = اسم16(&ب, قسم + 16);
                    ليكن نص_اسم: نص = «__text»;
                    ليكن قطاع_نص: نص = «__TEXT»;
                    إذا (نصان_متساويان(&اسم_قسم, &نص_اسم) && نصان_متساويان(&اسم_قطاع, &قطاع_نص)) {
                        وجد_نص := صواب;
                        حجم_نص := اقرأ64(&ب, قسم + 40);
                        موضع_نص := اقرأ32(&ب, قسم + 48);
                        إذا (!ضمن(&ب, موضع_نص, حجم_نص)) {
                            أرجع اختياري.موجود(«قسم __text خارج الملف»);
                        };
                    };
                    قسم := قسم + 80;
                    ق := ق + 1;
                }
            } وإلا إذا (الأمر == 0x80000028) {
                إذا (الحجم < 24) { أرجع اختياري.موجود(«LC_MAIN مبتور»); };
                وجد_دخول := صواب;
                موضع_دخول := اقرأ64(&ب, موضع + 8);
            } وإلا إذا (الأمر == 0x1d) {
                إذا (الحجم != 16) { أرجع اختياري.موجود(«حجم LC_CODE_SIGNATURE غير صحيح»); };
                ليكن موضع_توقيع: طبيعي = اقرأ32(&ب, موضع + 8);
                ليكن حجم_توقيع: طبيعي = اقرأ32(&ب, موضع + 12);
                إذا ((حجم_توقيع == 0) || (!ضمن(&ب, موضع_توقيع, حجم_توقيع))) {
                    أرجع اختياري.موجود(«بيانات توقيع Mach-O خارج الملف»);
                };
                وجد_توقيع := صواب;
            };

            موضع := موضع + الحجم;
            ف := ف + 1;
        }

        إذا (موضع != نهاية_أوامر) { أرجع اختياري.موجود(«امتداد أوامر Mach-O التنفيذي غير مطابق»); };
        إذا ((!وجد_نص) || (!وجد_دخول) || (!وجد_توقيع)) {
            أرجع اختياري.موجود(«Mach-O التنفيذي يفتقد __text أو LC_MAIN أو LC_CODE_SIGNATURE»);
        };
        إذا (نهاية_أوامر > موضع_نص) { أرجع اختياري.موجود(«أوامر Mach-O تتداخل مع __text»); };
        إذا ((موضع_دخول < موضع_نص) || (موضع_دخول >= (موضع_نص + حجم_نص))) {
            أرجع اختياري.موجود(«LC_MAIN خارج __text»);
        };
        إذا ((!ضمن(&ب, موضع_دخول, 4)) || (اقرأ32(&ب, موضع_دخول) == 0x1d)) {
            أرجع اختياري.موجود(«نقطة الدخول غير صالحة»);
        };

        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_تنفيذ_42(المسار: &نص, الاسم: &نص): منطقي {
    ليكن وسائط: متجه نص = [];
    ليكن نتيجة: نتيجة_أمر = نفذ_أمرا(المسار, &وسائط, الاسم);
    أرجع نتيجة.الحالة == 42;
}

// An x86_64-linux executable exits with 42 where the host can run it; on any
// other host (macOS, aarch64 Linux) its build and contents are what is checked.
عرف تحقق_تنفيذ_42_لينكس(المسار: &نص, الاسم: &نص): منطقي {
    ليكن لينكس: نص = «x86_64-linux»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) { أرجع صواب; };
    }
    | اختياري.لا_شيء -> { أرجع صواب; };
    أرجع تحقق_تنفيذ_42(المسار, الاسم);
}

عرف تحقق_توقيع_ماتشو(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مصدر: نص = «tests/en/compiler/semantic/return_precedence.sn»;
    ليكن مصدر_واجهة_أجنبية: نص = «tests/en/runtime/ffi/ffi_abs.sn»;
    ليكن هدف: نص = «arm64-darwin»;
    ليكن أ: نص = «build/tests-sultanc/macho-signed-a»;
    ليكن ب: نص = «build/tests-sultanc/macho-signed-b»;
    ليكن تنفيذي_واجهة_أجنبية: نص = «build/tests-sultanc/macho-signed-ffi»;
    ليكن مترجم: نص = مسار_المترجم();
    ليكن و1: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&أ)];
    ليكن و2: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر), «-o», انسخ_نص_اختبار(&ب)];
    ليكن و3: متجه نص = [«--target», انسخ_نص_اختبار(&هدف), انسخ_نص_اختبار(&مصدر_واجهة_أجنبية), «-o», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
    ليكن ن1: نص = «macho-executable-a»;
    ليكن ن2: نص = «macho-executable-b»;
    ليكن ن3: نص = «macho-executable-ffi»;
    ليكن ج1: نتيجة_أمر = نفذ_أمرا(&مترجم, &و1, &ن1);
    ليكن ج2: نتيجة_أمر = نفذ_أمرا(&مترجم, &و2, &ن2);
    ليكن ج3: نتيجة_أمر = نفذ_أمرا(&مترجم, &و3, &ن3);
    ليكن الاسم: نص = «حتمية وتوقيع Mach-O التنفيذي»;

    إذا ((ج1.الحالة != 0) || (ج2.الحالة != 0) || (ج3.الحالة != 0)
        || نتيجة_تحوي_فشلا_داخليا(&ج1) || نتيجة_تحوي_فشلا_داخليا(&ج2) || نتيجة_تحوي_فشلا_داخليا(&ج3)) {
        ليكن سبب: نص = «فشل بناء Mach-O التنفيذي العادي أو FFI»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    إذا (!ملفات_متساوية(&أ, &ب)) {
        ليكن سبب: نص = «مدخل Mach-O المتطابق لم ينتج بايتات متطابقة»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق تحقق_ماتشو_تنفيذي(&أ) مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختياري.لا_شيء -> { };

    طابق تحقق_ماتشو_تنفيذي(&تنفيذي_واجهة_أجنبية) مع
    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); أرجع; }
    | اختياري.لا_شيء -> { };

    ليكن مضيف_ذراع: متغير منطقي = خطأ;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        إذا (نصان_متساويان(&المضيف, &هدف)) { مضيف_ذراع := صواب; };
    }
    | _ -> { };

    إذا (مضيف_ذراع) {
        ليكن برنامج_توقيع: نص = «/usr/bin/codesign»;
        ليكن تحقق: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&أ)];
        ليكن تحقق_واجهة_أجنبية: متجه نص = [«--verify», «--strict», انسخ_نص_اختبار(&تنفيذي_واجهة_أجنبية)];
        ليكن اسم_تحقق: نص = «codesign-normal»;
        ليكن اسم_تحقق_واجهة_أجنبية: نص = «codesign-ffi»;
        ليكن ت1: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق, &اسم_تحقق);
        ليكن ت2: نتيجة_أمر = نفذ_أمرا(&برنامج_توقيع, &تحقق_واجهة_أجنبية, &اسم_تحقق_واجهة_أجنبية);
        ليكن اسم_تشغيل: نص = «macho-run-normal»;
        ليكن اسم_تشغيل_واجهة_أجنبية: نص = «macho-run-ffi»;
        إذا ((ت1.الحالة != 0) || (ت2.الحالة != 0)
            || (!تحقق_تنفيذ_42(&أ, &اسم_تشغيل))
            || (!تحقق_تنفيذ_42(&تنفيذي_واجهة_أجنبية, &اسم_تشغيل_واجهة_أجنبية))) {
            ليكن سبب: نص = «فشل تحقق codesign أو التنفيذ الأصلي على Darwin ARM64»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
    };

    سجل_نجاح(الملخص, &الاسم);
}

// Link inputs (compiler/link/input_ingest.sn): an SDK's text-based dylib
// stub (.tbd) is a dylib to a Mach-O link, its install name loaded and its
// exports bound to it; on another target, or when the file is no object,
// archive or library at all, the link names the file in a user diagnostic,
// never an internal error (previously SULTANC-ICE-CONTEXT
// link.macho.invalid-object for `-l c` with an SDK's libc.tbd).
عرف بايتات_تحتوي(البايتات: &متجه ط8, النص: &نص): منطقي {
    ليكن الطول_المطلوب: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الطول_المطلوب > العدد) { أرجع خطأ; };
    ليكن م: متغير طبيعي = 0;
    طالما (م + الطول_المطلوب <= العدد) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < الطول_المطلوب && (*البايتات)[م + ك] == (*النص)[ك]) { ك := ك + 1; }
        إذا (ك == الطول_المطلوب) { أرجع صواب; };
        م := م + 1;
    }
    أرجع خطأ;
}

عرف تحقق_مدخل_ربط_مرفوض(
    الملخص: &متغير ملخص_اختبارات,
    الاسم: نص,
    الوسائط: متجه نص,
    المسار: نص
): فراغ {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&مترجم, &الوسائط, &الاسم);
    ليكن الكود: نص = «SULTANC-LINK-INPUT-UNSUPPORTED»;
    إذا (النتيجة.الحالة != 3
        || !يحتوي_نصا(&النتيجة.الخطأ, &الكود)
        || !يحتوي_نصا(&النتيجة.الخطأ, &المسار)
        || نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
        ليكن سبب: نص = «مدخل ربط غير قابل للربط لم يبلغ بتشخيص للمستخدم يسمي الملف»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, &الاسم);
    };
}

عرف تحقق_مدخلات_الربط(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مترجم: نص = مسار_المترجم();
    // -l c with an SDK's libc.tbd on the -L path: libSystem, already linked.
    ليكن اسم_سي: نص = «-l c مع libc.tbd لـ arm64-darwin»;
    ليكن و_سي: متجه نص = [
        «tests/en/compiler/c_import_units/main.sn», «--target», «arm64-darwin»,
        «-o», «build/tests-sultanc/tbd-libc-darwin», «-L», «tests/runner/fixtures/darwin_libc», «-l», «c»
    ];
    ليكن نتيجة_سي: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_سي, &اسم_سي);
    إذا (نتيجة_سي.الحالة == 0) {
        سجل_نجاح(الملخص, &اسم_سي);
    } وإلا {
        ليكن سبب: نص = «ربط arm64-darwin مع -l c وlibc.tbd فشل»;
        سجل_فشل(الملخص, &اسم_سي, &سبب);
    };
    // abs from a stub's re-exported document binds to the stub's dylib.
    ليكن اسم_مكتبة: نص = «ربط رمز من مكتبة .tbd لـ arm64-darwin»;
    ليكن ناتج_مكتبة: نص = «build/tests-sultanc/tbd-fake-darwin»;
    ليكن و_مكتبة: متجه نص = [
        «tests/en/runtime/ffi/ffi_abs.sn», «--target», «arm64-darwin», «-o», انسخ_نص_اختبار(&ناتج_مكتبة),
        «-L», «tests/runner/fixtures/link_inputs», «-l», «fake»
    ];
    ليكن نتيجة_مكتبة: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_مكتبة, &اسم_مكتبة);
    ليكن اسم_التثبيت: نص = «/usr/lib/libfake.dylib»;
    ليكن الصورة: متغير متجه ط8 = [];
    إذا (نتيجة_مكتبة.الحالة == 0) {
        طابق اقرأ_بايتات_ملف(&ناتج_مكتبة) مع
        | نتيجة.نجح(البايتات) -> { الصورة := البايتات; }
        | نتيجة.خطأ(_) -> { };
    };
    إذا (بايتات_تحتوي(&الصورة, &اسم_التثبيت)) {
        سجل_نجاح(الملخص, &اسم_مكتبة);
    } وإلا {
        ليكن سبب: نص = «الصورة لا تحمل LC_LOAD_DYLIB لاسم تثبيت المكتبة النصية»;
        سجل_فشل(الملخص, &اسم_مكتبة, &سبب);
    };
    // Archives with nothing to link (only `!<arch>\n`; members that are not
    // objects, no symbol index), named with -l: they contribute nothing, as
    // with GNU ld, never an internal error. In both languages.
    ليكن مصادر_الأرشيف: متجه نص = [«tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»];
    ليكن مكتبات_الأرشيف: متجه نص = [«empty», «noobjects»];
    ليكن لغات_الأرشيف: متجه نص = [«en», «ar»];
    ليكن م_أ: متغير طبيعي = 0;
    طالما (م_أ < 2) {
        ليكن ك_أ: متغير طبيعي = 0;
        طالما (ك_أ < 2) {
            ليكن أجزاء_الاسم: متجه نص = [«أرشيف بلا كائنات -l », انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ]), « (», انسخ_نص_اختبار(&مصادر_الأرشيف[م_أ]), «)»];
            ليكن اسم_الأرشيف: نص = اجمع_نصوص(&أجزاء_الاسم);
            ليكن أجزاء_الناتج: متجه نص = [«build/tests-sultanc/archive-», انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ]), «-», انسخ_نص_اختبار(&لغات_الأرشيف[م_أ])];
            ليكن ناتج_الأرشيف: نص = اجمع_نصوص(&أجزاء_الناتج);
            ليكن و_أرشيف: متجه نص = [
                انسخ_نص_اختبار(&مصادر_الأرشيف[م_أ]), «--target», «x86_64-linux», «-o», انسخ_نص_اختبار(&ناتج_الأرشيف),
                «-L», «tests/runner/fixtures/link_inputs», «-l», انسخ_نص_اختبار(&مكتبات_الأرشيف[ك_أ])
            ];
            ليكن نتيجة_الأرشيف: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_أرشيف, &اسم_الأرشيف);
            إذا (نتيجة_الأرشيف.الحالة != 0 || نتيجة_تحوي_فشلا_داخليا(&نتيجة_الأرشيف)) {
                ليكن أصل_السبب: نص = «ربط برنامج مع أرشيف لا كائنات فيه فشل»;
                ليكن سبب: نص = سبب_مع_خرج(&أصل_السبب, &نتيجة_الأرشيف);
                سجل_فشل(الملخص, &اسم_الأرشيف, &سبب);
            } وإلا إذا (!تحقق_تنفيذ_42_لينكس(&ناتج_الأرشيف, &اسم_الأرشيف)) {
                ليكن سبب: نص = «البرنامج المربوط مع أرشيف لا كائنات فيه لم يخرج بالحالة 42»;
                سجل_فشل(الملخص, &اسم_الأرشيف, &سبب);
            } وإلا {
                سجل_نجاح(الملخص, &اسم_الأرشيف);
            };
            ك_أ := ك_أ + 1;
        }
        م_أ := م_أ + 1;
    }
    // Linked ELF executables carry .symtab and .strtab with the objects'
    // function symbols (elf/symbol_output.sn), for both backends and in
    // both languages: debuggers and unwinders find a frame's function by
    // them.
    ليكن مصادر_الرموز: متجه نص = [«tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»];
    ليكن خلفيات_الرموز: متجه نص = [«--backend=native», «--backend=llvm»];
    ليكن م_ر: متغير طبيعي = 0;
    طالما (م_ر < 2) {
        ليكن ك_ر: متغير طبيعي = 0;
        طالما (ك_ر < 2) {
            ليكن أجزاء_الاسم: متجه نص = [«جدول رموز ELF التنفيذي », انسخ_نص_اختبار(&خلفيات_الرموز[ك_ر]), « (», انسخ_نص_اختبار(&مصادر_الرموز[م_ر]), «)»];
            ليكن اسم_الرموز: نص = اجمع_نصوص(&أجزاء_الاسم);
            ليكن أجزاء_الناتج: متجه نص = [«build/tests-sultanc/symtab-», انسخ_نص_اختبار(&لغات_الأرشيف[م_ر]), «-», انسخ_نص_اختبار(&لغات_الأرشيف[ك_ر])];
            ليكن ناتج_الرموز: نص = اجمع_نصوص(&أجزاء_الناتج);
            ليكن و_رموز: متجه نص = [
                انسخ_نص_اختبار(&مصادر_الرموز[م_ر]), انسخ_نص_اختبار(&خلفيات_الرموز[ك_ر]), «--target», «x86_64-linux»,
                «-o», انسخ_نص_اختبار(&ناتج_الرموز)
            ];
            // --backend=llvm needs a compiler built with LLVM (--enable-llvm).
            إذا ((ك_ر == 1) && !المترجم_بإل_إل_في_إم()) {
                ليكن سبب_التجاوز: نص = «يحتاج مترجما بخلفية LLVM (--enable-llvm)»;
                سجل_تجاوز(الملخص, &اسم_الرموز, &سبب_التجاوز);
            } وإلا {
                ليكن نتيجة_الرموز: نتيجة_أمر = نفذ_أمرا(&مترجم, &و_رموز, &اسم_الرموز);
                ليكن صورة_الرموز: متغير متجه ط8 = [];
                إذا (نتيجة_الرموز.الحالة == 0) {
                    طابق اقرأ_بايتات_ملف(&ناتج_الرموز) مع
                    | نتيجة.نجح(البايتات) -> { صورة_الرموز := البايتات; }
                    | نتيجة.خطأ(_) -> { };
                };
                ليكن اسم_الجدول: نص = «.symtab»;
                ليكن اسم_الدالة: نص = «is_even»;
                إذا (بايتات_تحتوي(&صورة_الرموز, &اسم_الجدول) && بايتات_تحتوي(&صورة_الرموز, &اسم_الدالة)
                    && تحقق_تنفيذ_42_لينكس(&ناتج_الرموز, &اسم_الرموز)) {
                    سجل_نجاح(الملخص, &اسم_الرموز);
                } وإلا {
                    ليكن سبب: نص = «الملف التنفيذي بلا .symtab تسمي دوال الكائنات، أو لم يخرج بالحالة 42»;
                    سجل_فشل(الملخص, &اسم_الرموز, &سبب);
                };
            };
            ك_ر := ك_ر + 1;
        }
        م_ر := م_ر + 1;
    }
    // A .tbd outside a Mach-O link, and a file in no linkable format.
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «مكتبة .tbd في ربط x86_64-linux»,
        [«examples/en/basics/arithmetic.sn», «--target», «x86_64-linux», «-o», «build/tests-sultanc/tbd-linux»,
         «tests/runner/fixtures/darwin_libc/libc.tbd»],
        «tests/runner/fixtures/darwin_libc/libc.tbd»
    );
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «ملف مجهول الصيغة في ربط x86_64-linux»,
        [«examples/en/basics/arithmetic.sn», «--target», «x86_64-linux», «-o», «build/tests-sultanc/garbage-linux»,
         «tests/runner/fixtures/link_inputs/garbage.bin»],
        «tests/runner/fixtures/link_inputs/garbage.bin»
    );
    تحقق_مدخل_ربط_مرفوض(
        الملخص, «ملف مجهول الصيغة في ربط arm64-darwin»,
        [«examples/en/basics/arithmetic.sn», «--target», «arm64-darwin», «-o», «build/tests-sultanc/garbage-darwin»,
         «tests/runner/fixtures/link_inputs/garbage.bin»],
        «tests/runner/fixtures/link_inputs/garbage.bin»
    );
}

// Whether البايتات hold النمط as consecutive bytes.
عرف بايتات_تحوي_نمطا(البايتات: &متجه ط8, النمط: &متجه ط8): منطقي {
    ليكن الطول_المطلوب: طبيعي = الطول(*النمط) مثل طبيعي;
    ليكن العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الطول_المطلوب == 0 || الطول_المطلوب > العدد) { أرجع خطأ; };
    ليكن م: متغير طبيعي = 0;
    طالما (م + الطول_المطلوب <= العدد) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < الطول_المطلوب && (*البايتات)[م + ك] == (*النمط)[ك]) { ك := ك + 1; }
        إذا (ك == الطول_المطلوب) { أرجع صواب; };
        م := م + 1;
    }
    أرجع خطأ;
}

// Stack probes: a function whose frame spans pages touches the stack page
// by page in its prologue on every target with guard pages, Linux and macOS
// as Windows, so a stack overflow faults in the guard instead of stepping
// over it (backend/architectures/x86_64/encoder.sn ألحق_مسبار_مكدس_سيستم_في_إكس,
// backend/architectures/arm64/encoder.sn ألحق_طرح_مكدس_بمسبار_ذراع, and
// LLVM's "probe-stack"="inline-asm" in backend/provider/llvm/optimization.sn).
// The object of tests/{en,ar}/object/source/large_frame.sn (a 16 KiB local)
// holds the probe's bytes:
//   native x86-64: sub rsp,4096; test [rsp],rsp; dec r10; jnz; mov rsp,r11
//   native AArch64: sub sp,sp,#4080; str xzr,[sp]
//   LLVM x86-64: sub rsp,4096; mov qword [rsp],0
//   LLVM AArch64: sub sp,sp,#1,lsl #12 and str xzr,[sp]
عرف تحقق_مسابر_المكدس(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن المصادر: متجه نص = [«tests/en/object/source/large_frame.sn», «tests/ar/object/source/large_frame.sn»];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن الأهداف: متجه نص = [
        «x86_64-linux», «x86_64-darwin», «arm64-darwin», «aarch64-linux-gnu», «x86_64-linux», «aarch64-linux-gnu»
    ];
    ليكن الخلفيات: متجه نص = [
        «--backend=native», «--backend=native», «--backend=native», «--backend=native», «--backend=llvm», «--backend=llvm»
    ];
    ليكن مسبار_إكس: متجه ط8 = [
        0x48, 0x81, 0xEC, 0x00, 0x10, 0x00, 0x00, 0x48, 0x85, 0x24, 0x24,
        0x49, 0xFF, 0xCA, 0x75, 0xF0, 0x4C, 0x89, 0xDC
    ];
    ليكن مسبار_ذراع: متجه ط8 = [0xFF, 0xC3, 0x3F, 0xD1, 0xFF, 0x03, 0x00, 0xF9];
    ليكن مسبار_إكس_إل_إل_في_إم: متجه ط8 = [
        0x48, 0x81, 0xEC, 0x00, 0x10, 0x00, 0x00, 0x48, 0xC7, 0x04, 0x24, 0x00, 0x00, 0x00, 0x00
    ];
    ليكن طرح_صفحة_ذراع: متجه ط8 = [0xFF, 0x07, 0x40, 0xD1];
    ليكن تخزين_صفر_ذراع: متجه ط8 = [0xFF, 0x03, 0x00, 0xF9];
    ليكن م: متغير طبيعي = 0;
    طالما (م < 2) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(الأهداف) مثل طبيعي)) {
            ليكن أجزاء_الاسم: متجه نص = [
                «مسابر مكدس الإطار الكبير », انسخ_نص_اختبار(&الخلفيات[ك]), « »,
                انسخ_نص_اختبار(&الأهداف[ك]), « (», انسخ_نص_اختبار(&اللغات[م]), «)»
            ];
            ليكن الاسم: نص = اجمع_نصوص(&أجزاء_الاسم);
            ليكن أجزاء_الناتج: متجه نص = [
                «build/tests-sultanc/stack-probe-», انسخ_نص_اختبار(&الأهداف[ك]), «-»,
                طبيعي_إلى_نص(ك), «-», انسخ_نص_اختبار(&اللغات[م]), «.o»
            ];
            ليكن الناتج: نص = اجمع_نصوص(&أجزاء_الناتج);
            إذا (ك >= 4 && !المترجم_بإل_إل_في_إم()) {
                ليكن سبب_التجاوز: نص = «يحتاج مترجما بخلفية LLVM (--enable-llvm)»;
                سجل_تجاوز(الملخص, &الاسم, &سبب_التجاوز);
            } وإلا {
                ليكن الوسائط: متجه نص = [
                    «-c», «-O0», انسخ_نص_اختبار(&الخلفيات[ك]), «--target», انسخ_نص_اختبار(&الأهداف[ك]),
                    انسخ_نص_اختبار(&المصادر[م]), «-o», انسخ_نص_اختبار(&الناتج)
                ];
                ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&مترجم, &الوسائط, &الاسم);
                ليكن الصورة: متغير متجه ط8 = [];
                إذا (النتيجة.الحالة == 0 && !نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
                    طابق اقرأ_بايتات_ملف(&الناتج) مع
                    | نتيجة.نجح(البايتات) -> { الصورة := البايتات; }
                    | نتيجة.خطأ(_) -> { };
                };
                ليكن وجد: متغير منطقي = خطأ;
                إذا (ك == 0 || ك == 1) { وجد := بايتات_تحوي_نمطا(&الصورة, &مسبار_إكس); };
                إذا (ك == 2 || ك == 3) { وجد := بايتات_تحوي_نمطا(&الصورة, &مسبار_ذراع); };
                إذا (ك == 4) { وجد := بايتات_تحوي_نمطا(&الصورة, &مسبار_إكس_إل_إل_في_إم); };
                إذا (ك == 5) {
                    وجد := بايتات_تحوي_نمطا(&الصورة, &طرح_صفحة_ذراع) && بايتات_تحوي_نمطا(&الصورة, &تخزين_صفر_ذراع);
                };
                إذا (وجد) {
                    سجل_نجاح(الملخص, &الاسم);
                } وإلا {
                    ليكن سبب: نص = «كائن الدالة ذات الإطار الكبير بلا مسبار مكدس في مقدمتها»;
                    سجل_فشل(الملخص, &الاسم, &سبب);
                };
            };
            ك := ك + 1;
        }
        م := م + 1;
    }
}

// Whether البايتات hold النمط under the masks القناع somewhere: at each
// position, (byte & mask) is the pattern's byte.
عرف بايتات_تحوي_نمطا_بقناع(البايتات: &متجه ط8, النمط: &متجه ط8, القناع: &متجه ط8): منطقي {
    ليكن الطول_المطلوب: طبيعي = الطول(*النمط) مثل طبيعي;
    ليكن العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (الطول_المطلوب == 0 || الطول_المطلوب > العدد) { أرجع خطأ; };
    ليكن م: متغير طبيعي = 0;
    طالما (م + الطول_المطلوب <= العدد) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < الطول_المطلوب && ((*البايتات)[م + ك] & (*القناع)[ك]) == (*النمط)[ك]) { ك := ك + 1; }
        إذا (ك == الطول_المطلوب) { أرجع صواب; };
        م := م + 1;
    }
    أرجع خطأ;
}

// Whether some 4-aligned little-endian word w has (w & ق1) == ن1 and one of
// the المدى words after it (w2 & ق2) == ن2.
عرف كلمات_ذراع_تتلو(ب: &متجه ط8, ق1: طبيعي, ن1: طبيعي, ق2: طبيعي, ن2: طبيعي, المدى: طبيعي): منطقي {
    ليكن العدد: طبيعي = الطول(*ب) مثل طبيعي;
    ليكن م: متغير طبيعي = 0;
    طالما (م + 8 <= العدد) {
        إذا ((اقرأ32(ب, م) & ق1) == ن1) {
            ليكن ف: متغير طبيعي = 1;
            طالما (ف <= المدى && م + (4 * ف) + 4 <= العدد) {
                إذا ((اقرأ32(ب, م + (4 * ف)) & ق2) == ن2) { أرجع صواب; };
                ف := ف + 1;
            }
        };
        م := م + 4;
    }
    أرجع خطأ;
}

// Whether some 4-aligned little-endian word w has (w & القناع) == النمط.
عرف كلمة_ذراع_موجودة(ب: &متجه ط8, القناع: طبيعي, النمط: طبيعي): منطقي {
    ليكن العدد: طبيعي = الطول(*ب) مثل طبيعي;
    ليكن م: متغير طبيعي = 0;
    طالما (م + 4 <= العدد) {
        إذا ((اقرأ32(ب, م) & القناع) == النمط) { أرجع صواب; };
        م := م + 4;
    }
    أرجع خطأ;
}

// The x86-64 patterns: the first one missing.
عرف أنماط_إكس_المفقودة(الصورة: &متجه ط8): اختياري نص {
    // ADD r64, r64; JO rel32 (REX.W 01 /r, 0F 80).
    ليكن جمع: متجه ط8 = [0x48, 0x01, 0xC0, 0x0F, 0x80];
    ليكن قناع_جمع: متجه ط8 = [0xFA, 0xFF, 0xC0, 0xFF, 0xFF];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &جمع, &قناع_جمع)) { أرجع اختياري.موجود(«جمع مفحوص بلا ADD r64, r64 يتلوه JO»); };
    // SUB r64, 1; JO rel32 (REX.W 83 /5 01, 0F 80).
    ليكن طرح: متجه ط8 = [0x48, 0x83, 0xE8, 0x01, 0x0F, 0x80];
    ليكن قناع_طرح: متجه ط8 = [0xFA, 0xFF, 0xF8, 0xFF, 0xFF, 0xFF];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &طرح, &قناع_طرح)) { أرجع اختياري.موجود(«طرح 1 مفحوص بلا SUB r64, 1 يتلوه JO»); };
    // IMUL r64, r64; JO rel32 (REX.W 0F AF /r, 0F 80).
    ليكن ضرب: متجه ط8 = [0x48, 0x0F, 0xAF, 0xC0, 0x0F, 0x80];
    ليكن قناع_ضرب: متجه ط8 = [0xFA, 0xFF, 0xFF, 0xC0, 0xFF, 0xFF];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &ضرب, &قناع_ضرب)) { أرجع اختياري.موجود(«ضرب مفحوص بلا IMUL r64, r64 يتلوه JO»); };
    // LEA r64, [r + r*2] (a wrapping multiply by 3), with or without a
    // displacement byte.
    ليكن ليا: متجه ط8 = [0x48, 0x8D, 0x04, 0x40];
    ليكن قناع_ليا: متجه ط8 = [0xFA, 0xFF, 0xC7, 0xC0];
    ليكن ليا_إزاحة: متجه ط8 = [0x48, 0x8D, 0x44, 0x40];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &ليا, &قناع_ليا) && !بايتات_تحوي_نمطا_بقناع(الصورة, &ليا_إزاحة, &قناع_ليا)) {
        أرجع اختياري.موجود(«ضرب ملتف في 3 بلا LEA»);
    };
    // AND r64, 1 then JE or JNE (x % 2 == 0), near or short.
    ليكن زوجي: متجه ط8 = [0x48, 0x83, 0xE0, 0x01, 0x0F, 0x84];
    ليكن قناع_زوجي: متجه ط8 = [0xFA, 0xFF, 0xF8, 0xFF, 0xFF, 0xFE];
    ليكن زوجي_قصير: متجه ط8 = [0x48, 0x83, 0xE0, 0x01, 0x74];
    ليكن قناع_زوجي_قصير: متجه ط8 = [0xFA, 0xFF, 0xF8, 0xFF, 0xFE];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &زوجي, &قناع_زوجي) && !بايتات_تحوي_نمطا_بقناع(الصورة, &زوجي_قصير, &قناع_زوجي_قصير)) {
        أرجع اختياري.موجود(«x % 2 == 0 بلا AND 1 يتلوه JE أو JNE»);
    };
    // ADD r64, r64; JB rel32: an unsigned add's carry.
    ليكن جمع_طبيعي: متجه ط8 = [0x48, 0x01, 0xC0, 0x0F, 0x82];
    إذا (!بايتات_تحوي_نمطا_بقناع(الصورة, &جمع_طبيعي, &قناع_جمع)) { أرجع اختياري.موجود(«جمع طبيعي مفحوص بلا ADD يتلوه JB»); };
    أرجع اختياري.لا_شيء();
}

// The AArch64 patterns: the first one missing.
عرف أنماط_ذراع_المفقودة(الصورة: &متجه ط8): اختياري نص {
    // ADDS Xd, Xn, Xm; B.VS.
    إذا (!كلمات_ذراع_تتلو(الصورة, 0xFFE0FC00, 0xAB000000, 0xFF00001F, 0x54000006, 1)) {
        أرجع اختياري.موجود(«جمع مفحوص بلا ADDS يتلوه B.VS»);
    };
    // ADDS; B.CS: an unsigned add's carry.
    إذا (!كلمات_ذراع_تتلو(الصورة, 0xFFE0FC00, 0xAB000000, 0xFF00001F, 0x54000002, 1)) {
        أرجع اختياري.موجود(«جمع طبيعي مفحوص بلا ADDS يتلوه B.CS»);
    };
    // SUBS (register or immediate); B.VS.
    إذا (!كلمات_ذراع_تتلو(الصورة, 0xFFE0FC00, 0xEB000000, 0xFF00001F, 0x54000006, 1)
        && !كلمات_ذراع_تتلو(الصورة, 0xFFC00000, 0xF1000000, 0xFF00001F, 0x54000006, 1)) {
        أرجع اختياري.موجود(«طرح مفحوص بلا SUBS يتلوه B.VS»);
    };
    // SMULH, then B.NE to the report within four words.
    إذا (!كلمات_ذراع_تتلو(الصورة, 0xFFE0FC00, 0x9B407C00, 0xFF00001F, 0x54000001, 4)) {
        أرجع اختياري.موجود(«ضرب مفحوص بلا SMULH يتلوه B.NE»);
    };
    // CMP Xn, #0 then B.cond (no CSET between).
    إذا (!كلمات_ذراع_تتلو(الصورة, 0xFFFFFC1F, 0xF100001F, 0xFF000010, 0x54000000, 1)) {
        أرجع اختياري.موجود(«مقارنة بصفر بلا CMP #0 يتلوه B.cond»);
    };
    // CBZ or CBNZ (64-bit).
    إذا (!كلمة_ذراع_موجودة(الصورة, 0xFE000000, 0xB4000000)) { أرجع اختياري.موجود(«لا CBZ ولا CBNZ»); };
    // TBZ/TBNZ, or TST Xn, #1.
    إذا (!كلمة_ذراع_موجودة(الصورة, 0x7E000000, 0x36000000) && !كلمة_ذراع_موجودة(الصورة, 0xFFFFFC1F, 0xF240001F)) {
        أرجع اختياري.موجود(«اختبار البت الأدنى بلا TBZ ولا TST #1»);
    };
    // Constants in one instruction: MOVZ #5, MOVN #1 (-2), ORR XZR,
    // #0x5555555555555555; no MOVK of a zero halfword anywhere.
    إذا (!كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0xD28000A0)) { أرجع اختياري.موجود(«الثابت 5 ليس MOVZ واحدة»); };
    إذا (!كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0x92800020)) { أرجع اختياري.موجود(«الثابت -2 ليس MOVN واحدة»); };
    إذا (!كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0xB200F3E0)) { أرجع اختياري.موجود(«قناع البتات ليس ORR واحدة»); };
    إذا (كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0xF2A00000) || كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0xF2C00000)
        || كلمة_ذراع_موجودة(الصورة, 0xFFFFFFE0, 0xF2E00000)) {
        أرجع اختياري.موجود(«MOVK لنصف كلمة صفري»);
    };
    أرجع اختياري.لا_شيء();
}

// Machine-code patterns of the native backends' optimizations
// (docs/en/internals/msir-and-codegen.md) in the objects of
// tests/{en,ar}/object/source/optimization_patterns.sn, for x86-64 and
// AArch64: a checked operation is one instruction and a branch on its
// overflow (أنماط_إكس_المفقودة, أنماط_ذراع_المفقودة).
عرف تحقق_أنماط_التحسين(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن المصادر: متجه نص = [«tests/en/object/source/optimization_patterns.sn», «tests/ar/object/source/optimization_patterns.sn»];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن الأهداف: متجه نص = [«x86_64-linux», «arm64-darwin»];
    ليكن م: متغير طبيعي = 0;
    طالما (م < 2) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < 2) {
            ليكن أجزاء_الناتج: متجه نص = [
                «build/tests-sultanc/opt-patterns-», انسخ_نص_اختبار(&الأهداف[ك]), «-», انسخ_نص_اختبار(&اللغات[م]), «.o»
            ];
            ليكن الناتج: نص = اجمع_نصوص(&أجزاء_الناتج);
            ليكن أجزاء_الاسم: متجه نص = [
                «أنماط التحسين الأصلية », انسخ_نص_اختبار(&الأهداف[ك]), « (», انسخ_نص_اختبار(&اللغات[م]), «)»
            ];
            ليكن الاسم: نص = اجمع_نصوص(&أجزاء_الاسم);
            ليكن الوسائط: متجه نص = [
                «-c», «--backend=native», «--target», انسخ_نص_اختبار(&الأهداف[ك]),
                انسخ_نص_اختبار(&المصادر[م]), «-o», انسخ_نص_اختبار(&الناتج)
            ];
            ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&مترجم, &الوسائط, &الاسم);
            ليكن الصورة: متغير متجه ط8 = [];
            إذا (النتيجة.الحالة == 0 && !نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
                طابق اقرأ_بايتات_ملف(&الناتج) مع
                | نتيجة.نجح(البايتات) -> { الصورة := البايتات; }
                | نتيجة.خطأ(_) -> { };
            };
            ليكن المفقود: متغير اختياري نص = اختياري.لا_شيء();
            إذا ((الطول(الصورة) مثل طبيعي) == 0) { المفقود := اختياري.موجود(«تعذر بناء الكائن»); }
            وإلا إذا (ك == 0) { المفقود := أنماط_إكس_المفقودة(&الصورة); }
            وإلا { المفقود := أنماط_ذراع_المفقودة(&الصورة); };
            طابق المفقود مع
            | اختياري.لا_شيء -> { سجل_نجاح(الملخص, &الاسم); }
            | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &الاسم, &السبب); };
            ك := ك + 1;
        }
        م := م + 1;
    }
}

// The MSIR text of the function quoted الاسم names: from its name to the
// line that closes it; empty when it is not there.
عرف نص_دالة_مسير_اختبار(النص: &نص, الاسم: &نص): نص {
    طابق ابحث_نصا(النص, الاسم) مع
    | اختياري.لا_شيء -> { أرجع ""; }
    | اختياري.موجود(البداية) -> {
        ليكن النهاية_علامة: نص = "\n}";
        ليكن النهاية: متغير طبيعي = الطول(*النص) مثل طبيعي;
        طابق ابحث_نصا_من(النص, &النهاية_علامة, البداية) مع
        | اختياري.موجود(ن) -> { النهاية := ن; }
        | اختياري.لا_شيء -> { };
        طابق مقطع_نص(النص, البداية, النهاية - البداية) مع
        | اختياري.موجود(المقطع) -> { أرجع المقطع; }
        | اختياري.لا_شيء -> { أرجع ""; };
    };
}

// Range-based check removal (docs/en/internals/msir-and-codegen.md): the
// MSIR of tests/{en,ar}/object/source/proven_checks.sn holds no report
// block (no `trap`) in the two functions whose every check a dominating
// compare proves, and their additions and subtractions wrap.
عرف تحقق_الفحوص_المثبتة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن المصادر: متجه نص = [«tests/en/object/source/proven_checks.sn», «tests/ar/object/source/proven_checks.sn»];
    ليكن الأولى: متجه نص = ["\"count_to\"", "\"عد_إلى\""];
    ليكن الثانية: متجه نص = ["\"before_two\"", "\"قبل_الاثنين\""];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن الفخ: نص = «trap»;
    ليكن الملتف: نص = «.wrap»;
    ليكن م: متغير طبيعي = 0;
    طالما (م < 2) {
        ليكن أجزاء_الاسم: متجه نص = [«إزالة الفحوص المثبتة (», انسخ_نص_اختبار(&اللغات[م]), «)»];
        ليكن الاسم: نص = اجمع_نصوص(&أجزاء_الاسم);
        ليكن الوسائط: متجه نص = [«--emit=msir», انسخ_نص_اختبار(&المصادر[م])];
        ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&مترجم, &الوسائط, &الاسم);
        ليكن الأولى_نص: نص = نص_دالة_مسير_اختبار(&النتيجة.الخرج, &الأولى[م]);
        ليكن الثانية_نص: نص = نص_دالة_مسير_اختبار(&النتيجة.الخرج, &الثانية[م]);
        إذا (النتيجة.الحالة == 0 && (الطول(الأولى_نص) مثل طبيعي) > 0 && (الطول(الثانية_نص) مثل طبيعي) > 0
            && !يحتوي_نصا(&الأولى_نص, &الفخ) && !يحتوي_نصا(&الثانية_نص, &الفخ)
            && يحتوي_نصا(&الأولى_نص, &الملتف) && يحتوي_نصا(&الثانية_نص, &الملتف)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            ليكن سبب: نص = «بقي فحص تجاوز تثبت مقارنة مهيمنة أنه لا يقع»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
        م := م + 1;
    }
}

عام عرف اختبر_الكائنات(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن مصدر_خارجي: نص = «tests/en/object/source/external_call.sn»;
    ليكن بسيط: نص = «tests/en/object/source/simple.sn»;
    ليكن اكس: نص = «x86_64-linux»;
    ليكن ذراع: نص = «arm64-darwin»;
    ليكن ملف_إلف: نص = «build/tests-sultanc/external-x86_64.o»;
    ليكن ملف_ماتشو: نص = «build/tests-sultanc/external-arm64.o»;
    ليكن اسم_إلف: نص = «بنية ELF وترحيلاته»;
    ليكن اسم_ماتشو: نص = «بنية Mach-O وترحيلاته»;
    تحقق_كائن(الملخص, &مصدر_خارجي, &اكس, &ملف_إلف, &اسم_إلف, صواب);
    تحقق_كائن(الملخص, &مصدر_خارجي, &ذراع, &ملف_ماتشو, &اسم_ماتشو, صواب);
    ليكن ب1: نص = «deterministic-elf»;
    ليكن ب2: نص = «deterministic-macho»;
    تحقق_حتمية(الملخص, &بسيط, &اكس, &ب1);
    تحقق_حتمية(الملخص, &بسيط, &ذراع, &ب2);
    تحقق_توقيع_ماتشو(الملخص);
    تحقق_مدخلات_الربط(الملخص);
    تحقق_مسابر_المكدس(الملخص);
    تحقق_أنماط_التحسين(الملخص);
    تحقق_الفحوص_المثبتة(الملخص);
}
