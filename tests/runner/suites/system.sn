استورد "../common.sn";
استورد std.fs.write_file;
استورد std.fs.read_file;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.process.child;
استورد std.text.compare;
استورد std.time.duration;
استورد std.time.time;

عرف رمز_إنهاء(النهاية: &حالة_إنهاء): عدد {
    طابق *النهاية مع
    | حالة_إنهاء.خرج(الرمز) -> { أرجع الرمز; }
    | حالة_إنهاء.إشارة(الرمز) -> { أرجع 128 + الرمز; };
}

عرف اختبر_التقارب(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن اسم_بيئة: نص = «SULTANC_TEST_CONVERGENCE»;
    ليكن صفر: نص = «0»;
    ليكن مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    ليكن واحد: نص = «1»;
    ليكن الاسم: نص = «تقارب الاستضافة الذاتية Stage2 → Stage3 → Stage4»;
    إذا (!نصان_متساويان(&مفعل, &واحد)) {
        ليكن سبب: نص = «فعّل SULTANC_TEST_CONVERGENCE=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> {
        ليكن سبب: نص = «الهدف المضيف غير مدعوم»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | اختياري.موجود(الهدف) -> {
        ليكن مرحلة2: نص = مسار_المترجم();
        ليكن مرحلة3: نص = «build/tests-sultanc/stage3»;
        ليكن مرحلة4: نص = «build/tests-sultanc/stage4»;
        ليكن و3: متغير متجه نص = [«--target», انسخ_نص_اختبار(&الهدف), «-o», انسخ_نص_اختبار(&مرحلة3), «compiler/main.sn»];
        ليكن إضافية3: متجه نص = وسائط_بناء_المترجم();
        ليكن م3: متغير طبيعي = 0;
        طالما (م3 < (الطول(إضافية3) مثل طبيعي)) { ألحق(و3, انسخ_نص_اختبار(&إضافية3[م3])); م3 := م3 + 1; }
        ليكن ن3: نص = «convergence-stage3»;
        ليكن ج3: نتيجة_أمر = نفذ_أمرا_بمهلة(&مرحلة2, &و3, &ن3, مهلة_الأوامر() * 6);
        إذا ((ج3.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&ج3)) {
            ليكن أصل_السبب: نص = «تعذر إنتاج Stage3»;
            ليكن سبب: نص = سبب_مع_خرج(&أصل_السبب, &ج3);
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
        ليكن و4: متغير متجه نص = [«--target», انسخ_نص_اختبار(&الهدف), «-o», انسخ_نص_اختبار(&مرحلة4), «compiler/main.sn»];
        ليكن إضافية4: متجه نص = وسائط_بناء_المترجم();
        ليكن م4: متغير طبيعي = 0;
        طالما (م4 < (الطول(إضافية4) مثل طبيعي)) { ألحق(و4, انسخ_نص_اختبار(&إضافية4[م4])); م4 := م4 + 1; }
        ليكن ن4: نص = «convergence-stage4»;
        ليكن ج4: نتيجة_أمر = نفذ_أمرا_بمهلة(&مرحلة3, &و4, &ن4, مهلة_الأوامر() * 6);
        إذا ((ج4.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&ج4)) {
            ليكن أصل_السبب: نص = «تعذر إنتاج Stage4»;
            ليكن سبب: نص = سبب_مع_خرج(&أصل_السبب, &ج4);
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
        إذا ((!ملفات_متساوية(&مرحلة2, &مرحلة3)) || (!ملفات_متساوية(&مرحلة3, &مرحلة4))) {
            ليكن سبب: نص = «مخرجات مراحل الاستضافة الذاتية غير متطابقة بايتيا»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        } وإلا {
            سجل_نجاح(الملخص, &الاسم);
        };
    };
}

عرف ابن_تنفيذي(
    المصدر: &نص,
    الناتج: &نص,
    الاسم: &نص
): منطقي {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن و: متجه نص = [«--target», «arm64-darwin», «--lang», «en», استنسخ(المصدر), «-o», استنسخ(الناتج)];
    ليكن ج: نتيجة_أمر = نفذ_أمرا(&مترجم, &و, الاسم);
    أرجع (ج.الحالة == 0) && (!نتيجة_تحوي_فشلا_داخليا(&ج));
}

عرف نم_قليلا(ملي: عدد): فراغ {
    طابق مدة_من_مليثواني(ملي) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مدة_انتظار) -> {
        طابق نم_لمدة(&مدة_انتظار) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { };
    };
}

عرف اختبر_تي_سي_بي_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الاسم: نص = «شبكة TCP الحية على Darwin ARM64»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        ليكن المطلوب: نص = «arm64-darwin»;
        إذا (!نصان_متساويان(&الهدف, &المطلوب)) {
            ليكن سبب: نص = «الاختبار حي ومخصص لـ Darwin ARM64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | اختياري.لا_شيء -> {
        ليكن سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن خادم_مصدر: نص = «tests/en/runtime/darwin/network_tcp_server.sn»;
    ليكن عميل_مصدر: نص = «tests/en/runtime/darwin/network_tcp_client.sn»;
    ليكن خادم: نص = «build/tests-sultanc/tcp-server»;
    ليكن عميل: نص = «build/tests-sultanc/tcp-client»;
    ليكن اسم_بناء_خادم: نص = «tcp-build-server»;
    ليكن اسم_بناء_عميل: نص = «tcp-build-client»;
    إذا ((!ابن_تنفيذي(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        ليكن سبب: نص = «تعذر بناء خادم أو عميل TCP»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن لا_وسائط: متجه نص = [];
    طابق شغل_عملية(&خادم, &لا_وسائط) مع
    | نتيجة.خطأ(_) -> {
        ليكن سبب: نص = «تعذر تشغيل خادم TCP»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(طفل_الخادم) -> {
        نم_قليلا(200);
        ليكن حالة_عميل: متغير عدد = -1;
        طابق شغل_وانتظر(&عميل, &لا_وسائط) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_عميل := رمز_إنهاء(&نهاية); };
        ليكن حالة_خادم: متغير عدد = -1;
        طابق انتظر_عملية(&طفل_الخادم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_خادم := رمز_إنهاء(&نهاية); };
        إذا ((حالة_عميل == 42) && (حالة_خادم == 42)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            ليكن سبب: نص = «حالة الخادم أو العميل ليست 42»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عرف جهز_شهادة_تي_إل_إس(): منطقي {
    ليكن إعداد: نص = «[req]
distinguished_name=dn
x509_extensions=v3
prompt=no
[dn]
CN=localhost
[v3]
subjectAltName=@alt
basicConstraints=CA:TRUE
keyUsage=digitalSignature,keyEncipherment,keyCertSign
extendedKeyUsage=serverAuth
[alt]
DNS.1=localhost
IP.1=127.0.0.1
»;

    ليكن أمر_تهيئة: نص = «rm -rf /tmp/sultanc_tls_test && mkdir -p /tmp/sultanc_tls_test»;
    ليكن اسم_تهيئة: نص = «tls-directory»;
    ليكن نتيجة_تهيئة: نتيجة_أمر = نفذ_نص_شل(&أمر_تهيئة, &اسم_تهيئة);
    إذا (نتيجة_تهيئة.الحالة != 0) { أرجع خطأ; };

    ليكن ملف_إعداد: نص = «/tmp/sultanc_tls_test/openssl.cnf»;
    طابق اكتب_الملف(&ملف_إعداد, &إعداد) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(_) -> { };

    ليكن أ1: نص = «openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config /tmp/sultanc_tls_test/openssl.cnf -keyout /tmp/sultanc_tls_test/server.key -out /tmp/sultanc_tls_test/server.crt >/dev/null 2>&1»;
    ليكن ن1: نص = «tls-cert»;
    ليكن ج1: نتيجة_أمر = نفذ_نص_شل(&أ1, &ن1);
    إذا (ج1.الحالة != 0) { أرجع خطأ; };

    ليكن أ2: نص = «openssl x509 -in /tmp/sultanc_tls_test/server.crt -outform DER -out /tmp/sultanc_tls_test/server.der»;
    ليكن ن2: نص = «tls-der»;
    ليكن ج2: نتيجة_أمر = نفذ_نص_شل(&أ2, &ن2);
    إذا (ج2.الحالة != 0) { أرجع خطأ; };

    ليكن أ3: نص = «openssl pkcs12 -export -out /tmp/sultanc_tls_test/server.p12 -inkey /tmp/sultanc_tls_test/server.key -in /tmp/sultanc_tls_test/server.crt -passout pass:sultanc-test >/dev/null 2>&1»;
    ليكن ن3: نص = «tls-p12»;
    ليكن ج3: نتيجة_أمر = نفذ_نص_شل(&أ3, &ن3);
    أرجع ج3.الحالة == 0;
}

عرف اختبر_تي_إل_إس_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الاسم: نص = «TLS حي عبر Security.framework»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        ليكن المطلوب: نص = «arm64-darwin»;
        إذا (!نصان_متساويان(&الهدف, &المطلوب)) {
            ليكن سبب: نص = «الاختبار حي ومخصص لـ Darwin ARM64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        ليكن سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن تحقق_أوبن: نص = «command -v openssl >/dev/null 2>&1»;
    ليكن اسم_أوبن: نص = «tls-openssl»;
    ليكن ج_أوبن: نتيجة_أمر = نفذ_نص_شل(&تحقق_أوبن, &اسم_أوبن);
    إذا (ج_أوبن.الحالة != 0) {
        ليكن سبب: نص = «openssl غير متاح لتوليد شهادة الاختبار»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    إذا (!جهز_شهادة_تي_إل_إس()) {
        ليكن سبب: نص = «تعذر توليد شهادة TLS المحلية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن خادم_مصدر: نص = «tests/en/runtime/darwin/network_tls_server.sn»;
    ليكن عميل_مصدر: نص = «tests/en/runtime/darwin/network_tls_client.sn»;
    ليكن خادم: نص = «build/tests-sultanc/network_tls_server»;
    ليكن عميل: نص = «build/tests-sultanc/network_tls_client»;
    ليكن اسم_بناء_خادم: نص = «tls-build-server»;
    ليكن اسم_بناء_عميل: نص = «tls-build-client»;
    إذا ((!ابن_تنفيذي(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        ليكن سبب: نص = «تعذر بناء خادم أو عميل TLS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن لا_وسائط: متجه نص = [];
    طابق شغل_عملية(&خادم, &لا_وسائط) مع
    | نتيجة.خطأ(_) -> {
        ليكن سبب: نص = «تعذر تشغيل خادم TLS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(طفل_الخادم) -> {
        نم_قليلا(300);
        ليكن حالة_عميل: متغير عدد = -1;
        طابق شغل_وانتظر(&عميل, &لا_وسائط) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_عميل := رمز_إنهاء(&نهاية); };
        ليكن حالة_خادم: متغير عدد = -1;
        طابق انتظر_عملية(&طفل_الخادم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_خادم := رمز_إنهاء(&نهاية); };
        إذا ((حالة_عميل == 42) && (حالة_خادم == 42)) { سجل_نجاح(الملخص, &الاسم); }
        وإلا {
            ليكن سبب: نص = «فشل تفاوض TLS أو القراءة/الكتابة»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عرف ابن_تنفيذي_للمضيف(المصدر: &نص, الناتج: &نص, الاسم: &نص): منطقي {
    ليكن مترجم: نص = مسار_المترجم();
    ليكن و: متجه نص = [«--lang», «en», استنسخ(المصدر), «-o», استنسخ(الناتج)];
    ليكن ج: نتيجة_أمر = نفذ_أمرا(&مترجم, &و, الاسم);
    أرجع (ج.الحالة == 0) && (!نتيجة_تحوي_فشلا_داخليا(&ج));
}

// Live HTTP/2 on Linux: curl (nghttp2) against the std.http server over
// h2c with prior knowledge and over TLS with ALPN, plain HTTP/1 on the
// same listener, and std's HTTP/2 client with concurrent streams.
عرف اختبر_ويب2_حي(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الاسم: نص = «HTTP/2 حي: curl وعميل std عبر h2c وTLS (ALPN)»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        ليكن المطلوب: نص = «x86_64-linux»;
        إذا (!نصان_متساويان(&الهدف, &المطلوب)) {
            ليكن سبب: نص = «الاختبار حي ومخصص لـ Linux x86_64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        ليكن سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    ليكن تحقق_الأدوات: نص = «command -v openssl >/dev/null 2>&1 && curl -V 2>/dev/null | grep -q HTTP2»;
    ليكن اسم_الأدوات: نص = «h2-tools»;
    ليكن ج_الأدوات: نتيجة_أمر = نفذ_نص_شل(&تحقق_الأدوات, &اسم_الأدوات);
    إذا (ج_الأدوات.الحالة != 0) {
        ليكن سبب: نص = «curl بدعم HTTP/2 أو openssl غير متاح»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    إذا (!جهز_شهادة_تي_إل_إس()) {
        ليكن سبب: نص = «تعذر توليد شهادة TLS المحلية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    ليكن خادم_مصدر: نص = «tests/en/runtime/network/http2_live_server.sn»;
    ليكن عميل_مصدر: نص = «tests/en/runtime/network/http2_live_client.sn»;
    ليكن خادم: نص = «build/tests-sultanc/http2_live_server»;
    ليكن عميل: نص = «build/tests-sultanc/http2_live_client»;
    ليكن اسم_بناء_خادم: نص = «h2-build-server»;
    ليكن اسم_بناء_عميل: نص = «h2-build-client»;
    إذا ((!ابن_تنفيذي_للمضيف(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي_للمضيف(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        ليكن سبب: نص = «تعذر بناء خادم أو عميل HTTP/2»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    ليكن النص: نص = «S=build/tests-sultanc/http2_live_server; C=build/tests-sultanc/http2_live_client; T=/tmp/sultanc_tls_test
P=$((40000 + $$ % 1000)); Q=$((P + 1000))
$S $P 4 & PS=$!; sleep 0.3
[ "$(timeout 20 curl -s --http2-prior-knowledge http://127.0.0.1:$P/x)" = "h2 GET /x 0" ] || { kill $PS; exit 11; }
[ "$(timeout 20 curl -s --http2-prior-knowledge -d hello http://127.0.0.1:$P/p)" = "h2 POST /p 5" ] || { kill $PS; exit 12; }
[ "$(timeout 20 curl -s http://127.0.0.1:$P/y)" = "h1 GET /y 0" ] || { kill $PS; exit 13; }
timeout 30 $C http://127.0.0.1:$P/; [ $? = 42 ] || { kill $PS; exit 14; }
wait $PS; [ $? = 42 ] || exit 15
$S $Q 3 $T/server.p12 sultanc-test & PT=$!; sleep 0.3
[ "$(timeout 20 curl -sk --http2 https://127.0.0.1:$Q/x)" = "h2 GET /x 0" ] || { kill $PT; exit 21; }
[ "$(timeout 20 curl -sk --http1.1 https://127.0.0.1:$Q/y)" = "h1 GET /y 0" ] || { kill $PT; exit 22; }
timeout 30 $C https://127.0.0.1:$Q/ $T/server.der; [ $? = 42 ] || { kill $PT; exit 23; }
wait $PT; [ $? = 42 ] || exit 24
exit 0»;
    ليكن اسم_التشغيل: نص = «h2-live»;
    ليكن ج: نتيجة_أمر = نفذ_نص_شل(&النص, &اسم_التشغيل);
    إذا (ج.الحالة == 0) { سجل_نجاح(الملخص, &الاسم); }
    وإلا {
        ليكن سبب: نص = «فشل تبادل HTTP/2 الحي مع curl أو عميل std»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    };
}

عرف نمو_مئوي_يتجاوز(القديم: طبيعي, الجديد: طبيعي, الحد: طبيعي): منطقي {
    إذا (القديم == 0) { أرجع صواب; };
    إذا (الجديد <= القديم) { أرجع خطأ; };
    ليكن الزيادة: طبيعي = الجديد - القديم;
    أرجع (الزيادة * 100) > (القديم * الحد);
}

عرف اختبر_بوابة_الذاكرة_المقيمة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الاسم: نص = «بوابة انحدار RSS والزمن»;
    ليكن مقبول: منطقي =
        (!نمو_مئوي_يتجاوز(1000000000, 1100000000, 20))
        && (!نمو_مئوي_يتجاوز(1500000000, 1700000000, 20))
        && (!نمو_مئوي_يتجاوز(1800000000, 2100000000, 20))
        && (!نمو_مئوي_يتجاوز(1000, 1100, 30));
    ليكن مرفوض: منطقي =
        نمو_مئوي_يتجاوز(1000000000, 1350000000, 20)
        || نمو_مئوي_يتجاوز(1800000000, 2500000000, 20)
        || نمو_مئوي_يتجاوز(1000, 1400, 30);
    إذا (مقبول && مرفوض) { سجل_نجاح(الملخص, &الاسم); }
    وإلا {
        ليكن سبب: نص = «حساب حدود الانحدار لا يميز العينة المقبولة والمرفوضة»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    };
}

عرف رقم_بعد_علامة(النص: &نص, العلامة: &نص): اختياري طبيعي {
    طابق ابحث_نصا(النص, العلامة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        ليكن ف: متغير طبيعي = م + (الطول(*العلامة) مثل طبيعي);
        ليكن ك: طبيعي = الطول(*النص) مثل طبيعي;
        طالما ((ف < ك) && (((*النص)[ف] < 0x30) || ((*النص)[ف] > 0x39))) { ف := ف + 1; };
        إذا (ف >= ك) { أرجع اختياري.لا_شيء(); };
        ليكن ن: متغير طبيعي = ف;
        طالما ((ن < ك) && ((*النص)[ن] >= 0x30) && ((*النص)[ن] <= 0x39)) { ن := ن + 1; };
        ليكن رقم: متغير نص = «»;
        طابق مقطع_نص(النص, ف, ن - ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المقطع) -> { رقم := المقطع; };
        طابق حلل_طبيعي(&رقم) مع
        | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف رقم_قبل_علامة(النص: &نص, العلامة: &نص): اختياري طبيعي {
    طابق ابحث_نصا(النص, العلامة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        إذا (م == 0) { أرجع اختياري.لا_شيء(); };
        ليكن ف: متغير طبيعي = م;
        طالما ((ف > 0) && (((*النص)[ف - 1] < 0x30) || ((*النص)[ف - 1] > 0x39))) { ف := ف - 1; };
        ليكن نهاية: طبيعي = ف;
        طالما ((ف > 0) && ((*النص)[ف - 1] >= 0x30) && ((*النص)[ف - 1] <= 0x39)) { ف := ف - 1; };
        إذا (ف == نهاية) { أرجع اختياري.لا_شيء(); };
        ليكن رقم: متغير نص = «»;
        طابق مقطع_نص(النص, ف, نهاية - ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المقطع) -> { رقم := المقطع; };
        طابق حلل_طبيعي(&رقم) مع
        | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف استخرج_ذروة_الذاكرة_المقيمة(النتيجة: &نتيجة_أمر): اختياري طبيعي {
    ليكن علامة_داروين: نص = «maximum resident set size»;
    ليكن علامة_لينكس: نص = «Maximum resident set size (kbytes)»;
    ليكن قيمة: متغير اختياري طبيعي = رقم_قبل_علامة(&(*النتيجة).الخطأ, &علامة_داروين);
    طابق قيمة مع
    | اختياري.لا_شيء -> {
        طابق رقم_بعد_علامة(&(*النتيجة).الخطأ, &علامة_لينكس) مع
        | اختياري.موجود(كيلو) -> { قيمة := اختياري.موجود(كيلو * 1024); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع قيمة;
}

عرف قس_أمر_الذاكرة_المقيمة(الأمر: &نص, الاسم: &نص): اختياري طبيعي {
    ليكن بادئة: متغير نص = «/usr/bin/time -l »;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        ليكن لينكس: نص = «-linux»;
        إذا (يحتوي_نصا(&الهدف, &لينكس)) { بادئة := «/usr/bin/time -v »; };
    }
    | _ -> { };
    ليكن أجزاء: متجه نص = [بادئة, استنسخ(الأمر)];
    ليكن كامل: نص = اجمع_نصوص(&أجزاء);
    ليكن نتيجة: نتيجة_أمر = نفذ_نص_شل(&كامل, الاسم);
    إذا (نتيجة.الحالة != 0) { أرجع اختياري.لا_شيء(); };
    أرجع استخرج_ذروة_الذاكرة_المقيمة(&نتيجة);
}

عرف اختبر_قياس_الذاكرة_المقيمة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن اسم_بيئة: نص = «SULTANC_TEST_RSS»;
    ليكن صفر: نص = «0»;
    ليكن مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    ليكن واحد: نص = «1»;
    ليكن الاسم: نص = «قياس RSS لمسارات check/object/executable»;
    إذا (!نصان_متساويان(&مفعل, &واحد)) {
        ليكن سبب: نص = «فعّل SULTANC_TEST_RSS=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> {
        ليكن سبب: نص = «هدف المضيف غير مدعوم لقياس RSS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | اختياري.موجود(الهدف) -> {
        إذا (هدف_ويندوز(&الهدف)) {
            // The peak is read from /usr/bin/time, which Windows lacks.
            ليكن سبب: نص = «قياس RSS يستعمل /usr/bin/time، وليس على Windows»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
        ليكن المترجم: نص = مسار_المترجم();
        ليكن مترجم_شل: نص = اقتبس_لشل(&المترجم);
        ليكن هدف_شل: نص = اقتبس_لشل(&الهدف);
        ليكن أمر_فحص_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « check compiler/main.sn»];
        ليكن أمر_كائن_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « -c compiler/main.sn --target=», انسخ_نص_اختبار(&هدف_شل), « -o build/tests-sultanc/rss-profile.o»];
        ليكن إضافية_الذاكرة: متجه نص = وسائط_بناء_المترجم();
        ليكن أمر_تنفيذي_أجزاء: متغير متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « compiler/main.sn --target=», انسخ_نص_اختبار(&هدف_شل), « -o build/tests-sultanc/rss-profile-executable»];
        ليكن م_ذ: متغير طبيعي = 0;
        طالما (م_ذ < (الطول(إضافية_الذاكرة) مثل طبيعي)) {
            ألحق(أمر_تنفيذي_أجزاء, « »);
            ألحق(أمر_تنفيذي_أجزاء, اقتبس_لشل(&إضافية_الذاكرة[م_ذ]));
            م_ذ := م_ذ + 1;
        }
        ليكن أمر_فحص: نص = اجمع_نصوص(&أمر_فحص_أجزاء);
        ليكن أمر_كائن: نص = اجمع_نصوص(&أمر_كائن_أجزاء);
        ليكن أمر_تنفيذي: نص = اجمع_نصوص(&أمر_تنفيذي_أجزاء);
        ليكن ن1: نص = «rss-check»;
        ليكن ن2: نص = «rss-object»;
        ليكن ن3: نص = «rss-executable»;
        ليكن فحص: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_فحص, &ن1);
        ليكن كائن: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_كائن, &ن2);
        ليكن تنفيذي: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_تنفيذي, &ن3);

        طابق فحص مع
        | اختياري.لا_شيء -> {
            ليكن سبب: نص = «تعذر قياس RSS لمسار check»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };
        طابق كائن مع
        | اختياري.لا_شيء -> {
            ليكن سبب: نص = «تعذر قياس RSS لمسار object»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };
        طابق تنفيذي مع
        | اختياري.لا_شيء -> {
            ليكن سبب: نص = «تعذر قياس RSS لمسار executable»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };

        سجل_نجاح(الملخص, &الاسم);
    };
}

عرف أول_عدد_في_نص(النص: &نص): اختياري طبيعي {
    ليكن ف: متغير طبيعي = 0;
    ليكن ك: طبيعي = الطول(*النص) مثل طبيعي;
    طالما ((ف < ك) && (((*النص)[ف] < 0x30) || ((*النص)[ف] > 0x39))) { ف := ف + 1; };
    إذا (ف >= ك) { أرجع اختياري.لا_شيء(); };
    ليكن ن: متغير طبيعي = ف;
    طالما ((ن < ك) && ((*النص)[ن] >= 0x30) && ((*النص)[ن] <= 0x39)) { ن := ن + 1; };
    ليكن رقم: متغير نص = «»;
    طابق مقطع_نص(النص, ف, ن - ف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقطع) -> { رقم := المقطع; };
    طابق حلل_طبيعي(&رقم) مع
    | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف ذاكرة_عملية_مقيمة(المعرف: عدد): اختياري طبيعي {
    ليكن رقم: نص = عدد_إلى_نص(المعرف);
    ليكن برنامج: نص = «/bin/ps»;
    ليكن وسائط: متجه نص = [«-o», «rss=», «-p», انسخ_نص_اختبار(&رقم)];
    ليكن اسم: نص = «allocation-ps»;
    ليكن نتيجة: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط, &اسم);
    إذا (نتيجة.الحالة != 0) { أرجع اختياري.لا_شيء(); };
    طابق أول_عدد_في_نص(&نتيجة.الخرج) مع
    | اختياري.موجود(كيلو) -> { أرجع اختياري.موجود(كيلو * 1024); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف أرسل_إشارة(المعرف: عدد, الإشارة: &نص): منطقي {
    ليكن رقم: نص = عدد_إلى_نص(المعرف);
    ليكن برنامج: نص = «/bin/kill»;
    ليكن وسائط: متجه نص = [استنسخ(الإشارة), انسخ_نص_اختبار(&رقم)];
    ليكن اسم: نص = «allocation-signal»;
    ليكن نتيجة: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط, &اسم);
    أرجع نتيجة.الحالة == 0;
}

عرف اختبر_ملف_غير_فارغ(المسار: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(ب) -> { أرجع الطول(ب) > 0; };
}

عرف اختبر_تخصيصات_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن اسم_بيئة: نص = «SULTANC_TEST_ALLOCATIONS»;
    ليكن صفر: نص = «0»;
    ليكن مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    ليكن واحد: نص = «1»;
    ليكن الاسم: نص = «ملف تخصيصات malloc_history عند ذروة الذاكرة»;
    إذا (!نصان_متساويان(&مفعل, &واحد)) {
        ليكن سبب: نص = «فعّل SULTANC_TEST_ALLOCATIONS=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        ليكن المطلوب: نص = «arm64-darwin»;
        إذا (!نصان_متساويان(&الهدف, &المطلوب)) {
            ليكن سبب: نص = «malloc_history متاح فقط على Darwin»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        ليكن سبب: نص = «هدف المضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن تحقق_أدوات: نص = «test -x /usr/bin/malloc_history && test -x /usr/bin/vmmap && test -x /bin/ps && test -x /bin/kill»;
    ليكن اسم_أدوات: نص = «allocation-tools»;
    ليكن أدوات: نتيجة_أمر = نفذ_نص_شل(&تحقق_أدوات, &اسم_أدوات);
    إذا (أدوات.الحالة != 0) {
        ليكن سبب: نص = «أدوات malloc_history/vmmap غير متاحة»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    ليكن المترجم: نص = مسار_المترجم();
    ليكن مترجم_شل: نص = اقتبس_لشل(&المترجم);
    ليكن أمر_أساس_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « -c compiler/main.sn --target=arm64-darwin -o build/tests-sultanc/allocation-baseline.o»];
    ليكن أمر_أساس: نص = اجمع_نصوص(&أمر_أساس_أجزاء);
    ليكن اسم_أساس: نص = «allocation-baseline»;
    ليكن ذروة_اختيار: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_أساس, &اسم_أساس);
    ليكن ذروة: متغير طبيعي = 0;
    طابق ذروة_اختيار مع
    | اختياري.موجود(القيمة) -> { ذروة := القيمة; }
    | اختياري.لا_شيء -> {
        ليكن سبب: نص = «تعذر قياس ذروة RSS الأساسية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    ليكن عتبة: طبيعي = (ذروة * 90) / 100;

    ليكن أمر_عميق_أجزاء: متجه نص = [
        «exec env MallocStackLogging=1 », مترجم_شل,
        « -c compiler/main.sn --target=arm64-darwin -o build/tests-sultanc/allocation-deep.o >build/tests-sultanc/allocation.stdout 2>build/tests-sultanc/allocation.stderr»
    ];
    ليكن أمر_عميق: نص = اجمع_نصوص(&أمر_عميق_أجزاء);
    ليكن شل: نص = مسار_شل_الاختبار();
    ليكن وسائط_شل: متجه نص = [«-c», أمر_عميق];

    طابق شغل_عملية(&شل, &وسائط_شل) مع
    | نتيجة.خطأ(_) -> {
        ليكن سبب: نص = «تعذر تشغيل قياس التخصيصات»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(الطفل) -> {
        ليكن التقط: متغير منطقي = خطأ;
        ليكن انتهى_مبكرا: متغير منطقي = خطأ;
        ليكن دورة: متغير عدد = 0;
        طالما ((!التقط) && (!انتهى_مبكرا) && (دورة < 1500)) {
            طابق ذاكرة_عملية_مقيمة(الطفل.المعرف) مع
            | اختياري.لا_شيء -> { انتهى_مبكرا := صواب; }
            | اختياري.موجود(الحالي) -> {
                إذا ((الحالي > 0) && (الحالي >= عتبة)) {
                    ليكن توقف: نص = «-STOP»;
                    إذا (أرسل_إشارة(الطفل.المعرف, &توقف)) {
                        ليكن رقم: نص = عدد_إلى_نص(الطفل.المعرف);
                        ليكن برنامج_تاريخ: نص = «/usr/bin/malloc_history»;
                        ليكن برنامج_خريطة: نص = «/usr/bin/vmmap»;
                        ليكن وسائط_تاريخ: متجه نص = [انسخ_نص_اختبار(&رقم), «-allBySize», «-highWaterMark»];
                        ليكن وسائط_شجرة: متجه نص = [انسخ_نص_اختبار(&رقم), «-callTree», «-highWaterMark», «-invert», «-ignoreThreads»];
                        ليكن وسائط_خريطة: متجه نص = [«-summary», انسخ_نص_اختبار(&رقم)];
                        ليكن م1: نص = «allocation-history»;
                        ليكن م2: نص = «allocation-calltree»;
                        ليكن م3: نص = «allocation-vmmap»;
                        ليكن ت1: نتيجة_أمر = نفذ_أمرا(&برنامج_تاريخ, &وسائط_تاريخ, &م1);
                        ليكن ت2: نتيجة_أمر = نفذ_أمرا(&برنامج_تاريخ, &وسائط_شجرة, &م2);
                        ليكن ت3: نتيجة_أمر = نفذ_أمرا(&برنامج_خريطة, &وسائط_خريطة, &م3);
                        ليكن ملف1: نص = «build/tests-sultanc/malloc-history-high-water.txt»;
                        ليكن ملف2: نص = «build/tests-sultanc/malloc-history-calltree.txt»;
                        ليكن ملف3: نص = «build/tests-sultanc/vmmap-summary.txt»;
                        ليكن نجح_كتابة: متغير منطقي = صواب;
                        طابق اكتب_الملف(&ملف1, &ت1.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        طابق اكتب_الملف(&ملف2, &ت2.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        طابق اكتب_الملف(&ملف3, &ت3.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        ليكن استمر: نص = «-CONT»;
                        ليكن تجاهل_استمرار: منطقي = أرسل_إشارة(الطفل.المعرف, &استمر);
                        التقط := نجح_كتابة
                            && (ت1.الحالة == 0) && (ت2.الحالة == 0) && (ت3.الحالة == 0)
                            && اختبر_ملف_غير_فارغ(&ملف1)
                            && اختبر_ملف_غير_فارغ(&ملف2)
                            && اختبر_ملف_غير_فارغ(&ملف3);
                    };
                };
            };
            إذا ((!التقط) && (!انتهى_مبكرا)) { نم_قليلا(20); };
            دورة := دورة + 1;
        }

        ليكن حالة: متغير عدد = -1;
        طابق انتظر_عملية(&الطفل) مع
        | نتيجة.نجح(نهاية) -> { حالة := رمز_إنهاء(&نهاية); }
        | نتيجة.خطأ(_) -> { };

        إذا (التقط && (حالة == 0)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            ليكن سبب: نص = «لم تلتقط تقارير التخصيصات عند عتبة الذروة أو فشل التجميع»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عام عرف اختبر_النظام(الملخص: &متغير ملخص_اختبارات): فراغ {
    اختبر_بوابة_الذاكرة_المقيمة(الملخص);
    اختبر_قياس_الذاكرة_المقيمة(الملخص);
    اختبر_تخصيصات_داروين(الملخص);
    اختبر_تي_سي_بي_داروين(الملخص);
    اختبر_تي_إل_إس_داروين(الملخص);
    اختبر_ويب2_حي(الملخص);
    اختبر_التقارب(الملخص);
}
