استورد "../common.sn";
استورد std.fs.write_file;
استورد std.fs.read_file;
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.process.child;
استورد std.text.compare;
استورد std.time.duration;

عرف رمز_إنهاء(النهاية: &حالة_إنهاء): عدد {
    طابق *النهاية مع
    | حالة_إنهاء.خرج(الرمز) -> { أرجع الرمز; }
    | حالة_إنهاء.إشارة(الرمز) -> { أرجع 128 + الرمز; };
}

عرف اختبر_التقارب(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_بيئة: نص = «SULTANC_TEST_CONVERGENCE»;
    دع صفر: نص = «0»;
    دع مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    دع واحد: نص = «1»;
    دع الاسم: نص = «تقارب الاستضافة الذاتية Stage2 → Stage3 → Stage4»;
    لو (!نصان_متساويان(&مفعل, &واحد)) {
        دع سبب: نص = «فعّل SULTANC_TEST_CONVERGENCE=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> {
        دع سبب: نص = «الهدف المضيف غير مدعوم»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | اختياري.موجود(الهدف) -> {
        دع مرحلة2: نص = مسار_المترجم();
        دع مرحلة3: نص = «build/tests-sultanc/stage3»;
        دع مرحلة4: نص = «build/tests-sultanc/stage4»;
        دع و3: متجه نص = [«--target», انسخ_نص_اختبار(&الهدف), «-o», انسخ_نص_اختبار(&مرحلة3), «compiler/main.sn»];
        دع ن3: نص = «convergence-stage3»;
        دع ج3: نتيجة_أمر = نفذ_أمرا(&مرحلة2, &و3, &ن3);
        لو ((ج3.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&ج3)) {
            دع سبب: نص = «تعذر إنتاج Stage3»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
        دع و4: متجه نص = [«--target», انسخ_نص_اختبار(&الهدف), «-o», انسخ_نص_اختبار(&مرحلة4), «compiler/main.sn»];
        دع ن4: نص = «convergence-stage4»;
        دع ج4: نتيجة_أمر = نفذ_أمرا(&مرحلة3, &و4, &ن4);
        لو ((ج4.الحالة != 0) || نتيجة_تحوي_فشلا_داخليا(&ج4)) {
            دع سبب: نص = «تعذر إنتاج Stage4»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        };
        لو ((!ملفات_متساوية(&مرحلة2, &مرحلة3)) || (!ملفات_متساوية(&مرحلة3, &مرحلة4))) {
            دع سبب: نص = «مخرجات مراحل الاستضافة الذاتية غير متطابقة بايتيا»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        } وإلا {
            سجل_نجاح(الملخص, &الاسم);
        };
    };
}

عرف ابن_تنفيذي(
    المصدر: &نص,
    الناتج: &نص,
    الاسم: &نص
): منطقي {
    دع مترجم: نص = مسار_المترجم();
    دع و: متجه نص = [«--target», «arm64-darwin», «--lang», «en», استنسخ(المصدر), «-o», استنسخ(الناتج)];
    دع ج: نتيجة_أمر = نفذ_أمرا(&مترجم, &و, الاسم);
    أرجع (ج.الحالة == 0) && (!نتيجة_تحوي_فشلا_داخليا(&ج));
}

عرف نم_قليلا(ملي: عدد): فراغ {
    طابق مدة_من_مليثواني(ملي) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(مدة_انتظار) -> {
        طابق نم_لمدة(&مدة_انتظار) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> { };
    };
}

عرف اختبر_تي_سي_بي_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الاسم: نص = «شبكة TCP الحية على Darwin ARM64»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        دع المطلوب: نص = «arm64-darwin»;
        لو (!نصان_متساويان(&الهدف, &المطلوب)) {
            دع سبب: نص = «الاختبار حي ومخصص لـ Darwin ARM64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | اختياري.لا_شيء -> {
        دع سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع خادم_مصدر: نص = «tests/en/runtime/darwin/network_tcp_server.sn»;
    دع عميل_مصدر: نص = «tests/en/runtime/darwin/network_tcp_client.sn»;
    دع خادم: نص = «build/tests-sultanc/tcp-server»;
    دع عميل: نص = «build/tests-sultanc/tcp-client»;
    دع اسم_بناء_خادم: نص = «tcp-build-server»;
    دع اسم_بناء_عميل: نص = «tcp-build-client»;
    لو ((!ابن_تنفيذي(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        دع سبب: نص = «تعذر بناء خادم أو عميل TCP»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع لا_وسائط: متجه نص = [];
    طابق شغل_عملية(&خادم, &لا_وسائط) مع
    | نتيجة.خطأ(_) -> {
        دع سبب: نص = «تعذر تشغيل خادم TCP»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(طفل_الخادم) -> {
        نم_قليلا(200);
        دع حالة_عميل: متغير عدد = -1;
        طابق شغل_وانتظر(&عميل, &لا_وسائط) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_عميل := رمز_إنهاء(&نهاية); };
        دع حالة_خادم: متغير عدد = -1;
        طابق انتظر_عملية(&طفل_الخادم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_خادم := رمز_إنهاء(&نهاية); };
        لو ((حالة_عميل == 42) && (حالة_خادم == 42)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            دع سبب: نص = «حالة الخادم أو العميل ليست 42»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عرف جهز_شهادة_تي_إل_إس(): منطقي {
    دع إعداد: نص = «[req]
distinguished_name=dn
x509_extensions=v3
prompt=no
[dn]
CN=localhost
[v3]
subjectAltName=@alt
basicConstraints=CA:TRUE
keyUsage=digitalSignature,keyEncipherment,keyCertSign
extendedKeyUsage=serverAuth
[alt]
DNS.1=localhost
IP.1=127.0.0.1
»;

    دع أمر_تهيئة: نص = «rm -rf /tmp/sultanc_tls_test && mkdir -p /tmp/sultanc_tls_test»;
    دع اسم_تهيئة: نص = «tls-directory»;
    دع نتيجة_تهيئة: نتيجة_أمر = نفذ_نص_شل(&أمر_تهيئة, &اسم_تهيئة);
    لو (نتيجة_تهيئة.الحالة != 0) { أرجع خطأ; };

    دع ملف_إعداد: نص = «/tmp/sultanc_tls_test/openssl.cnf»;
    طابق اكتب_الملف(&ملف_إعداد, &إعداد) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(_) -> { };

    دع أ1: نص = «openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config /tmp/sultanc_tls_test/openssl.cnf -keyout /tmp/sultanc_tls_test/server.key -out /tmp/sultanc_tls_test/server.crt >/dev/null 2>&1»;
    دع ن1: نص = «tls-cert»;
    دع ج1: نتيجة_أمر = نفذ_نص_شل(&أ1, &ن1);
    لو (ج1.الحالة != 0) { أرجع خطأ; };

    دع أ2: نص = «openssl x509 -in /tmp/sultanc_tls_test/server.crt -outform DER -out /tmp/sultanc_tls_test/server.der»;
    دع ن2: نص = «tls-der»;
    دع ج2: نتيجة_أمر = نفذ_نص_شل(&أ2, &ن2);
    لو (ج2.الحالة != 0) { أرجع خطأ; };

    دع أ3: نص = «openssl pkcs12 -export -out /tmp/sultanc_tls_test/server.p12 -inkey /tmp/sultanc_tls_test/server.key -in /tmp/sultanc_tls_test/server.crt -passout pass:sultanc-test >/dev/null 2>&1»;
    دع ن3: نص = «tls-p12»;
    دع ج3: نتيجة_أمر = نفذ_نص_شل(&أ3, &ن3);
    أرجع ج3.الحالة == 0;
}

عرف اختبر_تي_إل_إس_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الاسم: نص = «TLS حي عبر Security.framework»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        دع المطلوب: نص = «arm64-darwin»;
        لو (!نصان_متساويان(&الهدف, &المطلوب)) {
            دع سبب: نص = «الاختبار حي ومخصص لـ Darwin ARM64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        دع سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع تحقق_أوبن: نص = «command -v openssl >/dev/null 2>&1»;
    دع اسم_أوبن: نص = «tls-openssl»;
    دع ج_أوبن: نتيجة_أمر = نفذ_نص_شل(&تحقق_أوبن, &اسم_أوبن);
    لو (ج_أوبن.الحالة != 0) {
        دع سبب: نص = «openssl غير متاح لتوليد شهادة الاختبار»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    لو (!جهز_شهادة_تي_إل_إس()) {
        دع سبب: نص = «تعذر توليد شهادة TLS المحلية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع خادم_مصدر: نص = «tests/en/runtime/darwin/network_tls_server.sn»;
    دع عميل_مصدر: نص = «tests/en/runtime/darwin/network_tls_client.sn»;
    دع خادم: نص = «build/tests-sultanc/network_tls_server»;
    دع عميل: نص = «build/tests-sultanc/network_tls_client»;
    دع اسم_بناء_خادم: نص = «tls-build-server»;
    دع اسم_بناء_عميل: نص = «tls-build-client»;
    لو ((!ابن_تنفيذي(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        دع سبب: نص = «تعذر بناء خادم أو عميل TLS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع لا_وسائط: متجه نص = [];
    طابق شغل_عملية(&خادم, &لا_وسائط) مع
    | نتيجة.خطأ(_) -> {
        دع سبب: نص = «تعذر تشغيل خادم TLS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(طفل_الخادم) -> {
        نم_قليلا(300);
        دع حالة_عميل: متغير عدد = -1;
        طابق شغل_وانتظر(&عميل, &لا_وسائط) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_عميل := رمز_إنهاء(&نهاية); };
        دع حالة_خادم: متغير عدد = -1;
        طابق انتظر_عملية(&طفل_الخادم) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(نهاية) -> { حالة_خادم := رمز_إنهاء(&نهاية); };
        لو ((حالة_عميل == 42) && (حالة_خادم == 42)) { سجل_نجاح(الملخص, &الاسم); }
        وإلا {
            دع سبب: نص = «فشل تفاوض TLS أو القراءة/الكتابة»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عرف ابن_تنفيذي_للمضيف(المصدر: &نص, الناتج: &نص, الاسم: &نص): منطقي {
    دع مترجم: نص = مسار_المترجم();
    دع و: متجه نص = [«--lang», «en», استنسخ(المصدر), «-o», استنسخ(الناتج)];
    دع ج: نتيجة_أمر = نفذ_أمرا(&مترجم, &و, الاسم);
    أرجع (ج.الحالة == 0) && (!نتيجة_تحوي_فشلا_داخليا(&ج));
}

// Live HTTP/2 on Linux: curl (nghttp2) against the std.http server over
// h2c with prior knowledge and over TLS with ALPN, plain HTTP/1 on the
// same listener, and std's HTTP/2 client with concurrent streams.
عرف اختبر_ويب2_حي(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الاسم: نص = «HTTP/2 حي: curl وعميل std عبر h2c وTLS (ALPN)»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        دع المطلوب: نص = «x86_64-linux»;
        لو (!نصان_متساويان(&الهدف, &المطلوب)) {
            دع سبب: نص = «الاختبار حي ومخصص لـ Linux x86_64»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        دع سبب: نص = «هدف مضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    دع تحقق_الأدوات: نص = «command -v openssl >/dev/null 2>&1 && curl -V 2>/dev/null | grep -q HTTP2»;
    دع اسم_الأدوات: نص = «h2-tools»;
    دع ج_الأدوات: نتيجة_أمر = نفذ_نص_شل(&تحقق_الأدوات, &اسم_الأدوات);
    لو (ج_الأدوات.الحالة != 0) {
        دع سبب: نص = «curl بدعم HTTP/2 أو openssl غير متاح»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };
    لو (!جهز_شهادة_تي_إل_إس()) {
        دع سبب: نص = «تعذر توليد شهادة TLS المحلية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    دع خادم_مصدر: نص = «tests/en/runtime/network/http2_live_server.sn»;
    دع عميل_مصدر: نص = «tests/en/runtime/network/http2_live_client.sn»;
    دع خادم: نص = «build/tests-sultanc/http2_live_server»;
    دع عميل: نص = «build/tests-sultanc/http2_live_client»;
    دع اسم_بناء_خادم: نص = «h2-build-server»;
    دع اسم_بناء_عميل: نص = «h2-build-client»;
    لو ((!ابن_تنفيذي_للمضيف(&خادم_مصدر, &خادم, &اسم_بناء_خادم)) || (!ابن_تنفيذي_للمضيف(&عميل_مصدر, &عميل, &اسم_بناء_عميل))) {
        دع سبب: نص = «تعذر بناء خادم أو عميل HTTP/2»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    دع النص: نص = «S=build/tests-sultanc/http2_live_server; C=build/tests-sultanc/http2_live_client; T=/tmp/sultanc_tls_test
P=$((40000 + $$ % 1000)); Q=$((P + 1000))
$S $P 4 & PS=$!; sleep 0.3
[ "$(timeout 20 curl -s --http2-prior-knowledge http://127.0.0.1:$P/x)" = "h2 GET /x 0" ] || { kill $PS; exit 11; }
[ "$(timeout 20 curl -s --http2-prior-knowledge -d hello http://127.0.0.1:$P/p)" = "h2 POST /p 5" ] || { kill $PS; exit 12; }
[ "$(timeout 20 curl -s http://127.0.0.1:$P/y)" = "h1 GET /y 0" ] || { kill $PS; exit 13; }
timeout 30 $C http://127.0.0.1:$P/; [ $? = 42 ] || { kill $PS; exit 14; }
wait $PS; [ $? = 42 ] || exit 15
$S $Q 3 $T/server.p12 sultanc-test & PT=$!; sleep 0.3
[ "$(timeout 20 curl -sk --http2 https://127.0.0.1:$Q/x)" = "h2 GET /x 0" ] || { kill $PT; exit 21; }
[ "$(timeout 20 curl -sk --http1.1 https://127.0.0.1:$Q/y)" = "h1 GET /y 0" ] || { kill $PT; exit 22; }
timeout 30 $C https://127.0.0.1:$Q/ $T/server.der; [ $? = 42 ] || { kill $PT; exit 23; }
wait $PT; [ $? = 42 ] || exit 24
exit 0»;
    دع اسم_التشغيل: نص = «h2-live»;
    دع ج: نتيجة_أمر = نفذ_نص_شل(&النص, &اسم_التشغيل);
    لو (ج.الحالة == 0) { سجل_نجاح(الملخص, &الاسم); }
    وإلا {
        دع سبب: نص = «فشل تبادل HTTP/2 الحي مع curl أو عميل std»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    };
}

عرف نمو_مئوي_يتجاوز(القديم: طبيعي, الجديد: طبيعي, الحد: طبيعي): منطقي {
    لو (القديم == 0) { أرجع صواب; };
    لو (الجديد <= القديم) { أرجع خطأ; };
    دع الزيادة: طبيعي = الجديد - القديم;
    أرجع (الزيادة * 100) > (القديم * الحد);
}

عرف اختبر_بوابة_الذاكرة_المقيمة(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الاسم: نص = «بوابة انحدار RSS والزمن»;
    دع مقبول: منطقي =
        (!نمو_مئوي_يتجاوز(1000000000, 1100000000, 20))
        && (!نمو_مئوي_يتجاوز(1500000000, 1700000000, 20))
        && (!نمو_مئوي_يتجاوز(1800000000, 2100000000, 20))
        && (!نمو_مئوي_يتجاوز(1000, 1100, 30));
    دع مرفوض: منطقي =
        نمو_مئوي_يتجاوز(1000000000, 1350000000, 20)
        || نمو_مئوي_يتجاوز(1800000000, 2500000000, 20)
        || نمو_مئوي_يتجاوز(1000, 1400, 30);
    لو (مقبول && مرفوض) { سجل_نجاح(الملخص, &الاسم); }
    وإلا {
        دع سبب: نص = «حساب حدود الانحدار لا يميز العينة المقبولة والمرفوضة»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    };
}

عرف رقم_بعد_علامة(النص: &نص, العلامة: &نص): اختياري طبيعي {
    طابق ابحث_نصا(النص, العلامة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        دع ف: متغير طبيعي = م + (الطول(*العلامة) مثل طبيعي);
        دع ك: طبيعي = الطول(*النص) مثل طبيعي;
        طالما ((ف < ك) && (((*النص)[ف] < 0x30) || ((*النص)[ف] > 0x39))) { ف := ف + 1; };
        لو (ف >= ك) { أرجع اختياري.لا_شيء(); };
        دع ن: متغير طبيعي = ف;
        طالما ((ن < ك) && ((*النص)[ن] >= 0x30) && ((*النص)[ن] <= 0x39)) { ن := ن + 1; };
        دع رقم: متغير نص = «»;
        طابق مقطع_نص(النص, ف, ن - ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المقطع) -> { رقم := المقطع; };
        طابق حلل_طبيعي(&رقم) مع
        | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف رقم_قبل_علامة(النص: &نص, العلامة: &نص): اختياري طبيعي {
    طابق ابحث_نصا(النص, العلامة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(م) -> {
        لو (م == 0) { أرجع اختياري.لا_شيء(); };
        دع ف: متغير طبيعي = م;
        طالما ((ف > 0) && (((*النص)[ف - 1] < 0x30) || ((*النص)[ف - 1] > 0x39))) { ف := ف - 1; };
        دع نهاية: طبيعي = ف;
        طالما ((ف > 0) && ((*النص)[ف - 1] >= 0x30) && ((*النص)[ف - 1] <= 0x39)) { ف := ف - 1; };
        لو (ف == نهاية) { أرجع اختياري.لا_شيء(); };
        دع رقم: متغير نص = «»;
        طابق مقطع_نص(النص, ف, نهاية - ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المقطع) -> { رقم := المقطع; };
        طابق حلل_طبيعي(&رقم) مع
        | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    };
}

عرف استخرج_ذروة_الذاكرة_المقيمة(النتيجة: &نتيجة_أمر): اختياري طبيعي {
    دع علامة_داروين: نص = «maximum resident set size»;
    دع علامة_لينكس: نص = «Maximum resident set size (kbytes)»;
    دع قيمة: متغير اختياري طبيعي = رقم_قبل_علامة(&(*النتيجة).الخطأ, &علامة_داروين);
    طابق قيمة مع
    | اختياري.لا_شيء -> {
        طابق رقم_بعد_علامة(&(*النتيجة).الخطأ, &علامة_لينكس) مع
        | اختياري.موجود(كيلو) -> { قيمة := اختياري.موجود(كيلو * 1024); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };
    أرجع قيمة;
}

عرف قس_أمر_الذاكرة_المقيمة(الأمر: &نص, الاسم: &نص): اختياري طبيعي {
    دع بادئة: متغير نص = «/usr/bin/time -l »;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        دع لينكس: نص = «x86_64-linux»;
        لو (نصان_متساويان(&الهدف, &لينكس)) { بادئة := «/usr/bin/time -v »; };
    }
    | _ -> { };
    دع أجزاء: متجه نص = [بادئة, استنسخ(الأمر)];
    دع كامل: نص = اجمع_نصوص(&أجزاء);
    دع نتيجة: نتيجة_أمر = نفذ_نص_شل(&كامل, الاسم);
    لو (نتيجة.الحالة != 0) { أرجع اختياري.لا_شيء(); };
    أرجع استخرج_ذروة_الذاكرة_المقيمة(&نتيجة);
}

عرف اختبر_قياس_الذاكرة_المقيمة(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_بيئة: نص = «SULTANC_TEST_RSS»;
    دع صفر: نص = «0»;
    دع مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    دع واحد: نص = «1»;
    دع الاسم: نص = «قياس RSS لمسارات check/object/executable»;
    لو (!نصان_متساويان(&مفعل, &واحد)) {
        دع سبب: نص = «فعّل SULTANC_TEST_RSS=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> {
        دع سبب: نص = «هدف المضيف غير مدعوم لقياس RSS»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | اختياري.موجود(الهدف) -> {
        دع المترجم: نص = مسار_المترجم();
        دع مترجم_شل: نص = اقتبس_لشل(&المترجم);
        دع هدف_شل: نص = اقتبس_لشل(&الهدف);
        دع أمر_فحص_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « check compiler/main.sn»];
        دع أمر_كائن_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « -c compiler/main.sn --target=», انسخ_نص_اختبار(&هدف_شل), « -o build/tests-sultanc/rss-profile.o»];
        دع أمر_تنفيذي_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « compiler/main.sn --target=», انسخ_نص_اختبار(&هدف_شل), « -o build/tests-sultanc/rss-profile-executable»];
        دع أمر_فحص: نص = اجمع_نصوص(&أمر_فحص_أجزاء);
        دع أمر_كائن: نص = اجمع_نصوص(&أمر_كائن_أجزاء);
        دع أمر_تنفيذي: نص = اجمع_نصوص(&أمر_تنفيذي_أجزاء);
        دع ن1: نص = «rss-check»;
        دع ن2: نص = «rss-object»;
        دع ن3: نص = «rss-executable»;
        دع فحص: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_فحص, &ن1);
        دع كائن: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_كائن, &ن2);
        دع تنفيذي: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_تنفيذي, &ن3);

        طابق فحص مع
        | اختياري.لا_شيء -> {
            دع سبب: نص = «تعذر قياس RSS لمسار check»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };
        طابق كائن مع
        | اختياري.لا_شيء -> {
            دع سبب: نص = «تعذر قياس RSS لمسار object»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };
        طابق تنفيذي مع
        | اختياري.لا_شيء -> {
            دع سبب: نص = «تعذر قياس RSS لمسار executable»;
            سجل_فشل(الملخص, &الاسم, &سبب);
            أرجع;
        }
        | _ -> { };

        سجل_نجاح(الملخص, &الاسم);
    };
}

عرف أول_عدد_في_نص(النص: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    دع ك: طبيعي = الطول(*النص) مثل طبيعي;
    طالما ((ف < ك) && (((*النص)[ف] < 0x30) || ((*النص)[ف] > 0x39))) { ف := ف + 1; };
    لو (ف >= ك) { أرجع اختياري.لا_شيء(); };
    دع ن: متغير طبيعي = ف;
    طالما ((ن < ك) && ((*النص)[ن] >= 0x30) && ((*النص)[ن] <= 0x39)) { ن := ن + 1; };
    دع رقم: متغير نص = «»;
    طابق مقطع_نص(النص, ف, ن - ف) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقطع) -> { رقم := المقطع; };
    طابق حلل_طبيعي(&رقم) مع
    | نتيجة.نجح(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

عرف ذاكرة_عملية_مقيمة(المعرف: عدد): اختياري طبيعي {
    دع رقم: نص = عدد_إلى_نص(المعرف);
    دع برنامج: نص = «/bin/ps»;
    دع وسائط: متجه نص = [«-o», «rss=», «-p», انسخ_نص_اختبار(&رقم)];
    دع اسم: نص = «allocation-ps»;
    دع نتيجة: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط, &اسم);
    لو (نتيجة.الحالة != 0) { أرجع اختياري.لا_شيء(); };
    طابق أول_عدد_في_نص(&نتيجة.الخرج) مع
    | اختياري.موجود(كيلو) -> { أرجع اختياري.موجود(كيلو * 1024); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف أرسل_إشارة(المعرف: عدد, الإشارة: &نص): منطقي {
    دع رقم: نص = عدد_إلى_نص(المعرف);
    دع برنامج: نص = «/bin/kill»;
    دع وسائط: متجه نص = [استنسخ(الإشارة), انسخ_نص_اختبار(&رقم)];
    دع اسم: نص = «allocation-signal»;
    دع نتيجة: نتيجة_أمر = نفذ_أمرا(&برنامج, &وسائط, &اسم);
    أرجع نتيجة.الحالة == 0;
}

عرف اختبر_ملف_غير_فارغ(المسار: &نص): منطقي {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(ب) -> { أرجع الطول(ب) > 0; };
}

عرف اختبر_تخصيصات_داروين(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_بيئة: نص = «SULTANC_TEST_ALLOCATIONS»;
    دع صفر: نص = «0»;
    دع مفعل: نص = قيمة_متغير_بيئة_أو(&اسم_بيئة, &صفر);
    دع واحد: نص = «1»;
    دع الاسم: نص = «ملف تخصيصات malloc_history عند ذروة الذاكرة»;
    لو (!نصان_متساويان(&مفعل, &واحد)) {
        دع سبب: نص = «فعّل SULTANC_TEST_ALLOCATIONS=1»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    طابق الهدف_المضيف() مع
    | اختياري.موجود(الهدف) -> {
        دع المطلوب: نص = «arm64-darwin»;
        لو (!نصان_متساويان(&الهدف, &المطلوب)) {
            دع سبب: نص = «malloc_history متاح فقط على Darwin»;
            سجل_تجاوز(الملخص, &الاسم, &سبب);
            أرجع;
        };
    }
    | _ -> {
        دع سبب: نص = «هدف المضيف غير مدعوم»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع تحقق_أدوات: نص = «test -x /usr/bin/malloc_history && test -x /usr/bin/vmmap && test -x /bin/ps && test -x /bin/kill»;
    دع اسم_أدوات: نص = «allocation-tools»;
    دع أدوات: نتيجة_أمر = نفذ_نص_شل(&تحقق_أدوات, &اسم_أدوات);
    لو (أدوات.الحالة != 0) {
        دع سبب: نص = «أدوات malloc_history/vmmap غير متاحة»;
        سجل_تجاوز(الملخص, &الاسم, &سبب);
        أرجع;
    };

    دع المترجم: نص = مسار_المترجم();
    دع مترجم_شل: نص = اقتبس_لشل(&المترجم);
    دع أمر_أساس_أجزاء: متجه نص = [انسخ_نص_اختبار(&مترجم_شل), « -c compiler/main.sn --target=arm64-darwin -o build/tests-sultanc/allocation-baseline.o»];
    دع أمر_أساس: نص = اجمع_نصوص(&أمر_أساس_أجزاء);
    دع اسم_أساس: نص = «allocation-baseline»;
    دع ذروة_اختيار: اختياري طبيعي = قس_أمر_الذاكرة_المقيمة(&أمر_أساس, &اسم_أساس);
    دع ذروة: متغير طبيعي = 0;
    طابق ذروة_اختيار مع
    | اختياري.موجود(القيمة) -> { ذروة := القيمة; }
    | اختياري.لا_شيء -> {
        دع سبب: نص = «تعذر قياس ذروة RSS الأساسية»;
        سجل_فشل(الملخص, &الاسم, &سبب);
        أرجع;
    };
    دع عتبة: طبيعي = (ذروة * 90) / 100;

    دع أمر_عميق_أجزاء: متجه نص = [
        «exec env MallocStackLogging=1 », مترجم_شل,
        « -c compiler/main.sn --target=arm64-darwin -o build/tests-sultanc/allocation-deep.o >build/tests-sultanc/allocation.stdout 2>build/tests-sultanc/allocation.stderr»
    ];
    دع أمر_عميق: نص = اجمع_نصوص(&أمر_عميق_أجزاء);
    دع شل: نص = «/bin/sh»;
    دع وسائط_شل: متجه نص = [«-c», أمر_عميق];

    طابق شغل_عملية(&شل, &وسائط_شل) مع
    | نتيجة.خطأ(_) -> {
        دع سبب: نص = «تعذر تشغيل قياس التخصيصات»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(الطفل) -> {
        دع التقط: متغير منطقي = خطأ;
        دع انتهى_مبكرا: متغير منطقي = خطأ;
        دع دورة: متغير عدد = 0;
        طالما ((!التقط) && (!انتهى_مبكرا) && (دورة < 1500)) {
            طابق ذاكرة_عملية_مقيمة(الطفل.المعرف) مع
            | اختياري.لا_شيء -> { انتهى_مبكرا := صواب; }
            | اختياري.موجود(الحالي) -> {
                لو ((الحالي > 0) && (الحالي >= عتبة)) {
                    دع توقف: نص = «-STOP»;
                    لو (أرسل_إشارة(الطفل.المعرف, &توقف)) {
                        دع رقم: نص = عدد_إلى_نص(الطفل.المعرف);
                        دع برنامج_تاريخ: نص = «/usr/bin/malloc_history»;
                        دع برنامج_خريطة: نص = «/usr/bin/vmmap»;
                        دع وسائط_تاريخ: متجه نص = [انسخ_نص_اختبار(&رقم), «-allBySize», «-highWaterMark»];
                        دع وسائط_شجرة: متجه نص = [انسخ_نص_اختبار(&رقم), «-callTree», «-highWaterMark», «-invert», «-ignoreThreads»];
                        دع وسائط_خريطة: متجه نص = [«-summary», انسخ_نص_اختبار(&رقم)];
                        دع م1: نص = «allocation-history»;
                        دع م2: نص = «allocation-calltree»;
                        دع م3: نص = «allocation-vmmap»;
                        دع ت1: نتيجة_أمر = نفذ_أمرا(&برنامج_تاريخ, &وسائط_تاريخ, &م1);
                        دع ت2: نتيجة_أمر = نفذ_أمرا(&برنامج_تاريخ, &وسائط_شجرة, &م2);
                        دع ت3: نتيجة_أمر = نفذ_أمرا(&برنامج_خريطة, &وسائط_خريطة, &م3);
                        دع ملف1: نص = «build/tests-sultanc/malloc-history-high-water.txt»;
                        دع ملف2: نص = «build/tests-sultanc/malloc-history-calltree.txt»;
                        دع ملف3: نص = «build/tests-sultanc/vmmap-summary.txt»;
                        دع نجح_كتابة: متغير منطقي = صواب;
                        طابق اكتب_الملف(&ملف1, &ت1.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        طابق اكتب_الملف(&ملف2, &ت2.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        طابق اكتب_الملف(&ملف3, &ت3.الخرج) مع | نتيجة.نجح(_) -> { } | نتيجة.خطأ(_) -> { نجح_كتابة := خطأ; };
                        دع استمر: نص = «-CONT»;
                        دع تجاهل_استمرار: منطقي = أرسل_إشارة(الطفل.المعرف, &استمر);
                        التقط := نجح_كتابة
                            && (ت1.الحالة == 0) && (ت2.الحالة == 0) && (ت3.الحالة == 0)
                            && اختبر_ملف_غير_فارغ(&ملف1)
                            && اختبر_ملف_غير_فارغ(&ملف2)
                            && اختبر_ملف_غير_فارغ(&ملف3);
                    };
                };
            };
            لو ((!التقط) && (!انتهى_مبكرا)) { نم_قليلا(20); };
            دورة := دورة + 1;
        }

        دع حالة: متغير عدد = -1;
        طابق انتظر_عملية(&الطفل) مع
        | نتيجة.نجح(نهاية) -> { حالة := رمز_إنهاء(&نهاية); }
        | نتيجة.خطأ(_) -> { };

        لو (التقط && (حالة == 0)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            دع سبب: نص = «لم تلتقط تقارير التخصيصات عند عتبة الذروة أو فشل التجميع»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
    };
}

عام عرف اختبر_النظام(الملخص: &متغير ملخص_اختبارات): فراغ {
    اختبر_بوابة_الذاكرة_المقيمة(الملخص);
    اختبر_قياس_الذاكرة_المقيمة(الملخص);
    اختبر_تخصيصات_داروين(الملخص);
    اختبر_تي_سي_بي_داروين(الملخص);
    اختبر_تي_إل_إس_داروين(الملخص);
    اختبر_ويب2_حي(الملخص);
    اختبر_التقارب(الملخص);
}
