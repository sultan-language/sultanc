استورد "../common.sn";
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.fs.write_file;

عام نوع أسلوب_طفرة =
    | استبدال
    | بتر
    | حذف_آخر
;

عام نوع طفرة_مصدر = {
    المصدر: نص,
    الاسم: نص,
    الأسلوب: أسلوب_طفرة,
    العلامة: نص,
    البديل: نص
};

عرف يطابق_عند(النص: &نص, العلامة: &نص, الموضع: طبيعي): منطقي {
    دع ن: طبيعي = الطول(*العلامة) مثل طبيعي;
    دع ك: طبيعي = الطول(*النص) مثل طبيعي;
    لو ((الموضع + ن) > ك) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < ن) {
        لو ((*النص)[الموضع + ف] != (*العلامة)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف آخر_موضع(النص: &نص, العلامة: &نص): اختياري طبيعي {
    دع ك: طبيعي = الطول(*النص) مثل طبيعي;
    دع ن: طبيعي = الطول(*العلامة) مثل طبيعي;
    لو ((ن == 0) || (ن > ك)) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    دع وجد: متغير اختياري طبيعي = اختياري.لا_شيء();
    طالما ((ف + ن) <= ك) {
        لو (يطابق_عند(النص, العلامة, ف)) { وجد := اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع وجد;
}

عرف ركّب_ثلاثة(أ: &نص, ب: &نص, ج: &نص): نص {
    دع أجزاء: متجه نص = [استنسخ(أ), استنسخ(ب), استنسخ(ج)];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف طبق_طفرة(المصدر: &نص, الطفرة: &طفرة_مصدر): اختياري نص {
    دع الموضع: متغير اختياري طبيعي = اختياري.لا_شيء();
    طابق (*الطفرة).الأسلوب مع
    | أسلوب_طفرة.حذف_آخر -> { الموضع := آخر_موضع(المصدر, &(*الطفرة).العلامة); }
    | _ -> { الموضع := ابحث_نصا(المصدر, &(*الطفرة).العلامة); };

    طابق الموضع مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(بداية) -> {
        دع قبل: متغير نص = «»;
        طابق مقطع_نص(المصدر, 0, بداية) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المقطع) -> { قبل := المقطع; };
        دع نهاية_علامة: طبيعي = بداية + (الطول((*الطفرة).العلامة) مثل طبيعي);
        طابق (*الطفرة).الأسلوب مع
        | أسلوب_طفرة.بتر -> {
            أرجع اختياري.موجود(ركّب_ثلاثة(&قبل, &(*الطفرة).العلامة, &(*الطفرة).البديل));
        }
        | أسلوب_طفرة.استبدال -> {
            دع بعد: متغير نص = «»;
            طابق مقطع_نص(المصدر, نهاية_علامة, (الطول(*المصدر) مثل طبيعي) - نهاية_علامة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المقطع) -> { بعد := المقطع; };
            أرجع اختياري.موجود(ركّب_ثلاثة(&قبل, &(*الطفرة).البديل, &بعد));
        }
        | أسلوب_طفرة.حذف_آخر -> {
            دع بعد: متغير نص = «»;
            طابق مقطع_نص(المصدر, نهاية_علامة, (الطول(*المصدر) مثل طبيعي) - نهاية_علامة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المقطع) -> { بعد := المقطع; };
            دع نص_فارغ: نص = «»;
            أرجع اختياري.موجود(ركّب_ثلاثة(&قبل, &نص_فارغ, &بعد));
        };
    };
}

عرف الطفرات(): متجه طفرة_مصدر {
    دع رجوع: نص = «tests/en/torture/functions/recursion_accumulator.sn»;
    دع نداءات: نص = «tests/en/torture/functions/nested_call_reuse.sn»;
    دع عموميات: نص = «tests/en/torture/generics/generic_multi_instantiation.sn»;
    دع اتحاد: نص = «tests/en/torture/records_adts/adt_record_pattern.sn»;
    دع متجه: نص = «tests/en/torture/collections/vector_record_mix.sn»;
    دع نصوص: نص = «tests/en/torture/strings/escaped_and_raw.sn»;
    دع وحدة: نص = «tests/en/torture/modules/main.sn»;
    دع تحويلات: نص = «tests/en/torture/integers/signed_width_cast_chain.sn»;
    دع سجلات: نص = «tests/en/torture/records_adts/nested_record_destructure.sn»;

    دع الناتج: متغير متجه طفرة_مصدر = [];
    دع طفرة_1: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&رجوع), الاسم: «قوس إغلاق مفقود», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «if (sum_down(9, 0) != 45) {», البديل: «if (sum_down(9, 0) != 45 {» };
    ألحق(الناتج, طفرة_1);
    دع طفرة_2: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&رجوع), الاسم: «قوس كتلة أخير مفقود», الأسلوب: أسلوب_طفرة.حذف_آخر(), العلامة: «}», البديل: «» };
    ألحق(الناتج, طفرة_2);
    دع طفرة_3: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نداءات), الاسم: «تعريف دالة مبتور», الأسلوب: أسلوب_طفرة.بتر(), العلامة: «def add(a: int, b», البديل: «» };
    ألحق(الناتج, طفرة_3);
    دع طفرة_4: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&عموميات), الاسم: «معامل عام مبتور», الأسلوب: أسلوب_طفرة.بتر(), العلامة: «def identity<T», البديل: «» };
    ألحق(الناتج, طفرة_4);
    دع طفرة_5: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نداءات), الاسم: «فاصلة معامل مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «a: int, b: int», البديل: «a: int b: int» };
    ألحق(الناتج, طفرة_5);
    دع طفرة_6: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&متجه), الاسم: «فاصلة قائمة مزدوجة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «[10, 20]», البديل: «[10,, 20]» };
    ألحق(الناتج, طفرة_6);
    دع طفرة_7: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&اتحاد), الاسم: «سهم مطابقة تالف», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «-> { return 1; }», البديل: «=> { return 1; }» };
    ألحق(الناتج, طفرة_7);
    دع طفرة_8: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&اتحاد), الاسم: «حمولة نمط مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «Choice.PairValue({ left: a, right: b })», البديل: «Choice.PairValue()» };
    ألحق(الناتج, طفرة_8);
    دع طفرة_9: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&سجلات), الاسم: «سجل حرفي مبتور», الأسلوب: أسلوب_طفرة.بتر(), العلامة: «let left: Point = { x: 10,», البديل: «» };
    ألحق(الناتج, طفرة_9);
    دع طفرة_10: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نداءات), الاسم: «نقطتا نوع مزدوجتان», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «let first: int», البديل: «let first:: int» };
    ألحق(الناتج, طفرة_10);
    دع طفرة_11: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نداءات), الاسم: «فاصلة منقوطة مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «return a + b;», البديل: «return a + b» };
    ألحق(الناتج, طفرة_11);
    دع طفرة_12: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نصوص), الاسم: «إغلاق نص خام مفقود», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: ««alpha beta»», البديل: "«alpha beta" };
    ألحق(الناتج, طفرة_12);
    دع طفرة_13: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&وحدة), الاسم: «استيراد تالف», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «import "helper.sn";», البديل: «import ;» };
    ألحق(الناتج, طفرة_13);
    دع طفرة_14: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&رجوع), الاسم: «نداء مبتور», الأسلوب: أسلوب_طفرة.بتر(), العلامة: «sum_down(9,», البديل: «» };
    ألحق(الناتج, طفرة_14);
    دع طفرة_15: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&تحويلات), الاسم: «نوع تحويل مفقود», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «value as i8», البديل: «value as» };
    ألحق(الناتج, طفرة_15);
    دع طفرة_16: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&رجوع), الاسم: «قيمة رجوع مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «return 42;», البديل: «return ;» };
    ألحق(الناتج, طفرة_16);
    دع طفرة_17: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&اتحاد), الاسم: «فاصل ذراع مطابقة مزدوج», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «| Choice.Empty», البديل: «| | Choice.Empty» };
    ألحق(الناتج, طفرة_17);
    دع طفرة_18: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&نداءات), الاسم: «فاصلة نداء مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «mix(4, 5, 1)», البديل: «mix(4 5, 1)» };
    ألحق(الناتج, طفرة_18);
    دع طفرة_19: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&اتحاد), الاسم: «فاصلة نمط سجل مفقودة», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «{ left: a, right: b }», البديل: «{ left: a right: b }» };
    ألحق(الناتج, طفرة_19);
    دع طفرة_20: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&عموميات), الاسم: «إغلاق عام مفقود», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «identity<T>», البديل: «identity<T» };
    ألحق(الناتج, طفرة_20);
    دع طفرة_21: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&عموميات), الاسم: «تعليق نوع عام تالف», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «let number: int», البديل: «let number:: int» };
    ألحق(الناتج, طفرة_21);
    دع طفرة_22: طفرة_مصدر = { المصدر: انسخ_نص_اختبار(&سجلات), الاسم: «موضوع مطابقة مبتور», الأسلوب: أسلوب_طفرة.استبدال(), العلامة: «match region.start with», البديل: «match region.start» };
    ألحق(الناتج, طفرة_22);
    أرجع الناتج;
}

عرف اختبر_طفرة(
    الملخص: &متغير ملخص_اختبارات,
    الطفرة: &طفرة_مصدر,
    الفهرس: طبيعي
): فراغ {
    دع الأصل: نص = اقرأ_إن_وجد(&(*الطفرة).المصدر);
    لو (الطول(الأصل) == 0) {
        دع سبب: نص = «مصدر الطفرة غير موجود أو فارغ»;
        سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
        أرجع;
    };

    طابق طبق_طفرة(&الأصل, الطفرة) مع
    | اختياري.لا_شيء -> {
        دع سبب: نص = «علامة الطفرة غير موجودة في المصدر»;
        سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
    }
    | اختياري.موجود(المتحور) -> {
        دع أجزاء: متجه نص = [«build/tests-sultanc/mutation-», طبيعي_إلى_نص(الفهرس), «.sn»];
        دع المسار: نص = اجمع_نصوص(&أجزاء);
        طابق اكتب_الملف(&المسار, &المتحور) مع
        | نتيجة.خطأ(_) -> {
            دع سبب: نص = «تعذر كتابة المصدر المتحور»;
            سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
        }
        | نتيجة.نجح(_) -> {
            دع و: متجه نص = [«--lang», «en», «check», المسار];
            دع المترجم: نص = مسار_المترجم();
            دع اسم_تشغيل: متجه نص = [«mutation-», طبيعي_إلى_نص(الفهرس)];
            دع اسم: نص = اجمع_نصوص(&اسم_تشغيل);
            دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, &و, &اسم);
            دع بادئة_تشخيص: نص = «SULTANC-»;
            لو (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
                دع سبب: نص = «المصدر المشوه سبب فشلا داخليا»;
                سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
            } وإلا لو (النتيجة.الحالة == 0) {
                دع سبب: نص = «المصدر المشوه قُبل»;
                سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
            } وإلا لو ((!يحتوي_نصا(&النتيجة.الخطأ, &بادئة_تشخيص)) && (!يحتوي_نصا(&النتيجة.الخرج, &بادئة_تشخيص))) {
                دع سبب: نص = «الرفض لا يحمل معرف تشخيص سلطان»;
                سجل_فشل(الملخص, &(*الطفرة).الاسم, &سبب);
            } وإلا {
                سجل_نجاح(الملخص, &(*الطفرة).الاسم);
            };
        };
    };
}

عرف ابن_تعشيقا_عميقا(العمق: طبيعي): نص {
    دع بداية: نص = «def id(value: int): int { return value; }

def main(): int {
    let value: int = »;
    دع نهاية: نص = «;
    if (value == 42) { return 42; };
    return 1;
}
»;
    دع أجزاء: متغير متجه نص = [بداية];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العمق) { ألحق(أجزاء, «id(»); ف := ف + 1; };
    ألحق(أجزاء, «42»);
    ف := 0;
    طالما (ف < العمق) { ألحق(أجزاء, «)»); ف := ف + 1; };
    ألحق(أجزاء, نهاية);
    أرجع اجمع_نصوص(&أجزاء);
}

عرف اختبر_التعشيق(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الاسم: نص = «تعشيق نداءات بعمق 184 بلا انهيار»;
    دع المصدر: نص = ابن_تعشيقا_عميقا(184);
    دع المسار: نص = «build/tests-sultanc/deep-nesting.sn»;
    طابق اكتب_الملف(&المسار, &المصدر) مع
    | نتيجة.خطأ(_) -> {
        دع سبب: نص = «تعذر إنشاء حالة التعشيق»;
        سجل_فشل(الملخص, &الاسم, &سبب);
    }
    | نتيجة.نجح(_) -> {
        دع و: متجه نص = [«check», المسار];
        دع المترجم: نص = مسار_المترجم();
        دع اسم_أمر: نص = «deep-nesting»;
        دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, &و, &اسم_أمر);
        لو ((النتيجة.الإشارة != 0) || (النتيجة.الحالة == 4) || نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
            دع سبب: نص = «التعشيق العميق سبب انهيارا أو فشلا داخليا»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        } وإلا {
            سجل_نجاح(الملخص, &الاسم);
        };
    };
}

// تحرير عنوان ليس كتلة حية داخل الكومة يوقف البرنامج بفخ (std os/allocation.sn).
عرف مصدر_تحرير_فاسد(السطر: &نص): نص {
    دع أجزاء: متجه نص = [
        «استورد std.os.allocation;
استورد std.io.println;

عرف الرئيسية(): عدد {
    دع أ: غ64 = خصص_ذاكرة_التشغيل(100000);
    دع ب: غ64 = خصص_ذاكرة_التشغيل(48);
    دع ج: غ64 = خصص_ذاكرة_التشغيل(48);
    »,
        انسخ_نص_اختبار(السطر),
        «
    اطبع_سطر("not reached");
    أرجع 0;
}
»
    ];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف اختبر_تحريرا_فاسدا(الملخص: &متغير ملخص_اختبارات, الاسم: &نص, السطر: &نص, الفهرس: طبيعي): فراغ {
    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> {
        دع سبب: نص = «هدف المضيف غير مدعوم»;
        سجل_تجاوز(الملخص, الاسم, &سبب);
    }
    | اختياري.موجود(المضيف) -> {
        دع لاحقة: نص = طبيعي_إلى_نص(الفهرس);
        دع أجزاء_المسار: متجه نص = [«build/tests-sultanc/bad-free-», انسخ_نص_اختبار(&لاحقة), «.sn»];
        دع المسار: نص = اجمع_نصوص(&أجزاء_المسار);
        دع أجزاء_التنفيذي: متجه نص = [«build/tests-sultanc/bad-free-», انسخ_نص_اختبار(&لاحقة)];
        دع التنفيذي: نص = اجمع_نصوص(&أجزاء_التنفيذي);
        دع المصدر: نص = مصدر_تحرير_فاسد(السطر);
        طابق اكتب_الملف(&المسار, &المصدر) مع
        | نتيجة.خطأ(_) -> {
            دع سبب: نص = «تعذر إنشاء حالة التحرير الفاسد»;
            سجل_فشل(الملخص, الاسم, &سبب);
        }
        | نتيجة.نجح(_) -> {
            دع المترجم: نص = مسار_المترجم();
            دع و: متجه نص = [«--target», انسخ_نص_اختبار(&المضيف), انسخ_نص_اختبار(&المسار), «-o», انسخ_نص_اختبار(&التنفيذي)];
            دع اسم_جمع: نص = «bad-free-build»;
            دع جمع: نتيجة_أمر = نفذ_أمرا(&المترجم, &و, &اسم_جمع);
            لو (جمع.الحالة != 0) {
                دع سبب: نص = «تعذر بناء حالة التحرير الفاسد»;
                سجل_فشل(الملخص, الاسم, &سبب);
            } وإلا {
                دع لا_وسائط: متجه نص = [];
                دع اسم_تشغيل: نص = «bad-free-run»;
                دع تشغيل: نتيجة_أمر = نفذ_أمرا(&التنفيذي, &لا_وسائط, &اسم_تشغيل);
                دع لم_يصل: نص = «not reached»;
                لو (تشغيل.الإشارة == 0 || يحتوي_نصا(&تشغيل.الخرج, &لم_يصل)) {
                    دع سبب: نص = «التحرير الفاسد لم يوقف البرنامج بفخ»;
                    سجل_فشل(الملخص, الاسم, &سبب);
                } وإلا {
                    سجل_نجاح(الملخص, الاسم);
                };
            };
        };
    };
}

عرف اختبر_التحرير_الفاسد(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_أ: نص = «تحرير كتلة كبيرة مرتين يوقف البرنامج»;
    دع سطر_أ: نص = «حرر_ذاكرة_التشغيل(أ); حرر_ذاكرة_التشغيل(أ);»;
    اختبر_تحريرا_فاسدا(الملخص, &اسم_أ, &سطر_أ, 1);
    دع اسم_ب: نص = «تحرير كتلة صغيرة مرتين يوقف البرنامج»;
    دع سطر_ب: نص = «حرر_ذاكرة_التشغيل(ب); حرر_ذاكرة_التشغيل(ب);»;
    اختبر_تحريرا_فاسدا(الملخص, &اسم_ب, &سطر_ب, 2);
    دع اسم_ج: نص = «تحرير عنوان داخل كتلة يوقف البرنامج»;
    دع سطر_ج: نص = «حرر_ذاكرة_التشغيل(أ + 16);»;
    اختبر_تحريرا_فاسدا(الملخص, &اسم_ج, &سطر_ج, 3);
    دع اسم_د: نص = «تحرير عنوان بعد قمة الكومة يوقف البرنامج»;
    دع سطر_د: نص = «حرر_ذاكرة_التشغيل(ج + 4096);»;
    اختبر_تحريرا_فاسدا(الملخص, &اسم_د, &سطر_د, 4);
}

عام عرف اختبر_المتانة(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الحالات: متجه طفرة_مصدر = الطفرات();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الحالات) مثل طبيعي)) {
        اختبر_طفرة(الملخص, &الحالات[ف], ف);
        ف := ف + 1;
    }
    اختبر_التعشيق(الملخص);
    اختبر_التحرير_الفاسد(الملخص);
}
