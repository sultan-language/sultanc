استورد "../common.sn";
استورد std.text.search;
استورد std.text.compare;
استورد std.text.from_bytes;

عرف تحقق_أمر(
    الملخص: &متغير ملخص_اختبارات,
    الاسم: &نص,
    الوسائط: &متجه نص,
    الحالة: عدد,
    العلامة: &نص,
    في_الخطأ: منطقي
): نتيجة_أمر {
    ليكن المترجم: نص = مسار_المترجم();
    ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, الوسائط, الاسم);
    ليكن النص: متغير نص = انسخ_نص_اختبار(&النتيجة.الخرج);
    إذا (في_الخطأ) { النص := انسخ_نص_اختبار(&النتيجة.الخطأ); };
    إذا (النتيجة.الحالة != الحالة) {
        ليكن سبب: نص = «حالة أمر المترجم لا تطابق المتوقع»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا إذا (!يحتوي_نصا(&النص, العلامة)) {
        ليكن سبب: نص = «خرج أمر المترجم لا يحتوي العلامة المطلوبة»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, الاسم);
    };
    أرجع النتيجة;
}

عام عرف اختبر_واجهة_المترجم(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن اسم_مساعدة_إن: نص = «مساعدة CLI الإنجليزية»;
    ليكن و_مساعدة_إن: متجه نص = [«--lang», «en», «--help»];
    ليكن علامة_مساعدة: نص = «--diagnostic-format=<format>»;
    ليكن نتيجة_مساعدة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مساعدة_إن, &و_مساعدة_إن, 0, &علامة_مساعدة, خطأ);

    ليكن اسم_شرح: نص = «شرح معرف التشخيص»;
    ليكن و_شرح: متجه نص = [«--lang», «en», «--explain», «SULTANC-TYPE-MISMATCH»];
    ليكن علامة_شرح: نص = «SULTANC-TYPE-MISMATCH»;
    ليكن تجاهل_شرح: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح, &و_شرح, 0, &علامة_شرح, خطأ);

    ليكن اسم_شرح_سيئ: نص = «رفض معرف تشخيص مجهول»;
    ليكن و_شرح_سيئ: متجه نص = [«--lang», «en», «--explain», «SULTANC-NOT-A-DIAGNOSTIC»];
    ليكن علامة_شرح_سيئ: نص = «SULTANC-CLI-UNKNOWN-DIAGNOSTIC-CODE»;
    ليكن تجاهل_شرح_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح_سيئ, &و_شرح_سيئ, 2, &علامة_شرح_سيئ, صواب);

    ليكن مصدر: نص = «tests/en/diagnostics/surface/type_expected_found.sn»;

    ليكن اسم_بشري: نص = «تشخيص بشري رمزي»;
    ليكن و_بشري: متجه نص = [«--lang», «en», «check», انسخ_نص_اختبار(&مصدر)];
    ليكن علامة_بشري: نص = «error[SULTANC-TYPE-MISMATCH]»;
    ليكن تجاهل_بشري: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بشري, &و_بشري, 1, &علامة_بشري, صواب);

    ليكن اسم_مختصر: نص = «تشخيص مختصر رمزي»;
    ليكن و_مختصر: متجه نص = [«--lang», «en», «--diagnostic-format», «short», «check», انسخ_نص_اختبار(&مصدر)];
    ليكن علامة_مختصر: نص = «SULTANC-TYPE-MISMATCH»;
    ليكن تجاهل_مختصر: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مختصر, &و_مختصر, 1, &علامة_مختصر, صواب);

    ليكن اسم_جيسون: نص = «تشخيص JSON منظم»;
    ليكن و_جيسون: متجه نص = [«--lang», «en», «--diagnostic-format», «json», «check», مصدر];
    ليكن علامة_جيسون: نص = «"schema":3,"language":"en"»;
    ليكن نتيجة_جيسون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_جيسون, &و_جيسون, 1, &علامة_جيسون, صواب);

    // منشئ بلا حمولة مستعمل قيمةً: إصلاحه الآلي `()` في "fixes" بمفتاحه الثابت.
    ليكن اسم_جيسون_منشئ: نص = «إصلاح JSON لمنشئ غير مستدعى»;
    ليكن و_جيسون_منشئ: متجه نص = [«--lang», «en», «--diagnostic-format», «json», «check», «tests/en/diagnostics/e2e/constructor_not_called.sn»];
    ليكن علامة_جيسون_منشئ: نص = «"replacement":"()","message":"call the constructor: add `()` after it","applicability":"machine-applicable","key":"call-constructor"»;
    ليكن تجاهل_جيسون_منشئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_جيسون_منشئ, &و_جيسون_منشئ, 1, &علامة_جيسون_منشئ, صواب);

    ليكن بايتات_هروب: متجه ط8 = [0x1b, 0x5b];
    ليكن رمز_هروب: نص = من_بايتات(&بايتات_هروب);
    إذا (يحتوي_نصا(&نتيجة_جيسون.الخطأ, &رمز_هروب)) {
        ليكن اسم: نص = «JSON بلا ألوان طرفية»;
        ليكن سبب: نص = «JSON يحتوي تسلسل لون طرفي»;
        سجل_فشل(الملخص, &اسم, &سبب);
    } وإلا {
        ليكن اسم: نص = «JSON بلا ألوان طرفية»;
        سجل_نجاح(الملخص, &اسم);
    };

    ليكن اسم_لون_سيئ: نص = «رفض سياسة لون مجهولة»;
    ليكن و_لون_سيئ: متجه نص = [«--lang», «en», «--color», «vivid», «--help»];
    ليكن علامة_لون_سيئ: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-COLOR»;
    ليكن تجاهل_لون_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_لون_سيئ, &و_لون_سيئ, 2, &علامة_لون_سيئ, صواب);

    ليكن اسم_صيغة_سيئة: نص = «رفض صيغة تشخيص مجهولة»;
    ليكن و_صيغة_سيئة: متجه نص = [«--diagnostic-format», «yaml», «examples/en/basics/arithmetic.sn»];
    ليكن علامة_صيغة_سيئة: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-FORMAT»;
    ليكن تجاهل_صيغة_سيئة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_صيغة_سيئة, &و_صيغة_سيئة, 2, &علامة_صيغة_سيئة, صواب);

    // `check --target` يتحقق للهدف المختار: تصريح لـ wasm32 فقط مقبول له.
    ليكن اسم_فحص_هدف_إن: نص = «check --target للهدف المختار (إنجليزي)»;
    ليكن و_فحص_هدف_إن: متجه نص = [«--diagnostic-format», «short», «check», «--target=wasm32-wasi», «tests/en/diagnostics/semantic/check_for_target.sn»];
    ليكن علامة_فارغة: نص = «»;
    ليكن تجاهل_فحص_هدف_إن: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_إن, &و_فحص_هدف_إن, 0, &علامة_فارغة, صواب);
    ليكن اسم_فحص_هدف_ع: نص = «check --target للهدف المختار (عربي)»;
    ليكن و_فحص_هدف_ع: متجه نص = [«check», «--target», «wasm32-wasi», «tests/ar/diagnostics/semantic/check_for_target.sn»];
    ليكن تجاهل_فحص_هدف_ع: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_ع, &و_فحص_هدف_ع, 0, &علامة_فارغة, صواب);
    ليكن اسم_فحص_هدف_مجهول: نص = «check --target بهدف مجهول»;
    ليكن و_فحص_هدف_مجهول: متجه نص = [«--lang», «en», «check», «--target=plan9-unknown», «tests/en/diagnostics/semantic/check_for_target.sn»];
    ليكن علامة_هدف_مجهول: نص = «SULTANC-TARGET-UNKNOWN»;
    ليكن تجاهل_فحص_هدف_مجهول: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_مجهول, &و_فحص_هدف_مجهول, 3, &علامة_هدف_مجهول, صواب);

    // واجهة std المرئية: المفسر يجب أن يحافظ على stdout وسياق argv الخاص بالبرنامج.
    ليكن اسم_طباعة: نص = «خرج std.io عبر المفسر»;
    ليكن و_طباعة: متجه نص = [«interpret», «tests/en/compiler/semantic/stdlib_public_io.sn»];
    ليكن مترجم_طباعة: نص = مسار_المترجم();
    ليكن نتيجة_طباعة: نتيجة_أمر = نفذ_أمرا(&مترجم_طباعة, &و_طباعة, &اسم_طباعة);
    ليكن متوقع_طباعة: نص = "AB\nسلطان\n";
    إذا ((نتيجة_طباعة.الحالة == 42) && نصان_متساويان(&نتيجة_طباعة.الخرج, &متوقع_طباعة) && (الطول(نتيجة_طباعة.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_طباعة);
    } وإلا {
        ليكن سبب: نص = «خرج print/println أو حالته غير مطابق»;
        سجل_فشل(الملخص, &اسم_طباعة, &سبب);
    };

    ليكن اسم_وسائط: نص = «سياق وسائط البرنامج المفسر»;
    ليكن و_وسائط: متجه نص = [«interpret», «tests/en/runtime/runtime_argc.sn»];
    ليكن المترجم: نص = مسار_المترجم();
    ليكن نتيجة_وسائط: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_وسائط, &اسم_وسائط);
    // argv فيه البرنامج نفسه فقط (الوسيطة 0، كما يعطيها النظام للتنفيذي)،
    // ولا شيء من وسائط المترجم.
    إذا ((نتيجة_وسائط.الحالة == 1) && (الطول(نتيجة_وسائط.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_وسائط);
    } وإلا {
        ليكن سبب: نص = «وسائط CLI تسربت إلى سياق البرنامج المفسر»;
        سجل_فشل(الملخص, &اسم_وسائط, &سبب);
    };

    // The Arabic entry function is الرئيسية only: the old name is an ordinary
    // function, so a program whose only entry has it has no entry point.
    ليكن مصدر_دخول_قديم: نص = «tests/ar/diagnostics/entry/old_entry_name.sn»;
    ليكن اسم_دخول_قديم: نص = «اسم الدخول القديم ليس نقطة دخول»;
    ليكن و_دخول_قديم: متجه نص = [«--lang», «ar», «run», انسخ_نص_اختبار(&مصدر_دخول_قديم)];
    ليكن علامة_دخول_قديم: نص = «SULTANC-ENTRYPOINT-NOT-FOUND»;
    ليكن تجاهل_دخول_قديم: نتيجة_أمر = تحقق_أمر(
        الملخص, &اسم_دخول_قديم, &و_دخول_قديم, 1, &علامة_دخول_قديم, صواب
    );
    ليكن اسم_دخول_مسمى: نص = «تشخيص نقطة الدخول المفقودة يسمي الرئيسية»;
    ليكن و_دخول_مسمى: متجه نص = [«--lang», «ar», «--color», «never», «run», انسخ_نص_اختبار(&مصدر_دخول_قديم)];
    ليكن علامة_دخول_مسمى: نص = «`الرئيسية`»;
    ليكن تجاهل_دخول_مسمى: نتيجة_أمر = تحقق_أمر(
        الملخص, &اسم_دخول_مسمى, &و_دخول_مسمى, 1, &علامة_دخول_مسمى, صواب
    );

    // macOS programs never name the C library: libSystem is linked anyway,
    // and the SDK's libc.tbd (a text stub for it) is no input for the native
    // Mach-O linker. A program importing C links for arm64-darwin with such a
    // libc.tbd on the -L path (tests/runner/fixtures/darwin_libc), in both
    // languages.
    ليكن مصادر_سي_داروين: متجه نص = [
        «tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»
    ];
    ليكن أسماء_سي_داروين: متجه نص = [
        «ربط استيراد سي لـ arm64-darwin دون libc (en)», «ربط استيراد سي لـ arm64-darwin دون libc (ar)»
    ];
    ليكن مخرجات_سي_داروين: متجه نص = [
        «build/tests-sultanc/c-import-darwin-en», «build/tests-sultanc/c-import-darwin-ar»
    ];
    ليكن ف_داروين: متغير طبيعي = 0;
    طالما (ف_داروين < 2) {
        ليكن و_داروين: متجه نص = [
            انسخ_نص_اختبار(&مصادر_سي_داروين[ف_داروين]), «--target», «arm64-darwin»,
            «-o», انسخ_نص_اختبار(&مخرجات_سي_داروين[ف_داروين]), «-L», «tests/runner/fixtures/darwin_libc»
        ];
        ليكن مترجم_داروين: نص = مسار_المترجم();
        ليكن نتيجة_داروين: نتيجة_أمر = نفذ_أمرا(&مترجم_داروين, &و_داروين, &أسماء_سي_داروين[ف_داروين]);
        إذا (نتيجة_داروين.الحالة == 0) {
            سجل_نجاح(الملخص, &أسماء_سي_داروين[ف_داروين]);
        } وإلا {
            ليكن سبب: نص = «ربط برنامج يستورد سي لـ arm64-darwin فشل مع libc.tbd في مسار -L»;
            سجل_فشل(الملخص, &أسماء_سي_داروين[ف_داروين], &سبب);
        };
        ف_داروين := ف_داروين + 1;
    }

    اختبر_مكتبات_التشغيل(الملخص);
    اختبر_تشخيصات_سي_والبيئة(الملخص);
    اختبر_مثال_الدالة_الخارجية(الملخص);
    اختبر_مستوى_التحسين_صفر(الملخص);
    اختبر_فخ_خيط(الملخص);
    اختبر_إصدار_مسير(الملخص);
    اختبر_خلفية_غير_متاحة_بتهجئة(الملخص);
}

// `run` and `interpret` take -l and -L with a build's meaning
// (process_driver.sn حل_مكتبات_تحميل_تفسير_عملية), in both languages.
عرف اختبر_مكتبات_التشغيل(الملخص: &متغير ملخص_اختبارات): فراغ {
    // Whether the interpreter runs a program given -l: only a compiler with a
    // dynamic loader (machine_entry.sn يلزم_تنفيذي_لمكتبات_آلة); without one
    // `run` builds and runs an executable.
    ليكن بمحمل: منطقي = مترجم_بمحمل_ديناميكي();
    ليكن البرامج: متجه نص = [
        «tests/en/runtime/runtime_allocator_churn.sn», «tests/ar/runtime/runtime_allocator_churn.sn»
    ];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن اللغة: نص = انسخ_نص_اختبار(&اللغات[ف]);
        ليكن البرنامج: نص = انسخ_نص_اختبار(&البرامج[ف]);
        ليكن بلا_علامة: نص = «»;

        // -l c and -l m: the C and math libraries the interpreter already
        // provides, valid as for a build, as -lc -lm, and for `interpret`.
        ليكن أجزاء_سي: متجه نص = [«run -l c -l m (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_سي: نص = اجمع_نصوص(&أجزاء_سي);
        ليكن و_سي: متجه نص = [«run», «-l», «c», «-l», «m», انسخ_نص_اختبار(&البرنامج)];
        ليكن تجاهل_سي: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_سي, &و_سي, 42, &بلا_علامة, خطأ);
        ليكن أجزاء_ملتصقة: متجه نص = [«interpret -lc -lm (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_ملتصقة: نص = اجمع_نصوص(&أجزاء_ملتصقة);
        ليكن و_ملتصقة: متجه نص = [«interpret», «-lc», «-lm», انسخ_نص_اختبار(&البرنامج)];
        ليكن تجاهل_ملتصقة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ملتصقة, &و_ملتصقة, 42, &بلا_علامة, خطأ);

        // A -L directory that does not exist holds nothing, as for a build.
        ليكن أجزاء_دليل: متجه نص = [«run -L بدليل غير موجود (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_دليل: نص = اجمع_نصوص(&أجزاء_دليل);
        ليكن و_دليل: متجه نص = [
            «run», «-L», «build/tests-sultanc/no-such-directory», «-l», «c», انسخ_نص_اختبار(&البرنامج)
        ];
        ليكن تجاهل_دليل: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_دليل, &و_دليل, 42, &بلا_علامة, خطأ);

        // A library nothing provides: the build's diagnostic.
        ليكن أجزاء_مفقودة: متجه نص = [«run -l لمكتبة غير موجودة (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_مفقودة: نص = اجمع_نصوص(&أجزاء_مفقودة);
        ليكن و_مفقودة: متجه نص = [
            «--lang», انسخ_نص_اختبار(&اللغة), «run», «-l», «sultanc_no_such_library», انسخ_نص_اختبار(&البرنامج)
        ];
        ليكن علامة_مفقودة: نص = «SULTANC-LINK-LIBRARY-NOT-FOUND»;
        ليكن تجاهل_مفقودة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مفقودة, &و_مفقودة, 3, &علامة_مفقودة, صواب);

        // Only a static archive (an empty one), when the interpreter runs
        // the program: it loads shared libraries only, so the -l is
        // reported, naming the archive. (The executable path links an
        // archive: libanswer.a below.)
        ليكن أجزاء_ساكنة: متجه نص = [«run -l لأرشيف ساكن فقط في المفسر (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_ساكنة: نص = اجمع_نصوص(&أجزاء_ساكنة);
        إذا (بمحمل) {
            ليكن و_ساكنة: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغة), «run», «-L», «tests/runner/fixtures/run_libs», «-l», «onlystatic»,
                انسخ_نص_اختبار(&البرنامج)
            ];
            ليكن علامة_ساكنة: نص = «SULTANC-RUN-LIBRARY-STATIC-ONLY»;
            ليكن تجاهل_ساكنة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ساكنة, &و_ساكنة, 3, &علامة_ساكنة, صواب);
            ليكن علامة_الأرشيف: نص = «libonlystatic.a»;
            ليكن أجزاء_الأرشيف: متجه نص = [«التشخيص يسمي الأرشيف (», انسخ_نص_اختبار(&اللغة), «)»];
            ليكن اسم_الأرشيف: نص = اجمع_نصوص(&أجزاء_الأرشيف);
            ليكن تجاهل_الأرشيف: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_الأرشيف, &و_ساكنة, 3, &علامة_الأرشيف, صواب);
        } وإلا {
            ليكن سبب: نص = «مترجم بلا محمّل ديناميكي: run يشغّل ملفا تنفيذيا لا المفسر»;
            سجل_تجاوز(الملخص, &اسم_ساكنة, &سبب);
        };
        ف := ف + 1;
    }

    // A program whose C functions run only from an executable (its own
    // extern here) links the -l libraries: libanswer.so, built from
    // tests/runner/fixtures/run_libs/answer.c by the host's cc, on Linux.
    ليكن اسم_المكتبة: نص = «run يربط مكتبات -l في التنفيذي»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        ليكن لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) {
            ليكن سبب: نص = «يحتاج مضيف Linux»;
            سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
            أرجع;
        };
    }
    | اختياري.لا_شيء -> {
        ليكن سبب: نص = «المضيف غير معروف»;
        سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
        أرجع;
    };
    ليكن الدليل: نص = «build/tests-sultanc/run_libs»;
    ليكن أنشئ: منطقي = تأكد_من_دليل(&الدليل);
    ليكن سي: نص = «cc»;
    ليكن و_سي: متجه نص = [
        «-shared», «-fPIC», «-o», «build/tests-sultanc/run_libs/libanswer.so», «tests/runner/fixtures/run_libs/answer.c»
    ];
    ليكن اسم_سي: نص = «cc-libanswer»;
    ليكن بناء_سي: نتيجة_أمر = نفذ_أمرا(&سي, &و_سي, &اسم_سي);
    إذا (بناء_سي.الحالة != 0) {
        ليكن سبب: نص = «لا يوجد مترجم سي (cc) لبناء المكتبة المشتركة»;
        سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
        أرجع;
    };
    ليكن البيئة: نص = مسار_env_الاختبار();
    ليكن المصادر: متجه نص = [«tests/runner/fixtures/run_libs/answer.sn», «tests/runner/fixtures/run_libs/answer_ar.sn»];
    ليكن الأسماء: متجه نص = [«run -L -l answer في التنفيذي (en)», «run -L -l answer في التنفيذي (ar)»];
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < 2) {
        ليكن و_تشغيل: متجه نص = [
            «LD_LIBRARY_PATH=build/tests-sultanc/run_libs», مسار_المترجم(), «run»,
            «-L», «build/tests-sultanc/run_libs», «-l», «answer», انسخ_نص_اختبار(&المصادر[ك])
        ];
        ليكن التشغيل: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_تشغيل, &الأسماء[ك]);
        إذا (التشغيل.الحالة == 42) {
            سجل_نجاح(الملخص, &الأسماء[ك]);
        } وإلا {
            ليكن سبب: نص = «برنامج يستدعي answer() من libanswer.so لم يخرج بـ 42 مع -L و-l»;
            سجل_فشل(الملخص, &الأسماء[ك], &سبب);
        };
        ك := ك + 1;
    }
    // Without the -l, the executable a compiler without a loader builds
    // does not link.
    إذا (!بمحمل) {
        ليكن اسم_بدون: نص = «run بدون -l لا يربط answer»;
        ليكن و_بدون: متجه نص = [«run», «tests/runner/fixtures/run_libs/answer.sn»];
        ليكن علامة_بدون: نص = «SULTANC-LINK-UNDEFINED-SYMBOL»;
        ليكن تجاهل_بدون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بدون, &و_بدون, 3, &علامة_بدون, صواب);
    };

    // A program importing C runs as an executable on every compiler: an -l
    // found only as an archive (libanswer.a, built by cc and ar) is linked.
    ليكن ار: نص = «ar»;
    ليكن و_كائن: متجه نص = [
        «-c», «-o», «build/tests-sultanc/run_libs/answer.o», «tests/runner/fixtures/run_libs/answer.c»
    ];
    ليكن اسم_كائن: نص = «cc-answer-o»;
    ليكن بناء_كائن: نتيجة_أمر = نفذ_أمرا(&سي, &و_كائن, &اسم_كائن);
    ليكن الأرشيف: نص = «build/tests-sultanc/run_libs/static/libanswer.a»;
    ليكن دليل_الأرشيف: نص = «build/tests-sultanc/run_libs/static»;
    ليكن أنشئ_الأرشيف: منطقي = تأكد_من_دليل(&دليل_الأرشيف);
    ليكن و_ار: متجه نص = [«rcs», انسخ_نص_اختبار(&الأرشيف), «build/tests-sultanc/run_libs/answer.o»];
    ليكن اسم_ار: نص = «ar-libanswer»;
    ليكن بناء_ار: نتيجة_أمر = نفذ_أمرا(&ار, &و_ار, &اسم_ار);
    ليكن مصادر_سي: متجه نص = [«tests/runner/fixtures/run_libs/answer_c.sn», «tests/runner/fixtures/run_libs/answer_c_ar.sn»];
    ليكن أسماء_سي: متجه نص = [«run يربط أرشيف -l في التنفيذي (en)», «run يربط أرشيف -l في التنفيذي (ar)»];
    ك := 0;
    طالما (ك < 2) {
        إذا (بناء_كائن.الحالة != 0 || بناء_ار.الحالة != 0) {
            ليكن سبب: نص = «لا يوجد cc أو ar لبناء الأرشيف»;
            سجل_تجاوز(الملخص, &أسماء_سي[ك], &سبب);
        } وإلا {
            ليكن و_أرشيف: متجه نص = [
                «run», «-L», انسخ_نص_اختبار(&دليل_الأرشيف), «-l», «answer», انسخ_نص_اختبار(&مصادر_سي[ك])
            ];
            ليكن بلا_علامة_أرشيف: نص = «»;
            ليكن تجاهل_أرشيف: نتيجة_أمر = تحقق_أمر(الملخص, &أسماء_سي[ك], &و_أرشيف, 42, &بلا_علامة_أرشيف, خطأ);
        };
        ك := ك + 1;
    }
}

// Whether this compiler has a dynamic loader, so that `run` loads -l
// libraries into the interpreter: on macOS always; on Linux when the
// compiler is a dynamically linked ELF (a PT_INTERP program header, as an
// LLVM-enabled build has); a static compiler has none.
عرف مترجم_بمحمل_ديناميكي(): منطقي {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        ليكن ماك: نص = «arm64-darwin»;
        إذا (نصان_متساويان_اختبار(&المضيف, &ماك)) { أرجع صواب; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن المترجم: نص = مسار_المترجم();
    ليكن ب: نص = اقرأ_إن_وجد(&المترجم);
    ليكن العدد: طبيعي = الطول(ب) مثل طبيعي;
    إذا (العدد < 64 || ب[0] != 0x7F || ب[1] != 0x45 || ب[4] != 2) { أرجع خطأ; };
    ليكن موضع_الرؤوس: طبيعي = قيمة_صغرى_أولا(&ب, 0x20, 8);
    ليكن حجم_الرأس: طبيعي = قيمة_صغرى_أولا(&ب, 0x36, 2);
    ليكن عدد_الرؤوس: طبيعي = قيمة_صغرى_أولا(&ب, 0x38, 2);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < عدد_الرؤوس) {
        ليكن الموضع: طبيعي = موضع_الرؤوس + ف * حجم_الرأس;
        إذا (الموضع + 4 > العدد) { أرجع خطأ; };
        // PT_INTERP
        إذا (قيمة_صغرى_أولا(&ب, الموضع, 4) == 3) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The little-endian unsigned value of العرض bytes at الموضع.
عرف قيمة_صغرى_أولا(البايتات: &نص, الموضع: طبيعي, العرض: طبيعي): طبيعي {
    ليكن القيمة: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = العرض;
    طالما (ف > 0) {
        ف := ف - 1;
        القيمة := القيمة * 256 + ((*البايتات)[الموضع + ف] مثل طبيعي);
    }
    أرجع القيمة;
}

// SULTANC_COMPTIME_BUDGET read by the CLI, the system C compiler for another
// target, and a C import's libc missing (a warning; the link goes on), in
// both languages.
عرف اختبر_تشخيصات_سي_والبيئة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن البيئة: نص = مسار_env_الاختبار();
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن اللغة: نص = انسخ_نص_اختبار(&اللغات[ف]);
        ليكن أجزاء_ميزانية: متجه نص = [«SULTANC_COMPTIME_BUDGET غير صالح (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_ميزانية: نص = اجمع_نصوص(&أجزاء_ميزانية);
        ليكن و_ميزانية: متجه نص = [
            «SULTANC_COMPTIME_BUDGET=ten», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «check», «tests/en/runtime/runtime_allocator_churn.sn»
        ];
        ليكن ميزانية: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_ميزانية, &اسم_ميزانية);
        ليكن علامة_ميزانية: نص = «SULTANC-CLI-ENV-VALUE-INVALID»;
        ليكن علامة_إسناد: نص = «SULTANC_COMPTIME_BUDGET=ten»;
        إذا (ميزانية.الحالة == 2 && يحتوي_نصا(&ميزانية.الخطأ, &علامة_ميزانية) && يحتوي_نصا(&ميزانية.الخطأ, &علامة_إسناد)) {
            سجل_نجاح(الملخص, &اسم_ميزانية);
        } وإلا {
            ليكن سبب: نص = «قيمة SULTANC_COMPTIME_BUDGET غير الصالحة لم تُرفض بتشخيص يسميها»;
            سجل_فشل(الملخص, &اسم_ميزانية, &سبب);
        };

        ليكن أجزاء_مضيف: متجه نص = [«SULTANC_C_COMPILER=cc لهدف غير المضيف (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_مضيف: نص = اجمع_نصوص(&أجزاء_مضيف);
        ليكن و_مضيف: متجه نص = [
            «SULTANC_C_COMPILER=cc», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «--target», هدف_غير_المضيف(),
            «-o», «build/tests-sultanc/c-host-only.exe»
        ];
        ليكن مضيف: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_مضيف, &اسم_مضيف);
        ليكن علامة_مضيف: نص = «SULTANC-C-COMPILER-HOST-ONLY»;
        إذا (مضيف.الحالة == 3 && يحتوي_نصا(&مضيف.الخطأ, &علامة_مضيف)) {
            سجل_نجاح(الملخص, &اسم_مضيف);
        } وإلا {
            ليكن سبب: نص = «مترجم سي النظام لهدف غير المضيف لم يُرفض بتشخيصه»;
            سجل_فشل(الملخص, &اسم_مضيف, &سبب);
        };

        // The system C compiler failing (CC=/bin/false exits with status 1)
        // and missing (CC naming no file): SULTANC-C-COMPILER-FAILED.
        ليكن أجزاء_فشل: متجه نص = [«مترجم سي النظام يفشل (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_فشل: نص = اجمع_نصوص(&أجزاء_فشل);
        ليكن و_فشل: متجه نص = [
            «SULTANC_C_COMPILER=cc», «CC=/bin/false», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «-o», «build/tests-sultanc/c-cc-failed»
        ];
        ليكن فشل: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_فشل, &اسم_فشل);
        ليكن علامة_فشل: نص = «SULTANC-C-COMPILER-FAILED»;
        إذا (فشل.الحالة == 3 && يحتوي_نصا(&فشل.الخطأ, &علامة_فشل)) {
            سجل_نجاح(الملخص, &اسم_فشل);
        } وإلا {
            ليكن سبب: نص = «فشل مترجم سي النظام لم يُبلَّغ بتشخيصه»;
            سجل_فشل(الملخص, &اسم_فشل, &سبب);
        };
        ليكن أجزاء_مفقود: متجه نص = [«مترجم سي النظام غير موجود (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_مفقود: نص = اجمع_نصوص(&أجزاء_مفقود);
        ليكن و_مفقود: متجه نص = [
            «SULTANC_C_COMPILER=cc», «CC=/nonexistent/sultanc-no-cc», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «-o», «build/tests-sultanc/c-cc-missing»
        ];
        ليكن مفقود: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_مفقود, &اسم_مفقود);
        إذا (مفقود.الحالة == 3 && يحتوي_نصا(&مفقود.الخطأ, &علامة_فشل)) {
            سجل_نجاح(الملخص, &اسم_مفقود);
        } وإلا {
            ليكن سبب: نص = «مترجم سي النظام المفقود لم يُبلَّغ بتشخيصه»;
            سجل_فشل(الملخص, &اسم_مفقود, &سبب);
        };

        // aarch64-linux-gnu from an x86_64 Linux host without that libc.
        ليكن أجزاء_ليبسي: متجه نص = [«تحذير مكتبة سي مفقودة (», انسخ_نص_اختبار(&اللغة), «)»];
        ليكن اسم_ليبسي: نص = اجمع_نصوص(&أجزاء_ليبسي);
        إذا (بلا_مكتبة_سي_لآرم()) {
            ليكن و_ليبسي: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغة), «tests/en/compiler/c_import_units/main.sn»,
                «--target», «aarch64-linux-gnu», «-o», «build/tests-sultanc/c-libc-missing»
            ];
            ليكن علامة_ليبسي: نص = «SULTANC-LINK-LIBC-NOT-FOUND»;
            ليكن تجاهل_ليبسي: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ليبسي, &و_ليبسي, 0, &علامة_ليبسي, صواب);
        } وإلا {
            ليكن سبب: نص = «يحتاج مضيف x86_64-linux بلا مكتبة سي لـ aarch64»;
            سجل_تجاوز(الملخص, &اسم_ليبسي, &سبب);
        };
        ف := ف + 1;
    }
}

// An x86_64 Linux host holding no aarch64 libc where the target looks.
عرف بلا_مكتبة_سي_لآرم(): منطقي {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        ليكن لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    ليكن المسارات: متجه نص = [
        «/lib/aarch64-linux-gnu/libc.so», «/usr/lib/aarch64-linux-gnu/libc.so»,
        «/lib/aarch64-linux-gnu/libc.a», «/usr/lib/aarch64-linux-gnu/libc.a»
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) {
        ليكن المحتوى: نص = اقرأ_إن_وجد(&المسارات[ف]);
        إذا ((الطول(المحتوى) مثل طبيعي) > 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// examples/{en,ar}/ffi/extern_call.sn: a plain extern links only the
// libraries named (SultanC never links libc implicitly), so with -l c it
// builds and prints 1234, and without it the link names labs as undefined
// (docs/en/contributing/examples.md).
عرف اختبر_مثال_الدالة_الخارجية(الملخص: &متغير ملخص_اختبارات): فراغ {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        ليكن لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) { أرجع; };
    }
    | اختياري.لا_شيء -> { أرجع; };
    ليكن المصادر: متجه نص = [«examples/en/ffi/extern_call.sn», «examples/ar/ffi/extern_call.sn»];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن أجزاء_المخرج: متجه نص = [«build/tests-sultanc/extern-call-», انسخ_نص_اختبار(&اللغات[ف])];
        ليكن المخرج: نص = اجمع_نصوص(&أجزاء_المخرج);
        ليكن أجزاء_اسم: متجه نص = [«مثال extern_call مع -l c (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        ليكن الاسم: نص = اجمع_نصوص(&أجزاء_اسم);
        ليكن و_بناء: متجه نص = [انسخ_نص_اختبار(&المصادر[ف]), «-l», «c», «-o», انسخ_نص_اختبار(&المخرج)];
        ليكن المترجم: نص = مسار_المترجم();
        ليكن البناء: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_بناء, &الاسم);
        ليكن بلا_وسائط: متجه نص = [];
        ليكن أجزاء_اسم_تشغيل: متجه نص = [«تشغيل extern_call (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        ليكن اسم_تشغيل: نص = اجمع_نصوص(&أجزاء_اسم_تشغيل);
        ليكن التشغيل: نتيجة_أمر = نفذ_أمرا(&المخرج, &بلا_وسائط, &اسم_تشغيل);
        ليكن المتوقع: نص = "1234\n";
        إذا (البناء.الحالة == 0 && التشغيل.الحالة == 0 && نصان_متساويان_اختبار(&التشغيل.الخرج, &المتوقع)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            ليكن سبب: نص = «extern_call مع -l c لم يُبنَ أو لم يطبع 1234»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
        ليكن أجزاء_بدون: متجه نص = [«مثال extern_call بدون -l c (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        ليكن اسم_بدون: نص = اجمع_نصوص(&أجزاء_بدون);
        ليكن و_بدون: متجه نص = [انسخ_نص_اختبار(&المصادر[ف]), «-o», انسخ_نص_اختبار(&المخرج)];
        ليكن علامة_بدون: نص = «SULTANC-LINK-UNDEFINED-SYMBOL»;
        ليكن تجاهل_بدون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بدون, &و_بدون, 3, &علامة_بدون, صواب);
        ف := ف + 1;
    }
}

// -O0 reaches the MSIR pipeline: no pass runs, so each call stays a call.
// A small function called four times is inlined at -O2; in an x86_64-linux
// object every call is an R_X86_64_PLT32 relocation, so -O0 has more of them
// than -O2. In both languages.
عرف اختبر_مستوى_التحسين_صفر(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن المصادر: متجه نص = [«tests/runner/fixtures/opt_level/calls.sn», «tests/runner/fixtures/opt_level/calls_ar.sn»];
    ليكن الأسماء: متجه نص = [«-O0 يبقي النداءات (en)», «-O0 يبقي النداءات (ar)»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن ناتج_صفر: نص = «build/tests-sultanc/opt-level-0.o»;
        ليكن ناتج_اثنان: نص = «build/tests-sultanc/opt-level-2.o»;
        ليكن و_صفر: متجه نص = [
            انسخ_نص_اختبار(&المصادر[ف]), «-c», «--target», «x86_64-linux», «-O0», «-o», انسخ_نص_اختبار(&ناتج_صفر)
        ];
        ليكن و_اثنان: متجه نص = [
            انسخ_نص_اختبار(&المصادر[ف]), «-c», «--target», «x86_64-linux», «-O2», «-o», انسخ_نص_اختبار(&ناتج_اثنان)
        ];
        ليكن المترجم: نص = مسار_المترجم();
        ليكن بناء_صفر: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_صفر, &الأسماء[ف]);
        ليكن بناء_اثنان: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_اثنان, &الأسماء[ف]);
        ليكن عدد_صفر: طبيعي = عدد_نداءات_إلف(&ناتج_صفر);
        ليكن عدد_اثنان: طبيعي = عدد_نداءات_إلف(&ناتج_اثنان);
        إذا (بناء_صفر.الحالة == 0 && بناء_اثنان.الحالة == 0 && عدد_صفر > عدد_اثنان) {
            سجل_نجاح(الملخص, &الأسماء[ف]);
        } وإلا {
            ليكن سبب: نص = «كائن -O0 لا يحمل نداءات أكثر من كائن -O2»;
            سجل_فشل(الملخص, &الأسماء[ف], &سبب);
        };
        ف := ف + 1;
    }
}

// `--emit=msir` writes the optimized MSIR program as text: to stdout by
// default, to the file -o names otherwise, for an English and an Arabic
// source (the function keeps its source name); the help of both languages
// lists it. It needs no backend, so wasm32-wasi (whose native backend the
// test host may lack) prints it too.
عرف اختبر_إصدار_مسير(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن المصادر: متجه نص = [«examples/en/basics/arithmetic.sn», «examples/ar/basics/arithmetic.sn»];
    ليكن الدوال: متجه نص = ["fn @", "fn @"];
    ليكن الأسماء_المصدرية: متجه نص = ["\"main\"", "\"الرئيسية\""];
    ليكن أسماء_الخرج: متجه نص = [«--emit=msir إلى الخرج القياسي (en)», «--emit=msir إلى الخرج القياسي (ar)»];
    ليكن أسماء_الملف: متجه نص = [«--emit=msir -o ملف (en)», «--emit=msir -o ملف (ar)»];
    ليكن أسماء_الهدف: متجه نص = [«--emit=msir لـ wasm32-wasi (en)», «--emit=msir لـ wasm32-wasi (ar)»];
    ليكن المرتجع: نص = «ret %»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن المترجم: نص = مسار_المترجم();
        ليكن و_خرج: متجه نص = [«--emit=msir», انسخ_نص_اختبار(&المصادر[ف])];
        ليكن الخرج: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_خرج, &أسماء_الخرج[ف]);
        إذا (الخرج.الحالة == 0 && يحتوي_نصا(&الخرج.الخرج, &الدوال[ف])
            && يحتوي_نصا(&الخرج.الخرج, &الأسماء_المصدرية[ف]) && يحتوي_نصا(&الخرج.الخرج, &المرتجع)) {
            سجل_نجاح(الملخص, &أسماء_الخرج[ف]);
        } وإلا {
            ليكن سبب: نص = «--emit=msir لم يكتب برنامج MSIR إلى الخرج القياسي»;
            سجل_فشل(الملخص, &أسماء_الخرج[ف], &سبب);
        };

        ليكن الملف: نص = «build/tests-sultanc/emit.msir»;
        اكتب_فارغا(&الملف);
        ليكن و_ملف: متجه نص = [«--emit=msir», «-o», انسخ_نص_اختبار(&الملف), انسخ_نص_اختبار(&المصادر[ف])];
        ليكن بناء_الملف: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_ملف, &أسماء_الملف[ف]);
        ليكن المكتوب: نص = اقرأ_إن_وجد(&الملف);
        إذا (بناء_الملف.الحالة == 0 && (الطول(بناء_الملف.الخرج) مثل طبيعي) == 0
            && يحتوي_نصا(&المكتوب, &الأسماء_المصدرية[ف]) && يحتوي_نصا(&المكتوب, &المرتجع)) {
            سجل_نجاح(الملخص, &أسماء_الملف[ف]);
        } وإلا {
            ليكن سبب: نص = «--emit=msir -o لم يكتب برنامج MSIR في الملف وحده»;
            سجل_فشل(الملخص, &أسماء_الملف[ف], &سبب);
        };

        ليكن و_هدف: متجه نص = [«--emit=msir», «--target=wasm32-wasi», انسخ_نص_اختبار(&المصادر[ف])];
        ليكن بناء_الهدف: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_هدف, &أسماء_الهدف[ف]);
        إذا (بناء_الهدف.الحالة == 0 && يحتوي_نصا(&بناء_الهدف.الخرج, &الأسماء_المصدرية[ف])) {
            سجل_نجاح(الملخص, &أسماء_الهدف[ف]);
        } وإلا {
            ليكن سبب: نص = «--emit=msir طلب خلفية لا يحتاجها»;
            سجل_فشل(الملخص, &أسماء_الهدف[ف], &سبب);
        };
        ف := ف + 1;
    }

    ليكن اسم_مساعدة_إن: نص = «مساعدة --emit=msir (en)»;
    ليكن و_مساعدة_إن: متجه نص = [«--lang», «en», «--help»];
    ليكن علامة_إن: نص = «--emit=msir            the optimized MSIR program as text»;
    ليكن تجاهل_إن: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مساعدة_إن, &و_مساعدة_إن, 0, &علامة_إن, خطأ);
    ليكن اسم_مساعدة_ع: نص = «مساعدة --emit=msir (ar)»;
    ليكن و_مساعدة_ع: متجه نص = [«--lang», «ar», «--help»];
    ليكن علامة_ع: نص = «--emit=msir            برنامج MSIR بعد التحسين نصا»;
    ليكن تجاهل_ع: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مساعدة_ع, &و_مساعدة_ع, 0, &علامة_ع, خطأ);
}

// SULTANC-BACKEND-UNAVAILABLE names the target as it is spelled on the
// command line, never by its registry number: the native backend has no
// i686 Linux path (registry number 10), in both languages.
عرف اختبر_خلفية_غير_متاحة_بتهجئة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن المصادر: متجه نص = [«examples/en/basics/arithmetic.sn», «examples/ar/basics/arithmetic.sn»];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن الأسماء: متجه نص = [«خلفية غير متاحة بتهجئة الهدف (en)», «خلفية غير متاحة بتهجئة الهدف (ar)»];
    ليكن العبارات: متجه نص = [«The backend is unavailable for target », «الخلفية غير متاحة للهدف »];
    ليكن الأرقام: متجه نص = [«for target 10», «للهدف 10»];
    ليكن الكود: نص = «SULTANC-BACKEND-UNAVAILABLE»;
    ليكن التهجئة: نص = «i686-linux-gnu»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن المترجم: نص = مسار_المترجم();
        ليكن الوسائط: متجه نص = [
            «--lang», انسخ_نص_اختبار(&اللغات[ف]), «--color», «never»,
            انسخ_نص_اختبار(&المصادر[ف]), «-c», «--target», «i686-linux-gnu», «--backend», «native»,
            «-o», «build/tests-sultanc/backend-unavailable.o»
        ];
        ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, &الوسائط, &الأسماء[ف]);
        إذا (النتيجة.الحالة != 0 && يحتوي_نصا(&النتيجة.الخطأ, &الكود)
            && يحتوي_نصا(&النتيجة.الخطأ, &العبارات[ف]) && يحتوي_نصا(&النتيجة.الخطأ, &التهجئة)
            && !يحتوي_نصا(&النتيجة.الخطأ, &الأرقام[ف])) {
            سجل_نجاح(الملخص, &الأسماء[ف]);
        } وإلا {
            ليكن سبب: نص = «SULTANC-BACKEND-UNAVAILABLE لا يسمي الهدف بتهجئته»;
            سجل_فشل(الملخص, &الأسماء[ف], &سبب);
        };
        ف := ف + 1;
    }
}

// The R_X86_64_PLT32 relocations (type 4) of every SHT_RELA section of an
// ELF64 object; 0 when the file is no such object.
عرف عدد_نداءات_إلف(المسار: &نص): طبيعي {
    ليكن ب: نص = اقرأ_إن_وجد(المسار);
    ليكن العدد: طبيعي = الطول(ب) مثل طبيعي;
    إذا (العدد < 64 || ب[0] != 0x7F || ب[1] != 0x45 || ب[4] != 2) { أرجع 0; };
    ليكن موضع_الأقسام: طبيعي = قيمة_صغرى_أولا(&ب, 0x28, 8);
    ليكن حجم_القسم: طبيعي = قيمة_صغرى_أولا(&ب, 0x3A, 2);
    ليكن عدد_الأقسام: طبيعي = قيمة_صغرى_أولا(&ب, 0x3C, 2);
    ليكن النداءات: متغير طبيعي = 0;
    ليكن ق: متغير طبيعي = 0;
    طالما (ق < عدد_الأقسام) {
        ليكن الرأس: طبيعي = موضع_الأقسام + ق * حجم_القسم;
        إذا (الرأس + 64 > العدد) { أرجع النداءات; };
        // SHT_RELA
        إذا (قيمة_صغرى_أولا(&ب, الرأس + 4, 4) == 4) {
            ليكن الموضع: طبيعي = قيمة_صغرى_أولا(&ب, الرأس + 24, 8);
            ليكن الحجم: طبيعي = قيمة_صغرى_أولا(&ب, الرأس + 32, 8);
            ليكن م: متغير طبيعي = 0;
            طالما (م + 24 <= الحجم && الموضع + م + 24 <= العدد) {
                // r_info: the type is its low 32 bits.
                إذا (قيمة_صغرى_أولا(&ب, الموضع + م + 8, 4) == 4) { النداءات := النداءات + 1; };
                م := م + 24;
            }
        };
        ق := ق + 1;
    }
    أرجع النداءات;
}

// A runtime check that fails on a spawned thread under `run` is reported like
// one on the main thread (the same code, message and source location: both go
// through std's panic handler) and the process exits with 1, with every
// diagnostic format; four threads failing at once give one report. In both
// languages.
عرف اختبر_فخ_خيط(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الرئيسية: متجه نص = [«tests/runner/fixtures/thread_trap/main_trap.sn», «tests/runner/fixtures/thread_trap/main_trap_ar.sn»];
    ليكن الخيط: متجه نص = [«tests/runner/fixtures/thread_trap/thread_trap.sn», «tests/runner/fixtures/thread_trap/thread_trap_ar.sn»];
    ليكن اللغات: متجه نص = [«en», «ar»];
    ليكن الصيغ: متجه نص = [«human», «short», «json»];
    ليكن العلامة: نص = «SULTANC-RUNTIME-PROGRAM-STOPPED»;
    ليكن المترجم: نص = مسار_المترجم();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        ليكن ص: متغير طبيعي = 0;
        طالما (ص < 3) {
            ليكن أجزاء_اسم: متجه نص = [
                «فخ خيط كفخ الرئيسي (», انسخ_نص_اختبار(&اللغات[ف]), «، », انسخ_نص_اختبار(&الصيغ[ص]), «)»
            ];
            ليكن الاسم: نص = اجمع_نصوص(&أجزاء_اسم);
            ليكن أجزاء_صيغة: متجه نص = [«--diagnostic-format=», انسخ_نص_اختبار(&الصيغ[ص])];
            ليكن الصيغة: نص = اجمع_نصوص(&أجزاء_صيغة);
            ليكن و_رئيسي: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغات[ف]), «--color», «never», انسخ_نص_اختبار(&الصيغة),
                «run», انسخ_نص_اختبار(&الرئيسية[ف])
            ];
            ليكن و_خيط: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغات[ف]), «--color», «never», انسخ_نص_اختبار(&الصيغة),
                «run», انسخ_نص_اختبار(&الخيط[ف])
            ];
            ليكن رئيسي: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_رئيسي, &الاسم);
            ليكن خيط: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_خيط, &الاسم);
            // The header (code and message) and, for the human format, the
            // source location are the frame both reports share.
            // A JSON report's `source_id` numbers the file within its own
            // compilation, which differs between the two programs.
            ليكن سطرا_رئيسي: نص = بلا_معرف_مصدر(&أول_سطرين(&رئيسي.الخطأ));
            ليكن سطرا_خيط: نص = بلا_معرف_مصدر(&أول_سطرين(&خيط.الخطأ));
            ليكن متطابقان: منطقي = نصان_متساويان_اختبار(&سطرا_رئيسي, &سطرا_خيط);
            إذا (رئيسي.الحالة == 1 && خيط.الحالة == 1 && يحتوي_نصا(&خيط.الخطأ, &العلامة) && متطابقان) {
                سجل_نجاح(الملخص, &الاسم);
            } وإلا {
                ليكن سبب: نص = «فشل الخيط لم يُبلَّغ كفشل الخيط الرئيسي أو لم يخرج بـ 1»;
                سجل_فشل(الملخص, &الاسم, &سبب);
            };
            ص := ص + 1;
        }
        ف := ف + 1;
    }
    ليكن اسم_أربعة: نص = «أربعة خيوط تقع في الفخ معا: بلاغ واحد»;
    ليكن و_أربعة: متجه نص = [«--lang», «en», «--color», «never», «run», «tests/runner/fixtures/thread_trap/threads4_trap.sn»];
    ليكن أربعة: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_أربعة, &اسم_أربعة);
    إذا (أربعة.الحالة == 1 && عدد_مرات_نص(&أربعة.الخطأ, &العلامة) == 1) {
        سجل_نجاح(الملخص, &اسم_أربعة);
    } وإلا {
        ليكن سبب: نص = «أربعة خيوط فاشلة لم تعط بلاغا واحدا وحالة 1»;
        سجل_فشل(الملخص, &اسم_أربعة, &سبب);
    };
}

// The first two lines of a text (fewer when it has fewer).
// النص with the digits after each `"source_id":` removed.
عرف بلا_معرف_مصدر(النص: &نص): نص {
    ليكن المفتاح: متجه ط8 = بايتات_من_نص(«"source_id":»);
    ليكن البايتات: متجه ط8 = بايتات_من_نص(استنسخ(النص));
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول(البايتات) مثل طبيعي;
    ليكن طول_المفتاح: طبيعي = الطول(المفتاح) مثل طبيعي;
    طالما (ف < العدد) {
        ليكن يطابق: متغير منطقي = ف + طول_المفتاح <= العدد;
        ليكن ك: متغير طبيعي = 0;
        طالما (يطابق && ك < طول_المفتاح) {
            إذا (البايتات[ف + ك] != المفتاح[ك]) { يطابق := خطأ; };
            ك := ك + 1;
        }
        إذا (يطابق) {
            ك := 0;
            طالما (ك < طول_المفتاح) { ألحق(الناتج, المفتاح[ك]); ك := ك + 1; }
            ف := ف + طول_المفتاح;
            طالما (ف < العدد && البايتات[ف] >= 0x30 && البايتات[ف] <= 0x39) { ف := ف + 1; }
        } وإلا {
            ألحق(الناتج, البايتات[ف]);
            ف := ف + 1;
        };
    }
    أرجع من_بايتات(&الناتج);
}

عرف أول_سطرين(النص: &نص): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن الأسطر: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي) && الأسطر < 2) {
        ألحق(البايتات, (*النص)[ف]);
        إذا ((*النص)[ف] == 0x0A) { الأسطر := الأسطر + 1; };
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

// How many times العلامة occurs in النص (non-overlapping).
عرف عدد_مرات_نص(النص: &نص, العلامة: &نص): طبيعي {
    ليكن ن: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن م: طبيعي = الطول(*العلامة) مثل طبيعي;
    إذا (م == 0) { أرجع 0; };
    ليكن العدد: متغير طبيعي = 0;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف + م <= ن) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < م && (*النص)[ف + ك] == (*العلامة)[ك]) { ك := ك + 1; }
        إذا (ك == م) { العدد := العدد + 1; ف := ف + م; } وإلا { ف := ف + 1; };
    }
    أرجع العدد;
}
