استورد "../common.sn";
استورد std.text.search;
استورد std.text.compare;
استورد std.text.from_bytes;

عرف تحقق_أمر(
    الملخص: &متغير ملخص_اختبارات,
    الاسم: &نص,
    الوسائط: &متجه نص,
    الحالة: عدد,
    العلامة: &نص,
    في_الخطأ: منطقي
): نتيجة_أمر {
    دع المترجم: نص = مسار_المترجم();
    دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, الوسائط, الاسم);
    دع النص: متغير نص = انسخ_نص_اختبار(&النتيجة.الخرج);
    لو (في_الخطأ) { النص := انسخ_نص_اختبار(&النتيجة.الخطأ); };
    لو (النتيجة.الحالة != الحالة) {
        دع سبب: نص = «حالة أمر المترجم لا تطابق المتوقع»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا لو (!يحتوي_نصا(&النص, العلامة)) {
        دع سبب: نص = «خرج أمر المترجم لا يحتوي العلامة المطلوبة»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, الاسم);
    };
    أرجع النتيجة;
}

عام عرف اختبر_واجهة_المترجم(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_مساعدة_إن: نص = «مساعدة CLI الإنجليزية»;
    دع و_مساعدة_إن: متجه نص = [«--lang», «en», «--help»];
    دع علامة_مساعدة: نص = «--diagnostic-format=<format>»;
    دع نتيجة_مساعدة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مساعدة_إن, &و_مساعدة_إن, 0, &علامة_مساعدة, خطأ);

    دع اسم_شرح: نص = «شرح معرف التشخيص»;
    دع و_شرح: متجه نص = [«--lang», «en», «--explain», «SULTANC-TYPE-MISMATCH»];
    دع علامة_شرح: نص = «SULTANC-TYPE-MISMATCH»;
    دع تجاهل_شرح: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح, &و_شرح, 0, &علامة_شرح, خطأ);

    دع اسم_شرح_سيئ: نص = «رفض معرف تشخيص مجهول»;
    دع و_شرح_سيئ: متجه نص = [«--lang», «en», «--explain», «SULTANC-NOT-A-DIAGNOSTIC»];
    دع علامة_شرح_سيئ: نص = «SULTANC-CLI-UNKNOWN-DIAGNOSTIC-CODE»;
    دع تجاهل_شرح_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح_سيئ, &و_شرح_سيئ, 2, &علامة_شرح_سيئ, صواب);

    دع مصدر: نص = «tests/en/diagnostics/surface/type_expected_found.sn»;

    دع اسم_بشري: نص = «تشخيص بشري رمزي»;
    دع و_بشري: متجه نص = [«--lang», «en», «check», انسخ_نص_اختبار(&مصدر)];
    دع علامة_بشري: نص = «error[SULTANC-CALL-ARGUMENT-TYPE-MISMATCH]»;
    دع تجاهل_بشري: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بشري, &و_بشري, 1, &علامة_بشري, صواب);

    دع اسم_مختصر: نص = «تشخيص مختصر رمزي»;
    دع و_مختصر: متجه نص = [«--lang», «en», «--diagnostic-format», «short», «check», انسخ_نص_اختبار(&مصدر)];
    دع علامة_مختصر: نص = «SULTANC-CALL-ARGUMENT-TYPE-MISMATCH»;
    دع تجاهل_مختصر: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مختصر, &و_مختصر, 1, &علامة_مختصر, صواب);

    دع اسم_جيسون: نص = «تشخيص JSON منظم»;
    دع و_جيسون: متجه نص = [«--lang», «en», «--diagnostic-format», «json», «check», مصدر];
    دع علامة_جيسون: نص = «"schema":2»;
    دع نتيجة_جيسون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_جيسون, &و_جيسون, 1, &علامة_جيسون, صواب);

    دع بايتات_هروب: متجه غ8 = [0x1b, 0x5b];
    دع رمز_هروب: نص = من_بايتات(&بايتات_هروب);
    لو (يحتوي_نصا(&نتيجة_جيسون.الخطأ, &رمز_هروب)) {
        دع اسم: نص = «JSON بلا ألوان طرفية»;
        دع سبب: نص = «JSON يحتوي تسلسل لون طرفي»;
        سجل_فشل(الملخص, &اسم, &سبب);
    } وإلا {
        دع اسم: نص = «JSON بلا ألوان طرفية»;
        سجل_نجاح(الملخص, &اسم);
    };

    دع اسم_لون_سيئ: نص = «رفض سياسة لون مجهولة»;
    دع و_لون_سيئ: متجه نص = [«--lang», «en», «--color», «vivid», «--help»];
    دع علامة_لون_سيئ: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-COLOR»;
    دع تجاهل_لون_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_لون_سيئ, &و_لون_سيئ, 2, &علامة_لون_سيئ, صواب);

    دع اسم_صيغة_سيئة: نص = «رفض صيغة تشخيص مجهولة»;
    دع و_صيغة_سيئة: متجه نص = [«--diagnostic-format», «yaml», «examples/en/basics/arithmetic.sn»];
    دع علامة_صيغة_سيئة: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-FORMAT»;
    دع تجاهل_صيغة_سيئة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_صيغة_سيئة, &و_صيغة_سيئة, 2, &علامة_صيغة_سيئة, صواب);

    // واجهة std المرئية: المفسر يجب أن يحافظ على stdout وسياق argv الخاص بالبرنامج.
    دع اسم_طباعة: نص = «خرج std.io عبر المفسر»;
    دع و_طباعة: متجه نص = [«interpret», «tests/en/compiler/semantic/stdlib_public_io.sn»];
    دع مترجم_طباعة: نص = مسار_المترجم();
    دع نتيجة_طباعة: نتيجة_أمر = نفذ_أمرا(&مترجم_طباعة, &و_طباعة, &اسم_طباعة);
    دع متوقع_طباعة: نص = "AB\nسلطان\n";
    لو ((نتيجة_طباعة.الحالة == 42) && نصان_متساويان(&نتيجة_طباعة.الخرج, &متوقع_طباعة) && (الطول(نتيجة_طباعة.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_طباعة);
    } وإلا {
        دع سبب: نص = «خرج print/println أو حالته غير مطابق»;
        سجل_فشل(الملخص, &اسم_طباعة, &سبب);
    };

    دع اسم_وسائط: نص = «سياق وسائط البرنامج المفسر»;
    دع و_وسائط: متجه نص = [«interpret», «tests/en/runtime/runtime_argc.sn»];
    دع المترجم: نص = مسار_المترجم();
    دع نتيجة_وسائط: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_وسائط, &اسم_وسائط);
    لو ((نتيجة_وسائط.الحالة == 0) && (الطول(نتيجة_وسائط.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_وسائط);
    } وإلا {
        دع سبب: نص = «وسائط CLI تسربت إلى سياق البرنامج المفسر»;
        سجل_فشل(الملخص, &اسم_وسائط, &سبب);
    };
}
