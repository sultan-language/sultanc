استورد "../common.sn";
استورد std.text.search;
استورد std.text.compare;
استورد std.text.from_bytes;

عرف تحقق_أمر(
    الملخص: &متغير ملخص_اختبارات,
    الاسم: &نص,
    الوسائط: &متجه نص,
    الحالة: عدد,
    العلامة: &نص,
    في_الخطأ: منطقي
): نتيجة_أمر {
    دع المترجم: نص = مسار_المترجم();
    دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المترجم, الوسائط, الاسم);
    دع النص: متغير نص = انسخ_نص_اختبار(&النتيجة.الخرج);
    إذا (في_الخطأ) { النص := انسخ_نص_اختبار(&النتيجة.الخطأ); };
    إذا (النتيجة.الحالة != الحالة) {
        دع سبب: نص = «حالة أمر المترجم لا تطابق المتوقع»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا إذا (!يحتوي_نصا(&النص, العلامة)) {
        دع سبب: نص = «خرج أمر المترجم لا يحتوي العلامة المطلوبة»;
        سجل_فشل(الملخص, الاسم, &سبب);
    } وإلا {
        سجل_نجاح(الملخص, الاسم);
    };
    أرجع النتيجة;
}

عام عرف اختبر_واجهة_المترجم(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع اسم_مساعدة_إن: نص = «مساعدة CLI الإنجليزية»;
    دع و_مساعدة_إن: متجه نص = [«--lang», «en», «--help»];
    دع علامة_مساعدة: نص = «--diagnostic-format=<format>»;
    دع نتيجة_مساعدة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مساعدة_إن, &و_مساعدة_إن, 0, &علامة_مساعدة, خطأ);

    دع اسم_شرح: نص = «شرح معرف التشخيص»;
    دع و_شرح: متجه نص = [«--lang», «en», «--explain», «SULTANC-TYPE-MISMATCH»];
    دع علامة_شرح: نص = «SULTANC-TYPE-MISMATCH»;
    دع تجاهل_شرح: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح, &و_شرح, 0, &علامة_شرح, خطأ);

    دع اسم_شرح_سيئ: نص = «رفض معرف تشخيص مجهول»;
    دع و_شرح_سيئ: متجه نص = [«--lang», «en», «--explain», «SULTANC-NOT-A-DIAGNOSTIC»];
    دع علامة_شرح_سيئ: نص = «SULTANC-CLI-UNKNOWN-DIAGNOSTIC-CODE»;
    دع تجاهل_شرح_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_شرح_سيئ, &و_شرح_سيئ, 2, &علامة_شرح_سيئ, صواب);

    دع مصدر: نص = «tests/en/diagnostics/surface/type_expected_found.sn»;

    دع اسم_بشري: نص = «تشخيص بشري رمزي»;
    دع و_بشري: متجه نص = [«--lang», «en», «check», انسخ_نص_اختبار(&مصدر)];
    دع علامة_بشري: نص = «error[SULTANC-TYPE-MISMATCH]»;
    دع تجاهل_بشري: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بشري, &و_بشري, 1, &علامة_بشري, صواب);

    دع اسم_مختصر: نص = «تشخيص مختصر رمزي»;
    دع و_مختصر: متجه نص = [«--lang», «en», «--diagnostic-format», «short», «check», انسخ_نص_اختبار(&مصدر)];
    دع علامة_مختصر: نص = «SULTANC-TYPE-MISMATCH»;
    دع تجاهل_مختصر: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مختصر, &و_مختصر, 1, &علامة_مختصر, صواب);

    دع اسم_جيسون: نص = «تشخيص JSON منظم»;
    دع و_جيسون: متجه نص = [«--lang», «en», «--diagnostic-format», «json», «check», مصدر];
    دع علامة_جيسون: نص = «"schema":3,"language":"en"»;
    دع نتيجة_جيسون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_جيسون, &و_جيسون, 1, &علامة_جيسون, صواب);

    دع بايتات_هروب: متجه ط8 = [0x1b, 0x5b];
    دع رمز_هروب: نص = من_بايتات(&بايتات_هروب);
    إذا (يحتوي_نصا(&نتيجة_جيسون.الخطأ, &رمز_هروب)) {
        دع اسم: نص = «JSON بلا ألوان طرفية»;
        دع سبب: نص = «JSON يحتوي تسلسل لون طرفي»;
        سجل_فشل(الملخص, &اسم, &سبب);
    } وإلا {
        دع اسم: نص = «JSON بلا ألوان طرفية»;
        سجل_نجاح(الملخص, &اسم);
    };

    دع اسم_لون_سيئ: نص = «رفض سياسة لون مجهولة»;
    دع و_لون_سيئ: متجه نص = [«--lang», «en», «--color», «vivid», «--help»];
    دع علامة_لون_سيئ: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-COLOR»;
    دع تجاهل_لون_سيئ: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_لون_سيئ, &و_لون_سيئ, 2, &علامة_لون_سيئ, صواب);

    دع اسم_صيغة_سيئة: نص = «رفض صيغة تشخيص مجهولة»;
    دع و_صيغة_سيئة: متجه نص = [«--diagnostic-format», «yaml», «examples/en/basics/arithmetic.sn»];
    دع علامة_صيغة_سيئة: نص = «SULTANC-CLI-INVALID-DIAGNOSTIC-FORMAT»;
    دع تجاهل_صيغة_سيئة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_صيغة_سيئة, &و_صيغة_سيئة, 2, &علامة_صيغة_سيئة, صواب);

    // `check --target` يتحقق للهدف المختار: تصريح لـ wasm32 فقط مقبول له.
    دع اسم_فحص_هدف_إن: نص = «check --target للهدف المختار (إنجليزي)»;
    دع و_فحص_هدف_إن: متجه نص = [«--diagnostic-format», «short», «check», «--target=wasm32-wasi», «tests/en/diagnostics/semantic/check_for_target.sn»];
    دع علامة_فارغة: نص = «»;
    دع تجاهل_فحص_هدف_إن: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_إن, &و_فحص_هدف_إن, 0, &علامة_فارغة, صواب);
    دع اسم_فحص_هدف_ع: نص = «check --target للهدف المختار (عربي)»;
    دع و_فحص_هدف_ع: متجه نص = [«check», «--target», «wasm32-wasi», «tests/ar/diagnostics/semantic/check_for_target.sn»];
    دع تجاهل_فحص_هدف_ع: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_ع, &و_فحص_هدف_ع, 0, &علامة_فارغة, صواب);
    دع اسم_فحص_هدف_مجهول: نص = «check --target بهدف مجهول»;
    دع و_فحص_هدف_مجهول: متجه نص = [«--lang», «en», «check», «--target=plan9-unknown», «tests/en/diagnostics/semantic/check_for_target.sn»];
    دع علامة_هدف_مجهول: نص = «SULTANC-TARGET-UNKNOWN»;
    دع تجاهل_فحص_هدف_مجهول: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_فحص_هدف_مجهول, &و_فحص_هدف_مجهول, 3, &علامة_هدف_مجهول, صواب);

    // واجهة std المرئية: المفسر يجب أن يحافظ على stdout وسياق argv الخاص بالبرنامج.
    دع اسم_طباعة: نص = «خرج std.io عبر المفسر»;
    دع و_طباعة: متجه نص = [«interpret», «tests/en/compiler/semantic/stdlib_public_io.sn»];
    دع مترجم_طباعة: نص = مسار_المترجم();
    دع نتيجة_طباعة: نتيجة_أمر = نفذ_أمرا(&مترجم_طباعة, &و_طباعة, &اسم_طباعة);
    دع متوقع_طباعة: نص = "AB\nسلطان\n";
    إذا ((نتيجة_طباعة.الحالة == 42) && نصان_متساويان(&نتيجة_طباعة.الخرج, &متوقع_طباعة) && (الطول(نتيجة_طباعة.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_طباعة);
    } وإلا {
        دع سبب: نص = «خرج print/println أو حالته غير مطابق»;
        سجل_فشل(الملخص, &اسم_طباعة, &سبب);
    };

    دع اسم_وسائط: نص = «سياق وسائط البرنامج المفسر»;
    دع و_وسائط: متجه نص = [«interpret», «tests/en/runtime/runtime_argc.sn»];
    دع المترجم: نص = مسار_المترجم();
    دع نتيجة_وسائط: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_وسائط, &اسم_وسائط);
    // argv فيه البرنامج نفسه فقط (الوسيطة 0، كما يعطيها النظام للتنفيذي)،
    // ولا شيء من وسائط المترجم.
    إذا ((نتيجة_وسائط.الحالة == 1) && (الطول(نتيجة_وسائط.الخطأ) == 0)) {
        سجل_نجاح(الملخص, &اسم_وسائط);
    } وإلا {
        دع سبب: نص = «وسائط CLI تسربت إلى سياق البرنامج المفسر»;
        سجل_فشل(الملخص, &اسم_وسائط, &سبب);
    };

    // The Arabic entry function is الرئيسية only: the old name is an ordinary
    // function, so a program whose only entry has it has no entry point.
    دع مصدر_دخول_قديم: نص = «tests/ar/diagnostics/entry/old_entry_name.sn»;
    دع اسم_دخول_قديم: نص = «اسم الدخول القديم ليس نقطة دخول»;
    دع و_دخول_قديم: متجه نص = [«--lang», «ar», «run», انسخ_نص_اختبار(&مصدر_دخول_قديم)];
    دع علامة_دخول_قديم: نص = «SULTANC-ENTRYPOINT-NOT-FOUND»;
    دع تجاهل_دخول_قديم: نتيجة_أمر = تحقق_أمر(
        الملخص, &اسم_دخول_قديم, &و_دخول_قديم, 1, &علامة_دخول_قديم, صواب
    );
    دع اسم_دخول_مسمى: نص = «تشخيص نقطة الدخول المفقودة يسمي الرئيسية»;
    دع و_دخول_مسمى: متجه نص = [«--lang», «ar», «--color», «never», «run», انسخ_نص_اختبار(&مصدر_دخول_قديم)];
    دع علامة_دخول_مسمى: نص = «`الرئيسية`»;
    دع تجاهل_دخول_مسمى: نتيجة_أمر = تحقق_أمر(
        الملخص, &اسم_دخول_مسمى, &و_دخول_مسمى, 1, &علامة_دخول_مسمى, صواب
    );

    // macOS programs never name the C library: libSystem is linked anyway,
    // and the SDK's libc.tbd (a text stub for it) is no input for the native
    // Mach-O linker. A program importing C links for arm64-darwin with such a
    // libc.tbd on the -L path (tests/runner/fixtures/darwin_libc), in both
    // languages.
    دع مصادر_سي_داروين: متجه نص = [
        «tests/en/compiler/c_import_units/main.sn», «tests/ar/compiler/c_import_units/main.sn»
    ];
    دع أسماء_سي_داروين: متجه نص = [
        «ربط استيراد سي لـ arm64-darwin دون libc (en)», «ربط استيراد سي لـ arm64-darwin دون libc (ar)»
    ];
    دع مخرجات_سي_داروين: متجه نص = [
        «build/tests-sultanc/c-import-darwin-en», «build/tests-sultanc/c-import-darwin-ar»
    ];
    دع ف_داروين: متغير طبيعي = 0;
    طالما (ف_داروين < 2) {
        دع و_داروين: متجه نص = [
            انسخ_نص_اختبار(&مصادر_سي_داروين[ف_داروين]), «--target», «arm64-darwin»,
            «-o», انسخ_نص_اختبار(&مخرجات_سي_داروين[ف_داروين]), «-L», «tests/runner/fixtures/darwin_libc»
        ];
        دع مترجم_داروين: نص = مسار_المترجم();
        دع نتيجة_داروين: نتيجة_أمر = نفذ_أمرا(&مترجم_داروين, &و_داروين, &أسماء_سي_داروين[ف_داروين]);
        إذا (نتيجة_داروين.الحالة == 0) {
            سجل_نجاح(الملخص, &أسماء_سي_داروين[ف_داروين]);
        } وإلا {
            دع سبب: نص = «ربط برنامج يستورد سي لـ arm64-darwin فشل مع libc.tbd في مسار -L»;
            سجل_فشل(الملخص, &أسماء_سي_داروين[ف_داروين], &سبب);
        };
        ف_داروين := ف_داروين + 1;
    }

    اختبر_مكتبات_التشغيل(الملخص);
    اختبر_تشخيصات_سي_والبيئة(الملخص);
    اختبر_مثال_الدالة_الخارجية(الملخص);
    اختبر_مستوى_التحسين_صفر(الملخص);
    اختبر_فخ_خيط(الملخص);
}

// `run` and `interpret` take -l and -L with a build's meaning
// (process_driver.sn حل_مكتبات_تحميل_تفسير_عملية), in both languages.
عرف اختبر_مكتبات_التشغيل(الملخص: &متغير ملخص_اختبارات): فراغ {
    // Whether the interpreter runs a program given -l: only a compiler with a
    // dynamic loader (machine_entry.sn يلزم_تنفيذي_لمكتبات_آلة); without one
    // `run` builds and runs an executable.
    دع بمحمل: منطقي = مترجم_بمحمل_ديناميكي();
    دع البرامج: متجه نص = [
        «tests/en/runtime/runtime_allocator_churn.sn», «tests/ar/runtime/runtime_allocator_churn.sn»
    ];
    دع اللغات: متجه نص = [«en», «ar»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        دع اللغة: نص = انسخ_نص_اختبار(&اللغات[ف]);
        دع البرنامج: نص = انسخ_نص_اختبار(&البرامج[ف]);
        دع بلا_علامة: نص = «»;

        // -l c and -l m: the C and math libraries the interpreter already
        // provides, valid as for a build, as -lc -lm, and for `interpret`.
        دع أجزاء_سي: متجه نص = [«run -l c -l m (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_سي: نص = اجمع_نصوص(&أجزاء_سي);
        دع و_سي: متجه نص = [«run», «-l», «c», «-l», «m», انسخ_نص_اختبار(&البرنامج)];
        دع تجاهل_سي: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_سي, &و_سي, 42, &بلا_علامة, خطأ);
        دع أجزاء_ملتصقة: متجه نص = [«interpret -lc -lm (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_ملتصقة: نص = اجمع_نصوص(&أجزاء_ملتصقة);
        دع و_ملتصقة: متجه نص = [«interpret», «-lc», «-lm», انسخ_نص_اختبار(&البرنامج)];
        دع تجاهل_ملتصقة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ملتصقة, &و_ملتصقة, 42, &بلا_علامة, خطأ);

        // A -L directory that does not exist holds nothing, as for a build.
        دع أجزاء_دليل: متجه نص = [«run -L بدليل غير موجود (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_دليل: نص = اجمع_نصوص(&أجزاء_دليل);
        دع و_دليل: متجه نص = [
            «run», «-L», «build/tests-sultanc/no-such-directory», «-l», «c», انسخ_نص_اختبار(&البرنامج)
        ];
        دع تجاهل_دليل: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_دليل, &و_دليل, 42, &بلا_علامة, خطأ);

        // A library nothing provides: the build's diagnostic.
        دع أجزاء_مفقودة: متجه نص = [«run -l لمكتبة غير موجودة (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_مفقودة: نص = اجمع_نصوص(&أجزاء_مفقودة);
        دع و_مفقودة: متجه نص = [
            «--lang», انسخ_نص_اختبار(&اللغة), «run», «-l», «sultanc_no_such_library», انسخ_نص_اختبار(&البرنامج)
        ];
        دع علامة_مفقودة: نص = «SULTANC-LINK-LIBRARY-NOT-FOUND»;
        دع تجاهل_مفقودة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_مفقودة, &و_مفقودة, 3, &علامة_مفقودة, صواب);

        // Only a static archive (an empty one), when the interpreter runs
        // the program: it loads shared libraries only, so the -l is
        // reported, naming the archive. (The executable path links an
        // archive: libanswer.a below.)
        دع أجزاء_ساكنة: متجه نص = [«run -l لأرشيف ساكن فقط في المفسر (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_ساكنة: نص = اجمع_نصوص(&أجزاء_ساكنة);
        إذا (بمحمل) {
            دع و_ساكنة: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغة), «run», «-L», «tests/runner/fixtures/run_libs», «-l», «onlystatic»,
                انسخ_نص_اختبار(&البرنامج)
            ];
            دع علامة_ساكنة: نص = «SULTANC-RUN-LIBRARY-STATIC-ONLY»;
            دع تجاهل_ساكنة: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ساكنة, &و_ساكنة, 3, &علامة_ساكنة, صواب);
            دع علامة_الأرشيف: نص = «libonlystatic.a»;
            دع أجزاء_الأرشيف: متجه نص = [«التشخيص يسمي الأرشيف (», انسخ_نص_اختبار(&اللغة), «)»];
            دع اسم_الأرشيف: نص = اجمع_نصوص(&أجزاء_الأرشيف);
            دع تجاهل_الأرشيف: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_الأرشيف, &و_ساكنة, 3, &علامة_الأرشيف, صواب);
        } وإلا {
            دع سبب: نص = «مترجم بلا محمّل ديناميكي: run يشغّل ملفا تنفيذيا لا المفسر»;
            سجل_تجاوز(الملخص, &اسم_ساكنة, &سبب);
        };
        ف := ف + 1;
    }

    // A program whose C functions run only from an executable (its own
    // extern here) links the -l libraries: libanswer.so, built from
    // tests/runner/fixtures/run_libs/answer.c by the host's cc, on Linux.
    دع اسم_المكتبة: نص = «run يربط مكتبات -l في التنفيذي»;
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        دع لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) {
            دع سبب: نص = «يحتاج مضيف Linux»;
            سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
            أرجع;
        };
    }
    | اختياري.لا_شيء -> {
        دع سبب: نص = «المضيف غير معروف»;
        سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
        أرجع;
    };
    دع الدليل: نص = «build/tests-sultanc/run_libs»;
    دع أنشئ: منطقي = تأكد_من_دليل(&الدليل);
    دع سي: نص = «cc»;
    دع و_سي: متجه نص = [
        «-shared», «-fPIC», «-o», «build/tests-sultanc/run_libs/libanswer.so», «tests/runner/fixtures/run_libs/answer.c»
    ];
    دع اسم_سي: نص = «cc-libanswer»;
    دع بناء_سي: نتيجة_أمر = نفذ_أمرا(&سي, &و_سي, &اسم_سي);
    إذا (بناء_سي.الحالة != 0) {
        دع سبب: نص = «لا يوجد مترجم سي (cc) لبناء المكتبة المشتركة»;
        سجل_تجاوز(الملخص, &اسم_المكتبة, &سبب);
        أرجع;
    };
    دع البيئة: نص = «/usr/bin/env»;
    دع المصادر: متجه نص = [«tests/runner/fixtures/run_libs/answer.sn», «tests/runner/fixtures/run_libs/answer_ar.sn»];
    دع الأسماء: متجه نص = [«run -L -l answer في التنفيذي (en)», «run -L -l answer في التنفيذي (ar)»];
    دع ك: متغير طبيعي = 0;
    طالما (ك < 2) {
        دع و_تشغيل: متجه نص = [
            «LD_LIBRARY_PATH=build/tests-sultanc/run_libs», مسار_المترجم(), «run»,
            «-L», «build/tests-sultanc/run_libs», «-l», «answer», انسخ_نص_اختبار(&المصادر[ك])
        ];
        دع التشغيل: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_تشغيل, &الأسماء[ك]);
        إذا (التشغيل.الحالة == 42) {
            سجل_نجاح(الملخص, &الأسماء[ك]);
        } وإلا {
            دع سبب: نص = «برنامج يستدعي answer() من libanswer.so لم يخرج بـ 42 مع -L و-l»;
            سجل_فشل(الملخص, &الأسماء[ك], &سبب);
        };
        ك := ك + 1;
    }
    // Without the -l, the executable a compiler without a loader builds
    // does not link.
    إذا (!بمحمل) {
        دع اسم_بدون: نص = «run بدون -l لا يربط answer»;
        دع و_بدون: متجه نص = [«run», «tests/runner/fixtures/run_libs/answer.sn»];
        دع علامة_بدون: نص = «SULTANC-LINK-UNDEFINED-SYMBOL»;
        دع تجاهل_بدون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بدون, &و_بدون, 3, &علامة_بدون, صواب);
    };

    // A program importing C runs as an executable on every compiler: an -l
    // found only as an archive (libanswer.a, built by cc and ar) is linked.
    دع ار: نص = «ar»;
    دع و_كائن: متجه نص = [
        «-c», «-o», «build/tests-sultanc/run_libs/answer.o», «tests/runner/fixtures/run_libs/answer.c»
    ];
    دع اسم_كائن: نص = «cc-answer-o»;
    دع بناء_كائن: نتيجة_أمر = نفذ_أمرا(&سي, &و_كائن, &اسم_كائن);
    دع الأرشيف: نص = «build/tests-sultanc/run_libs/static/libanswer.a»;
    دع دليل_الأرشيف: نص = «build/tests-sultanc/run_libs/static»;
    دع أنشئ_الأرشيف: منطقي = تأكد_من_دليل(&دليل_الأرشيف);
    دع و_ار: متجه نص = [«rcs», انسخ_نص_اختبار(&الأرشيف), «build/tests-sultanc/run_libs/answer.o»];
    دع اسم_ار: نص = «ar-libanswer»;
    دع بناء_ار: نتيجة_أمر = نفذ_أمرا(&ار, &و_ار, &اسم_ار);
    دع مصادر_سي: متجه نص = [«tests/runner/fixtures/run_libs/answer_c.sn», «tests/runner/fixtures/run_libs/answer_c_ar.sn»];
    دع أسماء_سي: متجه نص = [«run يربط أرشيف -l في التنفيذي (en)», «run يربط أرشيف -l في التنفيذي (ar)»];
    ك := 0;
    طالما (ك < 2) {
        إذا (بناء_كائن.الحالة != 0 || بناء_ار.الحالة != 0) {
            دع سبب: نص = «لا يوجد cc أو ar لبناء الأرشيف»;
            سجل_تجاوز(الملخص, &أسماء_سي[ك], &سبب);
        } وإلا {
            دع و_أرشيف: متجه نص = [
                «run», «-L», انسخ_نص_اختبار(&دليل_الأرشيف), «-l», «answer», انسخ_نص_اختبار(&مصادر_سي[ك])
            ];
            دع بلا_علامة_أرشيف: نص = «»;
            دع تجاهل_أرشيف: نتيجة_أمر = تحقق_أمر(الملخص, &أسماء_سي[ك], &و_أرشيف, 42, &بلا_علامة_أرشيف, خطأ);
        };
        ك := ك + 1;
    }
}

// Whether this compiler has a dynamic loader, so that `run` loads -l
// libraries into the interpreter: on macOS always; on Linux when the
// compiler is a dynamically linked ELF (a PT_INTERP program header, as an
// LLVM-enabled build has); a static compiler has none.
عرف مترجم_بمحمل_ديناميكي(): منطقي {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        دع ماك: نص = «arm64-darwin»;
        إذا (نصان_متساويان_اختبار(&المضيف, &ماك)) { أرجع صواب; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع المترجم: نص = مسار_المترجم();
    دع ب: نص = اقرأ_إن_وجد(&المترجم);
    دع العدد: طبيعي = الطول(ب) مثل طبيعي;
    إذا (العدد < 64 || ب[0] != 0x7F || ب[1] != 0x45 || ب[4] != 2) { أرجع خطأ; };
    دع موضع_الرؤوس: طبيعي = قيمة_صغرى_أولا(&ب, 0x20, 8);
    دع حجم_الرأس: طبيعي = قيمة_صغرى_أولا(&ب, 0x36, 2);
    دع عدد_الرؤوس: طبيعي = قيمة_صغرى_أولا(&ب, 0x38, 2);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الرؤوس) {
        دع الموضع: طبيعي = موضع_الرؤوس + ف * حجم_الرأس;
        إذا (الموضع + 4 > العدد) { أرجع خطأ; };
        // PT_INTERP
        إذا (قيمة_صغرى_أولا(&ب, الموضع, 4) == 3) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The little-endian unsigned value of العرض bytes at الموضع.
عرف قيمة_صغرى_أولا(البايتات: &نص, الموضع: طبيعي, العرض: طبيعي): طبيعي {
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = العرض;
    طالما (ف > 0) {
        ف := ف - 1;
        القيمة := القيمة * 256 + ((*البايتات)[الموضع + ف] مثل طبيعي);
    }
    أرجع القيمة;
}

// SULTANC_COMPTIME_BUDGET read by the CLI, the system C compiler for another
// target, and a C import's libc missing (a warning; the link goes on), in
// both languages.
عرف اختبر_تشخيصات_سي_والبيئة(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع البيئة: نص = «/usr/bin/env»;
    دع اللغات: متجه نص = [«en», «ar»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        دع اللغة: نص = انسخ_نص_اختبار(&اللغات[ف]);
        دع أجزاء_ميزانية: متجه نص = [«SULTANC_COMPTIME_BUDGET غير صالح (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_ميزانية: نص = اجمع_نصوص(&أجزاء_ميزانية);
        دع و_ميزانية: متجه نص = [
            «SULTANC_COMPTIME_BUDGET=ten», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «check», «tests/en/runtime/runtime_allocator_churn.sn»
        ];
        دع ميزانية: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_ميزانية, &اسم_ميزانية);
        دع علامة_ميزانية: نص = «SULTANC-CLI-ENV-VALUE-INVALID»;
        دع علامة_إسناد: نص = «SULTANC_COMPTIME_BUDGET=ten»;
        إذا (ميزانية.الحالة == 2 && يحتوي_نصا(&ميزانية.الخطأ, &علامة_ميزانية) && يحتوي_نصا(&ميزانية.الخطأ, &علامة_إسناد)) {
            سجل_نجاح(الملخص, &اسم_ميزانية);
        } وإلا {
            دع سبب: نص = «قيمة SULTANC_COMPTIME_BUDGET غير الصالحة لم تُرفض بتشخيص يسميها»;
            سجل_فشل(الملخص, &اسم_ميزانية, &سبب);
        };

        دع أجزاء_مضيف: متجه نص = [«SULTANC_C_COMPILER=cc لهدف غير المضيف (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_مضيف: نص = اجمع_نصوص(&أجزاء_مضيف);
        دع و_مضيف: متجه نص = [
            «SULTANC_C_COMPILER=cc», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «--target», «x86_64-windows-msvc»,
            «-o», «build/tests-sultanc/c-host-only.exe»
        ];
        دع مضيف: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_مضيف, &اسم_مضيف);
        دع علامة_مضيف: نص = «SULTANC-C-COMPILER-HOST-ONLY»;
        إذا (مضيف.الحالة == 3 && يحتوي_نصا(&مضيف.الخطأ, &علامة_مضيف)) {
            سجل_نجاح(الملخص, &اسم_مضيف);
        } وإلا {
            دع سبب: نص = «مترجم سي النظام لهدف غير المضيف لم يُرفض بتشخيصه»;
            سجل_فشل(الملخص, &اسم_مضيف, &سبب);
        };

        // The system C compiler failing (CC=/bin/false exits with status 1)
        // and missing (CC naming no file): SULTANC-C-COMPILER-FAILED.
        دع أجزاء_فشل: متجه نص = [«مترجم سي النظام يفشل (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_فشل: نص = اجمع_نصوص(&أجزاء_فشل);
        دع و_فشل: متجه نص = [
            «SULTANC_C_COMPILER=cc», «CC=/bin/false», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «-o», «build/tests-sultanc/c-cc-failed»
        ];
        دع فشل: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_فشل, &اسم_فشل);
        دع علامة_فشل: نص = «SULTANC-C-COMPILER-FAILED»;
        إذا (فشل.الحالة == 3 && يحتوي_نصا(&فشل.الخطأ, &علامة_فشل)) {
            سجل_نجاح(الملخص, &اسم_فشل);
        } وإلا {
            دع سبب: نص = «فشل مترجم سي النظام لم يُبلَّغ بتشخيصه»;
            سجل_فشل(الملخص, &اسم_فشل, &سبب);
        };
        دع أجزاء_مفقود: متجه نص = [«مترجم سي النظام غير موجود (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_مفقود: نص = اجمع_نصوص(&أجزاء_مفقود);
        دع و_مفقود: متجه نص = [
            «SULTANC_C_COMPILER=cc», «CC=/nonexistent/sultanc-no-cc», مسار_المترجم(), «--lang», انسخ_نص_اختبار(&اللغة),
            «tests/en/compiler/c_import_units/main.sn», «-o», «build/tests-sultanc/c-cc-missing»
        ];
        دع مفقود: نتيجة_أمر = نفذ_أمرا(&البيئة, &و_مفقود, &اسم_مفقود);
        إذا (مفقود.الحالة == 3 && يحتوي_نصا(&مفقود.الخطأ, &علامة_فشل)) {
            سجل_نجاح(الملخص, &اسم_مفقود);
        } وإلا {
            دع سبب: نص = «مترجم سي النظام المفقود لم يُبلَّغ بتشخيصه»;
            سجل_فشل(الملخص, &اسم_مفقود, &سبب);
        };

        // aarch64-linux-gnu from an x86_64 Linux host without that libc.
        دع أجزاء_ليبسي: متجه نص = [«تحذير مكتبة سي مفقودة (», انسخ_نص_اختبار(&اللغة), «)»];
        دع اسم_ليبسي: نص = اجمع_نصوص(&أجزاء_ليبسي);
        إذا (بلا_مكتبة_سي_لآرم()) {
            دع و_ليبسي: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغة), «tests/en/compiler/c_import_units/main.sn»,
                «--target», «aarch64-linux-gnu», «-o», «build/tests-sultanc/c-libc-missing»
            ];
            دع علامة_ليبسي: نص = «SULTANC-LINK-LIBC-NOT-FOUND»;
            دع تجاهل_ليبسي: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_ليبسي, &و_ليبسي, 0, &علامة_ليبسي, صواب);
        } وإلا {
            دع سبب: نص = «يحتاج مضيف x86_64-linux بلا مكتبة سي لـ aarch64»;
            سجل_تجاوز(الملخص, &اسم_ليبسي, &سبب);
        };
        ف := ف + 1;
    }
}

// An x86_64 Linux host holding no aarch64 libc where the target looks.
عرف بلا_مكتبة_سي_لآرم(): منطقي {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        دع لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { أرجع خطأ; };
    دع المسارات: متجه نص = [
        «/lib/aarch64-linux-gnu/libc.so», «/usr/lib/aarch64-linux-gnu/libc.so»,
        «/lib/aarch64-linux-gnu/libc.a», «/usr/lib/aarch64-linux-gnu/libc.a»
    ];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) {
        دع المحتوى: نص = اقرأ_إن_وجد(&المسارات[ف]);
        إذا ((الطول(المحتوى) مثل طبيعي) > 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// examples/{en,ar}/ffi/extern_call.sn: a plain extern links only the
// libraries named (SultanC never links libc implicitly), so with -l c it
// builds and prints 1234, and without it the link names labs as undefined
// (docs/en/contributing/examples.md).
عرف اختبر_مثال_الدالة_الخارجية(الملخص: &متغير ملخص_اختبارات): فراغ {
    طابق الهدف_المضيف() مع
    | اختياري.موجود(المضيف) -> {
        دع لينكس: نص = «x86_64-linux»;
        إذا (!نصان_متساويان_اختبار(&المضيف, &لينكس)) { أرجع; };
    }
    | اختياري.لا_شيء -> { أرجع; };
    دع المصادر: متجه نص = [«examples/en/ffi/extern_call.sn», «examples/ar/ffi/extern_call.sn»];
    دع اللغات: متجه نص = [«en», «ar»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        دع أجزاء_المخرج: متجه نص = [«build/tests-sultanc/extern-call-», انسخ_نص_اختبار(&اللغات[ف])];
        دع المخرج: نص = اجمع_نصوص(&أجزاء_المخرج);
        دع أجزاء_اسم: متجه نص = [«مثال extern_call مع -l c (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        دع الاسم: نص = اجمع_نصوص(&أجزاء_اسم);
        دع و_بناء: متجه نص = [انسخ_نص_اختبار(&المصادر[ف]), «-l», «c», «-o», انسخ_نص_اختبار(&المخرج)];
        دع المترجم: نص = مسار_المترجم();
        دع البناء: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_بناء, &الاسم);
        دع بلا_وسائط: متجه نص = [];
        دع أجزاء_اسم_تشغيل: متجه نص = [«تشغيل extern_call (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        دع اسم_تشغيل: نص = اجمع_نصوص(&أجزاء_اسم_تشغيل);
        دع التشغيل: نتيجة_أمر = نفذ_أمرا(&المخرج, &بلا_وسائط, &اسم_تشغيل);
        دع المتوقع: نص = "1234\n";
        إذا (البناء.الحالة == 0 && التشغيل.الحالة == 0 && نصان_متساويان_اختبار(&التشغيل.الخرج, &المتوقع)) {
            سجل_نجاح(الملخص, &الاسم);
        } وإلا {
            دع سبب: نص = «extern_call مع -l c لم يُبنَ أو لم يطبع 1234»;
            سجل_فشل(الملخص, &الاسم, &سبب);
        };
        دع أجزاء_بدون: متجه نص = [«مثال extern_call بدون -l c (», انسخ_نص_اختبار(&اللغات[ف]), «)»];
        دع اسم_بدون: نص = اجمع_نصوص(&أجزاء_بدون);
        دع و_بدون: متجه نص = [انسخ_نص_اختبار(&المصادر[ف]), «-o», انسخ_نص_اختبار(&المخرج)];
        دع علامة_بدون: نص = «SULTANC-LINK-UNDEFINED-SYMBOL»;
        دع تجاهل_بدون: نتيجة_أمر = تحقق_أمر(الملخص, &اسم_بدون, &و_بدون, 3, &علامة_بدون, صواب);
        ف := ف + 1;
    }
}

// -O0 reaches the MSIR pipeline: no pass runs, so each call stays a call.
// A small function called four times is inlined at -O2; in an x86_64-linux
// object every call is an R_X86_64_PLT32 relocation, so -O0 has more of them
// than -O2. In both languages.
عرف اختبر_مستوى_التحسين_صفر(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع المصادر: متجه نص = [«tests/runner/fixtures/opt_level/calls.sn», «tests/runner/fixtures/opt_level/calls_ar.sn»];
    دع الأسماء: متجه نص = [«-O0 يبقي النداءات (en)», «-O0 يبقي النداءات (ar)»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        دع ناتج_صفر: نص = «build/tests-sultanc/opt-level-0.o»;
        دع ناتج_اثنان: نص = «build/tests-sultanc/opt-level-2.o»;
        دع و_صفر: متجه نص = [
            انسخ_نص_اختبار(&المصادر[ف]), «-c», «--target», «x86_64-linux», «-O0», «-o», انسخ_نص_اختبار(&ناتج_صفر)
        ];
        دع و_اثنان: متجه نص = [
            انسخ_نص_اختبار(&المصادر[ف]), «-c», «--target», «x86_64-linux», «-O2», «-o», انسخ_نص_اختبار(&ناتج_اثنان)
        ];
        دع المترجم: نص = مسار_المترجم();
        دع بناء_صفر: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_صفر, &الأسماء[ف]);
        دع بناء_اثنان: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_اثنان, &الأسماء[ف]);
        دع عدد_صفر: طبيعي = عدد_نداءات_إلف(&ناتج_صفر);
        دع عدد_اثنان: طبيعي = عدد_نداءات_إلف(&ناتج_اثنان);
        إذا (بناء_صفر.الحالة == 0 && بناء_اثنان.الحالة == 0 && عدد_صفر > عدد_اثنان) {
            سجل_نجاح(الملخص, &الأسماء[ف]);
        } وإلا {
            دع سبب: نص = «كائن -O0 لا يحمل نداءات أكثر من كائن -O2»;
            سجل_فشل(الملخص, &الأسماء[ف], &سبب);
        };
        ف := ف + 1;
    }
}

// The R_X86_64_PLT32 relocations (type 4) of every SHT_RELA section of an
// ELF64 object; 0 when the file is no such object.
عرف عدد_نداءات_إلف(المسار: &نص): طبيعي {
    دع ب: نص = اقرأ_إن_وجد(المسار);
    دع العدد: طبيعي = الطول(ب) مثل طبيعي;
    إذا (العدد < 64 || ب[0] != 0x7F || ب[1] != 0x45 || ب[4] != 2) { أرجع 0; };
    دع موضع_الأقسام: طبيعي = قيمة_صغرى_أولا(&ب, 0x28, 8);
    دع حجم_القسم: طبيعي = قيمة_صغرى_أولا(&ب, 0x3A, 2);
    دع عدد_الأقسام: طبيعي = قيمة_صغرى_أولا(&ب, 0x3C, 2);
    دع النداءات: متغير طبيعي = 0;
    دع ق: متغير طبيعي = 0;
    طالما (ق < عدد_الأقسام) {
        دع الرأس: طبيعي = موضع_الأقسام + ق * حجم_القسم;
        إذا (الرأس + 64 > العدد) { أرجع النداءات; };
        // SHT_RELA
        إذا (قيمة_صغرى_أولا(&ب, الرأس + 4, 4) == 4) {
            دع الموضع: طبيعي = قيمة_صغرى_أولا(&ب, الرأس + 24, 8);
            دع الحجم: طبيعي = قيمة_صغرى_أولا(&ب, الرأس + 32, 8);
            دع م: متغير طبيعي = 0;
            طالما (م + 24 <= الحجم && الموضع + م + 24 <= العدد) {
                // r_info: the type is its low 32 bits.
                إذا (قيمة_صغرى_أولا(&ب, الموضع + م + 8, 4) == 4) { النداءات := النداءات + 1; };
                م := م + 24;
            }
        };
        ق := ق + 1;
    }
    أرجع النداءات;
}

// A trap on a spawned thread under `run` is written like a main-thread trap
// (the same code, message and source location: the interpreter renders it
// through the shared renderer with the run's sources, language and format)
// and the process exits with 101, in the human, short and json formats; four
// threads trapping at once give one report. In both languages.
عرف اختبر_فخ_خيط(الملخص: &متغير ملخص_اختبارات): فراغ {
    دع الرئيسية: متجه نص = [«tests/runner/fixtures/thread_trap/main_trap.sn», «tests/runner/fixtures/thread_trap/main_trap_ar.sn»];
    دع الخيط: متجه نص = [«tests/runner/fixtures/thread_trap/thread_trap.sn», «tests/runner/fixtures/thread_trap/thread_trap_ar.sn»];
    دع اللغات: متجه نص = [«en», «ar»];
    دع الصيغ: متجه نص = [«human», «short», «json»];
    دع العلامة: نص = «SULTANC-INTERPRETER-TRAP»;
    دع المترجم: نص = مسار_المترجم();
    دع ف: متغير طبيعي = 0;
    طالما (ف < 2) {
        دع ص: متغير طبيعي = 0;
        طالما (ص < 3) {
            دع أجزاء_اسم: متجه نص = [
                «فخ خيط كفخ الرئيسي (», انسخ_نص_اختبار(&اللغات[ف]), «، », انسخ_نص_اختبار(&الصيغ[ص]), «)»
            ];
            دع الاسم: نص = اجمع_نصوص(&أجزاء_اسم);
            دع أجزاء_صيغة: متجه نص = [«--diagnostic-format=», انسخ_نص_اختبار(&الصيغ[ص])];
            دع الصيغة: نص = اجمع_نصوص(&أجزاء_صيغة);
            دع و_رئيسي: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغات[ف]), «--color», «never», انسخ_نص_اختبار(&الصيغة),
                «run», انسخ_نص_اختبار(&الرئيسية[ف])
            ];
            دع و_خيط: متجه نص = [
                «--lang», انسخ_نص_اختبار(&اللغات[ف]), «--color», «never», انسخ_نص_اختبار(&الصيغة),
                «run», انسخ_نص_اختبار(&الخيط[ف])
            ];
            دع رئيسي: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_رئيسي, &الاسم);
            دع خيط: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_خيط, &الاسم);
            // The header (code and message) and, for the human format, the
            // source location are the frame both reports share.
            دع سطرا_رئيسي: نص = أول_سطرين(&رئيسي.الخطأ);
            دع سطرا_خيط: نص = أول_سطرين(&خيط.الخطأ);
            دع متطابقان: منطقي = نصان_متساويان_اختبار(&سطرا_رئيسي, &سطرا_خيط);
            إذا (رئيسي.الحالة == 101 && خيط.الحالة == 101 && يحتوي_نصا(&خيط.الخطأ, &العلامة) && متطابقان) {
                سجل_نجاح(الملخص, &الاسم);
            } وإلا {
                دع سبب: نص = «فخ الخيط لم يُبلَّغ كفخ الخيط الرئيسي أو لم يخرج بـ 101»;
                سجل_فشل(الملخص, &الاسم, &سبب);
            };
            ص := ص + 1;
        }
        ف := ف + 1;
    }
    دع اسم_أربعة: نص = «أربعة خيوط تقع في الفخ معا: بلاغ واحد»;
    دع و_أربعة: متجه نص = [«--lang», «en», «--color», «never», «run», «tests/runner/fixtures/thread_trap/threads4_trap.sn»];
    دع أربعة: نتيجة_أمر = نفذ_أمرا(&المترجم, &و_أربعة, &اسم_أربعة);
    إذا (أربعة.الحالة == 101 && عدد_مرات_نص(&أربعة.الخطأ, &العلامة) == 1) {
        سجل_نجاح(الملخص, &اسم_أربعة);
    } وإلا {
        دع سبب: نص = «أربعة خيوط في الفخ لم تعط بلاغا واحدا وحالة 101»;
        سجل_فشل(الملخص, &اسم_أربعة, &سبب);
    };
}

// The first two lines of a text (fewer when it has fewer).
عرف أول_سطرين(النص: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع الأسطر: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي) && الأسطر < 2) {
        ألحق(البايتات, (*النص)[ف]);
        إذا ((*النص)[ف] == 0x0A) { الأسطر := الأسطر + 1; };
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

// How many times العلامة occurs in النص (non-overlapping).
عرف عدد_مرات_نص(النص: &نص, العلامة: &نص): طبيعي {
    دع ن: طبيعي = الطول(*النص) مثل طبيعي;
    دع م: طبيعي = الطول(*العلامة) مثل طبيعي;
    إذا (م == 0) { أرجع 0; };
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف + م <= ن) {
        دع ك: متغير طبيعي = 0;
        طالما (ك < م && (*النص)[ف + ك] == (*العلامة)[ك]) { ك := ك + 1; }
        إذا (ك == م) { العدد := العدد + 1; ف := ف + م; } وإلا { ف := ف + 1; };
    }
    أرجع العدد;
}
