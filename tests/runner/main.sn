استورد "common.sn";
استورد std.text.number;
استورد std.io.println;
استورد "discovery.sn";
استورد "execute.sn";
استورد "suites/architecture.sn";
استورد "suites/cli.sn";
استورد "suites/robustness.sn";
استورد "suites/objects.sn";
استورد "suites/system.sn";

عرف اطبع_الملخص(الملخص: &ملخص_اختبارات): فراغ {
    دع أجزاء: متجه نص = [
        "\nاختبارات SultanC: الكلي=", غير_موقع_إلى_نص((*الملخص).الكلي),
        « ناجح=», غير_موقع_إلى_نص((*الملخص).الناجح),
        « فاشل=», غير_موقع_إلى_نص((*الملخص).الفاشل),
        « متجاوز=», غير_موقع_إلى_نص((*الملخص).المتجاوز),
        « تجميع-فقط=», غير_موقع_إلى_نص((*الملخص).تجميع_فقط)
    ];
    اطبع_سطر(اجمع_نصوص(&أجزاء));
}

عرف القلعة(): عدد {
    لو (!جهز_دليل_العمل()) {
        اطبع_سطر_خطأ(«تعذر تجهيز build/tests-sultanc»);
        أرجع 2;
    };

    دع الملخص: متغير ملخص_اختبارات = ملخص_جديد();

    // الحالات ذاتية الوصف: قبول/رفض/تشغيل/تفاضل/أهداف/تشخيصات/تكافؤ السطح.
    نفذ_الاختبارات_المكتشفة(&متغير الملخص);

    // اختبارات الملكية والبنية العامة للمترجم والمكتبة القياسية.
    اختبر_البنية(&متغير الملخص);

    // واجهة CLI ونقل التشخيصات والسطح المرئي للمكتبة القياسية.
    اختبر_واجهة_المترجم(&متغير الملخص);

    // الطفرات المنظمة والتعشيق العميق ضد الانهيار والفشل الداخلي.
    اختبر_المتانة(&متغير الملخص);

    // ELF / Mach-O / الترحيلات / الحتمية / توقيع Mach-O.
    اختبر_الكائنات(&متغير الملخص);

    // RSS والشبكة الحية والتقارب الاختياري للاستضافة الذاتية.
    اختبر_النظام(&متغير الملخص);

    اطبع_الملخص(&الملخص);

    لو (الملخص.الفاشل > 0) {
        أرجع 1;
    };

    أرجع 0;
}
