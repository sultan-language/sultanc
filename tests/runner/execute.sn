استورد "common.sn";
استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد "discovery.sn";
استورد std.fs.read_file;
استورد std.sync.arc;
استورد std.sync.atomic;
استورد std.sync.mutex;
استورد std.thread.thread;
استورد std.io.println;
استورد std.text.from_bytes;

عرف اسم_تشغيل(البادئة: &نص, الفهرس: طبيعي): نص {
    ليكن العدد: نص = طبيعي_إلى_نص(الفهرس);
    ليكن أجزاء: متجه نص = [استنسخ(البادئة), «-», العدد];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف مسار_ناتج(الفهرس: طبيعي, اللاحقة: &نص): نص {
    ليكن العدد: نص = طبيعي_إلى_نص(الفهرس);
    ليكن أجزاء: متجه نص = [«build/tests-sultanc/case-», العدد, استنسخ(اللاحقة)];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف هدف_مطلوب(الوصف: &وصف_اختبار, الهدف: &نص): منطقي {
    ليكن ذراع: نص = «arm64-darwin»;
    ليكن اكس: نص = «x86_64-linux»;
    إذا (نصان_متساويان(الهدف, &ذراع)) { أرجع (*الوصف).ذراع; };
    إذا (نصان_متساويان(الهدف, &اكس)) { أرجع (*الوصف).اكس; };
    أرجع خطأ;
}

عرف لا_أهداف_محددة(الوصف: &وصف_اختبار): منطقي {
    أرجع !(*الوصف).له_أهداف;
}

عرف نفذ_فحص(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص
): نتيجة_أمر {
    ليكن الوسائط: متجه نص = [«--diagnostic-format», «short», «check», استنسخ(المصدر)];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

// The test's `// تحسين:` level, when it names one.
عرف ألحق_تحسين(الوسائط: &متغير متجه نص, التحسين: &نص): فراغ {
    إذا ((الطول(*التحسين) مثل طبيعي) > 0) { ألحق(*الوسائط, استنسخ(التحسين)); };
}

عرف جمع_كائن(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص,
    التحسين: &نص
): نتيجة_أمر {
    ليكن الوسائط: متغير متجه نص = [«-c», «--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    ألحق_تحسين(&متغير الوسائط, التحسين);
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف جمع_تنفيذي(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص,
    الربط: &متجه نص,
    التحسين: &نص
): نتيجة_أمر {
    ليكن الوسائط: متغير متجه نص = [«--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    ألحق_مكتبات_ربط(&متغير الوسائط, الربط);
    ألحق_تحسين(&متغير الوسائط, التحسين);
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

// `-l NAME` for each library a test's `// ربط:` names.
عرف ألحق_مكتبات_ربط(الوسائط: &متغير متجه نص, الربط: &متجه نص): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الربط) مثل طبيعي)) {
        ألحق(*الوسائط, «-l»);
        ألحق(*الوسائط, استنسخ(&(*الربط)[ف]));
        ف := ف + 1;
    }
}

// The assignments of a test's `// بيئة:` header, one `env` argument each:
// several are separated by spaces (`// بيئة: A=1 B=2`).
عرف إسنادات_بيئة_اختبار(الإسناد: &نص): متجه نص {
    ليكن الناتج: متغير متجه نص = [];
    ليكن البايتات: متجه ط8 = بايتات_من_نص(استنسخ(الإسناد));
    ليكن الحالي: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف <= (الطول(البايتات) مثل طبيعي)) {
        إذا (ف == (الطول(البايتات) مثل طبيعي) || البايتات[ف] == 0x20) {
            إذا ((الطول(الحالي) مثل طبيعي) > 0) { ألحق(الناتج, من_بايتات(&الحالي)); };
            ليكن فارغ: متجه ط8 = [];
            الحالي := فارغ;
        } وإلا {
            ألحق(الحالي, البايتات[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف فسر(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص,
    البيئة: &اختياري نص,
    الربط: &متجه نص,
    التحسين: &نص
): نتيجة_أمر {
    ليكن الوسائط: متغير متجه نص = [«interpret»];
    ألحق_مكتبات_ربط(&متغير الوسائط, الربط);
    ألحق_تحسين(&متغير الوسائط, التحسين);
    ألحق(الوسائط, استنسخ(المصدر));
    طابق *البيئة مع
    | اختياري.موجود(الإسناد) -> {
        ليكن وسائط_البيئة: متغير متجه نص = إسنادات_بيئة_اختبار(&الإسناد);
        ألحق(وسائط_البيئة, استنسخ(المترجم));
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الوسائط) مثل طبيعي)) { ألحق(وسائط_البيئة, استنسخ(&الوسائط[ف])); ف := ف + 1; }
        ليكن البرنامج_env: نص = مسار_env_الاختبار();
        أرجع نفذ_أمرا(&البرنامج_env, &وسائط_البيئة, الاسم);
    }
    | اختياري.لا_شيء -> { };
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

// A test program's run, with the test's environment assignment if any.
عرف شغل_برنامج_اختبار(التنفيذي: &نص, الاسم: &نص, البيئة: &اختياري نص): نتيجة_أمر {
    طابق *البيئة مع
    | اختياري.موجود(الإسناد) -> {
        ليكن وسائط_البيئة: متغير متجه نص = إسنادات_بيئة_اختبار(&الإسناد);
        ألحق(وسائط_البيئة, استنسخ(التنفيذي));
        ليكن البرنامج_env: نص = مسار_env_الاختبار();
        أرجع نفذ_أمرا(&البرنامج_env, &وسائط_البيئة, الاسم);
    }
    | اختياري.لا_شيء -> { };
    ليكن لا_وسائط: متجه نص = [];
    أرجع نفذ_أمرا(التنفيذي, &لا_وسائط, الاسم);
}

عرف طابق_المخرجات_المتوقعة(الوصف: &وصف_اختبار, النتيجة: &نتيجة_أمر): اختياري نص {
    إذا ((*الوصف).تحقق_الخرج && !نصان_متساويان(&(*الوصف).الخرج_المتوقع, &(*النتيجة).الخرج)) {
        أرجع اختياري.موجود(«الخرج القياسي لا يطابق المتوقع»);
    };
    إذا ((*الوصف).تحقق_الخطأ && !نصان_متساويان(&(*الوصف).الخطأ_المتوقع, &(*النتيجة).الخطأ)) {
        أرجع اختياري.موجود(«خرج الخطأ لا يطابق المتوقع»);
    };
    طابق (*الوصف).ملف_الخطأ_المتوقع مع
    | اختياري.موجود(المسار_المتوقع) -> {
        ليكن المتوقع: نص = اقرأ_إن_وجد(&المسار_المتوقع);
        إذا ((الطول(المتوقع) مثل طبيعي) == 0) {
            أرجع اختياري.موجود(«ملف خرج الخطأ المتوقع مفقود أو فارغ»);
        };
        إذا (!نصان_متساويان(&المتوقع, &(*النتيجة).الخطأ)) {
            أرجع اختياري.موجود(«خرج الخطأ لا يطابق ملفه المتوقع»);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// The exact human diagnostic output of the compiler in one language.
عرف طابق_خرج_تشخيص_بلغة(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: طبيعي,
    اللغة: نص,
    الملف: &اختياري نص
): اختياري نص {
    طابق *الملف مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار_المتوقع) -> {
        ليكن أجزاء_البادئة: متجه نص = [«diagnostics-», انسخ_نص_اختبار(&اللغة)];
        ليكن البادئة: نص = اجمع_نصوص(&أجزاء_البادئة);
        ليكن الاسم: نص = اسم_تشغيل(&البادئة, الفهرس);
        ليكن الوسائط: متجه نص = [«--lang», انسخ_نص_اختبار(&اللغة), «--color», «never», «check», انسخ_نص_اختبار(&(*الوصف).المسار)];
        ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(المترجم, &الوسائط, &الاسم);
        ليكن المتوقع: نص = اقرأ_إن_وجد(&المسار_المتوقع);
        إذا ((الطول(المتوقع) مثل طبيعي) == 0) {
            أرجع اختياري.موجود(«ملف خرج التشخيص المتوقع مفقود أو فارغ»);
        };
        إذا (!نصان_متساويان(&المتوقع, &النتيجة.الخطأ)) {
            ليكن أجزاء: متجه نص = [
                «خرج التشخيص لا يطابق », انسخ_نص_اختبار(&المسار_المتوقع),
                وصف_أول_اختلاف(&المتوقع, &النتيجة.الخطأ)
            ];
            أرجع اختياري.موجود(اجمع_نصوص(&أجزاء));
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_مرحلة0(
    الوصف: &وصف_اختبار,
    نتيجة_المترجم: &نتيجة_أمر,
    الفهرس: طبيعي
): اختياري نص {
    إذا (!(*الوصف).مرحلة0) { أرجع اختياري.لا_شيء(); };
    طابق مسار_مترجم_المرحلة0() مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المرحلة0) -> {
        طابق الهدف_المضيف() مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(«لا يمكن تحديد الهدف المضيف لمقارنة Stage0»); }
        | اختياري.موجود(الهدف) -> {
            ليكن لاحقة_مرحلة0: نص = «.stage0.o»;
            ليكن بادئة_مرحلة0: نص = «stage0»;
            ليكن الناتج: نص = مسار_ناتج(الفهرس, &لاحقة_مرحلة0);
            ليكن الاسم: نص = اسم_تشغيل(&بادئة_مرحلة0, الفهرس);
            ليكن الوسائط: متجه نص = [استنسخ(&(*الوصف).المسار), «--target», الهدف, «-o», الناتج];
            ليكن النتيجة: نتيجة_أمر = نفذ_أمرا(&المرحلة0, &الوسائط, &الاسم);
            طابق (*الوصف).النمط مع
            | نمط_اختبار.قبول -> {
                إذا (النتيجة.الحالة != 0) { أرجع اختياري.موجود(«Stage0 رفض مصدرا يقبله المترجم الذاتي»); };
            }
            | نمط_اختبار.رفض -> {
                إذا (النتيجة.الحالة == 0) { أرجع اختياري.موجود(«Stage0 قبل مصدرا يرفضه المترجم الذاتي»); };
                طابق (*الوصف).التشخيص مع
                | اختياري.موجود(الكود) -> {
                    إذا ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                        أرجع اختياري.موجود(«Stage0 لم يعرض معرف التشخيص المتوقع»);
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف نفذ_قبول_أو_رفض(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: طبيعي
): اختياري نص {
    ليكن بادئة_فحص: نص = «check»;
    ليكن الاسم: نص = اسم_تشغيل(&بادئة_فحص, الفهرس);
    ليكن النتيجة: نتيجة_أمر = نفذ_فحص(المترجم, &(*الوصف).المسار, &الاسم);
    إذا (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
        أرجع اختياري.موجود(«حدث فشل داخلي للمترجم»);
    };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> {
        إذا (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختياري.موجود(«حالة قبول المصدر لا تطابق المتوقع»);
        };
        // An accepted program may still carry a warning: `// تشخيص:` names it.
        طابق (*الوصف).التشخيص مع
        | اختياري.موجود(الكود) -> {
            إذا ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                أرجع اختياري.موجود(«التحذير المتوقع غير موجود»);
            };
        }
        | اختياري.لا_شيء -> { };
        // `// خطأ-قياسي: <فارغ>` states that `check` reports nothing.
        طابق طابق_المخرجات_المتوقعة(الوصف, &النتيجة) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        // The exact warnings, per language, when the test names a file for them
        // (`// خرج-تشخيص-عربي:` / `// خرج-تشخيص-إنجليزي:`), as for a rejection.
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «ar», &(*الوصف).خرج_التشخيص_العربي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «en», &(*الوصف).خرج_التشخيص_الإنجليزي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
    }
    | نمط_اختبار.رفض -> {
        إذا (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختياري.موجود(«حالة رفض المصدر لا تطابق المتوقع»);
        };
        طابق (*الوصف).التشخيص مع
        | اختياري.موجود(الكود) -> {
            إذا ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                أرجع اختياري.موجود(«معرف التشخيص المتوقع غير موجود»);
            };
        }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «ar», &(*الوصف).خرج_التشخيص_العربي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «en», &(*الوصف).خرج_التشخيص_الإنجليزي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };

    ليكن هو_قبول: متغير منطقي = خطأ;
    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> { هو_قبول := صواب; }
    | _ -> { };
    إذا (هو_قبول && (!لا_أهداف_محددة(الوصف))) {
        ليكن الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
        ليكن ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الأهداف) مثل طبيعي)) {
            إذا (هدف_مطلوب(الوصف, &الأهداف[ت])) {
                ليكن أجزاء_لاحقة: متجه نص = [«-accept-», انسخ_نص_اختبار(&الأهداف[ت]), «.o»];
                ليكن لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
                ليكن الناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
                ليكن بادئة: نص = «accept-target»;
                ليكن اسم_هدف: نص = اسم_تشغيل(&بادئة, الفهرس);
                ليكن جمع: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ت], &الناتج, &اسم_هدف, &(*الوصف).التحسين);
                إذا (جمع.الحالة != 0) { أرجع اختياري.موجود(«فشل تجميع اختبار القبول للهدف المطلوب»); };
                إذا (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختياري.موجود(«فشل داخلي أثناء تجميع اختبار القبول»); };
            };
            ت := ت + 1;
        }
    };

    طابق تحقق_مرحلة0(الوصف, &النتيجة, الفهرس) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    أرجع اختياري.لا_شيء();
}

عرف جمع_كل_الأهداف(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي
): اختياري نص {
    ليكن الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        ليكن مطلوب: متغير منطقي = هدف_مطلوب(الوصف, &الأهداف[ف]);
        إذا (لا_أهداف_محددة(الوصف)) { مطلوب := صواب; };
        إذا (مطلوب) {
            ليكن أجزاء_لاحقة: متجه نص = [«-», انسخ_نص_اختبار(&الأهداف[ف]), «.o»];
            ليكن لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
            ليكن ناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
            ليكن بادئة_كائن: نص = «object»;
            ليكن اسم: نص = اسم_تشغيل(&بادئة_كائن, الفهرس);
            ليكن النتيجة: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ف], &ناتج, &اسم, &(*الوصف).التحسين);
            إذا (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) { أرجع اختياري.موجود(«فشل داخلي أثناء تجميع هدف»); };
            إذا (النتيجة.الحالة != 0) { أرجع اختياري.موجود(«فشل تجميع أحد الأهداف»); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نفذ_تشغيل_أو_تفاضل(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي
): اختياري نص {
    طابق جمع_كل_الأهداف(الوصف, المترجم, المضيف, الفهرس) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    إذا ((!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف))) {
        أرجع اختياري.لا_شيء();
    };

    ليكن لاحقة_تنفيذي: نص = «-native»;
    ليكن بادئة_بناء: نص = «native-build»;
    ليكن بادئة_تشغيل: نص = «native-run»;
    ليكن بادئة_تفسير: نص = «interpret»;
    ليكن التنفيذي: نص = مسار_ناتج(الفهرس, &لاحقة_تنفيذي);
    ليكن اسم_جمع: نص = اسم_تشغيل(&بادئة_بناء, الفهرس);
    ليكن جمع: نتيجة_أمر = جمع_تنفيذي(المترجم, &(*الوصف).المسار, المضيف, &التنفيذي, &اسم_جمع, &(*الوصف).الربط, &(*الوصف).التحسين);
    إذا (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختياري.موجود(«فشل داخلي أثناء بناء التنفيذي»); };
    إذا (جمع.الحالة != 0) { أرجع اختياري.موجود(«فشل بناء التنفيذي المضيف»); };

    ليكن اسم_تشغيل_فعلي: نص = اسم_تشغيل(&بادئة_تشغيل, الفهرس);
    // ملفات الاختبار تفسر المسارات النسبية من جذر المستودع مثل اكتشاف المصادر وتجميعها.
    ليكن تشغيل: نتيجة_أمر = شغل_برنامج_اختبار(&التنفيذي, &اسم_تشغيل_فعلي, &(*الوصف).البيئة);
    إذا (نتيجة_تشغيل_تحوي_فشلا_داخليا(&تشغيل)) { أرجع اختياري.موجود(«فشل داخلي أثناء تشغيل البرنامج»); };
    إذا (تشغيل.الحالة != (*الوصف).المتوقع) { أرجع اختياري.موجود(«حالة تشغيل البرنامج لا تطابق المتوقع»); };
    طابق طابق_المخرجات_المتوقعة(الوصف, &تشغيل) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.تفاضلي -> {
        ليكن اسم_تفسير: نص = اسم_تشغيل(&بادئة_تفسير, الفهرس);
        ليكن تفسير: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_تفسير, &(*الوصف).البيئة, &(*الوصف).الربط, &(*الوصف).التحسين);
        إذا (نتيجة_تشغيل_تحوي_فشلا_داخليا(&تفسير)) { أرجع اختياري.موجود(«فشل داخلي في المفسر»); };
        إذا (تفسير.الحالة != (*الوصف).المتوقع) { أرجع اختياري.موجود(«حالة المفسر لا تطابق المتوقع»); };
        إذا (تفسير.الحالة != تشغيل.الحالة) { أرجع اختياري.موجود(«اختلاف حالة المفسر والتنفيذي»); };
        إذا (!نصان_متساويان(&تفسير.الخرج, &تشغيل.الخرج)) { أرجع اختياري.موجود(«اختلاف الخرج بين المفسر والتنفيذي»); };
        إذا ((*الوصف).تفاضلي_كامل && !نصان_متساويان(&تفسير.الخطأ, &تشغيل.الخطأ)) {
            أرجع اختياري.موجود(«اختلاف خرج الخطأ بين المفسر والتنفيذي»);
        };
    }
    | _ -> { };

    أرجع اختياري.لا_شيء();
}

عرف نفذ_زوج_سطح(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي
): اختياري نص {
    // A reject pair is two reject tests, each checked on its own; the pair
    // run and object builds below apply only to programs that compile.
    طابق (*الوصف).النمط مع
    | نمط_اختبار.رفض -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    طابق (*الوصف).النظير مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النظير) -> {
        ليكن جذر_انجليزي: نص = «tests/en/»;
        إذا (!يبدأ_بـ(&(*الوصف).المسار, &جذر_انجليزي)) { أرجع اختياري.لا_شيء(); };
        أرجع نفذ_زوجا_لمسارين(الوصف, &النظير, المترجم, المضيف, الفهرس);
    };
}

// Interprets both twins and compares them only where the test runs on this
// host: a run or differential test whose `// أهداف:` leave the host out is
// compile-only here (اختبار_تجميع_فقط, counted as تجميع-فقط), so its pair is
// only built for each target, as its run step is.
عام عرف زوج_السطح_يفسر_على(الوصف: &وصف_اختبار, المضيف: &نص): منطقي {
    أرجع !اختبار_تجميع_فقط(الوصف, المضيف);
}

// The pair step of an English test and its twin: both interpreted (where
// the test runs on المضيف) with the same exit status and output, then both
// built for each target.
عام عرف نفذ_زوجا_لمسارين(
    الوصف: &وصف_اختبار,
    النظير: &نص,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي
): اختياري نص {
    إذا (زوج_السطح_يفسر_على(الوصف, المضيف)) {
        ليكن بادئة_سطح_أ: نص = «surface-a»;
        ليكن بادئة_سطح_ب: نص = «surface-b»;
        ليكن اسم_أ: نص = اسم_تشغيل(&بادئة_سطح_أ, الفهرس);
        ليكن اسم_ب: نص = اسم_تشغيل(&بادئة_سطح_ب, الفهرس);
        ليكن أ: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_أ, &(*الوصف).البيئة, &(*الوصف).الربط, &(*الوصف).التحسين);
        ليكن ب: نتيجة_أمر = فسر(المترجم, النظير, &اسم_ب, &(*الوصف).البيئة, &(*الوصف).الربط, &(*الوصف).التحسين);
        إذا ((أ.الحالة != (*الوصف).المتوقع) || (ب.الحالة != (*الوصف).المتوقع)) {
            أرجع اختياري.موجود(«اختلاف حالة زوج السطح»);
        };
        إذا (!نصان_متساويان(&أ.الخرج, &ب.الخرج)) {
            أرجع اختياري.موجود(«اختلاف خرج السطح العربي والإنجليزي»);
        };
    };
    ليكن الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
    ليكن ن: متغير طبيعي = 0;
    طالما (ن < 2) {
        // Only the host targets the test lists (all, without a list), as
        // its own object step (جمع_كل_الأهداف): a 32-bit-only pair is
        // built for neither.
        إذا (لا_أهداف_محددة(الوصف) || هدف_مطلوب(الوصف, &الأهداف[ن])) {
            ليكن لاحقة_أجزاء: متجه نص = [«-pair-a-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            ليكن لاحقة_أ: نص = اجمع_نصوص(&لاحقة_أجزاء);
            ليكن لاحقة_ب_أجزاء: متجه نص = [«-pair-b-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            ليكن لاحقة_ب: نص = اجمع_نصوص(&لاحقة_ب_أجزاء);
            ليكن ناتج_أ: نص = مسار_ناتج(الفهرس, &لاحقة_أ);
            ليكن ناتج_ب: نص = مسار_ناتج(الفهرس, &لاحقة_ب);
            ليكن بادئة_جمع_أ: نص = «pair-build-a»;
            ليكن بادئة_جمع_ب: نص = «pair-build-b»;
            ليكن اسم_جمع_أ: نص = اسم_تشغيل(&بادئة_جمع_أ, الفهرس);
            ليكن اسم_جمع_ب: نص = اسم_تشغيل(&بادئة_جمع_ب, الفهرس);
            ليكن جمع_أ: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ن], &ناتج_أ, &اسم_جمع_أ, &(*الوصف).التحسين);
            ليكن جمع_ب: نتيجة_أمر = جمع_كائن(المترجم, النظير, &الأهداف[ن], &ناتج_ب, &اسم_جمع_ب, &(*الوصف).التحسين);
            إذا ((جمع_أ.الحالة != 0) || (جمع_ب.الحالة != 0)) { أرجع اختياري.موجود(«فشل تجميع زوج السطح»); };
        };
        ن := ن + 1;
    }
    أرجع اختياري.لا_شيء();
}

// The pair step honours `// أهداف:` (tests/runner/fixtures/pair_targets):
// a pair for x86_64-linux only is not interpreted on arm64-darwin, where it
// is compile-only, and is on x86_64-linux; a pair without targets is
// interpreted on both. Each fixture exits 3 against an expected 0, so a
// pair step that interprets reports «اختلاف حالة زوج السطح». The host is
// named here, so both answers are checked on every machine.
عرف وصف_مثبت_زوج(المسار: &نص): اختياري وصف_اختبار {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(المصدر) -> { أرجع حلل_وصف_اختبار(المسار, &المصدر); };
}

عرف تحقق_زوج_مثبت(
    الملخص: &متغير ملخص_اختبارات,
    المترجم: &نص,
    المسار: نص,
    المضيف: نص,
    يفسر: منطقي,
    الفهرس: طبيعي
): فراغ {
    ليكن أجزاء_الاسم: متجه نص = [«أهداف زوج السطح: », استنسخ(&المسار), « على », استنسخ(&المضيف)];
    ليكن الاسم: نص = اجمع_نصوص(&أجزاء_الاسم);
    طابق وصف_مثبت_زوج(&المسار) مع
    | اختياري.لا_شيء -> { ليكن سبب: نص = «تعذرت قراءة المثبت أو تحليل ترويسته»; سجل_فشل(الملخص, &الاسم, &سبب); }
    | اختياري.موجود(الوصف) -> {
        طابق الوصف.النظير مع
        | اختياري.لا_شيء -> { ليكن سبب: نص = «المثبت بلا نظير»; سجل_فشل(الملخص, &الاسم, &سبب); }
        | اختياري.موجود(النظير) -> {
            إذا (زوج_السطح_يفسر_على(&الوصف, &المضيف) != يفسر) {
                ليكن سبب: نص = «قرار تفسير الزوج لا يطابق أهداف الاختبار»;
                سجل_فشل(الملخص, &الاسم, &سبب);
                أرجع;
            };
            ليكن النتيجة: اختياري نص = نفذ_زوجا_لمسارين(&الوصف, &النظير, المترجم, &المضيف, الفهرس);
            ليكن المتوقع: نص = «اختلاف حالة زوج السطح»;
            طابق النتيجة مع
            | اختياري.موجود(السبب) -> {
                إذا (يفسر && نصان_متساويان(&السبب, &المتوقع)) { سجل_نجاح(الملخص, &الاسم); أرجع; };
                سجل_فشل(الملخص, &الاسم, &السبب);
            }
            | اختياري.لا_شيء -> {
                إذا (!يفسر && اختبار_تجميع_فقط(&الوصف, &المضيف)) { سجل_نجاح(الملخص, &الاسم); أرجع; };
                ليكن سبب: نص = «خطوة الزوج لم تفسر زوجا يعمل على هذا المضيف»;
                سجل_فشل(الملخص, &الاسم, &سبب);
            };
        };
    };
}

عام عرف اختبر_أهداف_زوج_السطح(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن المترجم: نص = مسار_المترجم();
    ليكن لينكس_فقط: نص = «tests/runner/fixtures/pair_targets/linux_only_en.sn»;
    ليكن كل_المضيفين: نص = «tests/runner/fixtures/pair_targets/all_hosts_en.sn»;
    // Output indices past the discovered tests' (case-<n> files).
    تحقق_زوج_مثبت(الملخص, &المترجم, استنسخ(&لينكس_فقط), «arm64-darwin», خطأ, 900001);
    تحقق_زوج_مثبت(الملخص, &المترجم, استنسخ(&لينكس_فقط), «x86_64-linux», صواب, 900002);
    تحقق_زوج_مثبت(الملخص, &المترجم, استنسخ(&كل_المضيفين), «arm64-darwin», صواب, 900003);
    تحقق_زوج_مثبت(الملخص, &المترجم, استنسخ(&كل_المضيفين), «x86_64-linux», صواب, 900004);
}

// اختبار تشغيل أو تفاضل بأهداف لا تشمل المضيف يُجمَّع كائنات فقط.
عرف اختبار_تجميع_فقط(الوصف: &وصف_اختبار, المضيف: &نص): منطقي {
    طابق (*الوصف).النمط مع
    | نمط_اختبار.تشغيل -> { أرجع (!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف)); }
    | نمط_اختبار.تفاضلي -> { أرجع (!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف)); }
    | _ -> { أرجع خطأ; };
}

// One discovered test's outcome: its problem (none when it passed) and
// whether a run test was only compiled here.
نوع نتيجة_اختبار_منفذ = {
    منفذ: منطقي,
    المشكلة: اختياري نص,
    تجميع_فقط: منطقي,
    متجاوز: منطقي
};

// A run test only compiled here (its targets leave the host out) that
// imports C, on a Windows host: Windows has no C headers of the targets the
// runner builds it for (Linux, macOS), as a Linux host lends its own for
// macOS, so it needs those targets' headers through SULTANC_C_SYSROOT (a
// sysroot holding a libc's headers for each target the tests
// need). Skipped without one.
عرف سبب_تجاوز_ترويسات_سي(الوصف: &وصف_اختبار, المضيف: &نص): اختياري نص {
    إذا (!هدف_ويندوز(المضيف) || !اختبار_تجميع_فقط(الوصف, المضيف)) { أرجع اختياري.لا_شيء(); };
    ليكن اسم_الجذر: نص = «SULTANC_C_SYSROOT»;
    ليكن فارغ: نص = «»;
    ليكن الجذر: نص = قيمة_متغير_بيئة_أو(&اسم_الجذر, &فارغ);
    إذا (!نصان_متساويان(&الجذر, &فارغ)) { أرجع اختياري.لا_شيء(); };
    إذا (!يستورد_سي(&(*الوصف).المسار)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(«يحتاج ترويسات سي لأهدافه (SULTANC_C_SYSROOT) على مضيف Windows»);
}

// Whether a test's source imports a C header or file (`import "x.h"`,
// `استورد "x.c"`).
عرف يستورد_سي(المسار: &نص): منطقي {
    طابق اقرأ_الملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(النص) -> {
        ليكن اللواحق: متجه نص = [".h\";", ".c\";", ".h»;", ".c»;"];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(اللواحق) مثل طبيعي)) {
            إذا (يحتوي_نصا(&النص, &اللواحق[ف])) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    };
}

// What the workers share, read only: the tests, the units of work (test
// indexes run together by one worker), the compiler and the host target.
نوع عمل_الاختبارات = {
    الاختبارات: متجه وصف_اختبار,
    الوحدات: متجه متجه طبيعي,
    المترجم: نص,
    المضيف: نص
};

// Runs test ف and prints its PASS/FAIL line at once (the log shows progress
// even when a CI step's time runs out).
عرف نفذ_اختبارا_مكتشفا(العمل: &عمل_الاختبارات, ف: طبيعي): نتيجة_اختبار_منفذ {
    ليكن الوصف: &وصف_اختبار = &(*العمل).الاختبارات[ف];
    ليكن المترجم: &نص = &(*العمل).المترجم;
    ليكن المضيف: &نص = &(*العمل).المضيف;
    ليكن المشكلة: متغير اختياري نص = اختياري.لا_شيء();
    طابق سبب_تجاوز_ترويسات_سي(الوصف, المضيف) مع
    | اختياري.موجود(السبب) -> {
        ليكن أجزاء_تجاوز: متجه نص = ["SKIP\t", استنسخ(&(*الوصف).المسار), "\t", استنسخ(&السبب)];
        اطبع_سطر(اجمع_نصوص(&أجزاء_تجاوز));
        ليكن المتجاوز: نتيجة_اختبار_منفذ = { منفذ: صواب, المشكلة: اختياري.لا_شيء(), تجميع_فقط: خطأ, متجاوز: صواب };
        أرجع المتجاوز;
    }
    | اختياري.لا_شيء -> { };
    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, المترجم, ف); }
    | نمط_اختبار.رفض -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, المترجم, ف); }
    | نمط_اختبار.تشغيل -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, المترجم, المضيف, ف); }
    | نمط_اختبار.تفاضلي -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, المترجم, المضيف, ف); };
    طابق المشكلة مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { المشكلة := نفذ_زوج_سطح(الوصف, المترجم, المضيف, ف); };
    ليكن للتجميع: متغير منطقي = خطأ;
    طابق انسخ_اختيار_نص(&المشكلة) مع
    | اختياري.موجود(السبب) -> {
        ليكن أجزاء: متجه نص = ["FAIL\t", استنسخ(&(*الوصف).المسار), "\t", استنسخ(&السبب)];
        اطبع_سطر_خطأ(اجمع_نصوص(&أجزاء));
    }
    | اختياري.لا_شيء -> {
        ليكن أجزاء: متجه نص = ["PASS\t", استنسخ(&(*الوصف).المسار)];
        اطبع_سطر(اجمع_نصوص(&أجزاء));
        // اختبار تشغيل لا يشمل المضيف: جُمِّع فقط ولم يُشغَّل.
        للتجميع := اختبار_تجميع_فقط(الوصف, المضيف);
    };
    ليكن النتيجة: نتيجة_اختبار_منفذ = { منفذ: صواب, المشكلة: المشكلة, تجميع_فقط: للتجميع, متجاوز: خطأ };
    أرجع النتيجة;
}

// A worker: takes the next unit until none is left, and stores each test's
// outcome at its index.
عرف عامل_اختبارات(
    العمل: &مشترك<عمل_الاختبارات>,
    التالي: &مشترك<ذرة_ط64>,
    النتائج: &مشترك<قفل<متجه نتيجة_اختبار_منفذ>>
): فراغ {
    ليكن ع: &عمل_الاختبارات = اقرأ_مشترك(العمل);
    ليكن العدد: ط64 = الطول((*ع).الوحدات) مثل ط64;
    طالما (صواب) {
        ليكن الوحدة: ط64 = اجمع_واجلب_ط64(اقرأ_مشترك(التالي), 1 مثل ط64, ترتيب_ذاكرة.تسلسلي());
        إذا (الوحدة >= العدد) { أرجع; };
        ليكن الفهارس: &متجه طبيعي = &(*ع).الوحدات[الوحدة مثل طبيعي];
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(*الفهارس) مثل طبيعي)) {
            ليكن ف: طبيعي = (*الفهارس)[ك];
            ليكن النتيجة: نتيجة_اختبار_منفذ = نفذ_اختبارا_مكتشفا(ع, ف);
            ليكن القفل: &قفل<متجه نتيجة_اختبار_منفذ> = اقرأ_مشترك(النتائج);
            اقفل_خام(القفل);
            ليكن القيم: *متغير متجه نتيجة_اختبار_منفذ = مؤشر_قيمة_القفل(القفل);
            غير_آمن { (*القيم)[ف] := النتيجة; }
            افتح_خام(القفل);
            ك := ك + 1;
        }
    }
}

// The copies a worker's closure captures live in this frame until it ends.
عرف أطلق_عامل_اختبارات(
    العمل: &مشترك<عمل_الاختبارات>,
    التالي: &مشترك<ذرة_ط64>,
    النتائج: &مشترك<قفل<متجه نتيجة_اختبار_منفذ>>
): اختياري مقبض_خيط {
    ليكن عملي: مشترك<عمل_الاختبارات> = استنسخ_مشترك(العمل);
    ليكن تاليي: مشترك<ذرة_ط64> = استنسخ_مشترك(التالي);
    ليكن نتائجي: مشترك<قفل<متجه نتيجة_اختبار_منفذ>> = استنسخ_مشترك(النتائج);
    طابق أطلق(دالة(): فراغ -> عامل_اختبارات(&عملي, &تاليي, &نتائجي)) مع
    | نتيجة.نجح(م) -> { أرجع اختياري.موجود(م); }
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
}

// A test that uses the network, clocks, threads, processes, the file system
// or the environment runs alone: two at once could take the same port or
// temporary path, and timing assertions would miss on a loaded machine.
عرف اختبار_منفرد(الوصف: &وصف_اختبار): منطقي {
    ليكن المصدر: نص = اقرأ_إن_وجد(&(*الوصف).المسار);
    ليكن المشتركة: متجه نص = [
        «std.net», «std.http», «std.tls», «std.async», «std.time», «std.thread», «std.sync»,
        «std.process», «std.fs», «std.env», «std.os»
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المشتركة) مثل طبيعي)) {
        طابق ابحث_نصا(&المصدر, &المشتركة[ف]) مع
        | اختياري.موجود(_) -> { أرجع صواب; }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// The number of workers: SULTANC_TEST_JOBS, else the available processors.
عرف عدد_العمال(): طبيعي {
    ليكن اسم: نص = «SULTANC_TEST_JOBS»;
    ليكن فارغ: نص = «»;
    ليكن النص: نص = قيمة_متغير_بيئة_أو(&اسم, &فارغ);
    طابق حلل_طبيعي(&النص) مع
    | نتيجة.نجح(ن) -> { إذا (ن > 0) { أرجع ن; }; }
    | نتيجة.خطأ(_) -> { };
    طابق عدد_المعالجات_المتاحة() مع
    | نتيجة.نجح(ن) -> { إذا (ن > 0) { أرجع ن; }; }
    | نتيجة.خطأ(_) -> { };
    أرجع 1;
}

// Discovered tests run as units: an English test with its Arabic twin (the
// pair step reads the twin, so the two never run at once), any other test
// alone. Units with shared resources (اختبار_منفرد) run one at a time after
// the others, which run on عدد_العمال workers. The summary is counted in
// discovery order afterwards, so it does not depend on the schedule.
عام عرف نفذ_الاختبارات_المكتشفة(الملخص: &متغير ملخص_اختبارات): فراغ {
    ليكن الاختبارات: متجه وصف_اختبار;
    طابق اكتشف_الاختبارات() مع
    | نتيجة.خطأ(الخطأ) -> { ليكن اسم_اكتشاف: نص = «اكتشاف الاختبارات»; سجل_فشل(الملخص, &اسم_اكتشاف, &الخطأ); أرجع; }
    | نتيجة.نجح(ق) -> { الاختبارات := ق; };
    ليكن المضيف: نص;
    طابق الهدف_المضيف() مع
    | اختياري.لا_شيء -> { ليكن اسم_الهدف: نص = «الهدف المضيف»; ليكن سبب_الهدف: نص = «هدف مضيف غير مدعوم»; سجل_فشل(الملخص, &اسم_الهدف, &سبب_الهدف); أرجع; }
    | اختياري.موجود(م) -> { المضيف := م; };
    ليكن العدد: طبيعي = الطول(الاختبارات) مثل طبيعي;

    // Units, and the twin of each English test.
    ليكن مجمع: متغير متجه منطقي = [];
    ليكن منفرد: متغير متجه منطقي = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(مجمع, خطأ); ألحق(منفرد, اختبار_منفرد(&الاختبارات[ف])); ف := ف + 1; }
    ليكن المتوازية: متغير متجه متجه طبيعي = [];
    ليكن المتتالية: متغير متجه متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        إذا (!مجمع[ف]) {
            مجمع[ف] := صواب;
            ليكن الوحدة: متغير متجه طبيعي = [ف];
            ليكن وحيدة: متغير منطقي = منفرد[ف];
            طابق الاختبارات[ف].النظير مع
            | اختياري.موجود(النظير) -> {
                ليكن ك: متغير طبيعي = 0;
                طالما (ك < العدد) {
                    إذا (!مجمع[ك] && نصان_متساويان(&الاختبارات[ك].المسار, &النظير)) {
                        مجمع[ك] := صواب;
                        ألحق(الوحدة, ك);
                        إذا (منفرد[ك]) { وحيدة := صواب; };
                        ك := العدد;
                    };
                    ك := ك + 1;
                }
            }
            | اختياري.لا_شيء -> { };
            إذا (وحيدة) { ألحق(المتتالية, الوحدة); } وإلا { ألحق(المتوازية, الوحدة); };
        };
        ف := ف + 1;
    }

    ليكن لم_ينفذ: نتيجة_اختبار_منفذ = { منفذ: خطأ, المشكلة: اختياري.لا_شيء(), تجميع_فقط: خطأ, متجاوز: خطأ };
    ليكن الفارغة: متغير متجه نتيجة_اختبار_منفذ = [];
    ف := 0;
    طالما (ف < العدد) {
        ليكن نسخة: نتيجة_اختبار_منفذ = { منفذ: خطأ, المشكلة: اختياري.لا_شيء(), تجميع_فقط: خطأ, متجاوز: خطأ };
        ألحق(الفارغة, نسخة);
        ف := ف + 1;
    }
    ليكن النتائج: مشترك<قفل<متجه نتيجة_اختبار_منفذ>> = أنشئ_مشترك(أنشئ_قفل(الفارغة));
    ليكن المترجم: نص = مسار_المترجم();
    ليكن العمل_المتوازي: عمل_الاختبارات = {
        الاختبارات: الاختبارات, الوحدات: المتوازية, المترجم: استنسخ(&المترجم), المضيف: استنسخ(&المضيف)
    };
    ليكن المشترك: مشترك<عمل_الاختبارات> = أنشئ_مشترك(العمل_المتوازي);
    ليكن التالي: مشترك<ذرة_ط64> = أنشئ_مشترك(أنشئ_ذرة_ط64(0 مثل ط64));

    // This thread is one of the workers; a worker that cannot start leaves
    // its share to the others.
    ليكن العمال: متغير متجه مقبض_خيط = [];
    ليكن ع: متغير طبيعي = 1;
    ليكن الكل: طبيعي = عدد_العمال();
    طالما (ع < الكل) {
        طابق أطلق_عامل_اختبارات(&المشترك, &التالي, &النتائج) مع
        | اختياري.موجود(م) -> { ألحق(العمال, م); }
        | اختياري.لا_شيء -> { ع := الكل; };
        ع := ع + 1;
    }
    عامل_اختبارات(&المشترك, &التالي, &النتائج);
    طالما ((الطول(العمال) مثل طبيعي) > 0) {
        طابق أزل_الأخير(العمال) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> { ليكن م: متغير مقبض_خيط = المقبض; انضم(&متغير م); };
    }

    // The units with shared resources, one at a time.
    ليكن ع_م: &عمل_الاختبارات = اقرأ_مشترك(&المشترك);
    ليكن القفل: &قفل<متجه نتيجة_اختبار_منفذ> = اقرأ_مشترك(&النتائج);
    ليكن القيم: *متغير متجه نتيجة_اختبار_منفذ = مؤشر_قيمة_القفل(القفل);
    ليكن و: متغير طبيعي = 0;
    طالما (و < (الطول(المتتالية) مثل طبيعي)) {
        ليكن ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المتتالية[و]) مثل طبيعي)) {
            ليكن ت: طبيعي = المتتالية[و][ك];
            ليكن النتيجة: نتيجة_اختبار_منفذ = نفذ_اختبارا_مكتشفا(ع_م, ت);
            غير_آمن { (*القيم)[ت] := النتيجة; }
            ك := ك + 1;
        }
        و := و + 1;
    }

    // The summary, in discovery order.
    ف := 0;
    طالما (ف < العدد) {
        ليكن النتيجة: &نتيجة_اختبار_منفذ;
        غير_آمن { النتيجة := &(*القيم)[ف]; }
        (*الملخص).الكلي := (*الملخص).الكلي + 1;
        طابق (*النتيجة).المشكلة مع
        | اختياري.موجود(_) -> { (*الملخص).الفاشل := (*الملخص).الفاشل + 1; }
        | اختياري.لا_شيء -> {
            إذا ((*النتيجة).متجاوز) {
                (*الملخص).المتجاوز := (*الملخص).المتجاوز + 1;
            } وإلا إذا ((*النتيجة).منفذ) {
                (*الملخص).الناجح := (*الملخص).الناجح + 1;
                إذا ((*النتيجة).تجميع_فقط) { سجل_تجميع_فقط(الملخص); };
            } وإلا {
                (*الملخص).الفاشل := (*الملخص).الفاشل + 1;
            };
        };
        ف := ف + 1;
    }
}
