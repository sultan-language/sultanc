استورد "common.sn";
استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد "discovery.sn";

عرف اسم_تشغيل(البادئة: &نص, الفهرس: طبيعي): نص {
    دع العدد: نص = طبيعي_إلى_نص(الفهرس);
    دع أجزاء: متجه نص = [استنسخ(البادئة), «-», العدد];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف مسار_ناتج(الفهرس: طبيعي, اللاحقة: &نص): نص {
    دع العدد: نص = طبيعي_إلى_نص(الفهرس);
    دع أجزاء: متجه نص = [«build/tests-sultanc/case-», العدد, استنسخ(اللاحقة)];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف هدف_مطلوب(الوصف: &وصف_اختبار, الهدف: &نص): منطقي {
    دع ذراع: نص = «arm64-darwin»;
    دع اكس: نص = «x86_64-linux»;
    لو (نصان_متساويان(الهدف, &ذراع)) { أرجع (*الوصف).ذراع; };
    لو (نصان_متساويان(الهدف, &اكس)) { أرجع (*الوصف).اكس; };
    أرجع خطأ;
}

عرف لا_أهداف_محددة(الوصف: &وصف_اختبار): منطقي {
    أرجع (!(*الوصف).ذراع) && (!(*الوصف).اكس);
}

عرف نفذ_فحص(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«--diagnostic-format», «short», «check», استنسخ(المصدر)];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف جمع_كائن(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«-c», «--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف جمع_تنفيذي(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«--target», استنسخ(الهدف), استنسخ(المصدر), «-o», استنسخ(الناتج)];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف فسر(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص,
    البيئة: &اختياري نص
): نتيجة_أمر {
    طابق *البيئة مع
    | اختياري.موجود(الإسناد) -> {
        دع وسائط_البيئة: متجه نص = [استنسخ(&الإسناد), استنسخ(المترجم), «interpret», استنسخ(المصدر)];
        دع البرنامج_env: نص = «/usr/bin/env»;
        أرجع نفذ_أمرا(&البرنامج_env, &وسائط_البيئة, الاسم);
    }
    | اختياري.لا_شيء -> { };
    دع الوسائط: متجه نص = [«interpret», استنسخ(المصدر)];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

// A test program's run, with the test's environment assignment if any.
عرف شغل_برنامج_اختبار(التنفيذي: &نص, الاسم: &نص, البيئة: &اختياري نص): نتيجة_أمر {
    طابق *البيئة مع
    | اختياري.موجود(الإسناد) -> {
        دع وسائط_البيئة: متجه نص = [استنسخ(&الإسناد), استنسخ(التنفيذي)];
        دع البرنامج_env: نص = «/usr/bin/env»;
        أرجع نفذ_أمرا(&البرنامج_env, &وسائط_البيئة, الاسم);
    }
    | اختياري.لا_شيء -> { };
    دع لا_وسائط: متجه نص = [];
    أرجع نفذ_أمرا(التنفيذي, &لا_وسائط, الاسم);
}

عرف طابق_المخرجات_المتوقعة(الوصف: &وصف_اختبار, النتيجة: &نتيجة_أمر): اختياري نص {
    لو ((*الوصف).تحقق_الخرج && !نصان_متساويان(&(*الوصف).الخرج_المتوقع, &(*النتيجة).الخرج)) {
        أرجع اختياري.موجود(«الخرج القياسي لا يطابق المتوقع»);
    };
    لو ((*الوصف).تحقق_الخطأ && !نصان_متساويان(&(*الوصف).الخطأ_المتوقع, &(*النتيجة).الخطأ)) {
        أرجع اختياري.موجود(«خرج الخطأ لا يطابق المتوقع»);
    };
    طابق (*الوصف).ملف_الخطأ_المتوقع مع
    | اختياري.موجود(المسار_المتوقع) -> {
        دع المتوقع: نص = اقرأ_إن_وجد(&المسار_المتوقع);
        لو ((الطول(المتوقع) مثل طبيعي) == 0) {
            أرجع اختياري.موجود(«ملف خرج الخطأ المتوقع مفقود أو فارغ»);
        };
        لو (!نصان_متساويان(&المتوقع, &(*النتيجة).الخطأ)) {
            أرجع اختياري.موجود(«خرج الخطأ لا يطابق ملفه المتوقع»);
        };
    }
    | اختياري.لا_شيء -> { };
    أرجع اختياري.لا_شيء();
}

// The exact human diagnostic output of the compiler in one language.
عرف طابق_خرج_تشخيص_بلغة(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: طبيعي,
    اللغة: نص,
    الملف: &اختياري نص
): اختياري نص {
    طابق *الملف مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المسار_المتوقع) -> {
        دع أجزاء_البادئة: متجه نص = [«diagnostics-», انسخ_نص_اختبار(&اللغة)];
        دع البادئة: نص = اجمع_نصوص(&أجزاء_البادئة);
        دع الاسم: نص = اسم_تشغيل(&البادئة, الفهرس);
        دع الوسائط: متجه نص = [«--lang», انسخ_نص_اختبار(&اللغة), «--color», «never», «check», انسخ_نص_اختبار(&(*الوصف).المسار)];
        دع النتيجة: نتيجة_أمر = نفذ_أمرا(المترجم, &الوسائط, &الاسم);
        دع المتوقع: نص = اقرأ_إن_وجد(&المسار_المتوقع);
        لو ((الطول(المتوقع) مثل طبيعي) == 0) {
            أرجع اختياري.موجود(«ملف خرج التشخيص المتوقع مفقود أو فارغ»);
        };
        لو (!نصان_متساويان(&المتوقع, &النتيجة.الخطأ)) {
            دع أجزاء: متجه نص = [«خرج التشخيص لا يطابق », انسخ_نص_اختبار(&المسار_المتوقع)];
            أرجع اختياري.موجود(اجمع_نصوص(&أجزاء));
        };
        أرجع اختياري.لا_شيء();
    };
}

عرف تحقق_مرحلة0(
    الوصف: &وصف_اختبار,
    نتيجة_المترجم: &نتيجة_أمر,
    الفهرس: طبيعي
): اختياري نص {
    لو (!(*الوصف).مرحلة0) { أرجع اختياري.لا_شيء(); };
    طابق مسار_مترجم_المرحلة0() مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المرحلة0) -> {
        طابق الهدف_المضيف() مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(«لا يمكن تحديد الهدف المضيف لمقارنة Stage0»); }
        | اختياري.موجود(الهدف) -> {
            دع لاحقة_مرحلة0: نص = «.stage0.o»;
            دع بادئة_مرحلة0: نص = «stage0»;
            دع الناتج: نص = مسار_ناتج(الفهرس, &لاحقة_مرحلة0);
            دع الاسم: نص = اسم_تشغيل(&بادئة_مرحلة0, الفهرس);
            دع الوسائط: متجه نص = [استنسخ(&(*الوصف).المسار), «--target», الهدف, «-o», الناتج];
            دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المرحلة0, &الوسائط, &الاسم);
            طابق (*الوصف).النمط مع
            | نمط_اختبار.قبول -> {
                لو (النتيجة.الحالة != 0) { أرجع اختياري.موجود(«Stage0 رفض مصدرا يقبله المترجم الذاتي»); };
            }
            | نمط_اختبار.رفض -> {
                لو (النتيجة.الحالة == 0) { أرجع اختياري.موجود(«Stage0 قبل مصدرا يرفضه المترجم الذاتي»); };
                طابق (*الوصف).التشخيص مع
                | اختياري.موجود(الكود) -> {
                    لو ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                        أرجع اختياري.موجود(«Stage0 لم يعرض معرف التشخيص المتوقع»);
                    };
                }
                | اختياري.لا_شيء -> { };
            }
            | _ -> { };
            أرجع اختياري.لا_شيء();
        };
    };
}

عرف نفذ_قبول_أو_رفض(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: طبيعي
): اختياري نص {
    دع بادئة_فحص: نص = «check»;
    دع الاسم: نص = اسم_تشغيل(&بادئة_فحص, الفهرس);
    دع النتيجة: نتيجة_أمر = نفذ_فحص(المترجم, &(*الوصف).المسار, &الاسم);
    لو (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
        أرجع اختياري.موجود(«حدث فشل داخلي للمترجم»);
    };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> {
        لو (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختياري.موجود(«حالة قبول المصدر لا تطابق المتوقع»);
        };
        // An accepted program may still carry a warning: `// تشخيص:` names it.
        طابق (*الوصف).التشخيص مع
        | اختياري.موجود(الكود) -> {
            لو ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                أرجع اختياري.موجود(«التحذير المتوقع غير موجود»);
            };
        }
        | اختياري.لا_شيء -> { };
        // `// خطأ-قياسي: <فارغ>` states that `check` reports nothing.
        طابق طابق_المخرجات_المتوقعة(الوصف, &النتيجة) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        // The exact warnings, per language, when the test names a file for them
        // (`// خرج-تشخيص-عربي:` / `// خرج-تشخيص-إنجليزي:`), as for a rejection.
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «ar», &(*الوصف).خرج_التشخيص_العربي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «en», &(*الوصف).خرج_التشخيص_الإنجليزي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
    }
    | نمط_اختبار.رفض -> {
        لو (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختياري.موجود(«حالة رفض المصدر لا تطابق المتوقع»);
        };
        طابق (*الوصف).التشخيص مع
        | اختياري.موجود(الكود) -> {
            لو ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                أرجع اختياري.موجود(«معرف التشخيص المتوقع غير موجود»);
            };
        }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «ar», &(*الوصف).خرج_التشخيص_العربي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
        طابق طابق_خرج_تشخيص_بلغة(الوصف, المترجم, الفهرس, «en», &(*الوصف).خرج_التشخيص_الإنجليزي) مع
        | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
        | اختياري.لا_شيء -> { };
    }
    | _ -> { };

    دع هو_قبول: متغير منطقي = خطأ;
    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> { هو_قبول := صواب; }
    | _ -> { };
    لو (هو_قبول && (!لا_أهداف_محددة(الوصف))) {
        دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
        دع ت: متغير طبيعي = 0;
        طالما (ت < (الطول(الأهداف) مثل طبيعي)) {
            لو (هدف_مطلوب(الوصف, &الأهداف[ت])) {
                دع أجزاء_لاحقة: متجه نص = [«-accept-», انسخ_نص_اختبار(&الأهداف[ت]), «.o»];
                دع لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
                دع الناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
                دع بادئة: نص = «accept-target»;
                دع اسم_هدف: نص = اسم_تشغيل(&بادئة, الفهرس);
                دع جمع: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ت], &الناتج, &اسم_هدف);
                لو (جمع.الحالة != 0) { أرجع اختياري.موجود(«فشل تجميع اختبار القبول للهدف المطلوب»); };
                لو (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختياري.موجود(«فشل داخلي أثناء تجميع اختبار القبول»); };
            };
            ت := ت + 1;
        }
    };

    طابق تحقق_مرحلة0(الوصف, &النتيجة, الفهرس) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    أرجع اختياري.لا_شيء();
}

عرف جمع_كل_الأهداف(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي,
    الملخص: &متغير ملخص_اختبارات
): اختياري نص {
    دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأهداف) مثل طبيعي)) {
        دع مطلوب: متغير منطقي = هدف_مطلوب(الوصف, &الأهداف[ف]);
        لو (لا_أهداف_محددة(الوصف)) { مطلوب := صواب; };
        لو (مطلوب) {
            دع أجزاء_لاحقة: متجه نص = [«-», انسخ_نص_اختبار(&الأهداف[ف]), «.o»];
            دع لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
            دع ناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
            دع بادئة_كائن: نص = «object»;
            دع اسم: نص = اسم_تشغيل(&بادئة_كائن, الفهرس);
            دع النتيجة: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ف], &ناتج, &اسم);
            لو (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) { أرجع اختياري.موجود(«فشل داخلي أثناء تجميع هدف»); };
            لو (النتيجة.الحالة != 0) { أرجع اختياري.موجود(«فشل تجميع أحد الأهداف»); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف نفذ_تشغيل_أو_تفاضل(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: طبيعي,
    الملخص: &متغير ملخص_اختبارات
): اختياري نص {
    طابق جمع_كل_الأهداف(الوصف, المترجم, المضيف, الفهرس, الملخص) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    لو ((!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف))) {
        أرجع اختياري.لا_شيء();
    };

    دع لاحقة_تنفيذي: نص = «-native»;
    دع بادئة_بناء: نص = «native-build»;
    دع بادئة_تشغيل: نص = «native-run»;
    دع بادئة_تفسير: نص = «interpret»;
    دع التنفيذي: نص = مسار_ناتج(الفهرس, &لاحقة_تنفيذي);
    دع اسم_جمع: نص = اسم_تشغيل(&بادئة_بناء, الفهرس);
    دع جمع: نتيجة_أمر = جمع_تنفيذي(المترجم, &(*الوصف).المسار, المضيف, &التنفيذي, &اسم_جمع);
    لو (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختياري.موجود(«فشل داخلي أثناء بناء التنفيذي»); };
    لو (جمع.الحالة != 0) { أرجع اختياري.موجود(«فشل بناء التنفيذي المضيف»); };

    دع اسم_تشغيل_فعلي: نص = اسم_تشغيل(&بادئة_تشغيل, الفهرس);
    // ملفات الاختبار تفسر المسارات النسبية من جذر المستودع مثل اكتشاف المصادر وتجميعها.
    دع تشغيل: نتيجة_أمر = شغل_برنامج_اختبار(&التنفيذي, &اسم_تشغيل_فعلي, &(*الوصف).البيئة);
    لو (نتيجة_تشغيل_تحوي_فشلا_داخليا(&تشغيل)) { أرجع اختياري.موجود(«فشل داخلي أثناء تشغيل البرنامج»); };
    لو (تشغيل.الحالة != (*الوصف).المتوقع) { أرجع اختياري.موجود(«حالة تشغيل البرنامج لا تطابق المتوقع»); };
    طابق طابق_المخرجات_المتوقعة(الوصف, &تشغيل) مع
    | اختياري.موجود(السبب) -> { أرجع اختياري.موجود(السبب); }
    | اختياري.لا_شيء -> { };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.تفاضلي -> {
        دع اسم_تفسير: نص = اسم_تشغيل(&بادئة_تفسير, الفهرس);
        دع تفسير: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_تفسير, &(*الوصف).البيئة);
        لو (نتيجة_تشغيل_تحوي_فشلا_داخليا(&تفسير)) { أرجع اختياري.موجود(«فشل داخلي في المفسر»); };
        لو (تفسير.الحالة != (*الوصف).المتوقع) { أرجع اختياري.موجود(«حالة المفسر لا تطابق المتوقع»); };
        لو (تفسير.الحالة != تشغيل.الحالة) { أرجع اختياري.موجود(«اختلاف حالة المفسر والتنفيذي»); };
        لو (!نصان_متساويان(&تفسير.الخرج, &تشغيل.الخرج)) { أرجع اختياري.موجود(«اختلاف الخرج بين المفسر والتنفيذي»); };
        لو ((*الوصف).تفاضلي_كامل && !نصان_متساويان(&تفسير.الخطأ, &تشغيل.الخطأ)) {
            أرجع اختياري.موجود(«اختلاف خرج الخطأ بين المفسر والتنفيذي»);
        };
    }
    | _ -> { };

    أرجع اختياري.لا_شيء();
}

عرف نفذ_زوج_سطح(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: طبيعي
): اختياري نص {
    // A reject pair is two reject tests, each checked on its own; the pair
    // run and object builds below apply only to programs that compile.
    طابق (*الوصف).النمط مع
    | نمط_اختبار.رفض -> { أرجع اختياري.لا_شيء(); }
    | _ -> { };
    طابق (*الوصف).النظير مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النظير) -> {
        دع جذر_انجليزي: نص = «tests/en/»;
        لو (!يبدأ_بـ(&(*الوصف).المسار, &جذر_انجليزي)) { أرجع اختياري.لا_شيء(); };
        دع بادئة_سطح_أ: نص = «surface-a»;
        دع بادئة_سطح_ب: نص = «surface-b»;
        دع اسم_أ: نص = اسم_تشغيل(&بادئة_سطح_أ, الفهرس);
        دع اسم_ب: نص = اسم_تشغيل(&بادئة_سطح_ب, الفهرس);
        دع أ: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_أ, &(*الوصف).البيئة);
        دع ب: نتيجة_أمر = فسر(المترجم, &النظير, &اسم_ب, &(*الوصف).البيئة);
        لو ((أ.الحالة != (*الوصف).المتوقع) || (ب.الحالة != (*الوصف).المتوقع)) {
            أرجع اختياري.موجود(«اختلاف حالة زوج السطح»);
        };
        لو (!نصان_متساويان(&أ.الخرج, &ب.الخرج)) {
            أرجع اختياري.موجود(«اختلاف خرج السطح العربي والإنجليزي»);
        };
        دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
        دع ن: متغير طبيعي = 0;
        طالما (ن < 2) {
            دع لاحقة_أجزاء: متجه نص = [«-pair-a-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            دع لاحقة_أ: نص = اجمع_نصوص(&لاحقة_أجزاء);
            دع لاحقة_ب_أجزاء: متجه نص = [«-pair-b-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            دع لاحقة_ب: نص = اجمع_نصوص(&لاحقة_ب_أجزاء);
            دع ناتج_أ: نص = مسار_ناتج(الفهرس, &لاحقة_أ);
            دع ناتج_ب: نص = مسار_ناتج(الفهرس, &لاحقة_ب);
            دع بادئة_جمع_أ: نص = «pair-build-a»;
            دع بادئة_جمع_ب: نص = «pair-build-b»;
            دع اسم_جمع_أ: نص = اسم_تشغيل(&بادئة_جمع_أ, الفهرس);
            دع اسم_جمع_ب: نص = اسم_تشغيل(&بادئة_جمع_ب, الفهرس);
            دع جمع_أ: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ن], &ناتج_أ, &اسم_جمع_أ);
            دع جمع_ب: نتيجة_أمر = جمع_كائن(المترجم, &النظير, &الأهداف[ن], &ناتج_ب, &اسم_جمع_ب);
            لو ((جمع_أ.الحالة != 0) || (جمع_ب.الحالة != 0)) { أرجع اختياري.موجود(«فشل تجميع زوج السطح»); };
            ن := ن + 1;
        }
        أرجع اختياري.لا_شيء();
    };
}

// اختبار تشغيل أو تفاضل بأهداف لا تشمل المضيف يُجمَّع كائنات فقط.
عرف اختبار_تجميع_فقط(الوصف: &وصف_اختبار, المضيف: &نص): منطقي {
    طابق (*الوصف).النمط مع
    | نمط_اختبار.تشغيل -> { أرجع (!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف)); }
    | نمط_اختبار.تفاضلي -> { أرجع (!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف)); }
    | _ -> { أرجع خطأ; };
}

عام عرف نفذ_الاختبارات_المكتشفة(الملخص: &متغير ملخص_اختبارات): فراغ {
    طابق اكتشف_الاختبارات() مع
    | نتيجة.خطأ(الخطأ) -> { دع اسم_اكتشاف: نص = «اكتشاف الاختبارات»; سجل_فشل(الملخص, &اسم_اكتشاف, &الخطأ); }
    | نتيجة.نجح(الاختبارات) -> {
        دع المترجم: نص = مسار_المترجم();
        طابق الهدف_المضيف() مع
        | اختياري.لا_شيء -> { دع اسم_الهدف: نص = «الهدف المضيف»; دع سبب_الهدف: نص = «هدف مضيف غير مدعوم»; سجل_فشل(الملخص, &اسم_الهدف, &سبب_الهدف); }
        | اختياري.موجود(المضيف) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الاختبارات) مثل طبيعي)) {
                دع الوصف: &وصف_اختبار = &الاختبارات[ف];
                دع المشكلة: متغير اختياري نص = اختياري.لا_شيء();
                طابق (*الوصف).النمط مع
                | نمط_اختبار.قبول -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, &المترجم, ف); }
                | نمط_اختبار.رفض -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, &المترجم, ف); }
                | نمط_اختبار.تشغيل -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, &المترجم, &المضيف, ف, الملخص); }
                | نمط_اختبار.تفاضلي -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, &المترجم, &المضيف, ف, الملخص); };
                طابق المشكلة مع
                | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &(*الوصف).المسار, &السبب); }
                | اختياري.لا_شيء -> {
                    طابق نفذ_زوج_سطح(الوصف, &المترجم, ف) مع
                    | اختياري.موجود(السبب) -> { سجل_فشل(الملخص, &(*الوصف).المسار, &السبب); }
                    | اختياري.لا_شيء -> {
                        سجل_نجاح(الملخص, &(*الوصف).المسار);
                        // اختبار تشغيل لا يشمل المضيف: جُمِّع فقط ولم يُشغَّل.
                        لو (اختبار_تجميع_فقط(الوصف, &المضيف)) { سجل_تجميع_فقط(الملخص); };
                    };
                };
                ف := ف + 1;
            }
        };
    };
}
