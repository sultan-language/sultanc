استورد "common.sn";
استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد "discovery.sn";

عرف اسم_تشغيل(البادئة: &نص, الفهرس: غير_موقع): نص {
    دع العدد: نص = غير_موقع_إلى_نص(الفهرس);
    دع أجزاء: متجه نص = [*البادئة, «-», العدد];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف مسار_ناتج(الفهرس: غير_موقع, اللاحقة: &نص): نص {
    دع العدد: نص = غير_موقع_إلى_نص(الفهرس);
    دع أجزاء: متجه نص = [«build/tests-sultanc/case-», العدد, *اللاحقة];
    أرجع اجمع_نصوص(&أجزاء);
}

عرف هدف_مطلوب(الوصف: &وصف_اختبار, الهدف: &نص): منطقي {
    دع ذراع: نص = «arm64-darwin»;
    دع اكس: نص = «x86_64-linux»;
    لو (نصان_متساويان(الهدف, &ذراع)) { أرجع (*الوصف).ذراع; };
    لو (نصان_متساويان(الهدف, &اكس)) { أرجع (*الوصف).اكس; };
    أرجع خطأ;
}

عرف لا_أهداف_محددة(الوصف: &وصف_اختبار): منطقي {
    أرجع (!(*الوصف).ذراع) && (!(*الوصف).اكس);
}

عرف نفذ_فحص(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«--diagnostic-format», «short», «check», *المصدر];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف جمع_كائن(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«-c», «--target», *الهدف, *المصدر, «-o», *الناتج];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف جمع_تنفيذي(
    المترجم: &نص,
    المصدر: &نص,
    الهدف: &نص,
    الناتج: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«--target», *الهدف, *المصدر, «-o», *الناتج];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف فسر(
    المترجم: &نص,
    المصدر: &نص,
    الاسم: &نص
): نتيجة_أمر {
    دع الوسائط: متجه نص = [«interpret», *المصدر];
    أرجع نفذ_أمرا(المترجم, &الوسائط, الاسم);
}

عرف طابق_المخرجات_المتوقعة(الوصف: &وصف_اختبار, النتيجة: &نتيجة_أمر): اختيار نص {
    لو ((*الوصف).تحقق_الخرج && !نصان_متساويان(&(*الوصف).الخرج_المتوقع, &(*النتيجة).الخرج)) {
        أرجع اختيار.بعض(«الخرج القياسي لا يطابق المتوقع»);
    };
    لو ((*الوصف).تحقق_الخطأ && !نصان_متساويان(&(*الوصف).الخطأ_المتوقع, &(*النتيجة).الخطأ)) {
        أرجع اختيار.بعض(«خرج الخطأ لا يطابق المتوقع»);
    };
    أرجع اختيار.لا_شيء();
}

عرف تحقق_مرحلة0(
    الوصف: &وصف_اختبار,
    نتيجة_المترجم: &نتيجة_أمر,
    الفهرس: غير_موقع
): اختيار نص {
    لو (!(*الوصف).مرحلة0) { أرجع اختيار.لا_شيء(); };
    طابق مسار_مترجم_المرحلة0() مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(المرحلة0) -> {
        طابق الهدف_المضيف() مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(«لا يمكن تحديد الهدف المضيف لمقارنة Stage0»); }
        | اختيار.بعض(الهدف) -> {
            دع لاحقة_مرحلة0: نص = «.stage0.o»;
            دع بادئة_مرحلة0: نص = «stage0»;
            دع الناتج: نص = مسار_ناتج(الفهرس, &لاحقة_مرحلة0);
            دع الاسم: نص = اسم_تشغيل(&بادئة_مرحلة0, الفهرس);
            دع الوسائط: متجه نص = [(*الوصف).المسار, «--target», الهدف, «-o», الناتج];
            دع النتيجة: نتيجة_أمر = نفذ_أمرا(&المرحلة0, &الوسائط, &الاسم);
            طابق (*الوصف).النمط مع
            | نمط_اختبار.قبول -> {
                لو (النتيجة.الحالة != 0) { أرجع اختيار.بعض(«Stage0 رفض مصدرا يقبله المترجم الذاتي»); };
            }
            | نمط_اختبار.رفض -> {
                لو (النتيجة.الحالة == 0) { أرجع اختيار.بعض(«Stage0 قبل مصدرا يرفضه المترجم الذاتي»); };
                طابق (*الوصف).التشخيص مع
                | اختيار.بعض(الكود) -> {
                    لو ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                        أرجع اختيار.بعض(«Stage0 لم يعرض معرف التشخيص المتوقع»);
                    };
                }
                | اختيار.لا_شيء -> { };
            }
            | _ -> { };
            أرجع اختيار.لا_شيء();
        };
    };
}

عرف نفذ_قبول_أو_رفض(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: غير_موقع
): اختيار نص {
    دع بادئة_فحص: نص = «check»;
    دع الاسم: نص = اسم_تشغيل(&بادئة_فحص, الفهرس);
    دع النتيجة: نتيجة_أمر = نفذ_فحص(المترجم, &(*الوصف).المسار, &الاسم);
    لو (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) {
        أرجع اختيار.بعض(«حدث فشل داخلي للمترجم»);
    };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> {
        لو (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختيار.بعض(«حالة قبول المصدر لا تطابق المتوقع»);
        };
    }
    | نمط_اختبار.رفض -> {
        لو (النتيجة.الحالة != (*الوصف).المتوقع) {
            أرجع اختيار.بعض(«حالة رفض المصدر لا تطابق المتوقع»);
        };
        طابق (*الوصف).التشخيص مع
        | اختيار.بعض(الكود) -> {
            لو ((!يحتوي_نصا(&النتيجة.الخطأ, &الكود)) && (!يحتوي_نصا(&النتيجة.الخرج, &الكود))) {
                أرجع اختيار.بعض(«معرف التشخيص المتوقع غير موجود»);
            };
        }
        | اختيار.لا_شيء -> { };
    }
    | _ -> { };

    دع هو_قبول: متغير منطقي = خطأ;
    طابق (*الوصف).النمط مع
    | نمط_اختبار.قبول -> { هو_قبول := صواب; }
    | _ -> { };
    لو (هو_قبول && (!لا_أهداف_محددة(الوصف))) {
        دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
        دع ت: متغير غير_موقع = 0;
        بينما (ت < (الطول(الأهداف) مثل غير_موقع)) {
            لو (هدف_مطلوب(الوصف, &الأهداف[ت])) {
                دع أجزاء_لاحقة: متجه نص = [«-accept-», انسخ_نص_اختبار(&الأهداف[ت]), «.o»];
                دع لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
                دع الناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
                دع بادئة: نص = «accept-target»;
                دع اسم_هدف: نص = اسم_تشغيل(&بادئة, الفهرس);
                دع جمع: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ت], &الناتج, &اسم_هدف);
                لو (جمع.الحالة != 0) { أرجع اختيار.بعض(«فشل تجميع اختبار القبول للهدف المطلوب»); };
                لو (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختيار.بعض(«فشل داخلي أثناء تجميع اختبار القبول»); };
            };
            ت := ت + 1;
        }
    };

    طابق تحقق_مرحلة0(الوصف, &النتيجة, الفهرس) مع
    | اختيار.بعض(السبب) -> { أرجع اختيار.بعض(السبب); }
    | اختيار.لا_شيء -> { };

    أرجع اختيار.لا_شيء();
}

عرف جمع_كل_الأهداف(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: غير_موقع,
    الملخص: &متغير ملخص_اختبارات
): اختيار نص {
    دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الأهداف) مثل غير_موقع)) {
        دع مطلوب: متغير منطقي = هدف_مطلوب(الوصف, &الأهداف[ف]);
        لو (لا_أهداف_محددة(الوصف)) { مطلوب := صواب; };
        لو (مطلوب) {
            دع أجزاء_لاحقة: متجه نص = [«-», انسخ_نص_اختبار(&الأهداف[ف]), «.o»];
            دع لاحقة: نص = اجمع_نصوص(&أجزاء_لاحقة);
            دع ناتج: نص = مسار_ناتج(الفهرس, &لاحقة);
            دع بادئة_كائن: نص = «object»;
            دع اسم: نص = اسم_تشغيل(&بادئة_كائن, الفهرس);
            دع النتيجة: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ف], &ناتج, &اسم);
            لو (نتيجة_تحوي_فشلا_داخليا(&النتيجة)) { أرجع اختيار.بعض(«فشل داخلي أثناء تجميع هدف»); };
            لو (النتيجة.الحالة != 0) { أرجع اختيار.بعض(«فشل تجميع أحد الأهداف»); };
            لو (!نصان_متساويان(&الأهداف[ف], المضيف)) { سجل_تجميع_فقط(الملخص); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف نفذ_تشغيل_أو_تفاضل(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    المضيف: &نص,
    الفهرس: غير_موقع,
    الملخص: &متغير ملخص_اختبارات
): اختيار نص {
    طابق جمع_كل_الأهداف(الوصف, المترجم, المضيف, الفهرس, الملخص) مع
    | اختيار.بعض(السبب) -> { أرجع اختيار.بعض(السبب); }
    | اختيار.لا_شيء -> { };

    لو ((!لا_أهداف_محددة(الوصف)) && (!هدف_مطلوب(الوصف, المضيف))) {
        أرجع اختيار.لا_شيء();
    };

    دع لاحقة_تنفيذي: نص = «-native»;
    دع بادئة_بناء: نص = «native-build»;
    دع بادئة_تشغيل: نص = «native-run»;
    دع بادئة_تفسير: نص = «interpret»;
    دع التنفيذي: نص = مسار_ناتج(الفهرس, &لاحقة_تنفيذي);
    دع اسم_جمع: نص = اسم_تشغيل(&بادئة_بناء, الفهرس);
    دع جمع: نتيجة_أمر = جمع_تنفيذي(المترجم, &(*الوصف).المسار, المضيف, &التنفيذي, &اسم_جمع);
    لو (نتيجة_تحوي_فشلا_داخليا(&جمع)) { أرجع اختيار.بعض(«فشل داخلي أثناء بناء التنفيذي»); };
    لو (جمع.الحالة != 0) { أرجع اختيار.بعض(«فشل بناء التنفيذي المضيف»); };

    دع اسم_تشغيل_فعلي: نص = اسم_تشغيل(&بادئة_تشغيل, الفهرس);
    دع لا_وسائط: متجه نص = [];
    دع دليل_عمل: نص = «build/tests-sultanc»;
    دع أجزاء_اسم_تنفيذي: متجه نص = [«./case-», غير_موقع_إلى_نص(الفهرس), «-native»];
    دع اسم_ملف_تنفيذي: نص = اجمع_نصوص(&أجزاء_اسم_تنفيذي);
    دع تشغيل: نتيجة_أمر = نفذ_أمرا_في(&اسم_ملف_تنفيذي, &لا_وسائط, &دليل_عمل, &اسم_تشغيل_فعلي);
    لو (نتيجة_تحوي_فشلا_داخليا(&تشغيل)) { أرجع اختيار.بعض(«فشل داخلي أثناء تشغيل البرنامج»); };
    لو (تشغيل.الحالة != (*الوصف).المتوقع) { أرجع اختيار.بعض(«حالة تشغيل البرنامج لا تطابق المتوقع»); };
    طابق طابق_المخرجات_المتوقعة(الوصف, &تشغيل) مع
    | اختيار.بعض(السبب) -> { أرجع اختيار.بعض(السبب); }
    | اختيار.لا_شيء -> { };

    طابق (*الوصف).النمط مع
    | نمط_اختبار.تفاضلي -> {
        دع اسم_تفسير: نص = اسم_تشغيل(&بادئة_تفسير, الفهرس);
        دع تفسير: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_تفسير);
        لو (نتيجة_تحوي_فشلا_داخليا(&تفسير)) { أرجع اختيار.بعض(«فشل داخلي في المفسر»); };
        لو (تفسير.الحالة != (*الوصف).المتوقع) { أرجع اختيار.بعض(«حالة المفسر لا تطابق المتوقع»); };
        لو (تفسير.الحالة != تشغيل.الحالة) { أرجع اختيار.بعض(«اختلاف حالة المفسر والتنفيذي»); };
        لو (!نصان_متساويان(&تفسير.الخرج, &تشغيل.الخرج)) { أرجع اختيار.بعض(«اختلاف الخرج بين المفسر والتنفيذي»); };
        لو ((*الوصف).تفاضلي_كامل && !نصان_متساويان(&تفسير.الخطأ, &تشغيل.الخطأ)) {
            أرجع اختيار.بعض(«اختلاف خرج الخطأ بين المفسر والتنفيذي»);
        };
    }
    | _ -> { };

    أرجع اختيار.لا_شيء();
}

عرف نفذ_زوج_سطح(
    الوصف: &وصف_اختبار,
    المترجم: &نص,
    الفهرس: غير_موقع
): اختيار نص {
    طابق (*الوصف).النظير مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النظير) -> {
        دع جذر_انجليزي: نص = «tests/en/»;
        لو (!يبدأ_بـ(&(*الوصف).المسار, &جذر_انجليزي)) { أرجع اختيار.لا_شيء(); };
        دع بادئة_سطح_أ: نص = «surface-a»;
        دع بادئة_سطح_ب: نص = «surface-b»;
        دع اسم_أ: نص = اسم_تشغيل(&بادئة_سطح_أ, الفهرس);
        دع اسم_ب: نص = اسم_تشغيل(&بادئة_سطح_ب, الفهرس);
        دع أ: نتيجة_أمر = فسر(المترجم, &(*الوصف).المسار, &اسم_أ);
        دع ب: نتيجة_أمر = فسر(المترجم, &النظير, &اسم_ب);
        لو ((أ.الحالة != (*الوصف).المتوقع) || (ب.الحالة != (*الوصف).المتوقع)) {
            أرجع اختيار.بعض(«اختلاف حالة زوج السطح»);
        };
        لو (!نصان_متساويان(&أ.الخرج, &ب.الخرج)) {
            أرجع اختيار.بعض(«اختلاف خرج السطح العربي والإنجليزي»);
        };
        دع الأهداف: متجه نص = [«arm64-darwin», «x86_64-linux»];
        دع ن: متغير غير_موقع = 0;
        بينما (ن < 2) {
            دع لاحقة_أجزاء: متجه نص = [«-pair-a-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            دع لاحقة_أ: نص = اجمع_نصوص(&لاحقة_أجزاء);
            دع لاحقة_ب_أجزاء: متجه نص = [«-pair-b-», انسخ_نص_اختبار(&الأهداف[ن]), «.o»];
            دع لاحقة_ب: نص = اجمع_نصوص(&لاحقة_ب_أجزاء);
            دع ناتج_أ: نص = مسار_ناتج(الفهرس, &لاحقة_أ);
            دع ناتج_ب: نص = مسار_ناتج(الفهرس, &لاحقة_ب);
            دع بادئة_جمع_أ: نص = «pair-build-a»;
            دع بادئة_جمع_ب: نص = «pair-build-b»;
            دع اسم_جمع_أ: نص = اسم_تشغيل(&بادئة_جمع_أ, الفهرس);
            دع اسم_جمع_ب: نص = اسم_تشغيل(&بادئة_جمع_ب, الفهرس);
            دع جمع_أ: نتيجة_أمر = جمع_كائن(المترجم, &(*الوصف).المسار, &الأهداف[ن], &ناتج_أ, &اسم_جمع_أ);
            دع جمع_ب: نتيجة_أمر = جمع_كائن(المترجم, &النظير, &الأهداف[ن], &ناتج_ب, &اسم_جمع_ب);
            لو ((جمع_أ.الحالة != 0) || (جمع_ب.الحالة != 0)) { أرجع اختيار.بعض(«فشل تجميع زوج السطح»); };
            ن := ن + 1;
        }
        أرجع اختيار.لا_شيء();
    };
}

عام عرف نفذ_الاختبارات_المكتشفة(الملخص: &متغير ملخص_اختبارات): فراغ {
    طابق اكتشف_الاختبارات() مع
    | نتيجة.خطأ(الخطأ) -> { دع اسم_اكتشاف: نص = «اكتشاف الاختبارات»; سجل_فشل(الملخص, &اسم_اكتشاف, &الخطأ); }
    | نتيجة.نجح(الاختبارات) -> {
        دع المترجم: نص = مسار_المترجم();
        طابق الهدف_المضيف() مع
        | اختيار.لا_شيء -> { دع اسم_الهدف: نص = «الهدف المضيف»; دع سبب_الهدف: نص = «هدف مضيف غير مدعوم»; سجل_فشل(الملخص, &اسم_الهدف, &سبب_الهدف); }
        | اختيار.بعض(المضيف) -> {
            دع ف: متغير غير_موقع = 0;
            بينما (ف < (الطول(الاختبارات) مثل غير_موقع)) {
                دع الوصف: &وصف_اختبار = &الاختبارات[ف];
                دع المشكلة: متغير اختيار نص = اختيار.لا_شيء();
                طابق (*الوصف).النمط مع
                | نمط_اختبار.قبول -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, &المترجم, ف); }
                | نمط_اختبار.رفض -> { المشكلة := نفذ_قبول_أو_رفض(الوصف, &المترجم, ف); }
                | نمط_اختبار.تشغيل -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, &المترجم, &المضيف, ف, الملخص); }
                | نمط_اختبار.تفاضلي -> { المشكلة := نفذ_تشغيل_أو_تفاضل(الوصف, &المترجم, &المضيف, ف, الملخص); };
                طابق المشكلة مع
                | اختيار.بعض(السبب) -> { سجل_فشل(الملخص, &(*الوصف).المسار, &السبب); }
                | اختيار.لا_شيء -> {
                    طابق نفذ_زوج_سطح(الوصف, &المترجم, ف) مع
                    | اختيار.بعض(السبب) -> { سجل_فشل(الملخص, &(*الوصف).المسار, &السبب); }
                    | اختيار.لا_شيء -> { سجل_نجاح(الملخص, &(*الوصف).المسار); };
                };
                ف := ف + 1;
            }
        };
    };
}
