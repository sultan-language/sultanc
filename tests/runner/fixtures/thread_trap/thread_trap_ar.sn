// فخ على خيط مُطلق، في موضع main_trap_ar.sn نفسه.
استورد std.thread.thread;
استورد "trap_site_ar.sn";

عرف عمل(): فراغ {
    دع متجاهل: عدد = عنصر_عند(7);
}

عرف الرئيسية(): عدد {
    طابق أطلق(عمل) مع
    | نتيجة.نجح(م) -> {
        دع المقبض: متغير مقبض_خيط = م;
        انضم(&متغير المقبض);
    }
    | نتيجة.خطأ(_) -> { أرجع 2; };
    أرجع 0;
}
