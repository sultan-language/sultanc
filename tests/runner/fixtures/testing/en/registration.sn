// `sultanc test` (tests/runner/suites/testing.sn): a definition-time
// decorator's registration runs before the test as before main, so the
// counter is 1 in both. Expected: `sultanc test` exits 0, `run` exits 0.
import std.debug.assert;

let registered: mutable int = 0;

def count(handler: fn(): int): void {
    unsafe { registered := registered + 1; }
}

@@count
def handler(): int { return 7; }

@@test
def registration_ran(): void {
    let seen: int;
    unsafe { seen := registered; }
    assert(seen == 1);
}

def main(): int {
    let seen: int;
    unsafe { seen := registered; }
    if (seen != 1) { return 1; };
    return 0;
}
