// The dependency of the graph fixture. Its own test fails on purpose:
// `sultanc test` runs the root package's tests only, so the
// graph case still exits 0.
import std.debug.assert;

public def triple(x: int): int { return x * 3; }

@@test
def dependency_test_is_not_run(): void {
    assert(triple(1) == 4);
}
