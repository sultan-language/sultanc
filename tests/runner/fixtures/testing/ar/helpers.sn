// وحدة يستوردها tests/runner/fixtures/testing/ar/main.sn وpassing.sn: تُكتشف
// اختباراتها مع اختبارات الوحدة المستوردة.
استورد std.error.failure;

عام عرف ضاعف(س: عدد): عدد { أرجع س * 2; }

@@اختبار
عرف المضاعف_زوجي(): نتيجة عدد, فشل {
    إذا (ضاعف(21) % 2 != 0) {
        أرجع نتيجة.خطأ(فشل_بهوية(«اختبار», «مساعد», «ضاعف(21) فردي»));
    };
    أرجع نتيجة.نجح(0);
}
