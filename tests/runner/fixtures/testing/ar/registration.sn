// `sultanc test` (tests/runner/suites/testing.sn): يُشغَّل تسجيل مزخرف وقت
// التعريف قبل الاختبار كما يُشغَّل قبل الرئيسية، فالعداد 1 في الحالتين.
// المتوقع: يخرج `sultanc test` بالحالة 0، و`run` بالحالة 0.
استورد std.debug.assert;

دع المسجلة: متغير عدد = 0;

عرف عد(المعالج: دالة(): عدد): فراغ {
    غير_آمن { المسجلة := المسجلة + 1; }
}

@@عد
عرف معالج(): عدد { أرجع 7; }

@@اختبار
عرف التسجيل_جرى(): فراغ {
    دع المرئي: عدد;
    غير_آمن { المرئي := المسجلة; }
    تأكد(المرئي == 1);
}

عرف الرئيسية(): عدد {
    دع المرئي: عدد;
    غير_آمن { المرئي := المسجلة; }
    إذا (المرئي != 1) { أرجع 1; };
    أرجع 0;
}
