// `sultanc test` (tests/runner/suites/testing.sn): اختبارات ناجحة وفاشلة في
// وحدتين. المتوقع: نجح يضاعف، فشل تأكيد_فاشل (تأكيد)، فشل ينهار (رسالته)،
// فشل يرجع_خطأ (نص خطئه)، فشل يخرج_بسبعة (حالة الخروج 7)، نجح
// المضاعف_زوجي (helpers.sn)؛ الحالة 1. والبناء العادي يشغّل الرئيسية وحدها
// ويعيد 0.
استورد «helpers.sn»;
استورد std.debug.assert;
استورد std.process.panic;
استورد std.process.exit;
استورد std.error.failure;

@@اختبار
عرف يضاعف(): فراغ {
    تأكد(ضاعف(2) == 4);
}

@@اختبار
عرف تأكيد_فاشل(): فراغ {
    تأكد(ضاعف(2) == 5);
}

@@اختبار
عرف ينهار(): فراغ {
    إنهيار(«حدث خطأ ما»);
}

@@اختبار
عرف يرجع_خطأ(): نتيجة عدد, فشل {
    إذا (ضاعف(20) != 41) {
        أرجع نتيجة.خطأ(فشل_بهوية(«اختبار», «مثال», «ضاعف(20) هو 40، والمتوقع 41»));
    };
    أرجع نتيجة.نجح(0);
}

@@اختبار
عرف يخرج_بسبعة(): فراغ {
    اخرج(7);
}

عرف الرئيسية(): عدد { أرجع 0; }
