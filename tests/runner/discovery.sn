استورد "common.sn";
استورد std.text.search;
استورد std.text.substring;
استورد std.text.number;
استورد std.text.compare;
استورد std.fs.directory;
استورد std.fs.path;
استورد std.fs.read_file;

عام نوع نمط_اختبار =
    | قبول
    | رفض
    | تشغيل
    | تفاضلي
;

عام نوع وصف_اختبار = {
    المسار: نص,
    النمط: نمط_اختبار,
    المتوقع: عدد,
    ذراع: منطقي,
    اكس: منطقي,
    مرحلة0: منطقي,
    تفاضلي_كامل: منطقي,
    التشخيص: اختياري نص,
    النظير: اختياري نص,
    الفئة: اختياري نص,
    تحقق_الخرج: منطقي,
    الخرج_المتوقع: نص,
    تحقق_الخطأ: منطقي,
    الخطأ_المتوقع: نص,
    // End-to-end diagnostic output: files beside the test that hold the exact
    // stderr of `--lang ar|en --color never check <test>`
    // (headers `// خرج-تشخيص-عربي: <file>` and `// خرج-تشخيص-إنجليزي: <file>`).
    خرج_التشخيص_العربي: اختياري نص,
    خرج_التشخيص_الإنجليزي: اختياري نص,
    // One environment assignment for the test program's runs, native and
    // interpreted (`// بيئة: SULTANC_LANG=en`), and a file beside the test
    // with the program's exact standard error (`// خطأ-قياسي-ملف: <file>`).
    البيئة: اختياري نص,
    ملف_الخطأ_المتوقع: اختياري نص
};

عرف قيمة_بعد_علامة(
    المصدر: &نص,
    العلامة: &نص
): اختياري نص {
    طابق ابحث_نصا(المصدر, العلامة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        دع البداية: طبيعي = الموضع + (الطول(*العلامة) مثل طبيعي);
        دع النهاية: متغير طبيعي = البداية;
        دع العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
        طالما ((النهاية < العدد) && ((*المصدر)[النهاية] != (0x0A مثل ط8)) && ((*المصدر)[النهاية] != (0x0D مثل ط8))) {
            النهاية := النهاية + 1;
        }
        أرجع مقطع_نص(المصدر, البداية, النهاية - البداية);
    };
}

عرف قيمة_توجيه(المصدر: &نص, الاسم: &نص): اختياري نص {
    دع أجزاء: متجه نص = [«// », استنسخ(الاسم), «: »];
    دع العلامة: نص = اجمع_نصوص(&أجزاء);
    أرجع قيمة_بعد_علامة(المصدر, &العلامة);
}

عرف توجيه_نعم(المصدر: &نص, الاسم: &نص): منطقي {
    طابق قيمة_توجيه(المصدر, الاسم) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> {
        دع نعم: نص = «نعم»;
        أرجع نصان_متساويان(&القيمة, &نعم);
    };
}

عرف نمط_من_نص(القيمة: &نص): اختياري نمط_اختبار {
    دع قبول: نص = «قبول»;
    دع رفض: نص = «رفض»;
    دع تشغيل: نص = «تشغيل»;
    دع تفاضلي: نص = «تفاضلي»;
    لو (نصان_متساويان(القيمة, &قبول)) { أرجع اختياري.موجود(نمط_اختبار.قبول()); };
    لو (نصان_متساويان(القيمة, &رفض)) { أرجع اختياري.موجود(نمط_اختبار.رفض()); };
    لو (نصان_متساويان(القيمة, &تشغيل)) { أرجع اختياري.موجود(نمط_اختبار.تشغيل()); };
    لو (نصان_متساويان(القيمة, &تفاضلي)) { أرجع اختياري.موجود(نمط_اختبار.تفاضلي()); };
    أرجع اختياري.لا_شيء();
}

// A header file name resolved against the test file's directory.
عرف ملف_بجوار_اختبار(المسار: &نص, الاسم: اختياري نص): اختياري نص {
    طابق الاسم مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الملف) -> {
        طابق أب_المسار(المسار) مع
        | اختياري.موجود(الدليل) -> { أرجع اختياري.موجود(صل_المسار(&الدليل, &الملف)); }
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الملف); };
    };
}

عرف حلل_وصف_اختبار(المسار: &نص, المصدر: &نص): اختياري وصف_اختبار {
    دع اسم_اختبار: نص = «اختبار»;
    طابق قيمة_توجيه(المصدر, &اسم_اختبار) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(نص_النمط) -> {
        طابق نمط_من_نص(&نص_النمط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النمط) -> {
            دع المتوقع: متغير عدد = 0;
            طابق النمط مع
            | نمط_اختبار.رفض -> { المتوقع := 1; }
            | _ -> { };
            دع اسم_خروج: نص = «خروج»;
            طابق قيمة_توجيه(المصدر, &اسم_خروج) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(قيمة) -> {
                طابق حلل_عدد(&قيمة) مع
                | نتيجة.نجح(عدد_الخروج) -> { المتوقع := عدد_الخروج; }
                | نتيجة.خطأ(_) -> { };
            };

            دع ذراع: متغير منطقي = خطأ;
            دع اكس: متغير منطقي = خطأ;
            دع اسم_أهداف: نص = «أهداف»;
            طابق قيمة_توجيه(المصدر, &اسم_أهداف) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الأهداف) -> {
                دع هدف_ذراع: نص = «arm64-darwin»;
                دع هدف_اكس: نص = «x86_64-linux»;
                ذراع := يحتوي_نصا(&الأهداف, &هدف_ذراع);
                اكس := يحتوي_نصا(&الأهداف, &هدف_اكس);
            };

            دع اسم_تشخيص: نص = «تشخيص»;
            دع اسم_نظير: نص = «نظير»;
            دع اسم_فئة: نص = «فئة»;
            دع اسم_مرحلة0: نص = «مرحلة0»;
            دع اسم_تفاضلي: نص = «تفاضلي»;
            دع اسم_خرج_قياسي: نص = «خرج-قياسي»;
            دع اسم_خطأ_قياسي: نص = «خطأ-قياسي»;
            دع اسم_خرج_تشخيص_عربي: نص = «خرج-تشخيص-عربي»;
            دع اسم_خرج_تشخيص_إنجليزي: نص = «خرج-تشخيص-إنجليزي»;
            دع اسم_بيئة: نص = «بيئة»;
            دع اسم_ملف_الخطأ: نص = «خطأ-قياسي-ملف»;
            دع الخرج_المتوقع: متغير نص = «»;
            دع الخطأ_المتوقع: متغير نص = «»;
            دع تحقق_الخرج: متغير منطقي = خطأ;
            دع تحقق_الخطأ: متغير منطقي = خطأ;

            طابق قيمة_توجيه(المصدر, &اسم_خرج_قياسي) مع
            | اختياري.موجود(قيمة) -> {
                تحقق_الخرج := صواب;
                دع فارغ: نص = «<فارغ>»;
                لو (!نصان_متساويان(&قيمة, &فارغ)) { الخرج_المتوقع := قيمة; };
            }
            | اختياري.لا_شيء -> { };

            طابق قيمة_توجيه(المصدر, &اسم_خطأ_قياسي) مع
            | اختياري.موجود(قيمة) -> {
                تحقق_الخطأ := صواب;
                دع فارغ: نص = «<فارغ>»;
                لو (!نصان_متساويان(&قيمة, &فارغ)) { الخطأ_المتوقع := قيمة; };
            }
            | اختياري.لا_شيء -> { };

            دع الوصف: وصف_اختبار = {
                المسار: استنسخ(المسار),
                النمط: النمط,
                المتوقع: المتوقع,
                ذراع: ذراع,
                اكس: اكس,
                مرحلة0: توجيه_نعم(المصدر, &اسم_مرحلة0),
                تفاضلي_كامل: توجيه_نعم(المصدر, &اسم_تفاضلي),
                التشخيص: قيمة_توجيه(المصدر, &اسم_تشخيص),
                النظير: قيمة_توجيه(المصدر, &اسم_نظير),
                الفئة: قيمة_توجيه(المصدر, &اسم_فئة),
                تحقق_الخرج: تحقق_الخرج,
                الخرج_المتوقع: الخرج_المتوقع,
                تحقق_الخطأ: تحقق_الخطأ,
                الخطأ_المتوقع: الخطأ_المتوقع,
                خرج_التشخيص_العربي: ملف_بجوار_اختبار(المسار, قيمة_توجيه(المصدر, &اسم_خرج_تشخيص_عربي)),
                خرج_التشخيص_الإنجليزي: ملف_بجوار_اختبار(المسار, قيمة_توجيه(المصدر, &اسم_خرج_تشخيص_إنجليزي)),
                البيئة: قيمة_توجيه(المصدر, &اسم_بيئة),
                ملف_الخطأ_المتوقع: ملف_بجوار_اختبار(المسار, قيمة_توجيه(المصدر, &اسم_ملف_الخطأ))
            };
            أرجع اختياري.موجود(الوصف);
        };
    };
}

عام عرف اجمع_ملفات_سن(
    الدليل: &نص,
    الناتج: &متغير متجه نص
): منطقي {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع المسار: نص = صل_المسار(الدليل, &المداخل[ف].الاسم);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> {
                // The top-level tests/ar/ispeak and tests/en/ispeak have their own
                // runner (tools/tests/ispeak_test.sh): their benchmark loops are
                // too long for the interpreter path. Any other directory named
                // ispeak is an ordinary test directory.
                دع ispeak_عربي: نص = «tests/ar/ispeak»;
                دع ispeak_إنجليزي: نص = «tests/en/ispeak»;
                لو (!نصان_متساويان(&المسار, &ispeak_عربي) && !نصان_متساويان(&المسار, &ispeak_إنجليزي)) {
                    لو (!اجمع_ملفات_سن(&المسار, الناتج)) { أرجع خطأ; };
                };
            }
            | نوع_مدخل_دليل.ملف -> {
                دع امتداد: نص = «.sn»;
                لو (ينتهي_بـ(&المسار, &امتداد)) { ألحق(*الناتج, المسار); };
            }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع صواب;
    };
}

عام عرف اكتشف_الاختبارات(): نتيجة متجه وصف_اختبار, نص {
    دع الملفات: متغير متجه نص = [];
    دع عربي: نص = «tests/ar»;
    دع انجليزي: نص = «tests/en»;
    لو (!اجمع_ملفات_سن(&عربي, &متغير الملفات)) {
        أرجع نتيجة.خطأ(«تعذر اجتياز tests/ar»);
    };
    لو (!اجمع_ملفات_سن(&انجليزي, &متغير الملفات)) {
        أرجع نتيجة.خطأ(«تعذر اجتياز tests/en»);
    };

    دع الاختبارات: متغير متجه وصف_اختبار = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الملفات) مثل طبيعي)) {
        طابق اقرأ_الملف(&الملفات[ف]) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(«تعذر قراءة ملف اختبار»); }
        | نتيجة.نجح(المصدر) -> {
            طابق حلل_وصف_اختبار(&الملفات[ف], &المصدر) مع
            | اختياري.موجود(الوصف) -> { ألحق(الاختبارات, الوصف); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الاختبارات);
}
