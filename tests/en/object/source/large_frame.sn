// A function whose frame spans several pages: its prologue probes the stack
// page by page on every target with guard pages (tests/runner/suites/objects.sn,
// تحقق_مسابر_المكدس). Twin: tests/ar/object/source/large_frame.sn.

// 64, 512, 4096 and 16384 bytes.
type W = { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64 };
type X = { a: W, b: W, c: W, d: W, e: W, f: W, g: W, h: W };
type Y = { a: X, b: X, c: X, d: X, e: X, f: X, g: X, h: X };
type Z = { a: Y, b: Y, c: Y, d: Y };

def w(s: u64): W { return { a: s, b: s, c: s, d: s, e: s, f: s, g: s, h: s }; }
def x(s: u64): X { let v: W = w(s); return { a: v, b: v, c: v, d: v, e: v, f: v, g: v, h: v }; }
def y(s: u64): Y { let v: X = x(s); return { a: v, b: v, c: v, d: v, e: v, f: v, g: v, h: v }; }

def wide(seed: u64): u64 {
    let z: mutable Z = { a: y(seed), b: y(seed + 1), c: y(seed + 2), d: y(seed + 3) };
    z.d.h.h.h := seed * 2;
    return z.a.a.a.a + z.d.h.h.h;
}

def main(): int {
    return (wide(14) % 256) as int;
}
