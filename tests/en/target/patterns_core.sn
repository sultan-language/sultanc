// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux,aarch64-linux-gnu,i686-linux-gnu,riscv64-linux-gnu,wasm32-wasi
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/target/patterns_core.sn
// The pattern forms on every hosted target, native and LLVM, 32- and 64-bit:
// or-patterns binding names inside payloads inside tuples, guards over
// or-patterns, `as` around an or-pattern, record field punning with only some fields,
// vector patterns with guards and a named rest.
type Shape = | Circle of i64 | Square of i64 | Line of (i64, i64) | Dot;
type Size = { width: i64, height: i64, depth: i64 };

def nested(p: (option Shape, i64)): i64 {
    match p with
    | (option.some(Shape.Circle(n) | Shape.Line(n, _)), 1 | 2) -> { return n; }
    | (option.some(Shape.Square(n)), k) if n > k -> { return n - k; }
    | (option.some(_), _) -> { return 100; }
    | (option.none, k) -> { return k; };
}

def code(s: Shape): i64 {
    match s with
    | Shape.Circle(_) -> { return 1; }
    | Shape.Square(_) -> { return 2; }
    | Shape.Line(_, _) -> { return 3; }
    | Shape.Dot -> { return 4; };
}

def named(s: Shape): i64 {
    match s with
    | Shape.Circle(_) | Shape.Square(_) as round_or_square -> { return 10 * code(round_or_square); }
    | (Shape.Line(a, b)) as line if a == b -> { return code(line); }
    | _ -> { return 0; };
}

def area(s: Size): i64 {
    match s with
    | { width, height: 0 } -> { return width; }
    | { width, height } -> { return width * height; };
}

def sum(s: [] i64): i64 {
    let total: mutable i64 = 0;
    let i: mutable uint = 0;
    while (i < (length(s) as uint)) { total := total + s[i]; i := i + 1; }
    return total;
}

def sequence(v: vector i64): i64 {
    match v with
    | [] -> { return 0; }
    | [x, rest tail] if x > 5 -> { return x + sum(tail); }
    | [rest _, last] -> { return last; };
}

def main(): i64 {
    if (nested((option.some(Shape.Line(7, 1)), 2)) != 7) { return 1; };
    if (nested((option.some(Shape.Square(9)), 4)) != 5) { return 2; };
    if (nested((option.some(Shape.Square(3)), 4)) != 100) { return 3; };
    if (nested((option.none(), 6)) != 6) { return 4; };
    if (named(Shape.Square(1)) != 20 || named(Shape.Line(2, 2)) != 3 || named(Shape.Line(1, 2)) != 0) { return 5; };
    let flat: Size = { width: 6, height: 0, depth: 1 };
    let cube: Size = { width: 2, height: 3, depth: 1 };
    if (area(flat) != 6 || area(cube) != 6) { return 6; };
    let empty: vector i64 = [];
    let big: vector i64 = [10, 1, 2];
    let small: vector i64 = [1, 2, 3];
    if (sequence(empty) != 0 || sequence(big) != 13 || sequence(small) != 3) { return 7; };
    return 42;
}
