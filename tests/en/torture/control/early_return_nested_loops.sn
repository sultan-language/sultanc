// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: control
def locate(limit: int): int {
    let i: mutable int = 0;
    while (i < limit) {
        let j: mutable int = 0;
        while (j < limit) {
            if ((i * j) == 12) { return (i * 10) + j; };
            j := j + 1;
        }
        i := i + 1;
    }
    return 0;
}

def main(): int {
    if (locate(8) != 26) { return 1; };
    return 42;
}
