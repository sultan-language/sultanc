// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: functions
def add(a: int, b: int): int { return a + b; }
def mul(a: int, b: int): int { return a * b; }
def mix(a: int, b: int, c: int): int { return add(mul(a, b), c); }

def main(): int {
    let first: int = mix(4, 5, 1);
    let second: int = mix(first, 2, 0);
    let third: int = add(mix(2, 3, 1), mix(3, 4, 2));
    if (first != 21) { return 1; };
    if (second != 42) { return 2; };
    if (third != 21) { return 3; };
    return second;
}
