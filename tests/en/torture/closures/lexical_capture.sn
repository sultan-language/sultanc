// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: closures
def apply(callback: fn(i32): i32, value: i32): i32 {
    return callback(value);
}

def main(): i32 {
    let base: i32 = 40;
    let add: fn(i32): i32 = fn(x: i32): i32 -> base + x;
    return apply(add, 2);
}
