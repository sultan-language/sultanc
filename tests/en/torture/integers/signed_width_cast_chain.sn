// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: integers
def normalize(value: i64): i32 {
    let narrow: i8 = value as i8;
    let widened: i64 = narrow;
    return widened as i32;
}

def main(): i32 {
    if (normalize(255) != -1) { return 1; };
    if (normalize(127) != 127) { return 2; };
    let answer: i64 = 42;
    return answer as i32;
}
