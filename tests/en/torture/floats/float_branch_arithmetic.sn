// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: floats
type PairF = { left: f64, right: f64 };

def combine(value: PairF): f64 {
    return (value.left * 2.0) + value.right;
}

def main(): i32 {
    let value: PairF = { left: 20.0, right: 2.0 };
    let result: f64 = combine(value);
    if (result < 41.9) { return 1; };
    if (result > 42.1) { return 2; };
    if (result != 42.0) { return 3; };
    return 42;
}
