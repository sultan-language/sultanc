// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: ownership
def increment(value: & mutable i32): void { *value := *value + 1; }
def add(value: & mutable i32, amount: i32): void { *value := *value + amount; }

def main(): i32 {
    let value: mutable i32 = 39;
    let reference: & mutable i32 = & mutable value;
    increment(reference);
    add(reference, 2);
    return *reference;
}
