// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: slices
// A vector, a vector place or a call result passed where `[] T` is expected
// is viewed as a slice without a copy; the vector keeps owning its buffer. A
// slice initialized from a literal or a call result owns the backing vector
// through an anonymous owner in the enclosing block.
def sum(values: [] int): int {
    let total: mutable int = 0;
    let i: mutable uint = 0;
    while (i < (length(values) as uint)) { total := total + values[i]; i := i + 1; }
    return total;
}
def count<T>(values: [] T): uint { return length(values) as uint; }
def make(n: int): vector int {
    let v: mutable vector int = [];
    let i: mutable int = 0;
    while (i < n) { append(v, i); i := i + 1; }
    return v;
}
type Bag = { items: vector int };

def round(k: int): int {
    let v: mutable vector int = [1, 2, 3];
    append(v, k);
    let bag: Bag = { items: make(3) };
    let a: int = sum(v) + sum(bag.items);
    let view: [] int = v;
    let b: int = sum(view);
    let literal: [] int = [10, 20, 12];
    let c: int = sum(literal);
    let d: int = sum(make(5));
    let made: [] int = make(4);
    let e: int = sum(made);
    let f: int = (count(v) as int) + (count(literal) as int);
    return a + b + c + d + e + f + (length(v) as int);
}

def main(): int {
    let i: mutable int = 0;
    let total: mutable int = 0;
    while (i < 2000) { total := total + round(i % 7); i := i + 1; }
    if (total % 251 != 23) { return 1; };
    return 42;
}
