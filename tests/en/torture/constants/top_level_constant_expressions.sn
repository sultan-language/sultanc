// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// فئة: constants
let base: int = 6 * 7;
let shifted: int = (5 << 3) | 2;
let ready: bool = (base == shifted) && !false;
let stored: mutable int = base + (10 % 8) - 2;

def main(): int {
    if (ready && stored == 42) {
        return stored;
    };
    return 0;
}
