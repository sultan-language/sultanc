// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 42
def identity(v: int): int {
    return v;
}

def main(): int {
    let a0: int = 1;
    let a1: int = 2;
    let a2: int = 3;
    let a3: int = 4;
    let a4: int = 5;
    let a5: int = 6;
    let a6: int = 7;
    let a7: int = 8;
    let a8: int = 9;
    let a9: int = 10;
    let a10: int = 11;
    let a11: int = 12;

    let middle: int = identity(identity(a11));
    if (middle != 12) { return 1; };

    let total: int = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11;
    if (total != 78) { return 2; };
    return 42;
}
