// نظير: tests/ar/runtime/failure/main_ok.sn
// `main` returning `result int, Error` (docs/ERRORS.md): on success the
// program exits with the value, as an entry returning `int` does.
import std.error.failure;

def half(x: int): result int, Error {
    if ((x % 2) != 0) { return result.err(error_new("عدد فردي")); };
    return result.ok(x / 2);
}

def main(): result int, Error {
    let h: int = half(84)?;
    return result.ok(h);
}
