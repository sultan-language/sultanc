// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=ar
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: main_error_ar.stderr
// نظير: tests/ar/runtime/failure/main_error_ar.sn
// `main` returning `result int, Error` (docs/ERRORS.md): its error goes through
// the one runtime-failure path, the iSpeak frame "the program ended with an
// error" in the program's language (SULTANC_LANG=ar) and the error's
// error_describe text, exit status 1; native and interpreter agree.
import std.error.failure;
import std.error.context;
import std.error.from_number;
import std.text.number;

def read_port(text: string): result int, Error {
    let port: int = to_error(parse_int(&text), error_from_integer_parse_error)?;
    return result.ok(port);
}

def main(): result int, Error {
    let port: int = with_note(with_context(read_port("80x0"), "أثناء بدء الخادم"), "المنفذ من PORT")?;
    return result.ok(port);
}
