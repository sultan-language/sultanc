// اختبار: تشغيل
// أهداف: x86_64-linux,aarch64-linux-gnu
// خروج: 1
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: stack_overflow_large_frame_en.stderr
// نظير: tests/ar/runtime/failure/stack_overflow_large_frame_en.sn
// A recursion with no end whose frame (a 128 KiB local) is larger than the
// 64 KiB guard of a thread's stack: the prologue probes the frame page by page
// (docs/en/reference/targets.md, "Stack probes"), so the overflow faults in the
// guard instead of stepping over it into another thread's memory, and the
// report writes the frame "the program stopped" and the words of a stack
// overflow, exit status 1. Not run by the interpreter.
import std.thread.thread;

// 64, 512, 4096, 32768 and 131072 bytes.
type W = { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64 };
type X = { a: W, b: W, c: W, d: W, e: W, f: W, g: W, h: W };
type Y = { a: X, b: X, c: X, d: X, e: X, f: X, g: X, h: X };
type Z = { a: Y, b: Y, c: Y, d: Y, e: Y, f: Y, g: Y, h: Y };
type V = { a: Z, b: Z, c: Z, d: Z };

def w(s: u64): W { return { a: s, b: s, c: s, d: s, e: s, f: s, g: s, h: s }; }
def x(s: u64): X { let v: W = w(s); return { a: v, b: v, c: v, d: v, e: v, f: v, g: v, h: v }; }
def y(s: u64): Y { let v: X = x(s); return { a: v, b: v, c: v, d: v, e: v, f: v, g: v, h: v }; }
def z(s: u64): Z { let v: Y = y(s); return { a: v, b: v, c: v, d: v, e: v, f: v, g: v, h: v }; }

def wide(seed: u64): u64 {
    let v: mutable V = { a: z(seed), b: z(seed), c: z(seed), d: z(seed) };
    v.d.h.h.h.h := seed;
    let below: u64 = wide(seed + 1);
    return (below % 1000003) + v.a.a.a.a.a + v.d.h.h.h.h;
}

def main(): int {
    match spawn_value(fn(): u64 -> wide(1)) with
    | result.ok(h) -> {
        let handle: mutable value_join_handle<u64> = h;
        match join_value(&mutable handle) with
        | option.some(value) -> { return (value % 100) as int; }
        | option.none -> { return 3; };
    }
    | result.err(_) -> { return 2; };
}
