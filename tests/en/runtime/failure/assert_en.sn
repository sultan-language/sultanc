// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: assert_en.stderr
// نظير: tests/ar/runtime/failure/assert_en.sn
// A failed assertion (std.debug.assert, docs/en/reference/errors.md) stops the program
// through the same path as panic: the iSpeak frame "the program stopped"
// with the reason "an assertion failed", then the optional message, exit
// status 1. A passing assertion prints nothing.
import std.debug.assert;

def main(): int {
    assert(1 + 1 == 2);
    let message: string = "يجب أن يكون الحجم موجبا";
    assert_with_message(0 > 1, &message);
    return 0;
}
