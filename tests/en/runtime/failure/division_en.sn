// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: division_en.stderr
// نظير: tests/ar/runtime/failure/division_en.sn
// A division by zero (docs/en/reference/errors.md, "Runtime checks") stops the
// program through the panic path: the frame "the program stopped", then the
// kind and the place of the division, exit status 1.
def divide(total: int, parts: int): int {
    return total / parts;
}

def main(): int {
    return divide(10, 0);
}
