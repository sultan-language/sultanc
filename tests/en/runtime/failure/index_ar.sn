// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=ar
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: index_ar.stderr
// نظير: tests/ar/runtime/failure/index_ar.sn
// An index past the end of a vector (docs/en/reference/errors.md, "Runtime checks")
// stops the program through the panic path: the frame "the program stopped",
// then the index, the length and the place of the indexing, exit status 1.
def main(): int {
    let values: vector int = [10, 20, 30];
    let position: int = 5;
    return values[position];
}
