// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en_US.UTF-8
// خطأ-قياسي-ملف: panic_posix_locale.stderr
// نظير: tests/ar/runtime/failure/panic_posix_locale.sn
// The program's language comes from std.text.system_language, the one
// reading of the language variables (docs/ERRORS.md): a POSIX value
// (en_US.UTF-8) names English, so the frame of panic is English.
import std.process.panic;

def main(): int {
    panic("توقف عمدا");
    return 0;
}
