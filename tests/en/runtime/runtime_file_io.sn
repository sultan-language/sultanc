// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// خرج-قياسي: <فارغ>
// خطأ-قياسي: <فارغ>
import std.fs.read_file;
import std.fs.write_file;

def main(): int {
    let path: string = "stage0-runtime.tmp";
    let content: string = "*";
    let written: result int, int = write_file(&path, &content);
    match written with
    | result.err(e) -> { return e; }
    | result.ok(n) -> {
        let loaded: result string, int = read_file(&path);
        match loaded with
        | result.err(e) -> { return e; }
        | result.ok(text) -> { return text[0]; }
    }
}
