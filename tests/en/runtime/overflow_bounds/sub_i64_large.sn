// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: sub_i64_large.stderr
// نظير: tests/ar/runtime/overflow_bounds/sub_i64_large.sn
// A checked i64 subtract past its bound (-2 minus the largest value) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector i64 = [-2, 9223372036854775807];
    let result: i64 = values[0] - values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
