// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: mul_u16.stderr
// نظير: tests/ar/runtime/overflow_bounds/mul_u16.sn
// A checked u16 multiply past its bound (2^8 times 2^8) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector u16 = [256, 256];
    let result: u16 = values[0] * values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
