// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: add_i32_negative.stderr
// نظير: tests/ar/runtime/overflow_bounds/add_i32_negative.sn
// A checked i32 add past its bound (the least value plus -1) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector i32 = [-2147483647 - 1, -1];
    let result: i32 = values[0] + values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
