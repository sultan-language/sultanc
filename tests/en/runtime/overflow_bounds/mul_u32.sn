// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: mul_u32.stderr
// نظير: tests/ar/runtime/overflow_bounds/mul_u32.sn
// A checked u32 multiply past its bound (2^16 times 2^16) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector u32 = [65536, 65536];
    let result: u32 = values[0] * values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
