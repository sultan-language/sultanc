// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: loop_le_bound.stderr
// نظير: tests/ar/runtime/overflow_bounds/loop_le_bound.sn
// `i <= n` does not prove `i + 1`: range-based check removal keeps the check,
// which reports the overflow when n is the largest value.
def main(): int {
    let values: vector i64 = [9223372036854775805, 9223372036854775807];
    let i: mutable i64 = values[0];
    while (i <= values[1]) {
        i := i + 1;
    }
    return 0;
}
