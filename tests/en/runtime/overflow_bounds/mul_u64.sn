// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: mul_u64.stderr
// نظير: tests/ar/runtime/overflow_bounds/mul_u64.sn
// A checked u64 multiply past its bound (2^32 times 2^32) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector u64 = [4294967296, 4294967296];
    let result: u64 = values[0] * values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
