// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 1
// تفاضلي: نعم
// بيئة: SULTANC_LANG=en
// خرج-قياسي: <فارغ>
// خطأ-قياسي-ملف: add_u8.stderr
// نظير: tests/ar/runtime/overflow_bounds/add_u8.sn
// A checked u8 add past its bound (the largest value plus 1) reports the overflow at the
// operation on every code generator (docs/en/internals/msir-and-codegen.md).
def main(): int {
    let values: vector u8 = [255, 1];
    let result: u8 = values[0] + values[1];
    if (result == values[0]) { return 3; };
    return 0;
}
