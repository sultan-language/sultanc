// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/language/surface/if_expression.sn
// `if … else` as a value: after `let`, `:=` and `return`, as an argument and an
// operand, nested, with `else if` chains, braced branches whose last
// expression is the value, branches that return or leave a loop instead of
// giving a value, owned values moved into the result, beside a match
// expression, and in a closure. A bare else branch reads as far as it can.
def sign(n: int): int {
    return if (n > 0) 1 else if (n < 0) -1 else 0;
}

def size(n: int): string {
    return if (n == 0) "none" else if (n < 10) "small" else "big";
}

def first_or(v: vector int, fallback: int): int {
    let value: int = if (length(v) > 0) v[0] else { return fallback; };
    return value * 2;
}

def first_even(v: vector int): int {
    let i: mutable int = 0;
    let found: mutable int = -1;
    while (i < length(v)) {
        let x: int = v[i];
        found := if (x % 2 == 0) x else { i := i + 1; continue; };
        break;
    }
    return found;
}

def owned(flag: bool): string {
    let a: string = "left";
    let b: string = "right";
    let picked: string = if (flag) a else b;
    return picked;
}

def main(): int {
    if (sign(5) != 1 || sign(-3) != -1 || sign(0) != 0) { return 1; };
    if (length(size(0)) != 4 || length(size(3)) != 5 || length(size(30)) != 3) { return 2; };
    let n: int = 7;
    let doubled: int = if (n > 5) { let t: int = n * 2; t + 1 } else { 0 };
    if (doubled != 15) { return 3; };
    // The else branch is `2 + 10`.
    let wide: int = if (n > 100) 1 else 2 + 10;
    if (wide != 12) { return 4; };
    let total: int = 3 + (if (n > 0) 4 else 5);
    if (total != 7) { return 5; };
    if (first_or([], 9) != 9 || first_or([4], 9) != 8) { return 6; };
    if (first_even([1, 3, 6, 7]) != 6) { return 7; };
    if (length(owned(true)) != 4 || length(owned(false)) != 5) { return 8; };
    let kind: int = if (n > 0) (match n % 3 with | 0 -> 30 | r -> r) else 0;
    if (kind != 1) { return 9; };
    let pick: fn(int): int = fn(x: int): int -> if (x > 0) x else -x;
    if (pick(-4) != 4 || sign(pick(-2)) != 1) { return 10; };
    let changed: mutable int = 0;
    changed := if (n == 7) 2 else 3;
    return 40 + changed;
}
