// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// نظير: tests/ar/language/surface/hidden_reference_arguments.sn
// A record larger than the hidden-reference threshold (8 bytes on x86-64,
// 16 on AArch64) is passed between SultanC functions as a hidden reference
// (the address of storage the caller keeps unchanged for
// the call; compiler/msir/msir_copies.sn, مخازن_ثابتة_للنداء_مسير), yet an
// argument keeps value semantics: a callee that changes its parameter
// changes its own copy; the same record passed twice is two equal values;
// a record also changed through a reference, a global, or a box during the
// call is the value it had at the call; a block parameter (a value of an
// earlier loop iteration) passed back into the call that replaces it, and
// `x := f(x)` with the result built while the argument is read, read the
// argument before the result overwrites it; recursion, closures (a captured
// record, a record parameter of a function value) and tagged values with
// large payloads keep their values. A 16-byte record (Duo) is a hidden
// reference on x86-64 and two registers on AArch64.
type Duo = { u: int, v: int };
type Big = { a: int, b: int, c: int, d: int, e: int };
type Wide = { left: Big, right: Big, tag: int };
type Shape =
    | Box of Big
    | Pair of (Big, Big)
    | Dot
;

let pool: mutable vector Big = [];

def big(n: int): Big { return { a: n, b: n + 1, c: n + 2, d: n + 3, e: n + 4 }; }
def total(p: Big): int { return p.a + p.b + p.c + p.d + p.e; }

// The callee changes its own copy of the parameter.
def changed_copy(p: Big): int {
    let own: mutable Big = p;
    own.a := 100;
    own.e := 200;
    return own.a + own.e + p.a;
}

// Two parameters bound to the same record.
def same_twice(p: Big, q: Big): int {
    let own: mutable Big = p;
    own.b := 50;
    return own.b + q.b + p.b;
}

// The record is changed through a reference while the callee runs.
def through_reference(p: Big, r: &mutable Big): int {
    (*r).a := 77;
    (*r).d := 88;
    return p.a + p.d;
}

// The record is an element of a global vector the callee changes and grows.
def through_global(p: Big): int {
    unsafe {
        pool[0].a := 1000;
        pool[0] := big(500);
        let k: mutable int = 0;
        while (k < 64) { append(pool, big(k)); k := k + 1; }
    }
    return p.a + p.e;
}

// The record lives in a box the callee replaces (and so releases).
def through_box(p: Big, b: &mutable box Big): int {
    let fresh: box Big = box big(900);
    *b := fresh;
    return p.c;
}

// Swaps the halves while it reads them: the result is built in the
// caller's storage while the argument is read.
def swapped(w: Wide): Wide {
    return { left: w.right, right: w.left, tag: w.tag + 1 };
}

def shifted(p: Big): Big {
    return { a: p.e, b: p.a, c: p.b, d: p.c, e: p.d };
}

def depth(p: Big, n: int): int {
    if (n == 0) { return total(p); };
    let next: Big = { a: p.a + 1, b: p.b, c: p.c, d: p.d, e: p.e };
    let below: int = depth(next, n - 1);
    // p is unchanged by the deeper calls.
    return below + p.a;
}

def area(s: Shape): int {
    match s with
    | Shape.Box(b) -> { return total(b); }
    | Shape.Pair(l, r) -> { return total(l) - total(r); }
    | Shape.Dot -> { return 0; };
}

def apply(f: fn(Big): int, p: Big): int { return f(p); }

def duo_changed(d: Duo, r: &mutable Duo): int {
    (*r).u := 9;
    let own: mutable Duo = d;
    own.v := 5;
    return d.u + d.v + own.v;
}

def flip(d: Duo): Duo { return { u: d.v, v: d.u }; }

def main(): int {
    let x: Big = big(1);
    if (changed_copy(x) != 301 || x.a != 1 || x.e != 5) { return 1; };
    if (same_twice(x, x) != 54 || x.b != 2) { return 2; };

    let local: mutable Big = big(10);
    if (through_reference(local, &mutable local) != 23 || local.a != 77 || local.d != 88) { return 3; };

    let from_global: mutable int = 0;
    let after: mutable int = 0;
    unsafe {
        append(pool, big(1));
        from_global := through_global(pool[0]);
        after := pool[0].a;
    }
    if (from_global != 6 || after != 500) { return 4; };

    let boxed: mutable box Big = box big(20);
    if (through_box(*boxed, &mutable boxed) != 22 || (*boxed).c != 902) { return 5; };

    // x := f(x) on a local and on a record field.
    let w: mutable Wide = { left: big(1), right: big(10), tag: 0 };
    w := swapped(w);
    if (w.left.a != 10 || w.right.a != 1 || w.tag != 1) { return 6; };
    w := swapped(w);
    if (w.left.a != 1 || w.right.a != 10 || w.tag != 2) { return 7; };
    w.left := shifted(w.left);
    if (w.left.a != 5 || w.left.b != 1 || w.left.e != 4) { return 8; };

    // A loop-carried record: each iteration passes the previous result.
    let p: mutable Big = big(1);
    let i: mutable int = 0;
    while (i < 5) {
        p := shifted(p);
        i := i + 1;
    }
    if (p.a != 1 || p.b != 2 || p.e != 5) { return 9; };

    if (depth(big(1), 4) != 29) { return 10; };

    // Closures: a captured record, and a record parameter of a function value.
    let captured: Big = big(3);
    let reader: fn(int): int = fn(k: int): int -> total(captured) + k;
    if (reader(1) != 26) { return 11; };
    let summed: fn(Big): int = fn(q: Big): int -> changed_copy(q) + q.a;
    if (apply(summed, x) != 302 || x.a != 1) { return 12; };
    if (apply(total, big(2)) != 20) { return 13; };

    // Tagged values with large payloads.
    if (area(Shape.Box(big(1))) != 15) { return 14; };
    if (area(Shape.Pair(big(5), big(1))) != 20) { return 15; };
    if (area(Shape.Dot()) != 0) { return 16; };

    // A record of plain values is copied: the original stays usable.
    let y: Big = big(7);
    let first: int = total(y);
    if (first != total(y) || y.a != 7) { return 17; };

    // A 16-byte record changed through a reference during the call, then
    // replaced by a result built from it.
    let duo: mutable Duo = { u: 1, v: 2 };
    if (duo_changed(duo, &mutable duo) != 8 || duo.u != 9 || duo.v != 2) { return 18; };
    duo := flip(duo);
    if (duo.u != 2 || duo.v != 9) { return 19; };
    return 42;
}
