// اختبار: رفض
// تشخيص: SULTANC-TYPE-MISMATCH
// نظير: tests/ar/language/surface/reject_generic_operator_not_defined.sn
// A generic body may apply `>` to its type parameter; instantiated with a
// record, which defines no ordering, the instantiation is a type error at
// the operation (`>` is not defined for `Point`), not an internal error.
type Point = { x: int, y: int };

def larger<T>(a: T, b: T): bool { return a > b; }

def main(): int {
    let a: Point = { x: 1, y: 2 };
    let b: Point = { x: 3, y: 4 };
    if (larger(3, 2) && larger(a, b)) { return 1; };
    return 0;
}
