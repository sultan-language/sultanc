// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// خرج-قياسي: hello world مرحبا 😀
// نظير: tests/ar/language/surface/text_slices.sn
// Slices of text: `&s[a..b]` is a `&string` viewing the bytes a through b of
// s, both included, with no copy (docs/en/reference/type-system.md, "Text
// slices"). ASCII, Arabic (two bytes a letter) and emoji (four bytes) cut at
// character boundaries; whole, open-ended and empty slices; `&s` and
// `&s[..]` alike; comparison with literals, strings and other slices; a
// match on a slice; slices passed to and returned from functions taking
// `&string`; a slice of a slice; std's read-only text functions; owned
// copies; printing.
import std.io.print;
import std.text.search;
import std.text.from_bytes;

def count_bytes(text: &string): int {
    return length(*text);
}

// The first word of a text: a slice of the text it is given.
def first_word(text: &string): &string {
    let end: mutable int = 0;
    while (end < length(*text) && (*text)[end] != 32) { end := end + 1; }
    return &text[0..end - 1];
}

def main(): int {
    let s: string = "hello world";
    let w: &string = &s[6..10];
    if (*w != "world") { return 1; };
    if (w != "world") { return 2; };
    if (length(*w) != 5) { return 3; };
    // A borrow of all of a text and a slice of all of it are the same value.
    let all: &string = &s;
    let whole: &string = &s[..];
    if (*all != *whole || length(*whole) != 11 || all != whole) { return 4; };
    let head: &string = &s[..4];
    let tail: &string = &s[6..];
    if (*head != "hello" || *tail != "world") { return 5; };
    // Empty slices: `&s[a..a - 1]`, a start at the length, an end of -1.
    let empty: &string = &s[3..2];
    let none_left: &string = &s[11..];
    let none_right: &string = &s[..-1];
    if (length(*empty) != 0 || length(*none_left) != 0 || length(*none_right) != 0 || *empty != "") { return 6; };
    // Comparison with a string and with other slices, byte by byte.
    let world: string = "world";
    if (*w != world || w != tail || world != *tail) { return 7; };
    if (w == head) { return 8; };
    // A slice of a slice, through the reference or written out.
    let orl: &string = &w[1..3];
    let orl_again: &string = &(*w)[1..3];
    if (*orl != "orl" || orl != orl_again) { return 9; };
    // Slices passed to and returned from functions.
    if (count_bytes(w) != 5 || count_bytes(&s[0..0]) != 1) { return 10; };
    let word: &string = first_word(&s);
    if (word != "hello") { return 11; };
    // Arabic: two bytes a letter.
    let arabic: string = "مرحبا بالعالم";
    let greeting: &string = &arabic[0..9];
    if (greeting != "مرحبا" || length(*greeting) != 10) { return 12; };
    let ra: &string = &arabic[2..3];
    if (ra != "ر") { return 13; };
    let rest: &string = &arabic[11..];
    if (rest != "بالعالم" || first_word(&arabic) != greeting) { return 14; };
    // Emoji: four bytes.
    let faces: string = "😀😃x";
    let second: &string = &faces[4..7];
    if (second != "😃" || length(*second) != 4) { return 15; };
    let last: &string = &faces[8..];
    if (last != "x") { return 16; };
    let first_face: &string = &faces[..3];
    if (first_face != "😀") { return 17; };
    // A match on a slice.
    let kind: int = match *w with | "hello" -> 1 | "world" -> 2 | _ -> 3;
    if (kind != 2) { return 18; };
    // std's read-only text functions take any `&string`.
    if (!starts_with(w, &"wor") || !ends_with(&s[0..4], &"llo") || !contains(&arabic[11..], &"عالم")) { return 19; };
    // Owned copies.
    let copied: string = copy_text(w);
    let cloned: string = clone(&arabic[0..9]);
    if (copied != "world" || cloned != "مرحبا") { return 20; };
    // The text is read while the slices are alive: no copy was made.
    if (s != "hello world") { return 21; };
    print(&s[0..4]);
    print(" ");
    print(w);
    print(" ");
    print(greeting);
    print(" ");
    print(&faces[0..3]);
    return 42;
}
