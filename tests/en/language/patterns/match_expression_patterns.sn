// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/language/patterns/match_expression_patterns.sn
// The arms of a match expression are the match statement's arms: guards
// (`| p if c -> v`, the bindings borrowed while the guard runs, an owned
// payload moved by a later arm after a guard failed on it), or-patterns,
// `as` names, record patterns with only some fields and punned fields, and
// vector patterns (owning elements are views of the vector, `rest tail` a
// slice of it), also with braced arms, a match expression in a guard, and in a
// closure body.
type Shape = | Circle of int | Square of int | Rect of (int, int) | Dot;
type Size = { width: int, height: int, depth: int };
type Named = | One of string | Two of (string, string) | Nothing;

def kind(s: Shape): int {
    return match s with
    | Shape.Circle(r) if r > 10 -> 3
    | Shape.Circle(_) | Shape.Dot -> 1
    | Shape.Rect(w, h) if w == h -> 2
    | Shape.Rect(_, _) -> 0
    | Shape.Square(n) -> n;
}

def width_of(s: Size): int {
    return match s with
    | { width: w } if w > 10 -> w
    | { width, height: h, depth } -> width + h + depth;
}

def area(s: Size): int {
    let a: int = match s with | { width, height } -> width * height;
    return a;
}

def side(s: Shape): int {
    return match s with
    | Shape.Circle(r) as c -> r + kind(c)
    | Shape.Square(n) as q -> n + kind(q)
    | other -> kind(other);
}

def count_of(n: Named): int {
    return match n with
    | Named.One(s) -> length(s) as int
    | Named.Two(a, b) -> (length(a) as int) + (length(b) as int)
    | Named.Nothing -> 0;
}

def count_view(n: &Named): int {
    return match *n with
    | Named.One(_) -> 1
    | Named.Two(_, _) -> 2
    | Named.Nothing -> 0;
}

def whole(n: Named): int {
    return match n with
    | Named.One(_) as all -> count_of(all)
    | Named.Two(a, _) as all -> (length(a) as int) + count_view(&all)
    | Named.Nothing -> 0;
}

def sum(s: [] int): int {
    let total: mutable int = 0;
    let i: mutable uint = 0;
    while (i < (length(s) as uint)) {
        total := total + s[i];
        i := i + 1;
    }
    return total;
}

def describe(v: vector int): int {
    return match v with
    | [] -> 0
    | [a] -> a
    | [a, b] -> a + b
    | [first, rest _, last] -> first * 100 + last;
}

def head_rest(v: vector int): int {
    return match v with
    | [first, rest tail] -> first + 10 * sum(tail)
    | [] -> 0;
}

def guarded(v: vector int): int {
    return match v with
    | [x, rest _] if x > 5 -> 1
    | [_, rest _] -> 2
    | [] -> 3;
}

def owned_elements(v: vector string): int {
    return match v with
    | [a, b, rest _] -> (length(a) as int) + (length(b) as int)
    | [a] -> length(a) as int
    | [] -> 0;
}

def first_some(v: vector option int): int {
    return match v with
    | [option.some(n), rest _] | [_, option.some(n), rest _] -> n
    | _ -> 0;
}

def take(s: string): int { return length(s) as int; }

// The first arm's guard reads the payload and fails; the second arm moves it.
def moved_after_failed_guard(n: Named): int {
    return match n with
    | Named.One(s) if length(s) > 100 -> 0
    | Named.One(s) | Named.Two(s, _) -> take(s)
    | Named.Nothing -> 1;
}

def nested_guard(x: int): int {
    return match x with
    | v if (match v % 2 with | 0 -> true | _ -> false) -> {
        let h: int = v / 2;
        h
    }
    | v -> v;
}

def main(): int {
    if (kind(Shape.Circle(20)) != 3 || kind(Shape.Circle(2)) != 1 || kind(Shape.Dot()) != 1) { return 1; };
    if (kind(Shape.Rect(2, 2)) != 2 || kind(Shape.Rect(2, 3)) != 0 || kind(Shape.Square(4)) != 4) { return 2; };
    let big: Size = { width: 20, height: 1, depth: 1 };
    let small: Size = { width: 1, height: 2, depth: 3 };
    let cube: Size = { width: 2, height: 3, depth: 4 };
    if (width_of(big) != 20 || width_of(small) != 6 || area(cube) != 6) { return 3; };
    if (side(Shape.Circle(2)) != 3 || side(Shape.Square(3)) != 6 || side(Shape.Dot()) != 1) { return 4; };
    if (whole(Named.One("abc")) != 3 || whole(Named.Two("ab", "cde")) != 4 || whole(Named.Nothing()) != 0) { return 5; };
    if (describe([]) != 0 || describe([7]) != 7 || describe([3, 4]) != 7 || describe([1, 2, 3, 9]) != 109) { return 6; };
    if (head_rest([1, 2, 3, 9]) != 141 || head_rest([]) != 0) { return 7; };
    if (guarded([7]) != 1 || guarded([3, 4]) != 2 || guarded([]) != 3) { return 8; };
    if (owned_elements(["ab", "cde", "f"]) != 5 || owned_elements(["xyz"]) != 3 || owned_elements([]) != 0) { return 9; };
    if (first_some([option.some(5), option.none()]) != 5 || first_some([option.none(), option.some(6)]) != 6) { return 10; };
    if (first_some([option.none()]) != 0) { return 11; };
    if (moved_after_failed_guard(Named.One("abcd")) != 4 || moved_after_failed_guard(Named.Two("ab", "x")) != 2) { return 12; };
    if (moved_after_failed_guard(Named.Nothing()) != 1) { return 13; };
    if (nested_guard(10) != 5 || nested_guard(7) != 7) { return 14; };
    let pick: fn(Shape): int = fn(s: Shape): int -> match s with | Shape.Circle(r) if r > 1 -> r | _ -> 0;
    if (pick(Shape.Circle(5)) != 5 || pick(Shape.Circle(1)) != 0 || pick(Shape.Dot()) != 0) { return 15; };
    return 42;
}
