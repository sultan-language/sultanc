// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-COMPTIME-FAILED
// نظير: tests/ar/language/comptime/reject_folded_compile_error.sn
// خرج-تشخيص-إنجليزي: reject_folded_compile_error.en.txt
// The specialized copy for 42 takes the branch with compile_error: the
// compilation fails with its message, never a run-time trap.
import std.meta.reflect;

def checked(comptime n: int, x: int): int {
    if (n > 10) {
        compile_error("n must be at most 10");
    };
    return n + x;
}

def main(): int {
    let x: mutable int = 1;
    x := x + 1;
    return checked(42, x);
}
