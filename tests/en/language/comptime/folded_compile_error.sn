// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/language/comptime/folded_compile_error.sn
// In a specialized copy a run-time `if` whose condition the compile-time
// arguments decide is folded, so only the taken branch of a condition known
// at compile time is analyzed: a compile_error on the branch not taken never
// fires, and compile-time work there is not evaluated.
import std.meta.reflect;

def checked(comptime n: int, x: int): int {
    if (n > 10) {
        compile_error("n must be at most 10");
    };
    if (n < 0 || n == 99) {
        compile_error("n must not be negative");
    } else {
        if (n + 1 > 100) { compile_error("unreachable"); };
    };
    return n + x;
}

def divide(comptime d: int, x: int): int {
    if (d == 0) {
        return 0;
    };
    // Evaluated only in copies with a nonzero divisor.
    let q: int = comptime (100 / d);
    return q + x;
}

def main(): int {
    let x: mutable int = 1;
    x := x + 1;
    let a: int = checked(4, x);
    let b: int = divide(0, x);
    let c: int = divide(10, x);
    if (a != 6 || b != 0 || c != 12) { return 1; };
    return a + b + c + 24;
}
