// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// Values whose borrows end before they move are still destroyed exactly once
// (docs/en/internals/ownership-analysis.md, "Borrow regions" and "Drop
// elaboration"). A text read through a reference moves on some paths only
// and is destroyed on the others; a local given a value on some paths is
// given a new one, and only an old value that exists is destroyed; a loop
// reads through a reference, moves the text out and gives it a new value in
// each iteration; a record read through a reference moves out whole with the
// member it returns and destroys the other one; an early return out of a
// loop moves the text a reference last read. Each case runs many times on
// texts the heap holds, and the allocator's live bytes must return to their
// starting value after it: a value never destroyed grows them, one
// destroyed twice traps in the allocator, and one destroyed too early gives
// a wrong length.
// Counterpart: tests/ar/language/ownership/borrow_drop_paths.sn; no pair
// directive: the interpreter does not use the std allocator whose counters
// this reads.
import std.os.allocation;
import std.text.number;

type pair = { left: string, right: string };

// Seven digits, on the heap.
def payload(n: uint): string { return int_to_text((n + 1000000) as int); }

def take(text: string): int { return length(text) as int; }

def move_after_borrow(n: uint): int {
    let text: string = payload(n);
    let seen: &string = &text;
    let first: int = length(*seen) as int;
    if ((n % 2) == 0) {
        return first + take(text);
    };
    return first;
}

def conditional_then_reassigned(n: uint): int {
    let text: mutable string;
    if ((n % 3) == 0) { text := payload(n); };
    text := payload(n + 1);
    return take(text);
}

def loop_moves(n: uint): int {
    let text: mutable string = payload(n);
    let total: mutable int = 0;
    let i: mutable uint = 0;
    while (i < 3) {
        let view: &string = &text;
        total := total + (length(*view) as int);
        total := total + take(text);
        text := payload(n + i);
        i := i + 1;
    }
    return total;
}

def right_of(n: uint): string {
    let both: pair = { left: payload(n), right: payload(n + 1) };
    let peek: &pair = &both;
    if (length((*peek).left) == 0) { return payload(0); };
    return both.right;
}

def early_exit(n: uint): int {
    let kept: string = payload(n);
    let total: mutable int = 0;
    let i: mutable uint = 0;
    while (i < 5) {
        let inner: string = payload(n + i);
        let seen: &string = &inner;
        if (i == 2) { return total + take(inner) + (length(kept) as int); };
        total := total + (length(*seen) as int);
        i := i + 1;
    }
    return 0;
}

def check(case: uint, n: uint): int {
    if (case == 0) { return move_after_borrow(n); };
    if (case == 1) { return conditional_then_reassigned(n); };
    if (case == 2) { return loop_moves(n); };
    if (case == 3) { return take(right_of(n)); };
    return early_exit(n);
}

def expected(case: uint, n: uint): int {
    if (case == 0) {
        if ((n % 2) == 0) { return 14; };
        return 7;
    };
    if (case == 1) { return 7; };
    if (case == 2) { return 42; };
    if (case == 3) { return 7; };
    return 28;
}

def main(): int {
    let warm_up: int = check(0, 0) + check(4, 0);
    let case: mutable uint = 0;
    while (case < 5) {
        let before: u64 = بايتات_حية_مخصص_النظام();
        let n: mutable uint = 0;
        while (n < 2000) {
            if (check(case, n) != expected(case, n)) { return 10 + (case as int); };
            n := n + 1;
        }
        let after: u64 = بايتات_حية_مخصص_النظام();
        if (after != before) { return 20 + (case as int); };
        case := case + 1;
    }
    if (warm_up != 42) { return 1; };
    return 42;
}
