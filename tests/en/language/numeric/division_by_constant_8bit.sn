// خروج: 42
// نظير: tests/ar/language/numeric/division_by_constant_8bit.sn
// Division and remainder by every u8 and i8 constant (0 and -1 keep the
// trapping divide) over every dividend, against the same division by a
// value only known at run time. The native selectors replace a constant
// divisor by a multiply (backend/codegen/division_by_constant.sn); LLVM does
// it itself. Generated; each function checks one divisor.
import std.process.argument_count;

def t_u8_1(one: u8): bool {
    let d: u8 = 1 * one;
    let i: mutable uint = 0;
    while (i < 256) {
        let x: u8 = i as u8;
        if (x / 1 != x / d || x % 1 != x % d) { return false; };
        i := i + 1;
    }
    return true;
}
