// نظير: tests/ar/language/numeric/division_widths.sn
// Division and remainder of every integer width (truncating, as Rust and
// C99): the LLVM backend expands them where the target has no divide
// instruction (ARMv7-A, AVR, MSP430, Hexagon, Lanai) and does narrow
// division in 64 bits on SPARC V9. Expected values computed in Python.
def div_i8(a: i8, b: i8): i8 { return a / b; }
def rem_i8(a: i8, b: i8): i8 { return a % b; }
def div_i16(a: i16, b: i16): i16 { return a / b; }
def rem_i16(a: i16, b: i16): i16 { return a % b; }
def div_i32(a: i32, b: i32): i32 { return a / b; }
def rem_i32(a: i32, b: i32): i32 { return a % b; }
def div_i64(a: i64, b: i64): i64 { return a / b; }
def rem_i64(a: i64, b: i64): i64 { return a % b; }
def div_u8(a: u8, b: u8): u8 { return a / b; }
def rem_u8(a: u8, b: u8): u8 { return a % b; }
def div_u16(a: u16, b: u16): u16 { return a / b; }
def rem_u16(a: u16, b: u16): u16 { return a % b; }
