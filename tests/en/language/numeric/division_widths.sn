    if (div_i64(9223372036854775807, 7) != 1317624576693539401 || rem_i64(9223372036854775807, 7) != 0) { return 12; };
    if (div_i64((-100), 3) != (-33) || rem_i64((-100), 3) != (-1)) { return 13; };
    if (div_i64(100, (-7)) != (-14) || rem_i64(100, (-7)) != 2) { return 14; };
    if (div_i64((-7), (-2)) != 3 || rem_i64((-7), (-2)) != (-1)) { return 15; };
    if (div_i64(7, 2) != 3 || rem_i64(7, 2) != 1) { return 16; };
    if (div_i64((-1), 9223372036854775807) != 0 || rem_i64((-1), 9223372036854775807) != (-1)) { return 17; };
    if (div_i64((-9223372036854775807), (-1)) != 9223372036854775807 || rem_i64((-9223372036854775807), (-1)) != 0) { return 18; };
    if (div_i64(0, (-5)) != 0 || rem_i64(0, (-5)) != 0) { return 19; };
    if (div_i64(9223372036854775807, 9223372036854775807) != 1 || rem_i64(9223372036854775807, 9223372036854775807) != 0) { return 20; };
    if (div_u8(255, 1) != 255 || rem_u8(255, 1) != 0) { return 21; };
