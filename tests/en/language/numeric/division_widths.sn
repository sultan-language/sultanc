    if (div_i64((-9223372036854775807 - 1), 3) != (-3074457345618258602) || rem_i64((-9223372036854775807 - 1), 3) != (-2)) { return 8; };
    if (div_i64((-9223372036854775807 - 1), 9223372036854775807) != (-1) || rem_i64((-9223372036854775807 - 1), 9223372036854775807) != (-1)) { return 9; };
    if (div_i64(9223372036854775807, (-1)) != (-9223372036854775807) || rem_i64(9223372036854775807, (-1)) != 0) { return 10; };
