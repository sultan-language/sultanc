// نظير: tests/ar/language/numeric/division_by_constant_16bit.sn
// Division and remainder by u16 and i16 constants (small, powers of two and
// their neighbours, the extremes and random ones) over every dividend,
// against the same division by a value only known at run time. Generated.
import std.process.argument_count;

def t_u16_1(one: u16): bool {
    let d: u16 = 1 * one;
    let i: mutable uint = 0;
    while (i < 65536) {
        let x: u16 = i as u16;
        if (x / 1 != x / d || x % 1 != x % d) { return false; };
        i := i + 1;
    }
    return true;
}
