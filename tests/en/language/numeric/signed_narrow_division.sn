// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/language/numeric/signed_narrow_division.sn
// Division and remainder on narrow signed integers (i8, i16, i32): the native
// x86_64 backend used to trap at compile time while building the type's
// minimum sign-extended to 64 bits.
def div8(a: i8, b: i8): i8 { return a / b; }
def rem16(a: i16, b: i16): i16 { return a % b; }
def div32(a: i32, b: i32): i32 { return a / b; }
def main(): int {
    if (div8(-100, 3) != -33 || div8(-128, 2) != -64 || div8(127, -1) != -127) { return 1; };
    if (rem16(-32768, 7) != -1 || rem16(1000, -7) != 6) { return 2; };
    if (div32(-2147483647 - 1, 4) != -536870912 || div32(7, -2) != -3) { return 3; };
    return 42;
}
