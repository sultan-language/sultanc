// اختبار: رفض
// تشخيص: SULTANC-PARSE-SYNTAX
// نظير: tests/ar/language/propagation/reject_position.sn
// `?` is accepted only as the last postfix of a statement's whole right-hand
// side (docs/en/reference/errors.md); inside a call argument it is an unexpected token.
def parse(x: int): result int, string {
    return result.ok(x);
}

def twice(x: int): result int, string {
    let v: int = parse(parse(x)?)?;
    return result.ok(v);
}

def main(): int { return 0; }
