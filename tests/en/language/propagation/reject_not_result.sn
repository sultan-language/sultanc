// اختبار: رفض
// تشخيص: SULTANC-TYPE-RETURN-MISMATCH
// نظير: tests/ar/language/propagation/reject_not_result.sn
// `?` returns the error, so the function must return a result (or an option
// for an option): in a function returning `int` it is a return type
// mismatch at the `?`, naming both types.
def parse(x: int): result int, string {
    return result.ok(x);
}

def main(): int {
    let v: int = parse(1)?;
    return v;
}
