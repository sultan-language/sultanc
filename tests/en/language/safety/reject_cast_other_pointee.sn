// اختبار: رفض
// أهداف: arm64-darwin,x86_64-linux
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/ar/language/safety/reject_cast_other_pointee.sn
// A raw pointer cast to a pointer of another pointee type needs unsafe.
type First = { value: int };
type Second = { other: int };

def main(): int {
    let p: *First = 0 as *First;
    let q: *Second = p as *Second;
    return 0;
}
