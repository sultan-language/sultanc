// Rust: the trait UpperHex is not implemented for str.
import std.fmt.fmt;

def main(): int {
    let name: string = "Sultan";
    match format("{} {:X}", [fmt_arg.int(1), fmt_arg.text(&name)]) with
    | result.ok(_) -> { return 0; }
    | result.err(_) -> { return 1; };
}
