// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/ar/stdlib/fmt/reject_format_unclosed_brace.sn
// A `{` that no `}` closes.
// Rust: expected `}`.
import std.fmt.fmt;

def main(): int {
    let name: string = "Sultan";
    match format("value: {", [fmt_arg.text(&name)]) with
    | result.ok(_) -> { return 0; }
    | result.err(_) -> { return 1; };
}
