// اختبار: رفض
// خروج: 1
// تشخيص: SULTANC-FORMAT-STRING
// نظير: tests/ar/stdlib/fmt/reject_format_invalid_count.sn
// A width taken from an argument needs an integer argument.
// Rust: expected usize.
import std.fmt.fmt;

def main(): int {
    let name: string = "Sultan";
    match format("{:1$}", [fmt_arg.int(1), fmt_arg.text(&name)]) with
    | result.ok(_) -> { return 0; }
    | result.err(_) -> { return 1; };
}
