// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/stdlib/error/convert_json.sn
// std.error.from_json: every variant of json_error_kind; the byte offset is a note.
import std.error.failure;
import std.error.from_json;
import std.json.value;
import std.json.parse;
import std.text.compare;

def has_identity(failure: &Error, kind: &string): bool {
    let its_domain: string = error_domain(failure);
    let its_kind: string = error_kind(failure);
    let domain: string = "std.json";
    return texts_equal(&its_domain, &domain) && texts_equal(&its_kind, kind);
}

def main(): int {
    let kinds: mutable vector json_error_kind = [];
    append(kinds, json_error_kind.unexpected_eof());
    append(kinds, json_error_kind.unexpected_token());
    append(kinds, json_error_kind.invalid_escape());
    append(kinds, json_error_kind.invalid_unicode_escape());
    append(kinds, json_error_kind.invalid_utf8());
    append(kinds, json_error_kind.invalid_number());
    append(kinds, json_error_kind.trailing_text());
    append(kinds, json_error_kind.object_capacity_overflow());
    append(kinds, json_error_kind.nesting_too_deep());
    let names: vector string = [
        "نهاية_غير_متوقعة", "رمز_غير_متوقع", "محرف_هروب_غير_صالح",
        "هروب_يونيكود_غير_صالح", "يوتيف8_غير_صالح", "رقم_غير_صالح",
        "نص_لاحق", "سعة_كائن_غير_قابلة_للتمثيل", "تعشيش_عميق_جدا"
    ];
    let i: mutable uint = 0;
    while (i < (length(kinds) as uint)) {
        let problem: json_error = { الصنف: kinds[i], الإزاحة: i };
        let failure: Error = error_from_json_error(&problem);
        if (!has_identity(&failure, &names[i])) { return 1; };
        let message: string = error_message(&failure);
        if ((length(message) as uint) == 0) { return 2; };
        let notes: vector string = error_notes(&failure);
        if ((length(notes) as uint) != 1) { return 3; };
        i := i + 1;
    }

    // A real parse failure: trailing text at byte 3.
    let text: string = "[1]x";
    match parse_json(&text) with
    | result.ok(_) -> { return 4; }
    | result.err(problem) -> {
        let failure: Error = error_from_json_error(&problem);
        let trailing: string = "نص_لاحق";
        if (!has_identity(&failure, &trailing)) { return 5; };
        let notes: vector string = error_notes(&failure);
        let expected: string = "إزاحة البايت: 3";
        if (!texts_equal(&notes[0], &expected)) { return 6; };
        let message: string = error_message(&failure);
        let expected_message: string = "نص زائد بعد قيمة JSON";
        if (!texts_equal(&message, &expected_message)) { return 7; };
    };
    return 42;
}
