// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
import std.collections.sort;

def main(): int {
    let values: mutable vector int = [9, 1, 7, 3, 5, 2, 8, 4, 6];
    sort_int(&mutable values);
    let i: mutable uint = 0;
    while (i < (length(values) as uint)) {
        if (values[i] != ((i + 1) as int)) { return 1; };
        i := i + 1;
    }
    return 42;
}
