// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/stdlib/behavior/math_trigonometry.sn
// std.math.trigonometry against libm values: sin and cos within 4e-16
// (relative) or 1e-15 (absolute, near a zero), tan within 1e-14, from
// small angles to 1.8e308 (Payne-Hanek reduction); float32 within 1e-6.
import std.math.trigonometry;
import std.math.float;

def close(a: f64, b: f64, relative: f64): bool {
    let difference: f64 = abs_f64(a - b);
    if (difference <= relative * abs_f64(b) || difference <= 1.0e-15) { return true; };
    return false;
}

def check(x: f64, s: f64, c: f64, t: f64): int {
    let failures: mutable int = 0;
    if (!close(sin_f64(x), s, 4.0e-16)) { failures := failures + 1; };
    if (!close(cos_f64(x), c, 4.0e-16)) { failures := failures + 1; };
    if (!close(tan_f64(x), t, 1.0e-14)) { failures := failures + 1; };
    return failures;
}

def close32(a: f32, b: f32): bool {
    let difference: f32 = abs_f32(a - b);
    if (difference <= 1.0e-6 * abs_f32(b) || difference <= 1.0e-7) { return true; };
    return false;
}

def check32(x: f32, s: f32, c: f32, t: f32): int {
    let failures: mutable int = 0;
    if (!close32(sin_f32(x), s)) { failures := failures + 1; };
    if (!close32(cos_f32(x), c)) { failures := failures + 1; };
    if (!close32(tan_f32(x), t)) { failures := failures + 1; };
    return failures;
}

def main(): int {
    let failures: mutable int = 0;
    failures := failures + check(0.5, 0.479425538604203, 0.8775825618903728, 0.5463024898437905);
    failures := failures + check(-1.0, -0.8414709848078965, 0.5403023058681398, -1.5574077246549023);
    failures := failures + check(2.0, 0.9092974268256817, -0.4161468365471424, -2.185039863261519);
    failures := failures + check(3.0, 0.1411200080598672, -0.9899924966004454, -0.1425465430742778);
    failures := failures + check(10.0, -0.5440211108893698, -0.8390715290764524, 0.6483608274590866);
    failures := failures + check(-1234.5678, -0.07803344920002027, -0.9969507414140119, 0.07827212113744211);
    failures := failures + check(100000.0, 0.03574879797201651, -0.9993608074382124, -0.035771662952898776);
    failures := failures + check(700000000.0, 0.8585809602540806, 0.5126780029308659, 1.6746982615711314);
    failures := failures + check(-3000000000.0, -0.9870048864743554, -0.16069024262768705, 6.14228263231394);
    failures := failures + check(10000000000.0, -0.4875060250875107, 0.873119622676856, -0.5583496378112418);
    failures := failures + check(2500000000000.0, -0.9973172784076171, -0.07320004227883768, 13.624545114449258);
    failures := failures + check(1000000000000000.0, 0.8582727931702359, -0.5131937377869703, -1.672414782127583);
    failures := failures + check(-9.87654321e+17, -0.2977380175440756, -0.9546476171388707, 0.31188263836703656);
    failures := failures + check(1e+22, -0.8522008497671888, 0.523214785395139, -1.6287782256068988);
    failures := failures + check(1.2345e+30, -0.9633253138962465, 0.2683362435577762, -3.5899932902236906);
    failures := failures + check(1e+100, -0.3806377310050287, 0.9247242387519338, -0.4116229628832498);
    failures := failures + check(-1e+200, 0.6439687185395058, 0.7650518214752429, 0.8417321552123704);
    failures := failures + check(1e+300, -0.8178819121159085, -0.5753861119575491, 1.4214488238747245);
    failures := failures + check(1.7976931348623157e+308, 0.004961954789184062, -0.9999876894265599, -0.004962015874444895);
    failures := failures + check(1e-05, 9.999999999833334e-06, 0.99999999995, 1.0000000000333334e-05);
    failures := failures + check(-4.762045, 0.9987673931611837, 0.04963561582184295, 20.121990563108117);
    failures := failures + check(5.977239, -0.30119567283813514, 0.9535623559388149, -0.31586363593558353);
    failures := failures + check(42.421058, -0.9999543305359336, 0.00955703104697364, -104.63022727676314);
    failures := failures + check(-3.434993, 0.28920892680890786, -0.9572660009913858, -0.30211971020530415);
    failures := failures + check(0.784127, 0.706207361878858, 0.7080050579113851, 0.9974608994491786);
    failures := failures + check(8.738483, 0.6336753230491361, -0.7735991112705424, -0.8191262293572202);
    failures := failures + check(-31.533966, -0.11776554149657796, 0.9930414277541586, -0.11859076389482966);
    failures := failures + check(1.190864, 0.9286897348270093, 0.3708576228513298, 2.504167846643682);
    failures := failures + check(-4.63435e+192, 0.8435196800776702, -0.5370982678445956, -1.570512754514663);
    failures := failures + check(1.97607e+37, -0.8614731438977458, 0.5078031334512755, -1.6964707130551913);
    failures := failures + check(-1.320041e+51, -0.01677210229927082, -0.9998593383993885, 0.01677446182192009);
    failures := failures + check(4.748831e+182, -0.8770130590180198, -0.4804665381812299, 1.8253363956164088);
    failures := failures + check(-6.022219e+289, 0.6953651196272365, 0.7186566290001082, 0.9675902114681972);
    failures := failures + check(-5.096253e+190, -0.9932019994713809, 0.11640355770358174, -8.53240243739406);
    failures := failures + check32(0.5, 0.4794255495071411, 0.8775825500488281, 0.5463024973869324);
    failures := failures + check32(-1.0, -0.8414709568023682, 0.5403022766113281, -1.5574077367782593);
    failures := failures + check32(2.0, 0.9092974066734314, -0.416146844625473, -2.185039758682251);
    failures := failures + check32(3.0, 0.14112000167369843, -0.9899924993515015, -0.14254654943943024);
    failures := failures + check32(10.0, -0.5440211296081543, -0.83907151222229, 0.6483608484268188);
    failures := failures + check32(-100.25, 0.27728286385536194, 0.9607883095741272, 0.28859931230545044);
    failures := failures + check32(1000.0, 0.8268795609474182, 0.5623790621757507, 1.470324158668518);
    failures := failures + check32(5000.0, -0.9879664182662964, 0.1546684056520462, -6.3876423835754395);
    if (!is_nan_f64(sin_f64(infinity_f64()))) { return 2; };
    if (!is_nan_f64(cos_f64(0.0 / 0.0))) { return 3; };
    if (sin_f64(0.0) != 0.0 || cos_f64(0.0) != 1.0 || tan_f64(0.0) != 0.0) { return 4; };
    if (failures != 0) { return 1; };
    return 42;
}
