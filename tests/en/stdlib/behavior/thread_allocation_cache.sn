// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/stdlib/behavior/thread_allocation_cache.sn
// Per-thread allocation caches (std.os.allocation_cache): a std thread
// counts its allocations and frees in its cache, so the main thread's
// counts do not move while it works, and its counts join the process total
// after join. Four threads build and drop small texts at once with no lock
// on the fast path; the heap is used again afterwards without corruption.
import std.os.allocation;
import std.os.allocation_cache;
import std.thread.thread;
import std.text.number;

def work(): void {
    let i: mutable int = 0;
    while (i < 20000) {
        let t: string = int_to_text(i * 7919);
        let v: mutable vector int = [];
        append(v, i);
        i := i + 1;
    }
    if (thread_allocation_count() < 20000) { let z: int = 1 / (i - i); };
}

def main(): int {
    let main_before: u64 = thread_allocation_count();
    let all_before: u64 = allocation_count();
    let handles: mutable vector join_handle = [];
    let k: mutable int = 0;
    while (k < 4) {
        match spawn(work) with
        | result.err(_) -> { return 1; }
        | result.ok(h) -> { append(handles, h); };
        k := k + 1;
    }
    k := 0;
    while (k < 4) {
        join(&mutable handles[k as uint]);
        k := k + 1;
    }
    // The main thread allocates only its own bookkeeping: the handles
    // vector, and a few blocks per spawn for the thread's entry closure (and,
    // on macOS, the pthread_attr_t, pthread_t and thread-id cells std's
    // darwin threads.sn allocates at lines 50, 66 and 88). Measured
    // spawn+append counts, with joins counting 0: Linux 4, 3, 3, 3 = 13;
    // macOS 7, 6, 6, 6 = 25 (Apple M3). The limit, 36 = 4 * 8 + 4, allows
    // 8 per spawn and 4 for the vector. It does not remove macOS's extra 3
    // per spawn; it only stops assuming Linux's count. A worker's 20000+
    // allocations counted on the main thread still fail it.
    if (thread_allocation_count() - main_before > 36) { return 2; };
    if (allocation_count() - all_before < 80000) { return 3; };
    let t: string = int_to_text(123456789);
    if (length(t) != 9) { return 4; };
    return 0;
}
