// checked and saturating add, sub, mul and shifts for every integer width,
// against Rust's wrapping_*/checked_*/saturating_* at each type's bounds.
import std.math.wrapping;
import std.math.integer;

def expect_i8(value: option i8, expected: i8, present: bool): bool {
    match value with
    | option.some(x) -> { return present && x == expected; }
    | option.none -> { return !present; };
}
