// number of places or significant digits, against Python's decimal module.
import std.text.float;
import std.math.float;

def same(d: &float_digits, ds: string, pt: int): bool {
    if ((*d).النقطة != pt) { return false; };
    if (length((*d).الأرقام) != length(ds)) { return false; };
    let i: mutable uint = 0;
    while (i < (length(ds) as uint)) { if ((*d).الأرقام[i] + 48 != ds[i]) { return false; }; i := i + 1; }
    return true;
}
def c64(bits: u64, ds: string, pt: int): int {
    let d: float_digits = f64_shortest_digits(f64_from_bits(bits));
    if (same(&d, ds, pt)) { return 0; };
    return 1;
}
def c32(bits: u32, ds: string, pt: int): int {
    let d: float_digits = f32_shortest_digits(f32_from_bits(bits));
    if (same(&d, ds, pt)) { return 0; };
    return 1;
}
def cf(bits: u64, n: uint, ds: string, pt: int): int {
    let d: float_digits = f64_fixed_digits(f64_from_bits(bits), n);
    if (length(ds) == 0 && length(d.الأرقام) == 0) { return 0; };
    if (same(&d, ds, pt)) { return 0; };
    return 1;
}
def cs(bits: u64, n: uint, ds: string, pt: int): int {
    let d: float_digits = f64_significant_digits(f64_from_bits(bits), n);
    if (same(&d, ds, pt)) { return 0; };
    return 1;
}
