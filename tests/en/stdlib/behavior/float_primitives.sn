// The float primitives behind std.math (sqrt, floor, ceil, trunc,
// round_ties_even, abs, copysign, min, max, mul_add, f64 and f32): exact
// IEEE results as bit patterns, computed with Python's exact rationals and
// NumPy; sqrt also against std's former Newton iteration on the edge cases
// (zeros, subnormals, infinities, perfect squares). Native, LLVM and the
// interpreter give the same bits. Generated.
import std.math.float;

// The software square root std.math used before the float primitives
// (Newton iteration from a scaled start); it agrees on the edge cases.
def sqrt_newton_f64(value: f64): f64 {
    if (is_nan_f64(value)) { return value; };
    if (value < 0.0) { let zero: f64 = 0.0; return zero / zero; };
    if ((value == 0.0) || is_infinite_f64(value)) { return value; };
    let scaled: mutable f64 = value;
    let scale: mutable f64 = 1.0;
    while (scaled >= 4.0) { scaled := scaled / 4.0; scale := scale * 2.0; }
    while (scaled < 1.0) { scaled := scaled * 4.0; scale := scale / 2.0; }
    let start: f64 = scaled + 1.0;
    let guess: mutable f64 = start / 2.0;
    let step: mutable uint = 0;
    while (step < 10) {
        let ratio: f64 = scaled / guess;
        let sum: f64 = guess + ratio;
        guess := sum / 2.0;
        step := step + 1;
    }
    return guess * scale;
}

