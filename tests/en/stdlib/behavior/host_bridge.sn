// اختبار: تفاضلي
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/stdlib/behavior/host_bridge.sn
// The std paths that meet host memory, run the same natively and
// interpreted: a failing open reports not-found (errno / the last-error
// code), the working directory, the environment list (the Windows
// environment block), a directory listing (Darwin readdir's dirent),
// localhost resolution (getaddrinfo / GetAddrInfoW's list), and the system
// trust roots (the Windows CERT_CONTEXT list), whose outcome is printed.
import std.fs.handle;
import std.fs.error;
import std.fs.temporary;
import std.fs.directory;
import std.fs.write_file;
import std.fs.mutation;
import std.fs.path;
import std.fs.canonical;
import std.env.environment;
import std.env.variables;
import std.net.dns;
import std.net.socket_address;
import std.tls.trust;
import std.text.compare;
import std.io.println;

def main(): int {
    let missing: string = "sultanc-host-bridge-missing-file.txt";
    match open_file_handle_read(&missing) with
    | result.ok(_) -> { return 1; }
    | result.err(code) -> { if (!is_not_found_error(code)) { return 2; }; };

    match current_directory() with
    | result.err(_) -> { return 3; }
    | result.ok(directory) -> { if (length(directory) == 0) { return 4; }; };

    match environment_variables() with
    | result.err(_) -> { return 5; }
    | result.ok(variables) -> { if (length(variables) == 0) { return 6; }; };

    let prefix: string = "sultanc-bridge-";
    let directory: mutable string = "";
    match create_temp_dir(&prefix) with
    | result.err(_) -> { return 7; }
    | result.ok(made) -> { directory := made; };
    let first_name: string = "alpha.txt";
    let second_name: string = "beta.txt";
    let first: string = join_for(&directory, &first_name, host_path_flavor());
    let second: string = join_for(&directory, &second_name, host_path_flavor());
    let content: string = "x";
    match write_file(&first, &content) with
    | result.err(_) -> { return 8; }
    | result.ok(_) -> {};
    match write_file(&second, &content) with
    | result.err(_) -> { return 9; }
    | result.ok(_) -> {};
    match list_directory(&directory) with
    | result.err(_) -> { return 10; }
    | result.ok(entries) -> {
        if (length(entries) != 2) { return 11; };
        let seen_first: mutable bool = false;
        let seen_second: mutable bool = false;
        let i: mutable uint = 0;
        while (i < (length(entries) as uint)) {
            if (texts_equal(&entries[i].الاسم, &first_name)) { seen_first := true; };
            if (texts_equal(&entries[i].الاسم, &second_name)) { seen_second := true; };
            i := i + 1;
        }
        if (!seen_first || !seen_second) { return 12; };
    };
    match remove_file(&first) with
    | result.err(_) -> { return 13; }
    | result.ok(_) -> {};
    match remove_file(&second) with
    | result.err(_) -> { return 14; }
    | result.ok(_) -> {};
    match remove_directory(&directory) with
    | result.err(_) -> { return 15; }
    | result.ok(_) -> {};

    let localhost: string = "localhost";
    match resolve_host_ipv4(&localhost, 80) with
    | result.err(_) -> { return 16; }
    | result.ok(address) -> {
        let text: string = socket_addr_ip_text(&address);
        let loopback: string = "127.0.0.1";
        if (!texts_equal(&text, &loopback)) { return 17; };
    };

    match tls_system_roots() with
    | result.err(_) -> { println("roots: unavailable"); }
    | result.ok(roots) -> {
        if (length(roots) > 0) { println("roots: some"); } else { println("roots: none"); };
    };
    return 42;
}
