// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 42
// نظير: tests/ar/compiler/tooling/completion.sn
// Completion at the cursor (compiler/frontend/tooling_completion.sn) on lines
// that do not parse yet: members of a record value (English and Arabic
// sources), an import path through Arabic spellings, the names in scope with
// their distance, the constructors of an enum, and nothing inside a string;
// then (C1 to C9) the members of a call's result, of a dereference and of an
// element, the builtin option constructors, the Types of a Type position, the
// fields a record literal has not written, the cases a match has not covered
// and the call arguments whose Type fits the parameter; then (C10, C11)
// what a constructor inserts: a call in a value position (`Red()`,
// `Circle(`), its name in a pattern position, with its payload count; then
// (C12) the fields after `name.` whatever follows the cursor on its line
// (`;`, ` ;`, `);`, `with`, nothing), the fields whose Type fits what the
// place expects (a `return`, a `let` with a Type, a call argument) first.
// Each source is patched (رقع_مصدر_للإكمال), the patched text is analysed as
// the file, and the candidates are read from the analysis or the environment.
import compiler.driver.source_inputs;
import compiler.frontend.semantic_pipeline;
import compiler.frontend.tooling_completion;
import compiler.frontend.cancellation;
import compiler.frontend.module_loading.logical_environment;
import compiler.backend.target.target_model;
import compiler.backend.target.target_registry;
import std.text.search;
import std.text.compare;
import std.fs.temporary;
import std.fs.write_file;
import std.fs.path;
import std.text.from_bytes;

def host(): اختياري واصف_هدف {
    match حل_هدف_المضيف_المسجل() with
    | نتيجة_حل_هدف.غير_مسجل -> { return اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(target) -> { return اختياري.موجود(target); };
}

def build(path: string): اختياري نتيجة_واجهة_وحدة {
    let extras: vector string = [];
    match ابن_إعداد_تجميع_مباشر(&path, &extras) with
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { return اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: env, المفتاح_الجذري: key, المفاتيح_المباشرة: _ }) -> {
        let request: طلب_واجهة_وحدة = { البيئة: env, المفتاح_الجذري: key, احتفظ_بحقائق_الأدوات: true };
        let more: vector مفتاح_وحدة_مقنن = [];
        let cancel: mutable حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        match ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(request, host(), &more, &mutable cancel) with
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(frontend) -> { return اختياري.موجود(frontend); }
        | _ -> { return اختياري.لا_شيء(); };
    };
}

// The byte right after the first `needle`.
def cursor_after(text: &string, needle: string): uint {
    match ابحث_نصا_من(text, &needle, 0) with
    | اختياري.موجود(at) -> { return at + (length(needle) as uint); }
    | اختياري.لا_شيء -> { return 0; };
}

// The source of the analysis whose name ends with `name`.
def source_named(frontend: &نتيجة_واجهة_وحدة, name: &string): اختياري uint {
    let i: mutable uint = 0;
    while (i < 100000) {
        match اسم_مصدر_واجهة_بمعرف(frontend, i) with
        | اختياري.لا_شيء -> { return اختياري.لا_شيء(); }
        | اختياري.موجود(found) -> {
            if (ينتهي_بـ(&found, name)) { return اختياري.موجود(i); };
        };
        i := i + 1;
    }
    return اختياري.لا_شيء();
}

// Writes the patched text as the file `name` and completes in its analysis.
def complete(dir: &string, name: string, patch: &رقعة_إكمال): اختياري نتيجة_إكمال_أدوات {
    let file: string = join(dir, &name);
    match write_file(&file, &(*patch).النص) with
    | result.err(_) -> { return اختياري.لا_شيء(); }
    | result.ok(_) -> { };
    match build(file) with
    | اختياري.لا_شيء -> { return اختياري.لا_شيء(); }
    | اختياري.موجود(frontend) -> {
        match source_named(&frontend, &name) with
        | اختياري.لا_شيء -> { return اختياري.لا_شيء(); }
        | اختياري.موجود(source) -> {
            return اختياري.موجود(إكمال_عند_رقعة_واجهة(&frontend, source, patch));
        };
    };
}

def position_of(found: &نتيجة_إكمال_أدوات, name: string): uint {
    let i: mutable uint = 0;
    while (i < (length((*found).المرشحات) as uint)) {
        if (نصان_متساويان(&(*found).المرشحات[i].الاسم, &name)) { return i; };
        i := i + 1;
    }
    return 1000000;
}

def distance_of(found: &نتيجة_إكمال_أدوات, name: string): uint {
    let at: uint = position_of(found, name);
    if (at >= (length((*found).المرشحات) as uint)) { return 1000000; };
    return (*found).المرشحات[at].البعد;
}

def append_text(bytes: &mutable vector u8, text: &string): void {
    let i: mutable uint = 0;
    while (i < (length(*text) as uint)) { append(*bytes, (*text)[i]); i := i + 1; }
}

// The program of C1 to C9, with `line` as main's unfinished last statement.
def program(line: string): string {
    let prelude: string = «type Inner = { depth: int, label: string };
type Outer = { inner: Inner, count: int };
type Color = | Red | Green;
def make(): Outer {
    let i: Inner = { depth: 1, label: "a" };
    return { inner: i, count: 2 };
}
def area(width: int, height: int): int { return width * height; }
def main(): int {
    let outer_value: Outer = make();
    let r: &Outer = &outer_value;
    let arr: vector Outer = [make()];
    let c: Color = Color.Red();
    let top: int = 2;
    »;
    let tail: string = «
}
»;
    let bytes: mutable vector u8 = [];
    append_text(&mutable bytes, &prelude);
    append_text(&mutable bytes, &line);
    append_text(&mutable bytes, &tail);
    return from_bytes(&bytes);
}

// The candidate `name` is a constructor with `payloads` payloads that
// inserts `text`, offered in a pattern position or not.
def inserts(found: &نتيجة_إكمال_أدوات, name: string, payloads: uint, text: string, pattern: bool): bool {
    let at: uint = position_of(found, name);
    if (at >= (length((*found).المرشحات) as uint)) { return false; };
    match (*found).المرشحات[at].عدد_الحمولات with
    | اختياري.موجود(count) -> { if (count != payloads) { return false; }; }
    | اختياري.لا_شيء -> { return false; };
    if (!نصان_متساويان(&(*found).المرشحات[at].نص_الإدراج, &text)) { return false; };
    if (pattern) { return (*found).المرشحات[at].في_نمط; };
    return !(*found).المرشحات[at].في_نمط;
}

// Exactly two candidates, `first` then `second`.
def two(found: &نتيجة_إكمال_أدوات, first: string, second: string): bool {
    return (length((*found).المرشحات) as uint) == 2
        && position_of(found, first) == 0 && position_of(found, second) == 1;
}

// The program of C12: a record Name whose two fields have the Type `field`,
// foo taking a `field`, and get_name returning `returns`, whose body is the
// unfinished statement `line`.
def member_program(field: &string, returns: &string, line: &string): string {
    let bytes: mutable vector u8 = [];
    append_text(&mutable bytes, &"type Name = { ahmad: ");
    append_text(&mutable bytes, field);
    append_text(&mutable bytes, &", Ali: ");
    append_text(&mutable bytes, field);
    append_text(&mutable bytes, &" };\ndef foo(s: ");
    append_text(&mutable bytes, field);
    append_text(&mutable bytes, &"): int { return 0; }\ndef get_name(name: Name): ");
    append_text(&mutable bytes, returns);
    append_text(&mutable bytes, &" {\n    ");
    append_text(&mutable bytes, line);
    append_text(&mutable bytes, &"\n}\n");
    return from_bytes(&bytes);
}

// C12: completing `line` at the byte after `needle` offers Name's two
// fields in declaration order, whatever follows the cursor; `expected` says
// whether the place expects a Type, `fits` whether the fields' Type fits it.
def member_row(
    dir: &string, file: string, field: string, returns: string, line: string, needle: string,
    expected: bool, fits: bool
): bool {
    let text: string = member_program(&field, &returns, &line);
    let patch: رقعة_إكمال = رقع_مصدر_للإكمال(&text, cursor_after(&text, needle));
    if (patch.السياق != سياق_إكمال.عضو_قيمة()) { return false; };
    match complete(dir, file, &patch) with
    | اختياري.لا_شيء -> { return false; }
    | اختياري.موجود(found) -> {
        if (found.السياق != سياق_إكمال.عضو_قيمة() || !two(&found, "ahmad", "Ali")) { return false; };
        match found.النوع_المتوقع with
        | اختياري.موجود(_) -> { if (!expected) { return false; }; }
        | اختياري.لا_شيء -> { if (expected) { return false; }; };
        return (found.المرشحات[0].يلائم_المتوقع == fits) && (found.المرشحات[1].يلائم_المتوقع == fits);
    };
}

def main(): int {
    let prefix: string = "completion";
    match create_temp_dir(&prefix) with
    | result.err(_) -> { return 1; }
    | result.ok(dir) -> {
        // T1: a record value, the line unfinished.
        let t1: string = «type Point = { x: int, y: int };
def main(): int {
    let p: Point = { x: 1, y: 2 };
    return p.
}
»;
        let p1: رقعة_إكمال = رقع_مصدر_للإكمال(&t1, cursor_after(&t1, "return p."));
        if (p1.السياق != سياق_إكمال.عضو_قيمة()) { return 2; };
        match complete(&dir, "t1.sn", &p1) with
        | اختياري.لا_شيء -> { return 3; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.عضو_قيمة()) { return 4; };
            if ((length(found.المرشحات) as uint) != 2) { return 5; };
            if (position_of(&found, "x") != 0 || position_of(&found, "y") != 1) { return 6; };
        };
        // T2: the same in an Arabic source.
        let t2: string = «نوع نقطة = { س: عدد, ص: عدد };
عرف الرئيسية(): عدد {
    ليكن ن: نقطة = { س: 1, ص: 2 };
    أرجع ن.
}
»;
        let p2: رقعة_إكمال = رقع_مصدر_للإكمال(&t2, cursor_after(&t2, "أرجع ن."));
        match complete(&dir, "t2.sn", &p2) with
        | اختياري.لا_شيء -> { return 7; }
        | اختياري.موجود(found) -> {
            if ((length(found.المرشحات) as uint) != 2) { return 8; };
            if (position_of(&found, "س") != 0 || position_of(&found, "ص") != 1) { return 9; };
        };
        // T3: an import path through std's Arabic spellings.
        let t3: string = «استورد المكتبة.دخ.
»;
        let p3: رقعة_إكمال = رقع_مصدر_للإكمال(&t3, cursor_after(&t3, "دخ."));
        if (p3.السياق != سياق_إكمال.مسار_استيراد()) { return 10; };
        let t3_name: string = "t3.sn";
        let t3_file: string = join(&dir, &t3_name);
        match write_file(&t3_file, &p3.النص) with
        | result.err(_) -> { return 11; }
        | result.ok(_) -> { };
        let extras: vector string = [];
        match ابن_إعداد_تجميع_مباشر(&t3_file, &extras) with
        | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { return 12; }
        | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: env, المفتاح_الجذري: _, المفاتيح_المباشرة: _ }) -> {
            let found: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&env, &p3);
            if (position_of(&found, "println") >= 1000000) { return 13; };
            if (position_of(&found, "print") >= 1000000) { return 14; };
            if (position_of(&found, "read_line") >= 1000000) { return 15; };
            if (position_of(&found, "buffered_writer") >= 1000000) { return 16; };
            if (distance_of(&found, "println") != 4) { return 17; };
            // `import std.`: a spelling carries its language and module.
            let t3b: string = «import std.
»;
            let p3b: رقعة_إكمال = رقع_مصدر_للإكمال(&t3b, cursor_after(&t3b, "std."));
            let roots: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&env, &p3b);
            let at: uint = position_of(&roots, "دخ");
            if (at >= 1000000 || position_of(&roots, "io") >= 1000000) { return 28; };
            match roots.المرشحات[at].الأصلي with
            | اختياري.موجود(canonical) -> { if (!نصان_متساويان(&canonical, &"io")) { return 29; }; }
            | اختياري.لا_شيء -> { return 29; };
            match roots.المرشحات[at].اللغة with
            | اختياري.موجود(language) -> { if (!نصان_متساويان(&language, &"ar")) { return 30; }; }
            | اختياري.لا_شيء -> { return 30; };
            // `import std.text.`: a module text re-exports from core
            // (`module compare = core.text.compare { ar: مقارنة };`).
            let t3c: string = «import std.text.
»;
            let p3c: رقعة_إكمال = رقع_مصدر_للإكمال(&t3c, cursor_after(&t3c, "text."));
            let text_children: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&env, &p3c);
            if (position_of(&text_children, "compare") >= 1000000) { return 31; };
            if (position_of(&text_children, "مقارنة") >= 1000000) { return 32; };
            // `import std.json.`: the children of a folder std re-exports from
            // alloc (`module json = alloc.json`).
            let t3d: string = «import std.json.
»;
            let p3d: رقعة_إكمال = رقع_مصدر_للإكمال(&t3d, cursor_after(&t3d, "json."));
            let json_children: نتيجة_إكمال_أدوات = إكمال_مسار_بيئة(&env, &p3d);
            if (position_of(&json_children, "parse") >= 1000000) { return 33; };
        };
        // T4: the names in scope, the line unfinished.
        let t4: string = «def helper(a: int): int { return a; }
def main(): int {
    let total: int = 1;
    return he
}
»;
        let p4: رقعة_إكمال = رقع_مصدر_للإكمال(&t4, cursor_after(&t4, "return he"));
        if (p4.السياق != سياق_إكمال.اسم()) { return 18; };
        match complete(&dir, "t4.sn", &p4) with
        | اختياري.لا_شيء -> { return 19; }
        | اختياري.موجود(found) -> {
            if (distance_of(&found, "total") != 0) { return 20; };
            if (distance_of(&found, "helper") != 2) { return 21; };
            if (distance_of(&found, "main") != 2) { return 22; };
            // helper's parameter is not visible in main.
            if (position_of(&found, "a") < 1000000) { return 23; };
        };
        // T5: the constructors of an enum.
        let t5: string = «type Color = | Red | Green;
def main(): int { let c: Color = Color.»;
        let p5: رقعة_إكمال = رقع_مصدر_للإكمال(&t5, length(t5) as uint);
        match complete(&dir, "t5.sn", &p5) with
        | اختياري.لا_شيء -> { return 24; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.عضو_نوع()) { return 25; };
            if (position_of(&found, "Red") != 0 || position_of(&found, "Green") != 1) { return 26; };
        };
        // T6: inside a string nothing completes.
        let t6: string = "def main(): int { let s: string = \"p.";
        let p6: رقعة_إكمال = رقع_مصدر_للإكمال(&t6, length(t6) as uint);
        if (p6.السياق != سياق_إكمال.لا_شيء()) { return 27; };
        // C1: the members of a call's result, with their Types; main returns
        // int, so count, whose Type fits, comes first (as in C3 and C4).
        let c1: string = program("return make().");
        let q1: رقعة_إكمال = رقع_مصدر_للإكمال(&c1, cursor_after(&c1, "return make()."));
        if (q1.السياق != سياق_إكمال.عضو_قيمة() || !نصان_متساويان(&q1.التعبير, &"make()")) { return 50; };
        match complete(&dir, "c1.sn", &q1) with
        | اختياري.لا_شيء -> { return 51; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.عضو_قيمة()) { return 52; };
            if (!two(&found, "count", "inner") || !found.المرشحات[0].يلائم_المتوقع) { return 53; };
            match found.المرشحات[0].النوع with
            | اختياري.لا_شيء -> { return 54; }
            | اختياري.موجود(_) -> { };
        };
        // C2: a field of a call's result.
        let c2: string = program("return make().inner.");
        let q2: رقعة_إكمال = رقع_مصدر_للإكمال(&c2, cursor_after(&c2, "return make().inner."));
        if (!نصان_متساويان(&q2.التعبير, &"make().inner")) { return 55; };
        match complete(&dir, "c2.sn", &q2) with
        | اختياري.لا_شيء -> { return 56; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "depth", "label")) { return 57; };
        };
        // C3: through a dereference in brackets.
        let c3: string = program("return (*r).");
        let q3: رقعة_إكمال = رقع_مصدر_للإكمال(&c3, cursor_after(&c3, "return (*r)."));
        match complete(&dir, "c3.sn", &q3) with
        | اختياري.لا_شيء -> { return 58; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "count", "inner")) { return 59; };
        };
        // C4: an element of a vector.
        let c4: string = program("return arr[0].");
        let q4: رقعة_إكمال = رقع_مصدر_للإكمال(&c4, cursor_after(&c4, "return arr[0]."));
        match complete(&dir, "c4.sn", &q4) with
        | اختياري.لا_شيء -> { return 60; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "count", "inner")) { return 61; };
        };
        // C5: the builtin option constructors, spelled as the source's
        // keywords are: English here, Arabic in an Arabic source.
        let c5: string = program("let o: option int = option.");
        let q5: رقعة_إكمال = رقع_مصدر_للإكمال(&c5, cursor_after(&c5, "= option."));
        match complete(&dir, "c5.sn", &q5) with
        | اختياري.لا_شيء -> { return 62; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.عضو_نوع()) { return 63; };
            if (!two(&found, "some", "none")) { return 64; };
        };
        let c5_ar: string = «نوع نقطة = { س: عدد, ص: عدد };
عرف الرئيسية(): عدد {
    ليكن ق: اختياري عدد = اختياري.
}
»;
        let q5_ar: رقعة_إكمال = رقع_مصدر_للإكمال(&c5_ar, cursor_after(&c5_ar, "= اختياري."));
        match complete(&dir, "c5_ar.sn", &q5_ar) with
        | اختياري.لا_شيء -> { return 65; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "موجود", "لا_شيء")) { return 66; };
        };
        // C6: a Type position offers Types only: those in scope and the
        // builtin ones.
        let c6: string = program("let x: ");
        let q6: رقعة_إكمال = رقع_مصدر_للإكمال(&c6, cursor_after(&c6, "let x: "));
        if (q6.السياق != سياق_إكمال.موضع_نوع()) { return 67; };
        match complete(&dir, "c6.sn", &q6) with
        | اختياري.لا_شيء -> { return 68; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.موضع_نوع()) { return 69; };
            if (position_of(&found, "Inner") >= 1000000 || position_of(&found, "Outer") >= 1000000
                || position_of(&found, "Color") >= 1000000) { return 70; };
            if (distance_of(&found, "Inner") != 2) { return 71; };
            if (position_of(&found, "int") >= 1000000 || position_of(&found, "string") >= 1000000
                || position_of(&found, "bool") >= 1000000 || position_of(&found, "vector") >= 1000000
                || position_of(&found, "option") >= 1000000) { return 72; };
            if (position_of(&found, "outer_value") < 1000000 || position_of(&found, "top") < 1000000
                || position_of(&found, "make") < 1000000 || position_of(&found, "area") < 1000000
                || position_of(&found, "Red") < 1000000) { return 73; };
        };
        // C7: a record literal of a known Type offers the fields it has not
        // written.
        let c7: string = program("let o: Inner = {  };");
        let q7: رقعة_إكمال = رقع_مصدر_للإكمال(&c7, cursor_after(&c7, "let o: Inner = { "));
        if (q7.السياق != سياق_إكمال.حقل_سجل()) { return 74; };
        match complete(&dir, "c7.sn", &q7) with
        | اختياري.لا_شيء -> { return 75; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "depth", "label")) { return 76; };
            match found.النوع_المتوقع with
            | اختياري.لا_شيء -> { return 77; }
            | اختياري.موجود(_) -> { };
        };
        let c7b: string = program("let o: Inner = { depth: 5,  };");
        let q7b: رقعة_إكمال = رقع_مصدر_للإكمال(&c7b, cursor_after(&c7b, "depth: 5, "));
        match complete(&dir, "c7b.sn", &q7b) with
        | اختياري.لا_شيء -> { return 78; }
        | اختياري.موجود(found) -> {
            if ((length(found.المرشحات) as uint) != 1 || position_of(&found, "label") != 0) { return 79; };
        };
        // C8: a match on a known Type offers the cases no arm covers.
        let c8: string = program("match c with\n    | ");
        let q8: رقعة_إكمال = رقع_مصدر_للإكمال(&c8, cursor_after(&c8, "with\n    | "));
        if (q8.السياق != سياق_إكمال.حالة_مطابقة() || !نصان_متساويان(&q8.التعبير, &"c")) { return 80; };
        match complete(&dir, "c8.sn", &q8) with
        | اختياري.لا_شيء -> { return 81; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "Color.Red", "Color.Green")) { return 82; };
        };
        let c8b: string = program("match c with\n    | Color.Red -> { }\n    | ");
        let q8b: رقعة_إكمال = رقع_مصدر_للإكمال(&c8b, cursor_after(&c8b, "{ }\n    | "));
        match complete(&dir, "c8b.sn", &q8b) with
        | اختياري.لا_شيء -> { return 83; }
        | اختياري.موجود(found) -> {
            if ((length(found.المرشحات) as uint) != 1 || position_of(&found, "Color.Green") != 0) { return 84; };
        };
        // C9: a call argument ranks the names whose Type fits the parameter
        // (int) first.
        let c9: string = program("return area(");
        let q9: رقعة_إكمال = رقع_مصدر_للإكمال(&c9, cursor_after(&c9, "return area("));
        if (q9.السياق != سياق_إكمال.معامل_استدعاء() || q9.ترتيب_المعامل != 0) { return 85; };
        match complete(&dir, "c9.sn", &q9) with
        | اختياري.لا_شيء -> { return 86; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.معامل_استدعاء()) { return 87; };
            match found.النوع_المتوقع with
            | اختياري.لا_شيء -> { return 88; }
            | اختياري.موجود(_) -> { };
            if (position_of(&found, "top") != 0 || !found.المرشحات[0].يلائم_المتوقع) { return 89; };
            let at: uint = position_of(&found, "outer_value");
            if (at >= 1000000 || found.المرشحات[at].يلائم_المتوقع) { return 90; };
        };
        let c9b: string = program("return area(top, ");
        let q9b: رقعة_إكمال = رقع_مصدر_للإكمال(&c9b, cursor_after(&c9b, "area(top, "));
        if (q9b.ترتيب_المعامل != 1) { return 91; };
        match complete(&dir, "c9b.sn", &q9b) with
        | اختياري.لا_شيء -> { return 92; }
        | اختياري.موجود(found) -> {
            if (position_of(&found, "top") != 0 || !found.المرشحات[0].يلائم_المتوقع) { return 93; };
            let after: uint = position_of(&found, "outer_value");
            if (after >= 1000000 || found.المرشحات[after].يلائم_المتوقع) { return 94; };
        };
        // C10: in a value position a constructor is a call. The candidates
        // keep their names (T5) and carry their payload counts; one without
        // payloads inserts `Red()`, one with payloads `Circle(`.
        let c10: string = program("let k: Color = Color.");
        let q10: رقعة_إكمال = رقع_مصدر_للإكمال(&c10, cursor_after(&c10, "let k: Color = Color."));
        if (q10.في_نمط) { return 95; };
        match complete(&dir, "c10.sn", &q10) with
        | اختياري.لا_شيء -> { return 96; }
        | اختياري.موجود(found) -> {
            if (found.السياق != سياق_إكمال.عضو_نوع() || !two(&found, "Red", "Green")) { return 97; };
            if (!inserts(&found, "Red", 0, "Red()", false) || !inserts(&found, "Green", 0, "Green()", false)) { return 98; };
        };
        let c10b: string = «type Shape = | Circle of int | Empty;
def main(): int { let s: Shape = Shape.»;
        let q10b: رقعة_إكمال = رقع_مصدر_للإكمال(&c10b, length(c10b) as uint);
        match complete(&dir, "c10b.sn", &q10b) with
        | اختياري.لا_شيء -> { return 99; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "Circle", "Empty")) { return 100; };
            if (!inserts(&found, "Circle", 1, "Circle(", false) || !inserts(&found, "Empty", 0, "Empty()", false)) { return 101; };
        };
        // The builtin constructors too: `some(` and `none()`.
        let c10c: string = program("let o: option int = option.");
        let q10c: رقعة_إكمال = رقع_مصدر_للإكمال(&c10c, cursor_after(&c10c, "= option."));
        match complete(&dir, "c10c.sn", &q10c) with
        | اختياري.لا_شيء -> { return 102; }
        | اختياري.موجود(found) -> {
            if (!inserts(&found, "some", 1, "some(", false) || !inserts(&found, "none", 0, "none()", false)) { return 103; };
        };
        // C11: in a match arm's pattern a constructor is matched: it says so
        // and inserts its name only.
        let c11: string = program("match c with\n    | Color.");
        let q11: رقعة_إكمال = رقع_مصدر_للإكمال(&c11, cursor_after(&c11, "| Color."));
        if (!q11.في_نمط) { return 104; };
        match complete(&dir, "c11.sn", &q11) with
        | اختياري.لا_شيء -> { return 105; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "Red", "Green")) { return 106; };
            if (!inserts(&found, "Red", 0, "Red", true) || !inserts(&found, "Green", 0, "Green", true)) { return 107; };
        };
        // Inside an arm's body the position is a value's again.
        let c11b: string = program("match c with\n    | Color.Red -> { let k: Color = Color.");
        let q11b: رقعة_إكمال = رقع_مصدر_للإكمال(&c11b, cursor_after(&c11b, "let k: Color = Color."));
        if (q11b.في_نمط) { return 108; };
        // A match's cases (C8) are patterns: each inserts itself.
        let c11c: string = program("match c with\n    | ");
        let q11c: رقعة_إكمال = رقع_مصدر_للإكمال(&c11c, cursor_after(&c11c, "with\n    | "));
        match complete(&dir, "c11c.sn", &q11c) with
        | اختياري.لا_شيء -> { return 109; }
        | اختياري.موجود(found) -> {
            if (!inserts(&found, "Color.Red", 0, "Color.Red", true)) { return 110; };
        };
        // C12: after `name.` the fields are offered whatever follows the
        // cursor on its line (`with`, nothing, `;`, ` ;`, `);`). get_name
        // returns int: a `return` expects int, which string fields do not
        // fit; `let q: string` and foo's parameter expect string.
        if (!member_row(&dir, "c12a.sn", "string", "int", "match name. with", "match name.", false, false)) { return 111; };
        if (!member_row(&dir, "c12b.sn", "string", "int", "match name.ahma with", "name.ahma", false, false)) { return 112; };
        if (!member_row(&dir, "c12c.sn", "string", "int", "return name.ahmad", "name.ahmad", true, false)) { return 113; };
        if (!member_row(&dir, "c12d.sn", "string", "int", "return name.;", "return name.", true, false)) { return 114; };
        if (!member_row(&dir, "c12e.sn", "string", "int", "return name.ah;", "name.ah", true, false)) { return 115; };
        if (!member_row(&dir, "c12f.sn", "string", "int", "return name.ahmad ;", "name.ahmad", true, false)) { return 116; };
        if (!member_row(&dir, "c12g.sn", "string", "int", "let q: string = name.;", "= name.", true, true)) { return 117; };
        if (!member_row(&dir, "c12h.sn", "string", "int", "foo(name.);", "foo(name.", true, true)) { return 118; };
        // int fields, which every place of get_name (int) expects.
        if (!member_row(&dir, "c12i.sn", "int", "int", "return name.;", "return name.", true, true)) { return 119; };
        if (!member_row(&dir, "c12j.sn", "int", "int", "return name.ah;", "name.ah", true, true)) { return 120; };
        if (!member_row(&dir, "c12k.sn", "int", "int", "let q: int = name.;", "= name.", true, true)) { return 121; };
        if (!member_row(&dir, "c12l.sn", "int", "int", "foo(name.);", "foo(name.", true, true)) { return 122; };
        // A function returning string: its `return` expects string.
        if (!member_row(&dir, "c12m.sn", "string", "string", "return name.;", "return name.", true, true)) { return 123; };
        if (!member_row(&dir, "c12n.sn", "string", "string", "return name.ahmad ;", "name.ahmad", true, true)) { return 124; };
        // The fields whose Type fits come first.
        let c12o: string = "type Mixed = { count: int, title: string };\ndef label(m: Mixed): string {\n    return m.;\n}\n";
        let q12o: رقعة_إكمال = رقع_مصدر_للإكمال(&c12o, cursor_after(&c12o, "return m."));
        match complete(&dir, "c12o.sn", &q12o) with
        | اختياري.لا_شيء -> { return 125; }
        | اختياري.موجود(found) -> {
            if (!two(&found, "title", "count")) { return 126; };
            if (!found.المرشحات[0].يلائم_المتوقع || found.المرشحات[1].يلائم_المتوقع) { return 127; };
        };
    };
    return 42;
}
