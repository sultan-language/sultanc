// اختبار: تشغيل
// خروج: 42
// نظير: tests/ar/compiler/tooling/incremental_session.sn
// An incremental analysis session gives the result of a full analysis. The
// workspace (root.sn imports lib.sn, user.sn, other.sn, width.sn and std) is
// edited through an editor's unsaved texts; after each edit the session's
// result is compared with a full analysis of the same texts: every resolved
// occurrence (its declaration and Type), every diagnostic and every source's
// completeness (صف_واجهة_للمقارنة). The requests: one without edits (the
// final state the full analysis kept, as it is), a body edit (twice: each
// checks only lib.sn's bodies again, in that final state: early cutoff), a
// signature edit that breaks the callers (the kept states are built), the
// fix, an added std import, a new error, the fix, declaration edits of an
// open document (they reuse the kept workspace state), a body edit of it
// from the final state copied ahead, a cancelled request, and a target
// switch (width.sn declares by target).
import compiler.driver.source_inputs;
import compiler.frontend.semantic_pipeline;
import compiler.frontend.incremental_analysis;
import compiler.frontend.cancellation;
import compiler.frontend.module_loading.logical_environment;
import compiler.backend.target.target_model;
import compiler.backend.target.target_registry;
import std.text.search;
import std.text.substring;
import std.text.compare;
import std.text.transform;
import std.text.from_bytes;

def host(): اختياري واصف_هدف {
    match حل_هدف_المضيف_المسجل() with
    | نتيجة_حل_هدف.غير_مسجل -> { return اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(target) -> { return اختياري.موجود(target); };
}

// A registered target whose pointers are not as wide as the host's.
def other_target(): اختياري واصف_هدف {
    let width: mutable uint = 64;
    match host() with
    | اختياري.موجود(target) -> { width := target.نموذج_البيانات.عرض_المؤشر; }
    | اختياري.لا_شيء -> { };
    let all: vector واصف_هدف = الأهداف_المسجلة();
    let i: mutable uint = 0;
    while (i < (length(all) as uint)) {
        if (all[i].نموذج_البيانات.عرض_المؤشر != width) { return اختياري.موجود(استنسخ(&all[i])); }
        i := i + 1;
    }
    return اختياري.لا_شيء();
}

def path_of(name: string): string {
    let parts: vector string = ["tests/en/compiler/tooling/incremental_session/", name];
    let separator: string = "";
    return صل_النصوص(&parts, &separator);
}

def request(env: &بيئة_وحدات_منطقية, key: &مفتاح_وحدة_مقنن): طلب_واجهة_وحدة {
    let r: طلب_واجهة_وحدة = { البيئة: استنسخ(env), المفتاح_الجذري: استنسخ(key), احتفظ_بحقائق_الأدوات: true };
    return r;
}

def describe(result: &نتيجة_بناء_واجهة_قابلة_للإلغاء): vector string {
    match *result with
    | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(frontend) -> { return صف_واجهة_للمقارنة(&frontend); }
    | _ -> { let none: vector string = []; return none; };
}

def same(a: &vector string, b: &vector string): bool {
    if ((length(*a) as uint) == 0 || (length(*a) as uint) != (length(*b) as uint)) { return false; }
    let i: mutable uint = 0;
    while (i < (length(*a) as uint)) {
        if (!نصان_متساويان(&(*a)[i], &(*b)[i])) { return false; }
        i := i + 1;
    }
    return true;
}

// Whether any diagnostic line names the given text.
def mentions(lines: &vector string, text: string): bool {
    let i: mutable uint = 0;
    while (i < (length(*lines) as uint)) {
        match ابحث_نصا(&(*lines)[i], &text) with
        | اختياري.موجود(_) -> { return true; }
        | اختياري.لا_شيء -> { };
        i := i + 1;
    }
    return false;
}

// The path a source was loaded from, as its completeness line names it
// ("C <path> load=..."): an editor's text replaces the file at that path.
def loaded_path(lines: &vector string, name: string): string {
    let size: uint = length(name) as uint;
    let tail: string = صل_النصوص(&["/", name, " load="], &"");
    let i: mutable uint = 0;
    while (i < (length(*lines) as uint)) {
        let line: &string = &(*lines)[i];
        let head: string = "C ";
        if (يبدأ_بـ(line, &head)) {
            match ابحث_نصا(line, &tail) with
            | اختياري.موجود(at) -> {
                match مقطع_نص(line, 2, at + 1 + size - 2) with
                | اختياري.موجود(path) -> { return path; }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        }
        i := i + 1;
    }
    return "";
}

// The session's result for the current texts, compared with a full analysis.
def step(
    session: &mutable جلسة_تحليل_تزايدي, env: &بيئة_وحدات_منطقية, key: &مفتاح_وحدة_مقنن,
    target: اختياري واصف_هدف
): vector string {
    let more: vector مفتاح_وحدة_مقنن = [];
    let cancel: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
    let incremental: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_في_جلسة(session, request(env, key), استنسخ(&target), &more, &cancel);
    let full: نتيجة_بناء_واجهة_قابلة_للإلغاء =
        ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(request(env, key), target, &more, &cancel);
    let a: vector string = describe(&incremental);
    let b: vector string = describe(&full);
    if (!same(&a, &b)) { let none: vector string = []; return none; }
    return a;
}

def main(): int {
    let root: string = path_of("root.sn");
    // other.sn's key, for the editor's open documents.
    let extras: vector string = [path_of("other.sn")];
    match ابن_إعداد_تجميع_مباشر(&root, &extras) with
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { return 1; }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: env0, المفتاح_الجذري: key, المفاتيح_المباشرة: keys }) -> {
        let other_key: مفتاح_وحدة_مقنن = استنسخ(&keys[(length(keys) as uint) - 1]);
        let env: mutable بيئة_وحدات_منطقية = env0;
        let session: mutable جلسة_تحليل_تزايدي = جلسة_تحليل_تزايدي_جديدة();
        // A full analysis the first time, then the kept states are built.
        let first: vector string = step(&mutable session, &env, &key, host());
        if ((length(first) as uint) == 0) { return 2; }
        let lib: string = loaded_path(&first, "lib.sn");
        let user: string = loaded_path(&first, "user.sn");
        let other: string = loaded_path(&first, "other.sn");
        if ((length(lib) as uint) == 0 || (length(user) as uint) == 0 || (length(other) as uint) == 0) { return 22; }
        if (!إحصاء_جلسة_تحليل(&session).كاملة) { return 3; }
        // No edit: the kept final state as it is.
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 4; }
        if (!إحصاء_جلسة_تحليل(&session).قطع_مبكر || إحصاء_جلسة_تحليل(&session).المحللة != 0) { return 5; }
        // A body edit, twice.
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&lib),
            "public def scale(x: int): int { return x * 3; }\npublic def untouched(): int { return 1; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 6; }
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&lib),
            "public def scale(x: int): int { return x * 4; }\npublic def untouched(): int { return 1; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 7; }
        // No declaration changes: lib.sn alone, in the kept final state.
        if (إحصاء_جلسة_تحليل(&session).اللقطة != 3 || إحصاء_جلسة_تحليل(&session).المحللة != 1
            || !إحصاء_جلسة_تحليل(&session).قطع_مبكر) { return 8; }
        // A signature edit: the callers no longer type.
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&lib),
            "public def scale(x: int, y: int): int { return x * y; }\npublic def untouched(): int { return 1; }\n");
        let broken: vector string = step(&mutable session, &env, &key, host());
        if ((length(broken) as uint) == 0) { return 9; }
        if (!mentions(&broken, "user.sn")) { return 10; }
        if (!إحصاء_جلسة_تحليل(&session).بنيت_لقطة_الأساس || إحصاء_جلسة_تحليل(&session).قطع_مبكر) { return 29; }
        // The fix.
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&lib),
            "public def scale(x: int): int { return x * 2; }\npublic def untouched(): int { return 1; }\n");
        let fixed: vector string = step(&mutable session, &env, &key, host());
        if ((length(fixed) as uint) == 0) { return 11; }
        if (mentions(&fixed, "D ")) { return 12; }
        // An import change: a std module the kept states do not hold.
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&user),
            "import \"lib.sn\";\nimport std.text.search;\npublic def use_scale(): int { return scale(3) + untouched(); }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 13; }
        if (إحصاء_جلسة_تحليل(&session).المتغيرة != 1) { return 23; }
        // A new error, then its fix.
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&other),
            "public def other_value(): int { return not_declared_anywhere; }\n");
        let unknown: vector string = step(&mutable session, &env, &key, host());
        if ((length(unknown) as uint) == 0) { return 14; }
        if (!mentions(&unknown, "other.sn")) { return 15; }
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&other),
            "public def other_value(): int { return 4; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 16; }
        // other.sn is opened in the editor: the kept workspace state leaves it
        // out, so its declaration edits analyse only it and root.sn.
        let opened: vector مفتاح_وحدة_مقنن = [other_key];
        عيّن_مستندات_مفتوحة_جلسة(&mutable session, opened);
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&other),
            "public def other_value(): int { return 5; }\npublic def spare_one(): int { return 1; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 24; }
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&other),
            "public def other_value(): int { return 6; }\npublic def spare_two(): int { return 1; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 25; }
        if (إحصاء_جلسة_تحليل(&session).اللقطة != 2 || إحصاء_جلسة_تحليل(&session).المحللة != 2) { return 26; }
        // The kept final state is copied ahead (an editor's idle time); the
        // next edit, of other.sn's bodies, starts from that copy.
        جهز_جلسة_تحليل(&mutable session);
        ضع_تراكب_مصدر_في_البيئة(&mutable env, انسخ_نص(&other),
            "public def other_value(): int { return 7; }\npublic def spare_two(): int { return 1; }\n");
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 27; }
        if (!إحصاء_جلسة_تحليل(&session).جاهزة || إحصاء_جلسة_تحليل(&session).المحللة != 1
            || !إحصاء_جلسة_تحليل(&session).قطع_مبكر) { return 28; }
        // A cancelled request leaves the kept states; the next one reuses them.
        let more: vector مفتاح_وحدة_مقنن = [];
        let cancelled: حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        اطلب_إلغاء_واجهة(&cancelled);
        match ابن_واجهة_في_جلسة(&mutable session, request(&env, &key), host(), &more, &cancelled) with
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.ملغاة -> { }
        | _ -> { return 17; };
        if ((length(step(&mutable session, &env, &key, host())) as uint) == 0) { return 18; }
        if (إحصاء_جلسة_تحليل(&session).اللقطة == 0) { return 19; }
        // A target switch: everything is analysed again, for that target.
        match other_target() with
        | اختياري.موجود(target) -> {
            if ((length(step(&mutable session, &env, &key, اختياري.موجود(target))) as uint) == 0) { return 20; }
            if (!إحصاء_جلسة_تحليل(&session).كاملة) { return 21; }
        }
        | اختياري.لا_شيء -> { };
        return 42;
    };
}
