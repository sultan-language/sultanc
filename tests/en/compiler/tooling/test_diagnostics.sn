// اختبار: تشغيل
// خروج: 42
// نظير: tests/ar/compiler/tooling/test_diagnostics.sn
// A tooling request (احتفظ_بحقائق_الأدوات) reports the tests `sultanc test`
// would reject, by the same rules (compiler/test_mode/validation.sn), in
// تشخيصات_الأدوات at each test's name: parameters (line 4), a result
// that is neither nothing nor `result int, Error` (line 7), a type marked
// `@@test` (line 10). The valid tests (lines 13 and 16) have none. A
// compilation of the same file reports nothing: an ordinary build strips the
// annotation.
import compiler.driver.source_inputs;
import compiler.frontend.semantic_pipeline;
import compiler.frontend.cancellation;
import compiler.frontend.module_loading.logical_environment;
import compiler.diagnostics.identity;
import compiler.diagnostics.record;
import compiler.backend.target.target_model;
import compiler.backend.target.target_registry;

def host(): اختياري واصف_هدف {
    match حل_هدف_المضيف_المسجل() with
    | نتيجة_حل_هدف.غير_مسجل -> { return اختياري.لا_شيء(); }
    | نتيجة_حل_هدف.محلول(target) -> { return اختياري.موجود(target); };
}

type reported = { id: معرف_تشخيص, line: int };

// The identity of each diagnostic and the line its span starts on (0 without one).
def reported_of(diagnostics: &vector تشخيص): vector reported {
    let all: mutable vector reported = [];
    let i: mutable uint = 0;
    while (i < (length(*diagnostics) as uint)) {
        let line: mutable int = 0;
        match (*diagnostics)[i].المصدر_الرئيسي with
        | اختياري.موجود(where) -> {
            match where.بداية_العرض with
            | اختياري.موجود(start) -> { line := start.السطر as int; }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        let one: reported = { id: (*diagnostics)[i].المعرف, line: line };
        append(all, one);
        i := i + 1;
    }
    return all;
}

// The number of diagnostics with this identity whose span starts on line.
def count_at(diagnostics: &vector reported, identity: معرف_تشخيص, line: int): int {
    let found: mutable int = 0;
    let i: mutable uint = 0;
    while (i < (length(*diagnostics) as uint)) {
        if ((*diagnostics)[i].id == identity && (*diagnostics)[i].line == line) { found := found + 1; }
        i := i + 1;
    }
    return found;
}

def count_tests(diagnostics: &vector reported): int {
    let found: mutable int = 0;
    let i: mutable uint = 0;
    while (i < (length(*diagnostics) as uint)) {
        let id: معرف_تشخيص = (*diagnostics)[i].id;
        if (id == معرف_تشخيص.اختبار_بمعاملات() || id == معرف_تشخيص.ناتج_اختبار_غير_صالح()
            || id == معرف_تشخيص.اختبار_ليس_دالة_عادية()) {
            found := found + 1;
        }
        i := i + 1;
    }
    return found;
}

def analyse(tooling: bool): اختياري vector reported {
    let root: string = "tests/en/compiler/tooling/test_diagnostics/root.sn";
    let extras: vector string = [];
    match ابن_إعداد_تجميع_مباشر(&root, &extras) with
    | نتيجة_إعداد_تجميع_مباشر.غير_صالح -> { return اختياري.لا_شيء(); }
    | نتيجة_إعداد_تجميع_مباشر.جاهز({ البيئة: env, المفتاح_الجذري: key, المفاتيح_المباشرة: _ }) -> {
        let request: طلب_واجهة_وحدة = { البيئة: env, المفتاح_الجذري: key, احتفظ_بحقائق_الأدوات: tooling };
        let more: vector مفتاح_وحدة_مقنن = [];
        let cancel: mutable حالة_إلغاء_واجهة = حالة_إلغاء_واجهة_جديدة();
        match ابن_واجهة_وحدة_بهدف_قابلة_للإلغاء(request, host(), &more, &mutable cancel) with
        | نتيجة_بناء_واجهة_قابلة_للإلغاء.مكتملة(frontend) -> {
            return اختياري.موجود(reported_of(&frontend.تشخيصات_الأدوات.التشخيصات));
        }
        | _ -> { return اختياري.لا_شيء(); };
    };
}

def main(): int {
    match analyse(true) with
    | اختياري.لا_شيء -> { return 1; }
    | اختياري.موجود(diagnostics) -> {
        if (count_at(&diagnostics, معرف_تشخيص.اختبار_بمعاملات(), 4) != 1) { return 2; }
        if (count_at(&diagnostics, معرف_تشخيص.ناتج_اختبار_غير_صالح(), 7) != 1) { return 3; }
        if (count_at(&diagnostics, معرف_تشخيص.اختبار_ليس_دالة_عادية(), 10) != 1) { return 4; }
        if (count_tests(&diagnostics) != 3) { return 5; }
    };
    match analyse(false) with
    | اختياري.لا_شيء -> { return 6; }
    | اختياري.موجود(diagnostics) -> {
        if (count_tests(&diagnostics) != 0) { return 7; }
    };
    return 42;
}
