type Pair = { left: i32, right: i32 };

def mutate_copy(pair: Pair): Pair {
    let local: mutable Pair = pair;
    local.left := 100;
    return local;
}

def make_pair(left: i32, right: i32): Pair {
    let pair: Pair = { left: left, right: right };
    return pair;
}

def unrelated_call(): i32 {
    return 7;
}

def main(): i32 {
    let original: Pair = { left: 40, right: 2 };
    let changed: Pair = mutate_copy(original);
    if (changed.left != 100) {
        return 1;
    };
    if (original.left != 40) {
        return 2;
    };

    let retained: Pair = make_pair(40, 2);
    let ignored: i32 = unrelated_call();
    if (ignored != 7) {
        return 3;
    };
    return retained.left + retained.right;
}
