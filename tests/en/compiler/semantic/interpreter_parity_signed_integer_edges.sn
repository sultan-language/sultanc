// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
def main(): i64 {
    let a: i64 = -20;
    let b: i64 = -3;

    let sum: i64 = a + b;
    if (sum != -23) { return 1; };

    let difference: i64 = a - b;
    if (difference != -17) { return 2; };

    let product: i64 = b * 7;
    if (product != -21) { return 3; };

    let quotient: i64 = a / 3;
    if (quotient != -6) { return 4; };

    let remainder: i64 = a % 3;
    if (remainder != -2) { return 5; };

    let shifted: i64 = b << 2;
    if (shifted != -12) { return 6; };

    let restored: i64 = shifted >>> 2;
    if (restored != b) { return 7; };

    if (!(a < b)) { return 8; };
    return 42;
}
