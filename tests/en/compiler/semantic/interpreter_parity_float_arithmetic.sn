// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
def add64(a: f64, b: f64): f64 {
    return a + b;
}

def mul32(a: f32, b: f32): f32 {
    return a * b;
}

def main(): i32 {
    let a: f64 = 1.5;
    let b: f64 = 2.25;
    let c: f64 = add64(a, b);
    if (c != 3.75) { return 1; };
    if ((b - a) != 0.75) { return 2; };
    if ((a * 2.0) != 3.0) { return 3; };
    if ((b / 1.5) != 1.5) { return 4; };
    if (!(a < b)) { return 5; };
    if (!(b > a)) { return 6; };

    let x: f32 = 1.5;
    let y: f32 = 2.0;
    if (mul32(x, y) != 3.0) { return 7; };

    let zero: f64 = 0.0;
    let one: f64 = 1.0;
    let infinity: f64 = one / zero;
    let nan: f64 = zero / zero;
    if (!(infinity > one)) { return 8; };
    if (nan == nan) { return 9; };
    if (!(nan != nan)) { return 10; };
    return 42;
}
