    return context;
}

def empty_full_context(): حقائق_سياق_رسالة {
    let context_is_empty: حقائق_سياق_رسالة = {
        القيمة: option.none(),
        المتوقع: option.none(),
        الاستبدال: option.none(),
        الموجود: option.none(),
        الفهرس: option.none(),
        الطول: option.none(),
        المجال: option.none(),
        النمط: option.none(),
        المسار: option.none(),
        الرمز: option.none(),
        النوع: option.none(),
        السياق: option.none(),
        المرحلة: option.none(),
        الهدف: option.none(),
        الدالة: option.none(),
        الكتلة: option.none(),
        التعليمة: option.none(),
        العملية: option.none(),
        البدائي: option.none(),
        المصدر: option.none(),
        الوجهة: option.none(),
        السبب: option.none()
    };
    return context_is_empty;
}

def main(): int {
    let builder: mutable text_builder = new_text_builder_with_capacity(1024 as uint);
    let all_keys: vector مفتاح_رسالة_تشخيص = كل_مفاتيح_رسائل_التشخيص();
    let number_value: mutable uint = 0;
    let count: mutable uint = 0;
    while (number_value < (length(all_keys) as uint)) {
        let key: مفتاح_رسالة_تشخيص = all_keys[number_value];
        if (!check(&mutable builder, لغة_تشخيص.الإنجليزية(), key, full_context(), حقائق_رسالة.سياق_تشخيص(full_context()))) { return 1; };
        if (!check(&mutable builder, لغة_تشخيص.العربية(), key, full_context(), حقائق_رسالة.سياق_تشخيص(full_context()))) { return 2; };
        count := count + 1;
        number_value := number_value + 1;
    }
    if (count != (645 as uint)) { return 3; };
    let empty_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    if (!check(&mutable builder, لغة_تشخيص.الإنجليزية(), empty_key, empty_full_context(), حقائق_رسالة.سياق_تشخيص(empty_full_context()))) { return 4; };
    if (!check(&mutable builder, لغة_تشخيص.العربية(), empty_key, empty_full_context(), حقائق_رسالة.سياق_تشخيص(empty_full_context()))) { return 5; };
    return 0;
}
