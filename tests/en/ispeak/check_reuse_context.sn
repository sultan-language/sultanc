// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_reuse_context.sn
import compiler.diagnostics.identity;
import std.text.from_bytes;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;
import std.text.builder;
import std.text.compare;

// Every active identity with all 22 fields must yield byte-identical output
// through the allocation-sensitive sink and the owned-text API, EN and AR.
// Both inputs are built from the same facts: a context for the sink and the
// same context wrapped as a payload for the owned-text API.
def check(builder: &mutable text_builder, language: لغة_تشخيص, key: مفتاح_رسالة_تشخيص, context: حقائق_سياق_رسالة, payload: حقائق_رسالة): bool {
    text_builder_clear(builder);
    if (!ألحق_تشخيص_بسياق(builder, language, key, context)) { return false; };
    let appended: string = text_builder_text(builder);
    match رسالة_تشخيص_بحجج(language, key, payload) with
    | option.some(owned) -> { return texts_equal(&appended, &owned); }
    | option.none -> { return false; };
}

def full_context(): حقائق_سياق_رسالة {
    let fact_0: string = "FACT_00_UNIQUE_MARKER";
    let fact_1: string = "FACT_01_UNIQUE_MARKER";
    let fact_2: string = "FACT_02_UNIQUE_MARKER";
    let fact_3: string = "FACT_03_UNIQUE_MARKER";
    let fact_4: string = "FACT_04_UNIQUE_MARKER";
    let fact_5: string = "FACT_05_UNIQUE_MARKER";
    let fact_6: string = "FACT_06_UNIQUE_MARKER";
    let fact_7: string = "FACT_07_UNIQUE_MARKER";
    let fact_8: string = "FACT_08_UNIQUE_MARKER";
    let fact_9: string = "FACT_09_UNIQUE_MARKER";
    let fact_10: string = "FACT_10_UNIQUE_MARKER";
    let fact_11: string = "FACT_11_UNIQUE_MARKER";
