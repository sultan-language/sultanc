// Every source-backed specialized formatter must accept its typed facts in
// both languages. The input identity never depends on the rendered message.
def with_arguments(language: لغة_تشخيص, key: مفتاح_رسالة_تشخيص, facts: حقائق_رسالة): bool {
    let origin: string = رسالة_تشخيص(language, key);
    match رسالة_تشخيص_بحجج(language, key, facts) with
    | option.some(text) -> {
        if ((length(text) as uint) == 0) { return false; };
        return !texts_equal(&text, &origin);
    }
    | _ -> { return false; };
}

