// اختبار: تشغيل
// أهداف: x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_suggestion_roundtrip.sn
import std.text.compare;
import std.text.from_bytes;
import std.io.print;
import std.fs.temporary;
import std.fs.write_file;
import std.fs.walk;
import std.encoding.positions;
import compiler.driver.source_inputs;
