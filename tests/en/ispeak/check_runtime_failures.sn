// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_runtime_failures.sn
import std.text.compare;
import compiler.runtime.failure_identity;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;

def same_text(actual: string, expected: string): bool {
    return texts_equal(&actual, &expected);
}

// Exact runtime-failure wording in both languages.
def main(): int {
    if (!same_text(عنوان_فشل_تشغيل(لغة_تشخيص.الإنجليزية()), "runtime error")) { return 1; };
    if (!same_text(عنوان_فشل_تشغيل(لغة_تشخيص.العربية()), "خطأ وقت التشغيل")) { return 2; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.تجاوز_حدود()), "index out of bounds")) { return 3; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.تجاوز_حدود()), "الفهرس خارج الحدود")) { return 4; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), "argument out of range")) { return 5; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.وسيط_خارج_المدى()), "الوسيط خارج المدى المسموح")) { return 6; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), "invalid operation")) { return 7; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.عملية_غير_صالحة()), "عملية غير صالحة")) { return 8; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إدخال_إخراج()), "input/output failure")) { return 9; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إدخال_إخراج()), "فشل في الإدخال أو الإخراج")) { return 10; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.تجاوز_عدد_صحيح()), "integer overflow at {2}")) { return 11; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.تجاوز_عدد_صحيح()), "تجاوز العدد الصحيح حدود نوعه عند {2}")) { return 12; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.فهرس_خارج_المدى()), "index {0} out of range for length {1} at {2}")) { return 13; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.فهرس_خارج_المدى()), "الفهرس {0} خارج المدى للطول {1} عند {2}")) { return 14; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.قسمة_على_صفر()), "division by zero at {2}")) { return 15; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.قسمة_على_صفر()), "قسمة على صفر عند {2}")) { return 16; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إزاحة_خارج_المدى()), "shift by {0} out of range for a {1}-bit integer at {2}")) { return 17; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إزاحة_خارج_المدى()), "إزاحة بمقدار {0} خارج المدى لعدد صحيح من {1} بت عند {2}")) { return 18; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.فيض_المكدس()), "stack overflow: the call stack ran out of space")) { return 19; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.فيض_المكدس()), "فيض المكدس: نفدت مساحة مكدس الاستدعاءات")) { return 20; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.بداية_شريحة_خارج_المدى()), "slice start {0} out of range for length {1} at {2}")) { return 21; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.بداية_شريحة_خارج_المدى()), "بداية الشريحة {0} خارج المدى للطول {1} عند {2}")) { return 22; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.نهاية_شريحة_خارج_المدى()), "slice end {0} out of range for length {1} at {2}")) { return 23; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.نهاية_شريحة_خارج_المدى()), "نهاية الشريحة {0} خارج المدى للطول {1} عند {2}")) { return 24; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.شريحة_معكوسة()), "slice from {0} to {1} ends before it starts at {2}")) { return 25; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.شريحة_معكوسة()), "الشريحة من {0} إلى {1} تنتهي قبل أن تبدأ عند {2}")) { return 26; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.قسمة_خارج_المدى()), "split at {0} out of range for length {1} at {2}")) { return 27; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.قسمة_خارج_المدى()), "القسمة عند {0} خارج المدى للطول {1} عند {2}")) { return 28; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.الإنجليزية(), هوية_فشل_تشغيل.إزاحة_داخل_حرف()), "byte offset {0} is inside a character at {2}")) { return 29; };
    if (!same_text(نص_فشل_تشغيل(لغة_تشخيص.العربية(), هوية_فشل_تشغيل.إزاحة_داخل_حرف()), "إزاحة البايت {0} داخل حرف عند {2}")) { return 30; };
    return 0;
}
