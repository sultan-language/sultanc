import compiler.diagnostics.identity;
import compiler.diagnostics.reason;

// Frozen reason -> public identity policy (tests/check_reason_grouping.sn).
// Every one of the 481 reasons is listed: grouped reasons must name their
// identity; all others must leave the producer's identity unchanged.
def matches(reason: سبب_تشخيص, expected: معرف_تشخيص): bool {
    match تشخيص_عام_لسبب(reason) with
    | option.some(actual) -> { return actual == expected; }
    | option.none -> { return false; };
}

def unaggregated(reason: سبب_تشخيص): bool {
    match تشخيص_عام_لسبب(reason) with
    | option.none -> { return true; }
    | _ -> { return false; };
}

