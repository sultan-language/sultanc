// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_new_reasons.sn
import std.text.compare;
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;

// Current contextual-reason mappings must match their machine reason semantics.
def check_reason(reason: سبب_تشخيص, english: string, arabic: string): bool {
    let key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(reason);
    let actual_english: string = رسالة_تشخيص(لغة_تشخيص.الإنجليزية(), key);
    let actual_arabic: string = رسالة_تشخيص(لغة_تشخيص.العربية(), key);
    return texts_equal(&actual_english, &english) && texts_equal(&actual_arabic, &arabic);
}

def main(): int {
    // link.wasm.undefined-symbol, compiler/link/diagnostic_translation.sn:277
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_رمز_غير_معرف(), "WebAssembly link has an undefined symbol", "الربط بصيغة WebAssembly يحتوي رمزا غير معرف")) { return 1; };
    // link.wasm.symbol-type-mismatch, compiler/link/diagnostic_translation.sn:286
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_نوع_رمز_غير_متطابق(), "WebAssembly link has a symbol type mismatch", "نوع الرمز غير متطابق أثناء ربط WebAssembly")) { return 2; };
    // link.wasm.unsupported-relocation, compiler/link/diagnostic_translation.sn:295
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_إزاحة_غير_مدعومة(), "WebAssembly link does not support this relocation", "ربط WebAssembly لا يدعم نوع إعادة التوطين هذا")) { return 3; };
    // link.wasm.unsupported-feature, compiler/link/diagnostic_translation.sn:298
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_ميزة_غير_مدعومة(), "WebAssembly link does not support this feature", "ربط WebAssembly لا يدعم هذه الميزة")) { return 4; };
    // link.wasm.address-space-overflow, compiler/link/diagnostic_translation.sn:301
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_فيض_مساحة_العناوين(), "WebAssembly link exceeds its address space", "ربط WebAssembly يتجاوز مساحة العناوين المتاحة")) { return 5; };
    // link.wasm.non-pic-relocation, compiler/link/diagnostic_translation.sn:304
    if (!check_reason(سبب_تشخيص.سبب_ربط_واسم_إزاحة_غير_مستقلة_عن_الموضع(), "WebAssembly link contains a non-PIC relocation", "ربط WebAssembly يحتوي إعادة توطين غير مستقلة عن الموضع")) { return 6; };
    // object.wasm.unrepresentable-debug-relocation, compiler/backend/diagnostic_translation.sn:641
    if (!check_reason(سبب_تشخيص.سبب_كائن_واسم_إزاحة_تنقيح_غير_قابلة_للتمثيل(), "WebAssembly debug relocation cannot be represented", "تعذر تمثيل إعادة توطين بيانات التنقيح في WebAssembly")) { return 7; };
    // object.wasm.unrepresentable-pic-address, compiler/backend/diagnostic_translation.sn:642
    if (!check_reason(سبب_تشخيص.سبب_كائن_واسم_عنوان_مستقل_غير_قابل_للتمثيل(), "WebAssembly PIC address cannot be represented", "تعذر تمثيل عنوان مستقل عن الموضع في WebAssembly")) { return 8; };
    // native.backend-not-included, compiler/backend/diagnostic_translation.sn:846
    if (!check_reason(سبب_تشخيص.سبب_خلفية_أصلية_غير_مضمنة(), "Native backend is not included in this compiler", "الخلفية الأصلية غير مضمنة في هذا المترجم")) { return 9; };
    // llvm.backend-not-included, compiler/backend/diagnostic_translation.sn:847
    if (!check_reason(سبب_تشخيص.سبب_خلفية_إل_إل_في_إم_غير_مضمنة(), "LLVM backend is not included in this compiler", "خلفية LLVM غير مضمنة في هذا المترجم")) { return 10; };
    // comptime.instruction-budget-exhausted, compiler/interpreter/diagnostic_translation.sn:234
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_نفاد_ميزانية_التعليمات(), "Compile-time instruction budget was exhausted", "نفدت ميزانية التعليمات المسموحة وقت الترجمة")) { return 11; };
    // comptime.prohibited-effect, compiler/interpreter/diagnostic_translation.sn:237
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_أثر_ممنوع(), "Compile-time evaluation attempted a prohibited effect", "حاول التقييم وقت الترجمة تنفيذ أثر محظور")) { return 12; };
    // comptime.argument-not-constant, compiler/interpreter/diagnostic_translation.sn:240
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_ثابتة(), "Compile-time argument is not constant", "إحدى الحجج غير ثابتة وقت الترجمة")) { return 13; };
    // comptime.result-escapes-evaluator, compiler/interpreter/diagnostic_translation.sn:243
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_نتيجة_تهرب_من_المقيم(), "Compile-time result escapes its evaluator", "نتيجة وقت الترجمة تتجاوز نطاق المقيم")) { return 14; };
    // comptime.call-depth-exceeded, compiler/interpreter/diagnostic_translation.sn:246
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_عمق_الاستدعاء(), "Compile-time call depth limit was exceeded", "تجاوز التقييم وقت الترجمة حد عمق الاستدعاءات")) { return 15; };
    // comptime.compile-error, compiler/interpreter/diagnostic_translation.sn:249
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_فشل_مطلوب(), "Compile-time code explicitly requested an error", "طلبت الشفرة المنفذة وقت الترجمة خطأ صريحا")) { return 16; };
    // msir.switch-selector-not-integer, compiler/msir/diagnostic_translation.sn:192
    if (!check_reason(سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح(), "MSIR switch selector is not an integer", "مميز الفرع المتعدد في MSIR ليس عددا صحيحا")) { return 17; };
    // msir.duplicate-switch-case, compiler/msir/diagnostic_translation.sn:198
    if (!check_reason(سبب_تشخيص.سبب_مسير_وسم_حالة_مكرر(), "MSIR switch contains duplicate case tags", "الفرع المتعدد في MSIR يحتوي أوسمة حالات مكررة")) { return 18; };
    // comptime.argument-count-mismatch, compiler/driver/compile_time.sn:985
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_عدد_حجج_غير_مطابق(), "The call passes a different number of arguments than the function's compile-time parameters", "عدد الحجج في النداء لا يطابق معاملات وقت الترجمة في الدالة")) { return 19; };
    // comptime.argument-not-closed, compiler/driver/compile_time.sn:204
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_حجة_غير_مغلقة(), "A compile-time argument is not a closed constant value", "إحدى حجج وقت الترجمة ليست قيمة ثابتة مستقلة عن وقت التشغيل")) { return 20; };
    // comptime.call-depth-exhausted, compiler/driver/compile_time.sn:202
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_نفاد_عمق_الاستدعاء(), "Compile-time evaluation reached the maximum call depth", "بلغ التقييم وقت الترجمة الحد الأقصى لعمق الاستدعاءات")) { return 21; };
    // comptime.execution-failed, compiler/driver/compile_time.sn:206
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_فشل_التنفيذ(), "Compile-time evaluation failed while running the code", "فشل تنفيذ الشفرة أثناء التقييم وقت الترجمة")) { return 22; };
    // comptime.execution-trapped, compiler/driver/compile_time.sn:208
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_فخ_التنفيذ(), "The code trapped during compile-time evaluation", "توقف تنفيذ الشفرة بفخ أثناء التقييم وقت الترجمة")) { return 23; };
    // comptime.interpreter-failure, compiler/driver/compile_time.sn:209
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_خلل_المفسر(), "The interpreter failed internally during compile-time evaluation", "حدث خلل داخلي في المفسر أثناء التقييم وقت الترجمة")) { return 24; };
    // comptime.invalid-msir, compiler/driver/compile_time.sn:265
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_مسير_غير_صالح(), "The MSIR prepared for compile-time evaluation failed verification", "فشل التحقق من MSIR المعد للتقييم وقت الترجمة")) { return 25; };
    // comptime.layout-not-fixed, compiler/driver/compile_time.sn:1126
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_مثبت(), "The type's size or alignment is not fixed yet at compile time", "حجم النوع أو محاذاته لم يثبت بعد وقت الترجمة")) { return 26; };
    // comptime.layout-unavailable, compiler/driver/compile_time.sn:1129
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_تخطيط_غير_متاح(), "The type's layout is not available for the selected target", "تخطيط النوع غير متاح للهدف المحدد")) { return 27; };
    // comptime.missing-result, compiler/driver/compile_time.sn:254
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_مفقود(), "Compile-time evaluation finished without producing a value", "انتهى التقييم وقت الترجمة دون أن ينتج قيمة")) { return 28; };
    // comptime.nonconstant-argument, compiler/driver/compile_time.sn:231
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_حجة_نداء_غير_معروفة(), "A call argument is not known at compile time", "إحدى حجج النداء غير معروفة وقت الترجمة")) { return 29; };
    // comptime.nonconstant-or-prohibited-effect, compiler/driver/compile_time.sn:636
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_قيمة_غير_ثابتة_أو_أثر_ممنوع(), "A value depends on runtime data or on an effect that is not allowed at compile time", "إحدى القيم تعتمد على بيانات وقت التشغيل أو على أثر غير مسموح وقت الترجمة")) { return 30; };
    // comptime.result-not-closed, compiler/driver/compile_time.sn:205
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_نتيجة_غير_مغلقة(), "The compile-time result is not a closed constant value", "ناتج وقت الترجمة ليس قيمة ثابتة مستقلة عن وقت التشغيل")) { return 31; };
    // comptime.specialization-limit-exceeded, compiler/driver/compile_time.sn:1023
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_تجاوز_حد_التخصيصات(), "The number of compile-time specializations exceeded its limit", "تجاوز عدد تخصيصات وقت الترجمة الحد المسموح")) { return 32; };
    // comptime.unexpected-result, compiler/driver/compile_time.sn:508
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_غير_متوقع(), "Compile-time evaluation returned an unexpected result", "أعاد التقييم وقت الترجمة نتيجة غير متوقعة")) { return 33; };
    // comptime.unknown-target, compiler/driver/compile_time.sn:260
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_هدف_غير_معروف(), "Compile-time evaluation does not recognize the selected target", "لا يتعرف التقييم وقت الترجمة على الهدف المحدد")) { return 34; };
    // comptime.unrepresentable-result, compiler/driver/compile_time.sn:252
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_ناتج_غير_قابل_للتمثيل(), "The compile-time result cannot be represented as a constant of the expected type", "لا يمكن تمثيل ناتج وقت الترجمة ثابتا من النوع المتوقع")) { return 35; };
    // comptime.unsupported-callee, compiler/driver/compile_time.sn:225
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_مستدعى_غير_مدعوم(), "Only SultanC functions can be called at compile time", "يسمح التقييم وقت الترجمة باستدعاء دوال السلطان فقط")) { return 36; };
    // comptime.unsupported-operation, compiler/driver/compile_time.sn:495
    if (!check_reason(سبب_تشخيص.سبب_وقت_الترجمة_عملية_غير_مدعومة(), "This operation is not supported at compile time", "هذه العملية غير مدعومة وقت الترجمة")) { return 37; };
    // annotation.processing-not-implemented, compiler/frontend/semantic_pipeline.sn:850
    if (!check_reason(سبب_تشخيص.سبب_سمة_معالجة_غير_منفذة(), "Declaration annotation processing is not implemented yet", "معالجة سمات التصريحات غير منفذة بعد")) { return 38; };
    // ssf.move-out-of-reference, compiler/frontend/semantic_pipeline.sn:1534
    if (!check_reason(سبب_تشخيص.سبب_تدفق_سلامة_نقل_من_مرجع(), "An owned value is moved out of borrowed storage", "جرت محاولة نقل قيمة مملوكة من تخزين مستعار")) { return 39; };
    // format.unclosed-brace, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_قوس_غير_مغلق(), "A `{` in the format string is not closed by a `}`", "قوس `{` في سلسلة التنسيق لا يغلقه قوس `}`")) { return 40; };
    // format.unmatched-close-brace, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_قوس_إغلاق_منفرد(), "A `}` in the format string closes no `{`; write `}}` for a literal brace", "قوس `}` في سلسلة التنسيق لا يغلق قوس `{`؛ اكتب `}}` لقوس حرفي")) { return 41; };
    // format.invalid-spec, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_مواصفة_غير_صالحة(), "The placeholder's format spec is not valid", "مواصفة التنسيق في الموضع غير صالحة")) { return 42; };
    // format.unknown-type, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_نوع_غير_معروف(), "The placeholder names an unknown format type", "يذكر الموضع نوع تنسيق غير معروف")) { return 43; };
    // format.named-argument, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_وسيط_مسمى(), "Named arguments are not supported; refer to the argument by its position", "الوسائط المسماة غير مدعومة؛ أشر إلى الوسيط بموضعه")) { return 44; };
    // format.missing-argument, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_وسيط_مفقود(), "The format string refers to an argument the call does not pass", "تشير سلسلة التنسيق إلى وسيط لا يمرره النداء")) { return 45; };
    // format.unused-argument, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_وسيط_غير_مستخدم(), "The call passes an argument the format string never uses", "يمرر النداء وسيطا لا تستخدمه سلسلة التنسيق")) { return 46; };
    // format.mismatched-type, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_نوع_غير_مناسب(), "The placeholder's format type does not apply to the argument it formats", "نوع التنسيق في الموضع لا يناسب الوسيط الذي ينسقه")) { return 47; };
    // format.invalid-count, compiler/driver/compiler_driver.sn
    if (!check_reason(سبب_تشخيص.سبب_تنسيق_عدد_غير_صالح(), "A width or precision taken from an argument needs an integer argument", "العرض أو الدقة المأخوذان من وسيط يتطلبان وسيطا صحيحا")) { return 48; };
    return 0;
}
