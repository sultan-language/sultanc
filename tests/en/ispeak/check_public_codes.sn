    append(result, "link-input-unsupported");
    append(result, "unresolved-git-dependency");
    append(result, "invalid-dependency-map");
    append(result, "run-library-load-failed");
    append(result, "opaque-type-by-value");
    append(result, "opaque-type-argument");
    append(result, "opaque-pointer-dereference");
    append(result, "opaque-field-access");
    append(result, "opaque-pointer-arithmetic");
    append(result, "invalid-package-graph");
    append(result, "standard-library-not-found");
    append(result, "unformatted-source");
    append(result, "module-spelling-no-child");
    append(result, "module-spelling-shared");
    append(result, "module-spelling-reserved-word");
    append(result, "module-declaration-outside-root-file");
    return result;
}

def main(): int {
    let identities: vector معرف_تشخيص = كل_معرفات_التشخيص();
    let codes: vector string = pinned_codes();
    let kinds: vector string = pinned_kinds();
    if (length(identities) != length(codes)) { return 1; };
    let i: mutable uint = 0;
    while (i < (length(identities) as uint)) {
        let definition: تعريف_تشخيص = تعريف_التشخيص(identities[i]);
        let code: string = انسخ_نص(&definition.الكود);
        let kind: string = انسخ_نص(&definition.النوع_الآلي);
        if (!texts_equal(&code, &codes[i])) { return 2; };
        if (!texts_equal(&kind, &kinds[i])) { return 3; };
        i := i + 1;
    }
    return 0;
}
