// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_context_opaque_values.sn
import std.text.compare;
import std.text.builder;
import std.text.from_bytes;
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;

// Dynamic inputs must remain opaque when inserted into localized sentences.
// A fact must not break out of the fact boundary or change the surrounding
// agreement, punctuation, or quotation structure.
// An empty description stands for "no reason fact".
def reason_from_description(description: &string): option قيمة_حجة_رسالة {
    if ((length(*description) as uint) == 0) { return option.none(); };
    return option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(description)));
}

def symbol_facts(symbol: &string, description: &string): حقائق_سياق_رسالة {
    let context: حقائق_سياق_رسالة = {
        القيمة: option.none(),
        المتوقع: option.none(),
        الاستبدال: option.none(),
        الموجود: option.none(),
        الفهرس: option.none(),
        الطول: option.none(),
        المجال: option.none(),
        النمط: option.none(),
        المسار: option.none(),
        الرمز: option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(symbol))),
        النوع: option.none(),
        السياق: option.none(),
        المرحلة: option.none(),
        الهدف: option.none(),
        الدالة: option.none(),
        الكتلة: option.none(),
        التعليمة: option.none(),
        العملية: option.none(),
        البدائي: option.none(),
        المصدر: option.none(),
        الوجهة: option.none(),
        السبب: reason_from_description(description)
    };
    return context;
}

def check(language: لغة_تشخيص, symbol: &string, description: &string, expected: string): bool {
    let key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف());
    let payload: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(symbol_facts(symbol, description));
    match رسالة_تشخيص_بحجج(language, key, payload) with
    | option.some(text) -> {
        if (!texts_equal(&text, &expected)) { return false; };
        let builder: mutable text_builder = new_text_builder();
        if (!ألحق_تشخيص_بسياق(&mutable builder, language, key, symbol_facts(symbol, description))) { return false; };
        let from_builder: string = text_builder_text(&builder);
        return texts_equal(&from_builder, &expected);
    }
    | option.none -> { return false; };
}

def main(): int {
    let no_reason: string = "";
    let file: string = "lib/source.sn";
    if (!check(لغة_تشخيص.الإنجليزية(), &file, &no_reason, "unknown name — The unknown name is `lib/source.sn`.")) { return 1; };
    if (!check(لغة_تشخيص.العربية(), &file, &no_reason, "اسم غير معروف — الاسم غير المعروف هو `lib/source.sn`.")) { return 2; };

    let empty: string = "";
    if (!check(لغة_تشخيص.الإنجليزية(), &empty, &no_reason, "unknown name — The unknown name is ``.")) { return 3; };
    if (!check(لغة_تشخيص.العربية(), &empty, &no_reason, "اسم غير معروف — الاسم غير المعروف هو ``.")) { return 4; };

    let arabic_name: string = "متغيّر، جديد";
    if (!check(لغة_تشخيص.الإنجليزية(), &arabic_name, &no_reason, "unknown name — The unknown name is `متغيّر، جديد`.")) { return 5; };
    if (!check(لغة_تشخيص.العربية(), &arabic_name, &no_reason, "اسم غير معروف — الاسم غير المعروف هو `متغيّر، جديد`.")) { return 6; };

    let raw: mutable vector u8 = [];
    append_text_bytes(&mutable raw, "a`b");
    append(raw, 0x0A);
    append(raw, 0x09);
    append(raw, 0x00);
    let hazardous: string = from_bytes(&raw);
    if (!check(لغة_تشخيص.الإنجليزية(), &hazardous, &no_reason, «unknown name — The unknown name is `a\`b\n\t\x00`.»)) { return 7; };
    if (!check(لغة_تشخيص.العربية(), &hazardous, &no_reason, «اسم غير معروف — الاسم غير المعروف هو `a\`b\n\t\x00`.»)) { return 8; };

    let description: string = "side effects?";
    if (!check(لغة_تشخيص.الإنجليزية(), &empty, &description, "unknown name — The unknown name is ``. `side effects?`.")) { return 9; };
    if (!check(لغة_تشخيص.العربية(), &empty, &description, "اسم غير معروف — الاسم غير المعروف هو ``. `side effects?`.")) { return 10; };

    return 0;
}
