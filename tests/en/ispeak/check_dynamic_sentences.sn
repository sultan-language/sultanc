// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_dynamic_sentences.sn
import std.text.compare;
import std.text.from_bytes;
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;

// A small source-backed semantic sample: test full sentences, not merely
// longer strings or reversible numeric IDs.
def specific_context(
    value: option قيمة_حجة_رسالة,
    path: option قيمة_حجة_رسالة,
    symbol: option قيمة_حجة_رسالة,
    reason: option قيمة_حجة_رسالة,
    target: option قيمة_حجة_رسالة,
    expected: option قيمة_حجة_رسالة,
    found: option قيمة_حجة_رسالة
): حقائق_سياق_رسالة {
    let data: حقائق_سياق_رسالة = {
        القيمة: value,
        المتوقع: expected,
        الاستبدال: option.none(),
        الموجود: found,
        الفهرس: option.none(),
        الطول: option.none(),
        المجال: option.none(),
        النمط: option.none(),
        المسار: path,
        الرمز: symbol,
        النوع: option.none(),
        السياق: option.none(),
        المرحلة: option.none(),
        الهدف: target,
        الدالة: option.none(),
        الكتلة: option.none(),
        التعليمة: option.none(),
        العملية: option.none(),
        البدائي: option.none(),
        المصدر: option.none(),
        الوجهة: option.none(),
        السبب: reason
    };
    return data;
}

def check(language: لغة_تشخيص, key: مفتاح_رسالة_تشخيص, facts: حقائق_سياق_رسالة, expected: string): bool {
    let data: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(facts);
    match رسالة_تشخيص_بحجج(language, key, data) with
    | option.some(actual) -> { return texts_equal(&actual, &expected); }
    | option.none -> { return false; };
}

def main(): int {
    let option_text: string = "--bad";
    let path: string = "./lost.sn";
    let name: string = "counter";
    let reason: string = "side effects";
    let target: string = "unknown-os";
    let expected_type: string = "i32";
    let found_type: string = "f64";

    let option_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.خيار_مترجم_غير_معروف());
    if (!check(لغة_تشخيص.الإنجليزية(), option_key, specific_context(option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&option_text))), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "unknown option — The unrecognized compiler option is `--bad`.")) { return 1; };
    if (!check(لغة_تشخيص.العربية(), option_key, specific_context(option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&option_text))), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "خيار غير معروف — خيار المترجم غير المعروف هو `--bad`.")) { return 2; };

    let file_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.ملف_إدخال_مفقود());
    if (!check(لغة_تشخيص.الإنجليزية(), file_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "input file was not found — The missing input file is `./lost.sn`.")) { return 3; };
    if (!check(لغة_تشخيص.العربية(), file_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "ملف الإدخال غير موجود — ملف الإدخال المفقود هو `./lost.sn`.")) { return 4; };

    let name_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.استخدام_قبل_التهيئة());
    if (!check(لغة_تشخيص.الإنجليزية(), name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "use before initialization — The value used before initialization is `counter`.")) { return 5; };
    if (!check(لغة_تشخيص.العربية(), name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "استخدام قبل التهيئة — القيمة المستخدمة قبل التهيئة هي `counter`.")) { return 6; };

    let comptime_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تعبير_وقت_الترجمة_غير_ثابت());
    if (!check(لغة_تشخيص.الإنجليزية(), comptime_key, specific_context(option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&reason))), option.none(), option.none(), option.none()), "comptime expression must be a pure compile-time constant — The compile-time evaluation failure was described as follows: `side effects`.")) { return 7; };
    if (!check(لغة_تشخيص.العربية(), comptime_key, specific_context(option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&reason))), option.none(), option.none(), option.none()), "تعبير وقت_الترجمة يجب أن يكون ثابتا نقيا وقت الترجمة — ورد سبب فشل التقييم وقت الترجمة على النحو الآتي: `side effects`.")) { return 8; };

    let target_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.هدف_مترجم_غير_معروف());
    if (!check(لغة_تشخيص.الإنجليزية(), target_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&target))), option.none(), option.none()), "unknown target — The unrecognized compilation target is `unknown-os`.")) { return 9; };
    if (!check(لغة_تشخيص.العربية(), target_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&target))), option.none(), option.none()), "هدف غير معروف — هدف التجميع غير المعروف هو `unknown-os`.")) { return 10; };

    let type_pair_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوعان_غير_متوافقين());
    if (!check(لغة_تشخيص.الإنجليزية(), type_pair_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&expected_type))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&found_type)))), "mismatched types — The expected type is `i32` but the actual type is `f64`.")) { return 11; };
    if (!check(لغة_تشخيص.العربية(), type_pair_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&expected_type))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&found_type)))), "نوعان غير متوافقين — النوع المتوقع هو `i32`، لكن النوع الفعلي هو `f64`.")) { return 12; };

    // Exact source-identity wording beyond the original CLI/target/type sample.
    // These assertions reject a generic "The symbol is ..."/"The path is ..."
    // fallback even when the output is longer than the fixed message.
    let unknown_name_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.اسم_غير_معروف());
    if (!check(لغة_تشخيص.الإنجليزية(), unknown_name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "unknown name — The unknown name is `counter`.")) { return 13; };
    if (!check(لغة_تشخيص.العربية(), unknown_name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "اسم غير معروف — الاسم غير المعروف هو `counter`.")) { return 14; };

    let missing_field_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.حقل_سجل_مفقود());
    if (!check(لغة_تشخيص.الإنجليزية(), missing_field_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "required record field is missing — The missing record field is `counter`.")) { return 15; };
    if (!check(لغة_تشخيص.العربية(), missing_field_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "حقل سجل مطلوب مفقود — حقل السجل المفقود هو `counter`.")) { return 16; };

    let unreadable_module_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.وحدة_مصدر_غير_مقروءة());
    if (!check(لغة_تشخيص.الإنجليزية(), unreadable_module_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "source module could not be read — The unreadable source module is at `./lost.sn`.")) { return 17; };
    if (!check(لغة_تشخيص.العربية(), unreadable_module_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "تعذرت قراءة وحدة المصدر — وحدة المصدر التي تعذرت قراءتها هي `./lost.sn`.")) { return 18; };

    let escaping_import_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.استيراد_يهرب_من_الجذر());
    if (!check(لغة_تشخيص.الإنجليزية(), escaping_import_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "import escapes its library root — The import escapes the library root through `./lost.sn`.")) { return 19; };
    if (!check(لغة_تشخيص.العربية(), escaping_import_key, specific_context(option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&path))), option.none(), option.none(), option.none(), option.none(), option.none()), "الاستيراد يخرج عن جذر مكتبته — مسار الاستيراد الخارج عن جذر المكتبة هو `./lost.sn`.")) { return 20; };

    let warning_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.تحذير_عام());
    if (!check(لغة_تشخيص.الإنجليزية(), warning_key, specific_context(option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&option_text))), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "compiler warning — The warning detail is `--bad`.")) { return 21; };
    if (!check(لغة_تشخيص.العربية(), warning_key, specific_context(option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&option_text))), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "تحذير من المترجم — تفصيل التحذير هو `--bad`.")) { return 22; };

    let arguments_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.none()), "call argument count does not match — The expected argument count is 3.")) { return 23; };
    if (!check(لغة_تشخيص.العربية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.none()), "عدد حجج النداء غير مطابق — عدد حجج الاستدعاء المتوقع هو 3.")) { return 24; };

    if (!check(لغة_تشخيص.الإنجليزية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(4 as uint))), "call argument count does not match — The supplied argument count is 4.")) { return 25; };
    if (!check(لغة_تشخيص.العربية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(4 as uint))), "عدد حجج النداء غير مطابق — عدد حجج الاستدعاء المقدم هو 4.")) { return 26; };

    let return_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_إرجاع_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), return_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&found_type)))), "return type does not match — The return type is `f64`.")) { return 27; };
    if (!check(لغة_تشخيص.العربية(), return_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&found_type)))), "نوع الإرجاع غير مطابق — نوع الإرجاع الفعلي هو `f64`.")) { return 28; };

    let payloads_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حمولات_نمط_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), payloads_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint))), "pattern constructor payload count does not match — The constructor has 2 payloads, but the pattern binds 3 payloads.")) { return 29; };
    if (!check(لغة_تشخيص.العربية(), payloads_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint))), "عدد حمولات منشئ النمط غير مطابق — المنشئ يحمل حمولتين، لكن النمط يربط 3 حمولات.")) { return 30; };

    if (!check(لغة_تشخيص.الإنجليزية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(4 as uint))), "call argument count does not match — The function expects 3 arguments, but the call passes 4 arguments.")) { return 39; };
    if (!check(لغة_تشخيص.العربية(), arguments_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(4 as uint))), "عدد حجج النداء غير مطابق — الدالة تتوقع 3 حجج، لكن النداء يمرر 4 حجج.")) { return 40; };

    let internal_failure_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.فشل_مترجم_داخلي());
    if (!check(لغة_تشخيص.الإنجليزية(), internal_failure_key, specific_context(option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&reason))), option.none(), option.none(), option.none()), "The compiler encountered an internal failure — The compiler failure was described as follows: `side effects`.")) { return 31; };
    if (!check(لغة_تشخيص.العربية(), internal_failure_key, specific_context(option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&reason))), option.none(), option.none(), option.none()), "حدث خلل داخلي عام في المترجم — ورد سبب فشل المترجم على النحو الآتي: `side effects`.")) { return 32; };

    // Reason identities accept typed context directly; no reverse text lookup.
    let reason_key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_مسير_مميز_فرع_متعدد_غير_صحيح());
    if (!check(لغة_تشخيص.الإنجليزية(), reason_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "MSIR switch selector is not an integer — The symbol is `counter`.")) { return 33; };
    if (!check(لغة_تشخيص.العربية(), reason_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&name))), option.none(), option.none(), option.none(), option.none()), "مميز الفرع المتعدد في MSIR ليس عددا صحيحا — الرمز هو `counter`.")) { return 34; };

    // Empty context means the original fixed message, including for reasons.
    if (!check(لغة_تشخيص.الإنجليزية(), reason_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "MSIR switch selector is not an integer")) { return 35; };
    if (!check(لغة_تشخيص.العربية(), reason_key, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.none(), option.none()), "مميز الفرع المتعدد في MSIR ليس عددا صحيحا")) { return 36; };

    // Caller-provided Unicode and punctuation are data, never lookup keys.
    let unicode_name: string = "مُتغيّر`x";
    if (!check(لغة_تشخيص.الإنجليزية(), unknown_name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&unicode_name))), option.none(), option.none(), option.none(), option.none()), «unknown name — The unknown name is `مُتغيّر\`x`.»)) { return 37; };
    if (!check(لغة_تشخيص.العربية(), unknown_name_key, specific_context(option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&unicode_name))), option.none(), option.none(), option.none(), option.none()), «اسم غير معروف — الاسم غير المعروف هو `مُتغيّر\`x`.»)) { return 38; };
    return 0;
}
