import compiler.ispeak.keys.surface;
import std.text.from_bytes;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;

// Owned facts are consumed per call, so each locale receives its own payload.
def check(key: مفتاح_رسالة_تشخيص, payload: حقائق_رسالة, arabic_payload: حقائق_رسالة, correct: bool): bool {
    match رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), key, payload) with
    | option.some(_) -> { if (!correct) { return false; }; }
    | option.none -> { if (correct) { return false; }; };
    match رسالة_تشخيص_بحجج(لغة_تشخيص.العربية(), key, arabic_payload) with
    | option.some(_) -> { return correct; }
    | option.none -> { return !correct; };
}

def name_values(): حقائق_اسم_غير_معروف {
    let values: حقائق_اسم_غير_معروف = { الاسم: "demo" };
    return values;
}

def type_values(): حقائق_نوعان_غير_متوافقين {
    let values: حقائق_نوعان_غير_متوافقين = { المتوقع: "i32", الموجود: "f32" };
    return values;
}

def count_values(): حقائق_عدد_حجج_غير_مطابق {
    let values: حقائق_عدد_حجج_غير_مطابق = { المتوقع: 2 as uint, الموجود: 3 as uint };
    return values;
}

def text_values(): حقائق_نص_محدد {
    let values: حقائق_نص_محدد = { القيمة: "demo" };
    return values;
}

def link_values(): حقائق_ربط_إل_إل_في_إم {
    let values: حقائق_ربط_إل_إل_في_إم = { الهدف: "arm64-darwin", الرمز: "LLVMGetVersion" };
    return values;
}

def failure_values(): حقائق_فشل_وقت_الترجمة {
    let values: حقائق_فشل_وقت_الترجمة = { الرسالة: "compiler_error() called" };
    return values;
}

def manifest_values(): حقائق_بيان_حزمة {
    let values: حقائق_بيان_حزمة = { المسار: "./package-graph.toml", البايت: option.some(8 as uint), السبب: option.some(مفتاح_نص_مترجم.حقل_رسم_حزم_مطلوب_مفقود()) };
    return values;
}

def suggestion_values(): حقائق_اقتراح_كلمة {
    let values: حقائق_اقتراح_كلمة = { الاستبدال: "return" };
    return values;
}

def syntax_values(): حقائق_توقع_نحوي {
    let values: حقائق_توقع_نحوي = { المتوقع: "i32", الموجود: option.some("f32") };
    return values;
}

def primitive_values(): حقائق_بدائي_تفسير {
    let values: حقائق_بدائي_تفسير = { البدائي: "host.read", الفهرس: option.some(1 as uint), المتوقع: option.some(2 as uint), الموجود: option.some(3 as uint) };
    return values;
}

def unknown_name_payload(): حقائق_رسالة {
    return حقائق_رسالة.اسم_غير_معروف(name_values());
}

def incompatible_types_payload(): حقائق_رسالة {
    return حقائق_رسالة.نوعان_غير_متوافقين(type_values());
}

def argument_count_mismatch_payload(): حقائق_رسالة {
    return حقائق_رسالة.عدد_حجج_غير_مطابق(count_values());
}

def specific_text_payload(): حقائق_رسالة {
    return حقائق_رسالة.نص_محدد(text_values());
}

def llvm_link_payload(): حقائق_رسالة {
    return حقائق_رسالة.ربط_إل_إل_في_إم(link_values());
}

def comptime_failure_payload(): حقائق_رسالة {
    return حقائق_رسالة.فشل_وقت_الترجمة(failure_values());
}

def package_manifest_payload(): حقائق_رسالة {
    return حقائق_رسالة.بيان_حزمة(manifest_values());
}

def keyword_suggestion_payload(): حقائق_رسالة {
    return حقائق_رسالة.اقتراح_كلمة(suggestion_values());
}

def syntax_expectation_payload(): حقائق_رسالة {
    return حقائق_رسالة.توقع_نحوي(syntax_values());
}

def interpreter_primitive_payload(): حقائق_رسالة {
    return حقائق_رسالة.بدائي_تفسير(primitive_values());
}

