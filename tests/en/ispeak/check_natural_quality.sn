// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/check_natural_quality.sn
import std.text.compare;
import std.text.from_bytes;
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;

// A small source-backed semantic sample: test full sentences, not merely
// longer strings or reversible numeric IDs.
def specific_context(
    value: option قيمة_حجة_رسالة,
    path: option قيمة_حجة_رسالة,
    symbol: option قيمة_حجة_رسالة,
    reason: option قيمة_حجة_رسالة,
    target: option قيمة_حجة_رسالة,
    expected: option قيمة_حجة_رسالة,
    found: option قيمة_حجة_رسالة
): حقائق_سياق_رسالة {
    let data: حقائق_سياق_رسالة = {
        القيمة: value,
        المتوقع: expected,
        الاستبدال: option.none(),
        الموجود: found,
        الفهرس: option.none(),
        الطول: option.none(),
        المجال: option.none(),
        النمط: option.none(),
        المسار: path,
        الرمز: symbol,
        النوع: option.none(),
        السياق: option.none(),
        المرحلة: option.none(),
        الهدف: target,
        الدالة: option.none(),
        الكتلة: option.none(),
        التعليمة: option.none(),
        العملية: option.none(),
        البدائي: option.none(),
        المصدر: option.none(),
        الوجهة: option.none(),
        السبب: reason
    };
    return data;
}

def check(language: لغة_تشخيص, key: مفتاح_رسالة_تشخيص, facts: حقائق_سياق_رسالة, expected: string): bool {
    let data: حقائق_رسالة = حقائق_رسالة.سياق_تشخيص(facts);
    match رسالة_تشخيص_بحجج(language, key, data) with
    | option.some(actual) -> { return texts_equal(&actual, &expected); }
    | option.none -> { return false; };
}

def main(): int {
    let arguments: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.عدد_حجج_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(0 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(1 as uint))), "call argument count does not match — The function expects no arguments, but the call passes 1 argument.")) { return 1; };
    if (!check(لغة_تشخيص.العربية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(0 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(1 as uint))), "عدد حجج النداء غير مطابق — الدالة لا تتوقع أي حجة، لكن النداء يمرر حجة واحدة.")) { return 2; };
    if (!check(لغة_تشخيص.الإنجليزية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(1 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint))), "call argument count does not match — The function expects 1 argument, but the call passes 2 arguments.")) { return 3; };
    if (!check(لغة_تشخيص.العربية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(1 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint))), "عدد حجج النداء غير مطابق — الدالة تتوقع حجة واحدة، لكن النداء يمرر حجتين.")) { return 4; };
    if (!check(لغة_تشخيص.الإنجليزية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint))), "call argument count does not match — The function expects 2 arguments, but the call passes 3 arguments.")) { return 5; };
    if (!check(لغة_تشخيص.العربية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(2 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint))), "عدد حجج النداء غير مطابق — الدالة تتوقع حجتين، لكن النداء يمرر 3 حجج.")) { return 6; };
    if (!check(لغة_تشخيص.الإنجليزية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(11 as uint))), "call argument count does not match — The function expects 3 arguments, but the call passes 11 arguments.")) { return 7; };
    if (!check(لغة_تشخيص.العربية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(3 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(11 as uint))), "عدد حجج النداء غير مطابق — الدالة تتوقع 3 حجج، لكن النداء يمرر 11 حجة.")) { return 8; };
    if (!check(لغة_تشخيص.الإنجليزية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(11 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(102 as uint))), "call argument count does not match — The function expects 11 arguments, but the call passes 102 arguments.")) { return 9; };
    if (!check(لغة_تشخيص.العربية(), arguments, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.طبيعية(11 as uint)), option.some(قيمة_حجة_رسالة.طبيعية(102 as uint))), "عدد حجج النداء غير مطابق — الدالة تتوقع 11 حجة، لكن النداء يمرر 102 حجة.")) { return 10; };
    let first: string = "i32";
    let second: string = "f64";
    let argument: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_حجة_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), argument, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&first))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&second)))), "call argument type does not match — The argument was expected to have type `i32` but has type `f64`.")) { return 11; };
    if (!check(لغة_تشخيص.العربية(), argument, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&first))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&second)))), "نوع حجة النداء غير مطابق — نوع الحجة المتوقع هو `i32`، لكن نوع الحجة الفعلي هو `f64`.")) { return 12; };
    let return_text: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.نوع_إرجاع_غير_مطابق());
    if (!check(لغة_تشخيص.الإنجليزية(), return_text, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&first))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&second)))), "return type does not match — The return type was expected to be `i32` but is `f64`.")) { return 13; };
    if (!check(لغة_تشخيص.العربية(), return_text, specific_context(option.none(), option.none(), option.none(), option.none(), option.none(), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&first))), option.some(قيمة_حجة_رسالة.نصية(انسخ_نص(&second)))), "نوع الإرجاع غير مطابق — نوع الإرجاع المتوقع هو `i32`، لكن نوع الإرجاع الفعلي هو `f64`.")) { return 14; };
    let malformed_comparison: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_انتقاء_مقارنة_ليس_منه_شرط());
    let arabic_phrase: string = "يُستخدم ناتج مقارنة بطريقة لا تدعمها الخلفية الأصلية إلا كشرط تفرع";
    let رسالة_عربية: string = رسالة_تشخيص(لغة_تشخيص.العربية(), malformed_comparison);
    if (!texts_equal(&arabic_phrase, &رسالة_عربية)) { return 15; };
    let unsupported_comparison: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.سبب(سبب_تشخيص.سبب_انتقاء_غير_مدعوم_مقارنة());
    let comparison_phrase: string = "لا تدعم الخلفية الأصلية هذه المقارنة بعد";
    let comparison_message: string = رسالة_تشخيص(لغة_تشخيص.العربية(), unsupported_comparison);
    if (!texts_equal(&comparison_phrase, &comparison_message)) { return 16; };
    return 0;
}
