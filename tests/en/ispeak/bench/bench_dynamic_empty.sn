// اختبار: تشغيل
// أهداف: arm64-darwin,x86_64-linux
// خروج: 0
// نظير: tests/ar/ispeak/bench/bench_dynamic_empty.sn
import compiler.diagnostics.identity;
import compiler.diagnostics.reason;
import compiler.ispeak.format.facts;
import compiler.diagnostics.schema;
import compiler.ispeak.ispeak;
import std.text.compare;

// Same 200,000 calls through the dynamic API, but with no contextual values.
def empty_context(): حقائق_سياق_رسالة {
    let context: حقائق_سياق_رسالة = {
        القيمة: option.none(),
        المتوقع: option.none(),
        الاستبدال: option.none(),
        الموجود: option.none(),
        الفهرس: option.none(),
        الطول: option.none(),
        المجال: option.none(),
        النمط: option.none(),
        المسار: option.none(),
        الرمز: option.none(),
        النوع: option.none(),
        السياق: option.none(),
        المرحلة: option.none(),
        الهدف: option.none(),
        الدالة: option.none(),
        الكتلة: option.none(),
        التعليمة: option.none(),
        العملية: option.none(),
        البدائي: option.none(),
        المصدر: option.none(),
        الوجهة: option.none(),
        السبب: option.none()
    };
    return context;
}

def main(): int {
    let key: مفتاح_رسالة_تشخيص = مفتاح_رسالة_تشخيص.تشخيص(معرف_تشخيص.مسير_غير_صالح());
    let expected: string = "invalid MSIR";
    let message_length: uint = length(expected) as uint;
    let total: mutable uint = 0;
    let i: mutable uint = 0;
    while (i < 200000) {
        match رسالة_تشخيص_بحجج(لغة_تشخيص.الإنجليزية(), key, حقائق_رسالة.سياق_تشخيص(empty_context())) with
        | option.some(output) -> {
            total := total + (length(output) as uint);
            if (i == 0 && !texts_equal(&output, &expected)) { return 1; };
        }
        | option.none -> { return 2; };
        i := i + 1;
    }
    if (total != message_length * 200000) { return 3; };
    return 0;
}
