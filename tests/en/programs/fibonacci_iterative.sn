// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/programs/fibonacci_iterative.sn
def fibonacci(n: int): int {
    let a: mutable int = 0;
    let b: mutable int = 1;
    let i: mutable int = 0;
    while (i < n) {
        let next: int = a + b;
        a := b;
        b := next;
        i := i + 1;
    }
    return a;
}

def main(): int {
    if (fibonacci(10) == 55) { return 42; };
    return 1;
}
