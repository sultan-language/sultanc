// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/programs/prime_count.sn
def is_prime(n: int): bool {
    if (n < 2) { return false; };
    let d: mutable int = 2;
    while ((d * d) <= n) {
        if ((n % d) == 0) { return false; };
        d := d + 1;
    }
    return true;
}

def main(): int {
    let count: mutable int = 0;
    let n: mutable int = 2;
    while (n <= 100) {
        if (is_prime(n)) { count := count + 1; };
        n := n + 1;
    }
    if (count == 25) { return 42; };
    return 1;
}
