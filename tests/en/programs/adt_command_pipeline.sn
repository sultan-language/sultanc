// اختبار: تفاضلي
// أهداف: arm64-darwin,x86_64-linux
// خروج: 42
// تفاضلي: نعم
// نظير: tests/ar/programs/adt_command_pipeline.sn
type Operation = | Add of int | Multiply of int;

def apply(value: int, operation: Operation): int {
    match operation with
    | Operation.Add(amount) -> { return value + amount; }
    | Operation.Multiply(amount) -> { return value * amount; };
}

def main(): int {
    let first: Operation = Operation.Add(2);
    let second: Operation = Operation.Multiply(3);
    let third: Operation = Operation.Add(6);
    let value1: int = apply(10, first);
    let value2: int = apply(value1, second);
    let value3: int = apply(value2, third);
    if (value3 == 42) { return 42; };
    return 1;
}
