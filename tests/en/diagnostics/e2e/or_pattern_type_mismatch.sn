// خرج-تشخيص-عربي: or_pattern_type_mismatch.ar.stderr
// خرج-تشخيص-إنجليزي: or_pattern_type_mismatch.en.stderr
// The alternatives bind `v` with two different types.
type Value = | Number of int | Word of string;
def show(v: Value): int {
    match v with
    | Value.Number(x) | Value.Word(x) -> { return 1; };
}
def main(): int { return show(Value.Number(1)); }
