// A module-level value built by a constructor is rebuilt where it is read,
// so it cannot be storage a program writes: a user diagnostic at the
// declaration, never an internal lowering error.
type Color = | Red | Green;
let current: mutable Color = Color.Red();
def main(): i32 {
    return 0;
}
