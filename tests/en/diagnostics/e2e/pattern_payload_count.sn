// خرج-تشخيص-إنجليزي: pattern_payload_count.en.stderr
type Maybe = | Nothing | Just of i32;
def main(): i32 {
    let m: Maybe = Maybe.Just(1);
    match m with
    | Maybe.Just(a, b) -> { return a; }
    | Maybe.Nothing -> { return 0; };
}
