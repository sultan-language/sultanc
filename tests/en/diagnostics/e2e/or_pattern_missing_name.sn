// خرج-تشخيص-إنجليزي: or_pattern_missing_name.en.stderr
// Every alternative binds the same names: `x` is bound by the first
// alternative only.
def axis(p: (int, int)): int {
    match p with
    | (0, x) | (y, 0) -> { return 1; }
    | _ -> { return 0; };
}
def main(): int { return axis((0, 1)); }
