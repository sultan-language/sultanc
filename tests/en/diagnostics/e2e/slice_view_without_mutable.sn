// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-VIEW-WITHOUT-MUTABLE
// نظير: tests/ar/diagnostics/e2e/slice_view_without_mutable.sn
// خرج-تشخيص-عربي: slice_view_without_mutable.ar.stderr
// خرج-تشخيص-إنجليزي: slice_view_without_mutable.en.stderr
// A `mutable [] T` parameter writes into the vector it views, so the call
// asks for it with `&mutable`: `fill(&mutable values, 0)`. The fix writes it.
def fill(part: mutable [] int, value: int): void {
    let i: mutable int = 0;
    while (i < length(part)) { part[i] := value; i := i + 1; }
}
def main(): int {
    let values: mutable vector int = [1, 2, 3];
    fill(values, 0);
    return values[0];
}
