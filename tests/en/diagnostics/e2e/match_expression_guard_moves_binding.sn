// اختبار: رفض
// تشخيص: SULTANC-OWNERSHIP-MOVE-OUT-OF-REFERENCE
// نظير: tests/ar/diagnostics/e2e/match_expression_guard_moves_binding.sn
// خرج-تشخيص-عربي: match_expression_guard_moves_binding.ar.stderr
// خرج-تشخيص-إنجليزي: match_expression_guard_moves_binding.en.stderr
// The guard of a match expression borrows the bindings, as in the statement:
// it cannot move the payload, which still belongs to the scrutinee when the
// guard fails.
type Named = | One of string | Nothing;
def take(s: string): int { return length(s) as int; }
def f(n: Named): int {
    return match n with
    | Named.One(s) if take(s) > 3 -> 1
    | _ -> 0;
}
def main(): int { return f(Named.Nothing()); }
