// خرج-تشخيص-إنجليزي: partial_move.en.stderr
// Moving one element out of an owned vector is marked at the element.
def main(): int {
    let parts: vector string = ["first", "second"];
    return take(parts[1]);
}

def take(text: string): int {
    return length(text) as int;
}
