// reported from it (no error follows from another).
def helper(value: i32): i32 {
    return value;
}
def mistyped(): i32 {
    let count: i32 = "text";
    return count;
}
def main(): i32 {
    let first: i32 = missing_value + 1;
    let second: i32 = hlper(2);
    return first + second + mistyped();
}
