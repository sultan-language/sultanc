// اختبار: رفض
// تشخيص: SULTANC-MUTABILITY-WRITE-TO-IMMUTABLE
// نظير: tests/ar/diagnostics/e2e/slice_write_read_only.sn
// خرج-تشخيص-عربي: slice_write_read_only.ar.stderr
// خرج-تشخيص-إنجليزي: slice_write_read_only.en.stderr
// A slice without `&mutable` is a read-only view: writing through it is
// rejected, even when its vector is `mutable`.
def main(): int {
    let values: mutable vector int = [1, 2, 3];
    let part: [] int = values[1..];
    part[0] := 9;
    return 0;
}
