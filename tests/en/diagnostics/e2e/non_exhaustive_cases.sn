// نظير: tests/ar/diagnostics/e2e/non_exhaustive_cases.sn
// خرج-تشخيص-عربي: non_exhaustive_cases.ar.stderr
// خرج-تشخيص-إنجليزي: non_exhaustive_cases.en.stderr
// A match that misses cases names up to three of them, then how many more.
type Light =
    | Red | Yellow | Green | Blue of int | Violet | White;

def main(): int {
    let light: Light = Light.Red();
    match light with
    | Light.Red -> { return 1; }
    | Light.Yellow -> { return 2; };
    return 0;
}
