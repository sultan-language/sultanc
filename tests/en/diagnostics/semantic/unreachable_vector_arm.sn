// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// نظير: tests/ar/diagnostics/semantic/unreachable_vector_arm.sn
// `[_, rest _]` covers every vector of one element or more: the arm after it never
// runs, a warning, and the program builds.
def main(): int {
    let v: vector int = [1];
    match v with
    | [_, rest _] -> { return 0; }
    | [a] -> { return a; }
    | [] -> { return 2; };
}
