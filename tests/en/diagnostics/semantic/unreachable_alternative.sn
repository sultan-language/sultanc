// اختبار: قبول
// تشخيص: SULTANC-PATTERN-UNREACHABLE
// نظير: tests/ar/diagnostics/semantic/unreachable_alternative.sn
// An alternative the earlier arms already cover never matches: a warning at
// the alternative, and the program builds.
type Hand = | Rock | Paper | Scissors;
def main(): int {
    let h: Hand = Hand.Paper();
    match h with
    | Hand.Rock -> { return 1; }
    | Hand.Paper | Hand.Rock -> { return 0; }
    | Hand.Scissors -> { return 3; };
}
