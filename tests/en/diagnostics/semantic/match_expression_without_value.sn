// اختبار: رفض
// تشخيص: SULTANC-TYPE-MATCH-WITHOUT-VALUE
// نظير: tests/ar/diagnostics/semantic/match_expression_without_value.sn
// خرج-تشخيص-عربي: match_expression_without_value.ar.stderr
// خرج-تشخيص-إنجليزي: match_expression_without_value.en.stderr
// A match expression takes its value from an arm: one at least ends with a value.
def main(): int {
    let n: int = 1;
    let x: int = match n with
    | 1 -> { return 1; }
    | _ -> { return 2; };
    return x;
}
