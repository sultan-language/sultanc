// اختبار: رفض
// تشخيص: SULTANC-FLOW-USE-BEFORE-INITIALIZATION
// نظير: tests/ar/diagnostics/safety/conditional_initialization_join.sn
// Only one branch initializes the text; after the join it is initialized on
// some paths only, so the read is a use before initialization.
def main(): int {
    let flag: bool = true;
    let text: string;
    if (flag) {
        text := "set";
    };
    return length(text) as int;
}
