// اختبار: رفض
// تشخيص: SULTANC-SAFETY-UNSAFE-OPERATION
// نظير: tests/ar/diagnostics/safety/c_address_call_outside_unsafe.sn
// A call shape at an address (link name `*`) calls whatever its first argument holds with a signature nothing
// checks: like raw_c_call, it needs an unsafe scope.
extern def call_at(address: u64, value: i64): i64 = «*»;

def main(): int {
    let result: i64 = call_at(0 as u64, 1);
    return 0;
}
