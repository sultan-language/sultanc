// اختبار: رفض
// تشخيص: SULTANC-THREAD-CAPTURE-RAW-POINTER
// نظير: tests/ar/diagnostics/safety/thread_capture_raw_pointer.sn
// The spawn capture check (docs/TYPE_SYSTEM.md, "Thread capture rules"): a
// closure handed to another thread may not capture a raw pointer, which is
// not safe to send (Rust's *mut T is !Send), unless the spawn sits inside
// an unsafe block. Share heap state through std.sync instead.
import std.thread.thread;

type cell = { value: u64 };

def write_mark(p: *mutable cell): void { unsafe { (*p).value := 7 as u64; } }

def main(): i32 {
    let c: mutable cell = { value: 0 as u64 };
    let p: *mutable cell = &mutable c;
    match spawn(fn(): void -> write_mark(p)) with
    | result.ok(_) -> { }
    | result.err(_) -> { };
    return 0;
}
