# SULTANC_BOOTSTRAP=wasm: Stage1 comes from the WebAssembly seed in
# bootstrap-wasm/ (the seed bootstrap) instead of the C Stage0 in
# bootstrap/. The seed is translated to C and compiled with wasi.c; the result
# is the same SultanC compiler, built Native-only. All bootstrap rules live in
# WasmSeed.cmake; this module only fits them to the stage
# targets, output paths and exports of this build (as Stage0.cmake and
# Stage1.cmake do for the C route), so Stage2.cmake and Verify.cmake are shared.
include(CompilerSources)
include(WasmSeed)

if(NOT DEFINED SULTANC_STAGE1_OUTPUT_NAME)
    set(SULTANC_STAGE1_OUTPUT_NAME "sultanc-stage1")
endif()
set(SULTANC_WASM2C "" CACHE FILEPATH
    "Prebuilt sultanc-wasm2c for the build machine (cross builds of the wasm bootstrap)")

# There is no Stage0 in this route: the translator is its first tool.
add_custom_target(sultanc-stage0
    COMMAND "${CMAKE_COMMAND}" -E echo
        "SULTANC_BOOTSTRAP=wasm has no Stage0 (the C seed compiler); its first step is the translator sultanc-wasm2c"
    COMMAND "${CMAKE_COMMAND}" -E false
    VERBATIM)

set(_sultanc_stage1_export "")
if(SULTANC_EXPORT_DIRECTORY AND NOT SULTANC_STAGE1_OUTPUT_EXPLICIT AND
   (SULTANC_REQUESTED_STAGE STREQUAL "stage1" OR
    SULTANC_REQUESTED_STAGE STREQUAL "bootstrap"))
    sultanc_export_destination("${SULTANC_STAGE1_OUTPUT_NAME}${CMAKE_EXECUTABLE_SUFFIX}"
        "${SULTANC_EXPORT_DIRECTORY}/bootstrap" _sultanc_stage1_export)
endif()
# The stage target precedes the internal executable target (see
# sultanc_export_destination in CMakeLists.txt).
add_custom_target(sultanc-stage1 ALL DEPENDS ${_sultanc_stage1_export})
if(SULTANC_WASM2C)
    sultanc_wasm_add_stage1(sultanc-stage1-executable WASM2C "${SULTANC_WASM2C}")
else()
    sultanc_wasm_add_stage1(sultanc-stage1-executable)
endif()
add_dependencies(sultanc-stage1 sultanc-stage1-executable)
set_target_properties(sultanc-stage1-executable PROPERTIES OUTPUT_NAME "${SULTANC_STAGE1_OUTPUT_NAME}")
if(SULTANC_STAGE1_OUTPUT_EXPLICIT)
    set_target_properties(sultanc-stage1-executable PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "$<1:${SULTANC_STAGE1_OUTPUT_DIRECTORY}>")
else()
    set_target_properties(sultanc-stage1-executable PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
endif()
if(_sultanc_stage1_export)
    # This Stage1 has no LLVM: it imports no LLVM-C.dll on Windows.
    sultanc_export_executable(sultanc-stage1-executable "${_sultanc_stage1_export}"
        "Exporting Stage1 to ${SULTANC_EXPORT_DIRECTORY}/bootstrap" NATIVE_ONLY)
endif()

# An LLVM-enabled Stage2 calls the LLVM C API. A C-route Stage1 is itself
# linked with libLLVM and hands its location to the Stage2 link; this Stage1 is
# not, so the selected library is passed explicitly, by its resolved path (the
# same path the C route records, so both routes give identical Stage2 bytes).
set(SULTANC_STAGE1_LINK_INPUTS "")
if(SULTANC_COMPILER_LLVM)
    if(WIN32)
        message(FATAL_ERROR "SULTANC_BOOTSTRAP=wasm cannot build an LLVM-enabled Windows Stage2: "
                            "the Windows Stage2 is generated by the LLVM backend, which the seed's "
                            "Native-only Stage1 lacks. ${_sultanc_windows_stage2_help}")
    endif()
    get_filename_component(_sultanc_llvm_real "${SULTANC_LLVM_LIBRARY}" REALPATH)
    set(SULTANC_STAGE1_LINK_INPUTS "${_sultanc_llvm_real}")
endif()

# The seed is reproducible from the sources: the newest compiler this build
# can run rebuilds it, and it must equal the committed seed byte for byte.
# Stage2 when it runs on this host; otherwise (and for stage1/bootstrap
# builds, e.g. on Windows, which has no Native backend) Stage1 itself, the
# translated seed, which gives the same module when the seed is current.
# Called by CMakeLists.txt after Stage2.cmake defines SULTANC_STAGE2_OUTPUT.
function(sultanc_wasm_add_seed_check)
    set(_seed "${SULTANC_BINARY_OUTPUT_DIRECTORY}/seed/sultanc.wasm")
    if(SULTANC_WASM_STAGE1_ONLY OR NOT SULTANC_HOST_TARGET OR
       NOT SULTANC_STAGE2_TARGET STREQUAL SULTANC_HOST_TARGET)
        set(_producer "$<TARGET_FILE:sultanc-stage1-executable>")
        set(_producer_dep sultanc-stage1-executable)
        set(_comment "Stage1 rebuilds the WebAssembly seed")
    else()
        set(_producer "${SULTANC_STAGE2_OUTPUT}")
        set(_producer_dep "${SULTANC_STAGE2_OUTPUT}")
        set(_comment "Stage2 rebuilds the WebAssembly seed")
    endif()
    add_custom_command(OUTPUT "${_seed}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${SULTANC_BINARY_OUTPUT_DIRECTORY}/seed"
        COMMAND "${_producer}" --backend=native --target=wasm32-wasi --emit=exe
            "--module-source=compiler.backend.provider.llvm.llvm_codegen=compiler/backend/provider/llvm/unavailable.sn"
            -o "${_seed}" compiler/main.sn
        DEPENDS ${_producer_dep} ${SULTANC_COMPILER_SOURCES}
        WORKING_DIRECTORY "${SULTANC_SOURCE_ROOT}"
        COMMENT "${_comment}"
        VERBATIM)
    add_custom_target(sultanc-check-seed
        COMMAND "${CMAKE_COMMAND}" "-DWASM2C=${SULTANC_WASM2C_COMMAND}" "-DSEED=${_seed}"
            "-DCOMMITTED=${SULTANC_SOURCE_ROOT}/bootstrap-wasm/seed/sultanc.wasm.zst"
            "-DDECODED=${SULTANC_BINARY_OUTPUT_DIRECTORY}/seed/sultanc.committed.wasm"
            -P "${SULTANC_SOURCE_ROOT}/cmake/scripts/CheckSeed.cmake"
        DEPENDS "${_seed}" ${SULTANC_WASM2C_DEPENDS}
        VERBATIM)
endfunction()
