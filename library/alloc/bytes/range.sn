// التحقق من الحدود في الأساس (الأساس.بايتات.نطاق)، ويعاد تصديره هنا بالمسار نفسه.
استورد الأساس.بايتات.نطاق مثل نطاق_الأساس;
عام مرادف متاح_في_البايتات = نطاق_الأساس.متاح_في_البايتات;
عام مرادف byte_range_available = نطاق_الأساس.byte_range_available;

// ينسخ نطاق بايتات صالحا إلى متجه مستقل؛ النطاق غير الصالح لا يُقص أو يُمدد ضمنيا.
عام عرف انسخ_نطاق_بايتات(
    القيمة: &متجه ط8,
    الموضع: طبيعي,
    العدد: طبيعي
): اختياري متجه ط8 {
    إذا (!متاح_في_البايتات(القيمة, الموضع, العدد)) {
        أرجع اختياري.لا_شيء();
    };

    ليكن الناتج: متغير متجه ط8 = [];
    ليكن الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        ليكن موضع_الحالي: طبيعي = الموضع + الفهرس;
        ألحق(الناتج, (*القيمة)[موضع_الحالي]);
        الفهرس := الفهرس + 1;
    }

    أرجع اختياري.موجود(الناتج);
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف copy_byte_range = انسخ_نطاق_بايتات;
