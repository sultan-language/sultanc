استورد يونيكود.بيانات.تقطيع;
استورد يونيكود.خوارزميات.بحث;
استورد يونيكود.خوارزميات.إزاحات_النص;

// The boundary test needs no heap and is core's (core.unicode.word_boundary),
// re-exported here at the same path.
استورد الأساس.يونيكود.حدود_الكلمات مثل حدود_الكلمات_الأساس;
عام مرادف حد_كلمة_يونيكود = حدود_الكلمات_الأساس.حد_كلمة_يونيكود;

عام عرف حدود_كلمات_يونيكود(الرموز: &متجه ط32): متجه طبيعي {
    ليكن الناتج: متغير متجه طبيعي = [];
    ليكن موضع: متغير طبيعي = 0;
    طالما (موضع <= (الطول(*الرموز) مثل طبيعي)) {
        طابق حد_كلمة_يونيكود(الرموز, موضع) مع
        | اختياري.موجود(النتيجة) -> { إذا (النتيجة) { ألحق(الناتج, موضع); }; }
        | _ -> { };
        موضع := موضع + 1;
    }
    أرجع الناتج;
}

عام عرف حدود_كلمات_بايتات_يونيكود(النص: &نص): نتيجة متجه طبيعي, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        ليكن الحدود: متجه طبيعي = حدود_كلمات_يونيكود(&المراجع.القيم);
        أرجع نتيجة.نجح(حدود_بايتات_من_سلالم(&المراجع, &الحدود));
    };
}

عام مرادف unicode_word_boundaries = حدود_كلمات_يونيكود;
