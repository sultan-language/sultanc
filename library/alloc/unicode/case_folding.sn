استورد يونيكود.خوارزميات.إزاحات_النص;
استورد يونيكود.خوارزميات.بحث;
استورد يونيكود.بيانات.طي_الحالة;

// Simple case folding needs no heap and is core's (core.unicode.case_folding),
// re-exported here at the same path.
استورد الأساس.يونيكود.طي_الحالة مثل طي_الحالة_الأساس;
عام مرادف طي_حالة_بسيط_يونيكود = طي_الحالة_الأساس.طي_حالة_بسيط_يونيكود;

عام عرف طي_حالة_الأحرف_يونيكود(القيمة: ط32): متجه ط32 {
    أرجع تسلسل_تحويل_يونيكود(القيمة, &طي_حالة_كامل_مفاتيح,
        &طي_حالة_كامل_بدايات, &طي_حالة_كامل_أطوال, &طي_حالة_كامل_قيم);
}
عام عرف طي_حالة_نص_يونيكود(النص: &نص): نتيجة نص, خطأ_تحويل_يونيكود {
    طابق فك_نص_إلى_سلالم_يونيكود(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المراجع) -> {
        ليكن الناتج: متغير متجه ط32 = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المراجع.القيم) مثل طبيعي)) {
            ليكن المطابقة: متجه ط32 = طي_حالة_الأحرف_يونيكود(المراجع.القيم[ف]);
            ليكن ج: متغير طبيعي = 0;
            طالما (ج < (الطول(المطابقة) مثل طبيعي)) {
                ألحق(الناتج, المطابقة[ج]);
                ج := ج + 1;
            }
            ف := ف + 1;
        }
        أرجع حول_سلالم_إلى_نص_يونيكود(&الناتج);
    };
}

// English names (declared with their Arabic declarations: an alias names
// a declaration of its own module).
عام مرادف unicode_case_fold = طي_حالة_الأحرف_يونيكود;
