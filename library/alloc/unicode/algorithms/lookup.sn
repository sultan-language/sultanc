// Single sorted-table lookup owner for Unicode 18 data. The scalar and flag
// lookups (sorted inclusive triples (first, last, value), and properties sorted
// (property ID, first, last)) need no heap and are core's
// (core.unicode.algorithms.lookup), re-exported here at the same path.
استورد الأساس.يونيكود.خوارزميات.بحث مثل بحث_الأساس;
عام مرادف قيمة_نطاق_مرتب = بحث_الأساس.قيمة_نطاق_مرتب;
عام مرادف خاصية_نطاق_مرتبة = بحث_الأساس.خاصية_نطاق_مرتبة;
عام مرادف محرف_تحويل_بسيط_يونيكود = بحث_الأساس.محرف_تحويل_بسيط_يونيكود;

// Mapping keys are sorted; offsets and lengths index one shared scalar pool.
عام عرف تسلسل_تحويل_يونيكود(
    القيمة: ط32,
    المفاتيح: &متجه ط32,
    البدايات: &متجه ط32,
    الأطوال: &متجه ط32,
    القيم: &متجه ط32
): متجه ط32 {
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = الطول(*المفاتيح) مثل طبيعي;
    طالما (البداية < النهاية) {
        ليكن الوسط: طبيعي = البداية + (النهاية - البداية) / 2;
        إذا ((*المفاتيح)[الوسط] < القيمة) {
            البداية := الوسط + 1;
        } وإلا {
            النهاية := الوسط;
        };
    }
    ليكن الناتج: متغير متجه ط32 = [];
    إذا (البداية < (الطول(*المفاتيح) مثل طبيعي) && (*المفاتيح)[البداية] == القيمة) {
        ليكن موضع: متغير طبيعي = (*البدايات)[البداية] مثل طبيعي;
        ليكن النهاية_الفعلية: طبيعي = موضع + ((*الأطوال)[البداية] مثل طبيعي);
        طالما (موضع < النهاية_الفعلية) {
            ألحق(الناتج, (*القيم)[موضع]);
            موضع := موضع + 1;
        }
    } وإلا {
        ألحق(الناتج, القيمة);
    };
    أرجع الناتج;
}
