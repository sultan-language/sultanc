استورد حروف.أسكي;
استورد نصوص.باني;
استورد وقت.تقويم;

// The value, its checks and the parsers need no heap and are core's
// (core.time.date), re-exported here at the same path; the formatters build
// text and are alloc's.
استورد الأساس.وقت.تاريخ مثل تاريخ_الأساس;
عام مرادف خطأ_تاريخ = تاريخ_الأساس.خطأ_تاريخ;
عام مرادف تاريخ_ووقت = تاريخ_الأساس.تاريخ_ووقت;
عام مرادف تاريخ_ووقت_صالح = تاريخ_الأساس.تاريخ_ووقت_صالح;
عام مرادف أنشئ_تاريخا_ووقتا = تاريخ_الأساس.أنشئ_تاريخا_ووقتا;
عام مرادف أنشئ_تاريخا_ووقتا_بإزاحة_مجهولة = تاريخ_الأساس.أنشئ_تاريخا_ووقتا_بإزاحة_مجهولة;
عام مرادف حلل_تاريخ_آيزو = تاريخ_الأساس.حلل_تاريخ_آيزو;
عام مرادف حلل_آر_إف_سي3339 = تاريخ_الأساس.حلل_آر_إف_سي3339;
عام مرادف ثواني_يونكس_من_تاريخ = تاريخ_الأساس.ثواني_يونكس_من_تاريخ;
عام مرادف تاريخ_من_ثواني_يونكس = تاريخ_الأساس.تاريخ_من_ثواني_يونكس;
عام مرادف حلل_تاريخ_ويب_القياسي = تاريخ_الأساس.حلل_تاريخ_ويب_القياسي;
عام مرادف date_time = تاريخ_الأساس.date_time;
عام مرادف date_error = تاريخ_الأساس.date_error;
عام مرادف date_time_is_valid = تاريخ_الأساس.date_time_is_valid;
عام مرادف new_date_time = تاريخ_الأساس.new_date_time;
عام مرادف new_date_time_unknown_offset = تاريخ_الأساس.new_date_time_unknown_offset;
عام مرادف parse_iso_date = تاريخ_الأساس.parse_iso_date;
عام مرادف parse_rfc3339 = تاريخ_الأساس.parse_rfc3339;
عام مرادف unix_seconds_from_date_time = تاريخ_الأساس.unix_seconds_from_date_time;
عام مرادف date_time_from_unix_seconds = تاريخ_الأساس.date_time_from_unix_seconds;
عام مرادف parse_imf_fixdate = تاريخ_الأساس.parse_imf_fixdate;

عرف ألحق_رقما_بباني_التاريخ(الباني: &متغير باني_نص, الرقم: طبيعي): فراغ {
    دع المحرف: حرف = (((0x30 مثل طبيعي) + الرقم) مثل ط8) مثل حرف;
    دع أضيف: منطقي = ألحق_محرفا_بباني_النص(الباني, المحرف);
}

عرف ألحق_رقمين_بباني_التاريخ(الباني: &متغير باني_نص, القيمة: طبيعي): فراغ {
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 10) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, القيمة % 10);
}

عرف ألحق_أربعة_أرقام_بباني_التاريخ(الباني: &متغير باني_نص, القيمة: طبيعي): فراغ {
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 1000) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 100) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 10) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, القيمة % 10);
}

عام عرف نسق_تاريخ_آيزو(التاريخ: &تاريخ_تقويمي): اختياري نص {
    إذا (!تاريخ_تقويمي_صالح(التاريخ)) { أرجع اختياري.لا_شيء(); };
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(10);
    ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, (*التاريخ).السنة مثل طبيعي);
    دع شرطة: نص = «-»;
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*التاريخ).الشهر);
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*التاريخ).اليوم);
    أرجع اختياري.موجود(نص_باني_النص(&الباني));
}

عام عرف نسق_آر_إف_سي3339(القيمة: &تاريخ_ووقت): اختياري نص {
    إذا (!تاريخ_ووقت_صالح(القيمة)) { أرجع اختياري.لا_شيء(); };
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(32);
    ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.السنة مثل طبيعي);
    دع شرطة: نص = «-»;
    دع نقطتان: نص = «:»;
    دع حرف_ت: نص = «T»;
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.الشهر);
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.اليوم);
    ألحق_نصا_بباني_النص(&متغير الباني, &حرف_ت);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الساعة);
    ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الدقيقة);
    ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الثانية);

    إذا ((*القيمة).النانوثانية != 0) {
        دع نقطة: نص = «.»;
        ألحق_نصا_بباني_النص(&متغير الباني, &نقطة);
        دع العرض: متغير طبيعي = 9;
        دع المختصر: متغير طبيعي = (*القيمة).النانوثانية;
        طالما ((العرض > 1) && ((المختصر % 10) == 0)) {
            العرض := العرض - 1;
            المختصر := المختصر / 10;
        }
        دع ف: متغير طبيعي = 0;
        دع القاسم: متغير طبيعي = 100000000;
        طالما (ف < العرض) {
            دع الرقم: طبيعي = ((*القيمة).النانوثانية / القاسم) % 10;
            ألحق_رقما_بباني_التاريخ(&متغير الباني, الرقم);
            القاسم := القاسم / 10;
            ف := ف + 1;
        }
    };

    إذا (!(*القيمة).الإزاحة_معلومة) {
        دع مجهولة: نص = «-00:00»;
        ألحق_نصا_بباني_النص(&متغير الباني, &مجهولة);
    } وإلا إذا ((*القيمة).إزاحة_دقائق == 0) {
        دع ز: نص = «Z»;
        ألحق_نصا_بباني_النص(&متغير الباني, &ز);
    } وإلا {
        دع الإزاحة: متغير عدد = (*القيمة).إزاحة_دقائق;
        إذا (الإزاحة < 0) {
            دع ناقص: نص = «-»;
            ألحق_نصا_بباني_النص(&متغير الباني, &ناقص);
            الإزاحة := 0 - الإزاحة;
        } وإلا {
            دع زائد: نص = «+»;
            ألحق_نصا_بباني_النص(&متغير الباني, &زائد);
        };
        ألحق_رقمين_بباني_التاريخ(&متغير الباني, (الإزاحة / 60) مثل طبيعي);
        ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
        ألحق_رقمين_بباني_التاريخ(&متغير الباني, (الإزاحة % 60) مثل طبيعي);
    };
    أرجع اختياري.موجود(نص_باني_النص(&الباني));
}

عرف اسم_شهر_ويب(الشهر: طبيعي): اختياري نص {
    إذا (الشهر == 1) { أرجع اختياري.موجود(«Jan»); };
    إذا (الشهر == 2) { أرجع اختياري.موجود(«Feb»); };
    إذا (الشهر == 3) { أرجع اختياري.موجود(«Mar»); };
    إذا (الشهر == 4) { أرجع اختياري.موجود(«Apr»); };
    إذا (الشهر == 5) { أرجع اختياري.موجود(«May»); };
    إذا (الشهر == 6) { أرجع اختياري.موجود(«Jun»); };
    إذا (الشهر == 7) { أرجع اختياري.موجود(«Jul»); };
    إذا (الشهر == 8) { أرجع اختياري.موجود(«Aug»); };
    إذا (الشهر == 9) { أرجع اختياري.موجود(«Sep»); };
    إذا (الشهر == 10) { أرجع اختياري.موجود(«Oct»); };
    إذا (الشهر == 11) { أرجع اختياري.موجود(«Nov»); };
    إذا (الشهر == 12) { أرجع اختياري.موجود(«Dec»); };
    أرجع اختياري.لا_شيء();
}

عرف اسم_يوم_ويب(اليوم: يوم_الأسبوع): نص {
    طابق اليوم مع
    | يوم_الأسبوع.الأحد -> { أرجع «Sun»; }
    | يوم_الأسبوع.الاثنين -> { أرجع «Mon»; }
    | يوم_الأسبوع.الثلاثاء -> { أرجع «Tue»; }
    | يوم_الأسبوع.الأربعاء -> { أرجع «Wed»; }
    | يوم_الأسبوع.الخميس -> { أرجع «Thu»; }
    | يوم_الأسبوع.الجمعة -> { أرجع «Fri»; }
    | يوم_الأسبوع.السبت -> { أرجع «Sat»; };
}

عام عرف نسق_تاريخ_ويب(القيمة: &تاريخ_ووقت): اختياري نص {
    إذا (!تاريخ_ووقت_صالح(القيمة)) { أرجع اختياري.لا_شيء(); };
    إذا (!(*القيمة).الإزاحة_معلومة) { أرجع اختياري.لا_شيء(); };
    دع يو_تي_سي: متغير تاريخ_ووقت = *القيمة;
    إذا ((*القيمة).إزاحة_دقائق != 0) {
        طابق ثواني_يونكس_من_تاريخ(القيمة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الثواني) -> {
            طابق تاريخ_من_ثواني_يونكس(الثواني, 0) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(المحول) -> { يو_تي_سي := المحول; };
        };
    };
    طابق يوم_الأسبوع_للتاريخ(&يو_تي_سي.التاريخ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(يوم_الأسبوع) -> {
        طابق اسم_شهر_ويب(يو_تي_سي.التاريخ.الشهر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الشهر) -> {
            دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(29);
            دع اسم_اليوم: نص = اسم_يوم_ويب(يوم_الأسبوع);
            دع فاصلة_وفراغ: نص = «, »;
            دع مسافة: نص = « »;
            دع نقطتان: نص = «:»;
            دع غمت: نص = « GMT»;
            ألحق_نصا_بباني_النص(&متغير الباني, &اسم_اليوم);
            ألحق_نصا_بباني_النص(&متغير الباني, &فاصلة_وفراغ);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.التاريخ.اليوم);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_نصا_بباني_النص(&متغير الباني, &الشهر);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, يو_تي_سي.التاريخ.السنة مثل طبيعي);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الساعة);
            ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الدقيقة);
            ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الثانية);
            ألحق_نصا_بباني_النص(&متغير الباني, &غمت);
            أرجع اختياري.موجود(نص_باني_النص(&الباني));
        };
    };
}

عام مرادف format_iso_date = نسق_تاريخ_آيزو;
عام مرادف format_rfc3339 = نسق_آر_إف_سي3339;
عام مرادف format_http_date = نسق_تاريخ_ويب;
