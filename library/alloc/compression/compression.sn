// The root file of library/alloc/compression: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). The
// standard library is three libraries (docs/en/reference/std-layers.md); this
// file names only this library's own children.

module deflate { ar: ديفليت };
module gzip { ar: جي_زيب };
module lzma { ar: إل_زد_إم_إيه };
module xz { ar: إكس_زد };
module zstd { ar: زد_ستد };
