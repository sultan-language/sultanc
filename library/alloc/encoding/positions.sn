استورد ترميز.يوتيف8;

// The positions in borrowed text need no heap and are core's
// (core.encoding.positions), re-exported here at the same path; the line index
// owns a vector and is alloc's.
استورد الأساس.ترميز.مواضع مثل مواضع_الأساس;
عام مرادف خطأ_موضع_يونيكود = مواضع_الأساس.خطأ_موضع_يونيكود;
عام مرادف تحقق_يوتيف8 = مواضع_الأساس.تحقق_يوتيف8;
عام مرادف إزاحة_بايت_إلى_موضع_محرف = مواضع_الأساس.إزاحة_بايت_إلى_موضع_محرف;
عام مرادف موضع_محرف_إلى_إزاحة_بايت = مواضع_الأساس.موضع_محرف_إلى_إزاحة_بايت;
عام مرادف هل_نهاية_سطر_عند = مواضع_الأساس.هل_نهاية_سطر_عند;
عام مرادف إزاحة_بايت_إلى_عمود_يوتيف16 = مواضع_الأساس.إزاحة_بايت_إلى_عمود_يوتيف16;
عام مرادف عمود_يوتيف16_إلى_إزاحة_بايت = مواضع_الأساس.عمود_يوتيف16_إلى_إزاحة_بايت;
عام مرادف unicode_position_error = مواضع_الأساس.unicode_position_error;
عام مرادف validate_utf8 = مواضع_الأساس.validate_utf8;
عام مرادف utf8_byte_offset_to_codepoint_index = مواضع_الأساس.utf8_byte_offset_to_codepoint_index;
عام مرادف utf8_codepoint_index_to_byte_offset = مواضع_الأساس.utf8_codepoint_index_to_byte_offset;
عام مرادف utf8_byte_offset_to_utf16_column = مواضع_الأساس.utf8_byte_offset_to_utf16_column;
عام مرادف utf16_column_to_utf8_byte_offset = مواضع_الأساس.utf16_column_to_utf8_byte_offset;

عام نوع فهرس_سطور = {
    البدايات: متجه طبيعي,
    طول_النص: طبيعي
};

عام نوع موضع_نصي_يوتيف16 = {
    السطر: طبيعي,
    العمود: طبيعي
};

عام عرف ابن_فهرس_السطور(النص: &نص): فهرس_سطور {
    ليكن البدايات: متغير متجه طبيعي = [];
    ألحق(البدايات, 0);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        إذا (هل_نهاية_سطر_عند(النص, ف)) { ألحق(البدايات, ف + 1); };
        ف := ف + 1;
    }
    ليكن طول_النص: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن الناتج: فهرس_سطور = { البدايات: البدايات, طول_النص: طول_النص };
    أرجع الناتج;
}

عام عرف بداية_السطر(الفهرس: &فهرس_سطور, السطر: طبيعي): اختياري طبيعي {
    ليكن القيمة: فهرس_سطور = *الفهرس;
    إذا (السطر >= (الطول(القيمة.البدايات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(القيمة.البدايات[السطر]);
}

عام عرف سطر_الإزاحة(الفهرس: &فهرس_سطور, الإزاحة: طبيعي): اختياري طبيعي {
    ليكن القيمة: فهرس_سطور = *الفهرس;
    إذا (الإزاحة > القيمة.طول_النص) { أرجع اختياري.لا_شيء(); };
    ليكن العدد: طبيعي = الطول(القيمة.البدايات) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = العدد;
    طالما ((البداية + 1) < النهاية) {
        ليكن الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        إذا (القيمة.البدايات[الوسط] <= الإزاحة) {
            البداية := الوسط;
        } وإلا {
            النهاية := الوسط;
        };
    }
    أرجع اختياري.موجود(البداية);
}

عام عرف إزاحة_بايت_إلى_موضع_نصي_يوتيف16(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الإزاحة: طبيعي
): نتيجة موضع_نصي_يوتيف16, خطأ_موضع_يونيكود {
    إذا ((*الفهرس).طول_النص != (الطول(*النص) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق());
    };
    ليكن السطر: متغير طبيعي = 0;
    طابق سطر_الإزاحة(الفهرس, الإزاحة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(القيمة) -> { السطر := القيمة; };
    ليكن البداية: متغير طبيعي = 0;
    طابق بداية_السطر(الفهرس, السطر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(القيمة) -> { البداية := القيمة; };
    طابق إزاحة_بايت_إلى_عمود_يوتيف16(النص, البداية, الإزاحة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العمود) -> {
        ليكن الموضع: موضع_نصي_يوتيف16 = { السطر: السطر, العمود: العمود };
        أرجع نتيجة.نجح(الموضع);
    };
}

عام عرف موضع_نصي_يوتيف16_إلى_إزاحة_بايت(
    النص: &نص,
    الفهرس: &فهرس_سطور,
    الموضع: &موضع_نصي_يوتيف16
): نتيجة طبيعي, خطأ_موضع_يونيكود {
    إذا ((*الفهرس).طول_النص != (الطول(*النص) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق());
    };
    ليكن القيمة: موضع_نصي_يوتيف16 = *الموضع;
    طابق بداية_السطر(الفهرس, القيمة.السطر) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_موضع_يونيكود.إزاحة_خارج_النطاق()); }
    | اختياري.موجود(البداية) -> {
        أرجع عمود_يوتيف16_إلى_إزاحة_بايت(النص, البداية, القيمة.العمود);
    };
}

عام مرادف line_index = فهرس_سطور;
عام مرادف utf16_text_position = موضع_نصي_يوتيف16;
عام مرادف utf8_byte_offset_to_utf16_position = إزاحة_بايت_إلى_موضع_نصي_يوتيف16;
عام مرادف utf16_position_to_utf8_byte_offset = موضع_نصي_يوتيف16_إلى_إزاحة_بايت;
عام مرادف build_line_index = ابن_فهرس_السطور;
عام مرادف line_start = بداية_السطر;
عام مرادف line_for_offset = سطر_الإزاحة;
