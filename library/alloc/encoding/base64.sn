استورد نصوص.من_بايتات;

عام نوع خطأ_قاعدة64 =
    | طول_غير_صالح
    | محرف_غير_صالح بنوع طبيعي
    | حشو_غير_صالح بنوع طبيعي
;

عرف محرف_قاعدة64(القيمة: طبيعي): ط8 {
    إذا (القيمة < 26) { أرجع (0x41 + القيمة) مثل ط8; };
    إذا (القيمة < 52) { أرجع (0x61 + القيمة - 26) مثل ط8; };
    إذا (القيمة < 62) { أرجع (0x30 + القيمة - 52) مثل ط8; };
    إذا (القيمة == 62) { أرجع 0x2B; };
    أرجع 0x2F;
}

عرف قيمة_قاعدة64(البايت: ط8): عدد {
    إذا ((البايت >= 0x41) && (البايت <= 0x5A)) { أرجع (البايت - 0x41) مثل عدد; };
    إذا ((البايت >= 0x61) && (البايت <= 0x7A)) { أرجع ((البايت - 0x61) + 26) مثل عدد; };
    إذا ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع ((البايت - 0x30) + 52) مثل عدد; };
    إذا (البايت == 0x2B) { أرجع 62; };
    إذا (البايت == 0x2F) { أرجع 63; };
    أرجع -1;
}

عام عرف رمز_قاعدة64(البايتات: &متجه ط8): نص {
    ليكن المصدر: متجه ط8 = *البايتات;
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما ((العدد - ف) >= 3) {
        ليكن ف1: طبيعي = ف + 1;
        ليكن ف2: طبيعي = ف + 2;
        ليكن أ: طبيعي = المصدر[ف] مثل طبيعي;
        ليكن ب: طبيعي = المصدر[ف1] مثل طبيعي;
        ليكن ج: طبيعي = المصدر[ف2] مثل طبيعي;
        ليكن القيمة: متغير طبيعي = أ << 16;
        القيمة := القيمة | (ب << 8);
        القيمة := القيمة | ج;
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 6) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64(القيمة & 0x3F));
        ف := ف + 3;
    }
    ليكن الباقي: طبيعي = العدد - ف;
    إذا (الباقي == 1) {
        ليكن أ: طبيعي = المصدر[ف] مثل طبيعي;
        ليكن القيمة: طبيعي = أ << 16;
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق_بايتات_نص(&متغير الناتج, «==»);
    } وإلا إذا (الباقي == 2) {
        ليكن ف1: طبيعي = ف + 1;
        ليكن أ: طبيعي = المصدر[ف] مثل طبيعي;
        ليكن ب: طبيعي = المصدر[ف1] مثل طبيعي;
        ليكن القيمة: متغير طبيعي = أ << 16;
        القيمة := القيمة | (ب << 8);
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 18) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 12) & 0x3F));
        ألحق(الناتج, محرف_قاعدة64((القيمة >> 6) & 0x3F));
        ألحق(الناتج, 0x3D);
    };
    أرجع من_بايتات(&الناتج);
}

عرف قيمة_قاعدة64_أو_خطأ(المصدر: &نص, الموضع: طبيعي): نتيجة طبيعي, خطأ_قاعدة64 {
    ليكن النص: نص = *المصدر;
    ليكن القيمة: عدد = قيمة_قاعدة64(النص[الموضع]);
    إذا (القيمة < 0) { أرجع نتيجة.خطأ(خطأ_قاعدة64.محرف_غير_صالح(الموضع)); };
    أرجع نتيجة.نجح(القيمة مثل طبيعي);
}

عام عرف فك_قاعدة64(النص: &نص): نتيجة متجه ط8, خطأ_قاعدة64 {
    ليكن المصدر: نص = *النص;
    ليكن العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    إذا ((العدد % 4) != 0) { أرجع نتيجة.خطأ(خطأ_قاعدة64.طول_غير_صالح()); };
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ف1: طبيعي = ف + 1;
        ليكن ف2: طبيعي = ف + 2;
        ليكن ف3: طبيعي = ف + 3;
        ليكن ف4: طبيعي = ف + 4;
        ليكن الأخير: منطقي = ف4 == العدد;
        إذا ((المصدر[ف] == 0x3D) || (المصدر[ف1] == 0x3D)) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف));
        };
        ليكن أ: طبيعي;
        ليكن ب: طبيعي;
        طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { أ := القيمة; };
        طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف1) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { ب := القيمة; };

        ليكن الثالث_حشو: منطقي = المصدر[ف2] == 0x3D;
        ليكن الرابع_حشو: منطقي = المصدر[ف3] == 0x3D;
        إذا ((الثالث_حشو || الرابع_حشو) && !الأخير) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2));
        };
        إذا (الثالث_حشو && !الرابع_حشو) {
            أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2));
        };

        ليكن ج: متغير طبيعي = 0;
        ليكن د: متغير طبيعي = 0;
        إذا (!الثالث_حشو) {
            طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف2) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { ج := القيمة; };
        };
        إذا (!الرابع_حشو) {
            طابق قيمة_قاعدة64_أو_خطأ(&المصدر, ف3) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { د := القيمة; };
        };

        ليكن القيمة: متغير طبيعي = أ << 18;
        القيمة := القيمة | (ب << 12);
        القيمة := القيمة | (ج << 6);
        القيمة := القيمة | د;
        ألحق(الناتج, ((القيمة >> 16) & 0xFF) مثل ط8);
        إذا (!الثالث_حشو) { ألحق(الناتج, ((القيمة >> 8) & 0xFF) مثل ط8); };
        إذا (!الرابع_حشو) { ألحق(الناتج, (القيمة & 0xFF) مثل ط8); };

        // الحشو القانوني يجب أن يحمل بتات صفرية في الجزء غير المستخدم.
        إذا (الثالث_حشو && ((ب & 0x0F) != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف1)); };
        إذا (الرابع_حشو && !الثالث_حشو && ((ج & 0x03) != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف2)); };
        ف := ف + 4;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام مرادف base64_error = خطأ_قاعدة64;
عام مرادف base64_encode = رمز_قاعدة64;
عام مرادف base64_decode = فك_قاعدة64;
عام مرادف base64_error.invalid_length = خطأ_قاعدة64.طول_غير_صالح;
عام مرادف base64_error.invalid_character = خطأ_قاعدة64.محرف_غير_صالح;
عام مرادف base64_error.invalid_padding = خطأ_قاعدة64.حشو_غير_صالح;

// RFC 4648 base64url. Encoding omits padding; decoding accepts canonical
// padded or unpadded base64url and rejects the ordinary '+'/'/' alphabet.
عام عرف رمز_قاعدة64_عنوانية(البايتات: &متجه ط8): نص {
    ليكن العادي: نص = رمز_قاعدة64(البايتات);
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العادي) مثل طبيعي)) {
        ليكن ب: ط8 = العادي[ف];
        إذا (ب == 0x3D) { ف := الطول(العادي) مثل طبيعي; }
        وإلا {
            إذا (ب == 0x2B) { ألحق(الناتج, 0x2D); }
            وإلا إذا (ب == 0x2F) { ألحق(الناتج, 0x5F); }
            وإلا { ألحق(الناتج, ب); };
            ف := ف + 1;
        };
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف فك_قاعدة64_عنوانية(النص: &نص): نتيجة متجه ط8, خطأ_قاعدة64 {
    ليكن المصدر: نص = *النص;
    ليكن العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    ليكن الباقي: طبيعي = العدد % 4;
    إذا (الباقي == 1) { أرجع نتيجة.خطأ(خطأ_قاعدة64.طول_غير_صالح()); };
    ليكن العادي_بايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ب: ط8 = المصدر[ف];
        إذا ((ب == 0x2B) || (ب == 0x2F)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.محرف_غير_صالح(ف)); };
        إذا ((ب == 0x3D) && (الباقي != 0)) { أرجع نتيجة.خطأ(خطأ_قاعدة64.حشو_غير_صالح(ف)); };
        إذا (ب == 0x2D) { ألحق(العادي_بايتات, 0x2B); }
        وإلا إذا (ب == 0x5F) { ألحق(العادي_بايتات, 0x2F); }
        وإلا { ألحق(العادي_بايتات, ب); };
        ف := ف + 1;
    }
    إذا (الباقي == 2) { ألحق_بايتات_نص(&متغير العادي_بايتات, «==»); }
    وإلا إذا (الباقي == 3) { ألحق(العادي_بايتات, 0x3D); };
    ليكن العادي: نص = من_بايتات(&العادي_بايتات);
    أرجع فك_قاعدة64(&العادي);
}

عام مرادف base64url_encode = رمز_قاعدة64_عنوانية;
عام مرادف base64url_decode = فك_قاعدة64_عنوانية;
