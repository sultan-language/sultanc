عام عرف اكتب_ع64_بالبايت_الأقل_أهمية_أولا(ن: &متغير متجه ط8, ق: عدد): فراغ { طابق خام_عدد_موقع(ق, 64) مع | اختياري.موجود(خ) -> { اكتب_ط64_بالبايت_الأقل_أهمية_أولا(ن, خ); } | _ -> { }; }
عام عرف اكتب_ع64_بالبايت_الأكثر_أهمية_أولا(ن: &متغير متجه ط8, ق: عدد): فراغ { طابق خام_عدد_موقع(ق, 64) مع | اختياري.موجود(خ) -> { اكتب_ط64_بالبايت_الأكثر_أهمية_أولا(ن, خ); } | _ -> { }; }

