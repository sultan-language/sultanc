// Fixed-width integer encoding with explicit endianness. The reads and the
// writes in place need no heap and are core's (core.encoding.binary),
// re-exported here at the same path; the writes that append are alloc's.
استورد الأساس.ترميز.ثنائي مثل ثنائي_الأساس;

