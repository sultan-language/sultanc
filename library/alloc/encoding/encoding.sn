// The root file of library/alloc/encoding: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). The
// standard library is three libraries (docs/en/reference/std-layers.md); this
// file names only this library's own children.

module base32 { ar: قاعدة32 };
module base64 { ar: قاعدة64 };
module binary { ar: ثنائي };
module der { ar: دي_إي_آر };
module hex { ar: سداسي };
module pem { ar: بي_إي_إم };
module positions { ar: مواضع };
module utf16 { ar: يوتيف16 };
module utf8 { ar: يوتيف8 };
module varint { ar: فارنت };
