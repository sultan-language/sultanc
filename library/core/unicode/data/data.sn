// The root file of library/core/unicode/data: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). The
// standard library is three libraries (docs/en/reference/std-layers.md); this
// file names only this library's own children.

module case_folding { ar: طي_الحالة };
module case_mapping { ar: تحويل_الحالة };
module categories { ar: فئات };
module normalization { ar: تطبيع };
module properties { ar: خصائص };
module segmentation { ar: تقطيع };
module version { ar: إصدار };
