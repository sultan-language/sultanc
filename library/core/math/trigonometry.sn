استورد رياضيات.عشري;

// Sine, cosine and tangent of a binary32 angle in radians, in SultanC
// arithmetic (no libm): Cephes sinf/cosf/tanf with float32 coefficients and a
// three-part pi/4; the result keeps float32 accuracy for |x| up to 8192 (as
// Cephes) and degrades gracefully above. No heap, so core. The binary64 forms
// reduce with Payne-Hanek over vectors and are alloc's
// (alloc.math.trigonometry), which re-exports these at the same path.

// binary32 (Cephes sinf.c, cosf.c, tanf.c).
نوع مختزل_مثلثي32 = { الثمن: ط64, الزاوية: ع32 };

عرف اختزل32(س: ع32): مختزل_مثلثي32 {
    ليكن ي: متغير ع32 = بتر32(س * 1.27323954473516);
    إذا (باقي32(ي, 2.0) == 1.0) { ي := ي + 1.0; };
    ليكن الثمن_عائم: متغير ع32 = باقي32(ي, 8.0);
    ليكن ز: ع32 = ((س - ي * 0.78515625) - ي * 2.4187564849853515625e-4) - ي * 3.77489497744594108e-8;
    ليكن الثمن: متغير ط64 = 0;
    طالما (الثمن_عائم >= 1.0) { الثمن := الثمن + 1; الثمن_عائم := الثمن_عائم - 1.0; }
    ليكن الناتج: مختزل_مثلثي32 = { الثمن: الثمن, الزاوية: ز };
    أرجع الناتج;
}

عرف كثيرة_جيب32(ز: ع32, زز: ع32): ع32 {
    أرجع ((-1.9515295891e-4 * زز + 8.3321608736e-3) * زز - 1.6666654611e-1) * زز * ز + ز;
}

عرف كثيرة_جيب_تمام32(زز: ع32): ع32 {
    أرجع ((2.443315711809948e-5 * زز - 1.388731625493765e-3) * زز + 4.166664568298827e-2) * زز * زز - 0.5 * زز + 1.0;
}

عام عرف جيب32(القيمة: ع32): ع32 {
    إذا (القيمة == 0.0 || ليس_رقما32(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية32(القيمة)) { ليكن الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    ليكن سالب: متغير منطقي = القيمة < 0.0;
    ليكن المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    ليكن الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    ليكن ز: ع32 = المختزل.الزاوية;
    ليكن زز: ع32 = ز * ز;
    ليكن الناتج: متغير ع32 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب_تمام32(زز); }
    وإلا { الناتج := كثيرة_جيب32(ز, زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف جيب_تمام32(القيمة: ع32): ع32 {
    إذا (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة)) { ليكن الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    ليكن سالب: متغير منطقي = خطأ;
    ليكن المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    ليكن الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    إذا (الثمن > 1) { سالب := !سالب; };
    ليكن ز: ع32 = المختزل.الزاوية;
    ليكن زز: ع32 = ز * ز;
    ليكن الناتج: متغير ع32 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب32(ز, زز); }
    وإلا { الناتج := كثيرة_جيب_تمام32(زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف ظل32(القيمة: ع32): ع32 {
    إذا (القيمة == 0.0 || ليس_رقما32(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية32(القيمة)) { ليكن الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    ليكن سالب: منطقي = القيمة < 0.0;
    ليكن المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    ليكن ز: ع32 = المختزل.الزاوية;
    ليكن زز: ع32 = ز * ز;
    ليكن الناتج: متغير ع32 = ز;
    إذا (زز > 1.0e-4) {
        الناتج := (((((9.38540185543e-3 * زز + 3.11992232697e-3) * زز + 2.44301354525e-2) * زز
            + 5.34112807005e-2) * زز + 1.33387994085e-1) * زز + 3.33331568548e-1) * زز * ز + ز;
    };
    إذا ((المختزل.الثمن & 2) == 2) { الناتج := -1.0 / الناتج; };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام مرادف sin_f32 = جيب32;
عام مرادف cos_f32 = جيب_تمام32;
عام مرادف tan_f32 = ظل32;
