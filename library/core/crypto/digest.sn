// The hash-function selection of the protocols that negotiate the digest, and
// each digest's output and block sizes: no heap, so core. The dispatch, HMAC,
// HKDF and PBKDF2 build vectors and are alloc's (alloc.crypto.digest), which
// re-exports these at the same path.

عام نوع خوارزمية_تجزئة =
    | تجزئة_شا1
    | تجزئة_شا256
    | تجزئة_شا384
    | تجزئة_شا512
;

عام عرف حجم_ملخص_تجزئة(الخوارزمية: خوارزمية_تجزئة): طبيعي {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع 20; }
    | خوارزمية_تجزئة.تجزئة_شا256 -> { أرجع 32; }
    | خوارزمية_تجزئة.تجزئة_شا384 -> { أرجع 48; }
    | خوارزمية_تجزئة.تجزئة_شا512 -> { أرجع 64; };
}

عام عرف حجم_كتلة_تجزئة(الخوارزمية: خوارزمية_تجزئة): طبيعي {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع 64; }
    | خوارزمية_تجزئة.تجزئة_شا256 -> { أرجع 64; }
    | خوارزمية_تجزئة.تجزئة_شا384 -> { أرجع 128; }
    | خوارزمية_تجزئة.تجزئة_شا512 -> { أرجع 128; };
}

عام مرادف hash_algorithm = خوارزمية_تجزئة;
عام مرادف hash_digest_size = حجم_ملخص_تجزئة;
