// The words of a program's runtime failures (docs/en/reference/errors.md), rendered by
// iSpeak: the compiler replaces this module's text at every compilation
// (compiler/driver/program_failure_text.sn) with the same two functions,
// rendered from its iSpeak tables, and the language of that compilation's
// --lang. The text below is that rendering for Arabic; the C Stage0 and
// tools read it as written. Do not edit it by hand: the iSpeak suite checks
// it against the compiler's rendering.
//
// The failure keys: 0 the program ended with an error (`main` returned
// one), 1 the program stopped (إنهيار), 2 the program stopped because an
// assertion failed.

// The frame of one runtime failure, in English or in Arabic.
عام عرف إطار_فشل_تشغيل(المفتاح: عدد, الإنجليزية: منطقي): نص {
    إذا (المفتاح == 1) {
        إذا (الإنجليزية) { أرجع «error[SULTANC-RUNTIME-PROGRAM-STOPPED]: the program stopped»; };
        أرجع «خطأ[SULTANC-RUNTIME-PROGRAM-STOPPED]: توقف البرنامج»;
    };
    إذا (المفتاح == 2) {
        إذا (الإنجليزية) { أرجع «error[SULTANC-RUNTIME-PROGRAM-STOPPED]: the program stopped — An assertion failed.»; };
        أرجع «خطأ[SULTANC-RUNTIME-PROGRAM-STOPPED]: توقف البرنامج — فشل تأكيد.»;
    };
    إذا (الإنجليزية) { أرجع «error[SULTANC-RUNTIME-PROGRAM-ERROR]: the program ended with an error»; };
    أرجع «خطأ[SULTANC-RUNTIME-PROGRAM-ERROR]: انتهى البرنامج بخطأ»;
}

// The words of a failed runtime check (std.process.runtime_check), in
// English or in Arabic: {0} and {1} stand for the index and the length,
// {2} for the place. The kinds: 0 an integer overflow, 1 an index out of
// range, 2 a division by zero.
عام عرف نص_فحص_تشغيل(النوع: عدد, الإنجليزية: منطقي): نص {
    إذا (النوع == 1) {
        إذا (الإنجليزية) { أرجع «index {0} out of range for length {1} at {2}»; };
        أرجع «الفهرس {0} خارج المدى للطول {1} عند {2}»;
    };
    إذا (النوع == 2) {
        إذا (الإنجليزية) { أرجع «division by zero at {2}»; };
        أرجع «قسمة على صفر عند {2}»;
    };
    إذا (الإنجليزية) { أرجع «integer overflow at {2}»; };
    أرجع «تجاوز العدد الصحيح حدود نوعه عند {2}»;
}

// Whether the program was compiled with English as its language.
عام عرف لغة_البرنامج_المترجمة_إنجليزية(): منطقي {
    أرجع خطأ;
}
