استورد net.ip;
استورد net.socket_address;

استورد os.socket;
استورد os.error;

// Preserve the existing owned compact address layout, but obtain it from
// the target-selected native resolver rather than the deleted runtime.
عرف حل_اسم_مضيف_خام(الاسم: &نص, العائلة: عدد, الخارج: &متغير متجه ط8): عدد {
    طابق حل_اسم_مضيف_النظام(الاسم, العائلة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(البيانات) -> {
        دع الحجم: طبيعي = الطول(البيانات) مثل طبيعي;
        إذا (الحجم > (الطول(*الخارج) مثل طبيعي)) { أرجع -75; };
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < الحجم) {
            (*الخارج)[الفهرس] := البيانات[الفهرس];
            الفهرس := الفهرس + 1;
        }
        أرجع الحجم مثل عدد;
    };
}

عام نوع عائلة_حل_اسم =
    | آيبي4
    | آيبي6
;

عرف قيمة_عائلة_حل_اسم(العائلة: عائلة_حل_اسم): عدد {
    طابق العائلة مع
    | عائلة_حل_اسم.آيبي4 -> { أرجع 4; }
    | عائلة_حل_اسم.آيبي6 -> { أرجع 6; };
}

عرف اسم_مضيف_صفري(الاسم: &نص): نتيجة متجه ط8, عدد {
    دع القيمة: نص = *الاسم;
    إذا ((الطول(القيمة) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(-22); };
    دع الخارج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        إذا (القيمة[ف] == 0) { أرجع نتيجة.خطأ(-22); };
        ألحق(الخارج, القيمة[ف]);
        ف := ف + 1;
    }
    ألحق(الخارج, 0);
    أرجع نتيجة.نجح(الخارج);
}

عام عرف حل_اسم_مضيف(الاسم: &نص, المنفذ: ط16, العائلة: عائلة_حل_اسم): نتيجة عنوان_مقبس, عدد {
    طابق اسم_مضيف_صفري(الاسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الاسم_الصفري) -> {
        دع الخارج: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < 20) { ألحق(الخارج, 0); ف := ف + 1; }
        // 1=stream, 6=TCP are normalized runtime ABI values, not host constants.
        دع الحجم: عدد = حل_اسم_مضيف_خام(الاسم, قيمة_عائلة_حل_اسم(العائلة), &متغير الخارج);
        إذا (الحجم < 0) { أرجع نتيجة.خطأ(الحجم); };
        إذا ((الحجم != 8) && (الحجم != 20)) { أرجع نتيجة.خطأ(-22); };
        دع رمز_العائلة: ط8 = الخارج[0];
        دع طول_العنوان: ط8 = الخارج[1];
        إذا ((رمز_العائلة == 4) && (طول_العنوان == 4) && (الحجم == 8)) {
            دع ع4: عنوان_آيبي4 = { أ: الخارج[4], ب: الخارج[5], ج: الخارج[6], د: الخارج[7] };
            دع الآيبي: عنوان_آيبي = عنوان_آيبي.رابع(ع4);
            أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
        };
        إذا ((رمز_العائلة == 6) && (طول_العنوان == 16) && (الحجم == 20)) {
            دع المقاطع: متغير متجه ط16 = [];
            دع م: متغير طبيعي = 4;
            طالما (م < 20) {
                دع التالي: طبيعي = م + 1;
                دع الجزء: ط16 = (((الخارج[م] مثل ط16) << 8) | (الخارج[التالي] مثل ط16));
                ألحق(المقاطع, الجزء);
                م := م + 2;
            }
            دع ع6: عنوان_آيبي6 = { المقاطع: المقاطع };
            دع الآيبي: عنوان_آيبي = عنوان_آيبي.سادس(ع6);
            أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
        };
        أرجع نتيجة.خطأ(-22);
    };
}

عام عرف حل_اسم_مضيف4(الاسم: &نص, المنفذ: ط16): نتيجة عنوان_مقبس, عدد {
    أرجع حل_اسم_مضيف(الاسم, المنفذ, عائلة_حل_اسم.آيبي4());
}

عام عرف حل_اسم_مضيف6(الاسم: &نص, المنفذ: ط16): نتيجة عنوان_مقبس, عدد {
    أرجع حل_اسم_مضيف(الاسم, المنفذ, عائلة_حل_اسم.آيبي6());
}

عام نوع dns_family = عائلة_حل_اسم;
عام عرف dns_ipv4_family(): dns_family { أرجع عائلة_حل_اسم.آيبي4(); }
عام عرف dns_ipv6_family(): dns_family { أرجع عائلة_حل_اسم.آيبي6(); }
عام مرادف resolve_host = حل_اسم_مضيف;
عام مرادف resolve_host_ipv4 = حل_اسم_مضيف4;
عام مرادف resolve_host_ipv6 = حل_اسم_مضيف6;
