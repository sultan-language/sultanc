استورد net.ip;
استورد net.socket_address;

مرادف حل_اسم_مضيف_خام = بدائي_حل_اسم_مضيف;

عام نوع عائلة_حل_اسم =
    | آيبي4
    | آيبي6
;

عرف قيمة_عائلة_حل_اسم(العائلة: عائلة_حل_اسم): عدد {
    طابق العائلة مع
    | عائلة_حل_اسم.آيبي4 -> { أرجع 4; }
    | عائلة_حل_اسم.آيبي6 -> { أرجع 6; };
}

عرف اسم_مضيف_صفري(الاسم: &نص): نتيجة متجه غ8, عدد {
    دع القيمة: نص = *الاسم;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(-22); };
    دع الخارج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (القيمة[ف] == 0) { أرجع نتيجة.خطأ(-22); };
        ألحق(الخارج, القيمة[ف]);
        ف := ف + 1;
    }
    ألحق(الخارج, 0);
    أرجع نتيجة.نجح(الخارج);
}

عام عرف حل_اسم_مضيف(الاسم: &نص, المنفذ: غ16, العائلة: عائلة_حل_اسم): نتيجة عنوان_مقبس, عدد {
    طابق اسم_مضيف_صفري(الاسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الاسم_الصفري) -> {
        دع الخارج: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < 20) { ألحق(الخارج, 0); ف := ف + 1; }
        // 1=stream, 6=TCP are normalized runtime ABI values, not host constants.
        دع الحجم: عدد = حل_اسم_مضيف_خام(الاسم_الصفري, قيمة_عائلة_حل_اسم(العائلة), 1, 6, الخارج);
        لو (الحجم < 0) { أرجع نتيجة.خطأ(الحجم); };
        لو ((الحجم != 8) && (الحجم != 20)) { أرجع نتيجة.خطأ(-22); };
        دع رمز_العائلة: غ8 = الخارج[0];
        دع طول_العنوان: غ8 = الخارج[1];
        لو ((رمز_العائلة == 4) && (طول_العنوان == 4) && (الحجم == 8)) {
            دع ع4: عنوان_آيبي4 = { أ: الخارج[4], ب: الخارج[5], ج: الخارج[6], د: الخارج[7] };
            دع الآيبي: عنوان_آيبي = عنوان_آيبي.رابع(ع4);
            أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
        };
        لو ((رمز_العائلة == 6) && (طول_العنوان == 16) && (الحجم == 20)) {
            دع المقاطع: متغير متجه غ16 = [];
            دع م: متغير غير_موقع = 4;
            بينما (م < 20) {
                دع التالي: غير_موقع = م + 1;
                دع الجزء: غ16 = (((الخارج[م] مثل غ16) << 8) | (الخارج[التالي] مثل غ16));
                ألحق(المقاطع, الجزء);
                م := م + 2;
            }
            دع ع6: عنوان_آيبي6 = { المقاطع: المقاطع };
            دع الآيبي: عنوان_آيبي = عنوان_آيبي.سادس(ع6);
            أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
        };
        أرجع نتيجة.خطأ(-22);
    };
}

عام عرف حل_اسم_مضيف4(الاسم: &نص, المنفذ: غ16): نتيجة عنوان_مقبس, عدد {
    أرجع حل_اسم_مضيف(الاسم, المنفذ, عائلة_حل_اسم.آيبي4());
}

عام عرف حل_اسم_مضيف6(الاسم: &نص, المنفذ: غ16): نتيجة عنوان_مقبس, عدد {
    أرجع حل_اسم_مضيف(الاسم, المنفذ, عائلة_حل_اسم.آيبي6());
}

عام نوع dns_family = عائلة_حل_اسم;
عام عرف dns_ipv4_family(): dns_family { أرجع عائلة_حل_اسم.آيبي4(); }
عام عرف dns_ipv6_family(): dns_family { أرجع عائلة_حل_اسم.آيبي6(); }
عام مرادف resolve_host = حل_اسم_مضيف;
عام مرادف resolve_host_ipv4 = حل_اسم_مضيف4;
عام مرادف resolve_host_ipv6 = حل_اسم_مضيف6;
