استورد net.ip;
استورد net.options;
استورد net.socket_address;

استورد os.socket;
استورد os.error;

// UDP datagram sockets on the same OS socket layer as std.net.tcp: a socket
// is bound to a local address, then connected to one peer to send and
// receive datagrams (the kernel filters datagrams from other peers once it
// is connected). One send is one datagram; one receive returns at most one
// datagram, truncated to the buffer space given.

عام نوع مقبس_يو_دي_بي = صندوق عدد;

عرف رقم_مقبس_يو_دي_بي_للنظام(النتيجة: نتيجة عدد, خطأ_حد_نظام): عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}

عرف مقبس_نظام_يو_دي_بي(القيمة: عدد): مقبس_نظام {
    دع الناتج: مقبس_نظام = { القيمة: القيمة, مفتوح: صواب };
    أرجع الناتج;
}

عرف قيمة_مقبس_يو_دي_بي(المقبس: &مقبس_يو_دي_بي): عدد { أرجع **المقبس; }

عرف أغلق_مقبس_يو_دي_بي_خام(القيمة: عدد): عدد {
    دع المقبس: متغير مقبس_نظام = مقبس_نظام_يو_دي_بي(القيمة);
    أرجع رقم_مقبس_يو_دي_بي_للنظام(أغلق_مقبس_نظام(&متغير المقبس));
}

// Binds a new datagram socket (2 = datagram, 17 = UDP: normalized runtime
// ABI values) to العنوان after applying الخيارات.
عام عرف اربط_يو_دي_بي_بخيارات(
    العنوان: &عنوان_مقبس, الخيارات: &متجه خيار_مقبس
): نتيجة مقبس_يو_دي_بي, عدد {
    دع ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
        دع المقبس: عدد;
        طابق أنشئ_مقبس_نظام(العائلة, 2, 17) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(الناتج) -> { المقبس := الناتج.القيمة; };
        دع القيم: متجه خيار_مقبس = *الخيارات;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            طابق طبق_خيار_مقبس_داخليا(المقبس, القيم[ف]) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع تجاهل: عدد = أغلق_مقبس_يو_دي_بي_خام(المقبس);
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(_) -> { };
            ف := ف + 1;
        }
        دع نظامي: مقبس_نظام = مقبس_نظام_يو_دي_بي(المقبس);
        دع الحالة: عدد = رقم_مقبس_يو_دي_بي_للنظام(
            اربط_مقبس_نظام(&نظامي, &المرمز.البايتات, المرمز.الطول)
        );
        إذا (الحالة < 0) {
            دع تجاهل: عدد = أغلق_مقبس_يو_دي_بي_خام(المقبس);
            أرجع نتيجة.خطأ(الحالة);
        };
        دع الناتج_المغلف: مقبس_يو_دي_بي = صندوق المقبس;
        أرجع نتيجة.نجح(الناتج_المغلف);
    };
}

عام عرف اربط_يو_دي_بي(العنوان: &عنوان_مقبس): نتيجة مقبس_يو_دي_بي, عدد {
    دع الخيارات: متجه خيار_مقبس = [];
    أرجع اربط_يو_دي_بي_بخيارات(العنوان, &الخيارات);
}

// Sets the one peer this socket sends to and receives from.
عام عرف وصل_يو_دي_بي(
    المقبس: &مقبس_يو_دي_بي, العنوان: &عنوان_مقبس
): نتيجة عدد, عدد {
    دع ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع نظامي: مقبس_نظام = مقبس_نظام_يو_دي_بي(قيمة_مقبس_يو_دي_بي(المقبس));
        دع الحالة: عدد = رقم_مقبس_يو_دي_بي_للنظام(
            اتصل_مقبس_نظام(&نظامي, &المرمز.البايتات, المرمز.الطول)
        );
        إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        أرجع نتيجة.نجح(الحالة);
    };
}

// Sends المحتوى[الإزاحة .. الإزاحة + العدد) as one datagram to the peer.
عام عرف أرسل_يو_دي_بي(
    المقبس: &مقبس_يو_دي_بي, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع نظامي: مقبس_نظام = مقبس_نظام_يو_دي_بي(قيمة_مقبس_يو_دي_بي(المقبس));
    دع المرسل: عدد = رقم_مقبس_يو_دي_بي_للنظام(
        أرسل_مقبس_نظام(&نظامي, المحتوى, الإزاحة, العدد)
    );
    إذا (المرسل < 0) { أرجع نتيجة.خطأ(المرسل); };
    أرجع نتيجة.نجح(المرسل);
}

// Receives one datagram into المخزن[الإزاحة ..], at most العدد bytes.
عام عرف استقبل_يو_دي_بي(
    المقبس: &مقبس_يو_دي_بي, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع نظامي: مقبس_نظام = مقبس_نظام_يو_دي_بي(قيمة_مقبس_يو_دي_بي(المقبس));
    دع المقروء: عدد = رقم_مقبس_يو_دي_بي_للنظام(
        استقبل_مقبس_نظام(&نظامي, المخزن, الإزاحة, العدد)
    );
    إذا (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(المقروء);
}

عام عرف اضبط_خيار_يو_دي_بي(المقبس: &مقبس_يو_دي_بي, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    أرجع طبق_خيار_مقبس_داخليا(قيمة_مقبس_يو_دي_بي(المقبس), الخيار);
}

عام عرف أغلق_يو_دي_بي(المقبس: مقبس_يو_دي_بي): نتيجة عدد, عدد {
    دع القيمة: عدد = *المقبس;
    دع الحالة: عدد = أغلق_مقبس_يو_دي_بي_خام(القيمة);
    حرر(المقبس);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام نوع udp_socket = مقبس_يو_دي_بي;
عام مرادف udp_bind = اربط_يو_دي_بي;
عام مرادف udp_bind_with_options = اربط_يو_دي_بي_بخيارات;
عام مرادف udp_connect = وصل_يو_دي_بي;
عام مرادف udp_send = أرسل_يو_دي_بي;
عام مرادف udp_recv = استقبل_يو_دي_بي;
عام مرادف udp_set_option = اضبط_خيار_يو_دي_بي;
عام مرادف udp_close = أغلق_يو_دي_بي;
