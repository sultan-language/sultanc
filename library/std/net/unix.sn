استورد net.tcp;
استورد os.socket;
استورد os.socket_names;
استورد os.unix_socket;
استورد os.error;
استورد text.from_bytes;

// Unix domain sockets (Rust std::os::unix::net): a listener and the
// streams it accepts or connects (UnixListener, UnixStream), and
// datagram sockets (UnixDatagram). An address is a filesystem path, an
// abstract name (Linux and Android: a name in the kernel with no file), or
// unnamed (an unbound socket). Binding a path creates the socket file;
// nothing removes it on close, as in Rust: remove it with std.fs. Linux,
// Android, FreeBSD and macOS; Windows 10 1803+ has stream sockets only (no
// datagrams, no abstract names); WASI has none (غير_مدعوم). Errors are
// negative codes, as for TCP. Streams and datagram sockets use
// std.net.tcp's اتجاه_إيقاف_تي_سي_بي (Rust's std::net::Shutdown).

عام نوع عنوان_يونكس =
    | بلا_اسم
    | مسار بنوع نص
    | مجرد بنوع متجه ط8
;

عام نوع تدفق_يونكس = صندوق عدد;
عام نوع مستمع_يونكس = صندوق عدد;
عام نوع مقبس_رسائل_يونكس = صندوق عدد;

// A received datagram: its length and its sender.
عام نوع حزمة_يونكس = { المقروء: عدد, المرسل: عنوان_يونكس };

// Whether this platform has abstract names (Linux, Android).
عام عرف هل_العنوان_المجرد_مدعوم(): منطقي { أرجع هل_العنوان_المجرد_مدعوم_نظام(); }

عرف مقبس_يونكس_للنظام(القيمة: عدد): مقبس_نظام {
    دع الناتج: مقبس_نظام = { القيمة: القيمة, مفتوح: صواب };
    أرجع الناتج;
}
عرف رمز_نتيجة_يونكس(النتيجة: نتيجة عدد, خطأ_حد_نظام): نتيجة عدد, عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}
عرف أغلق_مقبس_يونكس_خام(القيمة: عدد): فراغ {
    دع المقبس: متغير مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
    دع الإغلاق: نتيجة عدد, خطأ_حد_نظام = أغلق_مقبس_نظام(&متغير المقبس);
}

// The platform sockaddr_un of an address; an unnamed one has none.
عرف رمز_عنوان_يونكس(العنوان: &عنوان_يونكس): نتيجة متجه ط8, عدد {
    دع الاسم: متغير متجه ط8 = [];
    دع مجرد: متغير منطقي = خطأ;
    طابق *العنوان مع
    | عنوان_يونكس.بلا_اسم -> { أرجع نتيجة.خطأ(-22); }
    | عنوان_يونكس.مسار(النص) -> { الاسم := بايتات_من_نص(انسخ_نص(&النص)); }
    | عنوان_يونكس.مجرد(البايتات) -> { الاسم := انسخ_بايتات(&البايتات); مجرد := صواب; };
    طابق رمز_عنوان_يونكس_نظام(&الاسم, مجرد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات); };
}

عرف عنوان_يونكس_من_نظام(البايتات: &متجه ط8): نتيجة عنوان_يونكس, عدد {
    طابق فك_عنوان_يونكس_نظام(البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح({ النوع: النوع, البايتات: البايتات }) -> {
        لو (النوع == 1) { أرجع نتيجة.نجح(عنوان_يونكس.مسار(من_بايتات(&البايتات))); };
        لو (النوع == 2) { أرجع نتيجة.نجح(عنوان_يونكس.مجرد(البايتات)); };
        أرجع نتيجة.نجح(عنوان_يونكس.بلا_اسم());
    };
}

// socket(AF_UNIX, النوع, 0): 1 stream, 2 datagram.
عرف أنشئ_مقبس_يونكس(النوع: عدد): نتيجة عدد, عدد {
    طابق أنشئ_مقبس_نظام(1, النوع, 0) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المقبس) -> { أرجع نتيجة.نجح(المقبس.القيمة); };
}

// A new socket of النوع bound (ربط) or connected to العنوان.
عرف مقبس_يونكس_بعنوان(النوع: عدد, العنوان: &عنوان_يونكس, ربط: منطقي): نتيجة عدد, عدد {
    طابق رمز_عنوان_يونكس(العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        طابق أنشئ_مقبس_يونكس(النوع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
            دع العدد: عدد = الطول(المرمز) مثل عدد;
            دع الحالة: متغير نتيجة عدد, خطأ_حد_نظام = نتيجة.نجح(0);
            لو (ربط) { الحالة := اربط_مقبس_نظام(&المقبس, &المرمز, العدد); }
            وإلا { الحالة := اتصل_مقبس_نظام(&المقبس, &المرمز, العدد); };
            طابق الحالة مع
            | نتيجة.خطأ(الخطأ) -> { أغلق_مقبس_يونكس_خام(القيمة); أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(القيمة); };
        };
    };
}

عرف اسم_مقبس_يونكس(القيمة: عدد, محلي: منطقي): نتيجة عنوان_يونكس, عدد {
    دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
    طابق اقرأ_اسم_مقبس_خام_نظام(&المقبس, محلي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(البايتات) -> { أرجع عنوان_يونكس_من_نظام(&البايتات); };
}

عرف أوقف_مقبس_يونكس(القيمة: عدد, الاتجاه: اتجاه_إيقاف_تي_سي_بي): نتيجة عدد, عدد {
    دع الرمز: متغير عدد = 2;
    طابق الاتجاه مع
    | اتجاه_إيقاف_تي_سي_بي.قراءة -> { الرمز := 0; }
    | اتجاه_إيقاف_تي_سي_بي.كتابة -> { الرمز := 1; }
    | اتجاه_إيقاف_تي_سي_بي.كلاهما -> { الرمز := 2; };
    دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
    أرجع رمز_نتيجة_يونكس(أوقف_مقبس_نظام(&المقبس, الرمز));
}

عرف أغلق_صندوق_يونكس(القيمة: عدد): نتيجة عدد, عدد {
    دع المقبس: متغير مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
    أرجع رمز_نتيجة_يونكس(أغلق_مقبس_نظام(&متغير المقبس));
}

// ---- Listener and streams ----

// Binds a listening stream socket to العنوان (Rust UnixListener::bind_addr).
// A path that exists already, even a stale socket file, is EADDRINUSE.
عام عرف اربط_مستمع_يونكس_بعنوان(العنوان: &عنوان_يونكس): نتيجة مستمع_يونكس, عدد {
    طابق مقبس_يونكس_بعنوان(1, العنوان, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(القيمة);
        طابق استمع_مقبس_نظام(&المقبس, 128) مع
        | نتيجة.خطأ(الخطأ) -> { أغلق_مقبس_يونكس_خام(القيمة); أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(_) -> {
            دع المستمع: مستمع_يونكس = صندوق القيمة;
            أرجع نتيجة.نجح(المستمع);
        };
    };
}

// Binds a listening stream socket to a filesystem path (UnixListener::bind).
عام عرف اربط_مستمع_يونكس(المسار: &نص): نتيجة مستمع_يونكس, عدد {
    دع العنوان: عنوان_يونكس = عنوان_يونكس.مسار(انسخ_نص(المسار));
    أرجع اربط_مستمع_يونكس_بعنوان(&العنوان);
}

// Waits for the next connection (UnixListener::accept); the peer's
// address is عنوان_نظير_يونكس of the stream.
عام عرف اقبل_يونكس(المستمع: &مستمع_يونكس): نتيجة تدفق_يونكس, عدد {
    دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(**المستمع);
    طابق اقبل_مقبس_نظام(&المقبس) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المقبول) -> {
        دع التدفق: تدفق_يونكس = صندوق المقبول.القيمة;
        أرجع نتيجة.نجح(التدفق);
    };
}

// Connects a stream socket to العنوان (UnixStream::connect_addr).
عام عرف اتصل_يونكس_بعنوان(العنوان: &عنوان_يونكس): نتيجة تدفق_يونكس, عدد {
    طابق مقبس_يونكس_بعنوان(1, العنوان, خطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع التدفق: تدفق_يونكس = صندوق القيمة;
        أرجع نتيجة.نجح(التدفق);
    };
}

// Connects a stream socket to a filesystem path (UnixStream::connect).
عام عرف اتصل_يونكس(المسار: &نص): نتيجة تدفق_يونكس, عدد {
    دع العنوان: عنوان_يونكس = عنوان_يونكس.مسار(انسخ_نص(المسار));
    أرجع اتصل_يونكس_بعنوان(&العنوان);
}

// The reader and writer shapes of std.io (قارئ, كاتب); 0 bytes read is the
// end of the stream.
عام عرف اقرأ_يونكس(
    التدفق: &تدفق_يونكس, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(**التدفق);
    أرجع رمز_نتيجة_يونكس(استقبل_مقبس_نظام(&المقبس, المخزن, الإزاحة, العدد));
}
عام عرف اكتب_يونكس(
    التدفق: &تدفق_يونكس, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع المقبس: مقبس_نظام = مقبس_يونكس_للنظام(**التدفق);
    أرجع رمز_نتيجة_يونكس(أرسل_مقبس_نظام(&المقبس, المحتوى, الإزاحة, العدد));
}

// Shuts down reading, writing or both (UnixStream::shutdown): after the
// write side is shut, the peer reads the end of the stream.
عام عرف أوقف_يونكس(التدفق: &تدفق_يونكس, الاتجاه: اتجاه_إيقاف_تي_سي_بي): نتيجة عدد, عدد {
    أرجع أوقف_مقبس_يونكس(**التدفق, الاتجاه);
}

عام عرف العنوان_المحلي_يونكس(التدفق: &تدفق_يونكس): نتيجة عنوان_يونكس, عدد {
    أرجع اسم_مقبس_يونكس(**التدفق, صواب);
}
عام عرف عنوان_نظير_يونكس(التدفق: &تدفق_يونكس): نتيجة عنوان_يونكس, عدد {
    أرجع اسم_مقبس_يونكس(**التدفق, خطأ);
}
عام عرف العنوان_المحلي_لمستمع_يونكس(المستمع: &مستمع_يونكس): نتيجة عنوان_يونكس, عدد {
    أرجع اسم_مقبس_يونكس(**المستمع, صواب);
}

عام عرف أغلق_تدفق_يونكس(التدفق: تدفق_يونكس): نتيجة عدد, عدد {
    دع القيمة: عدد = *التدفق;
    حرر(التدفق);
    أرجع أغلق_صندوق_يونكس(القيمة);
}
عام عرف أغلق_مستمع_يونكس(المستمع: مستمع_يونكس): نتيجة عدد, عدد {
    دع القيمة: عدد = *المستمع;
    حرر(المستمع);
    أرجع أغلق_صندوق_يونكس(القيمة);
}

// ---- Datagram sockets ----

// A datagram socket bound to العنوان (UnixDatagram::bind_addr).
عام عرف اربط_رسائل_يونكس_بعنوان(العنوان: &عنوان_يونكس): نتيجة مقبس_رسائل_يونكس, عدد {
    طابق مقبس_يونكس_بعنوان(2, العنوان, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع المقبس: مقبس_رسائل_يونكس = صندوق القيمة;
        أرجع نتيجة.نجح(المقبس);
    };
}

// A datagram socket bound to a filesystem path (UnixDatagram::bind).
عام عرف اربط_رسائل_يونكس(المسار: &نص): نتيجة مقبس_رسائل_يونكس, عدد {
    دع العنوان: عنوان_يونكس = عنوان_يونكس.مسار(انسخ_نص(المسار));
    أرجع اربط_رسائل_يونكس_بعنوان(&العنوان);
}

// An unbound datagram socket (UnixDatagram::unbound): it can send; its
// datagrams arrive from an unnamed sender.
عام عرف رسائل_يونكس_بلا_ربط(): نتيجة مقبس_رسائل_يونكس, عدد {
    طابق أنشئ_مقبس_يونكس(2) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع المقبس: مقبس_رسائل_يونكس = صندوق القيمة;
        أرجع نتيجة.نجح(المقبس);
    };
}

// Sets the default peer (UnixDatagram::connect_addr): أرسل_رسائل_يونكس
// sends to it, and only its datagrams are received.
عام عرف اتصل_رسائل_يونكس_بعنوان(المقبس: &مقبس_رسائل_يونكس, العنوان: &عنوان_يونكس): نتيجة عدد, عدد {
    طابق رمز_عنوان_يونكس(العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع الأصلي: مقبس_نظام = مقبس_يونكس_للنظام(**المقبس);
        أرجع رمز_نتيجة_يونكس(اتصل_مقبس_نظام(&الأصلي, &المرمز, الطول(المرمز) مثل عدد));
    };
}
عام عرف اتصل_رسائل_يونكس(المقبس: &مقبس_رسائل_يونكس, المسار: &نص): نتيجة عدد, عدد {
    دع العنوان: عنوان_يونكس = عنوان_يونكس.مسار(انسخ_نص(المسار));
    أرجع اتصل_رسائل_يونكس_بعنوان(المقبس, &العنوان);
}

// Sends one datagram to العنوان (UnixDatagram::send_to_addr).
عام عرف أرسل_إلى_يونكس_بعنوان(
    المقبس: &مقبس_رسائل_يونكس, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد,
    العنوان: &عنوان_يونكس
): نتيجة عدد, عدد {
    طابق رمز_عنوان_يونكس(العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع الأصلي: مقبس_نظام = مقبس_يونكس_للنظام(**المقبس);
        أرجع رمز_نتيجة_يونكس(أرسل_إلى_مقبس_نظام(&الأصلي, المحتوى, الإزاحة, العدد, &المرمز));
    };
}
عام عرف أرسل_إلى_يونكس(
    المقبس: &مقبس_رسائل_يونكس, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد, المسار: &نص
): نتيجة عدد, عدد {
    دع العنوان: عنوان_يونكس = عنوان_يونكس.مسار(انسخ_نص(المسار));
    أرجع أرسل_إلى_يونكس_بعنوان(المقبس, المحتوى, الإزاحة, العدد, &العنوان);
}

// Receives one datagram and its sender (UnixDatagram::recv_from). A
// datagram longer than the space is cut to it.
عام عرف استقبل_من_يونكس(
    المقبس: &مقبس_رسائل_يونكس, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة حزمة_يونكس, عدد {
    دع الأصلي: مقبس_نظام = مقبس_يونكس_للنظام(**المقبس);
    طابق استقبل_من_مقبس_خام_نظام(&الأصلي, المخزن, الإزاحة, العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح({ المقروء: المقروء, العنوان: العنوان }) -> {
        طابق عنوان_يونكس_من_نظام(&العنوان) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المرسل) -> {
            دع الناتج: حزمة_يونكس = { المقروء: المقروء, المرسل: المرسل };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}

// Send to and receive from the connected peer (UnixDatagram::send, recv).
عام عرف أرسل_رسائل_يونكس(
    المقبس: &مقبس_رسائل_يونكس, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع الأصلي: مقبس_نظام = مقبس_يونكس_للنظام(**المقبس);
    أرجع رمز_نتيجة_يونكس(أرسل_مقبس_نظام(&الأصلي, المحتوى, الإزاحة, العدد));
}
عام عرف استقبل_رسائل_يونكس(
    المقبس: &مقبس_رسائل_يونكس, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, عدد {
    دع الأصلي: مقبس_نظام = مقبس_يونكس_للنظام(**المقبس);
    أرجع رمز_نتيجة_يونكس(استقبل_مقبس_نظام(&الأصلي, المخزن, الإزاحة, العدد));
}

عام عرف أوقف_رسائل_يونكس(المقبس: &مقبس_رسائل_يونكس, الاتجاه: اتجاه_إيقاف_تي_سي_بي): نتيجة عدد, عدد {
    أرجع أوقف_مقبس_يونكس(**المقبس, الاتجاه);
}
عام عرف العنوان_المحلي_لرسائل_يونكس(المقبس: &مقبس_رسائل_يونكس): نتيجة عنوان_يونكس, عدد {
    أرجع اسم_مقبس_يونكس(**المقبس, صواب);
}
عام عرف عنوان_نظير_رسائل_يونكس(المقبس: &مقبس_رسائل_يونكس): نتيجة عنوان_يونكس, عدد {
    أرجع اسم_مقبس_يونكس(**المقبس, خطأ);
}
عام عرف أغلق_رسائل_يونكس(المقبس: مقبس_رسائل_يونكس): نتيجة عدد, عدد {
    دع القيمة: عدد = *المقبس;
    حرر(المقبس);
    أرجع أغلق_صندوق_يونكس(القيمة);
}

