استورد شبكة.آيبي;
استورد شبكة.خيارات;
استورد شبكة.عنوان_مقبس;

استورد نظام_التشغيل.مقبس;
استورد نظام_التشغيل.أخطاء;

عرف رقم_مقبس_لنظام(النتيجة: نتيجة عدد, خطأ_حد_نظام): عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}
عرف مقبس_تي_سي_بي_للنظام(القيمة: عدد): مقبس_نظام {
    ليكن الناتج: مقبس_نظام = { القيمة: القيمة, مفتوح: صواب };
    أرجع الناتج;
}
عرف أنشئ_مقبسا_خام(العائلة: عدد, النوع: عدد, البروتوكول: عدد): عدد {
    طابق أنشئ_مقبس_نظام(العائلة, النوع, البروتوكول) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(المقبس) -> { أرجع المقبس.القيمة; };
}
عرف اتصل_بمقبس_خام(القيمة: عدد, العنوان: &متجه ط8, العدد: عدد): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(اتصل_مقبس_نظام(&المقبس, العنوان, العدد));
}
عرف اربط_مقبسا_خام(القيمة: عدد, العنوان: &متجه ط8, العدد: عدد): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(اربط_مقبس_نظام(&المقبس, العنوان, العدد));
}
عرف استمع_لمقبس_خام(القيمة: عدد, التراكم: عدد): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(استمع_مقبس_نظام(&المقبس, التراكم));
}
عرف اقبل_مقبسا_خام(القيمة: عدد): عدد {
    ليكن المستمع: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    طابق اقبل_مقبس_نظام(&المستمع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(المقبس) -> { أرجع المقبس.القيمة; };
}
عرف أرسل_مقبس_خام(
    القيمة: عدد, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(أرسل_مقبس_نظام(&المقبس, المحتوى, الإزاحة, العدد));
}
عرف استقبل_مقبس_خام(
    القيمة: عدد, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(استقبل_مقبس_نظام(&المقبس, المخزن, الإزاحة, العدد));
}
عرف أوقف_مقبسا_خام(القيمة: عدد, الاتجاه: عدد): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(أوقف_مقبس_نظام(&المقبس, الاتجاه));
}
عرف أغلق_مقبسا_خام(القيمة: عدد): عدد {
    ليكن المقبس: متغير مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(أغلق_مقبس_نظام(&متغير المقبس));
}
عرف اضبط_غير_حاصر_خام(القيمة: عدد, المفعل: عدد): عدد {
    ليكن المقبس: مقبس_نظام = مقبس_تي_سي_بي_للنظام(القيمة);
    أرجع رقم_مقبس_لنظام(اضبط_مقبس_نظام_غير_حاصر(&المقبس, المفعل != 0));
}

عام نوع تدفق_تي_سي_بي = صندوق عدد;
عام نوع مستمع_تي_سي_بي = صندوق عدد;

عام نوع اتجاه_إيقاف_تي_سي_بي =
    | قراءة
    | كتابة
    | كلاهما
;

عرف قيمة_اتجاه_الإيقاف(الاتجاه: اتجاه_إيقاف_تي_سي_بي): عدد {
    طابق الاتجاه مع
    | اتجاه_إيقاف_تي_سي_بي.قراءة -> { أرجع 0; }
    | اتجاه_إيقاف_تي_سي_بي.كتابة -> { أرجع 1; }
    | اتجاه_إيقاف_تي_سي_بي.كلاهما -> { أرجع 2; };
}

عرف قيمة_تدفق_تي_سي_بي(التدفق: &تدفق_تي_سي_بي): عدد { أرجع **التدفق; }
عرف قيمة_مستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): عدد { أرجع **المستمع; }

// The OS descriptor (a Winsock SOCKET on Windows), for std.os.poll. The
// stream or listener still owns it.
عام عرف واصف_تدفق_تي_سي_بي(التدفق: &تدفق_تي_سي_بي): عدد { أرجع قيمة_تدفق_تي_سي_بي(التدفق); }
عام عرف واصف_مستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): عدد { أرجع قيمة_مستمع_تي_سي_بي(المستمع); }

عرف أنشئ_مقبس_تي_سي_بي(العائلة: عدد): نتيجة عدد, عدد {
    // 1=stream and 6=TCP are normalized runtime ABI values.
    ليكن المقبس: عدد = أنشئ_مقبسا_خام(العائلة, 1, 6);
    إذا (المقبس < 0) { أرجع نتيجة.خطأ(المقبس); };
    أرجع نتيجة.نجح(المقبس);
}

عرف طبق_خيارات_قبل_التشغيل(المقبس: عدد, الخيارات: &متجه خيار_مقبس): نتيجة عدد, عدد {
    ليكن القيم: متجه خيار_مقبس = *الخيارات;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        طابق طبق_خيار_مقبس_داخليا(المقبس, القيم[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

عام عرف اتصل_تي_سي_بي_بخيارات(العنوان: &عنوان_مقبس, الخيارات: &متجه خيار_مقبس): نتيجة تدفق_تي_سي_بي, عدد {
    ليكن ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        ليكن العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
        طابق أنشئ_مقبس_تي_سي_بي(العائلة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقبس) -> {
            طابق طبق_خيارات_قبل_التشغيل(المقبس, الخيارات) مع
            | نتيجة.خطأ(الخطأ) -> { ليكن تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ليكن الحالة: عدد = اتصل_بمقبس_خام(المقبس, &المرمز.البايتات, المرمز.الطول);
            إذا (الحالة < 0) { ليكن تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الحالة); };
            ليكن التدفق: تدفق_تي_سي_بي = صندوق المقبس;
            أرجع نتيجة.نجح(التدفق);
        };
    };
}

عام عرف اتصل_تي_سي_بي(العنوان: &عنوان_مقبس): نتيجة تدفق_تي_سي_بي, عدد {
    ليكن الخيارات: متجه خيار_مقبس = [];
    أرجع اتصل_تي_سي_بي_بخيارات(العنوان, &الخيارات);
}

// A listening socket gets SO_REUSEADDR on Unix-like systems, as most
// servers do: a server restarted on its port binds again while the
// old connections are still in TIME_WAIT. Windows' SO_REUSEADDR lets another
// socket take a bound port, so it is not set there. The caller's own options
// are applied after it and win.
إذا (الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos») {
    عرف أعد_استخدام_عنوان_المستمع_افتراضيا(): منطقي { أرجع صواب; }
}
إذا (الهدف.المنصة != «linux» && الهدف.المنصة != «android» && الهدف.المنصة != «freebsd» && الهدف.المنصة != «macos») {
    عرف أعد_استخدام_عنوان_المستمع_افتراضيا(): منطقي { أرجع خطأ; }
}

عام عرف اربط_مستمع_تي_سي_بي_بخيارات(
    العنوان: &عنوان_مقبس,
    التراكم: عدد,
    الخيارات: &متجه خيار_مقبس
): نتيجة مستمع_تي_سي_بي, عدد {
    إذا (التراكم < 0) { أرجع نتيجة.خطأ(-22); };
    ليكن ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        ليكن العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
        طابق أنشئ_مقبس_تي_سي_بي(العائلة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقبس) -> {
            إذا (أعد_استخدام_عنوان_المستمع_افتراضيا()) {
                // Best effort: a system that refuses it still binds as before.
                طابق طبق_خيار_مقبس_داخليا(المقبس, خيار_مقبس.إعادة_استخدام_العنوان(صواب)) مع
                | نتيجة.خطأ(_) -> { }
                | نتيجة.نجح(_) -> { };
            };
            طابق طبق_خيارات_قبل_التشغيل(المقبس, الخيارات) مع
            | نتيجة.خطأ(الخطأ) -> { ليكن تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ليكن حالة_الربط: عدد = اربط_مقبسا_خام(المقبس, &المرمز.البايتات, المرمز.الطول);
            إذا (حالة_الربط < 0) { ليكن تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(حالة_الربط); };
            ليكن حالة_الاستماع: عدد = استمع_لمقبس_خام(المقبس, التراكم);
            إذا (حالة_الاستماع < 0) { ليكن تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(حالة_الاستماع); };
            ليكن المستمع: مستمع_تي_سي_بي = صندوق المقبس;
            أرجع نتيجة.نجح(المستمع);
        };
    };
}

عام عرف اربط_مستمع_تي_سي_بي(العنوان: &عنوان_مقبس, التراكم: عدد): نتيجة مستمع_تي_سي_بي, عدد {
    ليكن الخيارات: متجه خيار_مقبس = [];
    أرجع اربط_مستمع_تي_سي_بي_بخيارات(العنوان, التراكم, &الخيارات);
}

عام عرف اقبل_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): نتيجة تدفق_تي_سي_بي, عدد {
    ليكن المقبس: عدد = اقبل_مقبسا_خام(قيمة_مستمع_تي_سي_بي(المستمع));
    إذا (المقبس < 0) { أرجع نتيجة.خطأ(المقبس); };
    ليكن التدفق: تدفق_تي_سي_بي = صندوق المقبس;
    أرجع نتيجة.نجح(التدفق);
}

عام عرف اقرأ_تي_سي_بي(
    التدفق: &تدفق_تي_سي_بي,
    المخزن: &متغير متجه ط8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    ليكن المقروء: عدد = استقبل_مقبس_خام(قيمة_تدفق_تي_سي_بي(التدفق), المخزن, الإزاحة, العدد);
    إذا (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(المقروء);
}

عام عرف اكتب_تي_سي_بي(
    التدفق: &تدفق_تي_سي_بي,
    المحتوى: &متجه ط8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    ليكن البيانات: متجه ط8 = *المحتوى;
    ليكن المكتوب: عدد = أرسل_مقبس_خام(قيمة_تدفق_تي_سي_بي(التدفق), &البيانات, الإزاحة, العدد);
    إذا (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
    أرجع نتيجة.نجح(المكتوب);
}

عام عرف أوقف_تي_سي_بي(التدفق: &تدفق_تي_سي_بي, الاتجاه: اتجاه_إيقاف_تي_سي_بي): نتيجة عدد, عدد {
    ليكن الحالة: عدد = أوقف_مقبسا_خام(قيمة_تدفق_تي_سي_بي(التدفق), قيمة_اتجاه_الإيقاف(الاتجاه));
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_تدفق_تي_سي_بي_غير_حاصر(التدفق: &تدفق_تي_سي_بي, مفعل: منطقي): نتيجة عدد, عدد {
    ليكن القيمة: متغير عدد = 0;
    إذا (مفعل) { القيمة := 1; };
    ليكن الحالة: عدد = اضبط_غير_حاصر_خام(قيمة_تدفق_تي_سي_بي(التدفق), القيمة);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_مستمع_تي_سي_بي_غير_حاصر(المستمع: &مستمع_تي_سي_بي, مفعل: منطقي): نتيجة عدد, عدد {
    ليكن القيمة: متغير عدد = 0;
    إذا (مفعل) { القيمة := 1; };
    ليكن الحالة: عدد = اضبط_غير_حاصر_خام(قيمة_مستمع_تي_سي_بي(المستمع), القيمة);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_خيار_تدفق_تي_سي_بي(التدفق: &تدفق_تي_سي_بي, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    أرجع طبق_خيار_مقبس_داخليا(قيمة_تدفق_تي_سي_بي(التدفق), الخيار);
}

عام عرف اضبط_خيار_مستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    أرجع طبق_خيار_مقبس_داخليا(قيمة_مستمع_تي_سي_بي(المستمع), الخيار);
}

عام عرف أغلق_تدفق_تي_سي_بي(التدفق: تدفق_تي_سي_بي): نتيجة عدد, عدد {
    ليكن المقبس: عدد = *التدفق;
    ليكن الحالة: عدد = أغلق_مقبسا_خام(المقبس);
    حرر(التدفق);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف أغلق_مستمع_تي_سي_بي(المستمع: مستمع_تي_سي_بي): نتيجة عدد, عدد {
    ليكن المقبس: عدد = *المستمع;
    ليكن الحالة: عدد = أغلق_مقبسا_خام(المقبس);
    حرر(المستمع);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

// Ownership-transfer helpers for std.tls. They intentionally have no English alias.
عام عرف سلم_مقبس_تدفق_تي_سي_بي(التدفق: تدفق_تي_سي_بي): عدد {
    ليكن المقبس: عدد = *التدفق;
    حرر(التدفق);
    أرجع المقبس;
}

عام عرف أغلق_مقبس_تي_سي_بي_خام(المقبس: عدد): عدد { أرجع أغلق_مقبسا_خام(المقبس); }

عام نوع tcp_stream = تدفق_تي_سي_بي;
عام نوع tcp_listener = مستمع_تي_سي_بي;
عام نوع tcp_shutdown = اتجاه_إيقاف_تي_سي_بي;
عام عرف tcp_shutdown_read(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.قراءة(); }
عام عرف tcp_shutdown_write(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.كتابة(); }
عام عرف tcp_shutdown_both(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.كلاهما(); }
عام مرادف tcp_connect = اتصل_تي_سي_بي;
عام مرادف tcp_connect_with_options = اتصل_تي_سي_بي_بخيارات;
عام مرادف tcp_bind = اربط_مستمع_تي_سي_بي;
عام مرادف tcp_bind_with_options = اربط_مستمع_تي_سي_بي_بخيارات;
