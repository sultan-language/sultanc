استورد net.ip;
استورد net.options;
استورد net.socket_address;

مرادف أنشئ_مقبسا_خام = بدائي_إنشاء_مقبس;
مرادف اتصل_بمقبس_خام = بدائي_اتصال_مقبس;
مرادف اربط_مقبسا_خام = بدائي_ربط_مقبس;
مرادف استمع_لمقبس_خام = بدائي_استماع_مقبس;
مرادف اقبل_مقبسا_خام = بدائي_قبول_مقبس;
مرادف أرسل_مقبس_خام = بدائي_إرسال_مقبس;
مرادف استقبل_مقبس_خام = بدائي_استقبال_مقبس;
مرادف أوقف_مقبسا_خام = بدائي_إيقاف_مقبس;
مرادف أغلق_مقبسا_خام = بدائي_إغلاق_مقبس;
مرادف اضبط_غير_حاصر_خام = بدائي_ضبط_مقبس_غير_حاصر;

عام نوع تدفق_تي_سي_بي = صندوق عدد;
عام نوع مستمع_تي_سي_بي = صندوق عدد;

عام نوع اتجاه_إيقاف_تي_سي_بي =
    | قراءة
    | كتابة
    | كلاهما
;

عرف قيمة_اتجاه_الإيقاف(الاتجاه: اتجاه_إيقاف_تي_سي_بي): عدد {
    طابق الاتجاه مع
    | اتجاه_إيقاف_تي_سي_بي.قراءة -> { أرجع 0; }
    | اتجاه_إيقاف_تي_سي_بي.كتابة -> { أرجع 1; }
    | اتجاه_إيقاف_تي_سي_بي.كلاهما -> { أرجع 2; };
}

عرف قيمة_تدفق_تي_سي_بي(التدفق: &تدفق_تي_سي_بي): عدد { أرجع **التدفق; }
عرف قيمة_مستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): عدد { أرجع **المستمع; }

عرف أنشئ_مقبس_تي_سي_بي(العائلة: عدد): نتيجة عدد, عدد {
    // 1=stream and 6=TCP are normalized runtime ABI values.
    دع المقبس: عدد = أنشئ_مقبسا_خام(العائلة, 1, 6);
    لو (المقبس < 0) { أرجع نتيجة.خطأ(المقبس); };
    أرجع نتيجة.نجح(المقبس);
}

عرف طبق_خيارات_قبل_التشغيل(المقبس: عدد, الخيارات: &متجه خيار_مقبس): نتيجة عدد, عدد {
    دع القيم: متجه خيار_مقبس = *الخيارات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق طبق_خيار_مقبس_داخليا(المقبس, القيم[ف]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

عام عرف اتصل_تي_سي_بي_بخيارات(العنوان: &عنوان_مقبس, الخيارات: &متجه خيار_مقبس): نتيجة تدفق_تي_سي_بي, عدد {
    دع ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
        طابق أنشئ_مقبس_تي_سي_بي(العائلة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقبس) -> {
            طابق طبق_خيارات_قبل_التشغيل(المقبس, الخيارات) مع
            | نتيجة.خطأ(الخطأ) -> { دع تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            دع الحالة: عدد = اتصل_بمقبس_خام(المقبس, المرمز.البايتات, المرمز.الطول);
            لو (الحالة < 0) { دع تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الحالة); };
            دع التدفق: تدفق_تي_سي_بي = صندوق المقبس;
            أرجع نتيجة.نجح(التدفق);
        };
    };
}

عام عرف اتصل_تي_سي_بي(العنوان: &عنوان_مقبس): نتيجة تدفق_تي_سي_بي, عدد {
    دع الخيارات: متجه خيار_مقبس = [];
    أرجع اتصل_تي_سي_بي_بخيارات(العنوان, &الخيارات);
}

عام عرف اربط_مستمع_تي_سي_بي_بخيارات(
    العنوان: &عنوان_مقبس,
    التراكم: عدد,
    الخيارات: &متجه خيار_مقبس
): نتيجة مستمع_تي_سي_بي, عدد {
    لو (التراكم < 0) { أرجع نتيجة.خطأ(-22); };
    دع ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
        طابق أنشئ_مقبس_تي_سي_بي(العائلة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقبس) -> {
            طابق طبق_خيارات_قبل_التشغيل(المقبس, الخيارات) مع
            | نتيجة.خطأ(الخطأ) -> { دع تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            دع حالة_الربط: عدد = اربط_مقبسا_خام(المقبس, المرمز.البايتات, المرمز.الطول);
            لو (حالة_الربط < 0) { دع تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(حالة_الربط); };
            دع حالة_الاستماع: عدد = استمع_لمقبس_خام(المقبس, التراكم);
            لو (حالة_الاستماع < 0) { دع تجاهل: عدد = أغلق_مقبسا_خام(المقبس); أرجع نتيجة.خطأ(حالة_الاستماع); };
            دع المستمع: مستمع_تي_سي_بي = صندوق المقبس;
            أرجع نتيجة.نجح(المستمع);
        };
    };
}

عام عرف اربط_مستمع_تي_سي_بي(العنوان: &عنوان_مقبس, التراكم: عدد): نتيجة مستمع_تي_سي_بي, عدد {
    دع الخيارات: متجه خيار_مقبس = [];
    أرجع اربط_مستمع_تي_سي_بي_بخيارات(العنوان, التراكم, &الخيارات);
}

عام عرف اقبل_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): نتيجة تدفق_تي_سي_بي, عدد {
    دع المقبس: عدد = اقبل_مقبسا_خام(قيمة_مستمع_تي_سي_بي(المستمع));
    لو (المقبس < 0) { أرجع نتيجة.خطأ(المقبس); };
    دع التدفق: تدفق_تي_سي_بي = صندوق المقبس;
    أرجع نتيجة.نجح(التدفق);
}

عام عرف اقرأ_تي_سي_بي(
    التدفق: &تدفق_تي_سي_بي,
    المخزن: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع الحالة: متغير متجه غ8 = *المخزن;
    دع المقروء: عدد = استقبل_مقبس_خام(قيمة_تدفق_تي_سي_بي(التدفق), الحالة, الإزاحة, العدد);
    *المخزن := الحالة;
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(المقروء);
}

عام عرف اكتب_تي_سي_بي(
    التدفق: &تدفق_تي_سي_بي,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع البيانات: متجه غ8 = *المحتوى;
    دع المكتوب: عدد = أرسل_مقبس_خام(قيمة_تدفق_تي_سي_بي(التدفق), البيانات, الإزاحة, العدد);
    لو (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
    أرجع نتيجة.نجح(المكتوب);
}

عام عرف أوقف_تي_سي_بي(التدفق: &تدفق_تي_سي_بي, الاتجاه: اتجاه_إيقاف_تي_سي_بي): نتيجة عدد, عدد {
    دع الحالة: عدد = أوقف_مقبسا_خام(قيمة_تدفق_تي_سي_بي(التدفق), قيمة_اتجاه_الإيقاف(الاتجاه));
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_تدفق_تي_سي_بي_غير_حاصر(التدفق: &تدفق_تي_سي_بي, مفعل: منطقي): نتيجة عدد, عدد {
    دع القيمة: متغير عدد = 0;
    لو (مفعل) { القيمة := 1; };
    دع الحالة: عدد = اضبط_غير_حاصر_خام(قيمة_تدفق_تي_سي_بي(التدفق), القيمة);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_مستمع_تي_سي_بي_غير_حاصر(المستمع: &مستمع_تي_سي_بي, مفعل: منطقي): نتيجة عدد, عدد {
    دع القيمة: متغير عدد = 0;
    لو (مفعل) { القيمة := 1; };
    دع الحالة: عدد = اضبط_غير_حاصر_خام(قيمة_مستمع_تي_سي_بي(المستمع), القيمة);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف اضبط_خيار_تدفق_تي_سي_بي(التدفق: &تدفق_تي_سي_بي, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    أرجع طبق_خيار_مقبس_داخليا(قيمة_تدفق_تي_سي_بي(التدفق), الخيار);
}

عام عرف اضبط_خيار_مستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    أرجع طبق_خيار_مقبس_داخليا(قيمة_مستمع_تي_سي_بي(المستمع), الخيار);
}

عام عرف أغلق_تدفق_تي_سي_بي(التدفق: تدفق_تي_سي_بي): نتيجة عدد, عدد {
    دع المقبس: عدد = *التدفق;
    دع الحالة: عدد = أغلق_مقبسا_خام(المقبس);
    حرر(التدفق);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف أغلق_مستمع_تي_سي_بي(المستمع: مستمع_تي_سي_بي): نتيجة عدد, عدد {
    دع المقبس: عدد = *المستمع;
    دع الحالة: عدد = أغلق_مقبسا_خام(المقبس);
    حرر(المستمع);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

// Ownership-transfer helpers for std.tls. They intentionally have no English alias.
عام عرف سلم_مقبس_تدفق_تي_سي_بي(التدفق: تدفق_تي_سي_بي): عدد {
    دع المقبس: عدد = *التدفق;
    حرر(التدفق);
    أرجع المقبس;
}

عام عرف أغلق_مقبس_تي_سي_بي_خام(المقبس: عدد): عدد { أرجع أغلق_مقبسا_خام(المقبس); }

عام نوع tcp_stream = تدفق_تي_سي_بي;
عام نوع tcp_listener = مستمع_تي_سي_بي;
عام نوع tcp_shutdown = اتجاه_إيقاف_تي_سي_بي;
عام عرف tcp_shutdown_read(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.قراءة(); }
عام عرف tcp_shutdown_write(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.كتابة(); }
عام عرف tcp_shutdown_both(): tcp_shutdown { أرجع اتجاه_إيقاف_تي_سي_بي.كلاهما(); }
عام مرادف tcp_connect = اتصل_تي_سي_بي;
عام مرادف tcp_connect_with_options = اتصل_تي_سي_بي_بخيارات;
عام مرادف tcp_bind = اربط_مستمع_تي_سي_بي;
عام مرادف tcp_bind_with_options = اربط_مستمع_تي_سي_بي_بخيارات;
عام مرادف tcp_accept = اقبل_تي_سي_بي;
عام مرادف tcp_read = اقرأ_تي_سي_بي;
عام مرادف tcp_write = اكتب_تي_سي_بي;
عام مرادف tcp_shutdown_stream = أوقف_تي_سي_بي;
عام مرادف tcp_stream_set_nonblocking = اضبط_تدفق_تي_سي_بي_غير_حاصر;
عام مرادف tcp_listener_set_nonblocking = اضبط_مستمع_تي_سي_بي_غير_حاصر;
عام مرادف tcp_stream_set_option = اضبط_خيار_تدفق_تي_سي_بي;
عام مرادف tcp_listener_set_option = اضبط_خيار_مستمع_تي_سي_بي;
عام مرادف tcp_stream_close = أغلق_تدفق_تي_سي_بي;
عام مرادف tcp_listener_close = أغلق_مستمع_تي_سي_بي;
