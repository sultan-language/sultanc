عام مرادف ipv6_is_loopback = هل_عنوان_آيبي6_حلقي;
عام مرادف ip_is_loopback = هل_عنوان_آيبي_حلقي;
عام مرادف ipv4_is_unspecified = هل_عنوان_آيبي4_غير_محدد;
عام مرادف ipv6_is_unspecified = هل_عنوان_آيبي6_غير_محدد;
