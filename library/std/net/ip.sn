استورد text.from_bytes;

// Portable IP address values. These types contain no native sockaddr/AF_* state.
عام نوع عنوان_آيبي4 = {
    أ: ط8,
    ب: ط8,
    ج: ط8,
    د: ط8
};

عام نوع عنوان_آيبي6 = {
    المقاطع: متجه ط16
};

عام نوع عنوان_آيبي =
    | رابع بنوع عنوان_آيبي4
    | سادس بنوع عنوان_آيبي6
;

عام نوع خطأ_تحليل_آيبي =
    | صيغة_غير_صالحة
    | جزء_خارج_المدى
;

عرف رقم_عشري_آيبي(ب: ط8): منطقي {
    أرجع (ب >= 0x30) && (ب <= 0x39);
}

عرف قيمة_سداسية_آيبي(ب: ط8): اختياري طبيعي {
    لو ((ب >= 0x30) && (ب <= 0x39)) { أرجع اختياري.موجود((ب - 0x30) مثل طبيعي); };
    لو ((ب >= 0x61) && (ب <= 0x66)) { أرجع اختياري.موجود(((ب - 0x61) + 10) مثل طبيعي); };
    لو ((ب >= 0x41) && (ب <= 0x46)) { أرجع اختياري.موجود(((ب - 0x41) + 10) مثل طبيعي); };
    أرجع اختياري.لا_شيء();
}

عرف حلل_ثمانية_عشرية_آيبي(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نتيجة ط8, خطأ_تحليل_آيبي {
    دع القيمة: نص = *النص;
    لو ((النهاية <= البداية) || ((النهاية - البداية) > 3)) {
        أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة());
    };
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = القيمة[ف];
        لو (!رقم_عشري_آيبي(ب)) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
        الناتج := (الناتج * 10) + ((ب - 0x30) مثل طبيعي);
        لو (الناتج > 255) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.جزء_خارج_المدى()); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج مثل ط8);
}

عام عرف حلل_عنوان_آيبي4(النص: &نص): نتيجة عنوان_آيبي4, خطأ_تحليل_آيبي {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد == 0) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    دع الأجزاء: متغير متجه ط8 = [];
    دع البداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        لو ((ف == العدد) || (القيمة[ف] == 0x2E)) {
            طابق حلل_ثمانية_عشرية_آيبي(&القيمة, البداية, ف) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الجزء) -> { ألحق(الأجزاء, الجزء); };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    لو ((الطول(الأجزاء) مثل طبيعي) != 4) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    دع الناتج: عنوان_آيبي4 = { أ: الأجزاء[0], ب: الأجزاء[1], ج: الأجزاء[2], د: الأجزاء[3] };
    أرجع نتيجة.نجح(الناتج);
}

عرف حلل_مقطع_سداسي_آيبي6(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نتيجة ط16, خطأ_تحليل_آيبي {
    لو ((النهاية <= البداية) || ((النهاية - البداية) > 4)) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    دع القيمة: نص = *النص;
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        طابق قيمة_سداسية_آيبي(القيمة[ف]) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); }
        | اختياري.موجود(الرقم) -> { الناتج := (الناتج << 4) | الرقم; };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج مثل ط16);
}

عرف يحتوي_نقطة_آيبي(النص: &نص, البداية: طبيعي, النهاية: طبيعي): منطقي {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        لو (القيمة[ف] == 0x2E) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف نص_مدى_آيبي(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    دع القيمة: نص = *النص;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق(البايتات, القيمة[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عرف حلل_جانب_آيبي6(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نتيجة متجه ط16, خطأ_تحليل_آيبي {
    دع القيمة: نص = *النص;
    دع الناتج: متغير متجه ط16 = [];
    لو (البداية == النهاية) { أرجع نتيجة.نجح(الناتج); };
    دع بداية_الجزء: متغير طبيعي = البداية;
    دع ف: متغير طبيعي = البداية;
    طالما (ف <= النهاية) {
        لو ((ف == النهاية) || (القيمة[ف] == 0x3A)) {
            لو (ف == بداية_الجزء) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
            لو (يحتوي_نقطة_آيبي(&القيمة, بداية_الجزء, ف)) {
                لو (ف != النهاية) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
                دع نص4: نص = نص_مدى_آيبي(&القيمة, بداية_الجزء, ف);
                طابق حلل_عنوان_آيبي4(&نص4) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(ع4) -> {
                    دع أول: ط16 = (((ع4.أ مثل ط16) << 8) | (ع4.ب مثل ط16));
                    دع ثان: ط16 = (((ع4.ج مثل ط16) << 8) | (ع4.د مثل ط16));
                    ألحق(الناتج, أول);
                    ألحق(الناتج, ثان);
                };
            } وإلا {
                طابق حلل_مقطع_سداسي_آيبي6(&القيمة, بداية_الجزء, ف) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الجزء) -> { ألحق(الناتج, الجزء); };
            };
            بداية_الجزء := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_عنوان_آيبي6(النص: &نص): نتيجة عنوان_آيبي6, خطأ_تحليل_آيبي {
    دع القيمة: نص = *النص;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    لو (العدد < 2) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    دع موضع_الضغط: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما ((ف + 1) < العدد) {
        دع التالي: طبيعي = ف + 1;
        لو ((القيمة[ف] == 0x3A) && (القيمة[التالي] == 0x3A)) {
            طابق موضع_الضغط مع
            | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); }
            | اختياري.لا_شيء -> { موضع_الضغط := اختياري.موجود(ف); };
            ف := ف + 1;
        };
        ف := ف + 1;
    }

    دع المقاطع: متغير متجه ط16 = [];
    طابق موضع_الضغط مع
    | اختياري.لا_شيء -> {
        طابق حلل_جانب_آيبي6(&القيمة, 0, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الكاملة) -> { المقاطع := الكاملة; };
        لو ((الطول(المقاطع) مثل طبيعي) != 8) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    }
    | اختياري.موجود(الموضع) -> {
        دع يمين_البداية: طبيعي = الموضع + 2;
        طابق حلل_جانب_آيبي6(&القيمة, 0, الموضع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(اليسار) -> {
            طابق حلل_جانب_آيبي6(&القيمة, يمين_البداية, العدد) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(اليمين) -> {
                دع طول_اليسار: طبيعي = الطول(اليسار) مثل طبيعي;
                دع طول_اليمين: طبيعي = الطول(اليمين) مثل طبيعي;
                دع مستخدم: طبيعي = طول_اليسار + طول_اليمين;
                لو (مستخدم >= 8) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
                دع ل: متغير طبيعي = 0;
                طالما (ل < (الطول(اليسار) مثل طبيعي)) { ألحق(المقاطع, اليسار[ل]); ل := ل + 1; }
                دع أصفار: متغير طبيعي = 8 - مستخدم;
                طالما (أصفار > 0) { ألحق(المقاطع, 0); أصفار := أصفار - 1; }
                دع ر: متغير طبيعي = 0;
                طالما (ر < (الطول(اليمين) مثل طبيعي)) { ألحق(المقاطع, اليمين[ر]); ر := ر + 1; }
            };
        };
    };
    دع الناتج: عنوان_آيبي6 = { المقاطع: المقاطع };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_عنوان_آيبي(النص: &نص): نتيجة عنوان_آيبي, خطأ_تحليل_آيبي {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        لو (القيمة[ف] == 0x3A) {
            طابق حلل_عنوان_آيبي6(&القيمة) مع
            | نتيجة.نجح(ع) -> { أرجع نتيجة.نجح(عنوان_آيبي.سادس(ع)); }
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        };
        ف := ف + 1;
    }
    طابق حلل_عنوان_آيبي4(&القيمة) مع
    | نتيجة.نجح(ع) -> { أرجع نتيجة.نجح(عنوان_آيبي.رابع(ع)); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
}

عام عرف بايتات_عنوان_آيبي4(العنوان: &عنوان_آيبي4): متجه ط8 {
    دع ع: عنوان_آيبي4 = *العنوان;
    دع الناتج: متجه ط8 = [ع.أ, ع.ب, ع.ج, ع.د];
    أرجع الناتج;
}

عام عرف بايتات_عنوان_آيبي6(العنوان: &عنوان_آيبي6): متجه ط8 {
    دع ع: عنوان_آيبي6 = *العنوان;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(ع.المقاطع) مثل طبيعي)) {
        دع جزء: ط16 = ع.المقاطع[ف];
        ألحق(الناتج, ((جزء >> 8) & 0xFF) مثل ط8);
        ألحق(الناتج, (جزء & 0xFF) مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف بايتات_عنوان_آيبي(العنوان: &عنوان_آيبي): متجه ط8 {
    دع ع: عنوان_آيبي = *العنوان;
    طابق ع مع
    | عنوان_آيبي.رابع(ع4) -> { أرجع بايتات_عنوان_آيبي4(&ع4); }
    | عنوان_آيبي.سادس(ع6) -> { أرجع بايتات_عنوان_آيبي6(&ع6); };
}

عام عرف عائلة_عنوان_آيبي(العنوان: &عنوان_آيبي): عدد {
    دع ع: عنوان_آيبي = *العنوان;
    طابق ع مع
    | عنوان_آيبي.رابع(_) -> { أرجع 4; }
    | عنوان_آيبي.سادس(_) -> { أرجع 6; };
}

عرف ألحق_عدد_عشري_آيبي(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    لو (القيمة >= 100) { ألحق(*الناتج, (0x30 + (القيمة / 100)) مثل ط8); };
    لو (القيمة >= 10) { ألحق(*الناتج, (0x30 + ((القيمة / 10) % 10)) مثل ط8); };
    ألحق(*الناتج, (0x30 + (القيمة % 10)) مثل ط8);
}

عام عرف نص_عنوان_آيبي4(العنوان: &عنوان_آيبي4): نص {
    دع ع: عنوان_آيبي4 = *العنوان;
    دع الناتج: متغير متجه ط8 = [];
    ألحق_عدد_عشري_آيبي(&متغير الناتج, ع.أ مثل طبيعي); ألحق(الناتج, 0x2E);
    ألحق_عدد_عشري_آيبي(&متغير الناتج, ع.ب مثل طبيعي); ألحق(الناتج, 0x2E);
    ألحق_عدد_عشري_آيبي(&متغير الناتج, ع.ج مثل طبيعي); ألحق(الناتج, 0x2E);
    ألحق_عدد_عشري_آيبي(&متغير الناتج, ع.د مثل طبيعي);
    أرجع من_بايتات(&الناتج);
}

عرف رقم_سداسي_حرف_آيبي(القيمة: طبيعي): ط8 {
    لو (القيمة < 10) { أرجع (0x30 + القيمة) مثل ط8; };
    أرجع (0x61 + (القيمة - 10)) مثل ط8;
}

عرف ألحق_ط16_سداسي_آيبي(الناتج: &متغير متجه ط8, القيمة: ط16): فراغ {
    دع بدأ: متغير منطقي = خطأ;
    دع الإزاحة: متغير عدد = 12;
    طالما (الإزاحة >= 0) {
        دع الرقم: طبيعي = (((القيمة مثل طبيعي) >> (الإزاحة مثل طبيعي)) & 0xF);
        لو (بدأ || (الرقم != 0) || (الإزاحة == 0)) { ألحق(*الناتج, رقم_سداسي_حرف_آيبي(الرقم)); بدأ := صواب; };
        الإزاحة := الإزاحة - 4;
    }
}

عام عرف نص_عنوان_آيبي6(العنوان: &عنوان_آيبي6): نص {
    دع ع: عنوان_آيبي6 = *العنوان;
    لو ((الطول(ع.المقاطع) مثل طبيعي) != 8) { أرجع «::»; };
    دع أفضل_بداية: متغير طبيعي = 8;
    دع أفضل_طول: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        لو (ع.المقاطع[ف] == 0) {
            دع بداية: طبيعي = ف;
            طالما ((ف < 8) && (ع.المقاطع[ف] == 0)) { ف := ف + 1; }
            دع الطول_صفر: طبيعي = ف - بداية;
            لو ((الطول_صفر >= 2) && (الطول_صفر > أفضل_طول)) { أفضل_بداية := بداية; أفضل_طول := الطول_صفر; };
        } وإلا { ف := ف + 1; };
    }
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 8) {
        لو (ف == أفضل_بداية) {
            ألحق_بايتات_نص(&متغير الناتج, «::»);
            ف := ف + أفضل_طول;
        } وإلا {
            لو ((ف > 0) && (ف != (أفضل_بداية + أفضل_طول))) { ألحق(الناتج, 0x3A); };
            ألحق_ط16_سداسي_آيبي(&متغير الناتج, ع.المقاطع[ف]);
            ف := ف + 1;
        };
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف نص_عنوان_آيبي(العنوان: &عنوان_آيبي): نص {
    دع ع: عنوان_آيبي = *العنوان;
    طابق ع مع
    | عنوان_آيبي.رابع(ع4) -> { أرجع نص_عنوان_آيبي4(&ع4); }
    | عنوان_آيبي.سادس(ع6) -> { أرجع نص_عنوان_آيبي6(&ع6); };
}

عام عرف أنشئ_عنوان_آيبي4(أ: ط8, ب: ط8, ج: ط8, د: ط8): عنوان_آيبي4 {
    دع العنوان: عنوان_آيبي4 = { أ: أ, ب: ب, ج: ج, د: د };
    أرجع العنوان;
}

عام عرف أنشئ_عنوان_آيبي6(المقاطع: متجه ط16): نتيجة عنوان_آيبي6, خطأ_تحليل_آيبي {
    لو ((الطول(المقاطع) مثل طبيعي) != 8) { أرجع نتيجة.خطأ(خطأ_تحليل_آيبي.صيغة_غير_صالحة()); };
    دع العنوان: عنوان_آيبي6 = { المقاطع: المقاطع };
    أرجع نتيجة.نجح(العنوان);
}

عام عرف هل_عنوان_آيبي4_حلقي(العنوان: &عنوان_آيبي4): منطقي {
    دع ع: عنوان_آيبي4 = *العنوان;
    أرجع ع.أ == 127;
}

عام عرف هل_عنوان_آيبي6_حلقي(العنوان: &عنوان_آيبي6): منطقي {
    دع ع: عنوان_آيبي6 = *العنوان;
    لو ((الطول(ع.المقاطع) مثل طبيعي) != 8) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < 7) { لو (ع.المقاطع[ف] != 0) { أرجع خطأ; }; ف := ف + 1; }
    أرجع ع.المقاطع[7] == 1;
}

عام عرف هل_عنوان_آيبي_حلقي(العنوان: &عنوان_آيبي): منطقي {
    دع ع: عنوان_آيبي = *العنوان;
    طابق ع مع
    | عنوان_آيبي.رابع(ع4) -> { أرجع هل_عنوان_آيبي4_حلقي(&ع4); }
    | عنوان_آيبي.سادس(ع6) -> { أرجع هل_عنوان_آيبي6_حلقي(&ع6); };
}

عام عرف هل_عنوان_آيبي4_غير_محدد(العنوان: &عنوان_آيبي4): منطقي {
    دع ع: عنوان_آيبي4 = *العنوان;
    أرجع (ع.أ == 0) && (ع.ب == 0) && (ع.ج == 0) && (ع.د == 0);
}

عام عرف هل_عنوان_آيبي6_غير_محدد(العنوان: &عنوان_آيبي6): منطقي {
    دع ع: عنوان_آيبي6 = *العنوان;
    لو ((الطول(ع.المقاطع) مثل طبيعي) != 8) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) { لو (ع.المقاطع[ف] != 0) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عام عرف هل_عنوان_آيبي_غير_محدد(العنوان: &عنوان_آيبي): منطقي {
    دع ع: عنوان_آيبي = *العنوان;
    طابق ع مع
    | عنوان_آيبي.رابع(ع4) -> { أرجع هل_عنوان_آيبي4_غير_محدد(&ع4); }
    | عنوان_آيبي.سادس(ع6) -> { أرجع هل_عنوان_آيبي6_غير_محدد(&ع6); };
}

