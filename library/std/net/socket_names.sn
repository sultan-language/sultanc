استورد net.ip;
استورد net.socket_address;
استورد net.udp;
استورد net.tcp;

استورد os.socket;
استورد os.socket_names;
استورد os.error;

// Local and peer addresses of sockets, and datagrams to and from any
// address on an unconnected UDP socket (Rust UdpSocket::send_to,
// recv_from, local_addr, peer_addr; Go net.UDPConn.WriteTo, ReadFrom,
// LocalAddr, RemoteAddr). Binding to port 0 and reading the local address
// gives the port the system chose. Errors are std.net's numeric statuses.

// A received datagram: its length and who sent it.
عام نوع حزمة_يو_دي_بي = { العدد: عدد, المرسل: عنوان_مقبس };

عرف مقبس_نظام_من_قيمة(القيمة: عدد): مقبس_نظام {
    دع الناتج: مقبس_نظام = { القيمة: القيمة, مفتوح: صواب };
    أرجع الناتج;
}

عرف عنوان_من_مفكوك(المفكوك: &عنوان_مقبس_نظام_مفكوك): نتيجة عنوان_مقبس, عدد {
    دع البايتات: &متجه ط8 = &(*المفكوك).العنوان;
    لو ((*المفكوك).العائلة == 4) {
        دع الرابع: عنوان_آيبي4 = أنشئ_عنوان_آيبي4((*البايتات)[0], (*البايتات)[1], (*البايتات)[2], (*البايتات)[3]);
        أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(عنوان_آيبي.رابع(الرابع), (*المفكوك).المنفذ مثل ط16));
    };
    دع المقاطع: متغير متجه ط16 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق(المقاطع, (((*البايتات)[ف * 2] مثل ط16) << 8) | ((*البايتات)[ف * 2 + 1] مثل ط16));
        ف := ف + 1;
    }
    طابق أنشئ_عنوان_آيبي6(المقاطع) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(-71); }
    | نتيجة.نجح(السادس) -> {
        أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(عنوان_آيبي.سادس(السادس), (*المفكوك).المنفذ مثل ط16));
    };
}

عرف عنوان_محلي_لقيمة(القيمة: عدد, محلي: منطقي): نتيجة عنوان_مقبس, عدد {
    دع المقبس: مقبس_نظام = مقبس_نظام_من_قيمة(القيمة);
    دع النتيجة: متغير نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام = نتيجة.خطأ(خطأ_حد_نظام.مورد_مغلق());
    لو (محلي) { النتيجة := اقرأ_عنوان_محلي_مقبس_نظام(&المقبس); }
    وإلا { النتيجة := اقرأ_عنوان_نظير_مقبس_نظام(&المقبس); };
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المفكوك) -> { أرجع عنوان_من_مفكوك(&المفكوك); };
}

عام عرف العنوان_المحلي_يو_دي_بي(المقبس: &مقبس_يو_دي_بي): نتيجة عنوان_مقبس, عدد {
    أرجع عنوان_محلي_لقيمة(**المقبس, صواب);
}
// The peer of a connected UDP socket.
عام عرف عنوان_نظير_يو_دي_بي(المقبس: &مقبس_يو_دي_بي): نتيجة عنوان_مقبس, عدد {
    أرجع عنوان_محلي_لقيمة(**المقبس, خطأ);
}
عام عرف العنوان_المحلي_تي_سي_بي(التدفق: &تدفق_تي_سي_بي): نتيجة عنوان_مقبس, عدد {
    أرجع عنوان_محلي_لقيمة(**التدفق, صواب);
}
عام عرف عنوان_نظير_تي_سي_بي(التدفق: &تدفق_تي_سي_بي): نتيجة عنوان_مقبس, عدد {
    أرجع عنوان_محلي_لقيمة(**التدفق, خطأ);
}
عام عرف العنوان_المحلي_لمستمع_تي_سي_بي(المستمع: &مستمع_تي_سي_بي): نتيجة عنوان_مقبس, عدد {
    أرجع عنوان_محلي_لقيمة(**المستمع, صواب);
}

// Sends المحتوى[الإزاحة .. الإزاحة + العدد) as one datagram to العنوان.
عام عرف أرسل_إلى_يو_دي_بي(
    المقبس: &مقبس_يو_دي_بي, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد,
    العنوان: &عنوان_مقبس
): نتيجة عدد, عدد {
    دع ع: عنوان_مقبس = *العنوان;
    طابق رمز_عنوان_مقبس_للتشغيل(&ع) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرمز) -> {
        دع المقبس_النظامي: مقبس_نظام = مقبس_نظام_من_قيمة(**المقبس);
        دع البايتات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (المرمز.الطول مثل طبيعي)) { ألحق(البايتات, المرمز.البايتات[ف]); ف := ف + 1; }
        طابق أرسل_إلى_مقبس_نظام(&المقبس_النظامي, المحتوى, الإزاحة, العدد, &البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(المرسل) -> { أرجع نتيجة.نجح(المرسل); };
    };
}

// Receives one datagram into المخزن[الإزاحة ..] (at most العدد bytes; the
// rest of a longer datagram is dropped) and reports its sender.
عام عرف استقبل_من_يو_دي_بي(
    المقبس: &مقبس_يو_دي_بي, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة حزمة_يو_دي_بي, عدد {
    دع المقبس_النظامي: مقبس_نظام = مقبس_نظام_من_قيمة(**المقبس);
    طابق استقبل_من_مقبس_نظام(&المقبس_النظامي, المخزن, الإزاحة, العدد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(الحزمة) -> {
        طابق عنوان_من_مفكوك(&الحزمة.المرسل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المرسل) -> {
            دع الناتج: حزمة_يو_دي_بي = { العدد: الحزمة.المقروء, المرسل: المرسل };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}

عام نوع udp_datagram = حزمة_يو_دي_بي;
عام مرادف udp_local_addr = العنوان_المحلي_يو_دي_بي;
عام مرادف udp_peer_addr = عنوان_نظير_يو_دي_بي;
عام مرادف tcp_local_addr = العنوان_المحلي_تي_سي_بي;
عام مرادف tcp_peer_addr = عنوان_نظير_تي_سي_بي;
عام مرادف tcp_listener_local_addr = العنوان_المحلي_لمستمع_تي_سي_بي;
عام مرادف udp_send_to = أرسل_إلى_يو_دي_بي;
عام مرادف udp_recv_from = استقبل_من_يو_دي_بي;
