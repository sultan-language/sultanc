استورد net.ip;
استورد text.from_bytes;
استورد text.number;

مرادف رمز_عنوان_مقبس_خام = بدائي_ترميز_عنوان_مقبس;

عام نوع عنوان_مقبس = {
    الآيبي: عنوان_آيبي,
    المنفذ: غ16
};

عام نوع خطأ_تحليل_عنوان_مقبس =
    | صيغة_غير_صالحة
    | عنوان_غير_صالح
    | منفذ_غير_صالح
;

// Internal std representation of the Target-produced sockaddr bytes.
// Application APIs should use SocketAddr rather than inspect these bytes.
عام نوع عنوان_مقبس_مرمز = {
    البايتات: متجه غ8,
    الطول: عدد
};

عام عرف أنشئ_عنوان_مقبس(الآيبي: عنوان_آيبي, المنفذ: غ16): عنوان_مقبس {
    دع الناتج: عنوان_مقبس = { الآيبي: الآيبي, المنفذ: المنفذ };
    أرجع الناتج;
}

عرف منفذ_من_نص(النص: &نص): اختيار غ16 {
    طابق حلل_غير_موقع(النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(القيمة) -> {
        لو (القيمة > 65535) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(القيمة مثل غ16);
    };
}

عرف نص_مدى_عنوان_مقبس(النص: &نص, البداية: غير_موقع, النهاية: غير_موقع): نص {
    دع القيمة: نص = *النص;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) { ألحق(البايتات, القيمة[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عام عرف حلل_عنوان_مقبس(النص: &نص): نتيجة عنوان_مقبس, خطأ_تحليل_عنوان_مقبس {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد < 3) { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة()); };

    لو (القيمة[0] == 0x5B) {
        دع إغلاق: متغير غير_موقع = 1;
        بينما ((إغلاق < العدد) && (القيمة[إغلاق] != 0x5D)) { إغلاق := إغلاق + 1; }
        لو ((إغلاق >= العدد) || ((إغلاق + 2) > العدد)) { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة()); };
        دع بعد_الإغلاق: غير_موقع = إغلاق + 1;
        لو ((بعد_الإغلاق >= العدد) || (القيمة[بعد_الإغلاق] != 0x3A)) { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة()); };
        دع بداية_المنفذ: غير_موقع = إغلاق + 2;
        دع نص_الآيبي: نص = نص_مدى_عنوان_مقبس(&القيمة, 1, إغلاق);
        دع نص_المنفذ: نص = نص_مدى_عنوان_مقبس(&القيمة, بداية_المنفذ, العدد);
        طابق حلل_عنوان_آيبي6(&نص_الآيبي) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.عنوان_غير_صالح()); }
        | نتيجة.نجح(ع6) -> {
            طابق منفذ_من_نص(&نص_المنفذ) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.منفذ_غير_صالح()); }
            | اختيار.بعض(المنفذ) -> {
                دع الآيبي: عنوان_آيبي = عنوان_آيبي.سادس(ع6);
                أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
            };
        };
    };

    // IPv4 socket addresses use the final ':' as the port separator.
    دع الفاصل: متغير غير_موقع = العدد;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (القيمة[ف] == 0x3A) { الفاصل := ف; };
        ف := ف + 1;
    }
    لو ((الفاصل == العدد) || (الفاصل == 0) || ((الفاصل + 1) >= العدد)) {
        أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.صيغة_غير_صالحة());
    };
    دع بداية_المنفذ: غير_موقع = الفاصل + 1;
    دع نص_الآيبي: نص = نص_مدى_عنوان_مقبس(&القيمة, 0, الفاصل);
    دع نص_المنفذ: نص = نص_مدى_عنوان_مقبس(&القيمة, بداية_المنفذ, العدد);
    طابق حلل_عنوان_آيبي4(&نص_الآيبي) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.عنوان_غير_صالح()); }
    | نتيجة.نجح(ع4) -> {
        طابق منفذ_من_نص(&نص_المنفذ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تحليل_عنوان_مقبس.منفذ_غير_صالح()); }
        | اختيار.بعض(المنفذ) -> {
            دع الآيبي: عنوان_آيبي = عنوان_آيبي.رابع(ع4);
            أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ));
        };
    };
}

عام عرف نص_عنوان_مقبس(العنوان: &عنوان_مقبس): نص {
    دع ع: عنوان_مقبس = *العنوان;
    دع البايتات: متغير متجه غ8 = [];
    طابق ع.الآيبي مع
    | عنوان_آيبي.رابع(ع4) -> {
        دع نص_الآيبي: نص = نص_عنوان_آيبي4(&ع4);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(نص_الآيبي) مثل غير_موقع)) { ألحق(البايتات, نص_الآيبي[ف]); ف := ف + 1; }
    }
    | عنوان_آيبي.سادس(ع6) -> {
        ألحق(البايتات, 0x5B);
        دع نص_الآيبي: نص = نص_عنوان_آيبي6(&ع6);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(نص_الآيبي) مثل غير_موقع)) { ألحق(البايتات, نص_الآيبي[ف]); ف := ف + 1; }
        ألحق(البايتات, 0x5D);
    };
    ألحق(البايتات, 0x3A);
    دع نص_المنفذ: نص = غير_موقع_إلى_نص(ع.المنفذ مثل غير_موقع);
    دع م: متغير غير_موقع = 0;
    بينما (م < (الطول(نص_المنفذ) مثل غير_موقع)) { ألحق(البايتات, نص_المنفذ[م]); م := م + 1; }
    أرجع من_بايتات(&البايتات);
}

// The runtime translates the normalized family and portable address bytes into
// the target's native sockaddr representation. Std never owns AF_* constants/layout.
عام عرف رمز_عنوان_مقبس_للتشغيل(العنوان: &عنوان_مقبس): نتيجة عنوان_مقبس_مرمز, عدد {
    دع ع: عنوان_مقبس = *العنوان;
    دع العائلة: عدد = عائلة_عنوان_آيبي(&ع.الآيبي);
    دع البايتات_الآيبي: متجه غ8 = بايتات_عنوان_آيبي(&ع.الآيبي);
    دع الخارج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 28) { ألحق(الخارج, 0); ف := ف + 1; }
    دع الطول_الخام: عدد = رمز_عنوان_مقبس_خام(العائلة, ع.المنفذ مثل عدد, البايتات_الآيبي, الخارج);
    لو (الطول_الخام < 0) { أرجع نتيجة.خطأ(الطول_الخام); };
    دع المرمز: عنوان_مقبس_مرمز = { البايتات: الخارج, الطول: الطول_الخام };
    أرجع نتيجة.نجح(المرمز);
}

عام عرف منفذ_عنوان_مقبس(العنوان: &عنوان_مقبس): غ16 {
    دع ع: عنوان_مقبس = *العنوان;
    أرجع ع.المنفذ;
}

عام عرف عائلة_عنوان_مقبس(العنوان: &عنوان_مقبس): عدد {
    دع ع: عنوان_مقبس = *العنوان;
    أرجع عائلة_عنوان_آيبي(&ع.الآيبي);
}

عام عرف نص_آيبي_عنوان_مقبس(العنوان: &عنوان_مقبس): نص {
    دع ع: عنوان_مقبس = *العنوان;
    أرجع نص_عنوان_آيبي(&ع.الآيبي);
}

عام نوع socket_addr = عنوان_مقبس;
عام نوع socket_addr_parse_error = خطأ_تحليل_عنوان_مقبس;
عام مرادف new_socket_addr = أنشئ_عنوان_مقبس;
عام مرادف parse_socket_addr = حلل_عنوان_مقبس;
عام مرادف socket_addr_to_text = نص_عنوان_مقبس;
عام مرادف socket_addr_port = منفذ_عنوان_مقبس;
عام مرادف socket_addr_family = عائلة_عنوان_مقبس;
عام مرادف socket_addr_ip_text = نص_آيبي_عنوان_مقبس;
