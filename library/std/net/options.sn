استورد os.socket;
استورد os.error;
عرف اضبط_خيار_مقبس_خام(المعرف: عدد, الخيار: عدد, القيمة: عدد): عدد {
    دع المقبس: مقبس_نظام = { القيمة: المعرف, مفتوح: صواب };
    طابق اضبط_خيار_مقبس_نظام(&المقبس, الخيار, القيمة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(الحالة) -> { أرجع الحالة; };
}

// Public typed socket options. Numeric runtime IDs remain an implementation detail.
عام نوع خيار_مقبس =
    | بلا_تأخير_تي_سي_بي بنوع منطقي
    | إعادة_استخدام_العنوان بنوع منطقي
    | إبقاء_حي بنوع منطقي
    | عمر_آيبي4 بنوع طبيعي
    | قفزات_آيبي6 بنوع طبيعي
    | مخزن_استقبال بنوع طبيعي
    | مخزن_إرسال بنوع طبيعي
    // Read/write timeouts in milliseconds (SO_RCVTIMEO / SO_SNDTIMEO); 0
    // means block without a limit. An expired timeout fails the call with
    // the platform's would-block or timed-out error.
    | مهلة_استقبال بنوع طبيعي
    | مهلة_إرسال بنوع طبيعي
    // SO_REUSEPORT: several listening sockets bind one address, and the
    // kernel spreads new connections over them (Linux, FreeBSD's
    // SO_REUSEPORT_LB); macOS allows the binding without balancing, and
    // Windows has no such option.
    | إعادة_استخدام_المنفذ بنوع منطقي
;

عرف معرف_وقيمة_خيار_مقبس(الخيار: خيار_مقبس): نتيجة متجه عدد, عدد {
    دع الناتج: متغير متجه عدد = [];
    طابق الخيار مع
    | خيار_مقبس.بلا_تأخير_تي_سي_بي(مفعل) -> { ألحق(الناتج, 1); إذا (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.إعادة_استخدام_العنوان(مفعل) -> { ألحق(الناتج, 2); إذا (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.إبقاء_حي(مفعل) -> { ألحق(الناتج, 3); إذا (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.عمر_آيبي4(القيمة) -> {
        إذا ((القيمة == 0) || (القيمة > 255)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 4); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.قفزات_آيبي6(القيمة) -> {
        إذا (القيمة > 255) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 5); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مخزن_استقبال(القيمة) -> {
        إذا ((القيمة == 0) || (القيمة > 2147483647)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 6); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مخزن_إرسال(القيمة) -> {
        إذا ((القيمة == 0) || (القيمة > 2147483647)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 7); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مهلة_استقبال(القيمة) -> {
        إذا (القيمة > 2147483647) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 8); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مهلة_إرسال(القيمة) -> {
        إذا (القيمة > 2147483647) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 9); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.إعادة_استخدام_المنفذ(مفعل) -> { ألحق(الناتج, 10); إذا (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; };
    أرجع نتيجة.نجح(الناتج);
}

// Used by std.net.tcp while the socket descriptor remains encapsulated there.
عام عرف طبق_خيار_مقبس_داخليا(المقبس: عدد, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    طابق معرف_وقيمة_خيار_مقبس(الخيار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الزوج) -> {
        دع الحالة: عدد = اضبط_خيار_مقبس_خام(المقبس, الزوج[0], الزوج[1]);
        إذا (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        أرجع نتيجة.نجح(الحالة);
    };
}

عام نوع socket_option = خيار_مقبس;

عام عرف tcp_nodelay(مفعل: منطقي): socket_option { أرجع خيار_مقبس.بلا_تأخير_تي_سي_بي(مفعل); }
عام عرف reuse_address(مفعل: منطقي): socket_option { أرجع خيار_مقبس.إعادة_استخدام_العنوان(مفعل); }
عام عرف keepalive(مفعل: منطقي): socket_option { أرجع خيار_مقبس.إبقاء_حي(مفعل); }
عام عرف ipv4_ttl(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.عمر_آيبي4(القيمة); }
عام عرف ipv6_hop_limit(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.قفزات_آيبي6(القيمة); }
عام عرف receive_buffer(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.مخزن_استقبال(القيمة); }
عام عرف send_buffer(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.مخزن_إرسال(القيمة); }
عام عرف receive_timeout_ms(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.مهلة_استقبال(القيمة); }
عام عرف send_timeout_ms(القيمة: طبيعي): socket_option { أرجع خيار_مقبس.مهلة_إرسال(القيمة); }
عام عرف reuse_port(مفعل: منطقي): socket_option { أرجع خيار_مقبس.إعادة_استخدام_المنفذ(مفعل); }
