خارجي عرف تشغيل_ضبط_خيار_مقبس(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد;
عرف اضبط_خيار_مقبس_خام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد { أرجع تشغيل_ضبط_خيار_مقبس(الحجة_0, الحجة_1, الحجة_2); }

// Public typed socket options. Numeric runtime IDs remain an implementation detail.
عام نوع خيار_مقبس =
    | بلا_تأخير_تي_سي_بي بنوع منطقي
    | إعادة_استخدام_العنوان بنوع منطقي
    | إبقاء_حي بنوع منطقي
    | عمر_آيبي4 بنوع غير_موقع
    | قفزات_آيبي6 بنوع غير_موقع
    | مخزن_استقبال بنوع غير_موقع
    | مخزن_إرسال بنوع غير_موقع
;

عرف معرف_وقيمة_خيار_مقبس(الخيار: خيار_مقبس): نتيجة متجه عدد, عدد {
    دع الناتج: متغير متجه عدد = [];
    طابق الخيار مع
    | خيار_مقبس.بلا_تأخير_تي_سي_بي(مفعل) -> { ألحق(الناتج, 1); لو (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.إعادة_استخدام_العنوان(مفعل) -> { ألحق(الناتج, 2); لو (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.إبقاء_حي(مفعل) -> { ألحق(الناتج, 3); لو (مفعل) { ألحق(الناتج, 1); } وإلا { ألحق(الناتج, 0); }; }
    | خيار_مقبس.عمر_آيبي4(القيمة) -> {
        لو ((القيمة == 0) || (القيمة > 255)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 4); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.قفزات_آيبي6(القيمة) -> {
        لو (القيمة > 255) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 5); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مخزن_استقبال(القيمة) -> {
        لو ((القيمة == 0) || (القيمة > 2147483647)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 6); ألحق(الناتج, القيمة مثل عدد);
    }
    | خيار_مقبس.مخزن_إرسال(القيمة) -> {
        لو ((القيمة == 0) || (القيمة > 2147483647)) { أرجع نتيجة.خطأ(-22); };
        ألحق(الناتج, 7); ألحق(الناتج, القيمة مثل عدد);
    };
    أرجع نتيجة.نجح(الناتج);
}

// Used by std.net.tcp while the socket descriptor remains encapsulated there.
عام عرف طبق_خيار_مقبس_داخليا(المقبس: عدد, الخيار: خيار_مقبس): نتيجة عدد, عدد {
    طابق معرف_وقيمة_خيار_مقبس(الخيار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الزوج) -> {
        دع الحالة: عدد = اضبط_خيار_مقبس_خام(المقبس, الزوج[0], الزوج[1]);
        لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        أرجع نتيجة.نجح(الحالة);
    };
}

عام نوع socket_option = خيار_مقبس;

عام عرف tcp_nodelay(مفعل: منطقي): socket_option { أرجع خيار_مقبس.بلا_تأخير_تي_سي_بي(مفعل); }
عام عرف reuse_address(مفعل: منطقي): socket_option { أرجع خيار_مقبس.إعادة_استخدام_العنوان(مفعل); }
عام عرف keepalive(مفعل: منطقي): socket_option { أرجع خيار_مقبس.إبقاء_حي(مفعل); }
عام عرف ipv4_ttl(القيمة: غير_موقع): socket_option { أرجع خيار_مقبس.عمر_آيبي4(القيمة); }
عام عرف ipv6_hop_limit(القيمة: غير_موقع): socket_option { أرجع خيار_مقبس.قفزات_آيبي6(القيمة); }
عام عرف receive_buffer(القيمة: غير_موقع): socket_option { أرجع خيار_مقبس.مخزن_استقبال(القيمة); }
عام عرف send_buffer(القيمة: غير_موقع): socket_option { أرجع خيار_مقبس.مخزن_إرسال(القيمة); }
