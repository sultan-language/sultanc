استورد uuid.uuid;
استورد os.entropy;
استورد os.error;
استورد time.time;

// UUID generation (RFC 9562). Kept apart from uuid.sn so parsing and
// formatting stay usable on targets with no entropy or clock source.
// Errors are the negative OS error codes of the entropy or clock call.

عرف بايتات_عشوائية_لمعرف(): نتيجة متجه ط8, عدد {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) { ألحق(البايتات, 0 مثل ط8); ف := ف + 1; }
    طابق املأ_بايتات_عشوائية_النظام(&متغير البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(البايتات); };
}

// Sets the version nibble (byte 6) and the RFC variant bits 10 (byte 8).
عرف اختم_معرفا(البايتات: &متغير متجه ط8, الإصدار: ط8): فراغ {
    (*البايتات)[6] := ((*البايتات)[6] & 0x0F) | (الإصدار << 4);
    (*البايتات)[8] := ((*البايتات)[8] & 0x3F) | 0x80;
}

// Version 4: 122 random bits from the operating system's CSPRNG.
عام عرف معرف_فريد_عشوائي(): نتيجة معرّف_فريد, عدد {
    طابق بايتات_عشوائية_لمعرف() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع البايتات: متغير متجه ط8 = القيمة;
        اختم_معرفا(&متغير البايتات, 4);
        دع الناتج: معرّف_فريد = { البايتات: البايتات };
        أرجع نتيجة.نجح(الناتج);
    };
}

// Version 7: a 48-bit big-endian Unix time in milliseconds, then 74 random
// bits, so identifiers sort by creation time.
عام عرف معرف_فريد_زمني(): نتيجة معرّف_فريد, عدد {
    دع الملي: متغير عدد = 0;
    طابق وقت_نظام_نانو() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النانو) -> { الملي := النانو / 1000000; };
    إذا (الملي < 0) { أرجع نتيجة.خطأ(-75); };
    طابق بايتات_عشوائية_لمعرف() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع البايتات: متغير متجه ط8 = القيمة;
        دع الزمن: ط64 = الملي مثل ط64;
        دع ف: متغير طبيعي = 0;
        طالما (ف < 6) {
            دع الإزاحة: ط64 = ((5 - ف) * 8) مثل ط64;
            البايتات[ف] := ((الزمن >> الإزاحة) & 255) مثل ط8;
            ف := ف + 1;
        }
        اختم_معرفا(&متغير البايتات, 7);
        دع الناتج: معرّف_فريد = { البايتات: البايتات };
        أرجع نتيجة.نجح(الناتج);
    };
}

عام مرادف uuid_v4 = معرف_فريد_عشوائي;
عام مرادف uuid_v7 = معرف_فريد_زمني;
