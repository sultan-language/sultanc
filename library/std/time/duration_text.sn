استورد math.integer;
استورد time.duration;
استورد text.number;
استورد text.from_bytes;

// Durations as text in Go's notation ("1h2m3.5s", "1.5ms", "-2µs", "0s"),
// and checked absolute value and division (Go time.Duration.String and
// time.ParseDuration; Rust Duration::checked_div).

عام نوع خطأ_مدة =
    | صيغة_غير_صالحة
    | وحدة_مجهولة
    | تجاوز
;

// The magnitude of a nanosecond count as a طبيعي, -2^63 included.
عرف مقدار_نانو(القيمة: عدد): طبيعي {
    إذا (القيمة >= 0) { أرجع القيمة مثل طبيعي; };
    أرجع ((0 - (القيمة + 1)) مثل طبيعي) + 1;
}

// "<whole>[.<fraction>]" of القيمة / 10^المنازل with trailing zeros of the
// fraction removed.
عرف ألحق_كسرا_عشريا(البايتات: &متغير متجه ط8, القيمة: طبيعي, المنازل: طبيعي): فراغ {
    دع القاسم: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 0;
    طالما (ف < المنازل) { القاسم := القاسم * 10; ف := ف + 1; }
    ألحق_بايتات_نص(البايتات, طبيعي_إلى_نص(القيمة / القاسم));
    دع الكسر: متغير طبيعي = القيمة % القاسم;
    إذا (الكسر == 0) { أرجع; };
    دع الأرقام: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < المنازل) {
        ألحق(الأرقام, ((الكسر % 10) مثل ط8) + 48);
        الكسر := الكسر / 10;
        ف := ف + 1;
    }
    // الأرقام holds the fraction's digits from the last; skip its zeros.
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < المنازل && الأرقام[البداية] == 48) { البداية := البداية + 1; }
    ألحق(*البايتات, 46);
    ف := المنازل;
    طالما (ف > البداية) { ف := ف - 1; ألحق(*البايتات, الأرقام[ف]); }
}

// Go's Duration.String: below one second a single unit (ns, µs, ms) with a
// decimal fraction; otherwise hours, minutes and seconds ("72h3m0.5s"), with
// zero leading units left out ("1m0s", "2s"). Zero is "0s".
عام عرف نسق_المدة(المدة: &مدة): نص {
    دع القيمة: عدد = (*المدة).النانوثواني;
    إذا (القيمة == 0) { أرجع «0s»; };
    دع المقدار: طبيعي = مقدار_نانو(القيمة);
    دع البايتات: متغير متجه ط8 = [];
    إذا (القيمة < 0) { ألحق(البايتات, 45); };
    إذا (المقدار < 1000) {
        ألحق_كسرا_عشريا(&متغير البايتات, المقدار, 0);
        ألحق(البايتات, 110); ألحق(البايتات, 115);
    } وإلا إذا (المقدار < 1000000) {
        ألحق_كسرا_عشريا(&متغير البايتات, المقدار, 3);
        // µ is U+00B5 (0xC2 0xB5), as Go prints it.
        ألحق(البايتات, 0xC2); ألحق(البايتات, 0xB5); ألحق(البايتات, 115);
    } وإلا إذا (المقدار < 1000000000) {
        ألحق_كسرا_عشريا(&متغير البايتات, المقدار, 6);
        ألحق(البايتات, 109); ألحق(البايتات, 115);
    } وإلا {
        دع الساعات: طبيعي = المقدار / 3600000000000;
        دع الدقائق: طبيعي = (المقدار / 60000000000) % 60;
        دع الثواني_نانو: طبيعي = المقدار % 60000000000;
        إذا (الساعات > 0) {
            ألحق_بايتات_نص(&متغير البايتات, طبيعي_إلى_نص(الساعات));
            ألحق(البايتات, 104);
        };
        إذا (الساعات > 0 || الدقائق > 0) {
            ألحق_بايتات_نص(&متغير البايتات, طبيعي_إلى_نص(الدقائق));
            ألحق(البايتات, 109);
        };
        ألحق_كسرا_عشريا(&متغير البايتات, الثواني_نانو, 9);
        ألحق(البايتات, 115);
    };
    أرجع من_بايتات(&البايتات);
}

// Nanoseconds per unit for a unit spelling, or nothing.
عرف نانو_الوحدة(الوحدة: &متجه ط8): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*الوحدة) مثل طبيعي;
    إذا (العدد == 1) {
        إذا ((*الوحدة)[0] == 115) { أرجع اختياري.موجود(1000000000); };
        إذا ((*الوحدة)[0] == 109) { أرجع اختياري.موجود(60000000000); };
        إذا ((*الوحدة)[0] == 104) { أرجع اختياري.موجود(3600000000000); };
        أرجع اختياري.لا_شيء();
    };
    إذا (العدد == 2 && (*الوحدة)[1] == 115) {
        إذا ((*الوحدة)[0] == 110) { أرجع اختياري.موجود(1); };
        إذا ((*الوحدة)[0] == 117) { أرجع اختياري.موجود(1000); };
        إذا ((*الوحدة)[0] == 109) { أرجع اختياري.موجود(1000000); };
        أرجع اختياري.لا_شيء();
    };
    // µs as U+00B5 (C2 B5) or U+03BC (CE BC), followed by s.
    إذا (العدد == 3 && (*الوحدة)[2] == 115
        && (((*الوحدة)[0] == 0xC2 && (*الوحدة)[1] == 0xB5) || ((*الوحدة)[0] == 0xCE && (*الوحدة)[1] == 0xBC))) {
        أرجع اختياري.موجود(1000);
    };
    أرجع اختياري.لا_شيء();
}

// floor(الكسر * الوحدة / المقياس) for الكسر < المقياس <= 10^17, with the
// unit split as c * 10^a (c <= 36).
عرف كسر_بالوحدة(الكسر: طبيعي, المقياس: طبيعي, الوحدة: طبيعي): طبيعي {
    دع المعامل: متغير طبيعي = الوحدة;
    دع القوة: متغير طبيعي = 1;
    طالما (المعامل % 10 == 0) { المعامل := المعامل / 10; القوة := القوة * 10; }
    إذا (القوة >= المقياس) { أرجع الكسر * المعامل * (القوة / المقياس); };
    أرجع (الكسر * المعامل) / (المقياس / القوة);
}

// Go's ParseDuration: an optional sign, then one or more decimal numbers
// (with an optional fraction) each followed by a unit: ns, us (µs, μs),
// ms, s, m, h. "0" alone is zero. The total must fit in a signed 64-bit
// nanosecond count.
عام عرف حلل_المدة(النص: &نص): نتيجة مدة, خطأ_مدة {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    دع سالب: متغير منطقي = خطأ;
    إذا (العدد > 0 && ((*النص)[0] == 45 || (*النص)[0] == 43)) {
        سالب := (*النص)[0] == 45;
        الموضع := 1;
    };
    إذا (العدد == الموضع + 1 && (*النص)[الموضع] == 48) { أرجع نتيجة.نجح(مدة_صفر()); };
    إذا (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_مدة.صيغة_غير_صالحة()); };
    دع المجموع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        // The whole part.
        دع الصحيح: متغير طبيعي = 0;
        دع أرقام_صحيحة: متغير طبيعي = 0;
        دع تجاوز_صحيح: متغير منطقي = خطأ;
        طالما (الموضع < العدد && (*النص)[الموضع] >= 48 && (*النص)[الموضع] <= 57) {
            إذا (الصحيح > 922337203685477580) { تجاوز_صحيح := صواب; }
            وإلا { الصحيح := الصحيح * 10 + (((*النص)[الموضع] - 48) مثل طبيعي); };
            أرقام_صحيحة := أرقام_صحيحة + 1;
            الموضع := الموضع + 1;
        }
        // The fraction: digits kept while they fit, as a value and a scale.
        دع الكسر: متغير طبيعي = 0;
        دع المقياس: متغير طبيعي = 1;
        دع أرقام_الكسر: متغير طبيعي = 0;
        إذا (الموضع < العدد && (*النص)[الموضع] == 46) {
            الموضع := الموضع + 1;
            طالما (الموضع < العدد && (*النص)[الموضع] >= 48 && (*النص)[الموضع] <= 57) {
                إذا (المقياس < 100000000000000000) {
                    الكسر := الكسر * 10 + (((*النص)[الموضع] - 48) مثل طبيعي);
                    المقياس := المقياس * 10;
                };
                أرقام_الكسر := أرقام_الكسر + 1;
                الموضع := الموضع + 1;
            }
        };
        إذا (أرقام_صحيحة == 0 && أرقام_الكسر == 0) { أرجع نتيجة.خطأ(خطأ_مدة.صيغة_غير_صالحة()); };
        دع الوحدة: متغير متجه ط8 = [];
        طالما (الموضع < العدد && (*النص)[الموضع] != 46 && ((*النص)[الموضع] < 48 || (*النص)[الموضع] > 57)) {
            ألحق(الوحدة, (*النص)[الموضع]);
            الموضع := الموضع + 1;
        }
        إذا ((الطول(الوحدة) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_مدة.صيغة_غير_صالحة()); };
        دع نانو: متغير طبيعي = 0;
        طابق نانو_الوحدة(&الوحدة) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مدة.وحدة_مجهولة()); }
        | اختياري.موجود(القيمة) -> { نانو := القيمة; };
        إذا (تجاوز_صحيح) { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); };
        طابق ضرب_طبيعي_متحقق(الصحيح, نانو) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); }
        | اختياري.موجود(الجزء) -> {
            // fraction * unit / scale without overflow: a unit is c * 10^a
            // with c <= 36, and the scale is at most 10^17.
            دع كسر_نانو: طبيعي = كسر_بالوحدة(الكسر, المقياس, نانو);
            طابق جمع_طبيعي_متحقق(الجزء, كسر_نانو) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); }
            | اختياري.موجود(المكون) -> {
                طابق جمع_طبيعي_متحقق(المجموع, المكون) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); }
                | اختياري.موجود(الجديد) -> { المجموع := الجديد; };
            };
        };
    }
    إذا (سالب) {
        إذا (المجموع > 9223372036854775808) { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); };
        إذا (المجموع == 9223372036854775808) { أرجع نتيجة.نجح(مدة_من_نانوثواني(-9223372036854775807 - 1)); };
        أرجع نتيجة.نجح(مدة_من_نانوثواني(0 - (المجموع مثل عدد)));
    };
    إذا (المجموع > 9223372036854775807) { أرجع نتيجة.خطأ(خطأ_مدة.تجاوز()); };
    أرجع نتيجة.نجح(مدة_من_نانوثواني(المجموع مثل عدد));
}

// |المدة|; nothing for -2^63 ns, which has no positive counterpart.
عام عرف مطلق_المدة(المدة: &مدة): اختياري مدة {
    دع القيمة: عدد = (*المدة).النانوثواني;
    إذا (القيمة >= 0) { أرجع اختياري.موجود(مدة_من_نانوثواني(القيمة)); };
    إذا (القيمة == -9223372036854775807 - 1) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(مدة_من_نانوثواني(0 - القيمة));
}

// المدة / القاسم rounded toward zero; nothing for a zero divisor or an
// overflowing quotient.
عام عرف اقسم_المدة(المدة: &مدة, القاسم: عدد): اختياري مدة {
    إذا (القاسم == 0) { أرجع اختياري.لا_شيء(); };
    دع القيمة: عدد = (*المدة).النانوثواني;
    إذا (القاسم == -1 && القيمة == -9223372036854775807 - 1) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(مدة_من_نانوثواني(القيمة / القاسم));
}

عام مرادف duration_error = خطأ_مدة;
عام مرادف duration_error.invalid_format = خطأ_مدة.صيغة_غير_صالحة;
عام مرادف duration_error.unknown_unit = خطأ_مدة.وحدة_مجهولة;
عام مرادف duration_error.overflow = خطأ_مدة.تجاوز;
عام مرادف format_duration = نسق_المدة;
عام مرادف parse_duration = حلل_المدة;
عام مرادف duration_abs = مطلق_المدة;
عام مرادف duration_divide = اقسم_المدة;
