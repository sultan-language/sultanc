استورد os.clock;
استورد os.error;

عرف وقت_رتيب_داخليا(): نتيجة لحظة_رتيبة_نظام, خطأ_حد_نظام {
    أرجع اقرأ_وقت_رتيب_النظام();
}
عرف وقت_نظام_داخليا(): نتيجة طابع_وقت_نظام, خطأ_حد_نظام {
    أرجع اقرأ_وقت_نظام_النظام();
}
عرف نم_داخليا(المدة: عدد): نتيجة عدد, خطأ_حد_نظام {
    أرجع نم_نانو_للنظام(المدة);
}

عام عرف وقت_رتيب_نانو(): نتيجة عدد, عدد {
    طابق وقت_رتيب_داخليا() مع
    | نتيجة.نجح(اللحظة) -> { أرجع نتيجة.نجح(اللحظة.النانوثواني); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); };
}

عام عرف وقت_نظام_نانو(): نتيجة عدد, عدد {
    طابق وقت_نظام_داخليا() مع
    | نتيجة.نجح(الطابع) -> { أرجع نتيجة.نجح(الطابع.النانوثواني); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); };
}

عام عرف نم_نانو(المدة: عدد): نتيجة عدد, عدد {
    طابق نم_داخليا(المدة) مع
    | نتيجة.نجح(الحالة) -> { أرجع نتيجة.نجح(الحالة); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); };
}

عام مرادف monotonic_time_ns = وقت_رتيب_نانو;
عام مرادف system_time_ns = وقت_نظام_نانو;
عام مرادف sleep_ns = نم_نانو;
