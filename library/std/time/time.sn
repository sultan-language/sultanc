مرادف وقت_رتيب_داخليا = بدائي_وقت_رتيب_نانو;
مرادف وقت_نظام_داخليا = بدائي_وقت_نظام_نانو;
مرادف نم_داخليا = بدائي_نوم_نانو;

عام عرف وقت_رتيب_نانو(): نتيجة عدد, عدد {
    دع القيمة: عدد = وقت_رتيب_داخليا();
    لو (القيمة < 0) { أرجع نتيجة.خطأ(القيمة); };
    أرجع نتيجة.نجح(القيمة);
}

عام عرف وقت_نظام_نانو(): نتيجة عدد, عدد {
    دع القيمة: عدد = وقت_نظام_داخليا();
    لو (القيمة < 0) { أرجع نتيجة.خطأ(القيمة); };
    أرجع نتيجة.نجح(القيمة);
}

عام عرف نم_نانو(المدة: عدد): نتيجة عدد, عدد {
    دع الحالة: عدد = نم_داخليا(المدة);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام مرادف monotonic_time_ns = وقت_رتيب_نانو;
عام مرادف system_time_ns = وقت_نظام_نانو;
عام مرادف sleep_ns = نم_نانو;
