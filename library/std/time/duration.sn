استورد math.integer;
استورد time.time;

// Signed nanosecond duration with checked scaling/arithmetic helpers.
عام نوع مدة = { النانوثواني: عدد };

عام عرف مدة_صفر(): مدة {
    دع الناتج: مدة = { النانوثواني: 0 };
    أرجع الناتج;
}

عام عرف مدة_من_نانوثواني(القيمة: عدد): مدة {
    دع الناتج: مدة = { النانوثواني: القيمة };
    أرجع الناتج;
}

عرف مدة_من_وحدة_متحققة(القيمة: عدد, عامل: عدد): اختيار مدة {
    طابق ضرب_عدد_متحقق(القيمة, عامل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النانوثواني) -> {
        أرجع اختيار.بعض(مدة_من_نانوثواني(النانوثواني));
    };
}

عام عرف مدة_من_ميكروثواني(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 1000);
}

عام عرف مدة_من_مليثواني(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 1000000);
}

عام عرف مدة_من_ثواني(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 1000000000);
}

عام عرف مدة_من_دقائق(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 60000000000);
}

عام عرف مدة_من_ساعات(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 3600000000000);
}

عام عرف مدة_من_أيام(القيمة: عدد): اختيار مدة {
    أرجع مدة_من_وحدة_متحققة(القيمة, 86400000000000);
}

عام عرف نانوثواني_المدة(المدة: &مدة): عدد {
    أرجع (*المدة).النانوثواني;
}

عام عرف ميكروثواني_المدة(المدة: &مدة): عدد {
    أرجع (*المدة).النانوثواني / 1000;
}

عام عرف مليثواني_المدة(المدة: &مدة): عدد {
    أرجع (*المدة).النانوثواني / 1000000;
}

عام عرف ثواني_المدة(المدة: &مدة): عدد {
    أرجع (*المدة).النانوثواني / 1000000000;
}

عام عرف اجمع_مدتين(الأولى: &مدة, الثانية: &مدة): اختيار مدة {
    طابق جمع_عدد_متحقق((*الأولى).النانوثواني, (*الثانية).النانوثواني) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(مدة_من_نانوثواني(القيمة)); };
}

عام عرف اطرح_مدتين(الأولى: &مدة, الثانية: &مدة): اختيار مدة {
    طابق طرح_عدد_متحقق((*الأولى).النانوثواني, (*الثانية).النانوثواني) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(مدة_من_نانوثواني(القيمة)); };
}

عام عرف اضرب_مدة(المدة: &مدة, العامل: عدد): اختيار مدة {
    طابق ضرب_عدد_متحقق((*المدة).النانوثواني, العامل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(مدة_من_نانوثواني(القيمة)); };
}

عام عرف قارن_مدتين(الأولى: &مدة, الثانية: &مدة): عدد {
    لو ((*الأولى).النانوثواني < (*الثانية).النانوثواني) { أرجع -1; };
    لو ((*الأولى).النانوثواني > (*الثانية).النانوثواني) { أرجع 1; };
    أرجع 0;
}

عام عرف مدة_صفرية(المدة: &مدة): منطقي {
    أرجع (*المدة).النانوثواني == 0;
}

عام عرف مدة_سالبة(المدة: &مدة): منطقي {
    أرجع (*المدة).النانوثواني < 0;
}

عام عرف نم_لمدة(المدة: &مدة): نتيجة عدد, عدد {
    أرجع نم_نانو((*المدة).النانوثواني);
}

عام نوع duration = مدة;
عام مرادف duration_zero = مدة_صفر;
عام مرادف duration_from_nanoseconds = مدة_من_نانوثواني;
عام مرادف duration_from_microseconds = مدة_من_ميكروثواني;
عام مرادف duration_from_milliseconds = مدة_من_مليثواني;
عام مرادف duration_from_seconds = مدة_من_ثواني;
عام مرادف duration_from_minutes = مدة_من_دقائق;
عام مرادف duration_from_hours = مدة_من_ساعات;
عام مرادف duration_from_days = مدة_من_أيام;
عام مرادف duration_nanoseconds = نانوثواني_المدة;
عام مرادف duration_microseconds = ميكروثواني_المدة;
عام مرادف duration_milliseconds = مليثواني_المدة;
عام مرادف duration_seconds = ثواني_المدة;
عام مرادف duration_add = اجمع_مدتين;
عام مرادف duration_subtract = اطرح_مدتين;
عام مرادف duration_multiply = اضرب_مدة;
عام مرادف duration_compare = قارن_مدتين;
عام مرادف duration_is_zero = مدة_صفرية;
عام مرادف duration_is_negative = مدة_سالبة;
عام مرادف sleep_duration = نم_لمدة;
