استورد encoding.binary;
استورد fs.path;
استورد fs.read_file;
استورد text.from_bytes;
استورد time.calendar;

عرف بايت_منطقة_عند(المصدر: &متجه ط8, الموضع: طبيعي): ط8 { أرجع (*المصدر)[الموضع]; }
عرف بايت_اسم_منطقة_عند(الاسم: &نص, الموضع: طبيعي): ط8 { أرجع (*الاسم)[الموضع]; }
عرف بايت_نص_منطقة_عند(النص: &نص, الموضع: طبيعي): ط8 { أرجع (*النص)[الموضع]; }

// RFC 9636 TZif reader. The core representation is independent of where the
// database comes from; callers can load IANA zone files from any supplied root.
عام نوع نوع_التوقيت_المحلي = {
    إزاحة_يوتي_سي: عدد,
    توقيت_صيفي: منطقي,
    الاختصار: نص
};

عام نوع انتقال_منطقة_زمنية = {
    ثانية_يونكس: عدد,
    فهرس_النوع: طبيعي
};

عام نوع منطقة_زمنية = {
    الاسم: نص,
    الانتقالات: متجه انتقال_منطقة_زمنية,
    الأنواع: متجه نوع_التوقيت_المحلي,
    قاعدة_بوزيكس: اختياري نص
};

عام نوع خطأ_منطقة_زمنية =
    | بيانات_منطقة_زمنية_غير_صالحة
    | إصدار_صيغة_المنطقة_غير_مدعوم
    | منطقة_غير_صالحة
    | قاعدة_بوزيكس_غير_مدعومة
    | ملف بنوع عدد
;

نوع رأس_بيانات_المنطقة = {
    الإصدار: ط8,
    عدد_مؤشرات_التوقيت_العالمي: طبيعي,
    عدد_قياسي: طبيعي,
    عدد_قفزات: طبيعي,
    عدد_انتقالات: طبيعي,
    عدد_أنواع: طبيعي,
    عدد_حروف: طبيعي
};

نوع قاعدة_يوم_بوزيكس = {
    الصنف: طبيعي, // 0=Jn, 1=n, 2=Mm.w.d
    أ: طبيعي,
    ب: طبيعي,
    ج: طبيعي,
    ثانية_اليوم: عدد
};

نوع قاعدة_بوزيكس_محللة = {
    قياسي: نص,
    إزاحة_قياسية: عدد,
    له_توقيت_صيفي: منطقي,
    صيفي: نص,
    إزاحة_صيفية: عدد,
    بداية: قاعدة_يوم_بوزيكس,
    نهاية: قاعدة_يوم_بوزيكس
};

عرف اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر: &متجه ط8, الموضع: طبيعي): اختياري طبيعي {
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع) مع
    | اختياري.موجود(قيمة) -> { أرجع اختياري.موجود(قيمة مثل طبيعي); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف حلل_رأس_بيانات_المنطقة(المصدر: &متجه ط8, الموضع: طبيعي): اختياري رأس_بيانات_المنطقة {
    إذا ((موضع + 44) > (الطول(*المصدر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا ((بايت_منطقة_عند(المصدر, موضع) != 0x54) || (بايت_منطقة_عند(المصدر, موضع+1) != 0x5A) || (بايت_منطقة_عند(المصدر, موضع+2) != 0x69) || (بايت_منطقة_عند(المصدر, موضع+3) != 0x66)) { أرجع اختياري.لا_شيء(); };
    دع الإصدار: ط8 = بايت_منطقة_عند(المصدر, موضع+4);
    إذا (!((الإصدار == 0) || (الإصدار == 0x32) || (الإصدار == 0x33) || (الإصدار == 0x34))) { أرجع اختياري.لا_شيء(); };
    دع عدد_مؤشرات_التوقيت_العالمي: متغير طبيعي=0; دع عدد_قياسي: متغير طبيعي=0; دع عدد_قفزات: متغير طبيعي=0;
    دع عدد_انتقالات: متغير طبيعي=0; دع عدد_أنواع: متغير طبيعي=0; دع عدد_حروف: متغير طبيعي=0;
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+20) مع | اختياري.موجود(ق)->{عدد_مؤشرات_التوقيت_العالمي:=ق;} | _->{أرجع اختياري.لا_شيء();};
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+24) مع | اختياري.موجود(ق)->{عدد_قياسي:=ق;} | _->{أرجع اختياري.لا_شيء();};
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+28) مع | اختياري.موجود(ق)->{عدد_قفزات:=ق;} | _->{أرجع اختياري.لا_شيء();};
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+32) مع | اختياري.موجود(ق)->{عدد_انتقالات:=ق;} | _->{أرجع اختياري.لا_شيء();};
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+36) مع | اختياري.موجود(ق)->{عدد_أنواع:=ق;} | _->{أرجع اختياري.لا_شيء();};
    طابق اقرأ_ط32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+40) مع | اختياري.موجود(ق)->{عدد_حروف:=ق;} | _->{أرجع اختياري.لا_شيء();};
    إذا (عدد_أنواع == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: رأس_بيانات_المنطقة={الإصدار:الإصدار,عدد_مؤشرات_التوقيت_العالمي:عدد_مؤشرات_التوقيت_العالمي,عدد_قياسي:عدد_قياسي,عدد_قفزات:عدد_قفزات,عدد_انتقالات:عدد_انتقالات,عدد_أنواع:عدد_أنواع,عدد_حروف:عدد_حروف};
    أرجع اختياري.موجود(الناتج);
}

عرف حجم_كتلة_بيانات_المنطقة(الرأس: &رأس_بيانات_المنطقة, حجم_الوقت: طبيعي): اختياري طبيعي {
    دع القيمة: متغير طبيعي = 0;
    دع الأعلى: طبيعي = ~((0 مثل طبيعي));
    إذا ((*الرأس).عدد_انتقالات > (الأعلى / حجم_الوقت)) { أرجع اختياري.لا_شيء(); };
    القيمة := (*الرأس).عدد_انتقالات * حجم_الوقت;
    إذا (القيمة > الأعلى - (*الرأس).عدد_انتقالات) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_انتقالات;
    إذا ((*الرأس).عدد_أنواع > ((الأعلى - القيمة) / 6)) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_أنواع * 6;
    إذا (القيمة > الأعلى - (*الرأس).عدد_حروف) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_حروف;
    إذا ((*الرأس).عدد_قفزات > ((الأعلى - القيمة) / (حجم_الوقت + 4))) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_قفزات * (حجم_الوقت + 4);
    إذا (القيمة > الأعلى - (*الرأس).عدد_قياسي) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_قياسي;
    إذا (القيمة > الأعلى - (*الرأس).عدد_مؤشرات_التوقيت_العالمي) { أرجع اختياري.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_مؤشرات_التوقيت_العالمي;
    أرجع اختياري.موجود(القيمة);
}

عرف نص_اختصار_المنطقة(الحروف: &متجه ط8, البداية: طبيعي): اختياري نص {
    إذا (البداية >= (الطول(*الحروف) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8=[]; دع ف: متغير طبيعي=البداية;
    طالما ((ف < (الطول(*الحروف) مثل طبيعي)) && ((*الحروف)[ف] != 0)) { ألحق(الناتج,(*الحروف)[ف]); ف:=ف+1; }
    إذا (ف >= (الطول(*الحروف) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(من_بايتات(&الناتج));
}

عرف اقرأ_وقت_انتقال_المنطقة(المصدر: &متجه ط8, الموضع: طبيعي, الحجم: طبيعي): اختياري عدد {
    إذا (الحجم == 4) { أرجع اقرأ_ع32_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع); };
    أرجع اقرأ_ع64_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع);
}

عرف حلل_كتلة_بيانات_المنطقة(المصدر: &متجه ط8, البداية: طبيعي, الرأس: &رأس_بيانات_المنطقة, حجم_الوقت: طبيعي, الاسم: &نص, موضع_النهاية: &متغير طبيعي): نتيجة منطقة_زمنية, خطأ_منطقة_زمنية {
    دع الحجم: متغير طبيعي=0; طابق حجم_كتلة_بيانات_المنطقة(الرأس,حجم_الوقت) مع | اختياري.موجود(ق)->{الحجم:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    إذا ((البداية + الحجم) > (الطول(*المصدر) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
    دع الانتقالات: متغير متجه انتقال_منطقة_زمنية=[];
    دع أوقات: متغير متجه عدد=[]; دع ف: متغير طبيعي=0;
    طالما (ف < (*الرأس).عدد_انتقالات) {
        دع موضع: طبيعي = البداية + ف * حجم_الوقت;
        طابق اقرأ_وقت_انتقال_المنطقة(المصدر, موضع, حجم_الوقت) مع
        | اختياري.موجود(ق) -> {
            إذا (ف > 0) {
                دع السابق: طبيعي = ف - 1;
                إذا (ق <= أوقات[السابق]) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
            };
            ألحق(أوقات, ق);
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
        ف := ف + 1;
    }
    دع بداية_الفهارس: طبيعي=البداية+(*الرأس).عدد_انتقالات*حجم_الوقت;
    دع بداية_الأنواع: طبيعي=بداية_الفهارس+(*الرأس).عدد_انتقالات;
    دع بداية_الحروف: طبيعي=بداية_الأنواع+(*الرأس).عدد_أنواع*6;
    دع الحروف: متغير متجه ط8=[]; ف:=0; طالما (ف<(*الرأس).عدد_حروف) { ألحق(الحروف,بايت_منطقة_عند(المصدر, بداية_الحروف+ف)); ف:=ف+1; }
    دع الأنواع: متغير متجه نوع_التوقيت_المحلي=[]; ف:=0;
    طالما (ف<(*الرأس).عدد_أنواع) {
        دع موضع:طبيعي=بداية_الأنواع+ف*6; دع الإزاحة:متغير عدد=0;
        طابق اقرأ_ع32_بالبايت_الأكثر_أهمية_أولا(المصدر,موضع) مع | اختياري.موجود(ق)->{الإزاحة:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
        دع dst:ط8=بايت_منطقة_عند(المصدر, موضع+4); دع فهرس:طبيعي=بايت_منطقة_عند(المصدر, موضع+5) مثل طبيعي;
        إذا ((dst>1)||(فهرس>=(*الرأس).عدد_حروف)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
        دع الاختصار:متغير نص=«»; طابق نص_اختصار_المنطقة(&الحروف,فهرس) مع | اختياري.موجود(ق)->{الاختصار:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
        دع النوع:نوع_التوقيت_المحلي={إزاحة_يوتي_سي:الإزاحة,توقيت_صيفي:dst==1,الاختصار:الاختصار}; ألحق(الأنواع,النوع); ف:=ف+1;
    }
    ف:=0; طالما (ف<(*الرأس).عدد_انتقالات) { دع الفهرس:طبيعي=بايت_منطقة_عند(المصدر, بداية_الفهارس+ف) مثل طبيعي; إذا (الفهرس>=(*الرأس).عدد_أنواع) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); }; دع انتقال:انتقال_منطقة_زمنية={ثانية_يونكس:أوقات[ف],فهرس_النوع:الفهرس}; ألحق(الانتقالات,انتقال); ف:=ف+1; }
    *موضع_النهاية := البداية + الحجم;
    دع الناتج:منطقة_زمنية={الاسم:*الاسم,الانتقالات:الانتقالات,الأنواع:الأنواع,قاعدة_بوزيكس:اختياري.لا_شيء()}; أرجع نتيجة.نجح(الناتج);
}

عرف نص_تذييل_بيانات_المنطقة(المصدر:&متجه ط8,الموضع:طبيعي): اختياري نص {
    إذا ((الموضع+1)>=(الطول(*المصدر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    إذا (بايت_منطقة_عند(المصدر, الموضع)!=0x0A) { أرجع اختياري.لا_شيء(); };
    دع ف:متغير طبيعي=الموضع+1; دع ب:متغير متجه ط8=[];
    طالما ((ف<(الطول(*المصدر) مثل طبيعي))&&(بايت_منطقة_عند(المصدر, ف)!=0x0A)) { إذا (بايت_منطقة_عند(المصدر, ف)==0) { أرجع اختياري.لا_شيء(); }; ألحق(ب,بايت_منطقة_عند(المصدر, ف)); ف:=ف+1; }
    إذا (ف>=(الطول(*المصدر) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(من_بايتات(&ب));
}

عام عرف حلل_بيانات_المنطقة_الزمنية(الاسم: &نص, المصدر: &متجه ط8): نتيجة منطقة_زمنية, خطأ_منطقة_زمنية {
    دع الرأس1:متغير رأس_بيانات_المنطقة; طابق حلل_رأس_بيانات_المنطقة(المصدر,0) مع | اختياري.موجود(ق)->{الرأس1:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    إذا (الرأس1.الإصدار==0) { دع نهاية:متغير طبيعي=0; أرجع حلل_كتلة_بيانات_المنطقة(المصدر,44,&الرأس1,4,الاسم,&متغير نهاية); };
    دع حجم1:متغير طبيعي=0; طابق حجم_كتلة_بيانات_المنطقة(&الرأس1,4) مع | اختياري.موجود(ق)->{حجم1:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    دع موضع_الرأس2:طبيعي=44+حجم1; دع الرأس2:متغير رأس_بيانات_المنطقة;
    طابق حلل_رأس_بيانات_المنطقة(المصدر,موضع_الرأس2) مع | اختياري.موجود(ق)->{الرأس2:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    دع نهاية:متغير طبيعي=0; دع المنطقة:متغير منطقة_زمنية;
    طابق حلل_كتلة_بيانات_المنطقة(المصدر,موضع_الرأس2+44,&الرأس2,8,الاسم,&متغير نهاية) مع | نتيجة.خطأ(خ)->{أرجع نتيجة.خطأ(خ);} | نتيجة.نجح(ق)->{المنطقة:=ق;};
    طابق نص_تذييل_بيانات_المنطقة(المصدر,نهاية) مع | اختياري.موجود(قاعدة)->{ إذا ((الطول(قاعدة) مثل طبيعي)>0) { المنطقة.قاعدة_بوزيكس:=اختياري.موجود(قاعدة); }; } | اختياري.لا_شيء->{ };
    أرجع نتيجة.نجح(المنطقة);
}

عرف اسم_منطقة_آمن(الاسم: &نص): منطقي {
    إذا ((الطول(*الاسم) مثل طبيعي) == 0) { أرجع خطأ; };
    إذا (بايت_اسم_منطقة_عند(الاسم, 0) == 0x2F) { أرجع خطأ; };
    دع بداية: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الاسم) مثل طبيعي;
    طالما (ف <= العدد) {
        إذا ((ف == العدد) || (بايت_اسم_منطقة_عند(الاسم, ف) == 0x2F)) {
            دع طول_الجزء: طبيعي = ف - بداية;
            إذا (طول_الجزء == 0) { أرجع خطأ; };
            إذا ((طول_الجزء == 1) && (بايت_اسم_منطقة_عند(الاسم, بداية) == 0x2E)) { أرجع خطأ; };
            إذا (طول_الجزء == 2) {
                دع التالي: طبيعي = بداية + 1;
                إذا ((بايت_اسم_منطقة_عند(الاسم, بداية) == 0x2E) && (بايت_اسم_منطقة_عند(الاسم, التالي) == 0x2E)) { أرجع خطأ; };
            };
            بداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف حمل_منطقة_زمنية(جذر_القاعدة:&نص,الاسم:&نص):نتيجة منطقة_زمنية,خطأ_منطقة_زمنية { إذا (!اسم_منطقة_آمن(الاسم)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.منطقة_غير_صالحة()); }; دع المسار:نص=صل_المسار(جذر_القاعدة,الاسم); طابق اقرأ_بايتات_ملف(&المسار) مع | نتيجة.خطأ(خ)->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.ملف(خ));} | نتيجة.نجح(ب)->{أرجع حلل_بيانات_المنطقة_الزمنية(الاسم,&ب);}; }

عرف نوع_التوقيت_من_الانتقالات(المنطقة:&منطقة_زمنية,الثواني:عدد): اختياري نوع_التوقيت_المحلي {
    إذا ((الطول((*المنطقة).الأنواع) مثل طبيعي)==0) { أرجع اختياري.لا_شيء(); };
    إذا ((الطول((*المنطقة).الانتقالات) مثل طبيعي)==0) { أرجع اختياري.موجود((*المنطقة).الأنواع[0]); };
    إذا (الثواني < (*المنطقة).الانتقالات[0].ثانية_يونكس) { أرجع اختياري.موجود((*المنطقة).الأنواع[0]); };
    دع بداية:متغير طبيعي=0; دع نهاية:متغير طبيعي=الطول((*المنطقة).الانتقالات) مثل طبيعي;
    طالما (بداية<نهاية) { دع وسط:طبيعي=بداية+((نهاية-بداية)/2); إذا ((*المنطقة).الانتقالات[وسط].ثانية_يونكس<=الثواني) { بداية:=وسط+1; } وإلا { نهاية:=وسط; }; }
    دع موضع_الانتقال: طبيعي = بداية - 1;
    دع انتقال: انتقال_منطقة_زمنية = (*المنطقة).الانتقالات[موضع_الانتقال]; إذا (انتقال.فهرس_النوع>=(الطول((*المنطقة).الأنواع) مثل طبيعي)) { أرجع اختياري.لا_شيء(); }; أرجع اختياري.موجود((*المنطقة).الأنواع[انتقال.فهرس_النوع]);
}

عرف حرف_اسم_بوزيكس(ب: ط8): منطقي {
    أرجع ((ب >= 0x41) && (ب <= 0x5A)) || ((ب >= 0x61) && (ب <= 0x7A));
}

عرف رقم_بوزيكس(ب: ط8): منطقي { أرجع (ب >= 0x30) && (ب <= 0x39); }

عرف اقرأ_اسم_بوزيكس(النص: &نص, الموضع: &متغير طبيعي): اختياري نص {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (*الموضع >= العدد) { أرجع اختياري.لا_شيء(); };
    دع البايتات: متغير متجه ط8 = [];
    إذا (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3C) {
        *الموضع := *الموضع + 1;
        طالما ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) != 0x3E)) {
            دع ب: ط8 = بايت_نص_منطقة_عند(النص, *الموضع);
            إذا ((ب == 0) || (ب == 0x2C)) { أرجع اختياري.لا_شيء(); };
            ألحق(البايتات, ب);
            *الموضع := *الموضع + 1;
        }
        إذا ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x3E) || ((الطول(البايتات) مثل طبيعي) == 0)) { أرجع اختياري.لا_شيء(); };
        *الموضع := *الموضع + 1;
        أرجع اختياري.موجود(من_بايتات(&البايتات));
    };
    طالما ((*الموضع < العدد) && حرف_اسم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع))) {
        ألحق(البايتات, بايت_نص_منطقة_عند(النص, *الموضع));
        *الموضع := *الموضع + 1;
    }
    إذا ((الطول(البايتات) مثل طبيعي) < 3) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}

عرف اقرأ_رقما_بوزيكس(النص: &نص, الموضع: &متغير طبيعي): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا ((*الموضع >= العدد) || (!رقم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع)))) { أرجع اختياري.لا_شيء(); };
    دع القيمة: متغير طبيعي = 0;
    طالما ((*الموضع < العدد) && رقم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع))) {
        دع الرقم: طبيعي = (بايت_نص_منطقة_عند(النص, *الموضع) - 0x30) مثل طبيعي;
        إذا (القيمة > ((~((0 مثل طبيعي)) - الرقم) / 10)) { أرجع اختياري.لا_شيء(); };
        القيمة := القيمة * 10 + الرقم;
        *الموضع := *الموضع + 1;
    }
    أرجع اختياري.موجود(القيمة);
}

عرف اقرأ_وقت_بوزيكس(
    النص: &نص,
    الموضع: &متغير طبيعي,
    أقصى_ساعة: طبيعي
): اختياري عدد {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع الإشارة: متغير عدد = 1;
    إذا (*الموضع < العدد) {
        إذا (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2D) { الإشارة := -1; *الموضع := *الموضع + 1; }
        وإلا إذا (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2B) { *الموضع := *الموضع + 1; };
    };
    دع الساعة: متغير طبيعي = 0;
    طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(ق) -> { الساعة := ق; };
    إذا (الساعة > أقصى_ساعة) { أرجع اختياري.لا_شيء(); };
    دع الدقيقة: متغير طبيعي = 0;
    دع الثانية: متغير طبيعي = 0;
    إذا ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3A)) {
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { الدقيقة := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا (الدقيقة > 59) { أرجع اختياري.لا_شيء(); };
        إذا ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3A)) {
            *الموضع := *الموضع + 1;
            طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { الثانية := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
            إذا (الثانية > 59) { أرجع اختياري.لا_شيء(); };
        };
    };
    دع القيمة: عدد = ((الساعة * 3600 + الدقيقة * 60 + الثانية) مثل عدد) * الإشارة;
    أرجع اختياري.موجود(القيمة);
}

عرف اقرأ_قاعدة_يوم_بوزيكس(النص: &نص, الموضع: &متغير طبيعي): اختياري قاعدة_يوم_بوزيكس {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (*الموضع >= العدد) { أرجع اختياري.لا_شيء(); };
    دع الصنف: متغير طبيعي = 0;
    دع أ: متغير طبيعي = 0;
    دع ب: متغير طبيعي = 0;
    دع ج: متغير طبيعي = 0;
    إذا (بايت_نص_منطقة_عند(النص, *الموضع) == 0x4A) {
        الصنف := 0;
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { أ := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا ((أ < 1) || (أ > 365)) { أرجع اختياري.لا_شيء(); };
    } وإلا إذا (بايت_نص_منطقة_عند(النص, *الموضع) == 0x4D) {
        الصنف := 2;
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { أ := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x2E)) { أرجع اختياري.لا_شيء(); }; *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { ب := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x2E)) { أرجع اختياري.لا_شيء(); }; *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { ج := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا ((أ < 1) || (أ > 12) || (ب < 1) || (ب > 5) || (ج > 6)) { أرجع اختياري.لا_شيء(); };
    } وإلا {
        الصنف := 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختياري.موجود(ق) -> { أ := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إذا (أ > 365) { أرجع اختياري.لا_شيء(); };
    };
    دع ثانية_اليوم: متغير عدد = 7200;
    إذا ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2F)) {
        *الموضع := *الموضع + 1;
        طابق اقرأ_وقت_بوزيكس(النص, الموضع, 167) مع | اختياري.موجود(ق) -> { ثانية_اليوم := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    };
    دع الناتج: قاعدة_يوم_بوزيكس = { الصنف: الصنف, أ: أ, ب: ب, ج: ج, ثانية_اليوم: ثانية_اليوم };
    أرجع اختياري.موجود(الناتج);
}

عرف حلل_قاعدة_بوزيكس(النص: &نص): اختياري قاعدة_بوزيكس_محللة {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    دع قياسي: متغير نص = «»;
    طابق اقرأ_اسم_بوزيكس(النص, &متغير الموضع) مع | اختياري.موجود(ق) -> { قياسي := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع إزاحة_نصية: متغير عدد = 0;
    طابق اقرأ_وقت_بوزيكس(النص, &متغير الموضع, 24) مع | اختياري.موجود(ق) -> { إزاحة_نصية := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع إزاحة_قياسية: عدد = 0 - إزاحة_نصية;
    دع قاعدة_فارغة: قاعدة_يوم_بوزيكس = { الصنف: 1, أ: 0, ب: 0, ج: 0, ثانية_اليوم: 7200 };
    إذا (الموضع == العدد) {
        دع الناتج: قاعدة_بوزيكس_محللة = { قياسي: قياسي, إزاحة_قياسية: إزاحة_قياسية, له_توقيت_صيفي: خطأ, صيفي: «», إزاحة_صيفية: إزاحة_قياسية, بداية: قاعدة_فارغة, نهاية: قاعدة_فارغة };
        أرجع اختياري.موجود(الناتج);
    };
    دع صيفي: متغير نص = «»;
    طابق اقرأ_اسم_بوزيكس(النص, &متغير الموضع) مع | اختياري.موجود(ق) -> { صيفي := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع إزاحة_صيفية: متغير عدد = إزاحة_قياسية + 3600;
    إذا ((الموضع < العدد) && (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) {
        دع نصية: متغير عدد = 0;
        طابق اقرأ_وقت_بوزيكس(النص, &متغير الموضع, 24) مع | اختياري.موجود(ق) -> { نصية := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
        إزاحة_صيفية := 0 - نصية;
    };
    إذا ((الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) { أرجع اختياري.لا_شيء(); }; الموضع := الموضع + 1;
    دع بداية: متغير قاعدة_يوم_بوزيكس;
    طابق اقرأ_قاعدة_يوم_بوزيكس(النص, &متغير الموضع) مع | اختياري.موجود(ق) -> { بداية := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    إذا ((الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) { أرجع اختياري.لا_شيء(); }; الموضع := الموضع + 1;
    دع نهاية: متغير قاعدة_يوم_بوزيكس;
    طابق اقرأ_قاعدة_يوم_بوزيكس(النص, &متغير الموضع) مع | اختياري.موجود(ق) -> { نهاية := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    إذا (الموضع != العدد) { أرجع اختياري.لا_شيء(); };
    دع الناتج: قاعدة_بوزيكس_محللة = { قياسي: قياسي, إزاحة_قياسية: إزاحة_قياسية, له_توقيت_صيفي: صواب, صيفي: صيفي, إزاحة_صيفية: إزاحة_صيفية, بداية: بداية, نهاية: نهاية };
    أرجع اختياري.موجود(الناتج);
}

عرف رقم_يوم_الأسبوع_بوزيكس(اليوم: يوم_الأسبوع): طبيعي {
    طابق اليوم مع
    | يوم_الأسبوع.الأحد -> { أرجع 0; }
    | يوم_الأسبوع.الاثنين -> { أرجع 1; }
    | يوم_الأسبوع.الثلاثاء -> { أرجع 2; }
    | يوم_الأسبوع.الأربعاء -> { أرجع 3; }
    | يوم_الأسبوع.الخميس -> { أرجع 4; }
    | يوم_الأسبوع.الجمعة -> { أرجع 5; }
    | يوم_الأسبوع.السبت -> { أرجع 6; };
}

عرف فهرس_يوم_قاعدة_بوزيكس(القاعدة: &قاعدة_يوم_بوزيكس, السنة: عدد): اختياري طبيعي {
    إذا ((*القاعدة).الصنف == 0) {
        دع الفهرس: متغير طبيعي = (*القاعدة).أ - 1;
        إذا (سنة_كبيسة(السنة) && ((*القاعدة).أ >= 60)) { الفهرس := الفهرس + 1; };
        أرجع اختياري.موجود(الفهرس);
    };
    إذا ((*القاعدة).الصنف == 1) { أرجع اختياري.موجود((*القاعدة).أ); };
    دع أول: تاريخ_تقويمي = { السنة: السنة, الشهر: (*القاعدة).أ, اليوم: 1 };
    دع يوم_أول: متغير طبيعي = 0;
    طابق يوم_الأسبوع_للتاريخ(&أول) مع | اختياري.موجود(ق) -> { يوم_أول := رقم_يوم_الأسبوع_بوزيكس(ق); } | _ -> { أرجع اختياري.لا_شيء(); };
    دع اليوم: متغير طبيعي = 1 + (((*القاعدة).ج + 7 - يوم_أول) % 7) + (((*القاعدة).ب - 1) * 7);
    دع أيام_الشهر: طبيعي = أيام_في_الشهر(السنة, (*القاعدة).أ);
    إذا (اليوم > أيام_الشهر) { اليوم := اليوم - 7; };
    دع التاريخ: تاريخ_تقويمي = { السنة: السنة, الشهر: (*القاعدة).أ, اليوم: اليوم };
    طابق ترتيب_اليوم_في_السنة(&التاريخ) مع | اختياري.موجود(ق) -> { أرجع اختياري.موجود(ق - 1); } | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف ثانية_انتقال_بوزيكس(القاعدة: &قاعدة_يوم_بوزيكس, السنة: عدد, الإزاحة_قبل: عدد): اختياري عدد {
    دع فهرس_اليوم: متغير طبيعي = 0;
    طابق فهرس_يوم_قاعدة_بوزيكس(القاعدة, السنة) مع | اختياري.موجود(ق) -> { فهرس_اليوم := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع أول_السنة: تاريخ_تقويمي = { السنة: السنة, الشهر: 1, اليوم: 1 };
    دع أيام_يونكس: متغير عدد = 0;
    طابق أيام_يونكس_من_التاريخ(&أول_السنة) مع | اختياري.موجود(ق) -> { أيام_يونكس := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع المحلي: عدد = (أيام_يونكس + (فهرس_اليوم مثل عدد)) * 86400 + (*القاعدة).ثانية_اليوم;
    أرجع اختياري.موجود(المحلي - الإزاحة_قبل);
}

عرف سنة_يونكس_بوزيكس(الثواني: عدد): اختياري عدد {
    دع الأيام: متغير عدد = الثواني / 86400;
    دع الباقي: عدد = الثواني % 86400;
    إذا (الباقي < 0) { الأيام := الأيام - 1; };
    طابق تاريخ_من_أيام_يونكس(الأيام) مع | اختياري.موجود(ق) -> { أرجع اختياري.موجود(ق.السنة); } | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف نوع_التوقيت_من_قاعدة_بوزيكس(القاعدة: &قاعدة_بوزيكس_محللة, الثواني: عدد): اختياري نوع_التوقيت_المحلي {
    إذا (!(*القاعدة).له_توقيت_صيفي) {
        دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_قياسية, توقيت_صيفي: خطأ, الاختصار: (*القاعدة).قياسي };
        أرجع اختياري.موجود(الناتج);
    };
    دع السنة: متغير عدد = 0;
    طابق سنة_يونكس_بوزيكس(الثواني) مع | اختياري.موجود(ق) -> { السنة := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع بدء: متغير عدد = 0; دع إنهاء: متغير عدد = 0;
    طابق ثانية_انتقال_بوزيكس(&(*القاعدة).بداية, السنة, (*القاعدة).إزاحة_قياسية) مع | اختياري.موجود(ق) -> { بدء := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    طابق ثانية_انتقال_بوزيكس(&(*القاعدة).نهاية, السنة, (*القاعدة).إزاحة_صيفية) مع | اختياري.موجود(ق) -> { إنهاء := ق; } | _ -> { أرجع اختياري.لا_شيء(); };
    دع صيفي: متغير منطقي = خطأ;
    إذا (بدء < إنهاء) { صيفي := (الثواني >= بدء) && (الثواني < إنهاء); }
    وإلا { صيفي := (الثواني >= بدء) || (الثواني < إنهاء); };
    إذا (صيفي) {
        دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_صيفية, توقيت_صيفي: صواب, الاختصار: (*القاعدة).صيفي };
        أرجع اختياري.موجود(الناتج);
    };
    دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_قياسية, توقيت_صيفي: خطأ, الاختصار: (*القاعدة).قياسي };
    أرجع اختياري.موجود(الناتج);
}

عام عرف نوع_التوقيت_المحلي_عند(المنطقة:&منطقة_زمنية,الثواني:عدد): نتيجة نوع_التوقيت_المحلي,خطأ_منطقة_زمنية {
    دع عدد_الانتقالات:طبيعي=الطول((*المنطقة).الانتقالات) مثل طبيعي;
    إذا (عدد_الانتقالات>0) {
        دع موضع_الأخير: طبيعي = عدد_الانتقالات - 1;
        دع الأخير: عدد = (*المنطقة).الانتقالات[موضع_الأخير].ثانية_يونكس;
        إذا (الثواني>الأخير) {
            طابق (*المنطقة).قاعدة_بوزيكس مع
            | اختياري.موجود(النص) -> {
                طابق حلل_قاعدة_بوزيكس(&النص) مع
                | اختياري.موجود(القاعدة) -> {
                    طابق نوع_التوقيت_من_قاعدة_بوزيكس(&القاعدة, الثواني) مع
                    | اختياري.موجود(النوع) -> { أرجع نتيجة.نجح(النوع); }
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.قاعدة_بوزيكس_غير_مدعومة()); };
                }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.قاعدة_بوزيكس_غير_مدعومة()); };
            }
            | اختياري.لا_شيء -> { };
        };
    };
    طابق نوع_التوقيت_من_الانتقالات(المنطقة,الثواني) مع | اختياري.موجود(ق)->{أرجع نتيجة.نجح(ق);} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
}

عام نوع timezone_type = نوع_التوقيت_المحلي;
عام نوع timezone_transition = انتقال_منطقة_زمنية;
عام نوع timezone = منطقة_زمنية;
عام نوع timezone_error = خطأ_منطقة_زمنية;
عام مرادف parse_tzif = حلل_بيانات_المنطقة_الزمنية;
عام مرادف load_timezone = حمل_منطقة_زمنية;
عام مرادف timezone_type_at = نوع_التوقيت_المحلي_عند;
