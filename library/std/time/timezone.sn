استورد encoding.binary;
استورد fs.path;
استورد fs.read_file;
استورد text.from_bytes;
استورد time.calendar;

عرف بايت_منطقة_عند(المصدر: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*المصدر)[الموضع]; }
عرف بايت_اسم_منطقة_عند(الاسم: &نص, الموضع: غير_موقع): غ8 { أرجع (*الاسم)[الموضع]; }
عرف بايت_نص_منطقة_عند(النص: &نص, الموضع: غير_موقع): غ8 { أرجع (*النص)[الموضع]; }

// RFC 9636 TZif reader. The core representation is independent of where the
// database comes from; callers can load IANA zone files from any supplied root.
عام نوع نوع_التوقيت_المحلي = {
    إزاحة_يوتي_سي: عدد,
    توقيت_صيفي: منطقي,
    الاختصار: نص
};

عام نوع انتقال_منطقة_زمنية = {
    ثانية_يونكس: عدد,
    فهرس_النوع: غير_موقع
};

عام نوع منطقة_زمنية = {
    الاسم: نص,
    الانتقالات: متجه انتقال_منطقة_زمنية,
    الأنواع: متجه نوع_التوقيت_المحلي,
    قاعدة_بوزيكس: اختيار نص
};

عام نوع خطأ_منطقة_زمنية =
    | بيانات_منطقة_زمنية_غير_صالحة
    | إصدار_صيغة_المنطقة_غير_مدعوم
    | منطقة_غير_صالحة
    | قاعدة_بوزيكس_غير_مدعومة
    | ملف بنوع عدد
;

نوع رأس_بيانات_المنطقة = {
    الإصدار: غ8,
    عدد_مؤشرات_التوقيت_العالمي: غير_موقع,
    عدد_قياسي: غير_موقع,
    عدد_قفزات: غير_موقع,
    عدد_انتقالات: غير_موقع,
    عدد_أنواع: غير_موقع,
    عدد_حروف: غير_موقع
};

نوع قاعدة_يوم_بوزيكس = {
    الصنف: غير_موقع, // 0=Jn, 1=n, 2=Mm.w.d
    أ: غير_موقع,
    ب: غير_موقع,
    ج: غير_موقع,
    ثانية_اليوم: عدد
};

نوع قاعدة_بوزيكس_محللة = {
    قياسي: نص,
    إزاحة_قياسية: عدد,
    له_توقيت_صيفي: منطقي,
    صيفي: نص,
    إزاحة_صيفية: عدد,
    بداية: قاعدة_يوم_بوزيكس,
    نهاية: قاعدة_يوم_بوزيكس
};

عرف اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار غير_موقع {
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع) مع
    | اختيار.بعض(قيمة) -> { أرجع اختيار.بعض(قيمة مثل غير_موقع); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عرف حلل_رأس_بيانات_المنطقة(المصدر: &متجه غ8, الموضع: غير_موقع): اختيار رأس_بيانات_المنطقة {
    لو ((موضع + 44) > (الطول(*المصدر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو ((بايت_منطقة_عند(المصدر, موضع) != 0x54) || (بايت_منطقة_عند(المصدر, موضع+1) != 0x5A) || (بايت_منطقة_عند(المصدر, موضع+2) != 0x69) || (بايت_منطقة_عند(المصدر, موضع+3) != 0x66)) { أرجع اختيار.لا_شيء(); };
    دع الإصدار: غ8 = بايت_منطقة_عند(المصدر, موضع+4);
    لو (!((الإصدار == 0) || (الإصدار == 0x32) || (الإصدار == 0x33) || (الإصدار == 0x34))) { أرجع اختيار.لا_شيء(); };
    دع عدد_مؤشرات_التوقيت_العالمي: متغير غير_موقع=0; دع عدد_قياسي: متغير غير_موقع=0; دع عدد_قفزات: متغير غير_موقع=0;
    دع عدد_انتقالات: متغير غير_موقع=0; دع عدد_أنواع: متغير غير_موقع=0; دع عدد_حروف: متغير غير_موقع=0;
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+20) مع | اختيار.بعض(ق)->{عدد_مؤشرات_التوقيت_العالمي:=ق;} | _->{أرجع اختيار.لا_شيء();};
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+24) مع | اختيار.بعض(ق)->{عدد_قياسي:=ق;} | _->{أرجع اختيار.لا_شيء();};
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+28) مع | اختيار.بعض(ق)->{عدد_قفزات:=ق;} | _->{أرجع اختيار.لا_شيء();};
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+32) مع | اختيار.بعض(ق)->{عدد_انتقالات:=ق;} | _->{أرجع اختيار.لا_شيء();};
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+36) مع | اختيار.بعض(ق)->{عدد_أنواع:=ق;} | _->{أرجع اختيار.لا_شيء();};
    طابق اقرأ_غ32_بالبايت_الأكثر_أهمية_أولا_مطلوب(المصدر,موضع+40) مع | اختيار.بعض(ق)->{عدد_حروف:=ق;} | _->{أرجع اختيار.لا_شيء();};
    لو (عدد_أنواع == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: رأس_بيانات_المنطقة={الإصدار:الإصدار,عدد_مؤشرات_التوقيت_العالمي:عدد_مؤشرات_التوقيت_العالمي,عدد_قياسي:عدد_قياسي,عدد_قفزات:عدد_قفزات,عدد_انتقالات:عدد_انتقالات,عدد_أنواع:عدد_أنواع,عدد_حروف:عدد_حروف};
    أرجع اختيار.بعض(الناتج);
}

عرف حجم_كتلة_بيانات_المنطقة(الرأس: &رأس_بيانات_المنطقة, حجم_الوقت: غير_موقع): اختيار غير_موقع {
    دع القيمة: متغير غير_موقع = 0;
    دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
    لو ((*الرأس).عدد_انتقالات > (الأعلى / حجم_الوقت)) { أرجع اختيار.لا_شيء(); };
    القيمة := (*الرأس).عدد_انتقالات * حجم_الوقت;
    لو (القيمة > الأعلى - (*الرأس).عدد_انتقالات) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_انتقالات;
    لو ((*الرأس).عدد_أنواع > ((الأعلى - القيمة) / 6)) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_أنواع * 6;
    لو (القيمة > الأعلى - (*الرأس).عدد_حروف) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_حروف;
    لو ((*الرأس).عدد_قفزات > ((الأعلى - القيمة) / (حجم_الوقت + 4))) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_قفزات * (حجم_الوقت + 4);
    لو (القيمة > الأعلى - (*الرأس).عدد_قياسي) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_قياسي;
    لو (القيمة > الأعلى - (*الرأس).عدد_مؤشرات_التوقيت_العالمي) { أرجع اختيار.لا_شيء(); }; القيمة := القيمة + (*الرأس).عدد_مؤشرات_التوقيت_العالمي;
    أرجع اختيار.بعض(القيمة);
}

عرف نص_اختصار_المنطقة(الحروف: &متجه غ8, البداية: غير_موقع): اختيار نص {
    لو (البداية >= (الطول(*الحروف) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8=[]; دع ف: متغير غير_موقع=البداية;
    بينما ((ف < (الطول(*الحروف) مثل غير_موقع)) && ((*الحروف)[ف] != 0)) { ألحق(الناتج,(*الحروف)[ف]); ف:=ف+1; }
    لو (ف >= (الطول(*الحروف) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(من_بايتات(&الناتج));
}

عرف اقرأ_وقت_انتقال_المنطقة(المصدر: &متجه غ8, الموضع: غير_موقع, الحجم: غير_موقع): اختيار عدد {
    لو (الحجم == 4) { أرجع اقرأ_ع32_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع); };
    أرجع اقرأ_ع64_بالبايت_الأكثر_أهمية_أولا(المصدر, الموضع);
}

عرف حلل_كتلة_بيانات_المنطقة(المصدر: &متجه غ8, البداية: غير_موقع, الرأس: &رأس_بيانات_المنطقة, حجم_الوقت: غير_موقع, الاسم: &نص, موضع_النهاية: &متغير غير_موقع): نتيجة منطقة_زمنية, خطأ_منطقة_زمنية {
    دع الحجم: متغير غير_موقع=0; طابق حجم_كتلة_بيانات_المنطقة(الرأس,حجم_الوقت) مع | اختيار.بعض(ق)->{الحجم:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    لو ((البداية + الحجم) > (الطول(*المصدر) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
    دع الانتقالات: متغير متجه انتقال_منطقة_زمنية=[];
    دع أوقات: متغير متجه عدد=[]; دع ف: متغير غير_موقع=0;
    بينما (ف < (*الرأس).عدد_انتقالات) {
        دع موضع: غير_موقع = البداية + ف * حجم_الوقت;
        طابق اقرأ_وقت_انتقال_المنطقة(المصدر, موضع, حجم_الوقت) مع
        | اختيار.بعض(ق) -> {
            لو (ف > 0) {
                دع السابق: غير_موقع = ف - 1;
                لو (ق <= أوقات[السابق]) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
            };
            ألحق(أوقات, ق);
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
        ف := ف + 1;
    }
    دع بداية_الفهارس: غير_موقع=البداية+(*الرأس).عدد_انتقالات*حجم_الوقت;
    دع بداية_الأنواع: غير_موقع=بداية_الفهارس+(*الرأس).عدد_انتقالات;
    دع بداية_الحروف: غير_موقع=بداية_الأنواع+(*الرأس).عدد_أنواع*6;
    دع الحروف: متغير متجه غ8=[]; ف:=0; بينما (ف<(*الرأس).عدد_حروف) { ألحق(الحروف,بايت_منطقة_عند(المصدر, بداية_الحروف+ف)); ف:=ف+1; }
    دع الأنواع: متغير متجه نوع_التوقيت_المحلي=[]; ف:=0;
    بينما (ف<(*الرأس).عدد_أنواع) {
        دع موضع:غير_موقع=بداية_الأنواع+ف*6; دع الإزاحة:متغير عدد=0;
        طابق اقرأ_ع32_بالبايت_الأكثر_أهمية_أولا(المصدر,موضع) مع | اختيار.بعض(ق)->{الإزاحة:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
        دع dst:غ8=بايت_منطقة_عند(المصدر, موضع+4); دع فهرس:غير_موقع=بايت_منطقة_عند(المصدر, موضع+5) مثل غير_موقع;
        لو ((dst>1)||(فهرس>=(*الرأس).عدد_حروف)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); };
        دع الاختصار:متغير نص=«»; طابق نص_اختصار_المنطقة(&الحروف,فهرس) مع | اختيار.بعض(ق)->{الاختصار:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
        دع النوع:نوع_التوقيت_المحلي={إزاحة_يوتي_سي:الإزاحة,توقيت_صيفي:dst==1,الاختصار:الاختصار}; ألحق(الأنواع,النوع); ف:=ف+1;
    }
    ف:=0; بينما (ف<(*الرأس).عدد_انتقالات) { دع الفهرس:غير_موقع=بايت_منطقة_عند(المصدر, بداية_الفهارس+ف) مثل غير_موقع; لو (الفهرس>=(*الرأس).عدد_أنواع) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة()); }; دع انتقال:انتقال_منطقة_زمنية={ثانية_يونكس:أوقات[ف],فهرس_النوع:الفهرس}; ألحق(الانتقالات,انتقال); ف:=ف+1; }
    *موضع_النهاية := البداية + الحجم;
    دع الناتج:منطقة_زمنية={الاسم:*الاسم,الانتقالات:الانتقالات,الأنواع:الأنواع,قاعدة_بوزيكس:اختيار.لا_شيء()}; أرجع نتيجة.نجح(الناتج);
}

عرف نص_تذييل_بيانات_المنطقة(المصدر:&متجه غ8,الموضع:غير_موقع): اختيار نص {
    لو ((الموضع+1)>=(الطول(*المصدر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    لو (بايت_منطقة_عند(المصدر, الموضع)!=0x0A) { أرجع اختيار.لا_شيء(); };
    دع ف:متغير غير_موقع=الموضع+1; دع ب:متغير متجه غ8=[];
    بينما ((ف<(الطول(*المصدر) مثل غير_موقع))&&(بايت_منطقة_عند(المصدر, ف)!=0x0A)) { لو (بايت_منطقة_عند(المصدر, ف)==0) { أرجع اختيار.لا_شيء(); }; ألحق(ب,بايت_منطقة_عند(المصدر, ف)); ف:=ف+1; }
    لو (ف>=(الطول(*المصدر) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(من_بايتات(&ب));
}

عام عرف حلل_بيانات_المنطقة_الزمنية(الاسم: &نص, المصدر: &متجه غ8): نتيجة منطقة_زمنية, خطأ_منطقة_زمنية {
    دع الرأس1:متغير رأس_بيانات_المنطقة; طابق حلل_رأس_بيانات_المنطقة(المصدر,0) مع | اختيار.بعض(ق)->{الرأس1:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    لو (الرأس1.الإصدار==0) { دع نهاية:متغير غير_موقع=0; أرجع حلل_كتلة_بيانات_المنطقة(المصدر,44,&الرأس1,4,الاسم,&متغير نهاية); };
    دع حجم1:متغير غير_موقع=0; طابق حجم_كتلة_بيانات_المنطقة(&الرأس1,4) مع | اختيار.بعض(ق)->{حجم1:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    دع موضع_الرأس2:غير_موقع=44+حجم1; دع الرأس2:متغير رأس_بيانات_المنطقة;
    طابق حلل_رأس_بيانات_المنطقة(المصدر,موضع_الرأس2) مع | اختيار.بعض(ق)->{الرأس2:=ق;} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
    دع نهاية:متغير غير_موقع=0; دع المنطقة:متغير منطقة_زمنية;
    طابق حلل_كتلة_بيانات_المنطقة(المصدر,موضع_الرأس2+44,&الرأس2,8,الاسم,&متغير نهاية) مع | نتيجة.خطأ(خ)->{أرجع نتيجة.خطأ(خ);} | نتيجة.نجح(ق)->{المنطقة:=ق;};
    طابق نص_تذييل_بيانات_المنطقة(المصدر,نهاية) مع | اختيار.بعض(قاعدة)->{ لو ((الطول(قاعدة) مثل غير_موقع)>0) { المنطقة.قاعدة_بوزيكس:=اختيار.بعض(قاعدة); }; } | اختيار.لا_شيء->{ };
    أرجع نتيجة.نجح(المنطقة);
}

عرف اسم_منطقة_آمن(الاسم: &نص): منطقي {
    لو ((الطول(*الاسم) مثل غير_موقع) == 0) { أرجع خطأ; };
    لو (بايت_اسم_منطقة_عند(الاسم, 0) == 0x2F) { أرجع خطأ; };
    دع بداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    بينما (ف <= العدد) {
        لو ((ف == العدد) || (بايت_اسم_منطقة_عند(الاسم, ف) == 0x2F)) {
            دع طول_الجزء: غير_موقع = ف - بداية;
            لو (طول_الجزء == 0) { أرجع خطأ; };
            لو ((طول_الجزء == 1) && (بايت_اسم_منطقة_عند(الاسم, بداية) == 0x2E)) { أرجع خطأ; };
            لو (طول_الجزء == 2) {
                دع التالي: غير_موقع = بداية + 1;
                لو ((بايت_اسم_منطقة_عند(الاسم, بداية) == 0x2E) && (بايت_اسم_منطقة_عند(الاسم, التالي) == 0x2E)) { أرجع خطأ; };
            };
            بداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف حمل_منطقة_زمنية(جذر_القاعدة:&نص,الاسم:&نص):نتيجة منطقة_زمنية,خطأ_منطقة_زمنية { لو (!اسم_منطقة_آمن(الاسم)) { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.منطقة_غير_صالحة()); }; دع المسار:نص=صل_المسار(جذر_القاعدة,الاسم); طابق اقرأ_بايتات_ملف(&المسار) مع | نتيجة.خطأ(خ)->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.ملف(خ));} | نتيجة.نجح(ب)->{أرجع حلل_بيانات_المنطقة_الزمنية(الاسم,&ب);}; }

عرف نوع_التوقيت_من_الانتقالات(المنطقة:&منطقة_زمنية,الثواني:عدد): اختيار نوع_التوقيت_المحلي {
    لو ((الطول((*المنطقة).الأنواع) مثل غير_موقع)==0) { أرجع اختيار.لا_شيء(); };
    لو ((الطول((*المنطقة).الانتقالات) مثل غير_موقع)==0) { أرجع اختيار.بعض((*المنطقة).الأنواع[0]); };
    لو (الثواني < (*المنطقة).الانتقالات[0].ثانية_يونكس) { أرجع اختيار.بعض((*المنطقة).الأنواع[0]); };
    دع بداية:متغير غير_موقع=0; دع نهاية:متغير غير_موقع=الطول((*المنطقة).الانتقالات) مثل غير_موقع;
    بينما (بداية<نهاية) { دع وسط:غير_موقع=بداية+((نهاية-بداية)/2); لو ((*المنطقة).الانتقالات[وسط].ثانية_يونكس<=الثواني) { بداية:=وسط+1; } وإلا { نهاية:=وسط; }; }
    دع موضع_الانتقال: غير_موقع = بداية - 1;
    دع انتقال: انتقال_منطقة_زمنية = (*المنطقة).الانتقالات[موضع_الانتقال]; لو (انتقال.فهرس_النوع>=(الطول((*المنطقة).الأنواع) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); }; أرجع اختيار.بعض((*المنطقة).الأنواع[انتقال.فهرس_النوع]);
}

عرف حرف_اسم_بوزيكس(ب: غ8): منطقي {
    أرجع ((ب >= 0x41) && (ب <= 0x5A)) || ((ب >= 0x61) && (ب <= 0x7A));
}

عرف رقم_بوزيكس(ب: غ8): منطقي { أرجع (ب >= 0x30) && (ب <= 0x39); }

عرف اقرأ_اسم_بوزيكس(النص: &نص, الموضع: &متغير غير_موقع): اختيار نص {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو (*الموضع >= العدد) { أرجع اختيار.لا_شيء(); };
    دع البايتات: متغير متجه غ8 = [];
    لو (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3C) {
        *الموضع := *الموضع + 1;
        بينما ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) != 0x3E)) {
            دع ب: غ8 = بايت_نص_منطقة_عند(النص, *الموضع);
            لو ((ب == 0) || (ب == 0x2C)) { أرجع اختيار.لا_شيء(); };
            ألحق(البايتات, ب);
            *الموضع := *الموضع + 1;
        }
        لو ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x3E) || ((الطول(البايتات) مثل غير_موقع) == 0)) { أرجع اختيار.لا_شيء(); };
        *الموضع := *الموضع + 1;
        أرجع اختيار.بعض(من_بايتات(&البايتات));
    };
    بينما ((*الموضع < العدد) && حرف_اسم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع))) {
        ألحق(البايتات, بايت_نص_منطقة_عند(النص, *الموضع));
        *الموضع := *الموضع + 1;
    }
    لو ((الطول(البايتات) مثل غير_موقع) < 3) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(من_بايتات(&البايتات));
}

عرف اقرأ_رقما_بوزيكس(النص: &نص, الموضع: &متغير غير_موقع): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو ((*الموضع >= العدد) || (!رقم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع)))) { أرجع اختيار.لا_شيء(); };
    دع القيمة: متغير غير_موقع = 0;
    بينما ((*الموضع < العدد) && رقم_بوزيكس(بايت_نص_منطقة_عند(النص, *الموضع))) {
        دع الرقم: غير_موقع = (بايت_نص_منطقة_عند(النص, *الموضع) - 0x30) مثل غير_موقع;
        لو (القيمة > ((~((0 مثل غير_موقع)) - الرقم) / 10)) { أرجع اختيار.لا_شيء(); };
        القيمة := القيمة * 10 + الرقم;
        *الموضع := *الموضع + 1;
    }
    أرجع اختيار.بعض(القيمة);
}

عرف اقرأ_وقت_بوزيكس(
    النص: &نص,
    الموضع: &متغير غير_موقع,
    أقصى_ساعة: غير_موقع
): اختيار عدد {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    دع الإشارة: متغير عدد = 1;
    لو (*الموضع < العدد) {
        لو (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2D) { الإشارة := -1; *الموضع := *الموضع + 1; }
        وإلا لو (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2B) { *الموضع := *الموضع + 1; };
    };
    دع الساعة: متغير غير_موقع = 0;
    طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(ق) -> { الساعة := ق; };
    لو (الساعة > أقصى_ساعة) { أرجع اختيار.لا_شيء(); };
    دع الدقيقة: متغير غير_موقع = 0;
    دع الثانية: متغير غير_موقع = 0;
    لو ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3A)) {
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { الدقيقة := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو (الدقيقة > 59) { أرجع اختيار.لا_شيء(); };
        لو ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x3A)) {
            *الموضع := *الموضع + 1;
            طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { الثانية := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
            لو (الثانية > 59) { أرجع اختيار.لا_شيء(); };
        };
    };
    دع القيمة: عدد = ((الساعة * 3600 + الدقيقة * 60 + الثانية) مثل عدد) * الإشارة;
    أرجع اختيار.بعض(القيمة);
}

عرف اقرأ_قاعدة_يوم_بوزيكس(النص: &نص, الموضع: &متغير غير_موقع): اختيار قاعدة_يوم_بوزيكس {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو (*الموضع >= العدد) { أرجع اختيار.لا_شيء(); };
    دع الصنف: متغير غير_موقع = 0;
    دع أ: متغير غير_موقع = 0;
    دع ب: متغير غير_موقع = 0;
    دع ج: متغير غير_موقع = 0;
    لو (بايت_نص_منطقة_عند(النص, *الموضع) == 0x4A) {
        الصنف := 0;
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { أ := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو ((أ < 1) || (أ > 365)) { أرجع اختيار.لا_شيء(); };
    } وإلا لو (بايت_نص_منطقة_عند(النص, *الموضع) == 0x4D) {
        الصنف := 2;
        *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { أ := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x2E)) { أرجع اختيار.لا_شيء(); }; *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { ب := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو ((*الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, *الموضع) != 0x2E)) { أرجع اختيار.لا_شيء(); }; *الموضع := *الموضع + 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { ج := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو ((أ < 1) || (أ > 12) || (ب < 1) || (ب > 5) || (ج > 6)) { أرجع اختيار.لا_شيء(); };
    } وإلا {
        الصنف := 1;
        طابق اقرأ_رقما_بوزيكس(النص, الموضع) مع | اختيار.بعض(ق) -> { أ := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        لو (أ > 365) { أرجع اختيار.لا_شيء(); };
    };
    دع ثانية_اليوم: متغير عدد = 7200;
    لو ((*الموضع < العدد) && (بايت_نص_منطقة_عند(النص, *الموضع) == 0x2F)) {
        *الموضع := *الموضع + 1;
        طابق اقرأ_وقت_بوزيكس(النص, الموضع, 167) مع | اختيار.بعض(ق) -> { ثانية_اليوم := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    };
    دع الناتج: قاعدة_يوم_بوزيكس = { الصنف: الصنف, أ: أ, ب: ب, ج: ج, ثانية_اليوم: ثانية_اليوم };
    أرجع اختيار.بعض(الناتج);
}

عرف حلل_قاعدة_بوزيكس(النص: &نص): اختيار قاعدة_بوزيكس_محللة {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    دع قياسي: متغير نص = «»;
    طابق اقرأ_اسم_بوزيكس(النص, &متغير الموضع) مع | اختيار.بعض(ق) -> { قياسي := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع إزاحة_نصية: متغير عدد = 0;
    طابق اقرأ_وقت_بوزيكس(النص, &متغير الموضع, 24) مع | اختيار.بعض(ق) -> { إزاحة_نصية := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع إزاحة_قياسية: عدد = 0 - إزاحة_نصية;
    دع قاعدة_فارغة: قاعدة_يوم_بوزيكس = { الصنف: 1, أ: 0, ب: 0, ج: 0, ثانية_اليوم: 7200 };
    لو (الموضع == العدد) {
        دع الناتج: قاعدة_بوزيكس_محللة = { قياسي: قياسي, إزاحة_قياسية: إزاحة_قياسية, له_توقيت_صيفي: خطأ, صيفي: «», إزاحة_صيفية: إزاحة_قياسية, بداية: قاعدة_فارغة, نهاية: قاعدة_فارغة };
        أرجع اختيار.بعض(الناتج);
    };
    دع صيفي: متغير نص = «»;
    طابق اقرأ_اسم_بوزيكس(النص, &متغير الموضع) مع | اختيار.بعض(ق) -> { صيفي := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع إزاحة_صيفية: متغير عدد = إزاحة_قياسية + 3600;
    لو ((الموضع < العدد) && (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) {
        دع نصية: متغير عدد = 0;
        طابق اقرأ_وقت_بوزيكس(النص, &متغير الموضع, 24) مع | اختيار.بعض(ق) -> { نصية := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
        إزاحة_صيفية := 0 - نصية;
    };
    لو ((الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) { أرجع اختيار.لا_شيء(); }; الموضع := الموضع + 1;
    دع بداية: متغير قاعدة_يوم_بوزيكس;
    طابق اقرأ_قاعدة_يوم_بوزيكس(النص, &متغير الموضع) مع | اختيار.بعض(ق) -> { بداية := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    لو ((الموضع >= العدد) || (بايت_نص_منطقة_عند(النص, الموضع) != 0x2C)) { أرجع اختيار.لا_شيء(); }; الموضع := الموضع + 1;
    دع نهاية: متغير قاعدة_يوم_بوزيكس;
    طابق اقرأ_قاعدة_يوم_بوزيكس(النص, &متغير الموضع) مع | اختيار.بعض(ق) -> { نهاية := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    لو (الموضع != العدد) { أرجع اختيار.لا_شيء(); };
    دع الناتج: قاعدة_بوزيكس_محللة = { قياسي: قياسي, إزاحة_قياسية: إزاحة_قياسية, له_توقيت_صيفي: صواب, صيفي: صيفي, إزاحة_صيفية: إزاحة_صيفية, بداية: بداية, نهاية: نهاية };
    أرجع اختيار.بعض(الناتج);
}

عرف رقم_يوم_الأسبوع_بوزيكس(اليوم: يوم_الأسبوع): غير_موقع {
    طابق اليوم مع
    | يوم_الأسبوع.الأحد -> { أرجع 0; }
    | يوم_الأسبوع.الاثنين -> { أرجع 1; }
    | يوم_الأسبوع.الثلاثاء -> { أرجع 2; }
    | يوم_الأسبوع.الأربعاء -> { أرجع 3; }
    | يوم_الأسبوع.الخميس -> { أرجع 4; }
    | يوم_الأسبوع.الجمعة -> { أرجع 5; }
    | يوم_الأسبوع.السبت -> { أرجع 6; };
}

عرف فهرس_يوم_قاعدة_بوزيكس(القاعدة: &قاعدة_يوم_بوزيكس, السنة: عدد): اختيار غير_موقع {
    لو ((*القاعدة).الصنف == 0) {
        دع الفهرس: متغير غير_موقع = (*القاعدة).أ - 1;
        لو (سنة_كبيسة(السنة) && ((*القاعدة).أ >= 60)) { الفهرس := الفهرس + 1; };
        أرجع اختيار.بعض(الفهرس);
    };
    لو ((*القاعدة).الصنف == 1) { أرجع اختيار.بعض((*القاعدة).أ); };
    دع أول: تاريخ_تقويمي = { السنة: السنة, الشهر: (*القاعدة).أ, اليوم: 1 };
    دع يوم_أول: متغير غير_موقع = 0;
    طابق يوم_الأسبوع_للتاريخ(&أول) مع | اختيار.بعض(ق) -> { يوم_أول := رقم_يوم_الأسبوع_بوزيكس(ق); } | _ -> { أرجع اختيار.لا_شيء(); };
    دع اليوم: متغير غير_موقع = 1 + (((*القاعدة).ج + 7 - يوم_أول) % 7) + (((*القاعدة).ب - 1) * 7);
    دع أيام_الشهر: غير_موقع = أيام_في_الشهر(السنة, (*القاعدة).أ);
    لو (اليوم > أيام_الشهر) { اليوم := اليوم - 7; };
    دع التاريخ: تاريخ_تقويمي = { السنة: السنة, الشهر: (*القاعدة).أ, اليوم: اليوم };
    طابق ترتيب_اليوم_في_السنة(&التاريخ) مع | اختيار.بعض(ق) -> { أرجع اختيار.بعض(ق - 1); } | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف ثانية_انتقال_بوزيكس(القاعدة: &قاعدة_يوم_بوزيكس, السنة: عدد, الإزاحة_قبل: عدد): اختيار عدد {
    دع فهرس_اليوم: متغير غير_موقع = 0;
    طابق فهرس_يوم_قاعدة_بوزيكس(القاعدة, السنة) مع | اختيار.بعض(ق) -> { فهرس_اليوم := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع أول_السنة: تاريخ_تقويمي = { السنة: السنة, الشهر: 1, اليوم: 1 };
    دع أيام_يونكس: متغير عدد = 0;
    طابق أيام_يونكس_من_التاريخ(&أول_السنة) مع | اختيار.بعض(ق) -> { أيام_يونكس := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع المحلي: عدد = (أيام_يونكس + (فهرس_اليوم مثل عدد)) * 86400 + (*القاعدة).ثانية_اليوم;
    أرجع اختيار.بعض(المحلي - الإزاحة_قبل);
}

عرف سنة_يونكس_بوزيكس(الثواني: عدد): اختيار عدد {
    دع الأيام: متغير عدد = الثواني / 86400;
    دع الباقي: عدد = الثواني % 86400;
    لو (الباقي < 0) { الأيام := الأيام - 1; };
    طابق تاريخ_من_أيام_يونكس(الأيام) مع | اختيار.بعض(ق) -> { أرجع اختيار.بعض(ق.السنة); } | _ -> { أرجع اختيار.لا_شيء(); };
}

عرف نوع_التوقيت_من_قاعدة_بوزيكس(القاعدة: &قاعدة_بوزيكس_محللة, الثواني: عدد): اختيار نوع_التوقيت_المحلي {
    لو (!(*القاعدة).له_توقيت_صيفي) {
        دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_قياسية, توقيت_صيفي: خطأ, الاختصار: (*القاعدة).قياسي };
        أرجع اختيار.بعض(الناتج);
    };
    دع السنة: متغير عدد = 0;
    طابق سنة_يونكس_بوزيكس(الثواني) مع | اختيار.بعض(ق) -> { السنة := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع بدء: متغير عدد = 0; دع إنهاء: متغير عدد = 0;
    طابق ثانية_انتقال_بوزيكس(&(*القاعدة).بداية, السنة, (*القاعدة).إزاحة_قياسية) مع | اختيار.بعض(ق) -> { بدء := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    طابق ثانية_انتقال_بوزيكس(&(*القاعدة).نهاية, السنة, (*القاعدة).إزاحة_صيفية) مع | اختيار.بعض(ق) -> { إنهاء := ق; } | _ -> { أرجع اختيار.لا_شيء(); };
    دع صيفي: متغير منطقي = خطأ;
    لو (بدء < إنهاء) { صيفي := (الثواني >= بدء) && (الثواني < إنهاء); }
    وإلا { صيفي := (الثواني >= بدء) || (الثواني < إنهاء); };
    لو (صيفي) {
        دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_صيفية, توقيت_صيفي: صواب, الاختصار: (*القاعدة).صيفي };
        أرجع اختيار.بعض(الناتج);
    };
    دع الناتج: نوع_التوقيت_المحلي = { إزاحة_يوتي_سي: (*القاعدة).إزاحة_قياسية, توقيت_صيفي: خطأ, الاختصار: (*القاعدة).قياسي };
    أرجع اختيار.بعض(الناتج);
}

عام عرف نوع_التوقيت_المحلي_عند(المنطقة:&منطقة_زمنية,الثواني:عدد): نتيجة نوع_التوقيت_المحلي,خطأ_منطقة_زمنية {
    دع عدد_الانتقالات:غير_موقع=الطول((*المنطقة).الانتقالات) مثل غير_موقع;
    لو (عدد_الانتقالات>0) {
        دع موضع_الأخير: غير_موقع = عدد_الانتقالات - 1;
        دع الأخير: عدد = (*المنطقة).الانتقالات[موضع_الأخير].ثانية_يونكس;
        لو (الثواني>الأخير) {
            طابق (*المنطقة).قاعدة_بوزيكس مع
            | اختيار.بعض(النص) -> {
                طابق حلل_قاعدة_بوزيكس(&النص) مع
                | اختيار.بعض(القاعدة) -> {
                    طابق نوع_التوقيت_من_قاعدة_بوزيكس(&القاعدة, الثواني) مع
                    | اختيار.بعض(النوع) -> { أرجع نتيجة.نجح(النوع); }
                    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.قاعدة_بوزيكس_غير_مدعومة()); };
                }
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.قاعدة_بوزيكس_غير_مدعومة()); };
            }
            | اختيار.لا_شيء -> { };
        };
    };
    طابق نوع_التوقيت_من_الانتقالات(المنطقة,الثواني) مع | اختيار.بعض(ق)->{أرجع نتيجة.نجح(ق);} | _->{أرجع نتيجة.خطأ(خطأ_منطقة_زمنية.بيانات_منطقة_زمنية_غير_صالحة());};
}

عام نوع timezone_type = نوع_التوقيت_المحلي;
عام نوع timezone_transition = انتقال_منطقة_زمنية;
عام نوع timezone = منطقة_زمنية;
عام نوع timezone_error = خطأ_منطقة_زمنية;
عام مرادف parse_tzif = حلل_بيانات_المنطقة_الزمنية;
عام مرادف load_timezone = حمل_منطقة_زمنية;
عام مرادف timezone_type_at = نوع_التوقيت_المحلي_عند;
