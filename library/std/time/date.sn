استورد chars.ascii;
استورد text.builder;
استورد time.calendar;
عرف بايت_تاريخ_عند(النص: &نص, الموضع: غير_موقع): غ8 { أرجع (*النص)[الموضع]; }

عام نوع خطأ_تاريخ =
    | صيغة_غير_صالحة
    | تاريخ_غير_صالح
    | وقت_غير_صالح
    | إزاحة_غير_صالحة
;

عام نوع تاريخ_ووقت = {
    التاريخ: تاريخ_تقويمي,
    الساعة: غير_موقع,
    الدقيقة: غير_موقع,
    الثانية: غير_موقع,
    النانوثانية: غير_موقع,
    إزاحة_دقائق: عدد,
    الإزاحة_معلومة: منطقي
};

عرف وقت_صالح(الساعة: غير_موقع, الدقيقة: غير_موقع, الثانية: غير_موقع, النانوثانية: غير_موقع): منطقي {
    أرجع (الساعة <= 23)
        && (الدقيقة <= 59)
        && (الثانية <= 60)
        && (النانوثانية < 1000000000);
}

عام عرف تاريخ_ووقت_صالح(القيمة: &تاريخ_ووقت): منطقي {
    لو (!تاريخ_تقويمي_صالح(&(*القيمة).التاريخ)) { أرجع خطأ; };
    لو (!وقت_صالح((*القيمة).الساعة, (*القيمة).الدقيقة, (*القيمة).الثانية, (*القيمة).النانوثانية)) { أرجع خطأ; };
    لو (!(*القيمة).الإزاحة_معلومة) { أرجع (*القيمة).إزاحة_دقائق == 0; };
    أرجع ((*القيمة).إزاحة_دقائق >= -1439) && ((*القيمة).إزاحة_دقائق <= 1439);
}

عام عرف أنشئ_تاريخا_ووقتا(
    السنة: عدد,
    الشهر: غير_موقع,
    اليوم: غير_موقع,
    الساعة: غير_موقع,
    الدقيقة: غير_موقع,
    الثانية: غير_موقع,
    النانوثانية: غير_موقع,
    إزاحة_دقائق: عدد
): اختيار تاريخ_ووقت {
    طابق أنشئ_تاريخا_تقويميا(السنة, الشهر, اليوم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التاريخ) -> {
        دع الناتج: تاريخ_ووقت = {
            التاريخ: التاريخ,
            الساعة: الساعة,
            الدقيقة: الدقيقة,
            الثانية: الثانية,
            النانوثانية: النانوثانية,
            إزاحة_دقائق: إزاحة_دقائق,
            الإزاحة_معلومة: صواب
        };
        لو (!تاريخ_ووقت_صالح(&الناتج)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الناتج);
    };
}


عام عرف أنشئ_تاريخا_ووقتا_بإزاحة_مجهولة(
    السنة: عدد,
    الشهر: غير_موقع,
    اليوم: غير_موقع,
    الساعة: غير_موقع,
    الدقيقة: غير_موقع,
    الثانية: غير_موقع,
    النانوثانية: غير_موقع
): اختيار تاريخ_ووقت {
    طابق أنشئ_تاريخا_تقويميا(السنة, الشهر, اليوم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التاريخ) -> {
        دع الناتج: تاريخ_ووقت = {
            التاريخ: التاريخ,
            الساعة: الساعة,
            الدقيقة: الدقيقة,
            الثانية: الثانية,
            النانوثانية: النانوثانية,
            إزاحة_دقائق: 0,
            الإزاحة_معلومة: خطأ
        };
        لو (!تاريخ_ووقت_صالح(&الناتج)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الناتج);
    };
}

عرف رقم_عند(النص: &نص, الموضع: غير_موقع): اختيار غير_موقع {
    لو (الموضع >= (الطول(*النص) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع ب: غ8 = بايت_تاريخ_عند(النص, الموضع);
    لو (!رقم_عشري(ب)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض((ب - 0x30) مثل غير_موقع);
}

عرف رقمان_عند(النص: &نص, الموضع: غير_موقع): اختيار غير_موقع {
    طابق رقم_عند(النص, الموضع) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(أ) -> {
        طابق رقم_عند(النص, الموضع + 1) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ب) -> { أرجع اختيار.بعض((أ * 10) + ب); };
    };
}

عرف أربعة_أرقام_عند(النص: &نص, الموضع: غير_موقع): اختيار غير_موقع {
    دع القيمة: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4) {
        طابق رقم_عند(النص, الموضع + ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(ر) -> { القيمة := (القيمة * 10) + ر; };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(القيمة);
}

عرف ألحق_رقما_بباني_التاريخ(الباني: &متغير باني_نص, الرقم: غير_موقع): فراغ {
    دع المحرف: حرف = (((0x30 مثل غير_موقع) + الرقم) مثل غ8) مثل حرف;
    دع أضيف: منطقي = ألحق_محرفا_بباني_النص(الباني, المحرف);
}

عرف ألحق_رقمين_بباني_التاريخ(الباني: &متغير باني_نص, القيمة: غير_موقع): فراغ {
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 10) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, القيمة % 10);
}

عرف ألحق_أربعة_أرقام_بباني_التاريخ(الباني: &متغير باني_نص, القيمة: غير_موقع): فراغ {
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 1000) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 100) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, (القيمة / 10) % 10);
    ألحق_رقما_بباني_التاريخ(الباني, القيمة % 10);
}

عام عرف نسق_تاريخ_آيزو(التاريخ: &تاريخ_تقويمي): اختيار نص {
    لو (!تاريخ_تقويمي_صالح(التاريخ)) { أرجع اختيار.لا_شيء(); };
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(10);
    ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, (*التاريخ).السنة مثل غير_موقع);
    دع شرطة: نص = «-»;
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*التاريخ).الشهر);
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*التاريخ).اليوم);
    أرجع اختيار.بعض(نص_باني_النص(&الباني));
}

عام عرف حلل_تاريخ_آيزو(النص: &نص): نتيجة تاريخ_تقويمي, خطأ_تاريخ {
    لو ((الطول(*النص) مثل غير_موقع) != 10) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    لو ((بايت_تاريخ_عند(النص, 4) != 0x2D) || (بايت_تاريخ_عند(النص, 7) != 0x2D)) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    طابق أربعة_أرقام_عند(النص, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(السنة) -> {
        طابق رقمان_عند(النص, 5) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
        | اختيار.بعض(الشهر) -> {
            طابق رقمان_عند(النص, 8) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
            | اختيار.بعض(اليوم) -> {
                طابق أنشئ_تاريخا_تقويميا(السنة مثل عدد, الشهر, اليوم) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.تاريخ_غير_صالح()); }
                | اختيار.بعض(التاريخ) -> { أرجع نتيجة.نجح(التاريخ); };
            };
        };
    };
}

عام عرف نسق_آر_إف_سي3339(القيمة: &تاريخ_ووقت): اختيار نص {
    لو (!تاريخ_ووقت_صالح(القيمة)) { أرجع اختيار.لا_شيء(); };
    دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(32);
    ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.السنة مثل غير_موقع);
    دع شرطة: نص = «-»;
    دع نقطتان: نص = «:»;
    دع حرف_ت: نص = «T»;
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.الشهر);
    ألحق_نصا_بباني_النص(&متغير الباني, &شرطة);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).التاريخ.اليوم);
    ألحق_نصا_بباني_النص(&متغير الباني, &حرف_ت);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الساعة);
    ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الدقيقة);
    ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
    ألحق_رقمين_بباني_التاريخ(&متغير الباني, (*القيمة).الثانية);

    لو ((*القيمة).النانوثانية != 0) {
        دع نقطة: نص = «.»;
        ألحق_نصا_بباني_النص(&متغير الباني, &نقطة);
        دع العرض: متغير غير_موقع = 9;
        دع المختصر: متغير غير_موقع = (*القيمة).النانوثانية;
        بينما ((العرض > 1) && ((المختصر % 10) == 0)) {
            العرض := العرض - 1;
            المختصر := المختصر / 10;
        }
        دع ف: متغير غير_موقع = 0;
        دع القاسم: متغير غير_موقع = 100000000;
        بينما (ف < العرض) {
            دع الرقم: غير_موقع = ((*القيمة).النانوثانية / القاسم) % 10;
            ألحق_رقما_بباني_التاريخ(&متغير الباني, الرقم);
            القاسم := القاسم / 10;
            ف := ف + 1;
        }
    };

    لو (!(*القيمة).الإزاحة_معلومة) {
        دع مجهولة: نص = «-00:00»;
        ألحق_نصا_بباني_النص(&متغير الباني, &مجهولة);
    } وإلا لو ((*القيمة).إزاحة_دقائق == 0) {
        دع ز: نص = «Z»;
        ألحق_نصا_بباني_النص(&متغير الباني, &ز);
    } وإلا {
        دع الإزاحة: متغير عدد = (*القيمة).إزاحة_دقائق;
        لو (الإزاحة < 0) {
            دع ناقص: نص = «-»;
            ألحق_نصا_بباني_النص(&متغير الباني, &ناقص);
            الإزاحة := 0 - الإزاحة;
        } وإلا {
            دع زائد: نص = «+»;
            ألحق_نصا_بباني_النص(&متغير الباني, &زائد);
        };
        ألحق_رقمين_بباني_التاريخ(&متغير الباني, (الإزاحة / 60) مثل غير_موقع);
        ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
        ألحق_رقمين_بباني_التاريخ(&متغير الباني, (الإزاحة % 60) مثل غير_موقع);
    };
    أرجع اختيار.بعض(نص_باني_النص(&الباني));
}

عام عرف حلل_آر_إف_سي3339(النص: &نص): نتيجة تاريخ_ووقت, خطأ_تاريخ {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    لو (العدد < 20) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    لو ((بايت_تاريخ_عند(النص, 4) != 0x2D) || (بايت_تاريخ_عند(النص, 7) != 0x2D)
        || ((بايت_تاريخ_عند(النص, 10) != 0x54) && (بايت_تاريخ_عند(النص, 10) != 0x74))
        || (بايت_تاريخ_عند(النص, 13) != 0x3A) || (بايت_تاريخ_عند(النص, 16) != 0x3A)) {
        أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة());
    };

    دع السنة: متغير غير_موقع = 0;
    دع الشهر: متغير غير_موقع = 0;
    دع اليوم: متغير غير_موقع = 0;
    دع الساعة: متغير غير_موقع = 0;
    دع الدقيقة: متغير غير_موقع = 0;
    دع الثانية: متغير غير_موقع = 0;

    طابق أربعة_أرقام_عند(النص, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { السنة := ق; };
    طابق رقمان_عند(النص, 5) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { الشهر := ق; };
    طابق رقمان_عند(النص, 8) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { اليوم := ق; };
    طابق رقمان_عند(النص, 11) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { الساعة := ق; };
    طابق رقمان_عند(النص, 14) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { الدقيقة := ق; };
    طابق رقمان_عند(النص, 17) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { الثانية := ق; };

    دع الموضع: متغير غير_موقع = 19;
    دع النانوثانية: متغير غير_موقع = 0;
    لو ((الموضع < العدد) && (بايت_تاريخ_عند(النص, الموضع) == 0x2E)) {
        الموضع := الموضع + 1;
        دع أرقام_الكسر: متغير غير_موقع = 0;
        بينما ((الموضع < العدد) && رقم_عشري(بايت_تاريخ_عند(النص, الموضع))) {
            لو (أرقام_الكسر < 9) {
                النانوثانية := (النانوثانية * 10) + ((بايت_تاريخ_عند(النص, الموضع) - 0x30) مثل غير_موقع);
            };
            أرقام_الكسر := أرقام_الكسر + 1;
            الموضع := الموضع + 1;
        }
        لو (أرقام_الكسر == 0) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
        بينما (أرقام_الكسر < 9) {
            النانوثانية := النانوثانية * 10;
            أرقام_الكسر := أرقام_الكسر + 1;
        }
    };

    دع الإزاحة: متغير عدد = 0;
    دع الإزاحة_معلومة: متغير منطقي = صواب;
    لو (الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    دع علامة: غ8 = بايت_تاريخ_عند(النص, الموضع);
    لو ((علامة == 0x5A) || (علامة == 0x7A)) {
        لو ((الموضع + 1) != العدد) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    } وإلا لو ((علامة == 0x2B) || (علامة == 0x2D)) {
        لو ((الموضع + 6) != العدد) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
        لو (بايت_تاريخ_عند(النص, الموضع + 3) != 0x3A) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
        دع ساعة_الإزاحة: متغير غير_موقع = 0;
        دع دقيقة_الإزاحة: متغير غير_موقع = 0;
        طابق رقمان_عند(النص, الموضع + 1) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
        | اختيار.بعض(ق) -> { ساعة_الإزاحة := ق; };
        طابق رقمان_عند(النص, الموضع + 4) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
        | اختيار.بعض(ق) -> { دقيقة_الإزاحة := ق; };
        لو ((ساعة_الإزاحة > 23) || (دقيقة_الإزاحة > 59)) {
            أرجع نتيجة.خطأ(خطأ_تاريخ.إزاحة_غير_صالحة());
        };
        الإزاحة := ((ساعة_الإزاحة * 60) + دقيقة_الإزاحة) مثل عدد;
        لو ((علامة == 0x2D) && (الإزاحة == 0)) {
            الإزاحة_معلومة := خطأ;
        } وإلا لو (علامة == 0x2D) {
            الإزاحة := 0 - الإزاحة;
        };
    } وإلا {
        أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة());
    };

    دع المنشأ: متغير اختيار تاريخ_ووقت = اختيار.لا_شيء();
    لو (الإزاحة_معلومة) {
        المنشأ := أنشئ_تاريخا_ووقتا(
            السنة مثل عدد, الشهر, اليوم,
            الساعة, الدقيقة, الثانية, النانوثانية, الإزاحة
        );
    } وإلا {
        المنشأ := أنشئ_تاريخا_ووقتا_بإزاحة_مجهولة(
            السنة مثل عدد, الشهر, اليوم,
            الساعة, الدقيقة, الثانية, النانوثانية
        );
    };
    طابق المنشأ مع
    | اختيار.لا_شيء -> {
        دع تاريخ_فقط: تاريخ_تقويمي = { السنة: السنة مثل عدد, الشهر: الشهر, اليوم: اليوم };
        لو (!تاريخ_تقويمي_صالح(&تاريخ_فقط)) { أرجع نتيجة.خطأ(خطأ_تاريخ.تاريخ_غير_صالح()); };
        لو (!وقت_صالح(الساعة, الدقيقة, الثانية, النانوثانية)) { أرجع نتيجة.خطأ(خطأ_تاريخ.وقت_غير_صالح()); };
        أرجع نتيجة.خطأ(خطأ_تاريخ.إزاحة_غير_صالحة());
    }
    | اختيار.بعض(الناتج) -> { أرجع نتيجة.نجح(الناتج); };
}

عام عرف ثواني_يونكس_من_تاريخ(القيمة: &تاريخ_ووقت): اختيار عدد {
    لو (!تاريخ_ووقت_صالح(القيمة)) { أرجع اختيار.لا_شيء(); };
    لو (!(*القيمة).الإزاحة_معلومة) { أرجع اختيار.لا_شيء(); };
    // Leap seconds cannot be represented uniquely in POSIX/Unix seconds.
    لو ((*القيمة).الثانية == 60) { أرجع اختيار.لا_شيء(); };
    طابق أيام_يونكس_من_التاريخ(&(*القيمة).التاريخ) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الأيام) -> {
        دع المحلي: عدد = (الأيام * 86400)
            + ((*القيمة).الساعة مثل عدد) * 3600
            + ((*القيمة).الدقيقة مثل عدد) * 60
            + ((*القيمة).الثانية مثل عدد);
        أرجع اختيار.بعض(المحلي - ((*القيمة).إزاحة_دقائق * 60));
    };
}

عام عرف تاريخ_من_ثواني_يونكس(الثواني: عدد, إزاحة_دقائق: عدد): اختيار تاريخ_ووقت {
    لو ((إزاحة_دقائق < -1439) || (إزاحة_دقائق > 1439)) { أرجع اختيار.لا_شيء(); };
    دع المحلي: عدد = الثواني + (إزاحة_دقائق * 60);
    دع الأيام: متغير عدد = المحلي / 86400;
    دع المتبقي: متغير عدد = المحلي % 86400;
    لو (المتبقي < 0) {
        المتبقي := المتبقي + 86400;
        الأيام := الأيام - 1;
    };
    طابق تاريخ_من_أيام_يونكس(الأيام) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(التاريخ) -> {
        دع الساعة: غير_موقع = (المتبقي / 3600) مثل غير_موقع;
        دع بعد_الساعة: عدد = المتبقي % 3600;
        دع الدقيقة: غير_موقع = (بعد_الساعة / 60) مثل غير_موقع;
        دع الثانية: غير_موقع = (بعد_الساعة % 60) مثل غير_موقع;
        دع الناتج: تاريخ_ووقت = {
            التاريخ: التاريخ,
            الساعة: الساعة,
            الدقيقة: الدقيقة,
            الثانية: الثانية,
            النانوثانية: 0,
            إزاحة_دقائق: إزاحة_دقائق,
            الإزاحة_معلومة: صواب
        };
        أرجع اختيار.بعض(الناتج);
    };
}

عرف اسم_شهر_ويب(الشهر: غير_موقع): اختيار نص {
    لو (الشهر == 1) { أرجع اختيار.بعض(«Jan»); };
    لو (الشهر == 2) { أرجع اختيار.بعض(«Feb»); };
    لو (الشهر == 3) { أرجع اختيار.بعض(«Mar»); };
    لو (الشهر == 4) { أرجع اختيار.بعض(«Apr»); };
    لو (الشهر == 5) { أرجع اختيار.بعض(«May»); };
    لو (الشهر == 6) { أرجع اختيار.بعض(«Jun»); };
    لو (الشهر == 7) { أرجع اختيار.بعض(«Jul»); };
    لو (الشهر == 8) { أرجع اختيار.بعض(«Aug»); };
    لو (الشهر == 9) { أرجع اختيار.بعض(«Sep»); };
    لو (الشهر == 10) { أرجع اختيار.بعض(«Oct»); };
    لو (الشهر == 11) { أرجع اختيار.بعض(«Nov»); };
    لو (الشهر == 12) { أرجع اختيار.بعض(«Dec»); };
    أرجع اختيار.لا_شيء();
}

عرف اسم_يوم_ويب(اليوم: يوم_الأسبوع): نص {
    طابق اليوم مع
    | يوم_الأسبوع.الأحد -> { أرجع «Sun»; }
    | يوم_الأسبوع.الاثنين -> { أرجع «Mon»; }
    | يوم_الأسبوع.الثلاثاء -> { أرجع «Tue»; }
    | يوم_الأسبوع.الأربعاء -> { أرجع «Wed»; }
    | يوم_الأسبوع.الخميس -> { أرجع «Thu»; }
    | يوم_الأسبوع.الجمعة -> { أرجع «Fri»; }
    | يوم_الأسبوع.السبت -> { أرجع «Sat»; };
}

عام عرف نسق_تاريخ_ويب(القيمة: &تاريخ_ووقت): اختيار نص {
    لو (!تاريخ_ووقت_صالح(القيمة)) { أرجع اختيار.لا_شيء(); };
    لو (!(*القيمة).الإزاحة_معلومة) { أرجع اختيار.لا_شيء(); };
    دع يو_تي_سي: متغير تاريخ_ووقت = *القيمة;
    لو ((*القيمة).إزاحة_دقائق != 0) {
        طابق ثواني_يونكس_من_تاريخ(القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الثواني) -> {
            طابق تاريخ_من_ثواني_يونكس(الثواني, 0) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(المحول) -> { يو_تي_سي := المحول; };
        };
    };
    طابق يوم_الأسبوع_للتاريخ(&يو_تي_سي.التاريخ) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(يوم_الأسبوع) -> {
        طابق اسم_شهر_ويب(يو_تي_سي.التاريخ.الشهر) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الشهر) -> {
            دع الباني: متغير باني_نص = أنشئ_باني_نص_بسعة(29);
            دع اسم_اليوم: نص = اسم_يوم_ويب(يوم_الأسبوع);
            دع فاصلة_وفراغ: نص = «, »;
            دع مسافة: نص = « »;
            دع نقطتان: نص = «:»;
            دع غمت: نص = « GMT»;
            ألحق_نصا_بباني_النص(&متغير الباني, &اسم_اليوم);
            ألحق_نصا_بباني_النص(&متغير الباني, &فاصلة_وفراغ);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.التاريخ.اليوم);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_نصا_بباني_النص(&متغير الباني, &الشهر);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_أربعة_أرقام_بباني_التاريخ(&متغير الباني, يو_تي_سي.التاريخ.السنة مثل غير_موقع);
            ألحق_نصا_بباني_النص(&متغير الباني, &مسافة);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الساعة);
            ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الدقيقة);
            ألحق_نصا_بباني_النص(&متغير الباني, &نقطتان);
            ألحق_رقمين_بباني_التاريخ(&متغير الباني, يو_تي_سي.الثانية);
            ألحق_نصا_بباني_النص(&متغير الباني, &غمت);
            أرجع اختيار.بعض(نص_باني_النص(&الباني));
        };
    };
}

عرف اسم_شهر_ويب_عند(النص: &نص, الموضع: غير_موقع): اختيار غير_موقع {
    لو ((الموضع + 3) > (الطول(*النص) مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    دع أ: غ8 = بايت_تاريخ_عند(النص, الموضع);
    دع ب: غ8 = بايت_تاريخ_عند(النص, الموضع + 1);
    دع ج: غ8 = بايت_تاريخ_عند(النص, الموضع + 2);
    لو ((أ == 0x4A) && (ب == 0x61) && (ج == 0x6E)) { أرجع اختيار.بعض(1); };
    لو ((أ == 0x46) && (ب == 0x65) && (ج == 0x62)) { أرجع اختيار.بعض(2); };
    لو ((أ == 0x4D) && (ب == 0x61) && (ج == 0x72)) { أرجع اختيار.بعض(3); };
    لو ((أ == 0x41) && (ب == 0x70) && (ج == 0x72)) { أرجع اختيار.بعض(4); };
    لو ((أ == 0x4D) && (ب == 0x61) && (ج == 0x79)) { أرجع اختيار.بعض(5); };
    لو ((أ == 0x4A) && (ب == 0x75) && (ج == 0x6E)) { أرجع اختيار.بعض(6); };
    لو ((أ == 0x4A) && (ب == 0x75) && (ج == 0x6C)) { أرجع اختيار.بعض(7); };
    لو ((أ == 0x41) && (ب == 0x75) && (ج == 0x67)) { أرجع اختيار.بعض(8); };
    لو ((أ == 0x53) && (ب == 0x65) && (ج == 0x70)) { أرجع اختيار.بعض(9); };
    لو ((أ == 0x4F) && (ب == 0x63) && (ج == 0x74)) { أرجع اختيار.بعض(10); };
    لو ((أ == 0x4E) && (ب == 0x6F) && (ج == 0x76)) { أرجع اختيار.بعض(11); };
    لو ((أ == 0x44) && (ب == 0x65) && (ج == 0x63)) { أرجع اختيار.بعض(12); };
    أرجع اختيار.لا_شيء();
}

عرف اسم_يوم_ويب_عند(النص: &نص): اختيار يوم_الأسبوع {
    لو ((الطول(*النص) مثل غير_موقع) < 3) { أرجع اختيار.لا_شيء(); };
    دع أ: غ8 = بايت_تاريخ_عند(النص, 0);
    دع ب: غ8 = بايت_تاريخ_عند(النص, 1);
    دع ج: غ8 = بايت_تاريخ_عند(النص, 2);
    لو ((أ == 0x53) && (ب == 0x75) && (ج == 0x6E)) { أرجع اختيار.بعض(يوم_الأسبوع.الأحد()); };
    لو ((أ == 0x4D) && (ب == 0x6F) && (ج == 0x6E)) { أرجع اختيار.بعض(يوم_الأسبوع.الاثنين()); };
    لو ((أ == 0x54) && (ب == 0x75) && (ج == 0x65)) { أرجع اختيار.بعض(يوم_الأسبوع.الثلاثاء()); };
    لو ((أ == 0x57) && (ب == 0x65) && (ج == 0x64)) { أرجع اختيار.بعض(يوم_الأسبوع.الأربعاء()); };
    لو ((أ == 0x54) && (ب == 0x68) && (ج == 0x75)) { أرجع اختيار.بعض(يوم_الأسبوع.الخميس()); };
    لو ((أ == 0x46) && (ب == 0x72) && (ج == 0x69)) { أرجع اختيار.بعض(يوم_الأسبوع.الجمعة()); };
    لو ((أ == 0x53) && (ب == 0x61) && (ج == 0x74)) { أرجع اختيار.بعض(يوم_الأسبوع.السبت()); };
    أرجع اختيار.لا_شيء();
}

عرف يوما_أسبوع_متساويان(أ: يوم_الأسبوع, ب: يوم_الأسبوع): منطقي {
    طابق أ مع
    | يوم_الأسبوع.الأحد -> { طابق ب مع | يوم_الأسبوع.الأحد -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.الاثنين -> { طابق ب مع | يوم_الأسبوع.الاثنين -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.الثلاثاء -> { طابق ب مع | يوم_الأسبوع.الثلاثاء -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.الأربعاء -> { طابق ب مع | يوم_الأسبوع.الأربعاء -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.الخميس -> { طابق ب مع | يوم_الأسبوع.الخميس -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.الجمعة -> { طابق ب مع | يوم_الأسبوع.الجمعة -> { أرجع صواب; } | _ -> { أرجع خطأ; }; }
    | يوم_الأسبوع.السبت -> { طابق ب مع | يوم_الأسبوع.السبت -> { أرجع صواب; } | _ -> { أرجع خطأ; }; };
}

// Parses the preferred IMF-fixdate form generated by HTTP senders.
عام عرف حلل_تاريخ_ويب_القياسي(النص: &نص): نتيجة تاريخ_ووقت, خطأ_تاريخ {
    لو ((الطول(*النص) مثل غير_موقع) != 29) { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); };
    لو ((بايت_تاريخ_عند(النص, 3) != 0x2C) || (بايت_تاريخ_عند(النص, 4) != 0x20)
        || (بايت_تاريخ_عند(النص, 7) != 0x20) || (بايت_تاريخ_عند(النص, 11) != 0x20)
        || (بايت_تاريخ_عند(النص, 16) != 0x20) || (بايت_تاريخ_عند(النص, 19) != 0x3A)
        || (بايت_تاريخ_عند(النص, 22) != 0x3A) || (بايت_تاريخ_عند(النص, 25) != 0x20)
        || (بايت_تاريخ_عند(النص, 26) != 0x47) || (بايت_تاريخ_عند(النص, 27) != 0x4D) || (بايت_تاريخ_عند(النص, 28) != 0x54)) {
        أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة());
    };
    دع يوم_النص: متغير يوم_الأسبوع = يوم_الأسبوع.الأحد();
    طابق اسم_يوم_ويب_عند(النص) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); }
    | اختيار.بعض(ق) -> { يوم_النص := ق; };
    دع اليوم: متغير غير_موقع = 0;
    دع الشهر: متغير غير_موقع = 0;
    دع السنة: متغير غير_موقع = 0;
    دع الساعة: متغير غير_موقع = 0;
    دع الدقيقة: متغير غير_موقع = 0;
    دع الثانية: متغير غير_موقع = 0;
    طابق رقمان_عند(النص, 5) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { اليوم := ق; };
    طابق اسم_شهر_ويب_عند(النص, 8) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { الشهر := ق; };
    طابق أربعة_أرقام_عند(النص, 12) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { السنة := ق; };
    طابق رقمان_عند(النص, 17) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { الساعة := ق; };
    طابق رقمان_عند(النص, 20) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { الدقيقة := ق; };
    طابق رقمان_عند(النص, 23) مع | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.صيغة_غير_صالحة()); } | اختيار.بعض(ق) -> { الثانية := ق; };

    طابق أنشئ_تاريخا_ووقتا(السنة مثل عدد, الشهر, اليوم, الساعة, الدقيقة, الثانية, 0, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.تاريخ_غير_صالح()); }
    | اختيار.بعض(الناتج) -> {
        طابق يوم_الأسبوع_للتاريخ(&الناتج.التاريخ) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تاريخ.تاريخ_غير_صالح()); }
        | اختيار.بعض(اليوم_الفعلي) -> {
            لو (!يوما_أسبوع_متساويان(يوم_النص, اليوم_الفعلي)) {
                أرجع نتيجة.خطأ(خطأ_تاريخ.تاريخ_غير_صالح());
            };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}

عام نوع date_error = خطأ_تاريخ;
عام نوع date_time = تاريخ_ووقت;
عام مرادف date_time_is_valid = تاريخ_ووقت_صالح;
عام مرادف new_date_time = أنشئ_تاريخا_ووقتا;
عام مرادف new_date_time_unknown_offset = أنشئ_تاريخا_ووقتا_بإزاحة_مجهولة;
عام مرادف format_iso_date = نسق_تاريخ_آيزو;
عام مرادف parse_iso_date = حلل_تاريخ_آيزو;
