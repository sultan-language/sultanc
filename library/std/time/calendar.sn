// Proleptic Gregorian calendar helpers for years 0000..9999.
عام نوع يوم_الأسبوع =
    | الأحد
    | الاثنين
    | الثلاثاء
    | الأربعاء
    | الخميس
    | الجمعة
    | السبت
;

عام نوع تاريخ_تقويمي = {
    السنة: عدد,
    الشهر: طبيعي,
    اليوم: طبيعي
};

عام عرف سنة_كبيسة(السنة: عدد): منطقي {
    إذا ((السنة % 400) == 0) { أرجع صواب; };
    إذا ((السنة % 100) == 0) { أرجع خطأ; };
    أرجع (السنة % 4) == 0;
}

عام عرف أيام_في_الشهر(السنة: عدد, الشهر: طبيعي): طبيعي {
    إذا ((الشهر == 1) || (الشهر == 3) || (الشهر == 5) || (الشهر == 7)
        || (الشهر == 8) || (الشهر == 10) || (الشهر == 12)) { أرجع 31; };
    إذا ((الشهر == 4) || (الشهر == 6) || (الشهر == 9) || (الشهر == 11)) { أرجع 30; };
    إذا (الشهر == 2) {
        إذا (سنة_كبيسة(السنة)) { أرجع 29; };
        أرجع 28;
    };
    أرجع 0;
}

عام عرف تاريخ_تقويمي_صالح(التاريخ: &تاريخ_تقويمي): منطقي {
    إذا (((*التاريخ).السنة < 0) || ((*التاريخ).السنة > 9999)) { أرجع خطأ; };
    إذا (((*التاريخ).الشهر < 1) || ((*التاريخ).الشهر > 12)) { أرجع خطأ; };
    دع الحد: طبيعي = أيام_في_الشهر((*التاريخ).السنة, (*التاريخ).الشهر);
    أرجع ((*التاريخ).اليوم >= 1) && ((*التاريخ).اليوم <= الحد);
}

عام عرف أنشئ_تاريخا_تقويميا(السنة: عدد, الشهر: طبيعي, اليوم: طبيعي): اختياري تاريخ_تقويمي {
    دع الناتج: تاريخ_تقويمي = { السنة: السنة, الشهر: الشهر, اليوم: اليوم };
    إذا (!تاريخ_تقويمي_صالح(&الناتج)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الناتج);
}

عرف أيام_قبل_السنة(السنة: عدد): عدد {
    // Number of days in Gregorian years [0000, السنة).
    أرجع (السنة * 365)
        + ((السنة + 3) / 4)
        - ((السنة + 99) / 100)
        + ((السنة + 399) / 400);
}

عرف أيام_قبل_الشهر(السنة: عدد, الشهر: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = 0;
    دع ش: متغير طبيعي = 1;
    طالما (ش < الشهر) {
        الناتج := الناتج + أيام_في_الشهر(السنة, ش);
        ش := ش + 1;
    }
    أرجع الناتج;
}

عام عرف ترتيب_اليوم_في_السنة(التاريخ: &تاريخ_تقويمي): اختياري طبيعي {
    إذا (!تاريخ_تقويمي_صالح(التاريخ)) { أرجع اختياري.لا_شيء(); };
    دع السابق: طبيعي = أيام_قبل_الشهر((*التاريخ).السنة, (*التاريخ).الشهر);
    أرجع اختياري.موجود(السابق + (*التاريخ).اليوم);
}

عام عرف أيام_يونكس_من_التاريخ(التاريخ: &تاريخ_تقويمي): اختياري عدد {
    إذا (!تاريخ_تقويمي_صالح(التاريخ)) { أرجع اختياري.لا_شيء(); };
    دع المطلقة: عدد = أيام_قبل_السنة((*التاريخ).السنة)
        + (أيام_قبل_الشهر((*التاريخ).السنة, (*التاريخ).الشهر) مثل عدد)
        + ((*التاريخ).اليوم مثل عدد) - 1;
    دع أصل_يونكس: عدد = أيام_قبل_السنة(1970);
    أرجع اختياري.موجود(المطلقة - أصل_يونكس);
}

عام عرف تاريخ_من_أيام_يونكس(الأيام: عدد): اختياري تاريخ_تقويمي {
    دع أصل_يونكس: عدد = أيام_قبل_السنة(1970);
    دع المطلقة: عدد = الأيام + أصل_يونكس;
    إذا (المطلقة < 0) { أرجع اختياري.لا_شيء(); };
    دع نهاية_النطاق: عدد = أيام_قبل_السنة(10000);
    إذا (المطلقة >= نهاية_النطاق) { أرجع اختياري.لا_شيء(); };

    دع الأدنى: متغير عدد = 0;
    دع الأعلى: متغير عدد = 10000;
    طالما ((الأدنى + 1) < الأعلى) {
        دع الوسط: عدد = (الأدنى + الأعلى) / 2;
        إذا (أيام_قبل_السنة(الوسط) <= المطلقة) {
            الأدنى := الوسط;
        } وإلا {
            الأعلى := الوسط;
        };
    }

    دع السنة: عدد = الأدنى;
    دع المتبقي: متغير طبيعي = (المطلقة - أيام_قبل_السنة(السنة)) مثل طبيعي;
    دع الشهر: متغير طبيعي = 1;
    طالما (الشهر <= 12) {
        دع أيام_الشهر: طبيعي = أيام_في_الشهر(السنة, الشهر);
        إذا (المتبقي < أيام_الشهر) {
            دع الناتج: تاريخ_تقويمي = {
                السنة: السنة,
                الشهر: الشهر,
                اليوم: المتبقي + 1
            };
            أرجع اختياري.موجود(الناتج);
        };
        المتبقي := المتبقي - أيام_الشهر;
        الشهر := الشهر + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف يوم_الأسبوع_للتاريخ(التاريخ: &تاريخ_تقويمي): اختياري يوم_الأسبوع {
    طابق أيام_يونكس_من_التاريخ(التاريخ) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأيام) -> {
        دع الرقم: متغير عدد = (الأيام + 4) % 7;
        إذا (الرقم < 0) { الرقم := الرقم + 7; };
        إذا (الرقم == 0) { أرجع اختياري.موجود(يوم_الأسبوع.الأحد()); };
        إذا (الرقم == 1) { أرجع اختياري.موجود(يوم_الأسبوع.الاثنين()); };
        إذا (الرقم == 2) { أرجع اختياري.موجود(يوم_الأسبوع.الثلاثاء()); };
        إذا (الرقم == 3) { أرجع اختياري.موجود(يوم_الأسبوع.الأربعاء()); };
        إذا (الرقم == 4) { أرجع اختياري.موجود(يوم_الأسبوع.الخميس()); };
        إذا (الرقم == 5) { أرجع اختياري.موجود(يوم_الأسبوع.الجمعة()); };
        أرجع اختياري.موجود(يوم_الأسبوع.السبت());
    };
}

عام مرادف weekday = يوم_الأسبوع;
عام نوع calendar_date = تاريخ_تقويمي;
عام مرادف is_leap_year = سنة_كبيسة;
عام مرادف days_in_month = أيام_في_الشهر;
عام مرادف calendar_date_is_valid = تاريخ_تقويمي_صالح;
عام مرادف new_calendar_date = أنشئ_تاريخا_تقويميا;
عام مرادف day_of_year = ترتيب_اليوم_في_السنة;
عام مرادف unix_days_from_date = أيام_يونكس_من_التاريخ;
عام مرادف date_from_unix_days = تاريخ_من_أيام_يونكس;
عام مرادف weekday_for_date = يوم_الأسبوع_للتاريخ;
عام مرادف weekday.sunday = يوم_الأسبوع.الأحد;
عام مرادف weekday.monday = يوم_الأسبوع.الاثنين;
عام مرادف weekday.tuesday = يوم_الأسبوع.الثلاثاء;
عام مرادف weekday.wednesday = يوم_الأسبوع.الأربعاء;
عام مرادف weekday.thursday = يوم_الأسبوع.الخميس;
عام مرادف weekday.friday = يوم_الأسبوع.الجمعة;
عام مرادف weekday.saturday = يوم_الأسبوع.السبت;
