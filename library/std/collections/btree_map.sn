// Ordered generic B-tree map. Minimum degree 8 gives up to 15 keys and
// 16 children per node. Optional slots let structural operations move owning
// generic keys/values without copying them.
// The caller comparator must define a stable total ordering: zero exactly for
// equivalent keys, and a consistent sign for each ordered pair of keys.

استورد process.panic;

عام نوع مدخل_خريطة_شجرة_بي<م, ق> = {
    المفتاح: م,
    القيمة: ق
};

نوع مدخل_منقول_شجرة_بي<م, ق> = {
    المفتاح: اختياري م,
    القيمة: اختياري ق
};

// Child node indices are ط32 (خصص_عقدة_خريطة_شجرة_بي checks the node count)
// and the key count, at most 15, is ط8.
نوع عقدة_خريطة_شجرة_بي<م, ق> = {
    المفاتيح: متجه اختياري م,
    القيم: متجه اختياري ق,
    الأبناء: متجه ط32,
    العدد: ط8,
    ورقة: منطقي,
    فعالة: منطقي
};

نوع موضع_خريطة_شجرة_بي = {
    العقدة: طبيعي,
    الموضع: طبيعي
};

عام نوع خريطة_شجرة_بي<م, ق> = {
    العقد: متجه عقدة_خريطة_شجرة_بي<م, ق>,
    الجذر: طبيعي,
    العدد: طبيعي,
    المقارنة: دالة(&م, &م): عدد,
    العقد_الحرة: متجه ط32,
    عدد_العقد_الحرة: طبيعي
};

عرف درجة_خريطة_شجرة_بي(): طبيعي { أرجع 8; }
عرف أقصى_مفاتيح_خريطة_شجرة_بي(): طبيعي { أرجع 15; }
عرف أقصى_أبناء_خريطة_شجرة_بي(): طبيعي { أرجع 16; }

عرف ابن_عقدة_خريطة_شجرة_بي<م, ق>(ورقة: منطقي): عقدة_خريطة_شجرة_بي<م, ق> {
    دع المفاتيح: متغير متجه اختياري م = [];
    دع القيم: متغير متجه اختياري ق = [];
    دع الأبناء: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < أقصى_مفاتيح_خريطة_شجرة_بي()) {
        ألحق(المفاتيح, اختياري.لا_شيء());
        ألحق(القيم, اختياري.لا_شيء());
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < أقصى_أبناء_خريطة_شجرة_بي()) {
        ألحق(الأبناء, 0);
        ف := ف + 1;
    }
    دع الناتج: عقدة_خريطة_شجرة_بي<م, ق> = {
        المفاتيح: المفاتيح,
        القيم: القيم,
        الأبناء: الأبناء,
        العدد: 0,
        ورقة: ورقة,
        فعالة: صواب
    };
    أرجع الناتج;
}

عرف فرغ_عقدة_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    الفهرس: طبيعي,
    ورقة: منطقي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < أقصى_مفاتيح_خريطة_شجرة_بي()) {
        دع مفتاح_مزال: متغير اختياري م = اختياري.لا_شيء();
        دع قيمة_مزالة: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الخريطة).العقد[الفهرس].المفاتيح[ف], مفتاح_مزال);
        بدّل((*الخريطة).العقد[الفهرس].القيم[ف], قيمة_مزالة);
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < أقصى_أبناء_خريطة_شجرة_بي()) {
        (*الخريطة).العقد[الفهرس].الأبناء[ف] := 0;
        ف := ف + 1;
    }
    (*الخريطة).العقد[الفهرس].العدد := 0;
    (*الخريطة).العقد[الفهرس].ورقة := ورقة;
    (*الخريطة).العقد[الفهرس].فعالة := صواب;
}

عرف خصص_عقدة_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    ورقة: منطقي
): طبيعي {
    إذا ((*الخريطة).عدد_العقد_الحرة > 0) {
        دع الموضع: طبيعي = (*الخريطة).عدد_العقد_الحرة - 1;
        دع الفهرس: طبيعي = (*الخريطة).العقد_الحرة[الموضع];
        (*الخريطة).عدد_العقد_الحرة := الموضع;
        فرغ_عقدة_خريطة_شجرة_بي(الخريطة, الفهرس, ورقة);
        أرجع الفهرس;
    };
    دع الفهرس: طبيعي = الطول((*الخريطة).العقد) مثل طبيعي;
    // Children hold node indices as ط32.
    إذا (الفهرس >= 0xFFFFFFFF) {
        إنهيار(«btree map: more than 2^32 - 1 nodes»);
    };
    دع العقدة: عقدة_خريطة_شجرة_بي<م, ق> = ابن_عقدة_خريطة_شجرة_بي(ورقة);
    ألحق((*الخريطة).العقد, العقدة);
    أرجع الفهرس;
}

عرف حرر_عقدة_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    الفهرس: طبيعي
): فراغ {
    (*الخريطة).العقد[الفهرس].العدد := 0;
    (*الخريطة).العقد[الفهرس].ورقة := صواب;
    (*الخريطة).العقد[الفهرس].فعالة := خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < أقصى_أبناء_خريطة_شجرة_بي()) {
        (*الخريطة).العقد[الفهرس].الأبناء[ف] := 0;
        ف := ف + 1;
    }
    دع الموضع: طبيعي = (*الخريطة).عدد_العقد_الحرة;
    إذا (الموضع < (الطول((*الخريطة).العقد_الحرة) مثل طبيعي)) {
        (*الخريطة).العقد_الحرة[الموضع] := الفهرس مثل ط32;
    } وإلا {
        ألحق((*الخريطة).العقد_الحرة, الفهرس مثل ط32);
    };
    (*الخريطة).عدد_العقد_الحرة := الموضع + 1;
}

عام عرف أنشئ_خريطة_شجرة_بي<م, ق>(المقارنة: دالة(&م, &م): عدد): خريطة_شجرة_بي<م, ق> {
    دع العقد: متجه عقدة_خريطة_شجرة_بي<م, ق> = [];
    دع الحرة: متجه ط32 = [];
    دع الناتج: متغير خريطة_شجرة_بي<م, ق> = {
        العقد: العقد,
        الجذر: 0,
        العدد: 0,
        المقارنة: المقارنة,
        العقد_الحرة: الحرة,
        عدد_العقد_الحرة: 0
    };
    دع الجذر: طبيعي = خصص_عقدة_خريطة_شجرة_بي(&متغير الناتج, صواب);
    الناتج.الجذر := الجذر;
    أرجع الناتج;
}

عام عرف طول_خريطة_شجرة_بي<م, ق>(الخريطة: &خريطة_شجرة_بي<م, ق>): طبيعي {
    أرجع (*الخريطة).العدد;
}

عام عرف خريطة_شجرة_بي_فارغة<م, ق>(الخريطة: &خريطة_شجرة_بي<م, ق>): منطقي {
    أرجع (*الخريطة).العدد == 0;
}

عرف ابحث_عن_موضع_خريطة_شجرة_بي<م, ق>(
    الخريطة: &خريطة_شجرة_بي<م, ق>,
    المفتاح: &م
): اختياري موضع_خريطة_شجرة_بي {
    دع المقارنة: دالة(&م, &م): عدد = (*الخريطة).المقارنة;
    دع فهرس_العقدة: متغير طبيعي = (*الخريطة).الجذر;
    طالما (صواب) {
        دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف] مع
            | اختياري.موجود(المخزن) -> {
                دع ج: عدد = المقارنة(المفتاح, &المخزن);
                إذا (ج == 0) {
                    دع الناتج: موضع_خريطة_شجرة_بي = { العقدة: فهرس_العقدة, الموضع: ف };
                    أرجع اختياري.موجود(الناتج);
                };
                إذا (ج < 0) { اخرج_من_حلقة; };
            }
            | اختياري.لا_شيء -> { اخرج_من_حلقة; };
            ف := ف + 1;
        }
        إذا ((*الخريطة).العقد[فهرس_العقدة].ورقة) { أرجع اختياري.لا_شيء(); };
        فهرس_العقدة := (*الخريطة).العقد[فهرس_العقدة].الأبناء[ف];
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ابحث_في_خريطة_شجرة_بي<م, ق>(
    الخريطة: &خريطة_شجرة_بي<م, ق>,
    المفتاح: &م
): اختياري ق {
    طابق ابحث_عن_موضع_خريطة_شجرة_بي(الخريطة, المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموجود) -> {
        // The map keeps its value; the caller gets a copy.
        طابق (*الخريطة).العقد[الموجود.العقدة].القيم[الموجود.الموضع] مع
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(استنسخ(&القيمة)); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
}

عام عرف تحتوي_خريطة_شجرة_بي<م, ق>(
    الخريطة: &خريطة_شجرة_بي<م, ق>,
    المفتاح: &م
): منطقي {
    طابق ابحث_عن_موضع_خريطة_شجرة_بي(الخريطة, المفتاح) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عرف قسم_ابن_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_الأب: طبيعي,
    موضع_الابن: طبيعي
): فراغ {
    دع فهرس_القديم: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن];
    دع ورقة: منطقي = (*الخريطة).العقد[فهرس_القديم].ورقة;
    دع فهرس_الجديد: طبيعي = خصص_عقدة_خريطة_شجرة_بي(الخريطة, ورقة);
    دع الدرجة: طبيعي = درجة_خريطة_شجرة_بي();
    دع ف: متغير طبيعي = 0;

    // Move the upper t-1 keys into the new sibling.
    طالما (ف < الدرجة - 1) {
        بدّل(
            (*الخريطة).العقد[فهرس_القديم].المفاتيح[ف + الدرجة],
            (*الخريطة).العقد[فهرس_الجديد].المفاتيح[ف]
        );
        بدّل(
            (*الخريطة).العقد[فهرس_القديم].القيم[ف + الدرجة],
            (*الخريطة).العقد[فهرس_الجديد].القيم[ف]
        );
        ف := ف + 1;
    }
    (*الخريطة).العقد[فهرس_الجديد].العدد := (الدرجة - 1) مثل ط8;

    إذا (!ورقة) {
        ف := 0;
        طالما (ف < الدرجة) {
            (*الخريطة).العقد[فهرس_الجديد].الأبناء[ف] :=
                (*الخريطة).العقد[فهرس_القديم].الأبناء[ف + الدرجة];
            (*الخريطة).العقد[فهرس_القديم].الأبناء[ف + الدرجة] := 0;
            ف := ف + 1;
        }
    };

    دع عدد_الأب: طبيعي = (*الخريطة).العقد[فهرس_الأب].العدد;
    دع ع: متغير طبيعي = عدد_الأب + 1;
    طالما (ع > موضع_الابن + 1) {
        (*الخريطة).العقد[فهرس_الأب].الأبناء[ع] :=
            (*الخريطة).العقد[فهرس_الأب].الأبناء[ع - 1];
        ع := ع - 1;
    }
    (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن + 1] := فهرس_الجديد مثل ط32;

    ع := عدد_الأب;
    طالما (ع > موضع_الابن) {
        بدّل(
            (*الخريطة).العقد[فهرس_الأب].المفاتيح[ع],
            (*الخريطة).العقد[فهرس_الأب].المفاتيح[ع - 1]
        );
        بدّل(
            (*الخريطة).العقد[فهرس_الأب].القيم[ع],
            (*الخريطة).العقد[فهرس_الأب].القيم[ع - 1]
        );
        ع := ع - 1;
    }

    // Move the median into the parent.
    بدّل(
        (*الخريطة).العقد[فهرس_القديم].المفاتيح[الدرجة - 1],
        (*الخريطة).العقد[فهرس_الأب].المفاتيح[موضع_الابن]
    );
    بدّل(
        (*الخريطة).العقد[فهرس_القديم].القيم[الدرجة - 1],
        (*الخريطة).العقد[فهرس_الأب].القيم[موضع_الابن]
    );

    (*الخريطة).العقد[فهرس_القديم].العدد := (الدرجة - 1) مثل ط8;
    (*الخريطة).العقد[فهرس_الأب].العدد := (عدد_الأب + 1) مثل ط8;
}

عرف أدرج_في_عقدة_غير_ممتلئة<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_العقدة: طبيعي,
    المفتاح: م,
    القيمة: ق
): اختياري ق {
    دع المقارنة: دالة(&م, &م): عدد = (*الخريطة).المقارنة;
    دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
    دع ف: متغير طبيعي = 0;

    طالما (ف < العدد) {
        طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف] مع
        | اختياري.موجود(المخزن) -> {
            دع ج: عدد = المقارنة(&المفتاح, &المخزن);
            إذا (ج == 0) {
                دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
                بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], الجديدة);
                أرجع الجديدة;
            };
            إذا (ج < 0) { اخرج_من_حلقة; };
        }
        | اختياري.لا_شيء -> { اخرج_من_حلقة; };
        ف := ف + 1;
    }

    إذا ((*الخريطة).العقد[فهرس_العقدة].ورقة) {
        دع ع: متغير طبيعي = العدد;
        طالما (ع > ف) {
            بدّل(
                (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ع],
                (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ع - 1]
            );
            بدّل(
                (*الخريطة).العقد[فهرس_العقدة].القيم[ع],
                (*الخريطة).العقد[فهرس_العقدة].القيم[ع - 1]
            );
            ع := ع - 1;
        }
        دع مفتاح_جديد: متغير اختياري م = اختياري.موجود(المفتاح);
        دع قيمة_جديدة: متغير اختياري ق = اختياري.موجود(القيمة);
        بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف], مفتاح_جديد);
        بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], قيمة_جديدة);
        (*الخريطة).العقد[فهرس_العقدة].العدد := (العدد + 1) مثل ط8;
        أرجع اختياري.لا_شيء();
    };

    دع موضع_الابن: متغير طبيعي = ف;
    دع فهرس_الابن: متغير طبيعي = (*الخريطة).العقد[فهرس_العقدة].الأبناء[موضع_الابن];
    إذا (((*الخريطة).العقد[فهرس_الابن].العدد مثل طبيعي) == أقصى_مفاتيح_خريطة_شجرة_بي()) {
        قسم_ابن_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, موضع_الابن);
        طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[موضع_الابن] مع
        | اختياري.موجود(الوسيط) -> {
            دع ج: عدد = المقارنة(&المفتاح, &الوسيط);
            إذا (ج == 0) {
                دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
                بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[موضع_الابن], الجديدة);
                أرجع الجديدة;
            };
            إذا (ج > 0) { موضع_الابن := موضع_الابن + 1; };
        }
        | اختياري.لا_شيء -> { };
        فهرس_الابن := (*الخريطة).العقد[فهرس_العقدة].الأبناء[موضع_الابن];
    };
    أرجع أدرج_في_عقدة_غير_ممتلئة(الخريطة, فهرس_الابن, المفتاح, القيمة);
}

عام عرف أدرج_في_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    المفتاح: م,
    القيمة: ق
): اختياري ق {
    دع الجذر_القديم: طبيعي = (*الخريطة).الجذر;
    إذا (((*الخريطة).العقد[الجذر_القديم].العدد مثل طبيعي) == أقصى_مفاتيح_خريطة_شجرة_بي()) {
        دع الجذر_الجديد: طبيعي = خصص_عقدة_خريطة_شجرة_بي(الخريطة, خطأ);
        (*الخريطة).العقد[الجذر_الجديد].الأبناء[0] := الجذر_القديم مثل ط32;
        (*الخريطة).الجذر := الجذر_الجديد;
        قسم_ابن_خريطة_شجرة_بي(الخريطة, الجذر_الجديد, 0);
    };
    دع الناتج: اختياري ق = أدرج_في_عقدة_غير_ممتلئة(
        الخريطة,
        (*الخريطة).الجذر,
        المفتاح,
        القيمة
    );
    طابق الناتج مع
    | اختياري.لا_شيء -> { (*الخريطة).العدد := (*الخريطة).العدد + 1; }
    | اختياري.موجود(_) -> { };
    أرجع الناتج;
}

عرف خذ_من_ورقة_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_العقدة: طبيعي,
    الموضع: طبيعي
): مدخل_منقول_شجرة_بي<م, ق> {
    دع المفتاح: متغير اختياري م = اختياري.لا_شيء();
    دع القيمة: متغير اختياري ق = اختياري.لا_شيء();
    بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[الموضع], المفتاح);
    بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[الموضع], القيمة);
    دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
    دع ف: متغير طبيعي = الموضع;
    طالما (ف + 1 < العدد) {
        بدّل(
            (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف],
            (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف + 1]
        );
        بدّل(
            (*الخريطة).العقد[فهرس_العقدة].القيم[ف],
            (*الخريطة).العقد[فهرس_العقدة].القيم[ف + 1]
        );
        ف := ف + 1;
    }
    (*الخريطة).العقد[فهرس_العقدة].العدد := (العدد - 1) مثل ط8;
    دع الناتج: مدخل_منقول_شجرة_بي<م, ق> = { المفتاح: المفتاح, القيمة: القيمة };
    أرجع الناتج;
}

عرف استعر_من_السابق_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_الأب: طبيعي,
    موضع_الابن: طبيعي
): فراغ {
    دع فهرس_الابن: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن];
    دع فهرس_السابق: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن - 1];
    دع عدد_الابن: طبيعي = (*الخريطة).العقد[فهرس_الابن].العدد;
    دع عدد_السابق: طبيعي = (*الخريطة).العقد[فهرس_السابق].العدد;
    دع ف: متغير طبيعي = عدد_الابن;
    طالما (ف > 0) {
        بدّل((*الخريطة).العقد[فهرس_الابن].المفاتيح[ف], (*الخريطة).العقد[فهرس_الابن].المفاتيح[ف - 1]);
        بدّل((*الخريطة).العقد[فهرس_الابن].القيم[ف], (*الخريطة).العقد[فهرس_الابن].القيم[ف - 1]);
        ف := ف - 1;
    }
    إذا (!(*الخريطة).العقد[فهرس_الابن].ورقة) {
        ف := عدد_الابن + 1;
        طالما (ف > 0) {
            (*الخريطة).العقد[فهرس_الابن].الأبناء[ف] := (*الخريطة).العقد[فهرس_الابن].الأبناء[ف - 1];
            ف := ف - 1;
        }
        (*الخريطة).العقد[فهرس_الابن].الأبناء[0] := (*الخريطة).العقد[فهرس_السابق].الأبناء[عدد_السابق];
        (*الخريطة).العقد[فهرس_السابق].الأبناء[عدد_السابق] := 0;
    };
    بدّل((*الخريطة).العقد[فهرس_الأب].المفاتيح[موضع_الابن - 1], (*الخريطة).العقد[فهرس_الابن].المفاتيح[0]);
    بدّل((*الخريطة).العقد[فهرس_الأب].القيم[موضع_الابن - 1], (*الخريطة).العقد[فهرس_الابن].القيم[0]);
    بدّل((*الخريطة).العقد[فهرس_السابق].المفاتيح[عدد_السابق - 1], (*الخريطة).العقد[فهرس_الأب].المفاتيح[موضع_الابن - 1]);
    بدّل((*الخريطة).العقد[فهرس_السابق].القيم[عدد_السابق - 1], (*الخريطة).العقد[فهرس_الأب].القيم[موضع_الابن - 1]);
    (*الخريطة).العقد[فهرس_السابق].العدد := (عدد_السابق - 1) مثل ط8;
    (*الخريطة).العقد[فهرس_الابن].العدد := (عدد_الابن + 1) مثل ط8;
}

عرف استعر_من_التالي_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_الأب: طبيعي,
    موضع_الابن: طبيعي
): فراغ {
    دع فهرس_الابن: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن];
    دع فهرس_التالي: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن + 1];
    دع عدد_الابن: طبيعي = (*الخريطة).العقد[فهرس_الابن].العدد;
    دع عدد_التالي: طبيعي = (*الخريطة).العقد[فهرس_التالي].العدد;
    بدّل((*الخريطة).العقد[فهرس_الأب].المفاتيح[موضع_الابن], (*الخريطة).العقد[فهرس_الابن].المفاتيح[عدد_الابن]);
    بدّل((*الخريطة).العقد[فهرس_الأب].القيم[موضع_الابن], (*الخريطة).العقد[فهرس_الابن].القيم[عدد_الابن]);
    إذا (!(*الخريطة).العقد[فهرس_الابن].ورقة) {
        (*الخريطة).العقد[فهرس_الابن].الأبناء[عدد_الابن + 1] := (*الخريطة).العقد[فهرس_التالي].الأبناء[0];
    };
    بدّل((*الخريطة).العقد[فهرس_التالي].المفاتيح[0], (*الخريطة).العقد[فهرس_الأب].المفاتيح[موضع_الابن]);
    بدّل((*الخريطة).العقد[فهرس_التالي].القيم[0], (*الخريطة).العقد[فهرس_الأب].القيم[موضع_الابن]);
    دع ف: متغير طبيعي = 0;
    طالما (ف + 1 < عدد_التالي) {
        بدّل((*الخريطة).العقد[فهرس_التالي].المفاتيح[ف], (*الخريطة).العقد[فهرس_التالي].المفاتيح[ف + 1]);
        بدّل((*الخريطة).العقد[فهرس_التالي].القيم[ف], (*الخريطة).العقد[فهرس_التالي].القيم[ف + 1]);
        ف := ف + 1;
    }
    إذا (!(*الخريطة).العقد[فهرس_التالي].ورقة) {
        ف := 0;
        طالما (ف < عدد_التالي) {
            (*الخريطة).العقد[فهرس_التالي].الأبناء[ف] := (*الخريطة).العقد[فهرس_التالي].الأبناء[ف + 1];
            ف := ف + 1;
        }
        (*الخريطة).العقد[فهرس_التالي].الأبناء[عدد_التالي] := 0;
    };
    (*الخريطة).العقد[فهرس_التالي].العدد := (عدد_التالي - 1) مثل ط8;
    (*الخريطة).العقد[فهرس_الابن].العدد := (عدد_الابن + 1) مثل ط8;
}

عرف ادمج_أبناء_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_الأب: طبيعي,
    الموضع: طبيعي
): طبيعي {
    دع فهرس_الأيسر: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[الموضع];
    دع فهرس_الأيمن: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[الموضع + 1];
    دع عدد_الأيسر: طبيعي = (*الخريطة).العقد[فهرس_الأيسر].العدد;
    دع عدد_الأيمن: طبيعي = (*الخريطة).العقد[فهرس_الأيمن].العدد;
    بدّل((*الخريطة).العقد[فهرس_الأب].المفاتيح[الموضع], (*الخريطة).العقد[فهرس_الأيسر].المفاتيح[عدد_الأيسر]);
    بدّل((*الخريطة).العقد[فهرس_الأب].القيم[الموضع], (*الخريطة).العقد[فهرس_الأيسر].القيم[عدد_الأيسر]);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الأيمن) {
        بدّل((*الخريطة).العقد[فهرس_الأيمن].المفاتيح[ف], (*الخريطة).العقد[فهرس_الأيسر].المفاتيح[عدد_الأيسر + 1 + ف]);
        بدّل((*الخريطة).العقد[فهرس_الأيمن].القيم[ف], (*الخريطة).العقد[فهرس_الأيسر].القيم[عدد_الأيسر + 1 + ف]);
        ف := ف + 1;
    }
    إذا (!(*الخريطة).العقد[فهرس_الأيسر].ورقة) {
        ف := 0;
        طالما (ف <= عدد_الأيمن) {
            (*الخريطة).العقد[فهرس_الأيسر].الأبناء[عدد_الأيسر + 1 + ف] := (*الخريطة).العقد[فهرس_الأيمن].الأبناء[ف];
            (*الخريطة).العقد[فهرس_الأيمن].الأبناء[ف] := 0;
            ف := ف + 1;
        }
    };
    (*الخريطة).العقد[فهرس_الأيسر].العدد := (عدد_الأيسر + 1 + عدد_الأيمن) مثل ط8;
    (*الخريطة).العقد[فهرس_الأيمن].العدد := 0;

    دع عدد_الأب: طبيعي = (*الخريطة).العقد[فهرس_الأب].العدد;
    ف := الموضع;
    طالما (ف + 1 < عدد_الأب) {
        بدّل((*الخريطة).العقد[فهرس_الأب].المفاتيح[ف], (*الخريطة).العقد[فهرس_الأب].المفاتيح[ف + 1]);
        بدّل((*الخريطة).العقد[فهرس_الأب].القيم[ف], (*الخريطة).العقد[فهرس_الأب].القيم[ف + 1]);
        ف := ف + 1;
    }
    ف := الموضع + 1;
    طالما (ف < عدد_الأب) {
        (*الخريطة).العقد[فهرس_الأب].الأبناء[ف] := (*الخريطة).العقد[فهرس_الأب].الأبناء[ف + 1];
        ف := ف + 1;
    }
    (*الخريطة).العقد[فهرس_الأب].الأبناء[عدد_الأب] := 0;
    (*الخريطة).العقد[فهرس_الأب].العدد := (عدد_الأب - 1) مثل ط8;
    حرر_عقدة_خريطة_شجرة_بي(الخريطة, فهرس_الأيمن);
    أرجع فهرس_الأيسر;
}

عرف ضمن_ابن_كافيا_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_الأب: طبيعي,
    موضع_الابن: طبيعي
): طبيعي {
    دع الدرجة: طبيعي = درجة_خريطة_شجرة_بي();
    دع عدد_الأب: طبيعي = (*الخريطة).العقد[فهرس_الأب].العدد;
    دع فهرس_الابن: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن];
    إذا (((*الخريطة).العقد[فهرس_الابن].العدد مثل طبيعي) >= الدرجة) { أرجع فهرس_الابن; };
    إذا (موضع_الابن > 0) {
        دع السابق: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن - 1];
        إذا (((*الخريطة).العقد[السابق].العدد مثل طبيعي) >= الدرجة) {
            استعر_من_السابق_خريطة_شجرة_بي(الخريطة, فهرس_الأب, موضع_الابن);
            أرجع فهرس_الابن;
        };
    };
    إذا (موضع_الابن < عدد_الأب) {
        دع التالي: طبيعي = (*الخريطة).العقد[فهرس_الأب].الأبناء[موضع_الابن + 1];
        إذا (((*الخريطة).العقد[التالي].العدد مثل طبيعي) >= الدرجة) {
            استعر_من_التالي_خريطة_شجرة_بي(الخريطة, فهرس_الأب, موضع_الابن);
            أرجع فهرس_الابن;
        };
    };
    إذا (موضع_الابن < عدد_الأب) {
        أرجع ادمج_أبناء_خريطة_شجرة_بي(الخريطة, فهرس_الأب, موضع_الابن);
    };
    أرجع ادمج_أبناء_خريطة_شجرة_بي(الخريطة, فهرس_الأب, موضع_الابن - 1);
}

عرف خذ_أدنى_مدخل_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_البداية: طبيعي
): مدخل_منقول_شجرة_بي<م, ق> {
    دع فهرس_العقدة: متغير طبيعي = فهرس_البداية;
    طالما (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
        فهرس_العقدة := ضمن_ابن_كافيا_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, 0);
    }
    أرجع خذ_من_ورقة_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, 0);
}

عرف خذ_أقصى_مدخل_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_البداية: طبيعي
): مدخل_منقول_شجرة_بي<م, ق> {
    دع فهرس_العقدة: متغير طبيعي = فهرس_البداية;
    طالما (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
        دع موضع_الابن: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
        فهرس_العقدة := ضمن_ابن_كافيا_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, موضع_الابن);
    }
    دع الأخير: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد - 1;
    أرجع خذ_من_ورقة_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, الأخير);
}

عرف احذف_من_عقدة_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    فهرس_العقدة: طبيعي,
    المفتاح: &م
): اختياري ق {
    دع المقارنة: دالة(&م, &م): عدد = (*الخريطة).المقارنة;
    دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
    دع ف: متغير طبيعي = 0;
    دع موجود: متغير منطقي = خطأ;
    طالما (ف < العدد) {
        طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف] مع
        | اختياري.موجود(المخزن) -> {
            دع ج: عدد = المقارنة(المفتاح, &المخزن);
            إذا (ج == 0) { موجود := صواب; اخرج_من_حلقة; };
            إذا (ج < 0) { اخرج_من_حلقة; };
        }
        | اختياري.لا_شيء -> { اخرج_من_حلقة; };
        ف := ف + 1;
    }

    إذا (موجود) {
        إذا ((*الخريطة).العقد[فهرس_العقدة].ورقة) {
            دع المزال: متغير مدخل_منقول_شجرة_بي<م, ق> = خذ_من_ورقة_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, ف);
            دع الناتج: متغير اختياري ق = اختياري.لا_شيء();
            بدّل(المزال.القيمة, الناتج);
            أرجع الناتج;
        };

        دع الأيسر: طبيعي = (*الخريطة).العقد[فهرس_العقدة].الأبناء[ف];
        دع الأيمن: طبيعي = (*الخريطة).العقد[فهرس_العقدة].الأبناء[ف + 1];
        دع الدرجة: طبيعي = درجة_خريطة_شجرة_بي();
        إذا (((*الخريطة).العقد[الأيسر].العدد مثل طبيعي) >= الدرجة) {
            دع المفتاح_القديم: متغير اختياري م = اختياري.لا_شيء();
            دع القيمة_القديمة: متغير اختياري ق = اختياري.لا_شيء();
            بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف], المفتاح_القديم);
            بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], القيمة_القديمة);
            دع البديل: متغير مدخل_منقول_شجرة_بي<م, ق> = خذ_أقصى_مدخل_خريطة_شجرة_بي(الخريطة, الأيسر);
            بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف], البديل.المفتاح);
            بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], البديل.القيمة);
            أرجع القيمة_القديمة;
        };
        إذا (((*الخريطة).العقد[الأيمن].العدد مثل طبيعي) >= الدرجة) {
            دع المفتاح_القديم: متغير اختياري م = اختياري.لا_شيء();
            دع القيمة_القديمة: متغير اختياري ق = اختياري.لا_شيء();
            بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف], المفتاح_القديم);
            بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], القيمة_القديمة);
            دع البديل: متغير مدخل_منقول_شجرة_بي<م, ق> = خذ_أدنى_مدخل_خريطة_شجرة_بي(الخريطة, الأيمن);
            بدّل((*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف], البديل.المفتاح);
            بدّل((*الخريطة).العقد[فهرس_العقدة].القيم[ف], البديل.القيمة);
            أرجع القيمة_القديمة;
        };
        دع المدمج: طبيعي = ادمج_أبناء_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, ف);
        أرجع احذف_من_عقدة_خريطة_شجرة_بي(الخريطة, المدمج, المفتاح);
    };

    إذا ((*الخريطة).العقد[فهرس_العقدة].ورقة) { أرجع اختياري.لا_شيء(); };
    دع الابن: طبيعي = ضمن_ابن_كافيا_خريطة_شجرة_بي(الخريطة, فهرس_العقدة, ف);
    أرجع احذف_من_عقدة_خريطة_شجرة_بي(الخريطة, الابن, المفتاح);
}

عام عرف احذف_من_خريطة_شجرة_بي<م, ق>(
    الخريطة: &متغير خريطة_شجرة_بي<م, ق>,
    المفتاح: &م
): اختياري ق {
    إذا ((*الخريطة).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: اختياري ق = احذف_من_عقدة_خريطة_شجرة_بي(الخريطة, (*الخريطة).الجذر, المفتاح);
    طابق الناتج مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(_) -> { (*الخريطة).العدد := (*الخريطة).العدد - 1; };

    دع الجذر_القديم: طبيعي = (*الخريطة).الجذر;
    إذا (((*الخريطة).العقد[الجذر_القديم].العدد == 0) && !(*الخريطة).العقد[الجذر_القديم].ورقة) {
        دع الجذر_الجديد: طبيعي = (*الخريطة).العقد[الجذر_القديم].الأبناء[0];
        (*الخريطة).العقد[الجذر_القديم].الأبناء[0] := 0;
        (*الخريطة).الجذر := الجذر_الجديد;
        حرر_عقدة_خريطة_شجرة_بي(الخريطة, الجذر_القديم);
    };
    أرجع الناتج;
}

عرف اجمع_مداخل_خريطة_شجرة_بي<م, ق>(
    الخريطة: &خريطة_شجرة_بي<م, ق>,
    فهرس_العقدة: طبيعي,
    الناتج: &متغير متجه مدخل_خريطة_شجرة_بي<م, ق>
): فراغ {
    دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
            اجمع_مداخل_خريطة_شجرة_بي(
                الخريطة,
                (*الخريطة).العقد[فهرس_العقدة].الأبناء[ف],
                الناتج
            );
        };
        طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف] مع
        | اختياري.موجود(المفتاح) -> {
            طابق (*الخريطة).العقد[فهرس_العقدة].القيم[ف] مع
            | اختياري.موجود(القيمة) -> {
                دع المدخل: مدخل_خريطة_شجرة_بي<م, ق> = { المفتاح: المفتاح, القيمة: القيمة };
                ألحق(*الناتج, المدخل);
            }
            | اختياري.لا_شيء -> { };
        }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
        اجمع_مداخل_خريطة_شجرة_بي(
            الخريطة,
            (*الخريطة).العقد[فهرس_العقدة].الأبناء[العدد],
            الناتج
        );
    };
}

عام عرف مداخل_خريطة_شجرة_بي<م, ق>(الخريطة: &خريطة_شجرة_بي<م, ق>): متجه مدخل_خريطة_شجرة_بي<م, ق> {
    دع الناتج: متغير متجه مدخل_خريطة_شجرة_بي<م, ق> = [];
    إذا ((*الخريطة).العدد > 0) {
        اجمع_مداخل_خريطة_شجرة_بي(الخريطة, (*الخريطة).الجذر, &متغير الناتج);
    };
    أرجع الناتج;
}

// Extract keys in comparator order without copying every associated value.
عرف اجمع_مفاتيح_خريطة_شجرة_بي<م, ق>(
    الخريطة: &خريطة_شجرة_بي<م, ق>,
    فهرس_العقدة: طبيعي,
    الناتج: &متغير متجه م
): فراغ {
    دع العدد: طبيعي = (*الخريطة).العقد[فهرس_العقدة].العدد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
            اجمع_مفاتيح_خريطة_شجرة_بي(
                الخريطة,
                (*الخريطة).العقد[فهرس_العقدة].الأبناء[ف],
                الناتج
            );
        };
        طابق (*الخريطة).العقد[فهرس_العقدة].المفاتيح[ف] مع
        | اختياري.موجود(المفتاح) -> { ألحق(*الناتج, المفتاح); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    إذا (!(*الخريطة).العقد[فهرس_العقدة].ورقة) {
        اجمع_مفاتيح_خريطة_شجرة_بي(
            الخريطة,
            (*الخريطة).العقد[فهرس_العقدة].الأبناء[العدد],
            الناتج
        );
    };
}

عام عرف مفاتيح_خريطة_شجرة_بي<م, ق>(الخريطة: &خريطة_شجرة_بي<م, ق>): متجه م {
    دع الناتج: متغير متجه م = [];
    إذا ((*الخريطة).العدد > 0) {
        اجمع_مفاتيح_خريطة_شجرة_بي(الخريطة, (*الخريطة).الجذر, &متغير الناتج);
    };
    أرجع الناتج;
}

عام عرف امسح_خريطة_شجرة_بي<م, ق>(الخريطة: &متغير خريطة_شجرة_بي<م, ق>): فراغ {
    دع عدد_العقد: طبيعي = الطول((*الخريطة).العقد) مثل طبيعي;
    دع الجذر: طبيعي = (*الخريطة).الجذر;
    دع الحرة: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_العقد) {
        فرغ_عقدة_خريطة_شجرة_بي(الخريطة, ف, صواب);
        إذا (ف != الجذر) {
            (*الخريطة).العقد[ف].فعالة := خطأ;
            ألحق(الحرة, ف مثل ط32);
        };
        ف := ف + 1;
    }
    (*الخريطة).العقد[الجذر].فعالة := صواب;
    (*الخريطة).العقد[الجذر].ورقة := صواب;
    (*الخريطة).العقد[الجذر].العدد := 0;
    (*الخريطة).العقد_الحرة := الحرة;
    (*الخريطة).عدد_العقد_الحرة := الطول((*الخريطة).العقد_الحرة) مثل طبيعي;
    (*الخريطة).العدد := 0;
}

عام عرف أعد_ضبط_خريطة_شجرة_بي<م, ق>(الخريطة: &متغير خريطة_شجرة_بي<م, ق>): فراغ {
    دع المقارنة: دالة(&م, &م): عدد = (*الخريطة).المقارنة;
    دع الجديدة: خريطة_شجرة_بي<م, ق> = أنشئ_خريطة_شجرة_بي(المقارنة);
    *الخريطة := الجديدة;
}

// English language surface.
عام نوع btree_map_entry<K, V> = مدخل_خريطة_شجرة_بي<K, V>;
عام نوع btree_map<K, V> = خريطة_شجرة_بي<K, V>;
عام مرادف new_btree_map = أنشئ_خريطة_شجرة_بي;
عام مرادف btree_map_insert = أدرج_في_خريطة_شجرة_بي;
عام مرادف btree_map_get = ابحث_في_خريطة_شجرة_بي;
عام مرادف btree_map_contains = تحتوي_خريطة_شجرة_بي;
عام مرادف btree_map_remove = احذف_من_خريطة_شجرة_بي;
عام مرادف btree_map_length = طول_خريطة_شجرة_بي;
عام مرادف btree_map_is_empty = خريطة_شجرة_بي_فارغة;
عام مرادف btree_map_entries = مداخل_خريطة_شجرة_بي;
عام مرادف btree_map_keys = مفاتيح_خريطة_شجرة_بي;
عام مرادف btree_map_clear = امسح_خريطة_شجرة_بي;
عام مرادف btree_map_reset = أعد_ضبط_خريطة_شجرة_بي;
