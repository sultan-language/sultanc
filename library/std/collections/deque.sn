// Generic double-ended queue backed by a growable ring buffer. Optional slots
// provide explicit empty storage so owning values can move out on pop/clear.
عام نوع طابور_ذو_نهايتين<ق> = {
    العناصر: متجه اختياري ق,
    البداية: طبيعي,
    العدد: طبيعي
};

عرف ابن_خانات_طابور_ذو_نهايتين<ق>(السعة: طبيعي): متجه اختياري ق {
    دع الناتج: متغير متجه اختياري ق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سعة_نمو_طابور_ذو_نهايتين(الحالية: طبيعي, المطلوبة: طبيعي): طبيعي {
    دع السعة: متغير طبيعي = الحالية;
    إذا (السعة < 8) { السعة := 8; };
    دع الحد: طبيعي = ~((0 مثل طبيعي));
    طالما (السعة < المطلوبة) {
        // Do not wrap on the last doubling. An exact large capacity is valid.
        إذا (السعة > (الحد / 2)) { أرجع المطلوبة; };
        السعة := السعة * 2;
    }
    أرجع السعة;
}

// The logical offset is always smaller than capacity. Subtract before
// adding to avoid overflowing a physical ring index near the uint limit.
عرف موضع_حلقة_طابور_ذو_نهايتين(
    البداية: طبيعي,
    الإزاحة: طبيعي,
    السعة: طبيعي
): طبيعي {
    دع الباقي: طبيعي = السعة - البداية;
    إذا (الإزاحة >= الباقي) { أرجع الإزاحة - الباقي; };
    أرجع البداية + الإزاحة;
}

عام عرف أنشئ_طابور_ذو_نهايتين_بسعة<ق>(السعة: طبيعي): طابور_ذو_نهايتين<ق> {
    دع العناصر: متجه اختياري ق = ابن_خانات_طابور_ذو_نهايتين(السعة);
    دع الناتج: طابور_ذو_نهايتين<ق> = { العناصر: العناصر, البداية: 0, العدد: 0 };
    أرجع الناتج;
}

عام عرف أنشئ_طابور_ذو_نهايتين<ق>(): طابور_ذو_نهايتين<ق> {
    أرجع أنشئ_طابور_ذو_نهايتين_بسعة(0);
}

عام عرف سعة_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): طبيعي {
    أرجع الطول((*الطابور).العناصر) مثل طبيعي;
}

عام عرف طول_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): طبيعي {
    أرجع (*الطابور).العدد;
}

عام عرف طابور_ذو_نهايتين_فارغ<ق>(الطابور: &طابور_ذو_نهايتين<ق>): منطقي {
    أرجع (*الطابور).العدد == 0;
}

عرف أعد_ترتيب_سعة_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, السعة: طبيعي): فراغ {
    دع الجديدة: متغير متجه اختياري ق = ابن_خانات_طابور_ذو_نهايتين(السعة);
    دع القديمة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الطابور).العدد) {
        دع موضع_قديم: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, ف, القديمة);
        دع المنقول: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الطابور).العناصر[موضع_قديم], المنقول);
        بدّل(الجديدة[ف], المنقول);
        ف := ف + 1;
    }
    (*الطابور).العناصر := الجديدة;
    (*الطابور).البداية := 0;
}

// False indicates unsigned count overflow; no slots or elements are changed.
// Allocation failure remains the backing vector's responsibility.
عام عرف احجز_لطابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, إضافي: طبيعي): منطقي {
    دع الحد: طبيعي = ~((0 مثل طبيعي));
    إذا (إضافي > (الحد - (*الطابور).العدد)) { أرجع خطأ; };
    دع المطلوبة: طبيعي = (*الطابور).العدد + إضافي;
    دع الحالية: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    إذا (المطلوبة <= الحالية) { أرجع صواب; };
    دع الجديدة: طبيعي = سعة_نمو_طابور_ذو_نهايتين(الحالية, المطلوبة);
    أعد_ترتيب_سعة_طابور_ذو_نهايتين(الطابور, الجديدة);
    أرجع صواب;
}

// False means no insertion occurred because the requested count overflowed.
عام عرف أضف_خلف_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, القيمة: ق): منطقي {
    إذا (!احجز_لطابور_ذو_نهايتين(الطابور, 1)) { أرجع خطأ; };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع الموضع: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, (*الطابور).العدد, السعة);
    دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
    بدّل((*الطابور).العناصر[الموضع], الجديدة);
    (*الطابور).العدد := (*الطابور).العدد + 1;
    أرجع صواب;
}

// False means no insertion occurred because the requested count overflowed.
عام عرف أضف_أمام_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, القيمة: ق): منطقي {
    إذا (!احجز_لطابور_ذو_نهايتين(الطابور, 1)) { أرجع خطأ; };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    إذا ((*الطابور).العدد == 0) {
        (*الطابور).البداية := 0;
    } وإلا {
        (*الطابور).البداية := موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, السعة - 1, السعة);
    };
    دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
    دع موضع_البداية: طبيعي = (*الطابور).البداية;
    بدّل((*الطابور).العناصر[موضع_البداية], الجديدة);
    (*الطابور).العدد := (*الطابور).العدد + 1;
    أرجع صواب;
}

عام عرف خذ_من_أمام_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): اختياري ق {
    إذا ((*الطابور).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع الموضع: طبيعي = (*الطابور).البداية;
    دع الناتج: متغير اختياري ق = اختياري.لا_شيء();
    بدّل((*الطابور).العناصر[الموضع], الناتج);
    (*الطابور).العدد := (*الطابور).العدد - 1;
    إذا ((*الطابور).العدد == 0) { (*الطابور).البداية := 0; }
    وإلا { (*الطابور).البداية := موضع_حلقة_طابور_ذو_نهايتين(الموضع, 1, السعة); };
    أرجع الناتج;
}

عام عرف خذ_من_خلف_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): اختياري ق {
    إذا ((*الطابور).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع الموضع: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, (*الطابور).العدد - 1, السعة);
    دع الناتج: متغير اختياري ق = اختياري.لا_شيء();
    بدّل((*الطابور).العناصر[الموضع], الناتج);
    (*الطابور).العدد := (*الطابور).العدد - 1;
    إذا ((*الطابور).العدد == 0) { (*الطابور).البداية := 0; };
    أرجع الناتج;
}

عام عرف أمام_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): اختياري ق {
    إذا ((*الطابور).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع موضع_البداية: طبيعي = (*الطابور).البداية;
    طابق (*الطابور).العناصر[موضع_البداية] مع
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف خلف_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): اختياري ق {
    إذا ((*الطابور).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع الموضع: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, (*الطابور).العدد - 1, السعة);
    طابق (*الطابور).العناصر[الموضع] مع
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف في_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>, الفهرس: طبيعي): اختياري ق {
    إذا (الفهرس >= (*الطابور).العدد) { أرجع اختياري.لا_شيء(); };
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع الموضع: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, الفهرس, السعة);
    طابق (*الطابور).العناصر[الموضع] مع
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف امسح_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): فراغ {
    دع السعة: طبيعي = الطول((*الطابور).العناصر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الطابور).العدد) {
        دع الموضع: طبيعي = موضع_حلقة_طابور_ذو_نهايتين((*الطابور).البداية, ف, السعة);
        دع المزال: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الطابور).العناصر[الموضع], المزال);
        ف := ف + 1;
    }
    (*الطابور).البداية := 0;
    (*الطابور).العدد := 0;
}

عام عرف أعد_ضبط_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): فراغ {
    دع الفارغة: متجه اختياري ق = [];
    (*الطابور).العناصر := الفارغة;
    (*الطابور).البداية := 0;
    (*الطابور).العدد := 0;
}

عام نوع deque<T> = طابور_ذو_نهايتين<T>;
عام مرادف new_deque = أنشئ_طابور_ذو_نهايتين;
عام مرادف new_deque_with_capacity = أنشئ_طابور_ذو_نهايتين_بسعة;
عام مرادف deque_reserve = احجز_لطابور_ذو_نهايتين;
عام مرادف deque_push_back = أضف_خلف_طابور_ذو_نهايتين;
عام مرادف deque_push_front = أضف_أمام_طابور_ذو_نهايتين;
عام مرادف deque_pop_front = خذ_من_أمام_طابور_ذو_نهايتين;
عام مرادف deque_pop_back = خذ_من_خلف_طابور_ذو_نهايتين;
عام مرادف deque_front = أمام_طابور_ذو_نهايتين;
عام مرادف deque_back = خلف_طابور_ذو_نهايتين;
عام مرادف deque_get = في_طابور_ذو_نهايتين;
عام مرادف deque_length = طول_طابور_ذو_نهايتين;
عام مرادف deque_capacity = سعة_طابور_ذو_نهايتين;
عام مرادف deque_is_empty = طابور_ذو_نهايتين_فارغ;
عام مرادف deque_clear = امسح_طابور_ذو_نهايتين;
عام مرادف deque_reset = أعد_ضبط_طابور_ذو_نهايتين;
