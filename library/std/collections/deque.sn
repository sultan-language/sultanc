// Generic double-ended queue backed by a growable ring buffer. Optional slots
// provide explicit empty storage so owning values can move out on pop/clear.
عام نوع طابور_ذو_نهايتين<ق> = {
    العناصر: متجه اختيار ق,
    البداية: غير_موقع,
    العدد: غير_موقع
};

عرف ابن_خانات_طابور_ذو_نهايتين<ق>(السعة: غير_موقع): متجه اختيار ق {
    دع الناتج: متغير متجه اختيار ق = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سعة_نمو_طابور_ذو_نهايتين(الحالية: غير_موقع, المطلوبة: غير_موقع): غير_موقع {
    دع السعة: متغير غير_موقع = الحالية;
    لو (السعة < 8) { السعة := 8; };
    بينما (السعة < المطلوبة) { السعة := السعة * 2; }
    أرجع السعة;
}

عام عرف أنشئ_طابور_ذو_نهايتين_بسعة<ق>(السعة: غير_موقع): طابور_ذو_نهايتين<ق> {
    دع العناصر: متجه اختيار ق = ابن_خانات_طابور_ذو_نهايتين(السعة);
    دع الناتج: طابور_ذو_نهايتين<ق> = { العناصر: العناصر, البداية: 0, العدد: 0 };
    أرجع الناتج;
}

عام عرف أنشئ_طابور_ذو_نهايتين<ق>(): طابور_ذو_نهايتين<ق> {
    أرجع أنشئ_طابور_ذو_نهايتين_بسعة(0);
}

عام عرف سعة_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): غير_موقع {
    أرجع الطول((*الطابور).العناصر) مثل غير_موقع;
}

عام عرف طول_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): غير_موقع {
    أرجع (*الطابور).العدد;
}

عام عرف طابور_ذو_نهايتين_فارغ<ق>(الطابور: &طابور_ذو_نهايتين<ق>): منطقي {
    أرجع (*الطابور).العدد == 0;
}

عرف أعد_ترتيب_سعة_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, السعة: غير_موقع): فراغ {
    دع الجديدة: متغير متجه اختيار ق = ابن_خانات_طابور_ذو_نهايتين(السعة);
    دع القديمة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الطابور).العدد) {
        دع موضع_قديم: غير_موقع = ((*الطابور).البداية + ف) % القديمة;
        دع المنقول: متغير اختيار ق = اختيار.لا_شيء();
        بدّل((*الطابور).العناصر[موضع_قديم], المنقول);
        بدّل(الجديدة[ف], المنقول);
        ف := ف + 1;
    }
    (*الطابور).العناصر := الجديدة;
    (*الطابور).البداية := 0;
}

عام عرف احجز_لطابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, إضافي: غير_موقع): فراغ {
    دع المطلوبة: غير_موقع = (*الطابور).العدد + إضافي;
    دع الحالية: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    لو (المطلوبة <= الحالية) { أرجع; };
    دع الجديدة: غير_موقع = سعة_نمو_طابور_ذو_نهايتين(الحالية, المطلوبة);
    أعد_ترتيب_سعة_طابور_ذو_نهايتين(الطابور, الجديدة);
}

عام عرف أضف_خلف_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, القيمة: ق): فراغ {
    احجز_لطابور_ذو_نهايتين(الطابور, 1);
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع الموضع: غير_موقع = ((*الطابور).البداية + (*الطابور).العدد) % السعة;
    دع الجديدة: متغير اختيار ق = اختيار.بعض(القيمة);
    بدّل((*الطابور).العناصر[الموضع], الجديدة);
    (*الطابور).العدد := (*الطابور).العدد + 1;
}

عام عرف أضف_أمام_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>, القيمة: ق): فراغ {
    احجز_لطابور_ذو_نهايتين(الطابور, 1);
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    لو ((*الطابور).العدد == 0) {
        (*الطابور).البداية := 0;
    } وإلا {
        (*الطابور).البداية := ((*الطابور).البداية + السعة - 1) % السعة;
    };
    دع الجديدة: متغير اختيار ق = اختيار.بعض(القيمة);
    دع موضع_البداية: غير_موقع = (*الطابور).البداية;
    بدّل((*الطابور).العناصر[موضع_البداية], الجديدة);
    (*الطابور).العدد := (*الطابور).العدد + 1;
}

عام عرف خذ_من_أمام_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): اختيار ق {
    لو ((*الطابور).العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع الموضع: غير_موقع = (*الطابور).البداية;
    دع الناتج: متغير اختيار ق = اختيار.لا_شيء();
    بدّل((*الطابور).العناصر[الموضع], الناتج);
    (*الطابور).العدد := (*الطابور).العدد - 1;
    لو ((*الطابور).العدد == 0) { (*الطابور).البداية := 0; }
    وإلا { (*الطابور).البداية := (الموضع + 1) % السعة; };
    أرجع الناتج;
}

عام عرف خذ_من_خلف_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): اختيار ق {
    لو ((*الطابور).العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع الموضع: غير_موقع = ((*الطابور).البداية + (*الطابور).العدد - 1) % السعة;
    دع الناتج: متغير اختيار ق = اختيار.لا_شيء();
    بدّل((*الطابور).العناصر[الموضع], الناتج);
    (*الطابور).العدد := (*الطابور).العدد - 1;
    لو ((*الطابور).العدد == 0) { (*الطابور).البداية := 0; };
    أرجع الناتج;
}

عام عرف أمام_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): اختيار ق {
    لو ((*الطابور).العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع موضع_البداية: غير_موقع = (*الطابور).البداية;
    طابق (*الطابور).العناصر[موضع_البداية] مع
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف خلف_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>): اختيار ق {
    لو ((*الطابور).العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع الموضع: غير_موقع = ((*الطابور).البداية + (*الطابور).العدد - 1) % السعة;
    طابق (*الطابور).العناصر[الموضع] مع
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف في_طابور_ذو_نهايتين<ق>(الطابور: &طابور_ذو_نهايتين<ق>, الفهرس: غير_موقع): اختيار ق {
    لو (الفهرس >= (*الطابور).العدد) { أرجع اختيار.لا_شيء(); };
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع الموضع: غير_موقع = ((*الطابور).البداية + الفهرس) % السعة;
    طابق (*الطابور).العناصر[الموضع] مع
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف امسح_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): فراغ {
    دع السعة: غير_موقع = الطول((*الطابور).العناصر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الطابور).العدد) {
        دع الموضع: غير_موقع = ((*الطابور).البداية + ف) % السعة;
        دع المزال: متغير اختيار ق = اختيار.لا_شيء();
        بدّل((*الطابور).العناصر[الموضع], المزال);
        ف := ف + 1;
    }
    (*الطابور).البداية := 0;
    (*الطابور).العدد := 0;
}

عام عرف أعد_ضبط_طابور_ذو_نهايتين<ق>(الطابور: &متغير طابور_ذو_نهايتين<ق>): فراغ {
    دع الفارغة: متجه اختيار ق = [];
    (*الطابور).العناصر := الفارغة;
    (*الطابور).البداية := 0;
    (*الطابور).العدد := 0;
}

عام نوع deque<T> = طابور_ذو_نهايتين<T>;
عام مرادف new_deque = أنشئ_طابور_ذو_نهايتين;
عام مرادف new_deque_with_capacity = أنشئ_طابور_ذو_نهايتين_بسعة;
عام مرادف deque_reserve = احجز_لطابور_ذو_نهايتين;
عام مرادف deque_push_back = أضف_خلف_طابور_ذو_نهايتين;
عام مرادف deque_push_front = أضف_أمام_طابور_ذو_نهايتين;
عام مرادف deque_pop_front = خذ_من_أمام_طابور_ذو_نهايتين;
عام مرادف deque_pop_back = خذ_من_خلف_طابور_ذو_نهايتين;
عام مرادف deque_front = أمام_طابور_ذو_نهايتين;
عام مرادف deque_back = خلف_طابور_ذو_نهايتين;
عام مرادف deque_get = في_طابور_ذو_نهايتين;
عام مرادف deque_length = طول_طابور_ذو_نهايتين;
عام مرادف deque_capacity = سعة_طابور_ذو_نهايتين;
عام مرادف deque_is_empty = طابور_ذو_نهايتين_فارغ;
عام مرادف deque_clear = امسح_طابور_ذو_نهايتين;
عام مرادف deque_reset = أعد_ضبط_طابور_ذو_نهايتين;
