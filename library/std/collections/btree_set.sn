استورد collections.btree_map;

// Ordered set implemented by the canonical B-tree map so ordering, balancing,
// node reuse, and ownership behavior have one implementation.
عام نوع مجموعة_شجرة_بي<ق> = {
    الخريطة: خريطة_شجرة_بي<ق, منطقي>
};

عام عرف أنشئ_مجموعة_شجرة_بي<ق>(المقارنة: دالة(&ق, &ق): عدد): مجموعة_شجرة_بي<ق> {
    دع الخريطة: خريطة_شجرة_بي<ق, منطقي> = أنشئ_خريطة_شجرة_بي(المقارنة);
    دع الناتج: مجموعة_شجرة_بي<ق> = { الخريطة: الخريطة };
    أرجع الناتج;
}

عام عرف أضف_إلى_مجموعة_شجرة_بي<ق>(المجموعة: &متغير مجموعة_شجرة_بي<ق>, القيمة: ق): منطقي {
    طابق أدرج_في_خريطة_شجرة_بي(&متغير (*المجموعة).الخريطة, القيمة, صواب) مع
    | اختيار.لا_شيء -> { أرجع صواب; }
    | اختيار.بعض(_) -> { أرجع خطأ; };
}

عام عرف تحتوي_مجموعة_شجرة_بي<ق>(المجموعة: &مجموعة_شجرة_بي<ق>, القيمة: &ق): منطقي {
    أرجع تحتوي_خريطة_شجرة_بي(&(*المجموعة).الخريطة, القيمة);
}

عام عرف احذف_من_مجموعة_شجرة_بي<ق>(المجموعة: &متغير مجموعة_شجرة_بي<ق>, القيمة: &ق): منطقي {
    طابق احذف_من_خريطة_شجرة_بي(&متغير (*المجموعة).الخريطة, القيمة) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(_) -> { أرجع صواب; };
}

عام عرف طول_مجموعة_شجرة_بي<ق>(المجموعة: &مجموعة_شجرة_بي<ق>): غير_موقع {
    أرجع طول_خريطة_شجرة_بي(&(*المجموعة).الخريطة);
}

عام عرف مجموعة_شجرة_بي_فارغة<ق>(المجموعة: &مجموعة_شجرة_بي<ق>): منطقي {
    أرجع خريطة_شجرة_بي_فارغة(&(*المجموعة).الخريطة);
}

عام عرف قيم_مجموعة_شجرة_بي<ق>(المجموعة: &مجموعة_شجرة_بي<ق>): متجه ق {
    دع المداخل: متجه مدخل_خريطة_شجرة_بي<ق, منطقي> = مداخل_خريطة_شجرة_بي(&(*المجموعة).الخريطة);
    دع الناتج: متغير متجه ق = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
        دع مرجع_القيمة: &ق = &المداخل[ف].المفتاح;
        دع القيمة: ق = *مرجع_القيمة;
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف امسح_مجموعة_شجرة_بي<ق>(المجموعة: &متغير مجموعة_شجرة_بي<ق>): فراغ {
    امسح_خريطة_شجرة_بي(&متغير (*المجموعة).الخريطة);
}

عام عرف أعد_ضبط_مجموعة_شجرة_بي<ق>(المجموعة: &متغير مجموعة_شجرة_بي<ق>): فراغ {
    أعد_ضبط_خريطة_شجرة_بي(&متغير (*المجموعة).الخريطة);
}

// English language surface.
عام نوع btree_set<T> = مجموعة_شجرة_بي<T>;
عام مرادف new_btree_set = أنشئ_مجموعة_شجرة_بي;
عام مرادف btree_set_insert = أضف_إلى_مجموعة_شجرة_بي;
عام مرادف btree_set_contains = تحتوي_مجموعة_شجرة_بي;
عام مرادف btree_set_remove = احذف_من_مجموعة_شجرة_بي;
عام مرادف btree_set_length = طول_مجموعة_شجرة_بي;
عام مرادف btree_set_is_empty = مجموعة_شجرة_بي_فارغة;
عام مرادف btree_set_values = قيم_مجموعة_شجرة_بي;
عام مرادف btree_set_clear = امسح_مجموعة_شجرة_بي;
عام مرادف btree_set_reset = أعد_ضبط_مجموعة_شجرة_بي;
