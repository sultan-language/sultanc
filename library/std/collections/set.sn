استورد collections.map;

عام نوع مجموعة<T> = { الخريطة: الخريطة<T, منطقي> };

عام عرف أنشئ_مجموعة<T>(الهاش: دالة(&T): طبيعي, التساوي: دالة(&T, &T): منطقي): مجموعة<T> {
    دع الخريطة: الخريطة<T, منطقي> = أنشئ_الخريطة(الهاش, التساوي);
    دع الناتج: مجموعة<T> = { الخريطة: الخريطة };
    أرجع الناتج;
}

// نجح(صواب) adds a new element; نجح(خطأ) means it was already present.
// Capacity failure is distinct from both outcomes and leaves the set unchanged.
عام عرف أضف_إلى_مجموعة<T>(
    المجموعة: &متغير مجموعة<T>,
    القيمة: T
): نتيجة منطقي, خطأ_إدراج_الخريطة {
    طابق أدرج_في_الخريطة(&متغير (*المجموعة).الخريطة, القيمة, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع نتيجة.نجح(صواب); }
    | نتيجة.نجح(اختياري.موجود(_)) -> { أرجع نتيجة.نجح(خطأ); };
}

عام عرف تحتوي_مجموعة<T>(المجموعة: &مجموعة<T>, القيمة: &T): منطقي {
    أرجع تحتوي_الخريطة(&(*المجموعة).الخريطة, القيمة);
}

عام عرف احذف_من_مجموعة<T>(المجموعة: &متغير مجموعة<T>, القيمة: &T): منطقي {
    طابق احذف_من_الخريطة(&متغير (*المجموعة).الخريطة, القيمة) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(_) -> { أرجع صواب; };
}

عام عرف طول_مجموعة<T>(المجموعة: &مجموعة<T>): طبيعي {
    أرجع طول_الخريطة(&(*المجموعة).الخريطة);
}

عام عرف امسح_مجموعة<T>(المجموعة: &متغير مجموعة<T>): فراغ {
    امسح_الخريطة(&متغير (*المجموعة).الخريطة);
}

// The canonical map materializes live keys without an intermediate entry copy.
عام عرف قيم_مجموعة<T>(المجموعة: &مجموعة<T>): متجه T {
    أرجع مفاتيح_الخريطة(&(*المجموعة).الخريطة);
}

عام نوع set<T> = مجموعة<T>;
عام مرادف new_set = أنشئ_مجموعة;
عام مرادف set_insert = أضف_إلى_مجموعة;
عام مرادف set_contains = تحتوي_مجموعة;
عام مرادف set_remove = احذف_من_مجموعة;
عام مرادف set_length = طول_مجموعة;
عام مرادف set_clear = امسح_مجموعة;
عام مرادف set_values = قيم_مجموعة;
