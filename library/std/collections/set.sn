استورد collections.map;

عام نوع مجموعة<T> = { الخريطة: خريطة<T, منطقي> };

عام عرف أنشئ_مجموعة<T>(الهاش: دالة(&T): غير_موقع, التساوي: دالة(&T, &T): منطقي): مجموعة<T> {
    دع الخريطة: خريطة<T, منطقي> = أنشئ_خريطة(الهاش, التساوي);
    دع الناتج: مجموعة<T> = { الخريطة: الخريطة };
    أرجع الناتج;
}

عام عرف أضف_إلى_مجموعة<T>(المجموعة: &متغير مجموعة<T>, القيمة: T): منطقي {
    دع الحالة: متغير مجموعة<T> = *المجموعة;
    طابق أدرج_في_خريطة(&متغير الحالة.الخريطة, القيمة, صواب) مع
    | اختيار.لا_شيء -> { *المجموعة := الحالة; أرجع صواب; }
    | اختيار.بعض(_) -> { *المجموعة := الحالة; أرجع خطأ; };
}

عام عرف تحتوي_مجموعة<T>(المجموعة: &مجموعة<T>, القيمة: &T): منطقي {
    دع الحالة: مجموعة<T> = *المجموعة;
    أرجع تحتوي_خريطة(&الحالة.الخريطة, القيمة);
}

عام عرف احذف_من_مجموعة<T>(المجموعة: &متغير مجموعة<T>, القيمة: &T): منطقي {
    دع الحالة: متغير مجموعة<T> = *المجموعة;
    طابق احذف_من_خريطة(&متغير الحالة.الخريطة, القيمة) مع
    | اختيار.لا_شيء -> { *المجموعة := الحالة; أرجع خطأ; }
    | اختيار.بعض(_) -> { *المجموعة := الحالة; أرجع صواب; };
}

عام عرف طول_مجموعة<T>(المجموعة: &مجموعة<T>): غير_موقع {
    دع الحالة: مجموعة<T> = *المجموعة;
    أرجع طول_خريطة(&الحالة.الخريطة);
}

عام عرف امسح_مجموعة<T>(المجموعة: &متغير مجموعة<T>): فراغ {
    دع الحالة: متغير مجموعة<T> = *المجموعة;
    امسح_خريطة(&متغير الحالة.الخريطة);
    *المجموعة := الحالة;
}

عام عرف قيم_مجموعة<T>(المجموعة: &مجموعة<T>): متجه T {
    دع الحالة: مجموعة<T> = *المجموعة;
    دع المداخل: متجه مدخل_خريطة<T, منطقي> = مداخل_خريطة(&الحالة.الخريطة);
    دع الناتج: متغير متجه T = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
        دع مرجع_المدخل: &مدخل_خريطة<T, منطقي> = &المداخل[ف];
        دع المدخل: مدخل_خريطة<T, منطقي> = *مرجع_المدخل;
        دع مرجع_القيمة: &T = &المدخل.المفتاح;
        دع القيمة: T = *مرجع_القيمة;
        ألحق(الناتج, القيمة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام نوع set<T> = مجموعة<T>;
عام مرادف new_set = أنشئ_مجموعة;
عام مرادف set_insert = أضف_إلى_مجموعة;
عام مرادف set_contains = تحتوي_مجموعة;
عام مرادف set_remove = احذف_من_مجموعة;
عام مرادف set_length = طول_مجموعة;
عام مرادف set_clear = امسح_مجموعة;
عام مرادف set_values = قيم_مجموعة;
