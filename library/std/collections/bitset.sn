// Dense dynamic bit set backed by machine-independent 64-bit words.
عام نوع مجموعة_بتات = {
    الكلمات: متجه غ64,
    عدد_البتات: غير_موقع,
    عدد_المضبوطة: غير_موقع
};

عرف عدد_كلمات_البتات(عدد_البتات: غير_موقع): غير_موقع {
    لو (عدد_البتات == 0) { أرجع 0; };
    أرجع ((عدد_البتات - 1) / 64) + 1;
}

عرف أنشئ_كلمات_بتات(العدد: غير_موقع): متجه غ64 {
    دع الناتج: متغير متجه غ64 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) { ألحق(الناتج, 0 مثل غ64); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف أنشئ_مجموعة_بتات(عدد_البتات: غير_موقع): مجموعة_بتات {
    دع الكلمات: متجه غ64 = أنشئ_كلمات_بتات(عدد_كلمات_البتات(عدد_البتات));
    دع الناتج: مجموعة_بتات = { الكلمات: الكلمات, عدد_البتات: عدد_البتات, عدد_المضبوطة: 0 };
    أرجع الناتج;
}

عام عرف طول_مجموعة_البتات(المجموعة: &مجموعة_بتات): غير_موقع { أرجع (*المجموعة).عدد_البتات; }
عام عرف عدد_عناصر_مجموعة_البتات(المجموعة: &مجموعة_بتات): غير_موقع { أرجع (*المجموعة).عدد_المضبوطة; }
عام عرف مجموعة_البتات_فارغة(المجموعة: &مجموعة_بتات): منطقي { أرجع (*المجموعة).عدد_المضبوطة == 0; }

عام عرف تحتوي_مجموعة_البتات(المجموعة: &مجموعة_بتات, الموضع: غير_موقع): منطقي {
    لو (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: غير_موقع = الموضع / 64;
    دع فهرس_البت: غير_موقع = الموضع % 64;
    دع القناع: غ64 = (1 مثل غ64) << (فهرس_البت مثل غ8);
    أرجع (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) != 0);
}

عام عرف أضف_إلى_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, الموضع: غير_موقع): منطقي {
    لو (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: غير_موقع = الموضع / 64;
    دع فهرس_البت: غير_موقع = الموضع % 64;
    دع القناع: غ64 = (1 مثل غ64) << (فهرس_البت مثل غ8);
    لو (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) != 0) { أرجع خطأ; };
    (*المجموعة).الكلمات[فهرس_الكلمة] := (*المجموعة).الكلمات[فهرس_الكلمة] | القناع;
    (*المجموعة).عدد_المضبوطة := (*المجموعة).عدد_المضبوطة + 1;
    أرجع صواب;
}

عام عرف احذف_من_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, الموضع: غير_موقع): منطقي {
    لو (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: غير_موقع = الموضع / 64;
    دع فهرس_البت: غير_موقع = الموضع % 64;
    دع القناع: غ64 = (1 مثل غ64) << (فهرس_البت مثل غ8);
    لو (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) == 0) { أرجع خطأ; };
    (*المجموعة).الكلمات[فهرس_الكلمة] := (*المجموعة).الكلمات[فهرس_الكلمة] & (~القناع);
    (*المجموعة).عدد_المضبوطة := (*المجموعة).عدد_المضبوطة - 1;
    أرجع صواب;
}

عام عرف عين_البت(المجموعة: &متغير مجموعة_بتات, الموضع: غير_موقع, القيمة: منطقي): منطقي {
    لو (القيمة) { أرجع أضف_إلى_مجموعة_البتات(المجموعة, الموضع); };
    أرجع احذف_من_مجموعة_البتات(المجموعة, الموضع);
}

عام عرف امسح_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*المجموعة).الكلمات) مثل غير_موقع)) { (*المجموعة).الكلمات[ف] := 0; ف := ف + 1; }
    (*المجموعة).عدد_المضبوطة := 0;
}

عام عرف غير_حجم_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, العدد_الجديد: غير_موقع): فراغ {
    دع الكلمات_الجديدة: غير_موقع = عدد_كلمات_البتات(العدد_الجديد);
    دع الكلمات_الحالية: غير_موقع = الطول((*المجموعة).الكلمات) مثل غير_موقع;
    لو (الكلمات_الجديدة > الكلمات_الحالية) {
        دع ف: متغير غير_موقع = الكلمات_الحالية;
        بينما (ف < الكلمات_الجديدة) { ألحق((*المجموعة).الكلمات, 0); ف := ف + 1; }
    } وإلا لو (الكلمات_الجديدة < الكلمات_الحالية) {
        دع الجديدة: متغير متجه غ64 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الكلمات_الجديدة) { ألحق(الجديدة, (*المجموعة).الكلمات[ف]); ف := ف + 1; }
        (*المجموعة).الكلمات := الجديدة;
    };
    (*المجموعة).عدد_البتات := العدد_الجديد;
    لو ((الكلمات_الجديدة > 0) && ((العدد_الجديد % 64) != 0)) {
        دع البتات_المستخدمة: غير_موقع = العدد_الجديد % 64;
        دع القناع: غ64 = ((1 مثل غ64) << (البتات_المستخدمة مثل غ8)) - 1;
        دع موضع_الكلمة_الأخيرة: غير_موقع = الكلمات_الجديدة - 1;
        (*المجموعة).الكلمات[موضع_الكلمة_الأخيرة] := (*المجموعة).الكلمات[موضع_الكلمة_الأخيرة] & القناع;
    };
    // Recount only on resize; ordinary set/clear operations stay O(1).
    دع العدد: متغير غير_موقع = 0;
    دع ك: متغير غير_موقع = 0;
    بينما (ك < الكلمات_الجديدة) {
        دع كلمة: متغير غ64 = (*المجموعة).الكلمات[ك];
        بينما (كلمة != 0) { العدد := العدد + 1; كلمة := كلمة & (كلمة - 1); }
        ك := ك + 1;
    }
    (*المجموعة).عدد_المضبوطة := العدد;
}

عام عرف اتحد_مع_مجموعة_بتات(الوجهة: &متغير مجموعة_بتات, المصدر: &مجموعة_بتات): منطقي {
    لو ((*الوجهة).عدد_البتات != (*المصدر).عدد_البتات) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الوجهة).الكلمات) مثل غير_موقع)) {
        (*الوجهة).الكلمات[ف] := (*الوجهة).الكلمات[ف] | (*المصدر).الكلمات[ف];
        ف := ف + 1;
    }
    دع الحجم: غير_موقع = (*الوجهة).عدد_البتات;
    (*الوجهة).عدد_المضبوطة := 0;
    ف := 0;
    بينما (ف < الحجم) { لو (تحتوي_مجموعة_البتات(الوجهة, ف)) { (*الوجهة).عدد_المضبوطة := (*الوجهة).عدد_المضبوطة + 1; }; ف := ف + 1; }
    أرجع صواب;
}

عام عرف تقاطع_مع_مجموعة_بتات(الوجهة: &متغير مجموعة_بتات, المصدر: &مجموعة_بتات): منطقي {
    لو ((*الوجهة).عدد_البتات != (*المصدر).عدد_البتات) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الوجهة).الكلمات) مثل غير_موقع)) {
        (*الوجهة).الكلمات[ف] := (*الوجهة).الكلمات[ف] & (*المصدر).الكلمات[ف];
        ف := ف + 1;
    }
    دع الحجم: غير_موقع = (*الوجهة).عدد_البتات;
    (*الوجهة).عدد_المضبوطة := 0;
    ف := 0;
    بينما (ف < الحجم) { لو (تحتوي_مجموعة_البتات(الوجهة, ف)) { (*الوجهة).عدد_المضبوطة := (*الوجهة).عدد_المضبوطة + 1; }; ف := ف + 1; }
    أرجع صواب;
}

عام نوع bit_set = مجموعة_بتات;
عام مرادف new_bit_set = أنشئ_مجموعة_بتات;
عام مرادف bit_set_length = طول_مجموعة_البتات;
عام مرادف bit_set_count = عدد_عناصر_مجموعة_البتات;
عام مرادف bit_set_is_empty = مجموعة_البتات_فارغة;
عام مرادف bit_set_contains = تحتوي_مجموعة_البتات;
عام مرادف bit_set_insert = أضف_إلى_مجموعة_البتات;
عام مرادف bit_set_remove = احذف_من_مجموعة_البتات;
عام مرادف bit_set_set = عين_البت;
عام مرادف bit_set_clear = امسح_مجموعة_البتات;
عام مرادف bit_set_resize = غير_حجم_مجموعة_البتات;
عام مرادف bit_set_union_with = اتحد_مع_مجموعة_بتات;
عام مرادف bit_set_intersect_with = تقاطع_مع_مجموعة_بتات;
