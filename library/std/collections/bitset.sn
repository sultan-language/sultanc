استورد math.integer;

// Dense dynamic bit set backed by machine-independent 64-bit words.
عام نوع مجموعة_بتات = {
    الكلمات: متجه ط64,
    عدد_البتات: طبيعي,
    عدد_المضبوطة: طبيعي
};

عرف عدد_كلمات_البتات(عدد_البتات: طبيعي): طبيعي {
    إذا (عدد_البتات == 0) { أرجع 0; };
    أرجع ((عدد_البتات - 1) / 64) + 1;
}

عرف أنشئ_كلمات_بتات(العدد: طبيعي): متجه ط64 {
    دع الناتج: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, 0 مثل ط64); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف أنشئ_مجموعة_بتات(عدد_البتات: طبيعي): مجموعة_بتات {
    دع الكلمات: متجه ط64 = أنشئ_كلمات_بتات(عدد_كلمات_البتات(عدد_البتات));
    دع الناتج: مجموعة_بتات = { الكلمات: الكلمات, عدد_البتات: عدد_البتات, عدد_المضبوطة: 0 };
    أرجع الناتج;
}

عام عرف طول_مجموعة_البتات(المجموعة: &مجموعة_بتات): طبيعي { أرجع (*المجموعة).عدد_البتات; }
عام عرف عدد_عناصر_مجموعة_البتات(المجموعة: &مجموعة_بتات): طبيعي { أرجع (*المجموعة).عدد_المضبوطة; }
عام عرف مجموعة_البتات_فارغة(المجموعة: &مجموعة_بتات): منطقي { أرجع (*المجموعة).عدد_المضبوطة == 0; }

عام عرف تحتوي_مجموعة_البتات(المجموعة: &مجموعة_بتات, الموضع: طبيعي): منطقي {
    إذا (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: طبيعي = الموضع / 64;
    دع فهرس_البت: طبيعي = الموضع % 64;
    دع القناع: ط64 = (1 مثل ط64) << (فهرس_البت مثل ط8);
    أرجع (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) != 0);
}

عام عرف أضف_إلى_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, الموضع: طبيعي): منطقي {
    إذا (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: طبيعي = الموضع / 64;
    دع فهرس_البت: طبيعي = الموضع % 64;
    دع القناع: ط64 = (1 مثل ط64) << (فهرس_البت مثل ط8);
    إذا (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) != 0) { أرجع خطأ; };
    (*المجموعة).الكلمات[فهرس_الكلمة] := (*المجموعة).الكلمات[فهرس_الكلمة] | القناع;
    (*المجموعة).عدد_المضبوطة := (*المجموعة).عدد_المضبوطة + 1;
    أرجع صواب;
}

عام عرف احذف_من_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, الموضع: طبيعي): منطقي {
    إذا (الموضع >= (*المجموعة).عدد_البتات) { أرجع خطأ; };
    دع فهرس_الكلمة: طبيعي = الموضع / 64;
    دع فهرس_البت: طبيعي = الموضع % 64;
    دع القناع: ط64 = (1 مثل ط64) << (فهرس_البت مثل ط8);
    إذا (((*المجموعة).الكلمات[فهرس_الكلمة] & القناع) == 0) { أرجع خطأ; };
    (*المجموعة).الكلمات[فهرس_الكلمة] := (*المجموعة).الكلمات[فهرس_الكلمة] & (~القناع);
    (*المجموعة).عدد_المضبوطة := (*المجموعة).عدد_المضبوطة - 1;
    أرجع صواب;
}

عام عرف عين_البت(المجموعة: &متغير مجموعة_بتات, الموضع: طبيعي, القيمة: منطقي): منطقي {
    إذا (القيمة) { أرجع أضف_إلى_مجموعة_البتات(المجموعة, الموضع); };
    أرجع احذف_من_مجموعة_البتات(المجموعة, الموضع);
}

عام عرف امسح_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعة).الكلمات) مثل طبيعي)) { (*المجموعة).الكلمات[ف] := 0; ف := ف + 1; }
    (*المجموعة).عدد_المضبوطة := 0;
}

عام عرف غير_حجم_مجموعة_البتات(المجموعة: &متغير مجموعة_بتات, العدد_الجديد: طبيعي): فراغ {
    دع الكلمات_الجديدة: طبيعي = عدد_كلمات_البتات(العدد_الجديد);
    دع الكلمات_الحالية: طبيعي = الطول((*المجموعة).الكلمات) مثل طبيعي;
    إذا (الكلمات_الجديدة > الكلمات_الحالية) {
        دع ف: متغير طبيعي = الكلمات_الحالية;
        طالما (ف < الكلمات_الجديدة) { ألحق((*المجموعة).الكلمات, 0); ف := ف + 1; }
    } وإلا إذا (الكلمات_الجديدة < الكلمات_الحالية) {
        دع الجديدة: متغير متجه ط64 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < الكلمات_الجديدة) { ألحق(الجديدة, (*المجموعة).الكلمات[ف]); ف := ف + 1; }
        (*المجموعة).الكلمات := الجديدة;
    };
    (*المجموعة).عدد_البتات := العدد_الجديد;
    إذا ((الكلمات_الجديدة > 0) && ((العدد_الجديد % 64) != 0)) {
        دع البتات_المستخدمة: طبيعي = العدد_الجديد % 64;
        دع القناع: ط64 = ((1 مثل ط64) << (البتات_المستخدمة مثل ط8)) - 1;
        دع موضع_الكلمة_الأخيرة: طبيعي = الكلمات_الجديدة - 1;
        (*المجموعة).الكلمات[موضع_الكلمة_الأخيرة] := (*المجموعة).الكلمات[موضع_الكلمة_الأخيرة] & القناع;
    };
    // Recount in O(words), including the masked last word after shrinking.
    دع العدد: متغير طبيعي = 0;
    دع ك: متغير طبيعي = 0;
    طالما (ك < الكلمات_الجديدة) {
        العدد := العدد + عدد_بتات_واحد((*المجموعة).الكلمات[ك] مثل طبيعي);
        ك := ك + 1;
    }
    (*المجموعة).عدد_المضبوطة := العدد;
}

عام عرف اتحد_مع_مجموعة_بتات(الوجهة: &متغير مجموعة_بتات, المصدر: &مجموعة_بتات): منطقي {
    إذا ((*الوجهة).عدد_البتات != (*المصدر).عدد_البتات) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوجهة).الكلمات) مثل طبيعي)) {
        (*الوجهة).الكلمات[ف] := (*الوجهة).الكلمات[ف] | (*المصدر).الكلمات[ف];
        ف := ف + 1;
    }
    دع المضبوطة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول((*الوجهة).الكلمات) مثل طبيعي)) {
        المضبوطة := المضبوطة + عدد_بتات_واحد((*الوجهة).الكلمات[ف] مثل طبيعي);
        ف := ف + 1;
    }
    (*الوجهة).عدد_المضبوطة := المضبوطة;
    أرجع صواب;
}

عام عرف تقاطع_مع_مجموعة_بتات(الوجهة: &متغير مجموعة_بتات, المصدر: &مجموعة_بتات): منطقي {
    إذا ((*الوجهة).عدد_البتات != (*المصدر).عدد_البتات) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الوجهة).الكلمات) مثل طبيعي)) {
        (*الوجهة).الكلمات[ف] := (*الوجهة).الكلمات[ف] & (*المصدر).الكلمات[ف];
        ف := ف + 1;
    }
    دع المضبوطة: متغير طبيعي = 0;
    ف := 0;
    طالما (ف < (الطول((*الوجهة).الكلمات) مثل طبيعي)) {
        المضبوطة := المضبوطة + عدد_بتات_واحد((*الوجهة).الكلمات[ف] مثل طبيعي);
        ف := ف + 1;
    }
    (*الوجهة).عدد_المضبوطة := المضبوطة;
    أرجع صواب;
}

عام نوع bit_set = مجموعة_بتات;
عام مرادف new_bit_set = أنشئ_مجموعة_بتات;
عام مرادف bit_set_length = طول_مجموعة_البتات;
عام مرادف bit_set_count = عدد_عناصر_مجموعة_البتات;
عام مرادف bit_set_is_empty = مجموعة_البتات_فارغة;
عام مرادف bit_set_contains = تحتوي_مجموعة_البتات;
عام مرادف bit_set_insert = أضف_إلى_مجموعة_البتات;
عام مرادف bit_set_remove = احذف_من_مجموعة_البتات;
عام مرادف bit_set_set = عين_البت;
عام مرادف bit_set_clear = امسح_مجموعة_البتات;
عام مرادف bit_set_resize = غير_حجم_مجموعة_البتات;
عام مرادف bit_set_union_with = اتحد_مع_مجموعة_بتات;
عام مرادف bit_set_intersect_with = تقاطع_مع_مجموعة_بتات;
