// Comparator-driven binary max-heap. A positive comparator result means the
// first value has higher priority than the second value.
عام نوع الكومة<ق> = {
    العناصر: متجه اختيار ق,
    العدد: غير_موقع,
    المقارنة: دالة(&ق, &ق): عدد
};

عرف سعة_نمو_الكومة(الحالية: غير_موقع, المطلوبة: غير_موقع): غير_موقع {
    دع السعة: متغير غير_موقع = الحالية;
    لو (السعة < 8) { السعة := 8; };
    بينما (السعة < المطلوبة) { السعة := السعة * 2; }
    أرجع السعة;
}

عرف ابن_خانات_الكومة<ق>(السعة: غير_موقع): متجه اختيار ق {
    دع الناتج: متغير متجه اختيار ق = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(الناتج, اختيار.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_الكومة_بسعة<ق>(السعة: غير_موقع, المقارنة: دالة(&ق, &ق): عدد): الكومة<ق> {
    دع العناصر: متجه اختيار ق = ابن_خانات_الكومة(السعة);
    دع الناتج: الكومة<ق> = { العناصر: العناصر, العدد: 0, المقارنة: المقارنة };
    أرجع الناتج;
}

عام عرف أنشئ_الكومة<ق>(المقارنة: دالة(&ق, &ق): عدد): الكومة<ق> {
    أرجع أنشئ_الكومة_بسعة(0, المقارنة);
}

عام عرف طول_الكومة<ق>(الكومة: &الكومة<ق>): غير_موقع {
    أرجع (*الكومة).العدد;
}

عام عرف سعة_الكومة<ق>(الكومة: &الكومة<ق>): غير_موقع {
    أرجع الطول((*الكومة).العناصر) مثل غير_موقع;
}

عام عرف الكومة_فارغة<ق>(الكومة: &الكومة<ق>): منطقي {
    أرجع (*الكومة).العدد == 0;
}

عام عرف احجز_للكومة<ق>(الكومة: &متغير الكومة<ق>, إضافي: غير_موقع): فراغ {
    دع المطلوبة: غير_موقع = (*الكومة).العدد + إضافي;
    دع الحالية: غير_موقع = الطول((*الكومة).العناصر) مثل غير_موقع;
    لو (المطلوبة <= الحالية) { أرجع; };
    دع الجديدة: غير_موقع = سعة_نمو_الكومة(الحالية, المطلوبة);
    دع ف: متغير غير_موقع = الحالية;
    بينما (ف < الجديدة) {
        ألحق((*الكومة).العناصر, اختيار.لا_شيء());
        ف := ف + 1;
    }
}

عرف عنصر_الكومة_أعلى<ق>(الكومة: &الكومة<ق>, الأول: غير_موقع, الثاني: غير_موقع): منطقي {
    دع المقارنة: دالة(&ق, &ق): عدد = (*الكومة).المقارنة;
    طابق (*الكومة).العناصر[الأول] مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(أ) -> {
        طابق (*الكومة).العناصر[الثاني] مع
        | اختيار.لا_شيء -> { أرجع صواب; }
        | اختيار.بعض(ب) -> { أرجع المقارنة(&أ, &ب) > 0; };
    };
}

عرف اصعد_في_الكومة<ق>(الكومة: &متغير الكومة<ق>, الموضع_الأولي: غير_موقع): فراغ {
    دع الموضع: متغير غير_موقع = الموضع_الأولي;
    بينما (الموضع > 0) {
        دع الأب: غير_موقع = (الموضع - 1) / 2;
        لو (!عنصر_الكومة_أعلى(الكومة, الموضع, الأب)) { أرجع; };
        بدّل((*الكومة).العناصر[الموضع], (*الكومة).العناصر[الأب]);
        الموضع := الأب;
    }
}

عرف انزل_في_الكومة<ق>(الكومة: &متغير الكومة<ق>, الموضع_الأولي: غير_موقع): فراغ {
    دع الموضع: متغير غير_موقع = الموضع_الأولي;
    بينما (صواب) {
        دع اليسار: غير_موقع = الموضع * 2 + 1;
        لو (اليسار >= (*الكومة).العدد) { أرجع; };
        دع الأفضل: متغير غير_موقع = اليسار;
        دع اليمين: غير_موقع = اليسار + 1;
        لو ((اليمين < (*الكومة).العدد) && عنصر_الكومة_أعلى(الكومة, اليمين, اليسار)) {
            الأفضل := اليمين;
        };
        لو (!عنصر_الكومة_أعلى(الكومة, الأفضل, الموضع)) { أرجع; };
        بدّل((*الكومة).العناصر[الموضع], (*الكومة).العناصر[الأفضل]);
        الموضع := الأفضل;
    }
}

عام عرف أضف_إلى_الكومة<ق>(الكومة: &متغير الكومة<ق>, القيمة: ق): فراغ {
    احجز_للكومة(الكومة, 1);
    دع الموضع: غير_موقع = (*الكومة).العدد;
    دع الجديدة: متغير اختيار ق = اختيار.بعض(القيمة);
    بدّل((*الكومة).العناصر[الموضع], الجديدة);
    (*الكومة).العدد := الموضع + 1;
    اصعد_في_الكومة(الكومة, الموضع);
}

عام عرف قمة_الكومة<ق>(الكومة: &الكومة<ق>): اختيار ق {
    لو ((*الكومة).العدد == 0) { أرجع اختيار.لا_شيء(); };
    طابق (*الكومة).العناصر[0] مع
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); }
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
}

عام عرف خذ_قمة_الكومة<ق>(الكومة: &متغير الكومة<ق>): اختيار ق {
    لو ((*الكومة).العدد == 0) { أرجع اختيار.لا_شيء(); };
    دع الأخير: غير_موقع = (*الكومة).العدد - 1;
    لو (الأخير > 0) {
        بدّل((*الكومة).العناصر[0], (*الكومة).العناصر[الأخير]);
    };
    دع الناتج: متغير اختيار ق = اختيار.لا_شيء();
    بدّل((*الكومة).العناصر[الأخير], الناتج);
    (*الكومة).العدد := الأخير;
    لو (الأخير > 0) { انزل_في_الكومة(الكومة, 0); };
    أرجع الناتج;
}

عام عرف امسح_الكومة<ق>(الكومة: &متغير الكومة<ق>): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الكومة).العدد) {
        دع المزال: متغير اختيار ق = اختيار.لا_شيء();
        بدّل((*الكومة).العناصر[ف], المزال);
        ف := ف + 1;
    }
    (*الكومة).العدد := 0;
}

عام عرف أعد_ضبط_الكومة<ق>(الكومة: &متغير الكومة<ق>): فراغ {
    دع الفارغة: متجه اختيار ق = [];
    (*الكومة).العناصر := الفارغة;
    (*الكومة).العدد := 0;
}

عام نوع heap<T> = الكومة<T>;
عام مرادف new_heap = أنشئ_الكومة;
عام مرادف new_heap_with_capacity = أنشئ_الكومة_بسعة;
عام مرادف heap_reserve = احجز_للكومة;
عام مرادف heap_push = أضف_إلى_الكومة;
عام مرادف heap_peek = قمة_الكومة;
عام مرادف heap_pop = خذ_قمة_الكومة;
عام مرادف heap_length = طول_الكومة;
عام مرادف heap_capacity = سعة_الكومة;
عام مرادف heap_is_empty = الكومة_فارغة;
عام مرادف heap_clear = امسح_الكومة;
عام مرادف heap_reset = أعد_ضبط_الكومة;
