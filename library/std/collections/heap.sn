// Comparator-driven binary max-heap. A positive comparator result means the
// first value has higher priority than the second value.
عام نوع الكومة<ق> = {
    العناصر: متجه اختياري ق,
    العدد: طبيعي,
    المقارنة: دالة(&ق, &ق): عدد
};

عرف سعة_نمو_الكومة(الحالية: طبيعي, المطلوبة: طبيعي): طبيعي {
    دع السعة: متغير طبيعي = الحالية;
    إذا (السعة < 8) { السعة := 8; };
    دع الحد: طبيعي = ~((0 مثل طبيعي));
    طالما (السعة < المطلوبة) {
        // Do not wrap on the last doubling. An exact large capacity is valid.
        إذا (السعة > (الحد / 2)) { أرجع المطلوبة; };
        السعة := السعة * 2;
    }
    أرجع السعة;
}

عرف ابن_خانات_الكومة<ق>(السعة: طبيعي): متجه اختياري ق {
    دع الناتج: متغير متجه اختياري ق = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_الكومة_بسعة<ق>(السعة: طبيعي, المقارنة: دالة(&ق, &ق): عدد): الكومة<ق> {
    دع العناصر: متجه اختياري ق = ابن_خانات_الكومة(السعة);
    دع الناتج: الكومة<ق> = { العناصر: العناصر, العدد: 0, المقارنة: المقارنة };
    أرجع الناتج;
}

عام عرف أنشئ_الكومة<ق>(المقارنة: دالة(&ق, &ق): عدد): الكومة<ق> {
    أرجع أنشئ_الكومة_بسعة(0, المقارنة);
}

عام عرف طول_الكومة<ق>(الكومة: &الكومة<ق>): طبيعي {
    أرجع (*الكومة).العدد;
}

عام عرف سعة_الكومة<ق>(الكومة: &الكومة<ق>): طبيعي {
    أرجع الطول((*الكومة).العناصر) مثل طبيعي;
}

عام عرف الكومة_فارغة<ق>(الكومة: &الكومة<ق>): منطقي {
    أرجع (*الكومة).العدد == 0;
}

// False indicates unsigned count overflow; no slots or elements are changed.
// Allocation failure remains the backing vector's responsibility.
عام عرف احجز_للكومة<ق>(الكومة: &متغير الكومة<ق>, إضافي: طبيعي): منطقي {
    دع الحد: طبيعي = ~((0 مثل طبيعي));
    إذا (إضافي > (الحد - (*الكومة).العدد)) { أرجع خطأ; };
    دع المطلوبة: طبيعي = (*الكومة).العدد + إضافي;
    دع الحالية: طبيعي = الطول((*الكومة).العناصر) مثل طبيعي;
    إذا (المطلوبة <= الحالية) { أرجع صواب; };
    دع الجديدة: طبيعي = سعة_نمو_الكومة(الحالية, المطلوبة);
    دع ف: متغير طبيعي = الحالية;
    طالما (ف < الجديدة) {
        ألحق((*الكومة).العناصر, اختياري.لا_شيء());
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف عنصر_الكومة_أعلى<ق>(الكومة: &الكومة<ق>, الأول: طبيعي, الثاني: طبيعي): منطقي {
    دع المقارنة: دالة(&ق, &ق): عدد = (*الكومة).المقارنة;
    طابق (*الكومة).العناصر[الأول] مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(أ) -> {
        طابق (*الكومة).العناصر[الثاني] مع
        | اختياري.لا_شيء -> { أرجع صواب; }
        | اختياري.موجود(ب) -> { أرجع المقارنة(&أ, &ب) > 0; };
    };
}

عرف اصعد_في_الكومة<ق>(الكومة: &متغير الكومة<ق>, الموضع_الأولي: طبيعي): فراغ {
    دع الموضع: متغير طبيعي = الموضع_الأولي;
    طالما (الموضع > 0) {
        دع الأب: طبيعي = (الموضع - 1) / 2;
        إذا (!عنصر_الكومة_أعلى(الكومة, الموضع, الأب)) { أرجع; };
        بدّل((*الكومة).العناصر[الموضع], (*الكومة).العناصر[الأب]);
        الموضع := الأب;
    }
}

عرف انزل_في_الكومة<ق>(الكومة: &متغير الكومة<ق>, الموضع_الأولي: طبيعي): فراغ {
    دع الموضع: متغير طبيعي = الموضع_الأولي;
    طالما (صواب) {
        // No child exists beyond this bound; avoid overflowing 2 * index + 1.
        إذا (الموضع >= ((*الكومة).العدد / 2)) { أرجع; };
        دع اليسار: طبيعي = الموضع * 2 + 1;
        دع الأفضل: متغير طبيعي = اليسار;
        دع اليمين: طبيعي = اليسار + 1;
        إذا ((اليمين < (*الكومة).العدد) && عنصر_الكومة_أعلى(الكومة, اليمين, اليسار)) {
            الأفضل := اليمين;
        };
        إذا (!عنصر_الكومة_أعلى(الكومة, الأفضل, الموضع)) { أرجع; };
        بدّل((*الكومة).العناصر[الموضع], (*الكومة).العناصر[الأفضل]);
        الموضع := الأفضل;
    }
}

// False means no insertion occurred because the requested count overflowed.
عام عرف أضف_إلى_الكومة<ق>(الكومة: &متغير الكومة<ق>, القيمة: ق): منطقي {
    إذا (!احجز_للكومة(الكومة, 1)) { أرجع خطأ; };
    دع الموضع: طبيعي = (*الكومة).العدد;
    دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
    بدّل((*الكومة).العناصر[الموضع], الجديدة);
    (*الكومة).العدد := الموضع + 1;
    اصعد_في_الكومة(الكومة, الموضع);
    أرجع صواب;
}

عام عرف قمة_الكومة<ق>(الكومة: &الكومة<ق>): اختياري ق {
    إذا ((*الكومة).العدد == 0) { أرجع اختياري.لا_شيء(); };
    طابق (*الكومة).العناصر[0] مع
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عام عرف خذ_قمة_الكومة<ق>(الكومة: &متغير الكومة<ق>): اختياري ق {
    إذا ((*الكومة).العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الأخير: طبيعي = (*الكومة).العدد - 1;
    إذا (الأخير > 0) {
        بدّل((*الكومة).العناصر[0], (*الكومة).العناصر[الأخير]);
    };
    دع الناتج: متغير اختياري ق = اختياري.لا_شيء();
    بدّل((*الكومة).العناصر[الأخير], الناتج);
    (*الكومة).العدد := الأخير;
    إذا (الأخير > 0) { انزل_في_الكومة(الكومة, 0); };
    أرجع الناتج;
}

عام عرف امسح_الكومة<ق>(الكومة: &متغير الكومة<ق>): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الكومة).العدد) {
        دع المزال: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الكومة).العناصر[ف], المزال);
        ف := ف + 1;
    }
    (*الكومة).العدد := 0;
}

عام عرف أعد_ضبط_الكومة<ق>(الكومة: &متغير الكومة<ق>): فراغ {
    دع الفارغة: متجه اختياري ق = [];
    (*الكومة).العناصر := الفارغة;
    (*الكومة).العدد := 0;
}

عام نوع heap<T> = الكومة<T>;
عام مرادف new_heap = أنشئ_الكومة;
عام مرادف new_heap_with_capacity = أنشئ_الكومة_بسعة;
عام مرادف heap_reserve = احجز_للكومة;
عام مرادف heap_push = أضف_إلى_الكومة;
عام مرادف heap_peek = قمة_الكومة;
عام مرادف heap_pop = خذ_قمة_الكومة;
عام مرادف heap_length = طول_الكومة;
عام مرادف heap_capacity = سعة_الكومة;
عام مرادف heap_is_empty = الكومة_فارغة;
عام مرادف heap_clear = امسح_الكومة;
عام مرادف heap_reset = أعد_ضبط_الكومة;
