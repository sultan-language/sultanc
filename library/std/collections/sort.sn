استورد text.compare;

// Comparator-driven in-place heap sort. A negative comparator result means
// the first value sorts before the second value. The implementation swaps
// vector slots directly so arbitrary generic values are not copied merely
// to reorder them. The comparator must define a consistent total order.
عام عرف رتب_بالمقارنة<ق>(القيم: &متغير متجه ق, المقارنة: دالة(&ق, &ق): عدد): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    لو (العدد < 2) { أرجع; };

    دع البداية: متغير طبيعي = العدد / 2;
    طالما (البداية > 0) {
        البداية := البداية - 1;
        دع الجذر: متغير طبيعي = البداية;
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            لو (الجذر >= (العدد / 2)) { اخرج_من_حلقة; };
            دع الأكبر: متغير طبيعي = الجذر;
            دع اليسار: طبيعي = الجذر * 2 + 1;
            لو ((اليسار < العدد) && (المقارنة(&(*القيم)[اليسار], &(*القيم)[الأكبر]) > 0)) { الأكبر := اليسار; };
            دع اليمين: طبيعي = اليسار + 1;
            لو ((اليمين < العدد) && (المقارنة(&(*القيم)[اليمين], &(*القيم)[الأكبر]) > 0)) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                بدّل((*القيم)[الجذر], (*القيم)[الأكبر]);
                الجذر := الأكبر;
            };
        }
    }

    دع الحد: متغير طبيعي = العدد;
    طالما (الحد > 1) {
        الحد := الحد - 1;
        بدّل((*القيم)[0], (*القيم)[الحد]);
        دع الجذر: متغير طبيعي = 0;
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            لو (الجذر >= (الحد / 2)) { اخرج_من_حلقة; };
            دع الأكبر: متغير طبيعي = الجذر;
            دع اليسار: طبيعي = الجذر * 2 + 1;
            لو ((اليسار < الحد) && (المقارنة(&(*القيم)[اليسار], &(*القيم)[الأكبر]) > 0)) { الأكبر := اليسار; };
            دع اليمين: طبيعي = اليسار + 1;
            لو ((اليمين < الحد) && (المقارنة(&(*القيم)[اليمين], &(*القيم)[الأكبر]) > 0)) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                بدّل((*القيم)[الجذر], (*القيم)[الأكبر]);
                الجذر := الأكبر;
            };
        }
    }
}

// Returns one matching position in an already-sorted vector.
عام عرف بحث_ثنائي_بالمقارنة<ق>(
    القيم: &متجه ق,
    المطلوب: &ق,
    المقارنة: دالة(&ق, &ق): عدد
): اختياري طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*القيم) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        دع نتيجة_المقارنة: عدد = المقارنة(&(*القيم)[الوسط], المطلوب);
        لو (نتيجة_المقارنة < 0) { البداية := الوسط + 1; }
        وإلا لو (نتيجة_المقارنة > 0) { النهاية := الوسط; }
        وإلا { أرجع اختياري.موجود(الوسط); };
    }
    أرجع اختياري.لا_شيء();
}

// First position at which value can be inserted without violating ordering.
عام عرف موضع_الحد_الأدنى_بالمقارنة<ق>(
    القيم: &متجه ق,
    المطلوب: &ق,
    المقارنة: دالة(&ق, &ق): عدد
): طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*القيم) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        لو (المقارنة(&(*القيم)[الوسط], المطلوب) < 0) { البداية := الوسط + 1; }
        وإلا { النهاية := الوسط; };
    }
    أرجع البداية;
}

// First position strictly after all values equal to the requested value.
عام عرف موضع_الحد_الأعلى_بالمقارنة<ق>(
    القيم: &متجه ق,
    المطلوب: &ق,
    المقارنة: دالة(&ق, &ق): عدد
): طبيعي {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول(*القيم) مثل طبيعي;
    طالما (البداية < النهاية) {
        دع الوسط: طبيعي = البداية + ((النهاية - البداية) / 2);
        لو (المقارنة(&(*القيم)[الوسط], المطلوب) <= 0) { البداية := الوسط + 1; }
        وإلا { النهاية := الوسط; };
    }
    أرجع البداية;
}

عرف قارن_طبيعي_للفرز(أ: &طبيعي, ب: &طبيعي): عدد {
    لو (*أ < *ب) { أرجع -1; };
    لو (*أ > *ب) { أرجع 1; };
    أرجع 0;
}

عرف قارن_عدد_للفرز(أ: &عدد, ب: &عدد): عدد {
    لو (*أ < *ب) { أرجع -1; };
    لو (*أ > *ب) { أرجع 1; };
    أرجع 0;
}

عام عرف رتب_طبيعي(القيم: &متغير متجه طبيعي): فراغ { رتب_بالمقارنة(القيم, قارن_طبيعي_للفرز); }
عام عرف رتب_عدد(القيم: &متغير متجه عدد): فراغ { رتب_بالمقارنة(القيم, قارن_عدد_للفرز); }
عام عرف رتب_نصوص(القيم: &متغير متجه نص): فراغ { رتب_بالمقارنة(القيم, قارن_نصين_معجميا); }

عام عرف بحث_ثنائي_طبيعي(القيم: &متجه طبيعي, المطلوب: طبيعي): اختياري طبيعي {
    أرجع بحث_ثنائي_بالمقارنة(القيم, &المطلوب, قارن_طبيعي_للفرز);
}
عام عرف بحث_ثنائي_عدد(القيم: &متجه عدد, المطلوب: عدد): اختياري طبيعي {
    أرجع بحث_ثنائي_بالمقارنة(القيم, &المطلوب, قارن_عدد_للفرز);
}
عام عرف بحث_ثنائي_نص(القيم: &متجه نص, المطلوب: &نص): اختياري طبيعي {
    أرجع بحث_ثنائي_بالمقارنة(القيم, المطلوب, قارن_نصين_معجميا);
}

عام مرادف sort_by = رتب_بالمقارنة;
عام مرادف binary_search_by = بحث_ثنائي_بالمقارنة;
عام مرادف lower_bound_by = موضع_الحد_الأدنى_بالمقارنة;
عام مرادف upper_bound_by = موضع_الحد_الأعلى_بالمقارنة;
عام مرادف sort_uint = رتب_طبيعي;
عام مرادف sort_int = رتب_عدد;
عام مرادف sort_texts = رتب_نصوص;
عام مرادف binary_search_uint = بحث_ثنائي_طبيعي;
عام مرادف binary_search_int = بحث_ثنائي_عدد;
عام مرادف binary_search_text = بحث_ثنائي_نص;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف رتب_غير_موقع = رتب_طبيعي;
عام مرادف بحث_ثنائي_غير_موقع = بحث_ثنائي_طبيعي;
