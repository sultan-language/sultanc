استورد text.compare;

// فرز تصاعدي داخل المتجه باستعمال heap sort: ذاكرة إضافية ثابتة و O(n log n).
عام عرف رتب_غير_موقع(القيم: &متغير متجه غير_موقع): فراغ {
    دع الحالية: متغير متجه غير_موقع = *القيم;
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع; };

    دع البداية: متغير غير_موقع = العدد / 2;
    بينما (البداية > 0) {
        البداية := البداية - 1;
        دع الجذر: متغير غير_موقع = البداية;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < العدد) && (الحالية[اليسار] > الحالية[الأكبر])) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < العدد) && (الحالية[اليمين] > الحالية[الأكبر])) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع مؤقت: غير_موقع = الحالية[الجذر];
                الحالية[الجذر] := الحالية[الأكبر];
                الحالية[الأكبر] := مؤقت;
                الجذر := الأكبر;
            };
        }
    }

    دع الحد: متغير غير_موقع = العدد;
    بينما (الحد > 1) {
        الحد := الحد - 1;
        دع مؤقت: غير_موقع = الحالية[0];
        الحالية[0] := الحالية[الحد];
        الحالية[الحد] := مؤقت;
        دع الجذر: متغير غير_موقع = 0;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < الحد) && (الحالية[اليسار] > الحالية[الأكبر])) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < الحد) && (الحالية[اليمين] > الحالية[الأكبر])) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع بدل: غير_موقع = الحالية[الجذر];
                الحالية[الجذر] := الحالية[الأكبر];
                الحالية[الأكبر] := بدل;
                الجذر := الأكبر;
            };
        }
    }
    *القيم := الحالية;
}

عام عرف رتب_عدد(القيم: &متغير متجه عدد): فراغ {
    دع الحالية: متغير متجه عدد = *القيم;
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع; };

    دع البداية: متغير غير_موقع = العدد / 2;
    بينما (البداية > 0) {
        البداية := البداية - 1;
        دع الجذر: متغير غير_موقع = البداية;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < العدد) && (الحالية[اليسار] > الحالية[الأكبر])) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < العدد) && (الحالية[اليمين] > الحالية[الأكبر])) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع مؤقت: عدد = الحالية[الجذر];
                الحالية[الجذر] := الحالية[الأكبر];
                الحالية[الأكبر] := مؤقت;
                الجذر := الأكبر;
            };
        }
    }

    دع الحد: متغير غير_موقع = العدد;
    بينما (الحد > 1) {
        الحد := الحد - 1;
        دع مؤقت: عدد = الحالية[0];
        الحالية[0] := الحالية[الحد];
        الحالية[الحد] := مؤقت;
        دع الجذر: متغير غير_موقع = 0;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < الحد) && (الحالية[اليسار] > الحالية[الأكبر])) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < الحد) && (الحالية[اليمين] > الحالية[الأكبر])) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع بدل: عدد = الحالية[الجذر];
                الحالية[الجذر] := الحالية[الأكبر];
                الحالية[الأكبر] := بدل;
                الجذر := الأكبر;
            };
        }
    }
    *القيم := الحالية;
}

عرف انسخ_نص_للفرز(القيمة: &نص): نص { دع النسخة: نص = *القيمة; أرجع النسخة; }

عام عرف رتب_نصوص(القيم: &متغير متجه نص): فراغ {
    دع الحالية: متغير متجه نص = *القيم;
    دع العدد: غير_موقع = الطول(الحالية) مثل غير_موقع;
    لو (العدد < 2) { أرجع; };

    دع البداية: متغير غير_موقع = العدد / 2;
    بينما (البداية > 0) {
        البداية := البداية - 1;
        دع الجذر: متغير غير_موقع = البداية;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < العدد) && (قارن_نصين_معجميا(&الحالية[اليسار], &الحالية[الأكبر]) > 0)) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < العدد) && (قارن_نصين_معجميا(&الحالية[اليمين], &الحالية[الأكبر]) > 0)) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع الأول: نص = انسخ_نص_للفرز(&الحالية[الجذر]);
                دع الثاني: نص = انسخ_نص_للفرز(&الحالية[الأكبر]);
                الحالية[الجذر] := الثاني;
                الحالية[الأكبر] := الأول;
                الجذر := الأكبر;
            };
        }
    }

    دع الحد: متغير غير_موقع = العدد;
    بينما (الحد > 1) {
        الحد := الحد - 1;
        دع الأول: نص = انسخ_نص_للفرز(&الحالية[0]);
        دع الثاني: نص = انسخ_نص_للفرز(&الحالية[الحد]);
        الحالية[0] := الثاني;
        الحالية[الحد] := الأول;
        دع الجذر: متغير غير_موقع = 0;
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            دع الأكبر: متغير غير_موقع = الجذر;
            دع اليسار: غير_موقع = الجذر * 2 + 1;
            لو ((اليسار < الحد) && (قارن_نصين_معجميا(&الحالية[اليسار], &الحالية[الأكبر]) > 0)) { الأكبر := اليسار; };
            دع اليمين: غير_موقع = اليسار + 1;
            لو ((اليمين < الحد) && (قارن_نصين_معجميا(&الحالية[اليمين], &الحالية[الأكبر]) > 0)) { الأكبر := اليمين; };
            لو (الأكبر == الجذر) { مستمر := خطأ; }
            وإلا {
                دع بدل_أ: نص = انسخ_نص_للفرز(&الحالية[الجذر]);
                دع بدل_ب: نص = انسخ_نص_للفرز(&الحالية[الأكبر]);
                الحالية[الجذر] := بدل_ب;
                الحالية[الأكبر] := بدل_أ;
                الجذر := الأكبر;
            };
        }
    }
    *القيم := الحالية;
}

عام عرف بحث_ثنائي_غير_موقع(القيم: &متجه غير_موقع, المطلوب: غير_موقع): اختيار غير_موقع {
    دع الحالية: متجه غير_موقع = *القيم;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(الحالية) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع القيمة: غير_موقع = الحالية[الوسط];
        لو (القيمة < المطلوب) { البداية := الوسط + 1; }
        وإلا لو (القيمة > المطلوب) { النهاية := الوسط; }
        وإلا { أرجع اختيار.بعض(الوسط); };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف بحث_ثنائي_عدد(القيم: &متجه عدد, المطلوب: عدد): اختيار غير_موقع {
    دع الحالية: متجه عدد = *القيم;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(الحالية) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع القيمة: عدد = الحالية[الوسط];
        لو (القيمة < المطلوب) { البداية := الوسط + 1; }
        وإلا لو (القيمة > المطلوب) { النهاية := الوسط; }
        وإلا { أرجع اختيار.بعض(الوسط); };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف بحث_ثنائي_نص(القيم: &متجه نص, المطلوب: &نص): اختيار غير_موقع {
    دع الحالية: متجه نص = *القيم;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(الحالية) مثل غير_موقع;
    بينما (البداية < النهاية) {
        دع الوسط: غير_موقع = البداية + ((النهاية - البداية) / 2);
        دع القيمة: نص = انسخ_نص_للفرز(&الحالية[الوسط]);
        دع المقارنة: عدد = قارن_نصين_معجميا(&القيمة, المطلوب);
        لو (المقارنة < 0) { البداية := الوسط + 1; }
        وإلا لو (المقارنة > 0) { النهاية := الوسط; }
        وإلا { أرجع اختيار.بعض(الوسط); };
    }
    أرجع اختيار.لا_شيء();
}

عام مرادف sort_uint = رتب_غير_موقع;
عام مرادف sort_int = رتب_عدد;
عام مرادف sort_texts = رتب_نصوص;
عام مرادف binary_search_uint = بحث_ثنائي_غير_موقع;
عام مرادف binary_search_int = بحث_ثنائي_عدد;
عام مرادف binary_search_text = بحث_ثنائي_نص;
