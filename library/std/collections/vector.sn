// Vector helpers over any element type, by swapping slots or through a
// caller-supplied predicate, equality or ordering (Go slices, Rust slice and
// Vec methods). Vectors grow with ألحق and shrink with أزل_الأخير / pop and
// اقتطع / truncate; the helpers here reorder, search, and remove in place.
// Removed elements are dropped (their storage released) exactly once.
// A vector keeps its buffer when it shrinks, as Rust's Vec does: سعة /
// capacity reads it, احجز_سعة / reserve_exact and احجز_في_المتجه / reserve
// grow it, قلص_المتجه / shrink_to_fit gives the unused part back.

// Reverses the order in place (Rust reverse, Go slices.Reverse).
عام عرف اعكس_المتجه<ق>(القيم: &متغير متجه ق): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد < 2) { أرجع; };
    دع اليسار: متغير طبيعي = 0;
    دع اليمين: متغير طبيعي = العدد - 1;
    طالما (اليسار < اليمين) {
        بدّل((*القيم)[اليسار], (*القيم)[اليمين]);
        اليسار := اليسار + 1;
        اليمين := اليمين - 1;
    }
}

// The first position whose element equals المطلوب (Go slices.IndexFunc).
عام عرف ابحث_في_المتجه<ق>(
    القيم: &متجه ق, المطلوب: &ق, التساوي: دالة(&ق, &ق): منطقي
): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        إذا (التساوي(&(*القيم)[ف], المطلوب)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف هل_يحتوي_المتجه<ق>(
    القيم: &متجه ق, المطلوب: &ق, التساوي: دالة(&ق, &ق): منطقي
): منطقي {
    طابق ابحث_في_المتجه(القيم, المطلوب, التساوي) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// The position of the smallest element under المقارنة (negative: the first
// argument is smaller); the first one among equals. Nothing when empty.
عام عرف موضع_الأصغر_في_المتجه<ق>(
    القيم: &متجه ق, المقارنة: دالة(&ق, &ق): عدد
): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الأفضل: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        إذا (المقارنة(&(*القيم)[ف], &(*القيم)[الأفضل]) < 0) { الأفضل := ف; };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الأفضل);
}

// The position of the largest element; the first one among equals.
عام عرف موضع_الأكبر_في_المتجه<ق>(
    القيم: &متجه ق, المقارنة: دالة(&ق, &ق): عدد
): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
    دع الأفضل: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        إذا (المقارنة(&(*القيم)[ف], &(*القيم)[الأفضل]) > 0) { الأفضل := ف; };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الأفضل);
}

// Moves the first المقدار elements to the end (Rust rotate_left), by three
// reversals.
عام عرف دور_المتجه_يسارا<ق>(القيم: &متغير متجه ق, المقدار: طبيعي): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد < 2) { أرجع; };
    دع ك: طبيعي = المقدار % العدد;
    إذا (ك == 0) { أرجع; };
    اعكس_مدى(القيم, 0, ك);
    اعكس_مدى(القيم, ك, العدد);
    اعكس_مدى(القيم, 0, العدد);
}

عرف اعكس_مدى<ق>(القيم: &متغير متجه ق, البداية: طبيعي, النهاية: طبيعي): فراغ {
    إذا (النهاية - البداية < 2) { أرجع; };
    دع اليسار: متغير طبيعي = البداية;
    دع اليمين: متغير طبيعي = النهاية - 1;
    طالما (اليسار < اليمين) {
        بدّل((*القيم)[اليسار], (*القيم)[اليمين]);
        اليسار := اليسار + 1;
        اليمين := اليمين - 1;
    }
}

// Keeps the elements الشرط accepts, in their order, and drops the others
// (Rust Vec::retain, Go slices.DeleteFunc with the predicate negated). Each
// kept element is swapped once into place, then the tail is truncated.
عام عرف احتفظ_في_المتجه<ق>(القيم: &متغير متجه ق, الشرط: دالة(&ق): منطقي): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    دع المكتوب: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (الشرط(&(*القيم)[ف])) {
            إذا (المكتوب != ف) { بدّل((*القيم)[المكتوب], (*القيم)[ف]); };
            المكتوب := المكتوب + 1;
        };
        ف := ف + 1;
    }
    اقتطع(*القيم, المكتوب);
}

// Removes consecutive elements that التساوي finds equal to the element kept
// before them (Rust Vec::dedup_by, Go slices.CompactFunc); the first of
// each run stays.
عام عرف أزل_المتكرر_المتتالي<ق>(القيم: &متغير متجه ق, التساوي: دالة(&ق, &ق): منطقي): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (العدد < 2) { أرجع; };
    دع المكتوب: متغير طبيعي = 1;
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        إذا (!التساوي(&(*القيم)[ف], &(*القيم)[المكتوب - 1])) {
            إذا (المكتوب != ف) { بدّل((*القيم)[المكتوب], (*القيم)[ف]); };
            المكتوب := المكتوب + 1;
        };
        ف := ف + 1;
    }
    اقتطع(*القيم, المكتوب);
}

// Removes and returns the element at الموضع, shifting the later ones down
// (Rust Vec::remove, Go slices.Delete); nothing when الموضع is out of range.
عام عرف أزل_عند<ق>(القيم: &متغير متجه ق, الموضع: طبيعي): اختياري ق {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (الموضع >= العدد) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = الموضع;
    طالما (ف + 1 < العدد) {
        بدّل((*القيم)[ف], (*القيم)[ف + 1]);
        ف := ف + 1;
    }
    أرجع أزل_الأخير(*القيم);
}

// Removes and returns the element at الموضع, moving the last element into
// its place: O(1), the order changes (Rust Vec::swap_remove).
عام عرف أزل_بالتبديل<ق>(القيم: &متغير متجه ق, الموضع: طبيعي): اختياري ق {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا (الموضع >= العدد) { أرجع اختياري.لا_شيء(); };
    إذا (الموضع + 1 < العدد) { بدّل((*القيم)[الموضع], (*القيم)[العدد - 1]); };
    أرجع أزل_الأخير(*القيم);
}

// Inserts القيمة at الموضع, shifting the later elements up (Rust Vec::insert,
// Go slices.Insert). A position past the end appends at the end: the value
// is never lost.
عام عرف أدرج_عند<ق>(القيم: &متغير متجه ق, الموضع: طبيعي, القيمة: ق): فراغ {
    ألحق(*القيم, القيمة);
    دع ف: متغير طبيعي = (الطول(*القيم) مثل طبيعي) - 1;
    طالما (ف > الموضع) {
        بدّل((*القيم)[ف], (*القيم)[ف - 1]);
        ف := ف - 1;
    }
}

// Removes every element (Rust Vec::clear, Go clear on a slice).
عام عرف امسح_المتجه<ق>(القيم: &متغير متجه ق): فراغ {
    اقتطع(*القيم, 0);
}

// A vector with room for at least السعة elements before it reallocates
// (Rust Vec::with_capacity, Go make([]T, 0, n)).
عام عرف متجه_بسعة<ق>(السعة: طبيعي): متجه ق {
    دع الناتج: متغير متجه ق = [];
    احجز_سعة(الناتج, السعة);
    أرجع الناتج;
}

// Room for at least الإضافي more elements (Rust Vec::reserve). When the
// buffer grows, it at least doubles, so repeated reserves stay amortized
// O(1) per element, as appends are.
عام عرف احجز_في_المتجه<ق>(القيم: &متغير متجه ق, الإضافي: طبيعي): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    دع السعة_الحالية: طبيعي = سعة(*القيم) مثل طبيعي;
    إذا (السعة_الحالية - العدد >= الإضافي) { أرجع; };
    دع المطلوب: متغير طبيعي = العدد + الإضافي;
    إذا (المطلوب < السعة_الحالية * 2) { المطلوب := السعة_الحالية * 2; };
    احجز_سعة(*القيم, المطلوب - العدد);
}

// Gives back the capacity beyond the length (Rust Vec::shrink_to_fit): the
// elements move, in order, into a buffer of exactly their count; an empty
// vector releases its buffer.
عام عرف قلص_المتجه<ق>(القيم: &متغير متجه ق): فراغ {
    دع العدد: طبيعي = الطول(*القيم) مثل طبيعي;
    إذا ((سعة(*القيم) مثل طبيعي) <= العدد) { أرجع; };
    دع الجديد: متغير متجه ق = [];
    احجز_سعة(الجديد, العدد);
    طالما ((الطول(*القيم) مثل طبيعي) > 0) {
        طابق أزل_الأخير(*القيم) مع
        | اختياري.موجود(العنصر) -> { ألحق(الجديد, العنصر); }
        | اختياري.لا_شيء -> { };
    }
    اعكس_المتجه(&متغير الجديد);
    // The old buffer, now empty, leaves with الجديد and is released.
    بدّل((*القيم), الجديد);
}

عام مرادف reverse_vector = اعكس_المتجه;
عام مرادف index_of_by = ابحث_في_المتجه;
عام مرادف contains_by = هل_يحتوي_المتجه;
عام مرادف position_min_by = موضع_الأصغر_في_المتجه;
عام مرادف position_max_by = موضع_الأكبر_في_المتجه;
عام مرادف rotate_left = دور_المتجه_يسارا;
عام مرادف retain = احتفظ_في_المتجه;
عام مرادف dedup_by = أزل_المتكرر_المتتالي;
عام مرادف remove_at = أزل_عند;
عام مرادف swap_remove = أزل_بالتبديل;
عام مرادف insert_at = أدرج_عند;
عام مرادف clear_vector = امسح_المتجه;
عام مرادف with_capacity = متجه_بسعة;
عام مرادف reserve = احجز_في_المتجه;
عام مرادف shrink_to_fit = قلص_المتجه;
