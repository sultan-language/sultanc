// Canonical generic open-addressed hash map. Hash and equality policy are supplied
// by the caller; this module owns storage, probing, capacity, and tombstones.
//
// Buckets intentionally contain only cached hash/index metadata. Generic keys and
// values live in side storage so probing can compare a borrowed stored key without
// copying arbitrary generic payloads on every collision.
عام نوع خانة_الخريطة<م, ق> =
    | فارغة
    | محذوفة
    | مشغولة بنوع (غير_موقع, غير_موقع)
;

عام نوع مدخل_الخريطة<م, ق> = { المفتاح: م, القيمة: ق };

عام نوع الخريطة<م, ق> = {
    الخانات: متجه خانة_الخريطة<م, ق>,
    المداخل: متجه مدخل_الخريطة<اختيار م, اختيار ق>,
    المداخل_الحرة: متجه غير_موقع,
    عدد_المداخل_الحرة: غير_موقع,
    العدد: غير_موقع,
    المحذوف: غير_موقع,
    الهاش: دالة(&م): غير_موقع,
    التساوي: دالة(&م, &م): منطقي
};

نوع نتيجة_مسبار_الخريطة = {
    الموضع: غير_موقع,
    فهرس_المدخل: غير_موقع,
    موجود: منطقي,
    يعيد_استخدام_محذوف: منطقي
};

نوع موضع_الخريطة = {
    الموضع: غير_موقع,
    فهرس_المدخل: غير_موقع
};

عرف سعة_خانات_للعدد(العدد: غير_موقع): غير_موقع {
    دع السعة: متغير غير_موقع = 8;
    بينما ((العدد * 4) > (السعة * 3)) { السعة := السعة * 2; }
    أرجع السعة;
}

عرف ابن_خانات_الخريطة<م, ق>(السعة: غير_موقع): متجه خانة_الخريطة<م, ق> {
    دع الناتج: متغير متجه خانة_الخريطة<م, ق> = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(الناتج, خانة_الخريطة.فارغة());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_الخريطة_بسعة<م, ق>(
    السعة_المتوقعة: غير_موقع,
    الهاش: دالة(&م): غير_موقع,
    التساوي: دالة(&م, &م): منطقي
): الخريطة<م, ق> {
    دع سعة_الخانات: غير_موقع = سعة_خانات_للعدد(السعة_المتوقعة);
    دع الخانات: متجه خانة_الخريطة<م, ق> = ابن_خانات_الخريطة(سعة_الخانات);
    دع المداخل: متجه مدخل_الخريطة<اختيار م, اختيار ق> = [];
    دع الحرة: متجه غير_موقع = [];
    دع الناتج: الخريطة<م, ق> = {
        الخانات: الخانات,
        المداخل: المداخل,
        المداخل_الحرة: الحرة,
        عدد_المداخل_الحرة: 0,
        العدد: 0,
        المحذوف: 0,
        الهاش: الهاش,
        التساوي: التساوي
    };
    أرجع الناتج;
}

عام عرف أنشئ_الخريطة<م, ق>(
    الهاش: دالة(&م): غير_موقع,
    التساوي: دالة(&م, &م): منطقي
): الخريطة<م, ق> {
    أرجع أنشئ_الخريطة_بسعة(0, الهاش, التساوي);
}

عرف ابحث_عن_موضع_الخريطة<م, ق>(
    الخريطة: &الخريطة<م, ق>,
    المفتاح: &م,
    الهاش: غير_موقع
): اختيار موضع_الخريطة {
    دع السعة: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق (*الخريطة).الخانات[الموضع] مع
        | خانة_الخريطة.فارغة -> { أرجع اختيار.لا_شيء(); }
        | خانة_الخريطة.محذوفة -> { }
        | خانة_الخريطة.مشغولة(هاش_الخانة, فهرس_المدخل) -> {
            لو (هاش_الخانة == الهاش) {
                دع مرجع_المفتاح: &اختيار م = &(*الخريطة).المداخل[فهرس_المدخل].المفتاح;
                طابق *مرجع_المفتاح مع
                | اختيار.بعض(المفتاح_المخزن) -> {
                    لو (التساوي(&المفتاح_المخزن, المفتاح)) {
                        دع الناتج: موضع_الخريطة = {
                            الموضع: الموضع,
                            فهرس_المدخل: فهرس_المدخل
                        };
                        أرجع اختيار.بعض(الناتج);
                    };
                }
                | اختيار.لا_شيء -> { };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف مسبار_إدخال_الخريطة<م, ق>(
    الخريطة: &الخريطة<م, ق>,
    المفتاح: &م,
    الهاش: غير_موقع
): نتيجة_مسبار_الخريطة {
    دع السعة: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع أول_محذوف: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق (*الخريطة).الخانات[الموضع] مع
        | خانة_الخريطة.فارغة -> {
            طابق أول_محذوف مع
            | اختيار.بعض(موضع_محذوف) -> {
                دع الناتج: نتيجة_مسبار_الخريطة = {
                    الموضع: موضع_محذوف,
                    فهرس_المدخل: 0,
                    موجود: خطأ,
                    يعيد_استخدام_محذوف: صواب
                };
                أرجع الناتج;
            }
            | اختيار.لا_شيء -> {
                دع الناتج: نتيجة_مسبار_الخريطة = {
                    الموضع: الموضع,
                    فهرس_المدخل: 0,
                    موجود: خطأ,
                    يعيد_استخدام_محذوف: خطأ
                };
                أرجع الناتج;
            };
        }
        | خانة_الخريطة.محذوفة -> {
            طابق أول_محذوف مع
            | اختيار.لا_شيء -> { أول_محذوف := اختيار.بعض(الموضع); }
            | اختيار.بعض(_) -> { };
        }
        | خانة_الخريطة.مشغولة(هاش_الخانة, فهرس_المدخل) -> {
            لو (هاش_الخانة == الهاش) {
                دع مرجع_المفتاح: &اختيار م = &(*الخريطة).المداخل[فهرس_المدخل].المفتاح;
                طابق *مرجع_المفتاح مع
                | اختيار.بعض(المفتاح_المخزن) -> {
                    لو (التساوي(&المفتاح_المخزن, المفتاح)) {
                        دع الناتج: نتيجة_مسبار_الخريطة = {
                            الموضع: الموضع,
                            فهرس_المدخل: فهرس_المدخل,
                            موجود: صواب,
                            يعيد_استخدام_محذوف: خطأ
                        };
                        أرجع الناتج;
                    };
                }
                | اختيار.لا_شيء -> { };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    طابق أول_محذوف مع
    | اختيار.بعض(موضع_محذوف) -> {
        دع الناتج: نتيجة_مسبار_الخريطة = {
            الموضع: موضع_محذوف,
            فهرس_المدخل: 0,
            موجود: خطأ,
            يعيد_استخدام_محذوف: صواب
        };
        أرجع الناتج;
    }
    | اختيار.لا_شيء -> {
        دع الناتج: نتيجة_مسبار_الخريطة = {
            الموضع: 0,
            فهرس_المدخل: 0,
            موجود: خطأ,
            يعيد_استخدام_محذوف: خطأ
        };
        أرجع الناتج;
    };
}

عرف أدرج_فهرس_في_خانات<م, ق>(
    الخانات: &متغير متجه خانة_الخريطة<م, ق>,
    الهاش: غير_موقع,
    فهرس_المدخل: غير_موقع
): فراغ {
    دع السعة: غير_موقع = الطول(*الخانات) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع المفحوص: متغير غير_موقع = 0;
    بينما (المفحوص < السعة) {
        طابق (*الخانات)[الموضع] مع
        | خانة_الخريطة.فارغة -> {
            (*الخانات)[الموضع] := خانة_الخريطة.مشغولة(الهاش, فهرس_المدخل);
            أرجع;
        }
        | _ -> { };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
}

عرف أعد_تجزئة_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, السعة_المطلوبة: غير_موقع): فراغ {
    دع السعة: متغير غير_موقع = السعة_المطلوبة;
    لو (السعة < 8) { السعة := 8; };
    دع الجديدة: متغير متجه خانة_الخريطة<م, ق> = ابن_خانات_الخريطة(السعة);
    دع القديمة: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < القديمة) {
        طابق (*الخريطة).الخانات[ف] مع
        | خانة_الخريطة.مشغولة(هاش_الخانة, فهرس_المدخل) -> {
            أدرج_فهرس_في_خانات(&متغير الجديدة, هاش_الخانة, فهرس_المدخل);
        }
        | _ -> { };
        ف := ف + 1;
    }
    (*الخريطة).الخانات := الجديدة;
    (*الخريطة).المحذوف := 0;
}

عرف سجل_مدخلا_حرا<م, ق>(الخريطة: &متغير الخريطة<م, ق>, فهرس_المدخل: غير_موقع): فراغ {
    دع الموضع: غير_موقع = (*الخريطة).عدد_المداخل_الحرة;
    لو (الموضع < (الطول((*الخريطة).المداخل_الحرة) مثل غير_موقع)) {
        (*الخريطة).المداخل_الحرة[الموضع] := فهرس_المدخل;
    } وإلا {
        ألحق((*الخريطة).المداخل_الحرة, فهرس_المدخل);
    };
    (*الخريطة).عدد_المداخل_الحرة := الموضع + 1;
}

عرف خذ_مدخلا_حرا<م, ق>(الخريطة: &متغير الخريطة<م, ق>): اختيار غير_موقع {
    لو ((*الخريطة).عدد_المداخل_الحرة == 0) { أرجع اختيار.لا_شيء(); };
    دع الموضع: غير_موقع = (*الخريطة).عدد_المداخل_الحرة - 1;
    (*الخريطة).عدد_المداخل_الحرة := الموضع;
    أرجع اختيار.بعض((*الخريطة).المداخل_الحرة[الموضع]);
}

عام عرف احجز_للخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, إضافي: غير_موقع): فراغ {
    دع المطلوب_من_المداخل: غير_موقع = (*الخريطة).العدد + إضافي;
    دع المطلوبة: غير_موقع = سعة_خانات_للعدد(المطلوب_من_المداخل);
    دع الحالية: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    لو (المطلوبة > الحالية) {
        أعد_تجزئة_الخريطة(الخريطة, المطلوبة);
        أرجع;
    };
    لو ((((*الخريطة).العدد + (*الخريطة).المحذوف + إضافي) * 4) > (الحالية * 3)) {
        لو ((*الخريطة).المحذوف > 0) { أعد_تجزئة_الخريطة(الخريطة, الحالية); };
    };
}

عام عرف سعة_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): غير_موقع {
    دع سعة_الخانات: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    أرجع (سعة_الخانات * 3) / 4;
}

عام عرف أدرج_في_الخريطة<م, ق>(
    الخريطة: &متغير الخريطة<م, ق>,
    المفتاح: م,
    القيمة: ق
): اختيار ق {
    دع دالة_الهاش: دالة(&م): غير_موقع = (*الخريطة).الهاش;
    دع الهاش: غير_موقع = دالة_الهاش(&المفتاح);
    دع المسبار: نتيجة_مسبار_الخريطة = مسبار_إدخال_الخريطة(الخريطة, &المفتاح, الهاش);

    // Replacement is settled by the first probe and never triggers a grow.
    لو (المسبار.موجود) {
        دع الجديدة: متغير اختيار ق = اختيار.بعض(القيمة);
        بدّل((*الخريطة).المداخل[المسبار.فهرس_المدخل].القيمة, الجديدة);
        أرجع الجديدة;
    };

    // Capacity work happens only for a genuinely new key. Rehashing rebuilds
    // bucket metadata only; generic keys and values remain in canonical storage.
    دع أعيد_تجزئتها: متغير منطقي = خطأ;
    دع سعة_الخانات: متغير غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    دع المطلوبة: غير_موقع = سعة_خانات_للعدد((*الخريطة).العدد + 1);
    لو (المطلوبة > سعة_الخانات) {
        أعد_تجزئة_الخريطة(الخريطة, المطلوبة);
        سعة_الخانات := المطلوبة;
        أعيد_تجزئتها := صواب;
    } وإلا {
        دع المشغول_بعد: غير_موقع = (*الخريطة).العدد + (*الخريطة).المحذوف + 1;
        لو (((المشغول_بعد * 4) > (سعة_الخانات * 3)) && ((*الخريطة).المحذوف > 0)) {
            أعد_تجزئة_الخريطة(الخريطة, سعة_الخانات);
            أعيد_تجزئتها := صواب;
        };
    };

    دع فهرس_المدخل: متغير غير_موقع = 0;
    طابق خذ_مدخلا_حرا(الخريطة) مع
    | اختيار.بعض(الفهرس) -> {
        فهرس_المدخل := الفهرس;
        دع المفتاح_الجديد: متغير اختيار م = اختيار.بعض(المفتاح);
        دع القيمة_الجديدة: متغير اختيار ق = اختيار.بعض(القيمة);
        بدّل((*الخريطة).المداخل[الفهرس].المفتاح, المفتاح_الجديد);
        بدّل((*الخريطة).المداخل[الفهرس].القيمة, القيمة_الجديدة);
    }
    | اختيار.لا_شيء -> {
        فهرس_المدخل := الطول((*الخريطة).المداخل) مثل غير_موقع;
        دع المدخل: مدخل_الخريطة<اختيار م, اختيار ق> = {
            المفتاح: اختيار.بعض(المفتاح),
            القيمة: اختيار.بعض(القيمة)
        };
        ألحق((*الخريطة).المداخل, المدخل);
    };

    لو (أعيد_تجزئتها) {
        أدرج_فهرس_في_خانات(&متغير (*الخريطة).الخانات, الهاش, فهرس_المدخل);
    } وإلا {
        (*الخريطة).الخانات[المسبار.الموضع] := خانة_الخريطة.مشغولة(الهاش, فهرس_المدخل);
        لو (المسبار.يعيد_استخدام_محذوف) {
            (*الخريطة).المحذوف := (*الخريطة).المحذوف - 1;
        };
    };
    (*الخريطة).العدد := (*الخريطة).العدد + 1;
    أرجع اختيار.لا_شيء();
}

عام عرف ابحث_في_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>, المفتاح: &م): اختيار ق {
    دع دالة_الهاش: دالة(&م): غير_موقع = (*الخريطة).الهاش;
    دع الهاش: غير_موقع = دالة_الهاش(المفتاح);
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموجود) -> {
        طابق (*الخريطة).المداخل[الموجود.فهرس_المدخل].القيمة مع
        | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(القيمة); }
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف تحتوي_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>, المفتاح: &م): منطقي {
    دع دالة_الهاش: دالة(&م): غير_موقع = (*الخريطة).الهاش;
    دع الهاش: غير_موقع = دالة_الهاش(المفتاح);
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف احذف_من_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, المفتاح: &م): اختيار ق {
    دع دالة_الهاش: دالة(&م): غير_موقع = (*الخريطة).الهاش;
    دع الهاش: غير_موقع = دالة_الهاش(المفتاح);
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموجود) -> {
        دع المفتاح_المحذوف: متغير اختيار م = اختيار.لا_شيء();
        دع القيمة_المحذوفة: متغير اختيار ق = اختيار.لا_شيء();
        بدّل((*الخريطة).المداخل[الموجود.فهرس_المدخل].المفتاح, المفتاح_المحذوف);
        بدّل((*الخريطة).المداخل[الموجود.فهرس_المدخل].القيمة, القيمة_المحذوفة);
        (*الخريطة).الخانات[الموجود.الموضع] := خانة_الخريطة.محذوفة();
        (*الخريطة).العدد := (*الخريطة).العدد - 1;
        (*الخريطة).المحذوف := (*الخريطة).المحذوف + 1;
        سجل_مدخلا_حرا(الخريطة, الموجود.فهرس_المدخل);
        أرجع القيمة_المحذوفة;
    };
}

عام عرف طول_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): غير_موقع {
    أرجع (*الخريطة).العدد;
}

// Clear releases every live generic payload while retaining reusable bucket
// and side-entry storage. Every side slot becomes owner-empty and reusable.
عام عرف امسح_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>): فراغ {
    دع ف: متغير غير_موقع = 0;
    دع السعة: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    بينما (ف < السعة) {
        (*الخريطة).الخانات[ف] := خانة_الخريطة.فارغة();
        ف := ف + 1;
    }

    (*الخريطة).عدد_المداخل_الحرة := 0;
    ف := 0;
    دع عدد_المداخل: غير_موقع = الطول((*الخريطة).المداخل) مثل غير_موقع;
    بينما (ف < عدد_المداخل) {
        دع المفتاح_المزال: متغير اختيار م = اختيار.لا_شيء();
        دع القيمة_المزالة: متغير اختيار ق = اختيار.لا_شيء();
        بدّل((*الخريطة).المداخل[ف].المفتاح, المفتاح_المزال);
        بدّل((*الخريطة).المداخل[ف].القيمة, القيمة_المزالة);
        سجل_مدخلا_حرا(الخريطة, ف);
        ف := ف + 1;
    }
    (*الخريطة).العدد := 0;
    (*الخريطة).المحذوف := 0;
}

عام عرف أعد_ضبط_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>): فراغ {
    دع الهاش: دالة(&م): غير_موقع = (*الخريطة).الهاش;
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الجديدة: الخريطة<م, ق> = أنشئ_الخريطة(الهاش, التساوي);
    *الخريطة := الجديدة;
}

عام عرف مداخل_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): متجه مدخل_الخريطة<م, ق> {
    دع الناتج: متغير متجه مدخل_الخريطة<م, ق> = [];
    دع ف: متغير غير_موقع = 0;
    دع السعة: غير_موقع = الطول((*الخريطة).الخانات) مثل غير_موقع;
    بينما (ف < السعة) {
        طابق (*الخريطة).الخانات[ف] مع
        | خانة_الخريطة.مشغولة(_, فهرس_المدخل) -> {
            طابق (*الخريطة).المداخل[فهرس_المدخل].المفتاح مع
            | اختيار.بعض(المفتاح) -> {
                طابق (*الخريطة).المداخل[فهرس_المدخل].القيمة مع
                | اختيار.بعض(القيمة) -> {
                    دع المدخل: مدخل_الخريطة<م, ق> = { المفتاح: المفتاح, القيمة: القيمة };
                    ألحق(الناتج, المدخل);
                }
                | اختيار.لا_شيء -> { };
            }
            | اختيار.لا_شيء -> { };
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// English compatibility surface.
عام نوع map_bucket<K, V> = خانة_الخريطة<K, V>;
عام نوع map<K, V> = الخريطة<K, V>;
عام نوع map_entry<K, V> = مدخل_الخريطة<K, V>;
عام مرادف new_map = أنشئ_الخريطة;
عام مرادف new_map_with_capacity = أنشئ_الخريطة_بسعة;
عام مرادف map_insert = أدرج_في_الخريطة;
عام مرادف map_get = ابحث_في_الخريطة;
عام مرادف map_contains = تحتوي_الخريطة;
عام مرادف map_remove = احذف_من_الخريطة;
عام مرادف map_length = طول_الخريطة;
عام مرادف map_capacity = سعة_الخريطة;
عام مرادف map_reserve = احجز_للخريطة;
عام مرادف map_clear = امسح_الخريطة;
عام مرادف map_clear_retain_capacity = امسح_الخريطة;
عام مرادف map_reset = أعد_ضبط_الخريطة;
عام مرادف map_entries = مداخل_الخريطة;
