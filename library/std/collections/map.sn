// Canonical generic open-addressed hash map. Hash and equality policy are supplied
// by the caller; this module owns storage and probing only.
عام نوع خانة_خريطة<K, V> =
    | فارغة
    | محذوفة
    | مشغولة بنوع (غير_موقع, K, V)
;

عام نوع خريطة<K, V> = {
    الخانات: متجه خانة_خريطة<K, V>,
    العدد: غير_موقع,
    المحذوف: غير_موقع,
    الهاش: دالة(&K): غير_موقع,
    التساوي: دالة(&K, &K): منطقي
};

عام نوع مدخل_خريطة<K, V> = { المفتاح: K, القيمة: V };

عام عرف أنشئ_خريطة<K, V>(
    الهاش: دالة(&K): غير_موقع,
    التساوي: دالة(&K, &K): منطقي
): خريطة<K, V> {
    دع الخانات: متغير متجه خانة_خريطة<K, V> = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) { ألحق(الخانات, خانة_خريطة.فارغة()); ف := ف + 1; }
    دع الناتج: خريطة<K, V> = {
        الخانات: الخانات, العدد: 0, المحذوف: 0, الهاش: الهاش, التساوي: التساوي
    };
    أرجع الناتج;
}

عرف ابحث_خانة_عامة<K, V>(الخريطة: &خريطة<K, V>, المفتاح: &K, الهاش: غير_موقع): اختيار غير_موقع {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع السعة: غير_موقع = الطول(الحالة.الخانات) مثل غير_موقع;
    لو (السعة == 0) { أرجع اختيار.لا_شيء(); };
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        طابق الحالة.الخانات[الموضع] مع
        | خانة_خريطة.فارغة -> { أرجع اختيار.لا_شيء(); }
        | خانة_خريطة.محذوفة -> { }
        | خانة_خريطة.مشغولة(هاش_الخانة, مفتاح_الخانة, _) -> {
            لو (هاش_الخانة == الهاش) {
                دع نسخة_المفتاح: K = مفتاح_الخانة;
                لو (الحالة.التساوي(&نسخة_المفتاح, المفتاح)) { أرجع اختيار.بعض(الموضع); };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف موضع_إدخال_عام<K, V>(الخريطة: &خريطة<K, V>, المفتاح: &K, الهاش: غير_موقع): غير_موقع {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع السعة: غير_موقع = الطول(الحالة.الخانات) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = الهاش % السعة;
    دع أول_محذوف: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        طابق الحالة.الخانات[الموضع] مع
        | خانة_خريطة.فارغة -> {
            طابق أول_محذوف مع
            | اختيار.بعض(المحذوف) -> { أرجع المحذوف; }
            | اختيار.لا_شيء -> { أرجع الموضع; };
        }
        | خانة_خريطة.محذوفة -> {
            طابق أول_محذوف مع
            | اختيار.لا_شيء -> { أول_محذوف := اختيار.بعض(الموضع); }
            | اختيار.بعض(_) -> { };
        }
        | خانة_خريطة.مشغولة(هاش_الخانة, مفتاح_الخانة, _) -> {
            لو (هاش_الخانة == الهاش) {
                دع نسخة_المفتاح: K = مفتاح_الخانة;
                لو (الحالة.التساوي(&نسخة_المفتاح, المفتاح)) { أرجع الموضع; };
            };
        };
        الموضع := (الموضع + 1) % السعة;
        ف := ف + 1;
    }
    طابق أول_محذوف مع
    | اختيار.بعض(المحذوف) -> { أرجع المحذوف; }
    | اختيار.لا_شيء -> { أرجع 0; };
}

عرف أدرج_دون_نمو_عام<K, V>(
    الخريطة: &متغير خريطة<K, V>, المفتاح: K, القيمة: V, الهاش: غير_موقع
): اختيار V {
    دع الحالة: متغير خريطة<K, V> = *الخريطة;
    دع الموضع: غير_موقع = موضع_إدخال_عام(&الحالة, &المفتاح, الهاش);
    طابق الحالة.الخانات[الموضع] مع
    | خانة_خريطة.مشغولة(_, مفتاح_قديم, قيمة_قديمة) -> {
        دع نسخة_المفتاح: K = مفتاح_قديم;
        لو (الحالة.التساوي(&نسخة_المفتاح, &المفتاح)) {
            الحالة.الخانات[الموضع] := خانة_خريطة.مشغولة(الهاش, المفتاح, القيمة);
            *الخريطة := الحالة;
            أرجع اختيار.بعض(قيمة_قديمة);
        };
    }
    | خانة_خريطة.محذوفة -> { الحالة.المحذوف := الحالة.المحذوف - 1; }
    | خانة_خريطة.فارغة -> { };
    الحالة.الخانات[الموضع] := خانة_خريطة.مشغولة(الهاش, المفتاح, القيمة);
    الحالة.العدد := الحالة.العدد + 1;
    *الخريطة := الحالة;
    أرجع اختيار.لا_شيء();
}

عرف أعد_تجزئة_عامة<K, V>(الخريطة: &متغير خريطة<K, V>, السعة: غير_موقع): فراغ {
    دع القديمة: خريطة<K, V> = *الخريطة;
    دع الخانات_الجديدة: متغير متجه خانة_خريطة<K, V> = [];
    دع ت: متغير غير_موقع = 0;
    بينما (ت < السعة) { ألحق(الخانات_الجديدة, خانة_خريطة.فارغة()); ت := ت + 1; }
    دع الجديدة: متغير خريطة<K, V> = {
        الخانات: الخانات_الجديدة, العدد: 0, المحذوف: 0,
        الهاش: القديمة.الهاش, التساوي: القديمة.التساوي
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القديمة.الخانات) مثل غير_موقع)) {
        طابق القديمة.الخانات[ف] مع
        | خانة_خريطة.مشغولة(هاش_الخانة, المفتاح, القيمة) -> {
            أدرج_دون_نمو_عام(&متغير الجديدة, المفتاح, القيمة, هاش_الخانة);
        }
        | _ -> { };
        ف := ف + 1;
    }
    *الخريطة := الجديدة;
}

عرف ضمن_سعة_عامة<K, V>(الخريطة: &متغير خريطة<K, V>): فراغ {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع السعة: غير_موقع = الطول(الحالة.الخانات) مثل غير_موقع;
    لو (السعة == 0) { أعد_تجزئة_عامة(الخريطة, 8); أرجع; };
    دع المستعمل: غير_موقع = الحالة.العدد + الحالة.المحذوف + 1;
    لو ((المستعمل * 10) >= (السعة * 7)) { أعد_تجزئة_عامة(الخريطة, السعة * 2); };
}

عام عرف أدرج_في_خريطة<K, V>(الخريطة: &متغير خريطة<K, V>, المفتاح: K, القيمة: V): اختيار V {
    ضمن_سعة_عامة(الخريطة);
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع الهاش: غير_موقع = الحالة.الهاش(&المفتاح);
    أرجع أدرج_دون_نمو_عام(الخريطة, المفتاح, القيمة, الهاش);
}

عام عرف ابحث_في_خريطة<K, V>(الخريطة: &خريطة<K, V>, المفتاح: &K): اختيار V {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع الهاش: غير_موقع = الحالة.الهاش(المفتاح);
    طابق ابحث_خانة_عامة(الخريطة, المفتاح, الهاش) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        طابق الحالة.الخانات[الموضع] مع
        | خانة_خريطة.مشغولة(_, _, القيمة) -> { أرجع اختيار.بعض(القيمة); }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف تحتوي_خريطة<K, V>(الخريطة: &خريطة<K, V>, المفتاح: &K): منطقي {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع الهاش: غير_موقع = الحالة.الهاش(المفتاح);
    طابق ابحث_خانة_عامة(الخريطة, المفتاح, الهاش) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف احذف_من_خريطة<K, V>(الخريطة: &متغير خريطة<K, V>, المفتاح: &K): اختيار V {
    دع نسخة_الخريطة: خريطة<K, V> = *الخريطة;
    دع الهاش: غير_موقع = نسخة_الخريطة.الهاش(المفتاح);
    طابق ابحث_خانة_عامة(&نسخة_الخريطة, المفتاح, الهاش) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الموضع) -> {
        دع الحالة: متغير خريطة<K, V> = *الخريطة;
        طابق الحالة.الخانات[الموضع] مع
        | خانة_خريطة.مشغولة(_, _, القديمة) -> {
            الحالة.الخانات[الموضع] := خانة_خريطة.محذوفة();
            الحالة.العدد := الحالة.العدد - 1;
            الحالة.المحذوف := الحالة.المحذوف + 1;
            *الخريطة := الحالة;
            أرجع اختيار.بعض(القديمة);
        }
        | _ -> { أرجع اختيار.لا_شيء(); };
    };
}

عام عرف طول_خريطة<K, V>(الخريطة: &خريطة<K, V>): غير_موقع {
    دع الحالة: خريطة<K, V> = *الخريطة;
    أرجع الحالة.العدد;
}

عام عرف امسح_خريطة<K, V>(الخريطة: &متغير خريطة<K, V>): فراغ {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع الجديدة: خريطة<K, V> = أنشئ_خريطة(الحالة.الهاش, الحالة.التساوي);
    *الخريطة := الجديدة;
}

عام عرف مداخل_خريطة<K, V>(الخريطة: &خريطة<K, V>): متجه مدخل_خريطة<K, V> {
    دع الحالة: خريطة<K, V> = *الخريطة;
    دع الناتج: متغير متجه مدخل_خريطة<K, V> = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.الخانات) مثل غير_موقع)) {
        طابق الحالة.الخانات[ف] مع
        | خانة_خريطة.مشغولة(_, المفتاح, القيمة) -> {
            دع المدخل: مدخل_خريطة<K, V> = { المفتاح: المفتاح, القيمة: القيمة };
            ألحق(الناتج, المدخل);
        }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام نوع map_bucket<K, V> = خانة_خريطة<K, V>;
عام نوع map<K, V> = خريطة<K, V>;
عام نوع map_entry<K, V> = مدخل_خريطة<K, V>;
عام مرادف new_map = أنشئ_خريطة;
عام مرادف map_insert = أدرج_في_خريطة;
عام مرادف map_get = ابحث_في_خريطة;
عام مرادف map_contains = تحتوي_خريطة;
عام مرادف map_remove = احذف_من_خريطة;
عام مرادف map_length = طول_خريطة;
عام مرادف map_clear = امسح_خريطة;
عام مرادف map_entries = مداخل_خريطة;
