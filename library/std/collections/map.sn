// Canonical generic open-addressed hash map. Hash and equality policy are supplied
// by the caller; this module owns storage, probing, capacity, and tombstones.
//
// Buckets intentionally contain only cached hash/index metadata. Generic keys and
// values live in side storage so probing can compare a borrowed stored key without
// copying arbitrary generic payloads on every collision.
// Equal keys must have equal hashes, and neither hash nor equality may change
// while a key is stored. Violating that caller contract invalidates lookup.
//
// A bucket is one ط64 (8 bytes; the tagged bucket below took 24): the low 32
// bits of the caller's hash in the high half and the entry index + 1 in the
// low half. 0 is an empty bucket and 0xFFFFFFFF (index half all ones) a
// tombstone. The low hash bits pick the home bucket (capacities are powers
// of two, so the positions are those of the full hash) and filter equality
// calls. A map holds at most أقصى_مداخل_الخريطة entries (احجز_للخريطة), so
// every index + 1 fits below the tombstone.
//
// خانة_الخريطة is the earlier tagged bucket form, kept as a public type.
عام نوع خانة_الخريطة<م, ق> =
    | فارغة
    | محذوفة
    | مشغولة بنوع (طبيعي, طبيعي)
;

عام نوع مدخل_الخريطة<م, ق> = { المفتاح: م, القيمة: ق };

عام نوع الخريطة<م, ق> = {
    الخانات: متجه ط64,
    المداخل: متجه مدخل_الخريطة<اختياري م, اختياري ق>,
    // Free entry indices; an index is below أقصى_مداخل_الخريطة.
    المداخل_الحرة: متجه ط32,
    عدد_المداخل_الحرة: طبيعي,
    العدد: طبيعي,
    المحذوف: طبيعي,
    الهاش: دالة(&م): طبيعي,
    التساوي: دالة(&م, &م): منطقي
};

نوع نتيجة_مسبار_الخريطة = {
    الموضع: طبيعي,
    فهرس_المدخل: طبيعي,
    موجود: منطقي,
    يعيد_استخدام_محذوف: منطقي
};

نوع موضع_الخريطة = {
    الموضع: طبيعي,
    فهرس_المدخل: طبيعي
};

// The most entries a map holds: index + 1 stays below the tombstone.
عام عرف أقصى_مداخل_الخريطة(): طبيعي { أرجع 0xFFFFFFFE; }
عرف خانة_فارغة_الخريطة(): ط64 { أرجع 0; }
عرف خانة_محذوفة_الخريطة(): ط64 { أرجع 0xFFFFFFFF; }

// The hash bits a bucket keeps (the low 32: positions are taken modulo a
// power-of-two capacity, so they are the full hash's positions).
عرف وسم_هاش_الخريطة(الهاش: طبيعي): طبيعي { أرجع الهاش & 0xFFFFFFFF; }

// An occupied bucket for a hash tag and an entry index.
عرف خانة_مشغولة_الخريطة(الوسم: طبيعي, فهرس_المدخل: طبيعي): ط64 {
    أرجع ((الوسم << 32) | (فهرس_المدخل + 1)) مثل ط64;
}

// The entry index of a bucket, or أقصى_مداخل_الخريطة for an empty bucket
// or a tombstone.
عام عرف فهرس_خانة_الخريطة(الخانة: ط64): طبيعي {
    دع المنخفض: طبيعي = (الخانة مثل طبيعي) & 0xFFFFFFFF;
    إذا (المنخفض == 0 || المنخفض == 0xFFFFFFFF) { أرجع أقصى_مداخل_الخريطة(); };
    أرجع المنخفض - 1;
}

عرف سعة_خانات_للعدد(العدد: طبيعي): طبيعي {
    دع السعة: متغير طبيعي = 8;
    // Divide first for a non-overflowing 3/4 threshold. The final capacity
    // may stop being a power of two if doubling cannot represent it; probing
    // uses modulo and remains valid for any nonzero bucket count.
    دع الحد: طبيعي = ~((0 مثل طبيعي));
    طالما (العدد > ((السعة / 4) * 3)) {
        إذا (السعة > (الحد / 2)) { أرجع الحد; };
        السعة := السعة * 2;
    }
    أرجع السعة;
}

عرف ابن_خانات_الخريطة(السعة: طبيعي): متجه ط64 {
    دع الناتج: متغير متجه ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(الناتج, خانة_فارغة_الخريطة());
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أنشئ_الخريطة_بسعة<م, ق>(
    السعة_المتوقعة: طبيعي,
    الهاش: دالة(&م): طبيعي,
    التساوي: دالة(&م, &م): منطقي
): الخريطة<م, ق> {
    دع سعة_الخانات: طبيعي = سعة_خانات_للعدد(السعة_المتوقعة);
    دع الخانات: متجه ط64 = ابن_خانات_الخريطة(سعة_الخانات);
    دع المداخل: متجه مدخل_الخريطة<اختياري م, اختياري ق> = [];
    دع الحرة: متجه ط32 = [];
    دع الناتج: الخريطة<م, ق> = {
        الخانات: الخانات,
        المداخل: المداخل,
        المداخل_الحرة: الحرة,
        عدد_المداخل_الحرة: 0,
        العدد: 0,
        المحذوف: 0,
        الهاش: الهاش,
        التساوي: التساوي
    };
    أرجع الناتج;
}

عام عرف أنشئ_الخريطة<م, ق>(
    الهاش: دالة(&م): طبيعي,
    التساوي: دالة(&م, &م): منطقي
): الخريطة<م, ق> {
    أرجع أنشئ_الخريطة_بسعة(0, الهاش, التساوي);
}

عرف ابحث_عن_موضع_الخريطة<م, ق>(
    الخريطة: &الخريطة<م, ق>,
    المفتاح: &م,
    الهاش: طبيعي
): اختياري موضع_الخريطة {
    دع السعة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    إذا (السعة == 0) { أرجع اختياري.لا_شيء(); };
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        دع الخانة: طبيعي = (*الخريطة).الخانات[الموضع] مثل طبيعي;
        إذا (الخانة == 0) { أرجع اختياري.لا_شيء(); };
        دع المنخفض: طبيعي = الخانة & 0xFFFFFFFF;
        إذا (المنخفض != 0xFFFFFFFF && (الخانة >> 32) == الهاش) {
            دع فهرس_المدخل: طبيعي = المنخفض - 1;
            دع مرجع_المفتاح: &اختياري م = &(*الخريطة).المداخل[فهرس_المدخل].المفتاح;
            طابق *مرجع_المفتاح مع
            | اختياري.موجود(المفتاح_المخزن) -> {
                إذا (التساوي(&المفتاح_المخزن, المفتاح)) {
                    دع الناتج: موضع_الخريطة = {
                        الموضع: الموضع,
                        فهرس_المدخل: فهرس_المدخل
                    };
                    أرجع اختياري.موجود(الناتج);
                };
            }
            | اختياري.لا_شيء -> { };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف مسبار_إدخال_الخريطة<م, ق>(
    الخريطة: &الخريطة<م, ق>,
    المفتاح: &م,
    الهاش: طبيعي
): نتيجة_مسبار_الخريطة {
    دع السعة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الموضع: متغير طبيعي = الهاش % السعة;
    دع أول_محذوف: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        دع الخانة: طبيعي = (*الخريطة).الخانات[الموضع] مثل طبيعي;
        دع المنخفض: طبيعي = الخانة & 0xFFFFFFFF;
        إذا (الخانة == 0) {
            طابق أول_محذوف مع
            | اختياري.موجود(موضع_محذوف) -> {
                دع الناتج: نتيجة_مسبار_الخريطة = {
                    الموضع: موضع_محذوف,
                    فهرس_المدخل: 0,
                    موجود: خطأ,
                    يعيد_استخدام_محذوف: صواب
                };
                أرجع الناتج;
            }
            | اختياري.لا_شيء -> {
                دع الناتج: نتيجة_مسبار_الخريطة = {
                    الموضع: الموضع,
                    فهرس_المدخل: 0,
                    موجود: خطأ,
                    يعيد_استخدام_محذوف: خطأ
                };
                أرجع الناتج;
            };
        } وإلا إذا (المنخفض == 0xFFFFFFFF) {
            طابق أول_محذوف مع
            | اختياري.لا_شيء -> { أول_محذوف := اختياري.موجود(الموضع); }
            | اختياري.موجود(_) -> { };
        } وإلا إذا ((الخانة >> 32) == الهاش) {
            دع فهرس_المدخل: طبيعي = المنخفض - 1;
            دع مرجع_المفتاح: &اختياري م = &(*الخريطة).المداخل[فهرس_المدخل].المفتاح;
            طابق *مرجع_المفتاح مع
            | اختياري.موجود(المفتاح_المخزن) -> {
                إذا (التساوي(&المفتاح_المخزن, المفتاح)) {
                    دع الناتج: نتيجة_مسبار_الخريطة = {
                        الموضع: الموضع,
                        فهرس_المدخل: فهرس_المدخل,
                        موجود: صواب,
                        يعيد_استخدام_محذوف: خطأ
                    };
                    أرجع الناتج;
                };
            }
            | اختياري.لا_شيء -> { };
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
    طابق أول_محذوف مع
    | اختياري.موجود(موضع_محذوف) -> {
        دع الناتج: نتيجة_مسبار_الخريطة = {
            الموضع: موضع_محذوف,
            فهرس_المدخل: 0,
            موجود: خطأ,
            يعيد_استخدام_محذوف: صواب
        };
        أرجع الناتج;
    }
    | اختياري.لا_شيء -> {
        دع الناتج: نتيجة_مسبار_الخريطة = {
            الموضع: 0,
            فهرس_المدخل: 0,
            موجود: خطأ,
            يعيد_استخدام_محذوف: خطأ
        };
        أرجع الناتج;
    };
}

// Places an occupied bucket (its tag in the high half) into fresh buckets.
عرف أدرج_خانة_في_خانات(
    الخانات: &متغير متجه ط64,
    الخانة: ط64
): فراغ {
    دع السعة: طبيعي = الطول(*الخانات) مثل طبيعي;
    دع الموضع: متغير طبيعي = ((الخانة مثل طبيعي) >> 32) % السعة;
    دع المفحوص: متغير طبيعي = 0;
    طالما (المفحوص < السعة) {
        إذا ((*الخانات)[الموضع] == خانة_فارغة_الخريطة()) {
            (*الخانات)[الموضع] := الخانة;
            أرجع;
        };
        الموضع := (الموضع + 1) % السعة;
        المفحوص := المفحوص + 1;
    }
}

عرف أعد_تجزئة_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, السعة_المطلوبة: طبيعي): فراغ {
    دع السعة: متغير طبيعي = السعة_المطلوبة;
    إذا (السعة < 8) { السعة := 8; };
    دع الجديدة: متغير متجه ط64 = ابن_خانات_الخريطة(السعة);
    دع القديمة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < القديمة) {
        دع الخانة: ط64 = (*الخريطة).الخانات[ف];
        إذا (فهرس_خانة_الخريطة(الخانة) != أقصى_مداخل_الخريطة()) {
            أدرج_خانة_في_خانات(&متغير الجديدة, الخانة);
        };
        ف := ف + 1;
    }
    (*الخريطة).الخانات := الجديدة;
    (*الخريطة).المحذوف := 0;
}

عرف سجل_مدخلا_حرا<م, ق>(الخريطة: &متغير الخريطة<م, ق>, فهرس_المدخل: طبيعي): فراغ {
    دع الموضع: طبيعي = (*الخريطة).عدد_المداخل_الحرة;
    // An entry index is below أقصى_مداخل_الخريطة.
    إذا (الموضع < (الطول((*الخريطة).المداخل_الحرة) مثل طبيعي)) {
        (*الخريطة).المداخل_الحرة[الموضع] := فهرس_المدخل مثل ط32;
    } وإلا {
        ألحق((*الخريطة).المداخل_الحرة, فهرس_المدخل مثل ط32);
    };
    (*الخريطة).عدد_المداخل_الحرة := الموضع + 1;
}

عرف خذ_مدخلا_حرا<م, ق>(الخريطة: &متغير الخريطة<م, ق>): اختياري طبيعي {
    إذا ((*الخريطة).عدد_المداخل_الحرة == 0) { أرجع اختياري.لا_شيء(); };
    دع الموضع: طبيعي = (*الخريطة).عدد_المداخل_الحرة - 1;
    (*الخريطة).عدد_المداخل_الحرة := الموضع;
    أرجع اختياري.موجود((*الخريطة).المداخل_الحرة[الموضع] مثل طبيعي);
}

// False means the requested live count exceeds the entry limit
// (أقصى_مداخل_الخريطة: an entry index + 1 fits a bucket's low half). The
// map is unchanged on that failure. Allocation failure remains the backing
// vector's responsibility.
عام عرف احجز_للخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, إضافي: طبيعي): منطقي {
    دع الحد_الأقصى: طبيعي = أقصى_مداخل_الخريطة();
    إذا ((*الخريطة).العدد > الحد_الأقصى) { أرجع خطأ; };
    إذا (إضافي > (الحد_الأقصى - (*الخريطة).العدد)) { أرجع خطأ; };
    دع المطلوب_من_المداخل: طبيعي = (*الخريطة).العدد + إضافي;
    دع المطلوبة: طبيعي = سعة_خانات_للعدد(المطلوب_من_المداخل);
    دع الحالية: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    إذا (المطلوبة > الحالية) {
        أعد_تجزئة_الخريطة(الخريطة, المطلوبة);
        أرجع صواب;
    };
    إذا ((*الخريطة).المحذوف > 0) {
        دع المساحة_الحرة: طبيعي = ((الحالية / 4) * 3) - (*الخريطة).العدد;
        إذا ((*الخريطة).المحذوف > المساحة_الحرة) {
            أعد_تجزئة_الخريطة(الخريطة, الحالية);
        } وإلا إذا (إضافي > (المساحة_الحرة - (*الخريطة).المحذوف)) {
            أعد_تجزئة_الخريطة(الخريطة, الحالية);
        };
    };
    أرجع صواب;
}

عام عرف سعة_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): طبيعي {
    دع سعة_الخانات: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    أرجع (سعة_الخانات / 4) * 3;
}

// An inserted key returns نجح(لا_شيء); a replaced key returns its old value.
// A capacity failure returns خطأ without modifying buckets or owned entries.
// The old اختيار-only insertion return could not represent this failure.
عام نوع خطأ_إدراج_الخريطة =
    | سعة_غير_قابلة_للتمثيل
;

عام عرف أدرج_في_الخريطة<م, ق>(
    الخريطة: &متغير الخريطة<م, ق>,
    المفتاح: م,
    القيمة: ق
): نتيجة اختياري ق, خطأ_إدراج_الخريطة {
    دع دالة_الهاش: دالة(&م): طبيعي = (*الخريطة).الهاش;
    دع الهاش: طبيعي = وسم_هاش_الخريطة(دالة_الهاش(&المفتاح));
    دع المسبار: نتيجة_مسبار_الخريطة = مسبار_إدخال_الخريطة(الخريطة, &المفتاح, الهاش);

    // Replacing an existing key does not require an additional slot.
    إذا (المسبار.موجود) {
        دع الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
        بدّل((*الخريطة).المداخل[المسبار.فهرس_المدخل].القيمة, الجديدة);
        أرجع نتيجة.نجح(الجديدة);
    };

    // Reservation is the sole capacity/overflow check. Failure happens before
    // taking a free entry or writing keys, values, buckets, or the live count.
    إذا (!احجز_للخريطة(الخريطة, 1)) {
        أرجع نتيجة.خطأ(خطأ_إدراج_الخريطة.سعة_غير_قابلة_للتمثيل());
    };

    // Reservation may rehash (including compacting tombstones). The original
    // probe is therefore stale; resolve the new bucket before changing storage.
    دع موضع_الإدراج: نتيجة_مسبار_الخريطة = مسبار_إدخال_الخريطة(
        الخريطة, &المفتاح, الهاش
    );

    دع فهرس_المدخل: متغير طبيعي = 0;
    طابق خذ_مدخلا_حرا(الخريطة) مع
    | اختياري.موجود(الفهرس) -> {
        فهرس_المدخل := الفهرس;
        دع المفتاح_الجديد: متغير اختياري م = اختياري.موجود(المفتاح);
        دع القيمة_الجديدة: متغير اختياري ق = اختياري.موجود(القيمة);
        بدّل((*الخريطة).المداخل[الفهرس].المفتاح, المفتاح_الجديد);
        بدّل((*الخريطة).المداخل[الفهرس].القيمة, القيمة_الجديدة);
    }
    | اختياري.لا_شيء -> {
        فهرس_المدخل := الطول((*الخريطة).المداخل) مثل طبيعي;
        دع المدخل: مدخل_الخريطة<اختياري م, اختياري ق> = {
            المفتاح: اختياري.موجود(المفتاح),
            القيمة: اختياري.موجود(القيمة)
        };
        ألحق((*الخريطة).المداخل, المدخل);
    };

    (*الخريطة).الخانات[موضع_الإدراج.الموضع] := خانة_مشغولة_الخريطة(الهاش, فهرس_المدخل);
    إذا (موضع_الإدراج.يعيد_استخدام_محذوف) {
        (*الخريطة).المحذوف := (*الخريطة).المحذوف - 1;
    };
    // The checked reservation guarantees that increasing the count fits.
    (*الخريطة).العدد := (*الخريطة).العدد + 1;
    أرجع نتيجة.نجح(اختياري.لا_شيء());
}

عام عرف ابحث_في_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>, المفتاح: &م): اختياري ق {
    دع دالة_الهاش: دالة(&م): طبيعي = (*الخريطة).الهاش;
    دع الهاش: طبيعي = وسم_هاش_الخريطة(دالة_الهاش(المفتاح));
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموجود) -> {
        طابق (*الخريطة).المداخل[الموجود.فهرس_المدخل].القيمة مع
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
}

عام عرف تحتوي_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>, المفتاح: &م): منطقي {
    دع دالة_الهاش: دالة(&م): طبيعي = (*الخريطة).الهاش;
    دع الهاش: طبيعي = وسم_هاش_الخريطة(دالة_الهاش(المفتاح));
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف احذف_من_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>, المفتاح: &م): اختياري ق {
    دع دالة_الهاش: دالة(&م): طبيعي = (*الخريطة).الهاش;
    دع الهاش: طبيعي = وسم_هاش_الخريطة(دالة_الهاش(المفتاح));
    طابق ابحث_عن_موضع_الخريطة(الخريطة, المفتاح, الهاش) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموجود) -> {
        دع المفتاح_المحذوف: متغير اختياري م = اختياري.لا_شيء();
        دع القيمة_المحذوفة: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الخريطة).المداخل[الموجود.فهرس_المدخل].المفتاح, المفتاح_المحذوف);
        بدّل((*الخريطة).المداخل[الموجود.فهرس_المدخل].القيمة, القيمة_المحذوفة);
        (*الخريطة).الخانات[الموجود.الموضع] := خانة_محذوفة_الخريطة();
        (*الخريطة).العدد := (*الخريطة).العدد - 1;
        (*الخريطة).المحذوف := (*الخريطة).المحذوف + 1;
        سجل_مدخلا_حرا(الخريطة, الموجود.فهرس_المدخل);
        أرجع القيمة_المحذوفة;
    };
}

عام عرف طول_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): طبيعي {
    أرجع (*الخريطة).العدد;
}

// Clear releases every live generic payload while retaining reusable bucket
// and side-entry storage. Every side slot becomes owner-empty and reusable.
عام عرف امسح_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>): فراغ {
    دع ف: متغير طبيعي = 0;
    دع السعة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    طالما (ف < السعة) {
        (*الخريطة).الخانات[ف] := خانة_فارغة_الخريطة();
        ف := ف + 1;
    }

    (*الخريطة).عدد_المداخل_الحرة := 0;
    ف := 0;
    دع عدد_المداخل: طبيعي = الطول((*الخريطة).المداخل) مثل طبيعي;
    طالما (ف < عدد_المداخل) {
        دع المفتاح_المزال: متغير اختياري م = اختياري.لا_شيء();
        دع القيمة_المزالة: متغير اختياري ق = اختياري.لا_شيء();
        بدّل((*الخريطة).المداخل[ف].المفتاح, المفتاح_المزال);
        بدّل((*الخريطة).المداخل[ف].القيمة, القيمة_المزالة);
        سجل_مدخلا_حرا(الخريطة, ف);
        ف := ف + 1;
    }
    (*الخريطة).العدد := 0;
    (*الخريطة).المحذوف := 0;
}

عام عرف أعد_ضبط_الخريطة<م, ق>(الخريطة: &متغير الخريطة<م, ق>): فراغ {
    دع الهاش: دالة(&م): طبيعي = (*الخريطة).الهاش;
    دع التساوي: دالة(&م, &م): منطقي = (*الخريطة).التساوي;
    دع الجديدة: الخريطة<م, ق> = أنشئ_الخريطة(الهاش, التساوي);
    *الخريطة := الجديدة;
}

عام عرف مداخل_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): متجه مدخل_الخريطة<م, ق> {
    دع الناتج: متغير متجه مدخل_الخريطة<م, ق> = [];
    دع ف: متغير طبيعي = 0;
    دع السعة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    طالما (ف < السعة) {
        دع فهرس_المدخل: طبيعي = فهرس_خانة_الخريطة((*الخريطة).الخانات[ف]);
        إذا (فهرس_المدخل != أقصى_مداخل_الخريطة()) {
            طابق (*الخريطة).المداخل[فهرس_المدخل].المفتاح مع
            | اختياري.موجود(المفتاح) -> {
                طابق (*الخريطة).المداخل[فهرس_المدخل].القيمة مع
                | اختياري.موجود(القيمة) -> {
                    دع المدخل: مدخل_الخريطة<م, ق> = { المفتاح: المفتاح, القيمة: القيمة };
                    ألحق(الناتج, المدخل);
                }
                | اختياري.لا_شيء -> { };
            }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Materialize live keys directly from the canonical bucket/index owner.
// No intermediate key/value entry vector is needed by set-values callers.
عام عرف مفاتيح_الخريطة<م, ق>(الخريطة: &الخريطة<م, ق>): متجه م {
    دع الناتج: متغير متجه م = [];
    دع ف: متغير طبيعي = 0;
    دع السعة: طبيعي = الطول((*الخريطة).الخانات) مثل طبيعي;
    طالما (ف < السعة) {
        دع فهرس_المدخل: طبيعي = فهرس_خانة_الخريطة((*الخريطة).الخانات[ف]);
        إذا (فهرس_المدخل != أقصى_مداخل_الخريطة()) {
            طابق (*الخريطة).المداخل[فهرس_المدخل].المفتاح مع
            | اختياري.موجود(المفتاح) -> { ألحق(الناتج, المفتاح); }
            | اختياري.لا_شيء -> { };
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// English compatibility surface.
عام نوع map_bucket<K, V> = خانة_الخريطة<K, V>;
عام نوع map<K, V> = الخريطة<K, V>;
عام نوع map_entry<K, V> = مدخل_الخريطة<K, V>;
عام مرادف new_map = أنشئ_الخريطة;
عام مرادف new_map_with_capacity = أنشئ_الخريطة_بسعة;
عام مرادف map_insert = أدرج_في_الخريطة;
عام مرادف map_get = ابحث_في_الخريطة;
عام مرادف map_contains = تحتوي_الخريطة;
عام مرادف map_remove = احذف_من_الخريطة;
عام مرادف map_length = طول_الخريطة;
عام مرادف map_capacity = سعة_الخريطة;
عام مرادف map_reserve = احجز_للخريطة;
عام مرادف map_clear = امسح_الخريطة;
عام مرادف map_clear_retain_capacity = امسح_الخريطة;
عام مرادف map_reset = أعد_ضبط_الخريطة;
عام مرادف map_entries = مداخل_الخريطة;
عام مرادف map_keys = مفاتيح_الخريطة;
