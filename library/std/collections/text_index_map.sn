استورد text.compare;
استورد hash.fnv;
استورد collections.map;
استورد collections.set;

// Text-specialized compatibility surface backed by the canonical generic map/set engine.
عام نوع خانة_خريطة_نص_فهرس = خانة_الخريطة<نص, غير_موقع>;
عام نوع خريطة_نص_فهرس = الخريطة<نص, غير_موقع>;
عام نوع مدخل_خريطة_نص_فهرس = مدخل_الخريطة<نص, غير_موقع>;
عام نوع مجموعة_نص = مجموعة<نص>;

// Text keys use the canonical byte-wise deterministic hash implementation.
عرف هاش_نص_فهرس(المفتاح: &نص): غير_موقع {
    أرجع هاش_فنڤ1أ_غير_موقع_للنص(المفتاح);
}

عام عرف أنشئ_خريطة_نص_فهرس(): خريطة_نص_فهرس {
    دع الناتج: خريطة_نص_فهرس = أنشئ_الخريطة(هاش_نص_فهرس, نصان_متساويان);
    أرجع الناتج;
}

عام عرف أدرج_في_خريطة_نص_فهرس(
    الخريطة: &متغير خريطة_نص_فهرس,
    المفتاح: نص,
    القيمة: غير_موقع
): نتيجة اختيار غير_موقع, خطأ_إدراج_الخريطة {
    أرجع أدرج_في_الخريطة(الخريطة, المفتاح, القيمة);
}

عام عرف ابحث_في_خريطة_نص_فهرس(
    الخريطة: &خريطة_نص_فهرس,
    المفتاح: &نص
): اختيار غير_موقع {
    أرجع ابحث_في_الخريطة(الخريطة, المفتاح);
}

عام عرف تحتوي_خريطة_نص_فهرس(الخريطة: &خريطة_نص_فهرس, المفتاح: &نص): منطقي {
    أرجع تحتوي_الخريطة(الخريطة, المفتاح);
}

عام عرف احذف_من_خريطة_نص_فهرس(
    الخريطة: &متغير خريطة_نص_فهرس,
    المفتاح: &نص
): اختيار غير_موقع {
    أرجع احذف_من_الخريطة(الخريطة, المفتاح);
}

عام عرف طول_خريطة_نص_فهرس(الخريطة: &خريطة_نص_فهرس): غير_موقع {
    أرجع طول_الخريطة(الخريطة);
}

عام عرف امسح_خريطة_نص_فهرس(الخريطة: &متغير خريطة_نص_فهرس): فراغ {
    امسح_الخريطة(الخريطة);
}

عام عرف مداخل_خريطة_نص_فهرس(الخريطة: &خريطة_نص_فهرس): متجه مدخل_خريطة_نص_فهرس {
    أرجع مداخل_الخريطة(الخريطة);
}

عام مرادف text_index_map_bucket = خانة_خريطة_نص_فهرس;
عام مرادف text_index_map = خريطة_نص_فهرس;
عام مرادف text_index_map_entry = مدخل_خريطة_نص_فهرس;
عام مرادف new_text_index_map = أنشئ_خريطة_نص_فهرس;
عام مرادف text_index_map_insert = أدرج_في_خريطة_نص_فهرس;
عام مرادف text_index_map_get = ابحث_في_خريطة_نص_فهرس;
عام مرادف text_index_map_contains = تحتوي_خريطة_نص_فهرس;
عام مرادف text_index_map_remove = احذف_من_خريطة_نص_فهرس;
عام مرادف text_index_map_length = طول_خريطة_نص_فهرس;
عام مرادف text_index_map_clear = امسح_خريطة_نص_فهرس;
عام مرادف text_index_map_entries = مداخل_خريطة_نص_فهرس;

عام عرف أنشئ_مجموعة_نص(): مجموعة_نص {
    دع الناتج: مجموعة_نص = أنشئ_مجموعة(هاش_نص_فهرس, نصان_متساويان);
    أرجع الناتج;
}

عام عرف أضف_إلى_مجموعة_نص(
    المجموعة: &متغير مجموعة_نص,
    القيمة: نص
): نتيجة منطقي, خطأ_إدراج_الخريطة {
    أرجع أضف_إلى_مجموعة(المجموعة, القيمة);
}

عام عرف تحتوي_مجموعة_نص(المجموعة: &مجموعة_نص, القيمة: &نص): منطقي {
    أرجع تحتوي_مجموعة(المجموعة, القيمة);
}

عام عرف احذف_من_مجموعة_نص(المجموعة: &متغير مجموعة_نص, القيمة: &نص): منطقي {
    أرجع احذف_من_مجموعة(المجموعة, القيمة);
}

عام عرف طول_مجموعة_نص(المجموعة: &مجموعة_نص): غير_موقع {
    أرجع طول_مجموعة(المجموعة);
}

عام عرف امسح_مجموعة_نص(المجموعة: &متغير مجموعة_نص): فراغ {
    امسح_مجموعة(المجموعة);
}

عام عرف قيم_مجموعة_نص(المجموعة: &مجموعة_نص): متجه نص {
    أرجع قيم_مجموعة(المجموعة);
}

عام مرادف text_set = مجموعة_نص;
عام مرادف new_text_set = أنشئ_مجموعة_نص;
عام مرادف text_set_insert = أضف_إلى_مجموعة_نص;
عام مرادف text_set_contains = تحتوي_مجموعة_نص;
عام مرادف text_set_remove = احذف_من_مجموعة_نص;
عام مرادف text_set_length = طول_مجموعة_نص;
عام مرادف text_set_clear = امسح_مجموعة_نص;
عام مرادف text_set_values = قيم_مجموعة_نص;
