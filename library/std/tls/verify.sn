// Certificate path building and validation for TLS (RFC 5280 section 6,
// profiled as Go crypto/x509 and webpki do for the Web PKI) and server
// identity checks (RFC 6125 / RFC 9525).
//
// A path is built depth-first from the leaf through the peer-supplied
// intermediates to a trust anchor, matching issuer and subject names
// byte-for-byte and verifying every signature. Each certificate must be
// within its validity period, free of unhandled critical extensions, and
// (when it issues) a CA with keyCertSign and a satisfied path length. The
// extended key usage must permit the requested purpose along the whole path,
// and DNS/IP name constraints are enforced. There is no fallback: any
// failure rejects the peer.

استورد chars.ascii;
استورد crypto.words;
استورد tls.x509;

عام نوع غرض_تحقق_تي_إل_إس =
    | غرض_خادم
    | غرض_عميل
;

عام نوع نتيجة_تحقق_شهادة_تي_إل_إس =
    | سلسلة_موثوقة
    | لا_مسار_موثوق
    | شهادة_منتهية
    | اسم_غير_مطابق
    | شهادة_تالفة
;

عرف بايت_تحقق(النص: نص): غ8 {
    أرجع النص[0];
}

عرف تسميات_تحقق(الاسم: &متجه غ8): متجه متجه غ8 {
    دع نقطة: غ8 = بايت_تحقق(«.»);
    دع التسميات: متغير متجه متجه غ8 = [];
    دع الحالية: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الاسم) مثل غير_موقع)) {
        دع ب: غ8 = (*الاسم)[ف];
        لو (ب == نقطة) {
            ألحق(التسميات, الحالية);
            دع فارغة: متجه غ8 = [];
            الحالية := فارغة;
        } وإلا {
            ألحق(الحالية, إلى_صغير_أسكي(ب));
        };
        ف := ف + 1;
    }
    ألحق(التسميات, الحالية);
    أرجع التسميات;
}

// A host name usable as a reference identifier: ASCII letters, digits,
// hyphens and dots, non-empty labels, at most 253 bytes, one optional
// trailing dot removed by the caller.
عرف اسم_مضيف_صالح_تحقق(الاسم: &متجه غ8): منطقي {
    دع الحجم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    لو (الحجم == 0 || الحجم > 253) { أرجع خطأ; };
    دع شرطة: غ8 = بايت_تحقق(«-»);
    دع نقطة: غ8 = بايت_تحقق(«.»);
    دع طول_التسمية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع ب: غ8 = (*الاسم)[ف];
        لو (ب == نقطة) {
            لو (طول_التسمية == 0) { أرجع خطأ; };
            طول_التسمية := 0;
        } وإلا {
            دع حرف_صالح: منطقي = حرف_أو_رقم_أسكي(ب) || ب == شرطة;
            لو (!حرف_صالح) { أرجع خطأ; };
            طول_التسمية := طول_التسمية + 1;
            لو (طول_التسمية > 63) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع طول_التسمية > 0;
}

// RFC 6125 6.4.3 as profiled by RFC 9525 / Go: the wildcard may only be
// the complete left-most label and matches exactly one label; the pattern
// must keep at least two further labels.
عرف اسم_يطابق_نمطا_تحقق(النمط: &متجه غ8, الاسم: &متجه غ8): منطقي {
    دع نجمة: غ8 = بايت_تحقق(«*»);
    دع أ: متجه متجه غ8 = تسميات_تحقق(النمط);
    دع ب: متجه متجه غ8 = تسميات_تحقق(الاسم);
    دع عدد_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    لو (عدد_أ != (الطول(ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_أ) {
        دع بري: منطقي = ف == 0 && (الطول(أ[0]) مثل غير_موقع) == 1 && أ[0][0] == نجمة;
        لو (بري) {
            لو (عدد_أ < 3 || (الطول(ب[0]) مثل غير_موقع) == 0) { أرجع خطأ; };
        } وإلا {
            لو ((الطول(أ[ف]) مثل غير_موقع) == 0) { أرجع خطأ; };
            لو (!متساويان_تحقق(&أ[ف], &ب[ف])) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف متساويان_تحقق(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع الحجم: غير_موقع = الطول(*أ) مثل غير_موقع;
    لو (الحجم != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// IPv4 dotted-quad or IPv6 text as 4 or 16 address bytes; none for a DNS name.
عام عرف عنوان_آي_بي_مضيف_تي_إل_إس(الاسم: &متجه غ8): اختيار متجه غ8 {
    دع نقطة: غ8 = بايت_تحقق(«.»);
    دع نقطتان: غ8 = بايت_تحقق(«:»);
    دع الحجم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    دع فيه_نقطتان: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        لو ((*الاسم)[ف] == نقطتان) { فيه_نقطتان := صواب; };
        ف := ف + 1;
    }
    لو (فيه_نقطتان) { أرجع عنوان_آي_بي6_من_نص_تحقق(الاسم); };
    // IPv4: exactly four decimal octets without leading zeros.
    دع الناتج: متغير متجه غ8 = [];
    دع القيمة: متغير غير_موقع = 0;
    دع الأرقام: متغير غير_موقع = 0;
    ف := 0;
    بينما (ف < الحجم) {
        دع ب: غ8 = (*الاسم)[ف];
        لو (ب == نقطة) {
            لو (الأرقام == 0) { أرجع اختيار.لا_شيء(); };
            ألحق(الناتج, القيمة مثل غ8);
            القيمة := 0;
            الأرقام := 0;
        } وإلا لو (رقم_عشري(ب)) {
            لو (الأرقام > 0 && القيمة == 0) { أرجع اختيار.لا_شيء(); };
            القيمة := القيمة * 10 + (قيمة_رقم_أسكي(ب) مثل غير_موقع);
            الأرقام := الأرقام + 1;
            لو (القيمة > 255) { أرجع اختيار.لا_شيء(); };
        } وإلا {
            أرجع اختيار.لا_شيء();
        };
        ف := ف + 1;
    }
    لو (الأرقام == 0) { أرجع اختيار.لا_شيء(); };
    ألحق(الناتج, القيمة مثل غ8);
    لو ((الطول(الناتج) مثل غير_موقع) != 4) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الناتج);
}

// IPv6 text (RFC 4291 2.2 forms 1 and 2; an embedded IPv4 tail is refused).
عرف عنوان_آي_بي6_من_نص_تحقق(الاسم: &متجه غ8): اختيار متجه غ8 {
    دع نقطتان: غ8 = بايت_تحقق(«:»);
    دع الحجم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    دع القبل: متغير متجه غير_موقع = [];
    دع البعد: متغير متجه غير_موقع = [];
    دع بعد_الضغط: متغير منطقي = خطأ;
    دع القيمة: متغير غير_موقع = 0;
    دع الأرقام: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    لو (الحجم >= 2 && (*الاسم)[0] == نقطتان && (*الاسم)[1] == نقطتان) {
        بعد_الضغط := صواب;
        ف := 2;
    } وإلا لو (الحجم >= 1 && (*الاسم)[0] == نقطتان) {
        أرجع اختيار.لا_شيء();
    };
    بينما (ف < الحجم) {
        لو ((*الاسم)[ف] == نقطتان) {
            لو (الأرقام == 0) {
                لو (بعد_الضغط) { أرجع اختيار.لا_شيء(); };
                بعد_الضغط := صواب;
            } وإلا {
                لو (بعد_الضغط) { ألحق(البعد, القيمة); } وإلا { ألحق(القبل, القيمة); };
                لو (ف + 1 < الحجم && (*الاسم)[ف + 1] == نقطتان) {
                    لو (بعد_الضغط) { أرجع اختيار.لا_شيء(); };
                    بعد_الضغط := صواب;
                    ف := ف + 1;
                } وإلا لو (ف + 1 == الحجم) {
                    أرجع اختيار.لا_شيء();
                };
            };
            القيمة := 0;
            الأرقام := 0;
        } وإلا {
            دع ر: عدد = قيمة_سداسية((*الاسم)[ف]);
            لو (ر < 0) { أرجع اختيار.لا_شيء(); };
            القيمة := القيمة * 16 + (ر مثل غير_موقع);
            الأرقام := الأرقام + 1;
            لو (الأرقام > 4) { أرجع اختيار.لا_شيء(); };
        };
        ف := ف + 1;
    }
    لو (الأرقام > 0) {
        لو (بعد_الضغط) { ألحق(البعد, القيمة); } وإلا { ألحق(القبل, القيمة); };
    };
    دع المجموع: غير_موقع = (الطول(القبل) مثل غير_موقع) + (الطول(البعد) مثل غير_موقع);
    لو ((!بعد_الضغط && المجموع != 8) || (بعد_الضغط && المجموع > 7)) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < (الطول(القبل) مثل غير_موقع)) {
        ألحق(الناتج, (القبل[ف] >> 8) مثل غ8);
        ألحق(الناتج, (القبل[ف] & 0xFF) مثل غ8);
        ف := ف + 1;
    }
    ف := المجموع;
    بينما (ف < 8) {
        ألحق(الناتج, 0 مثل غ8);
        ألحق(الناتج, 0 مثل غ8);
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(البعد) مثل غير_موقع)) {
        ألحق(الناتج, (البعد[ف] >> 8) مثل غ8);
        ألحق(الناتج, (البعد[ف] & 0xFF) مثل غ8);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف بلا_نقطة_ختامية_تحقق(الاسم: &متجه غ8): متجه غ8 {
    دع نقطة: غ8 = بايت_تحقق(«.»);
    دع الحجم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    لو (الحجم > 0 && (*الاسم)[الحجم - 1] == نقطة) {
        أرجع شريحة_بايتات_تشفير(الاسم, 0, الحجم - 1);
    };
    أرجع *الاسم;
}

// Server identity (RFC 9525 6.3): a DNS reference identity matches a SAN
// dNSName, an IP literal matches a SAN iPAddress. The subject common name is
// never consulted.
عام عرف شهادة_تطابق_المضيف_تي_إل_إس(الشهادة: &شهادة_إكس509, المضيف: &متجه غ8): منطقي {
    طابق عنوان_آي_بي_مضيف_تي_إل_إس(المضيف) مع
    | اختيار.بعض(العنوان) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول((*الشهادة).عناوين_آي_بي) مثل غير_موقع)) {
            لو (متساويان_تحقق(&(*الشهادة).عناوين_آي_بي[ف], &العنوان)) { أرجع صواب; };
            ف := ف + 1;
        }
        أرجع خطأ;
    }
    | اختيار.لا_شيء -> { };
    دع الاسم: متجه غ8 = بلا_نقطة_ختامية_تحقق(المضيف);
    لو (!اسم_مضيف_صالح_تحقق(&الاسم)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الشهادة).أسماء_النطاق) مثل غير_موقع)) {
        دع النمط: متجه غ8 = بلا_نقطة_ختامية_تحقق(&(*الشهادة).أسماء_النطاق[ف]);
        لو (اسم_يطابق_نمطا_تحقق(&النمط, &الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// dNSName constraint matching (RFC 5280 4.2.1.10): the name equals the
// constraint or ends with "." followed by it; a leading "." in the
// constraint requires at least one further label.
عرف اسم_ضمن_قيد_تحقق(الاسم: &متجه غ8, القيد: &متجه غ8): منطقي {
    دع نقطة: غ8 = بايت_تحقق(«.»);
    دع حجم_القيد: غير_موقع = الطول(*القيد) مثل غير_موقع;
    لو (حجم_القيد == 0) { أرجع صواب; };
    دع حجم_الاسم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    لو (حجم_الاسم < حجم_القيد) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < حجم_القيد) {
        دع س: غ8 = إلى_صغير_أسكي((*الاسم)[حجم_الاسم - حجم_القيد + ف]);
        دع ص: غ8 = إلى_صغير_أسكي((*القيد)[ف]);
        لو (س != ص) { أرجع خطأ; };
        ف := ف + 1;
    }
    لو ((*القيد)[0] == نقطة) { أرجع حجم_الاسم > حجم_القيد; };
    لو (حجم_الاسم == حجم_القيد) { أرجع صواب; };
    أرجع (*الاسم)[حجم_الاسم - حجم_القيد - 1] == نقطة;
}

عرف عنوان_ضمن_قيد_تحقق(العنوان: &متجه غ8, القيد: &قيد_اسم_إكس509): منطقي {
    دع الحجم: غير_موقع = الطول(*العنوان) مثل غير_موقع;
    لو (الحجم != (الطول((*القيد).القيمة) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع قناع: غير_موقع = (*القيد).القناع[ف] مثل غير_موقع;
        لو ((((*العنوان)[ف] مثل غير_موقع) & قناع) != (((*القيد).القيمة[ف] مثل غير_موقع) & قناع)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The leaf names must satisfy the constraints of one CA in the path.
عرف أسماء_تحترم_القيود_تحقق(الورقة: &شهادة_إكس509, السلطة: &شهادة_إكس509): منطقي {
    دع عدد_المسموحة: غير_موقع = الطول((*السلطة).قيود_مسموحة) مثل غير_موقع;
    دع عدد_المستبعدة: غير_موقع = الطول((*السلطة).قيود_مستبعدة) مثل غير_موقع;
    لو (عدد_المسموحة == 0 && عدد_المستبعدة == 0) { أرجع صواب; };
    دع فيه_نطاق_مسموح: متغير منطقي = خطأ;
    دع فيه_عنوان_مسموح: متغير منطقي = خطأ;
    دع م: متغير غير_موقع = 0;
    بينما (م < عدد_المسموحة) {
        لو ((*السلطة).قيود_مسموحة[م].نطاق) { فيه_نطاق_مسموح := صواب; } وإلا { فيه_عنوان_مسموح := صواب; };
        م := م + 1;
    }
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الورقة).أسماء_النطاق) مثل غير_موقع)) {
        دع الاسم: متجه غ8 = بلا_نقطة_ختامية_تحقق(&(*الورقة).أسماء_النطاق[ف]);
        م := 0;
        بينما (م < عدد_المستبعدة) {
            لو ((*السلطة).قيود_مستبعدة[م].نطاق && اسم_ضمن_قيد_تحقق(&الاسم, &(*السلطة).قيود_مستبعدة[م].القيمة)) { أرجع خطأ; };
            م := م + 1;
        }
        لو (فيه_نطاق_مسموح) {
            دع مسموح: متغير منطقي = خطأ;
            م := 0;
            بينما (م < عدد_المسموحة) {
                لو ((*السلطة).قيود_مسموحة[م].نطاق && اسم_ضمن_قيد_تحقق(&الاسم, &(*السلطة).قيود_مسموحة[م].القيمة)) { مسموح := صواب; };
                م := م + 1;
            }
            لو (!مسموح) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول((*الورقة).عناوين_آي_بي) مثل غير_موقع)) {
        دع العنوان: &متجه غ8 = &(*الورقة).عناوين_آي_بي[ف];
        م := 0;
        بينما (م < عدد_المستبعدة) {
            لو (!(*السلطة).قيود_مستبعدة[م].نطاق && عنوان_ضمن_قيد_تحقق(العنوان, &(*السلطة).قيود_مستبعدة[م])) { أرجع خطأ; };
            م := م + 1;
        }
        لو (فيه_عنوان_مسموح) {
            دع مسموح: متغير منطقي = خطأ;
            م := 0;
            بينما (م < عدد_المسموحة) {
                لو (!(*السلطة).قيود_مسموحة[م].نطاق && عنوان_ضمن_قيد_تحقق(العنوان, &(*السلطة).قيود_مسموحة[م])) { مسموح := صواب; };
                م := م + 1;
            }
            لو (!مسموح) { أرجع خطأ; };
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف صالحة_زمنيا_تحقق(الشهادة: &شهادة_إكس509, الآن: عدد): منطقي {
    أرجع الآن >= (*الشهادة).ليس_قبل && الآن <= (*الشهادة).ليس_بعد;
}

عرف تسمح_بالغرض_تحقق(الشهادة: &شهادة_إكس509, الغرض: غرض_تحقق_تي_إل_إس): منطقي {
    لو (!(*الشهادة).له_استخدام_ممتد) { أرجع صواب; };
    طابق الغرض مع
    | غرض_تحقق_تي_إل_إس.غرض_خادم -> { أرجع (*الشهادة).استخدام_خادم; }
    | غرض_تحقق_تي_إل_إس.غرض_عميل -> { أرجع (*الشهادة).استخدام_عميل; };
}

// Checks for a certificate used to issue another one at path depth
// العمق (the number of non-self-issued intermediates below it).
عرف سلطة_صالحة_تحقق(الشهادة: &شهادة_إكس509, العمق: عدد): منطقي {
    لو ((*الشهادة).الإصدار == 3) {
        لو (!(*الشهادة).له_قيود_أساسية || !(*الشهادة).سلطة) { أرجع خطأ; };
    } وإلا {
        // v1/v2 certificates cannot assert CA status (Go and webpki refuse them).
        أرجع خطأ;
    };
    لو ((*الشهادة).له_استخدام_المفتاح && ((*الشهادة).استخدام_المفتاح & استخدام_توقيع_شهادات_إكس509()) == 0) { أرجع خطأ; };
    لو ((*الشهادة).حد_المسار >= 0 && العمق > (*الشهادة).حد_المسار) { أرجع خطأ; };
    أرجع صواب;
}

// Depth-first search for an issuer chain ending at an anchor. المسار holds
// the indices of the intermediates already on the path (cycle guard).
عرف ابحث_عن_مسار_تحقق(
    الحالية: &شهادة_إكس509,
    الورقة: &شهادة_إكس509,
    الوسيطة: &متجه شهادة_إكس509,
    الجذور: &متجه شهادة_إكس509,
    المسار: &متغير متجه غير_موقع,
    الآن: عدد,
    الغرض: غرض_تحقق_تي_إل_إس,
    العمق: عدد
): منطقي {
    لو (العمق > 8) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الجذور) مثل غير_موقع)) {
        دع الجذر: &شهادة_إكس509 = &(*الجذور)[ف];
        لو (متساويان_تحقق(&(*الجذر).الموضوع, &(*الحالية).المصدر)
            && سلطة_صالحة_تحقق(الجذر, العمق)
            && صالحة_زمنيا_تحقق(الجذر, الآن)
            && !(*الجذر).امتداد_حرج_غير_معالج
            && تسمح_بالغرض_تحقق(الجذر, الغرض)
            && أسماء_تحترم_القيود_تحقق(الورقة, الجذر)
            && تحقق_توقيع_شهادة_إكس509(الحالية, الجذر)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < (الطول(*الوسيطة) مثل غير_موقع)) {
        دع مستعملة: متغير منطقي = خطأ;
        دع م: متغير غير_موقع = 0;
        بينما (م < (الطول(*المسار) مثل غير_موقع)) {
            لو ((*المسار)[م] == ف) { مستعملة := صواب; };
            م := م + 1;
        }
        دع المرشح: &شهادة_إكس509 = &(*الوسيطة)[ف];
        لو (!مستعملة
            && متساويان_تحقق(&(*المرشح).الموضوع, &(*الحالية).المصدر)
            && سلطة_صالحة_تحقق(المرشح, العمق)
            && صالحة_زمنيا_تحقق(المرشح, الآن)
            && !(*المرشح).امتداد_حرج_غير_معالج
            && تسمح_بالغرض_تحقق(المرشح, الغرض)
            && أسماء_تحترم_القيود_تحقق(الورقة, المرشح)
            && تحقق_توقيع_شهادة_إكس509(الحالية, المرشح)) {
            ألحق(*المسار, ف);
            لو (ابحث_عن_مسار_تحقق(المرشح, الورقة, الوسيطة, الجذور, المسار, الآن, الغرض, العمق + 1)) {
                أرجع صواب;
            };
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Validates the peer chain (leaf first, then whatever intermediates the peer
// sent, in any order) against the trust anchors at time الآن (Unix seconds).
// When المضيف is non-empty the leaf must also identify that host.
عام عرف تحقق_سلسلة_شهادات_تي_إل_إس(
    السلسلة: &متجه شهادة_إكس509,
    الجذور: &متجه شهادة_إكس509,
    المضيف: &متجه غ8,
    الآن: عدد,
    الغرض: غرض_تحقق_تي_إل_إس
): نتيجة_تحقق_شهادة_تي_إل_إس {
    لو ((الطول(*السلسلة) مثل غير_موقع) == 0) { أرجع نتيجة_تحقق_شهادة_تي_إل_إس.شهادة_تالفة(); };
    دع الورقة: &شهادة_إكس509 = &(*السلسلة)[0];
    لو ((*الورقة).امتداد_حرج_غير_معالج) { أرجع نتيجة_تحقق_شهادة_تي_إل_إس.شهادة_تالفة(); };
    لو (!صالحة_زمنيا_تحقق(الورقة, الآن)) { أرجع نتيجة_تحقق_شهادة_تي_إل_إس.شهادة_منتهية(); };
    لو (!تسمح_بالغرض_تحقق(الورقة, الغرض)) { أرجع نتيجة_تحقق_شهادة_تي_إل_إس.لا_مسار_موثوق(); };
    لو ((الطول(*المضيف) مثل غير_موقع) > 0 && !شهادة_تطابق_المضيف_تي_إل_إس(الورقة, المضيف)) {
        أرجع نتيجة_تحقق_شهادة_تي_إل_إس.اسم_غير_مطابق();
    };
    // A leaf that is itself a configured anchor is trusted directly.
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الجذور) مثل غير_موقع)) {
        لو (متساويان_تحقق(&(*الجذور)[ف].الخام, &(*الورقة).الخام)) { أرجع نتيجة_تحقق_شهادة_تي_إل_إس.سلسلة_موثوقة(); };
        ف := ف + 1;
    }
    دع الوسيطة: متغير متجه شهادة_إكس509 = [];
    ف := 1;
    بينما (ف < (الطول(*السلسلة) مثل غير_موقع)) {
        دع الوسيط: &شهادة_إكس509 = &(*السلسلة)[ف];
        ألحق(الوسيطة, *الوسيط);
        ف := ف + 1;
    }
    دع المسار: متغير متجه غير_موقع = [];
    لو (ابحث_عن_مسار_تحقق(الورقة, الورقة, &الوسيطة, الجذور, &متغير المسار, الآن, الغرض, 0)) {
        أرجع نتيجة_تحقق_شهادة_تي_إل_إس.سلسلة_موثوقة();
    };
    أرجع نتيجة_تحقق_شهادة_تي_إل_إس.لا_مسار_موثوق();
}

عام مرادف tls_verify_certificate_chain = تحقق_سلسلة_شهادات_تي_إل_إس;
عام مرادف tls_certificate_matches_host = شهادة_تطابق_المضيف_تي_إل_إس;
