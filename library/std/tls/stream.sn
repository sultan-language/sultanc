استورد net.tcp;
استورد tls.config;

خارجي عرف تشغيل_إنشاء_جلسة_تي_إل_إس(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف أنشئ_جلسة_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_إنشاء_جلسة_تي_إل_إس(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_ضبط_اسم_نظير_تي_إل_إس(الحجة_0: عدد, الحجة_1: متجه غ8): عدد;
عرف اضبط_اسم_نظير_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: &متجه غ8): عدد {
    أرجع تشغيل_ضبط_اسم_نظير_تي_إل_إس(الحجة_0, *الحجة_1);
}
خارجي عرف تشغيل_ضبط_تحقق_تي_إل_إس(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف اضبط_تحقق_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_ضبط_تحقق_تي_إل_إس(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_ضبط_هوية_خادم_تي_إل_إس(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: متجه غ8): عدد;
عرف اضبط_هوية_خادم_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: &متجه غ8, الحجة_2: &متجه غ8): عدد {
    أرجع تشغيل_ضبط_هوية_خادم_تي_إل_إس(الحجة_0, *الحجة_1, *الحجة_2);
}
خارجي عرف تشغيل_ضبط_جذور_ثقة_تي_إل_إس(الحجة_0: عدد, الحجة_1: متجه غ8): عدد;
عرف اضبط_جذور_ثقة_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: &متجه غ8): عدد {
    أرجع تشغيل_ضبط_جذور_ثقة_تي_إل_إس(الحجة_0, *الحجة_1);
}
خارجي عرف تشغيل_مصافحة_تي_إل_إس(الحجة_0: عدد): عدد;
عرف صافح_تي_إل_إس_خام(الحجة_0: عدد): عدد { أرجع تشغيل_مصافحة_تي_إل_إس(الحجة_0); }
خارجي عرف تشغيل_قراءة_تي_إل_إس(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اقرأ_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: &متغير متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_قراءة_تي_إل_إس(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_كتابة_تي_إل_إس(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اكتب_تي_إل_إس_خام(الحجة_0: عدد, الحجة_1: &متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_كتابة_تي_إل_إس(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_إغلاق_جلسة_تي_إل_إس(الحجة_0: عدد): عدد;
عرف أغلق_جلسة_تي_إل_إس_خام(الحجة_0: عدد): عدد { أرجع تشغيل_إغلاق_جلسة_تي_إل_إس(الحجة_0); }

نوع حالة_تدفق_تي_إل_إس = {
    الجلسة: عدد,
    المقبس: عدد
};

عام نوع تدفق_تي_إل_إس = صندوق حالة_تدفق_تي_إل_إس;

عرف أغلق_جلسة_ومقبس_تي_إل_إس(الجلسة: عدد, المقبس: عدد): فراغ {
    دع تجاهل_جلسة: عدد = أغلق_جلسة_تي_إل_إس_خام(الجلسة);
    دع تجاهل_مقبس: عدد = أغلق_مقبس_تي_سي_بي_خام(المقبس);
}

عرف أنشئ_تدفق_تي_إل_إس_من_جلسة(الجلسة: عدد, المقبس: عدد): تدفق_تي_إل_إس {
    دع الحالة: حالة_تدفق_تي_إل_إس = { الجلسة: الجلسة, المقبس: المقبس };
    دع التدفق: تدفق_تي_إل_إس = صندوق الحالة;
    أرجع التدفق;
}

عرف حالة_تي_إل_إس(التدفق: &تدفق_تي_إل_إس): حالة_تدفق_تي_إل_إس { أرجع **التدفق; }

عرف بايتات_اسم_تي_إل_إس(الاسم: &نص): متجه غ8 {
    دع القيمة: نص = *الاسم;
    دع الخارج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) { ألحق(الخارج, القيمة[ف]); ف := ف + 1; }
    أرجع الخارج;
}

عرف طبق_إعداد_عميل_تي_إل_إس(الجلسة: عدد, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة عدد, عدد {
    دع ق: إعداد_عميل_تي_إل_إس = *الإعداد;
    دع تحقق: متغير عدد = 0;
    لو (ق.تحقق_النظير) { تحقق := 1; };
    دع حالة_التحقق: عدد = اضبط_تحقق_تي_إل_إس_خام(الجلسة, تحقق);
    لو (حالة_التحقق < 0) { أرجع نتيجة.خطأ(حالة_التحقق); };
    طابق ق.اسم_الخادم مع
    | اختيار.بعض(الاسم) -> {
        دع البايتات: متجه غ8 = بايتات_اسم_تي_إل_إس(&الاسم);
        دع الحالة: عدد = اضبط_اسم_نظير_تي_إل_إس_خام(الجلسة, &البايتات);
        لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    }
    | اختيار.لا_شيء -> { };
    لو ((الطول(ق.جذور_الثقة) مثل غير_موقع) > 0) {
        طابق حزمة_جذور_ثقة_تي_إل_إس(&ق.جذور_الثقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            دع الحالة: عدد = اضبط_جذور_ثقة_تي_إل_إس_خام(الجلسة, &الحزمة);
            لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        };
    };
    أرجع نتيجة.نجح(0);
}

عرف طبق_إعداد_خادم_تي_إل_إس(الجلسة: عدد, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة عدد, عدد {
    دع ق: إعداد_خادم_تي_إل_إس = *الإعداد;
    دع حالة_الهوية: عدد = اضبط_هوية_خادم_تي_إل_إس_خام(الجلسة, &ق.الهوية.بي_كي_سي12, &ق.الهوية.كلمة_المرور);
    لو (حالة_الهوية < 0) { أرجع نتيجة.خطأ(حالة_الهوية); };
    دع تحقق: متغير عدد = 0;
    لو (ق.تحقق_العميل) { تحقق := 1; };
    دع حالة_التحقق: عدد = اضبط_تحقق_تي_إل_إس_خام(الجلسة, تحقق);
    لو (حالة_التحقق < 0) { أرجع نتيجة.خطأ(حالة_التحقق); };
    لو ((الطول(ق.جذور_ثقة_العميل) مثل غير_موقع) > 0) {
        طابق حزمة_جذور_ثقة_تي_إل_إس(&ق.جذور_ثقة_العميل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحزمة) -> {
            دع الحالة: عدد = اضبط_جذور_ثقة_تي_إل_إس_خام(الجلسة, &الحزمة);
            لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
        };
    };
    أرجع نتيجة.نجح(0);
}

عام عرف غلف_عميل_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    دع المقبس: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
    دع الجلسة: عدد = أنشئ_جلسة_تي_إل_إس_خام(0, المقبس);
    لو (الجلسة <= 0) { دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(المقبس); أرجع نتيجة.خطأ(-1); };
    طابق طبق_إعداد_عميل_تي_إل_إس(الجلسة, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أغلق_جلسة_ومقبس_تي_إل_إس(الجلسة, المقبس); أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    دع التدفق_الآمن: تدفق_تي_إل_إس = أنشئ_تدفق_تي_إل_إس_من_جلسة(الجلسة, المقبس);
    أرجع نتيجة.نجح(التدفق_الآمن);
}

عام عرف غلف_خادم_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    دع المقبس: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
    دع الجلسة: عدد = أنشئ_جلسة_تي_إل_إس_خام(1, المقبس);
    لو (الجلسة <= 0) { دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(المقبس); أرجع نتيجة.خطأ(-1); };
    طابق طبق_إعداد_خادم_تي_إل_إس(الجلسة, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أغلق_جلسة_ومقبس_تي_إل_إس(الجلسة, المقبس); أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    دع التدفق_الآمن: تدفق_تي_إل_إس = أنشئ_تدفق_تي_إل_إس_من_جلسة(الجلسة, المقبس);
    أرجع نتيجة.نجح(التدفق_الآمن);
}

عام عرف صافح_تدفق_تي_إل_إس(التدفق: &تدفق_تي_إل_إس): نتيجة عدد, عدد {
    دع الحالة: حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    دع النتيجة: عدد = صافح_تي_إل_إس_خام(الحالة.الجلسة);
    لو (النتيجة < 0) { أرجع نتيجة.خطأ(النتيجة); };
    أرجع نتيجة.نجح(النتيجة);
}

عام عرف اقرأ_تدفق_تي_إل_إس(
    التدفق: &تدفق_تي_إل_إس,
    المخزن: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع الحالة: حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    دع البيانات: متغير متجه غ8 = *المخزن;
    دع المقروء: عدد = اقرأ_تي_إل_إس_خام(الحالة.الجلسة, &متغير البيانات, الإزاحة, العدد);
    *المخزن := البيانات;
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(المقروء);
}

عام عرف اكتب_تدفق_تي_إل_إس(
    التدفق: &تدفق_تي_إل_إس,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع الحالة: حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    دع البيانات: متجه غ8 = *المحتوى;
    دع المكتوب: عدد = اكتب_تي_إل_إس_خام(الحالة.الجلسة, &البيانات, الإزاحة, العدد);
    لو (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
    أرجع نتيجة.نجح(المكتوب);
}

عام عرف أغلق_تدفق_تي_إل_إس(التدفق: تدفق_تي_إل_إس): نتيجة عدد, عدد {
    دع الحالة: حالة_تدفق_تي_إل_إس = *التدفق;
    حرر(التدفق);
    دع حالة_الجلسة: عدد = أغلق_جلسة_تي_إل_إس_خام(الحالة.الجلسة);
    دع حالة_المقبس: عدد = أغلق_مقبس_تي_سي_بي_خام(الحالة.المقبس);
    لو (حالة_الجلسة < 0) { أرجع نتيجة.خطأ(حالة_الجلسة); };
    لو (حالة_المقبس < 0) { أرجع نتيجة.خطأ(حالة_المقبس); };
    أرجع نتيجة.نجح(0);
}

عام عرف اتصل_عميل_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    طابق غلف_عميل_تي_إل_إس(التدفق, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الآمن) -> {
        طابق صافح_تدفق_تي_إل_إس(&الآمن) مع
        | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن); أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الآمن); };
    };
}

عام عرف اقبل_خادم_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    طابق غلف_خادم_تي_إل_إس(التدفق, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الآمن) -> {
        طابق صافح_تدفق_تي_إل_إس(&الآمن) مع
        | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن); أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الآمن); };
    };
}

عام نوع tls_stream = تدفق_تي_إل_إس;
عام مرادف tls_wrap_client = غلف_عميل_تي_إل_إس;
عام مرادف tls_wrap_server = غلف_خادم_تي_إل_إس;
عام مرادف tls_handshake = صافح_تدفق_تي_إل_إس;
عام مرادف tls_read = اقرأ_تدفق_تي_إل_إس;
عام مرادف tls_write = اكتب_تدفق_تي_إل_إس;
عام مرادف tls_close = أغلق_تدفق_تي_إل_إس;
عام مرادف tls_client_connect = اتصل_عميل_تي_إل_إس;
عام مرادف tls_server_accept = اقبل_خادم_تي_إل_إس;
