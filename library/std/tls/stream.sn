استورد net.tcp;
استورد os.socket;
استورد tls.client;
استورد tls.config;
استورد tls.errors;
استورد tls.record;
استورد tls.server;
استورد tls.wire;

// TLS streams over a TCP connection, implemented entirely in std (record
// layer, key schedule and handshakes in std.tls, primitives in std.crypto).
// There is no runtime or C provider. A stream owns its socket from the
// moment it is wrapped. The handshake runs on the first explicit
// صافح_تدفق_تي_إل_إس, read or write; a failed handshake or record leaves a
// sticky error and sends the matching alert. Reads return 0 after the
// peer's close_notify; a connection that ends without it is reported as
// خطأ_انقطاع_تي_إل_إس (truncation, RFC 8446 6.1).
//
// The std reader/writer contracts pass streams by shared reference, while
// TLS must advance sequence numbers and buffers on every call: each call
// copies the boxed connection state out, works on it, and stores it back
// into the box (*(*التدفق) := ...), the box being the stream's heap cell.

نوع دور_تدفق_تي_إل_إس =
    | دور_عميل بنوع إعداد_عميل_تي_إل_إس
    | دور_خادم بنوع إعداد_خادم_تي_إل_إس
;

نوع حالة_تدفق_تي_إل_إس = {
    الاتصال: حالة_اتصال_تي_إل_إس,
    الدور: دور_تدفق_تي_إل_إس
};

عام نوع تدفق_تي_إل_إس = صندوق حالة_تدفق_تي_إل_إس;

عرف حالة_تي_إل_إس(التدفق: &تدفق_تي_إل_إس): حالة_تدفق_تي_إل_إس { أرجع **التدفق; }

عرف احفظ_حالة_تي_إل_إس(التدفق: &تدفق_تي_إل_إس, الحالة: حالة_تدفق_تي_إل_إس): فراغ {
    *(*التدفق) := الحالة;
}

عرف أنشئ_تدفق_تي_إل_إس(المقبس: عدد, الدور: دور_تدفق_تي_إل_إس, خادم: منطقي): تدفق_تي_إل_إس {
    دع الحالة: حالة_تدفق_تي_إل_إس = {
        الاتصال: أنشئ_حالة_اتصال_تي_إل_إس(المقبس, خادم),
        الدور: الدور
    };
    دع التدفق: تدفق_تي_إل_إس = صندوق الحالة;
    أرجع التدفق;
}

عام عرف غلف_عميل_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    دع المقبس: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
    دع الدور: دور_تدفق_تي_إل_إس = دور_تدفق_تي_إل_إس.دور_عميل(*الإعداد);
    أرجع نتيجة.نجح(أنشئ_تدفق_تي_إل_إس(المقبس, الدور, خطأ));
}

عام عرف غلف_خادم_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    دع المقبس: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
    دع الدور: دور_تدفق_تي_إل_إس = دور_تدفق_تي_إل_إس.دور_خادم(*الإعداد);
    أرجع نتيجة.نجح(أنشئ_تدفق_تي_إل_إس(المقبس, الدور, صواب));
}

// Runs the handshake once; later calls report the outcome again.
عرف صافح_حالة_تي_إل_إس(الحالة: &متغير حالة_تدفق_تي_إل_إس): نتيجة عدد, عدد {
    لو ((*الحالة).الاتصال.خطأ_دائم != 0) { أرجع نتيجة.خطأ((*الحالة).الاتصال.خطأ_دائم); };
    لو ((*الحالة).الاتصال.مغلقة) { أرجع نتيجة.خطأ(خطأ_تدفق_مغلق_تي_إل_إس()); };
    لو ((*الحالة).الاتصال.المصافحة_مكتملة) { أرجع نتيجة.نجح(0); };
    طابق (*الحالة).الدور مع
    | دور_تدفق_تي_إل_إس.دور_عميل(الإعداد) -> {
        أرجع صافح_كعميل_تي_إل_إس(&متغير (*الحالة).الاتصال, &الإعداد);
    }
    | دور_تدفق_تي_إل_إس.دور_خادم(الإعداد) -> {
        أرجع صافح_كخادم_تي_إل_إس(&متغير (*الحالة).الاتصال, &الإعداد);
    };
}

عام عرف صافح_تدفق_تي_إل_إس(التدفق: &تدفق_تي_إل_إس): نتيجة عدد, عدد {
    دع الحالة: متغير حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    دع الناتج: نتيجة عدد, عدد = صافح_حالة_تي_إل_إس(&متغير الحالة);
    احفظ_حالة_تي_إل_إس(التدفق, الحالة);
    أرجع الناتج;
}

// Records a fatal failure: the alert goes out once and the error sticks.
عرف أفشل_اتصال_تي_إل_إس(الاتصال: &متغير حالة_اتصال_تي_إل_إس, الخطأ: عدد): عدد {
    لو (الخطأ <= -2001 && الخطأ > -3000 && الخطأ != خطأ_انقطاع_تي_إل_إس()) {
        أرسل_تنبيها_تي_إل_إس(الاتصال, تنبيه_لخطأ_تي_إل_إس(الخطأ));
    };
    (*الاتصال).خطأ_دائم := الخطأ;
    أرجع الخطأ;
}

// Post-handshake handshake messages (RFC 8446 4.6): NewSessionTicket is
// ignored by clients (no resumption) and KeyUpdate rotates the keys.
عرف عالج_رسائل_ما_بعد_المصافحة_تي_إل_إس(الاتصال: &متغير حالة_اتصال_تي_إل_إس): نتيجة عدد, عدد {
    بينما (صواب) {
        دع المتاح: غير_موقع = الطول((*الاتصال).وارد_مصافحة) مثل غير_موقع;
        لو (المتاح < 4) { أرجع نتيجة.نجح(0); };
        دع الطول_المعلن: غير_موقع = ((*الاتصال).وارد_مصافحة[1] مثل غير_موقع) * 65536
            + ((*الاتصال).وارد_مصافحة[2] مثل غير_موقع) * 256
            + ((*الاتصال).وارد_مصافحة[3] مثل غير_موقع);
        لو (الطول_المعلن > 65536) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        لو (المتاح < 4 + الطول_المعلن) { أرجع نتيجة.نجح(0); };
        دع النوع: غير_موقع = (*الاتصال).وارد_مصافحة[0] مثل غير_موقع;
        دع طلب_تحديث: متغير غير_موقع = 2;
        لو (النوع == رسالة_تحديث_المفتاح_تي_إل_إس()) {
            لو (الطول_المعلن != 1) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
            طلب_تحديث := (*الاتصال).وارد_مصافحة[4] مثل غير_موقع;
            لو (طلب_تحديث > 1) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        } وإلا لو (النوع != رسالة_تذكرة_جلسة_تي_إل_إس() || (*الاتصال).خادم) {
            أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
        };
        دع الباقي: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 4 + الطول_المعلن;
        بينما (ف < المتاح) {
            ألحق(الباقي, (*الاتصال).وارد_مصافحة[ف]);
            ف := ف + 1;
        }
        (*الاتصال).وارد_مصافحة := الباقي;
        لو (طلب_تحديث < 2) {
            // KeyUpdate must end its record (5.1): no buffered remainder.
            لو (!لا_مصافحة_معلقة_تي_إل_إس(الاتصال)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
            حدث_مفاتيح_تي_إل_إس(الاتصال, خطأ);
            لو (طلب_تحديث == 1) {
                دع الجسم: متجه غ8 = [0];
                دع الرد: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_تحديث_المفتاح_تي_إل_إس(), &الجسم);
                طابق اكتب_رسالة_مصافحة_تي_إل_إس(الاتصال, &الرد) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                حدث_مفاتيح_تي_إل_إس(الاتصال, صواب);
            };
        };
    }
    أرجع نتيجة.نجح(0);
}

// Delivers buffered application data, reading records as needed.
عرف اقرأ_تطبيق_تي_إل_إس(
    الاتصال: &متغير حالة_اتصال_تي_إل_إس,
    المخزن: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    بينما (صواب) {
        دع المتاح: غير_موقع = (الطول((*الاتصال).وارد_تطبيق) مثل غير_موقع) - (*الاتصال).موضع_التطبيق;
        لو (المتاح > 0) {
            دع المنسوخ: متغير غير_موقع = العدد مثل غير_موقع;
            لو (المنسوخ > المتاح) { المنسوخ := المتاح; };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < المنسوخ) {
                (*المخزن)[(الإزاحة مثل غير_موقع) + ف] := (*الاتصال).وارد_تطبيق[(*الاتصال).موضع_التطبيق + ف];
                ف := ف + 1;
            }
            (*الاتصال).موضع_التطبيق := (*الاتصال).موضع_التطبيق + المنسوخ;
            لو ((*الاتصال).موضع_التطبيق == (الطول((*الاتصال).وارد_تطبيق) مثل غير_موقع)) {
                دع فارغ: متجه غ8 = [];
                (*الاتصال).وارد_تطبيق := فارغ;
                (*الاتصال).موضع_التطبيق := 0;
            };
            أرجع نتيجة.نجح(المنسوخ مثل عدد);
        };
        لو ((*الاتصال).نهاية_مستلمة) { أرجع نتيجة.نجح(0); };
        طابق اقرأ_سجل_تي_إل_إس(الاتصال) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(السجل) -> {
            لو (السجل.النوع == نوع_بيانات_تطبيق_تي_إل_إس()) {
                دع مرجع_البيانات: &متجه غ8 = &السجل.البيانات;
                (*الاتصال).وارد_تطبيق := *مرجع_البيانات;
                (*الاتصال).موضع_التطبيق := 0;
            } وإلا لو (السجل.النوع == نوع_تنبيه_تي_إل_إس()) {
                دع الحالة: عدد = عالج_تنبيها_مستلما_تي_إل_إس(&السجل.البيانات);
                لو (الحالة == 0) {
                    (*الاتصال).نهاية_مستلمة := صواب;
                    أرجع نتيجة.نجح(0);
                };
                أرجع نتيجة.خطأ(الحالة);
            } وإلا {
                ألحق_بايتات_سجل_مصافحة_تي_إل_إس(الاتصال, &السجل.البيانات);
                طابق عالج_رسائل_ما_بعد_المصافحة_تي_إل_إس(الاتصال) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
}

عرف ألحق_بايتات_سجل_مصافحة_تي_إل_إس(الاتصال: &متغير حالة_اتصال_تي_إل_إس, البيانات: &متجه غ8): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*البيانات) مثل غير_موقع)) {
        ألحق((*الاتصال).وارد_مصافحة, (*البيانات)[ف]);
        ف := ف + 1;
    }
}

عرف نطاق_مخزن_صالح_تي_إل_إس(الحجم: عدد, الإزاحة: عدد, العدد: عدد): منطقي {
    لو (الإزاحة < 0 || العدد < 0 || الإزاحة > الحجم) { أرجع خطأ; };
    أرجع العدد <= الحجم - الإزاحة;
}

عام عرف اقرأ_تدفق_تي_إل_إس(
    التدفق: &تدفق_تي_إل_إس,
    المخزن: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    لو (!نطاق_مخزن_صالح_تي_إل_إس(الطول(*المخزن), الإزاحة, العدد)) { أرجع نتيجة.خطأ(خطأ_وسيط_تي_إل_إس()); };
    دع الحالة: متغير حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    طابق صافح_حالة_تي_إل_إس(&متغير الحالة) مع
    | نتيجة.خطأ(الخطأ) -> {
        احفظ_حالة_تي_إل_إس(التدفق, الحالة);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };
    لو (العدد == 0) {
        احفظ_حالة_تي_إل_إس(التدفق, الحالة);
        أرجع نتيجة.نجح(0);
    };
    دع الناتج: نتيجة عدد, عدد = اقرأ_تطبيق_تي_إل_إس(&متغير الحالة.الاتصال, المخزن, الإزاحة, العدد);
    طابق الناتج مع
    | نتيجة.خطأ(الخطأ) -> {
        دع الرمز: عدد = أفشل_اتصال_تي_إل_إس(&متغير الحالة.الاتصال, الخطأ);
        احفظ_حالة_تي_إل_إس(التدفق, الحالة);
        أرجع نتيجة.خطأ(الرمز);
    }
    | نتيجة.نجح(المقروء) -> {
        احفظ_حالة_تي_إل_إس(التدفق, الحالة);
        أرجع نتيجة.نجح(المقروء);
    };
}

عام عرف اكتب_تدفق_تي_إل_إس(
    التدفق: &تدفق_تي_إل_إس,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    لو (!نطاق_مخزن_صالح_تي_إل_إس(الطول(*المحتوى), الإزاحة, العدد)) { أرجع نتيجة.خطأ(خطأ_وسيط_تي_إل_إس()); };
    دع الحالة: متغير حالة_تدفق_تي_إل_إس = حالة_تي_إل_إس(التدفق);
    طابق صافح_حالة_تي_إل_إس(&متغير الحالة) مع
    | نتيجة.خطأ(الخطأ) -> {
        احفظ_حالة_تي_إل_إس(التدفق, الحالة);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> { };
    دع المكتوب: متغير غير_موقع = 0;
    دع الكلي: غير_موقع = العدد مثل غير_موقع;
    بينما (المكتوب < الكلي) {
        دع الجزء: متغير غير_موقع = الكلي - المكتوب;
        لو (الجزء > 16384) { الجزء := 16384; };
        دع القطعة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الجزء) {
            ألحق(القطعة, (*المحتوى)[(الإزاحة مثل غير_موقع) + المكتوب + ف]);
            ف := ف + 1;
        }
        طابق اكتب_سجل_تي_إل_إس(&متغير الحالة.الاتصال, نوع_بيانات_تطبيق_تي_إل_إس(), &القطعة) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع الرمز: عدد = أفشل_اتصال_تي_إل_إس(&متغير الحالة.الاتصال, الخطأ);
            احفظ_حالة_تي_إل_إس(التدفق, الحالة);
            أرجع نتيجة.خطأ(الرمز);
        }
        | نتيجة.نجح(_) -> { };
        المكتوب := المكتوب + الجزء;
    }
    احفظ_حالة_تي_إل_إس(التدفق, الحالة);
    أرجع نتيجة.نجح(العدد);
}

// Sends close_notify after a completed handshake, then closes the socket.
عام عرف أغلق_تدفق_تي_إل_إس(التدفق: تدفق_تي_إل_إس): نتيجة عدد, عدد {
    دع الحالة: متغير حالة_تدفق_تي_إل_إس = *التدفق;
    حرر(التدفق);
    لو (الحالة.الاتصال.المصافحة_مكتملة && الحالة.الاتصال.خطأ_دائم == 0 && !الحالة.الاتصال.مغلقة) {
        أرسل_تنبيها_تي_إل_إس(&متغير الحالة.الاتصال, 0);
    };
    دع المقبس: متغير مقبس_نظام = { القيمة: الحالة.الاتصال.المقبس, مفتوح: صواب };
    طابق أغلق_مقبس_نظام(&متغير المقبس) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_انقطاع_تي_إل_إس()); }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(0);
}

عام عرف اتصل_عميل_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    طابق غلف_عميل_تي_إل_إس(التدفق, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الآمن) -> {
        طابق صافح_تدفق_تي_إل_إس(&الآمن) مع
        | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن); أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الآمن); };
    };
}

عام عرف اقبل_خادم_تي_إل_إس(التدفق: تدفق_تي_سي_بي, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة تدفق_تي_إل_إس, عدد {
    طابق غلف_خادم_تي_إل_إس(التدفق, الإعداد) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الآمن) -> {
        طابق صافح_تدفق_تي_إل_إس(&الآمن) مع
        | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن); أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الآمن); };
    };
}

عام نوع tls_stream = تدفق_تي_إل_إس;
عام مرادف tls_wrap_client = غلف_عميل_تي_إل_إس;
عام مرادف tls_wrap_server = غلف_خادم_تي_إل_إس;
عام مرادف tls_handshake = صافح_تدفق_تي_إل_إس;
عام مرادف tls_read = اقرأ_تدفق_تي_إل_إس;
عام مرادف tls_write = اكتب_تدفق_تي_إل_إس;
عام مرادف tls_close = أغلق_تدفق_تي_إل_إس;
عام مرادف tls_client_connect = اتصل_عميل_تي_إل_إس;
عام مرادف tls_server_accept = اقبل_خادم_تي_إل_إس;
