استورد text.from_bytes;

// TLS configuration values. Trust roots are DER certificates; an empty root
// list means the system trust anchors (std.tls.trust). Server identities
// are PKCS#12 containers decoded by std.tls.pkcs12 at handshake time.

عام نوع شهادة_تي_إل_إس = {
    دي_إي_آر: متجه ط8
};

عام نوع هوية_خادم_تي_إل_إس = {
    بي_كي_سي12: متجه ط8,
    كلمة_المرور: متجه ط8
};

// البروتوكولات is the ALPN list (RFC 7301), most preferred first, as
// Go's tls.Config.NextProtos: a client offers it, a server picks its own
// first entry the client offered. Empty: ALPN is not used.
عام نوع إعداد_عميل_تي_إل_إس = {
    تحقق_النظير: منطقي,
    اسم_الخادم: اختياري نص,
    جذور_الثقة: متجه شهادة_تي_إل_إس,
    البروتوكولات: متجه نص
};

عام نوع إعداد_خادم_تي_إل_إس = {
    الهوية: هوية_خادم_تي_إل_إس,
    تحقق_العميل: منطقي,
    جذور_ثقة_العميل: متجه شهادة_تي_إل_إس,
    البروتوكولات: متجه نص
};

عرف بايتات_نص_تي_إل_إس(النص: &نص): متجه ط8 {
    دع القيمة: نص = *النص;
    دع الخارج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) { ألحق(الخارج, القيمة[ف]); ف := ف + 1; }
    أرجع الخارج;
}

عام عرف أنشئ_شهادة_تي_إل_إس_دي_إي_آر(دي_إي_آر: متجه ط8): شهادة_تي_إل_إس {
    دع الشهادة: شهادة_تي_إل_إس = { دي_إي_آر: دي_إي_آر };
    أرجع الشهادة;
}

عام عرف أنشئ_هوية_خادم_تي_إل_إس(بي_كي_سي12: متجه ط8, كلمة_المرور: &نص): هوية_خادم_تي_إل_إس {
    دع كلمة: متجه ط8 = بايتات_نص_تي_إل_إس(كلمة_المرور);
    دع الهوية: هوية_خادم_تي_إل_إس = { بي_كي_سي12: بي_كي_سي12, كلمة_المرور: كلمة };
    أرجع الهوية;
}

عام عرف إعداد_عميل_تي_إل_إس_افتراضي(اسم_الخادم: &نص): إعداد_عميل_تي_إل_إس {
    دع الاسم: نص = انسخ_نص(اسم_الخادم);
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع البروتوكولات: متجه نص = [];
    دع الإعداد: إعداد_عميل_تي_إل_إس = {
        تحقق_النظير: صواب,
        اسم_الخادم: اختياري.موجود(الاسم),
        جذور_الثقة: الجذور,
        البروتوكولات: البروتوكولات
    };
    أرجع الإعداد;
}

عام عرف إعداد_عميل_تي_إل_إس_بلا_اسم(): إعداد_عميل_تي_إل_إس {
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع البروتوكولات: متجه نص = [];
    دع الإعداد: إعداد_عميل_تي_إل_إس = {
        تحقق_النظير: صواب,
        اسم_الخادم: اختياري.لا_شيء(),
        جذور_الثقة: الجذور,
        البروتوكولات: البروتوكولات
    };
    أرجع الإعداد;
}

عام عرف أنشئ_إعداد_خادم_تي_إل_إس(الهوية: هوية_خادم_تي_إل_إس): إعداد_خادم_تي_إل_إس {
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع البروتوكولات: متجه نص = [];
    دع الإعداد: إعداد_خادم_تي_إل_إس = {
        الهوية: الهوية,
        تحقق_العميل: خطأ,
        جذور_ثقة_العميل: الجذور,
        البروتوكولات: البروتوكولات
    };
    أرجع الإعداد;
}

عام عرف اضبط_تحقق_نظير_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, مفعل: منطقي): فراغ {
    (*الإعداد).تحقق_النظير := مفعل;
}

عام عرف اضبط_اسم_خادم_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, الاسم: &نص): فراغ {
    (*الإعداد).اسم_الخادم := اختياري.موجود(انسخ_نص(الاسم));
}

عام عرف أزل_اسم_خادم_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس): فراغ {
    (*الإعداد).اسم_الخادم := اختياري.لا_شيء();
}

عام عرف أضف_جذر_ثقة_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, الشهادة: شهادة_تي_إل_إس): فراغ {
    ألحق((*الإعداد).جذور_الثقة, الشهادة);
}

عام عرف اضبط_تحقق_عميل_تي_إل_إس(الإعداد: &متغير إعداد_خادم_تي_إل_إس, مفعل: منطقي): فراغ {
    (*الإعداد).تحقق_العميل := مفعل;
}

عام عرف أضف_جذر_ثقة_عميل_تي_إل_إس(الإعداد: &متغير إعداد_خادم_تي_إل_إس, الشهادة: شهادة_تي_إل_إس): فراغ {
    ألحق((*الإعداد).جذور_ثقة_العميل, الشهادة);
}

// Sets the ALPN protocols a client offers (RFC 7301), most preferred first.
عام عرف اضبط_بروتوكولات_عميل_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, البروتوكولات: &متجه نص): فراغ {
    (*الإعداد).البروتوكولات := انسخ_نصوص_تي_إل_إس(البروتوكولات);
}

// Sets the ALPN protocols a server accepts, most preferred first.
عام عرف اضبط_بروتوكولات_خادم_تي_إل_إس(الإعداد: &متغير إعداد_خادم_تي_إل_إس, البروتوكولات: &متجه نص): فراغ {
    (*الإعداد).البروتوكولات := انسخ_نصوص_تي_إل_إس(البروتوكولات);
}

عرف انسخ_نصوص_تي_إل_إس(النصوص: &متجه نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النصوص) مثل طبيعي)) { ألحق(الناتج, انسخ_نص(&(*النصوص)[ف])); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف هل_تحقق_نظير_تي_إل_إس(الإعداد: &إعداد_عميل_تي_إل_إس): منطقي { دع ق: إعداد_عميل_تي_إل_إس = *الإعداد; أرجع ق.تحقق_النظير; }
عام عرف هل_تحقق_عميل_تي_إل_إس(الإعداد: &إعداد_خادم_تي_إل_إس): منطقي { دع ق: إعداد_خادم_تي_إل_إس = *الإعداد; أرجع ق.تحقق_العميل; }

عام نوع tls_certificate = شهادة_تي_إل_إس;
عام نوع tls_server_identity = هوية_خادم_تي_إل_إس;
عام نوع tls_client_config = إعداد_عميل_تي_إل_إس;
عام نوع tls_server_config = إعداد_خادم_تي_إل_إس;
عام مرادف tls_certificate_der = أنشئ_شهادة_تي_إل_إس_دي_إي_آر;
عام مرادف tls_server_identity_pkcs12 = أنشئ_هوية_خادم_تي_إل_إس;
عام مرادف tls_client_config_default = إعداد_عميل_تي_إل_إس_افتراضي;
عام مرادف tls_client_config_without_server_name = إعداد_عميل_تي_إل_إس_بلا_اسم;
عام مرادف tls_server_config_new = أنشئ_إعداد_خادم_تي_إل_إس;
عام مرادف tls_client_config_set_verify = اضبط_تحقق_نظير_تي_إل_إس;
عام مرادف tls_client_config_set_server_name = اضبط_اسم_خادم_تي_إل_إس;
عام مرادف tls_client_config_clear_server_name = أزل_اسم_خادم_تي_إل_إس;
عام مرادف tls_client_config_add_trust_root = أضف_جذر_ثقة_تي_إل_إس;
عام مرادف tls_server_config_set_verify_client = اضبط_تحقق_عميل_تي_إل_إس;
عام مرادف tls_server_config_add_client_trust_root = أضف_جذر_ثقة_عميل_تي_إل_إس;
عام مرادف tls_client_config_set_protocols = اضبط_بروتوكولات_عميل_تي_إل_إس;
عام مرادف tls_server_config_set_protocols = اضبط_بروتوكولات_خادم_تي_إل_إس;
عام مرادف tls_client_config_verifies_peer = هل_تحقق_نظير_تي_إل_إس;
عام مرادف tls_server_config_verifies_client = هل_تحقق_عميل_تي_إل_إس;

// Independent copies of configurations (a stream owns the configuration it
// was created with).
عرف انسخ_شهادات_تي_إل_إس(الشهادات: &متجه شهادة_تي_إل_إس): متجه شهادة_تي_إل_إس {
    دع الناتج: متغير متجه شهادة_تي_إل_إس = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الشهادات) مثل طبيعي)) {
        دع الشهادة: شهادة_تي_إل_إس = { دي_إي_آر: انسخ_بايتات(&(*الشهادات)[ف].دي_إي_آر) };
        ألحق(الناتج, الشهادة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف انسخ_إعداد_عميل_تي_إل_إس(الإعداد: &إعداد_عميل_تي_إل_إس): إعداد_عميل_تي_إل_إس {
    دع الاسم: متغير اختياري نص = اختياري.لا_شيء();
    طابق (*الإعداد).اسم_الخادم مع
    | اختياري.موجود(القيمة) -> { الاسم := اختياري.موجود(انسخ_نص(&القيمة)); }
    | اختياري.لا_شيء -> { };
    دع الناتج: إعداد_عميل_تي_إل_إس = {
        تحقق_النظير: (*الإعداد).تحقق_النظير,
        اسم_الخادم: الاسم,
        جذور_الثقة: انسخ_شهادات_تي_إل_إس(&(*الإعداد).جذور_الثقة),
        البروتوكولات: انسخ_نصوص_تي_إل_إس(&(*الإعداد).البروتوكولات)
    };
    أرجع الناتج;
}

عام عرف انسخ_إعداد_خادم_تي_إل_إس(الإعداد: &إعداد_خادم_تي_إل_إس): إعداد_خادم_تي_إل_إس {
    دع الهوية: هوية_خادم_تي_إل_إس = {
        بي_كي_سي12: انسخ_بايتات(&(*الإعداد).الهوية.بي_كي_سي12),
        كلمة_المرور: انسخ_بايتات(&(*الإعداد).الهوية.كلمة_المرور)
    };
    دع الناتج: إعداد_خادم_تي_إل_إس = {
        الهوية: الهوية,
        تحقق_العميل: (*الإعداد).تحقق_العميل,
        جذور_ثقة_العميل: انسخ_شهادات_تي_إل_إس(&(*الإعداد).جذور_ثقة_العميل),
        البروتوكولات: انسخ_نصوص_تي_إل_إس(&(*الإعداد).البروتوكولات)
    };
    أرجع الناتج;
}
