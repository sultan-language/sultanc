استورد text.from_bytes;

عام نوع شهادة_تي_إل_إس = {
    دي_إي_آر: متجه غ8
};

عام نوع هوية_خادم_تي_إل_إس = {
    بي_كي_سي12: متجه غ8,
    كلمة_المرور: متجه غ8
};

عام نوع إعداد_عميل_تي_إل_إس = {
    تحقق_النظير: منطقي,
    اسم_الخادم: اختيار نص,
    جذور_الثقة: متجه شهادة_تي_إل_إس
};

عام نوع إعداد_خادم_تي_إل_إس = {
    الهوية: هوية_خادم_تي_إل_إس,
    تحقق_العميل: منطقي,
    جذور_ثقة_العميل: متجه شهادة_تي_إل_إس
};

عرف بايتات_نص_تي_إل_إس(النص: &نص): متجه غ8 {
    دع القيمة: نص = *النص;
    دع الخارج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) { ألحق(الخارج, القيمة[ف]); ف := ف + 1; }
    أرجع الخارج;
}

عام عرف أنشئ_شهادة_تي_إل_إس_دي_إي_آر(دي_إي_آر: متجه غ8): شهادة_تي_إل_إس {
    دع الشهادة: شهادة_تي_إل_إس = { دي_إي_آر: دي_إي_آر };
    أرجع الشهادة;
}

عام عرف أنشئ_هوية_خادم_تي_إل_إس(بي_كي_سي12: متجه غ8, كلمة_المرور: &نص): هوية_خادم_تي_إل_إس {
    دع كلمة: متجه غ8 = بايتات_نص_تي_إل_إس(كلمة_المرور);
    دع الهوية: هوية_خادم_تي_إل_إس = { بي_كي_سي12: بي_كي_سي12, كلمة_المرور: كلمة };
    أرجع الهوية;
}

عام عرف إعداد_عميل_تي_إل_إس_افتراضي(اسم_الخادم: &نص): إعداد_عميل_تي_إل_إس {
    دع الاسم: نص = *اسم_الخادم;
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع الإعداد: إعداد_عميل_تي_إل_إس = {
        تحقق_النظير: صواب,
        اسم_الخادم: اختيار.بعض(الاسم),
        جذور_الثقة: الجذور
    };
    أرجع الإعداد;
}

عام عرف إعداد_عميل_تي_إل_إس_بلا_اسم(): إعداد_عميل_تي_إل_إس {
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع الإعداد: إعداد_عميل_تي_إل_إس = {
        تحقق_النظير: صواب,
        اسم_الخادم: اختيار.لا_شيء(),
        جذور_الثقة: الجذور
    };
    أرجع الإعداد;
}

عام عرف أنشئ_إعداد_خادم_تي_إل_إس(الهوية: هوية_خادم_تي_إل_إس): إعداد_خادم_تي_إل_إس {
    دع الجذور: متجه شهادة_تي_إل_إس = [];
    دع الإعداد: إعداد_خادم_تي_إل_إس = {
        الهوية: الهوية,
        تحقق_العميل: خطأ,
        جذور_ثقة_العميل: الجذور
    };
    أرجع الإعداد;
}

// Runtime trust input is a portable framed DER sequence:
// [u32 big-endian length][DER bytes] repeated.
عام عرف حزمة_جذور_ثقة_تي_إل_إس(الشهادات: &متجه شهادة_تي_إل_إس): نتيجة متجه غ8, عدد {
    دع القيم: متجه شهادة_تي_إل_إس = *الشهادات;
    دع الخارج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع الحجم: غير_موقع = الطول(القيم[ف].دي_إي_آر) مثل غير_موقع;
        لو (الحجم > 4294967295) { أرجع نتيجة.خطأ(-22); };
        ألحق(الخارج, ((الحجم >> 24) & 0xFF) مثل غ8);
        ألحق(الخارج, ((الحجم >> 16) & 0xFF) مثل غ8);
        ألحق(الخارج, ((الحجم >> 8) & 0xFF) مثل غ8);
        ألحق(الخارج, (الحجم & 0xFF) مثل غ8);
        دع م: متغير غير_موقع = 0;
        بينما (م < الحجم) { ألحق(الخارج, القيم[ف].دي_إي_آر[م]); م := م + 1; }
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الخارج);
}

عام عرف اضبط_تحقق_نظير_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, مفعل: منطقي): فراغ {
    دع ق: متغير إعداد_عميل_تي_إل_إس = *الإعداد;
    ق.تحقق_النظير := مفعل;
    *الإعداد := ق;
}

عام عرف اضبط_اسم_خادم_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, الاسم: &نص): فراغ {
    دع ق: متغير إعداد_عميل_تي_إل_إس = *الإعداد;
    دع القيمة: نص = *الاسم;
    ق.اسم_الخادم := اختيار.بعض(القيمة);
    *الإعداد := ق;
}

عام عرف أزل_اسم_خادم_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس): فراغ {
    دع ق: متغير إعداد_عميل_تي_إل_إس = *الإعداد;
    ق.اسم_الخادم := اختيار.لا_شيء();
    *الإعداد := ق;
}

عام عرف أضف_جذر_ثقة_تي_إل_إس(الإعداد: &متغير إعداد_عميل_تي_إل_إس, الشهادة: شهادة_تي_إل_إس): فراغ {
    دع ق: متغير إعداد_عميل_تي_إل_إس = *الإعداد;
    ألحق(ق.جذور_الثقة, الشهادة);
    *الإعداد := ق;
}

عام عرف اضبط_تحقق_عميل_تي_إل_إس(الإعداد: &متغير إعداد_خادم_تي_إل_إس, مفعل: منطقي): فراغ {
    دع ق: متغير إعداد_خادم_تي_إل_إس = *الإعداد;
    ق.تحقق_العميل := مفعل;
    *الإعداد := ق;
}

عام عرف أضف_جذر_ثقة_عميل_تي_إل_إس(الإعداد: &متغير إعداد_خادم_تي_إل_إس, الشهادة: شهادة_تي_إل_إس): فراغ {
    دع ق: متغير إعداد_خادم_تي_إل_إس = *الإعداد;
    ألحق(ق.جذور_ثقة_العميل, الشهادة);
    *الإعداد := ق;
}

عام عرف هل_تحقق_نظير_تي_إل_إس(الإعداد: &إعداد_عميل_تي_إل_إس): منطقي { دع ق: إعداد_عميل_تي_إل_إس = *الإعداد; أرجع ق.تحقق_النظير; }
عام عرف هل_تحقق_عميل_تي_إل_إس(الإعداد: &إعداد_خادم_تي_إل_إس): منطقي { دع ق: إعداد_خادم_تي_إل_إس = *الإعداد; أرجع ق.تحقق_العميل; }

عام نوع tls_certificate = شهادة_تي_إل_إس;
عام نوع tls_server_identity = هوية_خادم_تي_إل_إس;
عام نوع tls_client_config = إعداد_عميل_تي_إل_إس;
عام نوع tls_server_config = إعداد_خادم_تي_إل_إس;
عام مرادف tls_certificate_der = أنشئ_شهادة_تي_إل_إس_دي_إي_آر;
عام مرادف tls_server_identity_pkcs12 = أنشئ_هوية_خادم_تي_إل_إس;
عام مرادف tls_client_config_default = إعداد_عميل_تي_إل_إس_افتراضي;
عام مرادف tls_client_config_without_server_name = إعداد_عميل_تي_إل_إس_بلا_اسم;
عام مرادف tls_server_config_new = أنشئ_إعداد_خادم_تي_إل_إس;
عام مرادف tls_trust_bundle = حزمة_جذور_ثقة_تي_إل_إس;
عام مرادف tls_client_config_set_verify = اضبط_تحقق_نظير_تي_إل_إس;
عام مرادف tls_client_config_set_server_name = اضبط_اسم_خادم_تي_إل_إس;
عام مرادف tls_client_config_clear_server_name = أزل_اسم_خادم_تي_إل_إس;
عام مرادف tls_client_config_add_trust_root = أضف_جذر_ثقة_تي_إل_إس;
عام مرادف tls_server_config_set_verify_client = اضبط_تحقق_عميل_تي_إل_إس;
عام مرادف tls_server_config_add_client_trust_root = أضف_جذر_ثقة_عميل_تي_إل_إس;
عام مرادف tls_client_config_verifies_peer = هل_تحقق_نظير_تي_إل_إس;
عام مرادف tls_server_config_verifies_client = هل_تحقق_عميل_تي_إل_إس;
