// TLS 1.3 server handshake (RFC 8446 2, 4.1-4.4, 7.1), following the state
// sequence of Go crypto/tls handshake_server_tls13.go.
//
// The identity comes from a PKCS#12 container (std.tls.pkcs12). The server
// signs CertificateVerify with the scheme its key allows and the client
// offered (RFC 8446 4.2.3): RSASSA-PSS (rsa_pss_rsae_sha256/384/512) through
// crypto.rsa's constant-time CRT signer, ecdsa_secp256r1_sha256 or
// ecdsa_secp384r1_sha384 with deterministic constant-time ECDSA, or ed25519.
// The server selects TLS 1.3, its preferred cipher suite among
// ChaCha20-Poly1305, AES-128-GCM and AES-256-GCM, and its preferred group
// among X25519, secp256r1 and secp384r1 for which the client sent a share;
// when the client supports one of them without a share, one
// HelloRetryRequest asks for it. Previously only RSA keys and X25519 were
// accepted. PSKs are ignored (full handshake); early data, which requires a
// ticket this server never issues, is refused. With client verification
// enabled a CertificateRequest is sent and the client chain is validated for
// clientAuth against the configured client roots (or the system anchors).

استورد crypto.digest;
استورد crypto.ecdsa;
استورد crypto.ed25519;
استورد crypto.rsa;
استورد crypto.words;
استورد text.from_bytes;
استورد tls.client;
استورد tls.config;
استورد tls.errors;
استورد tls.key_exchange;
استورد tls.pkcs12;
استورد tls.record;
استورد tls.signature;
استورد tls.verify;
استورد tls.wire;
استورد tls.x509;

نوع ترحيب_عميل_تي_إل_إس = {
    معرف_الجلسة: متجه غ8,
    الحزم: متجه غير_موقع,
    الإصدارات: متجه غير_موقع,
    المجموعات: متجه غير_موقع,
    // Key shares of supported groups, in the client's order.
    مجموعات_المشاركات: متجه غير_موقع,
    مفاتيح_المشاركات: متجه متجه غ8,
    المخططات: متجه غير_موقع,
    بيانات_مبكرة: منطقي
};

عرف قائمة_أرقام_تي_إل_إس(البيانات: &متجه غ8, بايتات_الطول: غير_موقع): اختيار متجه غير_موقع {
    دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(البيانات, 0);
    دع الكتلة: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير ق, بايتات_الطول);
    لو (!قارئ_منته_تي_إل_إس(&ق) || ((الطول(الكتلة) مثل غير_موقع) % 2) != 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الكتلة) مثل غير_موقع)) {
        ألحق(الناتج, اقرأ_كبير16_تشفير(&الكتلة, ف));
        ف := ف + 2;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف يحتوي_رقما_تي_إل_إس(القائمة: &متجه غير_موقع, القيمة: غير_موقع): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القائمة) مثل غير_موقع)) {
        لو ((*القائمة)[ف] == القيمة) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف حلل_ترحيب_العميل_تي_إل_إس(الرسالة: &متجه غ8): نتيجة ترحيب_عميل_تي_إل_إس, عدد {
    لو ((*الرسالة)[0] != (رسالة_ترحيب_العميل_تي_إل_إس() مثل غ8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(الرسالة, 4);
    دع تجاهل_الإصدار: غير_موقع = اقرأ_رقما_تي_إل_إس(&متغير ق, 2);
    دع تجاهل_العشوائي: متجه غ8 = اقرأ_بايتات_تي_إل_إس(&متغير ق, 32);
    دع معرف_الجلسة: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 1);
    دع كتلة_الحزم: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 2);
    دع الضغط: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 1);
    لو (!ق.صالح || (الطول(معرف_الجلسة) مثل غير_موقع) > 32 || ((الطول(كتلة_الحزم) مثل غير_موقع) % 2) != 0) {
        أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس());
    };
    // TLS 1.3 requires exactly the null compression method (4.1.2).
    لو ((الطول(الضغط) مثل غير_موقع) != 1 || الضغط[0] != 0) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع الحزم: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(كتلة_الحزم) مثل غير_موقع)) {
        ألحق(الحزم, اقرأ_كبير16_تشفير(&كتلة_الحزم, ف));
        ف := ف + 2;
    }
    دع الامتدادات: متجه امتداد_تي_إل_إس;
    طابق اقرأ_امتدادات_تي_إل_إس(&متغير ق) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
    | اختيار.بعض(القيمة) -> { الامتدادات := القيمة; };
    لو (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    دع فارغ_أرقام1: متجه غير_موقع = [];
    دع فارغ_أرقام2: متجه غير_موقع = [];
    دع فارغ_أرقام3: متجه غير_موقع = [];
    دع فارغ_أرقام4: متجه غير_موقع = [];
    دع فارغ_مفاتيح: متجه متجه غ8 = [];
    دع الترحيب: متغير ترحيب_عميل_تي_إل_إس = {
        معرف_الجلسة: معرف_الجلسة,
        الحزم: الحزم,
        الإصدارات: فارغ_أرقام1,
        المجموعات: فارغ_أرقام2,
        مجموعات_المشاركات: فارغ_أرقام4,
        مفاتيح_المشاركات: فارغ_مفاتيح,
        المخططات: فارغ_أرقام3,
        بيانات_مبكرة: خطأ
    };
    دع العدد: غير_موقع = الطول(الامتدادات) مثل غير_موقع;
    ف := 0;
    بينما (ف < العدد) {
        دع النوع: غير_موقع = الامتدادات[ف].النوع;
        دع البيانات: &متجه غ8 = &الامتدادات[ف].البيانات;
        لو (النوع == امتداد_الإصدارات_تي_إل_إس()) {
            طابق قائمة_أرقام_تي_إل_إس(البيانات, 1) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
            | اختيار.بعض(القيمة) -> { الترحيب.الإصدارات := القيمة; };
        } وإلا لو (النوع == امتداد_المجموعات_تي_إل_إس()) {
            طابق قائمة_أرقام_تي_إل_إس(البيانات, 2) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
            | اختيار.بعض(القيمة) -> { الترحيب.المجموعات := القيمة; };
        } وإلا لو (النوع == امتداد_خوارزميات_التوقيع_تي_إل_إس()) {
            طابق قائمة_أرقام_تي_إل_إس(البيانات, 2) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
            | اختيار.بعض(القيمة) -> { الترحيب.المخططات := القيمة; };
        } وإلا لو (النوع == امتداد_مشاركة_المفتاح_تي_إل_إس()) {
            دع م: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(البيانات, 0);
            دع المشاركات: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير م, 2);
            لو (!قارئ_منته_تي_إل_إس(&م)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
            دع ن: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&المشاركات, 0);
            دع المرئية: متغير متجه غير_موقع = [];
            بينما (متبقي_قارئ_تي_إل_إس(&ن) > 0) {
                دع المجموعة: غير_موقع = اقرأ_رقما_تي_إل_إس(&متغير ن, 2);
                دع المفتاح: متجه غ8 = اقرأ_متجها_تي_إل_إس(&متغير ن, 2);
                لو (!ن.صالح || (الطول(المفتاح) مثل غير_موقع) == 0 || يحتوي_رقما_تي_إل_إس(&المرئية, المجموعة)) {
                    أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
                };
                ألحق(المرئية, المجموعة);
                لو (مجموعة_مدعومة_تي_إل_إس(المجموعة)) {
                    ألحق(الترحيب.مجموعات_المشاركات, المجموعة);
                    ألحق(الترحيب.مفاتيح_المشاركات, المفتاح);
                };
            }
        } وإلا لو (النوع == 42) {
            الترحيب.بيانات_مبكرة := صواب;
        } وإلا لو (النوع == امتداد_مفتاح_مشترك_مسبقا_تي_إل_إس()) {
            // pre_shared_key must be the last extension (4.2.11); it is ignored.
            لو (ف + 1 != العدد) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الترحيب);
}

عرف ابن_ترحيب_الخادم_تي_إل_إس(
    العشوائي: &متجه غ8,
    معرف_الجلسة: &متجه غ8,
    الحزمة: غير_موقع,
    مشاركة_المفتاح: &متجه غ8
): متجه غ8 {
    دع الجسم: متغير متجه غ8 = [];
    ألحق_كبير16_تشفير(&متغير الجسم, 0x0303);
    ألحق_بايتات_تشفير(&متغير الجسم, العشوائي);
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 1, معرف_الجلسة);
    ألحق_كبير16_تشفير(&متغير الجسم, الحزمة);
    ألحق(الجسم, 0 مثل غ8);
    دع الامتدادات: متغير متجه غ8 = [];
    ألحق_كبير16_تشفير(&متغير الامتدادات, امتداد_الإصدارات_تي_إل_إس());
    ألحق_كبير16_تشفير(&متغير الامتدادات, 2);
    ألحق_كبير16_تشفير(&متغير الامتدادات, 0x0304);
    ألحق_كبير16_تشفير(&متغير الامتدادات, امتداد_مشاركة_المفتاح_تي_إل_إس());
    ألحق_متجها_تي_إل_إس(&متغير الامتدادات, 2, مشاركة_المفتاح);
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 2, &الامتدادات);
    أرجع رسالة_مصافحة_تي_إل_إس(رسالة_ترحيب_الخادم_تي_إل_إس(), &الجسم);
}

// The first of the server's preferences that the client offered; 0 for none.
عرف اختر_من_تفضيل_تي_إل_إس(التفضيل: &متجه غير_موقع, العرض: &متجه غير_موقع): غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*التفضيل) مثل غير_موقع)) {
        لو (يحتوي_رقما_تي_إل_إس(العرض, (*التفضيل)[ف])) { أرجع (*التفضيل)[ف]; };
        ف := ف + 1;
    }
    أرجع 0;
}

// The index of the client's share for المجموعة, if it sent one.
عرف موضع_مشاركة_تي_إل_إس(الترحيب: &ترحيب_عميل_تي_إل_إس, المجموعة: غير_موقع): اختيار غير_موقع {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الترحيب).مجموعات_المشاركات) مثل غير_موقع)) {
        لو ((*الترحيب).مجموعات_المشاركات[ف] == المجموعة) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// The server's preferred group among the client's shares; 0 for none.
عرف مجموعة_بمشاركة_تي_إل_إس(الترحيب: &ترحيب_عميل_تي_إل_إس): غير_موقع {
    دع التفضيل: متجه غير_موقع = المجموعات_المدعومة_تي_إل_إس();
    أرجع اختر_من_تفضيل_تي_إل_إس(&التفضيل, &(*الترحيب).مجموعات_المشاركات);
}

// The CertificateVerify scheme for the identity key among the client's
// signature_algorithms; 0 when none fits.
عرف مخطط_توقيع_الهوية_تي_إل_إس(المفتاح: &مفتاح_خاص_تي_إل_إس, المعروضة: &متجه غير_موقع): غير_موقع {
    طابق *المفتاح مع
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_آر_إس_إيه(_) -> {
        دع التفضيل: متجه غير_موقع = [0x0804, 0x0805, 0x0806];
        أرجع اختر_من_تفضيل_تي_إل_إس(&التفضيل, المعروضة);
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إي_سي(المفتاح_إي_سي) -> {
        دع المطلوب: متغير غير_موقع = مخطط_إي_سي_دي_إس_إيه_بي256_تي_إل_إس();
        طابق المفتاح_إي_سي.المنحنى مع
        | منحنى_إهليلجي.منحنى_بي256 -> { المطلوب := مخطط_إي_سي_دي_إس_إيه_بي256_تي_إل_إس(); }
        | منحنى_إهليلجي.منحنى_بي384 -> { المطلوب := مخطط_إي_سي_دي_إس_إيه_بي384_تي_إل_إس(); };
        لو (يحتوي_رقما_تي_إل_إس(المعروضة, المطلوب)) { أرجع المطلوب; };
        أرجع 0;
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إد25519(_) -> {
        لو (يحتوي_رقما_تي_إل_إس(المعروضة, مخطط_إد25519_تي_إل_إس())) { أرجع مخطط_إد25519_تي_إل_إس(); };
        أرجع 0;
    };
}

// Signs the CertificateVerify content with the identity key.
عرف وقع_تحقق_الشهادة_تي_إل_إس(المفتاح: &مفتاح_خاص_تي_إل_إس, المخطط: غير_موقع, المحتوى: &متجه غ8): نتيجة متجه غ8, عدد {
    طابق *المفتاح مع
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_آر_إس_إيه(المفتاح_آر_إس_إيه) -> {
        دع تجزئة_التوقيع: خوارزمية_تجزئة = تجزئة_مخطط_بي_إس_إس_تي_إل_إس(المخطط);
        دع ملخص_التوقيع: متجه غ8 = جزئ_تشفير(تجزئة_التوقيع, المحتوى);
        طابق بايتات_عشوائية_تي_إل_إس(حجم_ملخص_تجزئة(تجزئة_التوقيع)) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الملح) -> {
            طابق وقع_آر_إس_إيه_بي_إس_إس(&المفتاح_آر_إس_إيه, تجزئة_التوقيع, &ملخص_التوقيع, &الملح) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); }
            | اختيار.بعض(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
        };
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إي_سي(المفتاح_إي_سي) -> {
        دع التجزئة: متغير خوارزمية_تجزئة = خوارزمية_تجزئة.تجزئة_شا256();
        لو (المخطط == مخطط_إي_سي_دي_إس_إيه_بي384_تي_إل_إس()) { التجزئة := خوارزمية_تجزئة.تجزئة_شا384(); };
        دع الملخص: متجه غ8 = جزئ_تشفير(التجزئة, المحتوى);
        طابق وقع_إي_سي_دي_إس_إيه(المفتاح_إي_سي.المنحنى, التجزئة, &المفتاح_إي_سي.الخاص, &الملخص) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); }
        | اختيار.بعض(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إد25519(البذرة) -> {
        طابق وقع_إد25519(&البذرة, المحتوى) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); }
        | اختيار.بعض(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    };
}

عرف تجزئة_مخطط_بي_إس_إس_تي_إل_إس(المخطط: غير_موقع): خوارزمية_تجزئة {
    لو (المخطط == مخطط_بي_إس_إس_شا384_تي_إل_إس()) { أرجع خوارزمية_تجزئة.تجزئة_شا384(); };
    لو (المخطط == مخطط_بي_إس_إس_شا512_تي_إل_إس()) { أرجع خوارزمية_تجزئة.تجزئة_شا512(); };
    أرجع خوارزمية_تجزئة.تجزئة_شا256();
}

عرف نفذ_مصافحة_خادم_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة عدد, عدد {
    دع الهوية: هوية_محللة_تي_إل_إس;
    طابق حلل_هوية_بي_كي_سي_إس12_تي_إل_إس(&(*الإعداد).الهوية.بي_كي_سي12, &(*الإعداد).الهوية.كلمة_المرور) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الهوية := القيمة; };

    دع الرسالة: متغير متجه غ8;
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
    دع الترحيب: متغير ترحيب_عميل_تي_إل_إس;
    طابق حلل_ترحيب_العميل_تي_إل_إس(&الرسالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الترحيب := القيمة; };
    لو (!يحتوي_رقما_تي_إل_إس(&الترحيب.الإصدارات, 0x0304)) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    لو (الترحيب.بيانات_مبكرة) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    دع تفضيل_الحزم: متجه غير_موقع = [0x1303, 0x1301, 0x1302];
    دع الحزمة: غير_موقع = اختر_من_تفضيل_تي_إل_إس(&تفضيل_الحزم, &الترحيب.الحزم);
    لو (الحزمة == 0) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    دع المخطط: غير_موقع = مخطط_توقيع_الهوية_تي_إل_إس(&الهوية.المفتاح, &الترحيب.المخططات);
    لو (المخطط == 0) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    (*الحالة).الحزمة := الحزمة;
    دع الخوارزمية: خوارزمية_تجزئة = تجزئة_الحزمة_تي_إل_إس(الحزمة);
    دع النص: متغير متجه غ8 = [];
    ألحق_بايتات_تشفير(&متغير النص, &الرسالة);
    دع أرسل_الوهمي: متغير منطقي = خطأ;
    دع وضع_التوافق: منطقي = (الطول(الترحيب.معرف_الجلسة) مثل غير_موقع) > 0;

    دع المجموعة: متغير غير_موقع = مجموعة_بمشاركة_تي_إل_إس(&الترحيب);
    لو (المجموعة == 0) {
        دع تفضيل_المجموعات: متجه غير_موقع = المجموعات_المدعومة_تي_إل_إس();
        المجموعة := اختر_من_تفضيل_تي_إل_إس(&تفضيل_المجموعات, &الترحيب.المجموعات);
        لو (المجموعة == 0) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
        // HelloRetryRequest for a share of the selected group (4.1.4).
        النص := بديل_ملخص_ترحيب_خادم_تي_إل_إس(الخوارزمية, &الرسالة);
        دع مشاركة_الإعادة: متغير متجه غ8 = [];
        ألحق_كبير16_تشفير(&متغير مشاركة_الإعادة, المجموعة);
        دع نص_الإعادة: متجه غ8 = بايتات_من_نص(«HelloRetryRequest»);
        دع عشوائي_الإعادة: متجه غ8 = جزئ_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), &نص_الإعادة);
        دع الإعادة: متجه غ8 = ابن_ترحيب_الخادم_تي_إل_إس(&عشوائي_الإعادة, &الترحيب.معرف_الجلسة, الحزمة, &مشاركة_الإعادة);
        طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &الإعادة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ألحق_بايتات_تشفير(&متغير النص, &الإعادة);
        لو (وضع_التوافق) {
            طابق أرسل_تغيير_تشفير_وهمي_تي_إل_إس(الحالة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            أرسل_الوهمي := صواب;
        };
        طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
        طابق حلل_ترحيب_العميل_تي_إل_إس(&الرسالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الترحيب := القيمة; };
        // The second ClientHello must carry exactly the requested share.
        دع مشاركة_مطابقة: منطقي = (الطول(الترحيب.مجموعات_المشاركات) مثل غير_موقع) == 1
            && الترحيب.مجموعات_المشاركات[0] == المجموعة;
        لو (!مشاركة_مطابقة || !يحتوي_رقما_تي_إل_إس(&الترحيب.الحزم, الحزمة)
            || الترحيب.بيانات_مبكرة || !يحتوي_رقما_تي_إل_إس(&الترحيب.الإصدارات, 0x0304)) {
            أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
        };
        ألحق_بايتات_تشفير(&متغير النص, &الرسالة);
    };

    // ServerHello with a fresh share of the selected group.
    دع العشوائي: متجه غ8;
    طابق بايتات_عشوائية_تي_إل_إس(32) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { العشوائي := القيمة; };
    دع مشاركة_الخادم: متغير مشاركة_مفتاح_تي_إل_إس;
    طابق أنشئ_مشاركة_مفتاح_تي_إل_إس(المجموعة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { مشاركة_الخادم := القيمة; };
    دع موضع_النظير: غير_موقع;
    طابق موضع_مشاركة_تي_إل_إس(&الترحيب, المجموعة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); }
    | اختيار.بعض(القيمة) -> { موضع_النظير := القيمة; };
    دع المشترك: متغير متجه غ8;
    طابق سر_مشاركة_مفتاح_تي_إل_إس(&مشاركة_الخادم, &الترحيب.مفاتيح_المشاركات[موضع_النظير]) مع
    | نتيجة.خطأ(الخطأ) -> { امسح_مشاركة_مفتاح_تي_إل_إس(&متغير مشاركة_الخادم); أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { المشترك := القيمة; };
    امسح_مشاركة_مفتاح_تي_إل_إس(&متغير مشاركة_الخادم);
    دع المشاركة: متغير متجه غ8 = [];
    ألحق_كبير16_تشفير(&متغير المشاركة, المجموعة);
    ألحق_متجها_تي_إل_إس(&متغير المشاركة, 2, &مشاركة_الخادم.العام);
    دع ترحيب_الخادم: متجه غ8 = ابن_ترحيب_الخادم_تي_إل_إس(&العشوائي, &الترحيب.معرف_الجلسة, الحزمة, &المشاركة);
    لو (!لا_مصافحة_معلقة_تي_إل_إس(الحالة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &ترحيب_الخادم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ألحق_بايتات_تشفير(&متغير النص, &ترحيب_الخادم);
    لو (وضع_التوافق && !أرسل_الوهمي) {
        طابق أرسل_تغيير_تشفير_وهمي_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };

    // Key schedule (7.1) and the server's encrypted flight.
    دع طول_الملخص: غير_موقع = حجم_ملخص_تجزئة(الخوارزمية);
    دع أصفار: متجه غ8 = أصفار_تشفير(طول_الملخص);
    دع لا_ملح: متجه غ8 = [];
    دع المبكر: متجه غ8 = هكدف_استخرج_تشفير(الخوارزمية, &لا_ملح, &أصفار);
    دع مشتق1: متجه غ8 = سر_مشتق_تالي_تي_إل_إس(الخوارزمية, &المبكر);
    دع سر_المصافحة: متغير متجه غ8 = هكدف_استخرج_تشفير(الخوارزمية, &مشتق1, &المشترك);
    امسح_بايتات_تشفير(&متغير المشترك);
    دع ملخص_الترحيب: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
    دع عميل_مصافحة: متغير متجه غ8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &سر_المصافحة, «c hs traffic», &ملخص_الترحيب);
    دع خادم_مصافحة: متغير متجه غ8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &سر_المصافحة, «s hs traffic», &ملخص_الترحيب);
    فعل_مفاتيح_تي_إل_إس(الحالة, صواب, &خادم_مصافحة);
    فعل_مفاتيح_تي_إل_إس(الحالة, خطأ, &عميل_مصافحة);

    دع جسم_الامتدادات: متجه غ8 = [0, 0];
    دع الامتدادات_المشفرة: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_امتدادات_مشفرة_تي_إل_إس(), &جسم_الامتدادات);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &الامتدادات_المشفرة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ألحق_بايتات_تشفير(&متغير النص, &الامتدادات_المشفرة);

    دع اطلب_شهادة: منطقي = (*الإعداد).تحقق_العميل;
    لو (اطلب_شهادة) {
        // CertificateRequest: empty context, signature_algorithms (4.3.2).
        دع جسم_الطلب: متغير متجه غ8 = [0];
        دع المخططات: متجه غير_موقع = [0x0807, 0x0403, 0x0503, 0x0804, 0x0805, 0x0806];
        دع القائمة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المخططات) مثل غير_موقع)) {
            ألحق_كبير16_تشفير(&متغير القائمة, المخططات[ف]);
            ف := ف + 1;
        }
        دع بيانات_التواقيع: متغير متجه غ8 = [];
        ألحق_متجها_تي_إل_إس(&متغير بيانات_التواقيع, 2, &القائمة);
        دع امتدادات_الطلب: متغير متجه غ8 = [];
        ألحق_كبير16_تشفير(&متغير امتدادات_الطلب, امتداد_خوارزميات_التوقيع_تي_إل_إس());
        ألحق_متجها_تي_إل_إس(&متغير امتدادات_الطلب, 2, &بيانات_التواقيع);
        ألحق_متجها_تي_إل_إس(&متغير جسم_الطلب, 2, &امتدادات_الطلب);
        دع رسالة_الطلب: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_طلب_شهادة_تي_إل_إس(), &جسم_الطلب);
        طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &رسالة_الطلب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ألحق_بايتات_تشفير(&متغير النص, &رسالة_الطلب);
    };

    // Certificate: empty context, then each certificate without extensions.
    دع القائمة_المرمزة: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الهوية.السلسلة) مثل غير_موقع)) {
        ألحق_متجها_تي_إل_إس(&متغير القائمة_المرمزة, 3, &الهوية.السلسلة[ف]);
        ألحق_كبير16_تشفير(&متغير القائمة_المرمزة, 0);
        ف := ف + 1;
    }
    دع جسم_الشهادة: متغير متجه غ8 = [0];
    ألحق_متجها_تي_إل_إس(&متغير جسم_الشهادة, 3, &القائمة_المرمزة);
    دع رسالة_الشهادة: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_شهادة_تي_إل_إس(), &جسم_الشهادة);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &رسالة_الشهادة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ألحق_بايتات_تشفير(&متغير النص, &رسالة_الشهادة);

    // CertificateVerify with the identity key (4.4.3).
    دع ملخص_حتى_الشهادة: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
    دع المحتوى: متجه غ8 = محتوى_تحقق_الشهادة_تي_إل_إس(صواب, &ملخص_حتى_الشهادة);
    دع التوقيع: متجه غ8;
    طابق وقع_تحقق_الشهادة_تي_إل_إس(&الهوية.المفتاح, المخطط, &المحتوى) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { التوقيع := القيمة; };
    دع جسم_التحقق: متغير متجه غ8 = [];
    ألحق_كبير16_تشفير(&متغير جسم_التحقق, المخطط);
    ألحق_متجها_تي_إل_إس(&متغير جسم_التحقق, 2, &التوقيع);
    دع رسالة_التحقق: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_تحقق_شهادة_تي_إل_إس(), &جسم_التحقق);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &رسالة_التحقق) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ألحق_بايتات_تشفير(&متغير النص, &رسالة_التحقق);

    // Server Finished.
    دع ملخص_حتى_التحقق: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
    دع بيانات_الخادم: متجه غ8 = بيانات_الإنهاء_تي_إل_إس(الخوارزمية, &خادم_مصافحة, &ملخص_حتى_التحقق);
    دع إنهاء_الخادم: متجه غ8 = رسالة_مصافحة_تي_إل_إس(رسالة_إنهاء_تي_إل_إس(), &بيانات_الخادم);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &إنهاء_الخادم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ألحق_بايتات_تشفير(&متغير النص, &إنهاء_الخادم);

    دع مشتق2: متجه غ8 = سر_مشتق_تالي_تي_إل_إس(الخوارزمية, &سر_المصافحة);
    دع السر_الرئيس: متغير متجه غ8 = هكدف_استخرج_تشفير(الخوارزمية, &مشتق2, &أصفار);
    دع ملخص_حتى_الإنهاء: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
    دع عميل_تطبيق: متغير متجه غ8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &السر_الرئيس, «c ap traffic», &ملخص_حتى_الإنهاء);
    دع خادم_تطبيق: متغير متجه غ8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &السر_الرئيس, «s ap traffic», &ملخص_حتى_الإنهاء);
    فعل_مفاتيح_تي_إل_إس(الحالة, صواب, &خادم_تطبيق);

    // Client flight: optional Certificate/CertificateVerify, then Finished.
    دع رسالة_العميل: متغير متجه غ8;
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { رسالة_العميل := القيمة; };
    لو (اطلب_شهادة) {
        لو (رسالة_العميل[0] != (رسالة_شهادة_تي_إل_إس() مثل غ8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        دع لا_سياق: متجه غ8 = [];
        دع شهادات_العميل: متجه شهادة_إكس509;
        طابق حلل_رسالة_شهادة_تي_إل_إس(&رسالة_العميل, &لا_سياق) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { شهادات_العميل := القيمة; };
        // An empty list is certificate_required (116).
        لو ((الطول(شهادات_العميل) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(خطأ_شهادة_غير_موثوقة_تي_إل_إس()); };
        ألحق_بايتات_تشفير(&متغير النص, &رسالة_العميل);
        طابق وقت_الآن_بالثواني_تي_إل_إس() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الآن) -> {
            طابق جذور_ثقة_محللة_تي_إل_إس(&(*الإعداد).جذور_ثقة_العميل) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الجذور) -> {
                دع لا_اسم: متجه غ8 = [];
                دع الرمز: عدد = رمز_نتيجة_التحقق_تي_إل_إس(تحقق_سلسلة_شهادات_تي_إل_إس(&شهادات_العميل, &الجذور, &لا_اسم, الآن, غرض_تحقق_تي_إل_إس.غرض_عميل()));
                لو (الرمز != 0) { أرجع نتيجة.خطأ(الرمز); };
            };
        };
        طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { رسالة_العميل := القيمة; };
        لو (رسالة_العميل[0] != (رسالة_تحقق_شهادة_تي_إل_إس() مثل غ8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        طابق حلل_تحقق_الشهادة_تي_إل_إس(&رسالة_العميل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(التحقق_المستلم) -> {
            دع ملخص_العميل_حتى_الشهادة: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
            دع محتوى_العميل: متجه غ8 = محتوى_تحقق_الشهادة_تي_إل_إس(خطأ, &ملخص_العميل_حتى_الشهادة);
            لو (!تحقق_توقيع_مصافحة_تي_إل_إس(&شهادات_العميل[0].المفتاح, التحقق_المستلم.النوع, &محتوى_العميل, &التحقق_المستلم.البيانات)) {
                أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس());
            };
        };
        ألحق_بايتات_تشفير(&متغير النص, &رسالة_العميل);
        طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { رسالة_العميل := القيمة; };
    };
    لو (رسالة_العميل[0] != (رسالة_إنهاء_تي_إل_إس() مثل غ8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع ملخص_إنهاء_العميل: متجه غ8 = جزئ_تشفير(الخوارزمية, &النص);
    دع المتوقع: متجه غ8 = بيانات_الإنهاء_تي_إل_إس(الخوارزمية, &عميل_مصافحة, &ملخص_إنهاء_العميل);
    دع المستلم: متجه غ8 = شريحة_بايتات_تشفير(&رسالة_العميل, 4, (الطول(رسالة_العميل) مثل غير_موقع) - 4);
    لو (!بايتات_متساوية_بزمن_ثابت_تشفير(&المتوقع, &المستلم)) { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); };
    لو (!لا_مصافحة_معلقة_تي_إل_إس(الحالة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    فعل_مفاتيح_تي_إل_إس(الحالة, خطأ, &عميل_تطبيق);
    (*الحالة).المصافحة_مكتملة := صواب;
    امسح_بايتات_تشفير(&متغير سر_المصافحة);
    امسح_بايتات_تشفير(&متغير عميل_مصافحة);
    امسح_بايتات_تشفير(&متغير خادم_مصافحة);
    امسح_بايتات_تشفير(&متغير السر_الرئيس);
    امسح_بايتات_تشفير(&متغير عميل_تطبيق);
    امسح_بايتات_تشفير(&متغير خادم_تطبيق);
    أرجع نتيجة.نجح(0);
}

عرف بديل_ملخص_ترحيب_خادم_تي_إل_إس(الخوارزمية: خوارزمية_تجزئة, الترحيب_الأول: &متجه غ8): متجه غ8 {
    دع الملخص: متجه غ8 = جزئ_تشفير(الخوارزمية, الترحيب_الأول);
    أرجع رسالة_مصافحة_تي_إل_إس(رسالة_ملخص_الرسالة_تي_إل_إس(), &الملخص);
}

// Runs the server handshake on a fresh connection state. On failure the
// matching alert is sent and the state keeps the error.
عام عرف صافح_كخادم_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الإعداد: &إعداد_خادم_تي_إل_إس): نتيجة عدد, عدد {
    طابق نفذ_مصافحة_خادم_تي_إل_إس(الحالة, الإعداد) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
    | نتيجة.خطأ(الخطأ) -> {
        لو (الخطأ <= -2001 && الخطأ > -3000 && الخطأ != خطأ_انقطاع_تي_إل_إس()) {
            أرسل_تنبيها_تي_إل_إس(الحالة, تنبيه_لخطأ_تي_إل_إس(الخطأ));
        };
        (*الحالة).خطأ_دائم := الخطأ;
        أرجع نتيجة.خطأ(الخطأ);
    };
}
