                    // CurvePrivateKey ::= OCTET STRING (RFC 8410 7).
                    طابق اقرأ_جذر_دي_إي_آر(&الداخلي) مع
                    | اختياري.لا_شيء -> { الناتج := نتيجة.خطأ(تالف); }
                    | اختياري.موجود(البذرة_المرمزة) -> {
                        دع البذرة: متغير متجه ط8 = محتوى_دي_إي_آر(&الداخلي, &البذرة_المرمزة);
                        إذا (البذرة_المرمزة.الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر() || (الطول(البذرة) مثل طبيعي) != 32) {
