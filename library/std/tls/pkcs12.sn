                            طابق أبناء_بوسم_دي_إي_آر(المحتويات, &القيمة[0], وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                            | اختياري.موجود(الشهادة) -> {
                                إذا ((الطول(الشهادة) مثل طبيعي) == 2 && معرف_بي_كي_سي_إس12(المحتويات, &الشهادة[0], «1.2.840.113549.1.9.22.1»)) {
                                    طابق أبناء_بوسم_دي_إي_آر(المحتويات, &الشهادة[1], وسم_سياق_مركب_دي_إي_آر(0)) مع
                                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                                    | اختياري.موجود(الداخل) -> {
                                        إذا ((الطول(الداخل) مثل طبيعي) != 1 || الداخل[0].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
                                        ألحق(*الشهادات, محتوى_دي_إي_آر(المحتويات, &الداخل[0]));
                                    };
                                };
                            };
                        };
                    };
                };
                ف := ف + 1;
            }
            أرجع نتيجة.نجح(0);
        };
    };
}

// True when the certificate carries the public half of the private key.
عرف شهادة_تطابق_المفتاح_تي_إل_إس(الشهادة: &شهادة_إكس509, المفتاح: &مفتاح_خاص_تي_إل_إس): منطقي {
    طابق *المفتاح مع
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_آر_إس_إيه(الخاص) -> {
        طابق (*الشهادة).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_آر_إس_إيه_إكس509(العام) -> {
            أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&العام.المعامل, &الخاص.العام.المعامل);
        }
        | _ -> { أرجع خطأ; };
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إي_سي(الخاص) -> {
        طابق (*الشهادة).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_إي_سي_إكس509(العام) -> {
            إذا (العام.المنحنى != الخاص.المنحنى) { أرجع خطأ; };
            طابق مفتاح_عام_إي_سي_دي_إس_إيه(الخاص.المنحنى, &الخاص.الخاص) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(النقطة) -> { أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&النقطة, &العام.النقطة); };
        }
        | _ -> { أرجع خطأ; };
    }
    | مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إد25519(البذرة) -> {
        طابق (*الشهادة).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_إد25519_إكس509(العام) -> {
            طابق مفتاح_عام_إد25519(&البذرة) مع
            | اختياري.لا_شيء -> { أرجع خطأ; }
            | اختياري.موجود(المحسوب) -> { أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&المحسوب, &العام); };
        }
        | _ -> { أرجع خطأ; };
    };
}

// Decodes a PKCS#12 container into one private key and its certificate chain
// (the certificate whose key matches first, the others after it).
عام عرف حلل_هوية_بي_كي_سي_إس12_تي_إل_إس(المدخل: &متجه ط8, كلمة_المرور: &متجه ط8): نتيجة هوية_محللة_تي_إل_إس, عدد {
    دع تالف: عدد = خطأ_ترميز_تي_إل_إس();
    دع الموحد: متجه ط8;
    طابق حول_بي_إي_آر_إلى_دي_إي_آر(المدخل) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(القيمة) -> { الموحد := القيمة; };
    دع البيانات: &متجه ط8 = &الموحد;
    دع كلمة_بي_إم_بي: متجه ط8;
    طابق كلمة_مرور_بي_إم_بي_بي_كي_سي_إس12(كلمة_المرور) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_وسيط_تي_إل_إس()); }
    | اختياري.موجود(القيمة) -> { كلمة_بي_إم_بي := القيمة; };
    دع الآمنة_الخام: متجه ط8;
    طابق اقرأ_جذر_دي_إي_آر(البيانات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(البيانات, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(الحقول) -> {
            دع العدد: طبيعي = الطول(الحقول) مثل طبيعي;
            إذا (العدد < 2 || العدد > 3) { أرجع نتيجة.خطأ(تالف); };
            طابق عدد_صغير_دي_إي_آر(البيانات, &الحقول[0]) مع
            | اختياري.موجود(الإصدار) -> { إذا (الإصدار != 3) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); }; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
            طابق أبناء_بوسم_دي_إي_آر(البيانات, &الحقول[1], وسم_تسلسل_دي_إي_آر()) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
            | اختياري.موجود(المعلومات) -> {
                إذا ((الطول(المعلومات) مثل طبيعي) == 0 || !معرف_بي_كي_سي_إس12(البيانات, &المعلومات[0], «1.2.840.113549.1.7.1»)) {
                    أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس());
                };
                طابق بيانات_معلومات_المحتوى_بي_كي_سي_إس12(البيانات, &المعلومات) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(القيمة) -> { الآمنة_الخام := القيمة; };
            };
            إذا (العدد == 3) {
                // MacData ::= SEQUENCE { mac DigestInfo, macSalt, iterations DEFAULT 1 }.
                طابق أبناء_بوسم_دي_إي_آر(البيانات, &الحقول[2], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(الماك) -> {
                    دع عدد_الماك: طبيعي = الطول(الماك) مثل طبيعي;
                    إذا (عدد_الماك < 2 || الماك[1].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
                    دع الملح: متجه ط8 = محتوى_دي_إي_آر(البيانات, &الماك[1]);
                    دع التكرارات: متغير طبيعي = 1;
                    إذا (عدد_الماك == 3) {
                        طابق عدد_صغير_دي_إي_آر(البيانات, &الماك[2]) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(القيمة) -> { التكرارات := القيمة; };
                    };
                    إذا (التكرارات == 0 || التكرارات > 10000000) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
                    طابق أبناء_بوسم_دي_إي_آر(البيانات, &الماك[0], وسم_تسلسل_دي_إي_آر()) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                    | اختياري.موجود(الملخص) -> {
                        إذا ((الطول(الملخص) مثل طبيعي) != 2 || الملخص[1].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
                        طابق أبناء_بوسم_دي_إي_آر(البيانات, &الملخص[0], وسم_تسلسل_دي_إي_آر()) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(الخوارزمية) -> {
                            إذا ((الطول(الخوارزمية) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(تالف); };
                            دع التجزئة: متغير خوارزمية_تجزئة = خوارزمية_تجزئة.تجزئة_شا1();
                            إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «1.3.14.3.2.26»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا1(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «2.16.840.1.101.3.4.2.1»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا256(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «2.16.840.1.101.3.4.2.2»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا384(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «2.16.840.1.101.3.4.2.3»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا512(); }
                            وإلا { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
                            دع المفتاح: متغير متجه ط8 = اشتق_بي_كي_سي_إس12(التجزئة, 3, &كلمة_بي_إم_بي, &الملح, التكرارات, حجم_ملخص_تجزئة(التجزئة));
                            دع المحسوب: متجه ط8 = هماك_تشفير(التجزئة, &المفتاح, &الآمنة_الخام);
                            امسح_بايتات_تشفير(&متغير المفتاح);
                            دع المستلم: متجه ط8 = محتوى_دي_إي_آر(البيانات, &الملخص[1]);
                            إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&المحسوب, &المستلم)) { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); };
                        };
                    };
                };
            };
        };
    };

    // AuthenticatedSafe ::= SEQUENCE OF ContentInfo (data or encryptedData).
    // The MAC covers its octets as stored; parsing uses the DER form.
    دع الآمنة: متجه ط8;
    طابق حول_بي_إي_آر_إلى_دي_إي_آر(&الآمنة_الخام) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(القيمة) -> { الآمنة := القيمة; };
    دع المفاتيح: متغير متجه مفتاح_خاص_تي_إل_إس = [];
    دع الشهادات: متغير متجه متجه ط8 = [];
    طابق اقرأ_جذر_دي_إي_آر(&الآمنة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(&الآمنة, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(القائمة) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(القائمة) مثل طبيعي)) {
                طابق أبناء_بوسم_دي_إي_آر(&الآمنة, &القائمة[ف], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(المعلومات) -> {
                    إذا ((الطول(المعلومات) مثل طبيعي) != 2) { أرجع نتيجة.خطأ(تالف); };
                    إذا (معرف_بي_كي_سي_إس12(&الآمنة, &المعلومات[0], «1.2.840.113549.1.7.1»)) {
                        طابق بيانات_معلومات_المحتوى_بي_كي_سي_إس12(&الآمنة, &المعلومات) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(المحتويات) -> {
                            طابق اجمع_حقائب_بي_كي_سي_إس12(&المحتويات, كلمة_المرور, &كلمة_بي_إم_بي, &متغير المفاتيح, &متغير الشهادات) مع
                            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                            | نتيجة.نجح(_) -> { };
                        };
                    } وإلا إذا (معرف_بي_كي_سي_إس12(&الآمنة, &المعلومات[0], «1.2.840.113549.1.7.6»)) {
                        // EncryptedData ::= SEQUENCE { version, EncryptedContentInfo }.
                        طابق أبناء_بوسم_دي_إي_آر(&الآمنة, &المعلومات[1], وسم_سياق_مركب_دي_إي_آر(0)) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(الغلاف) -> {
                            إذا ((الطول(الغلاف) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(تالف); };
                            طابق أبناء_بوسم_دي_إي_آر(&الآمنة, &الغلاف[0], وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                            | اختياري.موجود(المشفرة) -> {
                                إذا ((الطول(المشفرة) مثل طبيعي) < 2) { أرجع نتيجة.خطأ(تالف); };
                                طابق أبناء_بوسم_دي_إي_آر(&الآمنة, &المشفرة[1], وسم_تسلسل_دي_إي_آر()) مع
                                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                                | اختياري.موجود(المحتوى) -> {
                                    // contentType, contentEncryptionAlgorithm, [0] IMPLICIT OCTET STRING.
                                    إذا ((الطول(المحتوى) مثل طبيعي) != 3) {
                                        أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس());
                                    };
                                    دع البيانات_المشفرة: متجه ط8;
                                    طابق سلسلة_ضمنية_بي_كي_سي_إس12(&الآمنة, &المحتوى[2]) مع
                                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); }
                                    | اختياري.موجود(القيمة) -> { البيانات_المشفرة := القيمة; };
                                    طابق فك_محمي_بي_كي_سي_إس12(&الآمنة, &المحتوى[1], &البيانات_المشفرة, كلمة_المرور, &كلمة_بي_إم_بي) مع
                                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                                    | نتيجة.نجح(المحتويات) -> {
                                        طابق اجمع_حقائب_بي_كي_سي_إس12(&المحتويات, كلمة_المرور, &كلمة_بي_إم_بي, &متغير المفاتيح, &متغير الشهادات) مع
                                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                                        | نتيجة.نجح(_) -> { };
                                    };
                                };
                            };
                        };
                    } وإلا {
                        أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس());
                    };
                };
                ف := ف + 1;
            }
        };
    };

    إذا ((الطول(المفاتيح) مثل طبيعي) != 1 || (الطول(الشهادات) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    // Order the chain: the certificate matching the key first.
    دع السلسلة: متغير متجه متجه ط8 = [];
    دع الورقة: متغير طبيعي = الطول(الشهادات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الشهادات) مثل طبيعي)) {
        طابق حلل_شهادة_إكس509(&الشهادات[ف]) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(الشهادة) -> {
            إذا (الورقة == (الطول(الشهادات) مثل طبيعي) && شهادة_تطابق_المفتاح_تي_إل_إس(&الشهادة, &المفاتيح[0])) {
                الورقة := ف;
            };
        };
        ف := ف + 1;
    }
    إذا (الورقة == (الطول(الشهادات) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    // The decoded key and certificates are owned here: move them into the identity.
    دع ورقة_السلسلة: متغير متجه ط8 = [];
    بدّل(الشهادات[الورقة], ورقة_السلسلة);
    ألحق(السلسلة, ورقة_السلسلة);
    ف := 0;
    طالما (ف < (الطول(الشهادات) مثل طبيعي)) {
        إذا (ف != الورقة) {
            دع الشهادة: متغير متجه ط8 = [];
            بدّل(الشهادات[ف], الشهادة);
            ألحق(السلسلة, الشهادة);
        };
        ف := ف + 1;
    }
    دع بذرة_فارغة: متجه ط8 = [];
    دع المفتاح: متغير مفتاح_خاص_تي_إل_إس = مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إد25519(بذرة_فارغة);
    بدّل(المفاتيح[0], المفتاح);
    دع الهوية: هوية_محللة_تي_إل_إس = { المفتاح: المفتاح, السلسلة: السلسلة };
    أرجع نتيجة.نجح(الهوية);
}
