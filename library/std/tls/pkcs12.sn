// Collects keys and certificates from one SafeContents.
عرف اجمع_حقائب_بي_كي_سي_إس12(
    المدخل_الخام: &متجه ط8,
    كلمة_المرور: &متجه ط8,
    كلمة_بي_إم_بي: &متجه ط8,
    المفاتيح: &متغير متجه مفتاح_خاص_تي_إل_إس,
    الشهادات: &متغير متجه متجه ط8
