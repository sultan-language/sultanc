                                دع البيانات: متجه ط8 = محتوى_دي_إي_آر(المحتويات, &المشفر[1]);
                                طابق فك_محمي_بي_كي_سي_إس12(المحتويات, &المشفر[0], &البيانات, كلمة_المرور, كلمة_بي_إم_بي) مع
