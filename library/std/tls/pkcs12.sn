// Content of a ContentInfo of type id-data: the OCTET STRING inside [0].
عرف بيانات_معلومات_المحتوى_بي_كي_سي_إس12(المصدر: &متجه ط8, المعلومات: &متجه عنصر_دي_إي_آر): اختياري متجه ط8 {
    إذا ((الطول(*المعلومات) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
    طابق أبناء_بوسم_دي_إي_آر(المصدر, &(*المعلومات)[1], وسم_سياق_مركب_دي_إي_آر(0)) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الغلاف) -> {
        إذا ((الطول(الغلاف) مثل طبيعي) != 1 || الغلاف[0].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(محتوى_دي_إي_آر(المصدر, &الغلاف[0]));
