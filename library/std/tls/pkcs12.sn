                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                    | اختياري.موجود(القيمة) -> {
                        إذا ((الطول(القيمة) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(تالف); };
                        دع الترميز: متجه ط8 = ترميز_كامل_دي_إي_آر(المحتويات, &القيمة[0]);
