// PKCS#12 server identities (RFC 7292) and their private keys for the TLS
// server: PKCS#8 (RFC 5958) holding an RSA key (RFC 8017 A.1.2), an ECDSA
// P-256/P-384 key (RFC 5915, RFC 5480) or an Ed25519 key (RFC 8410).
//
// Supported protections: PBES2 with PBKDF2 (HMAC-SHA1/SHA-256/SHA-384/
// SHA-512) and AES-CBC (RFC 8018), the OpenSSL 3 default; and the legacy
// PKCS#12 PBE schemes pbeWithSHAAnd3-KeyTripleDES-CBC, pbeWithSHAAnd128BitRC2
// and pbeWithSHAAnd40BitRC2 with the RFC 7292 Appendix B key derivation,
// which LibreSSL and older OpenSSL produce. The MacData integrity check is
// verified whenever present, so a wrong password fails before any key is
// used. BER encodings (indefinite lengths, constructed strings), which
// Windows and Java write, are normalized to DER first (encoding.der).
// Previously only RSA keys and DER containers were accepted.

استورد crypto.aes;
استورد crypto.des;
استورد crypto.digest;
استورد crypto.ecdsa;
استورد crypto.ed25519;
استورد crypto.rc2;
استورد crypto.rsa;
استورد crypto.words;
استورد encoding.der;
استورد encoding.utf16;
استورد text.from_bytes;
استورد tls.errors;
استورد tls.x509;

// An ECDSA private scalar: big-endian bytes of the curve size.
عام نوع مفتاح_إي_سي_خاص_تي_إل_إس = {
    المنحنى: منحنى_إهليلجي,
    الخاص: متجه ط8
};

عام نوع مفتاح_خاص_تي_إل_إس =
    | مفتاح_خاص_آر_إس_إيه بنوع مفتاح_آر_إس_إيه_خاص
    | مفتاح_خاص_إي_سي بنوع مفتاح_إي_سي_خاص_تي_إل_إس
    // The 32-byte Ed25519 seed.
    | مفتاح_خاص_إد25519 بنوع متجه ط8
;

عام نوع هوية_محللة_تي_إل_إس = {
    المفتاح: مفتاح_خاص_تي_إل_إس,
    السلسلة: متجه متجه ط8
};

عرف معرف_بي_كي_سي_إس12(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر, النص: نص): منطقي {
    دع المتوقع: متجه ط8 = معرف_كائن_من_نص(النص);
    أرجع معرف_كائن_يساوي_دي_إي_آر(المصدر, العنصر, &المتوقع);
}

// The password as a NUL-terminated big-endian BMPString (RFC 7292 B.1).
عرف كلمة_مرور_بي_إم_بي_بي_كي_سي_إس12(كلمة_المرور: &متجه ط8): اختياري متجه ط8 {
    دع النص: نص = من_بايتات(كلمة_المرور);
    طابق نص_إلى_يوتيف16(&النص) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(الوحدات) -> {
        دع الناتج: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الوحدات) مثل طبيعي)) {
            دع الوحدة: طبيعي = الوحدات[ف] مثل طبيعي;
            ألحق(الناتج, (الوحدة >> 8) مثل ط8);
            ألحق(الناتج, (الوحدة & 0xFF) مثل ط8);
            ف := ف + 1;
        }
        ألحق(الناتج, 0 مثل ط8);
        ألحق(الناتج, 0 مثل ط8);
        أرجع اختياري.موجود(الناتج);
    };
}

عرف كرر_إلى_كتل_بي_كي_سي_إس12(البيانات: &متجه ط8, الكتلة: طبيعي): متجه ط8 {
    دع الحجم: طبيعي = الطول(*البيانات) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [];
    إذا (الحجم == 0) { أرجع الناتج; };
    دع الكلي: طبيعي = الكتلة * ((الحجم + الكتلة - 1) / الكتلة);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الكلي) {
        ألحق(الناتج, (*البيانات)[ف % الحجم]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Key material derivation of RFC 7292 Appendix B.2 (ID 1 key, 2 IV, 3 MAC).
عام عرف اشتق_بي_كي_سي_إس12(
    الخوارزمية: خوارزمية_تجزئة,
    المعرف: طبيعي,
    كلمة_المرور: &متجه ط8,
    الملح: &متجه ط8,
    التكرارات: طبيعي,
    الطول_المطلوب: طبيعي
): متجه ط8 {
    دع يو: طبيعي = حجم_ملخص_تجزئة(الخوارزمية);
    دع في: طبيعي = حجم_كتلة_تجزئة(الخوارزمية);
    دع دي: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < في) {
        ألحق(دي, المعرف مثل ط8);
        ف := ف + 1;
    }
    دع كتلة_آي: متغير متجه ط8 = كرر_إلى_كتل_بي_كي_سي_إس12(الملح, في);
    دع جزء_كلمة: متجه ط8 = كرر_إلى_كتل_بي_كي_سي_إس12(كلمة_المرور, في);
    ألحق_بايتات_تشفير(&متغير كتلة_آي, &جزء_كلمة);
    دع الناتج: متغير متجه ط8 = [];
    طالما ((الطول(الناتج) مثل طبيعي) < الطول_المطلوب) {
        دع المدخل: متغير متجه ط8 = [];
        ألحق_بايتات_تشفير(&متغير المدخل, &دي);
        ألحق_بايتات_تشفير(&متغير المدخل, &كتلة_آي);
        دع أ: متغير متجه ط8 = جزئ_تشفير(الخوارزمية, &المدخل);
        دع ر: متغير طبيعي = 1;
        طالما (ر < التكرارات) {
            أ := جزئ_تشفير(الخوارزمية, &أ);
            ر := ر + 1;
        }
        ف := 0;
        طالما (ف < يو && (الطول(الناتج) مثل طبيعي) < الطول_المطلوب) {
            ألحق(الناتج, أ[ف]);
            ف := ف + 1;
        }
        // I_j = (I_j + B + 1) mod 2^(8v) for every v-byte block of I.
        دع بي: متجه ط8 = كرر_إلى_كتل_بي_كي_سي_إس12(&أ, في);
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(كتلة_آي) مثل طبيعي)) {
            دع الحمل: متغير طبيعي = 1;
            دع ك: متغير طبيعي = في;
            طالما (ك > 0) {
                ك := ك - 1;
                دع مجموع: طبيعي = (كتلة_آي[ي + ك] مثل طبيعي) + (بي[ك] مثل طبيعي) + الحمل;
                كتلة_آي[ي + ك] := (مجموع & 0xFF) مثل ط8;
                الحمل := مجموع >> 8;
            }
            ي := ي + في;
        }
    }
    أرجع الناتج;
}

// Decrypts data protected by a PBES2 or PKCS#12 PBE AlgorithmIdentifier.
عرف فك_محمي_بي_كي_سي_إس12(
    المصدر: &متجه ط8,
    الخوارزمية: &عنصر_دي_إي_آر,
    المشفر: &متجه ط8,
    كلمة_المرور: &متجه ط8,
    كلمة_بي_إم_بي: &متجه ط8
): نتيجة متجه ط8, عدد {
    دع غير_مدعوم: عدد = خطأ_غير_مدعوم_تي_إل_إس();
    دع تالف: عدد = خطأ_ترميز_تي_إل_إس();
    طابق أبناء_بوسم_دي_إي_آر(المصدر, الخوارزمية, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الأجزاء) -> {
        إذا ((الطول(الأجزاء) مثل طبيعي) != 2) { أرجع نتيجة.خطأ(تالف); };
        طابق أبناء_بوسم_دي_إي_آر(المصدر, &الأجزاء[1], وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(المعاملات) -> {
            إذا (معرف_بي_كي_سي_إس12(المصدر, &الأجزاء[0], «1.2.840.113549.1.5.13»)) {
                // PBES2-params: keyDerivationFunc, encryptionScheme.
                إذا ((الطول(المعاملات) مثل طبيعي) != 2) { أرجع نتيجة.خطأ(تالف); };
                دع الاشتقاق: متجه عنصر_دي_إي_آر;
                دع التشفير: متجه عنصر_دي_إي_آر;
                طابق أبناء_بوسم_دي_إي_آر(المصدر, &المعاملات[0], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(القيمة) -> { الاشتقاق := القيمة; };
                طابق أبناء_بوسم_دي_إي_آر(المصدر, &المعاملات[1], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(القيمة) -> { التشفير := القيمة; };
                إذا ((الطول(الاشتقاق) مثل طبيعي) != 2 || (الطول(التشفير) مثل طبيعي) != 2) { أرجع نتيجة.خطأ(تالف); };
                إذا (!معرف_بي_كي_سي_إس12(المصدر, &الاشتقاق[0], «1.2.840.113549.1.5.12»)) { أرجع نتيجة.خطأ(غير_مدعوم); };
                دع حجم_المفتاح: متغير طبيعي = 0;
                إذا (معرف_بي_كي_سي_إس12(المصدر, &التشفير[0], «2.16.840.1.101.3.4.1.2»)) { حجم_المفتاح := 16; };
                إذا (معرف_بي_كي_سي_إس12(المصدر, &التشفير[0], «2.16.840.1.101.3.4.1.22»)) { حجم_المفتاح := 24; };
                إذا (معرف_بي_كي_سي_إس12(المصدر, &التشفير[0], «2.16.840.1.101.3.4.1.42»)) { حجم_المفتاح := 32; };
                إذا (حجم_المفتاح == 0) { أرجع نتيجة.خطأ(غير_مدعوم); };
                إذا (التشفير[1].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر() || التشفير[1].الطول != 16) { أرجع نتيجة.خطأ(تالف); };
                دع المتجه_الأولي: متجه ط8 = محتوى_دي_إي_آر(المصدر, &التشفير[1]);
                // PBKDF2-params: salt, iterationCount, keyLength?, prf?.
                طابق أبناء_بوسم_دي_إي_آر(المصدر, &الاشتقاق[1], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(بي_بي_كي_دي_إف) -> {
                    دع العدد: طبيعي = الطول(بي_بي_كي_دي_إف) مثل طبيعي;
                    إذا (العدد < 2 || بي_بي_كي_دي_إف[0].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(غير_مدعوم); };
                    دع الملح: متجه ط8 = محتوى_دي_إي_آر(المصدر, &بي_بي_كي_دي_إف[0]);
                    دع التكرارات: طبيعي;
                    طابق عدد_صغير_دي_إي_آر(المصدر, &بي_بي_كي_دي_إف[1]) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                    | اختياري.موجود(القيمة) -> { التكرارات := القيمة; };
                    إذا (التكرارات == 0 || التكرارات > 10000000) { أرجع نتيجة.خطأ(غير_مدعوم); };
                    دع التجزئة: متغير خوارزمية_تجزئة = خوارزمية_تجزئة.تجزئة_شا1();
                    دع م: متغير طبيعي = 2;
                    إذا (م < العدد && بي_بي_كي_دي_إف[م].الوسم == وسم_عدد_صحيح_دي_إي_آر()) {
                        طابق عدد_صغير_دي_إي_آر(المصدر, &بي_بي_كي_دي_إف[م]) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(القيمة) -> { إذا (القيمة != حجم_المفتاح) { أرجع نتيجة.خطأ(تالف); }; };
                        م := م + 1;
                    };
                    إذا (م < العدد) {
                        طابق أبناء_بوسم_دي_إي_آر(المصدر, &بي_بي_كي_دي_إف[م], وسم_تسلسل_دي_إي_آر()) مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                        | اختياري.موجود(الدالة) -> {
                            إذا ((الطول(الدالة) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(تالف); };
                            إذا (معرف_بي_كي_سي_إس12(المصدر, &الدالة[0], «1.2.840.113549.2.7»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا1(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(المصدر, &الدالة[0], «1.2.840.113549.2.9»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا256(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(المصدر, &الدالة[0], «1.2.840.113549.2.10»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا384(); }
                            وإلا إذا (معرف_بي_كي_سي_إس12(المصدر, &الدالة[0], «1.2.840.113549.2.11»)) { التجزئة := خوارزمية_تجزئة.تجزئة_شا512(); }
                            وإلا { أرجع نتيجة.خطأ(غير_مدعوم); };
                        };
                        م := م + 1;
                    };
                    إذا (م != العدد) { أرجع نتيجة.خطأ(تالف); };
                    طابق ببدف2_تشفير(التجزئة, كلمة_المرور, &الملح, التكرارات, حجم_المفتاح) مع
                    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                    | اختياري.موجود(المفتاح) -> {
                        دع مفتاح_قابل: متغير متجه ط8 = المفتاح;
                        دع الناتج: اختياري متجه ط8 = فك_أيس_سي_بي_سي(&مفتاح_قابل, &المتجه_الأولي, المشفر);
                        امسح_بايتات_تشفير(&متغير مفتاح_قابل);
                        طابق الناتج مع
                        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_فك_السجل_تي_إل_إس()); }
                        | اختياري.موجود(الصريح) -> { أرجع نتيجة.نجح(الصريح); };
                    };
                };
            };
            // PKCS#12 PBE: pkcs-12PbeParams ::= SEQUENCE { salt, iterations }.
            إذا ((الطول(المعاملات) مثل طبيعي) != 2 || المعاملات[0].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
            دع الملح: متجه ط8 = محتوى_دي_إي_آر(المصدر, &المعاملات[0]);
            دع التكرارات: طبيعي;
            طابق عدد_صغير_دي_إي_آر(المصدر, &المعاملات[1]) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
            | اختياري.موجود(القيمة) -> { التكرارات := القيمة; };
            إذا (التكرارات == 0 || التكرارات > 10000000) { أرجع نتيجة.خطأ(غير_مدعوم); };
            دع شا1: خوارزمية_تجزئة = خوارزمية_تجزئة.تجزئة_شا1();
            إذا (معرف_بي_كي_سي_إس12(المصدر, &الأجزاء[0], «1.2.840.113549.1.12.1.3»)) {
                دع المفتاح: متغير متجه ط8 = اشتق_بي_كي_سي_إس12(شا1, 1, كلمة_بي_إم_بي, &الملح, التكرارات, 24);
                دع المتجه_الأولي: متجه ط8 = اشتق_بي_كي_سي_إس12(شا1, 2, كلمة_بي_إم_بي, &الملح, التكرارات, 8);
                دع الناتج: اختياري متجه ط8 = فك_دي_إي_إس_الثلاثي_سي_بي_سي(&المفتاح, &المتجه_الأولي, المشفر);
                امسح_بايتات_تشفير(&متغير المفتاح);
                طابق الناتج مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_فك_السجل_تي_إل_إس()); }
                | اختياري.موجود(الصريح) -> { أرجع نتيجة.نجح(الصريح); };
            };
            دع بتات_آر_سي2: متغير طبيعي = 0;
            إذا (معرف_بي_كي_سي_إس12(المصدر, &الأجزاء[0], «1.2.840.113549.1.12.1.5»)) { بتات_آر_سي2 := 128; };
            إذا (معرف_بي_كي_سي_إس12(المصدر, &الأجزاء[0], «1.2.840.113549.1.12.1.6»)) { بتات_آر_سي2 := 40; };
            إذا (بتات_آر_سي2 == 0) { أرجع نتيجة.خطأ(غير_مدعوم); };
            دع المفتاح: متغير متجه ط8 = اشتق_بي_كي_سي_إس12(شا1, 1, كلمة_بي_إم_بي, &الملح, التكرارات, بتات_آر_سي2 / 8);
            دع المتجه_الأولي: متجه ط8 = اشتق_بي_كي_سي_إس12(شا1, 2, كلمة_بي_إم_بي, &الملح, التكرارات, 8);
            دع الناتج: اختياري متجه ط8 = فك_آر_سي2_سي_بي_سي(&المفتاح, بتات_آر_سي2, &المتجه_الأولي, المشفر);
            امسح_بايتات_تشفير(&متغير المفتاح);
            طابق الناتج مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_فك_السجل_تي_إل_إس()); }
            | اختياري.موجود(الصريح) -> { أرجع نتيجة.نجح(الصريح); };
        };
    };
}

// RSAPrivateKey (RFC 8017 A.1.2), two-prime form only.
عام عرف حلل_مفتاح_آر_إس_إيه_خاص_تي_إل_إس(البيانات: &متجه ط8): نتيجة مفتاح_آر_إس_إيه_خاص, عدد {
    دع تالف: عدد = خطأ_ترميز_تي_إل_إس();
    طابق اقرأ_جذر_دي_إي_آر(البيانات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(البيانات, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(الحقول) -> {
            إذا ((الطول(الحقول) مثل طبيعي) != 9) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
            طابق عدد_صغير_دي_إي_آر(البيانات, &الحقول[0]) مع
            | اختياري.موجود(الإصدار) -> { إذا (الإصدار != 0) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); }; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
            دع القيم: متغير متجه متجه ط8 = [];
            دع ف: متغير طبيعي = 1;
            طالما (ف < 9) {
                طابق عدد_صحيح_موجب_دي_إي_آر(البيانات, &الحقول[ف]) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(القيمة) -> { ألحق(القيم, القيمة); };
                ف := ف + 1;
            }
            دع العام: مفتاح_آر_إس_إيه_عام = أنشئ_مفتاح_آر_إس_إيه_عام(&القيم[0], &القيم[1]);
            دع الأول: &متجه ط8 = &القيم[3];
            دع الثاني: &متجه ط8 = &القيم[4];
            دع أس_أول: &متجه ط8 = &القيم[5];
            دع أس_ثان: &متجه ط8 = &القيم[6];
            دع المعامل: &متجه ط8 = &القيم[7];
            دع المفتاح: مفتاح_آر_إس_إيه_خاص = {
                العام: العام,
                الأولي_الأول: انسخ_بايتات(الأول),
                الأولي_الثاني: انسخ_بايتات(الثاني),
                أس_الأول: انسخ_بايتات(أس_أول),
                أس_الثاني: انسخ_بايتات(أس_ثان),
                معامل_الثاني: انسخ_بايتات(المعامل)
            };
            أرجع نتيجة.نجح(المفتاح);
        };
    };
}

// ECPrivateKey (RFC 5915 3): version 1, the private scalar, optional
// parameters and public key. The scalar is left-padded to the curve size.
عرف حلل_مفتاح_إي_سي_خاص_تي_إل_إس(البيانات: &متجه ط8, المنحنى: منحنى_إهليلجي): نتيجة مفتاح_خاص_تي_إل_إس, عدد {
    دع تالف: عدد = خطأ_ترميز_تي_إل_إس();
    دع الحجم: متغير طبيعي = 32;
    طابق المنحنى مع
    | منحنى_إهليلجي.منحنى_بي256 -> { الحجم := 32; }
    | منحنى_إهليلجي.منحنى_بي384 -> { الحجم := 48; };
    طابق اقرأ_جذر_دي_إي_آر(البيانات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(البيانات, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(الحقول) -> {
            إذا ((الطول(الحقول) مثل طبيعي) < 2 || الحقول[1].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
            طابق عدد_صغير_دي_إي_آر(البيانات, &الحقول[0]) مع
            | اختياري.موجود(الإصدار) -> { إذا (الإصدار != 1) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); }; }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); };
            دع الخام: متغير متجه ط8 = محتوى_دي_إي_آر(البيانات, &الحقول[1]);
            دع الطول_الخام: طبيعي = الطول(الخام) مثل طبيعي;
            إذا (الطول_الخام == 0 || الطول_الخام > الحجم) { امسح_بايتات_تشفير(&متغير الخام); أرجع نتيجة.خطأ(تالف); };
            دع الخاص: متغير متجه ط8 = أصفار_تشفير(الحجم - الطول_الخام);
            ألحق_بايتات_تشفير(&متغير الخاص, &الخام);
            امسح_بايتات_تشفير(&متغير الخام);
            // The scalar must be a valid key (1 <= d < n).
            طابق مفتاح_عام_إي_سي_دي_إس_إيه(المنحنى, &الخاص) مع
            | اختياري.لا_شيء -> { امسح_بايتات_تشفير(&متغير الخاص); أرجع نتيجة.خطأ(تالف); }
            | اختياري.موجود(_) -> { };
            دع المفتاح: مفتاح_إي_سي_خاص_تي_إل_إس = { المنحنى: المنحنى, الخاص: الخاص };
            أرجع نتيجة.نجح(مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إي_سي(المفتاح));
        };
    };
}

