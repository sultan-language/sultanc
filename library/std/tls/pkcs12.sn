        | اختياري.موجود(الحقائب) -> {
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الحقائب) مثل طبيعي)) {
                طابق أبناء_بوسم_دي_إي_آر(المحتويات, &الحقائب[ف], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
                | اختياري.موجود(الحقيبة) -> {
