                        } وإلا {
                            الناتج := نتيجة.نجح(مفتاح_خاص_تي_إل_إس.مفتاح_خاص_إد25519(البذرة));
                        };
                    };
                };
                امسح_بايتات_تشفير(&متغير الداخلي);
                أرجع الناتج;
