// id-ecPublicKey (P-256 or P-384) or id-Ed25519 key.
عام عرف حلل_مفتاح_بي_كي_سي_إس8_تي_إل_إس(البيانات: &متجه ط8): نتيجة مفتاح_خاص_تي_إل_إس, عدد {
    دع تالف: عدد = خطأ_ترميز_تي_إل_إس();
    طابق اقرأ_جذر_دي_إي_آر(البيانات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(البيانات, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(تالف); }
        | اختياري.موجود(الحقول) -> {
            إذا ((الطول(الحقول) مثل طبيعي) < 3) { أرجع نتيجة.خطأ(تالف); };
            إذا (الحقول[2].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع نتيجة.خطأ(تالف); };
            دع الداخلي: متغير متجه ط8 = محتوى_دي_إي_آر(البيانات, &الحقول[2]);
            طابق أبناء_بوسم_دي_إي_آر(البيانات, &الحقول[1], وسم_تسلسل_دي_إي_آر()) مع
            | اختياري.لا_شيء -> { امسح_بايتات_تشفير(&متغير الداخلي); أرجع نتيجة.خطأ(تالف); }
            | اختياري.موجود(الخوارزمية) -> {
                دع العدد: طبيعي = الطول(الخوارزمية) مثل طبيعي;
                إذا (العدد == 0) { امسح_بايتات_تشفير(&متغير الداخلي); أرجع نتيجة.خطأ(تالف); };
                دع الناتج: متغير نتيجة مفتاح_خاص_تي_إل_إس, عدد = نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس());
                إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «1.2.840.113549.1.1.1»)) {
                    طابق حلل_مفتاح_آر_إس_إيه_خاص_تي_إل_إس(&الداخلي) مع
                    | نتيجة.خطأ(الخطأ) -> { الناتج := نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(المفتاح) -> { الناتج := نتيجة.نجح(مفتاح_خاص_تي_إل_إس.مفتاح_خاص_آر_إس_إيه(المفتاح)); };
                } وإلا إذا (العدد == 2 && معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[0], «1.2.840.10045.2.1»)) {
                    إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[1], «1.2.840.10045.3.1.7»)) {
                        الناتج := حلل_مفتاح_إي_سي_خاص_تي_إل_إس(&الداخلي, منحنى_إهليلجي.منحنى_بي256());
                    } وإلا إذا (معرف_بي_كي_سي_إس12(البيانات, &الخوارزمية[1], «1.3.132.0.34»)) {
                        الناتج := حلل_مفتاح_إي_سي_خاص_تي_إل_إس(&الداخلي, منحنى_إهليلجي.منحنى_بي384());
