    };
}

// The value of an [0] IMPLICIT OCTET STRING: primitive (DER) or, in BER, a
// constructed element whose primitive OCTET STRING segments are joined.
عرف سلسلة_ضمنية_بي_كي_سي_إس12(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر): اختياري متجه ط8 {
    إذا ((*العنصر).الوسم == وسم_سياق_بسيط_دي_إي_آر(0)) { أرجع اختياري.موجود(محتوى_دي_إي_آر(المصدر, العنصر)); };
    إذا ((*العنصر).الوسم != وسم_سياق_مركب_دي_إي_آر(0)) { أرجع اختياري.لا_شيء(); };
    طابق أبناء_دي_إي_آر(المصدر, العنصر) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(المقاطع) -> {
        دع الناتج: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المقاطع) مثل طبيعي)) {
            إذا (المقاطع[ف].الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع اختياري.لا_شيء(); };
            دع الجزء: متجه ط8 = محتوى_دي_إي_آر(المصدر, &المقاطع[ف]);
            ألحق_بايتات_تشفير(&متغير الناتج, &الجزء);
            ف := ف + 1;
        }
        أرجع اختياري.موجود(الناتج);
