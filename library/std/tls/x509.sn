استورد text.from_bytes;
// X.509 v3 certificate parsing (RFC 5280 section 4) for TLS peer
// authentication. Parsing is strict DER through std.encoding.der. Only the
// fields that path validation and TLS use are extracted; extensions that are
// marked critical and are not understood here make the certificate unusable
// (RFC 5280 4.2), so validation fails closed.

استورد crypto.digest;
استورد crypto.ecdsa;
استورد crypto.ed25519;
استورد crypto.rsa;
استورد crypto.words;
استورد encoding.der;

عام نوع خوارزمية_توقيع_إكس509 =
    | توقيع_بي_كي_سي_إس1_إكس509 بنوع خوارزمية_تجزئة
    | توقيع_بي_إس_إس_إكس509 بنوع خوارزمية_تجزئة
    | توقيع_إي_سي_دي_إس_إيه_إكس509 بنوع خوارزمية_تجزئة
    // PureEdDSA over the TBSCertificate (RFC 8410 6).
    | توقيع_إد25519_إكس509
    | توقيع_غير_مدعوم_إكس509
;

عام نوع مفتاح_إي_سي_عام_إكس509 = {
    المنحنى: منحنى_إهليلجي,
    النقطة: متجه ط8
};

عام نوع مفتاح_عام_إكس509 =
    | مفتاح_آر_إس_إيه_إكس509 بنوع مفتاح_آر_إس_إيه_عام
    | مفتاح_إي_سي_إكس509 بنوع مفتاح_إي_سي_عام_إكس509
    // The 32-byte encoded point (RFC 8410 4).
    | مفتاح_إد25519_إكس509 بنوع متجه ط8
    | مفتاح_غير_مدعوم_إكس509
;

// One name-constraint subtree: a DNS name (القناع empty) or an IP address
// with its mask (RFC 5280 4.2.1.10).
عام نوع قيد_اسم_إكس509 = {
    نطاق: منطقي,
    القيمة: متجه ط8,
    القناع: متجه ط8
};

عام نوع شهادة_إكس509 = {
    الخام: متجه ط8,
    الجزء_الموقع: متجه ط8,
    خوارزمية_التوقيع: خوارزمية_توقيع_إكس509,
    التوقيع: متجه ط8,
    المصدر: متجه ط8,
    الموضوع: متجه ط8,
    ليس_قبل: عدد,
    ليس_بعد: عدد,
    المفتاح: مفتاح_عام_إكس509,
    الإصدار: طبيعي,
    له_قيود_أساسية: منطقي,
    سلطة: منطقي,
    حد_المسار: عدد,
    له_استخدام_المفتاح: منطقي,
    استخدام_المفتاح: طبيعي,
    له_استخدام_ممتد: منطقي,
    استخدام_خادم: منطقي,
    استخدام_عميل: منطقي,
    أسماء_النطاق: متجه متجه ط8,
    عناوين_آي_بي: متجه متجه ط8,
    قيود_مسموحة: متجه قيد_اسم_إكس509,
    قيود_مستبعدة: متجه قيد_اسم_إكس509,
    امتداد_حرج_غير_معالج: منطقي
};

// KeyUsage named bits (RFC 5280 4.2.1.3).
عام عرف استخدام_توقيع_رقمي_إكس509(): طبيعي { أرجع 1; }
عام عرف استخدام_توقيع_شهادات_إكس509(): طبيعي { أرجع 32; }

عرف معرف_إكس509(النص: نص): متجه ط8 {
    أرجع معرف_كائن_من_نص(النص);
}

عرف معرف_يساوي_إكس509(المصدر: &متجه ط8, العنصر: &عنصر_دي_إي_آر, النص: نص): منطقي {
    دع المتوقع: متجه ط8 = معرف_إكس509(النص);
    أرجع معرف_كائن_يساوي_دي_إي_آر(المصدر, العنصر, &المتوقع);
}

// Hash named by an AlgorithmIdentifier whose parameters are NULL or absent.
عرف تجزئة_من_معرف_إكس509(المصدر: &متجه ط8, المعرف: &عنصر_دي_إي_آر): اختياري خوارزمية_تجزئة {
    طابق أبناء_بوسم_دي_إي_آر(المصدر, المعرف, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأبناء) -> {
        دع العدد: طبيعي = الطول(الأبناء) مثل طبيعي;
        إذا (العدد == 0 || العدد > 2) { أرجع اختياري.لا_شيء(); };
        إذا (العدد == 2 && (الأبناء[1].الوسم != وسم_فارغ_دي_إي_آر() || الأبناء[1].الطول != 0)) { أرجع اختياري.لا_شيء(); };
        إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «2.16.840.1.101.3.4.2.1»)) { أرجع اختياري.موجود(خوارزمية_تجزئة.تجزئة_شا256()); };
        إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «2.16.840.1.101.3.4.2.2»)) { أرجع اختياري.موجود(خوارزمية_تجزئة.تجزئة_شا384()); };
        إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «2.16.840.1.101.3.4.2.3»)) { أرجع اختياري.موجود(خوارزمية_تجزئة.تجزئة_شا512()); };
        أرجع اختياري.لا_شيء();
    };
}

// RSASSA-PSS-params (RFC 4055 3.1) restricted to MGF1 with the same SHA-2
// digest, salt length equal to the digest length and trailer field 1.
عرف تجزئة_بي_إس_إس_إكس509(المصدر: &متجه ط8, المعاملات: &عنصر_دي_إي_آر): اختياري خوارزمية_تجزئة {
    دع التجزئة: متغير اختياري خوارزمية_تجزئة = اختياري.لا_شيء();
    دع تجزئة_القناع: متغير اختياري خوارزمية_تجزئة = اختياري.لا_شيء();
    دع الملح: متغير طبيعي = 20;
    طابق أبناء_بوسم_دي_إي_آر(المصدر, المعاملات, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأبناء) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الأبناء) مثل طبيعي)) {
            دع الوسم: طبيعي = الأبناء[ف].الوسم;
            طابق أبناء_دي_إي_آر(المصدر, &الأبناء[ف]) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الداخل) -> {
                إذا ((الطول(الداخل) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
                إذا (الوسم == وسم_سياق_مركب_دي_إي_آر(0)) {
                    التجزئة := تجزئة_من_معرف_إكس509(المصدر, &الداخل[0]);
                } وإلا إذا (الوسم == وسم_سياق_مركب_دي_إي_آر(1)) {
                    طابق أبناء_بوسم_دي_إي_آر(المصدر, &الداخل[0], وسم_تسلسل_دي_إي_آر()) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القناع) -> {
                        إذا ((الطول(القناع) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
                        إذا (!معرف_يساوي_إكس509(المصدر, &القناع[0], «1.2.840.113549.1.1.8»)) { أرجع اختياري.لا_شيء(); };
                        تجزئة_القناع := تجزئة_من_معرف_إكس509(المصدر, &القناع[1]);
                    };
                } وإلا إذا (الوسم == وسم_سياق_مركب_دي_إي_آر(2)) {
                    طابق عدد_صغير_دي_إي_آر(المصدر, &الداخل[0]) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> { الملح := القيمة; };
                } وإلا إذا (الوسم == وسم_سياق_مركب_دي_إي_آر(3)) {
                    طابق عدد_صغير_دي_إي_آر(المصدر, &الداخل[0]) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> { إذا (القيمة != 1) { أرجع اختياري.لا_شيء(); }; };
                } وإلا {
                    أرجع اختياري.لا_شيء();
                };
            };
            ف := ف + 1;
        }
    };
    طابق التجزئة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأولى) -> {
        طابق تجزئة_القناع مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الثانية) -> {
            إذا (الأولى != الثانية || الملح != حجم_ملخص_تجزئة(الأولى)) { أرجع اختياري.لا_شيء(); };
            أرجع اختياري.موجود(الأولى);
        };
    };
}

// Signature AlgorithmIdentifier (RFC 5280 4.1.1.2; RFC 4055; RFC 5758).
// SHA-1 and MD5 based algorithms are unsupported and therefore rejected.
عرف خوارزمية_توقيع_من_معرف_إكس509(المصدر: &متجه ط8, المعرف: &عنصر_دي_إي_آر): خوارزمية_توقيع_إكس509 {
    طابق أبناء_بوسم_دي_إي_آر(المصدر, المعرف, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع خوارزمية_توقيع_إكس509.توقيع_غير_مدعوم_إكس509(); }
    | اختياري.موجود(الأبناء) -> {
        دع العدد: طبيعي = الطول(الأبناء) مثل طبيعي;
        إذا (العدد == 0 || العدد > 2) { أرجع خوارزمية_توقيع_إكس509.توقيع_غير_مدعوم_إكس509(); };
        دع بلا_معاملات: منطقي = العدد == 1;
        دع معاملات_فارغة: منطقي = بلا_معاملات || (الأبناء[1].الوسم == وسم_فارغ_دي_إي_آر() && الأبناء[1].الطول == 0);
        إذا (معاملات_فارغة) {
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.113549.1.1.11»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_بي_كي_سي_إس1_إكس509(خوارزمية_تجزئة.تجزئة_شا256()); };
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.113549.1.1.12»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_بي_كي_سي_إس1_إكس509(خوارزمية_تجزئة.تجزئة_شا384()); };
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.113549.1.1.13»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_بي_كي_سي_إس1_إكس509(خوارزمية_تجزئة.تجزئة_شا512()); };
        };
        إذا (بلا_معاملات) {
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.10045.4.3.2»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_إي_سي_دي_إس_إيه_إكس509(خوارزمية_تجزئة.تجزئة_شا256()); };
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.10045.4.3.3»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_إي_سي_دي_إس_إيه_إكس509(خوارزمية_تجزئة.تجزئة_شا384()); };
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.10045.4.3.4»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_إي_سي_دي_إس_إيه_إكس509(خوارزمية_تجزئة.تجزئة_شا512()); };
            // id-Ed25519 with absent parameters (RFC 8410 3).
            إذا (معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.3.101.112»)) { أرجع خوارزمية_توقيع_إكس509.توقيع_إد25519_إكس509(); };
        };
        إذا (العدد == 2 && معرف_يساوي_إكس509(المصدر, &الأبناء[0], «1.2.840.113549.1.1.10»)) {
            طابق تجزئة_بي_إس_إس_إكس509(المصدر, &الأبناء[1]) مع
            | اختياري.موجود(التجزئة) -> { أرجع خوارزمية_توقيع_إكس509.توقيع_بي_إس_إس_إكس509(التجزئة); }
            | اختياري.لا_شيء -> { };
        };
        أرجع خوارزمية_توقيع_إكس509.توقيع_غير_مدعوم_إكس509();
    };
}

// SubjectPublicKeyInfo (RFC 5280 4.1.2.7; RFC 3279 2.3.1; RFC 5480 2).
عام عرف حلل_مفتاح_عام_إكس509(المصدر: &متجه ط8, المعلومات: &عنصر_دي_إي_آر): اختياري مفتاح_عام_إكس509 {
    طابق أبناء_بوسم_دي_إي_آر(المصدر, المعلومات, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأبناء) -> {
        إذا ((الطول(الأبناء) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
        دع المفتاح_الخام: متجه ط8;
        طابق سلسلة_بتات_كاملة_دي_إي_آر(المصدر, &الأبناء[1]) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { المفتاح_الخام := القيمة; };
        طابق أبناء_بوسم_دي_إي_آر(المصدر, &الأبناء[0], وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الخوارزمية) -> {
            دع العدد: طبيعي = الطول(الخوارزمية) مثل طبيعي;
            إذا (العدد == 0) { أرجع اختياري.لا_شيء(); };
            إذا (معرف_يساوي_إكس509(المصدر, &الخوارزمية[0], «1.2.840.113549.1.1.1»)) {
                طابق اقرأ_جذر_دي_إي_آر(&المفتاح_الخام) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(الجذر) -> {
                    طابق أبناء_بوسم_دي_إي_آر(&المفتاح_الخام, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(الأجزاء) -> {
                        إذا ((الطول(الأجزاء) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
                        طابق عدد_صحيح_موجب_دي_إي_آر(&المفتاح_الخام, &الأجزاء[0]) مع
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                        | اختياري.موجود(المعامل) -> {
                            طابق عدد_صحيح_موجب_دي_إي_آر(&المفتاح_الخام, &الأجزاء[1]) مع
                            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                            | اختياري.موجود(الأس) -> {
                                دع العام: مفتاح_آر_إس_إيه_عام = أنشئ_مفتاح_آر_إس_إيه_عام(&المعامل, &الأس);
                                أرجع اختياري.موجود(مفتاح_عام_إكس509.مفتاح_آر_إس_إيه_إكس509(العام));
                            };
                        };
                    };
                };
            };
            إذا (العدد == 2 && معرف_يساوي_إكس509(المصدر, &الخوارزمية[0], «1.2.840.10045.2.1»)) {
                دع المنحنى: منحنى_إهليلجي;
                إذا (معرف_يساوي_إكس509(المصدر, &الخوارزمية[1], «1.2.840.10045.3.1.7»)) {
                    المنحنى := منحنى_إهليلجي.منحنى_بي256();
                } وإلا إذا (معرف_يساوي_إكس509(المصدر, &الخوارزمية[1], «1.3.132.0.34»)) {
                    المنحنى := منحنى_إهليلجي.منحنى_بي384();
                } وإلا {
                    أرجع اختياري.موجود(مفتاح_عام_إكس509.مفتاح_غير_مدعوم_إكس509());
                };
                دع المفتاح: مفتاح_إي_سي_عام_إكس509 = { المنحنى: المنحنى, النقطة: المفتاح_الخام };
                أرجع اختياري.موجود(مفتاح_عام_إكس509.مفتاح_إي_سي_إكس509(المفتاح));
            };
            إذا (العدد == 1 && معرف_يساوي_إكس509(المصدر, &الخوارزمية[0], «1.3.101.112»)) {
                إذا ((الطول(المفتاح_الخام) مثل طبيعي) != 32) { أرجع اختياري.لا_شيء(); };
                أرجع اختياري.موجود(مفتاح_عام_إكس509.مفتاح_إد25519_إكس509(المفتاح_الخام));
            };
            أرجع اختياري.موجود(مفتاح_عام_إكس509.مفتاح_غير_مدعوم_إكس509());
        };
    };
}

// Reads a GeneralSubtree base for name constraints; none for a form that
// these constraints do not implement (the certificate is then unusable).
عرف قيد_من_اسم_عام_إكس509(المصدر: &متجه ط8, الشجرة: &عنصر_دي_إي_آر): اختياري قيد_اسم_إكس509 {
    طابق أبناء_بوسم_دي_إي_آر(المصدر, الشجرة, وسم_تسلسل_دي_إي_آر()) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الأجزاء) -> {
        // minimum must be 0 (absent) and maximum absent (RFC 5280 4.2.1.10).
        إذا ((الطول(الأجزاء) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
        دع الأساس: &عنصر_دي_إي_آر = &الأجزاء[0];
        دع فارغ: متجه ط8 = [];
        إذا ((*الأساس).الوسم == وسم_سياق_بسيط_دي_إي_آر(2)) {
            دع القيد: قيد_اسم_إكس509 = { نطاق: صواب, القيمة: محتوى_دي_إي_آر(المصدر, الأساس), القناع: فارغ };
            أرجع اختياري.موجود(القيد);
        };
        إذا ((*الأساس).الوسم == وسم_سياق_بسيط_دي_إي_آر(7)) {
            دع المحتوى: متجه ط8 = محتوى_دي_إي_آر(المصدر, الأساس);
            دع الحجم: طبيعي = الطول(المحتوى) مثل طبيعي;
            إذا (الحجم != 8 && الحجم != 32) { أرجع اختياري.لا_شيء(); };
            دع النصف: طبيعي = الحجم / 2;
            دع القيد: قيد_اسم_إكس509 = {
                نطاق: خطأ,
                القيمة: شريحة_بايتات_تشفير(&المحتوى, 0, النصف),
                القناع: شريحة_بايتات_تشفير(&المحتوى, النصف, النصف)
            };
            أرجع اختياري.موجود(القيد);
        };
        أرجع اختياري.لا_شيء();
    };
}

// Fills the extension-derived fields; false when the extensions are
// malformed or duplicated.
عرف حلل_امتدادات_إكس509(المصدر: &متجه ط8, الحاوية: &عنصر_دي_إي_آر, الشهادة: &متغير شهادة_إكس509): منطقي {
    طابق أبناء_دي_إي_آر(المصدر, الحاوية) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الغلاف) -> {
        إذا ((الطول(الغلاف) مثل طبيعي) != 1) { أرجع خطأ; };
        طابق أبناء_بوسم_دي_إي_آر(المصدر, &الغلاف[0], وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع خطأ; }
        | اختياري.موجود(الامتدادات) -> {
            إذا ((الطول(الامتدادات) مثل طبيعي) == 0) { أرجع خطأ; };
            دع رأيت_أساسية: متغير منطقي = خطأ;
            دع رأيت_استخدام: متغير منطقي = خطأ;
            دع رأيت_ممتد: متغير منطقي = خطأ;
            دع رأيت_بديل: متغير منطقي = خطأ;
            دع رأيت_قيود: متغير منطقي = خطأ;
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(الامتدادات) مثل طبيعي)) {
                طابق أبناء_بوسم_دي_إي_آر(المصدر, &الامتدادات[ف], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع خطأ; }
                | اختياري.موجود(الأجزاء) -> {
                    دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
                    إذا (العدد < 2 || العدد > 3) { أرجع خطأ; };
                    دع حرج: متغير منطقي = خطأ;
                    إذا (العدد == 3) {
                        طابق منطقي_دي_إي_آر(المصدر, &الأجزاء[1]) مع
                        | اختياري.لا_شيء -> { أرجع خطأ; }
                        | اختياري.موجود(القيمة) -> { حرج := القيمة; };
                    };
                    دع القيمة_عنصر: &عنصر_دي_إي_آر = &الأجزاء[العدد - 1];
                    إذا ((*القيمة_عنصر).الوسم != وسم_سلسلة_ثمانيات_دي_إي_آر()) { أرجع خطأ; };
                    دع القيمة: متجه ط8 = محتوى_دي_إي_آر(المصدر, القيمة_عنصر);
                    دع المعرف: &عنصر_دي_إي_آر = &الأجزاء[0];
                    دع معالج: متغير منطقي = خطأ;
                    طابق اقرأ_جذر_دي_إي_آر(&القيمة) مع
                    | اختياري.لا_شيء -> {
                        // Undecodable values are fatal only for the extensions read here.
                        إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.19») || معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.15»)
                            || معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.37») || معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.17»)
                            || معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.30»)) {
                            أرجع خطأ;
                        };
                    }
                    | اختياري.موجود(الجذر) -> {
                        إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.19»)) {
                            // basicConstraints
                            إذا (رأيت_أساسية) { أرجع خطأ; };
                            رأيت_أساسية := صواب;
                            معالج := صواب;
                            طابق أبناء_بوسم_دي_إي_آر(&القيمة, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع خطأ; }
                            | اختياري.موجود(الحقول) -> {
                                (*الشهادة).له_قيود_أساسية := صواب;
                                دع م: متغير طبيعي = 0;
                                إذا (م < (الطول(الحقول) مثل طبيعي) && الحقول[م].الوسم == وسم_منطقي_دي_إي_آر()) {
                                    طابق منطقي_دي_إي_آر(&القيمة, &الحقول[م]) مع
                                    | اختياري.لا_شيء -> { أرجع خطأ; }
                                    | اختياري.موجود(سلطة) -> { (*الشهادة).سلطة := سلطة; };
                                    م := م + 1;
                                };
                                إذا (م < (الطول(الحقول) مثل طبيعي)) {
                                    طابق عدد_صغير_دي_إي_آر(&القيمة, &الحقول[م]) مع
                                    | اختياري.لا_شيء -> { أرجع خطأ; }
                                    | اختياري.موجود(الحد) -> { (*الشهادة).حد_المسار := الحد مثل عدد; };
                                    م := م + 1;
                                };
                                إذا (م != (الطول(الحقول) مثل طبيعي)) { أرجع خطأ; };
                            };
                        } وإلا إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.15»)) {
                            // keyUsage
                            إذا (رأيت_استخدام) { أرجع خطأ; };
                            رأيت_استخدام := صواب;
                            معالج := صواب;
                            طابق بتات_مسماة_دي_إي_آر(&القيمة, &الجذر) مع
                            | اختياري.لا_شيء -> { أرجع خطأ; }
                            | اختياري.موجود(البتات) -> {
                                (*الشهادة).له_استخدام_المفتاح := صواب;
                                (*الشهادة).استخدام_المفتاح := البتات;
                            };
                        } وإلا إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.37»)) {
                            // extKeyUsage
                            إذا (رأيت_ممتد) { أرجع خطأ; };
                            رأيت_ممتد := صواب;
                            معالج := صواب;
                            طابق أبناء_بوسم_دي_إي_آر(&القيمة, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع خطأ; }
                            | اختياري.موجود(المعرفات) -> {
                                (*الشهادة).له_استخدام_ممتد := صواب;
                                دع م: متغير طبيعي = 0;
                                طالما (م < (الطول(المعرفات) مثل طبيعي)) {
                                    إذا (معرف_يساوي_إكس509(&القيمة, &المعرفات[م], «2.5.29.37.0»)) {
                                        (*الشهادة).استخدام_خادم := صواب;
                                        (*الشهادة).استخدام_عميل := صواب;
                                    };
                                    إذا (معرف_يساوي_إكس509(&القيمة, &المعرفات[م], «1.3.6.1.5.5.7.3.1»)) { (*الشهادة).استخدام_خادم := صواب; };
                                    إذا (معرف_يساوي_إكس509(&القيمة, &المعرفات[م], «1.3.6.1.5.5.7.3.2»)) { (*الشهادة).استخدام_عميل := صواب; };
                                    م := م + 1;
                                }
                            };
                        } وإلا إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.17»)) {
                            // subjectAltName: dNSName [2] and iPAddress [7]
                            إذا (رأيت_بديل) { أرجع خطأ; };
                            رأيت_بديل := صواب;
                            معالج := صواب;
                            طابق أبناء_بوسم_دي_إي_آر(&القيمة, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع خطأ; }
                            | اختياري.موجود(الأسماء) -> {
                                دع م: متغير طبيعي = 0;
                                طالما (م < (الطول(الأسماء) مثل طبيعي)) {
                                    إذا (الأسماء[م].الوسم == وسم_سياق_بسيط_دي_إي_آر(2)) {
                                        ألحق((*الشهادة).أسماء_النطاق, محتوى_دي_إي_آر(&القيمة, &الأسماء[م]));
                                    } وإلا إذا (الأسماء[م].الوسم == وسم_سياق_بسيط_دي_إي_آر(7)) {
                                        ألحق((*الشهادة).عناوين_آي_بي, محتوى_دي_إي_آر(&القيمة, &الأسماء[م]));
                                    };
                                    م := م + 1;
                                }
                            };
                        } وإلا إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.30»)) {
                            // nameConstraints with dNSName and iPAddress subtrees
                            إذا (رأيت_قيود) { أرجع خطأ; };
                            رأيت_قيود := صواب;
                            معالج := صواب;
                            طابق أبناء_بوسم_دي_إي_آر(&القيمة, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
                            | اختياري.لا_شيء -> { أرجع خطأ; }
                            | اختياري.موجود(الأشجار) -> {
                                دع م: متغير طبيعي = 0;
                                طالما (م < (الطول(الأشجار) مثل طبيعي)) {
                                    دع مستبعدة: منطقي = الأشجار[م].الوسم == وسم_سياق_مركب_دي_إي_آر(1);
                                    إذا (!مستبعدة && الأشجار[م].الوسم != وسم_سياق_مركب_دي_إي_آر(0)) { أرجع خطأ; };
                                    طابق أبناء_دي_إي_آر(&القيمة, &الأشجار[م]) مع
                                    | اختياري.لا_شيء -> { أرجع خطأ; }
                                    | اختياري.موجود(البنود) -> {
                                        دع ن: متغير طبيعي = 0;
                                        طالما (ن < (الطول(البنود) مثل طبيعي)) {
                                            طابق قيد_من_اسم_عام_إكس509(&القيمة, &البنود[ن]) مع
                                            | اختياري.لا_شيء -> { معالج := خطأ; }
                                            | اختياري.موجود(القيد) -> {
                                                إذا (مستبعدة) { ألحق((*الشهادة).قيود_مستبعدة, القيد); }
                                                وإلا { ألحق((*الشهادة).قيود_مسموحة, القيد); };
                                            };
                                            ن := ن + 1;
                                        }
                                    };
                                    م := م + 1;
                                }
                            };
                            // An unsupported subtree form cannot be enforced: refuse the certificate.
                            إذا (!معالج) { (*الشهادة).امتداد_حرج_غير_معالج := صواب; };
                        } وإلا إذا (معرف_يساوي_إكس509(المصدر, المعرف, «2.5.29.32»)) {
                            // certificatePolicies: no relying-party policy is required.
                            معالج := صواب;
                        };
                    };
                    إذا (حرج && !معالج) { (*الشهادة).امتداد_حرج_غير_معالج := صواب; };
                };
                ف := ف + 1;
            }
            أرجع صواب;
        };
    };
}

// Parses one DER certificate; none when it is not a well-formed X.509 v1-v3
// certificate.
عام عرف حلل_شهادة_إكس509(الخام: &متجه ط8): اختياري شهادة_إكس509 {
    طابق اقرأ_جذر_دي_إي_آر(الخام) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الجذر) -> {
        طابق أبناء_بوسم_دي_إي_آر(الخام, &الجذر, وسم_تسلسل_دي_إي_آر()) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الأقسام) -> {
            إذا ((الطول(الأقسام) مثل طبيعي) != 3) { أرجع اختياري.لا_شيء(); };
            دع التوقيع: متجه ط8;
            طابق سلسلة_بتات_كاملة_دي_إي_آر(الخام, &الأقسام[2]) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { التوقيع := القيمة; };
            دع الخوارزمية: خوارزمية_توقيع_إكس509 = خوارزمية_توقيع_من_معرف_إكس509(الخام, &الأقسام[1]);
            دع معرف_الخارج: متجه ط8 = ترميز_كامل_دي_إي_آر(الخام, &الأقسام[1]);
            طابق أبناء_بوسم_دي_إي_آر(الخام, &الأقسام[0], وسم_تسلسل_دي_إي_آر()) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(الحقول) -> {
                دع العدد: طبيعي = الطول(الحقول) مثل طبيعي;
                دع م: متغير طبيعي = 0;
                دع الإصدار: متغير طبيعي = 0;
                إذا (العدد > 0 && الحقول[0].الوسم == وسم_سياق_مركب_دي_إي_آر(0)) {
                    طابق أبناء_دي_إي_آر(الخام, &الحقول[0]) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(الداخل) -> {
                        إذا ((الطول(الداخل) مثل طبيعي) != 1) { أرجع اختياري.لا_شيء(); };
                        طابق عدد_صغير_دي_إي_آر(الخام, &الداخل[0]) مع
                        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                        | اختياري.موجود(القيمة) -> { الإصدار := القيمة; };
                    };
                    م := 1;
                };
                إذا (الإصدار > 2 || العدد < م + 6) { أرجع اختياري.لا_شيء(); };
                // serialNumber (م), signature (م+1), issuer, validity, subject, spki
                إذا (الحقول[م].الوسم != وسم_عدد_صحيح_دي_إي_آر()) { أرجع اختياري.لا_شيء(); };
                دع معرف_الداخل: متجه ط8 = ترميز_كامل_دي_إي_آر(الخام, &الحقول[م + 1]);
                إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&معرف_الداخل, &معرف_الخارج)) { أرجع اختياري.لا_شيء(); };
                إذا (الحقول[م + 2].الوسم != وسم_تسلسل_دي_إي_آر() || الحقول[م + 4].الوسم != وسم_تسلسل_دي_إي_آر()) { أرجع اختياري.لا_شيء(); };
                دع المصدر_الخام: متجه ط8 = ترميز_كامل_دي_إي_آر(الخام, &الحقول[م + 2]);
                دع الموضوع_الخام: متجه ط8 = ترميز_كامل_دي_إي_آر(الخام, &الحقول[م + 4]);
                دع ليس_قبل: متغير عدد = 0;
                دع ليس_بعد: متغير عدد = 0;
                طابق أبناء_بوسم_دي_إي_آر(الخام, &الحقول[م + 3], وسم_تسلسل_دي_إي_آر()) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(المدة) -> {
                    إذا ((الطول(المدة) مثل طبيعي) != 2) { أرجع اختياري.لا_شيء(); };
                    طابق وقت_دي_إي_آر(الخام, &المدة[0]) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> { ليس_قبل := القيمة; };
                    طابق وقت_دي_إي_آر(الخام, &المدة[1]) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(القيمة) -> { ليس_بعد := القيمة; };
                };
                دع المفتاح: مفتاح_عام_إكس509;
                طابق حلل_مفتاح_عام_إكس509(الخام, &الحقول[م + 5]) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(القيمة) -> { المفتاح := القيمة; };
                دع أسماء: متجه متجه ط8 = [];
                دع عناوين: متجه متجه ط8 = [];
                دع مسموحة: متجه قيد_اسم_إكس509 = [];
                دع مستبعدة: متجه قيد_اسم_إكس509 = [];
                دع الشهادة: متغير شهادة_إكس509 = {
                    الخام: انسخ_بايتات(الخام),
                    الجزء_الموقع: ترميز_كامل_دي_إي_آر(الخام, &الأقسام[0]),
                    خوارزمية_التوقيع: الخوارزمية,
                    التوقيع: التوقيع,
                    المصدر: المصدر_الخام,
                    الموضوع: الموضوع_الخام,
                    ليس_قبل: ليس_قبل,
                    ليس_بعد: ليس_بعد,
                    المفتاح: المفتاح,
                    الإصدار: الإصدار + 1,
                    له_قيود_أساسية: خطأ,
                    سلطة: خطأ,
                    حد_المسار: -1,
                    له_استخدام_المفتاح: خطأ,
                    استخدام_المفتاح: 0,
                    له_استخدام_ممتد: خطأ,
                    استخدام_خادم: خطأ,
                    استخدام_عميل: خطأ,
                    أسماء_النطاق: أسماء,
                    عناوين_آي_بي: عناوين,
                    قيود_مسموحة: مسموحة,
                    قيود_مستبعدة: مستبعدة,
                    امتداد_حرج_غير_معالج: خطأ
                };
                // Optional issuerUniqueID [1], subjectUniqueID [2], extensions [3].
                دع ك: متغير طبيعي = م + 6;
                طالما (ك < العدد) {
                    دع الوسم: طبيعي = الحقول[ك].الوسم;
                    إذا (الوسم == وسم_سياق_مركب_دي_إي_آر(3)) {
                        إذا (الإصدار != 2) { أرجع اختياري.لا_شيء(); };
                        إذا (!حلل_امتدادات_إكس509(الخام, &الحقول[ك], &متغير الشهادة)) { أرجع اختياري.لا_شيء(); };
                    } وإلا إذا (الوسم != 0x81 && الوسم != 0x82 && الوسم != 0xA1 && الوسم != 0xA2) {
                        أرجع اختياري.لا_شيء();
                    };
                    ك := ك + 1;
                }
                أرجع اختياري.موجود(الشهادة);
            };
        };
    };
}

// Verifies that المصدر_المرشح's key signed الشهادة. SHA-1/MD5 and unknown
// algorithms never verify; key types must match the signature algorithm.
عام عرف تحقق_توقيع_شهادة_إكس509(الشهادة: &شهادة_إكس509, المصدر_المرشح: &شهادة_إكس509): منطقي {
    طابق (*الشهادة).خوارزمية_التوقيع مع
    | خوارزمية_توقيع_إكس509.توقيع_غير_مدعوم_إكس509 -> { أرجع خطأ; }
    | خوارزمية_توقيع_إكس509.توقيع_بي_كي_سي_إس1_إكس509(التجزئة) -> {
        دع الملخص: متجه ط8 = جزئ_تشفير(التجزئة, &(*الشهادة).الجزء_الموقع);
        طابق (*المصدر_المرشح).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_آر_إس_إيه_إكس509(العام) -> {
            أرجع تحقق_آر_إس_إيه_بي_كي_سي_إس1(&العام, التجزئة, &الملخص, &(*الشهادة).التوقيع);
        }
        | _ -> { أرجع خطأ; };
    }
    | خوارزمية_توقيع_إكس509.توقيع_بي_إس_إس_إكس509(التجزئة) -> {
        دع الملخص: متجه ط8 = جزئ_تشفير(التجزئة, &(*الشهادة).الجزء_الموقع);
        طابق (*المصدر_المرشح).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_آر_إس_إيه_إكس509(العام) -> {
            أرجع تحقق_آر_إس_إيه_بي_إس_إس(&العام, التجزئة, &الملخص, &(*الشهادة).التوقيع);
        }
        | _ -> { أرجع خطأ; };
    }
    | خوارزمية_توقيع_إكس509.توقيع_إي_سي_دي_إس_إيه_إكس509(التجزئة) -> {
        دع الملخص: متجه ط8 = جزئ_تشفير(التجزئة, &(*الشهادة).الجزء_الموقع);
        طابق (*المصدر_المرشح).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_إي_سي_إكس509(المفتاح) -> {
            أرجع تحقق_إي_سي_دي_إس_إيه(المفتاح.المنحنى, &المفتاح.النقطة, &الملخص, &(*الشهادة).التوقيع);
        }
        | _ -> { أرجع خطأ; };
    }
    | خوارزمية_توقيع_إكس509.توقيع_إد25519_إكس509 -> {
        طابق (*المصدر_المرشح).المفتاح مع
        | مفتاح_عام_إكس509.مفتاح_إد25519_إكس509(العام) -> {
            أرجع تحقق_إد25519(&العام, &(*الشهادة).الجزء_الموقع, &(*الشهادة).التوقيع);
        }
        | _ -> { أرجع خطأ; };
    };
}

عام مرادف x509_certificate = شهادة_إكس509;
عام مرادف x509_parse_certificate = حلل_شهادة_إكس509;
