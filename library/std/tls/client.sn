// TLS 1.3 client handshake (RFC 8446 2, 4.1-4.4, 7.1), following the state
// sequence of Go crypto/tls handshake_client_tls13.go and Rustls.
//
// Offered: TLS 1.3 only; TLS_CHACHA20_POLY1305_SHA256, TLS_AES_128_GCM_SHA256
// and TLS_AES_256_GCM_SHA384; X25519, secp256r1 and secp384r1 key exchange
// (an X25519 share first, another group after a HelloRetryRequest);
// Ed25519, ECDSA P-256/P-384 and RSA-PSS signatures; ALPN (RFC 7301) when
// the configuration lists protocols. No PSK, resumption or 0-RTT. A server that
// negotiates anything else, or TLS 1.2, is refused. With peer verification
// on (the default) the chain is validated against the configured roots or,
// when none are configured, the system anchors, and the leaf must name the
// configured server; with it off only the CertificateVerify signature is
// checked against the leaf key, as with Go's InsecureSkipVerify.

استورد crypto.digest;
استورد crypto.sha256;
استورد crypto.words;
استورد text.from_bytes;
استورد time.time;
استورد tls.config;
استورد tls.errors;
استورد tls.key_exchange;
استورد tls.record;
استورد tls.signature;
استورد tls.trust;
استورد tls.verify;
استورد tls.wire;
استورد tls.x509;

نوع ترحيب_خادم_تي_إل_إس = {
    العشوائي: متجه ط8,
    معرف_الجلسة: متجه ط8,
    الحزمة: طبيعي,
    الإصدار: طبيعي,
    المجموعة: طبيعي,
    مفتاح_المشاركة: متجه ط8,
    الكعكة: متجه ط8,
    إعادة: منطقي
};

عرف ألحق_امتدادا_تي_إل_إس(الهدف: &متغير متجه ط8, النوع: طبيعي, البيانات: &متجه ط8): فراغ {
    ألحق_كبير16_تشفير(الهدف, النوع);
    ألحق_متجها_تي_إل_إس(الهدف, 2, البيانات);
}

عرف عشوائي_إعادة_المحاولة_تي_إل_إس(): متجه ط8 {
    // SHA-256("HelloRetryRequest") (RFC 8446 4.1.3).
    دع النص: متجه ط8 = بايتات_من_نص(«HelloRetryRequest»);
    أرجع شا256(&النص);
}

عرف ابن_ترحيب_العميل_تي_إل_إس(
    العشوائي: &متجه ط8,
    معرف_الجلسة: &متجه ط8,
    مجموعة_المشاركة: طبيعي,
    المفتاح_العام: &متجه ط8,
    الاسم: &متجه ط8,
    الكعكة: &متجه ط8,
    البروتوكولات: &متجه نص
): متجه ط8 {
    دع الجسم: متغير متجه ط8 = [];
    ألحق_كبير16_تشفير(&متغير الجسم, 0x0303);
    ألحق_بايتات_تشفير(&متغير الجسم, العشوائي);
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 1, معرف_الجلسة);
    دع الحزم: متغير متجه ط8 = [];
    ألحق_كبير16_تشفير(&متغير الحزم, حزمة_تشاتشا20_تي_إل_إس());
    ألحق_كبير16_تشفير(&متغير الحزم, حزمة_أيس128_جي_سي_إم_تي_إل_إس());
    ألحق_كبير16_تشفير(&متغير الحزم, حزمة_أيس256_جي_سي_إم_تي_إل_إس());
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 2, &الحزم);
    دع الضغط: متجه ط8 = [0];
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 1, &الضغط);

    دع الامتدادات: متغير متجه ط8 = [];
    إذا ((الطول(*الاسم) مثل طبيعي) > 0) {
        دع المدخل: متغير متجه ط8 = [0];
        ألحق_متجها_تي_إل_إس(&متغير المدخل, 2, الاسم);
        دع القائمة: متغير متجه ط8 = [];
        ألحق_متجها_تي_إل_إس(&متغير القائمة, 2, &المدخل);
        ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_اسم_الخادم_تي_إل_إس(), &القائمة);
    };
    دع الإصدارات: متغير متجه ط8 = [2];
    ألحق_كبير16_تشفير(&متغير الإصدارات, 0x0304);
    ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_الإصدارات_تي_إل_إس(), &الإصدارات);
    دع المجموعات: متغير متجه ط8 = [];
    دع قائمة_المجموعات: متغير متجه ط8 = [];
    دع المدعومة: متجه طبيعي = المجموعات_المدعومة_تي_إل_إس();
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المدعومة) مثل طبيعي)) {
        ألحق_كبير16_تشفير(&متغير قائمة_المجموعات, المدعومة[م]);
        م := م + 1;
    }
    ألحق_متجها_تي_إل_إس(&متغير المجموعات, 2, &قائمة_المجموعات);
    ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_المجموعات_تي_إل_إس(), &المجموعات);
    دع المخططات: متجه طبيعي = مخططات_التوقيع_المعلنة_تي_إل_إس();
    دع قائمة_المخططات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المخططات) مثل طبيعي)) {
        ألحق_كبير16_تشفير(&متغير قائمة_المخططات, المخططات[ف]);
        ف := ف + 1;
    }
    دع التواقيع: متغير متجه ط8 = [];
    ألحق_متجها_تي_إل_إس(&متغير التواقيع, 2, &قائمة_المخططات);
    ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_خوارزميات_التوقيع_تي_إل_إس(), &التواقيع);
    دع المدخل_المشترك: متغير متجه ط8 = [];
    ألحق_كبير16_تشفير(&متغير المدخل_المشترك, مجموعة_المشاركة);
    ألحق_متجها_تي_إل_إس(&متغير المدخل_المشترك, 2, المفتاح_العام);
    دع المشاركة: متغير متجه ط8 = [];
    ألحق_متجها_تي_إل_إس(&متغير المشاركة, 2, &المدخل_المشترك);
    ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_مشاركة_المفتاح_تي_إل_إس(), &المشاركة);
    إذا ((الطول(*البروتوكولات) مثل طبيعي) > 0) {
        // application_layer_protocol_negotiation: ProtocolNameList (RFC 7301 3.1).
        دع الأسماء: متغير متجه ط8 = [];
        دع ب: متغير طبيعي = 0;
        طالما (ب < (الطول(*البروتوكولات) مثل طبيعي)) {
            دع الاسم_: متجه ط8 = بايتات_من_نص(انسخ_نص(&(*البروتوكولات)[ب]));
            ألحق_متجها_تي_إل_إس(&متغير الأسماء, 1, &الاسم_);
            ب := ب + 1;
        }
        دع القائمة_: متغير متجه ط8 = [];
        ألحق_متجها_تي_إل_إس(&متغير القائمة_, 2, &الأسماء);
        ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_تفاوض_البروتوكول_تي_إل_إس(), &القائمة_);
    };
    إذا ((الطول(*الكعكة) مثل طبيعي) > 0) {
        دع الكعكة_المرمزة: متغير متجه ط8 = [];
        ألحق_متجها_تي_إل_إس(&متغير الكعكة_المرمزة, 2, الكعكة);
        ألحق_امتدادا_تي_إل_إس(&متغير الامتدادات, امتداد_الكعكة_تي_إل_إس(), &الكعكة_المرمزة);
    };
    ألحق_متجها_تي_إل_إس(&متغير الجسم, 2, &الامتدادات);
    أرجع رسالة_مصافحة_تي_إل_إس(رسالة_ترحيب_العميل_تي_إل_إس(), &الجسم);
}

عرف حلل_ترحيب_الخادم_تي_إل_إس(الرسالة: &متجه ط8): نتيجة ترحيب_خادم_تي_إل_إس, عدد {
    إذا ((*الرسالة)[0] != (رسالة_ترحيب_الخادم_تي_إل_إس() مثل ط8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(الرسالة, 4);
    دع الإصدار_القديم: طبيعي = اقرأ_رقما_تي_إل_إس(&متغير ق, 2);
    دع العشوائي: متجه ط8 = اقرأ_بايتات_تي_إل_إس(&متغير ق, 32);
    دع معرف_الجلسة: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 1);
    دع الحزمة: طبيعي = اقرأ_رقما_تي_إل_إس(&متغير ق, 2);
    دع الضغط: طبيعي = اقرأ_رقما_تي_إل_إس(&متغير ق, 1);
    إذا (!ق.صالح) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    إذا (الإصدار_القديم != 0x0303 || الضغط != 0) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع الامتدادات: متجه امتداد_تي_إل_إس;
    طابق اقرأ_امتدادات_تي_إل_إس(&متغير ق) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
    | اختياري.موجود(القيمة) -> { الامتدادات := القيمة; };
    إذا (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    دع عشوائي_الإعادة: متجه ط8 = عشوائي_إعادة_المحاولة_تي_إل_إس();
    دع هي_إعادة: منطقي = بايتات_متساوية_بزمن_ثابت_تشفير(&العشوائي, &عشوائي_الإعادة);
    دع فارغ1: متجه ط8 = [];
    دع فارغ2: متجه ط8 = [];
    دع الترحيب: متغير ترحيب_خادم_تي_إل_إس = {
        العشوائي: العشوائي,
        معرف_الجلسة: معرف_الجلسة,
        الحزمة: الحزمة,
        الإصدار: 0,
        المجموعة: 0,
        مفتاح_المشاركة: فارغ1,
        الكعكة: فارغ2,
        إعادة: هي_إعادة
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الامتدادات) مثل طبيعي)) {
        دع النوع: طبيعي = الامتدادات[ف].النوع;
        دع م: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&الامتدادات[ف].البيانات, 0);
        إذا (النوع == امتداد_الإصدارات_تي_إل_إس()) {
            الترحيب.الإصدار := اقرأ_رقما_تي_إل_إس(&متغير م, 2);
        } وإلا إذا (النوع == امتداد_مشاركة_المفتاح_تي_إل_إس()) {
            الترحيب.المجموعة := اقرأ_رقما_تي_إل_إس(&متغير م, 2);
            إذا (!هي_إعادة) {
                الترحيب.مفتاح_المشاركة := اقرأ_متجها_تي_إل_إس(&متغير م, 2);
            };
        } وإلا إذا (النوع == امتداد_الكعكة_تي_إل_إس() && هي_إعادة) {
            الترحيب.الكعكة := اقرأ_متجها_تي_إل_إس(&متغير م, 2);
            إذا ((الطول(الترحيب.الكعكة) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        } وإلا {
            // Only extensions this client offered may appear (RFC 8446 4.1.3);
            // pre_shared_key was not offered.
            أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
        };
        إذا (!قارئ_منته_تي_إل_إس(&م)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الترحيب);
}

// message_hash replacement of ClientHello1 after a HelloRetryRequest (4.4.1).
عرف بديل_ملخص_الترحيب_تي_إل_إس(الخوارزمية: خوارزمية_تجزئة, الترحيب_الأول: &متجه ط8): متجه ط8 {
    دع الملخص: متجه ط8 = جزئ_تشفير(الخوارزمية, الترحيب_الأول);
    أرجع رسالة_مصافحة_تي_إل_إس(رسالة_ملخص_الرسالة_تي_إل_إس(), &الملخص);
}

// The current wall-clock time in Unix seconds for certificate validity.
عام عرف وقت_الآن_بالثواني_تي_إل_إس(): نتيجة عدد, عدد {
    طابق وقت_نظام_نانو() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النانو) -> { أرجع نتيجة.نجح(النانو / 1000000000); };
}

// Trust anchors: the configured roots, otherwise the system bundle.
عام عرف جذور_ثقة_محللة_تي_إل_إس(الجذور: &متجه شهادة_تي_إل_إس): نتيجة متجه شهادة_إكس509, عدد {
    إذا ((الطول(*الجذور) مثل طبيعي) == 0) { أرجع جذور_النظام_تي_إل_إس(); };
    دع الناتج: متغير متجه شهادة_إكس509 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجذور) مثل طبيعي)) {
        طابق حلل_شهادة_إكس509(&(*الجذور)[ف].دي_إي_آر) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس()); }
        | اختياري.موجود(الشهادة) -> { ألحق(الناتج, الشهادة); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// Certificate message (RFC 8446 4.4.2): the request context must equal
// السياق_المتوقع; returns the certificates in order.
عام عرف حلل_رسالة_شهادة_تي_إل_إس(الرسالة: &متجه ط8, السياق_المتوقع: &متجه ط8): نتيجة متجه شهادة_إكس509, عدد {
    دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(الرسالة, 4);
    دع السياق: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 1);
    دع القائمة: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 3);
    إذا (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&السياق, السياق_المتوقع)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع م: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&القائمة, 0);
    دع الشهادات: متغير متجه شهادة_إكس509 = [];
    طالما (متبقي_قارئ_تي_إل_إس(&م) > 0) {
        دع البيانات: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير م, 3);
        دع امتدادات_المدخل: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير م, 2);
        إذا (!م.صالح || (الطول(البيانات) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        إذا ((الطول(الشهادات) مثل طبيعي) >= 16) { أرجع نتيجة.خطأ(خطأ_شهادة_غير_موثوقة_تي_إل_إس()); };
        طابق حلل_شهادة_إكس509(&البيانات) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_شهادة_غير_موثوقة_تي_إل_إس()); }
        | اختياري.موجود(الشهادة) -> { ألحق(الشهادات, الشهادة); };
    }
    أرجع نتيجة.نجح(الشهادات);
}

// Maps a path-validation outcome to a std.tls status (0 for success).
عام عرف رمز_نتيجة_التحقق_تي_إل_إس(النتيجة: نتيجة_تحقق_شهادة_تي_إل_إس): عدد {
    طابق النتيجة مع
    | نتيجة_تحقق_شهادة_تي_إل_إس.سلسلة_موثوقة -> { أرجع 0; }
    | نتيجة_تحقق_شهادة_تي_إل_إس.لا_مسار_موثوق -> { أرجع خطأ_شهادة_غير_موثوقة_تي_إل_إس(); }
    | نتيجة_تحقق_شهادة_تي_إل_إس.شهادة_منتهية -> { أرجع خطأ_صلاحية_الشهادة_تي_إل_إس(); }
    | نتيجة_تحقق_شهادة_تي_إل_إس.اسم_غير_مطابق -> { أرجع خطأ_اسم_الشهادة_تي_إل_إس(); }
    | نتيجة_تحقق_شهادة_تي_إل_إس.شهادة_تالفة -> { أرجع خطأ_شهادة_غير_موثوقة_تي_إل_إس(); };
}

// CertificateVerify body: scheme and signature.
عام عرف حلل_تحقق_الشهادة_تي_إل_إس(الرسالة: &متجه ط8): نتيجة امتداد_تي_إل_إس, عدد {
    دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(الرسالة, 4);
    دع المخطط: طبيعي = اقرأ_رقما_تي_إل_إس(&متغير ق, 2);
    دع التوقيع: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 2);
    إذا (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    دع الناتج: امتداد_تي_إل_إس = { النوع: المخطط, البيانات: التوقيع };
    أرجع نتيجة.نجح(الناتج);
}

عرف نفذ_مصافحة_عميل_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة عدد, عدد {
    دع التحقق: منطقي = (*الإعداد).تحقق_النظير;
    دع الاسم: متغير متجه ط8 = [];
    طابق (*الإعداد).اسم_الخادم مع
    | اختياري.موجود(الاسم_النصي) -> { الاسم := بايتات_من_نص(انسخ_نص(&الاسم_النصي)); }
    | اختياري.لا_شيء -> { };
    // Verification needs a reference identity (Go: ServerName or InsecureSkipVerify).
    إذا (التحقق && (الطول(الاسم) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_هوية_الخادم_تي_إل_إس()); };
    // ALPN protocol names are 1..255 bytes (RFC 7301 3.1).
    دع ب_: متغير طبيعي = 0;
    طالما (ب_ < (الطول((*الإعداد).البروتوكولات) مثل طبيعي)) {
        دع طول_الاسم: طبيعي = الطول((*الإعداد).البروتوكولات[ب_]) مثل طبيعي;
        إذا (طول_الاسم == 0 || طول_الاسم > 255) { أرجع نتيجة.خطأ(خطأ_وسيط_تي_إل_إس()); };
        ب_ := ب_ + 1;
    }
    // server_name carries DNS names only, never IP literals (RFC 6066 3).
    دع اسم_الإشارة: متغير متجه ط8 = [];
    طابق عنوان_آي_بي_مضيف_تي_إل_إس(&الاسم) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> { اسم_الإشارة := بايتات_بلا_نقطة_ختامية_تي_إل_إس(&الاسم); };

    دع العشوائي: متجه ط8;
    دع معرف_الجلسة: متجه ط8;
    طابق بايتات_عشوائية_تي_إل_إس(64) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(البذور) -> {
        العشوائي := شريحة_بايتات_تشفير(&البذور, 0, 32);
        معرف_الجلسة := شريحة_بايتات_تشفير(&البذور, 32, 32);
    };
    // The first ClientHello carries an X25519 share; secp256r1 and secp384r1
    // are offered in supported_groups and used after a HelloRetryRequest.
    دع المشاركة: متغير مشاركة_مفتاح_تي_إل_إس;
    طابق أنشئ_مشاركة_مفتاح_تي_إل_إس(مجموعة_إكس25519_تي_إل_إس()) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { المشاركة := القيمة; };
    دع لا_كعكة: متجه ط8 = [];
    دع الترحيب_الأول: متجه ط8 = ابن_ترحيب_العميل_تي_إل_إس(&العشوائي, &معرف_الجلسة, المشاركة.المجموعة, &المشاركة.العام, &اسم_الإشارة, &لا_كعكة, &(*الإعداد).البروتوكولات);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &الترحيب_الأول) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    دع النص: متغير متجه ط8 = [];
    ألحق_بايتات_تشفير(&متغير النص, &الترحيب_الأول);
    دع رسالة_الخادم: متغير متجه ط8;
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { رسالة_الخادم := القيمة; };
    دع الترحيب: متغير ترحيب_خادم_تي_إل_إس;
    طابق حلل_ترحيب_الخادم_تي_إل_إس(&رسالة_الخادم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الترحيب := القيمة; };
    دع أرسل_الوهمي: متغير منطقي = خطأ;

    إذا (الترحيب.إعادة) {
        // HelloRetryRequest (RFC 8446 4.1.4). A requested group must be one
        // this client offered and not the group of the share already sent;
        // the retry must change something (a group or a cookie).
        إذا (الترحيب.الإصدار != 0x0304 || !حزمة_مدعومة_تي_إل_إس(الترحيب.الحزمة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        إذا (الترحيب.المجموعة == 0 && (الطول(الترحيب.الكعكة) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        إذا (الترحيب.المجموعة != 0) {
            إذا (!مجموعة_مدعومة_تي_إل_إس(الترحيب.المجموعة) || الترحيب.المجموعة == المشاركة.المجموعة) {
                أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
            };
            امسح_مشاركة_مفتاح_تي_إل_إس(&متغير المشاركة);
            طابق أنشئ_مشاركة_مفتاح_تي_إل_إس(الترحيب.المجموعة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { المشاركة := القيمة; };
        };
        إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&الترحيب.معرف_الجلسة, &معرف_الجلسة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        دع حزمة_الإعادة: طبيعي = الترحيب.الحزمة;
        دع خوارزمية_الإعادة: خوارزمية_تجزئة = تجزئة_الحزمة_تي_إل_إس(حزمة_الإعادة);
        النص := بديل_ملخص_الترحيب_تي_إل_إس(خوارزمية_الإعادة, &الترحيب_الأول);
        ألحق_بايتات_تشفير(&متغير النص, &رسالة_الخادم);
        طابق أرسل_تغيير_تشفير_وهمي_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        أرسل_الوهمي := صواب;
        دع الترحيب_الثاني: متجه ط8 = ابن_ترحيب_العميل_تي_إل_إس(&العشوائي, &معرف_الجلسة, المشاركة.المجموعة, &المشاركة.العام, &اسم_الإشارة, &الترحيب.الكعكة, &(*الإعداد).البروتوكولات);
        طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &الترحيب_الثاني) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ألحق_بايتات_تشفير(&متغير النص, &الترحيب_الثاني);
        طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { رسالة_الخادم := القيمة; };
        طابق حلل_ترحيب_الخادم_تي_إل_إس(&رسالة_الخادم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الترحيب := القيمة; };
        إذا (الترحيب.إعادة || الترحيب.الحزمة != حزمة_الإعادة) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    };

    // ServerHello (RFC 8446 4.1.3, 4.2.1, 4.2.8).
    إذا (الترحيب.الإصدار != 0x0304) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    إذا (!حزمة_مدعومة_تي_إل_إس(الترحيب.الحزمة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&الترحيب.معرف_الجلسة, &معرف_الجلسة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    إذا (الترحيب.المجموعة != المشاركة.المجموعة) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    إذا (!لا_مصافحة_معلقة_تي_إل_إس(الحالة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    ألحق_بايتات_تشفير(&متغير النص, &رسالة_الخادم);
    (*الحالة).الحزمة := الترحيب.الحزمة;
    دع الخوارزمية: خوارزمية_تجزئة = تجزئة_الحزمة_تي_إل_إس(الترحيب.الحزمة);
    دع طول_الملخص: طبيعي = حجم_ملخص_تجزئة(الخوارزمية);
    دع المشترك: متغير متجه ط8;
    طابق سر_مشاركة_مفتاح_تي_إل_إس(&المشاركة, &الترحيب.مفتاح_المشاركة) مع
    | نتيجة.خطأ(الخطأ) -> { امسح_مشاركة_مفتاح_تي_إل_إس(&متغير المشاركة); أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { المشترك := القيمة; };
    امسح_مشاركة_مفتاح_تي_إل_إس(&متغير المشاركة);

    // Key schedule (RFC 8446 7.1) without PSK.
    دع أصفار: متجه ط8 = أصفار_تشفير(طول_الملخص);
    دع لا_ملح: متجه ط8 = [];
    دع المبكر: متجه ط8 = هكدف_استخرج_تشفير(الخوارزمية, &لا_ملح, &أصفار);
    دع مشتق1: متجه ط8 = سر_مشتق_تالي_تي_إل_إس(الخوارزمية, &المبكر);
    دع سر_المصافحة: متغير متجه ط8 = هكدف_استخرج_تشفير(الخوارزمية, &مشتق1, &المشترك);
    امسح_بايتات_تشفير(&متغير المشترك);
    دع ملخص_الترحيب: متجه ط8 = جزئ_تشفير(الخوارزمية, &النص);
    دع عميل_مصافحة: متغير متجه ط8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &سر_المصافحة, «c hs traffic», &ملخص_الترحيب);
    دع خادم_مصافحة: متغير متجه ط8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &سر_المصافحة, «s hs traffic», &ملخص_الترحيب);
    إذا (!أرسل_الوهمي) {
        طابق أرسل_تغيير_تشفير_وهمي_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    فعل_مفاتيح_تي_إل_إس(الحالة, خطأ, &خادم_مصافحة);
    فعل_مفاتيح_تي_إل_إس(الحالة, صواب, &عميل_مصافحة);

    // EncryptedExtensions (RFC 8446 4.3.1).
    دع الامتدادات_المشفرة: متجه ط8;
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الامتدادات_المشفرة := القيمة; };
    إذا (الامتدادات_المشفرة[0] != (رسالة_امتدادات_مشفرة_تي_إل_إس() مثل ط8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع قارئ_الامتدادات: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&الامتدادات_المشفرة, 4);
    طابق اقرأ_امتدادات_تي_إل_إس(&متغير قارئ_الامتدادات) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
    | اختياري.موجود(القائمة) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القائمة) مثل طبيعي)) {
            دع النوع: طبيعي = القائمة[ف].النوع;
            إذا (النوع == امتداد_تفاوض_البروتوكول_تي_إل_إس()) {
                // The selected protocol: one name, one the client offered (RFC 7301 3.1).
                دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&القائمة[ف].البيانات, 0);
                دع الأسماء: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير ق, 2);
                إذا (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
                دع م: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&الأسماء, 0);
                دع المختار: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير م, 1);
                إذا (!قارئ_منته_تي_إل_إس(&م) || (الطول(المختار) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
                دع معروض: متغير منطقي = خطأ;
                دع ب: متغير طبيعي = 0;
                طالما (ب < (الطول((*الإعداد).البروتوكولات) مثل طبيعي)) {
                    دع المعروض: متجه ط8 = بايتات_من_نص(انسخ_نص(&(*الإعداد).البروتوكولات[ب]));
                    إذا (بايتات_متساوية_بزمن_ثابت_تشفير(&المعروض, &المختار)) { معروض := صواب; };
                    ب := ب + 1;
                }
                إذا (!معروض) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
                (*الحالة).البروتوكول_المتفاوض := المختار;
            };
            // ServerHello-only extensions must not appear here.
            إذا (النوع == امتداد_مشاركة_المفتاح_تي_إل_إس()
                || النوع == امتداد_الإصدارات_تي_إل_إس() || النوع == امتداد_مفتاح_مشترك_مسبقا_تي_إل_إس()) {
                أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
            };
            ف := ف + 1;
        }
    };
    إذا (!قارئ_منته_تي_إل_إس(&قارئ_الامتدادات)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    ألحق_بايتات_تشفير(&متغير النص, &الامتدادات_المشفرة);

    // Optional CertificateRequest, then Certificate (RFC 8446 4.3.2, 4.4.2).
    دع الرسالة: متغير متجه ط8;
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
    دع طلب_شهادة: متغير منطقي = خطأ;
    دع سياق_الطلب: متغير متجه ط8 = [];
    إذا (الرسالة[0] == (رسالة_طلب_شهادة_تي_إل_إس() مثل ط8)) {
        دع ق: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&الرسالة, 4);
        سياق_الطلب := اقرأ_متجها_تي_إل_إس(&متغير ق, 1);
        طابق اقرأ_امتدادات_تي_إل_إس(&متغير ق) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); }
        | اختياري.موجود(_) -> { };
        إذا (!قارئ_منته_تي_إل_إس(&ق)) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        طلب_شهادة := صواب;
        ألحق_بايتات_تشفير(&متغير النص, &الرسالة);
        طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
    };
    إذا (الرسالة[0] != (رسالة_شهادة_تي_إل_إس() مثل ط8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع لا_سياق: متجه ط8 = [];
    دع الشهادات: متجه شهادة_إكس509;
    طابق حلل_رسالة_شهادة_تي_إل_إس(&الرسالة, &لا_سياق) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الشهادات := القيمة; };
    إذا ((الطول(الشهادات) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
    ألحق_بايتات_تشفير(&متغير النص, &الرسالة);
    إذا (التحقق) {
        دع الآن: عدد;
        طابق وقت_الآن_بالثواني_تي_إل_إس() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> { الآن := القيمة; };
        طابق جذور_ثقة_محللة_تي_إل_إس(&(*الإعداد).جذور_الثقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجذور) -> {
            دع النتيجة: نتيجة_تحقق_شهادة_تي_إل_إس = تحقق_سلسلة_شهادات_تي_إل_إس(&الشهادات, &الجذور, &الاسم, الآن, غرض_تحقق_تي_إل_إس.غرض_خادم());
            دع الرمز: عدد = رمز_نتيجة_التحقق_تي_إل_إس(النتيجة);
            إذا (الرمز != 0) { أرجع نتيجة.خطأ(الرمز); };
        };
    };

    // CertificateVerify over the transcript through Certificate (4.4.3).
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
    إذا (الرسالة[0] != (رسالة_تحقق_شهادة_تي_إل_إس() مثل ط8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    طابق حلل_تحقق_الشهادة_تي_إل_إس(&الرسالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التحقق_المستلم) -> {
        دع ملخص_حتى_الشهادة: متجه ط8 = جزئ_تشفير(الخوارزمية, &النص);
        دع المحتوى: متجه ط8 = محتوى_تحقق_الشهادة_تي_إل_إس(صواب, &ملخص_حتى_الشهادة);
        إذا (!تحقق_توقيع_مصافحة_تي_إل_إس(&الشهادات[0].المفتاح, التحقق_المستلم.النوع, &المحتوى, &التحقق_المستلم.البيانات)) {
            أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس());
        };
    };
    ألحق_بايتات_تشفير(&متغير النص, &الرسالة);

    // Server Finished (4.4.4).
    طابق اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الرسالة := القيمة; };
    إذا (الرسالة[0] != (رسالة_إنهاء_تي_إل_إس() مثل ط8)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    دع ملخص_حتى_التحقق: متجه ط8 = جزئ_تشفير(الخوارزمية, &النص);
    دع المتوقع: متجه ط8 = بيانات_الإنهاء_تي_إل_إس(الخوارزمية, &خادم_مصافحة, &ملخص_حتى_التحقق);
    دع المستلم: متجه ط8 = شريحة_بايتات_تشفير(&الرسالة, 4, (الطول(الرسالة) مثل طبيعي) - 4);
    إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&المتوقع, &المستلم)) { أرجع نتيجة.خطأ(خطأ_توقيع_تي_إل_إس()); };
    إذا (!لا_مصافحة_معلقة_تي_إل_إس(الحالة)) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    ألحق_بايتات_تشفير(&متغير النص, &الرسالة);

    // Application secrets from the transcript through server Finished.
    دع مشتق2: متجه ط8 = سر_مشتق_تالي_تي_إل_إس(الخوارزمية, &سر_المصافحة);
    دع السر_الرئيس: متغير متجه ط8 = هكدف_استخرج_تشفير(الخوارزمية, &مشتق2, &أصفار);
    دع ملخص_حتى_الإنهاء: متجه ط8 = جزئ_تشفير(الخوارزمية, &النص);
    دع عميل_تطبيق: متغير متجه ط8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &السر_الرئيس, «c ap traffic», &ملخص_حتى_الإنهاء);
    دع خادم_تطبيق: متغير متجه ط8 = اشتق_سرا_تي_إل_إس(الخوارزمية, &السر_الرئيس, «s ap traffic», &ملخص_حتى_الإنهاء);

    // Client second flight: empty Certificate when requested, then Finished.
    إذا (طلب_شهادة) {
        دع جسم_الشهادة: متغير متجه ط8 = [];
        ألحق_متجها_تي_إل_إس(&متغير جسم_الشهادة, 1, &سياق_الطلب);
        دع قائمة_فارغة: متجه ط8 = [];
        ألحق_متجها_تي_إل_إس(&متغير جسم_الشهادة, 3, &قائمة_فارغة);
        دع رسالة_الشهادة: متجه ط8 = رسالة_مصافحة_تي_إل_إس(رسالة_شهادة_تي_إل_إس(), &جسم_الشهادة);
        طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &رسالة_الشهادة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ألحق_بايتات_تشفير(&متغير النص, &رسالة_الشهادة);
    };
    دع ملخص_العميل: متجه ط8 = جزئ_تشفير(الخوارزمية, &النص);
    دع بيانات_العميل: متجه ط8 = بيانات_الإنهاء_تي_إل_إس(الخوارزمية, &عميل_مصافحة, &ملخص_العميل);
    دع إنهاء_العميل: متجه ط8 = رسالة_مصافحة_تي_إل_إس(رسالة_إنهاء_تي_إل_إس(), &بيانات_العميل);
    طابق اكتب_رسالة_مصافحة_تي_إل_إس(الحالة, &إنهاء_العميل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    فعل_مفاتيح_تي_إل_إس(الحالة, خطأ, &خادم_تطبيق);
    فعل_مفاتيح_تي_إل_إس(الحالة, صواب, &عميل_تطبيق);
    (*الحالة).المصافحة_مكتملة := صواب;
    امسح_بايتات_تشفير(&متغير سر_المصافحة);
    امسح_بايتات_تشفير(&متغير عميل_مصافحة);
    امسح_بايتات_تشفير(&متغير خادم_مصافحة);
    امسح_بايتات_تشفير(&متغير السر_الرئيس);
    امسح_بايتات_تشفير(&متغير عميل_تطبيق);
    امسح_بايتات_تشفير(&متغير خادم_تطبيق);
    أرجع نتيجة.نجح(0);
}

عرف بايتات_بلا_نقطة_ختامية_تي_إل_إس(الاسم: &متجه ط8): متجه ط8 {
    دع الحجم: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع النقطة: نص = «.»;
    إذا (الحجم > 0 && (*الاسم)[الحجم - 1] == النقطة[0]) {
        أرجع شريحة_بايتات_تشفير(الاسم, 0, الحجم - 1);
    };
    أرجع انسخ_بايتات(الاسم);
}

// Runs the client handshake on a fresh connection state. On failure the
// matching alert is sent and the state keeps the error.
عام عرف صافح_كعميل_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الإعداد: &إعداد_عميل_تي_إل_إس): نتيجة عدد, عدد {
    طابق نفذ_مصافحة_عميل_تي_إل_إس(الحالة, الإعداد) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); }
    | نتيجة.خطأ(الخطأ) -> {
        إذا (الخطأ <= -2001 && الخطأ > -3000 && الخطأ != خطأ_انقطاع_تي_إل_إس()) {
            أرسل_تنبيها_تي_إل_إس(الحالة, تنبيه_لخطأ_تي_إل_إس(الخطأ));
        };
        (*الحالة).خطأ_دائم := الخطأ;
        أرجع نتيجة.خطأ(الخطأ);
    };
}
