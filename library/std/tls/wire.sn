استورد text.from_bytes;
// Bounds-checked reading of TLS presentation-language structures
// (RFC 8446 3): fixed-width big-endian integers and opaque vectors with
// 8-, 16- or 24-bit length prefixes. A read past the end marks the reader
// invalid instead of trapping; parsers check صالح and that every byte was
// consumed, and report decode_error otherwise.

استورد crypto.words;

عام نوع قارئ_تي_إل_إس = {
    البيانات: متجه ط8,
    الموضع: طبيعي,
    صالح: منطقي
};

عام عرف أنشئ_قارئ_تي_إل_إس(البيانات: &متجه ط8, البداية: طبيعي): قارئ_تي_إل_إس {
    دع القارئ: قارئ_تي_إل_إس = { البيانات: انسخ_بايتات(البيانات), الموضع: البداية, صالح: صواب };
    أرجع القارئ;
}

عام عرف متبقي_قارئ_تي_إل_إس(القارئ: &قارئ_تي_إل_إس): طبيعي {
    دع الحجم: طبيعي = الطول((*القارئ).البيانات) مثل طبيعي;
    لو ((*القارئ).الموضع >= الحجم) { أرجع 0; };
    أرجع الحجم - (*القارئ).الموضع;
}

عام عرف قارئ_منته_تي_إل_إس(القارئ: &قارئ_تي_إل_إس): منطقي {
    أرجع (*القارئ).صالح && متبقي_قارئ_تي_إل_إس(القارئ) == 0;
}

عرف يكفي_قارئ_تي_إل_إس(القارئ: &متغير قارئ_تي_إل_إس, العدد: طبيعي): منطقي {
    لو (!(*القارئ).صالح || متبقي_قارئ_تي_إل_إس(القارئ) < العدد) {
        (*القارئ).صالح := خطأ;
        أرجع خطأ;
    };
    أرجع صواب;
}

عام عرف اقرأ_رقما_تي_إل_إس(القارئ: &متغير قارئ_تي_إل_إس, البايتات: طبيعي): طبيعي {
    لو (!يكفي_قارئ_تي_إل_إس(القارئ, البايتات)) { أرجع 0; };
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < البايتات) {
        القيمة := (القيمة << 8) | ((*القارئ).البيانات[(*القارئ).الموضع + ف] مثل طبيعي);
        ف := ف + 1;
    }
    (*القارئ).الموضع := (*القارئ).الموضع + البايتات;
    أرجع القيمة;
}

عام عرف اقرأ_بايتات_تي_إل_إس(القارئ: &متغير قارئ_تي_إل_إس, العدد: طبيعي): متجه ط8 {
    لو (!يكفي_قارئ_تي_إل_إس(القارئ, العدد)) {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
    دع الناتج: متجه ط8 = شريحة_بايتات_تشفير(&(*القارئ).البيانات, (*القارئ).الموضع, العدد);
    (*القارئ).الموضع := (*القارئ).الموضع + العدد;
    أرجع الناتج;
}

// opaque field<min..max> with a length prefix of بايتات_الطول bytes.
عام عرف اقرأ_متجها_تي_إل_إس(القارئ: &متغير قارئ_تي_إل_إس, بايتات_الطول: طبيعي): متجه ط8 {
    دع الحجم: طبيعي = اقرأ_رقما_تي_إل_إس(القارئ, بايتات_الطول);
    أرجع اقرأ_بايتات_تي_إل_إس(القارئ, الحجم);
}

// Appends opaque data with a length prefix of بايتات_الطول bytes.
عام عرف ألحق_متجها_تي_إل_إس(الهدف: &متغير متجه ط8, بايتات_الطول: طبيعي, البيانات: &متجه ط8): فراغ {
    دع الحجم: طبيعي = الطول(*البيانات) مثل طبيعي;
    لو (بايتات_الطول == 1) {
        ألحق(*الهدف, (الحجم & 0xFF) مثل ط8);
    } وإلا لو (بايتات_الطول == 2) {
        ألحق_كبير16_تشفير(الهدف, الحجم);
    } وإلا {
        ألحق_كبير24_تشفير(الهدف, الحجم);
    };
    ألحق_بايتات_تشفير(الهدف, البيانات);
}

// One extension: type, then opaque data<0..2^16-1>.
عام نوع امتداد_تي_إل_إس = {
    النوع: طبيعي,
    البيانات: متجه ط8
};

// Extension list<0..2^16-1>; none when malformed or a type repeats
// (RFC 8446 4.2: duplicate extensions are a protocol error).
عام عرف اقرأ_امتدادات_تي_إل_إس(القارئ: &متغير قارئ_تي_إل_إس): اختياري متجه امتداد_تي_إل_إس {
    دع الكتلة: متجه ط8 = اقرأ_متجها_تي_إل_إس(القارئ, 2);
    لو (!(*القارئ).صالح) { أرجع اختياري.لا_شيء(); };
    دع الداخلي: متغير قارئ_تي_إل_إس = أنشئ_قارئ_تي_إل_إس(&الكتلة, 0);
    دع الامتدادات: متغير متجه امتداد_تي_إل_إس = [];
    طالما (متبقي_قارئ_تي_إل_إس(&الداخلي) > 0) {
        دع النوع: طبيعي = اقرأ_رقما_تي_إل_إس(&متغير الداخلي, 2);
        دع البيانات: متجه ط8 = اقرأ_متجها_تي_إل_إس(&متغير الداخلي, 2);
        لو (!الداخلي.صالح) { أرجع اختياري.لا_شيء(); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الامتدادات) مثل طبيعي)) {
            لو (الامتدادات[ف].النوع == النوع) { أرجع اختياري.لا_شيء(); };
            ف := ف + 1;
        }
        دع الامتداد: امتداد_تي_إل_إس = { النوع: النوع, البيانات: البيانات };
        ألحق(الامتدادات, الامتداد);
    }
    أرجع اختياري.موجود(الامتدادات);
}

// Extension types (RFC 8446 4.2).
عام عرف امتداد_اسم_الخادم_تي_إل_إس(): طبيعي { أرجع 0; }
عام عرف امتداد_المجموعات_تي_إل_إس(): طبيعي { أرجع 10; }
عام عرف امتداد_خوارزميات_التوقيع_تي_إل_إس(): طبيعي { أرجع 13; }
عام عرف امتداد_تفاوض_البروتوكول_تي_إل_إس(): طبيعي { أرجع 16; }
عام عرف امتداد_مفتاح_مشترك_مسبقا_تي_إل_إس(): طبيعي { أرجع 41; }
عام عرف امتداد_الإصدارات_تي_إل_إس(): طبيعي { أرجع 43; }
عام عرف امتداد_الكعكة_تي_إل_إس(): طبيعي { أرجع 44; }
عام عرف امتداد_أنماط_المفتاح_المسبق_تي_إل_إس(): طبيعي { أرجع 45; }
عام عرف امتداد_خوارزميات_توقيع_الشهادات_تي_إل_إس(): طبيعي { أرجع 50; }
عام عرف امتداد_مشاركة_المفتاح_تي_إل_إس(): طبيعي { أرجع 51; }

// Handshake message types (RFC 8446 4).
عام عرف رسالة_ترحيب_العميل_تي_إل_إس(): طبيعي { أرجع 1; }
عام عرف رسالة_ترحيب_الخادم_تي_إل_إس(): طبيعي { أرجع 2; }
عام عرف رسالة_تذكرة_جلسة_تي_إل_إس(): طبيعي { أرجع 4; }
عام عرف رسالة_امتدادات_مشفرة_تي_إل_إس(): طبيعي { أرجع 8; }
عام عرف رسالة_شهادة_تي_إل_إس(): طبيعي { أرجع 11; }
عام عرف رسالة_طلب_شهادة_تي_إل_إس(): طبيعي { أرجع 13; }
عام عرف رسالة_تحقق_شهادة_تي_إل_إس(): طبيعي { أرجع 15; }
عام عرف رسالة_إنهاء_تي_إل_إس(): طبيعي { أرجع 20; }
عام عرف رسالة_تحديث_المفتاح_تي_إل_إس(): طبيعي { أرجع 24; }
عام عرف رسالة_ملخص_الرسالة_تي_إل_إس(): طبيعي { أرجع 254; }

// SignatureScheme values used by std.tls (RFC 8446 4.2.3).
عام عرف مخطط_إي_سي_دي_إس_إيه_بي256_تي_إل_إس(): طبيعي { أرجع 0x0403; }
عام عرف مخطط_إي_سي_دي_إس_إيه_بي384_تي_إل_إس(): طبيعي { أرجع 0x0503; }
عام عرف مخطط_بي_إس_إس_شا256_تي_إل_إس(): طبيعي { أرجع 0x0804; }
عام عرف مخطط_بي_إس_إس_شا384_تي_إل_إس(): طبيعي { أرجع 0x0805; }
عام عرف مخطط_بي_إس_إس_شا512_تي_إل_إس(): طبيعي { أرجع 0x0806; }
عام عرف مخطط_إد25519_تي_إل_إس(): طبيعي { أرجع 0x0807; }

// Schemes advertised in signature_algorithms: CertificateVerify accepts the
// Ed25519, ECDSA and RSA-PSS entries; the PKCS#1 v1.5 entries (0x0401,
// 0x0501, 0x0601) are listed only because certificates may carry them
// (4.2.3).
عام عرف مخططات_التوقيع_المعلنة_تي_إل_إس(): متجه طبيعي {
    دع المخططات: متجه طبيعي = [0x0807, 0x0403, 0x0503, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601];
    أرجع المخططات;
}

// Named groups (RFC 8446 4.2.7): X25519, secp256r1 and secp384r1.
عام عرف مجموعة_إكس25519_تي_إل_إس(): طبيعي { أرجع 0x001D; }
عام عرف مجموعة_بي256_تي_إل_إس(): طبيعي { أرجع 0x0017; }
عام عرف مجموعة_بي384_تي_إل_إس(): طبيعي { أرجع 0x0018; }

// Supported groups in preference order.
عام عرف المجموعات_المدعومة_تي_إل_إس(): متجه طبيعي {
    دع المجموعات: متجه طبيعي = [0x001D, 0x0017, 0x0018];
    أرجع المجموعات;
}
