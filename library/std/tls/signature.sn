// CertificateVerify signing and checking (RFC 8446 4.4.3). Only the schemes
// std.tls advertises are accepted; the scheme must match the key type and,
// for ECDSA, the key's curve. RSA keys use RSASSA-PSS (rsa_pss_rsae_*);
// PKCS#1 v1.5 is never valid in CertificateVerify. Ed25519 signs the content
// itself (ed25519, 0x0807).

استورد crypto.digest;
استورد crypto.ecdsa;
استورد crypto.ed25519;
استورد crypto.rsa;
استورد tls.wire;
استورد tls.x509;

عام عرف تحقق_توقيع_مصافحة_تي_إل_إس(
    المفتاح: &مفتاح_عام_إكس509,
    المخطط: غير_موقع,
    المحتوى: &متجه غ8,
    التوقيع: &متجه غ8
): منطقي {
    طابق *المفتاح مع
    | مفتاح_عام_إكس509.مفتاح_إي_سي_إكس509(المفتاح_إي_سي) -> {
        لو (المخطط == مخطط_إي_سي_دي_إس_إيه_بي256_تي_إل_إس()) {
            طابق المفتاح_إي_سي.المنحنى مع
            | منحنى_إهليلجي.منحنى_بي256 -> {
                دع الملخص: متجه غ8 = جزئ_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), المحتوى);
                أرجع تحقق_إي_سي_دي_إس_إيه(منحنى_إهليلجي.منحنى_بي256(), &المفتاح_إي_سي.النقطة, &الملخص, التوقيع);
            }
            | _ -> { أرجع خطأ; };
        };
        لو (المخطط == مخطط_إي_سي_دي_إس_إيه_بي384_تي_إل_إس()) {
            طابق المفتاح_إي_سي.المنحنى مع
            | منحنى_إهليلجي.منحنى_بي384 -> {
                دع الملخص: متجه غ8 = جزئ_تشفير(خوارزمية_تجزئة.تجزئة_شا384(), المحتوى);
                أرجع تحقق_إي_سي_دي_إس_إيه(منحنى_إهليلجي.منحنى_بي384(), &المفتاح_إي_سي.النقطة, &الملخص, التوقيع);
            }
            | _ -> { أرجع خطأ; };
        };
        أرجع خطأ;
    }
    | مفتاح_عام_إكس509.مفتاح_آر_إس_إيه_إكس509(المفتاح_آر_إس_إيه) -> {
        دع التجزئة: متغير خوارزمية_تجزئة = خوارزمية_تجزئة.تجزئة_شا256();
        لو (المخطط == مخطط_بي_إس_إس_شا256_تي_إل_إس()) {
            التجزئة := خوارزمية_تجزئة.تجزئة_شا256();
        } وإلا لو (المخطط == مخطط_بي_إس_إس_شا384_تي_إل_إس()) {
            التجزئة := خوارزمية_تجزئة.تجزئة_شا384();
        } وإلا لو (المخطط == مخطط_بي_إس_إس_شا512_تي_إل_إس()) {
            التجزئة := خوارزمية_تجزئة.تجزئة_شا512();
        } وإلا {
            أرجع خطأ;
        };
        دع الملخص: متجه غ8 = جزئ_تشفير(التجزئة, المحتوى);
        أرجع تحقق_آر_إس_إيه_بي_إس_إس(&المفتاح_آر_إس_إيه, التجزئة, &الملخص, التوقيع);
    }
    | مفتاح_عام_إكس509.مفتاح_إد25519_إكس509(العام) -> {
        لو (المخطط != مخطط_إد25519_تي_إل_إس()) { أرجع خطأ; };
        أرجع تحقق_إد25519(&العام, المحتوى, التوقيع);
    }
    | مفتاح_عام_إكس509.مفتاح_غير_مدعوم_إكس509 -> { أرجع خطأ; };
}
