// TLS 1.3 record layer and key schedule (RFC 8446 sections 5 and 7).
//
// One connection state owns the socket descriptor, both traffic directions
// and the buffered input. Protected records use the negotiated AEAD with the
// per-record nonce (static IV XOR the 64-bit sequence number), the record
// header as additional data and the TLSInnerPlaintext content type; padding
// is accepted on input and not added on output. Unencrypted
// change_cipher_spec records are dropped only while the handshake is in
// progress (RFC 8446 5 and D.4). Every violation returns a std.tls status
// code; the caller sends the matching alert.

استورد crypto.aes_gcm;
استورد crypto.chacha20_poly1305;
استورد crypto.digest;
استورد crypto.words;
استورد os.entropy;
استورد os.error;
استورد os.socket;
استورد text.from_bytes;
استورد tls.errors;

عام نوع مفاتيح_اتجاه_تي_إل_إس = {
    مفعلة: منطقي,
    المفتاح: متجه ط8,
    المتجه: متجه ط8,
    السر: متجه ط8,
    التسلسل: طبيعي
};

عام نوع حالة_اتصال_تي_إل_إس = {
    المقبس: عدد,
    خادم: منطقي,
    الحزمة: طبيعي,
    القراءة: مفاتيح_اتجاه_تي_إل_إس,
    الكتابة: مفاتيح_اتجاه_تي_إل_إس,
    وارد_خام: متجه ط8,
    وارد_مصافحة: متجه ط8,
    وارد_تطبيق: متجه ط8,
    موضع_التطبيق: طبيعي,
    المصافحة_مكتملة: منطقي,
    نهاية_مستلمة: منطقي,
    مغلقة: منطقي,
    خطأ_دائم: عدد,
    // The ALPN protocol both sides agreed on (RFC 7301); empty for none.
    البروتوكول_المتفاوض: متجه ط8
};

عام نوع سجل_تي_إل_إس = {
    النوع: طبيعي,
    البيانات: متجه ط8
};

// ContentType (RFC 8446 5.1).
عام عرف نوع_تغيير_التشفير_تي_إل_إس(): طبيعي { أرجع 20; }
عام عرف نوع_تنبيه_تي_إل_إس(): طبيعي { أرجع 21; }
عام عرف نوع_مصافحة_تي_إل_إس(): طبيعي { أرجع 22; }
عام عرف نوع_بيانات_تطبيق_تي_إل_إس(): طبيعي { أرجع 23; }

// Cipher suites (RFC 8446 B.4).
عام عرف حزمة_أيس128_جي_سي_إم_تي_إل_إس(): طبيعي { أرجع 0x1301; }
عام عرف حزمة_أيس256_جي_سي_إم_تي_إل_إس(): طبيعي { أرجع 0x1302; }
عام عرف حزمة_تشاتشا20_تي_إل_إس(): طبيعي { أرجع 0x1303; }

عام عرف حزمة_مدعومة_تي_إل_إس(الحزمة: طبيعي): منطقي {
    أرجع الحزمة == 0x1301 || الحزمة == 0x1302 || الحزمة == 0x1303;
}

عام عرف تجزئة_الحزمة_تي_إل_إس(الحزمة: طبيعي): خوارزمية_تجزئة {
    إذا (الحزمة == 0x1302) { أرجع خوارزمية_تجزئة.تجزئة_شا384(); };
    أرجع خوارزمية_تجزئة.تجزئة_شا256();
}

عرف حجم_مفتاح_الحزمة_تي_إل_إس(الحزمة: طبيعي): طبيعي {
    إذا (الحزمة == 0x1301) { أرجع 16; };
    أرجع 32;
}

عرف مفاتيح_معطلة_تي_إل_إس(): مفاتيح_اتجاه_تي_إل_إس {
    دع فارغ1: متجه ط8 = [];
    دع فارغ2: متجه ط8 = [];
    دع فارغ3: متجه ط8 = [];
    دع المفاتيح: مفاتيح_اتجاه_تي_إل_إس = { مفعلة: خطأ, المفتاح: فارغ1, المتجه: فارغ2, السر: فارغ3, التسلسل: 0 };
    أرجع المفاتيح;
}

عام عرف أنشئ_حالة_اتصال_تي_إل_إس(المقبس: عدد, خادم: منطقي): حالة_اتصال_تي_إل_إس {
    دع خام: متجه ط8 = [];
    دع مصافحة: متجه ط8 = [];
    دع تطبيق: متجه ط8 = [];
    دع بروتوكول: متجه ط8 = [];
    دع الحالة: حالة_اتصال_تي_إل_إس = {
        المقبس: المقبس,
        خادم: خادم,
        الحزمة: 0,
        القراءة: مفاتيح_معطلة_تي_إل_إس(),
        الكتابة: مفاتيح_معطلة_تي_إل_إس(),
        وارد_خام: خام,
        وارد_مصافحة: مصافحة,
        وارد_تطبيق: تطبيق,
        موضع_التطبيق: 0,
        المصافحة_مكتملة: خطأ,
        نهاية_مستلمة: خطأ,
        مغلقة: خطأ,
        خطأ_دائم: 0,
        البروتوكول_المتفاوض: بروتوكول
    };
    أرجع الحالة;
}

// HKDF-Expand-Label (RFC 8446 7.1).
عام عرف وسع_تسمية_تي_إل_إس(
    الخوارزمية: خوارزمية_تجزئة,
    السر: &متجه ط8,
    التسمية: نص,
    السياق: &متجه ط8,
    الطول_المطلوب: طبيعي
): متجه ط8 {
    دع الكاملة: متغير متجه ط8 = بايتات_من_نص(«tls13 »);
    ألحق_بايتات_نص(&متغير الكاملة, التسمية);
    دع المعلومات: متغير متجه ط8 = [];
    ألحق_كبير16_تشفير(&متغير المعلومات, الطول_المطلوب);
    ألحق(المعلومات, (الطول(الكاملة) مثل طبيعي) مثل ط8);
    ألحق_بايتات_تشفير(&متغير المعلومات, &الكاملة);
    ألحق(المعلومات, (الطول(*السياق) مثل طبيعي) مثل ط8);
    ألحق_بايتات_تشفير(&متغير المعلومات, السياق);
    طابق هكدف_وسع_تشفير(الخوارزمية, السر, &المعلومات, الطول_المطلوب) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
}

// Derive-Secret(Secret, Label, Messages) with the transcript already hashed.
عام عرف اشتق_سرا_تي_إل_إس(الخوارزمية: خوارزمية_تجزئة, السر: &متجه ط8, التسمية: نص, ملخص_النص: &متجه ط8): متجه ط8 {
    أرجع وسع_تسمية_تي_إل_إس(الخوارزمية, السر, التسمية, ملخص_النص, حجم_ملخص_تجزئة(الخوارزمية));
}

// The secret that salts the next extraction: Derive-Secret(., "derived", "").
عام عرف سر_مشتق_تالي_تي_إل_إس(الخوارزمية: خوارزمية_تجزئة, السر: &متجه ط8): متجه ط8 {
    دع فارغ: متجه ط8 = [];
    دع ملخص_فارغ: متجه ط8 = جزئ_تشفير(الخوارزمية, &فارغ);
    أرجع اشتق_سرا_تي_إل_إس(الخوارزمية, السر, «derived», &ملخص_فارغ);
}

// Installs traffic keys derived from a traffic secret (RFC 8446 7.3).
عام عرف فعل_مفاتيح_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, للكتابة: منطقي, السر: &متجه ط8): فراغ {
    دع الحزمة: طبيعي = (*الحالة).الحزمة;
    دع الخوارزمية: خوارزمية_تجزئة = تجزئة_الحزمة_تي_إل_إس(الحزمة);
    دع فارغ: متجه ط8 = [];
    دع المفتاح: متجه ط8 = وسع_تسمية_تي_إل_إس(الخوارزمية, السر, «key», &فارغ, حجم_مفتاح_الحزمة_تي_إل_إس(الحزمة));
    دع المتجه: متجه ط8 = وسع_تسمية_تي_إل_إس(الخوارزمية, السر, «iv», &فارغ, 12);
    دع المفاتيح: مفاتيح_اتجاه_تي_إل_إس = { مفعلة: صواب, المفتاح: المفتاح, المتجه: المتجه, السر: انسخ_بايتات(السر), التسلسل: 0 };
    إذا (للكتابة) {
        (*الحالة).الكتابة := المفاتيح;
    } وإلا {
        (*الحالة).القراءة := المفاتيح;
    };
}

// application_traffic_secret_N+1 (RFC 8446 7.2).
عام عرف حدث_مفاتيح_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, للكتابة: منطقي): فراغ {
    دع الخوارزمية: خوارزمية_تجزئة = تجزئة_الحزمة_تي_إل_إس((*الحالة).الحزمة);
    دع فارغ: متجه ط8 = [];
    دع القديم: متغير متجه ط8 = [];
    // Take the old secret: it is erased below and replaced by the new keys.
    إذا (للكتابة) {
        بدّل((*الحالة).الكتابة.السر, القديم);
    } وإلا {
        بدّل((*الحالة).القراءة.السر, القديم);
    };
    دع الجديد: متجه ط8 = وسع_تسمية_تي_إل_إس(الخوارزمية, &القديم, «traffic upd», &فارغ, حجم_ملخص_تجزئة(الخوارزمية));
    امسح_بايتات_تشفير(&متغير القديم);
    فعل_مفاتيح_تي_إل_إس(الحالة, للكتابة, &الجديد);
}

عرف نونس_سجل_تي_إل_إس(المتجه: &متجه ط8, التسلسل: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = شريحة_بايتات_تشفير(المتجه, 0, 12);
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        دع ب: طبيعي = (التسلسل >> (56 - ف * 8)) & 0xFF;
        الناتج[4 + ف] := ((الناتج[4 + ف] مثل طبيعي) ^ ب) مثل ط8;
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف اختم_بالحزمة_تي_إل_إس(الحزمة: طبيعي, المفتاح: &متجه ط8, النونس: &متجه ط8, الإضافية: &متجه ط8, الصريح: &متجه ط8): متجه ط8 {
    إذا (الحزمة == 0x1303) {
        أرجع اختم_تشاتشا20_بولي1305(المفتاح, النونس, الإضافية, الصريح);
    };
    طابق اختم_أيس_جي_سي_إم(المفتاح, النونس, الإضافية, الصريح) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> {
        دع فارغ: متجه ط8 = [];
        أرجع فارغ;
    };
}

عرف افتح_بالحزمة_تي_إل_إس(الحزمة: طبيعي, المفتاح: &متجه ط8, النونس: &متجه ط8, الإضافية: &متجه ط8, المشفر: &متجه ط8): اختياري متجه ط8 {
    إذا (الحزمة == 0x1303) {
        أرجع افتح_تشاتشا20_بولي1305(المفتاح, النونس, الإضافية, المشفر);
    };
    أرجع افتح_أيس_جي_سي_إم(المفتاح, النونس, الإضافية, المشفر);
}

عرف مقبس_نظام_تي_إل_إس(القيمة: عدد): مقبس_نظام {
    دع المقبس: مقبس_نظام = { القيمة: القيمة, مفتوح: صواب };
    أرجع المقبس;
}

// Writes all bytes to the socket.
عام عرف اكتب_بايتات_مقبس_تي_إل_إس(المقبس: عدد, البيانات: &متجه ط8): نتيجة عدد, عدد {
    دع مقبس: مقبس_نظام = مقبس_نظام_تي_إل_إس(المقبس);
    دع الحجم: عدد = الطول(*البيانات);
    دع المكتوب: متغير عدد = 0;
    طالما (المكتوب < الحجم) {
        طابق أرسل_مقبس_نظام(&مقبس, البيانات, المكتوب, الحجم - المكتوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد <= 0) { أرجع نتيجة.خطأ(خطأ_انقطاع_تي_إل_إس()); };
            المكتوب := المكتوب + العدد;
        };
    }
    أرجع نتيجة.نجح(الحجم);
}

// Sends one record of ≤ 2^14 bytes, protected when write keys are active.
عام عرف اكتب_سجل_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, النوع: طبيعي, البيانات: &متجه ط8): نتيجة عدد, عدد {
    إذا ((الطول(*البيانات) مثل طبيعي) > 16384) { أرجع نتيجة.خطأ(خطأ_وسيط_تي_إل_إس()); };
    دع السجل: متغير متجه ط8 = [];
    إذا (!(*الحالة).الكتابة.مفعلة) {
        ألحق(السجل, النوع مثل ط8);
        ألحق_كبير16_تشفير(&متغير السجل, 0x0303);
        ألحق_كبير16_تشفير(&متغير السجل, الطول(*البيانات) مثل طبيعي);
        ألحق_بايتات_تشفير(&متغير السجل, البيانات);
    } وإلا {
        إذا ((*الحالة).الكتابة.التسلسل >= 9223372036854775807) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        دع الداخلي: متغير متجه ط8 = [];
        ألحق_بايتات_تشفير(&متغير الداخلي, البيانات);
        ألحق(الداخلي, النوع مثل ط8);
        دع الرأس: متغير متجه ط8 = [];
        ألحق(الرأس, نوع_بيانات_تطبيق_تي_إل_إس() مثل ط8);
        ألحق_كبير16_تشفير(&متغير الرأس, 0x0303);
        ألحق_كبير16_تشفير(&متغير الرأس, (الطول(الداخلي) مثل طبيعي) + 16);
        دع النونس: متجه ط8 = نونس_سجل_تي_إل_إس(&(*الحالة).الكتابة.المتجه, (*الحالة).الكتابة.التسلسل);
        دع المشفر: متجه ط8 = اختم_بالحزمة_تي_إل_إس((*الحالة).الحزمة, &(*الحالة).الكتابة.المفتاح, &النونس, &الرأس, &الداخلي);
        إذا ((الطول(المشفر) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        (*الحالة).الكتابة.التسلسل := (*الحالة).الكتابة.التسلسل + 1;
        امسح_بايتات_تشفير(&متغير الداخلي);
        ألحق_بايتات_تشفير(&متغير السجل, &الرأس);
        ألحق_بايتات_تشفير(&متغير السجل, &المشفر);
    };
    أرجع اكتب_بايتات_مقبس_تي_إل_إس((*الحالة).المقبس, &السجل);
}

// Reads from the socket until at least المطلوب bytes are buffered.
عرف املأ_الوارد_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, المطلوب: طبيعي): نتيجة عدد, عدد {
    دع مقبس: مقبس_نظام = مقبس_نظام_تي_إل_إس((*الحالة).المقبس);
    طالما ((الطول((*الحالة).وارد_خام) مثل طبيعي) < المطلوب) {
        دع المخزن: متغير متجه ط8 = أصفار_تشفير(18437);
        طابق استقبل_مقبس_نظام(&مقبس, &متغير المخزن, 0, 18437) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد <= 0) { أرجع نتيجة.خطأ(خطأ_انقطاع_تي_إل_إس()); };
            دع ف: متغير طبيعي = 0;
            طالما (ف < (العدد مثل طبيعي)) {
                ألحق((*الحالة).وارد_خام, المخزن[ف]);
                ف := ف + 1;
            }
        };
    }
    أرجع نتيجة.نجح(0);
}

// Reads one record and removes its protection. change_cipher_spec records
// are dropped during the handshake; outside it they are a protocol error.
عام عرف اقرأ_سجل_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس): نتيجة سجل_تي_إل_إس, عدد {
    طالما (صواب) {
        طابق املأ_الوارد_تي_إل_إس(الحالة, 5) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع النوع: طبيعي = (*الحالة).وارد_خام[0] مثل طبيعي;
        دع الإصدار_الأعلى: طبيعي = (*الحالة).وارد_خام[1] مثل طبيعي;
        دع الطول_الحالي: طبيعي = اقرأ_كبير16_تشفير(&(*الحالة).وارد_خام, 3);
        إذا (الإصدار_الأعلى != 3) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        إذا (الطول_الحالي > 16640 || الطول_الحالي == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
        طابق املأ_الوارد_تي_إل_إس(الحالة, 5 + الطول_الحالي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع الرأس: متجه ط8 = شريحة_بايتات_تشفير(&(*الحالة).وارد_خام, 0, 5);
        دع الحمولة: متجه ط8 = شريحة_بايتات_تشفير(&(*الحالة).وارد_خام, 5, الطول_الحالي);
        دع الكلي: طبيعي = الطول((*الحالة).وارد_خام) مثل طبيعي;
        (*الحالة).وارد_خام := شريحة_بايتات_تشفير(&(*الحالة).وارد_خام, 5 + الطول_الحالي, الكلي - 5 - الطول_الحالي);

        إذا (النوع == نوع_تغيير_التشفير_تي_إل_إس()) {
            إذا ((*الحالة).المصافحة_مكتملة || الطول_الحالي != 1 || الحمولة[0] != 1) {
                أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
            };
        } وإلا إذا (!(*الحالة).القراءة.مفعلة) {
            إذا (الطول_الحالي > 16384) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
            إذا (النوع != نوع_مصافحة_تي_إل_إس() && النوع != نوع_تنبيه_تي_إل_إس()) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
            دع السجل: سجل_تي_إل_إس = { النوع: النوع, البيانات: الحمولة };
            أرجع نتيجة.نجح(السجل);
        } وإلا {
            إذا (النوع != نوع_بيانات_تطبيق_تي_إل_إس()) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
            دع النونس: متجه ط8 = نونس_سجل_تي_إل_إس(&(*الحالة).القراءة.المتجه, (*الحالة).القراءة.التسلسل);
            طابق افتح_بالحزمة_تي_إل_إس((*الحالة).الحزمة, &(*الحالة).القراءة.المفتاح, &النونس, &الرأس, &الحمولة) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_فك_السجل_تي_إل_إس()); }
            | اختياري.موجود(الداخلي) -> {
                (*الحالة).القراءة.التسلسل := (*الحالة).القراءة.التسلسل + 1;
                // TLSInnerPlaintext: content, type, zero padding.
                دع النهاية: متغير طبيعي = الطول(الداخلي) مثل طبيعي;
                طالما (النهاية > 0 && الداخلي[النهاية - 1] == 0) { النهاية := النهاية - 1; }
                إذا (النهاية == 0) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
                دع النوع_الداخلي: طبيعي = الداخلي[النهاية - 1] مثل طبيعي;
                إذا (النهاية - 1 > 16384) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
                إذا (النوع_الداخلي != نوع_مصافحة_تي_إل_إس() && النوع_الداخلي != نوع_تنبيه_تي_إل_إس() && النوع_الداخلي != نوع_بيانات_تطبيق_تي_إل_إس()) {
                    أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
                };
                دع السجل: سجل_تي_إل_إس = { النوع: النوع_الداخلي, البيانات: شريحة_بايتات_تشفير(&الداخلي, 0, النهاية - 1) };
                أرجع نتيجة.نجح(السجل);
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
}

// AlertDescription for a std.tls status (RFC 8446 6.2).
عام عرف تنبيه_لخطأ_تي_إل_إس(الخطأ: عدد): طبيعي {
    إذا (الخطأ == خطأ_ترميز_تي_إل_إس()) { أرجع 50; };
    إذا (الخطأ == خطأ_غير_مدعوم_تي_إل_إس()) { أرجع 40; };
    إذا (الخطأ == خطأ_شهادة_غير_موثوقة_تي_إل_إس()) { أرجع 48; };
    إذا (الخطأ == خطأ_اسم_الشهادة_تي_إل_إس()) { أرجع 42; };
    إذا (الخطأ == خطأ_صلاحية_الشهادة_تي_إل_إس()) { أرجع 45; };
    إذا (الخطأ == خطأ_توقيع_تي_إل_إس()) { أرجع 51; };
    إذا (الخطأ == خطأ_فك_السجل_تي_إل_إس()) { أرجع 20; };
    إذا (الخطأ == خطأ_بروتوكول_تي_إل_إس()) { أرجع 47; };
    إذا (الخطأ == خطأ_لا_بروتوكول_تطبيق_تي_إل_إس()) { أرجع 120; };
    أرجع 80;
}

// Sends an alert record; failures are ignored because the connection is
// already being abandoned or closed.
عام عرف أرسل_تنبيها_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الوصف: طبيعي): فراغ {
    دع المستوى: طبيعي = 2;
    إذا (الوصف == 0) {
        // close_notify is a warning-level alert by convention.
        دع بيانات: متجه ط8 = [1, 0];
        دع تجاهل: نتيجة عدد, عدد = اكتب_سجل_تي_إل_إس(الحالة, نوع_تنبيه_تي_إل_إس(), &بيانات);
        أرجع;
    };
    دع البيانات: متغير متجه ط8 = [];
    ألحق(البيانات, المستوى مثل ط8);
    ألحق(البيانات, الوصف مثل ط8);
    دع تجاهل: نتيجة عدد, عدد = اكتب_سجل_تي_إل_إس(الحالة, نوع_تنبيه_تي_إل_إس(), &البيانات);
}

// Interprets a received alert record: close_notify yields 0, any other
// alert (all are fatal in TLS 1.3 except user_canceled) yields its status.
عام عرف عالج_تنبيها_مستلما_تي_إل_إس(البيانات: &متجه ط8): عدد {
    إذا ((الطول(*البيانات) مثل طبيعي) != 2) { أرجع خطأ_ترميز_تي_إل_إس(); };
    دع الوصف: طبيعي = (*البيانات)[1] مثل طبيعي;
    إذا (الوصف == 0) { أرجع 0; };
    أرجع خطأ_تنبيه_مستلم_تي_إل_إس(الوصف);
}

// The next complete handshake message (header included). Messages may span
// records; application data or a closed stream is a protocol error here.
عام عرف اقرأ_رسالة_مصافحة_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس): نتيجة متجه ط8, عدد {
    طالما (صواب) {
        دع المتاح: طبيعي = الطول((*الحالة).وارد_مصافحة) مثل طبيعي;
        إذا (المتاح >= 4) {
            دع الطول_المعلن: طبيعي = اقرأ_كبير24_تشفير(&(*الحالة).وارد_مصافحة, 1);
            إذا (الطول_المعلن > 262144) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
            إذا (المتاح >= 4 + الطول_المعلن) {
                دع الرسالة: متجه ط8 = شريحة_بايتات_تشفير(&(*الحالة).وارد_مصافحة, 0, 4 + الطول_المعلن);
                (*الحالة).وارد_مصافحة := شريحة_بايتات_تشفير(&(*الحالة).وارد_مصافحة, 4 + الطول_المعلن, المتاح - 4 - الطول_المعلن);
                أرجع نتيجة.نجح(الرسالة);
            };
        };
        طابق اقرأ_سجل_تي_إل_إس(الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(السجل) -> {
            إذا (السجل.النوع == نوع_تنبيه_تي_إل_إس()) {
                دع الحالة_الناتجة: عدد = عالج_تنبيها_مستلما_تي_إل_إس(&السجل.البيانات);
                إذا (الحالة_الناتجة == 0) { أرجع نتيجة.خطأ(خطأ_انقطاع_تي_إل_إس()); };
                أرجع نتيجة.خطأ(الحالة_الناتجة);
            };
            إذا (السجل.النوع != نوع_مصافحة_تي_إل_إس()) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
            إذا ((الطول(السجل.البيانات) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ترميز_تي_إل_إس()); };
            ألحق_بايتات_تشفير(&متغير (*الحالة).وارد_مصافحة, &السجل.البيانات);
        };
    }
    أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
}

// Handshake messages must not span a key change (RFC 8446 5.1).
عام عرف لا_مصافحة_معلقة_تي_إل_إس(الحالة: &حالة_اتصال_تي_إل_إس): منطقي {
    أرجع (الطول((*الحالة).وارد_مصافحة) مثل طبيعي) == 0;
}

// Sends one handshake message, split across records when it exceeds 2^14.
عام عرف اكتب_رسالة_مصافحة_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس, الرسالة: &متجه ط8): نتيجة عدد, عدد {
    دع الحجم: طبيعي = الطول(*الرسالة) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم) {
        دع الجزء: متغير طبيعي = الحجم - الموضع;
        إذا (الجزء > 16384) { الجزء := 16384; };
        دع القطعة: متجه ط8 = شريحة_بايتات_تشفير(الرسالة, الموضع, الجزء);
        طابق اكتب_سجل_تي_إل_إس(الحالة, نوع_مصافحة_تي_إل_إس(), &القطعة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        الموضع := الموضع + الجزء;
    }
    أرجع نتيجة.نجح(الحجم مثل عدد);
}

// Wraps a handshake body with its type and 24-bit length.
عام عرف رسالة_مصافحة_تي_إل_إس(النوع: طبيعي, الجسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, النوع مثل ط8);
    ألحق_كبير24_تشفير(&متغير الناتج, الطول(*الجسم) مثل طبيعي);
    ألحق_بايتات_تشفير(&متغير الناتج, الجسم);
    أرجع الناتج;
}

// verify_data for a Finished message (RFC 8446 4.4.4).
عام عرف بيانات_الإنهاء_تي_إل_إس(الخوارزمية: خوارزمية_تجزئة, السر_الأساسي: &متجه ط8, ملخص_النص: &متجه ط8): متجه ط8 {
    دع فارغ: متجه ط8 = [];
    دع المفتاح: متغير متجه ط8 = وسع_تسمية_تي_إل_إس(الخوارزمية, السر_الأساسي, «finished», &فارغ, حجم_ملخص_تجزئة(الخوارزمية));
    دع الناتج: متجه ط8 = هماك_تشفير(الخوارزمية, &المفتاح, ملخص_النص);
    امسح_بايتات_تشفير(&متغير المفتاح);
    أرجع الناتج;
}

// The content signed by CertificateVerify (RFC 8446 4.4.3).
عام عرف محتوى_تحقق_الشهادة_تي_إل_إس(من_الخادم: منطقي, ملخص_النص: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 64) {
        ألحق_بايتات_نص(&متغير الناتج, « »);
        ف := ف + 1;
    }
    إذا (من_الخادم) {
        ألحق_بايتات_نص(&متغير الناتج, «TLS 1.3, server CertificateVerify»);
    } وإلا {
        ألحق_بايتات_نص(&متغير الناتج, «TLS 1.3, client CertificateVerify»);
    };
    ألحق(الناتج, 0 مثل ط8);
    ألحق_بايتات_تشفير(&متغير الناتج, ملخص_النص);
    أرجع الناتج;
}

// Fresh bytes from the operating-system CSPRNG; there is no fallback.
عام عرف بايتات_عشوائية_تي_إل_إس(العدد: طبيعي): نتيجة متجه ط8, عدد {
    دع المخزن: متغير متجه ط8 = أصفار_تشفير(العدد);
    طابق املأ_بايتات_عشوائية_النظام(&متغير المخزن) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عشوائية_تي_إل_إس()); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المخزن); };
}

// The legacy change_cipher_spec record sent once for middlebox
// compatibility (RFC 8446 D.4).
عام عرف أرسل_تغيير_تشفير_وهمي_تي_إل_إس(الحالة: &متغير حالة_اتصال_تي_إل_إس): نتيجة عدد, عدد {
    دع السجل: متجه ط8 = [20, 3, 3, 0, 1, 1];
    أرجع اكتب_بايتات_مقبس_تي_إل_إس((*الحالة).المقبس, &السجل);
}
