// Ephemeral (EC)DHE key shares for the TLS 1.3 client and server (RFC 8446
// 4.2.8): X25519 (RFC 7748) and the NIST curves secp256r1 and secp384r1
// (uncompressed SEC 1 points, 4.2.8.2). Private keys come from the system
// random source; the computations are constant time (crypto.x25519,
// crypto.ecdsa). A peer share of the wrong size, an invalid curve point or an
// all-zero X25519 result fails with illegal_parameter.

استورد crypto.ecdsa;
استورد crypto.words;
استورد crypto.x25519;
استورد tls.errors;
استورد tls.record;
استورد tls.wire;

عام نوع مشاركة_مفتاح_تي_إل_إس = {
    المجموعة: غير_موقع,
    الخاص: متجه غ8,
    العام: متجه غ8
};

عام عرف مجموعة_مدعومة_تي_إل_إس(المجموعة: غير_موقع): منطقي {
    أرجع المجموعة == مجموعة_إكس25519_تي_إل_إس()
        || المجموعة == مجموعة_بي256_تي_إل_إس()
        || المجموعة == مجموعة_بي384_تي_إل_إس();
}

عرف منحنى_مجموعة_تي_إل_إس(المجموعة: غير_موقع): منحنى_إهليلجي {
    لو (المجموعة == مجموعة_بي384_تي_إل_إس()) { أرجع منحنى_إهليلجي.منحنى_بي384(); };
    أرجع منحنى_إهليلجي.منحنى_بي256();
}

عرف حجم_مجموعة_تي_إل_إس(المجموعة: غير_موقع): غير_موقع {
    لو (المجموعة == مجموعة_بي384_تي_إل_إس()) { أرجع 48; };
    أرجع 32;
}

// A fresh key pair for المجموعة.
عام عرف أنشئ_مشاركة_مفتاح_تي_إل_إس(المجموعة: غير_موقع): نتيجة مشاركة_مفتاح_تي_إل_إس, عدد {
    لو (!مجموعة_مدعومة_تي_إل_إس(المجموعة)) { أرجع نتيجة.خطأ(خطأ_غير_مدعوم_تي_إل_إس()); };
    دع الحجم: غير_موقع = حجم_مجموعة_تي_إل_إس(المجموعة);
    // A random scalar outside [1, n) has probability below 2^-32 on these
    // curves; a few draws always suffice.
    دع المحاولة: متغير غير_موقع = 0;
    بينما (المحاولة < 8) {
        طابق بايتات_عشوائية_تي_إل_إس(الحجم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الخاص) -> {
            لو (المجموعة == مجموعة_إكس25519_تي_إل_إس()) {
                دع العام: متجه غ8 = مفتاح_عام_إكس25519(&الخاص);
                دع المشاركة: مشاركة_مفتاح_تي_إل_إس = { المجموعة: المجموعة, الخاص: الخاص, العام: العام };
                أرجع نتيجة.نجح(المشاركة);
            };
            طابق مفتاح_عام_إي_سي_دي_إس_إيه(منحنى_مجموعة_تي_إل_إس(المجموعة), &الخاص) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(العام) -> {
                دع المشاركة: مشاركة_مفتاح_تي_إل_إس = { المجموعة: المجموعة, الخاص: الخاص, العام: العام };
                أرجع نتيجة.نجح(المشاركة);
            };
        };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(خطأ_عشوائية_تي_إل_إس());
}

// The shared secret with the peer's share (the x-coordinate for the NIST
// curves, RFC 8446 7.4.2).
عام عرف سر_مشاركة_مفتاح_تي_إل_إس(المشاركة: &مشاركة_مفتاح_تي_إل_إس, النظير: &متجه غ8): نتيجة متجه غ8, عدد {
    دع المجموعة: غير_موقع = (*المشاركة).المجموعة;
    دع الحجم: غير_موقع = حجم_مجموعة_تي_إل_إس(المجموعة);
    لو (المجموعة == مجموعة_إكس25519_تي_إل_إس()) {
        لو ((الطول(*النظير) مثل غير_موقع) != 32) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
        دع المشترك: متغير متجه غ8 = إكس25519(&(*المشاركة).الخاص, النظير);
        لو (سر_إكس25519_صفري(&المشترك)) {
            امسح_بايتات_تشفير(&متغير المشترك);
            أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس());
        };
        أرجع نتيجة.نجح(المشترك);
    };
    لو ((الطول(*النظير) مثل غير_موقع) != 2 * الحجم + 1) { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); };
    طابق اتفاق_إي_سي_دي_إتش(منحنى_مجموعة_تي_إل_إس(المجموعة), &(*المشاركة).الخاص, النظير) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_بروتوكول_تي_إل_إس()); }
    | اختيار.بعض(المشترك) -> { أرجع نتيجة.نجح(المشترك); };
}

// Erases the private key.
عام عرف امسح_مشاركة_مفتاح_تي_إل_إس(المشاركة: &متغير مشاركة_مفتاح_تي_إل_إس): فراغ {
    امسح_بايتات_تشفير(&متغير (*المشاركة).الخاص);
}
