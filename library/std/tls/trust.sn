// System trust anchors for TLS peer verification.
//
// The bundle locations are those Go crypto/x509 searches on Linux
// (root_linux.go); the first readable bundle is used, and SSL_CERT_FILE,
// when set, replaces the search as in Go and OpenSSL. On macOS the
// Apple-maintained PEM bundle /etc/ssl/cert.pem is read; keychain trust
// settings are not consulted. Windows (CryptoAPI system stores) and WASI
// (no host store) have no system anchors here: a connection there must be
// configured with explicit roots, otherwise verification fails with
// خطأ_مخزن_الثقة_تي_إل_إس. Certificates that do not parse are skipped.

استورد encoding.pem;
استورد env.environment;
استورد fs.read_file;
استورد tls.errors;
استورد tls.x509;

لو (الهدف.المنصة == «linux») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [
            «/etc/ssl/certs/ca-certificates.crt»,
            «/etc/pki/tls/certs/ca-bundle.crt»,
            «/etc/ssl/ca-bundle.pem»,
            «/etc/pki/tls/cacert.pem»,
            «/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem»,
            «/etc/ssl/cert.pem»
        ];
        أرجع المسارات;
    }
}

لو (الهدف.المنصة == «macos») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [«/etc/ssl/cert.pem»];
        أرجع المسارات;
    }
}

لو (الهدف.المنصة == «windows» || الهدف.المنصة == «wasi») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [];
        أرجع المسارات;
    }
}

// Parses every CERTIFICATE block of a PEM bundle.
عام عرف شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(البيانات: &متجه غ8): متجه شهادة_إكس509 {
    دع الكتل: متجه متجه غ8 = كتل_بي_إي_إم_بوصف(البيانات, «CERTIFICATE»);
    دع الشهادات: متغير متجه شهادة_إكس509 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الكتل) مثل غير_موقع)) {
        طابق حلل_شهادة_إكس509(&الكتل[ف]) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الشهادة) -> { ألحق(الشهادات, الشهادة); };
        ف := ف + 1;
    }
    أرجع الشهادات;
}

عرف اقرأ_حزمة_جذور_تي_إل_إس(المسار: &نص): اختيار متجه شهادة_إكس509 {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(البيانات) -> {
        دع الشهادات: متجه شهادة_إكس509 = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(&البيانات);
        لو ((الطول(الشهادات) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الشهادات);
    };
}

// The platform trust anchors, or خطأ_مخزن_الثقة_تي_إل_إس when none can be read.
عام عرف جذور_النظام_تي_إل_إس(): نتيجة متجه شهادة_إكس509, عدد {
    دع اسم_المتغير: نص = «SSL_CERT_FILE»;
    طابق متغير_بيئة(&اسم_المتغير) مع
    | نتيجة.نجح(القيمة) -> {
        طابق القيمة مع
        | اختيار.بعض(المسار) -> {
            طابق اقرأ_حزمة_جذور_تي_إل_إس(&المسار) مع
            | اختيار.بعض(الشهادات) -> { أرجع نتيجة.نجح(الشهادات); }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس()); };
        }
        | اختيار.لا_شيء -> { };
    }
    | نتيجة.خطأ(_) -> { };
    دع المسارات: متجه نص = مسارات_جذور_النظام_تي_إل_إس();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المسارات) مثل غير_موقع)) {
        طابق اقرأ_حزمة_جذور_تي_إل_إس(&المسارات[ف]) مع
        | اختيار.بعض(الشهادات) -> { أرجع نتيجة.نجح(الشهادات); }
        | اختيار.لا_شيء -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس());
}

عام مرادف tls_system_roots = جذور_النظام_تي_إل_إس;
عام مرادف tls_certificates_from_pem = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس;
