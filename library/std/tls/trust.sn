// System trust anchors for TLS peer verification.
//
// The bundle and directory locations are those Go crypto/x509 searches
// (root_linux.go, root_unix.go): the first readable bundle is used, else
// every certificate file of the platform directories. SSL_CERT_FILE and
// SSL_CERT_DIR (a list separated by ':', ';' on Windows), when set, replace
// the search as in Go and OpenSSL. On macOS the Apple-maintained PEM bundle
// /etc/ssl/cert.pem is read; keychain trust settings are not consulted.
// Android reads its system CA directories (one PEM file per root). Windows
// enumerates the CryptoAPI ROOT system store (crypt32). WASI has no host
// store: there only SSL_CERT_FILE / SSL_CERT_DIR inside a preopened
// directory apply, otherwise verification fails with
// خطأ_مخزن_الثقة_تي_إل_إس. Certificates that do not parse are skipped.

استورد encoding.pem;
استورد env.environment;
استورد fs.read_file;
استورد fs.directory;
استورد text.from_bytes;
استورد tls.errors;
استورد tls.x509;

إذا (الهدف.المنصة == «linux») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [
            «/etc/ssl/certs/ca-certificates.crt»,
            «/etc/pki/tls/certs/ca-bundle.crt»,
            «/etc/ssl/ca-bundle.pem»,
            «/etc/pki/tls/cacert.pem»,
            «/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem»,
            «/etc/ssl/cert.pem»
        ];
        أرجع المسارات;
    }
}

إذا (الهدف.المنصة == «macos») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [«/etc/ssl/cert.pem»];
        أرجع المسارات;
    }
}

إذا (الهدف.المنصة == «freebsd») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [
            «/etc/ssl/cert.pem»,
            «/usr/local/share/certs/ca-root-nss.crt»
        ];
        أرجع المسارات;
    }
}

// Directories of one-certificate files (Go root_linux.go certDirectories;
// Android: the system and the updatable conscrypt APEX stores).
إذا (الهدف.المنصة == «linux» || الهدف.المنصة == «freebsd») {
    عرف أدلة_جذور_النظام_تي_إل_إس(): متجه نص {
        دع الأدلة: متجه نص = [«/etc/ssl/certs», «/etc/pki/tls/certs»];
        أرجع الأدلة;
    }
}
إذا (الهدف.المنصة == «android») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [];
        أرجع المسارات;
    }
    عرف أدلة_جذور_النظام_تي_إل_إس(): متجه نص {
        دع الأدلة: متجه نص = [«/apex/com.android.conscrypt/cacerts», «/system/etc/security/cacerts»];
        أرجع الأدلة;
    }
}
إذا (الهدف.المنصة != «linux» && الهدف.المنصة != «freebsd» && الهدف.المنصة != «android») {
    عرف أدلة_جذور_النظام_تي_إل_إس(): متجه نص {
        دع الأدلة: متجه نص = [];
        أرجع الأدلة;
    }
}

// No system PEM bundle (Windows keeps roots in its CryptoAPI store, read
// below; WASI and browsers have none): only an explicitly configured bundle.
إذا (الهدف.المنصة != «linux» && الهدف.المنصة != «macos» && الهدف.المنصة != «freebsd» && الهدف.المنصة != «android») {
    عرف مسارات_جذور_النظام_تي_إل_إس(): متجه نص {
        دع المسارات: متجه نص = [];
        أرجع المسارات;
    }
}

// Windows: the DER certificates of the CryptoAPI ROOT system store
// (os/platform/windows/win32/certificates.sn).
إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.certificates;
    عرف جذور_مخزن_ويندوز_تي_إل_إس(): متجه شهادة_إكس509 {
        دع الشهادات: متغير متجه شهادة_إكس509 = [];
        دع الكتل: متجه متجه ط8 = شهادات_مخزن_الجذور_ويندوز();
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الكتل) مثل طبيعي)) {
            طابق حلل_شهادة_إكس509(&الكتل[ف]) مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(الشهادة) -> { ألحق(الشهادات, الشهادة); };
            ف := ف + 1;
        }
        أرجع الشهادات;
    }
}
إذا (الهدف.المنصة != «windows») {
    عرف جذور_مخزن_ويندوز_تي_إل_إس(): متجه شهادة_إكس509 {
        دع الشهادات: متجه شهادة_إكس509 = [];
        أرجع الشهادات;
    }
}

// The list separator of SSL_CERT_DIR.
إذا (الهدف.المنصة == «windows») {
    عرف فاصل_قائمة_أدلة_تي_إل_إس(): ط8 { أرجع 0x3B; }
}
إذا (الهدف.المنصة != «windows») {
    عرف فاصل_قائمة_أدلة_تي_إل_إس(): ط8 { أرجع 0x3A; }
}

// Parses every CERTIFICATE block of a PEM bundle.
عام عرف شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(البيانات: &متجه ط8): متجه شهادة_إكس509 {
    دع الكتل: متجه متجه ط8 = كتل_بي_إي_إم_بوصف(البيانات, «CERTIFICATE»);
    دع الشهادات: متغير متجه شهادة_إكس509 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكتل) مثل طبيعي)) {
        طابق حلل_شهادة_إكس509(&الكتل[ف]) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(الشهادة) -> { ألحق(الشهادات, الشهادة); };
        ف := ف + 1;
    }
    أرجع الشهادات;
}

عرف اقرأ_حزمة_جذور_تي_إل_إس(المسار: &نص): اختياري متجه شهادة_إكس509 {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(البيانات) -> {
        دع الشهادات: متجه شهادة_إكس509 = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(&البيانات);
        إذا ((الطول(الشهادات) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الشهادات);
    };
}

// The bytes of every file in one directory, each followed by a newline, for
// one PEM parse (one-certificate-per-file stores such as Android's).
عرف ألحق_ملفات_دليل_تي_إل_إس(الدليل: &نص, الناتج: &متغير متجه ط8): فراغ {
    طابق اقرأ_مدخلات_الدليل(الدليل) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(المدخلات) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
            دع البايتات: متغير متجه ط8 = [];
            ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(الدليل));
            ألحق(البايتات, 0x2F);
            ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&المدخلات[ف].الاسم));
            دع المسار: نص = من_بايتات(&البايتات);
            طابق اقرأ_بايتات_ملف(&المسار) مع
            | نتيجة.خطأ(_) -> { }
            | نتيجة.نجح(المحتوى) -> {
                دع ك: متغير طبيعي = 0;
                طالما (ك < (الطول(المحتوى) مثل طبيعي)) { ألحق(*الناتج, المحتوى[ك]); ك := ك + 1; }
                ألحق(*الناتج, 0x0A);
            };
            ف := ف + 1;
        }
    };
}

// The directories of a SSL_CERT_DIR value.
عرف أدلة_من_قائمة_تي_إل_إس(القائمة: &نص): متجه نص {
    دع الأدلة: متغير متجه نص = [];
    دع الحالي: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    دع الطول_الكلي: طبيعي = الطول(*القائمة) مثل طبيعي;
    طالما (ف <= الطول_الكلي) {
        إذا (ف == الطول_الكلي || (*القائمة)[ف] == فاصل_قائمة_أدلة_تي_إل_إس()) {
            إذا ((الطول(الحالي) مثل طبيعي) > 0) {
                ألحق(الأدلة, من_بايتات(&الحالي));
                دع فارغ: متجه ط8 = [];
                الحالي := فارغ;
            };
        }
        وإلا { ألحق(الحالي, (*القائمة)[ف]); };
        ف := ف + 1;
    }
    أرجع الأدلة;
}

// The platform trust anchors, or خطأ_مخزن_الثقة_تي_إل_إس when none can be read.
عام عرف جذور_النظام_تي_إل_إس(): نتيجة متجه شهادة_إكس509, عدد {
    دع اسم_المتغير: نص = «SSL_CERT_FILE»;
    طابق متغير_بيئة(&اسم_المتغير) مع
    | نتيجة.نجح(القيمة) -> {
        طابق القيمة مع
        | اختياري.موجود(المسار) -> {
            طابق اقرأ_حزمة_جذور_تي_إل_إس(&المسار) مع
            | اختياري.موجود(الشهادات) -> { أرجع نتيجة.نجح(الشهادات); }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس()); };
        }
        | اختياري.لا_شيء -> { };
    }
    | نتيجة.خطأ(_) -> { };
    دع اسم_الأدلة: نص = «SSL_CERT_DIR»;
    طابق متغير_بيئة(&اسم_الأدلة) مع
    | نتيجة.نجح(اختياري.موجود(القائمة)) -> {
        دع بايتات_الأدلة: متغير متجه ط8 = [];
        دع الأدلة_المحددة: متجه نص = أدلة_من_قائمة_تي_إل_إس(&القائمة);
        دع د: متغير طبيعي = 0;
        طالما (د < (الطول(الأدلة_المحددة) مثل طبيعي)) {
            ألحق_ملفات_دليل_تي_إل_إس(&الأدلة_المحددة[د], &متغير بايتات_الأدلة);
            د := د + 1;
        }
        دع من_الأدلة: متجه شهادة_إكس509 = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(&بايتات_الأدلة);
        إذا ((الطول(من_الأدلة) مثل طبيعي) > 0) { أرجع نتيجة.نجح(من_الأدلة); };
        أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس());
    }
    | _ -> { };
    دع المسارات: متجه نص = مسارات_جذور_النظام_تي_إل_إس();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المسارات) مثل طبيعي)) {
        طابق اقرأ_حزمة_جذور_تي_إل_إس(&المسارات[ف]) مع
        | اختياري.موجود(الشهادات) -> { أرجع نتيجة.نجح(الشهادات); }
        | اختياري.لا_شيء -> { };
        ف := ف + 1;
    }
    دع بايتات_النظام: متغير متجه ط8 = [];
    دع أدلة_النظام: متجه نص = أدلة_جذور_النظام_تي_إل_إس();
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(أدلة_النظام) مثل طبيعي)) {
        ألحق_ملفات_دليل_تي_إل_إس(&أدلة_النظام[ك], &متغير بايتات_النظام);
        ك := ك + 1;
    }
    دع من_النظام: متجه شهادة_إكس509 = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس(&بايتات_النظام);
    إذا ((الطول(من_النظام) مثل طبيعي) > 0) { أرجع نتيجة.نجح(من_النظام); };
    دع من_ويندوز: متجه شهادة_إكس509 = جذور_مخزن_ويندوز_تي_إل_إس();
    إذا ((الطول(من_ويندوز) مثل طبيعي) > 0) { أرجع نتيجة.نجح(من_ويندوز); };
    أرجع نتيجة.خطأ(خطأ_مخزن_الثقة_تي_إل_إس());
}

عام مرادف tls_system_roots = جذور_النظام_تي_إل_إس;
عام مرادف tls_certificates_from_pem = شهادات_من_حزمة_بي_إي_إم_تي_إل_إس;
