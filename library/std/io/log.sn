استورد io.println;
استورد text.from_bytes;

عام نوع مستوى_سجل =
    | تتبع
    | تصحيح
    | معلومة
    | تحذير
    | عطل
;

عام نوع مسجل = {
    الحد_الأدنى: مستوى_سجل
};

عرف رتبة_مستوى_سجل(المستوى: مستوى_سجل): غير_موقع {
    طابق المستوى مع
    | مستوى_سجل.تتبع -> { أرجع 0; }
    | مستوى_سجل.تصحيح -> { أرجع 1; }
    | مستوى_سجل.معلومة -> { أرجع 2; }
    | مستوى_سجل.تحذير -> { أرجع 3; }
    | مستوى_سجل.عطل -> { أرجع 4; };
}

عرف اسم_مستوى_سجل(المستوى: مستوى_سجل): نص {
    طابق المستوى مع
    | مستوى_سجل.تتبع -> { أرجع «TRACE»; }
    | مستوى_سجل.تصحيح -> { أرجع «DEBUG»; }
    | مستوى_سجل.معلومة -> { أرجع «INFO»; }
    | مستوى_سجل.تحذير -> { أرجع «WARN»; }
    | مستوى_سجل.عطل -> { أرجع «ERROR»; };
}

عام عرف أنشئ_مسجلا(الحد_الأدنى: مستوى_سجل): مسجل {
    دع الناتج: مسجل = { الحد_الأدنى: الحد_الأدنى };
    أرجع الناتج;
}

عرف رسالة_سجل(المستوى: مستوى_سجل, الرسالة: &نص): نص {
    دع الاسم: نص = اسم_مستوى_سجل(المستوى);
    دع القيمة: نص = *الرسالة;
    دع البايتات: متغير متجه غ8 = [];
    ألحق(البايتات, 0x5B);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الاسم) مثل غير_موقع)) { ألحق(البايتات, الاسم[ف]); ف := ف + 1; }
    ألحق(البايتات, 0x5D);
    ألحق(البايتات, 0x20);
    ف := 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) { ألحق(البايتات, القيمة[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عام عرف سجل(المسجل: &مسجل, المستوى: مستوى_سجل, الرسالة: &نص): نتيجة عدد, عدد {
    دع الحالة: مسجل = *المسجل;
    لو (رتبة_مستوى_سجل(المستوى) < رتبة_مستوى_سجل(الحالة.الحد_الأدنى)) {
        أرجع نتيجة.نجح(0);
    };
    دع النص: نص = رسالة_سجل(المستوى, الرسالة);
    أرجع اطبع_سطر_خطأ(النص);
}

عام مرادف log_level = مستوى_سجل;
عام مرادف logger = مسجل;
عام مرادف new_logger = أنشئ_مسجلا;
عام مرادف log = سجل;
عام مرادف log_level.trace = مستوى_سجل.تتبع;
عام مرادف log_level.debug = مستوى_سجل.تصحيح;
عام مرادف log_level.info = مستوى_سجل.معلومة;
عام مرادف log_level.warn = مستوى_سجل.تحذير;
عام مرادف log_level.error = مستوى_سجل.عطل;
