استورد io.println;
استورد io.print;
استورد text.from_bytes;
استورد fmt.fmt;

عام نوع مستوى_سجل =
    | تتبع
    | تصحيح
    | معلومة
    | تحذير
    | عطل
;

عام نوع مسجل = {
    الحد_الأدنى: مستوى_سجل
};

عرف رتبة_مستوى_سجل(المستوى: مستوى_سجل): طبيعي {
    طابق المستوى مع
    | مستوى_سجل.تتبع -> { أرجع 0; }
    | مستوى_سجل.تصحيح -> { أرجع 1; }
    | مستوى_سجل.معلومة -> { أرجع 2; }
    | مستوى_سجل.تحذير -> { أرجع 3; }
    | مستوى_سجل.عطل -> { أرجع 4; };
}

عرف اسم_مستوى_سجل(المستوى: مستوى_سجل): نص {
    طابق المستوى مع
    | مستوى_سجل.تتبع -> { أرجع «TRACE»; }
    | مستوى_سجل.تصحيح -> { أرجع «DEBUG»; }
    | مستوى_سجل.معلومة -> { أرجع «INFO»; }
    | مستوى_سجل.تحذير -> { أرجع «WARN»; }
    | مستوى_سجل.عطل -> { أرجع «ERROR»; };
}

عام عرف أنشئ_مسجلا(الحد_الأدنى: مستوى_سجل): مسجل {
    دع الناتج: مسجل = { الحد_الأدنى: الحد_الأدنى };
    أرجع الناتج;
}

عرف رسالة_سجل(المستوى: مستوى_سجل, الرسالة: &نص): نص {
    دع الاسم: نص = اسم_مستوى_سجل(المستوى);
    دع القيمة: نص = *الرسالة;
    دع البايتات: متغير متجه ط8 = [];
    ألحق(البايتات, 0x5B);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الاسم) مثل طبيعي)) { ألحق(البايتات, الاسم[ف]); ف := ف + 1; }
    ألحق_بايتات_نص(&متغير البايتات, «] »);
    ف := 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) { ألحق(البايتات, القيمة[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عام عرف سجل(المسجل: &مسجل, المستوى: مستوى_سجل, الرسالة: &نص): نتيجة عدد, عدد {
    دع الحالة: مسجل = *المسجل;
    لو (رتبة_مستوى_سجل(المستوى) < رتبة_مستوى_سجل(الحالة.الحد_الأدنى)) {
        أرجع نتيجة.نجح(0);
    };
    دع النص: نص = رسالة_سجل(المستوى, الرسالة);
    أرجع اطبع_سطر_خطأ(النص);
}

// A formatted entry (Rust's log::info!("…", args), Go's log.Printf): the
// level prefix and the std.fmt text are built in one buffer and written to
// standard error in one write. Below the logger's level nothing is formatted.
عام عرف سجل_منسقا(
    المسجل: &مسجل, المستوى: مستوى_سجل, القالب: نص, الوسائط: متجه قيمة_تنسيق
): نتيجة طبيعي, خطأ_تنسيق {
    دع الحالة: مسجل = *المسجل;
    لو (رتبة_مستوى_سجل(المستوى) < رتبة_مستوى_سجل(الحالة.الحد_الأدنى)) {
        أرجع نتيجة.نجح(0);
    };
    دع الاسم: نص = اسم_مستوى_سجل(المستوى);
    دع المنسق: متغير منسق = أنشئ_منسقا();
    نسق_في(&متغير المنسق, «[{}] », [قيمة_تنسيق.نص(&الاسم)])؟;
    نسق_في(&متغير المنسق, القالب, الوسائط)؟;
    اكتب_حرفا_في_المنسق(&متغير المنسق, '\n')؟;
    طابق اكتب_بايتات_خطأ(&المنسق.الناتج) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تنسيق.فشل_الكتابة(الرمز)); }
    | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل طبيعي); };
}

عام مرادف log_level = مستوى_سجل;
عام مرادف logger = مسجل;
عام مرادف new_logger = أنشئ_مسجلا;
عام مرادف log = سجل;
عام مرادف log_fmt = سجل_منسقا;
عام مرادف log_level.trace = مستوى_سجل.تتبع;
عام مرادف log_level.debug = مستوى_سجل.تصحيح;
عام مرادف log_level.info = مستوى_سجل.معلومة;
عام مرادف log_level.warn = مستوى_سجل.تحذير;
عام مرادف log_level.error = مستوى_سجل.عطل;
