استورد نصوص.من_بايتات;

استورد نظام_التشغيل.دخل_خرج;
استورد نظام_التشغيل.أخطاء;
عرف اقرأ_مقطع_دخل_قياسي(المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد): عدد {
    طابق اقرأ_دخلا_قياسيا_للنظام(المخزن, الإزاحة, المطلوب) مع
    | نتيجة.نجح(العدد) -> { أرجع العدد; }
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); };
}

عام نوع قراءة_بايت =
    | بايت بنوع ط8
    | نهاية
;

عام نوع قراءة_بايتات = {
    البايتات: متجه ط8,
    نهاية_المدخل: منطقي
};

عام نوع قارئ_مخزن = {
    المخزن: متجه ط8,
    البداية: طبيعي,
    النهاية: طبيعي,
    نهاية_المدخل: منطقي
};

عرف ابن_مخزن_قراءة_قياسي(السعة: طبيعي): متجه ط8 {
    ليكن المخزن: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(المخزن, 0 مثل ط8);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عام عرف اقرأ_بايتا(): نتيجة قراءة_بايت, عدد {
    ليكن المخزن: متغير متجه ط8 = [0];
    طابق اقرأ_دخلا_قياسيا_للنظام(&متغير المخزن, 0, 1) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ));
    }
    | نتيجة.نجح(العدد) -> {
        إذا (العدد == 0) { أرجع نتيجة.نجح(قراءة_بايت.نهاية()); };
        إذا (العدد != 1) { أرجع نتيجة.خطأ(-75); };
        أرجع نتيجة.نجح(قراءة_بايت.بايت(المخزن[0]));
    };
}

// Performs one bounded host read. A short successful read is not treated as EOF;
// EOF is observed only when the host reports zero bytes.
عام عرف اقرأ_حتى(الحد: طبيعي): نتيجة قراءة_بايتات, عدد {
    ليكن البايتات: متغير متجه ط8 = [];
    إذا (الحد == 0) {
        ليكن الفارغ: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    ليكن المخزن: متغير متجه ط8 = ابن_مخزن_قراءة_قياسي(الحد);
    ليكن المقروء: عدد = اقرأ_مقطع_دخل_قياسي(&متغير المخزن, 0, الحد مثل عدد);
    إذا (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    إذا (المقروء == 0) {
        ليكن النهاية: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: صواب };
        أرجع نتيجة.نجح(النهاية);
    };

    ليكن العدد_المقروء: طبيعي = المقروء مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد_المقروء) {
        ألحق(البايتات, المخزن[ف]);
        ف := ف + 1;
    }
    ليكن الناتج: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
    أرجع نتيجة.نجح(الناتج);
}

// Keeps reading through normal partial host reads until the requested size is
// acquired, EOF is observed, or a host error occurs.
عام عرف اقرأ_بالضبط(العدد: طبيعي): نتيجة قراءة_بايتات, عدد {
    ليكن البايتات: متغير متجه ط8 = [];
    إذا (العدد == 0) {
        ليكن الفارغ: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    ليكن سعة_المخزن: متغير طبيعي = 4096;
    إذا (العدد < سعة_المخزن) { سعة_المخزن := العدد; };
    ليكن المخزن: متغير متجه ط8 = ابن_مخزن_قراءة_قياسي(سعة_المخزن);
    ليكن انتهى: متغير منطقي = خطأ;
    ليكن الكلي: متغير طبيعي = 0;

    طالما ((الكلي < العدد) && !انتهى) {
        ليكن المتبقي: طبيعي = العدد - الكلي;
        ليكن المطلوب: متغير طبيعي = سعة_المخزن;
        إذا (المتبقي < المطلوب) { المطلوب := المتبقي; };
        ليكن المقروء: عدد = اقرأ_مقطع_دخل_قياسي(&متغير المخزن, 0, المطلوب مثل عدد);
        إذا (المقروء < 0) {
            أرجع نتيجة.خطأ(المقروء);
        } وإلا إذا (المقروء == 0) {
            انتهى := صواب;
        } وإلا {
            ليكن العدد_المقروء: طبيعي = المقروء مثل طبيعي;
            ليكن ف: متغير طبيعي = 0;
            طالما (ف < العدد_المقروء) {
                ألحق(البايتات, المخزن[ف]);
                ف := ف + 1;
            }
            الكلي := الكلي + العدد_المقروء;
        };
    }

    ليكن الناتج: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: انتهى };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_السطر(): نتيجة نص, عدد {
    // السطر يبقى قراءة دقيقة بلا تجاوز حتى لا يستهلك بايتات بعد محرف السطر.
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق اقرأ_بايتا() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | قراءة_بايت.نهاية -> { مستمر := خطأ; }
            | قراءة_بايت.بايت(البايت) -> {
                ألحق(البايتات, البايت);
                إذا (البايت == 10) { مستمر := خطأ; };
            };
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام عرف أنشئ_قارئا_مخزنا(السعة: طبيعي): قارئ_مخزن {
    ليكن الفعلية: متغير طبيعي = السعة;
    إذا (الفعلية == 0) { الفعلية := 4096; };
    ليكن المخزن_الأولي: متجه ط8 = ابن_مخزن_قراءة_قياسي(الفعلية);
    ليكن الناتج: قارئ_مخزن = {
        المخزن: المخزن_الأولي,
        البداية: 0,
        النهاية: 0,
        نهاية_المدخل: خطأ
    };
    أرجع الناتج;
}

عرف املأ_القارئ_المخزن(القارئ: &متغير قارئ_مخزن): نتيجة طبيعي, عدد {
    إذا ((*القارئ).البداية < (*القارئ).النهاية) {
        أرجع نتيجة.نجح((*القارئ).النهاية - (*القارئ).البداية);
    };
    إذا ((*القارئ).نهاية_المدخل) { أرجع نتيجة.نجح(0); };
    ليكن السعة: طبيعي = الطول((*القارئ).المخزن) مثل طبيعي;
    ليكن المقروء: عدد = اقرأ_مقطع_دخل_قياسي(&متغير (*القارئ).المخزن, 0, السعة مثل عدد);
    إذا (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    (*القارئ).البداية := 0;
    إذا (المقروء == 0) {
        (*القارئ).النهاية := 0;
        (*القارئ).نهاية_المدخل := صواب;
        أرجع نتيجة.نجح(0);
    };
    (*القارئ).النهاية := المقروء مثل طبيعي;
    ليكن النهاية: طبيعي = (*القارئ).النهاية;
    أرجع نتيجة.نجح(النهاية);
}

عام عرف اقرأ_بايتا_مخزنا(القارئ: &متغير قارئ_مخزن): نتيجة قراءة_بايت, عدد {
    طابق املأ_القارئ_المخزن(القارئ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المتاح) -> {
        إذا (المتاح == 0) { أرجع نتيجة.نجح(قراءة_بايت.نهاية()); };
    };

    ليكن البايت: ط8 = (*القارئ).المخزن[(*القارئ).البداية];
    (*القارئ).البداية := (*القارئ).البداية + 1;
    أرجع نتيجة.نجح(قراءة_بايت.بايت(البايت));
}

// Returns currently available buffered bytes, refilling at most once.
عام عرف اقرأ_حتى_مخزنا(
    القارئ: &متغير قارئ_مخزن,
    الحد: طبيعي
): نتيجة قراءة_بايتات, عدد {
    ليكن الناتج: متغير متجه ط8 = [];
    إذا (الحد == 0) {
        ليكن الفارغ: قراءة_بايتات = { البايتات: الناتج, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    طابق املأ_القارئ_المخزن(القارئ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    ليكن المتاح: طبيعي = (*القارئ).النهاية - (*القارئ).البداية;
    ليكن العدد: متغير طبيعي = المتاح;
    إذا (الحد < العدد) { العدد := الحد; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن موضع_المخزن: طبيعي = (*القارئ).البداية + ف;
        ألحق(الناتج, (*القارئ).المخزن[موضع_المخزن]);
        ف := ف + 1;
    }
    (*القارئ).البداية := (*القارئ).البداية + العدد;
    ليكن انتهى_المدخل: متغير منطقي = (*القارئ).نهاية_المدخل;
    إذا (انتهى_المدخل) { انتهى_المدخل := (*القارئ).البداية == (*القارئ).النهاية; };
    ليكن القراءة: قراءة_بايتات = {
        البايتات: الناتج,
        نهاية_المدخل: انتهى_المدخل
    };
    أرجع نتيجة.نجح(القراءة);
}

عام عرف اقرأ_بالضبط_مخزنا(
    القارئ: &متغير قارئ_مخزن,
    العدد: طبيعي
): نتيجة قراءة_بايتات, عدد {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن الكلي: متغير طبيعي = 0;
    ليكن انتهى: متغير منطقي = خطأ;

    طالما ((الكلي < العدد) && !انتهى) {
        طابق املأ_القارئ_المخزن(القارئ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المتاح) -> {
            إذا (المتاح == 0) {
                انتهى := صواب;
            } وإلا {
                ليكن المتبقي: طبيعي = العدد - الكلي;
                ليكن يؤخذ: متغير طبيعي = المتاح;
                إذا (المتبقي < يؤخذ) { يؤخذ := المتبقي; };
                ليكن ف: متغير طبيعي = 0;
                طالما (ف < يؤخذ) {
                    ليكن موضع_المخزن: طبيعي = (*القارئ).البداية + ف;
                    ألحق(الناتج, (*القارئ).المخزن[موضع_المخزن]);
                    ف := ف + 1;
                }
                (*القارئ).البداية := (*القارئ).البداية + يؤخذ;
                الكلي := الكلي + يؤخذ;
            };
        };
    }

    ليكن القراءة: قراءة_بايتات = { البايتات: الناتج, نهاية_المدخل: انتهى };
    أرجع نتيجة.نجح(القراءة);
}

عام عرف اقرأ_سطر_مخزنا(القارئ: &متغير قارئ_مخزن): نتيجة نص, عدد {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق اقرأ_بايتا_مخزنا(القارئ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | قراءة_بايت.نهاية -> { مستمر := خطأ; }
            | قراءة_بايت.بايت(البايت) -> {
                ألحق(البايتات, البايت);
                إذا (البايت == 10) { مستمر := خطأ; };
            };
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام مرادف byte_read = قراءة_بايت;
عام مرادف byte_read.byte = قراءة_بايت.بايت;
عام مرادف byte_read.eof = قراءة_بايت.نهاية;
عام مرادف byte_read_chunk = قراءة_بايتات;
عام مرادف read_byte = اقرأ_بايتا;
عام مرادف read_up_to = اقرأ_حتى;
عام مرادف read_exact = اقرأ_بالضبط;
عام مرادف read_line = اقرأ_السطر;
عام مرادف buffered_reader = قارئ_مخزن;
عام مرادف new_buffered_reader = أنشئ_قارئا_مخزنا;
عام مرادف buffered_read_byte = اقرأ_بايتا_مخزنا;
عام مرادف buffered_read = اقرأ_حتى_مخزنا;
عام مرادف buffered_read_up_to = اقرأ_حتى_مخزنا;
عام مرادف buffered_read_exact = اقرأ_بالضبط_مخزنا;
عام مرادف buffered_read_line = اقرأ_سطر_مخزنا;
