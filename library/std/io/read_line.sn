استورد text.from_bytes;

خارجي عرف تشغيل_قراءة_بايت_الدخل_القياسي(): عدد;
عرف اقرأ_بايتا_من_التشغيل(): عدد { أرجع تشغيل_قراءة_بايت_الدخل_القياسي(); }
خارجي عرف تشغيل_قراءة_مقطع_الدخل_القياسي(الحجة_0: متجه غ8, الحجة_1: عدد, الحجة_2: عدد): عدد;
عرف اقرأ_مقطعا_من_التشغيل(الحجة_0: &متغير متجه غ8, الحجة_1: عدد, الحجة_2: عدد): عدد {
    أرجع تشغيل_قراءة_مقطع_الدخل_القياسي(*الحجة_0, الحجة_1, الحجة_2);
}

عام نوع قراءة_بايت =
    | بايت بنوع غ8
    | نهاية
;

عام نوع قراءة_بايتات = {
    البايتات: متجه غ8,
    نهاية_المدخل: منطقي
};

عام نوع قارئ_مخزن = {
    المخزن: متجه غ8,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    نهاية_المدخل: منطقي
};

عرف ابن_مخزن_قراءة_قياسي(السعة: غير_موقع): متجه غ8 {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(المخزن, 0 مثل غ8);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عام عرف اقرأ_بايتا(): نتيجة قراءة_بايت, عدد {
    دع المقروء: عدد = اقرأ_بايتا_من_التشغيل();
    لو (المقروء == -1) { أرجع نتيجة.نجح(قراءة_بايت.نهاية()); };
    لو (المقروء < -1) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(قراءة_بايت.بايت(المقروء مثل غ8));
}

// Performs one bounded host read. A short successful read is not treated as EOF;
// EOF is observed only when the host reports zero bytes.
عام عرف اقرأ_حتى(الحد: غير_موقع): نتيجة قراءة_بايتات, عدد {
    دع البايتات: متغير متجه غ8 = [];
    لو (الحد == 0) {
        دع الفارغ: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    دع المخزن: متغير متجه غ8 = ابن_مخزن_قراءة_قياسي(الحد);
    دع المقروء: عدد = اقرأ_مقطعا_من_التشغيل(&متغير المخزن, 0, الحد مثل عدد);
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    لو (المقروء == 0) {
        دع النهاية: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: صواب };
        أرجع نتيجة.نجح(النهاية);
    };

    دع العدد_المقروء: غير_موقع = المقروء مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد_المقروء) {
        ألحق(البايتات, المخزن[ف]);
        ف := ف + 1;
    }
    دع الناتج: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
    أرجع نتيجة.نجح(الناتج);
}

// Keeps reading through normal partial host reads until the requested size is
// acquired, EOF is observed, or a host error occurs.
عام عرف اقرأ_بالضبط(العدد: غير_موقع): نتيجة قراءة_بايتات, عدد {
    دع البايتات: متغير متجه غ8 = [];
    لو (العدد == 0) {
        دع الفارغ: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    دع سعة_المخزن: متغير غير_موقع = 4096;
    لو (العدد < سعة_المخزن) { سعة_المخزن := العدد; };
    دع المخزن: متغير متجه غ8 = ابن_مخزن_قراءة_قياسي(سعة_المخزن);
    دع انتهى: متغير منطقي = خطأ;
    دع الكلي: متغير غير_موقع = 0;

    بينما ((الكلي < العدد) && !انتهى) {
        دع المتبقي: غير_موقع = العدد - الكلي;
        دع المطلوب: متغير غير_موقع = سعة_المخزن;
        لو (المتبقي < المطلوب) { المطلوب := المتبقي; };
        دع المقروء: عدد = اقرأ_مقطعا_من_التشغيل(&متغير المخزن, 0, المطلوب مثل عدد);
        لو (المقروء < 0) {
            أرجع نتيجة.خطأ(المقروء);
        } وإلا لو (المقروء == 0) {
            انتهى := صواب;
        } وإلا {
            دع العدد_المقروء: غير_موقع = المقروء مثل غير_موقع;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < العدد_المقروء) {
                ألحق(البايتات, المخزن[ف]);
                ف := ف + 1;
            }
            الكلي := الكلي + العدد_المقروء;
        };
    }

    دع الناتج: قراءة_بايتات = { البايتات: البايتات, نهاية_المدخل: انتهى };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_السطر(): نتيجة نص, عدد {
    // السطر يبقى قراءة دقيقة بلا تجاوز حتى لا يستهلك بايتات بعد محرف السطر.
    دع البايتات: متغير متجه غ8 = [];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق اقرأ_بايتا() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | قراءة_بايت.نهاية -> { مستمر := خطأ; }
            | قراءة_بايت.بايت(البايت) -> {
                ألحق(البايتات, البايت);
                لو (البايت == 10) { مستمر := خطأ; };
            };
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام عرف أنشئ_قارئا_مخزنا(السعة: غير_موقع): قارئ_مخزن {
    دع الفعلية: متغير غير_موقع = السعة;
    لو (الفعلية == 0) { الفعلية := 4096; };
    دع المخزن_الأولي: متجه غ8 = ابن_مخزن_قراءة_قياسي(الفعلية);
    دع الناتج: قارئ_مخزن = {
        المخزن: المخزن_الأولي,
        البداية: 0,
        النهاية: 0,
        نهاية_المدخل: خطأ
    };
    أرجع الناتج;
}

عرف املأ_القارئ_المخزن(القارئ: &متغير قارئ_مخزن): نتيجة غير_موقع, عدد {
    دع الحالة: متغير قارئ_مخزن = *القارئ;
    لو (الحالة.البداية < الحالة.النهاية) {
        أرجع نتيجة.نجح(الحالة.النهاية - الحالة.البداية);
    };
    لو (الحالة.نهاية_المدخل) { أرجع نتيجة.نجح(0); };

    دع السعة: غير_موقع = الطول(الحالة.المخزن) مثل غير_موقع;
    دع المقروء: عدد = اقرأ_مقطعا_من_التشغيل(&متغير الحالة.المخزن, 0, السعة مثل عدد);
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };

    الحالة.البداية := 0;
    لو (المقروء == 0) {
        الحالة.النهاية := 0;
        الحالة.نهاية_المدخل := صواب;
        *القارئ := الحالة;
        أرجع نتيجة.نجح(0);
    };

    الحالة.النهاية := المقروء مثل غير_موقع;
    دع النهاية: غير_موقع = الحالة.النهاية;
    *القارئ := الحالة;
    أرجع نتيجة.نجح(النهاية);
}

عام عرف اقرأ_بايتا_مخزنا(القارئ: &متغير قارئ_مخزن): نتيجة قراءة_بايت, عدد {
    طابق املأ_القارئ_المخزن(القارئ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المتاح) -> {
        لو (المتاح == 0) { أرجع نتيجة.نجح(قراءة_بايت.نهاية()); };
    };

    دع الحالة: متغير قارئ_مخزن = *القارئ;
    دع البايت: غ8 = الحالة.المخزن[الحالة.البداية];
    الحالة.البداية := الحالة.البداية + 1;
    *القارئ := الحالة;
    أرجع نتيجة.نجح(قراءة_بايت.بايت(البايت));
}

// Returns currently available buffered bytes, refilling at most once.
عام عرف اقرأ_حتى_مخزنا(
    القارئ: &متغير قارئ_مخزن,
    الحد: غير_موقع
): نتيجة قراءة_بايتات, عدد {
    دع الناتج: متغير متجه غ8 = [];
    لو (الحد == 0) {
        دع الفارغ: قراءة_بايتات = { البايتات: الناتج, نهاية_المدخل: خطأ };
        أرجع نتيجة.نجح(الفارغ);
    };

    طابق املأ_القارئ_المخزن(القارئ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    دع الحالة: متغير قارئ_مخزن = *القارئ;
    دع المتاح: غير_موقع = الحالة.النهاية - الحالة.البداية;
    دع العدد: متغير غير_موقع = المتاح;
    لو (الحد < العدد) { العدد := الحد; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع موضع_المخزن: غير_موقع = الحالة.البداية + ف;
        ألحق(الناتج, الحالة.المخزن[موضع_المخزن]);
        ف := ف + 1;
    }
    الحالة.البداية := الحالة.البداية + العدد;
    دع انتهى_المدخل: متغير منطقي = الحالة.نهاية_المدخل;
    لو (انتهى_المدخل) { انتهى_المدخل := الحالة.البداية == الحالة.النهاية; };
    *القارئ := الحالة;
    دع القراءة: قراءة_بايتات = {
        البايتات: الناتج,
        نهاية_المدخل: انتهى_المدخل
    };
    أرجع نتيجة.نجح(القراءة);
}

عام عرف اقرأ_بالضبط_مخزنا(
    القارئ: &متغير قارئ_مخزن,
    العدد: غير_موقع
): نتيجة قراءة_بايتات, عدد {
    دع الناتج: متغير متجه غ8 = [];
    دع الكلي: متغير غير_موقع = 0;
    دع انتهى: متغير منطقي = خطأ;

    بينما ((الكلي < العدد) && !انتهى) {
        طابق املأ_القارئ_المخزن(القارئ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المتاح) -> {
            لو (المتاح == 0) {
                انتهى := صواب;
            } وإلا {
                دع الحالة: متغير قارئ_مخزن = *القارئ;
                دع المتبقي: غير_موقع = العدد - الكلي;
                دع يؤخذ: متغير غير_موقع = المتاح;
                لو (المتبقي < يؤخذ) { يؤخذ := المتبقي; };
                دع ف: متغير غير_موقع = 0;
                بينما (ف < يؤخذ) {
                    دع موضع_المخزن: غير_موقع = الحالة.البداية + ف;
                    ألحق(الناتج, الحالة.المخزن[موضع_المخزن]);
                    ف := ف + 1;
                }
                الحالة.البداية := الحالة.البداية + يؤخذ;
                *القارئ := الحالة;
                الكلي := الكلي + يؤخذ;
            };
        };
    }

    دع القراءة: قراءة_بايتات = { البايتات: الناتج, نهاية_المدخل: انتهى };
    أرجع نتيجة.نجح(القراءة);
}

عام عرف اقرأ_سطر_مخزنا(القارئ: &متغير قارئ_مخزن): نتيجة نص, عدد {
    دع البايتات: متغير متجه غ8 = [];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        طابق اقرأ_بايتا_مخزنا(القارئ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الحالة) -> {
            طابق الحالة مع
            | قراءة_بايت.نهاية -> { مستمر := خطأ; }
            | قراءة_بايت.بايت(البايت) -> {
                ألحق(البايتات, البايت);
                لو (البايت == 10) { مستمر := خطأ; };
            };
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

عام مرادف byte_read = قراءة_بايت;
عام مرادف byte_read.byte = قراءة_بايت.بايت;
عام مرادف byte_read.eof = قراءة_بايت.نهاية;
عام مرادف byte_read_chunk = قراءة_بايتات;
عام مرادف read_byte = اقرأ_بايتا;
عام مرادف read_up_to = اقرأ_حتى;
عام مرادف read_exact = اقرأ_بالضبط;
عام مرادف read_line = اقرأ_السطر;
عام مرادف buffered_reader = قارئ_مخزن;
عام مرادف new_buffered_reader = أنشئ_قارئا_مخزنا;
عام مرادف buffered_read_byte = اقرأ_بايتا_مخزنا;
عام مرادف buffered_read = اقرأ_حتى_مخزنا;
عام مرادف buffered_read_up_to = اقرأ_حتى_مخزنا;
عام مرادف buffered_read_exact = اقرأ_بالضبط_مخزنا;
عام مرادف buffered_read_line = اقرأ_سطر_مخزنا;
