استورد io.print;

عام نوع وجهة_كاتب_مخزن =
    | خرج_قياسي
    | خطأ_قياسي
;

عام نوع كاتب_مخزن = {
    الوجهة: وجهة_كاتب_مخزن,
    البايتات: متجه غ8,
    السعة: غير_موقع
};

عرف أنشئ_كاتبا_مخزنا_لوجهة(الوجهة: وجهة_كاتب_مخزن, السعة: غير_موقع): كاتب_مخزن {
    دع البايتات_الفارغة: متجه غ8 = [];
    دع الناتج: كاتب_مخزن = {
        الوجهة: الوجهة,
        البايتات: البايتات_الفارغة,
        السعة: السعة
    };
    أرجع الناتج;
}

عام عرف أنشئ_كاتبا_مخزنا(السعة: غير_موقع): كاتب_مخزن {
    دع الوجهة: وجهة_كاتب_مخزن = وجهة_كاتب_مخزن.خرج_قياسي();
    أرجع أنشئ_كاتبا_مخزنا_لوجهة(الوجهة, السعة);
}

عام عرف أنشئ_كاتب_خطأ_مخزنا(السعة: غير_موقع): كاتب_مخزن {
    دع الوجهة: وجهة_كاتب_مخزن = وجهة_كاتب_مخزن.خطأ_قياسي();
    أرجع أنشئ_كاتبا_مخزنا_لوجهة(الوجهة, السعة);
}

عرف اكتب_كل_وجهة_مخزنة(
    الوجهة: وجهة_كاتب_مخزن,
    البايتات: &متجه غ8
): نتيجة عدد, عدد {
    طابق الوجهة مع
    | وجهة_كاتب_مخزن.خرج_قياسي -> {
        أرجع اكتب_بايتات_خرج(البايتات);
    }
    | وجهة_كاتب_مخزن.خطأ_قياسي -> {
        أرجع اكتب_بايتات_خطأ(البايتات);
    };
}

عام عرف أفرغ_الكاتب_المخزن(
    الكاتب: &متغير كاتب_مخزن
): نتيجة عدد, عدد {
    دع الحالة: متغير كاتب_مخزن = *الكاتب;
    لو (الطول(الحالة.البايتات) == 0) { أرجع نتيجة.نجح(0); };
    طابق اكتب_كل_وجهة_مخزنة(الحالة.الوجهة, &الحالة.البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المكتوب) -> {
        دع البايتات_الفارغة: متجه غ8 = [];
        الحالة.البايتات := البايتات_الفارغة;
        *الكاتب := الحالة;
        أرجع نتيجة.نجح(المكتوب);
    };
}

عام عرف اكتب_مخزنا(
    الكاتب: &متغير كاتب_مخزن,
    البايتات: &متجه غ8
): نتيجة غير_موقع, عدد {
    دع الحالة: متغير كاتب_مخزن = *الكاتب;
    دع المصدر: متجه غ8 = *البايتات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        ألحق(الحالة.البايتات, المصدر[ف]);
        ف := ف + 1;
        لو ((الحالة.السعة > 0) && ((الطول(الحالة.البايتات) مثل غير_موقع) >= الحالة.السعة)) {
            *الكاتب := الحالة;
            طابق أفرغ_الكاتب_المخزن(الكاتب) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { الحالة := *الكاتب; };
        };
    }
    دع السعة_النهائية: غير_موقع = الحالة.السعة;
    *الكاتب := الحالة;
    لو (السعة_النهائية == 0) {
        طابق أفرغ_الكاتب_المخزن(الكاتب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    أرجع نتيجة.نجح(الطول(المصدر) مثل غير_موقع);
}

عام مرادف buffered_writer_destination = وجهة_كاتب_مخزن;
عام مرادف buffered_writer_destination.stdout = وجهة_كاتب_مخزن.خرج_قياسي;
عام مرادف buffered_writer_destination.stderr = وجهة_كاتب_مخزن.خطأ_قياسي;
عام مرادف buffered_writer = كاتب_مخزن;
عام مرادف new_buffered_writer = أنشئ_كاتبا_مخزنا;
عام مرادف new_buffered_error_writer = أنشئ_كاتب_خطأ_مخزنا;
عام مرادف buffered_write = اكتب_مخزنا;
عام مرادف flush = أفرغ_الكاتب_المخزن;
