// Generic byte-writer policy. file_handle_write, tcp_write, and tls_write
// satisfy this shape directly.
عام نوع كاتب<ح> = دالة(&ح, &متجه ط8, عدد, عدد): نتيجة عدد, عدد;

// Canonical full-write loop for both complete buffers and valid subranges.
// No intermediate byte-vector copy is needed to write a partially filled buffer.
عرف اكتب_نطاقا_كله<ح>(
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    البايتات: &متجه ط8,
    البداية: طبيعي,
    العدد: طبيعي
): نتيجة طبيعي, عدد {
    دع السعة: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (البداية > السعة) { أرجع نتيجة.خطأ(-1); };
    إذا (العدد > السعة - البداية) { أرجع نتيجة.خطأ(-1); };
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        دع إزاحة_الكتابة: طبيعي = البداية + الموضع;
        دع المتبقي: طبيعي = العدد - الموضع;
        طابق الكتابة(الوجهة, البايتات, إزاحة_الكتابة مثل عدد, المتبقي مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المكتوب) -> {
            إذا (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
            إذا (المكتوب == 0) { أرجع نتيجة.خطأ(-1); };
            إذا ((المكتوب مثل طبيعي) > المتبقي) {
                أرجع نتيجة.خطأ(-1);
            };
            الموضع := الموضع + (المكتوب مثل طبيعي);
        };
    }
    أرجع نتيجة.نجح(الموضع);
}

عام عرف اكتب_الكل<ح>(
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    البايتات: &متجه ط8
): نتيجة طبيعي, عدد {
    أرجع اكتب_نطاقا_كله(الوجهة, الكتابة, البايتات, 0, الطول(*البايتات) مثل طبيعي);
}

عام عرف انسخ_من_قارئ_إلى_كاتب<م, و>(
    المصدر: &م,
    القراءة: دالة(&م, &متغير متجه ط8, عدد, عدد): نتيجة عدد, عدد,
    الوجهة: &و,
    الكتابة: كاتب<و>,
    حد_أقصى: طبيعي
): نتيجة طبيعي, عدد {
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(المخزن, 0); ف := ف + 1; }
    دع الكلي: متغير طبيعي = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع المطلوب: متغير طبيعي = 8192;
        إذا (حد_أقصى > 0) {
            إذا (الكلي >= حد_أقصى) { مستمر := خطأ; المطلوب := 0; }
            وإلا إذا ((حد_أقصى - الكلي) < المطلوب) { المطلوب := حد_أقصى - الكلي; };
        };
        إذا (المطلوب > 0) {
            طابق القراءة(المصدر, &متغير المخزن, 0, المطلوب مثل عدد) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المقروء) -> {
                إذا (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
                إذا ((المقروء مثل طبيعي) > المطلوب) {
                    أرجع نتيجة.خطأ(-1);
                };
                إذا (المقروء == 0) { مستمر := خطأ; }
                وإلا {
                    دع العدد: طبيعي = المقروء مثل طبيعي;
                    طابق اكتب_نطاقا_كله(الوجهة, الكتابة, &المخزن, 0, العدد) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    إذا (الكلي > (~(0 مثل طبيعي)) - العدد) {
                        أرجع نتيجة.خطأ(-1);
                    };
                    الكلي := الكلي + العدد;
                };
            };
        };
    }
    أرجع نتيجة.نجح(الكلي);
}

عام نوع writer<S> = كاتب<S>;
عام مرادف write_all = اكتب_الكل;
عام مرادف copy_reader_to_writer = انسخ_من_قارئ_إلى_كاتب;
