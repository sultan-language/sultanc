// Generic byte-writer policy. file_handle_write, tcp_write, and tls_write
// satisfy this shape directly.
عام نوع كاتب<ح> = دالة(&ح, &متجه غ8, عدد, عدد): نتيجة عدد, عدد;

// Canonical full-write loop for both complete buffers and valid subranges.
// No intermediate byte-vector copy is needed to write a partially filled buffer.
عرف اكتب_نطاقا_كله<ح>(
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    العدد: غير_موقع
): نتيجة غير_موقع, عدد {
    دع السعة: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (البداية > السعة) { أرجع نتيجة.خطأ(-1); };
    لو (العدد > السعة - البداية) { أرجع نتيجة.خطأ(-1); };
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < العدد) {
        دع إزاحة_الكتابة: غير_موقع = البداية + الموضع;
        دع المتبقي: غير_موقع = العدد - الموضع;
        طابق الكتابة(الوجهة, البايتات, إزاحة_الكتابة مثل عدد, المتبقي مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المكتوب) -> {
            لو (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
            لو (المكتوب == 0) { أرجع نتيجة.خطأ(-1); };
            لو ((المكتوب مثل غير_موقع) > المتبقي) {
                أرجع نتيجة.خطأ(-1);
            };
            الموضع := الموضع + (المكتوب مثل غير_موقع);
        };
    }
    أرجع نتيجة.نجح(الموضع);
}

عام عرف اكتب_الكل<ح>(
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    البايتات: &متجه غ8
): نتيجة غير_موقع, عدد {
    أرجع اكتب_نطاقا_كله(الوجهة, الكتابة, البايتات, 0, الطول(*البايتات) مثل غير_موقع);
}

عام عرف انسخ_من_قارئ_إلى_كاتب<م, و>(
    المصدر: &م,
    القراءة: دالة(&م, &متغير متجه غ8, عدد, عدد): نتيجة عدد, عدد,
    الوجهة: &و,
    الكتابة: كاتب<و>,
    حد_أقصى: غير_موقع
): نتيجة غير_موقع, عدد {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8192) { ألحق(المخزن, 0); ف := ف + 1; }
    دع الكلي: متغير غير_موقع = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المطلوب: متغير غير_موقع = 8192;
        لو (حد_أقصى > 0) {
            لو (الكلي >= حد_أقصى) { مستمر := خطأ; المطلوب := 0; }
            وإلا لو ((حد_أقصى - الكلي) < المطلوب) { المطلوب := حد_أقصى - الكلي; };
        };
        لو (المطلوب > 0) {
            طابق القراءة(المصدر, &متغير المخزن, 0, المطلوب مثل عدد) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المقروء) -> {
                لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
                لو ((المقروء مثل غير_موقع) > المطلوب) {
                    أرجع نتيجة.خطأ(-1);
                };
                لو (المقروء == 0) { مستمر := خطأ; }
                وإلا {
                    دع العدد: غير_موقع = المقروء مثل غير_موقع;
                    طابق اكتب_نطاقا_كله(الوجهة, الكتابة, &المخزن, 0, العدد) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                    لو (الكلي > (~(0 مثل غير_موقع)) - العدد) {
                        أرجع نتيجة.خطأ(-1);
                    };
                    الكلي := الكلي + العدد;
                };
            };
        };
    }
    أرجع نتيجة.نجح(الكلي);
}

عام نوع writer<S> = كاتب<S>;
عام مرادف write_all = اكتب_الكل;
عام مرادف copy_reader_to_writer = انسخ_من_قارئ_إلى_كاتب;
