// Generic byte-reader policy. SultanC does not need a trait system here:
// file_handle_read, tcp_read, and tls_read already share this exact shape.
عام نوع قارئ<ح> = دالة(&ح, &متغير متجه ط8, عدد, عدد): نتيجة عدد, عدد;

عرف ابن_مخزن_قراءة(السعة: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف اقرأ_حتى_النهاية<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    حد_أقصى: طبيعي
): نتيجة متجه ط8, عدد {
    دع الناتج: متغير متجه ط8 = [];
    دع المخزن: متغير متجه ط8 = ابن_مخزن_قراءة(8192);
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع المسموح: متغير طبيعي = 8192;
        لو (حد_أقصى > 0) {
            دع الحالي: طبيعي = الطول(الناتج) مثل طبيعي;
            لو (الحالي >= حد_أقصى) { مستمر := خطأ; المسموح := 0; }
            وإلا لو ((حد_أقصى - الحالي) < المسموح) { المسموح := حد_أقصى - الحالي; };
        };
        لو (المسموح > 0) {
            طابق القراءة(المصدر, &متغير المخزن, 0, المسموح مثل عدد) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المقروء) -> {
                لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
                لو ((المقروء مثل طبيعي) > المسموح) {
                    أرجع نتيجة.خطأ(-1);
                };
                لو (المقروء == 0) { مستمر := خطأ; }
                وإلا {
                    دع ف: متغير طبيعي = 0;
                    دع العدد: طبيعي = المقروء مثل طبيعي;
                    طالما (ف < العدد) { ألحق(الناتج, المخزن[ف]); ف := ف + 1; }
                };
            };
        };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_بالضبط<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    العدد: طبيعي
): نتيجة متجه ط8, عدد {
    دع الناتج: متغير متجه ط8 = ابن_مخزن_قراءة(العدد);
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        طابق القراءة(المصدر, &متغير الناتج, الموضع مثل عدد, (العدد - الموضع) مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقروء) -> {
            لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
            لو (المقروء == 0) { أرجع نتيجة.خطأ(-1); };
            لو ((المقروء مثل طبيعي) > (العدد - الموضع)) {
                أرجع نتيجة.خطأ(-1);
            };
            الموضع := الموضع + (المقروء مثل طبيعي);
        };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام نوع reader<S> = قارئ<S>;
عام مرادف read_to_end = اقرأ_حتى_النهاية;
عام مرادف read_exact_from = اقرأ_بالضبط;
