// Generic byte-reader policy. SultanC does not need a trait system here:
// file_handle_read, tcp_read, and tls_read already share this exact shape.
عام نوع قارئ<ح> = دالة(&ح, &متغير متجه غ8, عدد, عدد): نتيجة عدد, عدد;

عرف ابن_مخزن_قراءة(السعة: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف اقرأ_حتى_النهاية<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    حد_أقصى: غير_موقع
): نتيجة متجه غ8, عدد {
    دع الناتج: متغير متجه غ8 = [];
    دع المخزن: متغير متجه غ8 = ابن_مخزن_قراءة(8192);
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المسموح: متغير غير_موقع = 8192;
        لو (حد_أقصى > 0) {
            دع الحالي: غير_موقع = الطول(الناتج) مثل غير_موقع;
            لو (الحالي >= حد_أقصى) { مستمر := خطأ; المسموح := 0; }
            وإلا لو ((حد_أقصى - الحالي) < المسموح) { المسموح := حد_أقصى - الحالي; };
        };
        لو (المسموح > 0) {
            طابق القراءة(المصدر, &متغير المخزن, 0, المسموح مثل عدد) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المقروء) -> {
                لو (المقروء <= 0) { مستمر := خطأ; }
                وإلا {
                    دع ف: متغير غير_موقع = 0;
                    دع العدد: غير_موقع = المقروء مثل غير_موقع;
                    بينما (ف < العدد) { ألحق(الناتج, المخزن[ف]); ف := ف + 1; }
                };
            };
        };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_بالضبط<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    العدد: غير_موقع
): نتيجة متجه غ8, عدد {
    دع الناتج: متغير متجه غ8 = ابن_مخزن_قراءة(العدد);
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < العدد) {
        طابق القراءة(المصدر, &متغير الناتج, الموضع مثل عدد, (العدد - الموضع) مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المقروء) -> {
            لو (المقروء <= 0) { أرجع نتيجة.خطأ(-1); };
            الموضع := الموضع + (المقروء مثل غير_موقع);
        };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام نوع reader<S> = قارئ<S>;
عام مرادف read_to_end = اقرأ_حتى_النهاية;
عام مرادف read_exact_from = اقرأ_بالضبط;
