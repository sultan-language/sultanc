استورد io.print;

// Public line output is real std behavior built on print.
عام عرف اطبع_سطر(النص: نص): نتيجة عدد, عدد {
    دع الأول: عدد;
    طابق اطبع(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المكتوب) -> { الأول := المكتوب; };

    طابق اطبع("\n") مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(الأول + المكتوب); };
}

عام عرف اطبع_سطر_خطأ(النص: نص): نتيجة عدد, عدد {
    دع الأول: عدد;
    طابق اطبع_خطأ(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المكتوب) -> { الأول := المكتوب; };

    طابق اطبع_خطأ("\n") مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(الأول + المكتوب); };
}

عام مرادف println = اطبع_سطر;
عام مرادف eprintln = اطبع_سطر_خطأ;
