استورد os.io;
استورد os.error;
استورد io.writer;

// Private standard-stream selection; native descriptors and handles stay in os.io.
نوع وجهة_تيار_قياسي =
    | خرج
    | خطأ
;

// Adapt one native byte write to the established generic writer signature.
عرف اكتب_مقطع_تيار_قياسي(
    الوجهة: &وجهة_تيار_قياسي,
    البايتات: &متجه غ8,
    الإزاحة: عدد,
    المطلوب: عدد
): نتيجة عدد, عدد {
    طابق *الوجهة مع
    | وجهة_تيار_قياسي.خرج -> {
        طابق اكتب_خرجا_قياسيا_للنظام(البايتات, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(المكتوب); };
    }
    | وجهة_تيار_قياسي.خطأ -> {
        طابق اكتب_خطأ_قياسيا_للنظام(البايتات, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
        | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(المكتوب); };
    };
}

// Use std.io.writer for partial writes and zero-progress handling.
عرف اكتب_كل_تيار_قياسي(
    الوجهة: وجهة_تيار_قياسي, البايتات: &متجه غ8
): نتيجة عدد, عدد {
    طابق اكتب_الكل(&الوجهة, اكتب_مقطع_تيار_قياسي, البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
}

// Text length and indexing here are UTF-8 bytes, not Unicode scalar indexes.
// Copy them once at the text/IO boundary, without transcoding or validation.
عرف بايتات_تيار_من_نص(المحتوى: &نص): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع العدد: غير_موقع = الطول(*المحتوى) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < العدد) {
        ألحق(الناتج, (*المحتوى)[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع الناتج;
}

عام عرف اطبع(النص: نص): نتيجة عدد, عدد {
    دع البايتات: متجه غ8 = بايتات_تيار_من_نص(&النص);
    أرجع اكتب_بايتات_خرج(&البايتات);
}

عام عرف اطبع_خطأ(النص: نص): نتيجة عدد, عدد {
    دع البايتات: متجه غ8 = بايتات_تيار_من_نص(&النص);
    أرجع اكتب_بايتات_خطأ(&البايتات);
}

// Borrow binary buffers directly: no text allocation or encoding conversion.
عام عرف اكتب_بايتات_خرج(البايتات: &متجه غ8): نتيجة عدد, عدد {
    أرجع اكتب_كل_تيار_قياسي(وجهة_تيار_قياسي.خرج(), البايتات);
}

عام عرف اكتب_بايتات_خطأ(البايتات: &متجه غ8): نتيجة عدد, عدد {
    أرجع اكتب_كل_تيار_قياسي(وجهة_تيار_قياسي.خطأ(), البايتات);
}

عام مرادف print = اطبع;
عام مرادف eprint = اطبع_خطأ;
عام مرادف write_bytes = اكتب_بايتات_خرج;
عام مرادف write_all_bytes = اكتب_بايتات_خرج;
عام مرادف write_error_bytes = اكتب_بايتات_خطأ;
عام مرادف write_all_error_bytes = اكتب_بايتات_خطأ;
