// The root file of std.io: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). An import may
// use either name; both name one module.

module buffered_writer { ar: كاتب_مؤقت };
module log { ar: سجل };
module print { ar: اطبع };
module print_failure { ar: اطبع_فشل };
module print_formatted { ar: اطبع_منسقا };
module println { ar: اطبع_سطر };
module read_line { ar: اقرأ_سطر };
module reader { ar: قارئ };

// Re-exported: these children are modules and folders of alloc and core, at the same
// paths (docs/en/reference/std-layers.md). One file, one module.
module writer = core.io.writer { ar: كاتب };
