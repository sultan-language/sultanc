خارجي عرف تشغيل_حجم_صفحة_النظام(): عدد;
عرف حجم_صفحة_خام(): عدد { أرجع تشغيل_حجم_صفحة_النظام(); }
خارجي عرف تشغيل_خريطة_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف خريطة_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_خريطة_ذاكرة_النظام(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_إلغاء_خريطة_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف إلغاء_خريطة_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_إلغاء_خريطة_ذاكرة_النظام(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_حماية_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد;
عرف حماية_خام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد { أرجع تشغيل_حماية_ذاكرة_النظام(الحجة_0, الحجة_1, الحجة_2); }
خارجي عرف تشغيل_قفل_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف قفل_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_قفل_ذاكرة_النظام(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_إلغاء_قفل_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد): عدد;
عرف إلغاء_قفل_خام(الحجة_0: عدد, الحجة_1: عدد): عدد { أرجع تشغيل_إلغاء_قفل_ذاكرة_النظام(الحجة_0, الحجة_1); }
خارجي عرف تشغيل_نصيحة_ذاكرة_النظام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد;
عرف نصيحة_خام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد { أرجع تشغيل_نصيحة_ذاكرة_النظام(الحجة_0, الحجة_1, الحجة_2); }

عام نوع منطقة_ذاكرة_نظام = {
    العنوان: غير_موقع,
    الحجم: غير_موقع
};

عام نوع حماية_ذاكرة_نظام =
    | لا_وصول
    | قراءة
    | كتابة
    | قراءة_وكتابة
    | تنفيذ
    | قراءة_وتنفيذ
    | كتابة_وتنفيذ
    | قراءة_وكتابة_وتنفيذ
;

عام نوع نصيحة_ذاكرة_نظام =
    | عادية
    | عشوائية
    | تسلسلية
    | ستحتاج
    | لن_تحتاج
;

عرف رمز_الحماية(الحماية: حماية_ذاكرة_نظام): عدد {
    طابق الحماية مع
    | حماية_ذاكرة_نظام.لا_وصول -> { أرجع 0; }
    | حماية_ذاكرة_نظام.قراءة -> { أرجع 1; }
    | حماية_ذاكرة_نظام.كتابة -> { أرجع 2; }
    | حماية_ذاكرة_نظام.قراءة_وكتابة -> { أرجع 3; }
    | حماية_ذاكرة_نظام.تنفيذ -> { أرجع 4; }
    | حماية_ذاكرة_نظام.قراءة_وتنفيذ -> { أرجع 5; }
    | حماية_ذاكرة_نظام.كتابة_وتنفيذ -> { أرجع 6; }
    | حماية_ذاكرة_نظام.قراءة_وكتابة_وتنفيذ -> { أرجع 7; };
}

عرف رمز_النصيحة(النصيحة: نصيحة_ذاكرة_نظام): عدد {
    طابق النصيحة مع
    | نصيحة_ذاكرة_نظام.عادية -> { أرجع 0; }
    | نصيحة_ذاكرة_نظام.عشوائية -> { أرجع 1; }
    | نصيحة_ذاكرة_نظام.تسلسلية -> { أرجع 2; }
    | نصيحة_ذاكرة_نظام.ستحتاج -> { أرجع 3; }
    | نصيحة_ذاكرة_نظام.لن_تحتاج -> { أرجع 4; };
}

عام عرف حجم_صفحة_النظام(): غير_موقع {
    دع الخام: عدد = حجم_صفحة_خام();
    أرجع الخام مثل غير_موقع;
}

عام عرف اربط_ذاكرة_النظام(
    الحجم: غير_موقع,
    الحماية: حماية_ذاكرة_نظام
): نتيجة منطقة_ذاكرة_نظام, عدد {
    لو (الحجم == 0) { أرجع نتيجة.خطأ(-22); };
    دع الخام: عدد = خريطة_خام(الحجم مثل عدد, رمز_الحماية(الحماية));
    لو (الخام < 0) { أرجع نتيجة.خطأ(الخام); };
    دع العنوان: غير_موقع = الخام مثل غير_موقع;
    دع المنطقة: منطقة_ذاكرة_نظام = {
        العنوان: العنوان,
        الحجم: الحجم
    };
    أرجع نتيجة.نجح(المنطقة);
}

عام عرف الغ_ربط_ذاكرة_النظام(المنطقة: &منطقة_ذاكرة_نظام): نتيجة عدد, عدد {
    دع القيمة: منطقة_ذاكرة_نظام = *المنطقة;
    دع الحالة: عدد = إلغاء_خريطة_خام(القيمة.العنوان مثل عدد, القيمة.الحجم مثل عدد);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(0);
}

عام عرف غير_حماية_ذاكرة_النظام(
    المنطقة: &منطقة_ذاكرة_نظام,
    الحماية: حماية_ذاكرة_نظام
): نتيجة عدد, عدد {
    دع القيمة: منطقة_ذاكرة_نظام = *المنطقة;
    دع الحالة: عدد = حماية_خام(
        القيمة.العنوان مثل عدد,
        القيمة.الحجم مثل عدد,
        رمز_الحماية(الحماية)
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(0);
}

عام عرف اقفل_ذاكرة_النظام(المنطقة: &منطقة_ذاكرة_نظام): نتيجة عدد, عدد {
    دع القيمة: منطقة_ذاكرة_نظام = *المنطقة;
    دع الحالة: عدد = قفل_خام(القيمة.العنوان مثل عدد, القيمة.الحجم مثل عدد);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(0);
}

عام عرف الغ_قفل_ذاكرة_النظام(المنطقة: &منطقة_ذاكرة_نظام): نتيجة عدد, عدد {
    دع القيمة: منطقة_ذاكرة_نظام = *المنطقة;
    دع الحالة: عدد = إلغاء_قفل_خام(القيمة.العنوان مثل عدد, القيمة.الحجم مثل عدد);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(0);
}

عام عرف انصح_ذاكرة_النظام(
    المنطقة: &منطقة_ذاكرة_نظام,
    النصيحة: نصيحة_ذاكرة_نظام
): نتيجة عدد, عدد {
    دع القيمة: منطقة_ذاكرة_نظام = *المنطقة;
    دع الحالة: عدد = نصيحة_خام(
        القيمة.العنوان مثل عدد,
        القيمة.الحجم مثل عدد,
        رمز_النصيحة(النصيحة)
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(0);
}

عام مرادف memory_region = منطقة_ذاكرة_نظام;
عام مرادف memory_protection = حماية_ذاكرة_نظام;
عام مرادف memory_advice = نصيحة_ذاكرة_نظام;
عام مرادف page_size = حجم_صفحة_النظام;
عام مرادف mmap = اربط_ذاكرة_النظام;
عام مرادف munmap = الغ_ربط_ذاكرة_النظام;
عام مرادف mprotect = غير_حماية_ذاكرة_النظام;
عام مرادف mlock = اقفل_ذاكرة_النظام;
عام مرادف munlock = الغ_قفل_ذاكرة_النظام;
عام مرادف madvise = انصح_ذاكرة_النظام;

عام مرادف memory_protection.none = حماية_ذاكرة_نظام.لا_وصول;
عام مرادف memory_protection.read = حماية_ذاكرة_نظام.قراءة;
عام مرادف memory_protection.write = حماية_ذاكرة_نظام.كتابة;
عام مرادف memory_protection.read_write = حماية_ذاكرة_نظام.قراءة_وكتابة;
عام مرادف memory_protection.execute = حماية_ذاكرة_نظام.تنفيذ;
عام مرادف memory_protection.read_execute = حماية_ذاكرة_نظام.قراءة_وتنفيذ;
عام مرادف memory_protection.write_execute = حماية_ذاكرة_نظام.كتابة_وتنفيذ;
عام مرادف memory_protection.read_write_execute = حماية_ذاكرة_نظام.قراءة_وكتابة_وتنفيذ;

عام مرادف memory_advice.normal = نصيحة_ذاكرة_نظام.عادية;
عام مرادف memory_advice.random = نصيحة_ذاكرة_نظام.عشوائية;
عام مرادف memory_advice.sequential = نصيحة_ذاكرة_نظام.تسلسلية;
عام مرادف memory_advice.will_need = نصيحة_ذاكرة_نظام.ستحتاج;
عام مرادف memory_advice.dont_need = نصيحة_ذاكرة_نظام.لن_تحتاج;

عام عرف حماية_ذاكرة_بلا_وصول(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.لا_وصول(); }
عام عرف حماية_ذاكرة_قراءة(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.قراءة(); }
عام عرف حماية_ذاكرة_كتابة(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.كتابة(); }
عام عرف حماية_ذاكرة_قراءة_وكتابة(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.قراءة_وكتابة(); }
عام عرف حماية_ذاكرة_تنفيذ(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.تنفيذ(); }
عام عرف حماية_ذاكرة_قراءة_وتنفيذ(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.قراءة_وتنفيذ(); }
عام عرف حماية_ذاكرة_كتابة_وتنفيذ(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.كتابة_وتنفيذ(); }
عام عرف حماية_ذاكرة_قراءة_وكتابة_وتنفيذ(): حماية_ذاكرة_نظام { أرجع حماية_ذاكرة_نظام.قراءة_وكتابة_وتنفيذ(); }

عام عرف نصيحة_ذاكرة_عادية(): نصيحة_ذاكرة_نظام { أرجع نصيحة_ذاكرة_نظام.عادية(); }
عام عرف نصيحة_ذاكرة_عشوائية(): نصيحة_ذاكرة_نظام { أرجع نصيحة_ذاكرة_نظام.عشوائية(); }
عام عرف نصيحة_ذاكرة_تسلسلية(): نصيحة_ذاكرة_نظام { أرجع نصيحة_ذاكرة_نظام.تسلسلية(); }
عام عرف نصيحة_ذاكرة_ستحتاج(): نصيحة_ذاكرة_نظام { أرجع نصيحة_ذاكرة_نظام.ستحتاج(); }
عام عرف نصيحة_ذاكرة_لن_تحتاج(): نصيحة_ذاكرة_نظام { أرجع نصيحة_ذاكرة_نظام.لن_تحتاج(); }

عام مرادف memory_protection_none = حماية_ذاكرة_بلا_وصول;
عام مرادف memory_protection_read = حماية_ذاكرة_قراءة;
عام مرادف memory_protection_write = حماية_ذاكرة_كتابة;
عام مرادف memory_protection_read_write = حماية_ذاكرة_قراءة_وكتابة;
عام مرادف memory_protection_execute = حماية_ذاكرة_تنفيذ;
عام مرادف memory_protection_read_execute = حماية_ذاكرة_قراءة_وتنفيذ;
عام مرادف memory_protection_write_execute = حماية_ذاكرة_كتابة_وتنفيذ;
عام مرادف memory_protection_read_write_execute = حماية_ذاكرة_قراءة_وكتابة_وتنفيذ;
عام مرادف memory_advice_normal = نصيحة_ذاكرة_عادية;
عام مرادف memory_advice_random = نصيحة_ذاكرة_عشوائية;
عام مرادف memory_advice_sequential = نصيحة_ذاكرة_تسلسلية;
عام مرادف memory_advice_will_need = نصيحة_ذاكرة_ستحتاج;
عام مرادف memory_advice_dont_need = نصيحة_ذاكرة_لن_تحتاج;
