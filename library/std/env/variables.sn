استورد env.environment;
استورد fs.error;
استورد fs.attributes;
استورد text.from_bytes;
استورد os.error;
استورد os.environment_list;
استورد os.file_attributes;
استورد os.environment_validation;
استورد env.table;

// The whole environment, setting and removing variables, the home directory
// and changing the working directory (Rust env::vars, env::set_var,
// env::remove_var, env::home_dir, env::set_current_dir; Go os.Environ,
// os.Setenv, os.Unsetenv, os.UserHomeDir, os.Chdir). Setting or removing a
// variable changes the table std keeps (std.env.table); every later read,
// and every child started without an explicit environment, sees it.

عام نوع مدخل_بيئة = { الاسم: نص, القيمة: نص };

// Every variable, in the order the system keeps them. An entry without '='
// or with an empty name is skipped.
عام عرف متغيرات_البيئة(): نتيجة متجه مدخل_بيئة, فئة_خطأ_نظام {
    دع من_النظام: متغير نتيجة متجه متجه ط8, خطأ_حد_نظام = نتيجة.نجح(مداخل_جدول_البيئة_إن_وجد());
    إذا (!هل_جدول_البيئة_مهيأ()) { من_النظام := اقرأ_بيئة_النظام(); };
    طابق من_النظام مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فئة_خطأ_حد_نظام(الخطأ)); }
    | نتيجة.نجح(المداخل) -> {
        دع الناتج: متغير متجه مدخل_بيئة = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع المدخل: &متجه ط8 = &المداخل[ف];
            دع العدد: طبيعي = الطول(*المدخل) مثل طبيعي;
            دع الفاصل: متغير طبيعي = 0;
            طالما (الفاصل < العدد && (*المدخل)[الفاصل] != 0x3D) { الفاصل := الفاصل + 1; }
            إذا (الفاصل > 0 && الفاصل < العدد) {
                دع الاسم: متغير متجه ط8 = [];
                دع القيمة: متغير متجه ط8 = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < الفاصل) { ألحق(الاسم, (*المدخل)[ح]); ح := ح + 1; }
                ح := الفاصل + 1;
                طالما (ح < العدد) { ألحق(القيمة, (*المدخل)[ح]); ح := ح + 1; }
                دع الزوج: مدخل_بيئة = { الاسم: من_بايتات(&الاسم), القيمة: من_بايتات(&القيمة) };
                ألحق(الناتج, الزوج);
            };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    };
}

إذا (الهدف.المنصة == «windows») {
    عرف اسم_متغير_الدليل_الرئيسي(): نص { أرجع «USERPROFILE»; }
} وإلا {
    عرف اسم_متغير_الدليل_الرئيسي(): نص { أرجع «HOME»; }
}

// The user's home directory: HOME (USERPROFILE on Windows), when set and
// not empty. Nothing otherwise: no password database is consulted.
عام عرف الدليل_الرئيسي(): نتيجة اختياري نص, فئة_خطأ_نظام {
    دع الاسم: نص = اسم_متغير_الدليل_الرئيسي();
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(صنف_خطأ_نظام(الرمز)); }
    | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        إذا (الطول(القيمة) == 0) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
        أرجع نتيجة.نجح(اختياري.موجود(القيمة));
    };
}

// Changes the process-wide working directory (not available on WASI).
عام عرف غير_دليل_العمل(المسار: &نص): نتيجة عدد, فئة_خطأ_نظام {
    إذا (الطول(*المسار) == 0) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    طابق غير_دليل_العمل_نظام(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فئة_خطأ_حد_نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// The table's entries once a variable was set or removed (none before).
عرف مداخل_جدول_البيئة_إن_وجد(): متجه متجه ط8 {
    إذا (هل_جدول_البيئة_مهيأ()) { أرجع مداخل_جدول_البيئة(); };
    دع لا_شيء: متجه متجه ط8 = [];
    أرجع لا_شيء;
}

// Sets a variable of this process (Rust env::set_var, Go os.Setenv). The
// name must be non-empty and hold no '=' and no NUL, the value no NUL;
// otherwise nothing changes and the error is إدخال_غير_صالح.
عام عرف اضبط_متغير_بيئة(الاسم: &نص, القيمة: &نص): نتيجة عدد, فئة_خطأ_نظام {
    إذا (!اسم_متغير_بيئة_نظام_صالح(الاسم) || !قيمة_متغير_بيئة_نظام_صالحة(القيمة)) {
        أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح());
    };
    دع الاسم_بايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الاسم));
    دع القيمة_بايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(القيمة));
    اضبط_في_جدول_البيئة(&الاسم_بايتات, &القيمة_بايتات);
    أرجع نتيجة.نجح(0);
}

// Removes a variable of this process (Rust env::remove_var, Go
// os.Unsetenv); removing a variable that is not set is not an error.
عام عرف أزل_متغير_بيئة(الاسم: &نص): نتيجة عدد, فئة_خطأ_نظام {
    إذا (!اسم_متغير_بيئة_نظام_صالح(الاسم)) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    دع الاسم_بايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الاسم));
    أزل_من_جدول_البيئة(&الاسم_بايتات);
    أرجع نتيجة.نجح(0);
}

عام نوع environment_entry = مدخل_بيئة;
عام مرادف environment_variables = متغيرات_البيئة;
عام مرادف set_environment_variable = اضبط_متغير_بيئة;
عام مرادف remove_environment_variable = أزل_متغير_بيئة;
عام مرادف home_directory = الدليل_الرئيسي;
عام مرادف set_current_directory = غير_دليل_العمل;
