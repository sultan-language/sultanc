استورد env.system;
استورد env.table;
استورد text.from_bytes;
استورد os.environment;
استورد os.error;

// A program's environment variables, working directory and temporary
// directory (Rust std::env::var, current_dir, temp_dir; Go os.Getenv,
// Getwd, TempDir). Until a variable is set or removed (std.env.variables)
// they are read from the system (std.env.system); afterwards from the table
// std keeps (std.env.table), which the change updated.

عام عرف متغير_بيئة(الاسم: &نص): نتيجة اختياري نص, عدد {
    لو (!هل_جدول_البيئة_مهيأ()) { أرجع متغير_بيئة_النظام(الاسم); };
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(الاسم));
    طابق ابحث_في_جدول_البيئة(&البايتات) مع
    | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(اختياري.موجود(من_بايتات(&القيمة))); }
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
}

عام عرف دليل_العمل(): نتيجة نص, عدد { أرجع دليل_العمل_للنظام(); }

لو (الهدف.المنصة == «windows») {
    // GetTempPathW reads TMP/TEMP from the process environment block, which a
    // change of the table also makes (SetEnvironmentVariableW).
    عام عرف الدليل_المؤقت(): نتيجة نص, عدد { أرجع الدليل_المؤقت_للنظام(); }
} وإلا {
    // TMPDIR as the table holds it once the environment was changed.
    عام عرف الدليل_المؤقت(): نتيجة نص, عدد {
        لو (!هل_جدول_البيئة_مهيأ()) { أرجع الدليل_المؤقت_للنظام(); };
        دع الاسم: متجه ط8 = بايتات_من_نص(«TMPDIR»);
        دع القيمة: متغير اختياري نص = اختياري.لا_شيء();
        طابق ابحث_في_جدول_البيئة(&الاسم) مع
        | اختياري.موجود(البايتات) -> { القيمة := اختياري.موجود(من_بايتات(&البايتات)); }
        | اختياري.لا_شيء -> { };
        طابق اختر_دليل_مؤقت_نظام_من_البيئة(القيمة) مع
        | نتيجة.نجح(المسار) -> { أرجع نتيجة.نجح(المسار); }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); };
    }
}

عام مرادف get_environment_variable = متغير_بيئة;
عام مرادف current_directory = دليل_العمل;
عام مرادف temporary_directory = الدليل_المؤقت;
