استورد text.from_bytes;
استورد fs.error;

استورد os.environment;
استورد os.error;

عرف طول_متغير_داخليا(الاسم: &نص): عدد {
    طابق طول_متغير_بيئة_نظام(الاسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف اقرأ_متغيرا_داخليا(
    الاسم: &نص, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): عدد {
    طابق اقرأ_متغير_بيئة_نظام(الاسم, المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف دليل_العمل_داخليا(المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد): عدد {
    طابق اقرأ_دليل_عمل_النظام(المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف الدليل_المؤقت_داخليا(المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد): عدد {
    طابق اقرأ_دليل_مؤقت_النظام(المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}

عرف مخزن_بيئة(السعة: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) { ألحق(الناتج, 0 مثل غ8); ف := ف + 1; }
    أرجع الناتج;
}

عرف نص_من_مخزن_بيئة(المخزن: &متجه غ8, العدد: غير_موقع): نص {
    دع المصدر: متجه غ8 = *المخزن;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) { ألحق(البايتات, المصدر[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

عام عرف متغير_بيئة(الاسم: &نص): نتيجة اختيار نص, عدد {
    دع الطول_المطلوب: عدد = طول_متغير_داخليا(الاسم);
    لو (الطول_المطلوب < 0) {
        لو (هل_خطأ_غير_موجود(الطول_المطلوب)) { أرجع نتيجة.نجح(اختيار.لا_شيء()); };
        أرجع نتيجة.خطأ(الطول_المطلوب);
    };
    دع السعة: غير_موقع = الطول_المطلوب مثل غير_موقع;
    دع المخزن: متغير متجه غ8 = مخزن_بيئة(السعة);
    دع المقروء: عدد = اقرأ_متغيرا_داخليا(الاسم, &متغير المخزن, 0, الطول_المطلوب);
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    دع النص: نص = نص_من_مخزن_بيئة(&المخزن, المقروء مثل غير_موقع);
    أرجع نتيجة.نجح(اختيار.بعض(النص));
}

عرف اقرأ_مسار_بيئة(مؤقت: منطقي): نتيجة نص, عدد {
    دع المخزن: متغير متجه غ8 = مخزن_بيئة(4096);
    دع المقروء: متغير عدد = 0;
    لو (مؤقت) {
        المقروء := الدليل_المؤقت_داخليا(&متغير المخزن, 0, 4096);
    } وإلا {
        المقروء := دليل_العمل_داخليا(&متغير المخزن, 0, 4096);
    };
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(نص_من_مخزن_بيئة(&المخزن, المقروء مثل غير_موقع));
}

عام عرف دليل_العمل(): نتيجة نص, عدد { أرجع اقرأ_مسار_بيئة(خطأ); }
عام عرف الدليل_المؤقت(): نتيجة نص, عدد { أرجع اقرأ_مسار_بيئة(صواب); }

عام مرادف get_environment_variable = متغير_بيئة;
عام مرادف current_directory = دليل_العمل;
عام مرادف temporary_directory = الدليل_المؤقت;
