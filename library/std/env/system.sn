استورد text.from_bytes;
استورد fs.error;

استورد os.environment;
استورد os.error;

عرف طول_متغير_داخليا(الاسم: &نص): عدد {
    طابق طول_متغير_بيئة_نظام(الاسم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف اقرأ_متغيرا_داخليا(
    الاسم: &نص, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): عدد {
    طابق اقرأ_متغير_بيئة_نظام(الاسم, المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف دليل_العمل_داخليا(المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد): عدد {
    طابق اقرأ_دليل_عمل_النظام(المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}
عرف الدليل_المؤقت_داخليا(المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد): عدد {
    طابق اقرأ_دليل_مؤقت_النظام(المخزن, الإزاحة, المطلوب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(العدد) -> { أرجع العدد; };
}

عرف مخزن_بيئة(السعة: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) { ألحق(الناتج, 0 مثل ط8); ف := ف + 1; }
    أرجع الناتج;
}

عرف نص_من_مخزن_بيئة(المخزن: &متجه ط8, العدد: طبيعي): نص {
    دع المصدر: متجه ط8 = *المخزن;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(البايتات, المصدر[ف]); ف := ف + 1; }
    أرجع من_بايتات(&البايتات);
}

// The environment as the system holds it: on Unix and WASI the vector the
// process started with, on Windows the process environment block. It carries
// no state, so the compiler itself (which the C Stage0 builds) reads its
// environment here; programs read through std.env.environment, which also
// sees the variables a program set or removed (std.env.table).

عام عرف متغير_بيئة_النظام(الاسم: &نص): نتيجة اختياري نص, عدد {
    // The typed "absent" answer is checked before the numeric status: its
    // generic code -2 is not ENOENT under every target's errno table
    // (WASI numbers ENOENT 44 and gives 2 to EACCES).
    طابق طول_متغير_بيئة_نظام(الاسم) مع
    | نتيجة.خطأ(خطأ_حد_نظام.غير_موجود) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
    | _ -> {};
    دع الطول_المطلوب: عدد = طول_متغير_داخليا(الاسم);
    لو (الطول_المطلوب < 0) {
        لو (هل_خطأ_غير_موجود(الطول_المطلوب)) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
        أرجع نتيجة.خطأ(الطول_المطلوب);
    };
    دع السعة: طبيعي = الطول_المطلوب مثل طبيعي;
    دع المخزن: متغير متجه ط8 = مخزن_بيئة(السعة);
    دع المقروء: عدد = اقرأ_متغيرا_داخليا(الاسم, &متغير المخزن, 0, الطول_المطلوب);
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    دع النص: نص = نص_من_مخزن_بيئة(&المخزن, المقروء مثل طبيعي);
    أرجع نتيجة.نجح(اختياري.موجود(النص));
}

عرف اقرأ_مسار_بيئة(مؤقت: منطقي): نتيجة نص, عدد {
    دع المخزن: متغير متجه ط8 = مخزن_بيئة(4096);
    دع المقروء: متغير عدد = 0;
    لو (مؤقت) {
        المقروء := الدليل_المؤقت_داخليا(&متغير المخزن, 0, 4096);
    } وإلا {
        المقروء := دليل_العمل_داخليا(&متغير المخزن, 0, 4096);
    };
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(نص_من_مخزن_بيئة(&المخزن, المقروء مثل طبيعي));
}

عام عرف دليل_العمل_للنظام(): نتيجة نص, عدد { أرجع اقرأ_مسار_بيئة(خطأ); }
عام عرف الدليل_المؤقت_للنظام(): نتيجة نص, عدد { أرجع اقرأ_مسار_بيئة(صواب); }
