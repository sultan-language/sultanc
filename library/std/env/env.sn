// The root file of std.env: the Arabic spellings of its modules
// (docs/en/reference/modules-and-imports.md, "Module spellings"). An import may
// use either name; both name one module.

module environment { ar: بيئة_العمل };
module executable { ar: البرنامج_الحالي };
module system { ar: نظام };
module table { ar: جدول };
module variables { ar: متغيرات };
