استورد text.substring;
استورد text.search;
استورد text.from_bytes;
استورد text.compare;
استورد encoding.utf8;
استورد fs.path;

عام نوع عنوان_موحد = {
    المخطط: نص,
    السلطة: اختيار نص,
    المسار: نص,
    الاستعلام: اختيار نص,
    الشظية: اختيار نص
};

عام نوع خطأ_عنوان_موحد =
    | مخطط_مفقود
    | ترميز_نسبي_غير_صالح بنوع غير_موقع
    | مسار_ملف_غير_مطلق
    | ليس_عنوان_ملف
    | سلطة_ملف_غير_مدعومة
    | يوتيف8_غير_صالح بنوع غير_موقع
;

عرف حرف_مخطط(ب: غ8, الأول: منطقي): منطقي {
    دع أبجدي: متغير منطقي = خطأ;
    لو ((ب >= 0x41) && (ب <= 0x5A)) { أبجدي := صواب; };
    لو ((ب >= 0x61) && (ب <= 0x7A)) { أبجدي := صواب; };
    لو (الأول) { أرجع أبجدي; };
    أرجع أبجدي || ((ب >= 0x30) && (ب <= 0x39)) || (ب == 0x2B) || (ب == 0x2D) || (ب == 0x2E);
}

عام عرف حلل_عنوانا_موحدا(النص: &نص): نتيجة عنوان_موحد, خطأ_عنوان_موحد {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع النقطتان: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو (القيمة[ف] == 0x3A) { لو (ف == 0) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.مخطط_مفقود()); }; النقطتان := اختيار.بعض(ف); ف := العدد; }
        وإلا لو (!حرف_مخطط(القيمة[ف], ف == 0)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.مخطط_مفقود()); }
        وإلا { ف := ف + 1; };
    }
    دع موضع_النقطتين: متغير غير_موقع = 0;
    طابق النقطتان مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.مخطط_مفقود()); }
    | اختيار.بعض(م) -> { موضع_النقطتين := م; };
    دع المخطط: متغير نص = «»;
    طابق مقطع_نص(&القيمة, 0, موضع_النقطتين) مع | اختيار.بعض(س) -> { المخطط := س; } | _ -> { };
    دع الموضع: متغير غير_موقع = موضع_النقطتين + 1;
    دع السلطة: متغير اختيار نص = اختيار.لا_شيء();
    دع الموضع_التالي: غير_موقع = الموضع + 1;
    لو ((الموضع_التالي < العدد) && (القيمة[الموضع] == 0x2F) && (القيمة[الموضع_التالي] == 0x2F)) {
        الموضع := الموضع + 2;
        دع بداية: غير_موقع = الموضع;
        بينما ((الموضع < العدد) && (القيمة[الموضع] != 0x2F) && (القيمة[الموضع] != 0x3F) && (القيمة[الموضع] != 0x23)) { الموضع := الموضع + 1; }
        طابق مقطع_نص(&القيمة, بداية, الموضع - بداية) مع | اختيار.بعض(س) -> { السلطة := اختيار.بعض(س); } | _ -> { };
    };
    دع بداية_المسار: غير_موقع = الموضع;
    بينما ((الموضع < العدد) && (القيمة[الموضع] != 0x3F) && (القيمة[الموضع] != 0x23)) { الموضع := الموضع + 1; }
    دع المسار: متغير نص = «»;
    طابق مقطع_نص(&القيمة, بداية_المسار, الموضع - بداية_المسار) مع | اختيار.بعض(س) -> { المسار := س; } | _ -> { };
    دع الاستعلام: متغير اختيار نص = اختيار.لا_شيء();
    لو ((الموضع < العدد) && (القيمة[الموضع] == 0x3F)) {
        الموضع := الموضع + 1;
        دع البداية: غير_موقع = الموضع;
        بينما ((الموضع < العدد) && (القيمة[الموضع] != 0x23)) { الموضع := الموضع + 1; }
        طابق مقطع_نص(&القيمة, البداية, الموضع - البداية) مع | اختيار.بعض(س) -> { الاستعلام := اختيار.بعض(س); } | _ -> { };
    };
    دع الشظية: متغير اختيار نص = اختيار.لا_شيء();
    لو ((الموضع < العدد) && (القيمة[الموضع] == 0x23)) {
        الموضع := الموضع + 1;
        طابق مقطع_نص(&القيمة, الموضع, العدد - الموضع) مع | اختيار.بعض(س) -> { الشظية := اختيار.بعض(س); } | _ -> { };
    };
    دع الناتج: عنوان_موحد = { المخطط: المخطط, السلطة: السلطة, المسار: المسار, الاستعلام: الاستعلام, الشظية: الشظية };
    أرجع نتيجة.نجح(الناتج);
}

عرف غير_محجوز_في_عنوان(ب: غ8): منطقي {
    أرجع ((ب >= 0x41) && (ب <= 0x5A)) || ((ب >= 0x61) && (ب <= 0x7A)) || ((ب >= 0x30) && (ب <= 0x39)) || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5F) || (ب == 0x7E);
}

عرف سداسي_عنوان(القيمة: غ8): غ8 { لو (القيمة < 10) { أرجع 0x30 + القيمة; }; أرجع 0x41 + (القيمة - 10); }

عرف رمز_نسبيا_بخيار(النص: &نص, احفظ_شرطة: منطقي): نص {
    دع القيمة: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ب: غ8 = القيمة[ف];
        لو (غير_محجوز_في_عنوان(ب) || (احفظ_شرطة && (ب == 0x2F))) { ألحق(الناتج, ب); }
        وإلا { ألحق(الناتج, 0x25); ألحق(الناتج, سداسي_عنوان((ب >> 4) & 0x0F)); ألحق(الناتج, سداسي_عنوان(ب & 0x0F)); };
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف رمز_نسبيا(النص: &نص): نص {
    أرجع رمز_نسبيا_بخيار(النص, خطأ);
}

عام عرف رمز_مسار_نسبيا(النص: &نص): نص {
    أرجع رمز_نسبيا_بخيار(النص, صواب);
}

عرف رقم_سداسي_عنوان(ب: غ8): اختيار غ8 {
    لو ((ب >= 0x30) && (ب <= 0x39)) { أرجع اختيار.بعض(ب - 0x30); };
    لو ((ب >= 0x41) && (ب <= 0x46)) { أرجع اختيار.بعض((ب - 0x41) + 10); };
    لو ((ب >= 0x61) && (ب <= 0x66)) { أرجع اختيار.بعض((ب - 0x61) + 10); };
    أرجع اختيار.لا_شيء();
}

عام عرف فك_الترميز_النسبي(النص: &نص): نتيجة نص, خطأ_عنوان_موحد {
    دع القيمة: نص = *النص;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    بينما (ف < العدد) {
        لو (القيمة[ف] != 0x25) { ألحق(الناتج, القيمة[ف]); ف := ف + 1; }
        وإلا {
            لو ((ف + 2) >= العدد) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.ترميز_نسبي_غير_صالح(ف)); };
            دع أعلى: متغير غ8 = 0; دع أدنى: متغير غ8 = 0;
            دع موضع_الرقم_الأعلى: غير_موقع = ف + 1;
            طابق رقم_سداسي_عنوان(القيمة[موضع_الرقم_الأعلى]) مع | اختيار.بعض(ر) -> { أعلى := ر; } | _ -> { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.ترميز_نسبي_غير_صالح(ف)); };
            دع موضع_الرقم_الأدنى: غير_موقع = ف + 2;
            طابق رقم_سداسي_عنوان(القيمة[موضع_الرقم_الأدنى]) مع | اختيار.بعض(ر) -> { أدنى := ر; } | _ -> { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.ترميز_نسبي_غير_صالح(ف)); };
            ألحق(الناتج, (أعلى << 4) | أدنى); ف := ف + 3;
        };
    }
    دع موضع: متغير غير_موقع = 0;
    بينما (موضع < (الطول(الناتج) مثل غير_موقع)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8_من_بايتات(&الناتج, موضع);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.يوتيف8_غير_صالح(موضع)); };
        موضع := موضع + المفكوك.العرض;
    }
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}

عام عرف مسار_إلى_عنوان_ملف(المسار: &نص): نتيجة نص, خطأ_عنوان_موحد {
    لو (!مسار_مطلق(المسار)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.مسار_ملف_غير_مطلق()); };
    دع المطبع: نص = طبع_المسار(المسار);
    دع المرَمّز: نص = رمز_مسار_نسبيا(&المطبع);
    دع الناتج: متغير متجه غ8 = [0x66,0x69,0x6C,0x65,0x3A,0x2F,0x2F];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المرَمّز) مثل غير_موقع)) { ألحق(الناتج, المرَمّز[ف]); ف := ف + 1; }
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}


عرف بايت_أسكي_صغير_لعنوان(البايت: غ8): غ8 {
    لو ((البايت >= 0x41) && (البايت <= 0x5A)) { أرجع البايت + 0x20; };
    أرجع البايت;
}

عرف نص_أسكي_يساوي_دون_حالة_لعنوان(الأول: &نص, الثاني: &نص): منطقي {
    دع أ: نص = *الأول;
    دع ب: نص = *الثاني;
    لو (الطول(أ) != الطول(ب)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ) مثل غير_موقع)) {
        لو (بايت_أسكي_صغير_لعنوان(أ[ف]) != بايت_أسكي_صغير_لعنوان(ب[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف مخطط_ملف(المخطط: &نص): منطقي {
    دع القيمة: نص = *المخطط;
    لو (الطول(القيمة) != 4) { أرجع خطأ; };
    دع ف0: غ8 = القيمة[0] | 0x20;
    دع ف1: غ8 = القيمة[1] | 0x20;
    دع ف2: غ8 = القيمة[2] | 0x20;
    دع ف3: غ8 = القيمة[3] | 0x20;
    أرجع (ف0 == 0x66) && (ف1 == 0x69) && (ف2 == 0x6C) && (ف3 == 0x65);
}

عام عرف عنوان_ملف_إلى_مسار(النص: &نص): نتيجة نص, خطأ_عنوان_موحد {
    طابق حلل_عنوانا_موحدا(النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العنوان) -> {
        لو (!مخطط_ملف(&العنوان.المخطط)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.ليس_عنوان_ملف()); };
        طابق العنوان.السلطة مع
        | اختيار.بعض(السلطة) -> {
            دع محلي: نص = «localhost»;
            لو ((الطول(السلطة) > 0) && !نص_أسكي_يساوي_دون_حالة_لعنوان(&السلطة, &محلي)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.سلطة_ملف_غير_مدعومة()); };
        }
        | اختيار.لا_شيء -> { };
        طابق فك_الترميز_النسبي(&العنوان.المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المسار) -> { لو (!مسار_مطلق(&المسار)) { أرجع نتيجة.خطأ(خطأ_عنوان_موحد.مسار_ملف_غير_مطلق()); }; أرجع نتيجة.نجح(المسار); };
    };
}

عام مرادف uri = عنوان_موحد;
عام مرادف uri_error = خطأ_عنوان_موحد;
عام مرادف parse_uri = حلل_عنوانا_موحدا;
عام مرادف percent_encode = رمز_نسبيا;
عام مرادف percent_encode_path = رمز_مسار_نسبيا;
عام مرادف percent_decode = فك_الترميز_النسبي;
عام مرادف file_path_to_uri = مسار_إلى_عنوان_ملف;
عام مرادف file_uri_to_path = عنوان_ملف_إلى_مسار;
عام مرادف uri_error.missing_scheme = خطأ_عنوان_موحد.مخطط_مفقود;
عام مرادف uri_error.invalid_percent_encoding = خطأ_عنوان_موحد.ترميز_نسبي_غير_صالح;
عام مرادف uri_error.relative_file_path = خطأ_عنوان_موحد.مسار_ملف_غير_مطلق;
عام مرادف uri_error.not_file_uri = خطأ_عنوان_موحد.ليس_عنوان_ملف;
عام مرادف uri_error.unsupported_file_authority = خطأ_عنوان_موحد.سلطة_ملف_غير_مدعومة;
عام مرادف uri_error.invalid_utf8 = خطأ_عنوان_موحد.يوتيف8_غير_صالح;

// Generic URI query helpers. Unlike form-urlencoded parsing, '+' remains a
// literal plus here; application/x-www-form-urlencoded semantics live in HTTP.
عام نوع زوج_استعلام_عنوان = {
    الاسم: نص,
    القيمة: نص,
    له_قيمة: منطقي
};

عرف انسخ_نص_عنوان(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف أضف_نص_إلى_بايتات_عنوان(الناتج: &متغير متجه غ8, القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(*الناتج, النص[ف]);
        ف := ف + 1;
    }
}

عام عرف سلسل_عنوانا_موحدا(العنوان: &عنوان_موحد): نص {
    دع القيمة: عنوان_موحد = *العنوان;
    دع الناتج: متغير متجه غ8 = [];
    أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &القيمة.المخطط);
    ألحق(الناتج, 0x3A);
    طابق القيمة.السلطة مع
    | اختيار.بعض(السلطة) -> {
        ألحق(الناتج, 0x2F);
        ألحق(الناتج, 0x2F);
        أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &السلطة);
    }
    | اختيار.لا_شيء -> { };
    أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &القيمة.المسار);
    طابق القيمة.الاستعلام مع
    | اختيار.بعض(الاستعلام) -> {
        ألحق(الناتج, 0x3F);
        أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &الاستعلام);
    }
    | اختيار.لا_شيء -> { };
    طابق القيمة.الشظية مع
    | اختيار.بعض(الشظية) -> {
        ألحق(الناتج, 0x23);
        أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &الشظية);
    }
    | اختيار.لا_شيء -> { };
    أرجع من_بايتات(&الناتج);
}

عام عرف حلل_استعلام_عنوان(الاستعلام: &نص): نتيجة متجه زوج_استعلام_عنوان, خطأ_عنوان_موحد {
    دع النص: نص = *الاستعلام;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع الناتج: متغير متجه زوج_استعلام_عنوان = [];
    لو (العدد == 0) { أرجع نتيجة.نجح(الناتج); };
    دع البداية: متغير غير_موقع = 0;
    بينما (البداية <= العدد) {
        دع النهاية: متغير غير_موقع = البداية;
        بينما ((النهاية < العدد) && (النص[النهاية] != 0x26)) { النهاية := النهاية + 1; }
        دع يساوي: متغير غير_موقع = النهاية;
        دع ف: متغير غير_موقع = البداية;
        بينما ((ف < النهاية) && (يساوي == النهاية)) {
            لو (النص[ف] == 0x3D) { يساوي := ف; };
            ف := ف + 1;
        }
        دع اسم_مرمز: متغير نص = «»;
        طابق مقطع_نص(&النص, البداية, يساوي - البداية) مع
        | اختيار.بعض(قيمة) -> { اسم_مرمز := قيمة; }
        | اختيار.لا_شيء -> { };
        دع قيمة_مرمزة: متغير نص = «»;
        دع له_قيمة: منطقي = يساوي < النهاية;
        لو (له_قيمة) {
            دع بداية_القيمة: غير_موقع = يساوي + 1;
            طابق مقطع_نص(&النص, بداية_القيمة, النهاية - بداية_القيمة) مع
            | اختيار.بعض(قيمة) -> { قيمة_مرمزة := قيمة; }
            | اختيار.لا_شيء -> { };
        };
        دع الاسم: متغير نص = «»;
        طابق فك_الترميز_النسبي(&اسم_مرمز) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة) -> { الاسم := قيمة; };
        دع القيمة: متغير نص = «»;
        لو (له_قيمة) {
            طابق فك_الترميز_النسبي(&قيمة_مرمزة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(قيمة_مفكوكة) -> { القيمة := قيمة_مفكوكة; };
        };
        دع الزوج: زوج_استعلام_عنوان = { الاسم: الاسم, القيمة: القيمة, له_قيمة: له_قيمة };
        ألحق(الناتج, الزوج);
        لو (النهاية >= العدد) { البداية := العدد + 1; } وإلا { البداية := النهاية + 1; };
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف ابن_استعلام_عنوان(الأزواج: &متجه زوج_استعلام_عنوان): نص {
    دع القيم: متجه زوج_استعلام_عنوان = *الأزواج;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (ف > 0) { ألحق(الناتج, 0x26); };
        دع الاسم: نص = رمز_نسبيا(&القيم[ف].الاسم);
        أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &الاسم);
        لو (القيم[ف].له_قيمة) {
            ألحق(الناتج, 0x3D);
            دع القيمة: نص = رمز_نسبيا(&القيم[ف].القيمة);
            أضف_نص_إلى_بايتات_عنوان(&متغير الناتج, &القيمة);
        };
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف عدد_أزواج_استعلام_عنوان(الأزواج: &متجه زوج_استعلام_عنوان): غير_موقع {
    دع القيم: متجه زوج_استعلام_عنوان = *الأزواج;
    أرجع الطول(القيم) مثل غير_موقع;
}

عام عرف أول_قيمة_استعلام_عنوان(الأزواج: &متجه زوج_استعلام_عنوان, الاسم: &نص): اختيار نص {
    دع القيم: متجه زوج_استعلام_عنوان = *الأزواج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&القيم[ف].الاسم, الاسم) && القيم[ف].له_قيمة) {
            أرجع اختيار.بعض(انسخ_نص_عنوان(&القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام نوع uri_query_pair = زوج_استعلام_عنوان;
عام مرادف uri_to_text = سلسل_عنوانا_موحدا;
عام مرادف parse_uri_query = حلل_استعلام_عنوان;
عام مرادف build_uri_query = ابن_استعلام_عنوان;
عام مرادف uri_query_pair_count = عدد_أزواج_استعلام_عنوان;
عام مرادف uri_query_first_value = أول_قيمة_استعلام_عنوان;
