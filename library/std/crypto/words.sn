// Fixed-width word and byte helpers shared by std crypto.
//
// SultanC integer arithmetic traps on overflow and has no wrapping operators,
// so modular 32-bit and 64-bit word arithmetic is computed explicitly inside
// the range of غير_موقع (64-bit unsigned). Words of 32 bits are kept below
// 2^32; left shifts are always applied to values whose shifted bits fit.
// None of these helpers branches on its data.

عام عرف جمع32_تشفير(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    أرجع (أ + ب) & 0xFFFFFFFF;
}

// The amount is 1..31; the word is below 2^32.
عام عرف دور_يسار32_تشفير(الكلمة: غير_موقع, المقدار: غير_موقع): غير_موقع {
    دع يسار: غير_موقع = (الكلمة << المقدار) & 0xFFFFFFFF;
    دع يمين: غير_موقع = الكلمة >> (32 - المقدار);
    أرجع يسار | يمين;
}

عام عرف دور_يمين32_تشفير(الكلمة: غير_موقع, المقدار: غير_موقع): غير_موقع {
    دع يمين: غير_موقع = الكلمة >> المقدار;
    دع يسار: غير_موقع = (الكلمة << (32 - المقدار)) & 0xFFFFFFFF;
    أرجع يسار | يمين;
}

عام عرف جمع64_تشفير(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    دع منخفض: غير_موقع = (أ & 0xFFFFFFFF) + (ب & 0xFFFFFFFF);
    دع مرتفع: غير_موقع = (أ >> 32) + (ب >> 32) + (منخفض >> 32);
    أرجع ((مرتفع & 0xFFFFFFFF) << 32) | (منخفض & 0xFFFFFFFF);
}

// The amount is 1..63.
عام عرف دور_يمين64_تشفير(الكلمة: غير_موقع, المقدار: غير_موقع): غير_موقع {
    دع قناع_منخفض: غير_موقع = (1 << المقدار) - 1;
    دع يسار: غير_موقع = (الكلمة & قناع_منخفض) << (64 - المقدار);
    أرجع (الكلمة >> المقدار) | يسار;
}

// 0 for a zero word below 2^32, otherwise 1, without a branch.
عام عرف ليس_صفرا32_تشفير(الكلمة: غير_موقع): غير_موقع {
    أرجع (الكلمة + 0xFFFFFFFF) >> 32;
}

// Selects أ when الشرط is 1 and ب when it is 0, for words below 2^32.
عام عرف اختر32_تشفير(الشرط: غير_موقع, أ: غير_موقع, ب: غير_موقع): غير_موقع {
    دع القناع: غير_موقع = الشرط * 0xFFFFFFFF;
    أرجع (أ & القناع) | (ب & (القناع ^ 0xFFFFFFFF));
}

عام عرف اقرأ_كبير16_تشفير(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع أ: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب: غير_موقع = (*البايتات)[الموضع + 1] مثل غير_موقع;
    أرجع (أ << 8) | ب;
}

عام عرف اقرأ_كبير24_تشفير(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع أ: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب: غير_موقع = (*البايتات)[الموضع + 1] مثل غير_موقع;
    دع ج: غير_موقع = (*البايتات)[الموضع + 2] مثل غير_موقع;
    أرجع (أ << 16) | (ب << 8) | ج;
}

عام عرف اقرأ_كبير32_تشفير(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع أ: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب: غير_موقع = (*البايتات)[الموضع + 1] مثل غير_موقع;
    دع ج: غير_موقع = (*البايتات)[الموضع + 2] مثل غير_موقع;
    دع د: غير_موقع = (*البايتات)[الموضع + 3] مثل غير_موقع;
    أرجع (أ << 24) | (ب << 16) | (ج << 8) | د;
}

عام عرف اقرأ_صغير32_تشفير(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع أ: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
    دع ب: غير_موقع = (*البايتات)[الموضع + 1] مثل غير_موقع;
    دع ج: غير_موقع = (*البايتات)[الموضع + 2] مثل غير_موقع;
    دع د: غير_موقع = (*البايتات)[الموضع + 3] مثل غير_موقع;
    أرجع (د << 24) | (ج << 16) | (ب << 8) | أ;
}

عام عرف اقرأ_كبير64_تشفير(البايتات: &متجه غ8, الموضع: غير_موقع): غير_موقع {
    دع مرتفع: غير_موقع = اقرأ_كبير32_تشفير(البايتات, الموضع);
    دع منخفض: غير_موقع = اقرأ_كبير32_تشفير(البايتات, الموضع + 4);
    أرجع (مرتفع << 32) | منخفض;
}

عام عرف ألحق_كبير16_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل غ8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل غ8);
}

عام عرف ألحق_كبير24_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل غ8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل غ8);
}

عام عرف ألحق_كبير32_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*الهدف, ((القيمة >> 24) & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل غ8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل غ8);
}

عام عرف ألحق_صغير32_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق(*الهدف, (القيمة & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل غ8);
    ألحق(*الهدف, ((القيمة >> 24) & 0xFF) مثل غ8);
}

عام عرف ألحق_كبير64_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق_كبير32_تشفير(الهدف, القيمة >> 32);
    ألحق_كبير32_تشفير(الهدف, القيمة & 0xFFFFFFFF);
}

عام عرف ألحق_صغير64_تشفير(الهدف: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    ألحق_صغير32_تشفير(الهدف, القيمة & 0xFFFFFFFF);
    ألحق_صغير32_تشفير(الهدف, القيمة >> 32);
}

عام عرف ألحق_بايتات_تشفير(الهدف: &متغير متجه غ8, المصدر: &متجه غ8): فراغ {
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        ألحق(*الهدف, (*المصدر)[ف]);
        ف := ف + 1;
    }
}

// Copies a range the caller has already checked to lie inside المصدر.
عام عرف شريحة_بايتات_تشفير(المصدر: &متجه غ8, البداية: غير_موقع, العدد: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, (*المصدر)[البداية + ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أصفار_تشفير(العدد: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, 0 مثل غ8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف بايتات_متصلة_تشفير(أ: &متجه غ8, ب: &متجه غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    ألحق_بايتات_تشفير(&متغير الناتج, أ);
    ألحق_بايتات_تشفير(&متغير الناتج, ب);
    أرجع الناتج;
}

// Overwrites key material that is no longer needed.
عام عرف امسح_بايتات_تشفير(المخزن: &متغير متجه غ8): فراغ {
    دع الحجم: غير_موقع = الطول(*المخزن) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        (*المخزن)[ف] := 0;
        ف := ف + 1;
    }
}

// Constant-time equality for secret values of public length. This is the
// single std implementation; std.bytes owns variable-time equality.
عام عرف بايتات_متساوية_بزمن_ثابت_تشفير(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع الحجم: غير_موقع = الطول(*أ) مثل غير_موقع;
    لو (الحجم != (الطول(*ب) مثل غير_موقع)) { أرجع خطأ; };
    دع الفرق: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        الفرق := الفرق | (((*أ)[ف] مثل غير_موقع) ^ ((*ب)[ف] مثل غير_موقع));
        ف := ف + 1;
    }
    أرجع الفرق == 0;
}
