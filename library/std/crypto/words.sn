// Fixed-width word and byte helpers shared by std crypto.
//
// SultanC integer arithmetic traps on overflow and has no wrapping operators,
// so modular 32-bit and 64-bit word arithmetic is computed explicitly inside
// the range of طبيعي (64-bit unsigned). Words of 32 bits are kept below
// 2^32; left shifts are always applied to values whose shifted bits fit.
// None of these helpers branches on its data.

عام عرف جمع32_تشفير(أ: طبيعي, ب: طبيعي): طبيعي {
    أرجع (أ + ب) & 0xFFFFFFFF;
}

// The amount is 1..31; the word is below 2^32.
عام عرف دور_يسار32_تشفير(الكلمة: طبيعي, المقدار: طبيعي): طبيعي {
    دع يسار: طبيعي = (الكلمة << المقدار) & 0xFFFFFFFF;
    دع يمين: طبيعي = الكلمة >> (32 - المقدار);
    أرجع يسار | يمين;
}

عام عرف دور_يمين32_تشفير(الكلمة: طبيعي, المقدار: طبيعي): طبيعي {
    دع يمين: طبيعي = الكلمة >> المقدار;
    دع يسار: طبيعي = (الكلمة << (32 - المقدار)) & 0xFFFFFFFF;
    أرجع يسار | يمين;
}

// 64-bit word arithmetic is in std.crypto.words64 (the compiler's wrapping
// intrinsics, which the C Stage0 building the compiler does not know).

// 0 for a zero word below 2^32, otherwise 1, without a branch.
عام عرف ليس_صفرا32_تشفير(الكلمة: طبيعي): طبيعي {
    أرجع (الكلمة + 0xFFFFFFFF) >> 32;
}

// Selects أ when الشرط is 1 and ب when it is 0, for words below 2^32.
عام عرف اختر32_تشفير(الشرط: طبيعي, أ: طبيعي, ب: طبيعي): طبيعي {
    دع القناع: طبيعي = الشرط * 0xFFFFFFFF;
    أرجع (أ & القناع) | (ب & (القناع ^ 0xFFFFFFFF));
}

عام عرف اقرأ_كبير16_تشفير(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع أ: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع ب: طبيعي = (*البايتات)[الموضع + 1] مثل طبيعي;
    أرجع (أ << 8) | ب;
}

عام عرف اقرأ_كبير24_تشفير(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع أ: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع ب: طبيعي = (*البايتات)[الموضع + 1] مثل طبيعي;
    دع ج: طبيعي = (*البايتات)[الموضع + 2] مثل طبيعي;
    أرجع (أ << 16) | (ب << 8) | ج;
}

عام عرف اقرأ_كبير32_تشفير(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع أ: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع ب: طبيعي = (*البايتات)[الموضع + 1] مثل طبيعي;
    دع ج: طبيعي = (*البايتات)[الموضع + 2] مثل طبيعي;
    دع د: طبيعي = (*البايتات)[الموضع + 3] مثل طبيعي;
    أرجع (أ << 24) | (ب << 16) | (ج << 8) | د;
}

عام عرف اقرأ_صغير32_تشفير(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع أ: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
    دع ب: طبيعي = (*البايتات)[الموضع + 1] مثل طبيعي;
    دع ج: طبيعي = (*البايتات)[الموضع + 2] مثل طبيعي;
    دع د: طبيعي = (*البايتات)[الموضع + 3] مثل طبيعي;
    أرجع (د << 24) | (ج << 16) | (ب << 8) | أ;
}

عام عرف اقرأ_كبير64_تشفير(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    دع مرتفع: طبيعي = اقرأ_كبير32_تشفير(البايتات, الموضع);
    دع منخفض: طبيعي = اقرأ_كبير32_تشفير(البايتات, الموضع + 4);
    أرجع (مرتفع << 32) | منخفض;
}

عام عرف ألحق_كبير16_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل ط8);
}

عام عرف ألحق_كبير24_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل ط8);
}

عام عرف ألحق_كبير32_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*الهدف, ((القيمة >> 24) & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الهدف, (القيمة & 0xFF) مثل ط8);
}

عام عرف ألحق_صغير32_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*الهدف, (القيمة & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 16) & 0xFF) مثل ط8);
    ألحق(*الهدف, ((القيمة >> 24) & 0xFF) مثل ط8);
}

عام عرف ألحق_كبير64_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق_كبير32_تشفير(الهدف, القيمة >> 32);
    ألحق_كبير32_تشفير(الهدف, القيمة & 0xFFFFFFFF);
}

عام عرف ألحق_صغير64_تشفير(الهدف: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق_صغير32_تشفير(الهدف, القيمة & 0xFFFFFFFF);
    ألحق_صغير32_تشفير(الهدف, القيمة >> 32);
}

عام عرف ألحق_بايتات_تشفير(الهدف: &متغير متجه ط8, المصدر: &متجه ط8): فراغ {
    دع الحجم: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        ألحق(*الهدف, (*المصدر)[ف]);
        ف := ف + 1;
    }
}

// Copies a range the caller has already checked to lie inside المصدر.
عام عرف شريحة_بايتات_تشفير(المصدر: &متجه ط8, البداية: طبيعي, العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, (*المصدر)[البداية + ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف أصفار_تشفير(العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, 0 مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف بايتات_متصلة_تشفير(أ: &متجه ط8, ب: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_بايتات_تشفير(&متغير الناتج, أ);
    ألحق_بايتات_تشفير(&متغير الناتج, ب);
    أرجع الناتج;
}

// Overwrites key material that is no longer needed.
عام عرف امسح_بايتات_تشفير(المخزن: &متغير متجه ط8): فراغ {
    دع الحجم: طبيعي = الطول(*المخزن) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        (*المخزن)[ف] := 0;
        ف := ف + 1;
    }
}

// Constant-time equality for secret values of public length. This is the
// single std implementation; std.bytes owns variable-time equality.
عام عرف بايتات_متساوية_بزمن_ثابت_تشفير(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    دع الحجم: طبيعي = الطول(*أ) مثل طبيعي;
    إذا (الحجم != (الطول(*ب) مثل طبيعي)) { أرجع خطأ; };
    دع الفرق: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        الفرق := الفرق | (((*أ)[ف] مثل طبيعي) ^ ((*ب)[ف] مثل طبيعي));
        ف := ف + 1;
    }
    أرجع الفرق == 0;
}
