// SHA-1 (FIPS 180-4, section 6.1). SHA-1 is broken for collision resistance:
// std uses it only to decode legacy PKCS#12 containers (PBE key derivation and
// MAC). TLS and certificate verification in std reject SHA-1 signatures.

استورد crypto.words;

عرف اضغط_كتلة_شا1(الحالة: &متغير متجه طبيعي, الرسالة: &متجه ط8, البداية: طبيعي): فراغ {
    دع و: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        ألحق(و, اقرأ_كبير32_تشفير(الرسالة, البداية + ف * 4));
        ف := ف + 1;
    }
    طالما (ف < 80) {
        دع مزيج: طبيعي = و[ف - 3] ^ و[ف - 8] ^ و[ف - 14] ^ و[ف - 16];
        ألحق(و, دور_يسار32_تشفير(مزيج, 1));
        ف := ف + 1;
    }
    دع أ: متغير طبيعي = (*الحالة)[0];
    دع ب: متغير طبيعي = (*الحالة)[1];
    دع ج: متغير طبيعي = (*الحالة)[2];
    دع د: متغير طبيعي = (*الحالة)[3];
    دع هاء: متغير طبيعي = (*الحالة)[4];
    ف := 0;
    طالما (ف < 80) {
        دع الدالة: متغير طبيعي = 0;
        دع الثابت: متغير طبيعي = 0;
        إذا (ف < 20) {
            الدالة := (ب & ج) | ((ب ^ 0xFFFFFFFF) & د);
            الثابت := 0x5A827999;
        } وإلا إذا (ف < 40) {
            الدالة := ب ^ ج ^ د;
            الثابت := 0x6ED9EBA1;
        } وإلا إذا (ف < 60) {
            الدالة := (ب & ج) | (ب & د) | (ج & د);
            الثابت := 0x8F1BBCDC;
        } وإلا {
            الدالة := ب ^ ج ^ د;
            الثابت := 0xCA62C1D6;
        };
        دع مؤقت: طبيعي = جمع32_تشفير(جمع32_تشفير(جمع32_تشفير(جمع32_تشفير(دور_يسار32_تشفير(أ, 5), الدالة), هاء), الثابت), و[ف]);
        هاء := د;
        د := ج;
        ج := دور_يسار32_تشفير(ب, 30);
        ب := أ;
        أ := مؤقت;
        ف := ف + 1;
    }
    (*الحالة)[0] := جمع32_تشفير((*الحالة)[0], أ);
    (*الحالة)[1] := جمع32_تشفير((*الحالة)[1], ب);
    (*الحالة)[2] := جمع32_تشفير((*الحالة)[2], ج);
    (*الحالة)[3] := جمع32_تشفير((*الحالة)[3], د);
    (*الحالة)[4] := جمع32_تشفير((*الحالة)[4], هاء);
}

عام عرف شا1(المصدر: &متجه ط8): متجه ط8 {
    دع الحجم: طبيعي = الطول(*المصدر) مثل طبيعي;
    دع م: متغير متجه ط8 = [];
    ألحق_بايتات_تشفير(&متغير م, المصدر);
    ألحق(م, 0x80 مثل ط8);
    طالما (((الطول(م) مثل طبيعي) % 64) != 56) { ألحق(م, 0 مثل ط8); }
    ألحق_كبير64_تشفير(&متغير م, الحجم * 8);
    دع الحالة: متغير متجه طبيعي = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0];
    دع الكتلة: متغير طبيعي = 0;
    دع الكلي: طبيعي = الطول(م) مثل طبيعي;
    طالما (الكتلة < الكلي) {
        اضغط_كتلة_شا1(&متغير الحالة, &م, الكتلة);
        الكتلة := الكتلة + 64;
    }
    دع الخرج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) {
        ألحق_كبير32_تشفير(&متغير الخرج, الحالة[ف]);
        ف := ف + 1;
    }
    أرجع الخرج;
}

عام مرادف sha1 = شا1;
