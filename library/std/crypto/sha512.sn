// SHA-512 and SHA-384 (FIPS 180-4, section 6.4) and their HMACs (RFC 2104).
// 64-bit word arithmetic is modular through crypto.words because SultanC
// arithmetic traps on overflow.

استورد crypto.words;

عرف ثوابت_شا512(): متجه غير_موقع {
    دع الثوابت: متجه غير_موقع = [
        0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC,
        0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118,
        0xD807AA98A3030242, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2,
        0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694,
        0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65,
        0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5,
        0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4,
        0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x06CA6351E003826F, 0x142929670A0E6E70,
        0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF,
        0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B,
        0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30,
        0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8,
        0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8,
        0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3,
        0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC,
        0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B,
        0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178,
        0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B,
        0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C,
        0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817
    ];
    أرجع الثوابت;
}

// Compresses the 128-byte block at البداية into الحالة.
عرف اضغط_كتلة_شا512(
    الحالة: &متغير متجه غير_موقع,
    الرسالة: &متجه غ8,
    البداية: غير_موقع,
    الثوابت: &متجه غير_موقع
): فراغ {
    دع و: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        ألحق(و, اقرأ_كبير64_تشفير(الرسالة, البداية + ف * 8));
        ف := ف + 1;
    }
    بينما (ف < 80) {
        دع س15: غير_موقع = و[ف - 15];
        دع س2: غير_موقع = و[ف - 2];
        دع ص0: غير_موقع = دور_يمين64_تشفير(س15, 1) ^ دور_يمين64_تشفير(س15, 8) ^ (س15 >> 7);
        دع ص1: غير_موقع = دور_يمين64_تشفير(س2, 19) ^ دور_يمين64_تشفير(س2, 61) ^ (س2 >> 6);
        دع مجموع: غير_موقع = جمع64_تشفير(جمع64_تشفير(جمع64_تشفير(و[ف - 16], ص0), و[ف - 7]), ص1);
        ألحق(و, مجموع);
        ف := ف + 1;
    }

    دع أ: متغير غير_موقع = (*الحالة)[0];
    دع ب: متغير غير_موقع = (*الحالة)[1];
    دع ج: متغير غير_موقع = (*الحالة)[2];
    دع د: متغير غير_موقع = (*الحالة)[3];
    دع هاء: متغير غير_موقع = (*الحالة)[4];
    دع و5: متغير غير_موقع = (*الحالة)[5];
    دع ز: متغير غير_موقع = (*الحالة)[6];
    دع ح: متغير غير_موقع = (*الحالة)[7];
    ف := 0;
    بينما (ف < 80) {
        دع كبير1: غير_موقع = دور_يمين64_تشفير(هاء, 14) ^ دور_يمين64_تشفير(هاء, 18) ^ دور_يمين64_تشفير(هاء, 41);
        دع اختيار_هاء: غير_موقع = (هاء & و5) ^ ((~هاء) & ز);
        دع مؤقت1: غير_موقع = جمع64_تشفير(جمع64_تشفير(جمع64_تشفير(جمع64_تشفير(ح, كبير1), اختيار_هاء), (*الثوابت)[ف]), و[ف]);
        دع كبير0: غير_موقع = دور_يمين64_تشفير(أ, 28) ^ دور_يمين64_تشفير(أ, 34) ^ دور_يمين64_تشفير(أ, 39);
        دع غالبية: غير_موقع = (أ & ب) ^ (أ & ج) ^ (ب & ج);
        دع مؤقت2: غير_موقع = جمع64_تشفير(كبير0, غالبية);
        ح := ز;
        ز := و5;
        و5 := هاء;
        هاء := جمع64_تشفير(د, مؤقت1);
        د := ج;
        ج := ب;
        ب := أ;
        أ := جمع64_تشفير(مؤقت1, مؤقت2);
        ف := ف + 1;
    }
    (*الحالة)[0] := جمع64_تشفير((*الحالة)[0], أ);
    (*الحالة)[1] := جمع64_تشفير((*الحالة)[1], ب);
    (*الحالة)[2] := جمع64_تشفير((*الحالة)[2], ج);
    (*الحالة)[3] := جمع64_تشفير((*الحالة)[3], د);
    (*الحالة)[4] := جمع64_تشفير((*الحالة)[4], هاء);
    (*الحالة)[5] := جمع64_تشفير((*الحالة)[5], و5);
    (*الحالة)[6] := جمع64_تشفير((*الحالة)[6], ز);
    (*الحالة)[7] := جمع64_تشفير((*الحالة)[7], ح);
}

// Pads, compresses and emits the first عدد_الكلمات state words.
عرف شا512_بحالة(المصدر: &متجه غ8, الحالة_الأولى: متجه غير_موقع, عدد_الكلمات: غير_موقع): متجه غ8 {
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    دع م: متغير متجه غ8 = [];
    ألحق_بايتات_تشفير(&متغير م, المصدر);
    ألحق(م, 0x80 مثل غ8);
    بينما (((الطول(م) مثل غير_موقع) % 128) != 112) { ألحق(م, 0 مثل غ8); }
    // The 128-bit length: messages are below 2^61 bytes.
    ألحق_كبير64_تشفير(&متغير م, 0);
    ألحق_كبير64_تشفير(&متغير م, الحجم * 8);

    دع الثوابت: متجه غير_موقع = ثوابت_شا512();
    دع الحالة: متغير متجه غير_موقع = الحالة_الأولى;
    دع الكتلة: متغير غير_موقع = 0;
    دع الكلي: غير_موقع = الطول(م) مثل غير_موقع;
    بينما (الكتلة < الكلي) {
        اضغط_كتلة_شا512(&متغير الحالة, &م, الكتلة, &الثوابت);
        الكتلة := الكتلة + 128;
    }
    دع الخرج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_الكلمات) {
        ألحق_كبير64_تشفير(&متغير الخرج, الحالة[ف]);
        ف := ف + 1;
    }
    أرجع الخرج;
}

عام عرف شا512(المصدر: &متجه غ8): متجه غ8 {
    دع الحالة: متجه غير_موقع = [
        0x6A09E667F3BCC908, 0xBB67AE8584CAA73B, 0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1,
        0x510E527FADE682D1, 0x9B05688C2B3E6C1F, 0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179
    ];
    أرجع شا512_بحالة(المصدر, الحالة, 8);
}

عام عرف شا384(المصدر: &متجه غ8): متجه غ8 {
    دع الحالة: متجه غير_موقع = [
        0xCBBB9D5DC1059ED8, 0x629A292A367CD507, 0x9159015A3070DD17, 0x152FECD8F70E5939,
        0x67332667FFC00B31, 0x8EB44A8768581511, 0xDB0C2E0D64F98FA7, 0x47B5481DBEFA4FA4
    ];
    أرجع شا512_بحالة(المصدر, الحالة, 6);
}

عام مرادف sha512 = شا512;
عام مرادف sha384 = شا384;
