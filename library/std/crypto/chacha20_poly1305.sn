// ChaCha20, Poly1305 and the ChaCha20-Poly1305 AEAD (RFC 8439).
// Every operation is data-independent: additions, rotations and XORs on
// 32-bit words, and Poly1305 in 26-bit limbs (the poly1305-donna layout) with
// a masked final reduction. Tags are compared in constant time.

استورد crypto.words;

عرف ربع_جولة_تشاتشا(س: &متغير متجه طبيعي, أ: طبيعي, ب: طبيعي, ج: طبيعي, د: طبيعي): فراغ {
    (*س)[أ] := جمع32_تشفير((*س)[أ], (*س)[ب]);
    (*س)[د] := دور_يسار32_تشفير((*س)[د] ^ (*س)[أ], 16);
    (*س)[ج] := جمع32_تشفير((*س)[ج], (*س)[د]);
    (*س)[ب] := دور_يسار32_تشفير((*س)[ب] ^ (*س)[ج], 12);
    (*س)[أ] := جمع32_تشفير((*س)[أ], (*س)[ب]);
    (*س)[د] := دور_يسار32_تشفير((*س)[د] ^ (*س)[أ], 8);
    (*س)[ج] := جمع32_تشفير((*س)[ج], (*س)[د]);
    (*س)[ب] := دور_يسار32_تشفير((*س)[ب] ^ (*س)[ج], 7);
}

// One 64-byte keystream block (RFC 8439 2.3) for a 32-byte key and 12-byte nonce.
عام عرف كتلة_تشاتشا20(المفتاح: &متجه ط8, العداد: طبيعي, النونس: &متجه ط8): متجه ط8 {
    دع الأولى: متغير متجه طبيعي = [0x61707865, 0x3320646E, 0x79622D32, 0x6B206574];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق(الأولى, اقرأ_صغير32_تشفير(المفتاح, ف * 4));
        ف := ف + 1;
    }
    ألحق(الأولى, العداد & 0xFFFFFFFF);
    ف := 0;
    طالما (ف < 3) {
        ألحق(الأولى, اقرأ_صغير32_تشفير(النونس, ف * 4));
        ف := ف + 1;
    }
    دع س: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < 16) {
        ألحق(س, الأولى[ف]);
        ف := ف + 1;
    }
    دع الجولة: متغير طبيعي = 0;
    طالما (الجولة < 10) {
        ربع_جولة_تشاتشا(&متغير س, 0, 4, 8, 12);
        ربع_جولة_تشاتشا(&متغير س, 1, 5, 9, 13);
        ربع_جولة_تشاتشا(&متغير س, 2, 6, 10, 14);
        ربع_جولة_تشاتشا(&متغير س, 3, 7, 11, 15);
        ربع_جولة_تشاتشا(&متغير س, 0, 5, 10, 15);
        ربع_جولة_تشاتشا(&متغير س, 1, 6, 11, 12);
        ربع_جولة_تشاتشا(&متغير س, 2, 7, 8, 13);
        ربع_جولة_تشاتشا(&متغير س, 3, 4, 9, 14);
        الجولة := الجولة + 1;
    }
    دع الخرج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 16) {
        ألحق_صغير32_تشفير(&متغير الخرج, جمع32_تشفير(س[ف], الأولى[ف]));
        ف := ف + 1;
    }
    امسح_كلمات_تشاتشا(&متغير س);
    امسح_كلمات_تشاتشا(&متغير الأولى);
    أرجع الخرج;
}

عرف امسح_كلمات_تشاتشا(الكلمات: &متغير متجه طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكلمات) مثل طبيعي)) {
        (*الكلمات)[ف] := 0;
        ف := ف + 1;
    }
}

// XORs the keystream starting at العداد_الأول with البيانات (RFC 8439 2.4).
// The caller keeps the block counter below 2^32.
عام عرف شفر_تشاتشا20(
    المفتاح: &متجه ط8,
    العداد_الأول: طبيعي,
    النونس: &متجه ط8,
    البيانات: &متجه ط8
): متجه ط8 {
    دع الحجم: طبيعي = الطول(*البيانات) مثل طبيعي;
    دع الخرج: متغير متجه ط8 = [];
    دع العداد: متغير طبيعي = العداد_الأول;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم) {
        دع التيار: متغير متجه ط8 = كتلة_تشاتشا20(المفتاح, العداد, النونس);
        دع ف: متغير طبيعي = 0;
        طالما ((ف < 64) && (الموضع + ف < الحجم)) {
            دع ب: طبيعي = ((*البيانات)[الموضع + ف] مثل طبيعي) ^ (التيار[ف] مثل طبيعي);
            ألحق(الخرج, ب مثل ط8);
            ف := ف + 1;
        }
        امسح_بايتات_تشفير(&متغير التيار);
        الموضع := الموضع + 64;
        العداد := العداد + 1;
    }
    أرجع الخرج;
}

// Poly1305 one-time authenticator (RFC 8439 2.5) over a 32-byte key.
عام عرف بولي1305(المفتاح: &متجه ط8, الرسالة: &متجه ط8): متجه ط8 {
    دع ق: طبيعي = 0x3FFFFFF;
    دع ر0: طبيعي = اقرأ_صغير32_تشفير(المفتاح, 0) & 0x3FFFFFF;
    دع ر1: طبيعي = (اقرأ_صغير32_تشفير(المفتاح, 3) >> 2) & 0x3FFFF03;
    دع ر2: طبيعي = (اقرأ_صغير32_تشفير(المفتاح, 6) >> 4) & 0x3FFC0FF;
    دع ر3: طبيعي = (اقرأ_صغير32_تشفير(المفتاح, 9) >> 6) & 0x3F03FFF;
    دع ر4: طبيعي = (اقرأ_صغير32_تشفير(المفتاح, 12) >> 8) & 0x00FFFFF;
    دع س1: طبيعي = ر1 * 5;
    دع س2: طبيعي = ر2 * 5;
    دع س3: طبيعي = ر3 * 5;
    دع س4: طبيعي = ر4 * 5;
    دع ه0: متغير طبيعي = 0;
    دع ه1: متغير طبيعي = 0;
    دع ه2: متغير طبيعي = 0;
    دع ه3: متغير طبيعي = 0;
    دع ه4: متغير طبيعي = 0;

    دع الحجم: طبيعي = الطول(*الرسالة) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم) {
        دع الكتلة: متغير متجه ط8 = [];
        دع البت_العلوي: متغير طبيعي = 16777216;
        دع ف: متغير طبيعي = 0;
        طالما ((ف < 16) && (الموضع + ف < الحجم)) {
            ألحق(الكتلة, (*الرسالة)[الموضع + ف]);
            ف := ف + 1;
        }
        لو (ف < 16) {
            // Final partial block: append 0x01 then zeros; no 2^128 bit.
            ألحق(الكتلة, 1 مثل ط8);
            طالما ((الطول(الكتلة) مثل طبيعي) < 16) { ألحق(الكتلة, 0 مثل ط8); }
            البت_العلوي := 0;
        };
        ه0 := ه0 + (اقرأ_صغير32_تشفير(&الكتلة, 0) & ق);
        ه1 := ه1 + ((اقرأ_صغير32_تشفير(&الكتلة, 3) >> 2) & ق);
        ه2 := ه2 + ((اقرأ_صغير32_تشفير(&الكتلة, 6) >> 4) & ق);
        ه3 := ه3 + ((اقرأ_صغير32_تشفير(&الكتلة, 9) >> 6) & ق);
        ه4 := ه4 + ((اقرأ_صغير32_تشفير(&الكتلة, 12) >> 8) | البت_العلوي);

        دع د0: متغير طبيعي = (ه0 * ر0) + (ه1 * س4) + (ه2 * س3) + (ه3 * س2) + (ه4 * س1);
        دع د1: متغير طبيعي = (ه0 * ر1) + (ه1 * ر0) + (ه2 * س4) + (ه3 * س3) + (ه4 * س2);
        دع د2: متغير طبيعي = (ه0 * ر2) + (ه1 * ر1) + (ه2 * ر0) + (ه3 * س4) + (ه4 * س3);
        دع د3: متغير طبيعي = (ه0 * ر3) + (ه1 * ر2) + (ه2 * ر1) + (ه3 * ر0) + (ه4 * س4);
        دع د4: متغير طبيعي = (ه0 * ر4) + (ه1 * ر3) + (ه2 * ر2) + (ه3 * ر1) + (ه4 * ر0);

        دع حمل: متغير طبيعي = د0 >> 26;
        ه0 := د0 & ق;
        د1 := د1 + حمل; حمل := د1 >> 26; ه1 := د1 & ق;
        د2 := د2 + حمل; حمل := د2 >> 26; ه2 := د2 & ق;
        د3 := د3 + حمل; حمل := د3 >> 26; ه3 := د3 & ق;
        د4 := د4 + حمل; حمل := د4 >> 26; ه4 := د4 & ق;
        ه0 := ه0 + (حمل * 5); حمل := ه0 >> 26; ه0 := ه0 & ق;
        ه1 := ه1 + حمل;
        الموضع := الموضع + 16;
    }

    // Full carry, then h + 5 - 2^130 selected without a branch.
    دع ح: متغير طبيعي = ه1 >> 26;
    ه1 := ه1 & ق; ه2 := ه2 + ح; ح := ه2 >> 26;
    ه2 := ه2 & ق; ه3 := ه3 + ح; ح := ه3 >> 26;
    ه3 := ه3 & ق; ه4 := ه4 + ح; ح := ه4 >> 26;
    ه4 := ه4 & ق; ه0 := ه0 + (ح * 5); ح := ه0 >> 26;
    ه0 := ه0 & ق; ه1 := ه1 + ح;

    دع ج0: متغير طبيعي = ه0 + 5; ح := ج0 >> 26; ج0 := ج0 & ق;
    دع ج1: متغير طبيعي = ه1 + ح; ح := ج1 >> 26; ج1 := ج1 & ق;
    دع ج2: متغير طبيعي = ه2 + ح; ح := ج2 >> 26; ج2 := ج2 & ق;
    دع ج3: متغير طبيعي = ه3 + ح; ح := ج3 >> 26; ج3 := ج3 & ق;
    دع ج4_كامل: طبيعي = ه4 + ح;
    دع اختيار_ج: طبيعي = ج4_كامل >> 26;
    دع ج4: طبيعي = ج4_كامل & ق;
    ه0 := اختر32_تشفير(اختيار_ج, ج0, ه0);
    ه1 := اختر32_تشفير(اختيار_ج, ج1, ه1);
    ه2 := اختر32_تشفير(اختيار_ج, ج2, ه2);
    ه3 := اختر32_تشفير(اختيار_ج, ج3, ه3);
    ه4 := اختر32_تشفير(اختيار_ج, ج4, ه4);

    دع ك0: طبيعي = (ه0 | (ه1 << 26)) & 0xFFFFFFFF;
    دع ك1: طبيعي = ((ه1 >> 6) | (ه2 << 20)) & 0xFFFFFFFF;
    دع ك2: طبيعي = ((ه2 >> 12) | (ه3 << 14)) & 0xFFFFFFFF;
    دع ك3: طبيعي = ((ه3 >> 18) | (ه4 << 8)) & 0xFFFFFFFF;

    دع م: متغير طبيعي = ك0 + اقرأ_صغير32_تشفير(المفتاح, 16);
    دع الخرج: متغير متجه ط8 = [];
    ألحق_صغير32_تشفير(&متغير الخرج, م & 0xFFFFFFFF);
    م := ك1 + اقرأ_صغير32_تشفير(المفتاح, 20) + (م >> 32);
    ألحق_صغير32_تشفير(&متغير الخرج, م & 0xFFFFFFFF);
    م := ك2 + اقرأ_صغير32_تشفير(المفتاح, 24) + (م >> 32);
    ألحق_صغير32_تشفير(&متغير الخرج, م & 0xFFFFFFFF);
    م := ك3 + اقرأ_صغير32_تشفير(المفتاح, 28) + (م >> 32);
    ألحق_صغير32_تشفير(&متغير الخرج, م & 0xFFFFFFFF);
    أرجع الخرج;
}

عرف ألحق_حشو16_تشاتشا(الهدف: &متغير متجه ط8): فراغ {
    طالما (((الطول(*الهدف) مثل طبيعي) % 16) != 0) { ألحق(*الهدف, 0 مثل ط8); }
}

عرف وسم_تشاتشا20_بولي1305(
    المفتاح: &متجه ط8,
    النونس: &متجه ط8,
    البيانات_الإضافية: &متجه ط8,
    المشفر: &متجه ط8
): متجه ط8 {
    دع الكتلة_الصفرية: متغير متجه ط8 = كتلة_تشاتشا20(المفتاح, 0, النونس);
    دع مفتاح_المرة: متغير متجه ط8 = شريحة_بايتات_تشفير(&الكتلة_الصفرية, 0, 32);
    دع بيانات_الوسم: متغير متجه ط8 = [];
    ألحق_بايتات_تشفير(&متغير بيانات_الوسم, البيانات_الإضافية);
    ألحق_حشو16_تشاتشا(&متغير بيانات_الوسم);
    ألحق_بايتات_تشفير(&متغير بيانات_الوسم, المشفر);
    ألحق_حشو16_تشاتشا(&متغير بيانات_الوسم);
    ألحق_صغير64_تشفير(&متغير بيانات_الوسم, الطول(*البيانات_الإضافية) مثل طبيعي);
    ألحق_صغير64_تشفير(&متغير بيانات_الوسم, الطول(*المشفر) مثل طبيعي);
    دع الوسم: متجه ط8 = بولي1305(&مفتاح_المرة, &بيانات_الوسم);
    امسح_بايتات_تشفير(&متغير الكتلة_الصفرية);
    امسح_بايتات_تشفير(&متغير مفتاح_المرة);
    أرجع الوسم;
}

// AEAD_CHACHA20_POLY1305 encryption: ciphertext followed by the 16-byte tag.
عام عرف اختم_تشاتشا20_بولي1305(
    المفتاح: &متجه ط8,
    النونس: &متجه ط8,
    البيانات_الإضافية: &متجه ط8,
    الصريح: &متجه ط8
): متجه ط8 {
    دع الناتج: متغير متجه ط8 = شفر_تشاتشا20(المفتاح, 1, النونس, الصريح);
    دع الوسم: متجه ط8 = وسم_تشاتشا20_بولي1305(المفتاح, النونس, البيانات_الإضافية, &الناتج);
    ألحق_بايتات_تشفير(&متغير الناتج, &الوسم);
    أرجع الناتج;
}

// AEAD_CHACHA20_POLY1305 decryption; none when the tag does not verify.
// No plaintext is produced before the tag check.
عام عرف افتح_تشاتشا20_بولي1305(
    المفتاح: &متجه ط8,
    النونس: &متجه ط8,
    البيانات_الإضافية: &متجه ط8,
    المشفر_والوسم: &متجه ط8
): اختياري متجه ط8 {
    دع الكلي: طبيعي = الطول(*المشفر_والوسم) مثل طبيعي;
    لو (الكلي < 16) { أرجع اختياري.لا_شيء(); };
    دع المشفر: متجه ط8 = شريحة_بايتات_تشفير(المشفر_والوسم, 0, الكلي - 16);
    دع الوسم_المستلم: متجه ط8 = شريحة_بايتات_تشفير(المشفر_والوسم, الكلي - 16, 16);
    دع الوسم: متجه ط8 = وسم_تشاتشا20_بولي1305(المفتاح, النونس, البيانات_الإضافية, &المشفر);
    لو (!بايتات_متساوية_بزمن_ثابت_تشفير(&الوسم, &الوسم_المستلم)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(شفر_تشاتشا20(المفتاح, 1, النونس, &المشفر));
}

عام مرادف chacha20_block = كتلة_تشاتشا20;
عام مرادف chacha20_xor = شفر_تشاتشا20;
عام مرادف poly1305 = بولي1305;
عام مرادف chacha20_poly1305_seal = اختم_تشاتشا20_بولي1305;
عام مرادف chacha20_poly1305_open = افتح_تشاتشا20_بولي1305;
