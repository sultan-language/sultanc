// Triple DES (EDE, 3-key) in CBC mode, decryption only (FIPS 46-3,
// SP 800-67), for legacy PKCS#12 containers protected with
// pbeWithSHAAnd3-KeyTripleDES-CBC. Permutation tables are the standard's;
// S-box values are read by scanning all 64 entries with masks so the access
// pattern does not depend on key or data.

استورد crypto.words;

نوع جداول_دي_إي_إس = {
    البدائي: متجه غير_موقع,
    النهائي: متجه غير_موقع,
    التوسيع: متجه غير_موقع,
    التبديل: متجه غير_موقع,
    الاختيار1: متجه غير_موقع,
    الاختيار2: متجه غير_موقع,
    الإزاحات: متجه غير_موقع,
    الصناديق: متجه غير_موقع
};

عرف جداول_دي_إي_إس_المعيارية(): جداول_دي_إي_إس {
    دع البدائي: متجه غير_موقع = [
        58, 50, 42, 34, 26, 18, 10, 2, 60, 52, 44, 36, 28, 20, 12, 4,
