// Bit permutation: positions count from 1 at the most significant of العرض bits.
عرف بدل_بتات_دي_إي_إس(القيمة: غير_موقع, الجدول: &متجه غير_موقع, العرض: غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الجدول) مثل غير_موقع)) {
        الناتج := (الناتج << 1) | ((القيمة >> (العرض - (*الجدول)[ف])) & 1);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// The sixteen 48-bit round keys of one DES key (big-endian 8 bytes).
عرف مفاتيح_جولات_دي_إي_إس(المفتاح: &متجه غ8, البداية: غير_موقع, الجداول: &جداول_دي_إي_إس): متجه غير_موقع {
    دع الكلمة: غير_موقع = اقرأ_كبير64_تشفير(المفتاح, البداية);
    دع المختار: غير_موقع = بدل_بتات_دي_إي_إس(الكلمة, &(*الجداول).الاختيار1, 64);
    دع ج: متغير غير_موقع = المختار >> 28;
    دع د: متغير غير_موقع = المختار & 0xFFFFFFF;
    دع المفاتيح: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع الإزاحة: غير_موقع = (*الجداول).الإزاحات[ف];
        ج := ((ج << الإزاحة) | (ج >> (28 - الإزاحة))) & 0xFFFFFFF;
        د := ((د << الإزاحة) | (د >> (28 - الإزاحة))) & 0xFFFFFFF;
        ألحق(المفاتيح, بدل_بتات_دي_إي_إس((ج << 28) | د, &(*الجداول).الاختيار2, 56));
        ف := ف + 1;
    }
    أرجع المفاتيح;
}

عرف دالة_الجولة_دي_إي_إس(اليمين: غير_موقع, المفتاح: غير_موقع, الجداول: &جداول_دي_إي_إس): غير_موقع {
    دع س: غير_موقع = بدل_بتات_دي_إي_إس(اليمين, &(*الجداول).التوسيع, 32) ^ المفتاح;
    دع الخرج: متغير غير_موقع = 0;
    دع ص: متغير غير_موقع = 0;
    بينما (ص < 8) {
        دع ب: غير_موقع = (س >> (42 - 6 * ص)) & 63;
        دع الفهرس: غير_موقع = (((ب >> 4) & 2) | (ب & 1)) * 16 + ((ب >> 1) & 15);
        دع القيمة: متغير غير_موقع = 0;
        دع م: متغير غير_موقع = 0;
        بينما (م < 64) {
            دع مطابق: غير_موقع = 1 - ليس_صفرا32_تشفير(م ^ الفهرس);
            القيمة := القيمة | ((*الجداول).الصناديق[ص * 64 + م] * مطابق);
            م := م + 1;
        }
        الخرج := (الخرج << 4) | القيمة;
        ص := ص + 1;
    }
    أرجع بدل_بتات_دي_إي_إس(الخرج, &(*الجداول).التبديل, 32);
}

عرف كتلة_دي_إي_إس(الكتلة: غير_موقع, المفاتيح: &متجه غير_موقع, معكوس: منطقي, الجداول: &جداول_دي_إي_إس): غير_موقع {
    دع البداية: غير_موقع = بدل_بتات_دي_إي_إس(الكتلة, &(*الجداول).البدائي, 64);
    دع يسار: متغير غير_موقع = البداية >> 32;
    دع يمين: متغير غير_موقع = البداية & 0xFFFFFFFF;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        دع رقم: متغير غير_موقع = ف;
        لو (معكوس) { رقم := 15 - ف; };
        دع التالي: غير_موقع = يسار ^ دالة_الجولة_دي_إي_إس(يمين, (*المفاتيح)[رقم], الجداول);
        يسار := يمين;
        يمين := التالي;
        ف := ف + 1;
    }
    أرجع بدل_بتات_دي_إي_إس((يمين << 32) | يسار, &(*الجداول).النهائي, 64);
}

// 3DES-CBC decryption with PKCS#7 padding removal; none when malformed.
عام عرف فك_دي_إي_إس_الثلاثي_سي_بي_سي(المفتاح: &متجه غ8, المتجه_الأولي: &متجه غ8, المشفر: &متجه غ8): اختيار متجه غ8 {
    دع الحجم: غير_موقع = الطول(*المشفر) مثل غير_موقع;
    لو ((الطول(*المفتاح) مثل غير_موقع) != 24 || (الطول(*المتجه_الأولي) مثل غير_موقع) != 8) { أرجع اختيار.لا_شيء(); };
    لو (الحجم == 0 || (الحجم % 8) != 0) { أرجع اختيار.لا_شيء(); };
    دع الجداول: جداول_دي_إي_إس = جداول_دي_إي_إس_المعيارية();
    دع م1: متجه غير_موقع = مفاتيح_جولات_دي_إي_إس(المفتاح, 0, &الجداول);
    دع م2: متجه غير_موقع = مفاتيح_جولات_دي_إي_إس(المفتاح, 8, &الجداول);
    دع م3: متجه غير_موقع = مفاتيح_جولات_دي_إي_إس(المفتاح, 16, &الجداول);
    دع السابق: متغير غير_موقع = اقرأ_كبير64_تشفير(المتجه_الأولي, 0);
    دع الناتج: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < الحجم) {
        دع الكتلة: غير_موقع = اقرأ_كبير64_تشفير(المشفر, الموضع);
        // EDE decryption: D_K1(E_K2(D_K3(c))).
        دع أ: غير_موقع = كتلة_دي_إي_إس(الكتلة, &م3, صواب, &الجداول);
        دع ب: غير_موقع = كتلة_دي_إي_إس(أ, &م2, خطأ, &الجداول);
        دع ج: غير_موقع = كتلة_دي_إي_إس(ب, &م1, صواب, &الجداول);
        ألحق_كبير64_تشفير(&متغير الناتج, ج ^ السابق);
        السابق := الكتلة;
        الموضع := الموضع + 8;
    }
    دع الحشو: غير_موقع = الناتج[الحجم - 1] مثل غير_موقع;
    لو (الحشو == 0 || الحشو > 8) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحشو) {
        لو ((الناتج[الحجم - 1 - ف] مثل غير_موقع) != الحشو) { أرجع اختيار.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختيار.بعض(شريحة_بايتات_تشفير(&الناتج, 0, الحجم - الحشو));
}

عام مرادف triple_des_cbc_decrypt = فك_دي_إي_إس_الثلاثي_سي_بي_سي;
