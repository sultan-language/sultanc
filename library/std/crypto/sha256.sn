// SHA-256 is implemented entirely in std. The implementation operates on
// bytes and owns no target/runtime policy. HMAC, HKDF and PBKDF2 over every
// std digest, including the SHA-256 forms, are owned by crypto.digest.

استورد crypto.words;

عرف دور_يمين_ط32(القيمة: طبيعي, المقدار: طبيعي): طبيعي {
    أرجع دور_يمين32_تشفير(القيمة % 4294967296, المقدار);
}

عرف اجمع_ط32(أ: طبيعي, ب: طبيعي): طبيعي {
    أرجع جمع32_تشفير(أ, ب);
}

عرف ألحق_بايت_هاش(البايتات: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    ألحق(*البايتات, (القيمة % 256) مثل ط8);
}

// SHA-256 core consumes a borrowed input range; only the padded message is
// allocated. This allows object writers to hash pages without copying images.
عرف شا256_المجال_المتحقق(
    المصدر: &متجه ط8, البداية: طبيعي, الحجم: طبيعي
): متجه ط8 {
    دع م: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) { ألحق(م, (*المصدر)[البداية + ف]); ف := ف + 1; }
    ألحق(م, 0x80 مثل ط8);
    طالما (((الطول(م) مثل طبيعي) % 64) != 56) { ألحق(م, 0 مثل ط8); }

    دع طول_البتات: طبيعي = الحجم * 8;
    دع ع: متغير طبيعي = 0;
    طالما (ع < 8) {
        دع إزاحة: طبيعي = 7 - ع;
        دع قاسم: متغير طبيعي = 1;
        دع ك: متغير طبيعي = 0;
        طالما (ك < إزاحة) { قاسم := قاسم * 256; ك := ك + 1; }
        ألحق(م, ((طول_البتات / قاسم) % 256) مثل ط8);
        ع := ع + 1;
    }

    دع الثوابت: متجه طبيعي = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2
    ];
    دع ه0: متغير طبيعي = 0x6A09E667;
    دع ه1: متغير طبيعي = 0xBB67AE85;
    دع ه2: متغير طبيعي = 0x3C6EF372;
    دع ه3: متغير طبيعي = 0xA54FF53A;
    دع ه4: متغير طبيعي = 0x510E527F;
    دع ه5: متغير طبيعي = 0x9B05688C;
    دع ه6: متغير طبيعي = 0x1F83D9AB;
    دع ه7: متغير طبيعي = 0x5BE0CD19;

    // Reuse the SHA-256 message schedule across blocks (no per-block allocation).
    دع و: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < 64) { ألحق(و, 0); ف := ف + 1; }
    دع كتلة: متغير طبيعي = 0;
    طالما (كتلة < (الطول(م) مثل طبيعي)) {
        ف := 0;
        طالما (ف < 16) {
            دع موضع: طبيعي = كتلة + ف * 4;
            دع موضع1: طبيعي = موضع + 1;
            دع موضع2: طبيعي = موضع + 2;
            دع موضع3: طبيعي = موضع + 3;
            دع ب0: طبيعي = م[موضع] مثل طبيعي;
            دع ب1: طبيعي = م[موضع1] مثل طبيعي;
            دع ب2: طبيعي = م[موضع2] مثل طبيعي;
            دع ب3: طبيعي = م[موضع3] مثل طبيعي;
            و[ف] := (ب0 * 16777216) + (ب1 * 65536) + (ب2 * 256) + ب3;
            ف := ف + 1;
        }
        طالما (ف < 64) {
            دع ف_15: طبيعي = ف - 15;
            دع ف_2: طبيعي = ف - 2;
            دع ف_16: طبيعي = ف - 16;
            دع ف_7: طبيعي = ف - 7;
            دع س0: طبيعي = دور_يمين_ط32(و[ف_15], 7)
                ^ دور_يمين_ط32(و[ف_15], 18)
                ^ (و[ف_15] >> 3);
            دع س1: طبيعي = دور_يمين_ط32(و[ف_2], 17)
                ^ دور_يمين_ط32(و[ف_2], 19)
                ^ (و[ف_2] >> 10);
            و[ف] := اجمع_ط32(اجمع_ط32(اجمع_ط32(و[ف_16], س0), و[ف_7]), س1);
            ف := ف + 1;
        }

        دع أ: متغير طبيعي = ه0; دع ب: متغير طبيعي = ه1;
        دع ج: متغير طبيعي = ه2; دع د: متغير طبيعي = ه3;
        دع هاء: متغير طبيعي = ه4; دع و5: متغير طبيعي = ه5;
        دع ز: متغير طبيعي = ه6; دع ح: متغير طبيعي = ه7;
        ف := 0;
        طالما (ف < 64) {
            دع س1أ: طبيعي = دور_يمين_ط32(هاء, 6) ^ دور_يمين_ط32(هاء, 11) ^ دور_يمين_ط32(هاء, 25);
            دع هاء_و5: طبيعي = هاء & و5;
            دع مقلوب_هاء: طبيعي = هاء ^ 0xFFFFFFFF;
            دع مقلوب_هاء_ز: طبيعي = مقلوب_هاء & ز;
            دع اختيار_هاء: طبيعي = هاء_و5 ^ مقلوب_هاء_ز;
            دع مؤقت1: طبيعي = اجمع_ط32(اجمع_ط32(اجمع_ط32(اجمع_ط32(ح, س1أ), اختيار_هاء), الثوابت[ف]), و[ف]);
            دع س0أ: طبيعي = دور_يمين_ط32(أ, 2) ^ دور_يمين_ط32(أ, 13) ^ دور_يمين_ط32(أ, 22);
            دع أ_ب: طبيعي = أ & ب;
            دع أ_ج: طبيعي = أ & ج;
            دع ب_ج: طبيعي = ب & ج;
            دع غالبية: طبيعي = أ_ب ^ أ_ج ^ ب_ج;
            دع مؤقت2: طبيعي = اجمع_ط32(س0أ, غالبية);
            ح := ز; ز := و5; و5 := هاء; هاء := اجمع_ط32(د, مؤقت1);
            د := ج; ج := ب; ب := أ; أ := اجمع_ط32(مؤقت1, مؤقت2);
            ف := ف + 1;
        }
        ه0 := اجمع_ط32(ه0, أ); ه1 := اجمع_ط32(ه1, ب);
        ه2 := اجمع_ط32(ه2, ج); ه3 := اجمع_ط32(ه3, د);
        ه4 := اجمع_ط32(ه4, هاء); ه5 := اجمع_ط32(ه5, و5);
        ه6 := اجمع_ط32(ه6, ز); ه7 := اجمع_ط32(ه7, ح);
        كتلة := كتلة + 64;
    }

    دع الخرج: متغير متجه ط8 = [];
    دع الحالات: متجه طبيعي = [ه0,ه1,ه2,ه3,ه4,ه5,ه6,ه7];
    ف := 0;
    طالما (ف < 8) {
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 16777216);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 65536);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 256);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف]);
        ف := ف + 1;
    }
    أرجع الخرج;
}

// The subtraction check prevents overflow in start + length.
عام عرف شا256_لمدى(
    المصدر: &متجه ط8, البداية: طبيعي, الحجم: طبيعي
): اختياري متجه ط8 {
    دع طول_المصدر: طبيعي = الطول(*المصدر) مثل طبيعي;
    لو (البداية > طول_المصدر || الحجم > طول_المصدر - البداية) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(شا256_المجال_المتحقق(المصدر, البداية, الحجم));
}

عام عرف شا256(المصدر: &متجه ط8): متجه ط8 {
    أرجع شا256_المجال_المتحقق(المصدر, 0, الطول(*المصدر) مثل طبيعي);
}

عام عرف هاش_متساوي_بزمن_ثابت(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    أرجع بايتات_متساوية_بزمن_ثابت_تشفير(أ, ب);
}

عام مرادف sha256 = شا256;
عام مرادف constant_time_digest_equal = هاش_متساوي_بزمن_ثابت;
عام مرادف sha256_range = شا256_لمدى;
