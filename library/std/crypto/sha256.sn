// SHA-256 is implemented entirely in std. The implementation operates on
// bytes and owns no target/runtime policy. HMAC, HKDF and PBKDF2 over every
// std digest, including the SHA-256 forms, are owned by crypto.digest.
//
// The working words are ط32, as FIPS 180-4 defines them. Integer arithmetic
// traps on overflow and the C Stage0 that builds the compiler (which hashes
// Mach-O pages through شا256_لمدى) has no wrapping intrinsics, so the
// modular sum and the rotation widen to uint and mask back to 32 bits.

استورد crypto.words;

عرف دور_يمين_ط32(القيمة: ط32, المقدار: طبيعي): ط32 {
    دع الكلمة: طبيعي = القيمة مثل طبيعي;
    أرجع (((الكلمة >> المقدار) | (الكلمة << (32 - المقدار))) & 0xFFFFFFFF) مثل ط32;
}

عرف اجمع_ط32(أ: ط32, ب: ط32): ط32 {
    أرجع (((أ مثل طبيعي) + (ب مثل طبيعي)) & 0xFFFFFFFF) مثل ط32;
}

عرف ألحق_كلمة_هاش(البايتات: &متغير متجه ط8, القيمة: ط32): فراغ {
    ألحق(*البايتات, (القيمة >> 24) مثل ط8);
    ألحق(*البايتات, ((القيمة >> 16) & 0xFF) مثل ط8);
    ألحق(*البايتات, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*البايتات, (القيمة & 0xFF) مثل ط8);
}

عرف ثوابت_شا256(): متجه ط32 {
    دع الثوابت: متجه ط32 = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2
    ];
    أرجع الثوابت;
}

// One 64-byte block of الكتلة at البداية into الحالة (eight words). و is
// the 64-word message schedule, reused across blocks.
عرف اضغط_كتلة_شا256(
    الحالة: &متغير متجه ط32,
    و: &متغير متجه ط32,
    الثوابت: &متجه ط32,
    الكتلة: &متجه ط8,
    البداية: طبيعي
): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < 16) {
        دع موضع: طبيعي = البداية + ف * 4;
        دع ب0: طبيعي = (*الكتلة)[موضع] مثل طبيعي;
        دع ب1: طبيعي = (*الكتلة)[موضع + 1] مثل طبيعي;
        دع ب2: طبيعي = (*الكتلة)[موضع + 2] مثل طبيعي;
        دع ب3: طبيعي = (*الكتلة)[موضع + 3] مثل طبيعي;
        (*و)[ف] := ((ب0 << 24) | (ب1 << 16) | (ب2 << 8) | ب3) مثل ط32;
        ف := ف + 1;
    }
    طالما (ف < 64) {
        دع ك15: ط32 = (*و)[ف - 15];
        دع ك2: ط32 = (*و)[ف - 2];
        دع س0: ط32 = دور_يمين_ط32(ك15, 7) ^ دور_يمين_ط32(ك15, 18) ^ (ك15 >> 3);
        دع س1: ط32 = دور_يمين_ط32(ك2, 17) ^ دور_يمين_ط32(ك2, 19) ^ (ك2 >> 10);
        (*و)[ف] := اجمع_ط32(اجمع_ط32(اجمع_ط32((*و)[ف - 16], س0), (*و)[ف - 7]), س1);
        ف := ف + 1;
    }

    دع أ: متغير ط32 = (*الحالة)[0]; دع ب: متغير ط32 = (*الحالة)[1];
    دع ج: متغير ط32 = (*الحالة)[2]; دع د: متغير ط32 = (*الحالة)[3];
    دع هاء: متغير ط32 = (*الحالة)[4]; دع و5: متغير ط32 = (*الحالة)[5];
    دع ز: متغير ط32 = (*الحالة)[6]; دع ح: متغير ط32 = (*الحالة)[7];
    ف := 0;
    طالما (ف < 64) {
        دع س1أ: ط32 = دور_يمين_ط32(هاء, 6) ^ دور_يمين_ط32(هاء, 11) ^ دور_يمين_ط32(هاء, 25);
        دع اختيار_هاء: ط32 = (هاء & و5) ^ ((هاء ^ 0xFFFFFFFF) & ز);
        دع مؤقت1: ط32 = اجمع_ط32(اجمع_ط32(اجمع_ط32(اجمع_ط32(ح, س1أ), اختيار_هاء), (*الثوابت)[ف]), (*و)[ف]);
        دع س0أ: ط32 = دور_يمين_ط32(أ, 2) ^ دور_يمين_ط32(أ, 13) ^ دور_يمين_ط32(أ, 22);
        دع غالبية: ط32 = (أ & ب) ^ (أ & ج) ^ (ب & ج);
        دع مؤقت2: ط32 = اجمع_ط32(س0أ, غالبية);
        ح := ز; ز := و5; و5 := هاء; هاء := اجمع_ط32(د, مؤقت1);
        د := ج; ج := ب; ب := أ; أ := اجمع_ط32(مؤقت1, مؤقت2);
        ف := ف + 1;
    }
    (*الحالة)[0] := اجمع_ط32((*الحالة)[0], أ); (*الحالة)[1] := اجمع_ط32((*الحالة)[1], ب);
    (*الحالة)[2] := اجمع_ط32((*الحالة)[2], ج); (*الحالة)[3] := اجمع_ط32((*الحالة)[3], د);
    (*الحالة)[4] := اجمع_ط32((*الحالة)[4], هاء); (*الحالة)[5] := اجمع_ط32((*الحالة)[5], و5);
    (*الحالة)[6] := اجمع_ط32((*الحالة)[6], ز); (*الحالة)[7] := اجمع_ط32((*الحالة)[7], ح);
}

// SHA-256 core over a borrowed input range. Whole blocks are compressed in
// place; only the last partial block and the padding (at most 128 bytes)
// are copied, so hashing an object image allocates no copy of it.
عرف شا256_المجال_المتحقق(
    المصدر: &متجه ط8, البداية: طبيعي, الحجم: طبيعي
): متجه ط8 {
    دع الثوابت: متجه ط32 = ثوابت_شا256();
    دع الحالة: متغير متجه ط32 = [
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
    ];
    دع و: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 64) { ألحق(و, 0 مثل ط32); ف := ف + 1; }

    دع الكاملة: طبيعي = الحجم - (الحجم % 64);
    دع كتلة: متغير طبيعي = 0;
    طالما (كتلة < الكاملة) {
        اضغط_كتلة_شا256(&متغير الحالة, &متغير و, &الثوابت, المصدر, البداية + كتلة);
        كتلة := كتلة + 64;
    }

    // The tail, 0x80, zeros up to 56 mod 64, then the bit length (big endian).
    دع الذيل: متغير متجه ط8 = [];
    ف := الكاملة;
    طالما (ف < الحجم) { ألحق(الذيل, (*المصدر)[البداية + ف]); ف := ف + 1; }
    ألحق(الذيل, 0x80 مثل ط8);
    طالما (((الطول(الذيل) مثل طبيعي) % 64) != 56) { ألحق(الذيل, 0 مثل ط8); }
    دع طول_البتات: طبيعي = الحجم * 8;
    دع ع: متغير طبيعي = 0;
    طالما (ع < 8) {
        ألحق(الذيل, ((طول_البتات >> ((7 - ع) * 8)) & 0xFF) مثل ط8);
        ع := ع + 1;
    }
    كتلة := 0;
    طالما (كتلة < (الطول(الذيل) مثل طبيعي)) {
        اضغط_كتلة_شا256(&متغير الحالة, &متغير و, &الثوابت, &الذيل, كتلة);
        كتلة := كتلة + 64;
    }

    دع الخرج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 8) { ألحق_كلمة_هاش(&متغير الخرج, الحالة[ف]); ف := ف + 1; }
    أرجع الخرج;
}

// The subtraction check prevents overflow in start + length.
عام عرف شا256_لمدى(
    المصدر: &متجه ط8, البداية: طبيعي, الحجم: طبيعي
): اختياري متجه ط8 {
    دع طول_المصدر: طبيعي = الطول(*المصدر) مثل طبيعي;
    إذا (البداية > طول_المصدر || الحجم > طول_المصدر - البداية) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(شا256_المجال_المتحقق(المصدر, البداية, الحجم));
}

عام عرف شا256(المصدر: &متجه ط8): متجه ط8 {
    أرجع شا256_المجال_المتحقق(المصدر, 0, الطول(*المصدر) مثل طبيعي);
}

عام عرف هاش_متساوي_بزمن_ثابت(أ: &متجه ط8, ب: &متجه ط8): منطقي {
    أرجع بايتات_متساوية_بزمن_ثابت_تشفير(أ, ب);
}

عام مرادف sha256 = شا256;
عام مرادف constant_time_digest_equal = هاش_متساوي_بزمن_ثابت;
عام مرادف sha256_range = شا256_لمدى;
