// SHA-256 and HMAC-SHA-256 are implemented entirely in std. The implementation
// operates on bytes and owns no target/runtime policy.

عرف دور_يمين_غ32(القيمة: غير_موقع, المقدار: غير_موقع): غير_موقع {
    دع ق: غير_موقع = القيمة % 4294967296;
    دع م: غير_موقع = المقدار % 32;
    لو (م == 0) { أرجع ق; };
    دع يمين: غير_موقع = ق >> م;
    دع إزاحة_يسار: غير_موقع = 32 - م;
    دع مزاح_يسار: غير_موقع = ق << إزاحة_يسار;
    دع يسار: غير_موقع = مزاح_يسار % 4294967296;
    أرجع (يمين | يسار) % 4294967296;
}

عرف اجمع_غ32(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    أرجع (أ + ب) % 4294967296;
}

عرف ألحق_بايت_هاش(البايتات: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    دع ب: متغير متجه غ8 = *البايتات;
    ألحق(ب, (القيمة % 256) مثل غ8);
    *البايتات := ب;
}

عام عرف شا256(المصدر: &متجه غ8): متجه غ8 {
    دع المدخل: متجه غ8 = *المصدر;
    دع الحجم: غير_موقع = الطول(المدخل) مثل غير_موقع;
    دع م: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق(م, المدخل[ف]); ف := ف + 1; }
    ألحق(م, 0x80 مثل غ8);
    بينما (((الطول(م) مثل غير_موقع) % 64) != 56) { ألحق(م, 0 مثل غ8); }

    دع طول_البتات: غير_موقع = الحجم * 8;
    دع ع: متغير غير_موقع = 0;
    بينما (ع < 8) {
        دع إزاحة: غير_موقع = 7 - ع;
        دع قاسم: متغير غير_موقع = 1;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < إزاحة) { قاسم := قاسم * 256; ك := ك + 1; }
        ألحق(م, ((طول_البتات / قاسم) % 256) مثل غ8);
        ع := ع + 1;
    }

    دع الثوابت: متجه غير_موقع = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2
    ];
    دع ه0: متغير غير_موقع = 0x6A09E667;
    دع ه1: متغير غير_موقع = 0xBB67AE85;
    دع ه2: متغير غير_موقع = 0x3C6EF372;
    دع ه3: متغير غير_موقع = 0xA54FF53A;
    دع ه4: متغير غير_موقع = 0x510E527F;
    دع ه5: متغير غير_موقع = 0x9B05688C;
    دع ه6: متغير غير_موقع = 0x1F83D9AB;
    دع ه7: متغير غير_موقع = 0x5BE0CD19;

    دع كتلة: متغير غير_موقع = 0;
    بينما (كتلة < (الطول(م) مثل غير_موقع)) {
        دع و: متغير متجه غير_موقع = [];
        ف := 0;
        بينما (ف < 64) { ألحق(و, 0); ف := ف + 1; }
        ف := 0;
        بينما (ف < 16) {
            دع موضع: غير_موقع = كتلة + ف * 4;
            دع موضع1: غير_موقع = موضع + 1;
            دع موضع2: غير_موقع = موضع + 2;
            دع موضع3: غير_موقع = موضع + 3;
            دع ب0: غير_موقع = م[موضع] مثل غير_موقع;
            دع ب1: غير_موقع = م[موضع1] مثل غير_موقع;
            دع ب2: غير_موقع = م[موضع2] مثل غير_موقع;
            دع ب3: غير_موقع = م[موضع3] مثل غير_موقع;
            و[ف] := (ب0 * 16777216) + (ب1 * 65536) + (ب2 * 256) + ب3;
            ف := ف + 1;
        }
        بينما (ف < 64) {
            دع ف_15: غير_موقع = ف - 15;
            دع ف_2: غير_موقع = ف - 2;
            دع ف_16: غير_موقع = ف - 16;
            دع ف_7: غير_موقع = ف - 7;
            دع س0: غير_موقع = دور_يمين_غ32(و[ف_15], 7)
                ^ دور_يمين_غ32(و[ف_15], 18)
                ^ (و[ف_15] >> 3);
            دع س1: غير_موقع = دور_يمين_غ32(و[ف_2], 17)
                ^ دور_يمين_غ32(و[ف_2], 19)
                ^ (و[ف_2] >> 10);
            و[ف] := اجمع_غ32(اجمع_غ32(اجمع_غ32(و[ف_16], س0), و[ف_7]), س1);
            ف := ف + 1;
        }

        دع أ: متغير غير_موقع = ه0; دع ب: متغير غير_موقع = ه1;
        دع ج: متغير غير_موقع = ه2; دع د: متغير غير_موقع = ه3;
        دع هـ: متغير غير_موقع = ه4; دع و5: متغير غير_موقع = ه5;
        دع ز: متغير غير_موقع = ه6; دع ح: متغير غير_موقع = ه7;
        ف := 0;
        بينما (ف < 64) {
            دع س1أ: غير_موقع = دور_يمين_غ32(هـ, 6) ^ دور_يمين_غ32(هـ, 11) ^ دور_يمين_غ32(هـ, 25);
            دع هـ_و5: غير_موقع = هـ & و5;
            دع مقلوب_هـ: غير_موقع = هـ ^ 0xFFFFFFFF;
            دع مقلوب_هـ_ز: غير_موقع = مقلوب_هـ & ز;
            دع اختيار_هـ: غير_موقع = هـ_و5 ^ مقلوب_هـ_ز;
            دع مؤقت1: غير_موقع = اجمع_غ32(اجمع_غ32(اجمع_غ32(اجمع_غ32(ح, س1أ), اختيار_هـ), الثوابت[ف]), و[ف]);
            دع س0أ: غير_موقع = دور_يمين_غ32(أ, 2) ^ دور_يمين_غ32(أ, 13) ^ دور_يمين_غ32(أ, 22);
            دع أ_ب: غير_موقع = أ & ب;
            دع أ_ج: غير_موقع = أ & ج;
            دع ب_ج: غير_موقع = ب & ج;
            دع غالبية: غير_موقع = أ_ب ^ أ_ج ^ ب_ج;
            دع مؤقت2: غير_موقع = اجمع_غ32(س0أ, غالبية);
            ح := ز; ز := و5; و5 := هـ; هـ := اجمع_غ32(د, مؤقت1);
            د := ج; ج := ب; ب := أ; أ := اجمع_غ32(مؤقت1, مؤقت2);
            ف := ف + 1;
        }
        ه0 := اجمع_غ32(ه0, أ); ه1 := اجمع_غ32(ه1, ب);
        ه2 := اجمع_غ32(ه2, ج); ه3 := اجمع_غ32(ه3, د);
        ه4 := اجمع_غ32(ه4, هـ); ه5 := اجمع_غ32(ه5, و5);
        ه6 := اجمع_غ32(ه6, ز); ه7 := اجمع_غ32(ه7, ح);
        كتلة := كتلة + 64;
    }

    دع الخرج: متغير متجه غ8 = [];
    دع الحالات: متجه غير_موقع = [ه0,ه1,ه2,ه3,ه4,ه5,ه6,ه7];
    ف := 0;
    بينما (ف < 8) {
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 16777216);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 65536);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف] / 256);
        ألحق_بايت_هاش(&متغير الخرج, الحالات[ف]);
        ف := ف + 1;
    }
    أرجع الخرج;
}

عام عرف هاش_متساوي_بزمن_ثابت(أ: &متجه غ8, ب: &متجه غ8): منطقي {
    دع س: متجه غ8 = *أ;
    دع ص: متجه غ8 = *ب;
    لو ((الطول(س) مثل غير_موقع) != (الطول(ص) مثل غير_موقع)) { أرجع خطأ; };
    دع فرق: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(س) مثل غير_موقع)) {
        فرق := فرق | ((س[ف] مثل غير_موقع) ^ (ص[ف] مثل غير_موقع));
        ف := ف + 1;
    }
    أرجع فرق == 0;
}

عام عرف هماك_شا256(المفتاح: &متجه غ8, الرسالة: &متجه غ8): متجه غ8 {
    دع ك_أصلي: متجه غ8 = *المفتاح;
    دع ك: متغير متجه غ8 = [];
    لو ((الطول(ك_أصلي) مثل غير_موقع) > 64) {
        ك := شا256(&ك_أصلي);
    } وإلا {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ك_أصلي) مثل غير_موقع)) { ألحق(ك, ك_أصلي[ف]); ف := ف + 1; }
    };
    بينما ((الطول(ك) مثل غير_موقع) < 64) { ألحق(ك, 0 مثل غ8); }

    دع داخلي: متغير متجه غ8 = [];
    دع وسادة_خارجية: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 64) {
        ألحق(داخلي, (((ك[ف] مثل غير_موقع) ^ 0x36) % 256) مثل غ8);
        ألحق(وسادة_خارجية, (((ك[ف] مثل غير_موقع) ^ 0x5C) % 256) مثل غ8);
        ف := ف + 1;
    }
    دع ر: متجه غ8 = *الرسالة;
    ف := 0;
    بينما (ف < (الطول(ر) مثل غير_موقع)) { ألحق(داخلي, ر[ف]); ف := ف + 1; }
    دع هاش_داخلي: متجه غ8 = شا256(&داخلي);
    ف := 0;
    بينما (ف < (الطول(هاش_داخلي) مثل غير_موقع)) { ألحق(وسادة_خارجية, هاش_داخلي[ف]); ف := ف + 1; }
    أرجع شا256(&وسادة_خارجية);
}


عام عرف هكدف_شا256_استخرج(الملح: &متجه غ8, مادة_المفتاح: &متجه غ8): متجه غ8 {
    دع قيمة_الملح: متجه غ8 = *الملح;
    لو ((الطول(قيمة_الملح) مثل غير_موقع) == 0) {
        دع أصفار: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < 32) { ألحق(أصفار, 0); ف := ف + 1; }
        أرجع هماك_شا256(&أصفار, مادة_المفتاح);
    };
    أرجع هماك_شا256(&قيمة_الملح, مادة_المفتاح);
}

عام عرف هكدف_شا256_وسع(المفتاح_الكاذب: &متجه غ8, المعلومات: &متجه غ8, الطول_المطلوب: غير_موقع): اختيار متجه غ8 {
    لو (الطول_المطلوب > 8160) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع السابق: متغير متجه غ8 = [];
    دع العداد: متغير غير_موقع = 1;
    بينما ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب) {
        دع الرسالة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(السابق) مثل غير_موقع)) { ألحق(الرسالة, السابق[ف]); ف := ف + 1; }
        دع سياق: متجه غ8 = *المعلومات;
        ف := 0;
        بينما (ف < (الطول(سياق) مثل غير_موقع)) { ألحق(الرسالة, سياق[ف]); ف := ف + 1; }
        ألحق(الرسالة, العداد مثل غ8);
        السابق := هماك_شا256(المفتاح_الكاذب, &الرسالة);
        ف := 0;
        بينما ((ف < (الطول(السابق) مثل غير_موقع)) && ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب)) {
            ألحق(الناتج, السابق[ف]);
            ف := ف + 1;
        }
        العداد := العداد + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام عرف هكدف_شا256(الملح: &متجه غ8, مادة_المفتاح: &متجه غ8, المعلومات: &متجه غ8, الطول_المطلوب: غير_موقع): اختيار متجه غ8 {
    دع المفتاح_الكاذب: متجه غ8 = هكدف_شا256_استخرج(الملح, مادة_المفتاح);
    أرجع هكدف_شا256_وسع(&المفتاح_الكاذب, المعلومات, الطول_المطلوب);
}

عام مرادف sha256 = شا256;
عام مرادف constant_time_digest_equal = هاش_متساوي_بزمن_ثابت;
عام مرادف hmac_sha256 = هماك_شا256;
عام مرادف hkdf_sha256_extract = هكدف_شا256_استخرج;
عام مرادف hkdf_sha256_expand = هكدف_شا256_وسع;
عام مرادف hkdf_sha256 = هكدف_شا256;

// PBKDF2-HMAC-SHA256. Callers own password/salt policy; this function only
// performs the standard derivation and rejects zero iterations/oversized output.
عام عرف ببدف2_هماك_شا256(
    كلمة_المرور: &متجه غ8,
    الملح: &متجه غ8,
    التكرارات: غير_موقع,
    الطول_المطلوب: غير_موقع
): اختيار متجه غ8 {
    لو (التكرارات == 0) { أرجع اختيار.لا_شيء(); };
    لو (الطول_المطلوب > 137438953440) { أرجع اختيار.لا_شيء(); };
    لو (الطول_المطلوب == 0) {
        دع فارغ: متجه غ8 = [];
        أرجع اختيار.بعض(فارغ);
    };

    دع الناتج: متغير متجه غ8 = [];
    دع مقرب_الطول: غير_موقع = الطول_المطلوب + 31;
    دع عدد_الكتل: غير_موقع = مقرب_الطول / 32;
    دع رقم_الكتلة: متغير غير_موقع = 1;
    بينما (رقم_الكتلة <= عدد_الكتل) {
        دع رسالة: متغير متجه غ8 = [];
        دع س: متجه غ8 = *الملح;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(س) مثل غير_موقع)) { ألحق(رسالة, س[ف]); ف := ف + 1; }
        ألحق(رسالة, ((رقم_الكتلة >> 24) & 0xFF) مثل غ8);
        ألحق(رسالة, ((رقم_الكتلة >> 16) & 0xFF) مثل غ8);
        ألحق(رسالة, ((رقم_الكتلة >> 8) & 0xFF) مثل غ8);
        ألحق(رسالة, (رقم_الكتلة & 0xFF) مثل غ8);

        دع يو: متغير متجه غ8 = هماك_شا256(كلمة_المرور, &رسالة);
        دع كتلة: متغير متجه غ8 = [];
        ف := 0;
        بينما (ف < 32) { ألحق(كتلة, يو[ف]); ف := ف + 1; }

        دع الجولة: متغير غير_موقع = 1;
        بينما (الجولة < التكرارات) {
            يو := هماك_شا256(كلمة_المرور, &يو);
            ف := 0;
            بينما (ف < 32) {
                كتلة[ف] := كتلة[ف] ^ يو[ف];
                ف := ف + 1;
            }
            الجولة := الجولة + 1;
        }

        ف := 0;
        بينما ((ف < 32) && ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب)) {
            ألحق(الناتج, كتلة[ف]);
            ف := ف + 1;
        }
        رقم_الكتلة := رقم_الكتلة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام مرادف pbkdf2_hmac_sha256 = ببدف2_هماك_شا256;
