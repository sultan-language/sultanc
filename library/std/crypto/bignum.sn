// Fixed-width multiprecision arithmetic for RSA and elliptic curves.
//
// Numbers are vectors of 32-bit limbs (least significant first) held in
// غير_موقع, so every limb product plus two carries fits in 64 bits:
// (2^32-1)^2 + 2(2^32-1) = 2^64-1. Modular arithmetic uses Montgomery
// multiplication (Montgomery 1985; REDC as in Handbook of Applied
// Cryptography 14.32) over a fixed limb count: products, reductions, carry
// propagation, final subtractions and exponent-table selection run the same
// operations for every value, so private keys and nonces are not exposed
// through timing. Only lengths (public) shape the control flow.

استورد crypto.words;

عام نوع سياق_مونتغمري = {
    المعامل: متجه غير_موقع,
    العدد: غير_موقع,
    المعكوس: غير_موقع,
    مربع_ر: متجه غير_موقع
};

عام عرف أطراف_صفرية_كبير(العدد: غير_موقع): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, 0);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Big-endian bytes into exactly العدد limbs; none when the value does not fit.
عام عرف عدد_كبير_من_بايتات(البايتات: &متجه غ8, العدد: غير_موقع): اختيار متجه غير_موقع {
    دع الحجم: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    بينما (البداية < الحجم && (*البايتات)[البداية] == 0) { البداية := البداية + 1; }
    لو (الحجم - البداية > العدد * 4) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غير_موقع = أطراف_صفرية_كبير(العدد);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم - البداية) {
        دع الموضع: غير_موقع = الحجم - 1 - ف;
        دع ب: غير_موقع = (*البايتات)[الموضع] مثل غير_موقع;
        دع الطرف: غير_موقع = ف / 4;
        الناتج[الطرف] := الناتج[الطرف] | (ب << ((ف % 4) * 8));
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// The low الطول bytes of the value, big-endian.
عام عرف بايتات_من_عدد_كبير(الأطراف: &متجه غير_موقع, الطول_المطلوب: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = أصفار_تشفير(الطول_المطلوب);
    دع العدد: غير_موقع = الطول(*الأطراف) مثل غير_موقع;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الطول_المطلوب) {
        دع الطرف: غير_موقع = ف / 4;
        لو (الطرف < العدد) {
            دع ب: غير_موقع = ((*الأطراف)[الطرف] >> ((ف % 4) * 8)) & 0xFF;
            الناتج[الطول_المطلوب - 1 - ف] := ب مثل غ8;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف طول_بتات_كبير(الأطراف: &متجه غير_موقع): غير_موقع {
    دع ف: متغير غير_موقع = الطول(*الأطراف) مثل غير_موقع;
    بينما (ف > 0) {
        دع الطرف: غير_موقع = (*الأطراف)[ف - 1];
        لو (الطرف != 0) {
            دع البتات: متغير غير_موقع = 0;
            دع ق: متغير غير_موقع = الطرف;
            بينما (ق != 0) {
                البتات := البتات + 1;
                ق := ق >> 1;
            }
            أرجع (ف - 1) * 32 + البتات;
        };
        ف := ف - 1;
    }
    أرجع 0;
}

عام عرف بت_كبير(الأطراف: &متجه غير_موقع, الموضع: غير_موقع): غير_موقع {
    دع الطرف: غير_موقع = الموضع / 32;
    لو (الطرف >= (الطول(*الأطراف) مثل غير_موقع)) { أرجع 0; };
    أرجع ((*الأطراف)[الطرف] >> (الموضع % 32)) & 1;
}

عام عرف هل_صفر_كبير(الأطراف: &متجه غير_موقع): منطقي {
    دع التجميع: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الأطراف) مثل غير_موقع)) {
        التجميع := التجميع | (*الأطراف)[ف];
        ف := ف + 1;
    }
    أرجع التجميع == 0;
}

عرف طرف_أو_صفر_كبير(الأطراف: &متجه غير_موقع, الموضع: غير_موقع): غير_موقع {
    لو (الموضع < (الطول(*الأطراف) مثل غير_موقع)) { أرجع (*الأطراف)[الموضع]; };
    أرجع 0;
}

// -1, 0 or 1. Variable time: for public values only.
عام عرف قارن_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع): عدد {
    دع الحجم: متغير غير_موقع = الطول(*أ) مثل غير_موقع;
    لو ((الطول(*ب) مثل غير_موقع) > الحجم) { الحجم := الطول(*ب) مثل غير_موقع; };
    دع ف: متغير غير_موقع = الحجم;
    بينما (ف > 0) {
        دع س: غير_موقع = طرف_أو_صفر_كبير(أ, ف - 1);
        دع ص: غير_موقع = طرف_أو_صفر_كبير(ب, ف - 1);
        لو (س > ص) { أرجع 1; };
        لو (س < ص) { أرجع -1; };
        ف := ف - 1;
    }
    أرجع 0;
}

// Full product with length len(أ) + len(ب).
عام عرف اضرب_كامل_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع): متجه غير_موقع {
    دع عدد_أ: غير_موقع = الطول(*أ) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(*ب) مثل غير_موقع;
    دع ت: متغير متجه غير_موقع = أطراف_صفرية_كبير(عدد_أ + عدد_ب);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_أ) {
        دع الحمل: متغير غير_موقع = 0;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < عدد_ب) {
            دع س: غير_موقع = ت[ف + ك] + (*أ)[ف] * (*ب)[ك] + الحمل;
            ت[ف + ك] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            ك := ك + 1;
        }
        ت[ف + عدد_ب] := الحمل;
        ف := ف + 1;
    }
    أرجع ت;
}

// Sum with length max(len) + 1.
عام عرف اجمع_كامل_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع): متجه غير_موقع {
    دع الحجم: متغير غير_موقع = الطول(*أ) مثل غير_موقع;
    لو ((الطول(*ب) مثل غير_موقع) > الحجم) { الحجم := الطول(*ب) مثل غير_موقع; };
    دع الناتج: متغير متجه غير_موقع = [];
    دع الحمل: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) {
        دع س: غير_موقع = طرف_أو_صفر_كبير(أ, ف) + طرف_أو_صفر_كبير(ب, ف) + الحمل;
        ألحق(الناتج, س & 0xFFFFFFFF);
        الحمل := س >> 32;
        ف := ف + 1;
    }
    ألحق(الناتج, الحمل);
    أرجع الناتج;
}

// أ - ب over العدد limbs; the borrow (0 or 1) is the extra last limb.
عرف اطرح_بإقراض_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع, العدد: غير_موقع): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع الاقتراض: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع س: غير_موقع = طرف_أو_صفر_كبير(أ, ف) + 4294967296 - طرف_أو_صفر_كبير(ب, ف) - الاقتراض;
        ألحق(الناتج, س & 0xFFFFFFFF);
        الاقتراض := 1 - (س >> 32);
        ف := ف + 1;
    }
    ألحق(الناتج, الاقتراض);
    أرجع الناتج;
}

عرف أول_أطراف_كبير(الأطراف: &متجه غير_موقع, العدد: غير_موقع): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, طرف_أو_صفر_كبير(الأطراف, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Returns أ when الشرط is 1 and ب when it is 0, limb by limb (العدد limbs).
عام عرف اختر_أطراف_كبير(الشرط: غير_موقع, أ: &متجه غير_موقع, ب: &متجه غير_موقع, العدد: غير_موقع): متجه غير_موقع {
    دع الناتج: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(الناتج, اختر32_تشفير(الشرط, طرف_أو_صفر_كبير(أ, ف), طرف_أو_صفر_كبير(ب, ف)));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A value below 2m held in العدد limbs plus an overflow bit, reduced below m.
عرف اطرح_المعامل_شرطيا_كبير(القيمة: &متجه غير_موقع, الفائض: غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع العدد: غير_موقع = (*السياق).العدد;
    دع الفرق: متجه غير_موقع = اطرح_بإقراض_كبير(القيمة, &(*السياق).المعامل, العدد);
    دع الاقتراض: غير_موقع = الفرق[العدد];
    // Subtract when the true value (overflow * 2^(32n) + value) is at least m.
    دع اطرح: غير_موقع = الفائض | (1 - الاقتراض);
    أرجع اختر_أطراف_كبير(اطرح, &الفرق, القيمة, العدد);
}

// Montgomery reduction of ت (at most 2n limbs, value below m * R): ت * R^-1 mod m.
عرف اختزل_مونتغمري(المدخل: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع العدد: غير_موقع = (*السياق).العدد;
    دع ت: متغير متجه غير_موقع = أطراف_صفرية_كبير(2 * العدد + 1);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*المدخل) مثل غير_موقع) && ف < 2 * العدد) {
        ت[ف] := (*المدخل)[ف];
        ف := ف + 1;
    }
    ف := 0;
    بينما (ف < العدد) {
        دع يو: غير_موقع = (ت[ف] * (*السياق).المعكوس) & 0xFFFFFFFF;
        دع الحمل: متغير غير_موقع = 0;
        دع ك: متغير غير_موقع = 0;
        بينما (ك < العدد) {
            دع س: غير_موقع = ت[ف + ك] + يو * (*السياق).المعامل[ك] + الحمل;
            ت[ف + ك] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            ك := ك + 1;
        }
        دع م: متغير غير_موقع = ف + العدد;
        بينما (م <= 2 * العدد) {
            دع س: غير_موقع = ت[م] + الحمل;
            ت[م] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            م := م + 1;
        }
        ف := ف + 1;
    }
    دع النتيجة: متغير متجه غير_موقع = [];
    ف := 0;
    بينما (ف < العدد) {
        ألحق(النتيجة, ت[العدد + ف]);
        ف := ف + 1;
    }
    أرجع اطرح_المعامل_شرطيا_كبير(&النتيجة, ت[2 * العدد], السياق);
}

عام عرف اضرب_مونتغمري(أ: &متجه غير_موقع, ب: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع الجداء: متجه غير_موقع = اضرب_كامل_كبير(أ, ب);
    أرجع اختزل_مونتغمري(&الجداء, السياق);
}

// Montgomery context for an odd modulus above 1 (big-endian bytes).
عام عرف أنشئ_سياق_مونتغمري(المعامل: &متجه غ8): اختيار سياق_مونتغمري {
    دع الحجم: متغير غير_موقع = الطول(*المعامل) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    بينما (البداية < الحجم && (*المعامل)[البداية] == 0) { البداية := البداية + 1; }
    لو (البداية == الحجم) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = (الحجم - البداية + 3) / 4;
    دع الأطراف: متجه غير_موقع;
    طابق عدد_كبير_من_بايتات(المعامل, العدد) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { الأطراف := القيمة; };
    دع م0: غير_موقع = الأطراف[0];
    لو ((م0 & 1) == 0) { أرجع اختيار.لا_شيء(); };
    لو (العدد == 1 && م0 == 1) { أرجع اختيار.لا_شيء(); };
    // Newton iteration for m0^-1 mod 2^32; m0 is its own inverse mod 8.
    دع س: متغير غير_موقع = م0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 5) {
        دع ت: غير_موقع = (م0 * س) & 0xFFFFFFFF;
        س := (س * ((2 + 4294967296 - ت) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        ف := ف + 1;
    }
    دع المعكوس: غير_موقع = (4294967296 - س) & 0xFFFFFFFF;

    دع السياق_الأولي: سياق_مونتغمري = {
        المعامل: الأطراف,
        العدد: العدد,
        المعكوس: المعكوس,
        مربع_ر: أطراف_صفرية_كبير(العدد)
    };
    // R^2 mod m by 64n modular doublings of 1.
    دع ر: متغير متجه غير_موقع = أطراف_صفرية_كبير(العدد);
    ر[0] := 1;
    ف := 0;
    بينما (ف < 64 * العدد) {
        دع المضاعف: متجه غير_موقع = اجمع_كامل_كبير(&ر, &ر);
        دع الفائض: غير_موقع = المضاعف[العدد];
        ر := اطرح_المعامل_شرطيا_كبير(&المضاعف, الفائض, &السياق_الأولي);
        ف := ف + 1;
    }
    دع النهائي: متغير سياق_مونتغمري = السياق_الأولي;
    النهائي.مربع_ر := ر;
    أرجع اختيار.بعض(النهائي);
}

عام عرف إلى_مونتغمري(أ: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    أرجع اضرب_مونتغمري(أ, &(*السياق).مربع_ر, السياق);
}

عام عرف من_مونتغمري(أ: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    أرجع اختزل_مونتغمري(أ, السياق);
}

// أ mod m for أ below m * R (at most 2n limbs).
عام عرف اختزل_كبير(أ: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع المختزل: متجه غير_موقع = اختزل_مونتغمري(أ, السياق);
    أرجع اضرب_مونتغمري(&المختزل, &(*السياق).مربع_ر, السياق);
}

// أ mod m for أ (n limbs) below 2m.
عام عرف اختزل_أقل_من_ضعف_كبير(أ: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    أرجع اطرح_المعامل_شرطيا_كبير(أ, 0, السياق);
}

// (أ + ب) mod m for أ, ب below m.
عام عرف اجمع_معياري_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع العدد: غير_موقع = (*السياق).العدد;
    دع المجموع: متجه غير_موقع = اجمع_كامل_كبير(أ, ب);
    أرجع اطرح_المعامل_شرطيا_كبير(&المجموع, المجموع[العدد], السياق);
}

// (أ - ب) mod m for أ, ب below m.
عام عرف اطرح_معياري_كبير(أ: &متجه غير_موقع, ب: &متجه غير_موقع, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع العدد: غير_موقع = (*السياق).العدد;
    دع الفرق: متجه غير_موقع = اطرح_بإقراض_كبير(أ, ب, العدد);
    دع الاقتراض: غير_موقع = الفرق[العدد];
    دع المعامل_المقنع: متغير متجه غير_موقع = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(المعامل_المقنع, (*السياق).المعامل[ف] & (الاقتراض * 0xFFFFFFFF));
        ف := ف + 1;
    }
    دع المصحح: متجه غير_موقع = اجمع_كامل_كبير(&الفرق, &المعامل_المقنع);
    أرجع أول_أطراف_كبير(&المصحح, العدد);
}

// الأساس^الأس mod m. الأساس is below m in normal form; الأس is big-endian.
// Fixed 4-bit windows: four squarings and one multiplication by a table entry
// chosen by scanning all sixteen entries with masks.
عام عرف أس_معياري_كبير(الأساس: &متجه غير_موقع, الأس: &متجه غ8, السياق: &سياق_مونتغمري): متجه غير_موقع {
    دع العدد: غير_موقع = (*السياق).العدد;
    دع واحد: متغير متجه غير_موقع = أطراف_صفرية_كبير(العدد);
    واحد[0] := 1;
    دع الجدول: متغير متجه متجه غير_موقع = [];
    ألحق(الجدول, إلى_مونتغمري(&واحد, السياق));
    ألحق(الجدول, إلى_مونتغمري(الأساس, السياق));
    دع ف: متغير غير_موقع = 2;
    بينما (ف < 16) {
        دع التالي: متجه غير_موقع = اضرب_مونتغمري(&الجدول[ف - 1], &الجدول[1], السياق);
        ألحق(الجدول, التالي);
        ف := ف + 1;
    }
    دع المجمع: متغير متجه غير_موقع = إلى_مونتغمري(&واحد, السياق);
    دع الحجم: غير_موقع = الطول(*الأس) مثل غير_موقع;
    دع ب: متغير غير_موقع = 0;
    بينما (ب < 2 * الحجم) {
        دع البايت: غير_موقع = (*الأس)[ب / 2] مثل غير_موقع;
        دع النافذة: متغير غير_موقع = البايت & 0x0F;
        لو ((ب % 2) == 0) { النافذة := البايت >> 4; };
        دع ر: متغير غير_موقع = 0;
        بينما (ر < 4) {
            المجمع := اضرب_مونتغمري(&المجمع, &المجمع, السياق);
            ر := ر + 1;
        }
        دع المختار: متغير متجه غير_موقع = أطراف_صفرية_كبير(العدد);
        دع م: متغير غير_موقع = 0;
        بينما (م < 16) {
            دع مطابق: غير_موقع = 1 - ليس_صفرا32_تشفير(م ^ النافذة);
            المختار := اختر_أطراف_كبير(مطابق, &الجدول[م], &المختار, العدد);
            م := م + 1;
        }
        المجمع := اضرب_مونتغمري(&المجمع, &المختار, السياق);
        ب := ب + 1;
    }
    أرجع من_مونتغمري(&المجمع, السياق);
}

// The big-endian bytes of the modulus minus a small value (for Fermat inverses).
عام عرف معامل_ناقص_كبير(السياق: &سياق_مونتغمري, المطروح: غير_موقع, الطول_المطلوب: غير_موقع): متجه غ8 {
    دع الصغير: متغير متجه غير_موقع = أطراف_صفرية_كبير((*السياق).العدد);
    الصغير[0] := المطروح;
    دع الفرق: متجه غير_موقع = اطرح_بإقراض_كبير(&(*السياق).المعامل, &الصغير, (*السياق).العدد);
    أرجع بايتات_من_عدد_كبير(&الفرق, الطول_المطلوب);
}

عام مرادف montgomery_context = سياق_مونتغمري;
عام مرادف bignum_from_bytes = عدد_كبير_من_بايتات;
عام مرادف bignum_to_bytes = بايتات_من_عدد_كبير;
عام مرادف montgomery_new = أنشئ_سياق_مونتغمري;
عام مرادف modular_exponent = أس_معياري_كبير;
