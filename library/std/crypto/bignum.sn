// Fixed-width multiprecision arithmetic for RSA and elliptic curves.
//
// Numbers are vectors of 32-bit limbs (least significant first) held in
// طبيعي, so every limb product plus two carries fits in 64 bits:
// (2^32-1)^2 + 2(2^32-1) = 2^64-1. Modular arithmetic uses Montgomery
// multiplication (Montgomery 1985; REDC as in Handbook of Applied
// Cryptography 14.32) over a fixed limb count: products, reductions, carry
// propagation, final subtractions and exponent-table selection run the same
// operations for every value, so private keys and nonces are not exposed
// through timing. Only lengths (public) shape the control flow.

استورد crypto.words;

عام نوع سياق_مونتغمري = {
    المعامل: متجه طبيعي,
    العدد: طبيعي,
    المعكوس: طبيعي,
    مربع_ر: متجه طبيعي
};

عام عرف أطراف_صفرية_كبير(العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, 0);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Big-endian bytes into exactly العدد limbs; none when the value does not fit.
عام عرف عدد_كبير_من_بايتات(البايتات: &متجه ط8, العدد: طبيعي): اختياري متجه طبيعي {
    دع الحجم: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < الحجم && (*البايتات)[البداية] == 0) { البداية := البداية + 1; }
    لو (الحجم - البداية > العدد * 4) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه طبيعي = أطراف_صفرية_كبير(العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم - البداية) {
        دع الموضع: طبيعي = الحجم - 1 - ف;
        دع ب: طبيعي = (*البايتات)[الموضع] مثل طبيعي;
        دع الطرف: طبيعي = ف / 4;
        الناتج[الطرف] := الناتج[الطرف] | (ب << ((ف % 4) * 8));
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// The low الطول bytes of the value, big-endian.
عام عرف بايتات_من_عدد_كبير(الأطراف: &متجه طبيعي, الطول_المطلوب: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = أصفار_تشفير(الطول_المطلوب);
    دع العدد: طبيعي = الطول(*الأطراف) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        دع الطرف: طبيعي = ف / 4;
        لو (الطرف < العدد) {
            دع ب: طبيعي = ((*الأطراف)[الطرف] >> ((ف % 4) * 8)) & 0xFF;
            الناتج[الطول_المطلوب - 1 - ف] := ب مثل ط8;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف طول_بتات_كبير(الأطراف: &متجه طبيعي): طبيعي {
    دع ف: متغير طبيعي = الطول(*الأطراف) مثل طبيعي;
    طالما (ف > 0) {
        دع الطرف: طبيعي = (*الأطراف)[ف - 1];
        لو (الطرف != 0) {
            دع البتات: متغير طبيعي = 0;
            دع ق: متغير طبيعي = الطرف;
            طالما (ق != 0) {
                البتات := البتات + 1;
                ق := ق >> 1;
            }
            أرجع (ف - 1) * 32 + البتات;
        };
        ف := ف - 1;
    }
    أرجع 0;
}

عام عرف بت_كبير(الأطراف: &متجه طبيعي, الموضع: طبيعي): طبيعي {
    دع الطرف: طبيعي = الموضع / 32;
    لو (الطرف >= (الطول(*الأطراف) مثل طبيعي)) { أرجع 0; };
    أرجع ((*الأطراف)[الطرف] >> (الموضع % 32)) & 1;
}

عام عرف هل_صفر_كبير(الأطراف: &متجه طبيعي): منطقي {
    دع التجميع: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأطراف) مثل طبيعي)) {
        التجميع := التجميع | (*الأطراف)[ف];
        ف := ف + 1;
    }
    أرجع التجميع == 0;
}

عرف طرف_أو_صفر_كبير(الأطراف: &متجه طبيعي, الموضع: طبيعي): طبيعي {
    لو (الموضع < (الطول(*الأطراف) مثل طبيعي)) { أرجع (*الأطراف)[الموضع]; };
    أرجع 0;
}

// -1, 0 or 1. Variable time: for public values only.
عام عرف قارن_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي): عدد {
    دع الحجم: متغير طبيعي = الطول(*أ) مثل طبيعي;
    لو ((الطول(*ب) مثل طبيعي) > الحجم) { الحجم := الطول(*ب) مثل طبيعي; };
    دع ف: متغير طبيعي = الحجم;
    طالما (ف > 0) {
        دع س: طبيعي = طرف_أو_صفر_كبير(أ, ف - 1);
        دع ص: طبيعي = طرف_أو_صفر_كبير(ب, ف - 1);
        لو (س > ص) { أرجع 1; };
        لو (س < ص) { أرجع -1; };
        ف := ف - 1;
    }
    أرجع 0;
}

// Full product with length len(أ) + len(ب).
عام عرف اضرب_كامل_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي): متجه طبيعي {
    دع عدد_أ: طبيعي = الطول(*أ) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*ب) مثل طبيعي;
    دع ت: متغير متجه طبيعي = أطراف_صفرية_كبير(عدد_أ + عدد_ب);
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_أ) {
        دع الحمل: متغير طبيعي = 0;
        دع ك: متغير طبيعي = 0;
        طالما (ك < عدد_ب) {
            دع س: طبيعي = ت[ف + ك] + (*أ)[ف] * (*ب)[ك] + الحمل;
            ت[ف + ك] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            ك := ك + 1;
        }
        ت[ف + عدد_ب] := الحمل;
        ف := ف + 1;
    }
    أرجع ت;
}

// Sum with length max(len) + 1.
عام عرف اجمع_كامل_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي): متجه طبيعي {
    دع الحجم: متغير طبيعي = الطول(*أ) مثل طبيعي;
    لو ((الطول(*ب) مثل طبيعي) > الحجم) { الحجم := الطول(*ب) مثل طبيعي; };
    دع الناتج: متغير متجه طبيعي = [];
    دع الحمل: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) {
        دع س: طبيعي = طرف_أو_صفر_كبير(أ, ف) + طرف_أو_صفر_كبير(ب, ف) + الحمل;
        ألحق(الناتج, س & 0xFFFFFFFF);
        الحمل := س >> 32;
        ف := ف + 1;
    }
    ألحق(الناتج, الحمل);
    أرجع الناتج;
}

// أ - ب over العدد limbs; the borrow (0 or 1) is the extra last limb.
عرف اطرح_بإقراض_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي, العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع الاقتراض: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع س: طبيعي = طرف_أو_صفر_كبير(أ, ف) + 4294967296 - طرف_أو_صفر_كبير(ب, ف) - الاقتراض;
        ألحق(الناتج, س & 0xFFFFFFFF);
        الاقتراض := 1 - (س >> 32);
        ف := ف + 1;
    }
    ألحق(الناتج, الاقتراض);
    أرجع الناتج;
}

عرف أول_أطراف_كبير(الأطراف: &متجه طبيعي, العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, طرف_أو_صفر_كبير(الأطراف, ف));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Returns أ when الشرط is 1 and ب when it is 0, limb by limb (العدد limbs).
عام عرف اختر_أطراف_كبير(الشرط: طبيعي, أ: &متجه طبيعي, ب: &متجه طبيعي, العدد: طبيعي): متجه طبيعي {
    دع الناتج: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, اختر32_تشفير(الشرط, طرف_أو_صفر_كبير(أ, ف), طرف_أو_صفر_كبير(ب, ف)));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// A value below 2m held in العدد limbs plus an overflow bit, reduced below m.
عرف اطرح_المعامل_شرطيا_كبير(القيمة: &متجه طبيعي, الفائض: طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع العدد: طبيعي = (*السياق).العدد;
    دع الفرق: متجه طبيعي = اطرح_بإقراض_كبير(القيمة, &(*السياق).المعامل, العدد);
    دع الاقتراض: طبيعي = الفرق[العدد];
    // Subtract when the true value (overflow * 2^(32n) + value) is at least m.
    دع اطرح: طبيعي = الفائض | (1 - الاقتراض);
    أرجع اختر_أطراف_كبير(اطرح, &الفرق, القيمة, العدد);
}

// Montgomery reduction of ت (at most 2n limbs, value below m * R): ت * R^-1 mod m.
عرف اختزل_مونتغمري(المدخل: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع العدد: طبيعي = (*السياق).العدد;
    دع ت: متغير متجه طبيعي = أطراف_صفرية_كبير(2 * العدد + 1);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المدخل) مثل طبيعي) && ف < 2 * العدد) {
        ت[ف] := (*المدخل)[ف];
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < العدد) {
        دع يو: طبيعي = (ت[ف] * (*السياق).المعكوس) & 0xFFFFFFFF;
        دع الحمل: متغير طبيعي = 0;
        دع ك: متغير طبيعي = 0;
        طالما (ك < العدد) {
            دع س: طبيعي = ت[ف + ك] + يو * (*السياق).المعامل[ك] + الحمل;
            ت[ف + ك] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            ك := ك + 1;
        }
        دع م: متغير طبيعي = ف + العدد;
        طالما (م <= 2 * العدد) {
            دع س: طبيعي = ت[م] + الحمل;
            ت[م] := س & 0xFFFFFFFF;
            الحمل := س >> 32;
            م := م + 1;
        }
        ف := ف + 1;
    }
    دع النتيجة: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        ألحق(النتيجة, ت[العدد + ف]);
        ف := ف + 1;
    }
    أرجع اطرح_المعامل_شرطيا_كبير(&النتيجة, ت[2 * العدد], السياق);
}

عام عرف اضرب_مونتغمري(أ: &متجه طبيعي, ب: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع الجداء: متجه طبيعي = اضرب_كامل_كبير(أ, ب);
    أرجع اختزل_مونتغمري(&الجداء, السياق);
}

// Montgomery context for an odd modulus above 1 (big-endian bytes).
عام عرف أنشئ_سياق_مونتغمري(المعامل: &متجه ط8): اختياري سياق_مونتغمري {
    دع الحجم: متغير طبيعي = الطول(*المعامل) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < الحجم && (*المعامل)[البداية] == 0) { البداية := البداية + 1; }
    لو (البداية == الحجم) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = (الحجم - البداية + 3) / 4;
    دع الأطراف: متجه طبيعي;
    طابق عدد_كبير_من_بايتات(المعامل, العدد) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { الأطراف := القيمة; };
    دع م0: طبيعي = الأطراف[0];
    لو ((م0 & 1) == 0) { أرجع اختياري.لا_شيء(); };
    لو (العدد == 1 && م0 == 1) { أرجع اختياري.لا_شيء(); };
    // Newton iteration for m0^-1 mod 2^32; m0 is its own inverse mod 8.
    دع س: متغير طبيعي = م0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 5) {
        دع ت: طبيعي = (م0 * س) & 0xFFFFFFFF;
        س := (س * ((2 + 4294967296 - ت) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        ف := ف + 1;
    }
    دع المعكوس: طبيعي = (4294967296 - س) & 0xFFFFFFFF;

    دع السياق_الأولي: سياق_مونتغمري = {
        المعامل: الأطراف,
        العدد: العدد,
        المعكوس: المعكوس,
        مربع_ر: أطراف_صفرية_كبير(العدد)
    };
    // R^2 mod m by 64n modular doublings of 1.
    دع ر: متغير متجه طبيعي = أطراف_صفرية_كبير(العدد);
    ر[0] := 1;
    ف := 0;
    طالما (ف < 64 * العدد) {
        دع المضاعف: متجه طبيعي = اجمع_كامل_كبير(&ر, &ر);
        دع الفائض: طبيعي = المضاعف[العدد];
        ر := اطرح_المعامل_شرطيا_كبير(&المضاعف, الفائض, &السياق_الأولي);
        ف := ف + 1;
    }
    دع النهائي: متغير سياق_مونتغمري = السياق_الأولي;
    النهائي.مربع_ر := ر;
    أرجع اختياري.موجود(النهائي);
}

عام عرف إلى_مونتغمري(أ: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    أرجع اضرب_مونتغمري(أ, &(*السياق).مربع_ر, السياق);
}

عام عرف من_مونتغمري(أ: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    أرجع اختزل_مونتغمري(أ, السياق);
}

// أ mod m for أ below m * R (at most 2n limbs).
عام عرف اختزل_كبير(أ: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع المختزل: متجه طبيعي = اختزل_مونتغمري(أ, السياق);
    أرجع اضرب_مونتغمري(&المختزل, &(*السياق).مربع_ر, السياق);
}

// أ mod m for أ (n limbs) below 2m.
عام عرف اختزل_أقل_من_ضعف_كبير(أ: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    أرجع اطرح_المعامل_شرطيا_كبير(أ, 0, السياق);
}

// (أ + ب) mod m for أ, ب below m.
عام عرف اجمع_معياري_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع العدد: طبيعي = (*السياق).العدد;
    دع المجموع: متجه طبيعي = اجمع_كامل_كبير(أ, ب);
    أرجع اطرح_المعامل_شرطيا_كبير(&المجموع, المجموع[العدد], السياق);
}

// (أ - ب) mod m for أ, ب below m.
عام عرف اطرح_معياري_كبير(أ: &متجه طبيعي, ب: &متجه طبيعي, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع العدد: طبيعي = (*السياق).العدد;
    دع الفرق: متجه طبيعي = اطرح_بإقراض_كبير(أ, ب, العدد);
    دع الاقتراض: طبيعي = الفرق[العدد];
    دع المعامل_المقنع: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(المعامل_المقنع, (*السياق).المعامل[ف] & (الاقتراض * 0xFFFFFFFF));
        ف := ف + 1;
    }
    دع المصحح: متجه طبيعي = اجمع_كامل_كبير(&الفرق, &المعامل_المقنع);
    أرجع أول_أطراف_كبير(&المصحح, العدد);
}

// الأساس^الأس mod m. الأساس is below m in normal form; الأس is big-endian.
// Fixed 4-bit windows: four squarings and one multiplication by a table entry
// chosen by scanning all sixteen entries with masks.
عام عرف أس_معياري_كبير(الأساس: &متجه طبيعي, الأس: &متجه ط8, السياق: &سياق_مونتغمري): متجه طبيعي {
    دع العدد: طبيعي = (*السياق).العدد;
    دع واحد: متغير متجه طبيعي = أطراف_صفرية_كبير(العدد);
    واحد[0] := 1;
    دع الجدول: متغير متجه متجه طبيعي = [];
    ألحق(الجدول, إلى_مونتغمري(&واحد, السياق));
    ألحق(الجدول, إلى_مونتغمري(الأساس, السياق));
    دع ف: متغير طبيعي = 2;
    طالما (ف < 16) {
        دع التالي: متجه طبيعي = اضرب_مونتغمري(&الجدول[ف - 1], &الجدول[1], السياق);
        ألحق(الجدول, التالي);
        ف := ف + 1;
    }
    دع المجمع: متغير متجه طبيعي = إلى_مونتغمري(&واحد, السياق);
    دع الحجم: طبيعي = الطول(*الأس) مثل طبيعي;
    دع ب: متغير طبيعي = 0;
    طالما (ب < 2 * الحجم) {
        دع البايت: طبيعي = (*الأس)[ب / 2] مثل طبيعي;
        دع النافذة: متغير طبيعي = البايت & 0x0F;
        لو ((ب % 2) == 0) { النافذة := البايت >> 4; };
        دع ر: متغير طبيعي = 0;
        طالما (ر < 4) {
            المجمع := اضرب_مونتغمري(&المجمع, &المجمع, السياق);
            ر := ر + 1;
        }
        دع المختار: متغير متجه طبيعي = أطراف_صفرية_كبير(العدد);
        دع م: متغير طبيعي = 0;
        طالما (م < 16) {
            دع مطابق: طبيعي = 1 - ليس_صفرا32_تشفير(م ^ النافذة);
            المختار := اختر_أطراف_كبير(مطابق, &الجدول[م], &المختار, العدد);
            م := م + 1;
        }
        المجمع := اضرب_مونتغمري(&المجمع, &المختار, السياق);
        ب := ب + 1;
    }
    أرجع من_مونتغمري(&المجمع, السياق);
}

// The big-endian bytes of the modulus minus a small value (for Fermat inverses).
عام عرف معامل_ناقص_كبير(السياق: &سياق_مونتغمري, المطروح: طبيعي, الطول_المطلوب: طبيعي): متجه ط8 {
    دع الصغير: متغير متجه طبيعي = أطراف_صفرية_كبير((*السياق).العدد);
    الصغير[0] := المطروح;
    دع الفرق: متجه طبيعي = اطرح_بإقراض_كبير(&(*السياق).المعامل, &الصغير, (*السياق).العدد);
    أرجع بايتات_من_عدد_كبير(&الفرق, الطول_المطلوب);
}

عام مرادف montgomery_context = سياق_مونتغمري;
عام مرادف bignum_from_bytes = عدد_كبير_من_بايتات;
عام مرادف bignum_to_bytes = بايتات_من_عدد_كبير;
عام مرادف montgomery_new = أنشئ_سياق_مونتغمري;
عام مرادف modular_exponent = أس_معياري_كبير;
