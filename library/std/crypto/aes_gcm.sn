// AES-GCM with 96-bit nonces and 128-bit tags (NIST SP 800-38D, RFC 5116).
// GHASH multiplies in GF(2^128) bit by bit with masks, so its running time does
// not depend on the hash key or the data. Tags are compared in constant time
// and no plaintext is released before the tag verifies.

استورد crypto.aes;
استورد crypto.words;

عام نوع قيمة128_تشفير = {
    العليا: غير_موقع,
    الدنيا: غير_موقع
};

عرف كل_البتات64_جي_سي_إم(): غير_موقع {
    أرجع 18446744073709551615;
}

عرف اقرأ_كتلة128_جي_سي_إم(المصدر: &متجه غ8, البداية: غير_موقع): قيمة128_تشفير {
    دع القيمة: قيمة128_تشفير = {
        العليا: اقرأ_كبير64_تشفير(المصدر, البداية),
        الدنيا: اقرأ_كبير64_تشفير(المصدر, البداية + 8)
    };
    أرجع القيمة;
}

// X * Y in GF(2^128) with the GCM bit order (SP 800-38D algorithm 1).
عرف اضرب_جي_إف128(س: &قيمة128_تشفير, ص: &قيمة128_تشفير): قيمة128_تشفير {
    دع الكل: غير_موقع = كل_البتات64_جي_سي_إم();
    دع ز_ع: متغير غير_موقع = 0;
    دع ز_د: متغير غير_موقع = 0;
    دع ف_ع: متغير غير_موقع = (*ص).العليا;
    دع ف_د: متغير غير_موقع = (*ص).الدنيا;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 128) {
        دع البت: متغير غير_موقع = 0;
        لو (ف < 64) {
            البت := ((*س).العليا >> (63 - ف)) & 1;
        } وإلا {
            البت := ((*س).الدنيا >> (127 - ف)) & 1;
        };
        دع القناع: غير_موقع = البت * الكل;
        ز_ع := ز_ع ^ (ف_ع & القناع);
        ز_د := ز_د ^ (ف_د & القناع);
        دع الأدنى: غير_موقع = ف_د & 1;
        ف_د := (ف_د >> 1) | ((ف_ع & 1) << 63);
        ف_ع := ف_ع >> 1;
        ف_ع := ف_ع ^ (0xE100000000000000 & (الأدنى * الكل));
        ف := ف + 1;
    }
    دع الناتج: قيمة128_تشفير = { العليا: ز_ع, الدنيا: ز_د };
    أرجع الناتج;
}

// Absorbs البيانات zero-padded to whole blocks.
عرف امتص_جهاش(الحالة: &متغير قيمة128_تشفير, المفتاح: &قيمة128_تشفير, البيانات: &متجه غ8): فراغ {
    دع الحجم: غير_موقع = الطول(*البيانات) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < الحجم) {
        دع الكتلة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < 16) {
            لو (الموضع + ف < الحجم) {
                ألحق(الكتلة, (*البيانات)[الموضع + ف]);
            } وإلا {
                ألحق(الكتلة, 0 مثل غ8);
            };
            ف := ف + 1;
        }
        دع ك: قيمة128_تشفير = اقرأ_كتلة128_جي_سي_إم(&الكتلة, 0);
        دع مجموع: قيمة128_تشفير = {
            العليا: (*الحالة).العليا ^ ك.العليا,
            الدنيا: (*الحالة).الدنيا ^ ك.الدنيا
        };
        *الحالة := اضرب_جي_إف128(&مجموع, المفتاح);
        الموضع := الموضع + 16;
    }
}

عرف كتلة_عداد_جي_سي_إم(النونس: &متجه غ8, العداد: غير_موقع): متجه غ8 {
    دع الكتلة: متغير متجه غ8 = شريحة_بايتات_تشفير(النونس, 0, 12);
    ألحق_كبير32_تشفير(&متغير الكتلة, العداد & 0xFFFFFFFF);
    أرجع الكتلة;
}

عرف شفر_عداد_جي_سي_إم(الجدول: &مفتاح_أيس, النونس: &متجه غ8, البيانات: &متجه غ8): متجه غ8 {
    دع الحجم: غير_موقع = الطول(*البيانات) مثل غير_موقع;
    دع الناتج: متغير متجه غ8 = [];
    دع العداد: متغير غير_موقع = 2;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < الحجم) {
        دع العداد_الحالي: متجه غ8 = كتلة_عداد_جي_سي_إم(النونس, العداد);
        دع التيار: متغير متجه غ8 = شفر_كتلة_أيس(الجدول, &العداد_الحالي, 0);
        دع ف: متغير غير_موقع = 0;
        بينما ((ف < 16) && (الموضع + ف < الحجم)) {
            ألحق(الناتج, (((*البيانات)[الموضع + ف] مثل غير_موقع) ^ (التيار[ف] مثل غير_موقع)) مثل غ8);
            ف := ف + 1;
        }
        امسح_بايتات_تشفير(&متغير التيار);
        الموضع := الموضع + 16;
        العداد := العداد + 1;
    }
    أرجع الناتج;
}

عرف وسم_جي_سي_إم(الجدول: &مفتاح_أيس, النونس: &متجه غ8, الإضافية: &متجه غ8, المشفر: &متجه غ8): متجه غ8 {
    دع صفر: متجه غ8 = أصفار_تشفير(16);
    دع ه_بايتات: متغير متجه غ8 = شفر_كتلة_أيس(الجدول, &صفر, 0);
    دع ه: قيمة128_تشفير = اقرأ_كتلة128_جي_سي_إم(&ه_بايتات, 0);
    دع الحالة: متغير قيمة128_تشفير = { العليا: 0, الدنيا: 0 };
    امتص_جهاش(&متغير الحالة, &ه, الإضافية);
    امتص_جهاش(&متغير الحالة, &ه, المشفر);
    دع الأطوال: قيمة128_تشفير = {
        العليا: الحالة.العليا ^ ((الطول(*الإضافية) مثل غير_موقع) * 8),
        الدنيا: الحالة.الدنيا ^ ((الطول(*المشفر) مثل غير_موقع) * 8)
    };
    دع الملخص: قيمة128_تشفير = اضرب_جي_إف128(&الأطوال, &ه);
    دع ج0: متجه غ8 = كتلة_عداد_جي_سي_إم(النونس, 1);
    دع قناع_الوسم: متغير متجه غ8 = شفر_كتلة_أيس(الجدول, &ج0, 0);
    دع الملخص_بايتات: متغير متجه غ8 = [];
    ألحق_كبير64_تشفير(&متغير الملخص_بايتات, الملخص.العليا);
    ألحق_كبير64_تشفير(&متغير الملخص_بايتات, الملخص.الدنيا);
    دع الوسم: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 16) {
        ألحق(الوسم, ((الملخص_بايتات[ف] مثل غير_موقع) ^ (قناع_الوسم[ف] مثل غير_موقع)) مثل غ8);
        ف := ف + 1;
    }
    امسح_بايتات_تشفير(&متغير ه_بايتات);
    امسح_بايتات_تشفير(&متغير قناع_الوسم);
    أرجع الوسم;
}

// Ciphertext followed by the tag; none for an invalid key or nonce size.
عام عرف اختم_أيس_جي_سي_إم(
    المفتاح: &متجه غ8,
    النونس: &متجه غ8,
    الإضافية: &متجه غ8,
    الصريح: &متجه غ8
): اختيار متجه غ8 {
    لو ((الطول(*النونس) مثل غير_موقع) != 12) { أرجع اختيار.لا_شيء(); };
    طابق جهز_مفتاح_أيس(المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الجدول) -> {
        دع الناتج: متغير متجه غ8 = شفر_عداد_جي_سي_إم(&الجدول, النونس, الصريح);
        دع الوسم: متجه غ8 = وسم_جي_سي_إم(&الجدول, النونس, الإضافية, &الناتج);
        ألحق_بايتات_تشفير(&متغير الناتج, &الوسم);
        أرجع اختيار.بعض(الناتج);
    };
}

// Plaintext, or none when the input is malformed or the tag does not verify.
عام عرف افتح_أيس_جي_سي_إم(
    المفتاح: &متجه غ8,
    النونس: &متجه غ8,
    الإضافية: &متجه غ8,
    المشفر_والوسم: &متجه غ8
): اختيار متجه غ8 {
    دع الكلي: غير_موقع = الطول(*المشفر_والوسم) مثل غير_موقع;
    لو (الكلي < 16 || (الطول(*النونس) مثل غير_موقع) != 12) { أرجع اختيار.لا_شيء(); };
    طابق جهز_مفتاح_أيس(المفتاح) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الجدول) -> {
        دع المشفر: متجه غ8 = شريحة_بايتات_تشفير(المشفر_والوسم, 0, الكلي - 16);
        دع المستلم: متجه غ8 = شريحة_بايتات_تشفير(المشفر_والوسم, الكلي - 16, 16);
        دع الوسم: متجه غ8 = وسم_جي_سي_إم(&الجدول, النونس, الإضافية, &المشفر);
        لو (!بايتات_متساوية_بزمن_ثابت_تشفير(&الوسم, &المستلم)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(شفر_عداد_جي_سي_إم(&الجدول, النونس, &المشفر));
    };
}

عام مرادف aes_gcm_seal = اختم_أيس_جي_سي_إم;
عام مرادف aes_gcm_open = افتح_أيس_جي_سي_إم;
