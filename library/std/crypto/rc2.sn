// RC2 in CBC mode, decryption only (RFC 2268), for legacy PKCS#12
// containers protected with pbeWithSHAAnd40BitRC2-CBC or
// pbeWithSHAAnd128BitRC2-CBC. PITABLE and expanded-key reads scan the whole
// table with masks, so the access pattern does not depend on key or data.

استورد crypto.words;

عرف جدول_باي_آر_سي2(): متجه طبيعي {
    دع الجدول: متجه طبيعي = [
        217, 120, 249, 196, 25, 221, 181, 237, 40, 233, 253, 121, 74, 160, 216, 157,
        198, 126, 55, 131, 43, 118, 83, 142, 98, 76, 100, 136, 68, 139, 251, 162,
        23, 154, 89, 245, 135, 179, 79, 19, 97, 69, 109, 141, 9, 129, 125, 50,
        189, 143, 64, 235, 134, 183, 123, 11, 240, 149, 33, 34, 92, 107, 78, 130,
        84, 214, 101, 147, 206, 96, 178, 28, 115, 86, 192, 20, 167, 140, 241, 220,
        18, 117, 202, 31, 59, 190, 228, 209, 66, 61, 212, 48, 163, 60, 182, 38,
        111, 191, 14, 218, 70, 105, 7, 87, 39, 242, 29, 155, 188, 148, 67, 3,
        248, 17, 199, 246, 144, 239, 62, 231, 6, 195, 213, 47, 200, 102, 30, 215,
        8, 232, 234, 222, 128, 82, 238, 247, 132, 170, 114, 172, 53, 77, 106, 42,
        150, 26, 210, 113, 90, 21, 73, 116, 75, 159, 208, 94, 4, 24, 164, 236,
        194, 224, 65, 110, 15, 81, 203, 204, 36, 145, 175, 80, 161, 244, 112, 57,
        153, 124, 58, 133, 35, 184, 180, 122, 252, 2, 54, 91, 37, 85, 151, 49,
        45, 93, 250, 152, 227, 138, 146, 174, 5, 223, 41, 16, 103, 108, 186, 201,
        211, 0, 230, 207, 225, 158, 168, 44, 99, 22, 1, 63, 88, 226, 137, 169,
        13, 56, 52, 27, 171, 51, 255, 176, 187, 72, 12, 95, 185, 177, 205, 46,
        197, 243, 219, 71, 229, 165, 156, 119, 10, 166, 32, 104, 254, 127, 193, 173
    ];
    أرجع الجدول;
}

عرف اقرأ_بقناع_آر_سي2(الجدول: &متجه طبيعي, الفهرس: طبيعي): طبيعي {
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجدول) مثل طبيعي)) {
        دع مطابق: طبيعي = 1 - ليس_صفرا32_تشفير(ف ^ الفهرس);
        القيمة := القيمة | ((*الجدول)[ف] * مطابق);
        ف := ف + 1;
    }
    أرجع القيمة;
}

// Key expansion (RFC 2268 2) with T1 effective key bits.
عرف وسع_مفتاح_آر_سي2(المفتاح: &متجه ط8, البتات_الفعالة: طبيعي): متجه طبيعي {
    دع باي: متجه طبيعي = جدول_باي_آر_سي2();
    دع ت: طبيعي = الطول(*المفتاح) مثل طبيعي;
    دع ل: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 128) {
        لو (ف < ت) { ألحق(ل, (*المفتاح)[ف] مثل طبيعي); } وإلا { ألحق(ل, 0); };
        ف := ف + 1;
    }
    دع ت8: طبيعي = (البتات_الفعالة + 7) / 8;
    دع تم: طبيعي = 255 % (1 << (8 + البتات_الفعالة - 8 * ت8));
    ف := ت;
    طالما (ف < 128) {
        ل[ف] := اقرأ_بقناع_آر_سي2(&باي, (ل[ف - 1] + ل[ف - ت]) % 256);
        ف := ف + 1;
    }
    ل[128 - ت8] := اقرأ_بقناع_آر_سي2(&باي, ل[128 - ت8] & تم);
    دع ي: متغير طبيعي = 128 - ت8;
    طالما (ي > 0) {
        ي := ي - 1;
        ل[ي] := اقرأ_بقناع_آر_سي2(&باي, ل[ي + 1] ^ ل[ي + ت8]);
    }
    دع الكلمات: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < 64) {
        ألحق(الكلمات, ل[2 * ف] + 256 * ل[2 * ف + 1]);
        ف := ف + 1;
    }
    أرجع الكلمات;
}

عرف دور_يمين16_آر_سي2(س: طبيعي, ن: طبيعي): طبيعي {
    أرجع ((س >> ن) | (س << (16 - ن))) & 0xFFFF;
}

// (أ - ب) mod 2^16 for 16-bit words.
عرف اطرح16_آر_سي2(أ: طبيعي, ب: طبيعي): طبيعي {
    أرجع (أ + 65536 - ب) & 0xFFFF;
}

عرف اعكس_خلط_آر_سي2(ر: &متغير متجه طبيعي, المفاتيح: &متجه طبيعي, ي: &متغير طبيعي): فراغ {
    دع الإزاحات: متجه طبيعي = [1, 2, 3, 5];
    دع ع: متغير طبيعي = 4;
    طالما (ع > 0) {
        ع := ع - 1;
        دع س1: طبيعي = (*ر)[(ع + 3) % 4];
        دع س2: طبيعي = (*ر)[(ع + 2) % 4];
        دع س3: طبيعي = (*ر)[(ع + 1) % 4];
        دع قيمة: متغير طبيعي = دور_يمين16_آر_سي2((*ر)[ع], الإزاحات[ع]);
        قيمة := اطرح16_آر_سي2(قيمة, (*المفاتيح)[*ي]);
        قيمة := اطرح16_آر_سي2(قيمة, س1 & س2);
        قيمة := اطرح16_آر_سي2(قيمة, (س1 ^ 0xFFFF) & س3);
        (*ر)[ع] := قيمة;
        لو (*ي > 0) { *ي := *ي - 1; };
    }
}

عرف اعكس_هرس_آر_سي2(ر: &متغير متجه طبيعي, المفاتيح: &متجه طبيعي): فراغ {
    دع ع: متغير طبيعي = 4;
    طالما (ع > 0) {
        ع := ع - 1;
        دع الفهرس: طبيعي = (*ر)[(ع + 3) % 4] & 63;
        (*ر)[ع] := اطرح16_آر_سي2((*ر)[ع], اقرأ_بقناع_آر_سي2(المفاتيح, الفهرس));
    }
}

عرف فك_كتلة_آر_سي2(المصدر: &متجه ط8, البداية: طبيعي, المفاتيح: &متجه طبيعي): متجه ط8 {
    دع ر: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 4) {
        ألحق(ر, ((*المصدر)[البداية + 2 * ف] مثل طبيعي) | (((*المصدر)[البداية + 2 * ف + 1] مثل طبيعي) << 8));
        ف := ف + 1;
    }
    دع ي: متغير طبيعي = 63;
    ف := 0;
    طالما (ف < 5) { اعكس_خلط_آر_سي2(&متغير ر, المفاتيح, &متغير ي); ف := ف + 1; }
    اعكس_هرس_آر_سي2(&متغير ر, المفاتيح);
    ف := 0;
    طالما (ف < 6) { اعكس_خلط_آر_سي2(&متغير ر, المفاتيح, &متغير ي); ف := ف + 1; }
    اعكس_هرس_آر_سي2(&متغير ر, المفاتيح);
    ف := 0;
    طالما (ف < 5) { اعكس_خلط_آر_سي2(&متغير ر, المفاتيح, &متغير ي); ف := ف + 1; }
    دع الناتج: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 4) {
        ألحق(الناتج, (ر[ف] & 0xFF) مثل ط8);
        ألحق(الناتج, (ر[ف] >> 8) مثل ط8);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// RC2-CBC decryption with PKCS#7 padding removal; none when malformed.
عام عرف فك_آر_سي2_سي_بي_سي(المفتاح: &متجه ط8, البتات_الفعالة: طبيعي, المتجه_الأولي: &متجه ط8, المشفر: &متجه ط8): اختياري متجه ط8 {
    دع الحجم: طبيعي = الطول(*المشفر) مثل طبيعي;
    دع حجم_المفتاح: طبيعي = الطول(*المفتاح) مثل طبيعي;
    لو (حجم_المفتاح == 0 || حجم_المفتاح > 128 || البتات_الفعالة == 0 || البتات_الفعالة > 1024) { أرجع اختياري.لا_شيء(); };
    لو ((الطول(*المتجه_الأولي) مثل طبيعي) != 8 || الحجم == 0 || (الحجم % 8) != 0) { أرجع اختياري.لا_شيء(); };
    دع المفاتيح: متجه طبيعي = وسع_مفتاح_آر_سي2(المفتاح, البتات_الفعالة);
    دع السابق: متغير متجه ط8 = شريحة_بايتات_تشفير(المتجه_الأولي, 0, 8);
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم) {
        دع الكتلة: متجه ط8 = فك_كتلة_آر_سي2(المشفر, الموضع, &المفاتيح);
        دع ف: متغير طبيعي = 0;
        طالما (ف < 8) {
            ألحق(الناتج, ((الكتلة[ف] مثل طبيعي) ^ (السابق[ف] مثل طبيعي)) مثل ط8);
            ف := ف + 1;
        }
        السابق := شريحة_بايتات_تشفير(المشفر, الموضع, 8);
        الموضع := الموضع + 8;
    }
    دع الحشو: طبيعي = الناتج[الحجم - 1] مثل طبيعي;
    لو (الحشو == 0 || الحشو > 8) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحشو) {
        لو ((الناتج[الحجم - 1 - ف] مثل طبيعي) != الحشو) { أرجع اختياري.لا_شيء(); };
        ف := ف + 1;
    }
    أرجع اختياري.موجود(شريحة_بايتات_تشفير(&الناتج, 0, الحجم - الحشو));
}

عام مرادف rc2_cbc_decrypt = فك_آر_سي2_سي_بي_سي;
