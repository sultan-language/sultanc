// Hash-function selection for protocols that negotiate the digest (TLS 1.3,
// PKCS#1, X.509, PKCS#12): one dispatch point over the std implementations,
// with generic HMAC (RFC 2104) and HKDF (RFC 5869) built on it.

استورد crypto.sha1;
استورد crypto.sha256;
استورد crypto.sha512;
استورد crypto.words;

عام نوع خوارزمية_تجزئة =
    | تجزئة_شا1
    | تجزئة_شا256
    | تجزئة_شا384
    | تجزئة_شا512
;

عام عرف جزئ_تشفير(الخوارزمية: خوارزمية_تجزئة, البيانات: &متجه غ8): متجه غ8 {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع شا1(البيانات); }
    | خوارزمية_تجزئة.تجزئة_شا256 -> { أرجع شا256(البيانات); }
    | خوارزمية_تجزئة.تجزئة_شا384 -> { أرجع شا384(البيانات); }
    | خوارزمية_تجزئة.تجزئة_شا512 -> { أرجع شا512(البيانات); };
}

عام عرف حجم_ملخص_تجزئة(الخوارزمية: خوارزمية_تجزئة): غير_موقع {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع 20; }
    | خوارزمية_تجزئة.تجزئة_شا256 -> { أرجع 32; }
    | خوارزمية_تجزئة.تجزئة_شا384 -> { أرجع 48; }
    | خوارزمية_تجزئة.تجزئة_شا512 -> { أرجع 64; };
}

عام عرف حجم_كتلة_تجزئة(الخوارزمية: خوارزمية_تجزئة): غير_موقع {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع 64; }
    | خوارزمية_تجزئة.تجزئة_شا256 -> { أرجع 64; }
    | خوارزمية_تجزئة.تجزئة_شا384 -> { أرجع 128; }
    | خوارزمية_تجزئة.تجزئة_شا512 -> { أرجع 128; };
}

عام عرف هماك_تشفير(الخوارزمية: خوارزمية_تجزئة, المفتاح: &متجه غ8, الرسالة: &متجه غ8): متجه غ8 {
    دع الكتلة: غير_موقع = حجم_كتلة_تجزئة(الخوارزمية);
    دع ك: متغير متجه غ8 = [];
    لو ((الطول(*المفتاح) مثل غير_موقع) > الكتلة) {
        ك := جزئ_تشفير(الخوارزمية, المفتاح);
    } وإلا {
        ألحق_بايتات_تشفير(&متغير ك, المفتاح);
    };
    بينما ((الطول(ك) مثل غير_موقع) < الكتلة) { ألحق(ك, 0 مثل غ8); }

    دع داخلي: متغير متجه غ8 = [];
    دع وسادة_خارجية: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الكتلة) {
        ألحق(داخلي, ((ك[ف] مثل غير_موقع) ^ 0x36) مثل غ8);
        ألحق(وسادة_خارجية, ((ك[ف] مثل غير_موقع) ^ 0x5C) مثل غ8);
        ف := ف + 1;
    }
    ألحق_بايتات_تشفير(&متغير داخلي, الرسالة);
    دع ملخص_داخلي: متجه غ8 = جزئ_تشفير(الخوارزمية, &داخلي);
    ألحق_بايتات_تشفير(&متغير وسادة_خارجية, &ملخص_داخلي);
    امسح_بايتات_تشفير(&متغير ك);
    امسح_بايتات_تشفير(&متغير داخلي);
    أرجع جزئ_تشفير(الخوارزمية, &وسادة_خارجية);
}

// HKDF-Extract. An empty salt is a string of HashLen zero bytes (RFC 5869 2.2).
عام عرف هكدف_استخرج_تشفير(الخوارزمية: خوارزمية_تجزئة, الملح: &متجه غ8, المادة: &متجه غ8): متجه غ8 {
    لو ((الطول(*الملح) مثل غير_موقع) == 0) {
        دع أصفار: متجه غ8 = أصفار_تشفير(حجم_ملخص_تجزئة(الخوارزمية));
        أرجع هماك_تشفير(الخوارزمية, &أصفار, المادة);
    };
    أرجع هماك_تشفير(الخوارزمية, الملح, المادة);
}

// HKDF-Expand; none when the length exceeds 255 * HashLen.
عام عرف هكدف_وسع_تشفير(
    الخوارزمية: خوارزمية_تجزئة,
    المفتاح_الكاذب: &متجه غ8,
    المعلومات: &متجه غ8,
    الطول_المطلوب: غير_موقع
): اختيار متجه غ8 {
    لو (الطول_المطلوب > 255 * حجم_ملخص_تجزئة(الخوارزمية)) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع السابق: متغير متجه غ8 = [];
    دع العداد: متغير غير_موقع = 1;
    بينما ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب) {
        دع الرسالة: متغير متجه غ8 = [];
        ألحق_بايتات_تشفير(&متغير الرسالة, &السابق);
        ألحق_بايتات_تشفير(&متغير الرسالة, المعلومات);
        ألحق(الرسالة, العداد مثل غ8);
        السابق := هماك_تشفير(الخوارزمية, المفتاح_الكاذب, &الرسالة);
        دع ف: متغير غير_موقع = 0;
        بينما ((ف < (الطول(السابق) مثل غير_موقع)) && ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب)) {
            ألحق(الناتج, السابق[ف]);
            ف := ف + 1;
        }
        العداد := العداد + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام مرادف hash_algorithm = خوارزمية_تجزئة;
عام مرادف hash_digest = جزئ_تشفير;
عام مرادف hash_digest_size = حجم_ملخص_تجزئة;
عام مرادف hmac = هماك_تشفير;
عام مرادف hkdf_extract = هكدف_استخرج_تشفير;
عام مرادف hkdf_expand = هكدف_وسع_تشفير;

// PBKDF2 (RFC 8018 5.2) with HMAC over the selected digest. Callers own the
// password/salt policy; zero iterations and oversized output are rejected.
عام عرف ببدف2_تشفير(
    الخوارزمية: خوارزمية_تجزئة,
    كلمة_المرور: &متجه غ8,
    الملح: &متجه غ8,
    التكرارات: غير_موقع,
    الطول_المطلوب: غير_موقع
): اختيار متجه غ8 {
    لو (التكرارات == 0) { أرجع اختيار.لا_شيء(); };
    دع الملخص: غير_موقع = حجم_ملخص_تجزئة(الخوارزمية);
    لو (الطول_المطلوب > 4294967295 * الملخص) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع رقم_الكتلة: متغير غير_موقع = 1;
    بينما ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب) {
        دع الرسالة: متغير متجه غ8 = [];
        ألحق_بايتات_تشفير(&متغير الرسالة, الملح);
        ألحق_كبير32_تشفير(&متغير الرسالة, رقم_الكتلة);
        دع يو: متغير متجه غ8 = هماك_تشفير(الخوارزمية, كلمة_المرور, &الرسالة);
        دع الكتلة: متغير متجه غ8 = [];
        ألحق_بايتات_تشفير(&متغير الكتلة, &يو);
        دع الجولة: متغير غير_موقع = 1;
        بينما (الجولة < التكرارات) {
            يو := هماك_تشفير(الخوارزمية, كلمة_المرور, &يو);
            دع ف: متغير غير_موقع = 0;
            بينما (ف < الملخص) {
                الكتلة[ف] := الكتلة[ف] ^ يو[ف];
                ف := ف + 1;
            }
            الجولة := الجولة + 1;
        }
        دع م: متغير غير_موقع = 0;
        بينما ((م < الملخص) && ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب)) {
            ألحق(الناتج, الكتلة[م]);
            م := م + 1;
        }
        رقم_الكتلة := رقم_الكتلة + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام مرادف pbkdf2 = ببدف2_تشفير;

// SHA-256 forms of the generic constructions (the previous std.crypto API).
عام عرف هماك_شا256(المفتاح: &متجه غ8, الرسالة: &متجه غ8): متجه غ8 {
    أرجع هماك_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), المفتاح, الرسالة);
}

عام عرف هكدف_شا256_استخرج(الملح: &متجه غ8, مادة_المفتاح: &متجه غ8): متجه غ8 {
    أرجع هكدف_استخرج_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), الملح, مادة_المفتاح);
}

عام عرف هكدف_شا256_وسع(المفتاح_الكاذب: &متجه غ8, المعلومات: &متجه غ8, الطول_المطلوب: غير_موقع): اختيار متجه غ8 {
    أرجع هكدف_وسع_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), المفتاح_الكاذب, المعلومات, الطول_المطلوب);
}

عام عرف هكدف_شا256(الملح: &متجه غ8, مادة_المفتاح: &متجه غ8, المعلومات: &متجه غ8, الطول_المطلوب: غير_موقع): اختيار متجه غ8 {
    دع المفتاح_الكاذب: متجه غ8 = هكدف_شا256_استخرج(الملح, مادة_المفتاح);
    أرجع هكدف_شا256_وسع(&المفتاح_الكاذب, المعلومات, الطول_المطلوب);
}

عام عرف ببدف2_هماك_شا256(
    كلمة_المرور: &متجه غ8,
    الملح: &متجه غ8,
    التكرارات: غير_موقع,
    الطول_المطلوب: غير_موقع
): اختيار متجه غ8 {
    لو (الطول_المطلوب == 0 && التكرارات != 0) {
        دع فارغ: متجه غ8 = [];
        أرجع اختيار.بعض(فارغ);
    };
    أرجع ببدف2_تشفير(خوارزمية_تجزئة.تجزئة_شا256(), كلمة_المرور, الملح, التكرارات, الطول_المطلوب);
}

عام مرادف hmac_sha256 = هماك_شا256;
عام مرادف hkdf_sha256_extract = هكدف_شا256_استخرج;
عام مرادف hkdf_sha256_expand = هكدف_شا256_وسع;
عام مرادف hkdf_sha256 = هكدف_شا256;
عام مرادف pbkdf2_hmac_sha256 = ببدف2_هماك_شا256;
