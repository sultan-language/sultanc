// RSA signatures (RFC 8017): RSASSA-PKCS1-v1_5 and RSASSA-PSS verification,
// and RSASSA-PSS signing with a CRT private key.
//
// Verification works on public values. Signing exponentiates with
// crypto.bignum's fixed-window Montgomery ladder over exponents padded to
// the prime length, recombines with Garner's formula and checks the result
// against the public key before releasing it (the fault-attack check used by
// Go crypto/rsa and BoringSSL). Moduli from 1024 to 8192 bits are accepted.

استورد crypto.bignum;
استورد crypto.digest;
استورد crypto.words;

عام نوع مفتاح_آر_إس_إيه_عام = {
    المعامل: متجه غ8,
    الأس: متجه غ8
};

عام نوع مفتاح_آر_إس_إيه_خاص = {
    العام: مفتاح_آر_إس_إيه_عام,
    الأولي_الأول: متجه غ8,
    الأولي_الثاني: متجه غ8,
    أس_الأول: متجه غ8,
    أس_الثاني: متجه غ8,
    معامل_الثاني: متجه غ8
};

عرف بلا_أصفار_بادئة_آر_إس_إيه(البايتات: &متجه غ8): متجه غ8 {
    دع الحجم: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    بينما (البداية < الحجم && (*البايتات)[البداية] == 0) { البداية := البداية + 1; }
    أرجع شريحة_بايتات_تشفير(البايتات, البداية, الحجم - البداية);
}

عام عرف أنشئ_مفتاح_آر_إس_إيه_عام(المعامل: &متجه غ8, الأس: &متجه غ8): مفتاح_آر_إس_إيه_عام {
    دع المفتاح: مفتاح_آر_إس_إيه_عام = {
        المعامل: بلا_أصفار_بادئة_آر_إس_إيه(المعامل),
        الأس: بلا_أصفار_بادئة_آر_إس_إيه(الأس)
    };
    أرجع المفتاح;
}

عام عرف بتات_مفتاح_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام): غير_موقع {
    دع المعامل: &متجه غ8 = &(*المفتاح).المعامل;
    دع الحجم: غير_موقع = الطول(*المعامل) مثل غير_موقع;
    لو (الحجم == 0) { أرجع 0; };
    دع الأول: متغير غير_موقع = (*المعامل)[0] مثل غير_موقع;
    دع البتات: متغير غير_موقع = 0;
    بينما (الأول != 0) {
        البتات := البتات + 1;
        الأول := الأول >> 1;
    }
    أرجع (الحجم - 1) * 8 + البتات;
}

عرف مفتاح_عام_مقبول_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام): منطقي {
    دع البتات: غير_موقع = بتات_مفتاح_آر_إس_إيه(المفتاح);
    لو (البتات < 1024 || البتات > 8192) { أرجع خطأ; };
    دع الأس: &متجه غ8 = &(*المفتاح).الأس;
    دع حجم_الأس: غير_موقع = الطول(*الأس) مثل غير_موقع;
    لو (حجم_الأس == 0 || حجم_الأس > 4) { أرجع خطأ; };
    لو ((((*الأس)[حجم_الأس - 1] مثل غير_موقع) & 1) == 0) { أرجع خطأ; };
    لو (حجم_الأس == 1 && (*الأس)[0] < 3) { أرجع خطأ; };
    أرجع صواب;
}

// s^e mod n as k bytes, or none when s is not below n.
عرف طبق_المفتاح_العام_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام, التوقيع: &متجه غ8): اختيار متجه غ8 {
    لو (!مفتاح_عام_مقبول_آر_إس_إيه(المفتاح)) { أرجع اختيار.لا_شيء(); };
    دع المعامل: &متجه غ8 = &(*المفتاح).المعامل;
    دع ك: غير_موقع = الطول(*المعامل) مثل غير_موقع;
    لو ((الطول(*التوقيع) مثل غير_موقع) != ك) { أرجع اختيار.لا_شيء(); };
    طابق أنشئ_سياق_مونتغمري(المعامل) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(السياق) -> {
        طابق عدد_كبير_من_بايتات(التوقيع, السياق.العدد) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(س) -> {
            لو (قارن_كبير(&س, &السياق.المعامل) >= 0) { أرجع اختيار.لا_شيء(); };
            دع م: متجه غير_موقع = أس_معياري_كبير(&س, &(*المفتاح).الأس, &السياق);
            أرجع اختيار.بعض(بايتات_من_عدد_كبير(&م, ك));
        };
    };
}

// DER DigestInfo prefix (RFC 8017 9.2 note 1) for the PKCS#1 v1.5 encoding.
عرف بادئة_معلومات_الملخص_آر_إس_إيه(الخوارزمية: خوارزمية_تجزئة): متجه غ8 {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا256 -> {
        دع ب: متجه غ8 = [0x30, 0x31, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا384 -> {
        دع ب: متجه غ8 = [0x30, 0x41, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا512 -> {
        دع ب: متجه غ8 = [0x30, 0x51, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا1 -> {
        دع ب: متجه غ8 = [];
        أرجع ب;
    };
}

// RSASSA-PKCS1-v1_5 verification of a message digest. SHA-1 is rejected.
عام عرف تحقق_آر_إس_إيه_بي_كي_سي_إس1(
    المفتاح: &مفتاح_آر_إس_إيه_عام,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه غ8,
    التوقيع: &متجه غ8
): منطقي {
    دع البادئة: متجه غ8 = بادئة_معلومات_الملخص_آر_إس_إيه(الخوارزمية);
    لو ((الطول(البادئة) مثل غير_موقع) == 0) { أرجع خطأ; };
    لو ((الطول(*الملخص) مثل غير_موقع) != حجم_ملخص_تجزئة(الخوارزمية)) { أرجع خطأ; };
    طابق طبق_المفتاح_العام_آر_إس_إيه(المفتاح, التوقيع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المرمز) -> {
        دع ك: غير_موقع = الطول(المرمز) مثل غير_موقع;
        دع ت: غير_موقع = (الطول(البادئة) مثل غير_موقع) + (الطول(*الملخص) مثل غير_موقع);
        لو (ك < ت + 11) { أرجع خطأ; };
        دع المتوقع: متغير متجه غ8 = [0x00, 0x01];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < ك - ت - 3) {
            ألحق(المتوقع, 0xFF مثل غ8);
            ف := ف + 1;
        }
        ألحق(المتوقع, 0x00 مثل غ8);
        ألحق_بايتات_تشفير(&متغير المتوقع, &البادئة);
        ألحق_بايتات_تشفير(&متغير المتوقع, الملخص);
        أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&المتوقع, &المرمز);
    };
}

// MGF1 (RFC 8017 B.2.1).
عام عرف إم_جي_إف1(الخوارزمية: خوارزمية_تجزئة, البذرة: &متجه غ8, الطول_المطلوب: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع العداد: متغير غير_موقع = 0;
    بينما ((الطول(الناتج) مثل غير_موقع) < الطول_المطلوب) {
        دع المدخل: متغير متجه غ8 = [];
        ألحق_بايتات_تشفير(&متغير المدخل, البذرة);
        ألحق_كبير32_تشفير(&متغير المدخل, العداد);
        دع الملخص: متجه غ8 = جزئ_تشفير(الخوارزمية, &المدخل);
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الملخص) مثل غير_موقع) && (الطول(الناتج) مثل غير_موقع) < الطول_المطلوب) {
            ألحق(الناتج, الملخص[ف]);
            ف := ف + 1;
        }
        العداد := العداد + 1;
    }
    أرجع الناتج;
}

// Mask for the leftmost byte: keeps the low (8 - zero_bits) bits.
عرف قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز: غير_موقع): غير_موقع {
    دع الصفرية: غير_موقع = (8 - (بتات_الترميز % 8)) % 8;
    أرجع 0xFF >> الصفرية;
}

// EMSA-PSS-VERIFY (RFC 8017 9.1.2) with MGF1 over the same digest and a
// salt length equal to the digest length (the TLS 1.3 and X.509 profile).
عام عرف تحقق_آر_إس_إيه_بي_إس_إس(
    المفتاح: &مفتاح_آر_إس_إيه_عام,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه غ8,
    التوقيع: &متجه غ8
): منطقي {
    دع هاء_طول: غير_موقع = حجم_ملخص_تجزئة(الخوارزمية);
    لو ((الطول(*الملخص) مثل غير_موقع) != هاء_طول) { أرجع خطأ; };
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع خطأ; }
    | _ -> { };
    طابق طبق_المفتاح_العام_آر_إس_إيه(المفتاح, التوقيع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(المرمز_الكامل) -> {
        دع بتات_الترميز: غير_موقع = بتات_مفتاح_آر_إس_إيه(المفتاح) - 1;
        دع طول_الترميز: غير_موقع = (بتات_الترميز + 7) / 8;
        دع ك: غير_موقع = الطول(المرمز_الكامل) مثل غير_موقع;
        // When emLen < k the leading byte of the k-byte value must be zero.
        لو (طول_الترميز < ك && المرمز_الكامل[0] != 0) { أرجع خطأ; };
        دع المرمز: متجه غ8 = شريحة_بايتات_تشفير(&المرمز_الكامل, ك - طول_الترميز, طول_الترميز);
        دع ملح_طول: غير_موقع = هاء_طول;
        لو (طول_الترميز < هاء_طول + ملح_طول + 2) { أرجع خطأ; };
        لو (المرمز[طول_الترميز - 1] != 0xBC) { أرجع خطأ; };
        دع طول_قاعدة: غير_موقع = طول_الترميز - هاء_طول - 1;
        دع المقنع: متجه غ8 = شريحة_بايتات_تشفير(&المرمز, 0, طول_قاعدة);
        دع هاء: متجه غ8 = شريحة_بايتات_تشفير(&المرمز, طول_قاعدة, هاء_طول);
        دع قناع_الأول: غير_موقع = قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز);
        لو (((المقنع[0] مثل غير_موقع) & (قناع_الأول ^ 0xFF)) != 0) { أرجع خطأ; };
        دع قناع_القاعدة: متجه غ8 = إم_جي_إف1(الخوارزمية, &هاء, طول_قاعدة);
        دع القاعدة: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < طول_قاعدة) {
            ألحق(القاعدة, ((المقنع[ف] مثل غير_موقع) ^ (قناع_القاعدة[ف] مثل غير_موقع)) مثل غ8);
            ف := ف + 1;
        }
        القاعدة[0] := ((القاعدة[0] مثل غير_موقع) & قناع_الأول) مثل غ8;
        دع طول_الحشو: غير_موقع = طول_الترميز - هاء_طول - ملح_طول - 2;
        ف := 0;
        بينما (ف < طول_الحشو) {
            لو (القاعدة[ف] != 0) { أرجع خطأ; };
            ف := ف + 1;
        }
        لو (القاعدة[طول_الحشو] != 0x01) { أرجع خطأ; };
        دع الملح: متجه غ8 = شريحة_بايتات_تشفير(&القاعدة, طول_قاعدة - ملح_طول, ملح_طول);
        دع م_شرطة: متغير متجه غ8 = أصفار_تشفير(8);
        ألحق_بايتات_تشفير(&متغير م_شرطة, الملخص);
        ألحق_بايتات_تشفير(&متغير م_شرطة, &الملح);
        دع هاء_شرطة: متجه غ8 = جزئ_تشفير(الخوارزمية, &م_شرطة);
        أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&هاء, &هاء_شرطة);
    };
}

عرف بايتات_بطول_آر_إس_إيه(البايتات: &متجه غ8, الطول_المطلوب: غير_موقع): متجه غ8 {
    دع النظيف: متجه غ8 = بلا_أصفار_بادئة_آر_إس_إيه(البايتات);
    دع الحجم: غير_موقع = الطول(النظيف) مثل غير_موقع;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = الحجم;
    بينما (ف < الطول_المطلوب) {
        ألحق(الناتج, 0 مثل غ8);
        ف := ف + 1;
    }
    ألحق_بايتات_تشفير(&متغير الناتج, &النظيف);
    أرجع الناتج;
}

// m^d mod n through CRT; none if the key is inconsistent or the result does
// not verify with the public exponent.
عرف طبق_المفتاح_الخاص_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_خاص, الرسالة: &متجه غ8): اختيار متجه غ8 {
    دع العام: &مفتاح_آر_إس_إيه_عام = &(*المفتاح).العام;
    لو (!مفتاح_عام_مقبول_آر_إس_إيه(العام)) { أرجع اختيار.لا_شيء(); };
    دع ك: غير_موقع = الطول((*العام).المعامل) مثل غير_موقع;
    لو ((الطول(*الرسالة) مثل غير_موقع) != ك) { أرجع اختيار.لا_شيء(); };
    طابق أنشئ_سياق_مونتغمري(&(*المفتاح).الأولي_الأول) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(سياق_ب) -> {
        طابق أنشئ_سياق_مونتغمري(&(*المفتاح).الأولي_الثاني) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(سياق_ق) -> {
            لو (سياق_ب.العدد != سياق_ق.العدد) { أرجع اختيار.لا_شيء(); };
            دع ن: غير_موقع = سياق_ب.العدد;
            طابق عدد_كبير_من_بايتات(الرسالة, 2 * ن) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(ج) -> {
                دع طول_ب: غير_موقع = ن * 4;
                دع أس_ب: متجه غ8 = بايتات_بطول_آر_إس_إيه(&(*المفتاح).أس_الأول, طول_ب);
                دع أس_ق: متجه غ8 = بايتات_بطول_آر_إس_إيه(&(*المفتاح).أس_الثاني, طول_ب);
                دع ج_ب: متجه غير_موقع = اختزل_كبير(&ج, &سياق_ب);
                دع ج_ق: متجه غير_موقع = اختزل_كبير(&ج, &سياق_ق);
                دع م1: متجه غير_موقع = أس_معياري_كبير(&ج_ب, &أس_ب, &سياق_ب);
                دع م2: متجه غير_موقع = أس_معياري_كبير(&ج_ق, &أس_ق, &سياق_ق);
                // h = qInv * (m1 - m2) mod p; m = m2 + q * h.
                دع م2_ب: متجه غير_موقع = اختزل_كبير(&م2, &سياق_ب);
                دع الفرق: متجه غير_موقع = اطرح_معياري_كبير(&م1, &م2_ب, &سياق_ب);
                طابق عدد_كبير_من_بايتات(&(*المفتاح).معامل_الثاني, ن) مع
                | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                | اختيار.بعض(معكوس_ق) -> {
                    دع معكوس_ق_مختزل: متجه غير_موقع = اختزل_كبير(&معكوس_ق, &سياق_ب);
                    دع معكوس_ق_م: متجه غير_موقع = إلى_مونتغمري(&معكوس_ق_مختزل, &سياق_ب);
                    دع هاء: متجه غير_موقع = اضرب_مونتغمري(&معكوس_ق_م, &الفرق, &سياق_ب);
                    دع ق_هاء: متجه غير_موقع = اضرب_كامل_كبير(&سياق_ق.المعامل, &هاء);
                    دع م: متجه غير_موقع = اجمع_كامل_كبير(&م2, &ق_هاء);
                    دع التوقيع: متجه غ8 = بايتات_من_عدد_كبير(&م, ك);
                    طابق طبق_المفتاح_العام_آر_إس_إيه(العام, &التوقيع) مع
                    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
                    | اختيار.بعض(المسترجع) -> {
                        لو (!بايتات_متساوية_بزمن_ثابت_تشفير(&المسترجع, الرسالة)) { أرجع اختيار.لا_شيء(); };
                        أرجع اختيار.بعض(التوقيع);
                    };
                };
            };
        };
    };
}

// RSASSA-PSS signature of a digest with salt length equal to the digest
// length. الملح must be HashLen fresh random bytes from the OS CSPRNG.
عام عرف وقع_آر_إس_إيه_بي_إس_إس(
    المفتاح: &مفتاح_آر_إس_إيه_خاص,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه غ8,
    الملح: &متجه غ8
): اختيار متجه غ8 {
    دع هاء_طول: غير_موقع = حجم_ملخص_تجزئة(الخوارزمية);
    لو ((الطول(*الملخص) مثل غير_موقع) != هاء_طول || (الطول(*الملح) مثل غير_موقع) != هاء_طول) {
        أرجع اختيار.لا_شيء();
    };
    دع العام: &مفتاح_آر_إس_إيه_عام = &(*المفتاح).العام;
    دع بتات_الترميز: غير_موقع = بتات_مفتاح_آر_إس_إيه(العام) - 1;
    دع طول_الترميز: غير_موقع = (بتات_الترميز + 7) / 8;
    لو (طول_الترميز < 2 * هاء_طول + 2) { أرجع اختيار.لا_شيء(); };
    دع م_شرطة: متغير متجه غ8 = أصفار_تشفير(8);
    ألحق_بايتات_تشفير(&متغير م_شرطة, الملخص);
    ألحق_بايتات_تشفير(&متغير م_شرطة, الملح);
    دع هاء: متجه غ8 = جزئ_تشفير(الخوارزمية, &م_شرطة);
    دع طول_قاعدة: غير_موقع = طول_الترميز - هاء_طول - 1;
    دع القاعدة: متغير متجه غ8 = أصفار_تشفير(طول_قاعدة - هاء_طول - 1);
    ألحق(القاعدة, 0x01 مثل غ8);
    ألحق_بايتات_تشفير(&متغير القاعدة, الملح);
    دع القناع: متجه غ8 = إم_جي_إف1(الخوارزمية, &هاء, طول_قاعدة);
    دع المرمز: متغير متجه غ8 = [];
    دع ك: غير_موقع = الطول((*العام).المعامل) مثل غير_موقع;
    دع ف: متغير غير_موقع = طول_الترميز;
    بينما (ف < ك) {
        ألحق(المرمز, 0 مثل غ8);
        ف := ف + 1;
    }
    دع بداية_القاعدة: غير_موقع = الطول(المرمز) مثل غير_موقع;
    ف := 0;
    بينما (ف < طول_قاعدة) {
        ألحق(المرمز, ((القاعدة[ف] مثل غير_موقع) ^ (القناع[ف] مثل غير_موقع)) مثل غ8);
        ف := ف + 1;
    }
    دع قناع_الأول: غير_موقع = قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز);
    المرمز[بداية_القاعدة] := ((المرمز[بداية_القاعدة] مثل غير_موقع) & قناع_الأول) مثل غ8;
    ألحق_بايتات_تشفير(&متغير المرمز, &هاء);
    ألحق(المرمز, 0xBC مثل غ8);
    امسح_بايتات_تشفير(&متغير القاعدة);
    أرجع طبق_المفتاح_الخاص_آر_إس_إيه(المفتاح, &المرمز);
}

عام مرادف rsa_public_key = مفتاح_آر_إس_إيه_عام;
عام مرادف rsa_private_key = مفتاح_آر_إس_إيه_خاص;
عام مرادف rsa_public_key_new = أنشئ_مفتاح_آر_إس_إيه_عام;
عام مرادف rsa_verify_pkcs1v15 = تحقق_آر_إس_إيه_بي_كي_سي_إس1;
عام مرادف rsa_verify_pss = تحقق_آر_إس_إيه_بي_إس_إس;
عام مرادف rsa_sign_pss = وقع_آر_إس_إيه_بي_إس_إس;
عام مرادف mgf1 = إم_جي_إف1;
