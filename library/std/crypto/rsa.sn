// RSA signatures (RFC 8017): RSASSA-PKCS1-v1_5 and RSASSA-PSS verification,
// and RSASSA-PSS signing with a CRT private key.
//
// Verification works on public values. Signing exponentiates with
// crypto.bignum's fixed-window Montgomery ladder over exponents padded to
// the prime length, recombines with Garner's formula and checks the result
// against the public key before releasing it (the fault-attack check used by
// Go crypto/rsa and BoringSSL). Moduli from 1024 to 8192 bits are accepted.

استورد crypto.bignum;
استورد crypto.digest;
استورد crypto.words;

عام نوع مفتاح_آر_إس_إيه_عام = {
    المعامل: متجه ط8,
    الأس: متجه ط8
};

عام نوع مفتاح_آر_إس_إيه_خاص = {
    العام: مفتاح_آر_إس_إيه_عام,
    الأولي_الأول: متجه ط8,
    الأولي_الثاني: متجه ط8,
    أس_الأول: متجه ط8,
    أس_الثاني: متجه ط8,
    معامل_الثاني: متجه ط8
};

عرف بلا_أصفار_بادئة_آر_إس_إيه(البايتات: &متجه ط8): متجه ط8 {
    دع الحجم: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    طالما (البداية < الحجم && (*البايتات)[البداية] == 0) { البداية := البداية + 1; }
    أرجع شريحة_بايتات_تشفير(البايتات, البداية, الحجم - البداية);
}

عام عرف أنشئ_مفتاح_آر_إس_إيه_عام(المعامل: &متجه ط8, الأس: &متجه ط8): مفتاح_آر_إس_إيه_عام {
    دع المفتاح: مفتاح_آر_إس_إيه_عام = {
        المعامل: بلا_أصفار_بادئة_آر_إس_إيه(المعامل),
        الأس: بلا_أصفار_بادئة_آر_إس_إيه(الأس)
    };
    أرجع المفتاح;
}

عام عرف بتات_مفتاح_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام): طبيعي {
    دع المعامل: &متجه ط8 = &(*المفتاح).المعامل;
    دع الحجم: طبيعي = الطول(*المعامل) مثل طبيعي;
    إذا (الحجم == 0) { أرجع 0; };
    دع الأول: متغير طبيعي = (*المعامل)[0] مثل طبيعي;
    دع البتات: متغير طبيعي = 0;
    طالما (الأول != 0) {
        البتات := البتات + 1;
        الأول := الأول >> 1;
    }
    أرجع (الحجم - 1) * 8 + البتات;
}

عرف مفتاح_عام_مقبول_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام): منطقي {
    دع البتات: طبيعي = بتات_مفتاح_آر_إس_إيه(المفتاح);
    إذا (البتات < 1024 || البتات > 8192) { أرجع خطأ; };
    دع الأس: &متجه ط8 = &(*المفتاح).الأس;
    دع حجم_الأس: طبيعي = الطول(*الأس) مثل طبيعي;
    إذا (حجم_الأس == 0 || حجم_الأس > 4) { أرجع خطأ; };
    إذا ((((*الأس)[حجم_الأس - 1] مثل طبيعي) & 1) == 0) { أرجع خطأ; };
    إذا (حجم_الأس == 1 && (*الأس)[0] < 3) { أرجع خطأ; };
    أرجع صواب;
}

// s^e mod n as k bytes, or none when s is not below n.
عرف طبق_المفتاح_العام_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_عام, التوقيع: &متجه ط8): اختياري متجه ط8 {
    إذا (!مفتاح_عام_مقبول_آر_إس_إيه(المفتاح)) { أرجع اختياري.لا_شيء(); };
    دع المعامل: &متجه ط8 = &(*المفتاح).المعامل;
    دع ك: طبيعي = الطول(*المعامل) مثل طبيعي;
    إذا ((الطول(*التوقيع) مثل طبيعي) != ك) { أرجع اختياري.لا_شيء(); };
    طابق أنشئ_سياق_مونتغمري(المعامل) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(السياق) -> {
        طابق عدد_كبير_من_بايتات(التوقيع, السياق.العدد) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(س) -> {
            إذا (قارن_كبير(&س, &السياق.المعامل) >= 0) { أرجع اختياري.لا_شيء(); };
            دع م: متجه طبيعي = أس_معياري_كبير(&س, &(*المفتاح).الأس, &السياق);
            أرجع اختياري.موجود(بايتات_من_عدد_كبير(&م, ك));
        };
    };
}

// DER DigestInfo prefix (RFC 8017 9.2 note 1) for the PKCS#1 v1.5 encoding.
عرف بادئة_معلومات_الملخص_آر_إس_إيه(الخوارزمية: خوارزمية_تجزئة): متجه ط8 {
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا256 -> {
        دع ب: متجه ط8 = [0x30, 0x31, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا384 -> {
        دع ب: متجه ط8 = [0x30, 0x41, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا512 -> {
        دع ب: متجه ط8 = [0x30, 0x51, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40];
        أرجع ب;
    }
    | خوارزمية_تجزئة.تجزئة_شا1 -> {
        دع ب: متجه ط8 = [];
        أرجع ب;
    };
}

// RSASSA-PKCS1-v1_5 verification of a message digest. SHA-1 is rejected.
عام عرف تحقق_آر_إس_إيه_بي_كي_سي_إس1(
    المفتاح: &مفتاح_آر_إس_إيه_عام,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه ط8,
    التوقيع: &متجه ط8
): منطقي {
    دع البادئة: متجه ط8 = بادئة_معلومات_الملخص_آر_إس_إيه(الخوارزمية);
    إذا ((الطول(البادئة) مثل طبيعي) == 0) { أرجع خطأ; };
    إذا ((الطول(*الملخص) مثل طبيعي) != حجم_ملخص_تجزئة(الخوارزمية)) { أرجع خطأ; };
    طابق طبق_المفتاح_العام_آر_إس_إيه(المفتاح, التوقيع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز) -> {
        دع ك: طبيعي = الطول(المرمز) مثل طبيعي;
        دع ت: طبيعي = (الطول(البادئة) مثل طبيعي) + (الطول(*الملخص) مثل طبيعي);
        إذا (ك < ت + 11) { أرجع خطأ; };
        دع المتوقع: متغير متجه ط8 = [0x00, 0x01];
        دع ف: متغير طبيعي = 0;
        طالما (ف < ك - ت - 3) {
            ألحق(المتوقع, 0xFF مثل ط8);
            ف := ف + 1;
        }
        ألحق(المتوقع, 0x00 مثل ط8);
        ألحق_بايتات_تشفير(&متغير المتوقع, &البادئة);
        ألحق_بايتات_تشفير(&متغير المتوقع, الملخص);
        أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&المتوقع, &المرمز);
    };
}

// MGF1 (RFC 8017 B.2.1).
عام عرف إم_جي_إف1(الخوارزمية: خوارزمية_تجزئة, البذرة: &متجه ط8, الطول_المطلوب: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع العداد: متغير طبيعي = 0;
    طالما ((الطول(الناتج) مثل طبيعي) < الطول_المطلوب) {
        دع المدخل: متغير متجه ط8 = [];
        ألحق_بايتات_تشفير(&متغير المدخل, البذرة);
        ألحق_كبير32_تشفير(&متغير المدخل, العداد);
        دع الملخص: متجه ط8 = جزئ_تشفير(الخوارزمية, &المدخل);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الملخص) مثل طبيعي) && (الطول(الناتج) مثل طبيعي) < الطول_المطلوب) {
            ألحق(الناتج, الملخص[ف]);
            ف := ف + 1;
        }
        العداد := العداد + 1;
    }
    أرجع الناتج;
}

// Mask for the leftmost byte: keeps the low (8 - zero_bits) bits.
عرف قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز: طبيعي): طبيعي {
    دع الصفرية: طبيعي = (8 - (بتات_الترميز % 8)) % 8;
    أرجع 0xFF >> الصفرية;
}

// EMSA-PSS-VERIFY (RFC 8017 9.1.2) with MGF1 over the same digest and a
// salt length equal to the digest length (the TLS 1.3 and X.509 profile).
عام عرف تحقق_آر_إس_إيه_بي_إس_إس(
    المفتاح: &مفتاح_آر_إس_إيه_عام,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه ط8,
    التوقيع: &متجه ط8
): منطقي {
    دع هاء_طول: طبيعي = حجم_ملخص_تجزئة(الخوارزمية);
    إذا ((الطول(*الملخص) مثل طبيعي) != هاء_طول) { أرجع خطأ; };
    طابق الخوارزمية مع
    | خوارزمية_تجزئة.تجزئة_شا1 -> { أرجع خطأ; }
    | _ -> { };
    طابق طبق_المفتاح_العام_آر_إس_إيه(المفتاح, التوقيع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المرمز_الكامل) -> {
        دع بتات_الترميز: طبيعي = بتات_مفتاح_آر_إس_إيه(المفتاح) - 1;
        دع طول_الترميز: طبيعي = (بتات_الترميز + 7) / 8;
        دع ك: طبيعي = الطول(المرمز_الكامل) مثل طبيعي;
        // When emLen < k the leading byte of the k-byte value must be zero.
        إذا (طول_الترميز < ك && المرمز_الكامل[0] != 0) { أرجع خطأ; };
        دع المرمز: متجه ط8 = شريحة_بايتات_تشفير(&المرمز_الكامل, ك - طول_الترميز, طول_الترميز);
        دع ملح_طول: طبيعي = هاء_طول;
        إذا (طول_الترميز < هاء_طول + ملح_طول + 2) { أرجع خطأ; };
        إذا (المرمز[طول_الترميز - 1] != 0xBC) { أرجع خطأ; };
        دع طول_قاعدة: طبيعي = طول_الترميز - هاء_طول - 1;
        دع المقنع: متجه ط8 = شريحة_بايتات_تشفير(&المرمز, 0, طول_قاعدة);
        دع هاء: متجه ط8 = شريحة_بايتات_تشفير(&المرمز, طول_قاعدة, هاء_طول);
        دع قناع_الأول: طبيعي = قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز);
        إذا (((المقنع[0] مثل طبيعي) & (قناع_الأول ^ 0xFF)) != 0) { أرجع خطأ; };
        دع قناع_القاعدة: متجه ط8 = إم_جي_إف1(الخوارزمية, &هاء, طول_قاعدة);
        دع القاعدة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < طول_قاعدة) {
            ألحق(القاعدة, ((المقنع[ف] مثل طبيعي) ^ (قناع_القاعدة[ف] مثل طبيعي)) مثل ط8);
            ف := ف + 1;
        }
        القاعدة[0] := ((القاعدة[0] مثل طبيعي) & قناع_الأول) مثل ط8;
        دع طول_الحشو: طبيعي = طول_الترميز - هاء_طول - ملح_طول - 2;
        ف := 0;
        طالما (ف < طول_الحشو) {
            إذا (القاعدة[ف] != 0) { أرجع خطأ; };
            ف := ف + 1;
        }
        إذا (القاعدة[طول_الحشو] != 0x01) { أرجع خطأ; };
        دع الملح: متجه ط8 = شريحة_بايتات_تشفير(&القاعدة, طول_قاعدة - ملح_طول, ملح_طول);
        دع م_شرطة: متغير متجه ط8 = أصفار_تشفير(8);
        ألحق_بايتات_تشفير(&متغير م_شرطة, الملخص);
        ألحق_بايتات_تشفير(&متغير م_شرطة, &الملح);
        دع هاء_شرطة: متجه ط8 = جزئ_تشفير(الخوارزمية, &م_شرطة);
        أرجع بايتات_متساوية_بزمن_ثابت_تشفير(&هاء, &هاء_شرطة);
    };
}

عرف بايتات_بطول_آر_إس_إيه(البايتات: &متجه ط8, الطول_المطلوب: طبيعي): متجه ط8 {
    دع النظيف: متجه ط8 = بلا_أصفار_بادئة_آر_إس_إيه(البايتات);
    دع الحجم: طبيعي = الطول(النظيف) مثل طبيعي;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = الحجم;
    طالما (ف < الطول_المطلوب) {
        ألحق(الناتج, 0 مثل ط8);
        ف := ف + 1;
    }
    ألحق_بايتات_تشفير(&متغير الناتج, &النظيف);
    أرجع الناتج;
}

// m^d mod n through CRT; none if the key is inconsistent or the result does
// not verify with the public exponent.
عرف طبق_المفتاح_الخاص_آر_إس_إيه(المفتاح: &مفتاح_آر_إس_إيه_خاص, الرسالة: &متجه ط8): اختياري متجه ط8 {
    دع العام: &مفتاح_آر_إس_إيه_عام = &(*المفتاح).العام;
    إذا (!مفتاح_عام_مقبول_آر_إس_إيه(العام)) { أرجع اختياري.لا_شيء(); };
    دع ك: طبيعي = الطول((*العام).المعامل) مثل طبيعي;
    إذا ((الطول(*الرسالة) مثل طبيعي) != ك) { أرجع اختياري.لا_شيء(); };
    طابق أنشئ_سياق_مونتغمري(&(*المفتاح).الأولي_الأول) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(سياق_ب) -> {
        طابق أنشئ_سياق_مونتغمري(&(*المفتاح).الأولي_الثاني) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(سياق_ق) -> {
            إذا (سياق_ب.العدد != سياق_ق.العدد) { أرجع اختياري.لا_شيء(); };
            دع ن: طبيعي = سياق_ب.العدد;
            طابق عدد_كبير_من_بايتات(الرسالة, 2 * ن) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(ج) -> {
                دع طول_ب: طبيعي = ن * 4;
                دع أس_ب: متجه ط8 = بايتات_بطول_آر_إس_إيه(&(*المفتاح).أس_الأول, طول_ب);
                دع أس_ق: متجه ط8 = بايتات_بطول_آر_إس_إيه(&(*المفتاح).أس_الثاني, طول_ب);
                دع ج_ب: متجه طبيعي = اختزل_كبير(&ج, &سياق_ب);
                دع ج_ق: متجه طبيعي = اختزل_كبير(&ج, &سياق_ق);
                دع م1: متجه طبيعي = أس_معياري_كبير(&ج_ب, &أس_ب, &سياق_ب);
                دع م2: متجه طبيعي = أس_معياري_كبير(&ج_ق, &أس_ق, &سياق_ق);
                // h = qInv * (m1 - m2) mod p; m = m2 + q * h.
                دع م2_ب: متجه طبيعي = اختزل_كبير(&م2, &سياق_ب);
                دع الفرق: متجه طبيعي = اطرح_معياري_كبير(&م1, &م2_ب, &سياق_ب);
                طابق عدد_كبير_من_بايتات(&(*المفتاح).معامل_الثاني, ن) مع
                | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                | اختياري.موجود(معكوس_ق) -> {
                    دع معكوس_ق_مختزل: متجه طبيعي = اختزل_كبير(&معكوس_ق, &سياق_ب);
                    دع معكوس_ق_م: متجه طبيعي = إلى_مونتغمري(&معكوس_ق_مختزل, &سياق_ب);
                    دع هاء: متجه طبيعي = اضرب_مونتغمري(&معكوس_ق_م, &الفرق, &سياق_ب);
                    دع ق_هاء: متجه طبيعي = اضرب_كامل_كبير(&سياق_ق.المعامل, &هاء);
                    دع م: متجه طبيعي = اجمع_كامل_كبير(&م2, &ق_هاء);
                    دع التوقيع: متجه ط8 = بايتات_من_عدد_كبير(&م, ك);
                    طابق طبق_المفتاح_العام_آر_إس_إيه(العام, &التوقيع) مع
                    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
                    | اختياري.موجود(المسترجع) -> {
                        إذا (!بايتات_متساوية_بزمن_ثابت_تشفير(&المسترجع, الرسالة)) { أرجع اختياري.لا_شيء(); };
                        أرجع اختياري.موجود(التوقيع);
                    };
                };
            };
        };
    };
}

// RSASSA-PSS signature of a digest with salt length equal to the digest
// length. الملح must be HashLen fresh random bytes from the OS CSPRNG.
عام عرف وقع_آر_إس_إيه_بي_إس_إس(
    المفتاح: &مفتاح_آر_إس_إيه_خاص,
    الخوارزمية: خوارزمية_تجزئة,
    الملخص: &متجه ط8,
    الملح: &متجه ط8
): اختياري متجه ط8 {
    دع هاء_طول: طبيعي = حجم_ملخص_تجزئة(الخوارزمية);
    إذا ((الطول(*الملخص) مثل طبيعي) != هاء_طول || (الطول(*الملح) مثل طبيعي) != هاء_طول) {
        أرجع اختياري.لا_شيء();
    };
    دع العام: &مفتاح_آر_إس_إيه_عام = &(*المفتاح).العام;
    دع بتات_الترميز: طبيعي = بتات_مفتاح_آر_إس_إيه(العام) - 1;
    دع طول_الترميز: طبيعي = (بتات_الترميز + 7) / 8;
    إذا (طول_الترميز < 2 * هاء_طول + 2) { أرجع اختياري.لا_شيء(); };
    دع م_شرطة: متغير متجه ط8 = أصفار_تشفير(8);
    ألحق_بايتات_تشفير(&متغير م_شرطة, الملخص);
    ألحق_بايتات_تشفير(&متغير م_شرطة, الملح);
    دع هاء: متجه ط8 = جزئ_تشفير(الخوارزمية, &م_شرطة);
    دع طول_قاعدة: طبيعي = طول_الترميز - هاء_طول - 1;
    دع القاعدة: متغير متجه ط8 = أصفار_تشفير(طول_قاعدة - هاء_طول - 1);
    ألحق(القاعدة, 0x01 مثل ط8);
    ألحق_بايتات_تشفير(&متغير القاعدة, الملح);
    دع القناع: متجه ط8 = إم_جي_إف1(الخوارزمية, &هاء, طول_قاعدة);
    دع المرمز: متغير متجه ط8 = [];
    دع ك: طبيعي = الطول((*العام).المعامل) مثل طبيعي;
    دع ف: متغير طبيعي = طول_الترميز;
    طالما (ف < ك) {
        ألحق(المرمز, 0 مثل ط8);
        ف := ف + 1;
    }
    دع بداية_القاعدة: طبيعي = الطول(المرمز) مثل طبيعي;
    ف := 0;
    طالما (ف < طول_قاعدة) {
        ألحق(المرمز, ((القاعدة[ف] مثل طبيعي) ^ (القناع[ف] مثل طبيعي)) مثل ط8);
        ف := ف + 1;
    }
    دع قناع_الأول: طبيعي = قناع_البايت_الأول_آر_إس_إيه(بتات_الترميز);
    المرمز[بداية_القاعدة] := ((المرمز[بداية_القاعدة] مثل طبيعي) & قناع_الأول) مثل ط8;
    ألحق_بايتات_تشفير(&متغير المرمز, &هاء);
    ألحق(المرمز, 0xBC مثل ط8);
    امسح_بايتات_تشفير(&متغير القاعدة);
    أرجع طبق_المفتاح_الخاص_آر_إس_إيه(المفتاح, &المرمز);
}

عام مرادف rsa_public_key = مفتاح_آر_إس_إيه_عام;
عام مرادف rsa_private_key = مفتاح_آر_إس_إيه_خاص;
عام مرادف rsa_public_key_new = أنشئ_مفتاح_آر_إس_إيه_عام;
عام مرادف rsa_verify_pkcs1v15 = تحقق_آر_إس_إيه_بي_كي_سي_إس1;
عام مرادف rsa_verify_pss = تحقق_آر_إس_إيه_بي_إس_إس;
عام مرادف rsa_sign_pss = وقع_آر_إس_إيه_بي_إس_إس;
عام مرادف mgf1 = إم_جي_إف1;
