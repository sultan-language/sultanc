استورد text.from_bytes;
استورد text.compare;
استورد fs.path;

مرادف افتح_دليلا_داخليا = بدائي_فتح_دليل;
مرادف اقرأ_مدخل_دليل_داخليا = بدائي_قراءة_مدخل_دليل;
مرادف أغلق_دليلا_داخليا = بدائي_إغلاق_دليل;

عام نوع نوع_مدخل_دليل =
    | ملف
    | دليل
    | وصلة_رمزية
    | آخر
;

عام نوع مدخل_دليل = {
    الاسم: نص,
    النوع: نوع_مدخل_دليل
};

عرف ابن_مخزن_اسم_دليل(): متجه غ8 {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4096) {
        ألحق(المخزن, 0 مثل غ8);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عرف نص_مدخل_من_مخزن(المخزن: &متجه غ8, العدد: غير_موقع): نص {
    دع القيمة: متجه غ8 = *المخزن;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف مدخل_خاص_بالدليل(الاسم: &نص): منطقي {
    دع نقطة: نص = «.»;
    دع نقطتان: نص = «..»;
    لو (نصان_متساويان(الاسم, &نقطة)) { أرجع صواب; };
    أرجع نصان_متساويان(الاسم, &نقطتان);
}

// Public directory enumeration owns the opaque runtime handle for the entire
// operation. No descriptor/DIR handle escapes into a copyable std value.
عرف نوع_مدخل_من_رمز(الرمز: عدد): نوع_مدخل_دليل {
    لو (الرمز == 1) { أرجع نوع_مدخل_دليل.ملف(); };
    لو (الرمز == 2) { أرجع نوع_مدخل_دليل.دليل(); };
    لو (الرمز == 3) { أرجع نوع_مدخل_دليل.وصلة_رمزية(); };
    أرجع نوع_مدخل_دليل.آخر();
}

عام عرف اقرأ_مدخلات_الدليل(المسار: &نص): نتيجة متجه مدخل_دليل, عدد {
    دع المقبض: عدد = افتح_دليلا_داخليا(*المسار);
    لو (المقبض < 0) { أرجع نتيجة.خطأ(المقبض); };

    دع الناتج: متغير متجه مدخل_دليل = [];
    دع المخزن: متغير متجه غ8 = ابن_مخزن_اسم_دليل();
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المقروء: عدد = اقرأ_مدخل_دليل_داخليا(المقبض, المخزن, 0, 4096);
        لو (المقروء < 0) {
            أغلق_دليلا_داخليا(المقبض);
            أرجع نتيجة.خطأ(المقروء);
        } وإلا لو (المقروء == 0) {
            مستمر := خطأ;
        } وإلا {
            دع رمز_النوع: عدد = المقروء / 4096;
            دع طول_الاسم: عدد = المقروء % 4096;
            دع العدد: غير_موقع = طول_الاسم مثل غير_موقع;
            دع الاسم: نص = نص_مدخل_من_مخزن(&المخزن, العدد);
            لو (!مدخل_خاص_بالدليل(&الاسم)) {
                دع النوع: نوع_مدخل_دليل = نوع_مدخل_من_رمز(رمز_النوع);
                دع المدخل: مدخل_دليل = { الاسم: الاسم, النوع: النوع };
                ألحق(الناتج, المدخل);
            };
        };
    }

    دع حالة_الإغلاق: عدد = أغلق_دليلا_داخليا(المقبض);
    لو (حالة_الإغلاق < 0) { أرجع نتيجة.خطأ(حالة_الإغلاق); };
    أرجع نتيجة.نجح(الناتج);
}

عرف ابحث_عن_مدخل_في_الدليل(
    المداخل: &متجه مدخل_دليل,
    الاسم: &نص
): اختيار نوع_مدخل_دليل {
    دع القيم: متجه مدخل_دليل = *المداخل;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&القيم[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(القيم[ف].النوع);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Directory support is enough to answer existence without hiding host errors:
// enumerate the parent and distinguish a missing name from an unreadable parent.
عام عرف حاول_نوع_مدخل_المسار(المسار: &نص): نتيجة اختيار نوع_مدخل_دليل, عدد {
    دع المطبع: نص = طبع_المسار(المسار);
    دع الجذر: نص = «/»;
    دع الحالي: نص = «.»;

    لو (نصان_متساويان(&المطبع, &الجذر) || نصان_متساويان(&المطبع, &الحالي)) {
        طابق اقرأ_مدخلات_الدليل(&المطبع) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(اختيار.بعض(نوع_مدخل_دليل.دليل())); };
    };

    طابق اسم_الملف(&المطبع) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
    | اختيار.بعض(الاسم) -> {
        طابق أب_المسار(&المطبع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(اختيار.لا_شيء()); }
        | اختيار.بعض(الأب) -> {
            طابق اقرأ_مدخلات_الدليل(&الأب) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المداخل) -> {
                أرجع نتيجة.نجح(ابحث_عن_مدخل_في_الدليل(&المداخل, &الاسم));
            };
        };
    };
}

عام عرف حاول_وجود_المسار(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.بعض(_) -> { أرجع نتيجة.نجح(صواب); }
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); };
    };
}

عام عرف حاول_مسار_ملف(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.ملف -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام عرف حاول_مسار_دليل(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام عرف حاول_مسار_وصلة_رمزية(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.وصلة_رمزية -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام مرادف directory_entry_type = نوع_مدخل_دليل;
عام مرادف directory_entry = مدخل_دليل;
عام مرادف directory_entry_type.file = نوع_مدخل_دليل.ملف;
عام مرادف directory_entry_type.directory = نوع_مدخل_دليل.دليل;
عام مرادف directory_entry_type.symlink = نوع_مدخل_دليل.وصلة_رمزية;
عام مرادف directory_entry_type.other = نوع_مدخل_دليل.آخر;
عام مرادف list_directory = اقرأ_مدخلات_الدليل;
عام مرادف try_path_entry_type = حاول_نوع_مدخل_المسار;
عام مرادف try_exists = حاول_وجود_المسار;
عام مرادف try_is_file = حاول_مسار_ملف;
عام مرادف try_is_directory = حاول_مسار_دليل;
عام مرادف try_is_symlink = حاول_مسار_وصلة_رمزية;
