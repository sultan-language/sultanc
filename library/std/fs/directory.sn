استورد text.from_bytes;
استورد text.compare;
استورد fs.metadata;
استورد fs.error;

استورد os.directory;
استورد os.error;
عام نوع نوع_مدخل_دليل =
    | ملف
    | دليل
    | وصلة_رمزية
    | آخر
;

عام نوع مدخل_دليل = {
    الاسم: نص,
    النوع: نوع_مدخل_دليل
};

عرف ابن_مخزن_اسم_دليل(): متجه غ8 {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4096) {
        ألحق(المخزن, 0 مثل غ8);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عرف نص_مدخل_من_مخزن(المخزن: &متجه غ8, العدد: غير_موقع): نص {
    دع القيمة: متجه غ8 = *المخزن;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف مدخل_خاص_بالدليل(الاسم: &نص): منطقي {
    دع نقطة: نص = «.»;
    دع نقطتان: نص = «..»;
    لو (نصان_متساويان(الاسم, &نقطة)) { أرجع صواب; };
    أرجع نصان_متساويان(الاسم, &نقطتان);
}

// Native directory listing owns and closes its platform resource in std.os.
عرف نوع_مدخل_من_رمز(الرمز: عدد): نوع_مدخل_دليل {
    لو (الرمز == 1) { أرجع نوع_مدخل_دليل.ملف(); };
    لو (الرمز == 2) { أرجع نوع_مدخل_دليل.دليل(); };
    لو (الرمز == 3) { أرجع نوع_مدخل_دليل.وصلة_رمزية(); };
    أرجع نوع_مدخل_دليل.آخر();
}

عام عرف اقرأ_مدخلات_الدليل(المسار: &نص): نتيجة متجه مدخل_دليل, عدد {
    طابق اقرأ_مداخل_دليل_النظام(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(المداخل) -> {
        دع الناتج: متغير متجه مدخل_دليل = [];
        دع الموضع: متغير غير_موقع = 0;
        بينما (الموضع < (الطول(المداخل) مثل غير_موقع)) {
            // Borrow the OS entry; its owned name bytes stay in المداخل.
            دع المصدر: &مدخل_نظام = &المداخل[الموضع];
            دع الاسم: نص = من_بايتات(&(*المصدر).الاسم);
            لو (!مدخل_خاص_بالدليل(&الاسم)) {
                دع المدخل: مدخل_دليل = {
                    الاسم: الاسم, النوع: نوع_مدخل_من_رمز((*المصدر).النوع)
                };
                ألحق(الناتج, المدخل);
            };
            الموضع := الموضع + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    };
}

// Check the actual path, not a normalized spelling or the last directory
// entry. "link/.." and "file/" must reach the filesystem unchanged.
// Metadata is the single std owner of path-type queries; the OS layer owns
// whether its path-type primitive observes symbolic links or their targets.
عرف نوع_مدخل_من_نوع_مسار(النوع: نوع_مسار): نوع_مدخل_دليل {
    طابق النوع مع
    | نوع_مسار.ملف -> { أرجع نوع_مدخل_دليل.ملف(); }
    | نوع_مسار.دليل -> { أرجع نوع_مدخل_دليل.دليل(); }
    | نوع_مسار.وصلة_رمزية -> { أرجع نوع_مدخل_دليل.وصلة_رمزية(); }
    | نوع_مسار.آخر -> { أرجع نوع_مدخل_دليل.آخر(); };
}

عام عرف حاول_نوع_مدخل_المسار(المسار: &نص): نتيجة اختيار نوع_مدخل_دليل, عدد {
    طابق حاول_نوع_المسار(المسار) مع
    | نتيجة.نجح(النوع) -> {
        أرجع نتيجة.نجح(اختيار.بعض(نوع_مدخل_من_نوع_مسار(النوع)));
    }
    | نتيجة.خطأ(الخطأ) -> {
        لو (هل_خطأ_غير_موجود(الخطأ)) {
            أرجع نتيجة.نجح(اختيار.لا_شيء());
        };
        أرجع نتيجة.خطأ(الخطأ);
    };
}

عام عرف حاول_وجود_المسار(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.بعض(_) -> { أرجع نتيجة.نجح(صواب); }
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); };
    };
}

عام عرف حاول_مسار_ملف(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.ملف -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام عرف حاول_مسار_دليل(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.دليل -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام عرف حاول_مسار_وصلة_رمزية(المسار: &نص): نتيجة منطقي, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(خطأ); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.وصلة_رمزية -> { أرجع نتيجة.نجح(صواب); }
            | _ -> { أرجع نتيجة.نجح(خطأ); };
        };
    };
}

عام مرادف directory_entry_type = نوع_مدخل_دليل;
عام مرادف directory_entry = مدخل_دليل;
عام مرادف directory_entry_type.file = نوع_مدخل_دليل.ملف;
عام مرادف directory_entry_type.directory = نوع_مدخل_دليل.دليل;
عام مرادف directory_entry_type.symlink = نوع_مدخل_دليل.وصلة_رمزية;
عام مرادف directory_entry_type.other = نوع_مدخل_دليل.آخر;
عام مرادف list_directory = اقرأ_مدخلات_الدليل;
عام مرادف try_path_entry_type = حاول_نوع_مدخل_المسار;
عام مرادف try_exists = حاول_وجود_المسار;
عام مرادف try_is_file = حاول_مسار_ملف;
عام مرادف try_is_directory = حاول_مسار_دليل;
عام مرادف try_is_symlink = حاول_مسار_وصلة_رمزية;
