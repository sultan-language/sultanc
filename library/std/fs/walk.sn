استورد fs.directory;
استورد fs.mutation;
استورد fs.path;
استورد fs.read_file;
استورد text.compare;

عام نوع مدخل_اجتياز = { المسار: نص, النوع: نوع_مدخل_دليل, العمق: غير_موقع };

عرف اجتز_فرعا(المسار: &نص, العمق: غير_موقع, الناتج: &متغير متجه مدخل_اجتياز): نتيجة عدد, عدد {
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع الطفل: نص = صل_المسار(المسار, &المداخل[ف].الاسم);
            دع سجل: مدخل_اجتياز = { المسار: الطفل, النوع: المداخل[ف].النوع, العمق: العمق };
            ألحق(*الناتج, سجل);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { طابق اجتز_فرعا(&الطفل, العمق + 1, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { }; }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الطول(*الناتج));
    };
}

عام عرف اجتز_الشجرة(الجذر: &نص): نتيجة متجه مدخل_اجتياز, عدد {
    دع الناتج: متغير متجه مدخل_اجتياز = [];
    طابق اجتز_فرعا(الجذر, 0, &متغير الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج); };
}

عام عرف أنشئ_مسار_الدليل(المسار: &نص): نتيجة عدد, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.بعض(نوع_مدخل_دليل.دليل) -> { أرجع نتيجة.نجح(0); }
        | اختيار.بعض(_) -> { أرجع نتيجة.خطأ(-17); }
        | اختيار.لا_شيء -> { };
    };
    طابق أب_المسار(المسار) مع
    | اختيار.بعض(الأب) -> {
        دع نقطة: نص = «.»; دع جذر: نص = «/»;
        لو ((!نصان_متساويان(&الأب, &نقطة)) && (!نصان_متساويان(&الأب, &جذر))) {
            طابق أنشئ_مسار_الدليل(&الأب) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
        };
    }
    | اختيار.لا_شيء -> { };
    أرجع أنشئ_دليلا(المسار);
}

عام عرف احذف_الشجرة(المسار: &نص): نتيجة عدد, عدد {
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.دليل -> {
                طابق اقرأ_مدخلات_الدليل(المسار) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(المداخل) -> {
                    دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
                        دع الطفل: نص = صل_المسار(المسار, &المداخل[ف].الاسم);
                        طابق احذف_الشجرة(&الطفل) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
                        ف := ف + 1;
                    }
                    أرجع أزل_دليلا(المسار);
                };
            }
            | _ -> { أرجع أزل_ملفا(المسار); };
        };
    };
}

عام عرف انسخ_الشجرة(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    طابق حاول_نوع_مدخل_المسار(المصدر) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(-2); }
        | اختيار.بعض(النوع) -> {
            طابق النوع مع
            | نوع_مدخل_دليل.ملف -> { أرجع انسخ_الملف(المصدر, الوجهة); }
            | نوع_مدخل_دليل.دليل -> {
                طابق أنشئ_مسار_الدليل(الوجهة) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
                طابق اقرأ_مدخلات_الدليل(المصدر) مع
                | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
                | نتيجة.نجح(المداخل) -> {
                    دع الكلي: متغير عدد = 0; دع ف: متغير غير_موقع = 0;
                    بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
                        دع م: نص = صل_المسار(المصدر, &المداخل[ف].الاسم); دع و: نص = صل_المسار(الوجهة, &المداخل[ف].الاسم);
                        طابق انسخ_الشجرة(&م, &و) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(ن) -> { الكلي := الكلي + ن; };
                        ف := ف + 1;
                    }
                    أرجع نتيجة.نجح(الكلي);
                };
            }
            | _ -> { أرجع نتيجة.خطأ(-95); };
        };
    };
}

عام نوع walk_entry = مدخل_اجتياز;
عام مرادف walk = اجتز_الشجرة;
عام مرادف create_dir_all = أنشئ_مسار_الدليل;
عام مرادف remove_tree = احذف_الشجرة;
عام مرادف copy_tree = انسخ_الشجرة;
