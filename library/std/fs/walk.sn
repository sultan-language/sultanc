استورد fs.directory;
استورد fs.mutation;
استورد fs.path;
استورد fs.error;
استورد fs.read_file;
استورد text.compare;

عام نوع مدخل_اجتياز = { المسار: نص, النوع: نوع_مدخل_دليل, العمق: غير_موقع };

عرف اجتز_فرعا(المسار: &نص, العمق: غير_موقع, الصيغة: صيغة_مسار, الناتج: &متغير متجه مدخل_اجتياز): نتيجة عدد, عدد {
    طابق اقرأ_مدخلات_الدليل(المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(المداخل) -> {
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(المداخل) مثل غير_موقع)) {
            دع الطفل: نص = صل_المسار_بصيغة(المسار, &المداخل[ف].الاسم, الصيغة);
            دع سجل: مدخل_اجتياز = { المسار: الطفل, النوع: المداخل[ف].النوع, العمق: العمق };
            ألحق(*الناتج, سجل);
            طابق المداخل[ف].النوع مع
            | نوع_مدخل_دليل.دليل -> { طابق اجتز_فرعا(&الطفل, العمق + 1, الصيغة, الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { }; }
            | _ -> { };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(الطول(*الناتج));
    };
}

عام عرف اجتز_الشجرة_بصيغة(الجذر: &نص, الصيغة: صيغة_مسار): نتيجة متجه مدخل_اجتياز, عدد {
    دع الناتج: متغير متجه مدخل_اجتياز = [];
    طابق اجتز_فرعا(الجذر, 0, الصيغة, &متغير الناتج) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج); };
}

عام عرف اجتز_الشجرة(الجذر: &نص): نتيجة متجه مدخل_اجتياز, عدد {
    أرجع اجتز_الشجرة_بصيغة(الجذر, صيغة_مسار.يونكس());
}

// Root paths and prefix-only paths are already interpreted by the OS.
// "C:" is a drive-relative current directory, not a directory to create.
عرف هل_أصل_مسار(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    دع نقطة: نص = «.»;
    لو (نصان_متساويان(المسار, &نقطة)) { أرجع صواب; };
    طابق جذر_المسار_بصيغة(المسار, الصيغة) مع
    | اختيار.بعض(الجذر) -> {
        لو (نصان_متساويان(المسار, &الجذر)) { أرجع صواب; };
    }
    | اختيار.لا_شيء -> { };
    طابق بادئة_المسار_بصيغة(المسار, الصيغة) مع
    | اختيار.بعض(البادئة) -> {
        لو (نصان_متساويان(المسار, &البادئة)) { أرجع صواب; };
    }
    | اختيار.لا_شيء -> { };
    أرجع خطأ;
}

عام عرف أنشئ_مسار_الدليل_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): نتيجة عدد, عدد {
    لو (الطول(*المسار) == 0) { أرجع أنشئ_دليلا(المسار); };
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.بعض(نوع_مدخل_دليل.دليل) -> { أرجع نتيجة.نجح(0); }
        | اختيار.بعض(_) -> { أرجع أنشئ_دليلا(المسار); }
        | اختيار.لا_شيء -> { };
    };
    طابق أب_المسار_بصيغة(المسار, الصيغة) مع
    | اختيار.بعض(الأب) -> {
        لو (!هل_أصل_مسار(&الأب, الصيغة)) {
            طابق أنشئ_مسار_الدليل_بصيغة(&الأب, الصيغة) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        };
    }
    | اختيار.لا_شيء -> { };
    // Another creator may have created the directory since the lookup.
    طابق أنشئ_دليلا(المسار) مع
    | نتيجة.نجح(الحالة) -> { أرجع نتيجة.نجح(الحالة); }
    | نتيجة.خطأ(الخطأ) -> {
        طابق صنف_خطأ_نظام(الخطأ) مع
        | فئة_خطأ_نظام.موجود_مسبقا -> {
            طابق حاول_مسار_دليل(المسار) مع
            | نتيجة.خطأ(فشل) -> { أرجع نتيجة.خطأ(فشل); }
            | نتيجة.نجح(هل_دليل) -> {
                لو (هل_دليل) { أرجع نتيجة.نجح(0); };
                أرجع نتيجة.خطأ(الخطأ);
            };
        }
        | _ -> { أرجع نتيجة.خطأ(الخطأ); };
    };
}

عام عرف أنشئ_مسار_الدليل(المسار: &نص): نتيجة عدد, عدد {
    أرجع أنشئ_مسار_الدليل_بصيغة(المسار, صيغة_مسار.يونكس());
}

// A directory listing already supplies the entry type. Carry it through the
// operation rather than looking up each child again: a link must not turn into
// a recursive traversal because metadata observes its target. Entries of
// unknown type are never assumed to be directories.
عرف احذف_مدخل_شجرة(
    المسار: &نص, النوع: نوع_مدخل_دليل, الصيغة: صيغة_مسار
): نتيجة عدد, عدد {
    طابق النوع مع
    | نوع_مدخل_دليل.دليل -> {
        طابق اقرأ_مدخلات_الدليل(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المداخل) -> {
            دع الفهرس: متغير غير_موقع = 0;
            بينما (الفهرس < (الطول(المداخل) مثل غير_موقع)) {
                دع الطفل: نص = صل_المسار_بصيغة(المسار, &المداخل[الفهرس].الاسم, الصيغة);
                طابق احذف_مدخل_شجرة(&الطفل, المداخل[الفهرس].النوع, الصيغة) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
                الفهرس := الفهرس + 1;
            }
            أرجع أزل_دليلا(المسار);
        };
    }
    | _ -> { أرجع أزل_ملفا(المسار); };
}

عام عرف احذف_الشجرة_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): نتيجة عدد, عدد {
    // Refuse a volume root and the current directory. Neither has a parent
    // that tree deletion can safely remove. This is a lexical safety check;
    // OS-level directory handles are needed to make traversal race-safe.
    دع المطبوع: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    لو (هل_أصل_مسار(&المطبوع, الصيغة)) { أرجع نتيجة.خطأ(-22); };
    طابق حاول_نوع_مدخل_المسار(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); }
        | اختيار.بعض(النوع) -> { أرجع احذف_مدخل_شجرة(المسار, النوع, الصيغة); };
    };
}

عام عرف احذف_الشجرة(المسار: &نص): نتيجة عدد, عدد {
    أرجع احذف_الشجرة_بصيغة(المسار, صيغة_مسار.يونكس());
}

// Do not follow listed symbolic links. Copying a link itself requires an OS
// readlink/create-link interface; silently copying its target is incorrect.
عرف انسخ_مدخل_شجرة(
    المصدر: &نص, الوجهة: &نص, النوع: نوع_مدخل_دليل, الصيغة: صيغة_مسار
): نتيجة عدد, عدد {
    طابق النوع مع
    | نوع_مدخل_دليل.ملف -> { أرجع انسخ_الملف(المصدر, الوجهة); }
    | نوع_مدخل_دليل.دليل -> {
        طابق أنشئ_مسار_الدليل_بصيغة(الوجهة, الصيغة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        طابق اقرأ_مدخلات_الدليل(المصدر) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المداخل) -> {
            دع الكلي: متغير عدد = 0;
            دع الفهرس: متغير غير_موقع = 0;
            بينما (الفهرس < (الطول(المداخل) مثل غير_موقع)) {
                دع مدخل_المصدر: نص = صل_المسار_بصيغة(
                    المصدر, &المداخل[الفهرس].الاسم, الصيغة
                );
                دع مدخل_الوجهة: نص = صل_المسار_بصيغة(
                    الوجهة, &المداخل[الفهرس].الاسم, الصيغة
                );
                طابق انسخ_مدخل_شجرة(
                    &مدخل_المصدر, &مدخل_الوجهة, المداخل[الفهرس].النوع, الصيغة
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(العدد) -> { الكلي := الكلي + العدد; };
                الفهرس := الفهرس + 1;
            }
            أرجع نتيجة.نجح(الكلي);
        };
    }
    | _ -> { أرجع نتيجة.خطأ(-95); };
}

// Catch lexical self/subtree copies before creating the destination. This is
// deliberately not filesystem canonicalization: hard links, symlinks, short
// names and case-insensitive aliases require an OS identity facility.
عرف هل_الوجهة_داخل_المصدر(
    المصدر: &نص, الوجهة: &نص, الصيغة: صيغة_مسار
): منطقي {
    دع الأصل: نص = طبع_المسار_بصيغة(المصدر, الصيغة);
    دع الهدف: نص = طبع_المسار_بصيغة(الوجهة, الصيغة);
    لو (نصان_متساويان(&الأصل, &الهدف)) { أرجع صواب; };

    // Every ordinary relative child is inside the current working directory.
    دع نقطة: نص = «.»;
    لو (نصان_متساويان(&الأصل, &نقطة)) {
        لو (مسار_مطلق_بصيغة(&الهدف, الصيغة) || للمسار_جذر_بصيغة(&الهدف, الصيغة)) {
            أرجع خطأ;
        };
        طابق بادئة_المسار_بصيغة(&الهدف, الصيغة) مع
        | اختيار.بعض(_) -> { أرجع خطأ; }
        | اختيار.لا_شيء -> { };
        دع بادئة: نص = «..»;
        لو (نصان_متساويان(&الهدف, &بادئة)) { أرجع خطأ; };
        لو ((الطول(الهدف) >= 3) &&
            (الهدف[0] == 0x2E) && (الهدف[1] == 0x2E) &&
            (الهدف[2] == فاصل_المسار_بصيغة(الصيغة))) {
            أرجع خطأ;
        };
        أرجع صواب;
    };
    دع طول_الأصل: غير_موقع = الطول(الأصل) مثل غير_موقع;
    دع طول_الهدف: غير_موقع = الطول(الهدف) مثل غير_موقع;
    لو (طول_الهدف <= طول_الأصل) { أرجع خطأ; };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < طول_الأصل) {
        لو (الأصل[الفهرس] != الهدف[الفهرس]) { أرجع خطأ; };
        الفهرس := الفهرس + 1;
    }
    دع الفاصل: غ8 = فاصل_المسار_بصيغة(الصيغة);
    طابق بادئة_المسار_بصيغة(&الأصل, الصيغة) مع
    | اختيار.بعض(البادئة) -> {
        لو (نصان_متساويان(&الأصل, &البادئة) &&
            (الأصل[طول_الأصل - 1] == 0x3A)) { أرجع صواب; };
    }
    | اختيار.لا_شيء -> { };
    لو ((الأصل[طول_الأصل - 1] == الفاصل) || (الهدف[طول_الأصل] == الفاصل)) {
        أرجع صواب;
    };
    أرجع خطأ;
}

عام عرف انسخ_الشجرة_بصيغة(
    المصدر: &نص, الوجهة: &نص, الصيغة: صيغة_مسار
): نتيجة عدد, عدد {
    // Copying onto itself destroys files, and recursive copying into the
    // source requires an OS identity check to avoid walking the new output.
    لو (هل_الوجهة_داخل_المصدر(المصدر, الوجهة, الصيغة)) {
        أرجع نتيجة.خطأ(-22);
    };
    طابق حاول_نوع_مدخل_المسار(المصدر) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الموجود) -> {
        طابق الموجود مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(-2); }
        | اختيار.بعض(النوع) -> {
            أرجع انسخ_مدخل_شجرة(المصدر, الوجهة, النوع, الصيغة);
        };
    };
}

عام عرف انسخ_الشجرة(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    أرجع انسخ_الشجرة_بصيغة(المصدر, الوجهة, صيغة_مسار.يونكس());
}

عام نوع walk_entry = مدخل_اجتياز;
عام مرادف walk = اجتز_الشجرة;
عام مرادف create_dir_all = أنشئ_مسار_الدليل;
عام مرادف remove_tree = احذف_الشجرة;
عام مرادف copy_tree = انسخ_الشجرة;
عام مرادف walk_for = اجتز_الشجرة_بصيغة;
عام مرادف create_dir_all_for = أنشئ_مسار_الدليل_بصيغة;
عام مرادف remove_tree_for = احذف_الشجرة_بصيغة;
عام مرادف copy_tree_for = انسخ_الشجرة_بصيغة;
