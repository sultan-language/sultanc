استورد fs.error;
استورد fs.path;
استورد fs.links;
استورد fs.attributes;
استورد env.environment;
استورد text.from_bytes;
استورد os.error;

// Absolute and canonical paths (Rust std::path::absolute and fs::canonicalize,
// Go filepath.Abs and filepath.EvalSymlinks). The path flavor is the host's.

// صيغة_مسار_المضيف, the host flavor, is defined by std.fs.path.

// المسار joined to the working directory when it is relative, then
// normalized lexically (std.fs.path: "." is dropped, ".." is kept, since
// "link/.." need not be the link's parent). The path need not exist.
عام عرف حول_إلى_مسار_مطلق(المسار: &نص): نتيجة نص, فئة_خطأ_نظام {
    إذا (الطول(*المسار) == 0) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    دع الصيغة: صيغة_مسار = صيغة_مسار_المضيف();
    إذا (مسار_مطلق_بصيغة(المسار, الصيغة)) { أرجع نتيجة.نجح(طبع_المسار_بصيغة(المسار, الصيغة)); };
    طابق دليل_العمل() مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(صنف_خطأ_نظام(الرمز)); }
    | نتيجة.نجح(الدليل) -> {
        دع الموصول: نص = صل_المسار_بصيغة(&الدليل, المسار, الصيغة);
        أرجع نتيجة.نجح(طبع_المسار_بصيغة(&الموصول, الصيغة));
    };
}

// Components of a POSIX path, without empty and "." components.
عرف مكونات_يونكس(المسار: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الحالي: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف <= العدد) {
        إذا (ف == العدد || (*المسار)[ف] == 0x2F) {
            دع نقطة: منطقي = (الطول(الحالي) مثل طبيعي) == 1 && الحالي[0] == 0x2E;
            إذا ((الطول(الحالي) مثل طبيعي) > 0 && !نقطة) {
                ألحق(الناتج, من_بايتات(&الحالي));
            };
            دع فارغ: متجه ط8 = [];
            الحالي := فارغ;
        } وإلا {
            ألحق(الحالي, (*المسار)[ف]);
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف صل_مكونات_يونكس(المكونات: &متجه نص, الإضافي: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المكونات) مثل طبيعي)) {
        ألحق(البايتات, 0x2F);
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(&(*المكونات)[ف]));
        ف := ف + 1;
    }
    إذا ((الطول(*الإضافي) مثل طبيعي) > 0) {
        ألحق(البايتات, 0x2F);
        ألحق_بايتات_نص(&متغير البايتات, انسخ_نص(الإضافي));
    };
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { ألحق(البايتات, 0x2F); };
    أرجع من_بايتات(&البايتات);
}

// POSIX resolution, component by component: ".." removes the last resolved
// component, a symbolic link is replaced by its target (an absolute target
// restarts from the root), at most 40 links are followed (Linux's
// MAXSYMLINKS), and every component must exist.
عرف مسار_قانوني_يونكس(المسار: &نص): نتيجة نص, فئة_خطأ_نظام {
    طابق حول_إلى_مسار_مطلق(المسار) مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(المطلق) -> {
        // الباقي holds the pending components in reverse order.
        دع الأولى: متجه نص = مكونات_يونكس(&المطلق);
        دع الباقي: متغير متجه نص = [];
        دع ف: متغير طبيعي = الطول(الأولى) مثل طبيعي;
        طالما (ف > 0) { ف := ف - 1; ألحق(الباقي, انسخ_نص(&الأولى[ف])); }
        دع المحلول: متغير متجه نص = [];
        دع القفزات: متغير طبيعي = 0;
        دع الفارغ_نص: نص = «»;
        طالما ((الطول(الباقي) مثل طبيعي) > 0) {
            دع الأخير: طبيعي = (الطول(الباقي) مثل طبيعي) - 1;
            دع المكون: نص = انسخ_نص(&الباقي[الأخير]);
            دع المختصر: متغير متجه نص = [];
            ف := 0;
            طالما (ف < الأخير) { ألحق(المختصر, انسخ_نص(&الباقي[ف])); ف := ف + 1; }
            الباقي := المختصر;
            دع نقطتان: منطقي = (الطول(المكون) مثل طبيعي) == 2 && المكون[0] == 0x2E && المكون[1] == 0x2E;
            إذا (نقطتان) {
                إذا ((الطول(المحلول) مثل طبيعي) > 0) {
                    دع الأب: متغير متجه نص = [];
                    دع ح: متغير طبيعي = 0;
                    طالما (ح + 1 < (الطول(المحلول) مثل طبيعي)) { ألحق(الأب, انسخ_نص(&المحلول[ح])); ح := ح + 1; }
                    المحلول := الأب;
                };
            } وإلا {
                دع المرشح: نص = صل_مكونات_يونكس(&المحلول, &المكون);
                // readlink tells a link (its target) from an existing
                // non-link (EINVAL, classified إدخال_غير_صالح) from a
                // missing component (ENOENT, ENOTDIR) in one call, also on
                // WASI, whose path metadata follows links.
                طابق اقرأ_وصلة_رمزية(&المرشح) مع
                | نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح) -> { ألحق(المحلول, المكون); }
                | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
                | نتيجة.نجح(الهدف) -> {
                    القفزات := القفزات + 1;
                    إذا (القفزات > 40) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.آخر()); };
                    إذا ((الطول(الهدف) مثل طبيعي) == 0) {
                        أرجع نتيجة.خطأ(فئة_خطأ_نظام.غير_موجود());
                    };
                    إذا (الهدف[0] == 0x2F) {
                        دع جذر: متجه نص = [];
                        المحلول := جذر;
                    };
                    دع مكونات_الهدف: متجه نص = مكونات_يونكس(&الهدف);
                    دع ح: متغير طبيعي = الطول(مكونات_الهدف) مثل طبيعي;
                    طالما (ح > 0) { ح := ح - 1; ألحق(الباقي, انسخ_نص(&مكونات_الهدف[ح])); }
                };
            };
        }
        أرجع نتيجة.نجح(صل_مكونات_يونكس(&المحلول, &الفارغ_نص));
    };
}

إذا (الهدف.المنصة == «windows») {
    استورد os.file_attributes;
    // GetFinalPathNameByHandleW on the opened path (std.os.file_attributes).
    عام عرف مسار_قانوني(المسار: &نص): نتيجة نص, فئة_خطأ_نظام {
        طابق المسار_النهائي_نظام(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فئة_خطأ_حد_نظام(الخطأ)); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
    }
} وإلا {
    // The absolute path of an existing file with every symbolic link, "."
    // and ".." resolved.
    عام عرف مسار_قانوني(المسار: &نص): نتيجة نص, فئة_خطأ_نظام {
        أرجع مسار_قانوني_يونكس(المسار);
    }
}

عام مرادف absolute = حول_إلى_مسار_مطلق;
عام مرادف canonicalize = مسار_قانوني;
