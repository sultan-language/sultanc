استورد text.from_bytes;
استورد text.compare;

استورد os.file;
استورد os.error;

عرف نتيجة_ملف_خام(النتيجة: نتيجة عدد, خطأ_حد_نظام): عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}
عرف ملف_من_معرف_خام(المعرف: عدد): ملف_نظام {
    دع الناتج: ملف_نظام = { القيمة: المعرف مثل ط64, مفتوح: صواب };
    أرجع الناتج;
}
عرف افتح_للقراءة(المسار: &نص): عدد {
    طابق افتح_ملف_نظام_للقراءة(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(الملف) -> { أرجع الملف.القيمة مثل عدد; };
}
عرف اقرأ_مقطعا(
    المعرف: عدد, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): عدد {
    دع الملف: ملف_نظام = ملف_من_معرف_خام(المعرف);
    أرجع نتيجة_ملف_خام(اقرأ_ملف_نظام(&الملف, المخزن, الإزاحة, المطلوب));
}
عرف أغلق(المعرف: عدد): عدد {
    دع الملف: متغير ملف_نظام = ملف_من_معرف_خام(المعرف);
    أرجع نتيجة_ملف_خام(أغلق_ملف_نظام(&متغير الملف));
}
عرف أنشئ_وجهة_نسخ(المسار: &نص): عدد {
    طابق أنشئ_ملف_نظام_للكتابة(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(الملف) -> { أرجع الملف.القيمة مثل عدد; };
}
عرف اكتب_مقطع_نسخ(
    المعرف: عدد, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): عدد {
    دع الملف: ملف_نظام = ملف_من_معرف_خام(المعرف);
    أرجع نتيجة_ملف_خام(اكتب_ملف_نظام(&الملف, المحتوى, الإزاحة, المطلوب));
}

// 4096 zero bytes: 64 written one by one, then copied in bulk.
عرف ابن_مخزن_ملف_قياسي(): متجه ط8 {
    دع القطعة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 64) {
        ألحق(القطعة, 0 مثل ط8);
        ف := ف + 1;
    }
    دع المخزن: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 4096) {
        ألحق_من(المخزن, &القطعة, 0, 64);
        ف := ف + 64;
    }
    أرجع المخزن;
}

عام عرف اقرأ_بايتات_ملف(المسار: &نص): نتيجة متجه ط8, عدد {
    دع الواصف: عدد = افتح_للقراءة(المسار);
    إذا (الواصف < 0) { أرجع نتيجة.خطأ(الواصف); };

    دع البايتات: متغير متجه ط8 = [];
    دع المخزن: متغير متجه ط8 = ابن_مخزن_ملف_قياسي();
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع المقروء: عدد = اقرأ_مقطعا(الواصف, &متغير المخزن, 0, 4096);
        إذا (المقروء < 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(المقروء);
        } وإلا إذا (المقروء == 0) {
            مستمر := خطأ;
        } وإلا {
            دع العدد_المقروء: طبيعي = المقروء مثل طبيعي;
            ألحق_من(البايتات, &المخزن, 0, العدد_المقروء);
        };
    }

    دع حالة_الإغلاق: عدد = أغلق(الواصف);
    إذا (حالة_الإغلاق < 0) { أرجع نتيجة.خطأ(حالة_الإغلاق); };
    أرجع نتيجة.نجح(البايتات);
}

عام عرف اقرأ_الملف(المسار: &نص): نتيجة نص, عدد {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(البايتات) -> {
        دع نسخة: متجه ط8 = البايتات;
        أرجع نتيجة.نجح(من_بايتات(&نسخة));
    };
}

عام مرادف read_bytes = اقرأ_بايتات_ملف;
عام مرادف read_file = اقرأ_الملف;

// Streams a file through a bounded std buffer; file contents are never materialized twice.
عام عرف انسخ_الملف(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    // Opening the destination truncates it. Never do so for the same spelling;
    // detecting aliases/hard links also needs an OS file-identity interface.
    إذا (نصان_متساويان(المصدر, الوجهة)) { أرجع نتيجة.خطأ(-22); };
    دع واصف_المصدر: عدد = افتح_للقراءة(المصدر);
    إذا (واصف_المصدر < 0) { أرجع نتيجة.خطأ(واصف_المصدر); };

    دع واصف_الوجهة: عدد = أنشئ_وجهة_نسخ(الوجهة);
    إذا (واصف_الوجهة < 0) {
        أغلق(واصف_المصدر);
        أرجع نتيجة.خطأ(واصف_الوجهة);
    };

    دع المخزن: متغير متجه ط8 = ابن_مخزن_ملف_قياسي();
    دع الكلي: متغير عدد = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        دع المقروء: عدد = اقرأ_مقطعا(واصف_المصدر, &متغير المخزن, 0, 4096);
        إذا (المقروء < 0) {
            أغلق(واصف_المصدر);
            أغلق(واصف_الوجهة);
            أرجع نتيجة.خطأ(المقروء);
        } وإلا إذا (المقروء == 0) {
            مستمر := خطأ;
        } وإلا {
            دع المكتوب_للمقطع: متغير عدد = 0;
            طالما (المكتوب_للمقطع < المقروء) {
                دع المكتوب: عدد = اكتب_مقطع_نسخ(واصف_الوجهة, &المخزن, المكتوب_للمقطع, المقروء - المكتوب_للمقطع);
                إذا (المكتوب < 0) {
                    أغلق(واصف_المصدر);
                    أغلق(واصف_الوجهة);
                    أرجع نتيجة.خطأ(المكتوب);
                };
                إذا (المكتوب == 0) {
                    أغلق(واصف_المصدر);
                    أغلق(واصف_الوجهة);
                    أرجع نتيجة.خطأ(-2);
                };
                المكتوب_للمقطع := المكتوب_للمقطع + المكتوب;
                الكلي := الكلي + المكتوب;
            }
        };
    }

    دع إغلاق_المصدر: عدد = أغلق(واصف_المصدر);
    إذا (إغلاق_المصدر < 0) {
        أغلق(واصف_الوجهة);
        أرجع نتيجة.خطأ(إغلاق_المصدر);
    };
    دع إغلاق_الوجهة: عدد = أغلق(واصف_الوجهة);
    إذا (إغلاق_الوجهة < 0) { أرجع نتيجة.خطأ(إغلاق_الوجهة); };
    أرجع نتيجة.نجح(الكلي);
}

عام مرادف copy_file = انسخ_الملف;
