استورد text.from_bytes;

خارجي عرف تشغيل_فتح_ملف_للقراءة(الحجة_0: نص): عدد;
عرف افتح_للقراءة(الحجة_0: &نص): عدد {
    أرجع تشغيل_فتح_ملف_للقراءة(*الحجة_0);
}
خارجي عرف تشغيل_قراءة_مقطع_ملف(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اقرأ_مقطعا(الحجة_0: عدد, الحجة_1: &متغير متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_قراءة_مقطع_ملف(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_إغلاق_ملف(الحجة_0: عدد): عدد;
عرف أغلق(الحجة_0: عدد): عدد { أرجع تشغيل_إغلاق_ملف(الحجة_0); }
خارجي عرف تشغيل_إنشاء_ملف_للكتابة(الحجة_0: نص): عدد;
عرف أنشئ_وجهة_نسخ(الحجة_0: &نص): عدد {
    أرجع تشغيل_إنشاء_ملف_للكتابة(*الحجة_0);
}
خارجي عرف تشغيل_كتابة_مقطع_ملف(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اكتب_مقطع_نسخ(الحجة_0: عدد, الحجة_1: &متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_كتابة_مقطع_ملف(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}

عرف ابن_مخزن_ملف_قياسي(): متجه غ8 {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 4096) {
        ألحق(المخزن, 0 مثل غ8);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عام عرف اقرأ_بايتات_ملف(المسار: &نص): نتيجة متجه غ8, عدد {
    دع الواصف: عدد = افتح_للقراءة(المسار);
    لو (الواصف < 0) { أرجع نتيجة.خطأ(الواصف); };

    دع البايتات: متغير متجه غ8 = [];
    دع المخزن: متغير متجه غ8 = ابن_مخزن_ملف_قياسي();
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المقروء: عدد = اقرأ_مقطعا(الواصف, &متغير المخزن, 0, 4096);
        لو (المقروء < 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(المقروء);
        } وإلا لو (المقروء == 0) {
            مستمر := خطأ;
        } وإلا {
            دع العدد_المقروء: غير_موقع = المقروء مثل غير_موقع;
            دع ف: متغير غير_موقع = 0;
            بينما (ف < العدد_المقروء) {
                ألحق(البايتات, المخزن[ف]);
                ف := ف + 1;
            }
        };
    }

    دع حالة_الإغلاق: عدد = أغلق(الواصف);
    لو (حالة_الإغلاق < 0) { أرجع نتيجة.خطأ(حالة_الإغلاق); };
    أرجع نتيجة.نجح(البايتات);
}

عام عرف اقرأ_الملف(المسار: &نص): نتيجة نص, عدد {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(البايتات) -> {
        دع نسخة: متجه غ8 = البايتات;
        أرجع نتيجة.نجح(من_بايتات(&نسخة));
    };
}

عام مرادف read_bytes = اقرأ_بايتات_ملف;
عام مرادف read_file = اقرأ_الملف;

// Streams a file through a bounded std buffer; file contents are never materialized twice.
عام عرف انسخ_الملف(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    دع واصف_المصدر: عدد = افتح_للقراءة(المصدر);
    لو (واصف_المصدر < 0) { أرجع نتيجة.خطأ(واصف_المصدر); };

    دع واصف_الوجهة: عدد = أنشئ_وجهة_نسخ(الوجهة);
    لو (واصف_الوجهة < 0) {
        أغلق(واصف_المصدر);
        أرجع نتيجة.خطأ(واصف_الوجهة);
    };

    دع المخزن: متغير متجه غ8 = ابن_مخزن_ملف_قياسي();
    دع الكلي: متغير عدد = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المقروء: عدد = اقرأ_مقطعا(واصف_المصدر, &متغير المخزن, 0, 4096);
        لو (المقروء < 0) {
            أغلق(واصف_المصدر);
            أغلق(واصف_الوجهة);
            أرجع نتيجة.خطأ(المقروء);
        } وإلا لو (المقروء == 0) {
            مستمر := خطأ;
        } وإلا {
            دع المكتوب_للمقطع: متغير عدد = 0;
            بينما (المكتوب_للمقطع < المقروء) {
                دع المكتوب: عدد = اكتب_مقطع_نسخ(واصف_الوجهة, &المخزن, المكتوب_للمقطع, المقروء - المكتوب_للمقطع);
                لو (المكتوب < 0) {
                    أغلق(واصف_المصدر);
                    أغلق(واصف_الوجهة);
                    أرجع نتيجة.خطأ(المكتوب);
                };
                لو (المكتوب == 0) {
                    أغلق(واصف_المصدر);
                    أغلق(واصف_الوجهة);
                    أرجع نتيجة.خطأ(-2);
                };
                المكتوب_للمقطع := المكتوب_للمقطع + المكتوب;
                الكلي := الكلي + المكتوب;
            }
        };
    }

    دع إغلاق_المصدر: عدد = أغلق(واصف_المصدر);
    لو (إغلاق_المصدر < 0) {
        أغلق(واصف_الوجهة);
        أرجع نتيجة.خطأ(إغلاق_المصدر);
    };
    دع إغلاق_الوجهة: عدد = أغلق(واصف_الوجهة);
    لو (إغلاق_الوجهة < 0) { أرجع نتيجة.خطأ(إغلاق_الوجهة); };
    أرجع نتيجة.نجح(الكلي);
}

عام مرادف copy_file = انسخ_الملف;
