استورد text.from_bytes;
استورد text.substring;
استورد text.compare;

عرف انسخ_نص_مسار(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عام عرف فاصل_المسار(): غ8 { أرجع 0x2F; }

عام عرف مسار_مطلق(المسار: &نص): منطقي {
    دع القيمة: نص = *المسار;
    أرجع (الطول(القيمة) > 0) && (القيمة[0] == فاصل_المسار());
}

عام عرف مسار_نسبي(المسار: &نص): منطقي {
    أرجع !مسار_مطلق(المسار);
}

عرف مكون_مسار(المسار: &نص, البداية: غير_موقع, النهاية: غير_موقع): نص {
    طابق مقطع_نص(المسار, البداية, النهاية - البداية) مع
    | اختيار.بعض(القيمة) -> { أرجع القيمة; }
    | اختيار.لا_شيء -> { أرجع «»; };
}

عرف نص_يساوي_مسارا(القيمة: &نص, المطلوب: نص): منطقي {
    دع ثابت: نص = المطلوب;
    أرجع نصان_متساويان(القيمة, &ثابت);
}

عرف ادفع_مكونا(المكونات: &متغير متجه نص, العمق: غير_موقع, القيمة: نص): فراغ {
    دع الحالية: متغير متجه نص = *المكونات;
    لو (العمق < (الطول(الحالية) مثل غير_موقع)) {
        الحالية[العمق] := القيمة;
    } وإلا {
        ألحق(الحالية, القيمة);
    };
    *المكونات := الحالية;
}

عام عرف طبع_المسار(المسار: &نص): نص {
    دع القيمة: نص = *المسار;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع مطلق: منطقي = مسار_مطلق(&القيمة);
    دع المكونات: متغير متجه نص = [];
    دع العمق: متغير غير_موقع = 0;
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;

    بينما (ف <= العدد) {
        دع نهاية_مكون: متغير منطقي = ف == العدد;
        لو (!نهاية_مكون) { نهاية_مكون := القيمة[ف] == فاصل_المسار(); };
        لو (نهاية_مكون) {
            لو (ف > البداية) {
                دع المكون: نص = مكون_مسار(&القيمة, البداية, ف);
                لو (نص_يساوي_مسارا(&المكون, «.»)) {
                    // تجاهل
                } وإلا لو (نص_يساوي_مسارا(&المكون, «..»)) {
                    لو (العمق > 0) {
                        دع فهرس_السابق: غير_موقع = العمق - 1;
                        دع السابق: نص = انسخ_نص_مسار(&المكونات[فهرس_السابق]);
                        لو (!نص_يساوي_مسارا(&السابق, «..»)) {
                            العمق := العمق - 1;
                        } وإلا لو (!مطلق) {
                            ادفع_مكونا(&متغير المكونات, العمق, المكون);
                            العمق := العمق + 1;
                        };
                    } وإلا لو (!مطلق) {
                        ادفع_مكونا(&متغير المكونات, العمق, المكون);
                        العمق := العمق + 1;
                    };
                } وإلا {
                    ادفع_مكونا(&متغير المكونات, العمق, المكون);
                    العمق := العمق + 1;
                };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }

    دع البايتات: متغير متجه غ8 = [];
    لو (مطلق) { ألحق(البايتات, فاصل_المسار()); };
    دع م: متغير غير_موقع = 0;
    بينما (م < العمق) {
        لو (م > 0) { ألحق(البايتات, فاصل_المسار()); };
        دع الجزء: نص = انسخ_نص_مسار(&المكونات[م]);
        دع ب: متغير غير_موقع = 0;
        بينما (ب < (الطول(الجزء) مثل غير_موقع)) {
            ألحق(البايتات, الجزء[ب]);
            ب := ب + 1;
        }
        م := م + 1;
    }
    لو ((الطول(البايتات) == 0) && مطلق) { أرجع «/»; };
    لو (الطول(البايتات) == 0) { أرجع «.»; };
    أرجع من_بايتات(&البايتات);
}

عام عرف صل_المسار(اليسار: &نص, اليمين: &نص): نص {
    لو (مسار_مطلق(اليمين)) { أرجع طبع_المسار(اليمين); };
    دع أ: نص = *اليسار;
    دع ب: نص = *اليمين;
    لو (الطول(أ) == 0) { أرجع طبع_المسار(&ب); };
    لو (الطول(ب) == 0) { أرجع طبع_المسار(&أ); };
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ) مثل غير_موقع)) { ألحق(البايتات, أ[ف]); ف := ف + 1; }
    دع طول_اليسار: غير_موقع = الطول(أ) مثل غير_موقع;
    دع فهرس_آخر_اليسار: غير_موقع = طول_اليسار - 1;
    لو (أ[فهرس_آخر_اليسار] != فاصل_المسار()) { ألحق(البايتات, فاصل_المسار()); };
    ف := 0;
    بينما (ف < (الطول(ب) مثل غير_موقع)) { ألحق(البايتات, ب[ف]); ف := ف + 1; }
    دع المجمع: نص = من_بايتات(&البايتات);
    أرجع طبع_المسار(&المجمع);
}

عام عرف اسم_الملف(المسار: &نص): اختيار نص {
    دع القيمة: نص = طبع_المسار(المسار);
    لو (نص_يساوي_مسارا(&القيمة, «/»)) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 0) {
        ف := ف - 1;
        لو (القيمة[ف] == فاصل_المسار()) { البداية := ف + 1; ف := 0; };
    }
    أرجع مقطع_نص(&القيمة, البداية, العدد - البداية);
}

عام عرف أب_المسار(المسار: &نص): اختيار نص {
    دع القيمة: نص = طبع_المسار(المسار);
    لو (نص_يساوي_مسارا(&القيمة, «/») || نص_يساوي_مسارا(&القيمة, «.»)) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 0) {
        ف := ف - 1;
        لو (القيمة[ف] == فاصل_المسار()) {
            لو (ف == 0) { أرجع اختيار.بعض(«/»); };
            أرجع مقطع_نص(&القيمة, 0, ف);
        };
    }
    أرجع اختيار.بعض(«.»);
}

عرف موضع_نقطة_امتداد(الاسم: &نص): اختيار غير_موقع {
    دع القيمة: نص = *الاسم;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد < 2) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 1) {
        ف := ف - 1;
        لو (القيمة[ف] == 0x2E) { أرجع اختيار.بعض(ف); };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف امتداد_المسار(المسار: &نص): اختيار نص {
    طابق اسم_الملف(المسار) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النقطة) -> {
            أرجع مقطع_نص(&الاسم, النقطة + 1, (الطول(الاسم) مثل غير_موقع) - النقطة - 1);
        };
    };
}

عام عرف ساق_المسار(المسار: &نص): اختيار نص {
    طابق اسم_الملف(المسار) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(الاسم); }
        | اختيار.بعض(النقطة) -> { أرجع مقطع_نص(&الاسم, 0, النقطة); };
    };
}

عام مرادف path_separator = فاصل_المسار;
عام مرادف is_absolute = مسار_مطلق;
عام مرادف is_relative = مسار_نسبي;
عام مرادف normalize = طبع_المسار;
عام مرادف join = صل_المسار;
عام مرادف file_name = اسم_الملف;
عام مرادف parent = أب_المسار;
عام مرادف extension = امتداد_المسار;
عام مرادف stem = ساق_المسار;

عام عرف مكونات_المسار(المسار: &نص): متجه نص {
    دع القيمة: نص = طبع_المسار(المسار);
    دع الناتج: متغير متجه نص = [];
    لو (نص_يساوي_مسارا(&القيمة, «.») || نص_يساوي_مسارا(&القيمة, «/»)) { أرجع الناتج; };
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    لو ((العدد > 0) && (القيمة[0] == فاصل_المسار())) { البداية := 1; };
    دع ف: متغير غير_موقع = البداية;
    بينما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        لو (!نهاية) { نهاية := القيمة[ف] == فاصل_المسار(); };
        لو (نهاية) {
            لو (ف > البداية) {
                طابق مقطع_نص(&القيمة, البداية, ف - البداية) مع
                | اختيار.بعض(المكون) -> { ألحق(الناتج, المكون); }
                | اختيار.لا_شيء -> { };
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف امتداد_مسار_صالح(الامتداد: &نص): منطقي {
    دع القيمة: نص = *الامتداد;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (القيمة[ف] == فاصل_المسار()) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف غير_امتداد_المسار(المسار: &نص, الامتداد_الجديد: &نص): اختيار نص {
    لو (!امتداد_مسار_صالح(الامتداد_الجديد)) { أرجع اختيار.لا_شيء(); };
    دع القيمة: نص = طبع_المسار(المسار);
    طابق ساق_المسار(&القيمة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الساق) -> {
        دع اسم_جديد_بايتات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(الساق) مثل غير_موقع)) { ألحق(اسم_جديد_بايتات, الساق[ف]); ف := ف + 1; }
        لو ((الطول(*الامتداد_الجديد) مثل غير_موقع) > 0) {
            ألحق(اسم_جديد_بايتات, 0x2E);
            دع الامتداد: نص = *الامتداد_الجديد;
            ف := 0;
            بينما (ف < (الطول(الامتداد) مثل غير_موقع)) { ألحق(اسم_جديد_بايتات, الامتداد[ف]); ف := ف + 1; }
        };
        دع الاسم_الجديد: نص = من_بايتات(&اسم_جديد_بايتات);
        طابق أب_المسار(&القيمة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(الاسم_الجديد); }
        | اختيار.بعض(الأب) -> { أرجع اختيار.بعض(صل_المسار(&الأب, &الاسم_الجديد)); };
    };
}

عام مرادف components = مكونات_المسار;
عام مرادف with_extension = غير_امتداد_المسار;
