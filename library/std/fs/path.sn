استورد text.from_bytes;
استورد text.substring;
استورد text.compare;

// A path flavor is explicit: the compiler may manipulate target paths on a
// different host. Filesystem canonicalization and host flavor selection are
// separate OS responsibilities. Existing unqualified APIs retain POSIX rules.
عام نوع صيغة_مسار = | يونكس | ويندوز;

عام مرادف path_flavor = صيغة_مسار;
عام مرادف path_flavor.posix = صيغة_مسار.يونكس;
عام مرادف path_flavor.windows = صيغة_مسار.ويندوز;

نوع تحليل_بادئة_مسار = {
    نهاية_البادئة: غير_موقع,
    نهاية_الجذر: غير_موقع,
    مطلق: منطقي,
    له_جذر: منطقي,
    حرفي: منطقي,
    قرص_نسبي: منطقي
};

عرف فاصل_مسار_بحسب_الصيغة(الصيغة: صيغة_مسار): غ8 {
    طابق الصيغة مع
    | صيغة_مسار.يونكس -> { أرجع 0x2F; }
    | صيغة_مسار.ويندوز -> { أرجع 0x5C; };
}

عام عرف فاصل_المسار_بصيغة(الصيغة: صيغة_مسار): غ8 {
    أرجع فاصل_مسار_بحسب_الصيغة(الصيغة);
}

عام عرف فاصل_المسار(): غ8 { أرجع فاصل_المسار_بصيغة(صيغة_مسار.يونكس()); }

عرف هل_فاصل_مسار(الحرف: غ8, الصيغة: صيغة_مسار, حرفي: منطقي): منطقي {
    لو (الحرف == 0x5C) {
        طابق الصيغة مع
        | صيغة_مسار.ويندوز -> { أرجع صواب; }
        | صيغة_مسار.يونكس -> { أرجع خطأ; };
    };
    لو (الحرف != 0x2F) { أرجع خطأ; };
    لو (حرفي) { أرجع خطأ; };
    أرجع صواب;
}

عرف هل_حرف_قرص(الحرف: غ8): منطقي {
    أرجع ((الحرف >= 0x41) && (الحرف <= 0x5A)) ||
          ((الحرف >= 0x61) && (الحرف <= 0x7A));
}

عرف تطابق_حرف_لاتيني(الحرف: غ8, الحرف_الكبير: غ8): منطقي {
    أرجع (الحرف == الحرف_الكبير) || (الحرف == الحرف_الكبير + 0x20);
}

عرف بداية_جزء_بعد(القيمة: &نص, البداية: غير_موقع, حرفي: منطقي): غير_موقع {
    دع العدد: غير_موقع = الطول(*القيمة) مثل غير_موقع;
    دع الموضع: متغير غير_موقع = البداية;
    بينما (الموضع < العدد) {
        لو (هل_فاصل_مسار((*القيمة)[الموضع], صيغة_مسار.ويندوز(), حرفي)) { أرجع الموضع; };
        الموضع := الموضع + 1;
    }
    أرجع العدد;
}

عرف حلل_بادئة_مسار(المسار: &نص, الصيغة: صيغة_مسار): تحليل_بادئة_مسار {
    دع القيمة: نص = *المسار;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    طابق الصيغة مع
    | صيغة_مسار.يونكس -> {
        دع الجذر: متغير غير_موقع = 0;
        لو ((العدد > 0) && (القيمة[0] == 0x2F)) {
            الجذر := 1;
            // Exactly two initial separators have implementation-defined POSIX meaning.
            لو ((العدد >= 2) && (القيمة[1] == 0x2F)) {
                لو ((العدد == 2) || (القيمة[2] != 0x2F)) { الجذر := 2; };
            };
        };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: الجذر, مطلق: الجذر > 0, له_جذر: الجذر > 0,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    }
    | صيغة_مسار.ويندوز -> { };

    // Windows verbatim (\\?\) and device (\\.\) namespaces. Only '\'
    // separates components in verbatim names; '/' is an ordinary character.
    لو ((العدد >= 4) && (القيمة[0] == 0x5C) && (القيمة[1] == 0x5C) &&
        ((القيمة[2] == 0x3F) || (القيمة[2] == 0x2E)) && (القيمة[3] == 0x5C)) {
        دع حرفي: منطقي = القيمة[2] == 0x3F;
        دع بداية_الاسم: غير_موقع = 4;
        لو (حرفي && (العدد >= 8) &&
            تطابق_حرف_لاتيني(القيمة[4], 0x55) &&
            تطابق_حرف_لاتيني(القيمة[5], 0x4E) &&
            تطابق_حرف_لاتيني(القيمة[6], 0x43) && (القيمة[7] == 0x5C)) {
            دع نهاية_الخادم: غير_موقع = بداية_جزء_بعد(&القيمة, 8, صواب);
            لو ((نهاية_الخادم > 8) && (نهاية_الخادم < العدد)) {
                دع نهاية_المشاركة: غير_موقع = بداية_جزء_بعد(&القيمة, نهاية_الخادم + 1, صواب);
                لو (نهاية_المشاركة > نهاية_الخادم + 1) {
                    دع الجذر: متغير غير_موقع = نهاية_المشاركة;
                    لو (الجذر < العدد) { الجذر := الجذر + 1; };
                    دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: نهاية_المشاركة,
                        نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
                        حرفي: صواب, قرص_نسبي: خطأ };
                    أرجع التحليل;
                };
            };
        };
        لو (حرفي && (العدد >= 6) && هل_حرف_قرص(القيمة[4]) && (القيمة[5] == 0x3A)) {
            دع الجذر: متغير غير_موقع = 6;
            لو ((العدد > 6) && (القيمة[6] == 0x5C)) { الجذر := 7; };
            دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 6,
                نهاية_الجذر: الجذر, مطلق: الجذر > 6, له_جذر: الجذر > 6,
                حرفي: صواب, قرص_نسبي: الجذر == 6 };
            أرجع التحليل;
        };
        دع النهاية: غير_موقع = بداية_جزء_بعد(&القيمة, بداية_الاسم, صواب);
        دع الجذر: متغير غير_موقع = النهاية;
        لو (النهاية < العدد) { الجذر := النهاية + 1; };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: النهاية,
            نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
            حرفي: حرفي, قرص_نسبي: خطأ };
        أرجع التحليل;
    };

    لو ((العدد >= 2) && هل_حرف_قرص(القيمة[0]) && (القيمة[1] == 0x3A)) {
        دع الجذر: متغير غير_موقع = 2;
        لو ((العدد > 2) && هل_فاصل_مسار(القيمة[2], الصيغة, خطأ)) { الجذر := 3; };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 2,
            نهاية_الجذر: الجذر, مطلق: الجذر > 2, له_جذر: الجذر > 2,
            حرفي: خطأ, قرص_نسبي: الجذر == 2 };
        أرجع التحليل;
    };

    لو ((العدد >= 2) && هل_فاصل_مسار(القيمة[0], الصيغة, خطأ) &&
        هل_فاصل_مسار(القيمة[1], الصيغة, خطأ)) {
        دع نهاية_الخادم: غير_موقع = بداية_جزء_بعد(&القيمة, 2, خطأ);
        لو ((نهاية_الخادم > 2) && (نهاية_الخادم < العدد)) {
            دع نهاية_المشاركة: غير_موقع = بداية_جزء_بعد(&القيمة, نهاية_الخادم + 1, خطأ);
            لو (نهاية_المشاركة > نهاية_الخادم + 1) {
                دع الجذر: متغير غير_موقع = نهاية_المشاركة;
                لو (الجذر < العدد) { الجذر := الجذر + 1; };
                دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: نهاية_المشاركة,
                    نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
                    حرفي: خطأ, قرص_نسبي: خطأ };
                أرجع التحليل;
            };
            // A server without a share is not a fully qualified UNC path.
            // Retain the double-root spelling without inventing a volume.
            دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
                نهاية_الجذر: 2, مطلق: خطأ, له_جذر: صواب,
                حرفي: خطأ, قرص_نسبي: خطأ };
            أرجع التحليل;
        };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: 2, مطلق: خطأ, له_جذر: صواب,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    };
    لو ((العدد > 0) && هل_فاصل_مسار(القيمة[0], الصيغة, خطأ)) {
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: 1, مطلق: خطأ, له_جذر: صواب,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    };
    دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
        نهاية_الجذر: 0, مطلق: خطأ, له_جذر: خطأ,
        حرفي: خطأ, قرص_نسبي: خطأ };
    أرجع التحليل;
}

// Root and prefix must be distinguished: "C:foo" has a drive prefix
// without a root, while "\\server\share\foo" has both.
عام عرف بادئة_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    لو (البادئة.نهاية_البادئة == 0) { أرجع اختيار.لا_شيء(); };
    أرجع مقطع_نص(المسار, 0, البادئة.نهاية_البادئة);
}

عام عرف جذر_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    لو (!البادئة.له_جذر) { أرجع اختيار.لا_شيء(); };
    أرجع مقطع_نص(المسار, 0, البادئة.نهاية_الجذر);
}

// A root and a fully qualified path are different on Windows: "\foo"
// has a root but depends on the current drive. "C:foo" has a drive prefix
// but depends on that drive's working directory.
عام عرف للمسار_جذر_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    أرجع البادئة.له_جذر;
}

عام عرف مسار_مطلق_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    أرجع البادئة.مطلق;
}

عام عرف مسار_نسبي_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    أرجع !مسار_مطلق_بصيغة(المسار, الصيغة);
}

عام عرف مسار_مطلق(المسار: &نص): منطقي { أرجع مسار_مطلق_بصيغة(المسار, صيغة_مسار.يونكس()); }
عام عرف مسار_نسبي(المسار: &نص): منطقي { أرجع مسار_نسبي_بصيغة(المسار, صيغة_مسار.يونكس()); }

عرف مكون_مسار(المسار: &نص, البداية: غير_موقع, النهاية: غير_موقع): نص {
    طابق مقطع_نص(المسار, البداية, النهاية - البداية) مع
    | اختيار.بعض(القيمة) -> { أرجع القيمة; }
    | اختيار.لا_شيء -> { أرجع «»; };
}

عرف نص_يساوي_مسارا(القيمة: &نص, المطلوب: نص): منطقي {
    دع ثابت: نص = المطلوب;
    أرجع نصان_متساويان(القيمة, &ثابت);
}

عرف انسخ_بايتات_مسار(الوجهة: &متغير متجه غ8, المصدر: &نص, البداية: غير_موقع, النهاية: غير_موقع): فراغ {
    دع فهرس: متغير غير_موقع = البداية;
    بينما (فهرس < النهاية) {
        ألحق(*الوجهة, (*المصدر)[فهرس]);
        فهرس := فهرس + 1;
    }
}

// Translate ordinary Windows path separators only where components are
// composed. Never run this over an existing verbatim path's own spelling.
عرف انسخ_مقطع_مسار_بفواصل_الصيغة(
    الوجهة: &متغير متجه غ8, المصدر: &نص, النهاية: غير_موقع, الصيغة: صيغة_مسار
): فراغ {
    دع فهرس: متغير غير_موقع = 0;
    بينما (فهرس < النهاية) {
        دع الحرف: غ8 = (*المصدر)[فهرس];
        طابق الصيغة مع
        | صيغة_مسار.ويندوز -> {
            لو (الحرف == 0x2F) { ألحق(*الوجهة, 0x5C); }
            وإلا { ألحق(*الوجهة, الحرف); };
        }
        | صيغة_مسار.يونكس -> { ألحق(*الوجهة, الحرف); };
        فهرس := فهرس + 1;
    }
}

// Lexical component normalization does not fold "..": symlink/../x is not
// generally equivalent to x. Verbatim Windows namespaces stay unchanged.
عام عرف طبع_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): نص {
    دع القيمة: نص = *المسار;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    لو (البادئة.حرفي) { أرجع القيمة; };
    دع البايتات: متغير متجه غ8 = [];
    لو (البادئة.نهاية_الجذر > 0) {
        انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, المسار, البادئة.نهاية_الجذر, الصيغة);
    };
    دع بداية: متغير غير_موقع = البادئة.نهاية_الجذر;
    دع الموضع: متغير غير_موقع = بداية;
    دع أضيف_مكون: متغير منطقي = خطأ;
    بينما (الموضع <= العدد) {
        دع نهاية_مكون: متغير منطقي = الموضع == العدد;
        لو (!نهاية_مكون) {
            نهاية_مكون := هل_فاصل_مسار(القيمة[الموضع], الصيغة, خطأ);
        };
        لو (نهاية_مكون) {
            لو (الموضع > بداية) {
                دع المكون: نص = مكون_مسار(&القيمة, بداية, الموضع);
                لو (!نص_يساوي_مسارا(&المكون, «.»)) {
                    لو (أضيف_مكون) {
                        ألحق(البايتات, فاصل_المسار_بصيغة(الصيغة));
                    };
                    انسخ_بايتات_مسار(&متغير البايتات, المسار, بداية, الموضع);
                    أضيف_مكون := صواب;
                };
            };
            بداية := الموضع + 1;
        };
        الموضع := الموضع + 1;
    }
    لو ((الطول(البايتات) مثل غير_موقع) == 0) { أرجع «.»; };
    أرجع من_بايتات(&البايتات);
}

عام عرف طبع_المسار(المسار: &نص): نص { أرجع طبع_المسار_بصيغة(المسار, صيغة_مسار.يونكس()); }

// Path composition is lexical. On Windows a rooted path retains the left
// drive/UNC prefix; a new drive prefix replaces the entire left path.
عام عرف صل_المسار_بصيغة(اليسار: &نص, اليمين: &نص, الصيغة: صيغة_مسار): نص {
    دع الأصل: نص = *اليسار;
    دع الملحق: نص = *اليمين;
    لو (الطول(الأصل) == 0) { أرجع الملحق; };
    لو (الطول(الملحق) == 0) { أرجع الأصل; };
    دع بادئة_اليمين: تحليل_بادئة_مسار = حلل_بادئة_مسار(اليمين, الصيغة);
    دع بادئة_اليسار: تحليل_بادئة_مسار = حلل_بادئة_مسار(اليسار, الصيغة);
    لو (بادئة_اليمين.نهاية_البادئة > 0) { أرجع الملحق; };
    لو (بادئة_اليمين.له_جذر) {
        لو (بادئة_اليسار.نهاية_البادئة == 0) { أرجع الملحق; };
        دع البايتات: متغير متجه غ8 = [];
        انسخ_بايتات_مسار(&متغير البايتات, اليسار, 0, بادئة_اليسار.نهاية_البادئة);
        لو (بادئة_اليسار.حرفي) {
            انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, اليمين, الطول(الملحق) مثل غير_موقع, الصيغة);
        } وإلا {
            انسخ_بايتات_مسار(&متغير البايتات, اليمين, 0, الطول(الملحق) مثل غير_موقع);
        };
        أرجع من_بايتات(&البايتات);
    };
    دع البايتات: متغير متجه غ8 = [];
    دع طول_الأصل: غير_موقع = الطول(الأصل) مثل غير_موقع;
    انسخ_بايتات_مسار(&متغير البايتات, اليسار, 0, طول_الأصل);
    لو (!هل_فاصل_مسار(الأصل[طول_الأصل - 1], الصيغة, بادئة_اليسار.حرفي) &&
        !((طول_الأصل == بادئة_اليسار.نهاية_البادئة) && بادئة_اليسار.قرص_نسبي)) {
        ألحق(البايتات, فاصل_المسار_بصيغة(الصيغة));
    };
    // A normal child path uses both Windows separators, but when appended to
    // a verbatim prefix only backslashes delimit components. Convert child
    // separators so joining never changes them into literal filename bytes.
    لو (بادئة_اليسار.حرفي) {
        انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, اليمين, الطول(الملحق) مثل غير_موقع, الصيغة);
    } وإلا {
        انسخ_بايتات_مسار(&متغير البايتات, اليمين, 0, الطول(الملحق) مثل غير_موقع);
    };
    أرجع من_بايتات(&البايتات);
}

عام عرف صل_المسار(اليسار: &نص, اليمين: &نص): نص {
    أرجع صل_المسار_بصيغة(اليسار, اليمين, صيغة_مسار.يونكس());
}

عام عرف اسم_الملف_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    لو (الطول(*المسار) == 0) { أرجع اختيار.لا_شيء(); };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    لو (العدد <= البادئة.نهاية_الجذر) { أرجع اختيار.لا_شيء(); };
    لو (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع اختيار.لا_شيء(); };
    دع البداية: متغير غير_موقع = البادئة.نهاية_الجذر;
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > البادئة.نهاية_الجذر) {
        ف := ف - 1;
        لو (هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي)) {
            البداية := ف + 1;
            ف := البادئة.نهاية_الجذر;
        };
    }
    لو (البداية == العدد) { أرجع اختيار.لا_شيء(); };
    دع الاسم: نص = مكون_مسار(&القيمة, البداية, العدد);
    لو (!البادئة.حرفي && نص_يساوي_مسارا(&الاسم, «..»)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الاسم);
}

عام عرف اسم_الملف(المسار: &نص): اختيار نص { أرجع اسم_الملف_بصيغة(المسار, صيغة_مسار.يونكس()); }

عام عرف أب_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    لو (الطول(*المسار) == 0) { أرجع اختيار.لا_شيء(); };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    لو (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع اختيار.لا_شيء(); };
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    لو (العدد <= البادئة.نهاية_الجذر) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > البادئة.نهاية_الجذر) {
        ف := ف - 1;
        لو (هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي)) {
            لو (ف == البادئة.نهاية_الجذر) {
                أرجع مقطع_نص(&القيمة, 0, البادئة.نهاية_الجذر);
            };
            أرجع مقطع_نص(&القيمة, 0, ف);
        };
    }
    لو (البادئة.نهاية_الجذر > 0) {
        أرجع مقطع_نص(&القيمة, 0, البادئة.نهاية_الجذر);
    };
    أرجع اختيار.بعض(«.»);
}

عام عرف أب_المسار(المسار: &نص): اختيار نص { أرجع أب_المسار_بصيغة(المسار, صيغة_مسار.يونكس()); }

عرف موضع_نقطة_امتداد(الاسم: &نص): اختيار غير_موقع {
    دع القيمة: نص = *الاسم;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد < 2) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = العدد;
    بينما (ف > 1) {
        ف := ف - 1;
        لو (القيمة[ف] == 0x2E) { أرجع اختيار.بعض(ف); };
    }
    أرجع اختيار.لا_شيء();
}

عام عرف امتداد_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    طابق اسم_الملف_بصيغة(المسار, الصيغة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(النقطة) -> {
            أرجع مقطع_نص(&الاسم, النقطة + 1, (الطول(الاسم) مثل غير_موقع) - النقطة - 1);
        };
    };
}

عام عرف امتداد_المسار(المسار: &نص): اختيار نص { أرجع امتداد_المسار_بصيغة(المسار, صيغة_مسار.يونكس()); }

عام عرف ساق_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختيار نص {
    طابق اسم_الملف_بصيغة(المسار, الصيغة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(الاسم); }
        | اختيار.بعض(النقطة) -> { أرجع مقطع_نص(&الاسم, 0, النقطة); };
    };
}

عام عرف ساق_المسار(المسار: &نص): اختيار نص { أرجع ساق_المسار_بصيغة(المسار, صيغة_مسار.يونكس()); }

عام عرف مكونات_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): متجه نص {
    دع الناتج: متغير متجه نص = [];
    لو (الطول(*المسار) == 0) { أرجع الناتج; };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    لو (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع الناتج; };
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    دع البداية: متغير غير_موقع = البادئة.نهاية_الجذر;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        لو (!نهاية) { نهاية := هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي); };
        لو (نهاية) {
            لو (ف > البداية) {
                ألحق(الناتج, مكون_مسار(&القيمة, البداية, ف));
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مكونات_المسار(المسار: &نص): متجه نص { أرجع مكونات_المسار_بصيغة(المسار, صيغة_مسار.يونكس()); }

عرف امتداد_مسار_صالح(الامتداد: &نص, الصيغة: صيغة_مسار): منطقي {
    دع القيمة: نص = *الامتداد;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (هل_فاصل_مسار(القيمة[ف], الصيغة, خطأ)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف غير_امتداد_المسار_بصيغة(
    المسار: &نص, الامتداد_الجديد: &نص, الصيغة: صيغة_مسار
): اختيار نص {
    لو (!امتداد_مسار_صالح(الامتداد_الجديد, الصيغة)) { أرجع اختيار.لا_شيء(); };
    طابق ساق_المسار_بصيغة(المسار, الصيغة) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(الساق) -> {
        دع الاسم_الجديد_بايتات: متغير متجه غ8 = [];
        انسخ_بايتات_مسار(&متغير الاسم_الجديد_بايتات, &الساق, 0, الطول(الساق) مثل غير_موقع);
        لو (الطول(*الامتداد_الجديد) > 0) {
            ألحق(الاسم_الجديد_بايتات, 0x2E);
            انسخ_بايتات_مسار(&متغير الاسم_الجديد_بايتات, الامتداد_الجديد, 0, الطول(*الامتداد_الجديد) مثل غير_موقع);
        };
        دع الاسم_الجديد: نص = من_بايتات(&الاسم_الجديد_بايتات);
        طابق أب_المسار_بصيغة(المسار, الصيغة) مع
        | اختيار.لا_شيء -> { أرجع اختيار.بعض(الاسم_الجديد); }
        | اختيار.بعض(الأب) -> {
            لو (نص_يساوي_مسارا(&الأب, «.»)) { أرجع اختيار.بعض(الاسم_الجديد); };
            أرجع اختيار.بعض(صل_المسار_بصيغة(&الأب, &الاسم_الجديد, الصيغة));
        };
    };
}

عام عرف غير_امتداد_المسار(المسار: &نص, الامتداد_الجديد: &نص): اختيار نص {
    أرجع غير_امتداد_المسار_بصيغة(المسار, الامتداد_الجديد, صيغة_مسار.يونكس());
}

