استورد text.from_bytes;
استورد text.substring;
استورد text.compare;

// A path flavor is explicit where a path belongs to another system (the
// compiler may name target paths on a different host): the _بصيغة forms.
// The unqualified forms use the host's flavor, as Rust's std::path does: on
// Windows "\\" and "/" both separate and drive and UNC prefixes are roots,
// everywhere else only "/" separates. A program built for POSIX keeps the
// exact POSIX rules.
عام نوع صيغة_مسار = | يونكس | ويندوز;

إذا (الهدف.المنصة == «windows») {
    عام عرف صيغة_مسار_المضيف(): صيغة_مسار { أرجع صيغة_مسار.ويندوز(); }
} وإلا {
    عام عرف صيغة_مسار_المضيف(): صيغة_مسار { أرجع صيغة_مسار.يونكس(); }
}
عام مرادف host_path_flavor = صيغة_مسار_المضيف;

عام مرادف path_flavor = صيغة_مسار;
عام مرادف path_flavor.posix = صيغة_مسار.يونكس;
عام مرادف path_flavor.windows = صيغة_مسار.ويندوز;

نوع تحليل_بادئة_مسار = {
    نهاية_البادئة: طبيعي,
    نهاية_الجذر: طبيعي,
    مطلق: منطقي,
    له_جذر: منطقي,
    حرفي: منطقي,
    قرص_نسبي: منطقي
};

عرف فاصل_مسار_بحسب_الصيغة(الصيغة: صيغة_مسار): ط8 {
    طابق الصيغة مع
    | صيغة_مسار.يونكس -> { أرجع 0x2F; }
    | صيغة_مسار.ويندوز -> { أرجع 0x5C; };
}

عام عرف فاصل_المسار_بصيغة(الصيغة: صيغة_مسار): ط8 {
    أرجع فاصل_مسار_بحسب_الصيغة(الصيغة);
}

عام عرف فاصل_المسار(): ط8 { أرجع فاصل_المسار_بصيغة(صيغة_مسار_المضيف()); }

عرف هل_فاصل_مسار(الحرف: ط8, الصيغة: صيغة_مسار, حرفي: منطقي): منطقي {
    إذا (الحرف == 0x5C) {
        طابق الصيغة مع
        | صيغة_مسار.ويندوز -> { أرجع صواب; }
        | صيغة_مسار.يونكس -> { أرجع خطأ; };
    };
    إذا (الحرف != 0x2F) { أرجع خطأ; };
    إذا (حرفي) { أرجع خطأ; };
    أرجع صواب;
}

عرف هل_حرف_قرص(الحرف: ط8): منطقي {
    أرجع ((الحرف >= 0x41) && (الحرف <= 0x5A)) ||
          ((الحرف >= 0x61) && (الحرف <= 0x7A));
}

عرف تطابق_حرف_لاتيني(الحرف: ط8, الحرف_الكبير: ط8): منطقي {
    أرجع (الحرف == الحرف_الكبير) || (الحرف == الحرف_الكبير + 0x20);
}

عرف بداية_جزء_بعد(القيمة: &نص, البداية: طبيعي, حرفي: منطقي): طبيعي {
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع الموضع: متغير طبيعي = البداية;
    طالما (الموضع < العدد) {
        إذا (هل_فاصل_مسار((*القيمة)[الموضع], صيغة_مسار.ويندوز(), حرفي)) { أرجع الموضع; };
        الموضع := الموضع + 1;
    }
    أرجع العدد;
}

عرف حلل_بادئة_مسار(المسار: &نص, الصيغة: صيغة_مسار): تحليل_بادئة_مسار {
    دع القيمة: نص = *المسار;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    طابق الصيغة مع
    | صيغة_مسار.يونكس -> {
        دع الجذر: متغير طبيعي = 0;
        إذا ((العدد > 0) && (القيمة[0] == 0x2F)) {
            الجذر := 1;
            // Exactly two initial separators have implementation-defined POSIX meaning.
            إذا ((العدد >= 2) && (القيمة[1] == 0x2F)) {
                إذا ((العدد == 2) || (القيمة[2] != 0x2F)) { الجذر := 2; };
            };
        };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: الجذر, مطلق: الجذر > 0, له_جذر: الجذر > 0,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    }
    | صيغة_مسار.ويندوز -> { };

    // Windows verbatim (\\?\) and device (\\.\) namespaces. Only '\'
    // separates components in verbatim names; '/' is an ordinary character.
    إذا ((العدد >= 4) && (القيمة[0] == 0x5C) && (القيمة[1] == 0x5C) &&
        ((القيمة[2] == 0x3F) || (القيمة[2] == 0x2E)) && (القيمة[3] == 0x5C)) {
        دع حرفي: منطقي = القيمة[2] == 0x3F;
        دع بداية_الاسم: طبيعي = 4;
        إذا (حرفي && (العدد >= 8) &&
            تطابق_حرف_لاتيني(القيمة[4], 0x55) &&
            تطابق_حرف_لاتيني(القيمة[5], 0x4E) &&
            تطابق_حرف_لاتيني(القيمة[6], 0x43) && (القيمة[7] == 0x5C)) {
            دع نهاية_الخادم: طبيعي = بداية_جزء_بعد(&القيمة, 8, صواب);
            إذا ((نهاية_الخادم > 8) && (نهاية_الخادم < العدد)) {
                دع نهاية_المشاركة: طبيعي = بداية_جزء_بعد(&القيمة, نهاية_الخادم + 1, صواب);
                إذا (نهاية_المشاركة > نهاية_الخادم + 1) {
                    دع الجذر: متغير طبيعي = نهاية_المشاركة;
                    إذا (الجذر < العدد) { الجذر := الجذر + 1; };
                    دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: نهاية_المشاركة,
                        نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
                        حرفي: صواب, قرص_نسبي: خطأ };
                    أرجع التحليل;
                };
            };
        };
        إذا (حرفي && (العدد >= 6) && هل_حرف_قرص(القيمة[4]) && (القيمة[5] == 0x3A)) {
            دع الجذر: متغير طبيعي = 6;
            إذا ((العدد > 6) && (القيمة[6] == 0x5C)) { الجذر := 7; };
            دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 6,
                نهاية_الجذر: الجذر, مطلق: الجذر > 6, له_جذر: الجذر > 6,
                حرفي: صواب, قرص_نسبي: الجذر == 6 };
            أرجع التحليل;
        };
        دع النهاية: طبيعي = بداية_جزء_بعد(&القيمة, بداية_الاسم, صواب);
        دع الجذر: متغير طبيعي = النهاية;
        إذا (النهاية < العدد) { الجذر := النهاية + 1; };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: النهاية,
            نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
            حرفي: حرفي, قرص_نسبي: خطأ };
        أرجع التحليل;
    };

    إذا ((العدد >= 2) && هل_حرف_قرص(القيمة[0]) && (القيمة[1] == 0x3A)) {
        دع الجذر: متغير طبيعي = 2;
        إذا ((العدد > 2) && هل_فاصل_مسار(القيمة[2], الصيغة, خطأ)) { الجذر := 3; };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 2,
            نهاية_الجذر: الجذر, مطلق: الجذر > 2, له_جذر: الجذر > 2,
            حرفي: خطأ, قرص_نسبي: الجذر == 2 };
        أرجع التحليل;
    };

    إذا ((العدد >= 2) && هل_فاصل_مسار(القيمة[0], الصيغة, خطأ) &&
        هل_فاصل_مسار(القيمة[1], الصيغة, خطأ)) {
        دع نهاية_الخادم: طبيعي = بداية_جزء_بعد(&القيمة, 2, خطأ);
        إذا ((نهاية_الخادم > 2) && (نهاية_الخادم < العدد)) {
            دع نهاية_المشاركة: طبيعي = بداية_جزء_بعد(&القيمة, نهاية_الخادم + 1, خطأ);
            إذا (نهاية_المشاركة > نهاية_الخادم + 1) {
                دع الجذر: متغير طبيعي = نهاية_المشاركة;
                إذا (الجذر < العدد) { الجذر := الجذر + 1; };
                دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: نهاية_المشاركة,
                    نهاية_الجذر: الجذر, مطلق: صواب, له_جذر: صواب,
                    حرفي: خطأ, قرص_نسبي: خطأ };
                أرجع التحليل;
            };
            // A server without a share is not a fully qualified UNC path.
            // Retain the double-root spelling without inventing a volume.
            دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
                نهاية_الجذر: 2, مطلق: خطأ, له_جذر: صواب,
                حرفي: خطأ, قرص_نسبي: خطأ };
            أرجع التحليل;
        };
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: 2, مطلق: خطأ, له_جذر: صواب,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    };
    إذا ((العدد > 0) && هل_فاصل_مسار(القيمة[0], الصيغة, خطأ)) {
        دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
            نهاية_الجذر: 1, مطلق: خطأ, له_جذر: صواب,
            حرفي: خطأ, قرص_نسبي: خطأ };
        أرجع التحليل;
    };
    دع التحليل: تحليل_بادئة_مسار = { نهاية_البادئة: 0,
        نهاية_الجذر: 0, مطلق: خطأ, له_جذر: خطأ,
        حرفي: خطأ, قرص_نسبي: خطأ };
    أرجع التحليل;
}

// Root and prefix must be distinguished: "C:foo" has a drive prefix
// without a root, while "\\server\share\foo" has both.
عام عرف بادئة_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    إذا (البادئة.نهاية_البادئة == 0) { أرجع اختياري.لا_شيء(); };
    أرجع مقطع_نص(المسار, 0, البادئة.نهاية_البادئة);
}

عام عرف جذر_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    إذا (!البادئة.له_جذر) { أرجع اختياري.لا_شيء(); };
    أرجع مقطع_نص(المسار, 0, البادئة.نهاية_الجذر);
}

// A root and a fully qualified path are different on Windows: "\foo"
// has a root but depends on the current drive. "C:foo" has a drive prefix
// but depends on that drive's working directory.
عام عرف للمسار_جذر_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    أرجع البادئة.له_جذر;
}

عام عرف مسار_مطلق_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    أرجع البادئة.مطلق;
}

عام عرف مسار_نسبي_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): منطقي {
    أرجع !مسار_مطلق_بصيغة(المسار, الصيغة);
}

عام عرف مسار_مطلق(المسار: &نص): منطقي { أرجع مسار_مطلق_بصيغة(المسار, صيغة_مسار_المضيف()); }
عام عرف مسار_نسبي(المسار: &نص): منطقي { أرجع مسار_نسبي_بصيغة(المسار, صيغة_مسار_المضيف()); }

عرف مكون_مسار(المسار: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    طابق مقطع_نص(المسار, البداية, النهاية - البداية) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عرف نص_يساوي_مسارا(القيمة: &نص, المطلوب: نص): منطقي {
    دع ثابت: نص = المطلوب;
    أرجع نصان_متساويان(القيمة, &ثابت);
}

عرف انسخ_بايتات_مسار(الوجهة: &متغير متجه ط8, المصدر: &نص, البداية: طبيعي, النهاية: طبيعي): فراغ {
    دع فهرس: متغير طبيعي = البداية;
    طالما (فهرس < النهاية) {
        ألحق(*الوجهة, (*المصدر)[فهرس]);
        فهرس := فهرس + 1;
    }
}

// Translate ordinary Windows path separators only where components are
// composed. Never run this over an existing verbatim path's own spelling.
عرف انسخ_مقطع_مسار_بفواصل_الصيغة(
    الوجهة: &متغير متجه ط8, المصدر: &نص, النهاية: طبيعي, الصيغة: صيغة_مسار
): فراغ {
    دع فهرس: متغير طبيعي = 0;
    طالما (فهرس < النهاية) {
        دع الحرف: ط8 = (*المصدر)[فهرس];
        طابق الصيغة مع
        | صيغة_مسار.ويندوز -> {
            إذا (الحرف == 0x2F) { ألحق(*الوجهة, 0x5C); }
            وإلا { ألحق(*الوجهة, الحرف); };
        }
        | صيغة_مسار.يونكس -> { ألحق(*الوجهة, الحرف); };
        فهرس := فهرس + 1;
    }
}

// Lexical component normalization does not fold "..": symlink/../x is not
// generally equivalent to x. Verbatim Windows namespaces stay unchanged.
عام عرف طبع_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): نص {
    دع القيمة: نص = *المسار;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(المسار, الصيغة);
    إذا (البادئة.حرفي) { أرجع انسخ_نص(المسار); };
    دع البايتات: متغير متجه ط8 = [];
    إذا (البادئة.نهاية_الجذر > 0) {
        انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, المسار, البادئة.نهاية_الجذر, الصيغة);
    };
    دع بداية: متغير طبيعي = البادئة.نهاية_الجذر;
    دع الموضع: متغير طبيعي = بداية;
    دع أضيف_مكون: متغير منطقي = خطأ;
    طالما (الموضع <= العدد) {
        دع نهاية_مكون: متغير منطقي = الموضع == العدد;
        إذا (!نهاية_مكون) {
            نهاية_مكون := هل_فاصل_مسار(القيمة[الموضع], الصيغة, خطأ);
        };
        إذا (نهاية_مكون) {
            إذا (الموضع > بداية) {
                دع المكون: نص = مكون_مسار(&القيمة, بداية, الموضع);
                إذا (!نص_يساوي_مسارا(&المكون, «.»)) {
                    إذا (أضيف_مكون) {
                        ألحق(البايتات, فاصل_المسار_بصيغة(الصيغة));
                    };
                    انسخ_بايتات_مسار(&متغير البايتات, المسار, بداية, الموضع);
                    أضيف_مكون := صواب;
                };
            };
            بداية := الموضع + 1;
        };
        الموضع := الموضع + 1;
    }
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع «.»; };
    أرجع من_بايتات(&البايتات);
}

عام عرف طبع_المسار(المسار: &نص): نص { أرجع طبع_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

// Lexical cleaning, as Go's filepath.Clean and Cargo's normalize_path: the
// path is normalized (طبع_المسار_بصيغة), then each ".." removes the
// component before it without asking the file system, so "link/.." is
// cleaned to "." even when link is a symbolic link. A ".." with nothing
// before it stays in a relative path ("../x") and is dropped after a root
// ("/../x" is "/x"). Verbatim Windows namespaces stay unchanged.
عام عرف نظف_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): نص {
    دع المطبع: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&المطبع, الصيغة);
    إذا (البادئة.حرفي) { أرجع المطبع; };
    دع المكونات: متجه نص = مكونات_المسار_بصيغة(&المطبع, الصيغة);
    // المبقاة[0 .. العدد) are the components kept so far.
    دع المبقاة: متغير متجه نص = [];
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المكونات) مثل طبيعي)) {
        دع نقطتان: منطقي = نص_يساوي_مسارا(&المكونات[ف], «..»);
        إذا (نقطتان && العدد > 0 && !نص_يساوي_مسارا(&المبقاة[العدد - 1], «..»)) {
            العدد := العدد - 1;
        } وإلا إذا (!نقطتان || !البادئة.له_جذر) {
            إذا (العدد < (الطول(المبقاة) مثل طبيعي)) {
                المبقاة[العدد] := انسخ_نص(&المكونات[ف]);
            } وإلا {
                ألحق(المبقاة, انسخ_نص(&المكونات[ف]));
            };
            العدد := العدد + 1;
        };
        ف := ف + 1;
    }
    دع البايتات: متغير متجه ط8 = [];
    انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, &المطبع, البادئة.نهاية_الجذر, الصيغة);
    ف := 0;
    طالما (ف < العدد) {
        إذا (ف > 0) { ألحق(البايتات, فاصل_المسار_بصيغة(الصيغة)); };
        انسخ_بايتات_مسار(&متغير البايتات, &المبقاة[ف], 0, الطول(المبقاة[ف]) مثل طبيعي);
        ف := ف + 1;
    }
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع «.»; };
    أرجع من_بايتات(&البايتات);
}

عام عرف نظف_المسار(المسار: &نص): نص { أرجع نظف_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

// Path composition is lexical. On Windows a rooted path retains the left
// drive/UNC prefix; a new drive prefix replaces the entire left path.
عام عرف صل_المسار_بصيغة(اليسار: &نص, اليمين: &نص, الصيغة: صيغة_مسار): نص {
    دع الأصل: نص = *اليسار;
    دع الملحق: نص = *اليمين;
    إذا (الطول(الأصل) == 0) { أرجع انسخ_نص(اليمين); };
    إذا (الطول(الملحق) == 0) { أرجع انسخ_نص(اليسار); };
    دع بادئة_اليمين: تحليل_بادئة_مسار = حلل_بادئة_مسار(اليمين, الصيغة);
    دع بادئة_اليسار: تحليل_بادئة_مسار = حلل_بادئة_مسار(اليسار, الصيغة);
    إذا (بادئة_اليمين.نهاية_البادئة > 0) { أرجع انسخ_نص(اليمين); };
    إذا (بادئة_اليمين.له_جذر) {
        إذا (بادئة_اليسار.نهاية_البادئة == 0) { أرجع انسخ_نص(اليمين); };
        دع البايتات: متغير متجه ط8 = [];
        انسخ_بايتات_مسار(&متغير البايتات, اليسار, 0, بادئة_اليسار.نهاية_البادئة);
        إذا (بادئة_اليسار.حرفي) {
            انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, اليمين, الطول(الملحق) مثل طبيعي, الصيغة);
        } وإلا {
            انسخ_بايتات_مسار(&متغير البايتات, اليمين, 0, الطول(الملحق) مثل طبيعي);
        };
        أرجع من_بايتات(&البايتات);
    };
    دع البايتات: متغير متجه ط8 = [];
    دع طول_الأصل: طبيعي = الطول(الأصل) مثل طبيعي;
    انسخ_بايتات_مسار(&متغير البايتات, اليسار, 0, طول_الأصل);
    إذا (!هل_فاصل_مسار(الأصل[طول_الأصل - 1], الصيغة, بادئة_اليسار.حرفي) &&
        !((طول_الأصل == بادئة_اليسار.نهاية_البادئة) && بادئة_اليسار.قرص_نسبي)) {
        ألحق(البايتات, فاصل_المسار_بصيغة(الصيغة));
    };
    // A normal child path uses both Windows separators, but when appended to
    // a verbatim prefix only backslashes delimit components. Convert child
    // separators so joining never changes them into literal filename bytes.
    إذا (بادئة_اليسار.حرفي) {
        انسخ_مقطع_مسار_بفواصل_الصيغة(&متغير البايتات, اليمين, الطول(الملحق) مثل طبيعي, الصيغة);
    } وإلا {
        انسخ_بايتات_مسار(&متغير البايتات, اليمين, 0, الطول(الملحق) مثل طبيعي);
    };
    أرجع من_بايتات(&البايتات);
}

عام عرف صل_المسار(اليسار: &نص, اليمين: &نص): نص {
    أرجع صل_المسار_بصيغة(اليسار, اليمين, صيغة_مسار_المضيف());
}

عام عرف اسم_الملف_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    إذا (الطول(*المسار) == 0) { أرجع اختياري.لا_شيء(); };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    إذا (العدد <= البادئة.نهاية_الجذر) { أرجع اختياري.لا_شيء(); };
    إذا (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع اختياري.لا_شيء(); };
    دع البداية: متغير طبيعي = البادئة.نهاية_الجذر;
    دع ف: متغير طبيعي = العدد;
    طالما (ف > البادئة.نهاية_الجذر) {
        ف := ف - 1;
        إذا (هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي)) {
            البداية := ف + 1;
            ف := البادئة.نهاية_الجذر;
        };
    }
    إذا (البداية == العدد) { أرجع اختياري.لا_شيء(); };
    دع الاسم: نص = مكون_مسار(&القيمة, البداية, العدد);
    إذا (!البادئة.حرفي && نص_يساوي_مسارا(&الاسم, «..»)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الاسم);
}

عام عرف اسم_الملف(المسار: &نص): اختياري نص { أرجع اسم_الملف_بصيغة(المسار, صيغة_مسار_المضيف()); }

عام عرف أب_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    إذا (الطول(*المسار) == 0) { أرجع اختياري.لا_شيء(); };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    إذا (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع اختياري.لا_شيء(); };
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    إذا (العدد <= البادئة.نهاية_الجذر) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = العدد;
    طالما (ف > البادئة.نهاية_الجذر) {
        ف := ف - 1;
        إذا (هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي)) {
            إذا (ف == البادئة.نهاية_الجذر) {
                أرجع مقطع_نص(&القيمة, 0, البادئة.نهاية_الجذر);
            };
            أرجع مقطع_نص(&القيمة, 0, ف);
        };
    }
    إذا (البادئة.نهاية_الجذر > 0) {
        أرجع مقطع_نص(&القيمة, 0, البادئة.نهاية_الجذر);
    };
    أرجع اختياري.موجود(«.»);
}

عام عرف أب_المسار(المسار: &نص): اختياري نص { أرجع أب_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

عرف موضع_نقطة_امتداد(الاسم: &نص): اختياري طبيعي {
    دع القيمة: نص = *الاسم;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    إذا (العدد < 2) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = العدد;
    طالما (ف > 1) {
        ف := ف - 1;
        إذا (القيمة[ف] == 0x2E) { أرجع اختياري.موجود(ف); };
    }
    أرجع اختياري.لا_شيء();
}

عام عرف امتداد_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    طابق اسم_الملف_بصيغة(المسار, الصيغة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(النقطة) -> {
            أرجع مقطع_نص(&الاسم, النقطة + 1, (الطول(الاسم) مثل طبيعي) - النقطة - 1);
        };
    };
}

عام عرف امتداد_المسار(المسار: &نص): اختياري نص { أرجع امتداد_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

عام عرف ساق_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): اختياري نص {
    طابق اسم_الملف_بصيغة(المسار, الصيغة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الاسم) -> {
        طابق موضع_نقطة_امتداد(&الاسم) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الاسم); }
        | اختياري.موجود(النقطة) -> { أرجع مقطع_نص(&الاسم, 0, النقطة); };
    };
}

عام عرف ساق_المسار(المسار: &نص): اختياري نص { أرجع ساق_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

عام عرف مكونات_المسار_بصيغة(المسار: &نص, الصيغة: صيغة_مسار): متجه نص {
    دع الناتج: متغير متجه نص = [];
    إذا (الطول(*المسار) == 0) { أرجع الناتج; };
    دع القيمة: نص = طبع_المسار_بصيغة(المسار, الصيغة);
    إذا (نص_يساوي_مسارا(&القيمة, «.»)) { أرجع الناتج; };
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع البادئة: تحليل_بادئة_مسار = حلل_بادئة_مسار(&القيمة, الصيغة);
    دع البداية: متغير طبيعي = البادئة.نهاية_الجذر;
    دع ف: متغير طبيعي = البداية;
    طالما (ف <= العدد) {
        دع نهاية: متغير منطقي = ف == العدد;
        إذا (!نهاية) { نهاية := هل_فاصل_مسار(القيمة[ف], الصيغة, البادئة.حرفي); };
        إذا (نهاية) {
            إذا (ف > البداية) {
                ألحق(الناتج, مكون_مسار(&القيمة, البداية, ف));
            };
            البداية := ف + 1;
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف مكونات_المسار(المسار: &نص): متجه نص { أرجع مكونات_المسار_بصيغة(المسار, صيغة_مسار_المضيف()); }

عرف امتداد_مسار_صالح(الامتداد: &نص, الصيغة: صيغة_مسار): منطقي {
    دع القيمة: نص = *الامتداد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        إذا (هل_فاصل_مسار(القيمة[ف], الصيغة, خطأ)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف غير_امتداد_المسار_بصيغة(
    المسار: &نص, الامتداد_الجديد: &نص, الصيغة: صيغة_مسار
): اختياري نص {
    إذا (!امتداد_مسار_صالح(الامتداد_الجديد, الصيغة)) { أرجع اختياري.لا_شيء(); };
    طابق ساق_المسار_بصيغة(المسار, الصيغة) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الساق) -> {
        دع الاسم_الجديد_بايتات: متغير متجه ط8 = [];
        انسخ_بايتات_مسار(&متغير الاسم_الجديد_بايتات, &الساق, 0, الطول(الساق) مثل طبيعي);
        إذا (الطول(*الامتداد_الجديد) > 0) {
            ألحق(الاسم_الجديد_بايتات, 0x2E);
            انسخ_بايتات_مسار(&متغير الاسم_الجديد_بايتات, الامتداد_الجديد, 0, الطول(*الامتداد_الجديد) مثل طبيعي);
        };
        دع الاسم_الجديد: نص = من_بايتات(&الاسم_الجديد_بايتات);
        طابق أب_المسار_بصيغة(المسار, الصيغة) مع
        | اختياري.لا_شيء -> { أرجع اختياري.موجود(الاسم_الجديد); }
        | اختياري.موجود(الأب) -> {
            إذا (نص_يساوي_مسارا(&الأب, «.»)) { أرجع اختياري.موجود(الاسم_الجديد); };
            أرجع اختياري.موجود(صل_المسار_بصيغة(&الأب, &الاسم_الجديد, الصيغة));
        };
    };
}

عام عرف غير_امتداد_المسار(المسار: &نص, الامتداد_الجديد: &نص): اختياري نص {
    أرجع غير_امتداد_المسار_بصيغة(المسار, الامتداد_الجديد, صيغة_مسار_المضيف());
}

// The path that leads from the directory الأصل to الهدف: joined onto الأصل
// (صل_المسار_بصيغة) it names الهدف, as Python's os.path.relpath(target,
// start) and Rust's pathdiff::diff_paths(target, base). It is lexical, not a
// file-system query: both paths are normalized first (طبع_المسار_بصيغة,
// which keeps ".." because "link/.." is not generally the link's parent),
// components compare byte for byte (no Windows case folding), and symlinks
// are not resolved. لا_شيء when the two do not share a root and prefix (one
// absolute and one relative, two drives or shares), or when a ".." of الأصل
// lies past the common part: the name of the directory it leaves is not in
// the text. Equal paths give ".".
عام عرف مسار_نسبي_من_بصيغة(
    الأصل: &نص, الهدف: &نص, الصيغة: صيغة_مسار
): اختياري نص {
    دع أصل_مطبع: نص = طبع_المسار_بصيغة(الأصل, الصيغة);
    دع هدف_مطبع: نص = طبع_المسار_بصيغة(الهدف, الصيغة);
    دع بادئة_الأصل: تحليل_بادئة_مسار = حلل_بادئة_مسار(&أصل_مطبع, الصيغة);
    دع بادئة_الهدف: تحليل_بادئة_مسار = حلل_بادئة_مسار(&هدف_مطبع, الصيغة);
    إذا (بادئة_الأصل.حرفي != بادئة_الهدف.حرفي) { أرجع اختياري.لا_شيء(); };
    دع جذر_الأصل: نص = مكون_مسار(&أصل_مطبع, 0, بادئة_الأصل.نهاية_الجذر);
    دع جذر_الهدف: نص = مكون_مسار(&هدف_مطبع, 0, بادئة_الهدف.نهاية_الجذر);
    إذا (!نصان_متساويان(&جذر_الأصل, &جذر_الهدف)) { أرجع اختياري.لا_شيء(); };

    دع مكونات_الأصل: متجه نص = مكونات_المسار_بصيغة(&أصل_مطبع, الصيغة);
    دع مكونات_الهدف: متجه نص = مكونات_المسار_بصيغة(&هدف_مطبع, الصيغة);
    دع عدد_الأصل: طبيعي = الطول(مكونات_الأصل) مثل طبيعي;
    دع عدد_الهدف: طبيعي = الطول(مكونات_الهدف) مثل طبيعي;
    دع المشترك: متغير طبيعي = 0;
    طالما (المشترك < عدد_الأصل && المشترك < عدد_الهدف
        && نصان_متساويان(&مكونات_الأصل[المشترك], &مكونات_الهدف[المشترك])) {
        المشترك := المشترك + 1;
    }

    دع الفاصل: ط8 = فاصل_المسار_بصيغة(الصيغة);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = المشترك;
    طالما (ف < عدد_الأصل) {
        إذا (نص_يساوي_مسارا(&مكونات_الأصل[ف], «..»)) { أرجع اختياري.لا_شيء(); };
        إذا ((الطول(البايتات) مثل طبيعي) > 0) { ألحق(البايتات, الفاصل); };
        ألحق(البايتات, 0x2E);
        ألحق(البايتات, 0x2E);
        ف := ف + 1;
    }
    ف := المشترك;
    طالما (ف < عدد_الهدف) {
        إذا ((الطول(البايتات) مثل طبيعي) > 0) { ألحق(البايتات, الفاصل); };
        انسخ_بايتات_مسار(&متغير البايتات, &مكونات_الهدف[ف], 0, الطول(مكونات_الهدف[ف]) مثل طبيعي);
        ف := ف + 1;
    }
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع اختياري.موجود(«.»); };
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}

عام عرف مسار_نسبي_من(الأصل: &نص, الهدف: &نص): اختياري نص {
    أرجع مسار_نسبي_من_بصيغة(الأصل, الهدف, صيغة_مسار_المضيف());
}

عام مرادف path_separator = فاصل_المسار;
عام مرادف is_absolute = مسار_مطلق;
عام مرادف is_relative = مسار_نسبي;
عام مرادف normalize = طبع_المسار;
عام مرادف clean = نظف_المسار;
عام مرادف join = صل_المسار;
عام مرادف file_name = اسم_الملف;
عام مرادف parent = أب_المسار;
عام مرادف extension = امتداد_المسار;
عام مرادف stem = ساق_المسار;
عام مرادف components = مكونات_المسار;
عام مرادف with_extension = غير_امتداد_المسار;
عام مرادف relative_path_from = مسار_نسبي_من;
عام مرادف path_separator_for = فاصل_المسار_بصيغة;
عام مرادف prefix_for = بادئة_المسار_بصيغة;
عام مرادف root_for = جذر_المسار_بصيغة;
عام مرادف has_root_for = للمسار_جذر_بصيغة;
عام مرادف is_absolute_for = مسار_مطلق_بصيغة;
عام مرادف is_relative_for = مسار_نسبي_بصيغة;
عام مرادف normalize_for = طبع_المسار_بصيغة;
عام مرادف clean_for = نظف_المسار_بصيغة;
عام مرادف join_for = صل_المسار_بصيغة;
عام مرادف file_name_for = اسم_الملف_بصيغة;
عام مرادف parent_for = أب_المسار_بصيغة;
عام مرادف extension_for = امتداد_المسار_بصيغة;
عام مرادف stem_for = ساق_المسار_بصيغة;
عام مرادف components_for = مكونات_المسار_بصيغة;
عام مرادف with_extension_for = غير_امتداد_المسار_بصيغة;
عام مرادف relative_path_from_for = مسار_نسبي_من_بصيغة;
