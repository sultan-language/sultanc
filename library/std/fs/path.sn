عام مرادف parent = أب_المسار;
عام مرادف extension = امتداد_المسار;
عام مرادف stem = ساق_المسار;
عام مرادف components = مكونات_المسار;
عام مرادف with_extension = غير_امتداد_المسار;
عام مرادف path_separator_for = فاصل_المسار_بصيغة;
عام مرادف prefix_for = بادئة_المسار_بصيغة;
عام مرادف root_for = جذر_المسار_بصيغة;
عام مرادف has_root_for = للمسار_جذر_بصيغة;
عام مرادف is_absolute_for = مسار_مطلق_بصيغة;
عام مرادف is_relative_for = مسار_نسبي_بصيغة;
عام مرادف normalize_for = طبع_المسار_بصيغة;
عام مرادف join_for = صل_المسار_بصيغة;
عام مرادف file_name_for = اسم_الملف_بصيغة;
عام مرادف parent_for = أب_المسار_بصيغة;
عام مرادف extension_for = امتداد_المسار_بصيغة;
عام مرادف stem_for = ساق_المسار_بصيغة;
عام مرادف components_for = مكونات_المسار_بصيغة;
عام مرادف with_extension_for = غير_امتداد_المسار_بصيغة;
