استورد os.directory;
استورد os.file;
استورد os.error;

// Keep the established signed-error public contract while native providers
// retain the source namespace and code in std.os.
عرف حالة_تغيير_ملف(النتيجة: نتيجة عدد, خطأ_حد_نظام): نتيجة عدد, عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(رمز_خطأ_حد_النظام(الخطأ)); }
    | نتيجة.نجح(الحالة) -> { أرجع نتيجة.نجح(الحالة); };
}

عام عرف أنشئ_دليلا(المسار: &نص): نتيجة عدد, عدد {
    أرجع حالة_تغيير_ملف(أنشئ_دليل_نظام(المسار));
}
عام عرف أزل_ملفا(المسار: &نص): نتيجة عدد, عدد {
    أرجع حالة_تغيير_ملف(أزل_ملف_نظام(المسار));
}
عام عرف أزل_دليلا(المسار: &نص): نتيجة عدد, عدد {
    أرجع حالة_تغيير_ملف(أزل_دليل_نظام(المسار));
}
عام عرف أعد_تسمية(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    أرجع حالة_تغيير_ملف(أعد_تسمية_مسار_نظام(المصدر, الوجهة));
}

عام مرادف create_directory = أنشئ_دليلا;
عام مرادف remove_file = أزل_ملفا;
عام مرادف remove_directory = أزل_دليلا;
عام مرادف rename = أعد_تسمية;
