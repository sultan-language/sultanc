مرادف أنشئ_دليلا_داخليا = بدائي_إنشاء_دليل;
مرادف أزل_ملفا_داخليا = بدائي_إزالة_ملف;
مرادف أزل_دليلا_داخليا = بدائي_إزالة_دليل;
مرادف أعد_تسمية_داخليا = بدائي_إعادة_تسمية;

عرف نتيجة_حالة_ملف(الحالة: عدد): نتيجة عدد, عدد {
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام عرف أنشئ_دليلا(المسار: &نص): نتيجة عدد, عدد {
    أرجع نتيجة_حالة_ملف(أنشئ_دليلا_داخليا(*المسار));
}

عام عرف أزل_ملفا(المسار: &نص): نتيجة عدد, عدد {
    أرجع نتيجة_حالة_ملف(أزل_ملفا_داخليا(*المسار));
}

عام عرف أزل_دليلا(المسار: &نص): نتيجة عدد, عدد {
    أرجع نتيجة_حالة_ملف(أزل_دليلا_داخليا(*المسار));
}

عام عرف أعد_تسمية(المصدر: &نص, الوجهة: &نص): نتيجة عدد, عدد {
    أرجع نتيجة_حالة_ملف(أعد_تسمية_داخليا(*المصدر, *الوجهة));
}

عام مرادف create_directory = أنشئ_دليلا;
عام مرادف remove_file = أزل_ملفا;
عام مرادف remove_directory = أزل_دليلا;
عام مرادف rename = أعد_تسمية;
