استورد fs.error;

استورد os.file;
استورد os.error;

عرف حالة_معلومات_المسار(النتيجة: نتيجة عدد, خطأ_حد_نظام): عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}

عرف نوع_مسار_داخليا(المسار: &نص): عدد {
    أرجع حالة_معلومات_المسار(نوع_مسار_نظام(المسار));
}
عرف حجم_مسار_داخليا(المسار: &نص): عدد {
    أرجع حالة_معلومات_المسار(حجم_مسار_نظام(المسار));
}
عرف وقت_تعديل_مسار_داخليا(المسار: &نص): عدد {
    أرجع حالة_معلومات_المسار(تعديل_مسار_نظام(المسار));
}

عام نوع نوع_مسار =
    | ملف
    | دليل
    | وصلة_رمزية
    | آخر
;

عرف نوع_مسار_من_رمز(الرمز: عدد): نوع_مسار {
    لو (الرمز == 1) { أرجع نوع_مسار.ملف(); };
    لو (الرمز == 2) { أرجع نوع_مسار.دليل(); };
    لو (الرمز == 3) { أرجع نوع_مسار.وصلة_رمزية(); };
    أرجع نوع_مسار.آخر();
}

عام عرف حاول_نوع_المسار(المسار: &نص): نتيجة نوع_مسار, عدد {
    دع الرمز: عدد = نوع_مسار_داخليا(المسار);
    لو (الرمز < 0) { أرجع نتيجة.خطأ(الرمز); };
    أرجع نتيجة.نجح(نوع_مسار_من_رمز(الرمز));
}

عام عرف موجود(المسار: &نص): نتيجة منطقي, عدد {
    دع الرمز: عدد = نوع_مسار_داخليا(المسار);
    لو (الرمز >= 0) { أرجع نتيجة.نجح(صواب); };
    لو (هل_خطأ_غير_موجود(الرمز)) { أرجع نتيجة.نجح(خطأ); };
    أرجع نتيجة.خطأ(الرمز);
}

عام عرف حجم_المسار(المسار: &نص): نتيجة عدد, عدد {
    دع الحجم: عدد = حجم_مسار_داخليا(المسار);
    لو (الحجم < 0) { أرجع نتيجة.خطأ(الحجم); };
    أرجع نتيجة.نجح(الحجم);
}

عام عرف وقت_تعديل_المسار_نانو(المسار: &نص): نتيجة عدد, عدد {
    دع الوقت: عدد = وقت_تعديل_مسار_داخليا(المسار);
    لو (الوقت < 0) { أرجع نتيجة.خطأ(الوقت); };
    أرجع نتيجة.نجح(الوقت);
}

عام مرادف path_type = نوع_مسار;
عام مرادف path_type.file = نوع_مسار.ملف;
عام مرادف path_type.directory = نوع_مسار.دليل;
عام مرادف path_type.symlink = نوع_مسار.وصلة_رمزية;
عام مرادف path_type.other = نوع_مسار.آخر;
عام مرادف try_path_type = حاول_نوع_المسار;
عام مرادف exists = موجود;
عام مرادف path_size = حجم_المسار;
عام مرادف path_modified_time_ns = وقت_تعديل_المسار_نانو;
