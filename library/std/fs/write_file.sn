استورد fs.write_bytes;

عام عرف اكتب_الملف(المسار: &نص, المحتوى: &نص): نتيجة عدد, عدد {
    دع النص: نص = *المحتوى;
    دع البايتات: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(النص) مثل طبيعي)) {
        ألحق(البايتات, النص[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    أرجع اكتب_البايتات(المسار, &البايتات);
}

عام مرادف write_file = اكتب_الملف;
