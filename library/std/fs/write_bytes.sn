استورد os.file;
استورد os.error;

عرف حالة_كتابة_ملف(النتيجة: نتيجة عدد, خطأ_حد_نظام): عدد {
    طابق النتيجة مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; };
}
عرف أنشئ_للكتابة(المسار: &نص): عدد {
    طابق أنشئ_ملف_نظام_للكتابة(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_حد_النظام(الخطأ); }
    | نتيجة.نجح(الملف) -> { أرجع الملف.القيمة مثل عدد; };
}
عرف اكتب_مقطعا(المعرف: عدد, المحتوى: &متجه غ8, الإزاحة: عدد, العدد: عدد): عدد {
    دع الملف: ملف_نظام = { القيمة: المعرف مثل غ64, مفتوح: صواب };
    أرجع حالة_كتابة_ملف(اكتب_ملف_نظام(&الملف, المحتوى, الإزاحة, العدد));
}
عرف أغلق(المعرف: عدد): عدد {
    دع الملف: متغير ملف_نظام = { القيمة: المعرف مثل غ64, مفتوح: صواب };
    أرجع حالة_كتابة_ملف(أغلق_ملف_نظام(&متغير الملف));
}

عام عرف اكتب_البايتات(المسار: &نص, المحتوى: &متجه غ8): نتيجة عدد, عدد {
    دع الواصف: عدد = أنشئ_للكتابة(المسار);
    لو (الواصف < 0) { أرجع نتيجة.خطأ(الواصف); };

    دع العدد: عدد = الطول(*المحتوى);
    دع الإزاحة: متغير عدد = 0;
    بينما (الإزاحة < العدد) {
        دع المكتوب: عدد = اكتب_مقطعا(الواصف, المحتوى, الإزاحة, العدد - الإزاحة);
        لو (المكتوب < 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(المكتوب);
        };
        لو (المكتوب == 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(-2);
        };
        الإزاحة := الإزاحة + المكتوب;
    }

    دع حالة_الإغلاق: عدد = أغلق(الواصف);
    لو (حالة_الإغلاق < 0) { أرجع نتيجة.خطأ(حالة_الإغلاق); };
    أرجع نتيجة.نجح(الإزاحة);
}

عام مرادف write_bytes = اكتب_البايتات;
