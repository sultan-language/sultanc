خارجي عرف تشغيل_إنشاء_ملف_للكتابة(الحجة_0: نص): عدد;
عرف أنشئ_للكتابة(الحجة_0: &نص): عدد {
    أرجع تشغيل_إنشاء_ملف_للكتابة(*الحجة_0);
}
خارجي عرف تشغيل_كتابة_مقطع_ملف(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اكتب_مقطعا(الحجة_0: عدد, الحجة_1: &متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_كتابة_مقطع_ملف(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_إغلاق_ملف(الحجة_0: عدد): عدد;
عرف أغلق(الحجة_0: عدد): عدد { أرجع تشغيل_إغلاق_ملف(الحجة_0); }

عام عرف اكتب_البايتات(المسار: &نص, المحتوى: &متجه غ8): نتيجة عدد, عدد {
    دع الواصف: عدد = أنشئ_للكتابة(المسار);
    لو (الواصف < 0) { أرجع نتيجة.خطأ(الواصف); };

    دع العدد: عدد = الطول(*المحتوى);
    دع الإزاحة: متغير عدد = 0;
    بينما (الإزاحة < العدد) {
        دع المكتوب: عدد = اكتب_مقطعا(الواصف, المحتوى, الإزاحة, العدد - الإزاحة);
        لو (المكتوب < 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(المكتوب);
        };
        لو (المكتوب == 0) {
            أغلق(الواصف);
            أرجع نتيجة.خطأ(-2);
        };
        الإزاحة := الإزاحة + المكتوب;
    }

    دع حالة_الإغلاق: عدد = أغلق(الواصف);
    لو (حالة_الإغلاق < 0) { أرجع نتيجة.خطأ(حالة_الإغلاق); };
    أرجع نتيجة.نجح(الإزاحة);
}

عام مرادف write_bytes = اكتب_البايتات;
