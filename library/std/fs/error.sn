خارجي عرف تشغيل_تصنيف_خطأ_نظام(الحجة_0: عدد): عدد;
عرف صنف_خطأ_نظام_خام(الحجة_0: عدد): عدد { أرجع تشغيل_تصنيف_خطأ_نظام(الحجة_0); }

عام نوع فئة_خطأ_نظام =
    | لا_خطأ
    | غير_موجود
    | مرفوض_الإذن
    | موجود_مسبقا
    | إدخال_غير_صالح
    | غير_مدعوم
    | هو_دليل
    | ليس_دليلا
    | مورد_منهك
    | مقاطعة
    | آخر
;

// Runtime owns errno/host-error mapping. Std only names its neutral class codes.
عام عرف صنف_خطأ_نظام(الخطأ: عدد): فئة_خطأ_نظام {
    دع الفئة: عدد = صنف_خطأ_نظام_خام(الخطأ);
    لو (الفئة == 0) { أرجع فئة_خطأ_نظام.لا_خطأ(); };
    لو (الفئة == 1) { أرجع فئة_خطأ_نظام.غير_موجود(); };
    لو (الفئة == 2) { أرجع فئة_خطأ_نظام.مرفوض_الإذن(); };
    لو (الفئة == 3) { أرجع فئة_خطأ_نظام.موجود_مسبقا(); };
    لو (الفئة == 4) { أرجع فئة_خطأ_نظام.إدخال_غير_صالح(); };
    لو (الفئة == 5) { أرجع فئة_خطأ_نظام.غير_مدعوم(); };
    لو (الفئة == 6) { أرجع فئة_خطأ_نظام.هو_دليل(); };
    لو (الفئة == 7) { أرجع فئة_خطأ_نظام.ليس_دليلا(); };
    لو (الفئة == 8) { أرجع فئة_خطأ_نظام.مورد_منهك(); };
    لو (الفئة == 9) { أرجع فئة_خطأ_نظام.مقاطعة(); };
    أرجع فئة_خطأ_نظام.آخر();
}

عام عرف هل_خطأ_غير_موجود(الخطأ: عدد): منطقي {
    طابق صنف_خطأ_نظام(الخطأ) مع
    | فئة_خطأ_نظام.غير_موجود -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام مرادف os_error_class = فئة_خطأ_نظام;
عام مرادف os_error_class.none = فئة_خطأ_نظام.لا_خطأ;
عام مرادف os_error_class.not_found = فئة_خطأ_نظام.غير_موجود;
عام مرادف os_error_class.permission_denied = فئة_خطأ_نظام.مرفوض_الإذن;
عام مرادف os_error_class.already_exists = فئة_خطأ_نظام.موجود_مسبقا;
عام مرادف os_error_class.invalid_input = فئة_خطأ_نظام.إدخال_غير_صالح;
عام مرادف os_error_class.unsupported = فئة_خطأ_نظام.غير_مدعوم;
عام مرادف os_error_class.is_directory = فئة_خطأ_نظام.هو_دليل;
عام مرادف os_error_class.not_directory = فئة_خطأ_نظام.ليس_دليلا;
عام مرادف os_error_class.resource_exhausted = فئة_خطأ_نظام.مورد_منهك;
عام مرادف os_error_class.interrupted = فئة_خطأ_نظام.مقاطعة;
عام مرادف os_error_class.other = فئة_خطأ_نظام.آخر;
عام مرادف classify_os_error = صنف_خطأ_نظام;
عام مرادف is_not_found_error = هل_خطأ_غير_موجود;
