// Uniquely named temporary directories and files (Go os.MkdirTemp and
// os.CreateTemp; Rust's tempfile crate). A name is the prefix followed by 16
// lowercase hexadecimal digits from the system CSPRNG. The directory is
// created with mkdir and the file with exclusive creation, so an existing
// path is never reused; a collision is retried with a new name. Nothing is
// removed automatically: remove the result with std.fs.walk's احذف_الشجرة or
// std.fs.mutation's أزل_ملفا.

عام نوع ملف_مؤقت = { المسار: نص, المقبض: مقبض_ملف };

عرف بادئة_مؤقتة_صالحة(البادئة: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البادئة) مثل طبيعي)) {
        دع البايت: ط8 = (*البادئة)[ف];
        لو (البايت == 0x2F || البايت == 0x5C || البايت == 0) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_مؤقت(الدليل: &نص, البادئة: &نص): نتيجة نص, فئة_خطأ_نظام {
    دع العشوائي: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    طابق املأ_بايتات_عشوائية_النظام(&متغير العشوائي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(فئة_خطأ_حد_نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {};
    دع الأرقام: نص = «0123456789abcdef»;
    دع الاسم: متغير متجه ط8 = بايتات_من_نص(انسخ_نص(البادئة));
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        ألحق(الاسم, الأرقام[(العشوائي[ف] >> 4) مثل طبيعي]);
        ألحق(الاسم, الأرقام[(العشوائي[ف] & 15) مثل طبيعي]);
        ف := ف + 1;
    }
    دع نص_الاسم: نص = من_بايتات(&الاسم);
    أرجع نتيجة.نجح(صل_المسار_بصيغة(الدليل, &نص_الاسم, صيغة_مسار_المضيف()));
}

// A new directory inside الدليل (mode 0o700 where permissions exist).
عام عرف أنشئ_دليلا_مؤقتا_في(الدليل: &نص, البادئة: &نص): نتيجة نص, فئة_خطأ_نظام {
    لو (!بادئة_مؤقتة_صالحة(البادئة)) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    دع المحاولة: متغير طبيعي = 0;
    طالما (المحاولة < 16) {
        طابق اسم_مؤقت(الدليل, البادئة) مع
        | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
        | نتيجة.نجح(المسار) -> {
            طابق أنشئ_دليلا(&المسار) مع
            | نتيجة.نجح(_) -> {
                دع الأذونات: نتيجة عدد, خطأ_حد_نظام = اضبط_أذونات_مسار_نظام(&المسار, 0x1c0);
                أرجع نتيجة.نجح(المسار);
            }
            | نتيجة.خطأ(الرمز) -> {
                طابق صنف_خطأ_نظام(الرمز) مع
                | فئة_خطأ_نظام.موجود_مسبقا -> {}
                | _ -> { أرجع نتيجة.خطأ(صنف_خطأ_نظام(الرمز)); };
            };
        };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(فئة_خطأ_نظام.موجود_مسبقا());
}

// A new file inside الدليل (mode 0o600), open for reading and writing.
عام عرف أنشئ_ملفا_مؤقتا_في(الدليل: &نص, البادئة: &نص): نتيجة ملف_مؤقت, فئة_خطأ_نظام {
    لو (!بادئة_مؤقتة_صالحة(البادئة)) { أرجع نتيجة.خطأ(فئة_خطأ_نظام.إدخال_غير_صالح()); };
    دع المحاولة: متغير طبيعي = 0;
    طالما (المحاولة < 16) {
        طابق اسم_مؤقت(الدليل, البادئة) مع
        | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
        | نتيجة.نجح(المسار) -> {
            طابق أنشئ_ملفا_جديدا_نظام(&المسار, 0x180) مع
            | نتيجة.نجح(النظامي) -> {
                دع المقبض: مقبض_ملف = صندوق (النظامي.القيمة مثل عدد);
                دع الناتج: ملف_مؤقت = { المسار: المسار, المقبض: المقبض };
                أرجع نتيجة.نجح(الناتج);
            }
            | نتيجة.خطأ(الخطأ) -> {
                طابق فئة_خطأ_حد_نظام(الخطأ) مع
                | فئة_خطأ_نظام.موجود_مسبقا -> {}
                | _ -> { أرجع نتيجة.خطأ(فئة_خطأ_حد_نظام(الخطأ)); };
            };
        };
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(فئة_خطأ_نظام.موجود_مسبقا());
}

// Without TMPDIR, Unix falls back to /tmp (Android: /data/local/tmp), as Go's
// os.TempDir and Rust's env::temp_dir do; Windows (GetTempPathW) and WASI
// report their own errors.
لو (الهدف.المنصة == «linux» || الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos») {
    عرف دليل_مؤقت_افتراضي(): اختياري نص { أرجع اختياري.موجود(«/tmp»); }
}
لو (الهدف.المنصة == «android») {
    عرف دليل_مؤقت_افتراضي(): اختياري نص { أرجع اختياري.موجود(«/data/local/tmp»); }
}
لو (الهدف.المنصة == «windows» || الهدف.المنصة == «wasi») {
    عرف دليل_مؤقت_افتراضي(): اختياري نص { أرجع اختياري.لا_شيء(); }
}

عرف الدليل_المؤقت_كفئة(): نتيجة نص, فئة_خطأ_نظام {
    طابق الدليل_المؤقت() مع
    | نتيجة.خطأ(الرمز) -> {
        طابق دليل_مؤقت_افتراضي() مع
        | اختياري.موجود(الافتراضي) -> { أرجع نتيجة.نجح(الافتراضي); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_نظام(الرمز)); };
    }
    | نتيجة.نجح(الدليل) -> { أرجع نتيجة.نجح(الدليل); };
}

// The same inside the system temporary directory (std.env's الدليل_المؤقت).
عام عرف أنشئ_دليلا_مؤقتا(البادئة: &نص): نتيجة نص, فئة_خطأ_نظام {
    طابق الدليل_المؤقت_كفئة() مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(الدليل) -> { أرجع أنشئ_دليلا_مؤقتا_في(&الدليل, البادئة); };
}

عام عرف أنشئ_ملفا_مؤقتا(البادئة: &نص): نتيجة ملف_مؤقت, فئة_خطأ_نظام {
    طابق الدليل_المؤقت_كفئة() مع
    | نتيجة.خطأ(الفئة) -> { أرجع نتيجة.خطأ(الفئة); }
    | نتيجة.نجح(الدليل) -> { أرجع أنشئ_ملفا_مؤقتا_في(&الدليل, البادئة); };
}

// Closes the file's handle and gives back its path (the file stays).
عام عرف أغلق_ملفا_مؤقتا(الملف: ملف_مؤقت): نتيجة نص, عدد {
    طابق الملف مع
    | { المسار: المسار, المقبض: المقبض } -> {
        طابق أغلق_مقبض_ملف(المقبض) مع
        | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المسار); };
    };
}

عام نوع temp_file = ملف_مؤقت;
عام مرادف close_temp_file = أغلق_ملفا_مؤقتا;
عام مرادف create_temp_dir_in = أنشئ_دليلا_مؤقتا_في;
عام مرادف create_temp_file_in = أنشئ_ملفا_مؤقتا_في;
عام مرادف create_temp_dir = أنشئ_دليلا_مؤقتا;
عام مرادف create_temp_file = أنشئ_ملفا_مؤقتا;
