// Persistent file handles are affine values. The runtime owns the opaque raw
// handle; std wraps that identity in an owned box so ordinary SultanC
// move/borrow rules prevent accidental copying and use-after-close.

خارجي عرف تشغيل_فتح_مقبض_ملف_للقراءة(الحجة_0: نص): عدد;
عرف افتح_مقبض_ملف_خام_للقراءة(الحجة_0: &نص): عدد {
    أرجع تشغيل_فتح_مقبض_ملف_للقراءة(*الحجة_0);
}
خارجي عرف تشغيل_إنشاء_مقبض_ملف_للكتابة(الحجة_0: نص): عدد;
عرف أنشئ_مقبض_ملف_خام_للكتابة(الحجة_0: &نص): عدد {
    أرجع تشغيل_إنشاء_مقبض_ملف_للكتابة(*الحجة_0);
}
خارجي عرف تشغيل_قراءة_مقطع_مقبض_ملف(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اقرأ_مقطع_مقبض_ملف_خام(الحجة_0: عدد, الحجة_1: &متغير متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_قراءة_مقطع_مقبض_ملف(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_كتابة_مقطع_مقبض_ملف(الحجة_0: عدد, الحجة_1: متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد;
عرف اكتب_مقطع_مقبض_ملف_خام(الحجة_0: عدد, الحجة_1: &متجه غ8, الحجة_2: عدد, الحجة_3: عدد): عدد {
    أرجع تشغيل_كتابة_مقطع_مقبض_ملف(الحجة_0, *الحجة_1, الحجة_2, الحجة_3);
}
خارجي عرف تشغيل_إغلاق_مقبض_ملف(الحجة_0: عدد): عدد;
عرف أغلق_مقبض_ملف_خام(الحجة_0: عدد): عدد { أرجع تشغيل_إغلاق_مقبض_ملف(الحجة_0); }
خارجي عرف تشغيل_تحريك_مقبض_ملف(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد;
عرف حرك_مقبض_ملف_خام(الحجة_0: عدد, الحجة_1: عدد, الحجة_2: عدد): عدد { أرجع تشغيل_تحريك_مقبض_ملف(الحجة_0, الحجة_1, الحجة_2); }
خارجي عرف تشغيل_موضع_مقبض_ملف(الحجة_0: عدد): عدد;
عرف موضع_مقبض_ملف_خام(الحجة_0: عدد): عدد { أرجع تشغيل_موضع_مقبض_ملف(الحجة_0); }
خارجي عرف تشغيل_مزامنة_مقبض_ملف(الحجة_0: عدد): عدد;
عرف زامن_مقبض_ملف_خام(الحجة_0: عدد): عدد { أرجع تشغيل_مزامنة_مقبض_ملف(الحجة_0); }

عام نوع مقبض_ملف = صندوق عدد;

عام نوع أصل_موضع_ملف =
    | البداية
    | الحالي
    | النهاية
;

عرف قيمة_أصل_موضع_ملف(الأصل: أصل_موضع_ملف): عدد {
    طابق الأصل مع
    | أصل_موضع_ملف.البداية -> { أرجع 0; }
    | أصل_موضع_ملف.الحالي -> { أرجع 1; }
    | أصل_موضع_ملف.النهاية -> { أرجع 2; };
}

عرف قيمة_مقبض_ملف(المقبض: &مقبض_ملف): عدد {
    أرجع **المقبض;
}

عام عرف افتح_مقبض_ملف_للقراءة(المسار: &نص): نتيجة مقبض_ملف, عدد {
    دع الخام: عدد = افتح_مقبض_ملف_خام_للقراءة(المسار);
    لو (الخام < 0) { أرجع نتيجة.خطأ(الخام); };
    دع المقبض: مقبض_ملف = صندوق الخام;
    أرجع نتيجة.نجح(المقبض);
}

عام عرف أنشئ_مقبض_ملف_للكتابة(المسار: &نص): نتيجة مقبض_ملف, عدد {
    دع الخام: عدد = أنشئ_مقبض_ملف_خام_للكتابة(المسار);
    لو (الخام < 0) { أرجع نتيجة.خطأ(الخام); };
    دع المقبض: مقبض_ملف = صندوق الخام;
    أرجع نتيجة.نجح(المقبض);
}

عام عرف اقرأ_من_مقبض_ملف(
    المقبض: &مقبض_ملف,
    المخزن: &متغير متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع الحالة: متغير متجه غ8 = *المخزن;
    دع المقروء: عدد = اقرأ_مقطع_مقبض_ملف_خام(قيمة_مقبض_ملف(المقبض), &متغير الحالة, الإزاحة, العدد);
    *المخزن := الحالة;
    لو (المقروء < 0) { أرجع نتيجة.خطأ(المقروء); };
    أرجع نتيجة.نجح(المقروء);
}

عام عرف اكتب_إلى_مقبض_ملف(
    المقبض: &مقبض_ملف,
    المحتوى: &متجه غ8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    دع الحالة: متجه غ8 = *المحتوى;
    دع المكتوب: عدد = اكتب_مقطع_مقبض_ملف_خام(قيمة_مقبض_ملف(المقبض), &الحالة, الإزاحة, العدد);
    لو (المكتوب < 0) { أرجع نتيجة.خطأ(المكتوب); };
    أرجع نتيجة.نجح(المكتوب);
}

عام عرف حرك_مقبض_ملف(
    المقبض: &مقبض_ملف,
    الإزاحة: عدد,
    الأصل: أصل_موضع_ملف
): نتيجة عدد, عدد {
    دع الموضع: عدد = حرك_مقبض_ملف_خام(
        قيمة_مقبض_ملف(المقبض), الإزاحة, قيمة_أصل_موضع_ملف(الأصل)
    );
    لو (الموضع < 0) { أرجع نتيجة.خطأ(الموضع); };
    أرجع نتيجة.نجح(الموضع);
}

عام عرف موضع_مقبض_ملف(المقبض: &مقبض_ملف): نتيجة عدد, عدد {
    دع الموضع: عدد = موضع_مقبض_ملف_خام(قيمة_مقبض_ملف(المقبض));
    لو (الموضع < 0) { أرجع نتيجة.خطأ(الموضع); };
    أرجع نتيجة.نجح(الموضع);
}

عام عرف زامن_مقبض_ملف(المقبض: &مقبض_ملف): نتيجة عدد, عدد {
    دع الحالة: عدد = زامن_مقبض_ملف_خام(قيمة_مقبض_ملف(المقبض));
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

// Close consumes the affine handle. The runtime closes the OS handle, then std
// releases the SultanC box that carried the affine identity.
عام عرف أغلق_مقبض_ملف(المقبض: مقبض_ملف): نتيجة عدد, عدد {
    دع الخام: عدد = *المقبض;
    دع الحالة: عدد = أغلق_مقبض_ملف_خام(الخام);
    حرر(المقبض);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(الحالة); };
    أرجع نتيجة.نجح(الحالة);
}

عام نوع file_handle = مقبض_ملف;
عام نوع file_seek_origin = أصل_موضع_ملف;
عام مرادف open_file_handle_read = افتح_مقبض_ملف_للقراءة;
عام مرادف create_file_handle_write = أنشئ_مقبض_ملف_للكتابة;
عام مرادف file_handle_read = اقرأ_من_مقبض_ملف;
عام مرادف file_handle_write = اكتب_إلى_مقبض_ملف;
عام مرادف file_handle_seek = حرك_مقبض_ملف;
عام مرادف file_handle_tell = موضع_مقبض_ملف;
عام مرادف file_handle_flush = زامن_مقبض_ملف;
عام مرادف file_handle_close = أغلق_مقبض_ملف;
