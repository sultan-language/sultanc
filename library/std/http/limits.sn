عام نوع صنف_خطأ_ويب =
    | غير_مكتمل
    | سطر_بداية_طويل
    | قسم_رؤوس_كبير
    | رؤوس_كثيرة
    | طريقة_غير_صالحة
    | هدف_غير_صالح
    | إصدار_غير_مدعوم
    | اسم_رأس_غير_صالح
    | قيمة_رأس_غير_صالحة
    | طي_رأس_قديم
    | طول_محتوى_غير_صالح
    | أطوال_محتوى_متعددة
    | ترميز_نقل_مع_طول
    | ترميز_نقل_غير_مدعوم
    | حجم_قطعة_غير_صالح
    | سطر_قطعة_طويل
    | نهاية_قطعة_غير_صالحة
    | جسم_كبير
    | مضيف_مفقود
    | مضيفون_متعددون
    | مضيف_غير_صالح
    | رأس_لاحق_ممنوع
    | محتوى_غير_مسموح
    | حالة_غير_صالحة
;

عام نوع خطأ_ويب = {
    الصنف: صنف_خطأ_ويب,
    الإزاحة: غير_موقع
};

عام نوع حدود_ويب = {
    أقصى_سطر_بداية: غير_موقع,
    أقصى_بايتات_رؤوس: غير_موقع,
    أقصى_عدد_رؤوس: غير_موقع,
    أقصى_بايتات_جسم: غير_موقع,
    أقصى_بايتات_سطر_قطعة: غير_موقع
};

عام عرف حدود_ويب_افتراضية(): حدود_ويب {
    دع الناتج: حدود_ويب = {
        أقصى_سطر_بداية: 8192,
        أقصى_بايتات_رؤوس: 65536,
        أقصى_عدد_رؤوس: 128,
        أقصى_بايتات_جسم: 8388608,
        أقصى_بايتات_سطر_قطعة: 8192
    };
    أرجع الناتج;
}

عام نوع حدود_استجابة_ويب1 = {
    أقصى_سطر_حالة: غير_موقع,
    أقصى_بايتات_رؤوس: غير_موقع,
    أقصى_عدد_رؤوس: غير_موقع,
    أقصى_بايتات_جسم: غير_موقع,
    أقصى_بايتات_سطر_قطعة: غير_موقع,
    أقصى_بايتات_رؤوس_لاحقة: غير_موقع,
    أقصى_عدد_رؤوس_لاحقة: غير_موقع
};

عام عرف حدود_استجابة_ويب1_افتراضية(): حدود_استجابة_ويب1 {
    دع الناتج: حدود_استجابة_ويب1 = {
        أقصى_سطر_حالة: 8192,
        أقصى_بايتات_رؤوس: 65536,
        أقصى_عدد_رؤوس: 128,
        أقصى_بايتات_جسم: 8388608,
        أقصى_بايتات_سطر_قطعة: 8192,
        أقصى_بايتات_رؤوس_لاحقة: 65536,
        أقصى_عدد_رؤوس_لاحقة: 128
    };
    أرجع الناتج;
}

عام عرف خطأ_ويب_عند(الصنف: صنف_خطأ_ويب, الإزاحة: غير_موقع): خطأ_ويب {
    دع الخطأ: خطأ_ويب = { الصنف: الصنف, الإزاحة: الإزاحة };
    أرجع الخطأ;
}

// English public aliases.
عام مرادف http_error_kind = صنف_خطأ_ويب;
عام مرادف http_error = خطأ_ويب;
عام مرادف http_limits = حدود_ويب;
عام مرادف default_http_limits = حدود_ويب_افتراضية;
عام مرادف http_error_kind.incomplete = صنف_خطأ_ويب.غير_مكتمل;
