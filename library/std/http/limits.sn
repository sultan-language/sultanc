عام مرادف http_error_kind.content_not_allowed = صنف_خطأ_ويب.محتوى_غير_مسموح;
عام مرادف http_error_kind.invalid_status = صنف_خطأ_ويب.حالة_غير_صالحة;
عام نوع http1_response_limits = حدود_استجابة_ويب1;
عام مرادف default_http1_response_limits = حدود_استجابة_ويب1_افتراضية;
