عام مرادف http_error_kind.body_too_large = صنف_خطأ_ويب.جسم_كبير;
عام مرادف http_error_kind.missing_host = صنف_خطأ_ويب.مضيف_مفقود;
عام مرادف http_error_kind.multiple_hosts = صنف_خطأ_ويب.مضيفون_متعددون;
