عام مرادف http_error_kind.unsupported_transfer_encoding = صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم;
عام مرادف http_error_kind.invalid_chunk_size = صنف_خطأ_ويب.حجم_قطعة_غير_صالح;
عام مرادف http_error_kind.chunk_line_too_long = صنف_خطأ_ويب.سطر_قطعة_طويل;
