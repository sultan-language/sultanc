استورد text.from_bytes;

عام نوع إصدار_ويب =
    | واحد_صفر
    | واحد_واحد
    | اثنان
    | ثلاثة
;

عام نوع صيغة_هدف_ويب =
    | أصل
    | مطلق
    | سلطة
    | نجمة
;

عام نوع رأس_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع طلب_ويب<B> = {
    الطريقة: نص,
    الهدف: نص,
    الإصدار: إصدار_ويب,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B
};

عام نوع استجابة_ويب<B> = {
    الإصدار: إصدار_ويب,
    الحالة: طبيعي,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B
};

عام نوع طلب_ويب_مخزن = طلب_ويب<متجه ط8>;
عام نوع استجابة_ويب_مخزنة = استجابة_ويب<متجه ط8>;

عام نوع خدمة_ويب<S, B1, B2> = دالة(&S, &طلب_ويب<B1>): استجابة_ويب<B2>;

عام عرف انسخ_نص_ويب(القيمة: &نص): نص {
    أرجع انسخ_نص(القيمة);
}

عام عرف نص_ويب_من_مدى(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نص {
    دع المصدر: متجه ط8 = *البايتات;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما ((ف < النهاية) && (ف < (الطول(المصدر) مثل طبيعي))) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عام عرف بايتات_ويب_من_نص(القيمة: &نص): متجه ط8 {
    دع النص: نص = *القيمة;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        ألحق(الناتج, النص[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ألحق_نص_ويب(الناتج: &متغير متجه ط8, القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        ألحق(*الناتج, النص[ف]);
        ف := ف + 1;
    }
}

عام عرف مدى_بعد_فراغ_ويب(النص: &نص, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = البداية;
    طالما ((ف < النهاية) && ((القيمة[ف] == 0x20) || (القيمة[ف] == 0x09))) { ف := ف + 1; }
    أرجع ف;
}

عام عرف مدى_قبل_فراغ_ويب(النص: &نص, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع القيمة: نص = *النص;
    دع ف: متغير طبيعي = النهاية;
    طالما (ف > البداية) {
        دع السابق: طبيعي = ف - 1;
        لو ((القيمة[السابق] == 0x20) || (القيمة[السابق] == 0x09)) { ف := السابق; } وإلا { أرجع ف; };
    }
    أرجع ف;
}

// English public aliases.
عام مرادف http_version = إصدار_ويب;
عام مرادف http_target_form = صيغة_هدف_ويب;
عام مرادف http_header = رأس_ويب;
عام نوع http_request<B> = طلب_ويب<B>;
عام نوع http_response<B> = استجابة_ويب<B>;
عام مرادف buffered_http_request = طلب_ويب_مخزن;
عام مرادف buffered_http_response = استجابة_ويب_مخزنة;
عام نوع http_service<S, B1, B2> = خدمة_ويب<S, B1, B2>;
عام مرادف http_version.http_1_0 = إصدار_ويب.واحد_صفر;
عام مرادف http_version.http_1_1 = إصدار_ويب.واحد_واحد;
عام مرادف http_version.http_2 = إصدار_ويب.اثنان;
عام مرادف http_version.http_3 = إصدار_ويب.ثلاثة;
عام مرادف http_target_form.origin = صيغة_هدف_ويب.أصل;
عام مرادف http_target_form.absolute = صيغة_هدف_ويب.مطلق;
عام مرادف http_target_form.authority = صيغة_هدف_ويب.سلطة;
عام مرادف http_target_form.asterisk = صيغة_هدف_ويب.نجمة;
