استورد text.from_bytes;

عام نوع إصدار_ويب =
    | واحد_صفر
    | واحد_واحد
    | اثنان
    | ثلاثة
;

عام نوع صيغة_هدف_ويب =
    | أصل
    | مطلق
    | سلطة
    | نجمة
;

عام نوع رأس_ويب = {
    الاسم: نص,
    القيمة: نص
};

// العنوان_البعيد is the client's address as "ip:port" ("[ip]:port" for
// IPv6), as Go's Request.RemoteAddr: the std servers fill it from the
// accepted socket (Nahr item 15); it is empty for a request a program builds
// itself, such as a client request.
عام نوع طلب_ويب<B> = {
    الطريقة: نص,
    الهدف: نص,
    الإصدار: إصدار_ويب,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B,
    العنوان_البعيد: نص,
    // Per-request facts the server fills in (http.deadline); a record so
    // that later additions do not change request literals again.
    السياق: سياق_طلب_ويب
};

عام نوع سياق_طلب_ويب = {
    // Monotonic nanoseconds (time.time وقت_رتيب_نانو) by which the handler
    // should finish; 0 is no deadline.
    المهلة_النانوية: عدد
};
عام مرادف http_request_context = سياق_طلب_ويب;

عام عرف سياق_طلب_ويب_فارغ(): سياق_طلب_ويب {
    دع الناتج: سياق_طلب_ويب = { المهلة_النانوية: 0 };
    أرجع الناتج;
}
عام مرادف http_request_context_empty = سياق_طلب_ويب_فارغ;

عام نوع استجابة_ويب<B> = {
    الإصدار: إصدار_ويب,
    الحالة: طبيعي,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B
};

عام نوع طلب_ويب_مخزن = طلب_ويب<متجه ط8>;
عام نوع استجابة_ويب_مخزنة = استجابة_ويب<متجه ط8>;

عام نوع خدمة_ويب<S, B1, B2> = دالة(&S, &طلب_ويب<B1>): استجابة_ويب<B2>;

عام عرف انسخ_نص_ويب(القيمة: &نص): نص {
    أرجع انسخ_نص(القيمة);
}

// One block copy of the clamped range, handed over as text (no second copy).
عام عرف نص_ويب_من_مدى(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع الحد: متغير طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (النهاية < الحد) { الحد := النهاية; };
    إذا (البداية < الحد) { ألحق_من(الناتج, البايتات, البداية, الحد - البداية); };
    أرجع الناتج مثل نص;
}

عام عرف بايتات_ويب_من_نص(القيمة: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, الطول(*القيمة) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ألحق_نص_ويب(الناتج: &متغير متجه ط8, القيمة: &نص): فراغ {
    احجز_سعة(*الناتج, الطول(*القيمة) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        ألحق(*الناتج, (*القيمة)[ف]);
        ف := ف + 1;
    }
}

عام عرف مدى_بعد_فراغ_ويب(النص: &نص, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع ف: متغير طبيعي = البداية;
    طالما ((ف < النهاية) && (((*النص)[ف] == 0x20) || ((*النص)[ف] == 0x09))) { ف := ف + 1; }
    أرجع ف;
}

عام عرف مدى_قبل_فراغ_ويب(النص: &نص, البداية: طبيعي, النهاية: طبيعي): طبيعي {
    دع ف: متغير طبيعي = النهاية;
    طالما (ف > البداية) {
        دع السابق: طبيعي = ف - 1;
        إذا (((*النص)[السابق] == 0x20) || ((*النص)[السابق] == 0x09)) { ف := السابق; } وإلا { أرجع ف; };
    }
    أرجع ف;
}

// English public aliases.
عام مرادف http_version = إصدار_ويب;
عام مرادف http_target_form = صيغة_هدف_ويب;
عام مرادف http_header = رأس_ويب;
عام نوع http_request<B> = طلب_ويب<B>;
عام نوع http_response<B> = استجابة_ويب<B>;
عام مرادف buffered_http_request = طلب_ويب_مخزن;
عام مرادف buffered_http_response = استجابة_ويب_مخزنة;
عام نوع http_service<S, B1, B2> = خدمة_ويب<S, B1, B2>;
عام مرادف http_version.http_1_0 = إصدار_ويب.واحد_صفر;
عام مرادف http_version.http_1_1 = إصدار_ويب.واحد_واحد;
عام مرادف http_version.http_2 = إصدار_ويب.اثنان;
عام مرادف http_version.http_3 = إصدار_ويب.ثلاثة;
عام مرادف http_target_form.origin = صيغة_هدف_ويب.أصل;
عام مرادف http_target_form.absolute = صيغة_هدف_ويب.مطلق;
عام مرادف http_target_form.authority = صيغة_هدف_ويب.سلطة;
عام مرادف http_target_form.asterisk = صيغة_هدف_ويب.نجمة;
