استورد text.compare;
استورد text.from_bytes;
استورد text.number;
استورد text.substring;
استورد text.transform;
استورد http.model;
استورد http.headers;

عام نوع زوج_كعكة_ويب = {
    الاسم: نص,
    القيمة: نص
};

عرف محرف_قيمة_كعكة_ويب_صالح(ب: ط8): منطقي {
    أرجع (ب == 0x21) || ((ب >= 0x23) && (ب <= 0x2B)) || ((ب >= 0x2D) && (ب <= 0x3A)) || ((ب >= 0x3C) && (ب <= 0x5B)) || ((ب >= 0x5D) && (ب <= 0x7E));
}

عرف قيمة_كعكة_ويب_صالحة(القيمة: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) { إذا (!محرف_قيمة_كعكة_ويب_صالح((*القيمة)[ف])) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف فك_قيمة_كعكة_ويب(القيمة: &نص): اختياري نص {
    دع العدد: طبيعي = الطول((*القيمة)) مثل طبيعي;
    إذا ((العدد >= 2) && ((*القيمة)[0] == 0x22)) {
        دع الأخير: طبيعي = العدد - 1;
        إذا ((*القيمة)[الأخير] != 0x22) { أرجع اختياري.لا_شيء(); };
        دع البايتات: متجه ط8 = بايتات_ويب_من_نص(القيمة);
        دع الداخل: نص = نص_ويب_من_مدى(&البايتات, 1, الأخير);
        إذا (!قيمة_كعكة_ويب_صالحة(&الداخل)) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الداخل);
    };
    إذا (!قيمة_كعكة_ويب_صالحة(القيمة)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(انسخ_نص_ويب(القيمة));
}

عرف قيمة_خاصية_كعكة_ويب_صالحة(القيمة: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا ((ب == 0x3B) || (ب == 0x0D) || (ب == 0x0A) || (ب == 0x00) || (ب < 0x20) || (ب == 0x7F)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف حلل_كعكات_ويب(الرؤوس: &متجه رأس_ويب): متجه زوج_كعكة_ويب {
    دع الاسم_الرأس: نص = «cookie»;
    دع قيم_الرأس: متجه نص = قيم_رأس_ويب(الرؤوس, &الاسم_الرأس);
    دع الناتج: متغير متجه زوج_كعكة_ويب = [];
    دع ه: متغير طبيعي = 0;
    طالما (ه < (الطول(قيم_الرأس) مثل طبيعي)) {
        دع النص: نص = انسخ_نص_ويب(&قيم_الرأس[ه]);
        دع بايتات_النص: متجه ط8 = بايتات_ويب_من_نص(&النص);
        دع العدد: طبيعي = الطول(النص) مثل طبيعي;
        دع البداية: متغير طبيعي = 0;
        طالما (البداية < العدد) {
            دع النهاية: متغير طبيعي = البداية;
            طالما ((النهاية < العدد) && (النص[النهاية] != 0x3B)) { النهاية := النهاية + 1; }
            دع أ: طبيعي = مدى_بعد_فراغ_ويب(&النص, البداية, النهاية);
            دع ب: طبيعي = مدى_قبل_فراغ_ويب(&النص, أ, النهاية);
            دع مساواة: متغير طبيعي = أ;
            طالما ((مساواة < ب) && (النص[مساواة] != 0x3D)) { مساواة := مساواة + 1; }
            إذا ((مساواة > أ) && (مساواة < ب)) {
                دع اسم_خام: نص = نص_ويب_من_مدى(&بايتات_النص, أ, مساواة);
                دع بداية_القيمة: طبيعي = مساواة + 1;
                دع قيمة_خام: نص = نص_ويب_من_مدى(&بايتات_النص, بداية_القيمة, ب);
                إذا (طريقة_ويب_صالحة(&اسم_خام)) {
                    طابق فك_قيمة_كعكة_ويب(&قيمة_خام) مع
                    | اختياري.موجود(قيمة_مفكوكة) -> { دع الزوج: زوج_كعكة_ويب = { الاسم: اسم_خام, القيمة: قيمة_مفكوكة }; ألحق(الناتج, الزوج); }
                    | اختياري.لا_شيء -> { };
                };
            };
            إذا (النهاية >= العدد) { البداية := العدد; } وإلا { البداية := النهاية + 1; };
        }
        ه := ه + 1;
    }
    أرجع الناتج;
}

عام عرف كعكات_طلب_ويب(الطلب: &طلب_ويب_مخزن): متجه زوج_كعكة_ويب {
    أرجع حلل_كعكات_ويب(&(*الطلب).الرؤوس);
}

عام عرف أول_كعكة_ويب(الكعكات: &متجه زوج_كعكة_ويب, الاسم: &نص): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكعكات)) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الكعكات)[ف].الاسم, الاسم)) { أرجع اختياري.موجود(انسخ_نص_ويب(&(*الكعكات)[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام نوع سياسة_نفس_موقع_كعكة_ويب =
    | غير_محدد
    | صارم
    | متساهل
    | لا_شيء
;

عام عرف ابن_رأس_تعيين_كعكة_ويب(
    الاسم: &نص,
    القيمة: &نص,
    المسار: &نص,
    المجال: &نص,
    لديه_عمر_أقصى: منطقي,
    العمر_الأقصى_ثوان: عدد,
    آمنة: منطقي,
    http_فقط: منطقي,
    نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب
): اختياري نص {
    إذا (!طريقة_ويب_صالحة(الاسم) || !قيمة_كعكة_ويب_صالحة(القيمة)) { أرجع اختياري.لا_شيء(); };
    إذا (((الطول(*المسار) مثل طبيعي) > 0) && !قيمة_خاصية_كعكة_ويب_صالحة(المسار)) { أرجع اختياري.لا_شيء(); };
    إذا (((الطول(*المجال) مثل طبيعي) > 0) && !قيمة_خاصية_كعكة_ويب_صالحة(المجال)) { أرجع اختياري.لا_شيء(); };
    دع البايتات: متغير متجه ط8 = [];
    ألحق_نص_ويب(&متغير البايتات, الاسم);
    دع يساوي: نص = «=»; ألحق_نص_ويب(&متغير البايتات, &يساوي);
    ألحق_نص_ويب(&متغير البايتات, القيمة);
    إذا ((الطول(*المسار) مثل طبيعي) > 0) { دع س: نص = «; Path=»; ألحق_نص_ويب(&متغير البايتات, &س); ألحق_نص_ويب(&متغير البايتات, المسار); };
    إذا ((الطول(*المجال) مثل طبيعي) > 0) { دع س: نص = «; Domain=»; ألحق_نص_ويب(&متغير البايتات, &س); ألحق_نص_ويب(&متغير البايتات, المجال); };
    إذا (لديه_عمر_أقصى) { دع س: نص = «; Max-Age=»; ألحق_نص_ويب(&متغير البايتات, &س); دع رقم: نص = عدد_إلى_نص(العمر_الأقصى_ثوان); ألحق_نص_ويب(&متغير البايتات, &رقم); };
    إذا (آمنة) { دع س: نص = «; Secure»; ألحق_نص_ويب(&متغير البايتات, &س); };
    إذا (http_فقط) { دع س: نص = «; HttpOnly»; ألحق_نص_ويب(&متغير البايتات, &س); };
    طابق نفس_الموقع مع
    | سياسة_نفس_موقع_كعكة_ويب.صارم -> { دع س: نص = «; SameSite=Strict»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | سياسة_نفس_موقع_كعكة_ويب.متساهل -> { دع س: نص = «; SameSite=Lax»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | سياسة_نفس_موقع_كعكة_ويب.لا_شيء -> { دع س: نص = «; SameSite=None»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | _ -> { };
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}

عام عرف أضف_كعكة_استجابة_ويب(
    الاستجابة: &متغير استجابة_ويب_مخزنة,
    الاسم: &نص,
    القيمة: &نص,
    المسار: &نص,
    المجال: &نص,
    لديه_عمر_أقصى: منطقي,
    العمر_الأقصى_ثوان: عدد,
    آمنة: منطقي,
    http_فقط: منطقي,
    نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب
): منطقي {
    طابق ابن_رأس_تعيين_كعكة_ويب(الاسم, القيمة, المسار, المجال, لديه_عمر_أقصى, العمر_الأقصى_ثوان, آمنة, http_فقط, نفس_الموقع) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(الرأس) -> {
        دع اسم_الرأس: نص = «set-cookie»;
        إذا (!أضف_رأس_ويب(&متغير (*الاستجابة).الرؤوس, &اسم_الرأس, &الرأس)) { أرجع خطأ; };
        أرجع صواب;
    };
}


عام عرف اسم_كعكة_ويب(القيمة: &زوج_كعكة_ويب): نص { أرجع انسخ_نص_ويب(&(*القيمة).الاسم); }
عام عرف قيمة_كعكة_ويب(القيمة: &زوج_كعكة_ويب): نص { أرجع انسخ_نص_ويب(&(*القيمة).القيمة); }

عام عرف ابن_رأس_تعيين_كعكة_ويب_بسيط(الاسم: &نص, القيمة: &نص): اختياري نص {
    دع المسار: نص = «»;
    دع المجال: نص = «»;
    أرجع ابن_رأس_تعيين_كعكة_ويب(الاسم, القيمة, &المسار, &المجال, خطأ, 0, خطأ, خطأ, سياسة_نفس_موقع_كعكة_ويب.غير_محدد());
}

عام عرف أضف_كعكة_استجابة_ويب_بسيطة(الاستجابة: &متغير استجابة_ويب_مخزنة, الاسم: &نص, القيمة: &نص): منطقي {
    دع المسار: نص = «»;
    دع المجال: نص = «»;
    أرجع أضف_كعكة_استجابة_ويب(الاستجابة, الاسم, القيمة, &المسار, &المجال, خطأ, 0, خطأ, خطأ, سياسة_نفس_موقع_كعكة_ويب.غير_محدد());
}

// English public aliases.
عام مرادف http_cookie = زوج_كعكة_ويب;
عام مرادف http_same_site = سياسة_نفس_موقع_كعكة_ويب;
عام مرادف parse_http_cookies = حلل_كعكات_ويب;
عام مرادف http_request_cookies = كعكات_طلب_ويب;
عام مرادف http_cookie_first = أول_كعكة_ويب;
عام مرادف http_cookie_name = اسم_كعكة_ويب;
عام مرادف http_cookie_value = قيمة_كعكة_ويب;
عام مرادف build_basic_set_cookie = ابن_رأس_تعيين_كعكة_ويب_بسيط;
عام مرادف http_response_add_basic_cookie = أضف_كعكة_استجابة_ويب_بسيطة;
عام مرادف build_set_cookie = ابن_رأس_تعيين_كعكة_ويب;
عام مرادف http_response_add_cookie = أضف_كعكة_استجابة_ويب;
عام مرادف http_same_site.unspecified = سياسة_نفس_موقع_كعكة_ويب.غير_محدد;
عام مرادف http_same_site.strict = سياسة_نفس_موقع_كعكة_ويب.صارم;
عام مرادف http_same_site.lax = سياسة_نفس_موقع_كعكة_ويب.متساهل;
عام مرادف http_same_site.none = سياسة_نفس_موقع_كعكة_ويب.لا_شيء;
