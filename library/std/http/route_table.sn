// Route tables built at compile time (Nahr item 11), as matchit and
// httprouter build their radix trees, but before the program runs: the
// patterns go through ابن_جدول_مسارات inside `comptime { ... }`, and the
// program holds only the encoded table, a vector of integers. Matching
// walks it segment by segment without allocating: a captured parameter is
// a byte range of the path.
//
// Patterns: `/users/{id}/posts` — a literal segment matches itself, `{name}`
// one non-empty segment, `{*name}` (last) the rest of the path. A literal
// segment wins over a parameter at the same place, and a parameter over a
// rest capture; a failed literal branch backtracks to the parameter.
//
//   let table: vector int = comptime { build_route_table(["/", "/users/{id}", "/files/{*path}"]) };
//   let captures: mutable vector int = [];
//   match match_route_table(&table, &"/users/42", &mutable captures) with
//   | option.some(route) -> { ... route 1, captures [7, 2] = "42" ... }
//
// Fixed responses: بايتات_استجابة_ثابتة_ويب1 serializes a response head
// and body at compile time (no Date: the server adds it per response).
استورد text.from_bytes;
استورد text.compare;

// ---- Encoding ----
// A node at offset o: [route at its end or -1, parameter child offset or
// -1, route of a rest capture or -1, static children n], then n entries
// [segment length, bytes..., child offset].

نوع عقدة_بناء_مسار = {
    النهاية: عدد,
    المعامل: عدد,
    الذيل: عدد,
    الثابتة: متجه نص,
    أبناء_ثابتة: متجه عدد
};

عرف عقدة_بناء_جديدة(): عقدة_بناء_مسار {
    دع ث: متجه نص = [];
    دع أ: متجه عدد = [];
    دع الناتج: عقدة_بناء_مسار = { النهاية: -1, المعامل: -1, الذيل: -1, الثابتة: ث, أبناء_ثابتة: أ };
    أرجع الناتج;
}

عرف مقاطع_مسار(المسار: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الحالي: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*المسار)[ف] == 0x2F) {
            إذا ((الطول(الحالي) مثل طبيعي) > 0) {
                دع المقطع: متغير متجه ط8 = [];
                بدّل(المقطع, الحالي);
                ألحق(الناتج, المقطع مثل نص);
            };
        } وإلا { ألحق(الحالي, (*المسار)[ف]); };
        ف := ف + 1;
    }
    إذا ((الطول(الحالي) مثل طبيعي) > 0) { ألحق(الناتج, الحالي مثل نص); };
    أرجع الناتج;
}

عرف نوع_مقطع(المقطع: &نص): عدد {
    دع العدد: طبيعي = الطول(*المقطع) مثل طبيعي;
    إذا (العدد >= 2 && (*المقطع)[0] == 0x7B && (*المقطع)[العدد - 1] == 0x7D) {
        إذا (العدد >= 3 && (*المقطع)[1] == 0x2A) { أرجع 2; };
        أرجع 1;
    };
    أرجع 0;
}

// Builds the encoded table of the patterns; route i is patterns[i].
عام عرف ابن_جدول_مسارات(الأنماط: متجه نص): متجه عدد {
    دع العقد: متغير متجه عقدة_بناء_مسار = [];
    ألحق(العقد, عقدة_بناء_جديدة());
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(الأنماط) مثل طبيعي)) {
        دع المقاطع: متجه نص = مقاطع_مسار(&الأنماط[م]);
        دع العقدة: متغير طبيعي = 0;
        دع ذيل: متغير منطقي = خطأ;
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(المقاطع) مثل طبيعي) && !ذيل) {
            دع النوع: عدد = نوع_مقطع(&المقاطع[ك]);
            إذا (النوع == 2) {
                العقد[العقدة].الذيل := م مثل عدد;
                ذيل := صواب;
            } وإلا إذا (النوع == 1) {
                إذا (العقد[العقدة].المعامل < 0) {
                    ألحق(العقد, عقدة_بناء_جديدة());
                    العقد[العقدة].المعامل := ((الطول(العقد) مثل طبيعي) - 1) مثل عدد;
                };
                العقدة := العقد[العقدة].المعامل مثل طبيعي;
            } وإلا {
                دع وجد: متغير عدد = -1;
                دع ث: متغير طبيعي = 0;
                طالما (ث < (الطول(العقد[العقدة].الثابتة) مثل طبيعي)) {
                    إذا (نصان_متساويان(&العقد[العقدة].الثابتة[ث], &المقاطع[ك])) { وجد := العقد[العقدة].أبناء_ثابتة[ث]; };
                    ث := ث + 1;
                }
                إذا (وجد < 0) {
                    ألحق(العقد, عقدة_بناء_جديدة());
                    وجد := ((الطول(العقد) مثل طبيعي) - 1) مثل عدد;
                    ألحق(العقد[العقدة].الثابتة, انسخ_نص(&المقاطع[ك]));
                    ألحق(العقد[العقدة].أبناء_ثابتة, وجد);
                };
                العقدة := وجد مثل طبيعي;
            };
            ك := ك + 1;
        }
        إذا (!ذيل) { العقد[العقدة].النهاية := م مثل عدد; };
        م := م + 1;
    }
    // Offsets: each node's size is known, so lay them out in order.
    دع الإزاحات: متغير متجه عدد = [];
    دع الموضع: متغير عدد = 0;
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(العقد) مثل طبيعي)) {
        ألحق(الإزاحات, الموضع);
        الموضع := الموضع + 4;
        دع ث: متغير طبيعي = 0;
        طالما (ث < (الطول(العقد[ع].الثابتة) مثل طبيعي)) {
            الموضع := الموضع + 2 + (الطول(العقد[ع].الثابتة[ث]) مثل عدد);
            ث := ث + 1;
        }
        ع := ع + 1;
    }
    دع الناتج: متغير متجه عدد = [];
    ع := 0;
    طالما (ع < (الطول(العقد) مثل طبيعي)) {
        ألحق(الناتج, العقد[ع].النهاية);
        إذا (العقد[ع].المعامل < 0) { ألحق(الناتج, -1); } وإلا { ألحق(الناتج, الإزاحات[العقد[ع].المعامل مثل طبيعي]); };
        ألحق(الناتج, العقد[ع].الذيل);
        ألحق(الناتج, الطول(العقد[ع].الثابتة) مثل عدد);
        دع ث: متغير طبيعي = 0;
        طالما (ث < (الطول(العقد[ع].الثابتة) مثل طبيعي)) {
            دع المقطع: &نص = &العقد[ع].الثابتة[ث];
            ألحق(الناتج, الطول(*المقطع) مثل عدد);
            دع ب: متغير طبيعي = 0;
            طالما (ب < (الطول(*المقطع) مثل طبيعي)) { ألحق(الناتج, (*المقطع)[ب] مثل عدد); ب := ب + 1; }
            ألحق(الناتج, الإزاحات[العقد[ع].أبناء_ثابتة[ث] مثل طبيعي]);
            ث := ث + 1;
        }
        ع := ع + 1;
    }
    أرجع الناتج;
}
عام مرادف build_route_table = ابن_جدول_مسارات;

// ---- Matching ----

// The next segment of المسار at or after الموضع (skipping «/»): its start
// and end, or none at the end of the path.
عرف المقطع_التالي(المسار: &نص, الموضع: طبيعي, البداية: &متغير طبيعي, النهاية: &متغير طبيعي): منطقي {
    دع العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    دع ف: متغير طبيعي = الموضع;
    طالما (ف < العدد && (*المسار)[ف] == 0x2F) { ف := ف + 1; }
    إذا (ف >= العدد) { أرجع خطأ; };
    *البداية := ف;
    طالما (ف < العدد && (*المسار)[ف] != 0x2F) { ف := ف + 1; }
    *النهاية := ف;
    أرجع صواب;
}

عرف طابق_من_عقدة(الجدول: &متجه عدد, العقدة: طبيعي, المسار: &نص, الموضع: طبيعي, الالتقاطات: &متغير متجه عدد): عدد {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = 0;
    إذا (!المقطع_التالي(المسار, الموضع, &متغير البداية, &متغير النهاية)) {
        أرجع (*الجدول)[العقدة];
    };
    دع الطول_المقطع: عدد = (النهاية - البداية) مثل عدد;
    // Static children.
    دع العدد: طبيعي = (*الجدول)[العقدة + 3] مثل طبيعي;
    دع م: متغير طبيعي = العقدة + 4;
    دع ث: متغير طبيعي = 0;
    طالما (ث < العدد) {
        دع طول_الثابت: عدد = (*الجدول)[م];
        إذا (طول_الثابت == الطول_المقطع) {
            دع يطابق: متغير منطقي = صواب;
            دع ب: متغير طبيعي = 0;
            طالما (يطابق && ب < (طول_الثابت مثل طبيعي)) {
                إذا ((*الجدول)[م + 1 + ب] != ((*المسار)[البداية + ب] مثل عدد)) { يطابق := خطأ; };
                ب := ب + 1;
            }
            إذا (يطابق) {
                دع الابن: طبيعي = (*الجدول)[م + 1 + (طول_الثابت مثل طبيعي)] مثل طبيعي;
                دع المحفوظ: طبيعي = الطول(*الالتقاطات) مثل طبيعي;
                دع الناتج: عدد = طابق_من_عقدة(الجدول, الابن, المسار, النهاية, الالتقاطات);
                إذا (الناتج >= 0) { أرجع الناتج; };
                اقتطع(*الالتقاطات, المحفوظ);
            };
        };
        م := م + 2 + (طول_الثابت مثل طبيعي);
        ث := ث + 1;
    }
    // Parameter.
    دع المعامل: عدد = (*الجدول)[العقدة + 1];
    إذا (المعامل >= 0) {
        دع المحفوظ: طبيعي = الطول(*الالتقاطات) مثل طبيعي;
        ألحق(*الالتقاطات, البداية مثل عدد);
        ألحق(*الالتقاطات, الطول_المقطع);
        دع الناتج: عدد = طابق_من_عقدة(الجدول, المعامل مثل طبيعي, المسار, النهاية, الالتقاطات);
        إذا (الناتج >= 0) { أرجع الناتج; };
        اقتطع(*الالتقاطات, المحفوظ);
    };
    // Rest of the path.
    دع الذيل: عدد = (*الجدول)[العقدة + 2];
    إذا (الذيل >= 0) {
        ألحق(*الالتقاطات, البداية مثل عدد);
        ألحق(*الالتقاطات, (الطول(*المسار) مثل عدد) - (البداية مثل عدد));
        أرجع الذيل;
    };
    أرجع -1;
}

// The route index المسار matches (the query string excluded by the caller)
// and its captures as (start, length) pairs in pattern order, or none.
عام عرف طابق_جدول_مسارات(الجدول: &متجه عدد, المسار: &نص, الالتقاطات: &متغير متجه عدد): اختياري طبيعي {
    اقتطع(*الالتقاطات, 0);
    إذا ((الطول(*الجدول) مثل طبيعي) < 4) { أرجع اختياري.لا_شيء(); };
    دع الناتج: عدد = طابق_من_عقدة(الجدول, 0, المسار, 0, الالتقاطات);
    إذا (الناتج < 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الناتج مثل طبيعي);
}
عام مرادف match_route_table = طابق_جدول_مسارات;

// ---- Fixed responses ----

عرف ألحق_نص_ثابت(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عرف ألحق_عدد_ثابت(الناتج: &متغير متجه ط8, العدد: طبيعي): فراغ {
    إذا (العدد >= 10) { ألحق_عدد_ثابت(الناتج, العدد / 10); };
    ألحق(*الناتج, (0x30 + (العدد % 10)) مثل ط8);
}

// The status line, Content-Type and Content-Length of a fixed response and
// its body, as HTTP/1.1 bytes ending in the header block's last line (the
// caller appends Date, connection headers and the blank line).
عام عرف بايتات_رأس_ثابت_ويب1(الحالة: طبيعي, السبب: نص, نوع_المحتوى: نص, طول_الجسم: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_ثابت(&متغير الناتج, &«HTTP/1.1 »);
    ألحق_عدد_ثابت(&متغير الناتج, الحالة);
    ألحق(الناتج, 0x20 مثل ط8);
    ألحق_نص_ثابت(&متغير الناتج, &السبب);
    ألحق_نص_ثابت(&متغير الناتج, &"\r\ncontent-type: ");
    ألحق_نص_ثابت(&متغير الناتج, &نوع_المحتوى);
    ألحق_نص_ثابت(&متغير الناتج, &"\r\ncontent-length: ");
    ألحق_عدد_ثابت(&متغير الناتج, طول_الجسم);
    ألحق_نص_ثابت(&متغير الناتج, &"\r\n");
    أرجع الناتج;
}
عام مرادف fixed_http1_head_bytes = بايتات_رأس_ثابت_ويب1;

// A whole fixed response (head, a blank line, body) without Date, for a
// server that sends prebuilt bytes as they are.
عام عرف بايتات_استجابة_ثابتة_ويب1(الحالة: طبيعي, السبب: نص, نوع_المحتوى: نص, الجسم: نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = بايتات_رأس_ثابت_ويب1(الحالة, السبب, نوع_المحتوى, الطول(الجسم) مثل طبيعي);
    ألحق_نص_ثابت(&متغير الناتج, &"\r\n");
    ألحق_نص_ثابت(&متغير الناتج, &الجسم);
    أرجع الناتج;
}
عام مرادف fixed_http1_response_bytes = بايتات_استجابة_ثابتة_ويب1;
