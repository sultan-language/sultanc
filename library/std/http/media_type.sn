استورد chars.ascii;
استورد text.compare;
استورد text.from_bytes;
استورد text.substring;
استورد http.model;
استورد http.headers;

عام نوع معامل_نوع_وسائط_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع نوع_وسائط_ويب = {
    الفئة: نص,
    النوع_الفرعي: نص,
    المعلمات: متجه معامل_نوع_وسائط_ويب
};

عام نوع صنف_خطأ_نوع_وسائط_ويب =
    | صيغة_غير_صالحة
    | رمز_غير_صالح
    | اقتباس_غير_مغلق
;

عام عرف نص_ويب_صغير(القيمة: &نص): نص {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        ألحق(البايتات, إلى_صغير_أسكي((*القيمة)[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف رمز_نوع_وسائط_ويب_صالح(النص: &نص): منطقي {
    إذا ((الطول((*النص)) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النص)) مثل طبيعي)) {
        إذا (!حرف_رمز_ويب((*النص)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف فك_قيمة_معامل_نوع_وسائط_ويب(النص: &نص): نتيجة نص, صنف_خطأ_نوع_وسائط_ويب {
    دع العدد: طبيعي = الطول((*النص)) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
    إذا ((*النص)[0] != 0x22) {
        إذا (!رمز_نوع_وسائط_ويب_صالح(النص)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
        أرجع نتيجة.نجح(انسخ_نص_ويب(النص));
    };
    إذا (العدد < 2) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
    دع آخر: طبيعي = العدد - 1;
    إذا ((*النص)[آخر] != 0x22) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 1;
    دع النهاية: طبيعي = العدد - 1;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x5C) {
            دع التالي: طبيعي = ف + 1;
            إذا (التالي >= النهاية) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
            دع ب2: ط8 = (*النص)[التالي];
            إذا ((ب2 == 0x0D) || (ب2 == 0x0A)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ألحق(الناتج, ب2);
            ف := ف + 2;
        } وإلا {
            إذا ((ب == 0x0D) || (ب == 0x0A) || (ب == 0x00)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ألحق(الناتج, ب);
            ف := ف + 1;
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}

عام عرف حلل_نوع_وسائط_ويب(النص: &نص): نتيجة نوع_وسائط_ويب, صنف_خطأ_نوع_وسائط_ويب {
    دع العدد: طبيعي = الطول((*النص)) مثل طبيعي;
    دع البداية: طبيعي = مدى_بعد_فراغ_ويب(النص, 0, العدد);
    دع نهاية_القيمة: طبيعي = مدى_قبل_فراغ_ويب(النص, البداية, العدد);
    دع بايتات_القيمة: متجه ط8 = بايتات_ويب_من_نص(النص);
    دع فاصلة_منقوطة: متغير طبيعي = نهاية_القيمة;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < نهاية_القيمة) {
        إذا ((*النص)[ف] == 0x3B) { فاصلة_منقوطة := ف; ف := نهاية_القيمة; } وإلا { ف := ف + 1; };
    }
    دع شرطة: متغير طبيعي = فاصلة_منقوطة;
    ف := البداية;
    طالما (ف < فاصلة_منقوطة) {
        إذا ((*النص)[ف] == 0x2F) { شرطة := ف; ف := فاصلة_منقوطة; } وإلا { ف := ف + 1; };
    }
    إذا ((شرطة == البداية) || (شرطة >= فاصلة_منقوطة)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
    دع نهاية_الفئة: طبيعي = مدى_قبل_فراغ_ويب(النص, البداية, شرطة);
    دع بداية_الفرعي: طبيعي = مدى_بعد_فراغ_ويب(النص, شرطة + 1, فاصلة_منقوطة);
    دع نهاية_الفرعي: طبيعي = مدى_قبل_فراغ_ويب(النص, بداية_الفرعي, فاصلة_منقوطة);
    دع الفئة_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, البداية, نهاية_الفئة);
    دع الفرعي_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_الفرعي, نهاية_الفرعي);
    إذا (!رمز_نوع_وسائط_ويب_صالح(&الفئة_الخام) || !رمز_نوع_وسائط_ويب_صالح(&الفرعي_الخام)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
    دع الفئة: نص = نص_ويب_صغير(&الفئة_الخام);
    دع الفرعي: نص = نص_ويب_صغير(&الفرعي_الخام);
    دع المعلمات: متغير متجه معامل_نوع_وسائط_ويب = [];
    ف := فاصلة_منقوطة;
    طالما (ف < نهاية_القيمة) {
        إذا ((*النص)[ف] == 0x3B) { ف := ف + 1; };
        ف := مدى_بعد_فراغ_ويب(النص, ف, نهاية_القيمة);
        إذا (ف >= نهاية_القيمة) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
        دع بداية_الاسم: طبيعي = ف;
        طالما ((ف < نهاية_القيمة) && ((*النص)[ف] != 0x3D) && ((*النص)[ف] != 0x3B)) { ف := ف + 1; }
        إذا ((ف >= نهاية_القيمة) || ((*النص)[ف] != 0x3D)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
        دع نهاية_الاسم: طبيعي = مدى_قبل_فراغ_ويب(النص, بداية_الاسم, ف);
        دع الاسم_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_الاسم, نهاية_الاسم);
        إذا (!رمز_نوع_وسائط_ويب_صالح(&الاسم_الخام)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
        دع الاسم: نص = نص_ويب_صغير(&الاسم_الخام);
        ف := ف + 1;
        ف := مدى_بعد_فراغ_ويب(النص, ف, نهاية_القيمة);
        دع بداية_القيمة: طبيعي = ف;
        دع نهاية_المعامل_الخام: متغير طبيعي = ف;
        إذا ((ف < نهاية_القيمة) && ((*النص)[ف] == 0x22)) {
            ف := ف + 1;
            دع هروب: متغير منطقي = خطأ;
            دع أغلق: متغير منطقي = خطأ;
            طالما ((ف < نهاية_القيمة) && !أغلق) {
                دع ب: ط8 = (*النص)[ف];
                إذا (هروب) { هروب := خطأ; ف := ف + 1; }
                وإلا إذا (ب == 0x5C) { هروب := صواب; ف := ف + 1; }
                وإلا إذا (ب == 0x22) { ف := ف + 1; نهاية_المعامل_الخام := ف; أغلق := صواب; }
                وإلا { ف := ف + 1; };
            }
            إذا (!أغلق) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
            دع بعد_القيمة: طبيعي = مدى_بعد_فراغ_ويب(النص, ف, نهاية_القيمة);
            إذا ((بعد_القيمة < نهاية_القيمة) && ((*النص)[بعد_القيمة] != 0x3B)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ف := بعد_القيمة;
        } وإلا {
            طالما ((ف < نهاية_القيمة) && ((*النص)[ف] != 0x3B)) { ف := ف + 1; }
            نهاية_المعامل_الخام := مدى_قبل_فراغ_ويب(النص, بداية_القيمة, ف);
        };
        دع قيمة_خام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_القيمة, نهاية_المعامل_الخام);
        دع قيمة_المعامل: متغير نص = «»;
        طابق فك_قيمة_معامل_نوع_وسائط_ويب(&قيمة_خام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة_مفكوكة) -> { قيمة_المعامل := قيمة_مفكوكة; };
        دع المعامل: معامل_نوع_وسائط_ويب = { الاسم: الاسم, القيمة: قيمة_المعامل };
        ألحق(المعلمات, المعامل);
        طالما ((ف < نهاية_القيمة) && ((*النص)[ف] != 0x3B)) { ف := ف + 1; }
    }
    دع الناتج: نوع_وسائط_ويب = { الفئة: الفئة, النوع_الفرعي: الفرعي, المعلمات: المعلمات };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف نوع_وسائط_ويب_يطابق(القيمة: &نوع_وسائط_ويب, الفئة: &نص, النوع_الفرعي: &نص): منطقي {
    دع أ: نص = نص_ويب_صغير(الفئة);
    دع ب: نص = نص_ويب_صغير(النوع_الفرعي);
    أرجع نصان_متساويان(&(*القيمة).الفئة, &أ) && نصان_متساويان(&(*القيمة).النوع_الفرعي, &ب);
}

عام عرف قيمة_معامل_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب, الاسم: &نص): اختياري نص {
    دع المطلوب: نص = نص_ويب_صغير(الاسم);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة).المعلمات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*القيمة).المعلمات[ف].الاسم, &المطلوب)) { أرجع اختياري.موجود(انسخ_نص_ويب(&(*القيمة).المعلمات[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}


عام عرف فئة_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب): نص { أرجع انسخ_نص_ويب(&(*القيمة).الفئة); }
عام عرف فرعي_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب): نص { أرجع انسخ_نص_ويب(&(*القيمة).النوع_الفرعي); }

// English public aliases.
عام مرادف http_media_type_parameter = معامل_نوع_وسائط_ويب;
عام مرادف http_media_type = نوع_وسائط_ويب;
عام مرادف http_media_type_error_kind = صنف_خطأ_نوع_وسائط_ويب;
عام مرادف parse_http_media_type = حلل_نوع_وسائط_ويب;
عام مرادف http_media_type_type = فئة_نوع_وسائط_ويب;
عام مرادف http_media_type_subtype = فرعي_نوع_وسائط_ويب;
عام مرادف http_media_type_matches = نوع_وسائط_ويب_يطابق;
عام مرادف http_media_type_parameter_value = قيمة_معامل_نوع_وسائط_ويب;
عام مرادف http_media_type_error_kind.invalid_syntax = صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة;
عام مرادف http_media_type_error_kind.invalid_token = صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح;
عام مرادف http_media_type_error_kind.unclosed_quote = صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق;
