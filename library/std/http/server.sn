استورد نصوص.من_بايتات;
استورد نصوص.مقارنة;
استورد دخ.كاتب;
استورد شبكة.خيارات;
استورد شبكة.عنوان_مقبس;
استورد شبكة.آيبي;
استورد شبكة.تي_سي_بي;
استورد ويب.نموذج;
استورد ويب.ترويسات;
استورد ويب.حدود;
استورد ويب.جسم;
استورد ويب.ويب1.محلل_الطلب;
استورد ويب.ويب1.كاتب_الاستجابة;
استورد ويب.ويب1.اتصال;
استورد ويب.ويب1.مشترك;
استورد نظام_التشغيل.أخطاء;
استورد نظام_التشغيل.ترجمة_الأخطاء;
استورد وقت.الوقت;
استورد تي_إل_إس.إعداد;
استورد تي_إل_إس.مجرى;
استورد ويب.ناقل;
استورد ويب.ويب2.إطار;
استورد ويب.ويب2.اتصال;
استورد ويب.ويب2.خادم;
استورد نظام_التشغيل.استطلاع;
استورد تزامن.مشترك;
استورد تزامن.قفل;
استورد تزامن.ذري;
استورد خيوط.خيط;
استورد ويب.إيقاف;
استورد ويب.تسليم;
استورد ويب.مهلة;
استورد غير_متزامن.وقت_التشغيل;
استورد غير_متزامن.شبكة;

// The slow-client limits are on by default; 0 turns one off.
// - مهلة_الرأس_بالمللي: from accepting the connection (or, on a keep-alive
//   connection, from the first byte of the next request) to the end of the
//   request head; also each read of a TLS handshake. Default 10 s.
// - مهلة_الجسم_بالمللي: the longest wait for more of a request body, and for
//   the client to take more of a response; also every read and write of an
//   HTTP/2 connection. Default 30 s.
// - مهلة_الخمول_بالمللي: how long a keep-alive connection may wait for its
//   next request. Default 5 s.
// - أقصى_الاتصالات: open connections at once; one more is answered 503 and
//   closed at once. Default 1024.
// A connection past a deadline is closed: with a 408 when part of a request
// was read, silently when it was idle.
عام نوع إعداد_خادم_ويب = {
    العنوان: نص,
    التراكم: عدد,
    الحدود: حدود_ويب,
    مهلة_الرأس_بالمللي: طبيعي,
    مهلة_الجسم_بالمللي: طبيعي,
    مهلة_الخمول_بالمللي: طبيعي,
    أقصى_الاتصالات: طبيعي,
    إعادة_استخدام_العنوان: منطقي
};

عام نوع خطأ_خادم_ويب =
    | عنوان_غير_صالح
    | شبكة بنوع عدد
    | بروتوكول بنوع خطأ_ويب
    | انتقال_بروتوكول_غير_مدعوم
    | ويب2 بنوع خطأ_ويب2
;

عام عرف إعداد_خادم_ويب_افتراضي(العنوان: &نص): إعداد_خادم_ويب {
    ليكن الإعداد: إعداد_خادم_ويب = {
        العنوان: انسخ_نص(العنوان),
        // A burst of connections waits in the kernel's queue rather than
        // losing its SYNs (the kernel caps it at its own limit).
        التراكم: 1024,
        الحدود: حدود_ويب_افتراضية(),
        مهلة_الرأس_بالمللي: 10000,
        مهلة_الجسم_بالمللي: 30000,
        مهلة_الخمول_بالمللي: 5000,
        أقصى_الاتصالات: 1024,
        إعادة_استخدام_العنوان: صواب
    };
    أرجع الإعداد;
}

عام عرف اضبط_مهلة_رأس_خادم_ويب(الإعداد: &متغير إعداد_خادم_ويب, المللي: طبيعي): فراغ {
    (*الإعداد).مهلة_الرأس_بالمللي := المللي;
}

عام عرف اضبط_مهلة_جسم_خادم_ويب(الإعداد: &متغير إعداد_خادم_ويب, المللي: طبيعي): فراغ {
    (*الإعداد).مهلة_الجسم_بالمللي := المللي;
}

عام عرف اضبط_مهلة_خمول_خادم_ويب(الإعداد: &متغير إعداد_خادم_ويب, المللي: طبيعي): فراغ {
    (*الإعداد).مهلة_الخمول_بالمللي := المللي;
}

عام عرف اضبط_أقصى_اتصالات_خادم_ويب(الإعداد: &متغير إعداد_خادم_ويب, العدد: طبيعي): فراغ {
    (*الإعداد).أقصى_الاتصالات := العدد;
}

// ---- Slow-client deadlines ----

// A connection's deadlines in nanoseconds (0: none), from its server's
// configuration.
نوع مهل_اتصال_ويب = {
    الرأس: عدد,
    الجسم: عدد,
    الخمول: عدد
};

عرف نانو_من_مللي_ويب(المللي: طبيعي): عدد {
    أرجع (المللي مثل عدد) * 1000000;
}

عرف مهل_من_إعداد_ويب(الإعداد: &إعداد_خادم_ويب): مهل_اتصال_ويب {
    ليكن المهل: مهل_اتصال_ويب = {
        الرأس: نانو_من_مللي_ويب((*الإعداد).مهلة_الرأس_بالمللي),
        الجسم: نانو_من_مللي_ويب((*الإعداد).مهلة_الجسم_بالمللي),
        الخمول: نانو_من_مللي_ويب((*الإعداد).مهلة_الخمول_بالمللي)
    };
    أرجع المهل;
}

// The defaults, for the functions that serve one connection without a
// configuration.
عرف مهل_افتراضية_ويب(): مهل_اتصال_ويب {
    ليكن العنوان: نص = «»;
    ليكن الإعداد: إعداد_خادم_ويب = إعداد_خادم_ويب_افتراضي(&العنوان);
    أرجع مهل_من_إعداد_ويب(&الإعداد);
}

عرف الآن_خادم_ويب(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(الآن) -> { أرجع الآن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// البداية + المدة, or 0 (no deadline) when المدة is 0.
عرف أضف_مهلة_ويب(البداية: عدد, المدة: عدد): عدد {
    إذا (المدة <= 0) { أرجع 0; };
    أرجع البداية + المدة;
}

// Nanoseconds as a socket timeout in milliseconds, rounded up; 0 (no
// timeout) for none.
عرف مللي_مقبس_ويب(النانو: عدد): طبيعي {
    إذا (النانو <= 0) { أرجع 0; };
    ليكن المللي: متغير عدد = (النانو + 999999) / 1000000;
    إذا (المللي > 2147483647) { المللي := 2147483647; };
    أرجع المللي مثل طبيعي;
}

// Scans the bytes of a request for the empty line that ends its head, from
// where the previous scan stopped (الموضع); leading empty lines are skipped.
عرف افحص_نهاية_رأس_ويب1(البايتات: &متجه ط8, الموضع: &متغير طبيعي): منطقي {
    ليكن ن: طبيعي = الطول(*البايتات) مثل طبيعي;
    ليكن ف: متغير طبيعي = *الموضع;
    إذا (ف == 0) {
        طالما (ف < ن && ((*البايتات)[ف] == 0x0D || (*البايتات)[ف] == 0x0A)) { ف := ف + 1; }
        إذا (ف == ن) { أرجع خطأ; };
    };
    طالما (ف < ن) {
        إذا ((*البايتات)[ف] == 0x0A) {
            إذا (ف + 1 >= ن) { *الموضع := ف; أرجع خطأ; };
            إذا ((*البايتات)[ف + 1] == 0x0A) { أرجع صواب; };
            إذا ((*البايتات)[ف + 1] == 0x0D) {
                إذا (ف + 2 >= ن) { *الموضع := ف; أرجع خطأ; };
                إذا ((*البايتات)[ف + 2] == 0x0A) { أرجع صواب; };
            };
        };
        ف := ف + 1;
    }
    *الموضع := ف;
    أرجع خطأ;
}

// Where an HTTP/1 connection is between reads: the start of the request head
// being read (0 before its first byte), whether its head is complete, whether
// the connection has answered a request and now waits idle for the next one,
// and the deadline of the current wait (0 none).
نوع حالة_مهلة_ويب1 = {
    بداية_الرأس: عدد,
    المهلة: عدد,
    موضع_الفحص: طبيعي,
    خدم_طلبا: منطقي,
    الرأس_مكتمل: منطقي,
    خامل: منطقي
};

// A connection accepted at الآن: its first request head is due within the
// header timeout.
عرف حالة_مهلة_جديدة_ويب1(المهل: &مهل_اتصال_ويب, الآن: عدد): حالة_مهلة_ويب1 {
    ليكن الناتج: حالة_مهلة_ويب1 = {
        بداية_الرأس: الآن,
        المهلة: أضف_مهلة_ويب(الآن, (*المهل).الرأس),
        موضع_الفحص: 0,
        خدم_طلبا: خطأ,
        الرأس_مكتمل: خطأ,
        خامل: خطأ
    };
    أرجع الناتج;
}

// A request left the decoder: the next one has not started.
عرف طلب_مأخوذ_مهلة_ويب1(الحالة: &متغير حالة_مهلة_ويب1): فراغ {
    (*الحالة).بداية_الرأس := 0;
    (*الحالة).موضع_الفحص := 0;
    (*الحالة).خدم_طلبا := صواب;
    (*الحالة).الرأس_مكتمل := خطأ;
    (*الحالة).خامل := خطأ;
}

// The deadline of the next wait for bytes, given the bytes read and not yet
// a request (المعلقة): an idle keep-alive connection waits at most the idle
// timeout from when it became idle; a request head is due within the header
// timeout from its start; a request body may pause at most the body timeout.
عرف مهلة_القراءة_التالية_ويب1(
    الحالة: &متغير حالة_مهلة_ويب1,
    المهل: &مهل_اتصال_ويب,
    المعلقة: &متجه ط8,
    الآن: عدد
): عدد {
    إذا ((الطول(*المعلقة) مثل طبيعي) == 0) {
        إذا ((*الحالة).خدم_طلبا) {
            إذا (!(*الحالة).خامل) {
                (*الحالة).خامل := صواب;
                (*الحالة).المهلة := أضف_مهلة_ويب(الآن, (*المهل).الخمول);
            };
            أرجع (*الحالة).المهلة;
        };
        (*الحالة).المهلة := أضف_مهلة_ويب((*الحالة).بداية_الرأس, (*المهل).الرأس);
        أرجع (*الحالة).المهلة;
    };
    (*الحالة).خامل := خطأ;
    إذا ((*الحالة).بداية_الرأس == 0) { (*الحالة).بداية_الرأس := الآن; };
    إذا (!(*الحالة).الرأس_مكتمل) {
        ليكن الموضع: متغير طبيعي = (*الحالة).موضع_الفحص;
        (*الحالة).الرأس_مكتمل := افحص_نهاية_رأس_ويب1(المعلقة, &متغير الموضع);
        (*الحالة).موضع_الفحص := الموضع;
    };
    إذا ((*الحالة).الرأس_مكتمل) {
        (*الحالة).المهلة := أضف_مهلة_ويب(الآن, (*المهل).الجسم);
    } وإلا {
        (*الحالة).المهلة := أضف_مهلة_ويب((*الحالة).بداية_الرأس, (*المهل).الرأس);
    };
    أرجع (*الحالة).المهلة;
}

// The answer to a request not read in time.
عرف بايتات_انتهاء_مهلة_طلب_خادم(): متجه ط8 {
    أرجع بايتات_من_نص("HTTP/1.1 408 Request Timeout\r\ncontent-type: text/plain; charset=utf-8\r\ncontent-length: 16\r\nconnection: close\r\n\r\nRequest Timeout\n");
}

// A connection over the server's limit: a short 503, written without
// waiting (best effort), then the socket is closed.
عرف ارفض_اتصالا_ممتلئا_ويب(التدفق: تدفق_تي_سي_بي): فراغ {
    ليكن البايتات: متجه ط8 = بايتات_من_نص("HTTP/1.1 503 Service Unavailable\r\ncontent-length: 0\r\nconnection: close\r\n\r\n");
    ليكن تجاهل_الحجب: نتيجة عدد, عدد = اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, صواب);
    ليكن تجاهل_الكتابة: نتيجة عدد, عدد = اكتب_تي_سي_بي(&التدفق, &البايتات, 0, الطول(البايتات) مثل عدد);
    ليكن تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
}

// A blocking connection's sockets: every send waits at most the body
// timeout, and a read the header timeout until a read sets its own (the TLS
// handshake's reads keep it).
عرف هيئ_مقبس_خادم_ويب(التدفق: &تدفق_تي_سي_بي, المهل: &مهل_اتصال_ويب): فراغ {
    ليكن تجاهل_الإرسال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(التدفق, خيار_مقبس.مهلة_إرسال(مللي_مقبس_ويب((*المهل).الجسم)));
    ليكن تجاهل_الاستقبال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(التدفق, خيار_مقبس.مهلة_استقبال(مللي_مقبس_ويب((*المهل).الرأس)));
}

// The send timeout of a transport that blocks (an async one bounds its
// writes itself).
عرف هيئ_ناقل_خادم_ويب(الناقل: &ناقل_ويب, المهل: &مهل_اتصال_ويب): فراغ {
    ليكن المللي: طبيعي = مللي_مقبس_ويب((*المهل).الجسم);
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> {
        ليكن تجاهل: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_إرسال(المللي));
    }
    | ناقل_ويب.تي_إل_إس(الآمن) -> {
        ليكن تجاهل: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(واصف_تدفق_تي_إل_إس(&الآمن), خيار_مقبس.مهلة_إرسال(المللي));
    }
    | _ -> { };
}

// Before a hand-over (http.handover) the callback owns the connection's
// waits: the socket timeouts this server set are cleared.
عرف امسح_مهل_ناقل_ويب(الناقل: &ناقل_ويب): فراغ {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> {
        ليكن تجاهل_الاستقبال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_استقبال(0));
        ليكن تجاهل_الإرسال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_إرسال(0));
    }
    | ناقل_ويب.تي_إل_إس(الآمن) -> {
        ليكن الواصف: عدد = واصف_تدفق_تي_إل_إس(&الآمن);
        ليكن تجاهل_الاستقبال: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(الواصف, خيار_مقبس.مهلة_استقبال(0));
        ليكن تجاهل_الإرسال: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(الواصف, خيار_مقبس.مهلة_إرسال(0));
    }
    | _ -> { };
}

// The transport an HTTP/2 connection is served on: each read and write waits
// at most the body timeout, so a client that goes silent is closed after it.
عرف ناقل_ويب2_بمهلة(الناقل: ناقل_ويب, المهل: &مهل_اتصال_ويب): ناقل_ويب {
    ليكن المللي: طبيعي = مللي_مقبس_ويب((*المهل).الجسم);
    طابق الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> {
        ليكن تجاهل_الاستقبال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_استقبال(المللي));
        ليكن تجاهل_الإرسال: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_إرسال(المللي));
        أرجع ناقل_ويب.تي_سي_بي(التدفق);
    }
    | ناقل_ويب.تي_إل_إس(الآمن) -> {
        ليكن الواصف: عدد = واصف_تدفق_تي_إل_إس(&الآمن);
        ليكن تجاهل_الاستقبال: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(الواصف, خيار_مقبس.مهلة_استقبال(المللي));
        ليكن تجاهل_الإرسال: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(الواصف, خيار_مقبس.مهلة_إرسال(المللي));
        أرجع ناقل_ويب.تي_إل_إس(الآمن);
    }
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> {
        ليكن المحدد: تدفق_بمهلة_ويب = { التدفق: التدفق, المهلة_بالنانو: (*المهل).الجسم };
        أرجع ناقل_ويب.تي_سي_بي_غير_متزامن_بمهلة(المحدد);
    }
    | ناقل_ويب.تي_سي_بي_غير_متزامن_بمهلة(المحدد) -> { أرجع ناقل_ويب.تي_سي_بي_غير_متزامن_بمهلة(المحدد); };
}

// One wait for request bytes.
نوع مقروء_بمهلة_ويب =
    | بايتات بنوع عدد
    | انتهت_المهلة
    | فشل_القراءة بنوع عدد
;

عرف بلا_ناتج_ويب(المقروء: &مقروء_بمهلة_ويب): منطقي {
    طابق *المقروء مع
    | مقروء_بمهلة_ويب.انتهت_المهلة -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A blocking socket's read timed out: EAGAIN (EWOULDBLOCK) on the Unix
// systems, WSAETIMEDOUT on Windows.
عرف خطأ_مهلة_مقبس_ويب(الخطأ: عدد): منطقي {
    أرجع هل_خطأ_سيحظر(الخطأ) || الخطأ == -10060;
}

// One slice of a wait on a blocking TCP socket (SO_RCVTIMEO); انتهت_المهلة
// means no bytes in the slice.
عرف اقرأ_شريحة_حاصرة_ويب(التدفق: &تدفق_تي_سي_بي, المخزن: &متغير متجه ط8, الشريحة: عدد): مقروء_بمهلة_ويب {
    ليكن تجاهل: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(التدفق, خيار_مقبس.مهلة_استقبال(مللي_مقبس_ويب(الشريحة)));
    طابق اقرأ_تي_سي_بي(التدفق, المخزن, 0, الطول(*المخزن) مثل عدد) مع
    | نتيجة.نجح(المقروء) -> { أرجع مقروء_بمهلة_ويب.بايتات(المقروء); }
    | نتيجة.خطأ(الخطأ) -> {
        إذا (هل_خطأ_مقاطعة(الخطأ) || خطأ_مهلة_مقبس_ويب(الخطأ)) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
        أرجع مقروء_بمهلة_ويب.فشل_القراءة(الخطأ);
    };
}

// One wait on a non-blocking socket served by a task: only the task waits
// (std.async), at most الشريحة nanoseconds (0: until the socket is ready or
// the task is woken). It holds one timer, not a wake-up every few hundred
// milliseconds, so thousands of waiting connections cost the scheduler
// nothing until they are due.
عرف اقرأ_شريحة_غير_متزامنة_ويب(التدفق: &تدفق_تي_سي_بي, المخزن: &متغير متجه ط8, الشريحة: عدد): مقروء_بمهلة_ويب {
    طابق اقرأ_تي_سي_بي(التدفق, المخزن, 0, الطول(*المخزن) مثل عدد) مع
    | نتيجة.نجح(المقروء) -> { أرجع مقروء_بمهلة_ويب.بايتات(المقروء); }
    | نتيجة.خطأ(الخطأ) -> {
        إذا (هل_خطأ_مقاطعة(الخطأ)) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
        إذا (!هل_خطأ_سيحظر(الخطأ)) { أرجع مقروء_بمهلة_ويب.فشل_القراءة(الخطأ); };
        ليكن الانتظار: متغير نتيجة عدد, عدد = نتيجة.نجح(0);
        إذا (الشريحة > 0) {
            الانتظار := انتظر_جاهزية_واصف_بمهلة(واصف_تدفق_تي_سي_بي(التدفق), اهتمام_مستطلع.قراءة(), الشريحة);
        } وإلا {
            الانتظار := انتظر_جاهزية_واصف(واصف_تدفق_تي_سي_بي(التدفق), اهتمام_مستطلع.قراءة());
        };
        طابق الانتظار مع
        | نتيجة.خطأ(خ) -> { أرجع مقروء_بمهلة_ويب.فشل_القراءة(خ); }
        | نتيجة.نجح(_) -> { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
    };
}

// A TLS read waits on its socket until the deadline itself (a timed-out TLS
// read fails the TLS connection for good, so it is not sliced).
عرف اقرأ_شريحة_آمنة_ويب(الآمن: &تدفق_تي_إل_إس, المخزن: &متغير متجه ط8, المهلة: عدد): مقروء_بمهلة_ويب {
    ليكن الباقي: متغير عدد = 0;
    إذا (المهلة != 0) {
        الباقي := المهلة - الآن_خادم_ويب();
        إذا (الباقي <= 0) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
    };
    ليكن تجاهل: نتيجة عدد, عدد = طبق_خيار_مقبس_داخليا(واصف_تدفق_تي_إل_إس(الآمن), خيار_مقبس.مهلة_استقبال(مللي_مقبس_ويب(الباقي)));
    طابق اقرأ_تدفق_تي_إل_إس(الآمن, المخزن, 0, الطول(*المخزن) مثل عدد) مع
    | نتيجة.نجح(المقروء) -> { أرجع مقروء_بمهلة_ويب.بايتات(المقروء); }
    | نتيجة.خطأ(الخطأ) -> {
        إذا (المهلة != 0 && الآن_خادم_ويب() + 2000000 >= المهلة) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
        أرجع مقروء_بمهلة_ويب.فشل_القراءة(الخطأ);
    };
}

// Reads request bytes into المخزن until المهلة (monotonic nanoseconds, 0
// none). A connection with no request bytes (بلا_طلب) also stops once a
// shutdown is requested, and every connection once the shutdown's grace
// period is over: a blocking TCP socket waits in slices of at most 200 ms
// to see them; a task waits for the deadline in one go, and the async
// server wakes its waiting tasks when a shutdown starts and when the grace
// period ends (انتظر_مهام_الاتصالات_ويب).
عرف اقرأ_ناقل_بمهلة_ويب(الناقل: &ناقل_ويب, المخزن: &متغير متجه ط8, المهلة: عدد, بلا_طلب: منطقي): مقروء_بمهلة_ويب {
    طالما (صواب) {
        ليكن الآن: عدد = الآن_خادم_ويب();
        إذا (المهلة != 0 && الآن >= المهلة) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
        إذا ((بلا_طلب && هل_طلب_إيقاف_الويب()) || هل_انتهت_مهلة_إيقاف_الويب()) { أرجع مقروء_بمهلة_ويب.انتهت_المهلة(); };
        ليكن الباقي: متغير عدد = 0;
        إذا (المهلة != 0) { الباقي := المهلة - الآن; };
        ليكن الشريحة: متغير عدد = الباقي;
        إذا (الشريحة <= 0 || الشريحة > 200000000) { الشريحة := 200000000; };
        ليكن الناتج: متغير مقروء_بمهلة_ويب = مقروء_بمهلة_ويب.انتهت_المهلة();
        طابق *الناقل مع
        | ناقل_ويب.تي_سي_بي(التدفق) -> { الناتج := اقرأ_شريحة_حاصرة_ويب(&التدفق, المخزن, الشريحة); }
        | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> { الناتج := اقرأ_شريحة_غير_متزامنة_ويب(&التدفق, المخزن, الباقي); }
        | ناقل_ويب.تي_سي_بي_غير_متزامن_بمهلة(المحدد) -> { الناتج := اقرأ_شريحة_غير_متزامنة_ويب(&المحدد.التدفق, المخزن, الباقي); }
        | ناقل_ويب.تي_إل_إس(الآمن) -> { الناتج := اقرأ_شريحة_آمنة_ويب(&الآمن, المخزن, المهلة); };
        إذا (!بلا_ناتج_ويب(&الناتج)) { أرجع الناتج; };
    }
    أرجع مقروء_بمهلة_ويب.انتهت_المهلة();
}

// Writes all the bytes; an async transport waits at most المدة for each step
// of progress (a blocking one has its send timeout).
عرف اكتب_كل_ناقل_بمهلة_ويب(الناقل: &ناقل_ويب, البايتات: &متجه ط8, المدة: عدد): نتيجة طبيعي, عدد {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> {
        طابق اكتب_الكل_غير_متزامن_بمهلة(&التدفق, البايتات, المدة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ن) -> { أرجع نتيجة.نجح(ن مثل طبيعي); };
    }
    | _ -> { أرجع اكتب_الكل(الناقل, اكتب_ناقل_ويب, البايتات); };
}

عرف بايتات_مقروءة_خادم(المخزن: &متجه ط8, العدد: طبيعي): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (ف < (الطول(*المخزن) مثل طبيعي))) { ألحق(الناتج, (*المخزن)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف حالة_خطأ_خادم_ويب(الخطأ: &خطأ_ويب): طبيعي {
    طابق (*الخطأ).الصنف مع
    | صنف_خطأ_ويب.جسم_كبير -> { أرجع 413; }
    | صنف_خطأ_ويب.قسم_رؤوس_كبير -> { أرجع 431; }
    | صنف_خطأ_ويب.رؤوس_كثيرة -> { أرجع 431; }
    | صنف_خطأ_ويب.إصدار_غير_مدعوم -> { أرجع 505; }
    | _ -> { أرجع 400; };
}

// The bytes of the "connection: close" error response for a protocol error
// (empty if it cannot be serialized).
عرف بايتات_خطأ_بروتوكول_خادم(الخطأ: &خطأ_ويب): متجه ط8 {
    ليكن النص: نص = «Bad HTTP request\n»;
    ليكن الاستجابة: متغير استجابة_ويب_مخزنة = استجابة_نص_ويب(حالة_خطأ_خادم_ويب(الخطأ), &النص);
    ليكن اسم_الاتصال: نص = «connection»;
    ليكن close: نص = «close»;
    ليكن تجاهل_رأس: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &اسم_الاتصال, &close);
    طابق سلسل_استجابة_ويب1(&الاستجابة) مع
    | نتيجة.خطأ(_) -> { ليكن فارغ: متجه ط8 = []; أرجع فارغ; }
    | نتيجة.نجح(البايتات) -> { أرجع البايتات; };
}

عرف أرسل_خطأ_بروتوكول_خادم(التدفق: &ناقل_ويب, الخطأ: &خطأ_ويب): فراغ {
    ليكن البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(الخطأ);
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع; };
    ليكن تجاهل_كتابة: نتيجة طبيعي, عدد = اكتب_الكل(التدفق, اكتب_ناقل_ويب, &البايتات);
}

// Whether البايتات can still be, or already are, the HTTP/2 client preface
// (RFC 9113 3.4); the server then switches to h2c with prior knowledge.
عرف بادئة_ويب2_خادم(البايتات: &متجه ط8): منطقي {
    ليكن المقدمة: متجه ط8 = مقدمة_ويب2();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 24 && ف < (الطول(*البايتات) مثل طبيعي)) {
        إذا ((*البايتات)[ف] != المقدمة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Sequential HTTP/1 connection owner. It consumes and closes the transport.
// A connection that starts with the HTTP/2 preface is handed to the HTTP/2
// server (h2c with prior knowledge). Every wait for the client is bounded by
// المهل (مهلة_القراءة_التالية_ويب1); past a deadline the connection is
// closed, after a 408 when part of a request was read. With مقفل the handler
// runs holding القفل (the threaded servers run one handler at a time).
عرف خدم_اتصال_ويب1<S>(
    التدفق: ناقل_ويب,
    الحدود: &حدود_ويب,
    المهل: &مهل_اتصال_ويب,
    القفل: &قفل<منطقي>,
    مقفل: منطقي,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    العنوان_البعيد: نص,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    هيئ_ناقل_خادم_ويب(&التدفق, المهل);
    ليكن المفكك: متغير مفكك_ويب1 = مفكك_ويب1_جديد(*الحدود);
    ليكن البداية: متغير متجه ط8 = [];
    ليكن يفحص_المقدمة: متغير منطقي = صواب;
    ليكن مخزن_قراءة: متغير متجه ط8 = [];
    احجز_سعة(مخزن_قراءة, 8192);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(مخزن_قراءة, 0); ف := ف + 1; }
    ليكن عدد_الطلبات: متغير عدد = 0;
    ليكن مستمر: متغير منطقي = صواب;
    ليكن الزمن: متغير حالة_مهلة_ويب1 = حالة_مهلة_جديدة_ويب1(المهل, الآن_خادم_ويب());
    // One output buffer for the connection, reused by every response.
    ليكن المرسل: متغير متجه ط8 = [];
    طالما (مستمر) {
        طابق التالي_من_مفكك_ويب1(&متغير المفكك) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرسل_خطأ_بروتوكول_خادم(&التدفق, &الخطأ);
            ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
            أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
        }
        | نتيجة.نجح(اختياري.موجود(المحلل)) -> {
            طلب_مأخوذ_مهلة_ويب1(&متغير الزمن);
            ليكن الطلب: متغير طلب_ويب_مخزن = خذ_طلب_محلل_ويب(المحلل);
            الطلب.العنوان_البعيد := انسخ_نص(&العنوان_البعيد);
            إذا (مقفل) { اقفل_خام(القفل); };
            ليكن الاستجابة: متغير استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(
                الحالة, الخدمة, &متغير الطلب, المفكك.الحدود.أقصى_زمن_معالج_بالمللي
            );
            إذا (مقفل) { افتح_خام(القفل); };
            ضع_إصدار_استجابة_ويب(&متغير الاستجابة, الطلب.الإصدار);
            // A protocol switch or a stream goes to the hand-over callback
            // after its head (http.handover); without one, a switch closes.
            ليكن ينتقل: منطقي = هل_انتقال_بروتوكول_ويب(&الطلب, &الاستجابة);
            طابق *المسلم مع
            | اختياري.موجود(المسلم_الفعلي) -> {
                إذا (ينتقل || هل_استجابة_متدفقة_ويب(&الاستجابة)) {
                    اقتطع(المرسل, 0);
                    طابق سلسل_رأس_استجابة_ويب1_إلى(&الطلب, &الاستجابة, &متغير المرسل) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                        أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
                    }
                    | نتيجة.نجح(_) -> { };
                    طابق اكتب_كل_ناقل_بمهلة_ويب(&التدفق, &المرسل, (*المهل).الجسم) مع
                    | نتيجة.خطأ(_) -> {
                        ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                        أرجع نتيجة.نجح(عدد_الطلبات);
                    }
                    | نتيجة.نجح(_) -> { };
                    ليكن الباقي: متغير متجه ط8 = [];
                    بدّل(المفكك.المخزن, الباقي);
                    امسح_مهل_ناقل_ويب(&التدفق);
                    المسلم_الفعلي(الحالة, &الطلب, &الاستجابة, التدفق, الباقي);
                    أرجع نتيجة.نجح(عدد_الطلبات + 1);
                };
            }
            | اختياري.لا_شيء -> {
                إذا (ينتقل) {
                    ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.انتقال_بروتوكول_غير_مدعوم());
                };
            };
            علم_إغلاق_عند_الإيقاف_ويب(&متغير الاستجابة);
            ليكن يبقى: منطقي = طبق_سياسة_اتصال_خادم_ويب1(&الطلب, &متغير الاستجابة);
            اقتطع(المرسل, 0);
            طابق سلسل_استجابة_ويب1_لطلب_إلى(&الطلب, &الاستجابة, &متغير المرسل) مع
            | نتيجة.خطأ(الخطأ) -> {
                ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
            }
            | نتيجة.نجح(_) -> { };
            طابق اكتب_كل_ناقل_بمهلة_ويب(&التدفق, &المرسل, (*المهل).الجسم) مع
            | نتيجة.خطأ(الخطأ) -> {
                ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
            }
            | نتيجة.نجح(_) -> { };
            عدد_الطلبات := عدد_الطلبات + 1;
            إذا (!يبقى) {
                ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.نجح(عدد_الطلبات);
            };
        }
        | نتيجة.نجح(اختياري.لا_شيء) -> {
            // The bytes read and not yet a request: the preface candidate,
            // then the decoder's buffer.
            ليكن المعلقة: متغير طبيعي = بايتات_معلقة_في_مفكك_ويب1(&المفكك);
            ليكن المهلة: متغير عدد = 0;
            إذا (يفحص_المقدمة) {
                المعلقة := الطول(البداية) مثل طبيعي;
                المهلة := مهلة_القراءة_التالية_ويب1(&متغير الزمن, المهل, &البداية, الآن_خادم_ويب());
            } وإلا {
                المهلة := مهلة_القراءة_التالية_ويب1(&متغير الزمن, المهل, &المفكك.المخزن, الآن_خادم_ويب());
            };
            طابق اقرأ_ناقل_بمهلة_ويب(&التدفق, &متغير مخزن_قراءة, المهلة, المعلقة == 0) مع
            | مقروء_بمهلة_ويب.انتهت_المهلة -> {
                إذا (المعلقة > 0) {
                    ليكن البايتات: متجه ط8 = بايتات_انتهاء_مهلة_طلب_خادم();
                    ليكن تجاهل_الكتابة: نتيجة طبيعي, عدد = اكتب_كل_ناقل_بمهلة_ويب(&التدفق, &البايتات, (*المهل).الجسم);
                };
                ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.نجح(عدد_الطلبات);
            }
            | مقروء_بمهلة_ويب.فشل_القراءة(الخطأ) -> {
                ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
            }
            | مقروء_بمهلة_ويب.بايتات(المقروء) -> {
                إذا (المقروء == 0) {
                    إذا (بايتات_معلقة_في_مفكك_ويب1(&المفكك) > 0) {
                        ليكن خطأ_النهاية: خطأ_ويب = خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), بايتات_معلقة_في_مفكك_ويب1(&المفكك));
                        أرسل_خطأ_بروتوكول_خادم(&التدفق, &خطأ_النهاية);
                    };
                    ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                    أرجع نتيجة.نجح(عدد_الطلبات);
                };
                ليكن الجزء: متجه ط8 = بايتات_مقروءة_خادم(&مخزن_قراءة, المقروء مثل طبيعي);
                إذا (يفحص_المقدمة) {
                    ليكن ك: متغير طبيعي = 0;
                    طالما (ك < (الطول(الجزء) مثل طبيعي)) { ألحق(البداية, الجزء[ك]); ك := ك + 1; }
                    إذا (!بادئة_ويب2_خادم(&البداية)) {
                        يفحص_المقدمة := خطأ;
                        غذ_مفكك_ويب1(&متغير المفكك, &البداية);
                    } وإلا إذا ((الطول(البداية) مثل طبيعي) >= 24) {
                        ليكن حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
                        ليكن الناقل2: ناقل_ويب = ناقل_ويب2_بمهلة(التدفق, المهل);
                        طابق خدم_اتصال_ويب2_متسلسل_من(الناقل2, البداية, &حدود2, الحالة, الخدمة, العنوان_البعيد, القفل, مقفل) مع
                        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.ويب2(خ)); }
                        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
                    };
                } وإلا {
                    غذ_مفكك_ويب1(&متغير المفكك, &الجزء);
                };
            };
        };
    }
    ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
    أرجع نتيجة.نجح(عدد_الطلبات);
}

// The sequential servers' wait for a connection (http.shutdown): with a
// poller, the listener is watched 200 ms at a time so a shutdown request is
// seen while no client connects; answers صواب when a connection is ready.
// Without a poller (Windows) accept itself waits.
عرف مستطلع_مستمع_خادم(المستمع: &مستمع_تي_سي_بي): اختياري مستطلع {
    إذا (!هل_المستطلع_مدعوم()) { أرجع اختياري.لا_شيء(); };
    طابق أنشئ_مستطلع() مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(م) -> {
        طابق سجل_في_مستطلع(&م, واصف_مستمع_تي_سي_بي(المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.خطأ(_) -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستطلع(م); أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(_) -> { أرجع اختياري.موجود(م); };
    };
}

عرف اتصال_جاهز_للقبول(
    المستطلع: &اختياري مستطلع,
    المستمع: &مستمع_تي_سي_بي,
    الأحداث: &متغير مخزن_أحداث_مستطلع
): منطقي {
    طابق *المستطلع مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(م) -> {
        طابق انتظر_مستطلع(&م, الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد == 0) { أرجع خطأ; };
            ليكن تجاهل: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(&م, واصف_مستمع_تي_سي_بي(المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة());
            أرجع صواب;
        };
    };
}

عرف أغلق_مستطلع_خادم(المستطلع: اختياري مستطلع): فراغ {
    طابق المستطلع مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(م) -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستطلع(م); };
}

// The sequential HTTP server (HTTP/1, and h2c by prior knowledge): a client
// that stalls never holds up the others. Where tasks switch (std.async:
// x86_64 and arm64 with a poller) it is the async server below, on the
// calling thread; elsewhere (Windows, other architectures) every connection
// gets a thread of its own while the handlers still run one at a time
// (شغل_خادم_ويب_بخيوط). Returns on a setup failure, when the listener fails
// for good, or after a shutdown (http.shutdown) once its connections ended.
عام عرف شغل_خادم_ويب<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    إذا (المهام_مدعومة() && هل_المستطلع_مدعوم()) {
        أرجع شغل_خادم_ويب_غير_متزامن(الإعداد, الحالة, الخدمة);
    };
    ليكن بلا_أمان: مشترك<إعداد_خادم_تي_إل_إس> = أنشئ_مشترك(إعداد_أمان_فارغ_ويب());
    أرجع شغل_خادم_ويب_بخيوط(الإعداد, بلا_أمان, خطأ, الحالة, الخدمة);
}

// A TLS configuration that is never used (a plain HTTP threaded server).
عرف إعداد_أمان_فارغ_ويب(): إعداد_خادم_تي_إل_إس {
    ليكن لا_بايتات: متجه ط8 = [];
    ليكن لا_كلمة: نص = «»;
    أرجع أنشئ_إعداد_خادم_تي_إل_إس(أنشئ_هوية_خادم_تي_إل_إس(لا_بايتات, &لا_كلمة));
}

// A connection thread of شغل_خادم_ويب_بخيوط and the flag it sets when done.
نوع خيط_اتصال_ويب = {
    المقبض: مقبض_خيط,
    انتهى: مشترك<ذرة_ط32>
};

// Joins the connection threads that have finished.
عرف اجمع_خيوط_الاتصالات_ويب(الخيوط: &متغير متجه خيط_اتصال_ويب): فراغ {
    ليكن الباقية: متغير متجه خيط_اتصال_ويب = [];
    طالما ((الطول(*الخيوط) مثل طبيعي) > 0) {
        طابق أزل_الأخير(*الخيوط) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(خ) -> {
            ليكن الخيط: متغير خيط_اتصال_ويب = خ;
            إذا (احمل_ط32(اقرأ_مشترك(&الخيط.انتهى), ترتيب_ذاكرة.تسلسلي()) != (0 مثل ط32)) {
                انضم(&متغير الخيط.المقبض);
            } وإلا {
                ألحق(الباقية, الخيط);
            };
        };
    }
    بدّل(*الخيوط, الباقية);
}

// After the accept loop: waits for every connection thread. During a
// shutdown, once its grace period is over, the requests still running are
// cancelled (http.deadline) and the reads still waiting stop.
عرف انتظر_خيوط_الاتصالات_ويب(الخيوط: &متغير متجه خيط_اتصال_ويب): فراغ {
    ليكن النهاية: عدد = الآن_خادم_ويب() + مهلة_إيقاف_الويب_بالثواني() * 1000000000;
    اجمع_خيوط_الاتصالات_ويب(الخيوط);
    طالما ((الطول(*الخيوط) مثل طبيعي) > 0) {
        إذا (هل_طلب_إيقاف_الويب() && الآن_خادم_ويب() >= النهاية) { علّم_انتهاء_مهلة_إيقاف_الويب(); };
        ليكن تجاهل: نتيجة عدد, عدد = نم_نانو(20000000);
        اجمع_خيوط_الاتصالات_ويب(الخيوط);
    }
}

// One connection of the threaded server: TLS first when آمن.
عرف خدم_اتصال_تسلسلي_ويب<S>(
    التدفق: تدفق_تي_سي_بي,
    الأمان: &إعداد_خادم_تي_إل_إس,
    آمن: منطقي,
    الحدود: &حدود_ويب,
    المهل: &مهل_اتصال_ويب,
    القفل: &قفل<منطقي>,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): فراغ {
    ليكن بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    إذا (آمن) {
        ليكن تجاهل_الآمن: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_ويب_آمن_داخلي(التدفق, الأمان, الحدود, المهل, القفل, صواب, الحالة, الخدمة, &بلا_تسليم);
        أرجع;
    };
    ليكن العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    ليكن تجاهل: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_ويب1(ناقل_ويب.تي_سي_بي(التدفق), الحدود, المهل, القفل, صواب, الحالة, الخدمة, العنوان, &بلا_تسليم);
}

// The body of a connection thread: the socket comes as its descriptor, the
// borrowed state as a pointer the server keeps valid (it joins every thread
// before it returns).
عرف خدم_اتصال_في_خيط_ويب<S>(
    الواصف: عدد,
    الأمان: مشترك<إعداد_خادم_تي_إل_إس>,
    آمن: منطقي,
    الحدود: حدود_ويب,
    المهل: مهل_اتصال_ويب,
    القفل: مشترك<قفل<منطقي>>,
    الحالة: *S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    انتهى: مشترك<ذرة_ط32>
): فراغ {
    ليكن التدفق: تدفق_تي_سي_بي = صندوق الواصف;
    غير_آمن {
        خدم_اتصال_تسلسلي_ويب(التدفق, اقرأ_مشترك(&الأمان), آمن, &الحدود, &المهل, اقرأ_مشترك(&القفل), &(*الحالة), الخدمة);
    }
    اخزن_ط32(اقرأ_مشترك(&انتهى), 1 مثل ط32, ترتيب_ذاكرة.تسلسلي());
}

// The threaded sequential server (HTTP, or HTTPS when آمن): every accepted
// connection is served on a thread of its own, so a slow or stalled client
// holds only its thread, up to أقصى_الاتصالات threads. The handlers still
// run one at a time (the state is borrowed, as on one thread): each holds
// one lock while it runs. Where no thread can start (the interpreter) a
// connection is served on this thread, its waits bounded by the deadlines.
عرف شغل_خادم_ويب_بخيوط<S>(
    الإعداد: &إعداد_خادم_ويب,
    الأمان: مشترك<إعداد_خادم_تي_إل_إس>,
    آمن: منطقي,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    ليكن الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(المستمع) -> {
        ليكن المهل: مهل_اتصال_ويب = مهل_من_إعداد_ويب(الإعداد);
        ليكن الحدود: حدود_ويب = (*الإعداد).الحدود;
        ليكن الأقصى: طبيعي = (*الإعداد).أقصى_الاتصالات;
        ليكن مؤشر_الحالة: *S = الحالة;
        ليكن القفل: مشترك<قفل<منطقي>> = أنشئ_مشترك(أنشئ_قفل(خطأ));
        ليكن الخيوط: متغير متجه خيط_اتصال_ويب = [];
        // A failed accept is usually about one connection or a passing
        // shortage (ECONNABORTED, EINTR, EMFILE, ENOBUFS, ...): retry after
        // a backoff of 1 ms doubling to 1 s. Stop only when the listener
        // itself is unusable (EINVAL: not listening) or after 64 failures
        // in a row, which also ends a closed or invalid descriptor.
        ليكن إخفاقات_متتالية: متغير عدد = 0;
        ليكن الانتظار: متغير عدد = 1000000;
        ليكن المستطلع: اختياري مستطلع = مستطلع_مستمع_خادم(&المستمع);
        ليكن الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(1);
        طالما (صواب) {
            إذا (هل_طلب_إيقاف_الويب()) {
                أغلق_مستطلع_خادم(المستطلع);
                ليكن تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                انتظر_خيوط_الاتصالات_ويب(&متغير الخيوط);
                أرجع نتيجة.نجح(0);
            };
            اجمع_خيوط_الاتصالات_ويب(&متغير الخيوط);
            إذا (اتصال_جاهز_للقبول(&المستطلع, &المستمع, &متغير الأحداث)) {
                طابق اقبل_تي_سي_بي(&المستمع) مع
                | نتيجة.خطأ(الخطأ) -> {
                    إخفاقات_متتالية := إخفاقات_متتالية + 1;
                    طابق صنف_خطأ_ملفات_النظام(الخطأ) مع
                    | صنف_خطأ_نظام.وسيط_غير_صالح -> { إخفاقات_متتالية := 64; }
                    | _ -> { };
                    إذا (إخفاقات_متتالية >= 64) {
                        أغلق_مستطلع_خادم(المستطلع);
                        ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                        انتظر_خيوط_الاتصالات_ويب(&متغير الخيوط);
                        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
                    };
                    ليكن تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(الانتظار);
                    إذا (الانتظار < 1000000000) { الانتظار := الانتظار * 2; };
                }
                | نتيجة.نجح(التدفق) -> {
                    إخفاقات_متتالية := 0;
                    الانتظار := 1000000;
                    إذا (الأقصى != 0 && (الطول(الخيوط) مثل طبيعي) >= الأقصى) {
                        ارفض_اتصالا_ممتلئا_ويب(التدفق);
                    } وإلا {
                        هيئ_مقبس_خادم_ويب(&التدفق, &المهل);
                        ليكن الواصف: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
                        ليكن انتهى: مشترك<ذرة_ط32> = أنشئ_مشترك(أنشئ_ذرة_ط32(0 مثل ط32));
                        ليكن انتهاؤه: مشترك<ذرة_ط32> = استنسخ_مشترك(&انتهى);
                        ليكن أمانه: مشترك<إعداد_خادم_تي_إل_إس> = استنسخ_مشترك(&الأمان);
                        ليكن قفله: مشترك<قفل<منطقي>> = استنسخ_مشترك(&القفل);
                        ليكن المقبض: متغير اختياري مقبض_خيط = اختياري.لا_شيء();
                        غير_آمن {
                            طابق أطلق(دالة(): فراغ -> خدم_اتصال_في_خيط_ويب(الواصف, أمانه, آمن, الحدود, المهل, قفله, مؤشر_الحالة, الخدمة, انتهاؤه)) مع
                            | نتيجة.خطأ(_) -> { }
                            | نتيجة.نجح(م) -> { المقبض := اختياري.موجود(م); };
                        }
                        طابق المقبض مع
                        | اختياري.موجود(م) -> {
                            ليكن الخيط: خيط_اتصال_ويب = { المقبض: م, انتهى: انتهى };
                            ألحق(الخيوط, الخيط);
                        }
                        | اختياري.لا_شيء -> {
                            // No thread (the interpreter, or the system
                            // refused one): this connection is served here.
                            ليكن هنا: تدفق_تي_سي_بي = صندوق الواصف;
                            خدم_اتصال_تسلسلي_ويب(هنا, اقرأ_مشترك(&الأمان), آمن, &الحدود, &المهل, اقرأ_مشترك(&القفل), الحالة, الخدمة);
                        };
                    };
                };
            };
        }
    };
    أرجع نتيجة.نجح(0);
}

// One connection of the async server, inside its task: the socket is
// non-blocking, so every read and write that has to wait suspends this task
// only (http.transport تي_سي_بي_غير_متزامن), and each wait is bounded by the
// deadlines.
عرف خدم_اتصال_مهمة_ويب<S>(
    الواصف: عدد,
    الحدود: حدود_ويب,
    المهل: مهل_اتصال_ويب,
    الحالة: *S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): منطقي {
    ليكن التدفق: تدفق_تي_سي_بي = صندوق الواصف;
    ليكن العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    ليكن بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    // Tasks share one thread: no handler lock (a second lock would block
    // the thread).
    ليكن بلا_قفل: قفل<منطقي> = أنشئ_قفل(خطأ);
    ليكن الناتج: متغير منطقي = صواب;
    غير_آمن {
        طابق خدم_اتصال_ويب1(ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق), &الحدود, &المهل, &بلا_قفل, خطأ, &(*الحالة), الخدمة, العنوان, &بلا_تسليم) مع
        | نتيجة.خطأ(_) -> { الناتج := خطأ; }
        | نتيجة.نجح(_) -> { };
    }
    أرجع الناتج;
}

// Drops the handles of the connection tasks that have finished.
عرف انزع_المهام_المنتهية_ويب(المهام: &متغير متجه مهمة<منطقي>): فراغ {
    ليكن الباقية: متغير متجه مهمة<منطقي> = [];
    طالما ((الطول(*المهام) مثل طبيعي) > 0) {
        طابق أزل_الأخير(*المهام) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(م) -> {
            إذا (!انتهت_المهمة(&م)) { ألحق(الباقية, م); };
        };
    }
    بدّل(*المهام, الباقية);
}

// Wakes every connection task that waits: an idle one then sees the
// shutdown and closes, the others wait again.
عرف أيقظ_مهام_الاتصالات_ويب(المهام: &متجه مهمة<منطقي>): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المهام) مثل طبيعي)) {
        أيقظ_مهمة_منتظرة(&(*المهام)[ف]);
        ف := ف + 1;
    }
}

// After the accept loop: lets every connection task finish (each one's waits
// are bounded; idle ones stop at a shutdown, woken here). Once a shutdown's
// grace period is over, the requests still running are cancelled and every
// task is woken again to see it.
عرف انتظر_مهام_الاتصالات_ويب(المهام: &متغير متجه مهمة<منطقي>): فراغ {
    ليكن النهاية: عدد = الآن_خادم_ويب() + مهلة_إيقاف_الويب_بالثواني() * 1000000000;
    ليكن انتهت_المهلة: متغير منطقي = خطأ;
    انزع_المهام_المنتهية_ويب(المهام);
    إذا (هل_طلب_إيقاف_الويب()) { أيقظ_مهام_الاتصالات_ويب(&(*المهام)); };
    طالما ((الطول(*المهام) مثل طبيعي) > 0) {
        إذا (!انتهت_المهلة && هل_طلب_إيقاف_الويب() && الآن_خادم_ويب() >= النهاية) {
            انتهت_المهلة := صواب;
            علّم_انتهاء_مهلة_إيقاف_الويب();
            أيقظ_مهام_الاتصالات_ويب(&(*المهام));
        };
        نم_مهمة(20000000);
        انزع_المهام_المنتهية_ويب(المهام);
    }
}

// The async HTTP server (HTTP/1, and h2c by prior knowledge) on the calling
// thread: every accepted connection is served by a task of its own
// (std.async), so an idle or slow client holds a task stack, not a thread,
// and thousands of connections share one thread. The state is borrowed for
// as long as the server runs. Every wait for a client is bounded by the
// configuration's deadlines, and at most أقصى_الاتصالات connections are
// open (one more is answered 503 and closed). Where tasks do not switch
// (المهام_مدعومة false) connections are served one after another. Returns on
// a setup failure, when the listener fails for good, or when shutdown was
// requested (checked between accepts), after its connections ended.
عام عرف شغل_خادم_ويب_غير_متزامن<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    ليكن الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    ليكن المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    ليكن مؤشر_الحالة: *S = الحالة;
    ليكن الحدود: حدود_ويب = (*الإعداد).الحدود;
    ليكن المهل: مهل_اتصال_ويب = مهل_من_إعداد_ويب(الإعداد);
    ليكن الأقصى: طبيعي = (*الإعداد).أقصى_الاتصالات;
    ليكن المهام: متغير متجه مهمة<منطقي> = [];
    ليكن المقبولة: متغير طبيعي = 0;
    ليكن إخفاقات_متتالية: متغير عدد = 0;
    طالما (صواب) {
        إذا (هل_طلب_إيقاف_الويب()) {
            ليكن تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(المستمع);
            انتظر_مهام_الاتصالات_ويب(&متغير المهام);
            أرجع نتيجة.نجح(0);
        };
        طابق اقبل_تي_سي_بي(&المستمع) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) {
                // Nothing to accept: wait for a connection, at most 250 ms
                // so a shutdown request is seen.
                ليكن تجاهل_الانتظار: نتيجة عدد, عدد = انتظر_جاهزية_واصف_بمهلة(
                    واصف_مستمع_تي_سي_بي(&المستمع), اهتمام_مستطلع.قراءة(), 250000000
                );
            } وإلا {
                // As شغل_خادم_ويب_بخيوط: a failed accept is usually about
                // one connection; stop after 64 in a row or a listener that
                // is not listening.
                إخفاقات_متتالية := إخفاقات_متتالية + 1;
                طابق صنف_خطأ_ملفات_النظام(الخطأ) مع
                | صنف_خطأ_نظام.وسيط_غير_صالح -> { إخفاقات_متتالية := 64; }
                | _ -> { };
                إذا (إخفاقات_متتالية >= 64) {
                    ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(المستمع);
                    انتظر_مهام_الاتصالات_ويب(&متغير المهام);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
                };
                نم_مهمة(1000000 * إخفاقات_متتالية);
            };
        }
        | نتيجة.نجح(التدفق) -> {
            إخفاقات_متتالية := 0;
            // The handles of finished tasks are dropped when the limit is
            // reached or every 256 connections, not at every accept.
            المقبولة := المقبولة + 1;
            إذا ((الأقصى != 0 && (الطول(المهام) مثل طبيعي) >= الأقصى) || المقبولة % 256 == 0) {
                انزع_المهام_المنتهية_ويب(&متغير المهام);
            };
            إذا (الأقصى != 0 && (الطول(المهام) مثل طبيعي) >= الأقصى) {
                ارفض_اتصالا_ممتلئا_ويب(التدفق);
            } وإلا {
                ليكن تجاهل_الوضع: نتيجة عدد, عدد = اجعل_تدفقا_غير_متزامن(&التدفق);
                ليكن الواصف: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
                ليكن العمل: دالة(): منطقي;
                غير_آمن {
                    العمل := دالة(): منطقي -> خدم_اتصال_مهمة_ويب(الواصف, الحدود, المهل, مؤشر_الحالة, الخدمة);
                }
                ليكن المهمة: مهمة<منطقي> = أطلق_مهمة(العمل);
                ألحق(المهام, المهمة);
            };
        };
    }
    أرجع نتيجة.نجح(0);
}
عام مرادف http_serve_async = شغل_خادم_ويب_غير_متزامن;

// Serves one accepted connection over a transport (HTTP/1, or HTTP/2 when it
// starts with the client preface) and closes it, with the default deadlines
// (إعداد_خادم_ويب_افتراضي).
عام عرف خدم_اتصال_ويب<S>(
    الناقل: ناقل_ويب,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن العنوان: نص = عنوان_نظير_ناقل_ويب(&الناقل);
    ليكن بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    ليكن المهل: مهل_اتصال_ويب = مهل_افتراضية_ويب();
    ليكن بلا_قفل: قفل<منطقي> = أنشئ_قفل(خطأ);
    أرجع خدم_اتصال_ويب1(الناقل, الحدود, &المهل, &بلا_قفل, خطأ, الحالة, الخدمة, العنوان, &بلا_تسليم);
}

// As خدم_اتصال_ويب, handing protocol switches and streamed responses to
// المسلم after their head (http.handover).
عام عرف خدم_اتصال_ويب_مع_تسليم<S>(
    الناقل: ناقل_ويب,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن العنوان: نص = عنوان_نظير_ناقل_ويب(&الناقل);
    ليكن مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    ليكن المهل: مهل_اتصال_ويب = مهل_افتراضية_ويب();
    ليكن بلا_قفل: قفل<منطقي> = أنشئ_قفل(خطأ);
    أرجع خدم_اتصال_ويب1(الناقل, الحدود, &المهل, &بلا_قفل, خطأ, الحالة, الخدمة, العنوان, &مع_تسليم);
}

// Serves one accepted TCP connection over TLS: the handshake (whose ALPN
// list comes from إعداد_الأمان), then HTTP/2 when "h2" was negotiated and
// HTTP/1 otherwise; with the default deadlines.
عام عرف خدم_اتصال_ويب_آمن<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    ليكن المهل: مهل_اتصال_ويب = مهل_افتراضية_ويب();
    ليكن بلا_قفل: قفل<منطقي> = أنشئ_قفل(خطأ);
    أرجع خدم_اتصال_ويب_آمن_داخلي(التدفق, إعداد_الأمان, الحدود, &المهل, &بلا_قفل, خطأ, الحالة, الخدمة, &بلا_تسليم);
}

// As خدم_اتصال_ويب_آمن, with a hand-over callback for HTTP/1 (http.handover).
عام عرف خدم_اتصال_ويب_آمن_مع_تسليم<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    ليكن المهل: مهل_اتصال_ويب = مهل_افتراضية_ويب();
    ليكن بلا_قفل: قفل<منطقي> = أنشئ_قفل(خطأ);
    أرجع خدم_اتصال_ويب_آمن_داخلي(التدفق, إعداد_الأمان, الحدود, &المهل, &بلا_قفل, خطأ, الحالة, الخدمة, &مع_تسليم);
}

// Every read of the handshake waits at most the header timeout, and every
// send the body timeout (هيئ_مقبس_خادم_ويب).
عرف خدم_اتصال_ويب_آمن_داخلي<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    المهل: &مهل_اتصال_ويب,
    القفل: &قفل<منطقي>,
    مقفل: منطقي,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    // The client's address, read before the socket moves into the TLS stream.
    ليكن العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    هيئ_مقبس_خادم_ويب(&التدفق, المهل);
    طابق اقبل_خادم_تي_إل_إس(التدفق, إعداد_الأمان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(الآمن) -> {
        ليكن h2: متغير منطقي = خطأ;
        طابق بروتوكول_تدفق_تي_إل_إس(&الآمن) مع
        | اختياري.موجود(ب) -> {
            ليكن اسم_h2: نص = «h2»;
            h2 := نصان_متساويان(&ب, &اسم_h2);
        }
        | اختياري.لا_شيء -> { };
        إذا (h2) {
            ليكن حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
            ليكن لا_بايتات: متجه ط8 = [];
            ليكن الناقل2: ناقل_ويب = ناقل_ويب2_بمهلة(ناقل_ويب.تي_إل_إس(الآمن), المهل);
            طابق خدم_اتصال_ويب2_متسلسل_من(الناقل2, لا_بايتات, &حدود2, الحالة, الخدمة, انسخ_نص(&العنوان), القفل, مقفل) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.ويب2(خ)); }
            | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
        };
        أرجع خدم_اتصال_ويب1(ناقل_ويب.تي_إل_إس(الآمن), الحدود, المهل, القفل, مقفل, الحالة, الخدمة, العنوان, المسلم);
    };
}

// The HTTPS server: each accepted connection runs the TLS handshake with
// ALPN offering "h2" and "http/1.1" (unless the configuration lists its own
// protocols), then HTTP/2 or HTTP/1 by the negotiated protocol. Every
// connection has a thread of its own (شغل_خادم_ويب_بخيوط); the handlers run
// one at a time.
عام عرف شغل_خادم_ويب_آمن<S>(
    الإعداد: &إعداد_خادم_ويب,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن الأمان: متغير إعداد_خادم_تي_إل_إس = انسخ_إعداد_خادم_تي_إل_إس(إعداد_الأمان);
    إذا ((الطول(الأمان.البروتوكولات) مثل طبيعي) == 0) {
        ليكن البروتوكولات: متجه نص = [«h2», «http/1.1»];
        اضبط_بروتوكولات_خادم_تي_إل_إس(&متغير الأمان, &البروتوكولات);
    };
    ليكن المشترك: مشترك<إعداد_خادم_تي_إل_إس> = أنشئ_مشترك(الأمان);
    أرجع شغل_خادم_ويب_بخيوط(الإعداد, المشترك, صواب, الحالة, الخدمة);
}

// ---- The event-driven HTTP server ----
//
// The threaded servers (شغل_خادم_ويب where tasks do not switch, and the
// HTTPS server) keep a thread per client, so an idle or slow client holds a
// whole thread, and the async one runs every handler on one thread. This
// server instead keeps every connection
// non-blocking in one readiness poller (std.os.poll: epoll, kqueue), the
// design of nginx:
//
// - N worker threads (default: the available parallelism) all wait on the
//   one poller. Every descriptor is armed one-shot, so an event hands its
//   connection to exactly one worker; no two workers touch a connection at
//   once, and a connection costs no thread while it waits.
// - The worker that gets an event takes the connection out of the shared
//   table, reads until the socket would block, feeds the incremental HTTP/1
//   parser, runs the handler for every complete request (pipelining kept in
//   order), and writes without blocking. Output the socket does not take
//   yet stays with the connection, which then waits to write; otherwise it
//   waits to read. It is put back in the table before it is re-armed.
// - The listener is token 0: the worker that gets it accepts until accept
//   would block, then re-arms it.
// - A handler runs on the worker that read its request. A slow handler
//   blocks that worker only; the others keep serving.
// - A connection that starts with the HTTP/2 client preface (h2c with prior
//   knowledge) leaves the poller and is served by the blocking HTTP/2
//   server on its worker for its lifetime (each read and write bounded by
//   the body timeout).
// - Every connection in the table carries the deadline of what it waits for
//   (مهلة_القراءة_التالية_ويب1, or the body timeout while it waits to
//   write). Each worker sweeps its table every 100 ms and closes the
//   connections past their deadline (اكنس_المنتهية_حدثيا), freeing their
//   descriptors.
// - Each worker's table holds at most its share of أقصى_الاتصالات; a
//   connection over it is answered 503 and closed when it is accepted.
//
// Targets without a poller (Windows for now: IOCP is a completion model)
// run the sequential شغل_خادم_ويب instead.

عرف تراكم_صادر_أقصى_ويب(): عدد { أرجع 8192; }

نوع اتصال_حدثي_ويب = {
    التدفق: تدفق_تي_سي_بي,
    المفكك: مفكك_ويب1,
    البداية: متجه ط8,
    الصادر: متجه ط8,
    المرسل: عدد,
    العنوان_البعيد: نص,
    // A response whose head is queued and whose connection then goes to the
    // hand-over callback (http.handover).
    التسليم: اختياري تسليم_معلق_ويب,
    // Its deadlines (حالة_مهلة_ويب1).
    الزمن: حالة_مهلة_ويب1,
    // The flags last, side by side (no padding after each).
    يفحص_المقدمة: منطقي,
    يغلق: منطقي
};

نوع تسليم_معلق_ويب = {
    الطلب: طلب_ويب_مخزن,
    الاستجابة: استجابة_ويب_مخزنة
};

// What the connection waits for after a step, carrying it back to the
// worker, which puts it back and re-arms it, or ends it.
نوع خطوة_اتصال_حدثي_ويب =
    | ينتظر_القراءة بنوع اتصال_حدثي_ويب
    | ينتظر_الكتابة بنوع اتصال_حدثي_ويب
    | انتهى_الاتصال بنوع اتصال_حدثي_ويب
    | إلى_ويب2 بنوع اتصال_حدثي_ويب
    | إلى_مسلم بنوع اتصال_حدثي_ويب
;

نوع نتيجة_إفراغ_ويب =
    | أفرغ
    | محجوب
    | فشل
;

// Connection slots: token = slot + 1 (0 is the listener). Free slots are
// reused so tokens stay small. A slot is one open connection (one
// descriptor), so slot indices fit ط32.
نوع جدول_اتصالات_ويب = {
    الخانات: متجه اختياري اتصال_حدثي_ويب,
    الحرة: متجه ط32
};

نوع سياق_خادم_حدثي_ويب = {
    المستطلع: مستطلع,
    المستمع: مستمع_تي_سي_بي,
    الجدول: قفل<جدول_اتصالات_ويب>,
    الحدود: حدود_ويب,
    المهل: مهل_اتصال_ويب,
    // The most connections this worker's table holds (0: no limit).
    السعة: طبيعي
};

عرف ألحق_بايتات_حدثي(الهدف: &متغير متجه ط8, البايتات: &متجه ط8): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) { ألحق(*الهدف, (*البايتات)[ف]); ف := ف + 1; }
}

// The table under its lock (std.sync.mutex's raw lock, as Condvar uses it).
عرف أدخل_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الاتصال: اتصال_حدثي_ويب): طبيعي {
    ليكن الخانة_الجديدة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(الاتصال);
    اقفل_خام(الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    ليكن الموضع: متغير طبيعي = 0;
    غير_آمن {
        طابق أزل_الأخير((*المؤشر).الحرة) مع
        | اختياري.موجود(الحرة) -> {
            الموضع := الحرة;
            بدّل((*المؤشر).الخانات[الموضع], الخانة_الجديدة);
        }
        | اختياري.لا_شيء -> {
            الموضع := الطول((*المؤشر).الخانات) مثل طبيعي;
            ألحق((*المؤشر).الخانات, الخانة_الجديدة);
        };
    }
    افتح_خام(الجدول);
    أرجع الموضع;
}

عرف خذ_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي): اختياري اتصال_حدثي_ويب {
    ليكن الناتج: متغير اختياري اتصال_حدثي_ويب = اختياري.لا_شيء();
    اقفل_خام(الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن {
        إذا (الموضع < (الطول((*المؤشر).الخانات) مثل طبيعي)) {
            بدّل((*المؤشر).الخانات[الموضع], الناتج);
        };
    }
    افتح_خام(الجدول);
    أرجع الناتج;
}

عرف أعد_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي, الاتصال: اتصال_حدثي_ويب): فراغ {
    ليكن الخانة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(الاتصال);
    اقفل_خام(الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن { بدّل((*المؤشر).الخانات[الموضع], الخانة); }
    افتح_خام(الجدول);
}

عرف حرر_خانة_حدثية(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي): فراغ {
    اقفل_خام(الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن { ألحق((*المؤشر).الحرة, الموضع مثل ط32); }
    افتح_خام(الجدول);
}

عرف أغلق_اتصالا_حدثيا(الاتصال: اتصال_حدثي_ويب): فراغ {
    طابق الاتصال مع
    | { التدفق: التدفق, المفكك: _, البداية: _, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: _, التسليم: _, الزمن: _ } -> {
        ليكن تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
    };
}

// Writes pending output until it is all sent or the socket would block.
عرف أفرغ_صادر_حدثي(الاتصال: &متغير اتصال_حدثي_ويب): نتيجة_إفراغ_ويب {
    ليكن الكل: عدد = الطول((*الاتصال).الصادر) مثل عدد;
    طالما ((*الاتصال).المرسل < الكل) {
        طابق اكتب_تي_سي_بي(&(*الاتصال).التدفق, &(*الاتصال).الصادر, (*الاتصال).المرسل, الكل - (*الاتصال).المرسل) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) { أرجع نتيجة_إفراغ_ويب.محجوب(); };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة_إفراغ_ويب.فشل(); };
        }
        | نتيجة.نجح(المكتوب) -> {
            إذا (المكتوب <= 0) { أرجع نتيجة_إفراغ_ويب.فشل(); };
            (*الاتصال).المرسل := (*الاتصال).المرسل + المكتوب;
        };
    }
    // Keep the buffer's capacity for the next responses.
    اقتطع((*الاتصال).الصادر, 0);
    (*الاتصال).المرسل := 0;
    أرجع نتيجة_إفراغ_ويب.أفرغ();
}

// Runs the handler for every complete request the parser holds and queues
// the responses; stops at a request that ends the connection.
عرف أجب_طلبات_حدثية<S>(
    الاتصال: &متغير اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    طالما (!(*الاتصال).يغلق) {
        طابق التالي_من_مفكك_ويب1(&متغير (*الاتصال).المفكك) مع
        | نتيجة.خطأ(الخطأ) -> {
            ليكن البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(&الخطأ);
            ألحق_بايتات_حدثي(&متغير (*الاتصال).الصادر, &البايتات);
            (*الاتصال).يغلق := صواب;
        }
        | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع; }
        | نتيجة.نجح(اختياري.موجود(المحلل)) -> {
            طلب_مأخوذ_مهلة_ويب1(&متغير (*الاتصال).الزمن);
            ليكن الطلب: متغير طلب_ويب_مخزن = خذ_طلب_محلل_ويب(المحلل);
            الطلب.العنوان_البعيد := انسخ_نص(&(*الاتصال).العنوان_البعيد);
            ليكن الاستجابة: متغير استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(
                الحالة, الخدمة, &متغير الطلب, (*الاتصال).المفكك.الحدود.أقصى_زمن_معالج_بالمللي
            );
            ضع_إصدار_استجابة_ويب(&متغير الاستجابة, الطلب.الإصدار);
            // As the sequential server: a protocol switch or a stream queues
            // its head and waits for the hand-over (خطوة_اتصال_ويب).
            ليكن ينتقل: منطقي = هل_انتقال_بروتوكول_ويب(&الطلب, &الاستجابة);
            طابق *المسلم مع
            | اختياري.موجود(_) -> {
                إذا (ينتقل || هل_استجابة_متدفقة_ويب(&الاستجابة)) {
                    طابق سلسل_رأس_استجابة_ويب1_إلى(&الطلب, &الاستجابة, &متغير (*الاتصال).الصادر) مع
                    | نتيجة.خطأ(_) -> { (*الاتصال).يغلق := صواب; }
                    | نتيجة.نجح(_) -> {
                        ليكن المعلق: تسليم_معلق_ويب = { الطلب: الطلب, الاستجابة: الاستجابة };
                        (*الاتصال).التسليم := اختياري.موجود(المعلق);
                    };
                    أرجع;
                };
            }
            | اختياري.لا_شيء -> {
                إذا (ينتقل) {
                    (*الاتصال).يغلق := صواب;
                    أرجع;
                };
            };
            علم_إغلاق_عند_الإيقاف_ويب(&متغير الاستجابة);
            ليكن يبقى: منطقي = طبق_سياسة_اتصال_خادم_ويب1(&الطلب, &متغير الاستجابة);
            // Serialized straight into the connection's output buffer.
            طابق سلسل_استجابة_ويب1_لطلب_إلى(&الطلب, &الاستجابة, &متغير (*الاتصال).الصادر) مع
            | نتيجة.خطأ(_) -> { (*الاتصال).يغلق := صواب; }
            | نتيجة.نجح(_) -> {
                إذا (!يبقى) { (*الاتصال).يغلق := صواب; };
            };
        };
    }
}

// Feeds bytes read from the socket, watching the first 24 for the HTTP/2
// client preface; answers صواب when the connection is h2c.
عرف غذ_اتصالا_حدثيا(الاتصال: &متغير اتصال_حدثي_ويب, الجزء: &متجه ط8): منطقي {
    إذا (!(*الاتصال).يفحص_المقدمة) {
        غذ_مفكك_ويب1(&متغير (*الاتصال).المفكك, الجزء);
        أرجع خطأ;
    };
    ألحق_بايتات_حدثي(&متغير (*الاتصال).البداية, الجزء);
    إذا (!بادئة_ويب2_خادم(&(*الاتصال).البداية)) {
        (*الاتصال).يفحص_المقدمة := خطأ;
        ليكن البداية: متغير متجه ط8 = [];
        بدّل((*الاتصال).البداية, البداية);
        غذ_مفكك_ويب1(&متغير (*الاتصال).المفكك, &البداية);
        أرجع خطأ;
    };
    أرجع (الطول((*الاتصال).البداية) مثل طبيعي) >= 24;
}

// One step of a ready connection. At most 16 reads per event, so a client
// that keeps sending cannot hold a worker; it is re-armed and, still
// readable, comes back at once.
عرف خطوة_اتصال_ويب<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المخزن: &متغير متجه ط8,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): خطوة_اتصال_حدثي_ويب {
    ليكن ج: متغير اتصال_حدثي_ويب = الاتصال;
    ليكن القراءات: متغير عدد = 0;
    طالما (صواب) {
        أجب_طلبات_حدثية(&متغير ج, الحالة, الخدمة, المسلم);
        طابق ج.التسليم مع
        | اختياري.موجود(_) -> { أرجع خطوة_اتصال_حدثي_ويب.إلى_مسلم(ج); }
        | اختياري.لا_شيء -> { };
        إذا ((الطول(ج.الصادر) مثل طبيعي) > 0) {
            طابق أفرغ_صادر_حدثي(&متغير ج) مع
            | نتيجة_إفراغ_ويب.محجوب -> { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_الكتابة(ج); }
            | نتيجة_إفراغ_ويب.فشل -> { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); }
            | نتيجة_إفراغ_ويب.أفرغ -> { };
        };
        إذا (ج.يغلق) { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); };
        إذا (القراءات >= 16) { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج); };
        القراءات := القراءات + 1;
        طابق اقرأ_تي_سي_بي(&ج.التدفق, المخزن, 0, الطول(*المخزن) مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج); };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); };
        }
        | نتيجة.نجح(المقروء) -> {
            إذا (المقروء == 0) {
                // The client closed. A partial request is answered as the
                // sequential server answers it, best effort.
                إذا (بايتات_معلقة_في_مفكك_ويب1(&ج.المفكك) > 0) {
                    ليكن خطأ_النهاية: خطأ_ويب = خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), بايتات_معلقة_في_مفكك_ويب1(&ج.المفكك));
                    ليكن البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(&خطأ_النهاية);
                    ألحق_بايتات_حدثي(&متغير ج.الصادر, &البايتات);
                    ليكن تجاهل: نتيجة_إفراغ_ويب = أفرغ_صادر_حدثي(&متغير ج);
                };
                أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج);
            };
            ليكن الجزء: متجه ط8 = بايتات_مقروءة_خادم(&(*المخزن), المقروء مثل طبيعي);
            إذا (غذ_اتصالا_حدثيا(&متغير ج, &الجزء)) { أرجع خطوة_اتصال_حدثي_ويب.إلى_ويب2(ج); };
        };
    }
    أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج);
}

// The connection leaves the poller for the hand-over callback: it becomes
// blocking, its queued output (the response head) is written, and the
// callback receives it with the bytes read past the request.
عرف سلم_اتصالا_إلى_مسلم<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    ليكن ج: متغير اتصال_حدثي_ويب = الاتصال;
    ليكن الباقي: متغير متجه ط8 = [];
    بدّل(ج.المفكك.المخزن, الباقي);
    ليكن الصادر: متغير متجه ط8 = [];
    بدّل(ج.الصادر, الصادر);
    ليكن المرسل: طبيعي = ج.المرسل مثل طبيعي;
    ليكن التسليم: متغير اختياري تسليم_معلق_ويب = اختياري.لا_شيء();
    بدّل(ج.التسليم, التسليم);
    طابق ج مع
    | { التدفق: التدفق, المفكك: _, البداية: _, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: _, التسليم: _, الزمن: _ } -> {
        ليكن تجاهل_الحجب: نتيجة عدد, عدد = اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, خطأ);
        ليكن الناقل: ناقل_ويب = ناقل_ويب.تي_سي_بي(التدفق);
        ليكن الكل: طبيعي = الطول(الصادر) مثل طبيعي;
        إذا (المرسل < الكل) {
            ليكن المتبقي: متجه ط8 = انسخ_بايتات_ويب(&الصادر, المرسل, الكل - المرسل);
            طابق اكتب_الكل(&الناقل, اكتب_ناقل_ويب, &المتبقي) مع
            | نتيجة.خطأ(_) -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); أرجع; }
            | نتيجة.نجح(_) -> { };
        };
        طابق *المسلم مع
        | اختياري.لا_شيء -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); }
        | اختياري.موجود(المسلم_الفعلي) -> {
            طابق التسليم مع
            | اختياري.لا_شيء -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); }
            | اختياري.موجود(المعلق) -> {
                المسلم_الفعلي(الحالة, &المعلق.الطلب, &المعلق.الاستجابة, الناقل, الباقي);
            };
        };
    };
}

// The connection leaves the poller for the blocking HTTP/2 server, each of
// its reads and writes bounded by the body timeout.
عرف سلم_اتصالا_إلى_ويب2<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المهل: &مهل_اتصال_ويب
): فراغ {
    طابق الاتصال مع
    | { التدفق: التدفق, المفكك: _, البداية: البداية, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: العنوان, التسليم: _, الزمن: _ } -> {
        ليكن تجاهل_الحجب: نتيجة عدد, عدد = اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, خطأ);
        ليكن حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
        ليكن الناقل: ناقل_ويب = ناقل_ويب2_بمهلة(ناقل_ويب.تي_سي_بي(التدفق), المهل);
        ليكن تجاهل: نتيجة عدد, خطأ_ويب2 = خدم_اتصال_ويب2_من(الناقل, البداية, &حدود2, الحالة, الخدمة, العنوان);
    };
}

عرف اتصال_حدثي_جديد(التدفق: تدفق_تي_سي_بي, الحدود: &حدود_ويب, المهل: &مهل_اتصال_ويب): اتصال_حدثي_ويب {
    ليكن العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    ليكن الناتج: اتصال_حدثي_ويب = {
        التدفق: التدفق,
        المفكك: مفكك_ويب1_جديد(*الحدود),
        البداية: [],
        يفحص_المقدمة: صواب,
        الصادر: [],
        المرسل: 0,
        يغلق: خطأ,
        العنوان_البعيد: العنوان,
        التسليم: اختياري.لا_شيء(),
        الزمن: حالة_مهلة_جديدة_ويب1(المهل, الآن_خادم_ويب())
    };
    أرجع الناتج;
}

// Accepts until accept would block, registers each connection, re-arms the
// listener. A failure other than "would block" (EMFILE, ENOBUFS, ...)
// pauses 1 ms so a full descriptor table does not spin the worker.
عرف اقبل_اتصالات_حدثية(السياق: &سياق_خادم_حدثي_ويب): فراغ {
    طالما (صواب) {
        طابق اقبل_تي_سي_بي(&(*السياق).المستمع) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (!هل_خطأ_سيحظر(الخطأ) && !هل_خطأ_مقاطعة(الخطأ)) {
                ليكن تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000);
            };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) {
                ليكن تجاهل: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(
                    &(*السياق).المستطلع, واصف_مستمع_تي_سي_بي(&(*السياق).المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()
                );
                أرجع;
            };
        }
        | نتيجة.نجح(التدفق) -> { سلم_تدفقا_لسياق_حدثي(السياق, التدفق); };
    }
}

// Puts an accepted connection in a worker's table and poller (from that
// worker, or from the acceptor thread: the table is locked and a poller
// takes registrations from any thread). A full table answers 503 and closes
// the connection.
عرف سلم_تدفقا_لسياق_حدثي(السياق: &سياق_خادم_حدثي_ويب, التدفق: تدفق_تي_سي_بي): فراغ {
    إذا ((*السياق).السعة != 0 && عدد_اتصالات_سياق_حدثي(السياق) >= (*السياق).السعة) {
        ارفض_اتصالا_ممتلئا_ويب(التدفق);
        أرجع;
    };
    ليكن الواصف: عدد = واصف_تدفق_تي_سي_بي(&التدفق);
    طابق اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, صواب) مع
    | نتيجة.خطأ(_) -> { ليكن تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق); }
    | نتيجة.نجح(_) -> {
        ليكن الاتصال: اتصال_حدثي_ويب = اتصال_حدثي_جديد(التدفق, &(*السياق).الحدود, &(*السياق).المهل);
        ليكن الموضع: طبيعي = أدخل_اتصالا_حدثيا(&(*السياق).الجدول, الاتصال);
        طابق سجل_في_مستطلع(&(*السياق).المستطلع, الواصف, (الموضع + 1) مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> {
            طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
            | اختياري.موجود(المرفوض) -> { أغلق_اتصالا_حدثيا(المرفوض); }
            | اختياري.لا_شيء -> { };
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
        };
    };
}

// Open connections in a worker's table.
عرف عدد_اتصالات_سياق_حدثي(السياق: &سياق_خادم_حدثي_ويب): طبيعي {
    اقفل_خام(&(*السياق).الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(&(*السياق).الجدول);
    ليكن العدد: متغير طبيعي = 0;
    غير_آمن {
        العدد := (الطول((*المؤشر).الخانات) مثل طبيعي) - (الطول((*المؤشر).الحرة) مثل طبيعي);
    }
    افتح_خام(&(*السياق).الجدول);
    أرجع العدد;
}

عرف خدم_حدث_اتصال<S>(
    السياق: &سياق_خادم_حدثي_ويب,
    الموضع: طبيعي,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المخزن: &متغير متجه ط8,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاتصال) -> {
        ليكن الواصف: عدد = واصف_تدفق_تي_سي_بي(&الاتصال.التدفق);
        ليكن الرمز: ط64 = (الموضع + 1) مثل ط64;
        طابق خطوة_اتصال_ويب(الاتصال, الحالة, الخدمة, المخزن, المسلم) مع
        | خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج) -> {
            ليكن المنتظر: متغير اتصال_حدثي_ويب = ج;
            حدث_مهلة_قراءة_حدثي(&متغير المنتظر, &(*السياق).المهل);
            أعد_اتصالا_حدثيا(&(*السياق).الجدول, الموضع, المنتظر);
            طابق أعد_تسليح_في_مستطلع(&(*السياق).المستطلع, الواصف, الرمز, اهتمام_مستطلع.قراءة()) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> { أنه_خانة_حدثية(السياق, الموضع); };
        }
        | خطوة_اتصال_حدثي_ويب.ينتظر_الكتابة(ج) -> {
            // The client has to take the response within the body timeout.
            ليكن المنتظر: متغير اتصال_حدثي_ويب = ج;
            المنتظر.الزمن.خامل := خطأ;
            المنتظر.الزمن.المهلة := أضف_مهلة_ويب(الآن_خادم_ويب(), (*السياق).المهل.الجسم);
            أعد_اتصالا_حدثيا(&(*السياق).الجدول, الموضع, المنتظر);
            طابق أعد_تسليح_في_مستطلع(&(*السياق).المستطلع, الواصف, الرمز, اهتمام_مستطلع.كتابة()) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> { أنه_خانة_حدثية(السياق, الموضع); };
        }
        | خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج) -> {
            أغلق_اتصالا_حدثيا(ج);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
        }
        | خطوة_اتصال_حدثي_ويب.إلى_مسلم(ج) -> {
            ليكن تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, الواصف);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
            سلم_اتصالا_إلى_مسلم(ج, الحالة, المسلم);
        }
        | خطوة_اتصال_حدثي_ويب.إلى_ويب2(ج) -> {
            ليكن تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, الواصف);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
            سلم_اتصالا_إلى_ويب2(ج, الحالة, الخدمة, &(*السياق).المهل);
        };
    };
}

// A re-arm failed after the connection went back: take it out and close it.
عرف أنه_خانة_حدثية(السياق: &سياق_خادم_حدثي_ويب, الموضع: طبيعي): فراغ {
    طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
    | اختياري.موجود(ج) -> { أغلق_اتصالا_حدثيا(ج); }
    | اختياري.لا_شيء -> { };
    حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
}

// The deadline of a connection that waits to read (مهلة_القراءة_التالية_ويب1
// over the bytes it holds).
عرف حدث_مهلة_قراءة_حدثي(الاتصال: &متغير اتصال_حدثي_ويب, المهل: &مهل_اتصال_ويب): فراغ {
    ليكن الآن: عدد = الآن_خادم_ويب();
    ليكن الزمن: متغير حالة_مهلة_ويب1 = (*الاتصال).الزمن;
    إذا ((*الاتصال).يفحص_المقدمة) {
        ليكن تجاهل_المهلة: عدد = مهلة_القراءة_التالية_ويب1(&متغير الزمن, المهل, &(*الاتصال).البداية, الآن);
    } وإلا {
        ليكن تجاهل_المهلة: عدد = مهلة_القراءة_التالية_ويب1(&متغير الزمن, المهل, &(*الاتصال).المفكك.المخزن, الآن);
    };
    (*الاتصال).الزمن := الزمن;
}

// Part of a request read, and no response left to send: a connection
// closed for its deadline is answered 408.
عرف طلب_جزئي_حدثي(الاتصال: &اتصال_حدثي_ويب): منطقي {
    إذا ((*الاتصال).المرسل < (الطول((*الاتصال).الصادر) مثل عدد)) { أرجع خطأ; };
    إذا ((*الاتصال).يفحص_المقدمة) { أرجع (الطول((*الاتصال).البداية) مثل طبيعي) > 0; };
    أرجع بايتات_معلقة_في_مفكك_ويب1(&(*الاتصال).المفكك) > 0;
}

// Takes every connection in the table whose deadline has passed out of it,
// and closes it (its descriptor leaves the poller first): with a 408,
// written without waiting, when part of a request was read; silently when
// it was idle. A connection a worker is serving is not in the table.
عرف اكنس_المنتهية_حدثيا(السياق: &سياق_خادم_حدثي_ويب, الآن: عدد): فراغ {
    ليكن المنتهية: متغير متجه اتصال_حدثي_ويب = [];
    اقفل_خام(&(*السياق).الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(&(*السياق).الجدول);
    غير_آمن {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*المؤشر).الخانات) مثل طبيعي)) {
            ليكن الخانة: متغير اختياري اتصال_حدثي_ويب = اختياري.لا_شيء();
            بدّل((*المؤشر).الخانات[ف], الخانة);
            طابق الخانة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ج) -> {
                إذا (ج.الزمن.المهلة != 0 && الآن >= ج.الزمن.المهلة) {
                    ألحق(المنتهية, ج);
                    ألحق((*المؤشر).الحرة, ف مثل ط32);
                } وإلا {
                    ليكن المعادة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(ج);
                    بدّل((*المؤشر).الخانات[ف], المعادة);
                };
            };
            ف := ف + 1;
        }
    }
    افتح_خام(&(*السياق).الجدول);
    طالما ((الطول(المنتهية) مثل طبيعي) > 0) {
        طابق أزل_الأخير(المنتهية) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(ج) -> {
            ليكن المنتهي: متغير اتصال_حدثي_ويب = ج;
            ليكن تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, واصف_تدفق_تي_سي_بي(&المنتهي.التدفق));
            إذا (طلب_جزئي_حدثي(&المنتهي)) {
                اقتطع(المنتهي.الصادر, 0);
                المنتهي.المرسل := 0;
                ليكن البايتات: متجه ط8 = بايتات_انتهاء_مهلة_طلب_خادم();
                ألحق_بايتات_حدثي(&متغير المنتهي.الصادر, &البايتات);
                ليكن تجاهل_الإفراغ: نتيجة_إفراغ_ويب = أفرغ_صادر_حدثي(&متغير المنتهي);
            };
            أغلق_اتصالا_حدثيا(المنتهي);
        };
    }
}

// Between requests: no partial request read, no response left to send and
// no HTTP/2 preface half read.
عرف اتصال_حدثي_خامل(الاتصال: &اتصال_حدثي_ويب): منطقي {
    إذا ((الطول((*الاتصال).المفكك.المخزن) مثل طبيعي) != 0) { أرجع خطأ; };
    إذا ((*الاتصال).يفحص_المقدمة && (الطول((*الاتصال).البداية) مثل طبيعي) != 0) { أرجع خطأ; };
    أرجع (*الاتصال).المرسل >= (الطول((*الاتصال).الصادر) مثل عدد);
}

// During a shutdown (http.shutdown): takes every idle connection (every
// connection when الكل) out of the table and closes it, and answers how many
// connections are still open, including those another worker is serving.
عرف أغلق_الخاملة_حدثيا(السياق: &سياق_خادم_حدثي_ويب, الكل: منطقي): طبيعي {
    ليكن المغلقة: متغير متجه اتصال_حدثي_ويب = [];
    ليكن الباقية: متغير طبيعي = 0;
    اقفل_خام(&(*السياق).الجدول);
    ليكن المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(&(*السياق).الجدول);
    غير_آمن {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*المؤشر).الخانات) مثل طبيعي)) {
            ليكن الخانة: متغير اختياري اتصال_حدثي_ويب = اختياري.لا_شيء();
            بدّل((*المؤشر).الخانات[ف], الخانة);
            طابق الخانة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ج) -> {
                إذا (الكل || اتصال_حدثي_خامل(&ج)) {
                    ألحق(المغلقة, ج);
                    ألحق((*المؤشر).الحرة, ف مثل ط32);
                } وإلا {
                    ليكن المعادة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(ج);
                    بدّل((*المؤشر).الخانات[ف], المعادة);
                };
            };
            ف := ف + 1;
        }
        الباقية := (الطول((*المؤشر).الخانات) مثل طبيعي) - (الطول((*المؤشر).الحرة) مثل طبيعي);
    }
    افتح_خام(&(*السياق).الجدول);
    طالما ((الطول(المغلقة) مثل طبيعي) > 0) {
        طابق أزل_الأخير(المغلقة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(ج) -> {
            ليكن تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, واصف_تدفق_تي_سي_بي(&ج.التدفق));
            أغلق_اتصالا_حدثيا(ج);
        };
    }
    أرجع الباقية;
}

عرف عامل_خادم_حدثي<S>(
    السياق: مشترك<سياق_خادم_حدثي_ويب>,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): فراغ {
    ليكن س: &سياق_خادم_حدثي_ويب = اقرأ_مشترك(&السياق);
    ليكن ح: &S = اقرأ_مشترك(&الحالة);
    ليكن الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(64);
    ليكن المخزن: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(المخزن, 0); ف := ف + 1; }
    // A shutdown (http.shutdown) is noticed within one 200 ms wait: the
    // listener is no longer accepted from (its one-shot interest is not
    // re-armed), idle connections are closed at every turn, and the worker
    // returns when none is left or the grace period has passed.
    ليكن ينهي: متغير منطقي = خطأ;
    ليكن المهلة_النهائية: متغير عدد = 0;
    // Expired connections are swept at most every 100 ms (the wait below
    // lasts at most 200 ms).
    ليكن آخر_كنس: متغير عدد = 0;
    طالما (صواب) {
        ليكن الآن_الكنس: عدد = الآن_خادم_ويب();
        إذا (الآن_الكنس - آخر_كنس >= 100000000) {
            آخر_كنس := الآن_الكنس;
            اكنس_المنتهية_حدثيا(س, الآن_الكنس);
        };
        إذا (هل_طلب_إيقاف_الويب()) {
            ليكن الآن: متغير عدد = 0;
            طابق وقت_رتيب_نانو() مع
            | نتيجة.نجح(ن) -> { الآن := ن; }
            | نتيجة.خطأ(_) -> { };
            إذا (!ينهي) {
                ينهي := صواب;
                المهلة_النهائية := الآن + مهلة_إيقاف_الويب_بالثواني() * 1000000000;
            };
            إذا (الآن >= المهلة_النهائية) { علّم_انتهاء_مهلة_إيقاف_الويب(); };
            إذا (أغلق_الخاملة_حدثيا(س, الآن >= المهلة_النهائية) == 0) { أرجع; };
        };
        طابق انتظر_مستطلع(&(*س).المستطلع, &متغير الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { ليكن تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000); }
        | نتيجة.نجح(العدد) -> {
            ليكن ك: متغير طبيعي = 0;
            طالما (ك < العدد) {
                ليكن الحدث: حدث_مستطلع = حدث_مستطلع_عند(&الأحداث, ك);
                إذا (الحدث.الرمز == (0 مثل ط64)) { إذا (!ينهي) { اقبل_اتصالات_حدثية(س); }; }
                وإلا { خدم_حدث_اتصال(س, (الحدث.الرمز - 1) مثل طبيعي, ح, الخدمة, &متغير المخزن, &المسلم); };
                ك := ك + 1;
            }
        };
    }
}

// The event-driven HTTP server (HTTP/1, and h2c by prior knowledge): the
// state is shared by every worker thread through an Arc. الخيوط 0 uses the available parallelism. It returns
// only on a setup failure.
عام عرف شغل_خادم_ويب_بأحداث<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    أرجع شغل_خادم_ويب_بأحداث_داخلي(الإعداد, الحالة, الخدمة, الخيوط, بلا_تسليم);
}

// As شغل_خادم_ويب_بأحداث, handing protocol switches and streamed responses
// to المسلم after their head (http.handover). The callback runs on the
// worker thread that served the request.
عام عرف شغل_خادم_ويب_بأحداث_مع_تسليم<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    أرجع شغل_خادم_ويب_بأحداث_داخلي(الإعداد, الحالة, الخدمة, الخيوط, مع_تسليم);
}

// A worker's listener, poller and connection table. With a balancing
// SO_REUSEPORT (Linux, FreeBSD) every worker binds its own listener on the
// address and owns its own context: no table or poller is shared between
// threads (shard-per-core, as nginx's reuseport).
// Elsewhere (macOS) one acceptor hands connections to the workers
// (شغل_خادم_ويب_بموزع).
عرف أنشئ_سياق_حدثي_ويب(
    الإعداد: &إعداد_خادم_ويب,
    منفذ_مشترك: منطقي,
    السعة: طبيعي
): نتيجة سياق_خادم_حدثي_ويب, خطأ_خادم_ويب {
    ليكن المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_حدثي_ويب(الإعداد, منفذ_مشترك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    ليكن واصف_المستمع: عدد = واصف_مستمع_تي_سي_بي(&المستمع);
    ليكن المهل: مهل_اتصال_ويب = مهل_من_إعداد_ويب(الإعداد);
    طابق سياق_حدثي_لمستمع_ويب(المستمع, &(*الإعداد).الحدود, &المهل, السعة, منفذ_مشترك, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(السياق) -> { أرجع نتيجة.نجح(السياق); };
}

// Closes a shard that no worker will serve: its listener and its poller's
// descriptor.
عرف أغلق_شظية_حدثية_ويب(الشظية: &مشترك<سياق_خادم_حدثي_ويب>): فراغ {
    ليكن السياق: &سياق_خادم_حدثي_ويب = اقرأ_مشترك(الشظية);
    ليكن تجاهل_المستمع: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_مستمع_تي_سي_بي(&(*السياق).المستمع));
    ليكن تجاهل_المستطلع: عدد = أغلق_مقبس_تي_سي_بي_خام((*السياق).المستطلع.الواصف);
}

// A worker's share of أقصى_الاتصالات (rounded up; 0: no limit).
عرف سعة_عامل_حدثي_ويب(الإعداد: &إعداد_خادم_ويب, العدد: طبيعي): طبيعي {
    ليكن الأقصى: طبيعي = (*الإعداد).أقصى_الاتصالات;
    إذا (الأقصى == 0 || العدد <= 1) { أرجع الأقصى; };
    أرجع (الأقصى + العدد - 1) / العدد;
}

// The configured address's port (0 when it does not parse).
عرف منفذ_إعداد_ويب(الإعداد: &إعداد_خادم_ويب): ط16 {
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.نجح(العنوان) -> { أرجع منفذ_عنوان_مقبس(&العنوان); }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// Whether a server already listens on the configured address: a TCP
// connection to it (through loopback for an unspecified address) is accepted.
عرف عنوان_إعداد_يستمع_ويب(الإعداد: &إعداد_خادم_ويب): منطقي {
    ليكن العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; }
    | نتيجة.خطأ(_) -> { أرجع صواب; };
    إذا (هل_عنوان_آيبي_غير_محدد(&العنوان.الآيبي)) {
        طابق العنوان.الآيبي مع
        | عنوان_آيبي.رابع(_) -> {
            العنوان := أنشئ_عنوان_مقبس(عنوان_آيبي.رابع(أنشئ_عنوان_آيبي4(127, 0, 0, 1)), العنوان.المنفذ);
        }
        | عنوان_آيبي.سادس(_) -> {
            ليكن المقاطع: متجه ط16 = [0, 0, 0, 0, 0, 0, 0, 1];
            طابق أنشئ_عنوان_آيبي6(المقاطع) مع
            | نتيجة.نجح(الحلقة) -> { العنوان := أنشئ_عنوان_مقبس(عنوان_آيبي.سادس(الحلقة), العنوان.المنفذ); }
            | نتيجة.خطأ(_) -> { };
        };
    };
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.نجح(التدفق) -> {
        ليكن تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
        أرجع صواب;
    }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// The configured address bound and listening, non-blocking.
عرف اربط_مستمع_حدثي_ويب(
    الإعداد: &إعداد_خادم_ويب,
    منفذ_مشترك: منطقي
): نتيجة مستمع_تي_سي_بي, خطأ_خادم_ويب {
    ليكن العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    ليكن الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    إذا (منفذ_مشترك) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_المنفذ(صواب)); };
    ليكن المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(المستمع);
}

// A worker context around a listener: its own poller (with the listener at
// token 0, one-shot, when يسجل_المستمع) and its own connection table. حلقي asks for an
// io_uring poller where the kernel allows it (os.poll أنشئ_مستطلع_حلقي;
// SULTANC_IO_URING=0 keeps epoll), else epoll or kqueue.
عرف سياق_حدثي_لمستمع_ويب(
    المستمع: مستمع_تي_سي_بي,
    الحدود: &حدود_ويب,
    المهل: &مهل_اتصال_ويب,
    السعة: طبيعي,
    حلقي: منطقي,
    يسجل_المستمع: منطقي
): نتيجة سياق_خادم_حدثي_ويب, خطأ_خادم_ويب {
    ليكن المستطلع: مستطلع;
    ليكن ناتج_المستطلع: نتيجة مستطلع, عدد;
    إذا (حلقي) { ناتج_المستطلع := أنشئ_مستطلع_حلقي(); } وإلا { ناتج_المستطلع := أنشئ_مستطلع(); };
    طابق ناتج_المستطلع مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(ب) -> { المستطلع := ب; };
    إذا (يسجل_المستمع) {
        طابق سجل_في_مستطلع(&المستطلع, واصف_مستمع_تي_سي_بي(&المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.خطأ(الخطأ) -> {
            ليكن تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
            أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
        }
        | نتيجة.نجح(_) -> { };
    };
    ليكن الجدول: جدول_اتصالات_ويب = { الخانات: [], الحرة: [] };
    ليكن السياق: سياق_خادم_حدثي_ويب = {
        المستطلع: المستطلع,
        المستمع: المستمع,
        الجدول: أنشئ_قفل(الجدول),
        الحدود: *الحدود,
        المهل: *المهل,
        السعة: السعة
    };
    أرجع نتيجة.نجح(السياق);
}

عرف شغل_خادم_ويب_بأحداث_داخلي<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    إذا (!هل_المستطلع_مدعوم()) {
        أرجع شغل_خادم_ويب(الإعداد, اقرأ_مشترك(&الحالة), الخدمة);
    };
    ليكن العدد: متغير طبيعي = الخيوط;
    إذا (العدد == 0) {
        طابق عدد_المعالجات_المتاحة() مع
        | نتيجة.نجح(ن) -> { العدد := ن; }
        | نتيجة.خطأ(_) -> { العدد := 1; };
    };
    إذا (العدد == 0) { العدد := 1; };
    ليكن السعة: طبيعي = سعة_عامل_حدثي_ويب(الإعداد, العدد);
    ليكن شظايا: متغير منطقي = العدد > 1 && توزيع_المنفذ_مدعوم_ويب();
    // Port 0: every shard would bind its own ephemeral port, so one
    // listener and the acceptor instead.
    إذا (شظايا && منفذ_إعداد_ويب(الإعداد) == 0) { شظايا := خطأ; };
    إذا (العدد > 1 && !شظايا) {
        أرجع شغل_خادم_ويب_بموزع(الإعداد, الحالة, الخدمة, العدد, المسلم);
    };
    // Shards bind with SO_REUSEPORT, which would also let them join the
    // listeners of another process on the same address (a second copy of
    // this server), splitting its connections. First the address must be
    // free: a bind without SO_REUSEPORT fails there with "address already in
    // use", as most servers fail by default.
    // A refused plain bind can also mean only connections a previous run
    // left in TIME_WAIT (they keep SO_REUSEPORT, which a plain bind does not
    // pass): then a connection to the address is refused, and the shards
    // bind as before.
    إذا (شظايا) {
        طابق اربط_مستمع_حدثي_ويب(الإعداد, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (عنوان_إعداد_يستمع_ويب(الإعداد)) { أرجع نتيجة.خطأ(الخطأ); };
        }
        | نتيجة.نجح(المسبار) -> {
            ليكن تجاهل_المسبار: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المسبار);
        };
    };
    ليكن الأول: سياق_خادم_حدثي_ويب;
    طابق أنشئ_سياق_حدثي_ويب(الإعداد, شظايا, السعة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(س) -> { الأول := س; };
    ليكن السياق: مشترك<سياق_خادم_حدثي_ويب> = أنشئ_مشترك(الأول);
    // العدد - 1 extra workers; this thread is the last one. After a shutdown
    // (http.shutdown) every worker returns; they are joined before this does.
    ليكن العمال: متغير متجه مقبض_خيط = [];
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        // Each shard binds its own listener and owns its poller and table;
        // its accept loop drains the listener until it would block. A
        // worker whose shard cannot be made shares the first one.
        ليكن سياقه: متغير مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&السياق);
        ليكن شظية_جديدة: متغير منطقي = خطأ;
        إذا (شظايا) {
            طابق أنشئ_سياق_حدثي_ويب(الإعداد, صواب, السعة) مع
            | نتيجة.خطأ(_) -> { }
            | نتيجة.نجح(س) -> { سياقه := أنشئ_مشترك(س); شظية_جديدة := صواب; };
        };
        ليكن شظيته: مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&سياقه);
        ليكن حالته: مشترك<S> = استنسخ_مشترك(&الحالة);
        ليكن مسلمه: اختياري مسلم_اتصال_ويب<S> = المسلم;
        طابق أطلق(دالة(): فراغ -> عامل_خادم_حدثي(سياقه, حالته, الخدمة, مسلمه)) مع
        | نتيجة.خطأ(_) -> {
            // No thread for this shard (none can start under the
            // interpreter, or the system refused one): its listener is
            // already bound with SO_REUSEPORT, and the kernel would hand it
            // connections nobody accepts, so it is closed with its poller.
            إذا (شظية_جديدة) { أغلق_شظية_حدثية_ويب(&شظيته); };
            ف := العدد;
        }
        | نتيجة.نجح(المقبض) -> { ألحق(العمال, المقبض); };
        ف := ف + 1;
    }
    عامل_خادم_حدثي(السياق, الحالة, الخدمة, المسلم);
    طالما ((الطول(العمال) مثل طبيعي) > 0) {
        طابق أزل_الأخير(العمال) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            ليكن المنضم: متغير مقبض_خيط = المقبض;
            انضم(&متغير المنضم);
        };
    }
    أرجع نتيجة.نجح(0);
}

// Without a balancing SO_REUSEPORT (macOS): one listener, and a worker that
// accepted until "would block" would take a whole burst of connections and
// leave the other workers idle. So, as libuv's acceptor, this
// thread only accepts: each connection goes to the worker with the fewest
// open connections (ties in turn), into that worker's own table and poller,
// and stays there. The workers never watch the listener: no wake-up herd,
// and after the hand-over a connection touches only its worker's poller
// and lock. The acceptor waits at most 200 ms at a time, so it sees a
// shutdown request (http.shutdown), stops accepting, joins the workers and
// closes the listener.
عرف شغل_خادم_ويب_بموزع<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    العدد: طبيعي,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    ليكن المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_حدثي_ويب(الإعداد, خطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    ليكن واصف_المستمع: عدد = واصف_مستمع_تي_سي_بي(&المستمع);
    // The acceptor's own poller, with the listener at token 0.
    ليكن المستطلع: مستطلع;
    طابق أنشئ_مستطلع() مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(ب) -> { المستطلع := ب; };
    طابق سجل_في_مستطلع(&المستطلع, واصف_المستمع, 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
    | نتيجة.خطأ(الخطأ) -> {
        ليكن تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
        ليكن تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    // One context per worker; the listener box each holds is never used.
    // The acceptor hands a connection to the least loaded worker, so a
    // connection is refused only when every table holds its share.
    ليكن السياقات: متغير متجه مشترك<سياق_خادم_حدثي_ويب> = [];
    ليكن المهل: مهل_اتصال_ويب = مهل_من_إعداد_ويب(الإعداد);
    ليكن السعة: طبيعي = سعة_عامل_حدثي_ويب(الإعداد, العدد);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن غير_مستخدم: مستمع_تي_سي_بي = صندوق واصف_المستمع;
        طابق سياق_حدثي_لمستمع_ويب(غير_مستخدم, &(*الإعداد).الحدود, &المهل, السعة, خطأ, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا ((الطول(السياقات) مثل طبيعي) == 0) {
                ليكن تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
                ليكن تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
                أرجع نتيجة.خطأ(الخطأ);
            };
            ف := العدد;
        }
        | نتيجة.نجح(س) -> { ألحق(السياقات, أنشئ_مشترك(س)); };
        ف := ف + 1;
    }
    ليكن العمال: متغير متجه مقبض_خيط = [];
    ليكن الجاهزة: متغير متجه مشترك<سياق_خادم_حدثي_ويب> = [];
    ف := 0;
    طالما (ف < (الطول(السياقات) مثل طبيعي)) {
        ليكن سياقه: مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&السياقات[ف]);
        ليكن حالته: مشترك<S> = استنسخ_مشترك(&الحالة);
        ليكن مسلمه: اختياري مسلم_اتصال_ويب<S> = المسلم;
        طابق أطلق(دالة(): فراغ -> عامل_خادم_حدثي(سياقه, حالته, الخدمة, مسلمه)) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(المقبض) -> {
            ألحق(العمال, المقبض);
            ألحق(الجاهزة, استنسخ_مشترك(&السياقات[ف]));
        };
        ف := ف + 1;
    }
    إذا ((الطول(الجاهزة) مثل طبيعي) == 0) {
        // No worker thread could start: serve on this thread instead.
        ليكن تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
        ليكن تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع شغل_خادم_ويب(الإعداد, اقرأ_مشترك(&الحالة), الخدمة);
    };
    ليكن الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(4);
    ليكن الدور: متغير طبيعي = 0;
    طالما (!هل_طلب_إيقاف_الويب()) {
        طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { ليكن تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000); }
        | نتيجة.نجح(_) -> { };
        // Accept until "would block" (also after a timeout: a missed
        // readiness costs nothing), then re-arm the one-shot listener.
        ليكن يقبل: متغير منطقي = صواب;
        طالما (يقبل) {
            طابق اقبل_تي_سي_بي(&المستمع) مع
            | نتيجة.خطأ(الخطأ) -> {
                // EMFILE, ENOBUFS, ...: pause 1 ms rather than spin.
                إذا (!هل_خطأ_سيحظر(الخطأ) && !هل_خطأ_مقاطعة(الخطأ)) {
                    ليكن تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000);
                };
                إذا (!هل_خطأ_مقاطعة(الخطأ)) { يقبل := خطأ; };
            }
            | نتيجة.نجح(التدفق) -> {
                ليكن العامل: طبيعي = أقل_العمال_حملا(&الجاهزة, الدور);
                الدور := الدور + 1;
                سلم_تدفقا_لسياق_حدثي(اقرأ_مشترك(&الجاهزة[العامل]), التدفق);
            };
        }
        ليكن تجاهل_التسليح: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(
            &المستطلع, واصف_المستمع, 0 مثل ط64, اهتمام_مستطلع.قراءة()
        );
    }
    طالما ((الطول(العمال) مثل طبيعي) > 0) {
        طابق أزل_الأخير(العمال) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            ليكن المنضم: متغير مقبض_خيط = المقبض;
            انضم(&متغير المنضم);
        };
    }
    ليكن تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
    ليكن تجاهل_المستمع: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
    أرجع نتيجة.نجح(0);
}

// The worker with the fewest open connections, scanning from الدور so equal
// loads take turns.
عرف أقل_العمال_حملا(السياقات: &متجه مشترك<سياق_خادم_حدثي_ويب>, الدور: طبيعي): طبيعي {
    ليكن العدد: طبيعي = الطول(*السياقات) مثل طبيعي;
    ليكن الأفضل: متغير طبيعي = الدور % العدد;
    ليكن أقل_حمل: متغير طبيعي = عدد_اتصالات_سياق_حدثي(اقرأ_مشترك(&(*السياقات)[الأفضل]));
    ليكن ك: متغير طبيعي = 1;
    طالما (ك < العدد && أقل_حمل > 0) {
        ليكن ف: طبيعي = (الدور + ك) % العدد;
        ليكن الحمل: طبيعي = عدد_اتصالات_سياق_حدثي(اقرأ_مشترك(&(*السياقات)[ف]));
        إذا (الحمل < أقل_حمل) { الأفضل := ف; أقل_حمل := الحمل; };
        ك := ك + 1;
    }
    أرجع الأفضل;
}

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    عرف توزيع_المنفذ_مدعوم_ويب(): منطقي { أرجع صواب; }
}
إذا (!((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve»)) {
    عرف توزيع_المنفذ_مدعوم_ويب(): منطقي { أرجع خطأ; }
}

