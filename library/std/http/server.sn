عام نوع إعداد_خادم_ويب = {
    العنوان: نص,
    التراكم: عدد,
    الحدود: حدود_ويب,
    إعادة_استخدام_العنوان: منطقي
};

عام نوع خطأ_خادم_ويب =
    | عنوان_غير_صالح
    | شبكة بنوع عدد
    | بروتوكول بنوع خطأ_ويب
    | انتقال_بروتوكول_غير_مدعوم
    | ويب2 بنوع خطأ_ويب2
;

عام عرف إعداد_خادم_ويب_افتراضي(العنوان: &نص): إعداد_خادم_ويب {
    دع الإعداد: إعداد_خادم_ويب = {
        العنوان: انسخ_نص(العنوان),
        التراكم: 128,
        الحدود: حدود_ويب_افتراضية(),
        إعادة_استخدام_العنوان: صواب
    };
    أرجع الإعداد;
}

عرف بايتات_مقروءة_خادم(المخزن: &متجه ط8, العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (ف < (الطول(*المخزن) مثل طبيعي))) { ألحق(الناتج, (*المخزن)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف حالة_خطأ_خادم_ويب(الخطأ: &خطأ_ويب): طبيعي {
    طابق (*الخطأ).الصنف مع
    | صنف_خطأ_ويب.جسم_كبير -> { أرجع 413; }
    | صنف_خطأ_ويب.قسم_رؤوس_كبير -> { أرجع 431; }
    | صنف_خطأ_ويب.رؤوس_كثيرة -> { أرجع 431; }
    | صنف_خطأ_ويب.إصدار_غير_مدعوم -> { أرجع 505; }
    | _ -> { أرجع 400; };
}

// The bytes of the "connection: close" error response for a protocol error
// (empty if it cannot be serialized).
عرف بايتات_خطأ_بروتوكول_خادم(الخطأ: &خطأ_ويب): متجه ط8 {
    دع النص: نص = «Bad HTTP request\n»;
    دع الاستجابة: متغير استجابة_ويب_مخزنة = استجابة_نص_ويب(حالة_خطأ_خادم_ويب(الخطأ), &النص);
    دع اسم_الاتصال: نص = «connection»;
    دع close: نص = «close»;
    دع تجاهل_رأس: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &اسم_الاتصال, &close);
    طابق سلسل_استجابة_ويب1(&الاستجابة) مع
    | نتيجة.خطأ(_) -> { دع فارغ: متجه ط8 = []; أرجع فارغ; }
    | نتيجة.نجح(البايتات) -> { أرجع البايتات; };
}

عرف أرسل_خطأ_بروتوكول_خادم(التدفق: &ناقل_ويب, الخطأ: &خطأ_ويب): فراغ {
    دع البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(الخطأ);
    إذا ((الطول(البايتات) مثل طبيعي) == 0) { أرجع; };
    دع تجاهل_كتابة: نتيجة طبيعي, عدد = اكتب_الكل(التدفق, اكتب_ناقل_ويب, &البايتات);
}

// Whether البايتات can still be, or already are, the HTTP/2 client preface
// (RFC 9113 3.4); the server then switches to h2c with prior knowledge.
عرف بادئة_ويب2_خادم(البايتات: &متجه ط8): منطقي {
    دع المقدمة: متجه ط8 = مقدمة_ويب2();
    دع ف: متغير طبيعي = 0;
    طالما (ف < 24 && ف < (الطول(*البايتات) مثل طبيعي)) {
        إذا ((*البايتات)[ف] != المقدمة[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Sequential HTTP/1 connection owner. It consumes and closes the transport.
// A connection that starts with the HTTP/2 preface is handed to the HTTP/2
// server (h2c with prior knowledge).
عرف خدم_اتصال_ويب1<S>(
    التدفق: ناقل_ويب,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    العنوان_البعيد: نص,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    دع المفكك: متغير مفكك_ويب1 = مفكك_ويب1_جديد(*الحدود);
    دع البداية: متغير متجه ط8 = [];
    دع يفحص_المقدمة: متغير منطقي = صواب;
    دع مخزن_قراءة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(مخزن_قراءة, 0); ف := ف + 1; }
    دع عدد_الطلبات: متغير عدد = 0;
    دع مستمر: متغير منطقي = صواب;
    // One output buffer for the connection, reused by every response.
    دع المرسل: متغير متجه ط8 = [];
    طالما (مستمر) {
        طابق التالي_من_مفكك_ويب1(&متغير المفكك) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرسل_خطأ_بروتوكول_خادم(&التدفق, &الخطأ);
            دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
            أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
        }
        | نتيجة.نجح(اختياري.موجود(المحلل)) -> {
            دع الطلب: متغير طلب_ويب_مخزن = خذ_طلب_محلل_ويب(المحلل);
            الطلب.العنوان_البعيد := انسخ_نص(&العنوان_البعيد);
            دع الاستجابة: متغير استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(
                الحالة, الخدمة, &متغير الطلب, المفكك.الحدود.أقصى_زمن_معالج_بالمللي
            );
            ضع_إصدار_استجابة_ويب(&متغير الاستجابة, الطلب.الإصدار);
            // A protocol switch or a stream goes to the hand-over callback
            // after its head (http.handover); without one, a switch closes.
            دع ينتقل: منطقي = هل_انتقال_بروتوكول_ويب(&الطلب, &الاستجابة);
            طابق *المسلم مع
            | اختياري.موجود(المسلم_الفعلي) -> {
                إذا (ينتقل || هل_استجابة_متدفقة_ويب(&الاستجابة)) {
                    اقتطع(المرسل, 0);
                    طابق سلسل_رأس_استجابة_ويب1_إلى(&الطلب, &الاستجابة, &متغير المرسل) مع
                    | نتيجة.خطأ(الخطأ) -> {
                        دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                        أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
                    }
                    | نتيجة.نجح(_) -> { };
                    طابق اكتب_الكل(&التدفق, اكتب_ناقل_ويب, &المرسل) مع
                    | نتيجة.خطأ(_) -> {
                        دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                        أرجع نتيجة.نجح(عدد_الطلبات);
                    }
                    | نتيجة.نجح(_) -> { };
                    دع الباقي: متغير متجه ط8 = [];
                    بدّل(المفكك.المخزن, الباقي);
                    المسلم_الفعلي(الحالة, &الطلب, &الاستجابة, التدفق, الباقي);
                    أرجع نتيجة.نجح(عدد_الطلبات + 1);
                };
            }
            | اختياري.لا_شيء -> {
                إذا (ينتقل) {
                    دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.انتقال_بروتوكول_غير_مدعوم());
                };
            };
            علم_إغلاق_عند_الإيقاف_ويب(&متغير الاستجابة);
            دع يبقى: منطقي = طبق_سياسة_اتصال_خادم_ويب1(&الطلب, &متغير الاستجابة);
            اقتطع(المرسل, 0);
            طابق سلسل_استجابة_ويب1_لطلب_إلى(&الطلب, &الاستجابة, &متغير المرسل) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.بروتوكول(الخطأ));
            }
            | نتيجة.نجح(_) -> { };
            طابق اكتب_الكل(&التدفق, اكتب_ناقل_ويب, &المرسل) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
            }
            | نتيجة.نجح(_) -> { };
            عدد_الطلبات := عدد_الطلبات + 1;
            إذا (!يبقى) {
                دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.نجح(عدد_الطلبات);
            };
        }
        | نتيجة.نجح(اختياري.لا_شيء) -> {
            طابق اقرأ_ناقل_ويب(&التدفق, &متغير مخزن_قراءة, 0, 8192) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
            }
            | نتيجة.نجح(المقروء) -> {
                إذا (المقروء == 0) {
                    إذا (بايتات_معلقة_في_مفكك_ويب1(&المفكك) > 0) {
                        دع خطأ_النهاية: خطأ_ويب = خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), بايتات_معلقة_في_مفكك_ويب1(&المفكك));
                        أرسل_خطأ_بروتوكول_خادم(&التدفق, &خطأ_النهاية);
                    };
                    دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
                    أرجع نتيجة.نجح(عدد_الطلبات);
                };
                دع الجزء: متجه ط8 = بايتات_مقروءة_خادم(&مخزن_قراءة, المقروء مثل طبيعي);
                إذا (يفحص_المقدمة) {
                    دع ك: متغير طبيعي = 0;
                    طالما (ك < (الطول(الجزء) مثل طبيعي)) { ألحق(البداية, الجزء[ك]); ك := ك + 1; }
                    إذا (!بادئة_ويب2_خادم(&البداية)) {
                        يفحص_المقدمة := خطأ;
                        غذ_مفكك_ويب1(&متغير المفكك, &البداية);
                    } وإلا إذا ((الطول(البداية) مثل طبيعي) >= 24) {
                        دع حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
                        طابق خدم_اتصال_ويب2_من(التدفق, البداية, &حدود2, الحالة, الخدمة, العنوان_البعيد) مع
                        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.ويب2(خ)); }
                        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
                    };
                } وإلا {
                    غذ_مفكك_ويب1(&متغير المفكك, &الجزء);
                };
            };
        };
    }
    دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(التدفق);
    أرجع نتيجة.نجح(عدد_الطلبات);
}

// The sequential servers' wait for a connection (http.shutdown): with a
// poller, the listener is watched 200 ms at a time so a shutdown request is
// seen while no client connects; answers صواب when a connection is ready.
// Without a poller (Windows) accept itself waits.
عرف مستطلع_مستمع_خادم(المستمع: &مستمع_تي_سي_بي): اختياري مستطلع {
    إذا (!هل_المستطلع_مدعوم()) { أرجع اختياري.لا_شيء(); };
    طابق أنشئ_مستطلع() مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(م) -> {
        طابق سجل_في_مستطلع(&م, واصف_مستمع_تي_سي_بي(المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.خطأ(_) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_مستطلع(م); أرجع اختياري.لا_شيء(); }
        | نتيجة.نجح(_) -> { أرجع اختياري.موجود(م); };
    };
}

عرف اتصال_جاهز_للقبول(
    المستطلع: &اختياري مستطلع,
    المستمع: &مستمع_تي_سي_بي,
    الأحداث: &متغير مخزن_أحداث_مستطلع
): منطقي {
    طابق *المستطلع مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(م) -> {
        طابق انتظر_مستطلع(&م, الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد == 0) { أرجع خطأ; };
            دع تجاهل: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(&م, واصف_مستمع_تي_سي_بي(المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة());
            أرجع صواب;
        };
    };
}

عرف أغلق_مستطلع_خادم(المستطلع: اختياري مستطلع): فراغ {
    طابق المستطلع مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(م) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_مستطلع(م); };
}

عام عرف شغل_خادم_ويب<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(المستمع) -> {
        // A failed accept is usually about one connection or a passing
        // shortage (ECONNABORTED, EINTR, EMFILE, ENOBUFS, ...): retry after
        // a backoff of 1 ms doubling to 1 s. Stop only when the listener
        // itself is unusable (EINVAL: not listening) or after 64 failures
        // in a row, which also ends a closed or invalid descriptor.
        دع إخفاقات_متتالية: متغير عدد = 0;
        دع الانتظار: متغير عدد = 1000000;
        دع المستطلع: اختياري مستطلع = مستطلع_مستمع_خادم(&المستمع);
        دع الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(1);
        طالما (صواب) {
            إذا (هل_طلب_إيقاف_الويب()) {
                أغلق_مستطلع_خادم(المستطلع);
                دع تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                أرجع نتيجة.نجح(0);
            };
            إذا (اتصال_جاهز_للقبول(&المستطلع, &المستمع, &متغير الأحداث)) {
            طابق اقبل_تي_سي_بي(&المستمع) مع
            | نتيجة.خطأ(الخطأ) -> {
                إخفاقات_متتالية := إخفاقات_متتالية + 1;
                دع قاتل: منطقي = إخفاقات_متتالية >= 64;
                طابق صنف_خطأ_ملفات_النظام(الخطأ) مع
                | صنف_خطأ_نظام.وسيط_غير_صالح -> { إخفاقات_متتالية := 64; }
                | _ -> { };
                إذا (قاتل || إخفاقات_متتالية >= 64) {
                    دع تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
                };
                دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(الانتظار);
                إذا (الانتظار < 1000000000) { الانتظار := الانتظار * 2; };
            }
            | نتيجة.نجح(التدفق) -> {
                إخفاقات_متتالية := 0;
                الانتظار := 1000000;
                // Per-connection failures are contained to that client. The
                // listener remains the server's long-lived owner.
                دع العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
                دع بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
                دع تجاهل_اتصال: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_ويب1(ناقل_ويب.تي_سي_بي(التدفق), &(*الإعداد).الحدود, الحالة, الخدمة, العنوان, &بلا_تسليم);
            };
            };
        }
    };
    أرجع نتيجة.نجح(0);
}

// One connection of the async server, inside its task: the socket is
// non-blocking, so every read and write that has to wait suspends this task
// only (http.transport تي_سي_بي_غير_متزامن).
عرف خدم_اتصال_مهمة_ويب<S>(
    الواصف: عدد,
    الحدود: حدود_ويب,
    الحالة: *S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): منطقي {
    دع التدفق: تدفق_تي_سي_بي = صندوق الواصف;
    دع العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    دع بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    دع الناتج: متغير منطقي = صواب;
    غير_آمن {
        طابق خدم_اتصال_ويب1(ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق), &الحدود, &(*الحالة), الخدمة, العنوان, &بلا_تسليم) مع
        | نتيجة.خطأ(_) -> { الناتج := خطأ; }
        | نتيجة.نجح(_) -> { };
    }
    أرجع الناتج;
}

// The async HTTP server (HTTP/1, and h2c by prior knowledge) on the calling
// thread: every accepted connection is served by a task of its own
// (std.async), so an idle or slow client holds a task stack, not a thread,
// and thousands of connections share one thread. The state is borrowed for
// as long as the server runs. Where tasks do not switch (المهام_مدعومة
// false) connections are served one after another. Returns on a setup
// failure, when the listener fails for good, or when shutdown was requested
// (checked between accepts).
عام عرف شغل_خادم_ويب_غير_متزامن<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    دع مؤشر_الحالة: *S = الحالة;
    دع الحدود: حدود_ويب = (*الإعداد).الحدود;
    دع إخفاقات_متتالية: متغير عدد = 0;
    طالما (صواب) {
        إذا (هل_طلب_إيقاف_الويب()) {
            دع تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(المستمع);
            أرجع نتيجة.نجح(0);
        };
        طابق اقبل_تي_سي_بي(&المستمع) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) {
                // Nothing to accept: wait for a connection, at most 250 ms
                // so a shutdown request is seen.
                دع تجاهل_الانتظار: نتيجة عدد, عدد = انتظر_جاهزية_واصف_بمهلة(
                    واصف_مستمع_تي_سي_بي(&المستمع), اهتمام_مستطلع.قراءة(), 250000000
                );
            } وإلا {
                // As شغل_خادم_ويب: a failed accept is usually about one
                // connection; stop after 64 in a row or a listener that is
                // not listening.
                إخفاقات_متتالية := إخفاقات_متتالية + 1;
                طابق صنف_خطأ_ملفات_النظام(الخطأ) مع
                | صنف_خطأ_نظام.وسيط_غير_صالح -> { إخفاقات_متتالية := 64; }
                | _ -> { };
                إذا (إخفاقات_متتالية >= 64) {
                    دع تجاهل: نتيجة عدد, عدد = أغلق_مستمعا_غير_متزامن(المستمع);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
                };
                نم_مهمة(1000000 * إخفاقات_متتالية);
            };
        }
        | نتيجة.نجح(التدفق) -> {
            إخفاقات_متتالية := 0;
            دع تجاهل_الوضع: نتيجة عدد, عدد = اجعل_تدفقا_غير_متزامن(&التدفق);
            دع الواصف: عدد = سلم_مقبس_تدفق_تي_سي_بي(التدفق);
            دع العمل: دالة(): منطقي;
            غير_آمن {
                العمل := دالة(): منطقي -> خدم_اتصال_مهمة_ويب(الواصف, الحدود, مؤشر_الحالة, الخدمة);
            }
            دع تجاهل_المهمة: مهمة<منطقي> = أطلق_مهمة(العمل);
        };
    }
    أرجع نتيجة.نجح(0);
}
عام مرادف http_serve_async = شغل_خادم_ويب_غير_متزامن;

// Serves one accepted connection over a transport (HTTP/1, or HTTP/2 when it
// starts with the client preface) and closes it; as Go's Server.ServeConn.
عام عرف خدم_اتصال_ويب<S>(
    الناقل: ناقل_ويب,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    دع العنوان: نص = عنوان_نظير_ناقل_ويب(&الناقل);
    دع بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    أرجع خدم_اتصال_ويب1(الناقل, الحدود, الحالة, الخدمة, العنوان, &بلا_تسليم);
}

// As خدم_اتصال_ويب, handing protocol switches and streamed responses to
// المسلم after their head (http.handover).
عام عرف خدم_اتصال_ويب_مع_تسليم<S>(
    الناقل: ناقل_ويب,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    دع العنوان: نص = عنوان_نظير_ناقل_ويب(&الناقل);
    دع مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    أرجع خدم_اتصال_ويب1(الناقل, الحدود, الحالة, الخدمة, العنوان, &مع_تسليم);
}

// Serves one accepted TCP connection over TLS: the handshake (whose ALPN
// list comes from إعداد_الأمان), then HTTP/2 when "h2" was negotiated and
// HTTP/1 otherwise.
عام عرف خدم_اتصال_ويب_آمن<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    دع بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    أرجع خدم_اتصال_ويب_آمن_داخلي(التدفق, إعداد_الأمان, الحدود, الحالة, الخدمة, &بلا_تسليم);
}

// As خدم_اتصال_ويب_آمن, with a hand-over callback for HTTP/1 (http.handover).
عام عرف خدم_اتصال_ويب_آمن_مع_تسليم<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    دع مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    أرجع خدم_اتصال_ويب_آمن_داخلي(التدفق, إعداد_الأمان, الحدود, الحالة, الخدمة, &مع_تسليم);
}

عرف خدم_اتصال_ويب_آمن_داخلي<S>(
    التدفق: تدفق_تي_سي_بي,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    // The client's address, read before the socket moves into the TLS stream.
    دع العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    طابق اقبل_خادم_تي_إل_إس(التدفق, إعداد_الأمان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(الآمن) -> {
        دع h2: متغير منطقي = خطأ;
        طابق بروتوكول_تدفق_تي_إل_إس(&الآمن) مع
        | اختياري.موجود(ب) -> {
            دع اسم_h2: نص = «h2»;
            h2 := نصان_متساويان(&ب, &اسم_h2);
        }
        | اختياري.لا_شيء -> { };
        إذا (h2) {
            دع حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
            دع لا_بايتات: متجه ط8 = [];
            طابق خدم_اتصال_ويب2_من(ناقل_ويب.تي_إل_إس(الآمن), لا_بايتات, &حدود2, الحالة, الخدمة, انسخ_نص(&العنوان)) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.ويب2(خ)); }
            | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
        };
        أرجع خدم_اتصال_ويب1(ناقل_ويب.تي_إل_إس(الآمن), الحدود, الحالة, الخدمة, العنوان, المسلم);
    };
}

// The HTTPS server: each accepted connection runs the TLS handshake with
// ALPN offering "h2" and "http/1.1" (unless the configuration lists its own
// protocols), then HTTP/2 or HTTP/1 by the negotiated protocol, as Go's
// http.Server.ServeTLS. Connections are served one at a time.
عام عرف شغل_خادم_ويب_آمن<S>(
    الإعداد: &إعداد_خادم_ويب,
    إعداد_الأمان: &إعداد_خادم_تي_إل_إس,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_خادم_ويب {
    دع الأمان: متغير إعداد_خادم_تي_إل_إس = انسخ_إعداد_خادم_تي_إل_إس(إعداد_الأمان);
    إذا ((الطول(الأمان.البروتوكولات) مثل طبيعي) == 0) {
        دع البروتوكولات: متجه نص = [«h2», «http/1.1»];
        اضبط_بروتوكولات_خادم_تي_إل_إس(&متغير الأمان, &البروتوكولات);
    };
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(المستمع) -> {
        دع إخفاقات_متتالية: متغير عدد = 0;
        دع المستطلع: اختياري مستطلع = مستطلع_مستمع_خادم(&المستمع);
        دع الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(1);
        طالما (صواب) {
            إذا (هل_طلب_إيقاف_الويب()) {
                أغلق_مستطلع_خادم(المستطلع);
                دع تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                أرجع نتيجة.نجح(0);
            };
            إذا (اتصال_جاهز_للقبول(&المستطلع, &المستمع, &متغير الأحداث)) {
            طابق اقبل_تي_سي_بي(&المستمع) مع
            | نتيجة.خطأ(الخطأ) -> {
                إخفاقات_متتالية := إخفاقات_متتالية + 1;
                طابق صنف_خطأ_ملفات_النظام(الخطأ) مع
                | صنف_خطأ_نظام.وسيط_غير_صالح -> { إخفاقات_متتالية := 64; }
                | _ -> { };
                إذا (إخفاقات_متتالية >= 64) {
                    دع تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
                    أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
                };
                دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000);
            }
            | نتيجة.نجح(التدفق) -> {
                إخفاقات_متتالية := 0;
                دع تجاهل: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_ويب_آمن(التدفق, &الأمان, &(*الإعداد).الحدود, الحالة, الخدمة);
            };
            };
        }
    };
    أرجع نتيجة.نجح(0);
}

// ---- The event-driven HTTP server ----
//
// شغل_خادم_ويب serves one connection at a time and a TLS or thread-per-
// connection server keeps a thread per client, so an idle or slow client
// holds a whole thread. This server instead keeps every connection
// non-blocking in one readiness poller (std.os.poll: epoll, kqueue), the
// design of Go's netpoller, Rust's mio/tokio and nginx:
//
// - N worker threads (default: the available parallelism) all wait on the
//   one poller. Every descriptor is armed one-shot, so an event hands its
//   connection to exactly one worker; no two workers touch a connection at
//   once, and a connection costs no thread while it waits.
// - The worker that gets an event takes the connection out of the shared
//   table, reads until the socket would block, feeds the incremental HTTP/1
//   parser, runs the handler for every complete request (pipelining kept in
//   order), and writes without blocking. Output the socket does not take
//   yet stays with the connection, which then waits to write; otherwise it
//   waits to read. It is put back in the table before it is re-armed.
// - The listener is token 0: the worker that gets it accepts until accept
//   would block, then re-arms it.
// - A handler runs on the worker that read its request. A slow handler
//   blocks that worker only; the others keep serving.
// - A connection that starts with the HTTP/2 client preface (h2c with prior
//   knowledge) leaves the poller and is served by the blocking HTTP/2
//   server on its worker for its lifetime.
//
// Targets without a poller (Windows for now: IOCP is a completion model)
// run the sequential شغل_خادم_ويب instead.

عرف تراكم_صادر_أقصى_ويب(): عدد { أرجع 8192; }

نوع اتصال_حدثي_ويب = {
    التدفق: تدفق_تي_سي_بي,
    المفكك: مفكك_ويب1,
    البداية: متجه ط8,
    الصادر: متجه ط8,
    المرسل: عدد,
    العنوان_البعيد: نص,
    // A response whose head is queued and whose connection then goes to the
    // hand-over callback (http.handover).
    التسليم: اختياري تسليم_معلق_ويب,
    // The flags last, side by side (no padding after each).
    يفحص_المقدمة: منطقي,
    يغلق: منطقي
};

نوع تسليم_معلق_ويب = {
    الطلب: طلب_ويب_مخزن,
    الاستجابة: استجابة_ويب_مخزنة
};

// What the connection waits for after a step, carrying it back to the
// worker, which puts it back and re-arms it, or ends it.
نوع خطوة_اتصال_حدثي_ويب =
    | ينتظر_القراءة بنوع اتصال_حدثي_ويب
    | ينتظر_الكتابة بنوع اتصال_حدثي_ويب
    | انتهى_الاتصال بنوع اتصال_حدثي_ويب
    | إلى_ويب2 بنوع اتصال_حدثي_ويب
    | إلى_مسلم بنوع اتصال_حدثي_ويب
;

نوع نتيجة_إفراغ_ويب =
    | أفرغ
    | محجوب
    | فشل
;

// Connection slots: token = slot + 1 (0 is the listener). Free slots are
// reused so tokens stay small. A slot is one open connection (one
// descriptor), so slot indices fit ط32.
نوع جدول_اتصالات_ويب = {
    الخانات: متجه اختياري اتصال_حدثي_ويب,
    الحرة: متجه ط32
};

نوع سياق_خادم_حدثي_ويب = {
    المستطلع: مستطلع,
    المستمع: مستمع_تي_سي_بي,
    الجدول: قفل<جدول_اتصالات_ويب>,
    الحدود: حدود_ويب
};

عرف ألحق_بايتات_حدثي(الهدف: &متغير متجه ط8, البايتات: &متجه ط8): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) { ألحق(*الهدف, (*البايتات)[ف]); ف := ف + 1; }
}

// The table under its lock (std.sync.mutex's raw lock, as Condvar uses it).
عرف أدخل_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الاتصال: اتصال_حدثي_ويب): طبيعي {
    دع الخانة_الجديدة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(الاتصال);
    اقفل_خام(الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    دع الموضع: متغير طبيعي = 0;
    غير_آمن {
        طابق أزل_الأخير((*المؤشر).الحرة) مع
        | اختياري.موجود(الحرة) -> {
            الموضع := الحرة;
            بدّل((*المؤشر).الخانات[الموضع], الخانة_الجديدة);
        }
        | اختياري.لا_شيء -> {
            الموضع := الطول((*المؤشر).الخانات) مثل طبيعي;
            ألحق((*المؤشر).الخانات, الخانة_الجديدة);
        };
    }
    افتح_خام(الجدول);
    أرجع الموضع;
}

عرف خذ_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي): اختياري اتصال_حدثي_ويب {
    دع الناتج: متغير اختياري اتصال_حدثي_ويب = اختياري.لا_شيء();
    اقفل_خام(الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن {
        إذا (الموضع < (الطول((*المؤشر).الخانات) مثل طبيعي)) {
            بدّل((*المؤشر).الخانات[الموضع], الناتج);
        };
    }
    افتح_خام(الجدول);
    أرجع الناتج;
}

عرف أعد_اتصالا_حدثيا(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي, الاتصال: اتصال_حدثي_ويب): فراغ {
    دع الخانة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(الاتصال);
    اقفل_خام(الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن { بدّل((*المؤشر).الخانات[الموضع], الخانة); }
    افتح_خام(الجدول);
}

عرف حرر_خانة_حدثية(الجدول: &قفل<جدول_اتصالات_ويب>, الموضع: طبيعي): فراغ {
    اقفل_خام(الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(الجدول);
    غير_آمن { ألحق((*المؤشر).الحرة, الموضع مثل ط32); }
    افتح_خام(الجدول);
}

عرف أغلق_اتصالا_حدثيا(الاتصال: اتصال_حدثي_ويب): فراغ {
    طابق الاتصال مع
    | { التدفق: التدفق, المفكك: _, البداية: _, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: _, التسليم: _ } -> {
        دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
    };
}

// Writes pending output until it is all sent or the socket would block.
عرف أفرغ_صادر_حدثي(الاتصال: &متغير اتصال_حدثي_ويب): نتيجة_إفراغ_ويب {
    دع الكل: عدد = الطول((*الاتصال).الصادر) مثل عدد;
    طالما ((*الاتصال).المرسل < الكل) {
        طابق اكتب_تي_سي_بي(&(*الاتصال).التدفق, &(*الاتصال).الصادر, (*الاتصال).المرسل, الكل - (*الاتصال).المرسل) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) { أرجع نتيجة_إفراغ_ويب.محجوب(); };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة_إفراغ_ويب.فشل(); };
        }
        | نتيجة.نجح(المكتوب) -> {
            إذا (المكتوب <= 0) { أرجع نتيجة_إفراغ_ويب.فشل(); };
            (*الاتصال).المرسل := (*الاتصال).المرسل + المكتوب;
        };
    }
    // Keep the buffer's capacity for the next responses.
    اقتطع((*الاتصال).الصادر, 0);
    (*الاتصال).المرسل := 0;
    أرجع نتيجة_إفراغ_ويب.أفرغ();
}

// Runs the handler for every complete request the parser holds and queues
// the responses; stops at a request that ends the connection.
عرف أجب_طلبات_حدثية<S>(
    الاتصال: &متغير اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    طالما (!(*الاتصال).يغلق) {
        طابق التالي_من_مفكك_ويب1(&متغير (*الاتصال).المفكك) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(&الخطأ);
            ألحق_بايتات_حدثي(&متغير (*الاتصال).الصادر, &البايتات);
            (*الاتصال).يغلق := صواب;
        }
        | نتيجة.نجح(اختياري.لا_شيء) -> { أرجع; }
        | نتيجة.نجح(اختياري.موجود(المحلل)) -> {
            دع الطلب: متغير طلب_ويب_مخزن = خذ_طلب_محلل_ويب(المحلل);
            الطلب.العنوان_البعيد := انسخ_نص(&(*الاتصال).العنوان_البعيد);
            دع الاستجابة: متغير استجابة_ويب_مخزنة = نفذ_خدمة_بمهلة_ويب(
                الحالة, الخدمة, &متغير الطلب, (*الاتصال).المفكك.الحدود.أقصى_زمن_معالج_بالمللي
            );
            ضع_إصدار_استجابة_ويب(&متغير الاستجابة, الطلب.الإصدار);
            // As the sequential server: a protocol switch or a stream queues
            // its head and waits for the hand-over (خطوة_اتصال_ويب).
            دع ينتقل: منطقي = هل_انتقال_بروتوكول_ويب(&الطلب, &الاستجابة);
            طابق *المسلم مع
            | اختياري.موجود(_) -> {
                إذا (ينتقل || هل_استجابة_متدفقة_ويب(&الاستجابة)) {
                    طابق سلسل_رأس_استجابة_ويب1_إلى(&الطلب, &الاستجابة, &متغير (*الاتصال).الصادر) مع
                    | نتيجة.خطأ(_) -> { (*الاتصال).يغلق := صواب; }
                    | نتيجة.نجح(_) -> {
                        دع المعلق: تسليم_معلق_ويب = { الطلب: الطلب, الاستجابة: الاستجابة };
                        (*الاتصال).التسليم := اختياري.موجود(المعلق);
                    };
                    أرجع;
                };
            }
            | اختياري.لا_شيء -> {
                إذا (ينتقل) {
                    (*الاتصال).يغلق := صواب;
                    أرجع;
                };
            };
            علم_إغلاق_عند_الإيقاف_ويب(&متغير الاستجابة);
            دع يبقى: منطقي = طبق_سياسة_اتصال_خادم_ويب1(&الطلب, &متغير الاستجابة);
            // Serialized straight into the connection's output buffer.
            طابق سلسل_استجابة_ويب1_لطلب_إلى(&الطلب, &الاستجابة, &متغير (*الاتصال).الصادر) مع
            | نتيجة.خطأ(_) -> { (*الاتصال).يغلق := صواب; }
            | نتيجة.نجح(_) -> {
                إذا (!يبقى) { (*الاتصال).يغلق := صواب; };
            };
        };
    }
}

// Feeds bytes read from the socket, watching the first 24 for the HTTP/2
// client preface; answers صواب when the connection is h2c.
عرف غذ_اتصالا_حدثيا(الاتصال: &متغير اتصال_حدثي_ويب, الجزء: &متجه ط8): منطقي {
    إذا (!(*الاتصال).يفحص_المقدمة) {
        غذ_مفكك_ويب1(&متغير (*الاتصال).المفكك, الجزء);
        أرجع خطأ;
    };
    ألحق_بايتات_حدثي(&متغير (*الاتصال).البداية, الجزء);
    إذا (!بادئة_ويب2_خادم(&(*الاتصال).البداية)) {
        (*الاتصال).يفحص_المقدمة := خطأ;
        دع البداية: متغير متجه ط8 = [];
        بدّل((*الاتصال).البداية, البداية);
        غذ_مفكك_ويب1(&متغير (*الاتصال).المفكك, &البداية);
        أرجع خطأ;
    };
    أرجع (الطول((*الاتصال).البداية) مثل طبيعي) >= 24;
}

// One step of a ready connection. At most 16 reads per event, so a client
// that keeps sending cannot hold a worker; it is re-armed and, still
// readable, comes back at once.
عرف خطوة_اتصال_ويب<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المخزن: &متغير متجه ط8,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): خطوة_اتصال_حدثي_ويب {
    دع ج: متغير اتصال_حدثي_ويب = الاتصال;
    دع القراءات: متغير عدد = 0;
    طالما (صواب) {
        أجب_طلبات_حدثية(&متغير ج, الحالة, الخدمة, المسلم);
        طابق ج.التسليم مع
        | اختياري.موجود(_) -> { أرجع خطوة_اتصال_حدثي_ويب.إلى_مسلم(ج); }
        | اختياري.لا_شيء -> { };
        إذا ((الطول(ج.الصادر) مثل طبيعي) > 0) {
            طابق أفرغ_صادر_حدثي(&متغير ج) مع
            | نتيجة_إفراغ_ويب.محجوب -> { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_الكتابة(ج); }
            | نتيجة_إفراغ_ويب.فشل -> { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); }
            | نتيجة_إفراغ_ويب.أفرغ -> { };
        };
        إذا (ج.يغلق) { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); };
        إذا (القراءات >= 16) { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج); };
        القراءات := القراءات + 1;
        طابق اقرأ_تي_سي_بي(&ج.التدفق, المخزن, 0, الطول(*المخزن) مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_سيحظر(الخطأ)) { أرجع خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج); };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج); };
        }
        | نتيجة.نجح(المقروء) -> {
            إذا (المقروء == 0) {
                // The client closed. A partial request is answered as the
                // sequential server answers it, best effort.
                إذا (بايتات_معلقة_في_مفكك_ويب1(&ج.المفكك) > 0) {
                    دع خطأ_النهاية: خطأ_ويب = خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), بايتات_معلقة_في_مفكك_ويب1(&ج.المفكك));
                    دع البايتات: متجه ط8 = بايتات_خطأ_بروتوكول_خادم(&خطأ_النهاية);
                    ألحق_بايتات_حدثي(&متغير ج.الصادر, &البايتات);
                    دع تجاهل: نتيجة_إفراغ_ويب = أفرغ_صادر_حدثي(&متغير ج);
                };
                أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج);
            };
            دع الجزء: متجه ط8 = بايتات_مقروءة_خادم(&(*المخزن), المقروء مثل طبيعي);
            إذا (غذ_اتصالا_حدثيا(&متغير ج, &الجزء)) { أرجع خطوة_اتصال_حدثي_ويب.إلى_ويب2(ج); };
        };
    }
    أرجع خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج);
}

// The connection leaves the poller for the hand-over callback: it becomes
// blocking, its queued output (the response head) is written, and the
// callback receives it with the bytes read past the request.
عرف سلم_اتصالا_إلى_مسلم<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    دع ج: متغير اتصال_حدثي_ويب = الاتصال;
    دع الباقي: متغير متجه ط8 = [];
    بدّل(ج.المفكك.المخزن, الباقي);
    دع الصادر: متغير متجه ط8 = [];
    بدّل(ج.الصادر, الصادر);
    دع المرسل: طبيعي = ج.المرسل مثل طبيعي;
    دع التسليم: متغير اختياري تسليم_معلق_ويب = اختياري.لا_شيء();
    بدّل(ج.التسليم, التسليم);
    طابق ج مع
    | { التدفق: التدفق, المفكك: _, البداية: _, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: _, التسليم: _ } -> {
        دع تجاهل_الحجب: نتيجة عدد, عدد = اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, خطأ);
        دع الناقل: ناقل_ويب = ناقل_ويب.تي_سي_بي(التدفق);
        دع الكل: طبيعي = الطول(الصادر) مثل طبيعي;
        إذا (المرسل < الكل) {
            دع المتبقي: متجه ط8 = انسخ_بايتات_ويب(&الصادر, المرسل, الكل - المرسل);
            طابق اكتب_الكل(&الناقل, اكتب_ناقل_ويب, &المتبقي) مع
            | نتيجة.خطأ(_) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); أرجع; }
            | نتيجة.نجح(_) -> { };
        };
        طابق *المسلم مع
        | اختياري.لا_شيء -> { دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); }
        | اختياري.موجود(المسلم_الفعلي) -> {
            طابق التسليم مع
            | اختياري.لا_شيء -> { دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل); }
            | اختياري.موجود(المعلق) -> {
                المسلم_الفعلي(الحالة, &المعلق.الطلب, &المعلق.الاستجابة, الناقل, الباقي);
            };
        };
    };
}

// The connection leaves the poller for the blocking HTTP/2 server.
عرف سلم_اتصالا_إلى_ويب2<S>(
    الاتصال: اتصال_حدثي_ويب,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): فراغ {
    طابق الاتصال مع
    | { التدفق: التدفق, المفكك: _, البداية: البداية, يفحص_المقدمة: _, الصادر: _, المرسل: _, يغلق: _, العنوان_البعيد: العنوان, التسليم: _ } -> {
        دع تجاهل_الحجب: نتيجة عدد, عدد = اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, خطأ);
        دع حدود2: حدود_ويب2 = حدود_ويب2_افتراضية();
        دع تجاهل: نتيجة عدد, خطأ_ويب2 = خدم_اتصال_ويب2_من(ناقل_ويب.تي_سي_بي(التدفق), البداية, &حدود2, الحالة, الخدمة, العنوان);
    };
}

عرف اتصال_حدثي_جديد(التدفق: تدفق_تي_سي_بي, الحدود: &حدود_ويب): اتصال_حدثي_ويب {
    دع العنوان: نص = عنوان_نظير_تي_سي_بي_نص(&التدفق);
    دع الناتج: اتصال_حدثي_ويب = {
        التدفق: التدفق,
        المفكك: مفكك_ويب1_جديد(*الحدود),
        البداية: [],
        يفحص_المقدمة: صواب,
        الصادر: [],
        المرسل: 0,
        يغلق: خطأ,
        العنوان_البعيد: العنوان,
        التسليم: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

// Accepts until accept would block, registers each connection, re-arms the
// listener. A failure other than "would block" (EMFILE, ENOBUFS, ...)
// pauses 1 ms so a full descriptor table does not spin the worker.
عرف اقبل_اتصالات_حدثية(السياق: &سياق_خادم_حدثي_ويب): فراغ {
    طالما (صواب) {
        طابق اقبل_تي_سي_بي(&(*السياق).المستمع) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (!هل_خطأ_سيحظر(الخطأ) && !هل_خطأ_مقاطعة(الخطأ)) {
                دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000);
            };
            إذا (!هل_خطأ_مقاطعة(الخطأ)) {
                دع تجاهل: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(
                    &(*السياق).المستطلع, واصف_مستمع_تي_سي_بي(&(*السياق).المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()
                );
                أرجع;
            };
        }
        | نتيجة.نجح(التدفق) -> { سلم_تدفقا_لسياق_حدثي(السياق, التدفق); };
    }
}

// Puts an accepted connection in a worker's table and poller (from that
// worker, or from the acceptor thread: the table is locked and a poller
// takes registrations from any thread).
عرف سلم_تدفقا_لسياق_حدثي(السياق: &سياق_خادم_حدثي_ويب, التدفق: تدفق_تي_سي_بي): فراغ {
    دع الواصف: عدد = واصف_تدفق_تي_سي_بي(&التدفق);
    طابق اضبط_تدفق_تي_سي_بي_غير_حاصر(&التدفق, صواب) مع
    | نتيجة.خطأ(_) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق); }
    | نتيجة.نجح(_) -> {
        دع الاتصال: اتصال_حدثي_ويب = اتصال_حدثي_جديد(التدفق, &(*السياق).الحدود);
        دع الموضع: طبيعي = أدخل_اتصالا_حدثيا(&(*السياق).الجدول, الاتصال);
        طابق سجل_في_مستطلع(&(*السياق).المستطلع, الواصف, (الموضع + 1) مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.نجح(_) -> { }
        | نتيجة.خطأ(_) -> {
            طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
            | اختياري.موجود(المرفوض) -> { أغلق_اتصالا_حدثيا(المرفوض); }
            | اختياري.لا_شيء -> { };
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
        };
    };
}

// Open connections in a worker's table.
عرف عدد_اتصالات_سياق_حدثي(السياق: &سياق_خادم_حدثي_ويب): طبيعي {
    اقفل_خام(&(*السياق).الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(&(*السياق).الجدول);
    دع العدد: متغير طبيعي = 0;
    غير_آمن {
        العدد := (الطول((*المؤشر).الخانات) مثل طبيعي) - (الطول((*المؤشر).الحرة) مثل طبيعي);
    }
    افتح_خام(&(*السياق).الجدول);
    أرجع العدد;
}

عرف خدم_حدث_اتصال<S>(
    السياق: &سياق_خادم_حدثي_ويب,
    الموضع: طبيعي,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المخزن: &متغير متجه ط8,
    المسلم: &اختياري مسلم_اتصال_ويب<S>
): فراغ {
    طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاتصال) -> {
        دع الواصف: عدد = واصف_تدفق_تي_سي_بي(&الاتصال.التدفق);
        دع الرمز: ط64 = (الموضع + 1) مثل ط64;
        طابق خطوة_اتصال_ويب(الاتصال, الحالة, الخدمة, المخزن, المسلم) مع
        | خطوة_اتصال_حدثي_ويب.ينتظر_القراءة(ج) -> {
            أعد_اتصالا_حدثيا(&(*السياق).الجدول, الموضع, ج);
            طابق أعد_تسليح_في_مستطلع(&(*السياق).المستطلع, الواصف, الرمز, اهتمام_مستطلع.قراءة()) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> { أنه_خانة_حدثية(السياق, الموضع); };
        }
        | خطوة_اتصال_حدثي_ويب.ينتظر_الكتابة(ج) -> {
            أعد_اتصالا_حدثيا(&(*السياق).الجدول, الموضع, ج);
            طابق أعد_تسليح_في_مستطلع(&(*السياق).المستطلع, الواصف, الرمز, اهتمام_مستطلع.كتابة()) مع
            | نتيجة.نجح(_) -> { }
            | نتيجة.خطأ(_) -> { أنه_خانة_حدثية(السياق, الموضع); };
        }
        | خطوة_اتصال_حدثي_ويب.انتهى_الاتصال(ج) -> {
            أغلق_اتصالا_حدثيا(ج);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
        }
        | خطوة_اتصال_حدثي_ويب.إلى_مسلم(ج) -> {
            دع تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, الواصف);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
            سلم_اتصالا_إلى_مسلم(ج, الحالة, المسلم);
        }
        | خطوة_اتصال_حدثي_ويب.إلى_ويب2(ج) -> {
            دع تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, الواصف);
            حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
            سلم_اتصالا_إلى_ويب2(ج, الحالة, الخدمة);
        };
    };
}

// A re-arm failed after the connection went back: take it out and close it.
عرف أنه_خانة_حدثية(السياق: &سياق_خادم_حدثي_ويب, الموضع: طبيعي): فراغ {
    طابق خذ_اتصالا_حدثيا(&(*السياق).الجدول, الموضع) مع
    | اختياري.موجود(ج) -> { أغلق_اتصالا_حدثيا(ج); }
    | اختياري.لا_شيء -> { };
    حرر_خانة_حدثية(&(*السياق).الجدول, الموضع);
}

// Between requests: no partial request read, no response left to send and
// no HTTP/2 preface half read.
عرف اتصال_حدثي_خامل(الاتصال: &اتصال_حدثي_ويب): منطقي {
    إذا ((الطول((*الاتصال).المفكك.المخزن) مثل طبيعي) != 0) { أرجع خطأ; };
    إذا ((*الاتصال).يفحص_المقدمة && (الطول((*الاتصال).البداية) مثل طبيعي) != 0) { أرجع خطأ; };
    أرجع (*الاتصال).المرسل >= (الطول((*الاتصال).الصادر) مثل عدد);
}

// During a shutdown (http.shutdown): takes every idle connection (every
// connection when الكل) out of the table and closes it, and answers how many
// connections are still open, including those another worker is serving.
عرف أغلق_الخاملة_حدثيا(السياق: &سياق_خادم_حدثي_ويب, الكل: منطقي): طبيعي {
    دع المغلقة: متغير متجه اتصال_حدثي_ويب = [];
    دع الباقية: متغير طبيعي = 0;
    اقفل_خام(&(*السياق).الجدول);
    دع المؤشر: *متغير جدول_اتصالات_ويب = مؤشر_قيمة_القفل(&(*السياق).الجدول);
    غير_آمن {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*المؤشر).الخانات) مثل طبيعي)) {
            دع الخانة: متغير اختياري اتصال_حدثي_ويب = اختياري.لا_شيء();
            بدّل((*المؤشر).الخانات[ف], الخانة);
            طابق الخانة مع
            | اختياري.لا_شيء -> { }
            | اختياري.موجود(ج) -> {
                إذا (الكل || اتصال_حدثي_خامل(&ج)) {
                    ألحق(المغلقة, ج);
                    ألحق((*المؤشر).الحرة, ف مثل ط32);
                } وإلا {
                    دع المعادة: متغير اختياري اتصال_حدثي_ويب = اختياري.موجود(ج);
                    بدّل((*المؤشر).الخانات[ف], المعادة);
                };
            };
            ف := ف + 1;
        }
        الباقية := (الطول((*المؤشر).الخانات) مثل طبيعي) - (الطول((*المؤشر).الحرة) مثل طبيعي);
    }
    افتح_خام(&(*السياق).الجدول);
    طالما ((الطول(المغلقة) مثل طبيعي) > 0) {
        طابق أزل_الأخير(المغلقة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(ج) -> {
            دع تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&(*السياق).المستطلع, واصف_تدفق_تي_سي_بي(&ج.التدفق));
            أغلق_اتصالا_حدثيا(ج);
        };
    }
    أرجع الباقية;
}

عرف عامل_خادم_حدثي<S>(
    السياق: مشترك<سياق_خادم_حدثي_ويب>,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): فراغ {
    دع س: &سياق_خادم_حدثي_ويب = اقرأ_مشترك(&السياق);
    دع ح: &S = اقرأ_مشترك(&الحالة);
    دع الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(64);
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(المخزن, 0); ف := ف + 1; }
    // A shutdown (http.shutdown) is noticed within one 200 ms wait: the
    // listener is no longer accepted from (its one-shot interest is not
    // re-armed), idle connections are closed at every turn, and the worker
    // returns when none is left or the grace period has passed.
    دع ينهي: متغير منطقي = خطأ;
    دع المهلة_النهائية: متغير عدد = 0;
    طالما (صواب) {
        إذا (هل_طلب_إيقاف_الويب()) {
            دع الآن: متغير عدد = 0;
            طابق وقت_رتيب_نانو() مع
            | نتيجة.نجح(ن) -> { الآن := ن; }
            | نتيجة.خطأ(_) -> { };
            إذا (!ينهي) {
                ينهي := صواب;
                المهلة_النهائية := الآن + مهلة_إيقاف_الويب_بالثواني() * 1000000000;
            };
            إذا (الآن >= المهلة_النهائية) { علّم_انتهاء_مهلة_إيقاف_الويب(); };
            إذا (أغلق_الخاملة_حدثيا(س, الآن >= المهلة_النهائية) == 0) { أرجع; };
        };
        طابق انتظر_مستطلع(&(*س).المستطلع, &متغير الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000); }
        | نتيجة.نجح(العدد) -> {
            دع ك: متغير طبيعي = 0;
            طالما (ك < العدد) {
                دع الحدث: حدث_مستطلع = حدث_مستطلع_عند(&الأحداث, ك);
                إذا (الحدث.الرمز == (0 مثل ط64)) { إذا (!ينهي) { اقبل_اتصالات_حدثية(س); }; }
                وإلا { خدم_حدث_اتصال(س, (الحدث.الرمز - 1) مثل طبيعي, ح, الخدمة, &متغير المخزن, &المسلم); };
                ك := ك + 1;
            }
        };
    }
}

// The event-driven HTTP server (HTTP/1, and h2c by prior knowledge): the
// state is shared by every worker thread through an Arc, as a Go handler's
// or an axum State's. الخيوط 0 uses the available parallelism. It returns
// only on a setup failure.
عام عرف شغل_خادم_ويب_بأحداث<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي
): نتيجة عدد, خطأ_خادم_ويب {
    دع بلا_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.لا_شيء();
    أرجع شغل_خادم_ويب_بأحداث_داخلي(الإعداد, الحالة, الخدمة, الخيوط, بلا_تسليم);
}

// As شغل_خادم_ويب_بأحداث, handing protocol switches and streamed responses
// to المسلم after their head (http.handover). The callback runs on the
// worker thread that served the request.
عام عرف شغل_خادم_ويب_بأحداث_مع_تسليم<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي,
    المسلم: مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    دع مع_تسليم: اختياري مسلم_اتصال_ويب<S> = اختياري.موجود(المسلم);
    أرجع شغل_خادم_ويب_بأحداث_داخلي(الإعداد, الحالة, الخدمة, الخيوط, مع_تسليم);
}

// A worker's listener, poller and connection table. With a balancing
// SO_REUSEPORT (Linux, FreeBSD) every worker binds its own listener on the
// address and owns its own context: no table or poller is shared between
// threads (shard-per-core, as nginx's reuseport, Seastar and actix-web).
// Elsewhere (macOS) one acceptor hands connections to the workers
// (شغل_خادم_ويب_بموزع).
عرف أنشئ_سياق_حدثي_ويب(
    الإعداد: &إعداد_خادم_ويب,
    منفذ_مشترك: منطقي
): نتيجة سياق_خادم_حدثي_ويب, خطأ_خادم_ويب {
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_حدثي_ويب(الإعداد, منفذ_مشترك) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    دع واصف_المستمع: عدد = واصف_مستمع_تي_سي_بي(&المستمع);
    طابق سياق_حدثي_لمستمع_ويب(المستمع, &(*الإعداد).الحدود, منفذ_مشترك, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(السياق) -> { أرجع نتيجة.نجح(السياق); };
}

// Closes a shard that no worker will serve: its listener and its poller's
// descriptor.
عرف أغلق_شظية_حدثية_ويب(الشظية: &مشترك<سياق_خادم_حدثي_ويب>): فراغ {
    دع السياق: &سياق_خادم_حدثي_ويب = اقرأ_مشترك(الشظية);
    دع تجاهل_المستمع: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_مستمع_تي_سي_بي(&(*السياق).المستمع));
    دع تجاهل_المستطلع: عدد = أغلق_مقبس_تي_سي_بي_خام((*السياق).المستطلع.الواصف);
}

// The configured address's port (0 when it does not parse).
عرف منفذ_إعداد_ويب(الإعداد: &إعداد_خادم_ويب): ط16 {
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.نجح(العنوان) -> { أرجع منفذ_عنوان_مقبس(&العنوان); }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// Whether a server already listens on the configured address: a TCP
// connection to it (through loopback for an unspecified address) is accepted.
عرف عنوان_إعداد_يستمع_ويب(الإعداد: &إعداد_خادم_ويب): منطقي {
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; }
    | نتيجة.خطأ(_) -> { أرجع صواب; };
    إذا (هل_عنوان_آيبي_غير_محدد(&العنوان.الآيبي)) {
        طابق العنوان.الآيبي مع
        | عنوان_آيبي.رابع(_) -> {
            العنوان := أنشئ_عنوان_مقبس(عنوان_آيبي.رابع(أنشئ_عنوان_آيبي4(127, 0, 0, 1)), العنوان.المنفذ);
        }
        | عنوان_آيبي.سادس(_) -> {
            دع المقاطع: متجه ط16 = [0, 0, 0, 0, 0, 0, 0, 1];
            طابق أنشئ_عنوان_آيبي6(المقاطع) مع
            | نتيجة.نجح(الحلقة) -> { العنوان := أنشئ_عنوان_مقبس(عنوان_آيبي.سادس(الحلقة), العنوان.المنفذ); }
            | نتيجة.خطأ(_) -> { };
        };
    };
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.نجح(التدفق) -> {
        دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
        أرجع صواب;
    }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// The configured address bound and listening, non-blocking.
عرف اربط_مستمع_حدثي_ويب(
    الإعداد: &إعداد_خادم_ويب,
    منفذ_مشترك: منطقي
): نتيجة مستمع_تي_سي_بي, خطأ_خادم_ويب {
    دع العنوان: متغير عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة_العنوان) -> { العنوان := قيمة_العنوان; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب)); };
    إذا (منفذ_مشترك) { ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_المنفذ(صواب)); };
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(المستمع);
}

// A worker context around a listener: its own poller (with the listener at
// token 0, one-shot, when يسجل_المستمع) and its own connection table. حلقي asks for an
// io_uring poller where the kernel allows it (os.poll أنشئ_مستطلع_حلقي;
// SULTANC_IO_URING=0 keeps epoll), else epoll or kqueue.
عرف سياق_حدثي_لمستمع_ويب(
    المستمع: مستمع_تي_سي_بي,
    الحدود: &حدود_ويب,
    حلقي: منطقي,
    يسجل_المستمع: منطقي
): نتيجة سياق_خادم_حدثي_ويب, خطأ_خادم_ويب {
    دع المستطلع: مستطلع;
    دع ناتج_المستطلع: نتيجة مستطلع, عدد;
    إذا (حلقي) { ناتج_المستطلع := أنشئ_مستطلع_حلقي(); } وإلا { ناتج_المستطلع := أنشئ_مستطلع(); };
    طابق ناتج_المستطلع مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(ب) -> { المستطلع := ب; };
    إذا (يسجل_المستمع) {
        طابق سجل_في_مستطلع(&المستطلع, واصف_مستمع_تي_سي_بي(&المستمع), 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
            أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
        }
        | نتيجة.نجح(_) -> { };
    };
    دع الجدول: جدول_اتصالات_ويب = { الخانات: [], الحرة: [] };
    دع السياق: سياق_خادم_حدثي_ويب = {
        المستطلع: المستطلع,
        المستمع: المستمع,
        الجدول: أنشئ_قفل(الجدول),
        الحدود: *الحدود
    };
    أرجع نتيجة.نجح(السياق);
}

عرف شغل_خادم_ويب_بأحداث_داخلي<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    الخيوط: طبيعي,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    إذا (!هل_المستطلع_مدعوم()) {
        أرجع شغل_خادم_ويب(الإعداد, اقرأ_مشترك(&الحالة), الخدمة);
    };
    دع العدد: متغير طبيعي = الخيوط;
    إذا (العدد == 0) {
        طابق عدد_المعالجات_المتاحة() مع
        | نتيجة.نجح(ن) -> { العدد := ن; }
        | نتيجة.خطأ(_) -> { العدد := 1; };
    };
    إذا (العدد == 0) { العدد := 1; };
    دع شظايا: متغير منطقي = العدد > 1 && توزيع_المنفذ_مدعوم_ويب();
    // Port 0: every shard would bind its own ephemeral port, so one
    // listener and the acceptor instead.
    إذا (شظايا && منفذ_إعداد_ويب(الإعداد) == 0) { شظايا := خطأ; };
    إذا (العدد > 1 && !شظايا) {
        أرجع شغل_خادم_ويب_بموزع(الإعداد, الحالة, الخدمة, العدد, المسلم);
    };
    // Shards bind with SO_REUSEPORT, which would also let them join the
    // listeners of another process on the same address (a second copy of
    // this server), splitting its connections. First the address must be
    // free: a bind without SO_REUSEPORT fails there with "address already in
    // use", as uvicorn, Go's net/http and actix-web fail by default.
    // A refused plain bind can also mean only connections a previous run
    // left in TIME_WAIT (they keep SO_REUSEPORT, which a plain bind does not
    // pass): then a connection to the address is refused, and the shards
    // bind as before.
    إذا (شظايا) {
        طابق اربط_مستمع_حدثي_ويب(الإعداد, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (عنوان_إعداد_يستمع_ويب(الإعداد)) { أرجع نتيجة.خطأ(الخطأ); };
        }
        | نتيجة.نجح(المسبار) -> {
            دع تجاهل_المسبار: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المسبار);
        };
    };
    دع الأول: سياق_خادم_حدثي_ويب;
    طابق أنشئ_سياق_حدثي_ويب(الإعداد, شظايا) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(س) -> { الأول := س; };
    دع السياق: مشترك<سياق_خادم_حدثي_ويب> = أنشئ_مشترك(الأول);
    // العدد - 1 extra workers; this thread is the last one. After a shutdown
    // (http.shutdown) every worker returns; they are joined before this does.
    دع العمال: متغير متجه مقبض_خيط = [];
    دع ف: متغير طبيعي = 1;
    طالما (ف < العدد) {
        // Each shard binds its own listener and owns its poller and table;
        // its accept loop drains the listener until it would block. A
        // worker whose shard cannot be made shares the first one.
        دع سياقه: متغير مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&السياق);
        دع شظية_جديدة: متغير منطقي = خطأ;
        إذا (شظايا) {
            طابق أنشئ_سياق_حدثي_ويب(الإعداد, صواب) مع
            | نتيجة.خطأ(_) -> { }
            | نتيجة.نجح(س) -> { سياقه := أنشئ_مشترك(س); شظية_جديدة := صواب; };
        };
        دع شظيته: مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&سياقه);
        دع حالته: مشترك<S> = استنسخ_مشترك(&الحالة);
        دع مسلمه: اختياري مسلم_اتصال_ويب<S> = المسلم;
        طابق أطلق(دالة(): فراغ -> عامل_خادم_حدثي(سياقه, حالته, الخدمة, مسلمه)) مع
        | نتيجة.خطأ(_) -> {
            // No thread for this shard (none can start under the
            // interpreter, or the system refused one): its listener is
            // already bound with SO_REUSEPORT, and the kernel would hand it
            // connections nobody accepts, so it is closed with its poller.
            إذا (شظية_جديدة) { أغلق_شظية_حدثية_ويب(&شظيته); };
            ف := العدد;
        }
        | نتيجة.نجح(المقبض) -> { ألحق(العمال, المقبض); };
        ف := ف + 1;
    }
    عامل_خادم_حدثي(السياق, الحالة, الخدمة, المسلم);
    طالما ((الطول(العمال) مثل طبيعي) > 0) {
        طابق أزل_الأخير(العمال) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            دع المنضم: متغير مقبض_خيط = المقبض;
            انضم(&متغير المنضم);
        };
    }
    أرجع نتيجة.نجح(0);
}

// Without a balancing SO_REUSEPORT (macOS): one listener, and a worker that
// accepted until "would block" would take a whole burst of connections and
// leave the other workers idle. So, as libuv's and tokio's acceptors, this
// thread only accepts: each connection goes to the worker with the fewest
// open connections (ties in turn), into that worker's own table and poller,
// and stays there. The workers never watch the listener: no wake-up herd,
// and after the hand-over a connection touches only its worker's poller
// and lock. The acceptor waits at most 200 ms at a time, so it sees a
// shutdown request (http.shutdown), stops accepting, joins the workers and
// closes the listener.
عرف شغل_خادم_ويب_بموزع<S>(
    الإعداد: &إعداد_خادم_ويب,
    الحالة: مشترك<S>,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>,
    العدد: طبيعي,
    المسلم: اختياري مسلم_اتصال_ويب<S>
): نتيجة عدد, خطأ_خادم_ويب {
    دع المستمع: مستمع_تي_سي_بي;
    طابق اربط_مستمع_حدثي_ويب(الإعداد, خطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(م) -> { المستمع := م; };
    دع واصف_المستمع: عدد = واصف_مستمع_تي_سي_بي(&المستمع);
    // The acceptor's own poller, with the listener at token 0.
    دع المستطلع: مستطلع;
    طابق أنشئ_مستطلع() مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(ب) -> { المستطلع := ب; };
    طابق سجل_في_مستطلع(&المستطلع, واصف_المستمع, 0 مثل ط64, اهتمام_مستطلع.قراءة()) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
        دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الخطأ));
    }
    | نتيجة.نجح(_) -> { };
    // One context per worker; the listener box each holds is never used.
    دع السياقات: متغير متجه مشترك<سياق_خادم_حدثي_ويب> = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع غير_مستخدم: مستمع_تي_سي_بي = صندوق واصف_المستمع;
        طابق سياق_حدثي_لمستمع_ويب(غير_مستخدم, &(*الإعداد).الحدود, خطأ, خطأ) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا ((الطول(السياقات) مثل طبيعي) == 0) {
                دع تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
                دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
                أرجع نتيجة.خطأ(الخطأ);
            };
            ف := العدد;
        }
        | نتيجة.نجح(س) -> { ألحق(السياقات, أنشئ_مشترك(س)); };
        ف := ف + 1;
    }
    دع العمال: متغير متجه مقبض_خيط = [];
    دع الجاهزة: متغير متجه مشترك<سياق_خادم_حدثي_ويب> = [];
    ف := 0;
    طالما (ف < (الطول(السياقات) مثل طبيعي)) {
        دع سياقه: مشترك<سياق_خادم_حدثي_ويب> = استنسخ_مشترك(&السياقات[ف]);
        دع حالته: مشترك<S> = استنسخ_مشترك(&الحالة);
        دع مسلمه: اختياري مسلم_اتصال_ويب<S> = المسلم;
        طابق أطلق(دالة(): فراغ -> عامل_خادم_حدثي(سياقه, حالته, الخدمة, مسلمه)) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(المقبض) -> {
            ألحق(العمال, المقبض);
            ألحق(الجاهزة, استنسخ_مشترك(&السياقات[ف]));
        };
        ف := ف + 1;
    }
    إذا ((الطول(الجاهزة) مثل طبيعي) == 0) {
        // No worker thread could start: serve on this thread instead.
        دع تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
        دع تجاهل: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
        أرجع شغل_خادم_ويب(الإعداد, اقرأ_مشترك(&الحالة), الخدمة);
    };
    دع الأحداث: متغير مخزن_أحداث_مستطلع = أنشئ_مخزن_أحداث_مستطلع(4);
    دع الدور: متغير طبيعي = 0;
    طالما (!هل_طلب_إيقاف_الويب()) {
        طابق انتظر_مستطلع(&المستطلع, &متغير الأحداث, 200) مع
        | نتيجة.خطأ(_) -> { دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000); }
        | نتيجة.نجح(_) -> { };
        // Accept until "would block" (also after a timeout: a missed
        // readiness costs nothing), then re-arm the one-shot listener.
        دع يقبل: متغير منطقي = صواب;
        طالما (يقبل) {
            طابق اقبل_تي_سي_بي(&المستمع) مع
            | نتيجة.خطأ(الخطأ) -> {
                // EMFILE, ENOBUFS, ...: pause 1 ms rather than spin.
                إذا (!هل_خطأ_سيحظر(الخطأ) && !هل_خطأ_مقاطعة(الخطأ)) {
                    دع تجاهل_النوم: نتيجة عدد, عدد = نم_نانو(1000000);
                };
                إذا (!هل_خطأ_مقاطعة(الخطأ)) { يقبل := خطأ; };
            }
            | نتيجة.نجح(التدفق) -> {
                دع العامل: طبيعي = أقل_العمال_حملا(&الجاهزة, الدور);
                الدور := الدور + 1;
                سلم_تدفقا_لسياق_حدثي(اقرأ_مشترك(&الجاهزة[العامل]), التدفق);
            };
        }
        دع تجاهل_التسليح: نتيجة عدد, عدد = أعد_تسليح_في_مستطلع(
            &المستطلع, واصف_المستمع, 0 مثل ط64, اهتمام_مستطلع.قراءة()
        );
    }
    طالما ((الطول(العمال) مثل طبيعي) > 0) {
        طابق أزل_الأخير(العمال) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(المقبض) -> {
            دع المنضم: متغير مقبض_خيط = المقبض;
            انضم(&متغير المنضم);
        };
    }
    دع تجاهل_المستطلع: نتيجة عدد, عدد = أغلق_مستطلع(المستطلع);
    دع تجاهل_المستمع: عدد = أغلق_مقبس_تي_سي_بي_خام(واصف_المستمع);
    أرجع نتيجة.نجح(0);
}

// The worker with the fewest open connections, scanning from الدور so equal
// loads take turns.
عرف أقل_العمال_حملا(السياقات: &متجه مشترك<سياق_خادم_حدثي_ويب>, الدور: طبيعي): طبيعي {
    دع العدد: طبيعي = الطول(*السياقات) مثل طبيعي;
    دع الأفضل: متغير طبيعي = الدور % العدد;
    دع أقل_حمل: متغير طبيعي = عدد_اتصالات_سياق_حدثي(اقرأ_مشترك(&(*السياقات)[الأفضل]));
    دع ك: متغير طبيعي = 1;
    طالما (ك < العدد && أقل_حمل > 0) {
        دع ف: طبيعي = (الدور + ك) % العدد;
        دع الحمل: طبيعي = عدد_اتصالات_سياق_حدثي(اقرأ_مشترك(&(*السياقات)[ف]));
        إذا (الحمل < أقل_حمل) { الأفضل := ف; أقل_حمل := الحمل; };
        ك := ك + 1;
    }
    أرجع الأفضل;
}

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    عرف توزيع_المنفذ_مدعوم_ويب(): منطقي { أرجع صواب; }
}
إذا (!((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve»)) {
    عرف توزيع_المنفذ_مدعوم_ويب(): منطقي { أرجع خطأ; }
}

عام نوع http_server_config = إعداد_خادم_ويب;
عام مرادف http_server_error = خطأ_خادم_ويب;
عام مرادف default_http_server_config = إعداد_خادم_ويب_افتراضي;
عام مرادف run_http_server = شغل_خادم_ويب;
عام مرادف run_https_server = شغل_خادم_ويب_آمن;
عام مرادف serve_http_connection = خدم_اتصال_ويب;
عام مرادف serve_https_connection = خدم_اتصال_ويب_آمن;
عام مرادف http_server_error.http2 = خطأ_خادم_ويب.ويب2;
عام مرادف http_server_error.invalid_address = خطأ_خادم_ويب.عنوان_غير_صالح;
عام مرادف http_server_error.network = خطأ_خادم_ويب.شبكة;
عام مرادف http_server_error.protocol = خطأ_خادم_ويب.بروتوكول;
عام مرادف http_server_error.unsupported_protocol_transition = خطأ_خادم_ويب.انتقال_بروتوكول_غير_مدعوم;
عام مرادف run_http_server_evented = شغل_خادم_ويب_بأحداث;
عام مرادف run_http_server_evented_with_handover = شغل_خادم_ويب_بأحداث_مع_تسليم;
عام مرادف serve_http_connection_with_handover = خدم_اتصال_ويب_مع_تسليم;
عام مرادف serve_https_connection_with_handover = خدم_اتصال_ويب_آمن_مع_تسليم;
