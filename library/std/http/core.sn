عام عرف أضف_مسار_delete_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة غير_موقع, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «DELETE»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_head_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة غير_موقع, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «HEAD»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_options_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة غير_موقع, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «OPTIONS»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }


عام عرف فئة_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب): نص { دع النوع: نوع_وسائط_ويب = *القيمة; أرجع انسخ_نص_ويب(&النوع.الفئة); }
عام عرف فرعي_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب): نص { دع النوع: نوع_وسائط_ويب = *القيمة; أرجع انسخ_نص_ويب(&النوع.النوع_الفرعي); }
عام عرف اسم_كعكة_ويب(القيمة: &زوج_كعكة_ويب): نص { دع الزوج: زوج_كعكة_ويب = *القيمة; أرجع انسخ_نص_ويب(&الزوج.الاسم); }
عام عرف قيمة_كعكة_ويب(القيمة: &زوج_كعكة_ويب): نص { دع الزوج: زوج_كعكة_ويب = *القيمة; أرجع انسخ_نص_ويب(&الزوج.القيمة); }

عام عرف ابن_رأس_تعيين_كعكة_ويب_بسيط(الاسم: &نص, القيمة: &نص): اختيار نص {
    دع المسار: نص = «»;
    دع المجال: نص = «»;
    أرجع ابن_رأس_تعيين_كعكة_ويب(الاسم, القيمة, &المسار, &المجال, خطأ, 0, خطأ, خطأ, سياسة_نفس_موقع_كعكة_ويب.غير_محدد());
}

