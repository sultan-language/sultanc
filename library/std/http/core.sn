عام عرف ضع_إصدار_استجابة_ويب(الاستجابة: &متغير استجابة_ويب_مخزنة, الإصدار: إصدار_ويب): فراغ { دع القيمة: متغير استجابة_ويب_مخزنة = *الاستجابة; القيمة.الإصدار := الإصدار; *الاستجابة := القيمة; }
عام عرف حالة_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): غير_موقع { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع القيمة.الحالة; }
عام عرف جسم_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): متجه غ8 { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع انسخ_بايتات_ويب(&القيمة.الجسم, 0, الطول(القيمة.الجسم) مثل غير_موقع); }
عام عرف أول_رأس_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة, الاسم: &نص): اختيار نص { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع أول_قيمة_رأس_ويب(&القيمة.الرؤوس, الاسم); }
عام عرف بايتات_طلب_مستهلكة(المحلل: &طلب_ويب_محلل): غير_موقع { دع القيمة: طلب_ويب_محلل = *المحلل; أرجع القيمة.المستهلك; }
عام عرف طلب_من_طلب_محلل(المحلل: &طلب_ويب_محلل): طلب_ويب_مخزن {
