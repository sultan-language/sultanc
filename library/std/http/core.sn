عام عرف قيمة_زوج_استعلام_ويب(الزوج: &زوج_استعلام_ويب): نص { دع القيمة: زوج_استعلام_ويب = *الزوج; أرجع انسخ_نص_ويب(&القيمة.القيمة); }

// Router core. Route patterns use /literal/{param}/{*tail}. Static segments
// outrank parameters, and catch-all routes rank below non-catch-all routes.
عام نوع جزء_مسار_ويب =
    | ثابت بنوع نص
    | معامل بنوع نص
    | بقية بنوع نص
;

عام نوع معامل_مسار_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع معاملات_مسار_ويب = {
    القيم: متجه معامل_مسار_ويب
};

عام نوع معالج_مسار_ويب<S> = دالة(&S, &طلب_ويب_مخزن, &معاملات_مسار_ويب): استجابة_ويب_مخزنة;

عام نوع مسار_ويب<S> = {
    الطريقة: نص,
    النمط: نص,
    الأجزاء: متجه جزء_مسار_ويب,
    الثوابت: غير_موقع,
    لديه_بقية: منطقي,
    المعالج: معالج_مسار_ويب<S>
};

عام نوع موجه_ويب<S> = {
    الحالة: S,
    المسارات: متجه مسار_ويب<S>
};

عام نوع صنف_خطأ_موجه_ويب =
    | نمط_غير_صالح
    | اسم_معامل_غير_صالح
    | معامل_مكرر
    | بقية_ليست_أخيرة
    | مسار_مكرر
    | طريقة_غير_صالحة
;

عام عرف موجه_ويب_جديد<S>(الحالة: S): موجه_ويب<S> {
    دع المسارات: متجه مسار_ويب<S> = [];
    دع الناتج: موجه_ويب<S> = { الحالة: الحالة, المسارات: المسارات };
    أرجع الناتج;
}

عرف اسم_معامل_مسار_ويب_صالح(الاسم: &نص): منطقي {
    دع القيمة: نص = *الاسم;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ب: غ8 = القيمة[ف];
        لو (!(حرف_أو_رقم_أسكي(ب) || (ب == 0x5F))) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_معامل_موجود(الأجزاء: &متجه جزء_مسار_ويب, الاسم: &نص): منطقي {
    دع القيم: متجه جزء_مسار_ويب = *الأجزاء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق القيم[ف] مع
        | جزء_مسار_ويب.معامل(قيمة) -> { لو (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | جزء_مسار_ويب.بقية(قيمة) -> { لو (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف حلل_نمط_مسار_ويب(النمط: &نص): نتيجة متجه جزء_مسار_ويب, صنف_خطأ_موجه_ويب {
    دع القيمة: نص = *النمط;
    لو (((الطول(القيمة) مثل غير_موقع) == 0) || (القيمة[0] != 0x2F)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.نمط_غير_صالح()); };
    دع فاصل_المسار: نص = «/»;
    دع النصوص: متجه نص = قسم_النص(&القيمة, &فاصل_المسار);
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(النصوص) مثل غير_موقع)) {
        دع الجزء: نص = انسخ_نص_ويب(&النصوص[ف]);
        دع الطول_الجزء: غير_موقع = الطول(الجزء) مثل غير_موقع;
        دع آخر_جزء: متغير غير_موقع = 0;
        لو (الطول_الجزء > 0) { آخر_جزء := الطول_الجزء - 1; };
        لو ((الطول_الجزء >= 2) && (الجزء[0] == 0x7B) && (الجزء[آخر_جزء] == 0x7D)) {
            دع بداية_الاسم: متغير غير_موقع = 1;
            دع بقية: متغير منطقي = خطأ;
            لو ((الطول_الجزء >= 3) && (الجزء[1] == 0x2A)) { بداية_الاسم := 2; بقية := صواب; };
            دع الاسم: متغير نص = «»;
            طابق مقطع_نص(&الجزء, بداية_الاسم, الطول_الجزء - بداية_الاسم - 1) مع | اختيار.بعض(قيمة_الاسم) -> { الاسم := قيمة_الاسم; } | _ -> { };
            لو (!اسم_معامل_مسار_ويب_صالح(&الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.اسم_معامل_غير_صالح()); };
            لو (اسم_معامل_موجود(&الأجزاء, &الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.معامل_مكرر()); };
            لو (بقية) {
                لو ((ف + 1) != (الطول(النصوص) مثل غير_موقع)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.بقية_ليست_أخيرة()); };
                ألحق(الأجزاء, جزء_مسار_ويب.بقية(الاسم));
            } وإلا {
                ألحق(الأجزاء, جزء_مسار_ويب.معامل(الاسم));
            };
        } وإلا {
            ألحق(الأجزاء, جزء_مسار_ويب.ثابت(الجزء));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الأجزاء);
}

عرف مساران_مسجلان_متساويان<S>(المسار: &مسار_ويب<S>, الطريقة: &نص, النمط: &نص): منطقي {
    دع القيمة: مسار_ويب<S> = *المسار;
    أرجع نصان_متساويان(&القيمة.الطريقة, الطريقة) && نصان_متساويان(&القيمة.النمط, النمط);
}

عام عرف أضف_مسار_ويب<S>(
    الموجه: &متغير موجه_ويب<S>,
    الطريقة: &نص,
    النمط: &نص,
    المعالج: معالج_مسار_ويب<S>
): نتيجة غير_موقع, صنف_خطأ_موجه_ويب {
    لو (!طريقة_ويب_صالحة(الطريقة)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.طريقة_غير_صالحة()); };
    دع الحالية: متغير موجه_ويب<S> = *الموجه;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالية.المسارات) مثل غير_موقع)) {
        لو (مساران_مسجلان_متساويان(&الحالية.المسارات[ف], الطريقة, النمط)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.مسار_مكرر()); };
        ف := ف + 1;
    }
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    طابق حلل_نمط_مسار_ويب(النمط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيم) -> { الأجزاء := قيم; };
    دع الثوابت: متغير غير_موقع = 0;
    دع لديه_بقية: متغير منطقي = خطأ;
    ف := 0;
    بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
        طابق الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(_) -> { الثوابت := الثوابت + 1; }
        | جزء_مسار_ويب.بقية(_) -> { لديه_بقية := صواب; }
        | _ -> { };
        ف := ف + 1;
    }
    دع طريقة_المسار: نص = انسخ_نص_ويب(الطريقة);
    دع نمط_المسار: نص = انسخ_نص_ويب(النمط);
    دع المسار: مسار_ويب<S> = {
        الطريقة: طريقة_المسار,
        النمط: نمط_المسار,
        الأجزاء: الأجزاء,
        الثوابت: الثوابت,
        لديه_بقية: لديه_بقية,
        المعالج: المعالج
    };
    دع الموضع: غير_موقع = الطول(الحالية.المسارات) مثل غير_موقع;
    ألحق(الحالية.المسارات, المسار);
    *الموجه := الحالية;
    أرجع نتيجة.نجح(الموضع);
}

عرف طابق_أجزاء_مسار_ويب<S>(المسار: &مسار_ويب<S>, المسار_الفعلي: &نص): اختيار معاملات_مسار_ويب {
    دع تعريف_المسار: مسار_ويب<S> = *المسار;
    دع النص: نص = *المسار_الفعلي;
    دع فاصل_المسار: نص = «/»;
    دع الأجزاء_الفعلية: متجه نص = قسم_النص(&النص, &فاصل_المسار);
    دع بداية: غير_موقع = 1;
    دع طول_الأجزاء_الفعلية: غير_موقع = الطول(الأجزاء_الفعلية) مثل غير_موقع;
    دع عدد_فعلي: غير_موقع = طول_الأجزاء_الفعلية - بداية;
    دع عدد_نمط: غير_موقع = الطول(تعريف_المسار.الأجزاء) مثل غير_موقع;
    لو (!تعريف_المسار.لديه_بقية && (عدد_فعلي != عدد_نمط)) { أرجع اختيار.لا_شيء(); };
    لو (تعريف_المسار.لديه_بقية && (عدد_فعلي + 1 < عدد_نمط)) { أرجع اختيار.لا_شيء(); };
    دع القيم: متغير متجه معامل_مسار_ويب = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_نمط) {
        طابق تعريف_المسار.الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(المطلوب) -> {
            لو (ف >= عدد_فعلي) { أرجع اختيار.لا_شيء(); };
            دع موضع_الجزء: غير_موقع = بداية + ف;
            لو (!نصان_متساويان(&المطلوب, &الأجزاء_الفعلية[موضع_الجزء])) { أرجع اختيار.لا_شيء(); };
        }
        | جزء_مسار_ويب.معامل(الاسم) -> {
            لو (ف >= عدد_فعلي) { أرجع اختيار.لا_شيء(); };
            دع موضع_المعامل: غير_موقع = بداية + ف;
            دع قيمة_المعامل: نص = انسخ_نص_ويب(&الأجزاء_الفعلية[موضع_المعامل]);
            دع المعامل: معامل_مسار_ويب = { الاسم: الاسم, القيمة: قيمة_المعامل };
            ألحق(القيم, المعامل);
        }
        | جزء_مسار_ويب.بقية(الاسم) -> {
            دع البقية: متغير متجه نص = [];
            دع ك: متغير غير_موقع = بداية + ف;
            بينما (ك < (الطول(الأجزاء_الفعلية) مثل غير_موقع)) { ألحق(البقية, انسخ_نص_ويب(&الأجزاء_الفعلية[ك])); ك := ك + 1; }
            دع فاصل: نص = «/»;
            دع القيمة: نص = صل_النصوص(&البقية, &فاصل);
            دع المعامل: معامل_مسار_ويب = { الاسم: الاسم, القيمة: القيمة };
            ألحق(القيم, المعامل);
            ف := عدد_نمط;
        };
        ف := ف + 1;
    }
    دع الناتج: معاملات_مسار_ويب = { القيم: القيم };
    أرجع اختيار.بعض(الناتج);
}

عام عرف قيمة_معامل_مسار_ويب(المعاملات: &معاملات_مسار_ويب, الاسم: &نص): اختيار نص {
    دع الحالة: معاملات_مسار_ويب = *المعاملات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.القيم[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(انسخ_نص_ويب(&الحالة.القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف مسار_أفضل<S>(المرشح: &مسار_ويب<S>, الحالي: &مسار_ويب<S>): منطقي {
    دع أ: مسار_ويب<S> = *المرشح;
    دع ب: مسار_ويب<S> = *الحالي;
    لو (أ.الثوابت > ب.الثوابت) { أرجع صواب; };
    لو (أ.الثوابت < ب.الثوابت) { أرجع خطأ; };
    لو (!أ.لديه_بقية && ب.لديه_بقية) { أرجع صواب; };
    لو (أ.لديه_بقية && !ب.لديه_بقية) { أرجع خطأ; };
    أرجع (الطول(أ.الأجزاء) مثل غير_موقع) > (الطول(ب.الأجزاء) مثل غير_موقع);
}

عام عرف وجه_طلب_ويب<S>(الموجه: &موجه_ويب<S>, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    دع حالة_الموجه: موجه_ويب<S> = *الموجه;
    دع قيمة_الطلب: طلب_ويب_مخزن = *الطلب;
    دع المسار_الفعلي: نص = مسار_هدف_ويب(&قيمة_الطلب.الهدف);
    دع أفضل: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع قيم_معاملات_فارغة: متجه معامل_مسار_ويب = [];
    دع أفضل_معاملات: متغير معاملات_مسار_ويب = { القيم: قيم_معاملات_فارغة };
    دع وجد_المسار: متغير منطقي = خطأ;
    دع الطرق_المسموحة: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_الموجه.المسارات) مثل غير_موقع)) {
        طابق طابق_أجزاء_مسار_ويب(&حالة_الموجه.المسارات[ف], &المسار_الفعلي) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المعاملات) -> {
            وجد_المسار := صواب;
            لو (!نصان_متساويان(&حالة_الموجه.المسارات[ف].الطريقة, &قيمة_الطلب.الطريقة)) {
                ألحق(الطرق_المسموحة, انسخ_نص_ويب(&حالة_الموجه.المسارات[ف].الطريقة));
            } وإلا {
                طابق أفضل مع
                | اختيار.لا_شيء -> { أفضل := اختيار.بعض(ف); أفضل_معاملات := المعاملات; }
                | اختيار.بعض(الموضع_الحالي) -> {
                    لو (مسار_أفضل(&حالة_الموجه.المسارات[ف], &حالة_الموجه.المسارات[الموضع_الحالي])) {
                        أفضل := اختيار.بعض(ف);
                        أفضل_معاملات := المعاملات;
                    };
                };
            };
        };
        ف := ف + 1;
    }
    طابق أفضل مع
    | اختيار.بعض(الموضع) -> {
        أرجع حالة_الموجه.المسارات[الموضع].المعالج(&حالة_الموجه.الحالة, &قيمة_الطلب, &أفضل_معاملات);
    }
    | اختيار.لا_شيء -> { };
    لو (وجد_المسار) {
        دع نص_خطأ: نص = «Method Not Allowed»;
        دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_نص_ويب(405, &نص_خطأ);
        لو ((الطول(الطرق_المسموحة) مثل غير_موقع) > 0) {
            دع فاصلة: نص = «, »;
            دع السماح: نص = صل_النصوص(&الطرق_المسموحة, &فاصلة);
            دع الاسم: نص = «allow»;
            دع أضيف_السماح: منطقي = أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, &السماح);
        };
        أرجع الناتج;
    };
    دع نص_خطأ: نص = «Not Found»;
    أرجع استجابة_نص_ويب(404, &نص_خطأ);
}

عام نوع تبادل_ويب1 = {
    بايتات_الاستجابة: متجه غ8,
    بايتات_الطلب_المستهلكة: غير_موقع
};

عام عرف عالج_بايتات_ويب1<S>(
    الموجه: &موجه_ويب<S>,
    البايتات: &متجه غ8,
    الحدود: &حدود_ويب
): نتيجة تبادل_ويب1, خطأ_ويب {
    طابق حلل_طلب_ويب1(البايتات, الحدود) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلل) -> {
        دع الاستجابة: متغير استجابة_ويب_مخزنة = وجه_طلب_ويب(الموجه, &المحلل.الطلب);
        دع إصدار_الطلب: إصدار_ويب = المحلل.الطلب.الإصدار;
        ضع_إصدار_استجابة_ويب(&متغير الاستجابة, إصدار_الطلب);
        طابق سلسل_استجابة_ويب1_لطلب(&المحلل.الطلب, &الاستجابة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(بايتات_الاستجابة) -> {
            دع المستهلك: غير_موقع = المحلل.المستهلك;
            دع الناتج: تبادل_ويب1 = { بايتات_الاستجابة: بايتات_الاستجابة, بايتات_الطلب_المستهلكة: المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}


// Framework-facing HTTP application helpers. These stay transport-neutral and
// operate only on the generic/buffered HTTP message model above.
عام نوع معامل_نوع_وسائط_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع نوع_وسائط_ويب = {
    الفئة: نص,
    النوع_الفرعي: نص,
    المعلمات: متجه معامل_نوع_وسائط_ويب
};

عام نوع صنف_خطأ_نوع_وسائط_ويب =
    | صيغة_غير_صالحة
    | رمز_غير_صالح
    | اقتباس_غير_مغلق
;

عرف نص_ويب_صغير(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(البايتات, إلى_صغير_أسكي(النص[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف مدى_بعد_فراغ_ويب(النص: &نص, البداية: غير_موقع, النهاية: غير_موقع): غير_موقع {
    دع القيمة: نص = *النص;
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف < النهاية) && ((القيمة[ف] == 0x20) || (القيمة[ف] == 0x09))) { ف := ف + 1; }
    أرجع ف;
}

عرف مدى_قبل_فراغ_ويب(النص: &نص, البداية: غير_موقع, النهاية: غير_موقع): غير_موقع {
    دع القيمة: نص = *النص;
    دع ف: متغير غير_موقع = النهاية;
    بينما (ف > البداية) {
        دع السابق: غير_موقع = ف - 1;
        لو ((القيمة[السابق] == 0x20) || (القيمة[السابق] == 0x09)) { ف := السابق; } وإلا { أرجع ف; };
    }
    أرجع ف;
}

عرف رمز_نوع_وسائط_ويب_صالح(النص: &نص): منطقي {
    دع القيمة: نص = *النص;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (!حرف_رمز_ويب(القيمة[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف فك_قيمة_معامل_نوع_وسائط_ويب(النص: &نص): نتيجة نص, صنف_خطأ_نوع_وسائط_ويب {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو (العدد == 0) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
    لو (القيمة[0] != 0x22) {
        لو (!رمز_نوع_وسائط_ويب_صالح(&القيمة)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
        أرجع نتيجة.نجح(القيمة);
    };
    لو (العدد < 2) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
    دع آخر: غير_موقع = العدد - 1;
    لو (القيمة[آخر] != 0x22) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 1;
    دع النهاية: غير_موقع = العدد - 1;
    بينما (ف < النهاية) {
        دع ب: غ8 = القيمة[ف];
        لو (ب == 0x5C) {
            دع التالي: غير_موقع = ف + 1;
            لو (التالي >= النهاية) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
            دع ب2: غ8 = القيمة[التالي];
            لو ((ب2 == 0x0D) || (ب2 == 0x0A)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ألحق(الناتج, ب2);
            ف := ف + 2;
        } وإلا {
            لو ((ب == 0x0D) || (ب == 0x0A) || (ب == 0x00)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ألحق(الناتج, ب);
            ف := ف + 1;
        };
    }
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}

عام عرف حلل_نوع_وسائط_ويب(النص: &نص): نتيجة نوع_وسائط_ويب, صنف_خطأ_نوع_وسائط_ويب {
    دع القيمة: نص = *النص;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    دع البداية: غير_موقع = مدى_بعد_فراغ_ويب(&القيمة, 0, العدد);
    دع نهاية_القيمة: غير_موقع = مدى_قبل_فراغ_ويب(&القيمة, البداية, العدد);
    دع بايتات_القيمة: متجه غ8 = بايتات_ويب_من_نص(&القيمة);
    دع فاصلة_منقوطة: متغير غير_موقع = نهاية_القيمة;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < نهاية_القيمة) {
        لو (القيمة[ف] == 0x3B) { فاصلة_منقوطة := ف; ف := نهاية_القيمة; } وإلا { ف := ف + 1; };
    }
    دع شرطة: متغير غير_موقع = فاصلة_منقوطة;
    ف := البداية;
    بينما (ف < فاصلة_منقوطة) {
        لو (القيمة[ف] == 0x2F) { شرطة := ف; ف := فاصلة_منقوطة; } وإلا { ف := ف + 1; };
    }
    لو ((شرطة == البداية) || (شرطة >= فاصلة_منقوطة)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
    دع نهاية_الفئة: غير_موقع = مدى_قبل_فراغ_ويب(&القيمة, البداية, شرطة);
    دع بداية_الفرعي: غير_موقع = مدى_بعد_فراغ_ويب(&القيمة, شرطة + 1, فاصلة_منقوطة);
    دع نهاية_الفرعي: غير_موقع = مدى_قبل_فراغ_ويب(&القيمة, بداية_الفرعي, فاصلة_منقوطة);
    دع الفئة_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, البداية, نهاية_الفئة);
    دع الفرعي_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_الفرعي, نهاية_الفرعي);
    لو (!رمز_نوع_وسائط_ويب_صالح(&الفئة_الخام) || !رمز_نوع_وسائط_ويب_صالح(&الفرعي_الخام)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
    دع الفئة: نص = نص_ويب_صغير(&الفئة_الخام);
    دع الفرعي: نص = نص_ويب_صغير(&الفرعي_الخام);
    دع المعلمات: متغير متجه معامل_نوع_وسائط_ويب = [];
    ف := فاصلة_منقوطة;
    بينما (ف < نهاية_القيمة) {
        لو (القيمة[ف] == 0x3B) { ف := ف + 1; };
        ف := مدى_بعد_فراغ_ويب(&القيمة, ف, نهاية_القيمة);
        لو (ف >= نهاية_القيمة) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
        دع بداية_الاسم: غير_موقع = ف;
        بينما ((ف < نهاية_القيمة) && (القيمة[ف] != 0x3D) && (القيمة[ف] != 0x3B)) { ف := ف + 1; }
        لو ((ف >= نهاية_القيمة) || (القيمة[ف] != 0x3D)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
        دع نهاية_الاسم: غير_موقع = مدى_قبل_فراغ_ويب(&القيمة, بداية_الاسم, ف);
        دع الاسم_الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_الاسم, نهاية_الاسم);
        لو (!رمز_نوع_وسائط_ويب_صالح(&الاسم_الخام)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.رمز_غير_صالح()); };
        دع الاسم: نص = نص_ويب_صغير(&الاسم_الخام);
        ف := ف + 1;
        ف := مدى_بعد_فراغ_ويب(&القيمة, ف, نهاية_القيمة);
        دع بداية_القيمة: غير_موقع = ف;
        دع نهاية_المعامل_الخام: متغير غير_موقع = ف;
        لو ((ف < نهاية_القيمة) && (القيمة[ف] == 0x22)) {
            ف := ف + 1;
            دع هروب: متغير منطقي = خطأ;
            دع أغلق: متغير منطقي = خطأ;
            بينما ((ف < نهاية_القيمة) && !أغلق) {
                دع ب: غ8 = القيمة[ف];
                لو (هروب) { هروب := خطأ; ف := ف + 1; }
                وإلا لو (ب == 0x5C) { هروب := صواب; ف := ف + 1; }
                وإلا لو (ب == 0x22) { ف := ف + 1; نهاية_المعامل_الخام := ف; أغلق := صواب; }
                وإلا { ف := ف + 1; };
            }
            لو (!أغلق) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.اقتباس_غير_مغلق()); };
            دع بعد_القيمة: غير_موقع = مدى_بعد_فراغ_ويب(&القيمة, ف, نهاية_القيمة);
            لو ((بعد_القيمة < نهاية_القيمة) && (القيمة[بعد_القيمة] != 0x3B)) { أرجع نتيجة.خطأ(صنف_خطأ_نوع_وسائط_ويب.صيغة_غير_صالحة()); };
            ف := بعد_القيمة;
        } وإلا {
            بينما ((ف < نهاية_القيمة) && (القيمة[ف] != 0x3B)) { ف := ف + 1; }
            نهاية_المعامل_الخام := مدى_قبل_فراغ_ويب(&القيمة, بداية_القيمة, ف);
        };
        دع قيمة_خام: نص = نص_ويب_من_مدى(&بايتات_القيمة, بداية_القيمة, نهاية_المعامل_الخام);
        دع قيمة_المعامل: متغير نص = «»;
        طابق فك_قيمة_معامل_نوع_وسائط_ويب(&قيمة_خام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة_مفكوكة) -> { قيمة_المعامل := قيمة_مفكوكة; };
        دع المعامل: معامل_نوع_وسائط_ويب = { الاسم: الاسم, القيمة: قيمة_المعامل };
        ألحق(المعلمات, المعامل);
        بينما ((ف < نهاية_القيمة) && (القيمة[ف] != 0x3B)) { ف := ف + 1; }
    }
    دع الناتج: نوع_وسائط_ويب = { الفئة: الفئة, النوع_الفرعي: الفرعي, المعلمات: المعلمات };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف نوع_وسائط_ويب_يطابق(القيمة: &نوع_وسائط_ويب, الفئة: &نص, النوع_الفرعي: &نص): منطقي {
    دع النوع: نوع_وسائط_ويب = *القيمة;
    دع أ: نص = نص_ويب_صغير(الفئة);
    دع ب: نص = نص_ويب_صغير(النوع_الفرعي);
    أرجع نصان_متساويان(&النوع.الفئة, &أ) && نصان_متساويان(&النوع.النوع_الفرعي, &ب);
}

عام عرف قيمة_معامل_نوع_وسائط_ويب(القيمة: &نوع_وسائط_ويب, الاسم: &نص): اختيار نص {
    دع النوع: نوع_وسائط_ويب = *القيمة;
    دع المطلوب: نص = نص_ويب_صغير(الاسم);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النوع.المعلمات) مثل غير_موقع)) {
        لو (نصان_متساويان(&النوع.المعلمات[ف].الاسم, &المطلوب)) { أرجع اختيار.بعض(انسخ_نص_ويب(&النوع.المعلمات[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام نوع صنف_خطأ_جسم_ويب =
    | يوتيف8_غير_صالح
    | نوع_محتوى_مفقود
    | نوع_محتوى_غير_صالح
    | نوع_محتوى_غير_متوقع
    | نموذج_غير_صالح
;

عرف بايتات_ويب_يوتيف8_صالحة(البايتات: &متجه غ8): منطقي {
    دع القيمة: متجه غ8 = *البايتات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8_من_بايتات(&القيمة, ف);
        لو (!المفكوك.صالح || (المفكوك.العرض == 0)) { أرجع خطأ; };
        ف := ف + المفكوك.العرض;
    }
    أرجع صواب;
}

عام عرف نص_جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): نتيجة نص, صنف_خطأ_جسم_ويب {
    دع القيمة: طلب_ويب_مخزن = *الطلب;
    لو (!بايتات_ويب_يوتيف8_صالحة(&القيمة.الجسم)) { أرجع نتيجة.خطأ(صنف_خطأ_جسم_ويب.يوتيف8_غير_صالح()); };
    أرجع نتيجة.نجح(من_بايتات(&القيمة.الجسم));
}

عرف تحقق_نوع_محتوى_طلب_ويب(الطلب: &طلب_ويب_مخزن, الفئة: &نص, الفرعي: &نص): اختيار صنف_خطأ_جسم_ويب {
    دع الاسم: نص = «content-type»;
    طابق أول_رأس_طلب_ويب(الطلب, &الاسم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.بعض(صنف_خطأ_جسم_ويب.نوع_محتوى_مفقود()); }
    | اختيار.بعض(القيمة) -> {
        طابق حلل_نوع_وسائط_ويب(&القيمة) مع
        | نتيجة.خطأ(_) -> { أرجع اختيار.بعض(صنف_خطأ_جسم_ويب.نوع_محتوى_غير_صالح()); }
        | نتيجة.نجح(النوع) -> {
            لو (!نوع_وسائط_ويب_يطابق(&النوع, الفئة, الفرعي)) { أرجع اختيار.بعض(صنف_خطأ_جسم_ويب.نوع_محتوى_غير_متوقع()); };
            أرجع اختيار.لا_شيء();
        };
    };
}

عام نوع نتيجة_جسون_طلب_ويب =
    | جسون بنوع وثيقة_جسون
    | خطأ_جسم بنوع صنف_خطأ_جسم_ويب
    | خطأ_جسون بنوع خطأ_جسون
;

عام عرف جسون_جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): نتيجة_جسون_طلب_ويب {
    دع فئة: نص = «application»;
    دع فرعي: نص = «json»;
    طابق تحقق_نوع_محتوى_طلب_ويب(الطلب, &فئة, &فرعي) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة_جسون_طلب_ويب.خطأ_جسم(الخطأ); }
    | اختيار.لا_شيء -> { };
    طابق نص_جسم_طلب_ويب(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_جسون_طلب_ويب.خطأ_جسم(الخطأ); }
    | نتيجة.نجح(النص) -> {
        طابق حلل_جسون(&النص) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة_جسون_طلب_ويب.خطأ_جسون(الخطأ); }
        | نتيجة.نجح(الوثيقة) -> { أرجع نتيجة_جسون_طلب_ويب.جسون(الوثيقة); };
    };
}

عام عرف نتيجة_جسون_جسم_ويب_صالحة(النتيجة: &نتيجة_جسون_طلب_ويب): منطقي {
    دع القيمة: نتيجة_جسون_طلب_ويب = *النتيجة;
    طابق القيمة مع
    | نتيجة_جسون_طلب_ويب.جسون(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عام عرف نموذج_جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): نتيجة متجه زوج_استعلام_ويب, صنف_خطأ_جسم_ويب {
    دع فئة: نص = «application»;
    دع فرعي: نص = «x-www-form-urlencoded»;
    طابق تحقق_نوع_محتوى_طلب_ويب(الطلب, &فئة, &فرعي) مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { };
    طابق نص_جسم_طلب_ويب(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النص) -> {
        طابق حلل_استعلام_ويب(&النص) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(صنف_خطأ_جسم_ويب.نموذج_غير_صالح()); }
        | نتيجة.نجح(الأزواج) -> { أرجع نتيجة.نجح(الأزواج); };
    };
}

عام عرف استجابة_بايتات_ويب(الحالة: غير_موقع, الجسم: متجه غ8, نوع_المحتوى: &نص): استجابة_ويب_مخزنة {
    دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_ويب_مخزنة_جديدة(الحالة, الجسم);
    لو ((الطول(*نوع_المحتوى) مثل غير_موقع) > 0) {
        دع الاسم: نص = «content-type»;
        دع أضيف: منطقي = أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, نوع_المحتوى);
    };
    أرجع الناتج;
}

عام عرف استجابة_فارغة_ويب(الحالة: غير_موقع): استجابة_ويب_مخزنة {
    دع الجسم: متجه غ8 = [];
    أرجع استجابة_ويب_مخزنة_جديدة(الحالة, الجسم);
}

عام عرف استجابة_جسون_ويب(الحالة: غير_موقع, الوثيقة: &وثيقة_جسون): نتيجة استجابة_ويب_مخزنة, صنف_خطأ_جسون {
    طابق جسون_إلى_نص(الوثيقة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النص) -> {
        دع الجسم: متجه غ8 = بايتات_ويب_من_نص(&النص);
        دع النوع: نص = «application/json; charset=utf-8»;
        أرجع نتيجة.نجح(استجابة_بايتات_ويب(الحالة, الجسم, &النوع));
    };
}

عام عرف استجابة_إعادة_توجيه_ويب(الحالة: غير_موقع, الموقع: &نص): اختيار استجابة_ويب_مخزنة {
    لو (!((الحالة == 301) || (الحالة == 302) || (الحالة == 303) || (الحالة == 307) || (الحالة == 308))) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_فارغة_ويب(الحالة);
    دع الاسم: نص = «location»;
    لو (!أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, الموقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(الناتج);
}

عام نوع زوج_كعكة_ويب = {
    الاسم: نص,
    القيمة: نص
};

عرف محرف_قيمة_كعكة_ويب_صالح(ب: غ8): منطقي {
    أرجع (ب == 0x21) || ((ب >= 0x23) && (ب <= 0x2B)) || ((ب >= 0x2D) && (ب <= 0x3A)) || ((ب >= 0x3C) && (ب <= 0x5B)) || ((ب >= 0x5D) && (ب <= 0x7E));
}

عرف قيمة_كعكة_ويب_صالحة(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) { لو (!محرف_قيمة_كعكة_ويب_صالح(النص[ف])) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عرف فك_قيمة_كعكة_ويب(القيمة: &نص): اختيار نص {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    لو ((العدد >= 2) && (النص[0] == 0x22)) {
        دع الأخير: غير_موقع = العدد - 1;
        لو (النص[الأخير] != 0x22) { أرجع اختيار.لا_شيء(); };
        دع البايتات: متجه غ8 = بايتات_ويب_من_نص(&النص);
        دع الداخل: نص = نص_ويب_من_مدى(&البايتات, 1, الأخير);
        لو (!قيمة_كعكة_ويب_صالحة(&الداخل)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(الداخل);
    };
    لو (!قيمة_كعكة_ويب_صالحة(&النص)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(النص);
}

عرف قيمة_خاصية_كعكة_ويب_صالحة(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        دع ب: غ8 = النص[ف];
        لو ((ب == 0x3B) || (ب == 0x0D) || (ب == 0x0A) || (ب == 0x00) || (ب < 0x20) || (ب == 0x7F)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف حلل_كعكات_ويب(الرؤوس: &متجه رأس_ويب): متجه زوج_كعكة_ويب {
    دع الاسم_الرأس: نص = «cookie»;
    دع قيم_الرأس: متجه نص = قيم_رأس_ويب(الرؤوس, &الاسم_الرأس);
    دع الناتج: متغير متجه زوج_كعكة_ويب = [];
    دع ه: متغير غير_موقع = 0;
    بينما (ه < (الطول(قيم_الرأس) مثل غير_موقع)) {
        دع النص: نص = انسخ_نص_ويب(&قيم_الرأس[ه]);
        دع بايتات_النص: متجه غ8 = بايتات_ويب_من_نص(&النص);
        دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
        دع البداية: متغير غير_موقع = 0;
        بينما (البداية < العدد) {
            دع النهاية: متغير غير_موقع = البداية;
            بينما ((النهاية < العدد) && (النص[النهاية] != 0x3B)) { النهاية := النهاية + 1; }
            دع أ: غير_موقع = مدى_بعد_فراغ_ويب(&النص, البداية, النهاية);
            دع ب: غير_موقع = مدى_قبل_فراغ_ويب(&النص, أ, النهاية);
            دع مساواة: متغير غير_موقع = أ;
            بينما ((مساواة < ب) && (النص[مساواة] != 0x3D)) { مساواة := مساواة + 1; }
            لو ((مساواة > أ) && (مساواة < ب)) {
                دع اسم_خام: نص = نص_ويب_من_مدى(&بايتات_النص, أ, مساواة);
                دع بداية_القيمة: غير_موقع = مساواة + 1;
                دع قيمة_خام: نص = نص_ويب_من_مدى(&بايتات_النص, بداية_القيمة, ب);
                لو (طريقة_ويب_صالحة(&اسم_خام)) {
                    طابق فك_قيمة_كعكة_ويب(&قيمة_خام) مع
                    | اختيار.بعض(قيمة_مفكوكة) -> { دع الزوج: زوج_كعكة_ويب = { الاسم: اسم_خام, القيمة: قيمة_مفكوكة }; ألحق(الناتج, الزوج); }
                    | اختيار.لا_شيء -> { };
                };
            };
            لو (النهاية >= العدد) { البداية := العدد; } وإلا { البداية := النهاية + 1; };
        }
        ه := ه + 1;
    }
    أرجع الناتج;
}

عام عرف كعكات_طلب_ويب(الطلب: &طلب_ويب_مخزن): متجه زوج_كعكة_ويب {
    دع القيمة: طلب_ويب_مخزن = *الطلب;
    أرجع حلل_كعكات_ويب(&القيمة.الرؤوس);
}

عام عرف أول_كعكة_ويب(الكعكات: &متجه زوج_كعكة_ويب, الاسم: &نص): اختيار نص {
    دع القيم: متجه زوج_كعكة_ويب = *الكعكات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&القيم[ف].الاسم, الاسم)) { أرجع اختيار.بعض(انسخ_نص_ويب(&القيم[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام نوع سياسة_نفس_موقع_كعكة_ويب =
    | غير_محدد
    | صارم
    | متساهل
    | لا_شيء
;

عام عرف ابن_رأس_تعيين_كعكة_ويب(
    الاسم: &نص,
    القيمة: &نص,
    المسار: &نص,
    المجال: &نص,
    لديه_عمر_أقصى: منطقي,
    العمر_الأقصى_ثوان: عدد,
    آمنة: منطقي,
    http_فقط: منطقي,
    نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب
): اختيار نص {
    لو (!طريقة_ويب_صالحة(الاسم) || !قيمة_كعكة_ويب_صالحة(القيمة)) { أرجع اختيار.لا_شيء(); };
    لو (((الطول(*المسار) مثل غير_موقع) > 0) && !قيمة_خاصية_كعكة_ويب_صالحة(المسار)) { أرجع اختيار.لا_شيء(); };
    لو (((الطول(*المجال) مثل غير_موقع) > 0) && !قيمة_خاصية_كعكة_ويب_صالحة(المجال)) { أرجع اختيار.لا_شيء(); };
    دع البايتات: متغير متجه غ8 = [];
    ألحق_نص_ويب(&متغير البايتات, الاسم);
    دع يساوي: نص = «=»; ألحق_نص_ويب(&متغير البايتات, &يساوي);
    ألحق_نص_ويب(&متغير البايتات, القيمة);
    لو ((الطول(*المسار) مثل غير_موقع) > 0) { دع س: نص = «; Path=»; ألحق_نص_ويب(&متغير البايتات, &س); ألحق_نص_ويب(&متغير البايتات, المسار); };
    لو ((الطول(*المجال) مثل غير_موقع) > 0) { دع س: نص = «; Domain=»; ألحق_نص_ويب(&متغير البايتات, &س); ألحق_نص_ويب(&متغير البايتات, المجال); };
    لو (لديه_عمر_أقصى) { دع س: نص = «; Max-Age=»; ألحق_نص_ويب(&متغير البايتات, &س); دع رقم: نص = عدد_إلى_نص(العمر_الأقصى_ثوان); ألحق_نص_ويب(&متغير البايتات, &رقم); };
    لو (آمنة) { دع س: نص = «; Secure»; ألحق_نص_ويب(&متغير البايتات, &س); };
    لو (http_فقط) { دع س: نص = «; HttpOnly»; ألحق_نص_ويب(&متغير البايتات, &س); };
    طابق نفس_الموقع مع
    | سياسة_نفس_موقع_كعكة_ويب.صارم -> { دع س: نص = «; SameSite=Strict»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | سياسة_نفس_موقع_كعكة_ويب.متساهل -> { دع س: نص = «; SameSite=Lax»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | سياسة_نفس_موقع_كعكة_ويب.لا_شيء -> { دع س: نص = «; SameSite=None»; ألحق_نص_ويب(&متغير البايتات, &س); }
    | _ -> { };
    أرجع اختيار.بعض(من_بايتات(&البايتات));
}

عام عرف أضف_كعكة_استجابة_ويب(
    الاستجابة: &متغير استجابة_ويب_مخزنة,
    الاسم: &نص,
    القيمة: &نص,
    المسار: &نص,
    المجال: &نص,
    لديه_عمر_أقصى: منطقي,
    العمر_الأقصى_ثوان: عدد,
    آمنة: منطقي,
    http_فقط: منطقي,
    نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب
): منطقي {
    طابق ابن_رأس_تعيين_كعكة_ويب(الاسم, القيمة, المسار, المجال, لديه_عمر_أقصى, العمر_الأقصى_ثوان, آمنة, http_فقط, نفس_الموقع) مع
    | اختيار.لا_شيء -> { أرجع خطأ; }
    | اختيار.بعض(الرأس) -> {
        دع الحالة: متغير استجابة_ويب_مخزنة = *الاستجابة;
        دع اسم_الرأس: نص = «set-cookie»;
        لو (!أضف_رأس_ويب(&متغير الحالة.الرؤوس, &اسم_الرأس, &الرأس)) { أرجع خطأ; };
        *الاستجابة := الحالة;
        أرجع صواب;
    };
}

عام عرف أضف_مسار_get_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة غير_موقع, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «GET»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
