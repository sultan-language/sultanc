استورد chars.ascii;
استورد encoding.utf8;
استورد json.parse;
استورد json.stringify;
استورد json.value;
استورد text.compare;
استورد text.from_bytes;
استورد text.number;
استورد text.substring;
استورد text.transform;
استورد uri.uri;

// Transport-neutral HTTP message model. Bodies stay generic so later socket,
// async, HTTP/2, and HTTP/3 layers can provide streaming body implementations.
عام نوع إصدار_ويب =
    | واحد_صفر
    | واحد_واحد
    | اثنان
    | ثلاثة
;

عام نوع صيغة_هدف_ويب =
    | أصل
    | مطلق
    | سلطة
    | نجمة
;

عام نوع رأس_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع طلب_ويب<B> = {
    الطريقة: نص,
    الهدف: نص,
    الإصدار: إصدار_ويب,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B
};

عام نوع استجابة_ويب<B> = {
    الإصدار: إصدار_ويب,
    الحالة: غير_موقع,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    الجسم: B
};

عام نوع طلب_ويب_مخزن = طلب_ويب<متجه غ8>;
عام نوع استجابة_ويب_مخزنة = استجابة_ويب<متجه غ8>;

عام نوع خدمة_ويب<S, B1, B2> = دالة(&S, &طلب_ويب<B1>): استجابة_ويب<B2>;

عرف انسخ_نص_ويب(القيمة: &نص): نص {
    دع النسخة: نص = *القيمة;
    أرجع النسخة;
}

عرف نص_ويب_من_مدى(البايتات: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): نص {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف < النهاية) && (ف < (الطول(المصدر) مثل غير_موقع))) {
        ألحق(الناتج, المصدر[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف بايتات_ويب_من_نص(القيمة: &نص): متجه غ8 {
    دع النص: نص = *القيمة;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(الناتج, النص[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_نص_ويب(الناتج: &متغير متجه غ8, القيمة: &نص): فراغ {
    دع النص: نص = *القيمة;
    دع الحالية: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        ألحق(الحالية, النص[ف]);
        ف := ف + 1;
    }
    *الناتج := الحالية;
}

عرف حرف_رمز_ويب(ب: غ8): منطقي {
    لو (حرف_أو_رقم_أسكي(ب)) { أرجع صواب; };
    أرجع (ب == 0x21) || (ب == 0x23) || (ب == 0x24) || (ب == 0x25)
        || (ب == 0x26) || (ب == 0x27) || (ب == 0x2A) || (ب == 0x2B)
        || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5E) || (ب == 0x5F)
        || (ب == 0x60) || (ب == 0x7C) || (ب == 0x7E);
}

عام عرف طريقة_ويب_صالحة(الطريقة: &نص): منطقي {
    دع القيمة: نص = *الطريقة;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (!حرف_رمز_ويب(القيمة[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_رأس_ويب_صالح(الاسم: &نص): منطقي {
    أرجع طريقة_ويب_صالحة(الاسم);
}

عرف قيمة_رأس_ويب_صالحة(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        دع ب: غ8 = النص[ف];
        لو ((ب == 0x0D) || (ب == 0x0A) || (ب == 0x00)) { أرجع خطأ; };
        لو ((ب < 0x20) && (ب != 0x09)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_رأس_ويب_مقنن(الاسم: &نص): نص {
    دع القيمة: نص = *الاسم;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        ألحق(البايتات, إلى_صغير_أسكي(القيمة[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف اسما_رأس_ويب_متساويان(الأول: &نص, الثاني: &نص): منطقي {
    دع أ: نص = *الأول;
    دع ب: نص = *الثاني;
    لو ((الطول(أ) مثل غير_موقع) != (الطول(ب) مثل غير_موقع)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(أ) مثل غير_موقع)) {
        لو (إلى_صغير_أسكي(أ[ف]) != إلى_صغير_أسكي(ب[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف أضف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    لو (!اسم_رأس_ويب_صالح(الاسم) || !قيمة_رأس_ويب_صالحة(القيمة)) { أرجع خطأ; };
    دع الحالية: متغير متجه رأس_ويب = *الرؤوس;
    دع الاسم_المقنن: نص = اسم_رأس_ويب_مقنن(الاسم);
    دع القيمة_المنسوخة: نص = انسخ_نص_ويب(القيمة);
    دع الرأس: رأس_ويب = { الاسم: الاسم_المقنن, القيمة: القيمة_المنسوخة };
    ألحق(الحالية, الرأس);
    *الرؤوس := الحالية;
    أرجع صواب;
}

عام عرف احذف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص): غير_موقع {
    دع المصدر: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه رأس_ويب = [];
    دع المحذوف: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        لو (اسما_رأس_ويب_متساويان(&المصدر[ف].الاسم, الاسم)) {
            المحذوف := المحذوف + 1;
        } وإلا {
            دع الاسم_المنسوخ: نص = انسخ_نص_ويب(&المصدر[ف].الاسم);
            دع القيمة_المنسوخة: نص = انسخ_نص_ويب(&المصدر[ف].القيمة);
            دع الرأس: رأس_ويب = { الاسم: الاسم_المنسوخ, القيمة: القيمة_المنسوخة };
            ألحق(الناتج, الرأس);
        };
        ف := ف + 1;
    }
    *الرؤوس := الناتج;
    أرجع المحذوف;
}

عام عرف ضع_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    دع عدد_المحذوف: غير_موقع = احذف_رأس_ويب(الرؤوس, الاسم);
    أرجع أضف_رأس_ويب(الرؤوس, الاسم, القيمة);
}

عام عرف أول_قيمة_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): اختيار نص {
    دع القيم: متجه رأس_ويب = *الرؤوس;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (اسما_رأس_ويب_متساويان(&القيم[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(انسخ_نص_ويب(&القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف قيم_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): متجه نص {
    دع القيم: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (اسما_رأس_ويب_متساويان(&القيم[ف].الاسم, الاسم)) {
            ألحق(الناتج, انسخ_نص_ويب(&القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف يحتوي_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): منطقي {
    طابق أول_قيمة_رأس_ويب(الرؤوس, الاسم) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف استجابة_ويب_مخزنة_جديدة(الحالة: غير_موقع, الجسم: متجه غ8): استجابة_ويب_مخزنة {
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الإصدار: إصدار_ويب = إصدار_ويب.واحد_واحد();
    دع الناتج: استجابة_ويب_مخزنة = { الإصدار: الإصدار, الحالة: الحالة, الرؤوس: الرؤوس, الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم };
    أرجع الناتج;
}

عام عرف استجابة_نص_ويب(الحالة: غير_موقع, النص: &نص): استجابة_ويب_مخزنة {
    دع الجسم: متجه غ8 = بايتات_ويب_من_نص(النص);
    دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_ويب_مخزنة_جديدة(الحالة, الجسم);
    دع الاسم: نص = «content-type»;
    دع القيمة: نص = «text/plain; charset=utf-8»;
    دع أضيف_نوع_المحتوى: منطقي = أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, &القيمة);
    أرجع الناتج;
}

// HTTP/1 buffered parser. Incomplete input is distinct from malformed input so
// a future transport can read more bytes without reparsing policy decisions.
عام نوع صنف_خطأ_ويب =
    | غير_مكتمل
    | سطر_بداية_طويل
    | قسم_رؤوس_كبير
    | رؤوس_كثيرة
    | طريقة_غير_صالحة
    | هدف_غير_صالح
    | إصدار_غير_مدعوم
    | اسم_رأس_غير_صالح
    | قيمة_رأس_غير_صالحة
    | طي_رأس_قديم
    | طول_محتوى_غير_صالح
    | أطوال_محتوى_متعددة
    | ترميز_نقل_مع_طول
    | ترميز_نقل_غير_مدعوم
    | حجم_قطعة_غير_صالح
    | نهاية_قطعة_غير_صالحة
    | جسم_كبير
    | مضيف_مفقود
    | مضيفون_متعددون
    | مضيف_غير_صالح
    | رأس_لاحق_ممنوع
    | محتوى_غير_مسموح
    | حالة_غير_صالحة
;

عام نوع خطأ_ويب = {
    الصنف: صنف_خطأ_ويب,
    الإزاحة: غير_موقع
};

عام نوع حدود_ويب = {
    أقصى_سطر_بداية: غير_موقع,
    أقصى_بايتات_رؤوس: غير_موقع,
    أقصى_عدد_رؤوس: غير_موقع,
    أقصى_بايتات_جسم: غير_موقع
};

عام عرف حدود_ويب_افتراضية(): حدود_ويب {
    دع الناتج: حدود_ويب = {
        أقصى_سطر_بداية: 8192,
        أقصى_بايتات_رؤوس: 65536,
        أقصى_عدد_رؤوس: 128,
        أقصى_بايتات_جسم: 8388608
    };
    أرجع الناتج;
}

عرف خطأ_ويب_عند(الصنف: صنف_خطأ_ويب, الإزاحة: غير_موقع): خطأ_ويب {
    دع الخطأ: خطأ_ويب = { الصنف: الصنف, الإزاحة: الإزاحة };
    أرجع الخطأ;
}

عرف ابحث_نهاية_سطر_ويب(البايتات: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع المصدر: متجه غ8 = *البايتات;
    دع ف: متغير غير_موقع = البداية;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    بينما ((ف + 1) < العدد) {
        دع التالي: غير_موقع = ف + 1;
        لو ((المصدر[ف] == 0x0D) && (المصدر[التالي] == 0x0A)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف قص_فراغ_رأس_ويب(القيمة: &نص): نص {
    دع النص: نص = *القيمة;
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(النص) مثل غير_موقع;
    بينما ((البداية < النهاية) && ((النص[البداية] == 0x20) || (النص[البداية] == 0x09))) { البداية := البداية + 1; }
    دع انتهى_القص: متغير منطقي = خطأ;
    بينما ((النهاية > البداية) && !انتهى_القص) {
        دع السابق: غير_موقع = النهاية - 1;
        لو ((النص[السابق] == 0x20) || (النص[السابق] == 0x09)) { النهاية := السابق; } وإلا { انتهى_القص := صواب; };
    }
    طابق مقطع_نص(&النص, البداية, النهاية - البداية) مع
    | اختيار.بعض(القيمة_المقصوصة) -> { أرجع القيمة_المقصوصة; }
    | اختيار.لا_شيء -> { أرجع «»; };
}

عرف حلل_إصدار_ويب(القيمة: &نص): نتيجة إصدار_ويب, صنف_خطأ_ويب {
    دع النص: نص = *القيمة;
    دع واحد_صفر_نص: نص = «HTTP/1.0»;
    دع واحد_واحد_نص: نص = «HTTP/1.1»;
    لو (نصان_متساويان(&النص, &واحد_صفر_نص)) { أرجع نتيجة.نجح(إصدار_ويب.واحد_صفر()); };
    لو (نصان_متساويان(&النص, &واحد_واحد_نص)) { أرجع نتيجة.نجح(إصدار_ويب.واحد_واحد()); };
    أرجع نتيجة.خطأ(صنف_خطأ_ويب.إصدار_غير_مدعوم());
}

عرف هدف_ويب_صالح(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    لو (العدد == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ب: غ8 = النص[ف];
        لو ((ب <= 0x20) || (ب >= 0x7F) || (ب == 0x23)) { أرجع خطأ; };
        لو (ب == 0x25) {
            لو ((ف + 2) >= العدد) { أرجع خطأ; };
            دع ف1: غير_موقع = ف + 1;
            دع ف2: غير_موقع = ف + 2;
            لو ((قيمة_رقم_أسكي(النص[ف1]) < 0) || (قيمة_رقم_أسكي(النص[ف1]) >= 16)) { أرجع خطأ; };
            لو ((قيمة_رقم_أسكي(النص[ف2]) < 0) || (قيمة_رقم_أسكي(النص[ف2]) >= 16)) { أرجع خطأ; };
            ف := ف + 3;
        } وإلا { ف := ف + 1; };
    }
    أرجع صواب;
}

عام عرف صيغة_هدف_طلب_ويب(الطريقة: &نص, الهدف: &نص): نتيجة صيغة_هدف_ويب, صنف_خطأ_ويب {
    دع م: نص = *الطريقة;
    دع ت: نص = *الهدف;
    دع نجمة_نص: نص = «*»;
    دع اتصال: نص = «CONNECT»;
    دع خيارات: نص = «OPTIONS»;
    لو (نصان_متساويان(&ت, &نجمة_نص)) {
        لو (!نصان_متساويان(&م, &خيارات)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
        أرجع نتيجة.نجح(صيغة_هدف_ويب.نجمة());
    };
    لو ((الطول(ت) مثل غير_موقع) > 0) {
        لو (ت[0] == 0x2F) {
            لو (نصان_متساويان(&م, &اتصال)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
            أرجع نتيجة.نجح(صيغة_هدف_ويب.أصل());
        };
    };
    لو (نصان_متساويان(&م, &اتصال)) {
        دع وجد_نقطتين: متغير منطقي = خطأ;
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(ت) مثل غير_موقع)) {
            لو ((ت[ف] == 0x3F) || (ت[ف] == 0x2F)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
            لو (ت[ف] == 0x3A) { وجد_نقطتين := صواب; };
            ف := ف + 1;
        }
        لو (!وجد_نقطتين) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
        أرجع نتيجة.نجح(صيغة_هدف_ويب.سلطة());
    };
    طابق حلل_عنوانا_موحدا(&ت) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صيغة_هدف_ويب.مطلق()); }
    | نتيجة.خطأ(_) -> { };
    أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح());
}

عرف حلل_سطر_طلب_ويب(البايتات: &متجه غ8, النهاية: غير_موقع): نتيجة طلب_ويب_مخزن, خطأ_ويب {
    دع المصدر: متجه غ8 = *البايتات;
    دع المسافة1: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع المسافة2: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < النهاية) {
        لو (المصدر[ف] == 0x20) {
            طابق المسافة1 مع
            | اختيار.لا_شيء -> { المسافة1 := اختيار.بعض(ف); }
            | اختيار.بعض(_) -> {
                طابق المسافة2 مع
                | اختيار.لا_شيء -> { المسافة2 := اختيار.بعض(ف); }
                | اختيار.بعض(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), ف)); };
            };
        };
        ف := ف + 1;
    }
    دع م1: متغير غير_موقع = 0;
    دع م2: متغير غير_موقع = 0;
    طابق المسافة1 مع | اختيار.بعض(م) -> { م1 := م; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0)); };
    طابق المسافة2 مع | اختيار.بعض(م) -> { م2 := م; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), م1 + 1)); };
    لو ((م1 == 0) || (م2 <= (م1 + 1)) || ((م2 + 1) >= النهاية)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), 0));
    };
    دع الطريقة: نص = نص_ويب_من_مدى(&المصدر, 0, م1);
    دع الهدف: نص = نص_ويب_من_مدى(&المصدر, م1 + 1, م2);
    دع الإصدار_نص: نص = نص_ويب_من_مدى(&المصدر, م2 + 1, النهاية);
    لو (!طريقة_ويب_صالحة(&الطريقة)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0)); };
    لو (!هدف_ويب_صالح(&الهدف)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), م1 + 1)); };
    طابق صيغة_هدف_طلب_ويب(&الطريقة, &الهدف) مع
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, م1 + 1)); }
    | نتيجة.نجح(_) -> { };
    دع الإصدار: متغير إصدار_ويب = إصدار_ويب.واحد_واحد();
    طابق حلل_إصدار_ويب(&الإصدار_نص) مع
    | نتيجة.نجح(قيمة) -> { الإصدار := قيمة; }
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, م2 + 1)); };
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه غ8 = [];
    دع الطلب: طلب_ويب_مخزن = { الطريقة: الطريقة, الهدف: الهدف, الإصدار: الإصدار, الرؤوس: الرؤوس, الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم };
    أرجع نتيجة.نجح(الطلب);
}

عرف حلل_رأس_ويب_خام(البايتات: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): نتيجة رأس_ويب, خطأ_ويب {
    دع المصدر: متجه غ8 = *البايتات;
    لو (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    لو ((المصدر[البداية] == 0x20) || (المصدر[البداية] == 0x09)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طي_رأس_قديم(), البداية));
    };
    دع النقطتان: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        لو (المصدر[ف] == 0x3A) { النقطتان := اختيار.بعض(ف); ف := النهاية; } وإلا { ف := ف + 1; };
    }
    دع م: متغير غير_موقع = البداية;
    طابق النقطتان مع | اختيار.بعض(ق) -> { م := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    لو (م == البداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    دع الاسم_الخام: نص = نص_ويب_من_مدى(&المصدر, البداية, م);
    دع القيمة_الخام: نص = نص_ويب_من_مدى(&المصدر, م + 1, النهاية);
    لو (!اسم_رأس_ويب_صالح(&الاسم_الخام)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    دع القيمة: نص = قص_فراغ_رأس_ويب(&القيمة_الخام);
    لو (!قيمة_رأس_ويب_صالحة(&القيمة)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), م + 1)); };
    دع الاسم_المقنن: نص = اسم_رأس_ويب_مقنن(&الاسم_الخام);
    دع الرأس: رأس_ويب = { الاسم: الاسم_المقنن, القيمة: القيمة };
    أرجع نتيجة.نجح(الرأس);
}

عرف قيمة_غير_موقعة_عشرية_ويب(النص: &نص): اختيار غير_موقع {
    دع القيمة: نص = *النص;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ب: غ8 = القيمة[ف];
        لو (!رقم_عشري(ب)) { أرجع اختيار.لا_شيء(); };
        دع فرق_الرقم: غ8 = ب - 0x30;
        دع الرقم: غير_موقع = فرق_الرقم مثل غير_موقع;
        دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
        لو (الناتج > ((الأعلى - الرقم) / 10)) { أرجع اختيار.لا_شيء(); };
        الناتج := (الناتج * 10) + الرقم;
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف قيمة_غير_موقعة_سداسية_ويب(النص: &نص): اختيار غير_موقع {
    دع القيمة: نص = *النص;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ر: عدد = قيمة_رقم_أسكي(القيمة[ف]);
        لو ((ر < 0) || (ر >= 16)) { أرجع اختيار.لا_شيء(); };
        دع الرقم: غير_موقع = ر مثل غير_موقع;
        دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
        لو (الناتج > ((الأعلى - الرقم) / 16)) { أرجع اختيار.لا_شيء(); };
        الناتج := (الناتج * 16) + الرقم;
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف انسخ_بايتات_ويب(المصدر: &متجه غ8, البداية: غير_موقع, العدد: غير_موقع): متجه غ8 {
    دع القيم: متجه غ8 = *المصدر;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما ((ف < العدد) && ((البداية + ف) < (الطول(القيم) مثل غير_موقع))) {
        دع الموضع: غير_موقع = البداية + ف;
        ألحق(الناتج, القيم[الموضع]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ألحق_بايتات_ويب(الناتج: &متغير متجه غ8, المصدر: &متجه غ8, البداية: غير_موقع, العدد: غير_موقع): فراغ {
    دع القيم: متجه غ8 = *المصدر;
    دع الحالية: متغير متجه غ8 = *الناتج;
    دع ف: متغير غير_موقع = 0;
    بينما ((ف < العدد) && ((البداية + ف) < (الطول(القيم) مثل غير_موقع))) {
        دع الموضع: غير_موقع = البداية + ف;
        ألحق(الحالية, القيم[الموضع]);
        ف := ف + 1;
    }
    *الناتج := الحالية;
}

عرف رأس_ويب_يسمى(الرأس: &رأس_ويب, الاسم: نص): منطقي {
    دع القيمة: رأس_ويب = *الرأس;
    دع المطلوب: نص = الاسم;
    أرجع اسما_رأس_ويب_متساويان(&القيمة.الاسم, &المطلوب);
}

// HTTP/1.1 Host is routing authority, so reject ambiguous or malformed values.
عرف قيمة_مضيف_ويب_صالحة(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    لو (العدد == 0) { أرجع خطأ; };
    لو (النص[0] == 0x5B) {
        دع إغلاق: متغير اختيار غير_موقع = اختيار.لا_شيء();
        دع ف: متغير غير_موقع = 1;
        بينما (ف < العدد) {
            دع ب: غ8 = النص[ف];
            لو (ب == 0x5D) { إغلاق := اختيار.بعض(ف); ف := العدد; }
            وإلا {
                لو ((ب <= 0x20) || (ب >= 0x7F) || (ب == 0x5B) || (ب == 0x2F) || (ب == 0x3F) || (ب == 0x23) || (ب == 0x40) || (ب == 0x2C)) { أرجع خطأ; };
                ف := ف + 1;
            };
        }
        دع موضع_الإغلاق: متغير غير_موقع = 0;
        طابق إغلاق مع | اختيار.بعض(م) -> { موضع_الإغلاق := م; } | اختيار.لا_شيء -> { أرجع خطأ; };
        لو (موضع_الإغلاق == 1) { أرجع خطأ; };
        لو ((موضع_الإغلاق + 1) == العدد) { أرجع صواب; };
        دع موضع_النقطتين: غير_موقع = موضع_الإغلاق + 1;
        لو ((النص[موضع_النقطتين] != 0x3A) || ((موضع_النقطتين + 1) >= العدد)) { أرجع خطأ; };
        ف := موضع_النقطتين + 1;
        بينما (ف < العدد) { لو (!رقم_عشري(النص[ف])) { أرجع خطأ; }; ف := ف + 1; }
        أرجع صواب;
    };
    دع موضع_المنفذ: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ب: غ8 = النص[ف];
        لو (ب == 0x3A) {
            طابق موضع_المنفذ مع | اختيار.بعض(_) -> { أرجع خطأ; } | اختيار.لا_شيء -> { موضع_المنفذ := اختيار.بعض(ف); };
            ف := ف + 1;
        } وإلا {
            دع مسموح: منطقي = حرف_أو_رقم_أسكي(ب) || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5F) || (ب == 0x7E)
                || (ب == 0x21) || (ب == 0x24) || (ب == 0x26) || (ب == 0x27) || (ب == 0x28) || (ب == 0x29)
                || (ب == 0x2A) || (ب == 0x2B) || (ب == 0x3B) || (ب == 0x3D) || (ب == 0x25);
            لو (!مسموح) { أرجع خطأ; };
            لو (ب == 0x25) {
                لو ((ف + 2) >= العدد) { أرجع خطأ; };
                دع ف1: غير_موقع = ف + 1; دع ف2: غير_موقع = ف + 2;
                لو ((قيمة_رقم_أسكي(النص[ف1]) < 0) || (قيمة_رقم_أسكي(النص[ف1]) >= 16)) { أرجع خطأ; };
                لو ((قيمة_رقم_أسكي(النص[ف2]) < 0) || (قيمة_رقم_أسكي(النص[ف2]) >= 16)) { أرجع خطأ; };
                ف := ف + 3;
            } وإلا { ف := ف + 1; };
        };
    }
    طابق موضع_المنفذ مع
    | اختيار.لا_شيء -> { أرجع صواب; }
    | اختيار.بعض(م) -> {
        لو ((م == 0) || ((م + 1) >= العدد)) { أرجع خطأ; };
        دع ك: متغير غير_موقع = م + 1;
        بينما (ك < العدد) { لو (!رقم_عشري(النص[ك])) { أرجع خطأ; }; ك := ك + 1; }
        أرجع صواب;
    };
}


عرف رأس_لاحق_ويب_ممنوع(الرأس: &رأس_ويب): منطقي {
    أرجع رأس_ويب_يسمى(الرأس, «content-length»)
        || رأس_ويب_يسمى(الرأس, «transfer-encoding»)
        || رأس_ويب_يسمى(الرأس, «host»);
}

عام نوع طلب_ويب_محلل = {
    الطلب: طلب_ويب_مخزن,
    المستهلك: غير_موقع
};

عام عرف حلل_طلب_ويب1(البايتات: &متجه غ8, الحدود: &حدود_ويب): نتيجة طلب_ويب_محلل, خطأ_ويب {
    دع المصدر: متجه غ8 = *البايتات;
    دع الحد: حدود_ويب = *الحدود;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع نهاية_سطر_البداية: متغير غير_موقع = 0;
    طابق ابحث_نهاية_سطر_ويب(&المصدر, 0) مع
    | اختيار.لا_شيء -> {
        لو (العدد > الحد.أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), الحد.أقصى_سطر_بداية)); };
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
    }
    | اختيار.بعض(م) -> { نهاية_سطر_البداية := م; };
    لو (نهاية_سطر_البداية > الحد.أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), نهاية_سطر_البداية)); };

    دع طريقة_فارغة: نص = «»;
    دع هدف_فارغ: نص = «»;
    دع إصدار_افتراضي: إصدار_ويب = إصدار_ويب.واحد_واحد();
    دع رؤوس_فارغة: متجه رأس_ويب = [];
    دع رؤوس_لاحقة_فارغة: متجه رأس_ويب = [];
    دع جسم_فارغ: متجه غ8 = [];
    دع الطلب: متغير طلب_ويب_مخزن = {
        الطريقة: طريقة_فارغة, الهدف: هدف_فارغ, الإصدار: إصدار_افتراضي, الرؤوس: رؤوس_فارغة, الرؤوس_اللاحقة: رؤوس_لاحقة_فارغة, الجسم: جسم_فارغ
    };
    طابق حلل_سطر_طلب_ويب(&المصدر, نهاية_سطر_البداية) مع
    | نتيجة.نجح(قيمة) -> { الطلب := قيمة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };

    دع الموضع: متغير غير_موقع = نهاية_سطر_البداية + 2;
    دع بداية_الرؤوس: غير_موقع = الموضع;
    دع عدد_الرؤوس: متغير غير_موقع = 0;
    دع انتهت_الرؤوس: متغير منطقي = خطأ;
    بينما (!انتهت_الرؤوس) {
        لو ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
        دع التالي: غير_موقع = الموضع + 1;
        لو ((المصدر[الموضع] == 0x0D) && (المصدر[التالي] == 0x0A)) {
            الموضع := الموضع + 2;
            انتهت_الرؤوس := صواب;
        } وإلا {
            لو ((الموضع - بداية_الرؤوس) > الحد.أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
            لو (عدد_الرؤوس >= الحد.أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
            دع نهاية_السطر: متغير غير_موقع = 0;
            طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختيار.بعض(م) -> { نهاية_السطر := م; };
            طابق حلل_رأس_ويب_خام(&المصدر, الموضع, نهاية_السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الرأس) -> {
                ألحق(الطلب.الرؤوس, الرأس);
            };
            عدد_الرؤوس := عدد_الرؤوس + 1;
            الموضع := نهاية_السطر + 2;
        };
    }
    لو ((الموضع - بداية_الرؤوس) > الحد.أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };

    دع يتطلب_مضيف: متغير منطقي = خطأ;
    طابق الطلب.الإصدار مع
    | إصدار_ويب.واحد_واحد -> { يتطلب_مضيف := صواب; }
    | _ -> { };
    لو (يتطلب_مضيف) {
        دع اسم_المضيف: نص = «host»;
        دع المضيفون: متجه نص = قيم_رأس_ويب(&الطلب.الرؤوس, &اسم_المضيف);
        دع عدد_المضيفين: غير_موقع = الطول(المضيفون) مثل غير_موقع;
        لو (عدد_المضيفين == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), الموضع)); };
        لو (عدد_المضيفين > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), الموضع)); };
        لو (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), الموضع)); };
    };

    دع طول_محتوى: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع ترميز_نقل: متغير اختيار نص = اختيار.لا_شيء();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الطلب.الرؤوس) مثل غير_موقع)) {
        لو (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «content-length»)) {
            طابق طول_محتوى مع
            | اختيار.بعض(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), الموضع)); }
            | اختيار.لا_شيء -> {
                طابق قيمة_غير_موقعة_عشرية_ويب(&الطلب.الرؤوس[ف].القيمة) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع)); }
                | اختيار.بعض(قيمة) -> { طول_محتوى := اختيار.بعض(قيمة); };
            };
        };
        لو (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «transfer-encoding»)) {
            طابق ترميز_نقل مع
            | اختيار.بعض(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); }
            | اختيار.لا_شيء -> { ترميز_نقل := اختيار.بعض(انسخ_نص_ويب(&الطلب.الرؤوس[ف].القيمة)); };
        };
        ف := ف + 1;
    }
    طابق ترميز_نقل مع
    | اختيار.بعض(_) -> {
        طابق طول_محتوى مع | اختيار.بعض(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), الموضع)); } | _ -> { };
    }
    | _ -> { };

    طابق ترميز_نقل مع
    | اختيار.لا_شيء -> {
        دع طول_الجسم: متغير غير_موقع = 0;
        طابق طول_محتوى مع | اختيار.بعض(قيمة) -> { طول_الجسم := قيمة; } | _ -> { };
        لو (طول_الجسم > الحد.أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
        لو ((العدد - الموضع) < طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        الطلب.الجسم := انسخ_بايتات_ويب(&المصدر, الموضع, طول_الجسم);
        دع المستهلك: غير_موقع = الموضع + طول_الجسم;
        دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: المستهلك };
        أرجع نتيجة.نجح(الناتج);
    }
    | اختيار.بعض(الترميز_الخام) -> {
        دع الترميز: نص = قص_فراغ_رأس_ويب(&الترميز_الخام);
        دع chunked: نص = «chunked»;
        لو (!اسما_رأس_ويب_متساويان(&الترميز, &chunked)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
        };
        دع الجسم: متغير متجه غ8 = [];
        بينما (صواب) {
            دع نهاية_الحجم: متغير غير_موقع = 0;
            طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختيار.بعض(م) -> { نهاية_الحجم := م; };
            دع نهاية_أرقام_الحجم: متغير غير_موقع = نهاية_الحجم;
            دع س: متغير غير_موقع = الموضع;
            بينما (س < نهاية_الحجم) {
                لو (المصدر[س] == 0x3B) { نهاية_أرقام_الحجم := س; س := نهاية_الحجم; } وإلا { س := س + 1; };
            }
            دع نص_الحجم_الخام: نص = نص_ويب_من_مدى(&المصدر, الموضع, نهاية_أرقام_الحجم);
            دع نص_الحجم: نص = قص_فراغ_رأس_ويب(&نص_الحجم_الخام);
            دع حجم_القطعة: متغير غير_موقع = 0;
            طابق قيمة_غير_موقعة_سداسية_ويب(&نص_الحجم) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), الموضع)); }
            | اختيار.بعض(قيمة) -> { حجم_القطعة := قيمة; };
            الموضع := نهاية_الحجم + 2;
            لو (حجم_القطعة == 0) {
                دع بداية_الرؤوس_اللاحقة: غير_موقع = الموضع;
                دع عدد_الرؤوس_اللاحقة: متغير غير_موقع = 0;
                بينما (صواب) {
                    لو ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
                    دع التالي_للرأس: غير_موقع = الموضع + 1;
                    لو ((المصدر[الموضع] == 0x0D) && (المصدر[التالي_للرأس] == 0x0A)) {
                        الموضع := الموضع + 2;
                        الطلب.الجسم := الجسم;
                        دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: الموضع };
                        أرجع نتيجة.نجح(الناتج);
                    };
                    دع نهاية_الرأس_اللاحق: متغير غير_موقع = 0;
                    طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
                    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
                    | اختيار.بعض(م) -> { نهاية_الرأس_اللاحق := م; };
                    طابق حلل_رأس_ويب_خام(&المصدر, الموضع, نهاية_الرأس_اللاحق) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(الرأس) -> {
                        لو (رأس_لاحق_ويب_ممنوع(&الرأس)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), الموضع)); };
                        لو (عدد_الرؤوس_اللاحقة >= الحد.أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
                        ألحق(الطلب.الرؤوس_اللاحقة, الرأس);
                        عدد_الرؤوس_اللاحقة := عدد_الرؤوس_اللاحقة + 1;
                    };
                    الموضع := نهاية_الرأس_اللاحق + 2;
                    لو ((الموضع - بداية_الرؤوس_اللاحقة) > الحد.أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
                }
            };
            لو (حجم_القطعة > (الحد.أقصى_بايتات_جسم - (الطول(الجسم) مثل غير_موقع))) {
                أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع));
            };
            لو ((العدد - الموضع) < (حجم_القطعة + 2)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
            ألحق_بايتات_ويب(&متغير الجسم, &المصدر, الموضع, حجم_القطعة);
            الموضع := الموضع + حجم_القطعة;
            دع التالي_للقطعة: غير_موقع = الموضع + 1;
            لو ((المصدر[الموضع] != 0x0D) || (المصدر[التالي_للقطعة] != 0x0A)) {
                أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.نهاية_قطعة_غير_صالحة(), الموضع));
            };
            الموضع := الموضع + 2;
        }
    };
    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
}

عرف عبارة_حالة_ويب(الحالة: غير_موقع): نص {
    لو (الحالة == 100) { أرجع «Continue»; };
    لو (الحالة == 101) { أرجع «Switching Protocols»; };
    لو (الحالة == 200) { أرجع «OK»; };
    لو (الحالة == 201) { أرجع «Created»; };
    لو (الحالة == 202) { أرجع «Accepted»; };
    لو (الحالة == 204) { أرجع «No Content»; };
    لو (الحالة == 205) { أرجع «Reset Content»; };
    لو (الحالة == 206) { أرجع «Partial Content»; };
    لو (الحالة == 301) { أرجع «Moved Permanently»; };
    لو (الحالة == 302) { أرجع «Found»; };
    لو (الحالة == 303) { أرجع «See Other»; };
    لو (الحالة == 304) { أرجع «Not Modified»; };
    لو (الحالة == 307) { أرجع «Temporary Redirect»; };
    لو (الحالة == 308) { أرجع «Permanent Redirect»; };
    لو (الحالة == 400) { أرجع «Bad Request»; };
    لو (الحالة == 401) { أرجع «Unauthorized»; };
    لو (الحالة == 403) { أرجع «Forbidden»; };
    لو (الحالة == 404) { أرجع «Not Found»; };
    لو (الحالة == 405) { أرجع «Method Not Allowed»; };
    لو (الحالة == 408) { أرجع «Request Timeout»; };
    لو (الحالة == 409) { أرجع «Conflict»; };
    لو (الحالة == 413) { أرجع «Content Too Large»; };
    لو (الحالة == 415) { أرجع «Unsupported Media Type»; };
    لو (الحالة == 422) { أرجع «Unprocessable Content»; };
    لو (الحالة == 429) { أرجع «Too Many Requests»; };
    لو (الحالة == 431) { أرجع «Request Header Fields Too Large»; };
    لو (الحالة == 500) { أرجع «Internal Server Error»; };
    لو (الحالة == 501) { أرجع «Not Implemented»; };
    لو (الحالة == 502) { أرجع «Bad Gateway»; };
    لو (الحالة == 503) { أرجع «Service Unavailable»; };
    أرجع «»;
}

عرف حالة_تمنع_المحتوى(الحالة: غير_موقع): منطقي {
    أرجع ((الحالة >= 100) && (الحالة < 200)) || (الحالة == 204) || (الحالة == 205) || (الحالة == 304);
}

عرف حالة_تمنع_طول_المحتوى(الحالة: غير_موقع): منطقي {
    أرجع ((الحالة >= 100) && (الحالة < 200)) || (الحالة == 204);
}

عرف انسخ_رؤوس_ويب(الرؤوس: &متجه رأس_ويب): متجه رأس_ويب {
    دع المصدر: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه رأس_ويب = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        دع الاسم: نص = انسخ_نص_ويب(&المصدر[ف].الاسم);
        دع القيمة: نص = انسخ_نص_ويب(&المصدر[ف].القيمة);
        دع الرأس: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
        ألحق(الناتج, الرأس);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف سلسل_استجابة_ويب1_داخليا(
    الاستجابة: &استجابة_ويب_مخزنة,
    احذف_الجسم_المنقول: منطقي,
    امنع_طول_المحتوى_إضافيا: منطقي
): نتيجة متجه غ8, خطأ_ويب {
    دع القيمة: استجابة_ويب_مخزنة = *الاستجابة;
    لو ((القيمة.الحالة < 100) || (القيمة.الحالة > 999)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 0)); };
    دع الرؤوس: متغير متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الرؤوس);
    دع اسم_الطول: نص = «content-length»;
    دع اسم_الترميز: نص = «transfer-encoding»;
    لو (يحتوي_رأس_ويب(&الرؤوس, &اسم_الترميز)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
    لو ((الطول(القيمة.الرؤوس_اللاحقة) مثل غير_موقع) > 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
    دع طول_الجسم: غير_موقع = الطول(القيمة.الجسم) مثل غير_موقع;
    لو (حالة_تمنع_المحتوى(القيمة.الحالة) && (طول_الجسم > 0)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), 0)); };
    لو (امنع_طول_المحتوى_إضافيا && (طول_الجسم > 0)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), 0)); };
    دع قيم_الطول: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_الطول);
    لو ((الطول(قيم_الطول) مثل غير_موقع) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), 0)); };
    لو (حالة_تمنع_طول_المحتوى(القيمة.الحالة) || امنع_طول_المحتوى_إضافيا) {
        لو ((الطول(قيم_الطول) مثل غير_موقع) != 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
    } وإلا لو (القيمة.الحالة == 304) {
        لو ((الطول(قيم_الطول) مثل غير_موقع) == 1) {
            طابق قيمة_غير_موقعة_عشرية_ويب(&قيم_الطول[0]) مع
            | اختيار.بعض(_) -> { }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
        };
    } وإلا {
        دع الطول_المتوقع: متغير غير_موقع = طول_الجسم;
        لو (القيمة.الحالة == 205) { الطول_المتوقع := 0; };
        لو ((الطول(قيم_الطول) مثل غير_موقع) == 1) {
            طابق قيمة_غير_موقعة_عشرية_ويب(&قيم_الطول[0]) مع
            | اختيار.بعض(معلن) -> { لو (معلن != الطول_المتوقع) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
        } وإلا {
            دع نص_الطول: نص = غير_موقع_إلى_نص(الطول_المتوقع);
            لو (!أضف_رأس_ويب(&متغير الرؤوس, &اسم_الطول, &نص_الطول)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
        };
    };
    دع الناتج: متغير متجه غ8 = [];
    دع المقدمة: متغير نص = «»;
    طابق القيمة.الإصدار مع
    | إصدار_ويب.واحد_صفر -> { المقدمة := «HTTP/1.0 »; }
    | إصدار_ويب.واحد_واحد -> { المقدمة := «HTTP/1.1 »; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.إصدار_غير_مدعوم(), 0)); };
    ألحق_نص_ويب(&متغير الناتج, &المقدمة);
    دع رقم_الحالة: نص = غير_موقع_إلى_نص(القيمة.الحالة);
    ألحق_نص_ويب(&متغير الناتج, &رقم_الحالة);
    ألحق(الناتج, 0x20);
    دع العبارة: نص = عبارة_حالة_ويب(القيمة.الحالة);
    ألحق_نص_ويب(&متغير الناتج, &العبارة);
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرؤوس) مثل غير_موقع)) {
        لو (!اسم_رأس_ويب_صالح(&الرؤوس[ف].الاسم) || !قيمة_رأس_ويب_صالحة(&الرؤوس[ف].القيمة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0));
        };
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].الاسم);
        ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].القيمة);
        ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    لو (!حالة_تمنع_المحتوى(القيمة.الحالة) && !احذف_الجسم_المنقول) {
        ألحق_بايتات_ويب(&متغير الناتج, &القيمة.الجسم, 0, الطول(القيمة.الجسم) مثل غير_موقع);
    };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف سلسل_استجابة_ويب1(الاستجابة: &استجابة_ويب_مخزنة): نتيجة متجه غ8, خطأ_ويب {
    أرجع سلسل_استجابة_ويب1_داخليا(الاستجابة, خطأ, خطأ);
}

عام عرف سلسل_استجابة_ويب1_لطلب(الطلب: &طلب_ويب_مخزن, الاستجابة: &استجابة_ويب_مخزنة): نتيجة متجه غ8, خطأ_ويب {
    دع قيمة_الطلب: طلب_ويب_مخزن = *الطلب;
    دع قيمة_الاستجابة: استجابة_ويب_مخزنة = *الاستجابة;
    دع رأس: نص = «HEAD»;
    دع اتصال: نص = «CONNECT»;
    دع طلب_رأس: منطقي = نصان_متساويان(&قيمة_الطلب.الطريقة, &رأس);
    دع اتصال_ناجح: منطقي = نصان_متساويان(&قيمة_الطلب.الطريقة, &اتصال) && (قيمة_الاستجابة.الحالة >= 200) && (قيمة_الاستجابة.الحالة < 300);
    أرجع سلسل_استجابة_ويب1_داخليا(الاستجابة, طلب_رأس || اتصال_ناجح, اتصال_ناجح);
}

// URL query helpers preserve duplicate keys. They apply the conventional
// application/x-www-form-urlencoded '+' decoding used by web frameworks.
عام نوع زوج_استعلام_ويب = {
    الاسم: نص,
    القيمة: نص
};

عرف فك_مكون_استعلام_ويب(القيمة: &نص): نتيجة نص, خطأ_عنوان_موحد {
    دع النص: نص = *القيمة;
    دع البايتات: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النص) مثل غير_موقع)) {
        لو (النص[ف] == 0x2B) { ألحق(البايتات, 0x20); } وإلا { ألحق(البايتات, النص[ف]); };
        ف := ف + 1;
    }
    دع قبل_النسب: نص = من_بايتات(&البايتات);
    أرجع فك_الترميز_النسبي(&قبل_النسب);
}

عام عرف مسار_هدف_ويب(الهدف: &نص): نص {
    دع القيمة: نص = *الهدف;
    لو ((الطول(القيمة) مثل غير_موقع) > 0) {
        لو (القيمة[0] != 0x2F) {
            طابق حلل_عنوانا_موحدا(&القيمة) مع
            | نتيجة.نجح(العنوان) -> { لو ((الطول(العنوان.المسار) مثل غير_موقع) == 0) { أرجع «/»; }; أرجع انسخ_نص_ويب(&العنوان.المسار); }
            | نتيجة.خطأ(_) -> { };
        };
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (القيمة[ف] == 0x3F) {
            طابق مقطع_نص(&القيمة, 0, ف) مع | اختيار.بعض(مسار) -> { أرجع مسار; } | _ -> { أرجع «»; };
        };
        ف := ف + 1;
    }
    أرجع القيمة;
}

عام عرف استعلام_هدف_ويب(الهدف: &نص): اختيار نص {
    دع القيمة: نص = *الهدف;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        لو (القيمة[ف] == 0x3F) {
            دع طول_الهدف: غير_موقع = الطول(القيمة) مثل غير_موقع;
            دع بداية_الاستعلام: غير_موقع = ف + 1;
            دع طول_الاستعلام: غير_موقع = طول_الهدف - بداية_الاستعلام;
            طابق مقطع_نص(&القيمة, بداية_الاستعلام, طول_الاستعلام) مع
            | اختيار.بعض(استعلام) -> { أرجع اختيار.بعض(استعلام); }
            | _ -> { أرجع اختيار.بعض(«»); };
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف حلل_استعلام_ويب(الاستعلام: &نص): نتيجة متجه زوج_استعلام_ويب, خطأ_عنوان_موحد {
    دع النص: نص = *الاستعلام;
    دع الناتج: متغير متجه زوج_استعلام_ويب = [];
    دع البداية: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    بينما (البداية <= العدد) {
        دع النهاية: متغير غير_موقع = البداية;
        بينما ((النهاية < العدد) && (النص[النهاية] != 0x26)) { النهاية := النهاية + 1; }
        دع مساواة: متغير غير_موقع = النهاية;
        دع ف: متغير غير_موقع = البداية;
        بينما (ف < النهاية) {
            لو (النص[ف] == 0x3D) { مساواة := ف; ف := النهاية; } وإلا { ف := ف + 1; };
        }
        دع الاسم_الخام: متغير نص = «»;
        دع القيمة_الخام: متغير نص = «»;
        طابق مقطع_نص(&النص, البداية, مساواة - البداية) مع | اختيار.بعض(قيمة) -> { الاسم_الخام := قيمة; } | _ -> { };
        لو (مساواة < النهاية) {
            طابق مقطع_نص(&النص, مساواة + 1, النهاية - مساواة - 1) مع | اختيار.بعض(قيمة) -> { القيمة_الخام := قيمة; } | _ -> { };
        };
        دع الاسم: متغير نص = «»;
        دع القيمة: متغير نص = «»;
        طابق فك_مكون_استعلام_ويب(&الاسم_الخام) مع | نتيجة.نجح(قيمة) -> { الاسم := قيمة; } | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        طابق فك_مكون_استعلام_ويب(&القيمة_الخام) مع | نتيجة.نجح(قيمة_مفكوكة) -> { القيمة := قيمة_مفكوكة; } | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        دع الزوج: زوج_استعلام_ويب = { الاسم: الاسم, القيمة: القيمة };
        ألحق(الناتج, الزوج);
        لو (النهاية >= العدد) { أرجع نتيجة.نجح(الناتج); };
        البداية := النهاية + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف أول_قيمة_استعلام_ويب(الأزواج: &متجه زوج_استعلام_ويب, الاسم: &نص): اختيار نص {
    دع القيم: متجه زوج_استعلام_ويب = *الأزواج;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&القيم[ف].الاسم, الاسم)) { أرجع اختيار.بعض(انسخ_نص_ويب(&القيم[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

// Incremental HTTP/1 decoder. A future socket/event-loop transport only feeds
// bytes here; protocol parsing and pipelined buffering remain owned by std.http.
عام نوع مفكك_ويب1 = {
    المخزن: متجه غ8,
    الحدود: حدود_ويب
};

عام عرف مفكك_ويب1_جديد(الحدود: حدود_ويب): مفكك_ويب1 {
    دع المخزن: متجه غ8 = [];
    دع الناتج: مفكك_ويب1 = { المخزن: المخزن, الحدود: الحدود };
    أرجع الناتج;
}

عام عرف غذ_مفكك_ويب1(المفكك: &متغير مفكك_ويب1, البايتات: &متجه غ8): فراغ {
    دع الحالة: متغير مفكك_ويب1 = *المفكك;
    دع المصدر: متجه غ8 = *البايتات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) { ألحق(الحالة.المخزن, المصدر[ف]); ف := ف + 1; }
    *المفكك := الحالة;
}

عام عرف التالي_من_مفكك_ويب1(المفكك: &متغير مفكك_ويب1): نتيجة اختيار طلب_ويب_محلل, خطأ_ويب {
    دع الحالة: متغير مفكك_ويب1 = *المفكك;
    طابق حلل_طلب_ويب1(&الحالة.المخزن, &الحالة.الحدود) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ.الصنف مع
        | صنف_خطأ_ويب.غير_مكتمل -> { *المفكك := الحالة; أرجع نتيجة.نجح(اختيار.لا_شيء()); }
        | _ -> { *المفكك := الحالة; أرجع نتيجة.خطأ(الخطأ); };
    }
    | نتيجة.نجح(المحلل) -> {
        دع الباقي: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = المحلل.المستهلك;
        بينما (ف < (الطول(الحالة.المخزن) مثل غير_موقع)) { ألحق(الباقي, الحالة.المخزن[ف]); ف := ف + 1; }
        الحالة.المخزن := الباقي;
        *المفكك := الحالة;
        أرجع نتيجة.نجح(اختيار.بعض(المحلل));
    };
}

عام عرف بايتات_معلقة_في_مفكك_ويب1(المفكك: &مفكك_ويب1): غير_موقع {
    دع الحالة: مفكك_ويب1 = *المفكك;
    أرجع الطول(الحالة.المخزن) مثل غير_موقع;
}

// Accessors keep the public English surface usable without exposing field spelling.
عام عرف طريقة_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_نص_ويب(&القيمة.الطريقة); }
عام عرف هدف_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_نص_ويب(&القيمة.الهدف); }
عام عرف إصدار_طلب_ويب(الطلب: &طلب_ويب_مخزن): إصدار_ويب { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع القيمة.الإصدار; }
عام عرف جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): متجه غ8 { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_بايتات_ويب(&القيمة.الجسم, 0, الطول(القيمة.الجسم) مثل غير_موقع); }
عام عرف أول_رأس_طلب_ويب(الطلب: &طلب_ويب_مخزن, الاسم: &نص): اختيار نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع أول_قيمة_رأس_ويب(&القيمة.الرؤوس, الاسم); }
