    دع الطريقة: نص = انسخ_نص_ويب(&القيمة.الطلب.الطريقة);
    دع الهدف: نص = انسخ_نص_ويب(&القيمة.الطلب.الهدف);
    دع الإصدار: إصدار_ويب = القيمة.الطلب.الإصدار;
    دع الرؤوس: متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الطلب.الرؤوس);
    دع الرؤوس_اللاحقة: متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الطلب.الرؤوس_اللاحقة);
    دع الجسم: متجه غ8 = انسخ_بايتات_ويب(&القيمة.الطلب.الجسم, 0, الطول(القيمة.الطلب.الجسم) مثل غير_موقع);
    دع الطلب: طلب_ويب_مخزن = { الطريقة: الطريقة, الهدف: الهدف, الإصدار: الإصدار, الرؤوس: الرؤوس, الرؤوس_اللاحقة: الرؤوس_اللاحقة, الجسم: الجسم };
    أرجع الطلب;
}
عام عرف صنف_خطأ_ويب_لقيمة(الخطأ: &خطأ_ويب): صنف_خطأ_ويب { دع القيمة: خطأ_ويب = *الخطأ; أرجع القيمة.الصنف; }
عام عرف إزاحة_خطأ_ويب(الخطأ: &خطأ_ويب): غير_موقع { دع القيمة: خطأ_ويب = *الخطأ; أرجع القيمة.الإزاحة; }
