عام مرادف http_error_kind.invalid_status = صنف_خطأ_ويب.حالة_غير_صالحة;

// Buffered multipart/form-data foundation. Transport streaming remains outside
// this parser; limits are explicit so application frameworks can set policy.
عام نوع جزء_متعدد_ويب = {
    الاسم: نص,
    اسم_الملف: اختيار نص,
    نوع_المحتوى: اختيار نص,
    الرؤوس: متجه رأس_ويب,
    الجسم: متجه غ8
};

عام نوع حدود_متعدد_ويب = {
    أقصى_الأجزاء: غير_موقع,
    أقصى_بايتات_الجزء: غير_موقع,
    أقصى_الرؤوس_للجزء: غير_موقع,
    أقصى_بايتات_رؤوس_الجزء: غير_موقع
};

عام نوع صنف_خطأ_متعدد_ويب =
    | نوع_محتوى_مفقود
    | نوع_محتوى_غير_صالح
    | ليس_نموذجا_متعدد_الأجزاء
    | حد_مفقود
    | حد_غير_صالح
    | جسم_غير_صالح
    | رؤوس_جزء_غير_صالحة
    | رؤوس_جزء_كبيرة
    | رؤوس_جزء_كثيرة
    | توزيع_مفقود
    | توزيع_غير_صالح
    | اسم_حقل_مفقود
    | أجزاء_كثيرة
    | جزء_كبير
;

عام عرف حدود_متعدد_ويب_افتراضية(): حدود_متعدد_ويب {
    دع الناتج: حدود_متعدد_ويب = {
        أقصى_الأجزاء: 128,
        أقصى_بايتات_الجزء: 8388608,
        أقصى_الرؤوس_للجزء: 64,
        أقصى_بايتات_رؤوس_الجزء: 65536
    };
    أرجع الناتج;
}

عرف حد_متعدد_ويب_صالح(الحد: &نص): منطقي {
    دع القيمة: نص = *الحد;
    دع العدد: غير_موقع = الطول(القيمة) مثل غير_موقع;
    لو ((العدد == 0) || (العدد > 70)) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع ب: غ8 = القيمة[ف];
        دع أبجدي_رقمي: منطقي = حرف_أو_رقم_أسكي(ب);
        دع خاص: منطقي = ((ب == 0x27) || (ب == 0x28) || (ب == 0x29) || (ب == 0x2B) || (ب == 0x5F) || (ب == 0x2C) || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x2F) || (ب == 0x3A) || (ب == 0x3D) || (ب == 0x3F));
        لو (ب == 0x20) {
            دع التالي: غير_موقع = ف + 1;
            لو (التالي >= العدد) { أرجع خطأ; };
        } وإلا لو (!أبجدي_رقمي && !خاص) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف بايتات_حد_متعدد_ويب(الحد: &نص, مع_بداية_سطر: منطقي): متجه غ8 {
    دع القيمة: نص = *الحد;
    دع الناتج: متغير متجه غ8 = [];
    لو (مع_بداية_سطر) { ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A); };
    ألحق(الناتج, 0x2D); ألحق(الناتج, 0x2D);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) { ألحق(الناتج, القيمة[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف بايتات_ويب_تطابق_عند(المصدر: &متجه غ8, النمط: &متجه غ8, الموضع: غير_موقع): منطقي {
    دع أ: متجه غ8 = *المصدر;
    دع ب: متجه غ8 = *النمط;
    دع عدد_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(ب) مثل غير_موقع;
    لو ((الموضع + عدد_ب) > عدد_أ) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_ب) {
        دع م: غير_موقع = الموضع + ف;
        لو (أ[م] != ب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابحث_بايتات_ويب_من(المصدر: &متجه غ8, النمط: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع أ: متجه غ8 = *المصدر;
    دع ب: متجه غ8 = *النمط;
    دع عدد_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(ب) مثل غير_موقع;
    لو (عدد_ب == 0) { أرجع اختيار.بعض(البداية); };
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف + عدد_ب) <= عدد_أ) {
        لو (بايتات_ويب_تطابق_عند(&أ, &ب, ف)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابحث_حد_متعدد_ويب(المصدر: &متجه غ8, النمط: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع أ: متجه غ8 = *المصدر;
    دع ب: متجه غ8 = *النمط;
    دع ف: متغير غير_موقع = البداية;
    دع انتهى: متغير منطقي = خطأ;
    بينما (!انتهى) {
        طابق ابحث_بايتات_ويب_من(&أ, &ب, ف) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(موضع) -> {
            دع بعد: غير_موقع = موضع + (الطول(ب) مثل غير_موقع);
            دع العدد_الكلي: غير_موقع = الطول(أ) مثل غير_موقع;
            لو ((بعد + 1) < العدد_الكلي) {
                دع بعد1: غير_موقع = بعد + 1;
                دع إغلاق: منطقي = ((أ[بعد] == 0x2D) && (أ[بعد1] == 0x2D));
                دع متابعة: منطقي = ((أ[بعد] == 0x0D) && (أ[بعد1] == 0x0A));
                لو (إغلاق || متابعة) { أرجع اختيار.بعض(موضع); };
            };
            ف := موضع + 1;
        };
    }
    أرجع اختيار.لا_شيء();
}

عرف انسخ_مدى_بايتات_ويب(المصدر: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): متجه غ8 {
    دع أ: متجه غ8 = *المصدر;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف < النهاية) && (ف < (الطول(أ) مثل غير_موقع))) { ألحق(الناتج, أ[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف حلل_رؤوس_جزء_ويب(المصدر: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع, الحدود: &حدود_متعدد_ويب): نتيجة متجه رأس_ويب, صنف_خطأ_متعدد_ويب {
    دع أ: متجه غ8 = *المصدر;
    دع حد: حدود_متعدد_ويب = *الحدود;
    لو ((النهاية - البداية) > حد.أقصى_بايتات_رؤوس_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كبيرة()); };
    دع الرؤوس: متغير متجه رأس_ويب = [];
    دع نهاية_السطر: متجه غ8 = [0x0D,0x0A];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        دع خط_النهاية: متغير غير_موقع = 0;
        طابق ابحث_بايتات_ويب_من(&أ, &نهاية_السطر, ف) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); }
        | اختيار.بعض(م) -> { خط_النهاية := م; };
        لو (خط_النهاية > النهاية) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        دع نقطتان: متغير غير_موقع = ف;
        بينما ((نقطتان < خط_النهاية) && (أ[نقطتان] != 0x3A)) { نقطتان := نقطتان + 1; }
        لو ((نقطتان == ف) || (نقطتان >= خط_النهاية)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        دع الاسم: نص = نص_ويب_من_مدى(&أ, ف, نقطتان);
        دع بداية_القيمة: متغير غير_موقع = نقطتان + 1;
        بينما ((بداية_القيمة < خط_النهاية) && ((أ[بداية_القيمة] == 0x20) || (أ[بداية_القيمة] == 0x09))) { بداية_القيمة := بداية_القيمة + 1; }
        دع نهاية_القيمة: متغير غير_موقع = خط_النهاية;
        دع قص: متغير منطقي = صواب;
        بينما ((نهاية_القيمة > بداية_القيمة) && قص) {
            دع السابق: غير_موقع = نهاية_القيمة - 1;
            لو ((أ[السابق] == 0x20) || (أ[السابق] == 0x09)) { نهاية_القيمة := السابق; } وإلا { قص := خطأ; };
        }
        دع القيمة: نص = نص_ويب_من_مدى(&أ, بداية_القيمة, نهاية_القيمة);
        لو (!أضف_رأس_ويب(&متغير الرؤوس, &الاسم, &القيمة)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        لو ((الطول(الرؤوس) مثل غير_موقع) > حد.أقصى_الرؤوس_للجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كثيرة()); };
        ف := خط_النهاية + 2;
    }
    أرجع نتيجة.نجح(الرؤوس);
}

عرف حلل_توزيع_نموذج_ويب(القيمة: &نص): نتيجة متجه نص, صنف_خطأ_متعدد_ويب {
    دع النص: نص = *القيمة;
    دع العدد: غير_موقع = الطول(النص) مثل غير_موقع;
    دع البايتات: متجه غ8 = بايتات_ويب_من_نص(&النص);
    دع ف: متغير غير_موقع = 0;
    بينما ((ف < العدد) && ((النص[ف] == 0x20) || (النص[ف] == 0x09))) { ف := ف + 1; }
    دع نهاية_النوع: متغير غير_موقع = ف;
    بينما ((نهاية_النوع < العدد) && (النص[نهاية_النوع] != 0x3B)) { نهاية_النوع := نهاية_النوع + 1; }
    دع نهاية_مقصوصة: متغير غير_موقع = نهاية_النوع;
    دع قص: متغير منطقي = صواب;
    بينما ((نهاية_مقصوصة > ف) && قص) {
        دع السابق: غير_موقع = نهاية_مقصوصة - 1;
        لو ((النص[السابق] == 0x20) || (النص[السابق] == 0x09)) { نهاية_مقصوصة := السابق; } وإلا { قص := خطأ; };
    }
    دع النوع_الخام: نص = نص_ويب_من_مدى(&البايتات, ف, نهاية_مقصوصة);
    دع النوع: نص = نص_ويب_صغير(&النوع_الخام);
    دع مطلوب: نص = «form-data»;
    لو (!نصان_متساويان(&النوع, &مطلوب)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };

    دع الاسم: متغير نص = «»;
    دع لديه_اسم: متغير منطقي = خطأ;
    دع اسم_الملف: متغير نص = «»;
    دع لديه_اسم_ملف: متغير منطقي = خطأ;
    ف := نهاية_النوع;
    بينما (ف < العدد) {
        لو (النص[ف] == 0x3B) { ف := ف + 1; };
        بينما ((ف < العدد) && ((النص[ف] == 0x20) || (النص[ف] == 0x09))) { ف := ف + 1; }
        لو (ف >= العدد) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع بداية_الاسم: غير_موقع = ف;
        بينما ((ف < العدد) && (النص[ف] != 0x3D) && (النص[ف] != 0x3B)) { ف := ف + 1; }
        لو ((ف >= العدد) || (النص[ف] != 0x3D)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع نهاية_اسم: متغير غير_موقع = ف;
        دع قص_اسم: متغير منطقي = صواب;
        بينما ((نهاية_اسم > بداية_الاسم) && قص_اسم) {
            دع السابق: غير_موقع = نهاية_اسم - 1;
            لو ((النص[السابق] == 0x20) || (النص[السابق] == 0x09)) { نهاية_اسم := السابق; } وإلا { قص_اسم := خطأ; };
        }
        دع اسم_خام: نص = نص_ويب_من_مدى(&البايتات, بداية_الاسم, نهاية_اسم);
        لو (!رمز_نوع_وسائط_ويب_صالح(&اسم_خام)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع اسم_معامل: نص = نص_ويب_صغير(&اسم_خام);
        ف := ف + 1;
        بينما ((ف < العدد) && ((النص[ف] == 0x20) || (النص[ف] == 0x09))) { ف := ف + 1; }
        دع بداية_القيمة: غير_موقع = ف;
        دع نهاية_القيمة: متغير غير_موقع = ف;
        لو ((ف < العدد) && (النص[ف] == 0x22)) {
            ف := ف + 1;
            دع هروب: متغير منطقي = خطأ;
            دع أغلق: متغير منطقي = خطأ;
            بينما ((ف < العدد) && !أغلق) {
                دع ب: غ8 = النص[ف];
                لو (هروب) { هروب := خطأ; ف := ف + 1; }
                وإلا لو (ب == 0x5C) { هروب := صواب; ف := ف + 1; }
                وإلا لو (ب == 0x22) { ف := ف + 1; نهاية_القيمة := ف; أغلق := صواب; }
                وإلا { ف := ف + 1; };
            }
            لو (!أغلق) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            دع تفحص: متغير غير_موقع = ف;
            بينما ((تفحص < العدد) && (النص[تفحص] != 0x3B)) {
                لو ((النص[تفحص] != 0x20) && (النص[تفحص] != 0x09)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
                تفحص := تفحص + 1;
            }
            ف := تفحص;
        } وإلا {
            بينما ((ف < العدد) && (النص[ف] != 0x3B)) { ف := ف + 1; }
            نهاية_القيمة := ف;
            دع قص_قيمة: متغير منطقي = صواب;
            بينما ((نهاية_القيمة > بداية_القيمة) && قص_قيمة) {
                دع السابق: غير_موقع = نهاية_القيمة - 1;
                لو ((النص[السابق] == 0x20) || (النص[السابق] == 0x09)) { نهاية_القيمة := السابق; } وإلا { قص_قيمة := خطأ; };
            }
        };
        دع قيمة_خام: نص = نص_ويب_من_مدى(&البايتات, بداية_القيمة, نهاية_القيمة);
        دع مفكوكة: متغير نص = «»;
        طابق فك_قيمة_معامل_نوع_وسائط_ويب(&قيمة_خام) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); }
        | نتيجة.نجح(قيمة_مفكوكة) -> { مفكوكة := قيمة_مفكوكة; };
        دع اسم_حقل: نص = «name»;
        دع اسم_ملف_معامل: نص = «filename»;
        لو (نصان_متساويان(&اسم_معامل, &اسم_حقل)) {
            لو (لديه_اسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            الاسم := مفكوكة;
            لديه_اسم := صواب;
        } وإلا لو (نصان_متساويان(&اسم_معامل, &اسم_ملف_معامل)) {
            لو (لديه_اسم_ملف) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            اسم_الملف := مفكوكة;
            لديه_اسم_ملف := صواب;
        };
        بينما ((ف < العدد) && (النص[ف] != 0x3B)) { ف := ف + 1; }
    }
    لو (!لديه_اسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.اسم_حقل_مفقود()); };
    دع الناتج: متغير متجه نص = [];
    ألحق(الناتج, الاسم);
    لو (لديه_اسم_ملف) { ألحق(الناتج, اسم_الملف); };
    أرجع نتيجة.نجح(الناتج);
}

عرف أنشئ_جزء_متعدد_ويب(الرؤوس: متجه رأس_ويب, الجسم: متجه غ8): نتيجة جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع اسم_التوزيع: نص = «content-disposition»;
    دع قيم_التوزيع: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_التوزيع);
    لو ((الطول(قيم_التوزيع) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_مفقود()); };
    لو ((الطول(قيم_التوزيع) مثل غير_موقع) != 1) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
    دع التوزيع: متغير متجه نص = [];
    طابق حلل_توزيع_نموذج_ويب(&قيم_التوزيع[0]) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { التوزيع := قيمة; };
    دع اسم_الجزء: نص = انسخ_نص_ويب(&التوزيع[0]);
    دع اسم_الملف: متغير اختيار نص = اختيار.لا_شيء();
    لو ((الطول(التوزيع) مثل غير_موقع) > 1) { اسم_الملف := اختيار.بعض(انسخ_نص_ويب(&التوزيع[1])); };
    دع اسم_نوع: نص = «content-type»;
    دع نوع_المحتوى: اختيار نص = أول_قيمة_رأس_ويب(&الرؤوس, &اسم_نوع);
    دع الناتج: جزء_متعدد_ويب = {
        الاسم: اسم_الجزء,
        اسم_الملف: اسم_الملف,
        نوع_المحتوى: نوع_المحتوى,
        الرؤوس: الرؤوس,
        الجسم: الجسم
    };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_نموذج_متعدد_ويب_بحدود(الطلب: &طلب_ويب_مخزن, الحدود: &حدود_متعدد_ويب): نتيجة متجه جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع القيمة: طلب_ويب_مخزن = *الطلب;
    دع حد: حدود_متعدد_ويب = *الحدود;
    دع اسم_نوع: نص = «content-type»;
    دع أنواع: متجه نص = قيم_رأس_ويب(&القيمة.الرؤوس, &اسم_نوع);
    لو ((الطول(أنواع) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_مفقود()); };
    لو ((الطول(أنواع) مثل غير_موقع) != 1) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_غير_صالح()); };
    دع النوع: متغير نوع_وسائط_ويب;
    طابق حلل_نوع_وسائط_ويب(&أنواع[0]) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_غير_صالح()); }
    | نتيجة.نجح(قيمة_نوع) -> { النوع := قيمة_نوع; };
    دع فئة: نص = «multipart»;
    دع فرعي: نص = «form-data»;
    لو (!نوع_وسائط_ويب_يطابق(&النوع, &فئة, &فرعي)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.ليس_نموذجا_متعدد_الأجزاء()); };
    دع اسم_الحد: نص = «boundary»;
    دع الحد_النصي: متغير نص = «»;
    طابق قيمة_معامل_نوع_وسائط_ويب(&النوع, &اسم_الحد) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.حد_مفقود()); }
    | اختيار.بعض(قيمة_حد) -> { الحد_النصي := قيمة_حد; };
    لو (!حد_متعدد_ويب_صالح(&الحد_النصي)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.حد_غير_صالح()); };

    دع بداية_حد: متجه غ8 = بايتات_حد_متعدد_ويب(&الحد_النصي, خطأ);
    دع حد_داخلي: متجه غ8 = بايتات_حد_متعدد_ويب(&الحد_النصي, صواب);
    دع عدد_الجسم: غير_موقع = الطول(القيمة.الجسم) مثل غير_موقع;
    دع الجسم: متجه غ8 = انسخ_مدى_بايتات_ويب(&القيمة.الجسم, 0, عدد_الجسم);
    دع بداية_الفاصل: متغير غير_موقع = 0;
    لو (!بايتات_ويب_تطابق_عند(&الجسم, &بداية_حد, 0)) {
        طابق ابحث_حد_متعدد_ويب(&الجسم, &حد_داخلي, 0) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختيار.بعض(م) -> { بداية_الفاصل := م + 2; };
    };
    دع موضع: متغير غير_موقع = بداية_الفاصل + (الطول(بداية_حد) مثل غير_موقع);
    لو ((موضع + 1) >= عدد_الجسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    دع موضع1: غير_موقع = موضع + 1;
    لو ((الجسم[موضع] == 0x2D) && (الجسم[موضع1] == 0x2D)) { دع فارغ: متجه جزء_متعدد_ويب = []; أرجع نتيجة.نجح(فارغ); };
    لو (!((الجسم[موضع] == 0x0D) && (الجسم[موضع1] == 0x0A))) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    موضع := موضع + 2;
    دع الأجزاء: متغير متجه جزء_متعدد_ويب = [];
    دع انتهى: متغير منطقي = خطأ;
    دع فاصل_الرؤوس: متجه غ8 = [0x0D,0x0A,0x0D,0x0A];
    بينما (!انتهى) {
        لو ((الطول(الأجزاء) مثل غير_موقع) >= حد.أقصى_الأجزاء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.أجزاء_كثيرة()); };
        دع نهاية_الرؤوس: متغير غير_موقع = 0;
        طابق ابحث_بايتات_ويب_من(&الجسم, &فاصل_الرؤوس, موضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختيار.بعض(م) -> { نهاية_الرؤوس := م; };
        لو ((نهاية_الرؤوس - موضع) > حد.أقصى_بايتات_رؤوس_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كبيرة()); };
        دع الرؤوس: متغير متجه رأس_ويب;
        طابق حلل_رؤوس_جزء_ويب(&الجسم, موضع, نهاية_الرؤوس + 2, &حد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة_رؤوس) -> { الرؤوس := قيمة_رؤوس; };
        دع بداية_الجسم: غير_موقع = نهاية_الرؤوس + 4;
        دع موضع_الحد: متغير غير_موقع = 0;
        طابق ابحث_حد_متعدد_ويب(&الجسم, &حد_داخلي, بداية_الجسم) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختيار.بعض(م) -> { موضع_الحد := م; };
        لو ((موضع_الحد - بداية_الجسم) > حد.أقصى_بايتات_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جزء_كبير()); };
        دع جسم_الجزء: متجه غ8 = انسخ_مدى_بايتات_ويب(&الجسم, بداية_الجسم, موضع_الحد);
        طابق أنشئ_جزء_متعدد_ويب(الرؤوس, جسم_الجزء) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجزء) -> { ألحق(الأجزاء, الجزء); };
        موضع := موضع_الحد + (الطول(حد_داخلي) مثل غير_موقع);
        لو ((موضع + 1) >= عدد_الجسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
        دع تالي: غير_موقع = موضع + 1;
        لو ((الجسم[موضع] == 0x2D) && (الجسم[تالي] == 0x2D)) { انتهى := صواب; موضع := موضع + 2; }
        وإلا لو ((الجسم[موضع] == 0x0D) && (الجسم[تالي] == 0x0A)) { موضع := موضع + 2; }
        وإلا { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    }
    أرجع نتيجة.نجح(الأجزاء);
}

عام عرف حلل_نموذج_متعدد_ويب(الطلب: &طلب_ويب_مخزن): نتيجة متجه جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع الحدود: حدود_متعدد_ويب = حدود_متعدد_ويب_افتراضية();
    أرجع حلل_نموذج_متعدد_ويب_بحدود(الطلب, &الحدود);
}

عرف انسخ_اختيار_نص_ويب(القيمة: &اختيار نص): اختيار نص {
    طابق *القيمة مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(النص) -> { دع النسخة: نص = انسخ_نص_ويب(&النص); أرجع اختيار.بعض(النسخة); };
}

عام عرف اسم_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): نص { دع قيمة: جزء_متعدد_ويب = *الجزء; أرجع انسخ_نص_ويب(&قيمة.الاسم); }
عام عرف اسم_ملف_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): اختيار نص { دع قيمة: جزء_متعدد_ويب = *الجزء; أرجع انسخ_اختيار_نص_ويب(&قيمة.اسم_الملف); }
عام عرف نوع_محتوى_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): اختيار نص { دع قيمة: جزء_متعدد_ويب = *الجزء; أرجع انسخ_اختيار_نص_ويب(&قيمة.نوع_المحتوى); }
عام عرف جسم_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): متجه غ8 {
    دع قيمة: جزء_متعدد_ويب = *الجزء;
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(قيمة.الجسم) مثل غير_موقع)) { ألحق(الناتج, قيمة.الجسم[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام نوع http_multipart_part = جزء_متعدد_ويب;
عام نوع http_multipart_limits = حدود_متعدد_ويب;
عام نوع http_multipart_error_kind = صنف_خطأ_متعدد_ويب;
عام مرادف default_http_multipart_limits = حدود_متعدد_ويب_افتراضية;
عام مرادف parse_http_multipart_with_limits = حلل_نموذج_متعدد_ويب_بحدود;
عام مرادف parse_http_multipart = حلل_نموذج_متعدد_ويب;
عام مرادف http_multipart_part_name = اسم_جزء_متعدد_ويب;
عام مرادف http_multipart_part_filename = اسم_ملف_جزء_متعدد_ويب;
عام مرادف http_multipart_part_content_type = نوع_محتوى_جزء_متعدد_ويب;
عام مرادف http_multipart_part_body = جسم_جزء_متعدد_ويب;
