استورد chars.ascii;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;

عام نوع جسم_مجزأ_ويب1 = {
    الجسم: متجه غ8,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    المستهلك: غير_موقع
};

عرف بايت_قيمة_سداسية_ويب(القيمة: غ8): عدد {
    دع الناتج: عدد = قيمة_رقم_أسكي(القيمة);
    لو ((الناتج >= 0) && (الناتج < 16)) { أرجع الناتج; };
    أرجع -1;
}

عرف قيمة_امتداد_قطعة_مسموحة(القيمة: غ8): منطقي {
    لو (القيمة == 0x09) { أرجع صواب; };
    لو ((القيمة >= 0x20) && (القيمة <= 0x7E)) { أرجع صواب; };
    لو (القيمة >= 0x80) { أرجع صواب; };
    أرجع خطأ;
}

// RFC 9112 chunk-ext = *( ";" chunk-ext-name [ "=" chunk-ext-val ] ).
// We accept token or quoted-string values and reject arbitrary suffix bytes.
عام عرف حلل_سطر_حجم_قطعة_ويب1(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    النهاية: غير_موقع
): نتيجة غير_موقع, خطأ_ويب {
    دع المصدر: متجه غ8 = *البايتات;
    لو (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), البداية)); };
    دع ف: متغير غير_موقع = البداية;
    دع الحجم: متغير غير_موقع = 0;
    دع رأى_رقما: متغير منطقي = خطأ;
    بينما (ف < النهاية) {
        دع ب: غ8 = المصدر[ف];
        لو (ب == 0x3B) { ف := النهاية; }
        وإلا {
            دع الرقم: عدد = بايت_قيمة_سداسية_ويب(ب);
            لو (الرقم < 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), ف)); };
            رأى_رقما := صواب;
            دع الرقم_غير_موقع: غير_موقع = الرقم مثل غير_موقع;
            دع الأعلى: غير_موقع = ~((0 مثل غير_موقع));
            لو (الحجم > ((الأعلى - الرقم_غير_موقع) / 16)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), ف)); };
            الحجم := (الحجم * 16) + الرقم_غير_موقع;
            ف := ف + 1;
        };
    }
    لو (!رأى_رقما) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), البداية)); };

    // Find the first extension delimiter again; the size scan intentionally stops there.
    دع موضع: متغير غير_موقع = البداية;
    بينما ((موضع < النهاية) && (المصدر[موضع] != 0x3B)) { موضع := موضع + 1; }
    بينما (موضع < النهاية) {
        لو (المصدر[موضع] != 0x3B) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
        موضع := موضع + 1;
        دع بداية_الاسم: غير_موقع = موضع;
        بينما ((موضع < النهاية) && حرف_رمز_ويب(المصدر[موضع])) { موضع := موضع + 1; }
        لو (موضع == بداية_الاسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
        لو ((موضع < النهاية) && (المصدر[موضع] == 0x3D)) {
            موضع := موضع + 1;
            لو (موضع >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            لو (المصدر[موضع] == 0x22) {
                موضع := موضع + 1;
                دع مغلق: متغير منطقي = خطأ;
                بينما ((موضع < النهاية) && !مغلق) {
                    دع ب: غ8 = المصدر[موضع];
                    لو (ب == 0x22) { مغلق := صواب; موضع := موضع + 1; }
                    وإلا لو (ب == 0x5C) {
                        موضع := موضع + 1;
                        لو ((موضع >= النهاية) || !قيمة_امتداد_قطعة_مسموحة(المصدر[موضع])) {
                            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
                        };
                        موضع := موضع + 1;
                    }
                    وإلا {
                        لو (!قيمة_امتداد_قطعة_مسموحة(ب) || (ب == 0x7F)) {
                            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
                        };
                        موضع := موضع + 1;
                    };
                }
                لو (!مغلق) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            } وإلا {
                دع بداية_القيمة: غير_موقع = موضع;
                بينما ((موضع < النهاية) && حرف_رمز_ويب(المصدر[موضع])) { موضع := موضع + 1; }
                لو (موضع == بداية_القيمة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            };
        };
        لو ((موضع < النهاية) && (المصدر[موضع] != 0x3B)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
        };
    }
    أرجع نتيجة.نجح(الحجم);
}

عام عرف حلل_جسم_مجزأ_ويب1(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    أقصى_بايتات_جسم: غير_موقع,
    أقصى_بايتات_سطر_قطعة: غير_موقع,
    أقصى_بايتات_رؤوس_لاحقة: غير_موقع,
    أقصى_عدد_رؤوس_لاحقة: غير_موقع
): نتيجة جسم_مجزأ_ويب1, خطأ_ويب {
    دع المصدر: متجه غ8 = *البايتات;
    دع العدد: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع الجسم: متغير متجه غ8 = [];
    دع الرؤوس_اللاحقة: متغير متجه رأس_ويب = [];
    دع الموضع: متغير غير_موقع = البداية;
    بينما (صواب) {
        دع نهاية_الحجم: متغير غير_موقع = 0;
        طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
        | اختيار.لا_شيء -> {
            لو ((العدد - الموضع) > أقصى_بايتات_سطر_قطعة) {
                أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_قطعة_طويل(), الموضع));
            };
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
        }
        | اختيار.بعض(قيمة) -> { نهاية_الحجم := قيمة; };
        لو ((نهاية_الحجم - الموضع) > أقصى_بايتات_سطر_قطعة) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_قطعة_طويل(), الموضع));
        };
        دع حجم_القطعة: متغير غير_موقع = 0;
        طابق حلل_سطر_حجم_قطعة_ويب1(&المصدر, الموضع, نهاية_الحجم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة) -> { حجم_القطعة := قيمة; };
        الموضع := نهاية_الحجم + 2;
        لو (حجم_القطعة == 0) {
            دع بداية_الرؤوس: غير_موقع = الموضع;
            بينما (صواب) {
                لو ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
                دع الموضع_التالي: غير_موقع = الموضع + 1;
                لو ((المصدر[الموضع] == 0x0D) && (المصدر[الموضع_التالي] == 0x0A)) {
                    الموضع := الموضع + 2;
                    دع الناتج: جسم_مجزأ_ويب1 = { الجسم: الجسم, الرؤوس_اللاحقة: الرؤوس_اللاحقة, المستهلك: الموضع };
                    أرجع نتيجة.نجح(الناتج);
                };
                لو ((الطول(الرؤوس_اللاحقة) مثل غير_موقع) >= أقصى_عدد_رؤوس_لاحقة) {
                    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع));
                };
                دع نهاية_الرأس: متغير غير_موقع = 0;
                طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
                | اختيار.بعض(قيمة) -> { نهاية_الرأس := قيمة; };
                طابق حلل_رأس_ويب_خام(&المصدر, الموضع, نهاية_الرأس) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الرأس) -> {
                    لو (رأس_لاحق_ويب_ممنوع(&الرأس)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), الموضع)); };
                    ألحق(الرؤوس_اللاحقة, الرأس);
                };
                الموضع := نهاية_الرأس + 2;
                لو ((الموضع - بداية_الرؤوس) > أقصى_بايتات_رؤوس_لاحقة) {
                    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع));
                };
            }
        };
        دع الحالي: غير_موقع = الطول(الجسم) مثل غير_موقع;
        لو ((الحالي > أقصى_بايتات_جسم) || (حجم_القطعة > (أقصى_بايتات_جسم - الحالي))) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع));
        };
        لو ((العدد - الموضع) < حجم_القطعة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        دع نهاية_البيانات: غير_موقع = الموضع + حجم_القطعة;
        لو ((نهاية_البيانات + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        ألحق_بايتات_ويب(&متغير الجسم, &المصدر, الموضع, حجم_القطعة);
        دع بعد_نهاية_البيانات: غير_موقع = نهاية_البيانات + 1;
        لو ((المصدر[نهاية_البيانات] != 0x0D) || (المصدر[بعد_نهاية_البيانات] != 0x0A)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.نهاية_قطعة_غير_صالحة(), نهاية_البيانات));
        };
        الموضع := نهاية_البيانات + 2;
    }
    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع));
}

عرف ألحق_غير_موقع_سداسي_ويب(الناتج: &متغير متجه غ8, القيمة: غير_موقع): فراغ {
    لو (القيمة == 0) { ألحق(*الناتج, 0x30); أرجع; };
    دع الأرقام: متغير متجه غ8 = [];
    دع الباقي: متغير غير_موقع = القيمة;
    بينما (الباقي > 0) {
        دع الرقم: غير_موقع = الباقي % 16;
        دع البايت: متغير غ8 = 0;
        لو (الرقم < 10) { البايت := 0x30 + (الرقم مثل غ8); }
        وإلا { البايت := 0x61 + ((الرقم - 10) مثل غ8); };
        ألحق(الأرقام, البايت);
        الباقي := الباقي / 16;
    }
    دع ف: متغير غير_موقع = الطول(الأرقام) مثل غير_موقع;
    بينما (ف > 0) { ف := ف - 1; ألحق(*الناتج, الأرقام[ف]); }
}

عام عرف سلسل_جسم_مجزأ_ويب1(الجسم: &متجه غ8, الرؤوس_اللاحقة: &متجه رأس_ويب): نتيجة متجه غ8, خطأ_ويب {
    دع الناتج: متغير متجه غ8 = [];
    دع حجم_الجسم: غير_موقع = الطول(*الجسم) مثل غير_موقع;
    لو (حجم_الجسم > 0) {
        ألحق_غير_موقع_سداسي_ويب(&متغير الناتج, حجم_الجسم);
        ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ألحق_بايتات_ويب(&متغير الناتج, الجسم, 0, حجم_الجسم);
        ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    };
    ألحق(الناتج, 0x30); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرؤوس_اللاحقة) مثل غير_موقع)) {
        دع اسم_الرأس: نص = انسخ_نص_ويب(&(*الرؤوس_اللاحقة)[ف].الاسم);
        دع قيمة_الرأس: نص = انسخ_نص_ويب(&(*الرؤوس_اللاحقة)[ف].القيمة);
        دع الرأس: رأس_ويب = { الاسم: اسم_الرأس, القيمة: قيمة_الرأس };
        لو (رأس_لاحق_ويب_ممنوع(&الرأس) || !اسم_رأس_ويب_صالح(&الرأس.الاسم) || !قيمة_رأس_ويب_صالحة(&الرأس.القيمة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0));
        };
        ألحق_نص_ويب(&متغير الناتج, &الرأس.الاسم); ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_ويب(&متغير الناتج, &الرأس.القيمة); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    أرجع نتيجة.نجح(الناتج);
}
