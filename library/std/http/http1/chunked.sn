استورد حروف.أسكي;
استورد ويب.نموذج;
استورد ويب.ترويسات;
استورد ويب.حدود;
استورد ويب.ويب1.مشترك;

عام نوع جسم_مجزأ_ويب1 = {
    الجسم: متجه ط8,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    المستهلك: طبيعي
};

عرف بايت_قيمة_سداسية_ويب(القيمة: ط8): عدد {
    ليكن الناتج: عدد = قيمة_رقم_أسكي(القيمة);
    إذا ((الناتج >= 0) && (الناتج < 16)) { أرجع الناتج; };
    أرجع -1;
}

عرف قيمة_امتداد_قطعة_مسموحة(القيمة: ط8): منطقي {
    إذا (القيمة == 0x09) { أرجع صواب; };
    إذا ((القيمة >= 0x20) && (القيمة <= 0x7E)) { أرجع صواب; };
    إذا (القيمة >= 0x80) { أرجع صواب; };
    أرجع خطأ;
}

// RFC 9112 chunk-ext = *( ";" chunk-ext-name [ "=" chunk-ext-val ] ).
// We accept token or quoted-string values and reject arbitrary suffix bytes.
عام عرف حلل_سطر_حجم_قطعة_ويب1(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    النهاية: طبيعي
): نتيجة طبيعي, خطأ_ويب {
    إذا (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), البداية)); };
    ليكن ف: متغير طبيعي = البداية;
    ليكن الحجم: متغير طبيعي = 0;
    ليكن رأى_رقما: متغير منطقي = خطأ;
    طالما (ف < النهاية) {
        ليكن ب: ط8 = (*البايتات)[ف];
        إذا (ب == 0x3B) { ف := النهاية; }
        وإلا {
            ليكن الرقم: عدد = بايت_قيمة_سداسية_ويب(ب);
            إذا (الرقم < 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), ف)); };
            رأى_رقما := صواب;
            ليكن الرقم_طبيعي: طبيعي = الرقم مثل طبيعي;
            ليكن الأعلى: طبيعي = ~((0 مثل طبيعي));
            إذا (الحجم > ((الأعلى - الرقم_طبيعي) / 16)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), ف)); };
            الحجم := (الحجم * 16) + الرقم_طبيعي;
            ف := ف + 1;
        };
    }
    إذا (!رأى_رقما) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), البداية)); };

    // Find the first extension delimiter again; the size scan intentionally stops there.
    ليكن موضع: متغير طبيعي = البداية;
    طالما ((موضع < النهاية) && ((*البايتات)[موضع] != 0x3B)) { موضع := موضع + 1; }
    طالما (موضع < النهاية) {
        إذا ((*البايتات)[موضع] != 0x3B) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
        موضع := موضع + 1;
        ليكن بداية_الاسم: طبيعي = موضع;
        طالما ((موضع < النهاية) && حرف_رمز_ويب((*البايتات)[موضع])) { موضع := موضع + 1; }
        إذا (موضع == بداية_الاسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
        إذا ((موضع < النهاية) && ((*البايتات)[موضع] == 0x3D)) {
            موضع := موضع + 1;
            إذا (موضع >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            إذا ((*البايتات)[موضع] == 0x22) {
                موضع := موضع + 1;
                ليكن مغلق: متغير منطقي = خطأ;
                طالما ((موضع < النهاية) && !مغلق) {
                    ليكن ب: ط8 = (*البايتات)[موضع];
                    إذا (ب == 0x22) { مغلق := صواب; موضع := موضع + 1; }
                    وإلا إذا (ب == 0x5C) {
                        موضع := موضع + 1;
                        إذا ((موضع >= النهاية) || !قيمة_امتداد_قطعة_مسموحة((*البايتات)[موضع])) {
                            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
                        };
                        موضع := موضع + 1;
                    }
                    وإلا {
                        إذا (!قيمة_امتداد_قطعة_مسموحة(ب) || (ب == 0x7F)) {
                            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
                        };
                        موضع := موضع + 1;
                    };
                }
                إذا (!مغلق) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            } وإلا {
                ليكن بداية_القيمة: طبيعي = موضع;
                طالما ((موضع < النهاية) && حرف_رمز_ويب((*البايتات)[موضع])) { موضع := موضع + 1; }
                إذا (موضع == بداية_القيمة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع)); };
            };
        };
        إذا ((موضع < النهاية) && ((*البايتات)[موضع] != 0x3B)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حجم_قطعة_غير_صالح(), موضع));
        };
    }
    أرجع نتيجة.نجح(الحجم);
}

عام عرف حلل_جسم_مجزأ_ويب1(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    أقصى_بايتات_جسم: طبيعي,
    أقصى_بايتات_سطر_قطعة: طبيعي,
    أقصى_بايتات_رؤوس_لاحقة: طبيعي,
    أقصى_عدد_رؤوس_لاحقة: طبيعي
): نتيجة جسم_مجزأ_ويب1, خطأ_ويب {
    ليكن العدد: طبيعي = الطول((*البايتات)) مثل طبيعي;
    ليكن الجسم: متغير متجه ط8 = [];
    ليكن الرؤوس_اللاحقة: متغير متجه رأس_ويب = [];
    ليكن الموضع: متغير طبيعي = البداية;
    طالما (صواب) {
        ليكن نهاية_الحجم: متغير طبيعي = 0;
        طابق ابحث_نهاية_سطر_ويب(البايتات, الموضع) مع
        | اختياري.لا_شيء -> {
            إذا ((العدد - الموضع) > أقصى_بايتات_سطر_قطعة) {
                أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_قطعة_طويل(), الموضع));
            };
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
        }
        | اختياري.موجود(قيمة) -> { نهاية_الحجم := قيمة; };
        إذا ((نهاية_الحجم - الموضع) > أقصى_بايتات_سطر_قطعة) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_قطعة_طويل(), الموضع));
        };
        ليكن حجم_القطعة: متغير طبيعي = 0;
        طابق حلل_سطر_حجم_قطعة_ويب1(البايتات, الموضع, نهاية_الحجم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة) -> { حجم_القطعة := قيمة; };
        الموضع := نهاية_الحجم + 2;
        إذا (حجم_القطعة == 0) {
            ليكن بداية_الرؤوس: طبيعي = الموضع;
            طالما (صواب) {
                إذا ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
                ليكن الموضع_التالي: طبيعي = الموضع + 1;
                إذا (((*البايتات)[الموضع] == 0x0D) && ((*البايتات)[الموضع_التالي] == 0x0A)) {
                    الموضع := الموضع + 2;
                    ليكن الناتج: جسم_مجزأ_ويب1 = { الجسم: الجسم, الرؤوس_اللاحقة: الرؤوس_اللاحقة, المستهلك: الموضع };
                    أرجع نتيجة.نجح(الناتج);
                };
                إذا ((الطول(الرؤوس_اللاحقة) مثل طبيعي) >= أقصى_عدد_رؤوس_لاحقة) {
                    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع));
                };
                ليكن نهاية_الرأس: متغير طبيعي = 0;
                طابق ابحث_نهاية_سطر_ويب(البايتات, الموضع) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
                | اختياري.موجود(قيمة) -> { نهاية_الرأس := قيمة; };
                طابق حلل_رأس_ويب_خام(البايتات, الموضع, نهاية_الرأس) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الرأس) -> {
                    إذا (رأس_لاحق_ويب_ممنوع(&الرأس)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), الموضع)); };
                    ألحق(الرؤوس_اللاحقة, الرأس);
                };
                الموضع := نهاية_الرأس + 2;
                إذا ((الموضع - بداية_الرؤوس) > أقصى_بايتات_رؤوس_لاحقة) {
                    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع));
                };
            }
        };
        ليكن الحالي: طبيعي = الطول(الجسم) مثل طبيعي;
        إذا ((الحالي > أقصى_بايتات_جسم) || (حجم_القطعة > (أقصى_بايتات_جسم - الحالي))) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع));
        };
        إذا ((العدد - الموضع) < حجم_القطعة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        ليكن نهاية_البيانات: طبيعي = الموضع + حجم_القطعة;
        إذا ((نهاية_البيانات + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        ألحق_بايتات_ويب(&متغير الجسم, البايتات, الموضع, حجم_القطعة);
        ليكن بعد_نهاية_البيانات: طبيعي = نهاية_البيانات + 1;
        إذا (((*البايتات)[نهاية_البيانات] != 0x0D) || ((*البايتات)[بعد_نهاية_البيانات] != 0x0A)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.نهاية_قطعة_غير_صالحة(), نهاية_البيانات));
        };
        الموضع := نهاية_البيانات + 2;
    }
    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع));
}

عام عرف ألحق_طبيعي_سداسي_ويب(الناتج: &متغير متجه ط8, القيمة: طبيعي): فراغ {
    إذا (القيمة == 0) { ألحق(*الناتج, 0x30); أرجع; };
    ليكن الأرقام: متغير متجه ط8 = [];
    ليكن الباقي: متغير طبيعي = القيمة;
    طالما (الباقي > 0) {
        ليكن الرقم: طبيعي = الباقي % 16;
        ليكن البايت: متغير ط8 = 0;
        إذا (الرقم < 10) { البايت := 0x30 + (الرقم مثل ط8); }
        وإلا { البايت := 0x61 + ((الرقم - 10) مثل ط8); };
        ألحق(الأرقام, البايت);
        الباقي := الباقي / 16;
    }
    ليكن ف: متغير طبيعي = الطول(الأرقام) مثل طبيعي;
    طالما (ف > 0) { ف := ف - 1; ألحق(*الناتج, الأرقام[ف]); }
}

عام عرف سلسل_جسم_مجزأ_ويب1(الجسم: &متجه ط8, الرؤوس_اللاحقة: &متجه رأس_ويب): نتيجة متجه ط8, خطأ_ويب {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن حجم_الجسم: طبيعي = الطول(*الجسم) مثل طبيعي;
    إذا (حجم_الجسم > 0) {
        ألحق_طبيعي_سداسي_ويب(&متغير الناتج, حجم_الجسم);
        ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ألحق_بايتات_ويب(&متغير الناتج, الجسم, 0, حجم_الجسم);
        ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    };
    ألحق(الناتج, 0x30); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرؤوس_اللاحقة) مثل طبيعي)) {
        ليكن الرأس: رأس_ويب = (*الرؤوس_اللاحقة)[ف];
        إذا (رأس_لاحق_ويب_ممنوع(&الرأس) || !اسم_رأس_ويب_صالح(&الرأس.الاسم) || !قيمة_رأس_ويب_صالحة(&الرأس.القيمة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0));
        };
        ألحق_نص_ويب(&متغير الناتج, &الرأس.الاسم); ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_ويب(&متغير الناتج, &الرأس.القيمة); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    أرجع نتيجة.نجح(الناتج);
}
