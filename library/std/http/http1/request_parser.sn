استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;
عام نوع طلب_ويب_محلل = {
    الطلب: طلب_ويب_مخزن,
    المستهلك: طبيعي
};

عام عرف حلل_طلب_ويب1(البايتات: &متجه ط8, الحدود: &حدود_ويب): نتيجة طلب_ويب_محلل, خطأ_ويب {
    دع المصدر: متجه ط8 = *البايتات;
    دع الحد: حدود_ويب = *الحدود;
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    دع نهاية_سطر_البداية: متغير طبيعي = 0;
    طابق ابحث_نهاية_سطر_ويب(&المصدر, 0) مع
    | اختياري.لا_شيء -> {
        لو (العدد > الحد.أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), الحد.أقصى_سطر_بداية)); };
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
    }
    | اختياري.موجود(م) -> { نهاية_سطر_البداية := م; };
    لو (نهاية_سطر_البداية > الحد.أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), نهاية_سطر_البداية)); };

    دع طريقة_فارغة: نص = «»;
    دع هدف_فارغ: نص = «»;
    دع إصدار_افتراضي: إصدار_ويب = إصدار_ويب.واحد_واحد();
    دع رؤوس_فارغة: متجه رأس_ويب = [];
    دع رؤوس_لاحقة_فارغة: متجه رأس_ويب = [];
    دع جسم_فارغ: متجه ط8 = [];
    دع الطلب: متغير طلب_ويب_مخزن = {
        الطريقة: طريقة_فارغة, الهدف: هدف_فارغ, الإصدار: إصدار_افتراضي, الرؤوس: رؤوس_فارغة, الرؤوس_اللاحقة: رؤوس_لاحقة_فارغة, الجسم: جسم_فارغ
    };
    طابق حلل_سطر_طلب_ويب(&المصدر, نهاية_سطر_البداية) مع
    | نتيجة.نجح(قيمة) -> { الطلب := قيمة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };

    دع الموضع: متغير طبيعي = نهاية_سطر_البداية + 2;
    دع بداية_الرؤوس: طبيعي = الموضع;
    دع عدد_الرؤوس: متغير طبيعي = 0;
    دع انتهت_الرؤوس: متغير منطقي = خطأ;
    طالما (!انتهت_الرؤوس) {
        لو ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
        دع التالي: طبيعي = الموضع + 1;
        لو ((المصدر[الموضع] == 0x0D) && (المصدر[التالي] == 0x0A)) {
            الموضع := الموضع + 2;
            انتهت_الرؤوس := صواب;
        } وإلا {
            لو ((الموضع - بداية_الرؤوس) > الحد.أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
            لو (عدد_الرؤوس >= الحد.أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
            دع نهاية_السطر: متغير طبيعي = 0;
            طابق ابحث_نهاية_سطر_ويب(&المصدر, الموضع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختياري.موجود(م) -> { نهاية_السطر := م; };
            طابق حلل_رأس_ويب_خام(&المصدر, الموضع, نهاية_السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الرأس) -> {
                ألحق(الطلب.الرؤوس, الرأس);
            };
            عدد_الرؤوس := عدد_الرؤوس + 1;
            الموضع := نهاية_السطر + 2;
        };
    }
    لو ((الموضع - بداية_الرؤوس) > الحد.أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };

    دع يتطلب_مضيف: متغير منطقي = خطأ;
    طابق الطلب.الإصدار مع
    | إصدار_ويب.واحد_واحد -> { يتطلب_مضيف := صواب; }
    | _ -> { };
    لو (يتطلب_مضيف) {
        دع اسم_المضيف: نص = «host»;
        دع المضيفون: متجه نص = قيم_رأس_ويب(&الطلب.الرؤوس, &اسم_المضيف);
        دع عدد_المضيفين: طبيعي = الطول(المضيفون) مثل طبيعي;
        لو (عدد_المضيفين == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), الموضع)); };
        لو (عدد_المضيفين > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), الموضع)); };
        لو (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), الموضع)); };
    };

    دع طول_محتوى: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ترميز_نقل: متغير اختياري نص = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الطلب.الرؤوس) مثل طبيعي)) {
        لو (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «content-length»)) {
            طابق طول_محتوى مع
            | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), الموضع)); }
            | اختياري.لا_شيء -> {
                طابق قيمة_طبيعية_عشرية_ويب(&الطلب.الرؤوس[ف].القيمة) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع)); }
                | اختياري.موجود(قيمة) -> { طول_محتوى := اختياري.موجود(قيمة); };
            };
        };
        لو (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «transfer-encoding»)) {
            طابق ترميز_نقل مع
            | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); }
            | اختياري.لا_شيء -> { ترميز_نقل := اختياري.موجود(انسخ_نص_ويب(&الطلب.الرؤوس[ف].القيمة)); };
        };
        ف := ف + 1;
    }
    طابق ترميز_نقل مع
    | اختياري.موجود(_) -> {
        طابق طول_محتوى مع | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), الموضع)); } | _ -> { };
    }
    | _ -> { };

    طابق ترميز_نقل مع
    | اختياري.لا_شيء -> {
        دع طول_الجسم: متغير طبيعي = 0;
        طابق طول_محتوى مع | اختياري.موجود(قيمة) -> { طول_الجسم := قيمة; } | _ -> { };
        لو (طول_الجسم > الحد.أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
        لو ((العدد - الموضع) < طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        الطلب.الجسم := انسخ_بايتات_ويب(&المصدر, الموضع, طول_الجسم);
        دع المستهلك: طبيعي = الموضع + طول_الجسم;
        دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: المستهلك };
        أرجع نتيجة.نجح(الناتج);
    }
    | اختياري.موجود(الترميز_الخام) -> {
        لو (!ترميز_نقل_مجزأ_ويب1(&الترميز_الخام)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
        };
        طابق حلل_جسم_مجزأ_ويب1(
            &المصدر,
            الموضع,
            الحد.أقصى_بايتات_جسم,
            الحد.أقصى_بايتات_سطر_قطعة,
            الحد.أقصى_بايتات_رؤوس,
            الحد.أقصى_عدد_رؤوس
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجزأ) -> {
            الطلب.الجسم := انسخ_بايتات_ويب(&المجزأ.الجسم, 0, الطول(المجزأ.الجسم) مثل طبيعي);
            الطلب.الرؤوس_اللاحقة := انسخ_رؤوس_ويب(&المجزأ.الرؤوس_اللاحقة);
            دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: المجزأ.المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    };
    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
}

عام نوع مفكك_ويب1 = {
    المخزن: متجه ط8,
    الحدود: حدود_ويب
};

عام عرف مفكك_ويب1_جديد(الحدود: حدود_ويب): مفكك_ويب1 {
    دع المخزن: متجه ط8 = [];
    دع الناتج: مفكك_ويب1 = { المخزن: المخزن, الحدود: الحدود };
    أرجع الناتج;
}

عام عرف غذ_مفكك_ويب1(المفكك: &متغير مفكك_ويب1, البايتات: &متجه ط8): فراغ {
    دع المصدر: متجه ط8 = *البايتات;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) { ألحق((*المفكك).المخزن, المصدر[ف]); ف := ف + 1; }
}

عام عرف التالي_من_مفكك_ويب1(المفكك: &متغير مفكك_ويب1): نتيجة اختياري طلب_ويب_محلل, خطأ_ويب {
    طابق حلل_طلب_ويب1(&(*المفكك).المخزن, &(*المفكك).الحدود) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ.الصنف مع
        | صنف_خطأ_ويب.غير_مكتمل -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | _ -> { أرجع نتيجة.خطأ(الخطأ); };
    }
    | نتيجة.نجح(المحلل) -> {
        دع الباقي: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = المحلل.المستهلك;
        طالما (ف < (الطول((*المفكك).المخزن) مثل طبيعي)) { ألحق(الباقي, (*المفكك).المخزن[ف]); ف := ف + 1; }
        (*المفكك).المخزن := الباقي;
        أرجع نتيجة.نجح(اختياري.موجود(المحلل));
    };
}

عام عرف بايتات_معلقة_في_مفكك_ويب1(المفكك: &مفكك_ويب1): طبيعي {
    دع الحالة: مفكك_ويب1 = *المفكك;
    أرجع الطول(الحالة.المخزن) مثل طبيعي;
}
عام عرف بايتات_طلب_مستهلكة(المحلل: &طلب_ويب_محلل): طبيعي { دع القيمة: طلب_ويب_محلل = *المحلل; أرجع القيمة.المستهلك; }
عام عرف طلب_من_طلب_محلل(المحلل: &طلب_ويب_محلل): طلب_ويب_مخزن {
    دع القيمة: طلب_ويب_محلل = *المحلل;
    دع الطريقة: نص = انسخ_نص_ويب(&القيمة.الطلب.الطريقة);
    دع الهدف: نص = انسخ_نص_ويب(&القيمة.الطلب.الهدف);
    دع الإصدار: إصدار_ويب = القيمة.الطلب.الإصدار;
    دع الرؤوس: متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الطلب.الرؤوس);
    دع الرؤوس_اللاحقة: متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الطلب.الرؤوس_اللاحقة);
    دع الجسم: متجه ط8 = انسخ_بايتات_ويب(&القيمة.الطلب.الجسم, 0, الطول(القيمة.الطلب.الجسم) مثل طبيعي);
    دع الطلب: طلب_ويب_مخزن = { الطريقة: الطريقة, الهدف: الهدف, الإصدار: الإصدار, الرؤوس: الرؤوس, الرؤوس_اللاحقة: الرؤوس_اللاحقة, الجسم: الجسم };
    أرجع الطلب;
}
عام عرف صنف_خطأ_ويب_لقيمة(الخطأ: &خطأ_ويب): صنف_خطأ_ويب { دع القيمة: خطأ_ويب = *الخطأ; أرجع القيمة.الصنف; }
عام عرف إزاحة_خطأ_ويب(الخطأ: &خطأ_ويب): طبيعي { دع القيمة: خطأ_ويب = *الخطأ; أرجع القيمة.الإزاحة; }

// English public aliases.
عام مرادف parsed_http_request = طلب_ويب_محلل;
عام مرادف http1_decoder = مفكك_ويب1;
عام مرادف parse_http1_request = حلل_طلب_ويب1;
عام مرادف new_http1_decoder = مفكك_ويب1_جديد;
عام مرادف http1_decoder_feed = غذ_مفكك_ويب1;
عام مرادف http1_decoder_next = التالي_من_مفكك_ويب1;
عام مرادف http1_decoder_pending_bytes = بايتات_معلقة_في_مفكك_ويب1;
عام مرادف parsed_http_request_consumed = بايتات_طلب_مستهلكة;
عام مرادف parsed_http_request_value = طلب_من_طلب_محلل;
عام مرادف http_error_class = صنف_خطأ_ويب_لقيمة;
عام مرادف http_error_offset = إزاحة_خطأ_ويب;
