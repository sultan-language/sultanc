استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;
استورد http.http1.views;
عام نوع طلب_ويب_محلل = {
    الطلب: طلب_ويب_مخزن,
    المستهلك: طبيعي
};

عام عرف حلل_طلب_ويب1(البايتات: &متجه ط8, الحدود: &حدود_ويب): نتيجة طلب_ويب_محلل, خطأ_ويب {
    دع العدد: طبيعي = الطول((*البايتات)) مثل طبيعي;
    دع نهاية_سطر_البداية: متغير طبيعي = 0;
    طابق ابحث_نهاية_سطر_ويب(البايتات, 0) مع
    | اختياري.لا_شيء -> {
        إذا (العدد > (*الحدود).أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), (*الحدود).أقصى_سطر_بداية)); };
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
    }
    | اختياري.موجود(م) -> { نهاية_سطر_البداية := م; };
    إذا (نهاية_سطر_البداية > (*الحدود).أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), نهاية_سطر_البداية)); };

    دع طريقة_فارغة: نص = «»;
    دع هدف_فارغ: نص = «»;
    دع إصدار_افتراضي: إصدار_ويب = إصدار_ويب.واحد_واحد();
    دع رؤوس_فارغة: متجه رأس_ويب = [];
    دع رؤوس_لاحقة_فارغة: متجه رأس_ويب = [];
    دع جسم_فارغ: متجه ط8 = [];
    دع الطلب: متغير طلب_ويب_مخزن = {
        الطريقة: طريقة_فارغة, الهدف: هدف_فارغ, الإصدار: إصدار_افتراضي, الرؤوس: رؤوس_فارغة, الرؤوس_اللاحقة: رؤوس_لاحقة_فارغة, الجسم: جسم_فارغ, العنوان_البعيد: «», السياق: سياق_طلب_ويب_فارغ()
    };
    طابق حلل_سطر_طلب_ويب(البايتات, نهاية_سطر_البداية) مع
    | نتيجة.نجح(قيمة) -> { الطلب := قيمة; }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };

    دع الموضع: متغير طبيعي = نهاية_سطر_البداية + 2;
    دع بداية_الرؤوس: طبيعي = الموضع;
    دع عدد_الرؤوس: متغير طبيعي = 0;
    دع انتهت_الرؤوس: متغير منطقي = خطأ;
    طالما (!انتهت_الرؤوس) {
        إذا ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
        دع التالي: طبيعي = الموضع + 1;
        إذا (((*البايتات)[الموضع] == 0x0D) && ((*البايتات)[التالي] == 0x0A)) {
            الموضع := الموضع + 2;
            انتهت_الرؤوس := صواب;
        } وإلا {
            إذا ((الموضع - بداية_الرؤوس) > (*الحدود).أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
            إذا (عدد_الرؤوس >= (*الحدود).أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
            دع نهاية_السطر: متغير طبيعي = 0;
            طابق ابحث_نهاية_سطر_ويب(البايتات, الموضع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختياري.موجود(م) -> { نهاية_السطر := م; };
            طابق حلل_رأس_ويب_سريع(البايتات, الموضع, نهاية_السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الرأس) -> {
                ألحق(الطلب.الرؤوس, الرأس);
            };
            عدد_الرؤوس := عدد_الرؤوس + 1;
            الموضع := نهاية_السطر + 2;
        };
    }
    إذا ((الموضع - بداية_الرؤوس) > (*الحدود).أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };

    دع يتطلب_مضيف: متغير منطقي = خطأ;
    طابق الطلب.الإصدار مع
    | إصدار_ويب.واحد_واحد -> { يتطلب_مضيف := صواب; }
    | _ -> { };
    إذا (يتطلب_مضيف) {
        دع اسم_المضيف: نص = «host»;
        دع المضيفون: متجه نص = قيم_رأس_ويب(&الطلب.الرؤوس, &اسم_المضيف);
        دع عدد_المضيفين: طبيعي = الطول(المضيفون) مثل طبيعي;
        إذا (عدد_المضيفين == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), الموضع)); };
        إذا (عدد_المضيفين > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), الموضع)); };
        إذا (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), الموضع)); };
    };

    دع طول_محتوى: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ترميز_نقل: متغير اختياري نص = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الطلب.الرؤوس) مثل طبيعي)) {
        إذا (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «content-length»)) {
            طابق طول_محتوى مع
            | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), الموضع)); }
            | اختياري.لا_شيء -> {
                طابق قيمة_طبيعية_عشرية_ويب(&الطلب.الرؤوس[ف].القيمة) مع
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع)); }
                | اختياري.موجود(قيمة) -> { طول_محتوى := اختياري.موجود(قيمة); };
            };
        };
        إذا (رأس_ويب_يسمى(&الطلب.الرؤوس[ف], «transfer-encoding»)) {
            طابق ترميز_نقل مع
            | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); }
            | اختياري.لا_شيء -> { ترميز_نقل := اختياري.موجود(انسخ_نص_ويب(&الطلب.الرؤوس[ف].القيمة)); };
        };
        ف := ف + 1;
    }
    طابق ترميز_نقل مع
    | اختياري.موجود(_) -> {
        طابق طول_محتوى مع | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), الموضع)); } | _ -> { };
    }
    | _ -> { };

    طابق ترميز_نقل مع
    | اختياري.لا_شيء -> {
        دع طول_الجسم: متغير طبيعي = 0;
        طابق طول_محتوى مع | اختياري.موجود(قيمة) -> { طول_الجسم := قيمة; } | _ -> { };
        إذا (طول_الجسم > (*الحدود).أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
        إذا ((العدد - الموضع) < طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        الطلب.الجسم := انسخ_بايتات_ويب(البايتات, الموضع, طول_الجسم);
        دع المستهلك: طبيعي = الموضع + طول_الجسم;
        دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: المستهلك };
        أرجع نتيجة.نجح(الناتج);
    }
    | اختياري.موجود(الترميز_الخام) -> {
        إذا (!ترميز_نقل_مجزأ_ويب1(&الترميز_الخام)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
        };
        طابق حلل_جسم_مجزأ_ويب1(
            البايتات,
            الموضع,
            (*الحدود).أقصى_بايتات_جسم,
            (*الحدود).أقصى_بايتات_سطر_قطعة,
            (*الحدود).أقصى_بايتات_رؤوس,
            (*الحدود).أقصى_عدد_رؤوس
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجزأ) -> {
            الطلب.الجسم := انسخ_بايتات_ويب(&المجزأ.الجسم, 0, الطول(المجزأ.الجسم) مثل طبيعي);
            الطلب.الرؤوس_اللاحقة := انسخ_رؤوس_ويب(&المجزأ.الرؤوس_اللاحقة);
            دع الناتج: طلب_ويب_محلل = { الطلب: الطلب, المستهلك: المجزأ.المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    };
    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
}

عام نوع مفكك_ويب1 = {
    المخزن: متجه ط8,
    الحدود: حدود_ويب
};

عام عرف مفكك_ويب1_جديد(الحدود: حدود_ويب): مفكك_ويب1 {
    دع المخزن: متجه ط8 = [];
    دع الناتج: مفكك_ويب1 = { المخزن: المخزن, الحدود: الحدود };
    أرجع الناتج;
}

عام عرف غذ_مفكك_ويب1(المفكك: &متغير مفكك_ويب1, البايتات: &متجه ط8): فراغ {
    ألحق_من((*المفكك).المخزن, البايتات, 0, الطول(*البايتات) مثل طبيعي);
}

// Drops the first المستهلك bytes of the buffer in place: nothing is
// allocated, and a buffer the request took whole is just emptied (keeping
// its capacity for the next request).
عرف أسقط_بداية_مفكك_ويب1(المفكك: &متغير مفكك_ويب1, المستهلك: طبيعي): فراغ {
    دع العدد: طبيعي = الطول((*المفكك).المخزن) مثل طبيعي;
    إذا (المستهلك >= العدد) { اقتطع((*المفكك).المخزن, 0); أرجع; };
    دع ف: متغير طبيعي = المستهلك;
    طالما (ف < العدد) {
        (*المفكك).المخزن[ف - المستهلك] := (*المفكك).المخزن[ف];
        ف := ف + 1;
    }
    اقتطع((*المفكك).المخزن, العدد - المستهلك);
}

عام عرف التالي_من_مفكك_ويب1(المفكك: &متغير مفكك_ويب1): نتيجة اختياري طلب_ويب_محلل, خطأ_ويب {
    طابق حلل_طلب_ويب1(&(*المفكك).المخزن, &(*المفكك).الحدود) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ.الصنف مع
        | صنف_خطأ_ويب.غير_مكتمل -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | _ -> { أرجع نتيجة.خطأ(الخطأ); };
    }
    | نتيجة.نجح(المحلل) -> {
        أسقط_بداية_مفكك_ويب1(المفكك, المحلل.المستهلك);
        أرجع نتيجة.نجح(اختياري.موجود(المحلل));
    };
}

// The next request as a zero-copy view of the decoder's buffer
// (http.http1.views), or none while it is incomplete. The view stays valid
// until أنه_طلب_معروض_من_مفكك_ويب1 consumes it; a chunked request is
// ترميز_نقل_غير_مدعوم here (use التالي_من_مفكك_ويب1).
عام عرف التالي_معروضا_من_مفكك_ويب1(المفكك: &مفكك_ويب1): نتيجة اختياري طلب_ويب1_معروض, خطأ_ويب {
    طابق حلل_طلب_ويب1_معروضا(&(*المفكك).المخزن, &(*المفكك).الحدود) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ.الصنف مع
        | صنف_خطأ_ويب.غير_مكتمل -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); }
        | _ -> { أرجع نتيجة.خطأ(الخطأ); };
    }
    | نتيجة.نجح(المعروض) -> { أرجع نتيجة.نجح(اختياري.موجود(المعروض)); };
}
عام مرادف http1_decoder_next_view = التالي_معروضا_من_مفكك_ويب1;

// The decoder's bytes a view's ranges index.
عام عرف مخزن_مفكك_ويب1(المفكك: &مفكك_ويب1): &متجه ط8 { أرجع &(*المفكك).المخزن; }
عام مرادف http1_decoder_buffer = مخزن_مفكك_ويب1;

عام عرف أنه_طلب_معروض_من_مفكك_ويب1(المفكك: &متغير مفكك_ويب1, الطلب: &طلب_ويب1_معروض): فراغ {
    أسقط_بداية_مفكك_ويب1(المفكك, (*الطلب).المستهلك);
}
عام مرادف http1_decoder_consume_view = أنه_طلب_معروض_من_مفكك_ويب1;

// The parsed request itself, moved out (no copy).
عام عرف خذ_طلب_محلل_ويب(المحلل: طلب_ويب_محلل): طلب_ويب_مخزن {
    أرجع المحلل.الطلب;
}
عام مرادف take_parsed_http_request = خذ_طلب_محلل_ويب;

عام عرف بايتات_معلقة_في_مفكك_ويب1(المفكك: &مفكك_ويب1): طبيعي {
    أرجع الطول((*المفكك).المخزن) مثل طبيعي;
}
عام عرف بايتات_طلب_مستهلكة(المحلل: &طلب_ويب_محلل): طبيعي { أرجع (*المحلل).المستهلك; }
عام عرف طلب_من_طلب_محلل(المحلل: &طلب_ويب_محلل): طلب_ويب_مخزن {
    دع الطريقة: نص = انسخ_نص_ويب(&(*المحلل).الطلب.الطريقة);
    دع الهدف: نص = انسخ_نص_ويب(&(*المحلل).الطلب.الهدف);
    دع الإصدار: إصدار_ويب = (*المحلل).الطلب.الإصدار;
    دع الرؤوس: متجه رأس_ويب = انسخ_رؤوس_ويب(&(*المحلل).الطلب.الرؤوس);
    دع الرؤوس_اللاحقة: متجه رأس_ويب = انسخ_رؤوس_ويب(&(*المحلل).الطلب.الرؤوس_اللاحقة);
    دع الجسم: متجه ط8 = انسخ_بايتات_ويب(&(*المحلل).الطلب.الجسم, 0, الطول((*المحلل).الطلب.الجسم) مثل طبيعي);
    دع العنوان: نص = انسخ_نص_ويب(&(*المحلل).الطلب.العنوان_البعيد);
    دع الطلب: طلب_ويب_مخزن = { الطريقة: الطريقة, الهدف: الهدف, الإصدار: الإصدار, الرؤوس: الرؤوس, الرؤوس_اللاحقة: الرؤوس_اللاحقة, الجسم: الجسم, العنوان_البعيد: العنوان, السياق: سياق_طلب_ويب_فارغ() };
    أرجع الطلب;
}
عام عرف صنف_خطأ_ويب_لقيمة(الخطأ: &خطأ_ويب): صنف_خطأ_ويب { أرجع (*الخطأ).الصنف; }
عام عرف إزاحة_خطأ_ويب(الخطأ: &خطأ_ويب): طبيعي { أرجع (*الخطأ).الإزاحة; }

// English public aliases.
عام مرادف parsed_http_request = طلب_ويب_محلل;
عام مرادف http1_decoder = مفكك_ويب1;
عام مرادف parse_http1_request = حلل_طلب_ويب1;
عام مرادف new_http1_decoder = مفكك_ويب1_جديد;
عام مرادف http1_decoder_feed = غذ_مفكك_ويب1;
عام مرادف http1_decoder_next = التالي_من_مفكك_ويب1;
عام مرادف http1_decoder_pending_bytes = بايتات_معلقة_في_مفكك_ويب1;
عام مرادف parsed_http_request_consumed = بايتات_طلب_مستهلكة;
عام مرادف parsed_http_request_value = طلب_من_طلب_محلل;
عام مرادف http_error_class = صنف_خطأ_ويب_لقيمة;
عام مرادف http_error_offset = إزاحة_خطأ_ويب;
