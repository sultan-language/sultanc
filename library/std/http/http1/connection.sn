استورد text.compare;
استورد http.model;
استورد http.headers;
استورد http.http1.common;
استورد time.time;
استورد time.date;
استورد text.from_bytes;

عام عرف يحتوي_رمز_اتصال_ويب1(الرؤوس: &متجه رأس_ويب, الرمز: &نص): منطقي {
    دع اسم_الاتصال: نص = «connection»;
    دع القيم: متجه نص = قيم_رأس_ويب(الرؤوس, &اسم_الاتصال);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        دع القيمة: نص = *(&القيم[ف]);
        دع البداية: متغير طبيعي = 0;
        دع م: متغير طبيعي = 0;
        طالما (م <= (الطول(القيمة) مثل طبيعي)) {
            دع نهاية: منطقي = م == (الطول(القيمة) مثل طبيعي);
            إذا (نهاية || (القيمة[م] == 0x2C)) {
                دع بايتات_القيمة: متجه ط8 = بايتات_ويب_من_نص(&القيمة);
                دع الخام: نص = نص_ويب_من_مدى(&بايتات_القيمة, البداية, م);
                دع الجزء: نص = قص_فراغ_رأس_ويب(&الخام);
                إذا (اسما_رأس_ويب_متساويان(&الجزء, الرمز)) { أرجع صواب; };
                البداية := م + 1;
            };
            م := م + 1;
        }
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام عرف طلب_ويب1_يبقي_الاتصال(الطلب: &طلب_ويب_مخزن): منطقي {
    دع close: نص = «close»;
    دع keep_alive: نص = «keep-alive»;
    إذا (يحتوي_رمز_اتصال_ويب1(&(*الطلب).الرؤوس, &close)) { أرجع خطأ; };
    طابق (*الطلب).الإصدار مع
    | إصدار_ويب.واحد_واحد -> { أرجع صواب; }
    | إصدار_ويب.واحد_صفر -> { أرجع يحتوي_رمز_اتصال_ويب1(&(*الطلب).الرؤوس, &keep_alive); }
    | _ -> { أرجع خطأ; };
}

عام عرف استجابة_ويب1_تبقي_الاتصال(الاستجابة: &استجابة_ويب_مخزنة): منطقي {
    دع close: نص = «close»;
    دع keep_alive: نص = «keep-alive»;
    إذا (يحتوي_رمز_اتصال_ويب1(&(*الاستجابة).الرؤوس, &close)) { أرجع خطأ; };
    طابق (*الاستجابة).الإصدار مع
    | إصدار_ويب.واحد_واحد -> { أرجع صواب; }
    | إصدار_ويب.واحد_صفر -> { أرجع يحتوي_رمز_اتصال_ويب1(&(*الاستجابة).الرؤوس, &keep_alive); }
    | _ -> { أرجع خطأ; };
}

عام عرف استجابة_ويب1_قابلة_لإعادة_الاستخدام(
    الطلب: &طلب_ويب_مخزن,
    الاستجابة: &استجابة_ويب_مخزنة,
    محددة_بالإغلاق: منطقي,
    نفق: منطقي
): منطقي {
    إذا (محددة_بالإغلاق || نفق || ((*الاستجابة).الحالة == 101)) { أرجع خطأ; };
    أرجع طلب_ويب1_يبقي_الاتصال(الطلب) && استجابة_ويب1_تبقي_الاتصال(الاستجابة);
}

// The Date header an origin server with a clock sends (RFC 9110 §6.6.1;
// Nahr item 18), as Go's net/http and hyper add it on the server side only:
// the current time as an IMF-fixdate, unless the service already set one.
// 1xx responses carry none. Without a working clock nothing is added.
//
// The text changes once a second, so it is formatted at most once a second
// and kept for every thread (Nahr item 4; hyper keeps a cached date too). The
// cache is a seqlock (Linux seqcount): an odd sequence means a write is in
// progress; a reader that sees the sequence change formats the date itself.
مرادف احمل_ذري_تاريخ_ويب = بدائي_ذري_حمل;
مرادف خزن_ذري_تاريخ_ويب = بدائي_ذري_خزن;
مرادف قارن_وبدل_ذري_تاريخ_ويب = بدائي_ذري_قارن_وبدل;

دع تسلسل_تاريخ_الويب: متغير ط64 = 0;
دع ثانية_تاريخ_الويب: متغير ط64 = 0;
دع كلمة0_تاريخ_الويب: متغير ط64 = 0;
دع كلمة1_تاريخ_الويب: متغير ط64 = 0;
دع كلمة2_تاريخ_الويب: متغير ط64 = 0;
دع كلمة3_تاريخ_الويب: متغير ط64 = 0;

// The IMF-fixdate is 29 ASCII bytes: four little-endian words.
عرف كلمة_من_تاريخ_ويب(البايتات: &متجه ط8, البداية: طبيعي): ط64 {
    دع الكلمة: متغير ط64 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        دع الموضع: طبيعي = البداية + ف;
        إذا (الموضع < (الطول(*البايتات) مثل طبيعي)) {
            الكلمة := الكلمة | (((*البايتات)[الموضع] مثل ط64) << ((ف * 8) مثل ط64));
        };
        ف := ف + 1;
    }
    أرجع الكلمة;
}

عرف ألحق_كلمة_تاريخ_ويب(البايتات: &متغير متجه ط8, الكلمة: ط64, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(*البايتات, ((الكلمة >> ((ف * 8) مثل ط64)) & 0xFF) مثل ط8);
        ف := ف + 1;
    }
}

عرف تاريخ_ويب_مخزن(الثانية: ط64): اختياري نص {
    دع الأول: ط64 = احمل_ذري_تاريخ_ويب(&متغير تسلسل_تاريخ_الويب, 4);
    إذا ((الأول & 1) != 0 || الأول == 0) { أرجع اختياري.لا_شيء(); };
    إذا (احمل_ذري_تاريخ_ويب(&متغير ثانية_تاريخ_الويب, 4) != الثانية) { أرجع اختياري.لا_شيء(); };
    دع ك0: ط64 = احمل_ذري_تاريخ_ويب(&متغير كلمة0_تاريخ_الويب, 4);
    دع ك1: ط64 = احمل_ذري_تاريخ_ويب(&متغير كلمة1_تاريخ_الويب, 4);
    دع ك2: ط64 = احمل_ذري_تاريخ_ويب(&متغير كلمة2_تاريخ_الويب, 4);
    دع ك3: ط64 = احمل_ذري_تاريخ_ويب(&متغير كلمة3_تاريخ_الويب, 4);
    إذا (احمل_ذري_تاريخ_ويب(&متغير تسلسل_تاريخ_الويب, 4) != الأول) { أرجع اختياري.لا_شيء(); };
    دع البايتات: متغير متجه ط8 = [];
    ألحق_كلمة_تاريخ_ويب(&متغير البايتات, ك0, 8);
    ألحق_كلمة_تاريخ_ويب(&متغير البايتات, ك1, 8);
    ألحق_كلمة_تاريخ_ويب(&متغير البايتات, ك2, 8);
    ألحق_كلمة_تاريخ_ويب(&متغير البايتات, ك3, 5);
    أرجع اختياري.موجود(من_بايتات(&البايتات));
}

// Stores a freshly formatted date unless another thread is storing one.
عرف خزن_تاريخ_ويب(الثانية: ط64, النص: &نص): فراغ {
    إذا ((الطول(*النص) مثل طبيعي) != 29) { أرجع; };
    دع الحالي: ط64 = احمل_ذري_تاريخ_ويب(&متغير تسلسل_تاريخ_الويب, 4);
    إذا ((الحالي & 1) != 0) { أرجع; };
    إذا (قارن_وبدل_ذري_تاريخ_ويب(&متغير تسلسل_تاريخ_الويب, الحالي, الحالي + 1, 4, 4) != الحالي) { أرجع; };
    دع البايتات: متجه ط8 = بايتات_من_نص(انسخ_نص(النص));
    خزن_ذري_تاريخ_ويب(&متغير ثانية_تاريخ_الويب, الثانية, 4);
    خزن_ذري_تاريخ_ويب(&متغير كلمة0_تاريخ_الويب, كلمة_من_تاريخ_ويب(&البايتات, 0), 4);
    خزن_ذري_تاريخ_ويب(&متغير كلمة1_تاريخ_الويب, كلمة_من_تاريخ_ويب(&البايتات, 8), 4);
    خزن_ذري_تاريخ_ويب(&متغير كلمة2_تاريخ_الويب, كلمة_من_تاريخ_ويب(&البايتات, 16), 4);
    خزن_ذري_تاريخ_ويب(&متغير كلمة3_تاريخ_الويب, كلمة_من_تاريخ_ويب(&البايتات, 24), 4);
    خزن_ذري_تاريخ_ويب(&متغير تسلسل_تاريخ_الويب, الحالي + 2, 4);
}

// The current IMF-fixdate, from the cache when it holds this second.
عام عرف تاريخ_ويب_حالي(): اختياري نص {
    طابق وقت_نظام_نانو() مع
    | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); }
    | نتيجة.نجح(النانو) -> {
        دع الثانية: ط64 = (النانو / 1000000000) مثل ط64;
        طابق تاريخ_ويب_مخزن(الثانية) مع
        | اختياري.موجود(النص) -> { أرجع اختياري.موجود(النص); }
        | اختياري.لا_شيء -> { };
        طابق تاريخ_من_ثواني_يونكس(النانو / 1000000000, 0) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(التاريخ) -> {
            طابق نسق_تاريخ_ويب(&التاريخ) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(النص) -> {
                خزن_تاريخ_ويب(الثانية, &النص);
                أرجع اختياري.موجود(النص);
            };
        };
    };
}
عام مرادف current_http_date = تاريخ_ويب_حالي;

عام عرف أضف_تاريخ_استجابة_خادم_ويب(الاستجابة: &متغير استجابة_ويب_مخزنة): فراغ {
    إذا ((*الاستجابة).الحالة < 200) { أرجع; };
    دع اسم_التاريخ: نص = «date»;
    إذا (يحتوي_رأس_ويب(&(*الاستجابة).الرؤوس, &اسم_التاريخ)) { أرجع; };
    طابق تاريخ_ويب_حالي() مع
    | اختياري.لا_شيء -> { أرجع; }
    | اختياري.موجود(النص) -> {
        // A valid name and IMF-fixdate: appended without re-validating.
        دع الرأس: رأس_ويب = { الاسم: اسم_التاريخ, القيمة: النص };
        ألحق((*الاستجابة).الرؤوس, الرأس);
    };
}
عام مرادف add_server_date_header = أضف_تاريخ_استجابة_خادم_ويب;

عام عرف طبق_سياسة_اتصال_خادم_ويب1(
    الطلب: &طلب_ويب_مخزن,
    الاستجابة: &متغير استجابة_ويب_مخزنة
): منطقي {
    أضف_تاريخ_استجابة_خادم_ويب(الاستجابة);
    دع close: نص = «close»;
    دع keep_alive: نص = «keep-alive»;
    دع اسم_الاتصال: نص = «connection»;
    دع يبقى: متغير منطقي = طلب_ويب1_يبقي_الاتصال(الطلب);
    إذا (يحتوي_رمز_اتصال_ويب1(&(*الاستجابة).الرؤوس, &close)) { يبقى := خطأ; };
    إذا (((*الاستجابة).الحالة == 101)) { يبقى := خطأ; };
    دع connect: نص = «CONNECT»;
    إذا (نصان_متساويان(&(*الطلب).الطريقة, &connect) && ((*الاستجابة).الحالة >= 200) && ((*الاستجابة).الحالة < 300)) {
        // std.http.server does not own tunnel traffic. The caller may use the
        // codec directly for CONNECT, but the generic server loop must stop.
        يبقى := خطأ;
    };
    إذا (!يبقى) {
        دع تجاهل: منطقي = ضع_رأس_ويب(&متغير (*الاستجابة).الرؤوس, &اسم_الاتصال, &close);
        أرجع خطأ;
    };
    طابق (*الطلب).الإصدار مع
    | إصدار_ويب.واحد_صفر -> {
        دع تجاهل: منطقي = ضع_رأس_ويب(&متغير (*الاستجابة).الرؤوس, &اسم_الاتصال, &keep_alive);
    }
    | _ -> { };
    أرجع صواب;
}

// English public aliases.
عام مرادف http1_request_keeps_connection = طلب_ويب1_يبقي_الاتصال;
عام مرادف http1_response_keeps_connection = استجابة_ويب1_تبقي_الاتصال;
عام مرادف http1_connection_reusable = استجابة_ويب1_قابلة_لإعادة_الاستخدام;
