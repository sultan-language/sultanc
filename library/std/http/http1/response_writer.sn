استورد text.number;
استورد text.compare;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;

عرف عبارة_حالة_ويب(الحالة: طبيعي): نص {
    إذا (الحالة == 100) { أرجع «Continue»; };
    إذا (الحالة == 101) { أرجع «Switching Protocols»; };
    إذا (الحالة == 200) { أرجع «OK»; };
    إذا (الحالة == 201) { أرجع «Created»; };
    إذا (الحالة == 202) { أرجع «Accepted»; };
    إذا (الحالة == 204) { أرجع «No Content»; };
    إذا (الحالة == 205) { أرجع «Reset Content»; };
    إذا (الحالة == 206) { أرجع «Partial Content»; };
    إذا (الحالة == 301) { أرجع «Moved Permanently»; };
    إذا (الحالة == 302) { أرجع «Found»; };
    إذا (الحالة == 303) { أرجع «See Other»; };
    إذا (الحالة == 304) { أرجع «Not Modified»; };
    إذا (الحالة == 307) { أرجع «Temporary Redirect»; };
    إذا (الحالة == 308) { أرجع «Permanent Redirect»; };
    إذا (الحالة == 400) { أرجع «Bad Request»; };
    إذا (الحالة == 401) { أرجع «Unauthorized»; };
    إذا (الحالة == 403) { أرجع «Forbidden»; };
    إذا (الحالة == 404) { أرجع «Not Found»; };
    إذا (الحالة == 405) { أرجع «Method Not Allowed»; };
    إذا (الحالة == 408) { أرجع «Request Timeout»; };
    إذا (الحالة == 409) { أرجع «Conflict»; };
    إذا (الحالة == 413) { أرجع «Content Too Large»; };
    إذا (الحالة == 415) { أرجع «Unsupported Media Type»; };
    إذا (الحالة == 422) { أرجع «Unprocessable Content»; };
    إذا (الحالة == 429) { أرجع «Too Many Requests»; };
    إذا (الحالة == 431) { أرجع «Request Header Fields Too Large»; };
    إذا (الحالة == 500) { أرجع «Internal Server Error»; };
    إذا (الحالة == 501) { أرجع «Not Implemented»; };
    إذا (الحالة == 502) { أرجع «Bad Gateway»; };
    إذا (الحالة == 503) { أرجع «Service Unavailable»; };
    إذا (الحالة == 505) { أرجع «HTTP Version Not Supported»; };
    أرجع «»;
}

عام عرف حالة_تمنع_المحتوى(الحالة: طبيعي): منطقي {
    أرجع ((الحالة >= 100) && (الحالة < 200)) || (الحالة == 204) || (الحالة == 205) || (الحالة == 304);
}

عرف حالة_تمنع_طول_المحتوى(الحالة: طبيعي): منطقي {
    أرجع ((الحالة >= 100) && (الحالة < 200)) || (الحالة == 204);
}

// Appends the serialized response to الناتج (Nahr item 4: a connection
// reuses one output buffer); answers the number of bytes appended. The
// response's own headers are written from the response itself; only the
// framing header std adds (content-length or transfer-encoding) is new.
عرف سلسل_استجابة_ويب1_إلى_داخليا(
    الاستجابة: &استجابة_ويب_مخزنة,
    احذف_الجسم_المنقول: منطقي,
    امنع_طول_المحتوى_إضافيا: منطقي,
    الناتج: &متغير متجه ط8
): نتيجة طبيعي, خطأ_ويب {
    إذا (((*الاستجابة).الحالة < 100) || ((*الاستجابة).الحالة > 999)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 0)); };
    دع نص_الإصدار: متغير نص = «»;
    طابق نص_إصدار_ويب1((*الاستجابة).الإصدار) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.إصدار_غير_مدعوم(), 0)); }
    | اختياري.موجود(النص) -> { نص_الإصدار := النص; };

    دع الإضافية: متغير متجه رأس_ويب = [];
    دع اسم_الطول: نص = «content-length»;
    دع اسم_الترميز: نص = «transfer-encoding»;
    دع قيم_الطول: متجه نص = قيم_رأس_ويب(&(*الاستجابة).الرؤوس, &اسم_الطول);
    دع قيم_الترميز: متجه نص = قيم_رأس_ويب(&(*الاستجابة).الرؤوس, &اسم_الترميز);
    إذا ((الطول(قيم_الطول) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), 0)); };
    إذا ((الطول(قيم_الترميز) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
    إذا (((الطول(قيم_الطول) مثل طبيعي) > 0) && ((الطول(قيم_الترميز) مثل طبيعي) > 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), 0));
    };

    دع طول_الجسم: طبيعي = الطول((*الاستجابة).الجسم) مثل طبيعي;
    إذا (حالة_تمنع_المحتوى((*الاستجابة).الحالة) && (طول_الجسم > 0)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), 0)); };
    إذا (امنع_طول_المحتوى_إضافيا && (طول_الجسم > 0)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), 0)); };
    إذا ((احذف_الجسم_المنقول || حالة_تمنع_المحتوى((*الاستجابة).الحالة)) && ((الطول((*الاستجابة).الرؤوس_اللاحقة) مثل طبيعي) > 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0));
    };

    دع استخدم_مجزأ: متغير منطقي = خطأ;
    إذا ((الطول(قيم_الترميز) مثل طبيعي) == 1) {
        إذا (امنع_طول_المحتوى_إضافيا || حالة_تمنع_طول_المحتوى((*الاستجابة).الحالة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0));
        };
        طابق (*الاستجابة).الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        إذا (!ترميز_نقل_مجزأ_ويب1(&قيم_الترميز[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        استخدم_مجزأ := صواب;
    };
    إذا ((الطول((*الاستجابة).الرؤوس_اللاحقة) مثل طبيعي) > 0) {
        طابق (*الاستجابة).الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
        إذا (!استخدم_مجزأ) {
            دع chunked: نص = «chunked»;
            إذا (!أضف_رأس_ويب(&متغير الإضافية, &اسم_الترميز, &chunked)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
            استخدم_مجزأ := صواب;
        };
    };

    إذا (!استخدم_مجزأ) {
        إذا (حالة_تمنع_طول_المحتوى((*الاستجابة).الحالة) || امنع_طول_المحتوى_إضافيا) {
            إذا ((الطول(قيم_الطول) مثل طبيعي) != 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
        } وإلا إذا ((*الاستجابة).الحالة == 304) {
            إذا ((الطول(قيم_الطول) مثل طبيعي) == 1) {
                طابق قيمة_طبيعية_عشرية_ويب(&قيم_الطول[0]) مع
                | اختياري.موجود(_) -> { }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
            };
        } وإلا {
            دع الطول_المتوقع: متغير طبيعي = طول_الجسم;
            إذا ((*الاستجابة).الحالة == 205) { الطول_المتوقع := 0; };
            إذا ((الطول(قيم_الطول) مثل طبيعي) == 1) {
                طابق قيمة_طبيعية_عشرية_ويب(&قيم_الطول[0]) مع
                | اختياري.موجود(معلن) -> { إذا (معلن != الطول_المتوقع) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }; }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); };
            } وإلا {
                دع نص_الطول: نص = طبيعي_إلى_نص(الطول_المتوقع);
                إذا (!أضف_رأس_ويب(&متغير الإضافية, &اسم_الطول, &نص_الطول)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
            };
        };
    };

    دع البداية: طبيعي = الطول(*الناتج) مثل طبيعي;
    ألحق_نص_ويب(الناتج, &نص_الإصدار); ألحق(*الناتج, 0x20);
    دع رقم_الحالة: نص = طبيعي_إلى_نص((*الاستجابة).الحالة);
    ألحق_نص_ويب(الناتج, &رقم_الحالة); ألحق(*الناتج, 0x20);
    دع العبارة: نص = عبارة_حالة_ويب((*الاستجابة).الحالة);
    ألحق_نص_ويب(الناتج, &العبارة); ألحق(*الناتج, 0x0D); ألحق(*الناتج, 0x0A);
    إذا (!ألحق_رؤوس_ويب1(الناتج, &(*الاستجابة).الرؤوس) || !ألحق_رؤوس_ويب1(الناتج, &الإضافية)) {
        اقتطع(*الناتج, البداية);
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0));
    };
    ألحق(*الناتج, 0x0D); ألحق(*الناتج, 0x0A);
    دع اكتب_جسم_مجزأ_فارغ_205: منطقي = ((*الاستجابة).الحالة == 205) && استخدم_مجزأ;
    إذا ((!حالة_تمنع_المحتوى((*الاستجابة).الحالة) || اكتب_جسم_مجزأ_فارغ_205) && !احذف_الجسم_المنقول) {
        إذا (استخدم_مجزأ) {
            طابق سلسل_جسم_مجزأ_ويب1(&(*الاستجابة).الجسم, &(*الاستجابة).الرؤوس_اللاحقة) مع
            | نتيجة.خطأ(الخطأ) -> { اقتطع(*الناتج, البداية); أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجزأ) -> { ألحق_بايتات_ويب(الناتج, &المجزأ, 0, الطول(المجزأ) مثل طبيعي); };
        } وإلا { ألحق_بايتات_ويب(الناتج, &(*الاستجابة).الجسم, 0, طول_الجسم); };
    };
    أرجع نتيجة.نجح((الطول(*الناتج) مثل طبيعي) - البداية);
}

// Writes each header line; false when a name or value is not valid.
عرف ألحق_رؤوس_ويب1(الناتج: &متغير متجه ط8, الرؤوس: &متجه رأس_ويب): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرؤوس) مثل طبيعي)) {
        إذا (!اسم_رأس_ويب_صالح(&(*الرؤوس)[ف].الاسم) || !قيمة_رأس_ويب_صالحة(&(*الرؤوس)[ف].القيمة)) { أرجع خطأ; };
        ألحق_نص_ويب(الناتج, &(*الرؤوس)[ف].الاسم); ألحق(*الناتج, 0x3A); ألحق(*الناتج, 0x20);
        ألحق_نص_ويب(الناتج, &(*الرؤوس)[ف].القيمة); ألحق(*الناتج, 0x0D); ألحق(*الناتج, 0x0A);
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف سلسل_استجابة_ويب1_داخليا(
    الاستجابة: &استجابة_ويب_مخزنة,
    احذف_الجسم_المنقول: منطقي,
    امنع_طول_المحتوى_إضافيا: منطقي
): نتيجة متجه ط8, خطأ_ويب {
    دع الناتج: متغير متجه ط8 = [];
    طابق سلسل_استجابة_ويب1_إلى_داخليا(الاستجابة, احذف_الجسم_المنقول, امنع_طول_المحتوى_إضافيا, &متغير الناتج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج); };
}

عام عرف سلسل_استجابة_ويب1(الاستجابة: &استجابة_ويب_مخزنة): نتيجة متجه ط8, خطأ_ويب {
    أرجع سلسل_استجابة_ويب1_داخليا(الاستجابة, خطأ, خطأ);
}

عام عرف سلسل_استجابة_ويب1_لطلب(الطلب: &طلب_ويب_مخزن, الاستجابة: &استجابة_ويب_مخزنة): نتيجة متجه ط8, خطأ_ويب {
    // Read through the references: neither message is copied.
    دع رأس: نص = «HEAD»;
    دع اتصال: نص = «CONNECT»;
    دع طلب_رأس: منطقي = نصان_متساويان(&(*الطلب).الطريقة, &رأس);
    دع اتصال_ناجح: منطقي = نصان_متساويان(&(*الطلب).الطريقة, &اتصال) && ((*الاستجابة).الحالة >= 200) && ((*الاستجابة).الحالة < 300);
    أرجع سلسل_استجابة_ويب1_داخليا(الاستجابة, طلب_رأس || اتصال_ناجح, اتصال_ناجح);
}

// As سلسل_استجابة_ويب1_لطلب, appending to a buffer the caller reuses.
عام عرف سلسل_استجابة_ويب1_لطلب_إلى(الطلب: &طلب_ويب_مخزن, الاستجابة: &استجابة_ويب_مخزنة, الناتج: &متغير متجه ط8): نتيجة طبيعي, خطأ_ويب {
    دع رأس: نص = «HEAD»;
    دع اتصال: نص = «CONNECT»;
    دع طلب_رأس: منطقي = نصان_متساويان(&(*الطلب).الطريقة, &رأس);
    دع اتصال_ناجح: منطقي = نصان_متساويان(&(*الطلب).الطريقة, &اتصال) && ((*الاستجابة).الحالة >= 200) && ((*الاستجابة).الحالة < 300);
    أرجع سلسل_استجابة_ويب1_إلى_داخليا(الاستجابة, طلب_رأس || اتصال_ناجح, اتصال_ناجح, الناتج);
}
عام مرادف serialize_http1_response_for_request_into = سلسل_استجابة_ويب1_لطلب_إلى;

// Only the head (status line and headers) of the response to a request: for
// a connection handed over after it (http.handover), whose body or new
// protocol the program then writes itself.
عام عرف سلسل_رأس_استجابة_ويب1_إلى(الطلب: &طلب_ويب_مخزن, الاستجابة: &استجابة_ويب_مخزنة, الناتج: &متغير متجه ط8): نتيجة طبيعي, خطأ_ويب {
    دع اتصال: نص = «CONNECT»;
    دع اتصال_ناجح: منطقي = نصان_متساويان(&(*الطلب).الطريقة, &اتصال) && ((*الاستجابة).الحالة >= 200) && ((*الاستجابة).الحالة < 300);
    أرجع سلسل_استجابة_ويب1_إلى_داخليا(الاستجابة, صواب, اتصال_ناجح, الناتج);
}
عام مرادف serialize_http1_response_head_into = سلسل_رأس_استجابة_ويب1_إلى;

// English public aliases.
عام مرادف serialize_http1_response = سلسل_استجابة_ويب1;
عام مرادف serialize_http1_response_for_request = سلسل_استجابة_ويب1_لطلب;
