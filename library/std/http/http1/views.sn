// Zero-copy HTTP/1 request views (Nahr items 3 and 9), as httparse and
// picohttpparser: the method, target, header names and values and the body
// are byte ranges (عرض_بايتات) of the read buffer, compared in place (header
// names case-insensitively) and copied only when a caller asks for text.
// A view is valid while the buffer it was parsed from is unchanged; the
// decoder consumes the request only when the caller says so
// (أنه_طلب_معروض_من_مفكك_ويب1).
//
// Also the range helpers the buffered parser (request_parser.sn) uses: block
// copies (ألحق_من) and static texts for common methods and header names,
// which cost no allocation.
استورد chars.ascii;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;

عام عرف مدى_رمز_ويب_صالح(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): منطقي {
    إذا (النهاية <= البداية) { أرجع خطأ; };
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا (!حرف_رمز_ويب((*البايتات)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف مدى_قيمة_رأس_ويب_صالح(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): منطقي {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*البايتات)[ف];
        إذا ((ب < 0x20) && (ب != 0x09)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The canonical (lowercase) header name: a static text for common names (no
// allocation), else one lowercased copy.
عام عرف اسم_رأس_من_مدى_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نص {
    دع الطول: طبيعي = النهاية - البداية;
    إذا (الطول == 4) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «host»)) { أرجع «host»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «date»)) { أرجع «date»; };
    } وإلا إذا (الطول == 6) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «accept»)) { أرجع «accept»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «cookie»)) { أرجع «cookie»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «origin»)) { أرجع «origin»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «pragma»)) { أرجع «pragma»; };
    } وإلا إذا (الطول == 7) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «referer»)) { أرجع «referer»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «upgrade»)) { أرجع «upgrade»; };
    } وإلا إذا (الطول == 10) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «user-agent»)) { أرجع «user-agent»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «connection»)) { أرجع «connection»; };
    } وإلا إذا (الطول == 12) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «content-type»)) { أرجع «content-type»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «x-request-id»)) { أرجع «x-request-id»; };
    } وإلا إذا (الطول == 13) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «authorization»)) { أرجع «authorization»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «cache-control»)) { أرجع «cache-control»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «if-none-match»)) { أرجع «if-none-match»; };
    } وإلا إذا (الطول == 14) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «content-length»)) { أرجع «content-length»; };
    } وإلا إذا (الطول == 15) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «accept-encoding»)) { أرجع «accept-encoding»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «accept-language»)) { أرجع «accept-language»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «x-forwarded-for»)) { أرجع «x-forwarded-for»; };
    } وإلا إذا (الطول == 17) {
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «transfer-encoding»)) { أرجع «transfer-encoding»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «if-modified-since»)) { أرجع «if-modified-since»; };
        إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, البداية, النهاية, «sec-websocket-key»)) { أرجع «sec-websocket-key»; };
    };
    دع الناتج: متغير متجه ط8 = [];
    ألحق_من(الناتج, البايتات, البداية, الطول);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول) { الناتج[ف] := إلى_صغير_أسكي(الناتج[ف]); ف := ف + 1; }
    أرجع الناتج مثل نص;
}

// The value range of a header line [البداية, النهاية) after its colon, with
// optional whitespace trimmed (RFC 9110 §5.5).
عام عرف مدى_قيمة_مقصوص_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): عرض_بايتات {
    دع ب: متغير طبيعي = البداية;
    دع ن: متغير طبيعي = النهاية;
    طالما (ب < ن && ((*البايتات)[ب] == 0x20 || (*البايتات)[ب] == 0x09)) { ب := ب + 1; }
    طالما (ن > ب && ((*البايتات)[ن - 1] == 0x20 || (*البايتات)[ن - 1] == 0x09)) { ن := ن - 1; }
    أرجع عرض_بايتات_من(ب, ن);
}

// A header line [البداية, النهاية): its name range and trimmed value range,
// validated in place; the colon's offset on failure.
عام نوع رأس_معروض_ويب = { الاسم: عرض_بايتات, القيمة: عرض_بايتات };
عام مرادف http_header_view = رأس_معروض_ويب;

عام عرف حلل_رأس_معروض_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نتيجة رأس_معروض_ويب, خطأ_ويب {
    إذا (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    إذا (((*البايتات)[البداية] == 0x20) || ((*البايتات)[البداية] == 0x09)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طي_رأس_قديم(), البداية));
    };
    دع م: متغير طبيعي = البداية;
    طالما (م < النهاية && (*البايتات)[م] != 0x3A) { م := م + 1; }
    إذا (م >= النهاية || !مدى_رمز_ويب_صالح(البايتات, البداية, م)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية));
    };
    دع القيمة: عرض_بايتات = مدى_قيمة_مقصوص_ويب(البايتات, م + 1, النهاية);
    إذا (!مدى_قيمة_رأس_ويب_صالح(البايتات, القيمة.البداية, القيمة.البداية + القيمة.الطول)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), م + 1));
    };
    دع الرأس: رأس_معروض_ويب = { الاسم: عرض_بايتات_من(البداية, م), القيمة: القيمة };
    أرجع نتيجة.نجح(الرأس);
}

// A header line as an owned header: the interned name and one value copy.
عام عرف حلل_رأس_ويب_سريع(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نتيجة رأس_ويب, خطأ_ويب {
    طابق حلل_رأس_معروض_ويب(البايتات, البداية, النهاية) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المعروض) -> {
        دع الرأس: رأس_ويب = {
            الاسم: اسم_رأس_من_مدى_ويب(البايتات, المعروض.الاسم.البداية, المعروض.الاسم.البداية + المعروض.الاسم.الطول),
            القيمة: نص_عرض_ويب(البايتات, المعروض.القيمة)
        };
        أرجع نتيجة.نجح(الرأس);
    };
}

// ---- Zero-copy request views ----

عام نوع طلب_ويب1_معروض = {
    الطريقة: عرض_بايتات,
    الهدف: عرض_بايتات,
    الإصدار: إصدار_ويب,
    الرؤوس: متجه رأس_معروض_ويب,
    الجسم: عرض_بايتات,
    // Bytes of the buffer the request takes (head and body).
    المستهلك: طبيعي
};
عام مرادف http1_request_view = طلب_ويب1_معروض;

// Parses a request at the start of البايتات without copying any of it. A
// chunked body has no single range: it is reported as unsupported
// (ترميز_نقل_غير_مدعوم), and the caller takes the buffered parser instead.
// An incomplete request is غير_مكتمل, as for the buffered parser.
عام عرف حلل_طلب_ويب1_معروضا(البايتات: &متجه ط8, الحدود: &حدود_ويب): نتيجة طلب_ويب1_معروض, خطأ_ويب {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع نهاية_البداية: متغير طبيعي = 0;
    طابق ابحث_نهاية_سطر_ويب(البايتات, 0) مع
    | اختياري.لا_شيء -> {
        إذا (العدد > (*الحدود).أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), (*الحدود).أقصى_سطر_بداية)); };
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
    }
    | اختياري.موجود(م) -> { نهاية_البداية := م; };
    إذا (نهاية_البداية > (*الحدود).أقصى_سطر_بداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), نهاية_البداية)); };
    // Request line: METHOD SP TARGET SP VERSION.
    دع م1: متغير طبيعي = 0;
    طالما (م1 < نهاية_البداية && (*البايتات)[م1] != 0x20) { م1 := م1 + 1; }
    دع م2: متغير طبيعي = م1 + 1;
    طالما (م2 < نهاية_البداية && (*البايتات)[م2] != 0x20) { م2 := م2 + 1; }
    إذا (م1 == 0 || م1 >= نهاية_البداية || !مدى_رمز_ويب_صالح(البايتات, 0, م1)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0));
    };
    إذا (م2 <= م1 + 1 || م2 + 1 >= نهاية_البداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), م1 + 1)); };
    دع ف: متغير طبيعي = م1 + 1;
    طالما (ف < م2) {
        دع ب: ط8 = (*البايتات)[ف];
        إذا (ب <= 0x20 || ب >= 0x7F || ب == 0x23) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), ف)); };
        ف := ف + 1;
    }
    دع الإصدار: متغير إصدار_ويب = إصدار_ويب.واحد_واحد();
    إذا (مدى_يساوي_ويب(البايتات, م2 + 1, نهاية_البداية, «HTTP/1.1»)) { }
    وإلا إذا (مدى_يساوي_ويب(البايتات, م2 + 1, نهاية_البداية, «HTTP/1.0»)) { الإصدار := إصدار_ويب.واحد_صفر(); }
    وإلا { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.إصدار_غير_مدعوم(), م2 + 1)); };
    // Headers.
    دع الرؤوس: متغير متجه رأس_معروض_ويب = [];
    دع الموضع: متغير طبيعي = نهاية_البداية + 2;
    دع بداية_الرؤوس: طبيعي = الموضع;
    دع طول_المحتوى: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع عدد_المضيفين: متغير طبيعي = 0;
    دع المضيف: متغير عرض_بايتات = عرض_بايتات_من(0, 0);
    دع انتهت: متغير منطقي = خطأ;
    طالما (!انتهت) {
        إذا (الموضع + 1 >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
        إذا ((*البايتات)[الموضع] == 0x0D && (*البايتات)[الموضع + 1] == 0x0A) {
            الموضع := الموضع + 2;
            انتهت := صواب;
        } وإلا {
            إذا (الموضع - بداية_الرؤوس > (*الحدود).أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
            إذا ((الطول(الرؤوس) مثل طبيعي) >= (*الحدود).أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
            دع نهاية_السطر: متغير طبيعي = 0;
            طابق ابحث_نهاية_سطر_ويب(البايتات, الموضع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختياري.موجود(م) -> { نهاية_السطر := م; };
            طابق حلل_رأس_معروض_ويب(البايتات, الموضع, نهاية_السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الرأس) -> {
                دع ب: طبيعي = الرأس.الاسم.البداية;
                دع ن: طبيعي = ب + الرأس.الاسم.الطول;
                إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, ب, ن, «host»)) {
                    عدد_المضيفين := عدد_المضيفين + 1;
                    المضيف := الرأس.القيمة;
                };
                إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, ب, ن, «transfer-encoding»)) {
                    أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع));
                };
                إذا (مدى_يساوي_بلا_حالة_ويب(البايتات, ب, ن, «content-length»)) {
                    طابق طول_المحتوى مع
                    | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), الموضع)); }
                    | اختياري.لا_شيء -> { };
                    دع القيمة: متغير طبيعي = 0;
                    دع ك: متغير طبيعي = 0;
                    إذا (الرأس.القيمة.الطول == 0 || الرأس.القيمة.الطول > 19) {
                        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع));
                    };
                    طالما (ك < الرأس.القيمة.الطول) {
                        دع الرقم: ط8 = (*البايتات)[الرأس.القيمة.البداية + ك];
                        إذا (الرقم < 0x30 || الرقم > 0x39) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع)); };
                        القيمة := القيمة * 10 + ((الرقم - 0x30) مثل طبيعي);
                        ك := ك + 1;
                    }
                    طول_المحتوى := اختياري.موجود(القيمة);
                };
                ألحق(الرؤوس, الرأس);
            };
            الموضع := نهاية_السطر + 2;
        };
    }
    طابق الإصدار مع
    | إصدار_ويب.واحد_واحد -> {
        إذا (عدد_المضيفين == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), الموضع)); };
        إذا (عدد_المضيفين > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), الموضع)); };
        // Host is routing authority (as the buffered parser checks it).
        دع نص_المضيف: نص = نص_عرض_ويب(البايتات, المضيف);
        إذا (!قيمة_مضيف_ويب_صالحة(&نص_المضيف)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), الموضع)); };
    }
    | _ -> { };
    دع طول_الجسم: متغير طبيعي = 0;
    طابق طول_المحتوى مع | اختياري.موجود(ق) -> { طول_الجسم := ق; } | اختياري.لا_شيء -> { };
    إذا (طول_الجسم > (*الحدود).أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
    إذا (العدد - الموضع < طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
    دع الطلب: طلب_ويب1_معروض = {
        الطريقة: عرض_بايتات_من(0, م1),
        الهدف: عرض_بايتات_من(م1 + 1, م2),
        الإصدار: الإصدار,
        الرؤوس: الرؤوس,
        الجسم: عرض_بايتات_من(الموضع, الموضع + طول_الجسم),
        المستهلك: الموضع + طول_الجسم
    };
    أرجع نتيجة.نجح(الطلب);
}
عام مرادف parse_http1_request_view = حلل_طلب_ويب1_معروضا;

// The first header named الاسم (case-insensitive), as a range.
عام عرف قيمة_رأس_معروض_ويب(البايتات: &متجه ط8, الطلب: &طلب_ويب1_معروض, الاسم: &نص): اختياري عرض_بايتات {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).الرؤوس) مثل طبيعي)) {
        إذا (عرض_يساوي_بلا_حالة_ويب(البايتات, (*الطلب).الرؤوس[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود((*الطلب).الرؤوس[ف].القيمة);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}
عام مرادف http1_request_view_header = قيمة_رأس_معروض_ويب;

// An owned, buffered request with the same contents (std.http's handlers).
عام عرف طلب_من_معروض_ويب(البايتات: &متجه ط8, الطلب: &طلب_ويب1_معروض): طلب_ويب_مخزن {
    دع الرؤوس: متغير متجه رأس_ويب = [];
    احجز_سعة(الرؤوس, الطول((*الطلب).الرؤوس) مثل طبيعي);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطلب).الرؤوس) مثل طبيعي)) {
        دع الاسم: عرض_بايتات = (*الطلب).الرؤوس[ف].الاسم;
        دع الرأس: رأس_ويب = {
            الاسم: اسم_رأس_من_مدى_ويب(البايتات, الاسم.البداية, الاسم.البداية + الاسم.الطول),
            القيمة: نص_عرض_ويب(البايتات, (*الطلب).الرؤوس[ف].القيمة)
        };
        ألحق(الرؤوس, الرأس);
        ف := ف + 1;
    }
    دع اللاحقة: متجه رأس_ويب = [];
    دع الطريقة: عرض_بايتات = (*الطلب).الطريقة;
    دع الناتج: طلب_ويب_مخزن = {
        الطريقة: طريقة_من_مدى_ويب(البايتات, الطريقة.البداية, الطريقة.البداية + الطريقة.الطول),
        الهدف: نص_عرض_ويب(البايتات, (*الطلب).الهدف),
        الإصدار: (*الطلب).الإصدار,
        الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: اللاحقة,
        الجسم: بايتات_عرض_ويب(البايتات, (*الطلب).الجسم),
        العنوان_البعيد: «»,
        السياق: سياق_طلب_ويب_فارغ()
    };
    أرجع الناتج;
}
عام مرادف http1_request_from_view = طلب_من_معروض_ويب;
