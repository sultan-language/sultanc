استورد chars.ascii;
استورد text.compare;
استورد text.substring;
استورد uri.uri;
استورد http.model;
استورد http.headers;
استورد http.limits;

عام عرف ابحث_نهاية_سطر_ويب(البايتات: &متجه ط8, البداية: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = البداية;
    دع العدد: طبيعي = الطول((*البايتات)) مثل طبيعي;
    طالما ((ف + 1) < العدد) {
        دع التالي: طبيعي = ف + 1;
        إذا (((*البايتات)[ف] == 0x0D) && ((*البايتات)[التالي] == 0x0A)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف قص_فراغ_رأس_ويب(القيمة: &نص): نص {
    دع البداية: متغير طبيعي = 0;
    دع النهاية: متغير طبيعي = الطول((*القيمة)) مثل طبيعي;
    طالما ((البداية < النهاية) && (((*القيمة)[البداية] == 0x20) || ((*القيمة)[البداية] == 0x09))) { البداية := البداية + 1; }
    دع انتهى_القص: متغير منطقي = خطأ;
    طالما ((النهاية > البداية) && !انتهى_القص) {
        دع السابق: طبيعي = النهاية - 1;
        إذا (((*القيمة)[السابق] == 0x20) || ((*القيمة)[السابق] == 0x09)) { النهاية := السابق; } وإلا { انتهى_القص := صواب; };
    }
    طابق مقطع_نص(القيمة, البداية, النهاية - البداية) مع
    | اختياري.موجود(القيمة_المقصوصة) -> { أرجع القيمة_المقصوصة; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام عرف حلل_إصدار_ويب(القيمة: &نص): نتيجة إصدار_ويب, صنف_خطأ_ويب {
    دع واحد_صفر_نص: نص = «HTTP/1.0»;
    دع واحد_واحد_نص: نص = «HTTP/1.1»;
    إذا (نصان_متساويان(القيمة, &واحد_صفر_نص)) { أرجع نتيجة.نجح(إصدار_ويب.واحد_صفر()); };
    إذا (نصان_متساويان(القيمة, &واحد_واحد_نص)) { أرجع نتيجة.نجح(إصدار_ويب.واحد_واحد()); };
    أرجع نتيجة.خطأ(صنف_خطأ_ويب.إصدار_غير_مدعوم());
}

عام عرف هدف_ويب_صالح(القيمة: &نص): منطقي {
    دع العدد: طبيعي = الطول((*القيمة)) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا ((ب <= 0x20) || (ب >= 0x7F) || (ب == 0x23)) { أرجع خطأ; };
        إذا (ب == 0x25) {
            إذا ((ف + 2) >= العدد) { أرجع خطأ; };
            دع ف1: طبيعي = ف + 1;
            دع ف2: طبيعي = ف + 2;
            إذا ((قيمة_رقم_أسكي((*القيمة)[ف1]) < 0) || (قيمة_رقم_أسكي((*القيمة)[ف1]) >= 16)) { أرجع خطأ; };
            إذا ((قيمة_رقم_أسكي((*القيمة)[ف2]) < 0) || (قيمة_رقم_أسكي((*القيمة)[ف2]) >= 16)) { أرجع خطأ; };
            ف := ف + 3;
        } وإلا { ف := ف + 1; };
    }
    أرجع صواب;
}

عام عرف صيغة_هدف_طلب_ويب(الطريقة: &نص, الهدف: &نص): نتيجة صيغة_هدف_ويب, صنف_خطأ_ويب {
    دع نجمة_نص: نص = «*»;
    دع اتصال: نص = «CONNECT»;
    دع خيارات: نص = «OPTIONS»;
    إذا (نصان_متساويان(الهدف, &نجمة_نص)) {
        إذا (!نصان_متساويان(الطريقة, &خيارات)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
        أرجع نتيجة.نجح(صيغة_هدف_ويب.نجمة());
    };
    إذا ((الطول((*الهدف)) مثل طبيعي) > 0) {
        إذا ((*الهدف)[0] == 0x2F) {
            إذا (نصان_متساويان(الطريقة, &اتصال)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
            أرجع نتيجة.نجح(صيغة_هدف_ويب.أصل());
        };
    };
    إذا (نصان_متساويان(الطريقة, &اتصال)) {
        دع وجد_نقطتين: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الهدف)) مثل طبيعي)) {
            إذا (((*الهدف)[ف] == 0x3F) || ((*الهدف)[ف] == 0x2F)) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
            إذا ((*الهدف)[ف] == 0x3A) { وجد_نقطتين := صواب; };
            ف := ف + 1;
        }
        إذا (!وجد_نقطتين) { أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح()); };
        أرجع نتيجة.نجح(صيغة_هدف_ويب.سلطة());
    };
    طابق حلل_عنوانا_موحدا(الهدف) مع
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(صيغة_هدف_ويب.مطلق()); }
    | نتيجة.خطأ(_) -> { };
    أرجع نتيجة.خطأ(صنف_خطأ_ويب.هدف_غير_صالح());
}

عام عرف حلل_سطر_طلب_ويب(البايتات: &متجه ط8, النهاية: طبيعي): نتيجة طلب_ويب_مخزن, خطأ_ويب {
    دع المسافة1: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع المسافة2: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < النهاية) {
        إذا ((*البايتات)[ف] == 0x20) {
            طابق المسافة1 مع
            | اختياري.لا_شيء -> { المسافة1 := اختياري.موجود(ف); }
            | اختياري.موجود(_) -> {
                طابق المسافة2 مع
                | اختياري.لا_شيء -> { المسافة2 := اختياري.موجود(ف); }
                | اختياري.موجود(_) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), ف)); };
            };
        };
        ف := ف + 1;
    }
    دع م1: متغير طبيعي = 0;
    دع م2: متغير طبيعي = 0;
    طابق المسافة1 مع | اختياري.موجود(م) -> { م1 := م; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0)); };
    طابق المسافة2 مع | اختياري.موجود(م) -> { م2 := م; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), م1 + 1)); };
    إذا ((م1 == 0) || (م2 <= (م1 + 1)) || ((م2 + 1) >= النهاية)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), 0));
    };
    دع الطريقة: نص = طريقة_من_مدى_ويب(البايتات, 0, م1);
    دع الهدف: نص = نص_من_مدى_ويب(البايتات, م1 + 1, م2);
    دع الإصدار_نص: نص = نص_من_مدى_ويب(البايتات, م2 + 1, النهاية);
    إذا (!طريقة_ويب_صالحة(&الطريقة)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0)); };
    إذا (!هدف_ويب_صالح(&الهدف)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.هدف_غير_صالح(), م1 + 1)); };
    طابق صيغة_هدف_طلب_ويب(&الطريقة, &الهدف) مع
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, م1 + 1)); }
    | نتيجة.نجح(_) -> { };
    دع الإصدار: متغير إصدار_ويب = إصدار_ويب.واحد_واحد();
    طابق حلل_إصدار_ويب(&الإصدار_نص) مع
    | نتيجة.نجح(قيمة) -> { الإصدار := قيمة; }
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, م2 + 1)); };
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الطلب: طلب_ويب_مخزن = { الطريقة: الطريقة, الهدف: الهدف, الإصدار: الإصدار, الرؤوس: الرؤوس, الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم, العنوان_البعيد: «», السياق: سياق_طلب_ويب_فارغ() };
    أرجع نتيجة.نجح(الطلب);
}

عام عرف حلل_رأس_ويب_خام(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نتيجة رأس_ويب, خطأ_ويب {
    إذا (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    إذا (((*البايتات)[البداية] == 0x20) || ((*البايتات)[البداية] == 0x09)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طي_رأس_قديم(), البداية));
    };
    دع النقطتان: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا ((*البايتات)[ف] == 0x3A) { النقطتان := اختياري.موجود(ف); ف := النهاية; } وإلا { ف := ف + 1; };
    }
    دع م: متغير طبيعي = البداية;
    طابق النقطتان مع | اختياري.موجود(ق) -> { م := ق; } | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    إذا (م == البداية) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    دع الاسم_الخام: نص = نص_ويب_من_مدى(البايتات, البداية, م);
    دع القيمة_الخام: نص = نص_ويب_من_مدى(البايتات, م + 1, النهاية);
    إذا (!اسم_رأس_ويب_صالح(&الاسم_الخام)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.اسم_رأس_غير_صالح(), البداية)); };
    دع القيمة: نص = قص_فراغ_رأس_ويب(&القيمة_الخام);
    إذا (!قيمة_رأس_ويب_صالحة(&القيمة)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), م + 1)); };
    دع الاسم_المقنن: نص = اسم_رأس_ويب_مقنن(&الاسم_الخام);
    دع الرأس: رأس_ويب = { الاسم: الاسم_المقنن, القيمة: القيمة };
    أرجع نتيجة.نجح(الرأس);
}

عام عرف قيمة_طبيعية_عشرية_ويب(النص: &نص): اختياري طبيعي {
    إذا ((الطول((*النص)) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النص)) مثل طبيعي)) {
        دع ب: ط8 = (*النص)[ف];
        إذا (!رقم_عشري(ب)) { أرجع اختياري.لا_شيء(); };
        دع فرق_الرقم: ط8 = ب - 0x30;
        دع الرقم: طبيعي = فرق_الرقم مثل طبيعي;
        دع الأعلى: طبيعي = ~((0 مثل طبيعي));
        إذا (الناتج > ((الأعلى - الرقم) / 10)) { أرجع اختياري.لا_شيء(); };
        الناتج := (الناتج * 10) + الرقم;
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عام عرف قيمة_طبيعية_سداسية_ويب(النص: &نص): اختياري طبيعي {
    إذا ((الطول((*النص)) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*النص)) مثل طبيعي)) {
        دع ر: عدد = قيمة_رقم_أسكي((*النص)[ف]);
        إذا ((ر < 0) || (ر >= 16)) { أرجع اختياري.لا_شيء(); };
        دع الرقم: طبيعي = ر مثل طبيعي;
        دع الأعلى: طبيعي = ~((0 مثل طبيعي));
        إذا (الناتج > ((الأعلى - الرقم) / 16)) { أرجع اختياري.لا_شيء(); };
        الناتج := (الناتج * 16) + الرقم;
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

// The bytes [البداية, البداية + العدد) of المصدر, clamped to its end, copied
// as one block (ألحق_من: memcpy-speed on every backend).
عرف عدد_متاح_ويب(المصدر: &متجه ط8, البداية: طبيعي, العدد: طبيعي): طبيعي {
    دع الطول_الكلي: طبيعي = الطول(*المصدر) مثل طبيعي;
    إذا (البداية >= الطول_الكلي) { أرجع 0; };
    إذا (العدد > الطول_الكلي - البداية) { أرجع الطول_الكلي - البداية; };
    أرجع العدد;
}

عام عرف انسخ_بايتات_ويب(المصدر: &متجه ط8, البداية: طبيعي, العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_من(الناتج, المصدر, البداية, عدد_متاح_ويب(المصدر, البداية, العدد));
    أرجع الناتج;
}

عام عرف ألحق_بايتات_ويب(الناتج: &متغير متجه ط8, المصدر: &متجه ط8, البداية: طبيعي, العدد: طبيعي): فراغ {
    ألحق_من(*الناتج, المصدر, البداية, عدد_متاح_ويب(المصدر, البداية, العدد));
}

عام عرف رأس_ويب_يسمى(الرأس: &رأس_ويب, الاسم: نص): منطقي {
    دع المطلوب: نص = الاسم;
    أرجع اسما_رأس_ويب_متساويان(&(*الرأس).الاسم, &المطلوب);
}

// HTTP/1.1 Host is routing authority, so reject ambiguous or malformed values.
عام عرف قيمة_مضيف_ويب_صالحة(القيمة: &نص): منطقي {
    دع العدد: طبيعي = الطول((*القيمة)) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    إذا ((*القيمة)[0] == 0x5B) {
        دع إغلاق: متغير اختياري طبيعي = اختياري.لا_شيء();
        دع ف: متغير طبيعي = 1;
        طالما (ف < العدد) {
            دع ب: ط8 = (*القيمة)[ف];
            إذا (ب == 0x5D) { إغلاق := اختياري.موجود(ف); ف := العدد; }
            وإلا {
                إذا ((ب <= 0x20) || (ب >= 0x7F) || (ب == 0x5B) || (ب == 0x2F) || (ب == 0x3F) || (ب == 0x23) || (ب == 0x40) || (ب == 0x2C)) { أرجع خطأ; };
                ف := ف + 1;
            };
        }
        دع موضع_الإغلاق: متغير طبيعي = 0;
        طابق إغلاق مع | اختياري.موجود(م) -> { موضع_الإغلاق := م; } | اختياري.لا_شيء -> { أرجع خطأ; };
        إذا (موضع_الإغلاق == 1) { أرجع خطأ; };
        إذا ((موضع_الإغلاق + 1) == العدد) { أرجع صواب; };
        دع موضع_النقطتين: طبيعي = موضع_الإغلاق + 1;
        إذا (((*القيمة)[موضع_النقطتين] != 0x3A) || ((موضع_النقطتين + 1) >= العدد)) { أرجع خطأ; };
        ف := موضع_النقطتين + 1;
        طالما (ف < العدد) { إذا (!رقم_عشري((*القيمة)[ف])) { أرجع خطأ; }; ف := ف + 1; }
        أرجع صواب;
    };
    دع موضع_المنفذ: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا (ب == 0x3A) {
            طابق موضع_المنفذ مع | اختياري.موجود(_) -> { أرجع خطأ; } | اختياري.لا_شيء -> { موضع_المنفذ := اختياري.موجود(ف); };
            ف := ف + 1;
        } وإلا {
            دع مسموح: منطقي = حرف_أو_رقم_أسكي(ب) || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5F) || (ب == 0x7E)
                || (ب == 0x21) || (ب == 0x24) || (ب == 0x26) || (ب == 0x27) || (ب == 0x28) || (ب == 0x29)
                || (ب == 0x2A) || (ب == 0x2B) || (ب == 0x3B) || (ب == 0x3D) || (ب == 0x25);
            إذا (!مسموح) { أرجع خطأ; };
            إذا (ب == 0x25) {
                إذا ((ف + 2) >= العدد) { أرجع خطأ; };
                دع ف1: طبيعي = ف + 1; دع ف2: طبيعي = ف + 2;
                إذا ((قيمة_رقم_أسكي((*القيمة)[ف1]) < 0) || (قيمة_رقم_أسكي((*القيمة)[ف1]) >= 16)) { أرجع خطأ; };
                إذا ((قيمة_رقم_أسكي((*القيمة)[ف2]) < 0) || (قيمة_رقم_أسكي((*القيمة)[ف2]) >= 16)) { أرجع خطأ; };
                ف := ف + 3;
            } وإلا { ف := ف + 1; };
        };
    }
    طابق موضع_المنفذ مع
    | اختياري.لا_شيء -> { أرجع صواب; }
    | اختياري.موجود(م) -> {
        إذا ((م == 0) || ((م + 1) >= العدد)) { أرجع خطأ; };
        دع ك: متغير طبيعي = م + 1;
        طالما (ك < العدد) { إذا (!رقم_عشري((*القيمة)[ك])) { أرجع خطأ; }; ك := ك + 1; }
        أرجع صواب;
    };
}


عام عرف رأس_لاحق_ويب_ممنوع(الرأس: &رأس_ويب): منطقي {
    أرجع رأس_ويب_يسمى(الرأس, «content-length»)
        || رأس_ويب_يسمى(الرأس, «transfer-encoding»)
        || رأس_ويب_يسمى(الرأس, «host»);
}


// SultanC HTTP/1 currently supports only the required chunked transfer coding.
// Validate the complete field value so unsupported coding lists are rejected,
// rather than treating the raw field as an opaque token.
عام عرف ترميز_نقل_مجزأ_ويب1(القيمة: &نص): منطقي {
    دع المقصوص: نص = قص_فراغ_رأس_ويب(القيمة);
    إذا ((الطول(المقصوص) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المقصوص) مثل طبيعي)) {
        إذا (!حرف_رمز_ويب(المقصوص[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    دع chunked: نص = «chunked»;
    أرجع اسما_رأس_ويب_متساويان(&المقصوص, &chunked);
}

عام عرف نص_إصدار_ويب1(الإصدار: إصدار_ويب): اختياري نص {
    طابق الإصدار مع
    | إصدار_ويب.واحد_صفر -> { أرجع اختياري.موجود(«HTTP/1.0»); }
    | إصدار_ويب.واحد_واحد -> { أرجع اختياري.موجود(«HTTP/1.1»); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

// English public aliases.
عام مرادف http_request_target_form = صيغة_هدف_طلب_ويب;

// Old names, kept for one release: the unsigned types are now `طبيعي` and `ط8`..`ط64`.
عام مرادف قيمة_غير_موقعة_عشرية_ويب = قيمة_طبيعية_عشرية_ويب;
عام مرادف قيمة_غير_موقعة_سداسية_ويب = قيمة_طبيعية_سداسية_ويب;

// Byte ranges of a buffer (http.http1.views builds request views on them).

عام نوع عرض_بايتات = { البداية: طبيعي, الطول: طبيعي };
عام مرادف byte_view = عرض_بايتات;

عام عرف عرض_بايتات_من(البداية: طبيعي, النهاية: طبيعي): عرض_بايتات {
    دع الطول: متغير طبيعي = 0;
    إذا (النهاية > البداية) { الطول := النهاية - البداية; };
    دع العرض: عرض_بايتات = { البداية: البداية, الطول: الطول };
    أرجع العرض;
}

// The range's bytes as owned text: one block copy, moved into the text.
عام عرف نص_عرض_ويب(البايتات: &متجه ط8, العرض: عرض_بايتات): نص {
    دع الناتج: متغير متجه ط8 = [];
    إذا (العرض.الطول > 0) { ألحق_من(الناتج, البايتات, العرض.البداية, العرض.الطول); };
    أرجع الناتج مثل نص;
}
عام مرادف byte_view_text = نص_عرض_ويب;

عام عرف بايتات_عرض_ويب(البايتات: &متجه ط8, العرض: عرض_بايتات): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    إذا (العرض.الطول > 0) { ألحق_من(الناتج, البايتات, العرض.البداية, العرض.الطول); };
    أرجع الناتج;
}
عام مرادف byte_view_bytes = بايتات_عرض_ويب;

عام عرف عرض_يساوي_ويب(البايتات: &متجه ط8, العرض: عرض_بايتات, النص: &نص): منطقي {
    إذا ((الطول(*النص) مثل طبيعي) != العرض.الطول) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض.الطول) {
        إذا ((*البايتات)[العرض.البداية + ف] != (*النص)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}
عام مرادف byte_view_equals = عرض_يساوي_ويب;

// ASCII case-insensitive (header names, RFC 9110 §5.1).
عام عرف عرض_يساوي_بلا_حالة_ويب(البايتات: &متجه ط8, العرض: عرض_بايتات, النص: &نص): منطقي {
    إذا ((الطول(*النص) مثل طبيعي) != العرض.الطول) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض.الطول) {
        إذا (إلى_صغير_أسكي((*البايتات)[العرض.البداية + ف]) != إلى_صغير_أسكي((*النص)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}
عام مرادف byte_view_equals_ignore_case = عرض_يساوي_بلا_حالة_ويب;

// ---- Range helpers for the buffered parser ----

// [البداية, النهاية) as owned text in one block copy.
عام عرف نص_من_مدى_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نص {
    أرجع نص_عرض_ويب(البايتات, عرض_بايتات_من(البداية, النهاية));
}

عام عرف مدى_يساوي_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, النص: نص): منطقي {
    دع المطلوب: نص = النص;
    أرجع عرض_يساوي_ويب(البايتات, عرض_بايتات_من(البداية, النهاية), &المطلوب);
}
عام عرف مدى_يساوي_بلا_حالة_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, النص: نص): منطقي {
    دع المطلوب: نص = النص;
    أرجع عرض_يساوي_بلا_حالة_ويب(البايتات, عرض_بايتات_من(البداية, النهاية), &المطلوب);
}

// The method as text: a static text for the RFC 9110 methods and PATCH (no
// allocation), else a copy.
عام عرف طريقة_من_مدى_ويب(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): نص {
    دع الطول: طبيعي = النهاية - البداية;
    إذا (الطول == 3) {
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «GET»)) { أرجع «GET»; };
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «PUT»)) { أرجع «PUT»; };
    } وإلا إذا (الطول == 4) {
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «POST»)) { أرجع «POST»; };
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «HEAD»)) { أرجع «HEAD»; };
    } وإلا إذا (الطول == 5) {
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «PATCH»)) { أرجع «PATCH»; };
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «TRACE»)) { أرجع «TRACE»; };
    } وإلا إذا (الطول == 6) {
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «DELETE»)) { أرجع «DELETE»; };
    } وإلا إذا (الطول == 7) {
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «OPTIONS»)) { أرجع «OPTIONS»; };
        إذا (مدى_يساوي_ويب(البايتات, البداية, النهاية, «CONNECT»)) { أرجع «CONNECT»; };
    };
    أرجع نص_من_مدى_ويب(البايتات, البداية, النهاية);
}

