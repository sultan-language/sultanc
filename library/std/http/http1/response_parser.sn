استورد text.compare;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;

عام نوع استجابة_ويب1_محللة = {
    الاستجابة: استجابة_ويب_مخزنة,
    المستهلك: طبيعي,
    نفق: منطقي,
    محدد_بالإغلاق: منطقي
};


عرف حلل_سطر_حالة_ويب1(البايتات: &متجه ط8, النهاية: طبيعي): نتيجة استجابة_ويب_مخزنة, خطأ_ويب {
    إذا (النهاية < 12) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 0)); };
    دع نص_الإصدار: نص = نص_ويب_من_مدى(البايتات, 0, 8);
    دع الإصدار: متغير إصدار_ويب = إصدار_ويب.واحد_واحد();
    طابق حلل_إصدار_ويب(&نص_الإصدار) مع
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, 0)); }
    | نتيجة.نجح(قيمة) -> { الإصدار := قيمة; };
    إذا ((*البايتات)[8] != 0x20) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 8)); };
    دع نص_الحالة: نص = نص_ويب_من_مدى(البايتات, 9, 12);
    دع الحالة: متغير طبيعي = 0;
    طابق قيمة_طبيعية_عشرية_ويب(&نص_الحالة) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 9)); }
    | اختياري.موجود(قيمة) -> { الحالة := قيمة; };
    إذا ((الحالة < 100) || (الحالة > 999)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 9)); };
    إذا ((النهاية > 12) && ((*البايتات)[12] != 0x20)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.حالة_غير_صالحة(), 12)); };
    دع الرؤوس: متجه رأس_ويب = [];
    دع اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الاستجابة: استجابة_ويب_مخزنة = { الإصدار: الإصدار, الحالة: الحالة, الرؤوس: الرؤوس, الرؤوس_اللاحقة: اللاحقة, الجسم: الجسم };
    أرجع نتيجة.نجح(الاستجابة);
}

عرف طلب_رأس_ويب(الطريقة: &نص): منطقي {
    دع head: نص = «HEAD»;
    أرجع نصان_متساويان(الطريقة, &head);
}

عرف طلب_اتصال_ويب(الطريقة: &نص): منطقي {
    دع connect: نص = «CONNECT»;
    أرجع نصان_متساويان(الطريقة, &connect);
}

عام عرف حلل_استجابة_ويب1_أساسيا(
    البايتات: &متجه ط8,
    انتهى_المدخل: منطقي,
    الحدود: &حدود_استجابة_ويب1,
    طريقة_الطلب: &نص
): نتيجة استجابة_ويب1_محللة, خطأ_ويب {
    دع العدد: طبيعي = الطول((*البايتات)) مثل طبيعي;
    دع نهاية_الحالة: متغير طبيعي = 0;
    طابق ابحث_نهاية_سطر_ويب(البايتات, 0) مع
    | اختياري.لا_شيء -> {
        إذا (العدد > (*الحدود).أقصى_سطر_حالة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), (*الحدود).أقصى_سطر_حالة)); };
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد));
    }
    | اختياري.موجود(قيمة) -> { نهاية_الحالة := قيمة; };
    إذا (نهاية_الحالة > (*الحدود).أقصى_سطر_حالة) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.سطر_بداية_طويل(), نهاية_الحالة)); };

    دع الاستجابة: متغير استجابة_ويب_مخزنة;
    طابق حلل_سطر_حالة_ويب1(البايتات, نهاية_الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { الاستجابة := قيمة; };

    دع الموضع: متغير طبيعي = نهاية_الحالة + 2;
    دع بداية_الرؤوس: طبيعي = الموضع;
    دع عدد_الرؤوس: متغير طبيعي = 0;
    دع انتهت_الرؤوس: متغير منطقي = خطأ;
    طالما (!انتهت_الرؤوس) {
        إذا ((الموضع + 1) >= العدد) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), الموضع)); };
        دع الموضع_التالي: طبيعي = الموضع + 1;
        إذا (((*البايتات)[الموضع] == 0x0D) && ((*البايتات)[الموضع_التالي] == 0x0A)) {
            الموضع := الموضع + 2;
            انتهت_الرؤوس := صواب;
        } وإلا {
            إذا ((الموضع - بداية_الرؤوس) > (*الحدود).أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };
            إذا (عدد_الرؤوس >= (*الحدود).أقصى_عدد_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رؤوس_كثيرة(), الموضع)); };
            دع نهاية_السطر: متغير طبيعي = 0;
            طابق ابحث_نهاية_سطر_ويب(البايتات, الموضع) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); }
            | اختياري.موجود(قيمة) -> { نهاية_السطر := قيمة; };
            طابق حلل_رأس_ويب_خام(البايتات, الموضع, نهاية_السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الرأس) -> { ألحق(الاستجابة.الرؤوس, الرأس); };
            عدد_الرؤوس := عدد_الرؤوس + 1;
            الموضع := نهاية_السطر + 2;
        };
    }
    إذا ((الموضع - بداية_الرؤوس) > (*الحدود).أقصى_بايتات_رؤوس) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قسم_رؤوس_كبير(), الموضع)); };

    // HTTP/1 framing precedence is decided before ordinary TE/CL framing.
    // Successful CONNECT switches to tunnel mode immediately after headers,
    // and HEAD/1xx/204/304 are header-terminated regardless of framing fields.
    دع اتصال_ناجح: منطقي = طلب_اتصال_ويب(طريقة_الطلب) && (الاستجابة.الحالة >= 200) && (الاستجابة.الحالة < 300);
    إذا (اتصال_ناجح) {
        دع الناتج: استجابة_ويب1_محللة = { الاستجابة: الاستجابة, المستهلك: الموضع, نفق: صواب, محدد_بالإغلاق: خطأ };
        أرجع نتيجة.نجح(الناتج);
    };
    دع بلا_جسم: منطقي = طلب_رأس_ويب(طريقة_الطلب)
        || ((الاستجابة.الحالة >= 100) && (الاستجابة.الحالة < 200))
        || (الاستجابة.الحالة == 204)
        || (الاستجابة.الحالة == 304);
    إذا (بلا_جسم) {
        دع الناتج: استجابة_ويب1_محللة = { الاستجابة: الاستجابة, المستهلك: الموضع, نفق: خطأ, محدد_بالإغلاق: خطأ };
        أرجع نتيجة.نجح(الناتج);
    };

    دع اسم_النقل: نص = «transfer-encoding»;
    دع اسم_الطول: نص = «content-length»;
    دع ترميزات: متجه نص = قيم_رأس_ويب(&الاستجابة.الرؤوس, &اسم_النقل);
    دع أطوال: متجه نص = قيم_رأس_ويب(&الاستجابة.الرؤوس, &اسم_الطول);
    إذا ((الطول(ترميزات) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); };
    إذا ((الطول(أطوال) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), الموضع)); };
    إذا (((الطول(ترميزات) مثل طبيعي) > 0) && ((الطول(أطوال) مثل طبيعي) > 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), الموضع));
    };
    إذا ((الطول(ترميزات) مثل طبيعي) == 1) {
        طابق الاستجابة.الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); };
        إذا (!ترميز_نقل_مجزأ_ويب1(&ترميزات[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), الموضع)); };
    };

    إذا ((الطول(ترميزات) مثل طبيعي) == 1) {
        طابق حلل_جسم_مجزأ_ويب1(
            البايتات,
            الموضع,
            (*الحدود).أقصى_بايتات_جسم,
            (*الحدود).أقصى_بايتات_سطر_قطعة,
            (*الحدود).أقصى_بايتات_رؤوس_لاحقة,
            (*الحدود).أقصى_عدد_رؤوس_لاحقة
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح({ الجسم: الجسم, الرؤوس_اللاحقة: الرؤوس_اللاحقة, المستهلك: المستهلك }) -> {
            إذا ((الاستجابة.الحالة == 205) && ((الطول(الجسم) مثل طبيعي) != 0)) {
                أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), الموضع));
            };
            الاستجابة.الجسم := الجسم;
            الاستجابة.الرؤوس_اللاحقة := الرؤوس_اللاحقة;
            دع الناتج: استجابة_ويب1_محللة = { الاستجابة: الاستجابة, المستهلك: المستهلك, نفق: خطأ, محدد_بالإغلاق: خطأ };
            أرجع نتيجة.نجح(الناتج);
        };
    };

    إذا ((الطول(أطوال) مثل طبيعي) == 1) {
        دع حجم: متغير طبيعي = 0;
        طابق قيمة_طبيعية_عشرية_ويب(&أطوال[0]) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), الموضع)); }
        | اختياري.موجود(قيمة) -> { حجم := قيمة; };
        إذا (حجم > (*الحدود).أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
        إذا ((الاستجابة.الحالة == 205) && (حجم != 0)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), الموضع));
        };
        إذا ((العدد - الموضع) < حجم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
        الاستجابة.الجسم := انسخ_بايتات_ويب(البايتات, الموضع, حجم);
        دع الناتج: استجابة_ويب1_محللة = { الاستجابة: الاستجابة, المستهلك: الموضع + حجم, نفق: خطأ, محدد_بالإغلاق: خطأ };
        أرجع نتيجة.نجح(الناتج);
    };

    دع حجم_الإغلاق: طبيعي = العدد - الموضع;
    إذا (حجم_الإغلاق > (*الحدود).أقصى_بايتات_جسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.جسم_كبير(), الموضع)); };
    إذا ((الاستجابة.الحالة == 205) && (حجم_الإغلاق != 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.محتوى_غير_مسموح(), الموضع));
    };
    إذا (!انتهى_المدخل) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.غير_مكتمل(), العدد)); };
    الاستجابة.الجسم := انسخ_بايتات_ويب(البايتات, الموضع, حجم_الإغلاق);
    دع الناتج: استجابة_ويب1_محللة = { الاستجابة: الاستجابة, المستهلك: العدد, نفق: خطأ, محدد_بالإغلاق: صواب };
    أرجع نتيجة.نجح(الناتج);
}

// English public aliases.
عام نوع detailed_http1_response = استجابة_ويب1_محللة;
عام مرادف parse_http1_response_detailed = حلل_استجابة_ويب1_أساسيا;
