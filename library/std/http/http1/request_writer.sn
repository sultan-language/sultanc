استورد text.number;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;

عرف تحقق_مضيف_طلب_ويب1(الطلب: &طلب_ويب_مخزن): نتيجة منطقي, خطأ_ويب {
    دع القيمة: طلب_ويب_مخزن = *الطلب;
    دع اسم_المضيف: نص = «host»;
    دع المضيفون: متجه نص = قيم_رأس_ويب(&القيمة.الرؤوس, &اسم_المضيف);
    طابق القيمة.الإصدار مع
    | إصدار_ويب.واحد_واحد -> {
        لو ((الطول(المضيفون) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), 0)); };
        لو ((الطول(المضيفون) مثل غير_موقع) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), 0)); };
        لو (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0)); };
    }
    | _ -> {
        لو ((الطول(المضيفون) مثل غير_موقع) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), 0)); };
        لو ((الطول(المضيفون) مثل غير_موقع) == 1) {
            لو (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0)); };
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عام عرف هيئ_طلب_ويب1_أساسيا(
    الطريقة: &نص,
    الهدف: &نص,
    السلطة: &نص,
    الرؤوس: &متجه رأس_ويب,
    الرؤوس_اللاحقة: &متجه رأس_ويب,
    الجسم: &متجه غ8
): نتيجة طلب_ويب_مخزن, خطأ_ويب {
    دع نسخة_رؤوس: متغير متجه رأس_ويب = انسخ_رؤوس_ويب(الرؤوس);
    دع نسخة_لاحقة: متجه رأس_ويب = انسخ_رؤوس_ويب(الرؤوس_اللاحقة);
    دع نسخة_جسم: متجه غ8 = *الجسم;
    دع اسم_المضيف: نص = «host»;
    طابق أول_قيمة_رأس_ويب(&نسخة_رؤوس, &اسم_المضيف) مع
    | اختيار.بعض(_) -> { }
    | اختيار.لا_شيء -> {
        لو ((الطول(*السلطة) مثل غير_موقع) == 0) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), 0));
        };
        لو (!أضف_رأس_ويب(&متغير نسخة_رؤوس, &اسم_المضيف, السلطة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0));
        };
    };
    دع الطلب: طلب_ويب_مخزن = {
        الطريقة: *الطريقة,
        الهدف: *الهدف,
        الإصدار: إصدار_ويب.واحد_واحد(),
        الرؤوس: نسخة_رؤوس,
        الرؤوس_اللاحقة: نسخة_لاحقة,
        الجسم: نسخة_جسم
    };
    طابق تحقق_مضيف_طلب_ويب1(&الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(الطلب);
}

عام عرف سلسل_طلب_ويب1_أساسي(الطلب: &طلب_ويب_مخزن): نتيجة متجه غ8, خطأ_ويب {
    دع القيمة: طلب_ويب_مخزن = *الطلب;
    لو (!طريقة_ويب_صالحة(&القيمة.الطريقة) || !هدف_ويب_صالح(&القيمة.الهدف)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0));
    };
    طابق صيغة_هدف_طلب_ويب(&القيمة.الطريقة, &القيمة.الهدف) مع
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, 0)); }
    | نتيجة.نجح(_) -> { };
    دع نص_الإصدار: متغير نص = «»;
    طابق نص_إصدار_ويب1(القيمة.الإصدار) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.إصدار_غير_مدعوم(), 0)); }
    | اختيار.بعض(النص) -> { نص_الإصدار := النص; };
    طابق تحقق_مضيف_طلب_ويب1(&القيمة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    دع الرؤوس: متغير متجه رأس_ويب = انسخ_رؤوس_ويب(&القيمة.الرؤوس);
    دع اسم_الطول: نص = «content-length»;
    دع اسم_النقل: نص = «transfer-encoding»;
    دع أطوال: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_الطول);
    دع ترميزات: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_النقل);
    لو ((الطول(أطوال) مثل غير_موقع) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), 0)); };
    لو ((الطول(ترميزات) مثل غير_موقع) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
    لو (((الطول(أطوال) مثل غير_موقع) > 0) && ((الطول(ترميزات) مثل غير_موقع) > 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), 0));
    };

    دع استخدم_مجزأ: متغير منطقي = خطأ;
    لو ((الطول(ترميزات) مثل غير_موقع) == 1) {
        طابق القيمة.الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        لو (!ترميز_نقل_مجزأ_ويب1(&ترميزات[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        استخدم_مجزأ := صواب;
    };
    لو ((الطول(القيمة.الرؤوس_اللاحقة) مثل غير_موقع) > 0) {
        طابق القيمة.الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
        لو (!استخدم_مجزأ) {
            دع chunked: نص = «chunked»;
            لو (!أضف_رأس_ويب(&متغير الرؤوس, &اسم_النقل, &chunked)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
            استخدم_مجزأ := صواب;
        };
    };

    دع طول_الجسم: غير_موقع = الطول(القيمة.الجسم) مثل غير_موقع;
    لو (!استخدم_مجزأ) {
        لو ((الطول(القيمة.الرؤوس_اللاحقة) مثل غير_موقع) > 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
        لو ((الطول(أطوال) مثل غير_موقع) == 1) {
            طابق قيمة_غير_موقعة_عشرية_ويب(&أطوال[0]) مع
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }
            | اختيار.بعض(المعلن) -> { لو (المعلن != طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }; };
        } وإلا لو (طول_الجسم > 0) {
            دع نص_الطول: نص = غير_موقع_إلى_نص(طول_الجسم);
            لو (!أضف_رأس_ويب(&متغير الرؤوس, &اسم_الطول, &نص_الطول)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
        };
    };

    دع الناتج: متغير متجه غ8 = [];
    ألحق_نص_ويب(&متغير الناتج, &القيمة.الطريقة); ألحق(الناتج, 0x20);
    ألحق_نص_ويب(&متغير الناتج, &القيمة.الهدف); ألحق(الناتج, 0x20);
    ألحق_نص_ويب(&متغير الناتج, &نص_الإصدار); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الرؤوس) مثل غير_موقع)) {
        لو (!اسم_رأس_ويب_صالح(&الرؤوس[ف].الاسم) || !قيمة_رأس_ويب_صالحة(&الرؤوس[ف].القيمة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0));
        };
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].الاسم); ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].القيمة); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    لو (استخدم_مجزأ) {
        طابق سلسل_جسم_مجزأ_ويب1(&القيمة.الجسم, &القيمة.الرؤوس_اللاحقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجزأ) -> { ألحق_بايتات_ويب(&متغير الناتج, &المجزأ, 0, الطول(المجزأ) مثل غير_موقع); };
    } وإلا {
        ألحق_بايتات_ويب(&متغير الناتج, &القيمة.الجسم, 0, طول_الجسم);
    };
    أرجع نتيجة.نجح(الناتج);
}
