استورد text.from_bytes;
استورد text.number;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.chunked;

عرف تحقق_مضيف_طلب_ويب1(الطلب: &طلب_ويب_مخزن): نتيجة منطقي, خطأ_ويب {
    دع اسم_المضيف: نص = «host»;
    دع المضيفون: متجه نص = قيم_رأس_ويب(&(*الطلب).الرؤوس, &اسم_المضيف);
    طابق (*الطلب).الإصدار مع
    | إصدار_ويب.واحد_واحد -> {
        إذا ((الطول(المضيفون) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), 0)); };
        إذا ((الطول(المضيفون) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), 0)); };
        إذا (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0)); };
    }
    | _ -> {
        إذا ((الطول(المضيفون) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيفون_متعددون(), 0)); };
        إذا ((الطول(المضيفون) مثل طبيعي) == 1) {
            إذا (!قيمة_مضيف_ويب_صالحة(&المضيفون[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0)); };
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عام عرف هيئ_طلب_ويب1_أساسيا(
    الطريقة: &نص,
    الهدف: &نص,
    السلطة: &نص,
    الرؤوس: &متجه رأس_ويب,
    الرؤوس_اللاحقة: &متجه رأس_ويب,
    الجسم: &متجه ط8
): نتيجة طلب_ويب_مخزن, خطأ_ويب {
    دع نسخة_رؤوس: متغير متجه رأس_ويب = انسخ_رؤوس_ويب(الرؤوس);
    دع نسخة_لاحقة: متجه رأس_ويب = انسخ_رؤوس_ويب(الرؤوس_اللاحقة);
    دع نسخة_جسم: متجه ط8 = انسخ_بايتات(الجسم);
    دع اسم_المضيف: نص = «host»;
    طابق أول_قيمة_رأس_ويب(&نسخة_رؤوس, &اسم_المضيف) مع
    | اختياري.موجود(_) -> { }
    | اختياري.لا_شيء -> {
        إذا ((الطول(*السلطة) مثل طبيعي) == 0) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_مفقود(), 0));
        };
        إذا (!أضف_رأس_ويب(&متغير نسخة_رؤوس, &اسم_المضيف, السلطة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.مضيف_غير_صالح(), 0));
        };
    };
    دع الطلب: طلب_ويب_مخزن = {
        الطريقة: انسخ_نص(الطريقة),
        الهدف: انسخ_نص(الهدف),
        الإصدار: إصدار_ويب.واحد_واحد(),
        الرؤوس: نسخة_رؤوس,
        الرؤوس_اللاحقة: نسخة_لاحقة,
        الجسم: نسخة_جسم,
        العنوان_البعيد: «»,
        السياق: سياق_طلب_ويب_فارغ()
    };
    طابق تحقق_مضيف_طلب_ويب1(&الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(الطلب);
}

عام عرف سلسل_طلب_ويب1_أساسي(الطلب: &طلب_ويب_مخزن): نتيجة متجه ط8, خطأ_ويب {
    إذا (!طريقة_ويب_صالحة(&(*الطلب).الطريقة) || !هدف_ويب_صالح(&(*الطلب).الهدف)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طريقة_غير_صالحة(), 0));
    };
    طابق صيغة_هدف_طلب_ويب(&(*الطلب).الطريقة, &(*الطلب).الهدف) مع
    | نتيجة.خطأ(الصنف) -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(الصنف, 0)); }
    | نتيجة.نجح(_) -> { };
    دع نص_الإصدار: متغير نص = «»;
    طابق نص_إصدار_ويب1((*الطلب).الإصدار) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.إصدار_غير_مدعوم(), 0)); }
    | اختياري.موجود(النص) -> { نص_الإصدار := النص; };
    طابق تحقق_مضيف_طلب_ويب1(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    دع الرؤوس: متغير متجه رأس_ويب = انسخ_رؤوس_ويب(&(*الطلب).الرؤوس);
    دع اسم_الطول: نص = «content-length»;
    دع اسم_النقل: نص = «transfer-encoding»;
    دع أطوال: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_الطول);
    دع ترميزات: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_النقل);
    إذا ((الطول(أطوال) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.أطوال_محتوى_متعددة(), 0)); };
    إذا ((الطول(ترميزات) مثل طبيعي) > 1) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
    إذا (((الطول(أطوال) مثل طبيعي) > 0) && ((الطول(ترميزات) مثل طبيعي) > 0)) {
        أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_مع_طول(), 0));
    };

    دع استخدم_مجزأ: متغير منطقي = خطأ;
    إذا ((الطول(ترميزات) مثل طبيعي) == 1) {
        طابق (*الطلب).الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        إذا (!ترميز_نقل_مجزأ_ويب1(&ترميزات[0])) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.ترميز_نقل_غير_مدعوم(), 0)); };
        استخدم_مجزأ := صواب;
    };
    إذا ((الطول((*الطلب).الرؤوس_اللاحقة) مثل طبيعي) > 0) {
        طابق (*الطلب).الإصدار مع
        | إصدار_ويب.واحد_واحد -> { }
        | _ -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
        إذا (!استخدم_مجزأ) {
            دع chunked: نص = «chunked»;
            إذا (!أضف_رأس_ويب(&متغير الرؤوس, &اسم_النقل, &chunked)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
            استخدم_مجزأ := صواب;
        };
    };

    دع طول_الجسم: طبيعي = الطول((*الطلب).الجسم) مثل طبيعي;
    إذا (!استخدم_مجزأ) {
        إذا ((الطول((*الطلب).الرؤوس_اللاحقة) مثل طبيعي) > 0) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.رأس_لاحق_ممنوع(), 0)); };
        إذا ((الطول(أطوال) مثل طبيعي) == 1) {
            طابق قيمة_طبيعية_عشرية_ويب(&أطوال[0]) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }
            | اختياري.موجود(المعلن) -> { إذا (المعلن != طول_الجسم) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.طول_محتوى_غير_صالح(), 0)); }; };
        } وإلا إذا (طول_الجسم > 0) {
            دع نص_الطول: نص = طبيعي_إلى_نص(طول_الجسم);
            إذا (!أضف_رأس_ويب(&متغير الرؤوس, &اسم_الطول, &نص_الطول)) { أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0)); };
        };
    };

    دع الناتج: متغير متجه ط8 = [];
    ألحق_نص_ويب(&متغير الناتج, &(*الطلب).الطريقة); ألحق(الناتج, 0x20);
    ألحق_نص_ويب(&متغير الناتج, &(*الطلب).الهدف); ألحق(الناتج, 0x20);
    ألحق_نص_ويب(&متغير الناتج, &نص_الإصدار); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الرؤوس) مثل طبيعي)) {
        إذا (!اسم_رأس_ويب_صالح(&الرؤوس[ف].الاسم) || !قيمة_رأس_ويب_صالحة(&الرؤوس[ف].القيمة)) {
            أرجع نتيجة.خطأ(خطأ_ويب_عند(صنف_خطأ_ويب.قيمة_رأس_غير_صالحة(), 0));
        };
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].الاسم); ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_ويب(&متغير الناتج, &الرؤوس[ف].القيمة); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    إذا (استخدم_مجزأ) {
        طابق سلسل_جسم_مجزأ_ويب1(&(*الطلب).الجسم, &(*الطلب).الرؤوس_اللاحقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجزأ) -> { ألحق_بايتات_ويب(&متغير الناتج, &المجزأ, 0, الطول(المجزأ) مثل طبيعي); };
    } وإلا {
        ألحق_بايتات_ويب(&متغير الناتج, &(*الطلب).الجسم, 0, طول_الجسم);
    };
    أرجع نتيجة.نجح(الناتج);
}
