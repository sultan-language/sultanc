// The byte transport under an HTTP connection: plain TCP or TLS. HTTP/1 and
// HTTP/2 run over either one through the std reader and writer shapes, as
// Go's net/http serves both protocols over a net.Conn or a tls.Conn.

استورد net.tcp;
استورد tls.stream;

عام نوع ناقل_ويب =
    | تي_سي_بي بنوع تدفق_تي_سي_بي
    | تي_إل_إس بنوع تدفق_تي_إل_إس
;

عام عرف اقرأ_ناقل_ويب(الناقل: &ناقل_ويب, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد): نتيجة عدد, عدد {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع اقرأ_تي_سي_بي(&التدفق, المخزن, الإزاحة, العدد); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع اقرأ_تدفق_تي_إل_إس(&التدفق, المخزن, الإزاحة, العدد); };
}

عام عرف اكتب_ناقل_ويب(الناقل: &ناقل_ويب, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد): نتيجة عدد, عدد {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع اكتب_تي_سي_بي(&التدفق, المحتوى, الإزاحة, العدد); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع اكتب_تدفق_تي_إل_إس(&التدفق, المحتوى, الإزاحة, العدد); };
}

// Closes the transport (TLS sends close_notify first).
عام عرف أغلق_ناقل_ويب(الناقل: ناقل_ويب): نتيجة عدد, عدد {
    طابق الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع أغلق_تدفق_تي_سي_بي(التدفق); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع أغلق_تدفق_تي_إل_إس(التدفق); };
}

عام مرادف http_transport = ناقل_ويب;
عام مرادف http_transport.tcp = ناقل_ويب.تي_سي_بي;
عام مرادف http_transport.tls = ناقل_ويب.تي_إل_إس;
عام مرادف http_transport_read = اقرأ_ناقل_ويب;
عام مرادف http_transport_write = اكتب_ناقل_ويب;
عام مرادف http_transport_close = أغلق_ناقل_ويب;
