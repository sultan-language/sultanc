// The byte transport under an HTTP connection: plain TCP or TLS. HTTP/1 and
// HTTP/2 run over either one through the std reader and writer shapes, as
// Go's net/http serves both protocols over a net.Conn or a tls.Conn. An
// async TCP transport (std.async.net) suspends the task serving the
// connection instead of the thread whenever the socket is not ready.

استورد net.tcp;
استورد tls.stream;
استورد net.socket_names;
استورد net.socket_address;
استورد async.net;

عام نوع ناقل_ويب =
    | تي_سي_بي بنوع تدفق_تي_سي_بي
    | تي_إل_إس بنوع تدفق_تي_إل_إس
    | تي_سي_بي_غير_متزامن بنوع تدفق_تي_سي_بي
;

// The client's address of a transport as "ip:port" (Go's RemoteAddr): the
// TCP socket's peer, or empty when it cannot be read (a TLS transport keeps
// its socket inside; its server records the address before the handshake).
عام عرف عنوان_نظير_ناقل_ويب(الناقل: &ناقل_ويب): نص {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع عنوان_نظير_تي_سي_بي_نص(&التدفق); }
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> { أرجع عنوان_نظير_تي_سي_بي_نص(&التدفق); }
    | ناقل_ويب.تي_إل_إس(_) -> { أرجع «»; };
}

// The peer of a TCP stream as text, empty when getpeername fails.
عام عرف عنوان_نظير_تي_سي_بي_نص(التدفق: &تدفق_تي_سي_بي): نص {
    طابق عنوان_نظير_تي_سي_بي(التدفق) مع
    | نتيجة.خطأ(_) -> { أرجع «»; }
    | نتيجة.نجح(العنوان) -> { أرجع نص_عنوان_مقبس(&العنوان); };
}

عام عرف اقرأ_ناقل_ويب(الناقل: &ناقل_ويب, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد): نتيجة عدد, عدد {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع اقرأ_تي_سي_بي(&التدفق, المخزن, الإزاحة, العدد); }
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> { أرجع اقرأ_غير_متزامن(&التدفق, المخزن, الإزاحة, العدد); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع اقرأ_تدفق_تي_إل_إس(&التدفق, المخزن, الإزاحة, العدد); };
}

عام عرف اكتب_ناقل_ويب(الناقل: &ناقل_ويب, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد): نتيجة عدد, عدد {
    طابق *الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع اكتب_تي_سي_بي(&التدفق, المحتوى, الإزاحة, العدد); }
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> { أرجع اكتب_غير_متزامن(&التدفق, المحتوى, الإزاحة, العدد); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع اكتب_تدفق_تي_إل_إس(&التدفق, المحتوى, الإزاحة, العدد); };
}

// Closes the transport (TLS sends close_notify first).
عام عرف أغلق_ناقل_ويب(الناقل: ناقل_ويب): نتيجة عدد, عدد {
    طابق الناقل مع
    | ناقل_ويب.تي_سي_بي(التدفق) -> { أرجع أغلق_تدفق_تي_سي_بي(التدفق); }
    | ناقل_ويب.تي_سي_بي_غير_متزامن(التدفق) -> { أرجع أغلق_غير_متزامن(التدفق); }
    | ناقل_ويب.تي_إل_إس(التدفق) -> { أرجع أغلق_تدفق_تي_إل_إس(التدفق); };
}

عام مرادف http_transport = ناقل_ويب;
عام مرادف http_transport.tcp = ناقل_ويب.تي_سي_بي;
عام مرادف http_transport.tls = ناقل_ويب.تي_إل_إس;
عام مرادف http_transport.tcp_async = ناقل_ويب.تي_سي_بي_غير_متزامن;
عام مرادف http_transport_read = اقرأ_ناقل_ويب;
عام مرادف http_transport_write = اكتب_ناقل_ويب;
عام مرادف http_transport_close = أغلق_ناقل_ويب;
