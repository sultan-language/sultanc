// Mapping between std.http's request/response model (shared with HTTP/1)
// and HTTP/2 header lists (RFC 9113 8.2-8.3): pseudo-header fields,
// lowercase field names and the connection-specific fields HTTP/2 forbids.

استورد text.from_bytes;
استورد text.number;
استورد http.model;

عرف نصان_متساويان_مشترك_ويب2(أ: &نص, ب: &نص): منطقي {
    إذا (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { إذا ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

عام عرف يساوي_نصا_ويب2(القيمة: &نص, الحرفي: نص): منطقي {
    أرجع نصان_متساويان_مشترك_ويب2(القيمة, &الحرفي);
}

// ASCII lowercase (field names are lowercase in HTTP/2, 8.2.1).
عام عرف اسم_صغير_ويب2(الاسم: &نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الاسم) مثل طبيعي)) {
        دع ب: متغير ط8 = (*الاسم)[ف];
        إذا (ب >= 0x41 && ب <= 0x5A) { ب := ب + 0x20; };
        ألحق(الناتج, ب);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

// Connection-specific fields (8.2.2) never travel in HTTP/2.
عام عرف حقل_اتصال_ويب2(الاسم: &نص): منطقي {
    أرجع يساوي_نصا_ويب2(الاسم, «connection») || يساوي_نصا_ويب2(الاسم, «keep-alive»)
        || يساوي_نصا_ويب2(الاسم, «proxy-connection») || يساوي_نصا_ويب2(الاسم, «transfer-encoding»)
        || يساوي_نصا_ويب2(الاسم, «upgrade»);
}

// A received field name: nonempty, lowercase, no separators (8.2.1).
عام عرف اسم_حقل_صالح_ويب2(الاسم: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    إذا ((*الاسم)[0] == 0x3A) { ف := 1; };
    طالما (ف < العدد) {
        دع ب: ط8 = (*الاسم)[ف];
        إذا (ب <= 0x20 || ب >= 0x7F || (ب >= 0x41 && ب <= 0x5A) || ب == 0x3A) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// A received field value: no NUL, CR or LF, no leading or trailing space (8.2.1).
عام عرف قيمة_حقل_صالحة_ويب2(القيمة: &نص): منطقي {
    دع العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا (ب == 0 || ب == 0x0A || ب == 0x0D) { أرجع خطأ; };
        ف := ف + 1;
    }
    إذا (العدد > 0 && ((*القيمة)[0] == 0x20 || (*القيمة)[0] == 0x09 || (*القيمة)[العدد - 1] == 0x20 || (*القيمة)[العدد - 1] == 0x09)) {
        أرجع خطأ;
    };
    أرجع صواب;
}

عام عرف رأس_ويب2(الاسم: نص, القيمة: نص): رأس_ويب {
    دع الرأس: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
    أرجع الرأس;
}

// The model's fields as HTTP/2 regular fields: lowercase names, without
// connection-specific fields and Host (carried by :authority), TE only as
// "trailers" (8.2.2).
عام عرف حقول_عادية_ويب2(الرؤوس: &متجه رأس_ويب, القائمة: &متغير متجه رأس_ويب): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرؤوس) مثل طبيعي)) {
        دع الاسم: نص = اسم_صغير_ويب2(&(*الرؤوس)[ف].الاسم);
        دع يتخطى: متغير منطقي = حقل_اتصال_ويب2(&الاسم) || يساوي_نصا_ويب2(&الاسم, «host»)
            || (الطول(الاسم) مثل طبيعي) == 0 || الاسم[0] == 0x3A;
        إذا (يساوي_نصا_ويب2(&الاسم, «te») && !يساوي_نصا_ويب2(&(*الرؤوس)[ف].القيمة, «trailers»)) { يتخطى := صواب; };
        إذا (!يتخطى) { ألحق(*القائمة, رأس_ويب2(الاسم, انسخ_نص(&(*الرؤوس)[ف].القيمة))); };
        ف := ف + 1;
    }
}

عام عرف يحتوي_حقلا_ويب2(الرؤوس: &متجه رأس_ويب, الاسم: نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرؤوس) مثل طبيعي)) {
        دع الصغير: نص = اسم_صغير_ويب2(&(*الرؤوس)[ف].الاسم);
        إذا (نصان_متساويان_مشترك_ويب2(&الصغير, &الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عام مرادف http2_lowercase_name = اسم_صغير_ويب2;
عام مرادف http2_connection_specific_field = حقل_اتصال_ويب2;
