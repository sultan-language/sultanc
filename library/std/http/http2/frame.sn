// HTTP/2 frames (RFC 9113 4, 6): the nine-octet frame header, the frame
// types, flags, error codes and settings identifiers, and the payload
// layouts of the fixed-size frames.

عام نوع إطار_ويب2 = {
    النوع: طبيعي,
    الأعلام: طبيعي,
    التيار: طبيعي,
    الحمولة: متجه ط8
};

// Frame types (6).
عام عرف إطار_بيانات_ويب2(): طبيعي { أرجع 0; }
عام عرف إطار_رؤوس_ويب2(): طبيعي { أرجع 1; }
عام عرف إطار_أولوية_ويب2(): طبيعي { أرجع 2; }
عام عرف إطار_إلغاء_تيار_ويب2(): طبيعي { أرجع 3; }
عام عرف إطار_إعدادات_ويب2(): طبيعي { أرجع 4; }
عام عرف إطار_وعد_دفع_ويب2(): طبيعي { أرجع 5; }
عام عرف إطار_نبض_ويب2(): طبيعي { أرجع 6; }
عام عرف إطار_وداع_ويب2(): طبيعي { أرجع 7; }
عام عرف إطار_تحديث_نافذة_ويب2(): طبيعي { أرجع 8; }
عام عرف إطار_استمرار_ويب2(): طبيعي { أرجع 9; }

// Flags.
عام عرف علم_نهاية_التيار_ويب2(): طبيعي { أرجع 0x1; }
عام عرف علم_تأكيد_ويب2(): طبيعي { أرجع 0x1; }
عام عرف علم_نهاية_الرؤوس_ويب2(): طبيعي { أرجع 0x4; }
عام عرف علم_حشو_ويب2(): طبيعي { أرجع 0x8; }
عام عرف علم_أولوية_ويب2(): طبيعي { أرجع 0x20; }

// Error codes (7).
عام عرف رمز_بلا_خطأ_ويب2(): طبيعي { أرجع 0x0; }
عام عرف رمز_خطأ_بروتوكول_ويب2(): طبيعي { أرجع 0x1; }
عام عرف رمز_خطأ_داخلي_ويب2(): طبيعي { أرجع 0x2; }
عام عرف رمز_خطأ_تحكم_التدفق_ويب2(): طبيعي { أرجع 0x3; }
عام عرف رمز_مهلة_الإعدادات_ويب2(): طبيعي { أرجع 0x4; }
عام عرف رمز_تيار_مغلق_ويب2(): طبيعي { أرجع 0x5; }
عام عرف رمز_خطأ_حجم_الإطار_ويب2(): طبيعي { أرجع 0x6; }
عام عرف رمز_تيار_مرفوض_ويب2(): طبيعي { أرجع 0x7; }
عام عرف رمز_إلغاء_ويب2(): طبيعي { أرجع 0x8; }
عام عرف رمز_خطأ_ضغط_ويب2(): طبيعي { أرجع 0x9; }
عام عرف رمز_خطأ_اتصال_ويب2(): طبيعي { أرجع 0xA; }
عام عرف رمز_تمهل_ويب2(): طبيعي { أرجع 0xB; }
عام عرف رمز_أمان_غير_كاف_ويب2(): طبيعي { أرجع 0xC; }
عام عرف رمز_يلزم_ويب1_ويب2(): طبيعي { أرجع 0xD; }

// SETTINGS identifiers (6.5.2).
عام عرف إعداد_حجم_جدول_الرؤوس_ويب2(): طبيعي { أرجع 0x1; }
عام عرف إعداد_تفعيل_الدفع_ويب2(): طبيعي { أرجع 0x2; }
عام عرف إعداد_أقصى_تيارات_ويب2(): طبيعي { أرجع 0x3; }
عام عرف إعداد_النافذة_الأولية_ويب2(): طبيعي { أرجع 0x4; }
عام عرف إعداد_أقصى_إطار_ويب2(): طبيعي { أرجع 0x5; }
عام عرف إعداد_أقصى_قائمة_رؤوس_ويب2(): طبيعي { أرجع 0x6; }

// The connection preface a client sends first (3.4).
عام عرف مقدمة_ويب2(): متجه ط8 {
    دع المقدمة: متجه ط8 = [
        0x50, 0x52, 0x49, 0x20, 0x2A, 0x20, 0x48, 0x54, 0x54, 0x50, 0x2F, 0x32,
        0x2E, 0x30, 0x0D, 0x0A, 0x0D, 0x0A, 0x53, 0x4D, 0x0D, 0x0A, 0x0D, 0x0A
    ];
    أرجع المقدمة;
}

عام عرف كبير_ويب2(البايتات: &متجه ط8, الموضع: طبيعي, العدد: طبيعي): طبيعي {
    دع الناتج: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        الناتج := (الناتج << 8) | ((*البايتات)[الموضع + ف] مثل طبيعي);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ألحق_كبير_ويب2(الناتج: &متغير متجه ط8, القيمة: طبيعي, العدد: طبيعي): فراغ {
    دع ف: متغير طبيعي = العدد;
    طالما (ف > 0) {
        ف := ف - 1;
        ألحق(*الناتج, ((القيمة >> (8 * ف)) & 0xFF) مثل ط8);
    }
}

// Appends one frame: header (4.1) then payload.
عام عرف ألحق_إطار_ويب2(
    الناتج: &متغير متجه ط8,
    النوع: طبيعي,
    الأعلام: طبيعي,
    التيار: طبيعي,
    الحمولة: &متجه ط8,
    البداية: طبيعي,
    العدد: طبيعي
): فراغ {
    ألحق_كبير_ويب2(الناتج, العدد, 3);
    ألحق(*الناتج, النوع مثل ط8);
    ألحق(*الناتج, الأعلام مثل ط8);
    ألحق_كبير_ويب2(الناتج, التيار & 0x7FFFFFFF, 4);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(*الناتج, (*الحمولة)[البداية + ف]); ف := ف + 1; }
}

// A SETTINGS payload from identifier/value pairs.
عام عرف حمولة_إعدادات_ويب2(المعرفات: &متجه طبيعي, القيم: &متجه طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المعرفات) مثل طبيعي)) {
        ألحق_كبير_ويب2(&متغير الناتج, (*المعرفات)[ف], 2);
        ألحق_كبير_ويب2(&متغير الناتج, (*القيم)[ف], 4);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف حمولة_أربعة_ويب2(القيمة: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_كبير_ويب2(&متغير الناتج, القيمة, 4);
    أرجع الناتج;
}

عام عرف حمولة_وداع_ويب2(آخر_تيار: طبيعي, الرمز: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    ألحق_كبير_ويب2(&متغير الناتج, آخر_تيار & 0x7FFFFFFF, 4);
    ألحق_كبير_ويب2(&متغير الناتج, الرمز, 4);
    أرجع الناتج;
}

عام نوع http2_frame = إطار_ويب2;
عام مرادف http2_preface = مقدمة_ويب2;
عام مرادف http2_append_frame = ألحق_إطار_ويب2;
عام مرادف http2_settings_payload = حمولة_إعدادات_ويب2;
