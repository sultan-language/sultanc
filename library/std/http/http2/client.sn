// The HTTP/2 client (RFC 9113 8, Go's x/net/http2 Transport): h2 over TLS
// negotiated with ALPN, or h2c with prior knowledge over plain TCP (3.3);
// requests and responses use std.http's model shared with HTTP/1, with
// الإصدار = اثنان. Several requests sent together travel as concurrent
// streams on one connection, within the peer's SETTINGS_MAX_CONCURRENT_STREAMS
// and both flow-control windows.

استورد io.writer;
استورد text.from_bytes;
استورد text.number;
استورد http.model;
استورد http.client;
استورد tls.config;
استورد http.transport;
استورد http.http2.frame;
استورد http.http2.connection;
استورد http.http2.common;

عام نوع خطأ_عميل_ويب2 =
    | عميل بنوع خطأ_عميل_ويب
    | ويب2 بنوع خطأ_ويب2
    | بروتوكول_غير_متفاوض
    | استجابة_غير_صالحة
;

عام نوع اتصال_عميل_ويب2 = {
    الاتصال: اتصال_ويب2,
    السلطة: نص,
    المخطط: نص
};

// Starts HTTP/2 on an open transport: the preface, our SETTINGS, then the
// server's SETTINGS (3.4).
عام عرف ابدأ_عميل_ويب2(الناقل: ناقل_ويب, السلطة: &نص, آمن: منطقي, الحدود: &حدود_ويب2): نتيجة اتصال_عميل_ويب2, خطأ_عميل_ويب2 {
    دع المقروء: متجه ط8 = [];
    دع الاتصال: متغير اتصال_ويب2 = أنشئ_اتصال_ويب2(الناقل, خطأ, الحدود, المقروء);
    دع المقدمة: متجه ط8 = مقدمة_ويب2();
    طابق اكتب_الكل(&الاتصال.الناقل, اكتب_ناقل_ويب, &المقدمة) مع
    | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال); أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خطأ_ويب2.شبكة(الخطأ))); }
    | نتيجة.نجح(_) -> { };
    طابق أرسل_إعدادات_ويب2(&متغير الاتصال) مع
    | نتيجة.خطأ(خ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال); أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خ)); }
    | نتيجة.نجح(_) -> { };
    طالما (!الاتصال.إعدادات_مستلمة) {
        طابق اقرأ_وعالج_إطار_ويب2(&متغير الاتصال) مع
        | نتيجة.خطأ(خ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال); أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خ)); }
        | نتيجة.نجح(_) -> { };
    }
    دع المخطط: متغير نص = «http»;
    إذا (آمن) { المخطط := «https»; };
    دع العميل: اتصال_عميل_ويب2 = { الاتصال: الاتصال, السلطة: انسخ_نص(السلطة), المخطط: المخطط };
    أرجع نتيجة.نجح(العميل);
}

// Connects to an http:// (h2c, prior knowledge) or https:// (ALPN "h2") URL.
عام عرف اتصل_عميل_ويب2(الرابط: &نص): نتيجة اتصال_عميل_ويب2, خطأ_عميل_ويب2 {
    أرجع اتصل_عميل_ويب2_بإعداد(الرابط, اختياري.لا_شيء());
}

// As اتصل_عميل_ويب2 with a TLS configuration for https URLs.
عام عرف اتصل_عميل_ويب2_بإعداد(الرابط: &نص, إعداد_الأمان: اختياري إعداد_عميل_تي_إل_إس): نتيجة اتصال_عميل_ويب2, خطأ_عميل_ويب2 {
    دع البروتوكولات: متجه نص = [«h2»];
    طابق افتح_ناقل_عميل_ويب_بإعداد(الرابط, &البروتوكولات, إعداد_الأمان) مع
    | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.عميل(خ)); }
    | نتيجة.نجح(المفتوح) -> {
        إذا (المفتوح.آمن) {
            دع h2: متغير منطقي = خطأ;
            طابق المفتوح.البروتوكول مع
            | اختياري.موجود(ب) -> { h2 := يساوي_نصا_ويب2(&ب, «h2»); }
            | اختياري.لا_شيء -> { };
            إذا (!h2) {
                طابق المفتوح مع
                | { الناقل: الناقل, السلطة: _, الهدف: _, آمن: _, البروتوكول: _ } -> {
                    دع تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل);
                };
                أرجع نتيجة.خطأ(خطأ_عميل_ويب2.بروتوكول_غير_متفاوض());
            };
        };
        دع الحدود: حدود_ويب2 = حدود_ويب2_افتراضية();
        طابق المفتوح مع
        | { الناقل: الناقل, السلطة: السلطة, الهدف: _, آمن: آمن, البروتوكول: _ } -> {
            أرجع ابدأ_عميل_ويب2(الناقل, &السلطة, آمن, &الحدود);
        };
    };
}

// The request's header list (8.3.1): :method, :scheme, :authority and :path
// first, then the regular fields.
عرف رؤوس_طلب_ويب2(الطلب: &طلب_ويب_مخزن, السلطة: &نص, المخطط: &نص): متجه رأس_ويب {
    دع القائمة: متغير متجه رأس_ويب = [];
    ألحق(القائمة, رأس_ويب2(«:method», انسخ_نص(&(*الطلب).الطريقة)));
    ألحق(القائمة, رأس_ويب2(«:scheme», انسخ_نص(المخطط)));
    ألحق(القائمة, رأس_ويب2(«:authority», انسخ_نص(السلطة)));
    دع المسار: متغير نص = انسخ_نص(&(*الطلب).الهدف);
    إذا ((الطول(المسار) مثل طبيعي) == 0) { المسار := «/»; };
    ألحق(القائمة, رأس_ويب2(«:path», المسار));
    حقول_عادية_ويب2(&(*الطلب).الرؤوس, &متغير القائمة);
    إذا ((الطول((*الطلب).الجسم) مثل طبيعي) > 0 && !يحتوي_حقلا_ويب2(&(*الطلب).الرؤوس, «content-length»)) {
        ألحق(القائمة, رأس_ويب2(«content-length», طبيعي_إلى_نص(الطول((*الطلب).الجسم) مثل طبيعي)));
    };
    أرجع القائمة;
}

// A response from a completed stream (8.3.2).
عرف استجابة_من_تيار_ويب2(التيار: &متغير تيار_ويب2): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب2 {
    دع الحالة: متغير طبيعي = 0;
    دع الرؤوس: متغير متجه رأس_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التيار).الرؤوس) مثل طبيعي)) {
        دع الاسم: &نص = &(*التيار).الرؤوس[ف].الاسم;
        إذا (!اسم_حقل_صالح_ويب2(الاسم) || !قيمة_حقل_صالحة_ويب2(&(*التيار).الرؤوس[ف].القيمة)) {
            أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة());
        };
        إذا ((*الاسم)[0] == 0x3A) {
            إذا (!يساوي_نصا_ويب2(الاسم, «:status») || الحالة != 0 || (الطول(الرؤوس) مثل طبيعي) > 0) {
                أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة());
            };
            طابق حلل_طبيعي(&(*التيار).الرؤوس[ف].القيمة) مع
            | نتيجة.نجح(ق) -> { الحالة := ق; }
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); };
            إذا (الحالة < 100 || الحالة > 999) { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); };
        } وإلا {
            ألحق(الرؤوس, رأس_ويب2(انسخ_نص(الاسم), انسخ_نص(&(*التيار).الرؤوس[ف].القيمة)));
        };
        ف := ف + 1;
    }
    إذا (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); };
    دع اللاحقة: متغير متجه رأس_ويب = [];
    ف := 0;
    طالما (ف < (الطول((*التيار).الرؤوس_اللاحقة) مثل طبيعي)) {
        دع الاسم: &نص = &(*التيار).الرؤوس_اللاحقة[ف].الاسم;
        إذا (!اسم_حقل_صالح_ويب2(الاسم) || (*الاسم)[0] == 0x3A) { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); };
        ألحق(اللاحقة, رأس_ويب2(انسخ_نص(الاسم), انسخ_نص(&(*التيار).الرؤوس_اللاحقة[ف].القيمة)));
        ف := ف + 1;
    }
    دع الجسم: متغير متجه ط8 = [];
    بدّل((*التيار).الجسم, الجسم);
    دع الاستجابة: استجابة_ويب_مخزنة = {
        الإصدار: إصدار_ويب.اثنان(),
        الحالة: الحالة,
        الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: اللاحقة,
        الجسم: الجسم
    };
    أرجع نتيجة.نجح(الاستجابة);
}

// Sends every request as its own stream, at most the peer's concurrent
// stream limit at a time, and returns the responses in request order.
عام عرف أرسل_طلبات_ويب2(
    العميل: &متغير اتصال_عميل_ويب2,
    الطلبات: &متجه طلب_ويب_مخزن
): نتيجة متجه استجابة_ويب_مخزنة, خطأ_عميل_ويب2 {
    دع العدد: طبيعي = الطول(*الطلبات) مثل طبيعي;
    دع المعرفات: متغير متجه طبيعي = [];
    دع التالي: متغير طبيعي = 0;
    طالما (صواب) {
        // Open streams while the peer allows more.
        دع النشطة: متغير طبيعي = 0;
        دع المنتهية: متغير طبيعي = 0;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المعرفات) مثل طبيعي)) {
            طابق موقع_تيار_ويب2(&(*العميل).الاتصال, المعرفات[ف]) مع
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خطأ_ويب2.تيار(رمز_تيار_مرفوض_ويب2()))); }
            | اختياري.موجود(م) -> {
                إذا ((*العميل).الاتصال.التيارات[م].ملغى) {
                    أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خطأ_ويب2.تيار((*العميل).الاتصال.التيارات[م].رمز_الإلغاء)));
                };
                إذا ((*العميل).الاتصال.التيارات[م].مغلق_بعيدا) { المنتهية := المنتهية + 1; } وإلا {
                    النشطة := النشطة + 1;
                    إذا ((*العميل).الاتصال.وداع_مستلم && المعرفات[ف] > (*العميل).الاتصال.آخر_معرف_وداع) {
                        أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خطأ_ويب2.وداع((*العميل).الاتصال.رمز_الوداع)));
                    };
                };
            };
            ف := ف + 1;
        }
        إذا (المنتهية == العدد) { اخرج_من_حلقة; };
        طالما (التالي < العدد && النشطة < (*العميل).الاتصال.أقصى_تيارات_النظير && !(*العميل).الاتصال.وداع_مستلم) {
            دع المعرف: طبيعي = افتح_تيار_ويب2(&متغير (*العميل).الاتصال);
            دع القائمة: متجه رأس_ويب = رؤوس_طلب_ويب2(&(*الطلبات)[التالي], &(*العميل).السلطة, &(*العميل).المخطط);
            دع بلا_جسم: منطقي = (الطول((*الطلبات)[التالي].الجسم) مثل طبيعي) == 0;
            طابق أرسل_رؤوس_ويب2(&متغير (*العميل).الاتصال, المعرف, &القائمة, بلا_جسم) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خ)); }
            | نتيجة.نجح(_) -> { };
            إذا (!بلا_جسم) { ضع_جسم_ويب2(&متغير (*العميل).الاتصال, المعرف, انسخ_بايتات(&(*الطلبات)[التالي].الجسم)); };
            ألحق(المعرفات, المعرف);
            التالي := التالي + 1;
            النشطة := النشطة + 1;
        }
        إذا ((*العميل).الاتصال.وداع_مستلم && التالي < العدد && النشطة == 0) {
            أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خطأ_ويب2.وداع((*العميل).الاتصال.رمز_الوداع)));
        };
        طابق ادفع_بيانات_ويب2(&متغير (*العميل).الاتصال) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خ)); }
        | نتيجة.نجح(_) -> { };
        طابق اقرأ_وعالج_إطار_ويب2(&متغير (*العميل).الاتصال) مع
        | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.ويب2(خ)); }
        | نتيجة.نجح(_) -> { };
    }
    دع الاستجابات: متغير متجه استجابة_ويب_مخزنة = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق موقع_تيار_ويب2(&(*العميل).الاتصال, المعرفات[ف]) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); }
        | اختياري.موجود(م) -> {
            دع الاستجابة: استجابة_ويب_مخزنة = استجابة_من_تيار_ويب2(&متغير (*العميل).الاتصال.التيارات[م])؟;
            (*العميل).الاتصال.التيارات[م].مخدوم := صواب;
            ألحق(الاستجابات, الاستجابة);
        };
        ف := ف + 1;
    }
    نظف_تيارات_ويب2(&متغير (*العميل).الاتصال);
    أرجع نتيجة.نجح(الاستجابات);
}

// One request on the connection.
عام عرف أرسل_طلب_ويب2(
    العميل: &متغير اتصال_عميل_ويب2,
    الطريقة: &نص,
    المسار: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه ط8
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب2 {
    دع لا_لاحقة: متجه رأس_ويب = [];
    دع الطلب: طلب_ويب_مخزن = {
        الطريقة: انسخ_نص(الطريقة),
        الهدف: انسخ_نص(المسار),
        الإصدار: إصدار_ويب.اثنان(),
        الرؤوس: انسخ_رؤوس_ويب2(الرؤوس),
        الرؤوس_اللاحقة: لا_لاحقة,
        الجسم: انسخ_بايتات(الجسم),
        العنوان_البعيد: «»,
        السياق: سياق_طلب_ويب_فارغ()
    };
    دع الطلبات: متغير متجه طلب_ويب_مخزن = [];
    ألحق(الطلبات, الطلب);
    دع الاستجابات: متغير متجه استجابة_ويب_مخزنة = أرسل_طلبات_ويب2(العميل, &الطلبات)؟;
    طابق أزل_الأخير(الاستجابات) مع
    | اختياري.موجود(الاستجابة) -> { أرجع نتيجة.نجح(الاستجابة); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب2.استجابة_غير_صالحة()); };
}

عرف انسخ_رؤوس_ويب2(الرؤوس: &متجه رأس_ويب): متجه رأس_ويب {
    دع الناتج: متغير متجه رأس_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الرؤوس) مثل طبيعي)) {
        ألحق(الناتج, رأس_ويب2(انسخ_نص(&(*الرؤوس)[ف].الاسم), انسخ_نص(&(*الرؤوس)[ف].القيمة)));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// GOAWAY (NO_ERROR), then the transport is closed.
عام عرف أغلق_عميل_ويب2(العميل: اتصال_عميل_ويب2): نتيجة عدد, عدد {
    طابق العميل مع
    | { الاتصال: الاتصال, السلطة: _, المخطط: _ } -> {
        دع الحالة: متغير اتصال_ويب2 = الاتصال;
        ودع_اتصال_ويب2(&متغير الحالة);
        أرجع أغلق_اتصال_ويب2(الحالة);
    };
}

عام مرادف http2_client_error = خطأ_عميل_ويب2;
عام نوع http2_client_connection = اتصال_عميل_ويب2;
عام مرادف http2_connect = اتصل_عميل_ويب2;
عام مرادف http2_connect_with_tls = اتصل_عميل_ويب2_بإعداد;
عام مرادف http2_start_client = ابدأ_عميل_ويب2;
عام مرادف http2_send_requests = أرسل_طلبات_ويب2;
عام مرادف http2_send_request = أرسل_طلب_ويب2;
عام مرادف http2_close_client = أغلق_عميل_ويب2;
عام مرادف http2_client_error.client = خطأ_عميل_ويب2.عميل;
عام مرادف http2_client_error.http2 = خطأ_عميل_ويب2.ويب2;
عام مرادف http2_client_error.protocol_not_negotiated = خطأ_عميل_ويب2.بروتوكول_غير_متفاوض;
عام مرادف http2_client_error.invalid_response = خطأ_عميل_ويب2.استجابة_غير_صالحة;
