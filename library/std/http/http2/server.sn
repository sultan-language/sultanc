// The HTTP/2 server side of one connection (RFC 9113 8, Go's
// x/net/http2 Server): it reads the client preface, answers every complete
// request stream with the std.http service - the same خدمة_ويب HTTP/1
// uses, with requests whose الإصدار is اثنان - and interleaves the
// responses' DATA within both flow-control windows. Malformed requests
// (8.1.1, 8.3.1) are reset with PROTOCOL_ERROR; CONNECT is answered 501.
// The server is sequential like std.http's HTTP/1 server: one service call
// at a time, while every open stream of the connection keeps progressing.

استورد text.from_bytes;
استورد text.number;
استورد http.model;
استورد http.transport;
استورد http.http2.frame;
استورد http.http2.connection;
استورد http.http2.common;

// A request from a completed stream; none means a malformed request.
عرف طلب_من_تيار_ويب2(التيار: &متغير تيار_ويب2): اختياري طلب_ويب_مخزن {
    دع الطريقة: متغير اختياري نص = اختياري.لا_شيء();
    دع المخطط: متغير اختياري نص = اختياري.لا_شيء();
    دع السلطة: متغير اختياري نص = اختياري.لا_شيء();
    دع المسار: متغير اختياري نص = اختياري.لا_شيء();
    دع الرؤوس: متغير متجه رأس_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*التيار).الرؤوس) مثل طبيعي)) {
        دع الاسم: &نص = &(*التيار).الرؤوس[ف].الاسم;
        دع القيمة: &نص = &(*التيار).الرؤوس[ف].القيمة;
        لو (!اسم_حقل_صالح_ويب2(الاسم) || !قيمة_حقل_صالحة_ويب2(القيمة)) { أرجع اختياري.لا_شيء(); };
        لو ((*الاسم)[0] == 0x3A) {
            // Pseudo-header fields come first, once each (8.3).
            لو ((الطول(الرؤوس) مثل طبيعي) > 0) { أرجع اختياري.لا_شيء(); };
            لو (يساوي_نصا_ويب2(الاسم, «:method»)) {
                طابق الطريقة مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
                الطريقة := اختياري.موجود(انسخ_نص(القيمة));
            } وإلا لو (يساوي_نصا_ويب2(الاسم, «:scheme»)) {
                طابق المخطط مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
                المخطط := اختياري.موجود(انسخ_نص(القيمة));
            } وإلا لو (يساوي_نصا_ويب2(الاسم, «:authority»)) {
                طابق السلطة مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
                السلطة := اختياري.موجود(انسخ_نص(القيمة));
            } وإلا لو (يساوي_نصا_ويب2(الاسم, «:path»)) {
                طابق المسار مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
                لو ((الطول(*القيمة) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
                المسار := اختياري.موجود(انسخ_نص(القيمة));
            } وإلا {
                أرجع اختياري.لا_شيء();
            };
        } وإلا {
            لو (حقل_اتصال_ويب2(الاسم)) { أرجع اختياري.لا_شيء(); };
            لو (يساوي_نصا_ويب2(الاسم, «te») && !يساوي_نصا_ويب2(القيمة, «trailers»)) { أرجع اختياري.لا_شيء(); };
            ألحق(الرؤوس, رأس_ويب2(انسخ_نص(الاسم), انسخ_نص(القيمة)));
        };
        ف := ف + 1;
    }
    دع الطريقة_: متغير نص = «»;
    طابق الطريقة مع
    | اختياري.موجود(ق) -> { الطريقة_ := ق; }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    دع الهدف: متغير نص = «»;
    لو (يساوي_نصا_ويب2(&الطريقة_, «CONNECT»)) {
        // CONNECT carries only :method and :authority (8.5).
        طابق المخطط مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
        طابق المسار مع | اختياري.موجود(_) -> { أرجع اختياري.لا_شيء(); } | اختياري.لا_شيء -> { };
        طابق السلطة مع
        | اختياري.موجود(ق) -> { الهدف := ق; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        السلطة := اختياري.موجود(انسخ_نص(&الهدف));
    } وإلا {
        طابق المخطط مع | اختياري.موجود(_) -> { } | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
        طابق المسار مع
        | اختياري.موجود(ق) -> { الهدف := ق; }
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
    };
    // :authority stands for Host (8.3.1).
    طابق السلطة مع
    | اختياري.موجود(ق) -> {
        لو (!يحتوي_حقلا_ويب2(&الرؤوس, «host»)) { ألحق(الرؤوس, رأس_ويب2(«host», ق)); };
    }
    | اختياري.لا_شيء -> { };
    // content-length must match the DATA received (8.1.1).
    دع ك: متغير طبيعي = 0;
    طالما (ك < (الطول(الرؤوس) مثل طبيعي)) {
        لو (يساوي_نصا_ويب2(&الرؤوس[ك].الاسم, «content-length»)) {
            طابق حلل_طبيعي(&الرؤوس[ك].القيمة) مع
            | نتيجة.نجح(ق) -> { لو (ق != (الطول((*التيار).الجسم) مثل طبيعي)) { أرجع اختياري.لا_شيء(); }; }
            | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
        };
        ك := ك + 1;
    }
    دع اللاحقة: متغير متجه رأس_ويب = [];
    ف := 0;
    طالما (ف < (الطول((*التيار).الرؤوس_اللاحقة) مثل طبيعي)) {
        دع الاسم: &نص = &(*التيار).الرؤوس_اللاحقة[ف].الاسم;
        لو (!اسم_حقل_صالح_ويب2(الاسم) || (*الاسم)[0] == 0x3A) { أرجع اختياري.لا_شيء(); };
        ألحق(اللاحقة, رأس_ويب2(انسخ_نص(الاسم), انسخ_نص(&(*التيار).الرؤوس_اللاحقة[ف].القيمة)));
        ف := ف + 1;
    }
    دع الجسم: متغير متجه ط8 = [];
    بدّل((*التيار).الجسم, الجسم);
    دع الطلب: طلب_ويب_مخزن = {
        الطريقة: الطريقة_,
        الهدف: الهدف,
        الإصدار: إصدار_ويب.اثنان(),
        الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: اللاحقة,
        الجسم: الجسم
    };
    أرجع اختياري.موجود(الطلب);
}

// Sends a response on a stream: HEADERS, then the body as DATA (8.3.2).
عرف أرسل_استجابة_ويب2(
    الاتصال: &متغير اتصال_ويب2,
    المعرف: طبيعي,
    الاستجابة: استجابة_ويب_مخزنة,
    رأسي: منطقي
): نتيجة طبيعي, خطأ_ويب2 {
    دع القائمة: متغير متجه رأس_ويب = [];
    دع الحالة: متغير طبيعي = الاستجابة.الحالة;
    لو (الحالة < 200 || الحالة > 999) { الحالة := 500; };
    ألحق(القائمة, رأس_ويب2(«:status», طبيعي_إلى_نص(الحالة)));
    حقول_عادية_ويب2(&الاستجابة.الرؤوس, &متغير القائمة);
    دع الحجم: طبيعي = الطول(الاستجابة.الجسم) مثل طبيعي;
    لو (الحجم > 0 && !يحتوي_حقلا_ويب2(&الاستجابة.الرؤوس, «content-length»)) {
        ألحق(القائمة, رأس_ويب2(«content-length», طبيعي_إلى_نص(الحجم)));
    };
    دع بلا_جسم: منطقي = الحجم == 0 || رأسي || الحالة == 204 || الحالة == 304;
    أرسل_رؤوس_ويب2(الاتصال, المعرف, &القائمة, بلا_جسم)؟;
    لو (!بلا_جسم) {
        طابق الاستجابة مع
        | { الإصدار: _, الحالة: _, الرؤوس: _, الرؤوس_اللاحقة: _, الجسم: الجسم } -> {
            ضع_جسم_ويب2(الاتصال, المعرف, الجسم);
        };
    };
    أرجع نتيجة.نجح(0);
}

// Serves one HTTP/2 connection until the client closes it or sends GOAWAY
// and its streams finish. المقروء holds bytes already read from the
// transport (the preface detected by the HTTP/1 server). Returns the number
// of requests served; the transport is closed.
عام عرف خدم_اتصال_ويب2<S>(
    الناقل: ناقل_ويب,
    المقروء: متجه ط8,
    الحدود: &حدود_ويب2,
    الحالة: &S,
    الخدمة: خدمة_ويب<S, متجه ط8, متجه ط8>
): نتيجة عدد, خطأ_ويب2 {
    دع الاتصال: متغير اتصال_ويب2 = أنشئ_اتصال_ويب2(الناقل, صواب, الحدود, المقروء);
    دع المخدومة: متغير عدد = 0;
    طابق أرسل_إعدادات_ويب2(&متغير الاتصال) مع
    | نتيجة.خطأ(خ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال); أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_مقدمة_ويب2(&متغير الاتصال) مع
    | نتيجة.خطأ(خ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال); أرجع نتيجة.خطأ(خ); }
    | نتيجة.نجح(_) -> { };
    دع الخطأ_النهائي: متغير اختياري خطأ_ويب2 = اختياري.لا_شيء();
    طالما (صواب) {
        // Answer every complete request.
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الاتصال.التيارات) مثل طبيعي)) {
            دع المعرف: طبيعي = الاتصال.التيارات[ف].المعرف;
            لو (الاتصال.التيارات[ف].ملغى) {
                الاتصال.التيارات[ف].مخدوم := صواب;
            } وإلا لو (!الاتصال.التيارات[ف].مخدوم && الاتصال.التيارات[ف].رؤوس_مستلمة && الاتصال.التيارات[ف].مغلق_بعيدا) {
                الاتصال.التيارات[ف].مخدوم := صواب;
                طابق طلب_من_تيار_ويب2(&متغير الاتصال.التيارات[ف]) مع
                | اختياري.لا_شيء -> {
                    طابق ألغ_تيار_ويب2(&متغير الاتصال, المعرف, رمز_خطأ_بروتوكول_ويب2()) مع
                    | نتيجة.خطأ(خ) -> { الخطأ_النهائي := اختياري.موجود(خ); اخرج_من_حلقة; }
                    | نتيجة.نجح(_) -> { };
                }
                | اختياري.موجود(الطلب) -> {
                    دع رأسي: منطقي = يساوي_نصا_ويب2(&الطلب.الطريقة, «HEAD»);
                    دع الاستجابة: متغير استجابة_ويب_مخزنة = استجابة_ويب_مخزنة_فارغة_ويب2(501);
                    لو (!يساوي_نصا_ويب2(&الطلب.الطريقة, «CONNECT»)) {
                        الاستجابة := الخدمة(الحالة, &الطلب);
                    };
                    الاستجابة.الإصدار := إصدار_ويب.اثنان();
                    طابق أرسل_استجابة_ويب2(&متغير الاتصال, المعرف, الاستجابة, رأسي) مع
                    | نتيجة.خطأ(خ) -> { الخطأ_النهائي := اختياري.موجود(خ); اخرج_من_حلقة; }
                    | نتيجة.نجح(_) -> { };
                    المخدومة := المخدومة + 1;
                };
            };
            ف := ف + 1;
        }
        طابق الخطأ_النهائي مع | اختياري.موجود(_) -> { اخرج_من_حلقة; } | اختياري.لا_شيء -> { };
        طابق ادفع_بيانات_ويب2(&متغير الاتصال) مع
        | نتيجة.خطأ(خ) -> { الخطأ_النهائي := اختياري.موجود(خ); اخرج_من_حلقة; }
        | نتيجة.نجح(_) -> { };
        نظف_تيارات_ويب2(&متغير الاتصال);
        لو (الاتصال.وداع_مستلم && (الطول(الاتصال.التيارات) مثل طبيعي) == 0) { اخرج_من_حلقة; };
        طابق اقرأ_وعالج_إطار_ويب2(&متغير الاتصال) مع
        | نتيجة.خطأ(خطأ_ويب2.نهاية_الاتصال) -> { اخرج_من_حلقة; }
        | نتيجة.خطأ(خ) -> { الخطأ_النهائي := اختياري.موجود(خ); اخرج_من_حلقة; }
        | نتيجة.نجح(_) -> { };
    }
    لو (!الاتصال.مغلق) { ودع_اتصال_ويب2(&متغير الاتصال); };
    دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_ويب2(الاتصال);
    طابق الخطأ_النهائي مع
    | اختياري.موجود(خ) -> { أرجع نتيجة.خطأ(خ); }
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(المخدومة); };
}

عرف استجابة_ويب_مخزنة_فارغة_ويب2(الحالة: طبيعي): استجابة_ويب_مخزنة {
    دع أ: متجه رأس_ويب = [];
    دع ب: متجه رأس_ويب = [];
    دع ج: متجه ط8 = [];
    دع الاستجابة: استجابة_ويب_مخزنة = { الإصدار: إصدار_ويب.اثنان(), الحالة: الحالة, الرؤوس: أ, الرؤوس_اللاحقة: ب, الجسم: ج };
    أرجع الاستجابة;
}

عام مرادف serve_http2_connection = خدم_اتصال_ويب2;
