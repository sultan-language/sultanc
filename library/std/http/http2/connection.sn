        أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
    };
    لو (النوع == إطار_نبض_ويب2()) {
        لو (المعرف != 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        لو (الطول_ != 8) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
        لو (((*الإطار).الأعلام & علم_تأكيد_ويب2()) == 0) {
            اكتب_إطار_ويب2(الاتصال, إطار_نبض_ويب2(), علم_تأكيد_ويب2(), 0, &(*الإطار).الحمولة)؟;
        };
        أرجع نتيجة.نجح(0);
    };
    لو (النوع == إطار_وداع_ويب2()) {
        لو (المعرف != 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        لو (الطول_ < 8) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
        (*الاتصال).وداع_مستلم := صواب;
        (*الاتصال).آخر_معرف_وداع := كبير_ويب2(&(*الإطار).الحمولة, 0, 4) & 0x7FFFFFFF;
        (*الاتصال).رمز_الوداع := كبير_ويب2(&(*الإطار).الحمولة, 4, 4);
        أرجع نتيجة.نجح(0);
    };
    لو (النوع == إطار_تحديث_نافذة_ويب2()) {
        لو (الطول_ != 4) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
        دع الزيادة: طبيعي = كبير_ويب2(&(*الإطار).الحمولة, 0, 4) & 0x7FFFFFFF;
        لو (المعرف == 0) {
            لو (الزيادة == 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
            دع الجديدة: عدد = (*الاتصال).نافذة_إرسال_الاتصال + (الزيادة مثل عدد);
            لو (الجديدة > 0x7FFFFFFF) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_تحكم_التدفق_ويب2())); };
            (*الاتصال).نافذة_إرسال_الاتصال := الجديدة;
            أرجع نتيجة.نجح(0);
        };
        طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
        | اختياري.موجود(ف) -> {
            لو (الزيادة == 0) { ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_بروتوكول_ويب2())؟; أرجع نتيجة.نجح(0); };
            دع الجديدة: عدد = (*الاتصال).التيارات[ف].نافذة_الإرسال + (الزيادة مثل عدد);
            لو (الجديدة > 0x7FFFFFFF) { ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_تحكم_التدفق_ويب2())؟; أرجع نتيجة.نجح(0); };
            (*الاتصال).التيارات[ف].نافذة_الإرسال := الجديدة;
        }
        | اختياري.لا_شيء -> {
            دع محلي: منطقي = (المعرف % 2 == 1) != (*الاتصال).خادم;
            لو ((محلي && المعرف >= (*الاتصال).المعرف_التالي) || (!محلي && المعرف > (*الاتصال).آخر_معرف_نظير)) {
                أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
            };
        };
        أرجع نتيجة.نجح(المعرف);
    };
    لو (النوع == إطار_استمرار_ويب2()) {
        أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
    };
    // Unknown frame types are ignored (4.1, 5.5).
    أرجع نتيجة.نجح(0);
}

عام عرف اقرأ_وعالج_إطار_ويب2(الاتصال: &متغير اتصال_ويب2): نتيجة طبيعي, خطأ_ويب2 {
    دع الإطار: إطار_ويب2 = اقرأ_إطار_ويب2(الاتصال)؟;
    أرجع عالج_إطار_ويب2(الاتصال, &الإطار);
}

// Removes streams that are closed both ways and already handed over.
عام عرف نظف_تيارات_ويب2(الاتصال: &متغير اتصال_ويب2): فراغ {
    دع القديمة: متغير متجه تيار_ويب2 = [];
    بدّل((*الاتصال).التيارات, القديمة);
    دع الباقية: متغير متجه تيار_ويب2 = [];
    طالما ((الطول(القديمة) مثل طبيعي) > 0) {
        طابق أزل_الأخير(القديمة) مع
        | اختياري.موجود(التيار) -> {
            لو (!(التيار.مخدوم && التيار.مغلق_محليا && التيار.مغلق_بعيدا)) { ألحق(الباقية, التيار); };
        }
        | اختياري.لا_شيء -> { };
    }
    // Restore the original order.
    طالما ((الطول(الباقية) مثل طبيعي) > 0) {
        طابق أزل_الأخير(الباقية) مع
        | اختياري.موجود(التيار) -> { ألحق((*الاتصال).التيارات, التيار); }
        | اختياري.لا_شيء -> { };
    }
}

عام عرف أغلق_اتصال_ويب2(الاتصال: اتصال_ويب2): نتيجة عدد, عدد {
    طابق الاتصال مع
    | { الناقل: الناقل, خادم: _, الحدود: _, المخزن: _, الموضع: _, مؤقت_القراءة: _, المفكك: _, المرمز: _,
        أقصى_إطار_النظير: _, نافذة_أولية_النظير: _, أقصى_تيارات_النظير: _, نافذة_إرسال_الاتصال: _,
        نافذة_استقبال_الاتصال: _, التيارات: _, آخر_معرف_نظير: _, المعرف_التالي: _, وداع_مستلم: _,
        آخر_معرف_وداع: _, رمز_الوداع: _, كتلة_معلقة: _, تيار_الكتلة: _, أعلام_الكتلة: _,
        إعدادات_مستلمة: _, مغلق: _ } -> { أرجع أغلق_ناقل_ويب(الناقل); };
}

