// An HTTP/2 connection (RFC 9113) shared by the client and the server: the
// frame reader, the stream table and its states (5.1), connection and
// stream flow control (5.2, 6.9), SETTINGS and their acknowledgement
// (6.5), PING (6.7), GOAWAY (6.8), RST_STREAM (6.4), header blocks over
// HEADERS and CONTINUATION (6.2, 6.10) through HPACK, and DATA (6.1).
//
// Like Go's x/net/http2 it is single-owner and synchronous: the caller
// alternates reading one frame (اقرأ_وعالج_إطار_ويب2) and pushing pending
// output (ادفع_بيانات_ويب2), so many streams progress on one connection.
// Limits (حدود_ويب2): the frame size this side accepts, the header list
// size, the header block size including CONTINUATION frames, the number of
// concurrent streams the peer may open and the body size of one stream.
// Violations end the connection with GOAWAY or the stream with RST_STREAM,
// with the error codes of RFC 9113 5.4.

استورد io.writer;
استورد text.from_bytes;
استورد http.model;
استورد http.transport;
استورد http.http2.frame;
استورد http.http2.hpack;

عام نوع خطأ_ويب2 =
    | اتصال بنوع طبيعي
    | تيار بنوع طبيعي
    | وداع بنوع طبيعي
    | شبكة بنوع عدد
    | نهاية_الاتصال
;

عام نوع حدود_ويب2 = {
    أقصى_إطار: طبيعي,
    أقصى_قائمة_رؤوس: طبيعي,
    أقصى_كتلة_رؤوس: طبيعي,
    أقصى_تيارات: طبيعي,
    النافذة_الأولية: طبيعي,
    أقصى_جسم: طبيعي
};

// Defaults close to Go's and nghttp2's: 16 KiB frames, a 64 KiB header
// list, 100 concurrent streams, 1 MiB windows and 16 MiB bodies.
عام عرف حدود_ويب2_افتراضية(): حدود_ويب2 {
    دع الحدود: حدود_ويب2 = {
        أقصى_إطار: 16384,
        أقصى_قائمة_رؤوس: 65536,
        أقصى_كتلة_رؤوس: 262144,
        أقصى_تيارات: 100,
        النافذة_الأولية: 1048576,
        أقصى_جسم: 16777216
    };
    أرجع الحدود;
}

عام نوع تيار_ويب2 = {
    المعرف: طبيعي,
    مغلق_محليا: منطقي,
    مغلق_بعيدا: منطقي,
    ملغى: منطقي,
    رمز_الإلغاء: طبيعي,
    نافذة_الإرسال: عدد,
    نافذة_الاستقبال: عدد,
    الرؤوس: متجه رأس_ويب,
    الرؤوس_اللاحقة: متجه رأس_ويب,
    رؤوس_مستلمة: منطقي,
    الجسم: متجه ط8,
    للإرسال: متجه ط8,
    موضع_الإرسال: طبيعي,
    إرسال_معلق: منطقي,
    مخدوم: منطقي
};

عام نوع اتصال_ويب2 = {
    الناقل: ناقل_ويب,
    خادم: منطقي,
    الحدود: حدود_ويب2,
    المخزن: متجه ط8,
    الموضع: طبيعي,
    مؤقت_القراءة: متجه ط8,
    المفكك: مفكك_إتش_باك,
    المرمز: مرمز_إتش_باك,
    أقصى_إطار_النظير: طبيعي,
    نافذة_أولية_النظير: عدد,
    أقصى_تيارات_النظير: طبيعي,
    نافذة_إرسال_الاتصال: عدد,
    نافذة_استقبال_الاتصال: عدد,
    التيارات: متجه تيار_ويب2,
    آخر_معرف_نظير: طبيعي,
    المعرف_التالي: طبيعي,
    وداع_مستلم: منطقي,
    آخر_معرف_وداع: طبيعي,
    رمز_الوداع: طبيعي,
    كتلة_معلقة: متجه ط8,
    تيار_الكتلة: طبيعي,
    أعلام_الكتلة: طبيعي,
    إعدادات_مستلمة: منطقي,
    مغلق: منطقي
};

عرف بايتات_فارغة_ويب2(العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

// A connection over a transport whose preface (if any) was already handled.
عام عرف أنشئ_اتصال_ويب2(الناقل: ناقل_ويب, خادم: منطقي, الحدود: &حدود_ويب2, المقروء: متجه ط8): اتصال_ويب2 {
    دع التيارات: متجه تيار_ويب2 = [];
    دع الكتلة: متجه ط8 = [];
    دع المعرف_الأول: متغير طبيعي = 1;
    لو (خادم) { المعرف_الأول := 2; };
    دع الاتصال: اتصال_ويب2 = {
        الناقل: الناقل,
        خادم: خادم,
        الحدود: *الحدود,
        المخزن: المقروء,
        الموضع: 0,
        مؤقت_القراءة: بايتات_فارغة_ويب2(16384),
        المفكك: أنشئ_مفكك_إتش_باك(4096),
        المرمز: أنشئ_مرمز_إتش_باك(),
        أقصى_إطار_النظير: 16384,
        نافذة_أولية_النظير: 65535,
        أقصى_تيارات_النظير: 0xFFFFFFFF,
        نافذة_إرسال_الاتصال: 65535,
        نافذة_استقبال_الاتصال: 65535,
        التيارات: التيارات,
        آخر_معرف_نظير: 0,
        المعرف_التالي: المعرف_الأول,
        وداع_مستلم: خطأ,
        آخر_معرف_وداع: 0,
        رمز_الوداع: 0,
        كتلة_معلقة: الكتلة,
        تيار_الكتلة: 0,
        أعلام_الكتلة: 0,
        إعدادات_مستلمة: خطأ,
        مغلق: خطأ
    };
    أرجع الاتصال;
}

// ---------------------------------------------------------------- output

عام عرف اكتب_إطار_ويب2(
    الاتصال: &متغير اتصال_ويب2,
    النوع: طبيعي,
    الأعلام: طبيعي,
    التيار: طبيعي,
    الحمولة: &متجه ط8
): نتيجة طبيعي, خطأ_ويب2 {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_إطار_ويب2(&متغير البايتات, النوع, الأعلام, التيار, الحمولة, 0, الطول(*الحمولة) مثل طبيعي);
    طابق اكتب_الكل(&(*الاتصال).الناقل, اكتب_ناقل_ويب, &البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.شبكة(الخطأ)); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
}

// Our SETTINGS (6.5) and the connection window raised to our limit.
عام عرف أرسل_إعدادات_ويب2(الاتصال: &متغير اتصال_ويب2): نتيجة طبيعي, خطأ_ويب2 {
    دع المعرفات: متغير متجه طبيعي = [];
    دع القيم: متغير متجه طبيعي = [];
    لو (!(*الاتصال).خادم) {
        ألحق(المعرفات, إعداد_تفعيل_الدفع_ويب2());
        ألحق(القيم, 0);
    };
    ألحق(المعرفات, إعداد_أقصى_تيارات_ويب2());
    ألحق(القيم, (*الاتصال).الحدود.أقصى_تيارات);
    ألحق(المعرفات, إعداد_النافذة_الأولية_ويب2());
    ألحق(القيم, (*الاتصال).الحدود.النافذة_الأولية);
    ألحق(المعرفات, إعداد_أقصى_إطار_ويب2());
    ألحق(القيم, (*الاتصال).الحدود.أقصى_إطار);
    ألحق(المعرفات, إعداد_أقصى_قائمة_رؤوس_ويب2());
    ألحق(القيم, (*الاتصال).الحدود.أقصى_قائمة_رؤوس);
    دع الحمولة: متجه ط8 = حمولة_إعدادات_ويب2(&المعرفات, &القيم);
    اكتب_إطار_ويب2(الاتصال, إطار_إعدادات_ويب2(), 0, 0, &الحمولة)؟;
    دع الأولية: طبيعي = (*الاتصال).الحدود.النافذة_الأولية;
    لو (الأولية > 65535) {
        دع الزيادة: متجه ط8 = حمولة_أربعة_ويب2(الأولية - 65535);
        اكتب_إطار_ويب2(الاتصال, إطار_تحديث_نافذة_ويب2(), 0, 0, &الزيادة)؟;
        (*الاتصال).نافذة_استقبال_الاتصال := الأولية مثل عدد;
    };
    أرجع نتيجة.نجح(0);
}

// A connection error (5.4.1): GOAWAY with the last peer stream, then closed.
عرف أفشل_اتصال_ويب2(الاتصال: &متغير اتصال_ويب2, الرمز: طبيعي): خطأ_ويب2 {
    لو (!(*الاتصال).مغلق) {
        دع الحمولة: متجه ط8 = حمولة_وداع_ويب2((*الاتصال).آخر_معرف_نظير, الرمز);
        دع تجاهل: نتيجة طبيعي, خطأ_ويب2 = اكتب_إطار_ويب2(الاتصال, إطار_وداع_ويب2(), 0, 0, &الحمولة);
        (*الاتصال).مغلق := صواب;
    };
    أرجع خطأ_ويب2.اتصال(الرمز);
}

// Sends GOAWAY with NO_ERROR (graceful shutdown, 6.8).
عام عرف ودع_اتصال_ويب2(الاتصال: &متغير اتصال_ويب2): فراغ {
    دع الحمولة: متجه ط8 = حمولة_وداع_ويب2((*الاتصال).آخر_معرف_نظير, رمز_بلا_خطأ_ويب2());
    دع تجاهل: نتيجة طبيعي, خطأ_ويب2 = اكتب_إطار_ويب2(الاتصال, إطار_وداع_ويب2(), 0, 0, &الحمولة);
}

عرف موضع_تيار_ويب2(الاتصال: &اتصال_ويب2, المعرف: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الاتصال).التيارات) مثل طبيعي)) {
        لو ((*الاتصال).التيارات[ف].المعرف == المعرف) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف موقع_تيار_ويب2(الاتصال: &اتصال_ويب2, المعرف: طبيعي): اختياري طبيعي {
    أرجع موضع_تيار_ويب2(الاتصال, المعرف);
}

// A stream error (5.4.2): RST_STREAM; the stream is closed both ways.
عام عرف ألغ_تيار_ويب2(الاتصال: &متغير اتصال_ويب2, المعرف: طبيعي, الرمز: طبيعي): نتيجة طبيعي, خطأ_ويب2 {
    دع الحمولة: متجه ط8 = حمولة_أربعة_ويب2(الرمز);
    اكتب_إطار_ويب2(الاتصال, إطار_إلغاء_تيار_ويب2(), 0, المعرف, &الحمولة)؟;
    طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
    | اختياري.موجود(ف) -> {
        (*الاتصال).التيارات[ف].ملغى := صواب;
        (*الاتصال).التيارات[ف].رمز_الإلغاء := الرمز;
        (*الاتصال).التيارات[ف].مغلق_محليا := صواب;
        (*الاتصال).التيارات[ف].مغلق_بعيدا := صواب;
        (*الاتصال).التيارات[ف].إرسال_معلق := خطأ;
    }
    | اختياري.لا_شيء -> { };
    أرجع نتيجة.نجح(0);
}

عرف تيار_ويب2_جديد(المعرف: طبيعي, نافذة_الإرسال: عدد, نافذة_الاستقبال: عدد): تيار_ويب2 {
    دع أ: متجه رأس_ويب = [];
    دع ب: متجه رأس_ويب = [];
    دع ج: متجه ط8 = [];
    دع د: متجه ط8 = [];
    دع التيار: تيار_ويب2 = {
        المعرف: المعرف,
        مغلق_محليا: خطأ,
        مغلق_بعيدا: خطأ,
        ملغى: خطأ,
        رمز_الإلغاء: 0,
        نافذة_الإرسال: نافذة_الإرسال,
        نافذة_الاستقبال: نافذة_الاستقبال,
        الرؤوس: أ,
        الرؤوس_اللاحقة: ب,
        رؤوس_مستلمة: خطأ,
        الجسم: ج,
        للإرسال: د,
        موضع_الإرسال: 0,
        إرسال_معلق: خطأ,
        مخدوم: خطأ
    };
    أرجع التيار;
}

// Opens a locally initiated stream and returns its identifier (5.1.1).
عام عرف افتح_تيار_ويب2(الاتصال: &متغير اتصال_ويب2): طبيعي {
    دع المعرف: طبيعي = (*الاتصال).المعرف_التالي;
    (*الاتصال).المعرف_التالي := المعرف + 2;
    دع التيار: تيار_ويب2 = تيار_ويب2_جديد(المعرف, (*الاتصال).نافذة_أولية_النظير, (*الاتصال).الحدود.النافذة_الأولية مثل عدد);
    ألحق((*الاتصال).التيارات, التيار);
    أرجع المعرف;
}

// Sends a header list as HEADERS plus CONTINUATION frames no larger than
// the peer's SETTINGS_MAX_FRAME_SIZE (6.2, 6.10, 4.3).
عام عرف أرسل_رؤوس_ويب2(
    الاتصال: &متغير اتصال_ويب2,
    المعرف: طبيعي,
    الرؤوس: &متجه رأس_ويب,
    نهاية_التيار: منطقي
): نتيجة طبيعي, خطأ_ويب2 {
    دع الكتلة: متجه ط8 = رمز_رؤوس_إتش_باك(&متغير (*الاتصال).المرمز, الرؤوس);
    دع الحجم: طبيعي = الطول(الكتلة) مثل طبيعي;
    دع الأقصى: طبيعي = (*الاتصال).أقصى_إطار_النظير;
    دع البايتات: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    دع أول: متغير منطقي = صواب;
    طالما (أول || الموضع < الحجم) {
        دع الجزء: متغير طبيعي = الحجم - الموضع;
        لو (الجزء > الأقصى) { الجزء := الأقصى; };
        دع الأعلام: متغير طبيعي = 0;
        لو (الموضع + الجزء == الحجم) { الأعلام := علم_نهاية_الرؤوس_ويب2(); };
        لو (أول) {
            لو (نهاية_التيار) { الأعلام := الأعلام | علم_نهاية_التيار_ويب2(); };
            ألحق_إطار_ويب2(&متغير البايتات, إطار_رؤوس_ويب2(), الأعلام, المعرف, &الكتلة, الموضع, الجزء);
        } وإلا {
            ألحق_إطار_ويب2(&متغير البايتات, إطار_استمرار_ويب2(), الأعلام, المعرف, &الكتلة, الموضع, الجزء);
        };
        أول := خطأ;
        الموضع := الموضع + الجزء;
    }
    طابق اكتب_الكل(&(*الاتصال).الناقل, اكتب_ناقل_ويب, &البايتات) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.شبكة(الخطأ)); }
    | نتيجة.نجح(_) -> { };
    لو (نهاية_التيار) {
        طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
        | اختياري.موجود(ف) -> { (*الاتصال).التيارات[ف].مغلق_محليا := صواب; }
        | اختياري.لا_شيء -> { };
    };
    أرجع نتيجة.نجح(0);
}

// Queues a body for a stream; ادفع_بيانات_ويب2 sends it as the windows allow
// and ends the stream after it.
عام عرف ضع_جسم_ويب2(الاتصال: &متغير اتصال_ويب2, المعرف: طبيعي, الجسم: متجه ط8): فراغ {
    طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
    | اختياري.موجود(ف) -> {
        (*الاتصال).التيارات[ف].للإرسال := الجسم;
        (*الاتصال).التيارات[ف].موضع_الإرسال := 0;
        (*الاتصال).التيارات[ف].إرسال_معلق := صواب;
    }
    | اختياري.لا_شيء -> { };
}

// Sends queued DATA within the connection and stream send windows and the
// peer's frame size (5.2, 6.9.1). Returns whether data is still queued.
عام عرف ادفع_بيانات_ويب2(الاتصال: &متغير اتصال_ويب2): نتيجة منطقي, خطأ_ويب2 {
    دع معلق: متغير منطقي = خطأ;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الاتصال).التيارات) مثل طبيعي)) {
        طالما ((*الاتصال).التيارات[ف].إرسال_معلق && !(*الاتصال).التيارات[ف].ملغى) {
            دع الحجم: طبيعي = الطول((*الاتصال).التيارات[ف].للإرسال) مثل طبيعي;
            دع الموضع: طبيعي = (*الاتصال).التيارات[ف].موضع_الإرسال;
            دع الباقي: طبيعي = الحجم - الموضع;
            دع المسموح: متغير عدد = (*الاتصال).نافذة_إرسال_الاتصال;
            لو ((*الاتصال).التيارات[ف].نافذة_الإرسال < المسموح) { المسموح := (*الاتصال).التيارات[ف].نافذة_الإرسال; };
            لو (المسموح > ((*الاتصال).أقصى_إطار_النظير مثل عدد)) { المسموح := (*الاتصال).أقصى_إطار_النظير مثل عدد; };
            لو (الباقي > 0 && المسموح <= 0) { معلق := صواب; اخرج_من_حلقة; };
            دع الجزء: متغير طبيعي = الباقي;
            لو (المسموح >= 0 && (الجزء مثل عدد) > المسموح) { الجزء := المسموح مثل طبيعي; };
            دع الأعلام: متغير طبيعي = 0;
            لو (الموضع + الجزء == الحجم) { الأعلام := علم_نهاية_التيار_ويب2(); };
            ألحق_إطار_ويب2(&متغير البايتات, إطار_بيانات_ويب2(), الأعلام, (*الاتصال).التيارات[ف].المعرف,
                &(*الاتصال).التيارات[ف].للإرسال, الموضع, الجزء);
            (*الاتصال).التيارات[ف].موضع_الإرسال := الموضع + الجزء;
            (*الاتصال).نافذة_إرسال_الاتصال := (*الاتصال).نافذة_إرسال_الاتصال - (الجزء مثل عدد);
            (*الاتصال).التيارات[ف].نافذة_الإرسال := (*الاتصال).التيارات[ف].نافذة_الإرسال - (الجزء مثل عدد);
            لو (الأعلام != 0) {
                (*الاتصال).التيارات[ف].إرسال_معلق := خطأ;
                (*الاتصال).التيارات[ف].مغلق_محليا := صواب;
                دع فارغ: متجه ط8 = [];
                (*الاتصال).التيارات[ف].للإرسال := فارغ;
            };
            لو ((الطول(البايتات) مثل طبيعي) >= 65536) {
                طابق اكتب_الكل(&(*الاتصال).الناقل, اكتب_ناقل_ويب, &البايتات) مع
                | نتيجة.خطأ(الخطأ) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.شبكة(الخطأ)); }
                | نتيجة.نجح(_) -> { };
                دع جديد: متجه ط8 = [];
                البايتات := جديد;
            };
        }
        ف := ف + 1;
    }
    لو ((الطول(البايتات) مثل طبيعي) > 0) {
        طابق اكتب_الكل(&(*الاتصال).الناقل, اكتب_ناقل_ويب, &البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.شبكة(الخطأ)); }
        | نتيجة.نجح(_) -> { };
    };
    أرجع نتيجة.نجح(معلق);
}

// ---------------------------------------------------------------- input

// Ensures العدد unread bytes are buffered; false at end of input.
عرف املأ_مخزن_ويب2(الاتصال: &متغير اتصال_ويب2, العدد: طبيعي): نتيجة منطقي, خطأ_ويب2 {
    طالما ((الطول((*الاتصال).المخزن) مثل طبيعي) - (*الاتصال).الموضع < العدد) {
        لو ((*الاتصال).الموضع >= 65536) {
            // Drop consumed bytes so the buffer stays bounded.
            دع الباقي: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = (*الاتصال).الموضع;
            طالما (ف < (الطول((*الاتصال).المخزن) مثل طبيعي)) { ألحق(الباقي, (*الاتصال).المخزن[ف]); ف := ف + 1; }
            (*الاتصال).المخزن := الباقي;
            (*الاتصال).الموضع := 0;
        };
        دع المقروء: متغير عدد = 0;
        طابق اقرأ_ناقل_ويب(&(*الاتصال).الناقل, &متغير (*الاتصال).مؤقت_القراءة, 0, 16384) مع
        | نتيجة.خطأ(الخطأ) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.شبكة(الخطأ)); }
        | نتيجة.نجح(ق) -> { المقروء := ق; };
        لو (المقروء <= 0) { أرجع نتيجة.نجح(خطأ); };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (المقروء مثل طبيعي)) { ألحق((*الاتصال).المخزن, (*الاتصال).مؤقت_القراءة[ف]); ف := ف + 1; }
    }
    أرجع نتيجة.نجح(صواب);
}

// Reads and checks the 24-octet client preface (server side, 3.4).
عام عرف اقرأ_مقدمة_ويب2(الاتصال: &متغير اتصال_ويب2): نتيجة طبيعي, خطأ_ويب2 {
    دع كاف: منطقي = املأ_مخزن_ويب2(الاتصال, 24)؟;
    لو (!كاف) { أرجع نتيجة.خطأ(خطأ_ويب2.نهاية_الاتصال()); };
    دع المقدمة: متجه ط8 = مقدمة_ويب2();
    دع ف: متغير طبيعي = 0;
    طالما (ف < 24) {
        لو ((*الاتصال).المخزن[(*الاتصال).الموضع + ف] != المقدمة[ف]) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
        };
        ف := ف + 1;
    }
    (*الاتصال).الموضع := (*الاتصال).الموضع + 24;
    أرجع نتيجة.نجح(0);
}

// Reads one frame (4.1); a frame over our SETTINGS_MAX_FRAME_SIZE is a
// FRAME_SIZE_ERROR (4.2).
عام عرف اقرأ_إطار_ويب2(الاتصال: &متغير اتصال_ويب2): نتيجة إطار_ويب2, خطأ_ويب2 {
    لو ((*الاتصال).مغلق) { أرجع نتيجة.خطأ(خطأ_ويب2.نهاية_الاتصال()); };
    دع كاف: منطقي = املأ_مخزن_ويب2(الاتصال, 9)؟;
    لو (!كاف) { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.نهاية_الاتصال()); };
    دع الطول_: طبيعي = كبير_ويب2(&(*الاتصال).المخزن, (*الاتصال).الموضع, 3);
    لو (الطول_ > (*الاتصال).الحدود.أقصى_إطار) {
        أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2()));
    };
    دع كامل: منطقي = املأ_مخزن_ويب2(الاتصال, 9 + الطول_)؟;
    لو (!كامل) { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_ويب2.نهاية_الاتصال()); };
    // Filling may have dropped consumed bytes and moved the frame.
    دع الموضع: طبيعي = (*الاتصال).الموضع;
    دع الحمولة: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_) { ألحق(الحمولة, (*الاتصال).المخزن[الموضع + 9 + ف]); ف := ف + 1; }
    دع الإطار: إطار_ويب2 = {
        النوع: (*الاتصال).المخزن[الموضع + 3] مثل طبيعي,
        الأعلام: (*الاتصال).المخزن[الموضع + 4] مثل طبيعي,
        التيار: كبير_ويب2(&(*الاتصال).المخزن, الموضع + 5, 4) & 0x7FFFFFFF,
        الحمولة: الحمولة
    };
    (*الاتصال).الموضع := الموضع + 9 + الطول_;
    أرجع نتيجة.نجح(الإطار);
}

// Strips padding (6.1, 6.2): returns the content range of a padded payload.
عرف حدود_المحتوى_ويب2(الإطار: &إطار_ويب2, تخطي: طبيعي): اختياري طبيعي {
    دع الطول_: طبيعي = الطول((*الإطار).الحمولة) مثل طبيعي;
    لو (((*الإطار).الأعلام & علم_حشو_ويب2()) == 0) {
        لو (تخطي > الطول_) { أرجع اختياري.لا_شيء(); };
        أرجع اختياري.موجود(الطول_);
    };
    لو (الطول_ < 1) { أرجع اختياري.لا_شيء(); };
    دع الحشو: طبيعي = (*الإطار).الحمولة[0] مثل طبيعي;
    لو (1 + تخطي + الحشو > الطول_) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الطول_ - الحشو);
}

عرف بداية_المحتوى_ويب2(الإطار: &إطار_ويب2): طبيعي {
    لو (((*الإطار).الأعلام & علم_حشو_ويب2()) != 0) { أرجع 1; };
    أرجع 0;
}

// Adds window credit after the application consumed received data: one
// WINDOW_UPDATE when half of a window is used (6.9).
عرف أعد_نافذة_ويب2(الاتصال: &متغير اتصال_ويب2, الموضع: طبيعي): نتيجة طبيعي, خطأ_ويب2 {
    دع الأولية: عدد = (*الاتصال).الحدود.النافذة_الأولية مثل عدد;
    لو ((*الاتصال).نافذة_استقبال_الاتصال < الأولية / 2) {
        دع الزيادة: طبيعي = (الأولية - (*الاتصال).نافذة_استقبال_الاتصال) مثل طبيعي;
        دع الحمولة: متجه ط8 = حمولة_أربعة_ويب2(الزيادة);
        اكتب_إطار_ويب2(الاتصال, إطار_تحديث_نافذة_ويب2(), 0, 0, &الحمولة)؟;
        (*الاتصال).نافذة_استقبال_الاتصال := الأولية;
    };
    لو (!(*الاتصال).التيارات[الموضع].مغلق_بعيدا && (*الاتصال).التيارات[الموضع].نافذة_الاستقبال < الأولية / 2) {
        دع الزيادة: طبيعي = (الأولية - (*الاتصال).التيارات[الموضع].نافذة_الاستقبال) مثل طبيعي;
        دع الحمولة: متجه ط8 = حمولة_أربعة_ويب2(الزيادة);
        اكتب_إطار_ويب2(الاتصال, إطار_تحديث_نافذة_ويب2(), 0, (*الاتصال).التيارات[الموضع].المعرف, &الحمولة)؟;
        (*الاتصال).التيارات[الموضع].نافذة_الاستقبال := الأولية;
    };
    أرجع نتيجة.نجح(0);
}

// Number of streams the peer opened that are still open on its side.
عرف تيارات_مفتوحة_للنظير_ويب2(الاتصال: &اتصال_ويب2): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    دع خادم: منطقي = (*الاتصال).خادم;
    طالما (ف < (الطول((*الاتصال).التيارات) مثل طبيعي)) {
        دع من_النظير: منطقي = ((*الاتصال).التيارات[ف].المعرف % 2 == 1) == خادم;
        لو (من_النظير && !((*الاتصال).التيارات[ف].مغلق_محليا && (*الاتصال).التيارات[ف].مغلق_بعيدا)) {
            العدد := العدد + 1;
        };
        ف := ف + 1;
    }
    أرجع العدد;
}

// A complete header block for stream المعرف (after CONTINUATION frames).
عرف عالج_كتلة_رؤوس_ويب2(الاتصال: &متغير اتصال_ويب2, المعرف: طبيعي, نهاية_التيار: منطقي): نتيجة طبيعي, خطأ_ويب2 {
    دع الكتلة: متغير متجه ط8 = [];
    بدّل((*الاتصال).كتلة_معلقة, الكتلة);
    (*الاتصال).تيار_الكتلة := 0;
    // The block is always decoded, even for a refused stream, to keep the
    // HPACK state in step (RFC 9113 4.3).
    دع الرؤوس: متغير متجه رأس_ويب = [];
    طابق فك_كتلة_إتش_باك(&متغير (*الاتصال).المفكك, &الكتلة, (*الاتصال).الحدود.أقصى_قائمة_رؤوس) مع
    | نتيجة.خطأ(خطأ_إتش_باك.قائمة_رؤوس_كبيرة) -> { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_تمهل_ويب2())); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_ضغط_ويب2())); }
    | نتيجة.نجح(ق) -> { الرؤوس := ق; };
    دع الموضع: متغير طبيعي = 0;
    طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
    | اختياري.موجود(ف) -> { الموضع := ف; }
    | اختياري.لا_شيء -> {
        // A new stream opened by the peer (5.1.1).
        دع من_النظير: منطقي = (المعرف % 2 == 1) == (*الاتصال).خادم;
        لو (!من_النظير || المعرف <= (*الاتصال).آخر_معرف_نظير) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
        };
        (*الاتصال).آخر_معرف_نظير := المعرف;
        لو (تيارات_مفتوحة_للنظير_ويب2(الاتصال) >= (*الاتصال).الحدود.أقصى_تيارات) {
            دع الحمولة: متجه ط8 = حمولة_أربعة_ويب2(رمز_تيار_مرفوض_ويب2());
            اكتب_إطار_ويب2(الاتصال, إطار_إلغاء_تيار_ويب2(), 0, المعرف, &الحمولة)؟;
            أرجع نتيجة.نجح(0);
        };
        دع التيار: تيار_ويب2 = تيار_ويب2_جديد(المعرف, (*الاتصال).نافذة_أولية_النظير, (*الاتصال).الحدود.النافذة_الأولية مثل عدد);
        ألحق((*الاتصال).التيارات, التيار);
        الموضع := (الطول((*الاتصال).التيارات) مثل طبيعي) - 1;
    };
    لو ((*الاتصال).التيارات[الموضع].ملغى) { أرجع نتيجة.نجح(المعرف); };
    لو ((*الاتصال).التيارات[الموضع].مغلق_بعيدا) {
        أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_تيار_مغلق_ويب2()));
    };
    دع نهائية: متغير منطقي = صواب;
    لو (!(*الاتصال).خادم && !(*الاتصال).التيارات[الموضع].رؤوس_مستلمة) {
        // Informational (1xx) responses come before the final one (8.1).
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الرؤوس) مثل طبيعي)) {
            دع الاسم: نص = «:status»;
            لو (نصان_متساويان_ويب2(&الرؤوس[ف].الاسم, &الاسم) && (الطول(الرؤوس[ف].القيمة) مثل طبيعي) == 3
                && الرؤوس[ف].القيمة[0] == 0x31) {
                نهائية := خطأ;
            };
            ف := ف + 1;
        }
    };
    لو (!(*الاتصال).التيارات[الموضع].رؤوس_مستلمة) {
        لو (نهائية) {
            (*الاتصال).التيارات[الموضع].الرؤوس := الرؤوس;
            (*الاتصال).التيارات[الموضع].رؤوس_مستلمة := صواب;
        } وإلا لو (نهاية_التيار) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
        };
    } وإلا {
        // Trailers end the stream (8.1).
        لو (!نهاية_التيار) {
            ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_بروتوكول_ويب2())؟;
            أرجع نتيجة.نجح(المعرف);
        };
        (*الاتصال).التيارات[الموضع].الرؤوس_اللاحقة := الرؤوس;
    };
    لو (نهاية_التيار) { (*الاتصال).التيارات[الموضع].مغلق_بعيدا := صواب; };
    أرجع نتيجة.نجح(المعرف);
}

عرف نصان_متساويان_ويب2(أ: &نص, ب: &نص): منطقي {
    لو (الطول(*أ) != الطول(*ب)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { لو ((*أ)[ف] != (*ب)[ف]) { أرجع خطأ; }; ف := ف + 1; }
    أرجع صواب;
}

// SETTINGS from the peer (6.5): applied, then acknowledged.
عرف عالج_إعدادات_ويب2(الاتصال: &متغير اتصال_ويب2, الإطار: &إطار_ويب2): نتيجة طبيعي, خطأ_ويب2 {
    لو ((*الإطار).التيار != 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
    دع الطول_: طبيعي = الطول((*الإطار).الحمولة) مثل طبيعي;
    لو (((*الإطار).الأعلام & علم_تأكيد_ويب2()) != 0) {
        لو (الطول_ != 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
        أرجع نتيجة.نجح(0);
    };
    لو (الطول_ % 6 != 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_) {
        دع المعرف: طبيعي = كبير_ويب2(&(*الإطار).الحمولة, ف, 2);
        دع القيمة: طبيعي = كبير_ويب2(&(*الإطار).الحمولة, ف + 2, 4);
        لو (المعرف == إعداد_حجم_جدول_الرؤوس_ويب2()) {
            اضبط_حد_مرمز_إتش_باك(&متغير (*الاتصال).المرمز, القيمة);
        } وإلا لو (المعرف == إعداد_تفعيل_الدفع_ويب2()) {
            لو (القيمة > 1 || (!(*الاتصال).خادم && القيمة == 1)) {
                أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
            };
        } وإلا لو (المعرف == إعداد_أقصى_تيارات_ويب2()) {
            (*الاتصال).أقصى_تيارات_النظير := القيمة;
        } وإلا لو (المعرف == إعداد_النافذة_الأولية_ويب2()) {
            لو (القيمة > 0x7FFFFFFF) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_تحكم_التدفق_ويب2())); };
            // A change applies to every open stream's send window (6.9.2).
            دع الفرق: عدد = (القيمة مثل عدد) - (*الاتصال).نافذة_أولية_النظير;
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*الاتصال).التيارات) مثل طبيعي)) {
                دع الجديدة: عدد = (*الاتصال).التيارات[ك].نافذة_الإرسال + الفرق;
                لو (الجديدة > 0x7FFFFFFF) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_تحكم_التدفق_ويب2())); };
                (*الاتصال).التيارات[ك].نافذة_الإرسال := الجديدة;
                ك := ك + 1;
            }
            (*الاتصال).نافذة_أولية_النظير := القيمة مثل عدد;
        } وإلا لو (المعرف == إعداد_أقصى_إطار_ويب2()) {
            لو (القيمة < 16384 || القيمة > 16777215) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
            (*الاتصال).أقصى_إطار_النظير := القيمة;
        };
        // SETTINGS_MAX_HEADER_LIST_SIZE is advisory; unknown settings are ignored.
        ف := ف + 6;
    }
    (*الاتصال).إعدادات_مستلمة := صواب;
    دع فارغ: متجه ط8 = [];
    اكتب_إطار_ويب2(الاتصال, إطار_إعدادات_ويب2(), علم_تأكيد_ويب2(), 0, &فارغ)؟;
    أرجع نتيجة.نجح(0);
}

// Processes one received frame; returns the stream it touched (0 for the
// connection).
عام عرف عالج_إطار_ويب2(الاتصال: &متغير اتصال_ويب2, الإطار: &إطار_ويب2): نتيجة طبيعي, خطأ_ويب2 {
    دع النوع: طبيعي = (*الإطار).النوع;
    دع المعرف: طبيعي = (*الإطار).التيار;
    دع الطول_: طبيعي = الطول((*الإطار).الحمولة) مثل طبيعي;
    // While a header block is open only its CONTINUATION frames may come (6.10).
    لو ((*الاتصال).تيار_الكتلة != 0) {
        لو (النوع != إطار_استمرار_ويب2() || المعرف != (*الاتصال).تيار_الكتلة) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
        };
        لو ((الطول((*الاتصال).كتلة_معلقة) مثل طبيعي) + الطول_ > (*الاتصال).الحدود.أقصى_كتلة_رؤوس) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_تمهل_ويب2()));
        };
        دع ف: متغير طبيعي = 0;
        طالما (ف < الطول_) { ألحق((*الاتصال).كتلة_معلقة, (*الإطار).الحمولة[ف]); ف := ف + 1; }
        لو (((*الإطار).الأعلام & علم_نهاية_الرؤوس_ويب2()) != 0) {
            دع نهاية: منطقي = ((*الاتصال).أعلام_الكتلة & علم_نهاية_التيار_ويب2()) != 0;
            أرجع عالج_كتلة_رؤوس_ويب2(الاتصال, المعرف, نهاية);
        };
        أرجع نتيجة.نجح(المعرف);
    };
    لو (!(*الاتصال).إعدادات_مستلمة && النوع != إطار_إعدادات_ويب2()) {
        // The first frame of each side is SETTINGS (3.4).
        أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
    };
    لو (النوع == إطار_بيانات_ويب2()) {
        لو (المعرف == 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        // Flow control counts the whole payload, padding included (6.9.1).
        لو ((الطول_ مثل عدد) > (*الاتصال).نافذة_استقبال_الاتصال) {
