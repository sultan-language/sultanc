        };
        (*الاتصال).نافذة_استقبال_الاتصال := (*الاتصال).نافذة_استقبال_الاتصال - (الطول_ مثل عدد);
        دع الموضع: متغير طبيعي = 0;
        طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
        | اختياري.موجود(ف) -> { الموضع := ف; }
        | اختياري.لا_شيء -> {
            لو (المعرف > (*الاتصال).آخر_معرف_نظير && ((المعرف % 2 == 1) == (*الاتصال).خادم)) {
                أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
            };
            ألغ_تيار_ويب2(الاتصال, المعرف, رمز_تيار_مغلق_ويب2())؟;
            أرجع نتيجة.نجح(0);
        };
        لو ((*الاتصال).التيارات[الموضع].ملغى) { أرجع نتيجة.نجح(0); };
        لو ((*الاتصال).التيارات[الموضع].مغلق_بعيدا || !(*الاتصال).التيارات[الموضع].رؤوس_مستلمة) {
            ألغ_تيار_ويب2(الاتصال, المعرف, رمز_تيار_مغلق_ويب2())؟;
            أرجع نتيجة.نجح(0);
        };
        لو ((الطول_ مثل عدد) > (*الاتصال).التيارات[الموضع].نافذة_الاستقبال) {
            ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_تحكم_التدفق_ويب2())؟;
            أرجع نتيجة.نجح(0);
        };
        (*الاتصال).التيارات[الموضع].نافذة_الاستقبال := (*الاتصال).التيارات[الموضع].نافذة_الاستقبال - (الطول_ مثل عدد);
        دع النهاية: متغير طبيعي = 0;
        طابق حدود_المحتوى_ويب2(الإطار, 0) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); }
        | اختياري.موجود(ق) -> { النهاية := ق; };
        دع البداية: طبيعي = بداية_المحتوى_ويب2(الإطار);
        لو ((الطول((*الاتصال).التيارات[الموضع].الجسم) مثل طبيعي) + (النهاية - البداية) > (*الاتصال).الحدود.أقصى_جسم) {
            ألغ_تيار_ويب2(الاتصال, المعرف, رمز_تمهل_ويب2())؟;
            أرجع نتيجة.نجح(المعرف);
        };
        دع ف: متغير طبيعي = البداية;
        طالما (ف < النهاية) { ألحق((*الاتصال).التيارات[الموضع].الجسم, (*الإطار).الحمولة[ف]); ف := ف + 1; }
        لو (((*الإطار).الأعلام & علم_نهاية_التيار_ويب2()) != 0) { (*الاتصال).التيارات[الموضع].مغلق_بعيدا := صواب; };
        أعد_نافذة_ويب2(الاتصال, الموضع)؟;
        أرجع نتيجة.نجح(المعرف);
    };
    لو (النوع == إطار_رؤوس_ويب2()) {
        لو (المعرف == 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        دع البداية: متغير طبيعي = بداية_المحتوى_ويب2(الإطار);
        دع تخطي: متغير طبيعي = 0;
        لو (((*الإطار).الأعلام & علم_أولوية_ويب2()) != 0) { تخطي := 5; };
        دع النهاية: متغير طبيعي = 0;
        طابق حدود_المحتوى_ويب2(الإطار, تخطي) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); }
        | اختياري.موجود(ق) -> { النهاية := ق; };
        لو (تخطي == 5) {
            // A stream cannot depend on itself (5.3.1).
            دع الاعتماد: طبيعي = كبير_ويب2(&(*الإطار).الحمولة, البداية, 4) & 0x7FFFFFFF;
            لو (الاعتماد == المعرف) {
                ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_بروتوكول_ويب2())؟;
            };
        };
        البداية := البداية + تخطي;
        لو (البداية > النهاية || النهاية - البداية > (*الاتصال).الحدود.أقصى_كتلة_رؤوس) {
            أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_تمهل_ويب2()));
        };
        دع الكتلة: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = البداية;
        طالما (ف < النهاية) { ألحق(الكتلة, (*الإطار).الحمولة[ف]); ف := ف + 1; }
        (*الاتصال).كتلة_معلقة := الكتلة;
        (*الاتصال).أعلام_الكتلة := (*الإطار).الأعلام;
        لو (((*الإطار).الأعلام & علم_نهاية_الرؤوس_ويب2()) == 0) {
            (*الاتصال).تيار_الكتلة := المعرف;
            أرجع نتيجة.نجح(المعرف);
        };
        أرجع عالج_كتلة_رؤوس_ويب2(الاتصال, المعرف, ((*الإطار).الأعلام & علم_نهاية_التيار_ويب2()) != 0);
    };
    لو (النوع == إطار_أولوية_ويب2()) {
        لو (المعرف == 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        لو (الطول_ != 5) { ألغ_تيار_ويب2(الاتصال, المعرف, رمز_خطأ_حجم_الإطار_ويب2())؟; };
        // Priorities are advisory (RFC 9113 5.3 deprecates the scheme).
        أرجع نتيجة.نجح(0);
    };
    لو (النوع == إطار_إلغاء_تيار_ويب2()) {
        لو (المعرف == 0) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2())); };
        لو (الطول_ != 4) { أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_حجم_الإطار_ويب2())); };
        طابق موضع_تيار_ويب2(الاتصال, المعرف) مع
        | اختياري.موجود(ف) -> {
            (*الاتصال).التيارات[ف].ملغى := صواب;
            (*الاتصال).التيارات[ف].رمز_الإلغاء := كبير_ويب2(&(*الإطار).الحمولة, 0, 4);
            (*الاتصال).التيارات[ف].مغلق_محليا := صواب;
            (*الاتصال).التيارات[ف].مغلق_بعيدا := صواب;
            (*الاتصال).التيارات[ف].إرسال_معلق := خطأ;
        }
        | اختياري.لا_شيء -> {
            // RST_STREAM on an idle stream (5.1).
            دع محلي: منطقي = (المعرف % 2 == 1) != (*الاتصال).خادم;
            لو ((محلي && المعرف >= (*الاتصال).المعرف_التالي) || (!محلي && المعرف > (*الاتصال).آخر_معرف_نظير)) {
                أرجع نتيجة.خطأ(أفشل_اتصال_ويب2(الاتصال, رمز_خطأ_بروتوكول_ويب2()));
            };
        };
        أرجع نتيجة.نجح(المعرف);
    };
    لو (النوع == إطار_إعدادات_ويب2()) {
        أرجع عالج_إعدادات_ويب2(الاتصال, الإطار);
    };
    لو (النوع == إطار_وعد_دفع_ويب2()) {
