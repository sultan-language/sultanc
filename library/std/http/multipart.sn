استورد chars.ascii;
استورد text.compare;
استورد text.from_bytes;
استورد text.substring;
استورد http.model;
استورد http.headers;
استورد http.media_type;
استورد http.http1.common;

// Buffered multipart/form-data foundation. Transport streaming remains outside
// this parser; limits are explicit so application frameworks can set policy.
عام نوع جزء_متعدد_ويب = {
    الاسم: نص,
    اسم_الملف: اختياري نص,
    نوع_المحتوى: اختياري نص,
    الرؤوس: متجه رأس_ويب,
    الجسم: متجه ط8
};

عام نوع حدود_متعدد_ويب = {
    أقصى_الأجزاء: طبيعي,
    أقصى_بايتات_الجزء: طبيعي,
    أقصى_الرؤوس_للجزء: طبيعي,
    أقصى_بايتات_رؤوس_الجزء: طبيعي
};

عام نوع صنف_خطأ_متعدد_ويب =
    | نوع_محتوى_مفقود
    | نوع_محتوى_غير_صالح
    | ليس_نموذجا_متعدد_الأجزاء
    | حد_مفقود
    | حد_غير_صالح
    | جسم_غير_صالح
    | رؤوس_جزء_غير_صالحة
    | رؤوس_جزء_كبيرة
    | رؤوس_جزء_كثيرة
    | توزيع_مفقود
    | توزيع_غير_صالح
    | اسم_حقل_مفقود
    | أجزاء_كثيرة
    | جزء_كبير
;

عام عرف حدود_متعدد_ويب_افتراضية(): حدود_متعدد_ويب {
    دع الناتج: حدود_متعدد_ويب = {
        أقصى_الأجزاء: 128,
        أقصى_بايتات_الجزء: 8388608,
        أقصى_الرؤوس_للجزء: 64,
        أقصى_بايتات_رؤوس_الجزء: 65536
    };
    أرجع الناتج;
}

عرف حد_متعدد_ويب_صالح(الحد: &نص): منطقي {
    دع العدد: طبيعي = الطول((*الحد)) مثل طبيعي;
    إذا ((العدد == 0) || (العدد > 70)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*الحد)[ف];
        دع أبجدي_رقمي: منطقي = حرف_أو_رقم_أسكي(ب);
        دع خاص: منطقي = ((ب == 0x27) || (ب == 0x28) || (ب == 0x29) || (ب == 0x2B) || (ب == 0x5F) || (ب == 0x2C) || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x2F) || (ب == 0x3A) || (ب == 0x3D) || (ب == 0x3F));
        إذا (ب == 0x20) {
            دع التالي: طبيعي = ف + 1;
            إذا (التالي >= العدد) { أرجع خطأ; };
        } وإلا إذا (!أبجدي_رقمي && !خاص) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف بايتات_حد_متعدد_ويب(الحد: &نص, مع_بداية_سطر: منطقي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    إذا (مع_بداية_سطر) { ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A); };
    ألحق(الناتج, 0x2D); ألحق(الناتج, 0x2D);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الحد)) مثل طبيعي)) { ألحق(الناتج, (*الحد)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف بايتات_ويب_تطابق_عند(المصدر: &متجه ط8, النمط: &متجه ط8, الموضع: طبيعي): منطقي {
    دع عدد_أ: طبيعي = الطول((*المصدر)) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول((*النمط)) مثل طبيعي;
    إذا ((الموضع + عدد_ب) > عدد_أ) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_ب) {
        دع م: طبيعي = الموضع + ف;
        إذا ((*المصدر)[م] != (*النمط)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ابحث_بايتات_ويب_من(المصدر: &متجه ط8, النمط: &متجه ط8, البداية: طبيعي): اختياري طبيعي {
    دع عدد_أ: طبيعي = الطول((*المصدر)) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول((*النمط)) مثل طبيعي;
    إذا (عدد_ب == 0) { أرجع اختياري.موجود(البداية); };
    دع ف: متغير طبيعي = البداية;
    طالما ((ف + عدد_ب) <= عدد_أ) {
        إذا (بايتات_ويب_تطابق_عند(المصدر, النمط, ف)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف ابحث_حد_متعدد_ويب(المصدر: &متجه ط8, النمط: &متجه ط8, البداية: طبيعي): اختياري طبيعي {
    دع ف: متغير طبيعي = البداية;
    دع انتهى: متغير منطقي = خطأ;
    طالما (!انتهى) {
        طابق ابحث_بايتات_ويب_من(المصدر, النمط, ف) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(موضع) -> {
            دع بعد: طبيعي = موضع + (الطول((*النمط)) مثل طبيعي);
            دع العدد_الكلي: طبيعي = الطول((*المصدر)) مثل طبيعي;
            إذا ((بعد + 1) < العدد_الكلي) {
                دع بعد1: طبيعي = بعد + 1;
                دع إغلاق: منطقي = (((*المصدر)[بعد] == 0x2D) && ((*المصدر)[بعد1] == 0x2D));
                دع متابعة: منطقي = (((*المصدر)[بعد] == 0x0D) && ((*المصدر)[بعد1] == 0x0A));
                إذا (إغلاق || متابعة) { أرجع اختياري.موجود(موضع); };
            };
            ف := موضع + 1;
        };
    }
    أرجع اختياري.لا_شيء();
}

عرف انسخ_مدى_بايتات_ويب(المصدر: &متجه ط8, البداية: طبيعي, النهاية: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = البداية;
    طالما ((ف < النهاية) && (ف < (الطول((*المصدر)) مثل طبيعي))) { ألحق(الناتج, (*المصدر)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف حلل_رؤوس_جزء_ويب(المصدر: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, الحدود: &حدود_متعدد_ويب): نتيجة متجه رأس_ويب, صنف_خطأ_متعدد_ويب {
    إذا ((النهاية - البداية) > (*الحدود).أقصى_بايتات_رؤوس_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كبيرة()); };
    دع الرؤوس: متغير متجه رأس_ويب = [];
    دع نهاية_السطر: متجه ط8 = [0x0D,0x0A];
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع خط_النهاية: متغير طبيعي = 0;
        طابق ابحث_بايتات_ويب_من(المصدر, &نهاية_السطر, ف) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); }
        | اختياري.موجود(م) -> { خط_النهاية := م; };
        إذا (خط_النهاية > النهاية) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        دع نقطتان: متغير طبيعي = ف;
        طالما ((نقطتان < خط_النهاية) && ((*المصدر)[نقطتان] != 0x3A)) { نقطتان := نقطتان + 1; }
        إذا ((نقطتان == ف) || (نقطتان >= خط_النهاية)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        دع الاسم: نص = نص_ويب_من_مدى(المصدر, ف, نقطتان);
        دع بداية_القيمة: متغير طبيعي = نقطتان + 1;
        طالما ((بداية_القيمة < خط_النهاية) && (((*المصدر)[بداية_القيمة] == 0x20) || ((*المصدر)[بداية_القيمة] == 0x09))) { بداية_القيمة := بداية_القيمة + 1; }
        دع نهاية_القيمة: متغير طبيعي = خط_النهاية;
        دع قص: متغير منطقي = صواب;
        طالما ((نهاية_القيمة > بداية_القيمة) && قص) {
            دع السابق: طبيعي = نهاية_القيمة - 1;
            إذا (((*المصدر)[السابق] == 0x20) || ((*المصدر)[السابق] == 0x09)) { نهاية_القيمة := السابق; } وإلا { قص := خطأ; };
        }
        دع القيمة: نص = نص_ويب_من_مدى(المصدر, بداية_القيمة, نهاية_القيمة);
        إذا (!أضف_رأس_ويب(&متغير الرؤوس, &الاسم, &القيمة)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة()); };
        إذا ((الطول(الرؤوس) مثل طبيعي) > (*الحدود).أقصى_الرؤوس_للجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كثيرة()); };
        ف := خط_النهاية + 2;
    }
    أرجع نتيجة.نجح(الرؤوس);
}

عرف حلل_توزيع_نموذج_ويب(القيمة: &نص): نتيجة متجه نص, صنف_خطأ_متعدد_ويب {
    دع العدد: طبيعي = الطول((*القيمة)) مثل طبيعي;
    دع البايتات: متجه ط8 = بايتات_ويب_من_نص(القيمة);
    دع ف: متغير طبيعي = 0;
    طالما ((ف < العدد) && (((*القيمة)[ف] == 0x20) || ((*القيمة)[ف] == 0x09))) { ف := ف + 1; }
    دع نهاية_النوع: متغير طبيعي = ف;
    طالما ((نهاية_النوع < العدد) && ((*القيمة)[نهاية_النوع] != 0x3B)) { نهاية_النوع := نهاية_النوع + 1; }
    دع نهاية_مقصوصة: متغير طبيعي = نهاية_النوع;
    دع قص: متغير منطقي = صواب;
    طالما ((نهاية_مقصوصة > ف) && قص) {
        دع السابق: طبيعي = نهاية_مقصوصة - 1;
        إذا (((*القيمة)[السابق] == 0x20) || ((*القيمة)[السابق] == 0x09)) { نهاية_مقصوصة := السابق; } وإلا { قص := خطأ; };
    }
    دع النوع_الخام: نص = نص_ويب_من_مدى(&البايتات, ف, نهاية_مقصوصة);
    دع النوع: نص = نص_ويب_صغير(&النوع_الخام);
    دع مطلوب: نص = «form-data»;
    إذا (!نصان_متساويان(&النوع, &مطلوب)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };

    دع الاسم: متغير نص = «»;
    دع لديه_اسم: متغير منطقي = خطأ;
    دع اسم_الملف: متغير نص = «»;
    دع لديه_اسم_ملف: متغير منطقي = خطأ;
    ف := نهاية_النوع;
    طالما (ف < العدد) {
        إذا ((*القيمة)[ف] == 0x3B) { ف := ف + 1; };
        طالما ((ف < العدد) && (((*القيمة)[ف] == 0x20) || ((*القيمة)[ف] == 0x09))) { ف := ف + 1; }
        إذا (ف >= العدد) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع بداية_الاسم: طبيعي = ف;
        طالما ((ف < العدد) && ((*القيمة)[ف] != 0x3D) && ((*القيمة)[ف] != 0x3B)) { ف := ف + 1; }
        إذا ((ف >= العدد) || ((*القيمة)[ف] != 0x3D)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع نهاية_اسم: متغير طبيعي = ف;
        دع قص_اسم: متغير منطقي = صواب;
        طالما ((نهاية_اسم > بداية_الاسم) && قص_اسم) {
            دع السابق: طبيعي = نهاية_اسم - 1;
            إذا (((*القيمة)[السابق] == 0x20) || ((*القيمة)[السابق] == 0x09)) { نهاية_اسم := السابق; } وإلا { قص_اسم := خطأ; };
        }
        دع اسم_خام: نص = نص_ويب_من_مدى(&البايتات, بداية_الاسم, نهاية_اسم);
        إذا (!رمز_نوع_وسائط_ويب_صالح(&اسم_خام)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
        دع اسم_معامل: نص = نص_ويب_صغير(&اسم_خام);
        ف := ف + 1;
        طالما ((ف < العدد) && (((*القيمة)[ف] == 0x20) || ((*القيمة)[ف] == 0x09))) { ف := ف + 1; }
        دع بداية_القيمة: طبيعي = ف;
        دع نهاية_القيمة: متغير طبيعي = ف;
        إذا ((ف < العدد) && ((*القيمة)[ف] == 0x22)) {
            ف := ف + 1;
            دع هروب: متغير منطقي = خطأ;
            دع أغلق: متغير منطقي = خطأ;
            طالما ((ف < العدد) && !أغلق) {
                دع ب: ط8 = (*القيمة)[ف];
                إذا (هروب) { هروب := خطأ; ف := ف + 1; }
                وإلا إذا (ب == 0x5C) { هروب := صواب; ف := ف + 1; }
                وإلا إذا (ب == 0x22) { ف := ف + 1; نهاية_القيمة := ف; أغلق := صواب; }
                وإلا { ف := ف + 1; };
            }
            إذا (!أغلق) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            دع تفحص: متغير طبيعي = ف;
            طالما ((تفحص < العدد) && ((*القيمة)[تفحص] != 0x3B)) {
                إذا (((*القيمة)[تفحص] != 0x20) && ((*القيمة)[تفحص] != 0x09)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
                تفحص := تفحص + 1;
            }
            ف := تفحص;
        } وإلا {
            طالما ((ف < العدد) && ((*القيمة)[ف] != 0x3B)) { ف := ف + 1; }
            نهاية_القيمة := ف;
            دع قص_قيمة: متغير منطقي = صواب;
            طالما ((نهاية_القيمة > بداية_القيمة) && قص_قيمة) {
                دع السابق: طبيعي = نهاية_القيمة - 1;
                إذا (((*القيمة)[السابق] == 0x20) || ((*القيمة)[السابق] == 0x09)) { نهاية_القيمة := السابق; } وإلا { قص_قيمة := خطأ; };
            }
        };
        دع قيمة_خام: نص = نص_ويب_من_مدى(&البايتات, بداية_القيمة, نهاية_القيمة);
        دع مفكوكة: متغير نص = «»;
        طابق فك_قيمة_معامل_نوع_وسائط_ويب(&قيمة_خام) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); }
        | نتيجة.نجح(قيمة_مفكوكة) -> { مفكوكة := قيمة_مفكوكة; };
        دع اسم_حقل: نص = «name»;
        دع اسم_ملف_معامل: نص = «filename»;
        إذا (نصان_متساويان(&اسم_معامل, &اسم_حقل)) {
            إذا (لديه_اسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            الاسم := مفكوكة;
            لديه_اسم := صواب;
        } وإلا إذا (نصان_متساويان(&اسم_معامل, &اسم_ملف_معامل)) {
            إذا (لديه_اسم_ملف) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
            اسم_الملف := مفكوكة;
            لديه_اسم_ملف := صواب;
        };
        طالما ((ف < العدد) && ((*القيمة)[ف] != 0x3B)) { ف := ف + 1; }
    }
    إذا (!لديه_اسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.اسم_حقل_مفقود()); };
    دع الناتج: متغير متجه نص = [];
    ألحق(الناتج, الاسم);
    إذا (لديه_اسم_ملف) { ألحق(الناتج, اسم_الملف); };
    أرجع نتيجة.نجح(الناتج);
}

عرف أنشئ_جزء_متعدد_ويب(الرؤوس: متجه رأس_ويب, الجسم: متجه ط8): نتيجة جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع اسم_التوزيع: نص = «content-disposition»;
    دع قيم_التوزيع: متجه نص = قيم_رأس_ويب(&الرؤوس, &اسم_التوزيع);
    إذا ((الطول(قيم_التوزيع) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_مفقود()); };
    إذا ((الطول(قيم_التوزيع) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.توزيع_غير_صالح()); };
    دع التوزيع: متغير متجه نص = [];
    طابق حلل_توزيع_نموذج_ويب(&قيم_التوزيع[0]) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { التوزيع := قيمة; };
    دع اسم_الجزء: نص = انسخ_نص_ويب(&التوزيع[0]);
    دع اسم_الملف: متغير اختياري نص = اختياري.لا_شيء();
    إذا ((الطول(التوزيع) مثل طبيعي) > 1) { اسم_الملف := اختياري.موجود(انسخ_نص_ويب(&التوزيع[1])); };
    دع اسم_نوع: نص = «content-type»;
    دع نوع_المحتوى: اختياري نص = أول_قيمة_رأس_ويب(&الرؤوس, &اسم_نوع);
    دع الناتج: جزء_متعدد_ويب = {
        الاسم: اسم_الجزء,
        اسم_الملف: اسم_الملف,
        نوع_المحتوى: نوع_المحتوى,
        الرؤوس: الرؤوس,
        الجسم: الجسم
    };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_نموذج_متعدد_ويب_بحدود(الطلب: &طلب_ويب_مخزن, الحدود: &حدود_متعدد_ويب): نتيجة متجه جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع اسم_نوع: نص = «content-type»;
    دع أنواع: متجه نص = قيم_رأس_ويب(&(*الطلب).الرؤوس, &اسم_نوع);
    إذا ((الطول(أنواع) مثل طبيعي) == 0) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_مفقود()); };
    إذا ((الطول(أنواع) مثل طبيعي) != 1) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_غير_صالح()); };
    دع النوع: متغير نوع_وسائط_ويب;
    طابق حلل_نوع_وسائط_ويب(&أنواع[0]) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_غير_صالح()); }
    | نتيجة.نجح(قيمة_نوع) -> { النوع := قيمة_نوع; };
    دع فئة: نص = «multipart»;
    دع فرعي: نص = «form-data»;
    إذا (!نوع_وسائط_ويب_يطابق(&النوع, &فئة, &فرعي)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.ليس_نموذجا_متعدد_الأجزاء()); };
    دع اسم_الحد: نص = «boundary»;
    دع الحد_النصي: متغير نص = «»;
    طابق قيمة_معامل_نوع_وسائط_ويب(&النوع, &اسم_الحد) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.حد_مفقود()); }
    | اختياري.موجود(قيمة_حد) -> { الحد_النصي := قيمة_حد; };
    إذا (!حد_متعدد_ويب_صالح(&الحد_النصي)) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.حد_غير_صالح()); };

    دع بداية_حد: متجه ط8 = بايتات_حد_متعدد_ويب(&الحد_النصي, خطأ);
    دع حد_داخلي: متجه ط8 = بايتات_حد_متعدد_ويب(&الحد_النصي, صواب);
    دع عدد_الجسم: طبيعي = الطول((*الطلب).الجسم) مثل طبيعي;
    دع الجسم: متجه ط8 = انسخ_مدى_بايتات_ويب(&(*الطلب).الجسم, 0, عدد_الجسم);
    دع بداية_الفاصل: متغير طبيعي = 0;
    إذا (!بايتات_ويب_تطابق_عند(&الجسم, &بداية_حد, 0)) {
        طابق ابحث_حد_متعدد_ويب(&الجسم, &حد_داخلي, 0) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختياري.موجود(م) -> { بداية_الفاصل := م + 2; };
    };
    دع موضع: متغير طبيعي = بداية_الفاصل + (الطول(بداية_حد) مثل طبيعي);
    إذا ((موضع + 1) >= عدد_الجسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    دع موضع1: طبيعي = موضع + 1;
    إذا ((الجسم[موضع] == 0x2D) && (الجسم[موضع1] == 0x2D)) { دع فارغ: متجه جزء_متعدد_ويب = []; أرجع نتيجة.نجح(فارغ); };
    إذا (!((الجسم[موضع] == 0x0D) && (الجسم[موضع1] == 0x0A))) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    موضع := موضع + 2;
    دع الأجزاء: متغير متجه جزء_متعدد_ويب = [];
    دع انتهى: متغير منطقي = خطأ;
    دع فاصل_الرؤوس: متجه ط8 = [0x0D,0x0A,0x0D,0x0A];
    طالما (!انتهى) {
        إذا ((الطول(الأجزاء) مثل طبيعي) >= (*الحدود).أقصى_الأجزاء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.أجزاء_كثيرة()); };
        دع نهاية_الرؤوس: متغير طبيعي = 0;
        طابق ابحث_بايتات_ويب_من(&الجسم, &فاصل_الرؤوس, موضع) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختياري.موجود(م) -> { نهاية_الرؤوس := م; };
        إذا ((نهاية_الرؤوس - موضع) > (*الحدود).أقصى_بايتات_رؤوس_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.رؤوس_جزء_كبيرة()); };
        دع الرؤوس: متغير متجه رأس_ويب;
        طابق حلل_رؤوس_جزء_ويب(&الجسم, موضع, نهاية_الرؤوس + 2, الحدود) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(قيمة_رؤوس) -> { الرؤوس := قيمة_رؤوس; };
        دع بداية_الجسم: طبيعي = نهاية_الرؤوس + 4;
        دع موضع_الحد: متغير طبيعي = 0;
        طابق ابحث_حد_متعدد_ويب(&الجسم, &حد_داخلي, بداية_الجسم) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); }
        | اختياري.موجود(م) -> { موضع_الحد := م; };
        إذا ((موضع_الحد - بداية_الجسم) > (*الحدود).أقصى_بايتات_الجزء) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جزء_كبير()); };
        دع جسم_الجزء: متجه ط8 = انسخ_مدى_بايتات_ويب(&الجسم, بداية_الجسم, موضع_الحد);
        طابق أنشئ_جزء_متعدد_ويب(الرؤوس, جسم_الجزء) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجزء) -> { ألحق(الأجزاء, الجزء); };
        موضع := موضع_الحد + (الطول(حد_داخلي) مثل طبيعي);
        إذا ((موضع + 1) >= عدد_الجسم) { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
        دع تالي: طبيعي = موضع + 1;
        إذا ((الجسم[موضع] == 0x2D) && (الجسم[تالي] == 0x2D)) { انتهى := صواب; موضع := موضع + 2; }
        وإلا إذا ((الجسم[موضع] == 0x0D) && (الجسم[تالي] == 0x0A)) { موضع := موضع + 2; }
        وإلا { أرجع نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جسم_غير_صالح()); };
    }
    أرجع نتيجة.نجح(الأجزاء);
}

عام عرف حلل_نموذج_متعدد_ويب(الطلب: &طلب_ويب_مخزن): نتيجة متجه جزء_متعدد_ويب, صنف_خطأ_متعدد_ويب {
    دع الحدود: حدود_متعدد_ويب = حدود_متعدد_ويب_افتراضية();
    أرجع حلل_نموذج_متعدد_ويب_بحدود(الطلب, &الحدود);
}

عرف انسخ_اختيار_نص_ويب(القيمة: &اختياري نص): اختياري نص {
    طابق *القيمة مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(النص) -> { دع النسخة: نص = انسخ_نص_ويب(&النص); أرجع اختياري.موجود(النسخة); };
}

عام عرف اسم_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): نص { أرجع انسخ_نص_ويب(&(*الجزء).الاسم); }
عام عرف اسم_ملف_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): اختياري نص { أرجع انسخ_اختيار_نص_ويب(&(*الجزء).اسم_الملف); }
عام عرف نوع_محتوى_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): اختياري نص { أرجع انسخ_اختيار_نص_ويب(&(*الجزء).نوع_المحتوى); }
عام عرف جسم_جزء_متعدد_ويب(الجزء: &جزء_متعدد_ويب): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجزء).الجسم) مثل طبيعي)) { ألحق(الناتج, (*الجزء).الجسم[ف]); ف := ف + 1; }
    أرجع الناتج;
}

// English public aliases.
عام نوع http_multipart_part = جزء_متعدد_ويب;
عام نوع http_multipart_limits = حدود_متعدد_ويب;
عام مرادف http_multipart_error_kind = صنف_خطأ_متعدد_ويب;
عام مرادف default_http_multipart_limits = حدود_متعدد_ويب_افتراضية;
عام مرادف parse_http_multipart_with_limits = حلل_نموذج_متعدد_ويب_بحدود;
عام مرادف parse_http_multipart = حلل_نموذج_متعدد_ويب;
عام مرادف http_multipart_part_name = اسم_جزء_متعدد_ويب;
عام مرادف http_multipart_part_filename = اسم_ملف_جزء_متعدد_ويب;
عام مرادف http_multipart_part_content_type = نوع_محتوى_جزء_متعدد_ويب;
عام مرادف http_multipart_part_body = جسم_جزء_متعدد_ويب;
عام مرادف http_multipart_error_kind.missing_content_type = صنف_خطأ_متعدد_ويب.نوع_محتوى_مفقود;
عام مرادف http_multipart_error_kind.invalid_content_type = صنف_خطأ_متعدد_ويب.نوع_محتوى_غير_صالح;
عام مرادف http_multipart_error_kind.not_multipart_form = صنف_خطأ_متعدد_ويب.ليس_نموذجا_متعدد_الأجزاء;
عام مرادف http_multipart_error_kind.missing_boundary = صنف_خطأ_متعدد_ويب.حد_مفقود;
عام مرادف http_multipart_error_kind.invalid_boundary = صنف_خطأ_متعدد_ويب.حد_غير_صالح;
عام مرادف http_multipart_error_kind.invalid_body = صنف_خطأ_متعدد_ويب.جسم_غير_صالح;
عام مرادف http_multipart_error_kind.invalid_part_headers = صنف_خطأ_متعدد_ويب.رؤوس_جزء_غير_صالحة;
عام مرادف http_multipart_error_kind.part_headers_too_large = صنف_خطأ_متعدد_ويب.رؤوس_جزء_كبيرة;
عام مرادف http_multipart_error_kind.too_many_part_headers = صنف_خطأ_متعدد_ويب.رؤوس_جزء_كثيرة;
عام مرادف http_multipart_error_kind.missing_disposition = صنف_خطأ_متعدد_ويب.توزيع_مفقود;
عام مرادف http_multipart_error_kind.invalid_disposition = صنف_خطأ_متعدد_ويب.توزيع_غير_صالح;
عام مرادف http_multipart_error_kind.missing_field_name = صنف_خطأ_متعدد_ويب.اسم_حقل_مفقود;
عام مرادف http_multipart_error_kind.too_many_parts = صنف_خطأ_متعدد_ويب.أجزاء_كثيرة;
عام مرادف http_multipart_error_kind.part_too_large = صنف_خطأ_متعدد_ويب.جزء_كبير;
