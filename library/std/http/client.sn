استورد http.core;
استورد io.reader;
استورد io.writer;
استورد net.dns;
استورد net.ip;
استورد net.socket_address;
استورد net.tcp;
استورد text.compare;
استورد text.from_bytes;
استورد text.number;
استورد text.substring;
استورد tls.config;
استورد tls.stream;
استورد uri.uri;

عرف بايت_عميل_ويب_عند(البايتات: &متجه غ8, الموضع: غير_موقع): غ8 { أرجع (*البايتات)[الموضع]; }

// Buffered HTTP/1.1 client. The protocol parser/serializer remains independent
// of TCP/TLS; the high-level request helper only supplies the transport.
عام نوع خطأ_عميل_ويب =
    | عنوان_غير_صالح
    | مخطط_غير_مدعوم
    | سلطة_غير_صالحة
    | طلب_غير_صالح
    | استجابة_غير_مكتملة
    | استجابة_غير_صالحة
    | استجابة_كبيرة
    | شبكة بنوع عدد
;

عام نوع استجابة_ويب_محللة = {
    الاستجابة: استجابة_ويب_مخزنة,
    المستهلك: غير_موقع
};

نوع وجهة_عميل_ويب = {
    المضيف: نص,
    المنفذ: غ16,
    الهدف: نص,
    آمن: منطقي,
    السلطة: نص
};

عرف ألحق_نص_عميل(الناتج: &متغير متجه غ8, النص: &نص): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عرف نص_مدى_عميل(البايتات: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): نص {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف < النهاية) && (ف < (الطول(*البايتات) مثل غير_موقع))) { ألحق(الناتج, بايت_عميل_ويب_عند(البايتات, ف)); ف := ف + 1; }
    أرجع من_بايتات(&الناتج);
}

عرف نص_أسكي_صغير_عميل(القيمة: &نص): نص {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        دع ب: متغير غ8 = (*القيمة)[ف];
        لو ((ب >= 0x41) && (ب <= 0x5A)) { ب := ب + 0x20; };
        ألحق(الناتج, ب);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف نص_أسكي_يساوي_عميل(القيمة: &نص, المطلوب: &نص): منطقي {
    دع أ: نص = نص_أسكي_صغير_عميل(القيمة);
    دع ب: نص = نص_أسكي_صغير_عميل(المطلوب);
    أرجع نصان_متساويان(&أ, &ب);
}

عرف ابحث_فاصل_سطر_ويب(البايتات: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف + 1) < العدد) {
        لو ((بايت_عميل_ويب_عند(البايتات, ف) == 0x0D) && (بايت_عميل_ويب_عند(البايتات, ف + 1) == 0x0A)) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف ابحث_نهاية_رؤوس_عميل(البايتات: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع ف: متغير غير_موقع = البداية;
    بينما ((ف + 3) < العدد) {
        لو ((بايت_عميل_ويب_عند(البايتات, ف) == 0x0D) && (بايت_عميل_ويب_عند(البايتات, ف + 1) == 0x0A)
            && (بايت_عميل_ويب_عند(البايتات, ف + 2) == 0x0D) && (بايت_عميل_ويب_عند(البايتات, ف + 3) == 0x0A)) {
            أرجع اختيار.بعض(ف);
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف حلل_منفذا_عميل(القيمة: &نص): اختيار غ16 {
    طابق حلل_غير_موقع(القيمة) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(المنفذ) -> {
        لو ((المنفذ == 0) || (المنفذ > 65535)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(المنفذ مثل غ16);
    };
}

عرف حلل_وجهة_عميل(الرابط: &نص): نتيجة وجهة_عميل_ويب, خطأ_عميل_ويب {
    دع العنوان: متغير عنوان_موحد;
    طابق حلل_عنوانا_موحدا(الرابط) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; };

    دع http: نص = «http»;
    دع https: نص = «https»;
    دع آمن: متغير منطقي = خطأ;
    دع المنفذ: متغير غ16 = 80;
    لو (نص_أسكي_يساوي_عميل(&العنوان.المخطط, &https)) { آمن := صواب; المنفذ := 443; }
    وإلا لو (!نص_أسكي_يساوي_عميل(&العنوان.المخطط, &http)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.مخطط_غير_مدعوم()); };

    دع السلطة: متغير نص = «»;
    طابق العنوان.السلطة مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); }
    | اختيار.بعض(قيمة) -> { السلطة := قيمة; };
    لو ((الطول(السلطة) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };

    دع المضيف: متغير نص = السلطة;
    لو (السلطة[0] == 0x5B) {
        دع نهاية_المضيف: متغير غير_موقع = 1;
        بينما ((نهاية_المضيف < (الطول(السلطة) مثل غير_موقع)) && (السلطة[نهاية_المضيف] != 0x5D)) { نهاية_المضيف := نهاية_المضيف + 1; }
        لو (نهاية_المضيف >= (الطول(السلطة) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        طابق مقطع_نص(&السلطة, 1, نهاية_المضيف - 1) مع
        | اختيار.بعض(قيمة) -> { المضيف := قيمة; }
        | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        لو ((نهاية_المضيف + 1) < (الطول(السلطة) مثل غير_موقع)) {
            دع موضع_فاصل_المنفذ: غير_موقع = نهاية_المضيف + 1;
            لو (السلطة[موضع_فاصل_المنفذ] != 0x3A) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            دع نص_المنفذ: متغير نص = «»;
            دع بداية_المنفذ: غير_موقع = نهاية_المضيف + 2;
            طابق مقطع_نص(&السلطة, بداية_المنفذ, (الطول(السلطة) مثل غير_موقع) - بداية_المنفذ) مع
            | اختيار.بعض(قيمة) -> { نص_المنفذ := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            طابق حلل_منفذا_عميل(&نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { المنفذ := قيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        };
    } وإلا {
        دع موضع_النقطتين: متغير اختيار غير_موقع = اختيار.لا_شيء();
        دع ف: متغير غير_موقع = 0;
        بينما (ف < (الطول(السلطة) مثل غير_موقع)) {
            لو (السلطة[ف] == 0x3A) { موضع_النقطتين := اختيار.بعض(ف); };
            ف := ف + 1;
        }
        طابق موضع_النقطتين مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الموضع) -> {
            طابق مقطع_نص(&السلطة, 0, الموضع) مع
            | اختيار.بعض(قيمة) -> { المضيف := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            دع نص_المنفذ: متغير نص = «»;
            طابق مقطع_نص(&السلطة, الموضع + 1, (الطول(السلطة) مثل غير_موقع) - الموضع - 1) مع
            | اختيار.بعض(قيمة) -> { نص_المنفذ := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            طابق حلل_منفذا_عميل(&نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { المنفذ := قيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        };
    };
    لو ((الطول(المضيف) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };

    دع الهدف: متغير نص = العنوان.المسار;
    لو ((الطول(الهدف) مثل غير_موقع) == 0) { الهدف := «/»; };
    طابق العنوان.الاستعلام مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الاستعلام) -> {
        دع ب: متغير متجه غ8 = [];
        ألحق_نص_عميل(&متغير ب, &الهدف);
        ألحق(ب, 0x3F);
        ألحق_نص_عميل(&متغير ب, &الاستعلام);
        الهدف := من_بايتات(&ب);
    };

    دع الناتج: وجهة_عميل_ويب = { المضيف: المضيف, المنفذ: المنفذ, الهدف: الهدف, آمن: آمن, السلطة: السلطة };
    أرجع نتيجة.نجح(الناتج);
}

عرف قيمة_رأس_عميل_صالحة(القيمة: &نص): منطقي {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        دع ب: غ8 = (*القيمة)[ف];
        لو ((ب == 0) || (ب == 0x0D) || (ب == 0x0A) || ((ب < 0x20) && (ب != 0x09)) || (ب == 0x7F)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف هدف_طلب_عميل_صالح(الهدف: &نص): منطقي {
    لو ((الطول(*الهدف) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الهدف) مثل غير_موقع)) {
        دع ب: غ8 = (*الهدف)[ف];
        لو ((ب <= 0x20) || (ب == 0x7F)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف إصدار_إلى_نص_عميل(الإصدار: إصدار_ويب): اختيار نص {
    طابق الإصدار مع
    | إصدار_ويب.واحد_صفر -> { أرجع اختيار.بعض(«HTTP/1.0»); }
    | إصدار_ويب.واحد_واحد -> { أرجع اختيار.بعض(«HTTP/1.1»); }
    | _ -> { أرجع اختيار.لا_شيء(); };
}

عام عرف سلسل_طلب_ويب1(الطلب: &طلب_ويب_مخزن): نتيجة متجه غ8, خطأ_عميل_ويب {
    لو (!طريقة_ويب_صالحة(&(*الطلب).الطريقة) || !هدف_طلب_عميل_صالح(&(*الطلب).الهدف)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); };
    دع نص_الإصدار: متغير نص = «»;
    طابق إصدار_إلى_نص_عميل((*الطلب).الإصدار) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); }
    | اختيار.بعض(قيمة) -> { نص_الإصدار := قيمة; };
    دع الناتج: متغير متجه غ8 = [];
    ألحق_نص_عميل(&متغير الناتج, &(*الطلب).الطريقة); ألحق(الناتج, 0x20);
    ألحق_نص_عميل(&متغير الناتج, &(*الطلب).الهدف); ألحق(الناتج, 0x20);
    ألحق_نص_عميل(&متغير الناتج, &نص_الإصدار); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول((*الطلب).الرؤوس) مثل غير_موقع)) {
        لو (!طريقة_ويب_صالحة(&(*الطلب).الرؤوس[ف].الاسم) || !قيمة_رأس_عميل_صالحة(&(*الطلب).الرؤوس[ف].القيمة)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); };
        ألحق_نص_عميل(&متغير الناتج, &(*الطلب).الرؤوس[ف].الاسم); ألحق(الناتج, 0x3A); ألحق(الناتج, 0x20);
        ألحق_نص_عميل(&متغير الناتج, &(*الطلب).الرؤوس[ف].القيمة); ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
        ف := ف + 1;
    }
    ألحق(الناتج, 0x0D); ألحق(الناتج, 0x0A);
    ف := 0;
    بينما (ف < (الطول((*الطلب).الجسم) مثل غير_موقع)) { ألحق(الناتج, (*الطلب).الجسم[ف]); ف := ف + 1; }
    أرجع نتيجة.نجح(الناتج);
}

عرف قيمة_سداسية_عميل(ب: غ8): عدد {
    لو ((ب >= 0x30) && (ب <= 0x39)) { أرجع (ب - 0x30) مثل عدد; };
    لو ((ب >= 0x41) && (ب <= 0x46)) { أرجع ((ب - 0x41) + 10) مثل عدد; };
    لو ((ب >= 0x61) && (ب <= 0x66)) { أرجع ((ب - 0x61) + 10) مثل عدد; };
    أرجع -1;
}

عرف حلل_حجم_قطعة_عميل(البايتات: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): اختيار غير_موقع {
    دع القيمة: متغير غير_موقع = 0;
    دع رأى_رقما: متغير منطقي = خطأ;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) {
        دع ب: غ8 = بايت_عميل_ويب_عند(البايتات, ف);
        لو (ب == 0x3B) { ف := النهاية; }
        وإلا {
            دع الرقم: عدد = قيمة_سداسية_عميل(ب);
            لو (الرقم < 0) { أرجع اختيار.لا_شيء(); };
            رأى_رقما := صواب;
            لو (القيمة > ((~((0 مثل غير_موقع)) - (الرقم مثل غير_موقع)) / 16)) { أرجع اختيار.لا_شيء(); };
            القيمة := القيمة * 16 + (الرقم مثل غير_موقع);
            ف := ف + 1;
        };
    }
    لو (!رأى_رقما) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(القيمة);
}

عرف حلل_رأسا_عميل(البايتات: &متجه غ8, البداية: غير_موقع, النهاية: غير_موقع): اختيار رأس_ويب {
    دع موضع: متغير غير_موقع = البداية;
    بينما ((موضع < النهاية) && (بايت_عميل_ويب_عند(البايتات, موضع) != 0x3A)) { موضع := موضع + 1; }
    لو ((موضع == البداية) || (موضع >= النهاية)) { أرجع اختيار.لا_شيء(); };
    دع الاسم: نص = نص_مدى_عميل(البايتات, البداية, موضع);
    لو (!طريقة_ويب_صالحة(&الاسم)) { أرجع اختيار.لا_شيء(); };
    موضع := موضع + 1;
    بينما ((موضع < النهاية) && ((بايت_عميل_ويب_عند(البايتات, موضع) == 0x20) || (بايت_عميل_ويب_عند(البايتات, موضع) == 0x09))) { موضع := موضع + 1; }
    دع آخر: متغير غير_موقع = النهاية;
    بينما ((آخر > موضع) && ((بايت_عميل_ويب_عند(البايتات, آخر - 1) == 0x20) || (بايت_عميل_ويب_عند(البايتات, آخر - 1) == 0x09))) { آخر := آخر - 1; }
    دع القيمة: نص = نص_مدى_عميل(البايتات, موضع, آخر);
    لو (!قيمة_رأس_عميل_صالحة(&القيمة)) { أرجع اختيار.لا_شيء(); };
    دع الرأس: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
    أرجع اختيار.بعض(الرأس);
}

عرف حلل_سطر_حالة_عميل(البايتات: &متجه غ8, النهاية: غير_موقع): اختيار استجابة_ويب_مخزنة {
    لو (النهاية < 12) { أرجع اختيار.لا_شيء(); };
    دع الإصدار: متغير إصدار_ويب = إصدار_ويب.واحد_واحد();
    دع بادئة10: نص = «HTTP/1.0»; دع بادئة11: نص = «HTTP/1.1»;
    دع أول: نص = نص_مدى_عميل(البايتات, 0, 8);
    لو (نصان_متساويان(&أول, &بادئة10)) { الإصدار := إصدار_ويب.واحد_صفر(); }
    وإلا لو (!نصان_متساويان(&أول, &بادئة11)) { أرجع اختيار.لا_شيء(); };
    لو (بايت_عميل_ويب_عند(البايتات, 8) != 0x20) { أرجع اختيار.لا_شيء(); };
    دع نص_الحالة: نص = نص_مدى_عميل(البايتات, 9, 12);
    دع الحالة: متغير غير_موقع = 0;
    طابق حلل_غير_موقع(&نص_الحالة) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(قيمة) -> { الحالة := قيمة; };
    لو ((الحالة < 100) || (الحالة > 999)) { أرجع اختيار.لا_شيء(); };
    دع رؤوس: متجه رأس_ويب = []; دع لاحقة: متجه رأس_ويب = []; دع جسم: متجه غ8 = [];
    دع الاستجابة: استجابة_ويب_مخزنة = { الإصدار: الإصدار, الحالة: الحالة, الرؤوس: رؤوس, الرؤوس_اللاحقة: لاحقة, الجسم: جسم };
    أرجع اختيار.بعض(الاستجابة);
}

عرف رأس_عميل_الأول(الرؤوس: &متجه رأس_ويب, الاسم: &نص): اختيار نص {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الرؤوس) مثل غير_موقع)) {
        لو (نص_أسكي_يساوي_عميل(&(*الرؤوس)[ف].الاسم, الاسم)) { أرجع اختيار.بعض((*الرؤوس)[ف].القيمة); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف رأس_لاحق_عميل_ممنوع(الرأس: &رأس_ويب): منطقي {
    دع طول: نص = «content-length»;
    دع نقل: نص = «transfer-encoding»;
    دع مضيف: نص = «host»;
    أرجع نص_أسكي_يساوي_عميل(&(*الرأس).الاسم, &طول)
        || نص_أسكي_يساوي_عميل(&(*الرأس).الاسم, &نقل)
        || نص_أسكي_يساوي_عميل(&(*الرأس).الاسم, &مضيف);
}

عرف حلل_جسم_مجزأ_عميل(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    حد_أقصى: غير_موقع
): نتيجة استجابة_ويب_محللة, خطأ_عميل_ويب {
    دع الجسم: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = البداية;
    دع استجابة_فارغة: استجابة_ويب_مخزنة = استجابة_ويب_مخزنة_جديدة(200, الجسم);
    بينما (صواب) {
        دع نهاية_السطر: متغير غير_موقع = 0;
        طابق ابحث_فاصل_سطر_ويب(البايتات, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); }
        | اختيار.بعض(قيمة) -> { نهاية_السطر := قيمة; };
        دع الحجم: متغير غير_موقع = 0;
        طابق حلل_حجم_قطعة_عميل(البايتات, الموضع, نهاية_السطر) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
        | اختيار.بعض(قيمة) -> { الحجم := قيمة; };
        الموضع := نهاية_السطر + 2;
        لو (الحجم == 0) {
            // A zero chunk is followed by zero or more trailer fields and one
            // empty line. Preserve valid trailers for callers.
            بينما (صواب) {
                دع نهاية_اللاحق: متغير غير_موقع = 0;
                طابق ابحث_فاصل_سطر_ويب(البايتات, الموضع) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); }
                | اختيار.بعض(ق) -> { نهاية_اللاحق := ق; };
                لو (نهاية_اللاحق == الموضع) {
                    دع الناتج: استجابة_ويب_محللة = { الاستجابة: استجابة_فارغة, المستهلك: الموضع + 2 };
                    أرجع نتيجة.نجح(الناتج);
                };
                طابق حلل_رأسا_عميل(البايتات, الموضع, نهاية_اللاحق) مع
                | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
                | اختيار.بعض(الرأس) -> {
                    لو (رأس_لاحق_عميل_ممنوع(&الرأس)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); };
                    ألحق(استجابة_فارغة.الرؤوس_اللاحقة, الرأس);
                };
                الموضع := نهاية_اللاحق + 2;
            }
        };
        لو ((حد_أقصى > 0) && (((الطول(الجسم) مثل غير_موقع) + الحجم) > حد_أقصى)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_كبيرة()); };
        لو ((موضع + الحجم + 2) > (الطول(*البايتات) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); };
        دع ف: متغير غير_موقع = 0;
        بينما (ف < الحجم) { ألحق(الجسم, بايت_عميل_ويب_عند(البايتات, موضع + ف)); ف := ف + 1; }
        الموضع := الموضع + الحجم;
        لو ((بايت_عميل_ويب_عند(البايتات, موضع) != 0x0D) || (بايت_عميل_ويب_عند(البايتات, موضع + 1) != 0x0A)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); };
        الموضع := الموضع + 2;
        استجابة_فارغة.الجسم := الجسم;
    }
    أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة());
}

عرف طول_محتوى_استجابة_عميل(الرؤوس: &متجه رأس_ويب): نتيجة اختيار غير_موقع, خطأ_عميل_ويب {
    دع الاسم: نص = «content-length»;
    دع القيم: متجه نص = قيم_رأس_ويب(الرؤوس, &الاسم);
    لو ((الطول(القيم) مثل غير_موقع) == 0) { أرجع نتيجة.نجح(اختيار.لا_شيء()); };
    دع المتوقع: متغير غير_موقع = 0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        دع الحالي: متغير غير_موقع = 0;
        طابق حلل_غير_موقع(&القيم[ف]) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
        | نتيجة.نجح(ق) -> { الحالي := ق; };
        لو (ف == 0) { المتوقع := الحالي; }
        وإلا لو (الحالي != المتوقع) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(اختيار.بعض(المتوقع));
}

عرف حلل_استجابة_ويب1_داخليا(
    البايتات: &متجه غ8,
    انتهى_المدخل: منطقي,
    حد_أقصى_للجسم: غير_موقع,
    استجابة_بلا_جسم: منطقي
): نتيجة استجابة_ويب_محللة, خطأ_عميل_ويب {
    دع نهاية_سطر_الحالة: متغير غير_موقع = 0;
    طابق ابحث_فاصل_سطر_ويب(البايتات, 0) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); }
    | اختيار.بعض(قيمة) -> { نهاية_سطر_الحالة := قيمة; };
    دع الاستجابة: متغير استجابة_ويب_مخزنة;
    طابق حلل_سطر_حالة_عميل(البايتات, نهاية_سطر_الحالة) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
    | اختيار.بعض(قيمة) -> { الاستجابة := قيمة; };
    دع بداية_الرؤوس: غير_موقع = نهاية_سطر_الحالة + 2;
    دع نهاية_الرؤوس: متغير غير_موقع = 0;
    طابق ابحث_نهاية_رؤوس_عميل(البايتات, بداية_الرؤوس) مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); }
    | اختيار.بعض(قيمة) -> { نهاية_الرؤوس := قيمة; };
    دع الموضع: متغير غير_موقع = بداية_الرؤوس;
    بينما (الموضع < نهاية_الرؤوس) {
        دع نهاية_السطر: متغير غير_موقع = 0;
        طابق ابحث_فاصل_سطر_ويب(البايتات, الموضع) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
        | اختيار.بعض(قيمة) -> { نهاية_السطر := قيمة; };
        طابق حلل_رأسا_عميل(البايتات, الموضع, نهاية_السطر) مع
        | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); }
        | اختيار.بعض(الرأس) -> { ألحق(استجابة.الرؤوس, الرأس); };
        الموضع := نهاية_السطر + 2;
    }
    دع بداية_الجسم: غير_موقع = نهاية_الرؤوس + 4;
    دع دون_جسم: منطقي = استجابة_بلا_جسم || ((استجابة.الحالة >= 100) && (استجابة.الحالة < 200)) || (استجابة.الحالة == 204) || (استجابة.الحالة == 304);
    لو (دون_جسم) {
        دع الناتج: استجابة_ويب_محللة = { الاستجابة: الاستجابة, المستهلك: بداية_الجسم };
        أرجع نتيجة.نجح(الناتج);
    };
    دع اسم_النقل: نص = «transfer-encoding»;
    طابق رأس_عميل_الأول(&استجابة.الرؤوس, &اسم_النقل) مع
    | اختيار.بعض(القيمة) -> {
        دع chunked: نص = «chunked»;
        لو (!نص_أسكي_يساوي_عميل(&القيمة, &chunked)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة()); };
        طابق حلل_جسم_مجزأ_عميل(البايتات, بداية_الجسم, حد_أقصى_للجسم) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المحلل) -> {
            الاستجابة.الجسم := المحلل.الاستجابة.الجسم;
            الاستجابة.الرؤوس_اللاحقة := المحلل.الاستجابة.الرؤوس_اللاحقة;
            دع الناتج: استجابة_ويب_محللة = { الاستجابة: الاستجابة, المستهلك: المحلل.المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    | اختيار.لا_شيء -> { };
    طابق طول_محتوى_استجابة_عميل(&استجابة.الرؤوس) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الطول_المعلن) -> {
        طابق الطول_المعلن مع
        | اختيار.بعض(الحجم) -> {
            لو ((حد_أقصى_للجسم > 0) && (الحجم > حد_أقصى_للجسم)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_كبيرة()); };
            لو ((بداية_الجسم + الحجم) > (الطول(*البايتات) مثل غير_موقع)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); };
            دع ف: متغير غير_موقع = 0;
            بينما (ف < الحجم) { ألحق(استجابة.الجسم, بايت_عميل_ويب_عند(البايتات, بداية_الجسم + ف)); ف := ف + 1; }
            دع الناتج: استجابة_ويب_محللة = { الاستجابة: الاستجابة, المستهلك: بداية_الجسم + الحجم };
            أرجع نتيجة.نجح(الناتج);
        }
        | اختيار.لا_شيء -> { };
    };
    لو (!انتهى_المدخل) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); };
    دع الحجم: غير_موقع = (الطول(*البايتات) مثل غير_موقع) - بداية_الجسم;
    لو ((حد_أقصى_للجسم > 0) && (الحجم > حد_أقصى_للجسم)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_كبيرة()); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق(استجابة.الجسم, بايت_عميل_ويب_عند(البايتات, بداية_الجسم + ف)); ف := ف + 1; }
    دع الناتج: استجابة_ويب_محللة = { الاستجابة: الاستجابة, المستهلك: الطول(*البايتات) مثل غير_موقع };
    أرجع نتيجة.نجح(الناتج);
}

عام عرف حلل_استجابة_ويب1(
    البايتات: &متجه غ8,
    انتهى_المدخل: منطقي,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_محللة, خطأ_عميل_ويب {
    أرجع حلل_استجابة_ويب1_داخليا(البايتات, انتهى_المدخل, حد_أقصى_للجسم, خطأ);
}

عرف حل_عنوان_عميل(المضيف: &نص, المنفذ: غ16): نتيجة عنوان_مقبس, خطأ_عميل_ويب {
    طابق حلل_عنوان_آيبي(المضيف) مع
    | نتيجة.نجح(الآيبي) -> { أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ)); }
    | نتيجة.خطأ(_) -> { };
    طابق حل_اسم_مضيف4(المضيف, المنفذ) مع
    | نتيجة.نجح(العنوان) -> { أرجع نتيجة.نجح(العنوان); }
    | نتيجة.خطأ(_) -> { };
    طابق حل_اسم_مضيف6(المضيف, المنفذ) مع
    | نتيجة.نجح(العنوان) -> { أرجع نتيجة.نجح(العنوان); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); };
}

عرف ألحق_رأس_إن_غاب(الطلب: &متغير طلب_ويب_مخزن, الاسم: &نص, القيمة: &نص): فراغ {
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, الاسم) مع
    | اختيار.بعض(_) -> { }
    | اختيار.لا_شيء -> { دع الرأس: رأس_ويب = { الاسم: *الاسم, القيمة: *القيمة }; ألحق((*الطلب).الرؤوس, الرأس); };
}

عرف هيئ_طلب_عميل(الطريقة: &نص, الوجهة: &وجهة_عميل_ويب, الرؤوس: &متجه رأس_ويب, الجسم: &متجه غ8): طلب_ويب_مخزن {
    دع نسخة_رؤوس: متجه رأس_ويب = *الرؤوس;
    دع لاحقة: متجه رأس_ويب = [];
    دع نسخة_جسم: متجه غ8 = *الجسم;
    دع الطلب: متغير طلب_ويب_مخزن = { الطريقة: *الطريقة, الهدف: (*الوجهة).الهدف, الإصدار: إصدار_ويب.واحد_واحد(), الرؤوس: نسخة_رؤوس, الرؤوس_اللاحقة: لاحقة, الجسم: نسخة_جسم };
    دع host: نص = «Host»; ألحق_رأس_إن_غاب(&متغير الطلب, &host, &(*الوجهة).السلطة);
    دع connection: نص = «Connection»; دع close: نص = «close»; ألحق_رأس_إن_غاب(&متغير الطلب, &connection, &close);
    دع content_length: نص = «Content-Length»;
    طابق أول_قيمة_رأس_ويب(&الطلب.الرؤوس, &content_length) مع
    | اختيار.بعض(_) -> { }
    | اختيار.لا_شيء -> {
        لو ((الطول(الطلب.الجسم) مثل غير_موقع) > 0) {
            دع قيمة_الطول: نص = غير_موقع_إلى_نص(الطول(الطلب.الجسم) مثل غير_موقع);
            دع الرأس: رأس_ويب = { الاسم: content_length, القيمة: قيمة_الطول };
            ألحق(الطلب.الرؤوس, الرأس);
        };
    };
    أرجع الطلب;
}

عرف اقرأ_استجابة_من_قارئ<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    حد_أقصى: غير_موقع,
    استجابة_بلا_جسم: منطقي
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع البايتات: متغير متجه غ8 = [];
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8192) { ألحق(المخزن, 0); ف := ف + 1; }
    بينما (صواب) {
        طابق حلل_استجابة_ويب1_داخليا(&البايتات, خطأ, حد_أقصى, استجابة_بلا_جسم) مع
        | نتيجة.نجح(المحلل) -> {
            لو ((المحلل.الاستجابة.الحالة >= 100) && (المحلل.الاستجابة.الحالة < 200) && (المحلل.الاستجابة.الحالة != 101)) {
                دع الباقي: متغير متجه غ8 = [];
                دع م: متغير غير_موقع = المحلل.المستهلك;
                بينما (م < (الطول(البايتات) مثل غير_موقع)) { ألحق(الباقي, البايتات[م]); م := م + 1; }
                البايتات := الباقي;
            } وإلا { أرجع نتيجة.نجح(المحلل.الاستجابة); };
        }
        | نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة) -> { }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        طابق القراءة(المصدر, &متغير المخزن, 0, 8192) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
        | نتيجة.نجح(المقروء) -> {
            لو (المقروء == 0) {
                طابق حلل_استجابة_ويب1_داخليا(&البايتات, صواب, حد_أقصى, استجابة_بلا_جسم) مع
                | نتيجة.نجح(المحلل) -> { أرجع نتيجة.نجح(المحلل.الاستجابة); }
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
            };
            دع ك: متغير غير_موقع = 0;
            بينما (ك < (المقروء مثل غير_موقع)) { ألحق(البايتات, المخزن[ك]); ك := ك + 1; }
            لو ((حد_أقصى > 0) && ((الطول(البايتات) مثل غير_موقع) > (حد_أقصى + 1048576))) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_كبيرة()); };
        };
    }
    أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة());
}

عام عرف نفذ_طلب_ويب(
    الطريقة: &نص,
    الرابط: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه غ8,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع الوجهة: متغير وجهة_عميل_ويب;
    طابق حلل_وجهة_عميل(الرابط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { الوجهة := قيمة; };
    دع الطلب: طلب_ويب_مخزن = هيئ_طلب_عميل(الطريقة, &الوجهة, الرؤوس, الجسم);
    دع طريقة_رأس: نص = «HEAD»;
    دع استجابة_بلا_جسم: منطقي = نص_أسكي_يساوي_عميل(الطريقة, &طريقة_رأس);
    دع المرسل: متغير متجه غ8 = [];
    طابق سلسل_طلب_ويب1(&الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { المرسل := قيمة; };
    دع العنوان: متغير عنوان_مقبس;
    طابق حل_عنوان_عميل(&الوجهة.المضيف, الوجهة.المنفذ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; };
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(التدفق) -> {
        لو (!الوجهة.آمن) {
            طابق اكتب_الكل(&التدفق, اكتب_تي_سي_بي, &المرسل) مع
            | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق); أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
            | نتيجة.نجح(_) -> { };
            دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = اقرأ_استجابة_من_قارئ(&التدفق, اقرأ_تي_سي_بي, حد_أقصى_للجسم, استجابة_بلا_جسم);
            دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
            أرجع الناتج;
        };
        دع الإعداد: إعداد_عميل_تي_إل_إس = إعداد_عميل_تي_إل_إس_افتراضي(&الوجهة.المضيف);
        طابق اتصل_عميل_تي_إل_إس(التدفق, &الإعداد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
        | نتيجة.نجح(الآمن) -> {
            طابق اكتب_الكل(&الآمن, اكتب_تدفق_تي_إل_إس, &المرسل) مع
            | نتيجة.خطأ(الخطأ) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن); أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
            | نتيجة.نجح(_) -> { };
            دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = اقرأ_استجابة_من_قارئ(&الآمن, اقرأ_تدفق_تي_إل_إس, حد_أقصى_للجسم, استجابة_بلا_جسم);
            دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_إل_إس(الآمن);
            أرجع الناتج;
        };
    };
}

عام عرف اجلب_ويب(الرابط: &نص, حد_أقصى_للجسم: غير_موقع): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع الطريقة: نص = «GET»; دع الرؤوس: متجه رأس_ويب = []; دع الجسم: متجه غ8 = [];
    أرجع نفذ_طلب_ويب(&الطريقة, الرابط, &الرؤوس, &الجسم, حد_أقصى_للجسم);
}

عام نوع http_client_error = خطأ_عميل_ويب;
عام نوع parsed_http_response = استجابة_ويب_محللة;
عام مرادف serialize_http1_request = سلسل_طلب_ويب1;
عام مرادف parse_http1_response = حلل_استجابة_ويب1;
عام مرادف http_request_execute = نفذ_طلب_ويب;
عام مرادف http_get = اجلب_ويب;
