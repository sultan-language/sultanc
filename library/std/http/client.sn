استورد io.reader;
استورد io.writer;
استورد net.dns;
استورد net.ip;
استورد net.socket_address;
استورد net.tcp;
استورد text.compare;
استورد text.from_bytes;
استورد text.number;
استورد text.substring;
استورد tls.config;
استورد tls.stream;
استورد uri.uri;
استورد http.model;
استورد http.limits;
استورد http.http1.common;
استورد http.http1.request_writer;
استورد http.http1.response_parser;
استورد http.http1.connection;

// Transport/client errors are kept separate from the canonical HTTP wire error.
عام نوع خطأ_عميل_ويب =
    | عنوان_غير_صالح
    | مخطط_غير_مدعوم
    | سلطة_غير_صالحة
    | طلب_غير_صالح
    | استجابة_غير_مكتملة
    | استجابة_غير_صالحة
    | استجابة_كبيرة
    | اتصال_غير_قابل_لإعادة_الاستخدام
    | نفق_اتصال
    | ترقية_بروتوكول
    | شبكة بنوع عدد
;

// Compatibility shape retained for parse_http1_response.
عام نوع استجابة_ويب_محللة = {
    الاستجابة: استجابة_ويب_مخزنة,
    المستهلك: غير_موقع
};

نوع وجهة_عميل_ويب = {
    المضيف: نص,
    المنفذ: غ16,
    الهدف: نص,
    آمن: منطقي,
    السلطة: نص
};

عام نوع اتصال_عميل_ويب_عادي = {
    التدفق: تدفق_تي_سي_بي,
    المضيف: نص,
    السلطة: نص,
    المخزن: متجه غ8,
    قابل_لإعادة_الاستخدام: منطقي
};

عام نوع اتصال_عميل_ويب_آمن = {
    التدفق: تدفق_تي_إل_إس,
    المضيف: نص,
    السلطة: نص,
    المخزن: متجه غ8,
    قابل_لإعادة_الاستخدام: منطقي
};

عام نوع حالة_عميل_ويب =
    | بلا_اتصال
    | عادي بنوع اتصال_عميل_ويب_عادي
    | آمن بنوع اتصال_عميل_ويب_آمن
;

عام نوع عميل_ويب = {
    الاتصال: حالة_عميل_ويب
};

عرف ألحق_نص_عميل(الناتج: &متغير متجه غ8, النص: &نص): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*النص) مثل غير_موقع)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عرف نص_أسكي_صغير_عميل(القيمة: &نص): نص {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*القيمة) مثل غير_موقع)) {
        دع ب: متغير غ8 = (*القيمة)[ف];
        لو ((ب >= 0x41) && (ب <= 0x5A)) { ب := ب + 0x20; };
        ألحق(الناتج, ب);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الناتج);
}

عرف نص_أسكي_يساوي_عميل(القيمة: &نص, المطلوب: &نص): منطقي {
    دع أ: نص = نص_أسكي_صغير_عميل(القيمة);
    دع ب: نص = نص_أسكي_صغير_عميل(المطلوب);
    أرجع نصان_متساويان(&أ, &ب);
}

عرف حلل_منفذا_عميل(القيمة: &نص): اختيار غ16 {
    طابق حلل_غير_موقع(القيمة) مع
    | نتيجة.خطأ(_) -> { أرجع اختيار.لا_شيء(); }
    | نتيجة.نجح(المنفذ) -> {
        لو ((المنفذ == 0) || (المنفذ > 65535)) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(المنفذ مثل غ16);
    };
}

عرف حلل_وجهة_عميل(الرابط: &نص): نتيجة وجهة_عميل_ويب, خطأ_عميل_ويب {
    دع العنوان: متغير عنوان_موحد;
    طابق حلل_عنوانا_موحدا(الرابط) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.عنوان_غير_صالح()); }
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; };

    دع http: نص = «http»;
    دع https: نص = «https»;
    دع آمن: متغير منطقي = خطأ;
    دع المنفذ: متغير غ16 = 80;
    لو (نص_أسكي_يساوي_عميل(&العنوان.المخطط, &https)) { آمن := صواب; المنفذ := 443; }
    وإلا لو (!نص_أسكي_يساوي_عميل(&العنوان.المخطط, &http)) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.مخطط_غير_مدعوم()); };

    دع السلطة: متغير نص = «»;
    طابق العنوان.السلطة مع
    | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); }
    | اختيار.بعض(قيمة) -> { السلطة := قيمة; };
    دع طول_السلطة: غير_موقع = الطول(السلطة) مثل غير_موقع;
    لو (طول_السلطة == 0) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };

    دع المضيف: متغير نص = السلطة;
    لو (السلطة[0] == 0x5B) {
        دع نهاية_المضيف: متغير غير_موقع = 1;
        بينما ((نهاية_المضيف < طول_السلطة) && (السلطة[نهاية_المضيف] != 0x5D)) { نهاية_المضيف := نهاية_المضيف + 1; }
        لو (نهاية_المضيف >= طول_السلطة) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        طابق مقطع_نص(&السلطة, 1, نهاية_المضيف - 1) مع
        | اختيار.بعض(قيمة) -> { المضيف := قيمة; }
        | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        دع بعد_نهاية_المضيف: غير_موقع = نهاية_المضيف + 1;
        لو (بعد_نهاية_المضيف < طول_السلطة) {
            لو (السلطة[بعد_نهاية_المضيف] != 0x3A) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            دع بداية_المنفذ: غير_موقع = نهاية_المضيف + 2;
            دع نص_المنفذ: متغير نص = «»;
            دع طول_نص_المنفذ: غير_موقع = طول_السلطة - بداية_المنفذ;
            طابق مقطع_نص(&السلطة, بداية_المنفذ, طول_نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { نص_المنفذ := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            طابق حلل_منفذا_عميل(&نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { المنفذ := قيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        };
    } وإلا {
        دع موضع_النقطتين: متغير اختيار غير_موقع = اختيار.لا_شيء();
        دع ف: متغير غير_موقع = 0;
        بينما (ف < طول_السلطة) { لو (السلطة[ف] == 0x3A) { موضع_النقطتين := اختيار.بعض(ف); }; ف := ف + 1; }
        طابق موضع_النقطتين مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(الموضع) -> {
            طابق مقطع_نص(&السلطة, 0, الموضع) مع
            | اختيار.بعض(قيمة) -> { المضيف := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            دع نص_المنفذ: متغير نص = «»;
            دع بداية_المنفذ: غير_موقع = الموضع + 1;
            دع طول_نص_المنفذ: غير_موقع = طول_السلطة - بداية_المنفذ;
            طابق مقطع_نص(&السلطة, بداية_المنفذ, طول_نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { نص_المنفذ := قيمة; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
            طابق حلل_منفذا_عميل(&نص_المنفذ) مع
            | اختيار.بعض(قيمة) -> { المنفذ := قيمة; }
            | اختيار.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };
        };
    };
    لو ((الطول(المضيف) مثل غير_موقع) == 0) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.سلطة_غير_صالحة()); };

    دع الهدف: متغير نص = العنوان.المسار;
    لو ((الطول(الهدف) مثل غير_موقع) == 0) { الهدف := «/»; };
    طابق العنوان.الاستعلام مع
    | اختيار.لا_شيء -> { }
    | اختيار.بعض(الاستعلام) -> {
        دع ب: متغير متجه غ8 = [];
        ألحق_نص_عميل(&متغير ب, &الهدف); ألحق(ب, 0x3F); ألحق_نص_عميل(&متغير ب, &الاستعلام);
        الهدف := من_بايتات(&ب);
    };
    دع الناتج: وجهة_عميل_ويب = { المضيف: المضيف, المنفذ: المنفذ, الهدف: الهدف, آمن: آمن, السلطة: السلطة };
    أرجع نتيجة.نجح(الناتج);
}

عرف حل_عنوان_عميل(المضيف: &نص, المنفذ: غ16): نتيجة عنوان_مقبس, خطأ_عميل_ويب {
    طابق حلل_عنوان_آيبي(المضيف) مع
    | نتيجة.نجح(الآيبي) -> { أرجع نتيجة.نجح(أنشئ_عنوان_مقبس(الآيبي, المنفذ)); }
    | نتيجة.خطأ(_) -> { };
    طابق حل_اسم_مضيف4(المضيف, المنفذ) مع
    | نتيجة.نجح(العنوان) -> { أرجع نتيجة.نجح(العنوان); }
    | نتيجة.خطأ(_) -> { };
    طابق حل_اسم_مضيف6(المضيف, المنفذ) مع
    | نتيجة.نجح(العنوان) -> { أرجع نتيجة.نجح(العنوان); }
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); };
}

عرف خطأ_استجابة_من_ويب(الخطأ: &خطأ_ويب): خطأ_عميل_ويب {
    طابق (*الخطأ).الصنف مع
    | صنف_خطأ_ويب.غير_مكتمل -> { أرجع خطأ_عميل_ويب.استجابة_غير_مكتملة(); }
    | صنف_خطأ_ويب.جسم_كبير -> { أرجع خطأ_عميل_ويب.استجابة_كبيرة(); }
    | صنف_خطأ_ويب.سطر_بداية_طويل -> { أرجع خطأ_عميل_ويب.استجابة_كبيرة(); }
    | صنف_خطأ_ويب.سطر_قطعة_طويل -> { أرجع خطأ_عميل_ويب.استجابة_كبيرة(); }
    | صنف_خطأ_ويب.قسم_رؤوس_كبير -> { أرجع خطأ_عميل_ويب.استجابة_كبيرة(); }
    | صنف_خطأ_ويب.رؤوس_كثيرة -> { أرجع خطأ_عميل_ويب.استجابة_كبيرة(); }
    | _ -> { أرجع خطأ_عميل_ويب.استجابة_غير_صالحة(); };
}

عرف حدود_استجابة_عميل(حد_أقصى_للجسم: غير_موقع): حدود_استجابة_ويب1 {
    دع الحدود: متغير حدود_استجابة_ويب1 = حدود_استجابة_ويب1_افتراضية();
    لو (حد_أقصى_للجسم == 0) { الحدود.أقصى_بايتات_جسم := ~((0 مثل غير_موقع)); }
    وإلا { الحدود.أقصى_بايتات_جسم := حد_أقصى_للجسم; };
    أرجع الحدود;
}

عام عرف سلسل_طلب_ويب1(الطلب: &طلب_ويب_مخزن): نتيجة متجه غ8, خطأ_عميل_ويب {
    طابق سلسل_طلب_ويب1_أساسي(الطلب) مع
    | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات); }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); };
}

عام عرف حلل_استجابة_ويب1_بحدود(
    البايتات: &متجه غ8,
    انتهى_المدخل: منطقي,
    الحدود: &حدود_استجابة_ويب1,
    طريقة_الطلب: &نص
): نتيجة استجابة_ويب_محللة, خطأ_عميل_ويب {
    طابق حلل_استجابة_ويب1_أساسيا(البايتات, انتهى_المدخل, الحدود, طريقة_الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_استجابة_من_ويب(&الخطأ)); }
    | نتيجة.نجح(المحلل) -> {
        دع الناتج: استجابة_ويب_محللة = { الاستجابة: المحلل.الاستجابة, المستهلك: المحلل.المستهلك };
        أرجع نتيجة.نجح(الناتج);
    };
}

عام عرف حلل_استجابة_ويب1(
    البايتات: &متجه غ8,
    انتهى_المدخل: منطقي,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_محللة, خطأ_عميل_ويب {
    دع الحدود: حدود_استجابة_ويب1 = حدود_استجابة_عميل(حد_أقصى_للجسم);
    دع طريقة: نص = «»;
    أرجع حلل_استجابة_ويب1_بحدود(البايتات, انتهى_المدخل, &الحدود, &الطريقة);
}

عرف انسخ_باقي_عميل(البايتات: &متجه غ8, البداية: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < (الطول(*البايتات) مثل غير_موقع)) { ألحق(الناتج, (*البايتات)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف اقرأ_استجابة_من_قارئ<ح>(
    المصدر: &ح,
    القراءة: قارئ<ح>,
    المخزن_المستمر: &متغير متجه غ8,
    الحدود: &حدود_استجابة_ويب1,
    الطريقة: &نص
): نتيجة استجابة_ويب1_محللة, خطأ_عميل_ويب {
    دع البايتات: متغير متجه غ8 = *المخزن_المستمر;
    دع مخزن_قراءة: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8192) { ألحق(مخزن_قراءة, 0); ف := ف + 1; }
    دع انتهى: متغير منطقي = خطأ;
    بينما (صواب) {
        طابق حلل_استجابة_ويب1_أساسيا(&البايتات, انتهى, الحدود, الطريقة) مع
        | نتيجة.نجح(المحلل) -> {
            دع الحالة: غير_موقع = المحلل.الاستجابة.الحالة;
            دع الباقي: متجه غ8 = انسخ_باقي_عميل(&البايتات, المحلل.المستهلك);
            البايتات := الباقي;
            لو ((الحالة >= 100) && (الحالة < 200) && (الحالة != 101)) {
                لو (انتهى && ((الطول(البايتات) مثل غير_موقع) == 0)) {
                    أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة());
                };
            } وإلا {
                *المخزن_المستمر := البايتات;
                أرجع نتيجة.نجح(المحلل);
            };
        }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ.الصنف مع
            | صنف_خطأ_ويب.غير_مكتمل -> {
                لو (انتهى) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_مكتملة()); };
                طابق القراءة(المصدر, &متغير مخزن_قراءة, 0, 8192) مع
                | نتيجة.خطأ(خطأ_شبكة) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(خطأ_شبكة)); }
                | نتيجة.نجح(المقروء) -> {
                    لو (المقروء == 0) { انتهى := صواب; }
                    وإلا {
                        دع ك: متغير غير_موقع = 0;
                        بينما (ك < (المقروء مثل غير_موقع)) { ألحق(البايتات, مخزن_قراءة[ك]); ك := ك + 1; }
                    };
                };
            }
            | _ -> { أرجع نتيجة.خطأ(خطأ_استجابة_من_ويب(&الخطأ)); };
        };
    }
    أرجع نتيجة.خطأ(خطأ_عميل_ويب.استجابة_غير_صالحة());
}

عام عرف افتح_اتصال_عميل_ويب_عادي(الرابط: &نص): نتيجة اتصال_عميل_ويب_عادي, خطأ_عميل_ويب {
    دع الوجهة: متغير وجهة_عميل_ويب;
    طابق حلل_وجهة_عميل(الرابط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { الوجهة := قيمة; };
    لو (الوجهة.آمن) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.مخطط_غير_مدعوم()); };
    دع العنوان: متغير عنوان_مقبس;
    طابق حل_عنوان_عميل(&الوجهة.المضيف, الوجهة.المنفذ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; };
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(التدفق) -> {
        دع المخزن: متجه غ8 = [];
        دع الاتصال: اتصال_عميل_ويب_عادي = { التدفق: التدفق, المضيف: الوجهة.المضيف, السلطة: الوجهة.السلطة, المخزن: المخزن, قابل_لإعادة_الاستخدام: صواب };
        أرجع نتيجة.نجح(الاتصال);
    };
}

عام عرف افتح_اتصال_عميل_ويب_آمن(الرابط: &نص): نتيجة اتصال_عميل_ويب_آمن, خطأ_عميل_ويب {
    دع الوجهة: متغير وجهة_عميل_ويب;
    طابق حلل_وجهة_عميل(الرابط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { الوجهة := قيمة; };
    لو (!الوجهة.آمن) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.مخطط_غير_مدعوم()); };
    دع العنوان: متغير عنوان_مقبس;
    طابق حل_عنوان_عميل(&الوجهة.المضيف, الوجهة.المنفذ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { العنوان := قيمة; };
    طابق اتصل_تي_سي_بي(&العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(التدفق) -> {
        دع الإعداد: إعداد_عميل_تي_إل_إس = إعداد_عميل_تي_إل_إس_افتراضي(&الوجهة.المضيف);
        طابق اتصل_عميل_تي_إل_إس(التدفق, &الإعداد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
        | نتيجة.نجح(الآمن) -> {
            دع المخزن: متجه غ8 = [];
            دع الاتصال: اتصال_عميل_ويب_آمن = { التدفق: الآمن, المضيف: الوجهة.المضيف, السلطة: الوجهة.السلطة, المخزن: المخزن, قابل_لإعادة_الاستخدام: صواب };
            أرجع نتيجة.نجح(الاتصال);
        };
    };
}

عام عرف نفذ_على_اتصال_عميل_ويب_عادي(
    الاتصال: &متغير اتصال_عميل_ويب_عادي,
    الطريقة: &نص,
    الهدف: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه غ8,
    الحدود: &حدود_استجابة_ويب1
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    لو (!(*الاتصال).قابل_لإعادة_الاستخدام) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.اتصال_غير_قابل_لإعادة_الاستخدام()); };
    دع الطلب: متغير طلب_ويب_مخزن;
    دع لا_رؤوس_لاحقة: متجه رأس_ويب = [];
    طابق هيئ_طلب_ويب1_أساسيا(الطريقة, الهدف, &(*الاتصال).السلطة, الرؤوس, &لا_رؤوس_لاحقة, الجسم) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); }
    | نتيجة.نجح(قيمة) -> { الطلب := قيمة; };
    دع المرسل: متغير متجه غ8 = [];
    طابق سلسل_طلب_ويب1(&الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { المرسل := قيمة; };
    طابق اكتب_الكل(&(*الاتصال).التدفق, اكتب_تي_سي_بي, &المرسل) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).قابل_لإعادة_الاستخدام := خطأ; أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_استجابة_من_قارئ(&(*الاتصال).التدفق, اقرأ_تي_سي_بي, &متغير (*الاتصال).المخزن, الحدود, الطريقة) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).قابل_لإعادة_الاستخدام := خطأ; أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلل) -> {
        (*الاتصال).قابل_لإعادة_الاستخدام := استجابة_ويب1_قابلة_لإعادة_الاستخدام(&الطلب, &المحلل.الاستجابة, المحلل.محدد_بالإغلاق, المحلل.نفق)
            && ((الطول((*الاتصال).المخزن) مثل غير_موقع) == 0);
        لو (المحلل.نفق) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.نفق_اتصال()); };
        لو (المحلل.الاستجابة.الحالة == 101) {
            أرجع نتيجة.خطأ(خطأ_عميل_ويب.ترقية_بروتوكول());
        };
        أرجع نتيجة.نجح(المحلل.الاستجابة);
    };
}

عام عرف نفذ_على_اتصال_عميل_ويب_آمن(
    الاتصال: &متغير اتصال_عميل_ويب_آمن,
    الطريقة: &نص,
    الهدف: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه غ8,
    الحدود: &حدود_استجابة_ويب1
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    لو (!(*الاتصال).قابل_لإعادة_الاستخدام) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.اتصال_غير_قابل_لإعادة_الاستخدام()); };
    دع الطلب: متغير طلب_ويب_مخزن;
    دع لا_رؤوس_لاحقة: متجه رأس_ويب = [];
    طابق هيئ_طلب_ويب1_أساسيا(الطريقة, الهدف, &(*الاتصال).السلطة, الرؤوس, &لا_رؤوس_لاحقة, الجسم) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عميل_ويب.طلب_غير_صالح()); }
    | نتيجة.نجح(قيمة) -> { الطلب := قيمة; };
    دع المرسل: متغير متجه غ8 = [];
    طابق سلسل_طلب_ويب1(&الطلب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { المرسل := قيمة; };
    طابق اكتب_الكل(&(*الاتصال).التدفق, اكتب_تدفق_تي_إل_إس, &المرسل) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).قابل_لإعادة_الاستخدام := خطأ; أرجع نتيجة.خطأ(خطأ_عميل_ويب.شبكة(الخطأ)); }
    | نتيجة.نجح(_) -> { };
    طابق اقرأ_استجابة_من_قارئ(&(*الاتصال).التدفق, اقرأ_تدفق_تي_إل_إس, &متغير (*الاتصال).المخزن, الحدود, الطريقة) مع
    | نتيجة.خطأ(الخطأ) -> { (*الاتصال).قابل_لإعادة_الاستخدام := خطأ; أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلل) -> {
        (*الاتصال).قابل_لإعادة_الاستخدام := استجابة_ويب1_قابلة_لإعادة_الاستخدام(&الطلب, &المحلل.الاستجابة, المحلل.محدد_بالإغلاق, المحلل.نفق)
            && ((الطول((*الاتصال).المخزن) مثل غير_موقع) == 0);
        لو (المحلل.نفق) { أرجع نتيجة.خطأ(خطأ_عميل_ويب.نفق_اتصال()); };
        لو (المحلل.الاستجابة.الحالة == 101) {
            أرجع نتيجة.خطأ(خطأ_عميل_ويب.ترقية_بروتوكول());
        };
        أرجع نتيجة.نجح(المحلل.الاستجابة);
    };
}

عام عرف أغلق_اتصال_عميل_ويب_عادي(الاتصال: اتصال_عميل_ويب_عادي): نتيجة عدد, عدد {
    أرجع أغلق_تدفق_تي_سي_بي(الاتصال.التدفق);
}

عام عرف أغلق_اتصال_عميل_ويب_آمن(الاتصال: اتصال_عميل_ويب_آمن): نتيجة عدد, عدد {
    أرجع أغلق_تدفق_تي_إل_إس(الاتصال.التدفق);
}

عام عرف أنشئ_عميل_ويب(): عميل_ويب {
    دع العميل: عميل_ويب = { الاتصال: حالة_عميل_ويب.بلا_اتصال() };
    أرجع العميل;
}

عام عرف أغلق_عميل_ويب(العميل: &متغير عميل_ويب): نتيجة عدد, عدد {
    دع الحالة: حالة_عميل_ويب = (*العميل).الاتصال;
    (*العميل).الاتصال := حالة_عميل_ويب.بلا_اتصال();
    طابق الحالة مع
    | حالة_عميل_ويب.بلا_اتصال -> { أرجع نتيجة.نجح(0); }
    | حالة_عميل_ويب.عادي(الاتصال) -> { أرجع أغلق_اتصال_عميل_ويب_عادي(الاتصال); }
    | حالة_عميل_ويب.آمن(الاتصال) -> { أرجع أغلق_اتصال_عميل_ويب_آمن(الاتصال); };
}

عرف ثبت_اتصال_عميل_ويب_عادي(
    العميل: &متغير عميل_ويب,
    الاتصال: اتصال_عميل_ويب_عادي
): فراغ {
    لو (الاتصال.قابل_لإعادة_الاستخدام) {
        (*العميل).الاتصال := حالة_عميل_ويب.عادي(الاتصال);
    } وإلا {
        دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_عميل_ويب_عادي(الاتصال);
        (*العميل).الاتصال := حالة_عميل_ويب.بلا_اتصال();
    };
}

عرف ثبت_اتصال_عميل_ويب_آمن(
    العميل: &متغير عميل_ويب,
    الاتصال: اتصال_عميل_ويب_آمن
): فراغ {
    لو (الاتصال.قابل_لإعادة_الاستخدام) {
        (*العميل).الاتصال := حالة_عميل_ويب.آمن(الاتصال);
    } وإلا {
        دع تجاهل: نتيجة عدد, عدد = أغلق_اتصال_عميل_ويب_آمن(الاتصال);
        (*العميل).الاتصال := حالة_عميل_ويب.بلا_اتصال();
    };
}

عام عرف نفذ_طلب_بعميل_ويب(
    العميل: &متغير عميل_ويب,
    الطريقة: &نص,
    الرابط: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه غ8,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع الوجهة: متغير وجهة_عميل_ويب;
    طابق حلل_وجهة_عميل(الرابط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيمة) -> { الوجهة := قيمة; };
    دع الحدود: حدود_استجابة_ويب1 = حدود_استجابة_عميل(حد_أقصى_للجسم);

    دع الحالة: حالة_عميل_ويب = (*العميل).الاتصال;
    طابق الحالة مع
    | حالة_عميل_ويب.بلا_اتصال -> { }
    | حالة_عميل_ويب.عادي(الاتصال_الحالي) -> {
        لو ((!الوجهة.آمن) && الاتصال_الحالي.قابل_لإعادة_الاستخدام
            && نص_أسكي_يساوي_عميل(&الاتصال_الحالي.السلطة, &الوجهة.السلطة)) {
            دع الاتصال: متغير اتصال_عميل_ويب_عادي = الاتصال_الحالي;
            دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = نفذ_على_اتصال_عميل_ويب_عادي(
                &متغير الاتصال, الطريقة, &الوجهة.الهدف, الرؤوس, الجسم, &الحدود
            );
            ثبت_اتصال_عميل_ويب_عادي(العميل, الاتصال);
            أرجع الناتج;
        };
    }
    | حالة_عميل_ويب.آمن(الاتصال_الحالي) -> {
        لو (الوجهة.آمن && الاتصال_الحالي.قابل_لإعادة_الاستخدام
            && نص_أسكي_يساوي_عميل(&الاتصال_الحالي.السلطة, &الوجهة.السلطة)) {
            دع الاتصال: متغير اتصال_عميل_ويب_آمن = الاتصال_الحالي;
            دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = نفذ_على_اتصال_عميل_ويب_آمن(
                &متغير الاتصال, الطريقة, &الوجهة.الهدف, الرؤوس, الجسم, &الحدود
            );
            ثبت_اتصال_عميل_ويب_آمن(العميل, الاتصال);
            أرجع الناتج;
        };
    };

    دع تجاهل_الإغلاق: نتيجة عدد, عدد = أغلق_عميل_ويب(العميل);
    لو (!الوجهة.آمن) {
        طابق افتح_اتصال_عميل_ويب_عادي(الرابط) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الاتصال_الأولي) -> {
            دع الاتصال: متغير اتصال_عميل_ويب_عادي = الاتصال_الأولي;
            دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = نفذ_على_اتصال_عميل_ويب_عادي(
                &متغير الاتصال, الطريقة, &الوجهة.الهدف, الرؤوس, الجسم, &الحدود
            );
            ثبت_اتصال_عميل_ويب_عادي(العميل, الاتصال);
            أرجع الناتج;
        };
    };

    طابق افتح_اتصال_عميل_ويب_آمن(الرابط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الاتصال_الأولي) -> {
        دع الاتصال: متغير اتصال_عميل_ويب_آمن = الاتصال_الأولي;
        دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = نفذ_على_اتصال_عميل_ويب_آمن(
            &متغير الاتصال, الطريقة, &الوجهة.الهدف, الرؤوس, الجسم, &الحدود
        );
        ثبت_اتصال_عميل_ويب_آمن(العميل, الاتصال);
        أرجع الناتج;
    };
}

عام عرف اجلب_بعميل_ويب(
    العميل: &متغير عميل_ويب,
    الرابط: &نص,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع الطريقة: نص = «GET»;
    دع الرؤوس: متجه رأس_ويب = [];
    دع الجسم: متجه غ8 = [];
    أرجع نفذ_طلب_بعميل_ويب(العميل, &الطريقة, الرابط, &الرؤوس, &الجسم, حد_أقصى_للجسم);
}

// Compatibility convenience: one isolated request. Repeated requests should
// use عميل_ويب so the client owns and reuses the persistent connection.
عام عرف نفذ_طلب_ويب(
    الطريقة: &نص,
    الرابط: &نص,
    الرؤوس: &متجه رأس_ويب,
    الجسم: &متجه غ8,
    حد_أقصى_للجسم: غير_موقع
): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع العميل: متغير عميل_ويب = أنشئ_عميل_ويب();
    دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = نفذ_طلب_بعميل_ويب(
        &متغير العميل, الطريقة, الرابط, الرؤوس, الجسم, حد_أقصى_للجسم
    );
    دع تجاهل: نتيجة عدد, عدد = أغلق_عميل_ويب(&متغير العميل);
    أرجع الناتج;
}

عام عرف اجلب_ويب(الرابط: &نص, حد_أقصى_للجسم: غير_موقع): نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب {
    دع العميل: متغير عميل_ويب = أنشئ_عميل_ويب();
    دع الناتج: نتيجة استجابة_ويب_مخزنة, خطأ_عميل_ويب = اجلب_بعميل_ويب(&متغير العميل, الرابط, حد_أقصى_للجسم);
    دع تجاهل: نتيجة عدد, عدد = أغلق_عميل_ويب(&متغير العميل);
    أرجع الناتج;
}

عام مرادف http_client_error = خطأ_عميل_ويب;
عام نوع parsed_http_response = استجابة_ويب_محللة;
عام نوع http_client_connection = اتصال_عميل_ويب_عادي;
عام نوع https_client_connection = اتصال_عميل_ويب_آمن;
عام نوع http_client = عميل_ويب;
عام مرادف new_http_client = أنشئ_عميل_ويب;
عام مرادف http_client_execute = نفذ_طلب_بعميل_ويب;
عام مرادف http_client_get = اجلب_بعميل_ويب;
عام مرادف close_http_client = أغلق_عميل_ويب;
عام مرادف serialize_http1_request = سلسل_طلب_ويب1;
عام مرادف parse_http1_response = حلل_استجابة_ويب1;
عام مرادف parse_http1_response_with_limits = حلل_استجابة_ويب1_بحدود;
عام مرادف open_http_client_connection = افتح_اتصال_عميل_ويب_عادي;
عام مرادف open_https_client_connection = افتح_اتصال_عميل_ويب_آمن;
عام مرادف execute_on_http_client_connection = نفذ_على_اتصال_عميل_ويب_عادي;
عام مرادف execute_on_https_client_connection = نفذ_على_اتصال_عميل_ويب_آمن;
عام مرادف close_http_client_connection = أغلق_اتصال_عميل_ويب_عادي;
عام مرادف close_https_client_connection = أغلق_اتصال_عميل_ويب_آمن;
