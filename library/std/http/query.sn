استورد text.compare;
استورد text.from_bytes;
استورد text.substring;
استورد uri.uri;
استورد http.model;

// URL query helpers preserve duplicate keys. They apply the conventional
// application/x-www-form-urlencoded '+' decoding used by web frameworks.
عام نوع زوج_استعلام_ويب = {
    الاسم: نص,
    القيمة: نص
};

عرف فك_مكون_استعلام_ويب(القيمة: &نص): نتيجة نص, خطأ_عنوان_موحد {
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        إذا ((*القيمة)[ف] == 0x2B) { ألحق(البايتات, 0x20); } وإلا { ألحق(البايتات, (*القيمة)[ف]); };
        ف := ف + 1;
    }
    دع قبل_النسب: نص = من_بايتات(&البايتات);
    أرجع فك_الترميز_النسبي(&قبل_النسب);
}

عام عرف مسار_هدف_ويب(الهدف: &نص): نص {
    إذا ((الطول((*الهدف)) مثل طبيعي) > 0) {
        إذا ((*الهدف)[0] != 0x2F) {
            طابق حلل_عنوانا_موحدا(الهدف) مع
            | نتيجة.نجح(العنوان) -> { إذا ((الطول(العنوان.المسار) مثل طبيعي) == 0) { أرجع «/»; }; أرجع انسخ_نص_ويب(&العنوان.المسار); }
            | نتيجة.خطأ(_) -> { };
        };
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الهدف)) مثل طبيعي)) {
        إذا ((*الهدف)[ف] == 0x3F) {
            طابق مقطع_نص(الهدف, 0, ف) مع | اختياري.موجود(مسار) -> { أرجع مسار; } | _ -> { أرجع «»; };
        };
        ف := ف + 1;
    }
    أرجع انسخ_نص_ويب(الهدف);
}

عام عرف استعلام_هدف_ويب(الهدف: &نص): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الهدف)) مثل طبيعي)) {
        إذا ((*الهدف)[ف] == 0x3F) {
            دع طول_الهدف: طبيعي = الطول((*الهدف)) مثل طبيعي;
            دع بداية_الاستعلام: طبيعي = ف + 1;
            دع طول_الاستعلام: طبيعي = طول_الهدف - بداية_الاستعلام;
            طابق مقطع_نص(الهدف, بداية_الاستعلام, طول_الاستعلام) مع
            | اختياري.موجود(استعلام) -> { أرجع اختياري.موجود(استعلام); }
            | _ -> { أرجع اختياري.موجود(«»); };
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف حلل_استعلام_ويب(الاستعلام: &نص): نتيجة متجه زوج_استعلام_ويب, خطأ_عنوان_موحد {
    دع الناتج: متغير متجه زوج_استعلام_ويب = [];
    دع البداية: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول((*الاستعلام)) مثل طبيعي;
    طالما (البداية <= العدد) {
        دع النهاية: متغير طبيعي = البداية;
        طالما ((النهاية < العدد) && ((*الاستعلام)[النهاية] != 0x26)) { النهاية := النهاية + 1; }
        دع مساواة: متغير طبيعي = النهاية;
        دع ف: متغير طبيعي = البداية;
        طالما (ف < النهاية) {
            إذا ((*الاستعلام)[ف] == 0x3D) { مساواة := ف; ف := النهاية; } وإلا { ف := ف + 1; };
        }
        دع الاسم_الخام: متغير نص = «»;
        دع القيمة_الخام: متغير نص = «»;
        طابق مقطع_نص(الاستعلام, البداية, مساواة - البداية) مع | اختياري.موجود(قيمة) -> { الاسم_الخام := قيمة; } | _ -> { };
        إذا (مساواة < النهاية) {
            طابق مقطع_نص(الاستعلام, مساواة + 1, النهاية - مساواة - 1) مع | اختياري.موجود(قيمة) -> { القيمة_الخام := قيمة; } | _ -> { };
        };
        دع الاسم: متغير نص = «»;
        دع القيمة: متغير نص = «»;
        طابق فك_مكون_استعلام_ويب(&الاسم_الخام) مع | نتيجة.نجح(قيمة) -> { الاسم := قيمة; } | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        طابق فك_مكون_استعلام_ويب(&القيمة_الخام) مع | نتيجة.نجح(قيمة_مفكوكة) -> { القيمة := قيمة_مفكوكة; } | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); };
        دع الزوج: زوج_استعلام_ويب = { الاسم: الاسم, القيمة: القيمة };
        ألحق(الناتج, الزوج);
        إذا (النهاية >= العدد) { أرجع نتيجة.نجح(الناتج); };
        البداية := النهاية + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف أول_قيمة_استعلام_ويب(الأزواج: &متجه زوج_استعلام_ويب, الاسم: &نص): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الأزواج)) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الأزواج)[ف].الاسم, الاسم)) { أرجع اختياري.موجود(انسخ_نص_ويب(&(*الأزواج)[ف].القيمة)); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}


عام عرف اسم_زوج_استعلام_ويب(الزوج: &زوج_استعلام_ويب): نص { أرجع انسخ_نص_ويب(&(*الزوج).الاسم); }
عام عرف قيمة_زوج_استعلام_ويب(الزوج: &زوج_استعلام_ويب): نص { أرجع انسخ_نص_ويب(&(*الزوج).القيمة); }

// English public aliases.
عام مرادف query_pair = زوج_استعلام_ويب;
عام مرادف http_query_pair_name = اسم_زوج_استعلام_ويب;
عام مرادف http_query_pair_value = قيمة_زوج_استعلام_ويب;
عام مرادف http_target_path = مسار_هدف_ويب;
عام مرادف http_target_query = استعلام_هدف_ويب;
عام مرادف parse_http_query = حلل_استعلام_ويب;
عام مرادف http_query_first = أول_قيمة_استعلام_ويب;
