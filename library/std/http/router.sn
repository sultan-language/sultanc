استورد chars.ascii;
استورد text.compare;
استورد text.substring;
استورد text.transform;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.query;
استورد http.body;
استورد http.http1.request_parser;
استورد http.http1.response_writer;

// Router core. Route patterns use /literal/{param}/{*tail}. Static segments
// outrank parameters, and catch-all routes rank below non-catch-all routes.
عام نوع جزء_مسار_ويب =
    | ثابت بنوع نص
    | معامل بنوع نص
    | بقية بنوع نص
;

عام نوع معامل_مسار_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع معاملات_مسار_ويب = {
    القيم: متجه معامل_مسار_ويب
};

عام نوع معالج_مسار_ويب<S> = دالة(
    &S,
    &طلب_ويب<متجه غ8>,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه غ8>;

عام نوع مسار_ويب<S> = {
    الطريقة: نص,
    النمط: نص,
    الأجزاء: متجه جزء_مسار_ويب,
    الثوابت: غير_موقع,
    لديه_بقية: منطقي,
    المعالج: معالج_مسار_ويب<S>
};

عام نوع موجه_ويب<S> = {
    الحالة: S,
    المسارات: متجه مسار_ويب<S>
};

عام نوع صنف_خطأ_موجه_ويب =
    | نمط_غير_صالح
    | اسم_معامل_غير_صالح
    | معامل_مكرر
    | بقية_ليست_أخيرة
    | مسار_مكرر
    | طريقة_غير_صالحة
;

عام عرف موجه_ويب_جديد<S>(الحالة: S): موجه_ويب<S> {
    دع المسارات: متجه مسار_ويب<S> = [];
    دع الناتج: موجه_ويب<S> = { الحالة: الحالة, المسارات: المسارات };
    أرجع الناتج;
}

عرف اسم_معامل_مسار_ويب_صالح(الاسم: &نص): منطقي {
    دع القيمة: نص = *الاسم;
    لو ((الطول(القيمة) مثل غير_موقع) == 0) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيمة) مثل غير_موقع)) {
        دع ب: غ8 = القيمة[ف];
        لو (!(حرف_أو_رقم_أسكي(ب) || (ب == 0x5F))) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_معامل_موجود(الأجزاء: &متجه جزء_مسار_ويب, الاسم: &نص): منطقي {
    دع القيم: متجه جزء_مسار_ويب = *الأجزاء;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(القيم) مثل غير_موقع)) {
        طابق القيم[ف] مع
        | جزء_مسار_ويب.معامل(قيمة) -> { لو (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | جزء_مسار_ويب.بقية(قيمة) -> { لو (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف حلل_نمط_مسار_ويب(النمط: &نص): نتيجة متجه جزء_مسار_ويب, صنف_خطأ_موجه_ويب {
    دع القيمة: نص = *النمط;
    لو (((الطول(القيمة) مثل غير_موقع) == 0) || (القيمة[0] != 0x2F)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.نمط_غير_صالح()); };
    دع فاصل_المسار: نص = «/»;
    دع النصوص: متجه نص = قسم_النص(&القيمة, &فاصل_المسار);
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(النصوص) مثل غير_موقع)) {
        دع الجزء: نص = انسخ_نص_ويب(&النصوص[ف]);
        دع الطول_الجزء: غير_موقع = الطول(الجزء) مثل غير_موقع;
        دع آخر_جزء: متغير غير_موقع = 0;
        لو (الطول_الجزء > 0) { آخر_جزء := الطول_الجزء - 1; };
        لو ((الطول_الجزء >= 2) && (الجزء[0] == 0x7B) && (الجزء[آخر_جزء] == 0x7D)) {
            دع بداية_الاسم: متغير غير_موقع = 1;
            دع بقية: متغير منطقي = خطأ;
            لو ((الطول_الجزء >= 3) && (الجزء[1] == 0x2A)) { بداية_الاسم := 2; بقية := صواب; };
            دع الاسم: متغير نص = «»;
            طابق مقطع_نص(&الجزء, بداية_الاسم, الطول_الجزء - بداية_الاسم - 1) مع | اختيار.بعض(قيمة_الاسم) -> { الاسم := قيمة_الاسم; } | _ -> { };
            لو (!اسم_معامل_مسار_ويب_صالح(&الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.اسم_معامل_غير_صالح()); };
            لو (اسم_معامل_موجود(&الأجزاء, &الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.معامل_مكرر()); };
            لو (بقية) {
                لو ((ف + 1) != (الطول(النصوص) مثل غير_موقع)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.بقية_ليست_أخيرة()); };
                ألحق(الأجزاء, جزء_مسار_ويب.بقية(الاسم));
            } وإلا {
                ألحق(الأجزاء, جزء_مسار_ويب.معامل(الاسم));
            };
        } وإلا {
            ألحق(الأجزاء, جزء_مسار_ويب.ثابت(الجزء));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الأجزاء);
}

عرف مساران_مسجلان_متساويان<S>(المسار: &مسار_ويب<S>, الطريقة: &نص, النمط: &نص): منطقي {
    دع القيمة: مسار_ويب<S> = *المسار;
    أرجع نصان_متساويان(&القيمة.الطريقة, الطريقة) && نصان_متساويان(&القيمة.النمط, النمط);
}

عام عرف أضف_مسار_ويب<S>(
    الموجه: &متغير موجه_ويب<S>,
    الطريقة: &نص,
    النمط: &نص,
    المعالج: معالج_مسار_ويب<S>
): نتيجة غير_موقع, صنف_خطأ_موجه_ويب {
    لو (!طريقة_ويب_صالحة(الطريقة)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.طريقة_غير_صالحة()); };
    دع الحالية: متغير موجه_ويب<S> = *الموجه;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالية.المسارات) مثل غير_موقع)) {
        لو (مساران_مسجلان_متساويان(&الحالية.المسارات[ف], الطريقة, النمط)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.مسار_مكرر()); };
        ف := ف + 1;
    }
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    طابق حلل_نمط_مسار_ويب(النمط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيم) -> { الأجزاء := قيم; };
    دع الثوابت: متغير غير_موقع = 0;
    دع لديه_بقية: متغير منطقي = خطأ;
    ف := 0;
    بينما (ف < (الطول(الأجزاء) مثل غير_موقع)) {
        طابق الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(_) -> { الثوابت := الثوابت + 1; }
        | جزء_مسار_ويب.بقية(_) -> { لديه_بقية := صواب; }
        | _ -> { };
        ف := ف + 1;
    }
    دع طريقة_المسار: نص = انسخ_نص_ويب(الطريقة);
    دع نمط_المسار: نص = انسخ_نص_ويب(النمط);
    دع المسار: مسار_ويب<S> = {
        الطريقة: طريقة_المسار,
        النمط: نمط_المسار,
        الأجزاء: الأجزاء,
        الثوابت: الثوابت,
        لديه_بقية: لديه_بقية,
        المعالج: المعالج
    };
    دع الموضع: غير_موقع = الطول(الحالية.المسارات) مثل غير_موقع;
    ألحق(الحالية.المسارات, المسار);
    *الموجه := الحالية;
    أرجع نتيجة.نجح(الموضع);
}

عرف طابق_أجزاء_مسار_ويب<S>(المسار: &مسار_ويب<S>, المسار_الفعلي: &نص): اختيار معاملات_مسار_ويب {
    دع تعريف_المسار: مسار_ويب<S> = *المسار;
    دع النص: نص = *المسار_الفعلي;
    دع فاصل_المسار: نص = «/»;
    دع الأجزاء_الفعلية: متجه نص = قسم_النص(&النص, &فاصل_المسار);
    دع بداية: غير_موقع = 1;
    دع طول_الأجزاء_الفعلية: غير_موقع = الطول(الأجزاء_الفعلية) مثل غير_موقع;
    دع عدد_فعلي: غير_موقع = طول_الأجزاء_الفعلية - بداية;
    دع عدد_نمط: غير_موقع = الطول(تعريف_المسار.الأجزاء) مثل غير_موقع;
    لو (!تعريف_المسار.لديه_بقية && (عدد_فعلي != عدد_نمط)) { أرجع اختيار.لا_شيء(); };
    لو (تعريف_المسار.لديه_بقية && (عدد_فعلي + 1 < عدد_نمط)) { أرجع اختيار.لا_شيء(); };
    دع القيم: متغير متجه معامل_مسار_ويب = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_نمط) {
        طابق تعريف_المسار.الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(المطلوب) -> {
            لو (ف >= عدد_فعلي) { أرجع اختيار.لا_شيء(); };
            دع موضع_الجزء: غير_موقع = بداية + ف;
            لو (!نصان_متساويان(&المطلوب, &الأجزاء_الفعلية[موضع_الجزء])) { أرجع اختيار.لا_شيء(); };
        }
        | جزء_مسار_ويب.معامل(الاسم) -> {
            لو (ف >= عدد_فعلي) { أرجع اختيار.لا_شيء(); };
            دع موضع_المعامل: غير_موقع = بداية + ف;
            دع قيمة_المعامل: نص = انسخ_نص_ويب(&الأجزاء_الفعلية[موضع_المعامل]);
            دع المعامل: معامل_مسار_ويب = { الاسم: الاسم, القيمة: قيمة_المعامل };
            ألحق(القيم, المعامل);
        }
        | جزء_مسار_ويب.بقية(الاسم) -> {
            دع البقية: متغير متجه نص = [];
            دع ك: متغير غير_موقع = بداية + ف;
            بينما (ك < (الطول(الأجزاء_الفعلية) مثل غير_موقع)) { ألحق(البقية, انسخ_نص_ويب(&الأجزاء_الفعلية[ك])); ك := ك + 1; }
            دع فاصل: نص = «/»;
            دع القيمة: نص = صل_النصوص(&البقية, &فاصل);
            دع المعامل: معامل_مسار_ويب = { الاسم: الاسم, القيمة: القيمة };
            ألحق(القيم, المعامل);
            ف := عدد_نمط;
        };
        ف := ف + 1;
    }
    دع الناتج: معاملات_مسار_ويب = { القيم: القيم };
    أرجع اختيار.بعض(الناتج);
}

عام عرف قيمة_معامل_مسار_ويب(المعاملات: &معاملات_مسار_ويب, الاسم: &نص): اختيار نص {
    دع الحالة: معاملات_مسار_ويب = *المعاملات;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الحالة.القيم) مثل غير_موقع)) {
        لو (نصان_متساويان(&الحالة.القيم[ف].الاسم, الاسم)) {
            أرجع اختيار.بعض(انسخ_نص_ويب(&الحالة.القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عرف مسار_أفضل<S>(المرشح: &مسار_ويب<S>, الحالي: &مسار_ويب<S>): منطقي {
    دع أ: مسار_ويب<S> = *المرشح;
    دع ب: مسار_ويب<S> = *الحالي;
    لو (أ.الثوابت > ب.الثوابت) { أرجع صواب; };
    لو (أ.الثوابت < ب.الثوابت) { أرجع خطأ; };
    لو (!أ.لديه_بقية && ب.لديه_بقية) { أرجع صواب; };
    لو (أ.لديه_بقية && !ب.لديه_بقية) { أرجع خطأ; };
    أرجع (الطول(أ.الأجزاء) مثل غير_موقع) > (الطول(ب.الأجزاء) مثل غير_موقع);
}

عام عرف وجه_طلب_ويب<S>(الموجه: &موجه_ويب<S>, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    دع حالة_الموجه: موجه_ويب<S> = *الموجه;
    دع قيمة_الطلب: طلب_ويب_مخزن = *الطلب;
    دع المسار_الفعلي: نص = مسار_هدف_ويب(&قيمة_الطلب.الهدف);
    دع أفضل: متغير اختيار غير_موقع = اختيار.لا_شيء();
    دع قيم_معاملات_فارغة: متجه معامل_مسار_ويب = [];
    دع أفضل_معاملات: متغير معاملات_مسار_ويب = { القيم: قيم_معاملات_فارغة };
    دع وجد_المسار: متغير منطقي = خطأ;
    دع الطرق_المسموحة: متغير متجه نص = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(حالة_الموجه.المسارات) مثل غير_موقع)) {
        طابق طابق_أجزاء_مسار_ويب(&حالة_الموجه.المسارات[ف], &المسار_الفعلي) مع
        | اختيار.لا_شيء -> { }
        | اختيار.بعض(المعاملات) -> {
            وجد_المسار := صواب;
            لو (!نصان_متساويان(&حالة_الموجه.المسارات[ف].الطريقة, &قيمة_الطلب.الطريقة)) {
                ألحق(الطرق_المسموحة, انسخ_نص_ويب(&حالة_الموجه.المسارات[ف].الطريقة));
            } وإلا {
                طابق أفضل مع
                | اختيار.لا_شيء -> { أفضل := اختيار.بعض(ف); أفضل_معاملات := المعاملات; }
                | اختيار.بعض(الموضع_الحالي) -> {
                    لو (مسار_أفضل(&حالة_الموجه.المسارات[ف], &حالة_الموجه.المسارات[الموضع_الحالي])) {
                        أفضل := اختيار.بعض(ف);
                        أفضل_معاملات := المعاملات;
                    };
                };
            };
        };
        ف := ف + 1;
    }
    طابق أفضل مع
    | اختيار.بعض(الموضع) -> {
        أرجع حالة_الموجه.المسارات[الموضع].المعالج(&حالة_الموجه.الحالة, &قيمة_الطلب, &أفضل_معاملات);
    }
    | اختيار.لا_شيء -> { };
    لو (وجد_المسار) {
        دع نص_خطأ: نص = «Method Not Allowed»;
        دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_نص_ويب(405, &نص_خطأ);
        لو ((الطول(الطرق_المسموحة) مثل غير_موقع) > 0) {
            دع فاصلة: نص = «, »;
            دع السماح: نص = صل_النصوص(&الطرق_المسموحة, &فاصلة);
            دع الاسم: نص = «allow»;
            دع أضيف_السماح: منطقي = أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, &السماح);
        };
        أرجع الناتج;
    };
    دع نص_خطأ: نص = «Not Found»;
    أرجع استجابة_نص_ويب(404, &نص_خطأ);
}

عام نوع تبادل_ويب1 = {
    بايتات_الاستجابة: متجه غ8,
    بايتات_الطلب_المستهلكة: غير_موقع
};

عام عرف عالج_بايتات_ويب1<S>(
    الموجه: &موجه_ويب<S>,
    البايتات: &متجه غ8,
    الحدود: &حدود_ويب
): نتيجة تبادل_ويب1, خطأ_ويب {
    طابق حلل_طلب_ويب1(البايتات, الحدود) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلل) -> {
        دع الاستجابة: متغير استجابة_ويب_مخزنة = وجه_طلب_ويب(الموجه, &المحلل.الطلب);
        دع إصدار_الطلب: إصدار_ويب = المحلل.الطلب.الإصدار;
        ضع_إصدار_استجابة_ويب(&متغير الاستجابة, إصدار_الطلب);
        طابق سلسل_استجابة_ويب1_لطلب(&المحلل.الطلب, &الاستجابة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(بايتات_الاستجابة) -> {
            دع المستهلك: غير_موقع = المحلل.المستهلك;
            دع الناتج: تبادل_ويب1 = { بايتات_الاستجابة: بايتات_الاستجابة, بايتات_الطلب_المستهلكة: المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}



عام عرف أضف_مسار_get_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة غير_موقع, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «GET»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
