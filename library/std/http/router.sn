استورد chars.ascii;
استورد text.compare;
استورد text.substring;
استورد text.transform;
استورد http.model;
استورد http.headers;
استورد http.limits;
استورد http.query;
استورد http.body;
استورد http.http1.request_parser;
استورد http.http1.response_writer;

// Router core. Route patterns use /literal/{param}/{*tail}. Static segments
// outrank parameters, and catch-all routes rank below non-catch-all routes.
//
// The routes also form a segment tree (as axum's matchit, one node per path
// segment): a node's literal children, at most one parameter child, the
// routes that end at it and the catch-all routes that start at it. A
// request path is split once into byte ranges (no copies), and only the
// branches whose segments match are followed, so dispatch does not grow
// with the number of routes; the parameter texts are copied only for the
// route that is chosen.
عام نوع جزء_مسار_ويب =
    | ثابت بنوع نص
    | معامل بنوع نص
    | بقية بنوع نص
;

عام نوع معامل_مسار_ويب = {
    الاسم: نص,
    القيمة: نص
};

عام نوع معاملات_مسار_ويب = {
    القيم: متجه معامل_مسار_ويب
};

عام نوع معالج_مسار_ويب<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8>;

عام نوع مسار_ويب<S> = {
    الطريقة: نص,
    النمط: نص,
    الأجزاء: متجه جزء_مسار_ويب,
    الثوابت: طبيعي,
    لديه_بقية: منطقي,
    المعالج: معالج_مسار_ويب<S>
};

عام نوع موجه_ويب<S> = {
    الحالة: S,
    المسارات: متجه مسار_ويب<S>,
    // The segment tree; node 0 is the root.
    العقد: متجه عقدة_موجه_ويب
};

// One segment-tree node. أبناء_ثابتة[ف] is the child for the literal
// segment أسماء_الثوابت[ف]; ابن_معامل is the parameter child + 1 (0 none).
عام نوع عقدة_موجه_ويب = {
    أسماء_الثوابت: متجه نص,
    أبناء_ثابتة: متجه طبيعي,
    ابن_معامل: طبيعي,
    // Routes whose pattern ends at this node.
    المنتهية: متجه طبيعي,
    // Routes whose catch-all segment follows this node.
    البقايا: متجه طبيعي
};

عام نوع صنف_خطأ_موجه_ويب =
    | نمط_غير_صالح
    | اسم_معامل_غير_صالح
    | معامل_مكرر
    | بقية_ليست_أخيرة
    | مسار_مكرر
    | طريقة_غير_صالحة
;

عرف عقدة_موجه_ويب_فارغة(): عقدة_موجه_ويب {
    دع الناتج: عقدة_موجه_ويب = {
        أسماء_الثوابت: [], أبناء_ثابتة: [], ابن_معامل: 0, المنتهية: [], البقايا: []
    };
    أرجع الناتج;
}

عام عرف موجه_ويب_جديد<S>(الحالة: S): موجه_ويب<S> {
    دع المسارات: متجه مسار_ويب<S> = [];
    دع العقد: متغير متجه عقدة_موجه_ويب = [];
    ألحق(العقد, عقدة_موجه_ويب_فارغة());
    دع الناتج: موجه_ويب<S> = { الحالة: الحالة, المسارات: المسارات, العقد: العقد };
    أرجع الناتج;
}

// Adds route الموضع (with these pattern segments) to the segment tree.
عرف أدخل_مسارا_في_الشجرة_ويب(العقد: &متغير متجه عقدة_موجه_ويب, الأجزاء: &متجه جزء_مسار_ويب, الموضع: طبيعي): فراغ {
    إذا ((الطول(*العقد) مثل طبيعي) == 0) { ألحق(*العقد, عقدة_موجه_ويب_فارغة()); };
    دع العقدة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        طابق (*الأجزاء)[ف] مع
        | جزء_مسار_ويب.ثابت(الثابت) -> {
            دع الموجود: متغير طبيعي = 0;
            دع ك: متغير طبيعي = 0;
            طالما (ك < (الطول((*العقد)[العقدة].أسماء_الثوابت) مثل طبيعي)) {
                إذا (نصان_متساويان(&(*العقد)[العقدة].أسماء_الثوابت[ك], &الثابت)) {
                    الموجود := (*العقد)[العقدة].أبناء_ثابتة[ك] + 1;
                };
                ك := ك + 1;
            }
            إذا (الموجود == 0) {
                دع الجديدة: طبيعي = الطول(*العقد) مثل طبيعي;
                ألحق(*العقد, عقدة_موجه_ويب_فارغة());
                ألحق((*العقد)[العقدة].أسماء_الثوابت, انسخ_نص_ويب(&الثابت));
                ألحق((*العقد)[العقدة].أبناء_ثابتة, الجديدة);
                العقدة := الجديدة;
            } وإلا { العقدة := الموجود - 1; };
        }
        | جزء_مسار_ويب.معامل(_) -> {
            إذا ((*العقد)[العقدة].ابن_معامل == 0) {
                دع الجديدة: طبيعي = الطول(*العقد) مثل طبيعي;
                ألحق(*العقد, عقدة_موجه_ويب_فارغة());
                (*العقد)[العقدة].ابن_معامل := الجديدة + 1;
                العقدة := الجديدة;
            } وإلا { العقدة := (*العقد)[العقدة].ابن_معامل - 1; };
        }
        | جزء_مسار_ويب.بقية(_) -> {
            // The catch-all is the last segment (حلل_نمط_مسار_ويب).
            ألحق((*العقد)[العقدة].البقايا, الموضع);
            أرجع;
        };
        ف := ف + 1;
    }
    ألحق((*العقد)[العقدة].المنتهية, الموضع);
}

// The path's segments as byte ranges [start, end), as قسم_النص by "/" minus
// its first piece: every "/" starts a segment (a trailing "/" makes an
// empty last one).
عرف أجزاء_مسار_الطلب_ويب(المسار: &نص, النهاية: طبيعي): متجه طبيعي {
    دع المدى: متغير متجه طبيعي = [];
    دع ف: متغير طبيعي = 0;
    دع في_جزء: متغير منطقي = خطأ;
    طالما (ف < النهاية) {
        إذا ((*المسار)[ف] == 0x2F) {
            إذا (في_جزء) { ألحق(المدى, ف); };
            ألحق(المدى, ف + 1);
            في_جزء := صواب;
        };
        ف := ف + 1;
    }
    إذا (في_جزء) { ألحق(المدى, النهاية); };
    أرجع المدى;
}

// Collects every route whose pattern matches segments الفهرس.. of the path.
عرف اجمع_مطابقات_الشجرة_ويب(
    العقد: &متجه عقدة_موجه_ويب,
    العقدة: طبيعي,
    المسار: &نص,
    المدى: &متجه طبيعي,
    الفهرس: طبيعي,
    المطابقات: &متغير متجه طبيعي
): فراغ {
    دع العدد: طبيعي = (الطول(*المدى) مثل طبيعي) / 2;
    دع ف: متغير طبيعي = 0;
    // A catch-all takes the rest of the path, which may be empty.
    طالما (ف < (الطول((*العقد)[العقدة].البقايا) مثل طبيعي)) {
        ألحق(*المطابقات, (*العقد)[العقدة].البقايا[ف]);
        ف := ف + 1;
    }
    إذا (الفهرس == العدد) {
        ف := 0;
        طالما (ف < (الطول((*العقد)[العقدة].المنتهية) مثل طبيعي)) {
            ألحق(*المطابقات, (*العقد)[العقدة].المنتهية[ف]);
            ف := ف + 1;
        }
        أرجع;
    };
    دع البداية: طبيعي = (*المدى)[الفهرس * 2];
    دع النهاية: طبيعي = (*المدى)[الفهرس * 2 + 1];
    ف := 0;
    طالما (ف < (الطول((*العقد)[العقدة].أسماء_الثوابت) مثل طبيعي)) {
        دع الثابت: &نص = &(*العقد)[العقدة].أسماء_الثوابت[ف];
        إذا (يطابق_شريحتين(المسار, البداية, النهاية, الثابت, 0, الطول(*الثابت) مثل طبيعي)) {
            اجمع_مطابقات_الشجرة_ويب(العقد, (*العقد)[العقدة].أبناء_ثابتة[ف], المسار, المدى, الفهرس + 1, المطابقات);
        };
        ف := ف + 1;
    }
    إذا ((*العقد)[العقدة].ابن_معامل != 0) {
        اجمع_مطابقات_الشجرة_ويب(العقد, (*العقد)[العقدة].ابن_معامل - 1, المسار, المدى, الفهرس + 1, المطابقات);
    };
}

// The bytes [البداية, النهاية) of a text as a new text.
عرف مقطع_مسار_ويب(المسار: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    طابق مقطع_نص(المسار, البداية, النهاية - البداية) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// The parameters of a route that matched (its pattern against the ranges).
عرف معاملات_مسار_مطابق_ويب<S>(المسار: &مسار_ويب<S>, الفعلي: &نص, المدى: &متجه طبيعي, نهاية_المسار: طبيعي): معاملات_مسار_ويب {
    دع القيم: متغير متجه معامل_مسار_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المسار).الأجزاء) مثل طبيعي)) {
        طابق (*المسار).الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(_) -> { }
        | جزء_مسار_ويب.معامل(الاسم) -> {
            دع المعامل: معامل_مسار_ويب = {
                الاسم: انسخ_نص_ويب(&الاسم),
                القيمة: مقطع_مسار_ويب(الفعلي, (*المدى)[ف * 2], (*المدى)[ف * 2 + 1])
            };
            ألحق(القيم, المعامل);
        }
        | جزء_مسار_ويب.بقية(الاسم) -> {
            // The remaining segments joined by "/": the path from the start
            // of segment ف (empty when no segment is left).
            دع القيمة: متغير نص = «»;
            إذا (ف * 2 < (الطول(*المدى) مثل طبيعي)) {
                القيمة := مقطع_مسار_ويب(الفعلي, (*المدى)[ف * 2], نهاية_المسار);
            };
            دع المعامل: معامل_مسار_ويب = { الاسم: انسخ_نص_ويب(&الاسم), القيمة: القيمة };
            ألحق(القيم, المعامل);
        };
        ف := ف + 1;
    }
    دع الناتج: معاملات_مسار_ويب = { القيم: القيم };
    أرجع الناتج;
}

عرف اسم_معامل_مسار_ويب_صالح(الاسم: &نص): منطقي {
    إذا ((الطول((*الاسم)) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الاسم)) مثل طبيعي)) {
        دع ب: ط8 = (*الاسم)[ف];
        إذا (!(حرف_أو_رقم_أسكي(ب) || (ب == 0x5F))) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف اسم_معامل_موجود(الأجزاء: &متجه جزء_مسار_ويب, الاسم: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الأجزاء)) مثل طبيعي)) {
        طابق (*الأجزاء)[ف] مع
        | جزء_مسار_ويب.معامل(قيمة) -> { إذا (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | جزء_مسار_ويب.بقية(قيمة) -> { إذا (نصان_متساويان(&قيمة, الاسم)) { أرجع صواب; }; }
        | _ -> { };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف حلل_نمط_مسار_ويب(النمط: &نص): نتيجة متجه جزء_مسار_ويب, صنف_خطأ_موجه_ويب {
    إذا (((الطول((*النمط)) مثل طبيعي) == 0) || ((*النمط)[0] != 0x2F)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.نمط_غير_صالح()); };
    دع فاصل_المسار: نص = «/»;
    دع النصوص: متجه نص = قسم_النص(النمط, &فاصل_المسار);
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(النصوص) مثل طبيعي)) {
        دع الجزء: نص = انسخ_نص_ويب(&النصوص[ف]);
        دع الطول_الجزء: طبيعي = الطول(الجزء) مثل طبيعي;
        دع آخر_جزء: متغير طبيعي = 0;
        إذا (الطول_الجزء > 0) { آخر_جزء := الطول_الجزء - 1; };
        إذا ((الطول_الجزء >= 2) && (الجزء[0] == 0x7B) && (الجزء[آخر_جزء] == 0x7D)) {
            دع بداية_الاسم: متغير طبيعي = 1;
            دع بقية: متغير منطقي = خطأ;
            إذا ((الطول_الجزء >= 3) && (الجزء[1] == 0x2A)) { بداية_الاسم := 2; بقية := صواب; };
            دع الاسم: متغير نص = «»;
            طابق مقطع_نص(&الجزء, بداية_الاسم, الطول_الجزء - بداية_الاسم - 1) مع | اختياري.موجود(قيمة_الاسم) -> { الاسم := قيمة_الاسم; } | _ -> { };
            إذا (!اسم_معامل_مسار_ويب_صالح(&الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.اسم_معامل_غير_صالح()); };
            إذا (اسم_معامل_موجود(&الأجزاء, &الاسم)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.معامل_مكرر()); };
            إذا (بقية) {
                إذا ((ف + 1) != (الطول(النصوص) مثل طبيعي)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.بقية_ليست_أخيرة()); };
                ألحق(الأجزاء, جزء_مسار_ويب.بقية(الاسم));
            } وإلا {
                ألحق(الأجزاء, جزء_مسار_ويب.معامل(الاسم));
            };
        } وإلا {
            ألحق(الأجزاء, جزء_مسار_ويب.ثابت(الجزء));
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الأجزاء);
}

عرف مساران_مسجلان_متساويان<S>(المسار: &مسار_ويب<S>, الطريقة: &نص, النمط: &نص): منطقي {
    أرجع نصان_متساويان(&(*المسار).الطريقة, الطريقة) && نصان_متساويان(&(*المسار).النمط, النمط);
}

عام عرف أضف_مسار_ويب<S>(
    الموجه: &متغير موجه_ويب<S>,
    الطريقة: &نص,
    النمط: &نص,
    المعالج: معالج_مسار_ويب<S>
): نتيجة طبيعي, صنف_خطأ_موجه_ويب {
    إذا (!طريقة_ويب_صالحة(الطريقة)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.طريقة_غير_صالحة()); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الموجه).المسارات) مثل طبيعي)) {
        إذا (مساران_مسجلان_متساويان(&(*الموجه).المسارات[ف], الطريقة, النمط)) { أرجع نتيجة.خطأ(صنف_خطأ_موجه_ويب.مسار_مكرر()); };
        ف := ف + 1;
    }
    دع الأجزاء: متغير متجه جزء_مسار_ويب = [];
    طابق حلل_نمط_مسار_ويب(النمط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(قيم) -> { الأجزاء := قيم; };
    دع الثوابت: متغير طبيعي = 0;
    دع لديه_بقية: متغير منطقي = خطأ;
    ف := 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        طابق الأجزاء[ف] مع
        | جزء_مسار_ويب.ثابت(_) -> { الثوابت := الثوابت + 1; }
        | جزء_مسار_ويب.بقية(_) -> { لديه_بقية := صواب; }
        | _ -> { };
        ف := ف + 1;
    }
    دع طريقة_المسار: نص = انسخ_نص_ويب(الطريقة);
    دع نمط_المسار: نص = انسخ_نص_ويب(النمط);
    دع المسار: مسار_ويب<S> = {
        الطريقة: طريقة_المسار,
        النمط: نمط_المسار,
        الأجزاء: الأجزاء,
        الثوابت: الثوابت,
        لديه_بقية: لديه_بقية,
        المعالج: المعالج
    };
    دع الموضع: طبيعي = الطول((*الموجه).المسارات) مثل طبيعي;
    أدخل_مسارا_في_الشجرة_ويب(&متغير (*الموجه).العقد, &المسار.الأجزاء, الموضع);
    ألحق((*الموجه).المسارات, المسار);
    أرجع نتيجة.نجح(الموضع);
}

عام عرف قيمة_معامل_مسار_ويب(المعاملات: &معاملات_مسار_ويب, الاسم: &نص): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المعاملات).القيم) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المعاملات).القيم[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود(انسخ_نص_ويب(&(*المعاملات).القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Reads both routes through their references: no route is copied.
عرف مسار_أفضل<S>(المرشح: &مسار_ويب<S>, الحالي: &مسار_ويب<S>): منطقي {
    إذا ((*المرشح).الثوابت > (*الحالي).الثوابت) { أرجع صواب; };
    إذا ((*المرشح).الثوابت < (*الحالي).الثوابت) { أرجع خطأ; };
    إذا (!(*المرشح).لديه_بقية && (*الحالي).لديه_بقية) { أرجع صواب; };
    إذا ((*المرشح).لديه_بقية && !(*الحالي).لديه_بقية) { أرجع خطأ; };
    أرجع (الطول((*المرشح).الأجزاء) مثل طبيعي) > (الطول((*الحالي).الأجزاء) مثل طبيعي);
}

// Dispatches through the router and request references, as axum's Router
// borrows its routes: neither the router (its state and routes) nor the
// request is copied, so state that holds atomics or locks stays one value.
عام عرف وجه_طلب_ويب<S>(الموجه: &موجه_ويب<S>, الطلب: &طلب_ويب_مخزن): استجابة_ويب_مخزنة {
    // The path is read in place when the target is origin-form ("/p?q");
    // other forms go through the URL parser.
    دع الهدف: &نص = &(*الطلب).الهدف;
    دع المسار_المنسوخ: متغير نص = «»;
    دع في_المكان: منطقي = (الطول(*الهدف) مثل طبيعي) > 0 && (*الهدف)[0] == 0x2F;
    دع نهاية_المسار: متغير طبيعي = 0;
    إذا (في_المكان) {
        طالما (نهاية_المسار < (الطول(*الهدف) مثل طبيعي) && (*الهدف)[نهاية_المسار] != 0x3F) {
            نهاية_المسار := نهاية_المسار + 1;
        }
    } وإلا {
        المسار_المنسوخ := مسار_هدف_ويب(الهدف);
        نهاية_المسار := الطول(المسار_المنسوخ) مثل طبيعي;
    };
    إذا (في_المكان) { أرجع وجه_مسار_طلب_ويب(الموجه, الطلب, الهدف, نهاية_المسار); };
    أرجع وجه_مسار_طلب_ويب(الموجه, الطلب, &المسار_المنسوخ, نهاية_المسار);
}

// Dispatches on the request path المسار_الفعلي[0..نهاية_المسار).
عرف وجه_مسار_طلب_ويب<S>(
    الموجه: &موجه_ويب<S>,
    الطلب: &طلب_ويب_مخزن,
    المسار_الفعلي: &نص,
    نهاية_المسار: طبيعي
): استجابة_ويب_مخزنة {
    دع المدى: متجه طبيعي = أجزاء_مسار_الطلب_ويب(المسار_الفعلي, نهاية_المسار);
    // Every route that matches the path, in registration order.
    دع المطابقات: متغير متجه طبيعي = [];
    إذا ((الطول((*الموجه).العقد) مثل طبيعي) > 0) {
        اجمع_مطابقات_الشجرة_ويب(&(*الموجه).العقد, 0, المسار_الفعلي, &المدى, 0, &متغير المطابقات);
    };
    دع م: متغير طبيعي = 1;
    طالما (م < (الطول(المطابقات) مثل طبيعي)) {
        دع ك: متغير طبيعي = م;
        طالما (ك > 0 && المطابقات[ك - 1] > المطابقات[ك]) {
            دع المؤقت: طبيعي = المطابقات[ك];
            المطابقات[ك] := المطابقات[ك - 1];
            المطابقات[ك - 1] := المؤقت;
            ك := ك - 1;
        }
        م := م + 1;
    }
    دع أفضل: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع وجد_المسار: منطقي = (الطول(المطابقات) مثل طبيعي) > 0;
    دع الطرق_المسموحة: متغير متجه نص = [];
    دع ع: متغير طبيعي = 0;
    طالما (ع < (الطول(المطابقات) مثل طبيعي)) {
        دع ف: طبيعي = المطابقات[ع];
        إذا (!نصان_متساويان(&(*الموجه).المسارات[ف].الطريقة, &(*الطلب).الطريقة)) {
            ألحق(الطرق_المسموحة, انسخ_نص_ويب(&(*الموجه).المسارات[ف].الطريقة));
        } وإلا {
            طابق أفضل مع
            | اختياري.لا_شيء -> { أفضل := اختياري.موجود(ف); }
            | اختياري.موجود(الموضع_الحالي) -> {
                إذا (مسار_أفضل(&(*الموجه).المسارات[ف], &(*الموجه).المسارات[الموضع_الحالي])) {
                    أفضل := اختياري.موجود(ف);
                };
            };
        };
        ع := ع + 1;
    }
    طابق أفضل مع
    | اختياري.موجود(الموضع) -> {
        دع أفضل_معاملات: معاملات_مسار_ويب = معاملات_مسار_مطابق_ويب(
            &(*الموجه).المسارات[الموضع], المسار_الفعلي, &المدى, نهاية_المسار
        );
        دع المعالج: معالج_مسار_ويب<S> = (*الموجه).المسارات[الموضع].المعالج;
        أرجع المعالج(&(*الموجه).الحالة, الطلب, &أفضل_معاملات);
    }
    | اختياري.لا_شيء -> { };
    إذا (وجد_المسار) {
        دع نص_خطأ: نص = «Method Not Allowed»;
        دع الناتج: متغير استجابة_ويب_مخزنة = استجابة_نص_ويب(405, &نص_خطأ);
        إذا ((الطول(الطرق_المسموحة) مثل طبيعي) > 0) {
            دع فاصلة: نص = «, »;
            دع السماح: نص = صل_النصوص(&الطرق_المسموحة, &فاصلة);
            دع الاسم: نص = «allow»;
            دع أضيف_السماح: منطقي = أضف_رأس_ويب(&متغير الناتج.الرؤوس, &الاسم, &السماح);
        };
        أرجع الناتج;
    };
    دع نص_خطأ: نص = «Not Found»;
    أرجع استجابة_نص_ويب(404, &نص_خطأ);
}

عام نوع تبادل_ويب1 = {
    بايتات_الاستجابة: متجه ط8,
    بايتات_الطلب_المستهلكة: طبيعي
};

عام عرف عالج_بايتات_ويب1<S>(
    الموجه: &موجه_ويب<S>,
    البايتات: &متجه ط8,
    الحدود: &حدود_ويب
): نتيجة تبادل_ويب1, خطأ_ويب {
    طابق حلل_طلب_ويب1(البايتات, الحدود) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلل) -> {
        دع الاستجابة: متغير استجابة_ويب_مخزنة = وجه_طلب_ويب(الموجه, &المحلل.الطلب);
        دع إصدار_الطلب: إصدار_ويب = المحلل.الطلب.الإصدار;
        ضع_إصدار_استجابة_ويب(&متغير الاستجابة, إصدار_الطلب);
        طابق سلسل_استجابة_ويب1_لطلب(&المحلل.الطلب, &الاستجابة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(بايتات_الاستجابة) -> {
            دع المستهلك: طبيعي = المحلل.المستهلك;
            دع الناتج: تبادل_ويب1 = { بايتات_الاستجابة: بايتات_الاستجابة, بايتات_الطلب_المستهلكة: المستهلك };
            أرجع نتيجة.نجح(الناتج);
        };
    };
}



عام عرف أضف_مسار_get_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «GET»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_post_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «POST»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_put_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «PUT»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_patch_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «PATCH»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_delete_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «DELETE»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_head_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «HEAD»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }
عام عرف أضف_مسار_options_ويب<S>(الموجه: &متغير موجه_ويب<S>, النمط: &نص, المعالج: معالج_مسار_ويب<S>): نتيجة طبيعي, صنف_خطأ_موجه_ويب { دع الطريقة: نص = «OPTIONS»; أرجع أضف_مسار_ويب(الموجه, &الطريقة, النمط, المعالج); }

// English public aliases.
عام مرادف http_router_get = أضف_مسار_get_ويب;
عام مرادف http_router_post = أضف_مسار_post_ويب;
عام مرادف http_router_put = أضف_مسار_put_ويب;
عام مرادف http_router_patch = أضف_مسار_patch_ويب;
عام مرادف http_router_delete = أضف_مسار_delete_ويب;
عام مرادف http_router_head = أضف_مسار_head_ويب;
عام مرادف http_router_options = أضف_مسار_options_ويب;
عام مرادف route_segment = جزء_مسار_ويب;
عام مرادف route_parameter = معامل_مسار_ويب;
عام مرادف route_parameters = معاملات_مسار_ويب;
عام نوع http_router_node = عقدة_موجه_ويب;
عام نوع route_handler<S> = معالج_مسار_ويب<S>;
عام نوع http_route<S> = مسار_ويب<S>;
عام نوع http_router<S> = موجه_ويب<S>;
عام مرادف router_error_kind = صنف_خطأ_موجه_ويب;
عام مرادف http1_exchange = تبادل_ويب1;
عام مرادف new_http_router = موجه_ويب_جديد;
عام مرادف http_router_add = أضف_مسار_ويب;
عام مرادف http_route_parameter = قيمة_معامل_مسار_ويب;
عام مرادف http_router_dispatch = وجه_طلب_ويب;
عام مرادف handle_http1_bytes = عالج_بايتات_ويب1;
عام مرادف route_segment.literal = جزء_مسار_ويب.ثابت;
عام مرادف route_segment.parameter = جزء_مسار_ويب.معامل;
عام مرادف route_segment.remainder = جزء_مسار_ويب.بقية;
عام مرادف router_error_kind.invalid_pattern = صنف_خطأ_موجه_ويب.نمط_غير_صالح;
عام مرادف router_error_kind.invalid_parameter_name = صنف_خطأ_موجه_ويب.اسم_معامل_غير_صالح;
عام مرادف router_error_kind.duplicate_parameter = صنف_خطأ_موجه_ويب.معامل_مكرر;
عام مرادف router_error_kind.remainder_not_last = صنف_خطأ_موجه_ويب.بقية_ليست_أخيرة;
عام مرادف router_error_kind.duplicate_route = صنف_خطأ_موجه_ويب.مسار_مكرر;
عام مرادف router_error_kind.invalid_method = صنف_خطأ_موجه_ويب.طريقة_غير_صالحة;
