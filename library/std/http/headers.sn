استورد chars.ascii;
استورد text.from_bytes;
استورد http.model;

عام عرف حرف_رمز_ويب(ب: ط8): منطقي {
    لو (حرف_أو_رقم_أسكي(ب)) { أرجع صواب; };
    أرجع (ب == 0x21) || (ب == 0x23) || (ب == 0x24) || (ب == 0x25)
        || (ب == 0x26) || (ب == 0x27) || (ب == 0x2A) || (ب == 0x2B)
        || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5E) || (ب == 0x5F)
        || (ب == 0x60) || (ب == 0x7C) || (ب == 0x7E);
}

عام عرف طريقة_ويب_صالحة(الطريقة: &نص): منطقي {
    دع القيمة: نص = *الطريقة;
    لو ((الطول(القيمة) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        لو (!حرف_رمز_ويب(القيمة[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رأس_ويب_صالح(الاسم: &نص): منطقي {
    أرجع طريقة_ويب_صالحة(الاسم);
}

عام عرف قيمة_رأس_ويب_صالحة(القيمة: &نص): منطقي {
    دع النص: نص = *القيمة;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) {
        دع ب: ط8 = النص[ف];
        لو ((ب == 0x0D) || (ب == 0x0A) || (ب == 0x00)) { أرجع خطأ; };
        لو ((ب < 0x20) && (ب != 0x09)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رأس_ويب_مقنن(الاسم: &نص): نص {
    دع القيمة: نص = *الاسم;
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيمة) مثل طبيعي)) {
        ألحق(البايتات, إلى_صغير_أسكي(القيمة[ف]));
        ف := ف + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عام عرف اسما_رأس_ويب_متساويان(الأول: &نص, الثاني: &نص): منطقي {
    دع أ: نص = *الأول;
    دع ب: نص = *الثاني;
    لو ((الطول(أ) مثل طبيعي) != (الطول(ب) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(أ) مثل طبيعي)) {
        لو (إلى_صغير_أسكي(أ[ف]) != إلى_صغير_أسكي(ب[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف أضف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    لو (!اسم_رأس_ويب_صالح(الاسم) || !قيمة_رأس_ويب_صالحة(القيمة)) { أرجع خطأ; };
    دع الاسم_المقنن: نص = اسم_رأس_ويب_مقنن(الاسم);
    دع القيمة_المنسوخة: نص = انسخ_نص_ويب(القيمة);
    دع الرأس: رأس_ويب = { الاسم: الاسم_المقنن, القيمة: القيمة_المنسوخة };
    ألحق(*الرؤوس, الرأس);
    أرجع صواب;
}

عام عرف احذف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص): طبيعي {
    دع المصدر: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه رأس_ويب = [];
    دع المحذوف: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        لو (اسما_رأس_ويب_متساويان(&المصدر[ف].الاسم, الاسم)) {
            المحذوف := المحذوف + 1;
        } وإلا {
            دع الاسم_المنسوخ: نص = انسخ_نص_ويب(&المصدر[ف].الاسم);
            دع القيمة_المنسوخة: نص = انسخ_نص_ويب(&المصدر[ف].القيمة);
            دع الرأس: رأس_ويب = { الاسم: الاسم_المنسوخ, القيمة: القيمة_المنسوخة };
            ألحق(الناتج, الرأس);
        };
        ف := ف + 1;
    }
    *الرؤوس := الناتج;
    أرجع المحذوف;
}

عام عرف ضع_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    دع عدد_المحذوف: طبيعي = احذف_رأس_ويب(الرؤوس, الاسم);
    أرجع أضف_رأس_ويب(الرؤوس, الاسم, القيمة);
}

عام عرف أول_قيمة_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): اختياري نص {
    دع القيم: متجه رأس_ويب = *الرؤوس;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (اسما_رأس_ويب_متساويان(&القيم[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود(انسخ_نص_ويب(&القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف قيم_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): متجه نص {
    دع القيم: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(القيم) مثل طبيعي)) {
        لو (اسما_رأس_ويب_متساويان(&القيم[ف].الاسم, الاسم)) {
            ألحق(الناتج, انسخ_نص_ويب(&القيم[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف يحتوي_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): منطقي {
    طابق أول_قيمة_رأس_ويب(الرؤوس, الاسم) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}


عام عرف انسخ_رؤوس_ويب(الرؤوس: &متجه رأس_ويب): متجه رأس_ويب {
    دع المصدر: متجه رأس_ويب = *الرؤوس;
    دع الناتج: متغير متجه رأس_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) {
        دع الاسم: نص = انسخ_نص_ويب(&المصدر[ف].الاسم);
        دع القيمة: نص = انسخ_نص_ويب(&المصدر[ف].القيمة);
        دع الرأس: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
        ألحق(الناتج, الرأس);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اسم_رأس_ويب(الرأس: &رأس_ويب): نص { دع القيمة: رأس_ويب = *الرأس; أرجع انسخ_نص_ويب(&القيمة.الاسم); }
عام عرف قيمة_رأس_ويب(الرأس: &رأس_ويب): نص { دع القيمة: رأس_ويب = *الرأس; أرجع انسخ_نص_ويب(&القيمة.القيمة); }

عرف انسخ_جسم_رسالة_ويب(الجسم: &متجه ط8): متجه ط8 {
    دع المصدر: متجه ط8 = *الجسم;
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المصدر) مثل طبيعي)) { ألحق(الناتج, المصدر[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف طريقة_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_نص_ويب(&القيمة.الطريقة); }
عام عرف هدف_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_نص_ويب(&القيمة.الهدف); }
عام عرف إصدار_طلب_ويب(الطلب: &طلب_ويب_مخزن): إصدار_ويب { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع القيمة.الإصدار; }
عام عرف جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): متجه ط8 { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع انسخ_جسم_رسالة_ويب(&القيمة.الجسم); }
عام عرف أول_رأس_طلب_ويب(الطلب: &طلب_ويب_مخزن, الاسم: &نص): اختياري نص { دع القيمة: طلب_ويب_مخزن = *الطلب; أرجع أول_قيمة_رأس_ويب(&القيمة.الرؤوس, الاسم); }
عام عرف إصدار_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): إصدار_ويب { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع القيمة.الإصدار; }
عام عرف ضع_إصدار_استجابة_ويب(الاستجابة: &متغير استجابة_ويب_مخزنة, الإصدار: إصدار_ويب): فراغ { (*الاستجابة).الإصدار := الإصدار; }
عام عرف حالة_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): طبيعي { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع القيمة.الحالة; }
عام عرف جسم_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): متجه ط8 { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع انسخ_جسم_رسالة_ويب(&القيمة.الجسم); }
عام عرف أول_رأس_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة, الاسم: &نص): اختياري نص { دع القيمة: استجابة_ويب_مخزنة = *الاستجابة; أرجع أول_قيمة_رأس_ويب(&القيمة.الرؤوس, الاسم); }

// English public aliases.
عام مرادف http_method_is_valid = طريقة_ويب_صالحة;
عام مرادف http_header_append = أضف_رأس_ويب;
عام مرادف http_header_remove = احذف_رأس_ويب;
عام مرادف http_header_set = ضع_رأس_ويب;
عام مرادف http_header_first = أول_قيمة_رأس_ويب;
عام مرادف http_header_values = قيم_رأس_ويب;
عام مرادف http_header_contains = يحتوي_رأس_ويب;
عام مرادف http_request_method = طريقة_طلب_ويب;
عام مرادف http_request_target = هدف_طلب_ويب;
عام مرادف http_request_version = إصدار_طلب_ويب;
عام مرادف http_request_body = جسم_طلب_ويب;
عام مرادف http_request_header_first = أول_رأس_طلب_ويب;
عام مرادف http_response_version = إصدار_استجابة_ويب;
عام مرادف http_response_set_version = ضع_إصدار_استجابة_ويب;
عام مرادف http_response_status = حالة_استجابة_ويب;
عام مرادف http_response_body = جسم_استجابة_ويب;
عام مرادف http_response_header_first = أول_رأس_استجابة_ويب;
عام مرادف http_header_name = اسم_رأس_ويب;
عام مرادف http_header_value = قيمة_رأس_ويب;
