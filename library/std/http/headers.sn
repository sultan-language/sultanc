استورد chars.ascii;
استورد text.from_bytes;
استورد http.model;

عام عرف حرف_رمز_ويب(ب: ط8): منطقي {
    إذا (حرف_أو_رقم_أسكي(ب)) { أرجع صواب; };
    أرجع (ب == 0x21) || (ب == 0x23) || (ب == 0x24) || (ب == 0x25)
        || (ب == 0x26) || (ب == 0x27) || (ب == 0x2A) || (ب == 0x2B)
        || (ب == 0x2D) || (ب == 0x2E) || (ب == 0x5E) || (ب == 0x5F)
        || (ب == 0x60) || (ب == 0x7C) || (ب == 0x7E);
}

عام عرف طريقة_ويب_صالحة(الطريقة: &نص): منطقي {
    إذا ((الطول((*الطريقة)) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الطريقة)) مثل طبيعي)) {
        إذا (!حرف_رمز_ويب((*الطريقة)[ف])) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رأس_ويب_صالح(الاسم: &نص): منطقي {
    أرجع طريقة_ويب_صالحة(الاسم);
}

عام عرف قيمة_رأس_ويب_صالحة(القيمة: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*القيمة)) مثل طبيعي)) {
        دع ب: ط8 = (*القيمة)[ف];
        إذا ((ب == 0x0D) || (ب == 0x0A) || (ب == 0x00)) { أرجع خطأ; };
        إذا ((ب < 0x20) && (ب != 0x09)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف اسم_رأس_ويب_مقنن(الاسم: &نص): نص {
    دع العدد: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع البايتات: متغير متجه ط8 = [];
    احجز_سعة(البايتات, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(البايتات, إلى_صغير_أسكي((*الاسم)[ف]));
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

// ASCII lowercase of one byte, kept local so the comparison loop inlines it.
عرف صغير_أسكي_رأس(ب: ط8): ط8 {
    إذا (ب >= 0x41 && ب <= 0x5A) { أرجع ب + 0x20; };
    أرجع ب;
}

// Stored names are already lowercase (اسم_رأس_ويب_مقنن), so equal bytes are
// the common case and skip the folding.
عام عرف اسما_رأس_ويب_متساويان(الأول: &نص, الثاني: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الأول) مثل طبيعي;
    إذا (العدد != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع أ: ط8 = (*الأول)[ف];
        دع ب: ط8 = (*الثاني)[ف];
        إذا (أ != ب && صغير_أسكي_رأس(أ) != صغير_أسكي_رأس(ب)) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف أضف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    إذا (!اسم_رأس_ويب_صالح(الاسم) || !قيمة_رأس_ويب_صالحة(القيمة)) { أرجع خطأ; };
    دع الاسم_المقنن: نص = اسم_رأس_ويب_مقنن(الاسم);
    دع القيمة_المنسوخة: نص = انسخ_نص_ويب(القيمة);
    دع الرأس: رأس_ويب = { الاسم: الاسم_المقنن, القيمة: القيمة_المنسوخة };
    ألحق(*الرؤوس, الرأس);
    أرجع صواب;
}

// In place, as Rust's Vec::retain: kept headers move forward in order (a
// swap moves, it copies nothing), removed ones end past the new length and
// are dropped by the truncation.
عام عرف احذف_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص): طبيعي {
    دع العدد: طبيعي = الطول(*الرؤوس) مثل طبيعي;
    دع المكتوب: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (!اسما_رأس_ويب_متساويان(&(*الرؤوس)[ف].الاسم, الاسم)) {
            إذا (المكتوب != ف) { بدّل((*الرؤوس)[المكتوب], (*الرؤوس)[ف]); };
            المكتوب := المكتوب + 1;
        };
        ف := ف + 1;
    }
    إذا (المكتوب < العدد) { اقتطع(*الرؤوس, المكتوب); };
    أرجع العدد - المكتوب;
}

عام عرف ضع_رأس_ويب(الرؤوس: &متغير متجه رأس_ويب, الاسم: &نص, القيمة: &نص): منطقي {
    دع عدد_المحذوف: طبيعي = احذف_رأس_ويب(الرؤوس, الاسم);
    أرجع أضف_رأس_ويب(الرؤوس, الاسم, القيمة);
}

عام عرف أول_قيمة_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): اختياري نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الرؤوس)) مثل طبيعي)) {
        إذا (اسما_رأس_ويب_متساويان(&(*الرؤوس)[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود(انسخ_نص_ويب(&(*الرؤوس)[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف قيم_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الرؤوس)) مثل طبيعي)) {
        إذا (اسما_رأس_ويب_متساويان(&(*الرؤوس)[ف].الاسم, الاسم)) {
            ألحق(الناتج, انسخ_نص_ويب(&(*الرؤوس)[ف].القيمة));
        };
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف يحتوي_رأس_ويب(الرؤوس: &متجه رأس_ويب, الاسم: &نص): منطقي {
    طابق أول_قيمة_رأس_ويب(الرؤوس, الاسم) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}


عام عرف انسخ_رؤوس_ويب(الرؤوس: &متجه رأس_ويب): متجه رأس_ويب {
    دع الناتج: متغير متجه رأس_ويب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الرؤوس)) مثل طبيعي)) {
        دع الاسم: نص = انسخ_نص_ويب(&(*الرؤوس)[ف].الاسم);
        دع القيمة: نص = انسخ_نص_ويب(&(*الرؤوس)[ف].القيمة);
        دع الرأس: رأس_ويب = { الاسم: الاسم, القيمة: القيمة };
        ألحق(الناتج, الرأس);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف اسم_رأس_ويب(الرأس: &رأس_ويب): نص { أرجع انسخ_نص_ويب(&(*الرأس).الاسم); }
عام عرف قيمة_رأس_ويب(الرأس: &رأس_ويب): نص { أرجع انسخ_نص_ويب(&(*الرأس).القيمة); }

عرف انسخ_جسم_رسالة_ويب(الجسم: &متجه ط8): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجسم)) مثل طبيعي)) { ألحق(الناتج, (*الجسم)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عام عرف طريقة_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { أرجع انسخ_نص_ويب(&(*الطلب).الطريقة); }
عام عرف هدف_طلب_ويب(الطلب: &طلب_ويب_مخزن): نص { أرجع انسخ_نص_ويب(&(*الطلب).الهدف); }
عام عرف إصدار_طلب_ويب(الطلب: &طلب_ويب_مخزن): إصدار_ويب { أرجع (*الطلب).الإصدار; }
عام عرف جسم_طلب_ويب(الطلب: &طلب_ويب_مخزن): متجه ط8 { أرجع انسخ_جسم_رسالة_ويب(&(*الطلب).الجسم); }
عام عرف أول_رأس_طلب_ويب(الطلب: &طلب_ويب_مخزن, الاسم: &نص): اختياري نص { أرجع أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, الاسم); }
عام عرف إصدار_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): إصدار_ويب { أرجع (*الاستجابة).الإصدار; }
عام عرف ضع_إصدار_استجابة_ويب(الاستجابة: &متغير استجابة_ويب_مخزنة, الإصدار: إصدار_ويب): فراغ { (*الاستجابة).الإصدار := الإصدار; }
عام عرف حالة_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): طبيعي { أرجع (*الاستجابة).الحالة; }
عام عرف جسم_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة): متجه ط8 { أرجع انسخ_جسم_رسالة_ويب(&(*الاستجابة).الجسم); }
عام عرف أول_رأس_استجابة_ويب(الاستجابة: &استجابة_ويب_مخزنة, الاسم: &نص): اختياري نص { أرجع أول_قيمة_رأس_ويب(&(*الاستجابة).الرؤوس, الاسم); }

// English public aliases.
عام مرادف http_method_is_valid = طريقة_ويب_صالحة;
عام مرادف http_header_append = أضف_رأس_ويب;
عام مرادف http_header_remove = احذف_رأس_ويب;
عام مرادف http_header_set = ضع_رأس_ويب;
عام مرادف http_header_first = أول_قيمة_رأس_ويب;
عام مرادف http_header_values = قيم_رأس_ويب;
عام مرادف http_header_contains = يحتوي_رأس_ويب;
عام مرادف http_request_method = طريقة_طلب_ويب;
عام مرادف http_request_target = هدف_طلب_ويب;
عام مرادف http_request_version = إصدار_طلب_ويب;
عام مرادف http_request_body = جسم_طلب_ويب;
عام مرادف http_request_header_first = أول_رأس_طلب_ويب;
عام مرادف http_response_version = إصدار_استجابة_ويب;
عام مرادف http_response_set_version = ضع_إصدار_استجابة_ويب;
عام مرادف http_response_status = حالة_استجابة_ويب;
عام مرادف http_response_body = جسم_استجابة_ويب;
عام مرادف http_response_header_first = أول_رأس_استجابة_ويب;
عام مرادف http_header_name = اسم_رأس_ويب;
عام مرادف http_header_value = قيمة_رأس_ويب;
