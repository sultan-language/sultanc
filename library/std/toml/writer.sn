استورد toml.parser;
استورد text.from_bytes;

// TOML serialization of a parsed or built document (TOML 1.0). The root's
// plain values come first; each nested table follows as a [a.b] section and
// each array whose elements are all tables as [[a.b]] sections. Tables and
// arrays met inside an inline array are written inline. Keys are bare when
// they consist of A-Z a-z 0-9 _ -, and quoted otherwise. Numbers and
// date-times keep the text the document holds. حلل_تومل of the output gives
// back the same keys, values and table structure.

عرف ألحق_بايت_تومل(الناتج: &متغير متجه ط8, البايت: ط8): فراغ { ألحق(*الناتج, البايت); }

عرف ألحق_نص_خام_تومل(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
}

عرف سداسي_تومل(القيمة: ط8): ط8 {
    إذا (القيمة < 10) { أرجع 0x30 + القيمة; };
    أرجع 0x41 + القيمة - 10;
}

// A basic string: ", \ and the control characters are escaped.
عرف ألحق_سلسلة_تومل(الناتج: &متغير متجه ط8, النص: &نص): فراغ {
    ألحق_بايت_تومل(الناتج, 0x22);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x22) { ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x22); }
        وإلا إذا (ب == 0x5C) { ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x5C); }
        وإلا إذا (ب == 0x0A) { ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x6E); }
        وإلا إذا (ب == 0x09) { ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x74); }
        وإلا إذا (ب == 0x0D) { ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x72); }
        وإلا إذا (ب < 0x20 || ب == 0x7F) {
            ألحق_بايت_تومل(الناتج, 0x5C); ألحق_بايت_تومل(الناتج, 0x75);
            ألحق_بايت_تومل(الناتج, 0x30); ألحق_بايت_تومل(الناتج, 0x30);
            ألحق_بايت_تومل(الناتج, سداسي_تومل(ب >> 4));
            ألحق_بايت_تومل(الناتج, سداسي_تومل(ب & 15));
        }
        وإلا { ألحق_بايت_تومل(الناتج, ب); };
        ف := ف + 1;
    }
    ألحق_بايت_تومل(الناتج, 0x22);
}

عرف مفتاح_عار_تومل(المفتاح: &نص): منطقي {
    إذا ((الطول(*المفتاح) مثل طبيعي) == 0) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفتاح) مثل طبيعي)) {
        دع ب: ط8 = (*المفتاح)[ف];
        دع صالح: منطقي = (ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A)
            || (ب >= 0x30 && ب <= 0x39) || ب == 0x5F || ب == 0x2D;
        إذا (!صالح) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف ألحق_مفتاح_تومل(الناتج: &متغير متجه ط8, المفتاح: &نص): فراغ {
    إذا (مفتاح_عار_تومل(المفتاح)) { ألحق_نص_خام_تومل(الناتج, المفتاح); }
    وإلا { ألحق_سلسلة_تومل(الناتج, المفتاح); };
}

عرف ألحق_مسار_تومل(الناتج: &متغير متجه ط8, المسار: &متجه نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المسار) مثل طبيعي)) {
        إذا (ف > 0) { ألحق_بايت_تومل(الناتج, 0x2E); };
        ألحق_مفتاح_تومل(الناتج, &(*المسار)[ف]);
        ف := ف + 1;
    }
}

عرف قيمة_جدول_هل(القيمة: &قيمة_تومل): منطقي {
    طابق *القيمة مع
    | قيمة_تومل.جدول(_) -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// A non-empty array whose every element is a table: written as [[...]].
عرف مصفوفة_جداول_هل(الوثيقة: &وثيقة_تومل, القيمة: &قيمة_تومل): منطقي {
    طابق *القيمة مع
    | قيمة_تومل.مصفوفة(الفهرس) -> {
        دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
        إذا ((الطول(القيم) مثل طبيعي) == 0) { أرجع خطأ; };
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            إذا (!قيمة_جدول_هل(&القيم[ف])) { أرجع خطأ; };
            ف := ف + 1;
        }
        أرجع صواب;
    }
    | _ -> { أرجع خطأ; };
}

عرف ألحق_قيمة_مضمنة_تومل(الوثيقة: &وثيقة_تومل, الناتج: &متغير متجه ط8, القيمة: &قيمة_تومل): فراغ {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { ألحق_سلسلة_تومل(الناتج, &النص); }
    | قيمة_تومل.منطق(المنطق) -> {
        إذا (المنطق) { ألحق_بايتات_نص(الناتج, «true»); } وإلا { ألحق_بايتات_نص(الناتج, «false»); };
    }
    | قيمة_تومل.عدد(النص) -> { ألحق_نص_خام_تومل(الناتج, &النص); }
    | قيمة_تومل.تاريخ_وقت(النص) -> { ألحق_نص_خام_تومل(الناتج, &النص); }
    | قيمة_تومل.مصفوفة(الفهرس) -> {
        دع القيم: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, الفهرس);
        ألحق_بايت_تومل(الناتج, 0x5B);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القيم) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايت_تومل(الناتج, 0x2C); ألحق_بايت_تومل(الناتج, 0x20); };
            ألحق_قيمة_مضمنة_تومل(الوثيقة, الناتج, &القيم[ف]);
            ف := ف + 1;
        }
        ألحق_بايت_تومل(الناتج, 0x5D);
    }
    | قيمة_تومل.جدول(الفهرس) -> {
        دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الفهرس);
        ألحق_بايت_تومل(الناتج, 0x7B);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            إذا (ف > 0) { ألحق_بايت_تومل(الناتج, 0x2C); };
            ألحق_بايت_تومل(الناتج, 0x20);
            ألحق_مفتاح_تومل(الناتج, &المداخل[ف].المفتاح);
            ألحق_بايتات_نص(الناتج, « = »);
            ألحق_قيمة_مضمنة_تومل(الوثيقة, الناتج, &المداخل[ف].القيمة);
            ف := ف + 1;
        }
        إذا ((الطول(المداخل) مثل طبيعي) > 0) { ألحق_بايت_تومل(الناتج, 0x20); };
        ألحق_بايت_تومل(الناتج, 0x7D);
    };
}

// One table's `key = value` lines, then its [section] and [[section]]
// children under المسار.
عرف ألحق_جدول_تومل(
    الوثيقة: &وثيقة_تومل, الناتج: &متغير متجه ط8, الفهرس: طبيعي, المسار: &متجه نص
): فراغ {
    دع المداخل: متجه مدخل_جدول_تومل = مداخل_جدول_تومل(الوثيقة, الفهرس);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع القيمة: قيمة_تومل = انسخ_قيمة_تومل(&المداخل[ف].القيمة);
        إذا (!قيمة_جدول_هل(&القيمة) && !مصفوفة_جداول_هل(الوثيقة, &القيمة)) {
            ألحق_مفتاح_تومل(الناتج, &المداخل[ف].المفتاح);
            ألحق_بايتات_نص(الناتج, « = »);
            ألحق_قيمة_مضمنة_تومل(الوثيقة, الناتج, &القيمة);
            ألحق_بايت_تومل(الناتج, 0x0A);
        };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        دع القيمة: قيمة_تومل = انسخ_قيمة_تومل(&المداخل[ف].القيمة);
        دع المسار_الفرعي: متغير متجه نص = [];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(*المسار) مثل طبيعي)) { ألحق(المسار_الفرعي, انسخ_نص(&(*المسار)[ك])); ك := ك + 1; }
        ألحق(المسار_الفرعي, انسخ_نص(&المداخل[ف].المفتاح));
        طابق القيمة مع
        | قيمة_تومل.جدول(الفرعي) -> {
            ألحق_بايت_تومل(الناتج, 0x0A);
            ألحق_بايت_تومل(الناتج, 0x5B);
            ألحق_مسار_تومل(الناتج, &المسار_الفرعي);
            ألحق_بايت_تومل(الناتج, 0x5D);
            ألحق_بايت_تومل(الناتج, 0x0A);
            ألحق_جدول_تومل(الوثيقة, الناتج, الفرعي, &المسار_الفرعي);
        }
        | قيمة_تومل.مصفوفة(فهرس_المصفوفة) -> {
            إذا (مصفوفة_جداول_هل(الوثيقة, &القيمة)) {
                دع العناصر: متجه قيمة_تومل = قيم_مصفوفة_تومل(الوثيقة, فهرس_المصفوفة);
                دع ع: متغير طبيعي = 0;
                طالما (ع < (الطول(العناصر) مثل طبيعي)) {
                    طابق انسخ_قيمة_تومل(&العناصر[ع]) مع
                    | قيمة_تومل.جدول(فهرس_العنصر) -> {
                        ألحق_بايت_تومل(الناتج, 0x0A);
                        ألحق_بايتات_نص(الناتج, «[[»);
                        ألحق_مسار_تومل(الناتج, &المسار_الفرعي);
                        ألحق_بايتات_نص(الناتج, «]]»);
                        ألحق_بايت_تومل(الناتج, 0x0A);
                        ألحق_جدول_تومل(الوثيقة, الناتج, فهرس_العنصر, &المسار_الفرعي);
                    }
                    | _ -> { };
                    ع := ع + 1;
                }
            };
        }
        | _ -> { };
        ف := ف + 1;
    }
}

عام عرف تومل_إلى_نص(الوثيقة: &وثيقة_تومل): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع المسار: متجه نص = [];
    ألحق_جدول_تومل(الوثيقة, &متغير الناتج, (*الوثيقة).الجذر, &المسار);
    أرجع من_بايتات(&الناتج);
}

عام مرادف toml_to_text = تومل_إلى_نص;
