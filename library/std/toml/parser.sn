استورد text.from_bytes;
استورد text.compare;
استورد encoding.utf8;

// Generic TOML document model. Package semantics belong to compiler/driver/package_graph.sn.
// Tables/arrays are arena-indexed so recursive TOML values do not require a
// recursive value layout in the language type system.
عام نوع قيمة_تومل =
    | سلسلة بنوع نص
    | منطق بنوع منطقي
    | عدد بنوع نص
    | تاريخ_وقت بنوع نص
    | مصفوفة بنوع طبيعي
    | جدول بنوع طبيعي
;

عام نوع مدخل_جدول_تومل = {
    المفتاح: نص,
    القيمة: قيمة_تومل,
    الإزاحة: طبيعي
};

عام نوع جدول_تومل = {
    المداخل: متجه مدخل_جدول_تومل,
    معلن: منطقي,
    مغلق: منطقي
};

عام نوع مصفوفة_تومل = {
    القيم: متجه قيمة_تومل
};

عام نوع وثيقة_تومل = {
    الجذر: طبيعي,
    الجداول: متجه جدول_تومل,
    المصفوفات: متجه مصفوفة_تومل
};

عام نوع صنف_خطأ_تومل =
    | نهاية_غير_متوقعة
    | رمز_غير_متوقع
    | مفتاح_غير_صالح
    | قيمة_غير_صالحة
    | هروب_غير_صالح
    | يونيكود_غير_صالح
    | مفتاح_مكرر
    | جدول_مكرر
    | تعارض_نوع
    | جدول_ضمني_مغلق
    | نص_لاحق
    // Inline arrays/tables nested deeper than حد_تعشيش_تومل().
    | تعشيش_عميق_جدا
;

عام نوع خطأ_تومل = {
    الصنف: صنف_خطأ_تومل,
    الإزاحة: طبيعي
};

// Independent copies of document values for the owning query results.
عام عرف انسخ_قيمة_تومل(القيمة: &قيمة_تومل): قيمة_تومل {
    طابق *القيمة مع
    | قيمة_تومل.سلسلة(النص) -> { أرجع قيمة_تومل.سلسلة(انسخ_نص(&النص)); }
    | قيمة_تومل.منطق(المنطق) -> { أرجع قيمة_تومل.منطق(المنطق); }
    | قيمة_تومل.عدد(النص) -> { أرجع قيمة_تومل.عدد(انسخ_نص(&النص)); }
    | قيمة_تومل.تاريخ_وقت(النص) -> { أرجع قيمة_تومل.تاريخ_وقت(انسخ_نص(&النص)); }
    | قيمة_تومل.مصفوفة(الفهرس) -> { أرجع قيمة_تومل.مصفوفة(الفهرس); }
    | قيمة_تومل.جدول(الفهرس) -> { أرجع قيمة_تومل.جدول(الفهرس); };
}

عرف انسخ_قيم_تومل(القيم: &متجه قيمة_تومل): متجه قيمة_تومل {
    دع الناتج: متغير متجه قيمة_تومل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        ألحق(الناتج, انسخ_قيمة_تومل(&(*القيم)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_مداخل_جدول_تومل(المداخل: &متجه مدخل_جدول_تومل): متجه مدخل_جدول_تومل {
    دع الناتج: متغير متجه مدخل_جدول_تومل = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المداخل) مثل طبيعي)) {
        دع المدخل: مدخل_جدول_تومل = {
            المفتاح: انسخ_نص(&(*المداخل)[ف].المفتاح),
            القيمة: انسخ_قيمة_تومل(&(*المداخل)[ف].القيمة),
            الإزاحة: (*المداخل)[ف].الإزاحة
        };
        ألحق(الناتج, المدخل);
        ف := ف + 1;
    }
    أرجع الناتج;
}

نوع محلل_تومل = {
    النص: نص,
    الموضع: طبيعي,
    الجدول_الحالي: طبيعي,
    الجذر: طبيعي,
    الجداول: متجه جدول_تومل,
    المصفوفات: متجه مصفوفة_تومل,
    العمق: طبيعي
};

// The deepest inline array/table nesting the recursive parser accepts.
عام عرف حد_تعشيش_تومل(): طبيعي { أرجع 512; }
عام مرادف toml_max_nesting = حد_تعشيش_تومل;

عرف خطأ_تومل_عند(الصنف: صنف_خطأ_تومل, الموضع: طبيعي): خطأ_تومل {
    دع الخطأ: خطأ_تومل = { الصنف: الصنف, الإزاحة: الموضع };
    أرجع الخطأ;
}

عرف جدول_تومل_جديد(معلن: منطقي, مغلق: منطقي): جدول_تومل {
    دع المداخل: متجه مدخل_جدول_تومل = [];
    دع الجدول: جدول_تومل = { المداخل: المداخل, معلن: معلن, مغلق: مغلق };
    أرجع الجدول;
}

عرف مصفوفة_تومل_جديدة(): مصفوفة_تومل {
    دع القيم: متجه قيمة_تومل = [];
    دع المصفوفة: مصفوفة_تومل = { القيم: القيم };
    أرجع المصفوفة;
}

عرف أضف_جدول_تومل(المحلل: &متغير محلل_تومل, معلن: منطقي, مغلق: منطقي): طبيعي {
    دع الفهرس: طبيعي = الطول((*المحلل).الجداول) مثل طبيعي;
    ألحق((*المحلل).الجداول, جدول_تومل_جديد(معلن, مغلق));
    أرجع الفهرس;
}

عرف أضف_مصفوفة_تومل(المحلل: &متغير محلل_تومل): طبيعي {
    دع الفهرس: طبيعي = الطول((*المحلل).المصفوفات) مثل طبيعي;
    ألحق((*المحلل).المصفوفات, مصفوفة_تومل_جديدة());
    أرجع الفهرس;
}

عرف موضع_مدخل_تومل(الجدول: &جدول_تومل, المفتاح: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الجدول).المداخل) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الجدول).المداخل[ف].المفتاح, المفتاح)) {
            أرجع اختياري.موجود(ف);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف قيمة_مدخل_تومل_داخلية(
    المحلل: &محلل_تومل,
    فهرس_الجدول: طبيعي,
    المفتاح: &نص
): اختياري قيمة_تومل {
    إذا (فهرس_الجدول >= (الطول((*المحلل).الجداول) مثل طبيعي)) {
        أرجع اختياري.لا_شيء();
    };
    دع الجدول: &جدول_تومل = &(*المحلل).الجداول[فهرس_الجدول];
    طابق موضع_مدخل_تومل(الجدول, المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        أرجع اختياري.موجود(انسخ_قيمة_تومل(&(*الجدول).المداخل[الموضع].القيمة));
    };
}

عرف أضف_مدخل_تومل(
    المحلل: &متغير محلل_تومل,
    فهرس_الجدول: طبيعي,
    المفتاح: نص,
    القيمة: قيمة_تومل,
    الإزاحة: طبيعي
): منطقي {
    إذا (فهرس_الجدول >= (الطول((*المحلل).الجداول) مثل طبيعي)) { أرجع خطأ; };
    طابق موضع_مدخل_تومل(&(*المحلل).الجداول[فهرس_الجدول], &المفتاح) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    دع المدخل: مدخل_جدول_تومل = { المفتاح: المفتاح, القيمة: القيمة, الإزاحة: الإزاحة };
    ألحق((*المحلل).الجداول[فهرس_الجدول].المداخل, المدخل);
    أرجع صواب;
}

عرف اضبط_جدول_معلنا(
    المحلل: &متغير محلل_تومل,
    الفهرس: طبيعي
): منطقي {
    إذا (الفهرس >= (الطول((*المحلل).الجداول) مثل طبيعي)) { أرجع خطأ; };
    إذا ((*المحلل).الجداول[الفهرس].مغلق || (*المحلل).الجداول[الفهرس].معلن) { أرجع خطأ; };
    (*المحلل).الجداول[الفهرس].معلن := صواب;
    أرجع صواب;
}

عرف أغلق_جدول_تومل(المحلل: &متغير محلل_تومل, الفهرس: طبيعي): فراغ {
    إذا (الفهرس < (الطول((*المحلل).الجداول) مثل طبيعي)) {
        (*المحلل).الجداول[الفهرس].مغلق := صواب;
    };
}

عرف ألحق_مصفوفة_تومل(
    المحلل: &متغير محلل_تومل,
    الفهرس: طبيعي,
    القيمة: قيمة_تومل
): منطقي {
    إذا (الفهرس >= (الطول((*المحلل).المصفوفات) مثل طبيعي)) { أرجع خطأ; };
    ألحق((*المحلل).المصفوفات[الفهرس].القيم, القيمة);
    أرجع صواب;
}

عرف في_نهاية_تومل(المحلل: &محلل_تومل): منطقي {
    أرجع (*المحلل).الموضع >= (الطول((*المحلل).النص) مثل طبيعي);
}

عرف بايت_تومل_عند(المحلل: &محلل_تومل, الموضع: طبيعي): ط8 {
    أرجع (*المحلل).النص[الموضع];
}

عرف بايت_تومل_الحالي(المحلل: &محلل_تومل): اختياري ط8 {
    إذا (في_نهاية_تومل(المحلل)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(بايت_تومل_عند(المحلل, (*المحلل).الموضع));
}

عرف تقدم_تومل(المحلل: &متغير محلل_تومل): فراغ {
    إذا ((*المحلل).الموضع < (الطول((*المحلل).النص) مثل طبيعي)) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
    };
}

عرف تجاوز_مسافة_تومل(المحلل: &متغير محلل_تومل): فراغ {
    دع مستمر: متغير منطقي = صواب;
    طالما (!في_نهاية_تومل(المحلل) && مستمر) {
        دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        إذا ((ب == 0x20) || (ب == 0x09)) { تقدم_تومل(المحلل); }
        وإلا { مستمر := خطأ; };
    }
}

عرف تجاوز_تعليق_تومل(المحلل: &متغير محلل_تومل): فراغ {
    إذا (في_نهاية_تومل(المحلل)) { أرجع; };
    إذا (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x23) { أرجع; };
    طالما (!في_نهاية_تومل(المحلل)) {
        دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        إذا ((ب == 0x0A) || (ب == 0x0D)) { أرجع; };
        تقدم_تومل(المحلل);
    }
}

عرف تجاوز_نهاية_سطر_تومل(المحلل: &متغير محلل_تومل): منطقي {
    إذا (في_نهاية_تومل(المحلل)) { أرجع صواب; };
    دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
    إذا (ب == 0x0A) { تقدم_تومل(المحلل); أرجع صواب; };
    إذا (ب == 0x0D) {
        تقدم_تومل(المحلل);
        إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x0A)) {
            تقدم_تومل(المحلل);
            أرجع صواب;
        };
        أرجع خطأ;
    };
    أرجع خطأ;
}

عرف تجاوز_فراغ_وتعليقات_مصفوفة(المحلل: &متغير محلل_تومل): منطقي {
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        تجاوز_مسافة_تومل(المحلل);
        إذا (في_نهاية_تومل(المحلل)) { أرجع صواب; };
        دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        إذا (ب == 0x23) {
            تجاوز_تعليق_تومل(المحلل);
        } وإلا إذا ((ب == 0x0A) || (ب == 0x0D)) {
            إذا (!تجاوز_نهاية_سطر_تومل(المحلل)) { أرجع خطأ; };
        } وإلا {
            مستمر := خطأ;
        };
    }
    أرجع صواب;
}

عرف يطابق_تومل_عند(المحلل: &محلل_تومل, الموضع: طبيعي, النص: نص): منطقي {
    دع الهدف: نص = النص;
    إذا ((الموضع + (الطول(الهدف) مثل طبيعي)) > (الطول((*المحلل).النص) مثل طبيعي)) {
        أرجع خطأ;
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الهدف) مثل طبيعي)) {
        إذا (بايت_تومل_عند(المحلل, الموضع + ف) != الهدف[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف قيمة_سداسية_تومل(البايت: ط8): اختياري ط32 {
    إذا ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع اختياري.موجود((البايت - 0x30) مثل ط32); };
    إذا ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع اختياري.موجود(((البايت - 0x41) مثل ط32) + 10); };
    إذا ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع اختياري.موجود(((البايت - 0x61) مثل ط32) + 10); };
    أرجع اختياري.لا_شيء();
}

عرف اقرأ_يونيكود_تومل(
    المحلل: &متغير محلل_تومل,
    العدد: طبيعي
): نتيجة ط32, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا ((البداية + العدد) > (الطول((*المحلل).النص) مثل طبيعي)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), البداية));
    };
    دع القيمة: متغير ط32 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        طابق قيمة_سداسية_تومل(بايت_تومل_عند(المحلل, البداية + ف)) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), البداية + ف));
        }
        | اختياري.موجود(الرقم) -> { القيمة := (القيمة << 4) | الرقم; };
        ف := ف + 1;
    }
    (*المحلل).الموضع := البداية + العدد;
    أرجع نتيجة.نجح(القيمة);
}

عرف ألحق_سلم_تومل(البايتات: &متغير متجه ط8, القيمة: ط32): منطقي {
    إذا (!صالح_كسلم_يونيكود(القيمة)) { أرجع خطأ; };
    دع الحالية: متغير متجه ط8 = [];
    بدّل((*البايتات), الحالية);
    طابق ألحق_محرف_يوتيف8(الحالية, القيمة) مع
    | نتيجة_ترميز_يوتيف8.قيمة_غير_صالحة -> { أرجع خطأ; }
    | نتيجة_ترميز_يوتيف8.مشفر(الناتج) -> { *البايتات := الناتج; أرجع صواب; };
}

عرف حلل_سلسلة_أساسية_تومل(
    المحلل: &متغير محلل_تومل,
    متعددة: منطقي
): نتيجة نص, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا (متعددة) {
        إذا (!يطابق_تومل_عند(المحلل, البداية, «"""»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        (*المحلل).الموضع := البداية + 3;
        إذا (!في_نهاية_تومل(المحلل)) {
            دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            إذا ((ب == 0x0A) || (ب == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); };
        };
    } وإلا {
        إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x22)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        تقدم_تومل(المحلل);
    };

    دع الناتج: متغير متجه ط8 = [];
    طالما (!في_نهاية_تومل(المحلل)) {
        دع الموضع: طبيعي = (*المحلل).الموضع;
        إذا (متعددة && يطابق_تومل_عند(المحلل, الموضع, «"""»)) {
            دع عدد_الاقتباسات: متغير طبيعي = 3;
            طالما (((الموضع + عدد_الاقتباسات) < (الطول((*المحلل).النص) مثل طبيعي))
                && (بايت_تومل_عند(المحلل, الموضع + عدد_الاقتباسات) == 0x22)) {
                عدد_الاقتباسات := عدد_الاقتباسات + 1;
            }
            إذا (عدد_الاقتباسات > 5) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
            };
            دع داخلية: متغير طبيعي = عدد_الاقتباسات - 3;
            طالما (داخلية > 0) { ألحق(الناتج, 0x22); داخلية := داخلية - 1; }
            (*المحلل).الموضع := الموضع + عدد_الاقتباسات;
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        دع ب: ط8 = بايت_تومل_عند(المحلل, الموضع);
        إذا (!متعددة && (ب == 0x22)) {
            تقدم_تومل(المحلل);
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        إذا (!متعددة && ((ب == 0x0A) || (ب == 0x0D))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        إذا (((ب < 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)) || (ب == 0x7F)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        إذا (ب != 0x5C) {
            ألحق(الناتج, ب);
            تقدم_تومل(المحلل);
        } وإلا {
            تقدم_تومل(المحلل);
            إذا (في_نهاية_تومل(المحلل)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
            };
            دع هـ: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            إذا (متعددة && ((هـ == 0x0A) || (هـ == 0x0D))) {
                إذا (!تجاوز_نهاية_سطر_تومل(المحلل)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.هروب_غير_صالح(), (*المحلل).الموضع));
                };
                دع مستمر: متغير منطقي = صواب;
                طالما (!في_نهاية_تومل(المحلل) && مستمر) {
                    دع فاصل: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
                    إذا ((فاصل == 0x20) || (فاصل == 0x09) || (فاصل == 0x0A) || (فاصل == 0x0D)) {
                        إذا ((فاصل == 0x0A) || (فاصل == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); }
                        وإلا { تقدم_تومل(المحلل); };
                    } وإلا { مستمر := خطأ; };
                }
            } وإلا {
                تقدم_تومل(المحلل);
                إذا (هـ == 0x22) { ألحق(الناتج, 0x22); }
                وإلا إذا (هـ == 0x5C) { ألحق(الناتج, 0x5C); }
                وإلا إذا (هـ == 0x62) { ألحق(الناتج, 0x08); }
                وإلا إذا (هـ == 0x74) { ألحق(الناتج, 0x09); }
                وإلا إذا (هـ == 0x6E) { ألحق(الناتج, 0x0A); }
                وإلا إذا (هـ == 0x66) { ألحق(الناتج, 0x0C); }
                وإلا إذا (هـ == 0x72) { ألحق(الناتج, 0x0D); }
                وإلا إذا ((هـ == 0x75) || (هـ == 0x55)) {
                    دع أرقام: متغير طبيعي = 4;
                    إذا (هـ == 0x55) { أرقام := 8; };
                    طابق اقرأ_يونيكود_تومل(المحلل, أرقام) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(السلم) -> {
                        إذا (!ألحق_سلم_تومل(&متغير الناتج, السلم)) {
                            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.يونيكود_غير_صالح(), الموضع));
                        };
                    };
                } وإلا {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.هروب_غير_صالح(), الموضع));
                };
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف حلل_سلسلة_حرفية_تومل(
    المحلل: &متغير محلل_تومل,
    متعددة: منطقي
): نتيجة نص, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا (متعددة) {
        إذا (!يطابق_تومل_عند(المحلل, البداية, «'''»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        (*المحلل).الموضع := البداية + 3;
        إذا (!في_نهاية_تومل(المحلل)) {
            دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            إذا ((ب == 0x0A) || (ب == 0x0D)) { تجاوز_نهاية_سطر_تومل(المحلل); };
        };
    } وإلا {
        إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x27)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
        };
        تقدم_تومل(المحلل);
    };
    دع الناتج: متغير متجه ط8 = [];
    طالما (!في_نهاية_تومل(المحلل)) {
        دع الموضع: طبيعي = (*المحلل).الموضع;
        إذا (متعددة && يطابق_تومل_عند(المحلل, الموضع, «'''»)) {
            دع عدد_الاقتباسات: متغير طبيعي = 3;
            طالما (((الموضع + عدد_الاقتباسات) < (الطول((*المحلل).النص) مثل طبيعي))
                && (بايت_تومل_عند(المحلل, الموضع + عدد_الاقتباسات) == 0x27)) {
                عدد_الاقتباسات := عدد_الاقتباسات + 1;
            }
            إذا (عدد_الاقتباسات > 5) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
            };
            دع داخلية: متغير طبيعي = عدد_الاقتباسات - 3;
            طالما (داخلية > 0) { ألحق(الناتج, 0x27); داخلية := داخلية - 1; }
            (*المحلل).الموضع := الموضع + عدد_الاقتباسات;
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        دع ب: ط8 = بايت_تومل_عند(المحلل, الموضع);
        إذا (!متعددة && (ب == 0x27)) {
            تقدم_تومل(المحلل);
            أرجع نتيجة.نجح(من_بايتات(&الناتج));
        };
        إذا (!متعددة && ((ب == 0x0A) || (ب == 0x0D))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        إذا (((ب < 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)) || (ب == 0x7F)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), الموضع));
        };
        ألحق(الناتج, ب);
        تقدم_تومل(المحلل);
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف بايت_مفتاح_عار_تومل(ب: ط8): منطقي {
    أرجع ((ب >= 0x41) && (ب <= 0x5A))
        || ((ب >= 0x61) && (ب <= 0x7A))
        || ((ب >= 0x30) && (ب <= 0x39))
        || (ب == 0x5F)
        || (ب == 0x2D);
}

عرف حلل_مفتاح_واحد_تومل(المحلل: &متغير محلل_تومل): نتيجة نص, خطأ_تومل {
    إذا (في_نهاية_تومل(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
    };
    دع ب: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
    إذا (ب == 0x22) { أرجع حلل_سلسلة_أساسية_تومل(المحلل, خطأ); };
    إذا (ب == 0x27) { أرجع حلل_سلسلة_حرفية_تومل(المحلل, خطأ); };
    دع الناتج: متغير متجه ط8 = [];
    طالما (!في_نهاية_تومل(المحلل) && بايت_مفتاح_عار_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
        ألحق(الناتج, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
        تقدم_تومل(المحلل);
    }
    إذا ((الطول(الناتج) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
    };
    أرجع نتيجة.نجح(من_بايتات(&الناتج));
}

عرف حلل_مسار_مفتاح_تومل(المحلل: &متغير محلل_تومل): نتيجة متجه نص, خطأ_تومل {
    دع الأجزاء: متغير متجه نص = [];
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        تجاوز_مسافة_تومل(المحلل);
        طابق حلل_مفتاح_واحد_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجزء) -> { ألحق(الأجزاء, الجزء); };
        تجاوز_مسافة_تومل(المحلل);
        إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x2E)) {
            تقدم_تومل(المحلل);
        } وإلا {
            مستمر := خطأ;
        };
    }
    إذا ((الطول(الأجزاء) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
    };
    أرجع نتيجة.نجح(الأجزاء);
}

عرف آخر_جدول_في_مصفوفة_تومل(
    المحلل: &محلل_تومل,
    فهرس_المصفوفة: طبيعي
): اختياري طبيعي {
    إذا (فهرس_المصفوفة >= (الطول((*المحلل).المصفوفات) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع مرجع_القيم: &متجه قيمة_تومل = &(*المحلل).المصفوفات[فهرس_المصفوفة].القيم;
    دع القيم: متجه قيمة_تومل = *مرجع_القيم;
    إذا ((الطول(القيم) مثل طبيعي) == 0) { أرجع اختياري.لا_شيء(); };
    دع الأخير: طبيعي = (الطول(القيم) مثل طبيعي) - 1;
    طابق القيم[الأخير] مع
    | قيمة_تومل.جدول(الجدول) -> { أرجع اختياري.موجود(الجدول); }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف حل_جدول_مسار_تومل(
    المحلل: &متغير محلل_تومل,
    البداية: طبيعي,
    الأجزاء: &متجه نص,
    العدد: طبيعي,
    أنشئ: منطقي,
    مغلق: منطقي
): نتيجة طبيعي, خطأ_تومل {
    دع الحالي: متغير طبيعي = البداية;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع مرجع_المفتاح: &نص = &(*الأجزاء)[ف];
        دع المفتاح: نص = انسخ_نص(مرجع_المفتاح);
        طابق قيمة_مدخل_تومل_داخلية(المحلل, الحالي, &المفتاح) مع
        | اختياري.لا_شيء -> {
            إذا (!أنشئ) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_غير_صالح(), (*المحلل).الموضع));
            };
            إذا ((*المحلل).الجداول[الحالي].مغلق) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.جدول_ضمني_مغلق(), (*المحلل).الموضع));
            };
            دع الجديد: طبيعي = أضف_جدول_تومل(المحلل, خطأ, مغلق);
            إذا (!أضف_مدخل_تومل(المحلل, الحالي, المفتاح, قيمة_تومل.جدول(الجديد), (*المحلل).الموضع)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
            };
            الحالي := الجديد;
        }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة مع
            | قيمة_تومل.جدول(الجدول) -> { الحالي := الجدول; }
            | قيمة_تومل.مصفوفة(المصفوفة) -> {
                طابق آخر_جدول_في_مصفوفة_تومل(المحلل, المصفوفة) مع
                | اختياري.موجود(الجدول) -> { الحالي := الجدول; }
                | اختياري.لا_شيء -> {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
                };
            }
            | _ -> {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الحالي);
}


عرف حلل_متداخلا_تومل(المحلل: &متغير محلل_تومل, مصفوفة: منطقي): نتيجة قيمة_تومل, خطأ_تومل {
    إذا (مصفوفة) { أرجع حلل_مصفوفة_تومل(المحلل); };
    أرجع حلل_جدول_ضمني_تومل(المحلل);
}

عرف حلل_مصفوفة_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x5B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    تقدم_تومل(المحلل);
    دع الفهرس: طبيعي = أضف_مصفوفة_تومل(المحلل);
    إذا (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
    };
    إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x5D)) {
        تقدم_تومل(المحلل);
        أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
    };
    دع يتوقع_قيمة: متغير منطقي = صواب;
    طالما (!في_نهاية_تومل(المحلل)) {
        إذا (!يتوقع_قيمة) {
            دع فاصل: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
            إذا (فاصل == 0x5D) {
                تقدم_تومل(المحلل);
                أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
            };
            إذا (فاصل != 0x2C) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            تقدم_تومل(المحلل);
            يتوقع_قيمة := صواب;
            إذا (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x5D)) {
                تقدم_تومل(المحلل);
                أرجع نتيجة.نجح(قيمة_تومل.مصفوفة(الفهرس));
            };
        };
        طابق حلل_قيمة_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            إذا (!ألحق_مصفوفة_تومل(المحلل, الفهرس, القيمة)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), (*المحلل).الموضع));
            };
        };
        يتوقع_قيمة := خطأ;
        إذا (!تجاوز_فراغ_وتعليقات_مصفوفة(المحلل)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف حلل_جدول_ضمني_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x7B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    تقدم_تومل(المحلل);
    دع الفهرس: طبيعي = أضف_جدول_تومل(المحلل, صواب, خطأ);
    تجاوز_مسافة_تومل(المحلل);
    إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x7D)) {
        تقدم_تومل(المحلل);
        أغلق_جدول_تومل(المحلل, الفهرس);
        أرجع نتيجة.نجح(قيمة_تومل.جدول(الفهرس));
    };
    طالما (!في_نهاية_تومل(المحلل)) {
        طابق حلل_مسار_مفتاح_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الأجزاء) -> {
            تجاوز_مسافة_تومل(المحلل);
            إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x3D)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
            };
            تقدم_تومل(المحلل);
            تجاوز_مسافة_تومل(المحلل);
            طابق حلل_قيمة_تومل(المحلل) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> {
                دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
                دع المالك: متغير طبيعي = الفهرس;
                إذا (العدد > 1) {
                    طابق حل_جدول_مسار_تومل(المحلل, الفهرس, &الأجزاء, العدد - 1, صواب, صواب) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(الجدول) -> { المالك := الجدول; };
                };
                دع موضع_المفتاح: طبيعي = العدد - 1;
                دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
                دع المفتاح: نص = انسخ_نص(مرجع_المفتاح);
                إذا (!أضف_مدخل_تومل(المحلل, المالك, المفتاح, القيمة, (*المحلل).الموضع)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
                };
            };
        };
        تجاوز_مسافة_تومل(المحلل);
        إذا (في_نهاية_تومل(المحلل)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
        };
        دع فاصل: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
        إذا (فاصل == 0x7D) {
            تقدم_تومل(المحلل);
            أغلق_جدول_تومل(المحلل, الفهرس);
            أرجع نتيجة.نجح(قيمة_تومل.جدول(الفهرس));
        };
        إذا (فاصل != 0x2C) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        تجاوز_مسافة_تومل(المحلل);
    }
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
}

عرف بايت_قيمة_عارية_تومل(ب: ط8): منطقي {
    أرجع (ب != 0x20) && (ب != 0x09) && (ب != 0x0A) && (ب != 0x0D)
        && (ب != 0x23) && (ب != 0x2C) && (ب != 0x5D) && (ب != 0x7D);
}

عرف بايت_رقم_تومل(البايت: ط8, الأساس: طبيعي): منطقي {
    إذا ((البايت >= 0x30) && (البايت <= 0x39)) {
        أرجع (((البايت - 0x30) مثل طبيعي) < الأساس);
    };
    إذا (الأساس == 16) {
        إذا ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع صواب; };
        إذا ((البايت >= 0x61) && (البايت <= 0x66)) { أرجع صواب; };
    };
    أرجع خطأ;
}

عرف قيمة_رقم_تومل(البايت: ط8): طبيعي {
    إذا ((البايت >= 0x30) && (البايت <= 0x39)) { أرجع (البايت - 0x30) مثل طبيعي; };
    إذا ((البايت >= 0x41) && (البايت <= 0x46)) { أرجع ((البايت - 0x41) مثل طبيعي) + 10; };
    أرجع ((البايت - 0x61) مثل طبيعي) + 10;
}

عرف تحقق_تسلسل_أرقام_تومل(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    الأساس: طبيعي
): منطقي {
    إذا (البداية >= النهاية) { أرجع خطأ; };
    دع رأى_رقما: متغير منطقي = خطأ;
    دع السابق_رقم: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (بايت_رقم_تومل(ب, الأساس)) {
            رأى_رقما := صواب;
            السابق_رقم := صواب;
        } وإلا إذا (ب == 0x5F) {
            دع التالي: طبيعي = ف + 1;
            إذا (!السابق_رقم || (التالي >= النهاية)) {
                أرجع خطأ;
            };
            إذا (!بايت_رقم_تومل((*النص)[التالي], الأساس)) {
                أرجع خطأ;
            };
            السابق_رقم := خطأ;
        } وإلا {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع رأى_رقما && السابق_رقم;
}

عرف عدد_أرقام_تومل_دون_فواصل(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): طبيعي {
    دع العدد: متغير طبيعي = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        إذا ((*النص)[ف] != 0x5F) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف تحقق_جزء_عشري_تومل(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    يسمح_بأصفار_بادئة: منطقي
): منطقي {
    إذا (!تحقق_تسلسل_أرقام_تومل(النص, البداية, النهاية, 10)) { أرجع خطأ; };
    إذا (!يسمح_بأصفار_بادئة) {
        دع العدد: طبيعي = عدد_أرقام_تومل_دون_فواصل(النص, البداية, النهاية);
        إذا ((العدد > 1) && ((*النص)[البداية] == 0x30)) { أرجع خطأ; };
    };
    أرجع صواب;
}

عرف صحيح_تومل_ضمن_ص64(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    الأساس: طبيعي,
    سالب: منطقي
): منطقي {
    دع الحد_الموجب: ط64 = (~(0 مثل ط64)) >> 1;
    دع الحد: متغير ط64 = الحد_الموجب;
    إذا (سالب) { الحد := الحد_الموجب + 1; };
    دع القيمة: متغير ط64 = 0;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب != 0x5F) {
            دع الرقم: ط64 = قيمة_رقم_تومل(ب) مثل ط64;
            دع القاعدة: ط64 = الأساس مثل ط64;
            إذا (القيمة > ((الحد - الرقم) / القاعدة)) { أرجع خطأ; };
            القيمة := (القيمة * القاعدة) + الرقم;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

نوع تصنيف_رقم_تومل =
    | غير_صالح
    | صحيح
    | عائم
;

عرف صنف_رقم_تومل(النص: &نص): تصنيف_رقم_تومل {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (العدد == 0) { أرجع تصنيف_رقم_تومل.غير_صالح(); };

    دع البداية: متغير طبيعي = 0;
    دع سالب: متغير منطقي = خطأ;
    دع له_إشارة: متغير منطقي = خطأ;
    إذا (((*النص)[0] == 0x2B) || ((*النص)[0] == 0x2D)) {
        له_إشارة := صواب;
        سالب := (*النص)[0] == 0x2D;
        البداية := 1;
        إذا (البداية >= العدد) { أرجع تصنيف_رقم_تومل.غير_صالح(); };
    };

    دع الباقي: متغير متجه ط8 = [];
    دع ر: متغير طبيعي = البداية;
    طالما (ر < العدد) { ألحق(الباقي, (*النص)[ر]); ر := ر + 1; }
    دع نص_الباقي: نص = من_بايتات(&الباقي);
    دع نان: نص = «nan»;
    دع لانهاية: نص = «inf»;
    إذا (نصان_متساويان(&نص_الباقي, &نان) || نصان_متساويان(&نص_الباقي, &لانهاية)) {
        أرجع تصنيف_رقم_تومل.عائم();
    };

    إذا (!له_إشارة && ((البداية + 2) <= العدد) && ((*النص)[البداية] == 0x30)) {
        دع موضع_النوع: طبيعي = البداية + 1;
        دع النوع: ط8 = (*النص)[موضع_النوع];
        دع الأساس: متغير طبيعي = 0;
        إذا (النوع == 0x78) { الأساس := 16; }
        وإلا إذا (النوع == 0x6F) { الأساس := 8; }
        وإلا إذا (النوع == 0x62) { الأساس := 2; };
        إذا (الأساس != 0) {
            دع بداية_الأرقام: طبيعي = البداية + 2;
            إذا (!تحقق_تسلسل_أرقام_تومل(النص, بداية_الأرقام, العدد, الأساس)) {
                أرجع تصنيف_رقم_تومل.غير_صالح();
            };
            إذا (!صحيح_تومل_ضمن_ص64(النص, بداية_الأرقام, العدد, الأساس, خطأ)) {
                أرجع تصنيف_رقم_تومل.غير_صالح();
            };
            أرجع تصنيف_رقم_تومل.صحيح();
        };
    };

    دع نهاية_الصحيح: متغير طبيعي = البداية;
    طالما ((نهاية_الصحيح < العدد) && ((*النص)[نهاية_الصحيح] != 0x2E)
        && ((*النص)[نهاية_الصحيح] != 0x65) && ((*النص)[نهاية_الصحيح] != 0x45)) {
        نهاية_الصحيح := نهاية_الصحيح + 1;
    }
    إذا (!تحقق_جزء_عشري_تومل(النص, البداية, نهاية_الصحيح, خطأ)) {
        أرجع تصنيف_رقم_تومل.غير_صالح();
    };
    إذا (نهاية_الصحيح == العدد) {
        إذا (!صحيح_تومل_ضمن_ص64(النص, البداية, العدد, 10, سالب)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        أرجع تصنيف_رقم_تومل.صحيح();
    };

    دع الموضع: متغير طبيعي = نهاية_الصحيح;
    دع له_كسر: متغير منطقي = خطأ;
    دع له_أس: متغير منطقي = خطأ;
    إذا ((*النص)[الموضع] == 0x2E) {
        له_كسر := صواب;
        الموضع := الموضع + 1;
        دع نهاية_الكسر: متغير طبيعي = الموضع;
        طالما ((نهاية_الكسر < العدد) && ((*النص)[نهاية_الكسر] != 0x65) && ((*النص)[نهاية_الكسر] != 0x45)) {
            نهاية_الكسر := نهاية_الكسر + 1;
        }
        إذا (!تحقق_تسلسل_أرقام_تومل(النص, الموضع, نهاية_الكسر, 10)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        الموضع := نهاية_الكسر;
    };
    إذا ((الموضع < العدد) && (((*النص)[الموضع] == 0x65) || ((*النص)[الموضع] == 0x45))) {
        له_أس := صواب;
        الموضع := الموضع + 1;
        إذا ((الموضع < العدد) && (((*النص)[الموضع] == 0x2B) || ((*النص)[الموضع] == 0x2D))) {
            الموضع := الموضع + 1;
        };
        إذا (!تحقق_تسلسل_أرقام_تومل(النص, الموضع, العدد, 10)) {
            أرجع تصنيف_رقم_تومل.غير_صالح();
        };
        الموضع := العدد;
    };
    إذا ((الموضع != العدد) || (!له_كسر && !له_أس)) {
        أرجع تصنيف_رقم_تومل.غير_صالح();
    };
    أرجع تصنيف_رقم_تومل.عائم();
}

عرف قيمة_أرقام_ثابتة_تومل(
    النص: &نص,
    البداية: طبيعي,
    العدد: طبيعي
): اختياري طبيعي {
    إذا ((البداية + العدد) > (الطول(*النص) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع القيمة: متغير طبيعي = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الموضع: طبيعي = البداية + ف;
        دع ب: ط8 = (*النص)[الموضع];
        إذا ((ب < 0x30) || (ب > 0x39)) { أرجع اختياري.لا_شيء(); };
        القيمة := (القيمة * 10) + ((ب - 0x30) مثل طبيعي);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(القيمة);
}

عرف سنة_كبيسة_تومل(السنة: طبيعي): منطقي {
    إذا ((السنة % 400) == 0) { أرجع صواب; };
    إذا ((السنة % 100) == 0) { أرجع خطأ; };
    أرجع (السنة % 4) == 0;
}

عرف أيام_شهر_تومل(السنة: طبيعي, الشهر: طبيعي): طبيعي {
    إذا ((الشهر == 1) || (الشهر == 3) || (الشهر == 5) || (الشهر == 7)
        || (الشهر == 8) || (الشهر == 10) || (الشهر == 12)) { أرجع 31; };
    إذا ((الشهر == 4) || (الشهر == 6) || (الشهر == 9) || (الشهر == 11)) { أرجع 30; };
    إذا (الشهر == 2) {
        إذا (سنة_كبيسة_تومل(السنة)) { أرجع 29; };
        أرجع 28;
    };
    أرجع 0;
}

عرف تحقق_تاريخ_تومل_عند(النص: &نص, البداية: طبيعي): منطقي {
    إذا ((البداية + 10) > (الطول(*النص) مثل طبيعي)) { أرجع خطأ; };
    دع موضع_فاصل_السنة: طبيعي = البداية + 4;
    دع موضع_فاصل_الشهر: طبيعي = البداية + 7;
    إذا (((*النص)[موضع_فاصل_السنة] != 0x2D) || ((*النص)[موضع_فاصل_الشهر] != 0x2D)) { أرجع خطأ; };
    دع السنة: طبيعي;
    دع الشهر: طبيعي;
    دع اليوم: طبيعي;
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية, 4) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { السنة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 5, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الشهر := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 8, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { اليوم := القيمة; };
    دع الحد: طبيعي = أيام_شهر_تومل(السنة, الشهر);
    أرجع (الحد != 0) && (اليوم >= 1) && (اليوم <= الحد);
}

عرف تحقق_وقت_تومل(
    النص: &نص,
    البداية: طبيعي,
    النهاية: طبيعي,
    يسمح_بمنطقة: منطقي
): منطقي {
    إذا ((البداية + 8) > النهاية) { أرجع خطأ; };
    دع موضع_فاصل_الساعة: طبيعي = البداية + 2;
    دع موضع_فاصل_الدقيقة: طبيعي = البداية + 5;
    إذا (((*النص)[موضع_فاصل_الساعة] != 0x3A) || ((*النص)[موضع_فاصل_الدقيقة] != 0x3A)) { أرجع خطأ; };
    دع الساعة: طبيعي;
    دع الدقيقة: طبيعي;
    دع الثانية: طبيعي;
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الساعة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 3, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الدقيقة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, البداية + 6, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { الثانية := القيمة; };
    إذا ((الساعة > 23) || (الدقيقة > 59) || (الثانية > 60)) { أرجع خطأ; };

    دع الموضع: متغير طبيعي = البداية + 8;
    إذا ((الموضع < النهاية) && ((*النص)[الموضع] == 0x2E)) {
        الموضع := الموضع + 1;
        دع بداية_الكسر: طبيعي = الموضع;
        طالما ((الموضع < النهاية) && ((*النص)[الموضع] >= 0x30) && ((*النص)[الموضع] <= 0x39)) {
            الموضع := الموضع + 1;
        }
        إذا (الموضع == بداية_الكسر) { أرجع خطأ; };
    };
    إذا (الموضع == النهاية) { أرجع صواب; };
    إذا (!يسمح_بمنطقة) { أرجع خطأ; };
    إذا (((*النص)[الموضع] == 0x5A) || ((*النص)[الموضع] == 0x7A)) {
        أرجع (الموضع + 1) == النهاية;
    };
    إذا (((*النص)[الموضع] != 0x2B) && ((*النص)[الموضع] != 0x2D)) { أرجع خطأ; };
    إذا ((الموضع + 6) != النهاية) { أرجع خطأ; };
    دع موضع_فاصل_المنطقة: طبيعي = الموضع + 3;
    إذا ((*النص)[موضع_فاصل_المنطقة] != 0x3A) { أرجع خطأ; };
    دع ساعة_المنطقة: طبيعي;
    دع دقيقة_المنطقة: طبيعي;
    طابق قيمة_أرقام_ثابتة_تومل(النص, الموضع + 1, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { ساعة_المنطقة := القيمة; };
    طابق قيمة_أرقام_ثابتة_تومل(النص, الموضع + 4, 2) مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(القيمة) -> { دقيقة_المنطقة := القيمة; };
    أرجع (ساعة_المنطقة <= 23) && (دقيقة_المنطقة <= 59);
}

عرف قيمة_تاريخ_وقت_صالحة_تومل(النص: &نص): منطقي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا ((العدد >= 10) && تحقق_تاريخ_تومل_عند(النص, 0)) {
        إذا (العدد == 10) { أرجع صواب; };
        دع الفاصل: ط8 = (*النص)[10];
        إذا ((الفاصل != 0x54) && (الفاصل != 0x74) && (الفاصل != 0x20)) { أرجع خطأ; };
        أرجع تحقق_وقت_تومل(النص, 11, العدد, صواب);
    };
    أرجع تحقق_وقت_تومل(النص, 0, العدد, خطأ);
}

عرف حلل_قيمة_عارية_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    دع البايتات: متغير متجه ط8 = [];
    طالما (!في_نهاية_تومل(المحلل) && بايت_قيمة_عارية_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
        ألحق(البايتات, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
        تقدم_تومل(المحلل);
    }
    // RFC3339 date-times may use one space instead of T. Keep that one space
    // inside the scalar only when it separates a date from a time token.
    إذا (!في_نهاية_تومل(المحلل) && (بايت_تومل_عند(المحلل, (*المحلل).الموضع) == 0x20)) {
        دع حفظ: طبيعي = (*المحلل).الموضع;
        دع الحالي: نص = من_بايتات(&البايتات);
        إذا ((الطول(الحالي) مثل طبيعي) == 10 && تحقق_تاريخ_تومل_عند(&الحالي, 0)) {
            (*المحلل).الموضع := حفظ + 1;
            إذا (!في_نهاية_تومل(المحلل)) {
                دع التالي: ط8 = بايت_تومل_عند(المحلل, (*المحلل).الموضع);
                إذا ((التالي >= 0x30) && (التالي <= 0x39)) {
                    ألحق(البايتات, 0x20);
                    طالما (!في_نهاية_تومل(المحلل) && بايت_قيمة_عارية_تومل(بايت_تومل_عند(المحلل, (*المحلل).الموضع))) {
                        ألحق(البايتات, بايت_تومل_عند(المحلل, (*المحلل).الموضع));
                        تقدم_تومل(المحلل);
                    }
                } وإلا {
                    (*المحلل).الموضع := حفظ;
                };
            };
        };
    };
    دع النص: نص = من_بايتات(&البايتات);
    دع صواب_نص: نص = «true»;
    دع خطأ_نص: نص = «false»;
    إذا (نصان_متساويان(&النص, &صواب_نص)) { أرجع نتيجة.نجح(قيمة_تومل.منطق(صواب)); };
    إذا (نصان_متساويان(&النص, &خطأ_نص)) { أرجع نتيجة.نجح(قيمة_تومل.منطق(خطأ)); };
    إذا (قيمة_تاريخ_وقت_صالحة_تومل(&النص)) { أرجع نتيجة.نجح(قيمة_تومل.تاريخ_وقت(النص)); };
    طابق صنف_رقم_تومل(&النص) مع
    | تصنيف_رقم_تومل.صحيح -> { أرجع نتيجة.نجح(قيمة_تومل.عدد(النص)); }
    | تصنيف_رقم_تومل.عائم -> { أرجع نتيجة.نجح(قيمة_تومل.عدد(النص)); }
    | تصنيف_رقم_تومل.غير_صالح -> { };
    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.قيمة_غير_صالحة(), البداية));
}

عرف حلل_قيمة_تومل(المحلل: &متغير محلل_تومل): نتيجة قيمة_تومل, خطأ_تومل {
    تجاوز_مسافة_تومل(المحلل);
    إذا (في_نهاية_تومل(المحلل)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نهاية_غير_متوقعة(), (*المحلل).الموضع));
    };
    دع الموضع: طبيعي = (*المحلل).الموضع;
    دع ب: ط8 = بايت_تومل_عند(المحلل, الموضع);
    إذا (ب == 0x22) {
        إذا (يطابق_تومل_عند(المحلل, الموضع, «"""»)) {
            دع النص: نص = حلل_سلسلة_أساسية_تومل(المحلل, صواب)؟;
            أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص));
        };
        دع النص: نص = حلل_سلسلة_أساسية_تومل(المحلل, خطأ)؟;
        أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص));
    };
    إذا (ب == 0x27) {
        إذا (يطابق_تومل_عند(المحلل, الموضع, «'''»)) {
            دع النص: نص = حلل_سلسلة_حرفية_تومل(المحلل, صواب)؟;
            أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص));
        };
        دع النص: نص = حلل_سلسلة_حرفية_تومل(المحلل, خطأ)؟;
        أرجع نتيجة.نجح(قيمة_تومل.سلسلة(النص));
    };
    إذا (ب == 0x5B || ب == 0x7B) {
        إذا ((*المحلل).العمق >= حد_تعشيش_تومل()) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعشيش_عميق_جدا(), (*المحلل).الموضع));
        };
        (*المحلل).العمق := (*المحلل).العمق + 1;
        دع المتداخل: نتيجة قيمة_تومل, خطأ_تومل = حلل_متداخلا_تومل(المحلل, ب == 0x5B);
        (*المحلل).العمق := (*المحلل).العمق - 1;
        أرجع المتداخل;
    };
    أرجع حلل_قيمة_عارية_تومل(المحلل);
}

عرف حلل_تعيين_تومل(المحلل: &متغير محلل_تومل): نتيجة منطقي, خطأ_تومل {
    طابق حلل_مسار_مفتاح_تومل(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الأجزاء) -> {
        تجاوز_مسافة_تومل(المحلل);
        إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x3D)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        تجاوز_مسافة_تومل(المحلل);
        طابق حلل_قيمة_تومل(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
            دع المالك: متغير طبيعي = (*المحلل).الجدول_الحالي;
            إذا (العدد > 1) {
                طابق حل_جدول_مسار_تومل(
                    المحلل, المالك, &الأجزاء, العدد - 1, صواب, صواب
                ) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الجدول) -> { المالك := الجدول; };
            };
            دع موضع_المفتاح: طبيعي = العدد - 1;
            دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
            دع المفتاح: نص = انسخ_نص(مرجع_المفتاح);
            إذا (!أضف_مدخل_تومل(المحلل, المالك, المفتاح, القيمة, (*المحلل).الموضع)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), (*المحلل).الموضع));
            };
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عرف حلل_رأس_جدول_تومل(المحلل: &متغير محلل_تومل): نتيجة منطقي, خطأ_تومل {
    دع البداية: طبيعي = (*المحلل).الموضع;
    إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, البداية) != 0x5B)) {
        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), البداية));
    };
    دع مصفوفة_جداول: منطقي = يطابق_تومل_عند(المحلل, البداية, «[[»);
    إذا (مصفوفة_جداول) { (*المحلل).الموضع := البداية + 2; }
    وإلا { (*المحلل).الموضع := البداية + 1; };
    تجاوز_مسافة_تومل(المحلل);
    دع الأجزاء: متجه نص;
    طابق حلل_مسار_مفتاح_تومل(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { الأجزاء := القيمة; };
    تجاوز_مسافة_تومل(المحلل);
    إذا (مصفوفة_جداول) {
        إذا (!يطابق_تومل_عند(المحلل, (*المحلل).الموضع, «]]»)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        (*المحلل).الموضع := (*المحلل).الموضع + 2;
        دع العدد: طبيعي = الطول(الأجزاء) مثل طبيعي;
        دع الأب: متغير طبيعي = (*المحلل).الجذر;
        إذا (العدد > 1) {
            طابق حل_جدول_مسار_تومل(المحلل, الأب, &الأجزاء, العدد - 1, صواب, خطأ) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الجدول) -> { الأب := الجدول; };
        };
        دع موضع_المفتاح: طبيعي = العدد - 1;
        دع مرجع_المفتاح: &نص = &الأجزاء[موضع_المفتاح];
        دع المفتاح: نص = انسخ_نص(مرجع_المفتاح);
        دع فهرس_المصفوفة: متغير طبيعي = 0;
        طابق قيمة_مدخل_تومل_داخلية(المحلل, الأب, &المفتاح) مع
        | اختياري.لا_شيء -> {
            فهرس_المصفوفة := أضف_مصفوفة_تومل(المحلل);
            إذا (!أضف_مدخل_تومل(المحلل, الأب, المفتاح, قيمة_تومل.مصفوفة(فهرس_المصفوفة), البداية)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.مفتاح_مكرر(), البداية));
            };
        }
        | اختياري.موجود(القيمة) -> {
            طابق القيمة مع
            | قيمة_تومل.مصفوفة(الفهرس) -> { فهرس_المصفوفة := الفهرس; }
            | _ -> { أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), البداية)); };
        };
        دع الجدول: طبيعي = أضف_جدول_تومل(المحلل, صواب, خطأ);
        إذا (!ألحق_مصفوفة_تومل(المحلل, فهرس_المصفوفة, قيمة_تومل.جدول(الجدول))) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.تعارض_نوع(), البداية));
        };
        (*المحلل).الجدول_الحالي := الجدول;
    } وإلا {
        إذا (في_نهاية_تومل(المحلل) || (بايت_تومل_عند(المحلل, (*المحلل).الموضع) != 0x5D)) {
            أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), (*المحلل).الموضع));
        };
        تقدم_تومل(المحلل);
        طابق حل_جدول_مسار_تومل(
            المحلل, (*المحلل).الجذر, &الأجزاء, الطول(الأجزاء) مثل طبيعي, صواب, خطأ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجدول) -> {
            إذا (!اضبط_جدول_معلنا(المحلل, الجدول)) {
                أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.جدول_مكرر(), البداية));
            };
            (*المحلل).الجدول_الحالي := الجدول;
        };
    };
    أرجع نتيجة.نجح(صواب);
}

عام عرف حلل_تومل(النص: &نص): نتيجة وثيقة_تومل, خطأ_تومل {
    دع الجداول: متجه جدول_تومل = [];
    دع المصفوفات: متجه مصفوفة_تومل = [];
    دع المحلل: متغير محلل_تومل = {
        النص: انسخ_نص(النص),
        الموضع: 0,
        الجدول_الحالي: 0,
        الجذر: 0,
        الجداول: الجداول,
        المصفوفات: المصفوفات,
        العمق: 0
    };
    دع الجذر: طبيعي = أضف_جدول_تومل(&متغير المحلل, صواب, خطأ);
    المحلل.الجذر := الجذر;
    المحلل.الجدول_الحالي := الجذر;

    طالما (!في_نهاية_تومل(&المحلل)) {
        تجاوز_مسافة_تومل(&متغير المحلل);
        إذا (في_نهاية_تومل(&المحلل)) { } وإلا {
            دع ب: ط8 = بايت_تومل_عند(&المحلل, المحلل.الموضع);
            إذا (ب == 0x23) {
                تجاوز_تعليق_تومل(&متغير المحلل);
            } وإلا إذا ((ب == 0x0A) || (ب == 0x0D)) {
                إذا (!تجاوز_نهاية_سطر_تومل(&متغير المحلل)) {
                    أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), المحلل.الموضع));
                };
            } وإلا {
                إذا (ب == 0x5B) {
                    طابق حلل_رأس_جدول_تومل(&متغير المحلل) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                } وإلا {
                    طابق حلل_تعيين_تومل(&متغير المحلل) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(_) -> { };
                };
                تجاوز_مسافة_تومل(&متغير المحلل);
                تجاوز_تعليق_تومل(&متغير المحلل);
                إذا (!في_نهاية_تومل(&المحلل)) {
                    دع نهاية: ط8 = بايت_تومل_عند(&المحلل, المحلل.الموضع);
                    إذا ((نهاية != 0x0A) && (نهاية != 0x0D)) {
                        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.نص_لاحق(), المحلل.الموضع));
                    };
                    إذا (!تجاوز_نهاية_سطر_تومل(&متغير المحلل)) {
                        أرجع نتيجة.خطأ(خطأ_تومل_عند(صنف_خطأ_تومل.رمز_غير_متوقع(), المحلل.الموضع));
                    };
                };
            };
        };
    }

    دع الجذر_النهائي: طبيعي = المحلل.الجذر;
    دع الجداول_النهائية: متغير متجه جدول_تومل = [];
    دع المصفوفات_النهائية: متغير متجه مصفوفة_تومل = [];
    بدّل(المحلل.الجداول, الجداول_النهائية);
    بدّل(المحلل.المصفوفات, المصفوفات_النهائية);
    دع الوثيقة: وثيقة_تومل = {
        الجذر: الجذر_النهائي,
        الجداول: الجداول_النهائية,
        المصفوفات: المصفوفات_النهائية
    };
    أرجع نتيجة.نجح(الوثيقة);
}

عام عرف قيمة_مفتاح_تومل(
    الوثيقة: &وثيقة_تومل,
    فهرس_الجدول: طبيعي,
    المفتاح: &نص
): اختياري قيمة_تومل {
    إذا (فهرس_الجدول >= (الطول((*الوثيقة).الجداول) مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    دع الجدول: &جدول_تومل = &(*الوثيقة).الجداول[فهرس_الجدول];
    طابق موضع_مدخل_تومل(الجدول, المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(الموضع) -> {
        أرجع اختياري.موجود(انسخ_قيمة_تومل(&(*الجدول).المداخل[الموضع].القيمة));
    };
}

عام عرف جدول_مفتاح_تومل(
    الوثيقة: &وثيقة_تومل,
    فهرس_الجدول: طبيعي,
    المفتاح: &نص
): اختياري طبيعي {
    طابق قيمة_مفتاح_تومل(الوثيقة, فهرس_الجدول, المفتاح) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> {
        طابق القيمة مع
        | قيمة_تومل.جدول(الجدول) -> { أرجع اختياري.موجود(الجدول); }
        | _ -> { أرجع اختياري.لا_شيء(); };
    };
}

عام عرف مداخل_جدول_تومل(الوثيقة: &وثيقة_تومل, الفهرس: طبيعي): متجه مدخل_جدول_تومل {
    إذا (الفهرس >= (الطول((*الوثيقة).الجداول) مثل طبيعي)) {
        دع فارغة: متجه مدخل_جدول_تومل = [];
        أرجع فارغة;
    };
    أرجع انسخ_مداخل_جدول_تومل(&(*الوثيقة).الجداول[الفهرس].المداخل);
}

عام عرف قيم_مصفوفة_تومل(الوثيقة: &وثيقة_تومل, الفهرس: طبيعي): متجه قيمة_تومل {
    إذا (الفهرس >= (الطول((*الوثيقة).المصفوفات) مثل طبيعي)) {
        دع فارغة: متجه قيمة_تومل = [];
        أرجع فارغة;
    };
    أرجع انسخ_قيم_تومل(&(*الوثيقة).المصفوفات[الفهرس].القيم);
}

// English spellings reference the canonical Arabic TOML declarations.
عام مرادف parse_toml = حلل_تومل;
عام مرادف toml_value_at = قيمة_مفتاح_تومل;
عام مرادف toml_table_at = جدول_مفتاح_تومل;
عام مرادف toml_document = وثيقة_تومل;
عام مرادف toml_value = قيمة_تومل;
عام مرادف toml_error = خطأ_تومل;
عام مرادف toml_table_entries = مداخل_جدول_تومل;
عام مرادف toml_array_values = قيم_مصفوفة_تومل;
