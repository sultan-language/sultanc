// Unicode White_Space property used by general text trimming.
عام عرف فراغ_يونيكود(القيمة: غ32): منطقي {
    لو ((القيمة >= 0x09) && (القيمة <= 0x0D)) { أرجع صواب; };
    لو ((القيمة == 0x20) || (القيمة == 0x85) || (القيمة == 0xA0)) { أرجع صواب; };
    لو (القيمة == 0x1680) { أرجع صواب; };
    لو ((القيمة >= 0x2000) && (القيمة <= 0x200A)) { أرجع صواب; };
    لو ((القيمة == 0x2028) || (القيمة == 0x2029) || (القيمة == 0x202F)) { أرجع صواب; };
    لو ((القيمة == 0x205F) || (القيمة == 0x3000)) { أرجع صواب; };
    أرجع خطأ;
}

عام مرادف is_unicode_whitespace = فراغ_يونيكود;
