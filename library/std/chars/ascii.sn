// خصائص ASCII العامة على مستوى البايت.
عام عرف رقم_عشري(البايت: غ8): منطقي {
    أرجع (البايت >= 0x30) && (البايت <= 0x39);
}

عام عرف رقم_سداسي(البايت: غ8): منطقي {
    أرجع رقم_عشري(البايت)
        || ((البايت >= 0x41) && (البايت <= 0x46))
        || ((البايت >= 0x61) && (البايت <= 0x66));
}

عام عرف قيمة_سداسية(البايت: غ8): عدد {
    لو ((البايت >= 0x30) && (البايت <= 0x39)) {
        أرجع (البايت - 0x30) مثل عدد;
    };
    لو ((البايت >= 0x41) && (البايت <= 0x46)) {
        أرجع ((البايت - 0x41) + 10) مثل عدد;
    };
    لو ((البايت >= 0x61) && (البايت <= 0x66)) {
        أرجع ((البايت - 0x61) + 10) مثل عدد;
    };
    أرجع -1;
}

عام عرف حرف_لاتيني(البايت: غ8): منطقي {
    أرجع ((البايت >= 0x41) && (البايت <= 0x5A))
        || ((البايت >= 0x61) && (البايت <= 0x7A));
}

عام عرف فاصل_أسكي(البايت: غ8): منطقي {
    أرجع (البايت == 0x20)
        || (البايت == 0x09)
        || (البايت == 0x0D)
        || (البايت == 0x0A);
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف is_decimal_digit = رقم_عشري;
عام مرادف is_hex_digit = رقم_سداسي;
عام مرادف hex_digit_value = قيمة_سداسية;
عام مرادف is_latin_letter = حرف_لاتيني;
عام مرادف is_ascii_separator = فاصل_أسكي;

عام عرف محرف_أسكي(البايت: غ8): منطقي {
    أرجع البايت <= 0x7F;
}

عام عرف حرف_لاتيني_صغير(البايت: غ8): منطقي {
    أرجع (البايت >= 0x61) && (البايت <= 0x7A);
}

عام عرف حرف_لاتيني_كبير(البايت: غ8): منطقي {
    أرجع (البايت >= 0x41) && (البايت <= 0x5A);
}

عام عرف حرف_أو_رقم_أسكي(البايت: غ8): منطقي {
    أرجع حرف_لاتيني(البايت) || رقم_عشري(البايت);
}

عام عرف فراغ_أسكي(البايت: غ8): منطقي {
    أرجع (البايت == 0x20) || ((البايت >= 0x09) && (البايت <= 0x0D));
}

عام عرف تحكم_أسكي(البايت: غ8): منطقي {
    أرجع (البايت <= 0x1F) || (البايت == 0x7F);
}

عام عرف قابل_للطباعة_أسكي(البايت: غ8): منطقي {
    أرجع (البايت >= 0x20) && (البايت <= 0x7E);
}

عام عرف إلى_صغير_أسكي(البايت: غ8): غ8 {
    لو (حرف_لاتيني_كبير(البايت)) { أرجع (البايت + 0x20) مثل غ8; };
    أرجع البايت;
}

عام عرف إلى_كبير_أسكي(البايت: غ8): غ8 {
    لو (حرف_لاتيني_صغير(البايت)) { أرجع (البايت - 0x20) مثل غ8; };
    أرجع البايت;
}

// قيمة رقم ASCII لقواعد 2..36؛ -1 لغير الرقم/الحرف اللاتيني.
عام عرف قيمة_رقم_أسكي(البايت: غ8): عدد {
    لو (رقم_عشري(البايت)) { أرجع (البايت - 0x30) مثل عدد; };
    لو (حرف_لاتيني_كبير(البايت)) { أرجع ((البايت - 0x41) + 10) مثل عدد; };
    لو (حرف_لاتيني_صغير(البايت)) { أرجع ((البايت - 0x61) + 10) مثل عدد; };
    أرجع -1;
}

عام مرادف is_ascii = محرف_أسكي;
عام مرادف is_ascii_lowercase = حرف_لاتيني_صغير;
عام مرادف is_ascii_uppercase = حرف_لاتيني_كبير;
عام مرادف is_ascii_alphanumeric = حرف_أو_رقم_أسكي;
عام مرادف is_ascii_whitespace = فراغ_أسكي;
عام مرادف is_ascii_control = تحكم_أسكي;
عام مرادف is_ascii_printable = قابل_للطباعة_أسكي;
عام مرادف to_ascii_lowercase = إلى_صغير_أسكي;
عام مرادف to_ascii_uppercase = إلى_كبير_أسكي;
عام مرادف ascii_digit_value = قيمة_رقم_أسكي;
