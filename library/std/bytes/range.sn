// التحقق العام من حدود نطاق داخل متجه بايتات.
عام عرف متاح_في_البايتات(
    القيمة: &متجه ط8,
    الموضع: طبيعي,
    العدد: طبيعي
): منطقي {
    دع الطول_الكلي: طبيعي = الطول(*القيمة) مثل طبيعي;

    لو (الموضع > الطول_الكلي) {
        أرجع خطأ;
    };

    أرجع العدد <= (الطول_الكلي - الموضع);
}

// ينسخ نطاق بايتات صالحا إلى متجه مستقل؛ النطاق غير الصالح لا يُقص أو يُمدد ضمنيا.
عام عرف انسخ_نطاق_بايتات(
    القيمة: &متجه ط8,
    الموضع: طبيعي,
    العدد: طبيعي
): اختياري متجه ط8 {
    لو (!متاح_في_البايتات(القيمة, الموضع, العدد)) {
        أرجع اختياري.لا_شيء();
    };

    دع الناتج: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < العدد) {
        دع موضع_الحالي: طبيعي = الموضع + الفهرس;
        ألحق(الناتج, (*القيمة)[موضع_الحالي]);
        الفهرس := الفهرس + 1;
    }

    أرجع اختياري.موجود(الناتج);
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف byte_range_available = متاح_في_البايتات;
عام مرادف copy_byte_range = انسخ_نطاق_بايتات;
