// مساواة عامة لمتجهي بايتات دون أي سياسة هوية أو ترميز أعلى.
عام عرف متجها_بايتات_متساويان(
    الأول: &متجه ط8,
    الثاني: &متجه ط8
): منطقي {
    دع عدد_أ: طبيعي = الطول(*الأول) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*الثاني) مثل طبيعي;

    إذا (عدد_أ != عدد_ب) {
        أرجع خطأ;
    };

    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < عدد_أ) {
        إذا ((*الأول)[الفهرس] != (*الثاني)[الفهرس]) {
            أرجع خطأ;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

// مقارنة معجمية عامة بالبايتات: -1 إن كان الأول أصغر، 0 إن تساويا، 1 إن كان أكبر.
عام عرف قارن_متجهي_بايتات_معجميا(
    الأول: &متجه ط8,
    الثاني: &متجه ط8
): عدد {
    دع عدد_أ: طبيعي = الطول(*الأول) مثل طبيعي;
    دع عدد_ب: طبيعي = الطول(*الثاني) مثل طبيعي;
    دع الحد: متغير طبيعي = عدد_أ;

    إذا (عدد_ب < الحد) {
        الحد := عدد_ب;
    };

    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < الحد) {
        إذا ((*الأول)[الفهرس] < (*الثاني)[الفهرس]) {
            أرجع -1;
        };
        إذا ((*الأول)[الفهرس] > (*الثاني)[الفهرس]) {
            أرجع 1;
        };
        الفهرس := الفهرس + 1;
    }

    إذا (عدد_أ < عدد_ب) {
        أرجع -1;
    };
    إذا (عدد_أ > عدد_ب) {
        أرجع 1;
    };
    أرجع 0;
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف byte_vectors_equal = متجها_بايتات_متساويان;
عام مرادف compare_byte_vectors_lexicographically = قارن_متجهي_بايتات_معجميا;

عام عرف تبدأ_البايتات_بـ(القيمة: &متجه ط8, المطلوب: &متجه ط8): منطقي {
    دع عدد_المصدر: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_النمط: طبيعي = الطول(*المطلوب) مثل طبيعي;
    إذا (عدد_النمط > عدد_المصدر) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_النمط) {
        إذا ((*القيمة)[ف] != (*المطلوب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف تنتهي_البايتات_بـ(القيمة: &متجه ط8, المطلوب: &متجه ط8): منطقي {
    دع عدد_المصدر: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_النمط: طبيعي = الطول(*المطلوب) مثل طبيعي;
    إذا (عدد_النمط > عدد_المصدر) { أرجع خطأ; };
    دع البداية: طبيعي = عدد_المصدر - عدد_النمط;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_النمط) {
        دع موضع: طبيعي = البداية + ف;
        إذا ((*القيمة)[موضع] != (*المطلوب)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ابحث_بايتات_من(القيمة: &متجه ط8, المطلوب: &متجه ط8, البداية: طبيعي): اختياري طبيعي {
    دع عدد_المصدر: طبيعي = الطول(*القيمة) مثل طبيعي;
    دع عدد_النمط: طبيعي = الطول(*المطلوب) مثل طبيعي;
    إذا (البداية > عدد_المصدر) { أرجع اختياري.لا_شيء(); };
    إذا (عدد_النمط == 0) { أرجع اختياري.موجود(البداية); };
    إذا (عدد_النمط > (عدد_المصدر - البداية)) { أرجع اختياري.لا_شيء(); };
    دع الحد: طبيعي = عدد_المصدر - عدد_النمط;
    دع ف: متغير طبيعي = البداية;
    طالما (ف <= الحد) {
        دع ع: متغير طبيعي = 0;
        دع يطابق: متغير منطقي = صواب;
        طالما (يطابق && (ع < عدد_النمط)) {
            دع موضع: طبيعي = ف + ع;
            إذا ((*القيمة)[موضع] != (*المطلوب)[ع]) { يطابق := خطأ; };
            ع := ع + 1;
        }
        إذا (يطابق) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف ابحث_بايتات(القيمة: &متجه ط8, المطلوب: &متجه ط8): اختياري طبيعي {
    أرجع ابحث_بايتات_من(القيمة, المطلوب, 0);
}

عام عرف تحتوي_البايتات(القيمة: &متجه ط8, المطلوب: &متجه ط8): منطقي {
    طابق ابحث_بايتات(القيمة, المطلوب) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام مرادف bytes_starts_with = تبدأ_البايتات_بـ;
عام مرادف bytes_ends_with = تنتهي_البايتات_بـ;
عام مرادف bytes_find_from = ابحث_بايتات_من;
عام مرادف bytes_find = ابحث_بايتات;
عام مرادف bytes_contains = تحتوي_البايتات;
