// مساواة عامة لمتجهي بايتات دون أي سياسة هوية أو ترميز أعلى.
عام عرف متجها_بايتات_متساويان(
    الأول: &متجه غ8,
    الثاني: &متجه غ8
): منطقي {
    دع أ: متجه غ8 = *الأول;
    دع ب: متجه غ8 = *الثاني;
    دع عدد_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(ب) مثل غير_موقع;

    لو (عدد_أ != عدد_ب) {
        أرجع خطأ;
    };

    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < عدد_أ) {
        لو (أ[الفهرس] != ب[الفهرس]) {
            أرجع خطأ;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع صواب;
}

// مقارنة معجمية عامة بالبايتات: -1 إن كان الأول أصغر، 0 إن تساويا، 1 إن كان أكبر.
عام عرف قارن_متجهي_بايتات_معجميا(
    الأول: &متجه غ8,
    الثاني: &متجه غ8
): عدد {
    دع أ: متجه غ8 = *الأول;
    دع ب: متجه غ8 = *الثاني;
    دع عدد_أ: غير_موقع = الطول(أ) مثل غير_موقع;
    دع عدد_ب: غير_موقع = الطول(ب) مثل غير_موقع;
    دع الحد: متغير غير_موقع = عدد_أ;

    لو (عدد_ب < الحد) {
        الحد := عدد_ب;
    };

    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < الحد) {
        لو (أ[الفهرس] < ب[الفهرس]) {
            أرجع -1;
        };
        لو (أ[الفهرس] > ب[الفهرس]) {
            أرجع 1;
        };
        الفهرس := الفهرس + 1;
    }

    لو (عدد_أ < عدد_ب) {
        أرجع -1;
    };
    لو (عدد_أ > عدد_ب) {
        أرجع 1;
    };
    أرجع 0;
}
// الأسماء العامة الإنجليزية ترتبط بالتصريحات العربية نفسها.
عام مرادف byte_vectors_equal = متجها_بايتات_متساويان;
عام مرادف compare_byte_vectors_lexicographically = قارن_متجهي_بايتات_معجميا;

عام عرف تبدأ_البايتات_بـ(القيمة: &متجه غ8, المطلوب: &متجه غ8): منطقي {
    دع المصدر: متجه غ8 = *القيمة;
    دع النمط: متجه غ8 = *المطلوب;
    دع عدد_المصدر: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع عدد_النمط: غير_موقع = الطول(النمط) مثل غير_موقع;
    لو (عدد_النمط > عدد_المصدر) { أرجع خطأ; };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_النمط) {
        لو (المصدر[ف] != النمط[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف تنتهي_البايتات_بـ(القيمة: &متجه غ8, المطلوب: &متجه غ8): منطقي {
    دع المصدر: متجه غ8 = *القيمة;
    دع النمط: متجه غ8 = *المطلوب;
    دع عدد_المصدر: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع عدد_النمط: غير_موقع = الطول(النمط) مثل غير_موقع;
    لو (عدد_النمط > عدد_المصدر) { أرجع خطأ; };
    دع البداية: غير_موقع = عدد_المصدر - عدد_النمط;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < عدد_النمط) {
        دع موضع: غير_موقع = البداية + ف;
        لو (المصدر[موضع] != النمط[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ابحث_بايتات_من(القيمة: &متجه غ8, المطلوب: &متجه غ8, البداية: غير_موقع): اختيار غير_موقع {
    دع المصدر: متجه غ8 = *القيمة;
    دع النمط: متجه غ8 = *المطلوب;
    دع عدد_المصدر: غير_موقع = الطول(المصدر) مثل غير_موقع;
    دع عدد_النمط: غير_موقع = الطول(النمط) مثل غير_موقع;
    لو (البداية > عدد_المصدر) { أرجع اختيار.لا_شيء(); };
    لو (عدد_النمط == 0) { أرجع اختيار.بعض(البداية); };
    لو (عدد_النمط > (عدد_المصدر - البداية)) { أرجع اختيار.لا_شيء(); };
    دع الحد: غير_موقع = عدد_المصدر - عدد_النمط;
    دع ف: متغير غير_موقع = البداية;
    بينما (ف <= الحد) {
        دع ع: متغير غير_موقع = 0;
        دع يطابق: متغير منطقي = صواب;
        بينما (يطابق && (ع < عدد_النمط)) {
            دع موضع: غير_موقع = ف + ع;
            لو (المصدر[موضع] != النمط[ع]) { يطابق := خطأ; };
            ع := ع + 1;
        }
        لو (يطابق) { أرجع اختيار.بعض(ف); };
        ف := ف + 1;
    }
    أرجع اختيار.لا_شيء();
}

عام عرف ابحث_بايتات(القيمة: &متجه غ8, المطلوب: &متجه غ8): اختيار غير_موقع {
    أرجع ابحث_بايتات_من(القيمة, المطلوب, 0);
}

عام عرف تحتوي_البايتات(القيمة: &متجه غ8, المطلوب: &متجه غ8): منطقي {
    طابق ابحث_بايتات(القيمة, المطلوب) مع
    | اختيار.بعض(_) -> { أرجع صواب; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام مرادف bytes_starts_with = تبدأ_البايتات_بـ;
عام مرادف bytes_ends_with = تنتهي_البايتات_بـ;
عام مرادف bytes_find_from = ابحث_بايتات_من;
عام مرادف bytes_find = ابحث_بايتات;
عام مرادف bytes_contains = تحتوي_البايتات;
