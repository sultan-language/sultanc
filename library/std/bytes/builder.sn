// Reusable byte builder. The backing vector length is storage capacity while
// `العدد` is the logical byte length, allowing clear/reuse without reallocating.
عام نوع باني_بايتات = {
    المخزن: متجه ط8,
    العدد: طبيعي
};

عرف سعة_نمو_باني_البايتات(الحالية: طبيعي, المطلوبة: طبيعي): طبيعي {
    دع السعة: متغير طبيعي = الحالية;
    إذا (السعة < 8) { السعة := 8; };
    دع الأعلى: طبيعي = ~((0 مثل طبيعي));
    طالما (السعة < المطلوبة) {
        إذا (السعة > (الأعلى / 2)) { أرجع المطلوبة; };
        السعة := السعة * 2;
    }
    أرجع السعة;
}

عرف ابن_مخزن_بايتات(السعة: طبيعي): متجه ط8 {
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < السعة) {
        ألحق(المخزن, 0);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عام عرف أنشئ_باني_بايتات_بسعة(السعة: طبيعي): باني_بايتات {
    دع المخزن: متجه ط8 = ابن_مخزن_بايتات(السعة);
    دع الناتج: باني_بايتات = { المخزن: المخزن, العدد: 0 };
    أرجع الناتج;
}

عام عرف أنشئ_باني_بايتات(): باني_بايتات {
    أرجع أنشئ_باني_بايتات_بسعة(0);
}

// False means unsigned capacity overflow. No storage or logical length is
// changed on that failure; allocation failure remains the vector's concern.
عام عرف احجز_لباني_البايتات(الباني: &متغير باني_بايتات, إضافي: طبيعي): منطقي {
    دع الأعلى: طبيعي = ~((0 مثل طبيعي));
    إذا (إضافي > (الأعلى - (*الباني).العدد)) { أرجع خطأ; };
    دع المطلوبة: طبيعي = (*الباني).العدد + إضافي;
    دع الحالية: طبيعي = الطول((*الباني).المخزن) مثل طبيعي;
    إذا (المطلوبة <= الحالية) { أرجع صواب; };

    دع الجديدة: طبيعي = سعة_نمو_باني_البايتات(الحالية, المطلوبة);
    دع ف: متغير طبيعي = الحالية;
    طالما (ف < الجديدة) {
        ألحق((*الباني).المخزن, 0);
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ألحق_بايتا_بباني_البايتات(الباني: &متغير باني_بايتات, البايت: ط8): منطقي {
    إذا (!احجز_لباني_البايتات(الباني, 1)) { أرجع خطأ; };
    دع الموضع: طبيعي = (*الباني).العدد;
    (*الباني).المخزن[الموضع] := البايت;
    (*الباني).العدد := الموضع + 1;
    أرجع صواب;
}

عام عرف ألحق_بايتات_بباني_البايتات(الباني: &متغير باني_بايتات, البايتات: &متجه ط8): منطقي {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (!احجز_لباني_البايتات(الباني, العدد)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الموضع: طبيعي = (*الباني).العدد;
        (*الباني).المخزن[الموضع] := (*البايتات)[ف];
        (*الباني).العدد := الموضع + 1;
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف ألحق_نصا_بباني_البايتات(الباني: &متغير باني_بايتات, النص: &نص): منطقي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (!احجز_لباني_البايتات(الباني, العدد)) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الموضع: طبيعي = (*الباني).العدد;
        (*الباني).المخزن[الموضع] := (*النص)[ف];
        (*الباني).العدد := الموضع + 1;
        ف := ف + 1;
    }
    أرجع صواب;
}

عام عرف طول_باني_البايتات(الباني: &باني_بايتات): طبيعي {
    أرجع (*الباني).العدد;
}

عام عرف سعة_باني_البايتات(الباني: &باني_بايتات): طبيعي {
    أرجع الطول((*الباني).المخزن) مثل طبيعي;
}

عام عرف باني_البايتات_فارغ(الباني: &باني_بايتات): منطقي {
    أرجع (*الباني).العدد == 0;
}

عام عرف بايتات_باني_البايتات(الباني: &باني_بايتات): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (*الباني).العدد) {
        ألحق(الناتج, (*الباني).المخزن[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Clear keeps reusable storage; reset releases it.
عام عرف امسح_باني_البايتات(الباني: &متغير باني_بايتات): فراغ {
    (*الباني).العدد := 0;
}

عام عرف أعد_ضبط_باني_البايتات(الباني: &متغير باني_بايتات): فراغ {
    دع الفارغ: متجه ط8 = [];
    (*الباني).المخزن := الفارغ;
    (*الباني).العدد := 0;
}

عام مرادف byte_builder = باني_بايتات;
عام مرادف new_byte_builder = أنشئ_باني_بايتات;
عام مرادف new_byte_builder_with_capacity = أنشئ_باني_بايتات_بسعة;
عام مرادف byte_builder_reserve = احجز_لباني_البايتات;
عام مرادف byte_builder_append_byte = ألحق_بايتا_بباني_البايتات;
عام مرادف byte_builder_append_bytes = ألحق_بايتات_بباني_البايتات;
عام مرادف byte_builder_append_text = ألحق_نصا_بباني_البايتات;
عام مرادف byte_builder_length = طول_باني_البايتات;
عام مرادف byte_builder_capacity = سعة_باني_البايتات;
عام مرادف byte_builder_is_empty = باني_البايتات_فارغ;
عام مرادف byte_builder_bytes = بايتات_باني_البايتات;
عام مرادف byte_builder_clear = امسح_باني_البايتات;
عام مرادف byte_builder_reset = أعد_ضبط_باني_البايتات;
