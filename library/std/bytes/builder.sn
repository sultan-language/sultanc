// Reusable byte builder. The backing vector length is storage capacity while
// `العدد` is the logical byte length, allowing clear/reuse without reallocating.
عام نوع باني_بايتات = {
    المخزن: متجه غ8,
    العدد: غير_موقع
};

عرف سعة_نمو_باني_البايتات(الحالية: غير_موقع, المطلوبة: غير_موقع): غير_موقع {
    دع السعة: متغير غير_موقع = الحالية;
    لو (السعة < 8) { السعة := 8; };
    بينما (السعة < المطلوبة) { السعة := السعة * 2; }
    أرجع السعة;
}

عرف ابن_مخزن_بايتات(السعة: غير_موقع): متجه غ8 {
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < السعة) {
        ألحق(المخزن, 0);
        ف := ف + 1;
    }
    أرجع المخزن;
}

عام عرف أنشئ_باني_بايتات_بسعة(السعة: غير_موقع): باني_بايتات {
    دع المخزن: متجه غ8 = ابن_مخزن_بايتات(السعة);
    دع الناتج: باني_بايتات = { المخزن: المخزن, العدد: 0 };
    أرجع الناتج;
}

عام عرف أنشئ_باني_بايتات(): باني_بايتات {
    أرجع أنشئ_باني_بايتات_بسعة(0);
}

عام عرف احجز_لباني_البايتات(الباني: &متغير باني_بايتات, إضافي: غير_موقع): فراغ {
    دع المطلوبة: غير_موقع = (*الباني).العدد + إضافي;
    دع الحالية: غير_موقع = الطول((*الباني).المخزن) مثل غير_موقع;
    لو (المطلوبة <= الحالية) { أرجع; };

    دع الجديدة: غير_موقع = سعة_نمو_باني_البايتات(الحالية, المطلوبة);
    دع ف: متغير غير_موقع = الحالية;
    بينما (ف < الجديدة) {
        ألحق((*الباني).المخزن, 0);
        ف := ف + 1;
    }
}

عام عرف ألحق_بايتا_بباني_البايتات(الباني: &متغير باني_بايتات, البايت: غ8): فراغ {
    احجز_لباني_البايتات(الباني, 1);
    دع الموضع: غير_موقع = (*الباني).العدد;
    (*الباني).المخزن[الموضع] := البايت;
    (*الباني).العدد := الموضع + 1;
}

عام عرف ألحق_بايتات_بباني_البايتات(الباني: &متغير باني_بايتات, البايتات: &متجه غ8): فراغ {
    دع العدد: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    احجز_لباني_البايتات(الباني, العدد);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الموضع: غير_موقع = (*الباني).العدد;
        (*الباني).المخزن[الموضع] := (*البايتات)[ف];
        (*الباني).العدد := الموضع + 1;
        ف := ف + 1;
    }
}

عام عرف ألحق_نصا_بباني_البايتات(الباني: &متغير باني_بايتات, النص: &نص): فراغ {
    دع العدد: غير_موقع = الطول(*النص) مثل غير_موقع;
    احجز_لباني_البايتات(الباني, العدد);
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        دع الموضع: غير_موقع = (*الباني).العدد;
        (*الباني).المخزن[الموضع] := (*النص)[ف];
        (*الباني).العدد := الموضع + 1;
        ف := ف + 1;
    }
}

عام عرف طول_باني_البايتات(الباني: &باني_بايتات): غير_موقع {
    أرجع (*الباني).العدد;
}

عام عرف سعة_باني_البايتات(الباني: &باني_بايتات): غير_موقع {
    أرجع الطول((*الباني).المخزن) مثل غير_موقع;
}

عام عرف باني_البايتات_فارغ(الباني: &باني_بايتات): منطقي {
    أرجع (*الباني).العدد == 0;
}

عام عرف بايتات_باني_البايتات(الباني: &باني_بايتات): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (*الباني).العدد) {
        ألحق(الناتج, (*الباني).المخزن[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Clear keeps reusable storage; reset releases it.
عام عرف امسح_باني_البايتات(الباني: &متغير باني_بايتات): فراغ {
    (*الباني).العدد := 0;
}

عام عرف أعد_ضبط_باني_البايتات(الباني: &متغير باني_بايتات): فراغ {
    دع الفارغ: متجه غ8 = [];
    (*الباني).المخزن := الفارغ;
    (*الباني).العدد := 0;
}

عام مرادف byte_builder = باني_بايتات;
عام مرادف new_byte_builder = أنشئ_باني_بايتات;
عام مرادف new_byte_builder_with_capacity = أنشئ_باني_بايتات_بسعة;
عام مرادف byte_builder_reserve = احجز_لباني_البايتات;
عام مرادف byte_builder_append_byte = ألحق_بايتا_بباني_البايتات;
عام مرادف byte_builder_append_bytes = ألحق_بايتات_بباني_البايتات;
عام مرادف byte_builder_append_text = ألحق_نصا_بباني_البايتات;
عام مرادف byte_builder_length = طول_باني_البايتات;
عام مرادف byte_builder_capacity = سعة_باني_البايتات;
عام مرادف byte_builder_is_empty = باني_البايتات_فارغ;
عام مرادف byte_builder_bytes = بايتات_باني_البايتات;
عام مرادف byte_builder_clear = امسح_باني_البايتات;
عام مرادف byte_builder_reset = أعد_ضبط_باني_البايتات;
