// Bounds-checked byte cursor for binary protocols and parsers. It owns no I/O;
// callers provide an already available byte vector.
عام نوع مؤشر_بايتات = {
    البايتات: متجه غ8,
    الموضع: غير_موقع
};

عام عرف أنشئ_مؤشر_بايتات(البايتات: &متجه غ8): مؤشر_بايتات {
    دع المصدر: متجه غ8 = *البايتات;
    دع الناتج: مؤشر_بايتات = { البايتات: المصدر, الموضع: 0 };
    أرجع الناتج;
}

عام عرف موضع_مؤشر_بايتات(المؤشر: &مؤشر_بايتات): غير_موقع {
    دع الحالة: مؤشر_بايتات = *المؤشر;
    أرجع الحالة.الموضع;
}

عام عرف متبقي_مؤشر_بايتات(المؤشر: &مؤشر_بايتات): غير_موقع {
    دع الحالة: مؤشر_بايتات = *المؤشر;
    دع العدد: غير_موقع = الطول(الحالة.البايتات) مثل غير_موقع;
    لو (الحالة.الموضع >= العدد) { أرجع 0; };
    أرجع العدد - الحالة.الموضع;
}

عام عرف اقرأ_غ8(المؤشر: &متغير مؤشر_بايتات): اختيار غ8 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < 1) { أرجع اختيار.لا_شيء(); };
    دع القيمة: غ8 = الحالة.البايتات[الحالة.الموضع];
    الحالة.الموضع := الحالة.الموضع + 1;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_غ16_صغير(المؤشر: &متغير مؤشر_بايتات): اختيار غ16 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < 2) { أرجع اختيار.لا_شيء(); };
    دع م: غير_موقع = الحالة.الموضع;
    دع م1: غير_موقع = م + 1;
    دع القيمة: غ16 = ((الحالة.البايتات[م] مثل غ16) | ((الحالة.البايتات[م1] مثل غ16) << 8));
    الحالة.الموضع := م + 2;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_غ16_كبير(المؤشر: &متغير مؤشر_بايتات): اختيار غ16 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < 2) { أرجع اختيار.لا_شيء(); };
    دع م: غير_موقع = الحالة.الموضع;
    دع م1: غير_موقع = م + 1;
    دع القيمة: غ16 = (((الحالة.البايتات[م] مثل غ16) << 8) | (الحالة.البايتات[م1] مثل غ16));
    الحالة.الموضع := م + 2;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_غ32_صغير(المؤشر: &متغير مؤشر_بايتات): اختيار غ32 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < 4) { أرجع اختيار.لا_شيء(); };
    دع م: غير_موقع = الحالة.الموضع;
    دع م1: غير_موقع = م + 1;
    دع م2: غير_موقع = م + 2;
    دع م3: غير_موقع = م + 3;
    دع ب0: غ32 = الحالة.البايتات[م] مثل غ32;
    دع ب1: غ32 = الحالة.البايتات[م1] مثل غ32;
    دع ب2: غ32 = الحالة.البايتات[م2] مثل غ32;
    دع ب3: غ32 = الحالة.البايتات[م3] مثل غ32;
    دع القيمة: متغير غ32 = ب0;
    القيمة := القيمة | (ب1 << 8);
    القيمة := القيمة | (ب2 << 16);
    القيمة := القيمة | (ب3 << 24);
    الحالة.الموضع := م + 4;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_غ32_كبير(المؤشر: &متغير مؤشر_بايتات): اختيار غ32 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < 4) { أرجع اختيار.لا_شيء(); };
    دع م: غير_موقع = الحالة.الموضع;
    دع م1: غير_موقع = م + 1;
    دع م2: غير_موقع = م + 2;
    دع م3: غير_موقع = م + 3;
    دع ب0: غ32 = الحالة.البايتات[م] مثل غ32;
    دع ب1: غ32 = الحالة.البايتات[م1] مثل غ32;
    دع ب2: غ32 = الحالة.البايتات[م2] مثل غ32;
    دع ب3: غ32 = الحالة.البايتات[م3] مثل غ32;
    دع القيمة: متغير غ32 = ب0 << 24;
    القيمة := القيمة | (ب1 << 16);
    القيمة := القيمة | (ب2 << 8);
    القيمة := القيمة | ب3;
    الحالة.الموضع := م + 4;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(القيمة);
}

عام عرف اقرأ_بايتات(المؤشر: &متغير مؤشر_بايتات, العدد: غير_موقع): اختيار متجه غ8 {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < العدد) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير متجه غ8 = [];
    دع النهاية: غير_موقع = الحالة.الموضع + العدد;
    دع ف: متغير غير_موقع = الحالة.الموضع;
    بينما (ف < النهاية) {
        ألحق(الناتج, الحالة.البايتات[ف]);
        ف := ف + 1;
    }
    الحالة.الموضع := النهاية;
    *المؤشر := الحالة;
    أرجع اختيار.بعض(الناتج);
}

عام عرف تخط_بايتات(المؤشر: &متغير مؤشر_بايتات, العدد: غير_موقع): منطقي {
    دع الحالة: متغير مؤشر_بايتات = *المؤشر;
    لو (متبقي_مؤشر_بايتات(&الحالة) < العدد) { أرجع خطأ; };
    الحالة.الموضع := الحالة.الموضع + العدد;
    *المؤشر := الحالة;
    أرجع صواب;
}

عام نوع byte_cursor = مؤشر_بايتات;
عام مرادف new_byte_cursor = أنشئ_مؤشر_بايتات;
عام مرادف byte_cursor_position = موضع_مؤشر_بايتات;
عام مرادف byte_cursor_remaining = متبقي_مؤشر_بايتات;
عام مرادف byte_cursor_read_u8 = اقرأ_غ8;
عام مرادف byte_cursor_read_u16_le = اقرأ_غ16_صغير;
عام مرادف byte_cursor_read_u16_be = اقرأ_غ16_كبير;
عام مرادف byte_cursor_read_u32_le = اقرأ_غ32_صغير;
عام مرادف byte_cursor_read_u32_be = اقرأ_غ32_كبير;
عام مرادف byte_cursor_read_bytes = اقرأ_بايتات;
عام مرادف byte_cursor_skip = تخط_بايتات;
