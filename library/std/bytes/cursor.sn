استورد text.from_bytes;
// Bounds-checked byte cursor for binary protocols and parsers. It owns no I/O;
// callers provide an already available byte vector.
عام نوع مؤشر_بايتات = {
    البايتات: متجه ط8,
    الموضع: طبيعي
};

عام عرف أنشئ_مؤشر_بايتات(البايتات: &متجه ط8): مؤشر_بايتات {
    // The cursor owns its bytes: an independent copy of the borrowed input.
    دع الناتج: مؤشر_بايتات = { البايتات: انسخ_بايتات(البايتات), الموضع: 0 };
    أرجع الناتج;
}

عام عرف موضع_مؤشر_بايتات(المؤشر: &مؤشر_بايتات): طبيعي {
    أرجع (*المؤشر).الموضع;
}

عام عرف متبقي_مؤشر_بايتات(المؤشر: &مؤشر_بايتات): طبيعي {
    دع العدد: طبيعي = الطول((*المؤشر).البايتات) مثل طبيعي;
    لو ((*المؤشر).الموضع >= العدد) { أرجع 0; };
    أرجع العدد - (*المؤشر).الموضع;
}

عام عرف اقرأ_ط8(المؤشر: &متغير مؤشر_بايتات): اختياري ط8 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < 1) { أرجع اختياري.لا_شيء(); };
    دع القيمة: ط8 = (*المؤشر).البايتات[(*المؤشر).الموضع];
    (*المؤشر).الموضع := (*المؤشر).الموضع + 1;
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_ط16_صغير(المؤشر: &متغير مؤشر_بايتات): اختياري ط16 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < 2) { أرجع اختياري.لا_شيء(); };
    دع م: طبيعي = (*المؤشر).الموضع;
    دع م1: طبيعي = م + 1;
    دع القيمة: ط16 = (((*المؤشر).البايتات[م] مثل ط16) | (((*المؤشر).البايتات[م1] مثل ط16) << 8));
    (*المؤشر).الموضع := م + 2;
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_ط16_كبير(المؤشر: &متغير مؤشر_بايتات): اختياري ط16 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < 2) { أرجع اختياري.لا_شيء(); };
    دع م: طبيعي = (*المؤشر).الموضع;
    دع م1: طبيعي = م + 1;
    دع القيمة: ط16 = ((((*المؤشر).البايتات[م] مثل ط16) << 8) | ((*المؤشر).البايتات[م1] مثل ط16));
    (*المؤشر).الموضع := م + 2;
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_ط32_صغير(المؤشر: &متغير مؤشر_بايتات): اختياري ط32 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < 4) { أرجع اختياري.لا_شيء(); };
    دع م: طبيعي = (*المؤشر).الموضع;
    دع م1: طبيعي = م + 1;
    دع م2: طبيعي = م + 2;
    دع م3: طبيعي = م + 3;
    دع ب0: ط32 = (*المؤشر).البايتات[م] مثل ط32;
    دع ب1: ط32 = (*المؤشر).البايتات[م1] مثل ط32;
    دع ب2: ط32 = (*المؤشر).البايتات[م2] مثل ط32;
    دع ب3: ط32 = (*المؤشر).البايتات[م3] مثل ط32;
    دع القيمة: متغير ط32 = ب0;
    القيمة := القيمة | (ب1 << 8);
    القيمة := القيمة | (ب2 << 16);
    القيمة := القيمة | (ب3 << 24);
    (*المؤشر).الموضع := م + 4;
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_ط32_كبير(المؤشر: &متغير مؤشر_بايتات): اختياري ط32 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < 4) { أرجع اختياري.لا_شيء(); };
    دع م: طبيعي = (*المؤشر).الموضع;
    دع م1: طبيعي = م + 1;
    دع م2: طبيعي = م + 2;
    دع م3: طبيعي = م + 3;
    دع ب0: ط32 = (*المؤشر).البايتات[م] مثل ط32;
    دع ب1: ط32 = (*المؤشر).البايتات[م1] مثل ط32;
    دع ب2: ط32 = (*المؤشر).البايتات[م2] مثل ط32;
    دع ب3: ط32 = (*المؤشر).البايتات[م3] مثل ط32;
    دع القيمة: متغير ط32 = ب0 << 24;
    القيمة := القيمة | (ب1 << 16);
    القيمة := القيمة | (ب2 << 8);
    القيمة := القيمة | ب3;
    (*المؤشر).الموضع := م + 4;
    أرجع اختياري.موجود(القيمة);
}

عام عرف اقرأ_بايتات(المؤشر: &متغير مؤشر_بايتات, العدد: طبيعي): اختياري متجه ط8 {
    لو (متبقي_مؤشر_بايتات(المؤشر) < العدد) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير متجه ط8 = [];
    دع النهاية: طبيعي = (*المؤشر).الموضع + العدد;
    دع ف: متغير طبيعي = (*المؤشر).الموضع;
    طالما (ف < النهاية) {
        ألحق(الناتج, (*المؤشر).البايتات[ف]);
        ف := ف + 1;
    }
    (*المؤشر).الموضع := النهاية;
    أرجع اختياري.موجود(الناتج);
}

عام عرف تخط_بايتات(المؤشر: &متغير مؤشر_بايتات, العدد: طبيعي): منطقي {
    لو (متبقي_مؤشر_بايتات(المؤشر) < العدد) { أرجع خطأ; };
    (*المؤشر).الموضع := (*المؤشر).الموضع + العدد;
    أرجع صواب;
}

عام نوع byte_cursor = مؤشر_بايتات;
عام مرادف new_byte_cursor = أنشئ_مؤشر_بايتات;
عام مرادف byte_cursor_position = موضع_مؤشر_بايتات;
عام مرادف byte_cursor_remaining = متبقي_مؤشر_بايتات;
عام مرادف byte_cursor_read_u8 = اقرأ_ط8;
عام مرادف byte_cursor_read_u16_le = اقرأ_ط16_صغير;
عام مرادف byte_cursor_read_u16_be = اقرأ_ط16_كبير;
عام مرادف byte_cursor_read_u32_le = اقرأ_ط32_صغير;
عام مرادف byte_cursor_read_u32_be = اقرأ_ط32_كبير;
عام مرادف byte_cursor_read_bytes = اقرأ_بايتات;
عام مرادف byte_cursor_skip = تخط_بايتات;

// Old names, kept for one release: the unsigned types are now `طبيعي` and `ط8`..`ط64`.
عام مرادف اقرأ_غ8 = اقرأ_ط8;
عام مرادف اقرأ_غ16_صغير = اقرأ_ط16_صغير;
عام مرادف اقرأ_غ16_كبير = اقرأ_ط16_كبير;
عام مرادف اقرأ_غ32_صغير = اقرأ_ط32_صغير;
عام مرادف اقرأ_غ32_كبير = اقرأ_ط32_كبير;
