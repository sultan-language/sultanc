    دع الناتج: ص8 = جمع_ملتف_بدائيا(أ, ب);
    لو ((ب < 0) != (الناتج < أ)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(الناتج);
}
عام عرف طرح_ص8_متحقق(أ: ص8, ب: ص8): اختياري ص8 {
