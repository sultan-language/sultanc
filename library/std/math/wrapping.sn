    طابق ضرب_ص8_متحقق_داخليا(أ, ب) مع
    | اختياري.موجود(الناتج) -> { أرجع الناتج; }
    | اختياري.لا_شيء -> { لو ((أ < 0) != (ب < 0)) { أرجع (-128); }; أرجع 127; };
