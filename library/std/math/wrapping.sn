عام عرف ضرب_ص8_متحقق(أ: ص8, ب: ص8): اختياري ص8 {
    // The exact product fits 64 bits: no division, no wrapping.
    دع الناتج: ص64 = (أ مثل ص64) * (ب مثل ص64);
    لو (الناتج < ((-128) مثل ص64) || الناتج > (127 مثل ص64)) { أرجع اختياري.لا_شيء(); };
