// Wrapping, checked and saturating integer arithmetic for every integer type.
// Generated by tools/generate/generate_wrapping_arithmetic.py; do not edit.
//
// - `جمع_T_ملتف` / `wrapping_add_T` (also طرح, ضرب): the result modulo 2^N, never
//   a trap (Rust's wrapping_add, Go's unsigned arithmetic).
// - `إزاحة_يسرى_T_ملتفة` / `wrapping_shl_T` (and يمنى): the amount is taken modulo
//   the width, as Rust's wrapping_shl; a right shift of a signed type is arithmetic.
// - `جمع_T_متحقق` / `checked_add_T`: none on overflow (Rust's checked_add).
// - `جمع_T_مشبع` / `saturating_add_T`: clamped to the type's bounds.
// The uint and int checked operations and the uint saturating ones are in
// std.math.integer, which defined them first.

مرادف جمع_ملتف_بدائيا = بدائي_جمع_ملتف;
مرادف طرح_ملتف_بدائيا = بدائي_طرح_ملتف;
مرادف ضرب_ملتف_بدائيا = بدائي_ضرب_ملتف;
