استورد math.float;

// Sine, cosine and tangent of an angle in radians, in SultanC arithmetic
// (no libm). binary64: Go's math package (Cephes polynomials on [-pi/4,
// pi/4]); the argument is reduced with Cody-Waite (pi/4 split in three)
// below 2^29 and with Payne-Hanek (1280 bits of 4/pi) above, so even
// sin(1e300) is correctly reduced. binary32: Cephes sinf/cosf/tanf with
// float32 coefficients and a three-part pi/4; the result keeps float32
// accuracy for |x| up to 8192 (as Cephes) and degrades gracefully above.
// SultanC has no float/integer conversion and traps on integer overflow,
// so the Payne-Hanek step builds the mantissa and the 128-bit product from
// exact float steps and 32-bit halves.

// 4/pi = sum of word[i] * 2^(-64 i) (Go's mPi4), generated from 4/pi.
عرف كلمات_أربعة_على_باي(): متجه ط64 {
    دع ك: متغير متجه ط64 = [];
    ألحق(ك, 0x0000000000000001); ألحق(ك, 0x45f306dc9c882a53); ألحق(ك, 0xf84eafa3ea69bb81);
    ألحق(ك, 0xb6c52b3278872083); ألحق(ك, 0xfca2c757bd778ac3); ألحق(ك, 0x6e48dc74849ba5c0);
    ألحق(ك, 0x0c925dd413a32439); ألحق(ك, 0xfc3bd63962534e7d); ألحق(ك, 0xd1046bea5d768909);
    ألحق(ك, 0xd338e04d68befc82); ألحق(ك, 0x7323ac7306a673e9); ألحق(ك, 0x3908bf177bf25076);
    ألحق(ك, 0x3ff12fffbc0b301f); ألحق(ك, 0xde5e2316b414da3e); ألحق(ك, 0xda6cfd9e4f96136e);
    ألحق(ك, 0x9e8c7ecd3cbfd45a); ألحق(ك, 0xea4f758fd7cbe2f6); ألحق(ك, 0x7a0e73ef14a525d4);
    ألحق(ك, 0xd7f6bf623f1aba10); ألحق(ك, 0xac06608df8f6d757);
    أرجع ك;
}

// An integral binary64 in [0, 2^64) as a ط64, one bit at a time.
عرف ط64_من_عائم(القيمة: ع64): ط64 {
    دع الباقي: متغير ع64 = القيمة;
    دع الوحدة: متغير ع64 = 9223372036854775808.0;
    دع الناتج: متغير ط64 = 0;
    دع البت: متغير ط64 = 63;
    طالما (صواب) {
        إذا (الباقي >= الوحدة) {
            الناتج := الناتج | ((1 مثل ط64) << البت);
            الباقي := الباقي - الوحدة;
        };
        إذا (البت == 0) { اخرج_من_حلقة; };
        البت := البت - 1;
        الوحدة := الوحدة / 2.0;
    }
    أرجع الناتج;
}

// The top 53 significant bits of a ط64 as a binary64 (lower bits are
// truncated, as Go's reduction truncates).
عرف عائم_من_ط64(القيمة: ط64): ع64 {
    دع الناتج: متغير ع64 = 0.0;
    دع الوحدة: متغير ع64 = 9223372036854775808.0;
    دع البت: متغير ط64 = 63;
    دع المأخوذ: متغير طبيعي = 0;
    دع بدأ: متغير منطقي = خطأ;
    طالما (صواب) {
        إذا (((القيمة >> البت) & 1) == 1) {
            بدأ := صواب;
            الناتج := الناتج + الوحدة;
        };
        إذا (بدأ) { المأخوذ := المأخوذ + 1; };
        إذا (البت == 0 || المأخوذ == 53) { اخرج_من_حلقة; };
        البت := البت - 1;
        الوحدة := الوحدة / 2.0;
    }
    أرجع الناتج;
}

// The full 128-bit product of two ط64 values, from 32-bit halves so that
// no step overflows: [high word, low word].
عرف اضرب_كاملا_ط64(أ: ط64, ب: ط64): متجه ط64 {
    دع قناع: ط64 = 0xffffffff;
    دع أ0: ط64 = أ & قناع;
    دع أ1: ط64 = أ >> 32;
    دع ب0: ط64 = ب & قناع;
    دع ب1: ط64 = ب >> 32;
    دع ض00: ط64 = أ0 * ب0;
    دع ض01: ط64 = أ0 * ب1;
    دع ض10: ط64 = أ1 * ب0;
    دع ض11: ط64 = أ1 * ب1;
    // Middle column: (ض00 >> 32) + low(ض01) + low(ض10) < 3 * 2^32.
    دع الوسط: ط64 = (ض00 >> 32) + (ض01 & قناع) + (ض10 & قناع);
    دع المنخفض: ط64 = (ض00 & قناع) | ((الوسط & قناع) << 32);
    دع المرتفع: ط64 = ض11 + (ض01 >> 32) + (ض10 >> 32) + (الوسط >> 32);
    دع الناتج: متغير متجه ط64 = [];
    ألحق(الناتج, المرتفع);
    ألحق(الناتج, المنخفض);
    أرجع الناتج;
}

// a + b modulo 2^64, with the carry out.
عرف اجمع_بحمل_ط64(أ: ط64, ب: ط64, الحمل_الداخل: ط64): متجه ط64 {
    دع قناع: ط64 = 0xffffffff;
    دع منخفض: ط64 = (أ & قناع) + (ب & قناع) + الحمل_الداخل;
    دع مرتفع: ط64 = (أ >> 32) + (ب >> 32) + (منخفض >> 32);
    دع الناتج: متغير متجه ط64 = [];
    ألحق(الناتج, ((مرتفع & قناع) << 32) | (منخفض & قناع));
    ألحق(الناتج, مرتفع >> 32);
    أرجع الناتج;
}

عرف أصفار_بادئة_ط64(القيمة: ط64): ط64 {
    دع العدد: متغير ط64 = 0;
    دع ف: متغير ط64 = 63;
    طالما (صواب) {
        إذا (((القيمة >> ف) & 1) == 1) { أرجع العدد; };
        العدد := العدد + 1;
        إذا (ف == 0) { أرجع 64; };
        ف := ف - 1;
    }
    أرجع 64;
}

// The reduced argument: j (octant, 0..7) and z in [-pi/4, pi/4], with
// x = j * pi/4 + z modulo 2 pi.
نوع مختزل_مثلثي = { الثمن: ط64, الزاوية: ع64 };

// Shifts that drop the bits leaving the word (a plain << traps on them).
عرف ط_يسار(القيمة: ط64, الإزاحة: ط64): ط64 {
    إذا (الإزاحة >= 64) { أرجع 0; };
    إذا (الإزاحة == 0) { أرجع القيمة; };
    دع القناع: ط64 = ((1 مثل ط64) << (64 - الإزاحة)) - 1;
    أرجع (القيمة & القناع) << الإزاحة;
}
عرف ط_يمين(القيمة: ط64, الإزاحة: ط64): ط64 {
    إذا (الإزاحة >= 64) { أرجع 0; };
    أرجع القيمة >> الإزاحة;
}

// Payne-Hanek (Go's trigReduce) for x >= 2^29.
عرف اختزل_كبيرا64(س: ع64): مختزل_مثلثي {
    // x = m * 2^e with 2^52 <= m < 2^53: exact halvings.
    دع ص: متغير ع64 = س;
    دع الأس: متغير عدد = 0;
    طالما (ص >= 9007199254740992.0) { ص := ص * 0.5; الأس := الأس + 1; }
    طالما (ص < 4503599627370496.0) { ص := ص * 2.0; الأس := الأس - 1; }
    دع م: ط64 = ط64_من_عائم(ص);
    // Go's exp is e (unbiased exponent minus 52); here x >= 2^29 gives
    // e >= -23, so e + 61 >= 38.
    دع الموضع: ط64 = (الأس + 61) مثل ط64;
    دع الرقم: طبيعي = (الموضع / 64) مثل طبيعي;
    دع الإزاحة: ط64 = الموضع % 64;
    دع ك: متجه ط64 = كلمات_أربعة_على_باي();
    دع ز0: ط64 = ط_يسار(ك[الرقم], الإزاحة) | ط_يمين(ك[الرقم + 1], 64 - الإزاحة);
    دع ز1: ط64 = ط_يسار(ك[الرقم + 1], الإزاحة) | ط_يمين(ك[الرقم + 2], 64 - الإزاحة);
    دع ز2: ط64 = ط_يسار(ك[الرقم + 2], الإزاحة) | ط_يمين(ك[الرقم + 3], 64 - الإزاحة);
    دع ض2: متجه ط64 = اضرب_كاملا_ط64(ز2, م);
    دع ض1: متجه ط64 = اضرب_كاملا_ط64(ز1, م);
    دع ض0: متجه ط64 = اضرب_كاملا_ط64(ز0, م);
    دع مجموع_منخفض: متجه ط64 = اجمع_بحمل_ط64(ض1[1], ض2[0], 0);
    دع مجموع_مرتفع: متجه ط64 = اجمع_بحمل_ط64(ض0[1], ض1[0], مجموع_منخفض[1]);
    دع منخفض: ط64 = مجموع_منخفض[0];
    دع مرتفع_كامل: ط64 = مجموع_مرتفع[0];
    دع الثمن: متغير ط64 = مرتفع_كامل >> 61;
    دع مرتفع: ط64 = ط_يسار(مرتفع_كامل, 3) | (منخفض >> 61);
    دع منخفض_مزاح: ط64 = ط_يسار(منخفض, 3);
    // The fraction hi:lo / 2^128 in [0, 1), from its top 53 bits.
    دع العشري: متغير ع64 = 0.0;
    إذا (مرتفع != 0) {
        العشري := عائم_من_ط64(مرتفع) / 18446744073709551616.0;
    } وإلا {
        العشري := عائم_من_ط64(منخفض_مزاح) / 18446744073709551616.0 / 18446744073709551616.0;
    };
    إذا ((الثمن & 1) == 1) {
        الثمن := (الثمن + 1) & 7;
        العشري := العشري - 1.0;
    };
    دع الناتج: مختزل_مثلثي = { الثمن: الثمن, الزاوية: العشري * 0.785398163397448309615660845819875721 };
    أرجع الناتج;
}

// Cody-Waite below 2^29: j = floor(x * 4/pi), rounded up to even, and
// z = ((x - j*PI4A) - j*PI4B) - j*PI4C.
عرف اختزل64(س: ع64): مختزل_مثلثي {
    إذا (س >= 536870912.0) { أرجع اختزل_كبيرا64(س); };
    دع ي: متغير ع64 = بتر64(س * 1.27323954473516268615107010698011489627567716592365);
    دع الثمن_عائم: متغير ع64 = ي - 8.0 * بتر64(ي / 8.0);
    إذا (باقي64(ي, 2.0) == 1.0) { ي := ي + 1.0; الثمن_عائم := الثمن_عائم + 1.0; };
    إذا (الثمن_عائم >= 8.0) { الثمن_عائم := الثمن_عائم - 8.0; };
    دع ز: ع64 = ((س - ي * 7.85398125648498535156e-1) - ي * 3.77489470793079817668e-8) - ي * 2.69515142907905952645e-15;
    دع الثمن: متغير ط64 = 0;
    دع ح: متغير ع64 = الثمن_عائم;
    طالما (ح >= 1.0) { الثمن := الثمن + 1; ح := ح - 1.0; }
    دع الناتج: مختزل_مثلثي = { الثمن: الثمن, الزاوية: ز };
    أرجع الناتج;
}

عرف كثيرة_جيب64(ز: ع64, زز: ع64): ع64 {
    أرجع ز + ز * زز * ((((((1.58962301576546568060e-10 * زز) + -2.50507477628578072866e-8) * زز
        + 2.75573136213857245213e-6) * زز + -1.98412698295895385996e-4) * زز
        + 8.33333333332211858878e-3) * زز + -1.66666666666666307295e-1);
}
عرف كثيرة_جيب_تمام64(زز: ع64): ع64 {
    أرجع 1.0 - 0.5 * زز + زز * زز * ((((((-1.13585365213876817300e-11 * زز) + 2.08757008419747316778e-9) * زز
        + -2.75573141792967388112e-7) * زز + 2.48015872888517045348e-5) * زز
        + -1.38888888888730564116e-3) * زز + 4.16666666666665929218e-2);
}

عام عرف جيب64(القيمة: ع64): ع64 {
    إذا (القيمة == 0.0 || ليس_رقما64(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية64(القيمة)) { دع الصفر: ع64 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: متغير منطقي = القيمة < 0.0;
    دع المختزل: مختزل_مثلثي = اختزل64(مطلق64(القيمة));
    دع الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    دع ز: ع64 = المختزل.الزاوية;
    دع زز: ع64 = ز * ز;
    دع الناتج: متغير ع64 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب_تمام64(زز); }
    وإلا { الناتج := كثيرة_جيب64(ز, زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف جيب_تمام64(القيمة: ع64): ع64 {
    إذا (ليس_رقما64(القيمة) || هل_لانهاية64(القيمة)) { دع الصفر: ع64 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: متغير منطقي = خطأ;
    دع المختزل: مختزل_مثلثي = اختزل64(مطلق64(القيمة));
    دع الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    إذا (الثمن > 1) { سالب := !سالب; };
    دع ز: ع64 = المختزل.الزاوية;
    دع زز: ع64 = ز * ز;
    دع الناتج: متغير ع64 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب64(ز, زز); }
    وإلا { الناتج := كثيرة_جيب_تمام64(زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف ظل64(القيمة: ع64): ع64 {
    إذا (القيمة == 0.0 || ليس_رقما64(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية64(القيمة)) { دع الصفر: ع64 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: منطقي = القيمة < 0.0;
    دع المختزل: مختزل_مثلثي = اختزل64(مطلق64(القيمة));
    دع ز: ع64 = المختزل.الزاوية;
    دع زز: ع64 = ز * ز;
    دع الناتج: متغير ع64 = ز;
    إذا (زز > 1.0e-14) {
        الناتج := ز + ز * (زز * (((-1.30936939181383777646e4 * زز) + 1.15351664838587416140e6) * زز
            + -1.79565251976484877988e7) / ((((زز + 1.36812963470692954678e4) * زز
            + -1.32089234440210967447e6) * زز + 2.50083801823357915839e7) * زز
            + -5.38695755929454629881e7));
    };
    إذا ((المختزل.الثمن & 2) == 2) { الناتج := -1.0 / الناتج; };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

// binary32 (Cephes sinf.c, cosf.c, tanf.c).
نوع مختزل_مثلثي32 = { الثمن: ط64, الزاوية: ع32 };

عرف اختزل32(س: ع32): مختزل_مثلثي32 {
    دع ي: متغير ع32 = بتر32(س * 1.27323954473516);
    إذا (باقي32(ي, 2.0) == 1.0) { ي := ي + 1.0; };
    دع الثمن_عائم: متغير ع32 = باقي32(ي, 8.0);
    دع ز: ع32 = ((س - ي * 0.78515625) - ي * 2.4187564849853515625e-4) - ي * 3.77489497744594108e-8;
    دع الثمن: متغير ط64 = 0;
    طالما (الثمن_عائم >= 1.0) { الثمن := الثمن + 1; الثمن_عائم := الثمن_عائم - 1.0; }
    دع الناتج: مختزل_مثلثي32 = { الثمن: الثمن, الزاوية: ز };
    أرجع الناتج;
}
عرف كثيرة_جيب32(ز: ع32, زز: ع32): ع32 {
    أرجع ((-1.9515295891e-4 * زز + 8.3321608736e-3) * زز - 1.6666654611e-1) * زز * ز + ز;
}
عرف كثيرة_جيب_تمام32(زز: ع32): ع32 {
    أرجع ((2.443315711809948e-5 * زز - 1.388731625493765e-3) * زز + 4.166664568298827e-2) * زز * زز - 0.5 * زز + 1.0;
}

عام عرف جيب32(القيمة: ع32): ع32 {
    إذا (القيمة == 0.0 || ليس_رقما32(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: متغير منطقي = القيمة < 0.0;
    دع المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    دع الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    دع ز: ع32 = المختزل.الزاوية;
    دع زز: ع32 = ز * ز;
    دع الناتج: متغير ع32 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب_تمام32(زز); }
    وإلا { الناتج := كثيرة_جيب32(ز, زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف جيب_تمام32(القيمة: ع32): ع32 {
    إذا (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: متغير منطقي = خطأ;
    دع المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    دع الثمن: متغير ط64 = المختزل.الثمن;
    إذا (الثمن > 3) { سالب := !سالب; الثمن := الثمن - 4; };
    إذا (الثمن > 1) { سالب := !سالب; };
    دع ز: ع32 = المختزل.الزاوية;
    دع زز: ع32 = ز * ز;
    دع الناتج: متغير ع32 = 0.0;
    إذا (الثمن == 1 || الثمن == 2) { الناتج := كثيرة_جيب32(ز, زز); }
    وإلا { الناتج := كثيرة_جيب_تمام32(زز); };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف ظل32(القيمة: ع32): ع32 {
    إذا (القيمة == 0.0 || ليس_رقما32(القيمة)) { أرجع القيمة; };
    إذا (هل_لانهاية32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: منطقي = القيمة < 0.0;
    دع المختزل: مختزل_مثلثي32 = اختزل32(مطلق32(القيمة));
    دع ز: ع32 = المختزل.الزاوية;
    دع زز: ع32 = ز * ز;
    دع الناتج: متغير ع32 = ز;
    إذا (زز > 1.0e-4) {
        الناتج := (((((9.38540185543e-3 * زز + 3.11992232697e-3) * زز + 2.44301354525e-2) * زز
            + 5.34112807005e-2) * زز + 1.33387994085e-1) * زز + 3.33331568548e-1) * زز * ز + ز;
    };
    إذا ((المختزل.الثمن & 2) == 2) { الناتج := -1.0 / الناتج; };
    إذا (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام مرادف sin_f64 = جيب64;
عام مرادف cos_f64 = جيب_تمام64;
