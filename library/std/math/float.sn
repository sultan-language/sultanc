عام مرادف cbrt_f32 = جذر_تكعيبي32;
عام مرادف log_f32 = لوغاريتم_أساس32;
عام مرادف div_euclid_f32 = قسمة_إقليدية32;
عام مرادف rem_euclid_f32 = باقي_إقليدي32;

// Additional aggregate statistics for f64 vectors.
عام عرف أصغر_قيمة64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير ع64 = النسخة[0];
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(النسخة) مثل غير_موقع)) {
        الناتج := أصغر64(الناتج, النسخة[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}
عام عرف أكبر_قيمة64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير ع64 = النسخة[0];
    دع ف: متغير غير_موقع = 1;
    بينما (ف < (الطول(النسخة) مثل غير_موقع)) {
        الناتج := أكبر64(الناتج, النسخة[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}
عام عرف حاصل_ضرب64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع الناتج: متغير ع64 = 1.0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النسخة) مثل غير_موقع)) { الناتج := الناتج * النسخة[ف]; ف := ف + 1; }
    أرجع الناتج;
}
عام عرف متوسط_تربيعي64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختيار.لا_شيء(); };
    دع المقياس: ع64 = معيار2_64(&النسخة);
    دع العدد: متغير ع64 = 0.0;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(النسخة) مثل غير_موقع)) { العدد := العدد + 1.0; ف := ف + 1; }
    أرجع اختيار.بعض(المقياس / جذر_تربيعي64(العدد));
}

عام مرادف min_value_f64 = أصغر_قيمة64;
عام مرادف max_value_f64 = أكبر_قيمة64;
عام مرادف product_f64 = حاصل_ضرب64;
عام مرادف rms_f64 = متوسط_تربيعي64;
