// Additional scalar conveniences built on the elementary layer.
عام عرف إشارة64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    لو (القيمة > 0.0) { أرجع 1.0; };
    أرجع -1.0;
}
عام عرف مقلوب64(القيمة: ع64): ع64 { أرجع 1.0 / القيمة; }
عام عرف نقطة_منتصف64(أ: ع64, ب: ع64): ع64 {
    لو (((أ < 0.0) && (ب > 0.0)) || ((أ > 0.0) && (ب < 0.0))) { أرجع (أ + ب) / 2.0; };
    أرجع (أ / 2.0) + (ب / 2.0);
}
عام عرف جذر_تكعيبي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || هل_لانهاية64(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    لو (القيمة < 0.0) { أرجع -أس64(لوغاريتم64(-القيمة) / 3.0); };
    أرجع أس64(لوغاريتم64(القيمة) / 3.0);
}
عام عرف لوغاريتم_أساس64(القيمة: ع64, الأساس: ع64): ع64 {
    لو ((الأساس <= 0.0) || (الأساس == 1.0) || ليس_رقما64(الأساس)) {
        دع الصفر: ع64 = 0.0; أرجع الصفر / الصفر;
    };
    أرجع لوغاريتم64(القيمة) / لوغاريتم64(الأساس);
}
عام عرف قسمة_إقليدية64(القيمة: ع64, المقسوم_عليه: ع64): ع64 {
    دع خارج: متغير ع64 = بتر64(القيمة / المقسوم_عليه);
    دع الباقي: ع64 = باقي64(القيمة, المقسوم_عليه);
    لو (الباقي < 0.0) {
        لو (المقسوم_عليه > 0.0) { خارج := خارج - 1.0; }
        وإلا { خارج := خارج + 1.0; };
    };
    أرجع خارج;
}
عام عرف باقي_إقليدي64(القيمة: ع64, المقسوم_عليه: ع64): ع64 {
    دع الباقي: ع64 = باقي64(القيمة, المقسوم_عليه);
    لو (الباقي < 0.0) { أرجع الباقي + مطلق64(المقسوم_عليه); };
    أرجع الباقي;
}

عام عرف إشارة32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    لو (القيمة > 0.0) { أرجع 1.0; };
    أرجع -1.0;
}
عام عرف مقلوب32(القيمة: ع32): ع32 { أرجع 1.0 / القيمة; }
عام عرف نقطة_منتصف32(أ: ع32, ب: ع32): ع32 {
    لو (((أ < 0.0) && (ب > 0.0)) || ((أ > 0.0) && (ب < 0.0))) { أرجع (أ + ب) / 2.0; };
    أرجع (أ / 2.0) + (ب / 2.0);
}
عام عرف جذر_تكعيبي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    لو (القيمة < 0.0) { أرجع -أس32(لوغاريتم32(-القيمة) / 3.0); };
    أرجع أس32(لوغاريتم32(القيمة) / 3.0);
}
عام عرف لوغاريتم_أساس32(القيمة: ع32, الأساس: ع32): ع32 {
    لو ((الأساس <= 0.0) || (الأساس == 1.0) || ليس_رقما32(الأساس)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    أرجع لوغاريتم32(القيمة) / لوغاريتم32(الأساس);
}
عام عرف قسمة_إقليدية32(القيمة: ع32, المقسوم_عليه: ع32): ع32 {
    دع خارج: متغير ع32 = بتر32(القيمة / المقسوم_عليه);
    دع الباقي: ع32 = باقي32(القيمة, المقسوم_عليه);
    لو (الباقي < 0.0) { لو (المقسوم_عليه > 0.0) { خارج := خارج - 1.0; } وإلا { خارج := خارج + 1.0; }; };
    أرجع خارج;
}
عام عرف باقي_إقليدي32(القيمة: ع32, المقسوم_عليه: ع32): ع32 {
    دع الباقي: ع32 = باقي32(القيمة, المقسوم_عليه);
    لو (الباقي < 0.0) { أرجع الباقي + مطلق32(المقسوم_عليه); };
    أرجع الباقي;
}

