عام مرادف tanpi_f64 = ظل_باي64;

// f32 parity for the arithmetic-only elementary layer.
عام عرف بتر32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    دع سالب: منطقي = القيمة < 0.0;
    دع المطلق: ع32 = مطلق32(القيمة);
    لو (المطلق < 1.0) { لو (سالب) { أرجع -0.0; }; أرجع 0.0; };
    لو (المطلق >= 8388608.0) { أرجع القيمة; };
    دع الوحدة: متغير ع32 = 1.0;
    بينما ((الوحدة * 2.0) <= المطلق) { الوحدة := الوحدة * 2.0; }
    دع الباقي: متغير ع32 = المطلق;
    دع الصحيح: متغير ع32 = 0.0;
    بينما (الوحدة >= 1.0) {
        لو (الباقي >= الوحدة) { الصحيح := الصحيح + الوحدة; الباقي := الباقي - الوحدة; };
        الوحدة := الوحدة / 2.0;
    }
    لو (سالب) { أرجع -الصحيح; };
    أرجع الصحيح;
}
عام عرف أرضية32(القيمة: ع32): ع32 {
    دع الصحيح: ع32 = بتر32(القيمة);
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة) || (القيمة == الصحيح)) { أرجع الصحيح; };
    لو (القيمة < 0.0) { أرجع الصحيح - 1.0; };
    أرجع الصحيح;
}
عام عرف سقف32(القيمة: ع32): ع32 {
    دع الصحيح: ع32 = بتر32(القيمة);
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة) || (القيمة == الصحيح)) { أرجع الصحيح; };
    لو (القيمة > 0.0) { أرجع الصحيح + 1.0; };
    أرجع الصحيح;
}
عام عرف كسر32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (هل_لانهاية32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    أرجع القيمة - بتر32(القيمة);
}
عام عرف تقريب32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    لو (القيمة > 0.0) { أرجع أرضية32(القيمة + 0.5); };
    أرجع سقف32(القيمة - 0.5);
}
عام عرف باقي32(القيمة: ع32, المقسوم_عليه: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || ليس_رقما32(المقسوم_عليه) || (المقسوم_عليه == 0.0) || هل_لانهاية32(القيمة)) {
        دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر;
    };
    لو (هل_لانهاية32(المقسوم_عليه)) { أرجع القيمة; };
    دع سالب: منطقي = القيمة < 0.0;
    دع المتبقي: متغير ع32 = مطلق32(القيمة);
    دع المقسوم: ع32 = مطلق32(المقسوم_عليه);
    لو (المتبقي < المقسوم) { أرجع القيمة; };
    دع المقياس: متغير ع32 = المقسوم;
    بينما ((المقياس <= (المتبقي / 2.0)) && هل_منته32(المقياس * 2.0)) { المقياس := المقياس * 2.0; }
    بينما (المقياس >= المقسوم) {
        لو (المتبقي >= المقياس) { المتبقي := المتبقي - المقياس; };
        المقياس := المقياس / 2.0;
    }
    لو (سالب) { أرجع -المتبقي; };
    أرجع المتبقي;
}
عرف قيس_قوة2_32(القيمة: ع32, الأس: ع32): ع32 {
    دع الناتج: متغير ع32 = القيمة;
    دع ك: متغير ع32 = الأس;
    بينما (ك >= 64.0) { الناتج := الناتج * 1.8446744e19; ك := ك - 64.0; }
    لو (ك >= 32.0) { الناتج := الناتج * 4294967296.0; ك := ك - 32.0; };
    لو (ك >= 16.0) { الناتج := الناتج * 65536.0; ك := ك - 16.0; };
    لو (ك >= 8.0) { الناتج := الناتج * 256.0; ك := ك - 8.0; };
    لو (ك >= 4.0) { الناتج := الناتج * 16.0; ك := ك - 4.0; };
    لو (ك >= 2.0) { الناتج := الناتج * 4.0; ك := ك - 2.0; };
    لو (ك >= 1.0) { الناتج := الناتج * 2.0; };
    بينما (ك <= -64.0) { الناتج := الناتج / 1.8446744e19; ك := ك + 64.0; }
    لو (ك <= -32.0) { الناتج := الناتج / 4294967296.0; ك := ك + 32.0; };
    لو (ك <= -16.0) { الناتج := الناتج / 65536.0; ك := ك + 16.0; };
    لو (ك <= -8.0) { الناتج := الناتج / 256.0; ك := ك + 8.0; };
    لو (ك <= -4.0) { الناتج := الناتج / 16.0; ك := ك + 4.0; };
    لو (ك <= -2.0) { الناتج := الناتج / 4.0; ك := ك + 2.0; };
    لو (ك <= -1.0) { الناتج := الناتج / 2.0; };
    أرجع الناتج;
}

عام عرف أس32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (القيمة > 88.722839) { أرجع لانهاية32(); };
    لو (القيمة < -103.972084) { أرجع 0.0; };
    لو (القيمة == 0.0) { أرجع 1.0; };
    دع لوغ2: ع32 = 0.69314718056;
    دع ك: ع32 = تقريب32(القيمة / لوغ2);
    دع ر: ع32 = القيمة - (ك * لوغ2);
    دع المجموع: متغير ع32 = 1.0;
    دع الحد: متغير ع32 = 1.0;
    دع ن: متغير ع32 = 1.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 12) { الحد := الحد * ر / ن; المجموع := المجموع + الحد; ن := ن + 1.0; ت := ت + 1; }
    أرجع قيس_قوة2_32(المجموع, ك);
}
عام عرف أس_ناقص_واحد32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (مطلق32(القيمة) >= 0.5) { أرجع أس32(القيمة) - 1.0; };
    دع المجموع: متغير ع32 = القيمة;
    دع الحد: متغير ع32 = القيمة;
    دع ن: متغير ع32 = 2.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 12) { الحد := الحد * القيمة / ن; المجموع := المجموع + الحد; ن := ن + 1.0; ت := ت + 1; }
    أرجع المجموع;
}
عام عرف لوغاريتم32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (القيمة < 0.0) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    لو (القيمة == 0.0) { أرجع -لانهاية32(); };
    لو (هل_لانهاية32(القيمة)) { أرجع القيمة; };
    دع م: متغير ع32 = القيمة;
    دع ك: متغير ع32 = 0.0;
    لو (م >= 1.8446744e19) { م := م / 1.8446744e19; ك := ك + 64.0; };
    لو (م >= 4294967296.0) { م := م / 4294967296.0; ك := ك + 32.0; };
    لو (م >= 65536.0) { م := م / 65536.0; ك := ك + 16.0; };
    لو (م >= 256.0) { م := م / 256.0; ك := ك + 8.0; };
    لو (م >= 16.0) { م := م / 16.0; ك := ك + 4.0; };
    لو (م >= 4.0) { م := م / 4.0; ك := ك + 2.0; };
    لو (م >= 2.0) { م := م / 2.0; ك := ك + 1.0; };
    بينما (م < 5.4210109e-20) { م := م * 1.8446744e19; ك := ك - 64.0; }
    لو (م < 2.3283064e-10) { م := م * 4294967296.0; ك := ك - 32.0; };
    لو (م < 0.000015258789) { م := م * 65536.0; ك := ك - 16.0; };
    لو (م < 0.00390625) { م := م * 256.0; ك := ك - 8.0; };
    لو (م < 0.0625) { م := م * 16.0; ك := ك - 4.0; };
    لو (م < 0.25) { م := م * 4.0; ك := ك - 2.0; };
    لو (م < 0.5) { م := م * 2.0; ك := ك - 1.0; };
    لو (م < 1.0) { م := م * 2.0; ك := ك - 1.0; };
    دع بسط: ع32 = م - 1.0;
    دع مقام: ع32 = م + 1.0;
    دع ص: ع32 = بسط / مقام;
    دع ص2: ع32 = ص * ص;
    دع الحد: متغير ع32 = ص;
    دع المجموع: متغير ع32 = ص;
    دع المقام: متغير ع32 = 3.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 16) { الحد := الحد * ص2; المجموع := المجموع + (الحد / المقام); المقام := المقام + 2.0; ت := ت + 1; }
    أرجع (2.0 * المجموع) + (ك * 0.69314718056);
}
عام عرف لوغاريتم_واحد_زائد32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (القيمة < -1.0) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    لو (القيمة == -1.0) { أرجع -لانهاية32(); };
    لو (مطلق32(القيمة) >= 0.5) { أرجع لوغاريتم32(1.0 + القيمة); };
    دع ص: ع32 = القيمة / (2.0 + القيمة);
    دع ص2: ع32 = ص * ص;
    دع الحد: متغير ع32 = ص;
    دع المجموع: متغير ع32 = ص;
    دع المقام: متغير ع32 = 3.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 14) { الحد := الحد * ص2; المجموع := المجموع + (الحد / المقام); المقام := المقام + 2.0; ت := ت + 1; }
    أرجع 2.0 * المجموع;
}
عام عرف لوغاريتم2_32(القيمة: ع32): ع32 { أرجع لوغاريتم32(القيمة) / 0.69314718056; }
عام عرف لوغاريتم10_32(القيمة: ع32): ع32 { أرجع لوغاريتم32(القيمة) / 2.302585093; }
عام عرف هل_صحيح32(القيمة: ع32): منطقي { لو (!هل_منته32(القيمة)) { أرجع خطأ; }; أرجع بتر32(القيمة) == القيمة; }
عام عرف هل_صحيح_فردي32(القيمة: ع32): منطقي {
    لو (!هل_صحيح32(القيمة)) { أرجع خطأ; };
    دع المطلق: ع32 = مطلق32(القيمة);
    لو (المطلق >= 16777216.0) { أرجع خطأ; };
    أرجع باقي32(المطلق, 2.0) == 1.0;
}
عام عرف قوة32(الأساس: ع32, الأس: ع32): ع32 {
    لو (ليس_رقما32(الأساس) || ليس_رقما32(الأس)) {
        لو (الأس == 0.0) { أرجع 1.0; };
        دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر;
    };
    لو (الأس == 0.0 || الأساس == 1.0) { أرجع 1.0; };
    لو (الأساس == 0.0) { لو (الأس < 0.0) { أرجع لانهاية32(); }; أرجع 0.0; };
    لو (الأساس < 0.0) {
        لو (!هل_صحيح32(الأس)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
        دع المقدار: ع32 = أس32(الأس * لوغاريتم32(-الأساس));
        لو (هل_صحيح_فردي32(الأس)) { أرجع -المقدار; };
        أرجع المقدار;
    };
    أرجع أس32(الأس * لوغاريتم32(الأساس));
}
عرف قوس_سلسلة32(القيمة: ع32): ع32 {
    دع ز2: ع32 = القيمة * القيمة;
    دع الحد: متغير ع32 = القيمة;
    دع المجموع: متغير ع32 = القيمة;
    دع المقام: متغير ع32 = 3.0;
    دع أضف: متغير منطقي = خطأ;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 14) {
        الحد := الحد * ز2;
        لو (أضف) { المجموع := المجموع + (الحد / المقام); } وإلا { المجموع := المجموع - (الحد / المقام); };
        أضف := !أضف; المقام := المقام + 2.0; ت := ت + 1;
    }
    أرجع المجموع;
}
عام عرف قوس_ظل32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (هل_لانهاية32(القيمة)) { لو (القيمة < 0.0) { أرجع -(باي32() / 2.0); }; أرجع باي32() / 2.0; };
    دع سالب: منطقي = القيمة < 0.0;
    دع أ: ع32 = مطلق32(القيمة);
    دع الناتج: ع32;
    لو (أ > 2.41421356) { الناتج := (باي32() / 2.0) - قوس_سلسلة32(1.0 / أ); }
    وإلا لو (أ > 0.41421356) { الناتج := (باي32() / 4.0) + قوس_سلسلة32((أ - 1.0) / (أ + 1.0)); }
    وإلا { الناتج := قوس_سلسلة32(أ); };
    لو (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}
عام عرف قوس_ظل2_32(ص: ع32, س: ع32): ع32 {
    لو (ليس_رقما32(س) || ليس_رقما32(ص)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع لانهاية_س: منطقي = هل_لانهاية32(س);
    دع لانهاية_ص: منطقي = هل_لانهاية32(ص);
    لو (لانهاية_س && لانهاية_ص) {
        لو (س > 0.0) { لو (ص > 0.0) { أرجع باي32() / 4.0; }; أرجع -(باي32() / 4.0); };
        لو (ص > 0.0) { أرجع 3.0 * باي32() / 4.0; };
        أرجع -(3.0 * باي32() / 4.0);
    };
    لو (لانهاية_ص) { لو (ص > 0.0) { أرجع باي32() / 2.0; }; أرجع -(باي32() / 2.0); };
    لو (لانهاية_س) {
        لو (س > 0.0) { لو (ص < 0.0) { أرجع -0.0; }; أرجع 0.0; };
        لو (ص < 0.0) { أرجع -باي32(); };
        أرجع باي32();
    };
    لو (س > 0.0) { أرجع قوس_ظل32(ص / س); };
    لو (س < 0.0) { دع أ: ع32 = قوس_ظل32(ص / س); لو (ص >= 0.0) { أرجع أ + باي32(); }; أرجع أ - باي32(); };
    لو (ص > 0.0) { أرجع باي32() / 2.0; };
    لو (ص < 0.0) { أرجع -(باي32() / 2.0); };
    أرجع 0.0;
}
عام عرف قوس_جيب32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    لو (القيمة == 1.0) { أرجع باي32() / 2.0; };
    لو (القيمة == -1.0) { أرجع -(باي32() / 2.0); };
    أرجع قوس_ظل2_32(القيمة, جذر_تربيعي32((1.0 - القيمة) * (1.0 + القيمة)));
}
عام عرف قوس_جيب_تمام32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    أرجع قوس_ظل2_32(جذر_تربيعي32((1.0 - القيمة) * (1.0 + القيمة)), القيمة);
}
عام عرف جيب_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة)) { أرجع القيمة; };
    أرجع (أس32(القيمة) - أس32(-القيمة)) / 2.0;
}
عام عرف جيب_تمام_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    دع أ: ع32 = مطلق32(القيمة);
    لو (هل_لانهاية32(أ)) { أرجع لانهاية32(); };
    أرجع (أس32(أ) + أس32(-أ)) / 2.0;
}
عام عرف ظل_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (القيمة > 10.0) { أرجع 1.0; };
    لو (القيمة < -10.0) { أرجع -1.0; };
    دع هـ2: ع32 = أس32(2.0 * القيمة);
    أرجع (هـ2 - 1.0) / (هـ2 + 1.0);
}
عام عرف قوس_جيب_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || هل_لانهاية32(القيمة)) { أرجع القيمة; };
    دع سالب: منطقي = القيمة < 0.0;
    دع أ: ع32 = مطلق32(القيمة);
    دع الناتج: ع32;
    لو (أ > 1.0e18) { الناتج := لوغاريتم32(أ) + 0.69314718056; }
    وإلا { الناتج := لوغاريتم32(أ + جذر_تربيعي32((أ * أ) + 1.0)); };
    لو (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}
عام عرف قوس_جيب_تمام_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || (القيمة < 1.0)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    لو (هل_لانهاية32(القيمة)) { أرجع القيمة; };
    لو (القيمة > 1.0e18) { أرجع لوغاريتم32(القيمة) + 0.69314718056; };
    أرجع لوغاريتم32(القيمة + جذر_تربيعي32((القيمة - 1.0) * (القيمة + 1.0)));
}
عام عرف قوس_ظل_زائدي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    لو (القيمة == 1.0) { أرجع لانهاية32(); };
    لو (القيمة == -1.0) { أرجع -لانهاية32(); };
    أرجع 0.5 * لوغاريتم_واحد_زائد32((2.0 * القيمة) / (1.0 - القيمة));
}
عرف جيب_سلسلة32(الزاوية: ع32): ع32 {
    دع ز2: ع32 = الزاوية * الزاوية;
    دع الحد: متغير ع32 = الزاوية;
    دع المجموع: متغير ع32 = الزاوية;
    دع ن: متغير ع32 = 2.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 6) { الحد := -الحد * ز2 / (ن * (ن + 1.0)); المجموع := المجموع + الحد; ن := ن + 2.0; ت := ت + 1; }
    أرجع المجموع;
}
عرف جيب_تمام_سلسلة32(الزاوية: ع32): ع32 {
    دع ز2: ع32 = الزاوية * الزاوية;
    دع الحد: متغير ع32 = 1.0;
    دع المجموع: متغير ع32 = 1.0;
    دع ن: متغير ع32 = 1.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 7) { الحد := -الحد * ز2 / (ن * (ن + 1.0)); المجموع := المجموع + الحد; ن := ن + 2.0; ت := ت + 1; }
    أرجع المجموع;
}
عام عرف جيب_باي32(القيمة: ع32): ع32 {
    لو (!هل_منته32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع سالب: منطقي = القيمة < 0.0;
    دع ر: متغير ع32 = باقي32(مطلق32(القيمة), 2.0);
    دع طور_سالب: متغير منطقي = خطأ;
    لو (ر > 1.0) { ر := ر - 1.0; طور_سالب := صواب; };
    لو (ر > 0.5) { ر := 1.0 - ر; };
    دع الناتج: متغير ع32 = جيب_سلسلة32(ر * باي32());
    لو (طور_سالب) { الناتج := -الناتج; };
    لو (سالب) { الناتج := -الناتج; };
    أرجع الناتج;
}
عام عرف جيب_تمام_باي32(القيمة: ع32): ع32 {
    لو (!هل_منته32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع ر: متغير ع32 = باقي32(مطلق32(القيمة), 2.0);
    لو (ر > 1.0) { ر := 2.0 - ر; };
    دع سالب: متغير منطقي = خطأ;
    لو (ر > 0.5) { ر := 1.0 - ر; سالب := صواب; };
    دع الناتج: ع32 = جيب_تمام_سلسلة32(ر * باي32());
    لو (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}
عام عرف ظل_باي32(القيمة: ع32): ع32 {
    لو (!هل_منته32(القيمة)) { دع الصفر: ع32 = 0.0; أرجع الصفر / الصفر; };
    دع ر: ع32 = باقي32(مطلق32(القيمة), 1.0);
    لو (ر == 0.5) { دع اللانهاية: ع32 = لانهاية32(); لو (القيمة < 0.0) { أرجع -اللانهاية; }; أرجع اللانهاية; };
    أرجع جيب_باي32(القيمة) / جيب_تمام_باي32(القيمة);
}

