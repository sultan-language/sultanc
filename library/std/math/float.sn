    // holds the value's bits, الكسر is F (52 or 23), الانحياز the exponent
    // bias and بت_الإشارة the sign bit.
    عرف قرب_بتات_إلى_صحيح(البتات: ط64, الوضع: طبيعي, الكسر: ط64, الانحياز: ط64, بت_الإشارة: ط64): ط64 {
        دع واحد: ط64 = 1;
        دع الحقل: ط64 = (البتات >> الكسر) & ((الانحياز * 2) + 1);
        لو (الحقل >= الانحياز + الكسر) { أرجع البتات; };
        دع الإشارة: ط64 = البتات & بت_الإشارة;
        دع سالب: منطقي = الإشارة != 0;
        دع الواحد: ط64 = الإشارة | (الانحياز << الكسر);
