        دع الإزاحة: ط64 = الكسر - (الحقل - الانحياز);
        دع الوحدة: ط64 = واحد << الإزاحة;
        دع الجزء: ط64 = البتات & (الوحدة - 1);
        لو (الجزء == 0) { أرجع البتات; };
        دع المبتور: ط64 = البتات - الجزء;
        دع ابتعد: متغير منطقي = خطأ;
        لو (الوضع == 1) { ابتعد := سالب; };
        لو (الوضع == 2) { ابتعد := !سالب; };
        لو (الوضع == 3) {
            دع النصف: ط64 = الوحدة >> 1;
            ابتعد := الجزء > النصف || (الجزء == النصف && (المبتور & الوحدة) != 0);
        };
        لو (ابتعد) { أرجع المبتور + الوحدة; };
        أرجع المبتور;
    }
    عرف قرب64_إلى_صحيح(القيمة: ع64, الوضع: طبيعي): ع64 {
        دع واحد: ط64 = 1;
        أرجع ع64_من_بتات_بدائيا(قرب_بتات_إلى_صحيح(بتات_ع64_بدائيا(القيمة), الوضع, 52, 1023, واحد << 63));
