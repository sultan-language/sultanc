            لو ((البتات & ~بت_الإشارة) == 0) { أرجع البتات; };
            لو (الوضع == 1 && سالب) { أرجع الواحد; };
            لو (الوضع == 2 && !سالب) { أرجع الواحد; };
            لو (الوضع == 3 && الحقل + 1 == الانحياز && (البتات & ((واحد << الكسر) - 1)) != 0) { أرجع الواحد; };
            أرجع الإشارة;
