// Pure floating-point helpers built only from SultanC's canonical f32/f64 arithmetic.
// The elementary layer is deterministic and host-libm independent. Ordinary sin/cos/tan
// remain intentionally absent until full-range argument reduction can use canonical float-bit
// access or libm primitives; sinpi/cospi/tanpi are provided because their reduction is exact
// from the representable input itself.
//
// sqrt, abs, copysign, minimum and maximum are the compiler's float primitives
// (docs/TYPE_SYSTEM.md, "Float operations"): one instruction on every target
// (SQRTSD, FSQRT, f64.sqrt, llvm.sqrt.*), as Rust's f64::sqrt. floor, ceil,
// trunc and round-ties-even are primitives where the instruction set has them
// (AArch64 FRINT*, WebAssembly f64.floor ...); elsewhere (baseline x86-64 has
// no ROUNDSD) they are the exact bit-level forms below, as Rust's libm. mul_add
// is the FMADD primitive on AArch64, RISC-V, POWER, z/Architecture and
// LoongArch, and an exact integer emulation elsewhere. Every form gives the
// same result on every target and in the interpreter.
مرادف جذر_عائم_بدائيا = بدائي_جذر_تربيعي_عائم;
مرادف مطلق_عائم_بدائيا = بدائي_قيمة_مطلقة_عائمة;
مرادف أرضية_عائمة_بدائيا = بدائي_أرضية_عائمة;
مرادف سقف_عائم_بدائيا = بدائي_سقف_عائم;
مرادف بتر_عائم_بدائيا = بدائي_بتر_عائم;
مرادف تقريب_زوجي_عائم_بدائيا = بدائي_تقريب_زوجي_عائم;
مرادف أدنى_عائم_بدائيا = بدائي_أدنى_عائم;
مرادف أقصى_عائم_بدائيا = بدائي_أقصى_عائم;
مرادف نسخ_إشارة_عائمة_بدائيا = بدائي_نسخ_إشارة_عائمة;
مرادف ضرب_جمع_مدمج_عائم_بدائيا = بدائي_ضرب_جمع_مدمج_عائم;
مرادف بدائي_جمع_ملتف_عائم = بدائي_جمع_ملتف;
مرادف بدائي_طرح_ملتف_عائم = بدائي_طرح_ملتف;

// The exact integer form of fused multiply-add on float bits (F fraction
// bits, the exponent bias, the sign bit), as Berkeley SoftFloat's mulAdd and
// the interpreter's (compiler/interpreter/operations/float_software.sn): the
// exact product of the significands (up to 2F + 2 bits) and the addend are
// placed with their top bit at bit 125 of a 128-bit integer, the one with the
// smaller exponent is shifted right keeping a sticky bit, the two are added
// or subtracted exactly, and the sum is rounded once to nearest, ties to even.
نوع عدد_مزدوج_عائم = {
    عالي: ط64,
    منخفض: ط64
};

عرف قناع_بتات_عائم(العدد: ط64): ط64 {
    لو (العدد >= 64) { أرجع ~(0 مثل ط64); };
    أرجع ((1 مثل ط64) << العدد) - 1;
}

عرف ازح_يسارا_مقنعا_عائم(القيمة: ط64, الإزاحة: ط64): ط64 {
    لو (الإزاحة == 0) { أرجع القيمة; };
    لو (الإزاحة >= 64) { أرجع 0; };
    أرجع (القيمة & قناع_بتات_عائم(64 - الإزاحة)) << الإزاحة;
}

عرف طول_بتات_مزدوج_عائم(القيمة: عدد_مزدوج_عائم): ط64 {
    دع الباقي: متغير ط64 = القيمة.منخفض;
    دع الأساس: متغير ط64 = 0;
    لو (القيمة.عالي != 0) { الباقي := القيمة.عالي; الأساس := 64; };
    دع الطول_: متغير ط64 = 0;
    طالما (الباقي != 0) { الطول_ := الطول_ + 1; الباقي := الباقي >> 1; }
    لو (الطول_ == 0) { أرجع 0; };
    أرجع الأساس + الطول_;
}

عرف ازح_مزدوجا_يسارا_عائم(القيمة: عدد_مزدوج_عائم, الإزاحة: ط64): عدد_مزدوج_عائم {
    لو (الإزاحة == 0) { أرجع القيمة; };
    لو (الإزاحة >= 64) {
        دع الناتج: عدد_مزدوج_عائم = { عالي: ازح_يسارا_مقنعا_عائم(القيمة.منخفض, الإزاحة - 64), منخفض: 0 };
        أرجع الناتج;
    };
    دع الناتج: عدد_مزدوج_عائم = {
        عالي: ازح_يسارا_مقنعا_عائم(القيمة.عالي, الإزاحة) | (القيمة.منخفض >> (64 - الإزاحة)),
        منخفض: ازح_يسارا_مقنعا_عائم(القيمة.منخفض, الإزاحة)
    };
    أرجع الناتج;
}

// Right shift; any 1 bit shifted out sets bit 0.
عرف ازح_مزدوجا_يمينا_بلزج_عائم(القيمة: عدد_مزدوج_عائم, الإزاحة: ط64): عدد_مزدوج_عائم {
    لو (الإزاحة == 0) { أرجع القيمة; };
    لو (الإزاحة >= 128) {
        دع اللزج: متغير ط64 = 0;
        لو (القيمة.عالي != 0 || القيمة.منخفض != 0) { اللزج := 1; };
        دع الناتج: عدد_مزدوج_عائم = { عالي: 0, منخفض: اللزج };
        أرجع الناتج;
    };
    دع العالي: متغير ط64 = 0;
    دع المنخفض: متغير ط64 = 0;
    دع الضائع: متغير منطقي = خطأ;
    لو (الإزاحة >= 64) {
        دع الباقي: ط64 = الإزاحة - 64;
        المنخفض := القيمة.عالي >> الباقي;
        الضائع := القيمة.منخفض != 0 || (القيمة.عالي & قناع_بتات_عائم(الباقي)) != 0;
    } وإلا {
        العالي := القيمة.عالي >> الإزاحة;
        المنخفض := (القيمة.منخفض >> الإزاحة) | ازح_يسارا_مقنعا_عائم(القيمة.عالي, 64 - الإزاحة);
        الضائع := (القيمة.منخفض & قناع_بتات_عائم(الإزاحة)) != 0;
    };
    لو (الضائع) { المنخفض := المنخفض | 1; };
    دع الناتج: عدد_مزدوج_عائم = { عالي: العالي, منخفض: المنخفض };
    أرجع الناتج;
}

// The 128-bit product of two values below 2^64, from 32-bit halves.
عرف اضرب_مزدوجا_عائم(أ: ط64, ب: ط64): عدد_مزدوج_عائم {
    دع النصف: ط64 = قناع_بتات_عائم(32);
    دع أ_م: ط64 = أ & النصف;
    دع أ_ع: ط64 = أ >> 32;
    دع ب_م: ط64 = ب & النصف;
    دع ب_ع: ط64 = ب >> 32;
    دع م_م: ط64 = أ_م * ب_م;
    دع ع_م: ط64 = أ_ع * ب_م;
    دع م_ع: ط64 = أ_م * ب_ع;
    دع ع_ع: ط64 = أ_ع * ب_ع;
    دع الوسط: ط64 = (م_م >> 32) + (ع_م & النصف) + (م_ع & النصف);
    دع الناتج: عدد_مزدوج_عائم = {
        عالي: ع_ع + (ع_م >> 32) + (م_ع >> 32) + (الوسط >> 32),
        منخفض: (م_م & النصف) | ((الوسط & النصف) << 32)
    };
    أرجع الناتج;
}

عرف اجمع_مزدوجين_عائم(أ: عدد_مزدوج_عائم, ب: عدد_مزدوج_عائم): عدد_مزدوج_عائم {
    دع المنخفض: ط64 = بدائي_جمع_ملتف_عائم(أ.منخفض, ب.منخفض);
    دع حمل: متغير ط64 = 0;
    لو (المنخفض < أ.منخفض) { حمل := 1; };
    دع الناتج: عدد_مزدوج_عائم = { عالي: أ.عالي + ب.عالي + حمل, منخفض: المنخفض };
    أرجع الناتج;
}

// أ - ب for أ >= ب.
عرف اطرح_مزدوجين_عائم(أ: عدد_مزدوج_عائم, ب: عدد_مزدوج_عائم): عدد_مزدوج_عائم {
    دع استلاف: متغير ط64 = 0;
    لو (أ.منخفض < ب.منخفض) { استلاف := 1; };
    دع الناتج: عدد_مزدوج_عائم = { عالي: أ.عالي - ب.عالي - استلاف, منخفض: بدائي_طرح_ملتف_عائم(أ.منخفض, ب.منخفض) };
    أرجع الناتج;
}

عرف أصغر_مزدوج_عائم(أ: عدد_مزدوج_عائم, ب: عدد_مزدوج_عائم): منطقي {
    لو (أ.عالي != ب.عالي) { أرجع أ.عالي < ب.عالي; };
    أرجع أ.منخفض < ب.منخفض;
}

// The significand (with the implicit bit) and exponent of a finite nonzero
// float, normalized so that value = significand * 2^(exponent - F).
نوع مكونات_عائم_بتات = {
    الدلالة: ط64,
    الأس: عدد
};

عرف فك_بتات_عائم(البتات: ط64, الكسر: ط64, الانحياز: ط64): مكونات_عائم_بتات {
    دع الحقل: ط64 = (البتات >> الكسر) & ((الانحياز * 2) + 1);
    دع الضمني: ط64 = (1 مثل ط64) << الكسر;
    دع الدلالة: متغير ط64 = البتات & (الضمني - 1);
    دع الأس: متغير عدد = 1 - (الانحياز مثل عدد);
    لو (الحقل != 0) {
        الدلالة := الدلالة | الضمني;
        الأس := (الحقل مثل عدد) - (الانحياز مثل عدد);
    };
    طالما (الدلالة < الضمني) { الدلالة := الدلالة << 1; الأس := الأس - 1; }
    دع الناتج: مكونات_عائم_بتات = { الدلالة: الدلالة, الأس: الأس };
    أرجع الناتج;
}

// Rounds sig * 2^(exp - F - 3) (sig below 2^62, its low bit sticky) to the
// nearest float, ties to even, with overflow to infinity and gradual
// underflow; as the interpreter's packer.
عرف احزم_بتات_عائم(سالب: منطقي, الدلالة_: ط64, الأس_: عدد, الكسر: ط64, الانحياز: ط64, بت_الإشارة: ط64): ط64 {
    دع الدلالة: متغير ط64 = الدلالة_;
    دع الأس: متغير عدد = الأس_;
    دع الإشارة: متغير ط64 = 0;
    لو (سالب) { الإشارة := بت_الإشارة; };
    لو (الدلالة == 0) { أرجع الإشارة; };
    دع الهدف_: ط64 = (1 مثل ط64) << (الكسر + 3);
    طالما (الدلالة >= الهدف_ * 2) {
        الدلالة := (الدلالة >> 1) | (الدلالة & 1);
        الأس := الأس + 1;
    }
    دع أدنى_أس: عدد = 1 - (الانحياز مثل عدد);
    طالما (الدلالة < الهدف_ && الأس > أدنى_أس) { الدلالة := الدلالة << 1; الأس := الأس - 1; }
    لو (الأس < أدنى_أس) {
        دع الفرق: ط64 = (أدنى_أس - الأس) مثل ط64;
        لو (الفرق >= 64) {
            لو (الدلالة != 0) { الدلالة := 1; };
        } وإلا {
            دع الضائع: ط64 = الدلالة & قناع_بتات_عائم(الفرق);
            الدلالة := الدلالة >> الفرق;
            لو (الضائع != 0) { الدلالة := الدلالة | 1; };
        };
        الأس := أدنى_أس;
    };
    دع الرئيسي: متغير ط64 = الدلالة >> 3;
    دع الباقي: ط64 = الدلالة & 7;
    لو (الباقي > 4 || (الباقي == 4 && (الرئيسي & 1) != 0)) { الرئيسي := الرئيسي + 1; };
    لو (الرئيسي >= ((1 مثل ط64) << (الكسر + 1))) { الرئيسي := الرئيسي >> 1; الأس := الأس + 1; };
    دع أعلى_أس: عدد = (الانحياز مثل عدد);
    لو (الأس > أعلى_أس) { أرجع الإشارة | ((((الانحياز * 2) + 1)) << الكسر); };
    دع الضمني: ط64 = (1 مثل ط64) << الكسر;
    لو (الأس == أدنى_أس && الرئيسي < الضمني) { أرجع الإشارة | الرئيسي; };
    دع الحقل: ط64 = (الأس + (الانحياز مثل عدد)) مثل ط64;
    أرجع الإشارة | (الحقل << الكسر) | (الرئيسي - الضمني);
}

عرف ضرب_جمع_بتات(أ: ط64, ب: ط64, ج: ط64, الكسر: ط64, الانحياز: ط64, بت_الإشارة: ط64): ط64 {
    دع واحد: ط64 = 1;
    دع قناع_الأس: ط64 = (الانحياز * 2) + 1;
    دع قناع_القدر: ط64 = بت_الإشارة - 1;
    دع اللانهاية: ط64 = قناع_الأس << الكسر;
    دع النان: ط64 = اللانهاية | (واحد << (الكسر - 1));
    دع قدر_أ: ط64 = أ & قناع_القدر;
    دع قدر_ب: ط64 = ب & قناع_القدر;
    دع قدر_ج: ط64 = ج & قناع_القدر;
    لو (قدر_أ > اللانهاية) { أرجع أ | (واحد << (الكسر - 1)); };
    لو (قدر_ب > اللانهاية) { أرجع ب | (واحد << (الكسر - 1)); };
    لو ((قدر_أ == اللانهاية && قدر_ب == 0) || (قدر_ب == اللانهاية && قدر_أ == 0)) { أرجع النان; };
    لو (قدر_ج > اللانهاية) { أرجع ج | (واحد << (الكسر - 1)); };
    دع إشارة_الضرب: ط64 = (أ ^ ب) & بت_الإشارة;
    لو (قدر_أ == اللانهاية || قدر_ب == اللانهاية) {
        لو (قدر_ج == اللانهاية && (ج & بت_الإشارة) != إشارة_الضرب) { أرجع النان; };
        أرجع إشارة_الضرب | اللانهاية;
    };
    لو (قدر_ج == اللانهاية) { أرجع ج; };
    لو (قدر_أ == 0 || قدر_ب == 0) {
        // An exact zero product: ±0 + c, where c == ±0 gives -0 only when
        // both zeros are negative.
        لو (قدر_ج != 0) { أرجع ج; };
        أرجع ج & إشارة_الضرب;
    };
    دع ك: عدد = الكسر مثل عدد;
    دع م_أ: مكونات_عائم_بتات = فك_بتات_عائم(أ, الكسر, الانحياز);
    دع م_ب: مكونات_عائم_بتات = فك_بتات_عائم(ب, الكسر, الانحياز);
    دع الضرب: عدد_مزدوج_عائم = اضرب_مزدوجا_عائم(م_أ.الدلالة, م_ب.الدلالة);
    دع إزاحة_الضرب: ط64 = 126 - طول_بتات_مزدوج_عائم(الضرب);
    دع الأول: متغير عدد_مزدوج_عائم = ازح_مزدوجا_يسارا_عائم(الضرب, إزاحة_الضرب);
    دع أس_الضرب: عدد = م_أ.الأس + م_ب.الأس - (2 * ك) - (إزاحة_الضرب مثل عدد);
    لو (قدر_ج == 0) {
        دع الطول_: ط64 = طول_بتات_مزدوج_عائم(الأول);
        دع المقصور: عدد_مزدوج_عائم = ازح_مزدوجا_يمينا_بلزج_عائم(الأول, الطول_ - 62);
        أرجع احزم_بتات_عائم(إشارة_الضرب != 0, المقصور.منخفض, أس_الضرب + ((الطول_ - 62) مثل عدد) + ك + 3,
            الكسر, الانحياز, بت_الإشارة);
    };
    دع م_ج: مكونات_عائم_بتات = فك_بتات_عائم(ج, الكسر, الانحياز);
    دع الجمع_الخام: عدد_مزدوج_عائم = { عالي: 0, منخفض: م_ج.الدلالة };
    دع إزاحة_الجمع: ط64 = 126 - طول_بتات_مزدوج_عائم(الجمع_الخام);
    دع الثاني: متغير عدد_مزدوج_عائم = ازح_مزدوجا_يسارا_عائم(الجمع_الخام, إزاحة_الجمع);
    دع أس_الجمع: عدد = م_ج.الأس - ك - (إزاحة_الجمع مثل عدد);
    دع الأس: متغير عدد = أس_الضرب;
    لو (أس_الضرب >= أس_الجمع) {
        الثاني := ازح_مزدوجا_يمينا_بلزج_عائم(الثاني, (أس_الضرب - أس_الجمع) مثل ط64);
    } وإلا {
        الأول := ازح_مزدوجا_يمينا_بلزج_عائم(الأول, (أس_الجمع - أس_الضرب) مثل ط64);
        الأس := أس_الجمع;
    };
    دع سالب_الضرب: منطقي = إشارة_الضرب != 0;
    دع سالب_الجمع: منطقي = (ج & بت_الإشارة) != 0;
    دع المجموع: متغير عدد_مزدوج_عائم = { عالي: 0, منخفض: 0 };
    دع سالب: متغير منطقي = سالب_الضرب;
    لو (سالب_الضرب == سالب_الجمع) {
        المجموع := اجمع_مزدوجين_عائم(الأول, الثاني);
    } وإلا لو (أصغر_مزدوج_عائم(الأول, الثاني)) {
        المجموع := اطرح_مزدوجين_عائم(الثاني, الأول);
        سالب := سالب_الجمع;
    } وإلا {
        المجموع := اطرح_مزدوجين_عائم(الأول, الثاني);
    };
    لو (المجموع.عالي == 0 && المجموع.منخفض == 0) { أرجع 0; };
    دع الطول_: ط64 = طول_بتات_مزدوج_عائم(المجموع);
    لو (الطول_ > 62) {
        المجموع := ازح_مزدوجا_يمينا_بلزج_عائم(المجموع, الطول_ - 62);
        الأس := الأس + ((الطول_ - 62) مثل عدد);
    };
    أرجع احزم_بتات_عائم(سالب, المجموع.منخفض, الأس + ك + 3, الكسر, الانحياز, بت_الإشارة);
}

عام عرف ليس_رقما64(القيمة: ع64): منطقي { أرجع القيمة != القيمة; }
عام عرف لانهاية64(): ع64 {
    دع الواحد: ع64 = 1.0;
    دع الصفر: ع64 = 0.0;
    أرجع الواحد / الصفر;
}
عام عرف هل_لانهاية64(القيمة: ع64): منطقي {
    دع اللانهاية: ع64 = لانهاية64();
    أرجع (القيمة == اللانهاية) || (القيمة == -اللانهاية);
}
عام عرف هل_منته64(القيمة: ع64): منطقي {
    أرجع !ليس_رقما64(القيمة) && !هل_لانهاية64(القيمة);
}
عام عرف مطلق64(القيمة: ع64): ع64 { أرجع مطلق_عائم_بدائيا(القيمة); }
// IEEE 754-2019 minimum/maximum: a NaN operand gives a NaN, and -0 < +0.
عام عرف أصغر64(أ: ع64, ب: ع64): ع64 { أرجع أدنى_عائم_بدائيا(أ, ب); }
عام عرف أكبر64(أ: ع64, ب: ع64): ع64 { أرجع أقصى_عائم_بدائيا(أ, ب); }
// The magnitude of القيمة with the sign of الإشارة (also for NaN and zeros).
عام عرف نسخ_إشارة64(القيمة: ع64, الإشارة: ع64): ع64 { أرجع نسخ_إشارة_عائمة_بدائيا(القيمة, الإشارة); }
عام عرف قيد64(القيمة: ع64, الأدنى: ع64, الأعلى: ع64): اختياري ع64 {
    لو (ليس_رقما64(القيمة) || ليس_رقما64(الأدنى) || ليس_رقما64(الأعلى)) { أرجع اختياري.لا_شيء(); };
    لو (الأدنى > الأعلى) { أرجع اختياري.لا_شيء(); };
    لو (القيمة < الأدنى) { أرجع اختياري.موجود(الأدنى); };
    لو (القيمة > الأعلى) { أرجع اختياري.موجود(الأعلى); };
    أرجع اختياري.موجود(القيمة);
}
عام عرف مربع64(القيمة: ع64): ع64 { أرجع القيمة * القيمة; }
عام عرف قريب64(أ: ع64, ب: ع64, سماح_مطلق: ع64, سماح_نسبي: ع64): منطقي {
    لو (!هل_منته64(سماح_مطلق) || !هل_منته64(سماح_نسبي)) { أرجع خطأ; };
    لو ((سماح_مطلق < 0.0) || (سماح_نسبي < 0.0)) { أرجع خطأ; };
    لو (ليس_رقما64(أ) || ليس_رقما64(ب)) { أرجع خطأ; };
    لو (أ == ب) { أرجع صواب; };
    لو (هل_لانهاية64(أ) || هل_لانهاية64(ب)) { أرجع خطأ; };
    دع الفرق: ع64 = مطلق64(أ - ب);
    لو (الفرق <= سماح_مطلق) { أرجع صواب; };
    دع المقياس: ع64 = أكبر64(مطلق64(أ), مطلق64(ب));
    أرجع الفرق <= (سماح_نسبي * المقياس);
}

// The correctly rounded square root (IEEE 754 squareRoot): -0 gives -0,
// a negative value or NaN gives NaN, +inf gives +inf.
عام عرف جذر_تربيعي64(القيمة: ع64): ع64 { أرجع جذر_عائم_بدائيا(القيمة); }

عام عرف وتر64(أ: ع64, ب: ع64): ع64 {
    دع س: ع64 = مطلق64(أ);
    دع ص: ع64 = مطلق64(ب);
    لو (هل_لانهاية64(س) || هل_لانهاية64(ص)) { أرجع لانهاية64(); };
    لو (ليس_رقما64(س)) { أرجع س; };
    لو (ليس_رقما64(ص)) { أرجع ص; };
    دع الأكبر: ع64 = أكبر64(س, ص);
    دع الأصغر: ع64 = أصغر64(س, ص);
    لو (الأكبر == 0.0) { أرجع 0.0; };
    دع النسبة: ع64 = الأصغر / الأكبر;
    أرجع الأكبر * جذر_تربيعي64(1.0 + (النسبة * النسبة));
}

عام عرف قوة_صحيحة64(الأساس: ع64, الأس: عدد): ع64 {
    لو (الأس == 0) { أرجع 1.0; };
    دع سالب: منطقي = الأس < 0;
    دع المقدار: طبيعي;
    لو (سالب) {
        // -(INT_MIN) is not representable; shift before negating.
        دع المزاح: عدد = -(الأس + 1);
        المقدار := (المزاح مثل طبيعي) + 1;
    }
    وإلا { المقدار := الأس مثل طبيعي; };

    دع الناتج: متغير ع64 = 1.0;
    دع القوة: متغير ع64 = الأساس;
    دع المتبقي: متغير طبيعي = المقدار;
    طالما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) { الناتج := الناتج * القوة; };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) { القوة := القوة * القوة; };
    }
    لو (سالب) { أرجع 1.0 / الناتج; };
    أرجع الناتج;
}

عام عرف امزج64(أ: ع64, ب: ع64, النسبة: ع64): ع64 {
    أرجع أ + ((ب - أ) * النسبة);
}
عام عرف درجات_إلى_راديان64(الدرجات: ع64): ع64 {
    أرجع الدرجات * (3.141592653589793238462643383279502884 / 180.0);
}
عام عرف راديان_إلى_درجات64(الراديان: ع64): ع64 {
    أرجع الراديان * (180.0 / 3.141592653589793238462643383279502884);
}
عام عرف باي64(): ع64 { أرجع 3.141592653589793238462643383279502884; }
عام عرف تاو64(): ع64 { أرجع 6.283185307179586476925286766559005768; }
عام عرف هـ64(): ع64 { أرجع 2.718281828459045235360287471352662498; }
عام عرف جذر2_64(): ع64 { أرجع 1.414213562373095048801688724209698079; }

// f32 counterparts for the scalar helpers most commonly needed without widening.
عام عرف ليس_رقما32(القيمة: ع32): منطقي { أرجع القيمة != القيمة; }
عام عرف لانهاية32(): ع32 {
    دع الواحد: ع32 = 1.0;
    دع الصفر: ع32 = 0.0;
    أرجع الواحد / الصفر;
}
عام عرف هل_لانهاية32(القيمة: ع32): منطقي {
    دع اللانهاية: ع32 = لانهاية32();
    أرجع (القيمة == اللانهاية) || (القيمة == -اللانهاية);
}
عام عرف هل_منته32(القيمة: ع32): منطقي { أرجع !ليس_رقما32(القيمة) && !هل_لانهاية32(القيمة); }
عام عرف مطلق32(القيمة: ع32): ع32 { أرجع مطلق_عائم_بدائيا(القيمة); }
عام عرف جذر_تربيعي32(القيمة: ع32): ع32 { أرجع جذر_عائم_بدائيا(القيمة); }
عام عرف نسخ_إشارة32(القيمة: ع32, الإشارة: ع32): ع32 { أرجع نسخ_إشارة_عائمة_بدائيا(القيمة, الإشارة); }

عام مرادف is_nan_f64 = ليس_رقما64;
عام مرادف infinity_f64 = لانهاية64;
عام مرادف is_infinite_f64 = هل_لانهاية64;
عام مرادف is_finite_f64 = هل_منته64;
عام مرادف abs_f64 = مطلق64;
عام مرادف min_f64 = أصغر64;
عام مرادف max_f64 = أكبر64;
عام مرادف clamp_f64 = قيد64;
عام مرادف square_f64 = مربع64;
عام مرادف approx_eq_f64 = قريب64;
عام مرادف sqrt_f64 = جذر_تربيعي64;
عام مرادف hypot_f64 = وتر64;
عام مرادف powi_f64 = قوة_صحيحة64;
عام مرادف lerp_f64 = امزج64;
عام مرادف radians_f64 = درجات_إلى_راديان64;
عام مرادف degrees_f64 = راديان_إلى_درجات64;
عام مرادف pi_f64 = باي64;
عام مرادف tau_f64 = تاو64;
عام مرادف e_f64 = هـ64;
عام مرادف sqrt2_f64 = جذر2_64;
عام مرادف is_nan_f32 = ليس_رقما32;
عام مرادف infinity_f32 = لانهاية32;
عام مرادف is_infinite_f32 = هل_لانهاية32;
عام مرادف is_finite_f32 = هل_منته32;
عام مرادف abs_f32 = مطلق32;
عام مرادف sqrt_f32 = جذر_تربيعي32;
عام مرادف copysign_f64 = نسخ_إشارة64;
عام مرادف copysign_f32 = نسخ_إشارة32;

// Aggregate/statistical helpers for f64 vectors. Empty inputs return none where
// a mathematically defined sample/value is required.
عام عرف مجموع64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع المجموع: متغير ع64 = 0.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النسخة) مثل طبيعي)) {
        المجموع := المجموع + النسخة[الموضع];
        الموضع := الموضع + 1;
    }
    أرجع المجموع;
}

عام عرف متوسط64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختياري.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النسخة) مثل طبيعي)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(الوسط);
}

عام عرف تباين_مجتمع64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختياري.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع مجموع_المربعات: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النسخة) مثل طبيعي)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        دع الفرق_بعد: ع64 = النسخة[الموضع] - الوسط;
        مجموع_المربعات := مجموع_المربعات + (الفرق * الفرق_بعد);
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(مجموع_المربعات / العدد);
}

عام عرف تباين_عينة64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) < 2) { أرجع اختياري.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع مجموع_المربعات: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النسخة) مثل طبيعي)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        دع الفرق_بعد: ع64 = النسخة[الموضع] - الوسط;
        مجموع_المربعات := مجموع_المربعات + (الفرق * الفرق_بعد);
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(مجموع_المربعات / (العدد - 1.0));
}

عام عرف انحراف_معياري_مجتمع64(القيم: &متجه ع64): اختياري ع64 {
    طابق تباين_مجتمع64(القيم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(جذر_تربيعي64(القيمة)); };
}

عام عرف انحراف_معياري_عينة64(القيم: &متجه ع64): اختياري ع64 {
    طابق تباين_عينة64(القيم) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(جذر_تربيعي64(القيمة)); };
}

عام عرف حاصل_ضرب_نقطي64(أ: &متجه ع64, ب: &متجه ع64): اختياري ع64 {
    دع س: متجه ع64 = *أ;
    دع ص: متجه ع64 = *ب;
    لو (الطول(س) != الطول(ص)) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير ع64 = 0.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(س) مثل طبيعي)) {
        الناتج := الناتج + (س[الموضع] * ص[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عام عرف معيار2_64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع المقياس: متغير ع64 = 0.0;
    دع مجموع_مقيس: متغير ع64 = 1.0;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النسخة) مثل طبيعي)) {
        دع القيمة: ع64 = مطلق64(النسخة[الموضع]);
        لو (ليس_رقما64(القيمة)) { أرجع القيمة; };
        لو (هل_لانهاية64(القيمة)) { أرجع القيمة; };
        لو (القيمة != 0.0) {
            لو (المقياس < القيمة) {
                دع النسبة: ع64 = المقياس / القيمة;
                مجموع_مقيس := 1.0 + (مجموع_مقيس * النسبة * النسبة);
                المقياس := القيمة;
            }
            وإلا {
                دع النسبة: ع64 = القيمة / المقياس;
                مجموع_مقيس := مجموع_مقيس + (النسبة * النسبة);
            };
        };
        الموضع := الموضع + 1;
    }
    لو (المقياس == 0.0) { أرجع 0.0; };
    أرجع المقياس * جذر_تربيعي64(مجموع_مقيس);
}

عام مرادف sum_f64 = مجموع64;
عام مرادف mean_f64 = متوسط64;
عام مرادف variance_population_f64 = تباين_مجتمع64;
عام مرادف variance_sample_f64 = تباين_عينة64;
عام مرادف stddev_population_f64 = انحراف_معياري_مجتمع64;
عام مرادف stddev_sample_f64 = انحراف_معياري_عينة64;
عام مرادف dot_f64 = حاصل_ضرب_نقطي64;
عام مرادف norm_l2_f64 = معيار2_64;

// Complete f32 scalar parity without widening to f64.
عام عرف أصغر32(أ: ع32, ب: ع32): ع32 { أرجع أدنى_عائم_بدائيا(أ, ب); }
عام عرف أكبر32(أ: ع32, ب: ع32): ع32 { أرجع أقصى_عائم_بدائيا(أ, ب); }
عام عرف قيد32(القيمة: ع32, الأدنى: ع32, الأعلى: ع32): اختياري ع32 {
    لو (ليس_رقما32(القيمة) || ليس_رقما32(الأدنى) || ليس_رقما32(الأعلى)) { أرجع اختياري.لا_شيء(); };
    لو (الأدنى > الأعلى) { أرجع اختياري.لا_شيء(); };
    لو (القيمة < الأدنى) { أرجع اختياري.موجود(الأدنى); };
    لو (القيمة > الأعلى) { أرجع اختياري.موجود(الأعلى); };
    أرجع اختياري.موجود(القيمة);
}
عام عرف مربع32(القيمة: ع32): ع32 { أرجع القيمة * القيمة; }
عام عرف قريب32(أ: ع32, ب: ع32, سماح_مطلق: ع32, سماح_نسبي: ع32): منطقي {
    لو (!هل_منته32(سماح_مطلق) || !هل_منته32(سماح_نسبي)) { أرجع خطأ; };
    لو ((سماح_مطلق < 0.0) || (سماح_نسبي < 0.0)) { أرجع خطأ; };
    لو (ليس_رقما32(أ) || ليس_رقما32(ب)) { أرجع خطأ; };
    لو (أ == ب) { أرجع صواب; };
    لو (هل_لانهاية32(أ) || هل_لانهاية32(ب)) { أرجع خطأ; };
    دع الفرق: ع32 = مطلق32(أ - ب);
    لو (الفرق <= سماح_مطلق) { أرجع صواب; };
    دع مقياس_أ: ع32 = مطلق32(أ);
    دع مقياس_ب: ع32 = مطلق32(ب);
    دع المقياس: ع32 = أكبر32(مقياس_أ, مقياس_ب);
    أرجع الفرق <= (سماح_نسبي * المقياس);
}
عام عرف وتر32(أ: ع32, ب: ع32): ع32 {
    دع س: ع32 = مطلق32(أ);
    دع ص: ع32 = مطلق32(ب);
    لو (هل_لانهاية32(س) || هل_لانهاية32(ص)) { أرجع لانهاية32(); };
    لو (ليس_رقما32(س)) { أرجع س; };
    لو (ليس_رقما32(ص)) { أرجع ص; };
    دع الأكبر: ع32 = أكبر32(س, ص);
    دع الأصغر: ع32 = أصغر32(س, ص);
    لو (الأكبر == 0.0) { أرجع 0.0; };
    دع النسبة: ع32 = الأصغر / الأكبر;
    أرجع الأكبر * جذر_تربيعي32(1.0 + (النسبة * النسبة));
}
عام عرف قوة_صحيحة32(الأساس: ع32, الأس: عدد): ع32 {
    لو (الأس == 0) { أرجع 1.0; };
    دع سالب: منطقي = الأس < 0;
    دع المقدار: طبيعي;
    لو (سالب) {
        دع المزاح: عدد = -(الأس + 1);
        المقدار := (المزاح مثل طبيعي) + 1;
    }
    وإلا { المقدار := الأس مثل طبيعي; };
    دع الناتج: متغير ع32 = 1.0;
    دع القوة: متغير ع32 = الأساس;
    دع المتبقي: متغير طبيعي = المقدار;
    طالما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) { الناتج := الناتج * القوة; };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) { القوة := القوة * القوة; };
    }
    لو (سالب) { أرجع 1.0 / الناتج; };
    أرجع الناتج;
}
عام عرف امزج32(أ: ع32, ب: ع32, النسبة: ع32): ع32 { أرجع أ + ((ب - أ) * النسبة); }
عام عرف درجات_إلى_راديان32(الدرجات: ع32): ع32 {
    دع المعامل: ع32 = 3.14159265358979323846 / 180.0;
    أرجع الدرجات * المعامل;
}
عام عرف راديان_إلى_درجات32(الراديان: ع32): ع32 {
    دع المعامل: ع32 = 180.0 / 3.14159265358979323846;
    أرجع الراديان * المعامل;
}
عام عرف باي32(): ع32 { أرجع 3.14159265358979323846; }
عام عرف تاو32(): ع32 { أرجع 6.28318530717958647692; }
عام عرف هـ32(): ع32 { أرجع 2.71828182845904523536; }
عام عرف جذر2_32(): ع32 { أرجع 1.41421356237309504880; }

عام مرادف min_f32 = أصغر32;
عام مرادف max_f32 = أكبر32;
عام مرادف clamp_f32 = قيد32;
عام مرادف square_f32 = مربع32;
عام مرادف approx_eq_f32 = قريب32;
عام مرادف hypot_f32 = وتر32;
عام مرادف powi_f32 = قوة_صحيحة32;
عام مرادف lerp_f32 = امزج32;
عام مرادف radians_f32 = درجات_إلى_راديان32;
عام مرادف degrees_f32 = راديان_إلى_درجات32;
عام مرادف pi_f32 = باي32;
عام مرادف tau_f32 = تاو32;
عام مرادف e_f32 = هـ32;
عام مرادف sqrt2_f32 = جذر2_32;

// Rounding to an integral value. On AArch64 and WebAssembly each is one
// instruction; elsewhere it works on the bits as Rust's libm does: the
// fraction bits below the binary point are cleared, and one unit of the
// integral part is added when the mode moves away from zero (same-sign float
// bits are ordered like their magnitudes, so that add carries into the
// exponent). NaN, infinities and values at or above 2^F are returned as they
// are; a result of zero keeps the operand's sign.
لو (الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «wasm32») {
