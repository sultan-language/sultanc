// Pure floating-point helpers built only from SultanC's canonical f32/f64 arithmetic.
// The elementary layer is deterministic and host-libm independent. Ordinary sin/cos/tan
// remain intentionally absent until full-range argument reduction can use canonical float-bit
// access or libm primitives; sinpi/cospi/tanpi are provided because their reduction is exact
// from the representable input itself.

عام عرف ليس_رقما64(القيمة: ع64): منطقي { أرجع القيمة != القيمة; }
عام عرف لانهاية64(): ع64 {
    دع الواحد: ع64 = 1.0;
    دع الصفر: ع64 = 0.0;
    أرجع الواحد / الصفر;
}
عام عرف هل_لانهاية64(القيمة: ع64): منطقي {
    دع اللانهاية: ع64 = لانهاية64();
    أرجع (القيمة == اللانهاية) || (القيمة == -اللانهاية);
}
عام عرف هل_منته64(القيمة: ع64): منطقي {
    أرجع !ليس_رقما64(القيمة) && !هل_لانهاية64(القيمة);
}
عام عرف مطلق64(القيمة: ع64): ع64 {
    لو (القيمة == 0.0) { أرجع 0.0; };
    لو (القيمة < 0.0) { أرجع -القيمة; };
    أرجع القيمة;
}
عام عرف أصغر64(أ: ع64, ب: ع64): ع64 {
    لو (ليس_رقما64(أ)) { أرجع أ; };
    لو (ليس_رقما64(ب)) { أرجع ب; };
    لو (أ < ب) { أرجع أ; };
    أرجع ب;
}
عام عرف أكبر64(أ: ع64, ب: ع64): ع64 {
    لو (ليس_رقما64(أ)) { أرجع أ; };
    لو (ليس_رقما64(ب)) { أرجع ب; };
    لو (أ > ب) { أرجع أ; };
    أرجع ب;
}
عام عرف قيد64(القيمة: ع64, الأدنى: ع64, الأعلى: ع64): اختيار ع64 {
    لو (ليس_رقما64(القيمة) || ليس_رقما64(الأدنى) || ليس_رقما64(الأعلى)) { أرجع اختيار.لا_شيء(); };
    لو (الأدنى > الأعلى) { أرجع اختيار.لا_شيء(); };
    لو (القيمة < الأدنى) { أرجع اختيار.بعض(الأدنى); };
    لو (القيمة > الأعلى) { أرجع اختيار.بعض(الأعلى); };
    أرجع اختيار.بعض(القيمة);
}
عام عرف مربع64(القيمة: ع64): ع64 { أرجع القيمة * القيمة; }
عام عرف قريب64(أ: ع64, ب: ع64, سماح_مطلق: ع64, سماح_نسبي: ع64): منطقي {
    لو (!هل_منته64(سماح_مطلق) || !هل_منته64(سماح_نسبي)) { أرجع خطأ; };
    لو ((سماح_مطلق < 0.0) || (سماح_نسبي < 0.0)) { أرجع خطأ; };
    لو (ليس_رقما64(أ) || ليس_رقما64(ب)) { أرجع خطأ; };
    لو (أ == ب) { أرجع صواب; };
    لو (هل_لانهاية64(أ) || هل_لانهاية64(ب)) { أرجع خطأ; };
    دع الفرق: ع64 = مطلق64(أ - ب);
    لو (الفرق <= سماح_مطلق) { أرجع صواب; };
    دع المقياس: ع64 = أكبر64(مطلق64(أ), مطلق64(ب));
    أرجع الفرق <= (سماح_نسبي * المقياس);
}

عام عرف جذر_تربيعي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة)) { أرجع القيمة; };
    لو (القيمة < 0.0) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    لو ((القيمة == 0.0) || هل_لانهاية64(القيمة)) { أرجع القيمة; };

    // Scale to [1,4), solve there, then restore the scale. This avoids a poor
    // Newton starting point for very large/small finite values.
    دع المطبع: متغير ع64 = القيمة;
    دع المقياس: متغير ع64 = 1.0;
    بينما (المطبع >= 4.0) {
        المطبع := المطبع / 4.0;
        المقياس := المقياس * 2.0;
    }
    بينما (المطبع < 1.0) {
        المطبع := المطبع * 4.0;
        المقياس := المقياس / 2.0;
    }
    دع بداية_التخمين: ع64 = المطبع + 1.0;
    دع التخمين: متغير ع64 = بداية_التخمين / 2.0;
    دع التكرار: متغير غير_موقع = 0;
    بينما (التكرار < 10) {
        دع نسبة_نيوتن: ع64 = المطبع / التخمين;
        دع مجموع_نيوتن: ع64 = التخمين + نسبة_نيوتن;
        التخمين := مجموع_نيوتن / 2.0;
        التكرار := التكرار + 1;
    }
    أرجع التخمين * المقياس;
}

عام عرف وتر64(أ: ع64, ب: ع64): ع64 {
    دع س: ع64 = مطلق64(أ);
    دع ص: ع64 = مطلق64(ب);
    لو (هل_لانهاية64(س) || هل_لانهاية64(ص)) { أرجع لانهاية64(); };
    لو (ليس_رقما64(س)) { أرجع س; };
    لو (ليس_رقما64(ص)) { أرجع ص; };
    دع الأكبر: ع64 = أكبر64(س, ص);
    دع الأصغر: ع64 = أصغر64(س, ص);
    لو (الأكبر == 0.0) { أرجع 0.0; };
    دع النسبة: ع64 = الأصغر / الأكبر;
    أرجع الأكبر * جذر_تربيعي64(1.0 + (النسبة * النسبة));
}

عام عرف قوة_صحيحة64(الأساس: ع64, الأس: عدد): ع64 {
    لو (الأس == 0) { أرجع 1.0; };
    دع سالب: منطقي = الأس < 0;
    دع المقدار: غير_موقع;
    لو (سالب) {
        // -(INT_MIN) is not representable; shift before negating.
        دع المزاح: عدد = -(الأس + 1);
        المقدار := (المزاح مثل غير_موقع) + 1;
    }
    وإلا { المقدار := الأس مثل غير_موقع; };

    دع الناتج: متغير ع64 = 1.0;
    دع القوة: متغير ع64 = الأساس;
    دع المتبقي: متغير غير_موقع = المقدار;
    بينما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) { الناتج := الناتج * القوة; };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) { القوة := القوة * القوة; };
    }
    لو (سالب) { أرجع 1.0 / الناتج; };
    أرجع الناتج;
}

عام عرف امزج64(أ: ع64, ب: ع64, النسبة: ع64): ع64 {
    أرجع أ + ((ب - أ) * النسبة);
}
عام عرف درجات_إلى_راديان64(الدرجات: ع64): ع64 {
    أرجع الدرجات * (3.141592653589793238462643383279502884 / 180.0);
}
عام عرف راديان_إلى_درجات64(الراديان: ع64): ع64 {
    أرجع الراديان * (180.0 / 3.141592653589793238462643383279502884);
}
عام عرف باي64(): ع64 { أرجع 3.141592653589793238462643383279502884; }
عام عرف تاو64(): ع64 { أرجع 6.283185307179586476925286766559005768; }
عام عرف هـ64(): ع64 { أرجع 2.718281828459045235360287471352662498; }
عام عرف جذر2_64(): ع64 { أرجع 1.414213562373095048801688724209698079; }

// f32 counterparts for the scalar helpers most commonly needed without widening.
عام عرف ليس_رقما32(القيمة: ع32): منطقي { أرجع القيمة != القيمة; }
عام عرف لانهاية32(): ع32 {
    دع الواحد: ع32 = 1.0;
    دع الصفر: ع32 = 0.0;
    أرجع الواحد / الصفر;
}
عام عرف هل_لانهاية32(القيمة: ع32): منطقي {
    دع اللانهاية: ع32 = لانهاية32();
    أرجع (القيمة == اللانهاية) || (القيمة == -اللانهاية);
}
عام عرف هل_منته32(القيمة: ع32): منطقي { أرجع !ليس_رقما32(القيمة) && !هل_لانهاية32(القيمة); }
عام عرف مطلق32(القيمة: ع32): ع32 {
    لو (القيمة == 0.0) { أرجع 0.0; };
    لو (القيمة < 0.0) { أرجع -القيمة; };
    أرجع القيمة;
}
عام عرف جذر_تربيعي32(القيمة: ع32): ع32 {
    لو (ليس_رقما32(القيمة)) { أرجع القيمة; };
    لو (القيمة < 0.0) {
        دع الصفر: ع32 = 0.0;
        أرجع الصفر / الصفر;
    };
    لو ((القيمة == 0.0) || هل_لانهاية32(القيمة)) { أرجع القيمة; };
    دع المطبع: متغير ع32 = القيمة;
    دع المقياس: متغير ع32 = 1.0;
    بينما (المطبع >= 4.0) { المطبع := المطبع / 4.0; المقياس := المقياس * 2.0; }
    بينما (المطبع < 1.0) { المطبع := المطبع * 4.0; المقياس := المقياس / 2.0; }
    دع بداية_التخمين: ع32 = المطبع + 1.0;
    دع التخمين: متغير ع32 = بداية_التخمين / 2.0;
    دع التكرار: متغير غير_موقع = 0;
    بينما (التكرار < 6) {
        دع نسبة_نيوتن: ع32 = المطبع / التخمين;
        دع مجموع_نيوتن: ع32 = التخمين + نسبة_نيوتن;
        التخمين := مجموع_نيوتن / 2.0;
        التكرار := التكرار + 1;
    }
    أرجع التخمين * المقياس;
}

عام مرادف is_nan_f64 = ليس_رقما64;
عام مرادف infinity_f64 = لانهاية64;
عام مرادف is_infinite_f64 = هل_لانهاية64;
عام مرادف is_finite_f64 = هل_منته64;
عام مرادف abs_f64 = مطلق64;
عام مرادف min_f64 = أصغر64;
عام مرادف max_f64 = أكبر64;
عام مرادف clamp_f64 = قيد64;
عام مرادف square_f64 = مربع64;
عام مرادف approx_eq_f64 = قريب64;
عام مرادف sqrt_f64 = جذر_تربيعي64;
عام مرادف hypot_f64 = وتر64;
عام مرادف powi_f64 = قوة_صحيحة64;
عام مرادف lerp_f64 = امزج64;
عام مرادف radians_f64 = درجات_إلى_راديان64;
عام مرادف degrees_f64 = راديان_إلى_درجات64;
عام مرادف pi_f64 = باي64;
عام مرادف tau_f64 = تاو64;
عام مرادف e_f64 = هـ64;
عام مرادف sqrt2_f64 = جذر2_64;
عام مرادف is_nan_f32 = ليس_رقما32;
عام مرادف infinity_f32 = لانهاية32;
عام مرادف is_infinite_f32 = هل_لانهاية32;
عام مرادف is_finite_f32 = هل_منته32;
عام مرادف abs_f32 = مطلق32;
عام مرادف sqrt_f32 = جذر_تربيعي32;

// Aggregate/statistical helpers for f64 vectors. Empty inputs return none where
// a mathematically defined sample/value is required.
عام عرف مجموع64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع المجموع: متغير ع64 = 0.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(النسخة) مثل غير_موقع)) {
        المجموع := المجموع + النسخة[الموضع];
        الموضع := الموضع + 1;
    }
    أرجع المجموع;
}

عام عرف متوسط64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختيار.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(النسخة) مثل غير_موقع)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(الوسط);
}

عام عرف تباين_مجتمع64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختيار.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع مجموع_المربعات: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(النسخة) مثل غير_موقع)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        دع الفرق_بعد: ع64 = النسخة[الموضع] - الوسط;
        مجموع_المربعات := مجموع_المربعات + (الفرق * الفرق_بعد);
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(مجموع_المربعات / العدد);
}

عام عرف تباين_عينة64(القيم: &متجه ع64): اختيار ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) < 2) { أرجع اختيار.لا_شيء(); };
    دع الوسط: متغير ع64 = 0.0;
    دع مجموع_المربعات: متغير ع64 = 0.0;
    دع العدد: متغير ع64 = 0.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(النسخة) مثل غير_موقع)) {
        العدد := العدد + 1.0;
        دع الفرق: ع64 = النسخة[الموضع] - الوسط;
        الوسط := الوسط + (الفرق / العدد);
        دع الفرق_بعد: ع64 = النسخة[الموضع] - الوسط;
        مجموع_المربعات := مجموع_المربعات + (الفرق * الفرق_بعد);
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(مجموع_المربعات / (العدد - 1.0));
}

عام عرف انحراف_معياري_مجتمع64(القيم: &متجه ع64): اختيار ع64 {
    طابق تباين_مجتمع64(القيم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(جذر_تربيعي64(القيمة)); };
}

عام عرف انحراف_معياري_عينة64(القيم: &متجه ع64): اختيار ع64 {
    طابق تباين_عينة64(القيم) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(جذر_تربيعي64(القيمة)); };
}

عام عرف حاصل_ضرب_نقطي64(أ: &متجه ع64, ب: &متجه ع64): اختيار ع64 {
    دع س: متجه ع64 = *أ;
    دع ص: متجه ع64 = *ب;
    لو (الطول(س) != الطول(ص)) { أرجع اختيار.لا_شيء(); };
    دع الناتج: متغير ع64 = 0.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(س) مثل غير_موقع)) {
        الناتج := الناتج + (س[الموضع] * ص[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام عرف معيار2_64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع المقياس: متغير ع64 = 0.0;
    دع مجموع_مقيس: متغير ع64 = 1.0;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(النسخة) مثل غير_موقع)) {
        دع القيمة: ع64 = مطلق64(النسخة[الموضع]);
        لو (ليس_رقما64(القيمة)) { أرجع القيمة; };
        لو (هل_لانهاية64(القيمة)) { أرجع القيمة; };
        لو (القيمة != 0.0) {
            لو (المقياس < القيمة) {
                دع النسبة: ع64 = المقياس / القيمة;
                مجموع_مقيس := 1.0 + (مجموع_مقيس * النسبة * النسبة);
                المقياس := القيمة;
            }
            وإلا {
                دع النسبة: ع64 = القيمة / المقياس;
                مجموع_مقيس := مجموع_مقيس + (النسبة * النسبة);
            };
        };
        الموضع := الموضع + 1;
    }
    لو (المقياس == 0.0) { أرجع 0.0; };
    أرجع المقياس * جذر_تربيعي64(مجموع_مقيس);
}

عام مرادف sum_f64 = مجموع64;
عام مرادف mean_f64 = متوسط64;
عام مرادف variance_population_f64 = تباين_مجتمع64;
عام مرادف variance_sample_f64 = تباين_عينة64;
عام مرادف stddev_population_f64 = انحراف_معياري_مجتمع64;
عام مرادف stddev_sample_f64 = انحراف_معياري_عينة64;
عام مرادف dot_f64 = حاصل_ضرب_نقطي64;
عام مرادف norm_l2_f64 = معيار2_64;

// Complete f32 scalar parity without widening to f64.
عام عرف أصغر32(أ: ع32, ب: ع32): ع32 {
    لو (ليس_رقما32(أ)) { أرجع أ; };
    لو (ليس_رقما32(ب)) { أرجع ب; };
    لو (أ < ب) { أرجع أ; };
    أرجع ب;
}
عام عرف أكبر32(أ: ع32, ب: ع32): ع32 {
    لو (ليس_رقما32(أ)) { أرجع أ; };
    لو (ليس_رقما32(ب)) { أرجع ب; };
    لو (أ > ب) { أرجع أ; };
    أرجع ب;
}
عام عرف قيد32(القيمة: ع32, الأدنى: ع32, الأعلى: ع32): اختيار ع32 {
    لو (ليس_رقما32(القيمة) || ليس_رقما32(الأدنى) || ليس_رقما32(الأعلى)) { أرجع اختيار.لا_شيء(); };
    لو (الأدنى > الأعلى) { أرجع اختيار.لا_شيء(); };
    لو (القيمة < الأدنى) { أرجع اختيار.بعض(الأدنى); };
    لو (القيمة > الأعلى) { أرجع اختيار.بعض(الأعلى); };
    أرجع اختيار.بعض(القيمة);
}
عام عرف مربع32(القيمة: ع32): ع32 { أرجع القيمة * القيمة; }
عام عرف قريب32(أ: ع32, ب: ع32, سماح_مطلق: ع32, سماح_نسبي: ع32): منطقي {
    لو (!هل_منته32(سماح_مطلق) || !هل_منته32(سماح_نسبي)) { أرجع خطأ; };
    لو ((سماح_مطلق < 0.0) || (سماح_نسبي < 0.0)) { أرجع خطأ; };
    لو (ليس_رقما32(أ) || ليس_رقما32(ب)) { أرجع خطأ; };
    لو (أ == ب) { أرجع صواب; };
    لو (هل_لانهاية32(أ) || هل_لانهاية32(ب)) { أرجع خطأ; };
    دع الفرق: ع32 = مطلق32(أ - ب);
