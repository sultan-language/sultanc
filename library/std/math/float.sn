    دع لانهاية_س: منطقي = هل_لانهاية64(س);
    دع لانهاية_ص: منطقي = هل_لانهاية64(ص);
    لو (لانهاية_س && لانهاية_ص) {
        لو (س > 0.0) {
            لو (ص > 0.0) { أرجع باي64() / 4.0; };
            أرجع -(باي64() / 4.0);
        };
        لو (ص > 0.0) { أرجع 3.0 * باي64() / 4.0; };
        أرجع -(3.0 * باي64() / 4.0);
    };
    لو (لانهاية_ص) {
        لو (ص > 0.0) { أرجع باي64() / 2.0; };
        أرجع -(باي64() / 2.0);
    };
    لو (لانهاية_س) {
        لو (س > 0.0) {
            لو (ص < 0.0) { أرجع -0.0; };
            أرجع 0.0;
        };
        لو (ص < 0.0) { أرجع -باي64(); };
        أرجع باي64();
    };
    لو (س > 0.0) { أرجع قوس_ظل64(ص / س); };
    لو (س < 0.0) {
        دع أ: ع64 = قوس_ظل64(ص / س);
        لو (ص >= 0.0) { أرجع أ + باي64(); };
        أرجع أ - باي64();
    };
    لو (ص > 0.0) { أرجع باي64() / 2.0; };
    لو (ص < 0.0) { أرجع -(باي64() / 2.0); };
    أرجع 0.0;
}

عام عرف قوس_جيب64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    لو (القيمة == 1.0) { أرجع باي64() / 2.0; };
    لو (القيمة == -1.0) { أرجع -(باي64() / 2.0); };
    أرجع قوس_ظل2_64(القيمة, جذر_تربيعي64((1.0 - القيمة) * (1.0 + القيمة)));
}

عام عرف قوس_جيب_تمام64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    أرجع قوس_ظل2_64(جذر_تربيعي64((1.0 - القيمة) * (1.0 + القيمة)), القيمة);
}

عام عرف جيب_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || هل_لانهاية64(القيمة)) { أرجع القيمة; };
    دع المطلق: ع64 = مطلق64(القيمة);
    لو (المطلق < 0.5) {
        دع س2: ع64 = القيمة * القيمة;
        دع الحد: متغير ع64 = القيمة;
        دع المجموع: متغير ع64 = القيمة;
        دع ن: متغير ع64 = 2.0;
        دع ت: متغير غير_موقع = 0;
        بينما (ت < 10) {
            الحد := الحد * س2 / (ن * (ن + 1.0));
            المجموع := المجموع + الحد;
            ن := ن + 2.0;
            ت := ت + 1;
        }
        أرجع المجموع;
    };
    أرجع (أس64(القيمة) - أس64(-القيمة)) / 2.0;
}

عام عرف جيب_تمام_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة)) { أرجع القيمة; };
    دع المطلق: ع64 = مطلق64(القيمة);
    لو (هل_لانهاية64(المطلق)) { أرجع لانهاية64(); };
    أرجع (أس64(المطلق) + أس64(-المطلق)) / 2.0;
}

عام عرف ظل_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة)) { أرجع القيمة; };
    لو (القيمة > 20.0) { أرجع 1.0; };
    لو (القيمة < -20.0) { أرجع -1.0; };
    دع هـ2: ع64 = أس64(2.0 * القيمة);
    أرجع (هـ2 - 1.0) / (هـ2 + 1.0);
}

عام عرف قوس_جيب_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || هل_لانهاية64(القيمة)) { أرجع القيمة; };
    دع سالب: منطقي = القيمة < 0.0;
    دع أ: ع64 = مطلق64(القيمة);
    دع الناتج: ع64;
    لو (أ > 1.0e150) { الناتج := لوغاريتم64(أ) + 0.693147180559945309417232121458176568; }
    وإلا { الناتج := لوغاريتم64(أ + جذر_تربيعي64((أ * أ) + 1.0)); };
    لو (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف قوس_جيب_تمام_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || (القيمة < 1.0)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    لو (هل_لانهاية64(القيمة)) { أرجع القيمة; };
    لو (القيمة > 1.0e150) { أرجع لوغاريتم64(القيمة) + 0.693147180559945309417232121458176568; };
    أرجع لوغاريتم64(القيمة + جذر_تربيعي64((القيمة - 1.0) * (القيمة + 1.0)));
}

عام عرف قوس_ظل_زائدي64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || (القيمة < -1.0) || (القيمة > 1.0)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    لو (القيمة == 1.0) { أرجع لانهاية64(); };
    لو (القيمة == -1.0) { أرجع -لانهاية64(); };
    أرجع 0.5 * لوغاريتم_واحد_زائد64((2.0 * القيمة) / (1.0 - القيمة));
}

عرف جيب_سلسلة64(الزاوية: ع64): ع64 {
    دع ز2: ع64 = الزاوية * الزاوية;
    دع الحد: متغير ع64 = الزاوية;
    دع المجموع: متغير ع64 = الزاوية;
    دع ن: متغير ع64 = 2.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 9) {
        الحد := -الحد * ز2 / (ن * (ن + 1.0));
        المجموع := المجموع + الحد;
        ن := ن + 2.0;
        ت := ت + 1;
    }
    أرجع المجموع;
}

عرف جيب_تمام_سلسلة64(الزاوية: ع64): ع64 {
    دع ز2: ع64 = الزاوية * الزاوية;
    دع الحد: متغير ع64 = 1.0;
    دع المجموع: متغير ع64 = 1.0;
    دع ن: متغير ع64 = 1.0;
    دع ت: متغير غير_موقع = 0;
    بينما (ت < 10) {
        الحد := -الحد * ز2 / (ن * (ن + 1.0));
        المجموع := المجموع + الحد;
        ن := ن + 2.0;
        ت := ت + 1;
    }
    أرجع المجموع;
}

عام عرف جيب_باي64(القيمة: ع64): ع64 {
    لو (!هل_منته64(القيمة)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    دع سالب: منطقي = القيمة < 0.0;
    دع ر: متغير ع64 = باقي64(مطلق64(القيمة), 2.0);
    دع طور_سالب: متغير منطقي = خطأ;
    لو (ر > 1.0) { ر := ر - 1.0; طور_سالب := صواب; };
    لو (ر > 0.5) { ر := 1.0 - ر; };
    دع الناتج: متغير ع64 = جيب_سلسلة64(ر * باي64());
    لو (طور_سالب) { الناتج := -الناتج; };
    لو (سالب) { الناتج := -الناتج; };
    أرجع الناتج;
}

عام عرف جيب_تمام_باي64(القيمة: ع64): ع64 {
    لو (!هل_منته64(القيمة)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    دع ر: متغير ع64 = باقي64(مطلق64(القيمة), 2.0);
    لو (ر > 1.0) { ر := 2.0 - ر; };
    دع سالب: متغير منطقي = خطأ;
    لو (ر > 0.5) { ر := 1.0 - ر; سالب := صواب; };
    دع الناتج: ع64 = جيب_تمام_سلسلة64(ر * باي64());
    لو (سالب) { أرجع -الناتج; };
    أرجع الناتج;
}

عام عرف ظل_باي64(القيمة: ع64): ع64 {
    لو (!هل_منته64(القيمة)) {
        دع الصفر: ع64 = 0.0;
        أرجع الصفر / الصفر;
    };
    دع ر: ع64 = باقي64(مطلق64(القيمة), 1.0);
    لو (ر == 0.5) {
        دع اللانهاية: ع64 = لانهاية64();
        لو (القيمة < 0.0) { أرجع -اللانهاية; };
        أرجع اللانهاية;
    };
    أرجع جيب_باي64(القيمة) / جيب_تمام_باي64(القيمة);
}

