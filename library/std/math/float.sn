// Exact arithmetic-only rounding and elementary functions. These do not depend
// on host libm. Rounding reconstructs the integral part from powers of two, so
// it remains bounded work even for large finite IEEE values.
عام عرف بتر64(القيمة: ع64): ع64 {
    لو (ليس_رقما64(القيمة) || هل_لانهاية64(القيمة) || (القيمة == 0.0)) { أرجع القيمة; };
    دع سالب: منطقي = القيمة < 0.0;
    دع المطلق: ع64 = مطلق64(القيمة);
    لو (المطلق < 1.0) {
        لو (سالب) { أرجع -0.0; };
