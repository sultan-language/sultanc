    }
    عام عرف بتر64(القيمة: ع64): ع64 { أرجع قرب64_إلى_صحيح(القيمة, 0); }
    عام عرف أرضية64(القيمة: ع64): ع64 { أرجع قرب64_إلى_صحيح(القيمة, 1); }
    عام عرف سقف64(القيمة: ع64): ع64 { أرجع قرب64_إلى_صحيح(القيمة, 2); }
    عام عرف تقريب_زوجي64(القيمة: ع64): ع64 { أرجع قرب64_إلى_صحيح(القيمة, 3); }
    عام عرف بتر32(القيمة: ع32): ع32 { أرجع قرب32_إلى_صحيح(القيمة, 0); }
    عام عرف أرضية32(القيمة: ع32): ع32 { أرجع قرب32_إلى_صحيح(القيمة, 1); }
    عام عرف سقف32(القيمة: ع32): ع32 { أرجع قرب32_إلى_صحيح(القيمة, 2); }
