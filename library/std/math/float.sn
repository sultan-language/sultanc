عام مرادف div_euclid_f32 = قسمة_إقليدية32;
عام مرادف rem_euclid_f32 = باقي_إقليدي32;

// Additional aggregate statistics for f64 vectors.
عام عرف أصغر_قيمة64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير ع64 = النسخة[0];
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(النسخة) مثل طبيعي)) {
        الناتج := أصغر64(الناتج, النسخة[ف]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}
عام عرف أكبر_قيمة64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختياري.لا_شيء(); };
    دع الناتج: متغير ع64 = النسخة[0];
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(النسخة) مثل طبيعي)) {
        الناتج := أكبر64(الناتج, النسخة[ف]);
        ف := ف + 1;
    }
    أرجع اختياري.موجود(الناتج);
}
عام عرف حاصل_ضرب64(القيم: &متجه ع64): ع64 {
    دع النسخة: متجه ع64 = *القيم;
    دع الناتج: متغير ع64 = 1.0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النسخة) مثل طبيعي)) { الناتج := الناتج * النسخة[ف]; ف := ف + 1; }
    أرجع الناتج;
}
عام عرف متوسط_تربيعي64(القيم: &متجه ع64): اختياري ع64 {
    دع النسخة: متجه ع64 = *القيم;
    لو (الطول(النسخة) == 0) { أرجع اختياري.لا_شيء(); };
    دع المقياس: ع64 = معيار2_64(&النسخة);
    دع العدد: متغير ع64 = 0.0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النسخة) مثل طبيعي)) { العدد := العدد + 1.0; ف := ف + 1; }
    أرجع اختياري.موجود(المقياس / جذر_تربيعي64(العدد));
}

عام مرادف min_value_f64 = أصغر_قيمة64;
عام مرادف max_value_f64 = أكبر_قيمة64;
عام مرادف product_f64 = حاصل_ضرب64;
عام مرادف rms_f64 = متوسط_تربيعي64;

// IEEE 754 bit patterns (Rust's f64::to_bits / from_bits, Go's
// math.Float64bits / Float64frombits): the compiler's bit-reinterpret
// intrinsics, reached through private aliases.
مرادف بتات_ع64_بدائيا = بدائي_بتات_ع64;
مرادف ع64_من_بتات_بدائيا = بدائي_ع64_من_بتات;
مرادف بتات_ع32_بدائيا = بدائي_بتات_ع32;
مرادف ع32_من_بتات_بدائيا = بدائي_ع32_من_بتات;
عام عرف بتات_ع64(القيمة: ع64): ط64 { أرجع بتات_ع64_بدائيا(القيمة); }
عام عرف ع64_من_بتات(البتات: ط64): ع64 { أرجع ع64_من_بتات_بدائيا(البتات); }
عام عرف بتات_ع32(القيمة: ع32): ط32 { أرجع بتات_ع32_بدائيا(القيمة); }
عام عرف ع32_من_بتات(البتات: ط32): ع32 { أرجع ع32_من_بتات_بدائيا(البتات); }
عام مرادف f64_to_bits = بتات_ع64;
عام مرادف f64_from_bits = ع64_من_بتات;
عام مرادف f32_to_bits = بتات_ع32;
عام مرادف f32_from_bits = ع32_من_بتات;
