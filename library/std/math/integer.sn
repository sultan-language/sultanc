// Overflow-safe modular arithmetic. A zero modulus is invalid and returns none.
عام عرف جمع_معياري_طبيعي(أ: طبيعي, ب: طبيعي, المعيار: طبيعي): اختياري طبيعي {
    لو (المعيار == 0) { أرجع اختياري.لا_شيء(); };
    دع س: طبيعي = أ % المعيار;
    دع ص: طبيعي = ب % المعيار;
    دع المتبقي: طبيعي = المعيار - ص;
    لو (س >= المتبقي) { أرجع اختياري.موجود(س - المتبقي); };
    أرجع اختياري.موجود(س + ص);
}

عام عرف ضرب_معياري_طبيعي(أ: طبيعي, ب: طبيعي, المعيار: طبيعي): اختياري طبيعي {
    لو (المعيار == 0) { أرجع اختياري.لا_شيء(); };
    دع س: متغير طبيعي = أ % المعيار;
    دع ص: متغير طبيعي = ب;
    دع الناتج: متغير طبيعي = 0;
    طالما (ص > 0) {
        لو ((ص & 1) == 1) {
            طابق جمع_معياري_طبيعي(الناتج, س, المعيار) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الناتج := القيمة; };
        };
        ص := ص >> 1;
        لو (ص > 0) {
            طابق جمع_معياري_طبيعي(س, س, المعيار) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { س := القيمة; };
        };
    }
    أرجع اختياري.موجود(الناتج);
}

عام عرف قوة_معيارية_طبيعي(الأساس: طبيعي, الأس: طبيعي, المعيار: طبيعي): اختياري طبيعي {
    لو (المعيار == 0) { أرجع اختياري.لا_شيء(); };
    لو (المعيار == 1) { أرجع اختياري.موجود(0); };
    دع القوة: متغير طبيعي = الأساس % المعيار;
    دع المتبقي: متغير طبيعي = الأس;
    دع الناتج: متغير طبيعي = 1 % المعيار;
    طالما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) {
            طابق ضرب_معياري_طبيعي(الناتج, القوة, المعيار) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { الناتج := القيمة; };
        };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) {
            طابق ضرب_معياري_طبيعي(القوة, القوة, المعيار) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(القيمة) -> { القوة := القيمة; };
        };
    }
    أرجع اختياري.موجود(الناتج);
}

عام مرادف mod_add_uint = جمع_معياري_طبيعي;
عام مرادف mod_mul_uint = ضرب_معياري_طبيعي;
عام مرادف mod_pow_uint = قوة_معيارية_طبيعي;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف أصغر_غير_موقع = أصغر_طبيعي;
