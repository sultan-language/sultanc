عام مرادف trailing_zeros_uint = أصفار_تابعة_غير_موقع;
عام مرادف leading_zeros_uint = أصفار_بادئة_غير_موقع;
عام مرادف rotate_left_uint = تدوير_يسار_غير_موقع;
عام مرادف rotate_right_uint = تدوير_يمين_غير_موقع;
عام مرادف checked_permutations_uint = تبديلات_غير_موقع_متحققة;
عام مرادف checked_binomial_uint = توافيق_غير_موقع_متحققة;

// Overflow-safe modular arithmetic. A zero modulus is invalid and returns none.
عام عرف جمع_معياري_غير_موقع(أ: غير_موقع, ب: غير_موقع, المعيار: غير_موقع): اختيار غير_موقع {
    لو (المعيار == 0) { أرجع اختيار.لا_شيء(); };
    دع س: غير_موقع = أ % المعيار;
    دع ص: غير_موقع = ب % المعيار;
    دع المتبقي: غير_موقع = المعيار - ص;
    لو (س >= المتبقي) { أرجع اختيار.بعض(س - المتبقي); };
    أرجع اختيار.بعض(س + ص);
}

عام عرف ضرب_معياري_غير_موقع(أ: غير_موقع, ب: غير_موقع, المعيار: غير_موقع): اختيار غير_موقع {
    لو (المعيار == 0) { أرجع اختيار.لا_شيء(); };
    دع س: متغير غير_موقع = أ % المعيار;
    دع ص: متغير غير_موقع = ب;
    دع الناتج: متغير غير_موقع = 0;
    بينما (ص > 0) {
        لو ((ص & 1) == 1) {
            طابق جمع_معياري_غير_موقع(الناتج, س, المعيار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { الناتج := القيمة; };
        };
        ص := ص >> 1;
        لو (ص > 0) {
            طابق جمع_معياري_غير_موقع(س, س, المعيار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { س := القيمة; };
        };
    }
    أرجع اختيار.بعض(الناتج);
}

عام عرف قوة_معيارية_غير_موقع(الأساس: غير_موقع, الأس: غير_موقع, المعيار: غير_موقع): اختيار غير_موقع {
    لو (المعيار == 0) { أرجع اختيار.لا_شيء(); };
    لو (المعيار == 1) { أرجع اختيار.بعض(0); };
    دع القوة: متغير غير_موقع = الأساس % المعيار;
    دع المتبقي: متغير غير_موقع = الأس;
    دع الناتج: متغير غير_موقع = 1 % المعيار;
    بينما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) {
            طابق ضرب_معياري_غير_موقع(الناتج, القوة, المعيار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { الناتج := القيمة; };
        };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) {
            طابق ضرب_معياري_غير_موقع(القوة, القوة, المعيار) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(القيمة) -> { القوة := القيمة; };
        };
    }
    أرجع اختيار.بعض(الناتج);
}

عام مرادف mod_add_uint = جمع_معياري_غير_موقع;
عام مرادف mod_mul_uint = ضرب_معياري_غير_موقع;
عام مرادف mod_pow_uint = قوة_معيارية_غير_موقع;
