// Pure integer helpers. Checked operations return none rather than wrapping.

عام عرف أصغر_طبيعي(أ: طبيعي, ب: طبيعي): طبيعي {
    لو (أ < ب) { أرجع أ; };
    أرجع ب;
}

عام عرف أكبر_طبيعي(أ: طبيعي, ب: طبيعي): طبيعي {
    لو (أ > ب) { أرجع أ; };
    أرجع ب;
}

عام عرف قيد_طبيعي(القيمة: طبيعي, الأدنى: طبيعي, الأعلى: طبيعي): طبيعي {
    لو (القيمة < الأدنى) { أرجع الأدنى; };
    لو (القيمة > الأعلى) { أرجع الأعلى; };
    أرجع القيمة;
}

عام عرف القاسم_المشترك_الأكبر(أ: طبيعي, ب: طبيعي): طبيعي {
    دع س: متغير طبيعي = أ;
    دع ص: متغير طبيعي = ب;
    طالما (ص != 0) {
        دع الباقي: طبيعي = س % ص;
        س := ص;
        ص := الباقي;
    }
    أرجع س;
}

عام عرف ضرب_طبيعي_متحقق(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    لو ((أ == 0) || (ب == 0)) { أرجع اختياري.موجود(0); };
    دع الحد: طبيعي = 18446744073709551615;
    لو (ب > (الحد / أ)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(أ * ب);
}

عام عرف المضاعف_المشترك_الأصغر(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    لو ((أ == 0) || (ب == 0)) { أرجع اختياري.موجود(0); };
    دع القاسم: طبيعي = القاسم_المشترك_الأكبر(أ, ب);
    دع المخفض: طبيعي = أ / القاسم;
    أرجع ضرب_طبيعي_متحقق(المخفض, ب);
}

عام عرف قوة_طبيعي_متحققة(الأساس: طبيعي, الأس: طبيعي): اختياري طبيعي {
    دع الناتج: متغير طبيعي = 1;
    دع القوة: متغير طبيعي = الأساس;
    دع المتبقي: متغير طبيعي = الأس;
    طالما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) {
            طابق ضرب_طبيعي_متحقق(الناتج, القوة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(قيمة) -> { الناتج := قيمة; };
        };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) {
            طابق ضرب_طبيعي_متحقق(القوة, القوة) مع
            | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
            | اختياري.موجود(قيمة) -> { القوة := قيمة; };
        };
    }
    أرجع اختياري.موجود(الناتج);
}

عام مرادف min_uint = أصغر_طبيعي;
عام مرادف max_uint = أكبر_طبيعي;
عام مرادف clamp_uint = قيد_طبيعي;
