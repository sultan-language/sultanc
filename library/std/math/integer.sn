عام عرف تبديلات_غير_موقع_متحققة(ن: غير_موقع, ك: غير_موقع): اختيار غير_موقع {
    لو (ك > ن) { أرجع اختيار.بعض(0); };
    دع الناتج: متغير غير_موقع = 1;
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < ك) {
        دع العامل: غير_موقع = ن - الموضع;
        طابق ضرب_غير_موقع_متحقق(الناتج, العامل) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الناتج := القيمة; };
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عام عرف توافيق_غير_موقع_متحققة(ن: غير_موقع, ك_الأصلي: غير_موقع): اختيار غير_موقع {
    لو (ك_الأصلي > ن) { أرجع اختيار.بعض(0); };
    دع المقابل: غير_موقع = ن - ك_الأصلي;
    دع ك: متغير غير_موقع = ك_الأصلي;
    لو (المقابل < ك) { ك := المقابل; };
    دع الناتج: متغير غير_موقع = 1;
    دع الموضع: متغير غير_موقع = 1;
    بينما (الموضع <= ك) {
        دع أساس_البسط: غير_موقع = ن - ك;
        دع البسط_الأصلي: غير_موقع = أساس_البسط + الموضع;
        دع المقام_الأصلي: غير_موقع = الموضع;
        دع قاسم1: غير_موقع = القاسم_المشترك_الأكبر(البسط_الأصلي, المقام_الأصلي);
        دع البسط: غير_موقع = البسط_الأصلي / قاسم1;
        دع المقام_بعد1: غير_موقع = المقام_الأصلي / قاسم1;
        دع قاسم2: غير_موقع = القاسم_المشترك_الأكبر(الناتج, المقام_بعد1);
        دع الناتج_المخفض: غير_موقع = الناتج / قاسم2;
        دع المقام: غير_موقع = المقام_بعد1 / قاسم2;
        لو (المقام != 1) { أرجع اختيار.لا_شيء(); };
        طابق ضرب_غير_موقع_متحقق(الناتج_المخفض, البسط) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(القيمة) -> { الناتج := القيمة; };
        الموضع := الموضع + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

