// Pure integer helpers. Checked operations return none rather than wrapping.

عام عرف أصغر_غير_موقع(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    لو (أ < ب) { أرجع أ; };
    أرجع ب;
}

عام عرف أكبر_غير_موقع(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    لو (أ > ب) { أرجع أ; };
    أرجع ب;
}

عام عرف قيد_غير_موقع(القيمة: غير_موقع, الأدنى: غير_موقع, الأعلى: غير_موقع): غير_موقع {
    لو (القيمة < الأدنى) { أرجع الأدنى; };
    لو (القيمة > الأعلى) { أرجع الأعلى; };
    أرجع القيمة;
}

عام عرف القاسم_المشترك_الأكبر(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    دع س: متغير غير_موقع = أ;
    دع ص: متغير غير_موقع = ب;
    بينما (ص != 0) {
        دع الباقي: غير_موقع = س % ص;
        س := ص;
        ص := الباقي;
    }
    أرجع س;
}

عام عرف ضرب_غير_موقع_متحقق(أ: غير_موقع, ب: غير_موقع): اختيار غير_موقع {
    لو ((أ == 0) || (ب == 0)) { أرجع اختيار.بعض(0); };
    دع الحد: غير_موقع = 18446744073709551615;
    لو (ب > (الحد / أ)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(أ * ب);
}

عام عرف المضاعف_المشترك_الأصغر(أ: غير_موقع, ب: غير_موقع): اختيار غير_موقع {
    لو ((أ == 0) || (ب == 0)) { أرجع اختيار.بعض(0); };
    دع القاسم: غير_موقع = القاسم_المشترك_الأكبر(أ, ب);
    دع المخفض: غير_موقع = أ / القاسم;
    أرجع ضرب_غير_موقع_متحقق(المخفض, ب);
}

عام عرف قوة_غير_موقع_متحققة(الأساس: غير_موقع, الأس: غير_موقع): اختيار غير_موقع {
    دع الناتج: متغير غير_موقع = 1;
    دع القوة: متغير غير_موقع = الأساس;
    دع المتبقي: متغير غير_موقع = الأس;
    بينما (المتبقي > 0) {
        لو ((المتبقي & 1) == 1) {
            طابق ضرب_غير_موقع_متحقق(الناتج, القوة) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(قيمة) -> { الناتج := قيمة; };
        };
        المتبقي := المتبقي >> 1;
        لو (المتبقي > 0) {
            طابق ضرب_غير_موقع_متحقق(القوة, القوة) مع
            | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
            | اختيار.بعض(قيمة) -> { القوة := قيمة; };
        };
    }
    أرجع اختيار.بعض(الناتج);
}

