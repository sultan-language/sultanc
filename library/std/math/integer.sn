عام عرف قسمة_سقفية_غير_موقع(أ: غير_موقع, ب: غير_موقع): اختيار غير_موقع {
    لو (ب == 0) { أرجع اختيار.لا_شيء(); };
    دع الخارج: غير_موقع = أ / ب;
    دع الباقي: غير_موقع = أ % ب;
    لو (الباقي == 0) { أرجع اختيار.بعض(الخارج); };
    أرجع جمع_غير_موقع_متحقق(الخارج, 1);
}

عام عرف جمع_غير_موقع_مشبع(أ: غير_موقع, ب: غير_موقع): غير_موقع {
    طابق جمع_غير_موقع_متحقق(أ, ب) مع
