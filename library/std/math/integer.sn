عام مرادف lcm = المضاعف_المشترك_الأصغر;
عام مرادف checked_pow_uint = قوة_طبيعي_متحققة;

// Expanded checked/saturating integer foundation.
عام عرف جمع_طبيعي_متحقق(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    دع الحد: طبيعي = 18446744073709551615;
    لو (ب > (الحد - أ)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(أ + ب);
}

عام عرف طرح_طبيعي_متحقق(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    لو (ب > أ) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(أ - ب);
}

عام عرف قسمة_طبيعي_متحققة(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    لو (ب == 0) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(أ / ب);
}

عام عرف قسمة_سقفية_طبيعي(أ: طبيعي, ب: طبيعي): اختياري طبيعي {
    لو (ب == 0) { أرجع اختياري.لا_شيء(); };
    دع الخارج: طبيعي = أ / ب;
    دع الباقي: طبيعي = أ % ب;
    لو (الباقي == 0) { أرجع اختياري.موجود(الخارج); };
    أرجع جمع_طبيعي_متحقق(الخارج, 1);
}

عام عرف جمع_طبيعي_مشبع(أ: طبيعي, ب: طبيعي): طبيعي {
    طابق جمع_طبيعي_متحقق(أ, ب) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع 18446744073709551615; };
}

عام عرف طرح_طبيعي_مشبع(أ: طبيعي, ب: طبيعي): طبيعي {
    لو (ب > أ) { أرجع 0; };
    أرجع أ - ب;
}

عام عرف ضرب_طبيعي_مشبع(أ: طبيعي, ب: طبيعي): طبيعي {
    طابق ضرب_طبيعي_متحقق(أ, ب) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع 18446744073709551615; };
}

عام عرف فرق_مطلق_طبيعي(أ: طبيعي, ب: طبيعي): طبيعي {
    لو (أ >= ب) { أرجع أ - ب; };
    أرجع ب - أ;
}

عام عرف هل_زوجي_طبيعي(القيمة: طبيعي): منطقي { أرجع (القيمة & 1) == 0; }
عام عرف هل_فردي_طبيعي(القيمة: طبيعي): منطقي { أرجع (القيمة & 1) == 1; }
عام عرف هل_قوة_اثنين(القيمة: طبيعي): منطقي {
    لو (القيمة == 0) { أرجع خطأ; };
    أرجع (القيمة & (القيمة - 1)) == 0;
}

عام عرف قوة_اثنين_التالية_متحققة(القيمة: طبيعي): اختياري طبيعي {
    لو (القيمة <= 1) { أرجع اختياري.موجود(1); };
    دع س: متغير طبيعي = القيمة - 1;
    س := س | (س >> 1);
    س := س | (س >> 2);
    س := س | (س >> 4);
    س := س | (س >> 8);
    س := س | (س >> 16);
    س := س | (س >> 32);
    لو (س == 18446744073709551615) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(س + 1);
}

عام عرف جذر_صحيح_طبيعي(القيمة: طبيعي): طبيعي {
    لو (القيمة < 2) { أرجع القيمة; };
    دع نصف_القيمة: طبيعي = القيمة / 2;
    دع التخمين: متغير طبيعي = نصف_القيمة + 1;
    دع نسبة_الجذر: متغير طبيعي = القيمة / التخمين;
    دع مجموع_الجذر: متغير طبيعي = التخمين + نسبة_الجذر;
    دع التالي: متغير طبيعي = مجموع_الجذر / 2;
    طالما (التالي < التخمين) {
        التخمين := التالي;
        نسبة_الجذر := القيمة / التخمين;
        مجموع_الجذر := التخمين + نسبة_الجذر;
        التالي := مجموع_الجذر / 2;
    }
    أرجع التخمين;
}

عام عرف مضروب_طبيعي_متحقق(القيمة: طبيعي): اختياري طبيعي {
    دع الناتج: متغير طبيعي = 1;
    دع العامل: متغير طبيعي = 2;
    طالما (العامل <= القيمة) {
        طابق ضرب_طبيعي_متحقق(الناتج, العامل) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(الجديد) -> { الناتج := الجديد; };
        العامل := العامل + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عرف أدنى_عدد(): عدد { أرجع (0 - 9223372036854775807) - 1; }
عرف أعلى_عدد(): عدد { أرجع 9223372036854775807; }

عام عرف جمع_عدد_متحقق(أ: عدد, ب: عدد): اختياري عدد {
    دع الأعلى: عدد = أعلى_عدد();
    دع الأدنى: عدد = أدنى_عدد();
    لو (ب > 0) {
        دع الحد: عدد = الأعلى - ب;
        لو (أ > الحد) { أرجع اختياري.لا_شيء(); };
    };
    لو (ب < 0) {
        دع الحد: عدد = الأدنى - ب;
        لو (أ < الحد) { أرجع اختياري.لا_شيء(); };
    };
    أرجع اختياري.موجود(أ + ب);
}

عام عرف طرح_عدد_متحقق(أ: عدد, ب: عدد): اختياري عدد {
    دع الأعلى: عدد = أعلى_عدد();
    دع الأدنى: عدد = أدنى_عدد();
    لو (ب > 0) {
        دع الحد: عدد = الأدنى + ب;
        لو (أ < الحد) { أرجع اختياري.لا_شيء(); };
    };
    لو (ب < 0) {
        دع الحد: عدد = الأعلى + ب;
        لو (أ > الحد) { أرجع اختياري.لا_شيء(); };
    };
    أرجع اختياري.موجود(أ - ب);
}

عرف مقدار_عدد(القيمة: عدد): طبيعي {
    لو (القيمة >= 0) { أرجع القيمة مثل طبيعي; };
    دع المزاح: عدد = -(القيمة + 1);
    أرجع (المزاح مثل طبيعي) + 1;
}

عام عرف مطلق_عدد_متحقق(القيمة: عدد): اختياري عدد {
    دع المقدار: طبيعي = مقدار_عدد(القيمة);
    لو (المقدار > (9223372036854775807 مثل طبيعي)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(المقدار مثل عدد);
}

عام عرف ضرب_عدد_متحقق(أ: عدد, ب: عدد): اختياري عدد {
    لو ((أ == 0) || (ب == 0)) { أرجع اختياري.موجود(0); };
    دع أ_سالب: منطقي = أ < 0;
    دع ب_سالب: منطقي = ب < 0;
    دع سالب: منطقي = أ_سالب != ب_سالب;
    دع مقدار_أ: طبيعي = مقدار_عدد(أ);
    دع مقدار_ب: طبيعي = مقدار_عدد(ب);
    دع المقدار: طبيعي;
    طابق ضرب_طبيعي_متحقق(مقدار_أ, مقدار_ب) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { المقدار := القيمة; };

    دع أعلى_موقع: طبيعي = 9223372036854775807 مثل طبيعي;
    لو (سالب) {
        دع حد_السالب: طبيعي = أعلى_موقع + 1;
        لو (المقدار > حد_السالب) { أرجع اختياري.لا_شيء(); };
        لو (المقدار == حد_السالب) { أرجع اختياري.موجود(أدنى_عدد()); };
        دع موجب: عدد = المقدار مثل عدد;
        أرجع اختياري.موجود(-موجب);
    };
    لو (المقدار > أعلى_موقع) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(المقدار مثل عدد);
}

