عام عرف جمع_غير_موقع_متحقق(أ: غير_موقع, ب: غير_موقع): اختيار غير_موقع {
    دع الحد: غير_موقع = 18446744073709551615;
    لو (ب > (الحد - أ)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(أ + ب);
}

