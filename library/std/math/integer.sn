عام عرف طول_بتات_طبيعي(القيمة: طبيعي): طبيعي {
    دع س: متغير طبيعي = القيمة;
    دع العدد: متغير طبيعي = 0;
    طالما (س > 0) { العدد := العدد + 1; س := س >> 1; }
    أرجع العدد;
}

عام عرف عدد_بتات_واحد(القيمة: طبيعي): طبيعي {
    دع س: متغير طبيعي = القيمة;
    دع العدد: متغير طبيعي = 0;
    طالما (س != 0) {
        س := س & (س - 1);
        العدد := العدد + 1;
    }
    أرجع العدد;
}

عام عرف أصفار_تابعة_طبيعي(القيمة: طبيعي): طبيعي {
    لو (القيمة == 0) { أرجع 64; };
    دع س: متغير طبيعي = القيمة;
    دع العدد: متغير طبيعي = 0;
    طالما ((س & 1) == 0) { العدد := العدد + 1; س := س >> 1; }
    أرجع العدد;
}

عام عرف أصفار_بادئة_طبيعي(القيمة: طبيعي): طبيعي {
    أرجع 64 - طول_بتات_طبيعي(القيمة);
}

عام عرف تدوير_يسار_طبيعي(القيمة: طبيعي, المقدار: طبيعي): طبيعي {
    دع الإزاحة: طبيعي = المقدار & 63;
    دع الناتج: متغير طبيعي = القيمة;
    دع العداد: متغير طبيعي = 0;
    طالما (العداد < الإزاحة) {
        دع الأعلى: طبيعي = الناتج & 9223372036854775808;
        دع الأسفل: طبيعي = الناتج & 9223372036854775807;
        الناتج := الأسفل << 1;
        لو (الأعلى != 0) { الناتج := الناتج | 1; };
        العداد := العداد + 1;
    }
    أرجع الناتج;
}

عام عرف تدوير_يمين_طبيعي(القيمة: طبيعي, المقدار: طبيعي): طبيعي {
    دع الإزاحة: طبيعي = المقدار & 63;
    دع الناتج: متغير طبيعي = القيمة;
    دع العداد: متغير طبيعي = 0;
    طالما (العداد < الإزاحة) {
        دع الأدنى: طبيعي = الناتج & 1;
        الناتج := الناتج >> 1;
        لو (الأدنى != 0) { الناتج := الناتج | 9223372036854775808; };
        العداد := العداد + 1;
    }
    أرجع الناتج;
}

عام عرف تبديلات_طبيعي_متحققة(ن: طبيعي, ك: طبيعي): اختياري طبيعي {
    لو (ك > ن) { أرجع اختياري.موجود(0); };
    دع الناتج: متغير طبيعي = 1;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < ك) {
        دع العامل: طبيعي = ن - الموضع;
        طابق ضرب_طبيعي_متحقق(الناتج, العامل) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الناتج := القيمة; };
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

عام عرف توافيق_طبيعي_متحققة(ن: طبيعي, ك_الأصلي: طبيعي): اختياري طبيعي {
    لو (ك_الأصلي > ن) { أرجع اختياري.موجود(0); };
    دع المقابل: طبيعي = ن - ك_الأصلي;
    دع ك: متغير طبيعي = ك_الأصلي;
    لو (المقابل < ك) { ك := المقابل; };
    دع الناتج: متغير طبيعي = 1;
    دع الموضع: متغير طبيعي = 1;
    طالما (الموضع <= ك) {
        دع أساس_البسط: طبيعي = ن - ك;
        دع البسط_الأصلي: طبيعي = أساس_البسط + الموضع;
        دع المقام_الأصلي: طبيعي = الموضع;
        دع قاسم1: طبيعي = القاسم_المشترك_الأكبر(البسط_الأصلي, المقام_الأصلي);
        دع البسط: طبيعي = البسط_الأصلي / قاسم1;
        دع المقام_بعد1: طبيعي = المقام_الأصلي / قاسم1;
        دع قاسم2: طبيعي = القاسم_المشترك_الأكبر(الناتج, المقام_بعد1);
        دع الناتج_المخفض: طبيعي = الناتج / قاسم2;
        دع المقام: طبيعي = المقام_بعد1 / قاسم2;
        لو (المقام != 1) { أرجع اختياري.لا_شيء(); };
        طابق ضرب_طبيعي_متحقق(الناتج_المخفض, البسط) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { الناتج := القيمة; };
        الموضع := الموضع + 1;
    }
    أرجع اختياري.موجود(الناتج);
}

