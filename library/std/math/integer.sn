عام عرف هل_قوة_اثنين(القيمة: غير_موقع): منطقي {
    لو (القيمة == 0) { أرجع خطأ; };
    أرجع (القيمة & (القيمة - 1)) == 0;
}

عام عرف قوة_اثنين_التالية_متحققة(القيمة: غير_موقع): اختيار غير_موقع {
    لو (القيمة <= 1) { أرجع اختيار.بعض(1); };
    دع س: متغير غير_موقع = القيمة - 1;
    س := س | (س >> 1);
    س := س | (س >> 2);
    س := س | (س >> 4);
    س := س | (س >> 8);
    س := س | (س >> 16);
    س := س | (س >> 32);
    لو (س == 18446744073709551615) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(س + 1);
}

عام عرف جذر_صحيح_غير_موقع(القيمة: غير_موقع): غير_موقع {
    لو (القيمة < 2) { أرجع القيمة; };
    دع نصف_القيمة: غير_موقع = القيمة / 2;
    دع التخمين: متغير غير_موقع = نصف_القيمة + 1;
    دع نسبة_الجذر: متغير غير_موقع = القيمة / التخمين;
    دع مجموع_الجذر: متغير غير_موقع = التخمين + نسبة_الجذر;
    دع التالي: متغير غير_موقع = مجموع_الجذر / 2;
    بينما (التالي < التخمين) {
        التخمين := التالي;
        نسبة_الجذر := القيمة / التخمين;
        مجموع_الجذر := التخمين + نسبة_الجذر;
        التالي := مجموع_الجذر / 2;
    }
    أرجع التخمين;
}

عام عرف مضروب_غير_موقع_متحقق(القيمة: غير_موقع): اختيار غير_موقع {
    دع الناتج: متغير غير_موقع = 1;
    دع العامل: متغير غير_موقع = 2;
    بينما (العامل <= القيمة) {
        طابق ضرب_غير_موقع_متحقق(الناتج, العامل) مع
        | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
        | اختيار.بعض(الجديد) -> { الناتج := الجديد; };
        العامل := العامل + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

عرف أدنى_عدد(): عدد { أرجع (0 - 9223372036854775807) - 1; }
عرف أعلى_عدد(): عدد { أرجع 9223372036854775807; }

عام عرف جمع_عدد_متحقق(أ: عدد, ب: عدد): اختيار عدد {
    دع الأعلى: عدد = أعلى_عدد();
    دع الأدنى: عدد = أدنى_عدد();
    لو (ب > 0) {
        دع الحد: عدد = الأعلى - ب;
        لو (أ > الحد) { أرجع اختيار.لا_شيء(); };
    };
    لو (ب < 0) {
        دع الحد: عدد = الأدنى - ب;
        لو (أ < الحد) { أرجع اختيار.لا_شيء(); };
    };
    أرجع اختيار.بعض(أ + ب);
}

عام عرف طرح_عدد_متحقق(أ: عدد, ب: عدد): اختيار عدد {
    دع الأعلى: عدد = أعلى_عدد();
    دع الأدنى: عدد = أدنى_عدد();
    لو (ب > 0) {
        دع الحد: عدد = الأدنى + ب;
        لو (أ < الحد) { أرجع اختيار.لا_شيء(); };
    };
    لو (ب < 0) {
        دع الحد: عدد = الأعلى + ب;
        لو (أ > الحد) { أرجع اختيار.لا_شيء(); };
    };
    أرجع اختيار.بعض(أ - ب);
}

عرف مقدار_عدد(القيمة: عدد): غير_موقع {
    لو (القيمة >= 0) { أرجع القيمة مثل غير_موقع; };
    دع المزاح: عدد = -(القيمة + 1);
    أرجع (المزاح مثل غير_موقع) + 1;
}

عام عرف مطلق_عدد_متحقق(القيمة: عدد): اختيار عدد {
    دع المقدار: غير_موقع = مقدار_عدد(القيمة);
    لو (المقدار > (9223372036854775807 مثل غير_موقع)) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(المقدار مثل عدد);
}

عام عرف ضرب_عدد_متحقق(أ: عدد, ب: عدد): اختيار عدد {
    لو ((أ == 0) || (ب == 0)) { أرجع اختيار.بعض(0); };
    دع أ_سالب: منطقي = أ < 0;
    دع ب_سالب: منطقي = ب < 0;
    دع سالب: منطقي = أ_سالب != ب_سالب;
    دع مقدار_أ: غير_موقع = مقدار_عدد(أ);
    دع مقدار_ب: غير_موقع = مقدار_عدد(ب);
    دع المقدار: غير_موقع;
    طابق ضرب_غير_موقع_متحقق(مقدار_أ, مقدار_ب) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { المقدار := القيمة; };

    دع أعلى_موقع: غير_موقع = 9223372036854775807 مثل غير_موقع;
    لو (سالب) {
        دع حد_السالب: غير_موقع = أعلى_موقع + 1;
        لو (المقدار > حد_السالب) { أرجع اختيار.لا_شيء(); };
        لو (المقدار == حد_السالب) { أرجع اختيار.بعض(أدنى_عدد()); };
        دع موجب: عدد = المقدار مثل عدد;
        أرجع اختيار.بعض(-موجب);
    };
    لو (المقدار > أعلى_موقع) { أرجع اختيار.لا_شيء(); };
    أرجع اختيار.بعض(المقدار مثل عدد);
}

