// Deterministic ordered combination of already-computed 64-bit component hashes.
// Each component is folded byte-by-byte so compound-key hashing is stable and
// does not depend on object layout or padding.
عام عرف بذرة_هاش_مركب(): غير_موقع {
    أرجع 14695981039346656037;
}

// FNV-1a's 64-bit prime is 256 * 2^32 + 435. Split the product into
// 32-bit limbs so all intermediate arithmetic fits the checked uint64 type
// while the final value wraps modulo 2^64, as specified by FNV.
عرف اضرب_هاش_مركب_دائريا(القيمة: غير_موقع): غير_موقع {
    دع الأدنى: غير_موقع = القيمة & 4294967295;
    دع الأعلى: غير_موقع = القيمة >> 32;
    دع حاصل_الأدنى: غير_موقع = الأدنى * 435;
    دع أدنى_الناتج: غير_موقع = حاصل_الأدنى & 4294967295;
    دع أعلى_الناتج: غير_موقع = (
        (الأعلى * 435) + (الأدنى * 256) + (حاصل_الأدنى >> 32)
    ) & 4294967295;
    أرجع (أعلى_الناتج << 32) | أدنى_الناتج;
}

عام عرف ادمج_هاشا(البذرة: غير_موقع, هاش_المكون: غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = البذرة;
    دع القيمة: متغير غير_موقع = هاش_المكون;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        دع البايت: غير_موقع = القيمة & 255;
        الناتج := الناتج ^ البايت;
        الناتج := اضرب_هاش_مركب_دائريا(الناتج);
        القيمة := القيمة >> 8;
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام عرف ادمج_هاشين(الأول: غير_موقع, الثاني: غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = بذرة_هاش_مركب();
    الناتج := ادمج_هاشا(الناتج, الأول);
    الناتج := ادمج_هاشا(الناتج, الثاني);
    أرجع الناتج;
}

عام عرف ادمج_ثلاثة_هاشات(الأول: غير_موقع, الثاني: غير_موقع, الثالث: غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = بذرة_هاش_مركب();
    الناتج := ادمج_هاشا(الناتج, الأول);
    الناتج := ادمج_هاشا(الناتج, الثاني);
    الناتج := ادمج_هاشا(الناتج, الثالث);
    أرجع الناتج;
}

عام عرف ادمج_هاشات(الهاشات: &متجه غير_موقع): غير_موقع {
    دع الناتج: متغير غير_موقع = بذرة_هاش_مركب();
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(*الهاشات) مثل غير_موقع)) {
        الناتج := ادمج_هاشا(الناتج, (*الهاشات)[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عام مرادف hash_combine_seed = بذرة_هاش_مركب;
عام مرادف hash_combine = ادمج_هاشا;
عام مرادف hash_combine2 = ادمج_هاشين;
عام مرادف hash_combine3 = ادمج_ثلاثة_هاشات;
عام مرادف hash_combine_all = ادمج_هاشات;
