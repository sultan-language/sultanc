// Deterministic non-cryptographic FNV-1a hashing for bytes and UTF-8 text.
// This is suitable for hash-table keys and stable tooling data, not security.
// uint is a canonical 64-bit type; each reduced 32-bit state times the
// 32-bit FNV prime fits within it before reduction modulo 2^32.

عام عرف هاش_فنڤ1أ_32_بايتات(القيمة: &متجه ط8): ط32 {
    دع هاش: متغير طبيعي = 2166136261;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        هاش := هاش ^ ((*القيمة)[ف] مثل طبيعي);
        هاش := (هاش * 16777619) % 4294967296;
        ف := ف + 1;
    }
    أرجع هاش مثل ط32;
}

عام عرف هاش_فنڤ1أ_32_نص(القيمة: &نص): ط32 {
    دع هاش: متغير طبيعي = 2166136261;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيمة) مثل طبيعي)) {
        هاش := هاش ^ ((*القيمة)[ف] مثل طبيعي);
        هاش := (هاش * 16777619) % 4294967296;
        ف := ف + 1;
    }
    أرجع هاش مثل ط32;
}

عام عرف هاش_فنڤ1أ_طبيعي_للبايتات(القيمة: &متجه ط8): طبيعي {
    أرجع هاش_فنڤ1أ_32_بايتات(القيمة) مثل طبيعي;
}

عام عرف هاش_فنڤ1أ_طبيعي_للنص(القيمة: &نص): طبيعي {
    أرجع هاش_فنڤ1أ_32_نص(القيمة) مثل طبيعي;
}

عام مرادف fnv1a32_bytes = هاش_فنڤ1أ_32_بايتات;
عام مرادف fnv1a32_text = هاش_فنڤ1أ_32_نص;
عام مرادف hash_bytes_fnv1a = هاش_فنڤ1أ_طبيعي_للبايتات;
عام مرادف hash_text_fnv1a = هاش_فنڤ1أ_طبيعي_للنص;

// Old names, kept for one release: the unsigned type is now `طبيعي`.
عام مرادف هاش_فنڤ1أ_غير_موقع_للبايتات = هاش_فنڤ1أ_طبيعي_للبايتات;
عام مرادف هاش_فنڤ1أ_غير_موقع_للنص = هاش_فنڤ1أ_طبيعي_للنص;
