// Deterministic non-cryptographic FNV-1a hashing for bytes and UTF-8 text.
// This is suitable for hash-table keys and stable tooling data, not security.

عام عرف هاش_فنڤ1أ_32_بايتات(القيمة: &متجه غ8): غ32 {
    دع المصدر: متجه غ8 = *القيمة;
    دع هاش: متغير غير_موقع = 2166136261;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        هاش := هاش ^ (المصدر[ف] مثل غير_موقع);
        هاش := (هاش * 16777619) % 4294967296;
        ف := ف + 1;
    }
    أرجع هاش مثل غ32;
}

عام عرف هاش_فنڤ1أ_32_نص(القيمة: &نص): غ32 {
    دع المصدر: نص = *القيمة;
    دع هاش: متغير غير_موقع = 2166136261;
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) {
        هاش := هاش ^ (المصدر[ف] مثل غير_موقع);
        هاش := (هاش * 16777619) % 4294967296;
        ف := ف + 1;
    }
    أرجع هاش مثل غ32;
}

عام عرف هاش_فنڤ1أ_غير_موقع_للبايتات(القيمة: &متجه غ8): غير_موقع {
    أرجع هاش_فنڤ1أ_32_بايتات(القيمة) مثل غير_موقع;
}

عام عرف هاش_فنڤ1أ_غير_موقع_للنص(القيمة: &نص): غير_موقع {
    أرجع هاش_فنڤ1أ_32_نص(القيمة) مثل غير_موقع;
}

عام مرادف fnv1a32_bytes = هاش_فنڤ1أ_32_بايتات;
عام مرادف fnv1a32_text = هاش_فنڤ1أ_32_نص;
عام مرادف hash_bytes_fnv1a = هاش_فنڤ1أ_غير_موقع_للبايتات;
عام مرادف hash_text_fnv1a = هاش_فنڤ1أ_غير_موقع_للنص;
