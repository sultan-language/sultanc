// XXH64 (the xxHash 64-bit algorithm, as specified in xxHash's
// doc/xxhash_spec.md and used by the zstd content checksum, RFC 8878 3.1.1).
// Non-cryptographic. The 64-bit lanes use the compiler's wrapping intrinsics,
// one machine operation each, as std.crypto.words64 does: ordinary SultanC
// arithmetic traps on overflow.

مرادف جمع_ملتف_بدائيا = بدائي_جمع_ملتف;
مرادف طرح_ملتف_بدائيا = بدائي_طرح_ملتف;
مرادف ضرب_ملتف_بدائيا = بدائي_ضرب_ملتف;
مرادف إزاحة_يسرى_ملتفة_بدائيا = بدائي_إزاحة_يسرى_ملتفة;

عرف أولي1_إكس_إكس_إتش64(): طبيعي { أرجع 11400714785074694791; }
عرف أولي2_إكس_إكس_إتش64(): طبيعي { أرجع 14029467366897019727; }
عرف أولي3_إكس_إكس_إتش64(): طبيعي { أرجع 1609587929392839161; }
عرف أولي4_إكس_إكس_إتش64(): طبيعي { أرجع 9650029242287828579; }
عرف أولي5_إكس_إكس_إتش64(): طبيعي { أرجع 2870177450012600261; }

// The amount is 1..63.
عرف دور_يسار_إكس_إكس_إتش64(القيمة: طبيعي, المقدار: طبيعي): طبيعي {
    أرجع إزاحة_يسرى_ملتفة_بدائيا(القيمة, المقدار) | (القيمة >> (64 - المقدار));
}

عرف اقرأ_صغير64_إكس_إكس_إتش(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    أرجع ((*البايتات)[الموضع] مثل طبيعي)
        | (((*البايتات)[الموضع + 1] مثل طبيعي) << 8)
        | (((*البايتات)[الموضع + 2] مثل طبيعي) << 16)
        | (((*البايتات)[الموضع + 3] مثل طبيعي) << 24)
        | (((*البايتات)[الموضع + 4] مثل طبيعي) << 32)
        | (((*البايتات)[الموضع + 5] مثل طبيعي) << 40)
        | (((*البايتات)[الموضع + 6] مثل طبيعي) << 48)
        | (((*البايتات)[الموضع + 7] مثل طبيعي) << 56);
}

عرف اقرأ_صغير32_إكس_إكس_إتش(البايتات: &متجه ط8, الموضع: طبيعي): طبيعي {
    أرجع ((*البايتات)[الموضع] مثل طبيعي)
        | (((*البايتات)[الموضع + 1] مثل طبيعي) << 8)
        | (((*البايتات)[الموضع + 2] مثل طبيعي) << 16)
        | (((*البايتات)[الموضع + 3] مثل طبيعي) << 24);
}

عرف جولة_إكس_إكس_إتش64(المجمع: طبيعي, المدخل: طبيعي): طبيعي {
    دع س: طبيعي = جمع_ملتف_بدائيا(المجمع, ضرب_ملتف_بدائيا(المدخل, أولي2_إكس_إكس_إتش64()));
    أرجع ضرب_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(س, 31), أولي1_إكس_إكس_إتش64());
}

عرف ادمج_جولة_إكس_إكس_إتش64(المجمع: طبيعي, القيمة: طبيعي): طبيعي {
    دع س: طبيعي = المجمع ^ جولة_إكس_إكس_إتش64(0, القيمة);
    أرجع جمع_ملتف_بدائيا(ضرب_ملتف_بدائيا(س, أولي1_إكس_إكس_إتش64()), أولي4_إكس_إكس_إتش64());
}

// XXH64 of البايتات[البداية..النهاية) with a seed.
عام عرف هاش_إكس_إكس_إتش64_لمدى(البايتات: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, البذرة: طبيعي): طبيعي {
    دع الطول: طبيعي = النهاية - البداية;
    دع ف: متغير طبيعي = البداية;
    دع الهاش: متغير طبيعي = 0;
    إذا (الطول >= 32) {
        دع م1: متغير طبيعي = جمع_ملتف_بدائيا(جمع_ملتف_بدائيا(البذرة, أولي1_إكس_إكس_إتش64()), أولي2_إكس_إكس_إتش64());
        دع م2: متغير طبيعي = جمع_ملتف_بدائيا(البذرة, أولي2_إكس_إكس_إتش64());
        دع م3: متغير طبيعي = البذرة;
        دع م4: متغير طبيعي = طرح_ملتف_بدائيا(البذرة, أولي1_إكس_إكس_إتش64());
        طالما (ف + 32 <= النهاية) {
            م1 := جولة_إكس_إكس_إتش64(م1, اقرأ_صغير64_إكس_إكس_إتش(البايتات, ف));
            م2 := جولة_إكس_إكس_إتش64(م2, اقرأ_صغير64_إكس_إكس_إتش(البايتات, ف + 8));
            م3 := جولة_إكس_إكس_إتش64(م3, اقرأ_صغير64_إكس_إكس_إتش(البايتات, ف + 16));
            م4 := جولة_إكس_إكس_إتش64(م4, اقرأ_صغير64_إكس_إكس_إتش(البايتات, ف + 24));
            ف := ف + 32;
        }
        الهاش := جمع_ملتف_بدائيا(
            جمع_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(م1, 1), دور_يسار_إكس_إكس_إتش64(م2, 7)),
            جمع_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(م3, 12), دور_يسار_إكس_إكس_إتش64(م4, 18))
        );
        الهاش := ادمج_جولة_إكس_إكس_إتش64(الهاش, م1);
        الهاش := ادمج_جولة_إكس_إكس_إتش64(الهاش, م2);
        الهاش := ادمج_جولة_إكس_إكس_إتش64(الهاش, م3);
        الهاش := ادمج_جولة_إكس_إكس_إتش64(الهاش, م4);
    } وإلا {
        الهاش := جمع_ملتف_بدائيا(البذرة, أولي5_إكس_إكس_إتش64());
    };
    الهاش := جمع_ملتف_بدائيا(الهاش, الطول);
    طالما (ف + 8 <= النهاية) {
        الهاش := الهاش ^ جولة_إكس_إكس_إتش64(0, اقرأ_صغير64_إكس_إكس_إتش(البايتات, ف));
        الهاش := جمع_ملتف_بدائيا(ضرب_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(الهاش, 27), أولي1_إكس_إكس_إتش64()), أولي4_إكس_إكس_إتش64());
        ف := ف + 8;
    }
    إذا (ف + 4 <= النهاية) {
        الهاش := الهاش ^ ضرب_ملتف_بدائيا(اقرأ_صغير32_إكس_إكس_إتش(البايتات, ف), أولي1_إكس_إكس_إتش64());
        الهاش := جمع_ملتف_بدائيا(ضرب_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(الهاش, 23), أولي2_إكس_إكس_إتش64()), أولي3_إكس_إكس_إتش64());
        ف := ف + 4;
    };
    طالما (ف < النهاية) {
        الهاش := الهاش ^ ضرب_ملتف_بدائيا((*البايتات)[ف] مثل طبيعي, أولي5_إكس_إكس_إتش64());
        الهاش := ضرب_ملتف_بدائيا(دور_يسار_إكس_إكس_إتش64(الهاش, 11), أولي1_إكس_إكس_إتش64());
        ف := ف + 1;
    }
    الهاش := الهاش ^ (الهاش >> 33);
    الهاش := ضرب_ملتف_بدائيا(الهاش, أولي2_إكس_إكس_إتش64());
    الهاش := الهاش ^ (الهاش >> 29);
    الهاش := ضرب_ملتف_بدائيا(الهاش, أولي3_إكس_إكس_إتش64());
    الهاش := الهاش ^ (الهاش >> 32);
    أرجع الهاش;
}

عام عرف هاش_إكس_إكس_إتش64_ببذرة(البايتات: &متجه ط8, البذرة: طبيعي): طبيعي {
    أرجع هاش_إكس_إكس_إتش64_لمدى(البايتات, 0, الطول(*البايتات) مثل طبيعي, البذرة);
}

عام عرف هاش_إكس_إكس_إتش64(البايتات: &متجه ط8): طبيعي {
    أرجع هاش_إكس_إكس_إتش64_لمدى(البايتات, 0, الطول(*البايتات) مثل طبيعي, 0);
}

عام مرادف xxh64 = هاش_إكس_إكس_إتش64;
عام مرادف xxh64_with_seed = هاش_إكس_إكس_إتش64_ببذرة;
عام مرادف xxh64_range = هاش_إكس_إكس_إتش64_لمدى;
