// مولد Park-Miller حتمي. لا يدعي entropy أو أمانا تشفيريا ولا يستدعي المضيف.
عام نوع مولد_عشوائي = {
    الحالة: غير_موقع
};

عام عرف أنشئ_مولد_عشوائي(البذرة: غير_موقع): مولد_عشوائي {
    دع الحالة: متغير غير_موقع = البذرة % 2147483647;
    لو (الحالة == 0) { الحالة := 1; };
    دع المولد: مولد_عشوائي = { الحالة: الحالة };
    أرجع المولد;
}

عام عرف عشوائي_تالي(المولد: &متغير مولد_عشوائي): غير_موقع {
    دع الحالة: متغير مولد_عشوائي = *المولد;
    الحالة.الحالة := (الحالة.الحالة * 48271) % 2147483647;
    دع الناتج: غير_موقع = الحالة.الحالة;
    *المولد := الحالة;
    أرجع الناتج;
}

عام عرف عشوائي_أقل_من(المولد: &متغير مولد_عشوائي, الحد: غير_موقع): اختيار غير_موقع {
    لو (الحد == 0) { أرجع اختيار.لا_شيء(); };
    دع المجال: غير_موقع = 2147483646;
    لو (الحد > المجال) { أرجع اختيار.لا_شيء(); };
    دع المقبول: غير_موقع = المجال - (المجال % الحد);
    دع القيمة: متغير غير_موقع = عشوائي_تالي(المولد) - 1;
    بينما (القيمة >= المقبول) { القيمة := عشوائي_تالي(المولد) - 1; }
    أرجع اختيار.بعض(القيمة % الحد);
}

عام مرادف prng = مولد_عشوائي;
عام مرادف new_prng = أنشئ_مولد_عشوائي;
عام مرادف prng_next = عشوائي_تالي;
عام مرادف prng_below = عشوائي_أقل_من;

عام عرف عشوائي_بين(المولد: &متغير مولد_عشوائي, الأدنى: غير_موقع, الأعلى_حصري: غير_موقع): اختيار غير_موقع {
    لو (الأعلى_حصري <= الأدنى) { أرجع اختيار.لا_شيء(); };
    دع العرض: غير_موقع = الأعلى_حصري - الأدنى;
    طابق عشوائي_أقل_من(المولد, العرض) مع
    | اختيار.لا_شيء -> { أرجع اختيار.لا_شيء(); }
    | اختيار.بعض(القيمة) -> { أرجع اختيار.بعض(الأدنى + القيمة); };
}

عام عرف عشوائي_منطقي(المولد: &متغير مولد_عشوائي): منطقي {
    طابق عشوائي_أقل_من(المولد, 2) مع
    | اختيار.بعض(القيمة) -> { أرجع القيمة == 1; }
    | اختيار.لا_شيء -> { أرجع خطأ; };
}

عام عرف عشوائي_بايت(المولد: &متغير مولد_عشوائي): غ8 {
    طابق عشوائي_أقل_من(المولد, 256) مع
    | اختيار.بعض(القيمة) -> { أرجع القيمة مثل غ8; }
    | اختيار.لا_شيء -> { أرجع 0; };
}

عام مرادف prng_range = عشوائي_بين;
عام مرادف prng_bool = عشوائي_منطقي;
عام مرادف prng_byte = عشوائي_بايت;
