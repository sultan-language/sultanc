// مولد Park-Miller حتمي. لا يدعي entropy أو أمانا تشفيريا ولا يستدعي المضيف.
عام نوع مولد_عشوائي = {
    الحالة: طبيعي
};

عام عرف أنشئ_مولد_عشوائي(البذرة: طبيعي): مولد_عشوائي {
    دع الحالة: متغير طبيعي = البذرة % 2147483647;
    إذا (الحالة == 0) { الحالة := 1; };
    دع المولد: مولد_عشوائي = { الحالة: الحالة };
    أرجع المولد;
}

عام عرف عشوائي_تالي(المولد: &متغير مولد_عشوائي): طبيعي {
    (*المولد).الحالة := ((*المولد).الحالة * 48271) % 2147483647;
    دع الناتج: طبيعي = (*المولد).الحالة;
    أرجع الناتج;
}

عام عرف عشوائي_أقل_من(المولد: &متغير مولد_عشوائي, الحد: طبيعي): اختياري طبيعي {
    إذا (الحد == 0) { أرجع اختياري.لا_شيء(); };
    دع المجال: طبيعي = 2147483646;
    إذا (الحد > المجال) { أرجع اختياري.لا_شيء(); };
    دع المقبول: طبيعي = المجال - (المجال % الحد);
    دع القيمة: متغير طبيعي = عشوائي_تالي(المولد) - 1;
    طالما (القيمة >= المقبول) { القيمة := عشوائي_تالي(المولد) - 1; }
    أرجع اختياري.موجود(القيمة % الحد);
}

عام مرادف prng = مولد_عشوائي;
عام مرادف new_prng = أنشئ_مولد_عشوائي;
عام مرادف prng_next = عشوائي_تالي;
عام مرادف prng_below = عشوائي_أقل_من;

عام عرف عشوائي_بين(المولد: &متغير مولد_عشوائي, الأدنى: طبيعي, الأعلى_حصري: طبيعي): اختياري طبيعي {
    إذا (الأعلى_حصري <= الأدنى) { أرجع اختياري.لا_شيء(); };
    دع العرض: طبيعي = الأعلى_حصري - الأدنى;
    طابق عشوائي_أقل_من(المولد, العرض) مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(الأدنى + القيمة); };
}

عام عرف عشوائي_منطقي(المولد: &متغير مولد_عشوائي): منطقي {
    طابق عشوائي_أقل_من(المولد, 2) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة == 1; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

عام عرف عشوائي_بايت(المولد: &متغير مولد_عشوائي): ط8 {
    طابق عشوائي_أقل_من(المولد, 256) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة مثل ط8; }
    | اختياري.لا_شيء -> { أرجع 0; };
}

عام مرادف prng_range = عشوائي_بين;
عام مرادف prng_bool = عشوائي_منطقي;
عام مرادف prng_byte = عشوائي_بايت;
