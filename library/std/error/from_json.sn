// Converter to فشل for std.json parse errors.
// Domain «std.json», kind = the variant name of صنف_خطأ_جسون; the byte
// offset is kept as a note. The message is Arabic, with an English language
// version («en»).
استورد error.failure;
استورد json.value;
استورد text.number;
استورد text.from_bytes;

// The note «<prefix><value>»; Stage0-compatible text concatenation.
عرف نص_ملاحظة_جسون(البادئة: نص, القيمة: نص): نص {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(البادئة);
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

عرف اسم_صنف_خطأ_جسون(الصنف: &صنف_خطأ_جسون): نص {
    طابق *الصنف مع
    | صنف_خطأ_جسون.نهاية_غير_متوقعة -> { أرجع «نهاية_غير_متوقعة»; }
    | صنف_خطأ_جسون.رمز_غير_متوقع -> { أرجع «رمز_غير_متوقع»; }
    | صنف_خطأ_جسون.محرف_هروب_غير_صالح -> { أرجع «محرف_هروب_غير_صالح»; }
    | صنف_خطأ_جسون.هروب_يونيكود_غير_صالح -> { أرجع «هروب_يونيكود_غير_صالح»; }
    | صنف_خطأ_جسون.يوتيف8_غير_صالح -> { أرجع «يوتيف8_غير_صالح»; }
    | صنف_خطأ_جسون.رقم_غير_صالح -> { أرجع «رقم_غير_صالح»; }
    | صنف_خطأ_جسون.نص_لاحق -> { أرجع «نص_لاحق»; }
    | صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل -> { أرجع «سعة_كائن_غير_قابلة_للتمثيل»; }
    | صنف_خطأ_جسون.تعشيش_عميق_جدا -> { أرجع «تعشيش_عميق_جدا»; };
}

عرف رسالة_صنف_خطأ_جسون(الصنف: &صنف_خطأ_جسون): نص {
    طابق *الصنف مع
    | صنف_خطأ_جسون.نهاية_غير_متوقعة -> { أرجع «انتهى نص JSON قبل اكتمال القيمة»; }
    | صنف_خطأ_جسون.رمز_غير_متوقع -> { أرجع «رمز غير متوقع في نص JSON»; }
    | صنف_خطأ_جسون.محرف_هروب_غير_صالح -> { أرجع «محرف هروب غير صالح في سلسلة JSON»; }
    | صنف_خطأ_جسون.هروب_يونيكود_غير_صالح -> { أرجع «هروب يونيكود غير صالح في سلسلة JSON»; }
    | صنف_خطأ_جسون.يوتيف8_غير_صالح -> { أرجع «نص JSON ليس UTF-8 صالحا»; }
    | صنف_خطأ_جسون.رقم_غير_صالح -> { أرجع «رقم غير صالح في نص JSON»; }
    | صنف_خطأ_جسون.نص_لاحق -> { أرجع «نص زائد بعد قيمة JSON»; }
    | صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل -> { أرجع «حجم كائن JSON لا يمكن تمثيله»; }
    | صنف_خطأ_جسون.تعشيش_عميق_جدا -> { أرجع «تعشيش JSON أعمق من الحد المسموح»; };
}

عرف رسالة_إنجليزية_صنف_خطأ_جسون(الصنف: &صنف_خطأ_جسون): نص {
    طابق *الصنف مع
    | صنف_خطأ_جسون.نهاية_غير_متوقعة -> { أرجع «the JSON text ended before the value was complete»; }
    | صنف_خطأ_جسون.رمز_غير_متوقع -> { أرجع «unexpected token in the JSON text»; }
    | صنف_خطأ_جسون.محرف_هروب_غير_صالح -> { أرجع «invalid escape character in a JSON string»; }
    | صنف_خطأ_جسون.هروب_يونيكود_غير_صالح -> { أرجع «invalid Unicode escape in a JSON string»; }
    | صنف_خطأ_جسون.يوتيف8_غير_صالح -> { أرجع «the JSON text is not valid UTF-8»; }
    | صنف_خطأ_جسون.رقم_غير_صالح -> { أرجع «invalid number in the JSON text»; }
    | صنف_خطأ_جسون.نص_لاحق -> { أرجع «extra text after the JSON value»; }
    | صنف_خطأ_جسون.سعة_كائن_غير_قابلة_للتمثيل -> { أرجع «the size of a JSON object cannot be represented»; }
    | صنف_خطأ_جسون.تعشيش_عميق_جدا -> { أرجع «JSON nesting is deeper than the limit»; };
}

عام عرف فشل_من_خطأ_جسون(الخطأ: &خطأ_جسون): فشل {
    دع الصنف: صنف_خطأ_جسون = (*الخطأ).الصنف;
    دع الناتج: متغير فشل = فشل_بهوية(
        «std.json», اسم_صنف_خطأ_جسون(&الصنف), رسالة_صنف_خطأ_جسون(&الصنف)
    );
    أضف_نسخة_لغة(&متغير الناتج, «en», رسالة_إنجليزية_صنف_خطأ_جسون(&الصنف));
    أضف_ملاحظة(&متغير الناتج, نص_ملاحظة_جسون(«إزاحة البايت: », طبيعي_إلى_نص((*الخطأ).الإزاحة)));
    أرجع الناتج;
}

عام مرادف error_from_json_error = فشل_من_خطأ_جسون;
