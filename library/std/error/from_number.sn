// Converter to فشل for std.text.number parse errors.
// Domain «std.text.number», kind = the variant name of خطأ_تحليل_عدد. The
// message is Arabic, with an English language version («en»).
استورد error.failure;
استورد text.number;
استورد text.from_bytes;

// The note «<prefix><value>»; Stage0-compatible text concatenation.
عرف نص_ملاحظة_تحليل_عدد(البادئة: نص, القيمة: نص): نص {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(البادئة);
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

// The error with an English language version of its message.
عرف فشل_تحليل_عدد_بنسخة_إنجليزية(الفشل: فشل, الإنجليزية: نص): فشل {
    دع الناتج: متغير فشل = الفشل;
    أضف_نسخة_لغة(&متغير الناتج, «en», الإنجليزية);
    أرجع الناتج;
}

عام عرف فشل_من_خطأ_تحليل_عدد(الخطأ: &خطأ_تحليل_عدد): فشل {
    دع النطاق: نص = «std.text.number»;
    طابق *الخطأ مع
    | خطأ_تحليل_عدد.نص_فارغ -> {
        أرجع فشل_تحليل_عدد_بنسخة_إنجليزية(فشل_بهوية(النطاق, «نص_فارغ», «النص المراد تحليله عددا فارغ»),
            «the text to parse as a number is empty»);
    }
    | خطأ_تحليل_عدد.إشارة_بلا_أرقام -> {
        أرجع فشل_تحليل_عدد_بنسخة_إنجليزية(فشل_بهوية(النطاق, «إشارة_بلا_أرقام», «إشارة العدد ليس بعدها أرقام»),
            «the sign of the number has no digits after it»);
    }
    | خطأ_تحليل_عدد.رقم_غير_صالح(الموضع) -> {
        دع الناتج: متغير فشل = فشل_بهوية(النطاق, «رقم_غير_صالح», «في النص محرف ليس رقما عشريا»);
        أضف_نسخة_لغة(&متغير الناتج, «en», «the text has a character that is not a decimal digit»);
        أضف_ملاحظة(&متغير الناتج, نص_ملاحظة_تحليل_عدد(«موضع البايت: », طبيعي_إلى_نص(الموضع)));
        أرجع الناتج;
    }
    | خطأ_تحليل_عدد.تجاوز -> {
        أرجع فشل_تحليل_عدد_بنسخة_إنجليزية(فشل_بهوية(النطاق, «تجاوز», «العدد خارج مدى النوع»),
            «the number is out of the type's range»);
    }
    | خطأ_تحليل_عدد.سالب_لطبيعي -> {
        أرجع فشل_تحليل_عدد_بنسخة_إنجليزية(فشل_بهوية(النطاق, «سالب_لطبيعي», «عدد سالب لنوع طبيعي»),
            «a negative number for an unsigned type»);
    };
}

عام مرادف error_from_integer_parse_error = فشل_من_خطأ_تحليل_عدد;
