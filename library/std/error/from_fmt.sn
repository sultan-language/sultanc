// Converter to فشل for std.fmt errors.
// Domain «std.fmt», kind = the variant name of خطأ_تنسيق. The message is
// Arabic, with an English language version («en»); the byte offset, the
// argument index or the writer status is a note.
استورد error.failure;
استورد fmt.fmt;
استورد text.number;
استورد text.from_bytes;

// The note «<prefix><value>»; Stage0-compatible text concatenation.
عرف نص_ملاحظة_تنسيق(البادئة: نص, القيمة: نص): نص {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(البادئة);
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

عرف فشل_تنسيق(النوع: نص, العربية: نص, الإنجليزية: نص, الملاحظة: نص, القيمة: نص): فشل {
    دع الناتج: متغير فشل = فشل_بهوية(«std.fmt», النوع, العربية);
    أضف_نسخة_لغة(&متغير الناتج, «en», الإنجليزية);
    لو ((الطول(الملاحظة) مثل طبيعي) > 0) {
        أضف_ملاحظة(&متغير الناتج, نص_ملاحظة_تنسيق(الملاحظة, القيمة));
    };
    أرجع الناتج;
}

عام عرف فشل_من_خطأ_تنسيق(الخطأ: &خطأ_تنسيق): فشل {
    طابق *الخطأ مع
    | خطأ_تنسيق.قوس_غير_مغلق(الموضع) -> {
        أرجع فشل_تنسيق(«قوس_غير_مغلق», «في قالب التنسيق قوس { لم يغلق»,
            «the format string has a { that is not closed», «موضع البايت: », طبيعي_إلى_نص(الموضع));
    }
    | خطأ_تنسيق.قوس_إغلاق_منفرد(الموضع) -> {
        أرجع فشل_تنسيق(«قوس_إغلاق_منفرد», «في قالب التنسيق قوس } بلا قوس فتح (اكتب }} لقوس حرفي)»,
            «the format string has a } without an opening { (write }} for a literal one)», «موضع البايت: », طبيعي_إلى_نص(الموضع));
    }
    | خطأ_تنسيق.مواصفة_غير_صالحة(الموضع) -> {
        أرجع فشل_تنسيق(«مواصفة_غير_صالحة», «مواصفة التنسيق غير صالحة»,
            «the format spec is not valid», «موضع البايت: », طبيعي_إلى_نص(الموضع));
    }
    | خطأ_تنسيق.نوع_غير_معروف(الموضع) -> {
        أرجع فشل_تنسيق(«نوع_غير_معروف», «نوع التنسيق غير معروف (المعروفة: ? x X o b e E x? X?)»,
            «the format type is unknown (known: ? x X o b e E x? X?)», «موضع البايت: », طبيعي_إلى_نص(الموضع));
    }
    | خطأ_تنسيق.وسيط_مسمى(الموضع) -> {
        أرجع فشل_تنسيق(«وسيط_مسمى», «الوسائط المسماة غير مدعومة؛ استعمل رقم الوسيط»,
            «named arguments are not supported; use the argument's index», «موضع البايت: », طبيعي_إلى_نص(الموضع));
    }
    | خطأ_تنسيق.وسيط_مفقود(الفهرس) -> {
        أرجع فشل_تنسيق(«وسيط_مفقود», «يشير قالب التنسيق إلى وسيط غير موجود»,
            «the format string refers to an argument that is not there», «رقم الوسيط: », طبيعي_إلى_نص(الفهرس));
    }
    | خطأ_تنسيق.وسيط_غير_مستخدم(الفهرس) -> {
        أرجع فشل_تنسيق(«وسيط_غير_مستخدم», «وسيط لا يستعمله قالب التنسيق»,
            «an argument is not used by the format string», «رقم الوسيط: », طبيعي_إلى_نص(الفهرس));
    }
    | خطأ_تنسيق.نوع_غير_مناسب(الفهرس) -> {
        أرجع فشل_تنسيق(«نوع_غير_مناسب», «نوع التنسيق لا ينطبق على نوع الوسيط»,
            «the format type does not apply to the argument's type», «رقم الوسيط: », طبيعي_إلى_نص(الفهرس));
    }
    | خطأ_تنسيق.عدد_غير_صالح(الفهرس) -> {
        أرجع فشل_تنسيق(«عدد_غير_صالح», «وسيط العرض أو الدقة ليس عددا صحيحا بين 0 و65535»,
            «the width or precision argument is not an integer from 0 to 65535», «رقم الوسيط: », طبيعي_إلى_نص(الفهرس));
    }
    | خطأ_تنسيق.فشل_الكتابة(الرمز) -> {
        أرجع فشل_تنسيق(«فشل_الكتابة», «تعذرت كتابة النص المنسق»,
            «the formatted text could not be written», «رمز الحالة: », عدد_إلى_نص(الرمز));
    }
    | خطأ_تنسيق.فشل_مخصص -> {
        أرجع فشل_تنسيق(«فشل_مخصص», «فشل منسق مخصص», «a custom formatter failed», «», «»);
    };
}

عام مرادف error_from_fmt_error = فشل_من_خطأ_تنسيق;
