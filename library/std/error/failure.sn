// std.error: the common, language-independent error value (docs/en/reference/errors.md).
//
// A فشل carries an identity (النطاق, النوع), one developer message in the
// author's language, an optional cause and notes. Code decides by identity or
// by a typed error enum, never by message text. Callers use the functions
// below only; the fields are an implementation detail.
//
// This module is pure SultanC and Stage0-compatible: no copy primitive, no
// reference returns, no references stored in records or mutable locals, and
// no calls inside vector literals. Compiler and runtime diagnostics never use
// it; they stay in iSpeak.
//
// Language versions (optional, never required): an author may give the
// message in other languages, each under a BCP 47 tag; نص_فشل_بلغة chooses
// one for a locale (text.language) and صف_فشل_بلغة renders the whole chain
// in it. Nothing else reads them: the identity, صف_فشل and every other
// function work on the author's message alone.
استورد text.from_bytes;
استورد text.compare;
استورد text.language;
استورد text.bidi;
استورد io.println;

// One language version of the message: a BCP 47 tag in canonical case and
// the message in that language.
نوع نسخة_لغة_فشل = {
    الوسم: نص,
    النص: نص
};

عام نوع فشل = {
    النطاق: نص,
    النوع: نص,
    الرسالة: نص,
    السبب: اختياري صندوق فشل,
    الملاحظات: متجه نص,
    النسخ: متجه نسخة_لغة_فشل
};

// --- Constructors ----------------------------------------------------------

// An ad-hoc error: empty identity.
عام عرف فشل_من(الرسالة: نص): فشل {
    دع النطاق: نص = «»;
    دع النوع: نص = «»;
    دع الملاحظات: متجه نص = [];
    دع النسخ: متجه نسخة_لغة_فشل = [];
    دع الناتج: فشل = {
        النطاق: النطاق,
        النوع: النوع,
        الرسالة: الرسالة,
        السبب: اختياري.لا_شيء(),
        الملاحظات: الملاحظات,
        النسخ: النسخ
    };
    أرجع الناتج;
}

// An error with a stable identity: the owning module or package, and a
// machine kind inside it.
عام عرف فشل_بهوية(النطاق: نص, النوع: نص, الرسالة: نص): فشل {
    دع الملاحظات: متجه نص = [];
    دع النسخ: متجه نسخة_لغة_فشل = [];
    دع الناتج: فشل = {
        النطاق: النطاق,
        النوع: النوع,
        الرسالة: الرسالة,
        السبب: اختياري.لا_شيء(),
        الملاحظات: الملاحظات,
        النسخ: النسخ
    };
    أرجع الناتج;
}

// An ad-hoc error that wraps a cause. The cause is moved in.
عام عرف فشل_بسبب(الرسالة: نص, السبب: فشل): فشل {
    دع النطاق: نص = «»;
    دع النوع: نص = «»;
    دع الملاحظات: متجه نص = [];
    دع النسخ: متجه نسخة_لغة_فشل = [];
    دع الصندوق: صندوق فشل = صندوق السبب;
    دع الناتج: فشل = {
        النطاق: النطاق,
        النوع: النوع,
        الرسالة: الرسالة,
        السبب: اختياري.موجود(الصندوق),
        الملاحظات: الملاحظات,
        النسخ: النسخ
    };
    أرجع الناتج;
}

// An error with a stable identity that wraps a cause. The cause is moved in.
عام عرف فشل_بهوية_وسبب(النطاق: نص, النوع: نص, الرسالة: نص, السبب: فشل): فشل {
    دع الملاحظات: متجه نص = [];
    دع النسخ: متجه نسخة_لغة_فشل = [];
    دع الصندوق: صندوق فشل = صندوق السبب;
    دع الناتج: فشل = {
        النطاق: النطاق,
        النوع: النوع,
        الرسالة: الرسالة,
        السبب: اختياري.موجود(الصندوق),
        الملاحظات: الملاحظات,
        النسخ: النسخ
    };
    أرجع الناتج;
}

// --- Copies ----------------------------------------------------------------

عرف انسخ_ملاحظات_فشل(الملاحظات: &متجه نص): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع العدد: طبيعي = الطول(*الملاحظات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الناتج, انسخ_نص(&(*الملاحظات)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف انسخ_نسخ_لغات_فشل(النسخ: &متجه نسخة_لغة_فشل): متجه نسخة_لغة_فشل {
    دع الناتج: متغير متجه نسخة_لغة_فشل = [];
    دع العدد: طبيعي = الطول(*النسخ) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الوسم: نص = انسخ_نص(&(*النسخ)[ف].الوسم);
        دع النص: نص = انسخ_نص(&(*النسخ)[ف].النص);
        دع النسخة: نسخة_لغة_فشل = { الوسم: الوسم, النص: النص };
        ألحق(الناتج, النسخة);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// An independent deep copy, causes and language versions included. `استنسخ(&ف)` gives the same
// result; this function is the spelling Stage0-compiled code can use.
عام عرف انسخ_فشل(الفشل: &فشل): فشل {
    دع السبب: متغير اختياري صندوق فشل = اختياري.لا_شيء();
    طابق (*الفشل).السبب مع
    | اختياري.موجود(الأصل) -> {
        دع النسخة: فشل = انسخ_فشل(&(*الأصل));
        دع الصندوق: صندوق فشل = صندوق النسخة;
        السبب := اختياري.موجود(الصندوق);
    }
    | اختياري.لا_شيء -> { };
    دع النطاق: نص = انسخ_نص(&(*الفشل).النطاق);
    دع النوع: نص = انسخ_نص(&(*الفشل).النوع);
    دع الرسالة: نص = انسخ_نص(&(*الفشل).الرسالة);
    دع الملاحظات: متجه نص = انسخ_ملاحظات_فشل(&(*الفشل).الملاحظات);
    دع النسخ: متجه نسخة_لغة_فشل = انسخ_نسخ_لغات_فشل(&(*الفشل).النسخ);
    دع الناتج: فشل = {
        النطاق: النطاق,
        النوع: النوع,
        الرسالة: الرسالة,
        السبب: السبب,
        الملاحظات: الملاحظات,
        النسخ: النسخ
    };
    أرجع الناتج;
}

// --- Accessors (owned copies: Stage0 cannot return references) ------------

عام عرف رسالة_فشل(الفشل: &فشل): نص {
    أرجع انسخ_نص(&(*الفشل).الرسالة);
}

عام عرف نطاق_فشل(الفشل: &فشل): نص {
    أرجع انسخ_نص(&(*الفشل).النطاق);
}

عام عرف نوع_فشل(الفشل: &فشل): نص {
    أرجع انسخ_نص(&(*الفشل).النوع);
}

عام عرف له_سبب(الفشل: &فشل): منطقي {
    طابق (*الفشل).السبب مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// A copy of the direct cause.
عام عرف سبب_فشل(الفشل: &فشل): اختياري فشل {
    طابق (*الفشل).السبب مع
    | اختياري.موجود(الأصل) -> {
        دع النسخة: فشل = انسخ_فشل(&(*الأصل));
        أرجع اختياري.موجود(النسخة);
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

// A copy of the notes, in the order they were added.
عام عرف ملاحظات_فشل(الفشل: &فشل): متجه نص {
    أرجع انسخ_ملاحظات_فشل(&(*الفشل).الملاحظات);
}

// Whether this error or any cause in its chain has the identity
// (النطاق, النوع). An empty kind is no identity: it never matches.
عام عرف هل_من_نوع(الفشل: &فشل, النطاق: &نص, النوع: &نص): منطقي {
    إذا ((الطول(*النوع) مثل طبيعي) == 0) { أرجع خطأ; };
    إذا (نصان_متساويان(&(*الفشل).النوع, النوع)
        && نصان_متساويان(&(*الفشل).النطاق, النطاق)) {
        أرجع صواب;
    };
    طابق (*الفشل).السبب مع
    | اختياري.موجود(الأصل) -> { أرجع هل_من_نوع(&(*الأصل), النطاق, النوع); }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// --- Mutation --------------------------------------------------------------

// Appends a note. The identity and the message do not change.
عام عرف أضف_ملاحظة(الفشل: &متغير فشل, الملاحظة: نص): فراغ {
    ألحق((*الفشل).الملاحظات, الملاحظة);
}

// --- Developer rendering (one language; fixed std connector words) --------

عرف ألحق_نصا_بالبايتات(البايتات: &متغير متجه ط8, النص: &نص): فراغ {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(*البايتات, (*النص)[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_ملاحظات_بالبايتات(البايتات: &متغير متجه ط8, الفشل: &فشل): فراغ {
    دع بادئة: نص = "\nملاحظة: ";
    دع العدد: طبيعي = الطول((*الفشل).الملاحظات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_نصا_بالبايتات(البايتات, &بادئة);
        ألحق_نصا_بالبايتات(البايتات, &(*الفشل).الملاحظات[ف]);
        ف := ف + 1;
    }
}

عرف ألحق_أسبابا_بالبايتات(البايتات: &متغير متجه ط8, الفشل: &فشل): فراغ {
    طابق (*الفشل).السبب مع
    | اختياري.موجود(الأصل) -> {
        دع بادئة: نص = "\nبسبب: ";
        ألحق_نصا_بالبايتات(البايتات, &بادئة);
        ألحق_نصا_بالبايتات(البايتات, &(*الأصل).الرسالة);
        ألحق_ملاحظات_بالبايتات(البايتات, &(*الأصل));
        ألحق_أسبابا_بالبايتات(البايتات, &(*الأصل));
    }
    | اختياري.لا_شيء -> { };
}

// The message, then its notes («ملاحظة: …»), then one «بسبب: …» line per
// cause, each followed by that cause's notes. Lines are separated by "\n";
// there is no trailing newline.
عام عرف صف_فشل(الفشل: &فشل): نص {
    دع البايتات: متغير متجه ط8 = [];
    ألحق_نصا_بالبايتات(&متغير البايتات, &(*الفشل).الرسالة);
    ألحق_ملاحظات_بالبايتات(&متغير البايتات, الفشل);
    ألحق_أسبابا_بالبايتات(&متغير البايتات, الفشل);
    أرجع البايتات مثل نص;
}

// Writes صف_فشل and a newline to standard error.
عام عرف اطبع_فشل(الفشل: &فشل): فراغ {
    دع تجاهل: نتيجة عدد, عدد = اطبع_سطر_خطأ(صف_فشل(الفشل));
}

// --- Language versions (optional) -----------------------------------------

// Adds the message in another language, under a BCP 47 tag («en», «ar-SA»;
// «_» is accepted, and the case does not matter). A second version under the
// same tag replaces the first. The identity, the author's message, صف_فشل
// and هل_من_نوع do not change.
عام عرف أضف_نسخة_لغة(الفشل: &متغير فشل, الوسم: نص, النص: نص): فراغ {
    دع المطبوع: نص = طبع_وسم_لغة(&الوسم);
    دع العدد: طبيعي = الطول((*الفشل).النسخ) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (نصان_متساويان(&(*الفشل).النسخ[ف].الوسم, &المطبوع)) {
            (*الفشل).النسخ[ف].النص := النص;
            أرجع;
        };
        ف := ف + 1;
    }
    دع النسخة: نسخة_لغة_فشل = { الوسم: المطبوع, النص: النص };
    ألحق((*الفشل).النسخ, النسخة);
}

// The index of the version under exactly this tag, or the count of versions
// when there is none.
عرف موضع_نسخة_لغة(الفشل: &فشل, الوسم: &نص): طبيعي {
    دع العدد: طبيعي = الطول((*الفشل).النسخ) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (نصان_متساويان(&(*الفشل).النسخ[ف].الوسم, الوسم)) { أرجع ف; };
        ف := ف + 1;
    }
    أرجع العدد;
}

// The message of this error (its causes are not included) for a locale, by
// the RFC 4647 §3.4 lookup: for each tag of the locale, most preferred
// first, the version under that tag, then under each shorter form of it
// down to its primary language («ar-SA» → «ar»); then the author's message;
// when that is empty, the first version given.
عام عرف نص_فشل_بلغة(الفشل: &فشل, اللغة: &لغة): نص {
    دع العدد: طبيعي = الطول((*الفشل).النسخ) مثل طبيعي;
    إذا (العدد > 0) {
        دع الوسوم: متجه نص = وسوم_لغة(اللغة);
        دع عدد_الوسوم: طبيعي = الطول(الوسوم) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف < عدد_الوسوم) {
            دع المحاول: متغير نص = انسخ_نص(&الوسوم[ف]);
            طالما ((الطول(المحاول) مثل طبيعي) > 0) {
                دع الموضع: طبيعي = موضع_نسخة_لغة(الفشل, &المحاول);
                إذا (الموضع < العدد) { أرجع انسخ_نص(&(*الفشل).النسخ[الموضع].النص); };
                المحاول := اختصر_وسم_لغة(&المحاول);
            }
            ف := ف + 1;
        }
    };
    إذا ((الطول((*الفشل).الرسالة) مثل طبيعي) > 0 || العدد == 0) {
        أرجع انسخ_نص(&(*الفشل).الرسالة);
    };
    أرجع انسخ_نص(&(*الفشل).النسخ[0].النص);
}

// The connector words of صف_فشل_بلغة, fixed text owned by std: Arabic for
// a locale whose language is Arabic or that has no tag, English otherwise.
عرف لغة_الوصل_عربية(اللغة: &لغة): منطقي {
    دع الأساسية: نص = اللغة_الأساسية(اللغة);
    دع العربية: نص = «ar»;
    أرجع (الطول(الأساسية) مثل طبيعي) == 0 || نصان_متساويان(&الأساسية, &العربية);
}

عرف ألحق_ملاحظات_بلغة(البايتات: &متغير متجه ط8, الفشل: &فشل, العربية: منطقي): فراغ {
    دع بادئة: متغير نص = "\nnote: ";
    دع السياق: متغير اتجاه_نص = اتجاه_نص.من_اليسار_إلى_اليمين();
    إذا (العربية) {
        بادئة := "\nملاحظة: ";
        السياق := اتجاه_نص.من_اليمين_إلى_اليسار();
    };
    دع العدد: طبيعي = الطول((*الفشل).الملاحظات) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق_نصا_بالبايتات(البايتات, &بادئة);
        دع المعزول: نص = اعزل_اتجاه_في(&(*الفشل).الملاحظات[ف], السياق);
        ألحق_نصا_بالبايتات(البايتات, &المعزول);
        ف := ف + 1;
    }
}

عرف ألحق_أسبابا_بلغة(البايتات: &متغير متجه ط8, الفشل: &فشل, اللغة: &لغة, العربية: منطقي): فراغ {
    طابق (*الفشل).السبب مع
    | اختياري.موجود(الأصل) -> {
        دع بادئة: متغير نص = "\ncaused by: ";
        دع السياق: متغير اتجاه_نص = اتجاه_نص.من_اليسار_إلى_اليمين();
        إذا (العربية) {
            بادئة := "\nبسبب: ";
            السياق := اتجاه_نص.من_اليمين_إلى_اليسار();
        };
        ألحق_نصا_بالبايتات(البايتات, &بادئة);
        دع النص: نص = نص_فشل_بلغة(&(*الأصل), اللغة);
        دع المعزول: نص = اعزل_اتجاه_في(&النص, السياق);
        ألحق_نصا_بالبايتات(البايتات, &المعزول);
        ألحق_ملاحظات_بلغة(البايتات, &(*الأصل), العربية);
        ألحق_أسبابا_بلغة(البايتات, &(*الأصل), اللغة, العربية);
    }
    | اختياري.لا_شيء -> { };
}

// صف_فشل for a locale: the message of each error in the chain chosen by
// نص_فشل_بلغة with the same locale, the connector words in the locale's
// language («ملاحظة: », «بسبب: » for Arabic and a locale without a tag;
// «note: », «caused by: » for any other language), and every message or
// note after a connector whose direction differs from the connector's
// isolated by U+2068 … U+2069 (text.bidi). The first line is left as it is.
عام عرف صف_فشل_بلغة(الفشل: &فشل, اللغة: &لغة): نص {
    دع العربية: منطقي = لغة_الوصل_عربية(اللغة);
    دع البايتات: متغير متجه ط8 = [];
    دع الرسالة: نص = نص_فشل_بلغة(الفشل, اللغة);
    ألحق_نصا_بالبايتات(&متغير البايتات, &الرسالة);
    ألحق_ملاحظات_بلغة(&متغير البايتات, الفشل, العربية);
    ألحق_أسبابا_بلغة(&متغير البايتات, الفشل, اللغة, العربية);
    أرجع البايتات مثل نص;
}

// Writes صف_فشل_بلغة and a newline to standard error.
عام عرف اطبع_فشل_بلغة(الفشل: &فشل, اللغة: &لغة): فراغ {
    دع تجاهل: نتيجة عدد, عدد = اطبع_سطر_خطأ(صف_فشل_بلغة(الفشل, اللغة));
}

عام مرادف Error = فشل;
عام مرادف error_new = فشل_من;
عام مرادف error_with_kind = فشل_بهوية;
عام مرادف error_caused_by = فشل_بسبب;
عام مرادف error_with_kind_caused_by = فشل_بهوية_وسبب;
عام مرادف error_copy = انسخ_فشل;
عام مرادف error_message = رسالة_فشل;
عام مرادف error_domain = نطاق_فشل;
عام مرادف error_kind = نوع_فشل;
عام مرادف error_has_cause = له_سبب;
عام مرادف error_cause = سبب_فشل;
عام مرادف error_notes = ملاحظات_فشل;
عام مرادف error_is = هل_من_نوع;
