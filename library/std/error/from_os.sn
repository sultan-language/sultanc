// Converters to فشل for std.fs, std.io and std.process.
//
// These modules report the inherited numeric runtime status (`عدد`, negative
// on failure). std.fs.error classifies that status into فئة_خطأ_نظام; the
// converters use that classification as the kind, the calling module as the
// domain, and keep the numeric status as a note. Every converter takes its
// error by reference, the shape a converter function value needs. The
// message is Arabic, with an English language version («en»).
استورد error.failure;
استورد fs.error;
استورد text.number;
استورد text.from_bytes;

// The note «<prefix><value>»; Stage0-compatible text concatenation.
عرف نص_ملاحظة_حالة_نظام(البادئة: نص, القيمة: نص): نص {
    دع البايتات: متغير متجه ط8 = بايتات_من_نص(البادئة);
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(البايتات, القيمة[ف]);
        ف := ف + 1;
    }
    أرجع البايتات مثل نص;
}

عرف اسم_فئة_خطأ_نظام(الفئة: &فئة_خطأ_نظام): نص {
    طابق *الفئة مع
    | فئة_خطأ_نظام.لا_خطأ -> { أرجع «لا_خطأ»; }
    | فئة_خطأ_نظام.غير_موجود -> { أرجع «غير_موجود»; }
    | فئة_خطأ_نظام.مرفوض_الإذن -> { أرجع «مرفوض_الإذن»; }
    | فئة_خطأ_نظام.موجود_مسبقا -> { أرجع «موجود_مسبقا»; }
    | فئة_خطأ_نظام.إدخال_غير_صالح -> { أرجع «إدخال_غير_صالح»; }
    | فئة_خطأ_نظام.غير_مدعوم -> { أرجع «غير_مدعوم»; }
    | فئة_خطأ_نظام.هو_دليل -> { أرجع «هو_دليل»; }
    | فئة_خطأ_نظام.ليس_دليلا -> { أرجع «ليس_دليلا»; }
    | فئة_خطأ_نظام.مورد_منهك -> { أرجع «مورد_منهك»; }
    | فئة_خطأ_نظام.مقاطعة -> { أرجع «مقاطعة»; }
    | فئة_خطأ_نظام.آخر -> { أرجع «آخر»; };
}

عرف رسالة_فئة_خطأ_نظام(الفئة: &فئة_خطأ_نظام): نص {
    طابق *الفئة مع
    | فئة_خطأ_نظام.لا_خطأ -> { أرجع «لم يحدث خطأ»; }
    | فئة_خطأ_نظام.غير_موجود -> { أرجع «الملف أو المسار غير موجود»; }
    | فئة_خطأ_نظام.مرفوض_الإذن -> { أرجع «الإذن مرفوض»; }
    | فئة_خطأ_نظام.موجود_مسبقا -> { أرجع «الملف أو المسار موجود مسبقا»; }
    | فئة_خطأ_نظام.إدخال_غير_صالح -> { أرجع «الإدخال غير صالح»; }
    | فئة_خطأ_نظام.غير_مدعوم -> { أرجع «العملية غير مدعومة»; }
    | فئة_خطأ_نظام.هو_دليل -> { أرجع «المسار دليل»; }
    | فئة_خطأ_نظام.ليس_دليلا -> { أرجع «المسار ليس دليلا»; }
    | فئة_خطأ_نظام.مورد_منهك -> { أرجع «نفدت موارد النظام»; }
    | فئة_خطأ_نظام.مقاطعة -> { أرجع «قوطعت العملية»; }
    | فئة_خطأ_نظام.آخر -> { أرجع «فشلت عملية النظام»; };
}

عرف رسالة_إنجليزية_فئة_خطأ_نظام(الفئة: &فئة_خطأ_نظام): نص {
    طابق *الفئة مع
    | فئة_خطأ_نظام.لا_خطأ -> { أرجع «no error occurred»; }
    | فئة_خطأ_نظام.غير_موجود -> { أرجع «the file or path does not exist»; }
    | فئة_خطأ_نظام.مرفوض_الإذن -> { أرجع «permission denied»; }
    | فئة_خطأ_نظام.موجود_مسبقا -> { أرجع «the file or path already exists»; }
    | فئة_خطأ_نظام.إدخال_غير_صالح -> { أرجع «invalid input»; }
    | فئة_خطأ_نظام.غير_مدعوم -> { أرجع «the operation is not supported»; }
    | فئة_خطأ_نظام.هو_دليل -> { أرجع «the path is a directory»; }
    | فئة_خطأ_نظام.ليس_دليلا -> { أرجع «the path is not a directory»; }
    | فئة_خطأ_نظام.مورد_منهك -> { أرجع «system resources are exhausted»; }
    | فئة_خطأ_نظام.مقاطعة -> { أرجع «the operation was interrupted»; }
    | فئة_خطأ_نظام.آخر -> { أرجع «a system operation failed»; };
}

عرف فشل_نظام_في_نطاق(النطاق: نص, الفئة: &فئة_خطأ_نظام): فشل {
    دع الناتج: متغير فشل = فشل_بهوية(النطاق, اسم_فئة_خطأ_نظام(الفئة), رسالة_فئة_خطأ_نظام(الفئة));
    أضف_نسخة_لغة(&متغير الناتج, «en», رسالة_إنجليزية_فئة_خطأ_نظام(الفئة));
    أرجع الناتج;
}

عرف فشل_رمز_نظام_في_نطاق(النطاق: نص, الرمز: عدد): فشل {
    دع الفئة: فئة_خطأ_نظام = صنف_خطأ_نظام(الرمز);
    دع الناتج: متغير فشل = فشل_نظام_في_نطاق(النطاق, &الفئة);
    أضف_ملاحظة(&متغير الناتج, نص_ملاحظة_حالة_نظام(«رمز الحالة: », عدد_إلى_نص(الرمز)));
    أرجع الناتج;
}

// std.fs's classification enum. Domain «std.fs», kind = the variant name.
عام عرف فشل_من_فئة_خطأ_نظام(الفئة: &فئة_خطأ_نظام): فشل {
    أرجع فشل_نظام_في_نطاق(«std.fs», الفئة);
}

// A std.fs numeric status, for example from اقرأ_الملف.
عام عرف فشل_من_خطأ_ملف(الرمز: &عدد): فشل {
    أرجع فشل_رمز_نظام_في_نطاق(«std.fs», *الرمز);
}

// A std.io numeric status, for example from اطبع or اقرأ_السطر.
عام عرف فشل_من_خطأ_دخل_خرج(الرمز: &عدد): فشل {
    أرجع فشل_رمز_نظام_في_نطاق(«std.io», *الرمز);
}

// A std.process numeric status, for example from شغل_عملية.
عام عرف فشل_من_خطأ_عملية(الرمز: &عدد): فشل {
    أرجع فشل_رمز_نظام_في_نطاق(«std.process», *الرمز);
}

عام مرادف error_from_os_error_class = فشل_من_فئة_خطأ_نظام;
عام مرادف error_from_fs_error = فشل_من_خطأ_ملف;
عام مرادف error_from_io_error = فشل_من_خطأ_دخل_خرج;
عام مرادف error_from_process_error = فشل_من_خطأ_عملية;
