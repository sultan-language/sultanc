// Async tasks (docs/en/reference/concurrency.md, "Async tasks"): stackful
// coroutines on one thread, as Go's goroutines on one P, Java's virtual
// threads or Lua's coroutines. A task is a closure running on a stack of its
// own (256 KiB reserved, the lowest 64 KiB an inaccessible guard, pages
// committed by the system on first touch). `أطلق_مهمة` starts one and
// answers a handle; `انتظر_مهمة` suspends the caller until that task has
// finished and answers its result. Code inside a task is ordinary code: a
// call that has to wait (انتظر_جاهزية_واصف for a socket, نم_مهمة for a
// timer, انتظر_مهمة for another task) suspends only that task, and the
// scheduler runs the others meanwhile. No function is "coloured": an async
// read is a plain call that returns when the bytes are there.
//
// The scheduler runs on the thread that waits from outside every task (the
// program's main code awaiting a task, or blocking on a socket through the
// same calls): while that code waits, the ready tasks run in turn, and when
// none is ready the thread sleeps in the poller (io_uring or epoll on Linux,
// kqueue on the BSDs and macOS) until a socket is ready or the nearest timer
// is due. One scheduler serves the process; tasks belong to the thread that
// drives it and must not be awaited from another thread.
//
// A switch saves the callee-saved registers on the task's stack and swaps
// stack pointers (بدل_سياق_المهام_التشغيل, whose body the backends replace
// with fixed machine code). It is available on x86_64 (System V) and arm64
// (AAPCS64) with the native and LLVM backends. Everywhere else (wasm32, the
// interpreter, Windows, other architectures) المهام_مدعومة answers false and
// a task runs to completion when it is started, so the same program still
// runs, one task after another, with every wait blocking the thread.
//
// A closure given to أطلق_مهمة may capture only what a thread's closure may
// (the spawn capture check): the task outlives the caller's frame.
استورد os.allocation;
استورد os.poll;
استورد time.time;
استورد sync.arc;
استورد sync.mutex;
استورد process.panic;

مرادف عنوان_إغلاق_مهمة = بدائي_عنوان_دالة;
مرادف إغلاق_من_عنوان_مهمة = بدائي_دالة_من_عنوان;

إذا (((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») {
    مرادف اقرأ_كلمة_آلة_مهمة = بدائي_اقرأ_ذاكرة_الآلة;
    مرادف اكتب_كلمة_آلة_مهمة = بدائي_اكتب_ذاكرة_الآلة;
    عرف احجز_مكدس_مهمة_نظام(الطول: ط64, الحارس: ط64): ط64 { أرجع احجز_مكدس_مهمة_مخصص(الطول, الحارس); }
}

إذا (!(((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    عرف اقرأ_كلمة_آلة_مهمة(العنوان: ط64): ط64 { أرجع 0; }
    عرف اكتب_كلمة_آلة_مهمة(العنوان: ط64, القيمة: ط64): فراغ { }
    عرف احجز_مكدس_مهمة_نظام(الطول: ط64, الحارس: ط64): ط64 { أرجع 0; }
}

// Which saved-frame layout the switch routine uses (arm64 or x86_64).
إذا (الهدف.المعمارية == «aarch64») {
    عرف إطار_مهمة_ذراع(): منطقي { أرجع صواب; }
}
إذا (الهدف.المعمارية != «aarch64») {
    عرف إطار_مهمة_ذراع(): منطقي { أرجع خطأ; }
}

// The context switch (compiler.runtime اسم_تبديل_سياق_المهام_أساسي). With a
// zero المكدس_الجديد it answers the address of the task trampoline; otherwise
// it saves the callee-saved registers on the current stack, stores the stack
// pointer at the word الحفظ, loads المكدس_الجديد, restores the registers saved
// there and returns on that stack. Backends that can switch stacks replace
// this body; this one answers 0: no task switching on the target.
عام عرف بدل_سياق_المهام_التشغيل(الحفظ: ط64, المكدس_الجديد: ط64): ط64 { أرجع 0; }

عرف اقرأ_كلمة_مهمة(العنوان: ط64): ط64 {
    دع القيمة: ط64;
    غير_آمن { القيمة := اقرأ_كلمة_آلة_مهمة(العنوان); }
    أرجع القيمة;
}

عرف اكتب_كلمة_مهمة(العنوان: ط64, القيمة: ط64): فراغ {
    غير_آمن { اكتب_كلمة_آلة_مهمة(العنوان, القيمة); }
}

// Task states.
عرف مهمة_حرة(): ط8 { أرجع 0; }
عرف مهمة_جاهزة(): ط8 { أرجع 1; }
عرف مهمة_تعمل(): ط8 { أرجع 2; }
عرف مهمة_منتظرة(): ط8 { أرجع 3; }
عرف مهمة_منتهية(): ط8 { أرجع 4; }

// One scheduler entry. Entry 0 is the code outside every task (no stack of
// its own); the others own a stack reservation and the address of their
// entry closure (one reference, dropped when the task has finished).
// Entry indices are ط32: every task owns a stack reservation
// (حجم_مكدس_مهمة), so far fewer than 2^32 entries can exist. The
// generation stays 64-bit: it counts every reuse of an entry.
نوع سجل_مهمة = {
    الجيل: ط64,
    القاعدة: ط64,
    الإغلاق: ط64,
    // The entry awaiting this task, plus one; 0 when none.
    المنتظر: ط32,
    الحالة: ط8
};

نوع مؤقت_مهمة = { المهلة: عدد, المهمة: ط32 };

دع مهام_التشغيل: متغير متجه سجل_مهمة = [];
دع طابور_المهام: متغير متجه ط32 = [];
دع رأس_طابور_المهام: متغير طبيعي = 0;
دع مؤقتات_المهام: متغير متجه مؤقت_مهمة = [];
دع مكادس_المهام_الحرة: متغير متجه ط64 = [];
دع واصفات_المهام_المسجلة: متغير متجه عدد = [];
دع مستطلع_المهام: متغير متجه مستطلع = [];
دع أحداث_المهام: متغير متجه مخزن_أحداث_مستطلع = [];
دع المهمة_الجارية: متغير طبيعي = 0;
// The stack pointer of the scheduler (the code outside every task) while a
// task runs.
دع سياق_مجدول_المهام: متغير ط64 = 0;
// 0 unknown, 1 tasks switch, 2 tasks run when started.
دع حالة_دعم_المهام: متغير ط8 = 0;
دع منصة_المهام: متغير ط64 = 0;
دع منتظرو_الواصفات: متغير طبيعي = 0;

عرف حجم_مكدس_مهمة(): ط64 { أرجع 262144; }
عرف حجم_حارس_مكدس_مهمة(): ط64 { أرجع 65536; }
// The word at the top of a task stack holding its saved stack pointer.
عرف خانة_حفظ_مهمة(القاعدة: ط64): ط64 { أرجع القاعدة + حجم_مكدس_مهمة() - 16; }

// Whether tasks switch on this target (the routine answered a trampoline).
عام عرف المهام_مدعومة(): منطقي {
    غير_آمن {
        إذا (حالة_دعم_المهام == 0) {
            دع المنصة: ط64 = بدل_سياق_المهام_التشغيل(0 مثل ط64, 0 مثل ط64);
            إذا (المنصة == 0) {
                حالة_دعم_المهام := 2;
            } وإلا {
                منصة_المهام := المنصة;
                حالة_دعم_المهام := 1;
            };
        };
        أرجع حالة_دعم_المهام == 1;
    };
}
عام مرادف tasks_supported = المهام_مدعومة;

عرف هيئ_المهام(): فراغ {
    غير_آمن {
        إذا ((الطول(مهام_التشغيل) مثل طبيعي) == 0) {
            دع الخارجية: سجل_مهمة = {
                الحالة: مهمة_تعمل(), الجيل: 0, القاعدة: 0, الإغلاق: 0, المنتظر: 0
            };
            ألحق(مهام_التشغيل, الخارجية);
        };
    }
}

عرف حالة_مهمة(ف: طبيعي): ط8 {
    غير_آمن { أرجع مهام_التشغيل[ف].الحالة; };
}

عرف ضع_حالة_مهمة(ف: طبيعي, الحالة: ط8): فراغ {
    غير_آمن { مهام_التشغيل[ف].الحالة := الحالة; }
}

عرف ادفع_مهمة_جاهزة(ف: طبيعي): فراغ {
    غير_آمن {
        // Drop the consumed front once it is most of the queue.
        إذا (رأس_طابور_المهام > 64 && رأس_طابور_المهام * 2 > (الطول(طابور_المهام) مثل طبيعي)) {
            دع الباقي: متغير متجه ط32 = [];
            دع ك: متغير طبيعي = رأس_طابور_المهام;
            طالما (ك < (الطول(طابور_المهام) مثل طبيعي)) { ألحق(الباقي, طابور_المهام[ك]); ك := ك + 1; }
            طابور_المهام := الباقي;
            رأس_طابور_المهام := 0;
        };
        ألحق(طابور_المهام, ف مثل ط32);
    }
}

// The next ready entry, or 0 when the queue is empty.
عرف خذ_مهمة_جاهزة(): طبيعي {
    غير_آمن {
        إذا (رأس_طابور_المهام >= (الطول(طابور_المهام) مثل طبيعي)) { أرجع 0; };
        دع ف: طبيعي = طابور_المهام[رأس_طابور_المهام];
        رأس_طابور_المهام := رأس_طابور_المهام + 1;
        أرجع ف;
    };
}

// Makes a waiting entry ready (a task is queued; the outside code is
// picked up by the scheduler loop it is waiting in).
عرف أيقظ_مهمة(ف: طبيعي): فراغ {
    إذا (حالة_مهمة(ف) != مهمة_منتظرة()) { أرجع; };
    ضع_حالة_مهمة(ف, مهمة_جاهزة());
    إذا (ف != 0) { ادفع_مهمة_جاهزة(ف); };
}

عرف خذ_مكدس_مهمة(): ط64 {
    غير_آمن {
        دع المتاحة: متغير اختياري ط64 = أزل_الأخير(مكادس_المهام_الحرة);
        طابق المتاحة مع
        | اختياري.موجود(القاعدة) -> { أرجع القاعدة; }
        | اختياري.لا_شيء -> { };
    }
    أرجع احجز_مكدس_مهمة_نظام(حجم_مكدس_مهمة(), حجم_حارس_مكدس_مهمة());
}

// The first frame of a task, laid out as the switch routine saved it: the
// callee-saved registers zero but the one holding the entry closure (r12 on
// x86_64, x19 on arm64), and the return address the trampoline, which calls
// that closure.
عرف ابن_إطار_بداية_مهمة(القاعدة: ط64, الإغلاق: ط64): فراغ {
    دع الأعلى: ط64 = القاعدة + حجم_مكدس_مهمة() - 64;
    دع المكدس: متغير ط64 = 0;
    إذا (إطار_مهمة_ذراع()) {
        // x19..x28, x29, x30, d8..d15: 176 bytes, 16-byte aligned.
        المكدس := الأعلى - 176;
        دع ك: متغير ط64 = 0;
        طالما (ك < 176) { اكتب_كلمة_مهمة(المكدس + ك, 0 مثل ط64); ك := ك + 8; }
        اكتب_كلمة_مهمة(المكدس, الإغلاق);
        اكتب_كلمة_مهمة(المكدس + 88, منصة_المهام_الحالية());
    } وإلا {
        // r15 r14 r13 r12 rbx rbp, then the return address; the trampoline
        // calls with the stack 16-byte aligned.
        المكدس := الأعلى - 56;
        دع ك: متغير ط64 = 0;
        طالما (ك < 56) { اكتب_كلمة_مهمة(المكدس + ك, 0 مثل ط64); ك := ك + 8; }
        اكتب_كلمة_مهمة(المكدس + 24, الإغلاق);
        اكتب_كلمة_مهمة(المكدس + 48, منصة_المهام_الحالية());
    };
    اكتب_كلمة_مهمة(خانة_حفظ_مهمة(القاعدة), المكدس);
}

عرف منصة_المهام_الحالية(): ط64 {
    غير_آمن { أرجع منصة_المهام; };
}

// A new ready entry for a task on القاعدة whose entry closure is الإغلاق.
عرف سجل_مهمة_جديدة(القاعدة: ط64, الإغلاق: ط64): طبيعي {
    ابن_إطار_بداية_مهمة(القاعدة, الإغلاق);
    دع ف: متغير طبيعي = 1;
    غير_آمن {
        طالما (ف < (الطول(مهام_التشغيل) مثل طبيعي) && مهام_التشغيل[ف].الحالة != مهمة_حرة()) { ف := ف + 1; }
        إذا (ف == (الطول(مهام_التشغيل) مثل طبيعي)) {
            دع الجديد: سجل_مهمة = { الحالة: مهمة_حرة(), الجيل: 0, القاعدة: 0, الإغلاق: 0, المنتظر: 0 };
            ألحق(مهام_التشغيل, الجديد);
        };
        مهام_التشغيل[ف].الجيل := مهام_التشغيل[ف].الجيل + 1;
        مهام_التشغيل[ف].القاعدة := القاعدة;
        مهام_التشغيل[ف].الإغلاق := الإغلاق;
        مهام_التشغيل[ف].المنتظر := 0;
        مهام_التشغيل[ف].الحالة := مهمة_جاهزة();
    }
    ادفع_مهمة_جاهزة(ف);
    أرجع ف;
}

// The address of the scheduler's saved stack pointer.
عرف خانة_سياق_المجدول(): ط64 {
    دع العنوان: ط64;
    غير_آمن {
        دع المؤشر: *متغير ط64 = &متغير سياق_مجدول_المهام;
        العنوان := المؤشر مثل ط64;
    }
    أرجع العنوان;
}

// Runs task ف until it suspends or finishes (on the scheduler's stack).
عرف استأنف_مهمة(ف: طبيعي): فراغ {
    دع القاعدة: ط64;
    غير_آمن {
        مهام_التشغيل[ف].الحالة := مهمة_تعمل();
        القاعدة := مهام_التشغيل[ف].القاعدة;
        المهمة_الجارية := ف;
    }
    دع المكدس: ط64 = اقرأ_كلمة_مهمة(خانة_حفظ_مهمة(القاعدة));
    دع تجاهل: ط64 = بدل_سياق_المهام_التشغيل(خانة_سياق_المجدول(), المكدس);
    غير_آمن { المهمة_الجارية := 0; }
    إذا (حالة_مهمة(ف) == مهمة_منتهية()) { حرر_مهمة_منتهية(ف); };
}

// Back to the scheduler from task ف (on the task's stack); returns when the
// scheduler resumes it.
عرف بدل_إلى_المجدول(ف: طبيعي): فراغ {
    دع القاعدة: ط64;
    دع المجدول: ط64;
    غير_آمن {
        القاعدة := مهام_التشغيل[ف].القاعدة;
        المجدول := سياق_مجدول_المهام;
    }
    دع تجاهل: ط64 = بدل_سياق_المهام_التشغيل(خانة_حفظ_مهمة(القاعدة), المجدول);
}

// A finished task's stack goes back to the pool and its entry closure is
// dropped (with what it captured).
عرف حرر_مهمة_منتهية(ف: طبيعي): فراغ {
    دع القاعدة: ط64;
    دع الإغلاق: ط64;
    غير_آمن {
        القاعدة := مهام_التشغيل[ف].القاعدة;
        الإغلاق := مهام_التشغيل[ف].الإغلاق;
        مهام_التشغيل[ف].الحالة := مهمة_حرة();
        مهام_التشغيل[ف].القاعدة := 0;
        مهام_التشغيل[ف].الإغلاق := 0;
        ألحق(مكادس_المهام_الحرة, القاعدة);
    }
    دع المدخل: دالة(): فراغ;
    غير_آمن { المدخل := إغلاق_من_عنوان_مهمة(الإغلاق); }
}

// Suspends the running entry until something wakes it: a task switches to
// the scheduler; the code outside every task runs the scheduler until it is
// woken.
عرف علق_الجارية(): فراغ {
    هيئ_المهام();
    دع ف: طبيعي;
    غير_آمن { ف := المهمة_الجارية; }
    ضع_حالة_مهمة(ف, مهمة_منتظرة());
    إذا (ف == 0) {
        دور_مجدول_المهام();
    } وإلا {
        بدل_إلى_المجدول(ف);
    };
}

// The scheduler loop of the code outside every task: runs ready tasks, then
// sleeps in the poller until a socket or a timer wakes one, and returns once
// entry 0 is ready again.
عرف دور_مجدول_المهام(): فراغ {
    طالما (صواب) {
        إذا (حالة_مهمة(0) == مهمة_جاهزة()) {
            ضع_حالة_مهمة(0, مهمة_تعمل());
            أرجع;
        };
        دع ف: طبيعي = خذ_مهمة_جاهزة();
        إذا (ف != 0) {
            إذا (حالة_مهمة(ف) == مهمة_جاهزة()) { استأنف_مهمة(ف); };
        } وإلا {
            دع لا_مؤقتات: منطقي;
            دع لا_واصفات: منطقي;
            غير_آمن {
                لا_مؤقتات := (الطول(مؤقتات_المهام) مثل طبيعي) == 0;
                لا_واصفات := منتظرو_الواصفات == 0;
            }
            إذا (لا_مؤقتات && لا_واصفات) {
                إنهيار(«async: every task is waiting and nothing can wake one (a task awaits itself, or a cycle of tasks await each other)»);
                أرجع;
            };
            انتظر_أحداث_المهام();
        };
    }
}

عرف الآن_مهام(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(الآن) -> { أرجع الآن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// The poller, created on first use (io_uring where the kernel has it).
عرف مستطلع_المهام_متاح(): منطقي {
    غير_آمن {
        إذا ((الطول(مستطلع_المهام) مثل طبيعي) > 0) { أرجع صواب; };
        طابق أنشئ_مستطلع_حلقي() مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(المستطلع) -> {
            ألحق(مستطلع_المهام, المستطلع);
            ألحق(أحداث_المهام, أنشئ_مخزن_أحداث_مستطلع(256));
            أرجع صواب;
        };
    };
}

// Sleeps until the nearest timer or a ready socket, then wakes their tasks.
عرف انتظر_أحداث_المهام(): فراغ {
    دع الآن: عدد = الآن_مهام();
    دع المهلة: متغير عدد = -1;
    غير_آمن {
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(مؤقتات_المهام) مثل طبيعي)) {
            دع الباقي: عدد = مؤقتات_المهام[ك].المهلة - الآن;
            دع بالمللي: متغير عدد = 0;
            إذا (الباقي > 0) { بالمللي := (الباقي + 999999) / 1000000; };
            إذا (المهلة < 0 || بالمللي < المهلة) { المهلة := بالمللي; };
            ك := ك + 1;
        }
    }
    إذا (مستطلع_المهام_متاح()) {
        غير_آمن {
            طابق انتظر_مستطلع(&مستطلع_المهام[0], &متغير أحداث_المهام[0], المهلة) مع
            | نتيجة.خطأ(_) -> { }
            | نتيجة.نجح(العدد) -> {
                دع ك: متغير طبيعي = 0;
                طالما (ك < العدد) {
                    دع الحدث: حدث_مستطلع = حدث_مستطلع_عند(&أحداث_المهام[0], ك);
                    دع ف: طبيعي = الحدث.الرمز مثل طبيعي;
                    إذا (ف < (الطول(مهام_التشغيل) مثل طبيعي)) { أيقظ_مهمة(ف); };
                    ك := ك + 1;
                }
            };
        }
    } وإلا {
        إذا (المهلة > 0) { دع تجاهل: نتيجة عدد, عدد = نم_نانو(المهلة * 1000000); };
    };
    أيقظ_المؤقتات_المستحقة();
}

عرف أيقظ_المؤقتات_المستحقة(): فراغ {
    دع الآن: عدد = الآن_مهام();
    دع المستحقة: متغير متجه ط32 = [];
    غير_آمن {
        دع الباقية: متغير متجه مؤقت_مهمة = [];
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(مؤقتات_المهام) مثل طبيعي)) {
            دع المؤقت: مؤقت_مهمة = مؤقتات_المهام[ك];
            إذا (المؤقت.المهلة <= الآن) { ألحق(المستحقة, المؤقت.المهمة); } وإلا { ألحق(الباقية, المؤقت); };
            ك := ك + 1;
        }
        مؤقتات_المهام := الباقية;
    }
    دع م: متغير طبيعي = 0;
    طالما (م < (الطول(المستحقة) مثل طبيعي)) { أيقظ_مهمة(المستحقة[م]); م := م + 1; }
}

// ---------------------------------------------------------------- tasks

// A task's handle: its scheduler entry and generation, and the cell its
// result lands in (shared with the task, as std.thread's value handle).
عام نوع مهمة<ق> = {
    المعرف: طبيعي,
    الجيل: ط64,
    الخانة: مشترك<قفل<متجه ق>>
};
عام مرادف task = مهمة;

عرف نفذ_وخزن_ناتج_مهمة<ق>(العمل: دالة(): ق, الخانة: مشترك<قفل<متجه ق>>): فراغ {
    دع الناتج: ق = العمل();
    دع القفل: &قفل<متجه ق> = اقرأ_مشترك(&الخانة);
    اقفل_خام(القفل);
    دع القيم: *متغير متجه ق = مؤشر_قيمة_القفل(القفل);
    غير_آمن { ألحق((*القيم), الناتج); }
    افتح_خام(القفل);
}

عرف لا_عمل_مهمة(): فراغ { }

// Takes the work out of its cell, runs it and drops it on return.
عرف شغل_عمل_مهمة(الخلية: &صندوق متغير دالة(): فراغ, المؤشر: *متغير دالة(): فراغ): فراغ {
    دع العمل: متغير دالة(): فراغ = لا_عمل_مهمة;
    غير_آمن { بدّل((*المؤشر), العمل); }
    العمل();
}

// The task's first frame calls this (through the trampoline): the work runs
// and is dropped, then the task finishes and never comes back.
عرف شغل_مهمة_ثم_أنهها(الخلية: &صندوق متغير دالة(): فراغ, المؤشر: *متغير دالة(): فراغ): فراغ {
    شغل_عمل_مهمة(الخلية, المؤشر);
    أنه_المهمة_الجارية();
}

عرف مدخل_مهمة(العمل: دالة(): فراغ): دالة(): فراغ {
    دع الخلية: صندوق متغير دالة(): فراغ = صندوق العمل;
    دع مؤشر_العمل: *متغير دالة(): فراغ = &متغير (*الخلية);
    دع المدخل: دالة(): فراغ = دالة(): فراغ -> شغل_مهمة_ثم_أنهها(&الخلية, مؤشر_العمل);
    أرجع المدخل;
}

// Marks the running task finished, wakes its awaiter and leaves its stack
// for good (the scheduler then frees it).
عرف أنه_المهمة_الجارية(): فراغ {
    دع ف: طبيعي;
    دع المنتظر: طبيعي;
    غير_آمن {
        ف := المهمة_الجارية;
        مهام_التشغيل[ف].الحالة := مهمة_منتهية();
        المنتظر := مهام_التشغيل[ف].المنتظر;
    }
    إذا (المنتظر > 0) { أيقظ_مهمة(المنتظر - 1); };
    بدل_إلى_المجدول(ف);
    إنهيار(«async: a finished task was resumed»);
}

// Starts العمل as a task and answers its handle. Where tasks do not switch
// (المهام_مدعومة false), or no stack can be reserved, the work runs to
// completion here and the handle already holds its result.
عام عرف أطلق_مهمة<ق>(العمل: دالة(): ق): مهمة<ق> {
    هيئ_المهام();
    دع الفارغة: متجه ق = [];
    دع الخانة: مشترك<قفل<متجه ق>> = أنشئ_مشترك(أنشئ_قفل(الفارغة));
    دع للمهمة: مشترك<قفل<متجه ق>> = استنسخ_مشترك(&الخانة);
    دع الغلاف: دالة(): فراغ = دالة(): فراغ -> نفذ_وخزن_ناتج_مهمة(العمل, للمهمة);
    دع القاعدة: متغير ط64 = 0;
    إذا (المهام_مدعومة()) { القاعدة := خذ_مكدس_مهمة(); };
    إذا (القاعدة == 0) {
        الغلاف();
        دع المنفذة: مهمة<ق> = { المعرف: 0, الجيل: 0, الخانة: الخانة };
        أرجع المنفذة;
    };
    دع المدخل: دالة(): فراغ = مدخل_مهمة(الغلاف);
    دع العنوان: ط64;
    غير_آمن { العنوان := عنوان_إغلاق_مهمة(المدخل); }
    دع ف: طبيعي = سجل_مهمة_جديدة(القاعدة, العنوان);
    دع الجيل: ط64;
    غير_آمن { الجيل := مهام_التشغيل[ف].الجيل; }
    دع المقبض: مهمة<ق> = { المعرف: ف, الجيل: الجيل, الخانة: الخانة };
    أرجع المقبض;
}
عام مرادف spawn_task = أطلق_مهمة;

عرف خذ_ناتج_مهمة<ق>(المهمة: &مهمة<ق>): اختياري ق {
    دع القفل: &قفل<متجه ق> = اقرأ_مشترك(&(*المهمة).الخانة);
    اقفل_خام(القفل);
    دع القيم: *متغير متجه ق = مؤشر_قيمة_القفل(القفل);
    دع الناتج: اختياري ق;
    غير_آمن { الناتج := أزل_الأخير((*القيم)); }
    افتح_خام(القفل);
    أرجع الناتج;
}

// Whether the task is still to finish (its entry is the same generation and
// not finished).
عرف مهمة_قائمة(ف: طبيعي, الجيل: ط64): منطقي {
    إذا (ف == 0) { أرجع خطأ; };
    غير_آمن {
        إذا (ف >= (الطول(مهام_التشغيل) مثل طبيعي)) { أرجع خطأ; };
        إذا (مهام_التشغيل[ف].الجيل != الجيل) { أرجع خطأ; };
        دع الحالة: ط8 = مهام_التشغيل[ف].الحالة;
        أرجع الحالة != مهمة_حرة() && الحالة != مهمة_منتهية();
    };
}

// Suspends the caller until the task has finished and answers its result;
// a second await answers لا_شيء. One task (or the outside code) awaits a
// given task at a time. From outside every task this runs the scheduler
// until the task is done (Rust's block_on).
عام عرف انتظر_مهمة<ق>(المهمة: &متغير مهمة<ق>): اختياري ق {
    طالما (صواب) {
        طابق خذ_ناتج_مهمة(المهمة) مع
        | اختياري.موجود(القيمة) -> { أرجع اختياري.موجود(القيمة); }
        | اختياري.لا_شيء -> { };
        إذا (!مهمة_قائمة((*المهمة).المعرف, (*المهمة).الجيل)) { أرجع خذ_ناتج_مهمة(المهمة); };
        غير_آمن { مهام_التشغيل[(*المهمة).المعرف].المنتظر := (المهمة_الجارية + 1) مثل ط32; }
        علق_الجارية();
    }
    أرجع اختياري.لا_شيء();
}
عام مرادف await_task = انتظر_مهمة;

// Whether the task has finished (its result is waiting, or was taken).
عام عرف انتهت_المهمة<ق>(المهمة: &مهمة<ق>): منطقي {
    أرجع !مهمة_قائمة((*المهمة).المعرف, (*المهمة).الجيل);
}
عام مرادف task_finished = انتهت_المهمة;

// Runs العمل as a task and drives the scheduler until it is done: the entry
// point of an async program.
عام عرف شغل_غير_متزامن<ق>(العمل: دالة(): ق): اختياري ق {
    دع المهمة: متغير مهمة<ق> = أطلق_مهمة(العمل);
    أرجع انتظر_مهمة(&متغير المهمة);
}
عام مرادف block_on = شغل_غير_متزامن;

// Lets the other ready tasks run before the caller goes on. From outside
// every task, runs each task that is ready now once.
عام عرف تنازل_مهمة(): فراغ {
    هيئ_المهام();
    دع ف: طبيعي;
    غير_آمن { ف := المهمة_الجارية; }
    إذا (ف == 0) {
        دع العدد: طبيعي;
        غير_آمن { العدد := (الطول(طابور_المهام) مثل طبيعي) - رأس_طابور_المهام; }
        دع ك: متغير طبيعي = 0;
        طالما (ك < العدد) {
            دع ت: طبيعي = خذ_مهمة_جاهزة();
            إذا (ت != 0 && حالة_مهمة(ت) == مهمة_جاهزة()) { استأنف_مهمة(ت); };
            ك := ك + 1;
        }
        أرجع;
    };
    ضع_حالة_مهمة(ف, مهمة_جاهزة());
    ادفع_مهمة_جاهزة(ف);
    بدل_إلى_المجدول(ف);
}
عام مرادف yield_task = تنازل_مهمة;

// Suspends the caller for at least النانو nanoseconds; the other tasks run
// meanwhile.
عام عرف نم_مهمة(النانو: عدد): فراغ {
    هيئ_المهام();
    دع المهلة: عدد = الآن_مهام() + النانو;
    طالما (الآن_مهام() < المهلة) {
        غير_آمن {
            دع المؤقت: مؤقت_مهمة = { المهلة: المهلة, المهمة: المهمة_الجارية مثل ط32 };
            ألحق(مؤقتات_المهام, المؤقت);
        }
        علق_الجارية();
    }
}
عام مرادف sleep_task = نم_مهمة;

// Suspends the caller until the descriptor is ready for الاهتمام (one-shot:
// each wait arms it again). The other tasks run meanwhile. Fails with the
// poller's negative error when no poller can be made.
عام عرف انتظر_جاهزية_واصف(الواصف: عدد, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
    هيئ_المهام();
    إذا (!مستطلع_المهام_متاح()) { أرجع نتيجة.خطأ(-95); };
    غير_آمن {
        دع الرمز: ط64 = المهمة_الجارية مثل ط64;
        دع مسجل: متغير منطقي = خطأ;
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(واصفات_المهام_المسجلة) مثل طبيعي)) {
            إذا (واصفات_المهام_المسجلة[ك] == الواصف) { مسجل := صواب; };
            ك := ك + 1;
        }
        إذا (مسجل) {
            طابق أعد_تسليح_في_مستطلع(&مستطلع_المهام[0], الواصف, الرمز, الاهتمام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        } وإلا {
            طابق سجل_في_مستطلع(&مستطلع_المهام[0], الواصف, الرمز, الاهتمام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            ألحق(واصفات_المهام_المسجلة, الواصف);
        };
        منتظرو_الواصفات := منتظرو_الواصفات + 1;
    }
    علق_الجارية();
    غير_آمن { منتظرو_الواصفات := منتظرو_الواصفات - 1; }
    أرجع نتيجة.نجح(0);
}
عام مرادف wait_fd_ready = انتظر_جاهزية_واصف;

// As انتظر_جاهزية_واصف, but the caller is woken after النانو nanoseconds
// at the latest (it then finds the descriptor still not ready).
عام عرف انتظر_جاهزية_واصف_بمهلة(الواصف: عدد, الاهتمام: اهتمام_مستطلع, النانو: عدد): نتيجة عدد, عدد {
    هيئ_المهام();
    غير_آمن {
        دع المؤقت: مؤقت_مهمة = { المهلة: الآن_مهام() + النانو, المهمة: المهمة_الجارية مثل ط32 };
        ألحق(مؤقتات_المهام, المؤقت);
    }
    أرجع انتظر_جاهزية_واصف(الواصف, الاهتمام);
}
عام مرادف wait_fd_ready_timeout = انتظر_جاهزية_واصف_بمهلة;

// Forgets a descriptor before it is closed (it leaves the poller).
عام عرف انس_واصف_مهام(الواصف: عدد): فراغ {
    غير_آمن {
        دع الباقية: متغير متجه عدد = [];
        دع وجد: متغير منطقي = خطأ;
        دع ك: متغير طبيعي = 0;
        طالما (ك < (الطول(واصفات_المهام_المسجلة) مثل طبيعي)) {
            إذا (واصفات_المهام_المسجلة[ك] == الواصف) { وجد := صواب; } وإلا { ألحق(الباقية, واصفات_المهام_المسجلة[ك]); };
            ك := ك + 1;
        }
        واصفات_المهام_المسجلة := الباقية;
        إذا (وجد && (الطول(مستطلع_المهام) مثل طبيعي) > 0) {
            دع تجاهل: نتيجة عدد, عدد = ألغ_من_مستطلع(&مستطلع_المهام[0], الواصف);
        };
    }
}
عام مرادف forget_task_fd = انس_واصف_مهام;
