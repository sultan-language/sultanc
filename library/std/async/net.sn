// Async TCP (std.async.runtime): the std.net.tcp calls on non-blocking
// sockets, where a call that would block suspends the calling task until the
// socket is ready (the other tasks run meanwhile) and then retries. Outside
// every task, or where tasks do not switch, the same calls wait in the
// poller, so they still work as blocking calls.
استورد async.runtime;
استورد net.tcp;
استورد net.socket_address;
استورد os.poll;

عرف انتظر_تدفق_مهام(الواصف: عدد, الاهتمام: اهتمام_مستطلع, الخطأ: عدد): نتيجة عدد, عدد {
    إذا (!هل_خطأ_سيحظر(الخطأ)) { أرجع نتيجة.خطأ(الخطأ); };
    أرجع انتظر_جاهزية_واصف(الواصف, الاهتمام);
}

// Makes a stream non-blocking, as every async call expects.
عام عرف اجعل_تدفقا_غير_متزامن(التدفق: &تدفق_تي_سي_بي): نتيجة عدد, عدد {
    أرجع اضبط_تدفق_تي_سي_بي_غير_حاصر(التدفق, صواب);
}
عام مرادف tcp_make_async = اجعل_تدفقا_غير_متزامن;

// A listener for async accepts: bound, listening and non-blocking.
عام عرف اربط_مستمع_غير_متزامن(العنوان: &عنوان_مقبس, التراكم: عدد): نتيجة مستمع_تي_سي_بي, عدد {
    طابق اربط_مستمع_تي_سي_بي(العنوان, التراكم) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المستمع) -> {
        طابق اضبط_مستمع_تي_سي_بي_غير_حاصر(&المستمع, صواب) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع تجاهل: نتيجة عدد, عدد = أغلق_مستمع_تي_سي_بي(المستمع);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المستمع); };
    };
}
عام مرادف tcp_listen_async = اربط_مستمع_غير_متزامن;

// Accepts the next connection (the listener must be non-blocking); the new
// stream is non-blocking too.
عام عرف اقبل_غير_متزامن(المستمع: &مستمع_تي_سي_بي): نتيجة تدفق_تي_سي_بي, عدد {
    طالما (صواب) {
        طابق اقبل_تي_سي_بي(المستمع) مع
        | نتيجة.نجح(التدفق) -> {
            طابق اجعل_تدفقا_غير_متزامن(&التدفق) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(التدفق); };
        }
        | نتيجة.خطأ(الخطأ) -> {
            طابق انتظر_تدفق_مهام(واصف_مستمع_تي_سي_بي(المستمع), اهتمام_مستطلع.قراءة(), الخطأ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        };
    }
    أرجع نتيجة.خطأ(-5);
}
عام مرادف tcp_accept_async = اقبل_غير_متزامن;

// Connects (the handshake itself blocks, as a DNS-free connect is short)
// and answers a non-blocking stream.
عام عرف اتصل_غير_متزامن(العنوان: &عنوان_مقبس): نتيجة تدفق_تي_سي_بي, عدد {
    طابق اتصل_تي_سي_بي(العنوان) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(التدفق) -> {
        طابق اجعل_تدفقا_غير_متزامن(&التدفق) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(التدفق); };
    };
}
عام مرادف tcp_connect_async = اتصل_غير_متزامن;

// Reads up to العدد bytes into المخزن at الإزاحة; 0 is the end of the stream.
عام عرف اقرأ_غير_متزامن(
    التدفق: &تدفق_تي_سي_بي,
    المخزن: &متغير متجه ط8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    طالما (صواب) {
        طابق اقرأ_تي_سي_بي(التدفق, المخزن, الإزاحة, العدد) مع
        | نتيجة.نجح(المقروء) -> { أرجع نتيجة.نجح(المقروء); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق انتظر_تدفق_مهام(واصف_تدفق_تي_سي_بي(التدفق), اهتمام_مستطلع.قراءة(), الخطأ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        };
    }
    أرجع نتيجة.خطأ(-5);
}
عام مرادف tcp_read_async = اقرأ_غير_متزامن;

// Writes up to العدد bytes from المحتوى at الإزاحة (at least one, unless the
// connection failed).
عام عرف اكتب_غير_متزامن(
    التدفق: &تدفق_تي_سي_بي,
    المحتوى: &متجه ط8,
    الإزاحة: عدد,
    العدد: عدد
): نتيجة عدد, عدد {
    طالما (صواب) {
        طابق اكتب_تي_سي_بي(التدفق, المحتوى, الإزاحة, العدد) مع
        | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(المكتوب); }
        | نتيجة.خطأ(الخطأ) -> {
            طابق انتظر_تدفق_مهام(واصف_تدفق_تي_سي_بي(التدفق), اهتمام_مستطلع.كتابة(), الخطأ) مع
            | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); }
            | نتيجة.نجح(_) -> { };
        };
    }
    أرجع نتيجة.خطأ(-5);
}
عام مرادف tcp_write_async = اكتب_غير_متزامن;

// Writes all of المحتوى.
عام عرف اكتب_الكل_غير_متزامن(التدفق: &تدفق_تي_سي_بي, المحتوى: &متجه ط8): نتيجة عدد, عدد {
    دع الكل: عدد = الطول(*المحتوى) مثل عدد;
    دع المكتوب: متغير عدد = 0;
    طالما (المكتوب < الكل) {
        طابق اكتب_غير_متزامن(التدفق, المحتوى, المكتوب, الكل - المكتوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ن) -> {
            إذا (ن <= 0) { أرجع نتيجة.خطأ(-32); };
            المكتوب := المكتوب + ن;
        };
    }
    أرجع نتيجة.نجح(المكتوب);
}
عام مرادف tcp_write_all_async = اكتب_الكل_غير_متزامن;

// Closes a stream used by tasks (it leaves the poller first).
عام عرف أغلق_غير_متزامن(التدفق: تدفق_تي_سي_بي): نتيجة عدد, عدد {
    انس_واصف_مهام(واصف_تدفق_تي_سي_بي(&التدفق));
    أرجع أغلق_تدفق_تي_سي_بي(التدفق);
}
عام مرادف tcp_close_async = أغلق_غير_متزامن;

// Closes a listener used by tasks.
عام عرف أغلق_مستمعا_غير_متزامن(المستمع: مستمع_تي_سي_بي): نتيجة عدد, عدد {
    انس_واصف_مهام(واصف_مستمع_تي_سي_بي(&المستمع));
    أرجع أغلق_مستمع_تي_سي_بي(المستمع);
}
عام مرادف tcp_listener_close_async = أغلق_مستمعا_غير_متزامن;
