// std.fmt.fmt (المكتبة.تنسيق.fmt): formatting with a format string and arguments,
// after Rust's std::fmt (format!, write!, print!, the format-spec
// mini-language, Display and Debug) and Go's fmt (Sprintf, Fprintf, Printf).
// The grammar, the Rust and Go mapping and the deviations are in docs/FMT.md.
//
// SultanC has no variadic functions and no traits, so the arguments are a
// vector of `قيمة_تنسيق` / `fmt_arg` values: one constructor per primitive
// type, borrowed text and vectors, and a custom case holding a closure that
// writes into the formatter (the Display/Debug equivalent for user types):
//
//   دع السطر: نص = نسق(«{:<10}|{:>4}», [قيمة_تنسيق.نص(&الاسم), قيمة_تنسيق.عدد(العمر)])؟;
//
// A literal format string is checked against the arguments at compile time:
// the compiler evaluates تحقق_قالب_تنسيق_وقت_الترجمة below on the literal and
// the argument kinds (docs/FMT.md, "Compile-time check"). A format string
// built at run time is parsed and checked when it is used: errors are
// `خطأ_تنسيق` values (std.error converts them with فشل_من_خطأ_تنسيق).
//
// Output goes into one byte buffer (the formatter's); integers, text, chars
// and booleans are written into it directly, without a temporary per
// argument. Floats use std.text.float's digits (shortest round trip, or the
// exact value rounded half to even for a precision).
//
// Width and precision of text count extended grapheme clusters (UAX #29,
// std.unicode.grapheme), so a letter with its harakat counts once and a
// precision never cuts a cluster; ASCII text without CR takes a fast path.
// Rust counts Unicode scalar values; for text without combining marks the
// two agree. No direction marks are inserted.

استورد text.float;
استورد unicode.grapheme;
استورد unicode.general_category;
استورد io.writer;
استورد io.print;

// ---- Public types --------------------------------------------------------

// One argument. Text and vectors are borrowed: formatting copies nothing.
عام نوع قيمة_تنسيق =
    | عدد بنوع عدد
    | طبيعي بنوع طبيعي
    | ص8 بنوع ص8
    | ص16 بنوع ص16
    | ص32 بنوع ص32
    | ص64 بنوع ص64
    | ط8 بنوع ط8
    | ط16 بنوع ط16
    | ط32 بنوع ط32
    | ط64 بنوع ط64
    | ع32 بنوع ع32
    | ع64 بنوع ع64
    | منطقي بنوع منطقي
    | حرف بنوع حرف
    | نص بنوع &نص
    | بايتات بنوع &متجه ط8
    | أعداد بنوع &متجه عدد
    | نصوص بنوع &متجه نص
    | قائمة بنوع &متجه قيمة_تنسيق
    | مخصص بنوع دالة(&متغير منسق): نتيجة طبيعي, خطأ_تنسيق
;

// A format-string or formatting error. Offsets are byte offsets into the
// format string; indexes are 0-based argument positions.
عام نوع خطأ_تنسيق =
    | قوس_غير_مغلق بنوع طبيعي
    | قوس_إغلاق_منفرد بنوع طبيعي
    | مواصفة_غير_صالحة بنوع طبيعي
    | نوع_غير_معروف بنوع طبيعي
    | وسيط_مسمى بنوع طبيعي
    | وسيط_مفقود بنوع طبيعي
    | وسيط_غير_مستخدم بنوع طبيعي
    | نوع_غير_مناسب بنوع طبيعي
    | عدد_غير_صالح بنوع طبيعي
    | فشل_الكتابة بنوع عدد
    | فشل_مخصص
;

عام نوع محاذاة_تنسيق =
    | بلا
    | يسار
    | وسط
    | يمين
;

// The placeholder's type: {} {:?} {:x} {:X} {:o} {:b} {:e} {:E} {:x?} {:X?}.
عام نوع صيغة_تنسيق =
    | عرض
    | تصحيح
    | ست_عشري
    | ست_عشري_كبير
    | ثماني
    | ثنائي
    | أسي
    | أسي_كبير
    | تصحيح_ست_عشري
    | تصحيح_ست_عشري_كبير
;

// The parsed spec of the current placeholder ([[fill]align][sign]['#']['0']
// [width]['.' precision]type), with width and precision resolved.
عام نوع مواصفة_تنسيق = {
    الحشو: ط32,
    المحاذاة: محاذاة_تنسيق,
    زائد: منطقي,
    بديل: منطقي,
    أصفار: منطقي,
    له_عرض: منطقي,
    العرض: طبيعي,
    له_دقة: منطقي,
    الدقة: طبيعي,
    الصيغة: صيغة_تنسيق
};

// The output buffer and the spec of the placeholder being written. Custom
// formatters receive it (Rust's &mut Formatter); reuse one for many writes.
عام نوع منسق = {
    الناتج: متجه ط8,
    المواصفة: مواصفة_تنسيق
};

// ---- Formatter -------------------------------------------------------------

عرف مواصفة_افتراضية(): مواصفة_تنسيق {
    دع الناتج: مواصفة_تنسيق = {
        الحشو: 32,
        المحاذاة: محاذاة_تنسيق.بلا(),
        زائد: خطأ,
        بديل: خطأ,
        أصفار: خطأ,
        له_عرض: خطأ,
        العرض: 0,
        له_دقة: خطأ,
        الدقة: 0,
        الصيغة: صيغة_تنسيق.عرض()
    };
    أرجع الناتج;
}

عام عرف أنشئ_منسقا_بسعة(السعة: طبيعي): منسق {
    دع البايتات: متغير متجه ط8 = [];
    لو (السعة > 0) { احجز_سعة(البايتات, السعة); };
    دع الناتج: منسق = { الناتج: البايتات, المواصفة: مواصفة_افتراضية() };
    أرجع الناتج;
}

عام عرف أنشئ_منسقا(): منسق {
    أرجع أنشئ_منسقا_بسعة(0);
}

// A copy of the text written so far.
عام عرف نص_المنسق(المنسق: &منسق): نص {
    دع النسخة: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    احجز_سعة(النسخة, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(النسخة, (*المنسق).الناتج[ف]); ف := ف + 1; }
    أرجع النسخة مثل نص;
}

// The text written so far, moved out without a copy; the formatter is left
// empty (Rust's std::mem::take on a String).
عام عرف خذ_نص_المنسق(المنسق: &متغير منسق): نص {
    دع الفارغ: متغير متجه ط8 = [];
    بدّل((*المنسق).الناتج, الفارغ);
    أرجع الفارغ مثل نص;
}

عام عرف طول_المنسق(المنسق: &منسق): طبيعي {
    أرجع الطول((*المنسق).الناتج) مثل طبيعي;
}

// Empties the formatter and keeps its buffer for the next writes.
عام عرف امسح_المنسق(المنسق: &متغير منسق): فراغ {
    اقتطع((*المنسق).الناتج, 0);
}

// The current placeholder's spec, for custom formatters (Rust's
// Formatter::width, precision, fill, align, alternate, sign_plus,
// sign_aware_zero_pad, and whether {:?} asked for Debug).
عام عرف عرض_المنسق(المنسق: &منسق): اختياري طبيعي {
    لو ((*المنسق).المواصفة.له_عرض) { أرجع اختياري.موجود((*المنسق).المواصفة.العرض); };
    أرجع اختياري.لا_شيء();
}

عام عرف دقة_المنسق(المنسق: &منسق): اختياري طبيعي {
    لو ((*المنسق).المواصفة.له_دقة) { أرجع اختياري.موجود((*المنسق).المواصفة.الدقة); };
    أرجع اختياري.لا_شيء();
}

// The fill character's code point (U+0020 by default).
عام عرف حشو_المنسق(المنسق: &منسق): ط32 { أرجع (*المنسق).المواصفة.الحشو; }
عام عرف محاذاة_المنسق(المنسق: &منسق): محاذاة_تنسيق { أرجع (*المنسق).المواصفة.المحاذاة; }
عام عرف المنسق_بديل(المنسق: &منسق): منطقي { أرجع (*المنسق).المواصفة.بديل; }
عام عرف المنسق_بإشارة(المنسق: &منسق): منطقي { أرجع (*المنسق).المواصفة.زائد; }
عام عرف المنسق_بأصفار(المنسق: &منسق): منطقي { أرجع (*المنسق).المواصفة.أصفار; }
عام عرف صيغة_المنسق(المنسق: &منسق): صيغة_تنسيق { أرجع (*المنسق).المواصفة.الصيغة; }

عام عرف المنسق_للتصحيح(المنسق: &منسق): منطقي {
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.تصحيح -> { أرجع صواب; }
    | صيغة_تنسيق.تصحيح_ست_عشري -> { أرجع صواب; }
    | صيغة_تنسيق.تصحيح_ست_عشري_كبير -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// Appends text as is, ignoring width and precision (Rust's write_str).
عام عرف اكتب_نصا_في_المنسق(المنسق: &متغير منسق, النص: &نص): نتيجة طبيعي, خطأ_تنسيق {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    ألحق_مقطع_نص(المنسق, النص, 0, العدد);
    أرجع نتيجة.نجح(العدد);
}

// Appends one character (Rust's write_char).
عام عرف اكتب_حرفا_في_المنسق(المنسق: &متغير منسق, المحرف: حرف): نتيجة طبيعي, خطأ_تنسيق {
    دع قبل: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    ألحق_رمزا(المنسق, المحرف مثل ط32);
    أرجع نتيجة.نجح((الطول((*المنسق).الناتج) مثل طبيعي) - قبل);
}

// Appends text honouring the current width, fill, alignment (left by
// default) and precision (Rust's Formatter::pad).
عام عرف احش_نصا(المنسق: &متغير منسق, النص: &نص): نتيجة طبيعي, خطأ_تنسيق {
    دع قبل: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    احش_مقطع_نص(المنسق, النص);
    أرجع نتيجة.نجح((الطول((*المنسق).الناتج) مثل طبيعي) - قبل);
}

// ---- Bytes and characters ------------------------------------------------------

عرف ألحق_مقطع_نص(المنسق: &متغير منسق, النص: &نص, البداية: طبيعي, النهاية: طبيعي): فراغ {
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { ألحق((*المنسق).الناتج, (*النص)[ف]); ف := ف + 1; }
}

// UTF-8 of one code point.
عرف ألحق_رمزا(المنسق: &متغير منسق, الرمز: ط32): فراغ {
    لو (الرمز < 0x80) { ألحق((*المنسق).الناتج, الرمز مثل ط8); أرجع; };
    لو (الرمز < 0x800) {
        ألحق((*المنسق).الناتج, (0xC0 | (الرمز >> 6)) مثل ط8);
        ألحق((*المنسق).الناتج, (0x80 | (الرمز & 0x3F)) مثل ط8);
        أرجع;
    };
    لو (الرمز < 0x10000) {
        ألحق((*المنسق).الناتج, (0xE0 | (الرمز >> 12)) مثل ط8);
        ألحق((*المنسق).الناتج, (0x80 | ((الرمز >> 6) & 0x3F)) مثل ط8);
        ألحق((*المنسق).الناتج, (0x80 | (الرمز & 0x3F)) مثل ط8);
        أرجع;
    };
    ألحق((*المنسق).الناتج, (0xF0 | (الرمز >> 18)) مثل ط8);
    ألحق((*المنسق).الناتج, (0x80 | ((الرمز >> 12) & 0x3F)) مثل ط8);
    ألحق((*المنسق).الناتج, (0x80 | ((الرمز >> 6) & 0x3F)) مثل ط8);
    ألحق((*المنسق).الناتج, (0x80 | (الرمز & 0x3F)) مثل ط8);
}

// The number of bytes of a well-formed UTF-8 sequence starting at الموضع,
// or 0 when the bytes there are not one.
عرف طول_رمز_عند(النص: &نص, الموضع: طبيعي): طبيعي {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع أ: ط8 = (*النص)[الموضع];
    لو (أ < 0x80) { أرجع 1; };
    دع الطول_المطلوب: متغير طبيعي = 0;
    لو (أ >= 0xC2 && أ <= 0xDF) { الطول_المطلوب := 2; }
    وإلا لو (أ >= 0xE0 && أ <= 0xEF) { الطول_المطلوب := 3; }
    وإلا لو (أ >= 0xF0 && أ <= 0xF4) { الطول_المطلوب := 4; }
    وإلا { أرجع 0; };
    لو (الموضع + الطول_المطلوب > العدد) { أرجع 0; };
    دع ف: متغير طبيعي = 1;
    طالما (ف < الطول_المطلوب) {
        لو (((*النص)[الموضع + ف] & 0xC0) != 0x80) { أرجع 0; };
        ف := ف + 1;
    }
    دع ب: ط8 = (*النص)[الموضع + 1];
    لو (أ == 0xE0 && ب < 0xA0) { أرجع 0; };
    لو (أ == 0xED && ب >= 0xA0) { أرجع 0; };
    لو (أ == 0xF0 && ب < 0x90) { أرجع 0; };
    لو (أ == 0xF4 && ب >= 0x90) { أرجع 0; };
    أرجع الطول_المطلوب;
}

// The code point of a well-formed sequence of الطول_ bytes.
عرف رمز_عند(النص: &نص, الموضع: طبيعي, الطول_: طبيعي): ط32 {
    دع أ: ط32 = (*النص)[الموضع] مثل ط32;
    لو (الطول_ == 1) { أرجع أ; };
    لو (الطول_ == 2) { أرجع ((أ & 0x1F) << 6) | (((*النص)[الموضع + 1] مثل ط32) & 0x3F); };
    لو (الطول_ == 3) {
        أرجع ((أ & 0x0F) << 12) | ((((*النص)[الموضع + 1] مثل ط32) & 0x3F) << 6)
            | (((*النص)[الموضع + 2] مثل ط32) & 0x3F);
    };
    أرجع ((أ & 0x07) << 18) | ((((*النص)[الموضع + 1] مثل ط32) & 0x3F) << 12)
        | ((((*النص)[الموضع + 2] مثل ط32) & 0x3F) << 6) | (((*النص)[الموضع + 3] مثل ط32) & 0x3F);
}

// ---- Width and padding -------------------------------------------------------

// A text's extent in user-perceived characters: النهاية is the byte offset
// after at most الحد clusters (all of them without a limit) and العدد the
// clusters before it.
نوع قياس_نص = { النهاية: طبيعي, العدد: طبيعي };

عرف قس_نصا(النص: &نص, له_حد: منطقي, الحد: طبيعي): قياس_نص {
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع بسيط: متغير منطقي = صواب;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد && بسيط) {
        دع ب: ط8 = (*النص)[ف];
        لو (ب >= 0x80 || ب == 0x0D) { بسيط := خطأ; };
        ف := ف + 1;
    }
    لو (بسيط) {
        لو (له_حد && الحد < العدد) {
            دع المقطوع: قياس_نص = { النهاية: الحد, العدد: الحد };
            أرجع المقطوع;
        };
        دع الكامل: قياس_نص = { النهاية: العدد, العدد: العدد };
        أرجع الكامل;
    };
    طابق حدود_عناقيد_بايتات_يونيكود(النص) مع
    | نتيجة.نجح(الحدود) -> {
        // The boundaries include 0 and the text's length.
        دع العناقيد: طبيعي = (الطول(الحدود) مثل طبيعي) - 1;
        لو (له_حد && الحد < العناقيد) {
            دع المقطوع: قياس_نص = { النهاية: الحدود[الحد], العدد: الحد };
            أرجع المقطوع;
        };
        دع الكامل: قياس_نص = { النهاية: العدد, العدد: العناقيد };
        أرجع الكامل;
    }
    | نتيجة.خطأ(_) -> {
        // Not UTF-8: count bytes.
        لو (له_حد && الحد < العدد) {
            دع المقطوع: قياس_نص = { النهاية: الحد, العدد: الحد };
            أرجع المقطوع;
        };
        دع الكامل: قياس_نص = { النهاية: العدد, العدد: العدد };
        أرجع الكامل;
    };
}

عرف اكتب_حشوا(المنسق: &متغير منسق, العدد: طبيعي): فراغ {
    دع الحشو: ط32 = (*المنسق).المواصفة.الحشو;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق_رمزا(المنسق, الحشو); ف := ف + 1; }
}

// Writes the padding before content of المحارف characters and returns the
// padding still to write after it. Center puts the odd one after (Rust).
عرف حشو_قبل(المنسق: &متغير منسق, المحارف: طبيعي, الافتراضية: محاذاة_تنسيق): طبيعي {
    لو (!(*المنسق).المواصفة.له_عرض) { أرجع 0; };
    دع العرض: طبيعي = (*المنسق).المواصفة.العرض;
    لو (العرض <= المحارف) { أرجع 0; };
    دع الحشو: طبيعي = العرض - المحارف;
    دع المحاذاة: متغير محاذاة_تنسيق = (*المنسق).المواصفة.المحاذاة;
    طابق المحاذاة مع
    | محاذاة_تنسيق.بلا -> { المحاذاة := الافتراضية; }
    | _ -> { };
    طابق المحاذاة مع
    | محاذاة_تنسيق.يسار -> { أرجع الحشو; }
    | محاذاة_تنسيق.وسط -> {
        دع القبلي: طبيعي = الحشو / 2;
        اكتب_حشوا(المنسق, القبلي);
        أرجع الحشو - القبلي;
    }
    | _ -> {
        اكتب_حشوا(المنسق, الحشو);
        أرجع 0;
    };
}

عرف احش_مقطع_نص(المنسق: &متغير منسق, النص: &نص): فراغ {
    دع له_عرض: منطقي = (*المنسق).المواصفة.له_عرض;
    دع له_دقة: منطقي = (*المنسق).المواصفة.له_دقة;
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    لو (!له_عرض && !له_دقة) { ألحق_مقطع_نص(المنسق, النص, 0, العدد); أرجع; };
    دع القياس: قياس_نص = قس_نصا(النص, له_دقة, (*المنسق).المواصفة.الدقة);
    دع البعدي: طبيعي = حشو_قبل(المنسق, القياس.العدد, محاذاة_تنسيق.يسار());
    ألحق_مقطع_نص(المنسق, النص, 0, القياس.النهاية);
    اكتب_حشوا(المنسق, البعدي);
}

// ---- Integers --------------------------------------------------------------

عرف عدد_خانات(القيمة: ط64, القاعدة: ط64): طبيعي {
    دع العدد: متغير طبيعي = 1;
    دع الباقي: متغير ط64 = القيمة;
    طالما (الباقي >= القاعدة) { الباقي := الباقي / القاعدة; العدد := العدد + 1; }
    أرجع العدد;
}

عرف ألحق_خانات(المنسق: &متغير منسق, القيمة: ط64, القاعدة: ط64, كبير: منطقي, العدد: طبيعي): فراغ {
    دع البداية: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق((*المنسق).الناتج, 0x30); ف := ف + 1; }
    دع الموضع: متغير طبيعي = البداية + العدد;
    دع الباقي: متغير ط64 = القيمة;
    طالما (الموضع > البداية) {
        الموضع := الموضع - 1;
        دع الرقم: ط8 = (الباقي % القاعدة) مثل ط8;
        لو (الرقم < 10) { (*المنسق).الناتج[الموضع] := 0x30 + الرقم; }
        وإلا لو (كبير) { (*المنسق).الناتج[الموضع] := 0x37 + الرقم; }
        وإلا { (*المنسق).الناتج[الموضع] := 0x57 + الرقم; };
        الباقي := الباقي / القاعدة;
    }
}

// The sign: '-' for a negative value, '+' when {:+} asked for one.
عرف بايت_الإشارة(المنسق: &منسق, سالب: منطقي): ط8 {
    لو (سالب) { أرجع 0x2D; };
    لو ((*المنسق).المواصفة.زائد) { أرجع 0x2B; };
    أرجع 0;
}

// Writes sign, prefix and body with sign-aware zero padding ({:08}: zeros
// after the sign and prefix, alignment ignored) or fill and alignment (right
// by default). The body is الخانات digits of a value, or the bytes of
// الجسم when الخانات is 0.
عرف اكتب_عددا_مركبا(
    المنسق: &متغير منسق,
    الإشارة: ط8,
    البادئة: ط8,
    القيمة: ط64,
    القاعدة: ط64,
    كبير: منطقي,
    الخانات: طبيعي,
    الجسم: &متجه ط8
): فراغ {
    دع طول_الإشارة: متغير طبيعي = 0;
    لو (الإشارة != 0) { طول_الإشارة := 1; };
    دع طول_البادئة: متغير طبيعي = 0;
    لو (البادئة != 0) { طول_البادئة := 2; };
    دع طول_الجسم: متغير طبيعي = الخانات;
    لو (الخانات == 0) { طول_الجسم := الطول(*الجسم) مثل طبيعي; };
    دع الكلي: طبيعي = طول_الإشارة + طول_البادئة + طول_الجسم;
    دع البعدي: متغير طبيعي = 0;
    دع الأصفار: متغير طبيعي = 0;
    لو ((*المنسق).المواصفة.أصفار) {
        لو ((*المنسق).المواصفة.له_عرض && (*المنسق).المواصفة.العرض > الكلي) {
            الأصفار := (*المنسق).المواصفة.العرض - الكلي;
        };
    } وإلا {
        البعدي := حشو_قبل(المنسق, الكلي, محاذاة_تنسيق.يمين());
    };
    لو (الإشارة != 0) { ألحق((*المنسق).الناتج, الإشارة); };
    لو (البادئة != 0) { ألحق((*المنسق).الناتج, 0x30); ألحق((*المنسق).الناتج, البادئة); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الأصفار) { ألحق((*المنسق).الناتج, 0x30); ف := ف + 1; }
    لو (الخانات != 0) {
        ألحق_خانات(المنسق, القيمة, القاعدة, كبير, الخانات);
    } وإلا {
        ف := 0;
        طالما (ف < طول_الجسم) { ألحق((*المنسق).الناتج, (*الجسم)[ف]); ف := ف + 1; }
    };
    اكتب_حشوا(المنسق, البعدي);
}

// An integer: magnitude, sign and width in bits (the two's complement of a
// negative value is taken at that width for x, X, o and b, as Rust does).
عرف اكتب_صحيحا(
    المنسق: &متغير منسق, الموضع: طبيعي, الخام: ط64, موقع: منطقي, البتات: طبيعي
): نتيجة طبيعي, خطأ_تنسيق {
    دع القناع: متغير ط64 = ~(0 مثل ط64);
    لو (البتات < 64) { القناع := ((1 مثل ط64) << (البتات مثل ط64)) - 1; };
    دع سالب: منطقي = موقع && ((الخام >> 63) & 1) == 1;
    دع القاعدة: متغير ط64 = 10;
    دع كبير: متغير منطقي = خطأ;
    دع البادئة: متغير ط8 = 0;
    دع أسي_: متغير منطقي = خطأ;
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.ست_عشري -> { القاعدة := 16; البادئة := 0x78; }
    | صيغة_تنسيق.تصحيح_ست_عشري -> { القاعدة := 16; البادئة := 0x78; }
    | صيغة_تنسيق.ست_عشري_كبير -> { القاعدة := 16; كبير := صواب; البادئة := 0x78; }
    | صيغة_تنسيق.تصحيح_ست_عشري_كبير -> { القاعدة := 16; كبير := صواب; البادئة := 0x78; }
    | صيغة_تنسيق.ثماني -> { القاعدة := 8; البادئة := 0x6F; }
    | صيغة_تنسيق.ثنائي -> { القاعدة := 2; البادئة := 0x62; }
    | صيغة_تنسيق.أسي -> { أسي_ := صواب; }
    | صيغة_تنسيق.أسي_كبير -> { أسي_ := صواب; كبير := صواب; }
    | _ -> { };
    لو (القاعدة != 10) {
        // x, X, o, b: the bit pattern at the type's width, no sign.
        لو (!(*المنسق).المواصفة.بديل) { البادئة := 0; };
        دع النمط: ط64 = الخام & القناع;
        دع فارغ: متجه ط8 = [];
        اكتب_عددا_مركبا(المنسق, بايت_الإشارة(المنسق, خطأ), البادئة, النمط, القاعدة, كبير, عدد_خانات(النمط, القاعدة), &فارغ);
        أرجع نتيجة.نجح(0);
    };
    دع المقدار: متغير ط64 = الخام & القناع;
    لو (سالب) { المقدار := (~الخام) + 1; };
    لو (أسي_) {
        // {:e} on an integer: its decimal digits in exponent form.
        دع الأرقام: متغير متجه ط8 = [];
        دع الباقي: متغير ط64 = المقدار;
        طالما (الباقي != 0) { ألحق(الأرقام, (الباقي % 10) مثل ط8); الباقي := الباقي / 10; }
        اعكس_أرقاما(&متغير الأرقام);
        دع النقطة: عدد = الطول(الأرقام) مثل عدد;
        احذف_الأصفار_الأخيرة(&متغير الأرقام);
        دع الجسم: متغير متجه ط8 = [];
        ابن_أسيا(المنسق, &متغير الجسم, &متغير الأرقام, النقطة, كبير);
        اكتب_عددا_مركبا(المنسق, بايت_الإشارة(المنسق, سالب), 0, 0, 10, خطأ, 0, &الجسم);
        أرجع نتيجة.نجح(0);
    };
    دع فارغ: متجه ط8 = [];
    اكتب_عددا_مركبا(المنسق, بايت_الإشارة(المنسق, سالب), 0, المقدار, 10, خطأ, عدد_خانات(المقدار, 10), &فارغ);
    أرجع نتيجة.نجح(0);
}

// ---- Floats -----------------------------------------------------------------

عرف اعكس_أرقاما(الأرقام: &متغير متجه ط8): فراغ {
    دع ي: متغير طبيعي = 0;
    دع ش: متغير طبيعي = الطول(*الأرقام) مثل طبيعي;
    طالما (ي + 1 < ش) {
        ش := ش - 1;
        دع م: ط8 = (*الأرقام)[ي];
        (*الأرقام)[ي] := (*الأرقام)[ش];
        (*الأرقام)[ش] := م;
        ي := ي + 1;
    }
}

عرف احذف_الأصفار_الأخيرة(الأرقام: &متغير متجه ط8): فراغ {
    دع ش: متغير طبيعي = الطول(*الأرقام) مثل طبيعي;
    طالما (ش > 0 && (*الأرقام)[ش - 1] == 0) { ش := ش - 1; }
    اقتطع(*الأرقام, ش);
}

// Keeps the first المحفوظ significant digits of 0.d1d2... * 10^النقطة,
// rounding the exact value half to even (Rust's {:.N} and {:.Ne}). Digits
// carry no trailing zeros, so a digit after the cut means "more follows".
عرف قرب_أرقاما(الأرقام: &متغير متجه ط8, النقطة: &متغير عدد, المحفوظ: عدد): فراغ {
    دع العدد: عدد = الطول(*الأرقام) مثل عدد;
    لو (المحفوظ >= العدد) { أرجع; };
    لو (المحفوظ < 0) { اقتطع(*الأرقام, 0); أرجع; };
    دع القطع: طبيعي = المحفوظ مثل طبيعي;
    دع التالي: ط8 = (*الأرقام)[القطع];
    دع ما_بعده: منطقي = العدد > المحفوظ + 1;
    دع فردي: متغير منطقي = خطأ;
    لو (القطع > 0) { فردي := ((*الأرقام)[القطع - 1] % 2) == 1; };
    دع للأعلى: منطقي = التالي > 5 || (التالي == 5 && (ما_بعده || فردي));
    اقتطع(*الأرقام, القطع);
    لو (للأعلى) {
        دع ف: متغير طبيعي = القطع;
        دع الحمل: متغير منطقي = صواب;
        طالما (الحمل && ف > 0) {
            ف := ف - 1;
            لو ((*الأرقام)[ف] == 9) { (*الأرقام)[ف] := 0; }
            وإلا { (*الأرقام)[ف] := (*الأرقام)[ف] + 1; الحمل := خطأ; };
        }
        لو (الحمل) {
            // 0.99..9 rounded up is 0.1 * 10^(n+1).
            اقتطع(*الأرقام, 0);
            ألحق(*الأرقام, 1);
            *النقطة := *النقطة + 1;
        };
    };
    احذف_الأصفار_الأخيرة(الأرقام);
}

عرف ألحق_رقما(الجسم: &متغير متجه ط8, الرقم: ط8): فراغ { ألحق(*الجسم, 0x30 + الرقم); }

// Positional: the integer part, then الدقة fraction digits when the spec has
// a precision, else every fraction digit (".0" for an integral value when
// نقطة_صفر, as Debug writes 1.0).
عرف ابن_موضعيا(
    المنسق: &منسق, الجسم: &متغير متجه ط8, الأرقام: &متجه ط8, النقطة: عدد, نقطة_صفر: منطقي
): فراغ {
    دع العدد: عدد = الطول(*الأرقام) مثل عدد;
    دع له_دقة: منطقي = (*المنسق).المواصفة.له_دقة;
    دع الدقة: طبيعي = (*المنسق).المواصفة.الدقة;
    لو (النقطة <= 0) {
        ألحق(*الجسم, 0x30);
    } وإلا {
        دع ف: متغير عدد = 0;
        طالما (ف < النقطة) {
            لو (ف < العدد) { ألحق_رقما(الجسم, (*الأرقام)[ف مثل طبيعي]); } وإلا { ألحق(*الجسم, 0x30); };
            ف := ف + 1;
        }
    };
    // Fraction digit j (0-based) is digit النقطة + j.
    دع الكسرية: متغير طبيعي = 0;
    لو (العدد > النقطة) { الكسرية := (العدد - النقطة) مثل طبيعي; };
    لو (له_دقة) {
        لو (الدقة == 0) { أرجع; };
        ألحق(*الجسم, 0x2E);
        دع ي: متغير طبيعي = 0;
        طالما (ي < الدقة) {
            دع الموضع: عدد = النقطة + (ي مثل عدد);
            لو (الموضع >= 0 && الموضع < العدد) { ألحق_رقما(الجسم, (*الأرقام)[الموضع مثل طبيعي]); }
            وإلا { ألحق(*الجسم, 0x30); };
            ي := ي + 1;
        }
        أرجع;
    };
    لو (الكسرية == 0) {
        لو (نقطة_صفر) { ألحق(*الجسم, 0x2E); ألحق(*الجسم, 0x30); };
        أرجع;
    };
    ألحق(*الجسم, 0x2E);
    دع ي: متغير طبيعي = 0;
    طالما (ي < الكسرية) {
        دع الموضع: عدد = النقطة + (ي مثل عدد);
        لو (الموضع >= 0) { ألحق_رقما(الجسم, (*الأرقام)[الموضع مثل طبيعي]); } وإلا { ألحق(*الجسم, 0x30); };
        ي := ي + 1;
    }
}

// Exponent form d.ddde<exp> (Rust writes no '+' and no exponent padding);
// with a precision, exactly الدقة digits after the point.
عرف ابن_أسيا(
    المنسق: &منسق, الجسم: &متغير متجه ط8, الأرقام: &متغير متجه ط8, النقطة_: عدد, كبير: منطقي
): فراغ {
    دع النقطة: متغير عدد = النقطة_;
    دع له_دقة: منطقي = (*المنسق).المواصفة.له_دقة;
    دع الدقة: طبيعي = (*المنسق).المواصفة.الدقة;
    لو (له_دقة) { قرب_أرقاما(الأرقام, &متغير النقطة, (الدقة مثل عدد) + 1); };
    دع العدد: طبيعي = الطول(*الأرقام) مثل طبيعي;
    دع الأس: متغير عدد = 0;
    لو (العدد == 0) {
        ألحق(*الجسم, 0x30);
    } وإلا {
        ألحق_رقما(الجسم, (*الأرقام)[0]);
        الأس := النقطة - 1;
    };
    لو (له_دقة) {
        لو (الدقة > 0) {
            ألحق(*الجسم, 0x2E);
            دع ي: متغير طبيعي = 1;
            طالما (ي <= الدقة) {
                لو (ي < العدد) { ألحق_رقما(الجسم, (*الأرقام)[ي]); } وإلا { ألحق(*الجسم, 0x30); };
                ي := ي + 1;
            }
        };
    } وإلا لو (العدد > 1) {
        ألحق(*الجسم, 0x2E);
        دع ي: متغير طبيعي = 1;
        طالما (ي < العدد) { ألحق_رقما(الجسم, (*الأرقام)[ي]); ي := ي + 1; }
    };
    لو (كبير) { ألحق(*الجسم, 0x45); } وإلا { ألحق(*الجسم, 0x65); };
    دع المطلق: متغير طبيعي = 0;
    لو (الأس < 0) { ألحق(*الجسم, 0x2D); المطلق := (0 - الأس) مثل طبيعي; } وإلا { المطلق := الأس مثل طبيعي; };
    دع البداية: طبيعي = الطول(*الجسم) مثل طبيعي;
    دع الخانات: طبيعي = عدد_خانات(المطلق مثل ط64, 10);
    دع ف: متغير طبيعي = 0;
    طالما (ف < الخانات) { ألحق(*الجسم, 0x30); ف := ف + 1; }
    دع الموضع: متغير طبيعي = البداية + الخانات;
    طالما (الموضع > البداية) {
        الموضع := الموضع - 1;
        (*الجسم)[الموضع] := 0x30 + ((المطلق % 10) مثل ط8);
        المطلق := المطلق / 10;
    }
}

// A float from its digits (std.text.float: the shortest, or with a
// precision the value rounded half to even, which the rounding here then
// leaves as it is): Display writes positional text
// (no exponent, "-0" for negative zero), Debug positional with ".0" between
// 1e-4 and 1e16 and exponent form outside, e/E exponent form. NaN carries no
// sign; inf takes '-' or '+' like a number; zero padding applies to both, as
// in Rust.
عرف اكتب_عائما(المنسق: &متغير منسق, القيمة_: أرقام_عائم): فراغ {
    دع القيمة: متغير أرقام_عائم = القيمة_;
    دع الجسم: متغير متجه ط8 = [];
    دع سالب: متغير منطقي = القيمة.سالب;
    لو (القيمة.الصنف == 2) {
        سالب := خطأ;
        ألحق(الجسم, 0x4E); ألحق(الجسم, 0x61); ألحق(الجسم, 0x4E);
        اكتب_عددا_مركبا(المنسق, 0, 0, 0, 10, خطأ, 0, &الجسم);
        أرجع;
    };
    لو (القيمة.الصنف == 1) {
        ألحق(الجسم, 0x69); ألحق(الجسم, 0x6E); ألحق(الجسم, 0x66);
        اكتب_عددا_مركبا(المنسق, بايت_الإشارة(المنسق, سالب), 0, 0, 10, خطأ, 0, &الجسم);
        أرجع;
    };
    دع الأرقام: متغير متجه ط8 = [];
    بدّل(الأرقام, القيمة.الأرقام);
    دع النقطة: متغير عدد = القيمة.النقطة;
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.أسي -> { ابن_أسيا(المنسق, &متغير الجسم, &متغير الأرقام, النقطة, خطأ); }
    | صيغة_تنسيق.أسي_كبير -> { ابن_أسيا(المنسق, &متغير الجسم, &متغير الأرقام, النقطة, صواب); }
    | صيغة_تنسيق.عرض -> {
        لو ((*المنسق).المواصفة.له_دقة) {
            قرب_أرقاما(&متغير الأرقام, &متغير النقطة, النقطة + ((*المنسق).المواصفة.الدقة مثل عدد));
        };
        ابن_موضعيا(المنسق, &متغير الجسم, &الأرقام, النقطة, خطأ);
    }
    | _ -> {
        // Debug.
        لو ((*المنسق).المواصفة.له_دقة) {
            قرب_أرقاما(&متغير الأرقام, &متغير النقطة, النقطة + ((*المنسق).المواصفة.الدقة مثل عدد));
            ابن_موضعيا(المنسق, &متغير الجسم, &الأرقام, النقطة, خطأ);
        } وإلا {
            دع الأس: عدد = النقطة - 1;
            لو ((الطول(الأرقام) مثل طبيعي) > 0 && (الأس < -4 || الأس >= 16)) {
                ابن_أسيا(المنسق, &متغير الجسم, &متغير الأرقام, النقطة, خطأ);
            } وإلا {
                ابن_موضعيا(المنسق, &متغير الجسم, &الأرقام, النقطة, صواب);
            };
        };
    };
    اكتب_عددا_مركبا(المنسق, بايت_الإشارة(المنسق, سالب), 0, 0, 10, خطأ, 0, &الجسم);
}

عرف صيغة_أسية(المنسق: &منسق): منطقي {
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.أسي -> { أرجع صواب; }
    | صيغة_تنسيق.أسي_كبير -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// ---- Debug text ------------------------------------------------------------

عرف ألحق_نصا_ثابتا(المنسق: &متغير منسق, النص: نص): فراغ {
    دع العدد: طبيعي = الطول(النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق((*المنسق).الناتج, النص[ف]); ف := ف + 1; }
}

// \u{hex} with lowercase digits, as Rust's escape_debug writes.
عرف ألحق_هروب_يونيكود(المنسق: &متغير منسق, الرمز: ط32): فراغ {
    ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x75); ألحق((*المنسق).الناتج, 0x7B);
    ألحق_خانات(المنسق, الرمز مثل ط64, 16, خطأ, عدد_خانات(الرمز مثل ط64, 16));
    ألحق((*المنسق).الناتج, 0x7D);
}

// Rust's escape_debug: control, format, separator (other than space),
// private-use, surrogate and unassigned code points are escaped; a
// combining mark is escaped where it starts the value (a char, or the first
// character of a text). Rust also escapes a combining mark after a letter
// inside text; std.fmt keeps it, so Arabic harakat stay readable.
عرف يهرب_في_التصحيح(الرمز: ط32, في_البداية: منطقي): منطقي {
    لو (الرمز < 0x20 || الرمز == 0x7F) { أرجع صواب; };
    لو (الرمز < 0x7F) { أرجع خطأ; };
    طابق فئة_محرف_يونيكود(الرمز) مع
    | فئة_يونيكود.تحكم -> { أرجع صواب; }
    | فئة_يونيكود.تنسيق -> { أرجع صواب; }
    | فئة_يونيكود.فاصل_سطر -> { أرجع صواب; }
    | فئة_يونيكود.فاصل_فقرة -> { أرجع صواب; }
    | فئة_يونيكود.فاصل_مسافة -> { أرجع صواب; }
    | فئة_يونيكود.استخدام_خاص -> { أرجع صواب; }
    | فئة_يونيكود.بديل -> { أرجع صواب; }
    | فئة_يونيكود.غير_معين -> { أرجع صواب; }
    | فئة_يونيكود.علامة_غير_متباعدة -> { أرجع في_البداية; }
    | فئة_يونيكود.علامة_إحاطة -> { أرجع في_البداية; }
    | _ -> { أرجع خطأ; };
}

// One character of Debug output: the short escapes, \u{…} for what
// يهرب_في_التصحيح selects, else its UTF-8.
عرف اكتب_رمزا_للتصحيح(المنسق: &متغير منسق, الرمز: ط32, الاقتباس: ط8, في_البداية: منطقي): فراغ {
    لو (الرمز == 0x09) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x74); أرجع; };
    لو (الرمز == 0x0D) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x72); أرجع; };
    لو (الرمز == 0x0A) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x6E); أرجع; };
    لو (الرمز == 0x5C) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x5C); أرجع; };
    لو (الرمز == 0x00) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, 0x30); أرجع; };
    لو (الرمز == (الاقتباس مثل ط32)) { ألحق((*المنسق).الناتج, 0x5C); ألحق((*المنسق).الناتج, الاقتباس); أرجع; };
    لو (يهرب_في_التصحيح(الرمز, في_البداية)) { ألحق_هروب_يونيكود(المنسق, الرمز); أرجع; };
    ألحق_رمزا(المنسق, الرمز);
}

// A quoted, escaped text ("…" for text). Width does not apply, as in Rust.
عرف اكتب_نصا_للتصحيح(المنسق: &متغير منسق, النص: &نص, الاقتباس: ط8): فراغ {
    ألحق((*المنسق).الناتج, الاقتباس);
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*النص)[ف];
        لو (ب >= 0x20 && ب < 0x7F && ب != 0x5C && ب != الاقتباس) {
            ألحق((*المنسق).الناتج, ب);
            ف := ف + 1;
        } وإلا {
            دع الطول_: طبيعي = طول_رمز_عند(النص, ف);
            لو (الطول_ == 0) {
                ألحق_هروب_يونيكود(المنسق, 0xFFFD);
                ف := ف + 1;
            } وإلا {
                اكتب_رمزا_للتصحيح(المنسق, رمز_عند(النص, ف, الطول_), الاقتباس, ف == 0);
                ف := ف + الطول_;
            };
        };
    }
    ألحق((*المنسق).الناتج, الاقتباس);
}

// Bytes as text: well-formed UTF-8 as is, every ill-formed byte as U+FFFD
// (Rust's String::from_utf8_lossy, one replacement per byte).
عرف نص_من_بايتات_بتسامح(البايتات: &متجه ط8): نص {
    دع المصدر: نص = نسخة_نصية(البايتات);
    دع الناتج: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(المصدر) مثل طبيعي;
    احجز_سعة(الناتج, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع الطول_: طبيعي = طول_رمز_عند(&المصدر, ف);
        لو (الطول_ == 0) {
            ألحق(الناتج, 0xEF); ألحق(الناتج, 0xBF); ألحق(الناتج, 0xBD);
            ف := ف + 1;
        } وإلا {
            دع ي: متغير طبيعي = 0;
            طالما (ي < الطول_) { ألحق(الناتج, المصدر[ف + ي]); ي := ي + 1; }
            ف := ف + الطول_;
        };
    }
    أرجع الناتج مثل نص;
}

عرف نسخة_نصية(البايتات: &متجه ط8): نص {
    دع النسخة: متغير متجه ط8 = [];
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    احجز_سعة(النسخة, العدد);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(النسخة, (*البايتات)[ف]); ف := ف + 1; }
    أرجع النسخة مثل نص;
}

// ---- Lists (Debug) -----------------------------------------------------------

// {:#?}: indents every line an element wrote after its first (Rust's
// PadAdapter), so nested lists and multi-line custom output line up.
عرف أزح_الأسطر(المنسق: &متغير منسق, البداية: طبيعي): فراغ {
    دع النهاية: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    دع فيه_سطر: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) { لو ((*المنسق).الناتج[ف] == 0x0A) { فيه_سطر := صواب; }; ف := ف + 1; }
    لو (!فيه_سطر) { أرجع; };
    دع الذيل: متغير متجه ط8 = [];
    ف := البداية;
    طالما (ف < النهاية) {
        دع ب: ط8 = (*المنسق).الناتج[ف];
        ألحق(الذيل, ب);
        لو (ب == 0x0A) { ألحق(الذيل, 0x20); ألحق(الذيل, 0x20); ألحق(الذيل, 0x20); ألحق(الذيل, 0x20); };
        ف := ف + 1;
    }
    اقتطع((*المنسق).الناتج, البداية);
    ف := 0;
    طالما (ف < (الطول(الذيل) مثل طبيعي)) { ألحق((*المنسق).الناتج, الذيل[ف]); ف := ف + 1; }
}

// Opens or separates list entries: "[" / ", " or, pretty, "[\n    " / ",\n    ".
عرف افتح_قائمة(المنسق: &متغير منسق, العدد: طبيعي): فراغ {
    ألحق((*المنسق).الناتج, 0x5B);
    لو ((*المنسق).المواصفة.بديل && العدد > 0) { ألحق((*المنسق).الناتج, 0x0A); };
}

عرف قبل_عنصر(المنسق: &متغير منسق, الموضع: طبيعي): طبيعي {
    لو ((*المنسق).المواصفة.بديل) {
        ألحق_نصا_ثابتا(المنسق, «    »);
    } وإلا لو (الموضع > 0) {
        ألحق((*المنسق).الناتج, 0x2C); ألحق((*المنسق).الناتج, 0x20);
    };
    أرجع الطول((*المنسق).الناتج) مثل طبيعي;
}

عرف بعد_عنصر(المنسق: &متغير منسق, البداية: طبيعي): فراغ {
    لو ((*المنسق).المواصفة.بديل) {
        أزح_الأسطر(المنسق, البداية);
        ألحق((*المنسق).الناتج, 0x2C); ألحق((*المنسق).الناتج, 0x0A);
    };
}

عرف أغلق_قائمة(المنسق: &متغير منسق): فراغ {
    ألحق((*المنسق).الناتج, 0x5D);
}

// ---- One value ---------------------------------------------------------------

عرف صيغة_عرض_أو_تصحيح(المنسق: &منسق): منطقي {
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.عرض -> { أرجع صواب; }
    | صيغة_تنسيق.تصحيح -> { أرجع صواب; }
    | صيغة_تنسيق.تصحيح_ست_عشري -> { أرجع صواب; }
    | صيغة_تنسيق.تصحيح_ست_عشري_كبير -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف صيغة_عائمة(المنسق: &منسق): منطقي {
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.أسي -> { أرجع صواب; }
    | صيغة_تنسيق.أسي_كبير -> { أرجع صواب; }
    | _ -> { أرجع صيغة_عرض_أو_تصحيح(المنسق); };
}

عرف صيغة_تصحيح_فقط(المنسق: &منسق): منطقي {
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.عرض -> { أرجع خطأ; }
    | _ -> { أرجع صيغة_عرض_أو_تصحيح(المنسق); };
}

عرف اكتب_منطقيا(المنسق: &متغير منسق, القيمة: منطقي): فراغ {
    لو (القيمة) {
        دع النص: نص = «true»;
        احش_مقطع_نص(المنسق, &النص);
    } وإلا {
        دع النص: نص = «false»;
        احش_مقطع_نص(المنسق, &النص);
    };
}

// A char: Display pads one character (precision 0 writes nothing, as
// Rust's pad does); Debug quotes and escapes it, without width.
عرف اكتب_حرفا_منسقا(المنسق: &متغير منسق, المحرف: حرف): فراغ {
    دع الرمز: ط32 = المحرف مثل ط32;
    طابق (*المنسق).المواصفة.الصيغة مع
    | صيغة_تنسيق.عرض -> {
        دع يكتب: منطقي = !((*المنسق).المواصفة.له_دقة && (*المنسق).المواصفة.الدقة == 0);
        دع المحارف: متغير طبيعي = 0;
        لو (يكتب) { المحارف := 1; };
        دع البعدي: طبيعي = حشو_قبل(المنسق, المحارف, محاذاة_تنسيق.يسار());
        لو (يكتب) { ألحق_رمزا(المنسق, الرمز); };
        اكتب_حشوا(المنسق, البعدي);
    }
    | _ -> {
        ألحق((*المنسق).الناتج, 0x27);
        اكتب_رمزا_للتصحيح(المنسق, الرمز, 0x27, صواب);
        ألحق((*المنسق).الناتج, 0x27);
    };
}

// Writes one argument with the formatter's current spec. الموضع is the
// argument's index for error reports.
عرف اكتب_قيمة(المنسق: &متغير منسق, القيمة: &قيمة_تنسيق, الموضع: طبيعي): نتيجة طبيعي, خطأ_تنسيق {
    طابق *القيمة مع
    | قيمة_تنسيق.عدد(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, صواب, 64); }
    | قيمة_تنسيق.طبيعي(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, خطأ, 64); }
    | قيمة_تنسيق.ص8(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, صواب, 8); }
    | قيمة_تنسيق.ص16(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, صواب, 16); }
    | قيمة_تنسيق.ص32(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, صواب, 32); }
    | قيمة_تنسيق.ص64(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, صواب, 64); }
    | قيمة_تنسيق.ط8(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, خطأ, 8); }
    | قيمة_تنسيق.ط16(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, خطأ, 16); }
    | قيمة_تنسيق.ط32(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س مثل ط64, خطأ, 32); }
    | قيمة_تنسيق.ط64(س) -> { أرجع اكتب_صحيحا(المنسق, الموضع, س, خطأ, 64); }
    | قيمة_تنسيق.ع64(س) -> {
        لو (!صيغة_عائمة(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        لو (!(*المنسق).المواصفة.له_دقة) { اكتب_عائما(المنسق, أرقام_ع64_الأقصر(س)); }
        وإلا لو (صيغة_أسية(المنسق)) { اكتب_عائما(المنسق, أرقام_ع64_بخانات_معنوية(س, (*المنسق).المواصفة.الدقة + 1)); }
        وإلا { اكتب_عائما(المنسق, أرقام_ع64_بخانات_كسرية(س, (*المنسق).المواصفة.الدقة)); };
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.ع32(س) -> {
        لو (!صيغة_عائمة(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        لو (!(*المنسق).المواصفة.له_دقة) { اكتب_عائما(المنسق, أرقام_ع32_الأقصر(س)); }
        وإلا لو (صيغة_أسية(المنسق)) { اكتب_عائما(المنسق, أرقام_ع32_بخانات_معنوية(س, (*المنسق).المواصفة.الدقة + 1)); }
        وإلا { اكتب_عائما(المنسق, أرقام_ع32_بخانات_كسرية(س, (*المنسق).المواصفة.الدقة)); };
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.منطقي(س) -> {
        لو (!صيغة_عرض_أو_تصحيح(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        اكتب_منطقيا(المنسق, س);
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.حرف(س) -> {
        لو (!صيغة_عرض_أو_تصحيح(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        اكتب_حرفا_منسقا(المنسق, س);
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.نص(س) -> {
        طابق (*المنسق).المواصفة.الصيغة مع
        | صيغة_تنسيق.عرض -> { احش_مقطع_نص(المنسق, س); }
        | _ -> {
            لو (!صيغة_عرض_أو_تصحيح(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
            اكتب_نصا_للتصحيح(المنسق, س, 0x22);
        };
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.بايتات(س) -> {
        طابق (*المنسق).المواصفة.الصيغة مع
        | صيغة_تنسيق.عرض -> {
            دع النص: نص = نص_من_بايتات_بتسامح(س);
            احش_مقطع_نص(المنسق, &النص);
        }
        | صيغة_تنسيق.ست_عشري -> { اكتب_بايتات_ست_عشرية(المنسق, س, خطأ); }
        | صيغة_تنسيق.ست_عشري_كبير -> { اكتب_بايتات_ست_عشرية(المنسق, س, صواب); }
        | _ -> {
            لو (!صيغة_تصحيح_فقط(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
            افتح_قائمة(المنسق, الطول(*س) مثل طبيعي);
            دع ف: متغير طبيعي = 0;
            طالما (ف < (الطول(*س) مثل طبيعي)) {
                دع البداية: طبيعي = قبل_عنصر(المنسق, ف);
                اكتب_صحيحا(المنسق, الموضع, (*س)[ف] مثل ط64, خطأ, 8)؟;
                بعد_عنصر(المنسق, البداية);
                ف := ف + 1;
            }
            أغلق_قائمة(المنسق);
        };
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.أعداد(س) -> {
        لو (!صيغة_تصحيح_فقط(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        افتح_قائمة(المنسق, الطول(*س) مثل طبيعي);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*س) مثل طبيعي)) {
            دع البداية: طبيعي = قبل_عنصر(المنسق, ف);
            اكتب_صحيحا(المنسق, الموضع, (*س)[ف] مثل ط64, صواب, 64)؟;
            بعد_عنصر(المنسق, البداية);
            ف := ف + 1;
        }
        أغلق_قائمة(المنسق);
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.نصوص(س) -> {
        لو (!صيغة_تصحيح_فقط(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        افتح_قائمة(المنسق, الطول(*س) مثل طبيعي);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*س) مثل طبيعي)) {
            دع البداية: طبيعي = قبل_عنصر(المنسق, ف);
            اكتب_نصا_للتصحيح(المنسق, &(*س)[ف], 0x22);
            بعد_عنصر(المنسق, البداية);
            ف := ف + 1;
        }
        أغلق_قائمة(المنسق);
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.قائمة(س) -> {
        لو (!صيغة_تصحيح_فقط(المنسق)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_مناسب(الموضع)); };
        افتح_قائمة(المنسق, الطول(*س) مثل طبيعي);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*س) مثل طبيعي)) {
            دع البداية: طبيعي = قبل_عنصر(المنسق, ف);
            اكتب_قيمة(المنسق, &(*س)[ف], الموضع)؟;
            بعد_عنصر(المنسق, البداية);
            ف := ف + 1;
        }
        أغلق_قائمة(المنسق);
        أرجع نتيجة.نجح(0);
    }
    | قيمة_تنسيق.مخصص(الدالة) -> {
        دع المحفوظة: مواصفة_تنسيق = (*المنسق).المواصفة;
        دع الناتج: نتيجة طبيعي, خطأ_تنسيق = الدالة(&متغير *المنسق);
        (*المنسق).المواصفة := المحفوظة;
        أرجع الناتج;
    };
}

// {:x} / {:X} on bytes: two hex digits per byte (Go's %x), "0x" first with #.
عرف اكتب_بايتات_ست_عشرية(المنسق: &متغير منسق, البايتات: &متجه ط8, كبير: منطقي): فراغ {
    دع الجسم: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البايتات) مثل طبيعي)) {
        دع ب: ط8 = (*البايتات)[ف];
        دع أعلى: ط8 = ب >> 4;
        دع أدنى: ط8 = ب & 0x0F;
        ألحق(الجسم, خانة_ست_عشرية(أعلى, كبير));
        ألحق(الجسم, خانة_ست_عشرية(أدنى, كبير));
        ف := ف + 1;
    }
    دع البادئة: متغير ط8 = 0;
    لو ((*المنسق).المواصفة.بديل) { البادئة := 0x78; };
    اكتب_عددا_مركبا(المنسق, 0, البادئة, 0, 16, كبير, 0, &الجسم);
}

عرف خانة_ست_عشرية(الرقم: ط8, كبير: منطقي): ط8 {
    لو (الرقم < 10) { أرجع 0x30 + الرقم; };
    لو (كبير) { أرجع 0x37 + الرقم; };
    أرجع 0x57 + الرقم;
}

// ---- The format string -------------------------------------------------------

عرف رقم_عشري_(البايت: ط8): منطقي { أرجع البايت >= 0x30 && البايت <= 0x39; }

// The start of a named argument: an ASCII letter, '_' or any non-ASCII
// character (Rust's identifiers are XID).
عرف بداية_اسم(البايت: ط8): منطقي {
    أرجع (البايت >= 0x41 && البايت <= 0x5A) || (البايت >= 0x61 && البايت <= 0x7A)
        || البايت == 0x5F || البايت >= 0x80;
}

عرف بايت_محاذاة(البايت: ط8): منطقي { أرجع البايت == 0x3C || البايت == 0x5E || البايت == 0x3E; }

عرف محاذاة_من_بايت(البايت: ط8): محاذاة_تنسيق {
    لو (البايت == 0x3C) { أرجع محاذاة_تنسيق.يسار(); };
    لو (البايت == 0x5E) { أرجع محاذاة_تنسيق.وسط(); };
    أرجع محاذاة_تنسيق.يمين();
}

// Format width and precision are at most 65535, as in Rust (u16).
عرف أقصى_عدد(): طبيعي { أرجع 65535; }

// Parser state for one format string.
نوع حالة_تحليل = {
    الموضع: طبيعي,
    التالي: طبيعي,
    المستخدمة: ط64,
    المستخدمة_الزائدة: متجه منطقي
};

عرف علم_مستخدما(الحالة: &متغير حالة_تحليل, الفهرس: طبيعي): فراغ {
    لو (الفهرس < 64) {
        (*الحالة).المستخدمة := (*الحالة).المستخدمة | ((1 مثل ط64) << (الفهرس مثل ط64));
        أرجع;
    };
    طالما ((الطول((*الحالة).المستخدمة_الزائدة) مثل طبيعي) <= الفهرس - 64) {
        ألحق((*الحالة).المستخدمة_الزائدة, خطأ);
    }
    (*الحالة).المستخدمة_الزائدة[الفهرس - 64] := صواب;
}

عرف مستخدم(الحالة: &حالة_تحليل, الفهرس: طبيعي): منطقي {
    لو (الفهرس < 64) { أرجع (((*الحالة).المستخدمة >> (الفهرس مثل ط64)) & 1) == 1; };
    لو ((الطول((*الحالة).المستخدمة_الزائدة) مثل طبيعي) <= الفهرس - 64) { أرجع خطأ; };
    أرجع (*الحالة).المستخدمة_الزائدة[الفهرس - 64];
}

// A decimal integer at the state's position; none past 65535.
عرف حلل_عددا_صحيحا(القالب: &نص, الحالة: &متغير حالة_تحليل): اختياري طبيعي {
    دع العدد: طبيعي = الطول(*القالب) مثل طبيعي;
    دع القيمة: متغير طبيعي = 0;
    طالما ((*الحالة).الموضع < العدد && رقم_عشري_((*القالب)[(*الحالة).الموضع])) {
        القيمة := القيمة * 10 + (((*القالب)[(*الحالة).الموضع] - 0x30) مثل طبيعي);
        لو (القيمة > أقصى_عدد()) { أرجع اختياري.لا_شيء(); };
        (*الحالة).الموضع := (*الحالة).الموضع + 1;
    }
    أرجع اختياري.موجود(القيمة);
}

// A width or precision argument: a non-negative integer of at most 65535.
عرف عدد_من_وسيط(الوسائط: &متجه قيمة_تنسيق, الفهرس: طبيعي): نتيجة طبيعي, خطأ_تنسيق {
    لو (الفهرس >= (الطول(*الوسائط) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_مفقود(الفهرس)); };
    دع القيمة: متغير ط64 = 0;
    دع سالب: متغير منطقي = خطأ;
    طابق (*الوسائط)[الفهرس] مع
    | قيمة_تنسيق.عدد(س) -> { سالب := س < 0; القيمة := س مثل ط64; }
    | قيمة_تنسيق.طبيعي(س) -> { القيمة := س مثل ط64; }
    | قيمة_تنسيق.ص8(س) -> { سالب := س < 0; القيمة := س مثل ط64; }
    | قيمة_تنسيق.ص16(س) -> { سالب := س < 0; القيمة := س مثل ط64; }
    | قيمة_تنسيق.ص32(س) -> { سالب := س < 0; القيمة := س مثل ط64; }
    | قيمة_تنسيق.ص64(س) -> { سالب := س < 0; القيمة := س مثل ط64; }
    | قيمة_تنسيق.ط8(س) -> { القيمة := س مثل ط64; }
    | قيمة_تنسيق.ط16(س) -> { القيمة := س مثل ط64; }
    | قيمة_تنسيق.ط32(س) -> { القيمة := س مثل ط64; }
    | قيمة_تنسيق.ط64(س) -> { القيمة := س; }
    | _ -> { أرجع نتيجة.خطأ(خطأ_تنسيق.عدد_غير_صالح(الفهرس)); };
    لو (سالب || القيمة > (أقصى_عدد() مثل ط64)) { أرجع نتيجة.خطأ(خطأ_تنسيق.عدد_غير_صالح(الفهرس)); };
    أرجع نتيجة.نجح(القيمة مثل طبيعي);
}

// What a count names: a literal, an argument ("N$"), or the next argument (".*").
نوع عد_محلل =
    | بلا_عد
    | قيمة_عد بنوع طبيعي
    | وسيط_عد بنوع طبيعي
    | التالي_عد
;

// One placeholder from just after '{' to just after '}', written into the
// formatter.
عرف نسق_موضعا(
    المنسق: &متغير منسق,
    القالب: &نص,
    الوسائط: &متجه قيمة_تنسيق,
    الحالة: &متغير حالة_تحليل,
    الفتح: طبيعي
): نتيجة طبيعي, خطأ_تنسيق {
    دع العدد: طبيعي = الطول(*القالب) مثل طبيعي;
    // argument := integer | identifier
    دع له_فهرس: متغير منطقي = خطأ;
    دع الفهرس: متغير طبيعي = 0;
    لو ((*الحالة).الموضع < العدد && رقم_عشري_((*القالب)[(*الحالة).الموضع])) {
        طابق حلل_عددا_صحيحا(القالب, الحالة) مع
        | اختياري.موجود(س) -> { الفهرس := س; له_فهرس := صواب; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تنسيق.مواصفة_غير_صالحة((*الحالة).الموضع)); };
    } وإلا لو ((*الحالة).الموضع < العدد && بداية_اسم((*القالب)[(*الحالة).الموضع])) {
        أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_مسمى((*الحالة).الموضع));
    };
    دع المواصفة: متغير مواصفة_تنسيق = مواصفة_افتراضية();
    دع العرض: متغير عد_محلل = عد_محلل.بلا_عد();
    دع الدقة: متغير عد_محلل = عد_محلل.بلا_عد();
    لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x3A) {
        (*الحالة).الموضع := (*الحالة).الموضع + 1;
        // [[fill]align]: the fill is any character followed by an alignment.
        لو ((*الحالة).الموضع < العدد) {
            دع طول_المحرف: متغير طبيعي = طول_رمز_عند(القالب, (*الحالة).الموضع);
            لو (طول_المحرف == 0) { طول_المحرف := 1; };
            دع بعده: طبيعي = (*الحالة).الموضع + طول_المحرف;
            لو (بعده < العدد && بايت_محاذاة((*القالب)[بعده])) {
                لو (طول_المحرف == 1) { المواصفة.الحشو := (*القالب)[(*الحالة).الموضع] مثل ط32; }
                وإلا { المواصفة.الحشو := رمز_عند(القالب, (*الحالة).الموضع, طول_المحرف); };
                المواصفة.المحاذاة := محاذاة_من_بايت((*القالب)[بعده]);
                (*الحالة).الموضع := بعده + 1;
            } وإلا لو (بايت_محاذاة((*القالب)[(*الحالة).الموضع])) {
                المواصفة.المحاذاة := محاذاة_من_بايت((*القالب)[(*الحالة).الموضع]);
                (*الحالة).الموضع := (*الحالة).الموضع + 1;
            };
        };
        // [sign]
        لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x2B) {
            المواصفة.زائد := صواب;
            (*الحالة).الموضع := (*الحالة).الموضع + 1;
        } وإلا لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x2D) {
            // '-' is accepted and unused, as in Rust.
            (*الحالة).الموضع := (*الحالة).الموضع + 1;
        };
        // ['#']
        لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x23) {
            المواصفة.بديل := صواب;
            (*الحالة).الموضع := (*الحالة).الموضع + 1;
        };
        // ['0'], unless it is the argument of a width "0$".
        لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x30) {
            دع دولار: منطقي = (*الحالة).الموضع + 1 < العدد && (*القالب)[(*الحالة).الموضع + 1] == 0x24;
            لو (!دولار) {
                المواصفة.أصفار := صواب;
                (*الحالة).الموضع := (*الحالة).الموضع + 1;
            };
        };
        // [width] := integer | integer '$' | identifier '$'
        لو ((*الحالة).الموضع < العدد && رقم_عشري_((*القالب)[(*الحالة).الموضع])) {
            طابق حلل_عددا_صحيحا(القالب, الحالة) مع
            | اختياري.موجود(س) -> {
                لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x24) {
                    (*الحالة).الموضع := (*الحالة).الموضع + 1;
                    العرض := عد_محلل.وسيط_عد(س);
                } وإلا { العرض := عد_محلل.قيمة_عد(س); };
            }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تنسيق.مواصفة_غير_صالحة((*الحالة).الموضع)); };
        } وإلا لو ((*الحالة).الموضع < العدد && بداية_اسم((*القالب)[(*الحالة).الموضع])) {
            // A name followed by '$' is a named width; otherwise it is the type.
            دع ك: متغير طبيعي = (*الحالة).الموضع;
            طالما (ك < العدد && (بداية_اسم((*القالب)[ك]) || رقم_عشري_((*القالب)[ك]))) { ك := ك + 1; }
            لو (ك < العدد && (*القالب)[ك] == 0x24) {
                أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_مسمى((*الحالة).الموضع));
            };
        };
        // ['.' precision] := count | '*'
        لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x2E) {
            (*الحالة).الموضع := (*الحالة).الموضع + 1;
            لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x2A) {
                (*الحالة).الموضع := (*الحالة).الموضع + 1;
                الدقة := عد_محلل.التالي_عد();
            } وإلا لو ((*الحالة).الموضع < العدد && رقم_عشري_((*القالب)[(*الحالة).الموضع])) {
                طابق حلل_عددا_صحيحا(القالب, الحالة) مع
                | اختياري.موجود(س) -> {
                    لو ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x24) {
                        (*الحالة).الموضع := (*الحالة).الموضع + 1;
                        الدقة := عد_محلل.وسيط_عد(س);
                    } وإلا { الدقة := عد_محلل.قيمة_عد(س); };
                }
                | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_تنسيق.مواصفة_غير_صالحة((*الحالة).الموضع)); };
            } وإلا {
                // A name followed by '$' is a named precision; anything else
                // after '.' is not a count.
                دع ك: متغير طبيعي = (*الحالة).الموضع;
                طالما (ك < العدد && (بداية_اسم((*القالب)[ك]) || رقم_عشري_((*القالب)[ك]))) { ك := ك + 1; }
                لو (ك > (*الحالة).الموضع && ك < العدد && (*القالب)[ك] == 0x24) {
                    أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_مسمى((*الحالة).الموضع));
                };
                أرجع نتيجة.خطأ(خطأ_تنسيق.مواصفة_غير_صالحة((*الحالة).الموضع));
            };
        };
        // type := '' | '?' | 'x?' | 'X?' | x | X | o | b | e | E
        لو ((*الحالة).الموضع < العدد) {
            دع ب: ط8 = (*القالب)[(*الحالة).الموضع];
            دع بعدها_استفهام: منطقي = (*الحالة).الموضع + 1 < العدد && (*القالب)[(*الحالة).الموضع + 1] == 0x3F;
            لو (ب == 0x3F) { المواصفة.الصيغة := صيغة_تنسيق.تصحيح(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x78 && بعدها_استفهام) { المواصفة.الصيغة := صيغة_تنسيق.تصحيح_ست_عشري(); (*الحالة).الموضع := (*الحالة).الموضع + 2; }
            وإلا لو (ب == 0x58 && بعدها_استفهام) { المواصفة.الصيغة := صيغة_تنسيق.تصحيح_ست_عشري_كبير(); (*الحالة).الموضع := (*الحالة).الموضع + 2; }
            وإلا لو (ب == 0x78) { المواصفة.الصيغة := صيغة_تنسيق.ست_عشري(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x58) { المواصفة.الصيغة := صيغة_تنسيق.ست_عشري_كبير(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x6F) { المواصفة.الصيغة := صيغة_تنسيق.ثماني(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x62) { المواصفة.الصيغة := صيغة_تنسيق.ثنائي(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x65) { المواصفة.الصيغة := صيغة_تنسيق.أسي(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (ب == 0x45) { المواصفة.الصيغة := صيغة_تنسيق.أسي_كبير(); (*الحالة).الموضع := (*الحالة).الموضع + 1; }
            وإلا لو (بداية_اسم(ب)) { أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_معروف((*الحالة).الموضع)); };
            // A type made of more letters (`xx`, `ex`) is unknown too.
            لو ((*الحالة).الموضع < العدد && بداية_اسم((*القالب)[(*الحالة).الموضع])) {
                أرجع نتيجة.خطأ(خطأ_تنسيق.نوع_غير_معروف((*الحالة).الموضع));
            };
        };
    };
    // [ws]* '}'
    طالما ((*الحالة).الموضع < العدد && (*القالب)[(*الحالة).الموضع] == 0x20) {
        (*الحالة).الموضع := (*الحالة).الموضع + 1;
    }
    لو ((*الحالة).الموضع >= العدد) { أرجع نتيجة.خطأ(خطأ_تنسيق.قوس_غير_مغلق(الفتح)); };
    لو ((*القالب)[(*الحالة).الموضع] != 0x7D) {
        أرجع نتيجة.خطأ(خطأ_تنسيق.مواصفة_غير_صالحة((*الحالة).الموضع));
    };
    (*الحالة).الموضع := (*الحالة).الموضع + 1;
    // Resolve the counts: ".*" takes the next argument before the value.
    طابق العرض مع
    | عد_محلل.قيمة_عد(س) -> { المواصفة.له_عرض := صواب; المواصفة.العرض := س; }
    | عد_محلل.وسيط_عد(س) -> {
        المواصفة.له_عرض := صواب;
        المواصفة.العرض := عدد_من_وسيط(الوسائط, س)؟;
        علم_مستخدما(الحالة, س);
    }
    | _ -> { };
    طابق الدقة مع
    | عد_محلل.قيمة_عد(س) -> { المواصفة.له_دقة := صواب; المواصفة.الدقة := س; }
    | عد_محلل.وسيط_عد(س) -> {
        المواصفة.له_دقة := صواب;
        المواصفة.الدقة := عدد_من_وسيط(الوسائط, س)؟;
        علم_مستخدما(الحالة, س);
    }
    | عد_محلل.التالي_عد -> {
        دع س: طبيعي = (*الحالة).التالي;
        (*الحالة).التالي := س + 1;
        المواصفة.له_دقة := صواب;
        المواصفة.الدقة := عدد_من_وسيط(الوسائط, س)؟;
        علم_مستخدما(الحالة, س);
    }
    | _ -> { };
    لو (!له_فهرس) {
        الفهرس := (*الحالة).التالي;
        (*الحالة).التالي := الفهرس + 1;
    };
    لو (الفهرس >= (الطول(*الوسائط) مثل طبيعي)) { أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_مفقود(الفهرس)); };
    علم_مستخدما(الحالة, الفهرس);
    (*المنسق).المواصفة := المواصفة;
    أرجع اكتب_قيمة(المنسق, &(*الوسائط)[الفهرس], الفهرس);
}

// The whole format string, appended to the formatter. On an error the
// formatter is left as it was.
عرف نسق_داخليا(المنسق: &متغير منسق, القالب: &نص, الوسائط: &متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    دع البداية: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    دع المحفوظة: مواصفة_تنسيق = (*المنسق).المواصفة;
    دع الناتج: نتيجة طبيعي, خطأ_تنسيق = نسق_بلا_استعادة(المنسق, القالب, الوسائط);
    (*المنسق).المواصفة := المحفوظة;
    طابق الناتج مع
    | نتيجة.خطأ(الخطأ) -> {
        اقتطع((*المنسق).الناتج, البداية);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(_) -> {
        أرجع نتيجة.نجح((الطول((*المنسق).الناتج) مثل طبيعي) - البداية);
    };
}

عرف نسق_بلا_استعادة(المنسق: &متغير منسق, القالب: &نص, الوسائط: &متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    دع العدد: طبيعي = الطول(*القالب) مثل طبيعي;
    دع عدد_الوسائط: طبيعي = الطول(*الوسائط) مثل طبيعي;
    دع الزائدة: متجه منطقي = [];
    دع الحالة: متغير حالة_تحليل = { الموضع: 0, التالي: 0, المستخدمة: 0, المستخدمة_الزائدة: الزائدة };
    // One reservation for the literal text and a few bytes per argument.
    دع الحالي: طبيعي = الطول((*المنسق).الناتج) مثل طبيعي;
    دع المطلوب: طبيعي = الحالي + العدد + 8 * عدد_الوسائط;
    لو ((سعة((*المنسق).الناتج) مثل طبيعي) < المطلوب) {
        دع المضاعف: متغير طبيعي = (سعة((*المنسق).الناتج) مثل طبيعي) * 2;
        لو (المضاعف < المطلوب) { المضاعف := المطلوب; };
        احجز_سعة((*المنسق).الناتج, المضاعف - الحالي);
    };
    طالما (الحالة.الموضع < العدد) {
        دع ب: ط8 = (*القالب)[الحالة.الموضع];
        لو (ب == 0x7B) {
            لو (الحالة.الموضع + 1 < العدد && (*القالب)[الحالة.الموضع + 1] == 0x7B) {
                ألحق((*المنسق).الناتج, 0x7B);
                الحالة.الموضع := الحالة.الموضع + 2;
            } وإلا {
                دع الفتح: طبيعي = الحالة.الموضع;
                الحالة.الموضع := الحالة.الموضع + 1;
                نسق_موضعا(المنسق, القالب, الوسائط, &متغير الحالة, الفتح)؟;
            };
        } وإلا لو (ب == 0x7D) {
            لو (الحالة.الموضع + 1 < العدد && (*القالب)[الحالة.الموضع + 1] == 0x7D) {
                ألحق((*المنسق).الناتج, 0x7D);
                الحالة.الموضع := الحالة.الموضع + 2;
            } وإلا {
                أرجع نتيجة.خطأ(خطأ_تنسيق.قوس_إغلاق_منفرد(الحالة.الموضع));
            };
        } وإلا {
            ألحق((*المنسق).الناتج, ب);
            الحالة.الموضع := الحالة.الموضع + 1;
        };
    }
    // Every argument must be used, as Rust requires.
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الوسائط) {
        لو (!مستخدم(&الحالة, ف)) { أرجع نتيجة.خطأ(خطأ_تنسيق.وسيط_غير_مستخدم(ف)); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

// ---- Compile-time check ------------------------------------------------------

// The packed result of تحقق_قالب_تنسيق_وقت_الترجمة: 0 for no error, else
// (variant + 1) << 48 | (placeholder offset + 1) << 24 | payload. Without
// known arguments only the format string's own syntax is reported.
عرف رمز_خطأ_تحقق(الخطأ: &خطأ_تنسيق, الفتح: طبيعي, معروفة: منطقي): ط64 {
    دع الصنف: متغير ط64 = 0;
    دع الحمولة: متغير طبيعي = 0;
    طابق *الخطأ مع
    | خطأ_تنسيق.قوس_غير_مغلق(س) -> { الصنف := 1; الحمولة := س; }
    | خطأ_تنسيق.قوس_إغلاق_منفرد(س) -> { الصنف := 2; الحمولة := س; }
    | خطأ_تنسيق.مواصفة_غير_صالحة(س) -> { الصنف := 3; الحمولة := س; }
    | خطأ_تنسيق.نوع_غير_معروف(س) -> { الصنف := 4; الحمولة := س; }
    | خطأ_تنسيق.وسيط_مسمى(س) -> { الصنف := 5; الحمولة := س; }
    | خطأ_تنسيق.وسيط_مفقود(س) -> { الصنف := 6; الحمولة := س; }
    | خطأ_تنسيق.وسيط_غير_مستخدم(س) -> { الصنف := 7; الحمولة := س; }
    | خطأ_تنسيق.نوع_غير_مناسب(س) -> { الصنف := 8; الحمولة := س; }
    | خطأ_تنسيق.عدد_غير_صالح(س) -> { الصنف := 9; الحمولة := س; }
    | _ -> { أرجع 0; };
    لو (!معروفة && الصنف >= 6) { أرجع 0; };
    لو (الحمولة > 0xFFFFFF) { الحمولة := 0xFFFFFF; };
    دع الموضع: متغير ط64 = الفتح مثل ط64;
    لو (الموضع > 0xFFFFFF) { الموضع := 0; };
    أرجع (الصنف << 48) | (الموضع << 24) | (الحمولة مثل ط64);
}

// The compiler's format check (docs/FMT.md, "Compile-time check"). For a call
// whose format string is a literal, the compiler evaluates this function at
// compile time with the literal and, per argument, one byte: `A` plus the
// constructor index of its قيمة_تنسيق, or `?` when the call site does not
// show the constructor (text constants are what every backend can hold);
// معروفة is false
// when the arguments are not a vector literal. The string is formatted into a
// scratch formatter with stand-in arguments of those kinds, through the same
// parser as at run time, so the check reports exactly the errors the run-time
// formatting would. The result is packed by رمز_خطأ_تحقق. المصدر, البداية
// and النهاية locate the literal for the compiler's diagnostic; they are not
// read here.
عام عرف تحقق_قالب_تنسيق_وقت_الترجمة(
    القالب: نص,
    الأنواع: نص,
    معروفة: منطقي,
    المصدر: طبيعي,
    البداية: طبيعي,
    النهاية: طبيعي
): ط64 {
    دع فارغ_نص: نص = «»;
    دع فارغ_بايتات: متجه ط8 = [];
    دع فارغ_أعداد: متجه عدد = [];
    دع فارغ_نصوص: متجه نص = [];
    دع فارغ_قيم: متجه قيمة_تنسيق = [];
    دع العدد: طبيعي = الطول(القالب) مثل طبيعي;
    دع الوسائط: متغير متجه قيمة_تنسيق = [];
    دع ف: متغير طبيعي = 0;
    لو (معروفة) {
        طالما (ف < (الطول(الأنواع) مثل طبيعي)) {
            دع البايت: ط8 = الأنواع[ف];
            دع ك: متغير ط8 = 255;
            لو (البايت >= 0x41) { ك := البايت - 0x41; };
            لو (ك == 1) { ألحق(الوسائط, قيمة_تنسيق.طبيعي(0)); }
            وإلا لو (ك == 2) { ألحق(الوسائط, قيمة_تنسيق.ص8(0)); }
            وإلا لو (ك == 3) { ألحق(الوسائط, قيمة_تنسيق.ص16(0)); }
            وإلا لو (ك == 4) { ألحق(الوسائط, قيمة_تنسيق.ص32(0)); }
            وإلا لو (ك == 5) { ألحق(الوسائط, قيمة_تنسيق.ص64(0)); }
            وإلا لو (ك == 6) { ألحق(الوسائط, قيمة_تنسيق.ط8(0)); }
            وإلا لو (ك == 7) { ألحق(الوسائط, قيمة_تنسيق.ط16(0)); }
            وإلا لو (ك == 8) { ألحق(الوسائط, قيمة_تنسيق.ط32(0)); }
            وإلا لو (ك == 9) { ألحق(الوسائط, قيمة_تنسيق.ط64(0)); }
            وإلا لو (ك == 10) { ألحق(الوسائط, قيمة_تنسيق.ع32(0.0)); }
            وإلا لو (ك == 11) { ألحق(الوسائط, قيمة_تنسيق.ع64(0.0)); }
            وإلا لو (ك == 12) { ألحق(الوسائط, قيمة_تنسيق.منطقي(خطأ)); }
            وإلا لو (ك == 13) { ألحق(الوسائط, قيمة_تنسيق.حرف('a')); }
            وإلا لو (ك == 14) { ألحق(الوسائط, قيمة_تنسيق.نص(&فارغ_نص)); }
            وإلا لو (ك == 15) { ألحق(الوسائط, قيمة_تنسيق.بايتات(&فارغ_بايتات)); }
            وإلا لو (ك == 16) { ألحق(الوسائط, قيمة_تنسيق.أعداد(&فارغ_أعداد)); }
            وإلا لو (ك == 17) { ألحق(الوسائط, قيمة_تنسيق.نصوص(&فارغ_نصوص)); }
            وإلا لو (ك == 18) { ألحق(الوسائط, قيمة_تنسيق.قائمة(&فارغ_قيم)); }
            وإلا لو (ك == 19) {
                ألحق(الوسائط, قيمة_تنسيق.مخصص(دالة(م: &متغير منسق): نتيجة طبيعي, خطأ_تنسيق -> نتيجة.نجح(0)));
            }
            // An integer accepts every format type and counts as a width:
            // an argument whose kind the call site does not show is not
            // type-checked.
            وإلا { ألحق(الوسائط, قيمة_تنسيق.عدد(0)); };
            ف := ف + 1;
        }
    } وإلا {
        // Unknown arguments: enough integers for every implicit position.
        طالما (ف <= العدد) {
            ألحق(الوسائط, قيمة_تنسيق.عدد(0));
            ف := ف + 1;
        }
    };
    دع المنسق: متغير منسق = أنشئ_منسقا();
    دع الزائدة: متجه منطقي = [];
    دع الحالة: متغير حالة_تحليل = { الموضع: 0, التالي: 0, المستخدمة: 0, المستخدمة_الزائدة: الزائدة };
    طالما (الحالة.الموضع < العدد) {
        دع ب: ط8 = القالب[الحالة.الموضع];
        لو (ب == 0x7B) {
            لو (الحالة.الموضع + 1 < العدد && القالب[الحالة.الموضع + 1] == 0x7B) {
                الحالة.الموضع := الحالة.الموضع + 2;
            } وإلا {
                دع الفتح: طبيعي = الحالة.الموضع;
                الحالة.الموضع := الحالة.الموضع + 1;
                طابق نسق_موضعا(&متغير المنسق, &القالب, &الوسائط, &متغير الحالة, الفتح) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع رمز_خطأ_تحقق(&الخطأ, الفتح + 1, معروفة); }
                | نتيجة.نجح(_) -> { };
            };
        } وإلا لو (ب == 0x7D) {
            لو (الحالة.الموضع + 1 < العدد && القالب[الحالة.الموضع + 1] == 0x7D) {
                الحالة.الموضع := الحالة.الموضع + 2;
            } وإلا {
                دع المنفرد: خطأ_تنسيق = خطأ_تنسيق.قوس_إغلاق_منفرد(الحالة.الموضع);
                أرجع رمز_خطأ_تحقق(&المنفرد, الحالة.الموضع + 1, معروفة);
            };
        } وإلا {
            الحالة.الموضع := الحالة.الموضع + 1;
        };
    }
    لو (معروفة) {
        ف := 0;
        طالما (ف < (الطول(الوسائط) مثل طبيعي)) {
            لو (!مستخدم(&الحالة, ف)) {
                دع غير_المستخدم: خطأ_تنسيق = خطأ_تنسيق.وسيط_غير_مستخدم(ف);
                أرجع رمز_خطأ_تحقق(&غير_المستخدم, 0, معروفة);
            };
            ف := ف + 1;
        }
    };
    أرجع 0;
}

// ---- Public formatting API ---------------------------------------------------

// The formatted text (Rust's format!, Go's fmt.Sprintf).
عام عرف نسق(القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة نص, خطأ_تنسيق {
    دع المنسق: متغير منسق = أنشئ_منسقا();
    نسق_داخليا(&متغير المنسق, &القالب, &الوسائط)؟;
    أرجع نتيجة.نجح(خذ_نص_المنسق(&متغير المنسق));
}

// Appends to a formatter and returns the bytes written (Rust's write! to a
// String or, inside a custom formatter, to the Formatter it was given).
عام عرف نسق_في(المنسق: &متغير منسق, القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع نسق_داخليا(المنسق, &القالب, &الوسائط);
}

// Formats into a reused formatter (cleared first) and writes the bytes to a
// std.io writer in full (Rust's write! on an io::Write, Go's fmt.Fprintf).
عام عرف اكتب_منسقا_بمنسق<ح>(
    المنسق: &متغير منسق,
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    القالب: نص,
    الوسائط: متجه قيمة_تنسيق
): نتيجة طبيعي, خطأ_تنسيق {
    امسح_المنسق(المنسق);
    نسق_داخليا(المنسق, &القالب, &الوسائط)؟;
    طابق اكتب_الكل(الوجهة, الكتابة, &(*المنسق).الناتج) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تنسيق.فشل_الكتابة(الرمز)); }
    | نتيجة.نجح(المكتوب) -> { أرجع نتيجة.نجح(المكتوب); };
}

عام عرف اكتب_منسقا<ح>(
    الوجهة: &ح,
    الكتابة: كاتب<ح>,
    القالب: نص,
    الوسائط: متجه قيمة_تنسيق
): نتيجة طبيعي, خطأ_تنسيق {
    دع المنسق: متغير منسق = أنشئ_منسقا();
    أرجع اكتب_منسقا_بمنسق(&متغير المنسق, الوجهة, الكتابة, القالب, الوسائط);
}

// Standard output and error: one write of the whole formatted text.
عرف اطبع_إلى(القالب: نص, الوسائط: متجه قيمة_تنسيق, سطر: منطقي, الخطأ_القياسي: منطقي): نتيجة طبيعي, خطأ_تنسيق {
    دع المنسق: متغير منسق = أنشئ_منسقا();
    نسق_داخليا(&متغير المنسق, &القالب, &الوسائط)؟;
    لو (سطر) { ألحق(المنسق.الناتج, 0x0A); };
    دع المكتوب: نتيجة عدد, عدد = اكتب_بايتات_خرج_أو_خطأ(&المنسق.الناتج, الخطأ_القياسي);
    طابق المكتوب مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(خطأ_تنسيق.فشل_الكتابة(الرمز)); }
    | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل طبيعي); };
}

عرف اكتب_بايتات_خرج_أو_خطأ(البايتات: &متجه ط8, الخطأ_القياسي: منطقي): نتيجة عدد, عدد {
    لو (الخطأ_القياسي) { أرجع اكتب_بايتات_خطأ(البايتات); };
    أرجع اكتب_بايتات_خرج(البايتات);
}

// Rust's print!, println!, eprint!, eprintln! (Go's Printf and Fprintf to
// os.Stderr); the line forms add "\n".
عام عرف اطبع_منسقا(القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع اطبع_إلى(القالب, الوسائط, خطأ, خطأ);
}

عام عرف اطبع_سطرا_منسقا(القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع اطبع_إلى(القالب, الوسائط, صواب, خطأ);
}

عام عرف اطبع_خطأ_منسقا(القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع اطبع_إلى(القالب, الوسائط, خطأ, صواب);
}

عام عرف اطبع_سطر_خطأ_منسقا(القالب: نص, الوسائط: متجه قيمة_تنسيق): نتيجة طبيعي, خطأ_تنسيق {
    أرجع اطبع_إلى(القالب, الوسائط, صواب, صواب);
}

// ---- English names -------------------------------------------------------------
// print/println would clash with std.io's print/println when a program
// imports both, so the printing aliases carry _fmt like write_fmt.

عام مرادف fmt_arg = قيمة_تنسيق;
عام مرادف fmt_arg.int = قيمة_تنسيق.عدد;
عام مرادف fmt_arg.uint = قيمة_تنسيق.طبيعي;
عام مرادف fmt_arg.i8 = قيمة_تنسيق.ص8;
عام مرادف fmt_arg.i16 = قيمة_تنسيق.ص16;
عام مرادف fmt_arg.i32 = قيمة_تنسيق.ص32;
عام مرادف fmt_arg.i64 = قيمة_تنسيق.ص64;
عام مرادف fmt_arg.u8 = قيمة_تنسيق.ط8;
عام مرادف fmt_arg.u16 = قيمة_تنسيق.ط16;
عام مرادف fmt_arg.u32 = قيمة_تنسيق.ط32;
عام مرادف fmt_arg.u64 = قيمة_تنسيق.ط64;
عام مرادف fmt_arg.f32 = قيمة_تنسيق.ع32;
