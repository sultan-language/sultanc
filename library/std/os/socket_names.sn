استورد os.error;
استورد os.socket;

// Socket names (getsockname, getpeername) and datagrams to and from a given
// address, one guarded branch per OS. A sockaddr is decoded into its family
// (4 or 6), port and address bytes here, so std.net never reads a platform
// layout. Encoding is std.os.socket's رمز_عنوان_مقبس_النظام.

// The family is 4 or 6 and the port a 16-bit TCP/UDP port (host order).
عام نوع عنوان_مقبس_نظام_مفكوك = { العنوان: متجه ط8, المنفذ: ط16, العائلة: ط8 };
عام نوع حزمة_مقبس_نظام = { المقروء: عدد, المرسل: عنوان_مقبس_نظام_مفكوك };
// A datagram whose sender is left as the platform's sockaddr bytes, for
// families decoded elsewhere (a Unix domain address: std.os.unix_socket).
عام نوع حزمة_مقبس_خام_نظام = { المقروء: عدد, العنوان: متجه ط8 };

// The port and address of a sockaddr_in (address at 4) or sockaddr_in6
// (address at 8): the same offsets on every supported OS. The port is in
// network order.
عرف فك_عنوان_مقبس_بعائلة(البايتات: &متجه ط8, العائلة: عدد): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع البداية: متغير طبيعي = 4;
    دع الطول: متغير طبيعي = 4;
    إذا (العائلة == 6) { البداية := 8; الطول := 16; };
    إذا (العائلة != 4 && العائلة != 6) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
    إذا (العدد < البداية + الطول) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
    دع العنوان: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول) { ألحق(العنوان, (*البايتات)[البداية + ف]); ف := ف + 1; }
    دع المنفذ: ط16 = (((*البايتات)[2] مثل ط16) << 8) | ((*البايتات)[3] مثل ط16);
    // العائلة is 4 or 6 here (checked above).
    دع الناتج: عنوان_مقبس_نظام_مفكوك = { العنوان: العنوان, المنفذ: المنفذ, العائلة: العائلة مثل ط8 };
    أرجع نتيجة.نجح(الناتج);
}

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.socket_names;
    استورد os.platform.unix.linux.sockets;
    استورد os.platform.unix.linux.file_descriptors;
    إذا (الهدف.المنصة == «linux» || الهدف.المنصة == «android») { استورد os.platform.unix.linux.uapi; }
    إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

    عرف خطأ_اسم_مقبس_للنظام(الخطأ: خطأ_مقبس_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_لينكس.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبس_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبس_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف واصف_اسم_مقبس(المقبس: &مقبس_نظام): واصف_ملف_لينكس {
        دع الناتج: واصف_ملف_لينكس = { القيمة: واصف_لينكس_من_عدد((*المقبس).القيمة), مفتوح: (*المقبس).مفتوح };
        أرجع الناتج;
    }
    // sa_family: a host-order u16 at 0 on Linux; a u8 at 1, after sa_len,
    // on FreeBSD (عنوان_مقبس_بطول_لينكس).
    عرف فك_عنوان_مقبس_نظام(البايتات: &متجه ط8): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        إذا ((الطول(*البايتات) مثل طبيعي) < 4) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
        دع الأصلية: متغير ط64 = (*البايتات)[1] مثل ط64;
        إذا (!عنوان_مقبس_بطول_لينكس()) {
            إذا (ترتيب_بايت_كبير_لينكس()) {
                الأصلية := (((*البايتات)[0] مثل ط64) << 8) | ((*البايتات)[1] مثل ط64);
            } وإلا {
                الأصلية := ((*البايتات)[0] مثل ط64) | (((*البايتات)[1] مثل ط64) << 8);
            };
        };
        دع العائلة: متغير عدد = 0;
        إذا (الأصلية == 2) { العائلة := 4; };
        إذا (الأصلية == عائلة_آيبي6_لينكس()) { العائلة := 6; };
        أرجع فك_عنوان_مقبس_بعائلة(البايتات, العائلة);
    }
    عرف اقرأ_اسم_مقبس_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_اسم_مقبس(المقبس);
        طابق اقرأ_اسم_مقبس_لينكس(&الواصف, محلي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع فك_عنوان_مقبس_نظام(&البايتات); };
    }
    عام عرف اقرأ_اسم_مقبس_خام_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة متجه ط8, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_اسم_مقبس(المقبس);
        طابق اقرأ_اسم_مقبس_لينكس(&الواصف, محلي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات); };
    }
    عام عرف استقبل_من_مقبس_خام_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_خام_نظام, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_اسم_مقبس(المقبس);
        طابق استقبل_من_عنوان_لينكس(&الواصف, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح({ المقروء: المقروء, العنوان: العنوان }) -> {
            دع الناتج: حزمة_مقبس_خام_نظام = { المقروء: المقروء مثل عدد, العنوان: العنوان };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    عام عرف أرسل_إلى_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد, العنوان: &متجه ط8
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_اسم_مقبس(المقبس);
        طابق أرسل_إلى_عنوان_لينكس(&الواصف, المحتوى, الإزاحة, العدد, العنوان) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(المرسل) -> { أرجع نتيجة.نجح(المرسل مثل عدد); };
    }
    عام عرف استقبل_من_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_نظام, خطأ_حد_نظام {
        دع الواصف: واصف_ملف_لينكس = واصف_اسم_مقبس(المقبس);
        طابق استقبل_من_عنوان_لينكس(&الواصف, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_للنظام(الخطأ)); }
        | نتيجة.نجح(الحزمة) -> {
            طابق فك_عنوان_مقبس_نظام(&الحزمة.العنوان) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المرسل) -> {
                دع الناتج: حزمة_مقبس_نظام = { المقروء: الحزمة.المقروء مثل عدد, المرسل: المرسل };
                أرجع نتيجة.نجح(الناتج);
            };
        };
    }
}

إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.socket_names;
    استورد os.platform.unix.apple.darwin.sockets;

    عرف خطأ_اسم_مقبس_داروين_للنظام(الخطأ: خطأ_مقبس_داروين): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_داروين.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_مقبس_داروين.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }
    عرف مقبس_داروين_للاسم(المقبس: &مقبس_نظام): مقبس_داروين {
        دع الناتج: مقبس_داروين = { القيمة: (*المقبس).القيمة مثل ص32, مفتوح: (*المقبس).مفتوح };
        أرجع الناتج;
    }
    // BSD sockaddr: sa_len (u8) at 0, sa_family (u8) at 1; AF_INET6 is 30.
    عرف فك_عنوان_مقبس_نظام(البايتات: &متجه ط8): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        إذا ((الطول(*البايتات) مثل طبيعي) < 4) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
        دع العائلة: متغير عدد = 0;
        إذا ((*البايتات)[1] == 2) { العائلة := 4; };
        إذا ((*البايتات)[1] == 30) { العائلة := 6; };
        أرجع فك_عنوان_مقبس_بعائلة(البايتات, العائلة);
    }
    عرف اقرأ_اسم_مقبس_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        دع الأصلي: مقبس_داروين = مقبس_داروين_للاسم(المقبس);
        طابق اقرأ_اسم_مقبس_داروين(&الأصلي, محلي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع فك_عنوان_مقبس_نظام(&البايتات); };
    }
    عام عرف اقرأ_اسم_مقبس_خام_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة متجه ط8, خطأ_حد_نظام {
        دع الأصلي: مقبس_داروين = مقبس_داروين_للاسم(المقبس);
        طابق اقرأ_اسم_مقبس_داروين(&الأصلي, محلي) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات); };
    }
    عام عرف استقبل_من_مقبس_خام_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_خام_نظام, خطأ_حد_نظام {
        دع الأصلي: مقبس_داروين = مقبس_داروين_للاسم(المقبس);
        طابق استقبل_من_عنوان_داروين(&الأصلي, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح({ المقروء: المقروء, العنوان: العنوان }) -> {
            دع الناتج: حزمة_مقبس_خام_نظام = { المقروء: المقروء, العنوان: العنوان };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    عام عرف أرسل_إلى_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد, العنوان: &متجه ط8
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_داروين = مقبس_داروين_للاسم(المقبس);
        طابق أرسل_إلى_عنوان_داروين(&الأصلي, المحتوى, الإزاحة, العدد, العنوان) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(المرسل) -> { أرجع نتيجة.نجح(المرسل); };
    }
    عام عرف استقبل_من_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_نظام, خطأ_حد_نظام {
        دع الأصلي: مقبس_داروين = مقبس_داروين_للاسم(المقبس);
        طابق استقبل_من_عنوان_داروين(&الأصلي, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(الحزمة) -> {
            طابق فك_عنوان_مقبس_نظام(&الحزمة.العنوان) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المرسل) -> {
                دع الناتج: حزمة_مقبس_نظام = { المقروء: الحزمة.المقروء, المرسل: المرسل };
                أرجع نتيجة.نجح(الناتج);
            };
        };
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.winsock.sockets;

    عرف خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ: خطأ_مقبس_وينسوك): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبس_وينسوك.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_مقبس_وينسوك.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | _ -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); };
    }
    عرف مقبس_وينسوك_للاسم(المقبس: &مقبس_نظام): مقبس_وينسوك {
        دع الناتج: مقبس_وينسوك = { القيمة: (*المقبس).القيمة مثل ط64, مفتوح: (*المقبس).مفتوح };
        أرجع الناتج;
    }
    // Winsock sockaddr: ADDRESS_FAMILY (u16, little-endian) at 0;
    // AF_INET6 is 23.
    عرف فك_عنوان_مقبس_نظام(البايتات: &متجه ط8): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        إذا ((الطول(*البايتات) مثل طبيعي) < 4) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
        دع الأصلية: عدد = ((*البايتات)[0] مثل عدد) | (((*البايتات)[1] مثل عدد) << 8);
        دع العائلة: متغير عدد = 0;
        إذا (الأصلية == 2) { العائلة := 4; };
        إذا (الأصلية == 23) { العائلة := 6; };
        أرجع فك_عنوان_مقبس_بعائلة(البايتات, العائلة);
    }
    عرف اقرأ_اسم_مقبس_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_للاسم(المقبس);
        دع النتيجة: متغير نتيجة متجه ط8, خطأ_مقبس_وينسوك = نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق());
        إذا (محلي) { النتيجة := اقرأ_عنوان_محلي_مقبس_وينسوك(&الأصلي); }
        وإلا { النتيجة := اقرأ_عنوان_نظير_مقبس_وينسوك(&الأصلي); };
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع فك_عنوان_مقبس_نظام(&البايتات); };
    }
    عام عرف اقرأ_اسم_مقبس_خام_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة متجه ط8, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_للاسم(المقبس);
        دع النتيجة: متغير نتيجة متجه ط8, خطأ_مقبس_وينسوك = نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق());
        إذا (محلي) { النتيجة := اقرأ_عنوان_محلي_مقبس_وينسوك(&الأصلي); }
        وإلا { النتيجة := اقرأ_عنوان_نظير_مقبس_وينسوك(&الأصلي); };
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(البايتات) -> { أرجع نتيجة.نجح(البايتات); };
    }
    عام عرف استقبل_من_مقبس_خام_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_خام_نظام, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_للاسم(المقبس);
        طابق استقبل_من_مقبس_وينسوك(&الأصلي, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح({ المقروء: المقروء, العنوان: العنوان }) -> {
            دع الناتج: حزمة_مقبس_خام_نظام = { المقروء: المقروء, العنوان: العنوان };
            أرجع نتيجة.نجح(الناتج);
        };
    }
    عام عرف أرسل_إلى_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد, العنوان: &متجه ط8
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_للاسم(المقبس);
        طابق أرسل_إلى_مقبس_وينسوك(&الأصلي, العنوان, المحتوى, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(المرسل) -> { أرجع نتيجة.نجح(المرسل); };
    }
    عام عرف استقبل_من_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_نظام, خطأ_حد_نظام {
        دع الأصلي: مقبس_وينسوك = مقبس_وينسوك_للاسم(المقبس);
        طابق استقبل_من_مقبس_وينسوك(&الأصلي, المخزن, الإزاحة, العدد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_اسم_مقبس_وينسوك_للنظام(الخطأ)); }
        | نتيجة.نجح(الحزمة) -> {
            طابق فك_عنوان_مقبس_نظام(&الحزمة.العنوان) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المرسل) -> {
                دع الناتج: حزمة_مقبس_نظام = { المقروء: الحزمة.المقروء, المرسل: المرسل };
                أرجع نتيجة.نجح(الناتج);
            };
        };
    }
}

إذا (الهدف.المنصة == «wasi») {
    // WASI preview 1 sockets are preopened and connected only (ENOTSUP 58).
    عرف غير_مدعوم_مقبس_واسي(): خطأ_حد_نظام {
        أرجع خطأ_حد_نظام.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 58));
    }
    عرف اقرأ_اسم_مقبس_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(غير_مدعوم_مقبس_واسي());
    }
    عام عرف أرسل_إلى_مقبس_نظام(
        المقبس: &مقبس_نظام, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد, العنوان: &متجه ط8
    ): نتيجة عدد, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_مقبس_واسي()); }
    عام عرف استقبل_من_مقبس_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_نظام, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_مقبس_واسي()); }
    عام عرف اقرأ_اسم_مقبس_خام_نظام(المقبس: &مقبس_نظام, محلي: منطقي): نتيجة متجه ط8, خطأ_حد_نظام {
        أرجع نتيجة.خطأ(غير_مدعوم_مقبس_واسي());
    }
    عام عرف استقبل_من_مقبس_خام_نظام(
        المقبس: &مقبس_نظام, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
    ): نتيجة حزمة_مقبس_خام_نظام, خطأ_حد_نظام { أرجع نتيجة.خطأ(غير_مدعوم_مقبس_واسي()); }
}

عام عرف اقرأ_عنوان_محلي_مقبس_نظام(المقبس: &مقبس_نظام): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
    أرجع اقرأ_اسم_مقبس_نظام(المقبس, صواب);
}
عام عرف اقرأ_عنوان_نظير_مقبس_نظام(المقبس: &مقبس_نظام): نتيجة عنوان_مقبس_نظام_مفكوك, خطأ_حد_نظام {
    أرجع اقرأ_اسم_مقبس_نظام(المقبس, خطأ);
}
