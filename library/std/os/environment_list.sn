استورد os.error;

// The whole process environment as "NAME=VALUE" byte strings, one guarded
// branch per OS: the Unix startup vector (no libc environ), the Windows
// environment block, the WASI environ_get table.

لو (الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos») {
    استورد os.platform.unix.process_startup;
    عام عرف اقرأ_بيئة_النظام(): نتيجة متجه متجه ط8, خطأ_حد_نظام {
        طابق اجمع_بيئة_إقلاع_يونكس() مع
        | اختياري.موجود(المداخل) -> { أرجع نتيجة.نجح(المداخل); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.environment_block;
    عام عرف اقرأ_بيئة_النظام(): نتيجة متجه متجه ط8, خطأ_حد_نظام {
        طابق اقرأ_كتلة_بيئة_ويندوز() مع
        | نتيجة.نجح(المداخل) -> { أرجع نتيجة.نجح(المداخل); }
        | نتيجة.خطأ(خطأ_كتلة_بيئة_ويندوز.نظام(الأصلي)) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي)); }
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
    }
}

لو (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.process_startup;
    استورد os.platform.wasi.preview1.file_descriptors;
    عام عرف اقرأ_بيئة_النظام(): نتيجة متجه متجه ط8, خطأ_حد_نظام {
        طابق اقرأ_بيئة_واسي() مع
        | نتيجة.نجح(المداخل) -> { أرجع نتيجة.نجح(المداخل); }
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); };
    }
}
