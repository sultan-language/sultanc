استورد math.integer;
استورد os.error;

// Arithmetic at a virtual-memory API boundary must not overflow SultanC's
// 64-bit unsigned lengths. The platform binding must additionally check
// the selected target's pointer width, page size and protection flags.
عام عرف طول_ذاكرة_محاذى_للصفحة(
    الطول_المطلوب: غير_موقع,
    حجم_الصفحة: غير_موقع
): اختيار غير_موقع {
    لو (حجم_الصفحة == 0) { أرجع اختيار.لا_شيء(); };
    دع الباقي: غير_موقع = الطول_المطلوب % حجم_الصفحة;
    لو (الباقي == 0) { أرجع اختيار.بعض(الطول_المطلوب); };
    أرجع جمع_غير_موقع_متحقق(الطول_المطلوب, حجم_الصفحة - الباقي);
}

// Check a subrange without forming the potentially overflowing end address.
// A zero-length subrange at the region's end is valid for range arithmetic;
// individual OS mapping calls may impose a stricter nonzero requirement.
عام عرف نطاق_ذاكرة_ضمن_منطقة(
    بداية_المنطقة: غير_موقع,
    طول_المنطقة: غير_موقع,
    بداية_النطاق: غير_موقع,
    طول_النطاق: غير_موقع
): منطقي {
    لو (بداية_النطاق < بداية_المنطقة) { أرجع خطأ; };
    دع الإزاحة: غير_موقع = بداية_النطاق - بداية_المنطقة;
    لو (الإزاحة > طول_المنطقة) { أرجع خطأ; };
    أرجع طول_النطاق <= (طول_المنطقة - الإزاحة);
}

// Page alignment is not presumed to be a power of two across every OS API.
عام عرف عنوان_محاذى_للصفحة(العنوان: غير_موقع, حجم_الصفحة: غير_موقع): منطقي {
    لو (حجم_الصفحة == 0) { أرجع خطأ; };
    أرجع (العنوان % حجم_الصفحة) == 0;
}

// The canonical target model supplies the pointer width; this function only
// validates against that supplied value. It must never inspect the host.
عام عرف قيمة_تناسب_عرض_مؤشر_نظام(
    القيمة: غير_موقع,
    عرض_المؤشر: غير_موقع
): منطقي {
    لو (عرض_المؤشر == 0 || عرض_المؤشر > 64) { أرجع خطأ; };
    لو (عرض_المؤشر == 64) { أرجع صواب; };
    أرجع (القيمة >> عرض_المؤشر) == 0;
}

عام مرادف os_value_fits_target_pointer = قيمة_تناسب_عرض_مؤشر_نظام;
عام مرادف os_page_align_size_checked = طول_ذاكرة_محاذى_للصفحة;
عام مرادف os_region_contains_range = نطاق_ذاكرة_ضمن_منطقة;
عام مرادف os_page_aligned_address = عنوان_محاذى_للصفحة;


// Raw mapping addresses are 64-bit words on the supported Linux ABIs;
// no signed-status reinterpretation is performed on successful mmap results.
عام نوع ربط_ذاكرة_نظام = { العنوان: غ64, الطول: غ64, نشط: منطقي };

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.virtual_memory;
    استورد os.platform.unix.linux.auxiliary_vector;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_ذاكرة_لينكس_للنظام(الخطأ: خطأ_ذاكرة_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_ذاكرة_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_ذاكرة_لينكس.منطقة_غير_نشطة -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_ذاكرة_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عرف منطقة_لينكس_من_النظام(المنطقة: &ربط_ذاكرة_نظام): منطقة_ذاكرة_لينكس {
        دع الناتج: منطقة_ذاكرة_لينكس = {
            العنوان: (*المنطقة).العنوان,
            الطول: (*المنطقة).الطول,
            نشطة: (*المنطقة).نشط
        };
        أرجع الناتج;
    }
    عرف نتيجة_ذاكرة_للنظام(
        النتيجة: نتيجة غ64, خطأ_ذاكرة_لينكس
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> {
            لو (العدد > 9223372036854775807) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح(العدد مثل عدد);
        };
    }
    // Optional procfs auxiliary-vector reader. A sandbox without procfs
    // returns the kernel's error; it must not invent a 4096-byte page size.
    عام عرف حجم_صفحة_تشغيل_نظام(): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_حجم_صفحة_من_بروك_لينكس() مع
        | نتيجة.نجح(القيمة) -> {
            لو (القيمة > 9223372036854775807) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            };
            أرجع نتيجة.نجح(القيمة مثل عدد);
        }
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_متجه_مساعد_لينكس.بيانات_غير_صالحة -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            }
            | خطأ_متجه_مساعد_لينكس.مدخل_غير_موجود -> {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
            }
            | خطأ_متجه_مساعد_لينكس.واصف(خطأ_الواصف) -> {
                طابق خطأ_الواصف مع
                | خطأ_واصف_لينكس.نظام(الأصلي) -> {
                    أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(الأصلي));
                }
                | _ -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
            };
        };
    }
    عام عرف اربط_ذاكرة_تشغيل_نظام(
        الطول: عدد, الحماية: عدد
    ): نتيجة ربط_ذاكرة_نظام, خطأ_حد_نظام {
        لو (الطول <= 0 || الحماية < 0 || الحماية > 7) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        // MAP_PRIVATE | MAP_ANONYMOUS, fd=-1, offset=0.
        طابق اربط_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة()),
            الطول مثل غ64, الحماية مثل غ64, 0x22 مثل غ64,
            (-1 مثل ص64), 0 مثل غ64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(المصدر) -> {
            دع الربط: ربط_ذاكرة_نظام = {
                العنوان: المصدر.العنوان, الطول: المصدر.الطول, نشط: صواب
            };
            أرجع نتيجة.نجح(الربط);
        };
    }
    عام عرف الغ_ربط_ذاكرة_تشغيل_نظام(
        المنطقة: &متغير ربط_ذاكرة_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصل: متغير منطقة_ذاكرة_لينكس = منطقة_لينكس_من_النظام(المنطقة);
        دع الحالة: نتيجة غ64, خطأ_ذاكرة_لينكس = ألغ_ربط_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إلغاء_ربط_ذاكرة()),
            &متغير الأصل
        );
        (*المنطقة).نشط := الأصل.نشطة;
        أرجع نتيجة_ذاكرة_للنظام(الحالة);
    }
    عام عرف احم_ذاكرة_تشغيل_نظام(
        المنطقة: &ربط_ذاكرة_نظام, الحماية: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (الحماية < 0 || الحماية > 7) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الأصل: منطقة_ذاكرة_لينكس = منطقة_لينكس_من_النظام(المنطقة);
        أرجع نتيجة_ذاكرة_للنظام(نفذ_توجيه_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حماية_ذاكرة()),
            &الأصل, الحماية مثل غ64
        ));
    }
    عام عرف اقفل_ذاكرة_تشغيل_نظام(
        المنطقة: &ربط_ذاكرة_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصل: منطقة_ذاكرة_لينكس = منطقة_لينكس_من_النظام(المنطقة);
        أرجع نتيجة_ذاكرة_للنظام(نفذ_توجيه_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قفل_ذاكرة()), &الأصل, 0 مثل غ64
        ));
    }
    عام عرف الغ_قفل_ذاكرة_تشغيل_نظام(
        المنطقة: &ربط_ذاكرة_نظام
    ): نتيجة عدد, خطأ_حد_نظام {
        دع الأصل: منطقة_ذاكرة_لينكس = منطقة_لينكس_من_النظام(المنطقة);
        أرجع نتيجة_ذاكرة_للنظام(نفذ_توجيه_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إلغاء_قفل_ذاكرة()), &الأصل, 0 مثل غ64
        ));
    }
    عام عرف انصح_ذاكرة_تشغيل_نظام(
        المنطقة: &ربط_ذاكرة_نظام, النصيحة: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (النصيحة < 0 || النصيحة > 4) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        دع الأصل: منطقة_ذاكرة_لينكس = منطقة_لينكس_من_النظام(المنطقة);
        أرجع نتيجة_ذاكرة_للنظام(نفذ_توجيه_ذاكرة_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نصيحة_ذاكرة()),
            &الأصل, النصيحة مثل غ64
        ));
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.virtual_memory;
    عام عرف حجم_صفحة_تشغيل_نظام(): نتيجة عدد, خطأ_حد_نظام {
        دع المعلومات: معلومات_صفحات_ويندوز = اقرأ_معلومات_صفحات_ويندوز();
        لو (المعلومات.حجم_الصفحة == 0) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
        };
        أرجع نتيجة.نجح(المعلومات.حجم_الصفحة مثل عدد);
    }
    // Windows regions remain pointer-backed, with ownership held by the
    // canonical Win32 provider. The Linux numeric mmap contract is not
    // forced on Windows pointers (nor on 64-bit addresses with the high bit set).
    عرف حماية_ويندوز_من_رمز_نظام(
        الحماية: عدد
    ): نتيجة حماية_صفحات_ويندوز, خطأ_حد_نظام {
        لو (الحماية == 0) { أرجع نتيجة.نجح(حماية_صفحات_ويندوز.ممنوعة()); };
        لو (الحماية == 1) { أرجع نتيجة.نجح(حماية_صفحات_ويندوز.قراءة()); };
        لو (الحماية == 3) { أرجع نتيجة.نجح(حماية_صفحات_ويندوز.قراءة_وكتابة()); };
        لو (الحماية == 5) { أرجع نتيجة.نجح(حماية_صفحات_ويندوز.تنفيذ_وقراءة()); };
        لو (الحماية == 7) {
            أرجع نتيجة.نجح(حماية_صفحات_ويندوز.تنفيذ_وقراءة_وكتابة());
        };
        // Win32 has no exact write-only, execute-only or write+execute
        // page contracts. Do not silently grant additional permissions.
        أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
    }
    عرف خطأ_ذاكرة_ويندوز_للنظام(الخطأ: خطأ_ذاكرة_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_ذاكرة_ويندوز.نطاق_غير_صالح -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_ذاكرة_ويندوز.منطقة_محررة -> {
            أرجع خطأ_حد_نظام.مورد_مغلق();
        }
        | خطأ_ذاكرة_ويندوز.نظام(الأصلي) -> {
            أرجع خطأ_حد_نظام.نظام(الأصلي);
        };
    }
    عام عرف احجز_منطقة_ذاكرة_نظام_ويندوز(
        الطول: غ64, الحماية: عدد
    ): نتيجة منطقة_ذاكرة_ويندوز, خطأ_حد_نظام {
        طابق حماية_ويندوز_من_رمز_نظام(الحماية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الوضع) -> {
            طابق احجز_ذاكرة_ويندوز(الطول, الوضع) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ));
            }
            | نتيجة.نجح(المنطقة) -> { أرجع نتيجة.نجح(المنطقة); };
        };
    }
    عام عرف حرر_منطقة_ذاكرة_نظام_ويندوز(
        المنطقة: &متغير منطقة_ذاكرة_ويندوز
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق حرر_ذاكرة_ويندوز(المنطقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف احم_منطقة_ذاكرة_نظام_ويندوز(
        المنطقة: &منطقة_ذاكرة_ويندوز, الحماية: عدد
    ): نتيجة غ32, خطأ_حد_نظام {
        طابق حماية_ويندوز_من_رمز_نظام(الحماية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الوضع) -> {
            طابق احم_ذاكرة_ويندوز(المنطقة, الوضع) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ));
            }
            | نتيجة.نجح(السابقة) -> { أرجع نتيجة.نجح(السابقة); };
        };
    }
    عام عرف اقفل_منطقة_ذاكرة_نظام_ويندوز(
        المنطقة: &منطقة_ذاكرة_ويندوز
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقفل_ذاكرة_ويندوز(المنطقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف الغ_قفل_منطقة_ذاكرة_نظام_ويندوز(
        المنطقة: &منطقة_ذاكرة_ويندوز
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق افتح_قفل_ذاكرة_ويندوز(المنطقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
    عام عرف استبق_منطقة_ذاكرة_نظام_ويندوز(
        المنطقة: &منطقة_ذاكرة_ويندوز
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق استبق_تحميل_ذاكرة_ويندوز(المنطقة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
    }
}
