استورد os.error;

// Argument vectors belong to process startup, not to a kernel syscall.
// Validate a zero-based index before converting to an unsigned vector offset.
// The Windows provider supplies owned text; Linux requires the compiler's
// source-level external-data access to the process-lifetime argv symbol.
عرف موضع_وسيطة_نظام_صالح(الموضع: عدد, العدد: طبيعي): منطقي {
    إذا (الموضع < 0) { أرجع خطأ; };
    أرجع (الموضع مثل طبيعي) < العدد;
}

إذا (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.process_control;
    استورد text.from_bytes;

    عرف خطأ_وسائط_ويندوز_للنظام(الخطأ: خطأ_عملية_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_عملية_ويندوز.وسيط_غير_صالح -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_عملية_ويندوز.ترميز_غير_صالح -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_عملية_ويندوز.مغلقة -> {
            أرجع خطأ_حد_نظام.مورد_مغلق();
        }
        | خطأ_عملية_ويندوز.حالة_انتظار_غير_متوقعة(_) -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_عملية_ويندوز.نظام(الأصلي) -> {
            أرجع خطأ_حد_نظام.نظام(الأصلي);
        };
    }

    عام عرف عدد_وسائط_النظام(): نتيجة عدد, خطأ_حد_نظام {
        طابق عدد_وسائط_عملية_ويندوز() مع
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_وسائط_ويندوز_للنظام(الخطأ));
        };
    }

    عام عرف وسيطة_النظام(الموضع: عدد): نتيجة نص, خطأ_حد_نظام {
        إذا (الموضع < 0) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        طابق اقرأ_وسائط_عملية_ويندوز() مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_وسائط_ويندوز_للنظام(الخطأ));
        }
        | نتيجة.نجح(الوسائط) -> {
            إذا (!موضع_وسيطة_نظام_صالح(الموضع, الطول(الوسائط) مثل طبيعي)) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            };
            // The argument vector is owned here; return an independent copy.
            دع الوسيطة: نص = انسخ_نص(&الوسائط[الموضع مثل طبيعي]);
            أرجع نتيجة.نجح(الوسيطة);
        };
    }
}


// Linux and Darwin share the Unix process-startup argv contract.
إذا (((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos») {
    استورد os.platform.unix.process_startup;
    استورد text.from_bytes;

    عام عرف عدد_وسائط_النظام(): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_عدد_وسائط_إقلاع_يونكس() مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق()); }
        | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); };
    }

    عام عرف وسيطة_النظام(الموضع: عدد): نتيجة نص, خطأ_حد_نظام {
        إذا (الموضع < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق اقرأ_وسيطة_إقلاع_يونكس(الموضع مثل طبيعي) مع
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); }
        | اختياري.موجود(القيمة) -> { أرجع نتيجة.نجح(من_بايتات(&القيمة)); };
    }
}

// WASI hosts supply arguments through args_sizes_get/args_get.
إذا (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;
    استورد os.platform.wasi.preview1.process_startup;
    استورد text.from_bytes;

    عام عرف عدد_وسائط_النظام(): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_وسائط_واسي() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(الوسائط) -> { أرجع نتيجة.نجح(الطول(الوسائط) مثل عدد); };
    }

    عام عرف وسيطة_النظام(الموضع: عدد): نتيجة نص, خطأ_حد_نظام {
        إذا (الموضع < 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        طابق اقرأ_وسائط_واسي() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(الوسائط) -> {
            إذا (!موضع_وسيطة_نظام_صالح(الموضع, الطول(الوسائط) مثل طبيعي)) {
                أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
            };
            أرجع نتيجة.نجح(من_بايتات(&الوسائط[الموضع مثل طبيعي]));
        };
    }
}
