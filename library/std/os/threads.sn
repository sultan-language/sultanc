استورد os.error;

// OS threads, one guarded branch per OS (docs/CONCURRENCY.md); std.thread
// builds Rust's std::thread surface on it. A started thread runs a
// `() -> ()` closure given by the address of its environment
// (بدائي_عنوان_دالة, taken by std.thread's spawn, which is what makes the
// spawn capture check treat spawn's closure as sent to another thread). The
// thread owns that one reference, which join drops after the thread ended
// (بدائي_دالة_من_عنوان), so a joined thread leaves nothing behind; a handle
// dropped without join leaks the thread's stack and that reference, as a
// detached thread keeps its own. On an error the reference is dropped.
//
// - Linux and Android, every architecture: clone onto a stack std maps,
//   futex join on the tid the kernel clears (os.platform.unix.linux.threads);
//   gettid, sched_yield, sched_getaffinity.
// - FreeBSD: thr_new onto a stack std maps, _umtx_op join on thr_exit's
//   state word (os.platform.unix.freebsd.threads); thr_self, sched_yield,
//   cpuset_getaffinity then sysctl hw.ncpu.
// - macOS: pthread_create / pthread_join (os.platform.unix.apple.darwin.threads);
//   pthread_threadid_np, pthread_yield_np, sysctlbyname hw.logicalcpu.
// - Windows: CreateThread / WaitForSingleObject / GetExitCodeThread /
//   CloseHandle (os.platform.windows.win32.threads); GetCurrentThreadId,
//   SwitchToThread, GetSystemInfo.
// - Every other target (WASI preview 1 has no thread creation): not
//   supported; std.thread reports it.
//
// The handle's words: the thread id, the OS handle (the tid cell, the
// pthread_t or the HANDLE), the stack mapping std made (0 where the OS owns
// the stack) and the environment address to drop at join.
عام نوع خيط_نظام = {
    المعرف: ط64,
    المقبض: ط64,
    قاعدة_المكدس: ط64,
    حجم_المكدس: ط64,
    قمة_المكدس: ط64,
    عنوان_الإغلاق: ط64
};

لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.threads;
    استورد os.allocation;

    مرادف إغلاق_من_عنوان_نظام = بدائي_دالة_من_عنوان;

    عام عرف خيوط_النظام_مدعومة(): منطقي { أرجع صواب; }

    عرف حرر_إغلاق_خيط_نظام(العنوان: ط64): فراغ {
        دع العمل: دالة(): فراغ;
        غير_آمن { العمل := إغلاق_من_عنوان_نظام(العنوان); }
    }

    عام عرف ابدأ_خيط_نظام(العنوان: ط64): نتيجة خيط_نظام, خطأ_نظام_أصلي {
        // Every allocation past the first spawn is locked (os/allocation.sn).
        فعّل_قفل_المخصص();
        دع المكدس: مكدس_خيط_لينكس;
        طابق خصص_مكدس_خيط_لينكس() مع
        | نتيجة.خطأ(الخطأ) -> {
            حرر_إغلاق_خيط_نظام(العنوان);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(م) -> { المكدس := م; };
        طابق ابدأ_خيط_لينكس(&المكدس, العنوان) مع
        | نتيجة.خطأ(الخطأ) -> {
            حرر_مكدس_خيط_لينكس(&المكدس);
            حرر_إغلاق_خيط_نظام(العنوان);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(المعرف) -> {
            دع الخيط: خيط_نظام = {
                المعرف: المعرف مثل ط64, المقبض: خلية_خيط_لينكس(&المكدس),
                قاعدة_المكدس: المكدس.القاعدة, حجم_المكدس: المكدس.الحجم,
                قمة_المكدس: المكدس.القمة, عنوان_الإغلاق: العنوان
            };
            أرجع نتيجة.نجح(الخيط);
        };
    }

    عام عرف انضم_خيط_نظام(الخيط: &خيط_نظام): فراغ {
        انضم_خيط_لينكس((*الخيط).المقبض, (*الخيط).المعرف مثل عدد);
        دع المكدس: مكدس_خيط_لينكس = {
            القاعدة: (*الخيط).قاعدة_المكدس, الحجم: (*الخيط).حجم_المكدس, القمة: (*الخيط).قمة_المكدس
        };
        حرر_مكدس_خيط_لينكس(&المكدس);
        حرر_إغلاق_خيط_نظام((*الخيط).عنوان_الإغلاق);
    }

    عام عرف معرف_الخيط_الحالي_نظام(): ط64 { أرجع معرف_الخيط_الحالي_لينكس(); }
    عام عرف تنازل_نظام(): فراغ { تنازل_لينكس(); }
    عام عرف عدد_المعالجات_نظام(): نتيجة ط64, خطأ_نظام_أصلي { أرجع عدد_المعالجات_لينكس(); }
}

لو (الهدف.المنصة == «freebsd» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «riscv64»)) {
    استورد os.platform.unix.linux.threads;
    استورد os.platform.unix.freebsd.threads;
    استورد os.allocation;

    مرادف إغلاق_من_عنوان_نظام = بدائي_دالة_من_عنوان;

    عام عرف خيوط_النظام_مدعومة(): منطقي { أرجع صواب; }

    عام عرف ابدأ_خيط_نظام(العنوان: ط64): نتيجة خيط_نظام, خطأ_نظام_أصلي {
        // The closure takes over the caller's reference; the OS layer keeps
        // its own for the thread, and this one drops on return.
        دع العمل: دالة(): فراغ;
        غير_آمن { العمل := إغلاق_من_عنوان_نظام(العنوان); }
        فعّل_قفل_المخصص();
        دع المكدس: مكدس_خيط_لينكس;
        طابق خصص_مكدس_خيط_لينكس() مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(م) -> { المكدس := م; };
        طابق ابدأ_خيط_فري_بي_إس_دي(&المكدس, العمل) مع
        | نتيجة.خطأ(الخطأ) -> {
            حرر_مكدس_خيط_لينكس(&المكدس);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(البدء) -> {
            دع الخيط: خيط_نظام = {
                المعرف: البدء.المعرف, المقبض: خلية_خيط_لينكس(&المكدس),
                قاعدة_المكدس: المكدس.القاعدة, حجم_المكدس: المكدس.الحجم,
                قمة_المكدس: المكدس.القمة, عنوان_الإغلاق: البدء.عنوان_الغلاف
            };
            أرجع نتيجة.نجح(الخيط);
        };
    }

    عام عرف انضم_خيط_نظام(الخيط: &خيط_نظام): فراغ {
        انضم_خيط_فري_بي_إس_دي((*الخيط).المقبض);
        دع المكدس: مكدس_خيط_لينكس = {
            القاعدة: (*الخيط).قاعدة_المكدس, الحجم: (*الخيط).حجم_المكدس, القمة: (*الخيط).قمة_المكدس
        };
        حرر_مكدس_خيط_لينكس(&المكدس);
        حرر_غلاف_خيط_فري((*الخيط).عنوان_الإغلاق);
    }

    عام عرف معرف_الخيط_الحالي_نظام(): ط64 { أرجع معرف_الخيط_الحالي_فري_بي_إس_دي(); }
    عام عرف تنازل_نظام(): فراغ { تنازل_لينكس(); }
    عام عرف عدد_المعالجات_نظام(): نتيجة ط64, خطأ_نظام_أصلي { أرجع عدد_المعالجات_فري_بي_إس_دي(); }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.threads;
    استورد os.allocation;

    مرادف إغلاق_من_عنوان_نظام = بدائي_دالة_من_عنوان;

    عام عرف خيوط_النظام_مدعومة(): منطقي { أرجع صواب; }

    عام عرف ابدأ_خيط_نظام(العنوان: ط64): نتيجة خيط_نظام, خطأ_نظام_أصلي {
        // The closure takes over the caller's reference; the OS layer keeps
        // its own for the thread, and this one drops on return.
        دع العمل: دالة(): فراغ;
        غير_آمن { العمل := إغلاق_من_عنوان_نظام(العنوان); }
        فعّل_قفل_المخصص();
        طابق ابدأ_خيط_داروين(العمل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(البدء) -> {
            دع الخيط: خيط_نظام = {
                المعرف: معرف_خيط_داروين(البدء.المقبض), المقبض: البدء.المقبض,
                قاعدة_المكدس: 0, حجم_المكدس: 0, قمة_المكدس: 0,
                عنوان_الإغلاق: البدء.عنوان_الإغلاق
            };
            أرجع نتيجة.نجح(الخيط);
        };
    }

    عام عرف انضم_خيط_نظام(الخيط: &خيط_نظام): فراغ {
        انضم_خيط_داروين((*الخيط).المقبض);
        حرر_إغلاق_خيط_داروين((*الخيط).عنوان_الإغلاق);
    }

    عام عرف معرف_الخيط_الحالي_نظام(): ط64 { أرجع معرف_خيط_داروين(0); }
    عام عرف تنازل_نظام(): فراغ { تنازل_داروين(); }
    عام عرف عدد_المعالجات_نظام(): نتيجة ط64, خطأ_نظام_أصلي { أرجع عدد_المعالجات_داروين(); }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.threads;
    استورد os.allocation;

    مرادف إغلاق_من_عنوان_نظام = بدائي_دالة_من_عنوان;

    عام عرف خيوط_النظام_مدعومة(): منطقي { أرجع صواب; }

    عام عرف ابدأ_خيط_نظام(العنوان: ط64): نتيجة خيط_نظام, خطأ_نظام_أصلي {
        // The closure takes over the caller's reference; the OS layer keeps
        // its own for the thread, and this one drops on return.
        دع العمل: دالة(): فراغ;
        غير_آمن { العمل := إغلاق_من_عنوان_نظام(العنوان); }
        فعّل_قفل_المخصص();
        طابق ابدأ_خيط_ويندوز(العمل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(البدء) -> {
            دع الخيط: خيط_نظام = {
                المعرف: البدء.المعرف, المقبض: البدء.المقبض,
                قاعدة_المكدس: 0, حجم_المكدس: 0, قمة_المكدس: 0,
                عنوان_الإغلاق: البدء.عنوان_الإغلاق
            };
            أرجع نتيجة.نجح(الخيط);
        };
    }

    عام عرف انضم_خيط_نظام(الخيط: &خيط_نظام): فراغ {
        انضم_خيط_ويندوز((*الخيط).المقبض);
        حرر_إغلاق_خيط_ويندوز((*الخيط).عنوان_الإغلاق);
    }

    عام عرف معرف_الخيط_الحالي_نظام(): ط64 { أرجع معرف_الخيط_الحالي_ويندوز(); }
    عام عرف تنازل_نظام(): فراغ { تنازل_ويندوز(); }
    عام عرف عدد_المعالجات_نظام(): نتيجة ط64, خطأ_نظام_أصلي { أرجع عدد_المعالجات_ويندوز(); }
}

// WASI preview 1 (no thread creation; wasi-threads is not used, and a wasm32
// module runs one thread) and every target without an OS thread API.
لو (!((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve»)
    && !(الهدف.المنصة == «freebsd» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «riscv64»))
    && الهدف.المنصة != «macos» && الهدف.المنصة != «windows») {
    عام عرف خيوط_النظام_مدعومة(): منطقي { أرجع خطأ; }

    // ENOTSUP (WASI 58, POSIX 95 / 45): never reached, std.thread asks first.
    عام عرف ابدأ_خيط_نظام(العنوان: ط64): نتيجة خيط_نظام, خطأ_نظام_أصلي {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 58));
    }
    عام عرف انضم_خيط_نظام(الخيط: &خيط_نظام): فراغ { }
    // The one thread's id, as Rust numbers the main thread 1.
    عام عرف معرف_الخيط_الحالي_نظام(): ط64 { أرجع 1; }
    عام عرف تنازل_نظام(): فراغ { }
    عام عرف عدد_المعالجات_نظام(): نتيجة ط64, خطأ_نظام_أصلي {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), 58));
    }
}
