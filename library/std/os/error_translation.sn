استورد نظام_التشغيل.أخطاء;

// File-operation integer errors are the inherited STD boundary. The native
// OS error itself retains its origin in os.error. A negative integer alone
// cannot identify a Winsock error versus a Win32 error: do not apply this
// file-only classifier to socket errors.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد نظام_التشغيل.منصات.يونكس.لينكس.نداءات_النظام.نتيجة_النواة;
    عام عرف صنف_خطأ_ملفات_النظام(الحالة: عدد): صنف_خطأ_نظام {
        إذا (الحالة >= 0) { أرجع صنف_خطأ_نظام.غير_معروف(); };
        أرجع صنف_خطأ_نواة_لينكس_أساسيا(0 - الحالة);
    }
}

// FreeBSD errno values (EAGAIN 35, ...) are classified by their own table.
إذا (الهدف.المنصة == «freebsd») {
    استورد نظام_التشغيل.منصات.يونكس.فري_بي_إس_دي.واجهة_النواة;
    عام عرف صنف_خطأ_ملفات_النظام(الحالة: عدد): صنف_خطأ_نظام {
        إذا (الحالة >= 0) { أرجع صنف_خطأ_نظام.غير_معروف(); };
        أرجع صنف_خطأ_نواة_فري_بي_إس_دي_أساسيا(0 - الحالة);
    }
}

إذا (الهدف.المنصة == «windows») {
    استورد نظام_التشغيل.منصات.ويندوز.وين32.ترجمة_الأخطاء;
    عام عرف صنف_خطأ_ملفات_النظام(الحالة: عدد): صنف_خطأ_نظام {
        إذا (الحالة >= 0 || الحالة < -4294967295) {
            أرجع صنف_خطأ_نظام.غير_معروف();
        };
        أرجع صنف_خطأ_وين32((0 - الحالة) مثل ط32);
    }
}

إذا (الهدف.المنصة == «macos») {
    استورد نظام_التشغيل.منصات.يونكس.آبل.داروين.ترجمة_الأخطاء;
    عام عرف صنف_خطأ_ملفات_النظام(الحالة: عدد): صنف_خطأ_نظام {
        إذا (الحالة >= 0) { أرجع صنف_خطأ_نظام.غير_معروف(); };
        أرجع صنف_خطأ_داروين_أساسيا(0 - الحالة);
    }
}

إذا (الهدف.المنصة == «wasi») {
    استورد نظام_التشغيل.منصات.واسي.معاينة1.ترجمة_الأخطاء;
    عام عرف صنف_خطأ_ملفات_النظام(الحالة: عدد): صنف_خطأ_نظام {
        إذا (الحالة >= 0) { أرجع صنف_خطأ_نظام.غير_معروف(); };
        أرجع صنف_خطأ_واسي_أساسيا(0 - الحالة);
    }
}
