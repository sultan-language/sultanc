// Compiler storage services: allocate, reallocate, free.
//
// These are the compiler's three storage services (see
// compiler/runtime/service_identity.sn) on every target where std has a page
// source. No C allocator is used anywhere: MSIR lowering binds the public
// functions below by their canonical names as the program's allocation
// providers (compiler/runtime/primitive_runtime_abi.sn), every backend calls
// them directly, and the driver loads this module for each compilation that
// generates code for such a target (runtime_symbol_query_context.sn,
// مزود_خدمات_ذاكرة_للهدف, owns the target list; it must match the guards here).
//
// Page sources:
//   wasm32          the module's linear memory (memory.grow), u32 addresses;
//   Linux x86_64/aarch64  one reserved address range from raw mmap, committed
//                   by mprotect (os.platform.unix.linux.virtual_memory);
//   macOS           the same through libSystem's mmap/mprotect, the supported
//                   Darwin kernel interface (os.platform.unix.apple.darwin).
// 0 is a failed allocation, which the generated code turns into a trap.
//
// Layout (word W = 4 bytes on wasm32, 8 on 64-bit native targets). The state
// block starts the heap (wasm32: the first 16-byte boundary at or after
// __heap_base; native: the start of the reserved range): [+0] state tag,
// [+W] first unused address, [+16 + W c] free-list head of class c. Every
// block starts 16-byte aligned with an 8-byte header (class u32 at payload-8,
// allocated/free tag u32 at payload-4), so payloads are 8-byte aligned. Small
// classes c = 1..256 are 16c-byte blocks; large classes
// c = 257 + 4(k - 12) + q (q = 0..3) hold 2^k (4 + q) / 4-byte payloads in
// blocks 16 bytes larger, so rounding wastes at most a quarter of a large
// request. Freed blocks are pushed on their class list (the link is the first
// payload word). The block that ends at the first unused address grows in
// place when reallocated, so the most recent growing vector needs no copy.
// The heap only grows. One allocator instance per program image; not
// thread-safe (SultanC programs are single-threaded).
//
// Nothing here may allocate: only integer arithmetic, the memory primitives
// and the page-source calls are used.

// Native heap position: start of the reserved range (0 until first use), its
// end, and the committed prefix end. Unused on wasm32 (linear memory itself
// records the heap there).
دع قاعدة_كومة_الآلة: متغير غ64 = 0;
دع نهاية_حجز_كومة_الآلة: متغير غ64 = 0;
دع نهاية_تثبيت_كومة_الآلة: متغير غ64 = 0;

لو (الهدف.المعمارية == «wasm32») {
    // Compiler intrinsics bind only through private aliases.
    مرادف انم_الذاكرة_الخطية = بدائي_نمو_الذاكرة_الخطية;
    مرادف اقرأ_الذاكرة_الخطية = بدائي_اقرأ_الذاكرة_الخطية;
    مرادف اكتب_الذاكرة_الخطية = بدائي_اكتب_الذاكرة_الخطية;
    مرادف انسخ_الذاكرة_الخطية = بدائي_انسخ_الذاكرة_الخطية;
    مرادف قاعدة_الكومة_الخطية = بدائي_قاعدة_الكومة_الخطية;

    عرف كلمة_المخصص(): غ64 { أرجع 4; }
    // The next-free address is a u32 word; the heap stays below 2^32.
    عرف أعلى_فئة_مخصص(): غ64 { أرجع 31; }

    عرف اقرأ_كلمة_مخصص(العنوان: غ64): غ64 {
        أرجع اقرأ_الذاكرة_الخطية(العنوان مثل غ32) مثل غ64;
    }

    عرف اكتب_كلمة_مخصص(العنوان: غ64, القيمة: غ64): فراغ {
        اكتب_الذاكرة_الخطية(العنوان مثل غ32, القيمة مثل غ32);
    }

    عرف فئة_رأس_مخصص(الكتلة: غ64): غ64 { أرجع اقرأ_كلمة_مخصص(الكتلة - 8); }
    عرف وسم_رأس_مخصص(الكتلة: غ64): غ64 { أرجع اقرأ_كلمة_مخصص(الكتلة - 4); }
    عرف اكتب_رأس_مخصص(الكتلة: غ64, الفئة: غ64, الوسم: غ64): فراغ {
        اكتب_كلمة_مخصص(الكتلة - 8, الفئة);
        اكتب_كلمة_مخصص(الكتلة - 4, الوسم);
    }

    عرف انسخ_ذاكرة_مخصص(الوجهة: غ64, المصدر: غ64, الطول: غ64): فراغ {
        انسخ_الذاكرة_الخطية(الوجهة مثل غ32, المصدر مثل غ32, الطول مثل غ32);
    }

    عرف نهاية_كومة_مخصص(): غ64 { أرجع 4294967296; }

    // Makes linear memory cover [0, النهاية). Grows by at least 1 MiB so small
    // allocations rarely reach memory.grow, falling back to the exact need.
    عرف اضمن_كومة_مخصص(النهاية: غ64): منطقي {
        لو (النهاية > نهاية_كومة_مخصص()) { أرجع خطأ; };
        دع فشل_النمو: غ32 = 0xFFFFFFFF;
        دع الصفحات: غ64 = انم_الذاكرة_الخطية(0) مثل غ64;
        دع المتاح: غ64 = الصفحات * 65536;
        لو (النهاية <= المتاح) { أرجع صواب; };
        دع المطلوب: غ64 = (النهاية - المتاح + 65535) / 65536;
        دع الدفعة: متغير غ64 = المطلوب;
        لو (الدفعة < 16) { الدفعة := 16; };
        لو (الصفحات + الدفعة > 65536) { الدفعة := المطلوب; };
        لو (انم_الذاكرة_الخطية(الدفعة مثل غ32) != فشل_النمو) { أرجع صواب; };
        لو (الدفعة != المطلوب) {
            لو (انم_الذاكرة_الخطية(المطلوب مثل غ32) != فشل_النمو) { أرجع صواب; };
        };
        أرجع خطأ;
    }

    // The state block address: the heap's first 16-byte boundary.
    عرف بداية_كومة_مخصص(): غ64 {
        دع القاعدة: غ64 = قاعدة_الكومة_الخطية() مثل غ64;
        أرجع (القاعدة + 15) / 16 * 16;
    }

    عام عرف خصص_ذاكرة_التشغيل(الحجم: غ32): غ32 {
        أرجع خصص_كتلة_مخصص(الحجم مثل غ64) مثل غ32;
    }

    عام عرف حرر_ذاكرة_التشغيل(العنوان: غ32): فراغ {
        حرر_كتلة_مخصص(العنوان مثل غ64);
    }

    عام عرف أعد_تخصيص_ذاكرة_التشغيل(العنوان: غ32, الحجم: غ32): غ32 {
        أرجع أعد_تخصيص_كتلة_مخصص(العنوان مثل غ64, الحجم مثل غ64) مثل غ32;
    }
}

// Native 64-bit targets with a std page source.
لو ((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) || الهدف.المنصة == «macos») {
    مرادف اقرأ_ذاكرة_الآلة = بدائي_اقرأ_ذاكرة_الآلة;
    مرادف اكتب_ذاكرة_الآلة = بدائي_اكتب_ذاكرة_الآلة;

    عرف كلمة_المخصص(): غ64 { أرجع 8; }
    // Largest single request: 2^40 bytes.
    عرف أعلى_فئة_مخصص(): غ64 { أرجع 40; }

    عرف اقرأ_كلمة_مخصص(العنوان: غ64): غ64 { أرجع اقرأ_ذاكرة_الآلة(العنوان); }
    عرف اكتب_كلمة_مخصص(العنوان: غ64, القيمة: غ64): فراغ { اكتب_ذاكرة_الآلة(العنوان, القيمة); }

    // The 8-byte header is one little-endian word: class low, tag high.
    عرف فئة_رأس_مخصص(الكتلة: غ64): غ64 { أرجع اقرأ_ذاكرة_الآلة(الكتلة - 8) & 0xFFFFFFFF; }
    عرف وسم_رأس_مخصص(الكتلة: غ64): غ64 { أرجع اقرأ_ذاكرة_الآلة(الكتلة - 8) >> 32; }
    عرف اكتب_رأس_مخصص(الكتلة: غ64, الفئة: غ64, الوسم: غ64): فراغ {
        اكتب_ذاكرة_الآلة(الكتلة - 8, (الوسم << 32) | (الفئة & 0xFFFFFFFF));
    }

    // Block capacities are multiples of 8, so whole words are copied.
    عرف انسخ_ذاكرة_مخصص(الوجهة: غ64, المصدر: غ64, الطول: غ64): فراغ {
        دع ف: متغير غ64 = 0;
        بينما (ف < الطول) {
            اكتب_ذاكرة_الآلة(الوجهة + ف, اقرأ_ذاكرة_الآلة(المصدر + ف));
            ف := ف + 8;
        }
    }

    عرف نهاية_كومة_مخصص(): غ64 { أرجع نهاية_حجز_كومة_الآلة; }

    // Reserves one address range on first use: 64 GiB, halved while the
    // system refuses (address-space limits), down to 64 MiB.
    عرف بداية_كومة_مخصص(): غ64 {
        لو (قاعدة_كومة_الآلة != 0) { أرجع قاعدة_كومة_الآلة; };
        دع الطول: متغير غ64 = 68719476736;
        بينما (الطول >= 67108864) {
            دع العنوان: غ64 = احجز_صفحات_كومة_الآلة(الطول);
            لو (العنوان != 0) {
                قاعدة_كومة_الآلة := العنوان;
                نهاية_حجز_كومة_الآلة := العنوان + الطول;
                نهاية_تثبيت_كومة_الآلة := العنوان;
                أرجع العنوان;
            };
            الطول := الطول / 2;
        }
        أرجع 0;
    }

    // Commits the reserved range up to النهاية, 4 MiB at a time at least.
    عرف اضمن_كومة_مخصص(النهاية: غ64): منطقي {
        لو (قاعدة_كومة_الآلة == 0 || النهاية > نهاية_حجز_كومة_الآلة) { أرجع خطأ; };
        لو (النهاية <= نهاية_تثبيت_كومة_الآلة) { أرجع صواب; };
        دع الهدف_الجديد: متغير غ64 = (النهاية + 4194303) / 4194304 * 4194304;
        لو (الهدف_الجديد > نهاية_حجز_كومة_الآلة) { الهدف_الجديد := نهاية_حجز_كومة_الآلة; };
        لو (!ثبت_صفحات_كومة_الآلة(نهاية_تثبيت_كومة_الآلة, الهدف_الجديد - نهاية_تثبيت_كومة_الآلة)) {
            أرجع خطأ;
        };
        نهاية_تثبيت_كومة_الآلة := الهدف_الجديد;
        أرجع صواب;
    }

    عام عرف خصص_ذاكرة_التشغيل(الحجم: غ64): غ64 {
        أرجع خصص_كتلة_مخصص(الحجم);
    }

    عام عرف حرر_ذاكرة_التشغيل(العنوان: غ64): فراغ {
        حرر_كتلة_مخصص(العنوان);
    }

    عام عرف أعد_تخصيص_ذاكرة_التشغيل(العنوان: غ64, الحجم: غ64): غ64 {
        أرجع أعد_تخصيص_كتلة_مخصص(العنوان, الحجم);
    }
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.virtual_memory;

    عرف احجز_صفحات_كومة_الآلة(الطول: غ64): غ64 { أرجع احجز_عناوين_لينكس(الطول); }
    عرف ثبت_صفحات_كومة_الآلة(العنوان: غ64, الطول: غ64): منطقي {
        أرجع ثبت_عناوين_لينكس(العنوان, الطول);
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.virtual_memory;

    عرف احجز_صفحات_كومة_الآلة(الطول: غ64): غ64 { أرجع احجز_عناوين_داروين(الطول); }
    عرف ثبت_صفحات_كومة_الآلة(العنوان: غ64, الطول: غ64): منطقي {
        أرجع ثبت_عناوين_داروين(العنوان, الطول);
    }
}

// The allocator itself, shared by every page source above.
لو (الهدف.المعمارية == «wasm32» || ((الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) || الهدف.المنصة == «macos»)) {
    عرف وسم_كتلة_مخصصة(): غ64 { أرجع 0x53554C41; }
    عرف وسم_كتلة_محررة(): غ64 { أرجع 0x53554C46; }
    عرف وسم_حالة_مخصص(): غ64 { أرجع 0x53554C53; }

    عرف عدد_فئات_مخصص(): غ64 { أرجع 258 + 4 * (أعلى_فئة_مخصص() - 12); }
    عرف حجم_حالة_مخصص(): غ64 {
        أرجع (16 + كلمة_المخصص() * عدد_فئات_مخصص() + 15) / 16 * 16;
    }
    عرف رأس_قائمة_فئة(الحالة: غ64, الفئة: غ64): غ64 {
        أرجع الحالة + 16 + كلمة_المخصص() * الفئة;
    }

    // The state block, initialized on first use; 0 when it cannot be placed.
    // Fresh pages are zeroed, so every class list starts empty.
    عرف حالة_المخصص(): غ64 {
        دع الحالة: غ64 = بداية_كومة_مخصص();
        لو (الحالة == 0) { أرجع 0; };
        لو (!اضمن_كومة_مخصص(الحالة + حجم_حالة_مخصص())) { أرجع 0; };
        لو (اقرأ_كلمة_مخصص(الحالة) != وسم_حالة_مخصص()) {
            اكتب_كلمة_مخصص(الحالة + كلمة_المخصص(), الحالة + حجم_حالة_مخصص());
            اكتب_كلمة_مخصص(الحالة, وسم_حالة_مخصص());
        };
        أرجع الحالة;
    }

    // The class of a request for البايتات payload bytes; 0 when too large.
    // A payload always holds at least one free-list word.
    عرف فئة_طلب(البايتات_المطلوبة: غ64): غ64 {
        دع البايتات: متغير غ64 = البايتات_المطلوبة;
        لو (البايتات < كلمة_المخصص()) { البايتات := كلمة_المخصص(); };
        لو (البايتات <= 4088) {
            أرجع (البايتات + 8 + 15) / 16;
        };
        لو (البايتات > ((1 مثل غ64) << أعلى_فئة_مخصص())) { أرجع 0; };
        دع الأس: متغير غ64 = 12;
        دع الأساس: متغير غ64 = 4096;
        بينما (الأساس * 2 < البايتات) {
            الأساس := الأساس * 2;
            الأس := الأس + 1;
        }
        // البايتات lies in (الأساس, 2 الأساس]; pick the first quarter step.
        دع الربع: متغير غ64 = 0;
        بينما (الربع < 4 && الأساس * (4 + الربع) / 4 < البايتات) {
            الربع := الربع + 1;
        }
        لو (الربع == 4) {
            الأس := الأس + 1;
            الربع := 0;
        };
        دع الفئة: غ64 = 257 + 4 * (الأس - 12) + الربع;
        لو (الفئة >= عدد_فئات_مخصص()) { أرجع 0; };
        أرجع الفئة;
    }

    عرف حجم_كتلة_فئة(الفئة: غ64): غ64 {
        لو (الفئة <= 256) { أرجع الفئة * 16; };
        دع الدرجة: غ64 = (الفئة - 257) / 4;
        دع الربع: غ64 = (الفئة - 257) % 4;
        دع الأساس: متغير غ64 = 4096;
        دع ف: متغير غ64 = 0;
        بينما (ف < الدرجة) {
            الأساس := الأساس * 2;
            ف := ف + 1;
        }
        أرجع الأساس * (4 + الربع) / 4 + 16;
    }

    // The class of an allocated payload; 0 when the address is not a live
    // block of this allocator (never allocated here, or already freed).
    عرف فئة_كتلة_حية(الحالة: غ64, الكتلة: غ64): غ64 {
        لو (الكتلة < الحالة + حجم_حالة_مخصص() + 8) { أرجع 0; };
        لو (الكتلة >= اقرأ_كلمة_مخصص(الحالة + كلمة_المخصص())) { أرجع 0; };
        لو (وسم_رأس_مخصص(الكتلة) != وسم_كتلة_مخصصة()) { أرجع 0; };
        دع الفئة: غ64 = فئة_رأس_مخصص(الكتلة);
        لو (الفئة == 0 || الفئة >= عدد_فئات_مخصص()) { أرجع 0; };
        أرجع الفئة;
    }

    عرف خصص_كتلة_مخصص(الحجم: غ64): غ64 {
        دع الحالة: غ64 = حالة_المخصص();
        لو (الحالة == 0) { أرجع 0; };
        دع الفئة: غ64 = فئة_طلب(الحجم);
        لو (الفئة == 0) { أرجع 0; };
        دع الرأس: غ64 = رأس_قائمة_فئة(الحالة, الفئة);
        دع الحرة: غ64 = اقرأ_كلمة_مخصص(الرأس);
        لو (الحرة != 0) {
            اكتب_كلمة_مخصص(الرأس, اقرأ_كلمة_مخصص(الحرة));
            اكتب_رأس_مخصص(الحرة, الفئة, وسم_كتلة_مخصصة());
            أرجع الحرة;
        };
        دع البداية: غ64 = اقرأ_كلمة_مخصص(الحالة + كلمة_المخصص());
        دع النهاية: غ64 = البداية + حجم_كتلة_فئة(الفئة);
        لو (النهاية >= نهاية_كومة_مخصص() || !اضمن_كومة_مخصص(النهاية)) { أرجع 0; };
        اكتب_كلمة_مخصص(الحالة + كلمة_المخصص(), النهاية);
        اكتب_رأس_مخصص(البداية + 8, الفئة, وسم_كتلة_مخصصة());
        أرجع البداية + 8;
    }

    عرف حرر_كتلة_مخصص(الكتلة: غ64): فراغ {
        لو (الكتلة == 0) { أرجع; };
        دع الحالة: غ64 = حالة_المخصص();
        لو (الحالة == 0) { أرجع; };
        دع الفئة: غ64 = فئة_كتلة_حية(الحالة, الكتلة);
        لو (الفئة == 0) { أرجع; };
        دع الرأس: غ64 = رأس_قائمة_فئة(الحالة, الفئة);
        اكتب_كلمة_مخصص(الكتلة, اقرأ_كلمة_مخصص(الرأس));
        اكتب_رأس_مخصص(الكتلة, الفئة, وسم_كتلة_محررة());
        اكتب_كلمة_مخصص(الرأس, الكتلة);
    }

    عرف أعد_تخصيص_كتلة_مخصص(الكتلة: غ64, الحجم: غ64): غ64 {
        لو (الكتلة == 0) { أرجع خصص_كتلة_مخصص(الحجم); };
        دع الحالة: غ64 = حالة_المخصص();
        لو (الحالة == 0) { أرجع 0; };
        دع الفئة: غ64 = فئة_كتلة_حية(الحالة, الكتلة);
        لو (الفئة == 0) { أرجع 0; };
        دع السعة: غ64 = حجم_كتلة_فئة(الفئة) - 8;
        لو (الحجم <= السعة) { أرجع الكتلة; };
        // The most recently carved block extends in place.
        دع البداية: غ64 = الكتلة - 8;
        لو (البداية + حجم_كتلة_فئة(الفئة) == اقرأ_كلمة_مخصص(الحالة + كلمة_المخصص())) {
            دع الفئة_الجديدة: غ64 = فئة_طلب(الحجم);
            لو (الفئة_الجديدة == 0) { أرجع 0; };
            دع النهاية: غ64 = البداية + حجم_كتلة_فئة(الفئة_الجديدة);
            لو (النهاية < نهاية_كومة_مخصص() && اضمن_كومة_مخصص(النهاية)) {
                اكتب_كلمة_مخصص(الحالة + كلمة_المخصص(), النهاية);
                اكتب_رأس_مخصص(الكتلة, الفئة_الجديدة, وسم_كتلة_مخصصة());
                أرجع الكتلة;
            };
        };
        دع الجديدة: غ64 = خصص_كتلة_مخصص(الحجم);
        لو (الجديدة == 0) { أرجع 0; };
        انسخ_ذاكرة_مخصص(الجديدة, الكتلة, السعة);
        حرر_كتلة_مخصص(الكتلة);
        أرجع الجديدة;
    }
}
