            اكتب_كلمة_مخصص(الرأس, الكتلة);
        };
        إذا ((كبيرة || صحح_التالية) && الكتلة - 8 + الحجم < قمة_المخصص(الحالة)) {
            حدث_علم_السابق_مخصص(الكتلة + الحجم, كبيرة);
        };
        أدرج_حرة_مخصص(الكتلة, الحجم);
    }

    // الكتلة (on no list; الكلي bytes) becomes an allocated block of الحجم
    // bytes; the rest, when there is one, is listed free. Returns the size the
    // block keeps.
    عرف اقسم_كتلة_مخصص(الحالة: ط64, الكتلة: ط64, الكلي: ط64, الحجم: ط64): ط64 {
        دع الباقي: ط64 = الكلي - الحجم;
        دع سابقها_حر: منطقي = سابقها_حر_مخصص(الكتلة);
        إذا (الباقي == 0) {
            اكتب_كتلة_مخصص(الكتلة, الكلي, وسم_كتلة_مخصصة(), سابقها_حر);
            إذا (الكتلة - 8 + الكلي < قمة_المخصص(الحالة)) {
                حدث_علم_السابق_مخصص(الكتلة + الكلي, خطأ);
            };
            أرجع الكلي;
        };
        اكتب_كتلة_مخصص(الكتلة, الحجم, وسم_كتلة_مخصصة(), سابقها_حر);
        ضع_كتلة_حرة_مخصص(الحالة, الكتلة + الحجم, الباقي, خطأ, صواب);
        أرجع الحجم;
    }

    // A new block of الحجم bytes at the top. The block before the top is
    // never a free large block (one that reaches the top lowers it instead).
    عرف اقتطع_من_القمة_مخصص(الحالة: ط64, الحجم: ط64): ط64 {
        دع البداية: ط64 = قمة_المخصص(الحالة);
        دع النهاية: ط64 = البداية + الحجم;
        إذا (النهاية >= نهاية_كومة_مخصص() || !اضمن_كومة_مخصص(النهاية)) { أرجع 0; };
        ضع_قمة_المخصص(الحالة, النهاية);
        اكتب_كتلة_مخصص(البداية + 8, الحجم, وسم_كتلة_مخصصة(), خطأ);
        أضف_حيا_مخصص(الحجم);
        أرجع البداية + 8;
    }

    // The size of a live block; 0 when the address is not one (never
    // allocated here, already freed, or not a block start).
    عرف حجم_كتلة_حية_مخصص(الحالة: ط64, الكتلة: ط64): ط64 {
        إذا (الحالة == 0 || الكتلة % 16 != 8) { أرجع 0; };
        إذا (الكتلة < الحالة + حجم_حالة_مخصص() + 8) { أرجع 0; };
        دع القمة: ط64 = قمة_المخصص(الحالة);
        إذا (الكتلة >= القمة) { أرجع 0; };
        إذا (وسم_رأس_مخصص(الكتلة) != وسم_كتلة_مخصصة()) { أرجع 0; };
        دع الحجم: ط64 = حجم_كتلة_مخصص(الكتلة);
        إذا (الحجم < 16 || الكتلة - 8 + الحجم > القمة) { أرجع 0; };
        أرجع الحجم;
    }

    عرف خصص_كتلة_مخصص(الطلب: ط64): ط64 {
        دع الحالة: ط64 = حالة_المخصص();
        إذا (الحالة == 0) { أرجع 0; };
        دع الحجم: ط64 = حجم_طلب_مخصص(الطلب);
        إذا (الحجم == 0) { أرجع 0; };
        إذا (!كتلة_كبيرة_مخصص(الحجم)) {
            دع الرأس: ط64 = رأس_قائمة_فئة(الحالة, الحجم / 16);
            دع الحرة: ط64 = اقرأ_كلمة_مخصص(الرأس);
            إذا (الحرة != 0) {
                إذا (!أخرج_حرة_مخصص(الحرة, الحجم, صواب)) { أرجع 0; };
                اكتب_كلمة_مخصص(الرأس, اقرأ_كلمة_مخصص(الحرة));
                اكتب_كتلة_مخصص(الحرة, الحجم, وسم_كتلة_مخصصة(), سابقها_حر_مخصص(الحرة));
                أضف_حيا_مخصص(الحجم);
                أرجع الحرة;
            };
            أرجع اقتطع_من_القمة_مخصص(الحالة, الحجم);
        };
        // The first fitting block of the first bin that can hold the request.
        // Past the request's own bin every block fits; within it (and in the
        // last, open-ended bin) a few blocks are tried.
        دع الصندوق: متغير ط64 = صندوق_حجم_مخصص(الحجم);
        طالما (الصندوق < عدد_فئات_مخصص()) {
            دع الكتلة: متغير ط64 = اقرأ_كلمة_مخصص(رأس_قائمة_فئة(الحالة, الصندوق));
            دع المحاولات: متغير ط64 = 0;
            طالما (الكتلة != 0 && المحاولات < 8) {
                دع حجمها: ط64 = حجم_كتلة_مخصص(الكتلة);
                إذا (حجمها >= الحجم) {
                    إذا (!أخرج_حرة_مخصص(الكتلة, حجمها, صواب)) { أرجع 0; };
                    أزل_من_صندوق_مخصص(الحالة, الكتلة, حجمها);
                    أضف_حيا_مخصص(اقسم_كتلة_مخصص(الحالة, الكتلة, حجمها, الحجم));
                    أرجع الكتلة;
                };
                الكتلة := اقرأ_كلمة_مخصص(الكتلة);
                المحاولات := المحاولات + 1;
            }
            الصندوق := الصندوق + 1;
        }
        أرجع اقتطع_من_القمة_مخصص(الحالة, الحجم);
    }

    // Takes back an allocated block (already counted out of the live bytes):
    // merges it with its free large neighbours, then lowers the top when the
    // result ends there, or lists it free.
    عرف أعد_كتلة_مخصص(الحالة: ط64, الكتلة: ط64, الحجم: ط64): فراغ {
        دع البداية: متغير ط64 = الكتلة;
        دع الكلي: متغير ط64 = الحجم;
        دع سابقها_حر: متغير منطقي = سابقها_حر_مخصص(الكتلة);
        دع القمة: ط64 = قمة_المخصص(الحالة);
        دع التالية: ط64 = الكتلة + الحجم;
        إذا (التالية - 8 < القمة && كتلة_حرة_مخصص(التالية)) {
            دع حجم_التالية: ط64 = حجم_كتلة_مخصص(التالية);
            إذا (كتلة_كبيرة_مخصص(حجم_التالية) && الكلي + حجم_التالية < حد_الدمج_مخصص()) {
                // Recommit a reclaimed neighbour's pages: if the merged block
                // ends at the top, the top is lowered over them and later
                // growth reuses them without committing (Windows decommits
                // reclaimed pages; POSIX keeps them mapped).
                إذا (أخرج_حرة_مخصص(التالية, حجم_التالية, صواب)) {
                    أزل_من_صندوق_مخصص(الحالة, التالية, حجم_التالية);
                    الكلي := الكلي + حجم_التالية;
                };
            };
        };
        إذا (سابقها_حر) {
            // Its last word names it; anything else is a corrupted heap.
            دع السابقة: ط64 = اقرأ_كلمة_مخصص(الكتلة - 8 - كلمة_المخصص());
            دع حجم_السابقة: ط64 = حجم_كتلة_مخصص(السابقة);
            إذا (السابقة < الحالة + حجم_حالة_مخصص() + 8 || السابقة >= الكتلة || !كتلة_حرة_مخصص(السابقة)
                || !كتلة_كبيرة_مخصص(حجم_السابقة) || السابقة + حجم_السابقة != الكتلة) {
                إذا (أوقف_المخصص(الكتلة) != 0) { أرجع; };
            };
            إذا (الكلي + حجم_السابقة < حد_الدمج_مخصص()) {
                إذا (أخرج_حرة_مخصص(السابقة, حجم_السابقة, صواب)) {
                    أزل_من_صندوق_مخصص(الحالة, السابقة, حجم_السابقة);
                    البداية := السابقة;
                    الكلي := الكلي + حجم_السابقة;
                    سابقها_حر := سابقها_حر_مخصص(السابقة);
                };
            };
        };
        إذا (البداية - 8 + الكلي == القمة) {
            ضع_قمة_المخصص(الحالة, البداية - 8);
            قلص_القمة_مخصص(البداية - 8);
            أرجع;
        };
        ضع_كتلة_حرة_مخصص(الحالة, البداية, الكلي, سابقها_حر, خطأ);
    }

    عرف حرر_كتلة_مخصص(الكتلة: ط64): فراغ {
        إذا (الكتلة == 0 || !في_الكومة_مخصص(الكتلة)) { أرجع; };
        دع الحالة: ط64 = حالة_المخصص();
        دع الحجم: ط64 = حجم_كتلة_حية_مخصص(الحالة, الكتلة);
        إذا (الحجم == 0) {
            إذا (أوقف_المخصص(الكتلة) != 0) { أرجع; };
        };
        انقص_حيا_مخصص(الحجم);
        أعد_كتلة_مخصص(الحالة, الكتلة, الحجم);
    }

    عرف أعد_تخصيص_كتلة_مخصص(الكتلة: ط64, الطلب: ط64): ط64 {
        إذا (الكتلة == 0) { أرجع خصص_كتلة_مخصص(الطلب); };
        // Static storage cannot grow: 0, which the generated code traps on.
        إذا (!في_الكومة_مخصص(الكتلة)) { أرجع 0; };
        دع الحالة: ط64 = حالة_المخصص();
        دع الحجم: ط64 = حجم_كتلة_حية_مخصص(الحالة, الكتلة);
        إذا (الحجم == 0) { أرجع أوقف_المخصص(الكتلة); };
        دع السعة: ط64 = الحجم - 8;
        إذا (الطلب <= السعة) { أرجع الكتلة; };
        دع المطلوب: ط64 = حجم_طلب_مخصص(الطلب);
        إذا (المطلوب == 0) { أرجع 0; };
        دع القمة: ط64 = قمة_المخصص(الحالة);
        دع النهاية_الحالية: ط64 = الكتلة - 8 + الحجم;
        // The block at the top extends in place, unless a released block of a
        // small target size can be reused instead: a vector that is grown,
        // released and built again then reuses its storage.
        إذا (النهاية_الحالية == القمة
            && (كتلة_كبيرة_مخصص(المطلوب) || اقرأ_كلمة_مخصص(رأس_قائمة_فئة(الحالة, المطلوب / 16)) == 0)) {
            دع النهاية: ط64 = الكتلة - 8 + المطلوب;
            إذا (النهاية < نهاية_كومة_مخصص() && اضمن_كومة_مخصص(النهاية)) {
                ضع_قمة_المخصص(الحالة, النهاية);
                اكتب_كتلة_مخصص(الكتلة, المطلوب, وسم_كتلة_مخصصة(), سابقها_حر_مخصص(الكتلة));
                أضف_حيا_مخصص(المطلوب - الحجم);
                أرجع الكتلة;
            };
        };
        // A free large block right after it: grow into it.
        إذا (النهاية_الحالية < القمة && كتلة_حرة_مخصص(الكتلة + الحجم)) {
            دع التالية: ط64 = الكتلة + الحجم;
            دع حجم_التالية: ط64 = حجم_كتلة_مخصص(التالية);
            إذا (كتلة_كبيرة_مخصص(حجم_التالية) && الحجم + حجم_التالية >= المطلوب) {
                إذا (!أخرج_حرة_مخصص(التالية, حجم_التالية, صواب)) { أرجع 0; };
                أزل_من_صندوق_مخصص(الحالة, التالية, حجم_التالية);
                دع المحفوظ: ط64 = اقسم_كتلة_مخصص(الحالة, الكتلة, الحجم + حجم_التالية, المطلوب);
                أضف_حيا_مخصص(المحفوظ - الحجم);
                أرجع الكتلة;
            };
        };
        دع الجديدة: ط64 = خصص_كتلة_مخصص(الطلب);
        إذا (الجديدة == 0) { أرجع 0; };
        انسخ_ذاكرة_مخصص(الجديدة, الكتلة, السعة);
        حرر_كتلة_مخصص(الكتلة);
        أرجع الجديدة;
    }

    // ---- Giving free memory back ----
    // A released small block waits on the list of its size and never merges,
    // so a heap whose small blocks were released in bulk (a compiler phase's
    // data) keeps every page they occupy. This walks the blocks from the first
    // to the top once, under the lock, and merges each run of adjacent free
    // blocks into one: a free large block, whose interior pages go back to
    // the OS (أدرج_حرة_مخصص), or the top, lowered over a run that ends there.
    // The small lists are rebuilt along the way. Its time is linear in the
    // number of blocks: for a program changing phase (the driver before
    // `sultanc run` starts the program), not for a hot path.
    عرف اجمع_الكتل_الحرة_مخصص(): فراغ {
        دع الحالة: ط64 = حالة_المخصص_المهيأة;
        إذا (الحالة == 0) { أرجع; };
        دع الفئة: متغير ط64 = 1;
        طالما (الفئة <= 256) {
            اكتب_كلمة_مخصص(رأس_قائمة_فئة(الحالة, الفئة), 0);
            الفئة := الفئة + 1;
        }
        دع القمة: ط64 = قمة_المخصص(الحالة);
        دع الكتلة: متغير ط64 = الحالة + حجم_حالة_مخصص() + 8;
        // The current run: its first block (0 for none), its size, and whether
        // its blocks have left their lists (from its second block on).
        دع البداية: متغير ط64 = 0;
        دع الكلي: متغير ط64 = 0;
        دع خرجت: متغير منطقي = خطأ;
        طالما (الكتلة - 8 < القمة) {
            دع الحجم: ط64 = حجم_كتلة_مخصص(الكتلة);
            إذا (الحجم < 16 || الكتلة - 8 + الحجم > القمة) {
                إذا (أوقف_المخصص(الكتلة) != 0) { أرجع; };
            };
            إذا (كتلة_حرة_مخصص(الكتلة)) {
                إذا (البداية != 0 && الكلي + الحجم >= حد_الدمج_مخصص()) {
                    أنه_مسارا_حرا_مخصص(الحالة, البداية, الكلي, خرجت);
                    البداية := 0;
                };
                إذا (البداية == 0) {
                    البداية := الكتلة;
                    الكلي := الحجم;
                    خرجت := خطأ;
                } وإلا إذا (!خرجت && !أخرج_للدمج_مخصص(الحالة, البداية, الكلي)) {
                    // Its first block keeps its pages released (Windows could
                    // not recommit them) and stays listed: start again here.
                    البداية := الكتلة;
                    الكلي := الحجم;
                } وإلا {
                    خرجت := صواب;
                    إذا (أخرج_للدمج_مخصص(الحالة, الكتلة, الحجم)) {
                        الكلي := الكلي + الحجم;
                    } وإلا {
                        أنه_مسارا_حرا_مخصص(الحالة, البداية, الكلي, صواب);
                        البداية := 0;
                    };
                };
            } وإلا إذا (البداية != 0) {
                أنه_مسارا_حرا_مخصص(الحالة, البداية, الكلي, خرجت);
                البداية := 0;
            };
            الكتلة := الكتلة + الحجم;
        }
        إذا (البداية != 0) { أنه_مسارا_حرا_مخصص(الحالة, البداية, الكلي, خرجت); };
    }

    // A free block leaves its list to be merged; false (nothing changed)
    // when its released pages cannot be recommitted. The small lists are
    // being rebuilt, so a small block is on none.
    عرف أخرج_للدمج_مخصص(الحالة: ط64, الكتلة: ط64, الحجم: ط64): منطقي {
        إذا (!أخرج_حرة_مخصص(الكتلة, الحجم, صواب)) { أرجع خطأ; };
        إذا (كتلة_كبيرة_مخصص(الحجم)) { أزل_من_صندوق_مخصص(الحالة, الكتلة, الحجم); };
        أرجع صواب;
    }

    // Ends a run of free blocks from البداية (الكلي bytes). One block that
    // never left its list stays as it is (a small one goes back on its
    // list); a merged run becomes one free block, or lowers the top when it
    // ends there (unless a free large block that could not be merged lies
    // just before it: the block before the top is never one).
    عرف أنه_مسارا_حرا_مخصص(الحالة: ط64, البداية: ط64, الكلي: ط64, خرجت: منطقي): فراغ {
        دع عند_القمة: منطقي = البداية - 8 + الكلي == قمة_المخصص(الحالة) && !سابقها_حر_مخصص(البداية);
        دع مدمجة: متغير منطقي = خرجت;
        إذا (!مدمجة && عند_القمة) { مدمجة := أخرج_للدمج_مخصص(الحالة, البداية, الكلي); };
        إذا (!مدمجة) {
            إذا (!كتلة_كبيرة_مخصص(الكلي)) {
                دع الرأس: ط64 = رأس_قائمة_فئة(الحالة, الكلي / 16);
                اكتب_كلمة_مخصص(البداية, اقرأ_كلمة_مخصص(الرأس));
                اكتب_كلمة_مخصص(الرأس, البداية);
            } وإلا {
                أرجع_صفحات_كتلة_حرة_مخصص(البداية, الكلي);
            };
            أرجع;
        };
        إذا (عند_القمة) {
            ضع_قمة_المخصص(الحالة, البداية - 8);
            قلص_القمة_مخصص(البداية - 8);
            أرجع;
        };
        ضع_كتلة_حرة_مخصص(الحالة, البداية, الكلي, سابقها_حر_مخصص(البداية), صواب);
        أرجع_صفحات_كتلة_حرة_مخصص(البداية, الكلي);
    }
}
