// Compiler storage services: allocate, reallocate, free.
//
// These are the compiler's three storage services (see
// compiler/runtime/service_identity.sn) on every target where std has a page
// source. No C allocator is used anywhere: MSIR lowering binds the public
// functions below by their canonical names as the program's allocation
// providers (compiler/runtime/primitive_runtime_abi.sn), every backend calls
// them directly, and the driver loads this module for each compilation that
// generates code for such a target (runtime_symbol_query_context.sn,
// مزود_خدمات_ذاكرة_للهدف, owns the target list; it must match the guards here).
//
// Page sources:
//   wasm32          the module's linear memory (memory.grow), u32 addresses;
//   Linux x86_64/aarch64  one reserved address range from raw mmap, committed
//                   by mprotect (os.platform.unix.linux.virtual_memory);
//   macOS           the same through libSystem's mmap/mprotect, the supported
//                   Darwin kernel interface (os.platform.unix.apple.darwin);
//   Windows         the same through kernel32's VirtualAlloc reserve and commit
//                   (os.platform.windows.win32.virtual_memory).
// 0 is a failed allocation, which the generated code turns into a trap.
//
// Layout (word W = 4 bytes on wasm32, 8 on 64-bit native targets). The state
// block starts the heap (wasm32: the first 16-byte boundary at or after
// __heap_base; native: the start of the reserved range): [+0] state tag,
// [+W] top (the first unused address), [+16 + W c] list head c. Blocks are
// carved from the top, contiguously, each 16-byte aligned with a multiple of
// 16 bytes and an 8-byte header (field u32 at payload-8, tag u32 at
// payload-4), so payloads are 8-byte aligned. The field holds the block size
// / 16 in bits 0-30; bit 31 says the block just before is a free large block.
//   Small blocks (at most 4 KiB: requests up to 4088 bytes) round up to 16
//   bytes. A free small block is pushed on the list of its size (c = size /
//   16, 1..256; the link is the first payload word) and reused for the same
//   size only.
//   Large blocks (over 4 KiB) have the exact rounded size. A free large block
//   has two links (next, previous) at the start of its payload and its
//   payload address in its last word, and sits in the bin of its size: bin c
//   (257 <= c) holds sizes in [2^k (4 + q) / 4 + 16, the next bound), with
//   c = 257 + 4 (k - 12) + q, q = 0..3. A large request takes the first
//   fitting block of the first bin that can hold it and splits off the rest
//   (a large or a small free block).
//   Freeing merges the block with free large neighbours (both sides). A free
//   block that ends at the top lowers the top instead. On native targets the
//   fully interior 64 KiB ranges of a free large block are returned to the
//   OS (never its header, links or last word), and when the top falls 8 MiB
//   below the committed end, the pages above it are returned as well.
//   Windows recommits those ranges before a block is reused.
// The block that ends at the top grows in place when reallocated (unless a
// free block of a small target size is ready), and a block followed by a
// free large block grows into it, so a growing vector rarely needs a copy.
// Releasing an address outside the heap does nothing: owned values may point
// at static storage (a text literal passed as an owned value), and their drop
// releases it. Inside the heap, releasing or reallocating an address that is
// not a live block (released twice, inside a block, past the top) traps. One allocator
// instance per program image; not thread-safe (SultanC programs are
// single-threaded).
//
// Nothing here may allocate: only integer arithmetic, the memory primitives
// and the page-source calls are used.

// Native heap position: start of the reserved range (0 until first use), its
// end, and the committed prefix end. Unused on wasm32 (linear memory itself
// records the heap there).
دع قاعدة_كومة_الآلة: متغير ط64 = 0;
دع نهاية_حجز_كومة_الآلة: متغير ط64 = 0;
دع نهاية_تثبيت_كومة_الآلة: متغير ط64 = 0;
// The state block's address once it is initialized (0 before), so every
// operation after the first skips placing it again.
دع حالة_المخصص_المهيأة: متغير ط64 = 0;
// Thread safety (docs/CONCURRENCY.md). One global allocator instance serves
// every thread, so a lock serializes allocate/reallocate/free once threads
// exist. قفل_المخصص_مفعل is set to 1 by فعّل_قفل_المخصص before the first
// thread is spawned (std.thread), and never cleared; a single-threaded
// program (and the compiler, which is single-threaded) leaves it 0 and takes
// one predictable-not-taken branch per allocation, no atomic. The lock word
// is an uncontended seqcst compare-exchange otherwise (a spinlock: an
// allocator critical section is a few hundred instructions).
دع قفل_المخصص: متغير ط64 = 0;
دع قفل_المخصص_مفعل: متغير ط64 = 0;
// The 32-bit ABIs lock a 32-bit word: i386 has no 64-bit atomic store
// without a library call (LLVM's __atomic_store), and a word is enough.
دع قفل_المخصص32: متغير ط32 = 0;

// Whether a thread was ever spawned (the allocator lock is on): std's other
// process-wide tables (std.env.table) take their locks only from then on.
عام عرف هل_بدأت_خيوط(): منطقي { أرجع قفل_المخصص_مفعل != 0; }

لو (الهدف.المعمارية == «wasm32») {
    // Compiler intrinsics bind only through private aliases.
    مرادف انم_الذاكرة_الخطية = بدائي_نمو_الذاكرة_الخطية;
    مرادف اقرأ_الذاكرة_الخطية = بدائي_اقرأ_الذاكرة_الخطية;
    مرادف اكتب_الذاكرة_الخطية = بدائي_اكتب_الذاكرة_الخطية;
    مرادف انسخ_الذاكرة_الخطية = بدائي_انسخ_الذاكرة_الخطية;
    مرادف قاعدة_الكومة_الخطية = بدائي_قاعدة_الكومة_الخطية;

    عرف كلمة_المخصص(): ط64 { أرجع 4; }
    // The next-free address is a u32 word; the heap stays below 2^32.
    عرف أعلى_فئة_مخصص(): ط64 { أرجع 31; }

    عرف اقرأ_كلمة_مخصص(العنوان: ط64): ط64 {
        أرجع اقرأ_الذاكرة_الخطية(العنوان مثل ط32) مثل ط64;
    }

    عرف اكتب_كلمة_مخصص(العنوان: ط64, القيمة: ط64): فراغ {
        اكتب_الذاكرة_الخطية(العنوان مثل ط32, القيمة مثل ط32);
    }

    عرف فئة_رأس_مخصص(الكتلة: ط64): ط64 { أرجع اقرأ_كلمة_مخصص(الكتلة - 8); }
    عرف وسم_رأس_مخصص(الكتلة: ط64): ط64 { أرجع اقرأ_كلمة_مخصص(الكتلة - 4); }
    عرف اكتب_رأس_مخصص(الكتلة: ط64, الفئة: ط64, الوسم: ط64): فراغ {
        اكتب_كلمة_مخصص(الكتلة - 8, الفئة);
        اكتب_كلمة_مخصص(الكتلة - 4, الوسم);
    }

    عرف انسخ_ذاكرة_مخصص(الوجهة: ط64, المصدر: ط64, الطول: ط64): فراغ {
        انسخ_الذاكرة_الخطية(الوجهة مثل ط32, المصدر مثل ط32, الطول مثل ط32);
    }

    عرف نهاية_كومة_مخصص(): ط64 { أرجع 4294967296; }

    // Makes linear memory cover [0, النهاية). Grows by at least 1 MiB so small
    // allocations rarely reach memory.grow, falling back to the exact need.
    عرف اضمن_كومة_مخصص(النهاية: ط64): منطقي {
        لو (النهاية > نهاية_كومة_مخصص()) { أرجع خطأ; };
        دع فشل_النمو: ط32 = 0xFFFFFFFF;
        دع الصفحات: ط64 = انم_الذاكرة_الخطية(0) مثل ط64;
        دع المتاح: ط64 = الصفحات * 65536;
        لو (النهاية <= المتاح) { أرجع صواب; };
        دع المطلوب: ط64 = (النهاية - المتاح + 65535) / 65536;
        دع الدفعة: متغير ط64 = المطلوب;
        لو (الدفعة < 16) { الدفعة := 16; };
        لو (الصفحات + الدفعة > 65536) { الدفعة := المطلوب; };
        لو (انم_الذاكرة_الخطية(الدفعة مثل ط32) != فشل_النمو) { أرجع صواب; };
        لو (الدفعة != المطلوب) {
            لو (انم_الذاكرة_الخطية(المطلوب مثل ط32) != فشل_النمو) { أرجع صواب; };
        };
        أرجع خطأ;
    }

    // Native-only accounting and reclamation are deliberately no-ops for
    // WASM, where linear-memory pages cannot be returned to the host.
    عرف أضف_حيا_مخصص(البايتات: ط64): فراغ { }
    عرف انقص_حيا_مخصص(البايتات: ط64): فراغ { }
    عرف أدرج_حرة_مخصص(الكتلة: ط64, الحجم: ط64): فراغ { }
    عرف أخرج_حرة_مخصص(الكتلة: ط64, الحجم: ط64, للاستعمال: منطقي): منطقي { أرجع صواب; }
    عرف قلص_القمة_مخصص(القمة: ط64): فراغ { }

    // The state block address: the heap's first 16-byte boundary.
    عرف بداية_كومة_مخصص(): ط64 {
        دع القاعدة: ط64 = قاعدة_الكومة_الخطية() مثل ط64;
        أرجع (القاعدة + 15) / 16 * 16;
    }

    // Static data and the shadow stack lie below the heap base.
    عرف في_الكومة_مخصص(العنوان: ط64): منطقي {
        أرجع العنوان >= بداية_كومة_مخصص() && العنوان < نهاية_كومة_مخصص();
    }

    عام عرف خصص_ذاكرة_التشغيل(الحجم: ط32): ط32 {
        أرجع خصص_كتلة_مخصص(الحجم مثل ط64) مثل ط32;
    }

    عام عرف حرر_ذاكرة_التشغيل(العنوان: ط32): فراغ {
        حرر_كتلة_مخصص(العنوان مثل ط64);
    }

    عام عرف أعد_تخصيص_ذاكرة_التشغيل(العنوان: ط32, الحجم: ط32): ط32 {
        أرجع أعد_تخصيص_كتلة_مخصص(العنوان مثل ط64, الحجم مثل ط64) مثل ط32;
    }
}

// Native 64-bit targets with a std page source.
لو (((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») {
    مرادف اقرأ_ذاكرة_الآلة = بدائي_اقرأ_ذاكرة_الآلة;
    مرادف اكتب_ذاكرة_الآلة = بدائي_اكتب_ذاكرة_الآلة;

    عرف كلمة_المخصص(): ط64 { أرجع 8; }
    // Largest single request: 2^34 bytes (16 GiB; a block size / 16 must fit
    // the header's 31-bit field).
    عرف أعلى_فئة_مخصص(): ط64 { أرجع 34; }

    عرف اقرأ_كلمة_مخصص(العنوان: ط64): ط64 { أرجع اقرأ_ذاكرة_الآلة(العنوان); }
    عرف اكتب_كلمة_مخصص(العنوان: ط64, القيمة: ط64): فراغ { اكتب_ذاكرة_الآلة(العنوان, القيمة); }

    // The 8-byte header is one little-endian word: class low, tag high.
    عرف فئة_رأس_مخصص(الكتلة: ط64): ط64 { أرجع اقرأ_ذاكرة_الآلة(الكتلة - 8) & 0xFFFFFFFF; }
    عرف وسم_رأس_مخصص(الكتلة: ط64): ط64 { أرجع اقرأ_ذاكرة_الآلة(الكتلة - 8) >> 32; }
    عرف اكتب_رأس_مخصص(الكتلة: ط64, الفئة: ط64, الوسم: ط64): فراغ {
        اكتب_ذاكرة_الآلة(الكتلة - 8, (الوسم << 32) | (الفئة & 0xFFFFFFFF));
    }

    // Block capacities are multiples of 8, so whole words are copied.
    عرف انسخ_ذاكرة_مخصص(الوجهة: ط64, المصدر: ط64, الطول: ط64): فراغ {
        دع ف: متغير ط64 = 0;
        طالما (ف < الطول) {
            اكتب_ذاكرة_الآلة(الوجهة + ف, اقرأ_ذاكرة_الآلة(المصدر + ف));
            ف := ف + 8;
        }
    }

    عرف نهاية_كومة_مخصص(): ط64 { أرجع نهاية_حجز_كومة_الآلة; }

    // The reserved range; static data and stacks lie outside it.
    عرف في_الكومة_مخصص(العنوان: ط64): منطقي {
        أرجع قاعدة_كومة_الآلة != 0 && العنوان >= قاعدة_كومة_الآلة && العنوان < نهاية_حجز_كومة_الآلة;
    }

    // Reserves one address range on first use: the page source's largest
    // reservation (64 GiB; 1 GiB on 32-bit address spaces), halved while
    // the system refuses (address-space limits), down to 64 MiB.
    عرف بداية_كومة_مخصص(): ط64 {
        لو (قاعدة_كومة_الآلة != 0) { أرجع قاعدة_كومة_الآلة; };
        دع الطول: متغير ط64 = أكبر_حجز_كومة_الآلة();
        طالما (الطول >= 67108864) {
            دع العنوان: ط64 = احجز_صفحات_كومة_الآلة(الطول);
            لو (العنوان != 0) {
                قاعدة_كومة_الآلة := العنوان;
                نهاية_حجز_كومة_الآلة := العنوان + الطول;
                نهاية_تثبيت_كومة_الآلة := العنوان;
                أرجع العنوان;
            };
            الطول := الطول / 2;
        }
        أرجع 0;
    }

    // Commits the reserved range up to النهاية, 4 MiB at a time at least.
    عرف اضمن_كومة_مخصص(النهاية: ط64): منطقي {
        لو (قاعدة_كومة_الآلة == 0 || النهاية > نهاية_حجز_كومة_الآلة) { أرجع خطأ; };
        لو (النهاية <= نهاية_تثبيت_كومة_الآلة) { أرجع صواب; };
        دع الهدف_الجديد: متغير ط64 = (النهاية + 4194303) / 4194304 * 4194304;
        لو (الهدف_الجديد > نهاية_حجز_كومة_الآلة) { الهدف_الجديد := نهاية_حجز_كومة_الآلة; };
        لو (!ثبت_صفحات_كومة_الآلة(نهاية_تثبيت_كومة_الآلة, الهدف_الجديد - نهاية_تثبيت_كومة_الآلة)) {
            أرجع خطأ;
        };
        نهاية_تثبيت_كومة_الآلة := الهدف_الجديد;
        أرجع صواب;
    }

    // These counters describe class block sizes, not requested payload sizes.
    // Eligible = whole free-block interior ranges, including advice failures.
    // Reclaimed = successful OS reclaim requests, not a measured RSS reduction.
    دع بايتات_كتل_حية_المخصص: متغير ط64 = 0;
    دع بايتات_كتل_حرة_المخصص: متغير ط64 = 0;
    دع بايتات_قابلة_للاسترداد_المخصص: متغير ط64 = 0;
    دع بايتات_مستردة_المخصص: متغير ط64 = 0;

    // 64 KiB alignment is a multiple of the page sizes of the registered
    // native targets, including 16 KiB Darwin and 64 KiB AArch64 Linux.
    // Never release a page holding a block header, the two list links at the
    // start of a free large block's payload or its last word.
    عرف بداية_استرداد_مخصص(الكتلة: ط64): ط64 {
        أرجع (الكتلة + 2 * كلمة_المخصص() + 65535) / 65536 * 65536;
    }
    عرف نهاية_استرداد_مخصص(الكتلة: ط64, الحجم: ط64): ط64 {
        أرجع (الكتلة - 8 + الحجم - كلمة_المخصص()) / 65536 * 65536;
    }
    عرف حجم_استرداد_مخصص(الكتلة: ط64, الحجم: ط64): ط64 {
        لو (!كتلة_كبيرة_مخصص(الحجم)) { أرجع 0; };
        دع البداية: ط64 = بداية_استرداد_مخصص(الكتلة);
        دع النهاية: ط64 = نهاية_استرداد_مخصص(الكتلة, الحجم);
        لو (النهاية <= البداية) { أرجع 0; };
        أرجع النهاية - البداية;
    }

    // These helpers change only accounting and free-block page ownership.
    // All allocator list operations remain in the shared owner below.
    عرف أضف_حيا_مخصص(البايتات: ط64): فراغ {
        بايتات_كتل_حية_المخصص := بايتات_كتل_حية_المخصص + البايتات;
    }
    عرف انقص_حيا_مخصص(البايتات: ط64): فراغ {
        بايتات_كتل_حية_المخصص := بايتات_كتل_حية_المخصص - البايتات;
    }
    // A block that has just been listed free: return its interior pages.
    عرف أدرج_حرة_مخصص(الكتلة: ط64, الحجم: ط64): فراغ {
        دع حجم_الصفحات: ط64 = حجم_استرداد_مخصص(الكتلة, الحجم);
        بايتات_كتل_حرة_المخصص := بايتات_كتل_حرة_المخصص + الحجم;
        بايتات_قابلة_للاسترداد_المخصص := بايتات_قابلة_للاسترداد_المخصص + حجم_الصفحات;
        لو (حجم_الصفحات != 0 && استرد_صفحات_كومة_الآلة(بداية_استرداد_مخصص(الكتلة), حجم_الصفحات)) {
            // The header survives reclamation and identifies the blocks
            // whose pages really were released/advised to the platform.
            اكتب_رأس_مخصص(الكتلة, فئة_رأس_مخصص(الكتلة), وسم_كتلة_مستردة());
            بايتات_مستردة_المخصص := بايتات_مستردة_المخصص + حجم_الصفحات;
        };
    }
    // A free block leaving its list: to be used (its pages recommitted
    // first; false when that fails, with nothing changed) or merged.
    عرف أخرج_حرة_مخصص(الكتلة: ط64, الحجم: ط64, للاستعمال: منطقي): منطقي {
        دع حجم_الصفحات: ط64 = حجم_استرداد_مخصص(الكتلة, الحجم);
        لو (للاستعمال && !أعد_تثبيت_استرداد_مخصص(بداية_استرداد_مخصص(الكتلة), حجم_الصفحات)) {
            أرجع خطأ;
        };
        بايتات_كتل_حرة_المخصص := بايتات_كتل_حرة_المخصص - الحجم;
        بايتات_قابلة_للاسترداد_المخصص := بايتات_قابلة_للاسترداد_المخصص - حجم_الصفحات;
        لو (وسم_رأس_مخصص(الكتلة) == وسم_كتلة_مستردة()) {
            بايتات_مستردة_المخصص := بايتات_مستردة_المخصص - حجم_الصفحات;
        };
        أرجع صواب;
    }
    // The top fell to القمة: once the committed end is 8 MiB above it, return
    // the pages above the next 4 MiB boundary (committing restarts there).
    عرف قلص_القمة_مخصص(القمة: ط64): فراغ {
        دع الحد: ط64 = (القمة + 4194303) / 4194304 * 4194304;
        لو (نهاية_تثبيت_كومة_الآلة <= الحد) { أرجع; };
        لو (نهاية_تثبيت_كومة_الآلة - الحد < 8388608) { أرجع; };
        لو (استرد_صفحات_كومة_الآلة(الحد, نهاية_تثبيت_كومة_الآلة - الحد)) {
            نهاية_تثبيت_كومة_الآلة := الحد;
        };
    }

    // Nonallocating instrumentation for an external RSS/profiling harness.
    عام عرف بايتات_حية_مخصص_النظام(): ط64 { أرجع بايتات_كتل_حية_المخصص; }
    عام عرف بايتات_حرة_مخصص_النظام(): ط64 { أرجع بايتات_كتل_حرة_المخصص; }
    عام عرف بايتات_قابلة_لاسترداد_مخصص_النظام(): ط64 { أرجع بايتات_قابلة_للاسترداد_المخصص; }
    عام عرف بايتات_مستردة_مخصص_النظام(): ط64 { أرجع بايتات_مستردة_المخصص; }
    عام عرف بايتات_مثبتة_مخصص_النظام(): ط64 {
        لو (قاعدة_كومة_الآلة == 0) { أرجع 0; };
        دع المدى: ط64 = نهاية_تثبيت_كومة_الآلة - قاعدة_كومة_الآلة;
        // POSIX madvise drops physical pages but retains an RW mapping;
        // only Win32 MEM_DECOMMIT subtracts from committed address space.
        أرجع احسب_بايتات_مثبتة_مخصص(المدى);
    }

}

// The allocation entry points the backends call take and return
