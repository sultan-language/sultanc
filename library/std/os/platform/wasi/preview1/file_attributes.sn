استورد os.path;
استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// Links, file sizes and file times through WASI preview 1 (witx). Paths are
// resolved against the preopened directories (حل_مسار_واسي). WASI has no
// permission bits and no working directory to change.
خارجي «wasi_snapshot_preview1» عرف path_symlink(
    الهدف: *ط8, طول_الهدف: ط32, الدليل: ط32, المسار: *ط8, طول_المسار: ط32
): ص32;
خارجي «wasi_snapshot_preview1» عرف path_readlink(
    الدليل: ط32, المسار: *ط8, طول_المسار: ط32, المخزن: *متغير ط8, طول_المخزن: ط32,
    المستخدم: *متغير ط32
): ص32;
خارجي «wasi_snapshot_preview1» عرف path_link(
    دليل_الأصل: ط32, أعلام_الأصل: ط32, الأصل: *ط8, طول_الأصل: ط32,
    دليل_الجديد: ط32, الجديد: *ط8, طول_الجديد: ط32
): ص32;
خارجي «wasi_snapshot_preview1» عرف fd_filestat_set_size(الواصف: ط32, الحجم: ط64): ص32;
// fstflags: atim 1, atim_now 2, mtim 4, mtim_now 8.
خارجي «wasi_snapshot_preview1» عرف path_filestat_set_times(
    الدليل: ط32, الأعلام: ط32, المسار: *ط8, طول_المسار: ط32,
    الوصول: ط64, التعديل: ط64, أعلام_الأوقات: ط16
): ص32;

// The target text is stored as given; only the link path is resolved.
عام عرف أنشئ_وصلة_رمزية_واسي(
    الهدف_المرجعي: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_واصف_واسي {
    إذا (الطول(*الهدف_المرجعي) == 0) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح()); };
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه ط8 = &المحلول.النسبي;
        دع الرمز: ص32 = path_symlink(
            &(*الهدف_المرجعي)[0], الطول(*الهدف_المرجعي) مثل ط32,
            المحلول.الدليل, &(*الاسم)[0], الطول(*الاسم) مثل ط32
        );
        إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف اقرأ_وصلة_رمزية_واسي(
    المسار: &متجه ط8
): نتيجة متجه ط8, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه ط8 = &المحلول.النسبي;
        دع السعة: متغير طبيعي = 256;
        طالما (السعة <= 1048576) {
            دع المخزن: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < السعة) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
            دع المستخدم: متغير متجه ط32 = [0];
            دع الرمز: ص32 = path_readlink(
                المحلول.الدليل, &(*الاسم)[0], الطول(*الاسم) مثل ط32,
                &متغير المخزن[0], السعة مثل ط32, &متغير المستخدم[0]
            );
            إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
            إذا ((المستخدم[0] مثل طبيعي) < السعة) {
                دع الناتج: متغير متجه ط8 = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < (المستخدم[0] مثل طبيعي)) { ألحق(الناتج, المخزن[ح]); ح := ح + 1; }
                أرجع نتيجة.نجح(الناتج);
            };
            السعة := السعة * 4;
        }
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
}

// lookupflags 0: a symlink source is linked itself, not followed.
عام عرف أنشئ_وصلة_صلبة_واسي(
    الأصل: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(محلول_الأصل) -> {
        طابق حل_مسار_واسي(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(محلول_الجديد) -> {
            دع اسم_الأصل: &متجه ط8 = &محلول_الأصل.النسبي;
            دع اسم_الجديد: &متجه ط8 = &محلول_الجديد.النسبي;
            دع الرمز: ص32 = path_link(
                محلول_الأصل.الدليل, 0, &(*اسم_الأصل)[0], الطول(*اسم_الأصل) مثل ط32,
                محلول_الجديد.الدليل, &(*اسم_الجديد)[0], الطول(*اسم_الجديد) مثل ط32
            );
            إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
            أرجع نتيجة.نجح(0);
        };
    };
}

عام عرف اقتطع_واصف_واسي(
    الواصف: &واصف_ملف_واسي, الطول: ط64
): نتيجة ط64, خطأ_واصف_واسي {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    دع الرمز: ص32 = fd_filestat_set_size((*الواصف).القيمة, الطول);
    إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}

// Timestamps are u64 nanoseconds since the Unix epoch; lookupflags
// symlink_follow (1), fstflags atim|mtim (5).
عام عرف اضبط_أوقات_مسار_واسي(
    المسار: &متجه ط8, ثواني_الوصول: ص64, نانو_الوصول: ط64,
    ثواني_التعديل: ص64, نانو_التعديل: ط64
): نتيجة ط64, خطأ_واصف_واسي {
    إذا (ثواني_الوصول < 0 || ثواني_التعديل < 0
        || نانو_الوصول >= 1000000000 || نانو_التعديل >= 1000000000
        || ثواني_الوصول > 18446744073 || ثواني_التعديل > 18446744073) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه ط8 = &المحلول.النسبي;
        دع الوصول: ط64 = (ثواني_الوصول مثل ط64) * 1000000000 + نانو_الوصول;
        دع التعديل: ط64 = (ثواني_التعديل مثل ط64) * 1000000000 + نانو_التعديل;
        دع الرمز: ص32 = path_filestat_set_times(
            المحلول.الدليل, 1, &(*الاسم)[0], الطول(*الاسم) مثل ط32,
            الوصول, التعديل, 5
        );
        إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        أرجع نتيجة.نجح(0);
    };
}

// path_open with oflags creat|excl (5): fails with EEXIST if the path
// exists. Rights: fd_datasync, fd_read, fd_seek, fd_sync, fd_tell,
// fd_write, fd_filestat_get, fd_filestat_set_size (0x600077).
عام عرف أنشئ_ملفا_جديدا_واسي(المسار: &متجه ط8): نتيجة واصف_ملف_واسي, خطأ_واصف_واسي {
    أرجع افتح_بأعلام_واسي(المسار, 5, 0x600077);
}

// An existing file for writing and resizing (fd_write | fd_seek | fd_tell |
// fd_filestat_set_size), not truncated.
عام عرف افتح_ملفا_للتعديل_واسي(المسار: &متجه ط8): نتيجة واصف_ملف_واسي, خطأ_واصف_واسي {
    أرجع افتح_بأعلام_واسي(المسار, 0, 0x400064);
}

عرف افتح_بأعلام_واسي(
    المسار: &متجه ط8, أعلام_الفتح: ط16, الحقوق: ط64
): نتيجة واصف_ملف_واسي, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه ط8 = &المحلول.النسبي;
        دع الناتج: متغير متجه ط32 = [0];
        دع الرمز: ص32 = path_open(
            المحلول.الدليل, 1, &(*الاسم)[0], الطول(*الاسم) مثل ط32, أعلام_الفتح,
            الحقوق, 0, 0, &متغير الناتج[0]
        );
        إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        دع الواصف: واصف_ملف_واسي = { القيمة: الناتج[0], مفتوح: صواب };
        أرجع نتيجة.نجح(الواصف);
    };
}
