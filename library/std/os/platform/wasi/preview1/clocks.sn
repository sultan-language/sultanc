استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 clocks: clock_time_get(realtime 0 | monotonic 1) returns
// nanoseconds. Sleeping is poll_oneoff with one relative clock subscription
// (48-byte subscription; 32-byte event record), the only blocking primitive.
خارجي عرف clock_time_get(المعرف: غ32, الدقة: غ64, الوقت: *متغير غ64): ص32;
خارجي عرف poll_oneoff(
    الاشتراكات: *غ8, الأحداث: *متغير غ8, العدد: غ32, الحاصل: *متغير غ32
): ص32;

عام عرف اقرأ_ساعة_واسي(رتيب: منطقي): نتيجة غ64, خطأ_واصف_واسي {
    دع الوقت: متغير متجه غ64 = [0];
    دع المعرف: متغير غ32 = 0;
    لو (رتيب) { المعرف := 1; };
    دع الرمز: ص32 = clock_time_get(المعرف, 1, &متغير الوقت[0]);
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(الوقت[0]);
}

عرف اكتب_غ64_واسي(المخزن: &متغير متجه غ8, البداية: غير_موقع, القيمة: غ64): فراغ {
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 8) {
        (*المخزن)[البداية + ف] := ((القيمة >> ((ف * 8) مثل غ64)) & 255) مثل غ8;
        ف := ف + 1;
    }
}

// subscription: userdata u64 @0, tag u8 @8 (0 = clock), clock id u32 @16,
// timeout u64 @24, precision u64 @32, flags u16 @40 (0 = relative).
عام عرف نم_واسي(النانو: غ64): نتيجة غ64, خطأ_واصف_واسي {
    دع الاشتراك: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < 48) { ألحق(الاشتراك, 0 مثل غ8); ف := ف + 1; }
    الاشتراك[16] := 1;
    اكتب_غ64_واسي(&متغير الاشتراك, 24, النانو);
    دع الحدث: متغير متجه غ8 = [];
    ف := 0;
    بينما (ف < 32) { ألحق(الحدث, 0 مثل غ8); ف := ف + 1; }
    دع الحاصل: متغير متجه غ32 = [0];
    دع الرمز: ص32 = poll_oneoff(&الاشتراك[0], &متغير الحدث[0], 1, &متغير الحاصل[0]);
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}
