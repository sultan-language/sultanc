استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 clocks: clock_time_get(realtime 0 | monotonic 1) returns
// nanoseconds. Sleeping is poll_oneoff with one relative clock subscription
// (48-byte subscription; 32-byte event record), the only blocking primitive.
خارجي «wasi_snapshot_preview1» عرف clock_time_get(المعرف: ط32, الدقة: ط64, الوقت: *متغير ط64): ص32;
خارجي «wasi_snapshot_preview1» عرف poll_oneoff(
    الاشتراكات: *ط8, الأحداث: *متغير ط8, العدد: ط32, الحاصل: *متغير ط32
): ص32;

عام عرف اقرأ_ساعة_واسي(رتيب: منطقي): نتيجة ط64, خطأ_واصف_واسي {
    دع الوقت: متغير متجه ط64 = [0];
    دع المعرف: متغير ط32 = 0;
    لو (رتيب) { المعرف := 1; };
    دع الرمز: ص32 = clock_time_get(المعرف, 1, &متغير الوقت[0]);
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(الوقت[0]);
}

عرف اكتب_ط64_واسي(المخزن: &متغير متجه ط8, البداية: طبيعي, القيمة: ط64): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < 8) {
        (*المخزن)[البداية + ف] := ((القيمة >> ((ف * 8) مثل ط64)) & 255) مثل ط8;
        ف := ف + 1;
    }
}

// subscription: userdata u64 @0, tag u8 @8 (0 = clock), clock id u32 @16,
// timeout u64 @24, precision u64 @32, flags u16 @40 (0 = relative).
عام عرف نم_واسي(النانو: ط64): نتيجة ط64, خطأ_واصف_واسي {
    دع الاشتراك: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 48) { ألحق(الاشتراك, 0 مثل ط8); ف := ف + 1; }
    الاشتراك[16] := 1;
    اكتب_ط64_واسي(&متغير الاشتراك, 24, النانو);
    دع الحدث: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < 32) { ألحق(الحدث, 0 مثل ط8); ف := ف + 1; }
    دع الحاصل: متغير متجه ط32 = [0];
    دع الرمز: ص32 = poll_oneoff(&الاشتراك[0], &متغير الحدث[0], 1, &متغير الحاصل[0]);
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}
