استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 random_get fills the buffer from the host's CSPRNG
// (the specification requires cryptographically secure output).
خارجي عرف random_get(المخزن: *متغير غ8, الحجم: غ32): ص32;

عام عرف املأ_عشوائية_واسي(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_واصف_واسي {
    دع البايتات: متغير متجه غ8 = *المخزن;
    دع الحجم: غير_موقع = الطول(البايتات) مثل غير_موقع;
    دع المكتمل: متغير غير_موقع = 0;
    بينما (المكتمل < الحجم) {
        دع الجزء: متغير غير_موقع = الحجم - المكتمل;
        لو (الجزء > 65536) { الجزء := 65536; };
        دع الرمز: ص32 = random_get(&متغير البايتات[المكتمل], الجزء مثل غ32);
        لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        المكتمل := المكتمل + الجزء;
    }
    *المخزن := البايتات;
    أرجع نتيجة.نجح(الحجم);
}
