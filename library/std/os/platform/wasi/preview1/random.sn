استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 random_get fills the buffer from the host's CSPRNG
// (the specification requires cryptographically secure output).
خارجي «wasi_snapshot_preview1» عرف random_get(المخزن: *متغير ط8, الحجم: ط32): ص32;

عام عرف املأ_عشوائية_واسي(المخزن: &متغير متجه ط8): نتيجة طبيعي, خطأ_واصف_واسي {
    دع الحجم: طبيعي = الطول(*المخزن) مثل طبيعي;
    دع المكتمل: متغير طبيعي = 0;
    طالما (المكتمل < الحجم) {
        دع الجزء: متغير طبيعي = الحجم - المكتمل;
        إذا (الجزء > 65536) { الجزء := 65536; };
        دع الرمز: ص32 = random_get(&متغير (*المخزن)[المكتمل], الجزء مثل ط32);
        إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        المكتمل := المكتمل + الجزء;
    }
    أرجع نتيجة.نجح(الحجم);
}
