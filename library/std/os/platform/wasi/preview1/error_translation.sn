استورد os.error;

// WASI preview 1 errno values (wasi_snapshot_preview1 `errno` enumeration);
// they differ from every Unix numbering and are never borrowed from one.
عام عرف صنف_خطأ_واسي_أساسيا(الرمز: عدد): صنف_خطأ_نظام {
    إذا (الرمز == 44) { أرجع صنف_خطأ_نظام.غير_موجود(); }; // NOENT
    إذا (الرمز == 27) { أرجع صنف_خطأ_نظام.عملية_انقطعت(); }; // INTR
    إذا (الرمز == 48) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // NOMEM
    إذا (الرمز == 2) { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }; // ACCES
    إذا (الرمز == 63) { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }; // PERM
    إذا (الرمز == 76) { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }; // NOTCAPABLE
    إذا (الرمز == 10) { أرجع صنف_خطأ_نظام.مورد_مشغول(); }; // BUSY
    إذا (الرمز == 20) { أرجع صنف_خطأ_نظام.موجود_مسبقا(); }; // EXIST
    إذا (الرمز == 54) { أرجع صنف_خطأ_نظام.ليس_دليلا(); }; // NOTDIR
    إذا (الرمز == 31) { أرجع صنف_خطأ_نظام.هو_دليل(); }; // ISDIR
    إذا (الرمز == 28) { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); }; // INVAL
    إذا (الرمز == 8) { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); }; // BADF
    إذا (الرمز == 41) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // NFILE
    إذا (الرمز == 33) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // MFILE
    إذا (الرمز == 51) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // NOSPC
    إذا (الرمز == 6) { أرجع صنف_خطأ_نظام.عملية_ستحظر(); }; // AGAIN
    إذا (الرمز == 73) { أرجع صنف_خطأ_نظام.انتهت_المهلة(); }; // TIMEDOUT
    إذا (الرمز == 14) { أرجع صنف_خطأ_نظام.اتصال_مرفوض(); }; // CONNREFUSED
    إذا (الرمز == 52) { أرجع صنف_خطأ_نظام.غير_مدعوم(); }; // NOSYS
    إذا (الرمز == 58) { أرجع صنف_خطأ_نظام.غير_مدعوم(); }; // NOTSUP
    أرجع صنف_خطأ_نظام.غير_معروف();
}
