استورد os.buffer;
استورد os.path;
استورد os.error;

// WASI preview 1 (wasm32) file-descriptor provider. Every function below is a
// host import from the target's system interface module wasi_snapshot_preview1
// (bound by the target owner) and returns a WASI errno, 0 meaning success.
// WASI has no ambient filesystem: every path is opened relative to a
// directory the host preopened (descriptors 3, 4, ... described by
// fd_prestat_get). Only this provider dereferences the ABI records.
//
// Records (wasm32, little-endian): iovec {buf u32, len u32}; prestat
// {tag u8 @0, name_len u32 @4}; filestat {filetype u8 @16, size u64 @32,
// mtim u64 @48} (64 bytes); dirent {d_next u64 @0, d_namlen u32 @16,
// d_type u8 @20} followed by the name (header 24 bytes).
عام نوع مقطع_قراءة_واسي = { المؤشر: *متغير غ8, الطول: غ32 };
عام نوع مقطع_كتابة_واسي = { المؤشر: *غ8, الطول: غ32 };

خارجي عرف fd_read(الواصف: غ32, المقاطع: *مقطع_قراءة_واسي, العدد: غ32, المقروء: *متغير غ32): ص32;
خارجي عرف fd_write(الواصف: غ32, المقاطع: *مقطع_كتابة_واسي, العدد: غ32, المكتوب: *متغير غ32): ص32;
خارجي عرف fd_close(الواصف: غ32): ص32;
خارجي عرف fd_seek(الواصف: غ32, الإزاحة: ص64, الأصل: غ8, الموضع: *متغير غ64): ص32;
خارجي عرف fd_sync(الواصف: غ32): ص32;
خارجي عرف fd_prestat_get(الواصف: غ32, الحالة: *متغير غ8): ص32;
خارجي عرف fd_prestat_dir_name(الواصف: غ32, الاسم: *متغير غ8, الطول: غ32): ص32;
خارجي عرف path_open(
    الدليل: غ32, أعلام_الدليل: غ32, المسار: *غ8, طول_المسار: غ32, أعلام_الفتح: غ16,
    الحقوق: غ64, الحقوق_الموروثة: غ64, أعلام_الواصف: غ16, الواصف: *متغير غ32
): ص32;
خارجي عرف path_filestat_get(
    الدليل: غ32, الأعلام: غ32, المسار: *غ8, طول_المسار: غ32, المعلومات: *متغير غ8
): ص32;
خارجي عرف path_unlink_file(الدليل: غ32, المسار: *غ8, طول_المسار: غ32): ص32;
خارجي عرف path_rename(
    الدليل: غ32, الأصل: *غ8, طول_الأصل: غ32,
    دليل_الوجهة: غ32, الوجهة: *غ8, طول_الوجهة: غ32
): ص32;
خارجي عرف path_create_directory(الدليل: غ32, المسار: *غ8, طول_المسار: غ32): ص32;
خارجي عرف path_remove_directory(الدليل: غ32, المسار: *غ8, طول_المسار: غ32): ص32;
خارجي عرف fd_readdir(
    الدليل: غ32, المخزن: *متغير غ8, الطول: غ32, المؤشر_التالي: غ64, المستخدم: *متغير غ32
): ص32;

عام نوع خطأ_واصف_واسي =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | واصف_مغلق
    | خارج_الأدلة_المفتوحة
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع واصف_ملف_واسي = { القيمة: غ64, مفتوح: منطقي };

// The single WASI mapping onto the portable std.os boundary error. A path
// outside every preopened directory does not exist for this instance.
عام عرف خطأ_واصف_واسي_للنظام(الخطأ: خطأ_واصف_واسي): خطأ_حد_نظام {
    طابق الخطأ مع
    | خطأ_واصف_واسي.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_واسي.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_واسي.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
    | خطأ_واصف_واسي.خارج_الأدلة_المفتوحة -> { أرجع خطأ_حد_نظام.غير_موجود(); }
    | خطأ_واصف_واسي.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
}

عام عرف خطأ_رقم_واسي(الرمز: ص32): خطأ_واصف_واسي {
    أرجع خطأ_واصف_واسي.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.واسي(), الرمز مثل عدد));
}

عرف اقرأ_غ32_واسي(البايتات: &متجه غ8, البداية: غير_موقع): غ64 {
    دع الناتج: متغير غ64 = 0;
    دع ف: متغير غير_موقع = 4;
    بينما (ف > 0) {
        ف := ف - 1;
        الناتج := (الناتج << 8) | ((*البايتات)[البداية + ف] مثل غ64);
    }
    أرجع الناتج;
}

عرف اقرأ_غ64_واسي(البايتات: &متجه غ8, البداية: غير_موقع): غ64 {
    دع الناتج: متغير غ64 = 0;
    دع ف: متغير غير_موقع = 8;
    بينما (ف > 0) {
        ف := ف - 1;
        الناتج := (الناتج << 8) | ((*البايتات)[البداية + ف] مثل غ64);
    }
    أرجع الناتج;
}

عرف مخزن_أصفار_واسي(الحجم: غير_موقع): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق(الناتج, 0 مثل غ8); ف := ف + 1; }
    أرجع الناتج;
}

// --- Preopened directories ---------------------------------------------------

// The name of preopened directory `الواصف`, or nothing when the descriptor is
// not a preopened directory. A trailing NUL some hosts include is dropped.
عرف اسم_دليل_مفتوح_واسي(الواصف: غ32): اختيار متجه غ8 {
    دع الحالة: متغير متجه غ8 = مخزن_أصفار_واسي(8);
    لو (fd_prestat_get(الواصف, &متغير الحالة[0]) != 0) { أرجع اختيار.لا_شيء(); };
    لو (الحالة[0] != 0) { أرجع اختيار.لا_شيء(); };
    دع طول_الاسم: غ64 = اقرأ_غ32_واسي(&الحالة, 4);
    لو (طول_الاسم > 4096) { أرجع اختيار.لا_شيء(); };
    دع الاسم: متغير متجه غ8 = [];
    لو (طول_الاسم > 0) {
        الاسم := مخزن_أصفار_واسي(طول_الاسم مثل غير_موقع);
        لو (fd_prestat_dir_name(الواصف, &متغير الاسم[0], طول_الاسم مثل غ32) != 0) {
            أرجع اختيار.لا_شيء();
        };
    };
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < (الطول(الاسم) مثل غير_موقع) && الاسم[ف] != 0) {
        ألحق(الناتج, الاسم[ف]);
        ف := ف + 1;
    }
    أرجع اختيار.بعض(الناتج);
}

// The descriptor (inside its directory) that a path names.
عام نوع مسار_محلول_واسي = { الدليل: غ32, النسبي: متجه غ8 };

// `الاسم` without trailing '/' (keeping "/" itself) and without a leading
// "./"; "." and "" both name the current directory.
عرف اسم_دليل_مقنن_واسي(الاسم: &متجه غ8): متجه غ8 {
    دع البداية: متغير غير_موقع = 0;
    دع النهاية: متغير غير_موقع = الطول(*الاسم) مثل غير_موقع;
    بينما (النهاية > 1 && (*الاسم)[النهاية - 1] == 0x2F) { النهاية := النهاية - 1; }
    بينما ((النهاية - البداية) >= 2 && (*الاسم)[البداية] == 0x2E
        && (*الاسم)[البداية + 1] == 0x2F) {
        البداية := البداية + 2;
    }
    دع الناتج: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = البداية;
    بينما (ف < النهاية) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
    لو ((الطول(الناتج) مثل غير_موقع) == 0) { ألحق(الناتج, 0x2E); };
    أرجع الناتج;
}

// Length of the part of `المسار` covered by directory name `الاسم`, or
// nothing when the directory does not contain the path. A match ends at the
// path's end or at a '/' separator.
عرف طول_تطابق_دليل_واسي(الاسم: &متجه غ8, المسار: &متجه غ8): اختيار غير_موقع {
    دع طول_الاسم: غير_موقع = الطول(*الاسم) مثل غير_موقع;
    دع طول_المسار: غير_موقع = الطول(*المسار) مثل غير_موقع;
    لو (طول_الاسم == 1 && (*الاسم)[0] == 0x2F) {
        لو (طول_المسار > 0 && (*المسار)[0] == 0x2F) { أرجع اختيار.بعض(1); };
        أرجع اختيار.لا_شيء();
    };
    لو (طول_الاسم == 1 && (*الاسم)[0] == 0x2E) {
        لو (طول_المسار > 0 && (*المسار)[0] == 0x2F) { أرجع اختيار.لا_شيء(); };
        أرجع اختيار.بعض(0);
    };
    لو (طول_الاسم > طول_المسار) { أرجع اختيار.لا_شيء(); };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < طول_الاسم) {
        لو ((*الاسم)[ف] != (*المسار)[ف]) { أرجع اختيار.لا_شيء(); };
        ف := ف + 1;
    }
    لو (طول_الاسم < طول_المسار && (*المسار)[طول_الاسم] != 0x2F) {
        أرجع اختيار.لا_شيء();
    };
    أرجع اختيار.بعض(طول_الاسم);
}

// Resolve `المسار` against the preopened directories, choosing the longest
// containing directory name (as wasi-libc does). A relative path is taken
// relative to a "." preopen when one exists, otherwise relative to "/".
عام عرف حل_مسار_واسي(المسار: &متجه غ8): نتيجة مسار_محلول_واسي, خطأ_واصف_واسي {
    دع العدد: غير_موقع = الطول(*المسار) مثل غير_موقع;
    لو (العدد == 0) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    دع ف: متغير غير_موقع = 0;
    بينما (ف < العدد) {
        لو ((*المسار)[ف] == 0) {
            أرجع نتيجة.خطأ(خطأ_واصف_واسي.مسار(خطأ_مسار_نظام.صفر_مدمج()));
        };
        ف := ف + 1;
    }
    دع المقنن: متجه غ8 = اسم_دليل_مقنن_واسي(المسار);
    دع المطلق: متغير متجه غ8 = [];
    لو (المقنن[0] != 0x2F) {
        ألحق(المطلق, 0x2F);
    };
    ف := 0;
    بينما (ف < (الطول(المقنن) مثل غير_موقع)) { ألحق(المطلق, المقنن[ف]); ف := ف + 1; }

    دع وجد: متغير منطقي = خطأ;
    دع أفضل_دليل: متغير غ32 = 0;
    دع أفضل_طول: متغير غير_موقع = 0;
    دع أفضل_نقطة: متغير منطقي = خطأ;
    دع الواصف: متغير غ32 = 3;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر && الواصف < 1024) {
        دع الحالة: متغير متجه غ8 = مخزن_أصفار_واسي(8);
        دع الرمز: ص32 = fd_prestat_get(الواصف, &متغير الحالة[0]);
        لو (الرمز == 8) {
            // EBADF: no further preopened descriptors.
            مستمر := خطأ;
        } وإلا {
            طابق اسم_دليل_مفتوح_واسي(الواصف) مع
            | اختيار.لا_شيء -> { }
            | اختيار.بعض(الاسم_الخام) -> {
                دع الاسم: متجه غ8 = اسم_دليل_مقنن_واسي(&الاسم_الخام);
                دع نقطة: منطقي = (الطول(الاسم) مثل غير_موقع) == 1 && الاسم[0] == 0x2E;
                لو (نقطة && المقنن[0] != 0x2F) {
                    لو (!وجد || !أفضل_نقطة) {
                        وجد := صواب;
                        أفضل_نقطة := صواب;
                        أفضل_دليل := الواصف;
                        أفضل_طول := 0;
                    };
                } وإلا لو (!نقطة && !أفضل_نقطة) {
                    // Directory names are matched against the absolute form.
                    دع الاسم_المطلق: متغير متجه غ8 = [];
                    لو (الاسم[0] != 0x2F) { ألحق(الاسم_المطلق, 0x2F); };
                    دع ح: متغير غير_موقع = 0;
                    بينما (ح < (الطول(الاسم) مثل غير_موقع)) {
                        ألحق(الاسم_المطلق, الاسم[ح]);
                        ح := ح + 1;
                    }
                    طابق طول_تطابق_دليل_واسي(&الاسم_المطلق, &المطلق) مع
                    | اختيار.لا_شيء -> { }
                    | اختيار.بعض(الطول_المطابق) -> {
                        لو (!وجد || الطول_المطابق > أفضل_طول) {
                            وجد := صواب;
                            أفضل_دليل := الواصف;
                            أفضل_طول := الطول_المطابق;
                        };
                    };
                };
            };
        };
        الواصف := الواصف + 1;
    }
    لو (!وجد) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.خارج_الأدلة_المفتوحة()); };

    دع المصدر: متغير متجه غ8 = المطلق;
    لو (أفضل_نقطة) { المصدر := المقنن; };
    دع النسبي: متغير متجه غ8 = [];
    ف := أفضل_طول;
    بينما (ف < (الطول(المصدر) مثل غير_موقع) && المصدر[ف] == 0x2F) { ف := ف + 1; }
    بينما (ف < (الطول(المصدر) مثل غير_موقع)) { ألحق(النسبي, المصدر[ف]); ف := ف + 1; }
    لو ((الطول(النسبي) مثل غير_موقع) == 0) { ألحق(النسبي, 0x2E); };
    دع الناتج: مسار_محلول_واسي = { الدليل: أفضل_دليل, النسبي: النسبي };
    أرجع نتيجة.نجح(الناتج);
}

// --- Descriptors ---------------------------------------------------------------

// Rights (WASI preview 1): fd_datasync 1, fd_read 2, fd_seek 4, fd_sync 16,
// fd_tell 32, fd_write 64, fd_readdir 1<<14, fd_filestat_get 1<<21.
// oflags: creat 1, directory 2, trunc 8. lookupflags: symlink_follow 1.
عرف افتح_محلولا_واسي(
    المحلول: &مسار_محلول_واسي, أعلام_الفتح: غ16, الحقوق: غ64
): نتيجة واصف_ملف_واسي, خطأ_واصف_واسي {
    دع الاسم: &متجه غ8 = &(*المحلول).النسبي;
    دع الناتج: متغير متجه غ32 = [0];
    دع الرمز: ص32 = path_open(
        (*المحلول).الدليل, 1, &(*الاسم)[0], الطول(*الاسم) مثل غ32, أعلام_الفتح,
        الحقوق, 0, 0, &متغير الناتج[0]
    );
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    دع الواصف: واصف_ملف_واسي = { القيمة: الناتج[0] مثل غ64, مفتوح: صواب };
    أرجع نتيجة.نجح(الواصف);
}

عام عرف افتح_واصف_واسي(
    المسار: &متجه غ8, للكتابة: منطقي
): نتيجة واصف_ملف_واسي, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        لو (للكتابة) {
            أرجع افتح_محلولا_واسي(&المحلول, 9, 2097271);
        };
        أرجع افتح_محلولا_واسي(&المحلول, 0, 2097190);
    };
}

عام عرف اقرأ_واصف_واسي(
    الواصف: &واصف_ملف_واسي, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_واسي {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المقطع: مقطع_قراءة_واسي = {
        المؤشر: &متغير (*المخزن)[الإزاحة مثل غير_موقع], الطول: الطلب مثل غ32
    };
    دع المقاطع: متجه مقطع_قراءة_واسي = [المقطع];
    دع المقروء: متغير متجه غ32 = [0];
    دع الرمز: ص32 = fd_read(
        (*الواصف).القيمة مثل غ32, &المقاطع[0], 1, &متغير المقروء[0]
    );
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(المقروء[0] مثل غ64);
}

عام عرف اكتب_واصف_واسي(
    الواصف: &واصف_ملف_واسي, المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_واسي {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المقطع: مقطع_كتابة_واسي = {
        المؤشر: &(*المحتوى)[الإزاحة مثل غير_موقع], الطول: الطلب مثل غ32
    };
    دع المقاطع: متجه مقطع_كتابة_واسي = [المقطع];
    دع المكتوب: متغير متجه غ32 = [0];
    دع الرمز: ص32 = fd_write(
        (*الواصف).القيمة مثل غ32, &المقاطع[0], 1, &متغير المكتوب[0]
    );
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(المكتوب[0] مثل غ64);
}

// fd_close consumes the descriptor; it is never retried.
عام عرف أغلق_واصف_واسي(
    الواصف: &متغير واصف_ملف_واسي
): نتيجة غ64, خطأ_واصف_واسي {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    دع الرمز: ص32 = fd_close((*الواصف).القيمة مثل غ32);
    (*الواصف).مفتوح := خطأ;
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}

// whence: set 0, cur 1, end 2 (same numbering as the portable origin).
عام عرف حرك_واصف_واسي(
    الواصف: &واصف_ملف_واسي, الإزاحة: ص64, الأصل: غ64
): نتيجة غ64, خطأ_واصف_واسي {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    لو (الأصل > 2) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح()); };
    دع الموضع: متغير متجه غ64 = [0];
    دع الرمز: ص32 = fd_seek(
        (*الواصف).القيمة مثل غ32, الإزاحة, الأصل مثل غ8, &متغير الموضع[0]
    );
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(الموضع[0]);
}

عام عرف زامن_واصف_واسي(الواصف: &واصف_ملف_واسي): نتيجة غ64, خطأ_واصف_واسي {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_واسي.واصف_مغلق()); };
    دع الرمز: ص32 = fd_sync((*الواصف).القيمة مثل غ32);
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}

// Standard streams are descriptors 0, 1 and 2 of every WASI command.
عام عرف اقرأ_دخل_واسي(
    المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_واسي {
    دع الدخل: واصف_ملف_واسي = { القيمة: 0, مفتوح: صواب };
    أرجع اقرأ_واصف_واسي(&الدخل, المخزن, الإزاحة, المطلوب);
}

عام عرف اكتب_تيار_واسي(
    الواصف: غ64, المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_واسي {
    لو (الواصف != 1 && الواصف != 2) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    دع التيار: واصف_ملف_واسي = { القيمة: الواصف, مفتوح: صواب };
    أرجع اكتب_واصف_واسي(&التيار, المحتوى, الإزاحة, المطلوب);
}

// Complete file output: create/truncate, write every byte and close once.
// WASI has no permission bits, so there is no executable mode to set.
عام عرف اكتب_بايتات_كاملة_واسي(
    المسار: &متجه غ8, البايتات: &متجه غ8
): نتيجة غ64, خطأ_واصف_واسي {
    طابق افتح_واصف_واسي(المسار, صواب) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المفتوح) -> {
        دع الواصف: متغير واصف_ملف_واسي = المفتوح;
        دع الكلي: عدد = الطول(*البايتات) مثل عدد;
        دع المكتوب: متغير عدد = 0;
        بينما (المكتوب < الكلي) {
            طابق اكتب_واصف_واسي(&الواصف, البايتات, المكتوب, الكلي - المكتوب) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير الواصف);
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(العدد) -> {
                لو (العدد == 0) {
                    دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير الواصف);
                    أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
                };
                المكتوب := المكتوب + (العدد مثل عدد);
            };
        }
        طابق أغلق_واصف_واسي(&متغير الواصف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الكلي مثل غ64); };
    };
}

// --- Paths -------------------------------------------------------------------

عام عرف أعد_تسمية_واسي(
    الأصل: &متجه غ8, الوجهة: &متجه غ8
): نتيجة غ64, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول_الأصل) -> {
        طابق حل_مسار_واسي(الوجهة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المحلول_الوجهة) -> {
            دع اسم_الأصل: &متجه غ8 = &المحلول_الأصل.النسبي;
            دع اسم_الوجهة: &متجه غ8 = &المحلول_الوجهة.النسبي;
            دع الرمز: ص32 = path_rename(
                المحلول_الأصل.الدليل, &(*اسم_الأصل)[0], الطول(*اسم_الأصل) مثل غ32,
                المحلول_الوجهة.الدليل, &(*اسم_الوجهة)[0], الطول(*اسم_الوجهة) مثل غ32
            );
            لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
            أرجع نتيجة.نجح(0);
        };
    };
}

// العملية: 0 unlink file, 1 create directory, 2 remove directory.
عرف عملية_مسار_واسي(المسار: &متجه غ8, العملية: عدد): نتيجة غ64, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه غ8 = &المحلول.النسبي;
        دع الرمز: متغير ص32 = 0;
        لو (العملية == 0) {
            الرمز := path_unlink_file(المحلول.الدليل, &(*الاسم)[0], الطول(*الاسم) مثل غ32);
        } وإلا لو (العملية == 1) {
            الرمز := path_create_directory(المحلول.الدليل, &(*الاسم)[0], الطول(*الاسم) مثل غ32);
        } وإلا {
            الرمز := path_remove_directory(المحلول.الدليل, &(*الاسم)[0], الطول(*الاسم) مثل غ32);
        };
        لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف احذف_ملف_واسي(المسار: &متجه غ8): نتيجة غ64, خطأ_واصف_واسي {
    أرجع عملية_مسار_واسي(المسار, 0);
}
عام عرف أنشئ_دليل_واسي(المسار: &متجه غ8): نتيجة غ64, خطأ_واصف_واسي {
    أرجع عملية_مسار_واسي(المسار, 1);
}
عام عرف أزل_دليل_واسي(المسار: &متجه غ8): نتيجة غ64, خطأ_واصف_واسي {
    أرجع عملية_مسار_واسي(المسار, 2);
}

// filetype: 3 directory, 4 regular file, 7 symbolic link.
عام نوع معلومات_مسار_واسي = { النوع: غ8, الحجم: غ64, التعديل_بالنانو: غ64 };

عام عرف اقرأ_معلومات_مسار_واسي(
    المسار: &متجه غ8
): نتيجة معلومات_مسار_واسي, خطأ_واصف_واسي {
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        دع الاسم: &متجه غ8 = &المحلول.النسبي;
        دع المخزن: متغير متجه غ8 = مخزن_أصفار_واسي(64);
        دع الرمز: ص32 = path_filestat_get(
            المحلول.الدليل, 1, &(*الاسم)[0], الطول(*الاسم) مثل غ32, &متغير المخزن[0]
        );
        لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
        دع المعلومات: معلومات_مسار_واسي = {
            النوع: المخزن[16],
            الحجم: اقرأ_غ64_واسي(&المخزن, 32),
            التعديل_بالنانو: اقرأ_غ64_واسي(&المخزن, 48)
        };
        أرجع نتيجة.نجح(المعلومات);
    };
}

عام نوع مدخل_دليل_واسي = { الاسم: متجه غ8, النوع: غ8 };

// Lists every entry except "." and "..". fd_readdir fills a buffer from a
// cookie; an entry cut off at the buffer end is fetched again from the
// cookie of the last complete entry, with a larger buffer when one entry
// alone does not fit. The directory descriptor is closed exactly once.
عام عرف اقرأ_مداخل_دليل_واسي(
    المسار: &متجه غ8
): نتيجة متجه مدخل_دليل_واسي, خطأ_واصف_واسي {
    دع المفتوح: متغير واصف_ملف_واسي = { القيمة: 0, مفتوح: خطأ };
    طابق حل_مسار_واسي(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المحلول) -> {
        طابق افتح_محلولا_واسي(&المحلول, 2, 2113536) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الواصف) -> { المفتوح := الواصف; };
    };
    دع الناتج: متغير متجه مدخل_دليل_واسي = [];
    دع السعة: متغير غير_موقع = 4096;
    دع المؤشر_التالي: متغير غ64 = 0;
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع المخزن: متغير متجه غ8 = مخزن_أصفار_واسي(السعة);
        دع المستخدم: متغير متجه غ32 = [0];
        دع الرمز: ص32 = fd_readdir(
            المفتوح.القيمة مثل غ32, &متغير المخزن[0], السعة مثل غ32,
            المؤشر_التالي, &متغير المستخدم[0]
        );
        لو (الرمز != 0) {
            دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير المفتوح);
            أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز));
        };
        دع المملوء: غير_موقع = المستخدم[0] مثل غير_موقع;
        لو (المملوء > السعة) {
            دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير المفتوح);
            أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
        };
        دع الموضع: متغير غير_موقع = 0;
        دع مكتمل_واحد: متغير منطقي = خطأ;
        دع مقطوع: متغير منطقي = خطأ;
        بينما (!مقطوع && الموضع + 24 <= المملوء) {
            دع التالي: غ64 = اقرأ_غ64_واسي(&المخزن, الموضع);
            دع طول_الاسم: غير_موقع = اقرأ_غ32_واسي(&المخزن, الموضع + 16) مثل غير_موقع;
            دع النوع: غ8 = المخزن[الموضع + 20];
            لو (طول_الاسم > 4096) {
                دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير المفتوح);
                أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
            };
            لو (الموضع + 24 + طول_الاسم > المملوء) {
                مقطوع := صواب;
            } وإلا {
                دع الاسم: متغير متجه غ8 = [];
                دع ح: متغير غير_موقع = 0;
                بينما (ح < طول_الاسم) { ألحق(الاسم, المخزن[الموضع + 24 + ح]); ح := ح + 1; }
                دع خاص: منطقي = (طول_الاسم == 1 && الاسم[0] == 0x2E)
                    || (طول_الاسم == 2 && الاسم[0] == 0x2E && الاسم[1] == 0x2E);
                لو (!خاص) {
                    دع المدخل: مدخل_دليل_واسي = { الاسم: الاسم, النوع: النوع };
                    ألحق(الناتج, المدخل);
                };
                المؤشر_التالي := التالي;
                مكتمل_واحد := صواب;
                الموضع := الموضع + 24 + طول_الاسم;
            };
        }
        لو (الموضع < المملوء && !مقطوع) { مقطوع := صواب; };
        لو (المملوء < السعة && !مقطوع) {
            // A short buffer means the end of the directory stream.
            مستمر := خطأ;
        } وإلا لو (!مكتمل_واحد) {
            // Not even one entry fit: grow (bounded) and read the same cookie.
            لو (السعة >= 1048576) {
                دع الإغلاق: نتيجة غ64, خطأ_واصف_واسي = أغلق_واصف_واسي(&متغير المفتوح);
                أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
            };
            السعة := السعة * 2;
        };
    }
    طابق أغلق_واصف_واسي(&متغير المفتوح) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج); };
}
