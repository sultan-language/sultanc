استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 process startup data. The host supplies arguments and the
// environment through *_sizes_get / *_get: the second call fills a pointer
// table (u32 linear-memory addresses on wasm32) and a buffer holding the
// NUL-terminated strings. Entry i is the string at pointer i: the host decides
// where in the buffer each string lives, so the table, not the buffer order,
// is authoritative. Each string is read from linear memory at its address,
// bounded by the memory size and the host-reported buffer size. Owned copies
// only. (Previously the buffer was split at NULs in order, which assumed the
// host packs the strings contiguously in table order.)
خارجي «wasi_snapshot_preview1» عرف args_sizes_get(العدد: *متغير ط32, الحجم: *متغير ط32): ص32;
خارجي «wasi_snapshot_preview1» عرف args_get(المؤشرات: *متغير ط32, المخزن: *متغير ط8): ص32;
خارجي «wasi_snapshot_preview1» عرف environ_sizes_get(العدد: *متغير ط32, الحجم: *متغير ط32): ص32;
خارجي «wasi_snapshot_preview1» عرف environ_get(المؤشرات: *متغير ط32, المخزن: *متغير ط8): ص32;

// Compiler intrinsics bind only through private aliases.
مرادف اقرأ_كلمة_ذاكرة_واسي = بدائي_اقرأ_الذاكرة_الخطية;
مرادف حجم_ذاكرة_واسي = بدائي_نمو_الذاكرة_الخطية;

// The byte at a linear-memory address, read through its aligned word (an
// aligned word never crosses the end of memory when the byte is inside it).
عرف بايت_ذاكرة_واسي(العنوان: ط64): ط8 {
    دع الكلمة: ط64 = اقرأ_كلمة_ذاكرة_واسي(((العنوان / 4) * 4) مثل ط32) مثل ط64;
    دع الإزاحة: ط64 = (العنوان % 4) * 8;
    أرجع ((الكلمة >> الإزاحة) % 256) مثل ط8;
}

عرف اقرأ_سلاسل_جدول_واسي(
    المؤشرات: &متجه ط32,
    العدد: طبيعي,
    حجم_المخزن: طبيعي
): نتيجة متجه متجه ط8, خطأ_واصف_واسي {
    دع نهاية_الذاكرة: ط64 = (حجم_ذاكرة_واسي(0) مثل ط64) * 65536;
    دع المتبقي: متغير ط64 = حجم_المخزن مثل ط64;
    دع الناتج: متغير متجه متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع العنوان: متغير ط64 = (*المؤشرات)[ف] مثل ط64;
        دع السلسلة: متغير متجه ط8 = [];
        دع انتهت: متغير منطقي = خطأ;
        طالما (!انتهت) {
            // Every string, terminator included, lies in the host buffer.
            لو (المتبقي == 0 || العنوان >= نهاية_الذاكرة) {
                أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
            };
            المتبقي := المتبقي - 1;
            دع البايت: ط8 = بايت_ذاكرة_واسي(العنوان);
            لو (البايت == 0) {
                انتهت := صواب;
            } وإلا {
                ألحق(السلسلة, البايت);
                العنوان := العنوان + 1;
            };
        }
        ألحق(الناتج, السلسلة);
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// بيئة: false = arguments, true = environment entries (NAME=VALUE).
عرف اقرأ_سلاسل_إقلاع_واسي(بيئة: منطقي): نتيجة متجه متجه ط8, خطأ_واصف_واسي {
    دع العدد: متغير متجه ط32 = [0];
    دع الحجم: متغير متجه ط32 = [0];
    دع الرمز: متغير ص32 = 0;
    لو (بيئة) {
        الرمز := environ_sizes_get(&متغير العدد[0], &متغير الحجم[0]);
    } وإلا {
        الرمز := args_sizes_get(&متغير العدد[0], &متغير الحجم[0]);
    };
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    لو (العدد[0] > 65536 || الحجم[0] > 16777216) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    // One extra slot keeps both tables non-empty for the host call.
    دع المؤشرات: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف <= (العدد[0] مثل طبيعي)) { ألحق(المؤشرات, 0 مثل ط32); ف := ف + 1; }
    دع المخزن: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف <= (الحجم[0] مثل طبيعي)) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
    لو (بيئة) {
        الرمز := environ_get(&متغير المؤشرات[0], &متغير المخزن[0]);
    } وإلا {
        الرمز := args_get(&متغير المؤشرات[0], &متغير المخزن[0]);
    };
    لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    // The buffer stays owned (and unmoved) here while its strings are read.
    أرجع اقرأ_سلاسل_جدول_واسي(&المؤشرات, العدد[0] مثل طبيعي, الحجم[0] مثل طبيعي);
}

عام عرف اقرأ_وسائط_واسي(): نتيجة متجه متجه ط8, خطأ_واصف_واسي {
    أرجع اقرأ_سلاسل_إقلاع_واسي(خطأ);
}

عام عرف اقرأ_بيئة_واسي(): نتيجة متجه متجه ط8, خطأ_واصف_واسي {
    أرجع اقرأ_سلاسل_إقلاع_واسي(صواب);
}

// The value of NAME in the environment; nothing when it is absent.
عام عرف ابحث_قيمة_بيئة_واسي(الاسم: &نص): نتيجة اختياري متجه ط8, خطأ_واصف_واسي {
    طابق اقرأ_بيئة_واسي() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المداخل) -> {
        دع طول_الاسم: طبيعي = الطول(*الاسم) مثل طبيعي;
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(المداخل) مثل طبيعي)) {
            دع المدخل: &متجه ط8 = &المداخل[ف];
            دع طول_المدخل: طبيعي = الطول(*المدخل) مثل طبيعي;
            لو (طول_المدخل > طول_الاسم && (*المدخل)[طول_الاسم] == 0x3D) {
                دع مطابق: متغير منطقي = صواب;
                دع ح: متغير طبيعي = 0;
                طالما (ح < طول_الاسم) {
                    لو ((*المدخل)[ح] != (*الاسم)[ح]) { مطابق := خطأ; };
                    ح := ح + 1;
                }
                لو (مطابق) {
                    دع القيمة: متغير متجه ط8 = [];
                    ح := طول_الاسم + 1;
                    طالما (ح < طول_المدخل) { ألحق(القيمة, (*المدخل)[ح]); ح := ح + 1; }
                    أرجع نتيجة.نجح(اختياري.موجود(القيمة));
                };
            };
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(اختياري.لا_شيء());
    };
}
