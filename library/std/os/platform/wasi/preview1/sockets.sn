استورد os.buffer;
استورد os.error;
استورد os.platform.wasi.preview1.file_descriptors;

// WASI preview 1 sockets. The interface has no socket creation, connect,
// bind, listen or name resolution: an instance only receives sockets the
// host preopened (listeners) and accepts, sends, receives and shuts down on
// them. Each import returns a WASI errno, 0 meaning success.
خارجي «wasi_snapshot_preview1» عرف sock_accept(الواصف: ط32, الأعلام: ط16, الناتج: *متغير ط32): ص32;
خارجي «wasi_snapshot_preview1» عرف sock_recv(
    الواصف: ط32, المقاطع: *مقطع_قراءة_واسي, العدد: ط32, الأعلام: ط16,
    المستقبل: *متغير ط32, أعلام_الناتج: *متغير ط16
): ص32;
خارجي «wasi_snapshot_preview1» عرف sock_send(
    الواصف: ط32, المقاطع: *مقطع_كتابة_واسي, العدد: ط32, الأعلام: ط16,
    المرسل: *متغير ط32
): ص32;
خارجي «wasi_snapshot_preview1» عرف sock_shutdown(الواصف: ط32, الاتجاه: ط8): ص32;

// ENOTSUP in the WASI errno numbering.
عام عرف رمز_غير_مدعوم_واسي(): ص32 { أرجع 58; }

عام عرف اقبل_مقبس_واسي(المستمع: ط32): نتيجة ط32, خطأ_واصف_واسي {
    دع الناتج: متغير متجه ط32 = [0];
    دع الرمز: ص32 = sock_accept(المستمع, 0 مثل ط16, &متغير الناتج[0]);
    إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(الناتج[0]);
}

عام عرف أرسل_مقبس_واسي(
    الواصف: ط32, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_واسي {
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المقطع: مقطع_كتابة_واسي = {
        المؤشر: &(*المحتوى)[الإزاحة مثل طبيعي], الطول: الطلب مثل ط32
    };
    دع المقاطع: متجه مقطع_كتابة_واسي = [المقطع];
    دع المرسل: متغير متجه ط32 = [0];
    دع الرمز: ص32 = sock_send(الواصف, &المقاطع[0], 1, 0 مثل ط16, &متغير المرسل[0]);
    إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(المرسل[0] مثل ط64);
}

عام عرف استقبل_مقبس_واسي(
    الواصف: ط32, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_واسي {
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_واسي.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المقطع: مقطع_قراءة_واسي = {
        المؤشر: &متغير (*المخزن)[الإزاحة مثل طبيعي], الطول: الطلب مثل ط32
    };
    دع المقاطع: متجه مقطع_قراءة_واسي = [المقطع];
    دع المستقبل: متغير متجه ط32 = [0];
    دع الأعلام: متغير متجه ط16 = [0];
    دع الرمز: ص32 = sock_recv(
        الواصف, &المقاطع[0], 1, 0 مثل ط16, &متغير المستقبل[0], &متغير الأعلام[0]
    );
    إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(المستقبل[0] مثل ط64);
}

// الاتجاه: 0 read, 1 write, 2 both (std.os.socket); WASI sdflags 1 RD, 2 WR.
عام عرف أوقف_مقبس_واسي(الواصف: ط32, الاتجاه: عدد): نتيجة ط64, خطأ_واصف_واسي {
    دع الأعلام: متغير ط8 = 3;
    إذا (الاتجاه == 0) { الأعلام := 1; };
    إذا (الاتجاه == 1) { الأعلام := 2; };
    دع الرمز: ص32 = sock_shutdown(الواصف, الأعلام);
    إذا (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_رقم_واسي(الرمز)); };
    أرجع نتيجة.نجح(0);
}
