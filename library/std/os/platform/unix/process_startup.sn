// Unix process startup data (Linux and Darwin). The executable entry stores
// the argc, argv and envp the kernel (Linux, through SultanC's `_start`) or
// dyld (Darwin) passes in these linker data symbols before
// SultanC code runs; the layout is identical on every Unix target. Only this OS provider dereferences the foreign arrays.
// All public consumers receive owned copies, never borrowed native pointers.
خارجي دع عدد_وسائط_إقلاع_يونكس: طبيعي = «sultanc.bootstrap.argc»;
خارجي دع مؤشر_وسائط_إقلاع_يونكس: *متغير *ط8 = «sultanc.bootstrap.argv»;
خارجي دع مؤشر_بيئة_إقلاع_يونكس: *متغير *ط8 = «sultanc.bootstrap.envp»;

// Bounds prevent nonterminated process strings and vectors from consuming
// unbounded allocations; these limits apply equally to argv and envp.
عرف انسخ_سلسلة_إقلاع_يونكس(المؤشر: *ط8): اختياري متجه ط8 {
    لو (المؤشر == الفارغ) { أرجع اختياري.لا_شيء(); };
    دع البايتات: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    غير_آمن {
        طالما (الموضع < 1048576 && المؤشر[الموضع] != 0) {
            ألحق(البايتات, المؤشر[الموضع]);
            الموضع := الموضع + 1;
        }
        لو (الموضع == 1048576) { أرجع اختياري.لا_شيء(); };
    }
    أرجع اختياري.موجود(البايتات);
}

عام عرف اقرأ_عدد_وسائط_إقلاع_يونكس(): اختياري طبيعي {
    // The kernel and dyld supply argv[argc] == NULL. Bound argc before indexing.
    لو (عدد_وسائط_إقلاع_يونكس > 65536) { أرجع اختياري.لا_شيء(); };
    لو (عدد_وسائط_إقلاع_يونكس > 0 && مؤشر_وسائط_إقلاع_يونكس == الفارغ) {
        أرجع اختياري.لا_شيء();
    };
    // The required ABI sentinel also guards against an inconsistent count.
    لو (مؤشر_وسائط_إقلاع_يونكس != الفارغ) {
        دع النهاية: متغير *ط8 = الفارغ;
        غير_آمن { النهاية := مؤشر_وسائط_إقلاع_يونكس[عدد_وسائط_إقلاع_يونكس]; }
        لو (النهاية != الفارغ) { أرجع اختياري.لا_شيء(); };
    };
    أرجع اختياري.موجود(عدد_وسائط_إقلاع_يونكس);
}

عام عرف اقرأ_وسيطة_إقلاع_يونكس(الموضع: طبيعي): اختياري متجه ط8 {
    طابق اقرأ_عدد_وسائط_إقلاع_يونكس() مع
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
    | اختياري.موجود(العدد) -> {
        لو (الموضع >= العدد) { أرجع اختياري.لا_شيء(); };
    };
    دع المؤشر: متغير *ط8 = الفارغ;
    غير_آمن { المؤشر := مؤشر_وسائط_إقلاع_يونكس[الموضع]; }
    أرجع انسخ_سلسلة_إقلاع_يونكس(المؤشر);
}

// Environment entries are opaque byte strings. Scan the process-lifetime envp array
// only until its NULL sentinel, never past the bounded entry limit.
// Distinguish an exhausted environment vector from an invalid/overlong entry:
// the native NULL sentinel ends iteration; a non-NULL invalid value fails.
عام عرف اجمع_بيئة_إقلاع_يونكس(): اختياري متجه متجه ط8 {
    لو (مؤشر_بيئة_إقلاع_يونكس == الفارغ) { أرجع اختياري.لا_شيء(); };
    دع العناصر: متغير متجه متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 65536) {
        دع المؤشر: متغير *ط8 = الفارغ;
        غير_آمن { المؤشر := مؤشر_بيئة_إقلاع_يونكس[الفهرس]; }
        لو (المؤشر == الفارغ) { أرجع اختياري.موجود(العناصر); };
        طابق انسخ_سلسلة_إقلاع_يونكس(المؤشر) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(القيمة) -> { ألحق(العناصر, القيمة); };
        الفهرس := الفهرس + 1;
    }
    أرجع اختياري.لا_شيء();
}

// Look up one startup environment value without materializing the entire
// process environment. A normal lookup cannot allocate one copy per entry.
// Distinguish an absent key from an invalid startup pointer/string.
عام نوع نتيجة_بحث_بيئة_إقلاع_يونكس =
    | موجود بنوع متجه ط8
    | غير_موجود
    | غير_صالح
;

عام عرف ابحث_قيمة_بيئة_إقلاع_يونكس(
    الاسم: &نص
): نتيجة_بحث_بيئة_إقلاع_يونكس {
    لو (مؤشر_بيئة_إقلاع_يونكس == الفارغ) {
        أرجع نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح();
    };
    دع طول_الاسم: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 65536) {
        دع المؤشر: متغير *ط8 = الفارغ;
        غير_آمن { المؤشر := مؤشر_بيئة_إقلاع_يونكس[الفهرس]; }
        لو (المؤشر == الفارغ) {
            أرجع نتيجة_بحث_بيئة_إقلاع_يونكس.غير_موجود();
        };
        طابق انسخ_سلسلة_إقلاع_يونكس(المؤشر) مع
        | اختياري.لا_شيء -> {
            أرجع نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح();
        }
        | اختياري.موجود(المدخل) -> {
            دع طول_المدخل: طبيعي = الطول(المدخل) مثل طبيعي;
            لو (طول_المدخل > طول_الاسم && المدخل[طول_الاسم] == 0x3D) {
                دع مطابق: متغير منطقي = صواب;
                دع الموضع: متغير طبيعي = 0;
                طالما (الموضع < طول_الاسم) {
                    لو (المدخل[الموضع] != (*الاسم)[الموضع]) {
                        مطابق := خطأ;
                    };
                    الموضع := الموضع + 1;
                }
                لو (مطابق) {
                    دع القيمة: متغير متجه ط8 = [];
                    دع موضع_القيمة: متغير طبيعي = طول_الاسم + 1;
                    طالما (موضع_القيمة < طول_المدخل) {
                        ألحق(القيمة, المدخل[موضع_القيمة]);
                        موضع_القيمة := موضع_القيمة + 1;
                    }
                    أرجع نتيجة_بحث_بيئة_إقلاع_يونكس.موجود(القيمة);
                };
            };
        };
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح();
}
