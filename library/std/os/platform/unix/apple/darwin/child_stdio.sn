استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Descriptors for a child's standard streams through libSystem: pipe(2),
// the null device and poll(2) (<unistd.h>, <poll.h>; nfds_t is u32). The
// pipe ends are not close-on-exec, but std's posix_spawn passes
// POSIX_SPAWN_CLOEXEC_DEFAULT, so a child only receives the descriptors its
// file actions name.
خارجي «/usr/lib/libSystem.B.dylib» عرف pipe(الواصفات: *متغير ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف poll(الأحداث: *متغير ط32, العدد: ط32, المهلة: ص32): ص32;

عام عرف أنشئ_قناة_داروين(): نتيجة متجه ص32, خطأ_واصف_داروين {
    دع الواصفات: متغير متجه ص32 = [-1, -1];
    إذا (pipe(&متغير الواصفات[0]) < 0) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي())); };
    أرجع نتيجة.نجح(الواصفات);
}

// open("/dev/null", O_RDWR|O_CLOEXEC).
عام عرف افتح_الجهاز_الفارغ_داروين(): نتيجة واصف_ملف_داروين, خطأ_واصف_داروين {
    دع المسار: متجه ط8 = [47, 100, 101, 118, 47, 110, 117, 108, 108, 0];
    دع الناتج: ص32 = open(&المسار[0], 0x1000002);
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي())); };
    دع الواصف: واصف_ملف_داروين = { القيمة: الناتج, مفتوح: صواب };
    أرجع نتيجة.نجح(الواصف);
}

// poll with POLLIN (1); ready on POLLIN, POLLERR (8), POLLHUP (0x10) or
// POLLNVAL (0x20). Both Darwin ABIs are little-endian.
عام عرف انتظر_واصفات_للقراءة_داروين(
    الواصفات: &متجه ط64
): نتيجة متجه منطقي, خطأ_واصف_داروين {
    دع العدد: طبيعي = الطول(*الواصفات) مثل طبيعي;
    إذا (العدد == 0 || العدد > 64) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    دع الأحداث: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الأحداث, (*الواصفات)[ف] مثل ط32);
        ألحق(الأحداث, 1);
        ف := ف + 1;
    }
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        إذا (poll(&متغير الأحداث[0], العدد مثل ط32, -1) < 0) {
            دع الخطأ: خطأ_نظام_أصلي = خطأ_داروين_الحالي();
            إذا (الخطأ.الرمز != 4) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(الخطأ)); };
        } وإلا {
            مستمر := خطأ;
        };
    }
    دع الجاهزة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) {
        ألحق(الجاهزة, ((الأحداث[ف * 2 + 1] >> 16) & 0x39) != 0);
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الجاهزة);
}

// <signal.h>: sigset_t is a u32 whose bit (signal - 1) is the signal;
// SIG_BLOCK 1, SIG_SETMASK 3, SIGPIPE 13. pthread_sigmask and sigwait
// return an error number instead of setting errno.
خارجي «/usr/lib/libSystem.B.dylib» عرف pthread_sigmask(الأمر: ص32, المجموعة: *ط32, القديمة: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف sigpending(المجموعة: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف sigwait(المجموعة: *ط32, الإشارة: *متغير ص32): ص32;

// write(2) to a pipe without SIGPIPE (a child's standard input), as
// PostgreSQL's libpq does it on Darwin (pq_block_sigpipe /
// pq_reset_sigpipe): SIGPIPE is blocked in this thread for the write; after
// an EPIPE the SIGPIPE it left pending is taken with sigwait, and the old
// mask is restored. F_SETNOSIGPIPE would need fcntl's variadic argument,
// which arm64 passes on the stack.
عام عرف اكتب_قناة_بلا_إشارة_داروين(
    الواصف: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_داروين {
    دع المجموعة: متجه ط32 = [0x1000];
    دع القديمة: متغير ط32 = 0;
    دع الحجب: ص32 = pthread_sigmask(1, &المجموعة[0], &متغير القديمة);
    إذا (الحجب != 0) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الحجب مثل عدد)));
    };
    دع المقبض: واصف_ملف_داروين = { القيمة: واصف_داروين_من_ط64(الواصف), مفتوح: صواب };
    دع الناتج: نتيجة ط64, خطأ_واصف_داروين = اكتب_واصف_داروين(&المقبض, المحتوى, الإزاحة, المطلوب);
    طابق الناتج مع
    | نتيجة.خطأ(خطأ_واصف_داروين.نظام(الأصلي)) -> {
        إذا (الأصلي.الرمز == 32) {
            دع المعلقة: متغير ط32 = 0;
            إذا (sigpending(&متغير المعلقة) == 0 && (المعلقة & 0x1000) != 0) {
                دع الإشارة: متغير ص32 = 0;
                دع الأخذ: ص32 = sigwait(&المجموعة[0], &متغير الإشارة);
            };
        };
    }
    | _ -> {};
    دع الاستعادة: ص32 = pthread_sigmask(3, &القديمة, الفارغ);
    أرجع الناتج;
}
