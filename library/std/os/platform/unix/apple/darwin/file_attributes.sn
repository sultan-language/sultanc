استورد os.path;
استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;
استورد os.platform.unix.apple.darwin.entropy;
استورد text.from_bytes;

// Links, permission bits, file sizes, file times and the working directory
// through libSystem (<unistd.h>, <sys/stat.h>, <fcntl.h>). mode_t is u16,
// off_t i64; struct timespec is {i64 tv_sec, i64 tv_nsec} on both Darwin
// ABIs; AT_FDCWD is -2 (<sys/fcntl.h>).
خارجي «/usr/lib/libSystem.B.dylib» عرف symlink(الهدف: *ط8, الوصلة: *ط8): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف readlink(المسار: *ط8, المخزن: *متغير ط8, الحجم: ط64): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف link(الموجود: *ط8, الجديد: *ط8): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف chmod(المسار: *ط8, الوضع: ط16): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف ftruncate(الواصف: ص32, الطول: ص64): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف utimensat(الدليل: ص32, المسار: *ط8, الأوقات: *ص64, الأعلام: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف chdir(المسار: *ط8): ص32;

عرف فشل_سمات_داروين(): خطأ_واصف_داروين {
    أرجع خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي());
}

عام عرف أنشئ_وصلة_رمزية_داروين(
    الهدف_المرجعي: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(الهدف_المرجعي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الهدف) -> {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_المسار) -> {
            دع أ: متجه ط8 = بايتات_الهدف;
            دع ب: متجه ط8 = بايتات_المسار;
            إذا (symlink(&أ[0], &ب[0]) < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

// readlink(2) truncates silently: a full buffer is retried larger.
عام عرف اقرأ_وصلة_رمزية_داروين(
    المسار: &متجه ط8
): نتيجة متجه ط8, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع السعة: متغير طبيعي = 256;
        طالما (السعة <= 1048576) {
            دع المخزن: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < السعة) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
            دع العدد: ص64 = readlink(&الاسم[0], &متغير المخزن[0], السعة مثل ط64);
            إذا (العدد < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
            إذا ((العدد مثل طبيعي) < السعة) {
                دع الناتج: متغير متجه ط8 = [];
                دع ح: متغير طبيعي = 0;
                طالما (ح < (العدد مثل طبيعي)) { ألحق(الناتج, المخزن[ح]); ح := ح + 1; }
                أرجع نتيجة.نجح(الناتج);
            };
            السعة := السعة * 4;
        }
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
}

عام عرف أنشئ_وصلة_صلبة_داروين(
    الأصل: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_المسار) -> {
            دع أ: متجه ط8 = بايتات_الأصل;
            دع ب: متجه ط8 = بايتات_المسار;
            إذا (link(&أ[0], &ب[0]) < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

عام عرف اضبط_أذونات_مسار_داروين(
    المسار: &متجه ط8, الوضع: ط64
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (الوضع > 0xfff) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        إذا (chmod(&الاسم[0], الوضع مثل ط16) < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف اقتطع_واصف_داروين(
    الواصف: &واصف_ملف_داروين, الطول: ط64
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    إذا (الطول > 0x7fffffffffffffff) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    إذا (ftruncate((*الواصف).القيمة, الطول مثل ص64) < 0) {
        أرجع نتيجة.خطأ(فشل_سمات_داروين());
    };
    أرجع نتيجة.نجح(0);
}

عام عرف اضبط_أوقات_مسار_داروين(
    المسار: &متجه ط8, ثواني_الوصول: ص64, نانو_الوصول: ط64,
    ثواني_التعديل: ص64, نانو_التعديل: ط64
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (نانو_الوصول >= 1000000000 || نانو_التعديل >= 1000000000) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع الأوقات: متغير متجه ص64 = [];
        ألحق(الأوقات, ثواني_الوصول);
        ألحق(الأوقات, نانو_الوصول مثل ص64);
        ألحق(الأوقات, ثواني_التعديل);
        ألحق(الأوقات, نانو_التعديل مثل ص64);
        إذا (utimensat(-2, &الاسم[0], &الأوقات[0], 0) < 0) {
            أرجع نتيجة.خطأ(فشل_سمات_داروين());
        };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف غير_دليل_العمل_داروين(المسار: &متجه ط8): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        إذا (chdir(&الاسم[0]) < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
        أرجع نتيجة.نجح(0);
    };
}

// open(path, O_WRONLY|O_CLOEXEC): an existing file, not truncated. No
// O_CREAT, so the variadic mode argument is never needed.
عام عرف افتح_ملفا_للتعديل_داروين(
    المسار: &متجه ط8
): نتيجة واصف_ملف_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع الناتج: ص32 = open(&الاسم[0], 0x1000001);
        إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
        دع الواصف: واصف_ملف_داروين = { القيمة: الناتج, مفتوح: صواب };
        أرجع نتيجة.نجح(الواصف);
    };
}

// Exclusive creation: open(path, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, mode)
// (0x2 | 0x200 | 0x800 | 0x1000000 on Darwin), with the variadic mode passed
// as Apple's arm64 ABI expects it (file_descriptors.sn).
عام عرف أنشئ_ملفا_جديدا_داروين(
    المسار: &متجه ط8, الوضع: ط64
): نتيجة واصف_ملف_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_المسار) -> {
        دع ب: متجه ط8 = بايتات_المسار;
        دع الناتج: ص32 = افتح_بوضع_داروين(&ب[0], 0x1000A02, الوضع & 0xFFF);
        إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_سمات_داروين()); };
        دع الواصف: واصف_ملف_داروين = { القيمة: الناتج, مفتوح: صواب };
        أرجع نتيجة.نجح(الواصف);
    };
}
