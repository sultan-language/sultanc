// حد ABI لمحمل المكتبات الديناميكية في النظام.
// الأسماء الإنجليزية هنا فقط لأنها أسماء رموز C خارجية فعلية.
// Darwin dladdr is provided by libSystem. This module holds only the
// platform C ABI and generic C-string extraction, not compiler policy.

عام نوع معلومات_عنوان_محمل_ديناميكي = {
    اسم_الملف: *غ8,
    قاعدة: *غ8,
    اسم_الرمز: *غ8,
    عنوان_الرمز: *غ8
};

خارجي عرف dladdr(العنوان: *متغير غ8, المعلومات: *متغير معلومات_عنوان_محمل_ديناميكي): ص32;

عام عرف ابحث_معلومات_عنوان_ديناميكي(
    العنوان: *متغير غ8,
    المعلومات: *متغير معلومات_عنوان_محمل_ديناميكي
): ص32 {
    أرجع dladdr(العنوان, المعلومات);
}

عام عرف انسخ_نص_سي_من_محمل_ديناميكي(المصدر: *غ8): متجه غ8 {
    دع الناتج: متغير متجه غ8 = [];
    دع فهرس_البايت: متغير غير_موقع = 0;
    غير_آمن {
        بينما (المصدر[فهرس_البايت] != 0) {
            ألحق(الناتج, المصدر[فهرس_البايت]);
            فهرس_البايت := فهرس_البايت + 1;
        }
    }
    أرجع الناتج;
}
