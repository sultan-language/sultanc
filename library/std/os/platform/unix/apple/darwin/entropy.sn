استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;

// getentropy(2) is the libSystem (libsystem_kernel) entry point to the
// kernel CSPRNG, in the same role as the other Darwin system-call entry
// points. One call fills at most 256 bytes and either fills the whole
// request or fails with errno.
خارجي «/usr/lib/libSystem.B.dylib» عرف getentropy(المخزن: *متغير ط8, الحجم: ط64): ص32;

عام عرف املأ_عشوائية_نواة_داروين(المخزن: &متغير متجه ط8): نتيجة طبيعي, خطأ_نظام_أصلي {
    دع الحجم: طبيعي = الطول(*المخزن) مثل طبيعي;
    دع المكتمل: متغير طبيعي = 0;
    طالما (المكتمل < الحجم) {
        دع الجزء: متغير طبيعي = الحجم - المكتمل;
        لو (الجزء > 256) { الجزء := 256; };
        دع الرمز: ص32 = getentropy(&متغير (*المخزن)[المكتمل], الجزء مثل ط64);
        لو (الرمز != 0) { أرجع نتيجة.خطأ(خطأ_داروين_الحالي()); };
        المكتمل := المكتمل + الجزء;
    }
    أرجع نتيجة.نجح(الحجم);
}
