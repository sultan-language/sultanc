// The process id, terminal checks and shutdown signals on macOS, through
// libSystem as Rust's std and Go's runtime call it there (Nahr items 16
// and 17). pthread_sigmask and sigwait return an error number instead of
// setting errno. SIGINT is 2, SIGTERM 15; SIG_BLOCK is 1.
استورد os.error;

خارجي «/usr/lib/libSystem.B.dylib» عرف getpid(): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف isatty(الواصف: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف pthread_sigmask(الأمر: ص32, المجموعة: *ط32, القديمة: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف sigpending(المجموعة: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف sigwait(المجموعة: *ط32, الإشارة: *متغير ص32): ص32;

عام عرف معرف_العملية_داروين(): ط64 { أرجع (getpid() مثل ط32) مثل ط64; }

عام عرف هل_طرفية_داروين(الواصف: ط64): منطقي { أرجع isatty(الواصف مثل ص32) == 1; }

// SIGINT and SIGTERM as a sigset_t (32 bits on Darwin).
عرف مجموعة_إشارات_الإيقاف_داروين(): ط32 { أرجع 0x4002; }

عام عرف احجب_إشارات_الإيقاف_داروين(): نتيجة طبيعي, خطأ_نظام_أصلي {
    دع المجموعة: متجه ط32 = [0x4002];
    دع القديمة: متغير ط32 = 0;
    دع الحالة: ص32 = pthread_sigmask(1, &المجموعة[0], &متغير القديمة);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الحالة مثل عدد));
    };
    أرجع نتيجة.نجح(0);
}

// SIG_UNBLOCK is 2.
عام عرف ارفع_حجب_إشارات_الإيقاف_داروين(): نتيجة طبيعي, خطأ_نظام_أصلي {
    دع المجموعة: متجه ط32 = [0x4002];
    دع القديمة: متغير ط32 = 0;
    دع الحالة: ص32 = pthread_sigmask(2, &المجموعة[0], &متغير القديمة);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الحالة مثل عدد));
    };
    أرجع نتيجة.نجح(0);
}

// Takes one pending SIGINT or SIGTERM and answers its number; with فوري
// only one already pending (EAGAIN, 35, when there is none).
عام عرف خذ_إشارة_إيقاف_داروين(فوري: منطقي): نتيجة طبيعي, خطأ_نظام_أصلي {
    دع المجموعة: متجه ط32 = [0x4002];
    إذا (فوري) {
        دع المعلقة: متغير ط32 = 0;
        إذا (sigpending(&متغير المعلقة) != 0 || (المعلقة & 0x4002) == 0) {
            أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), 35));
        };
    };
    دع الإشارة: متغير ص32 = 0;
    دع الحالة: ص32 = sigwait(&المجموعة[0], &متغير الإشارة);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الحالة مثل عدد));
    };
    أرجع نتيجة.نجح((الإشارة مثل ط32) مثل طبيعي);
}
