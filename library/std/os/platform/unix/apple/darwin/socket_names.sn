استورد os.buffer;
استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;
استورد os.platform.unix.apple.darwin.sockets;

// Socket names and address-bearing datagrams through libSystem
// (<sys/socket.h>; socklen_t is u32, ssize_t i64). Sockets are created with
// SO_NOSIGPIPE, so sendto never raises SIGPIPE.
خارجي «/usr/lib/libSystem.B.dylib» عرف getsockname(المقبس: ص32, العنوان: *متغير ط8, الطول: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف getpeername(المقبس: ص32, العنوان: *متغير ط8, الطول: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف sendto(
    المقبس: ص32, المحتوى: *ط8, الطول: ط64, الأعلام: ص32, العنوان: *ط8, طول_العنوان: ط32
): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف recvfrom(
    المقبس: ص32, المحتوى: *متغير ط8, الطول: ط64, الأعلام: ص32,
    العنوان: *متغير ط8, طول_العنوان: *متغير ط32
): ص64;

عام نوع حزمة_واردة_داروين = { المقروء: عدد, العنوان: متجه ط8 };

عرف فشل_اسم_مقبس_داروين(): خطأ_مقبس_داروين {
    أرجع خطأ_مقبس_داروين.نظام(خطأ_داروين_الحالي());
}

عرف اقطع_عنوان_داروين(المخزن: &متجه ط8, الطول: ط32): نتيجة متجه ط8, خطأ_مقبس_داروين {
    إذا (الطول > 128) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح()); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول مثل طبيعي)) { ألحق(الناتج, (*المخزن)[ف]); ف := ف + 1; }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_اسم_مقبس_داروين(
    المقبس: &مقبس_داروين, محلي: منطقي
): نتيجة متجه ط8, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 128) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
    دع الطول: متغير ط32 = 128;
    دع الحالة: متغير ص32 = 0;
    إذا (محلي) {
        الحالة := getsockname((*المقبس).القيمة, &متغير المخزن[0], &متغير الطول);
    } وإلا {
        الحالة := getpeername((*المقبس).القيمة, &متغير المخزن[0], &متغير الطول);
    };
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_اسم_مقبس_داروين()); };
    أرجع اقطع_عنوان_داروين(&المخزن, الطول);
}

عام عرف أرسل_إلى_عنوان_داروين(
    المقبس: &مقبس_داروين, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد,
    العنوان: &متجه ط8
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 0x7fffffff || الطول(*العنوان) < 2 || الطول(*العنوان) > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع المؤقت: متجه ط8 = [0];
    دع المؤشر: متغير *ط8 = &المؤقت[0];
    إذا (المطلوب > 0) { المؤشر := &(*المحتوى)[الإزاحة مثل طبيعي]; };
    دع الحالة: ص64 = sendto(
        (*المقبس).القيمة, المؤشر, المطلوب مثل ط64, 0, &(*العنوان)[0], الطول(*العنوان) مثل ط32
    );
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_اسم_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف استقبل_من_عنوان_داروين(
    المقبس: &مقبس_داروين, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة حزمة_واردة_داروين, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب) || المطلوب > 0x7fffffff) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع العنوان: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 128) { ألحق(العنوان, 0 مثل ط8); ف := ف + 1; }
    دع الطول: متغير ط32 = 128;
    دع المؤقت: متغير متجه ط8 = [0];
    دع المؤشر: متغير *متغير ط8 = &متغير المؤقت[0];
    إذا (المطلوب > 0) { المؤشر := &متغير (*المخزن)[الإزاحة مثل طبيعي]; };
    دع الحالة: ص64 = recvfrom(
        (*المقبس).القيمة, المؤشر, المطلوب مثل ط64, 0, &متغير العنوان[0], &متغير الطول
    );
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_اسم_مقبس_داروين()); };
    طابق اقطع_عنوان_داروين(&العنوان, الطول) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرسل) -> {
        دع الحزمة: حزمة_واردة_داروين = { المقروء: الحالة مثل عدد, العنوان: المرسل };
        أرجع نتيجة.نجح(الحزمة);
    };
}
