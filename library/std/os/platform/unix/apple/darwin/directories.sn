استورد os.path;
استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Darwin directory provider through libSystem (see file_descriptors.sn for
// why libSystem is the supported Darwin kernel interface). arm64 Darwin
// always uses the 64-bit inode ABI, so opendir/readdir carry no $INODE64
// suffix and struct dirent is: d_ino u64 @0, d_seekoff u64 @8,
// d_reclen u16 @16, d_namlen u16 @18, d_type u8 @20, d_name @21.
خارجي عرف opendir(المسار: *غ8): *متغير غ8;
خارجي عرف readdir(الدليل: *متغير غ8): *غ8;
خارجي عرف closedir(الدليل: *متغير غ8): ص32;
خارجي عرف mkdir(المسار: *غ8, الوضع: غ16): ص32;
خارجي عرف rmdir(المسار: *غ8): ص32;

عام نوع مدخل_دليل_داروين = { الاسم: متجه غ8, النوع: غ8 };

// Lists every entry except "." and ".."; the DIR stream is closed exactly once.
عام عرف اقرأ_مداخل_دليل_داروين(
    المسار: &متجه غ8
): نتيجة متجه مدخل_دليل_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        دع الدليل: *متغير غ8 = opendir(&الاسم[0]);
        لو (الدليل == الفارغ) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        دع الناتج: متغير متجه مدخل_دليل_داروين = [];
        دع مستمر: متغير منطقي = صواب;
        بينما (مستمر) {
            // readdir reports end and failure both as NULL; errno separates them.
            اضبط_خطأ_داروين_صفرا();
            دع المدخل: *غ8 = readdir(الدليل);
            لو (المدخل == الفارغ) {
                دع الخطأ: خطأ_نظام_أصلي = خطأ_داروين_الحالي();
                دع الإغلاق: ص32 = closedir(الدليل);
                لو (الخطأ.الرمز != 0) {
                    أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(الخطأ));
                };
                مستمر := خطأ;
            } وإلا {
                دع الطول_الأدنى: متغير غير_موقع = 0;
                دع الطول_الأعلى: متغير غير_موقع = 0;
                دع النوع: متغير غ8 = 0;
                غير_آمن {
                    الطول_الأدنى := المدخل[18] مثل غير_موقع;
                    الطول_الأعلى := المدخل[19] مثل غير_موقع;
                    النوع := المدخل[20];
                }
                دع طول_الاسم: غير_موقع = الطول_الأدنى + (الطول_الأعلى * 256);
                لو (طول_الاسم > 1023) {
                    دع الإغلاق: ص32 = closedir(الدليل);
                    أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
                };
                دع اسم_المدخل: متغير متجه غ8 = [];
                دع ف: متغير غير_موقع = 0;
                بينما (ف < طول_الاسم) {
                    دع البايت: متغير غ8 = 0;
                    غير_آمن { البايت := المدخل[21 + ف]; }
                    ألحق(اسم_المدخل, البايت);
                    ف := ف + 1;
                }
                دع خاص: منطقي = (طول_الاسم == 1 && اسم_المدخل[0] == 46)
                    || (طول_الاسم == 2 && اسم_المدخل[0] == 46 && اسم_المدخل[1] == 46);
                لو (!خاص) {
                    دع الناتج_المقروء: مدخل_دليل_داروين = { الاسم: اسم_المدخل, النوع: النوع };
                    ألحق(الناتج, الناتج_المقروء);
                };
            };
        }
        أرجع نتيجة.نجح(الناتج);
    };
}

عام عرف أنشئ_دليل_داروين(المسار: &متجه غ8, الوضع: غ16): نتيجة غ64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        لو (mkdir(&الاسم[0], الوضع) < 0) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف أزل_دليل_داروين(المسار: &متجه غ8): نتيجة غ64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        لو (rmdir(&الاسم[0]) < 0) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        أرجع نتيجة.نجح(0);
    };
}
