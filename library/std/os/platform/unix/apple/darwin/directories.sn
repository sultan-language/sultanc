استورد os.path;
استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Darwin directory provider through libSystem (see file_descriptors.sn for
// why libSystem is the supported Darwin kernel interface). std reads the
// 64-bit-inode struct dirent: d_ino u64 @0, d_seekoff u64 @8,
// d_reclen u16 @16, d_namlen u16 @18, d_type u8 @20, d_name @21. arm64
// Darwin has only that ABI, so opendir/readdir carry no suffix there. On
// x86_64 the plain names are the legacy 32-bit-inode ABI (d_ino u32,
// d_namlen u8 @7); <dirent.h> binds the 64-bit-inode ones to
// `opendir$INODE64` (__DARWIN_ALIAS_I) and `readdir$INODE64`
// (__DARWIN_INODE64), as Rust's libc does with link_name. closedir, mkdir and
// rmdir have no inode variant on x86_64.
لو (الهدف.المعمارية == «x86_64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف opendir(المسار: *ط8): *متغير ط8 = «opendir$INODE64»;
    خارجي «/usr/lib/libSystem.B.dylib» عرف readdir(الدليل: *متغير ط8): *ط8 = «readdir$INODE64»;
} وإلا {
    خارجي «/usr/lib/libSystem.B.dylib» عرف opendir(المسار: *ط8): *متغير ط8;
    خارجي «/usr/lib/libSystem.B.dylib» عرف readdir(الدليل: *متغير ط8): *ط8;
}
خارجي «/usr/lib/libSystem.B.dylib» عرف closedir(الدليل: *متغير ط8): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف mkdir(المسار: *ط8, الوضع: ط16): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف rmdir(المسار: *ط8): ص32;

عام نوع مدخل_دليل_داروين = { الاسم: متجه ط8, النوع: ط8 };

// Lists every entry except "." and ".."; the DIR stream is closed exactly once.
عام عرف اقرأ_مداخل_دليل_داروين(
    المسار: &متجه ط8
): نتيجة متجه مدخل_دليل_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع الدليل: *متغير ط8 = opendir(&الاسم[0]);
        لو (الدليل == الفارغ) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        دع الناتج: متغير متجه مدخل_دليل_داروين = [];
        دع مستمر: متغير منطقي = صواب;
        طالما (مستمر) {
            // readdir reports end and failure both as NULL; errno separates them.
            اضبط_خطأ_داروين_صفرا();
            دع المدخل: *ط8 = readdir(الدليل);
            لو (المدخل == الفارغ) {
                دع الخطأ: خطأ_نظام_أصلي = خطأ_داروين_الحالي();
                دع الإغلاق: ص32 = closedir(الدليل);
                لو (الخطأ.الرمز != 0) {
                    أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(الخطأ));
                };
                مستمر := خطأ;
            } وإلا {
                دع الطول_الأدنى: متغير طبيعي = 0;
                دع الطول_الأعلى: متغير طبيعي = 0;
                دع النوع: متغير ط8 = 0;
                غير_آمن {
                    الطول_الأدنى := المدخل[18] مثل طبيعي;
                    الطول_الأعلى := المدخل[19] مثل طبيعي;
                    النوع := المدخل[20];
                }
                دع طول_الاسم: طبيعي = الطول_الأدنى + (الطول_الأعلى * 256);
                لو (طول_الاسم > 1023) {
                    دع الإغلاق: ص32 = closedir(الدليل);
                    أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
                };
                دع اسم_المدخل: متغير متجه ط8 = [];
                دع ف: متغير طبيعي = 0;
                طالما (ف < طول_الاسم) {
                    دع البايت: متغير ط8 = 0;
                    غير_آمن { البايت := المدخل[21 + ف]; }
                    ألحق(اسم_المدخل, البايت);
                    ف := ف + 1;
                }
                دع خاص: منطقي = (طول_الاسم == 1 && اسم_المدخل[0] == 46)
                    || (طول_الاسم == 2 && اسم_المدخل[0] == 46 && اسم_المدخل[1] == 46);
                لو (!خاص) {
                    دع الناتج_المقروء: مدخل_دليل_داروين = { الاسم: اسم_المدخل, النوع: النوع };
                    ألحق(الناتج, الناتج_المقروء);
                };
            };
        }
        أرجع نتيجة.نجح(الناتج);
    };
}

عام عرف أنشئ_دليل_داروين(المسار: &متجه ط8, الوضع: ط16): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        لو (mkdir(&الاسم[0], الوضع) < 0) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف أزل_دليل_داروين(المسار: &متجه ط8): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        لو (rmdir(&الاسم[0]) < 0) {
            أرجع نتيجة.خطأ(خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي()));
        };
        أرجع نتيجة.نجح(0);
    };
}
