استورد os.buffer;
استورد os.path;
استورد os.error;

// Darwin file-descriptor provider. On macOS the supported kernel interface is
// libSystem (libsystem_kernel); the raw syscall ABI is private and unstable,
// so these are the platform's system-call entry points, in the same role as
// the Win32 provider's kernel32 declarations. No libc stdio is used.
// Variadic entry points (open/fcntl) are only called with their fixed
// arguments: on Apple arm64 variadic arguments travel on the stack.
// Every declaration names libSystem's install name, as Go's darwin port names
// "/usr/lib/libSystem.B.dylib" in each cgo_import_dynamic directive.
// Signatures follow the macOS SDK headers (<unistd.h>, <fcntl.h>,
// <sys/stat.h>, <stdio.h> for rename): mode_t is u16, off_t i64, size_t u64.
خارجي «/usr/lib/libSystem.B.dylib» عرف __error(): *متغير ص32;
// open(2) with its variadic mode: on arm64 the mode travels on the stack, so
// x2-x7 are six unused fixed arguments and the mode is the ninth, which the
// standard ABI places at [sp]; on x86-64 it is the third (sockets.sn fcntl).
إذا (الهدف.المعمارية == «aarch64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف open_بوضع_داروين(
        المسار: *ط8, الأعلام: ص32,
        غير2: ط64, غير3: ط64, غير4: ط64, غير5: ط64, غير6: ط64, غير7: ط64,
        الوضع: ط64
    ): ص32 = «open»;
    عام عرف افتح_بوضع_داروين(المسار: *ط8, الأعلام: ص32, الوضع: ط64): ص32 {
        أرجع open_بوضع_داروين(المسار, الأعلام, 0, 0, 0, 0, 0, 0, الوضع);
    }
}
إذا (الهدف.المعمارية != «aarch64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف open_بوضع_داروين(المسار: *ط8, الأعلام: ص32, الوضع: ط64): ص32 = «open»;
    عام عرف افتح_بوضع_داروين(المسار: *ط8, الأعلام: ص32, الوضع: ط64): ص32 {
        أرجع open_بوضع_داروين(المسار, الأعلام, الوضع);
    }
}
// open(2) without a mode. An ordinary function, not a second extern of the
// C symbol "open": one symbol takes one declaration.
عام عرف open(المسار: *ط8, الأعلام: ص32): ص32 { أرجع افتح_بوضع_داروين(المسار, الأعلام, 0); }
عام خارجي «/usr/lib/libSystem.B.dylib» عرف creat(المسار: *ط8, الوضع: ط16): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف read(الواصف: ص32, المخزن: *متغير ط8, العدد: ط64): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف write(الواصف: ص32, المخزن: *ط8, العدد: ط64): ص64;
// Shared with the socket provider (sockets.sn), which closes descriptors too.
عام خارجي «/usr/lib/libSystem.B.dylib» عرف close(الواصف: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف lseek(الواصف: ص32, الإزاحة: ص64, الأصل: ص32): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف fsync(الواصف: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف fchmod(الواصف: ص32, الوضع: ط16): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف rename(الأصل: *ط8, الوجهة: *ط8): ص32;
عام خارجي «/usr/lib/libSystem.B.dylib» عرف unlink(المسار: *ط8): ص32;
// std reads the 64-bit-inode struct stat (اقرأ_معلومات_مسار_داروين). arm64
// macOS has only that ABI, under the plain name. x86_64 macOS keeps the
// legacy 32-bit-inode `stat` under the plain name, and <sys/stat.h> binds the
// 64-bit-inode one to `stat$INODE64` (__DARWIN_INODE64), as Rust's libc does
// with link_name = "stat$INODE64".
إذا (الهدف.المعمارية == «x86_64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف stat(المسار: *ط8, المعلومات: *متغير ط8): ص32 = «stat$INODE64»;
} وإلا {
    خارجي «/usr/lib/libSystem.B.dylib» عرف stat(المسار: *ط8, المعلومات: *متغير ط8): ص32;
}

عام نوع خطأ_واصف_داروين =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | كتابة_بلا_تقدم
    | واصف_مغلق
    | نظام بنوع خطأ_نظام_أصلي
;

// A Darwin descriptor is a C int (ص32), what libSystem takes and returns.
عام نوع واصف_ملف_داروين = { القيمة: ص32, مفتوح: منطقي };

// A descriptor held at portable width (the os-level ط64 file handle) back
// as a C int. A value outside the int range is no descriptor: it becomes
// -1, which the next call rejects with EBADF, rather than the low bits of
// another descriptor.
عام عرف واصف_داروين_من_ط64(القيمة: ط64): ص32 {
    إذا (القيمة > 2147483647) { أرجع -1; };
    أرجع القيمة مثل ص32;
}

// The single Darwin mapping onto the portable std.os boundary error.
عام عرف خطأ_واصف_داروين_للنظام(الخطأ: خطأ_واصف_داروين): خطأ_حد_نظام {
    طابق الخطأ مع
    | خطأ_واصف_داروين.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_داروين.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_داروين.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
    | خطأ_واصف_داروين.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
    | خطأ_واصف_داروين.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
}

// errno must be captured immediately after the failing call.
عام عرف خطأ_داروين_الحالي(): خطأ_نظام_أصلي {
    دع المؤشر: *متغير ص32 = __error();
    دع الرمز: متغير ص32 = 0;
    إذا (المؤشر != الفارغ) {
        غير_آمن { الرمز := المؤشر[0]; }
    };
    أرجع أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الرمز مثل عدد);
}

// Calls that report failure only through errno (readdir) clear it first.
عام عرف اضبط_خطأ_داروين_صفرا(): فراغ {
    دع المؤشر: *متغير ص32 = __error();
    إذا (المؤشر != الفارغ) {
        غير_آمن { المؤشر[0] := 0; }
    };
}

عرف فشل_واصف_داروين(): خطأ_واصف_داروين {
    أرجع خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي());
}

// O_RDONLY | O_CLOEXEC (0x1000000). Write creation uses creat(2), which is
// open(O_CREAT|O_WRONLY|O_TRUNC, mode) without variadic arguments.
عام عرف افتح_واصف_داروين(
    المسار: &متجه ط8, للكتابة: منطقي, الوضع: ط16
): نتيجة واصف_ملف_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع الناتج: متغير ص32 = -1;
        إذا (للكتابة) {
            الناتج := creat(&الاسم[0], الوضع);
        } وإلا {
            الناتج := open(&الاسم[0], 0x1000000);
        };
        إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
        دع الواصف: واصف_ملف_داروين = { القيمة: الناتج, مفتوح: صواب };
        أرجع نتيجة.نجح(الواصف);
    };
}

عام عرف اقرأ_واصف_داروين(
    الواصف: &واصف_ملف_داروين, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    // Darwin rejects transfers above INT_MAX with EINVAL.
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع الناتج: ص64 = read(
        (*الواصف).القيمة, &متغير (*المخزن)[الإزاحة مثل طبيعي], الطلب مثل ط64
    );
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل ط64);
}

عام عرف اكتب_واصف_داروين(
    الواصف: &واصف_ملف_داروين, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع الناتج: ص64 = write(
        (*الواصف).القيمة, &(*المحتوى)[الإزاحة مثل طبيعي], الطلب مثل ط64
    );
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل ط64);
}

// close consumes the descriptor even when it reports EINTR; never retry it.
عام عرف أغلق_واصف_داروين(
    الواصف: &متغير واصف_ملف_داروين
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    دع الناتج: ص32 = close((*الواصف).القيمة);
    (*الواصف).مفتوح := خطأ;
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(0);
}

عام عرف حرك_واصف_داروين(
    الواصف: &واصف_ملف_داروين, الإزاحة: ص64, الأصل: ط64
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    إذا (الأصل > 2) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    دع الناتج: ص64 = lseek((*الواصف).القيمة, الإزاحة, الأصل مثل ص32);
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل ط64);
}

عام عرف زامن_واصف_داروين(الواصف: &واصف_ملف_داروين): نتيجة ط64, خطأ_واصف_داروين {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    دع الناتج: ص32 = fsync((*الواصف).القيمة);
    إذا (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(0);
}

// Raw fd 0/1/2 are borrowed from process startup; never close them here.
عام عرف اقرأ_دخل_داروين(
    المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_داروين {
    دع الدخل: واصف_ملف_داروين = { القيمة: 0, مفتوح: صواب };
    أرجع اقرأ_واصف_داروين(&الدخل, المخزن, الإزاحة, المطلوب);
}

عام عرف اكتب_تيار_داروين(
    الواصف: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_داروين {
    إذا (الواصف != 1 && الواصف != 2) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    دع التيار: واصف_ملف_داروين = { القيمة: واصف_داروين_من_ط64(الواصف), مفتوح: صواب };
    أرجع اكتب_واصف_داروين(&التيار, المحتوى, الإزاحة, المطلوب);
}

// Complete executable output: create/truncate, write every byte (retrying
// EINTR without losing partial progress), set 0755 and close exactly once.
عام عرف اكتب_بايتات_تنفيذية_داروين(
    المسار: &متجه ط8, البايتات: &متجه ط8
): نتيجة ط64, خطأ_واصف_داروين {
    دع الملف: متغير واصف_ملف_داروين;
    طابق افتح_واصف_داروين(المسار, صواب, 493) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الواصف) -> { الملف := الواصف; };
    دع الكلي: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع المكتوب: متغير طبيعي = 0;
    طالما (المكتوب < الكلي) {
        دع الباقي: طبيعي = الكلي - المكتوب;
        طابق اكتب_واصف_داروين(&الملف, البايتات, المكتوب مثل عدد, الباقي مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع إعادة: متغير منطقي = خطأ;
            طابق الخطأ مع
            | خطأ_واصف_داروين.نظام(الأصلي) -> { إعادة := الأصلي.الرمز == 4; }
            | _ -> { };
            إذا (!إعادة) {
                دع التنظيف: نتيجة ط64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
                أرجع نتيجة.خطأ(الخطأ);
            };
        }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد == 0) {
                دع التنظيف: نتيجة ط64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
                أرجع نتيجة.خطأ(خطأ_واصف_داروين.كتابة_بلا_تقدم());
            };
            المكتوب := المكتوب + (العدد مثل طبيعي);
        };
    }
    // creat(2) keeps an existing file's mode; make the output executable.
    إذا (fchmod(الملف.القيمة مثل ص32, 493) < 0) {
        دع خطأ_الوضع: خطأ_واصف_داروين = فشل_واصف_داروين();
        دع التنظيف: نتيجة ط64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
        أرجع نتيجة.خطأ(خطأ_الوضع);
    };
    طابق أغلق_واصف_داروين(&متغير الملف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(الكلي مثل ط64);
}

عام عرف أعد_تسمية_داروين(
    الأصل: &متجه ط8, الوجهة: &متجه ط8
): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(مخزن_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(الوجهة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
        | نتيجة.نجح(مخزن_الوجهة) -> {
            دع أ: متجه ط8 = مخزن_الأصل;
            دع ب: متجه ط8 = مخزن_الوجهة;
            إذا (rename(&أ[0], &ب[0]) < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

عام عرف احذف_ملف_داروين(المسار: &متجه ط8): نتيجة ط64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        إذا (unlink(&الاسم[0]) < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
        أرجع نتيجة.نجح(0);
    };
}

// struct stat with the 64-bit inode layout (144 bytes; arm64, and x86_64
// through stat$INODE64):
// st_mode u16 @4, st_mtimespec {i64 sec, i64 nsec} @48, st_size i64 @96.
عام نوع معلومات_مسار_داروين = {
    الوضع: ط16,
    الحجم: ط64,
    التعديل_بالثواني: ص64,
    التعديل_بالنانو: ص64
};

عرف اقرأ_ط64_داروين(البايتات: &متجه ط8, البداية: طبيعي): ط64 {
    دع القيمة: متغير ط64 = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 8) {
        دع البايت: ط64 = (*البايتات)[البداية + الفهرس] مثل ط64;
        القيمة := القيمة | (البايت << (الفهرس * 8));
        الفهرس := الفهرس + 1;
    }
    أرجع القيمة;
}

عام عرف اقرأ_معلومات_مسار_داروين(
    المسار: &متجه ط8
): نتيجة معلومات_مسار_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه ط8 = البايتات;
        دع المعلومات: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < 144) { ألحق(المعلومات, 0); ف := ف + 1; }
        إذا (stat(&الاسم[0], &متغير المعلومات[0]) < 0) {
            أرجع نتيجة.خطأ(فشل_واصف_داروين());
        };
        دع الوضع_الأدنى: ط16 = المعلومات[4] مثل ط16;
        دع الوضع_الأعلى: ط16 = المعلومات[5] مثل ط16;
        دع الناتج: معلومات_مسار_داروين = {
            الوضع: الوضع_الأدنى | (الوضع_الأعلى << 8),
            الحجم: اقرأ_ط64_داروين(&المعلومات, 96),
            التعديل_بالثواني: اقرأ_ط64_داروين(&المعلومات, 48) مثل ص64,
            التعديل_بالنانو: اقرأ_ط64_داروين(&المعلومات, 56) مثل ص64
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

خارجي «/usr/lib/libSystem.B.dylib» عرف getcwd(المخزن: *متغير ط8, الحجم: ط64): *متغير ط8;

// Current working directory bytes, without the terminating NUL.
عام عرف اقرأ_دليل_عمل_داروين(السعة: طبيعي): نتيجة متجه ط8, خطأ_واصف_داروين {
    إذا (السعة == 0) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    // PATH_MAX is 1024 on Darwin; one extra byte holds the NUL.
    دع الحجم: طبيعي = 1025;
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الحجم) { ألحق(المخزن, 0); ف := ف + 1; }
    دع الناتج: *متغير ط8 = getcwd(&متغير المخزن[0], الحجم مثل ط64);
    إذا (الناتج == الفارغ) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    دع المسار: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < الحجم && المخزن[الموضع] != 0) {
        ألحق(المسار, المخزن[الموضع]);
        الموضع := الموضع + 1;
    }
    إذا ((الطول(المسار) مثل طبيعي) > السعة) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    أرجع نتيجة.نجح(المسار);
}
