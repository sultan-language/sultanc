استورد os.buffer;
استورد os.path;
استورد os.error;

// Darwin file-descriptor provider. On macOS the supported kernel interface is
// libSystem (libsystem_kernel); the raw syscall ABI is private and unstable,
// so these are the platform's system-call entry points, in the same role as
// the Win32 provider's kernel32 declarations. No libc stdio is used.
// Variadic entry points (open/fcntl) are only called with their fixed
// arguments: on Apple arm64 variadic arguments travel on the stack.
خارجي عرف __error(): *متغير ص32;
خارجي عرف open(المسار: *غ8, الأعلام: ص32): ص32;
خارجي عرف creat(المسار: *غ8, الوضع: غ16): ص32;
خارجي عرف read(الواصف: ص32, المخزن: *متغير غ8, العدد: غ64): ص64;
خارجي عرف write(الواصف: ص32, المخزن: *غ8, العدد: غ64): ص64;
خارجي عرف close(الواصف: ص32): ص32;
خارجي عرف lseek(الواصف: ص32, الإزاحة: ص64, الأصل: ص32): ص64;
خارجي عرف fsync(الواصف: ص32): ص32;
خارجي عرف fchmod(الواصف: ص32, الوضع: غ16): ص32;
خارجي عرف rename(الأصل: *غ8, الوجهة: *غ8): ص32;
خارجي عرف unlink(المسار: *غ8): ص32;
خارجي عرف stat(المسار: *غ8, المعلومات: *متغير غ8): ص32;

عام نوع خطأ_واصف_داروين =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | كتابة_بلا_تقدم
    | واصف_مغلق
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع واصف_ملف_داروين = { القيمة: غ64, مفتوح: منطقي };

// The single Darwin mapping onto the portable std.os boundary error.
عام عرف خطأ_واصف_داروين_للنظام(الخطأ: خطأ_واصف_داروين): خطأ_حد_نظام {
    طابق الخطأ مع
    | خطأ_واصف_داروين.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_داروين.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
    | خطأ_واصف_داروين.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); }
    | خطأ_واصف_داروين.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
    | خطأ_واصف_داروين.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
}

// errno must be captured immediately after the failing call.
عام عرف خطأ_داروين_الحالي(): خطأ_نظام_أصلي {
    دع المؤشر: *متغير ص32 = __error();
    دع الرمز: متغير ص32 = 0;
    لو (المؤشر != الفارغ) {
        غير_آمن { الرمز := المؤشر[0]; }
    };
    أرجع أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الرمز مثل عدد);
}

// Calls that report failure only through errno (readdir) clear it first.
عام عرف اضبط_خطأ_داروين_صفرا(): فراغ {
    دع المؤشر: *متغير ص32 = __error();
    لو (المؤشر != الفارغ) {
        غير_آمن { المؤشر[0] := 0; }
    };
}

عرف فشل_واصف_داروين(): خطأ_واصف_داروين {
    أرجع خطأ_واصف_داروين.نظام(خطأ_داروين_الحالي());
}

// O_RDONLY | O_CLOEXEC (0x1000000). Write creation uses creat(2), which is
// open(O_CREAT|O_WRONLY|O_TRUNC, mode) without variadic arguments.
عام عرف افتح_واصف_داروين(
    المسار: &متجه غ8, للكتابة: منطقي, الوضع: غ16
): نتيجة واصف_ملف_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        دع الناتج: متغير ص32 = -1;
        لو (للكتابة) {
            الناتج := creat(&الاسم[0], الوضع);
        } وإلا {
            الناتج := open(&الاسم[0], 0x1000000);
        };
        لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
        دع الواصف: واصف_ملف_داروين = { القيمة: الناتج مثل غ64, مفتوح: صواب };
        أرجع نتيجة.نجح(الواصف);
    };
}

عام عرف اقرأ_واصف_داروين(
    الواصف: &واصف_ملف_داروين, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_داروين {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    // Darwin rejects transfers above INT_MAX with EINVAL.
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع الناتج: ص64 = read(
        (*الواصف).القيمة مثل ص32, &متغير (*المخزن)[الإزاحة مثل غير_موقع], الطلب مثل غ64
    );
    لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل غ64);
}

عام عرف اكتب_واصف_داروين(
    الواصف: &واصف_ملف_داروين, المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_داروين {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع الناتج: ص64 = write(
        (*الواصف).القيمة مثل ص32, &(*المحتوى)[الإزاحة مثل غير_موقع], الطلب مثل غ64
    );
    لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل غ64);
}

// close consumes the descriptor even when it reports EINTR; never retry it.
عام عرف أغلق_واصف_داروين(
    الواصف: &متغير واصف_ملف_داروين
): نتيجة غ64, خطأ_واصف_داروين {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    دع الناتج: ص32 = close((*الواصف).القيمة مثل ص32);
    (*الواصف).مفتوح := خطأ;
    لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(0);
}

عام عرف حرك_واصف_داروين(
    الواصف: &واصف_ملف_داروين, الإزاحة: ص64, الأصل: غ64
): نتيجة غ64, خطأ_واصف_داروين {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    لو (الأصل > 2) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    دع الناتج: ص64 = lseek((*الواصف).القيمة مثل ص32, الإزاحة, الأصل مثل ص32);
    لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(الناتج مثل غ64);
}

عام عرف زامن_واصف_داروين(الواصف: &واصف_ملف_داروين): نتيجة غ64, خطأ_واصف_داروين {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.واصف_مغلق()); };
    دع الناتج: ص32 = fsync((*الواصف).القيمة مثل ص32);
    لو (الناتج < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    أرجع نتيجة.نجح(0);
}

// Raw fd 0/1/2 are borrowed from process startup; never close them here.
عام عرف اقرأ_دخل_داروين(
    المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_داروين {
    دع الدخل: واصف_ملف_داروين = { القيمة: 0, مفتوح: صواب };
    أرجع اقرأ_واصف_داروين(&الدخل, المخزن, الإزاحة, المطلوب);
}

عام عرف اكتب_تيار_داروين(
    الواصف: غ64, المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_داروين {
    لو (الواصف != 1 && الواصف != 2) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    دع التيار: واصف_ملف_داروين = { القيمة: الواصف, مفتوح: صواب };
    أرجع اكتب_واصف_داروين(&التيار, المحتوى, الإزاحة, المطلوب);
}

// Complete executable output: create/truncate, write every byte (retrying
// EINTR without losing partial progress), set 0755 and close exactly once.
عام عرف اكتب_بايتات_تنفيذية_داروين(
    المسار: &متجه غ8, البايتات: &متجه غ8
): نتيجة غ64, خطأ_واصف_داروين {
    دع الملف: متغير واصف_ملف_داروين;
    طابق افتح_واصف_داروين(المسار, صواب, 493) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الواصف) -> { الملف := الواصف; };
    دع الكلي: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    دع المكتوب: متغير غير_موقع = 0;
    بينما (المكتوب < الكلي) {
        دع الباقي: غير_موقع = الكلي - المكتوب;
        طابق اكتب_واصف_داروين(&الملف, البايتات, المكتوب مثل عدد, الباقي مثل عدد) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع إعادة: متغير منطقي = خطأ;
            طابق الخطأ مع
            | خطأ_واصف_داروين.نظام(الأصلي) -> { إعادة := الأصلي.الرمز == 4; }
            | _ -> { };
            لو (!إعادة) {
                دع التنظيف: نتيجة غ64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
                أرجع نتيجة.خطأ(الخطأ);
            };
        }
        | نتيجة.نجح(العدد) -> {
            لو (العدد == 0) {
                دع التنظيف: نتيجة غ64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
                أرجع نتيجة.خطأ(خطأ_واصف_داروين.كتابة_بلا_تقدم());
            };
            المكتوب := المكتوب + (العدد مثل غير_موقع);
        };
    }
    // creat(2) keeps an existing file's mode; make the output executable.
    لو (fchmod(الملف.القيمة مثل ص32, 493) < 0) {
        دع خطأ_الوضع: خطأ_واصف_داروين = فشل_واصف_داروين();
        دع التنظيف: نتيجة غ64, خطأ_واصف_داروين = أغلق_واصف_داروين(&متغير الملف);
        أرجع نتيجة.خطأ(خطأ_الوضع);
    };
    طابق أغلق_واصف_داروين(&متغير الملف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(الكلي مثل غ64);
}

عام عرف أعد_تسمية_داروين(
    الأصل: &متجه غ8, الوجهة: &متجه غ8
): نتيجة غ64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(مخزن_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(الوجهة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
        | نتيجة.نجح(مخزن_الوجهة) -> {
            دع أ: متجه غ8 = مخزن_الأصل;
            دع ب: متجه غ8 = مخزن_الوجهة;
            لو (rename(&أ[0], &ب[0]) < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

عام عرف احذف_ملف_داروين(المسار: &متجه غ8): نتيجة غ64, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        لو (unlink(&الاسم[0]) < 0) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
        أرجع نتيجة.نجح(0);
    };
}

// struct stat on Darwin arm64 (64-bit inode layout, 144 bytes):
// st_mode u16 @4, st_mtimespec {i64 sec, i64 nsec} @48, st_size i64 @96.
عام نوع معلومات_مسار_داروين = {
    الوضع: غ16,
    الحجم: غ64,
    التعديل_بالثواني: ص64,
    التعديل_بالنانو: ص64
};

عرف اقرأ_غ64_داروين(البايتات: &متجه غ8, البداية: غير_موقع): غ64 {
    دع القيمة: متغير غ64 = 0;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 8) {
        دع البايت: غ64 = (*البايتات)[البداية + الفهرس] مثل غ64;
        القيمة := القيمة | (البايت << (الفهرس * 8));
        الفهرس := الفهرس + 1;
    }
    أرجع القيمة;
}

عام عرف اقرأ_معلومات_مسار_داروين(
    المسار: &متجه غ8
): نتيجة معلومات_مسار_داروين, خطأ_واصف_داروين {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متجه غ8 = البايتات;
        دع المعلومات: متغير متجه غ8 = [];
        دع ف: متغير غير_موقع = 0;
        بينما (ف < 144) { ألحق(المعلومات, 0); ف := ف + 1; }
        لو (stat(&الاسم[0], &متغير المعلومات[0]) < 0) {
            أرجع نتيجة.خطأ(فشل_واصف_داروين());
        };
        دع الوضع_الأدنى: غ16 = المعلومات[4] مثل غ16;
        دع الوضع_الأعلى: غ16 = المعلومات[5] مثل غ16;
        دع الناتج: معلومات_مسار_داروين = {
            الوضع: الوضع_الأدنى | (الوضع_الأعلى << 8),
            الحجم: اقرأ_غ64_داروين(&المعلومات, 96),
            التعديل_بالثواني: اقرأ_غ64_داروين(&المعلومات, 48) مثل ص64,
            التعديل_بالنانو: اقرأ_غ64_داروين(&المعلومات, 56) مثل ص64
        };
        أرجع نتيجة.نجح(الناتج);
    };
}

خارجي عرف getcwd(المخزن: *متغير غ8, الحجم: غ64): *متغير غ8;

// Current working directory bytes, without the terminating NUL.
عام عرف اقرأ_دليل_عمل_داروين(السعة: غير_موقع): نتيجة متجه غ8, خطأ_واصف_داروين {
    لو (السعة == 0) { أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح()); };
    // PATH_MAX is 1024 on Darwin; one extra byte holds the NUL.
    دع الحجم: غير_موقع = 1025;
    دع المخزن: متغير متجه غ8 = [];
    دع ف: متغير غير_موقع = 0;
    بينما (ف < الحجم) { ألحق(المخزن, 0); ف := ف + 1; }
    دع الناتج: *متغير غ8 = getcwd(&متغير المخزن[0], الحجم مثل غ64);
    لو (الناتج == الفارغ) { أرجع نتيجة.خطأ(فشل_واصف_داروين()); };
    دع المسار: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < الحجم && المخزن[الموضع] != 0) {
        ألحق(المسار, المخزن[الموضع]);
        الموضع := الموضع + 1;
    }
    لو ((الطول(المسار) مثل غير_موقع) > السعة) {
        أرجع نتيجة.خطأ(خطأ_واصف_داروين.نطاق_غير_صالح());
    };
    أرجع نتيجة.نجح(المسار);
}
