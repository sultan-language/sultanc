استورد os.error;
استورد os.buffer;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Darwin sockets use libSystem's public POSIX entry points, not private
// Darwin kernel syscall numbers.  socklen_t is u32; size_t/ssize_t are 64-bit
// on the registered arm64 Darwin target.  Native sockaddr bytes (including
// sin_len/sin6_len) are prepared by os.platform.unix.bsd.socket_address.
// References: Apple XNU bsd/sys/socket.h, bsd/netinet6/in6.h; Apple socket(2),
// accept(2), setsockopt(2), getaddrinfo(3) and POSIX sys/socket.h.
خارجي «/usr/lib/libSystem.B.dylib» عرف socket(العائلة: ص32, النوع: ص32, البروتوكول: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف connect(المقبس: ص32, العنوان: *ط8, الطول: ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف bind(المقبس: ص32, العنوان: *ط8, الطول: ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف listen(المقبس: ص32, التراكم: ص32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف accept(المقبس: ص32, العنوان: *متغير ط8, الطول: *متغير ط32): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف send(المقبس: ص32, المحتوى: *ط8, الطول: ط64, الأعلام: ص32): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف recv(المقبس: ص32, المحتوى: *متغير ط8, الطول: ط64, الأعلام: ص32): ص64;
خارجي «/usr/lib/libSystem.B.dylib» عرف shutdown(المقبس: ص32, الاتجاه: ص32): ص32;
// fcntl(2) is variadic. Apple's arm64 ABI passes a variadic argument on the
// stack, at [sp], while fixed arguments use x0-x7; x86-64 passes it in a
// register like a fixed one. So on arm64 the call names six unused fixed
// arguments (x2-x7) and the value as a ninth, 8-byte argument, which the
// standard ABI places exactly at [sp] (Nahr item 13), as Go's darwin
// trampolines and Rust's libc call it; on x86-64 it is the third argument.
إذا (الهدف.المعمارية == «aarch64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف fcntl_داروين(
        الواصف: ص32, الأمر: ص32,
        غير2: ط64, غير3: ط64, غير4: ط64, غير5: ط64, غير6: ط64, غير7: ط64,
        القيمة: ط64
    ): ص32 = «fcntl»;
    عرف نادي_fcntl_داروين(الواصف: ص32, الأمر: ص32, القيمة: ط64): ص32 {
        أرجع fcntl_داروين(الواصف, الأمر, 0, 0, 0, 0, 0, 0, القيمة);
    }
}
إذا (الهدف.المعمارية != «aarch64») {
    خارجي «/usr/lib/libSystem.B.dylib» عرف fcntl_داروين(الواصف: ص32, الأمر: ص32, القيمة: ط64): ص32 = «fcntl»;
    عرف نادي_fcntl_داروين(الواصف: ص32, الأمر: ص32, القيمة: ط64): ص32 {
        أرجع fcntl_داروين(الواصف, الأمر, القيمة);
    }
}

خارجي «/usr/lib/libSystem.B.dylib» عرف setsockopt(
    المقبس: ص32, المستوى: ص32, الخيار: ص32, القيمة: *ص32, الطول: ط32
): ص32;

// Apple getaddrinfo returns an owned linked list. Apple's <netdb.h> (the BSD
// layout, as FreeBSD and Rust's libc for Apple) declares struct addrinfo as
// ai_flags, ai_family, ai_socktype, ai_protocol, ai_addrlen (socklen_t),
// ai_canonname, ai_addr, ai_next: ai_canonname at 24 precedes ai_addr at 32,
// the reverse of glibc's Linux layout. Previously the record followed the
// Linux order, so ai_addr was read from ai_canonname (NULL without
// AI_CANONNAME) and every lookup failed.
نوع معلومات_عنوان_داروين_أصلية = {
    الأعلام: ص32,
    العائلة: ص32,
    النوع: ص32,
    البروتوكول: ص32,
    الطول: ط32,
    الاسم_القانوني: *ط8,
    العنوان: *ط8,
    التالي: *معلومات_عنوان_داروين_أصلية
};
خارجي «/usr/lib/libSystem.B.dylib» عرف getaddrinfo(
    المضيف: *ط8, الخدمة: *ط8,
    التلميحات: *معلومات_عنوان_داروين_أصلية,
    النتائج: *متغير *معلومات_عنوان_داروين_أصلية
): ص32;
خارجي «/usr/lib/libSystem.B.dylib» عرف freeaddrinfo(النتائج: *معلومات_عنوان_داروين_أصلية): فراغ;

عام نوع خطأ_مقبس_داروين =
    | مغلق
    | نطاق_غير_صالح
    | حل_اسم_فشل
    | نظام بنوع خطأ_نظام_أصلي
;
عام نوع مقبس_داروين = { القيمة: ص32, مفتوح: منطقي };

عرف فشل_مقبس_داروين(): خطأ_مقبس_داروين {
    أرجع خطأ_مقبس_داروين.نظام(خطأ_داروين_الحالي());
}

// SO_NOSIGPIPE prevents a disconnected client from terminating an HTTP
// server with SIGPIPE.  A failed initialization closes its descriptor.
عام عرف أنشئ_مقبس_داروين(
    العائلة: ص32, النوع: ص32, البروتوكول: ص32
): نتيجة مقبس_داروين, خطأ_مقبس_داروين {
    دع الواصف: ص32 = socket(العائلة, النوع, البروتوكول);
    إذا (الواصف < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    دع نعم: ص32 = 1;
    إذا (setsockopt(الواصف, 0xffff, 0x1022, &نعم, 4) < 0) {
        دع الخطأ: خطأ_مقبس_داروين = فشل_مقبس_داروين();
        دع تجاهل: ص32 = close(الواصف);
        أرجع نتيجة.خطأ(الخطأ);
    };
    دع المقبس: مقبس_داروين = { القيمة: الواصف, مفتوح: صواب };
    أرجع نتيجة.نجح(المقبس);
}

عام عرف ضع_عنوان_مقبس_داروين(
    المقبس: &مقبس_داروين, العنوان: &متجه ط8, ربط: منطقي
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع الحجم: طبيعي = الطول(*العنوان) مثل طبيعي;
    // sockaddr_in (16), sockaddr_in6 (28), or a sockaddr_un (AF_UNIX 1) of
    // sun_len, sun_family and up to 104 path bytes; sun_len is the length.
    دع يونكس: منطقي = الحجم >= 3 && الحجم <= 106 && (*العنوان)[1] == 1;
    إذا ((الحجم != 16 && الحجم != 28 && !يونكس) || (*العنوان)[0] != (الحجم مثل ط8)) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع الحالة: ص32;
    إذا (ربط) { الحالة := bind((*المقبس).القيمة, &(*العنوان)[0], الحجم مثل ط32); }
    وإلا { الحالة := connect((*المقبس).القيمة, &(*العنوان)[0], الحجم مثل ط32); };
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف استمع_مقبس_داروين(
    المقبس: &مقبس_داروين, التراكم: ص32
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح || التراكم < 0) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع الحالة: ص32 = listen((*المقبس).القيمة, التراكم);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف اقبل_مقبس_داروين(
    المستمع: &مقبس_داروين
): نتيجة مقبس_داروين, خطأ_مقبس_داروين {
    إذا (!(*المستمع).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    // POSIX permits NULL,NULL when the peer address is not requested.
    دع الواصف: ص32 = accept((*المستمع).القيمة, الفارغ, الفارغ);
    إذا (الواصف < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    دع نعم: ص32 = 1;
    إذا (setsockopt(الواصف, 0xffff, 0x1022, &نعم, 4) < 0) {
        دع الخطأ: خطأ_مقبس_داروين = فشل_مقبس_داروين();
        دع تجاهل: ص32 = close(الواصف);
        أرجع نتيجة.خطأ(الخطأ);
    };
    دع الطفل: مقبس_داروين = { القيمة: الواصف, مفتوح: صواب };
    أرجع نتيجة.نجح(الطفل);
}

عام عرف أرسل_مقبس_داروين(
    المقبس: &مقبس_داروين, المحتوى: &متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, العدد)) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع الطلب: متغير عدد = العدد;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    إذا (الطلب == 0) { أرجع نتيجة.نجح(0); };
    دع الحالة: ص64 = send(
        (*المقبس).القيمة, &(*المحتوى)[الإزاحة مثل طبيعي], الطلب مثل ط64, 0
    );
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف استقبل_مقبس_داروين(
    المقبس: &مقبس_داروين, المخزن: &متغير متجه ط8, الإزاحة: عدد, العدد: عدد
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, العدد)) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع الطلب: متغير عدد = العدد;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    إذا (الطلب == 0) { أرجع نتيجة.نجح(0); };
    دع الحالة: ص64 = recv(
        (*المقبس).القيمة, &متغير (*المخزن)[الإزاحة مثل طبيعي], الطلب مثل ط64, 0
    );
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

// O_NONBLOCK through fcntl(F_GETFL = 3) and fcntl(F_SETFL = 4); Darwin's
// O_NONBLOCK is 0x4. The descriptor flags keep every other bit.
عام عرف اضبط_مقبس_داروين_غير_حاصر(المقبس: &مقبس_داروين, مفعل: منطقي): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع الأعلام: ص32 = نادي_fcntl_داروين((*المقبس).القيمة, 3, 0);
    إذا (الأعلام < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    دع الجديدة: متغير ص32 = الأعلام | 4;
    إذا (!مفعل) { الجديدة := الأعلام & ~(4 مثل ص32); };
    إذا (الجديدة == الأعلام) { أرجع نتيجة.نجح(0); };
    إذا (نادي_fcntl_داروين((*المقبس).القيمة, 4, (الجديدة مثل ط32) مثل ط64) < 0) {
        أرجع نتيجة.خطأ(فشل_مقبس_داروين());
    };
    أرجع نتيجة.نجح(0);
}

عام عرف أوقف_مقبس_داروين(
    المقبس: &مقبس_داروين, الاتجاه: ص32
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    إذا (الاتجاه < 0 || الاتجاه > 2) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح()); };
    دع الحالة: ص32 = shutdown((*المقبس).القيمة, الاتجاه);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف اضبط_خيار_عدد_مقبس_داروين(
    المقبس: &مقبس_داروين, المستوى: ص32, الخيار: ص32, القيمة: ص32
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع المعطى: ص32 = القيمة;
    دع الحالة: ص32 = setsockopt((*المقبس).القيمة, المستوى, الخيار, &المعطى, 4);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

// SO_RCVTIMEO 0x1006 / SO_SNDTIMEO 0x1005 take a struct timeval: a 64-bit
// tv_sec, a 32-bit tv_usec and 4 bytes of padding (16 bytes, little-endian
// on both Darwin ABIs). 0 ms clears the timeout.
عام عرف اضبط_مهلة_مقبس_داروين(
    المقبس: &مقبس_داروين, استقبال: منطقي, المللي: عدد
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع الخيار: متغير ص32 = 0x1006;
    إذا (!استقبال) { الخيار := 0x1005; };
    دع الزمن: متغير متجه ص32 = [];
    ألحق(الزمن, (المللي / 1000) مثل ص32);
    ألحق(الزمن, 0);
    ألحق(الزمن, ((المللي % 1000) * 1000) مثل ص32);
    ألحق(الزمن, 0);
    دع الحالة: ص32 = setsockopt((*المقبس).القيمة, 0xffff, الخيار, &متغير الزمن[0], 16);
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف أغلق_مقبس_داروين(
    المقبس: &متغير مقبس_داروين
): نتيجة عدد, خطأ_مقبس_داروين {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.مغلق()); };
    دع الحالة: ص32 = close((*المقبس).القيمة);
    // POSIX close, including EINTR, must never be blindly retried:
    // the file descriptor may already have been reassigned.
    (*المقبس).مفتوح := خطأ;
    إذا (الحالة < 0) { أرجع نتيجة.خطأ(فشل_مقبس_داروين()); };
    أرجع نتيجة.نجح(0);
}

// POSIX getaddrinfo reports EAI_* status directly, not errno (except EAI_SYSTEM).
// Return the std.net.dns compact owned IP encoding [family, len, 0, 0, IP...].
عام عرف حل_اسم_مضيف_داروين(
    المضيف: &نص, العائلة: عدد
): نتيجة متجه ط8, خطأ_مقبس_داروين {
    إذا ((العائلة != 4 && العائلة != 6) || الطول(*المضيف) == 0) {
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح());
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*المضيف) مثل طبيعي)) {
        دع البايت: ط8 = (*المضيف)[الموضع];
        إذا (البايت == 0) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح()); };
        ألحق(الاسم, البايت);
        الموضع := الموضع + 1;
    }
    ألحق(الاسم, 0);
    دع القائمة: متغير *معلومات_عنوان_داروين_أصلية = الفارغ;
    دع الحالة: ص32 = getaddrinfo(&الاسم[0], الفارغ, الفارغ, &متغير القائمة);
    إذا (الحالة != 0) {
        // getaddrinfo() uses the EAI_* namespace, not errno. Never turn an
        // EAI value into a fake Unix errno. The std.os boundary currently
        // exposes a generic DNS failure but not individual EAI categories.
        أرجع نتيجة.خطأ(خطأ_مقبس_داروين.حل_اسم_فشل());
    };
    دع المطلوب: ص32;
    إذا (العائلة == 4) { المطلوب := 2; } وإلا { المطلوب := 30; };
    دع الحالي: متغير *معلومات_عنوان_داروين_أصلية = القائمة;
    دع الناتج: متغير متجه ط8 = [];
    دع مستمر: متغير منطقي = صواب;
    غير_آمن {
        طالما (مستمر && الحالي != الفارغ) {
            إذا ((*الحالي).العائلة == المطلوب && (*الحالي).العنوان != الفارغ) {
                دع بايتات_العنوان: *ط8 = (*الحالي).العنوان;
                دع الحد: متغير طبيعي = 0;
                دع البداية: متغير طبيعي = 0;
                إذا (العائلة == 4 && (*الحالي).الطول >= 16) {
                    الحد := 4; البداية := 4;
                } وإلا إذا (العائلة == 6 && (*الحالي).الطول >= 28) {
                    الحد := 16; البداية := 8;
                };
                إذا (الحد > 0) {
                    ألحق(الناتج, العائلة مثل ط8);
                    ألحق(الناتج, الحد مثل ط8);
                    ألحق(الناتج, 0); ألحق(الناتج, 0);
                    دع ف: متغير طبيعي = 0;
                    طالما (ف < الحد) {
                        ألحق(الناتج, بايتات_العنوان[البداية + ف]);
                        ف := ف + 1;
                    }
                    مستمر := خطأ;
                } وإلا { الحالي := (*الحالي).التالي; };
            } وإلا { الحالي := (*الحالي).التالي; };
        }
    }
    freeaddrinfo(القائمة);
    إذا (الطول(الناتج) == 0) { أرجع نتيجة.خطأ(خطأ_مقبس_داروين.نطاق_غير_صالح()); };
    أرجع نتيجة.نجح(الناتج);
}
