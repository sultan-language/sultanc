استورد os.error;
استورد os.path;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Darwin process provider through libSystem. posix_spawn is the supported
// Darwin process-creation interface (fork in a multithreaded process is not).
// posix_spawnp gives execvp program lookup: a spelling with '/' is used as
// given, a bare name is searched in the parent's PATH (same rule as Linux).
// posix_spawnattr_t and posix_spawn_file_actions_t are pointer-sized opaque
// handles on Darwin; each is initialized and destroyed exactly once here.
خارجي عرف posix_spawnp(
    المعرف: *متغير ص32, المسار: *غ8, الأفعال: *متغير غ64, السمات: *متغير غ64,
    الوسائط: **غ8, البيئة: **غ8
): ص32;
خارجي عرف posix_spawnattr_init(السمات: *متغير غ64): ص32;
خارجي عرف posix_spawnattr_setflags(السمات: *متغير غ64, الأعلام: ص16): ص32;
خارجي عرف posix_spawnattr_destroy(السمات: *متغير غ64): ص32;
خارجي عرف posix_spawn_file_actions_init(الأفعال: *متغير غ64): ص32;
خارجي عرف posix_spawn_file_actions_addinherit_np(الأفعال: *متغير غ64, الواصف: ص32): ص32;
خارجي عرف posix_spawn_file_actions_destroy(الأفعال: *متغير غ64): ص32;
خارجي عرف waitpid(المعرف: ص32, الحالة: *متغير ص32, الخيارات: ص32): ص32;
خارجي عرف kill(المعرف: ص32, الإشارة: ص32): ص32;
خارجي عرف _exit(الرمز: ص32): فراغ;

عام نوع خطأ_تشغيل_طفل_داروين =
    | مدخل_غير_صالح
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع حالة_طفل_داروين =
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

عام نوع خطأ_انتظار_داروين =
    | معرف_غير_صالح
    | استجابة_غير_صالحة
    | نظام بنوع خطأ_نظام_أصلي
;

عرف خطأ_رقم_داروين(الرمز: ص32): خطأ_نظام_أصلي {
    أرجع أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الرمز مثل عدد);
}

عرف أضف_سلسلة_صفرية_داروين(
    المخازن: &متغير متجه متجه غ8, البايتات: &متجه غ8
): منطقي {
    طابق بايتات_مسار_يونكس_صفرية(البايتات) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(المنتهي) -> { ألحق(*المخازن, المنتهي); أرجع صواب; };
}

// argv = [program, arguments...]; envp entries are complete NAME=VALUE byte
// strings. POSIX_SPAWN_CLOEXEC_DEFAULT (0x4000) closes every descriptor in
// the child except the explicitly inherited standard streams 0, 1 and 2.
عام عرف شغل_طفلا_داروين_ببيئة(
    البرنامج: &متجه غ8, الوسائط: &متجه متجه غ8, البيئة: &متجه متجه غ8
): نتيجة عدد, خطأ_تشغيل_طفل_داروين {
    دع مخازن_الوسائط: متغير متجه متجه غ8 = [];
    لو (!أضف_سلسلة_صفرية_داروين(&متغير مخازن_الوسائط, البرنامج)) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.مدخل_غير_صالح());
    };
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*الوسائط) مثل غير_موقع)) {
        لو (!أضف_سلسلة_صفرية_داروين(&متغير مخازن_الوسائط, &(*الوسائط)[الفهرس])) {
            أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.مدخل_غير_صالح());
        };
        الفهرس := الفهرس + 1;
    }
    دع مخازن_البيئة: متغير متجه متجه غ8 = [];
    الفهرس := 0;
    بينما (الفهرس < (الطول(*البيئة) مثل غير_موقع)) {
        لو (!أضف_سلسلة_صفرية_داروين(&متغير مخازن_البيئة, &(*البيئة)[الفهرس])) {
            أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.مدخل_غير_صالح());
        };
        الفهرس := الفهرس + 1;
    }
    // Pointer tables reference the owned buffers, which outlive the call.
    دع مؤشرات_الوسائط: متغير متجه *غ8 = [];
    الفهرس := 0;
    بينما (الفهرس < (الطول(مخازن_الوسائط) مثل غير_موقع)) {
        ألحق(مؤشرات_الوسائط, &مخازن_الوسائط[الفهرس][0]);
        الفهرس := الفهرس + 1;
    }
    ألحق(مؤشرات_الوسائط, الفارغ);
    دع مؤشرات_البيئة: متغير متجه *غ8 = [];
    الفهرس := 0;
    بينما (الفهرس < (الطول(مخازن_البيئة) مثل غير_موقع)) {
        ألحق(مؤشرات_البيئة, &مخازن_البيئة[الفهرس][0]);
        الفهرس := الفهرس + 1;
    }
    ألحق(مؤشرات_البيئة, الفارغ);

    دع السمات: متغير متجه غ64 = [0];
    دع الأفعال: متغير متجه غ64 = [0];
    دع حالة_السمات: ص32 = posix_spawnattr_init(&متغير السمات[0]);
    لو (حالة_السمات != 0) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.نظام(خطأ_رقم_داروين(حالة_السمات)));
    };
    دع حالة_الأفعال: ص32 = posix_spawn_file_actions_init(&متغير الأفعال[0]);
    لو (حالة_الأفعال != 0) {
        دع تنظيف_السمات: ص32 = posix_spawnattr_destroy(&متغير السمات[0]);
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.نظام(خطأ_رقم_داروين(حالة_الأفعال)));
    };
    دع الإعداد: متغير ص32 = posix_spawnattr_setflags(&متغير السمات[0], 0x4000);
    دع التيار: متغير ص32 = 0;
    بينما (الإعداد == 0 && التيار < 3) {
        الإعداد := posix_spawn_file_actions_addinherit_np(&متغير الأفعال[0], التيار);
        التيار := التيار + 1;
    }
    دع المعرف: متغير متجه ص32 = [0];
    دع حالة_التشغيل: متغير ص32 = الإعداد;
    لو (الإعداد == 0) {
        دع مصفوفة_الوسائط: **غ8 = &مؤشرات_الوسائط[0];
        دع مصفوفة_البيئة: **غ8 = &مؤشرات_البيئة[0];
        حالة_التشغيل := posix_spawnp(
            &متغير المعرف[0], مؤشرات_الوسائط[0], &متغير الأفعال[0], &متغير السمات[0],
            مصفوفة_الوسائط, مصفوفة_البيئة
        );
    };
    دع تنظيف_الأفعال: ص32 = posix_spawn_file_actions_destroy(&متغير الأفعال[0]);
    دع تنظيف_السمات_النهائي: ص32 = posix_spawnattr_destroy(&متغير السمات[0]);
    لو (حالة_التشغيل != 0) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_داروين.نظام(خطأ_رقم_داروين(حالة_التشغيل)));
    };
    أرجع نتيجة.نجح(المعرف[0] مثل عدد);
}

// POSIX waitpid: WNOHANG=1 returns 0 while the child is still running.
// A successful wait consumes the child status exactly once. EINTR retries
// without interpreting the uninitialized status word.
عرف انتظر_طفلا_داروين_بخيارات(
    المعرف: عدد, الخيارات: ص32
): نتيجة اختيار حالة_طفل_داروين, خطأ_انتظار_داروين {
    لو (المعرف <= 0 || المعرف > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_انتظار_داروين.معرف_غير_صالح());
    };
    دع الحالة: متغير متجه ص32 = [0];
    دع مستمر: متغير منطقي = صواب;
    بينما (مستمر) {
        دع الناتج: ص32 = waitpid(المعرف مثل ص32, &متغير الحالة[0], الخيارات);
        لو (الناتج < 0) {
            دع الخطأ: خطأ_نظام_أصلي = خطأ_داروين_الحالي();
            لو (الخطأ.الرمز != 4) { أرجع نتيجة.خطأ(خطأ_انتظار_داروين.نظام(الخطأ)); };
        } وإلا لو (الناتج == 0 && الخيارات == 1) {
            أرجع نتيجة.نجح(اختيار.لا_شيء());
        } وإلا لو ((الناتج مثل عدد) != المعرف) {
            أرجع نتيجة.خطأ(خطأ_انتظار_داروين.استجابة_غير_صالحة());
        } وإلا {
            مستمر := خطأ;
        };
    }
    دع القيمة: عدد = (الحالة[0] مثل عدد) & 0xFFFF;
    دع الإشارة: عدد = القيمة & 0x7F;
    لو (الإشارة == 0) {
        أرجع نتيجة.نجح(اختيار.بعض(حالة_طفل_داروين.خرج((القيمة >> 8) & 0xFF)));
    };
    لو (الإشارة != 0x7F) {
        أرجع نتيجة.نجح(اختيار.بعض(حالة_طفل_داروين.إشارة(الإشارة)));
    };
    أرجع نتيجة.خطأ(خطأ_انتظار_داروين.استجابة_غير_صالحة());
}

// Blocking wait retains its existing success/error contract.
عام عرف انتظر_طفلا_داروين(المعرف: عدد): نتيجة حالة_طفل_داروين, خطأ_انتظار_داروين {
    طابق انتظر_طفلا_داروين_بخيارات(المعرف, 0) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النتيجة) -> {
        طابق النتيجة مع
        | اختيار.بعض(الحالة) -> { أرجع نتيجة.نجح(الحالة); }
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_انتظار_داروين.استجابة_غير_صالحة());
        };
    };
}

عام عرف تفقد_طفلا_داروين(
    المعرف: عدد
): نتيجة اختيار حالة_طفل_داروين, خطأ_انتظار_داروين {
    أرجع انتظر_طفلا_داروين_بخيارات(المعرف, 1);
}

// Only a live, waitable child may receive a signal. If it already exited,
// return (and consume) its real status instead of signaling a recycled PID.
// None means the requested signal was submitted; the caller still owns the child and must
// wait to reap it. ESRCH/ECHILD remain native errors, not false successes.
عام عرف أرسل_إشارة_طفل_داروين(
    المعرف: عدد, الإشارة: ص32
): نتيجة اختيار حالة_طفل_داروين, خطأ_انتظار_داروين {
    لو (الإشارة != 9 && الإشارة != 15) {
        أرجع نتيجة.خطأ(خطأ_انتظار_داروين.معرف_غير_صالح());
    };
    طابق تفقد_طفلا_داروين(المعرف) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الحالة) -> {
        طابق الحالة مع
        | اختيار.بعض(النهاية) -> { أرجع نتيجة.نجح(اختيار.بعض(النهاية)); }
        | اختيار.لا_شيء -> {
            لو (kill(المعرف مثل ص32, الإشارة) < 0) {
                أرجع نتيجة.خطأ(خطأ_انتظار_داروين.نظام(خطأ_داروين_الحالي()));
            };
            أرجع نتيجة.نجح(اختيار.لا_شيء());
        };
    };
}

// _exit terminates without running library destructors, like Linux exit_group.
عام عرف اخرج_من_عملية_داروين(الرمز: ص32): فراغ {
    _exit(الرمز);
}
