استورد os.error;

// Darwin <sys/errno.h> values. Shared low numbers equal Linux; EAGAIN (35),
// ETIMEDOUT (60) and ECONNREFUSED (61) differ and are never borrowed from Linux.
عام عرف صنف_خطأ_داروين_أساسيا(الرمز: عدد): صنف_خطأ_نظام {
    لو (الرمز == 2) { أرجع صنف_خطأ_نظام.غير_موجود(); }; // ENOENT
    لو (الرمز == 4) { أرجع صنف_خطأ_نظام.عملية_انقطعت(); }; // EINTR
    لو (الرمز == 12) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // ENOMEM
    لو (الرمز == 13) { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }; // EACCES
    لو (الرمز == 16) { أرجع صنف_خطأ_نظام.مورد_مشغول(); }; // EBUSY
    لو (الرمز == 17) { أرجع صنف_خطأ_نظام.موجود_مسبقا(); }; // EEXIST
    لو (الرمز == 20) { أرجع صنف_خطأ_نظام.ليس_دليلا(); }; // ENOTDIR
    لو (الرمز == 21) { أرجع صنف_خطأ_نظام.هو_دليل(); }; // EISDIR
    لو (الرمز == 22) { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); }; // EINVAL
    لو (الرمز == 23) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // ENFILE
    لو (الرمز == 24) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // EMFILE
    لو (الرمز == 28) { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); }; // ENOSPC
    لو (الرمز == 35) { أرجع صنف_خطأ_نظام.عملية_ستحظر(); }; // EAGAIN
    لو (الرمز == 60) { أرجع صنف_خطأ_نظام.انتهت_المهلة(); }; // ETIMEDOUT
    لو (الرمز == 61) { أرجع صنف_خطأ_نظام.اتصال_مرفوض(); }; // ECONNREFUSED
    أرجع صنف_خطأ_نظام.غير_معروف();
}
