استورد os.error;
استورد os.platform.unix.apple.darwin.file_descriptors;

// Darwin's POSIX clock_gettime(CLOCK_REALTIME=0) writes a timespec with
// two 64-bit signed longs on the supported arm64 macOS ABI. This is wall
// time; it cannot be substituted by mach_absolute_time's uptime epoch.
خارجي «/usr/lib/libSystem.B.dylib» عرف clock_gettime(معرف_الساعة: ص32, الوقت: *متغير ص64): ص32;

عام عرف اقرأ_وقت_داروين_جداري_نانو(): نتيجة عدد, خطأ_حد_نظام {
    دع الحقول: متغير متجه ص64 = [0, 0];
    دع الحالة: ص32 = clock_gettime(0, &متغير الحقول[0]);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.نظام(خطأ_داروين_الحالي()));
    };
    دع الثواني: ص64 = الحقول[0];
    دع النانو: ص64 = الحقول[1];
    إذا (الثواني < 0 || الثواني > 9223372035 || النانو < 0 || النانو >= 1000000000) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
    };
    دع الكلي: ط64 = (الثواني مثل ط64) * 1000000000;
    إذا ((النانو مثل ط64) > 9223372036854775807 - الكلي) {
        أرجع نتيجة.خطأ(خطأ_حد_نظام.قيمة_خارج_النطاق());
    };
    أرجع نتيجة.نجح((الكلي + (النانو مثل ط64)) مثل عدد);
}

// Mach's supported monotonic clock API. Unlike POSIX clock_gettime, these
// declarations name Mach timing interfaces, not libc functions.
// mach_timebase_info_data_t contains two uint32_t fields.
خارجي «/usr/lib/libSystem.B.dylib» عرف mach_absolute_time(): ط64;
خارجي «/usr/lib/libSystem.B.dylib» عرف mach_timebase_info(المعلومات: *متغير ط32): ص32;

عام نوع خطأ_ساعة_ماخ =
    | فشل_نواة بنوع ص32
    | تردد_غير_صالح
    | خارج_النطاق
;

عام نوع قراءة_ساعة_ماخ = {
    الدقات: ط64,
    بسط_نانو_الثانية: ط32,
    مقام_نانو_الثانية: ط32
};

// Retain a rational conversion factor: ticks * numerator / denominator
// must be evaluated with overflow checks by consumers. mach_absolute_time
// is monotonic but does not include suspended-system sleep time.
عام عرف اقرأ_ساعة_ماخ_الرتيبة(): نتيجة قراءة_ساعة_ماخ, خطأ_ساعة_ماخ {
    دع البيانات: متغير متجه ط32 = [0, 0];
    دع الحالة: ص32 = mach_timebase_info(&متغير البيانات[0]);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.فشل_نواة(الحالة));
    };
    إذا (البيانات[1] == 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.تردد_غير_صالح());
    };
    دع القراءة: قراءة_ساعة_ماخ = {
        الدقات: mach_absolute_time(),
        بسط_نانو_الثانية: البيانات[0],
        مقام_نانو_الثانية: البيانات[1]
    };
    أرجع نتيجة.نجح(القراءة);
}

// mach_continuous_time includes time while the system is asleep, unlike
// mach_absolute_time. Both share mach_timebase_info's unit conversion.
خارجي «/usr/lib/libSystem.B.dylib» عرف mach_continuous_time(): ط64;

// A large accumulated tick count cannot be multiplied directly by the
// numerator: split before multiplying. Both timebase fields are u32, so
// (ticks % denominator) * numerator fits in u64. Never return a wrapped
// duration if the whole-seconds contribution would overflow.
عام عرف حول_دقات_ماخ_إلى_نانو(
    الدقات: ط64, البسط: ط32, المقام: ط32
): نتيجة ط64, خطأ_ساعة_ماخ {
    إذا (المقام == 0 || البسط == 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.تردد_غير_صالح());
    };
    دع القاسم: ط64 = المقام مثل ط64;
    دع المضاعف: ط64 = البسط مثل ط64;
    دع الكامل: ط64 = الدقات / القاسم;
    دع الباقي: ط64 = الدقات % القاسم;
    إذا (الكامل > (18446744073709551615 / المضاعف)) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.خارج_النطاق());
    };
    دع الجزء: ط64 = (الباقي * المضاعف) / القاسم;
    دع الناتج: ط64 = الكامل * المضاعف;
    إذا (الجزء > (18446744073709551615 - الناتج)) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.خارج_النطاق());
    };
    أرجع نتيجة.نجح(الناتج + الجزء);
}

عام عرف اقرأ_وقت_ماخ_رتيب_نانو(): نتيجة ط64, خطأ_ساعة_ماخ {
    طابق اقرأ_ساعة_ماخ_الرتيبة() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القراءة) -> {
        أرجع حول_دقات_ماخ_إلى_نانو(
            القراءة.الدقات, القراءة.بسط_نانو_الثانية, القراءة.مقام_نانو_الثانية
        );
    };
}

عام عرف اقرأ_وقت_ماخ_مستمر_نانو(): نتيجة ط64, خطأ_ساعة_ماخ {
    دع البيانات: متغير متجه ط32 = [0, 0];
    دع الحالة: ص32 = mach_timebase_info(&متغير البيانات[0]);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.فشل_نواة(الحالة));
    };
    أرجع حول_دقات_ماخ_إلى_نانو(
        mach_continuous_time(), البيانات[0], البيانات[1]
    );
}

// Native Mach absolute-deadline wait (mach/mach_time.h). The timebase ratio
// converts nanoseconds to ticks; rounding up must not shorten the wait.
// Mach's absolute clock does not count time spent suspended. This operation
// does not use POSIX nanosleep or a C runtime.
خارجي «/usr/lib/libSystem.B.dylib» عرف mach_wait_until(الموعد: ط64): ص32;

عام عرف نم_نانو_ماخ(المدة_نانو: ط64): نتيجة عدد, خطأ_ساعة_ماخ {
    إذا (المدة_نانو == 0) { أرجع نتيجة.نجح(0); };
    دع البيانات: متغير متجه ط32 = [0, 0];
    دع الحالة: ص32 = mach_timebase_info(&متغير البيانات[0]);
    إذا (الحالة != 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.فشل_نواة(الحالة));
    };
    إذا (البيانات[0] == 0 || البيانات[1] == 0) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.تردد_غير_صالح());
    };
    دع البسط: ط64 = البيانات[0] مثل ط64;
    دع المقام: ط64 = البيانات[1] مثل ط64;
    دع الجزء_الكامل: ط64 = المدة_نانو / البسط;
    دع الباقي: ط64 = المدة_نانو % البسط;
    إذا (الجزء_الكامل > 18446744073709551615 / المقام) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.خارج_النطاق());
    };
    دع الدقات_الكاملة: ط64 = الجزء_الكامل * المقام;
    دع ناتج_الباقي: ط64 = الباقي * المقام;
    دع الدقات_الجزئية: متغير ط64 = ناتج_الباقي / البسط;
    إذا ((ناتج_الباقي % البسط) != 0) {
        الدقات_الجزئية := الدقات_الجزئية + 1;
    };
    دع الآن: ط64 = mach_absolute_time();
    إذا (الدقات_الجزئية > 18446744073709551615 - الدقات_الكاملة) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.خارج_النطاق());
    };
    دع الدقات: ط64 = الدقات_الكاملة + الدقات_الجزئية;
    إذا (الدقات > 18446744073709551615 - الآن) {
        أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.خارج_النطاق());
    };
    دع الموعد: ط64 = الآن + الدقات;
    // KERN_ABORTED (14) denotes an interrupted Mach wait. Continue from
    // the original deadline rather than losing elapsed time or busy-spinning.
    طالما (mach_absolute_time() < الموعد) {
        دع الانتظار: ص32 = mach_wait_until(الموعد);
        إذا (الانتظار != 0 && الانتظار != 14) {
            أرجع نتيجة.خطأ(خطأ_ساعة_ماخ.فشل_نواة(الانتظار));
        };
    }
    أرجع نتيجة.نجح(0);
}
