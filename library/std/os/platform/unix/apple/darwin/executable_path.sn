استورد os.error;

// The path of this process's executable on Darwin: dyld's
// _NSGetExecutablePath (<mach-o/dyld.h>), which Rust's std::env::current_exe
// calls before canonicalizing. It fills the buffer and returns 0, or returns
// -1 with *bufsize set to the size it needs.
خارجي «/usr/lib/libSystem.B.dylib» عرف _NSGetExecutablePath(المخزن: *متغير ط8, الحجم: *متغير ط32): ص32;

// The path bytes without the NUL; لا_شيء when dyld gives none.
عام عرف اقرأ_مسار_البرنامج_داروين(): اختياري متجه ط8 {
    دع السعة: متغير طبيعي = 1024;
    دع المحاولة: متغير طبيعي = 0;
    طالما (المحاولة < 2) {
        دع المخزن: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < السعة) { ألحق(المخزن, 0); ف := ف + 1; }
        دع الحجم: متغير متجه ط32 = [];
        ألحق(الحجم, السعة مثل ط32);
        دع الحالة: ص32 = _NSGetExecutablePath(&متغير المخزن[0], &متغير الحجم[0]);
        إذا (الحالة == 0) {
            دع الناتج: متغير متجه ط8 = [];
            دع م: متغير طبيعي = 0;
            طالما (م < السعة && المخزن[م] != 0) { ألحق(الناتج, المخزن[م]); م := م + 1; }
            أرجع اختياري.موجود(الناتج);
        };
        إذا ((الحجم[0] مثل طبيعي) <= السعة || (الحجم[0] مثل طبيعي) > 1048576) {
            أرجع اختياري.لا_شيء();
        };
        السعة := الحجم[0] مثل طبيعي;
        المحاولة := المحاولة + 1;
    }
    أرجع اختياري.لا_شيء();
}
