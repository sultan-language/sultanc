استورد os.error;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.freebsd.uapi;

// FreeBSD kernel parameters read through __sysctl(name, namelen, old,
// oldlenp, new, newlen), the call libc's sysctl(3) wraps. Nothing here is
// cached or defaulted: a failed read reports the kernel's errno.

// hw.pagesize (CTL_HW, HW_PAGESIZE: an int). The kernel passes the same
// PAGE_SIZE to new images as AT_PAGESZ (sys/kern/imgact_elf.c).
عام عرف اقرأ_حجم_صفحة_فري_بي_إس_دي(): نتيجة ط64, خطأ_نظام_أصلي {
    دع الاسم: متغير متجه ص32 = [];
    ألحق(الاسم, متغير_عتاد_فري_بي_إس_دي() مثل ص32);
    ألحق(الاسم, متغير_حجم_الصفحة_فري_بي_إس_دي() مثل ص32);
    دع القيمة: متغير متجه ص32 = [0];
    دع الطول: متغير متجه ط64 = [4];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_متغير_نواة()),
        &متغير الاسم[0], 2 مثل ط64, &متغير القيمة[0], &متغير الطول[0],
        0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> {
        إذا (الطول[0] != 4 || القيمة[0] <= 0) {
            // EINVAL: not the int this name is documented to hold.
            أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), 22));
        };
        أرجع نتيجة.نجح(القيمة[0] مثل ط64);
    };
}

// kern.proc.pathname of this process (CTL_KERN 1, KERN_PROC 14,
// KERN_PROC_PATHNAME 12, pid -1: sys/sys/sysctl.h), the path the kernel
// recorded when it executed the image, as Rust's std::env::current_exe
// reads it on FreeBSD. The bytes exclude the terminating NUL.
عام عرف اقرأ_مسار_البرنامج_فري_بي_إس_دي(): نتيجة متجه ط8, خطأ_نظام_أصلي {
    دع الاسم: متغير متجه ص32 = [];
    ألحق(الاسم, 1);
    ألحق(الاسم, 14);
    ألحق(الاسم, 12);
    ألحق(الاسم, -1);
    // PATH_MAX (1024) bytes and its NUL.
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 1025) { ألحق(المخزن, 0); ف := ف + 1; }
    دع الطول: متغير متجه ط64 = [1025];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_متغير_نواة()),
        &متغير الاسم[0], 4 مثل ط64, &متغير المخزن[0], &متغير الطول[0],
        0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> {
        دع الناتج: متغير متجه ط8 = [];
        دع م: متغير طبيعي = 0;
        طالما (م < (الطول[0] مثل طبيعي) && م < 1025 && المخزن[م] != 0) {
            ألحق(الناتج, المخزن[م]);
            م := م + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    };
}

// hw.ncpu (CTL_HW, HW_NCPU 3: an int), the number of CPUs; Rust's
// available_parallelism falls back to it when cpuset_getaffinity fails.
عام عرف اقرأ_عدد_المعالجات_فري_بي_إس_دي(): نتيجة ط64, خطأ_نظام_أصلي {
    دع الاسم: متغير متجه ص32 = [];
    ألحق(الاسم, متغير_عتاد_فري_بي_إس_دي() مثل ص32);
    ألحق(الاسم, 3 مثل ص32);
    دع القيمة: متغير متجه ص32 = [0];
    دع الطول: متغير متجه ط64 = [4];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_متغير_نواة()),
        &متغير الاسم[0], 2 مثل ط64, &متغير القيمة[0], &متغير الطول[0],
        0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> {
        إذا (الطول[0] != 4 || القيمة[0] <= 0) {
            أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), 22));
        };
        أرجع نتيجة.نجح(القيمة[0] مثل ط64);
    };
}
