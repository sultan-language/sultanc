// Shared BSD-family network address layout for Darwin and FreeBSD.
// These native sockaddr structures carry an initial length byte, unlike
// Linux sockaddr; no POSIX libc functions are called by this module.
// The caller supplies the selected target's native AF_INET6 value: Darwin
// and FreeBSD deliberately do not share that constant. It also supplies
// the target's byte order, never the compiler host's byte order.
//
// Sources: Apple XNU bsd/netinet6/in6.h, FreeBSD sys/netinet/in.h and
// sys/netinet6/in6.h: sockaddr_in is 16 bytes, sockaddr_in6 is 28 bytes.

عام نوع خطأ_عنوان_مقبس_بي_إس_دي =
    | طول_عنوان_غير_صالح
    | عائلة_غير_صالحة
;

عرف ألحق_عدد_غ32_أصلي_بي_إس_دي(
    المخزن: &متغير متجه غ8, القيمة: غ32, صغير_النهاية: منطقي
): فراغ {
    لو (صغير_النهاية) {
        ألحق(*المخزن, (القيمة & 255) مثل غ8);
        ألحق(*المخزن, ((القيمة >> 8) & 255) مثل غ8);
        ألحق(*المخزن, ((القيمة >> 16) & 255) مثل غ8);
        ألحق(*المخزن, ((القيمة >> 24) & 255) مثل غ8);
    } وإلا {
        ألحق(*المخزن, ((القيمة >> 24) & 255) مثل غ8);
        ألحق(*المخزن, ((القيمة >> 16) & 255) مثل غ8);
        ألحق(*المخزن, ((القيمة >> 8) & 255) مثل غ8);
        ألحق(*المخزن, (القيمة & 255) مثل غ8);
    };
}

// BSD sin_len=16, AF_INET=2. sin_port and the four address bytes are in
// network byte order. sockaddr_in's eight remaining bytes are zero-filled.
عام عرف عنوان_مقبس_آيبي4_بي_إس_دي(
    العنوان: &متجه غ8, المنفذ: غ16
): نتيجة متجه غ8, خطأ_عنوان_مقبس_بي_إس_دي {
    لو (الطول(*العنوان) != 4) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_بي_إس_دي.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [
        16, 2,
        ((المنفذ >> 8) & 255) مثل غ8,
        (المنفذ & 255) مثل غ8
    ];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 4) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    دع الحشو: متغير غير_موقع = 0;
    بينما (الحشو < 8) {
        ألحق(الناتج, 0 مثل غ8);
        الحشو := الحشو + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// BSD sockaddr_in6: [len, family, port(be16), flowinfo(be32),
// address(16 bytes), scope_id(u32 native)]. AF_INET6 differs across
// Darwin (30) and FreeBSD (28), so it is a selected-platform input.
عام عرف عنوان_مقبس_آيبي6_بي_إس_دي(
    العنوان: &متجه غ8, المنفذ: غ16,
    معلومات_التدفق: غ32, نطاق_الواجهة: غ32,
    عائلة_آيبي6: غ8, صغير_النهاية: منطقي
): نتيجة متجه غ8, خطأ_عنوان_مقبس_بي_إس_دي {
    لو (الطول(*العنوان) != 16) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_بي_إس_دي.طول_عنوان_غير_صالح());
    };
    لو (عائلة_آيبي6 != 28 && عائلة_آيبي6 != 30) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_بي_إس_دي.عائلة_غير_صالحة());
    };
    دع الناتج: متغير متجه غ8 = [
        28, عائلة_آيبي6,
        ((المنفذ >> 8) & 255) مثل غ8,
        (المنفذ & 255) مثل غ8,
        ((معلومات_التدفق >> 24) & 255) مثل غ8,
        ((معلومات_التدفق >> 16) & 255) مثل غ8,
        ((معلومات_التدفق >> 8) & 255) مثل غ8,
        (معلومات_التدفق & 255) مثل غ8
    ];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 16) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق_عدد_غ32_أصلي_بي_إس_دي(&متغير الناتج, نطاق_الواجهة, صغير_النهاية);
    أرجع نتيجة.نجح(الناتج);
}
