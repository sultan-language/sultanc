// Linux kernel socket address data, shared with Android's Linux kernel ABI.
// This implements byte layout in SultanC source: there is no libc binding.
// Target byte order is supplied by canonical target selection, not detected
// from the build host. All port and flow-info fields use network byte order.
//
// Linux UAPI: include/uapi/linux/in.h, include/uapi/linux/in6.h and socket.h.
// sockaddr_in:  family(u16 native), port(be16), address(4 bytes), padding(8).
// sockaddr_in6: family(u16 native), port(be16), flowinfo(be32), address(16),
//               scope_id(u32 native). Sizes are 16 and 28 bytes respectively.

عام نوع خطأ_عنوان_مقبس_لينكس =
    | طول_عنوان_غير_صالح
;

// The only native-order field in the IPv4 prefix is sa_family_t.
عرف ألحق_عدد_غ16_بنهاية_لينكس(
    الناتج: &متغير متجه غ8, القيمة: غ16, صغير_النهاية: منطقي
): فراغ {
    لو (صغير_النهاية) {
        ألحق(*الناتج, (القيمة & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل غ8);
    } وإلا {
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل غ8);
        ألحق(*الناتج, (القيمة & 255) مثل غ8);
    };
}

عرف ألحق_عدد_غ32_بنهاية_لينكس(
    الناتج: &متغير متجه غ8, القيمة: غ32, صغير_النهاية: منطقي
): فراغ {
    لو (صغير_النهاية) {
        ألحق(*الناتج, (القيمة & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 16) & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 24) & 255) مثل غ8);
    } وإلا {
        ألحق(*الناتج, ((القيمة >> 24) & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 16) & 255) مثل غ8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل غ8);
        ألحق(*الناتج, (القيمة & 255) مثل غ8);
    };
}

// Linux AF_INET is 2 for the supported Linux-kernel UAPI. The address bytes
// are already in network byte order; only the family follows native order.
عام عرف عنوان_مقبس_آيبي4_لينكس(
    العنوان: &متجه غ8, المنفذ: غ16, صغير_النهاية: منطقي
): نتيجة متجه غ8, خطأ_عنوان_مقبس_لينكس {
    لو (الطول(*العنوان) != 4) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_لينكس.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [];
    ألحق_عدد_غ16_بنهاية_لينكس(&متغير الناتج, 2, صغير_النهاية);
    ألحق(الناتج, ((المنفذ >> 8) & 255) مثل غ8);
    ألحق(الناتج, (المنفذ & 255) مثل غ8);
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 4) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    دع الحشو: متغير غير_موقع = 0;
    بينما (الحشو < 8) {
        ألحق(الناتج, 0 مثل غ8);
        الحشو := الحشو + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// Linux AF_INET6 is 10 (unlike WinSock's 23). flowinfo is a big-endian
// __be32 in the kernel UAPI; scope_id is an ordinary native-endian __u32.
عام عرف عنوان_مقبس_آيبي6_لينكس(
    العنوان: &متجه غ8, المنفذ: غ16,
    معلومات_التدفق: غ32, نطاق_الواجهة: غ32,
    صغير_النهاية: منطقي
): نتيجة متجه غ8, خطأ_عنوان_مقبس_لينكس {
    لو (الطول(*العنوان) != 16) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_لينكس.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [];
    ألحق_عدد_غ16_بنهاية_لينكس(&متغير الناتج, 10, صغير_النهاية);
    ألحق(الناتج, ((المنفذ >> 8) & 255) مثل غ8);
    ألحق(الناتج, (المنفذ & 255) مثل غ8);
    ألحق_عدد_غ32_بنهاية_لينكس(&متغير الناتج, معلومات_التدفق, خطأ);
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 16) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق_عدد_غ32_بنهاية_لينكس(&متغير الناتج, نطاق_الواجهة, صغير_النهاية);
    أرجع نتيجة.نجح(الناتج);
}
