// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Linux kernel socket address data, shared with Android's Linux kernel ABI.
// This implements byte layout in SultanC source: there is no libc binding.
// Target byte order is supplied by canonical target selection, not detected
// from the build host. All port and flow-info fields use network byte order.
//
// Linux UAPI: include/uapi/linux/in.h, include/uapi/linux/in6.h and socket.h.
// sockaddr_in:  family(u16 native), port(be16), address(4 bytes), padding(8).
// sockaddr_in6: family(u16 native), port(be16), flowinfo(be32), address(16),
//               scope_id(u32 native). Sizes are 16 and 28 bytes respectively.
// FreeBSD (uapi.sn عنوان_مقبس_بطول_لينكس) keeps the sizes but splits the
// family word into sin_len (u8) and sin_family (u8): sys/netinet/in.h,
// sys/netinet6/in6.h. AF_INET6 is per kernel (10 on Linux, 28 on FreeBSD).

عام نوع خطأ_عنوان_مقبس_لينكس =
    | طول_عنوان_غير_صالح
;

// The only native-order field in the IPv4 prefix is sa_family_t.
عرف ألحق_عدد_ط16_بنهاية_لينكس(
    الناتج: &متغير متجه ط8, القيمة: ط16, صغير_النهاية: منطقي
): فراغ {
    لو (صغير_النهاية) {
        ألحق(*الناتج, (القيمة & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل ط8);
    } وإلا {
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل ط8);
        ألحق(*الناتج, (القيمة & 255) مثل ط8);
    };
}

عرف ألحق_عدد_ط32_بنهاية_لينكس(
    الناتج: &متغير متجه ط8, القيمة: ط32, صغير_النهاية: منطقي
): فراغ {
    لو (صغير_النهاية) {
        ألحق(*الناتج, (القيمة & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 16) & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 24) & 255) مثل ط8);
    } وإلا {
        ألحق(*الناتج, ((القيمة >> 24) & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 16) & 255) مثل ط8);
        ألحق(*الناتج, ((القيمة >> 8) & 255) مثل ط8);
        ألحق(*الناتج, (القيمة & 255) مثل ط8);
    };
}

// AF_INET is 2 on Linux and FreeBSD. The address bytes
// are already in network byte order; only the family follows native order.
عام عرف عنوان_مقبس_آيبي4_لينكس(
    العنوان: &متجه ط8, المنفذ: ط16, صغير_النهاية: منطقي
): نتيجة متجه ط8, خطأ_عنوان_مقبس_لينكس {
    لو (الطول(*العنوان) != 4) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_لينكس.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه ط8 = [];
    لو (عنوان_مقبس_بطول_لينكس()) {
        ألحق(الناتج, 16 مثل ط8);
        ألحق(الناتج, 2 مثل ط8);
    } وإلا {
        ألحق_عدد_ط16_بنهاية_لينكس(&متغير الناتج, 2, صغير_النهاية);
    };
    ألحق(الناتج, ((المنفذ >> 8) & 255) مثل ط8);
    ألحق(الناتج, (المنفذ & 255) مثل ط8);
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 4) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    دع الحشو: متغير طبيعي = 0;
    طالما (الحشو < 8) {
        ألحق(الناتج, 0 مثل ط8);
        الحشو := الحشو + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// AF_INET6 is 10 on Linux (WinSock: 23, FreeBSD: 28). flowinfo is a big-endian
// __be32 in the kernel UAPI; scope_id is an ordinary native-endian __u32.
عام عرف عنوان_مقبس_آيبي6_لينكس(
    العنوان: &متجه ط8, المنفذ: ط16,
    معلومات_التدفق: ط32, نطاق_الواجهة: ط32,
    صغير_النهاية: منطقي
): نتيجة متجه ط8, خطأ_عنوان_مقبس_لينكس {
    لو (الطول(*العنوان) != 16) {
        أرجع نتيجة.خطأ(خطأ_عنوان_مقبس_لينكس.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه ط8 = [];
    دع العائلة: ط64 = عائلة_آيبي6_لينكس();
    لو (عنوان_مقبس_بطول_لينكس()) {
        ألحق(الناتج, 28 مثل ط8);
        ألحق(الناتج, العائلة مثل ط8);
    } وإلا {
        ألحق_عدد_ط16_بنهاية_لينكس(&متغير الناتج, العائلة مثل ط16, صغير_النهاية);
    };
    ألحق(الناتج, ((المنفذ >> 8) & 255) مثل ط8);
    ألحق(الناتج, (المنفذ & 255) مثل ط8);
    ألحق_عدد_ط32_بنهاية_لينكس(&متغير الناتج, معلومات_التدفق, خطأ);
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 16) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق_عدد_ط32_بنهاية_لينكس(&متغير الناتج, نطاق_الواجهة, صغير_النهاية);
    أرجع نتيجة.نجح(الناتج);
}
