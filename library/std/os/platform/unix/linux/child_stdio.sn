استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.file_descriptors;
استورد os.error;
استورد os.buffer;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Descriptors for a child's standard streams (Linux, Android, FreeBSD):
// the null device, a close-on-exec duplicate above the standard range, and
// waiting until any of several descriptors can be read without blocking.

// openat(AT_FDCWD, "/dev/null", O_RDWR|O_CLOEXEC).
عام عرف افتح_الجهاز_الفارغ_لينكس(): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    دع المسار: متجه ط8 = [47, 100, 101, 118, 47, 110, 117, 108, 108];
    أرجع افتح_واصف_لينكس(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), &المسار,
        علم_فتح_للقراءة_والكتابة_لينكس() | علم_فتح_إغلاق_عند_التنفيذ_لينكس(), 0 مثل ط64
    );
}

// fcntl(fd, F_DUPFD_CLOEXEC, 3): a second owner of the same open file,
// numbered 3 or above; the original stays open.
عام عرف كرر_واصفا_فوق_القياسية_لينكس(الواصف: ط64): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تحكم_واصف()), الواصف,
        أمر_تكرار_واصف_بإغلاق_عند_التنفيذ_لينكس(), 3 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_واصف_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع الناتج: واصف_ملف_لينكس = { القيمة: القيمة, مفتوح: صواب };
        أرجع نتيجة.نجح(الناتج);
    };
}

// ppoll(fds, n, NULL, NULL, 0) with POLLIN on each descriptor, retried on
// EINTR. struct pollfd is {int fd; short events; short revents}: two u32
// words whose second holds events and revents in the kernel's byte order.
// A descriptor counts as ready on POLLIN, POLLERR (8), POLLHUP (0x10) or
// POLLNVAL (0x20), so a closed write end ends the wait too.
عام عرف انتظر_واصفات_للقراءة_لينكس(
    الواصفات: &متجه ط64
): نتيجة متجه منطقي, خطأ_واصف_لينكس {
    دع العدد: طبيعي = الطول(*الواصفات) مثل طبيعي;
    لو (العدد == 0 || العدد > 64) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح()); };
    دع الأحداث: متغير متجه ط32 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(الأحداث, (*الواصفات)[ف] مثل ط32);
        لو (ترتيب_بايت_كبير_لينكس()) { ألحق(الأحداث, 1 << 16); } وإلا { ألحق(الأحداث, 1); };
        ف := ف + 1;
    }
    دع الخام: متغير ط64 = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مقبسا()),
            &متغير الأحداث[0], العدد مثل ط64, 0 مثل ط64,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(الأصلي) -> {
            لو (الأصلي.الرمز != 4) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نظام(الأصلي)); };
        }
        | نتيجة.نجح(_) -> { مستمر := خطأ; };
    }
    دع الجاهزة: متغير متجه منطقي = [];
    ف := 0;
    طالما (ف < العدد) {
        دع الكلمة: ط32 = الأحداث[ف * 2 + 1];
        دع الراجعة: متغير ط32 = الكلمة >> 16;
        لو (ترتيب_بايت_كبير_لينكس()) { الراجعة := الكلمة & 0xffff; };
        ألحق(الجاهزة, (الراجعة & 0x39) != 0);
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الجاهزة);
}

// write(2) to a pipe without SIGPIPE (a child's standard input), as
// PostgreSQL's libpq writes to a socket it cannot mark MSG_NOSIGNAL
// (pq_block_sigpipe / pq_reset_sigpipe): SIGPIPE is blocked in this thread
// for the write, so a reader that went away gives EPIPE instead of ending
// the process; the SIGPIPE that write left pending is then taken with a
// zero-timeout rt_sigtimedwait, and the old mask is restored. Rust's std
// gets EPIPE by ignoring SIGPIPE for the whole process and resetting it in
// every child; blocking it per write changes no process-wide state.
// sigset_t is a word array whose bit (signal - 1) is the signal: SIGPIPE
// (13) is in the first 64-bit word on every ABI, of 8 bytes or (MIPS,
// FreeBSD) 16.
عام عرف اكتب_قناة_بلا_إشارة_لينكس(
    الواصف: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_لينكس {
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع الحجم: ط64 = حجم_مجموعة_إشارات_لينكس() مثل ط64;
    دع المجموعة: متغير متجه ط64 = [0, 0];
    المجموعة[0] := (1 مثل ط64) << (إشارة_أنبوب_مكسور_لينكس() - 1);
    دع القديمة: متغير متجه ط64 = [0, 0];
    دع الحجب: ط64;
    غير_آمن { الحجب := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حجب_إشارات()), أمر_حجب_إشارات_لينكس(),
        &المجموعة[0], &متغير القديمة[0], الحجم, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الحجب) مع
    | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نظام(الأصلي)); }
    | نتيجة.نجح(_) -> {};
    دع الخام: متغير ط64 = 0;
    دع مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة()), الواصف,
            &(*المحتوى)[الإزاحة مثل طبيعي], الطلب مثل ط64,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        // EINTR: no byte was written; write again.
        لو (الخام != (~(0 مثل ط64)) - 3) { مستمر := خطأ; };
    }
    لو (الخام == (~(0 مثل ط64)) - ((رمز_خطأ_أنبوب_مكسور_لينكس() مثل ط64) - 1)) {
        دع الصفر: متغير متجه ط64 = [0, 0];
        دع الأخذ: ط64;
        غير_آمن { الأخذ := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_إشارة()),
            &المجموعة[0], 0 مثل ط64, &الصفر[0], الحجم, 0 مثل ط64, 0 مثل ط64
        ); }
    };
    دع الاستعادة: ط64;
    غير_آمن { الاستعادة := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حجب_إشارات()), أمر_ضبط_قناع_إشارات_لينكس(),
        &القديمة[0], 0 مثل ط64, الحجم, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}
