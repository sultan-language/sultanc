// Linux getdents64 records (include/linux/types.h, linux_dirent64):
// ino64 at 0, off64 at 8, reclen native u16 at 16, d_type at 18,
// NUL-terminated filename starting at byte 19. A record's padding is not
// part of the filename. This source decoder is also valid for Android's
// Linux-kernel ABI and does not depend on libc DIR or struct dirent.
// Directory names remain opaque bytes: not every Unix name is valid UTF-8.
عام نوع خطأ_مدخل_دليل_لينكس =
    | نطاق_غير_صالح
    | سجل_غير_صالح
    | اسم_بلا_نهاية
;

عام نوع مدخل_دليل_نواة_لينكس = {
    المعرف: غ64,
    الإزاحة_التالية: غ64,
    النوع: غ8,
    الاسم: متجه غ8,
    موضع_السجل_التالي: غير_موقع
};

عرف اقرأ_غ64_نواة_لينكس(
    البايتات: &متجه غ8, البداية: غير_موقع, صغير_النهاية: منطقي
): غ64 {
    دع القيمة: متغير غ64 = 0;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 8) {
        دع الإزاحة: متغير غير_موقع = الفهرس;
        لو (!صغير_النهاية) { الإزاحة := 7 - الفهرس; };
        القيمة := القيمة | (((*البايتات)[البداية + الفهرس] مثل غ64) << (الإزاحة * 8));
        الفهرس := الفهرس + 1;
    }
    أرجع القيمة;
}

// A record may be unaligned relative to the supplied vector; decoding bytes
// instead of forming a native pointer avoids invalid unaligned dereferences.
عام عرف حلل_مدخل_دليل_نواة_لينكس(
    البايتات: &متجه غ8,
    البداية: غير_موقع,
    النهاية: غير_موقع,
    صغير_النهاية: منطقي
): نتيجة مدخل_دليل_نواة_لينكس, خطأ_مدخل_دليل_لينكس {
    دع السعة: غير_موقع = الطول(*البايتات) مثل غير_موقع;
    لو (البداية > النهاية || النهاية > السعة) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.نطاق_غير_صالح());
    };
    لو (النهاية - البداية < 20) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.سجل_غير_صالح());
    };
    دع طول_السجل: متغير غير_موقع = 0;
    لو (صغير_النهاية) {
        طول_السجل := ((*البايتات)[البداية + 16] مثل غير_موقع)
            | (((*البايتات)[البداية + 17] مثل غير_موقع) << 8);
    } وإلا {
        طول_السجل := (((*البايتات)[البداية + 16] مثل غير_موقع) << 8)
            | ((*البايتات)[البداية + 17] مثل غير_موقع);
    };
    لو (طول_السجل < 20 || طول_السجل > النهاية - البداية) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.سجل_غير_صالح());
    };
    دع الاسم: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = البداية + 19;
    دع نهاية_السجل: غير_موقع = البداية + طول_السجل;
    بينما (الموضع < نهاية_السجل && (*البايتات)[الموضع] != 0) {
        ألحق(الاسم, (*البايتات)[الموضع]);
        الموضع := الموضع + 1;
    }
    لو (الموضع == نهاية_السجل) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.اسم_بلا_نهاية());
    };
    دع المدخل: مدخل_دليل_نواة_لينكس = {
        المعرف: اقرأ_غ64_نواة_لينكس(البايتات, البداية, صغير_النهاية),
        الإزاحة_التالية: اقرأ_غ64_نواة_لينكس(البايتات, البداية + 8, صغير_النهاية),
        النوع: (*البايتات)[البداية + 18],
        الاسم: الاسم,
        موضع_السجل_التالي: نهاية_السجل
    };
    أرجع نتيجة.نجح(المدخل);
}
