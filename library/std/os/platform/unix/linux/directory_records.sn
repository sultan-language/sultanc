// Linux getdents64 records (include/linux/types.h, linux_dirent64):
// ino64 at 0, off64 at 8, reclen native u16 at 16, d_type at 18,
// NUL-terminated filename starting at byte 19. A record's padding is not
// part of the filename. This source decoder is also valid for Android's
// Linux-kernel ABI and does not depend on libc DIR or struct dirent.
// Directory names remain opaque bytes: not every Unix name is valid UTF-8.
// FreeBSD getdirentries records (sys/sys/dirent.h, struct dirent) share the
// first 19 bytes (d_fileno, d_off, d_reclen, d_type) and put the
// NUL-terminated d_name at 24 after d_pad0 and d_namlen (uapi.sn).
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
عام نوع خطأ_مدخل_دليل_لينكس =
    | نطاق_غير_صالح
    | سجل_غير_صالح
    | اسم_بلا_نهاية
;

عام نوع مدخل_دليل_نواة_لينكس = {
    المعرف: ط64,
    الإزاحة_التالية: ط64,
    النوع: ط8,
    الاسم: متجه ط8,
    موضع_السجل_التالي: طبيعي
};

عرف اقرأ_ط64_نواة_لينكس(
    البايتات: &متجه ط8, البداية: طبيعي, صغير_النهاية: منطقي
): ط64 {
    دع القيمة: متغير ط64 = 0;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 8) {
        دع الإزاحة: متغير طبيعي = الفهرس;
        إذا (!صغير_النهاية) { الإزاحة := 7 - الفهرس; };
        القيمة := القيمة | (((*البايتات)[البداية + الفهرس] مثل ط64) << (الإزاحة * 8));
        الفهرس := الفهرس + 1;
    }
    أرجع القيمة;
}

// A record may be unaligned relative to the supplied vector; decoding bytes
// instead of forming a native pointer avoids invalid unaligned dereferences.
عام عرف حلل_مدخل_دليل_نواة_لينكس(
    البايتات: &متجه ط8,
    البداية: طبيعي,
    النهاية: طبيعي,
    صغير_النهاية: منطقي
): نتيجة مدخل_دليل_نواة_لينكس, خطأ_مدخل_دليل_لينكس {
    دع السعة: طبيعي = الطول(*البايتات) مثل طبيعي;
    إذا (البداية > النهاية || النهاية > السعة) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.نطاق_غير_صالح());
    };
    دع بداية_الاسم: طبيعي = إزاحة_اسم_مدخل_دليل_لينكس();
    إذا (النهاية - البداية < بداية_الاسم + 1) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.سجل_غير_صالح());
    };
    دع طول_السجل: متغير طبيعي = 0;
    إذا (صغير_النهاية) {
        طول_السجل := ((*البايتات)[البداية + 16] مثل طبيعي)
            | (((*البايتات)[البداية + 17] مثل طبيعي) << 8);
    } وإلا {
        طول_السجل := (((*البايتات)[البداية + 16] مثل طبيعي) << 8)
            | ((*البايتات)[البداية + 17] مثل طبيعي);
    };
    إذا (طول_السجل < بداية_الاسم + 1 || طول_السجل > النهاية - البداية) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.سجل_غير_صالح());
    };
    دع الاسم: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = البداية + بداية_الاسم;
    دع نهاية_السجل: طبيعي = البداية + طول_السجل;
    طالما (الموضع < نهاية_السجل && (*البايتات)[الموضع] != 0) {
        ألحق(الاسم, (*البايتات)[الموضع]);
        الموضع := الموضع + 1;
    }
    إذا (الموضع == نهاية_السجل) {
        أرجع نتيجة.خطأ(خطأ_مدخل_دليل_لينكس.اسم_بلا_نهاية());
    };
    دع المدخل: مدخل_دليل_نواة_لينكس = {
        المعرف: اقرأ_ط64_نواة_لينكس(البايتات, البداية, صغير_النهاية),
        الإزاحة_التالية: اقرأ_ط64_نواة_لينكس(البايتات, البداية + 8, صغير_النهاية),
        النوع: (*البايتات)[البداية + 18],
        الاسم: الاسم,
        موضع_السجل_التالي: نهاية_السجل
    };
    أرجع نتيجة.نجح(المدخل);
}
