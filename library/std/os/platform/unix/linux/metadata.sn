استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.path;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.kernel_records;

// Linux statx(2) uses the same 256-byte UAPI record on every architecture
// (unlike newfstatat); only the byte order of its fields follows the target. Reference: include/uapi/linux/stat.h (struct statx).
// FreeBSD reads struct stat instead (below).
عام نوع خطأ_معلومات_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | معلومات_غير_متاحة
    | نظام بنوع خطأ_نظام_أصلي
;
عام نوع معلومات_مسار_لينكس = {
    النمط: ط16,
    الحجم: ط64,
    التعديل_بالثواني: ص64,
    التعديل_بالنانو: ط32,
    قناع_المعلومات: ط32
};

إذا (الهدف.المنصة == «linux» || الهدف.المنصة == «android») {
    // statx(AT_FDCWD, path, AT_SYMLINK_NOFOLLOW, STATX_BASIC_STATS, &out).
    // Do not follow symlinks when answering a filesystem path-type query.
    // The output's stx_mask is mandatory: do not claim optional fields exist.
    عام عرف اقرأ_معلومات_مسار_لينكس(
        رقم_إحصاء_مسار: ط64, المسار: &متجه ط8
    ): نتيجة معلومات_مسار_لينكس, خطأ_معلومات_لينكس {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(البايتات) -> {
            دع الاسم: متغير متجه ط8 = البايتات;
            // u64[32] supplies 256 bytes, naturally aligned for Linux statx.
            دع السجل: متغير متجه ط64 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < 32) { ألحق(السجل, 0 مثل ط64); الفهرس := الفهرس + 1; };
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إحصاء_مسار()), (-100 مثل ص64) مثل ط64,
                &متغير الاسم[0], 0x100 مثل ط64, 0x7ff مثل ط64,
                &متغير السجل[0], 0 مثل ط64
            ); }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.نظام(الخطأ)); }
            | نتيجة.نجح(_) -> {
                دع القناع: ط32 = ط32_من_كلمات_لينكس(&السجل, 0); // stx_mask
                // Require S_IFMT (STATX_TYPE), size and mtime, no fabricated data.
                إذا ((القناع & 0x241) != 0x241) {
                    أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.معلومات_غير_متاحة());
                };
                // stx_mode at offset 28; stx_size at 40; mtime at 112 and 120.
                دع النمط: ط16 = ط16_من_كلمات_لينكس(&السجل, 28); // stx_mode
                دع نانو: ط32 = ط32_من_كلمات_لينكس(&السجل, 120); // stx_mtime.tv_nsec
                إذا (نانو >= 1000000000) {
                    أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.معلومات_غير_متاحة());
                };
                دع المعلومات: معلومات_مسار_لينكس = {
                    النمط: النمط, الحجم: السجل[5],
                    التعديل_بالثواني: السجل[14] مثل ص64,
                    التعديل_بالنانو: نانو,
                    قناع_المعلومات: القناع
                };
                أرجع نتيجة.نجح(المعلومات);
            };
        };
    }
}

// FreeBSD has no statx: fstatat(AT_FDCWD, path, &stat, AT_SYMLINK_NOFOLLOW)
// fills struct stat (ino64 layout, 224 bytes on amd64, arm64 and riscv;
// offsets generated from sys/sys/stat.h into freebsd/uapi.sn). Every field
// std reads is always valid there, so the statx mask is reported complete.
إذا (الهدف.المنصة == «freebsd») {
    استورد os.platform.unix.freebsd.uapi;

    // The caller's statx number is not FreeBSD's: fstatat is issued instead.
    عام عرف اقرأ_معلومات_مسار_لينكس(
        رقم_إحصاء_مسار: ط64, المسار: &متجه ط8
    ): نتيجة معلومات_مسار_لينكس, خطأ_معلومات_لينكس {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(البايتات) -> {
            دع الاسم: متغير متجه ط8 = البايتات;
            دع الكلمات: طبيعي = حجم_سجل_معلومات_فري_بي_إس_دي() / 8;
            دع السجل: متغير متجه ط64 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < الكلمات) { ألحق(السجل, 0 مثل ط64); الفهرس := الفهرس + 1; };
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.معلومات_ملف_عند()), (-100 مثل ص64) مثل ط64,
                &متغير الاسم[0], &متغير السجل[0], علم_بلا_تتبع_وصلة_فري_بي_إس_دي(),
                0 مثل ط64, 0 مثل ط64
            ); }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.نظام(الخطأ)); }
            | نتيجة.نجح(_) -> {
                دع التعديل: طبيعي = إزاحة_تعديل_معلومات_فري_بي_إس_دي();
                دع نانو: ط64 = السجل[(التعديل + 8) / 8];
                إذا (نانو >= 1000000000) {
                    أرجع نتيجة.خطأ(خطأ_معلومات_لينكس.معلومات_غير_متاحة());
                };
                دع النمط: ط16 = ط16_من_كلمات_لينكس(&السجل, إزاحة_نمط_معلومات_فري_بي_إس_دي());
                دع الحجم: ط64 = السجل[إزاحة_حجم_معلومات_فري_بي_إس_دي() / 8];
                دع الثواني: ص64 = السجل[التعديل / 8] مثل ص64;
                دع المعلومات: معلومات_مسار_لينكس = {
                    النمط: النمط, الحجم: الحجم,
                    التعديل_بالثواني: الثواني,
                    التعديل_بالنانو: نانو مثل ط32,
                    قناع_المعلومات: 0x241
                };
                أرجع نتيجة.نجح(المعلومات);
            };
        };
    }
}

عام عرف نوع_معلومات_مسار_لينكس(المعلومات: &معلومات_مسار_لينكس): ط16 {
    أرجع (*المعلومات).النمط & 0xf000;
}
