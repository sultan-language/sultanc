استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.file_descriptors;
استورد os.platform.unix.linux.kernel_records;
استورد os.path;
استورد os.error;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Links, permission bits, file sizes, file times and the working directory
// through the direct-kernel provider (Linux, Android and FreeBSD). Every call
// takes the same arguments on both kernels: symlinkat, linkat, fchmodat,
// ftruncate, utimensat and chdir, relative to AT_FDCWD (-100 on both).
// Paths are opaque Unix bytes, as in path_operations.sn.
عام نوع خطأ_سمات_ملف_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | نظام بنوع خطأ_نظام_أصلي
;

عرف حالة_سمات_لينكس(الخام: ط64): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

عرف دليل_العمل_الحالي_لينكس(): ط64 { أرجع (-100 مثل ص64) مثل ط64; }

// symlinkat(target, AT_FDCWD, linkpath): the target is stored as given.
عام عرف أنشئ_وصلة_رمزية_لينكس(
    الهدف_المرجعي: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(الهدف_المرجعي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الهدف) -> {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_المسار) -> {
            دع الهدف_صفري: متغير متجه ط8 = بايتات_الهدف;
            دع المسار_صفري: متغير متجه ط8 = بايتات_المسار;
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.وصلة_رمزية_عند()),
                &متغير الهدف_صفري[0], دليل_العمل_الحالي_لينكس(), &متغير المسار_صفري[0],
                0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            أرجع حالة_سمات_لينكس(الخام);
        };
    };
}

// readlinkat(AT_FDCWD, path, buf, size) does not NUL-terminate and truncates
// silently, so a result that fills the buffer is retried with a larger one.
عام عرف اقرأ_وصلة_رمزية_لينكس(
    المسار: &متجه ط8
): نتيجة متجه ط8, خطأ_سمات_ملف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع السعة: متغير طبيعي = 256;
        طالما (السعة <= 1048576) {
            دع المخزن: متغير متجه ط8 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < السعة) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_وصلة_عند()),
                دليل_العمل_الحالي_لينكس(), &متغير الاسم[0], &متغير المخزن[0],
                السعة مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            طابق حالة_سمات_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(العدد) -> {
                إذا ((العدد مثل طبيعي) < السعة) {
                    دع الناتج: متغير متجه ط8 = [];
                    دع ح: متغير طبيعي = 0;
                    طالما (ح < (العدد مثل طبيعي)) { ألحق(الناتج, المخزن[ح]); ح := ح + 1; }
                    أرجع نتيجة.نجح(الناتج);
                };
            };
            السعة := السعة * 4;
        }
        أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح());
    };
}

// linkat(AT_FDCWD, existing, AT_FDCWD, new, 0): a symlink is not followed.
عام عرف أنشئ_وصلة_صلبة_لينكس(
    الأصل: &متجه ط8, المسار: &متجه ط8
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_المسار) -> {
            دع الأصل_صفري: متغير متجه ط8 = بايتات_الأصل;
            دع المسار_صفري: متغير متجه ط8 = بايتات_المسار;
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.وصلة_صلبة_عند()),
                دليل_العمل_الحالي_لينكس(), &متغير الأصل_صفري[0],
                دليل_العمل_الحالي_لينكس(), &متغير المسار_صفري[0],
                0 مثل ط64, 0 مثل ط64
            ); }
            أرجع حالة_سمات_لينكس(الخام);
        };
    };
}

// fchmodat(AT_FDCWD, path, mode, 0): follows a symlink, like chmod(2).
عام عرف اضبط_أذونات_مسار_لينكس(
    المسار: &متجه ط8, الوضع: ط64
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    إذا (الوضع > 0xfff) { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح()); };
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أذونات_مسار_عند()),
            دليل_العمل_الحالي_لينكس(), &متغير الاسم[0], الوضع,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع حالة_سمات_لينكس(الخام);
    };
}

// ftruncate(fd, length). The 32-bit ABIs' ftruncate takes a 32-bit length;
// a larger length is refused instead of being cut.
عام عرف اقتطع_واصف_لينكس(
    الواصف: &واصف_ملف_لينكس, الطول: ط64
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح()); };
    إذا (الطول > 0x7fffffffffffffff) { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح()); };
    إذا (حجم_كلمة_لينكس() == 4 && الطول > 0x7fffffff) {
        أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح());
    };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.اقتطاع_واصف()),
        ((*الواصف).القيمة مثل ط64), الطول, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع حالة_سمات_لينكس(الخام);
}

// utimensat(AT_FDCWD, path, {atime, mtime}, 0). Each time is a 64-bit
// timespec {tv_sec, tv_nsec} (the time64 entry point on the 32-bit ABIs);
// u64 storage keeps the kernel's byte order and alignment.
عام عرف اضبط_أوقات_مسار_لينكس(
    المسار: &متجه ط8, ثواني_الوصول: ص64, نانو_الوصول: ط64,
    ثواني_التعديل: ص64, نانو_التعديل: ط64
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    إذا (نانو_الوصول >= 1000000000 || نانو_التعديل >= 1000000000) {
        أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح());
    };
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الأوقات: متغير متجه ط64 = [];
        ألحق(الأوقات, ثواني_الوصول مثل ط64);
        ألحق(الأوقات, نانو_الوصول);
        ألحق(الأوقات, ثواني_التعديل مثل ط64);
        ألحق(الأوقات, نانو_التعديل);
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أوقات_مسار_عند()),
            دليل_العمل_الحالي_لينكس(), &متغير الاسم[0], &متغير الأوقات[0],
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع حالة_سمات_لينكس(الخام);
    };
}

// chdir(path): the working directory is process-wide.
عام عرف غير_دليل_العمل_لينكس(
    المسار: &متجه ط8
): نتيجة ط64, خطأ_سمات_ملف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تغيير_دليل_العمل()),
            &متغير الاسم[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع حالة_سمات_لينكس(الخام);
    };
}

// openat(AT_FDCWD, path, O_RDWR|O_CREAT|O_EXCL|O_CLOEXEC, mode): creates a
// file that did not exist, atomically (EEXIST otherwise).
عام عرف أنشئ_ملفا_جديدا_لينكس(
    المسار: &متجه ط8, الوضع: ط64
): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    دع الأعلام: ط64 = علم_فتح_للقراءة_والكتابة_لينكس() | علم_فتح_إنشاء_لينكس()
        | علم_فتح_حصري_لينكس() | علم_فتح_إغلاق_عند_التنفيذ_لينكس();
    أرجع افتح_واصف_لينكس(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), المسار, الأعلام, الوضع
    );
}

// openat(AT_FDCWD, path, O_WRONLY|O_CLOEXEC): an existing file, not truncated.
عام عرف افتح_ملفا_للتعديل_لينكس(
    المسار: &متجه ط8
): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    دع الأعلام: ط64 = علم_فتح_للكتابة_لينكس() | علم_فتح_إغلاق_عند_التنفيذ_لينكس();
    أرجع افتح_واصف_لينكس(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), المسار, الأعلام, 0 مثل ط64
    );
}

// The file mode (type and permission bits) of a path, following a final
// symlink: statx(AT_FDCWD, path, 0, STATX_MODE) on Linux, fstatat(AT_FDCWD,
// path, &stat, 0) on FreeBSD.
إذا (الهدف.المنصة == «linux» || الهدف.المنصة == «android») {
    عام عرف اقرأ_نمط_مسار_لينكس(
        المسار: &متجه ط8
    ): نتيجة ط64, خطأ_سمات_ملف_لينكس {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(البايتات) -> {
            دع الاسم: متغير متجه ط8 = البايتات;
            دع السجل: متغير متجه ط64 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < 32) { ألحق(السجل, 0 مثل ط64); ف := ف + 1; }
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إحصاء_مسار()),
                دليل_العمل_الحالي_لينكس(), &متغير الاسم[0], 0 مثل ط64, 0x3 مثل ط64,
                &متغير السجل[0], 0 مثل ط64
            ); }
            طابق حالة_سمات_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> {
                دع القناع: ط32 = ط32_من_كلمات_لينكس(&السجل, 0);
                إذا ((القناع & 0x3) != 0x3) {
                    أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.نطاق_غير_صالح());
                };
                أرجع نتيجة.نجح(ط16_من_كلمات_لينكس(&السجل, 28) مثل ط64);
            };
        };
    }
}
إذا (الهدف.المنصة == «freebsd») {
    عام عرف اقرأ_نمط_مسار_لينكس(
        المسار: &متجه ط8
    ): نتيجة ط64, خطأ_سمات_ملف_لينكس {
        طابق بايتات_مسار_يونكس_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(البايتات) -> {
            دع الاسم: متغير متجه ط8 = البايتات;
            دع الكلمات: طبيعي = حجم_سجل_معلومات_فري_بي_إس_دي() / 8;
            دع السجل: متغير متجه ط64 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < الكلمات) { ألحق(السجل, 0 مثل ط64); ف := ف + 1; }
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.معلومات_ملف_عند()),
                دليل_العمل_الحالي_لينكس(), &متغير الاسم[0], &متغير السجل[0],
                0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            طابق حالة_سمات_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> {
                أرجع نتيجة.نجح(ط16_من_كلمات_لينكس(&السجل, إزاحة_نمط_معلومات_فري_بي_إس_دي()) مثل ط64);
            };
        };
    }
}
