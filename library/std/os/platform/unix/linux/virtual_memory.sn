استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;

// Raw Linux mmap returns an unsigned pointer word. Linux -errno occupies
// only the top 4095 words; a valid high address must not be signed-cast.
// These operations require a page-aligned length/address as documented by
// the kernel, and their flags must come from Linux UAPI, not Win32 enums.
عام نوع خطأ_ذاكرة_لينكس =
    | نطاق_غير_صالح
    | منطقة_غير_نشطة
    | نظام بنوع خطأ_نظام_أصلي
;
عام نوع منطقة_ذاكرة_لينكس = {
    العنوان: غ64,
    الطول: غ64,
    نشطة: منطقي
};

عرف نتيجة_ذاكرة_لينكس(الخام: غ64): نتيجة غ64, خطأ_ذاكرة_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

عام عرف اربط_ذاكرة_لينكس(
    رقم_ربط_ذاكرة: غ64, الطول: غ64, الحماية: غ64, الأعلام: غ64,
    الواصف: ص64, إزاحة_الملف: غ64
): نتيجة منطقة_ذاكرة_لينكس, خطأ_ذاكرة_لينكس {
    لو (الطول == 0 || الحماية > 7 || الأعلام == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.نطاق_غير_صالح());
    };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_ربط_ذاكرة, 0 مثل غ64, الطول, الحماية, الأعلام,
        الواصف مثل غ64, إزاحة_الملف
    );
    طابق نتيجة_ذاكرة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العنوان) -> {
        دع المنطقة: منطقة_ذاكرة_لينكس = { العنوان: العنوان, الطول: الطول, نشطة: صواب };
        أرجع نتيجة.نجح(المنطقة);
    };
}

عام عرف ألغ_ربط_ذاكرة_لينكس(
    رقم_إلغاء_ربط: غ64, المنطقة: &متغير منطقة_ذاكرة_لينكس
): نتيجة غ64, خطأ_ذاكرة_لينكس {
    لو (!(*المنطقة).نشطة) { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.منطقة_غير_نشطة()); };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_إلغاء_ربط, (*المنطقة).العنوان, (*المنطقة).الطول,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق نتيجة_ذاكرة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { (*المنطقة).نشطة := خطأ; أرجع نتيجة.نجح(القيمة); };
}

عام عرف نفذ_توجيه_ذاكرة_لينكس(
    رقم_العملية: غ64, المنطقة: &منطقة_ذاكرة_لينكس, الوسيط: غ64
): نتيجة غ64, خطأ_ذاكرة_لينكس {
    لو (!(*المنطقة).نشطة) { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.منطقة_غير_نشطة()); };
    // mprotect/madvise: arg3=protection/advice. mlock/munlock: arg3=0.
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_العملية, (*المنطقة).العنوان, (*المنطقة).الطول, الوسيط,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_ذاكرة_لينكس(الخام);
}

// Address-range reservation for std's allocator (os/allocation.sn). These two
// calls use only integers and the raw kernel call, so they never allocate:
// the allocator itself depends on them. PROT_NONE (0) with MAP_PRIVATE |
// MAP_ANONYMOUS | MAP_NORESERVE (0x02 | 0x20 | 0x4000) reserves addresses
// without committing memory; PROT_READ | PROT_WRITE (3) commits a page range.
// A kernel error is the top-4095 return word; the result is then 0 / false.
عام عرف احجز_عناوين_لينكس(الطول: غ64): غ64 {
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة()), 0 مثل غ64, الطول,
        0 مثل غ64, 0x4022 مثل غ64, (-1 مثل ص64) مثل غ64, 0 مثل غ64
    );
    دع الحد_الأعلى: غ64 = ~(0 مثل غ64);
    لو (الخام >= الحد_الأعلى - 4094) { أرجع 0; };
    أرجع الخام;
}

عام عرف ثبت_عناوين_لينكس(العنوان: غ64, الطول: غ64): منطقي {
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حماية_ذاكرة()), العنوان, الطول,
        3 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع الخام == 0;
}
