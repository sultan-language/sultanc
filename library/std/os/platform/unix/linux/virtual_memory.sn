استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Raw Linux mmap returns an unsigned pointer word. Linux -errno occupies
// only the top 4095 words; a valid high address must not be signed-cast.
// These operations require a page-aligned length/address as documented by
// the kernel, and their flags must come from Linux UAPI, not Win32 enums.
عام نوع خطأ_ذاكرة_لينكس =
    | نطاق_غير_صالح
    | منطقة_غير_نشطة
    | نظام بنوع خطأ_نظام_أصلي
;
عام نوع منطقة_ذاكرة_لينكس = {
    العنوان: ط64,
    الطول: ط64,
    نشطة: منطقي
};

عرف نتيجة_ذاكرة_لينكس(الخام: ط64): نتيجة ط64, خطأ_ذاكرة_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// s390 old_mmap argument block (struct mmap_arg_struct), six words in order.
نوع كتلة_ربط_ذاكرة_لينكس = {
    العنوان: ط64, الطول: ط64, الحماية: ط64,
    الأعلام: ط64, الواصف: ط64, الإزاحة: ط64
};

عام عرف اربط_ذاكرة_لينكس(
    رقم_ربط_ذاكرة: ط64, الطول: ط64, الحماية: ط64, الأعلام: ط64,
    الواصف: ص64, إزاحة_الملف: ط64
): نتيجة منطقة_ذاكرة_لينكس, خطأ_ذاكرة_لينكس {
    إذا (الطول == 0 || الحماية > 7 || الأعلام == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.نطاق_غير_صالح());
    };
    دع الخام: متغير ط64 = 0;
    إذا (ربط_ذاكرة_بكتلة_وسائط_لينكس()) {
        // s390: mmap reads {addr, len, prot, flags, fd, offset} from memory.
        دع الواصف_الخام: ط64 = الواصف مثل ط64;
        دع الكتلة: متغير كتلة_ربط_ذاكرة_لينكس = {
            العنوان: 0, الطول: الطول, الحماية: الحماية, الأعلام: الأعلام,
            الواصف: الواصف_الخام, الإزاحة: إزاحة_الملف
        };
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة_بكتلة()), &متغير الكتلة.العنوان,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_ربط_ذاكرة, 0 مثل ط64, الطول, الحماية, الأعلام,
            الواصف مثل ط64, إزاحة_الملف
        ); }
    };
    طابق نتيجة_ذاكرة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(العنوان) -> {
        دع المنطقة: منطقة_ذاكرة_لينكس = { العنوان: العنوان, الطول: الطول, نشطة: صواب };
        أرجع نتيجة.نجح(المنطقة);
    };
}

عام عرف ألغ_ربط_ذاكرة_لينكس(
    رقم_إلغاء_ربط: ط64, المنطقة: &متغير منطقة_ذاكرة_لينكس
): نتيجة ط64, خطأ_ذاكرة_لينكس {
    إذا (!(*المنطقة).نشطة) { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.منطقة_غير_نشطة()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_إلغاء_ربط, (*المنطقة).العنوان, (*المنطقة).الطول,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_ذاكرة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { (*المنطقة).نشطة := خطأ; أرجع نتيجة.نجح(القيمة); };
}

عام عرف نفذ_توجيه_ذاكرة_لينكس(
    رقم_العملية: ط64, المنطقة: &منطقة_ذاكرة_لينكس, الوسيط: ط64
): نتيجة ط64, خطأ_ذاكرة_لينكس {
    إذا (!(*المنطقة).نشطة) { أرجع نتيجة.خطأ(خطأ_ذاكرة_لينكس.منطقة_غير_نشطة()); };
    // mprotect/madvise: arg3=protection/advice. mlock/munlock: arg3=0.
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_العملية, (*المنطقة).العنوان, (*المنطقة).الطول, الوسيط,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_ذاكرة_لينكس(الخام);
}

// Address-range reservation for std's allocator (os/allocation.sn). These two
// calls use only integers and the raw kernel call, so they never allocate:
// the allocator itself depends on them. PROT_NONE (0) with MAP_PRIVATE |
// MAP_ANONYMOUS | MAP_NORESERVE (uapi.sn; FreeBSD has no MAP_NORESERVE) reserves addresses
// without committing memory; PROT_READ | PROT_WRITE (3) commits a page range.
// A kernel error is the top-4095 return word; the result is then 0 / false.
عام عرف احجز_عناوين_لينكس(الطول: ط64): ط64 {
    دع الأعلام: ط64 = ربط_ذاكرة_خاص_لينكس() | ربط_ذاكرة_مجهول_لينكس() | ربط_ذاكرة_بلا_حجز_لينكس();
    دع بلا_واصف: ط64 = (-1 مثل ص64) مثل ط64;
    دع الخام: متغير ط64 = 0;
    إذا (ربط_ذاكرة_بكتلة_وسائط_لينكس()) {
        // s390: mmap reads {addr, len, prot, flags, fd, offset} from memory.
        // A stack record, not a vector: the allocator itself reserves
        // through this call, so it must not allocate.
        دع الكتلة: متغير كتلة_ربط_ذاكرة_لينكس = {
            العنوان: 0, الطول: الطول, الحماية: 0, الأعلام: الأعلام,
            الواصف: بلا_واصف, الإزاحة: 0
        };
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة_بكتلة()), &متغير الكتلة.العنوان,
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة()), 0 مثل ط64, الطول,
            0 مثل ط64, الأعلام, بلا_واصف, 0 مثل ط64
        ); }
    };
    دع الحد_الأعلى: ط64 = ~(0 مثل ط64);
    إذا (الخام >= الحد_الأعلى - 4094) { أرجع 0; };
    أرجع الخام;
}

عام عرف ثبت_عناوين_لينكس(العنوان: ط64, الطول: ط64): منطقي {
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حماية_ذاكرة()), العنوان, الطول,
        3 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع الخام == 0;
}

// Linux MADV_DONTNEED (4) on anonymous private pages discards their
// contents; the reservation and its RW access remain intact, with zero-fill
// on reuse. FreeBSD takes MADV_FREE (5): the pages may be discarded and
// their contents must not be relied on (uapi.sn نصيحة_ذاكرة_استرداد_لينكس).
// Callers must exclude every live allocation and allocator metadata page.
عام عرف استرد_عناوين_لينكس(العنوان: ط64, الطول: ط64): منطقي {
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نصيحة_ذاكرة()),
        العنوان, الطول, نصيحة_ذاكرة_استرداد_لينكس(), 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع الخام == 0;
}
