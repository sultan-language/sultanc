استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.file_descriptors;
استورد os.platform.unix.linux.sockets;
استورد os.buffer;
استورد os.error;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Socket names and address-bearing datagrams (Linux, Android, FreeBSD):
// getsockname, getpeername, sendto with a peer address and recvfrom that
// reports the sender. Addresses are the kernel's sockaddr bytes, at most a
// 128-byte sockaddr_storage with a 32-bit socklen_t length.

عام نوع حزمة_واردة_لينكس = { المقروء: ط64, العنوان: متجه ط8 };

عرف اقطع_عنوان_لينكس(المخزن: &متجه ط8, الطول: ط32): نتيجة متجه ط8, خطأ_مقبس_لينكس {
    إذا (الطول > 128) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول مثل طبيعي)) { ألحق(الناتج, (*المخزن)[ف]); ف := ف + 1; }
    أرجع نتيجة.نجح(الناتج);
}

// getsockname (محلي) or getpeername.
عام عرف اقرأ_اسم_مقبس_لينكس(
    المقبس: &واصف_ملف_لينكس, محلي: منطقي
): نتيجة متجه ط8, خطأ_مقبس_لينكس {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 128) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
    دع الطول: متغير متجه ط32 = [128];
    دع العملية: متغير عملية_نداء_نواة_لينكس = عملية_نداء_نواة_لينكس.اسم_مقبس_نظير();
    إذا (محلي) { العملية := عملية_نداء_نواة_لينكس.اسم_مقبس_محلي(); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(العملية), ((*المقبس).القيمة مثل ط64),
        &متغير المخزن[0], &متغير الطول[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_مقبس_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { أرجع اقطع_عنوان_لينكس(&المخزن, الطول[0]); };
}

// sendto(fd, buf, len, MSG_NOSIGNAL, addr, addrlen): one datagram to العنوان.
عام عرف أرسل_إلى_عنوان_لينكس(
    المقبس: &واصف_ملف_لينكس, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد,
    العنوان: &متجه ط8
): نتيجة ط64, خطأ_مقبس_لينكس {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 0x7ffff000 || الطول(*العنوان) < 2 || الطول(*العنوان) > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع المؤقت: متجه ط8 = [0];
    دع الخام: ط64;
    إذا (المطلوب > 0) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إرسال_إلى_عنوان()),
            ((*المقبس).القيمة مثل ط64), &(*المحتوى)[الإزاحة مثل طبيعي], المطلوب مثل ط64,
            علم_إرسال_بلا_إشارة_لينكس(), &(*العنوان)[0], الطول(*العنوان) مثل ط64
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إرسال_إلى_عنوان()),
            ((*المقبس).القيمة مثل ط64), &المؤقت[0], 0 مثل ط64,
            علم_إرسال_بلا_إشارة_لينكس(), &(*العنوان)[0], الطول(*العنوان) مثل ط64
        ); }
    };
    أرجع نتيجة_مقبس_لينكس(الخام);
}

// recvfrom(fd, buf, len, 0, addr, &addrlen): one datagram and its sender.
عام عرف استقبل_من_عنوان_لينكس(
    المقبس: &واصف_ملف_لينكس, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة حزمة_واردة_لينكس, خطأ_مقبس_لينكس {
    إذا (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب) || المطلوب > 0x7ffff000) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع العنوان: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 128) { ألحق(العنوان, 0 مثل ط8); ف := ف + 1; }
    دع الطول: متغير متجه ط32 = [128];
    دع المؤقت: متغير متجه ط8 = [0];
    دع الخام: ط64;
    إذا (المطلوب > 0) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.استقبال_من_عنوان()),
            ((*المقبس).القيمة مثل ط64), &متغير (*المخزن)[الإزاحة مثل طبيعي], المطلوب مثل ط64,
            0 مثل ط64, &متغير العنوان[0], &متغير الطول[0]
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.استقبال_من_عنوان()),
            ((*المقبس).القيمة مثل ط64), &متغير المؤقت[0], 0 مثل ط64,
            0 مثل ط64, &متغير العنوان[0], &متغير الطول[0]
        ); }
    };
    طابق نتيجة_مقبس_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقروء) -> {
        طابق اقطع_عنوان_لينكس(&العنوان, الطول[0]) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المرسل) -> {
            دع الحزمة: حزمة_واردة_لينكس = { المقروء: المقروء, العنوان: المرسل };
            أرجع نتيجة.نجح(الحزمة);
        };
    };
}
