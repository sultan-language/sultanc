استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.platform.unix.linux.syscalls.kernel_result;

لو (الهدف.المنصة == «linux» || الهدف.المنصة == «android») {
    // prlimit64 on the calling process (pid 0), RLIMIT_STACK (3). Linux grows the main thread's stack on demand up to the
    // current soft limit, so raising the soft limit at run time takes effect for
    // the running process. The gap below the stack reserved at exec time is at
    // least 128 MiB, so a soft limit up to that size can be used.
    عرف رقم_حد_المكدس_لينكس(): ط64 { أرجع 3 مثل ط64; }

    // Raise the soft stack limit to at least `المطلوب` bytes, within the hard
    // limit. True when the limit is already high enough or was raised.
    عام عرف ارفع_حد_المكدس_لينكس(المطلوب: ط64): منطقي {
        دع الحالي: متغير متجه ط64 = [0, 0];
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_حد_مورد()), 0 مثل ط64, رقم_حد_المكدس_لينكس(),
            0 مثل ط64, &متغير الحالي[0], 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { };
        دع غير_محدود: ط64 = ~(0 مثل ط64);
        لو (الحالي[0] == غير_محدود || الحالي[0] >= المطلوب) { أرجع صواب; };
        دع الجديد: متغير ط64 = المطلوب;
        لو (الحالي[1] != غير_محدود && الحالي[1] < الجديد) { الجديد := الحالي[1]; };
        لو (الجديد <= الحالي[0]) { أرجع خطأ; };
        دع المطلوب_ضبطه: متغير متجه ط64 = [الجديد, الحالي[1]];
        دع خام_الضبط: ط64;
        غير_آمن { خام_الضبط := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ضبط_حد_مورد()), 0 مثل ط64, رقم_حد_المكدس_لينكس(),
            &متغير المطلوب_ضبطه[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(خام_الضبط) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { أرجع الجديد >= المطلوب; };
    }
}

// FreeBSD: getrlimit(RLIMIT_STACK, &rl) and setrlimit(RLIMIT_STACK, &rl),
// struct rlimit {rlim_cur, rlim_max} of two 64-bit words, RLIM_INFINITY the
// all-ones word. exec reserves kern.maxssiz for the main stack (kern_exec.c
// exec_new_vmspace; 512 MiB on amd64 by default) and grows it on demand up
// to the current soft limit (vm_map_growstack), so raising the soft limit
// takes effect at run time, within that reservation.
لو (الهدف.المنصة == «freebsd») {
    استورد os.platform.unix.freebsd.uapi;

    عام عرف ارفع_حد_المكدس_لينكس(المطلوب: ط64): منطقي {
        دع الحالي: متغير متجه ط64 = [0, 0];
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_حد_مورد()), حد_المكدس_فري_بي_إس_دي(),
            &متغير الحالي[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { };
        دع غير_محدود: ط64 = ~(0 مثل ط64);
        لو (الحالي[0] == غير_محدود || الحالي[0] >= المطلوب) { أرجع صواب; };
        دع الجديد: متغير ط64 = المطلوب;
        لو (الحالي[1] != غير_محدود && الحالي[1] < الجديد) { الجديد := الحالي[1]; };
        لو (الجديد <= الحالي[0]) { أرجع خطأ; };
        دع المطلوب_ضبطه: متغير متجه ط64 = [الجديد, الحالي[1]];
        دع خام_الضبط: ط64;
        غير_آمن { خام_الضبط := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ضبط_حد_مورد()), حد_المكدس_فري_بي_إس_دي(),
            &متغير المطلوب_ضبطه[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(خام_الضبط) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(_) -> { أرجع الجديد >= المطلوب; };
    }
}
