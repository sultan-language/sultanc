استورد os.platform.unix.linux.file_descriptors;
// Linux's exit_group terminates the whole thread group; exit terminates
// only the invoking thread. Process arguments/environment are startup data,
// not syscalls. A safe spawn must not be faked using clone alone.
عام عرف اخرج_من_مجموعة_عملية_لينكس(رقم_الخروج_الجماعي: غ64, الحالة: غ64): فراغ {
    دع الناتج: غ64 = بدائي_نداء_نواة_خام(
        رقم_الخروج_الجماعي, الحالة, 0 مثل غ64, 0 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
}

استورد os.path;
استورد os.error;
استورد os.platform.unix.process_startup;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;

// waitid(P_PID, pid, siginfo, WEXITED, NULL) consumes an exited child once.
// The caller must own a child PID obtained from an actual spawn operation.
// Linux kernel siginfo_t is 128 bytes on both supported 64-bit ABIs.
// Header fields are 32-bit; SIGCHLD si_pid and si_status are at offsets 16/24.
عام نوع حالة_طفل_لينكس =
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

عام نوع خطأ_انتظار_لينكس =
    | معرف_غير_صالح
    | استجابة_غير_صالحة
    | نظام بنوع خطأ_نظام_أصلي
;

عام عرف انتظر_طفلا_لينكس(معرف_الطفل: عدد): نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس {
    لو (معرف_الطفل <= 0 || معرف_الطفل > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.معرف_غير_صالح());
    };
    // 32 * u32 = 128 bytes, with 8-byte alignment guaranteed by u64 storage.
    دع المعلومات: متغير متجه غ64 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < 16) {
        ألحق(المعلومات, 0 مثل غ64);
        الموضع := الموضع + 1;
    }
    // P_PID=1, WEXITED=4; fifth syscall argument is the optional rusage.
    دع الخام: متغير غ64 = 0;
    دع اكتمل: متغير منطقي = خطأ;
    بينما (!اكتمل) {
        الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظار_عملية()),
            1 مثل غ64, معرف_الطفل مثل غ64, &متغير المعلومات[0],
            4 مثل غ64, 0 مثل غ64, 0 مثل غ64
        );
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(الخطأ) -> {
            لو (الخطأ.الرمز != 4) { اكتمل := صواب; } // EINTR
        }
        | نتيجة.نجح(_) -> { اكتمل := صواب; };
    }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {
        // SIGCHLD (17) is at byte 0, si_code at 8, si_pid at
        // 16, and si_status at 24 on the supported Linux 64-bit ABIs.
        دع الإشارة: غ32 = (المعلومات[0] & 0xffffffff) مثل غ32;
        دع الرمز: غ32 = (المعلومات[1] & 0xffffffff) مثل غ32;
        دع المعرف: غ32 = (المعلومات[2] & 0xffffffff) مثل غ32;
        دع الحالة: غ32 = (المعلومات[3] & 0xffffffff) مثل غ32;
        لو (الإشارة != 17 || المعرف != (معرف_الطفل مثل غ32)) {
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
        };
        لو (الرمز == 1 && الحالة <= 255) {
            أرجع نتيجة.نجح(حالة_طفل_لينكس.خرج(الحالة مثل عدد));
        };
        لو ((الرمز == 2 || الرمز == 3) && الحالة >= 1 && الحالة <= 64) {
            أرجع نتيجة.نجح(حالة_طفل_لينكس.إشارة(الحالة مثل عدد));
        };
        أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
    };
}

// pipe2(O_CLOEXEC) creates a kernel-owned error-reporting channel without
// exposing descriptors across a successful execve. The parent keeps the
// read end; the future child owns the write end. This is one component of
// safe spawning, not itself a spawn or a child-execution ABI.
عام نوع قناة_فشل_طفل_لينكس = {
    القارئ: واصف_ملف_لينكس,
    الكاتب: واصف_ملف_لينكس
};

عام عرف أنشئ_قناة_فشل_طفل_لينكس(): نتيجة قناة_فشل_طفل_لينكس, خطأ_انتظار_لينكس {
    دع الواصفات: متغير متجه ص32 = [-1, -1];
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قناة_عملية()),
        &متغير الواصفات[0], 0x80000 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {
        لو (الواصفات[0] < 0 || الواصفات[1] < 0) {
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
        };
        دع القارئ: واصف_ملف_لينكس = { القيمة: الواصفات[0] مثل غ64, مفتوح: صواب };
        دع الكاتب: واصف_ملف_لينكس = { القيمة: الواصفات[1] مثل غ64, مفتوح: صواب };
        دع القناة: قناة_فشل_طفل_لينكس = { القارئ: القارئ, الكاتب: الكاتب };
        أرجع نتيجة.نجح(القناة);
    };
}

// Both ends remain owned until explicitly closed. Preserve the first error
// while still attempting the other close to prevent descriptor leaks.
عام عرف أغلق_قناة_فشل_طفل_لينكس(
    القناة: &متغير قناة_فشل_طفل_لينكس
): نتيجة غ64, خطأ_واصف_لينكس {
    دع خطأ_الأول: متغير اختيار خطأ_واصف_لينكس = اختيار.لا_شيء();
    لو ((*القناة).القارئ.مفتوح) {
        طابق أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            &متغير (*القناة).القارئ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { خطأ_الأول := اختيار.بعض(الخطأ); }
        | نتيجة.نجح(_) -> {};
    };
    لو ((*القناة).الكاتب.مفتوح) {
        طابق أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            &متغير (*القناة).الكاتب
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق خطأ_الأول مع
            | اختيار.لا_شيء -> { خطأ_الأول := اختيار.بعض(الخطأ); }
            | اختيار.بعض(_) -> {};
        }
        | نتيجة.نجح(_) -> {};
    };
    طابق خطأ_الأول مع
    | اختيار.بعض(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); };
}

// If IPC fails after clone, the parent cannot return a PID it does not own.
// Kill that exact child and reap it to prevent a zombie. Errors in this
// cleanup must not hide the first communication failure.
عرف ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف: عدد): فراغ {
    دع القتل: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أرسل_إشارة_عملية()),
        المعرف مثل غ64, 9 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    دع الانتظار: نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس = انتظر_طفلا_لينكس(المعرف);
}

// The child image always receives an explicit environment vector owned by the
// caller. std.os.process supplies either caller-provided entries or an owned
// copy of the process startup environment (os.platform.unix.process_startup);
// no /proc snapshot, libc environ or invented global is used here.
// All storage and argv/envp pointer arrays are completed BEFORE clone. The
// child runs only raw kernel calls until execve or _exit; it never allocates,
// resizes a SultanC vector, locks a runtime mutex, or returns to a caller.
عام نوع خطأ_تشغيل_طفل_لينكس =
    | مدخل_غير_صالح
    | فشل_بروتوكول_الطفل
    | واصف بنوع خطأ_واصف_لينكس
    | نظام بنوع خطأ_نظام_أصلي
;

// Linux MAX_ARG_STRLEN is 32 pages, but page size may differ. This modest
// source-level bound also protects against oversized temporary allocations;
// the kernel remains authoritative and can return E2BIG.
عرف جهز_عنصر_تنفيذ_لينكس(
    البايتات: &متجه غ8
): نتيجة متجه غ8, خطأ_تشغيل_طفل_لينكس {
    لو ((الطول(*البايتات) مثل غير_موقع) > 65535) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    طابق بايتات_مسار_يونكس_صفرية(البايتات) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح()); }
    | نتيجة.نجح(المنتهي) -> { أرجع نتيجة.نجح(المنتهي); };
}

عرف تحقق_متغير_تنفيذ_لينكس(المدخل: &متجه غ8): منطقي {
    لو (الطول(*المدخل) == 0) { أرجع خطأ; };
    دع الفهرس: متغير غير_موقع = 0;
    دع فاصلة: متغير منطقي = خطأ;
    بينما (الفهرس < (الطول(*المدخل) مثل غير_موقع)) {
        دع البايت: غ8 = (*المدخل)[الفهرس];
        لو (البايت == 0) { أرجع خطأ; };
        لو (البايت == 61 && !فاصلة) {
            لو (الفهرس == 0) { أرجع خطأ; };
            فاصلة := صواب;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع فاصلة;
}

// execvp/posix_spawnp program lookup. A program spelling containing '/' is
// used as given. A bare name is searched in the PARENT's startup PATH, in
// order; an empty PATH element names the current directory (POSIX XBD 8.3).
// A missing PATH is reported as ENOENT: no platform default search list is
// invented here. Every candidate is a completed NUL-terminated buffer built
// before clone, so the child only issues execve attempts.
عرف مرشحو_تنفيذ_لينكس(
    البرنامج: &متجه غ8
): نتيجة متجه متجه غ8, خطأ_تشغيل_طفل_لينكس {
    دع المرشحون: متغير متجه متجه غ8 = [];
    دع فيه_فاصل: متغير منطقي = خطأ;
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (الطول(*البرنامج) مثل غير_موقع)) {
        لو ((*البرنامج)[الفهرس] == 0x2F) { فيه_فاصل := صواب; };
        الفهرس := الفهرس + 1;
    }
    لو (فيه_فاصل) {
        طابق جهز_عنصر_تنفيذ_لينكس(البرنامج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجهز) -> { ألحق(المرشحون, المجهز); };
        أرجع نتيجة.نجح(المرشحون);
    };
    دع اسم_المسار: نص = «PATH»;
    دع قيمة_المسار: متغير متجه غ8 = [];
    طابق ابحث_قيمة_بيئة_إقلاع_يونكس(&اسم_المسار) مع
    | نتيجة_بحث_بيئة_إقلاع_يونكس.موجود(القيمة) -> { قيمة_المسار := القيمة; }
    | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_موجود -> {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(
            أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), 2)
        ));
    }
    | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح -> {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    دع طول_المسار: غير_موقع = الطول(قيمة_المسار) مثل غير_موقع;
    دع البداية: متغير غير_موقع = 0;
    الفهرس := 0;
    بينما (الفهرس <= طول_المسار) {
        دع نهاية_عنصر: متغير منطقي = الفهرس == طول_المسار;
        لو (!نهاية_عنصر) { نهاية_عنصر := قيمة_المسار[الفهرس] == 0x3A; };
        لو (نهاية_عنصر) {
            لو ((الطول(المرشحون) مثل غير_موقع) >= 256) {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
            };
            دع المرشح: متغير متجه غ8 = [];
            دع ح: متغير غير_موقع = البداية;
            بينما (ح < الفهرس) { ألحق(المرشح, قيمة_المسار[ح]); ح := ح + 1; }
            لو (الفهرس > البداية) { ألحق(المرشح, 0x2F); };
            ح := 0;
            بينما (ح < (الطول(*البرنامج) مثل غير_موقع)) {
                ألحق(المرشح, (*البرنامج)[ح]);
                ح := ح + 1;
            }
            طابق جهز_عنصر_تنفيذ_لينكس(&المرشح) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> { ألحق(المرشحون, المجهز); };
            البداية := الفهرس + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة.نجح(المرشحون);
}

// Linux raw clone(SIGCHLD, NULL, NULL, NULL, NULL) duplicates the address
// space copy-on-write without CLONE_VM/CLONE_FILES/CLONE_THREAD. All five
// clone arguments after flags are zero: this is valid for both x86_64 and
// AArch64 despite their different fourth/fifth argument ordering.
// Pipe EOF after closing the parent's writer means execve closed the child's
// O_CLOEXEC writer. Four bytes instead mean child execve failed with errno.
عام عرف شغل_طفلا_لينكس_ببيئة(
    البرنامج: &متجه غ8, الوسائط: &متجه متجه غ8,
    البيئة: &متجه متجه غ8, بيئة_موروثة: منطقي
): نتيجة عدد, خطأ_تشغيل_طفل_لينكس {
    لو (الطول(*البرنامج) == 0
        || (الطول(*الوسائط) مثل غير_موقع) > 4096
        || (الطول(*البيئة) مثل غير_موقع) > 4096) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    طابق مرشحو_تنفيذ_لينكس(البرنامج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرشحون_المجهزون) -> {
        دع المرشحون: متغير متجه متجه غ8 = المرشحون_المجهزون;
        دع عدد_المرشحين: غير_موقع = الطول(المرشحون) مثل غير_موقع;
        دع وسائط_مجهزة: متغير متجه متجه غ8 = [];
        دع بيئة_مجهزة: متغير متجه متجه غ8 = [];
        // argv[0] is the executable path; subsequent arguments keep their
        // original byte contents including intentionally empty arguments.
        طابق جهز_عنصر_تنفيذ_لينكس(البرنامج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الأول) -> { ألحق(وسائط_مجهزة, الأول); };
        دع الإجمالي: متغير غير_موقع = الطول(وسائط_مجهزة[0]) مثل غير_موقع;
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < (الطول(*الوسائط) مثل غير_موقع)) {
            طابق جهز_عنصر_تنفيذ_لينكس(&(*الوسائط)[الفهرس]) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> {
                دع السعة: غير_موقع = الطول(المجهز) مثل غير_موقع;
                لو (السعة > 1048576 - الإجمالي) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
                };
                الإجمالي := الإجمالي + السعة;
                ألحق(وسائط_مجهزة, المجهز);
            };
            الفهرس := الفهرس + 1;
        }
        الفهرس := 0;
        بينما (الفهرس < (الطول(*البيئة) مثل غير_موقع)) {
            لو (!بيئة_موروثة && !تحقق_متغير_تنفيذ_لينكس(&(*البيئة)[الفهرس])) {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
            };
            طابق جهز_عنصر_تنفيذ_لينكس(&(*البيئة)[الفهرس]) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> {
                دع السعة: غير_موقع = الطول(المجهز) مثل غير_موقع;
                لو (السعة > 1048576 - الإجمالي) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
                };
                الإجمالي := الإجمالي + السعة;
                ألحق(بيئة_مجهزة, المجهز);
            };
            الفهرس := الفهرس + 1;
        }
        // Do not append any string after creating an address to its data.
        دع مؤشرات_الوسائط: متغير متجه *غ8 = [];
        الفهرس := 0;
        بينما (الفهرس < (الطول(وسائط_مجهزة) مثل غير_موقع)) {
            ألحق(مؤشرات_الوسائط, &وسائط_مجهزة[الفهرس][0]);
            الفهرس := الفهرس + 1;
        }
        ألحق(مؤشرات_الوسائط, الفارغ);
        دع مؤشرات_البيئة: متغير متجه *غ8 = [];
        الفهرس := 0;
        بينما (الفهرس < (الطول(بيئة_مجهزة) مثل غير_موقع)) {
            ألحق(مؤشرات_البيئة, &بيئة_مجهزة[الفهرس][0]);
            الفهرس := الفهرس + 1;
        }
        ألحق(مؤشرات_البيئة, الفارغ);
        // Allocate the error record before cloning. Child code does not
        // change its size or allocate through the SultanC runtime.
        دع رسالة_الطفل: متغير متجه غ8 = [0, 0, 0, 0];
        طابق أنشئ_قناة_فشل_طفل_لينكس() مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_انتظار_لينكس.نظام(الأصلي) -> {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
            }
            | _ -> { أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل()); };
        }
        | نتيجة.نجح(القناة_الجديدة) -> {
            دع القناة: متغير قناة_فشل_طفل_لينكس = القناة_الجديدة;
            // pipe2 chooses the lowest unused descriptors. If stdio was
            // closed, either pipe end may be 0, 1 or 2; move it above the
            // standard range BEFORE clone, preserving the stdio state for
            // execve and the owned close-on-exec error channel.
            دع نداء_تحكم: غ64 = رقم_نداء_نواة_لينكس(
                عملية_نداء_نواة_لينكس.تحكم_واصف()
            );
            دع نداء_إغلاق: غ64 = رقم_نداء_نواة_لينكس(
                عملية_نداء_نواة_لينكس.إغلاق()
            );
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(
                نداء_تحكم, نداء_إغلاق, &متغير القناة.القارئ
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة غ64, خطأ_واصف_لينكس =
                    أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(
                نداء_تحكم, نداء_إغلاق, &متغير القناة.الكاتب
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة غ64, خطأ_واصف_لينكس =
                    أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            // Resolve syscall identities in the parent, not the child.
            دع نداء_نسخ: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نسخ_عملية());
            دع نداء_تشغيل: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تشغيل_برنامج());
            دع نداء_قراءة: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة());
            دع نداء_كتابة: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة());
            دع نداء_خروج: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.خروج());
            دع نداء_إغلاق_مجال: غ64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أغلق_مجال_واصفات());
            دع الخام: غ64 = بدائي_نداء_نواة_خام(
                نداء_نسخ, 17 مثل غ64, 0 مثل غ64, 0 مثل غ64,
                0 مثل غ64, 0 مثل غ64, 0 مثل غ64
            );
            لو (الخام == 0) {
                // Child: never close the parent's writer or run finalizers.
                // Only close the reader. Linux close+EINTR still consumes fd.
                دع إغلاق_القارئ: غ64 = بدائي_نداء_نواة_خام(
                    نداء_إغلاق, القناة.القارئ.القيمة, 0 مثل غ64, 0 مثل غ64,
                    0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                );
                // Close every nonstandard inherited descriptor other than
                // the O_CLOEXEC error writer. close_range is an explicit
                // Linux >=5.9 dependency: ENOSYS is reported to the parent,
                // never silently replaced by leaking inherited handles.
                دع نتيجة_التنفيذ: متغير غ64 = 0;
                دع الكاتب: غ64 = القناة.الكاتب.القيمة;
                لو (الكاتب > 3) {
                    نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                        نداء_إغلاق_مجال, 3 مثل غ64, الكاتب - 1,
                        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                    );
                };
                لو (نتيجة_التنفيذ == 0) {
                    دع البداية_الثانية: متغير غ64 = 3;
                    لو (الكاتب >= 3) { البداية_الثانية := الكاتب + 1; };
                    نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                        نداء_إغلاق_مجال, البداية_الثانية, 4294967295 مثل غ64,
                        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                    );
                };
                لو (نتيجة_التنفيذ == 0) {
                    // argv/envp are arrays of raw pointers; a reference to a
                    // pointer is not a raw-call scalar, so form the raw
                    // pointer to each array through the canonical
                    // reference-to-pointer conversion.
                    دع مصفوفة_الوسائط: **غ8 = &مؤشرات_الوسائط[0];
                    دع مصفوفة_البيئة: **غ8 = &مؤشرات_البيئة[0];
                    // execvp order: ENOENT/ENOTDIR try the next candidate;
                    // EACCES is remembered and reported if nothing else
                    // runs; any other result (including success) stops.
                    دع خطأ_الوصول: متغير منطقي = خطأ;
                    دع مستمر: متغير منطقي = صواب;
                    دع المرشح: متغير غير_موقع = 0;
                    بينما (مستمر && المرشح < عدد_المرشحين) {
                        نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                            نداء_تشغيل, &المرشحون[المرشح][0], مصفوفة_الوسائط,
                            مصفوفة_البيئة, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                        );
                        لو (نتيجة_التنفيذ == (~(0 مثل غ64)) - 1
                            || نتيجة_التنفيذ == (~(0 مثل غ64)) - 19) {
                        } وإلا لو (نتيجة_التنفيذ == (~(0 مثل غ64)) - 12) {
                            خطأ_الوصول := صواب;
                        } وإلا {
                            مستمر := خطأ;
                        };
                        المرشح := المرشح + 1;
                    }
                    لو (مستمر && خطأ_الوصول) {
                        نتيجة_التنفيذ := (~(0 مثل غ64)) - 12;
                    };
                };
                // execve has no successful return. Report raw kernel errno,
                // never call error translators or heap functions in child.
                // Raw syscall failures occupy [-4095, -1]. Zero is a
                // protocol-invalid record, never a native errno.
                دع الرمز: متغير غ32 = 0;
                لو (نتيجة_التنفيذ >= ((~(0 مثل غ64)) - 4094)) {
                    الرمز := ((~نتيجة_التنفيذ) + 1) مثل غ32;
                };
                رسالة_الطفل[0] := (الرمز & 255) مثل غ8;
                رسالة_الطفل[1] := ((الرمز >> 8) & 255) مثل غ8;
                رسالة_الطفل[2] := ((الرمز >> 16) & 255) مثل غ8;
                رسالة_الطفل[3] := ((الرمز >> 24) & 255) مثل غ8;
                دع الموضع: متغير غ64 = 0;
                بينما (الموضع < 4) {
                    دع المكتوب: غ64 = بدائي_نداء_نواة_خام(
                        نداء_كتابة, القناة.الكاتب.القيمة,
                        &متغير رسالة_الطفل[الموضع مثل غير_موقع], 4 - الموضع,
                        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                    );
                    لو (المكتوب == ((~(0 مثل غ64)) - 3)) { } // -EINTR
                    وإلا لو (المكتوب > 4 - الموضع || المكتوب == 0) { الموضع := 4; }
                    وإلا { الموضع := الموضع + المكتوب; };
                }
                دع الخروج: غ64 = بدائي_نداء_نواة_خام(
                    نداء_خروج, 127 مثل غ64, 0 مثل غ64, 0 مثل غ64,
                    0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                );
                // The kernel never returns from exit. No parent-only
                // SultanC resource cleanup is permitted here.
                بينما (صواب) { }
            }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الأصلي) -> {
                دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
            }
            | نتيجة.نجح(المعرف) -> {
                لو (المعرف == 0 || المعرف > 2147483647) {
                    دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                // Parent must close the write end before reading. EOF then
                // distinguishes exec success from an errno record.
                دع غلق_الكاتب: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                    نداء_إغلاق, &متغير القناة.الكاتب
                );
                // A failed close must not be ignored before waiting for EOF:
                // on Linux even EINTR consumes the descriptor, and returning
                // an unowned PID after a channel error would leak a child.
                طابق غلق_الكاتب مع
                | نتيجة.خطأ(الخطأ) -> {
                    دع غلق_القارئ: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                        نداء_إغلاق, &متغير القناة.القارئ
                    );
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
                }
                | نتيجة.نجح(_) -> {};
                دع المقروء: متغير غ64 = 0;
                دع فشل_القراءة: متغير اختيار خطأ_تشغيل_طفل_لينكس = اختيار.لا_شيء();
                دع نهاية: متغير منطقي = خطأ;
                بينما (!نهاية && المقروء < 4) {
                    دع القراءة_الخام: غ64 = بدائي_نداء_نواة_خام(
                        نداء_قراءة, القناة.القارئ.القيمة,
                        &متغير رسالة_الطفل[المقروء مثل غير_موقع], 4 - المقروء,
                        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
                    );
                    طابق حلل_نتيجة_نداء_نواة_لينكس(القراءة_الخام) مع
                    | نتيجة.خطأ(الأصلي) -> {
                        لو (الأصلي.الرمز != 4) {
                            فشل_القراءة := اختيار.بعض(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
                            نهاية := صواب;
                        };
                    }
                    | نتيجة.نجح(حجم_القراءة) -> {
                        // The kernel word is غير_موقع; the progress counter is غ64.
                        دع الحجم: غ64 = حجم_القراءة مثل غ64;
                        لو (الحجم == 0) { نهاية := صواب; }
                        وإلا لو (الحجم > 4 - المقروء) {
                            فشل_القراءة := اختيار.بعض(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                            نهاية := صواب;
                        }
                        وإلا { المقروء := المقروء + الحجم; };
                    };
                }
                دع غلق_القارئ: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                    نداء_إغلاق, &متغير القناة.القارئ
                );
                طابق فشل_القراءة مع
                | اختيار.بعض(الخطأ) -> {
                    // Abort and reap a child whose status cannot be safely
                    // transferred; do not lose its PID or misreport exec.
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | اختيار.لا_شيء -> {};
                طابق غلق_القارئ مع
                | نتيجة.خطأ(الخطأ) -> {
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
                }
                | نتيجة.نجح(_) -> {};
                لو (المقروء == 0) {
                    أرجع نتيجة.نجح(المعرف مثل عدد);
                };
                لو (المقروء != 4) {
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                دع الرمز: عدد = (رسالة_الطفل[0] مثل عدد)
                    | ((رسالة_الطفل[1] مثل عدد) << 8)
                    | ((رسالة_الطفل[2] مثل عدد) << 16)
                    | ((رسالة_الطفل[3] مثل عدد) << 24);
                // exec failed: child has called _exit. A zero/out-of-range
                // record signals a broken child protocol, not kernel errno.
                دع الانتظار: نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس =
                    انتظر_طفلا_لينكس(المعرف مثل عدد);
                لو (الرمز <= 0 || الرمز > 4095) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(
                    أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الرمز)
                ));
            };
        };
    };
}
