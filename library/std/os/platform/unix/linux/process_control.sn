استورد os.platform.unix.linux.file_descriptors;
// Linux's exit_group terminates the whole thread group; exit terminates
// only the invoking thread. Process arguments/environment are startup data,
// not syscalls. A safe spawn must not be faked using clone alone.
عام عرف اخرج_من_مجموعة_عملية_لينكس(رقم_الخروج_الجماعي: ط64, الحالة: ط64): فراغ {
    دع الناتج: ط64;
    غير_آمن { الناتج := بدائي_نداء_نواة_خام(
        رقم_الخروج_الجماعي, الحالة, 0 مثل ط64, 0 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
}

استورد os.path;
استورد os.error;
استورد os.platform.unix.process_startup;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
استورد os.platform.unix.linux.kernel_records;

// waitid(P_PID, pid, siginfo, WEXITED, NULL) consumes an exited child once.
// The caller must own a child PID obtained from an actual spawn operation.
// Linux kernel siginfo_t is 128 bytes on both supported 64-bit ABIs.
// Header fields are 32-bit; SIGCHLD si_pid and si_status are at offsets 16/24.
عام نوع حالة_طفل_لينكس =
    | خرج بنوع عدد
    | إشارة بنوع عدد
;

عام نوع خطأ_انتظار_لينكس =
    | معرف_غير_صالح
    | استجابة_غير_صالحة
    | نظام بنوع خطأ_نظام_أصلي
;

لو (الهدف.المنصة == «linux» || الهدف.المنصة == «android») {
    عرف انتظر_طفلا_بخيارات_لينكس(
        معرف_الطفل: عدد, بلا_حجب: منطقي
    ): نتيجة اختياري حالة_طفل_لينكس, خطأ_انتظار_لينكس {
        لو (معرف_الطفل <= 0 || معرف_الطفل > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.معرف_غير_صالح());
        };
        // 32 * u32 = 128 bytes, with 8-byte alignment guaranteed by u64 storage.
        دع المعلومات: متغير متجه ط64 = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < 16) {
            ألحق(المعلومات, 0 مثل ط64);
            الموضع := الموضع + 1;
        }
        // P_PID=1, WEXITED=4, WNOHANG=1; fifth syscall argument is the optional
        // rusage. With WNOHANG a live child leaves the record zeroed (si_pid 0).
        دع الخيارات: متغير ط64 = 4;
        لو (بلا_حجب) { الخيارات := 5; };
        دع الخام: متغير ط64 = 0;
        دع اكتمل: متغير منطقي = خطأ;
        طالما (!اكتمل) {
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظار_عملية()),
                1 مثل ط64, معرف_الطفل مثل ط64, &متغير المعلومات[0],
                الخيارات, 0 مثل ط64, 0 مثل ط64
            ); }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> {
                لو (الخطأ.الرمز != 4) { اكتمل := صواب; } // EINTR
            }
            | نتيجة.نجح(_) -> { اكتمل := صواب; };
        }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
        | نتيجة.نجح(_) -> {
            // siginfo: si_signo at byte 0, si_code at 8 (4 on MIPS), then the
            // union at the word-aligned offset (16, or 12 on 32-bit ABIs) with
            // si_pid first and si_status 8 bytes later, in the kernel's byte
            // order (uapi.sn).
            دع الحمولة: طبيعي = إزاحة_حمولة_معلومات_إشارة_لينكس();
            دع الإشارة: ط32 = ط32_من_كلمات_لينكس(&المعلومات, 0);
            دع الرمز: ط32 = ط32_من_كلمات_لينكس(&المعلومات, إزاحة_رمز_معلومات_إشارة_لينكس());
            دع المعرف: ط32 = ط32_من_كلمات_لينكس(&المعلومات, الحمولة);
            دع الحالة: ط32 = ط32_من_كلمات_لينكس(&المعلومات, الحمولة + 8);
            لو (بلا_حجب && المعرف == 0) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
            لو ((الإشارة مثل ط64) != إشارة_انتهاء_طفل_لينكس() || المعرف != (معرف_الطفل مثل ط32)) {
                أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
            };
            لو (الرمز == 1 && الحالة <= 255) {
                أرجع نتيجة.نجح(اختياري.موجود(حالة_طفل_لينكس.خرج(الحالة مثل عدد)));
            };
            لو ((الرمز == 2 || الرمز == 3) && الحالة >= 1 && الحالة <= 64) {
                أرجع نتيجة.نجح(اختياري.موجود(حالة_طفل_لينكس.إشارة(الحالة مثل عدد)));
            };
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
        };
    }
}

// FreeBSD: wait4(pid, &status, WNOHANG or 0, NULL) reports a wait(2) status
// word, not siginfo (sys/sys/wait.h): the low 7 bits are 0 for an exit (code
// in bits 8..15), the terminating signal otherwise; 0177 (_WSTOPPED) and
// 0x13 (_WCONTINUED) only arrive with WUNTRACED / WCONTINUED, which std never
// passes. With WNOHANG a live child makes wait4 return 0.
لو (الهدف.المنصة == «freebsd») {
    عرف انتظر_طفلا_بخيارات_لينكس(
        معرف_الطفل: عدد, بلا_حجب: منطقي
    ): نتيجة اختياري حالة_طفل_لينكس, خطأ_انتظار_لينكس {
        لو (معرف_الطفل <= 0 || معرف_الطفل > 2147483647) {
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.معرف_غير_صالح());
        };
        دع الخيارات: متغير ط64 = 0;
        لو (بلا_حجب) { الخيارات := انتظار_بلا_حجب_فري_بي_إس_دي(); };
        دع الحالة: متغير متجه ط32 = [0];
        دع الخام: متغير ط64 = 0;
        دع اكتمل: متغير منطقي = خطأ;
        طالما (!اكتمل) {
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظار_عملية()),
                معرف_الطفل مثل ط64, &متغير الحالة[0], الخيارات,
                0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الخطأ) -> {
                لو (الخطأ.الرمز != 4) { اكتمل := صواب; } // EINTR
            }
            | نتيجة.نجح(_) -> { اكتمل := صواب; };
        }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
        | نتيجة.نجح(المعرف) -> {
            لو (بلا_حجب && المعرف == 0) { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
            لو (المعرف != (معرف_الطفل مثل طبيعي)) {
                أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
            };
            دع الكلمة: ط64 = الحالة[0] مثل ط64;
            دع الأدنى: ط64 = الكلمة & حالة_انتظار_متوقف_فري_بي_إس_دي();
            لو (الأدنى == 0) {
                أرجع نتيجة.نجح(اختياري.موجود(حالة_طفل_لينكس.خرج(((الكلمة >> 8) & 255) مثل عدد)));
            };
            لو (الأدنى != حالة_انتظار_متوقف_فري_بي_إس_دي() && الكلمة != 0x13) {
                أرجع نتيجة.نجح(اختياري.موجود(حالة_طفل_لينكس.إشارة(الأدنى مثل عدد)));
            };
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
        };
    }
}

عام عرف انتظر_طفلا_لينكس(معرف_الطفل: عدد): نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس {
    طابق انتظر_طفلا_بخيارات_لينكس(معرف_الطفل, خطأ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النتيجة) -> {
        طابق النتيجة مع
        | اختياري.موجود(الحالة) -> { أرجع نتيجة.نجح(الحالة); }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة()); };
    };
}

// waitid(..., WEXITED | WNOHANG): None while the child runs; Some reaps it.
عام عرف تفقد_طفلا_لينكس(معرف_الطفل: عدد): نتيجة اختياري حالة_طفل_لينكس, خطأ_انتظار_لينكس {
    أرجع انتظر_طفلا_بخيارات_لينكس(معرف_الطفل, صواب);
}

// Some: the child had already exited and is now reaped (no signal is sent,
// so a recycled PID is never signalled). None: the signal was sent and the
// caller still owns the child. SIGTERM 15 and SIGKILL 9 on every Linux ABI
// and on FreeBSD; the WNOHANG check is kernel-specific (above).
عام عرف أرسل_إشارة_طفل_لينكس(
    معرف_الطفل: عدد, الإشارة: عدد
): نتيجة اختياري حالة_طفل_لينكس, خطأ_انتظار_لينكس {
    طابق تفقد_طفلا_لينكس(معرف_الطفل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النتيجة) -> {
        طابق النتيجة مع
        | اختياري.موجود(الحالة) -> { أرجع نتيجة.نجح(اختياري.موجود(الحالة)); }
        | اختياري.لا_شيء -> { };
    };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أرسل_إشارة_عملية()),
        معرف_الطفل مثل ط64, الإشارة مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(اختياري.لا_شيء()); };
}

// pipe2(O_CLOEXEC) creates a kernel-owned error-reporting channel without
// exposing descriptors across a successful execve. The parent keeps the
// read end; the future child owns the write end. This is one component of
// safe spawning, not itself a spawn or a child-execution ABI.
عام نوع قناة_فشل_طفل_لينكس = {
    القارئ: واصف_ملف_لينكس,
    الكاتب: واصف_ملف_لينكس
};

عام عرف أنشئ_قناة_فشل_طفل_لينكس(): نتيجة قناة_فشل_طفل_لينكس, خطأ_انتظار_لينكس {
    دع الواصفات: متغير متجه ص32 = [-1, -1];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قناة_عملية()),
        &متغير الواصفات[0], علم_فتح_إغلاق_عند_التنفيذ_لينكس(),
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {
        لو (الواصفات[0] < 0 || الواصفات[1] < 0) {
            أرجع نتيجة.خطأ(خطأ_انتظار_لينكس.استجابة_غير_صالحة());
        };
        دع القارئ: واصف_ملف_لينكس = { القيمة: الواصفات[0] مثل ط64, مفتوح: صواب };
        دع الكاتب: واصف_ملف_لينكس = { القيمة: الواصفات[1] مثل ط64, مفتوح: صواب };
        دع القناة: قناة_فشل_طفل_لينكس = { القارئ: القارئ, الكاتب: الكاتب };
        أرجع نتيجة.نجح(القناة);
    };
}

// Both ends remain owned until explicitly closed. Preserve the first error
// while still attempting the other close to prevent descriptor leaks.
عام عرف أغلق_قناة_فشل_طفل_لينكس(
    القناة: &متغير قناة_فشل_طفل_لينكس
): نتيجة ط64, خطأ_واصف_لينكس {
    دع خطأ_الأول: متغير اختياري خطأ_واصف_لينكس = اختياري.لا_شيء();
    لو ((*القناة).القارئ.مفتوح) {
        طابق أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            &متغير (*القناة).القارئ
        ) مع
        | نتيجة.خطأ(الخطأ) -> { خطأ_الأول := اختياري.موجود(الخطأ); }
        | نتيجة.نجح(_) -> {};
    };
    لو ((*القناة).الكاتب.مفتوح) {
        طابق أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            &متغير (*القناة).الكاتب
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق خطأ_الأول مع
            | اختياري.لا_شيء -> { خطأ_الأول := اختياري.موجود(الخطأ); }
            | اختياري.موجود(_) -> {};
        }
        | نتيجة.نجح(_) -> {};
    };
    طابق خطأ_الأول مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(0); };
}

// If IPC fails after clone, the parent cannot return a PID it does not own.
// Kill that exact child and reap it to prevent a zombie. Errors in this
// cleanup must not hide the first communication failure.
عرف ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف: عدد): فراغ {
    دع القتل: ط64;
    غير_آمن { القتل := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أرسل_إشارة_عملية()),
        المعرف مثل ط64, 9 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    دع الانتظار: نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس = انتظر_طفلا_لينكس(المعرف);
}

// The child image always receives an explicit environment vector owned by the
// caller. std.os.process supplies either caller-provided entries or an owned
// copy of the process startup environment (os.platform.unix.process_startup);
// no /proc snapshot, libc environ or invented global is used here.
// All storage and argv/envp pointer arrays are completed BEFORE clone. The
// child runs only raw kernel calls until execve or _exit; it never allocates,
// resizes a SultanC vector, locks a runtime mutex, or returns to a caller.
عام نوع خطأ_تشغيل_طفل_لينكس =
    | مدخل_غير_صالح
    | فشل_بروتوكول_الطفل
    | واصف بنوع خطأ_واصف_لينكس
    | نظام بنوع خطأ_نظام_أصلي
;

// Linux MAX_ARG_STRLEN is 32 pages, but page size may differ. This modest
// source-level bound also protects against oversized temporary allocations;
// the kernel remains authoritative and can return E2BIG.
عرف جهز_عنصر_تنفيذ_لينكس(
    البايتات: &متجه ط8
): نتيجة متجه ط8, خطأ_تشغيل_طفل_لينكس {
    لو ((الطول(*البايتات) مثل طبيعي) > 65535) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    طابق بايتات_مسار_يونكس_صفرية(البايتات) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح()); }
    | نتيجة.نجح(المنتهي) -> { أرجع نتيجة.نجح(المنتهي); };
}

عرف تحقق_متغير_تنفيذ_لينكس(المدخل: &متجه ط8): منطقي {
    لو (الطول(*المدخل) == 0) { أرجع خطأ; };
    دع الفهرس: متغير طبيعي = 0;
    دع فاصلة: متغير منطقي = خطأ;
    طالما (الفهرس < (الطول(*المدخل) مثل طبيعي)) {
        دع البايت: ط8 = (*المدخل)[الفهرس];
        لو (البايت == 0) { أرجع خطأ; };
        لو (البايت == 61 && !فاصلة) {
            لو (الفهرس == 0) { أرجع خطأ; };
            فاصلة := صواب;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع فاصلة;
}

// execvp/posix_spawnp program lookup. A program spelling containing '/' is
// used as given. A bare name is searched in the PARENT's startup PATH, in
// order; an empty PATH element names the current directory (POSIX XBD 8.3).
// A missing PATH is reported as ENOENT: no platform default search list is
// invented here. Every candidate is a completed NUL-terminated buffer built
// before clone, so the child only issues execve attempts.
عرف مرشحو_تنفيذ_لينكس(
    البرنامج: &متجه ط8
): نتيجة متجه متجه ط8, خطأ_تشغيل_طفل_لينكس {
    دع المرشحون: متغير متجه متجه ط8 = [];
    دع فيه_فاصل: متغير منطقي = خطأ;
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < (الطول(*البرنامج) مثل طبيعي)) {
        لو ((*البرنامج)[الفهرس] == 0x2F) { فيه_فاصل := صواب; };
        الفهرس := الفهرس + 1;
    }
    لو (فيه_فاصل) {
        طابق جهز_عنصر_تنفيذ_لينكس(البرنامج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجهز) -> { ألحق(المرشحون, المجهز); };
        أرجع نتيجة.نجح(المرشحون);
    };
    دع اسم_المسار: نص = «PATH»;
    دع قيمة_المسار: متغير متجه ط8 = [];
    طابق ابحث_قيمة_بيئة_إقلاع_يونكس(&اسم_المسار) مع
    | نتيجة_بحث_بيئة_إقلاع_يونكس.موجود(القيمة) -> { قيمة_المسار := القيمة; }
    | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_موجود -> {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(
            أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), 2)
        ));
    }
    | نتيجة_بحث_بيئة_إقلاع_يونكس.غير_صالح -> {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    دع طول_المسار: طبيعي = الطول(قيمة_المسار) مثل طبيعي;
    دع البداية: متغير طبيعي = 0;
    الفهرس := 0;
    طالما (الفهرس <= طول_المسار) {
        دع نهاية_عنصر: متغير منطقي = الفهرس == طول_المسار;
        لو (!نهاية_عنصر) { نهاية_عنصر := قيمة_المسار[الفهرس] == 0x3A; };
        لو (نهاية_عنصر) {
            لو ((الطول(المرشحون) مثل طبيعي) >= 256) {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
            };
            دع المرشح: متغير متجه ط8 = [];
            دع ح: متغير طبيعي = البداية;
            طالما (ح < الفهرس) { ألحق(المرشح, قيمة_المسار[ح]); ح := ح + 1; }
            لو (الفهرس > البداية) { ألحق(المرشح, 0x2F); };
            ح := 0;
            طالما (ح < (الطول(*البرنامج) مثل طبيعي)) {
                ألحق(المرشح, (*البرنامج)[ح]);
                ح := ح + 1;
            }
            طابق جهز_عنصر_تنفيذ_لينكس(&المرشح) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> { ألحق(المرشحون, المجهز); };
            البداية := الفهرس + 1;
        };
        الفهرس := الفهرس + 1;
    }
    أرجع نتيجة.نجح(المرشحون);
}

// Linux raw clone(SIGCHLD, NULL, NULL, NULL, NULL) duplicates the address
// space copy-on-write without CLONE_VM/CLONE_FILES/CLONE_THREAD. All five
// clone arguments after flags are zero: this is valid for both x86_64 and
// AArch64 despite their different fourth/fifth argument ordering.
// Pipe EOF after closing the parent's writer means execve closed the child's
// O_CLOEXEC writer. Four bytes instead mean child execve failed with errno.
عام عرف شغل_طفلا_لينكس_ببيئة(
    البرنامج: &متجه ط8, الوسائط: &متجه متجه ط8,
    البيئة: &متجه متجه ط8, بيئة_موروثة: منطقي
): نتيجة عدد, خطأ_تشغيل_طفل_لينكس {
    دع موروثة: متجه ص64 = [-1, -1, -1];
    دع بلا_دليل: متجه ط8 = [];
    أرجع شغل_طفلا_لينكس_بإعداد(البرنامج, الوسائط, البيئة, بيئة_موروثة, &موروثة, &بلا_دليل);
}

// The same with the child's standard streams and working directory:
// القياسية holds three descriptors for the child's 0, 1 and 2 (-1 keeps the
// parent's), each already >= 3 (ارفع_واصف_خاص_لينكس_فوق_القياسية), so no
// dup3 target is another one's source; الدليل is the directory to chdir to
// (empty: unchanged). In the child, dup3(fd, n, 0) installs each stream
// without close-on-exec, then chdir runs; either failure is reported to the
// parent as an errno like a failed execve. close_range then closes every
// other descriptor, the sources included.
عام عرف شغل_طفلا_لينكس_بإعداد(
    البرنامج: &متجه ط8, الوسائط: &متجه متجه ط8,
    البيئة: &متجه متجه ط8, بيئة_موروثة: منطقي,
    القياسية: &متجه ص64, الدليل: &متجه ط8
): نتيجة عدد, خطأ_تشغيل_طفل_لينكس {
    لو ((الطول(*القياسية) مثل طبيعي) != 3) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    دع ف_قياسي_فحص: متغير طبيعي = 0;
    طالما (ف_قياسي_فحص < 3) {
        دع المصدر_المفحوص: ص64 = (*القياسية)[ف_قياسي_فحص];
        لو (المصدر_المفحوص != -1 && (المصدر_المفحوص < 3 || المصدر_المفحوص > 2147483647)) {
            أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
        };
        ف_قياسي_فحص := ف_قياسي_فحص + 1;
    }
    دع الدليل_الصفري: متغير متجه ط8 = [];
    دع له_دليل: منطقي = الطول(*الدليل) > 0;
    لو (له_دليل) {
        طابق جهز_عنصر_تنفيذ_لينكس(الدليل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(المجهز) -> { الدليل_الصفري := المجهز; };
    } وإلا {
        ألحق(الدليل_الصفري, 0 مثل ط8);
    };
    دع مصادر_قياسية: متغير متجه ص64 = [];
    ف_قياسي_فحص := 0;
    طالما (ف_قياسي_فحص < 3) { ألحق(مصادر_قياسية, (*القياسية)[ف_قياسي_فحص]); ف_قياسي_فحص := ف_قياسي_فحص + 1; }
    لو (الطول(*البرنامج) == 0
        || (الطول(*الوسائط) مثل طبيعي) > 4096
        || (الطول(*البيئة) مثل طبيعي) > 4096) {
        أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
    };
    طابق مرشحو_تنفيذ_لينكس(البرنامج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المرشحون_المجهزون) -> {
        دع المرشحون: متغير متجه متجه ط8 = المرشحون_المجهزون;
        دع عدد_المرشحين: طبيعي = الطول(المرشحون) مثل طبيعي;
        دع وسائط_مجهزة: متغير متجه متجه ط8 = [];
        دع بيئة_مجهزة: متغير متجه متجه ط8 = [];
        // argv[0] is the executable path; subsequent arguments keep their
        // original byte contents including intentionally empty arguments.
        طابق جهز_عنصر_تنفيذ_لينكس(البرنامج) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الأول) -> { ألحق(وسائط_مجهزة, الأول); };
        دع الإجمالي: متغير طبيعي = الطول(وسائط_مجهزة[0]) مثل طبيعي;
        دع الفهرس: متغير طبيعي = 0;
        طالما (الفهرس < (الطول(*الوسائط) مثل طبيعي)) {
            طابق جهز_عنصر_تنفيذ_لينكس(&(*الوسائط)[الفهرس]) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> {
                دع السعة: طبيعي = الطول(المجهز) مثل طبيعي;
                لو (السعة > 1048576 - الإجمالي) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
                };
                الإجمالي := الإجمالي + السعة;
                ألحق(وسائط_مجهزة, المجهز);
            };
            الفهرس := الفهرس + 1;
        }
        الفهرس := 0;
        طالما (الفهرس < (الطول(*البيئة) مثل طبيعي)) {
            لو (!بيئة_موروثة && !تحقق_متغير_تنفيذ_لينكس(&(*البيئة)[الفهرس])) {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
            };
            طابق جهز_عنصر_تنفيذ_لينكس(&(*البيئة)[الفهرس]) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(المجهز) -> {
                دع السعة: طبيعي = الطول(المجهز) مثل طبيعي;
                لو (السعة > 1048576 - الإجمالي) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.مدخل_غير_صالح());
                };
                الإجمالي := الإجمالي + السعة;
                ألحق(بيئة_مجهزة, المجهز);
            };
            الفهرس := الفهرس + 1;
        }
        // Do not append any string after creating an address to its data.
        دع مؤشرات_الوسائط: متغير متجه *ط8 = [];
        الفهرس := 0;
        طالما (الفهرس < (الطول(وسائط_مجهزة) مثل طبيعي)) {
            ألحق(مؤشرات_الوسائط, &وسائط_مجهزة[الفهرس][0]);
            الفهرس := الفهرس + 1;
        }
        ألحق(مؤشرات_الوسائط, الفارغ);
        دع مؤشرات_البيئة: متغير متجه *ط8 = [];
        الفهرس := 0;
        طالما (الفهرس < (الطول(بيئة_مجهزة) مثل طبيعي)) {
            ألحق(مؤشرات_البيئة, &بيئة_مجهزة[الفهرس][0]);
            الفهرس := الفهرس + 1;
        }
        ألحق(مؤشرات_البيئة, الفارغ);
        // Allocate the error record before cloning. Child code does not
        // change its size or allocate through the SultanC runtime.
        دع رسالة_الطفل: متغير متجه ط8 = [0, 0, 0, 0];
        طابق أنشئ_قناة_فشل_طفل_لينكس() مع
        | نتيجة.خطأ(الخطأ) -> {
            طابق الخطأ مع
            | خطأ_انتظار_لينكس.نظام(الأصلي) -> {
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
            }
            | _ -> { أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل()); };
        }
        | نتيجة.نجح(القناة_الجديدة) -> {
            دع القناة: متغير قناة_فشل_طفل_لينكس = القناة_الجديدة;
            // pipe2 chooses the lowest unused descriptors. If stdio was
            // closed, either pipe end may be 0, 1 or 2; move it above the
            // standard range BEFORE clone, preserving the stdio state for
            // execve and the owned close-on-exec error channel.
            دع نداء_تحكم: ط64 = رقم_نداء_نواة_لينكس(
                عملية_نداء_نواة_لينكس.تحكم_واصف()
            );
            دع نداء_إغلاق: ط64 = رقم_نداء_نواة_لينكس(
                عملية_نداء_نواة_لينكس.إغلاق()
            );
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(
                نداء_تحكم, نداء_إغلاق, &متغير القناة.القارئ
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة ط64, خطأ_واصف_لينكس =
                    أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            طابق ارفع_واصف_خاص_لينكس_فوق_القياسية(
                نداء_تحكم, نداء_إغلاق, &متغير القناة.الكاتب
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع التنظيف: نتيجة ط64, خطأ_واصف_لينكس =
                    أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
            }
            | نتيجة.نجح(_) -> {};
            // Resolve syscall identities in the parent, not the child.
            دع نداء_نسخ: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نسخ_عملية());
            دع نداء_تشغيل: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تشغيل_برنامج());
            دع نداء_قراءة: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة());
            دع نداء_كتابة: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة());
            دع نداء_خروج: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.خروج());
            دع نداء_إغلاق_مجال: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أغلق_مجال_واصفات());
            دع نداء_مضاعفة: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.مضاعفة_واصف());
            دع نداء_دليل: ط64 = رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تغيير_دليل_العمل());
            // fork-like clone: exit signal SIGCHLD, no new stack. s390 takes
            // (stack, flags), every other Linux ABI (flags, stack). FreeBSD
            // issues fork(2) here, which takes no arguments; its child also
            // gets 0 in the result register (sys/<arch>/<arch>/vm_machdep.c
            // cpu_fork), so the test below is the same.
            دع وسيط_النسخ_الأول: متغير ط64 = إشارة_انتهاء_طفل_لينكس();
            دع وسيط_النسخ_الثاني: متغير ط64 = 0;
            لو (!نسخ_عملية_بالأعلام_أولا_لينكس()) {
                وسيط_النسخ_الأول := 0;
                وسيط_النسخ_الثاني := إشارة_انتهاء_طفل_لينكس();
            };
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                نداء_نسخ, وسيط_النسخ_الأول, وسيط_النسخ_الثاني, 0 مثل ط64,
                0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            لو (الخام == 0) {
                // Child: never close the parent's writer or run finalizers.
                // Only close the reader. Linux close+EINTR still consumes fd.
                دع إغلاق_القارئ: ط64;
                غير_آمن { إغلاق_القارئ := بدائي_نداء_نواة_خام(
                    نداء_إغلاق, القناة.القارئ.القيمة, 0 مثل ط64, 0 مثل ط64,
                    0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                ); }
