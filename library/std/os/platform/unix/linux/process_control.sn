                // the O_CLOEXEC error writer. close_range is an explicit
                // Linux >=5.9 dependency: ENOSYS is reported to the parent,
                // never silently replaced by leaking inherited handles.
                دع نتيجة_التنفيذ: متغير ط64 = 0;
                دع الكاتب: ط64 = القناة.الكاتب.القيمة;
                دع ف_قياسي: متغير طبيعي = 0;
                طالما (نتيجة_التنفيذ == 0 && ف_قياسي < 3) {
                    لو (مصادر_قياسية[ف_قياسي] >= 0) {
                        دع المضاعف: ط64;
                        غير_آمن { المضاعف := بدائي_نداء_نواة_خام(
                            نداء_مضاعفة, مصادر_قياسية[ف_قياسي] مثل ط64, ف_قياسي مثل ط64,
                            0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                        ); }
                        لو (المضاعف >= ((~(0 مثل ط64)) - 4094)) { نتيجة_التنفيذ := المضاعف; };
                    };
                    ف_قياسي := ف_قياسي + 1;
                }
                لو (نتيجة_التنفيذ == 0 && له_دليل) {
                    غير_آمن { نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                        نداء_دليل, &متغير الدليل_الصفري[0], 0 مثل ط64, 0 مثل ط64,
                        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                    ); }
                };
                لو (نتيجة_التنفيذ == 0 && الكاتب > 3) {
                    غير_آمن { نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                        نداء_إغلاق_مجال, 3 مثل ط64, الكاتب - 1,
                        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                    ); }
                };
                لو (نتيجة_التنفيذ == 0) {
                    دع البداية_الثانية: متغير ط64 = 3;
                    لو (الكاتب >= 3) { البداية_الثانية := الكاتب + 1; };
                    غير_آمن { نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                        نداء_إغلاق_مجال, البداية_الثانية, 4294967295 مثل ط64,
                        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                    ); }
                };
                لو (نتيجة_التنفيذ == 0) {
                    // argv/envp are arrays of raw pointers; a reference to a
                    // pointer is not a raw-call scalar, so form the raw
                    // pointer to each array through the canonical
                    // reference-to-pointer conversion.
                    دع مصفوفة_الوسائط: **ط8 = &مؤشرات_الوسائط[0];
                    دع مصفوفة_البيئة: **ط8 = &مؤشرات_البيئة[0];
                    // execvp order: ENOENT/ENOTDIR try the next candidate;
                    // EACCES is remembered and reported if nothing else
                    // runs; any other result (including success) stops.
                    دع خطأ_الوصول: متغير منطقي = خطأ;
                    دع مستمر: متغير منطقي = صواب;
                    دع المرشح: متغير طبيعي = 0;
                    طالما (مستمر && المرشح < عدد_المرشحين) {
                        غير_آمن { نتيجة_التنفيذ := بدائي_نداء_نواة_خام(
                            نداء_تشغيل, &المرشحون[المرشح][0], مصفوفة_الوسائط,
                            مصفوفة_البيئة, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                        ); }
                        لو (نتيجة_التنفيذ == (~(0 مثل ط64)) - 1
                            || نتيجة_التنفيذ == (~(0 مثل ط64)) - 19) {
                        } وإلا لو (نتيجة_التنفيذ == (~(0 مثل ط64)) - 12) {
                            خطأ_الوصول := صواب;
                        } وإلا {
                            مستمر := خطأ;
                        };
                        المرشح := المرشح + 1;
                    }
                    لو (مستمر && خطأ_الوصول) {
                        نتيجة_التنفيذ := (~(0 مثل ط64)) - 12;
                    };
                };
                // execve has no successful return. Report raw kernel errno,
                // never call error translators or heap functions in child.
                // Raw syscall failures occupy [-4095, -1]. Zero is a
                // protocol-invalid record, never a native errno.
                دع الرمز: متغير ط32 = 0;
                لو (نتيجة_التنفيذ >= ((~(0 مثل ط64)) - 4094)) {
                    الرمز := ((~نتيجة_التنفيذ) + 1) مثل ط32;
                };
                رسالة_الطفل[0] := (الرمز & 255) مثل ط8;
                رسالة_الطفل[1] := ((الرمز >> 8) & 255) مثل ط8;
                رسالة_الطفل[2] := ((الرمز >> 16) & 255) مثل ط8;
                رسالة_الطفل[3] := ((الرمز >> 24) & 255) مثل ط8;
                دع الموضع: متغير ط64 = 0;
                طالما (الموضع < 4) {
                    دع المكتوب: ط64;
                    غير_آمن { المكتوب := بدائي_نداء_نواة_خام(
                        نداء_كتابة, القناة.الكاتب.القيمة,
                        &متغير رسالة_الطفل[الموضع مثل طبيعي], 4 - الموضع,
                        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                    ); }
                    لو (المكتوب == ((~(0 مثل ط64)) - 3)) { } // -EINTR
                    وإلا لو (المكتوب > 4 - الموضع || المكتوب == 0) { الموضع := 4; }
                    وإلا { الموضع := الموضع + المكتوب; };
                }
                دع الخروج: ط64;
                غير_آمن { الخروج := بدائي_نداء_نواة_خام(
                    نداء_خروج, 127 مثل ط64, 0 مثل ط64, 0 مثل ط64,
                    0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                ); }
                // The kernel never returns from exit. No parent-only
                // SultanC resource cleanup is permitted here.
                طالما (صواب) { }
            }
            طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
            | نتيجة.خطأ(الأصلي) -> {
                دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
            }
            | نتيجة.نجح(المعرف) -> {
                لو (المعرف == 0 || المعرف > 2147483647) {
                    دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_قناة_فشل_طفل_لينكس(&متغير القناة);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                // Parent must close the write end before reading. EOF then
                // distinguishes exec success from an errno record.
                دع غلق_الكاتب: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                    نداء_إغلاق, &متغير القناة.الكاتب
                );
                // A failed close must not be ignored before waiting for EOF:
                // on Linux even EINTR consumes the descriptor, and returning
                // an unowned PID after a channel error would leak a child.
                طابق غلق_الكاتب مع
                | نتيجة.خطأ(الخطأ) -> {
                    دع غلق_القارئ: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                        نداء_إغلاق, &متغير القناة.القارئ
                    );
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
                }
                | نتيجة.نجح(_) -> {};
                دع المقروء: متغير ط64 = 0;
                دع فشل_القراءة: متغير اختياري خطأ_تشغيل_طفل_لينكس = اختياري.لا_شيء();
                دع نهاية: متغير منطقي = خطأ;
                طالما (!نهاية && المقروء < 4) {
                    دع القراءة_الخام: ط64;
                    غير_آمن { القراءة_الخام := بدائي_نداء_نواة_خام(
                        نداء_قراءة, القناة.القارئ.القيمة,
                        &متغير رسالة_الطفل[المقروء مثل طبيعي], 4 - المقروء,
                        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
                    ); }
                    طابق حلل_نتيجة_نداء_نواة_لينكس(القراءة_الخام) مع
                    | نتيجة.خطأ(الأصلي) -> {
                        لو (الأصلي.الرمز != 4) {
                            فشل_القراءة := اختياري.موجود(خطأ_تشغيل_طفل_لينكس.نظام(الأصلي));
                            نهاية := صواب;
                        };
                    }
                    | نتيجة.نجح(حجم_القراءة) -> {
                        // The kernel word is طبيعي; the progress counter is ط64.
                        دع الحجم: ط64 = حجم_القراءة مثل ط64;
                        لو (الحجم == 0) { نهاية := صواب; }
                        وإلا لو (الحجم > 4 - المقروء) {
                            فشل_القراءة := اختياري.موجود(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                            نهاية := صواب;
                        }
                        وإلا { المقروء := المقروء + الحجم; };
                    };
                }
                دع غلق_القارئ: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                    نداء_إغلاق, &متغير القناة.القارئ
                );
                طابق فشل_القراءة مع
                | اختياري.موجود(الخطأ) -> {
                    // Abort and reap a child whose status cannot be safely
                    // transferred; do not lose its PID or misreport exec.
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | اختياري.لا_شيء -> {};
                طابق غلق_القارئ مع
                | نتيجة.خطأ(الخطأ) -> {
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.واصف(الخطأ));
                }
                | نتيجة.نجح(_) -> {};
                لو (المقروء == 0) {
                    أرجع نتيجة.نجح(المعرف مثل عدد);
                };
                لو (المقروء != 4) {
                    ألغ_طفلا_فشل_إبلاغه_لينكس(المعرف مثل عدد);
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                دع الرمز: عدد = (رسالة_الطفل[0] مثل عدد)
                    | ((رسالة_الطفل[1] مثل عدد) << 8)
                    | ((رسالة_الطفل[2] مثل عدد) << 16)
                    | ((رسالة_الطفل[3] مثل عدد) << 24);
                // exec failed: child has called _exit. A zero/out-of-range
                // record signals a broken child protocol, not kernel errno.
                دع الانتظار: نتيجة حالة_طفل_لينكس, خطأ_انتظار_لينكس =
                    انتظر_طفلا_لينكس(المعرف مثل عدد);
                لو (الرمز <= 0 || الرمز > 4095) {
                    أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.فشل_بروتوكول_الطفل());
                };
                أرجع نتيجة.خطأ(خطأ_تشغيل_طفل_لينكس.نظام(
                    أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), الرمز)
                ));
            };
        };
    };
}
