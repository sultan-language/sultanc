استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Kernel clock_gettime and nanosleep ABI (Linux; FreeBSD takes the same
// arguments). timespec64 is two signed 64-bit fields on every ABI: the
// 32-bit Linux ones use clock_gettime64 and clock_nanosleep_time64
// (selected in the syscall tables), which take it.
عام نوع زمن_نواة_لينكس = { الثواني: ص64, النانو: ص64 };
عام نوع خطأ_ساعة_لينكس =
    | مدة_غير_صالحة
    | نظام بنوع خطأ_نظام_أصلي
;

عام عرف اقرأ_ساعة_لينكس(
    رقم_ساعة_نظام: ط64, رتيب: منطقي
): نتيجة زمن_نواة_لينكس, خطأ_ساعة_لينكس {
    دع الساعة: متغير ط64 = 0; // CLOCK_REALTIME
    إذا (رتيب) { الساعة := ساعة_رتيبة_لينكس(); }; // CLOCK_MONOTONIC: 1 on Linux, 4 on FreeBSD
    دع البيانات: متغير متجه ص64 = [0, 0];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ساعة_نظام()), الساعة, &متغير البيانات[0],
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {
        إذا (البيانات[1] < 0 || البيانات[1] >= 1000000000) {
            أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.مدة_غير_صالحة());
        };
        دع الزمن: زمن_نواة_لينكس = { الثواني: البيانات[0], النانو: البيانات[1] };
        أرجع نتيجة.نجح(الزمن);
    };
}

عام عرف نم_نانو_لينكس(
    رقم_نوم_نانو: ط64, الثواني: ص64, النانو: ص64
): نتيجة ط64, خطأ_ساعة_لينكس {
    إذا (الثواني < 0 || النانو < 0 || النانو >= 1000000000) {
        أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.مدة_غير_صالحة());
    };
    دع المطلوب: متغير متجه ص64 = [الثواني, النانو];
    دع الباقي: متغير متجه ص64 = [0, 0];
    دع الخام: متغير ط64 = 0;
    إذا (نوم_بالساعة_لينكس()) {
        // clock_nanosleep_time64(CLOCK_MONOTONIC, 0, req, rem): nanosleep's
        // clock, and the only relative sleep that takes timespec64 there.
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نوم_الساعة()), ساعة_رتيبة_لينكس(), 0 مثل ط64,
            &متغير المطلوب[0], &متغير الباقي[0], 0 مثل ط64, 0 مثل ط64
        ); }
    }
    وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نوم_نانو, &متغير المطلوب[0], &متغير الباقي[0],
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
    };
    // EINTR is reported to the caller with its native code; the caller may
    // choose whether to resume using the kernel-populated remaining time.
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}
