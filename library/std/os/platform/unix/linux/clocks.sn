استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;

// Linux kernel clock_gettime and nanosleep ABI on 64-bit x86-64/AArch64.
// timespec64 is two signed 64-bit fields; 32-bit time64 ABIs are separate.
عام نوع زمن_نواة_لينكس = { الثواني: ص64, النانو: ص64 };
عام نوع خطأ_ساعة_لينكس =
    | مدة_غير_صالحة
    | نظام بنوع خطأ_نظام_أصلي
;

عام عرف اقرأ_ساعة_لينكس(
    رقم_ساعة_نظام: غ64, رتيب: منطقي
): نتيجة زمن_نواة_لينكس, خطأ_ساعة_لينكس {
    دع الساعة: متغير غ64 = 0; // CLOCK_REALTIME
    لو (رتيب) { الساعة := 1; }; // CLOCK_MONOTONIC
    دع البيانات: متغير متجه ص64 = [0, 0];
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ساعة_نظام()), الساعة, &متغير البيانات[0],
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(_) -> {
        لو (البيانات[1] < 0 || البيانات[1] >= 1000000000) {
            أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.مدة_غير_صالحة());
        };
        دع الزمن: زمن_نواة_لينكس = { الثواني: البيانات[0], النانو: البيانات[1] };
        أرجع نتيجة.نجح(الزمن);
    };
}

عام عرف نم_نانو_لينكس(
    رقم_نوم_نانو: غ64, الثواني: ص64, النانو: ص64
): نتيجة غ64, خطأ_ساعة_لينكس {
    لو (الثواني < 0 || النانو < 0 || النانو >= 1000000000) {
        أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.مدة_غير_صالحة());
    };
    دع المطلوب: متغير متجه ص64 = [الثواني, النانو];
    دع الباقي: متغير متجه ص64 = [0, 0];
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.نوم_نانو()), &متغير المطلوب[0], &متغير الباقي[0],
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    // EINTR is reported to the caller with its native code; the caller may
    // choose whether to resume using the kernel-populated remaining time.
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_ساعة_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}
