استورد os.platform.unix.linux.file_descriptors;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;

// ELF auxiliary entries are 2 x 64-bit words on the supported ABIs.
// AT_PAGESZ=6, AT_NULL=0. This is kernel process-startup information,
// not a syscall; /proc/self/auxv is an optional procfs view of that data.
عام نوع خطأ_متجه_مساعد_لينكس =
    | بيانات_غير_صالحة
    | مدخل_غير_موجود
    | واصف بنوع خطأ_واصف_لينكس
;

// Decode a bounded little-endian word without unaligned native loads.
عرف اقرأ_كلمة_مساعدة_لينكس(المصدر: &متجه غ8, البداية: غير_موقع): غ64 {
    دع الناتج: متغير غ64 = 0;
    دع البايت: متغير غير_موقع = 0;
    بينما (البايت < 8) {
        الناتج := الناتج | (((*المصدر)[البداية + البايت] مثل غ64) << (8 * البايت));
        البايت := البايت + 1;
    }
    أرجع الناتج;
}

// Parse actual auxiliary-vector records; absence of AT_PAGESZ never produces
// a fabricated default. A truncated vector or one lacking AT_NULL is invalid.
عام عرف قيمة_متجه_مساعد_لينكس(
    المصدر: &متجه غ8, النوع_المطلوب: غ64
): نتيجة غ64, خطأ_متجه_مساعد_لينكس {
    دع الحجم: غير_موقع = الطول(*المصدر) مثل غير_موقع;
    لو ((الحجم % 16) != 0) {
        أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.بيانات_غير_صالحة());
    };
    دع الموضع: متغير غير_موقع = 0;
    دع موجود: متغير منطقي = خطأ;
    دع القيمة: متغير غ64 = 0;
    بينما (الموضع < الحجم) {
        دع النوع: غ64 = اقرأ_كلمة_مساعدة_لينكس(المصدر, الموضع);
        دع البيانات: غ64 = اقرأ_كلمة_مساعدة_لينكس(المصدر, الموضع + 8);
        لو (النوع == 0) {
            لو (موجود) { أرجع نتيجة.نجح(القيمة); };
            أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.مدخل_غير_موجود());
        };
        لو (النوع == النوع_المطلوب) {
            موجود := صواب;
            القيمة := البيانات;
        };
        الموضع := الموضع + 16;
    }
    أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.بيانات_غير_صالحة());
}

عام عرف حجم_صفحة_من_متجه_مساعد_لينكس(
    المصدر: &متجه غ8
): نتيجة غ64, خطأ_متجه_مساعد_لينكس {
    طابق قيمة_متجه_مساعد_لينكس(المصدر, 6 مثل غ64) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الحجم) -> {
        لو (الحجم == 0 || (الحجم & (الحجم - 1)) != 0) {
            أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.بيانات_غير_صالحة());
        };
        أرجع نتيجة.نجح(الحجم);
    };
}

// Optional procfs provider. Absence of procfs is returned as an open error;
// callers with the genuine startup auxv should call the decoder directly.
// Reads are bounded, EOF-aware, and close the owned fd on every path.
عام عرف اقرأ_حجم_صفحة_من_بروك_لينكس(): نتيجة غ64, خطأ_متجه_مساعد_لينكس {
    دع الاسم: نص = «/proc/self/auxv»;
    دع المسار: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول(الاسم) مثل غير_موقع)) {
        ألحق(المسار, الاسم[الموضع]);
        الموضع := الموضع + 1;
    }
    طابق افتح_واصف_لينكس(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()),
        &المسار, 0x80000 مثل غ64, 0 مثل غ64
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.واصف(الخطأ)); }
    | نتيجة.نجح(المفتوح) -> {
        دع الواصف: متغير واصف_ملف_لينكس = المفتوح;
        دع البيانات: متغير متجه غ8 = [];
        دع الدفعة: متغير متجه غ8 = [];
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < 512) {
            ألحق(الدفعة, 0 مثل غ8);
            الفهرس := الفهرس + 1;
        }
        دع انتهى: متغير منطقي = خطأ;
        بينما (!انتهى) {
            طابق اقرأ_واصف_لينكس(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()),
                &الواصف, &متغير الدفعة, 0, 512
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                    رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
                );
                أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.واصف(الخطأ));
            }
            | نتيجة.نجح(العدد) -> {
                لو (العدد == 0) { انتهى := صواب; }
                وإلا {
                    // Refuse unbounded procfs input before appending anything.
                    لو (العدد > 65536 - (الطول(البيانات) مثل غ64)) {
                        دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
                        );
                        أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.بيانات_غير_صالحة());
                    };
                    دع الف: متغير غير_موقع = 0;
                    بينما (الف < (العدد مثل غير_موقع)) {
                        ألحق(البيانات, الدفعة[الف]);
                        الف := الف + 1;
                    }
                };
            };
        }
        طابق أغلق_واصف_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_متجه_مساعد_لينكس.واصف(الخطأ)); }
        | نتيجة.نجح(_) -> { أرجع حجم_صفحة_من_متجه_مساعد_لينكس(&البيانات); };
    };
}
