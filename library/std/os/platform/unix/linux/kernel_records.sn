// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Fields of kernel records (siginfo, statx, ...) read into 64-bit words, in
// the kernel's byte order for the target (uapi.sn ترتيب_بايت_كبير_لينكس).
// البايت is the field's byte offset in the record.

عام عرف ط32_من_كلمات_لينكس(الكلمات: &متجه ط64, البايت: طبيعي): ط32 {
    دع الكلمة: ط64 = (*الكلمات)[البايت / 8];
    دع الإزاحة: ط64 = (البايت % 8) مثل ط64;
    لو (ترتيب_بايت_كبير_لينكس()) {
        أرجع ((الكلمة >> (32 - الإزاحة * 8)) & 0xffffffff) مثل ط32;
    };
    أرجع ((الكلمة >> (الإزاحة * 8)) & 0xffffffff) مثل ط32;
}

عام عرف ط16_من_كلمات_لينكس(الكلمات: &متجه ط64, البايت: طبيعي): ط16 {
    دع الكلمة: ط64 = (*الكلمات)[البايت / 8];
    دع الإزاحة: ط64 = (البايت % 8) مثل ط64;
    لو (ترتيب_بايت_كبير_لينكس()) {
        أرجع ((الكلمة >> (48 - الإزاحة * 8)) & 0xffff) مثل ط16;
    };
    أرجع ((الكلمة >> (الإزاحة * 8)) & 0xffff) مثل ط16;
}

// Old names, kept for one release: the unsigned types are now `طبيعي` and `ط8`..`ط64`.
عام مرادف غ32_من_كلمات_لينكس = ط32_من_كلمات_لينكس;
عام مرادف غ16_من_كلمات_لينكس = ط16_من_كلمات_لينكس;
