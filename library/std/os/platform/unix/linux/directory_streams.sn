استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.buffer;
استورد os.platform.unix.linux.file_descriptors;
استورد os.platform.unix.linux.directory_records;

// Linux directory file descriptors are opened with openat(O_DIRECTORY), not
// libc DIR*. getdents64 returns a block of records (not a single filename).
// The caller must retain unconsumed records and its owned descriptor.
عام نوع خطأ_تيار_دليل_لينكس =
    | واصف بنوع خطأ_واصف_لينكس
    | مدخل بنوع خطأ_مدخل_دليل_لينكس
    | نطاق_غير_صالح
;

عام نوع دفعة_دليل_لينكس = {
    البايتات: متجه غ8,
    الموضع: غير_موقع,
    النهاية: غير_موقع
};

عام عرف افتح_دليل_لينكس(
    رقم_فتح_عند: غ64, المسار: &متجه غ8
): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    // O_RDONLY|O_DIRECTORY|O_CLOEXEC. 0200000 + 02000000 octal.
    أرجع افتح_واصف_لينكس(رقم_فتح_عند, المسار, 0x90000, 0);
}

عام عرف اقرأ_دفعة_دليل_لينكس(
    رقم_قراءة_مداخل_دليل: غ64, الدليل: &واصف_ملف_لينكس,
    السعة: غير_موقع
): نتيجة دفعة_دليل_لينكس, خطأ_تيار_دليل_لينكس {
    لو (!(*الدليل).مفتوح || السعة < 24 || السعة > 0x7ffff000) {
        أرجع نتيجة.خطأ(خطأ_تيار_دليل_لينكس.نطاق_غير_صالح());
    };
    دع المخزن: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < السعة) { ألحق(المخزن, 0 مثل غ8); الفهرس := الفهرس + 1; };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_مداخل_دليل()), (*الدليل).القيمة,
        &متغير المخزن[0], السعة مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق نتيجة_واصف_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_دليل_لينكس.واصف(الخطأ)); }
    | نتيجة.نجح(الحجم) -> {
        لو (الحجم > (السعة مثل غ64)) {
            أرجع نتيجة.خطأ(خطأ_تيار_دليل_لينكس.نطاق_غير_صالح());
        };
        دع الدفعة: دفعة_دليل_لينكس = {
            البايتات: المخزن, الموضع: 0, النهاية: الحجم مثل غير_موقع
        };
        أرجع نتيجة.نجح(الدفعة);
    };
}

عام عرف خذ_مدخل_دفعة_دليل_لينكس(
    الدفعة: &متغير دفعة_دليل_لينكس, صغير_النهاية: منطقي
): نتيجة اختيار مدخل_دليل_نواة_لينكس, خطأ_تيار_دليل_لينكس {
    لو ((*الدفعة).الموضع == (*الدفعة).النهاية) {
        أرجع نتيجة.نجح(اختيار.لا_شيء());
    };
    طابق حلل_مدخل_دليل_نواة_لينكس(
        &(*الدفعة).البايتات, (*الدفعة).الموضع,
        (*الدفعة).النهاية, صغير_النهاية
    ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_دليل_لينكس.مدخل(الخطأ)); }
    | نتيجة.نجح(المدخل) -> {
        (*الدفعة).الموضع := المدخل.موضع_السجل_التالي;
        أرجع نتيجة.نجح(اختيار.بعض(المدخل));
    };
}
