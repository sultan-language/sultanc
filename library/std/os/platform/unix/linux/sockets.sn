استورد os.buffer;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
استورد os.platform.unix.linux.file_descriptors;
استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Linux socket syscalls: returned sockets are file descriptors, NOT Winsock
// SOCKETs. Addr buffers are opaque Linux sockaddr byte sequences. Ownership
// of accepted sockets transfers to the caller; close uses the Linux close
// syscall in file_descriptors.sn. No libc or resolver ABI is involved.
عام نوع خطأ_مقبس_لينكس =
    | مغلق
    | نطاق_غير_صالح
    | نظام بنوع خطأ_نظام_أصلي
;

عام عرف نتيجة_مقبس_لينكس(الخام: ط64): نتيجة ط64, خطأ_مقبس_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

عام عرف أنشئ_مقبس_لينكس(
    رقم_مقبس: ط64, النطاق: ط64, النوع: ط64, البروتوكول: ط64
): نتيجة واصف_ملف_لينكس, خطأ_مقبس_لينكس {
    // Every newly owned socket is close-on-exec, including sockets made
    // before spawning a child. SOCK_CLOEXEC (Linux: O_CLOEXEC; FreeBSD: its
    // own type flag) is set atomically by the kernel. A caller may also
    // request SOCK_NONBLOCK in النوع.
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.مقبس()), النطاق, النوع | علم_مقبس_إغلاق_عند_التنفيذ_لينكس(), البروتوكول,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_مقبس_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع المقبس: واصف_ملف_لينكس = { القيمة: القيمة, مفتوح: صواب };
        أرجع نتيجة.نجح(المقبس);
    };
}

// connect and bind both take (fd, sockaddr*, socklen_t); the supplied syscall
// number selects the operation. Linux sockaddr may contain embedded zeroes.
عام عرف ضع_عنوان_مقبس_لينكس(
    رقم_العملية: ط64, المقبس: &واصف_ملف_لينكس, العنوان: &متجه ط8
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    دع الحجم: طبيعي = الطول(*العنوان) مثل طبيعي;
    لو (الحجم < 2 || الحجم > 0x7fffffff) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_العملية, (*المقبس).القيمة, &(*العنوان)[0], الحجم مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_مقبس_لينكس(الخام);
}

عام عرف استمع_مقبس_لينكس(
    رقم_استماع: ط64, المقبس: &واصف_ملف_لينكس, التراكم: ص32
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    لو (التراكم < 0) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.استماع()), (*المقبس).القيمة, التراكم مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_مقبس_لينكس(الخام);
}

// accept4 accepts a peer address only when both buffer and length pointer
// are supplied. NULL,NULL requests no peer address; flags take SOCK_CLOEXEC.
عام عرف اقبل_مقبس_لينكس(
    رقم_قبول_بأعلام: ط64, المستمع: &واصف_ملف_لينكس, الأعلام: ط64
): نتيجة واصف_ملف_لينكس, خطأ_مقبس_لينكس {
    لو (!(*المستمع).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_قبول_بأعلام, (*المستمع).القيمة,
        0 مثل ط64, 0 مثل ط64, الأعلام | علم_مقبس_إغلاق_عند_التنفيذ_لينكس(),
        0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_مقبس_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> {
        دع المقبس: واصف_ملف_لينكس = { القيمة: القيمة, مفتوح: صواب };
        أرجع نتيجة.نجح(المقبس);
    };
}

// sendto(fd, buf, len, flags, NULL, 0); recvfrom analogous with NULL peer.
// A zero-length stream transfer is a successful zero, while a zero-length
// UDP send must still issue the syscall to transmit an empty datagram.
عام عرف أرسل_مقبس_لينكس(
    رقم_إرسال_إلى: ط64, المقبس: &واصف_ملف_لينكس,
    المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد, الأعلام: ط64
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع المؤقت: متجه ط8 = [0];
    // Preserve the exact typed storage borrow at the raw primitive site.
    // A pointer copied through a temporary machine variable cannot prove its
    // allocation and indexed offset to Frontend/MSIR.
    دع الخام: ط64;
    لو (الطلب > 0) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إرسال_إلى()),
            (*المقبس).القيمة, &(*المحتوى)[الإزاحة مثل طبيعي],
            الطلب مثل ط64, الأعلام | علم_إرسال_بلا_إشارة_لينكس(),
            0 مثل ط64, 0 مثل ط64
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إرسال_إلى()),
            (*المقبس).القيمة, &المؤقت[0],
            0 مثل ط64, الأعلام | علم_إرسال_بلا_إشارة_لينكس(),
            0 مثل ط64, 0 مثل ط64
        ); }
    };
    أرجع نتيجة_مقبس_لينكس(الخام);
}

عام عرف استقبل_مقبس_لينكس(
    رقم_استقبال_من: ط64, المقبس: &واصف_ملف_لينكس,
    المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد, الأعلام: ط64
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع المؤقت: متغير متجه ط8 = [0];
    دع الخام: ط64;
    لو (الطلب > 0) {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.استقبال_من()),
            (*المقبس).القيمة, &متغير (*المخزن)[الإزاحة مثل طبيعي],
            الطلب مثل ط64, الأعلام, 0 مثل ط64, 0 مثل ط64
        ); }
    } وإلا {
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.استقبال_من()),
            (*المقبس).القيمة, &متغير المؤقت[0],
            0 مثل ط64, الأعلام, 0 مثل ط64, 0 مثل ط64
        ); }
    };
    أرجع نتيجة_مقبس_لينكس(الخام);
}

عام عرف أوقف_مقبس_لينكس(
    رقم_إيقاف: ط64, المقبس: &واصف_ملف_لينكس, الاتجاه: ط64
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    لو (الاتجاه > 2) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إيقاف_مقبس()), (*المقبس).القيمة, الاتجاه,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_مقبس_لينكس(الخام);
}

// SOL_SOCKET differs per architecture (uapi.sn). setsockopt is passed a by-reference int32 value,
// getsockopt uses in/out socklen_t. Do not confuse either with WinSock.
عام عرف اضبط_خيار_عدد_مقبس_لينكس(
    رقم_ضبط: ط64, المقبس: &واصف_ملف_لينكس,
    المستوى: ط64, الخيار: ط64, القيمة: ص32
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    دع المعطى: متغير ص32 = القيمة;
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_ضبط, (*المقبس).القيمة, المستوى, الخيار,
        &متغير المعطى, 4 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_مقبس_لينكس(الخام);
}

عام عرف اقرأ_خيار_عدد_مقبس_لينكس(
    رقم_قراءة: ط64, المقبس: &واصف_ملف_لينكس,
    المستوى: ط64, الخيار: ط64
): نتيجة ص32, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    دع القيمة: متغير ص32 = 0;
    دع الحجم: متغير ط32 = 4;
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_قراءة, (*المقبس).القيمة, المستوى, الخيار,
        &متغير القيمة, &متغير الحجم, 0 مثل ط64
    ); }
    طابق نتيجة_مقبس_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> {
        لو (الحجم != 4) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
        أرجع نتيجة.نجح(القيمة);
    };
}

// SO_RCVTIMEO_OLD / SO_SNDTIMEO_OLD (uapi.sn) take a timeval of two native
// longs: 16 bytes on the 64-bit ABIs, 8 on the 32-bit ones (a relative
// timeout always fits; glibc uses the same form there, and qemu-user
// translates no _NEW variant). The timeout belongs to the socket, not a
// process-global resolver state.
عام عرف اضبط_مهلة_مقبس_لينكس(
    رقم_ضبط: ط64, المقبس: &واصف_ملف_لينكس, استقبال: منطقي,
    ثوان: ط64, ميكروثوان: ط64
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.مغلق()); };
    لو (ثوان > 9223372036854775807 || ميكروثوان >= 1000000) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع رقم_الخيار: متغير ط64 = خيار_مهلة_الاستقبال_لينكس();
    لو (!استقبال) { رقم_الخيار := خيار_مهلة_الإرسال_لينكس(); };
    لو (حجم_كلمة_لينكس() == 4) {
        لو (ثوان > 2147483647) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
        دع زمن_32: متغير متجه ط32 = [ثوان مثل ط32, ميكروثوان مثل ط32];
        دع خام_32: ط64;
        غير_آمن { خام_32 := بدائي_نداء_نواة_خام(
            رقم_ضبط, (*المقبس).القيمة, مستوى_مقبس_لينكس(), رقم_الخيار,
            &متغير زمن_32[0], 8 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_مقبس_لينكس(خام_32);
    };
    // sparc64: tv_usec is a 32-bit int at offset 8 (then 4 bytes of
    // padding), which on that big-endian ABI is the high half of word 2.
    دع الميكرو: متغير ط64 = ميكروثوان;
    لو (ميكروثواني_زمن_32_لينكس() && ترتيب_بايت_كبير_لينكس()) { الميكرو := ميكروثوان << 32; };
    دع الزمن: متغير متجه ط64 = [ثوان, الميكرو];
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_ضبط, (*المقبس).القيمة, مستوى_مقبس_لينكس(), رقم_الخيار,
        &متغير الزمن[0], 16 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_مقبس_لينكس(الخام);
}

// A DNS TCP fallback must not use a blocking connect with an unbounded
// kernel timeout. Caller creates SOCK_NONBLOCK | SOCK_CLOEXEC; connect()
// normally returns -EINPROGRESS, then ppoll(POLLOUT) waits at most 2s.
// Finally SO_ERROR decides whether the connection succeeded, and fcntl
// restores blocking mode for the existing per-socket send/receive deadlines.
// Linux pollfd layout on the supported x86-64/AArch64 little-endian ABIs:
// int fd; short events; short revents (eight bytes, aligned to four).
عام عرف اتصل_مقبس_لينكس_بمهلة(
    المقبس: &واصف_ملف_لينكس, العنوان: &متجه ط8
): نتيجة ط64, خطأ_مقبس_لينكس {
    لو (!(*المقبس).مفتوح || (*المقبس).القيمة > 2147483647
        || الطول(*العنوان) < 2 || الطول(*العنوان) > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
    };
    دع الاتصال: ط64;
    غير_آمن { الاتصال := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.اتصال()),
        (*المقبس).القيمة, &(*العنوان)[0], الطول(*العنوان) مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    دع ينتظر: متغير منطقي = خطأ;
    طابق حلل_نتيجة_نداء_نواة_لينكس(الاتصال) مع
    | نتيجة.نجح(_) -> {}
    | نتيجة.خطأ(الأصلي) -> {
        // EINPROGRESS, EALREADY, EINTR: wait; EISCONN: already connected.
        لو (الأصلي.الرمز == رمز_خطأ_قيد_التقدم_لينكس() || الأصلي.الرمز == رمز_خطأ_جار_بالفعل_لينكس()
            || الأصلي.الرمز == 4) {
            ينتظر := صواب;
        } وإلا لو (الأصلي.الرمز != رمز_خطأ_متصل_بالفعل_لينكس()) {
            أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(الأصلي));
        };
    };
    لو (ينتظر) {
        // POLLOUT=4 in `short events`, the first half of the second word:
        // its low 16 bits on little-endian targets, the high 16 on big-endian.
        دع واصف_الانتظار: ط32 = (*المقبس).القيمة مثل ط32;
        دع أحداث_الانتظار: متغير ط32 = 4;
        لو (ترتيب_بايت_كبير_لينكس()) { أحداث_الانتظار := 4 << 16; };
        دع الأحداث: متغير متجه ط32 = [واصف_الانتظار, أحداث_الانتظار];
        دع المهلة: متغير متجه ص64 = [2, 0];
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مقبسا()),
            &متغير الأحداث[0], 1 مثل ط64, &متغير المهلة[0],
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(الأصلي)); }
        | نتيجة.نجح(العدد) -> {
            لو (العدد == 0) {
                أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(
                    أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), رمز_خطأ_انتهت_المهلة_لينكس())
                ));
            };
            لو (العدد != 1) { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
        };
        // SOL_SOCKET/SO_ERROR per architecture; socklen_t is a 32-bit value.
        دع رمز_المقبس: متغير ط32 = 0;
        دع حجم_الخيار: متغير ط32 = 4;
        دع الخام_الخيار: ط64;
        غير_آمن { الخام_الخيار := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_خيار_مقبس()),
            (*المقبس).القيمة, مستوى_مقبس_لينكس(), خيار_خطأ_المقبس_لينكس(),
            &متغير رمز_المقبس, &متغير حجم_الخيار, 0 مثل ط64
        ); }
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام_الخيار) مع
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(الأصلي)); }
        | نتيجة.نجح(_) -> {
            لو (حجم_الخيار != 4) {
                أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح());
            };
            لو (رمز_المقبس != 0) {
                أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(
                    أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.يونكس(), رمز_المقبس مثل عدد)
                ));
            };
        };
    };
    // Nonblocking flag is local to this privately owned resolver socket.
    // Restoring blocking mode makes the configured SO_RCVTIMEO/SO_SNDTIMEO
    // apply to subsequent framed DNS reads and writes.
    طابق اضبط_واصف_لينكس_غير_حاصر(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تحكم_واصف()),
        المقبس, خطأ
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.نظام(الأصلي) -> {
            أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نظام(الأصلي));
        }
        | _ -> { أرجع نتيجة.خطأ(خطأ_مقبس_لينكس.نطاق_غير_صالح()); };
    }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(0); };
}
