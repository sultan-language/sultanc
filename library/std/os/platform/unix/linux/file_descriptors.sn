استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.buffer;
استورد os.path;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Linux kernel fd operations. The caller must supply the syscall number from
// the selected target's registered Linux UAPI table. The compiler lowers the
// raw kernel call itself for Linux x86-64 and AArch64; libc is not involved.
// A descriptor is nonnegative; a successful zero-byte read is EOF.
عام نوع خطأ_واصف_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | كتابة_بلا_تقدم
    | واصف_مغلق
    | نظام بنوع خطأ_نظام_أصلي
;

// A descriptor is a C int on every Linux and FreeBSD ABI (ص32); it widens
// to the 64-bit syscall register explicitly at each kernel call.
عام نوع واصف_ملف_لينكس = { القيمة: ص32, مفتوح: منطقي };

// A descriptor held at register or portable width (a kernel result, an
// os-level handle) back as a C int. A value outside the int range is no
// descriptor: it becomes -1, which the next call rejects with EBADF, rather
// than the low bits of another descriptor.
عام عرف واصف_لينكس_من_ط64(القيمة: ط64): ص32 {
    إذا (القيمة > 2147483647) { أرجع -1; };
    أرجع القيمة مثل ص32;
}

عام عرف واصف_لينكس_من_عدد(القيمة: عدد): ص32 {
    إذا (القيمة < 0 || القيمة > 2147483647) { أرجع -1; };
    أرجع القيمة مثل ص32;
}

عام عرف نتيجة_واصف_لينكس(الخام: ط64): نتيجة ط64, خطأ_واصف_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// openat(AT_FDCWD, path, flags, mode): AT_FDCWD=-100 on both ABIs.
// Flags are Linux O_* UAPI flags, not portable flags or Win32 access modes.
عام عرف افتح_واصف_لينكس(
    رقم_فتح_عند: ط64, المسار: &متجه ط8, الأعلام: ط64, الوضع: ط64
): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), (-100 مثل ص64) مثل ط64,
            &متغير الاسم[0], الأعلام, الوضع, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق نتيجة_واصف_لينكس(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع الواصف: واصف_ملف_لينكس = { القيمة: واصف_لينكس_من_ط64(القيمة), مفتوح: صواب };
            أرجع نتيجة.نجح(الواصف);
        };
    };
}

عام عرف اقرأ_واصف_لينكس(
    رقم_قراءة: ط64, الواصف: &واصف_ملف_لينكس,
    المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    // Linux MAX_RW_COUNT is 0x7ffff000; never pass a larger transfer.
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()), ((*الواصف).القيمة مثل ط64),
        &متغير (*المخزن)[الإزاحة مثل طبيعي], الطلب مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}

عام عرف اكتب_واصف_لينكس(
    رقم_كتابة: ط64, الواصف: &واصف_ملف_لينكس,
    المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    إذا (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة()), ((*الواصف).القيمة مثل ط64),
        &(*المحتوى)[الإزاحة مثل طبيعي], الطلب مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}

// The descriptor becomes unowned after close is attempted. Retrying close
// after EINTR risks closing a newly reused descriptor on Linux.
عام عرف أغلق_واصف_لينكس(
    رقم_إغلاق: ط64, الواصف: &متغير واصف_ملف_لينكس
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), ((*الواصف).القيمة مثل ط64), 0 مثل ط64, 0 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    (*الواصف).مفتوح := خطأ;
    أرجع نتيجة_واصف_لينكس(الخام);
}

عام عرف زامن_واصف_لينكس(
    رقم_مزامنة: ط64, الواصف: &واصف_ملف_لينكس
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.مزامنة_ملف()), ((*الواصف).القيمة مثل ط64), 0 مثل ط64, 0 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}

// offset is an i64 bit pattern, not a truncated 32-bit count.
عام عرف حرك_واصف_لينكس(
    رقم_موضع: ط64, الواصف: &واصف_ملف_لينكس, الإزاحة: ص64, الأصل: ط64
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    إذا (الأصل > 2) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح()); };
    إذا (موضع_ملف_بنصفين_لينكس()) {
        // _llseek(fd, offset >> 32, offset & 0xffffffff, &result, whence):
        // the 32-bit ABIs' 64-bit seek; the new offset comes back in result.
        دع الناتج: متغير متجه ص64 = [0];
        دع الكاملة: ط64 = الإزاحة مثل ط64;
        دع خام_النصفين: ط64;
        غير_آمن { خام_النصفين := بدائي_نداء_نواة_خام(
            رقم_موضع, ((*الواصف).القيمة مثل ط64), الكاملة >> 32, الكاملة & 0xffffffff,
            &متغير الناتج[0], الأصل, 0 مثل ط64
        ); }
        طابق نتيجة_واصف_لينكس(خام_النصفين) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج[0] مثل ط64); };
    };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_موضع, ((*الواصف).القيمة مثل ط64), الإزاحة مثل ط64, الأصل,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}

// pipe2 may allocate descriptors 0, 1 or 2 when the calling process has
// closed standard streams. A private child-error channel must not occupy
// those slots: the child must be able to preserve the original stdio state.
// F_DUPFD_CLOEXEC (uapi.sn) creates an owned descriptor >=3 atomically with
// FD_CLOEXEC. The old descriptor is consumed by close even on EINTR; never
// retry it. A failure to close the old descriptor also releases the duplicate
// rather than leaving a second owner behind.
عام عرف ارفع_واصف_خاص_لينكس_فوق_القياسية(
    رقم_تحكم_واصف: ط64, رقم_إغلاق: ط64,
    الواصف: &متغير واصف_ملف_لينكس
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق());
    };
    إذا ((*الواصف).القيمة >= 3) {
        أرجع نتيجة.نجح((*الواصف).القيمة مثل ط64);
    };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_تحكم_واصف, ((*الواصف).القيمة مثل ط64),
        أمر_تكرار_واصف_بإغلاق_عند_التنفيذ_لينكس(), 3 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_واصف_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الجديد) -> {
        دع المكرر: متغير واصف_ملف_لينكس = {
            القيمة: واصف_لينكس_من_ط64(الجديد), مفتوح: صواب
        };
        طابق أغلق_واصف_لينكس(رقم_إغلاق, الواصف) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع التنظيف: نتيجة ط64, خطأ_واصف_لينكس =
                أغلق_واصف_لينكس(رقم_إغلاق, &متغير المكرر);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> {
            (*الواصف).القيمة := واصف_لينكس_من_ط64(الجديد);
            (*الواصف).مفتوح := صواب;
            أرجع نتيجة.نجح(الجديد);
        };
    };
}

// Raw fd=0/1/2 are borrowed from process startup; never close by default.
عام عرف اقرأ_دخل_لينكس(
    رقم_قراءة: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_لينكس {
    دع الدخل: واصف_ملف_لينكس = { القيمة: 0, مفتوح: صواب };
    أرجع اقرأ_واصف_لينكس(رقم_قراءة, &الدخل, المخزن, الإزاحة, المطلوب);
}

عام عرف اكتب_تيار_لينكس(
    رقم_كتابة: ط64, الواصف: ط64,
    المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (الواصف != 1 && الواصف != 2) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    دع التيار: واصف_ملف_لينكس = { القيمة: الواصف مثل ص32, مفتوح: صواب };
    أرجع اكتب_واصف_لينكس(رقم_كتابة, &التيار, المحتوى, الإزاحة, المطلوب);
}

// fcntl(F_GETFL/F_SETFL) preserves existing file status flags; O_NONBLOCK
// is per kernel (uapi.sn); F_GETFL=3 and F_SETFL=4 on Linux and FreeBSD.
عام عرف اضبط_واصف_لينكس_غير_حاصر(
    رقم_تحكم_واصف: ط64, الواصف: &واصف_ملف_لينكس, مفعل: منطقي
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع القراءة: ط64;
    غير_آمن { القراءة := بدائي_نداء_نواة_خام(
        رقم_تحكم_واصف, ((*الواصف).القيمة مثل ط64), 3 مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق نتيجة_واصف_لينكس(القراءة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الأعلام) -> {
        دع الجديدة: متغير ط64 = الأعلام & (~علم_فتح_غير_حاصر_لينكس());
        إذا (مفعل) { الجديدة := الأعلام | علم_فتح_غير_حاصر_لينكس(); };
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_تحكم_واصف, ((*الواصف).القيمة مثل ط64), 4 مثل ط64,
            الجديدة, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_واصف_لينكس(الخام);
    };
}

// fchmod uses a documented Linux kernel interface. The caller owns the fd;
// mode changes affect the existing file, unlike openat's creation mode.
عام عرف اضبط_أذونات_واصف_لينكس(
    رقم_الأذونات: ط64, الواصف: &واصف_ملف_لينكس, الوضع: ط64
): نتيجة ط64, خطأ_واصف_لينكس {
    إذا (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_الأذونات, ((*الواصف).القيمة مثل ط64), الوضع,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    أرجع نتيجة_واصف_لينكس(الخام);
}

// Executable output is file creation, complete bounded writes, explicit
// permission setting and close. Nothing here implements a linker.
عام عرف اكتب_بايتات_تنفيذية_لينكس(
    رقم_فتح_عند: ط64, رقم_كتابة: ط64, رقم_إغلاق: ط64,
    رقم_أذونات: ط64, المسار: &متجه ط8, المحتوى: &متجه ط8
): نتيجة ط64, خطأ_واصف_لينكس {
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode 0755 (umask applies).
    طابق افتح_واصف_لينكس(رقم_فتح_عند, المسار, (علم_فتح_إغلاق_عند_التنفيذ_لينكس() | علم_فتح_إنشاء_لينكس() | علم_فتح_اقتطاع_لينكس() | علم_فتح_للكتابة_لينكس()), 493) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المفتوح) -> {
        دع الواصف: متغير واصف_ملف_لينكس = المفتوح;
        دع العدد: عدد = الطول(*المحتوى);
        دع الموضع: متغير عدد = 0;
        طالما (الموضع < العدد) {
            طابق اكتب_واصف_لينكس(
                رقم_كتابة, &الواصف, المحتوى, الموضع, العدد - الموضع
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ مع
                | خطأ_واصف_لينكس.نظام(الأصلي) -> {
                    إذا (الأصلي.الرمز != 4) {
                        دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                        أرجع نتيجة.خطأ(الخطأ);
                    };
                }
                | _ -> {
                    دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                    أرجع نتيجة.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(المكتوب) -> {
                إذا (المكتوب == 0 || المكتوب > ((العدد - الموضع) مثل ط64)) {
                    دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                    أرجع نتيجة.خطأ(خطأ_واصف_لينكس.كتابة_بلا_تقدم());
                };
                الموضع := الموضع + (المكتوب مثل عدد);
            };
        }
        طابق اضبط_أذونات_واصف_لينكس(رقم_أذونات, &الواصف, 493) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع الإغلاق: نتيجة ط64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> { };
        طابق أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الموضع مثل ط64); };
    };
}
