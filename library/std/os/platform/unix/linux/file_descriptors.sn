استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.buffer;
استورد os.path;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;

// Linux kernel fd operations. The caller must supply the syscall number from
// the selected target's registered Linux UAPI table. The compiler lowers the
// raw kernel call itself for Linux x86-64 and AArch64; libc is not involved.
// A descriptor is nonnegative; a successful zero-byte read is EOF.
عام نوع خطأ_واصف_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | كتابة_بلا_تقدم
    | واصف_مغلق
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع واصف_ملف_لينكس = { القيمة: غ64, مفتوح: منطقي };

عام عرف نتيجة_واصف_لينكس(الخام: غ64): نتيجة غ64, خطأ_واصف_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// openat(AT_FDCWD, path, flags, mode): AT_FDCWD=-100 on both ABIs.
// Flags are Linux O_* UAPI flags, not portable flags or Win32 access modes.
عام عرف افتح_واصف_لينكس(
    رقم_فتح_عند: غ64, المسار: &متجه غ8, الأعلام: غ64, الوضع: غ64
): نتيجة واصف_ملف_لينكس, خطأ_واصف_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه غ8 = البايتات;
        دع الخام: غ64 = بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), (-100 مثل ص64) مثل غ64,
            &متغير الاسم[0], الأعلام, الوضع, 0 مثل غ64, 0 مثل غ64
        );
        طابق نتيجة_واصف_لينكس(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(القيمة) -> {
            دع الواصف: واصف_ملف_لينكس = { القيمة: القيمة, مفتوح: صواب };
            أرجع نتيجة.نجح(الواصف);
        };
    };
}

عام عرف اقرأ_واصف_لينكس(
    رقم_قراءة: غ64, الواصف: &واصف_ملف_لينكس,
    المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    // Linux MAX_RW_COUNT is 0x7ffff000; never pass a larger transfer.
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()), (*الواصف).القيمة,
        &متغير (*المخزن)[الإزاحة مثل غير_موقع], الطلب مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_واصف_لينكس(الخام);
}

عام عرف اكتب_واصف_لينكس(
    رقم_كتابة: غ64, الواصف: &واصف_ملف_لينكس,
    المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    لو (الطلب > 0x7ffff000) { الطلب := 0x7ffff000; };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة()), (*الواصف).القيمة,
        &(*المحتوى)[الإزاحة مثل غير_موقع], الطلب مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_واصف_لينكس(الخام);
}

// The descriptor becomes unowned after close is attempted. Retrying close
// after EINTR risks closing a newly reused descriptor on Linux.
عام عرف أغلق_واصف_لينكس(
    رقم_إغلاق: غ64, الواصف: &متغير واصف_ملف_لينكس
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), (*الواصف).القيمة, 0 مثل غ64, 0 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    (*الواصف).مفتوح := خطأ;
    أرجع نتيجة_واصف_لينكس(الخام);
}

عام عرف زامن_واصف_لينكس(
    رقم_مزامنة: غ64, الواصف: &واصف_ملف_لينكس
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.مزامنة_ملف()), (*الواصف).القيمة, 0 مثل غ64, 0 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_واصف_لينكس(الخام);
}

// offset is an i64 bit pattern, not a truncated 32-bit count.
عام عرف حرك_واصف_لينكس(
    رقم_موضع: غ64, الواصف: &واصف_ملف_لينكس, الإزاحة: ص64, الأصل: غ64
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    لو (الأصل > 2) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح()); };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.موضع_ملف()), (*الواصف).القيمة, الإزاحة مثل غ64, الأصل,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_واصف_لينكس(الخام);
}

// pipe2 may allocate descriptors 0, 1 or 2 when the calling process has
// closed standard streams. A private child-error channel must not occupy
// those slots: the child must be able to preserve the original stdio state.
// F_DUPFD_CLOEXEC (1030) creates an owned descriptor >=3 atomically with
// FD_CLOEXEC. The old descriptor is consumed by close even on EINTR; never
// retry it. A failure to close the old descriptor also releases the duplicate
// rather than leaving a second owner behind.
عام عرف ارفع_واصف_خاص_لينكس_فوق_القياسية(
    رقم_تحكم_واصف: غ64, رقم_إغلاق: غ64,
    الواصف: &متغير واصف_ملف_لينكس
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق());
    };
    لو ((*الواصف).القيمة >= 3) {
        أرجع نتيجة.نجح((*الواصف).القيمة);
    };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_تحكم_واصف, (*الواصف).القيمة,
        1030 مثل غ64, 3 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق نتيجة_واصف_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الجديد) -> {
        دع المكرر: متغير واصف_ملف_لينكس = {
            القيمة: الجديد, مفتوح: صواب
        };
        طابق أغلق_واصف_لينكس(رقم_إغلاق, الواصف) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع التنظيف: نتيجة غ64, خطأ_واصف_لينكس =
                أغلق_واصف_لينكس(رقم_إغلاق, &متغير المكرر);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> {
            (*الواصف).القيمة := الجديد;
            (*الواصف).مفتوح := صواب;
            أرجع نتيجة.نجح(الجديد);
        };
    };
}

// Raw fd=0/1/2 are borrowed from process startup; never close by default.
عام عرف اقرأ_دخل_لينكس(
    رقم_قراءة: غ64, المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_لينكس {
    دع الدخل: واصف_ملف_لينكس = { القيمة: 0, مفتوح: صواب };
    أرجع اقرأ_واصف_لينكس(رقم_قراءة, &الدخل, المخزن, الإزاحة, المطلوب);
}

عام عرف اكتب_تيار_لينكس(
    رقم_كتابة: غ64, الواصف: غ64,
    المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (الواصف != 1 && الواصف != 2) {
        أرجع نتيجة.خطأ(خطأ_واصف_لينكس.نطاق_غير_صالح());
    };
    دع التيار: واصف_ملف_لينكس = { القيمة: الواصف, مفتوح: صواب };
    أرجع اكتب_واصف_لينكس(رقم_كتابة, &التيار, المحتوى, الإزاحة, المطلوب);
}

// fcntl(F_GETFL/F_SETFL) preserves existing file status flags; O_NONBLOCK
// 0x800, F_GETFL=3, F_SETFL=4 in Linux UAPI on both supported targets.
عام عرف اضبط_واصف_لينكس_غير_حاصر(
    رقم_تحكم_واصف: غ64, الواصف: &واصف_ملف_لينكس, مفعل: منطقي
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع القراءة: غ64 = بدائي_نداء_نواة_خام(
        رقم_تحكم_واصف, (*الواصف).القيمة, 3 مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق نتيجة_واصف_لينكس(القراءة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الأعلام) -> {
        دع الجديدة: متغير غ64 = الأعلام & (~(0x800 مثل غ64));
        لو (مفعل) { الجديدة := الأعلام | 0x800; };
        دع الخام: غ64 = بدائي_نداء_نواة_خام(
            رقم_تحكم_واصف, (*الواصف).القيمة, 4 مثل غ64,
            الجديدة, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
        );
        أرجع نتيجة_واصف_لينكس(الخام);
    };
}

// fchmod uses a documented Linux kernel interface. The caller owns the fd;
// mode changes affect the existing file, unlike openat's creation mode.
عام عرف اضبط_أذونات_واصف_لينكس(
    رقم_الأذونات: غ64, الواصف: &واصف_ملف_لينكس, الوضع: غ64
): نتيجة غ64, خطأ_واصف_لينكس {
    لو (!(*الواصف).مفتوح) { أرجع نتيجة.خطأ(خطأ_واصف_لينكس.واصف_مغلق()); };
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_الأذونات, (*الواصف).القيمة, الوضع,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    أرجع نتيجة_واصف_لينكس(الخام);
}

// Executable output is file creation, complete bounded writes, explicit
// permission setting and close. Nothing here implements a linker.
عام عرف اكتب_بايتات_تنفيذية_لينكس(
    رقم_فتح_عند: غ64, رقم_كتابة: غ64, رقم_إغلاق: غ64,
    رقم_أذونات: غ64, المسار: &متجه غ8, المحتوى: &متجه غ8
): نتيجة غ64, خطأ_واصف_لينكس {
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, mode 0755 (umask applies).
    طابق افتح_واصف_لينكس(رقم_فتح_عند, المسار, 0x80241, 493) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المفتوح) -> {
        دع الواصف: متغير واصف_ملف_لينكس = المفتوح;
        دع العدد: عدد = الطول(*المحتوى);
        دع الموضع: متغير عدد = 0;
        بينما (الموضع < العدد) {
            طابق اكتب_واصف_لينكس(
                رقم_كتابة, &الواصف, المحتوى, الموضع, العدد - الموضع
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                طابق الخطأ مع
                | خطأ_واصف_لينكس.نظام(الأصلي) -> {
                    لو (الأصلي.الرمز != 4) {
                        دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                        أرجع نتيجة.خطأ(الخطأ);
                    };
                }
                | _ -> {
                    دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                    أرجع نتيجة.خطأ(الخطأ);
                };
            }
            | نتيجة.نجح(المكتوب) -> {
                لو (المكتوب == 0 || المكتوب > ((العدد - الموضع) مثل غ64)) {
                    دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
                    أرجع نتيجة.خطأ(خطأ_واصف_لينكس.كتابة_بلا_تقدم());
                };
                الموضع := الموضع + (المكتوب مثل عدد);
            };
        }
        طابق اضبط_أذونات_واصف_لينكس(رقم_أذونات, &الواصف, 493) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(_) -> { };
        طابق أغلق_واصف_لينكس(رقم_إغلاق, &متغير الواصف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الموضع مثل غ64); };
    };
}
