استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.path;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;
// Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }

// Kernel-facing pathname operations. These accept opaque Unix bytes, not
// a presumed UTF-8 filename. The selected kernel's table supplies the
// syscall numbers (Linux UAPI, or FreeBSD's syscall.h: same arguments).
عام نوع خطأ_مسارات_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | نظام بنوع خطأ_نظام_أصلي
;

عرف حالة_مسار_لينكس(الخام: ط64): نتيجة ط64, خطأ_مسارات_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// mkdirat(AT_FDCWD, path, mode); default permissions are subject to umask.
عام عرف أنشئ_دليل_لينكس(
    رقم_إنشاء_دليل_عند: ط64, المسار: &متجه ط8, الوضع: ط64
): نتيجة ط64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إنشاء_دليل_عند()), (-100 مثل ص64) مثل ط64,
            &متغير الاسم[0], الوضع, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع حالة_مسار_لينكس(الخام);
    };
}

// unlinkat: flag=0 deletes a non-directory; AT_REMOVEDIR (uapi.sn: 0x200
// on Linux, 0x800 on FreeBSD) removes an empty directory. These are
// distinct kernel semantics.
عام عرف احذف_مسار_لينكس(
    رقم_حذف_عند: ط64, المسار: &متجه ط8, دليل: منطقي
): نتيجة ط64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه ط8 = البايتات;
        دع الأعلام: متغير ط64 = 0;
        لو (دليل) { الأعلام := علم_حذف_دليل_لينكس(); };
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حذف_عند()), (-100 مثل ص64) مثل ط64,
            &متغير الاسم[0], الأعلام, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع حالة_مسار_لينكس(الخام);
    };
}

// renameat: both NUL-terminated path arrays stay alive across the call.
عام عرف أعد_تسمية_لينكس(
    رقم_إعادة_تسمية_عند: ط64, الأصل: &متجه ط8, الوجهة: &متجه ط8
): نتيجة ط64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(الوجهة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_الوجهة) -> {
            دع مخزن_الأصل: متغير متجه ط8 = بايتات_الأصل;
            دع مخزن_الوجهة: متغير متجه ط8 = بايتات_الوجهة;
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إعادة_تسمية_عند()), (-100 مثل ص64) مثل ط64,
                &متغير مخزن_الأصل[0], (-100 مثل ص64) مثل ط64,
                &متغير مخزن_الوجهة[0], 0 مثل ط64, 0 مثل ط64
            ); }
            أرجع حالة_مسار_لينكس(الخام);
        };
    };
}

// getcwd writes an absolute NUL-terminated pathname into caller storage.
// The successful raw Linux return is the occupied byte count incl. NUL;
// FreeBSD's __getcwd returns 0 (uapi.sn دليل_العمل_بطوله_لينكس), so the
// length is then the position of the NUL within the buffer.
عام عرف اقرأ_دليل_عمل_لينكس(
    رقم_قراءة_دليل_العمل: ط64, السعة: طبيعي
): نتيجة متجه ط8, خطأ_مسارات_لينكس {
    لو (السعة == 0 || السعة > 0x7ffff000) { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح())); };
    دع المخزن: متغير متجه ط8 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < السعة) {
        ألحق(المخزن, 0 مثل ط8);
        الفهرس := الفهرس + 1;
    }
    دع الخام: ط64;
    غير_آمن { الخام := بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_دليل_العمل()), &متغير المخزن[0], السعة مثل ط64,
        0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
    ); }
    طابق حالة_مسار_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الناتج_الخام) -> {
        دع الحجم: متغير ط64 = الناتج_الخام;
        لو (!دليل_العمل_بطوله_لينكس()) {
            لو (الناتج_الخام != 0) {
                أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح()));
            };
            دع النهاية: متغير طبيعي = 0;
            طالما (النهاية < السعة && المخزن[النهاية] != 0) { النهاية := النهاية + 1; }
            لو (النهاية == السعة) {
                أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح()));
            };
            الحجم := (النهاية + 1) مثل ط64;
        };
        لو (الحجم == 0 || الحجم > (السعة مثل ط64)) {
            أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح()));
        };
        دع الناتج: متغير متجه ط8 = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < ((الحجم - 1) مثل طبيعي)) {
            ألحق(الناتج, المخزن[الموضع]);
            الموضع := الموضع + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    };
}
