استورد os.platform.unix.linux.syscalls.operations;
استورد os.platform.unix.linux.syscalls.selection;
استورد os.path;
استورد os.error;
استورد os.platform.unix.linux.syscalls.kernel_result;

// Kernel-facing pathname operations. These accept opaque Unix bytes, not
// a presumed UTF-8 filename. The selected Linux target supplies syscall
// numbers from its existing UAPI table; only x86-64/AArch64 have lowering.
عام نوع خطأ_مسارات_لينكس =
    | مسار بنوع خطأ_مسار_نظام
    | نظام بنوع خطأ_نظام_أصلي
;

عرف حالة_مسار_لينكس(الخام: غ64): نتيجة غ64, خطأ_مسارات_لينكس {
    طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.نظام(الخطأ)); }
    | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); };
}

// mkdirat(AT_FDCWD, path, mode); default permissions are subject to umask.
عام عرف أنشئ_دليل_لينكس(
    رقم_إنشاء_دليل_عند: غ64, المسار: &متجه غ8, الوضع: غ64
): نتيجة غ64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه غ8 = البايتات;
        دع الخام: غ64 = بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إنشاء_دليل_عند()), (-100 مثل ص64) مثل غ64,
            &متغير الاسم[0], الوضع, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
        );
        أرجع حالة_مسار_لينكس(الخام);
    };
}

// unlinkat: flag=0 deletes a non-directory; AT_REMOVEDIR=0x200 removes
// an empty directory. These are distinct kernel semantics.
عام عرف احذف_مسار_لينكس(
    رقم_حذف_عند: غ64, المسار: &متجه غ8, دليل: منطقي
): نتيجة غ64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(البايتات) -> {
        دع الاسم: متغير متجه غ8 = البايتات;
        دع الأعلام: متغير غ64 = 0;
        لو (دليل) { الأعلام := 0x200; };
        دع الخام: غ64 = بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حذف_عند()), (-100 مثل ص64) مثل غ64,
            &متغير الاسم[0], الأعلام, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
        );
        أرجع حالة_مسار_لينكس(الخام);
    };
}

// renameat: both NUL-terminated path arrays stay alive across the call.
عام عرف أعد_تسمية_لينكس(
    رقم_إعادة_تسمية_عند: غ64, الأصل: &متجه غ8, الوجهة: &متجه غ8
): نتيجة غ64, خطأ_مسارات_لينكس {
    طابق بايتات_مسار_يونكس_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
    | نتيجة.نجح(بايتات_الأصل) -> {
        طابق بايتات_مسار_يونكس_صفرية(الوجهة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(الخطأ)); }
        | نتيجة.نجح(بايتات_الوجهة) -> {
            دع مخزن_الأصل: متغير متجه غ8 = بايتات_الأصل;
            دع مخزن_الوجهة: متغير متجه غ8 = بايتات_الوجهة;
            دع الخام: غ64 = بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إعادة_تسمية_عند()), (-100 مثل ص64) مثل غ64,
                &متغير مخزن_الأصل[0], (-100 مثل ص64) مثل غ64,
                &متغير مخزن_الوجهة[0], 0 مثل غ64, 0 مثل غ64
            );
            أرجع حالة_مسار_لينكس(الخام);
        };
    };
}

// getcwd writes an absolute NUL-terminated pathname into caller storage.
// The successful raw Linux return is the occupied byte count incl. NUL.
عام عرف اقرأ_دليل_عمل_لينكس(
    رقم_قراءة_دليل_العمل: غ64, السعة: غير_موقع
): نتيجة متجه غ8, خطأ_مسارات_لينكس {
    لو (السعة == 0 || السعة > 0x7ffff000) { أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح())); };
    دع المخزن: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < السعة) {
        ألحق(المخزن, 0 مثل غ8);
        الفهرس := الفهرس + 1;
    }
    دع الخام: غ64 = بدائي_نداء_نواة_خام(
        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_دليل_العمل()), &متغير المخزن[0], السعة مثل غ64,
        0 مثل غ64, 0 مثل غ64, 0 مثل غ64, 0 مثل غ64
    );
    طابق حالة_مسار_لينكس(الخام) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الحجم) -> {
        لو (الحجم == 0 || الحجم > (السعة مثل غ64)) {
            أرجع نتيجة.خطأ(خطأ_مسارات_لينكس.مسار(خطأ_مسار_نظام.ترميز_غير_صالح()));
        };
        دع الناتج: متغير متجه غ8 = [];
        دع الموضع: متغير غير_موقع = 0;
        بينما (الموضع < ((الحجم - 1) مثل غير_موقع)) {
            ألحق(الناتج, المخزن[الموضع]);
            الموضع := الموضع + 1;
        }
        أرجع نتيجة.نجح(الناتج);
    };
}
