    استورد نظام_التشغيل.منصات.يونكس.لينكس.نداءات_النظام.أرقام_ريسك_في64;

    عام عرف رقم_نداء_نواة_لينكس(العملية: عملية_نداء_نواة_لينكس): ط64 {
