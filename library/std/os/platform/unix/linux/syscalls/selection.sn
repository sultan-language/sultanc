استورد نظام_التشغيل.منصات.يونكس.لينكس.نداءات_النظام.عمليات;

// Source target guards are evaluated by the canonical frontend before import
// resolution. No host probing or independent target table is introduced.
// One generated number table per kernel ABI (Android included:
// it is the Linux kernel ABI without libc).

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية == «x86_64» && الهدف.عرض_المؤشر == «64») {
    استورد نظام_التشغيل.منصات.يونكس.لينكس.نداءات_النظام.أرقام_إكس86_64;

    عام عرف رقم_نداء_نواة_لينكس(العملية: عملية_نداء_نواة_لينكس): ط64 {
        أرجع رقم_نداء_نواة_لينكس_اكس86_64(العملية) مثل ط64;
    }
}

إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية == «aarch64» && الهدف.عرض_المؤشر == «64») {
