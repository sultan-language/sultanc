// FreeBSD: the same std operations, issued through FreeBSD's own system-call
// numbers (one table for every architecture, generated from sys/sys/
// syscall.h by tools/generate/generate_freebsd_syscalls.py). Where the
// FreeBSD call differs from Linux's in its arguments or result, the std code
// that issues it has a FreeBSD path (registry/freebsd_syscalls.def).
إذا (الهدف.المنصة == «freebsd» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «riscv64»)) {
    استورد نظام_التشغيل.منصات.يونكس.فري_بي_إس_دي.نداءات_النظام.أرقام;

    عام عرف رقم_نداء_نواة_لينكس(العملية: عملية_نداء_نواة_لينكس): ط64 {
        أرجع رقم_نداء_نواة_فري_بي_إس_دي(العملية) مثل ط64;
    }
}
