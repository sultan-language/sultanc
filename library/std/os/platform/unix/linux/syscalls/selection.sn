// 32-bit ABIs: their time64 and large-file entry points are selected in the
// tables (tools/generate/registry/linux_syscalls.def, ilp32: rows).
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية == «x86» && الهدف.عرض_المؤشر == «32») {
    استورد نظام_التشغيل.منصات.يونكس.لينكس.نداءات_النظام.أرقام_آي386;

    عام عرف رقم_نداء_نواة_لينكس(العملية: عملية_نداء_نواة_لينكس): ط64 {
        أرجع رقم_نداء_نواة_لينكس_اكس86_32(العملية) مثل ط64;
