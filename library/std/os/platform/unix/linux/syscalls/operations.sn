        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_الوسيطة_2, دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    دع اسم_إنشاء_دليل_عند: نص = «إنشاء_دليل_عند»;
    إذا (نصان_متساويان(&الاسم, &اسم_إنشاء_دليل_عند)) {
