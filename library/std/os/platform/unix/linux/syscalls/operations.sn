        دع دور_الوسيطة_5: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(كتابة, حد_ذاكرة_نواة_لينكس.ثابت(256));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_الوسيطة_2, دور_عدد, دور_عدد, دور_الوسيطة_5, غير_مستخدم];
