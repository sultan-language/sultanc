استورد std.text.compare;

// Kernel operations required by std.os. This identifies OS services, not
// compilation targets; architecture-specific syscall numbers are kept in
// their respective Linux UAPI tables. No host calls occur in this module.
عام نوع عملية_نداء_نواة_لينكس =
    | قراءة
    | كتابة
    | إغلاق
    | فتح_عند
    | معلومات_ملف_عند
    | إحصاء_مسار
    | قراءة_مداخل_دليل
    | إنشاء_دليل_عند
    | حذف_عند
    | إعادة_تسمية_عند
    | موضع_ملف
    | مزامنة_ملف
    | مزامنة_بيانات
    | تحكم_واصف
    | أذونات_واصف
    | قراءة_دليل_العمل
    | خروج
    | خروج_جماعي
    | انتظار_عملية
    | قناة_عملية
    | أغلق_مجال_واصفات
    | انتظر_مقبسا
    | نسخ_عملية
    | أرسل_إشارة_عملية
    | تشغيل_برنامج
    | ربط_ذاكرة
    // mmap taking one pointer to its six arguments (s390 old_mmap); no
    // contract: only the s390 virtual-memory provider issues it.
    | ربط_ذاكرة_بكتلة
    | إلغاء_ربط_ذاكرة
    | حماية_ذاكرة
    | قفل_ذاكرة
    | إلغاء_قفل_ذاكرة
    | نصيحة_ذاكرة
    | مقبس
    | اتصال
    | ربط_مقبس
    | استماع
    | قبول
    | قبول_بأعلام
    | إرسال_إلى
    | استقبال_من
    | إيقاف_مقبس
    | ضبط_خيار_مقبس
    | قراءة_خيار_مقبس
    | ساعة_نظام
    | نوم_نانو
    | نوم_الساعة
    | قراءة_وصلة_عند
    | عشوائية_النواة
    | قراءة_حد_مورد
    | ضبط_حد_مورد
    // FreeBSD __sysctl (hw.pagesize); Linux has no such call (std never
    // issues it there: its page size comes from the auxiliary vector).
    | قراءة_متغير_نواة
    // Links, permissions, sizes, times and the working directory (std.fs,
    // std.env), descriptor duplication for child stdio (std.process), and
    // address-bearing socket calls (std.net).
    | وصلة_رمزية_عند
    | وصلة_صلبة_عند
    | أذونات_مسار_عند
    | اقتطاع_واصف
    | أوقات_مسار_عند
    | تغيير_دليل_العمل
    | مضاعفة_واصف
    | اسم_مقبس_محلي
    | اسم_مقبس_نظير
    | إرسال_إلى_عنوان
    | استقبال_من_عنوان
    // Advisory whole-file locks (std.fs.lock), and the signal mask and
    // pending-signal wait of a SIGPIPE-safe pipe write (std.process).
    | قفل_ملف
    | حجب_إشارات
    | انتظر_إشارة
    // futex(addr, op, val, timeout, ...): the Linux thread join and the
    // Mutex/Condvar wait and wake (std.thread, docs/en/reference/concurrency.md). A join
    // uses FUTEX_WAIT on the tid CLONE_CHILD_CLEARTID clears; a NULL timeout
    // makes the 32-bit ABIs' plain futex serve the 64-bit record too.
    | مستقبل
    // futex with a relative timeout (std.os.wait_address): futex_time64 on
    // the 32-bit ABIs, so the timespec is the 64-bit record everywhere.
    | مستقبل_بمهلة
    // FreeBSD's _umtx_op(obj, op, val, uaddr1, uaddr2) with a relative
    // timespec in uaddr2, the fifth slot (std.os.wait_address).
    | مستقبل_بمهلة_بي_إس_دي
    // sched_yield, gettid and sched_getaffinity: std.thread's yield, current
    // thread id and available parallelism.
    | تنازل_جدولة
    | معرف_الخيط
    | ألفة_المعالج
    // Ending the calling thread only (Linux exit, FreeBSD thr_exit), and
    // FreeBSD's thread creation (thr_new; Linux threads start with clone).
    | إنهاء_خيط
    | إنشاء_خيط
    // The readiness poller under std.os.poll: Linux epoll_create1, epoll_ctl
    // and epoll_pwait (a NULL sigmask, so its size argument is ignored);
    // FreeBSD kqueue and kevent (kevent both changes and waits, so FreeBSD
    // has no control row).
    | أنشئ_مستطلع_أحداث
    | تحكم_مستطلع_أحداث
    | انتظر_مستطلع_أحداث
    // getpid and ioctl: std.process.id and std.os.terminal (TCGETS on
    // Linux, TIOCGETA on FreeBSD, as isatty(3) does).
    | معرف_العملية
    | تحكم_جهاز
    // io_uring_setup and io_uring_enter: std.os.poll's ring poller.
    | إعداد_حلقة_إدخال
    | دخول_حلقة_إدخال
;

// The canonical Linux operation is also the sole owner of kernel memory ABI
// signatures. An unlisted operation has no safe flat-memory interpretation.
// Slot indexes are machine ABI positions 1..6 (the syscall number is slot 0).
عام نوع اتجاه_ذاكرة_نواة_لينكس =
    | قراءة
    | كتابة
    | قراءة_وكتابة
;

عام نوع حد_ذاكرة_نواة_لينكس =
    | وسيطة بنوع طبيعي
    | ثابت بنوع طبيعي
    | سلسلة_صفرية
;

عام نوع دور_وسيطة_نواة_لينكس =
    | عدد
    | غير_مستخدم
    | مخزن بنوع (اتجاه_ذاكرة_نواة_لينكس, حد_ذاكرة_نواة_لينكس)
;

// A copy-back policy is part of the authenticated operation, not a mask
// supplied by source code. The interpreter must never copy an unproven size.
عام نوع أثر_نتيجة_نواة_لينكس =
    | بلا_نسخ
    | عدد_بايتات_النتيجة
    | كامل_عند_النجاح
    | كامل_عند_المقاطعة
;

عام نوع توقيع_نداء_نواة_لينكس = {
    الأدوار: متجه دور_وسيطة_نواة_لينكس,
    النسخ: أثر_نتيجة_نواة_لينكس
};

// Unsupported graph pointers (execve, iovec, msghdr, socket address in/out
// with pointer length, and target-dependent ioctl/fcntl) fail closed.
// Linux x86-64 and asm-generic AArch64 use the same argument shapes below;
// their actual syscall numbers remain exclusively in the selected UAPI table.
عام عرف توقيع_عملية_نواة_لينكس(
    الاسم: نص
): اختياري توقيع_نداء_نواة_لينكس {
    دع دور_عدد: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.عدد();
    دع غير_مستخدم: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.غير_مستخدم();
    دع قراءة: اتجاه_ذاكرة_نواة_لينكس = اتجاه_ذاكرة_نواة_لينكس.قراءة();
    دع كتابة: اتجاه_ذاكرة_نواة_لينكس = اتجاه_ذاكرة_نواة_لينكس.كتابة();
    دع اسم_قراءة: نص = «قراءة»;
    إذا (نصان_متساويان(&الاسم, &اسم_قراءة)) {
        دع دور_الوسيطة_2: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(كتابة, حد_ذاكرة_نواة_لينكس.وسيطة(3));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_الوسيطة_2, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.عدد_بايتات_النتيجة() };
        أرجع اختياري.موجود(التوقيع);
    }
    دع اسم_كتابة: نص = «كتابة»;
    إذا (نصان_متساويان(&الاسم, &اسم_كتابة)) {
        دع دور_الوسيطة_2: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.وسيطة(3));
