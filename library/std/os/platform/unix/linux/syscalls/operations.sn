        دع دور_الوسيطة_2: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(كتابة, حد_ذاكرة_نواة_لينكس.وسيطة(3));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_الوسيطة_2, دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.عدد_بايتات_النتيجة() };
        أرجع اختيار.بعض(التوقيع);
    }
    دع اسم_مقبس: نص = «مقبس»;
    لو (نصان_متساويان(&الاسم, &اسم_مقبس)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختيار.بعض(التوقيع);
    }
    دع اسم_استماع: نص = «استماع»;
    لو (نصان_متساويان(&الاسم, &اسم_استماع)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختيار.بعض(التوقيع);
    }
    دع اسم_إيقاف_مقبس: نص = «إيقاف_مقبس»;
    لو (نصان_متساويان(&الاسم, &اسم_إيقاف_مقبس)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختيار.بعض(التوقيع);
    }
    دع اسم_أرسل_إشارة_عملية: نص = «أرسل_إشارة_عملية»;
    لو (نصان_متساويان(&الاسم, &اسم_أرسل_إشارة_عملية)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختيار.بعض(التوقيع);
    }
    دع اسم_أغلق_مجال_واصفات: نص = «أغلق_مجال_واصفات»;
    لو (نصان_متساويان(&الاسم, &اسم_أغلق_مجال_واصفات)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختيار.بعض(التوقيع);
    }
    أرجع اختيار.لا_شيء();
}
