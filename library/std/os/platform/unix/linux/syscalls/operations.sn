        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    // recvfrom(fd, buf, len, flags, addr, &addrlen): three writable buffers,
    // so every one is copied back whole (the data buffer is read-write, so
    // its bytes past the datagram keep their contents).
    دع اسم_استقبال_من_عنوان: نص = «استقبال_من_عنوان»;
    إذا (نصان_متساويان(&الاسم, &اسم_استقبال_من_عنوان)) {
        دع دور_الوسيطة_2: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة_وكتابة, حد_ذاكرة_نواة_لينكس.وسيطة(3));
        دع دور_الوسيطة_5: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة_وكتابة, حد_ذاكرة_نواة_لينكس.ثابت(128));
        دع دور_الوسيطة_6: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة_وكتابة, حد_ذاكرة_نواة_لينكس.ثابت(4));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_الوسيطة_2, دور_عدد, دور_عدد, دور_الوسيطة_5, دور_الوسيطة_6];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.كامل_عند_النجاح() };
        أرجع اختياري.موجود(التوقيع);
    }
    // futex(uaddr, op, val, timeout, uaddr2, val3) / _umtx_op(obj, op, val,
    // uaddr1, uaddr2) (std.os.wait_address): the kernel reads the 32-bit
    // cell; the timed forms also read a 16-byte relative timespec. Nothing is
    // copied back. A join passes the tid cell's address as an integer, which
    // leaves that call uncontracted, as clone's.
    دع اسم_مستقبل: نص = «مستقبل»;
    إذا (نصان_متساويان(&الاسم, &اسم_مستقبل)) {
        دع دور_الخلية: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.ثابت(4));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_الخلية, دور_عدد, دور_عدد, دور_عدد, دور_عدد, دور_عدد];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    دع اسم_مستقبل_بمهلة: نص = «مستقبل_بمهلة»;
    إذا (نصان_متساويان(&الاسم, &اسم_مستقبل_بمهلة)) {
        دع دور_الخلية: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.ثابت(4));
        دع دور_المهلة: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.ثابت(16));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_الخلية, دور_عدد, دور_عدد, دور_المهلة, دور_عدد, دور_عدد];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    دع اسم_مستقبل_بمهلة_بي_إس_دي: نص = «مستقبل_بمهلة_بي_إس_دي»;
    إذا (نصان_متساويان(&الاسم, &اسم_مستقبل_بمهلة_بي_إس_دي)) {
        دع دور_الخلية: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.ثابت(4));
        دع دور_المهلة: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(قراءة, حد_ذاكرة_نواة_لينكس.ثابت(16));
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_الخلية, دور_عدد, دور_عدد, دور_عدد, دور_المهلة, دور_عدد];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    // flock(fd, operation): two integers, nothing copied back. The signal
    // calls have no signature: they are marshalled like clone and waitid.
    دع اسم_قفل_ملف: نص = «قفل_ملف»;
    إذا (نصان_متساويان(&الاسم, &اسم_قفل_ملف)) {
        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_عدد, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.بلا_نسخ() };
        أرجع اختياري.موجود(التوقيع);
    }
    أرجع اختياري.لا_شيء();
}
