// The canonical Linux operation is also the sole owner of kernel memory ABI
// signatures. An unlisted operation has no safe flat-memory interpretation.
// Slot indexes are machine ABI positions 1..6 (the syscall number is slot 0).
عام نوع اتجاه_ذاكرة_نواة_لينكس =
    | قراءة
    | كتابة
    | قراءة_وكتابة
;

عام نوع حد_ذاكرة_نواة_لينكس =
    | وسيطة بنوع غير_موقع
    | ثابت بنوع غير_موقع
    | سلسلة_صفرية
;

عام نوع دور_وسيطة_نواة_لينكس =
    | عدد
    | غير_مستخدم
    | مخزن بنوع (اتجاه_ذاكرة_نواة_لينكس, حد_ذاكرة_نواة_لينكس)
;

// A copy-back policy is part of the authenticated operation, not a mask
// supplied by source code. The interpreter must never copy an unproven size.
عام نوع أثر_نتيجة_نواة_لينكس =
    | بلا_نسخ
    | عدد_بايتات_النتيجة
    | كامل_عند_النجاح
    | كامل_عند_المقاطعة
;

عام نوع توقيع_نداء_نواة_لينكس = {
    الأدوار: متجه دور_وسيطة_نواة_لينكس,
    النسخ: أثر_نتيجة_نواة_لينكس
};

