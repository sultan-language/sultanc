        دع الأدوار: متجه دور_وسيطة_نواة_لينكس = [دور_الوسيطة_1, دور_عدد, غير_مستخدم, غير_مستخدم, غير_مستخدم, غير_مستخدم];
        دع التوقيع: توقيع_نداء_نواة_لينكس = { الأدوار: الأدوار, النسخ: أثر_نتيجة_نواة_لينكس.عدد_بايتات_النتيجة() };
        أرجع اختياري.موجود(التوقيع);
    }
    دع اسم_عشوائية_النواة: نص = «عشوائية_النواة»;
    إذا (نصان_متساويان(&الاسم, &اسم_عشوائية_النواة)) {
        دع دور_الوسيطة_1: دور_وسيطة_نواة_لينكس = دور_وسيطة_نواة_لينكس.مخزن(كتابة, حد_ذاكرة_نواة_لينكس.وسيطة(2));
