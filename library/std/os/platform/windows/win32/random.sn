استورد os.error;

// ProcessPrng (bcryptprimitives) is the Windows system CSPRNG entry point
// used by mature runtimes (Go 1.22+, Rust std). It always fills the whole
// buffer and is documented to return TRUE. Linking bcryptprimitives belongs
// to the target's system-library linkage configuration, as for kernel32.
خارجي عرف ProcessPrng(المخزن: *متغير غ8, الحجم: غ64): ص32;

عام عرف املأ_عشوائية_ويندوز(المخزن: &متغير متجه غ8): نتيجة غير_موقع, خطأ_نظام_أصلي {
    دع البايتات: متغير متجه غ8 = *المخزن;
    دع الحجم: غير_موقع = الطول(البايتات) مثل غير_موقع;
    لو (الحجم == 0) { أرجع نتيجة.نجح(0); };
    دع الرمز: ص32 = ProcessPrng(&متغير البايتات[0], الحجم مثل غ64);
    لو (الرمز == 0) {
        // ERROR_GEN_FAILURE (31): ProcessPrng has no failure contract.
        أرجع نتيجة.خطأ(أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.وين32(), 31));
    };
    *المخزن := البايتات;
    أرجع نتيجة.نجح(الحجم);
}
