استورد os.path;
استورد os.error;
استورد encoding.utf16;
استورد os.platform.windows.win32.error;
استورد os.platform.windows.win32.file_handles;
استورد os.platform.windows.win32.file_paths;

// Links, attributes, file sizes, file times and final paths through kernel32
// (MSDN declarations). BOOLEAN is u8; BOOL is i32; DWORD u32; HANDLE u64;
// LARGE_INTEGER i64; FILETIME is a u64 of 100 ns intervals since 1601-01-01.
خارجي «kernel32.dll» عرف CreateSymbolicLinkW(الوصلة: *ط16, الهدف: *ط16, الأعلام: ط32): ط8;
خارجي «kernel32.dll» عرف CreateHardLinkW(الجديد: *ط16, الموجود: *ط16, الحماية: *ط8): ص32;
خارجي «kernel32.dll» عرف SetFileAttributesW(المسار: *ط16, السمات: ط32): ص32;
خارجي «kernel32.dll» عرف DeviceIoControl(
    المقبض: ط64, الرمز: ط32, الداخل: *ط8, طول_الداخل: ط32,
    الخارج: *متغير ط8, طول_الخارج: ط32, المعاد: *متغير ط32, التراكب: *ط8
): ص32;
// FILE_INFO_BY_HANDLE_CLASS FileEndOfFileInfo = 6: FILE_END_OF_FILE_INFO is
// one LARGE_INTEGER.
خارجي «kernel32.dll» عرف SetFileInformationByHandle(
    المقبض: ط64, الصنف: ص32, المعلومات: *ص64, الحجم: ط32
): ص32;
خارجي «kernel32.dll» عرف SetFileTime(
    المقبض: ط64, الإنشاء: *ط64, الوصول: *ط64, التعديل: *ط64
): ص32;
خارجي «kernel32.dll» عرف GetFinalPathNameByHandleW(
    المقبض: ط64, المخزن: *متغير ط16, السعة: ط32, الأعلام: ط32
): ط32;

عام نوع خطأ_سمات_ملف_ويندوز =
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | غير_وصلة
    | نظام بنوع خطأ_نظام_أصلي
;

عرف فشل_سمات_ويندوز(): خطأ_سمات_ملف_ويندوز {
    أرجع خطأ_سمات_ملف_ويندوز.نظام(التقط_خطأ_وين32());
}

عرف مقبض_غير_صالح_ويندوز(): ط64 { أرجع ~(0 مثل ط64); }

// CreateFileW(path, access, FILE_SHARE_READ|WRITE|DELETE, NULL,
// disposition, flags, NULL).
عرف افتح_مقبض_سمات_ويندوز(
    المسار: &نص, الوصول: ط32, الإنشاء: ط32, الأعلام: ط32
): نتيجة ط64, خطأ_سمات_ملف_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه ط16 = الوحدات;
        دع المقبض: ط64 = CreateFileW(
            &متغير الاسم[0], الوصول, 7, الفارغ, الإنشاء, الأعلام, 0
        );
        إذا (المقبض == مقبض_غير_صالح_ويندوز()) { أرجع نتيجة.خطأ(فشل_سمات_ويندوز()); };
        أرجع نتيجة.نجح(المقبض);
    };
}

// The directory a relative symlink target is resolved against: the link's
// parent ("" when the link path has no separator).
عرف أب_وصلة_ويندوز(المسار: &نص): متجه ط8 {
    دع العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    دع الحد: متغير طبيعي = 0;
    دع وجد: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*المسار)[ف] == 0x5C || (*المسار)[ف] == 0x2F) { الحد := ف + 1; وجد := صواب; };
        ف := ف + 1;
    }
    دع الناتج: متغير متجه ط8 = [];
    إذا (!وجد) { أرجع الناتج; };
    ف := 0;
    طالما (ف < الحد) { ألحق(الناتج, (*المسار)[ف]); ف := ف + 1; }
    أرجع الناتج;
}

عرف هدف_مطلق_ويندوز(الهدف: &نص): منطقي {
    دع العدد: طبيعي = الطول(*الهدف) مثل طبيعي;
    إذا (العدد >= 1 && ((*الهدف)[0] == 0x5C || (*الهدف)[0] == 0x2F)) { أرجع صواب; };
    إذا (العدد >= 2 && (*الهدف)[1] == 0x3A) { أرجع صواب; };
    أرجع خطأ;
}

// SYMBOLIC_LINK_FLAG_DIRECTORY (1) when the target, resolved against the
// link's directory, is a directory; SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_
// CREATE (2) lets Developer Mode create links without elevation (Go and
// Rust pass it too).
عام عرف أنشئ_وصلة_رمزية_ويندوز(
    الهدف_المرجعي: &نص, المسار: &نص
): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    دع المحلول: متغير متجه ط8 = [];
    إذا (!هدف_مطلق_ويندوز(الهدف_المرجعي)) { المحلول := أب_وصلة_ويندوز(المسار); };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الهدف_المرجعي) مثل طبيعي)) { ألحق(المحلول, (*الهدف_المرجعي)[ف]); ف := ف + 1; }
    دع نص_المحلول: نص = المحلول مثل نص;
    دع الأعلام: متغير ط32 = 2;
    طابق سمات_مسار_ويندوز(&نص_المحلول) مع
    | نتيجة.خطأ(_) -> {}
    | نتيجة.نجح(السمات) -> {
        إذا (سمات_مسار_ويندوز_دليل(السمات)) { الأعلام := 3; };
    };
    طابق وحدات_مسار_ويندوز_صفرية(الهدف_المرجعي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(وحدات_الهدف) -> {
        طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
        | نتيجة.نجح(وحدات_الوصلة) -> {
            دع الهدف_الواسع: متجه ط16 = وحدات_الهدف;
            دع الوصلة_الواسعة: متجه ط16 = وحدات_الوصلة;
            إذا (CreateSymbolicLinkW(&الوصلة_الواسعة[0], &الهدف_الواسع[0], الأعلام) == 0) {
                أرجع نتيجة.خطأ(فشل_سمات_ويندوز());
            };
            أرجع نتيجة.نجح(0);
        };
    };
}

عرف ط16_من_بايتات_ويندوز(البايتات: &متجه ط8, البداية: طبيعي): طبيعي {
    أرجع ((*البايتات)[البداية] مثل طبيعي) | (((*البايتات)[البداية + 1] مثل طبيعي) << 8);
}

// FSCTL_GET_REPARSE_POINT (0x900A8) on a handle opened with
// FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS. The
// REPARSE_DATA_BUFFER holds the tag at 0 and four u16 name offsets/lengths
// at 8; the path buffer starts at 20 for IO_REPARSE_TAG_SYMLINK
// (0xA000000C, after a u32 Flags) and at 16 for IO_REPARSE_TAG_MOUNT_POINT
// (0xA0000003). The print name is returned; when it is empty the substitute
// name is, without its NT "\??\" prefix.
عام عرف اقرأ_وصلة_رمزية_ويندوز(
    المسار: &نص
): نتيجة نص, خطأ_سمات_ملف_ويندوز {
    طابق افتح_مقبض_سمات_ويندوز(المسار, 0, 3, 0x02200000) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع المخزن: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < 16384) { ألحق(المخزن, 0 مثل ط8); ف := ف + 1; }
        دع المعاد: متغير ط32 = 0;
        دع الحالة: ص32 = DeviceIoControl(
            المقبض, 0x000900A8, الفارغ, 0, &متغير المخزن[0], 16384, &متغير المعاد, الفارغ
        );
        دع الخطأ: خطأ_سمات_ملف_ويندوز = فشل_سمات_ويندوز();
        دع الإغلاق: ص32 = CloseHandle(المقبض);
        إذا (الحالة == 0) { أرجع نتيجة.خطأ(الخطأ); };
        إذا (المعاد < 20) { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.غير_وصلة()); };
        دع الوسم: ط32 = (المخزن[0] مثل ط32) | ((المخزن[1] مثل ط32) << 8)
            | ((المخزن[2] مثل ط32) << 16) | ((المخزن[3] مثل ط32) << 24);
        دع بداية_المسارات: متغير طبيعي = 0;
        إذا (الوسم == 0xA000000C) { بداية_المسارات := 20; }
        وإلا إذا (الوسم == 0xA0000003) { بداية_المسارات := 16; }
        وإلا { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.غير_وصلة()); };
        دع إزاحة_البديل: طبيعي = ط16_من_بايتات_ويندوز(&المخزن, 8);
        دع طول_البديل: طبيعي = ط16_من_بايتات_ويندوز(&المخزن, 10);
        دع إزاحة_العرض: طبيعي = ط16_من_بايتات_ويندوز(&المخزن, 12);
        دع طول_العرض: طبيعي = ط16_من_بايتات_ويندوز(&المخزن, 14);
        دع الإزاحة: متغير طبيعي = إزاحة_العرض;
        دع الطول_بالبايت: متغير طبيعي = طول_العرض;
        إذا (طول_العرض == 0) { الإزاحة := إزاحة_البديل; الطول_بالبايت := طول_البديل; };
        دع البداية: طبيعي = بداية_المسارات + الإزاحة;
        إذا (البداية + الطول_بالبايت > (المعاد مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح());
        };
        دع الوحدات: متغير متجه ط16 = [];
        ف := 0;
        طالما (ف + 1 < الطول_بالبايت) {
            ألحق(الوحدات, ط16_من_بايتات_ويندوز(&المخزن, البداية + ف) مثل ط16);
            ف := ف + 2;
        }
        // "\??\" (0x5C 0x3F 0x3F 0x5C) only prefixes NT substitute names.
        إذا (طول_العرض == 0 && (الطول(الوحدات) مثل طبيعي) >= 4
            && الوحدات[0] == 0x5C && الوحدات[1] == 0x3F && الوحدات[2] == 0x3F && الوحدات[3] == 0x5C) {
            دع المقتطع: متغير متجه ط16 = [];
            ف := 4;
            طالما (ف < (الطول(الوحدات) مثل طبيعي)) { ألحق(المقتطع, الوحدات[ف]); ف := ف + 1; }
            الوحدات := المقتطع;
        };
        طابق يوتيف16_إلى_نص(&الوحدات) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح()); }
        | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
    };
}

عام عرف أنشئ_وصلة_صلبة_ويندوز(
    الأصل: &نص, المسار: &نص
): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(الأصل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(وحدات_الأصل) -> {
        طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
        | نتيجة.نجح(وحدات_المسار) -> {
            دع الموجود: متجه ط16 = وحدات_الأصل;
            دع الجديد: متجه ط16 = وحدات_المسار;
            إذا (CreateHardLinkW(&الجديد[0], &الموجود[0], الفارغ) == 0) {
                أرجع نتيجة.خطأ(فشل_سمات_ويندوز());
            };
            أرجع نتيجة.نجح(0);
        };
    };
}

// Windows has one permission bit, FILE_ATTRIBUTE_READONLY (1): it is set
// when the owner-write bit (0o200) is clear, as in Go and Rust.
عام عرف اضبط_أذونات_مسار_ويندوز(
    المسار: &نص, الوضع: ط64
): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    طابق سمات_مسار_ويندوز(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(فشل_سمات_ويندوز()); }
    | نتيجة.نجح(السمات) -> {
        دع الجديدة: متغير ط32 = السمات & (~(1 مثل ط32));
        إذا ((الوضع & 0x80) == 0) { الجديدة := الجديدة | 1; };
        // FILE_ATTRIBUTE_NORMAL (0x80) stands alone for "no attributes".
        إذا (الجديدة == 0) { الجديدة := 0x80; };
        طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.مسار(الخطأ)); }
        | نتيجة.نجح(الوحدات) -> {
            دع الاسم: متجه ط16 = الوحدات;
            إذا (SetFileAttributesW(&الاسم[0], الجديدة) == 0) { أرجع نتيجة.خطأ(فشل_سمات_ويندوز()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

// Go's Windows FileMode: 0o444 when read-only, else 0o666; directories add
// the search bits 0o111.
عام عرف اقرأ_أذونات_مسار_ويندوز(المسار: &نص): نتيجة ط64, خطأ_سمات_ملف_ويندوز {
    طابق سمات_مسار_ويندوز(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(فشل_سمات_ويندوز()); }
    | نتيجة.نجح(السمات) -> {
        دع الوضع: متغير ط64 = 0x1b6;
        إذا ((السمات & 1) != 0) { الوضع := 0x124; };
        إذا (سمات_مسار_ويندوز_دليل(السمات)) { الوضع := الوضع | 0x49; };
        أرجع نتيجة.نجح(الوضع);
    };
}

// SetFileInformationByHandle(FileEndOfFileInfo) sets the size without moving
// the file pointer.
عام عرف اقتطع_مقبض_ويندوز(المقبض: ط64, الطول: ط64): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    إذا (الطول > 0x7fffffffffffffff) { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح()); };
    دع الحجم: متجه ص64 = [الطول مثل ص64];
    إذا (SetFileInformationByHandle(المقبض, 6, &الحجم[0], 8) == 0) {
        أرجع نتيجة.خطأ(فشل_سمات_ويندوز());
    };
    أرجع نتيجة.نجح(0);
}

// GENERIC_WRITE (0x40000000), OPEN_EXISTING (3), FILE_ATTRIBUTE_NORMAL.
عام عرف اقتطع_مسار_ويندوز(المسار: &نص, الطول: ط64): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    طابق افتح_مقبض_سمات_ويندوز(المسار, 0x40000000, 3, 0x80) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع النتيجة: نتيجة عدد, خطأ_سمات_ملف_ويندوز = اقتطع_مقبض_ويندوز(المقبض, الطول);
        دع الإغلاق: ص32 = CloseHandle(المقبض);
        أرجع النتيجة;
    };
}

// FILETIME from Unix seconds and nanoseconds: 100 ns units since 1601.
عرف وقت_ملف_ويندوز(الثواني: ص64, النانو: ط64): ط64 {
    أرجع ((الثواني + 11644473600) * 10000000 + ((النانو / 100) مثل ص64)) مثل ط64;
}

// FILE_WRITE_ATTRIBUTES (0x100) with FILE_FLAG_BACKUP_SEMANTICS so that
// directories open too; the creation time is left unchanged (NULL).
عام عرف اضبط_أوقات_مسار_ويندوز(
    المسار: &نص, ثواني_الوصول: ص64, نانو_الوصول: ط64,
    ثواني_التعديل: ص64, نانو_التعديل: ط64
): نتيجة عدد, خطأ_سمات_ملف_ويندوز {
    إذا (نانو_الوصول >= 1000000000 || نانو_التعديل >= 1000000000
        || ثواني_الوصول < -11644473600 || ثواني_التعديل < -11644473600) {
        أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح());
    };
    طابق افتح_مقبض_سمات_ويندوز(المسار, 0x100, 3, 0x02000000) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع الأوقات: متغير متجه ط64 = [];
        ألحق(الأوقات, وقت_ملف_ويندوز(ثواني_الوصول, نانو_الوصول));
        ألحق(الأوقات, وقت_ملف_ويندوز(ثواني_التعديل, نانو_التعديل));
        دع الحالة: ص32 = SetFileTime(المقبض, الفارغ, &الأوقات[0], &الأوقات[1]);
        دع الخطأ: خطأ_سمات_ملف_ويندوز = فشل_سمات_ويندوز();
        دع الإغلاق: ص32 = CloseHandle(المقبض);
        إذا (الحالة == 0) { أرجع نتيجة.خطأ(الخطأ); };
        أرجع نتيجة.نجح(0);
    };
}

// GENERIC_READ|GENERIC_WRITE, CREATE_NEW (1): fails if the path exists.
عام عرف أنشئ_ملفا_جديدا_ويندوز(المسار: &نص): نتيجة ط64, خطأ_سمات_ملف_ويندوز {
    أرجع افتح_مقبض_سمات_ويندوز(المسار, 0xC0000000, 1, 0x80);
}

// GENERIC_WRITE, OPEN_EXISTING: an existing file, not truncated.
عام عرف افتح_ملفا_للتعديل_ويندوز(المسار: &نص): نتيجة ط64, خطأ_سمات_ملف_ويندوز {
    أرجع افتح_مقبض_سمات_ويندوز(المسار, 0x40000000, 3, 0x80);
}

// GetFinalPathNameByHandleW(FILE_NAME_NORMALIZED | VOLUME_NAME_DOS) on a
// handle opened with FILE_FLAG_BACKUP_SEMANTICS (directories too). The
// "\\?\" prefix is removed from a drive path and "\\?\UNC\" becomes "\\".
عام عرف المسار_النهائي_ويندوز(المسار: &نص): نتيجة نص, خطأ_سمات_ملف_ويندوز {
    طابق افتح_مقبض_سمات_ويندوز(المسار, 0, 3, 0x02000000) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع السعة: متغير ط32 = 512;
        دع المحاولة: متغير طبيعي = 0;
        طالما (المحاولة < 4) {
            دع المخزن: متغير متجه ط16 = [];
            دع ف: متغير طبيعي = 0;
            طالما (ف < (السعة مثل طبيعي)) { ألحق(المخزن, 0 مثل ط16); ف := ف + 1; }
            دع المكتوب: ط32 = GetFinalPathNameByHandleW(المقبض, &متغير المخزن[0], السعة, 0);
            إذا (المكتوب == 0) {
                دع الخطأ: خطأ_سمات_ملف_ويندوز = فشل_سمات_ويندوز();
                دع الإغلاق: ص32 = CloseHandle(المقبض);
                أرجع نتيجة.خطأ(الخطأ);
            };
            إذا (المكتوب < السعة) {
                دع الإغلاق: ص32 = CloseHandle(المقبض);
                دع البداية: متغير طبيعي = 0;
                دع الوحدات: متغير متجه ط16 = [];
                دع العدد: طبيعي = المكتوب مثل طبيعي;
                إذا (العدد >= 6 && المخزن[0] == 0x5C && المخزن[1] == 0x5C && المخزن[2] == 0x3F
                    && المخزن[3] == 0x5C && المخزن[5] == 0x3A) {
                    البداية := 4;
                } وإلا إذا (العدد >= 8 && المخزن[0] == 0x5C && المخزن[1] == 0x5C && المخزن[2] == 0x3F
                    && المخزن[3] == 0x5C && المخزن[4] == 0x55 && المخزن[5] == 0x4E
                    && المخزن[6] == 0x43 && المخزن[7] == 0x5C) {
                    ألحق(الوحدات, 0x5C);
                    البداية := 7;
                };
                ف := البداية;
                طالما (ف < العدد) { ألحق(الوحدات, المخزن[ف]); ف := ف + 1; }
                طابق يوتيف16_إلى_نص(&الوحدات) مع
                | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح()); }
                | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
            };
            السعة := المكتوب + 1;
            المحاولة := المحاولة + 1;
        }
        دع الإغلاق_الأخير: ص32 = CloseHandle(المقبض);
        أرجع نتيجة.خطأ(خطأ_سمات_ملف_ويندوز.نطاق_غير_صالح());
    };
}
