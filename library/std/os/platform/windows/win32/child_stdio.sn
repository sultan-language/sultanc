استورد os.path;
استورد os.error;
استورد encoding.utf16;
استورد os.platform.windows.win32.error;
استورد os.platform.windows.win32.clocks;
استورد os.platform.windows.win32.file_handles;
استورد os.platform.windows.win32.process_control;

// A child's standard streams, working directory and environment through
// kernel32 (MSDN declarations). Pipes are anonymous and not inheritable;
// the child's three handles are inheritable duplicates made just for
// CreateProcessW (STARTF_USESTDHANDLES), named in its handle list (the only
// handles it inherits) and closed right after it.
خارجي «kernel32.dll» عرف CreatePipe(القارئ: *متغير ط64, الكاتب: *متغير ط64, الحماية: *ط8, الحجم: ط32): ص32;
خارجي «kernel32.dll» عرف PeekNamedPipe(
    المقبض: ط64, المخزن: *متغير ط8, الحجم: ط32, المقروء: *متغير ط32,
    المتاح: *متغير ط32, الباقي: *متغير ط32
): ص32;
خارجي «kernel32.dll» عرف DuplicateHandle(
    العملية_المصدر: ط64, المقبض: ط64, العملية_الهدف: ط64, الناتج: *متغير ط64,
    الوصول: ط32, الوراثة: ص32, الخيارات: ط32
): ص32;

// The child inherits its three standard handles and nothing else: a
// PROC_THREAD_ATTRIBUTE_HANDLE_LIST in STARTUPINFOEXW names them, as Go's
// os/exec does (syscall.StartProcess), so an inheritable handle another
// part of the process made at the same time does not leak into the child.
// The attribute list is opaque and sized by the system; it is allocated
// from the process heap and passed by address. UpdateProcThreadAttribute
// keeps a pointer to the handle array until the list is deleted, so the
// array lives in the same heap block, right after the list, copied there
// with RtlMoveMemory (a stack or SultanC copy could move or, in the
// interpreter, be a temporary host copy).
خارجي «kernel32.dll» عرف GetProcessHeap(): ط64;
خارجي «kernel32.dll» عرف HeapAlloc(الكومة: ط64, الأعلام: ط32, الحجم: ط64): ط64;
خارجي «kernel32.dll» عرف HeapFree(الكومة: ط64, الأعلام: ط32, الذاكرة: ط64): ص32;
خارجي «kernel32.dll» عرف InitializeProcThreadAttributeList(
    القائمة: ط64, العدد: ط32, الأعلام: ط32, الحجم: *متغير ط64
): ص32;
خارجي «kernel32.dll» عرف UpdateProcThreadAttribute(
    القائمة: ط64, الأعلام: ط32, السمة: ط64, القيمة: ط64, الحجم: ط64,
    السابقة: *ط8, الحجم_المعاد: *ط8
): ص32;
خارجي «kernel32.dll» عرف DeleteProcThreadAttributeList(القائمة: ط64): فراغ;
// VOID RtlMoveMemory(VOID *Destination, const VOID *Source, SIZE_T Length).
خارجي «kernel32.dll» عرف RtlMoveMemory(الوجهة: ط64, المصدر: *ط64, الطول: ط64): فراغ;

عرف فشل_ويندوز_حالي(): خطأ_عملية_ويندوز {
    أرجع خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32());
}

عام عرف أنشئ_قناة_ويندوز(): نتيجة متجه ط64, خطأ_عملية_ويندوز {
    دع القارئ: متغير ط64 = 0;
    دع الكاتب: متغير ط64 = 0;
    إذا (CreatePipe(&متغير القارئ, &متغير الكاتب, الفارغ, 0) == 0) {
        أرجع نتيجة.خطأ(فشل_ويندوز_حالي());
    };
    دع الناتج: متغير متجه ط64 = [];
    ألحق(الناتج, القارئ);
    ألحق(الناتج, الكاتب);
    أرجع نتيجة.نجح(الناتج);
}

// CreateFileW("NUL", GENERIC_READ|GENERIC_WRITE, FILE_SHARE_READ|WRITE,
// NULL, OPEN_EXISTING, 0, NULL).
عام عرف افتح_الجهاز_الفارغ_ويندوز(): نتيجة ط64, خطأ_عملية_ويندوز {
    دع الاسم: متغير متجه ط16 = [78, 85, 76, 0];
    دع المقبض: ط64 = CreateFileW(&متغير الاسم[0], 0xC0000000, 3, الفارغ, 3, 0, 0);
    إذا (المقبض == ~(0 مثل ط64)) { أرجع نتيجة.خطأ(فشل_ويندوز_حالي()); };
    أرجع نتيجة.نجح(المقبض);
}

// ReadFile; a write end closed by the child (ERROR_BROKEN_PIPE, 109) is
// the end of the stream, read as 0 bytes.
عام عرف اقرأ_قناة_ويندوز(
    المقبض: ط64, المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_عملية_ويندوز {
    إذا (الإزاحة < 0 || المطلوب < 0 || الإزاحة + المطلوب > (الطول(*المخزن) مثل عدد)) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المقروء: متغير ط32 = 0;
    إذا (ReadFile(المقبض, &متغير (*المخزن)[الإزاحة مثل طبيعي], الطلب مثل ط32, &متغير المقروء, الفارغ) == 0) {
        دع الخطأ: خطأ_نظام_أصلي = التقط_خطأ_وين32();
        إذا (الخطأ.الرمز == 109) { أرجع نتيجة.نجح(0); };
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(الخطأ));
    };
    أرجع نتيجة.نجح(المقروء مثل عدد);
}

// Anonymous pipes cannot be waited on together without threads or
// overlapped I/O, so PeekNamedPipe is polled with a 1 ms sleep between
// rounds. A handle is ready when it has bytes or PeekNamedPipe fails (the
// pipe was closed: the read that follows reports the end).
عام عرف انتظر_قنوات_ويندوز(المقابض: &متجه ط64): نتيجة متجه منطقي, خطأ_عملية_ويندوز {
    دع العدد: طبيعي = الطول(*المقابض) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح()); };
    طالما (صواب) {
        دع الجاهزة: متغير متجه منطقي = [];
        دع أي_جاهز: متغير منطقي = خطأ;
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            دع المتاح: متغير ط32 = 0;
            دع جاهز: متغير منطقي = خطأ;
            إذا (PeekNamedPipe((*المقابض)[ف], الفارغ, 0, الفارغ, &متغير المتاح, الفارغ) == 0) {
                جاهز := صواب;
            } وإلا إذا (المتاح > 0) {
                جاهز := صواب;
            };
            إذا (جاهز) { أي_جاهز := صواب; };
            ألحق(الجاهزة, جاهز);
            ف := ف + 1;
        }
        إذا (أي_جاهز) { أرجع نتيجة.نجح(الجاهزة); };
        Sleep(1);
    }
    دع لا_شيء: متجه منطقي = [];
    أرجع نتيجة.نجح(لا_شيء);
}

عرف ألحق_وحدات_بايتات_ويندوز(البايتات: &متغير متجه ط8, الوحدات: &متجه ط16): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوحدات) مثل طبيعي)) {
        ألحق(*البايتات, ((*الوحدات)[ف] & 255) مثل ط8);
        ألحق(*البايتات, ((*الوحدات)[ف] >> 8) مثل ط8);
        ف := ف + 1;
    }
}

// An argument is quoted (ألحق_وسيطة_عملية_ويندوز) only when it is empty or
// holds a space, tab, newline or '"', as Rust's std does: programs with
// their own parser, cmd.exe first of all, read a bare word as written.
عرف ألحق_وسيطة_عند_الحاجة_ويندوز(السطر: &متغير متجه ط16, الوسيطة: &متجه ط16): منطقي {
    دع يحتاج: متغير منطقي = (الطول(*الوسيطة) مثل طبيعي) == 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الوسيطة) مثل طبيعي)) {
        دع الوحدة: ط16 = (*الوسيطة)[ف];
        إذا (الوحدة == 0x20 || الوحدة == 0x09 || الوحدة == 0x0A || الوحدة == 0x22) { يحتاج := صواب; };
        ف := ف + 1;
    }
    إذا (يحتاج) { أرجع ألحق_وسيطة_عملية_ويندوز(السطر, الوسيطة); };
    إذا ((الطول(*السطر) مثل طبيعي) + (الطول(*الوسيطة) مثل طبيعي) >= 32766) { أرجع خطأ; };
    ف := 0;
    طالما (ف < (الطول(*الوسيطة) مثل طبيعي)) { ألحق(*السطر, (*الوسيطة)[ف]); ف := ف + 1; }
    أرجع صواب;
}

// The program name is always quoted; the arguments when they need it. A
// program name without a path separator is searched by CreateProcessW
// (application directory, current directory, system directories, PATH);
// one with a separator is used as given. البيئة, when مخصصة, is the whole
// child environment as a CREATE_UNICODE_ENVIRONMENT (0x400) block.
// القياسية holds a handle for each of the child's standard input, output
// and error, or ~0 for the parent's own (GetStdHandle).
عام عرف شغل_عملية_ويندوز_بإعداد(
    البرنامج: &نص, الوسائط: &متجه نص, البيئة: &متجه نص, بيئة_مخصصة: منطقي,
    القياسية: &متجه ط64, الدليل: &نص
): نتيجة عملية_ويندوز, خطأ_عملية_ويندوز {
    إذا (الطول(*البرنامج) == 0 || !مسار_نظام_بلا_صفر_مدمج(البرنامج) || (الطول(*القياسية) مثل طبيعي) != 3) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
    };
    دع فيه_فاصل: متغير منطقي = خطأ;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*البرنامج) مثل طبيعي)) {
        إذا ((*البرنامج)[ف] == 0x5C || (*البرنامج)[ف] == 0x2F) { فيه_فاصل := صواب; };
        ف := ف + 1;
    }
    دع السطر: متغير متجه ط16 = [];
    دع الاسم: متغير متجه ط16 = [];
    طابق نص_إلى_يوتيف16(البرنامج) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(الوحدات) -> {
        إذا (!ألحق_وسيطة_عملية_ويندوز(&متغير السطر, &الوحدات)) {
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
        };
        الاسم := الوحدات;
        ألحق(الاسم, 0 مثل ط16);
    };
    ف := 0;
    طالما (ف < (الطول(*الوسائط) مثل طبيعي)) {
        إذا (!مسار_نظام_بلا_صفر_مدمج(&(*الوسائط)[ف])) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح()); };
        طابق نص_إلى_يوتيف16(&(*الوسائط)[ف]) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
        | نتيجة.نجح(الوحدات) -> {
            ألحق(السطر, 0x20 مثل ط16);
            إذا (!ألحق_وسيطة_عند_الحاجة_ويندوز(&متغير السطر, &الوحدات)) {
                أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
            };
        };
        ف := ف + 1;
    }
    إذا ((الطول(السطر) مثل طبيعي) >= 32767) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح()); };
    ألحق(السطر, 0 مثل ط16);
    دع الكتلة: متغير متجه ط8 = [];
    دع الأعلام: متغير ط32 = 0;
    إذا (بيئة_مخصصة) {
        الأعلام := 0x400;
        ف := 0;
        طالما (ف < (الطول(*البيئة) مثل طبيعي)) {
            إذا (!مسار_نظام_بلا_صفر_مدمج(&(*البيئة)[ف])) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح()); };
            طابق نص_إلى_يوتيف16(&(*البيئة)[ف]) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
            | نتيجة.نجح(الوحدات) -> { ألحق_وحدات_بايتات_ويندوز(&متغير الكتلة, &الوحدات); };
            ألحق(الكتلة, 0 مثل ط8);
            ألحق(الكتلة, 0 مثل ط8);
            ف := ف + 1;
        }
        // An empty block still needs its two terminating NUL units.
        إذا ((الطول(*البيئة) مثل طبيعي) == 0) { ألحق(الكتلة, 0 مثل ط8); ألحق(الكتلة, 0 مثل ط8); };
        ألحق(الكتلة, 0 مثل ط8);
        ألحق(الكتلة, 0 مثل ط8);
    } وإلا {
        ألحق(الكتلة, 0 مثل ط8);
    };
    دع الدليل_الواسع: متغير متجه ط16 = [0];
    دع له_دليل: منطقي = الطول(*الدليل) > 0;
    إذا (له_دليل) {
        طابق وحدات_مسار_ويندوز_صفرية(الدليل) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
        | نتيجة.نجح(الوحدات) -> { الدليل_الواسع := الوحدات; };
    };
    // Inheritable duplicates (DUPLICATE_SAME_ACCESS = 2) of the three
    // handles; the current-process pseudo handle is ~0.
    دع المكررة: متغير متجه ط64 = [0, 0, 0];
    دع القياسي_الأصلي: متجه ط32 = [0xFFFFFFF6, 0xFFFFFFF5, 0xFFFFFFF4];
    ف := 0;
    دع فشل_التكرار: متغير اختياري خطأ_عملية_ويندوز = اختياري.لا_شيء();
    طالما (ف < 3) {
        دع المصدر: متغير ط64 = (*القياسية)[ف];
        إذا (المصدر == ~(0 مثل ط64)) { المصدر := GetStdHandle(القياسي_الأصلي[ف]); };
        إذا (المصدر != 0 && المصدر != ~(0 مثل ط64)) {
            دع الناتج: متغير ط64 = 0;
            إذا (DuplicateHandle(~(0 مثل ط64), المصدر, ~(0 مثل ط64), &متغير الناتج, 0, 1, 2) == 0) {
                فشل_التكرار := اختياري.موجود(فشل_ويندوز_حالي());
            } وإلا {
                المكررة[ف] := الناتج;
            };
        };
        ف := ف + 1;
    }
    // The handles the child may inherit (HANDLE_LIST takes no duplicates;
    // each of the three is its own duplicate).
    دع الموروثة: متغير متجه ط64 = [];
    ف := 0;
    طالما (ف < 3) {
        إذا (المكررة[ف] != 0) { ألحق(الموروثة, المكررة[ف]); };
        ف := ف + 1;
    }
    // STARTUPINFOEXW: STARTUPINFOW (104 bytes) and lpAttributeList (112).
    دع البدء: متغير متجه ط64 = [];
    ف := 0;
    طالما (ف < 14) { ألحق(البدء, 0 مثل ط64); ف := ف + 1; }
    البدء[0] := 104;
    البدء[7] := (0x100 مثل ط64) << 32;
    البدء[10] := المكررة[0];
    البدء[11] := المكررة[1];
    البدء[12] := المكررة[2];
    دع المعلومات: متغير متجه ط64 = [0, 0, 0];
    دع الحالة: متغير ص32 = 0;
    دع خطأ_التشغيل: متغير اختياري خطأ_عملية_ويندوز = فشل_التكرار;
    دع الكومة: ط64 = GetProcessHeap();
    دع القائمة: متغير ط64 = 0;
    دع القائمة_مهيأة: متغير منطقي = خطأ;
    دع الوراثة: متغير ص32 = 0;
    طابق خطأ_التشغيل مع
    | اختياري.موجود(_) -> {}
    | اختياري.لا_شيء -> {
        إذا ((الطول(الموروثة) مثل طبيعي) > 0) {
            // The first call reports the size (and fails with
            // ERROR_INSUFFICIENT_BUFFER); EXTENDED_STARTUPINFO_PRESENT is
            // 0x80000, PROC_THREAD_ATTRIBUTE_HANDLE_LIST 0x20002.
            دع الحجم: متغير ط64 = 0;
            دع الاستعلام: ص32 = InitializeProcThreadAttributeList(0, 1, 0, &متغير الحجم);
            // The list, rounded up to 8 bytes, then the handle array.
            دع إزاحة_المقابض: ط64 = ((الحجم + 7) / 8) * 8;
            دع حجم_المقابض: ط64 = ((الطول(الموروثة) مثل طبيعي) * 8) مثل ط64;
            إذا (الحجم > 0) { القائمة := HeapAlloc(الكومة, 0, إزاحة_المقابض + حجم_المقابض); };
            إذا (القائمة == 0) {
                خطأ_التشغيل := اختياري.موجود(فشل_ويندوز_حالي());
            } وإلا إذا (InitializeProcThreadAttributeList(القائمة, 1, 0, &متغير الحجم) == 0) {
                خطأ_التشغيل := اختياري.موجود(فشل_ويندوز_حالي());
            } وإلا {
                القائمة_مهيأة := صواب;
                RtlMoveMemory(القائمة + إزاحة_المقابض, &الموروثة[0], حجم_المقابض);
                إذا (UpdateProcThreadAttribute(
                    القائمة, 0, 0x20002, القائمة + إزاحة_المقابض, حجم_المقابض,
                    الفارغ, الفارغ
                ) == 0) {
                    خطأ_التشغيل := اختياري.موجود(فشل_ويندوز_حالي());
                } وإلا {
                    البدء[0] := 112;
                    البدء[13] := القائمة;
                    الأعلام := الأعلام | 0x80000;
                    الوراثة := 1;
                };
            };
        };
    };
    طابق خطأ_التشغيل مع
    | اختياري.موجود(_) -> {}
    | اختياري.لا_شيء -> {
        دع مؤشر_الاسم: متغير *ط16 = الفارغ;
        إذا (فيه_فاصل) { مؤشر_الاسم := &الاسم[0]; };
        دع مؤشر_البيئة: متغير *ط8 = الفارغ;
        إذا (بيئة_مخصصة) { مؤشر_البيئة := &الكتلة[0]; };
        دع مؤشر_الدليل: متغير *ط16 = الفارغ;
        إذا (له_دليل) { مؤشر_الدليل := &الدليل_الواسع[0]; };
        الحالة := CreateProcessW(
            مؤشر_الاسم, &متغير السطر[0], الفارغ, الفارغ, الوراثة, الأعلام,
            مؤشر_البيئة, مؤشر_الدليل, &متغير البدء[0], &متغير المعلومات[0]
        );
        إذا (الحالة == 0) { خطأ_التشغيل := اختياري.موجود(فشل_ويندوز_حالي()); };
    };
    إذا (القائمة_مهيأة) { DeleteProcThreadAttributeList(القائمة); };
    إذا (القائمة != 0) { دع التحرير: ص32 = HeapFree(الكومة, 0, القائمة); };
    ف := 0;
    طالما (ف < 3) {
        إذا (المكررة[ف] != 0) { دع الإغلاق: ص32 = CloseHandle(المكررة[ف]); };
        ف := ف + 1;
    }
    طابق خطأ_التشغيل مع
    | اختياري.موجود(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | اختياري.لا_شيء -> {};
    دع العملية: عملية_ويندوز = {
        مقبض_العملية: المعلومات[0], مقبض_الخيط: المعلومات[1],
        مفتوحة: صواب, خيط_مفتوح: صواب
    };
    أرجع نتيجة.نجح(العملية);
}

// WriteFile to a pipe. A reader that closed its end gives ERROR_NO_DATA
// (232) or ERROR_BROKEN_PIPE (109), reported as they are: Windows raises
// no signal.
عام عرف اكتب_قناة_ويندوز(
    المقبض: ط64, المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_عملية_ويندوز {
    إذا (الإزاحة < 0 || المطلوب < 0 || الإزاحة + المطلوب > (الطول(*المحتوى) مثل عدد)) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
    };
    إذا (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع الطلب: متغير عدد = المطلوب;
    إذا (الطلب > 0x7fffffff) { الطلب := 0x7fffffff; };
    دع المكتوب: متغير ط32 = 0;
    إذا (WriteFile(المقبض, &(*المحتوى)[الإزاحة مثل طبيعي], الطلب مثل ط32, &متغير المكتوب, الفارغ) == 0) {
        أرجع نتيجة.خطأ(فشل_ويندوز_حالي());
    };
    أرجع نتيجة.نجح(المكتوب مثل عدد);
}
