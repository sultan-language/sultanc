استورد os.error;
استورد os.path;
استورد os.buffer;
استورد os.platform.windows.win32.error;

// Windows file HANDLEs are not Unix descriptors or Winsock SOCKETs.
// Direct Windows system API calls; no C runtime library is involved.
// This module is only valid for the registered 64-bit Windows targets.
// CreateFileW uses UTF-16 paths and returns INVALID_HANDLE_VALUE on failure.
// Flags are the documented Win32 GENERIC_READ/WRITE, FILE_SHARE_READ,
// OPEN_EXISTING/CREATE_ALWAYS, and FILE_ATTRIBUTE_NORMAL constants.
عام خارجي «kernel32.dll» عرف GetStdHandle(التيار: ط32): ط64;
عام خارجي «kernel32.dll» عرف CreateFileW(
    المسار: *ط16, الوصول: ط32, المشاركة: ط32, الحماية: *ط8,
    الإنشاء: ط32, السمات: ط32, القالب: ط64
): ط64;
عام خارجي «kernel32.dll» عرف ReadFile(
    المقبض: ط64, المخزن: *متغير ط8, الحجم: ط32,
    المقروء: *متغير ط32, التراكب: *ط8
): ص32;
عام خارجي «kernel32.dll» عرف WriteFile(
    المقبض: ط64, المخزن: *ط8, الحجم: ط32,
    المكتوب: *متغير ط32, التراكب: *ط8
): ص32;
عام خارجي «kernel32.dll» عرف CloseHandle(المقبض: ط64): ص32;
خارجي «kernel32.dll» عرف FlushFileBuffers(المقبض: ط64): ص32;
خارجي «kernel32.dll» عرف GetFileTime(
    المقبض: ط64, الإنشاء: *ط64, الوصول: *ط64, التعديل: *متغير ط64
): ص32;
خارجي «kernel32.dll» عرف GetFileSizeEx(المقبض: ط64, الحجم: *متغير ص64): ص32;
خارجي «kernel32.dll» عرف SetFilePointerEx(
    المقبض: ط64, المسافة: ص64, الموضع: *متغير ص64, المرجع: ط32
): ص32;

عام نوع خطأ_مقبض_ملف_ويندوز =
    | مقبض_مغلق
    | مسار بنوع خطأ_مسار_نظام
    | نطاق_غير_صالح
    | كتابة_بلا_تقدم
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع مقبض_ملف_ويندوز = {
    القيمة: ط64,
    مفتوح: منطقي
};

// Ownership is handed to this structure by a successful Win32 file-open
// operation; do not construct this record from an arbitrary integer.
عام عرف تبن_مقبض_ملف_ويندوز(
    المقبض: ط64
): مقبض_ملف_ويندوز {
    دع الملف: مقبض_ملف_ويندوز = { القيمة: المقبض, مفتوح: صواب };
    أرجع الملف;
}

عرف خطأ_عملية_ملف_ويندوز(): خطأ_مقبض_ملف_ويندوز {
    أرجع خطأ_مقبض_ملف_ويندوز.نظام(التقط_خطأ_وين32());
}

عام عرف حجم_ملف_ويندوز(
    الملف: &مقبض_ملف_ويندوز
): نتيجة ص64, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    دع الحجم: متغير ص64 = 0;
    دع الحالة: ص32 = GetFileSizeEx((*الملف).القيمة, &متغير الحجم);
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    أرجع نتيجة.نجح(الحجم);
}

عام نوع مرجع_موضع_ملف_ويندوز =
    | البداية
    | الحالي
    | النهاية
;

عرف رقم_مرجع_موضع_ملف_ويندوز(المرجع: مرجع_موضع_ملف_ويندوز): ط32 {
    طابق المرجع مع
    | مرجع_موضع_ملف_ويندوز.البداية -> { أرجع 0; } // FILE_BEGIN
    | مرجع_موضع_ملف_ويندوز.الحالي -> { أرجع 1; }  // FILE_CURRENT
    | مرجع_موضع_ملف_ويندوز.النهاية -> { أرجع 2; }; // FILE_END
}

عام عرف حرك_مؤشر_ملف_ويندوز(
    الملف: &مقبض_ملف_ويندوز, المسافة: ص64, المرجع: مرجع_موضع_ملف_ويندوز
): نتيجة ص64, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    دع الموضع: متغير ص64 = 0;
    دع الحالة: ص32 = SetFilePointerEx(
        (*الملف).القيمة, المسافة, &متغير الموضع,
        رقم_مرجع_موضع_ملف_ويندوز(المرجع)
    );
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    أرجع نتيجة.نجح(الموضع);
}

عام عرف زامن_ملف_ويندوز(
    الملف: &مقبض_ملف_ويندوز
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    دع الحالة: ص32 = FlushFileBuffers((*الملف).القيمة);
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    أرجع نتيجة.نجح(0);
}

عام عرف أغلق_ملف_ويندوز(
    الملف: &متغير مقبض_ملف_ويندوز
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    دع الحالة: ص32 = CloseHandle((*الملف).القيمة);
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    (*الملف).مفتوح := خطأ;
    أرجع نتيجة.نجح(0);
}

// These handles are synchronous: no FILE_FLAG_OVERLAPPED is requested.
// The returned HANDLE belongs to the caller and must be closed once.
عام عرف افتح_ملف_ويندوز_للقراءة(
    المسار: &نص
): نتيجة مقبض_ملف_ويندوز, خطأ_مقبض_ملف_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه ط16 = الوحدات;
        // FILE_SHARE_READ | WRITE | DELETE (7), Rust's default share mode
        // (OpenOptions::share_mode): other processes may open the file
        // too, which std.fs.lock relies on.
        دع المقبض: ط64 = CreateFileW(
            &متغير الاسم[0], 0x80000000, 7, الفارغ,
            3, 0x00000080, 0
        );
        لو (المقبض == (~(0 مثل ط64))) {
            أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز());
        };
        أرجع نتيجة.نجح(تبن_مقبض_ملف_ويندوز(المقبض));
    };
}

عام عرف أنشئ_ملف_ويندوز_للكتابة(
    المسار: &نص
): نتيجة مقبض_ملف_ويندوز, خطأ_مقبض_ملف_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه ط16 = الوحدات;
        دع المقبض: ط64 = CreateFileW(
            &متغير الاسم[0], 0x40000000, 7, الفارغ,
            2, 0x00000080, 0
        );
        لو (المقبض == (~(0 مثل ط64))) {
            أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز());
        };
        أرجع نتيجة.نجح(تبن_مقبض_ملف_ويندوز(المقبض));
    };
}

// A zero-length transfer is successful without forming an out-of-bounds
// pointer. DWORD-sized requests are checked before narrowing.
عام عرف اقرأ_مقطع_ملف_ويندوز(
    الملف: &مقبض_ملف_ويندوز,
    المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
        || المطلوب > 4294967295) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع المقروء: متغير ط32 = 0;
    دع الحالة: ص32 = ReadFile(
        (*الملف).القيمة, &متغير (*المخزن)[الإزاحة مثل طبيعي],
        المطلوب مثل ط32, &متغير المقروء, الفارغ
    );
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    أرجع نتيجة.نجح(المقروء مثل عدد);
}

عام عرف اكتب_مقطع_ملف_ويندوز(
    الملف: &مقبض_ملف_ويندوز,
    المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!(*الملف).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 4294967295) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    دع المكتوب: متغير ط32 = 0;
    دع الحالة: ص32 = WriteFile(
        (*الملف).القيمة, &(*المحتوى)[الإزاحة مثل طبيعي],
        المطلوب مثل ط32, &متغير المكتوب, الفارغ
    );
    لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
    أرجع نتيجة.نجح(المكتوب مثل عدد);
}

// GetStdHandle returns a borrowed process-owned HANDLE: it must never be
// closed by std.os. A GUI process may have NULL standard handles.
عام نوع تيار_قياسي_ويندوز =
    | دخل
    | خرج
    | خطأ
;

عرف معرف_تيار_قياسي_ويندوز(التيار: تيار_قياسي_ويندوز): ط32 {
    طابق التيار مع
    | تيار_قياسي_ويندوز.دخل -> { أرجع 0xFFFFFFF6; } // (DWORD)-10
    | تيار_قياسي_ويندوز.خرج -> { أرجع 0xFFFFFFF5; } // (DWORD)-11
    | تيار_قياسي_ويندوز.خطأ -> { أرجع 0xFFFFFFF4; }; // (DWORD)-12
}

عرف خذ_مقبض_تيار_قياسي_ويندوز(
    التيار: تيار_قياسي_ويندوز
): نتيجة ط64, خطأ_مقبض_ملف_ويندوز {
    دع المقبض: ط64 = GetStdHandle(معرف_تيار_قياسي_ويندوز(التيار));
    لو (المقبض == (~(0 مثل ط64))) {
        أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز());
    };
    لو (المقبض == 0) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مقبض_مغلق());
    };
    أرجع نتيجة.نجح(المقبض);
}

عام عرف اقرأ_دخلا_قياسيا_ويندوز(
    المخزن: &متغير متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
        || المطلوب > 4294967295) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    طابق خذ_مقبض_تيار_قياسي_ويندوز(تيار_قياسي_ويندوز.دخل()) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع المقروء: متغير ط32 = 0;
        دع الحالة: ص32 = ReadFile(
            المقبض, &متغير (*المخزن)[الإزاحة مثل طبيعي],
            المطلوب مثل ط32, &متغير المقروء, الفارغ
        );
        لو (الحالة == 0) {
            // ERROR_BROKEN_PIPE (109) on redirected stdin is ordinary EOF,
            // not a failed file read. Capture GetLastError before any call.
            دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
            لو (الأصلي.الرمز == 109) { أرجع نتيجة.نجح(0); };
            أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.نظام(الأصلي));
        };
        أرجع نتيجة.نجح(المقروء مثل عدد);
    };
}

// The byte-level standard-output operation is intended for redirected
// streams and binary data. Console Unicode rendering is a separate contract.
عام عرف اكتب_تيارا_قياسيا_ويندوز(
    التيار: تيار_قياسي_ويندوز,
    المحتوى: &متجه ط8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 4294967295) {
        أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح());
    };
    لو (المطلوب == 0) { أرجع نتيجة.نجح(0); };
    طابق خذ_مقبض_تيار_قياسي_ويندوز(التيار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع المكتوب: متغير ط32 = 0;
        دع الحالة: ص32 = WriteFile(
            المقبض, &(*المحتوى)[الإزاحة مثل طبيعي],
            المطلوب مثل ط32, &متغير المكتوب, الفارغ
        );
        لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز()); };
        أرجع نتيجة.نجح(المكتوب مثل عدد);
    };
}

// An executable output is normal file output, not a linker operation.
// Commit complete bytes using repeated bounded synchronous writes, close the
// owned HANDLE even if a write fails, and preserve the first write error.
عام عرف اكتب_بايتات_تنفيذية_ويندوز(
    المسار: &نص, البايتات: &متجه ط8
): نتيجة عدد, خطأ_مقبض_ملف_ويندوز {
    طابق أنشئ_ملف_ويندوز_للكتابة(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقبض) -> {
        دع الملف: متغير مقبض_ملف_ويندوز = المقبض;
        دع المكتوب: متغير عدد = 0;
        دع العدد: عدد = الطول(*البايتات);
        طالما (المكتوب < العدد) {
            دع المتبقي: عدد = العدد - المكتوب;
            دع الدفعة: متغير عدد = المتبقي;
            لو (الدفعة > 2147483647) { الدفعة := 2147483647; };
            طابق اكتب_مقطع_ملف_ويندوز(&الملف, البايتات, المكتوب, الدفعة) مع
            | نتيجة.خطأ(الخطأ) -> {
                دع الإغلاق: نتيجة عدد, خطأ_مقبض_ملف_ويندوز = أغلق_ملف_ويندوز(&متغير الملف);
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(الدفعة_المكتوبة) -> {
                لو (الدفعة_المكتوبة == 0) {
                    دع الإغلاق: نتيجة عدد, خطأ_مقبض_ملف_ويندوز = أغلق_ملف_ويندوز(&متغير الملف);
                    أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.كتابة_بلا_تقدم());
                };
                المكتوب := المكتوب + الدفعة_المكتوبة;
            };
        }
        طابق أغلق_ملف_ويندوز(&متغير الملف) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المكتوب); };
    };
}

// Query path metadata without treating FILETIME (100-ns ticks from 1601 UTC)
// as a Unix timestamp. Close the file after the synchronous metadata call.
عام عرف وقت_تعديل_ملف_ويندوز(
    المسار: &نص
): نتيجة ط64, خطأ_مقبض_ملف_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مقبض_ملف_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه ط16 = الوحدات;
        // FILE_READ_ATTRIBUTES, FILE_SHARE_READ|WRITE|DELETE, OPEN_EXISTING.
        دع المقبض: ط64 = CreateFileW(
            &متغير الاسم[0], 0x00000080, 7, الفارغ, 3, 0x00000080, 0
        );
        لو (المقبض == (~(0 مثل ط64))) {
            أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز());
        };
        دع الوقت: متغير ط64 = 0;
        دع الحالة: ص32 = GetFileTime(المقبض, الفارغ, الفارغ, &متغير الوقت);
        لو (الحالة == 0) {
            دع الخطأ: خطأ_مقبض_ملف_ويندوز = خطأ_عملية_ملف_ويندوز();
            دع الإغلاق: ص32 = CloseHandle(المقبض);
            أرجع نتيجة.خطأ(الخطأ);
        };
        لو (CloseHandle(المقبض) == 0) {
            أرجع نتيجة.خطأ(خطأ_عملية_ملف_ويندوز());
        };
        أرجع نتيجة.نجح(الوقت);
    };
}
