استورد os.path;
استورد os.error;
استورد os.platform.windows.win32.error;
استورد os.platform.windows.win32.file_handles;
استورد encoding.utf16;

// Win32 kernel32 process API. PROCESS_INFORMATION is 24 bytes on the
// registered 64-bit Windows ABIs: two HANDLEs followed by two DWORD IDs.
// STARTUPINFOW is 104 bytes, with its leading cb DWORD set to sizeof.
// The word buffers preserve the native 8-byte alignment and remain alive
// until CreateProcessW returns. They contain C ABI data, not machine code.
خارجي عرف CreateProcessW(
    البرنامج: *غ16, السطر: *متغير غ16,
    حماية_العملية: *غ8, حماية_الخيط: *غ8,
    وراثة_المقابض: ص32, الأعلام: غ32,
    البيئة: *غ8, الدليل: *غ16,
    البدء: *متغير غ64, المعلومات: *متغير غ64
): ص32;
عام خارجي عرف WaitForSingleObject(المقبض: غ64, المهلة: غ32): غ32;
خارجي عرف GetExitCodeProcess(المقبض: غ64, الرمز: *متغير غ32): ص32;
خارجي عرف TerminateProcess(المقبض: غ64, الرمز: غ32): ص32;
خارجي عرف ExitProcess(الرمز: غ32): فراغ;
خارجي عرف GetCommandLineW(): *غ16;
// Shell32 parses the native process command line; LocalFree releases its
// single allocation (both the pointer table and UTF-16 strings).
خارجي عرف CommandLineToArgvW(السطر: *غ16, العدد: *متغير ص32): **غ16;
خارجي عرف LocalFree(المؤشرات: **غ16): **غ16;

عام نوع خطأ_عملية_ويندوز =
    | وسيط_غير_صالح
    | ترميز_غير_صالح
    | مغلقة
    | حالة_انتظار_غير_متوقعة بنوع غ32
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع عملية_ويندوز = {
    مقبض_العملية: غ64,
    مقبض_الخيط: غ64,
    مفتوحة: منطقي,
    خيط_مفتوح: منطقي
};

// Windows CRT argv quoting rules (documented by Microsoft) for a single
// argument. Always quoting also preserves empty arguments. A run of N
// backslashes before a quote becomes 2N+1; before the closing quote 2N.
// Account for every escaped backslash before appending it. The command line
// must have room for its trailing quote and NUL (32767 WCHAR total).
// Reject oversized arguments before expanding them into a temporary vector.
عرف ألحق_وسيطة_عملية_ويندوز(
    السطر: &متغير متجه غ16, الوسيطة: &متجه غ16
): منطقي {
    لو ((الطول(*السطر) مثل غير_موقع) >= 32766) { أرجع خطأ; };
    ألحق(*السطر, 0x22 مثل غ16);
    دع الموضع: متغير غير_موقع = 0;
    دع العدد: غير_موقع = الطول(*الوسيطة) مثل غير_موقع;
    بينما (الموضع < العدد) {
        دع الشرطات: متغير غير_موقع = 0;
        بينما (الموضع < العدد && (*الوسيطة)[الموضع] == 0x5C) {
            الشرطات := الشرطات + 1;
            الموضع := الموضع + 1;
        }
        دع الإعادة: متغير غير_موقع = الشرطات;
        لو (الموضع == العدد || (*الوسيطة)[الموضع] == 0x22) {
            لو (الشرطات > 32766) { أرجع خطأ; };
            الإعادة := الشرطات * 2;
            لو (الموضع < العدد) { الإعادة := الإعادة + 1; };
        };
        دع الموجود: غير_موقع = الطول(*السطر) مثل غير_موقع;
        لو (الموجود > 32766 || الإعادة > (32766 - الموجود)) { أرجع خطأ; };
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < الإعادة) {
            ألحق(*السطر, 0x5C مثل غ16);
            الفهرس := الفهرس + 1;
        }
        لو (الموضع < العدد) {
            لو ((الطول(*السطر) مثل غير_موقع) >= 32766) { أرجع خطأ; };
            ألحق(*السطر, (*الوسيطة)[الموضع]);
            الموضع := الموضع + 1;
        }
    }
    لو ((الطول(*السطر) مثل غير_موقع) >= 32766) { أرجع خطأ; };
    ألحق(*السطر, 0x22 مثل غ16);
    أرجع صواب;
}

// The executable path is specified separately (no command-line search
// ambiguity). Command-line storage is mutable because CreateProcessW may
// modify it. Security attributes and environment are inherited from the
// current process, but file HANDLE inheritance is explicitly disabled.
عام عرف شغل_عملية_ويندوز(
    البرنامج: &نص, الوسائط: &متجه نص
): نتيجة عملية_ويندوز, خطأ_عملية_ويندوز {
    لو (الطول(*البرنامج) == 0 || !مسار_نظام_بلا_صفر_مدمج(البرنامج)) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(البرنامج) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(وحدات_البرنامج) -> {
        دع الاسم: متغير متجه غ16 = وحدات_البرنامج;
        دع السطر: متغير متجه غ16 = [];
        // Drop the terminating NUL from the standalone program path.
        دع الاسم_بلا_صفر: متغير متجه غ16 = [];
        دع موضع_الاسم: متغير غير_موقع = 0;
        بينما (موضع_الاسم + 1 < (الطول(الاسم) مثل غير_موقع)) {
            ألحق(الاسم_بلا_صفر, الاسم[موضع_الاسم]);
            موضع_الاسم := موضع_الاسم + 1;
        }
        لو (!ألحق_وسيطة_عملية_ويندوز(&متغير السطر, &الاسم_بلا_صفر)) {
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
        };
        دع الموضع: متغير غير_موقع = 0;
        بينما (الموضع < (الطول(*الوسائط) مثل غير_موقع)) {
            دع النص: نص = (*الوسائط)[الموضع];
            لو (!مسار_نظام_بلا_صفر_مدمج(&النص)) {
                أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
            };
            طابق نص_إلى_يوتيف16(&النص) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
            | نتيجة.نجح(الوحدات) -> {
                لو ((الطول(السطر) مثل غير_موقع) >= 32766) {
                    أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
                };
                ألحق(السطر, 0x20 مثل غ16);
                لو (!ألحق_وسيطة_عملية_ويندوز(&متغير السطر, &الوحدات)) {
                    أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
                };
            };
            // Windows command lines are limited to 32767 UTF-16 code units.
            لو ((الطول(السطر) مثل غير_موقع) >= 32767) {
                أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
            };
            الموضع := الموضع + 1;
        }
        لو ((الطول(السطر) مثل غير_موقع) >= 32767) {
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
        };
        ألحق(السطر, 0 مثل غ16);
        دع البدء: متغير متجه غ64 = [];
        دع الفهرس: متغير غير_موقع = 0;
        بينما (الفهرس < 13) {
            ألحق(البدء, 0 مثل غ64);
            الفهرس := الفهرس + 1;
        }
        البدء[0] := 104;
        دع المعلومات: متغير متجه غ64 = [0, 0, 0];
        دع الحالة: ص32 = CreateProcessW(
            &متغير الاسم[0], &متغير السطر[0],
            الفارغ, الفارغ, 0, 0, الفارغ, الفارغ,
            &متغير البدء[0], &متغير المعلومات[0]
        );
        لو (الحالة == 0) {
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        دع العملية: عملية_ويندوز = {
            مقبض_العملية: المعلومات[0], مقبض_الخيط: المعلومات[1],
            مفتوحة: صواب, خيط_مفتوح: صواب
        };
        أرجع نتيجة.نجح(العملية);
    };
}

// WAIT_OBJECT_0=0, WAIT_TIMEOUT=0x102, WAIT_FAILED=0xffffffff.
// Only WAIT_FAILED provides a meaningful GetLastError value. Finite waits
// return None on timeout without closing or consuming the process handle.
عام عرف انتظر_عملية_ويندوز_بمهلة(
    العملية: &عملية_ويندوز,
    المهلة_بالميلي: غ32
): نتيجة اختيار غ32, خطأ_عملية_ويندوز {
    لو (!(*العملية).مفتوحة) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.مغلقة()); };
    دع الحالة: غ32 = WaitForSingleObject((*العملية).مقبض_العملية, المهلة_بالميلي);
    لو (الحالة == 0xFFFFFFFF) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    لو (الحالة == 0x102) { أرجع نتيجة.نجح(اختيار.لا_شيء()); };
    لو (الحالة != 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.حالة_انتظار_غير_متوقعة(الحالة));
    };
    دع الرمز: متغير غ32 = 0;
    لو (GetExitCodeProcess((*العملية).مقبض_العملية, &متغير الرمز) == 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(اختيار.بعض(الرمز));
}

// An infinite wait must produce a terminated process; it is not permitted
// to fabricate a successful exit code from an unexpected wait result.
عام عرف انتظر_عملية_ويندوز(
    العملية: &عملية_ويندوز
): نتيجة غ32, خطأ_عملية_ويندوز {
    طابق انتظر_عملية_ويندوز_بمهلة(العملية, 0xFFFFFFFF) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(النتيجة) -> {
        طابق النتيجة مع
        | اختيار.بعض(الرمز) -> { أرجع نتيجة.نجح(الرمز); }
        | اختيار.لا_شيء -> {
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.حالة_انتظار_غير_متوقعة(0x102));
        };
    };
}

عام عرف أنه_عملية_ويندوز(
    العملية: &عملية_ويندوز, الرمز: غ32
): نتيجة عدد, خطأ_عملية_ويندوز {
    لو (!(*العملية).مفتوحة) { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.مغلقة()); };
    لو (TerminateProcess((*العملية).مقبض_العملية, الرمز) == 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(0);
}

عام عرف أغلق_عملية_ويندوز(
    العملية: &متغير عملية_ويندوز
): نتيجة عدد, خطأ_عملية_ويندوز {
    لو (!(*العملية).مفتوحة && !(*العملية).خيط_مفتوح) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.مغلقة());
    };
    دع الأول: متغير اختيار خطأ_نظام_أصلي = اختيار.لا_شيء();
    لو ((*العملية).خيط_مفتوح) {
        لو (CloseHandle((*العملية).مقبض_الخيط) == 0) {
            الأول := اختيار.بعض(التقط_خطأ_وين32());
        } وإلا {
            (*العملية).خيط_مفتوح := خطأ;
        };
    };
    لو ((*العملية).مفتوحة) {
        لو (CloseHandle((*العملية).مقبض_العملية) == 0) {
            دع الخطأ: خطأ_نظام_أصلي = التقط_خطأ_وين32();
            طابق الأول مع
            | اختيار.لا_شيء -> { الأول := اختيار.بعض(الخطأ); }
            | اختيار.بعض(_) -> {};
        } وإلا {
            (*العملية).مفتوحة := خطأ;
        };
    };
    طابق الأول مع
    | اختيار.بعض(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(الخطأ));
    }
    | اختيار.لا_شيء -> { أرجع نتيجة.نجح(0); };
}

عام عرف اخرج_من_عملية_ويندوز(الرمز: غ32): فراغ {
    ExitProcess(الرمز);
}

// Returned pointer is borrowed from the process, not allocated by us.
// Read only up to the documented maximum command-line length.
عام عرف اقرأ_سطر_أوامر_ويندوز(): نتيجة نص, خطأ_عملية_ويندوز {
    دع المؤشر: *غ16 = GetCommandLineW();
    لو (المؤشر == الفارغ) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع الوحدات: متغير متجه غ16 = [];
    دع الفهرس: متغير غير_موقع = 0;
    غير_آمن {
        بينما (الفهرس < 32767 && المؤشر[الفهرس] != 0) {
            ألحق(الوحدات, المؤشر[الفهرس]);
            الفهرس := الفهرس + 1;
        }
    }
    لو (الفهرس == 32767) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
    };
    طابق يوتيف16_إلى_نص(&الوحدات) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
}

// CommandLineToArgvW follows documented Shell32 rules, which can differ
// from the startup code of a program linked against a particular C runtime.
// Own the decoded strings; always release Shell32's pointer array, including
// on malformed UTF-16 or an oversized unterminated argument.
عام عرف اقرأ_وسائط_عملية_ويندوز(): نتيجة متجه نص, خطأ_عملية_ويندوز {
    دع السطر: *غ16 = GetCommandLineW();
    لو (السطر == الفارغ) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع العدد: متغير ص32 = 0;
    دع المؤشرات: **غ16 = CommandLineToArgvW(السطر, &متغير العدد);
    لو (المؤشرات == الفارغ) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع الوسائط: متغير متجه نص = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < (العدد مثل غير_موقع)) {
        دع الوحدات: متغير متجه غ16 = [];
        دع مؤشر_الوسيطة: *غ16 = الفارغ;
        غير_آمن { مؤشر_الوسيطة := المؤشرات[الفهرس]; }
        دع الموضع: متغير غير_موقع = 0;
        غير_آمن {
            بينما (الموضع < 32767 && مؤشر_الوسيطة[الموضع] != 0) {
                ألحق(الوحدات, مؤشر_الوسيطة[الموضع]);
                الموضع := الموضع + 1;
            }
        }
        لو (الموضع == 32767) {
            دع التحرير: **غ16 = LocalFree(المؤشرات);
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.وسيط_غير_صالح());
        };
        طابق يوتيف16_إلى_نص(&الوحدات) مع
        | نتيجة.خطأ(_) -> {
            دع التحرير: **غ16 = LocalFree(المؤشرات);
            أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.ترميز_غير_صالح());
        }
        | نتيجة.نجح(الوسيطة) -> { ألحق(الوسائط, الوسيطة); };
        الفهرس := الفهرس + 1;
    }
    دع التحرير: **غ16 = LocalFree(المؤشرات);
    لو (التحرير != الفارغ) {
        أرجع نتيجة.خطأ(خطأ_عملية_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(الوسائط);
}

// Argument count and argument retrieval share the same native parser.
// Count excludes no entries, including the program image at argv[0].
عام عرف عدد_وسائط_عملية_ويندوز(): نتيجة عدد, خطأ_عملية_ويندوز {
    طابق اقرأ_وسائط_عملية_ويندوز() مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الوسائط) -> { أرجع نتيجة.نجح(الطول(الوسائط)); };
}
