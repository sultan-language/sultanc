استورد os.error;
استورد os.platform.windows.win32.error;

// Win32 virtual memory has distinct reserve/commit and release semantics.
// These kernel32 interfaces are not CRT allocators or POSIX mmap wrappers.
// Registered Windows targets are 64-bit; SIZE_T is 64-bit on both.
خارجي عرف VirtualAlloc(
    العنوان: *غ8, الطول: غ64, نوع_الحجز: غ32, الحماية: غ32
): *متغير غ8;
خارجي عرف VirtualFree(العنوان: *متغير غ8, الطول: غ64, النوع: غ32): ص32;
خارجي عرف VirtualProtect(
    العنوان: *متغير غ8, الطول: غ64, الحماية: غ32, السابقة: *متغير غ32
): ص32;
خارجي عرف VirtualLock(العنوان: *متغير غ8, الطول: غ64): ص32;
خارجي عرف VirtualUnlock(العنوان: *متغير غ8, الطول: غ64): ص32;
// SYSTEM_INFO is 48 bytes with 8-byte alignment on Win64; dwPageSize is
// the DWORD at offset 4 and dwAllocationGranularity at offset 40.
خارجي عرف GetSystemInfo(البيانات: *متغير غ64): فراغ;
// Kernel32 page-prefetch hint: WIN32_MEMORY_RANGE_ENTRY is two 64-bit
// fields on Win64, a pointer and SIZE_T. Available since Windows 8.
خارجي عرف GetCurrentProcess(): غ64;
عام نوع منطقة_استباق_ويندوز = {
    العنوان: *متغير غ8,
    الطول: غ64
};
خارجي عرف PrefetchVirtualMemory(
    العملية: غ64, عدد_المناطق: غ64,
    المناطق: *منطقة_استباق_ويندوز, الأعلام: غ32
): ص32;

عام نوع حماية_صفحات_ويندوز =
    | ممنوعة
    | قراءة
    | قراءة_وكتابة
    | تنفيذ_وقراءة
    | تنفيذ_وقراءة_وكتابة
;

عرف أعلام_حماية_صفحات_ويندوز(الحماية: حماية_صفحات_ويندوز): غ32 {
    طابق الحماية مع
    | حماية_صفحات_ويندوز.ممنوعة -> { أرجع 0x01; } // PAGE_NOACCESS
    | حماية_صفحات_ويندوز.قراءة -> { أرجع 0x02; } // PAGE_READONLY
    | حماية_صفحات_ويندوز.قراءة_وكتابة -> { أرجع 0x04; } // PAGE_READWRITE
    | حماية_صفحات_ويندوز.تنفيذ_وقراءة -> { أرجع 0x20; } // PAGE_EXECUTE_READ
    | حماية_صفحات_ويندوز.تنفيذ_وقراءة_وكتابة -> { أرجع 0x40; }; // PAGE_EXECUTE_READWRITE
}

عام نوع خطأ_ذاكرة_ويندوز =
    | نطاق_غير_صالح
    | منطقة_محررة
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع منطقة_ذاكرة_ويندوز = {
    العنوان: *متغير غ8,
    الطول: غ64,
    نشطة: منطقي
};

// MEM_RESERVE | MEM_COMMIT = 0x3000. NULL indicates failure; no
// address casts to signed integers or artificial -errno conventions.
عام عرف احجز_ذاكرة_ويندوز(
    الطول: غ64, الحماية: حماية_صفحات_ويندوز
): نتيجة منطقة_ذاكرة_ويندوز, خطأ_ذاكرة_ويندوز {
    لو (الطول == 0) { أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نطاق_غير_صالح()); };
    دع العنوان: *متغير غ8 = VirtualAlloc(
        الفارغ, الطول, 0x3000, أعلام_حماية_صفحات_ويندوز(الحماية)
    );
    لو (العنوان == الفارغ) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع المنطقة: منطقة_ذاكرة_ويندوز = { العنوان: العنوان, الطول: الطول, نشطة: صواب };
    أرجع نتيجة.نجح(المنطقة);
}

// MEM_RELEASE requires dwSize=0 and the *original allocation base*.
عام عرف حرر_ذاكرة_ويندوز(
    المنطقة: &متغير منطقة_ذاكرة_ويندوز
): نتيجة عدد, خطأ_ذاكرة_ويندوز {
    لو (!(*المنطقة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.منطقة_محررة());
    };
    دع الحالة: ص32 = VirtualFree((*المنطقة).العنوان, 0, 0x8000);
    لو (الحالة == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    (*المنطقة).نشطة := خطأ;
    أرجع نتيجة.نجح(0);
}

عام عرف احم_ذاكرة_ويندوز(
    المنطقة: &منطقة_ذاكرة_ويندوز, الحماية: حماية_صفحات_ويندوز
): نتيجة غ32, خطأ_ذاكرة_ويندوز {
    لو (!(*المنطقة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.منطقة_محررة());
    };
    دع السابقة: متغير غ32 = 0;
    دع الحالة: ص32 = VirtualProtect(
        (*المنطقة).العنوان, (*المنطقة).الطول,
        أعلام_حماية_صفحات_ويندوز(الحماية), &متغير السابقة
    );
    لو (الحالة == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(السابقة);
}

// Locking is subject to process working-set quotas; a failure preserves
// GetLastError rather than pretending the pages were locked.
عام عرف اقفل_ذاكرة_ويندوز(
    المنطقة: &منطقة_ذاكرة_ويندوز
): نتيجة عدد, خطأ_ذاكرة_ويندوز {
    لو (!(*المنطقة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.منطقة_محررة());
    };
    دع الحالة: ص32 = VirtualLock((*المنطقة).العنوان, (*المنطقة).الطول);
    لو (الحالة == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(0);
}

عام عرف افتح_قفل_ذاكرة_ويندوز(
    المنطقة: &منطقة_ذاكرة_ويندوز
): نتيجة عدد, خطأ_ذاكرة_ويندوز {
    لو (!(*المنطقة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.منطقة_محررة());
    };
    دع الحالة: ص32 = VirtualUnlock((*المنطقة).العنوان, (*المنطقة).الطول);
    لو (الحالة == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(0);
}

عام نوع معلومات_صفحات_ويندوز = {
    حجم_الصفحة: غ32,
    دقة_الحجز: غ32
};

عام عرف اقرأ_معلومات_صفحات_ويندوز(): معلومات_صفحات_ويندوز {
    دع البيانات: متغير متجه غ64 = [0, 0, 0, 0, 0, 0];
    GetSystemInfo(&متغير البيانات[0]);
    دع المعلومات: معلومات_صفحات_ويندوز = {
        حجم_الصفحة: ((البيانات[0] >> 32) & 0xFFFFFFFF) مثل غ32,
        دقة_الحجز: (البيانات[5] & 0xFFFFFFFF) مثل غ32
    };
    أرجع المعلومات;
}

// Prefetching is only a hint; success does not guarantee resident pages.
// It is not a generic POSIX madvise replacement or memory lock operation.
عام عرف استبق_تحميل_ذاكرة_ويندوز(
    المنطقة: &منطقة_ذاكرة_ويندوز
): نتيجة عدد, خطأ_ذاكرة_ويندوز {
    لو (!(*المنطقة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.منطقة_محررة());
    };
    // This Win64 ABI uses a pointer followed by SIZE_T, both 64 bits.
    دع العنوان: *متغير غ8 = (*المنطقة).العنوان;
    دع الإدخال: متغير منطقة_استباق_ويندوز = {
        العنوان: العنوان, الطول: (*المنطقة).الطول
    };
    لو (PrefetchVirtualMemory(GetCurrentProcess(), 1, &متغير الإدخال, 0) == 0) {
        أرجع نتيجة.خطأ(خطأ_ذاكرة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(0);
}
