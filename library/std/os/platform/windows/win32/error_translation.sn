استورد os.error;

// Win32 system-error codes: WinError.h, Microsoft System Error Codes (0-499).
// Classification never changes the original GetLastError identity.
عام عرف صنف_خطأ_وين32(الرمز: غ32): صنف_خطأ_نظام {
    طابق الرمز مع
    | 2 -> { أرجع صنف_خطأ_نظام.غير_موجود(); }       // ERROR_FILE_NOT_FOUND
    | 3 -> { أرجع صنف_خطأ_نظام.غير_موجود(); }       // ERROR_PATH_NOT_FOUND
    | 5 -> { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }      // ERROR_ACCESS_DENIED
    | 6 -> { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); } // ERROR_INVALID_HANDLE
    | 8 -> { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); } // ERROR_NOT_ENOUGH_MEMORY
    | 14 -> { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); } // ERROR_OUTOFMEMORY
    | 32 -> { أرجع صنف_خطأ_نظام.مورد_مشغول(); }     // ERROR_SHARING_VIOLATION
    | 50 -> { أرجع صنف_خطأ_نظام.غير_مدعوم(); }      // ERROR_NOT_SUPPORTED
    | 267 -> { أرجع صنف_خطأ_نظام.ليس_دليلا(); } // ERROR_DIRECTORY
    | 80 -> { أرجع صنف_خطأ_نظام.موجود_مسبقا(); }    // ERROR_FILE_EXISTS
    | 87 -> { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); } // ERROR_INVALID_PARAMETER
    | 112 -> { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); } // ERROR_DISK_FULL
    | 145 -> { أرجع صنف_خطأ_نظام.مورد_مشغول(); }   // ERROR_DIR_NOT_EMPTY
    | 170 -> { أرجع صنف_خطأ_نظام.مورد_مشغول(); }    // ERROR_BUSY
    | 183 -> { أرجع صنف_خطأ_نظام.موجود_مسبقا(); }   // ERROR_ALREADY_EXISTS
    | 203 -> { أرجع صنف_خطأ_نظام.غير_موجود(); }    // ERROR_ENVVAR_NOT_FOUND
    | _ -> { أرجع صنف_خطأ_نظام.غير_معروف(); };
}

عام عرف ترجم_خطأ_وين32(الأصلي: خطأ_نظام_أصلي): خطأ_نظام {
    أرجع صنف_خطأ_نظام_أصليا(الأصلي, صنف_خطأ_وين32(الأصلي.الرمز مثل غ32));
}
