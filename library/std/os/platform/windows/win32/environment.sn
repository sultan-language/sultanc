استورد os.environment_validation;
استورد os.path;
استورد os.error;
استورد os.platform.windows.win32.error;
استورد encoding.utf16;

// Kernel32 uses UTF-16 environment entries. Never interpret these as Unix
// byte strings, and do not access the CRT's getenv or environ variables.
خارجي «kernel32.dll» عرف GetEnvironmentVariableW(
    الاسم: *ط16, المخزن: *متغير ط16, السعة: ط32
): ط32;
خارجي «kernel32.dll» عرف SetEnvironmentVariableW(الاسم: *ط16, القيمة: *ط16): ص32;
خارجي «kernel32.dll» عرف GetCurrentDirectoryW(السعة: ط32, المخزن: *متغير ط16): ط32;
خارجي «kernel32.dll» عرف GetTempPathW(السعة: ط32, المخزن: *متغير ط16): ط32;
خارجي «kernel32.dll» عرف SetCurrentDirectoryW(المسار: *ط16): ص32;

عام نوع خطأ_بيئة_ويندوز =
    | اسم_غير_صالح
    | ترميز_غير_صالح
    | تغير_متكرر
    | نظام بنوع خطأ_نظام_أصلي
;

// Query the required capacity including the NUL, and retry if another
// thread enlarged the value between the two native calls.
عام عرف اقرأ_متغير_بيئة_ويندوز(
    الاسم: &نص
): نتيجة نص, خطأ_بيئة_ويندوز {
    إذا (!اسم_متغير_بيئة_نظام_صالح(الاسم)) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(الاسم) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح());
    }
    | نتيجة.نجح(الوحدات) -> {
        دع المفتاح: متغير متجه ط16 = الوحدات;
        // GetEnvironmentVariableW returns zero for both an absent variable
        // and a present empty value. LastError distinguishes these states.
        SetLastError(0);
        دع المطلوب: متغير ط32 = GetEnvironmentVariableW(&متغير المفتاح[0], الفارغ, 0);
        إذا (المطلوب == 0) {
            دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
            إذا (الأصلي.الرمز == 0) { أرجع نتيجة.نجح(«»); };
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(الأصلي));
        };
        // The Windows environment API limits a single value to 32767 units.
        إذا (المطلوب > 32768) {
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
        };
        دع المحاولة: متغير عدد = 0;
        طالما (المحاولة < 4) {
            دع المخزن: متغير متجه ط16 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < (المطلوب مثل طبيعي)) {
                ألحق(المخزن, 0 مثل ط16);
                الفهرس := الفهرس + 1;
            }
            // A zero length is an empty value only if GetLastError is zero.
            // Clear it immediately before this Win32 call to avoid stale
            // thread error state from prior unrelated operations.
            SetLastError(0);
            دع المكتوب: ط32 = GetEnvironmentVariableW(
                &متغير المفتاح[0], &متغير المخزن[0], المطلوب
            );
            إذا (المكتوب == 0) {
                // An empty value is successful when the last error is zero.
                دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
                إذا (الأصلي.الرمز != 0) {
                    أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(الأصلي));
                };
                أرجع نتيجة.نجح(«»);
            };
            إذا (المكتوب < المطلوب) {
                دع القيمة: متغير متجه ط16 = [];
                دع الموضع: متغير طبيعي = 0;
                طالما (الموضع < (المكتوب مثل طبيعي)) {
                    ألحق(القيمة, المخزن[الموضع]);
                    الموضع := الموضع + 1;
                }
                طابق يوتيف16_إلى_نص(&القيمة) مع
                | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
                | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
            };
            المطلوب := المكتوب;
            إذا (المطلوب > 32768) {
                أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
            };
            المحاولة := المحاولة + 1;
        }
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.تغير_متكرر());
    };
}

عام عرف ضع_متغير_بيئة_ويندوز(
    الاسم: &نص, القيمة: &نص
): نتيجة عدد, خطأ_بيئة_ويندوز {
    إذا (!اسم_متغير_بيئة_نظام_صالح(الاسم)
        || !قيمة_متغير_بيئة_نظام_صالحة(القيمة)) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(الاسم_المشفر) -> {
        طابق وحدات_مسار_ويندوز_صفرية(القيمة) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
        | نتيجة.نجح(القيمة_المشفرة) -> {
            دع المفتاح: متغير متجه ط16 = الاسم_المشفر;
            دع المحتوى: متغير متجه ط16 = القيمة_المشفرة;
            دع الحالة: ص32 = SetEnvironmentVariableW(&متغير المفتاح[0], &متغير المحتوى[0]);
            إذا (الحالة == 0) {
                أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
            };
            أرجع نتيجة.نجح(0);
        };
    };
}

// Capture the native working directory, including the drive or UNC prefix.
// A concurrent SetCurrentDirectoryW may change the required buffer length.
عام عرف اقرأ_دليل_عمل_ويندوز(): نتيجة نص, خطأ_بيئة_ويندوز {
    دع السعة: متغير ط32 = GetCurrentDirectoryW(0, الفارغ);
    إذا (السعة == 0) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع المحاولة: متغير عدد = 0;
    طالما (المحاولة < 4) {
        دع المخزن: متغير متجه ط16 = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < (السعة مثل طبيعي)) {
            ألحق(المخزن, 0 مثل ط16);
            الموضع := الموضع + 1;
        }
        دع المكتوب: ط32 = GetCurrentDirectoryW(السعة, &متغير المخزن[0]);
        إذا (المكتوب == 0) {
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        إذا (المكتوب < السعة) {
            دع الوحدات: متغير متجه ط16 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < (المكتوب مثل طبيعي)) {
                ألحق(الوحدات, المخزن[الفهرس]);
                الفهرس := الفهرس + 1;
            }
            طابق يوتيف16_إلى_نص(&الوحدات) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
            | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
        };
        السعة := المكتوب;
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.تغير_متكرر());
}

// GetTempPathW follows the process environment's TMP/TEMP policy; the OS
// does not guarantee that the returned directory exists or is writable.
عام عرف اقرأ_دليل_مؤقت_ويندوز(): نتيجة نص, خطأ_بيئة_ويندوز {
    دع السعة: متغير ط32 = GetTempPathW(0, الفارغ);
    إذا (السعة == 0) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع المحاولة: متغير عدد = 0;
    طالما (المحاولة < 4) {
        دع المخزن: متغير متجه ط16 = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < (السعة مثل طبيعي)) {
            ألحق(المخزن, 0 مثل ط16);
            الموضع := الموضع + 1;
        }
        دع المكتوب: ط32 = GetTempPathW(السعة, &متغير المخزن[0]);
        إذا (المكتوب == 0) {
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        إذا (المكتوب < السعة) {
            دع الوحدات: متغير متجه ط16 = [];
            دع الفهرس: متغير طبيعي = 0;
            طالما (الفهرس < (المكتوب مثل طبيعي)) {
                ألحق(الوحدات, المخزن[الفهرس]);
                الفهرس := الفهرس + 1;
            }
            طابق يوتيف16_إلى_نص(&الوحدات) مع
            | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
            | نتيجة.نجح(النص) -> { أرجع نتيجة.نجح(النص); };
        };
        السعة := المكتوب;
        المحاولة := المحاولة + 1;
    }
    أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.تغير_متكرر());
}

// Passing NULL to SetEnvironmentVariableW deletes a variable; passing an
// empty UTF-16 string instead leaves a present, empty variable.
عام عرف احذف_متغير_بيئة_ويندوز(
    الاسم: &نص
): نتيجة عدد, خطأ_بيئة_ويندوز {
    إذا (!اسم_متغير_بيئة_نظام_صالح(الاسم)) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(الوحدات) -> {
        دع المفتاح: متغير متجه ط16 = الوحدات;
        إذا (SetEnvironmentVariableW(&متغير المفتاح[0], الفارغ) == 0) {
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        أرجع نتيجة.نجح(0);
    };
}

// The working directory is process-wide and may be changed by any thread.
// Paths are converted to the W API's UTF-16 ABI, not the process code page.
عام عرف غيّر_دليل_عمل_ويندوز(
    المسار: &نص
): نتيجة عدد, خطأ_بيئة_ويندوز {
    إذا (الطول(*المسار) == 0) {
        أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.اسم_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.ترميز_غير_صالح()); }
    | نتيجة.نجح(الوحدات) -> {
        دع الدليل: متغير متجه ط16 = الوحدات;
        إذا (SetCurrentDirectoryW(&متغير الدليل[0]) == 0) {
            أرجع نتيجة.خطأ(خطأ_بيئة_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        أرجع نتيجة.نجح(0);
    };
}
