استورد os.error;
استورد os.platform.windows.win32.error;
استورد os.platform.windows.win32.file_handles;
استورد os.platform.windows.win32.process_control;
استورد os.platform.windows.win32.file_paths;

// Kernel32 time facilities: system FILETIME counts 100 ns units since
// 1601-01-01 UTC; QPC counts monotonic high-resolution counter ticks.
// Their epochs and adjustments differ and the values must not be mixed.
خارجي عرف GetSystemTimePreciseAsFileTime(الوقت: *متغير غ64): فراغ;
خارجي عرف QueryPerformanceCounter(القيمة: *متغير ص64): ص32;
خارجي عرف QueryPerformanceFrequency(التردد: *متغير ص64): ص32;
خارجي عرف GetTickCount64(): غ64;
خارجي عرف Sleep(المدة: غ32): فراغ;
خارجي عرف CreateWaitableTimerW(
    الحماية: *غ8, يدوي: ص32, الاسم: *غ16
): غ64;
خارجي عرف SetWaitableTimer(
    المؤقت: غ64, الاستحقاق: *ص64, الفترة: ص32,
    الإجراء: *غ8, الوسيط: *غ8, إيقاظ_النظام: ص32
): ص32;

عام نوع قراءة_ساعة_رتيبة_ويندوز = {
    عدد_الدقات: ص64,
    الدقات_في_الثانية: ص64
};

عام عرف اقرأ_وقت_نظام_ويندوز(): غ64 {
    دع الوقت: متغير غ64 = 0;
    GetSystemTimePreciseAsFileTime(&متغير الوقت);
    أرجع الوقت;
}

عام عرف اقرأ_ساعة_رتيبة_ويندوز(): نتيجة قراءة_ساعة_رتيبة_ويندوز, خطأ_نظام_أصلي {
    دع الدقات: متغير ص64 = 0;
    دع التردد: متغير ص64 = 0;
    لو (QueryPerformanceFrequency(&متغير التردد) == 0) {
        أرجع نتيجة.خطأ(التقط_خطأ_وين32());
    };
    لو (QueryPerformanceCounter(&متغير الدقات) == 0) {
        أرجع نتيجة.خطأ(التقط_خطأ_وين32());
    };
    دع القراءة: قراءة_ساعة_رتيبة_ويندوز = {
        عدد_الدقات: الدقات, الدقات_في_الثانية: التردد
    };
    أرجع نتيجة.نجح(القراءة);
}

// Millisecond sleep guarantees no nanosecond precision. The caller can use
// a waitable timer for finer waits when that ABI is available.
عام عرف نم_ميلي_ويندوز(المدة: غ32): فراغ {
    Sleep(المدة);
}

عام عرف عمر_إقلاع_ويندوز_بالميلي(): غ64 {
    أرجع GetTickCount64();
}

عام نوع خطأ_نوم_ويندوز =
    | حالة_انتظار_غير_متوقعة بنوع غ32
    | نظام بنوع خطأ_نظام_أصلي
;

// A relative waitable-timer interval is negative, in 100-ns units.
// Rounding up avoids returning earlier than the requested duration; actual
// scheduling resolution is OS/hardware-dependent, not nanosecond precision.
عام عرف نم_نانو_ويندوز(المدة_نانو: غ64): نتيجة عدد, خطأ_نوم_ويندوز {
    لو (المدة_نانو == 0) { أرجع نتيجة.نجح(0); };
    دع المؤقت: غ64 = CreateWaitableTimerW(الفارغ, 1, الفارغ);
    لو (المؤقت == 0) {
        أرجع نتيجة.خطأ(خطأ_نوم_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    دع وحدات_مئة_نانو: متغير غ64 = (المدة_نانو / 100) + 1;
    لو ((المدة_نانو % 100) == 0) {
        وحدات_مئة_نانو := المدة_نانو / 100;
    };
    // u64 nanoseconds cannot exceed signed 64-bit 100-ns intervals even
    // after rounding up: max(u64) / 100 + 1 < max(i64).
    دع الاستحقاق: متغير ص64 = 0 - (وحدات_مئة_نانو مثل ص64);
    لو (SetWaitableTimer(المؤقت, &الاستحقاق, 0, الفارغ, الفارغ, 0) == 0) {
        دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
        دع الإغلاق: ص32 = CloseHandle(المؤقت);
        أرجع نتيجة.خطأ(خطأ_نوم_ويندوز.نظام(الأصلي));
    };
    دع الانتظار: غ32 = WaitForSingleObject(المؤقت, 0xFFFFFFFF);
    لو (الانتظار == 0xFFFFFFFF) {
        دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
        دع الإغلاق: ص32 = CloseHandle(المؤقت);
        أرجع نتيجة.خطأ(خطأ_نوم_ويندوز.نظام(الأصلي));
    };
    لو (الانتظار != 0) {
        دع الإغلاق: ص32 = CloseHandle(المؤقت);
        أرجع نتيجة.خطأ(خطأ_نوم_ويندوز.حالة_انتظار_غير_متوقعة(الانتظار));
    };
    لو (CloseHandle(المؤقت) == 0) {
        أرجع نتيجة.خطأ(خطأ_نوم_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    أرجع نتيجة.نجح(0);
}

// Convert native FILETIME to Unix-epoch nanoseconds without silently
// wrapping a signed or unsigned 64-bit duration. FILETIME's 1601 origin is
// 116444736000000000 100-ns units before the Unix epoch.
عام نوع خطأ_تحويل_وقت_ويندوز =
    | خارج_النطاق
    | تردد_غير_صالح
    | نظام بنوع خطأ_نظام_أصلي
;

عام عرف وقت_ملف_ويندوز_إلى_نانو_يونكس(
    وقت_الملف: غ64
): نتيجة غ64, خطأ_تحويل_وقت_ويندوز {
    لو (وقت_الملف < 116444736000000000) {
        أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.خارج_النطاق());
    };
    دع وحدات_مئة_نانو: غ64 = وقت_الملف - 116444736000000000;
    لو (وحدات_مئة_نانو > 184467440737095516) {
        أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.خارج_النطاق());
    };
    أرجع نتيجة.نجح(وحدات_مئة_نانو * 100);
}

// This is wall-clock time: it can jump when the system clock is adjusted.
// The native API returns a FILETIME and the conversion never uses a CRT.
عام عرف اقرأ_وقت_يونكس_نانو_ويندوز(): نتيجة غ64, خطأ_تحويل_وقت_ويندوز {
    أرجع وقت_ملف_ويندوز_إلى_نانو_يونكس(اقرأ_وقت_نظام_ويندوز());
}

// Compute floor(remainder * 1e9 / divisor) with no intermediate product
// wider than u64. At each bit the stored remainder stays below divisor;
// the two conditional reductions implement a double plus an optional add.
// This also handles performance-counter frequencies above 18 GHz correctly.
عرف كسر_ثانية_رتيبة_ويندوز(الباقي: غ64, المقام: غ64): غ64 {
    دع الناتج: متغير غ64 = 0;
    دع المتبقي: متغير غ64 = 0;
    دع البت: متغير عدد = 29;
    بينما (البت >= 0) {
        دع المحمول: متغير غ64 = 0;
        دع قبل_المضاعفة: غ64 = المقام - المتبقي;
        لو (المتبقي >= قبل_المضاعفة) {
            المتبقي := المتبقي - قبل_المضاعفة;
            المحمول := 1;
        } وإلا {
            المتبقي := المتبقي + المتبقي;
        };
        لو (((1000000000 مثل غ64) >> (البت مثل غ64) & 1) != 0) {
            دع قبل_الجمع: غ64 = المقام - الباقي;
            لو (المتبقي >= قبل_الجمع) {
                المتبقي := المتبقي - قبل_الجمع;
                المحمول := المحمول + 1;
            } وإلا {
                المتبقي := المتبقي + الباقي;
            };
        };
        الناتج := (الناتج * 2) + المحمول;
        البت := البت - 1;
    }
    أرجع الناتج;
}

// QPC measures a monotonic interval; its tick count is not a Unix timestamp.
// Split into whole seconds and fractional ticks so conversion never wraps.
عام عرف اقرأ_وقت_رتيب_نانو_ويندوز(): نتيجة غ64, خطأ_تحويل_وقت_ويندوز {
    طابق اقرأ_ساعة_رتيبة_ويندوز() مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.نظام(الخطأ));
    }
    | نتيجة.نجح(القراءة) -> {
        لو (القراءة.عدد_الدقات < 0 || القراءة.الدقات_في_الثانية <= 0) {
            أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.تردد_غير_صالح());
        };
        دع الدقات: غ64 = القراءة.عدد_الدقات مثل غ64;
        دع التردد: غ64 = القراءة.الدقات_في_الثانية مثل غ64;
        دع الثواني: غ64 = الدقات / التردد;
        دع الباقي: غ64 = الدقات % التردد;
        لو (الثواني > 18446744073) {
            أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.خارج_النطاق());
        };
        دع الكلي: غ64 = الثواني * 1000000000;
        دع الجزئي: غ64 = كسر_ثانية_رتيبة_ويندوز(الباقي, التردد);
        لو (الجزئي > 18446744073709551615 - الكلي) {
            أرجع نتيجة.خطأ(خطأ_تحويل_وقت_ويندوز.خارج_النطاق());
        };
        أرجع نتيجة.نجح(الكلي + الجزئي);
    };
}

// Path metadata reads files AND directories through GetFileAttributesExW.
// Opening a directory as an ordinary file HANDLE is not equivalent. FILETIME
// has the same epoch as the native wall clock, not a Unix timestamp.
عام نوع خطأ_وقت_تعديل_ملف_ويندوز =
    | مسار بنوع خطأ_مسارات_ويندوز
    | تحويل بنوع خطأ_تحويل_وقت_ويندوز
;

عام عرف اقرأ_وقت_تعديل_ملف_نانو_يونكس_ويندوز(
    المسار: &نص
): نتيجة غ64, خطأ_وقت_تعديل_ملف_ويندوز {
    طابق اقرأ_معلومات_مسار_ويندوز(المسار) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_وقت_تعديل_ملف_ويندوز.مسار(الخطأ));
    }
    | نتيجة.نجح(المعلومات) -> {
        طابق وقت_ملف_ويندوز_إلى_نانو_يونكس(المعلومات.تعديل_زمن_الملف) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_وقت_تعديل_ملف_ويندوز.تحويل(الخطأ));
        }
        | نتيجة.نجح(النانوثواني) -> { أرجع نتيجة.نجح(النانوثواني); };
    };
}
