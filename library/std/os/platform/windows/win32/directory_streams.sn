استورد os.path;
استورد os.error;
استورد os.platform.windows.win32.error;
استورد os.platform.windows.win32.file_paths;
استورد encoding.utf16;
استورد text.compare;

// FindFirstFileW/FindNextFileW return WIN32_FIND_DATAW, not a Unix dirent.
// Windows SDK minwinbase.h: DWORD attributes at offset 0; cFileName WCHAR
// array at offset 44, with MAX_PATH=260. The output buffer is 8-byte
// aligned and generously sized for the documented Win32 ABI (640 bytes).
// Both registered Windows architectures are little-endian.
خارجي «kernel32.dll» عرف FindFirstFileW(النمط: *ط16, البيانات: *متغير ط64): ط64;
خارجي «kernel32.dll» عرف FindNextFileW(المقبض: ط64, البيانات: *متغير ط64): ص32;
خارجي «kernel32.dll» عرف FindClose(المقبض: ط64): ص32;

عام نوع خطأ_بحث_ويندوز =
    | مسار بنوع خطأ_مسار_نظام
    | ترميز_غير_صالح
    | مغلق
    | ليس_دليلا
    | مسارات بنوع خطأ_مسارات_ويندوز
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع مدخل_دليل_ويندوز = {
    الاسم: نص,
    السمات: ط32,
    الحجم: ط64
};

عام نوع بحث_دليل_ويندوز = { القيمة: ط64, مفتوح: منطقي };

عام نوع بداية_بحث_دليل_ويندوز = {
    البحث: بحث_دليل_ويندوز,
    المدخل: مدخل_دليل_ويندوز
};

عرف مخزن_معلومات_بحث_ويندوز(): متجه ط64 {
    دع المخزن: متغير متجه ط64 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 80) {
        ألحق(المخزن, 0 مثل ط64);
        الفهرس := الفهرس + 1;
    }
    أرجع المخزن;
}

// The file name is part of a Win32 output struct with a bounded 260-WCHAR
// region. Convert only the first NUL-terminated name, and reject malformed
// surrogate pairs instead of silently replacing them.
عرف فك_مدخل_بحث_ويندوز(
    البيانات: &متجه ط64
): نتيجة مدخل_دليل_ويندوز, خطأ_بحث_ويندوز {
    دع السمات: ط32 = ((*البيانات)[0] & 0xFFFFFFFF) مثل ط32;
    // nFileSizeHigh and nFileSizeLow are DWORDs at offsets 28 and 32.
    دع الحجم_العالي: ط64 = ((*البيانات)[3] >> 32) & 0xFFFFFFFF;
    دع الحجم_المنخفض: ط64 = (*البيانات)[4] & 0xFFFFFFFF;
    دع الاسم: متغير متجه ط16 = [];
    دع الفهرس: متغير طبيعي = 0;
    طالما (الفهرس < 260) {
        دع الإزاحة: طبيعي = 44 + (الفهرس * 2);
        دع الكلمة: ط64 = (*البيانات)[الإزاحة / 8];
        دع إزاحة_البتات: ط64 = ((الإزاحة % 8) * 8) مثل ط64;
        دع الوحدة: ط16 = ((الكلمة >> إزاحة_البتات) & 0xFFFF) مثل ط16;
        لو (الوحدة == 0) { اخرج_من_حلقة; };
        ألحق(الاسم, الوحدة);
        الفهرس := الفهرس + 1;
    }
    لو (الفهرس == 260) {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.ترميز_غير_صالح());
    };
    طابق يوتيف16_إلى_نص(&الاسم) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.ترميز_غير_صالح());
    }
    | نتيجة.نجح(النص) -> {
        دع المدخل: مدخل_دليل_ويندوز = {
            الاسم: النص, السمات: السمات,
            الحجم: (الحجم_العالي << 32) | الحجم_المنخفض
        };
        أرجع نتيجة.نجح(المدخل);
    };
}

// The pattern is a Windows search pattern (e.g. C:\\folder\\*), not a
// raw directory path. FindClose owns its distinct search HANDLE lifetime.
عام عرف ابدأ_بحث_دليل_ويندوز(
    النمط: &نص
): نتيجة بداية_بحث_دليل_ويندوز, خطأ_بحث_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(النمط) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه ط16 = الوحدات;
        دع المعلومات: متغير متجه ط64 = مخزن_معلومات_بحث_ويندوز();
        دع المقبض: ط64 = FindFirstFileW(&متغير الاسم[0], &متغير المعلومات[0]);
        لو (المقبض == (~(0 مثل ط64))) {
            أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.نظام(التقط_خطأ_وين32()));
        };
        طابق فك_مدخل_بحث_ويندوز(&المعلومات) مع
        | نتيجة.خطأ(الخطأ) -> {
            // Decode failure still must close the successfully opened search.
            دع الحالة: ص32 = FindClose(المقبض);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(المدخل) -> {
            دع البحث: بحث_دليل_ويندوز = { القيمة: المقبض, مفتوح: صواب };
            دع البداية: بداية_بحث_دليل_ويندوز = { البحث: البحث, المدخل: المدخل };
            أرجع نتيجة.نجح(البداية);
        };
    };
}

عام عرف اقرأ_مدخل_بحث_ويندوز(
    البحث: &بحث_دليل_ويندوز
): نتيجة اختياري مدخل_دليل_ويندوز, خطأ_بحث_ويندوز {
    لو (!(*البحث).مفتوح) { أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.مغلق()); };
    دع المعلومات: متغير متجه ط64 = مخزن_معلومات_بحث_ويندوز();
    دع الحالة: ص32 = FindNextFileW((*البحث).القيمة, &متغير المعلومات[0]);
    لو (الحالة == 0) {
        دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
        لو (الأصلي.الرمز == 18) { أرجع نتيجة.نجح(اختياري.لا_شيء()); }; // ERROR_NO_MORE_FILES
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.نظام(الأصلي));
    };
    طابق فك_مدخل_بحث_ويندوز(&المعلومات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المدخل) -> { أرجع نتيجة.نجح(اختياري.موجود(المدخل)); };
}

عام عرف أغلق_بحث_دليل_ويندوز(
    البحث: &متغير بحث_دليل_ويندوز
): نتيجة عدد, خطأ_بحث_ويندوز {
    لو (!(*البحث).مفتوح) { أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.مغلق()); };
    دع الحالة: ص32 = FindClose((*البحث).القيمة);
    لو (الحالة == 0) {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.نظام(التقط_خطأ_وين32()));
    };
    (*البحث).مفتوح := خطأ;
    أرجع نتيجة.نجح(0);
}

// Directory enumeration accepts a DIRECTORY PATH, not a FindFirstFileW
// wildcard. Windows' search API requires a trailing '*' (Microsoft fileapi.h).
// The directory is checked first: ERROR_FILE_NOT_FOUND from FindFirstFileW
// then means no matching entries, not that the directory itself is absent.
// An empty directory has no search HANDLE to close.
عام عرف افتح_دليلا_ويندوز(
    المسار: &نص
): نتيجة اختياري بداية_بحث_دليل_ويندوز, خطأ_بحث_ويندوز {
    لو (الطول(*المسار) == 0) {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.ليس_دليلا());
    };
    طابق سمات_مسار_ويندوز(المسار) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.مسارات(الخطأ));
    }
    | نتيجة.نجح(السمات) -> {
        لو (!سمات_مسار_ويندوز_دليل(السمات)) {
            أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.ليس_دليلا());
        };
    };
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.مسار(الخطأ));
    }
    | نتيجة.نجح(الوحدات) -> {
        دع النمط: متغير متجه ط16 = [];
        دع العدد: طبيعي = الطول(الوحدات) مثل طبيعي;
        // Conversion always supplies exactly one terminal NUL.
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع + 1 < العدد) {
            ألحق(النمط, الوحدات[الموضع]);
            الموضع := الموضع + 1;
        }
        دع الأخير: ط16 = النمط[(الطول(النمط) - 1) مثل طبيعي];
        // C: is drive-relative; C:\ is a drive root. Preserve both.
        لو (الأخير != 0x5C && الأخير != 0x2F && الأخير != 0x3A) {
            ألحق(النمط, 0x5C مثل ط16);
        };
        ألحق(النمط, 0x2A مثل ط16);
        ألحق(النمط, 0 مثل ط16);
        دع المعلومات: متغير متجه ط64 = مخزن_معلومات_بحث_ويندوز();
        دع المقبض: ط64 = FindFirstFileW(&متغير النمط[0], &متغير المعلومات[0]);
        لو (المقبض == (~(0 مثل ط64))) {
            دع الأصلي: خطأ_نظام_أصلي = التقط_خطأ_وين32();
            لو (الأصلي.الرمز == 2) {
                أرجع نتيجة.نجح(اختياري.لا_شيء()); // ERROR_FILE_NOT_FOUND
            };
            أرجع نتيجة.خطأ(خطأ_بحث_ويندوز.نظام(الأصلي));
        };
        طابق فك_مدخل_بحث_ويندوز(&المعلومات) مع
        | نتيجة.خطأ(الخطأ) -> {
            دع الإغلاق: ص32 = FindClose(المقبض);
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(المدخل) -> {
            دع البحث: بحث_دليل_ويندوز = { القيمة: المقبض, مفتوح: صواب };
            دع البداية: بداية_بحث_دليل_ويندوز = {
                البحث: البحث, المدخل: المدخل
            };
            أرجع نتيجة.نجح(اختياري.موجود(البداية));
        };
    };
}

// This operation owns the complete native directory-search lifetime. Entries
// are copied out of WIN32_FIND_DATAW before the next FindNextFileW call; no
// borrowed native pointers escape, including on a failed enumeration.
عرف اسم_مدخل_دليل_ويندوز_خاص(الاسم: &نص): منطقي {
    دع الحالي: نص = «.»;
    دع الأب: نص = «..»;
    أرجع نصان_متساويان(الاسم, &الحالي) || نصان_متساويان(الاسم, &الأب);
}

عام عرف اقرأ_مداخل_دليل_ويندوز(
    المسار: &نص
): نتيجة متجه مدخل_دليل_ويندوز, خطأ_بحث_ويندوز {
    دع المداخل: متغير متجه مدخل_دليل_ويندوز = [];
    طابق افتح_دليلا_ويندوز(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(البداية_المحتملة) -> {
        طابق البداية_المحتملة مع
        | اختياري.لا_شيء -> { أرجع نتيجة.نجح(المداخل); }
        | اختياري.موجود({ البحث: البحث_الأولي, المدخل: المدخل_الأول }) -> {
            دع البحث: متغير بحث_دليل_ويندوز = البحث_الأولي;
            لو (!اسم_مدخل_دليل_ويندوز_خاص(&المدخل_الأول.الاسم)) {
                ألحق(المداخل, المدخل_الأول);
            };
            دع مستمر: متغير منطقي = صواب;
            طالما (مستمر) {
                طابق اقرأ_مدخل_بحث_ويندوز(&البحث) مع
                | نتيجة.خطأ(الخطأ) -> {
                    دع نتيجة_الإغلاق: نتيجة عدد, خطأ_بحث_ويندوز = أغلق_بحث_دليل_ويندوز(&متغير البحث);
                    أرجع نتيجة.خطأ(الخطأ);
                }
                | نتيجة.نجح(المدخل_المحتمل) -> {
                    طابق المدخل_المحتمل مع
                    | اختياري.لا_شيء -> { مستمر := خطأ; }
                    | اختياري.موجود(المدخل) -> {
                        لو (!اسم_مدخل_دليل_ويندوز_خاص(&المدخل.الاسم)) {
                            ألحق(المداخل, المدخل);
                        };
                    };
                };
            }
            طابق أغلق_بحث_دليل_ويندوز(&متغير البحث) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(المداخل); };
        };
    };
}
