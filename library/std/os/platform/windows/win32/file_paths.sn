استورد os.path;
استورد os.error;
استورد os.platform.windows.win32.error;

// Native Win32 Unicode paths. The W APIs consume UTF-16, not UTF-8.
// These symbols are from kernel32; linking that system library belongs
// to the target's system-library linkage configuration.
خارجي عرف CreateDirectoryW(المسار: *غ16, الحماية: *غ8): ص32;
خارجي عرف DeleteFileW(المسار: *غ16): ص32;
خارجي عرف GetFileAttributesW(المسار: *غ16): غ32;
خارجي عرف RemoveDirectoryW(المسار: *غ16): ص32;
خارجي عرف MoveFileExW(الأصل: *غ16, الجديد: *غ16, الأعلام: غ32): ص32;
// GET_FILEEX_INFO_LEVELS::GetFileExInfoStandard = 0.
// WIN32_FILE_ATTRIBUTE_DATA is 36 bytes (9 DWORDs), aligned to DWORD.
خارجي عرف GetFileAttributesExW(
    المسار: *غ16, المستوى: ص32, البيانات: *متغير غ32
): ص32;

عام نوع خطأ_مسارات_ويندوز =
    | مسار بنوع خطأ_مسار_نظام
    | نظام بنوع خطأ_نظام_أصلي
;

عرف خطأ_ملف_ويندوز(): خطأ_مسارات_ويندوز {
    أرجع خطأ_مسارات_ويندوز.نظام(
        التقط_خطأ_وين32()
    );
}

عام عرف احذف_ملف_ويندوز(المسار: &نص): نتيجة عدد, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه غ16 = الوحدات;
        دع الحالة: ص32 = DeleteFileW(&متغير الاسم[0]);
        لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_ملف_ويندوز()); };
        أرجع نتيجة.نجح(0);
    };
}

عام عرف احذف_دليلا_ويندوز(المسار: &نص): نتيجة عدد, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه غ16 = الوحدات;
        دع الحالة: ص32 = RemoveDirectoryW(&متغير الاسم[0]);
        لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_ملف_ويندوز()); };
        أرجع نتيجة.نجح(0);
    };
}

// MOVEFILE_REPLACE_EXISTING = 0x00000001 (Win32 documented flag).
// This operation does not imply cross-volume moves or Unix rename rules.
عام عرف أعد_تسمية_مسار_ويندوز(
    الأصلي: &نص, الجديد: &نص
): نتيجة عدد, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(الأصلي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(وحدات_الأصل) -> {
        طابق وحدات_مسار_ويندوز_صفرية(الجديد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
        | نتيجة.نجح(وحدات_الوجهة) -> {
            دع المصدر: متغير متجه غ16 = وحدات_الأصل;
            دع الوجهة: متغير متجه غ16 = وحدات_الوجهة;
            دع الحالة: ص32 = MoveFileExW(
                &متغير المصدر[0], &متغير الوجهة[0], 1
            );
            لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_ملف_ويندوز()); };
            أرجع نتيجة.نجح(0);
        };
    };
}

// INVALID_FILE_ATTRIBUTES is 0xffffffff. The returned DWORD is left intact;
// FILE_ATTRIBUTE_DIRECTORY = 0x10, FILE_ATTRIBUTE_REPARSE_POINT = 0x400.
// A reparse point is not silently treated as a normal directory or file.
عام عرف سمات_مسار_ويندوز(المسار: &نص): نتيجة غ32, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه غ16 = الوحدات;
        دع السمات: غ32 = GetFileAttributesW(&متغير الاسم[0]);
        لو (السمات == (~(0 مثل غ32))) {
            أرجع نتيجة.خطأ(خطأ_ملف_ويندوز());
        };
        أرجع نتيجة.نجح(السمات);
    };
}

عام عرف سمات_مسار_ويندوز_دليل(السمات: غ32): منطقي {
    أرجع (السمات & 0x10) != 0;
}

عام عرف سمات_مسار_ويندوز_وصلة(السمات: غ32): منطقي {
    أرجع (السمات & 0x400) != 0;
}

// Windows only creates one directory level; recursive creation is higher-level.
عام عرف أنشئ_دليلا_ويندوز(
    المسار: &نص
): نتيجة عدد, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ)); }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه غ16 = الوحدات;
        دع الحالة: ص32 = CreateDirectoryW(&متغير الاسم[0], الفارغ);
        لو (الحالة == 0) { أرجع نتيجة.خطأ(خطأ_ملف_ويندوز()); };
        أرجع نتيجة.نجح(0);
    };
}

عام نوع معلومات_مسار_ويندوز = {
    السمات: غ32,
    الحجم: غ64,
    تعديل_زمن_الملف: غ64
};

// FILETIME is a 100ns count since 1601, not Unix epoch nanoseconds.
// File size is uint64; directory and reparse-point semantics are indicated
// separately by the returned attributes, never guessed from size alone.
عام عرف اقرأ_معلومات_مسار_ويندوز(
    المسار: &نص
): نتيجة معلومات_مسار_ويندوز, خطأ_مسارات_ويندوز {
    طابق وحدات_مسار_ويندوز_صفرية(المسار) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_مسارات_ويندوز.مسار(الخطأ));
    }
    | نتيجة.نجح(الوحدات) -> {
        دع الاسم: متغير متجه غ16 = الوحدات;
        دع البيانات: متغير متجه غ32 = [0, 0, 0, 0, 0, 0, 0, 0, 0];
        لو (GetFileAttributesExW(&متغير الاسم[0], 0, &متغير البيانات[0]) == 0) {
            أرجع نتيجة.خطأ(خطأ_ملف_ويندوز());
        };
        دع المعلومات: معلومات_مسار_ويندوز = {
            السمات: البيانات[0],
            الحجم: ((البيانات[7] مثل غ64) << 32) | (البيانات[8] مثل غ64),
            تعديل_زمن_الملف: ((البيانات[6] مثل غ64) << 32) | (البيانات[5] مثل غ64)
        };
        أرجع نتيجة.نجح(المعلومات);
    };
}
