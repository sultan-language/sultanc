استورد os.error;
استورد os.buffer;

// Win64 Winsock: SOCKET is UINT_PTR (64 bits on registered Windows targets).
// It is NOT a POSIX fd or a Win32 HANDLE. This binding requires successful
// WSAStartup(2.2) by the owning execution host before socket operations.
// Native sockaddr layouts and AF_* constants are supplied by the Windows
// provider rather than being silently borrowed from Unix.
// WSADATA on Win64 is 408 bytes with 8-byte alignment, per winsock2.h.
// Reserve 51 64-bit words rather than reinterpreting it as a byte vector.
خارجي عرف socket(العائلة: ص32, النوع: ص32, البروتوكول: ص32): غ64;
خارجي عرف closesocket(المقبس: غ64): ص32;
خارجي عرف connect(المقبس: غ64, العنوان: *غ8, الطول: ص32): ص32;
خارجي عرف bind(المقبس: غ64, العنوان: *غ8, الطول: ص32): ص32;
خارجي عرف listen(المقبس: غ64, التراكم: ص32): ص32;
خارجي عرف send(المقبس: غ64, البايتات: *غ8, الطول: ص32, الأعلام: ص32): ص32;
خارجي عرف recv(المقبس: غ64, البايتات: *متغير غ8, الطول: ص32, الأعلام: ص32): ص32;
خارجي عرف accept(المقبس: غ64, العنوان: *متغير غ8, الطول: *متغير ص32): غ64;
خارجي عرف shutdown(المقبس: غ64, الاتجاه: ص32): ص32;
خارجي عرف ioctlsocket(المقبس: غ64, الأمر: ص32, القيمة: *متغير غ32): ص32;
خارجي عرف setsockopt(
    المقبس: غ64, المستوى: ص32, الخيار: ص32, القيمة: *ص32, الطول: ص32
): ص32;
خارجي عرف WSAGetLastError(): ص32;
خارجي عرف WSAStartup(الإصدار: غ16, البيانات: *متغير غ64): ص32;
خارجي عرف WSACleanup(): ص32;
خارجي عرف getsockname(المقبس: غ64, العنوان: *متغير غ8, الطول: *متغير ص32): ص32;
خارجي عرف getpeername(المقبس: غ64, العنوان: *متغير غ8, الطول: *متغير ص32): ص32;
خارجي عرف getsockopt(
    المقبس: غ64, المستوى: ص32, الخيار: ص32,
    القيمة: *متغير ص32, الطول: *متغير ص32
): ص32;
خارجي عرف sendto(
    المقبس: غ64, المخزن: *غ8, الطول: ص32, الأعلام: ص32,
    العنوان: *غ8, طول_العنوان: ص32
): ص32;
خارجي عرف recvfrom(
    المقبس: غ64, المخزن: *متغير غ8, الطول: ص32, الأعلام: ص32,
    العنوان: *متغير غ8, طول_العنوان: *متغير ص32
): ص32;

عام نوع خطأ_مقبس_وينسوك =
    | غير_مهيأ
    | إصدار_غير_مدعوم
    | نطاق_غير_صالح
    | مغلق
    | نظام بنوع خطأ_نظام_أصلي
;

عام نوع جلسة_وينسوك = { نشطة: منطقي };

// WSAStartup returns a concrete Winsock error value, not a BOOL and not a
// failure communicated through WSAGetLastError.
عام عرف ابدأ_جلسة_وينسوك(): نتيجة جلسة_وينسوك, خطأ_مقبس_وينسوك {
    دع البيانات: متغير متجه غ64 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 51) {
        ألحق(البيانات, 0 مثل غ64);
        الفهرس := الفهرس + 1;
    }
    دع الرمز: ص32 = WSAStartup(0x0202, &متغير البيانات[0]);
    لو (الرمز != 0) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نظام(
            أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.وينسوك(), الرمز مثل عدد)
        ));
    };
    // wVersion is the low WORD of WSADATA on registered 64-bit Windows.
    // A successful initialization can still negotiate an older version.
    لو ((البيانات[0] & 0xFFFF) != 0x0202) {
        دع الإغلاق: ص32 = WSACleanup();
        لو (الإغلاق < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.إصدار_غير_مدعوم());
    };
    دع الجلسة: جلسة_وينسوك = { نشطة: صواب };
    أرجع نتيجة.نجح(الجلسة);
}

// All owned sockets created under a session must be closed before cleanup.
عام عرف أنه_جلسة_وينسوك(
    الجلسة: &متغير جلسة_وينسوك
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*الجلسة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.غير_مهيأ());
    };
    دع الحالة: ص32 = WSACleanup();
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    (*الجلسة).نشطة := خطأ;
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام نوع مقبس_وينسوك = {
    القيمة: غ64,
    مفتوح: منطقي
};

عرف خطأ_عملية_وينسوك(): خطأ_مقبس_وينسوك {
    أرجع خطأ_مقبس_وينسوك.نظام(
        أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.وينسوك(), WSAGetLastError() مثل عدد)
    );
}

// INVALID_SOCKET is (SOCKET)~0, not NULL or -1 in an int descriptor.
عام عرف أنشئ_مقبس_وينسوك(
    الجلسة: &جلسة_وينسوك,
    العائلة: ص32, النوع: ص32, البروتوكول: ص32
): نتيجة مقبس_وينسوك, خطأ_مقبس_وينسوك {
    لو (!(*الجلسة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.غير_مهيأ());
    };
    دع المقبس_الخام: غ64 = socket(العائلة, النوع, البروتوكول);
    لو (المقبس_الخام == (~(0 مثل غ64))) {
        أرجع نتيجة.خطأ(خطأ_عملية_وينسوك());
    };
    دع المقبس: مقبس_وينسوك = { القيمة: المقبس_الخام, مفتوح: صواب };
    أرجع نتيجة.نجح(المقبس);
}

عام عرف اتصل_بمقبس_وينسوك(
    المقبس: &مقبس_وينسوك, العنوان: &متجه غ8
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع الحجم: غير_موقع = الطول(*العنوان) مثل غير_موقع;
    لو (الحجم == 0 || الحجم > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع الحالة: ص32 = connect((*المقبس).القيمة, &(*العنوان)[0], الحجم مثل ص32);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف اربط_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, العنوان: &متجه غ8
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع الحجم: غير_موقع = الطول(*العنوان) مثل غير_موقع;
    لو (الحجم == 0 || الحجم > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع الحالة: ص32 = bind((*المقبس).القيمة, &(*العنوان)[0], الحجم مثل ص32);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف استمع_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, التراكم: ص32
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (التراكم < 0) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح()); };
    دع الحالة: ص32 = listen((*المقبس).القيمة, التراكم);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف أرسل_بمقبس_وينسوك(
    المقبس: &مقبس_وينسوك,
    المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    // A zero-byte send on a datagram socket transmits a real empty
    // datagram; do not turn it into a no-op. Keep a valid source pointer.
    دع المؤقت: متغير متجه غ8 = [0];
    دع المؤشر: متغير *غ8 = &المؤقت[0];
    لو (المطلوب > 0) {
        المؤشر := &(*المحتوى)[الإزاحة مثل غير_موقع];
    };
    دع الحالة: ص32 = send(
        (*المقبس).القيمة, المؤشر, المطلوب مثل ص32, 0
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف استقبل_بمقبس_وينسوك(
    المقبس: &مقبس_وينسوك,
    المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
        || المطلوب > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    // A zero-byte receive must reach Winsock on datagram sockets. The
    // scratch byte avoids forming an out-of-range caller-vector pointer.
    دع المؤقت: متغير متجه غ8 = [0];
    دع المؤشر: متغير *متغير غ8 = &متغير المؤقت[0];
    لو (المطلوب > 0) {
        المؤشر := &متغير (*المخزن)[الإزاحة مثل غير_موقع];
    };
    دع الحالة: ص32 = recv(
        (*المقبس).القيمة, المؤشر, المطلوب مثل ص32, 0
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

عام عرف أغلق_مقبس_وينسوك(
    المقبس: &متغير مقبس_وينسوك
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع الحالة: ص32 = closesocket((*المقبس).القيمة);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    (*المقبس).مفتوح := خطأ;
    أرجع نتيجة.نجح(الحالة مثل عدد);
}

// accept with NULL address arguments produces an independent owned socket.
عام عرف اقبل_مقبس_وينسوك(
    المستمع: &مقبس_وينسوك
): نتيجة مقبس_وينسوك, خطأ_مقبس_وينسوك {
    لو (!(*المستمع).مفتوح) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق());
    };
    دع المقبس_الجديد: غ64 = accept((*المستمع).القيمة, الفارغ, الفارغ);
    لو (المقبس_الجديد == (~(0 مثل غ64))) {
        أرجع نتيجة.خطأ(خطأ_عملية_وينسوك());
    };
    دع المقبس: مقبس_وينسوك = { القيمة: المقبس_الجديد, مفتوح: صواب };
    أرجع نتيجة.نجح(المقبس);
}

// SD_RECEIVE = 0, SD_SEND = 1, SD_BOTH = 2 (winsock2.h).
عام عرف أوقف_اتجاه_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, الاتجاه: ص32
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (الاتجاه < 0 || الاتجاه > 2) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع الحالة: ص32 = shutdown((*المقبس).القيمة, الاتجاه);
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(0);
}

// FIONBIO = _IOW('f',126,u_long) on Windows. This is the Windows
// Winsock IOCTL value, not an ioctl command copied from Linux.
عام عرف اضبط_مقبس_وينسوك_غير_حاصر(
    المقبس: &مقبس_وينسوك, مفعل: منطقي
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع القيمة: متغير غ32 = 0;
    لو (مفعل) { القيمة := 1; };
    دع الحالة: ص32 = ioctlsocket(
        (*المقبس).القيمة, 0x8004667E مثل ص32, &متغير القيمة
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(0);
}

// Native level and option numbers must be supplied by the Windows provider.
// A socket option stores an int in this operation, not an arbitrary blob.
عام عرف اضبط_خيار_عدد_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, المستوى: ص32, الخيار: ص32, القيمة: ص32
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع القيمة_المحلية: متغير ص32 = القيمة;
    دع الحالة: ص32 = setsockopt(
        (*المقبس).القيمة, المستوى, الخيار, &متغير القيمة_المحلية, 4
    );
    لو (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(0);
}

// A returned getsockopt int is native Windows socket state, not a Linux
// SOL_SOCKET option. Validate optlen before exposing the result.
عام عرف اقرأ_خيار_عدد_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, المستوى: ص32, الخيار: ص32
): نتيجة ص32, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع القيمة: متغير ص32 = 0;
    دع الطول: متغير ص32 = 4;
    لو (getsockopt((*المقبس).القيمة, المستوى, الخيار, &متغير القيمة, &متغير الطول) < 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_وينسوك());
    };
    لو (الطول != 4) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح()); };
    أرجع نتيجة.نجح(القيمة);
}

// sockaddr_storage is 128 bytes in Winsock. Return an owned copy of the
// address and never expose the stack/output scratch buffer to the caller.
عام عرف اقرأ_عنوان_محلي_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك
): نتيجة متجه غ8, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع المخزن: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 128) { ألحق(المخزن, 0 مثل غ8); الفهرس := الفهرس + 1; }
    دع الطول: متغير ص32 = 128;
    لو (getsockname((*المقبس).القيمة, &متغير المخزن[0], &متغير الطول) < 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_وينسوك());
    };
    لو (الطول < 2 || الطول > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول مثل غير_موقع)) {
        ألحق(الناتج, المخزن[الموضع]); الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عام عرف اقرأ_عنوان_نظير_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك
): نتيجة متجه غ8, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    دع المخزن: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 128) { ألحق(المخزن, 0 مثل غ8); الفهرس := الفهرس + 1; }
    دع الطول: متغير ص32 = 128;
    لو (getpeername((*المقبس).القيمة, &متغير المخزن[0], &متغير الطول) < 0) {
        أرجع نتيجة.خطأ(خطأ_عملية_وينسوك());
    };
    لو (الطول < 2 || الطول > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (الطول مثل غير_موقع)) {
        ألحق(الناتج, المخزن[الموضع]); الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

// sendto accepts an explicit Windows sockaddr, independently of whether the
// socket is connected. The address and payload are borrowed until return.
عام عرف أرسل_إلى_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك, العنوان: &متجه غ8,
    المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة عدد, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)
        || المطلوب > 2147483647 || الطول(*العنوان) < 2
        || الطول(*العنوان) > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    // Zero-byte datagrams are real datagrams and must reach the provider.
    // Supply a valid address even when the caller's byte vector is empty.
    دع المؤقت: متغير متجه غ8 = [0];
    دع المؤشر: متغير *غ8 = &المؤقت[0];
    لو (المطلوب > 0) { المؤشر := &(*المحتوى)[الإزاحة مثل غير_موقع]; };
    دع المرسل: ص32 = sendto(
        (*المقبس).القيمة, المؤشر,
        المطلوب مثل ص32, 0, &(*العنوان)[0], الطول(*العنوان) مثل ص32
    );
    لو (المرسل < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    أرجع نتيجة.نجح(المرسل مثل عدد);
}

عام نوع حزمة_واردة_وينسوك = { المقروء: عدد, العنوان: متجه غ8 };

// recvfrom returns both the transferred count and the exact source address.
// For a zero-length destination, calling recvfrom is still necessary: on a
// datagram socket it may dequeue a legitimate empty datagram.
عام عرف استقبل_من_مقبس_وينسوك(
    المقبس: &مقبس_وينسوك,
    المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
): نتيجة حزمة_واردة_وينسوك, خطأ_مقبس_وينسوك {
    لو (!(*المقبس).مفتوح) { أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.مغلق()); };
    لو (!نطاق_بايتات_نظام_صالح(الطول(*المخزن), الإزاحة, المطلوب)
        || المطلوب > 2147483647) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع العنوان: متغير متجه غ8 = [];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 128) { ألحق(العنوان, 0 مثل غ8); الفهرس := الفهرس + 1; }
    دع حجم_العنوان: متغير ص32 = 128;
    // A one-byte temporary buffer permits zero-length receive requests
    // without constructing a pointer past the end of the caller's vector.
    دع المؤقت: متغير متجه غ8 = [0];
    دع المؤشر: متغير *متغير غ8 = &متغير المؤقت[0];
    لو (المطلوب > 0) { المؤشر := &متغير (*المخزن)[الإزاحة مثل غير_موقع]; };
    دع المقروء: ص32 = recvfrom(
        (*المقبس).القيمة, المؤشر, المطلوب مثل ص32, 0,
        &متغير العنوان[0], &متغير حجم_العنوان
    );
    لو (المقروء < 0) { أرجع نتيجة.خطأ(خطأ_عملية_وينسوك()); };
    لو (حجم_العنوان < 0 || حجم_العنوان > 128) {
        أرجع نتيجة.خطأ(خطأ_مقبس_وينسوك.نطاق_غير_صالح());
    };
    دع المصدر: متغير متجه غ8 = [];
    دع الموضع: متغير غير_موقع = 0;
    بينما (الموضع < (حجم_العنوان مثل غير_موقع)) {
        ألحق(المصدر, العنوان[الموضع]); الموضع := الموضع + 1;
    }
    دع الحزمة: حزمة_واردة_وينسوك = { المقروء: المقروء مثل عدد, العنوان: المصدر };
    أرجع نتيجة.نجح(الحزمة);
}
