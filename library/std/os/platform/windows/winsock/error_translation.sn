استورد os.error;

// WSA error codes from Winsock2.h, not Win32 GetLastError or Unix errno.
عام عرف صنف_خطأ_وينسوك(الرمز: ص32): صنف_خطأ_نظام {
    طابق الرمز مع
    | 10004 -> { أرجع صنف_خطأ_نظام.عملية_انقطعت(); }    // WSAEINTR
    | 10013 -> { أرجع صنف_خطأ_نظام.وصول_مرفوض(); }      // WSAEACCES
    | 10014 -> { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); } // WSAEFAULT
    | 10022 -> { أرجع صنف_خطأ_نظام.وسيط_غير_صالح(); } // WSAEINVAL
    | 10035 -> { أرجع صنف_خطأ_نظام.عملية_ستحظر(); }    // WSAEWOULDBLOCK
    | 10045 -> { أرجع صنف_خطأ_نظام.غير_مدعوم(); }       // WSAEOPNOTSUPP
    | 10048 -> { أرجع صنف_خطأ_نظام.مورد_مشغول(); }     // WSAEADDRINUSE
    | 10050 -> { أرجع صنف_خطأ_نظام.شبكة_غير_متاحة(); } // WSAENETDOWN
    | 10051 -> { أرجع صنف_خطأ_نظام.شبكة_غير_متاحة(); } // WSAENETUNREACH
    | 10053 -> { أرجع صنف_خطأ_نظام.اتصال_انقطع(); }   // WSAECONNABORTED
    | 10054 -> { أرجع صنف_خطأ_نظام.اتصال_انقطع(); }   // WSAECONNRESET
    | 10055 -> { أرجع صنف_خطأ_نظام.استنفاد_الموارد(); } // WSAENOBUFS
    | 10060 -> { أرجع صنف_خطأ_نظام.انتهت_المهلة(); }  // WSAETIMEDOUT
    | 10061 -> { أرجع صنف_خطأ_نظام.اتصال_مرفوض(); }   // WSAECONNREFUSED
    | 10065 -> { أرجع صنف_خطأ_نظام.شبكة_غير_متاحة(); } // WSAEHOSTUNREACH
    | _ -> { أرجع صنف_خطأ_نظام.غير_معروف(); };
}

عام عرف ترجم_خطأ_وينسوك(الأصلي: خطأ_نظام_أصلي): خطأ_نظام {
    أرجع صنف_خطأ_نظام_أصليا(الأصلي, صنف_خطأ_وينسوك(الأصلي.الرمز مثل ص32));
}
