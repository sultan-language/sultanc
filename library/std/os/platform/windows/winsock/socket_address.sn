// Winsock sockaddr construction is a native source operation. No C library
// parses or formats these addresses. All registered Windows targets are
// little-endian, while TCP/UDP port numbers are stored in network byte order.
//
// Winsock2.h / Ws2def.h:
//   AF_INET=2, sockaddr_in=16 bytes, sin_port at offset 2, sin_addr at 4.
//   AF_INET6=23, sockaddr_in6=28 bytes, sin6_flowinfo at offset 4,
//   sin6_addr at offset 8, sin6_scope_id at offset 24.

عام نوع خطأ_عنوان_وينسوك =
    | طول_عنوان_غير_صالح
;

// The 8-byte sin_zero field is zeroed; do not copy Unix sockaddr_in's
// opaque storage or an architecture-dependent record layout.
عام عرف عنوان_مقبس_آيبي4_وينسوك(
    العنوان: &متجه غ8, المنفذ: غ16
): نتيجة متجه غ8, خطأ_عنوان_وينسوك {
    لو (الطول(*العنوان) != 4) {
        أرجع نتيجة.خطأ(خطأ_عنوان_وينسوك.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [
        2, 0,
        ((المنفذ >> 8) & 255) مثل غ8,
        (المنفذ & 255) مثل غ8,
        (*العنوان)[0], (*العنوان)[1], (*العنوان)[2], (*العنوان)[3],
        0, 0, 0, 0, 0, 0, 0, 0
    ];
    أرجع نتيجة.نجح(الناتج);
}

// Flow information and the 128-bit address use network byte order.
// scope_id is a host-order DWORD at offset 24 on these Windows targets.
عام عرف عنوان_مقبس_آيبي6_وينسوك(
    العنوان: &متجه غ8, المنفذ: غ16,
    معلومات_التدفق: غ32, نطاق_الواجهة: غ32
): نتيجة متجه غ8, خطأ_عنوان_وينسوك {
    لو (الطول(*العنوان) != 16) {
        أرجع نتيجة.خطأ(خطأ_عنوان_وينسوك.طول_عنوان_غير_صالح());
    };
    دع الناتج: متغير متجه غ8 = [
        23, 0,
        ((المنفذ >> 8) & 255) مثل غ8,
        (المنفذ & 255) مثل غ8,
        ((معلومات_التدفق >> 24) & 255) مثل غ8,
        ((معلومات_التدفق >> 16) & 255) مثل غ8,
        ((معلومات_التدفق >> 8) & 255) مثل غ8,
        (معلومات_التدفق & 255) مثل غ8
    ];
    دع الفهرس: متغير غير_موقع = 0;
    بينما (الفهرس < 16) {
        ألحق(الناتج, (*العنوان)[الفهرس]);
        الفهرس := الفهرس + 1;
    }
    ألحق(الناتج, (نطاق_الواجهة & 255) مثل غ8);
    ألحق(الناتج, ((نطاق_الواجهة >> 8) & 255) مثل غ8);
    ألحق(الناتج, ((نطاق_الواجهة >> 16) & 255) مثل غ8);
    ألحق(الناتج, ((نطاق_الواجهة >> 24) & 255) مثل غ8);
    أرجع نتيجة.نجح(الناتج);
}
