استورد os.path;
استورد os.error;
استورد os.platform.windows.winsock.sockets;

// GetAddrInfoW/FreeAddrInfoW are native Winsock functions from Ws2_32,
// not C-runtime getaddrinfo. ADDRINFOW (ws2def.h) is 48 bytes on both
// registered 64-bit Windows ABIs: four int fields, size_t and three pointers.
// The linked list and native sockaddr buffers belong entirely to Winsock;
// returned SultanC vectors copy bytes before FreeAddrInfoW releases them.
نوع سجل_حل_عنوان_وينسوك_أصلي = {
    الأعلام: ص32,
    العائلة: ص32,
    نوع_المقبس: ص32,
    البروتوكول: ص32,
    طول_العنوان: ط64,
    الاسم_القانوني: *ط16,
    العنوان: *ط8,
    التالي: *سجل_حل_عنوان_وينسوك_أصلي
};

خارجي «ws2_32.dll» عرف GetAddrInfoW(
    المضيف: *ط16, الخدمة: *ط16,
    الخيارات: *سجل_حل_عنوان_وينسوك_أصلي,
    القائمة: *متغير *سجل_حل_عنوان_وينسوك_أصلي
): ص32;
خارجي «ws2_32.dll» عرف FreeAddrInfoW(القائمة: *سجل_حل_عنوان_وينسوك_أصلي): فراغ;

عام نوع عنوان_محلول_وينسوك = {
    العائلة: ص32,
    نوع_المقبس: ص32,
    البروتوكول: ص32,
    البايتات: متجه ط8
};

عام نوع خطأ_حل_عنوان_وينسوك =
    | جلسة_غير_نشطة
    | اسم_غير_صالح
    | عنوان_غير_صالح
    | نظام بنوع خطأ_نظام_أصلي
;

// A result is always an owned snapshot. The first parameter must be a valid
// host name, and an empty service denotes no requested service. Unicode host names
// are handed to the Windows resolver, never passed as Unix locale bytes.
عام عرف حل_اسم_مضيف_وينسوك(
    الجلسة: &جلسة_وينسوك, المضيف: &نص, الخدمة: &نص
): نتيجة متجه عنوان_محلول_وينسوك, خطأ_حل_عنوان_وينسوك {
    إذا (!(*الجلسة).نشطة) {
        أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.جلسة_غير_نشطة());
    };
    إذا (الطول(*المضيف) == 0) {
        أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.اسم_غير_صالح());
    };
    طابق وحدات_مسار_ويندوز_صفرية(المضيف) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.اسم_غير_صالح());
    }
    | نتيجة.نجح(وحدات_المضيف) -> {
        طابق وحدات_مسار_ويندوز_صفرية(الخدمة) مع
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.اسم_غير_صالح());
        }
        | نتيجة.نجح(وحدات_الخدمة) -> {
            دع اسم_المضيف: متغير متجه ط16 = وحدات_المضيف;
            دع اسم_الخدمة: متغير متجه ط16 = وحدات_الخدمة;
            دع مؤشر_الخدمة: متغير *ط16 = الفارغ;
            إذا (الطول(*الخدمة) != 0) {
                مؤشر_الخدمة := &متغير اسم_الخدمة[0];
            };
            دع قائمة_النتائج: متغير *سجل_حل_عنوان_وينسوك_أصلي = الفارغ;
            دع الحالة: ص32 = GetAddrInfoW(
                &متغير اسم_المضيف[0], مؤشر_الخدمة,
                الفارغ, &متغير قائمة_النتائج
            );
            // GetAddrInfoW returns its own explicit error code; do not
            // consult WSAGetLastError in this failure branch.
            إذا (الحالة != 0) {
                أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.نظام(
                    أنشئ_خطأ_نظام_أصلي(مصدر_خطأ_نظام.وينسوك(), الحالة مثل عدد)
                ));
            };
            دع العناوين: متغير متجه عنوان_محلول_وينسوك = [];
            دع الحالي: متغير *سجل_حل_عنوان_وينسوك_أصلي = قائمة_النتائج;
            // The resolver owns list links and the sockaddr byte buffers;
            // read them only while its allocation is still live.
            غير_آمن {
                طالما (الحالي != الفارغ) {
                    دع طول_العنوان: ط64 = (*الحالي).طول_العنوان;
                    دع بايتات_العنوان: *ط8 = (*الحالي).العنوان;
                    // sockaddr_storage on Winsock is 128 bytes. Do not
                    // truncate a provider address or return borrowed data.
                    إذا (طول_العنوان == 0 || طول_العنوان > 128
                        || بايتات_العنوان == الفارغ) {
                        FreeAddrInfoW(قائمة_النتائج);
                        أرجع نتيجة.خطأ(خطأ_حل_عنوان_وينسوك.عنوان_غير_صالح());
                    };
                    دع البايتات: متغير متجه ط8 = [];
                    دع الموضع: متغير طبيعي = 0;
                    طالما (الموضع < (طول_العنوان مثل طبيعي)) {
                        ألحق(البايتات, بايتات_العنوان[الموضع]);
                        الموضع := الموضع + 1;
                    }
                    دع العنوان: عنوان_محلول_وينسوك = {
                        العائلة: (*الحالي).العائلة,
                        نوع_المقبس: (*الحالي).نوع_المقبس,
                        البروتوكول: (*الحالي).البروتوكول,
                        البايتات: البايتات
                    };
                    ألحق(العناوين, العنوان);
                    الحالي := (*الحالي).التالي;
                }
            }
            FreeAddrInfoW(قائمة_النتائج);
            أرجع نتيجة.نجح(العناوين);
        };
    };
}
