استورد os.error;

// Unix domain socket addresses: the platform's struct sockaddr_un, so
// std.net.unix never reads a platform layout. Every layout starts with a
// two-byte header and holds the path after it:
//
// - Linux, Android: sa_family_t (u16, the kernel's byte order) and
//   sun_path[108] (include/uapi/linux/un.h). A path starting with a NUL byte
//   is an abstract name (unix(7)): the bytes after it, NULs included, up to
//   the address length, with no file behind it. An address of the header
//   alone is an unnamed socket.
// - FreeBSD, macOS: sun_len (u8, the address length) and sun_family (u8),
//   then sun_path[104] (<sys/un.h>). No abstract names.
// - Windows 10 1803+: ADDRESS_FAMILY (u16, little-endian) and
//   sun_path[108] (<afunix.h>). No abstract names here.
//
// A pathname address is the path, then a terminating NUL, which the
// address length includes (Rust's std::os::unix::net does the same); the
// path must leave room for that NUL. Kinds: 0 unnamed, 1 pathname,
// 2 abstract.

عام نوع عنوان_يونكس_نظام = { النوع: عدد, البايتات: متجه ط8 };

لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
لو (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
لو ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    عرف حجم_مسار_يونكس_نظام(): طبيعي { أرجع حجم_مسار_مقبس_يونكس_لينكس(); }
    // FreeBSD's sockaddr starts with sa_len (عنوان_مقبس_بطول_لينكس).
    عرف عنوان_يونكس_بطول_نظام(): منطقي { أرجع عنوان_مقبس_بطول_لينكس(); }
    عرف عائلة_يونكس_بترتيب_كبير_نظام(): منطقي { أرجع ترتيب_بايت_كبير_لينكس(); }
    عرف عائلة_يونكس_نظام(): ط64 { أرجع عائلة_يونكس_لينكس(); }
    عام عرف هل_العنوان_المجرد_مدعوم_نظام(): منطقي { أرجع !عنوان_مقبس_بطول_لينكس(); }
}
لو (الهدف.المنصة == «macos») {
    عرف حجم_مسار_يونكس_نظام(): طبيعي { أرجع 104; }
    عرف عنوان_يونكس_بطول_نظام(): منطقي { أرجع صواب; }
    عرف عائلة_يونكس_بترتيب_كبير_نظام(): منطقي { أرجع خطأ; }
    عرف عائلة_يونكس_نظام(): ط64 { أرجع 1; }
    عام عرف هل_العنوان_المجرد_مدعوم_نظام(): منطقي { أرجع خطأ; }
}
لو (الهدف.المنصة == «windows») {
    عرف حجم_مسار_يونكس_نظام(): طبيعي { أرجع 108; }
    عرف عنوان_يونكس_بطول_نظام(): منطقي { أرجع خطأ; }
    عرف عائلة_يونكس_بترتيب_كبير_نظام(): منطقي { أرجع خطأ; }
    عرف عائلة_يونكس_نظام(): ط64 { أرجع 1; }
    عام عرف هل_العنوان_المجرد_مدعوم_نظام(): منطقي { أرجع خطأ; }
}
لو (الهدف.المنصة == «wasi») {
    // WASI preview 1 has no Unix domain sockets: creating one reports
    // ENOTSUP, so these values are never put to use.
    عرف حجم_مسار_يونكس_نظام(): طبيعي { أرجع 108; }
    عرف عنوان_يونكس_بطول_نظام(): منطقي { أرجع خطأ; }
    عرف عائلة_يونكس_بترتيب_كبير_نظام(): منطقي { أرجع خطأ; }
    عرف عائلة_يونكس_نظام(): ط64 { أرجع 1; }
    عام عرف هل_العنوان_المجرد_مدعوم_نظام(): منطقي { أرجع خطأ; }
}

// The two header bytes for an address of الطول bytes in all.
عرف ألحق_رأس_عنوان_يونكس(الناتج: &متغير متجه ط8, الطول: طبيعي): فراغ {
    دع العائلة: ط8 = عائلة_يونكس_نظام() مثل ط8;
    لو (عنوان_يونكس_بطول_نظام()) {
        ألحق(*الناتج, الطول مثل ط8);
        ألحق(*الناتج, العائلة);
    } وإلا لو (عائلة_يونكس_بترتيب_كبير_نظام()) {
        ألحق(*الناتج, 0);
        ألحق(*الناتج, العائلة);
    } وإلا {
        ألحق(*الناتج, العائلة);
        ألحق(*الناتج, 0);
    };
}

// The sockaddr_un of a path (مجرد خطأ) or of an abstract name (مجرد صواب,
// Linux and Android only). A path is non-empty, has no NUL byte and is
// shorter than sun_path; an abstract name fits in sun_path after its
// leading NUL.
عام عرف رمز_عنوان_يونكس_نظام(الاسم: &متجه ط8, مجرد: منطقي): نتيجة متجه ط8, خطأ_حد_نظام {
    دع العدد: طبيعي = الطول(*الاسم) مثل طبيعي;
    دع الحد: طبيعي = حجم_مسار_يونكس_نظام();
    دع الناتج: متغير متجه ط8 = [];
    لو (مجرد) {
        لو (!هل_العنوان_المجرد_مدعوم_نظام() || العدد + 1 > الحد) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        ألحق_رأس_عنوان_يونكس(&متغير الناتج, العدد + 3);
        ألحق(الناتج, 0);
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) { ألحق(الناتج, (*الاسم)[ف]); ف := ف + 1; }
        أرجع نتيجة.نجح(الناتج);
    };
    لو (العدد == 0 || العدد >= الحد) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
    ألحق_رأس_عنوان_يونكس(&متغير الناتج, العدد + 3);
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        لو ((*الاسم)[ف] == 0) { أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح()); };
        ألحق(الناتج, (*الاسم)[ف]);
        ف := ف + 1;
    }
    ألحق(الناتج, 0);
    أرجع نتيجة.نجح(الناتج);
}

// The kind and name of a sockaddr_un the system returned (getsockname,
// getpeername, recvfrom). A header alone, or a family of 0 (AF_UNSPEC: an
// unbound sender on some systems), is unnamed; a pathname stops at its
// first NUL.
عام عرف فك_عنوان_يونكس_نظام(البايتات: &متجه ط8): نتيجة عنوان_يونكس_نظام, خطأ_حد_نظام {
    دع العدد: طبيعي = الطول(*البايتات) مثل طبيعي;
    دع فارغ: متجه ط8 = [];
    دع بلا_اسم: عنوان_يونكس_نظام = { النوع: 0, البايتات: فارغ };
    لو (العدد <= 2) { أرجع نتيجة.نجح(بلا_اسم); };
    دع العائلة: متغير ط64 = (*البايتات)[1] مثل ط64;
    لو (!عنوان_يونكس_بطول_نظام()) {
        لو (عائلة_يونكس_بترتيب_كبير_نظام()) {
            العائلة := (((*البايتات)[0] مثل ط64) << 8) | ((*البايتات)[1] مثل ط64);
        } وإلا {
            العائلة := ((*البايتات)[0] مثل ط64) | (((*البايتات)[1] مثل ط64) << 8);
        };
    };
    لو (العائلة == 0) { أرجع نتيجة.نجح(بلا_اسم); };
    لو (العائلة != عائلة_يونكس_نظام()) { أرجع نتيجة.خطأ(خطأ_حد_نظام.رد_شبكة_غير_صالح()); };
    دع الاسم: متغير متجه ط8 = [];
    لو ((*البايتات)[2] == 0) {
        لو (!هل_العنوان_المجرد_مدعوم_نظام()) { أرجع نتيجة.نجح(بلا_اسم); };
        دع ف: متغير طبيعي = 3;
        طالما (ف < العدد) { ألحق(الاسم, (*البايتات)[ف]); ف := ف + 1; }
        دع المجرد: عنوان_يونكس_نظام = { النوع: 2, البايتات: الاسم };
        أرجع نتيجة.نجح(المجرد);
    };
    دع ف: متغير طبيعي = 2;
    طالما (ف < العدد && (*البايتات)[ف] != 0) { ألحق(الاسم, (*البايتات)[ف]); ف := ف + 1; }
    دع المسار: عنوان_يونكس_نظام = { النوع: 1, البايتات: الاسم };
    أرجع نتيجة.نجح(المسار);
}
