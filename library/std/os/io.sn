استورد os.error;

// Only native stream operations live here. Each write makes one OS call and
// may report a short count; retry and buffering policy belongs to std.io.
لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_تيار_لينكس_للنظام(الخطأ: خطأ_واصف_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_واصف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_واصف_لينكس.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); };
    }

    عام عرف اقرأ_دخلا_قياسيا_للنظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دخل_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة()),
            المخزن, الإزاحة, المطلوب
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عرف اكتب_تيارا_قياسيا_لينكس(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد, الواصف: غ64
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_تيار_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.كتابة()),
            الواصف, المحتوى, الإزاحة, المطلوب
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عام عرف اكتب_خرجا_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_لينكس(المحتوى, الإزاحة, المطلوب, 1 مثل غ64);
    }

    عام عرف اكتب_خطأ_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_لينكس(المحتوى, الإزاحة, المطلوب, 2 مثل غ64);
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.buffer;
    استورد os.platform.windows.win32.file_handles;

    عرف خطأ_تيار_ويندوز_للنظام(الخطأ: خطأ_مقبض_ملف_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مقبض_ملف_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
        | خطأ_مقبض_ملف_ويندوز.مقبض_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_مقبض_ملف_ويندوز.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبض_ملف_ويندوز.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مقبض_ملف_ويندوز.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); };
    }

    عام عرف اقرأ_دخلا_قياسيا_للنظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دخلا_قياسيا_ويندوز(المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }

    عرف اكتب_تيارا_قياسيا_للويندوز(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد, التيار: تيار_قياسي_ويندوز
    ): نتيجة عدد, خطأ_حد_نظام {
        لو (!نطاق_بايتات_نظام_صالح(الطول(*المحتوى), الإزاحة, المطلوب)) {
            أرجع نتيجة.خطأ(خطأ_حد_نظام.وسيط_غير_صالح());
        };
        // The native WriteFile count is a DWORD. Keep each call bounded;
        // std.io.writer handles the remaining bytes after a short write.
        دع الدفعة: متغير عدد = المطلوب;
        لو (الدفعة > 2147483647) { الدفعة := 2147483647; };
        طابق اكتب_تيارا_قياسيا_ويندوز(التيار, المحتوى, الإزاحة, الدفعة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_تيار_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }

    عام عرف اكتب_خرجا_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_للويندوز(
            المحتوى, الإزاحة, المطلوب, تيار_قياسي_ويندوز.خرج()
        );
    }

    عام عرف اكتب_خطأ_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_للويندوز(
            المحتوى, الإزاحة, المطلوب, تيار_قياسي_ويندوز.خطأ()
        );
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_descriptors;

    عام عرف اقرأ_دخلا_قياسيا_للنظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دخل_داروين(المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عرف اكتب_تيارا_قياسيا_داروين(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد, الواصف: غ64
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_تيار_داروين(الواصف, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عام عرف اكتب_خرجا_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_داروين(المحتوى, الإزاحة, المطلوب, 1 مثل غ64);
    }

    عام عرف اكتب_خطأ_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_داروين(المحتوى, الإزاحة, المطلوب, 2 مثل غ64);
    }
}

// WASI command standard streams are descriptors 0, 1 and 2.
لو (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;

    عام عرف اقرأ_دخلا_قياسيا_للنظام(
        المخزن: &متغير متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اقرأ_دخل_واسي(المخزن, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عرف اكتب_تيارا_قياسيا_واسي(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد, الواصف: غ64
    ): نتيجة عدد, خطأ_حد_نظام {
        طابق اكتب_تيار_واسي(الواصف, المحتوى, الإزاحة, المطلوب) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }

    عام عرف اكتب_خرجا_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_واسي(المحتوى, الإزاحة, المطلوب, 1 مثل غ64);
    }

    عام عرف اكتب_خطأ_قياسيا_للنظام(
        المحتوى: &متجه غ8, الإزاحة: عدد, المطلوب: عدد
    ): نتيجة عدد, خطأ_حد_نظام {
        أرجع اكتب_تيارا_قياسيا_واسي(المحتوى, الإزاحة, المطلوب, 2 مثل غ64);
    }
}
