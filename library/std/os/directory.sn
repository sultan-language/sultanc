استورد os.error;
استورد os.path;

// Directory names retain their native bytes. Directory listings own and
// release the selected platform search resource before returning the list.
// A textual std.fs consumer may later apply its own encoding policy.
عام نوع مدخل_نظام = { الاسم: متجه غ8, النوع: عدد };

// mkdirat/unlinkat on Linux, CreateDirectoryW/RemoveDirectoryW on Windows.
// A directory path is not opened merely to create or remove it. Linux uses
// mkdirat/unlinkat(AT_REMOVEDIR); Windows uses the native W-path APIs.
لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.path_operations;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_دليل_لينكس_للنظام(الخطأ: خطأ_مسارات_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مسارات_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مسارات_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عام عرف أنشئ_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق أنشئ_دليل_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إنشاء_دليل_عند()),
            &البايتات, 493 مثل غ64
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_دليل_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أزل_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق احذف_مسار_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.حذف_عند()),
            &البايتات, صواب
        ) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_دليل_لينكس_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
}
لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.file_paths;

    عرف خطأ_دليل_ويندوز_للنظام(الخطأ: خطأ_مسارات_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_مسارات_ويندوز.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_مسارات_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }
    عام عرف أنشئ_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق أنشئ_دليلا_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_دليل_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
    عام عرف أزل_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        طابق احذف_دليلا_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_دليل_ويندوز_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); };
    }
}

لو (الهدف.المنصة == «linux» && (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64»)) {
    استورد os.platform.unix.linux.directory_streams;
    استورد os.platform.unix.linux.file_descriptors;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;

    عرف خطأ_دفعة_دليل_للنظام(الخطأ: خطأ_تيار_دليل_لينكس): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_تيار_دليل_لينكس.نطاق_غير_صالح -> {
            أرجع خطأ_حد_نظام.وسيط_غير_صالح();
        }
        | خطأ_تيار_دليل_لينكس.مدخل(_) -> {
            أرجع خطأ_حد_نظام.قيمة_خارج_النطاق();
        }
        | خطأ_تيار_دليل_لينكس.واصف(الواصف) -> {
            طابق الواصف مع
            | خطأ_واصف_لينكس.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); }
            | خطأ_واصف_لينكس.واصف_مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
            | خطأ_واصف_لينكس.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
            | خطأ_واصف_لينكس.نطاق_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
            | خطأ_واصف_لينكس.كتابة_بلا_تقدم -> { أرجع خطأ_حد_نظام.قيمة_خارج_النطاق(); };
        };
    }

    عرف اسم_مدخل_خاص_لينكس(الاسم: &متجه غ8): منطقي {
        دع العدد: غير_موقع = الطول(*الاسم) مثل غير_موقع;
        لو (العدد == 1 && (*الاسم)[0] == 46) { أرجع صواب; };
        أرجع العدد == 2 && (*الاسم)[0] == 46 && (*الاسم)[1] == 46;
    }

    عام عرف اقرأ_مداخل_دليل_النظام(المسار: &نص): نتيجة متجه مدخل_نظام, خطأ_حد_نظام {
        دع بايتات_المسار: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق افتح_دليل_لينكس(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.فتح_عند()), &بايتات_المسار
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_دفعة_دليل_للنظام(خطأ_تيار_دليل_لينكس.واصف(الخطأ)));
        }
        | نتيجة.نجح(المفتوح) -> {
            دع الواصف: متغير واصف_ملف_لينكس = المفتوح;
            دع الناتج: متغير متجه مدخل_نظام = [];
            دع انتهى: متغير منطقي = خطأ;
            بينما (!انتهى) {
                طابق اقرأ_دفعة_دليل_لينكس(
                    رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.قراءة_مداخل_دليل()),
                    &الواصف, 16384
                ) مع
                | نتيجة.خطأ(الخطأ) -> {
                    دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                        رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
                    );
                    أرجع نتيجة.خطأ(خطأ_دفعة_دليل_للنظام(الخطأ));
                }
                | نتيجة.نجح(المقروء) -> {
                    دع الدفعة: متغير دفعة_دليل_لينكس = المقروء;
                    لو (الدفعة.النهاية == 0) { انتهى := صواب; }
                    وإلا {
                        دع أكمل_الدفعة: متغير منطقي = صواب;
                        بينما (أكمل_الدفعة) {
                            طابق خذ_مدخل_دفعة_دليل_لينكس(&متغير الدفعة, صواب) مع
                            | نتيجة.خطأ(الخطأ) -> {
                                دع الإغلاق: نتيجة غ64, خطأ_واصف_لينكس = أغلق_واصف_لينكس(
                                    رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
                                );
                                أرجع نتيجة.خطأ(خطأ_دفعة_دليل_للنظام(الخطأ));
                            }
                            | نتيجة.نجح(المدخل_المحتمل) -> {
                                طابق المدخل_المحتمل مع
                                | اختيار.لا_شيء -> { أكمل_الدفعة := خطأ; }
                                | اختيار.بعض({ الاسم: اسم_المدخل, النوع: نوع_المدخل }) -> {
                                    // Destructure the owned entry; its name moves whole.
                                    لو (!اسم_مدخل_خاص_لينكس(&اسم_المدخل)) {
                                        دع النوع: متغير عدد = 4;
                                        لو (نوع_المدخل == 8) { النوع := 1; };
                                        لو (نوع_المدخل == 4) { النوع := 2; };
                                        لو (نوع_المدخل == 10) { النوع := 3; };
                                        دع الناتج_المقروء: مدخل_نظام = {
                                            الاسم: اسم_المدخل, النوع: النوع
                                        };
                                        ألحق(الناتج, الناتج_المقروء);
                                    };
                                };
                            };
                        }
                    };
                };
            }
            طابق أغلق_واصف_لينكس(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()), &متغير الواصف
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(خطأ_دفعة_دليل_للنظام(خطأ_تيار_دليل_لينكس.واصف(الخطأ)));
            }
            | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(الناتج); };
        };
    }
}

لو (الهدف.المنصة == «windows») {
    استورد os.platform.windows.win32.directory_streams;
    استورد os.platform.windows.win32.file_paths;

    عرف خطأ_بحث_دليل_للنظام(الخطأ: خطأ_بحث_ويندوز): خطأ_حد_نظام {
        طابق الخطأ مع
        | خطأ_بحث_ويندوز.مسار(_) -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_بحث_ويندوز.ترميز_غير_صالح -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_بحث_ويندوز.مغلق -> { أرجع خطأ_حد_نظام.مورد_مغلق(); }
        | خطأ_بحث_ويندوز.ليس_دليلا -> { أرجع خطأ_حد_نظام.وسيط_غير_صالح(); }
        | خطأ_بحث_ويندوز.مسارات(الخطأ) -> { أرجع خطأ_دليل_ويندوز_للنظام(الخطأ); }
        | خطأ_بحث_ويندوز.نظام(الأصلي) -> { أرجع خطأ_حد_نظام.نظام(الأصلي); };
    }

    عام عرف اقرأ_مداخل_دليل_النظام(المسار: &نص): نتيجة متجه مدخل_نظام, خطأ_حد_نظام {
        طابق اقرأ_مداخل_دليل_ويندوز(المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_بحث_دليل_للنظام(الخطأ)); }
        | نتيجة.نجح(المداخل) -> {
            دع الناتج: متغير متجه مدخل_نظام = [];
            دع الموضع: متغير غير_موقع = 0;
            بينما (الموضع < (الطول(المداخل) مثل غير_موقع)) {
                دع المصدر: مدخل_دليل_ويندوز = المداخل[الموضع];
                دع النوع: متغير عدد = 1;
                لو (سمات_مسار_ويندوز_دليل(المصدر.السمات)) { النوع := 2; };
                لو (سمات_مسار_ويندوز_وصلة(المصدر.السمات)) { النوع := 3; };
                دع المدخل: مدخل_نظام = {
                    الاسم: بايتات_مسار_نص_نظام(&المصدر.الاسم), النوع: النوع
                };
                ألحق(الناتج, المدخل);
                الموضع := الموضع + 1;
            }
            أرجع نتيجة.نجح(الناتج);
        };
    }
}

لو (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.directories;
    استورد os.platform.unix.apple.darwin.file_descriptors;

    عام عرف أنشئ_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق أنشئ_دليل_داروين(&البايتات, 493) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أزل_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق أزل_دليل_داروين(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    // DT_REG=8, DT_DIR=4, DT_LNK=10 map to the portable 1/2/3, else 4.
    عام عرف اقرأ_مداخل_دليل_النظام(المسار: &نص): نتيجة متجه مدخل_نظام, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_مداخل_دليل_داروين(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_داروين_للنظام(الخطأ)); }
        | نتيجة.نجح(المداخل) -> {
            دع المصادر: متغير متجه مدخل_دليل_داروين = المداخل;
            دع الناتج: متغير متجه مدخل_نظام = [];
            دع الموضع: متغير غير_موقع = 0;
            بينما (الموضع < (الطول(المصادر) مثل غير_موقع)) {
                دع اسم_فارغ: متجه غ8 = [];
                دع مدخل_فارغ: مدخل_دليل_داروين = { الاسم: اسم_فارغ, النوع: 0 };
                دع المصدر: متغير مدخل_دليل_داروين = مدخل_فارغ;
                بدّل(المصدر, المصادر[الموضع]);
                دع النوع: متغير عدد = 4;
                لو (المصدر.النوع == 8) { النوع := 1; };
                لو (المصدر.النوع == 4) { النوع := 2; };
                لو (المصدر.النوع == 10) { النوع := 3; };
                طابق المصدر مع
                | { الاسم: اسم_المدخل, النوع: _ } -> {
                    دع المدخل: مدخل_نظام = { الاسم: اسم_المدخل, النوع: النوع };
                    ألحق(الناتج, المدخل);
                };
                الموضع := الموضع + 1;
            }
            أرجع نتيجة.نجح(الناتج);
        };
    }
}

لو (الهدف.المنصة == «wasi») {
    استورد os.platform.wasi.preview1.file_descriptors;

    عام عرف أنشئ_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق أنشئ_دليل_واسي(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    عام عرف أزل_دليل_نظام(المسار: &نص): نتيجة عدد, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق أزل_دليل_واسي(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد مثل عدد); };
    }
    // WASI filetype 4 regular, 3 directory, 7 symlink map to the portable
    // 1/2/3, anything else to 4.
    عام عرف اقرأ_مداخل_دليل_النظام(المسار: &نص): نتيجة متجه مدخل_نظام, خطأ_حد_نظام {
        دع البايتات: متجه غ8 = بايتات_مسار_نص_نظام(المسار);
        طابق اقرأ_مداخل_دليل_واسي(&البايتات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_واصف_واسي_للنظام(الخطأ)); }
        | نتيجة.نجح(المداخل) -> {
            دع المصادر: متغير متجه مدخل_دليل_واسي = المداخل;
            دع الناتج: متغير متجه مدخل_نظام = [];
            دع الموضع: متغير غير_موقع = 0;
            بينما (الموضع < (الطول(المصادر) مثل غير_موقع)) {
                دع اسم_فارغ: متجه غ8 = [];
                دع مدخل_فارغ: مدخل_دليل_واسي = { الاسم: اسم_فارغ, النوع: 0 };
                دع المصدر: متغير مدخل_دليل_واسي = مدخل_فارغ;
                بدّل(المصدر, المصادر[الموضع]);
                دع النوع: متغير عدد = 4;
                لو (المصدر.النوع == 4) { النوع := 1; };
                لو (المصدر.النوع == 3) { النوع := 2; };
                لو (المصدر.النوع == 7) { النوع := 3; };
                طابق المصدر مع
                | { الاسم: اسم_المدخل, النوع: _ } -> {
                    دع المدخل: مدخل_نظام = { الاسم: اسم_المدخل, النوع: النوع };
                    ألحق(الناتج, المدخل);
                };
                الموضع := الموضع + 1;
            }
            أرجع نتيجة.نجح(الناتج);
        };
    }
}
