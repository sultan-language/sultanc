// The readiness poller (docs/en/reference/concurrency.md, "Readiness polling"):
// one kernel object that tells which of many non-blocking descriptors can be
// read or written, so one thread serves thousands of connections instead of
// one blocked thread per connection. After Rust's mio (Poll, Registry,
// Events), the layer under tokio, and Go's runtime netpoll:
//
// - Linux, Android: epoll (epoll_create1, epoll_ctl, epoll_pwait).
// - FreeBSD: kqueue and kevent, as raw system calls.
// - macOS: kqueue and kevent from libSystem, the supported Darwin interface.
// - Windows and every other target: not supported yet (هل_المستطلع_مدعوم
//   answers خطأ and every call fails with -95, EOPNOTSUPP). Windows needs
//   IOCP, a completion model rather than a readiness one.
//
// Every registration is one-shot: after one event the descriptor is
// disarmed until أعد_تسليح_في_مستطلع arms it again. Several threads can then
// wait on one poller at once and each descriptor is handed to exactly one of
// them at a time (EPOLLONESHOT; kqueue EV_ONESHOT), which is how a pool of
// worker threads shares one poller without locking each connection.
//
// Interest is reading or writing, never both: two armed kqueue filters
// could fire on two threads at once. A connection waits to read until its
// output is blocked, then waits to write.
//
// A token is the caller's ط64 naming the descriptor (a connection slot); the
// event gives it back. Errors are negated native error codes, as std.net.
// A wait interrupted by a signal answers 0 events.
//
// Nothing here is thread-unsafe: the kernel object serializes registration
// and waiting.

عام نوع اهتمام_مستطلع =
    | قراءة
    | كتابة
;

// One ready descriptor. انتهى is the peer's hang-up or an error on the
// descriptor: the owner should read once more (to see EOF or the error)
// and close it.
عام نوع حدث_مستطلع = {
    الرمز: ط64,
    قابل_للقراءة: منطقي,
    قابل_للكتابة: منطقي,
    انتهى: منطقي
};

عام نوع مستطلع = { الواصف: عدد, الحلقة: حلقة_مستطلع };

// An io_uring poller's rings (Linux; أنشئ_مستطلع_حلقي): absolute addresses
// of the mapped rings' fields. Unused (مفعلة false) everywhere else.
عام نوع حلقة_مستطلع = {
    مفعلة: منطقي,
    ق_رأس: ط64, ق_ذيل: ط64, ق_قناع: ط64, ق_مصفوفة: ط64, ق_عدد: ط64,
    إ_رأس: ط64, إ_ذيل: ط64, إ_قناع: ط64, إ_مدخلات: ط64,
    المدخلات: ط64,
    ق_منطقة: ط64, ق_طول: ط64, إ_منطقة: ط64, إ_طول: ط64, م_طول: ط64
};

عام عرف حلقة_مستطلع_فارغة(): حلقة_مستطلع {
    دع الناتج: حلقة_مستطلع = {
        مفعلة: خطأ, ق_رأس: 0, ق_ذيل: 0, ق_قناع: 0, ق_مصفوفة: 0, ق_عدد: 0,
        إ_رأس: 0, إ_ذيل: 0, إ_قناع: 0, إ_مدخلات: 0, المدخلات: 0,
        ق_منطقة: 0, ق_طول: 0, إ_منطقة: 0, إ_طول: 0, م_طول: 0
    };
    أرجع الناتج;
}

// A caller-owned event buffer: each waiting thread keeps its own and reuses
// it, so a wait allocates nothing.
عام نوع مخزن_أحداث_مستطلع = {
    البايتات: متجه ط8,
    السعة: طبيعي,
    العدد: طبيعي
};

// Little- or big-endian fields of the kernel records.
عرف اكتب_بايتات_عدد_مستطلع(المخزن: &متغير متجه ط8, الموضع: طبيعي, القيمة: ط64, العرض: طبيعي, كبير: منطقي): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع الإزاحة: ط64 = (ف * 8) مثل ط64;
        دع البايت: ط8 = ((القيمة >> الإزاحة) & 0xFF) مثل ط8;
        إذا (كبير) { (*المخزن)[الموضع + العرض - 1 - ف] := البايت; }
        وإلا { (*المخزن)[الموضع + ف] := البايت; };
        ف := ف + 1;
    }
}

عرف اقرأ_بايتات_عدد_مستطلع(المخزن: &متجه ط8, الموضع: طبيعي, العرض: طبيعي, كبير: منطقي): ط64 {
    دع القيمة: متغير ط64 = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العرض) {
        دع البايت: متغير ط8 = 0;
        إذا (كبير) { البايت := (*المخزن)[الموضع + ف]; }
        وإلا { البايت := (*المخزن)[الموضع + العرض - 1 - ف]; };
        القيمة := (القيمة << 8) | (البايت مثل ط64);
        ف := ف + 1;
    }
    أرجع القيمة;
}

عرف أصفار_مستطلع(العدد: طبيعي): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(الناتج, 0); ف := ف + 1; }
    أرجع الناتج;
}

// ---- Linux and Android: epoll ----
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد os.platform.unix.linux.uapi;
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;
    استورد os.platform.unix.linux.syscalls.kernel_result;

    عام عرف هل_المستطلع_مدعوم(): منطقي { أرجع صواب; }

    // EAGAIN and EINTR are the same on every Linux architecture std targets
    // (alpha and parisc, which differ, are not targets).
    عام عرف هل_خطأ_سيحظر(الرمز: عدد): منطقي { أرجع الرمز == -11; }
    عام عرف هل_خطأ_مقاطعة(الرمز: عدد): منطقي { أرجع الرمز == -4; }

    // <sys/epoll.h>: EPOLLIN 0x001, EPOLLOUT 0x004, EPOLLERR 0x008,
    // EPOLLHUP 0x010, EPOLLRDHUP 0x2000, EPOLLONESHOT 1 << 30; the same
    // values on every architecture.
    عرف أعلام_اهتمام_إي_بول(الاهتمام: اهتمام_مستطلع): ط64 {
        طابق الاهتمام مع
        | اهتمام_مستطلع.قراءة -> { أرجع 0x40002001 مثل ط64; }
        | اهتمام_مستطلع.كتابة -> { أرجع 0x40000004 مثل ط64; };
    }

    // struct epoll_event {u32 events; u64 data}: packed (12 bytes) on x86
    // and x86_64 (__EPOLL_PACKED), naturally aligned (16, data at 8)
    // everywhere else.
    إذا (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «x86») {
        عرف حجم_حدث_إي_بول(): طبيعي { أرجع 12; }
        عرف إزاحة_بيانات_إي_بول(): طبيعي { أرجع 4; }
    }
    إذا (!(الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «x86»)) {
        عرف حجم_حدث_إي_بول(): طبيعي { أرجع 16; }
        عرف إزاحة_بيانات_إي_بول(): طبيعي { أرجع 8; }
    }

    عرف نتيجة_نواة_مستطلع(الخام: ط64): نتيجة عدد, عدد {
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); }
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(0 - الأصلي.الرمز); };
    }

    عام عرف أنشئ_مستطلع(): نتيجة مستطلع, عدد {
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أنشئ_مستطلع_أحداث()),
            علم_فتح_إغلاق_عند_التنفيذ_لينكس(), 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق نتيجة_نواة_مستطلع(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الواصف) -> {
            دع الناتج: مستطلع = { الواصف: الواصف, الحلقة: حلقة_مستطلع_فارغة() };
            أرجع نتيجة.نجح(الناتج);
        };
    }

    // struct epoll_event in two words on the stack (no allocation per
    // registration): {u32 events; u64 data}, packed at 4 on x86 and x86_64,
    // at 8 elsewhere; big-endian targets store each field's bytes reversed.
    نوع حدث_إي_بول_خام = { الأولى: ط64, الثانية: ط64 };

    عرف تحكم_إي_بول(المستطلع: &مستطلع, العملية: ط64, الواصف: عدد, الأعلام: ط64, الرمز: ط64): نتيجة عدد, عدد {
        دع الحدث: متغير حدث_إي_بول_خام = { الأولى: 0, الثانية: 0 };
        إذا (إزاحة_بيانات_إي_بول() == 4) {
            الحدث.الأولى := (الأعلام & 0xFFFFFFFF) | (الرمز << 32);
            الحدث.الثانية := الرمز >> 32;
        } وإلا إذا (ترتيب_بايت_كبير_لينكس()) {
            الحدث.الأولى := (الأعلام & 0xFFFFFFFF) << 32;
            الحدث.الثانية := الرمز;
        } وإلا {
            الحدث.الأولى := الأعلام & 0xFFFFFFFF;
            الحدث.الثانية := الرمز;
        };
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.تحكم_مستطلع_أحداث()),
            (*المستطلع).الواصف مثل ط64, العملية, الواصف مثل ط64, &متغير الحدث.الأولى, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_نواة_مستطلع(الخام);
    }

    // EPOLL_CTL_ADD 1, EPOLL_CTL_DEL 2, EPOLL_CTL_MOD 3.
    عام عرف سجل_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
        إذا ((*المستطلع).الحلقة.مفعلة) { أرجع اطلب_استطلاع_حلقة(المستطلع, الواصف, الرمز, الاهتمام); };
        أرجع تحكم_إي_بول(المستطلع, 1 مثل ط64, الواصف, أعلام_اهتمام_إي_بول(الاهتمام), الرمز);
    }

    عام عرف أعد_تسليح_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
        إذا ((*المستطلع).الحلقة.مفعلة) { أرجع اطلب_استطلاع_حلقة(المستطلع, الواصف, الرمز, الاهتمام); };
        أرجع تحكم_إي_بول(المستطلع, 3 مثل ط64, الواصف, أعلام_اهتمام_إي_بول(الاهتمام), الرمز);
    }

    عام عرف ألغ_من_مستطلع(المستطلع: &مستطلع, الواصف: عدد): نتيجة عدد, عدد {
        إذا ((*المستطلع).الحلقة.مفعلة) { أرجع ألغ_استطلاعات_حلقة(المستطلع, الواصف); };
        أرجع تحكم_إي_بول(المستطلع, 2 مثل ط64, الواصف, 0 مثل ط64, 0 مثل ط64);
    }

    عام عرف أنشئ_مخزن_أحداث_مستطلع(السعة: طبيعي): مخزن_أحداث_مستطلع {
        دع الحد: متغير طبيعي = السعة;
        إذا (الحد == 0) { الحد := 1; };
        دع الناتج: مخزن_أحداث_مستطلع = {
            البايتات: أصفار_مستطلع(الحد * حجم_حدث_إي_بول()), السعة: الحد, العدد: 0
        };
        أرجع الناتج;
    }

    // epoll_pwait(epfd, events, maxevents, timeout_ms, NULL, 0). A negative
    // timeout waits without a deadline.
    عام عرف انتظر_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد {
        (*المخزن).العدد := 0;
        إذا ((*المستطلع).الحلقة.مفعلة) { أرجع انتظر_حلقة_مستطلع(المستطلع, المخزن, المهلة_بالملي); };
        دع المهلة: متغير عدد = المهلة_بالملي;
        إذا (المهلة < 0) { المهلة := -1; };
        إذا (المهلة > 2147483647) { المهلة := 2147483647; };
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مستطلع_أحداث()),
            (*المستطلع).الواصف مثل ط64, &متغير (*المخزن).البايتات[0], (*المخزن).السعة مثل ط64,
            المهلة مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق نتيجة_نواة_مستطلع(الخام) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة.نجح(0); };
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(العدد) -> {
            (*المخزن).العدد := العدد مثل طبيعي;
            أرجع نتيجة.نجح(العدد مثل طبيعي);
        };
    }

    عام عرف حدث_مستطلع_عند(المخزن: &مخزن_أحداث_مستطلع, الموضع: طبيعي): حدث_مستطلع {
        دع كبير: منطقي = ترتيب_بايت_كبير_لينكس();
        دع البداية: طبيعي = الموضع * حجم_حدث_إي_بول();
        دع الأعلام: ط64 = اقرأ_بايتات_عدد_مستطلع(&(*المخزن).البايتات, البداية, 4, كبير);
        دع الرمز: ط64 = اقرأ_بايتات_عدد_مستطلع(&(*المخزن).البايتات, البداية + إزاحة_بيانات_إي_بول(), 8, كبير);
        دع الحدث: حدث_مستطلع = {
            الرمز: الرمز,
            قابل_للقراءة: (الأعلام & 0x1) != 0,
            قابل_للكتابة: (الأعلام & 0x4) != 0,
            انتهى: (الأعلام & 0x2018) != 0
        };
        أرجع الحدث;
    }

    عام عرف أغلق_مستطلع(المستطلع: مستطلع): نتيجة عدد, عدد {
        إذا (المستطلع.الحلقة.مفعلة) { ألغ_ربط_حلقات_مستطلع(&المستطلع.الحلقة); };
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            المستطلع.الواصف مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_نواة_مستطلع(الخام);
    }

    // ---- io_uring (أنشئ_مستطلع_حلقي) ----
    // The same one-shot readiness interface over an io_uring: a
    // registration is an IORING_OP_POLL_ADD written into the submission ring
    // (no system call), and a wait submits every pending one and waits in a
    // single io_uring_enter, where epoll takes one epoll_ctl per re-arm and
    // one epoll_pwait. A ring belongs to one thread (the sharded evented
    // server's workers each own one): it is not shared. Linux 5.11+ on the
    // 64-bit little-endian targets; elsewhere, or when the kernel refuses
    // (seccomp, io_uring_disabled), the poller is epoll.
    إذا (الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «riscv64» || الهدف.المعمارية == «loongarch64») {
        استورد sync.atomic;
        استورد os.platform.unix.linux.virtual_memory;
        استورد env.system;

        مرادف اقرأ_كلمة_حلقة = بدائي_اقرأ_ذاكرة_الآلة;
        مرادف اكتب_كلمة_حلقة = بدائي_اكتب_ذاكرة_الآلة;
        مرادف احمل_ذري_حلقة = بدائي_ذري_حمل;
        مرادف اخزن_ذري_حلقة = بدائي_ذري_خزن;

        // A ring field (u32) read with acquire, written with release.
        عرف احمل32_حلقة(العنوان: ط64): ط64 {
            دع م: *متغير ذرة_ط32;
            دع ق: ط32;
            غير_آمن {
                م := العنوان مثل *متغير ذرة_ط32;
                ق := احمل_ذري_حلقة(&(*م).القيمة, 2);
            }
            أرجع ق مثل ط64;
        }
        عرف اخزن32_حلقة(العنوان: ط64, القيمة: ط64): فراغ {
            دع م: *متغير ذرة_ط32;
            غير_آمن {
                م := العنوان مثل *متغير ذرة_ط32;
                اخزن_ذري_حلقة(&(*م).القيمة, (القيمة & 0xFFFFFFFF) مثل ط32, 1);
            }
        }

        عرف دخول_حلقة(الواصف: عدد, للإرسال: ط64, أدنى_اكتمال: ط64, الأعلام: ط64, الوسيطة: ط64, الحجم: ط64): نتيجة عدد, عدد {
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.دخول_حلقة_إدخال()),
                الواصف مثل ط64, للإرسال, أدنى_اكتمال, الأعلام, الوسيطة, الحجم
            ); }
            أرجع نتيجة_نواة_مستطلع(الخام);
        }

        عرف اربط_حلقة(الواصف: عدد, الطول: ط64, الإزاحة: ط64): ط64 {
            // PROT_READ | PROT_WRITE, MAP_SHARED | MAP_POPULATE.
            طابق اربط_ذاكرة_لينكس(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.ربط_ذاكرة()),
                الطول, 3 مثل ط64, 0x8001 مثل ط64, الواصف مثل ص64, الإزاحة
            ) مع
            | نتيجة.نجح(المنطقة) -> { أرجع المنطقة.العنوان; }
            | نتيجة.خطأ(_) -> { أرجع 0; };
        }

        عرف ألغ_ربط_حلقة(العنوان: ط64, الطول: ط64): فراغ {
            إذا (العنوان == 0) { أرجع; };
            دع المنطقة: متغير منطقة_ذاكرة_لينكس = { العنوان: العنوان, الطول: الطول, نشطة: صواب };
            دع تجاهل: نتيجة ط64, خطأ_ذاكرة_لينكس = ألغ_ربط_ذاكرة_لينكس(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إلغاء_ربط_ذاكرة()), &متغير المنطقة
            );
        }

        عرف ألغ_ربط_حلقات_مستطلع(الحلقة: &حلقة_مستطلع): فراغ {
            ألغ_ربط_حلقة((*الحلقة).المدخلات, (*الحلقة).م_طول);
            إذا ((*الحلقة).إ_منطقة != (*الحلقة).ق_منطقة) { ألغ_ربط_حلقة((*الحلقة).إ_منطقة, (*الحلقة).إ_طول); };
            ألغ_ربط_حلقة((*الحلقة).ق_منطقة, (*الحلقة).ق_طول);
        }

        // io_uring_setup with 256 entries; the rings mapped as the kernel's
        // io_uring_params describes them (sq_off at 40, cq_off at 80).
        عام عرف أنشئ_مستطلع_حلقي(): نتيجة مستطلع, عدد {
            دع المفتاح: نص = «SULTANC_IO_URING»;
            طابق متغير_بيئة_النظام(&المفتاح) مع
            | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
                إذا ((الطول(القيمة) مثل طبيعي) == 1 && القيمة[0] == (0x30 مثل ط8)) { أرجع أنشئ_مستطلع(); };
            }
            | _ -> { };
            دع المعاملات: متغير متجه ط8 = أصفار_مستطلع(120);
            دع الخام: ط64;
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إعداد_حلقة_إدخال()),
                256 مثل ط64, &متغير المعاملات[0], 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
            ); }
            دع الواصف: عدد;
            طابق نتيجة_نواة_مستطلع(الخام) مع
            | نتيجة.خطأ(_) -> { أرجع أنشئ_مستطلع(); }
            | نتيجة.نجح(و) -> { الواصف := و; };
            دع عدد_ق: ط64 = اقرأ_بايتات_عدد_مستطلع(&المعاملات, 0, 4, خطأ);
            دع عدد_إ: ط64 = اقرأ_بايتات_عدد_مستطلع(&المعاملات, 4, 4, خطأ);
            دع الميزات: ط64 = اقرأ_بايتات_عدد_مستطلع(&المعاملات, 20, 4, خطأ);
            // IORING_FEAT_SINGLE_MMAP 1, IORING_FEAT_EXT_ARG (timed waits) 1 << 8.
            إذا ((الميزات & 0x100) == 0) {
                دع تجاهل: نتيجة عدد, عدد = أغلق_مستطلع({ الواصف: الواصف, الحلقة: حلقة_مستطلع_فارغة() });
                أرجع أنشئ_مستطلع();
            };
            دع طول_ق: متغير ط64 = اقرأ_بايتات_عدد_مستطلع(&المعاملات, 64, 4, خطأ) + عدد_ق * 4;
            دع طول_إ: متغير ط64 = اقرأ_بايتات_عدد_مستطلع(&المعاملات, 100, 4, خطأ) + عدد_إ * 16;
            دع منطقة_ق: ط64;
            دع منطقة_إ: متغير ط64 = 0;
            إذا ((الميزات & 1) != 0) {
                إذا (طول_إ > طول_ق) { طول_ق := طول_إ; };
                طول_إ := طول_ق;
                منطقة_ق := اربط_حلقة(الواصف, طول_ق, 0);
                منطقة_إ := منطقة_ق;
            } وإلا {
                منطقة_ق := اربط_حلقة(الواصف, طول_ق, 0);
                منطقة_إ := اربط_حلقة(الواصف, طول_إ, 0x8000000);
            };
            دع طول_م: ط64 = عدد_ق * 64;
            دع المدخلات: ط64 = اربط_حلقة(الواصف, طول_م, 0x10000000);
            دع الحلقة: حلقة_مستطلع = {
                مفعلة: صواب,
                ق_رأس: منطقة_ق + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 40, 4, خطأ), ق_ذيل: منطقة_ق + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 44, 4, خطأ), ق_قناع: منطقة_ق + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 48, 4, خطأ),
                ق_مصفوفة: منطقة_ق + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 64, 4, خطأ), ق_عدد: عدد_ق,
                إ_رأس: منطقة_إ + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 80, 4, خطأ), إ_ذيل: منطقة_إ + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 84, 4, خطأ), إ_قناع: منطقة_إ + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 88, 4, خطأ),
                إ_مدخلات: منطقة_إ + اقرأ_بايتات_عدد_مستطلع(&المعاملات, 100, 4, خطأ),
                المدخلات: المدخلات,
                ق_منطقة: منطقة_ق, ق_طول: طول_ق, إ_منطقة: منطقة_إ, إ_طول: طول_إ, م_طول: طول_م
            };
            إذا (منطقة_ق == 0 || منطقة_إ == 0 || المدخلات == 0) {
                ألغ_ربط_حلقات_مستطلع(&الحلقة);
                دع تجاهل: نتيجة عدد, عدد = أغلق_مستطلع({ الواصف: الواصف, الحلقة: حلقة_مستطلع_فارغة() });
                أرجع أنشئ_مستطلع();
            };
            دع الناتج: مستطلع = { الواصف: الواصف, الحلقة: الحلقة };
            أرجع نتيجة.نجح(الناتج);
        }

        // Writes one submission (64 bytes as eight words) and publishes it;
        // a full ring is submitted first.
        عرف أضف_مدخل_حلقة(المستطلع: &مستطلع, الأولى: ط64, الرابعة: ط64, المستخدم: ط64): نتيجة عدد, عدد {
            دع ح: &حلقة_مستطلع = &(*المستطلع).الحلقة;
            دع الذيل: ط64 = احمل32_حلقة((*ح).ق_ذيل);
            دع الرأس: ط64 = احمل32_حلقة((*ح).ق_رأس);
            إذا (((الذيل - الرأس) & 0xFFFFFFFF) >= (*ح).ق_عدد) {
                طابق دخول_حلقة((*المستطلع).الواصف, (الذيل - الرأس) & 0xFFFFFFFF, 0, 0, 0, 0) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
            دع الموضع: ط64 = الذيل & احمل32_حلقة((*ح).ق_قناع);
            دع المدخل: ط64 = (*ح).المدخلات + الموضع * 64;
            غير_آمن {
                اكتب_كلمة_حلقة(المدخل, الأولى);
                اكتب_كلمة_حلقة(المدخل + 8, 0);
                اكتب_كلمة_حلقة(المدخل + 16, 0);
                اكتب_كلمة_حلقة(المدخل + 24, الرابعة);
                اكتب_كلمة_حلقة(المدخل + 32, المستخدم);
                اكتب_كلمة_حلقة(المدخل + 40, 0);
                اكتب_كلمة_حلقة(المدخل + 48, 0);
                اكتب_كلمة_حلقة(المدخل + 56, 0);
            }
            اخزن32_حلقة((*ح).ق_مصفوفة + الموضع * 4, الموضع);
            اخزن32_حلقة((*ح).ق_ذيل, الذيل + 1);
            أرجع نتيجة.نجح(0);
        }

        // IORING_OP_POLL_ADD (6) for POLLIN|POLLRDHUP or POLLOUT; the event's
        // user data is the caller's token.
        عرف اطلب_استطلاع_حلقة(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
            إذا (الرمز == ~(0 مثل ط64)) { أرجع نتيجة.خطأ(-22); };
            دع الأحداث: متغير ط64 = 0x4;
            طابق الاهتمام مع
            | اهتمام_مستطلع.قراءة -> { الأحداث := 0x2001; }
            | اهتمام_مستطلع.كتابة -> { };
            أرجع أضف_مدخل_حلقة(المستطلع, 6 | ((الواصف مثل ط64 & 0xFFFFFFFF) << 32), الأحداث << 32, الرمز);
        }

        // IORING_OP_ASYNC_CANCEL (14) of every request on the descriptor
        // (IORING_ASYNC_CANCEL_ALL | IORING_ASYNC_CANCEL_FD, Linux 5.19+); its
        // completion carries the reserved token and is skipped.
        // Submitted at once: the caller closes the descriptor next, and its
        // number may name another file by the following wait.
        عرف ألغ_استطلاعات_حلقة(المستطلع: &مستطلع, الواصف: عدد): نتيجة عدد, عدد {
            طابق أضف_مدخل_حلقة(المستطلع, 14 | ((الواصف مثل ط64 & 0xFFFFFFFF) << 32), (3 مثل ط64) << 32, ~(0 مثل ط64)) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
            دع ح: &حلقة_مستطلع = &(*المستطلع).الحلقة;
            دع المعلقة: ط64 = (احمل32_حلقة((*ح).ق_ذيل) - احمل32_حلقة((*ح).ق_رأس)) & 0xFFFFFFFF;
            أرجع دخول_حلقة((*المستطلع).الواصف, المعلقة, 0, 0, 0, 0);
        }

        نوع وقت_حلقة = { الثواني: ط64, النانو: ط64 };
        نوع وسيطة_انتظار_حلقة = { القناع: ط64, حجم_القناع: ط64, الوقت: ط64 };

        // Submits the pending registrations, waits (IORING_ENTER_GETEVENTS 1,
        // with a timeout through IORING_ENTER_EXT_ARG 8) and reaps the
        // completions into the buffer in epoll's layout, so حدث_مستطلع_عند
        // reads them as epoll's (POLLIN, POLLOUT, POLLERR, POLLHUP and
        // POLLRDHUP have epoll's bit values).
        عرف انتظر_حلقة_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد {
            دع ح: &حلقة_مستطلع = &(*المستطلع).الحلقة;
            دع المعلقة: ط64 = (احمل32_حلقة((*ح).ق_ذيل) - احمل32_حلقة((*ح).ق_رأس)) & 0xFFFFFFFF;
            دع جاهزة: منطقي = احمل32_حلقة((*ح).إ_ذيل) != احمل32_حلقة((*ح).إ_رأس);
            إذا (جاهزة || المهلة_بالملي == 0) {
                إذا (المعلقة > 0) {
                    طابق دخول_حلقة((*المستطلع).الواصف, المعلقة, 0, 0, 0, 0) مع
                    | نتيجة.خطأ(الخطأ) -> { إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة.خطأ(الخطأ); }; }
                    | نتيجة.نجح(_) -> { };
                };
            } وإلا إذا (المهلة_بالملي < 0) {
                طابق دخول_حلقة((*المستطلع).الواصف, المعلقة, 1, 1, 0, 0) مع
                | نتيجة.خطأ(الخطأ) -> { إذا (!هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة.خطأ(الخطأ); }; }
                | نتيجة.نجح(_) -> { };
            } وإلا {
                دع الوقت: متغير وقت_حلقة = {
                    الثواني: (المهلة_بالملي / 1000) مثل ط64,
                    النانو: ((المهلة_بالملي % 1000) * 1000000) مثل ط64
                };
                دع عنوان_الوقت: ط64;
                غير_آمن { عنوان_الوقت := ((&متغير الوقت) مثل *متغير وقت_حلقة) مثل ط64; }
                دع الوسيطة: متغير وسيطة_انتظار_حلقة = { القناع: 0, حجم_القناع: 0, الوقت: عنوان_الوقت };
                دع عنوان_الوسيطة: ط64;
                غير_آمن { عنوان_الوسيطة := ((&متغير الوسيطة) مثل *متغير وسيطة_انتظار_حلقة) مثل ط64; }
                طابق دخول_حلقة((*المستطلع).الواصف, المعلقة, 1, 9, عنوان_الوسيطة, 24) مع
                | نتيجة.خطأ(الخطأ) -> {
                    // ETIME: the timeout passed with no completion.
                    إذا (!هل_خطأ_مقاطعة(الخطأ) && الخطأ != -62) { أرجع نتيجة.خطأ(الخطأ); };
                }
                | نتيجة.نجح(_) -> { };
                // Keep the records alive past the call.
                الوقت.الثواني := الوقت.الثواني;
                الوسيطة.الوقت := الوسيطة.الوقت;
            };
            دع الرأس: متغير ط64 = احمل32_حلقة((*ح).إ_رأس);
            دع الذيل: ط64 = احمل32_حلقة((*ح).إ_ذيل);
            دع القناع: ط64 = احمل32_حلقة((*ح).إ_قناع);
            دع العدد: متغير طبيعي = 0;
            طالما (الرأس != الذيل && العدد < (*المخزن).السعة) {
                دع المدخل: ط64 = (*ح).إ_مدخلات + (الرأس & القناع) * 16;
                دع المستخدم: ط64;
                دع الكلمة: ط64;
                غير_آمن {
                    المستخدم := اقرأ_كلمة_حلقة(المدخل);
                    الكلمة := اقرأ_كلمة_حلقة(المدخل + 8);
                }
                إذا (المستخدم != ~(0 مثل ط64)) {
                    دع الناتج: ط64 = الكلمة & 0xFFFFFFFF;
                    دع الأحداث: متغير ط64 = الناتج;
                    // A negative result (bit 31) is an error: EPOLLERR.
                    إذا ((الناتج & 0x80000000) != 0) { الأحداث := 0x8; };
                    دع الموضع: طبيعي = العدد * حجم_حدث_إي_بول();
                    اكتب_بايتات_عدد_مستطلع(&متغير (*المخزن).البايتات, الموضع, الأحداث, 4, خطأ);
                    اكتب_بايتات_عدد_مستطلع(&متغير (*المخزن).البايتات, الموضع + إزاحة_بيانات_إي_بول(), المستخدم, 8, خطأ);
                    العدد := العدد + 1;
                };
                الرأس := (الرأس + 1) & 0xFFFFFFFF;
            }
            اخزن32_حلقة((*ح).إ_رأس, الرأس);
            (*المخزن).العدد := العدد;
            أرجع نتيجة.نجح(العدد);
        }
    }
    إذا (!(الهدف.المعمارية == «x86_64» || الهدف.المعمارية == «aarch64» || الهدف.المعمارية == «riscv64» || الهدف.المعمارية == «loongarch64»)) {
        عام عرف أنشئ_مستطلع_حلقي(): نتيجة مستطلع, عدد { أرجع أنشئ_مستطلع(); }
        عرف اطلب_استطلاع_حلقة(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
        عرف ألغ_استطلاعات_حلقة(المستطلع: &مستطلع, الواصف: عدد): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
        عرف انتظر_حلقة_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد { أرجع نتيجة.خطأ(-95); }
        عرف ألغ_ربط_حلقات_مستطلع(الحلقة: &حلقة_مستطلع): فراغ { }
    }
}

// ---- kqueue: the record and flags shared by FreeBSD and macOS ----
// struct kevent: ident u64 @0, filter i16 @8, flags u16 @10, fflags u32
// @12, data i64 @16, udata u64 @24; FreeBSD 12+ adds ext[4] (u64), so the
// record is 64 bytes there and 32 on Darwin. Every target is little-endian.
// EVFILT_READ -1, EVFILT_WRITE -2; EV_ADD 0x1, EV_DELETE 0x2, EV_ONESHOT
// 0x10, EV_ERROR 0x4000, EV_EOF 0x8000.
إذا (الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos») {
    عرف مرشح_اهتمام_كيو(الاهتمام: اهتمام_مستطلع): ط64 {
        طابق الاهتمام مع
        | اهتمام_مستطلع.قراءة -> { أرجع 0xFFFF مثل ط64; }
        | اهتمام_مستطلع.كتابة -> { أرجع 0xFFFE مثل ط64; };
    }

    عرف سجل_تغيير_كيو(الحجم: طبيعي, الواصف: عدد, المرشح: ط64, الأعلام: ط64, الرمز: ط64): متجه ط8 {
        دع السجل: متغير متجه ط8 = أصفار_مستطلع(الحجم);
        اكتب_بايتات_عدد_مستطلع(&متغير السجل, 0, الواصف مثل ط64, 8, خطأ);
        اكتب_بايتات_عدد_مستطلع(&متغير السجل, 8, المرشح, 2, خطأ);
        اكتب_بايتات_عدد_مستطلع(&متغير السجل, 10, الأعلام, 2, خطأ);
        اكتب_بايتات_عدد_مستطلع(&متغير السجل, 24, الرمز, 8, خطأ);
        أرجع السجل;
    }

    عرف حدث_كيو_عند(المخزن: &مخزن_أحداث_مستطلع, الموضع: طبيعي, الحجم: طبيعي): حدث_مستطلع {
        دع البداية: طبيعي = الموضع * الحجم;
        دع المرشح: ط64 = اقرأ_بايتات_عدد_مستطلع(&(*المخزن).البايتات, البداية + 8, 2, خطأ);
        دع الأعلام: ط64 = اقرأ_بايتات_عدد_مستطلع(&(*المخزن).البايتات, البداية + 10, 2, خطأ);
        دع الرمز: ط64 = اقرأ_بايتات_عدد_مستطلع(&(*المخزن).البايتات, البداية + 24, 8, خطأ);
        دع الحدث: حدث_مستطلع = {
            الرمز: الرمز,
            قابل_للقراءة: المرشح == (0xFFFF مثل ط64),
            قابل_للكتابة: المرشح == (0xFFFE مثل ط64),
            انتهى: (الأعلام & 0xC000) != 0
        };
        أرجع الحدث;
    }

    عام عرف هل_المستطلع_مدعوم(): منطقي { أرجع صواب; }
    // EAGAIN is 35 and EINTR 4 on FreeBSD and Darwin.
    عام عرف هل_خطأ_سيحظر(الرمز: عدد): منطقي { أرجع الرمز == -35; }
    عام عرف هل_خطأ_مقاطعة(الرمز: عدد): منطقي { أرجع الرمز == -4; }

    // Registering and re-arming are the same change: EV_ADD | EV_ONESHOT on
    // the one filter of the interest (the fired one-shot filter is gone).
    عام عرف سجل_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
        أرجع غير_كيو(المستطلع, الواصف, مرشح_اهتمام_كيو(الاهتمام), 0x11 مثل ط64, الرمز);
    }

    عام عرف أعد_تسليح_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد {
        أرجع غير_كيو(المستطلع, الواصف, مرشح_اهتمام_كيو(الاهتمام), 0x11 مثل ط64, الرمز);
    }

    // Deletes both filters; a filter that is not armed (ENOENT, 2) is fine.
    // Closing a descriptor removes its filters anyway.
    عام عرف ألغ_من_مستطلع(المستطلع: &مستطلع, الواصف: عدد): نتيجة عدد, عدد {
        دع القراءة: نتيجة عدد, عدد = غير_كيو(المستطلع, الواصف, 0xFFFF مثل ط64, 0x2 مثل ط64, 0 مثل ط64);
        دع الكتابة: نتيجة عدد, عدد = غير_كيو(المستطلع, الواصف, 0xFFFE مثل ط64, 0x2 مثل ط64, 0 مثل ط64);
        طابق القراءة مع
        | نتيجة.خطأ(الخطأ) -> { إذا (الخطأ != -2) { أرجع نتيجة.خطأ(الخطأ); }; }
        | نتيجة.نجح(_) -> { };
        طابق الكتابة مع
        | نتيجة.خطأ(الخطأ) -> { إذا (الخطأ != -2) { أرجع نتيجة.خطأ(الخطأ); }; }
        | نتيجة.نجح(_) -> { };
        أرجع نتيجة.نجح(0);
    }

    عام عرف أنشئ_مخزن_أحداث_مستطلع(السعة: طبيعي): مخزن_أحداث_مستطلع {
        دع الحد: متغير طبيعي = السعة;
        إذا (الحد == 0) { الحد := 1; };
        دع الناتج: مخزن_أحداث_مستطلع = {
            البايتات: أصفار_مستطلع(الحد * حجم_حدث_كيو()), السعة: الحد, العدد: 0
        };
        أرجع الناتج;
    }

    عام عرف حدث_مستطلع_عند(المخزن: &مخزن_أحداث_مستطلع, الموضع: طبيعي): حدث_مستطلع {
        أرجع حدث_كيو_عند(المخزن, الموضع, حجم_حدث_كيو());
    }

    // A relative timespec {i64 seconds, i64 nanoseconds} for a timeout.
    عرف مهلة_كيو(المهلة_بالملي: عدد): متجه ط8 {
        دع المؤقت: متغير متجه ط8 = أصفار_مستطلع(16);
        اكتب_بايتات_عدد_مستطلع(&متغير المؤقت, 0, (المهلة_بالملي / 1000) مثل ط64, 8, خطأ);
        اكتب_بايتات_عدد_مستطلع(&متغير المؤقت, 8, ((المهلة_بالملي % 1000) * 1000000) مثل ط64, 8, خطأ);
        أرجع المؤقت;
    }
}

// ---- FreeBSD: kqueue and kevent as system calls ----
إذا (الهدف.المنصة == «freebsd») {
    استورد os.platform.unix.linux.syscalls.operations;
    استورد os.platform.unix.linux.syscalls.selection;
    استورد os.platform.unix.linux.syscalls.kernel_result;

    عرف حجم_حدث_كيو(): طبيعي { أرجع 64; }

    عرف نتيجة_نواة_مستطلع(الخام: ط64): نتيجة عدد, عدد {
        طابق حلل_نتيجة_نداء_نواة_لينكس(الخام) مع
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة مثل عدد); }
        | نتيجة.خطأ(الأصلي) -> { أرجع نتيجة.خطأ(0 - الأصلي.الرمز); };
    }

    عام عرف أنشئ_مستطلع_حلقي(): نتيجة مستطلع, عدد { أرجع أنشئ_مستطلع(); }
    عام عرف أنشئ_مستطلع(): نتيجة مستطلع, عدد {
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.أنشئ_مستطلع_أحداث()),
            0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        طابق نتيجة_نواة_مستطلع(الخام) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الواصف) -> {
            دع الناتج: مستطلع = { الواصف: الواصف, الحلقة: حلقة_مستطلع_فارغة() };
            أرجع نتيجة.نجح(الناتج);
        };
    }

    // One change, no event list: kevent(kq, &change, 1, NULL, 0, NULL).
    عرف غير_كيو(المستطلع: &مستطلع, الواصف: عدد, المرشح: ط64, الأعلام: ط64, الرمز: ط64): نتيجة عدد, عدد {
        دع التغيير: متغير متجه ط8 = سجل_تغيير_كيو(حجم_حدث_كيو(), الواصف, المرشح, الأعلام, الرمز);
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مستطلع_أحداث()),
            (*المستطلع).الواصف مثل ط64, &متغير التغيير[0], 1 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_نواة_مستطلع(الخام);
    }

    عام عرف انتظر_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد {
        (*المخزن).العدد := 0;
        دع المؤقت: متغير متجه ط8 = مهلة_كيو(المهلة_بالملي);
        دع الخام: ط64;
        إذا (المهلة_بالملي < 0) {
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مستطلع_أحداث()),
                (*المستطلع).الواصف مثل ط64, 0 مثل ط64, 0 مثل ط64,
                &متغير (*المخزن).البايتات[0], (*المخزن).السعة مثل ط64, 0 مثل ط64
            ); }
        } وإلا {
            غير_آمن { الخام := بدائي_نداء_نواة_خام(
                رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.انتظر_مستطلع_أحداث()),
                (*المستطلع).الواصف مثل ط64, 0 مثل ط64, 0 مثل ط64,
                &متغير (*المخزن).البايتات[0], (*المخزن).السعة مثل ط64, &متغير المؤقت[0]
            ); }
        };
        طابق نتيجة_نواة_مستطلع(الخام) مع
        | نتيجة.خطأ(الخطأ) -> {
            إذا (هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة.نجح(0); };
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(العدد) -> {
            (*المخزن).العدد := العدد مثل طبيعي;
            أرجع نتيجة.نجح(العدد مثل طبيعي);
        };
    }

    عام عرف أغلق_مستطلع(المستطلع: مستطلع): نتيجة عدد, عدد {
        دع الخام: ط64;
        غير_آمن { الخام := بدائي_نداء_نواة_خام(
            رقم_نداء_نواة_لينكس(عملية_نداء_نواة_لينكس.إغلاق()),
            المستطلع.الواصف مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64, 0 مثل ط64
        ); }
        أرجع نتيجة_نواة_مستطلع(الخام);
    }
}

// ---- macOS: kqueue and kevent from libSystem ----
إذا (الهدف.المنصة == «macos») {
    استورد os.platform.unix.apple.darwin.file_descriptors;

    خارجي «/usr/lib/libSystem.B.dylib» عرف kqueue(): ص32;
    خارجي «/usr/lib/libSystem.B.dylib» عرف kevent(
        المستطلع: ص32, التغييرات: *ط8, عدد_التغييرات: ص32,
        الأحداث: *متغير ط8, عدد_الأحداث: ص32, المهلة: *ط8
    ): ص32;

    عرف حجم_حدث_كيو(): طبيعي { أرجع 32; }

    عرف خطأ_مستطلع_داروين(): عدد { أرجع 0 - خطأ_داروين_الحالي().الرمز; }

    عام عرف أنشئ_مستطلع_حلقي(): نتيجة مستطلع, عدد { أرجع أنشئ_مستطلع(); }
    عام عرف أنشئ_مستطلع(): نتيجة مستطلع, عدد {
        دع الواصف: ص32 = kqueue();
        إذا (الواصف < 0) { أرجع نتيجة.خطأ(خطأ_مستطلع_داروين()); };
        دع الناتج: مستطلع = { الواصف: الواصف مثل عدد, الحلقة: حلقة_مستطلع_فارغة() };
        أرجع نتيجة.نجح(الناتج);
    }

    عرف غير_كيو(المستطلع: &مستطلع, الواصف: عدد, المرشح: ط64, الأعلام: ط64, الرمز: ط64): نتيجة عدد, عدد {
        دع التغيير: متجه ط8 = سجل_تغيير_كيو(حجم_حدث_كيو(), الواصف, المرشح, الأعلام, الرمز);
        دع الحالة: ص32 = kevent(
            (*المستطلع).الواصف مثل ص32, &التغيير[0], 1, الفارغ, 0, الفارغ
        );
        إذا (الحالة < 0) { أرجع نتيجة.خطأ(خطأ_مستطلع_داروين()); };
        أرجع نتيجة.نجح(0);
    }

    عام عرف انتظر_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد {
        (*المخزن).العدد := 0;
        دع المؤقت: متجه ط8 = مهلة_كيو(المهلة_بالملي);
        دع السعة: ص32 = (*المخزن).السعة مثل ص32;
        دع الحالة: متغير ص32 = 0;
        إذا (المهلة_بالملي < 0) {
            الحالة := kevent((*المستطلع).الواصف مثل ص32, الفارغ, 0, &متغير (*المخزن).البايتات[0], السعة, الفارغ);
        } وإلا {
            الحالة := kevent((*المستطلع).الواصف مثل ص32, الفارغ, 0, &متغير (*المخزن).البايتات[0], السعة, &المؤقت[0]);
        };
        إذا (الحالة < 0) {
            دع الخطأ: عدد = خطأ_مستطلع_داروين();
            إذا (هل_خطأ_مقاطعة(الخطأ)) { أرجع نتيجة.نجح(0); };
            أرجع نتيجة.خطأ(الخطأ);
        };
        (*المخزن).العدد := الحالة مثل طبيعي;
        أرجع نتيجة.نجح(الحالة مثل طبيعي);
    }

    عام عرف أغلق_مستطلع(المستطلع: مستطلع): نتيجة عدد, عدد {
        إذا (close(المستطلع.الواصف مثل ص32) < 0) { أرجع نتيجة.خطأ(خطأ_مستطلع_داروين()); };
        أرجع نتيجة.نجح(0);
    }
}

// ---- Every other target: no readiness poller yet ----
إذا (!(((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») || الهدف.المنصة == «freebsd» || الهدف.المنصة == «macos»)) {
    عام عرف هل_المستطلع_مدعوم(): منطقي { أرجع خطأ; }
    عام عرف هل_خطأ_سيحظر(الرمز: عدد): منطقي { أرجع الرمز == -10035 || الرمز == -11; }
    عام عرف هل_خطأ_مقاطعة(الرمز: عدد): منطقي { أرجع الرمز == -4; }
    عام عرف أنشئ_مستطلع(): نتيجة مستطلع, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف أنشئ_مستطلع_حلقي(): نتيجة مستطلع, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف سجل_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف أعد_تسليح_في_مستطلع(المستطلع: &مستطلع, الواصف: عدد, الرمز: ط64, الاهتمام: اهتمام_مستطلع): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف ألغ_من_مستطلع(المستطلع: &مستطلع, الواصف: عدد): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف أنشئ_مخزن_أحداث_مستطلع(السعة: طبيعي): مخزن_أحداث_مستطلع {
        دع الناتج: مخزن_أحداث_مستطلع = { البايتات: [], السعة: 0, العدد: 0 };
        أرجع الناتج;
    }
    عام عرف انتظر_مستطلع(المستطلع: &مستطلع, المخزن: &متغير مخزن_أحداث_مستطلع, المهلة_بالملي: عدد): نتيجة طبيعي, عدد { أرجع نتيجة.خطأ(-95); }
    عام عرف حدث_مستطلع_عند(المخزن: &مخزن_أحداث_مستطلع, الموضع: طبيعي): حدث_مستطلع {
        دع الحدث: حدث_مستطلع = { الرمز: 0, قابل_للقراءة: خطأ, قابل_للكتابة: خطأ, انتهى: صواب };
        أرجع الحدث;
    }
    عام عرف أغلق_مستطلع(المستطلع: مستطلع): نتيجة عدد, عدد { أرجع نتيجة.خطأ(-95); }
}

عام عرف عدد_أحداث_مستطلع(المخزن: &مخزن_أحداث_مستطلع): طبيعي { أرجع (*المخزن).العدد; }

عام مرادف poller = مستطلع;
عام مرادف poll_interest = اهتمام_مستطلع;
عام مرادف poll_interest.read = اهتمام_مستطلع.قراءة;
عام مرادف poll_interest.write = اهتمام_مستطلع.كتابة;
عام مرادف poll_event = حدث_مستطلع;
عام مرادف poll_events = مخزن_أحداث_مستطلع;
عام مرادف poll_supported = هل_المستطلع_مدعوم;
عام مرادف is_would_block = هل_خطأ_سيحظر;
عام مرادف is_interrupted = هل_خطأ_مقاطعة;
عام مرادف poller_new = أنشئ_مستطلع;
عام مرادف ring_poller_new = أنشئ_مستطلع_حلقي;
عام مرادف poller_register = سجل_في_مستطلع;
عام مرادف poller_rearm = أعد_تسليح_في_مستطلع;
عام مرادف poller_deregister = ألغ_من_مستطلع;
عام مرادف poll_events_new = أنشئ_مخزن_أحداث_مستطلع;
عام مرادف poller_wait = انتظر_مستطلع;
عام مرادف poll_event_at = حدث_مستطلع_عند;
عام مرادف poll_events_count = عدد_أحداث_مستطلع;
عام مرادف poller_close = أغلق_مستطلع;
