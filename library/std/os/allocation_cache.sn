// The allocation entry points the compiler binds (compiler/runtime/
// primitive_runtime_abi.sn): os/allocation.sn's allocator with the running
// thread's cache (Nahr item 2; see "Per-thread caches" there). The thread is
// named by the address of a local variable, which falls in its stack slot;
// this module holds the one conversion of an address to an integer, so
// os/allocation.sn stays within what older compilers lower (a compiler
// bootstrapped from an older seed binds os/allocation.sn's plain, locked
// entry points instead).
//
// Also the calling thread's own allocation counts.
استورد os.allocation;

إذا ((((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») && الهدف.عرض_المؤشر == «64») {
    // An address on the running thread's stack.
    عرف عنوان_في_مكدس_الخيط(): ط64 {
        دع المحلي: متغير ط64 = 0;
        دع العنوان: ط64;
        غير_آمن { العنوان := ((&متغير المحلي) مثل *متغير ط64) مثل ط64; }
        أرجع العنوان;
    }
    عرف مخبأ_الخيط_الحالي(): ط64 { أرجع مخبأ_من_عنوان_مكدس_مخصص(عنوان_في_مكدس_الخيط()); }

    عام عرف خصص_ذاكرة_التشغيل_المخبأ(الحجم: ط64): ط64 {
        أرجع خصص_بمخبأ_مخصص(مخبأ_الخيط_الحالي(), الحجم);
    }
    عام عرف حرر_ذاكرة_التشغيل_المخبأ(العنوان: ط64): فراغ {
        حرر_بمخبأ_مخصص(مخبأ_الخيط_الحالي(), العنوان);
    }
    عام عرف أعد_تخصيص_ذاكرة_التشغيل_المخبأ(العنوان: ط64, الحجم: ط64): ط64 {
        أرجع أعد_تخصيص_بمخبأ_مخصص(مخبأ_الخيط_الحالي(), العنوان, الحجم);
    }

    عرف عداد_الخيط_الحالي(الإزاحة: ط64): ط64 { أرجع عداد_مخبأ_مخصص(مخبأ_الخيط_الحالي(), الإزاحة); }
}

// No per-thread caches: the plain entry points under the bound names.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve» && الهدف.عرض_المؤشر == «32») {
    عام عرف خصص_ذاكرة_التشغيل_المخبأ(الحجم: ط32): ط32 { أرجع خصص_ذاكرة_التشغيل(الحجم); }
    عام عرف حرر_ذاكرة_التشغيل_المخبأ(العنوان: ط32): فراغ { حرر_ذاكرة_التشغيل(العنوان); }
    عام عرف أعد_تخصيص_ذاكرة_التشغيل_المخبأ(العنوان: ط32, الحجم: ط32): ط32 {
        أرجع أعد_تخصيص_ذاكرة_التشغيل(العنوان, الحجم);
    }
    عرف عداد_الخيط_الحالي(الإزاحة: ط64): ط64 { أرجع عداد_مخبأ_مخصص(0, الإزاحة); }
}
إذا (الهدف.المعمارية == «wasm32») {
    عام عرف خصص_ذاكرة_التشغيل_المخبأ(الحجم: ط32): ط32 { أرجع خصص_ذاكرة_التشغيل(الحجم); }
    عام عرف حرر_ذاكرة_التشغيل_المخبأ(العنوان: ط32): فراغ { حرر_ذاكرة_التشغيل(العنوان); }
    عام عرف أعد_تخصيص_ذاكرة_التشغيل_المخبأ(العنوان: ط32, الحجم: ط32): ط32 {
        أرجع أعد_تخصيص_ذاكرة_التشغيل(العنوان, الحجم);
    }
    عرف عداد_الخيط_الحالي(الإزاحة: ط64): ط64 { أرجع عداد_مخبأ_مخصص(0, الإزاحة); }
}

إذا (الهدف.المعمارية == «wasm32» || (((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows»)) {
    // The calling thread's own allocations, frees, reallocations and
    // requested bytes: a std thread's since it started, the main thread's
    // (and those of threads without a stack slot) since the program started.
    عام عرف عدد_تخصيصات_الخيط(): ط64 { أرجع عداد_الخيط_الحالي(0); }
    عام عرف عدد_تحريرات_الخيط(): ط64 { أرجع عداد_الخيط_الحالي(8); }
    عام عرف عدد_إعادات_تخصيص_الخيط(): ط64 { أرجع عداد_الخيط_الحالي(16); }
    عام عرف بايتات_مطلوبة_الخيط(): ط64 { أرجع عداد_الخيط_الحالي(24); }
    عام مرادف thread_allocation_count = عدد_تخصيصات_الخيط;
    عام مرادف thread_free_count = عدد_تحريرات_الخيط;
    عام مرادف thread_reallocation_count = عدد_إعادات_تخصيص_الخيط;
    عام مرادف thread_requested_bytes = بايتات_مطلوبة_الخيط;
}
