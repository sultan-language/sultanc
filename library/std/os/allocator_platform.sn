// std.os.allocator_platform (المكتبة.نظام_التشغيل.منصة_المخصص): what the heap
// allocator (std.os.allocation) needs from the operating system, and nothing
// else: one file per platform behind one interface; a new platform
// implements these functions
// and the allocator runs on it unchanged:
//
//   Page source (native targets):
//     أكبر_حجز_كومة_الآلة(): ط64                 the largest range to reserve
//     احجز_صفحات_كومة_الآلة(الطول): ط64           reserve without committing; 0 = refused
//     ثبت_صفحات_كومة_الآلة(العنوان, الطول): منطقي   commit reserved pages
//     استرد_صفحات_كومة_الآلة(العنوان, الطول): منطقي  return pages to the system
//     صفحة_إرجاع_مخصص(): ط64                    the size returned pages are cut to
//     صفحات_مستردة_تحتاج_تثبيتا(): منطقي          whether returned pages must be
//                                               committed again before reuse (Windows)
//   Lock (targets with threads):
//     نم_على_خلية_المخصص(&الخلية)                sleep while the word is 2
//     أيقظ_نائما_على_خلية_المخصص(&الخلية)         wake one sleeper
//   مصدر_صفحات_أصلي_للمخصص(): منطقي            whether the target has the page source
//
// wasm32 grows its linear memory with the memory.grow instruction instead,
// in std.os.allocation itself. Nothing here allocates.

// Whether the target has a native page source here (wasm32 grows linear
// memory instead; a target with neither has no heap from std).
إذا (((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») || الهدف.المنصة == «macos» || الهدف.المنصة == «windows») {
    عام عرف مصدر_صفحات_أصلي_للمخصص(): منطقي { أرجع صواب; }
} وإلا {
    عام عرف مصدر_صفحات_أصلي_للمخصص(): منطقي { أرجع خطأ; }
}

// Sleeping on and waking the allocator lock's word (std.os.allocation owns
// the word). Nothing here allocates: the waits are the raw-cell OS calls
// without a timeout, whose results are plain values.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») {
    استورد نظام_التشغيل.منصات.يونكس.لينكس.انتظار_العنوان;

    عام عرف نم_على_خلية_المخصص(الخلية: &ط32): فراغ {
        ليكن تجاهل: منطقي = انتظر_عند_عنوان_لينكس(الخلية, 2 مثل ط32, اختياري.لا_شيء());
    }
    عام عرف أيقظ_نائما_على_خلية_المخصص(الخلية: &ط32): فراغ { أيقظ_عند_عنوان_لينكس(الخلية, 1 مثل ط64); }
}
إذا (الهدف.المنصة == «freebsd») {
    استورد نظام_التشغيل.منصات.يونكس.فري_بي_إس_دي.انتظار_العنوان;

    عام عرف نم_على_خلية_المخصص(الخلية: &ط32): فراغ {
        ليكن تجاهل: منطقي = انتظر_عند_عنوان_فري_بي_إس_دي(الخلية, 2 مثل ط32, اختياري.لا_شيء());
    }
    عام عرف أيقظ_نائما_على_خلية_المخصص(الخلية: &ط32): فراغ { أيقظ_عند_عنوان_فري_بي_إس_دي(الخلية, 1 مثل ط64); }
}
إذا (الهدف.المنصة == «macos» && الهدف.عرض_المؤشر == «64») {
    استورد نظام_التشغيل.منصات.يونكس.آبل.داروين.انتظار_العنوان;

    عام عرف نم_على_خلية_المخصص(الخلية: &ط32): فراغ {
        ليكن تجاهل: منطقي = انتظر_عند_عنوان_داروين(الخلية, 2 مثل ط32, اختياري.لا_شيء());
    }
    عام عرف أيقظ_نائما_على_خلية_المخصص(الخلية: &ط32): فراغ { أيقظ_عند_عنوان_داروين(الخلية, خطأ); }
}
إذا (الهدف.المنصة == «windows» && الهدف.عرض_المؤشر == «64») {
    استورد نظام_التشغيل.منصات.ويندوز.وين32.انتظار_العنوان;

    عام عرف نم_على_خلية_المخصص(الخلية: &ط32): فراغ {
        ليكن تجاهل: منطقي = انتظر_عند_عنوان_ويندوز(الخلية, 2 مثل ط32, اختياري.لا_شيء());
    }
    عام عرف أيقظ_نائما_على_خلية_المخصص(الخلية: &ط32): فراغ { أيقظ_عند_عنوان_ويندوز(الخلية, خطأ); }
}

// The page source: one reserved address range, committed and released in
// pages. Kernel ABI values of the selected kernel: Linux UAPI or FreeBSD headers.
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android») && الهدف.المعمارية != «ve») { استورد os.platform.unix.linux.uapi; }
إذا (الهدف.المنصة == «freebsd») { استورد os.platform.unix.freebsd.uapi; }
إذا ((الهدف.المنصة == «linux» || الهدف.المنصة == «android» || الهدف.المنصة == «freebsd») && الهدف.المعمارية != «ve») {
    استورد نظام_التشغيل.منصات.يونكس.لينكس.ذاكرة_افتراضية;

    عام عرف أكبر_حجز_كومة_الآلة(): ط64 {
        إذا (حجم_كلمة_لينكس() == 4) { أرجع 1073741824; };
        أرجع 68719476736;
    }
    عام عرف احجز_صفحات_كومة_الآلة(الطول: ط64): ط64 { أرجع احجز_عناوين_لينكس(الطول); }
    عام عرف ثبت_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع ثبت_عناوين_لينكس(العنوان, الطول);
    }
    عام عرف استرد_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع استرد_عناوين_لينكس(العنوان, الطول);
    }
    عام عرف صفحات_مستردة_تحتاج_تثبيتا(): منطقي { أرجع خطأ; }
    // The page size the trim may release at: 4 KiB on x86-64; AArch64 and
    // others may run with 16 or 64 KiB pages, so the allocator's 64 KiB.
    إذا (الهدف.المعمارية == «x86_64») { عام عرف صفحة_إرجاع_مخصص(): ط64 { أرجع 4096; } }
    إذا (الهدف.المعمارية != «x86_64») { عام عرف صفحة_إرجاع_مخصص(): ط64 { أرجع 65536; } }
}

إذا (الهدف.المنصة == «macos») {
    استورد نظام_التشغيل.منصات.يونكس.آبل.داروين.ذاكرة_افتراضية;

    عام عرف أكبر_حجز_كومة_الآلة(): ط64 { أرجع 68719476736; }
    عام عرف احجز_صفحات_كومة_الآلة(الطول: ط64): ط64 { أرجع احجز_عناوين_داروين(الطول); }
    عام عرف ثبت_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع ثبت_عناوين_داروين(العنوان, الطول);
    }
    عام عرف استرد_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع استرد_عناوين_داروين(العنوان, الطول);
    }
    عام عرف صفحات_مستردة_تحتاج_تثبيتا(): منطقي { أرجع خطأ; }
    // The page size the trim may release at: 4 KiB on x86-64, 16 KiB on
    // Apple silicon.
    إذا (الهدف.المعمارية == «x86_64») { عام عرف صفحة_إرجاع_مخصص(): ط64 { أرجع 4096; } }
    إذا (الهدف.المعمارية != «x86_64») { عام عرف صفحة_إرجاع_مخصص(): ط64 { أرجع 16384; } }
}

إذا (الهدف.المنصة == «windows») {
    استورد نظام_التشغيل.منصات.ويندوز.وين32.ذاكرة_افتراضية;

    عام عرف أكبر_حجز_كومة_الآلة(): ط64 { أرجع 68719476736; }
    عام عرف احجز_صفحات_كومة_الآلة(الطول: ط64): ط64 { أرجع احجز_عناوين_ويندوز(الطول); }
    عام عرف ثبت_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع ثبت_عناوين_ويندوز(العنوان, الطول);
    }
    عام عرف استرد_صفحات_كومة_الآلة(العنوان: ط64, الطول: ط64): منطقي {
        أرجع استرد_عناوين_ويندوز(العنوان, الطول);
    }
    عام عرف صفحات_مستردة_تحتاج_تثبيتا(): منطقي { أرجع صواب; }
    // Released pages are decommitted and must be recommitted before reuse,
    // which the free blocks' bookkeeping does for their 64 KiB ranges only.
    عام عرف صفحة_إرجاع_مخصص(): ط64 { أرجع 65536; }
}
